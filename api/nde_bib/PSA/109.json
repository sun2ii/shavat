{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":109,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. ElikaDavida. Ihubo."]},{"type":"verse","number":1,"content":[{"text":"Oh Nkulunkulu, wena engikudumisayo,","poem":1},{"text":"ungali ulokhu uthule,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ngoba abantu ababi abalenkohliso","poem":1},{"text":"bayivulile imilomo yabo bekhuluma ngami;","poem":2},{"lineBreak":true},{"text":"bakhuluma bengigcona ngendimi zabo zamanga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bangihonqolozela ngamazwi enzondo;","poem":1},{"text":"bayangisukela nje kungelasizatho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ukubathanda kwami bakuphindisela ngokungisola,","poem":1},{"text":"kodwa ngingumuntu womkhuleko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bangiphindisela okuhle ngokubi,","poem":1},{"text":"langenzondo ukubathanda kwami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bathi, “Khethani umuntu omubi ozamelana laye;","poem":1},{"text":"ombeka icala kame kwesokunene sakhe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nxa esethonisiswa kafunyanwe elecala,","poem":1},{"text":"futhi sengathi imikhuleko yakhe ingamlahla.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sengathi insuku zakhe zingabazilutshwana;","poem":1},{"text":"kakube lomunye ozathatha isikhundla sakhe sobukhokheli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sengathi abantwabakhe bangaba zintandane","poem":1},{"text":"lomkakhe abe ngumfelokazi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sengathi abantwabakhe bangaba zinzulane zeziceli;","poem":1},{"text":"sengathi bangaxotshwa emizini yabo esingamanxiwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sengathi lowo aboleke kuye angamemuka konke alakho;","poem":1},{"text":"sengathi labezizweni bangaphanga izithelo zamandla akhe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akungabikhona omenzela umusa","poem":1},{"text":"loba ozwela izintandane zakhe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sengathi izizukulwane zakhe zingaphela,","poem":1},{"text":"amabizo abo esulwe esizukulwaneni esilandelayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sengathi ububi bukayise bungakhunjulwa phambi kukaThixo,","poem":1},{"text":"sengathi isono sikanina singacitshi lanini.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sengathi izono zabo zingahlala zisobala phambi kukaThixo,","poem":1},{"text":"ukuze aphelise du ukukhunjulwa kwabo emhlabeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ngoba kazange akhumbule ukwenza umusa","poem":1},{"text":"kodwa wabazingelela ukufa abayanga","poem":2},{"lineBreak":true},{"text":"labaswelayo labadabukileyo enhliziyweni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wayekuthanda ukwethesa isithuko,","poem":1},{"text":"sengathi singehlela kuye.","poem":2},{"text":"Wayengakuthandi ukubusisa","poem":1},{"text":"sengathi kungaba khatshana laye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wayevunula ukuthuka njengesigqoko;","poem":1},{"text":"kwangena emzimbeni wakhe njengamanzi,","poem":2},{"lineBreak":true},{"text":"emathanjeni akhe njengamafutha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sengathi kungaba njengengubo athandelwe ngayo","poem":1},{"text":"njengebhanti abotshwe ngalo lanini.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sengathi lokhu kungaba yisijeziso sikaThixo kulabo abangethesa amacala,","poem":1},{"text":"labo abakhuluma okubi ngami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kodwa wena, Oh Thixo woBukhosi,","poem":1},{"text":"ngenzela kuhle ngenxa yebizo lakho;","poem":2},{"lineBreak":true},{"text":"ngenxa yokulunga kothando lwakho akungikhulule.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ngoba ngingumyanga ngiyaswela,","poem":1},{"text":"lenhliziyo yami ilimele ngaphakathi kwami.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngiyafiphala njengethunzi lakusihlwa;","poem":1},{"text":"ngiyaphetshulwa njengentethe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Amadolo ami asebuthakathaka ngokuzila ukudla;","poem":1},{"text":"umzimba wami usuzacile usutshwabhene.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sengiyinto yokuhlekisa kulabo abangibeka amacala;","poem":1},{"text":"bathi bengibona banyikinye amakhanda abo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Akungisize, Oh Thixo Nkulunkulu wami;","poem":1},{"text":"ngisindisa ngokuya ngothando lwakho.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kumele bakwazi ukuthi lokhu ngokwesandla sakho;","poem":1},{"text":"wena, Oh Thixo, nguwe okwenzileyo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bangangiqalekisa, kodwa wena uzabusisa;","poem":1},{"text":"bathi bayahlasela bayangiswe,","poem":2},{"lineBreak":true},{"text":"kodwa inceku yakho izathokoza.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Abangivukelayo kabembeswe ihlazo","poem":1},{"text":"bagoqelwe ngokuyangeka njengengubo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ngomlomo wami ngizambabaza kakhulu uThixo;","poem":1},{"text":"ngisemphakathini ngizamdumisa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ngoba umi ngakwesokunene salowo oswelayo,","poem":1},{"text":"ukusindisa impilo yakhe kulabo abamnikela ekufeni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}