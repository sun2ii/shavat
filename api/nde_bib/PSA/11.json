{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Mina ngiphephela kuThixo.","poem":1},{"text":"Pho ungatsho kanjani kimi ukuthi:","poem":2},{"lineBreak":true},{"text":"“Balekela entabeni yakho njengenyoni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngoba, khangela, ababi sebewanwebile amadandili abo;","poem":1},{"text":"imitshoko yabo sebeyixhume ezintanjeni","poem":2},{"text":"ukuthi batshoke becatshile emathunzini","poem":1},{"text":"beciba labo abaqotho ezinhliziyweni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kambe nxa kubhidlizwa izisekelo,","poem":1},{"text":"kuyini abangakwenza abalungileyo na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"UThixo usethempelini lakhe elingcwele;","poem":1},{"text":"uThixo usesihlalweni sakhe sobukhosi basezulwini.","poem":2},{"text":"Uyawakhangela amadodana abantu;","poem":1},{"text":"amehlo akhe ayabahlola.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"UThixo uyabahlola abalungileyo,","poem":1},{"text":"kodwa ababi lalabo abathanda udlakela","poem":2},{"lineBreak":true},{"text":"uyabazonda ngomoya wakhe wonke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ababi uzabehlisela amalahle avuthayo lesalufa etshisayo;","poem":1},{"text":"umoya otshisayo uzabahaqaza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngoba uThixo ulungile,","poem":1},{"text":"uthanda ukwahlulela okuhle;","poem":2},{"lineBreak":true},{"text":"abaqotho bazabubona ubuso bakhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}