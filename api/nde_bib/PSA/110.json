{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["ElikaDavida. Ihubo."]},{"type":"verse","number":1,"content":[{"text":"UThixo uthi enkosini yami:","poem":1},{"lineBreak":true},{"text":"“Hlala ngakwesokunene sami","poem":1},{"text":"ngize ngenze izitha zakho","poem":2},{"lineBreak":true},{"text":"zibe yisinyathelo senyawo zakho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"UThixo uzakwelula intonga yakhe elamandla eyobukhosi kusuka eZiyoni","poem":1},{"text":"wena uzabusa phakathi kwezitha zakho","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amabutho akho azazinikela","poem":1},{"text":"mhla uphuma impi.","poem":2},{"text":"Wembethe ubukhosi obungcwele,","poem":1},{"text":"phakathi komnyama wempondozankomo","poem":2},{"lineBreak":true},{"text":"uzakwamukela amazolo obutsha bakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"UThixo ufungile","poem":1},{"text":"njalo kasoze ayiguqule ingqondo yakhe:","poem":2},{"text":"“Wena ungumphristi kuze kube nini lanini","poem":1},{"text":"emkhondweni kaMelikhizedekhi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"INkosi ikwesokunene sakho;","poem":1},{"text":"izawachoboza amakhosi mhla wosuku lokuthukuthela kwayo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Izazahlulela izizwe, yenze inqwaba yabafileyo","poem":1},{"text":"njalo ibachoboze ababusi bomhlaba wonke.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Izanatha emfuleni oseceleni kwendlela;","poem":1},{"text":"ngakho-ke izaliphakamisa ikhanda layo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}