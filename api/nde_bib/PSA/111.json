{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Dumisani uThixo.","poem":1},{"lineBreak":true},{"text":"Ngizambabaza uThixo ngenhliziyo yami yonke","poem":1},{"text":"enkundleni yabaqotho lasemhlanganweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mikhulu imisebenzi kaThixo;","poem":1},{"text":"isemicabangweni yabo bonke abathokoza ngayo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zilenkazimulo lobukhosi izenzo zakhe,","poem":1},{"text":"lokulunga Kwakhe kumi kuze kube laphakade.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wenzile ukuthi izimanga zakhe zikhunjulwe;","poem":1},{"text":"uThixo ulomusa lesihawu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uyabapha ukudla labo abamesabayo;","poem":1},{"text":"uyasikhumbula isivumelwano Sakhe lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ubatshengisile abantu bakhe amandla emisebenzi yakhe,","poem":1},{"text":"ngokubapha amazwe ezinye izizwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Imisebenzi yezandla zakhe ithembekile, ilungile;","poem":1},{"text":"zonke iziqondiso zakhe ziyathembeka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zimi kaziguquki nini lanini,","poem":1},{"text":"zenziwa ngeqiniso langobuqotho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wathumela abantu bakhe insindiso;","poem":1},{"text":"wasingcwelisa isivumelwano Sakhe okwanininini","poem":2},{"lineBreak":true},{"text":"lingcwele liyesabeka ibizo lakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ukumesaba uThixo kuyikuqala kwenhlakanipho","poem":1},{"text":"bonke abalandela iziqondiso zakhe balokuzwisisa okuhle.","poem":2},{"lineBreak":true},{"text":"Kungokwakhe ukudunyiswa kwaphakade.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}