{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Dumisani uThixo.","poem":1},{"lineBreak":true},{"text":"Ubusisiwe umuntu owesaba uThixo,","poem":1},{"text":"othokoza kakhulu ngemilayo yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Abantwabakhe bazaba lamandla elizweni;","poem":1},{"text":"isizukulwane soqotho sizabusiswa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inotho lenzuzo kusendlini yakhe,","poem":1},{"text":"lokulunga kwakhe kumi laphakade.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lasebumnyameni kuyavela ukukhanya kwabaqotho,","poem":1},{"text":"emuntwini olomusa, olesihawu lolungileyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ubuhle buzakwehlela kuye ophanayo loweboleka ekhululekile,","poem":1},{"text":"oqhuba zonke izinto zakhe ngemfanelo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngeqiniso kayikunyikinyeka;","poem":1},{"text":"umuntu olungileyo uzakhunjulwa lanininini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akayikwesaba imibiko emibi;","poem":1},{"text":"inhliziyo yakhe ichumile, yethembele kuThixo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inhliziyo yakhe ikhululekile, akalakwesaba;","poem":1},{"text":"ekucineni uzakhangela izitha zakhe ngokunqoba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uhlakazele izipho zakhe kubayanga ezindaweni zonke,","poem":1},{"text":"ukulunga kwakhe kumi laphakade;","poem":2},{"lineBreak":true},{"text":"uphondo lwakhe luzaphakanyiselwa phezulu ngenhlonipho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Umuntu omubi uzakubona lokhu afuthelane,","poem":1},{"text":"uzagedla amazinyo akhe, acikizeke emzimbeni;","poem":2},{"lineBreak":true},{"text":"izinkanuko zababi zizaphetha ziyize.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}