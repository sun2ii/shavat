{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Dumisani uThixo.","poem":1},{"lineBreak":true},{"text":"Dumisani uThixo, lina zinceku zakhe,","poem":1},{"text":"dumisani ibizo likaThixo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kalidunyiswe ibizo likaThixo,","poem":1},{"text":"khona manje kanye laphakade.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kusukela okuphuma khona ilanga kusiyafika lapho elitshona khona,","poem":1},{"text":"kufanele lidunyiswe ibizo likaThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"UThixo uphakeme ngaphezu kwezizwe zonke,","poem":1},{"text":"inkazimulo yakhe ngaphezulu kwamazulu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngubani na onjengoThixo uNkulunkulu wethu,","poem":1},{"text":"oNguye ohlezi ebukhosini phezulu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"okhothama akhangele phansi","poem":1},{"text":"emazulwini lasemhlabeni?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Uyabavusa abampofu othulini,","poem":1},{"text":"aphakamise abaswelayo esilotheni;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"abahlalise lamakhosana,","poem":1},{"text":"amakhosana abantu bakibo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lomfazi oyinyumba umenza ahlale kuhle emzini wakhe","poem":1},{"text":"afane lalowo ongunina wabantwana.","poem":2},{"lineBreak":true},{"text":"Dumisani uThixo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}