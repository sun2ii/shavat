_break"},{"type":"verse","number":7,"content":[{"text":"Thuthumela, we mhlaba, phambi kukaThixo,","poem":1},{"text":"phambi kukaNkulunkulu kaJakhobe,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"owaphendula idwala laba lichibi,","poem":1},{"text":"idwala eliqinileyo laba ngumthombo wamanzi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}