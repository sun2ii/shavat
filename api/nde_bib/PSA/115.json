{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Kakungabi kithi, Oh Thixo, hatshi kithi","poem":1},{"text":"kodwa kwelakho ibizo kakube lenkazimulo,","poem":2},{"lineBreak":true},{"text":"ngenxa yothando lokuthembeka Kwakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kungani izizwe zisithi,","poem":1},{"text":"“Ungaphi uNkulunkulu wabo na?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"UNkulunkulu wethu usezulwini;","poem":1},{"text":"wenza loba yini ayithandayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kodwa izithombe zabo yisiliva legolide,","poem":1},{"text":"zenziwe ngezandla zabantu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zilemilomo, kodwa kazikhulumi,","poem":1},{"text":"amehlo, kodwa kaziboni;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"zilezindlebe, kodwa kazizwa,","poem":1},{"text":"amakhala, kodwa kazinuki lutho;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"zilezandla, kodwa kazenelisi ukuthinta,","poem":1},{"text":"inyawo, kodwa kazihambi;","poem":2},{"lineBreak":true},{"text":"njalo ngeke nje zenze umsindo ngemphimbo yazo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Labo abazenzayo bazakuba njengazo,","poem":1},{"text":"kube njalo lakulabo abathemba kuzo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Oh ndlu ka-Israyeli, methembe uThixo","poem":1},{"text":"lusizo lwabo lesihlangu sabo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Oh, ndlu ka-Aroni, methembe uThixo","poem":1},{"text":"ulusizo lwabo lesihlangu sabo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lina elimesabayo, thembani kuThixo","poem":1},{"text":"ulusizo lwabo lesihlangu sabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"UThixo uyasikhumbula njalo uzasibusisa:","poem":1},{"text":"Uzayibusisa indlu ka-Israyeli,","poem":2},{"lineBreak":true},{"text":"uzayibusisa indlu ka-Aroni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"uzababusisa labo abamesabayo uThixo","poem":1},{"text":"abancinyane labakhulu ngokufananayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sengathi uThixo angalenza lande,","poem":1},{"text":"lonke lina kanye labantwana benu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sengathi lingabusiswa nguThixo","poem":1},{"text":"uMenzi wezulu lomhlaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"NgakaThixo amazulu aphezu kwakho konke,","poem":1},{"text":"kodwa umhlaba wawunika abantu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kakusibo abafileyo abadumisa uThixo,","poem":1},{"text":"labo abangena phansi ekuthuleni;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"yithi esimbabazayo uThixo,","poem":1},{"text":"khona manje kanye laphakade.","poem":2},{"lineBreak":true},{"text":"Dumisani uThixo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}