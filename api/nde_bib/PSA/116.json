{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Ngiyamthanda uThixo ngoba walizwa ilizwi lami;","poem":1},{"text":"wezwa ukukhala kwami ngicela umusa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngoba wangipha indlela yakhe,","poem":1},{"text":"ngizambiza kokuphela nxa ngisaphila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Izibopho zokufa zangithandela,","poem":1},{"text":"ubuhlungu obukhulu bengcwaba bangehlela;","poem":2},{"lineBreak":true},{"text":"ngagajelwa yikuhlupheka losizi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngasengibiza ibizo likaThixo :","poem":1},{"text":"“Oh Thixo ake ungisindise!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"UThixo ulomusa njalo ulungile;","poem":1},{"text":"uNkulunkulu wethu ulesihawu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"UThixo uvikela abalenhliziyo ethobekileyo;","poem":1},{"text":"ngathi ngihluphekile kakhulu wangisindisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Phumula njalo, we mphefumulo wami,","poem":1},{"text":"ngoba uThixo ukwenzile ukulunga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngoba wena Thixo,","poem":1},{"text":"uwukhulule umphefumulo wami ekufeni,","poem":2},{"lineBreak":true},{"text":"amehlo ami ezinyembezini,","poem":2},{"lineBreak":true},{"text":"lezinyawo zami azaze zakhubeka,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ukuze ngihambe phambi kukaThixo","poem":1},{"text":"elizweni labaphilayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngathembela kuThixo; ngakho ngasengisithi,","poem":1},{"text":"“Ngiyahlupheka kakhulu.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngiphakathi kokulahla ithemba ngathi,","poem":1},{"text":"“Bonke abantu balamanga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ngingambonga ngani uThixo","poem":1},{"text":"ngabo bonke ubuhle bakhe kimi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngizayiphakamisa inkezo yensindiso","poem":1},{"text":"ngimemeze ibizo likaThixo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngizazigcwalisa izifungo zami kuThixo","poem":1},{"text":"phambi kwabo bonke abantu bakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kuligugu emehlweni kaThixo","poem":1},{"text":"ukufa kwabathembekileyo bakhe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Oh Thixo, ngempela ngiyinceku Yakho,","poem":1},{"text":"indodana yencekukazi yakho;","poem":2},{"lineBreak":true},{"text":"usungikhulule emaketaneni ami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ngizakwenzela umhlatshelo womnikelo wokubonga","poem":1},{"text":"ngilibize ibizo likaThixo","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngizazigcwalisa izifungo zami kuThixo","poem":1},{"text":"phambi kwabo bonke abantu bakhe,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"emagumeni endlu kaThixo","poem":1},{"text":"phakathi kwakho, wena Jerusalema.","poem":2},{"lineBreak":true},{"text":"Dumisani uThixo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}