{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"Mbongeni uThixo ngoba ulungile;","poem":1},{"text":"uthando lwakhe lumi laphakade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"U-Israyeli katsho athi:","poem":1},{"text":"“Uthando lwakhe lumi laphakade.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kayithi indlu ka-Aroni:","poem":1},{"text":"“Uthando lwakhe lumi laphakade.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akuthi bonke abamesabayo uThixo bathi:","poem":1},{"text":"“Uthando lwakhe lumi laphakade.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngathi ngidabukile ngakhala kuThixo,","poem":1},{"text":"waphendula ngokungikhulula.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"UThixo ulami, angiyikwesaba.","poem":1},{"text":"Umuntu angenzani kimi na?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"UThixo ulami; ungumsizi wami.","poem":1},{"text":"Ngizazinyonkoloza ngegunya izitha zami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kungcono ukuphephela kuThixo","poem":1},{"text":"kulokuthemba umuntu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kungcono ukuphephela kuThixo","poem":1},{"text":"kulokuthemba amakhosana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zonke izizwe zangihanqa,","poem":1},{"text":"kodwa ngegama likaThixo ngazichitha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zangihanqa inxa zonke","poem":1},{"text":"kodwa ngegama likaThixo ngazichitha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Zangiminyezela njengezinyosi","poem":1},{"text":"kodwa zafa masinyane njengokungunguma komlilo wameva;","poem":2},{"lineBreak":true},{"text":"ngebizo likaThixo ngazichitha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngasunduzelwa emuva ngaphose ngawa,","poem":1},{"text":"kodwa uThixo wangisiza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"UThixo ungamandla ami lengoma yami;","poem":1},{"text":"yena useyikusindiswa kwami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Imisindo yentokozo lokunqoba","poem":1},{"text":"iphuma emathenteni abalungileyo:","poem":2},{"text":"“Isandla sokunene sikaThixo senzile izinto ezinkulu!","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Isandla sokunene sikaThixo siphakanyisiwe kakhulu;","poem":2},{"lineBreak":true},{"text":"isandla sokunene sikaThixo senzile izinto ezinkulu!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Angizukufa kodwa ngizaphila,","poem":1},{"text":"ngizamemezela lokho akwenzileyo uThixo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"UThixo ungitshayile kakhulu,","poem":1},{"text":"kodwa kanginikelanga ekufeni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngivulela amasango okulunga;","poem":1},{"text":"ngizangena ngimbonge uThixo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nanti isango likaThixo","poem":1},{"text":"okungangena khona abalungileyo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngizakubonga, ngoba ungiphendulile;","poem":1},{"text":"usuyinsindiso yami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ilitshe ababelilahlile","poem":1},{"text":"seliyilona ilitshe lekhoneni;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"uThixo ukwenzile lokhu;","poem":1},{"text":"njalo kuyamangalisa emehlweni ethu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Leli lilanga alenzileyo uThixo;","poem":1},{"text":"kasithokoze sijabule ngalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Oh Thixo, sisindise;","poem":1},{"text":"Oh Thixo, siphumelelise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ubusisiwe lowo obuya ngebizo likaThixo.","poem":1},{"text":"Siyakubusisa sisendlini kaThixo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"UThixo unguNkulunkulu,","poem":1},{"text":"wenzile ukukhanya kwakhe kwehlela phezu kwethu.","poem":2},{"text":"Liphethe izingatshana, ngenani edibini lomgido","poem":1},{"text":"lize liyefika empondweni ze-alithare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"UnguNkulunkulu wami, ngizakubonga;","poem":1},{"text":"unguNkulunkulu wami, ngizakuphakamisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Mbongeni uThixo ngoba ulungile;","poem":1},{"text":"uthando lwakhe lumi kuze kube phakade.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}