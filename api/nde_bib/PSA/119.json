"text":"ngilokhu ngiyifunda imithetho yakho elungileyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngizazilalela izimemezelo zakho;","poem":1},{"text":"ungangikhalali ngempela.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ijaha lingaphila njani impilo ehlambulukileyo?","poem":1},{"text":"Ngokuphila ngendlela yelizwi lakho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngikudinga ngenhliziyo yami yonke;","poem":1},{"text":"ungangiyekeli ngiphambuke emilayweni yakho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ilizwi lakho ngilifihlile enhliziyweni yami","poem":1},{"text":"ukuze ngingenzi isono kuwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Udumo kalube kuwe, Oh Thixo;","poem":1},{"text":"ngifundisa izimemezelo zakho.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngezindebe zami ngiyayibala yonke","poem":1},{"text":"imithetho ephuma emlonyeni wakho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kuyangithokozisa ukulandela izimiso zakho","poem":1},{"text":"njengomuntu ethabela inotho enkulu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngiyanakana ngezimiso zakho","poem":1},{"text":"ngikhumbule ngezindlela zakho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngiyathokoza ngezimemezelo zakho;","poem":1},{"text":"angiyikulidela ilizwi lakho.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yenzele okuhle inceku yakho ukuba ngiphile;","poem":1},{"text":"ngizalilalela ilizwi lakho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vula amehlo ami ukuze ngibone","poem":1},{"text":"izinto ezimangalisayo emthethweni wakho.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngiyisihambi emhlabeni;","poem":1},{"text":"ungangifihleli imilayo yakho.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Umphefumulo wami uhugekile ngokulangazelela","poem":1},{"text":"imithetho yakho ngezikhathi zonke.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Uyabakhuza abaklolodayo,","poem":1},{"text":"abaqalekisiweyo abaphambukayo emithethweni yakho.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Susa kimi ihlazo lokweyisa,","poem":1},{"text":"ngoba ngiyazigcina izimiso zakho.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Loba ababusi behlangana ngami bengigcona,","poem":1},{"text":"inceku yakho izanakana ngezimemezelo zakho.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Izimiso zakho ziyinjabulo yami;","poem":1},{"text":"zingabacebisi bami.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngehliselwe phansi othulini;","poem":1},{"text":"londoloza impilo yami njengokwelizwi lakho.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngabalisa izindlela zami wangiphendula;","poem":1},{"text":"ngifundisa izimiso zakho.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ngenza ngizwisise imfundiso yezimiso zakho;","poem":1},{"text":"lapho-ke ngizanakana ngezimanga zakho.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Umphefumulo wami ukhathele ngosizi;","poem":1},{"text":"ngiqinisa njengokwelizwi lakho.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ngivikela ezindleleni zenkohliso;","poem":1},{"text":"woba lobubele kimi ngokomthetho wakho.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ngikhethe indlela yeqiniso;","poem":1},{"text":"sengibeke inhliziyo yami emithethweni yakho.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ngibambelele ezimisweni zakho, Oh Thixo;","poem":1},{"text":"ungangiyekeli ngiyangeka.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngigijima ngendlela yemithetho yakho,","poem":1},{"text":"ngoba uyikhulule inhliziyo yami.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ngifundisa, Oh Thixo; ukulandela izimemezelo zakho;","poem":1},{"text":"ukuthi ngizigcine kuze kufike ekucineni.","p