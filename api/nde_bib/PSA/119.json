amakhosi","poem":1},{"text":"ngingabi lamahloni,","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ngoba ngithokoza ngisemilayweni yakho","poem":1},{"text":"ngoba ngiyayithanda.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ngizaphakamisa izandla zami emilayweni yakho engiyithandayo,","poem":1},{"text":"nginakana ngezimemezelo zakho.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Khumbula ilizwi lakho encekwini yakho,","poem":1},{"text":"ngoba usungiphe ithemba.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Induduzo yami phakathi kokuhlupheka kwami yile:","poem":1},{"text":"Isithembiso sakho sigcina impilo yami.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Abaklolodayo bangihleka baze bakholise,","poem":1},{"text":"kodwa kangiphambuki emthethweni wakho.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Ngiyayikhumbula imithetho yakho yekadeni, Oh Thixo,","poem":1},{"text":"ngifumana ukududuzeka kuyo.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Ngithukuthela ngife ngenxa yababi,","poem":1},{"text":"asebedele umthetho wakho.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Izimemezelo zakho ziyiyo injongo yengoma yami","poem":1},{"text":"loba ngingabe ngihlala ngaphi","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Ebusuku ngiyalikhumbula ibizo lakho, Oh Thixo,","poem":1},{"text":"njalo ngizawugcina umthetho wakho.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Le yiyo injayelo yokwenza kwami:","poem":1},{"text":"Ngiyayilalela imithetho yakho.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Uyingxenye yami, Oh Thixo,","poem":1},{"text":"ngithembisile ukulalela amazwi akho.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Ngiyabudinga ubuso bakho ngenhliziyo yami yonke;","poem":1},{"text":"woba lobubele kimi njengesithembiso sakho.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Sengizihlolile izindlela zami","poem":1},{"text":"ngaphendula izinyathelo zami zaya ezimisweni zakho.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Ngizaphangisa ngingaphuzi","poem":1},{"text":"ukulalela imilayo yakho.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Loba ababi bengangibopha ngentambo,","poem":1},{"text":"angiyikuwukhohlwa umthetho wakho.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Phakathi kobusuku ngivukela ukukubonga","poem":1},{"text":"ngemithetho yakho emihle.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Ngingumngane kubo bonke abakwesabayo,","poem":1},{"text":"kubo bonke abalandela imithetho yakho.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Umhlaba ugcwele uthando lwakho, Oh Thixo;","poem":1},{"text":"ngifundisa izimiso zakho.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Senzele okuhle isisebenzi sakho","poem":1},{"text":"njengelizwi lakho, Oh Thixo.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Ngifundisa ulwazi lokwahlulela okufaneleyo,","poem":1},{"text":"ngoba ngiyayikholwa imilayo yakho.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Ngingakabi sekuhluphekeni ngalahleka,","poem":1},{"text":"kodwa manje sengilalela ilizwi lakho.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Ulungile njalo okwenzayo kulungile;","poem":1},{"text":"ngifundisa izimiso zakho.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Lokuba abaklolodayo bengibhaceke ngamanga,","poem":1},{"text":"ngiyazigcina izimiso zakho ngenhliziyo yami yonke.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Inhliziyo zabo zilolunya kazilazwelo,","poem":1},{"text":"kodwa mina ngijabula ngomthetho wakho.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Kwakukuhle kimi ukuthi ngihlutshwe","poem":1},{"text":"ukuze ngifunde izimiso zakho.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Umthetho ophuma emlonyeni wakho uligugu kimi","poem":1},{"text":"okudlula inhlamvu zesiliva legolide eziyizinkulungwane.","poem":2}]},{"type":"verse","number":73,"content":[{"text":"Izandla zakho zangenza zangibumba,","poem":1},{"text":"ngipha ukuzwisisa ukuze ngifunde imilayo yakho.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Sengathi labo abakwesabayo bangathokoza nxa bengibona,","poem":1},{"text":"ngoba sengibeke ithemba lami elizwini lakho.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Ngiyazi, Thixo, ukuthi imithetho yakho ilungile,","poem":1},{"text":"lokuthi ungihlukuluzile ngenxa yokuthembeka kwakho.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Sengathi uthando lwakho olungaphuthiyo lungaba yinduduzo kimi,","poem":1},{"text":"njengesithembiso sakho encekwini yakho.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Isihawu sakho kasize kimi ukuze ngiphile,","poem":1},{"text":"umthetho wakho uyikuthokoza kwami.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Sengathi abaklolodayo bangayangiswa ngokungigcona ngingonanga lutho;","poem":1},{"text":"kodwa mina ngizanakana ngemithetho yakho.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"Sengathi labo abakwesabayo bangaphendukela kimi,","poem":1},{"text":"bona abezwisisa izimiso zakho.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Sengathi inhliziyo yami ingaba msulwa ngezimiso zakho,","poem":1},{"text":"ukuze ngingayangiswa.","poem":2}]},{"type":"verse","number":81,"content":[{"text":"Umphefumulo wami uyacikizeka ngokulangazelela insindiso yakho,","poem":1},{"text":"kodwa ngilibekile ithemba lami elizwini lakho.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Amehlo ami aseze efiphala ngokulinda isithembiso sakho;","poem":1},{"text":"ngithi, “Uzaze ungiduduze nini na?”","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Lanxa nginjengesixaxa sewayini esesikhumba sifuswe entuthwini,","poem":1},{"text":"kangizilibali izimiso zakho.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Inceku yakho izalinda kuze kube nini na?","poem":1},{"text":"Uzabajezisa nini abangihluphayo na?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Abaklolodayo bangigebhela amagodi,","poem":1},{"text":"bephikisa umthetho wakho.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Yonke imilayo yakho ithembekile,","poem":1},{"text":"ngisiza, ngoba abantu bayangichukuluza kungelasizatho.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Baphose bangesula emhlabeni,","poem":1},{"text":"kodwa kangiyilahlanga imithetho yakho.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"Ngivuselela ngomusa wakho olothando,","poem":1},{"text":"ukuze ngigcine izimiso zomlomo wakho.","poem":2}]},{"type":"verse","number":89,"content":[{"text":"Ilizwi lakho, Oh Thixo, kalipheli lanini;","poem":1},{"text":"limi liqinile emazulwini.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Ukuthembeka kwakho kukhona kuzozonke izizukulwane;","poem":1},{"text":"wawumisa umhlaba, uzakuma kokuphela.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Imithetho yakho imi lanamhla lokhu,","poem":1},{"text":"ngoba zonke izinto zikhonza wena.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Aluba umthetho wakho ubungesiyo injabulo yami","poem":1},{"text":"ngabe ngabhubha ngiphakathi kokuhlupheka kwami.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Kangisoze ngafa ngayilibala imithetho yakho,","poem":1},{"text":"ngoba ngayo uyilondolozile impilo yami.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Ngisindisa ngoba ngingowakho;","poem":1},{"text":"ngiyidingisisile imithetho yakho.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"Ababi balindele ukungichitha,","poem":1},{"text":"kodwa ngizanakana ngezimiso zakho.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Kukho konke ukuphelela ngibona kulomkhawulo;","poem":1},{"text":"kodwa imilayo yakho ayilamingcele.","poem":2}]},{"type":"verse","number":97,"content":[{"text":"Oh, ngiwuthanda kangakanani umthetho wakho!","poem":1},{"text":"Ngikhumbula ngawo ilanga lonke.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"Imilayo yakho iyangihlakaniphisa kulezitha zami,","poem":1},{"text":"ngoba ngihlezi ngilayo.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Ngicacile ukuqedisisa kwami kulabafundisi bami,","poem":1},{"text":"ngoba ngiyanakana ngezimiso zakho.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Ngiyezwisisa okudlula abadala,","poem":1},{"text":"ngoba ngiyayilalela imithetho yakho.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Inyawo zami kaziyinyathelanga layiphi indlela embi","poem":1},{"text":"ukuze ngilalele ilizwi lakho.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Kangiphambukanga emithethweni yakho,","poem":1},{"text":"ngoba wena ngokwakho ungifundisile.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Amazwi akho anambitheka kamnandi kimi,","poem":1},{"text":"amnandi kulenyosi emlonyeni wami!","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Ngiyazuza ukuqedisisa emithethweni yakho;","poem":1},{"text":"ngakho ngiyayizonda loba layiphi indlela engalunganga.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"Ilizwi lakho liyisibane ezinyaweni zami","poem":1},{"text":"liyikukhanya kwendlela yami.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Sengenzile isifungo ngasiqinisa,","poem":1},{"text":"ukuthi ngizalandela imithetho yakho elungileyo.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Sengihlupheke kakhulu;","poem":1},{"text":"londoloza impilo yami, Oh Thixo","poem":2},{"lineBreak":true},{"text":"njengokutshiwo yilizwi lakho.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Yamukela, Oh Thixo,","poem":1},{"text":"indumiso epheleleyo ngomlomo wami,","poem":2},{"lineBreak":true},{"text":"ungifundise imithetho yakho.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Loba ngihlezi ngizibona sengingene engozini,","poem":1},{"text":"kangiyi kuwulibala umthetho wakho.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Ababi sebengithiye ngomjibila","poem":1},{"text":"kodwa kangiphambukanga emithethweni yakho.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Izimiso zakho ziyilifa lami laphakade;","poem":1},{"text":"ziyintokozo yenhliziyo yami.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Inhliziyo yami izimisele ukugcina imilayo yakho","poem":1},{"text":"kuze kube sekupheleni.","poem":2}]},{"type":"verse","number":113,"content":[{"text":"Ngiyabazonda abantu abangongqondombili,","poem":1},{"text":"kodwa ngiyawuthanda umthetho wakho.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"Uyisiphephelo sami lesihlangu sami;","poem":1},{"text":"sengibeke ithemba lami elizwini lakho.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Sukani kimi lina benzi bobubi,","poem":1},{"text":"ukuze ngikwazi ukugcina imilayo kaNkulunkulu wami!","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Ngisekela njengesithembiso sakho ukuze ngiphile;","poem":1},{"text":"ithemba lami lingaze labhidlika.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"Ngiqinisa ukuze ngikhululwe;","poem":1},{"text":"ngizahlala ngizinanza izimiso zakho.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"Uyabalahla bonke labo abaphambuka ezimisweni zakho,","poem":1},{"text":"ngoba ukukhohlisa kwabo kuyize.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Bonke ababi bomhlaba uyabalahlela kude njengezibi;","poem":1},{"text":"ngakho ngiyazithanda izimiso zakho.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Inyama yami iyathuthumela ngokukwesaba;","poem":1},{"text":"ngizwa ngiyesaba imithetho yakho.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"Ngenzile okulungileyo lokufaneleyo;","poem":1},{"text":"ungangiyekeleli abancindezeli bami.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"Qinisa impilakahle yenceku yakho;","poem":1},{"text":"ungayekeli abaklolodayo bangincindezele.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Amehlo ami asefiphala elokhu ekhangele insindiso yakho,","poem":1},{"text":"ekhangele isithembiso sakho esilungileyo.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Yenza encekwini yakho ngokothando lwakho,","poem":1},{"text":"ungifundise izimiso zakho.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Ngiyinceku yakho; ngipha ukuqedisisa","poem":1},{"text":"ukuthi ngizwisise izimiso zakho.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Sekuyisikhathi sakho sokuthi wenze okwakho, Oh Thixo","poem":1},{"text":"umthetho wakho uyephulwa nje.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Ngoba ngiyayithanda imilayo yakho kulegolide,","poem":1},{"text":"kulegolide elicengekileyo,","poem":2}]},{"type":"verse","number":128,"content":[{"text":"njalo njengoba ngisithi imithetho yakho ilungile,","poem":1},{"text":"ngiyayizonda yonke indlela engaqondanga.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"Izimiso zakho ziyamangalisa;","poem":1},{"text":"ngakho ngiyazilalela.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Ukwambulwa kwamazwi akho kuletha ukukhanya;","poem":1},{"text":"kunika ukuzwisisa kwabayizithutha.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Ngivula umlomo wami ngikhefuzele,","poem":1},{"text":"ngilangazelela imilayo yakho.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Phendukela kimi ube lomusa kimi,","poem":1},{"text":"njengoba uhlezi ukwenza kwabathanda ibizo lakho.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Qondisa izinyathelo zami ngokwelizwi lakho;","poem":1},{"text":"kakungabi lesono esingibusayo.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Ngihlenga ekuncindezelweni ngabantu,","poem":1},{"text":"ukuze ngilalele imithetho yakho.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Yenza ubuso bakho bukhanye encekwini yakho,","poem":1},{"text":"ungifundise izimiso zakho.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Imifula yezinyembezi iyajuluka emehlweni ami,","poem":1},{"text":"ngoba umthetho wakho kawulalelwa.","poem":2}]},{"type":"verse","number":137,"content":[{"text":"Ulungile wena Thixo,","poem":1},{"text":"lemithetho yakho ilungile.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Izimiso ozibekileyo zilungile;","poem":1},{"text":"zithembekile ngokupheleleyo.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Ukutshiseka kwami kuyangicoba,","poem":1},{"text":"ngoba izitha zami kaziwananzi amazwi akho.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Izithembiso zakho zihlolisisiwe kakhulu,","poem":1},{"text":"inceku yakho iyazithanda.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Loba ngingumuntukazana ngiseyiswa,","poem":1},{"text":"angiyikhohlwa imithetho yakho.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"Ukulunga kwakho kumi laphakade","poem":1},{"text":"njalo umthetho wakho uliqiniso.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Uhlupho losizi kuyakungehlele,","poem":1},{"text":"kodwa imilayo yakho iyikuthokoza kwami.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Izimiso zakho zihlezi zilungile;","poem":1},{"text":"ngipha ukuzwisisa ukuze ngiphile.","poem":2}]},{"type":"verse","number":145,"content":[{"text":"Ngiyamemeza ngayo yonke inhliziyo yami;","poem":1},{"text":"ngiphendula, Thixo, mina ngizalalela imithetho yakho.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"Ngiyakubiza, ngisindisa mina","poem":1},{"text":"ngizagcina izimiso zakho.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"Ngivuka emathathakusa ngikhale kuwe ngicela usizo;","poem":1},{"text":"sengibeke ithemba lami elizwini lakho.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Amehlo ami alala ekhangele ngemilindo yonke yobusuku,","poem":1},{"text":"ukuze ngicabange ngezithembiso zakho.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Zwana ilizwi lami ngokuya kothando lwakho;","poem":1},{"text":"londoloza impilo yami, Oh Thixo ngokuya kwemithetho yakho.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Labo abakha amasu amabi baseduze,","poem":1},{"text":"kodwa bakhatshana lomthetho wakho.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"Ikanti useduze, wena Thixo,","poem":1},{"text":"lemilayo yakho yonke iqinisile.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Sekukade ngafunda ezimisweni zakho","poem":1},{"text":"ukuthi wazenzela ukuthi zime lanininini.","poem":2}]},{"type":"verse","number":153,"content":[{"text":"Khangela ukuhawula kwami ungikhulule,","poem":1},{"text":"ngoba kangiwukhohlwanga umthetho wakho.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Ake ungimele ukuze ungihlenge;","poem":1},{"text":"londoloza impilo yami njengesithembiso sakho.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Insindiso ikhatshana kwababi,","poem":1},{"text":"ngoba kabazidingi izimiso zakho.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Isihawu sakho sikhulu, Oh Thixo","poem":1},{"text":"londoloza impilo yami mayelana lemithetho yakho.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Zinengi izitha ezingihluphayo,","poem":1},{"text":"kodwa kangiphambukanga ezimisweni zakho.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"Ngikhangela abangakholwayo ngibenyanye,","poem":1},{"text":"ngoba kabalilaleli ilizwi lakho.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"Ake ubone ukuthi ngiyithanda kanganani imithetho yakho;","poem":1},{"text":"londoloza impilo yami, Oh Thixo, ngokothando lwakho.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Wonke amazwi akho aqinisile;","poem":1},{"text":"yonke imithetho yakho elungileyo ngeyaphakade.","poem":2}]},{"type":"verse","number":161,"content":[{"text":"Ababusi bayangihlupha kungelasizatho,","poem":1},{"text":"kodwa inhliziyo yami iyaliqhuqhela ilizwi lakho.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Isithembiso sakho siyangithokozisa","poem":1},{"text":"ingathi ngumuntu othole impango enkulu.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Amanga ngiyawazonda njalo ngiyawenyanya","poem":1},{"text":"kodwa umthetho wakho ngiyawuthanda.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Ngikudumisa kasikhombisa ngelanga","poem":1},{"text":"ngenxa yemithetho yakho elungileyo.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Kukhulu ukuthula abalakho labo abathanda umthetho wakho,","poem":1},{"text":"kakulalutho olungabakhubekisa.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Ngiyilindele insindiso yakho, Oh Thixo","poem":1},{"text":"njalo ngiyayilandela imilayo yakho.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Ngiyazilalela izimiso zakho,","poem":1},{"text":"ngoba ngiyazithanda kakhulu.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"Ngiyayilalela imithetho yakho lezimiso zakho,","poem":1},{"text":"ngoba uyazazi zonke izindlela zami.","poem":2}]},{"type":"verse","number":169,"content":[{"text":"Sengathi ukukhala kwami kungafika kuwe, Oh Thixo","poem":1},{"text":"ngipha ukuzwisisa njengelizwi lakho.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Sengathi ukuncenga kwami kungafika kuwe;","poem":1},{"text":"ngikhulula njengesithembiso sakho.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Sengathi indebe zami zingageleza indumiso yakho,","poem":1},{"text":"ngoba uyangifundisa imithetho yakho.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Sengathi ulimi lwami lungalihlabela ilizwi lakho,","poem":1},{"text":"ngoba yonke imilayo yakho ilungile.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Sengathi isandla sakho singalungela ukungisiza,","poem":1},{"text":"ngoba sengikhethe imithetho yakho.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Ngilangazelela insindiso yakho, Oh Thixo","poem":1},{"text":"ngoba umthetho wakho uyinjabulo yami.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Kangiphile ukuze ngikudumise,","poem":1},{"text":"sengathi njalo lemithetho yakho ingangisekela.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Ngiphambukile njengemvu elahlekileyo.","poem":1},{"text":"Yidinge inceku yakho,","poem":2},{"lineBreak":true},{"text":"ngoba kangikayikhohlwa imilayo yakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}