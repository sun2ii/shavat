{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ngendlela yesheminithi. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Siza Thixo, ngoba kabasekho abakholwayo;","poem":1},{"text":"abathembekileyo sebenyamalele kabasekho ebantwini.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bonke baqamba amanga kubomakhelwane babo;","poem":1},{"text":"izindebe zabo eziyengayo","poem":2},{"lineBreak":true},{"text":"zihlezi zikhuluma inkohliso esezinhliziyweni zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sengathi uThixo angaziquma zonke izindebe ezikhohlisayo","poem":1},{"text":"kanye laluphi ulimi oluzikhukhumezayo","poem":2}]},{"type":"verse","number":4,"content":[{"text":"oluthi, “Sizanqoba ngendimi zethu;","poem":1},{"text":"izindebe zethu zizasilwela","poem":2},{"lineBreak":true},{"text":"ngubani oyinkosi yethu na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ngenxa yokuncindezelwa kwabayanga lokububula kwabaswelayo,","poem":1},{"text":"sengizavuka khathesi,” kutsho uThixo.","poem":2},{"lineBreak":true},{"text":"“Ngizabavikela kulabo ababachukuluzayo.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Njalo amazwi kaThixo amsulwa,","poem":1},{"text":"njengesiliva esicengwe esithandweni somlilo esebumba,","poem":2},{"lineBreak":true},{"text":"njengegolide elihlanjululwe kasikhombisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Oh Thixo, uzahlala usiphephisile","poem":1},{"text":"njalo usivikele ebantwini ababi nini lanini.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ababi bayaklamasa santando","poem":1},{"text":"nxa bebona izinto ezilihlazo zidunyiswa ngabantu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}