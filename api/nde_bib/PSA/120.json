xt":"Sengihlale isikhathi eside kakhulu","poem":1},{"text":"phakathi kwalabo abazonda ukuthula.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngingumuntu wokuthula;","poem":1},{"text":"kodwa ngithi ngingakhuluma, sebefuna impi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}