{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["Ingoma yemiqanso. ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ngathokoza lalabo abathi kimi,","poem":1},{"text":"“Kasiye endlini kaThixo.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inyawo zethu zimi","poem":1},{"text":"ngaphakathi kwamasango akho, wena Jerusalema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"IJerusalema yakhiwe njengomuzi","poem":1},{"text":"obambeneyo waqina.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kulapho eziqansela khona izizwana,","poem":1},{"text":"izizwana zikaThixo,","poem":2},{"text":"ukudumisa ibizo likaThixo","poem":1},{"text":"njengalokho okwamiselwa u-Israyeli,","poem":2},{"lineBreak":true},{"text":"ukuba abonge ibizo likaThixo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kulapho okumi khona izihlalo zobukhosi ezokwahlulela,","poem":1},{"text":"izihlalo zobukhosi ezendlu kaDavida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Khulekelani ukuthula kwaseJerusalema:","poem":1},{"text":"“Sengathi labo abakuthandayo bangaphepha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sengathi kungaba lokuthula ngaphakathi kwemiduli yakho","poem":1},{"text":"lokuvikela ngaphakathi kwezinqaba zakho.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngenxa yabafowethu labangane bami,","poem":1},{"text":"ngizakuthi, “Ukuthula akube ngaphakathi kwakho.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngenxa yendlu kaThixo uNkulunkulu wethu,","poem":1},{"text":"ngizakhuthaza ukuphumelela kwakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}