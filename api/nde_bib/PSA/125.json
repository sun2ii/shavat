content":[{"text":"kodwa labo abaphambukela ezindleleni ezitshekileyo","poem":1},{"text":"uThixo uzabaxotsha kanye labenzi bobubi.","poem":2},{"lineBreak":true},{"text":"Ukuthula kakube ku-Israyeli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}