":6,"content":[{"text":"Lowo ophuma ekhala,","poem":1},{"text":"ethwele inhlanyelo ukuba ayehlanyela","poem":2},{"text":"uzabuya ngezingoma zentokozo,","poem":1},{"text":"ethwele izinyanda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}