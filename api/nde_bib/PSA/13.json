{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Koze kube nini, Oh Thixo? Uzangikhohlwa lanininini na?","poem":1},{"text":"Koze kube nini ungifihlela ubuso bakho na?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Koze kube nini ngitshukumisana lemicabango yami,","poem":1},{"text":"inhliziyo yami ihlale idabukile insuku zonke na?","poem":2},{"lineBreak":true},{"text":"Koze kube nini isitha sami sitshakala phezu kwami?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngizwela ungiphendule, Oh Thixo Nkulunkulu wami.","poem":1},{"text":"Khanyisela amehlo ami funa ngihle ngilale kokuphela;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"isitha sami sizakuthi, “Sengimehlule,”","poem":1},{"text":"labangizondayo bathokoze nxa ngisiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kodwa ngiyalwethemba uthando lwabo olungapheliyo;","poem":1},{"text":"inhliziyo yami iyathokoza ngensindiso yakho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngizahlabelela kuThixo,","poem":1},{"text":"ngoba ungenzele ukulunga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}