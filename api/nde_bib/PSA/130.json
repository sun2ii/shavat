{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Ingoma yemiqanso."]},{"type":"verse","number":1,"content":[{"text":"Ngingaphansi ekujuleni ngiyakhala kuwe, Thixo;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Thixo, zwana ilizwi lami.","poem":2},{"text":"Indlebe zakho kazilalele ukukhala kwami","poem":1},{"text":"ngicela umusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Aluba wena, Thixo ububhala phansi zonke izono,","poem":1},{"text":"ngubani ongema na Nkosi?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kodwa kuwe kulentethelelo;","poem":1},{"text":"ngalokho uyesatshwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngiyamlindela uThixo, umphefumulo wami uyalinda,","poem":1},{"text":"ngibeka ithemba lami elizwini lakho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Umphefumulo wami ulindela uThixo","poem":1},{"text":"okudlula abalindi bemelele ukusa,","poem":2},{"lineBreak":true},{"text":"okudlula abalindi bemelele ukusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"We Israyeli, beka ithemba lakho kuThixo,","poem":1},{"text":"ngoba kuye uThixo kulothando olungaphuthiyo","poem":2},{"lineBreak":true},{"text":"njalo kuye kulensindiso epheleleyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yena ngokwakhe uzahlenga u-Israyeli","poem":1},{"text":"kuzozonke izono zabo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}