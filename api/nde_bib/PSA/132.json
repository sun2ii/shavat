{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["Ingoma yemiqanso."]},{"type":"verse","number":1,"content":[{"text":"Oh Thixo, khumbula uDavida","poem":1},{"text":"ngezinhlupheko zonke azibhenselayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wafunga isifungo kuThixo","poem":1},{"text":"wenza isithembiso kuMninimandla kaJakhobe:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Angizukungena endlini yami","poem":1},{"text":"loba ngiye embhedeni wami,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"angiyikuwavumela amehlo ami ubuthongo,","poem":1},{"text":"akukuba lakuwozela enkopheni zami,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ngize ngifumane indawo kaThixo,","poem":1},{"text":"indawo yokuhlala uMninimandla kaJakhobe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sakuzwa lokhu e-Efrathi,","poem":1},{"text":"sakubona emangweni waseJayari:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Kasiye lapho ahlala khona;","poem":1},{"text":"kasikhonze phansi kwesihlalo sakhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Phakama, Oh Thixo, ubuye endaweni yakho yokuphumula,","poem":1},{"text":"wena umtshokotsho wesivumelwano elitshengisa amandla akho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sengathi abaphristi bakho bangembeswa ngokulunga;","poem":1},{"text":"sengathi labathembekileyo bakho bangahlabelela ngentokozo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngenxa yenceku yakho uDavida,","poem":1},{"text":"ungamfulatheli ogcotshiweyo wakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"UThixo wenza isifungo kuDavida,","poem":1},{"text":"isifungo esiqinileyo angakusaphula wathi:","poem":2},{"text":"“Omunye wezizukulwane zakho","poem":1},{"text":"ngizambeka esihlalweni sakho sobukhosi","poem":2}]},{"type":"verse","number":12,"content":[{"text":"aluba amadodana akho egcina isivumelwano sami","poem":1},{"text":"lezimiso engibafundisa zona,","poem":2},{"text":"lapho-ke amadodana abo azahlala esihlalweni sakho","poem":1},{"text":"sobukhosi kuze kube nini lanini.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngoba uThixo uyikhethile iZiyoni,","poem":1},{"text":"uyithandile ukuba yindawo yakhe yokuhlala:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Le yindawo yami yokuphumula lanini;","poem":1},{"text":"lapha ngizahlala ngisebukhosini, ngoba ngiyithandile","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ngizayibusisa ngokudla okunengi;","poem":1},{"text":"abayanga bayo ngizabasuthisa ngokudla.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngizavunulisa abaphristi bayo ngensindiso,","poem":1},{"text":"labathembekileyo bakhe bazahlabelela ngentokozo nini lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lapha ngizakhulisa uphondo lukaDavida","poem":1},{"text":"ngilungisele ogcotshiweyo wami isibane.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngizakwembathisa izitha ngehlazo,","poem":1},{"text":"kodwa umqhele osekhanda lakhe uzakhazimula.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}