{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Dumisani uThixo.","poem":1},{"lineBreak":true},{"text":"Dumisani ibizo likaThixo;","poem":1},{"text":"mdumiseni lina zinceku zikaThixo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"lina eliqhuba inkonzo endlini kaThixo,","poem":1},{"text":"emagumeni endlu kaNkulunkulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dumisani uThixo ngoba uThixo ulungile;","poem":1},{"text":"hlabelani indumiso ebizweni lakhe ngoba lokho kuhle.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoba uThixo usemkhethile uJakhobe ukuba ngowakhe,","poem":1},{"text":"u-Israyeli ukuba yinotho yakhe eligugu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngiyazi ukuthi uThixo mkhulu,","poem":1},{"text":"lokuthi iNkosi yethu inkulu kulabonkulunkulu bonke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"UThixo wenza loba yini ayifunayo,","poem":1},{"text":"emazulwini lasemhlabeni,","poem":2},{"lineBreak":true},{"text":"enlwandle lasezinzikini zazo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wenza amayezi aqubuka emikhawulweni yomhlaba;","poem":1},{"text":"uthuma umbane kanye lezulu,","poem":2},{"lineBreak":true},{"text":"avulele umoya oseziphaleni zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wawalahla phansi amazibulo aseGibhithe,","poem":1},{"text":"amazibulo abantu lawezinyamazana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wathumela izibonakaliso lezimangaliso zakhe","poem":1},{"text":"phakathi kwakho, wena Gibhithe,","poem":2},{"lineBreak":true},{"text":"phezu kukaFaro lezinceku zakhe zonke.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wazilahla phansi izizwe ezinengi","poem":1},{"text":"wabulala amakhosi alamandla,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"uSihoni inkosi yama-Amori,","poem":1},{"text":"u-Ogi inkosi yaseBhashani","poem":2},{"lineBreak":true},{"text":"lawo wonke amakhosi aseKhenani","poem":2}]},{"type":"verse","number":12,"content":[{"text":"wanika ilizwe labo laba yilifa,","poem":1},{"text":"ilifa labantu bakhe, u-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ibizo lakho, Oh Thixo, limi kuze kube nininini,","poem":1},{"text":"udumo lwakho, Oh Thixo, ezizukulwaneni zonke.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngoba uThixo uzabalamulela abantu bakhe","poem":1},{"text":"abe lesihawu ezincekwini zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Izithombe zezizwe ziyisiliva legolide,","poem":1},{"text":"zenziwe ngezandla zabantu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zilemilomo, kodwa kazikhulumi,","poem":1},{"text":"amehlo, kodwa kaziboni;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"zilezindlebe, kodwa kazizwa,","poem":1},{"text":"njalo kazilamphefumulo emilonyeni yazo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Labo abazenzayo bazakuba njengazo,","poem":1},{"text":"kube njalo lakulabo abathemba kuzo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wena ndlu ka-Israyeli, dumisa uThixo;","poem":1},{"text":"wena ndlu ka-Aroni, dumisa uThixo;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"wena ndlu kaLevi, dumisa uThixo","poem":1},{"text":"lina elimesabayo, dumisani uThixo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Udumo alube uThixo lusuka eZiyoni,","poem":1},{"text":"kuye ohlala eJerusalema.","poem":2},{"lineBreak":true},{"text":"Dumisani uThixo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}