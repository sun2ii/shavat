{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Ngasemifuleni yaseBhabhiloni sahlala phansi sakhala","poem":1},{"text":"lapho sasikhumbula iZiyoni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Khona lapho ezihlahleni zemidubu","poem":1},{"text":"saphanyeka amachacho ethu,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ngoba khonapho abathumbi bethu bacela izingoma kithi,","poem":1},{"text":"labahlukuluzi bethu bafuna izingoma zentokozo;","poem":2},{"lineBreak":true},{"text":"bathi, “Sihlabeleleni enye yezingoma zaseZiyoni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Singazihlabela kanjani izingoma zikaThixo","poem":1},{"text":"siselizweni lemzini na?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aluba ngikukhohlwa, Oh Jerusalema,","poem":1},{"text":"isandla sami sokunene kasilahlekelwe yibungcitshi baso.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sengathi ulimi lwami lunganamathela elwangeni lomlomo wami","poem":1},{"text":"uba ngingakukhumbuli wena,","poem":2},{"text":"uba ngingathathi iJerusalema","poem":1},{"text":"njengentokozo yami ephezu konke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Khumbula, Oh Thixo, ama-Edomi akwenzayo","poem":1},{"text":"mhla iJerusalema ithunjwa.","poem":2},{"text":"“Lidilizeni,” baklabalala,","poem":1},{"text":"“lidilizeni kanye lezisekelo zalo!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wena Ndodakazi yaseBhabhiloni,","poem":1},{"text":"oqunyelwe ukubhubha,","poem":2},{"lineBreak":true},{"text":"ubusisiwe lowo okuphindiselayo ngalokho okwenzileyo kithi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ubusisiwe lowo othatha insane zakho,","poem":1},{"text":"azisakazele ematsheni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}