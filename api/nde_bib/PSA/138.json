{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ngizakudumisa, Thixo, ngenhliziyo yami yonke;","poem":1},{"text":"phambi kwabo “nkulunkulu” ngizahlabelela udumo lwakho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngizakhothama ngikhangele ethempelini lakho elingcwele","poem":1},{"text":"ngidumise ibizo lakho,","poem":2},{"lineBreak":true},{"text":"ngenxa yothando lwakho lokuthembeka kwakho,","poem":2},{"text":"ngoba uphakamise ngaphezu kwezinto zonke","poem":1},{"text":"ibizo lakho lelizwi lakho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngabiza wena wangiphendula;","poem":1},{"text":"wangenza ngaba lesibindi lenhliziyo eqinileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sengathi wonke amakhosi omhlaba angakudumisa, Oh Thixo,","poem":1},{"text":"lapho esizwa amazwi omlomo wakho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sengathi bangahlabela ngezindlela zikaThixo","poem":1},{"text":"ngoba inkazimulo kaThixo inkulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Loba uThixo ephakeme, uyabananza abathobekileyo,","poem":1},{"text":"kodwa abazigqajayo ubazi ekhatshana labo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Loba ngihamba phakathi kohlupho","poem":1},{"text":"uyayilondoloza impilo yami;","poem":2},{"text":"uyaselula isandla sakho ukungivikela elakeni lwezitha zami,","poem":1},{"text":"ngesandla sakho sokunene uyangisindisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"UThixo uzagcwalisa icebo lakhe ngami;","poem":1},{"text":"uthando lwakho, Oh Thixo, lumi laphakade","poem":2},{"lineBreak":true},{"text":"ungawutshiyi umsebenzi wezandla zakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}