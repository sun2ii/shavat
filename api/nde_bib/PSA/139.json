{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. ElikaDavida. Ihubo."]},{"type":"verse","number":1,"content":[{"text":"Oh Thixo, usungihlolile","poem":1},{"text":"usungazi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Uyakwazi lapho ngihlala lalapho ngiphakama;","poem":1},{"text":"uyayibona imicabango yami lanxa ukhatshana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uyananzelela ukuphuma kwami lokulala phansi kwami;","poem":1},{"text":"uzazi kuhle zonke izindlela zami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ilizwi lingakabi khona elimini lwami","poem":1},{"text":"usulazi lonke, wena Thixo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uyangihonqolozela emuva laphambili;","poem":1},{"text":"ubekile isandla sakho phezu kwami.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ukwazi okunje kungumangaliso kimi,","poem":1},{"text":"kuphakeme kakhulu ngeke ngikufinyelele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngingaya ngaphi ngisuke eMoyeni wakho na?","poem":1},{"text":"Ngingabalekela ngaphi ngisuke kuwe na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngingakhuphukela emazulwini, ukhona lapho;","poem":1},{"text":"nxa ngilala ezinzikini, ukhona lapho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aluba ngindiza ngamaphiko okusa,","poem":1},{"text":"aluba ngisehlela ngaphetsheya kolwandle,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"lalapho isandla sakho sizangikhokhela,","poem":1},{"text":"isandla sakho sokunene sizangibamba singiqinise.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nxa ngisithi, “Ngempela ubumnyama buzangifihla","poem":1},{"text":"ukukhanya kube yibusuku eduze kwami,”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"lalobo bumnyama kabukuba mnyama kuwe;","poem":1},{"text":"ubusuku buzakhanya njengemini,","poem":2},{"lineBreak":true},{"text":"ngoba ubumnyama buyikukhanya kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngoba wadala ingaphakathi yobuyimi;","poem":1},{"text":"wangiphetha kuhle ndawonye esiswini sikamama.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngiyakudumisa ngokuthi ngabunjwa ngesimanga esesabekayo;","poem":1},{"text":"iyamangalisa imisebenzi yakho,","poem":2},{"lineBreak":true},{"text":"lokho ngikwazi kamhlophe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isimo samathambo ami sasingafihlekanga kuwe","poem":1},{"text":"lapho ngangisenziwa endaweni esithekileyo.","poem":2},{"lineBreak":true},{"text":"Lapho ngangiselukelwa ndawonye ezinzikini zomhlaba,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"amehlo akho awubona umzimba wami ungakabi lesimo.","poem":1},{"text":"Zonke insuku ezamiselwa mina zabhalwa encwadini yakho","poem":2},{"lineBreak":true},{"text":"lalunye lwazo lungakabi khona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iligugu elinganani kimi imicabango yakho, Oh Nkulunkulu!","poem":1},{"text":"Bukhulu kanganani ubunengi bayo!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Aluba ngingayibala","poem":1},{"text":"ingedlula ubunengi bezinhlamvu zetshebetshebe.","poem":2},{"lineBreak":true},{"text":"Ngithi nxa ngivuka ngibe ngilokhu ngilawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ungasake ubabulale ababi, awu Nkulunkulu!","poem":1},{"text":"Sukani kimi lina bachithi begazi!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bakhuluma ngawe beqonde ububi;","poem":1},{"text":"abakuphikisayo badlala ngebizo lakho.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kangibazondi yini abakuzondayo na Oh, Thixo,","poem":1},{"text":"ngibenyanye labo abakuvukelayo na?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ngiyabazonda ngenzondo yonke;","poem":1},{"text":"ngithi bayizitha zami.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngihlola, Oh Nkulunkulu, uyazi inhliziyo yami;","poem":1},{"text":"ngizama ukuze wazi ukunqineka kwemicabango yami.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ake ubone ingabe kulendledlana embi kimi,","poem":1},{"text":"ungihole ngendlela yaphakade.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}