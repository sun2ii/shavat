{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. KaDavida."]},{"type":"verse","number":1,"content":[{"text":"Isiwula sithi enhliziyweni yaso,","poem":1},{"text":"“AkulaNkulunkulu.”","poem":2},{"text":"Baxhwalile, izenzo zabo zibolile;","poem":1},{"text":"kakho loyedwa owenza okuhle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"UThixo ukhangela phansi esezulwini","poem":1},{"text":"emadodaneni abantu","poem":2},{"text":"ingabe bakhona yini abazwisisayo,","poem":1},{"text":"abamdingayo uNkulunkulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bonke baphambukile, bonke sebexhwalile;","poem":1},{"text":"kakho loyedwa owenza okuhle,","poem":2},{"lineBreak":true},{"text":"kakho lamunye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kanti lezizixhwali kaziyikufa zafunda yini?","poem":1},{"lineBreak":true},{"text":"Zona ezidla abantu bami ingathi zidla isinkwa,","poem":1},{"text":"ezingamkhonziyo uThixo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kodwa yibo abagubhazeliswa luvalo","poem":1},{"text":"ngoba uNkulunkulu ukhona phakathi kwabalungileyo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lina benzi bobubi lifubisa amalungiselelo abayanga,","poem":1},{"text":"kodwa uThixo uyisiphephelo sabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Awu, sengathi insindiso ka-Israyeli ingaqhamuka eZiyoni!","poem":1},{"text":"Nxa uThixo esebuyisela impumelelo yabantu bakhe,","poem":2},{"lineBreak":true},{"text":"kathokoze uJakhobe lo-Israyeli ajabule!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}