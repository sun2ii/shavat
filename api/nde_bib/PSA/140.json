{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo LikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ngilamulela, Oh Thixo, ebantwini ababi;","poem":1},{"text":"ngivikela ebantwini bodlakela,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"abakha amacebo amabi ezinhliziyweni zabo","poem":1},{"text":"bahlokomise impi ukusa kwamalanga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Benza izindimi zabo zicije njengezenyoka;","poem":1},{"text":"ubuhlungu benhlangwana busezindebeni zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngivikela, Oh Thixo, ezandleni zababi;","poem":1},{"text":"ngiphephisa ebantwini bodlakela","poem":2},{"lineBreak":true},{"text":"abaceba ukungigwenxa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abantu abazigqajayo bangifihlele isifu;","poem":1},{"text":"sebewanwebile amambule abo","poem":2},{"lineBreak":true},{"text":"bangithiya lapha lalapha endleleni yami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Oh Thixo, ngithi kuwe, “UnguNkulunkulu wami.”","poem":1},{"text":"Zwana, ukukhala kwami ngicela umusa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oh Thixo wobukhosi, mhlengi wami olamandla,","poem":1},{"text":"ovikela ikhanda lami ngelanga lempi","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ungavumeli ababi izifiso zabo Oh Thixo;","poem":1},{"text":"ungayekeli amacebo abo ukuthi aphumelele, funa bazigqaje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Akuthi ingqondo zalabo abangihanqileyo","poem":1},{"text":"zandelwe luhlupho oludalwe yizindebe zabo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akuthi amalahle avuthayo abakhithikele;","poem":1},{"text":"sengathi bangaphoselwa emlilweni,","poem":2},{"lineBreak":true},{"text":"emigodini ebhixa udaka, bangavuki futhi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akuthi abahlebayo bangatholi indawo elizweni;","poem":1},{"text":"akuthi umnyama ubahlale izithende abantu bochuku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ngiyazi ukuthi uThixo ubenzela okulungileyo abayanga,","poem":1},{"text":"ubamele abaswelayo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngempela abalungileyo bazalidumisa ibizo lakho","poem":1},{"text":"labaqotho bazahlala phambi kwakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}