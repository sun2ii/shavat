{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["Ihubo likaDavida"]},{"type":"verse","number":1,"content":[{"text":"Oh Thixo, ngiyakubiza; woza masinyane kimi.","poem":1},{"text":"Zwana ilizwi lami nxa ngikubiza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sengathi umkhuleko wami ungema phambi kwakho njengempepha;","poem":1},{"text":"kuthi ukuphakama kwezandla zami kube njengomhlatshelo wakusihlwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngibekela umlindi womlomo wami, Oh Thixo,","poem":1},{"text":"qaphela umnyango wezindebe zami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ungayekeli inhliziyo yami ihugwe ngokubi,","poem":1},{"text":"ngingene ezenzweni ezimbi","poem":2},{"text":"labantu abayizigangi;","poem":1},{"text":"mangingadli izibiliboco zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ake ngitshaywe ngumuntu olungileyo, kungumusa;","poem":1},{"text":"kake angikhuze, kungamafutha ekhanda lami.","poem":2},{"text":"Ikhanda lami kaliyikukwala.","poem":1},{"text":"Ikanti umkhuleko wami uhlezi umelana lezenzo zezigangi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ababusi bazo bazaphoselwa phansi emaweni,","poem":1},{"text":"lababi bazafunda ukuthi amazwi ami ayekhulunywe kuhle.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bazakuthi, “Njengalowo olimayo eqeqebula umhlabathi,","poem":1},{"text":"kanjalo amathambo ethu achithiziwe emlonyeni weliba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kodwa amehlo ami agxile kuwe, Oh Thixo woBukhosi;","poem":1},{"text":"kuwe ngiyaphephela unganginikeli ekufeni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngivikela emijibileni asebeyithiyele mina,","poem":1},{"text":"ezifini ezithiywe yizigangi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akuthi ababi bawele emambuleni abo,","poem":1},{"text":"mina ngidlule kuhle ngiphephile.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}