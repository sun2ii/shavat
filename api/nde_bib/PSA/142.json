{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Ihubo likaDavida. Lapho esebhalwini. Umkhuleko."]},{"type":"verse","number":1,"content":[{"text":"Ngiyamemeza kakhulu kuThixo;","poem":1},{"text":"ngiphakamisela ilizwi lami kuThixo ngicela umusa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngithululela ukusola kwami phambi kwakhe;","poem":1},{"text":"phambi kwakhe ngichaza ukuhlupheka kwami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lapho umphefumulo wami uncipha ngaphakathi kwami,","poem":1},{"text":"nguwe oyaziyo indlela yami.","poem":2},{"text":"Endleleni engihamba ngayo","poem":1},{"text":"abantu bangithiyile khona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Khangela kwesokunene sami ubone;","poem":1},{"text":"kakho lobani onginanzayo.","poem":2},{"text":"Angilaso isiphephelo;","poem":1},{"text":"kakho onakekela impilo yami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngikhala kuwe, Oh Thixo;","poem":1},{"text":"ngithi, “Uyisiphephelo sami,","poem":2},{"lineBreak":true},{"text":"uyisabelo sami elizweni labaphilayo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lalela ukukhala kwami,","poem":1},{"text":"ngoba ngileziswelo ezizikileyo,","poem":2},{"text":"ngikhulula kulabo abaxotshana lami,","poem":1},{"text":"ngoba balamandla kakhulu kulami.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngikhulula entolongweni yami,","poem":1},{"text":"ukuze ngidumise ibizo lakho.","poem":2},{"text":"Lapho-ke abalungileyo bazangibuthanela","poem":1},{"text":"ngenxa yokulunga kwakho kimi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}