{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["Ihubo likaDavida"]},{"type":"verse","number":1,"content":[{"text":"Oh Thixo, zwana umkhuleko wami,","poem":1},{"text":"zwana ukukhala kwami ngicela umusa;","poem":2},{"text":"ngokuthembeka kwakho langokulunga kwakho","poem":1},{"text":"woza uzongiphumuza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ungangenisi inceku yakho ekwahlulelweni,","poem":1},{"text":"ngoba kakho ophilayo ongabe ulungile kuwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isitha siyangizingela,","poem":1},{"text":"singincindezela phansi emhlabathini;","poem":2},{"text":"singenza ngihlale emnyameni","poem":1},{"text":"njengalabo abafa kudala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kanjalo umphefumulo wami uyaphela ngaphakathi kwami;","poem":1},{"text":"inhliziyo yami ngaphakathi kwami idanile.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngiyazikhumbula insuku zekadeni;","poem":1},{"text":"ngidla ingqondo ngayo yonke imisebenzi yakho","poem":2},{"lineBreak":true},{"text":"nginakane ngalokho okwenziwe yizandla zakho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngiyelula izandla zami kuwe;","poem":1},{"text":"umphefumulo wami uyakomela njengomhlabathi owomileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngiphendula masinyane, awu Thixo;","poem":1},{"text":"umoya wami uyaphela.","poem":2},{"text":"Ungangifihleli ubuso bakho","poem":1},{"text":"funa ngibe njengalabo abaya egodini.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akuthi ukusa kungilethele ilizwi lothando lwakho olungaphuthiyo,","poem":1},{"text":"ngoba sengibeke ithemba lami kuwe.","poem":2},{"text":"Ngitshengisa indlela okumele ngihambe ngayo,","poem":1},{"text":"ngoba ngiphakamisela umphefumulo wami kuwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngikhulula ezitheni zami, Oh Thixo,","poem":1},{"text":"ngoba ngizifihla kuwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngifundisa ukwenza intando yakho,","poem":1},{"text":"ngoba unguNkulunkulu wami;","poem":2},{"text":"sengathi uMoya wakho omuhle kakhulu","poem":1},{"text":"ungangikhokhela emhlabathini ochayileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ngenxa yebizo lakho, Oh Thixo, londoloza impilo yami;","poem":1},{"text":"ngokulunga kwakho ngikhupha ekuhluphekeni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ethandweni lwakho olungaphuthiyo, thulisa izitha zami;","poem":1},{"text":"bhubhisa bonke abangizondayo,","poem":2},{"lineBreak":true},{"text":"ngoba ngiyinceku yakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}