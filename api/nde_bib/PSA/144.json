{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"hebrew_subtitle","content":["ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Udumo kalube kuThixo iDwala lami,","poem":1},{"text":"yena ofundisa izandla zami ukulwa impi,","poem":2},{"lineBreak":true},{"text":"leminwe yami ukuhlasela.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"UnguNkulunkulu wami othandekayo lenqaba yami,","poem":1},{"text":"inqaba yami lomkhululi wami,","poem":2},{"text":"isihlangu sami engiphephela kuso,","poem":1},{"text":"othobisa abantu bami ngaphansi kwami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kambe Thixo, umuntu uyini ungaze umnanze,","poem":1},{"text":"indodana yomuntu ukuthi uyikhumbule na?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umuntu unjengomphefumulo;","poem":1},{"text":"insuku zakhe zinjengesithunzi esidlulayo masinyane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yahlukanisa izulu lakho, Oh Thixo, wehlele phansi;","poem":1},{"text":"thinta izintaba, ukuze zithunqe intuthu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Thumela umbane uzihlakaze izitha;","poem":1},{"text":"phosa imitshoko yakho zichitheke.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yelula isandla sakho sisuka phezulu;","poem":1},{"text":"ngihlenga ungikhulule","poem":2},{"lineBreak":true},{"text":"emanzini alamandla abezizweni","poem":2}]},{"type":"verse","number":8,"content":[{"text":"omilomo yabo igcwele amanga,","poem":1},{"text":"ozandla zabo zokunene zilenkohliso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngizakuhlabelela ingoma entsha, Oh Nkulunkulu;","poem":1},{"text":"ngechacho lezintambo ezilitshumi ngizakutshayela ingoma,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kuye yedwa onika amakhosi ukunqoba,","poem":1},{"text":"ohlenga inceku yakhe uDavida enkembeni ebulalayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ngihlenge, ungikhulule","poem":1},{"text":"ezandleni zabezizwe","poem":2},{"text":"omilomo yabo igcwele amanga,","poem":1},{"text":"ozandla zabo zokunene zilenkohliso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kuzakuthi amadodana ethu ebutsheni bawo","poem":1},{"text":"azakuba njengezihlahla ezikhuliswa kuhle,","poem":2},{"text":"kuthi amadodakazi ethu","poem":1},{"text":"abe njengezinsika ezibazelwe ukucecisa isigodlo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iziphala zethu zizagcwala","poem":1},{"text":"ngemihlobo yonke yokudla.","poem":2},{"text":"Izimvu zethu zizakwanda ngezinkulungwane,","poem":1},{"text":"ngamatshumi ezinkulungwane emadlelweni ethu;","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"inkabi zethu zizadonsa imithwalo enzima.","poem":2},{"text":"Akusayikuba khona ukubhidlizwa kwemiduli,","poem":1},{"text":"ukuya ebugqilini,","poem":2},{"lineBreak":true},{"text":"lokukhala kosizi emigwaqweni yakithi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Babusisiwe labobantu lokhu okuzakwenzakala kubo;","poem":1},{"text":"babusisiwe abantu oNkulunkulu wabo ngu Thixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}