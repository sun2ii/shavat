{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["Ihubo lokudumisa. ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ngizaphakamisa wena, Nkulunkulu wami oyiNkosi;","poem":1},{"text":"ngizalidumisa ibizo lakho kuze kube phakade.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zonke insuku ngizakudumisa","poem":1},{"text":"ngibabaze ibizo lakho kuze kube phakade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Umkhulu uThixo njalo ufanele kakhulu ukudunyiswa;","poem":1},{"text":"ubukhulu bakhe kakho ongabulinganisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yileso laleso isizukulwane sizababaza imisebenzi yakho kwesinye;","poem":1},{"text":"sizatshelana ngezenzo zakho ezinkulu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sizakhuluma ngenkazimulo yakho ebenyezelayo ubukhosi bakho,","poem":1},{"text":"lami ngizazidla ingqondo ngemisebenzi yakho emangalisayo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zizalandisa ngamandla emisebenzi yakho emangalisayo,","poem":1},{"text":"lami ngizafakaza ngemisebenzi yakho emikhulu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bazakwenza umkhosi ngokulunga kwakho okukhulu","poem":1},{"text":"bahlabele ngentokozo ngokulunga kwakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"UThixo ulomusa njalo ulesihawu,","poem":1},{"text":"uyaphuza ukuthukuthela, kodwa uyanda ngothando.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"UThixo ulungile kubo bonke;","poem":1},{"text":"ulesihawu kukho konke akwenzayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Konke owakwenzayo kuzakudumisa, wena Thixo;","poem":1},{"text":"abathembekileyo bakho bazakubabaza.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bazalandisa ngenkazimulo yombuso wakho","poem":1},{"text":"bakhulume ngamandla akho,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kuze kuthi bonke abantu bazi ngezenzo zakho ezinkulu","poem":1},{"text":"lokubenyezela kwenkazimulo yombuso wakho.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Umbuso wakho ungumbuso ongapheliyo,","poem":1},{"text":"lobukhosi bakho bumi kuzozonke izizukulwane.","poem":2},{"lineBreak":true},{"text":"UThixo uthembekile kuzozonke izithembiso zakhe","poem":1},{"text":"njalo ulothando kukho konke akwenzayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"UThixo uyabaxhasa bonke labo abawayo","poem":1},{"text":"abaphakamise bonke abacubayo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amehlo abo bonke akhangela kuwe,","poem":1},{"text":"wena ubaphe ukudla kwabo ngesikhathi esifaneleyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uyavula isandla sakho","poem":1},{"text":"usuthise izidingo zakho konke okuphilayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"UThixo ulungile kuzozonke izindlela zakhe","poem":1},{"text":"njalo uthembekile kukho konke akwenzayo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"UThixo useduze kulabo abacela kuye,","poem":1},{"text":"kubo bonke abacela kuye ngeqiniso.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Uyagcwalisa izidingo zalabo abamesabayo;","poem":1},{"text":"uyezwa ukukhala kwabo abasindise.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"UThixo uyabalinda bonke abamthandayo,","poem":1},{"text":"kodwa bonke ababi uzababhubhisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Umlomo wami uzakhuluma ngokudumisa uThixo.","poem":1},{"text":"Akuthi izidalwa zonke zidumise ibizo lakhe elingcwele","poem":2},{"lineBreak":true},{"text":"kuze kube nini lanini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}