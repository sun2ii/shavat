{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Dumisani uThixo.","poem":1},{"lineBreak":true},{"text":"Dumisa uThixo mphefumulo wami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngizamdumisa uThixo impilo yami yonke;","poem":2},{"lineBreak":true},{"text":"ngizahlabela indumiso kuNkulunkulu wami nxa ngisaphila.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lingabeki ithemba lenu emakhosini,","poem":1},{"text":"ebantwini benyama, abangeke basindise.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuthi umoya wabo ungaphuma, babuyele emhlabathini;","poem":1},{"text":"mhlalokho nje amacebo ahle abhidlike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ubusisiwe lowo osizo lwakhe lunguNkulunkulu kaJakhobe,","poem":1},{"text":"othemba lakhe likuThixo uNkulunkulu wakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"UnguMenzi wamazulu lomhlaba,","poem":1},{"text":"ulwandle lakho konke okulapho:","poem":2},{"lineBreak":true},{"text":"uThixo owala elokhu ethembekile laphakade.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uyabalwela abancindezelwayo","poem":1},{"text":"anike abalambileyo ukudla.","poem":2},{"text":"UThixo ukhulula izibotshwa,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"uThixo wenza iziphofu zibone,","poem":2},{"text":"uThixo uyabaphakamisa labo asebebhazalele,","poem":1},{"text":"uThixo uthanda abalungileyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"UThixo uyabalinda abezizweni","poem":1},{"text":"asekele izintandane labafelokazi,","poem":2},{"lineBreak":true},{"text":"kodwa anyampise izindlela zababi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"UThixo uyabusa nini lanini,","poem":1},{"text":"uNkulunkulu wakho, wena Ziyoni, ezizukulwaneni zonke.","poem":2},{"lineBreak":true},{"text":"Dumisani uThixo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}