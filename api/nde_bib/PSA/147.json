{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Dumisani uThixo.","poem":1},{"lineBreak":true},{"text":"Kuhle kangakanani ukuhlabela indumiso kuNkulunkulu wethu,","poem":1},{"text":"kumnandi njalo kufanele ukumbonga!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"UThixo uyalakha iJerusalema;","poem":1},{"text":"aqoqe labo abahlakazekileyo baka-Israyeli.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uyabathoba abadabukileyo enhliziyweni","poem":1},{"text":"abophe amanxeba abo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umisile ubunengi bezinkanyezi","poem":1},{"text":"aziqambe leyo laleyo ngamabizo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"INkosi yethu inkulu, njalo makhulu amandla ayo;","poem":1},{"text":"ukuzwisisa kwayo kakulamkhawulo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"UThixo uyabasekela abathobekileyo kodwa","poem":1},{"text":"abaphosele phansi ababi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hlabelani kuThixo ngokubonga;","poem":1},{"text":"litshaye amachacho kuNkulunkulu wethu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uyembesa umkhathi ngamayezi;","poem":1},{"text":"awuphe umhlaba izulu","poem":2},{"lineBreak":true},{"text":"njalo akhulise utshani ezintabeni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Unika inkomo utshani","poem":1},{"text":"aphe lamatsiyane amawabayi nxa esekhala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ukuthokoza kwakhe kakukho emandleni ebhiza,","poem":1},{"text":"loba injabulo yakhe ekuqineni kwemilenze yomuntu;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"UThixo uthokoza ngalabo abamesabayo,","poem":1},{"text":"ababeka ithemba labo ethandweni lwakhe olungaphuthiyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Umbabaze uThixo, Oh Jerusalema;","poem":1},{"text":"dumisa uNkulunkulu wakho, Oh Ziyoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngoba uyaqinisa imigoqo yamasango akho,","poem":1},{"text":"abusise labantu bakho ngaphakathi kwakho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wenza ukuthula emikhawulweni yelizwe lakho.","poem":1},{"text":"Njalo ukusuthisa ngamabele amahle kakhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Uthumela umlayo wakhe emhlabeni;","poem":1},{"text":"ilizwi lakhe ligijima masinyane.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wendlala ungqwaqwane njengoboya bezimvu","poem":1},{"text":"ahaze iliqhwa njengomlotha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Uphosela phansi isiqhotho sakhe njengamatshe.","poem":1},{"text":"Ngubani ongamelana lomfutho wakhe olomqando na?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uthumela ilizwi lakhe konke kuncibilike;","poem":1},{"text":"aphephethise umoya wakhe amanzi ageleze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ulivezile ilizwi lakhe kuJakhobe,","poem":1},{"text":"imithetho yakhe lezahlulelo ku-Israyeli.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lokhu kazange akwenzele esinye isizwe;","poem":1},{"text":"kaziyazi imithetho yakhe.","poem":2},{"lineBreak":true},{"text":"Dumisani uThixo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}