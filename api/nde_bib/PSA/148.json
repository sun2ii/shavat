{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Dumisani uThixo.","poem":1},{"lineBreak":true},{"text":"Dumisani uThixo emazulwini,","poem":1},{"text":"mdumiseni eziqongweni ngaphezulu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mdumiseni zingilosi zakhe zonke,","poem":1},{"text":"mdumiseni lonke mabutho asezulwini.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mdumiseni, langa lenyanga,","poem":1},{"text":"mdumiseni lonke zinkanyezi ezikhazimulayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mdumiseni lina ziqongo zamazulu","poem":1},{"text":"lani manzi ngaphezulu komkhathi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Konke kakudumise ibizo likaThixo","poem":1},{"text":"ngoba yena watsho ilizwi kwadaleka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wazibeka ezindaweni zazo okwanini lanini;","poem":1},{"text":"wanika isahlulelo esingela kuguquka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dumisani uThixo emhlabeni,","poem":1},{"text":"lina zidalwa zasolwandle lezinziki zalo zonke,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"umbane lesiqhotho, ungqwaqwane lamayezi,","poem":1},{"text":"umoya wesiphepho owenza intando yakhe,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"lina zintaba lamaqaqa wonke,","poem":1},{"text":"zihlahla zezithelo lemisedari yonke,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"zinyamazana zeganga lenkomo zonke,","poem":1},{"text":"zinanakazana lezinyoni eziphaphayo,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"makhosi omhlaba lezizwe zonke,","poem":1},{"text":"lina makhosana lababusi bonke emhlabeni,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"majaha lezintombi,","poem":1},{"text":"maxhegu labantwana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kabalidumise ibizo likaThixo,","poem":1},{"text":"ngoba ibizo lakhe lodwa liphakeme;","poem":2},{"lineBreak":true},{"text":"inkazimulo yakhe ingaphezulu komhlaba lamazulu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ubaphakamisele abantu bakhe uphondo,","poem":1},{"text":"indumiso yabo bonke abathembekileyo bakhe,","poem":2},{"lineBreak":true},{"text":"eka-Israyeli, abantu abasesifubeni sakhe.","poem":2},{"lineBreak":true},{"text":"Dumisani uThixo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}