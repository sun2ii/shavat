{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Dumisani uThixo.","poem":1},{"lineBreak":true},{"text":"Hlabelelani uThixo ingoma entsha,","poem":1},{"text":"indumiso yakhe ebandleni labathembekileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Akuthi u-Israyeli athokoze ngoMenzi wakhe;","poem":1},{"text":"akuthi abantu baseZiyoni bajabule ngeNkosi yabo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kabadumise ibizo lakhe ngokusina,","poem":1},{"text":"batshaye amagedla lamachacho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoba uThixo uyathokoza ngabantu bakhe;","poem":1},{"text":"abathobekileyo ubapha umqhele wensindiso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akuthi abathembekileyo bathokoze ngale inhlonipho,","poem":1},{"text":"bahlabele ngentokozo besemibhedeni yabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sengathi indumiso kaNkulunkulu ingaba semilonyeni yabo","poem":1},{"text":"lenkemba esika nxazonke ibe sezandleni zabo,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ukuthi benze impindiselo phezu kwezizwe","poem":1},{"text":"lesijeziso phezu kwabantu,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"babophe amakhosi azo ngentambo","poem":1},{"text":"lezikhulu zabo ngezibopho zensimbi,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ukugcwalisa kubo isigwebo abasibhalelwayo.","poem":1},{"text":"Lokhu kuyinkazimulo yabathembekileyo bakhe bonke.","poem":2},{"lineBreak":true},{"text":"Dumisani uThixo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}