{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["Imikithamu kaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ngilondoloza, Oh Nkulunkulu,","poem":1},{"text":"ngoba ngiphephela kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngathi kuThixo, “UnguThixo wami;","poem":1},{"text":"ngaphandle kwakho angilakho okuhle.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Labo abangcwele abakhona elizweni","poem":1},{"text":"bangabakhazimulayo engithokoza ngabo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Labo abagijimela abanye onkulunkulu inhlupho zabo zizakwanda.","poem":1},{"text":"Angiyi kuyithulula iminikelo yegazi kubonkulunkulu labo","poem":2},{"lineBreak":true},{"text":"njalo amabizo abo kawayikuphuma kwezami izindebe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Thixo, usungahlukanisele isabelo sami kanye lenkezo yami;","poem":1},{"text":"konke okwami usukumise kuhle.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Imingcele yesabelo sami idabula ezindaweni ezibukekayo;","poem":1},{"text":"ngeqiniso elami ilifa liyathokozisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngizamdumisa uThixo, onguye ongelulekayo;","poem":1},{"text":"lasebusuku inhliziyo yami iyangiqondisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngikhangele kuThixo kokuphela.","poem":1},{"text":"Njengoba esesandleni sami sokunene angiyi kunyikinywa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngakho-ke inhliziyo yami iyathokoza lolimi lwami luyajabula;","poem":1},{"text":"lomzimba wami uzaphumula uvikelekile,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ngoba kawuzukungiyekela ngize ngiye endaweni yabafileyo,","poem":1},{"text":"njalo kawusoze wekele othembekileyo wakho ezwe ukubola.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Usungazisile indlela yempilo;","poem":1},{"text":"uzangigcwalisa ngokuthaba phambi kwakho,","poem":2},{"lineBreak":true},{"text":"ngenjabulo engapheliyo kwesokunene sakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}