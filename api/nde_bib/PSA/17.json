{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"hebrew_subtitle","content":["Umkhuleko kaDavida."]},{"type":"verse","number":1,"content":[{"text":"Zwana, Oh Thixo, ukuncenga kwami okulungileyo;","poem":1},{"text":"lalela ukukhala kwami.","poem":2},{"text":"Zwana umkhuleko wami,","poem":1},{"text":"kawusuki ezindebeni ezikhohlisayo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ukugezwa kwami ecaleni kakuvele kuwe;","poem":1},{"text":"sengathi amehlo Akho angabona lokho okuqondileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Udungulule inhliziyo yami","poem":1},{"text":"wangihlola ebusuku wangilinga,","poem":2},{"text":"kawuyikufumana lutho olubi engiluhlelileyo;","poem":1},{"text":"sengizimisele ukuthi umlomo wami ungenzi sono.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mayelana lezenzo zabantu,","poem":1},{"text":"mina ngizazithiba ezindleleni zobudlwangudlwangu","poem":2},{"lineBreak":true},{"text":"ngelizwi lezindebe zakho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Izinyathelo zami zalela ezindleleni zakho;","poem":1},{"text":"inyawo zami kazizange zitshelele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngikhala kuwe, Oh Nkulunkulu ngoba uzangiphendula;","poem":1},{"text":"ngilalela uzwe umkhuleko wami.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tshengisa ukumangalisa kothando lwakho olukhulu,","poem":1},{"text":"wena osindisa ngesandla sakho sokunene,","poem":2},{"lineBreak":true},{"text":"labo ababalekela kuwe ezitheni zabo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngilondoloza njengegugu lakho;","poem":1},{"text":"ngifihla emthunzini wamaphiko akho","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kwababi abangihlaselayo,","poem":1},{"text":"ezitheni zami ezimbi ezingihanqileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bagcika inhliziyo zabo ezingelazwelo,","poem":1},{"text":"lemilomo yabo ikhuluma iqholoza.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sebeze bangithola, manje sebengihanqile","poem":1},{"text":"bangiqhuzulele amehlo bafuna ukungilahla phansi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Banjengesilwane silambele loba yini esingayidumela,","poem":1},{"text":"njengesilwane esesabekayo siquthile sicatshile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Phakama, Oh Thixo, basukele, balahle phansi;","poem":1},{"text":"ngilamulela kwababi ngenkemba yakho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Oh Thixo, ngisindisa ngesandla sakho ebantwini abanjalo,","poem":1},{"text":"ebantwini bakulumhlaba omvuzo wabo ukuyonale impilo.","poem":2},{"text":"Udedisa iphango lalabo obathandayo;","poem":1},{"text":"amadodana abo akhomba ngophakathi;","poem":2},{"lineBreak":true},{"text":"baqoqela abantwababo inotho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mina-ke ngenxa yokulunga ngizabubona ubuso bakho;","poem":1},{"text":"ngizakuthi ekuvukeni kwami nganeliswe yikubona isimo sakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}