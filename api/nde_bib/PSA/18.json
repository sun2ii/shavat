{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":18,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. ElikaDavida inceku kaThixo Wahlabelela uJehova amazwi alelihubo lapho uJehova wamsindisa esandleni sezitha zakhe zonke lasesandleni sikaSawuli. Wathi:"]},{"type":"verse","number":1,"content":[{"text":"Ngiyakuthanda, Oh Thixo, Mandla ami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"UThixo ulidwala lami, inqaba yami, lomsindisi wami;","poem":1},{"text":"uNkulunkulu wami ulidwala lami, lapho engiphephela khona,","poem":2},{"lineBreak":true},{"text":"isihlangu sami lophondo lokusindiswa kwami, inqaba yami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngakhuleka kuThixo ofanele ukudunyiswa","poem":1},{"text":"njalo ngikhululwe ezitheni zami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Izibopho zokufa zangihilela;","poem":1},{"text":"lezikhukhula zokubhubhisa zangikhulela.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Izibopho zengcwaba zangithandela;","poem":1},{"text":"imijibila yokufa yangijamela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ekukhathazekeni kwami ngakhuleka kuThixo;","poem":1},{"text":"ngakhala kuNkulunkulu wami ngicela usizo.","poem":2},{"text":"Walizwa ilizwi lami esethempelini lakhe;","poem":1},{"text":"ukukhala kwami kwafinyelela kuye,","poem":2},{"lineBreak":true},{"text":"ezindlebeni zakhe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Umhlaba wagedezela wazamazama,","poem":1},{"text":"izisekelo zezintaba zanyikinyeka;","poem":2},{"lineBreak":true},{"text":"zagedezela ngoba wayethukuthele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Intuthu yalanquka emakhaleni Akhe","poem":1},{"text":"umlilo ohangulayo waphuma emlonyeni wakhe,","poem":2},{"lineBreak":true},{"text":"amalahle avuthayo alavuka ephuma kuwo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waqhekeza amazulu wehlela phansi;","poem":1},{"text":"amayezi amnyama","poem":2},{"lineBreak":true},{"text":"ayengaphansi kwezinyawo zakhe","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wagada amakherubhi waphapha;","poem":1},{"text":"wantweza phezu kwamaphiko omoya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wenza umnyama isembeso sakhe,","poem":1},{"text":"isigubuzelo esimhanqileyo,","poem":2},{"lineBreak":true},{"text":"amayezi ezulu amnyama asemkhathini.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Phakathi kokukhazimula kobukhona bakhe","poem":1},{"text":"kwaqubuka amayezi,","poem":2},{"lineBreak":true},{"text":"kulesiqhotho lezikhatha zombane.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"UThixo wakhwaza esezulwini;","poem":1},{"text":"ilizwi loPhezukonke lanqenqetha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waciba imitshoko wazihlakaza izitha,","poem":1},{"text":"ngembane eminengi waziqothula.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Izigodi zolwandle zambulwa","poem":1},{"text":"lezisekelo zomhlaba zavezwa obala","poem":2},{"text":"ekukhuzeni kwakho Thixo,","poem":1},{"text":"ngomfutho wokuphefumula kwamakhala akho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Welula isandla Sakhe esezulwini","poem":1},{"text":"wangibamba wangihlenga enzikini yamanzi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wangihlenga esitheni sami esilamandla,","poem":1},{"text":"ezitheni zami ezazingigabhela ngamandla.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zangijamela mhla ngisebunzimeni,","poem":1},{"text":"kodwa uThixo waba yinsika yami.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wangikhupha wangibeka endaweni ebanzi","poem":1},{"text":"wangihlenga ngoba wayethokoza ngami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"UThixo ungenzele okulingene ukulunga kwami;","poem":1},{"text":"wanginika umvuzo ngokufanele ukuhlanzeka kwezandla zami.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngoba ngizigcinile izindlela zikaThixo;","poem":1},{"text":"angenzanga okubi ngokufulathela uNkulunkulu wami.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yonke imithetho yakhe ibiphambi kwami;","poem":1},{"text":"angizifulathelanga izimiso zakhe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngibe ngilokhu ngimsulwa phambi kwakhe","poem":1},{"text":"njalo ngisixwayile isono.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"UThixo unginike umvuzo ngokufanele ukulunga kwami,","poem":1},{"text":"ngokufanele ukuhlanzeka kwezandla zami phambi Kwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kwabathembekileyo lawe uthembekile,","poem":1},{"text":"kwabamsulwa lawe umsulwa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kwabahlanzekileyo uziveza uhlanzekile","poem":1},{"text":"kodwa kwabangaqondanga uziveza ukhaliphile.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Uyabasindisa abathobekileyo;","poem":1},{"text":"kodwa uyabehlisela phansi labo abamehlo asesiphundu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wena, Oh Thixo, gcina isibane sami sibhebha;","poem":1},{"text":"uNkulunkulu wami uguqula umnyama wami ube yikukhanya.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ngosizo lwakho ngingaphuma ngimelane lebutho lempi;","poem":1},{"text":"ngoNkulunkulu wami ngingaweqa umduli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Izindlela zikaNkulunkulu uqobo lwakhe ziphelele;","poem":1},{"text":"ilizwi likaThixo kalilasici.","poem":2},{"lineBreak":true},{"text":"Ulihawu labo bonke abaphephela kuye.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ngoba ngubani uNkulunkulu ngaphandle kukaThixo?","poem":1},{"text":"Njalo ngubani oliDwala ngaphandle kukaNkulunkulu wethu na?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"NguNkulunkulu ongihlomisa amandla","poem":1},{"text":"enze indlela yami iphelele.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Wenza inyawo zami zibe njengezempala;","poem":1},{"text":"ungenza ngime ezingqongweni","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ufundisa izandla zami ukulwa impi;","poem":1},{"text":"izingalo zami zingaligobisa idandili lethusi.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Wena uyanginika isihlangu sakho sokunqoba,","poem":1},{"text":"lesandla sakho sokunene siyangiqinisa;","poem":2},{"lineBreak":true},{"text":"uyazehlisela phansi ukuze ungenze ngibe mkhulu.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Uqhelisa indlela enginyathela kuyo,","poem":1},{"text":"ukuze inqagala zami zingapheci.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Ngaxotshana lezitha zami ngazifica;","poem":1},{"text":"kangiphendukanga ngingakazibhubhisi zonke.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ngazichoboza, zazingeke zisavuka;","poem":1},{"text":"zawela ngaphansi kwezinyawo zami","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Wangihlomisa ngamandla okulwa impi;","poem":1},{"text":"wenza abaxabana lami bakhothama ezinyaweni zami.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Wenza izitha zami zafulathela zabaleka,","poem":1},{"text":"njalo ngazibhubhisa izitha zami.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Bakhala becela uncedo, kodwa wayengekho owayengabalamulela","poem":1},{"text":"kuThixo, kodwa kaphendulanga.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Ngabatshaya bacholeka njengothuli luphetshulwa ngumoya;","poem":1},{"text":"ngabathulula njengodaka ezindleleni.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ungikhulule ekuhlaselweni yilababantu;","poem":1},{"text":"usungenze ngaba yinhloko yezizwe;","poem":2},{"text":"abantu engangingabazi sebebuswa yimi.","poem":1}]},{"type":"verse","number":44,"content":[{"text":"Bathi bengizwa nje ngendaba, bangilalele;","poem":2},{"lineBreak":true},{"text":"abezizweni bayatshotshobala phambi kwami.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Bonke badelile;","poem":1},{"text":"beza bethuthumela bevela ezinqabeni zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Uthixo uyaphila!","poem":1},{"text":"Alidunyiswe iDwala lami!","poem":2},{"lineBreak":true},{"text":"Kaphakanyiswe uNkulunkulu uMsindisi wami!","poem":2}]},{"type":"verse","number":47,"content":[{"text":"UnguNkulunkulu ongiphindiselelayo,","poem":1},{"text":"onqoba izizwe zibe ngaphansi kwami,","poem":2}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"ongisindisayo ezitheni zami.","poem":2},{"text":"Wena wangikhuphula ngaphezu kwezitha zami;","poem":1},{"text":"wangihlenga ebantwini bodlakela.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Ngakho ngizakudumisa phakathi kwezizwe, Oh Thixo;","poem":1},{"text":"ngizahlabelela indumiso yebizo lakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"Upha inkosi yakhe ukunqoba okukhulu;","poem":1},{"text":"utshengisa umusa wakhe ongaphuthiyo kogcotshiweyo wakhe,","poem":2},{"lineBreak":true},{"text":"kuDavida kanye lezizukulwane zakhe kuze kube nininini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}