{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Amazulu afakaza inkazimulo kaNkulunkulu;","poem":1},{"text":"lomkhathi utshumayela umsebenzi wezandla zakhe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Usuku ngosuku lezizinto ziyakhuluma;","poem":1},{"text":"ubusuku lobusuku zibonisa ulwazi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akula nkulumo, akula mazwi","poem":1},{"text":"ilizwi lazo alizwakali.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kodwa Ilizwi lazo lizwakala emhlabeni wonke,","poem":1},{"text":"amazwi azo afika emikhawulweni yomhlaba.","poem":2},{"text":"Emazulwini uNkulunkulu uselakhele ithente ilanga.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Lona linjengomyeni ephuma exhibeni lakhe,","poem":2},{"lineBreak":true},{"text":"njengentshantshu ethakazelela ukugijima ibanga layo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Liphuma emkhawulweni wamazulu","poem":1},{"text":"lihambe indlela yalo liyotshona ngakuloyana;","poem":2},{"lineBreak":true},{"text":"kakukho okusithekileyo ekutshiseni kwalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Umthetho kaThixo uphelele","poem":1},{"text":"uvuselela umphefumulo.","poem":2},{"text":"Izimiso zikaThixo zithembekile,","poem":1},{"text":"zihlakaniphisa izithutha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iziqondiso zikaThixo zilungile,","poem":1},{"text":"ziletha ukuthokoza enhliziyweni.","poem":2},{"text":"Imilayo kaThixo isobala,","poem":1},{"text":"iletha ukukhanya emehlweni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ukumesaba uThixo kuhlanzekile,","poem":1},{"text":"kumi kuze kube phakade.","poem":2},{"text":"Izahlulelo zikaThixo ziqinisekile","poem":1},{"text":"njalo zilungile ngokupheleleyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ziligugu okudlula igolide,","poem":1},{"text":"okudlula igolide elinengi elicengekileyo;","poem":2},{"text":"zimnandi kuloluju,","poem":1},{"text":"uluju olujuluka ohlangeni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngazo inceku yakho iyacetshiswa;","poem":1},{"text":"ukuzilandela kulomvuzo omkhulu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngubani ongazizwisisa iziphambeko zakhe?","poem":1},{"text":"Thethelela iziphambeko zami ezisithekileyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Phephisa inceku yakho ezonweni zamabomo;","poem":1},{"text":"sengathi zingeze zabusa phezu kwami.","poem":2},{"text":"Lapho ngizakuba msulwa","poem":1},{"text":"ngingabi lacala lokona okukhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sengathi amazwi omlomo wami leminakano yenhliziyo yami","poem":1},{"text":"kungathokozisa emehlweni akho,","poem":2},{"lineBreak":true},{"text":"Oh Thixo, Dwala lami loMhlengi wami.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}