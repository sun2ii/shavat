{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Kungani izizwe zixokozela,","poem":1},{"text":"labantu besakha amacebo ngeze?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amakhosi omhlaba ayahloma ajame","poem":1},{"text":"lababusi bahlangana ndawonye","poem":2},{"lineBreak":true},{"text":"bemelana loThixo njalo lalowo ogcotshiweyo wakhe besithi;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Kasiwaqamuleni amaketane abo,","poem":1},{"text":"silahle izibopho zabo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yena osesihlalweni ezulwini uyahleka;","poem":1},{"text":"uThixo uyabahleka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abesebakhalimela ngolaka,","poem":1},{"text":"abathuthumelise ngentukuthelo yakhe, esithi,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Sengiyibekile eyami inkosi phezu kweZiyoni,","poem":1},{"text":"intaba yami engcwele.”","poem":2}]},{"type":"verse","number":7,"content":["Ngizasimemezela isimiso sikaThixo :",{"text":"Wathi kimi, “UyiNdodana yami;","poem":1},{"text":"lamhla sengibe nguyihlo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Cela kimi,","poem":1},{"text":"ngizakwenza izizwe zibe yilifa lakho,","poem":2},{"lineBreak":true},{"text":"imikhawulo yomhlaba kube yinotho yakho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uzazibusa ngentonga yobukhosi eyensimbi,","poem":1},{"text":"uzazibhidliza zicubuzeke njengebumba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngakho-ke lina makhosi, limukani,","poem":1},{"text":"liyaxwayiswa lina babusi bomhlaba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mkhonzeni uThixo ngokumesaba,","poem":1},{"text":"lithokozele umbuso wakhe ngokuthuthumela.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ikhothameleni iNdodana, funa ithukuthele","poem":1},{"text":"beselibhujiswa endleleni yenu,","poem":2},{"text":"ngoba intukuthelo yakhe ingavutha ngesikhatshana.","poem":1},{"text":"Babusisiwe bonke abaphephela kuye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}