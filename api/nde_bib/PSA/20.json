{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Sengathi uThixo angakuphendula nxa usenkathazweni;","poem":1},{"text":"sengathi ibizo likaNkulunkulu kaJakhobe lingakuvikela.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sengathi angakuthumela usizo luvela endlini engcwele","poem":1},{"text":"njalo akunike ukuhlomulela kuvela eZiyoni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sengathi angakhumbula yonke imihlatshelo yakho","poem":1},{"text":"njalo emukele iminikelo yakho yokutshiswa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sengathi angakupha isifiso senhliziyo yakho","poem":1},{"text":"enze izimiso zakho zonke ziphumelele.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sizamemeza ngokujabula lapho usunqobile,","poem":1},{"text":"siphakamise uphawu lwethu egameni likaNkulunkulu wethu.","poem":2},{"lineBreak":true},{"text":"Sengathi uThixo angakupha zonke izicelo zakho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Manje sengisazi ukuthi","poem":1},{"text":"uThixo uyamhlenga ogcotshiweyo wakhe;","poem":2},{"text":"uyamphendula esezulwini lakhe elingcwele","poem":1},{"text":"ngamandla Akhe asindisayo awesandla Sakhe sokunene.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abanye bathemba izinqola zempi,","poem":1},{"text":"abanye amabhiza,","poem":2},{"lineBreak":true},{"text":"kodwa thina sithemba ibizo likaThixo uNkulunkulu wethu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bafuqelwa phansi bawe,","poem":1},{"text":"kodwa thina siyaphakama sime sigxile.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Oh Thixo, sindisa inkosi!","poem":1},{"text":"Sabela lapho simemeza!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}