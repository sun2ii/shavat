{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Yebo Thixo umbusi uyathokoza ngamandla akho.","poem":1},{"text":"Kukhulu ukuthokoza kwakhe ngokunqoba akuphiwa nguwe!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Usumphile isiloyiso senhliziyo yakhe","poem":1},{"text":"njalo kawumncitshanga isicelo sezindebe zakhe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wamemukela ngezibusiso ezinhle","poem":1},{"text":"wamethesa umqhele wegolide elicengekileyo ekhanda lakhe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wacela kuwe ukusila,","poem":1},{"text":"wamupha ubude bezinsuku kuze kube nini lanini.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngokunqoba akuphiwe nguwe","poem":1},{"text":"lukhulu udumo lwakhe;","poem":2},{"lineBreak":true},{"text":"usumgqizise inkazimulo lobukhosi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngempela usumuphe izibusiso ezingapheliyo","poem":1},{"text":"wamenza wajabula ngentokozo yobukhona Bakho.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngoba umbusi uyamthemba uThixo;","poem":1},{"text":"ngothando loPhezukonke olungaphuthiyo","poem":2},{"lineBreak":true},{"text":"akayikuzanyazanyiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Isandla Sakho sizazibamba zonke izitha Zakho;","poem":1},{"text":"isandla Sakho sokunene sizabaxhakalaza abakuzondayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kuzakuthi lapho uqhamuka wena","poem":1},{"text":"uzabenza babe njengomlilo wemvutho enkulu.","poem":2},{"text":"Ngenxa yentukuthelo yakhe uThixo uzabaginya,","poem":1},{"text":"umlilo wakhe uzabaqothula.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wena uzabhubhisa izizukulwane zabo emhlabeni,","poem":1},{"text":"inzalo yabo ebantwini.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Loba beceba okubi Ngawe","poem":1},{"text":"besakha amaqhinga amabi, abangeke baphumelele;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ngoba uzabenza bafulathele babaleke","poem":1},{"text":"nxa usubakhombela usulinwebile idandili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Phakanyiswa, Oh Thixo ngamandla Akho;","poem":1},{"text":"sizahlabela sibabaze amandla Akho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}