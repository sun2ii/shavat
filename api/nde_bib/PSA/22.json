{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Kulandela itshuni ethi, “Impalakazi yekuSeni.” Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Nkulunkulu wami, Nkulunkulu wami, kungani usungidelile na?","poem":1},{"text":"Kungani ukhatshana kokungisindisa,","poem":2},{"lineBreak":true},{"text":"khatshana kwamazwi okububula kwami?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oh Nkulunkulu wami, ngiyakhala emini,","poem":1},{"text":"kodwa kawuphenduli;","poem":2},{"lineBreak":true},{"text":"ebusuku, kangithulanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kanti usesihlalweni sobukhosi uNguye oNgcwele","poem":1},{"text":"uyindumiso ka-Israyeli.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Obaba babeka ithemba labo Kuwe;","poem":1},{"text":"bona bathemba wena wabakhulula.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bakhala kuwe bakhululwa;","poem":1},{"text":"bathemba kuwe kabaze badaniswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kodwa ngiyimpethu nje kangisumuntu,","poem":1},{"text":"ngihozwa ngabantu njalo abanengi bangeyise.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bonke abangibonayo bayangihleka;","poem":1},{"text":"bayangithethisa baze banyikinye amakhanda:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Uthemba uThixo","poem":1},{"text":"lowo Thixo kamkhulule.","poem":2},{"lineBreak":true},{"text":"Kamsindise njengoba ethokoza ngaye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kanti wena wangikhupha esiswini;","poem":1},{"text":"wangenza ngakuthemba kusukela ebeleni likamama.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kusukela ekuzalweni kwami ngabekwa ezandleni Zakho;","poem":1},{"text":"kusukela esiswini sikamama ulokhu unguNkulunkulu wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ungabi khatshana kwami,","poem":1},{"text":"ngoba uhlupho luseduze njalo","poem":2},{"lineBreak":true},{"text":"kakho ongangisiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Inkunzi ezinengi zingihanqile;","poem":1},{"text":"inkunzi ezilamandla zaseBhashani zingihonqolozele.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Izilwane ezibhongayo ezibamba zidabudabule","poem":1},{"text":"zingikhamisela imilomo yazo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngiyathululeka njengamanzi,","poem":1},{"text":"njalo amathambo ami wonke akhumukile.","poem":2},{"text":"Inhliziyo yami isiphenduke yaba yingcino;","poem":1},{"text":"isincibilikile ngaphakathi kwami.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amandla ami asetshile qhu ingathi ludengezi,","poem":1},{"text":"lolimi lwami luyanamathela elwangeni lwami;","poem":2},{"lineBreak":true},{"text":"uyangilalisa othulini lokufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Izinja sezingihanqile;","poem":1},{"text":"ixuku labantu ababi selingihonqolozele,","poem":2},{"lineBreak":true},{"text":"sebengigwaze izandla lezinyawo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngingawabala wonke amathambo ami;","poem":1},{"text":"abantu bayanginyonkoloza bangiklolodele.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Behlukaniselana izembatho zami","poem":1},{"text":"njalo benze inkatho ngezigqoko zami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kodwa wena, Thixo, ungabi kude lami.","poem":1},{"text":"Ungamandla ami, woza masinyane uzongisiza.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Phephisa impilo yami enkembeni,","poem":1},{"text":"impilo yami eligugu emandleni azo izinja.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngilamulela emlonyeni wezilwane;","poem":1},{"text":"ngisindisa empondweni zezinyathi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ngizamemezela ibizo Lakho kubafowethu;","poem":1},{"text":"emphakathini ngizakudumisa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Lina elimesabayo uThixo, mdumiseni!","poem":1},{"text":"Lani lina zizukulwane zikaJakhobe, mbabazeni!","poem":2},{"lineBreak":true},{"text":"Mhlonipheni, lina lonke zizukulwane zika-Israyeli!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngoba keyisanga loba adelele","poem":1},{"text":"ukuhlupheka kwalowo ohlukuluzwayo;","poem":2},{"text":"kamfihlelanga ubuso bakhe","poem":1},{"text":"kodwa walalela ukukhala kwakhe ecela ukusizwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Sivela kuwe isithathelo sokudumisa kwami emhlanganweni omkhulu;","poem":1},{"text":"ngizagcwalisa izifungo zami phambi kwalabo abakwesabayo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Abayanga bazakudla basuthe","poem":1},{"text":"labo abamdingayo uThixo bazamdumisa","poem":2},{"lineBreak":true},{"text":"sengathi inhliziyo zenu zingaphila nini lanini!","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Yonke imikhawulo yomhlaba","poem":1},{"text":"izakhumbula iphendukele kuThixo,","poem":2},{"text":"njalo lezimuli zonke zezizwe","poem":1},{"text":"zizakhothama phansi phambi kwakhe,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ngoba umbuso ungokaThixo","poem":1},{"text":"njalo uyabusa phezu kwezizwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Zonke izinothi zomhlaba zizazitika ngokudla","poem":1},{"text":"njalo zikhonze;","poem":2},{"text":"bonke abangena othulini bazaguqa phambi Kwakhe","poem":1},{"text":"labo abangeke baziphilise.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Abesikhathi esizayo bazamkhonza;","poem":1},{"text":"izizukulwane zizakwaziswa ngoThixo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bazatshumayela ukulunga kwakhe,","poem":1},{"text":"ebantwini abangakazalwa","poem":2},{"lineBreak":true},{"text":"ngoba ukwenzile Yena.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}