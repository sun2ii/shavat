{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Umhlaba ngokaThixo, lakho konke okukuwo,","poem":1},{"text":"ilizwe labo bonke abahlala kulo;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ngoba wenza isisekelo sawo phezu kolwandle","poem":1},{"text":"wawumisa phezu kwamanzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngubani ongaqansa intaba kaThixo na?","poem":1},{"text":"Ngubani ongema endaweni yakhe engcwele na?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngulowo olezandla ezihlanzekileyo lenhliziyo emhlophe,","poem":1},{"text":"ongaphakamiseli umphefumulo wakhe kunkulunkulu wamanga","poem":2},{"lineBreak":true},{"text":"loba afunge ngenkohliso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Uzakwamukela isibusiso kuThixo","poem":1},{"text":"lokukhululwa kuNkulunkulu uMsindisi wakhe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sinjalo isizukulwane salabo abamdingayo,","poem":1},{"text":"abadinga ubuso Bakho, Oh Nkulunkulu kaJakhobe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Phakamisani amakhanda enu, lina masango;","poem":1},{"text":"phakamani, lina minyango yekadeni,","poem":2},{"lineBreak":true},{"text":"ukuba iNkosi yenkazimulo ingene.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngubani iNkosi yenkazimulo?","poem":1},{"text":"NguThixo oqinileyo olamandla,","poem":2},{"lineBreak":true},{"text":"uThixo olamandla empini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Phakamisani amakhanda enu, lina masango;","poem":1},{"text":"aphakamiseni, lina minyango yekadeni,","poem":2},{"lineBreak":true},{"text":"ukuba iNkosi yenkazimulo ingene.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ungubani na lowo Thixo wenkazimulo?","poem":1},{"text":"NguThixo uSomandla","poem":2},{"lineBreak":true},{"text":"iNkosi yenkazimulo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}