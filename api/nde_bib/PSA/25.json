{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Kuwe, Thixo,","poem":1},{"text":"ngiphakamisela umphefumulo wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngethemba kuwe,","poem":1},{"text":"ungangiyekeli ngiyangeka,","poem":2},{"lineBreak":true},{"text":"futhi ungayekeli izitha zami zinginqobe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kakukho bani othemba lakhe likuwe","poem":1},{"text":"ozayangiswa lanini,","poem":2},{"text":"kodwa bazayangiswa","poem":1},{"text":"abadinga ukulimaza kungelasizatho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngibonisa izindlela Zakho, Oh Thixo,","poem":1},{"text":"ngifundisa izindlela Zakho;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ngikhokhela eqinisweni Lakho ungifundise","poem":1},{"text":"ngoba unguNkulunkulu, uMsindisi wami,","poem":2},{"lineBreak":true},{"text":"lethemba lami likuwe insuku zonke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Khumbula, Oh Thixo, isihawu Sakho esikhulu kanye lothando,","poem":1},{"text":"ngoba konke kuvela ekadeni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ungakhumbuli izono zobutsha bami","poem":1},{"text":"lezindlela zokuhlamuka kwami;","poem":2},{"text":"ngikhumbula ngokufanele uthando Lwakho,","poem":1},{"text":"ngoba ulungile, Oh Thixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"UThixo ulungile, uqotho;","poem":1},{"text":"ngakho weluleka izoni ngezindlela zakhe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uhola abathobekileyo kulokho okuqondileyo","poem":1},{"text":"abafundise indlela yakhe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zonke izindlela zikaThixo zilothando, ziyathembeka","poem":1},{"text":"kulabo abagcina izimiso zesivumelwano Sakhe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngenxa yegama Lakho, Oh Thixo,","poem":1},{"text":"thethelela ububi bami, loba bubukhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ngubani-ke umuntu omesabayo uThixo?","poem":1},{"text":"Uzameluleka ngaleyondlela ayimiselweyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uzaphila insuku zakhe ekhomba ngophakathi,","poem":1},{"text":"lezizukulwane zakhe zizakudla ilifa lelizwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bayathenjwa nguThixo labo abamesabayo;","poem":1},{"text":"ubenza basazi isivumelwano Sakhe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amehlo ami ahlezi ekuThixo lanini,","poem":1},{"text":"ngoba nguye kuphela ozakhumula inyawo zami esithiyweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Phendukela kimi ube lobubele lami,","poem":1},{"text":"ngoba ngilesizungu, ngikhathazekile.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inhlupheko zenhliziyo yami sezandile;","poem":1},{"text":"ngikhulula ekudabukeni kwami.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Khangela ukukhathazeka kwami lokuhawula kwami,","poem":1},{"text":"ususe zonke izono zami.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ake ubone ukuthi izitha zami sezande kangakanani,","poem":1},{"text":"lokuthi zingizonda kubi kanjani!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Linda impilo yami ungihlenge;","poem":1},{"text":"ungangiyekeli ngiyangeke,","poem":2},{"lineBreak":true},{"text":"ngoba ngizuza isiphephelo Kuwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sengathi ubuqotho lokuqonda kungangivikela,","poem":1},{"text":"ngoba ngizuza isiphephelo Kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Hlenga u-Israyeli, Oh Nkulunkulu,","poem":1},{"text":"kuzozonke inhlupheko zakhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}