{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Veza ukungabi lacala kwami, Thixo,","poem":1},{"text":"ngoba sengiphile impilo engelansolo;","poem":2},{"text":"ngihlezi ngimethemba uThixo","poem":1},{"text":"ngingaxhamandi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngilinga, Oh Thixo, ungizame,","poem":1},{"text":"hlola inhliziyo yami lengqondo yami;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ngoba uthando Lwakho luhlezi luphambi kwami,","poem":1},{"text":"njalo kokuphela ngihamba eqinisweni Lakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kangidlelani labantu abakhohlisayo","poem":1},{"text":"njalo kangiwelelani labazenzisi;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ngiyawenyanya umbuthano wezigangi;","poem":1},{"text":"njalo ngiyala ukuhlala lezixhwali.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngigeza izandla zami ngokungelacala,","poem":1},{"text":"bese ngilizungeza i-alithari Lakho, Oh Thixo,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ngimemezele ngamandla indumiso Yakho","poem":1},{"text":"ngibatshele bonke ngemisebenzi Yakho eyisimanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngiyayithanda indlu ohlala kuyo, Oh Thixo,","poem":1},{"text":"indawo lapho inkazimulo Yakho ehlala khona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ungamukisi umphefumulo wami ndawonye lowezoni,","poem":1},{"text":"impilo yami kanye lalabo abomele igazi,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ozandla zabo zilamacebo amabi,","poem":1},{"text":"ozandla zabo zokunene zifumbethe izivalamlomo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodwa mina ngiphila impilo engelasici;","poem":1},{"text":"ngihlenga ube lesihawu kimi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Inyawo zami zimi emhlabathini ochayileyo;","poem":1},{"text":"ngizamdumisa uThixo emhlanganweni omkhulu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}