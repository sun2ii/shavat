{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"UThixo uyikukhanya kwami lensindiso yami","poem":1},{"text":"ngizakwesaba bani na?","poem":2},{"text":"UThixo uyinqaba yokuphila kwami","poem":1},{"text":"ngubani engingamesaba na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nxa ababi bengihlasela","poem":1},{"text":"bezodlithiza inyama yami,","poem":2},{"text":"lapho izitha zami labangizondayo bengihlasela,","poem":1},{"text":"bazakhubeka bawe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Loba impi ingivimbezela,","poem":1},{"text":"inhliziyo yami kayizukwesaba;","poem":2},{"text":"loba ngivukelwa yimpi,","poem":1},{"text":"loba kunjalo ngizakuma isibindi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yinye into engiyicelayo kuThixo,","poem":1},{"text":"yilokhu engikudingayo:","poem":2},{"text":"ukuba ngihlale endlini kaThixo","poem":1},{"text":"zonke insuku zokuphila kwami,","poem":2},{"text":"ngibuke ubuhle bukaThixo,","poem":1},{"text":"lokuthi ngimdinge ethempelini lakhe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Phela ngosuku lokuhlupheka","poem":1},{"text":"uzangilondoloza emzini wakhe,","poem":2},{"text":"uzangifihla esiphephelweni sethabanikeli lakhe","poem":1},{"text":"angimise phezulu kwedwala elisesiqongweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lapho-ke ikhanda lami lizaphakanyiswa","poem":1},{"text":"ngaphezu kwezitha ezingihanqileyo;","poem":2},{"text":"ethabanikeleni lakhe ngizakwenza umhlatshelo ngimemeza ngentokozo;","poem":1},{"text":"ngizahlabelela ingoma zendumiso kuThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zwana ilizwi lami lapho ngimemeza Oh Thixo;","poem":1},{"text":"woba lomusa kimi ungiphendule.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ithi inhliziyo yami Ngawe, “Dinga ubuso bakhe!”","poem":1},{"text":"Ubuso Bakho, Thixo ngizabudinga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ungangifihleli ubuso Bakho,","poem":1},{"text":"ungayixotshi inceku yakho ngokuthukuthela;","poem":2},{"lineBreak":true},{"text":"wena ubungumsizi wami.","poem":2},{"text":"Ungangilahli loba ungidele,","poem":1},{"text":"Oh Nkulunkulu, Msindisi wami.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Loba obaba lomama bengangidela,","poem":1},{"text":"uThixo uzangemukela.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngifundisa indlela Yakho, Oh Thixo;","poem":1},{"text":"ngihola endleleni eqondileyo","poem":2},{"lineBreak":true},{"text":"ngenxa yabancindezeli bami.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Unganginikeli entandweni yabangizondayo,","poem":1},{"text":"ngoba ofakazi bamanga bayangivukela","poem":2},{"lineBreak":true},{"text":"bevutha ulaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngilokhu ngilesibindi ngalokhu:","poem":1},{"text":"ngizakubona ukulunga kukaThixo","poem":2},{"lineBreak":true},{"text":"emhlabeni wabaphilayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lindela uThixo","poem":1},{"text":"qina ume isibindi","poem":2},{"lineBreak":true},{"text":"ulindele uThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}