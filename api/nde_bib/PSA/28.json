"text":"kanye lemisebenzi yabo emibi;","poem":2},{"text":"bajezisele imisebenzi yezandla zabo,","poem":1},{"text":"ubaphindisele ngokubafaneleyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Njengoba bengananzi imisebenzi kaThixo","poem":1},{"text":"lalokho okwenziwe yizandla zakhe,","poem":2},{"text":"uzababhidlizela phansi","poem":1},{"text":"angaphindi ababumbe futhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Udumo kalube kuye uThixo,","poem":1},{"text":"ngoba ukuzwile ukukhala kwami ngicela umusa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"UThixo ungamandla ami lesihlangu sami;","poem":1},{"text":"inhliziyo yami yethemba Kuye, ngiyancedwa.","poem":2},{"text":"Inhliziyo yami iyaqolotsha ngentokozo","poem":1},{"text":"njalo ngizambonga ngehubo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"UThixo ungamandla abantu bakhe,","poem":1},{"text":"inqaba yensindiso yogcotshiweyo wakhe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sindisa abantu Bakho ubusise ilifa lakho;","poem":1},{"text":"woba ngumelusi wabo ubathwale lanininini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}