poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wenza iLebhanoni itshakale njengethole,","poem":1},{"text":"iSiriyoni njengeguqa lenyathi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ilizwi likaThixo litshaya","poem":1},{"text":"ngezikhatha zombane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ilizwi likaThixo liyayizamazamisa inkangala;","poem":1},{"text":"uThixo uyayizamazamisa iNkangala yaseKhadeshi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ilizwi likaThixo liyayitshila imikusu","poem":1},{"text":"likhwebule izihlahla amagusu asale eze.","poem":2},{"text":"Njalo ethempelini lakhe bonke bazamemeza bathi,","poem":1},{"text":"“Inkazimulo!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"UThixo uhlezi ebukhosini phezu kwesikhukhula;","poem":1},{"text":"uThixo unguMbusi lanininini.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"UThixo unika amandla ebantwini bakhe;","poem":1},{"text":"uThixo ubusisa abantu bakhe ngokuthula.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}