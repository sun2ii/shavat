{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Ihubo likaDavida ebalekela indodana yakhe u-Abhisalomu."]},{"type":"verse","number":1,"content":[{"text":"Oh Thixo banengi kangaka abayizitha zami!","poem":1},{"text":"Banengi kangaka abangihlaselayo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abanengi bathi ngami,","poem":1},{"text":"“UNkulunkulu kayikumhlenga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kodwa wena uyisihlangu sokungivikela, Oh, Thixo,","poem":1},{"text":"inkazimulo yami, uphakamisa ikhanda lami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngikhala kakhulu kuThixo","poem":1},{"text":"uyangiphendula esentabeni yakhe engcwele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngilala phansi ngijumeke;","poem":1},{"text":"ngibuye ngiphaphame, ngoba uThixo uyangilondoloza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Angiyikubesaba abangamatshumitshumi ezinkulungwane","poem":1},{"text":"abangihlaselayo inxa zonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Phakama, awu Thixo","poem":1},{"text":"Ngisindise, Oh Nkulunkulu wami.","poem":2},{"text":"Zibethe zonke izitha zami emhlathini;","poem":1},{"text":"akhumule amazinyo ababi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"KuThixo kuvela insindiso.","poem":1},{"text":"Sengathi isibusiso Sakho singaba sebantwini Bakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}