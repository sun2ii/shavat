{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["Ihubo. Ingoma. Elokunikela ithempeli. ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ngizakuphakamisa, Oh Thixo,","poem":1},{"text":"ngoba wangenyula ekujuleni","poem":2},{"lineBreak":true},{"text":"awaze wavumela izitha zami zijabule phezu kwami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awu Thixo, Nkulunkulu wami,","poem":1},{"text":"ngacela Kuwe uncedo wangisilisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yebo Thixo wangenyula elibeni,","poem":1},{"text":"wangisiza ngaphepha ukungena egodini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hlabelelani kuThixo lina bathembekileyo bakhe;","poem":1},{"text":"dumisani ibizo lakhe elingcwele.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngoba ukuthukuthela Kwakhe ngokomzuzwana nje,","poem":1},{"text":"kodwa umusa wakhe ukhona okwempilo yonke;","poem":2},{"text":"ukulila kungaqhubeka ubusuku bonke,","poem":1},{"text":"kodwa ukuthokoza kuyafika ekuseni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngathi lapho ngizizwa ngihlezi kuhle ngathi,","poem":1},{"text":"“Kangisoze ngafa ngahlukuluzeka.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yebo Thixo, wathi lapho ungizwela","poem":1},{"text":"wenza intaba yami yagxila qho;","poem":2},{"text":"kodwa kwathi lapho usufihle ubuso Bakho","poem":1},{"text":"ngaphelelwa lithemba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngakhala kuwe, Thixo;","poem":1},{"text":"ngacela umusa eNkosini:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Kulenzuzo bani ngokubhujiswa kwami na,","poem":1},{"text":"ngokutshona kwami egodini?","poem":2},{"text":"Kambe uthuli luzakudumisa na?","poem":1},{"text":"Lona luzafakaza na ngokuthembeka Kwakho?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zwana, Oh Thixo, ube lomusa kimi;","poem":1},{"text":"woba lusizo lwami.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Waguqula ukububula kwami kwaba ngumgido;","poem":1},{"text":"wangihlubula izigqoko zamasaka wangigqokisa ukuthokoza,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ukuze inhliziyo yami ikuhlabelele ingathuli.","poem":1},{"text":"Oh Thixo, Nkulunkulu wami,","poem":2},{"lineBreak":true},{"text":"ngizakubonga nini lanini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}