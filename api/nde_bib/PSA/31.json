Nkulunkulu weqiniso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngiyabazonda labo abanamathela izithombe eziyize;","poem":1},{"text":"ngithemba kuThixo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngizathokoza ngijabule othandweni Lwakho,","poem":1},{"text":"ngoba wakubona ukuhlupheka kwami","poem":2},{"lineBreak":true},{"text":"wabazi ubuhlungu bomphefumulo wami.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kawungifuqelanga esitheni","poem":1},{"text":"kodwa ugxilise inyawo zami endaweni ebanzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Woba lomusa kimi, Oh Thixo, ngoba ngiyahlupheka;","poem":1},{"text":"amehlo ami ayafiphala ngenxa yosizi,","poem":2},{"lineBreak":true},{"text":"umphefumulo wami lomzimba wami ngokudabuka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Impilo yami incitshiswa yikukhathazeka,","poem":1},{"text":"leminyaka yami yikububula;","poem":2},{"text":"amandla ami ayadeda ngenxa yokuhlupheka kwami,","poem":1},{"text":"lamathambo ami aphela amandla.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngenxa yezitha zami,","poem":1},{"text":"sengiyinhlekisa enjani kubomakhelwane;","poem":2},{"text":"sengiyinhlekisa kubangane bami","poem":1},{"text":"labo abangibonayo ezindleleni bayangibalekela.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sebekhohliwe ngami kungathi sengafa;","poem":1},{"text":"senginjengembiza yebumba ehlephukileyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngoba ngizwa izingoma zabanengi;","poem":1},{"text":"kulezisongo inxa zonke;","poem":2},{"text":"bakha amasu okungilimaza,","poem":1},{"text":"njalo baceba ukuchitha impilo yami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kodwa ngiyethemba Kuwe, Thixo;","poem":1},{"text":"ngithi, “UnguNkulunkulu wami.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Izikhathi zami zisezandleni Zakho;","poem":1},{"text":"ngisindisa ezitheni zami","poem":2},{"lineBreak":true},{"text":"lakulabo abangizingelayo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ubuso Bakho mabukhazimulele encekwini Yakho;","poem":1},{"text":"ngisindisa ngothando Lwakho olungehlulekiyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mangingahlaziswa, Oh Thixo,","poem":1},{"text":"ngoba sengikhalile Kuwe;","poem":2},{"text":"kodwa akuthi ababi bahlaziswe","poem":1},{"text":"balale bathule zwi ethuneni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Akuthi izindebe zabo zamanga zithuliswe,","poem":1},{"text":"ezikhuluma ngokuzigqaja lokweyisa","poem":2},{"lineBreak":true},{"text":"bakhuluma ngobuqholo ngabantu abalungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kukhulu kangakanani ukulunga Kwakho","poem":1},{"text":"okugcinele labo abakwesabayo,","poem":2},{"text":"okunika obala abantu bebona","poem":1},{"text":"kulabo abaphephela Kuwe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Uyabafihla ekusithekeni kobukhona Bakho","poem":1},{"text":"emaqingeni ababi","poem":2},{"text":"uyabagcina bevikelwe emzini wakhe","poem":1},{"text":"ezilimini ezichothozayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Udumo alube kuThixo","poem":1},{"text":"ngoba watshengisa uthando lwakhe olumangalisayo kimi","poem":2},{"lineBreak":true},{"text":"ngisedolobheni elihanqiweyo yimpi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ngiphakathi kokwethuka ngathi,","poem":1},{"text":"“Sengisusiwe kangisabonakali Kuwe!”","poem":2},{"text":"Kanti wakuzwa ukukhala kwami ngicela umusa,","poem":1},{"text":"lapho ngangicela kuwe ukusizwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mthandeni uThixo,","poem":1},{"text":"lina bangcwele bakhe!","poem":2},{"text":"UThixo uyabalondoloza abathembekileyo,","poem":1},{"text":"kodwa abazigqajayo uyabaphindisela ngokugcweleyo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Qinani lime isibindi,","poem":1},{"text":"lonke lina elithemba uThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}