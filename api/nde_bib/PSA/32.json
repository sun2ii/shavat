{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ubusisiwe lowo","poem":1},{"text":"oziphambeko zakhe zithethelelwe,","poem":2},{"lineBreak":true},{"text":"ozono zakhe zisibekelwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ubusisiwe lowo","poem":1},{"text":"ongasoze abalelwe isono sakhe nguThixo,","poem":2},{"lineBreak":true},{"text":"njalo ongelankohliso emoyeni wakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngathi lapho ngithule,","poem":1},{"text":"amathambo ami ababuthakathaka","poem":2},{"lineBreak":true},{"text":"ngenxa yokububula kwami ilanga lonke.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoba imini lobusuku","poem":1},{"text":"isandla Sakho sasingelekile, singisinda;","poem":2},{"text":"amandla ami aphela","poem":1},{"text":"kwafana lesikhudumezi sehlobo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lapho-ke ngasengisivuma isono sami Kuwe","poem":1},{"text":"angabe ngisasibekela ububi bami.","poem":2},{"text":"Ngathi, “Ngizazivuma iziphambeko zami kuThixo,”","poem":1},{"text":"walithethelela icala lesono sami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngakho akuthi wonke umuntu othembekileyo akhuleke kuwe","poem":1},{"text":"usatholakala;","poem":2},{"text":"ngeqiniso kuzakuthi lapho impophoma seziqubuka,","poem":1},{"text":"kabayi kumfinyelela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uyindawo yami yokuphephela;","poem":1},{"text":"uzangivikela enkathazweni","poem":2},{"lineBreak":true},{"text":"ungizungeze ngezingoma zensindiso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngizakutshengisa ngikufundise indlela ofanele uhambe ngayo;","poem":1},{"text":"ngizakweluleka ngikulinde.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ungabi njengebhiza loba imbongolo,","poem":1},{"text":"khona akulakuzwisisa","poem":2},{"text":"kodwa kumele kukhokhelwa ngamatomu","poem":1},{"text":"ukuze umuntu kumlalele.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zinengi izikhalazo zababi,","poem":1},{"text":"kodwa uthando lukaThixo olungaphuthiyo","poem":2},{"lineBreak":true},{"text":"luyamzungeza umuntu othemba kuye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Thokozani kuThixo, lithabe lina balungileyo;","poem":1},{"text":"hlabelelani lonke lina eliqotho enhliziyweni!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}