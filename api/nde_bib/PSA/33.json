{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Hlabelelani kuThixo ngentokozo,","poem":1},{"text":"lina balungileyo;","poem":2},{"lineBreak":true},{"text":"kubafanele abaqotho ukumdumisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dumisani uThixo ngechacho;","poem":1},{"text":"mhlabeleleni ngesiginci sezintambo ezilitshumi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mhlabeleleni ingoma entsha;","poem":1},{"text":"tshayani kamnandi lihlokome ngentokozo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngoba ilizwi likaThixo lilungile, liqinisile;","poem":1},{"text":"uthembekile kukho konke akwenzayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"UThixo uthanda ukulunga lokwahlulela okuqondileyo;","poem":1},{"text":"umhlaba ugcwele uthando lwakhe olungaphuthiyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngelizwi likaThixo amazulu enziwa,","poem":1},{"text":"ubunkanyankanya bezinkanyezi ngomoya womlomo wakhe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uyawaqoqa amanzi olwandle awathele enkonxeni;","poem":1},{"text":"athululele inziki zolwandle eziphaleni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Umhlaba wonke kawesabe uThixo;","poem":1},{"text":"akuthi bonke abantu bomhlaba bazithobe phambi Kwakhe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngoba wakhuluma, kwahle kwaba khona;","poem":1},{"text":"wayala, kwema kwaqina nko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"UThixo uyawachitha amacebo ezizwe;","poem":1},{"text":"uyazinyampisa izinhloso zabantu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodwa amacebo kaThixo ami aqinile nini lanini,","poem":1},{"text":"izinhloso zenhliziyo yakhe kuzozonke izizukulwane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sibusisekile isizwe uNkulunkulu waso onguThixo,","poem":1},{"text":"abantu abakhethayo baba yilifa lakhe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"UThixo ukhangele phansi esezulwini","poem":1},{"text":"ababone bonke abantu;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"esemzini wakhe","poem":1},{"text":"uyababona bonke abahlala emhlabeni","poem":2}]},{"type":"verse","number":15,"content":[{"text":"yena owenza inhliziyo zabo bonke,","poem":1},{"text":"enanzelela konke abakwenzayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Akulankosi esizwa yibukhulu bebutho layo;","poem":1},{"text":"akulaqhawe eliphunyuka ngamandla alo amakhulu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yikuthemba ize ukuthi ibhiza lingakusindisa;","poem":1},{"text":"loba lona lilamandla amakhulu ngeke lisindise.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kodwa amehlo kaThixo akulabo abamesabayo,","poem":1},{"text":"kulabo othemba labo lisethandweni lwakhe olungapheliyo,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ukubakhulula ekufeni","poem":1},{"text":"baphiliswe lanxa kulendlala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Simlindele uThixo ngokwethemba;","poem":1},{"text":"ulusizo lwethu lesihlangu sethu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inhliziyo zethu zithokoza Ngaye,","poem":1},{"text":"ngoba sithembe ebizweni lakhe elingcwele.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sengathi uthando Lwakho olungaphuthiyo, Thixo, lungaba phezu kwethu","poem":1},{"text":"njengalokhu sibeka ithemba lethu kuwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}