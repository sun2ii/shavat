{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"hebrew_subtitle","content":["ElikaDavida. Lapho azenza uhlanya ku-Abhimelekhi, owamxotshayo wahamba."]},{"type":"verse","number":1,"content":[{"text":"Ngizamphakamisa uThixo ngezikhathi zonke;","poem":1},{"text":"indumiso yakhe izahlala isezindebeni zami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Umphefumulo wami uzaziqhenya Thixo","poem":1},{"text":"akuthi abahluphekileyo bezwe bajabule.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bongani uThixo kanye lami;","poem":1},{"text":"kasiphakamiseni ibizo lakhe sonke, ndawonye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngamdinga uThixo wangiphendula;","poem":1},{"text":"wangikhulula kukho konke engangikwesaba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Labo abakhangele Kuye bayakhazimula;","poem":1},{"text":"ubuso babo abungeke bembeswe lihlazo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isihlupheki lesi samemeza, uThixo wasizwa;","poem":1},{"text":"wasisindisa kuzozonke inhlupheko zaso.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ingilosi kaThixo iyabazungeza","poem":1},{"text":"labo abamesabayo, ibakhulule.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nambithani libone ukuthi uThixo ulungile;","poem":1},{"text":"ubusisiwe umuntu ophephela Kuye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mesabeni Uthixo, lina bangcwele bakhe,","poem":1},{"text":"ngoba labo abamesabayo kabasweli lutho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Izilwane zingaphela amandla zilambe,","poem":1},{"text":"kodwa labo abamdingayo uThixo kabasweli lutho oluhle.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wozani, bantwabami, lalelani kimi;","poem":1},{"text":"ngizalifundisa ukumesaba uThixo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lowo othanda ukuphila","poem":1},{"text":"abone lezinsuku ezinhle kumele","poem":2}]},{"type":"verse","number":13,"content":[{"text":"anqande ulimi lwakhe kokubi","poem":1},{"text":"lezindebe zakhe ekukhulumeni inkohliso.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tshiya ububi wenze okulungileyo;","poem":1},{"text":"funa ukuthula ukunxwanele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Amehlo kaThixo akhangele abalungileyo","poem":1},{"text":"lezindlebe zakhe ziyezwa ukukhala kwabo;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ubuso bukaThixo bumelana lalabo abenza okubi,","poem":1},{"text":"ukuba acitshe ukukhunjulwa kwabo emhlabeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Abalungileyo bayakhala kuThixo abezwe;","poem":1},{"text":"uyabakhulula kuzozonke inhlupheko zabo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"UThixo useduze labo abalezinhliziyo ezephukileyo","poem":1},{"text":"asindise labo abadabukileyo emoyeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Umuntu olungileyo angaba lezinhlupheko ezinengi,","poem":1},{"text":"kodwa uThixo uyamkhulula kuzozonke.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Uyawavikela wonke amathambo akhe,","poem":1},{"text":"kungephuki loba lalinye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ububi buzambulala oyisixhwali;","poem":1},{"text":"izitha zolungileyo zizalahlwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"UThixo uyazihlenga izinceku zakhe;","poem":1},{"text":"kakho ozalahlwa ophephela kuye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}