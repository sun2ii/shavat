{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Xabana labo, Thixo abaxabana lami;","poem":1},{"text":"lwana labo abalwa lami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Thatha isihlangu lewisa;","poem":1},{"text":"phakama uzongilamulela.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Phakamisa umkhonto lesijula,","poem":1},{"text":"ukuqondise kwabangihlaselayo.","poem":2},{"text":"Ngitshela ukuthi,","poem":1},{"text":"“Ngiyikusindiswa kwakho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sengathi labo abazingela impilo yami","poem":1},{"text":"bangayangiswa bathelwe ngehlazo;","poem":2},{"text":"sengathi labo abazama ukungidiliza","poem":1},{"text":"bangabuyiselwa emuva bedumazekile.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sengathi bangaba njengamakhoba emoyeni,","poem":1},{"text":"ingilosi kaThixo ibe ibadudula ibaxotsha;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"sengathi indlela yabo ingaba mnyama itshelele,","poem":1},{"text":"ingilosi kaThixo ibe ibahlezi ezithendeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngoba bangithiya ngamambule abo ngingonanga lutho,","poem":1},{"text":"baphinda bangembela umgodi kungelasizatho,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"sengathi bangadilizwa belibele","poem":1},{"text":"lawomambule abawathiyileyo abahilele,","poem":2},{"lineBreak":true},{"text":"sengathi bangawela kulowomgodi babhidlizwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lapho-ke umoya wami uzathokoza kuThixo","poem":1},{"text":"ujabule ekusindiseni Kwakhe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mina qobo lwami ngizamemeza ngithi,","poem":1},{"text":"“Ngubani onjengawe, Oh Thixo?","poem":2},{"text":"Uyabakhulula abahluphekayo kulabo abalamandla kulabo,","poem":1},{"text":"abahluphekayo labaswelayo kulabo ababantshontshelayo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ofakazi bolunya bayangivelela;","poem":1},{"text":"bangibuza ngezinto engingazaziyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bangiphindisela okuhle ngokubi","poem":1},{"text":"umphefumulo wami usale usudabukile.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ikanti kwathi bona begula ngembatha amasaka","poem":1},{"text":"ngazithoba ngazila ukudla.","poem":2},{"text":"Kwathi lapho imikhuleko yami ingaphendulwa","poem":1}]},{"type":"verse","number":14,"content":[{"text":"ngaba sesililweni","poem":2},{"lineBreak":true},{"text":"kwangathi ngililela umngane wami loba umfowethu.","poem":2},{"text":"Ngakhothamisa ikhanda lami ngokudabuka","poem":1},{"text":"kwangathi ngililela umama.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kodwa ngathi sengikhubekile baqwebana bokha insini;","poem":1},{"text":"abahlaseli bangihlanganyela ngilibele.","poem":2},{"lineBreak":true},{"text":"Bangichothoza okungapheliyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bakloloda ngomona njengabangakholwayo;","poem":1},{"text":"bangigedlela amazinyo abo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nkosi, uzakuma ubukele kuze kube nini na?","poem":1},{"text":"Yenyula impilo yami ekungilimazeni kwabo,","poem":2},{"lineBreak":true},{"text":"impilo yami eligugu kulezizilwane.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngizakubonga phakathi komhlangano omkhulu;","poem":1},{"text":"ngikudumise ngiphakathi kwamaxuku abantu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ungabayekeli abayizitha zami ngingabonelanga lutho,","poem":1},{"text":"bantele phezu kwami.","poem":2},{"text":"Ungayekeli labo abangizondayo kungelasizatho,","poem":1},{"text":"banginyonkoloze ngomona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kabakhulumi okuqondileyo","poem":1},{"text":"kodwa babumba amacala amanga,","poem":2},{"lineBreak":true},{"text":"ngalabo abaphila ngokuthula elizweni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bangikhamisela imilomo bathi, “Hiya belo!","poem":1},{"text":"Sizibonele ngawethu amehlo la.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Oh Thixo, usukubonile lokhu; ungathuli.","poem":1},{"text":"Ungabi khatshana kwami, Oh Nkosi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Vuka, uphakame ungilamulele!","poem":1},{"text":"Ngilwela, Nkulunkulu Thixo wami.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngigeza ngokulunga Kwakho,","poem":1},{"text":"Thixo, Nkulunkulu wami;","poem":2},{"lineBreak":true},{"text":"ungabayekeli bantele phezu kwami.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ungabayekeli bacabange bathi, “Ehe, yikho ebesikufuna!”","poem":1},{"text":"loba bathi, “Sesimginyile.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Sengathi bonke abantela ngokuhlupheka kwami","poem":1},{"text":"bangathelwa ngehlazo basanganiseke;","poem":2},{"text":"sengathi bonke abazikhukhumezayo phezu kwami","poem":1},{"text":"bangembeswa ngokuyangeka langehlazo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sengathi labo abathokoza ngokugezwa kwami","poem":1},{"text":"bangahalalisa ngentokozo lenjabulo;","poem":2},{"text":"sengathi bangatsho kokuphela bathi,","poem":1},{"text":"“Makaphakanyiswe uThixo","poem":2},{"lineBreak":true},{"text":"othokoza ngokuhlala kuhle kwenceku yakhe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ulimi lwami luzakhuluma ngokulunga Kwakho","poem":1},{"text":"langendumiso Yakho ilanga lonke.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}