{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. ElikaDavida inceku kaThixo."]},{"type":"verse","number":1,"content":[{"text":"Ngilenkinga enhliziyweni yami","poem":1},{"text":"mayelana lokuxhwala kwesigangi:","poem":2},{"text":"Kakukho ukwesaba uNkulunkulu","poem":1},{"text":"engqondweni yaso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Phela kweyaso ingqondo siyazikhohlisa","poem":1},{"text":"size sehluleke ukubona kumbe ukuzonda isono saso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amazwi omlomo waso abolile alenkohliso;","poem":1},{"text":"kasiselakho ukuhlakanipha lokulunga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwala loba silele siceba ububi;","poem":1},{"text":"sizinikela endleleni yobubi","poem":2},{"lineBreak":true},{"text":"njalo kasikulahli okubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Uthando Lwakho, Thixo, lufika emazulwini,","poem":1},{"text":"ukuthembeka Kwakho esibhakabhakeni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ukulunga Kwakho kunjengezintaba ezesabekayo,","poem":1},{"text":"ukwahlulela kuhle Kwakho njengolwandle olukhulu.","poem":2},{"lineBreak":true},{"text":"Oh Thixo, uyamlondoloza umuntu kanye lenyamazana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Luligugu elinganani uthando Lwakho olungaphuthiyo,","poem":1},{"text":"Oh Nkulunkulu!","poem":2},{"text":"Bonke abantu bazuza isiphephelo","poem":1},{"text":"emthunzini wamaphiko Akho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bayazitika ngokudla okunengi endlini Yakho;","poem":1},{"text":"ubapha okunathwayo okwemfuleni wakho wokuthokoza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngoba kuwe kulomthombo wokuphila;","poem":1},{"text":"kokwakho ukukhanya sibona ukukhanya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Qhubeka ngothando Lwakho kulabo abakwaziyo,","poem":1},{"text":"ukuluga Kwakho kwabaqotho enhliziyweni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sengathi unyawo lwabazazisayo lungehluleka ukunginyathela,","poem":1},{"text":"loba ukuthi isandla sababi singangixotshi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bonani-ke ukuthi izigangi sezithe daca","poem":1},{"text":"ziwiselwe phansi, kazisavuki futhi!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}