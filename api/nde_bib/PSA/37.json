{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"hebrew_subtitle","content":["ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ungazikhathazi ngabantu ababi","poem":1},{"text":"loba uhawukele labo abenza okungalunganga;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ngoba bazabuna masinyane njengotshani,","poem":1},{"text":"njengezimila eziluhlaza bazakufa masinyane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Themba kuThixo wenze okulungileyo;","poem":1},{"text":"hlala elizweni ukholise amadlelo amahle.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zithokozise kuThixo","poem":1},{"text":"Yena uzakupha izifiso zenhliziyo yakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nikela indlela zakho kuThixo;","poem":1},{"text":"themba kuye, Yena uzakwenzela lokhu:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uzakwenza ukulunga kwakho kukhazimule njengentathakusa,","poem":1},{"text":"ubuqotho balokho okulwelayo njengelanga lemini enkulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Chuma phambi kukaThixo","poem":1},{"text":"umlindele ngesineke;","poem":2},{"text":"ungakhathazeki nxa abantu bephumelela ngezindlela zabo,","poem":1},{"text":"nxa bephutshisa amaqhinga abo amabi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xwayana lokuzonda njalo ufulathele intukuthelo;","poem":1},{"text":"ungakhathazeki, kukhokhelela ebubini kuphela.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngoba abantu ababi bazasuswa,","poem":1},{"text":"kodwa labo abathemba uThixo bazakudla ilifa lelizwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kuseyisikhatshana nje, ababi bazabe bengasekho;","poem":1},{"text":"loba usubadinga kabasayikufunyanwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodwa abathobekileyo bazakudla ilifa lelizwe","poem":1},{"text":"njalo bakholise ukuthula okukhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ababi baceba ukulimaza abalungileyo","poem":1},{"text":"babagedlele amazinyo;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kodwa iNkosi iyabahleka ababi,","poem":1},{"text":"ngoba iyazi ukuthi usuku lwabo luyeza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ababi bakhokha inkemba,","poem":1},{"text":"badonsa idandili","poem":2},{"text":"ngenhloso yokulimaza abahluphekayo labaswelayo,","poem":1},{"text":"lokubulala labo abahamba ngokulunga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kodwa izinkemba zabo zizagwaza ezabo inhliziyo,","poem":1},{"text":"lamadandili abo azakwephulwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kungcono ingcosana leyo abalayo abalungileyo","poem":1},{"text":"kulenotho yababi abanengi;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ngoba amandla ababi azaqedwa,","poem":1},{"text":"kodwa uThixo uyabaxhasa abalungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Insuku zabangelasici ziyaziwa nguThixo,","poem":1},{"text":"ilifa labo lizakuma lanini.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngezikhathi zomonakalo abayikubuna;","poem":1},{"text":"ngezikhathi zendlala bazasutha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kodwa ababi bazabhubha;","poem":1},{"text":"izitha zikaThixo zinjengobuhle beganga,","poem":2},{"lineBreak":true},{"text":"zizanyamalala, zinyamalale njengentuthu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ababi bayaboleka kodwa kababuyiseli,","poem":1},{"text":"kodwa abalungileyo bayapha kakhulu;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"labo uThixo ababusisayo bazakudla ilifa lelizwe;","poem":1},{"text":"kodwa labo abathukayo bazasuswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Nxa uThixo ethokoziswa yikuhamba komuntu,","poem":1},{"text":"uyaqinisa izinyathelo zakhe;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"loba angakhubeka, kayikuwa,","poem":1},{"text":"ngoba uThixo uyamsekela ngesandla sakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ngangimutsha, manje sengiluphele,","poem":1},{"text":"kodwa angizange ngibone abalungileyo bedelwa","poem":2},{"lineBreak":true},{"text":"loba abantwababo becela isinkwa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bayaphana kokuphela njalo bayebolekana nje;","poem":1},{"text":"abantwababo bazabusiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Phendukani ebubini lenze ukulunga","poem":1},{"text":"lapho-ke lizahlala elizweni nini lanini.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ngoba uThixo uthanda abalungileyo","poem":1},{"text":"njalo kayikubadela abathembekileyo bakhe.","poem":2},{"lineBreak":true},{"text":"Bazavikelwa kuze kube nini lanini","poem":1},{"text":"kodwa inzalo yababi izalahlwa;","poem":2}]},{"type":"verse","number":29,"content":[{"text":"abalungileyo bazazuza ilifa lelizwe","poem":1},{"text":"bahlale kulo lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Umlomo womuntu olungileyo ukhuluma ukuhlakanipha,","poem":1},{"text":"lolimi lwakhe lukhuluma okuqondileyo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Umthetho kaNkulunkulu wakhe usenhliziyweni yakhe;","poem":1},{"text":"inyawo zakhe kazitsheleli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Ababi bacathamela abalungileyo","poem":1},{"text":"befuna impilo yabo qobo lwayo;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"kodwa uThixo kayikubayekela bazenzele abakuthandayo","poem":1},{"text":"kubo kumbe balahlwe licala nxa bethonisiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Lindelani uThixo ligcine indlela yakhe.","poem":1},{"text":"Uzaliphakamisa lilithathe ilifa lelizwe;","poem":2},{"lineBreak":true},{"text":"lizakubona lokhu nxa ababi sebesusiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Sengike ngabona umuntu omubi olesihluku","poem":1},{"text":"kulokubhadala ehluma njengesihlahla,","poem":2},{"lineBreak":true},{"text":"esikhula kuhle emhlabathini waso wemvelo,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"kodwa waphanga wafa kabe esabakhona;","poem":1},{"text":"ngathi loba sengimdinga ngamswela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Nanzelela abangelecala, qaphela abaqotho.","poem":1},{"text":"Likhona ikusasa kumuntu wokuthula.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Kodwa zonke izoni zizabhujiswa;","poem":1},{"text":"ikusasa lezigangi lizasuswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Ukusindiswa kwabalungileyo kuvela kuThixo;","poem":1},{"text":"uyinqaba yabo ngesikhathi sokuhlupheka.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"UThixo uyabasiza abakhulule;","poem":1},{"text":"abakhulule kwababi abasindise,","poem":2},{"lineBreak":true},{"text":"ngoba baphephela kuye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}