{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"hebrew_subtitle","content":["Ihubo likaDavida. Isikhalazo."]},{"type":"verse","number":1,"content":[{"text":"Awu Thixo, ungangikhuzi","poem":1},{"text":"ngolaka loba ungijezise uthukuthele.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngoba imitshoko yakho ingicibile,","poem":1},{"text":"njalo wangibhansula kakhulu ngesandla sakho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngenxa yokuthukuthela kwakho kangiselakuphila emzimbeni wami;","poem":1},{"text":"amathambo ami kawasaqinanga ngenxa yesono sami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ukona kwami sekungisinda","poem":1},{"text":"njengomthwalo onzima ongathwalekiyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Izilonda zami sezilobovu sezisenyanyeka","poem":1},{"text":"ngenxa yobuthutha bami besono.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngiyangiswe ngehliswa kakhulu;","poem":1},{"text":"sengitshona ngilila ilanga lonke.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngiphethwe liqolo ngobuhlungu obuqumayo;","poem":1},{"text":"umzimba wami kawuselampilo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sengibuthakathaka, sengicikizekile;","poem":1},{"text":"ngiyabubula ngobuhlungu benhliziyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zonke iziloyiso zami zisobala kuwe, Oh Thixo,","poem":1},{"text":"ukububula kwami kakufihlekanga kuwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inhliziyo yami iyagubhazela, amandla ami ayaphela;","poem":1},{"text":"lokukhanya sekufiphele emehlweni ami.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abangane bami labakhula bami sebengibalekela ngenxa yamanxeba ami;","poem":1},{"text":"omakhelwane bami sebehlalela khatshana","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Labo abafuna impilo yami sebethiyile,","poem":1},{"text":"labo abafuna ukungilimaza bakhuluma ngokungidiliza;","poem":2},{"lineBreak":true},{"text":"ilanga lonke batshonela ukwakha amacebo enkohliso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sengifana lesacuthe esingezwayo,","poem":1},{"text":"njengesimungulu esehluleka ukuvula umlomo waso;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"senginjengomuntu ongezwayo,","poem":1},{"text":"olomlomo ongaphenduliyo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngikulindele, Oh Thixo,","poem":1},{"text":"uzaphendula, Oh Nkosi Nkulunkulu wami.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngoba ngathi, “Ungabayekeli baklolode","poem":1},{"text":"kumbe bazikhukhumeze phezu kwami nxa unyawo lwami lutshelela.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ngoba sengiseduze lokuwa,","poem":1},{"text":"lobuhlungu bungiphethe njalonjalo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngiyabuvuma ububi bami;","poem":1},{"text":"ngiyakhathazeka ngesono sami.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Banengi labo abayizitha zami ezitshisekayo,","poem":1},{"text":"labo abangizonda bengelasizatho banengi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Labo abangiphindisela okuhle ngokubi","poem":1},{"text":"bayangigcona lapho ngisenza okulungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Oh Thixo, ungangideli;","poem":1},{"text":"ungabi khatshana lami, Oh Nkulunkulu wami.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Woza masinyane uzongisiza,","poem":1},{"text":"Nkosi yami loMsindisi wami.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}