{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. ElikaJeduthuni. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ngathi, “Ngizaziqaphela izindlela zami,","poem":1},{"text":"ngiluthinte ulimi lwami esonweni;","poem":2},{"text":"ngizawugcika umlomo wami","poem":1},{"text":"nxa ababi bekhona phambi kwami.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kodwa kwathi lapho ngithule ngithe zwi,","poem":1},{"text":"ngingatsho lutho loba lungoluhle","poem":2},{"text":"ubuhlungu benhliziyo yami bakhula.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Inhliziyo yami yavutha ngaphakathi kwami;","poem":2},{"text":"kwathi lapho ngizuliswa yimicabango, umlilo wavutha;","poem":1},{"text":"ngasengikhuluma ngolimi lwami:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ngitshengisa, Thixo, isiphetho sempilo yami","poem":1},{"text":"lobunengi bezinsuku zami;","poem":2},{"lineBreak":true},{"text":"ngazisa ukuthi impilo yami igijima kanganani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Usuwenze insuku zami zaba lobubanzi besandla;","poem":1},{"text":"ububanzi beminyaka yami kabusilutho kuwe.","poem":2},{"text":"Impilo yabantu ingumoya kuphela,","poem":1},{"text":"kanye lalabo abakhanya behlalisekile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Umuntu uhambahamba njengesithunzi nje;","poem":1},{"text":"uyatshikatshika, kodwa konke akwenzayo kuyize lodwa;","poem":2},{"lineBreak":true},{"text":"ubuthelela inotho engazi ukuthi izakuba ngekabani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kodwa okwamanje, Thixo, ngisafunani kambe?","poem":1},{"text":"Ithemba lami likuwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngisindisa kuzozonke iziphambeko zami;","poem":1},{"text":"ungangenzi inhlekisa yezitha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngathula; ngangingeke ngiwuvule umlomo wami,","poem":1},{"text":"ngoba lokhu kwenziwe nguwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Susa uswazi lwakho kimi;","poem":1},{"text":"sengikhulelwa yisidutshulo sesandla sakho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abantu uyabakhuza ubajezisele isono sabo;","poem":1},{"text":"ucikiza inotho yabo njengenondo","poem":2},{"lineBreak":true},{"text":"ngempela umuntu ngamunye ungumoya nje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Zwana umkhuleko wami, Oh Thixo,","poem":1},{"text":"lalela isikhalazo sami ngicela uncedo;","poem":2},{"lineBreak":true},{"text":"ungabi ligcikandlebe nxa ngikhala.","poem":2},{"text":"Phela ngihlala lawe nginjengesihambi, ngiyisethekeli","poem":1},{"text":"njengoba okhokho bonke babenjalo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ake ukhangele eceleni nje ukuze ngithokoze njalo,","poem":1},{"text":"ngingakasuki lapha ngibe ngongasekho.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}