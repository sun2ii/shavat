{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ngeziginci. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ngiphendula lapho ngikubiza,","poem":1},{"text":"Oh Nkulunkulu wami olungileyo.","poem":2},{"text":"Ake ungiphumuze ekuhlulukelweni engikukho;","poem":1},{"text":"woba lomusa kimi njalo uzwe umkhuleko wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Koze kube nini, we bantu,","poem":1},{"text":"koze kube nini inkazimulo yami liyenza ihlazo?","poem":2},{"text":"Koze kube nini lithanda inkohliso","poem":1},{"text":"njalo lidinga onkulunkulu bamanga?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yazini ukuthi uThixo","poem":1},{"text":"usezehlukanisele labo abathembekileyo,","poem":2},{"lineBreak":true},{"text":"njalo uThixo uyezwa nxa ngikhala kuye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ekuthukutheleni kwenu lingoni;","poem":1},{"text":"nxa lisemibhedeni yenu","poem":2},{"lineBreak":true},{"text":"hlolani inhliziyo zenu, lithule.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nikelani imihlatshelo eqondileyo,","poem":1},{"text":"limethembe uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abanengi bayabuza bathi,","poem":1},{"text":"“Kuvele ngubani ongasitshengisa ukulunga na?”","poem":2},{"text":"Sengathi ukukhanya kobuso bakho","poem":1},{"text":"kungakhazimula phezu kwethu, Oh Thixo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uyigcwalisile inhliziyo yami ngentokozo enkulu","poem":1},{"text":"eyedlula ubunengi bamabele abo lewayini labo elitsha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngizalala phansi ngijunywe yibuthongo ngilokuthula,","poem":1},{"text":"ngoba wena wedwa,","poem":2},{"lineBreak":true},{"text":"Oh Thixo, uhlezi ungilondolozile.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}