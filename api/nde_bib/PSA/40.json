{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. ElikaDavida. Ihubo."]},{"type":"verse","number":1,"content":[{"text":"Ngamlindela ngesineke uThixo;","poem":1},{"text":"waphendukela ngakimi wezwa ukukhala kwami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wangenyula emgodini otshonayo,","poem":1},{"text":"wangikhupha edakeni lexhaphozini;","poem":2},{"text":"wamisa inyawo zami edwaleni,","poem":1},{"text":"wangipha indawo eqinileyo yokuma.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wangipha ingoma entsha emlonyeni wami,","poem":1},{"text":"ihubo lokudumisa kuNkulunkulu wethu.","poem":2},{"text":"Abanengi bazabona besabe","poem":1},{"text":"babeke ithemba labo kuThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ubusisiwe umuntu","poem":1},{"text":"owenza uThixo abe lithemba lakhe,","poem":2},{"text":"ongathembi abazigqajayo,","poem":1},{"text":"lalabo abaqambukela kubonkulunkulu bamanga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zinengi, Thixo, Nkulunkulu wami,","poem":1},{"text":"izimangaliso ozenzileyo.","poem":2},{"text":"Izinto owasilungiselela zona","poem":1},{"text":"kakho ongazibala kuwe;","poem":2},{"text":"aluba bengingakhuluma","poem":1},{"text":"loba ngilandise ngazo,","poem":2},{"lineBreak":true},{"text":"zingaba zinengi ngokweqileyo ukuzibalisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kawufisanga imihlatshelo leminikelo","poem":1},{"text":"kodwa indlebe zami uzikleklile;","poem":2},{"lineBreak":true},{"text":"iminikelo yokutshiswa leminikelo yesono kawuzange uyidinge.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lapho-ke ngasengisithi, “Ngilapha, sengifikile","poem":1},{"text":"kulotshiwe ngami emqulwini.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngiyakunxwanela ukwenza intando yakho, Oh Nkulunkulu wami;","poem":1},{"text":"umthetho wakho usenhliziyweni yami.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngiyafakaza ngokulunga ngisemhlanganweni omkhulu;","poem":1},{"text":"angizivali izindebe zami, njengoba usazi, Oh Thixo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ukulunga kwakho kangikufihli enhliziyweni yami;","poem":1},{"text":"ngikhuluma ngokuthembeka kwakho lokusindisa kwakho.","poem":2},{"text":"Kangilufihli uthando lwakho leqiniso lakho","poem":1},{"text":"emhlanganweni omkhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ungasigodli isihawu sakho kimi, Oh Thixo;","poem":1},{"text":"sengathi uthando lwakho leqiniso lakho kungahlala kungivikela.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Phela inhlupheko ezingelakubalwa zingihanqile;","poem":1},{"text":"izono zami sezingificile, kangisaboni.","poem":2},{"text":"Zinengi kulenwele zekhanda lami,","poem":1},{"text":"njalo inhliziyo yami isiphela amandla.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jabula, awu Thixo, ungisindise;","poem":1},{"text":"awu Thixo, woza masinyane uzongisiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sengathi bonke abafuna ukuqeda impilo yami","poem":1},{"text":"bangayangiswa basanganiswe;","poem":2},{"text":"sengathi bonke abafisa ukungidiliza","poem":1},{"text":"bangabuyiselwa emuva beyangekile.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sengathi bonke abathi kimi, “Ehe, Ehe!”","poem":1},{"text":"banganengwa lihlazo labo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kodwa akuthi bonke abakudingayo","poem":1},{"text":"bathokoze bajabule kuwe;","poem":2},{"text":"akuthi labo abathanda insindiso yakho bahlale besithi,","poem":1},{"text":"“UThixo kadunyiswe!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kodwa mina ngiyahlupheka, ngiyaswela;","poem":1},{"text":"sengathi iNkosi ingangikhumbula.","poem":2},{"text":"Ilusizo lwami lomkhululi wami;","poem":1},{"text":"Oh Nkulunkulu wami, ungalibali.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}