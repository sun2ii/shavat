{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ubusisiwe lowo onanza abahluphekayo;","poem":1},{"text":"uThixo uyamkhulula ngezikhathi zokuhlupheka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"UThixo uzamvikela alondoloze impilo yakhe;","poem":1},{"text":"uzambusisa phakathi kwelizwe","poem":2},{"lineBreak":true},{"text":"akasoze amnikele emandleni ezitha zakhe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"UThixo uzamqinisa lanxa elele egula","poem":1},{"text":"njalo amsilise avuke ekuguleni kwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngathi, “Oh Thixo ake ungihawukele;","poem":1},{"text":"ngisilisa, ngoba ngonile kuwe.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Izitha zami ziyangigcona zithi,","poem":1},{"text":"“Uzakufa nini licitshe ibizo lakhe?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nxa omunye wabo efika ezongibona,","poem":1},{"text":"ukhuluma kuhle angikhohlise,","poem":2},{"lineBreak":true},{"text":"kodwa enhliziyweni yakhe egaya izibozi;","poem":2},{"lineBreak":true},{"text":"athi angaphuma ahambe esekhihliza ebantwini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bonke abangizondayo banyenyezelana ngami;","poem":1},{"text":"bangicabangela wonke amanyala besithi,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Usengenwe ngumkhuhlane omubi;","poem":1},{"text":"kasoze asile avuke futhi.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lomngane wami osekhwapheni,","poem":1},{"text":"ebengimthembile,","poem":2},{"text":"lowo obesidla lami isinkwa","poem":1},{"text":"usengihlamukele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kodwa wena, Oh Thixo ake ungihawukele;","poem":1},{"text":"ake ungivuse ukuze ngibakhawulise.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngiyazi ukuthi uyathokoza ngami,","poem":1},{"text":"ngoba isitha sami kasingehluli.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ubuqotho bami busekelwa nguwe","poem":1},{"text":"njalo ungimisa phambi kwakho nini lanini.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Udumo alube kuye uThixo, uNkulunkulu ka-Israyeli,","poem":1},{"text":"kusukela nininini kuze kube nininini.","poem":2},"Ameni njalo Ameni!"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}