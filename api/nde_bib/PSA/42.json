{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo lamaDodana kaKhora."]},{"type":"verse","number":1,"content":[{"text":"Njengempala inxwanela imifula yamanzi,","poem":1},{"text":"kunjalo umphefumulo wami uyakunxwanela, Oh Nkulunkulu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Umphefumulo wami womela uNkulunkulu, uNkulunkulu ophilayo.","poem":1},{"text":"Ngizahamba nini ngiyohlangana loNkulunkulu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inyembezi zami seziyikudla kwami","poem":1},{"text":"imini lobusuku,","poem":2},{"text":"lapho abantu besithi kimi ilanga lonke,","poem":1},{"text":"“Ungaphi uNkulunkulu wakho?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lezizinto ngiyazikhumbula","poem":1},{"text":"nxa ngizisola kakhulu ngidabukile:","poem":2},{"text":"Ngangihamba endlini kaNkulunkulu,","poem":1},{"text":"ngaphansi kwempiko zikaSomandla","poem":2},{"text":"sihlokoma ngentokozo langokubonga","poem":1},{"text":"lexuku elithakazelela umkhosi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kungani wephukile na, wena mphefumulo wami?","poem":1},{"text":"Kungani udungekile kanje ngaphakathi kwami?","poem":2},{"text":"Beka ithemba lakho kuNkulunkulu,","poem":1},{"text":"ngoba ngisezakumdumisa,","poem":2},{"lineBreak":true},{"text":"uMsindisi wami loNkulunkulu wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Umphefumulo wami wephukile ngaphakathi kwami;","poem":1},{"text":"ngakho ngizakukhumbula","poem":2},{"text":"kusukela esifundeni seJodani,","poem":1},{"text":"iziqongo zaseHemoni,","poem":2},{"lineBreak":true},{"text":"kusukela entabeni iMizari.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inziki imemeza inziki","poem":1},{"text":"phakathi kwenhlokomo yezimpophoma zakho;","poem":2},{"text":"wonke amavinqo lokukhaphaka","poem":1},{"text":"sekugabhela phezu kwami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Emini uThixo uyaluqondisa uthando lwakhe","poem":1},{"text":"ebusuku ingoma yakhe ikhona kimi","poem":2},{"lineBreak":true},{"text":"umkhuleko kuNkulunkulu wempilo yami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngithi kuNkulunkulu iDwala lami,","poem":1},{"text":"“Kutheni usungikhohliwe na?","poem":2},{"text":"Kutheni sengizula ngingolilayo,","poem":1},{"text":"ngincindezelwa yisitha na?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amathambo ami ezwa ubuhlungu obungiqedayo","poem":1},{"text":"lapho izitha zami zingihoza,","poem":2},{"text":"zisithi kimi ilanga lonke,","poem":1},{"text":"“Ungaphi uNkulunkulu wakho?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kungani wephukile na, wena mphefumulo wami?","poem":1},{"text":"Kungani udungekile kanje ngaphakathi kwami?","poem":2},{"text":"Beka ithemba lakho kuNkulunkulu,","poem":1},{"text":"ngoba ngisezakumdumisa,","poem":2},{"lineBreak":true},{"text":"uMsindisi wami loNkulunkulu wami.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}