{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Ngigeza, awu Nkulunkulu,","poem":1},{"text":"ungimele","poem":2},{"lineBreak":true},{"text":"uphikise isizwe esingathembekanga;","poem":2},{"text":"ngikhulula ebantwini","poem":1},{"text":"ababi abalenkohliso.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"UnguNkulunkulu inqaba yami.","poem":1},{"text":"Usungilahlelani na?","poem":2},{"text":"Kungani sengizula ngilila","poem":1},{"text":"ngincindezelwa yisitha sami na?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Thumela ukukhanya kwakho leqiniso lakho,","poem":1},{"text":"kakungikhokhele;","poem":2},{"text":"kakungilethe entabeni yakho engcwele,","poem":1},{"text":"endaweni lapho ohlala khona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lapho-ke ngizakuya e-alithareni likaNkulunkulu,","poem":1},{"text":"kuNkulunkulu, intokozo yami lenjabulo yami.","poem":2},{"text":"Ngizakudumisa ngechacho,","poem":1},{"text":"Oh Nkulunkulu, Nkulunkulu wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kungani wephukile, wena mphefumulo wami?","poem":1},{"text":"Kungani udungekile kanje ngaphakathi kwami?","poem":2},{"text":"Beka ithemba lakho kuNkulunkulu,","poem":1},{"text":"ngoba ngisezakumdumisa, uMsindisi wami","poem":2},{"lineBreak":true},{"text":"loNkulunkulu wami.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}