{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo lamaDodana kaKhora."]},{"type":"verse","number":1,"content":[{"text":"Sizizwele ngezethu indlebe, yebo Oh Nkulunkulu","poem":1},{"text":"obaba basitshela","poem":2},{"text":"owakwenzayo ensukwini zabo,","poem":1},{"text":"ensukwini zekadeni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngezakho izandla wazixotsha izizwe","poem":1},{"text":"wagxumeka obaba;","poem":2},{"text":"wabahlifiza abantu","poem":1},{"text":"wenza obaba baphumelela.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwakungasinkemba zabo ezathumba ilizwe,","poem":1},{"text":"njalo kakusingalo yabo eyaletha ukunqoba;","poem":2},{"text":"kwaba yisandla sakho sokunene, ingalo yakho,","poem":1},{"text":"lokukhanya kobuso bakho, ngoba wawubathanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"UyiNkosi yami loNkulunkulu wami,","poem":1},{"text":"ophayo ukunqoba kuJakhobe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngawe siyazihlehlisa izitha zethu;","poem":1},{"text":"ngebizo lakho siyazigxobagxoba izitha zethu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Angilithembi idandili lami,","poem":1},{"text":"inkemba yami kayingiletheli ukunqoba;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kodwa wena usipha ukunqoba phezu kwezitha zethu,","poem":1},{"text":"abalwa lathi ubathela ihlazo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Siyazincoma ngoNkulunkulu ilanga lonke,","poem":1},{"text":"njalo sizalidumisa ibizo lakho nini lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kodwa manje ususilahlile wasiyangisa;","poem":1},{"text":"kawusaphelekezeli izimpi zethu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wasenza sahlehla phambi kwesitha,","poem":1},{"text":"abalwa lathi sebethethe impango.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wasiyekela sadliwa njengezimvu","poem":1},{"text":"wasichithachitha phakathi kwezizwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wathengisa abantu bakho ngengcosana nje","poem":1},{"text":"awazuza lutho ngalokho kuthengisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ususenze saba lihlazo kubomakhelwane,","poem":1},{"text":"inhlekisa lendumazo kwesihlalisene labo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ususenze saba yisiga phakathi kwezizwe;","poem":1},{"text":"abantu banyikinya amakhanda ngathi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ukuyangeka kwami kuyangilandela ilanga lonke,","poem":1},{"text":"ubuso bami buhuqwe ngehlazo,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ngokuhozwa yilabo abangisolayo","poem":1},{"text":"njalo abangenyanyayo,","poem":2},{"lineBreak":true},{"text":"ngenxa yesitha esijonge ukuphindisela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Konke lokhu kwenzakala kithi,","poem":1},{"text":"lanxa sasingakulibalanga;","poem":2},{"lineBreak":true},{"text":"asathembeka esivumelwaneni sakho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Inhliziyo zethu zazingabuyelanga emuva;","poem":1},{"text":"inyawo zethu zazingaphambukanga endleleni yakho.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kodwa wasichoboza saba yikudla kwamaganyane,","poem":1},{"text":"wasembesa ngomnyama omkhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Aluba sasesilikhohliwe ibizo likaNkulunkulu wethu","poem":1},{"text":"loba saphakamisela izandla zethu kunkulunkulu wezizweni,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kambe ngabe uNkulunkulu kakubonanga lokho na,","poem":1},{"text":"njengoba esazi imfihlo zenhliziyo?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ikanti ngenxa yakho wena sikhangelane lokufa ilanga lonke;","poem":1},{"text":"sithathwa njengezimvu ezizahlatshwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Vuka, Oh Thixo! Ulaleleni na?","poem":1},{"text":"Ziphaphamise! Ungasilahli kokuphela.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ubufihlelani ubuso bakho na,","poem":1},{"text":"ukhohlwe ukuhlupheka kwethu lokuncindezelwa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Sesibhuqwe phansi othulini;","poem":1},{"text":"imizimba yethu isinamathele phansi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Phakama usisize;","poem":1},{"text":"sihlenge ngenxa yothando lwakho olungaphuthiyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}