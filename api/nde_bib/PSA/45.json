{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":45,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Njengengoma ethi “Izimbali.” Ihubo lamaDodana kaKhora. Ingoma yomtshado."]},{"type":"verse","number":1,"content":[{"text":"Inhliziyo yami iyagubhazela ngendaba enkulu","poem":1},{"text":"nxa ngivuma inkondlo yami ngiyihayela inkosi;","poem":2},{"lineBreak":true},{"text":"ulimi lwami lusiba lomlobi ololwazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Uyilikhwa lamakhwa emadodeni wonke","poem":1},{"text":"lezindebe zakho ziconjwe kuhle ngobunono,","poem":2},{"text":"njengalokhu uNkulunkulu","poem":1},{"text":"ekubusisile lanininini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hloma inkemba yakho okhalweni, wena omkhulu;","poem":1},{"text":"zembathise ngokukhazimula langobukhosi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Usebukhosini bakho khwela enqoleni ulokunqoba","poem":1},{"text":"umele iqiniso lokuzithoba lokulunga;","poem":2},{"lineBreak":true},{"text":"akuthi isandla sakho sokunene senze izimanga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akuthi imitshoko yakho ecijileyo icibe inhliziyo zezitha zenkosi;","poem":1},{"text":"akuthi izizwe ziwe ngaphansi kwezinyawo zakho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isihlalo sakho sobukhosi,","poem":1},{"text":"Oh Nkulunkulu, sizakuma nini lanini;","poem":2},{"text":"intonga yokwahlulela okulungileyo","poem":1},{"text":"izakuba yintonga yombuso wakho.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uyakuthanda ukulunga njalo uyabuzonda ububi;","poem":1},{"text":"ngakho uNkulunkulu, uNkulunkulu wakho","poem":2},{"text":"usekubeke ngaphezu kwabakhula bakho","poem":1},{"text":"ngokukugcoba ngamafutha entokozo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zonke izembatho zakho ziqholiwe ngemure,","poem":1},{"text":"langenhlaba langekhasiya;","poem":2},{"text":"ezigodlweni eziceciswe ngempondo zendlovu kuqhamuka","poem":1},{"text":"inhlokomo yeziginci ekuthokozisayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amadodakazi amakhosi akhona","poem":1},{"text":"kanye labanye abesifazane abahloniphekayo;","poem":2},{"text":"kwesokunene sakho ngumlobokazi wesikhosini","poem":1},{"text":"oceciswe ngegolide lase-Ofiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lalela, ndodakazi, nanzelela uvule indlebe;","poem":1},{"text":"khohlwa abakini, lendlu yakwenu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inkosi iyaphelelwa ngobuhle bakho;","poem":1},{"text":"yihloniphe, ngoba iyinkosi yakho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Indodakazi yaseThire izakuza lesipho,","poem":1},{"text":"amadoda anothileyo azazincengela kuwe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngaphakathi exhibeni layo","poem":1},{"text":"inkosazana yibucwazicwazi;","poem":2},{"lineBreak":true},{"text":"isembatho sayo sicecisiwe ngegolide.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isiwa enkosini yembethe izivunulo ezelukiweyo;","poem":1},{"text":"abakhaphi bayo bayayilandela","poem":2},{"lineBreak":true},{"text":"balethwe kuwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bangeniswa lapho ngentokozo lenjabulo;","poem":1},{"text":"bangena esigodlweni senkosi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Amadodana enu azathatha isikhundla saboyihlo;","poem":1},{"text":"lizawenza abe ngamakhosana elizweni lonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ibizo lakho ngizalenza","poem":1},{"text":"likhunjulwe kokuphela yizizukulwane zonke;","poem":2},{"lineBreak":true},{"text":"yikho-ke izizwe zizakudumisa nini lanini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}