{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. ElamaDodana kaKhora. Ingoma ngendlela ye-alamothi."]},{"type":"verse","number":1,"content":[{"text":"UNkulunkulu uyisiphephelo sethu lamandla ethu,","poem":1},{"text":"usizo oluhlezi lukhona nxa kulohlupho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngakho kangiyikwesaba, umhlaba ungaze ubhidlike","poem":1},{"text":"lezintaba ziwele ekujuleni kolwandle,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"loba amanzi alo ehlokoma agubhazele","poem":1},{"text":"izintaba zivevezele ngokuqubuka kwalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kukhona umfula ozifudlana zawo zithokozisa idolobho likaNkulunkulu,","poem":1},{"text":"indawo engcwele okuhlala kuyo oPhezukonke.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"UNkulunkulu ungaphakathi kwalo, kaliyikuwiswa;","poem":1},{"text":"uNkulunkulu uzalisiza ngovivi lokusa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Izizwe ziyahlokoma, imibuso iyachitheka;","poem":1},{"text":"uphakamisa ilizwi lakhe umhlaba uncibilike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"UThixo uSomandla ulathi;","poem":1},{"text":"uNkulunkulu kaJakhobe uyinqaba yethu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wozani libone imisebenzi kaThixo,","poem":1},{"text":"incithakalo aseyenzile emhlabeni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uyathulisa izimpi","poem":1},{"text":"kuze kube semikhawulweni yomhlaba;","poem":2},{"text":"uyalephula idandili avadlaze lomkhonto,","poem":1},{"text":"utshisa izinqola ngomlilo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Thulani, lazi ukuba mina nginguNkulunkulu;","poem":1},{"text":"ngizaphakanyiswa phakathi kwezizwe;","poem":2},{"lineBreak":true},{"text":"ngizaphakanyiswa emhlabeni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"UThixo uSomandla ulathi,","poem":1},{"text":"uNkulunkulu kaJakhobe uyinqaba yethu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}