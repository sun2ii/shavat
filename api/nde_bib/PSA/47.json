{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. ElamaDodana kaKhora. Ihubo."]},{"type":"verse","number":1,"content":[{"text":"Qakezani izandla zenu, zizwe zonke;","poem":1},{"text":"hlokomani kuNkulunkulu ngomsindo wokuthokoza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wesabeka kangakanani uThixo oPhezukonke,","poem":1},{"text":"iNkosi enkulu kuwo wonke umhlaba!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wazehlula zonke izizwe zaba ngaphansi kwethu,","poem":1},{"text":"abantu babangaphansi kwezinyawo zethu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wasikhethela ilifa lethu,","poem":1},{"text":"igugu likaJakhobe amthandayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"UNkulunkulu usekhuphukile phakathi komsindo wentokozo,","poem":1},{"text":"uThixo uphakathi kokukhala kwamacilongo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hlabelelani indumiso kuNkulunkulu, hlabelelani indumiso;","poem":1},{"text":"hlabelelani indumiso eNkosini yethu, hlabelelani indumiso.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngoba uNkulunkulu uyiNkosi yomhlaba wonke;","poem":1},{"text":"hlabelelani kuye ihubo lokudumisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"UNkulunkulu uyazibusa izizwe;","poem":1},{"text":"uNkulunkulu uhlezi esihlalweni sakhe sobukhosi esingcwele.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Izikhulu zezizwe ziyaqoqana","poem":1},{"text":"njengabantu bakaNkulunkulu ka-Abhrahama,","poem":2},{"text":"ngoba amakhosi omhlaba angakaNkulunkulu;","poem":1},{"text":"uphakeme kakhulukazi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}