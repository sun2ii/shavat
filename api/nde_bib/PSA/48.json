{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["Ingoma. Ihubo lamaDodana kaKhora."]},{"type":"verse","number":1,"content":[{"text":"Umkhulu uThixo, ufanele ngokuphindiweyo ukudunyiswa,","poem":1},{"text":"emzini kaNkulunkulu wethu, intaba yakhe engcwele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Muhle kakhulu ngokuphakama kwakhe,","poem":1},{"text":"uyintokozo yomhlaba wonke.","poem":2},{"text":"Njengeziqongo zeZafoni injalo intaba iZiyoni,","poem":1},{"text":"umuzi weNkosi eNkulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"UNkulunkulu usemithangaleni yawo;","poem":1},{"text":"ubonisa ukuthi nguye oyinqaba yawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kwathi lapho amakhosi ehlanganisa izimpi zawo,","poem":1},{"text":"lapho ehlasela kanyekanye,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"awubona umuzi lo ethuka","poem":1},{"text":"aphaphatheka esetshaywa luvalo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ahle athuthumela khonapho,","poem":1},{"text":"ezwa ubuhlungu obuzwiwa ngowesifazane ehelelwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wena wabatshabalalisa njengemikhumbi yaseThashishi","poem":1},{"text":"ibhidlizwa ngumoya wempumalanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lokho esikuzwileyo","poem":1},{"text":"yikho esikubonileyo","poem":2},{"text":"emzini kaThixo uSomandla,","poem":1},{"text":"emzini kaNkulunkulu wethu:","poem":2},{"lineBreak":true},{"text":"uNkulunkulu uzawuvikela lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Phakathi kwethempeli lakho, Oh Nkulunkulu,","poem":1},{"text":"siyacabanga ngothando lwakho olungaphuthiyo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Njengebizo lakho, Oh Nkulunkulu,","poem":1},{"text":"udumo lwakho lufika emikhawulweni yomhlaba;","poem":2},{"lineBreak":true},{"text":"isandla sakho sokunene sigcwele ukulunga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Intaba iZiyoni iyathokoza,","poem":1},{"text":"imizi yakoJuda iyathaba","poem":2},{"lineBreak":true},{"text":"ngezahlulelo zakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hambahamba eZiyoni, ibhode,","poem":1},{"text":"bala izilindo zayo eziphezulu,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"nanzelela kuhle imithangala yayo,","poem":1},{"text":"hlola izinqaba zayo,","poem":2},{"text":"ukuze ukwazi ukulandisela","poem":1},{"text":"isizukulwane esizayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ngoba uNkulunkulu lo nguNkulunkulu wethu nini lanini;","poem":1},{"text":"uzakuba ngumholi wethu lasekupheleni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}