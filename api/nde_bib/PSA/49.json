{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. ElamaDodana kaKhora. Ihubo."]},{"type":"verse","number":1,"content":[{"text":"Zwanini lokhu lina bantu lonke;","poem":1},{"text":"lalelani, lonke elihlala kulo umhlaba,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"abantukazana lezikhulu,","poem":1},{"text":"abanothileyo labayanga ngokufanayo:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Umlomo wami uzakhuluma amazwi okuhlakanipha;","poem":1},{"text":"amazwi aphuma enhliziyweni yami azanika ukuzwisisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngizabeka indlebe yami kuso isaga;","poem":1},{"text":"ngechacho ngizaliqhaqha ilibho:","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngingesabelani na nxa kufika insuku ezimbi,","poem":1},{"text":"lapho abakhohlisi ababi bengihanqa,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"labo abathembe inotho yabo","poem":1},{"text":"abazitshaya isifuba ngenotho yabo enengi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kakho umuntu ongahlenga impilo yomunye","poem":1},{"text":"kumbe amkhuphele inhlawulo kuNkulunkulu,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ngoba ukuhlenga impilo yomuntu kuyadula,","poem":1},{"text":"akulambhadalo engakwenelisa,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ukuze aphile kokuphela","poem":1},{"text":"angaboni ukubola.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Phela bonke bayabona ukuthi izihlakaniphi ziyafa;","poem":1},{"text":"ngokunjalo iziwula labasangeneyo bayabhubha","poem":2},{"lineBreak":true},{"text":"batshiye inotho yabo kwabanye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amangcwaba abo ayizindlu zabo zanininini,","poem":1},{"text":"yimizi yabo okwezizukulwane ezingapheliyo,","poem":2},{"lineBreak":true},{"text":"lokuba nje basebeqambe iziqinti ngamabizo abo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kodwa umuntu, lokuba elenotho, kaphili kokuphela;","poem":1},{"text":"unjengezinyamazana ezibhubhayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lesi yisiphetho salabo abazithembayo bona,","poem":1},{"text":"labalandeli babo, abavumelana labakutshoyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njengezimvu bamiselwe ingcwaba,","poem":1},{"text":"ukufa kuzazitika kubo.","poem":2},{"text":"Abaqotho bazabusa phezu kwabo ekuseni;","poem":1},{"text":"izidumbu zabo zizabola engcwabeni,","poem":2},{"lineBreak":true},{"text":"kude lemizi yabo efana leyamakhosi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kodwa uNkulunkulu uzayihlenga eyami impilo engcwabeni;","poem":1},{"text":"ngempela uzangithatha angise kuye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ungasuki udangale kakhulu ngokubona omunye enotha;","poem":1},{"text":"nxa indlu yakhe igcwala ngobunkentshenkentshe;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"phela kazukuhamba lalutho mhla esifa,","poem":1},{"text":"ubukhazikhazi lobo kayikwehla labo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Loba wayesithi esaphila azibone engobusisiweyo","poem":1},{"text":"abantu bayakukhonza nxa uphumelela,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"uzakuyahlangana lesizukulwane sabokhokho bakhe,","poem":1},{"text":"abangasayikuphinde bakubone ukukhanya kwempilo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Umuntu olenotho kodwa engaqedisisi","poem":1},{"text":"unjengezinyamazana ezibhubhayo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}