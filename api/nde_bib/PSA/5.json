{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Kwabemifece. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Zwana amazwi ami, Oh Thixo,","poem":1},{"text":"hawukela ukububula kwami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lalela ukukhala kwami ngidinga uncedo,","poem":1},{"text":"Nkosi yami loNkulunkulu wami,","poem":2},{"lineBreak":true},{"text":"ngoba ngikhuleka kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ekuseni, Oh Thixo, uyalizwa ilizwi lami;","poem":1},{"text":"ekuseni ngibeka izicelo zami phambi kwakho","poem":2},{"lineBreak":true},{"text":"ngilinde ngithembile.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kawusuye uNkulunkulu othokoza ngobubi;","poem":1},{"text":"ababi ngeke bahlale lawe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iziqholo ngeke zime","poem":1},{"text":"phambi kwakho;","poem":2},{"text":"uyabazonda bonke abenza okubi.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Uyababhubhisa labo abaqamba amanga;","poem":2},{"text":"abomele igazi labakhohlisayo","poem":1},{"text":"uThixo uyabenyanya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodwa mina, ngomusa wakho omkhulu,","poem":1},{"text":"ngizangena endlini yakho;","poem":2},{"text":"ngizakhothamela phansi ngokuhlonipha","poem":1},{"text":"ngikhangele ethempelini lakho elingcwele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngikhokhele, Oh Thixo, ngokulunga kwakho;","poem":1},{"text":"ngenxa yezitha zami","poem":2},{"lineBreak":true},{"text":"yenza iqonde indlela yakho phambi kwami.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kalikho lalinye ilizwi lomlomo wabo elithembekileyo;","poem":1},{"text":"inhliziyo yabo igcwele ukubhidliza.","poem":2},{"text":"Umphimbo wabo ulingcwaba elikhamisileyo;","poem":1},{"text":"ngolimi lwabo bakhuluma inkohliso.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tshono uthi balecala, Oh Nkulunkulu!","poem":1},{"text":"Akuthi amacebo abo abe yikuwa kwabo.","poem":2},{"text":"Baxotshele khatshana ngenxa yezono zabo ezinengi,","poem":1},{"text":"ngoba bakuhlamukele wena.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodwa akuthi bonke abaphephela kuwe bathokoze;","poem":1},{"text":"kabahlabelele njalonjalo ngenjabulo.","poem":2},{"text":"Basibekele ngovikelo lwakho,","poem":1},{"text":"kuthi labo abalithandayo ibizo lakho bajabule ngawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ngoba ngempela, Oh Thixo,","poem":1},{"text":"uyababusisa abalungileyo;","poem":2},{"lineBreak":true},{"text":"uyabazungeza ngomusa wakho njengesihlangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}