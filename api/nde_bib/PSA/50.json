{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"hebrew_subtitle","content":["Ihubo lika-Asafi."]},{"type":"verse","number":1,"content":[{"text":"USomandla, uNkulunkulu, uThixo,","poem":1},{"text":"uyakhuluma, ubiza umhlaba","poem":2},{"lineBreak":true},{"text":"kusukela okuphuma khona ilanga kuze kufike lapho elitshona khona.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"EseZiyoni, epheleleyo ngobuhle,","poem":1},{"text":"uNkulunkulu uyakhazimula.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"UNkulunkulu wethu uyeza,","poem":1},{"text":"kayikuthula;","poem":2},{"text":"umlilo uyahangula phambi kwakhe,","poem":1},{"text":"emaceleni akhe kukhukhula isiphepho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ubiza amazulu ngaphezulu lomhlaba,","poem":1},{"text":"ukuze ehlulele abantu bakhe:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Qoqani kimi abahlanjululiweyo bami,","poem":1},{"text":"abenza isivumelwano lami ngemihlatshelo.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lamazulu atshumayela ukulunga kwakhe;","poem":1},{"text":"ngoba uNkulunkulu ngumahluleli ngokwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Zwanini, bantu bami, ngizakhuluma;","poem":1},{"text":"yebo Israyeli, ngizafakaza ngimelane lawe;","poem":2},{"lineBreak":true},{"text":"nginguNkulunkulu, Nkulunkulu wakho","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kangikukhuzi ngemihlatshelo yakho","poem":1},{"text":"kumbe iminikelo yakho yokutshiswa,","poem":2},{"lineBreak":true},{"text":"ehlezi ikhona phambi kwami.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Angisweli inkunzi ephuma esibayeni sakho","poem":1},{"text":"kumbe imbuzi zesilugu sakho,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ngoba yiphi layiphi inyamazana yeganga ngeyami,","poem":1},{"text":"lenkomo ezisemaqaqeni azinkulungwane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngazi zonke izinyoni ezisezintabeni,","poem":1},{"text":"lezidalwa zeganga ngezami.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aluba ngangingolambayo ngangingekulitshela,","poem":1},{"text":"ngoba umhlaba ngowami, lakho konke okukuwo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngidla inyama yezinkunzi yini","poem":1},{"text":"kumbe nginatha igazi lembuzi na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yenzani imihlatshelo yokubonga kuNkulunkulu,","poem":1},{"text":"gcwalisani izifungo zenu koPhezukonke,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"njalo lize kimi mhla lisekuhluphekeni;","poem":1},{"text":"ngizalikhulula, lani lizangidumisa.”","poem":2}]},{"type":"verse","number":16,"content":["Kodwa kwababi, uNkulunkulu uthi:",{"text":"“Lilelungelo bani ukukhuluma imithetho yami","poem":1},{"text":"kumbe liphathe isivumelwano sami ezindebeni zenu na?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Liyazizonda iziqondiso zami,","poem":1},{"text":"lilahlela amazwi ami emuva kwenu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lithi lingabona isela lihle libambane lalo;","poem":1},{"text":"lisuka lingenelane lezifebe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lisebenzisa imilomo yenu ukukhuluma okubi","poem":1},{"text":"lifundise ulimi lwenu inkohliso.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Linyeya umfowenu njalonjalo,","poem":1},{"text":"limgcone umntakanyoko uqobo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Lizenzile lezizinto ngazithulela;","poem":1},{"text":"lalikhumbula ukuthi ngifana lani.","poem":2},{"text":"Kodwa ngizalikhuza","poem":1},{"text":"ngilibonisa icala lenu obala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nanzelelani lokhu, lina elikhohlwa uNkulunkulu,","poem":1},{"text":"funa ngilidabudabule, kungekho ongalilamulela:","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Lowo onikela iminikelo yokubonga uyangidumisa,","poem":1},{"text":"njalo ulungisa indlela ukuze ngimtshengise insindiso yami.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}