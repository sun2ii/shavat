{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo likaDavida. Lapho umphrofethi uNathani efike kuye emveni kokuba uDavida efebe loBhathishebha."]},{"type":"verse","number":1,"content":[{"text":"Ake ungihawukele, awu Nkulunkulu,","poem":1},{"text":"ngenxa yothando lwakho olungaphuthiyo;","poem":2},{"text":"ngenxa yesihawu sakho esikhulu","poem":1},{"text":"yesula iziphambeko zami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hlanza wonke amanyala ami","poem":1},{"text":"ungihlambulule esonweni sami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Phela ngiyazazi iziphambeko zami,","poem":1},{"text":"isono sami sihlezi siphambi kwami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngenzile isono kuwe, wena wedwa,","poem":1},{"text":"ngenza okubi phambi kwakho,","poem":2},{"text":"ukuze kukhanye ukuthi wena uqondile nxa ukhuluma","poem":1},{"text":"njalo kube kufanele nxa usahlulela.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngeqiniso ngavele ngazalwa ngilesono,","poem":1},{"text":"ngaba yisoni ngiqalisa esiswini sikamama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngempela wena ufuna iqiniso elisuka emibilini;","poem":1},{"text":"uyangifundisa ukuhlakanipha ngaphakathi kwami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngihlanza ngehisophi ngihlambuluke;","poem":1},{"text":"ngigezisa ngibemhlophe kuleliqhwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mangizwe intokozo lokuthaba;","poem":1},{"text":"makuthi amathambo owacobozileyo ajabule.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Fihla ubuso bakho esonweni sami","poem":1},{"text":"ucitshe nya wonke amanyala ami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dala phakathi kwami inhliziyo ehlanzekileyo, Oh Nkulunkulu","poem":1},{"text":"uvuselele ngaphakathi kwami umoya othembekileyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ungangilahli ebusweni bakho","poem":1},{"text":"kumbe ususe kimi uMoya oNgcwele.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Buyisela kimi intokozo yokusindisa kwakho","poem":1},{"text":"njalo ungiphe umoya ovumayo ukuthi ungisekele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lapho-ke ngizafundisa abonayo izindlela zakho,","poem":1},{"text":"lezoni zizabuyela kuwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngikhulula ecaleni lokuchitha igazi, Oh Nkulunkulu,","poem":1},{"text":"uNkulunkulu ongisindisayo,","poem":2},{"lineBreak":true},{"text":"njalo ulimi lwami luzahlabelela ukulunga kwakho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Oh Thixo, vula izindebe zami,","poem":1},{"text":"umlomo wami uzamemezela indumiso yakho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kawuthokoziswa yimihlatshelo, ngoba bengizawuletha;","poem":1},{"text":"kawuthakazeleli iminikelo yokutshiswa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Imihlatshelo kaNkulunkulu iyinhliziyo edabukileyo;","poem":1},{"text":"inhliziyo edabukileyo, ezisolayo,","poem":2},{"lineBreak":true},{"text":"awu Nkulunkulu, kawuyikuyilahla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nxa kuyintando yakho phumelelisa iZiyoni;","poem":1},{"text":"yakha imiduli yeJerusalema.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lapho-ke kuzakuba lemihlatshelo elungileyo,","poem":1},{"text":"iminikelo yokutshiswa egcweleyo elungileyo,","poem":2},{"lineBreak":true},{"text":"lapho-ke inkunzi zizanikelwa e-alithareni lakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}