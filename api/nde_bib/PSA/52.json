{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo likaDavida. Lapho uDoyegi umʼEdomi wayeye kuSawuli wamtshela wathi, “UDavida uye wayangena endlini ka-Ahimeleki.”"]},{"type":"verse","number":1,"content":[{"text":"Kungani uncoma ngobubi, wena somandlase?","poem":1},{"text":"Kungani utshona untela ilanga lonke,","poem":2},{"lineBreak":true},{"text":"wena olihlazo emehlweni kaNkulunkulu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ulimi lwakho luceba incithakalo;","poem":1},{"text":"lunjengensingo eloliweyo,","poem":2},{"lineBreak":true},{"text":"wena owenza inkohliso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uthanda ububi kulobuhle,","poem":1},{"text":"amanga kulokukhuluma iqiniso.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uyawathanda wonke amanga alimazayo,","poem":1},{"text":"wena limi olukhohlisayo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngeqiniso uNkulunkulu uzakwehlisela ukubhubha okungapheliyo:","poem":1},{"text":"Uzakuhlwitha akukhuphe ethenteni lakho;","poem":2},{"lineBreak":true},{"text":"uzakuquphula akususe elizweni labaphilayo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abalungileyo bazabona besabe;","poem":1},{"text":"bazamhleka bathi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Nangu-ke manje umuntu","poem":1},{"text":"lo ongenzanga uNkulunkulu inqaba yakhe","poem":2},{"text":"kodwa wathemba inotho yakhe enkulu","poem":1},{"text":"wakhula waba lamandla ngokuwisa abanye!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kodwa mina nginjengesihlahla se-oliva","poem":1},{"text":"esikhula endlini kaNkulunkulu;","poem":2},{"text":"ngithembe uthando lukaNkulunkulu","poem":1},{"text":"olungaphuthiyo nini lanini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngizakudumisa lanini ngalokho okwenzileyo;","poem":1},{"text":"ngizathemba ebizweni lakho,","poem":2},{"text":"ngoba lihle ibizo lakho.","poem":1},{"text":"Ngizakudumisa phambi kwabangcwele bakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}