{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Kutshaywa iziginci. Ihubo likaDavida. Lapho amaZifi aya kuSawuli afika athi, “Kanti uDavida kacatshanga yini phakathi kwethu?”"]},{"type":"verse","number":1,"content":[{"text":"Ngisindisa, awu Nkulunkulu, ngebizo lakho;","poem":1},{"text":"ngigeza ecaleni ngamandla akho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zwana umkhuleko wami, Oh Nkulunkulu;","poem":1},{"text":"lalela amazwi omlomo wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngihlaselwa ngabantu engingabaziyo;","poem":1},{"text":"izikliwi zifuna impilo yami","poem":2},{"lineBreak":true},{"text":"abantu abangamnanzanga uNkulunkulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngeqiniso uNkulunkulu ulusizo lwami;","poem":1},{"text":"uThixo nguye ongisizayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Akuthi ububi bubuyele phezu kwalabo abangigconayo;","poem":1},{"text":"ngokuthembeka kwakho babhubhise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngizakwenzela umhlatshelo owomnikelo wokuzithandela;","poem":1},{"text":"ngizalidumisa ibizo lakho, Thixo, ngoba lihle.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngoba ingikhulule kuzozonke inhlupheko zami,","poem":1},{"text":"lamehlo ami akubonile ukunqotshwa kwezitha zami.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}