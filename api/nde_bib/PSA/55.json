{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Kutshaywa iziginci. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Lalela umkhuleko wami, Oh Nkulunkulu,","poem":1},{"text":"ungafulatheli isikhalazo sami;","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ngizwa ungiphendule.","poem":2},{"text":"Imicabango yami iyangikhathaza, ngididekile","poem":1}]},{"type":"verse","number":3,"content":[{"text":"ngelizwi lesitha sami,","poem":2},{"lineBreak":true},{"text":"lokunyonkolozwa ngababi;","poem":2},{"text":"ngoba bangibangela","poem":1},{"text":"inhlupho bangithuka bethukuthele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inhliziyo yami iyatshiseka ngaphakathi kwami;","poem":1},{"text":"ukwesaba ukufa kuyangiqinela.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ukwesaba lokuthuthumela sekungihlasele;","poem":1},{"text":"isithuli sesingigabhela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngathi, “He, aluba ngangilamaphiko njengejuba!","poem":1},{"text":"Ngangizaphapha ngizoziphumulela kude.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngangizabaleka ngiye kude","poem":1},{"text":"ngiyehlala enkangala;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ngangizaphanga ngiye enqabeni yami,","poem":1},{"text":"kude kwesikhukhula lesiphepho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sanganisa ababi, Oh Thixo,","poem":1},{"text":"sanganisa ukukhuluma kwabo,","poem":2},{"lineBreak":true},{"text":"ngoba ngibona udlakela lengxabano edolobheni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Emini lebusuku bayacathama emidulini yalo;","poem":1},{"text":"umona lenzondo kugcwele lapho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Imimoya yokubhidliza yiyo esibusa;","poem":1},{"text":"izisongo lamanga akusasuki emigwaqweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Aluba ngithukwa yisitha","poem":1},{"text":"ngingakubhensela lokho;","poem":2},{"text":"aluba ongizondayo engivukela","poem":1},{"text":"ngingamcatshela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kodwa nguwe, umuntu njengami,","poem":1},{"text":"umkhula wami, umngane wami oseduze,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"engake ngaba lobudlelwano obukhulu laye","poem":1},{"lineBreak":true},{"text":"lapho sasihamba ndawonye","poem":1},{"text":"labanengi endlini kaNkulunkulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yekela ukufa kuzijume izitha zami;","poem":1},{"text":"yekela bagqitshelwe bephila engcwabeni,","poem":2},{"lineBreak":true},{"text":"ngoba ububi buthe khoxo phakathi kwabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kodwa ngiyambiza uNkulunkulu,","poem":1},{"text":"uThixo angisindise.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kusihlwa, ekuseni lemini","poem":1},{"text":"ngiyakhala ngisosizini,","poem":2},{"lineBreak":true},{"text":"yena uyalizwa ilizwi lami.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uyangihlenga ngingakalimali","poem":1},{"text":"kuleyompi engihlaselayo,","poem":2},{"lineBreak":true},{"text":"loba bebanengi abaxabana lami.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"UNkulunkulu osesihlalweni sobukhosi lanininini,","poem":1},{"text":"uzabezwa abachithachithe","poem":2},{"text":"abantu abangaguqukiyo ezindleleni zabo","poem":1},{"text":"njalo abangamesabiyo uNkulunkulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Umkhula wami uyabahlasela abangane bakhe;","poem":1},{"text":"wephula isivumelwano asenzayo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inkulumo yakhe ibutshelezi njengolaza,","poem":1},{"text":"kodwa kulempi enhliziyweni yakhe","poem":2},{"text":"amazwi akhe alolozela ukwedlula amafutha","poem":1},{"text":"kodwa abukhali kulensingo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yethula inswelo zakho kuThixo","poem":1},{"text":"yena uzakusekela;","poem":2},{"lineBreak":true},{"text":"akazukuyekela abalungileyo bawe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kodwa wena, Nkulunkulu","poem":1},{"text":"ababi uzabawisela egodini lokungcola;","poem":2},{"text":"abantu abomele igazi njalo abakhohlisayo","poem":1},{"text":"kabasoze bayiphile ingxenye yezinsuku zabo.","poem":2},{"lineBreak":true},{"text":"Kodwa mina, ngithemba kuwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}