{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Kulandelwa itshuni ethi, “Ijuba phezu kwemikusu ekude.” ElikaDavida. Imikithamu. Lapho wayesethunjwe ngamafilistiya eGathi."]},{"type":"verse","number":1,"content":[{"text":"Woba lomusa kimi, Oh Nkulunkulu,","poem":1},{"text":"ngoba abantu baxotshana lami kubi;","poem":2},{"lineBreak":true},{"text":"ilanga lonke bayajujumezela bengihlasela.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Labo abangigconayo baxotshana lami ilanga lonke;","poem":1},{"text":"abanengi bangihlasela bekloloda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nxa ngisesaba ngizathemba kuwe.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"KuNkulunkulu, engidumisa ibizo lakhe,","poem":2},{"text":"ngithemba kuye uNkulunkulu; angiyikwesaba.","poem":1},{"text":"Umuntu wenyama angenzani kimi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ilanga lonke batshona behlanekela amazwi ami;","poem":1},{"text":"beqoqa ukungibhidliza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bayabuthana bengicathamela","poem":1},{"text":"balandele izinyathelo zami","poem":2},{"lineBreak":true},{"text":"betshisekela ukucitsha impilo yami.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Loba sekutheni ungabayekeli baphunyuke;","poem":1},{"text":"ngokuthukuthela kwakho, Nkulunkulu, zidilize izizwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bhala phansi isililo sami;","poem":1},{"text":"bhala ithonsi ngalinye lezinyembezi zami emqulwini wakho","poem":2},{"lineBreak":true},{"text":"kazikho yini emibhalweni yakho?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lapho-ke izitha zami zizafulathela","poem":1},{"text":"nxa sengicela uncedo.","poem":2},{"lineBreak":true},{"text":"Ngalokhu ngizakwazi ukuthi uNkulunkulu ulami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"KuNkulunkulu, engidumisa ibizo lakhe,","poem":1},{"text":"kuThixo engidumisa ibizo lakhe,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kuNkulunkulu ngiyathemba; angiyikwesaba.","poem":1},{"text":"Umuntu angenzani kimi na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ngibanjwe yizifungo kuwe, Oh Nkulunkulu;","poem":1},{"text":"ngizakwethula umnikelo wami wokubonga kuwe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngoba ungikhulule ekufeni","poem":1},{"text":"lezinyawo zami lapho ngikhubeka,","poem":2},{"text":"ukuze ngihambe phambi kukaNkulunkulu","poem":1},{"text":"ekukhanyeni kwempilo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}