{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Itshuni ethi, “Ungabhidlizi.” ElikaDavida. Imikithamu. Ngesikhathi ebalekele uSawuli wacatsha ebhalwini."]},{"type":"verse","number":1,"content":[{"text":"Woba lesihawu kimi, Oh Nkulunkulu, woba lomusa kimi,","poem":1},{"text":"ngoba umphefumulo wami uphelela kuwe.","poem":2},{"text":"Ngizaphephela ethunzini lamaphiko akho","poem":1},{"text":"kuze kudlule incithakalo le.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngiyakhala kuNkulunkulu oPhezukonke,","poem":1},{"text":"kuNkulunkulu ogcwalisa isimiso sakhe ngami.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uyathumela esezulwini angisindise,","poem":1},{"text":"abakhwazele labo abafuna ukungilimaza.","poem":2},{"lineBreak":true},{"text":"UNkulunkulu uyehlisa uthando lwakhe lokwethembeka kwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngiphakathi kwezilwane;","poem":1},{"text":"ngilala phakathi kwezilo eziqholozayo","poem":2},{"text":"abantu abamazinyo abo yimikhonto lemitshoko,","poem":1},{"text":"abanlimi zabo zinkemba ezibukhali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mawuphakanyiswe, Oh Nkulunkulu, ngaphezu kwamazulu;","poem":1},{"text":"akuthi inkazimulo yakho ibesemhlabeni wonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bangithiya ngamambule ezinyaweni","poem":1},{"text":"ngaphela amandla ngokudabuka.","poem":2},{"text":"Bangimbela igodi endleleni","poem":1},{"text":"kodwa sebewele kulo bona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Inhliziyo yami ibambelele, kayiguquki Oh Nkulunkulu,","poem":1},{"text":"inhliziyo yami ibambelele;","poem":2},{"lineBreak":true},{"text":"ngizahlabela ngenze iculo elimnandi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vuka, mphefumulo wami!","poem":1},{"text":"Vukani, chacho lomqangala!","poem":2},{"lineBreak":true},{"text":"Ngizayivusa intathakusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngizakudumisa, Oh Thixo, phakathi kwezizwe;","poem":1},{"text":"ngizahlabela ngawe phakathi kwabantu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngoba lukhulu uthando lwakho, lufika emazulwini;","poem":1},{"text":"ukuthembeka kwakho kufinyelela esibhakabhakeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mawuphakanyiswe, Oh Nkulunkulu, ngaphezulu kwamazulu;","poem":1},{"text":"akuthi inkazimulo yakho ibesemhlabeni wonke.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}