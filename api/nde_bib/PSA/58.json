{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Itshuni ethi, “Ungabhidlizi.” ElikaDavida. Imikithamu."]},{"type":"verse","number":1,"content":[{"text":"Lina babusi, kambe likhuluma okuqondileyo na?","poem":1},{"text":"Lahlulela ngobuqotho yini ebantwini?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hatshi, ezinhliziyweni zenu lakha amacebo okubusa kubi,","poem":1},{"text":"lezandla zenu zijezisa ngochuku emhlabeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwasekuzalweni ababi bayaphumputheka;","poem":1},{"text":"kwasekuzalweni baxhwalile, beqamba amanga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Itshefu yabo ifana letshefu yenyoka,","poem":1},{"text":"ifana leyebululu elingezwa umsindo,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"elingananzi lomculo wombumbi,","poem":1},{"text":"loba lowombumbi eligabazi elinganani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Khumula amazinyo emilonyeni yazo, awu Nkulunkulu;","poem":1},{"text":"zikhumule, Oh Thixo, izingavula zezilwane!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yekela zinyamalale njengamanzi agelezayo;","poem":1},{"text":"zithi lapho zinweba idandili,","poem":2},{"lineBreak":true},{"text":"kayithundubale imitshoko yazo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Njengomnenke uncibilika uphele ulokhu uhamba,","poem":1},{"text":"njengomphunzo, kabangaliboni ilanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Imbiza zakho zingakaqalisi ukutshisa","poem":1},{"text":"ngomlilo wenkuni zameva","poem":2},{"text":"loba ngezimanzi kumbe ngezomileyo","poem":1},{"text":"ababi bazakhukhulelwa khatshana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abalungileyo bazajabula nxa sebephindiselelwa,","poem":1},{"text":"nxa sebegeza inyawo zabo egazini lababi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lapho-ke abantu bazakuthi,","poem":1},{"text":"“Ngempela abalungileyo bajinge bathole umvuzo;","poem":2},{"lineBreak":true},{"text":"ngempela ukhona uNkulunkulu owahlulela umhlaba.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}