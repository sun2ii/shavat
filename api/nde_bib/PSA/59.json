{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Itshuni ethi, “Ungabhidlizi.” ElikaDavida. Imikithamu. Ngesikhathi uSawuli ethume amadoda ukuqaphela indlu kaDavida ukuze bambulale."]},{"type":"verse","number":1,"content":[{"text":"Ngikhulula ezitheni zami, awu Nkulunkulu;","poem":1},{"text":"ngivikela kulabo abangivukelayo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngikhulula kubenzi bobubi","poem":1},{"text":"ungisindise ebantwini abomele igazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ake ubone ukuthi bangicathamela njani!","poem":1},{"text":"Amadoda esabekayo angakhela amacebo","poem":2},{"lineBreak":true},{"text":"kungelacala loba isono engisenzileyo, Oh Thixo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Angonanga lutho, kodwa balungele ukungihlasela.","poem":1},{"text":"Phakama ungisize; ake ubone umumo engikuwo!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Oh Thixo Nkulunkulu Somandla,","poem":1},{"text":"Nkulunkulu ka-Israyeli,","poem":2},{"text":"ake uzivuse wena ukuze uzijezise zonke izizwe;","poem":1},{"text":"ungabazweli isihawu bonke abahlamuki ababi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bathi bephenduka kusihlwa","poem":1},{"text":"babe behwabha njengezinja,","poem":2},{"lineBreak":true},{"text":"bahwede bebhoda ledolobho.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ake ubone ukuthi baphihlizani emilonyeni yabo:","poem":1},{"text":"baphihliza izinkemba ezindebeni zabo,","poem":2},{"lineBreak":true},{"text":"bese besithi, “Ngubani osizwayo?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kodwa wena, Oh Thixo, uyabahleka;","poem":1},{"text":"uyazigqabhazela zonke lezozizwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Oh Mandla ami, ngiyakulindela;","poem":1},{"text":"wena, Oh Nkulunkulu, uyinqaba yami,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nkulunkulu wami olothando.","poem":2},{"lineBreak":true},{"text":"UNkulunkulu uzahamba phambi kwami","poem":1},{"text":"angenze ngiklolode phezu kwalabo abangingcolisayo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodwa ungababulali, Nkosi hawu lethu,","poem":1},{"text":"funa abantu bakithi bakhohlwe.","poem":2},{"text":"Ngamandla akho","poem":1},{"text":"baphumputhekise njalo ubehlule wena Thixo, sihlangu sethu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngenxa yezono zemilomo yabo,","poem":1},{"text":"ngenxa yamazwi ezindebe zabo,","poem":2},{"lineBreak":true},{"text":"kababanjwe belokhu bezigqaja benjalo.","poem":2},{"text":"Ngenxa yezethuko lamanga abawaqambayo,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"babhuqe ngolaka, babhuqe bangabi khona futhi.","poem":2},{"text":"Lapho-ke kuzakwaziwa lasemikhawulweni yomhlaba","poem":1},{"text":"ukuthi uNkulunkulu uyabusa phezu kukaJakhobe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bathi bephenduka kusihlwa","poem":1},{"text":"babe behwabha njengezinja,","poem":2},{"lineBreak":true},{"text":"bahambahambe becathama edolobheni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bayazula bedinga ukudla","poem":1},{"text":"bahlabe umkhulungwane nxa bengasuthanga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kodwa mina ngizahlabelela ngihaya amandla akho,","poem":1},{"text":"ekuseni ngizahlabelela ngihaya uthando lwakho,","poem":2},{"text":"ngoba wena uyinqaba yami,","poem":1},{"text":"isiphephelo sami ezikhathini zokuhlupheka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Oh wena Mandla ami, ngihlabelela indumiso kuwe;","poem":1},{"text":"wena, Oh Nkulunkulu uyinqaba yami,","poem":2},{"lineBreak":true},{"text":"Nkulunkulu wami olothando.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}