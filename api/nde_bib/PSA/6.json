{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ngeleziginci. Kulandelwa isheminithi. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Oh Thixo ungangikhalimeli ngolaka lwakho","poem":1},{"text":"njalo ungangitshayi uthukuthele.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Woba lomusa kimi, Thixo,","poem":1},{"text":"ngoba ngiphela amandla;","poem":2},{"lineBreak":true},{"text":"Oh Thixo, ngisilisa,","poem":2},{"lineBreak":true},{"text":"ngoba amathambo ami alobuhlungu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Umoya wami udabukile.","poem":1},{"text":"Koze kube nini, Oh Thixo,","poem":2},{"lineBreak":true},{"text":"koze kube nini?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Phenduka, Oh Thixo, ungikhulule;","poem":1},{"text":"ngihlenga ngenxa yothando lwakho olungehlulekiyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kakho okukhumbulayo nxa esefile.","poem":1},{"text":"Ngubani okukhonzayo esengcwabeni lakhe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngikhathele ngokububula;","poem":1},{"text":"ubusuku bonke umbheda wami uba manzi te ngikhala","poem":2},{"lineBreak":true},{"text":"umendlalo wami ngiwugcwalise ngezinyembezi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amehlo ami ayafiphala ngenxa yosizi;","poem":1},{"text":"ayanqundeka ngenxa yazo zonke izitha zami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xekani kimi lina lonke elenza okubi,","poem":1},{"text":"ngoba uThixo usekuzwile ukulila kwami.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"UThixo usekuzwile ukukhala kwami ngicela umusa;","poem":1},{"text":"UThixo uyawamukela umkhuleko wami.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zonke izitha zami zizayangeka zidaniswe;","poem":1},{"text":"zizatshibilika zibuyele emuva masinyane sezilehlazo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}