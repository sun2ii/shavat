{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Kutshaywa iziginci. ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Zwana ukukhala kwami, Oh Nkulunkulu;","poem":1},{"text":"lalela umkhuleko wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngisemkhawulweni womhlaba ngiyakubiza,","poem":1},{"text":"ngiyabiza lapho inhliziyo yami isiphela amandla;","poem":2},{"lineBreak":true},{"text":"ngikhokhelela edwaleni eliphakeme kulami.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngoba ube uyisiphephelo sami,","poem":1},{"text":"inqaba eqinileyo evikela esitheni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngiyalangazelela ukuhlala ethenteni lakho laphakade","poem":1},{"text":"ngizifihle emthunzini wamaphiko akho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Phela usuzizwile izifungo zami, Oh Nkulunkulu;","poem":1},{"text":"usungiphile ilifa lalabo abalesabayo ibizo lakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yandisa insuku zempilo yenkosi,","poem":1},{"text":"iminyaka yayo okwezizukulwane ezinengi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sengathi ingaba sesihlalweni iphambi kukaNkulunkulu nini lanini;","poem":1},{"text":"wabele uthando Lwakho lokuthembeka Kwakho kuyivikele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lapho-ke ngizahlala ngihlabelela indumiso ebizweni Lakho","poem":1},{"text":"ngigcwalise izifungo zami insuku ngensuku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}