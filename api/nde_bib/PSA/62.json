{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. KuJeduthuni. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Umphefumulo wami ufumana ukuphumula kuNkulunkulu kuphela;","poem":1},{"text":"ukusindiswa kwami kuvela kuye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yena yedwa uyilo idwala lami lensindiso yami;","poem":1},{"text":"uyinqaba yami, kangisoze ngihlukunyezwe lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Koze kube nini lilokhu lihlukuluza umuntu na?","poem":1},{"text":"Lonke lizamlahla phansi na","poem":2},{"text":"yena ongumduli otshekileyo,","poem":1},{"text":"oluthango olutebhayo?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bazimisele ukumqethula","poem":1},{"text":"esikhundleni sakhe esiphezulu;","poem":2},{"lineBreak":true},{"text":"bathokoziswa ngamanga.","poem":2},{"text":"Ngemilomo yabo bayabusisa,","poem":1},{"text":"kodwa ezinhliziyweni zabo bayaqalekisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Fumana ukuphumula, Oh mphefumulo wami,","poem":1},{"text":"kuNkulunkulu kuphela; ithemba lami livela kuye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yena yedwa ulidwala lami lensindiso;","poem":1},{"text":"uyinqaba yami, kangisoze ngihlukunyezwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Insindiso yami lodumo lwami kweyeme kuNkulunkulu;","poem":1},{"text":"ulidwala lami eliqinileyo, isiphephelo sami.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Thembani kuye ngezikhathi zonke, lina bantu;","poem":1},{"text":"likhuphe konke okusezinhliziyweni zenu kuye,","poem":2},{"lineBreak":true},{"text":"ngoba uNkulunkulu uyisiphephelo sethu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abantukazana bangumoya nje,","poem":1},{"text":"izikhulu ziyinkohliso nje;","poem":2},{"text":"aluba belinganiswa esikalini kabasilutho;","poem":1},{"text":"bonke ndawonye bangumoya kuphela.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lingathembi ukuqilibezela","poem":1},{"text":"kumbe lizikhukhumeze ngempahla zokwebiwa;","poem":2},{"text":"kungaze kube inotho yenu iyanda,","poem":1},{"text":"lingabeki inhliziyo zenu kuyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yinye into uNkulunkulu ayikhulumileyo,","poem":1},{"text":"zimbili izinto engizizwileyo,","poem":2},{"text":"ukuthi amandla wonke ngawakho wena, Oh Nkulunkulu.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Lokuthi wena, Thixo, ulothando olojulileyo,","poem":2},{"text":"umuntu ngamunye uzamupha umvuzo","poem":1},{"text":"ngalokho akwenzileyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}