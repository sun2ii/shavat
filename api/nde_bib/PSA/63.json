{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Ihubo likaDavida eseNkangala yakoJuda."]},{"type":"verse","number":1,"content":[{"text":"Oh Nkulunkulu, unguNkulunkulu wami,","poem":1},{"text":"ngiyakudinga ngitshiseka;","poem":2},{"text":"umphefumulo wami uyakomela,","poem":1},{"text":"umzimba wami uyakudinga,","poem":2},{"text":"elizweni elomileyo eseligugile","poem":1},{"text":"lapho okungelamanzi khona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngikubonile endlini Yakho engcwele","poem":1},{"text":"ngawabona amandla Akho lenkazimulo Yakho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngoba uthando Lwakho lungcono kulempilo,","poem":1},{"text":"izindebe zami zizakutsho inkazimulo Yakho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngizakudumisa kokuphela nxa ngisaphila,","poem":1},{"text":"ngebizo lakho ngizaphakamisa izandla zami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umphefumulo wami uzasuthiswa ngokudla okuhle okuphilisayo;","poem":1},{"text":"ngezindebe ezihlabelayo umlomo wami uzakudumisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngisembhedeni wami ngiyakhumbula;","poem":1},{"text":"ngiyakukhumbula lanxa ngisemlindweni wasebusuku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngoba ulusizo lwami,","poem":1},{"text":"ngiyahlabelela ngisemthunzini wamaphiko Akho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Umphefumulo wami unamathele Kuwe;","poem":1},{"text":"isandla sakho sokunene siyangisekela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Labo abazingela impilo yami bazabhujiswa;","poem":1},{"text":"bazakwehlela phansi ekujuleni komhlabathi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bazakwabelwa ukudliwa yinkemba","poem":1},{"text":"babe yikudla kwamakhanka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kodwa inkosi izathokoza kuNkulunkulu;","poem":1},{"text":"bonke abafunga ngebizo likaNkulunkulu bazamdumisa,","poem":2},{"lineBreak":true},{"text":"ikanti imilomo yabaqamba amanga izathuliswa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}