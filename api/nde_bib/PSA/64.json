{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ake ungizwe, Oh Nkulunkulu, nxa ngiletha ukusola kwami;","poem":1},{"text":"vikela impilo yami ekusongelweni yisitha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngifihla emacebeni abantu ababi,","poem":1},{"text":"kulokho kuxokozela kwezixhwali.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bayazilola inlimi zabo njengezinkemba","poem":1},{"text":"bakhombele amazwi abo njengemitshoko ebulalayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Batshoka becathemele umuntu ongonanga lutho;","poem":1},{"text":"bayaphanga ukumciba bengelavalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bayakhuthazana ngamacebo amabi,","poem":1},{"text":"bakhulumisana ngokufihla imijibila yabo;","poem":2},{"lineBreak":true},{"text":"bathi, “Sizabonwa ngubani?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Baceba ukona besithi,","poem":1},{"text":"“Sesakhe icebo elihle kakhulu!”","poem":2},{"text":"Ngempela ingqondo yomuntu","poem":1},{"text":"lenhliziyo yakhe ilobuqili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kodwa uNkulunkulu uzabaciba ngemitshoko;","poem":1},{"text":"ngokuphangisa nje bazalahlwa phansi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uzakwenza banyeyane bona bodwa bacine sebedilizana;","poem":1},{"text":"bonke abababonayo","poem":2},{"lineBreak":true},{"text":"bazanyikinya amakhanda babahleke.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bonke abantu bomhlaba bazakwesaba;","poem":1},{"text":"bazafakaza imisebenzi kaNkulunkulu","poem":2},{"lineBreak":true},{"text":"banakane ngalokho akwenzileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Akuthi abalungileyo bathokoze kuThixo","poem":1},{"text":"baphephele kuye;","poem":2},{"lineBreak":true},{"text":"akuthi bonke abaqotho ngenhliziyo bamdumise.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}