{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ihubo likaDavida. Ingoma."]},{"type":"verse","number":1,"content":[{"text":"Udumo lukulindele, Oh Nkulunkulu, eZiyoni;","poem":1},{"text":"kuwe izifungo zethu zizagcwaliseka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yebo, wena owuzwayo umkhuleko,","poem":1},{"text":"bonke abantu bazakuza kuwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwathi lapho sisancindezelwa yizono,","poem":1},{"text":"wazithethelela iziphambeko zethu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Babusisiwe labo obakhethayo","poem":1},{"text":"ubasondeze bazohlala emagumeni Akho!","poem":2},{"text":"Sigcwalisiwe ngezinto ezinhle zendlu Yakho,","poem":1},{"text":"ezethempeli lakho elingcwele.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uyasiphendula ngezenzo zokulunga ezimangalisayo,","poem":1},{"text":"Oh Nkulunkulu Msindisi wethu,","poem":2},{"text":"themba lemikhawulo yonke yomhlaba","poem":1},{"text":"lenlwandle ezikude,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"owabumba izintaba ngamandla akho,","poem":1},{"text":"lapho wena usuziqinisile ngamandla,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"owathulisa ukuduma kolwandle,","poem":1},{"text":"ukuduma kwamagagasi azo,","poem":2},{"lineBreak":true},{"text":"lokuhlokoma kwezizwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Labo abahlala khatshana bayazesaba izimangaliso zakho;","poem":1},{"text":"lapho okudabuka khona ukusa lokuhlwa okufiphala khona,","poem":2},{"lineBreak":true},{"text":"uhlabela izingoma zentokozo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uyawunakekela umhlaba uwuthelezele ngamanzi;","poem":1},{"text":"uyawunothisa kakhulu.","poem":2},{"text":"Imifula kaNkulunkulu igcwalisiwe ngamanzi","poem":1},{"text":"ukuze abantu bazuze amabele,","poem":2},{"lineBreak":true},{"text":"ngoba ukumisile wena lokho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uyayigcwalisa imisele yawo ngamanzi","poem":1},{"text":"uyendlale kahle imibundu yawo;","poem":2},{"lineBreak":true},{"text":"uyawuthambisa ngemikhizo ubusise amabele awo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uyawuphelelisa umnyaka ngenala,","poem":1},{"text":"izinqola Zakho ziphuphume ngokugcwala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amadlelo asenkangala ayaphuphuma;","poem":1},{"text":"izintaba zigqokiswe ngenjabulo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amadlelo agcwele imihlambi yezimvu","poem":1},{"text":"lezigodi zisibekelwe ngamabele;","poem":2},{"lineBreak":true},{"text":"ziyamemeza ngentokozo zihlabelela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}