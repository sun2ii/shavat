{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ingoma. Ihubo."]},{"type":"verse","number":1,"content":[{"text":"Memezani ngentokozo kuNkulunkulu mhlaba wonke!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Hlabelani ngobukhosi bebizo lakhe;","poem":2},{"lineBreak":true},{"text":"yenzani udumo lwakhe lube lenkazimulo!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yitshoni kuNkulunkulu lithi,","poem":1},{"text":"“Imangalisa kangaka imisebenzi yakho!","poem":2},{"lineBreak":true},{"text":"Izitha Zakho ziyethuka phambi Kwakho","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umhlaba wonke uyakhothama Kuwe;","poem":1},{"text":"bahlabela udumo Kuwe,","poem":2},{"lineBreak":true},{"text":"bahlabelela udumo ebizweni Lakho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wozani libone akwenzileyo uNkulunkulu,","poem":1},{"text":"ukumangalisa kwemisebenzi yakhe ayenzela abantu!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waguqula ulwandle lwaba ngumhlabathi owomileyo,","poem":1},{"text":"badabula phakathi kwamanzi behamba ngezinyawo","poem":2},{"lineBreak":true},{"text":"wozani sithokoze Kuye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uyabusa laphakade ngamandla Akhe,","poem":1},{"text":"amehlo Akhe ayazikhangela izizwe","poem":2},{"lineBreak":true},{"text":"sengathi abahlamuki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dumisani uNkulunkulu wethu, lina bantu lonke,","poem":1},{"text":"akuthi inhlokomo yokudunyiswa kwakhe izwakale;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"uzilondolozile impilo zethu","poem":1},{"text":"wavikela inyawo zethu ukuze zingatsheleli.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngoba wena, Oh Nkulunkulu, wasilinga;","poem":1},{"text":"wasicenga njengesiliva.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wasingenisa entolongweni","poem":1},{"text":"waseleka ngemithwalo emihlane yethu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wayekela abantu bakhwela bazehlela emakhanda ethu;","poem":1},{"text":"sedlula phakathi komlilo lamanzi,","poem":2},{"lineBreak":true},{"text":"kodwa wasiletha endaweni yenala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngizakuza ethempelini Lakho lomnikelo wokutshiswa","poem":1},{"text":"ngigcwalise izifungo zami Kuwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izifungo ezathenjiswa yizindebe zami lomlomo wami","poem":1},{"text":"lapho ngisekuhluphekeni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngizakuhlabela izifuyo ezinonileyo,","poem":1},{"text":"lomnikelo wenqama; ngizanikela ngenkunzi kanye lembuzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wozani lilalele, lina lonke elimesabayo uNkulunkulu;","poem":1},{"text":"wothani ngilitshele lokho angenzele khona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngakhala Kuye ngomlomo wami;","poem":1},{"text":"indumiso yakhe yayisolimini lwami.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Aluba ngangigcine isono enhliziyweni yami,","poem":1},{"text":"iNkosi ngabe kayizange ingilalele;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kodwa ngeqiniso uNkulunkulu walalela","poem":1},{"text":"walizwa ilizwi lami ngikhuleka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kadunyiswe uNkulunkulu","poem":1},{"text":"ongawulahlanga umkhuleko wami","poem":2},{"lineBreak":true},{"text":"futhi ongagodlanga uthando lwakhe kimi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}