gathi abantu bonke bangadumisa wena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lapho-ke umhlaba uzathela isivuno,","poem":1},{"text":"uNkulunkulu, uNkulunkulu wethu, uzasibusisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"UNkulunkulu uzasibusisa,","poem":1},{"text":"kuthi yonke imikhawulo yomhlaba izamesaba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}