{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabelela. ElikaDavida. Ihubo. Ingoma."]},{"type":"verse","number":1,"content":[{"text":"UNkulunkulu kaphakame, izitha zakhe azihlakazwe;","poem":1},{"text":"izitha zakhe azimbalekele.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Njengentuthu iphetshulwa ngumoya lawe baphephulele kude;","poem":1},{"text":"njengengcino encibilikiswa ngumlilo,","poem":2},{"lineBreak":true},{"text":"ababi kababhubhe phambi kukaNkulunkulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodwa sekungathi abalungileyo bangajabula","poem":1},{"text":"bathokoze phambi kukaNkulunkulu;","poem":2},{"lineBreak":true},{"text":"sengathi bangathaba bathokoze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hlabelelani kuNkulunkulu,","poem":1},{"text":"hlabelelani indumiso ebizweni lakhe,","poem":2},{"text":"mphakamiseni yena ohlezi phezu kwamayezi","poem":1},{"text":"lithokoze phambi kwakhe obizo lakhe nguThixo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uyise wezintandane, umlamuleli wabafelokazi,","poem":1},{"text":"nguNkulunkulu emzini wakhe ongcwele.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"UNkulunkulu uyabalungisela indawo ezimulini labo abalesizungu,","poem":1},{"text":"ukhokhela izibotshwa ngokuhlabela;","poem":2},{"lineBreak":true},{"text":"kodwa abahlamuki bahlala elizweni elomileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kwathi lapho ukhokhela abantu bakho, Oh Nkulunkulu,","poem":1},{"text":"lapho wawudabula elizweni eliyinkangala,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"umhlaba wanyikinyeka, umkhathi walithulula izulu,","poem":1},{"text":"phambi kukaNkulunkulu, onguYena oweSinayi,","poem":2},{"lineBreak":true},{"text":"phambi kukaNkulunkulu ka-Israyeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wanisa izulu elinengi, Oh Nkulunkulu;","poem":1},{"text":"wavuselela ilifa lakho elaselikhathele.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abantu bakho bahlala kulo bazinza,","poem":1},{"text":"kwathi ngokuphana kwakho Nkulunkulu,","poem":2},{"lineBreak":true},{"text":"wabaphakela abangabayanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"INkosi yalikhupha ilizwi,","poem":1},{"text":"kwaba labanengi kakhulu abalimemezelayo besithi,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Makhosi lamabutho phangisani libaleke;","poem":1},{"text":"ezihonqweni amakhosikazi abelana impango.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Khonapho lisalele phakathi kwemililo yezihonqo,","poem":1},{"text":"impiko zejuba lami zihuqiwe ngesiliva,","poem":2},{"lineBreak":true},{"text":"izinsiba zalo ngegolide elikhazimulayo.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lapho uSomandla wawahlakaza amakhosi elizwe,","poem":1},{"text":"kwakunjengongqwaqwane eqoqene phezu kweZalimoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Izintaba zeBhashani yizintaba ezilesithunzi;","poem":1},{"text":"zilezindongandonga izintaba zaseBhashani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kungani linyonkoloza ngomona,","poem":1},{"text":"lina zintaba ezindongandonga,","poem":2},{"text":"leyontaba uNkulunkulu akhetha ukubusa kuyo,","poem":1},{"text":"lapho uThixo ngokwakhe uzahlala khona lanini?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Izinqola zikaNkulunkulu zingamatshumi ezinkulungwane;","poem":1},{"text":"lezinkulungwane zezinkulungwane;","poem":2},{"lineBreak":true},{"text":"iNkosi isifikile ivela eSinayi yangena endlini yayo engcwele.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wathi ekukhuphukeni kwakho uqansa,","poem":1},{"text":"wakhokhela abathunjiweyo;","poem":2},{"lineBreak":true},{"text":"wemukela izipho ebantwini,","poem":2},{"text":"lakulabo abahlamukayo","poem":1},{"text":"ukuze wena, Oh Thixo Nkulunkulu, uhlale khona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Udumo kalube kuThixo, kuNkulunkulu uMsindisi wethu,","poem":1},{"text":"othwala imithwalo yethu insuku zonke.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"UNkulunkulu wethu nguNkulunkulu osindisayo;","poem":1},{"text":"kuThixo wobukhosi kuvela ukuphepha ekufeni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngeqiniso uNkulunkulu uzawachoboza amakhanda ezitha zakhe,","poem":1},{"text":"imiqhele eloboya yalabo abaqhubekayo ngezono zabo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"INkosi ithi, “Ngizabaletha besuka eBhashani;","poem":1},{"text":"ngizabaletha besuka ekujuleni kolwandle,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ukuze ligxamuze inyawo zenu egazini lezitha zenu,","poem":1},{"text":"lezilimi zezinja zenu zibe lesabelo sazo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Udwendwe lwakho Nkulunkulu seluqhamuka, yebo","poem":1},{"text":"udwendwe lukaNkulunkulu wami leNkosi","poem":2},{"lineBreak":true},{"text":"lungena endlini engcwele.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Phambili ngabahlabeleli, kulandele abamachacho;","poem":1},{"text":"phakathi kwabo kulamantombazana atshaya amagedla.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Dumisani uNkulunkulu ebandleni elikhulu;","poem":1},{"text":"dumisani uThixo embuthanweni ka-Israyeli.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Masinyane isizwana sakoBhenjamini sibakhokhele,","poem":1},{"text":"nantiyana ixuku elikhulu lamakhosana kaJuda,","poem":2},{"lineBreak":true},{"text":"njalo nankayana amakhosana kaZebhuluni lakaNafithali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Veza amandla akho, Oh Nkulunkulu,","poem":1},{"text":"sitshengise amandla akho Nkulunkulu,","poem":2},{"lineBreak":true},{"text":"njengowakwenza endulo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ngenxa yethempeli lakho eliseJerusalema","poem":1},{"text":"amakhosi azakulethela izipho.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Khuza isilo esiphakathi kwemihlanga","poem":1},{"text":"umhlambi wenkunzi phakathi kwamathole ezizwe.","poem":2},{"text":"Sezithotshisiwe kazilethe izibhebhedu zesiliva.","poem":1},{"text":"Hlakaza izizwe ezithokoza ngempi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Amanxusa azavela eGibhithe;","poem":1},{"text":"iKhushi izazithoba kuNkulunkulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Hlabelelani kuNkulunkulu, awu lina mibuso yomhlaba,","poem":1},{"text":"hlabelelani indumiso kuThixo,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"kuye ohlala phezu kwesibhakabhaka sekadeni,","poem":1},{"text":"okhwaza ngelizwi elikhulu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Fakazani ngamandla kaNkulunkulu,","poem":1},{"text":"obukhosi bakhe buphezu kuka-Israyeli;","poem":2},{"lineBreak":true},{"text":"omandla akhe asesibhakabhakeni.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Uyamangalisa, Oh Nkulunkulu, usendlini yakho engcwele;","poem":1},{"text":"uNkulunkulu ka-Israyeli upha amandla ebantwini bakhe.","poem":2},{"lineBreak":true},{"text":"Indumiso kayibe kuNkulunkulu!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}