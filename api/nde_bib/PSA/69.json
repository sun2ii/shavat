{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Itshuni ethi, “Amaluba.” ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ngisindisa, Oh Nkulunkulu,","poem":1},{"text":"ngoba umsinga wamanzi usugamenxe ngentamo yami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngiyagalula ezinzikini ezitotayo,","poem":1},{"text":"lapho okungekho ndawo yokugxila.","poem":2},{"text":"Sengifike enzikini;","poem":1},{"text":"impophoma sezingikhulela.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sengidiniwe yikumemeza ngicela uncedo;","poem":1},{"text":"umphimbo wami usome qha.","poem":2},{"text":"Amehlo ami aseze efiphele,","poem":1},{"text":"edinga uNkulunkulu wami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Labo abangizondayo kungelasizatho","poem":1},{"text":"banengi okwedlula inwele zekhanda lami;","poem":2},{"text":"banengi abayizitha zami kungelambangela,","poem":1},{"text":"labo abafuna ukungidiliza.","poem":2},{"text":"Ngiyaphoqelwa ukuhlawula","poem":1},{"text":"engingakuntshontshanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Uyabazi ubuthutha bami, wena Nkulunkulu;","poem":1},{"text":"isono sami kasifihlakalanga kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Akuthi labo abathemba kuwe","poem":1},{"text":"bangayangiswa ngenxa yami,","poem":2},{"lineBreak":true},{"text":"Oh Thixo, Thixo Somandla;","poem":2},{"text":"akuthi labo abakudingayo,","poem":1},{"text":"bangahlaziswa ngenxa yami,","poem":2},{"lineBreak":true},{"text":"Oh Nkulunkulu ka-Israyeli.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngiyakubhensela ukugconwa ngenxa yakho,","poem":1},{"text":"ihlazo lihuqiwe ebusweni bami.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngingowemzini kubafowethu,","poem":1},{"text":"ngingowemzini emadodaneni kamama;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ngoba ukutshisekela indlu yakho kufuthelene kimi,","poem":1},{"text":"lezethuko zalabo abakuthukayo ziwela kimi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngithi lapho ngilila ngizila ukudla,","poem":1},{"text":"ngibhensele ukwetheswa inhlamba;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kuthi lapho ngivunula amasaka","poem":1},{"text":"abantu badlale ngami.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Labo abalinda emasangweni bayangihleka,","poem":1},{"text":"ngiyingoma nje yezidakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kodwa ngikhuleka kuwe, Oh Thixo,","poem":1},{"text":"ngesikhathi somusa wakho;","poem":2},{"text":"ngothando lwakho olukhulu, Oh Nkulunkulu,","poem":1},{"text":"ngiphendula ngensindiso yakho eqinisekileyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngihlenga exhaphozini,","poem":1},{"text":"ungangiyekeli ngigalule;","poem":2},{"text":"ngikhulula kulabo abangizondayo,","poem":1},{"text":"emanzini atshonayo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ungayekeli izikhukhula zingigalulise","poem":1},{"text":"loba inziki zingiginye,","poem":2},{"lineBreak":true},{"text":"loba umgodi uvaleke umlomo wawo phezu kwami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ngiphendula, Oh Thixo, ngenxa yokulunga kothando lwakho;","poem":1},{"text":"emuseni wakho omkhulu phendukela kimi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ungayifihleli ubuso bakho inceku yakho;","poem":1},{"text":"ngiphendula masinyane, ngoba ngiphakathi kohlupho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sondela ungikhulule;","poem":1},{"text":"ngihlenga ngenxa yezitha zami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Uyakwazi ukuthi ngigconwa njani,","poem":1},{"text":"ngihlaziswa njalo ngiyangiswa;","poem":2},{"lineBreak":true},{"text":"zonke izitha zami ziphambi kwakho.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ukugconwa sekuyephule inhliziyo yami","poem":1},{"text":"kwangitshiya esithubeni;","poem":2},{"text":"ngadinga uzwelo ngaluswela,","poem":1},{"text":"abaduduzi, kodwa ngabaswela.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bathela inyongo ekudleni kwami","poem":1},{"text":"banginathisa iviniga nxa ngomile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Sengathi itafula eliphambi kwabo lingaba ngumjibila;","poem":1},{"text":"sengathi lingaba yisijeziso lesithiyo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sengathi amehlo abo angafiphala ukuze bangaboni,","poem":1},{"text":"lamaqolo abo akhokhobe kokuphela.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Thululela ulaka lwakho phezu kwabo;","poem":1},{"text":"akuthi ulaka lwakho olwesabekayo lubehlele.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sengathi indawo yabo ingaba ngamanxiwa;","poem":1},{"text":"akungabi lamuntu ozahlala emathenteni abo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngoba bahlupha labo obalimazayo","poem":1},{"text":"bakhulume ngobuhlungu balabo obalimazayo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bethese amacala phezu kwamacala;","poem":1},{"text":"ungayekeli bazuze isabelo sensindiso yakho.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Sengathi bangesulwa encwadini yokuphila","poem":1},{"text":"bangaze babalwa kanye labalungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ngisebuhlungwini, ngikhathazekile;","poem":1},{"text":"sengathi insindiso yakho, Oh Nkulunkulu ingangivikela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ngizalidumisa ibizo likaNkulunkulu ngengoma,","poem":1},{"text":"ngilibabaze ngokubonga.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Lokhu kuzamthabisa uThixo okwedlula inkabi,","poem":1},{"text":"okwedlula inkunzi yonke ilempondo lamangqina ayo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Abayanga bazabona bajabule","poem":1},{"text":"lina elimdingayo uNkulunkulu,","poem":2},{"lineBreak":true},{"text":"sengathi inhliziyo zenu zingaphila!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"UThixo uyabezwa abaswelayo,","poem":1},{"text":"kabeyisi abantu bakhe abathunjiweyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Akuthi izulu lomhlaba kumdumise,","poem":1},{"text":"inlwandle lakho konke okunyakaza kuzo,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ngoba uNkulunkulu uzayisindisa iZiyoni","poem":1},{"text":"ayakhe kutsha imizi yakoJuda.","poem":2},{"text":"Yikhona-ke abantu bazakwakha khona balithathe libe ngelabo;","poem":1}]},{"type":"verse","number":36,"content":[{"text":"abantwana bezinceku zayo lizakuba yilifa labo,","poem":2},{"lineBreak":true},{"text":"labalithandayo ibizo lakhe bazahlala khona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}