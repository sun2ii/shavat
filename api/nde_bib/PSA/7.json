{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["Ishigayoni kaDavida ayihlabelela uThixo mayelana loKhushi umBhenjamini."]},{"type":"verse","number":1,"content":[{"text":"Oh Thixo Nkulunkulu wami,","poem":1},{"text":"ngiphephela kuwe;","poem":2},{"lineBreak":true},{"text":"ngisindisa ungikhulule kubo bonke abangizingelayo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ngoba bazanginithiza njengesilwane","poem":1},{"text":"bangiklebule iziqanyana kungekho ongangilamulela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Oh Thixo, Nkulunkulu wami, nxa ngikwenzile lokhu","poem":1},{"text":"izandla zami zilecala,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"nxa ngenze okubi kulowo ohlalisene kuhle lami","poem":1},{"text":"loba ngisuke ngaphanga isitha sami kungelasizatho,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"nxa kunjalo akuthi isitha sami singihlasele;","poem":1},{"text":"masigxobagxobele impilo yami emhlabathini","poem":2},{"lineBreak":true},{"text":"singibhuqabhuqele phansi ebhuqwini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vuka, Oh Thixo, ngolaka lwakho;","poem":1},{"text":"vuka uvimbele ukuthukuthela kwezitha zami.","poem":2},{"text":"Vuka, Nkulunkulu wami,","poem":1},{"text":"memezela ukwahlulela okuhle.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akuthi abantu bebuthene bakuhanqe","poem":1},{"text":"busa phezu kwabo usekuphakameni.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"UThixo kahlulele bonke abantu.","poem":2},{"text":"Ngahlulele, Oh Thixo ngokwanele ukulunga kwami,","poem":1},{"text":"ngokwanele ubuqotho bami, wena oPhezukonke.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Oh Nkulunkulu olungileyo,","poem":1},{"text":"ohlolisisa imicabango lezinhliziyo,","poem":2},{"text":"qeda udlakela lwababi","poem":1},{"text":"ukuze abalungileyo bavikeleke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Isihlangu sami nguNkulunkulu oPhezukonke,","poem":1},{"text":"osindisa abaqotho ngenhliziyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"UNkulunkulu ngumahluleli olungileyo,","poem":1},{"text":"uNkulunkulu obonisa ulaka lwakhe insuku zonke.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nxa umuntu engadeli ububi bakhe","poem":1},{"text":"uzalola inkemba yakhe;","poem":2},{"lineBreak":true},{"text":"uzaligoba alithiye idandili lakhe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Usezilungisile izikhali zakhe ezibulalayo;","poem":1},{"text":"uselungisa imitshoko yakhe evutha umlilo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lowo osuthiswe ngobubi","poem":1},{"text":"akhulelwe yikona uzala ukuphumputheka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lowo omba umgodi awuphande","poem":1},{"text":"uwela kulowomgodi awumbileyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inkathazo ayidalileyo iyamphendukela;","poem":1},{"text":"lesihluku sakhe sehlela phezu kwekhanda lakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ngizambonga uThixo ngenxa yokulunga kwakhe;","poem":1},{"text":"ngizahlabelela indumiso egameni likaThixo oPhezukonke.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}