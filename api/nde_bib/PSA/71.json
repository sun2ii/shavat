{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"Kuwe Thixo, sengithole isiphephelo;","poem":1},{"text":"mangingayangiswa lanini.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngihlenga ungikhulule ngokulunga kwakho;","poem":1},{"text":"ngilalela, woza ngokuphangisa ungisindise.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Woba lidwala lami lokuphephela,","poem":1},{"text":"lapho engingaya khona loba nini;","poem":2},{"text":"tshono umlayo wokuba ngisindiswe,","poem":1},{"text":"ngoba ulidwala lami lenqaba yami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngikhulula, Oh Nkulunkulu, esandleni sababi,","poem":1},{"text":"emandleni abantu ababi abalochuku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngoba ube ulithemba lami, Oh Thixo Wobukhosi,","poem":1},{"text":"ithemba lami kusukela ebutsheni bami.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kusukela ekuzalweni kwami ngahle ngeyama kuwe;","poem":1},{"text":"nguwe owangikhuphayo esiswini sikamama.","poem":2},{"lineBreak":true},{"text":"Ngizakudumisa njalonjalo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Senginjengomhlolo kwabanengi,","poem":1},{"text":"kodwa wena uyisiphephelo sami esiqinileyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Umlomo wami ugcwele udumo lwakho,","poem":1},{"text":"umemezela inkazimulo yakho ilanga lonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ungangilahleli kude nxa sengiluphele;","poem":1},{"text":"ungangifulatheli lapho amandla ami esephelile.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngoba izitha zami zikhuluma kubi ngami;","poem":1},{"text":"labo abalindele ukungibulala bahlangana ngami.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bathi, “UNkulunkulu usemlahlile;","poem":1},{"text":"xotshanani laye limbambe,","poem":2},{"lineBreak":true},{"text":"ngoba kakho ozamlamulela.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ungabi khatshana kwami, Oh Nkulunkulu;","poem":1},{"text":"woza masinyane, Oh Nkulunkulu wami, uzongisiza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sengathi labo abangethesa amacala","poem":1},{"text":"bangabhubha beyangekile;","poem":2},{"lineBreak":true},{"text":"sengathi labo abafuna ukungilimaza","poem":2},{"lineBreak":true},{"text":"bangabhixwa ngehlazo lokuyangeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kodwa mina ngizahlala ngithembile;","poem":1},{"text":"ngizakudumisa kakhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Umlomo wami uzafakaza ngokulunga kwakho,","poem":1},{"text":"langensindiso yakho ilanga lonke,","poem":2},{"lineBreak":true},{"text":"lokuba ngingasazi isilinganiso sayo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngizakuza ngifakaze ngemisebenzi yakho emikhulu,","poem":1},{"text":"Oh Thixo Wobukhosi;","poem":2},{"lineBreak":true},{"text":"ngizafakaza ngokulunga kwakho, okwakho wedwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kusukela ebutsheni bami, Oh Nkulunkulu, wangifundisa,","poem":1},{"text":"kuze kube lamuhla ngimemezela","poem":2},{"lineBreak":true},{"text":"imisebenzi yakho emangalisayo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lokuba sengiluphele sengiyimpunga","poem":1},{"text":"ungangideli, Oh Nkulunkulu,","poem":2},{"text":"ngize ngifakaze ngamandla akho esizukulwaneni esizayo,","poem":1},{"text":"amandla akho kubo bonke abalandelayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ukulunga kwakho kufika emkhathini, Oh Nkulunkulu,","poem":1},{"text":"wena osuwenze izinto ezinkulu.","poem":2},{"lineBreak":true},{"text":"Ngubani, Oh Nkulunkulu, onjengawe?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Loba usungenze ngabona inhlupheko","poem":1},{"text":"ezinengi lezibuhlungu,","poem":2},{"lineBreak":true},{"text":"uzangenyula njalo ekujuleni komhlabathi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Uzalwandisa udumo lwami","poem":1},{"text":"ungiduduze futhi njalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ngizakudumisa ngechacho","poem":1},{"text":"ngenxa yokuthembeka kwakho,","poem":2},{"lineBreak":true},{"text":"Nkulunkulu wami;","poem":2},{"text":"ngizahlabelela indumiso kuwe ngomqangala,","poem":1},{"text":"wena oNgcwele ka-Israyeli.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Izindebe zami zizamemeza ngentokozo","poem":1},{"text":"lapho ngihlabelela indumiso kuwe","poem":2},{"lineBreak":true},{"text":"mina ongisindisileyo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ulimi lwami luzatshona lukhuluma ngokulunga kwakho","poem":1},{"text":"ilanga lonke,","poem":2},{"text":"ngoba labo abafuna ukungilimaza","poem":1},{"text":"sebeyangisiwe basanganiswa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}