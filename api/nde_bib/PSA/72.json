{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"hebrew_subtitle","content":["ElikaSolomoni."]},{"type":"verse","number":1,"content":[{"text":"Yiphe inkosi ukwahlulela kwakho, Oh Nkulunkulu,","poem":1},{"text":"lokulunga kwakho indodana yesikhosini.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Uzakwahlulela abantu bakho ngokulunga,","poem":1},{"text":"labahluphekayo bakho ngemfanelo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Izintaba zizaletha ukuphumelela ebantwini,","poem":1},{"text":"lamaqaqa azaletha izithelo zokulunga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uzabavikela abahlukuluzwayo phakathi kwabantu","poem":1},{"text":"asindise abantwana balabo abaswelayo","poem":2},{"lineBreak":true},{"text":"afohloze umncindezeli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uzaphila kokuphela njengelanga,","poem":1},{"text":"njengenyanga kuzozonke izizukulwane.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uzakuba njengezulu lisina phezu kotshani obugundiweyo,","poem":1},{"text":"njengemikhizo ithelezela umhlabathi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngezinsuku zayo abalungileyo bazaphumelela;","poem":1},{"text":"ukuphumelela kuzakwanda inyanga ize itshabalale.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uzabusa kusukela elwandle kusiya elwandle,","poem":1},{"text":"njalo kusukela eMfuleni kusiya emikhawulweni yomhlaba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Izizwe ezihlala enkangala zizakhothama kuye,","poem":1},{"text":"izitha zakhe zizakhotha uthuli.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amakhosi eThashishi lawemazweni akude","poem":1},{"text":"azaletha imithelo kuye;","poem":2},{"text":"amakhosi aseShebha leSebha","poem":1},{"text":"azayilethela izipho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wonke amakhosi azakhothama kuye","poem":1},{"text":"lezizwe zonke zizakhonza kuye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ngoba uzabakhulula abaswelayo abakhalayo kuye,","poem":1},{"text":"abahluphekayo abangelamsizi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uzabahawukela ababuthakathaka","poem":1},{"text":"labaswelayo asindise abaswelayo ekufeni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uzabahlenga ekuncindezelweni lekuhlukuluzweni,","poem":1},{"text":"ngoba igazi labo liligugu kuye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mayibe lempilo ende!","poem":1},{"text":"Mayiphiwe igolide laseShebha.","poem":2},{"text":"Abantu kabayikhulekele","poem":1},{"text":"bayenzele izibusiso ilanga lonke.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akuthi amabele ande elizweni lonke;","poem":1},{"text":"azunguze eziqongweni zamaqaqa.","poem":2},{"text":"Izithelo zalo kazikhihlize njengeLebhanoni;","poem":1},{"text":"kaligcwale njengotshani egangeni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sengathi ibizo lakhe lingema njalo laphakade,","poem":1},{"text":"kalibe khona lanini nxa lilokhu lisekhona ilanga.","poem":2},{"lineBreak":true},{"text":"Zonke izizwe zizabusiswa ngaye,","poem":1},{"text":"zizakuthi ubusisiwe.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Udumo alube kuye uThixo uNkulunkulu, uNkulunkulu ka-Israyeli,","poem":1},{"text":"onguye yedwa owenza izinto ezimangalisayo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Udumo kalube sebizweni lakhe elingcwele laphakade;","poem":1},{"text":"sengathi umhlaba wonke ungagcwala inkazimulo yakhe.","poem":2},"Ameni njalo Ameni."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lokhu yikho ukuphetha kwemikhuleko kaDavida indodana kaJese.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}