{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"hebrew_subtitle","content":["Ihubo lika-Asafi."]},{"type":"verse","number":1,"content":[{"text":"Ngempela uNkulunkulu ulungile ku-Israyeli,","poem":1},{"text":"kulabo abahlanzekileyo enhliziyweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kodwa mina, inyawo zami zaphose zatshelela;","poem":1},{"text":"ngaphose ngakhuthisa ukunyathela.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngasuka ngahawukela abaklolodayo","poem":1},{"text":"ngibona ukuphumelela kwezigangi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kabalazo inhlungu;","poem":1},{"text":"imizimba yabo iphilile iqinile.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kabalayo imithwalo enzima ejayelekileyo ebantwini;","poem":1},{"text":"kabahlukuluzwa loba yini njengabanye abantu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngakho-ke ukuziqhenya kuyisigqizo sabo entanyeni;","poem":1},{"text":"bazigqokisa ngokwenza isihluku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ezinhliziyweni zabo ezingelazwelo kuphuma ububi;","poem":1},{"text":"iminakano emibi yezingqondo zabo ayilamikhawulo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bayakloloda, bakhulume ngomona;","poem":1},{"text":"bayaqholoza basongele ukuncindezela.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Imilomo yabo ithi izulu selingelabo,","poem":1},{"text":"lezilimi zabo zihle ziwuthathe umhlaba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yikho abantu bakibo bebakholwa,","poem":1},{"text":"bawanathe amanzi kakhulukazi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bathi, “UNkulunkulu angakwazi kanjani?","poem":1},{"text":"OPhezukonke ulalo ulwazi na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yikho lokhu abayikho khona ababi","poem":1},{"text":"bavele kabananzi, iyanda eyabo inotho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngempela bekuyize ukugcina inhliziyo yami ihlanzekile;","poem":1},{"text":"kube yize ukugeza izandla zami ngokungelacala.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ilanga lonke ngitshona ngikhathazwa;","poem":1},{"text":"ngiyajeziswa ekuseni zonke insuku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Aluba ngangithe,","poem":1},{"text":"“Ngizakhuluma ngitsho njalo,”","poem":2},{"lineBreak":true},{"text":"ngabe ngangibakhohlisa abantwabakho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngathi ngizama ukukuzwisisa konke lokhu","poem":1},{"text":"ngezwa kungisinda,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ngaze ngangena endlini engcwele kaNkulunkulu;","poem":1},{"text":"lapho-ke ngasengizwisisa isiphetho sabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ngempela uyababeka endaweni etshelelayo;","poem":1},{"text":"ubalahlela phansi ekubhujisweni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yeka, ukubhujiswa kwabo lula nje,","poem":1},{"text":"bakhuculwe nje yikwesaba!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Njengephupho nxa umuntu ephaphama","poem":1},{"text":"kuzakuba njalo lapho usuvuka, Thixo,","poem":2},{"lineBreak":true},{"text":"uzabeyisa njengemifanekiso yengqondo kuphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Lapho inhliziyo yami yayifuthelene","poem":1},{"text":"lomoya wami uthukuthele,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ngangiyisithutha esingaziyo;","poem":1},{"text":"ngangiyinyamazana yeganga kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ikanti ngihlezi ngilawe;","poem":1},{"text":"uyangibamba ngesandla sami sokunene.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Uyangikhokhela ngokweluleka kwakho","poem":1},{"text":"kuthi ngemva kwalokho uzangithatha ungise ebukhosini.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngilobani na ezulwini ngaphandle kwakho?","poem":1},{"text":"Lomhlaba kawulakho engikufisayo ngaphandle kwakho.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inyama yami lenhliziyo yami kungehluleka","poem":1},{"text":"kodwa uNkulunkulu ungamandla enhliziyo yami,","poem":2},{"lineBreak":true},{"text":"uyisabelo sami laphakade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Labo abakhatshana lawe bazabhubha;","poem":1},{"text":"uyababhidliza bonke abangathembekanga kuwe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kodwa mina kimi kuhle ukuba seduze loNkulunkulu.","poem":1},{"text":"Sengenze uThixo Wobukhosi isiphephelo sami;","poem":2},{"lineBreak":true},{"text":"ngizafakaza ngazozonke izenzo zakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}