{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":74,"content":[{"type":"hebrew_subtitle","content":["Ihubo lika-Asafu"]},{"type":"verse","number":1,"content":[{"text":"Kungani ususilahlile kokuphela na, awu Nkulunkulu?","poem":1},{"text":"Kungani ulaka lwakho luvutha phezu kwezimvu zedlelo lakho na?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Khumbula abantu owabathengayo ekadeni,","poem":1},{"text":"isizwe selifa lakho owasihlengayo","poem":2},{"lineBreak":true},{"text":"iNtaba iZiyoni, owawuhlala khona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Phenduka ungene emanxiweni aphakade la,","poem":1},{"text":"incithakalo yonke le yenziwe yisitha endlini engcwele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Izitha zakho zazibhonga endaweni owawuhlangana lathi kuyo;","poem":1},{"text":"zamisa impawu zazo njengeziboniso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zenza njengabantu abaphakamise amahloka","poem":1},{"text":"ukuphendla indlela yabo eguswini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zafohloza konke okubaziweyo","poem":1},{"text":"ngamahloka azo langezando.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zatshisa indlu yakho engcwele yaphela nya;","poem":1},{"text":"zangcolisa indawo ehlala iBizo lakho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zathi ngezinhliziyo zazo, “Sizababhuqa baphele nya!”","poem":1},{"text":"Zatshisa zonke izindawo zokukhonzela uNkulunkulu elizweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kasisaboniswa mimangaliso; kakuselabuphrofethi,","poem":1},{"text":"kakho kithi owaziyo ukuthi","poem":2},{"lineBreak":true},{"text":"kuzaze kube nini kunjalo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Koze kube nini isitha sikuklolodela na, awu Nkulunkulu?","poem":1},{"text":"Izitha zizalithuka kokuphela ibizo lakho na?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kungani ufinyeza isandla sakho sokunene na?","poem":1},{"text":"Sikhuphe ezingoxweni zezembatho zakho ubabhubhise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kodwa wena Nkulunkulu uyiNkosi yami kwasekadeni;","poem":1},{"text":"uletha insindiso emhlabeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kwakunguwe owaqhekeza ulwandle ngamandla akho;","poem":1},{"text":"wafohloza amakhanda esilo phakathi kwamanzi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwakunguwe owachoboza amakhanda kaLeviyathani","poem":1},{"text":"waba yikudla kwezidalwa zasenkangala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwakunguwe owavula imithombo lemifula;","poem":1},{"text":"womisa qha imifula eyayihlala igeleza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Imini ngeyakho, ngobakho njalo lobusuku;","poem":1},{"text":"walimisa ilanga kanye lenyanga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwakunguwe owamisa imingcele yonke yomhlaba;","poem":1},{"text":"wenza ihlobo kanye lobusika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Khumbula ukuthi isitha besikuklolodela, Thixo,","poem":1},{"text":"ukuthi iziwula bezihlambaza ibizo lakho.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ungaqhubeli umphefumulo wejuba lakho ezinyamazaneni;","poem":1},{"text":"ungaze wakhohlwa kokuphela","poem":2},{"lineBreak":true},{"text":"impilo yabantu bakho abahluphekayo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nanzelela isivumelwano sakho,","poem":1},{"text":"ngoba izikhundla zobugebenga zigcwele","poem":2},{"lineBreak":true},{"text":"kulolonke ilizwe ezindaweni ezilamathunzi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ungayekeli abancindezelweyo babuyele beyangekile;","poem":1},{"text":"sengathi abayanga labaswelayo bangalidumisa ibizo lakho.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Phakama, awu Nkulunkulu, vikela okungokwakho;","poem":1},{"text":"khumbula ukuthi iziwula zikuhleka njani ilanga lonke.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ungakulibali ukuvungama kwalabo abalwa lawe,","poem":1},{"text":"ukuxokozela kwezitha zakho, okuzwakala kokuphela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}