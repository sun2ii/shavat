{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Iculo elithi, “Ungabhidlizi.” Ihubo lika-Asafi. Ingoma."]},{"type":"verse","number":1,"content":[{"text":"Siletha ukubonga kuwe, Oh Nkulunkulu,","poem":1},{"text":"siletha ukubonga, ngoba iBizo lakho liseduze;","poem":2},{"lineBreak":true},{"text":"abantu bakhuluma ngemisebenzi Yakho emangalisayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wena uthi, “Ngikhetha isikhathi esimisiweyo;","poem":1},{"text":"yimi engahlulela okuqondileyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nxa umhlaba kanye labantu bawo kuzamazama,","poem":1},{"text":"yimi engizibamba ziqine izisekelo zawo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngithi kwabayiziqholo, ‘Lingabe lisazincoma,’","poem":1},{"text":"ngithi kwababi, ‘Lingaziphakamisi impondo zenu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lingaphakamiseli uphondo lwenu phezulu ezulwini;","poem":1},{"text":"lingakhulumi liziqhenya.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kakho ovela empumalanga loba entshonalanga,","poem":1},{"text":"kumbe ovela enkangala ongaphakamisa umuntu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodwa nguNkulunkulu owahlulelayo:","poem":1},{"text":"uyamehlisa omunye, amkhweze omunye.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Esandleni sikaThixo kukhona inkezo","poem":1},{"text":"egcwele iwayini eliphuphumayo elixutshwe ngeziyoliso;","poem":2},{"text":"uyalithulula, kuthi bonke ababi bomhlaba","poem":1},{"text":"balinathe kanye lenzece zalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kodwa mina ngizamemezela lokhu lanini;","poem":1},{"text":"ngizahlabelela indumiso kuNkulunkulu kaJakhobe,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"yena othi, “Ngizazithulisa zonke impondo zababi,","poem":1},{"text":"kodwa impondo zabalungileyo zizaphakanyiswa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}