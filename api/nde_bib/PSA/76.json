{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Kusetshenziswa iziginci. Ihubo lika-Asafi. Ingoma."]},{"type":"verse","number":1,"content":[{"text":"Uyaziwa uNkulunkulu koJuda","poem":1},{"text":"ibizo lakhe likhulu ko-Israyeli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ithente lakhe liseSalema,","poem":1},{"text":"indawo yakhe yokuhlala iseZiyoni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Khonapho wayephula imitshoko ebenyezelayo,","poem":1},{"text":"izihlangu lezinkemba, izikhali zempi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Uyakhazimula ngokukhanya,","poem":1},{"text":"ulobukhosi obudlula izintaba ezigcwele izinyamazana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amadoda alezibindi alele ucaca aphangiwe,","poem":1},{"text":"alele ubuthongo bawo bokucina;","poem":2},{"text":"kakho loyedwa wamabutho lawo","poem":1},{"text":"ongaphakamisa izandla zakhe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uthi ungakhwaza wena, Oh Nkulunkulu kaJakhobe,","poem":1},{"text":"ibhiza lenqola kuhle kulale phansi kuthi zwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wena wedwa uyesatshwa.","poem":1},{"text":"Ngubani ongema phambi kwakho nxa usuthukuthele?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wathi usezulwini wehlisa ukwahlulela kwakho,","poem":1},{"text":"ilizwe lesaba lathula,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"lapho wena, Oh Nkulunkulu, waphakama ukwahlulela,","poem":1},{"text":"ukusindisa bonke abahluphekayo belizwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngempela ulaka lwakho ebantwini lukulethela indumiso,","poem":1},{"text":"kuthi bonke abasilileyo elakeni lwakho bathotshiswe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yenzani izifungo kuThixo uNkulunkulu wenu lizigcwalise;","poem":1},{"text":"akuthi wonke amazwe abomakhelwana","poem":2},{"lineBreak":true},{"text":"alethe izipho kuye Yedwa omele esatshwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uyephula ubuqholo bababusi;","poem":1},{"text":"uyesatshwa ngamakhosi omhlaba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}