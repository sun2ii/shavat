{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. KuJeduthuni, Elika-Asafi. Ihubo."]},{"type":"verse","number":1,"content":[{"text":"Ngakhala kuNkulunkulu ngicela uncedo;","poem":1},{"text":"ngakhala kuNkulunkulu ukuthi angizwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngathi ngikhathazekile ngamdinga uThixo;","poem":1},{"text":"ebusuku ngazelula izandla azazezadinwa","poem":2},{"lineBreak":true},{"text":"lomphefumulo wami wala ukududuzeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngakukhumbula, Oh Nkulunkulu, ngabubula;","poem":1},{"text":"ngacabanga, umoya wami wancipha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wala ukuthi amehlo ami avaleke;","poem":1},{"text":"ngangikhathazekile ngisehluleka ukukhuluma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngakhumbula ngezinsuku ezedlulayo,","poem":1},{"text":"insuku zakudala;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ngakhumbula izingoma zami ebusuku.","poem":1},{"text":"Inhliziyo yami yacabanga lomoya wami wadinga:","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“INkosi izakhalala kokuphela na?","poem":1},{"text":"Ayisayikuphinde itshengise uthando lwayo njalo na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kanti uthando lwayo olungapheliyo selunyamalele kokuphela na?","poem":1},{"text":"Kanti isithembiso sayo sesiphelile kokuphela na?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kanti uNkulunkulu usekhohliwe ukuba lesihawu na?","poem":1},{"text":"Usethe ngokuzonda wagodla uzwelo lwakhe na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngasengikhumbula ngathi, “Yilokhu okunginqundayo,","poem":1},{"text":"ukuthi isandla sokunene soPhezukonke kasisekho phezu kwami.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngizayikhumbula imisebenzi kaThixo;","poem":1},{"text":"yebo, ngizayikhumbula imimangaliso yakho yekadeni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngizacabanga ngayo yonke imisebenzi yakho","poem":1},{"text":"nginakane ngazozonke izenzo zakho ezinkulu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Izindlela zakho, Oh Nkulunkulu, zingcwele;","poem":1},{"text":"nguphi unkulunkulu omkhulu njengoNkulunkulu wethu na?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nguwe Nkulunkulu owenza izimanga;","poem":1},{"text":"uyawatshengisa amandla akho ebantwini.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngengalo yakho elamandla wabakhulula abantu bakho,","poem":1},{"text":"izizukulwane zikaJakhobe loJosefa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Amanzi akubona wena, Oh Nkulunkulu,","poem":1},{"text":"amanzi akubona atshotshobala;","poem":2},{"lineBreak":true},{"text":"inziki zagonyuluka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Amayezi awathulula amanzi,","poem":1},{"text":"isibhakabhaka sandindiza ngokuduma;","poem":2},{"lineBreak":true},{"text":"imitshoko yakho yaphazima yaya le lale.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Umdumo wakho wezwakala uphakathi kwesivunguzane,","poem":1},{"text":"umbane wakho wawukhanyisa umhlaba;","poem":2},{"lineBreak":true},{"text":"umhlaba wavevezela wanyikinyeka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Indlela yakho yadabula olwandle,","poem":1},{"text":"umkhondo wakho phakathi kwamanzi,","poem":2},{"lineBreak":true},{"text":"kodwa izinyathelo zakho zazingabonakali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wabahola abantu bakho njengomhlambi wezimvu","poem":1},{"text":"ngesandla sikaMosi lo-Aroni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}