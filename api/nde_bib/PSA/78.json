i bawufundise abantwababo,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ukuze aziwe yisizukulwane esilandelayo,","poem":1},{"text":"kanye labantwana abazazalwa,","poem":2},{"lineBreak":true},{"text":"kuthi labo batshele abantwababo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yikho-ke bazabeka ithemba labo kuNkulunkulu","poem":1},{"text":"njalo abasoze bakhohlwa izenzo zakhe","poem":2},{"lineBreak":true},{"text":"kodwa bagcine imilayo yakhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kabayikuba njengabokhokho babo","poem":1},{"text":"ababeyisizukulwana esilobuqholo lesihlamukayo,","poem":2},{"text":"onhliziyo zabo zazingazinikelanga kuNkulunkulu","poem":1},{"text":"omoya yabo yayingathembekanga kuye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amadoda ako-Efrayimi, loba ayehlomile ngemitshoko,","poem":1},{"text":"afulathela mhla welanga lempi;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kabasigcinanga isivumelwano sikaNkulunkulu,","poem":1},{"text":"bala ukuphila ngomthetho wakhe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bakhohlwa lokho ayekwenzile,","poem":1},{"text":"izimanga ayebatshengise zona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wenza imimangaliso oyise bekhangele","poem":1},{"text":"elizweni laseGibhithe, esigodini saseZowani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Walwahlukanisa ulwandle wabahola bachapha;","poem":1},{"text":"wenza amanzi ema aqina saka njengomduli.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wabahola ngeyezi emini","poem":1},{"text":"njalo ngokukhanya komlilo ubusuku bonke.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wawaqhekeza amadwala enkangala","poem":1},{"text":"wabapha amanzi amanengi njengolwandle;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"wantshazisa impophoma emadwaleni amawa","poem":1},{"text":"wenza amanzi ageleza njengemifula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kodwa baqhubeka besona phambi kwakhe,","poem":1},{"text":"bamhlamukela enkangala yena oPhezukonke.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bamlinga uNkulunkulu ngabomo","poem":1},{"text":"ngokucela ukudla ababekutshisekela.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bamchothoza uNkulunkulu","poem":1},{"text":"besithi, “Kambe uNkulunkulu angendlala itafula lokudlela","poem":2},{"lineBreak":true},{"text":"enkangala na?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wathi lapho etshaya idwala,","poem":1},{"text":"amanzi antshantshaza,","poem":2},{"lineBreak":true},{"text":"kwageleza amanzi amanengi.","poem":2},{"text":"Kodwa angasipha njalo lokudla na?","poem":1},{"text":"Angabalethela inyama abantu bakhe na?”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"UThixo wathi ebezwa wathukuthela kakhulu;","poem":1},{"text":"umlilo wakhe wavuthela kuJakhobe,","poem":2},{"lineBreak":true},{"text":"ulaka lwakhe lwaqina ku-Israyeli,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ngoba kabamkholwanga uNkulunkulu","poem":1},{"text":"njalo kabawathembanga amandla okuhlenga kwakhe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Loba kunjalo walaya umkhathi ngaphezulu","poem":1},{"text":"wavula iminyango yamazulu;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"wanisa imana ukuthi badle abantu,","poem":1},{"text":"wabapha amabele asezulwini.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Abantu badla isinkwa sezingilosi;","poem":1},{"text":"wabathumela konke ukudla ababengakudla.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Wawukhulula umoya wempumalanga uvela emazulwini,","poem":1},{"text":"wawukhulula umoya weningizimu ngamandla akhe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Wanisela inyama kubo njengothuli,","poem":1},{"text":"i