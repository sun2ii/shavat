nt":[{"text":"Wayilungisa indlela yolaka lwakhe;","poem":1},{"text":"kabaphephisanga ekufeni","poem":2},{"lineBreak":true},{"text":"kodwa wabanikela emikhuhlaneni.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Wawabulala wonke amazibulo aseGibhithe,","poem":1},{"text":"izithelo zabo zokuqala zokuba ngamadoda emathenteni kaHamu.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Kodwa wabakhupha abantu bakhe njengomhlambi wezimvu;","poem":1},{"text":"wabahola njengezimvu bedabula inkangala.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Wabakhokhela ngonanzelelo,","poem":1},{"text":"ngakho babengesabi;","poem":2},{"lineBreak":true},{"text":"kodwa ulwandle lwazigubuzela izitha zabo.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Kanjalo wabaletha emngceleni welizwe lakhe elingcwele,","poem":1},{"text":"elizweni lamaqaqa ayelithethe ngesandla sakhe sokunene.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Wazixotsha izizwe phambi kwabo","poem":1},{"text":"wabahlukanisela ilizwe lazo laba yilifa;","poem":2},{"lineBreak":true},{"text":"wahlalisa izizwana zako-Israyeli emizini yazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"Kodwa bamlinga uNkulunkulu,","poem":1},{"text":"bamhlamukela oPhezukonke;","poem":2},{"lineBreak":true},{"text":"kabayigcinanga imilayo yakhe.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Njengabokhokho babo babengathembekanga bengakholwa,","poem":1},{"text":"ungeke wathemba njengedandili elenziwe kubi.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Bamvusa ulaka ngezindawo zabo eziphezulu;","poem":1},{"text":"baqubula ubukhwele bakhe ngezithombe zabo.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Wathi uNkulunkulu ngokukuzwa lokho,","poem":1},{"text":"wathukuthela kakhulu;","poem":2},{"lineBreak":true},{"text":"wamlahla qobo lokumlahla u-Israyeli.","poem":2}]},{"type":"verse","number":60,"content":[{"t