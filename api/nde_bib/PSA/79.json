{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["Ihubo lika-Asafi"]},{"type":"verse","number":1,"content":[{"text":"Oh Nkulunkulu, izizwe sezilingenele ilifa lakho;","poem":1},{"text":"sezilingcolisile ithempeli lakho eligcwele,","poem":2},{"lineBreak":true},{"text":"iJerusalema isibhidliziwe yaba luthuli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Izidumbu zezinceku zakho sebezilahlile","poem":1},{"text":"ukuba yikudla kwezinyoni zasemoyeni,","poem":2},{"lineBreak":true},{"text":"inyama yabangcwele bakho yaba yikudla kwezilo zelizwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Balichithile igazi njengamanzi","poem":1},{"text":"bahonqolozela ngalo iJerusalema,","poem":2},{"lineBreak":true},{"text":"kasekho ozangcwaba abafileyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Siyizinto zokuchothozwa kubomakhelwane bethu,","poem":1},{"text":"inhlekisa lokweyiswa yibo bonke esihlala labo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Koze kube nini, Oh Thixo? Uzazonda kuze kube nininini na?","poem":1},{"text":"Koze kube nini ubukhwele bakho butshisa njengomlilo na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Thululela intukuthelo yakho kulezozizwe","poem":1},{"text":"ezingakunanziyo,","poem":2},{"lineBreak":true},{"text":"ezingalibiziyo ibizo lakho","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ngoba zimchithile uJakhobe","poem":1},{"text":"zalibhidliza ilizwe lakibo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ungawethesi thina umlandu wabokhokho;","poem":1},{"text":"sengathi isihawu sakho singeza masinyane ukuzasivikela,","poem":2},{"lineBreak":true},{"text":"ngoba sesisebunzimeni obubi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sisize, awu Nkulunkulu Msindisi wethu,","poem":1},{"text":"ngenxa yobukhosi bebizo lakho;","poem":2},{"text":"sikhulule uthethelele izono zethu,","poem":1},{"text":"ngenxa yebizo lakho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kungani izizwe zisithi,","poem":1},{"text":"“Ungaphi uNkulunkulu wabo?”","poem":2},{"lineBreak":true},{"text":"Yenza emehlweni ethu, kwaziwe phakathi kwezizwe","poem":1},{"text":"ukuthi uyaliphindisela igazi lezinceku zakho elachithwayo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sengathi ukububula kwezibotshwa kungafinyelela kuwe;","poem":1},{"text":"ngamandla engalo yakho sindisa labo abagwetshelwe ukufa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Baphindisele kasikhombisa omakhelwane bethu","poem":1},{"text":"ngezinhlamba ababekuchaphaza ngazo, Thixo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kuzakuthi-ke thina abantu bakho,","poem":1},{"text":"izimvu zedlelo lakho, sikudumise laphakade;","poem":2},{"text":"kusuka esizukulwaneni kusiya esizukulwaneni","poem":1},{"text":"sizabalisa udumo lwakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}