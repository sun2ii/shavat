lwakho luvutha","poem":2},{"lineBreak":true},{"text":"phezu kwemikhuleko yabantu bakho?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Usubafunzile ngesinkwa sezinyembezi;","poem":1},{"text":"ubenze banatha inyembezi ezigcwele umganu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ususenze saba yimbangela yengxabano kubomakhelwane bethu,","poem":1},{"text":"lezitha zethu ziyasihleka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sivuselele, Oh Nkulunkulu Somandla;","poem":1},{"text":"khanyisa ubuso bakho kithi,","poem":2},{"lineBreak":true},{"text":"ukuze sisindiswe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waletha ivini ulisusa eGibhithe;","poem":1},{"text":"wazixotsha izizwe waligxumeka,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"walicentela indawo","poem":1},{"text":"labamba emhlabathini lagcwala ilizwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Izintaba zagcwala umthunzi walo,","poem":1},{"text":"imisedari emikhulu yathi silikici ngamagatsha alo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lakhulisa amagatsha alo anabela oLwandle,","poem":1},{"text":"amahlumela alo afika kude eMfuleni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kungani na usudilize imiduli yalo","poem":1},{"text":"ukuze bonke abedlulayo baziqhululele izithelo zalo?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ingulungunda ziyalivadlaza,","poem":1},{"text":"lezidalwa zeganga zizitika ngalo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Buya kithi, Oh Nkulunkulu Somandla!","poem":1},{"text":"Khangela phansi usezulwini ubone!","poem":2},{"text":"Nakekela ivini leli,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"impande ehlanyelwe yisandla sakho sokunene,","poem":2},{"lineBreak":true},{"text":"indodana ozondlele yona wena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ivini lakho seliqunyiwe, selitshiswe ngomlilo;","poem":1},{"text":"ngokukhuza kwakho abantu bayabhubha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yeyamisa isandla sakho emuntwini ongakwesokunene kwakho,","poem":1},{"text":"indodana yomuntu ozondlele yona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yikho asiyikukufulathela, sivuselele,","poem":1},{"text":"ukuze sibize ibizo lakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sivuselele, Oh Thixo Nkulunkulu Somandla;","poem":1},{"text":"khanyisa ubuso bakho kithi,","poem":2},{"lineBreak":true},{"text":"ukuze sisindiswe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}