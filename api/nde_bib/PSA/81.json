{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ngendlela yegithithi. Elika-Asafi"]},{"type":"verse","number":1,"content":[{"text":"Hlabelelani ngentokozo kuNkulunkulu ongamandla ethu;","poem":1},{"text":"memezani kakhulu kuNkulunkulu kaJakhobe!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Qalisani ukuhlabela, tshayani isigubhu,","poem":1},{"text":"khalisani ichacho elimnandi lomhubhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Khalisani uphondo lwenqama ekuThwaseni kweNyanga,","poem":1},{"text":"lalapho inyanga isigcwele, ngelanga lomkhosi;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"lesi yisimemezelo sika-Israyeli,","poem":1},{"text":"umthetho kaNkulunkulu kaJakhobe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wakumisa njengesimiso kuJosefa","poem":1},{"text":"lapho aphuma wavukela ilizwe leGibhithe,","poem":2},{"text":"lapho ezwa khona ulimi esasingaluzwa.","poem":1},{"lineBreak":true},{"text":"Ngezwa ilizwi engingalaziyo lisithi:","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ngawethula umthwalo emahlombe abo;","poem":1},{"text":"izandla zabo zakhululwa engcebethwini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ekuhluphekeni kwenu lamemeza mina ngalikhulula.","poem":1},{"text":"Ngaliphendula ngiphakathi komdumo weyezi;","poem":2},{"lineBreak":true},{"text":"ngalilinga emanzini aseMeribha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zwanini, awu bantu bami, mina ngizalixwayisa","poem":1},{"text":"aluba lingangilalela, Oh Israyeli!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lingabi lonkulunkulu wezizweni phakathi kwenu;","poem":1},{"text":"lingabokhothamela unkulunkulu ongaziwayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"NginguThixo uNkulunkulu wenu,","poem":1},{"text":"owalikhuphayo eGibhithe.","poem":2},{"text":"Vulani kakhulu umlomo wenu ngizawugcwalisa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kodwa abantu bami kabangilalelanga;","poem":1},{"text":"u-Israyeli wala ukungithobela.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngakho ngasengibayekela ngezinhliziyo zabo zobuqholo","poem":1},{"text":"ukuthi balandele lokho abakufunayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Aluba abantu bami bengangilalela,","poem":1},{"text":"aluba u-Israyeli engalandela izindlela zami,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"masinyane nje ngingazibhuqa izitha zabo","poem":1},{"text":"ngiphakamisele isandla sami ezitheni zabo!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Labo abamzondayo uThixo bangatshotshobala phambi kwakhe,","poem":1},{"text":"kuthi isijeziso sabo sibe ngesaphakade.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kodwa lina lingaphiwa ingqoloyi enhle kakhulu;","poem":1},{"text":"ngilisuthise ngoluju oluphuma edwaleni.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}