{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Ihubo lika-Asafi"]},{"type":"verse","number":1,"content":[{"text":"UNkulunkulu usesihlalweni emhlanganweni omkhulu;","poem":1},{"text":"nguye owahlulelayo phakathi kwabo “nkulunkulu”:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Koze kube nini livikela ababi na","poem":1},{"text":"libonakala lithanda izigangi?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lamlelani ababuthakathaka lezintandane;","poem":1},{"text":"melani amalungelo abayanga labahlukuluzwayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lamlelani ababuthakathaka labaswelayo;","poem":1},{"text":"bephuleni esandleni sababi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Onkulunkulu kabazi lutho, kabazwisisi lutho.","poem":1},{"text":"Bayantula emnyameni;","poem":2},{"lineBreak":true},{"text":"zonke izisekelo zomhlaba zixukuxiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngathi, ‘Lingo “nkulunkulu”;","poem":1},{"text":"lonke lingamadodana akhe oPhezukonke.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodwa lizakufa lingabantu nje;","poem":1},{"text":"lizakuwa njengamanye amakhosi wonke.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Phakama, Oh Nkulunkulu, yahlulela umhlaba,","poem":1},{"text":"ngoba zonke izizwe ziyilifa lakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}