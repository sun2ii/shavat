{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["Ingoma. Ihubo lika-Asafi."]},{"type":"verse","number":1,"content":[{"text":"Oh Nkulunkulu, ungathuli uthi zwi;","poem":1},{"text":"ungangincitshi indlebe yakho,","poem":2},{"lineBreak":true},{"text":"ungameli khatshana lami, Oh Nkulunkulu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akubone ukuthi ziphithizela kanjani izitha zakho,","poem":1},{"text":"ukuthi ziwaqaphisa kanganani amakhanda azo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngobuqili zakhela abantu bakho amacebo;","poem":1},{"text":"zisongela labo obathembileyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bathi, “Wozani kasibabhuqe du njengesizwe,","poem":1},{"text":"ukuze ibizo lika-Israyeli lingaphindi likhunjulwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nganhliziyonye bawakha amacebo ndawonye;","poem":1},{"text":"bayahlangana beme ndawonye ukumelana lawe,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"amathente ase-Edomi lama-Ishumayeli,","poem":1},{"text":"awamaMowabi lawamaHagari,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"amaGebhali, lama-Amoni lama-Amaleki,","poem":1},{"text":"amaFilistiya labantu beThire.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lama-Asiriya asebambene labo","poem":1},{"text":"ukuqinisa izizukulwane zikaLothi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yenza kubo njengoba wenza eMidiyani,","poem":1},{"text":"njengowakwenza kuSisera loJabhini emfuleni iKhishoni,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ababhubha e-Endo","poem":1},{"text":"baba njengezibi emhlabathini.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yenza izikhulu zabo zibe njengo-Orebhi loZebhi,","poem":1},{"text":"wonke amakhosana abo abe njengoZebha loZalimuna,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"abathi, “Kasiwathumbe","poem":1},{"text":"amadlelo kaNkulunkulu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Benze babe njengenkunkuma, Oh Nkulunkulu wami,","poem":1},{"text":"njengamakhoba ephetshulwa ngumoya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njengalokhu umlilo uhangula igusu","poem":1},{"text":"kumbe ilangabi lilumathisa izintaba,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kanjalo basukele ngesivunguvungu sakho","poem":1},{"text":"ubethuse ngesiphepho sakho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bahuqe ubuso babo ngehlazo","poem":1},{"text":"ukuze abantu balidinge ibizo lakho, Oh Thixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sengathi bangayangeka lanini badunyazwe;","poem":1},{"text":"kungathi bangafa belehlazo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yenza bakwazi ukuthi wena, obizo lakho unguThixo","poem":1},{"text":"ukuthi wena wedwa ungoPhezukonke emhlabeni wonke.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}