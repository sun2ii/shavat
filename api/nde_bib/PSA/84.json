{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Ngendlela yegithithi. Elabantwana bakaKhora. Ihubo."]},{"type":"verse","number":1,"content":[{"text":"Yeka ubuhle bendlu yakho,","poem":1},{"text":"Oh Thixo Somandla!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Umphefumulo wami uyalangazela, uze ungathi uyaphela,","poem":1},{"text":"ngifuna amaguma kaThixo;","poem":2},{"text":"inhliziyo yami lenyama yami","poem":1},{"text":"kukhalela uNkulunkulu ophilayo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Intaka layo ilizuzile ikhaya,","poem":1},{"text":"lenkonjane isidleke sayo,","poem":2},{"lineBreak":true},{"text":"lapho ingazalela khona abantwana bayo","poem":2},{"text":"indawo eduze kwe-alithari lakho,","poem":1},{"text":"Oh Thixo Somandla, Nkosi yami loNkulunkulu wami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Babusisiwe labo abahlala endlini yakho;","poem":1},{"text":"bahlala bekudumisa kokuphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Babusisiwe labo abalamandla abo akuwe","poem":1},{"text":"asebebeke inhliziyo zabo ekulagiseni kuwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bathi nxa bedabula esiGodini seBhaka","poem":1},{"text":"basenze sibe yindawo yemithombo;","poem":2},{"lineBreak":true},{"text":"izulu lekwindla lalo ligcwalise iziziba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ayakhula amandla abo ande,","poem":1},{"text":"ngulowo lalowo aze aqhamuke kuNkulunkulu eZiyoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Zwana umkhuleko wami, Oh Thixo Nkulunkulu Somandla;","poem":1},{"text":"akungilalele, Oh Nkulunkulu kaJakhobe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Khangela isihlangu sethu, Oh Nkulunkulu;","poem":1},{"text":"khangela ngomusa kogcotshiweyo wakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lungcono usuku olulodwa emagumeni akho","poem":1},{"text":"kulensuku eziyinkulungwane kwenye indawo;","poem":2},{"text":"kungabangcono ngibe ngumlindimasango endlini kaNkulunkulu","poem":1},{"text":"kulokuhlala emathenteni ababi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngoba uThixo ulilanga lesihlangu;","poem":1},{"text":"uThixo uyapha umusa lodumo;","poem":2},{"text":"kancitshani langaluphi ulutho oluhle","poem":1},{"text":"kulabo ozinyathelo zabo zingelansolo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Oh Thixo Somandla,","poem":1},{"text":"ubusisiwe umuntu owethemba kuwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}