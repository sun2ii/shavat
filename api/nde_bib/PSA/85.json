{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabela. Elamadodana kaKhora. Ihubo."]},{"type":"verse","number":1,"content":[{"text":"Ulithandile ilizwe lakho, Oh Thixo;","poem":1},{"text":"uyibuyisile inhlanhla kaJakhobe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wazithethelela iziphambeko zabantu bakho","poem":1},{"text":"wazisibekela zonke izono zabo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Walubuyisela eceleni lonke ulaka lwakho","poem":1},{"text":"wakufulathela ukuthukuthela kwakho okwesabekayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sivuselele njalo, Oh Nkulunkulu Msindisi wethu,","poem":1},{"text":"ukubeke khatshana ukukucunula kwethu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uzasizondela kuze kube phakade na?","poem":1},{"text":"Uzalugcina ulaka lwakho kuzozonke izizukulwane na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kawuzukusivuselela na,","poem":1},{"text":"ukuze abantu bakho bathokoze kuwe?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sitshengise uthando lwakho olungaphuthiyo, Oh Thixo,","poem":1},{"text":"usinike insindiso yakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngizalalela lokho uNkulunkulu uThixo azakutsho;","poem":1},{"text":"uthembisa abantu bakhe ukuthula, abangcwele bakhe","poem":2},{"lineBreak":true},{"text":"kodwa kabangabuyeli ebufebeni babo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngempela insindiso iseduze kulabo abamesabayo,","poem":1},{"text":"ukuze inkazimulo yakhe ihlale elizweni lethu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Uthando lokuthembeka kuyahlangana ndawonye;","poem":1},{"text":"ukulunga lokuthula kuyangana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ukuthembeka kuqhamuka emhlabathini,","poem":1},{"text":"ukulunga kukhanya phansi kusezulwini.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngeqiniso uThixo uzanika okulungileyo,","poem":1},{"text":"lelizwe lethu lizathela isivuno salo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ukulunga kuhamba phambi kwakhe","poem":1},{"text":"kulungisele izinyathelo zakhe indlela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}