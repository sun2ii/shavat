{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"hebrew_subtitle","content":["Umkhuleko kaDavida"]},{"type":"verse","number":1,"content":[{"text":"Zwana, Oh Thixo, ungiphendule,","poem":1},{"text":"ngoba ngingumyanga ngiyaswela.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vikela impilo yami, ngoba ngizinikele kuwe;","poem":1},{"text":"sindisa inceku yakho ekuthembayo;","poem":2},{"text":"UnguNkulunkulu wami.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Woba lesihawu kimi, Oh Thixo,","poem":2},{"lineBreak":true},{"text":"ngoba ngitshona ngikubiza ilanga lonke.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Letha ukuthokoza encekwini yakho,","poem":1},{"text":"ngoba kuwe, Oh Thixo,","poem":2},{"lineBreak":true},{"text":"ngiphakamisela umphefumulo wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Uyathethelela njalo ulungile, Oh Thixo,","poem":1},{"text":"ugcwele uthando kulabo abakhuleka kuwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zwana umkhuleko wami, Oh Thixo;","poem":1},{"text":"lalela ukukhala kwami ngicela umusa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mhla ngiphakathi kokuhlupheka ngizakhala kuwe,","poem":1},{"text":"ngoba uzangiphendula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Phakathi kwabonkulunkulu kakho onjengawe, Oh Thixo;","poem":1},{"text":"kakulazenzo ezingalinganiswa lezakho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zonke izizwe owazenzayo","poem":1},{"text":"zizakuza zikhonze kuwe, Nkosi;","poem":2},{"lineBreak":true},{"text":"zizaletha udumo ebizweni lakho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngoba umkhulu njalo wenza imisebenzi emangalisayo;","poem":1},{"text":"wena wedwa unguNkulunkulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ngifundisa indlela yakho, Oh Thixo,","poem":1},{"text":"ukuze ngihambe eqinisweni lakho;","poem":2},{"text":"ngipha inhliziyo engaxamalazanga,","poem":1},{"text":"ukuze ngilesabe ibizo lakho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngizakudumisa, Nkosi Nkulunkulu wami,","poem":1},{"text":"ngenhliziyo yami yonke;","poem":2},{"lineBreak":true},{"text":"ngizalidumisa ibizo lakho laphakade.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngoba lukhulu uthando lwakho kimi;","poem":1},{"text":"ungenyule ekujuleni kwendawo yabafileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Iziqholo ziyangihlasela, Oh Nkulunkulu","poem":1},{"text":"iqembu lamadoda alesihluku lizingela impilo yami","poem":2},{"lineBreak":true},{"text":"abantu abangakunanziyo wena.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kodwa wena, Nkosi, unguNkulunkulu olozwelo, olobubelo,","poem":1},{"text":"ophuza ukuzonda, owandayo ngothando lokuthembeka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Phendukela ngakimi ube lesihawu kimi;","poem":1},{"text":"veza amandla akho ngenceku yakho,","poem":2},{"text":"ngisindise ngoba ngiyakukhonza,","poem":1},{"text":"njengokwenziwa ngumama.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngipha isiboniso sokulunga kwakho,","poem":1},{"text":"ukuze izitha zami zisibone ziyangeke,","poem":2},{"lineBreak":true},{"text":"ngoba wena, Oh Thixo, usungisizile njalo wangiduduza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}