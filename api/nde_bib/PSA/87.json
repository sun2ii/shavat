{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Elamadodana kaKhora. Ihubo. Ingoma."]},{"type":"verse","number":1,"content":[{"text":"Usakhile isisekelo sakhe entabeni engcwele;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"uThixo uyawathanda amasango eZiyoni","poem":1},{"text":"okudlula yonke imizi kaJakhobe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Izinto ezinhle okumangalisayo ziyatshiwo ngawe,","poem":1},{"text":"we muzi kaNkulunkulu:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ngizabalisa uRahabi leBhabhiloni","poem":1},{"text":"phakathi kwalabo abathi bayangazi","poem":2},{"text":"iFilistiya leThire, kanye leKhushi","poem":1},{"text":"ngibe sengisithi, ‘Lo wazalelwa eZiyoni.’ ”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngempela kuzathiwa ngeZiyoni,","poem":1},{"text":"“Lo laloyana bazalelwa khona,","poem":2},{"lineBreak":true},{"text":"kuthi yena oPhezukonke uzaliqinisa.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"UThixo uzaloba eluhlwini lwamabizo abantu:","poem":1},{"text":"“Lo wazalelwa eZiyoni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bazakuthi betshaya amachacho bahlabele bathi,","poem":1},{"text":"“Yonke imithombo yami ikuwe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}