{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"hebrew_subtitle","content":["Ingoma. Ihubo lamadodana kaKhora. Kumqondisi wokuhlabela. Itshuni ethi, Mahalathi leyanothi (Ukuhlupheka lokuchukuluzwa) Ihubo likaHemani umʼEzira."]},{"type":"verse","number":1,"content":[{"text":"Oh Thixo, Nkulunkulu ongisindisayo,","poem":1},{"text":"ebusuku lemini ngikhala kuwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akuthi umkhuleko wami ufinyelele kuwe;","poem":1},{"text":"phendula indlebe yakho izwe ukukhala kwami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngoba umphefumulo wami ugcwele inhlupheko","poem":1},{"text":"lempilo yami isilengela engcwabeni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngibalwa ndawonye lalabo asebesiya egodini;","poem":1},{"text":"senginjengendoda engelamandla.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sengahlukaniselwe kwabafileyo,","poem":1},{"text":"lezidumbu ezilele engcwabeni,","poem":2},{"text":"wena ongasabakhumbuliyo njalo,","poem":1},{"text":"abangasekho kulabo obanakekelayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Usungifake egodini elitshona okudlulayo,","poem":1},{"text":"ekujuleni okumnyama bhuqe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Intukuthelo yakho iyangeleka;","poem":1},{"text":"usungigalulisile ngawo wonke amagagasi akho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Usungithathele abangane bami abasekhwapheni","poem":1},{"text":"wangenza ngaba lesidina kubo.","poem":2},{"text":"Ngivalelwe kangiselantuba;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"amehlo ami asebona kalufifi ngenxa yosizi.","poem":2},{"lineBreak":true},{"text":"Ngiyakubiza, Oh Thixo, insuku zonke;","poem":1},{"text":"ngiphakamisela izandla zami kuwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Izimanga zakho uyazitshengisa kwabafileyo na?","poem":1},{"text":"Kambe labo asebefile bangavuka bakudumise na?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uthando lwakho luyamenyezelwa engcwabeni yini,","poem":1},{"text":"ukuthembeka kwakho endaweni yokuBhubha na?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Izimanga zakho ziyaziwa yini endaweni yobumnyama,","poem":1},{"text":"kumbe izenzo zakho zokulunga elizweni lokungabikho na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kodwa ngikhala kuwe ngoncedo, Oh Thixo;","poem":1},{"text":"ekuseni umkhuleko wami uyafika kuwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kungani, awu Thixo, ungifulathela","poem":1},{"text":"ungifihlela ubuso bakho?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kusukela ebutsheni bami ngavele ngahlupheka ngaba seduze lokufa;","poem":1},{"text":"ngiphethwe yikwesatshiswa nguwe, sengize ngidangele.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Intukuthelo yakho isingigabhele;","poem":1},{"text":"ukwesaba wena sekungiqedile.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ilanga lonke kungihanqile njengesikhukhula;","poem":1},{"text":"sekungigalulisa nya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Usungithathele abakhula bami lengibathandayo;","poem":1},{"text":"ubumnyama sebunguyena mngane wami oseduze.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}