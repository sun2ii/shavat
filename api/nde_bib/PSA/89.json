{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"hebrew_subtitle","content":["Ihubo lika-Ethani umEzira"]},{"type":"verse","number":1,"content":[{"text":"Ngizahlabelela ngothando lukaThixo olukhulu lanininini;","poem":1},{"text":"ngomlomo wami ngizakwenza ukuthembeka kwakho kwaziwe","poem":2},{"lineBreak":true},{"text":"ezizukulwaneni zonke.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngizamemezela ukuthi uthando lwakho lumi luqinile laphakade,","poem":1},{"text":"ukuthi ukuthembeka kwakho wakugxilisa ezulwini uqobo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wathi, “Sengenze isivumelwano lalowo okhethiweyo wami,","poem":1},{"text":"sengifungile kuDavida inceku yami,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘Ngizawumisa umndeni wakho laphakade,","poem":1},{"text":"ngisiqinise isihlalo sakho sobukhosi","poem":2},{"lineBreak":true},{"text":"kuzozonke izizukulwane.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Amazulu ayazidumisa izimanga zakho, Oh Thixo,","poem":1},{"text":"lokuthembeka kwakho emhlanganweni wabangcwele.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Phela ngubani onjengoThixo phakathi kwabaphilayo ezulwini na?","poem":1},{"text":"Ngubani onjengoThixo phakathi kwabaphilayo ezulwini na?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enhlanganisweni yabangcwele uNkulunkulu uyesatshwa kakhulu;","poem":1},{"text":"uyesabeka kulabo bonke abahlezi laye.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yebo Thixo Nkulunkulu Somandla, ngubani onjengawe na?","poem":1},{"text":"Ulamandla, Oh Thixo, ukuthembeka kwakho kukuhonqolozele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uyabusa phezu kolwandle olugubhazelayo;","poem":1},{"text":"lapho amavinqo alo equbuka, uyawathulisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wamchoboza uRahabi njengomunye wababuleweyo;","poem":1},{"text":"ngengalo yakho elamandla wazichitha izitha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngawakho amazulu, ngowakho njalo lomhlaba;","poem":1},{"text":"wawudala umhlaba lakho konke okukuwo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wayidala inyakatho kanye leningizimu;","poem":1},{"text":"iThabhori leHemoni zihlabelela ibizo lakho ngentokozo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ingalo yakho igcwele amandla;","poem":1},{"text":"isandla sakho siqinile, esokunene siphakeme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ukulunga lokwahlulela kuhle yikho okuyinsika yesihlalo sakho sobukhosi;","poem":1},{"text":"uthando lokuthembeka kuhamba phambili kwakho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Babusisiwe labo asebekufundile ukukubabaza,","poem":1},{"text":"abahamba ekukhanyeni kobukhona bakho, Oh Thixo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bayathokoza ngebizo lakho ilanga lonke;","poem":1},{"text":"bayagubhazela ngokulunga kwakho.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngoba uyibukhosi babo lamandla abo,","poem":1},{"text":"kuthi ngomusa wakho uphakamise uphondo lwethu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngempela isihlangu sethu ngesikaThixo, iNkosi yethu","poem":1},{"text":"Kuye oYedwa oNgcwele ka-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Endulo wakhuluma ngombono,","poem":1},{"text":"ebantwini bakho abathembekileyo wathi:","poem":2},{"text":"“Sengiwehlisele amandla phezu kweqhawe;","poem":1},{"text":"sengiphakamise insizwa phakathi kwabantu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sengifumane uDavida inceku yami;","poem":1},{"text":"ngamafutha ami angcwele sengimgcobile.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isandla sami sizamsekela;","poem":1},{"text":"ngempela ingalo yami izamqinisa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Akulasitha esizamncindezela ukuthi athele kuso;","poem":1},{"text":"kakho umuntu omubi ozamcindezela.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngizazichoboza izitha zakhe phambi kwakhe","poem":1},{"text":"ngibalahlele phansi abalwa laye.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Uthando lwami oluthembekileyo luzaba laye,","poem":1},{"text":"ukuthi ngebizo lami luphakanyiswe uphondo lwakhe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngizabeka isandla sakhe phezu kolwandle,","poem":1},{"text":"isandla sakhe sokunene phezu kwemifula.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Uzamemeza kimi athi, ‘UnguBaba,","poem":1},{"text":"Nkulunkulu wami, iDwala elinguMsindisi wami.’","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Njalo ngizamisa abe lizibulo lami,","poem":1},{"text":"inkosi ephakeme ngaphezu kwawo wonke amakhosi omhlaba.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ngizalugcina uthando lwami kuye laphakade,","poem":1},{"text":"lesivumelwano sami laye kasiyikuphela.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Inzalo yakhe ngizayimisa nini lanini,","poem":1},{"text":"lesihlalo sakhe sobukhosi kasiyikufa saphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Aluba amadodana akhe edela umlayo wami","poem":1},{"text":"angalandeli izimiso zami,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"nxa besephula izimemezelo zami","poem":1},{"text":"behluleke ukugcina imiyalo yami,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ngizajezisa isono sabo ngoswazi,","poem":1},{"text":"lesiphambeko sabo ngokubatshaya;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"kodwa kangiyikulususa uthando lwami kuye,","poem":1},{"text":"njalo kangisoze ngiguqule ukuthembeka kwami.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kangiyikusephula isivumelwano sami","poem":1},{"text":"kumbe ngiguqule lokho okuphume ezindebeni zami.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ngavele ngafunga kanye ngobungcwele bami","poem":1},{"text":"angiyikuqamba amanga kuDavida,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ukuthi inzalo yakhe izaqhubeka laphakade","poem":1},{"text":"lesihlalo sakhe sobukhosi sizakuma phambi kwami njengelanga;","poem":2}]},{"type":"verse","number":37,"content":[{"text":"sizakuma laphakade njengenyanga,","poem":1},{"text":"ufakazi othembekileyo yisibhakabhaka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Kodwa usumalile, usumlahlile,","poem":1},{"text":"ubumthukuthelela kakhulu ogcotshiweyo wakho.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ususikhalele isivumelwano lenceku yakho","poem":1},{"text":"wawubhuqela othulini umqhele wakhe.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Usuyibhidlizile yonke imiduli yakhe,","poem":1},{"text":"izinqaba zakhe wazenza amanxiwa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Bonke abedlula khona bamphangile;","poem":1},{"text":"useyinhlekisa yabomakhelwane.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Usuphakamisile isandla sokunene sezitha zakhe;","poem":1},{"text":"usuwenze zonke izitha zakhe zathokoza.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Uyibuyisele emuva inkemba yakhe ebukhali","poem":1},{"text":"awaze wamsekela empini.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Usuyiqedile inkazimulo yakhe","poem":1},{"text":"wadilizela phansi isihlalo sakhe sobukhosi.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Uluqumile lwaba lufitshane usuku lobutsha bakhe;","poem":1},{"text":"usumembese ingubo yehlazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Koze kube nini, Oh Thixo? Uzazifihla kokuphela na?","poem":1},{"text":"Koze kube nini ulaka lwakho luvutha njengomlilo?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Khumbula ukwedlula masinyane kwempilo yami.","poem":1},{"text":"Ngoba wabadalela ize nje abantu!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ngumuntu bani ongaphila angaze abona ukufa,","poem":1},{"text":"loba azisindise emandleni eliba na?","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Oh Thixo, lungaphi uthando lwakho lwakudala olukhulu,","poem":1},{"text":"okwathi ngokuthembeka kwakho wafunga ngalo kuDavida?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Khumbula, Thixo ukuthi inceku yakho iklolodelwa njani,","poem":1},{"text":"ukuthi enhliziyweni yami ngithwele izigcono zezizwe,","poem":2}]},{"type":"verse","number":51,"content":[{"text":"izigcono izitha zakho eziklolode ngazo, Oh Thixo,","poem":1},{"text":"okuthe ngazo zaklolodela ogcotshiweyo wakho kukho konke akwenzayo.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Udumo kalube kuThixo laphakade!","poem":1},"Ameni njalo Ameni."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}