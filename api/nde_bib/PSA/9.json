{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"hebrew_subtitle","content":["Kumqondisi wokuhlabelela. Ihlatshelwa njengengoma ethi “Ukufa kweNdodana.” Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Ngizakudumisa, Oh Thixo, ngenhliziyo yami yonke;","poem":1},{"text":"ngizafakaza ngazozonke izimangaliso zakho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngizathokoza ngijabule ngawe,","poem":1},{"text":"ngizahlabelela indumiso egameni lakho,","poem":2},{"lineBreak":true},{"text":"wena oPhezukonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Izitha zami ziyafulathela zibaleke;","poem":1},{"text":"ziyakhubeka zitshabalale phambi kwakho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoba ulisekele ilungelo lami;","poem":1},{"text":"usuhlalile esihlalweni sakho sobukhosi","poem":2},{"lineBreak":true},{"text":"wahlulela kakuhle.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uzikhuzile izizwe,","poem":1},{"text":"wababhubhisa ababi;","poem":2},{"text":"wawesula amabizo abo","poem":1},{"text":"kuze kube nini lanini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ukubhidlika okungapheliyo kusehlele isitha sami,","poem":1},{"text":"wawasiphuna amadolobho aso;","poem":2},{"lineBreak":true},{"text":"lokukhunjulwa kwaso sekuphele nya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"UThixo uyabusa kuze kube nininini;","poem":1},{"text":"usesimisile isihlalo sakhe sobukhosi ukuze ahlulele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uzabusa umhlaba ngokulunga","poem":1},{"text":"njalo uzakwahlulela abantu ngokufaneleyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"UThixo uyisiphephelo sabancindezelweyo,","poem":1},{"text":"uyinqaba ezikhathini zokuhlupheka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Labo abalaziyo ibizo lakho bazathemba kuwe,","poem":1},{"text":"ngoba wena, Thixo, kawubafulatheli abakudingayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hlabelelani indumiso kuThixo esebukhosini eZiyoni;","poem":1},{"text":"fakazani phakathi kwezizwe","poem":2},{"lineBreak":true},{"text":"ngalokho akwenzileyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngoba yena ophindiselayo kulowo ochitha igazi uyakhumbula;","poem":1},{"text":"akakudeli ukukhala kwabahlukuluzwayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Oh Thixo, ake ubone ukuthi izitha zami zingichukuluza njani!","poem":1},{"text":"Yiba lesihawu ungenyule emasangweni okufa,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ukuze ngifakaze indumiso yakho","poem":1},{"text":"emasangweni eNdodakazi yaseZiyoni","poem":2},{"text":"kuthi khonale ngithokoze","poem":1},{"text":"ngokusindisa kwakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Izizwe ziwele emgodini eziwumbileyo;","poem":1},{"text":"inyawo zazo zibanjwe emambuleni eziwathiyileyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"UThixo waziwa ngokwahlulela kwakhe okulungileyo;","poem":1},{"text":"ababi babanjwa yizenzo zezandla zabo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ababi babuyela engcwabeni,","poem":1},{"text":"zonke izizwe ezikhohlwa uNkulunkulu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kodwa abaswelayo kabayikukhohlakala kokuphela,","poem":1},{"text":"njalo lethemba labahlukuluzwayo kaliyikutshabalala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Vuka Thixo, ungayekeli umuntu anqobe;","poem":1},{"text":"akuthi izizwe zahlulelwe phambi kwakho.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Batshayise ngovalo, Oh Thixo;","poem":1},{"text":"akuthi izizwe zikwazi ukuthi zingabantu nje.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}