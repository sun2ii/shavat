{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"hebrew_subtitle","content":["Umkhuleko kaMosi umuntu kaNkulunkulu."]},{"type":"verse","number":1,"content":[{"text":"Thixo, wena ulikhaya lethu","poem":1},{"text":"kuzozonke izizukulwane.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Izintaba zingakabikhona","poem":1},{"text":"lalapho ungakawuvezi umhlaba kanye lelizwe,","poem":2},{"lineBreak":true},{"text":"kusukela phakade kuze kube phakade unguNkulunkulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ubuyisela abantu ethulini,","poem":1},{"text":"usithi, “Buyelani othulini, lina madodana abantu.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoba iminyaka eyinkulungwane ekuboneni kwakho","poem":1},{"text":"injengosuku olusanda kudlula,","poem":2},{"lineBreak":true},{"text":"kumbe njengomlindo webusuku.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uyabakhucula abantu ebuthongweni bokufa;","poem":1},{"text":"banjengotshani obutsha obekuseni","poem":2}]},{"type":"verse","number":6,"content":[{"text":"lokuba ekuseni buhluma bubutsha,","poem":1},{"text":"kuthi ntambama sebomile sebubunile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ulaka lwakho luyasitshabalalisa","poem":1},{"text":"sithuthumeliswe yikucaphuka kwakho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Usubuchayile ububi bethu phambi kwakho,","poem":1},{"text":"izono zethu zensitha wazichaya ekukhanyeni kobukhona bakho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zonke insuku zethu ziyedlula ngaphansi kolaka lwakho;","poem":1},{"text":"leminyaka yethu siyiphetha ngokububula.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ubude bezinsuku zethu buyiminyaka engamatshumi ayisikhombisa","poem":1},{"text":"loba amatshumi ayisificaminwembili, nxa silamandla;","poem":2},{"text":"kanti lelobanga layo liluhlupho losizi,","poem":1},{"text":"ngoba iphanga yedlule, lathi siphaphe nje sedlule.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngubani owaziyo amandla olaka lwakho na?","poem":1},{"text":"Ngoba intukuthelo yakho inkulu njengokwesatshwa okukufaneleyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sifundise ukubala kuhle insuku zethu,","poem":1},{"text":"ukuze sizuze inhliziyo yenhlakanipho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Phola, Oh Thixo! Koze kube nini kulokhu kunjalo na?","poem":1},{"text":"Woba lesihawu ezincekwini zakho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sisuthise ekuseni ngothando lwakho olungaphuthiyo,","poem":1},{"text":"ukuze sihlabelele ngentokozo sijabule zonke insuku zethu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Senze sijabule okwensuku ezilingana ukusihlupha kwakho,","poem":1},{"text":"okwensuku ezilingana lalezo esesabona ngazo ukudubeka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sengathi imisebenzi yakho ingatshengiswa ezincekwini zakho,","poem":1},{"text":"inkazimulo yakho ebantwaneni babo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sengathi umusa weNkosi uNkulunkulu wethu ungehlela kithi;","poem":1},{"text":"uqinise umsebenzi wezandla zethu","poem":2},{"lineBreak":true},{"text":"yebo, qinisa umsebenzi wezandla zethu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}