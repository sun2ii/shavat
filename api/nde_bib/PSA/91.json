{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"Lowo ohlala ekusithekeni koPhezukonke","poem":1},{"text":"uzaphumula emthunzini kaSomandla.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngizakuthi kuThixo, “Uyisiphephelo sami lenqaba yami,","poem":1},{"text":"uNkulunkulu wami, engithemba kuye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngempela uzakuphephisa","poem":1},{"text":"emjibileni womthiyi","poem":2},{"lineBreak":true},{"text":"lasesifeni esibi esibulalayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uzakusibekela ngezinsiba zakhe,","poem":1},{"text":"uzuze isiphephelo ngaphansi kwamaphiko akhe;","poem":2},{"lineBreak":true},{"text":"ukuthembeka kwakhe kuzakuba yisihlangu sakho lenqaba yakho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Awuyikwesaba umnyama wobusuku,","poem":1},{"text":"loba umtshoko ontweza emini,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kumbe ingozi ehahabela emnyameni,","poem":1},{"text":"kumbe umkhuhlane obhubhisayo emini enkulu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abazinkulungwane bangawa eceleni lakho;","poem":1},{"text":"itshumi lezinkulungwane esandleni sakho sokunene,","poem":2},{"lineBreak":true},{"text":"kodwa kakusoze kusondele kuwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uzaphosa nje amehlo akho","poem":1},{"text":"ubukele ubone ukujeziswa kwababi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ungenza oPhezukonke abe likhaya lakho","poem":1},{"text":"yena uThixo oyisiphephelo sami","poem":2}]},{"type":"verse","number":10,"content":[{"text":"lapho-ke akulangozi engakuwela,","poem":1},{"text":"akulamonakalo ozasondela ethenteni lakho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngoba uzayala izingilosi zakhe ngawe","poem":1},{"text":"zikulinde kuzozonke izindlela zakho;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"zizakuphakamisa ezandleni zazo,","poem":1},{"text":"ukuze ungakhubeki elitsheni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uzanyathela isilwane lephimpi;","poem":1},{"text":"uzasigxoba isilwane esikhulu lenyoka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ngoba uyangithanda,” kutsho uThixo, “ngizamkhulula;","poem":1},{"text":"ngizamvikela, ngoba uyalinaka ibizo lami.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uzangibiza, ngimphendule;","poem":1},{"text":"ngizakuba laye ekuhluphekeni,","poem":2},{"lineBreak":true},{"text":"ngizamkhulula ngimenzele udumo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngizamsuthisa ngempilo ende","poem":1},{"text":"ngimtshengise insindiso yami.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}