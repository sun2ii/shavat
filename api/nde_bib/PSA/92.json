{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["Ihubo. Ingoma. Elosuku lweSabatha."]},{"type":"verse","number":1,"content":[{"text":"Kuhle ukudumisa uThixo","poem":1},{"text":"lokuhlabelela ebizweni lakho, wena oPhezukonke,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ukumemezela uthando lwakho ekuseni","poem":1},{"text":"lokuthembeka kwakho ebusuku,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ukutshaya iziginci ngomhubhe wezintambo ezilitshumi","poem":1},{"text":"lemvungamo emnandi yechacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngoba uyangijabulisa ngezenzo zakho, Oh Thixo;","poem":1},{"text":"ngihlala ngentokozo ngomsebenzi wezandla zakho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mikhulu kangaka imisebenzi yakho, Oh Thixo,","poem":1},{"text":"izikile imicabango yakho!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Umuntu ongelangqondo akazi,","poem":1},{"text":"iziwula kazizwisisi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ukuthi loba ababi bemila njengotshani","poem":1},{"text":"lezigangi zonke ziphumelela,","poem":2},{"lineBreak":true},{"text":"zizabhujiswa nini lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kodwa wena Thixo, uphakeme laphakade.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngoba ngempela izitha zakho, Oh Thixo,","poem":1},{"text":"ngempela izitha zakho zizabhubha;","poem":2},{"lineBreak":true},{"text":"zonke izigangi zizachithizwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uluphakamisile uphondo lwami njengolwenyathi;","poem":1},{"text":"ngagcotshwa ngamakha amnandi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amehlo ami abonile ukwehlulwa kwezitha zami;","poem":1},{"text":"indlebe zami zizwile ngokuchithizwa kwezitha zami ezimbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Abalungileyo bazaqhela njengesihlahla selala,","poem":1},{"text":"bazakhula njengomsedari waseLebhanoni;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ngoba behlanyelwe endlini kaThixo,","poem":1},{"text":"bazaqhela emagumeni kaNkulunkulu wethu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bazabe belokhu bethela izithelo lanxa sebebadala,","poem":1},{"text":"bazahlala belokhu behluma beluhlaza,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"bememezela besithi, “UThixo uqotho;","poem":1},{"text":"uliDwala lami, kakukho bubi kuye.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}