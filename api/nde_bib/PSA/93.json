{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"UThixo uyabusa, ugqoke ubukhosi;","poem":1},{"text":"uThixo ugqoke ubukhosi njalo uzihlome ngamandla.","poem":2},{"lineBreak":true},{"text":"Umhlaba ugxilile uqinile; ngeke ugudlulwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isihlalo sakho saqiniswa ekadeni;","poem":1},{"text":"uNguwe kusukela phakade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Inlwandle seziphakamisile, Oh Thixo,","poem":1},{"text":"inlwandle ziliphakamisile ilizwi lazo;","poem":2},{"lineBreak":true},{"text":"inlwandle ziwaphakamisile amagagasi azo agubhuzelayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngamandla adlula umdumo wamanzi amanengi,","poem":1},{"text":"ngamandla adlula awokugubhuza kolwandle","poem":2},{"lineBreak":true},{"text":"uThixo ophezulu ulamandla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Izimiso zakhe zimi ziqinile;","poem":1},{"text":"ubungcwele bukhazimulisa indlu Yakho","poem":2},{"lineBreak":true},{"text":"okwensuku ezingapheliyo, Oh Thixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}