{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"Oh Thixo, uNkulunkulu ophindiselayo,","poem":1},{"text":"Oh Nkulunkulu ophindiselayo, khanya uvele.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Phakama, awu Mahluli womhlaba;","poem":1},{"text":"baphindisele abazigqajayo ngokubafaneleyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Koze kube nini ababi, Oh Thixo,","poem":1},{"text":"koze kube nini ababi beklamasa na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bathulula amazwi okukloloda;","poem":1},{"text":"zonke izigangi zifuthelene ngokuzikhukhumeza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ziyabanyathezela abantu bakho, Oh Thixo;","poem":1},{"text":"zincindezela ilifa lakho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zibulala umfelokazi kanye lowezizweni;","poem":1},{"text":"zibulala intandane.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zithi, “UThixo kaboni;","poem":1},{"text":"uNkulunkulu kaJakhobe kananzi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Limukani, lina elingelangqondo phakathi kwabantu;","poem":1},{"text":"lina ziphukuphuku, lizahlakanipha nini?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yena lowo owayigxumekayo indlebe kezwa yini?","poem":1},{"text":"Yena lowo owabumba ilihlo kaboni na?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yena lowo oqondisa izizwe kajezisi yini?","poem":1},{"text":"Yena lowo ofundisa umuntu kalalwazi na?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"UThixo uyayazi imicabango yomuntu;","poem":1},{"text":"uyayazi ukuthi iyize nje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ubusisiwe umuntu omqondisayo, Oh Thixo,","poem":1},{"text":"umuntu omfundisa okomthetho wakho;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"uyamphumuza ensukwini zokuhlupheka,","poem":1},{"text":"kuze kuthi ababi bembelwe igodi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngoba uThixo kazukwala abantu bakhe;","poem":1},{"text":"kasoze lanini afulathele ilifa lakhe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ukwahlulela kuzaphinda njalo kumiswe ngokulunga,","poem":1},{"text":"kuthi bonke abaqotho ngenhliziyo bakulandele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ngubani ozangimela ekulweni lababi na?","poem":1},{"text":"Ngubani ozangelekelela ekulweni lezigangi na?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aluba uThixo wayengangelulekanga,","poem":1},{"text":"ngabe ngahle ngahlala ngathula zwi ekufeni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lapho ngasengisithi, “Unyawo lwami selutshelela,”","poem":1},{"text":"uthando lwakho, Oh Thixo, lwangisekela.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nxa ukunqineka kwase kungikhulela,","poem":1},{"text":"induduzo yakho yaletha intokozo emphefumulweni wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kambe isihlalo sobukhosi esixhwalileyo singema lawe yini","poem":1},{"text":"leso esiletha inhlupheko ngezimemezelo zaso?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bayahlangana ukumelana labalungileyo","poem":1},{"text":"ongelacala agwetshelwe ukufa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kodwa uThixo useyinqaba yami,","poem":1},{"text":"loNkulunkulu wami ulidwala engiphephela kulo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Uzabaphindisela ngenxa yezono zabo","poem":1},{"text":"ababhubhise ngenxa yobubi babo;","poem":2},{"lineBreak":true},{"text":"uThixo uNkulunkulu wethu uzababhubhisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}