{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Wozani sihlabelele ngentokozo kuThixo;","poem":1},{"text":"kasihlokomeni kamnandi kulo iDwala lokusindiswa kwethu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kasizeni phambi kwakhe ngokubonga","poem":1},{"text":"simdumise ngamachacho langengoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngoba uThixo unguNkulunkulu omkhulu,","poem":1},{"text":"iNkosi enkulu ngaphezu kwabonkulunkulu bonke.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inziki zomhlaba zisezandleni zakhe,","poem":1},{"text":"leziqongo zezintaba ngezakhe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngolwakhe ulwandle ngoba walwenza,","poem":1},{"text":"lezandla zakhe zawenza umhlaba owomileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wozani, kasikhothame simkhonze,","poem":1},{"text":"kasiguqe phambi kukaThixo uMenzi wethu;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ngoba unguNkulunkulu wethu,","poem":1},{"text":"thina singabantu bedlelo lakhe,","poem":2},{"lineBreak":true},{"text":"umhlambi awunakekelayo.","poem":2},{"lineBreak":true},{"text":"Lamhla, nxa lisizwa ilizwi lakhe,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"lingazenzi lukhuni inhliziyo zenu njengoba lenzenjalo eMeribha,","poem":1},{"text":"njengelakwenza ngaleliyana ilanga eMasa enkangala,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"lapho okhokho benu abangilinga khona","poem":1},{"text":"bengizama, lanxa babekubonile engakwenzayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Okweminyaka engamatshumi amane ngangisizondele lesosizukulwane;","poem":1},{"text":"ngathi, “Bangabantu onhliziyo zabo ziyahlanhlatha,","poem":2},{"lineBreak":true},{"text":"njalo kabazazanga izindlela zami.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngakho ngamemezela ngesifungo ekuthukutheleni kwami","poem":1},{"text":"ngathi, “Kabayikungena ekuphumuleni kwami.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}