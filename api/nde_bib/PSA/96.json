{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"Hlabelani kuThixo ingoma entsha;","poem":1},{"text":"hlabelani kuThixo mhlaba wonke.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hlabelani kuThixo, dumisani ibizo lakhe;","poem":1},{"text":"memezelani insindiso yakhe insuku ngezinsuku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Fakazani ngobukhosi bakhe ezizweni zonke,","poem":1},{"text":"lemisebenzi yakhe emangalisayo phakathi kwabantu bonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngoba umkhulu uThixo, ufanele ukudunyiswa ngokuphindiweyo;","poem":1},{"text":"kumele esatshwe ngaphezu kwabonkulunkulu bonke.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngoba bonke onkulunkulu bezizwe bayizithombe,","poem":1},{"text":"kodwa uThixo wadala amazulu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inkazimulo lobukhosi kuphambi Kwakhe;","poem":1},{"text":"amandla lobukhosi kusendlini yakhe engcwele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mnikeni uThixo, lina zizukulwane zezizwe.","poem":1},{"text":"Mnikeni uThixo ubukhosi lamandla.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mnikeni uThixo udumo olufanele ibizo lakhe.","poem":1},{"text":"Lethani umnikelo libuye phambi kwakhe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mkhonzeni uThixo enkazimulweni yobungcwele bakhe;","poem":1},{"text":"thuthumelani phambi kwakhe mhlaba wonke.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wothini phakathi kwezizwe, “UThixo uyabusa.”","poem":1},{"text":"Umhlaba ugxilile, ungeke wagudluzwa;","poem":2},{"lineBreak":true},{"text":"uzabehlulela abantu ngokubafaneleyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Amazulu kawathokoze, lomhlaba ujabule;","poem":1},{"text":"ulwandle kaluhlokome, lakho konke okukulo;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"amasimu kawathakazelele lakho konke okukuwo.","poem":1},{"text":"Lapho-ke izihlahla zonke zeganga zizahlabela ngentokozo;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"phambi kukaThixo, ngoba uyeza,","poem":1},{"text":"uyeza ukuzakwahlulela umhlaba.","poem":2},{"text":"Uzakwahlulela umhlaba ngokulunga,","poem":1},{"text":"ahlulele abantu ngeqiniso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}