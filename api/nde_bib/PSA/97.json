{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"UThixo uyabusa, umhlaba kawuthokoze;","poem":1},{"text":"akuthi amakhumbi akude ajabule.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amayezi lomnyama omkhulu kumsibekele;","poem":1},{"text":"ukulunga lokwahlulela kuhle kuyisisekelo sesihlalo Sakhe sobukhosi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Umlilo uhamba phambi Kwakhe","poem":1},{"text":"uzihangule izitha zakhe inxa zonke.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umbane wakhe ukhanyisa umhlaba;","poem":1},{"text":"umhlaba ukubone lokho uthuthumele.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Izintaba zincibilika njengengcino phambi kukaThixo,","poem":1},{"text":"phambi kweNkosi yomhlaba wonke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amazulu amemezela ukulunga kwayo,","poem":1},{"text":"labantu bonke bayayibona inkazimulo yayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bonke abakhonza izifanekiso bathelwa ihlazo,","poem":1},{"text":"labo abazikhukhumeza ngezithombe","poem":2},{"lineBreak":true},{"text":"mkhonzeni, lonke lina bonkulunkulu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"IZiyoni iyezwa ithokoze","poem":1},{"text":"lemizi yakoJuda iyajabula","poem":2},{"lineBreak":true},{"text":"ngenxa yokwahlulela Kwakho, Oh Thixo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngoba wena, Oh Thixo ungoPhezukonke kuwo wonke umhlaba;","poem":1},{"text":"uphakeme ngaphezulu kakhulu kwabonkulunkulu bonke.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akuthi bonke abamthandayo, uThixo, bazonde okubi,","poem":1},{"text":"ngoba uyazilinda impilo zabathembekileyo bakhe","poem":2},{"lineBreak":true},{"text":"abakhulule esandleni sababi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ukukhanya kuyehliselwa kwabalungileyo","poem":1},{"text":"lentokozo kwabaqotho enhliziyweni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Thokozani kuThixo lina elilungileyo,","poem":1},{"text":"lidumise ibizo lakhe elingcwele.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}