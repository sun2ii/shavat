{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Ihubo"]},{"type":"verse","number":1,"content":[{"text":"Hlabelelani uThixo ingoma entsha,","poem":1},{"text":"ngoba wenzile izinto ezimangalisayo;","poem":2},{"text":"isandla sakhe sokunene lengalo yakhe engcwele","poem":1},{"text":"sekumenzele insindiso.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"UThixo useyenze yaziwa insindiso yakhe","poem":1},{"text":"waveza ukulunga kwakhe ezizweni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uselukhumbule uthando lwakhe","poem":1},{"text":"lokuthembeka Kwakhe endlini ka-Israyeli;","poem":2},{"text":"yonke imikhawulo yomhlaba","poem":1},{"text":"iyibonile insindiso kaNkulunkulu wethu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hlokomani ngentokozo kuThixo, mhlaba wonke,","poem":1},{"text":"hlabelani ingoma ngokujabula okukhulu,","poem":2},{"lineBreak":true},{"text":"litshaya amachacho;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"yenzani umsindo kuThixo ngomhubhe,","poem":1},{"text":"ngomhubhe langomsindo wokuhlabela,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ngamacilongo langomsindo wophondo lwenqama","poem":1},{"text":"hlokomani ngentokozo phambi kukaThixo, iNkosi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Akuthi ulwandle luhlokome, lakho konke okuphakathi kwalo,","poem":1},{"text":"umhlaba labo bonke abahlala kuwo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akuthi imifula iqakeze izandla zayo,","poem":1},{"text":"akuthi izintaba zihlabele kanyekanye ngentokozo;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kazihlabele phambi kukaThixo,","poem":1},{"text":"ngoba Uyeza ukuzakwahlulela umhlaba.","poem":2},{"text":"Uzakwahlulela umhlaba ngokulunga","poem":1},{"text":"labantu bonke ngokufaneleyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}