{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"UThixo uyabusa,","poem":1},{"text":"izizwe kazithuthumele;","poem":2},{"text":"uhlezi esihlalweni sobukhosi phakathi kwamakherubhi,","poem":1},{"text":"umhlaba kawuzamazame.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mkhulu uThixo eZiyoni;","poem":1},{"text":"uphakeme ngaphezu kwezizwe zonke.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kabadumise ibizo Lakho elikhulu elesabekayo","poem":1},{"text":"Yena ungcwele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"INkosi ilamandla, ithanda ukwahlulela okuhle","poem":1},{"text":"umisile ukwaba ngemfanelo;","poem":2},{"lineBreak":true},{"text":"kuJakhobe usuwenzile okuqondileyo lokulungileyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dumisani uThixo uNkulunkulu wethu","poem":1},{"text":"likhonze phansi kwesihlalo sakhe;","poem":2},{"lineBreak":true},{"text":"yena ungcwele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"UMosi lo-Aroni babephakathi kwabaphristi bakhe,","poem":1},{"text":"uSamuyeli wayekulabo ababelibiza ibizo lakhe;","poem":2},{"text":"bambiza uThixo","poem":1},{"text":"Yena wabaphendula.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wabakhulumisa ephakathi kwensika yeyezi;","poem":1},{"text":"bagcina izimiso zakhe lezimemezelo azitshoyo kubo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oh Thixo Nkulunkulu wethu,","poem":1},{"text":"wabaphendula;","poem":2},{"text":"ku-Israyeli wawunguNkulunkulu othethelelayo,","poem":1},{"text":"lanxa wabajezisa ngenxa yezenzo zabo ezimbi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Phakamisani uThixo uNkulunkulu wethu,","poem":1},{"text":"limkhonze entabeni yakhe engcwele,","poem":2},{"lineBreak":true},{"text":"ngoba uThixo uNkulunkulu wethu ungcwele.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}