{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"REV","translationId":"nde_bib","name":"Isambulo","commonName":"Isambulo","title":"Isambulo","order":66,"numberOfChapters":22,"sha256":"5429a6a9470f72bdc7810ecec69570622ef0e19c6c446dc694d26b4c3d38cff9","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/nde_bib/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":18,"content":[{"type":"heading","content":["Ukudilika KweBhabhiloni"]},{"type":"verse","number":1,"content":["Emva kwalokhu ngabona enye ingilosi isehla ivela ezulwini. Yayilamandla amakhulu njalo umhlaba wakhanyiswa yikukhazimula kwayo."]},{"type":"verse","number":2,"content":["Yamemeza ngelizwi elikhulu yathi:",{"text":"“ ‘Liwile! Liwile iBhabhiloni eliKhulu!’","poem":1},{"noteId":14},{"text":"Selibe likhaya lamadimoni","poem":2},{"text":"lomango wabomoya ababi,","poem":1},{"text":"lomango wezinyoni zonke ezingcolileyo lezenyanyekayo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngoba izizwe zonke zinathe","poem":1},{"text":"iwayini elihlanyisayo lobufebe balo.","poem":2},{"text":"Amakhosi omhlaba afeba lalo,","poem":1},{"text":"labathengisi basemhlabeni banothiswa yinotho yalo edlulisileyo.”","poem":2}]},{"type":"heading","content":["Izixwayiso Zokwahlulelwa KweBhabhiloni"]},{"type":"verse","number":4,"content":["Ngabuya ngezwa elinye ilizwi livela ezulwini lisithi:",{"text":"“ ‘Bantu bami, phumani kulo,’","poem":1},{"noteId":15},{"text":"ukuze lingahlanganyeli ezonweni zalo","poem":2},{"lineBreak":true},{"text":"ukuze lingehlelwa yizifo zalo;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ngoba izono zalo ziyinqwaba efika ezulwini,","poem":1},{"text":"njalo uNkulunkulu usekhumbule amacala alo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lipheni njengokupha kwalo;","poem":1},{"text":"buyiselani ngokuphindiweyo kulokho elikwenzileyo.","poem":2},{"lineBreak":true},{"text":"Thelani kabili isilinganiso enkezweni yalo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lizwiseni uchuku olukhulu losizi","poem":1},{"text":"okulingana inkazimulo lenotho elizipha khona.”","poem":2},{"noteId":16},{"text":"Enhliziyweni yalo liyazincoma lisithi,","poem":1},{"text":"ngihlezi njengendlovukazi; kangisumfelokazi,","poem":2},{"lineBreak":true},{"text":"njalo kangisoze ngilile.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngakho-ke, ngosuku olulodwa izifo zalo zizalifica:","poem":1},{"text":"ukufa lokukhala kanye lendlala.","poem":2},{"text":"Lizahangulwa ngumlilo","poem":1},{"text":"ngoba ilamandla iNkosi uNkulunkulu olahlulelayo.","poem":2}]},{"type":"heading","content":["Izixwayiso Ezintathu Ngokuwa KweBhabhiloni"]},{"type":"verse","number":9,"content":["Lapho amakhosi asemhlabeni afeba lalo njalo abelana lalo inotho yalo ebona intuthu yokutsha kwalo azalikhalela alililele."]},{"type":"verse","number":10,"content":["Azesaba ngenxa yokuhlukuluzwa kwalo eme khatshana akhale esithi:",{"text":"Maye! Maye, Oh dolobho elikhulu,","poem":1},{"text":"Oh Bhabhiloni, dolobho lamandla!","poem":2},{"text":"Ngehola linye nje incithakalo yakho ifikile!","poem":1}]},{"type":"verse","number":11,"content":["Abathengisi basemhlabeni bazalikhalela balililele ngoba kungasekho othenga impahla yabo,"]},{"type":"verse","number":12,"content":["imithwalo yegolide leyesiliva leyamatshe aligugu leyobuhlalu; eyelineni elihle leliyibubende, ilembu lesilika lelembu elibomvu gebhu; inhlobo zonke zezigodo zesithironi lezinhlobo zonke zezinto ezenziwe ngempondo zendlovu lezigodo ezidulayo lethusi lensimbi kanye lelitshe elimhlophe;"]},{"type":"verse","number":13,"content":["imithwalo yesinamoni leyeziyoliso, eyempepha leyemure kanye leyamakha, eyewayini lamafutha e-oliva, eyefulawa ecolekileyo kanye lengqoloyi; inkomo lezimvu; amabhiza lezinqola lezigqili kanye lemiphefumulo yabantu."]},{"type":"verse","number":14,"content":["Bazakuthi, “Izithelo owawuzilangathela zisukile kuwe. Yonke inotho yakho lenkazimulo sekunyamalele, kakuyikutholakala futhi.”"]},{"type":"verse","number":15,"content":["Abathengisi ababethengisa lezizinto bezuza inotho yabo kuyo bazakuma khatshana, besesaba ngokuhlukuluzwa kwalo. Bazalila babubule"]},{"type":"verse","number":16,"content":["njalo bakhale kakhulu besithi:",{"text":"“Maye! Maye, Oh dolobho elikhulu,","poem":1},{"text":"eligqoke ilineni elihle, okuyibubende lokubomvu,","poem":2},{"text":"elikhazimulayo ngegolide langamatshe","poem":1},{"text":"aligugu kanye lobuhlalu!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngehola linye nje inotho enengi kangaka isichithiwe!”","poem":1},"Izinduna zonke zemikhumbi labo bonke abahamba ngayo labatshayeli labo bonke abazuza ukuphila kwabo olwandle bazakuma khatshana."]},{"type":"verse","number":18,"content":["Lapho bebona izikhatha zokutsha kwalo bazachaza bathi, “Kambe kwake kwaba ledolobho elinjengaleli idolobho elikhulu na?”"]},{"type":"verse","number":19,"content":["Bazathela uthuli emakhanda abo balile babubule bekhala besithi:",{"text":"“Maye! Maye, Oh dolobho elikhulu,","poem":1},{"text":"lapho bonke ababelemikhumbi olwandle","poem":2},{"lineBreak":true},{"text":"abanothiswa khona yinotho yalo!","poem":2},{"text":"Ngehola linye nje selichithiwe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Thokoza ngalo, Oh Zulu!","poem":1},{"text":"Thokozani bangcwele labapostoli kanye labaphrofethi!","poem":2},{"text":"UNkulunkulu uselahlulele","poem":1},{"text":"ngendlela elaliphatha ngayo.”","poem":2}]},{"type":"heading","content":["Isinqumo Sokubhujiswa KweBhabhiloni"]},{"type":"verse","number":21,"content":["Ingilosi elamandla yasidobha ilitshe elingangembokodo enkulu yaliphosela olwandle, yathi:",{"text":"“Idolobho elikhulu laseBhabhiloni lizaphoselwa phansi,","poem":1},{"text":"ngodlakela olunje,","poem":2},{"lineBreak":true},{"text":"lingaphindi libonakale futhi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Umculo wabatshayi bamachacho labahlabeleli labatshayi bemihlanga lamacilongo,","poem":1},{"text":"kawusoze uzwakale kuwe futhi.","poem":2},{"text":"Akukho sisebenzi lesawuphi umsebenzi","poem":1},{"text":"esizatholakala kuwe futhi.","poem":2},{"text":"Umsindo wembokodo","poem":1},{"text":"kawusoze uzwakale kuwe futhi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ukukhanya kwesibane","poem":1},{"text":"akusoze kukhanye kuwe futhi.","poem":2},{"text":"Ilizwi lomyeni lelomlobokazi","poem":1},{"text":"kalisoze lizwakale kuwe futhi.","poem":2},{"text":"Abathengisi bakho babeyizikhulu zomhlaba.","poem":1},{"text":"Izizwe zonke zadukiswa yibuthakathi bakho.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kuwe kwafunyanwa igazi labaphrofethi lelabangcwele,","poem":1},{"text":"kanye lelabo bonke ababulawayo emhlabeni.”","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"18.2 U-Isaya 21.9","reference":{"chapter":18,"verse":2}},{"noteId":15,"caller":"+","text":"18.4 UJeremiya 51.45","reference":{"chapter":18,"verse":4}},{"noteId":16,"caller":"+","text":"18.7 U-Isaya 47.7-8","reference":{"chapter":18,"verse":7}}]},"thisChapterLink":"/api/nde_bib/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}