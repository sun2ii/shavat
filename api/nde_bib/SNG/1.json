{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"SNG","translationId":"nde_bib","name":"Ingoma","commonName":"Ingoma","title":"Ingoma Yezingoma","order":22,"numberOfChapters":8,"sha256":"3895fb7d8a923bb9656aec15c8d2114cd128e824e8185ef359b9bc46633008de","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nde_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ingoma yezingoma kaSolomoni."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kangange ngezangiwo zomlomo wakhe","poem":1},{"text":"ngoba uthando lwakho lumnandi kulewayini.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Limnandi iphunga lamagcobo akho;","poem":1},{"text":"ibizo lakho linjengamakha atheliweyo.","poem":2},{"lineBreak":true},{"text":"Yikho izintombi zikuthanda kangaka!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngithatha uhambe lami, kasiphangise!","poem":1},{"text":"Inkosi kayingingenise endlini yayo.","poem":2},"Abangane",{"text":"Siyathokoza njalo siyajabula ngawe;","poem":1},{"text":"sizalubabaza uthando lwakho okudlula iwayini.","poem":2},"Umlobokazi",{"text":"Kabazenzi ukuba bakuthande!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngimnyama kodwa ngiyabukeka,","poem":1},{"text":"lina madodakazi aseJerusalema","poem":2},{"text":"ngimnyama okwamathente aseKhedari,","poem":1},{"text":"okwamakhetheni amathente kaSolomoni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Linganginyonkolozi ngoba ngimnyama,","poem":1},{"text":"ngimnyama ngenxa yokutshiswa lilanga.","poem":2},{"text":"Abanewethu bangizondela","poem":1},{"text":"bangenza umlindi wesivini;","poem":2},{"lineBreak":true},{"text":"angabe ngisanaka esami isivini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akungitshele, wena engikuthandayo,","poem":1},{"text":"uyelusela ngaphi imihlambi yezimvu zakho","poem":2},{"lineBreak":true},{"text":"lokuthi ziphumula ngaphi izimvu zakho emini?","poem":2},{"text":"Kungani ngisiba njengomfazi ombozileyo eceleni","poem":1},{"text":"kwemihlambi yabangane bakho na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nxa ungazi, wena omuhle okudlula bonke abesifazane,","poem":1},{"text":"landela umkhondo wezimvu","poem":2},{"text":"udlisele amazinyane embuzi zakho","poem":1},{"text":"eduze lamathente abelusi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sithandwa sami, ngikufanisa lebhiza elisikazi","poem":1},{"text":"elibotshwe enqoleni kaFaro.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Izihlathi zakho zinhle ngokuceciswa,","poem":1},{"text":"intamo yakho ngobuhlalu obucazimulayo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sizakwenzela amacici egolide,","poem":1},{"text":"ebalazwe ngesiliva.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Khonapho inkosi isetafuleni","poem":1},{"text":"amakha ami enadi alanquza iphunga lawo elimnandi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kimi isithandwa sami sinjengemfuko yemure","poem":1},{"text":"ithe khoxo phakathi kwamabele ami.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kimi isithandwa sami sinjengelixha lempoko zehena","poem":1},{"text":"eliphuma esivinini se-Eni-Gedi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bakithi, umuhle njani sithandwa sami!","poem":1},{"text":"Ngeqiniso umuhle!","poem":2},{"lineBreak":true},{"text":"Amehlo akho angamajuba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Umuhle ngempela, sithandwa sami!","poem":1},{"text":"Bakithi, uyabukeka!","poem":2},{"lineBreak":true},{"text":"Umbheda wethu butshani obuluhlaza tshoko.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Izinsika zendlu yethu ngezomsedari","poem":1},{"text":"lezintungo ngezefire.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}