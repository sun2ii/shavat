{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"SNG","translationId":"nde_bib","name":"Ingoma","commonName":"Ingoma","title":"Ingoma Yezingoma","order":22,"numberOfChapters":8,"sha256":"3895fb7d8a923bb9656aec15c8d2114cd128e824e8185ef359b9bc46633008de","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nde_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ngililuba laseSharoni,","poem":1},{"text":"imbali yasezigodini.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Njengembali phakathi kwameva","poem":1},{"text":"sinjalo isithandwa sami phakathi kwezintombi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Njengesihlahla se-aphula phakathi kwezihlahla zeganga","poem":1},{"text":"sinjalo isithandwa sami phakathi kwamajaha.","poem":2},{"text":"Kumnandi kimi ukuhlala emthunzini waso,","poem":1},{"text":"lezithelo zakhe ziyahlabusa kimi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Useke wangisa endlini yedili,","poem":1},{"text":"lophawu lwakhe kimi luthando.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngiqinisani ngamavini awonyisiweyo,","poem":1},{"text":"lingivuselele ngama-aphula,","poem":2},{"lineBreak":true},{"text":"ngoba sengiyathiswa luthando.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ingalo yakhe yobunxele ngiyiqamele,","poem":1},{"text":"kuthi ingalo yakhe yokunene ingigonile.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Madodakazi aseJerusalema,","poem":1},{"text":"ngiyaliqonqosela","poem":2},{"lineBreak":true},{"text":"ngezimpala langezimpalakazi zeganga.","poem":2},{"text":"Lingalunyakazisi loba liluvuse uthando","poem":1},{"text":"luze luzifunele lona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Zwanini! Yisithandwa sami!","poem":1},{"text":"Khangelani! Nansi siyeza,","poem":2},{"text":"siseqa ezintabeni","poem":1},{"text":"siqolotsha emaqaqeni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isithandwa sami sinjengempala loba ithole lomziki.","poem":1},{"text":"Khangela! Nansiyana simi ngale komduli wakwethu,","poem":2},{"text":"sikhangele sibona emawindini,","poem":1},{"text":"silunguza ngezimbotshana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isithandwa sami sakhuluma sathi kimi,","poem":1},{"text":"“Sukuma, sithandwa sami,","poem":2},{"lineBreak":true},{"text":"wena omuhle, woza sihambe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Khangela! Ubusika sebudlulile;","poem":1},{"text":"isikhathi sezulu sesidlule.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amaluba asebonakala emangweni;","poem":1},{"text":"isikhathi sokuhlabelela kwezinyoni sesifikile,","poem":2},{"text":"ukukhala kwamajuba","poem":1},{"text":"sekuzwakala elizweni lakithi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Umkhiwa usuthela izithelo zawo zakuqala;","poem":1},{"text":"amavini aqhakazayo aseletha iphunga elimnandi.","poem":2},{"text":"Sukuma, woza sithandwa sami;","poem":1},{"text":"wena omuhle wami, woza sihambe.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Juba lami elisezingoxweni zedwala,","poem":1},{"text":"ekusithekeni kwamawa entaba,","poem":2},{"text":"akungitshengise ubuso bakho,","poem":1},{"text":"akungizwise ilizwi lakho;","poem":2},{"text":"ngoba limnandi ilizwi lakho,","poem":1},{"text":"lobuso bakho buyabukeka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sibambeleni amakhanka,","poem":1},{"text":"amakhanka amancinyane","poem":2},{"text":"onayo ezivinini,","poem":1},{"text":"izivini zethu esezithela.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isithandwa sami ngesami lami ngingowakhe;","poem":1},{"text":"uzithokozisa ngoba phakathi kwamaluba.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akuze kube emadabukakusa","poem":1},{"text":"lapho kunyamalala khona izithunzi,","poem":2},{"text":"phenduka sithandwa sami,","poem":1},{"text":"ube njengempala","poem":2},{"text":"loba njengegogo elisengumntwana","poem":1},{"text":"phezu kwezintaba ezilamakhelekethe.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}