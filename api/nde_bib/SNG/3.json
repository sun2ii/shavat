{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"SNG","translationId":"nde_bib","name":"Ingoma","commonName":"Ingoma","title":"Ingoma Yezingoma","order":22,"numberOfChapters":8,"sha256":"3895fb7d8a923bb9656aec15c8d2114cd128e824e8185ef359b9bc46633008de","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nde_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Ubusuku bonke ngisembhedeni wami","poem":1},{"text":"ngamdinga lowo othandwa yinhliziyo yami;","poem":2},{"lineBreak":true},{"text":"ngamdinga kodwa kangimfumananga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sengivuka manje ngizulazule phakathi kwedolobho,","poem":1},{"text":"emigwaqweni lasemagcekeni alo;","poem":2},{"text":"ngizalibhudula ngidinga othandwa yinhliziyo yami.","poem":1},{"text":"Kanjalo ngamdinga kodwa angaze ngamthola.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abalindi bangifica belokhu","poem":1},{"text":"benquma phakathi kwedolobho.","poem":2},{"lineBreak":true},{"text":"“Like lambona yini lowo othandwa yinhliziyo yami?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngathi ngisedlula kubo","poem":1},{"text":"ngabe ngimbona othandwa yinhliziyo yami.","poem":2},{"text":"Ngambamba angaze ngamyekela ukuba ahambe","poem":1},{"text":"ngaze ngamletha endlini kamama,","poem":2},{"lineBreak":true},{"text":"endlini yakhe lowo owangizalayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Madodakazi aseJerusalema, ngiyaliqonqosela","poem":1},{"text":"ngezimpala langezimpalakazi zeganga.","poem":2},{"text":"Lingalunyakazisi loba liluvuse uthando","poem":1},{"text":"luze luzifunele lona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngubani lo ozayo eqhamuka enkangala","poem":1},{"text":"kungathi yisikhatha sentuthu,","poem":2},{"text":"eziqhole ngamakha emure lenhlaka eyenziwe","poem":1},{"text":"ngemihlobo yonke yezinongo zomthengisi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Khangela! Yinqola kaSolomoni,","poem":1},{"text":"isekelwe ngamabutho angamatshumi ayisithupha,","poem":2},{"lineBreak":true},{"text":"angabathenjwa abayinqaba ko-Israyeli,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"bonke begqize izinkemba enqulwini,","poem":1},{"text":"bonke sebake bazilwa izimpi,","poem":2},{"text":"ngulowo lalowo inkemba yakhe eceleni kwakhe,","poem":1},{"text":"elungele ukuhlatshwa komkhosi ebusuku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inkosi uSolomoni yazenzela inqola leyo;","poem":1},{"text":"yayenza ngezigodo zeLebhanoni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Imijabo yayo yayenza ngesiliva,","poem":1},{"text":"isisekelo sayo yasenza ngegolide.","poem":2},{"text":"Isihlalo sayo yasithungela ilembu eliyibubende","poem":1},{"text":"ingaphakathi yayo yaceciswa ngothando","poem":2},{"lineBreak":true},{"text":"ngamadodakazi aseJerusalema.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Phumani phandle madodakazi aseZiyoni,","poem":1},{"text":"libone iNkosi uSolomoni ithwele umqhele,","poem":2},{"text":"umqhele ewetheswa ngunina mhla welanga atshada ngalo,","poem":1},{"text":"ilanga inhliziyo yakhe yathokoza ngalo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}