{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"SNG","translationId":"nde_bib","name":"Ingoma","commonName":"Ingoma","title":"Ingoma Yezingoma","order":22,"numberOfChapters":8,"sha256":"3895fb7d8a923bb9656aec15c8d2114cd128e824e8185ef359b9bc46633008de","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nde_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Kayisibuhle bakho, sithandwa sami!","poem":1},{"text":"Awu, ayisibuhle, bakithi!","poem":2},{"lineBreak":true},{"text":"Amehlo akho embeswe liveli, angamajuba.","poem":2},{"text":"Inwele zakho zinjengomhlambi wembuzi","poem":1},{"text":"zisehla entabeni iGiliyadi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amazinyo akho anjengomhlambi wezimvu zisanda kugundwa,","poem":1},{"text":"zivela geziswa yileyo ihamba laleyo efanana layo;","poem":2},{"lineBreak":true},{"text":"kayikho ethe qekele yodwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Izindebe zakho zinjengozwezwe olubomvu;","poem":1},{"text":"muhle umlomo wakho.","poem":2},{"text":"Izihlathi zakho ezembeswe liveli lakho","poem":1},{"text":"ezinjengephomegranathi elidatshulwe phakathi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Intamo yakho injengomphotshongo wokulinda kaDavida,","poem":1},{"text":"owakhiwa waba muhle kakhulu;","poem":2},{"text":"kulengiswe kuwo amahawu ayinkulungwane,","poem":1},{"text":"wonke angamahawu amaqhawe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amabele akho omabili anjengamazinyane amabili,","poem":1},{"text":"njengamaphahla amazinyane empala","poem":2},{"lineBreak":true},{"text":"adla utshani phakathi kwezimbali.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nxa kusesemadabukakusa","poem":1},{"text":"izithunzi zingakabaleki emuntwini,","poem":2},{"text":"ngizakuya entabeni yemure","poem":1},{"text":"laseqaqeni lwamakha amnandi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Umuhle kakhulukazi, ntokazi yami;","poem":1},{"text":"kakulanto engenhle kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Woza, mlobokazi wami, sisuke eLebhanoni,","poem":1},{"text":"woza sisuke eLebhanoni.","poem":2},{"text":"Yehla emaweni ase-Amana,","poem":1},{"text":"wehle esiqongweni saseSeniri, isiqongo seHemoni,","poem":2},{"text":"ezimbalwini zezingonyama","poem":1},{"text":"lezintabeni okuhlala ingwe kuzo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uyithumbile inhliziyo yami, dadewethu, mlobokazi wami;","poem":1},{"text":"uyithumbile inhliziyo yami","poem":2},{"text":"ngokungithi jeqe ngamehlo akho,","poem":1},{"text":"langengqongqo elilodwa lobuhlalu bakho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Luthokozisa kanganani uthando lwakho,","poem":1},{"text":"dadewethu, mlobokazi wami!","poem":2},{"text":"Lumnandi kakhulu kulewayini,","poem":1},{"text":"lephunga lamakha akho","poem":2},{"lineBreak":true},{"text":"kulawo wonke amafutha!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Izindebe zakho ziconsa ubumnandi njengoluju, mlobokazi wami;","poem":1},{"text":"uchago loluju kungaphansi kolimi lwakho.","poem":2},{"text":"Iphunga lezivunulo zakho","poem":1},{"text":"linjengeleLebhanoni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uyisivande esibiyelweyo, dadewethu, mlobokazi wami;","poem":1},{"text":"ungumthombo obiyelweyo,","poem":2},{"lineBreak":true},{"text":"lesiphethu esihuqelweyo sagcikwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Izilimo zakho ziyisivande samaphomegranathi","poem":1},{"text":"alezithelo ezinhle zilehena lenadi,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"inadi lesafuroni,","poem":2},{"lineBreak":true},{"text":"ikhalamu lesinamoni,","poem":2},{"lineBreak":true},{"text":"lemihlobo yonke yezihlahla zempepha,","poem":2},{"lineBreak":true},{"text":"imure lenhlaba lazozonke iziyoliso zekhethelo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uyisiphethu sesivandeni,","poem":1},{"text":"umthombo ogeleza amanzi","poem":2},{"lineBreak":true},{"text":"ugeleza usehla eLebhanoni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Vuka moya wenyakatho,","poem":1},{"text":"woza moya weningizimu!","poem":2},{"text":"Phephetha esivandeni sami,","poem":1},{"text":"ukuze amakha aso agcwale indawo yonke.","poem":2},{"text":"Akuthi isithandwa sami size esivandeni saso","poem":1},{"text":"sikholise izithelo zaso zekhethelo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}