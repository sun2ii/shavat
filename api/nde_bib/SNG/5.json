{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"SNG","translationId":"nde_bib","name":"Ingoma","commonName":"Ingoma","title":"Ingoma Yezingoma","order":22,"numberOfChapters":8,"sha256":"3895fb7d8a923bb9656aec15c8d2114cd128e824e8185ef359b9bc46633008de","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nde_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Sengingenile esivandeni sami, dadewethu, mlobokazi wami;","poem":1},{"text":"sengiyibuthile imure yami lesiyoliso sami.","poem":2},{"text":"Sengizidlile inhlanga zami loluju lwami;","poem":1},{"text":"sengiyinathile iwayini yami lochago lwami.","poem":2},"Abangane",{"text":"Dlanini, bangane, linathe;","poem":1},{"text":"nathani lizidele, lina zithandani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngalala kodwa inhliziyo yami ivukile.","poem":1},{"text":"Zwana! Isithandwa sami siyaqoqoda:","poem":2},{"text":"“Ngivulela, dadewethu, sithandwa sami,","poem":1},{"text":"juba lami, wena ongelasiyinga.","poem":2},{"text":"Ikhanda lami ligcwele amazolo,","poem":1},{"text":"inwele zami zilobumanzi bobusuku.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sengisikhulule isigqoko sami","poem":1},{"text":"ngisigqoke futhi na?","poem":2},{"text":"Sengizigezile inyawo zami","poem":1},{"text":"ngibuye ngizingcolise futhi na?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isithandwa sami sangenisa isandla saso embotsheni yomnyango;","poem":1},{"text":"inhliziyo yami yagubhazela ifuna sona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngavuka ngayasivulela isithandwa sami,","poem":1},{"text":"izandla zami zijuluka imure,","poem":2},{"text":"iminwe yami igeleza imure,","poem":1},{"text":"phezu kwezibambo zekhiye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngasivulela isithandwa sami,","poem":1},{"text":"kodwa isithandwa sami sasesisukile, sasesihambile.","poem":2},{"text":"Inhliziyo yami yadangala ngoba sesihambile.","poem":1},{"text":"Ngasithalaza kodwa ngasiswela.","poem":2},{"lineBreak":true},{"text":"Ngasimemeza kodwa kasisabelanga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abalindi bangibona","poem":1},{"text":"ngesikhathi bebhodabhoda, behlola idolobho.","poem":2},{"text":"Bangitshaya bangilimaza;","poem":1},{"text":"bangihlubula bathatha ibhatshi lami,","poem":2},{"lineBreak":true},{"text":"labobalindi bemiduli!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lina madodakazi aseJerusalema, ngiyaliqonqosela","poem":1},{"text":"nxa lisithola isithandwa sami lizasitshelani?","poem":2},{"lineBreak":true},{"text":"Sitsheleni ukuthi mina sengiyathiswa luthando.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isithandwa sakho singcono ngani kulezinye izithandwa","poem":1},{"text":"wena omuhle okudlula bonke abesifazane?","poem":2},{"text":"Singcono ngani isithandwa sakho kulezinye","poem":1},{"text":"osungaze usiqonqosele kangaka?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isithandwa sami siyakhazimula sincwaba,","poem":1},{"text":"siyabonakala laphakathi kwezinkulungwane ezilitshumi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ikhanda laso liligolide elicengwe kakhulu;","poem":1},{"text":"inwele zaso ziyibulembu,","poem":2},{"lineBreak":true},{"text":"zimnyama okwewabayi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amehlo aso anjengamajuba","poem":1},{"text":"esezifuleni ezilamanzi,","poem":2},{"text":"agezwe ngochago,","poem":1},{"text":"amiswa njengamatshe engcebo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Izihlathi zaso zinjengendima yeziyoliso","poem":1},{"text":"ezilephunga lamakha.","poem":2},{"text":"Izindebe zaso zinjengezimbali,","poem":1},{"text":"ziconsa imure.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izingalo zaso yimiqwayi yegolide","poem":1},{"text":"elixutshwe ngekhrisolithe.","poem":2},{"text":"Umzimba waso unjengophondo lwendlovu olulolongiweyo","poem":1},{"text":"lwaceciswa ngamasafire.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Imilenze yaso yizinsika zelitshe","poem":1},{"text":"eliqinileyo elibutshelezi","poem":2},{"lineBreak":true},{"text":"elimiswe ezisekelweni zegolide elicengekileyo.","poem":2},{"text":"Isithombo saso sinjengeLebhanoni,","poem":1},{"text":"njengemisedari yakhona eyebanga laphezulu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Umlomo waso uyibumnandi qobo lwabo;","poem":1},{"text":"siyabukeka ngokupheleleyo.","poem":2},{"text":"Lesi yiso isithandwa sami, yena umngane wami,","poem":1},{"text":"we madodakazi aseJerusalema.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}