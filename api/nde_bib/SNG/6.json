{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"SNG","translationId":"nde_bib","name":"Ingoma","commonName":"Ingoma","title":"Ingoma Yezingoma","order":22,"numberOfChapters":8,"sha256":"3895fb7d8a923bb9656aec15c8d2114cd128e824e8185ef359b9bc46633008de","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nde_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Sesiye ngaphi isithandwa sakho","poem":1},{"text":"wena omuhle kulabo bonke abesifazane?","poem":2},{"text":"Siqonde ngaphi isithandwa sakho","poem":1},{"text":"ukuze sikudingise sona?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isithandwa sami sehlele ngesivandeni saso,","poem":1},{"text":"endimeni yamaluba eziyoliso,","poem":2},{"text":"ukuzulazula ezivandeni","poem":1},{"text":"lokuqunta izimbali.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngingowaso isithandwa sami, laso singesami;","poem":1},{"text":"uzithokozisa ngoba phakathi kwamaluba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umuhle, sithandwa sami, njengeThiza,","poem":1},{"text":"uthandeka njengeJerusalema,","poem":2},{"lineBreak":true},{"text":"ulesithunzi njengamabutho ephethe uphawu lwempi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Susa amehlo akho kimi;","poem":1},{"text":"angihubula igwebu.","poem":2},{"text":"Inwele zakho zinjengomhlambi wembuzi","poem":1},{"text":"zisehla eGiliyadi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amazinyo akho anjengomhlambi wezimvu","poem":1},{"text":"zivela geziswa","poem":2},{"text":"yileyo ihamba laleyo efanana layo;","poem":1},{"text":"akula ehamba yodwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Izihlathi zakho ezivalwe liveli lakho","poem":1},{"text":"zinjengezingxenye zesithelo sephomegranathi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kungabe kukhona amakhosikazi angamatshumi ayisithupha,","poem":1},{"text":"labanye abafazi beceleni abangamatshumi ayisificaminwembili,","poem":2},{"lineBreak":true},{"text":"lezintombi ezipheleleyo ezingelakubalwa;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kodwa ijuba lami, opheleleyo wami, wehlukene,","poem":1},{"text":"nguye yedwa kunina,","poem":2},{"lineBreak":true},{"text":"uyintandokazi yalowo owamzalayo.","poem":2},{"text":"Izintombi zambona zathi ubusisiwe;","poem":1},{"text":"amakhosikazi labafazi beceleni bambabaza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngubani lo oqhamuka njengokusa,","poem":1},{"text":"omuhle njengenyanga, okhazimula njengelanga,","poem":2},{"lineBreak":true},{"text":"olobukhosi njengezinkanyezi ziludwendwe?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngehlela esivandeni esilezithelo ezilenkelo","poem":1},{"text":"ngisiyabona amahlumela esigodini,","poem":2},{"text":"ngisiyabona ingabe amavini ayesenunkula yini","poem":1},{"text":"langabe amaphomegranathi ayeseqhakazile na.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngisalibele nje","poem":1},{"text":"isifiso sami sangibeka ezinqoleni zobukhosi ezabantu bakithi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Phenduka, phenduka, wena mShulamithi;","poem":1},{"text":"phenduka, phenduka, ukuze sikubuke!","poem":2},"Umyeni",{"text":"Liyabe limbukelani umShulamithi","poem":1},{"text":"kungathi libuka umgido kaMahanayimi?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}