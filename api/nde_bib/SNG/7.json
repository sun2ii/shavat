{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"SNG","translationId":"nde_bib","name":"Ingoma","commonName":"Ingoma","title":"Ingoma Yezingoma","order":22,"numberOfChapters":8,"sha256":"3895fb7d8a923bb9656aec15c8d2114cd128e824e8185ef359b9bc46633008de","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nde_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Zinhle kakhulu inyawo zakho emanyathelweni,","poem":1},{"text":"awu ndodakazi yenkosana!","poem":2},{"text":"Amathebe mahle anjengamatshe aligugu,","poem":1},{"text":"ingathi abunjwa kuhle yingcitshi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inkaba yakho yindingilizana yesiphathelo esihle","poem":1},{"text":"esihlala sigcwele iwayini elixutshiweyo.","poem":2},{"text":"Ukhalo lwakho luyinqunjana yengqoloyi","poem":1},{"text":"ezingelezwe yizimbali.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amabele akho anjengamazinyane amabili,","poem":1},{"text":"njengamaphahla empala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Intamo yakho injengomphotshongo wempondo zendlovu.","poem":1},{"lineBreak":true},{"text":"Amehlo akho ayiziziba zeHeshibhoni","poem":1},{"text":"eduze lesango laseBhathi Rabhimi.","poem":2},{"text":"Impumulo yakho injengomphotshongo waseLebhanoni","poem":1},{"text":"ukhangele eDamaseko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ikhanda lakho lingumqhele kuwe njengentaba iKhameli.","poem":1},{"text":"Inwele zakho zingumceciso wobukhosi;","poem":2},{"lineBreak":true},{"text":"inkosi ithunjiwe ngamagoda azo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wamuhle bantu njalo uyathokozisa,","poem":1},{"text":"wena sithandwa, ngezintokozo zakho!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uluthi lwakho luthe klwi, njengesihlahla sephamu,","poem":1},{"text":"lamabele akho anjengelixha lezithelo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngathi, “Ngizakhwela esihlahleni sephamu;","poem":1},{"text":"ngizaziphatha lezozithelo zalo.”","poem":2},{"text":"Sengathi amabele akho angaba njengamaxha evini,","poem":1},{"text":"amakha okuphefumula kwakho abe njengama-aphula,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"lomlomo wakho ube njengewayini elidlula wonke.","poem":2},"Umlobokazi",{"text":"Sengathi iwayini lelo lingaya kusithandwa sami,","poem":1},{"text":"ligeleze kakuhle ezindebeni lasemazinyweni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngingowaso isithandwa sami,","poem":1},{"text":"silangathela mina.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Woza, sithandwa sami, kasihambe siye emaphandleni,","poem":1},{"text":"kasiyolala emizini.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kasihambe ekuseni ezivinini","poem":1},{"text":"ukuyabona ingabe amavini asenunkula na,","poem":2},{"text":"ingabe amaluba amaphomegranathi awo aseqhakazile","poem":1},{"text":"lapho ngizakupha uthando lwami.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Izihlahla zamamandraki zikhupha iphunga elimnandi,","poem":1},{"text":"kuthi emnyango wakwethu kube lezibiliboco zonke","poem":2},{"text":"ezintsha lezindala,","poem":1},{"text":"engikubekele zona, sithandwa sami.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}