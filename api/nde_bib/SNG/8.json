{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"SNG","translationId":"nde_bib","name":"Ingoma","commonName":"Ingoma","title":"Ingoma Yezingoma","order":22,"numberOfChapters":8,"sha256":"3895fb7d8a923bb9656aec15c8d2114cd128e824e8185ef359b9bc46633008de","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nde_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Aluba nje unjengomfowethu kimi,","poem":1},{"text":"owondliwa emunya emabeleni kamama!","poem":2},{"text":"Lapho-ke, nxa ngikufica phandle,","poem":1},{"text":"ngithi loba ngikwanga,","poem":2},{"lineBreak":true},{"text":"angabikhona ongisolayo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngabe ngiyakudonsa","poem":1},{"text":"ngikuse endlini kamama","poem":2},{"lineBreak":true},{"text":"yena owangikhulisayo.","poem":2},{"text":"Ngabe ngikupha iwayini elixutshiweyo unathe,","poem":1},{"text":"uluju lwamaphomegranathi ami.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ingalo yakhe yobunxele ngiyiqamele","poem":1},{"text":"kuthi ingalo yakhe yokunene ingigonile.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Madodakazi aseJerusalema, ngiyaliqonqosela:","poem":1},{"text":"Lingalunyakazisi loba liluvuse uthando","poem":2},{"lineBreak":true},{"text":"luze luzifunele lona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngubani lo oqhamukayo evela enkangala na,","poem":1},{"text":"eyeme isithandwa sakhe?","poem":2},"Umlobokazi",{"text":"Ngikuvusile ngaphansi kwesihlahla se-aphula;","poem":1},{"text":"kulapho unyoko akumithela khona,","poem":2},{"lineBreak":true},{"text":"kulapho ahelelwa wakuzalela khona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngibeka ngibe njengesidindo enhliziyweni yakho,","poem":1},{"text":"njengesidindo engalweni yakho;","poem":2},{"text":"ngoba uthando lulamandla njengokufa,","poem":1},{"text":"ubukhwele balo kabuyekethisi njengengcwaba.","poem":2},{"text":"Luyatshisa njengomlilo obhebha kakhulu,","poem":1},{"text":"njengelangabi elivuthayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Impophoma zamanzi ngeke zilucime uthando;","poem":1},{"text":"imifula ngeke ilukhukhule.","poem":2},{"text":"Nxa umuntu enganika","poem":1},{"text":"yonke inotho yomuzi wakhe","poem":2},{"lineBreak":true},{"text":"ngenxa yothando kungaba yinhlekisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Silentombazana engumnawethu,","poem":1},{"text":"njalo kayikaphuhli.","poem":2},{"text":"Sizamenzelani kambe umnawethu","poem":1},{"text":"mhla sekuthiwa uyacelwa?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uba engumduli,","poem":1},{"text":"sizakwakha imiphotshongo yesiliva phezu kwakhe.","poem":2},{"text":"Uba engumnyango,","poem":1},{"text":"sizamvala ngamapulanka esihlahla somsedari.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngingumduli,","poem":1},{"text":"lamabele ami anjengemiphotshongo.","poem":2},{"text":"Yikho-nje emehlweni akhe","poem":1},{"text":"sengifana lalowo olethe ukusuthiseka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"USolomoni wayelesivini eBhali Hamoni;","poem":1},{"text":"wasiqhatshisela ebalimini isivini sakhe.","poem":2},{"text":"Munye ngamunye kwakumele athele umthelo wezithelo zawo","poem":1},{"text":"ongamashekeli esiliva ayinkulungwane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kodwa esami isivini ngesami ukupha santando;","poem":1},{"text":"amashekeli lawo ayinkulungwane ngawakho, bakithi Solomoni,","poem":2},{"lineBreak":true},{"text":"lamakhulu amabili amashekeli ngawalabo abalondoloza izithelo zawo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wena ohlala ezivandeni labangane","poem":1},{"text":"bekususa isizungu,","poem":2},{"lineBreak":true},{"text":"ake ngilizwe ilizwi lakho!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Masihambe, sithandwa sami,","poem":1},{"text":"woba njengembabala","poem":2},{"text":"kumbe njengejongosana lomziki","poem":1},{"text":"ezintabeni ezigcwele amakha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}