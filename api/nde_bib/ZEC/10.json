kaJuda,","poem":2},{"lineBreak":true},{"text":"abenze babe njengebhiza elilesithunzi empini.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ilitshe lekhoneni lizavela kuJuda,","poem":1},{"text":"kuye kuzavela isikhonkwane sethente,","poem":2},{"text":"kuye kuzavela idandili lokulwa impi,","poem":1},{"text":"kuye kuzavela bonke ababusi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndawonye bazakuba njengamaqhawe alamandla empini","poem":1},{"text":"enyathelela izitha zawo odakeni lwemigwaqo.","poem":2},{"text":"Bazakulwa ngoba uThixo ephakathi kwabo,","poem":1},{"text":"babanqobe abagadi bamabhiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngizayiqinisa indlu kaJuda,","poem":1},{"text":"ngisindise indlu kaJosefa.","poem":2},{"text":"Ngizababuyisa ngoba ngilesihawu kubo.","poem":1},{"text":"Bazakuba sengathi kangizange ngibakhalale,","poem":2},{"text":"ngoba nginguThixo uNkulunkulu wabo","poem":1},{"text":"njalo ngizabaphendula.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abako-Efrayimi bazakuba njengamaqhawe,","poem":1},{"text":"lezinhliziyo zabo zizajabula kungathi banathe iwayini.","poem":2},{"text":"Abantwababo bazakubona lokho bathokoze;","poem":1},{"text":"inhliziyo zabo zizathokoza kuThixo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngizabamema","poem":1},{"text":"ngibabuthe ndawonye.","poem":2},{"text":"Ngempela ngizabahlenga;","poem":1},{"text":"bazakuba banengi njengakuqala.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lanxa ngibahlakazile phakathi kwezizwe,","poem":1},{"text":"kodwa bazangikhumbula khonale emazweni akude.","poem":2},{"text":"Bona kanye labantwababo bazaphila,","poem":1},{"text":"njalo bazabuya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngizababuyisa basuke eGibhithe","poem":1},{"text":"ngibaqoqe e-Asiriya.","poem":2},{"text":"Ngizabaletha eGiliyadi leLebhanoni,","poem":1},{"text":"kuze kungasabi lendawo ebaneleyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bazadabula phakathi kolwandle lokuhlupheka;","poem":1},{"text":"ulwandle oluphuphumayo luzadediswa","poem":2},{"lineBreak":true},{"text":"lezinziki zonke zeNayili zizakoma qha.","poem":2},{"text":"Ukuzikhukhumeza kwe-Asiriya kuzakwehliswa","poem":1},{"text":"lentonga yobukhosi yaseGibhithe izaphela.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngizabaqinisa kuThixo,","poem":1},{"text":"bona bazahamba ngebizo lakhe,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}