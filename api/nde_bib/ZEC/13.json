{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ZEC","translationId":"nde_bib","name":"UZakhariya","commonName":"UZakhariya","title":"UZakhariya","order":38,"numberOfChapters":14,"sha256":"0658ef55e4209b21f2c521a16f4d7ab32de130e71d5f9aa41a0f142c6c8d34e5","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":13,"content":[{"type":"heading","content":["Ukuhlanjululwa Ezonweni"]},{"type":"verse","number":1,"content":["“Ngalelolanga umthombo uzavulelwa indlu kaDavida labakhileyo eJerusalema, ukubahlanza izono lokungcola."]},{"type":"verse","number":2,"content":["Ngalelolanga ngizawasusa amabizo ezithombe elizweni ukuze zingakhunjulwa njalo,” kutsho uThixo uSomandla. “Ngizabasusa abaphrofethi kanye lomoya wokungcola phakathi kwelizwe."]},{"type":"verse","number":3,"content":["Nxa ezabe elokhu ekhona ophrofethayo, uyise lonina abamzalayo bazakuthi kuye, ‘Kumele ufe ngoba usukhulume amanga ngegama likaThixo.’ Uzakuthi ephrofitha abazali bakhe ngokwabo bazamgwaza."]},{"type":"verse","number":4,"content":["Ngalelolanga ngulowo lalowo umphrofethi uzaba lamanhloni ngombono wakhe wokuphrofetha. Akayikwembatha isivunulo somphrofethi esoboya ezama ukukhohlisa."]},{"type":"verse","number":5,"content":["Uzakuthi, ‘Kangisuye umphrofethi, ngingumlimi; umhlabathi uyilapho okulokuphila kwami kusukela ebutsheni bami’"]},{"type":"verse","number":6,"content":["Aluba ebuzwa kuthiwe, ‘Ngawani amanxeba la asemzimbeni wakho?’ Uzaphendula athi, ‘Ngamanxeba engawazuza endlini yabangane bami.’"]},{"type":"heading","content":["Umelusi Utshayiwe, Izimvu Zahlakazwa"]},{"type":"verse","number":7,"content":[{"text":"Vuka, wena nkemba, vukela umelusi wami,","poem":1},{"text":"uvukele umuntu osekhwapheni lami!”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo uSomandla.","poem":2},{"text":"“Tshaya umelusi,","poem":1},{"text":"izimvu zizahlakazeka,","poem":2},{"lineBreak":true},{"text":"njalo ngizaphendula isandla sami ngitshaye ezincinyane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kulolonke ilizwe,” kutsho uThixo,","poem":1},{"text":"“ezimbili kwezintathu zizatshaywa zife;","poem":2},{"lineBreak":true},{"text":"kodwa ingxenye yesithathu izasala kulo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Le ingxenye yesithathu ngizayifaka emlilweni;","poem":1},{"text":"ngizabancibilikisa ngibacenge njengesiliva","poem":2},{"lineBreak":true},{"text":"ngibahlolisise njengegolide.","poem":2},{"text":"Bazalibiza ibizo lami,","poem":1},{"text":"lami ngizabaphendula;","poem":2},{"text":"ngizakuthi, ‘Bangabantu bami,’","poem":1},{"text":"labo bazakuthi, ‘UThixo unguNkulunkulu wethu.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ZEC/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ZEC/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ZEC/12.json","previousChapterAudioLinks":{},"numberOfVerses":9}