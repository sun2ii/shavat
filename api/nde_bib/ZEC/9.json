{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ZEC","translationId":"nde_bib","name":"UZakhariya","commonName":"UZakhariya","title":"UZakhariya","order":38,"numberOfChapters":14,"sha256":"0658ef55e4209b21f2c521a16f4d7ab32de130e71d5f9aa41a0f142c6c8d34e5","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["Ukwahlulelwa Kwezitha Zika-Israyeli Isiqalekiso"]},{"type":"verse","number":1,"content":["Isiphrofethi:",{"text":"Ilizwi likaThixo liqophe ilizwe laseHadiraki","poem":1},{"text":"lize liyokweyama phezu kweDamaseko","poem":2},{"text":"ngoba amehlo abantu lawezizwana zonke zika-Israyeli","poem":1},{"text":"akuThixo","poem":2}]},{"type":"verse","number":2,"content":[{"text":"laphezu kweHamathi layo, engcelelane layo,","poem":1},{"text":"laphezu kweThire leSidoni, lokuba nje zilobungcitshi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"IThire isizakhele inqaba;","poem":1},{"text":"isibuthelele isiliva kwangathi luthuli;","poem":2},{"lineBreak":true},{"text":"legolide njengomhlabathi wemigwaqweni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kodwa uThixo uzayemuka inotho yayo","poem":1},{"text":"achithe lamandla ayo asolwandle,","poem":2},{"lineBreak":true},{"text":"kuthi yona iqedwe ngumlilo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I-Ashikheloni izakubona lokho yesabe;","poem":1},{"text":"iGaza izathuthumela izwe ubuhlungu,","poem":2},{"lineBreak":true},{"text":"le-Ekroni layo, ngoba ithemba layo lizabuna.","poem":2},{"text":"IGaza izabhujelwa yinkosi yayo","poem":1},{"text":"le-Ashikheloni isale ingaselamuntu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abezizwe bazayithatha i-Ashidodi bahlale kuyo,","poem":1},{"text":"njalo ngizakuqeda ukuzigqaja kwamaFilistiya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngizathatha igazi emilonyeni yabo,","poem":1},{"text":"okuyikudla okungavunyelwayo ngikukhuphe emazinyweni abo.","poem":2},{"text":"Labo abaseleyo bazakuba ngabakaNkulunkulu wethu","poem":1},{"text":"njalo babengabakhokheli koJuda,","poem":2},{"lineBreak":true},{"text":"le-Ekroni izakuba njengamaJebusi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kodwa ngizayivikela indlu yami","poem":1},{"text":"kulabo abangabaphangi.","poem":2},{"text":"Kakusayikuphinda kwenzeke ukuthi umncindezeli achithe abantu bami,","poem":1},{"text":"ngoba manje sengihlezi ngiqaphele.","poem":2}]},{"type":"heading","content":["Ukuza KweNkosi YaseZiyoni"]},{"type":"verse","number":9,"content":[{"text":"Thokoza kakhulu, wena Ndodakazi yaseZiyoni!","poem":1},{"text":"Memeza, Ndodakazi yaseJerusalema!","poem":2},{"text":"Khangela, inkosi yakho iyeza kuwe,","poem":1},{"text":"iza ilungile ilensindiso,","poem":2},{"text":"imnene, ihamba igade ubabhemi,","poem":1},{"text":"iphezu kwenkonyane, inkonyane kababhemi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngizazisusa izinqola zempi ko-Efrayimi","poem":1},{"text":"lamabhiza empi eJerusalema,","poem":2},{"lineBreak":true},{"text":"ledandili lempi lizakwephulwa.","poem":2},{"text":"Izamemezela ukuthula phakathi kwezizwe.","poem":1},{"text":"Umbuso wayo uzasukela elwandle usiya elwandle,","poem":2},{"lineBreak":true},{"text":"njalo kusukela eMfuleni kusiya emaphethelweni omhlaba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wena pho, ngenxa yegazi lesivumelwano lawe,","poem":1},{"text":"ngizakhulula izibotshwa zakho emgodini ongelamanzi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Buyelani enqabeni yenu, lina zibotshwa ezilethemba;","poem":1},{"text":"sengihle ngibika ukuthi","poem":2},{"lineBreak":true},{"text":"ngizalibuyisela izibusiso ngokuphindwe kabili.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngizamgoba uJuda njengalokhu ngigoba idandili lami","poem":1},{"text":"besengigcwalisa ngo-Efrayimi.","poem":2},{"text":"Ngizawahlokoza amadodana akho, wena Ziyoni,","poem":1},{"text":"avukele amadodana akho, wena Grisi,","poem":2},{"lineBreak":true},{"text":"ngikwenze ube njengenkemba yebutho.","poem":2}]},{"type":"heading","content":["UThixo Uzaqhamuka"]},{"type":"verse","number":14,"content":[{"text":"Kulapho-ke uThixo azaqhamuka ngaphezu kwabo;","poem":1},{"text":"umtshoko wakhe uzabenyezela njengonyezi.","poem":2},{"text":"UThixo Wobukhosi uzatshaya icilongo;","poem":1},{"text":"uzahaluzela ngeziphepho zaseningizimu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"njalo uThixo uSomandla uzabavikela.","poem":1},{"text":"Bazabhubhisa njalo banqobe ngamatshe ezavutha.","poem":2},{"text":"Bazanatha baklabalale njengabadakwe liwayini;","poem":1},{"text":"bazagcwala lona njengomganu","poem":2},{"lineBreak":true},{"text":"osetshenziswa kuchelwa amagumbi e-alithare.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"UThixo uNkulunkulu wabo uzabasindisa ngalelolanga","poem":1},{"text":"njengoba bengumhlambi wezimvu zakhe.","poem":2},{"text":"Bazakhazimula elizweni lakhe","poem":1},{"text":"njengamatshe aligugu acecise umqhele.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yeka ukukhanga kwabo lobuhle abazakuba yibobona!","poem":1},{"text":"Isivuno esihle sizatshwaphulula izinsizwa,","poem":2},{"lineBreak":true},{"text":"lewayini elitsha lithokozise izintombi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}