{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ZEP","translationId":"nde_bib","name":"UZefaniya","commonName":"UZefaniya","title":"UZefaniya","order":36,"numberOfChapters":3,"sha256":"4e9ecba54b9c0f2cc9da283200b95ddb2f5bb3df5a15eb8f433ecdeefdb27b7f","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ilizwi likaThixo elafika kuZefaniya indodana kaKhushi, indodana kaGedaliya, indodana ka-Amariya, indodana kaHezekhiya, ekubuseni kukaJosiya indodana ka-Amoni inkosi yakoJuda:"]},{"type":"line_break"},{"type":"heading","content":["Isixwayiso Ngencithakalo Ezayo"]},{"type":"verse","number":2,"content":[{"text":"“Ngizakhucula konke","poem":1},{"text":"ebusweni bomhlaba,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Ngizakhucula kokubili abantu lezinyamazana;","poem":1},{"text":"ngizakhucula izinyoni zasemoyeni","poem":2},{"lineBreak":true},{"text":"kanye lenhlanzi zasolwandle,","poem":2},{"lineBreak":true},{"text":"lezithombe ezenza ababi bakhubeke.","poem":2},{"lineBreak":true},{"text":"Lapho ngiqeda abantu","poem":1},{"text":"ebusweni bomhlaba,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"heading","content":["Ukumelana LoJuda"]},{"type":"verse","number":4,"content":[{"text":"“Ngizakwelulela isandla sami koJuda","poem":1},{"text":"lakubo bonke abahlala eJerusalema.","poem":2},{"text":"Ngizaqeda konke okukaBhali okuseleyo kule indawo,","poem":1},{"text":"amabizo abahedeni labaphristi abakhonza izithombe","poem":2}]},{"type":"verse","number":5,"content":[{"text":"labo abakhothama phezu kwezindlu","poem":1},{"text":"bakhonze ixuku lezinkanyezi,","poem":2},{"text":"labo abakhothama bafunge ngoThixo,","poem":1},{"text":"abafunga langoMoleki futhi,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"labo ababuyela emuva bedela ukulandela uThixo","poem":1},{"text":"njalo abangamdinganga uThixo loba babuze ngaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Thula phambi kukaThixo Wobukhosi,","poem":1},{"text":"ngoba usuku lukaThixo seluseduze.","poem":2},{"text":"UThixo uselungise umhlatshelo;","poem":1},{"text":"usebangcwelisile labo abanxusileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngosuku lomhlatshelo kaThixo","poem":1},{"text":"ngizajezisa izikhulu","poem":2},{"lineBreak":true},{"text":"lamadodana amakhosi labo bonke","poem":2},{"text":"labo abagqoke","poem":1},{"text":"izigqoko zezizweni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngalolosuku ngizabajezisa","poem":1},{"text":"bonke abaxwaya ukunyathela umbundu womnyango,","poem":2},{"text":"abagcwalisa ithempeli labonkulunkulu","poem":1},{"text":"babo ngodlakela langenkohliso.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"UThixo, uthi,","poem":1},{"lineBreak":true},{"text":"“Ngalolosuku ilizwi lokukhala","poem":1},{"text":"lizaqonga ngaseSangweni leNhlanzi,","poem":2},{"text":"ukulila kuvelela esiGabeni eSitsha","poem":1},{"text":"lomsindo omkhulu wokufohloza uvela emaqaqeni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lilani lina elihlala esigodini sokuthengisela saseMakhithashi,","poem":1},{"text":"bonke abathengisi benu bazaqedwa,","poem":2},{"lineBreak":true},{"text":"bonke abathengiselana ngesiliva bazabhujiswa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngalesosikhathi ngizaphenya iJerusalema ngezibane","poem":1},{"text":"ngijezise labo abangakhathaliyo,","poem":2},{"lineBreak":true},{"text":"abanjengewayini elitshiywe phakathi kwensipho zalo,","poem":2},{"text":"abathi, ‘UThixo kayikwenza lutho,","poem":1},{"text":"oluhle loba olubi.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inotho yabo izaphangwa,","poem":1},{"text":"izindlu zabo zidilizwe.","poem":2},{"text":"Bazakwakha izindlu","poem":1},{"text":"kodwa bangahlali kuzo;","poem":2},{"text":"bazahlanyela izivini,","poem":1},{"text":"kodwa iwayini bangalinathi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Usuku olukhulu lukaThixo seluseduze,","poem":1},{"text":"njalo luza ngokuphangisa.","poem":2},{"text":"Lalelani! Ukukhala ngosuku lukaThixo","poem":1},{"text":"kuzakuba buhlungu, lokuklabalala kwebutho khonapho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lolosuku luzakuba lusuku lolaka,","poem":1},{"text":"usuku losizi lokudabuka;","poem":2},{"text":"usuku lokuhlupheka lokuchitheka,","poem":3},{"text":"usuku lomnyama lokudana,","poem":2},{"text":"usuku lwamayezi lobumnyama,","poem":3}]},{"type":"verse","number":16,"content":[{"text":"usuku lwecilongo lokuhlaba umkhosi wokulwa impi","poem":2},{"text":"lamadolobho avikelweyo","poem":1},{"text":"kanye lezinqaba zasemajikweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Ngizaletha usizi ebantwini","poem":1},{"text":"njalo bazahamba njengeziphofu,","poem":2},{"lineBreak":true},{"text":"ngoba bonile kuThixo.","poem":2},{"text":"Igazi labo lizachithwa njengothuli","poem":1},{"text":"lezibilini zabo njengamanyala.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isiliva sabo loba igolide labo","poem":1},{"text":"kakungeke kwenelise ukubasindisa","poem":2},{"lineBreak":true},{"text":"ngosuku lolaka lukaThixo.","poem":2},{"lineBreak":true},{"text":"Umhlaba wonke uzatshiswa emlilweni","poem":1},{"text":"womona wakhe","poem":2},{"text":"ngoba uzakwenza isiphetho ngokuphangisa","poem":1},{"text":"kubo bonke abahlala emhlabeni.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}