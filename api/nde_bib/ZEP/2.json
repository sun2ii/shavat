{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ZEP","translationId":"nde_bib","name":"UZefaniya","commonName":"UZefaniya","title":"UZefaniya","order":36,"numberOfChapters":3,"sha256":"4e9ecba54b9c0f2cc9da283200b95ddb2f5bb3df5a15eb8f433ecdeefdb27b7f","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["IJuda LeJerusalema Yahlulelwa Kanye Lezinye Izizwe."]},{"type":"heading","content":["UJuda Ukhuthazwa Ukuthi Aphenduke"]},{"type":"verse","number":1,"content":[{"text":"Buthanani ndawonye, buthanani ndawonye,","poem":1},{"text":"wena sizwe esiyangisayo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"isikhathi esimisiweyo singakafiki","poem":1},{"text":"losuku ludlule njengamakhoba,","poem":2},{"text":"ukuthukuthela okwesabekayo kukaThixo","poem":1},{"text":"kungakafiki kuwe,","poem":2},{"text":"usuku lolaka lukaThixo","poem":1},{"text":"lungakafiki kuwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dingani uThixo, lonke lina abathobekileyo belizwe,","poem":1},{"text":"lina elenza lokho akulayayo.","poem":2},{"text":"Dingani ukulunga, dingani ukuthobeka;","poem":1},{"text":"mhlawumbe lingavikelwa","poem":2},{"lineBreak":true},{"text":"ngosuku lwentukuthelo kaThixo.","poem":2}]},{"type":"heading","content":["Ukumelana LeFilistiya"]},{"type":"verse","number":4,"content":[{"text":"IGaza izadelwa","poem":1},{"text":"le-Ashikheloni isale isingamanxiwa.","poem":2},{"text":"Abantu base-Ashidodi bazaxotshwa emini,","poem":1},{"text":"le-Ekroni isitshulwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maye kini lina elihlala ngasolwandle,","poem":1},{"text":"lina sizwe samaKherethi;","poem":2},{"text":"ilizwi likaThixo limelana lani,","poem":1},{"text":"wena Khenani, lizwe lamaFilistiya.","poem":2},{"text":"“Ngizakutshabalalisa,","poem":1},{"text":"njalo kakho ozasala.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ilizwe elingasolwandle","poem":1},{"text":"lizakuba yindawo yabelusi","poem":2},{"lineBreak":true},{"text":"lezibaya zezimvu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ilizwe lizakuba","poem":1},{"text":"ngelabaseleyo abendlu kaJuda;","poem":2},{"lineBreak":true},{"text":"bazathola amadlelo khona.","poem":2},{"text":"Kusihlwa bazalala phansi","poem":1},{"text":"ezindlini zase-Ashikheloni.","poem":2},{"text":"UThixo uNkulunkulu wabo uzabalondoloza;","poem":1},{"text":"uzabenza baphumelele futhi.","poem":2}]},{"type":"heading","content":["Ukumelana LeMowabi Le-Amoni"]},{"type":"verse","number":8,"content":[{"text":"“Ngizizwile izithuko zeMowabi","poem":1},{"text":"lokuchothoza kwama-Amoni,","poem":2},{"text":"abathuka abantu bami","poem":1},{"text":"besongela lelizwe labo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngakho ngeqiniso elinjengoba ngikhona,”","poem":1},{"text":"kutsho uThixo uSomandla,","poem":2},{"lineBreak":true},{"text":"uNkulunkulu ka-Israyeli,","poem":2},{"text":"“impela iMowabi izakuba njengeSodoma,","poem":1},{"text":"ama-Amoni abe njengeGomora,","poem":2},{"text":"indawo yokhula lemigodi yetshwayi,","poem":1},{"text":"ilizwe elichithekileyo nini lanini.","poem":2},{"text":"Abaseleyo babantu bami bazabaphanga;","poem":1},{"text":"abaphephileyo babantu bami bazathatha ilizwe labo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lokhu yikho abazakuthola kungumvuzo wokuzigqaja kwabo,","poem":1},{"text":"ngenxa yokuthuka lokuklolodela","poem":2},{"lineBreak":true},{"text":"abantu bakaThixo uSomandla.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"UThixo uzakwesabeka kubo","poem":1},{"text":"lapho esetshabalalisa bonke onkulunkulu belizwe.","poem":2},{"text":"Izizwe ezisemakhunjini wonke zizamkhonza,","poem":1},{"text":"ngulowo elizweni lakhe.","poem":2}]},{"type":"heading","content":["UKumelana LeKhushi"]},{"type":"verse","number":12,"content":[{"text":"“Lani futhi, lina maKhushi","poem":1},{"text":"lizabulawa ngenkemba yami.”","poem":2}]},{"type":"heading","content":["Ukumelana Le-Asiriya"]},{"type":"verse","number":13,"content":[{"text":"Uzakwelulela isandla sakhe enyakatho","poem":1},{"text":"achithe i-Asiriya,","poem":2},{"text":"atshiye iNiniva itshabalele ngokupheleleyo","poem":1},{"text":"njalo yome njengenkangala.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Imihlambi yezimvu leyenkomo izalala phansi khonapho,","poem":1},{"text":"lezidalwa zezinhlobo zonke.","poem":2},{"text":"Isikhova senkangala lomandukulo","poem":1},{"text":"kuzahlala ensikeni zakhe.","poem":2},{"text":"Ukukhala kwazo kuzezwakala emawindini,","poem":1},{"text":"imfucuza izakuba eminyango,","poem":2},{"lineBreak":true},{"text":"imijabo yemisedari ichayeke.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Leli lidolobho elingakhathaliyo","poem":1},{"text":"elalizihlalele livikelekile.","poem":2},{"text":"Lazitshela lathi:","poem":1},{"text":"“Ngiyimi, kakho omunye ngaphandle kwami.”","poem":2},{"text":"Yeka ukuchitheka eseliyikho,","poem":1},{"text":"isikhundla sezinyamazana zeganga!","poem":2},{"text":"Bonke abadlula kulo bahleka usulu","poem":1},{"text":"balikhombe ngeminwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}