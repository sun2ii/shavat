{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ZEP","translationId":"nde_bib","name":"UZefaniya","commonName":"UZefaniya","title":"UZefaniya","order":36,"numberOfChapters":3,"sha256":"4e9ecba54b9c0f2cc9da283200b95ddb2f5bb3df5a15eb8f433ecdeefdb27b7f","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Ikusasa LeJerusalema"]},{"type":"verse","number":1,"content":[{"text":"Maye kulo idolobho labancindezeli,","poem":1},{"text":"elihlamukayo lelingcolileyo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kalilaleli muntu,","poem":1},{"text":"kalivumi kukhuzwa.","poem":2},{"text":"Kalithembeli kuThixo,","poem":1},{"text":"kalisondeli kuNkulunkulu walo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Izikhulu zalo","poem":1},{"text":"ziyizilwane ezibhongayo, ababusi balo","poem":2},{"text":"bazimpisi zakusihlwa,","poem":1},{"text":"ezingatshiyi lutho lwekuseni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abaphrofethi balo bayazazisa;","poem":1},{"text":"bangabantu bamacebo amabi.","poem":2},{"text":"Abaphristi balo bangcolisa indawo engcwele","poem":1},{"text":"bephule lomthetho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"UThixo phakathi kwalo ulungile;","poem":1},{"text":"kenzi okubi,","poem":2},{"text":"nsuku zonke ekuseni wenza ukulunga kwakhe","poem":1},{"text":"njalo kaphambanisi ukusa kwamalanga wonke,","poem":2},{"lineBreak":true},{"text":"ikanti abangalunganga kabalanhloni.","poem":2}]},{"type":"heading","content":["IJerusalema Yala Ukuphenduka"]},{"type":"verse","number":6,"content":[{"text":"“Ngizichithile izizwe;","poem":1},{"text":"izinqaba zazo zidiliziwe.","poem":2},{"text":"Ngitshiye imigwaqo yazo ideliwe","poem":1},{"text":"kungekho odlula khona.","poem":2},{"text":"Amadolobho azo adiliziwe;","poem":1},{"text":"kakho ozasala kakho lamunye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngathi kulo idolobho,","poem":1},{"text":"‘Impela uzangesaba","poem":2},{"lineBreak":true},{"text":"uvume ukukhuzwa!’","poem":2},{"text":"Lapho-ke indlu yalo yokuhlala yayingayikudilizwa","poem":1},{"text":"loba isijeziso sami sehlele phezu kwalo.","poem":2},{"text":"Kodwa babelokhu betshisekela izenzo zokuxhwala","poem":1},{"text":"kukho konke abakwenzayo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngakho ngilindela,” kutsho uThixo,","poem":1},{"text":"“lolusuku engizasukuma ngalo ngifakaze.","poem":2},{"text":"Sengimise ukubuthanisa izizwe,","poem":1},{"text":"ngiqoqe imibuso,","poem":2},{"text":"ngehlisele ulaka lwami phezu kwabo","poem":1},{"text":"konke ukuthukuthela kwami okukhulu.","poem":2},{"text":"Umhlaba wonke uzaqothulwa","poem":1},{"text":"ngomlilo womona wentukuthelo yami.”","poem":2}]},{"type":"heading","content":["Ukuvuselelwa Kwensalela Yako-Israyeli"]},{"type":"verse","number":9,"content":[{"text":"“Lapho-ke ngizahlambulula izindebe zezizwe,","poem":1},{"text":"ukuze zonke zikhuleke ebizweni likaThixo","poem":2},{"lineBreak":true},{"text":"zimkhonze zimanyane.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kusukela ngaphetsheya kwemifula yaseKhushi","poem":1},{"text":"abakhonzi bami, abantu bami abahlakazekileyo,","poem":2},{"lineBreak":true},{"text":"bazangilethela iminikelo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngalolosuku kaliyikuyangiswa","poem":1},{"text":"ngobubi bonke elabenza kimi,","poem":2},{"text":"ngoba ngizabasusa kulelidolobho","poem":1},{"text":"abathokoziswa yikuzigqaja kwabo.","poem":2},{"text":"Kaliyikuzikhukhumeza futhi","poem":1},{"text":"entabeni yami engcwele.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kodwa ngizatshiya phakathi kwenu","poem":1},{"text":"abathambileyo labathobekileyo,","poem":2},{"lineBreak":true},{"text":"abathembele ebizweni likaThixo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kabayikwenza okubi;","poem":1},{"text":"kabayikuqamba amanga,","poem":2},{"text":"loba kube lenkohliso","poem":1},{"text":"emilonyeni yabo.","poem":2},{"text":"Bazakudla balale phansi,","poem":1},{"text":"kakho ozabenza besabe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hlabela wena Ndodakazi yeZiyoni,","poem":1},{"text":"klabalala kakhulu, wena Israyeli!","poem":2},{"text":"Thaba uthokoze ngenhliziyo yakho yonke","poem":1},{"text":"wena ndodakazi yaseJerusalema!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"UThixo usesisusile isijeziso sakho,","poem":1},{"text":"usesixotshile isitha sakho.","poem":2},{"text":"UThixo, iNkosi ka-Israyeli, ulawe;","poem":1},{"text":"akulangozi ozaphinda uyesabe futhi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngalolosuku bazakuthi kulo iJerusalema,","poem":1},{"text":"“Ungesabi,","poem":2},{"text":"wena Ziyoni;","poem":1},{"text":"ungavumeli ukuba izandla zakho zibe buthakathaka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"UThixo uNkulunkulu wakho ulawe,","poem":1},{"text":"ulamandla okusindisa.","poem":2},{"text":"Uzathokoza kakhulu ngawe,","poem":1},{"text":"uzakududuza ngothando lwakhe,","poem":2},{"lineBreak":true},{"text":"uzakuthokozela ngokuhlabelela.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Insizi zemikhosi emisiweyo","poem":1},{"text":"ngizazisusa kuwe;","poem":2},{"lineBreak":true},{"text":"zingumthwalo lehlazo kuwe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngalesosikhathi ngizababona","poem":1},{"text":"bonke abalincindezelayo;","poem":2},{"text":"ngizahlenga abaqhulayo","poem":1},{"text":"ngibuthe lalabo abahlakazwayo,","poem":2},{"text":"ngizabapha udumo lenhlonipho","poem":1},{"text":"kuwo wonke amazwe lapho abahlaziswa khona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngalesosikhathi ngizalibutha;","poem":1},{"text":"ngalesosikhathi ngizalisa ekhaya.","poem":2},{"text":"Ngizalipha inhlonipho lodumo","poem":1},{"text":"phakathi kwezizwe zonke zasemhlabeni","poem":2},{"text":"lapho sengiliphumelelisa futhi","poem":1},{"text":"phambi kwamehlo enu uqobo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}