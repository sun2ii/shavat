{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"ISA","translationId":"nhe_tbl","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"fb2094ca0f88e089d4e9fc7b2f92606eee246c72ae58fac087e31ea4ff2d43c1","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nhe_tbl/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["Huicatl tlen tlascamatili para TOTECO"]},{"type":"verse","number":1,"content":["Hualas se tonal quema tlacame huicase:",{"text":"“Nimitzhueyitlalía, TOTECO.","poem":1},{"lineBreak":true},{"text":"Yonque tlahuel ticualaniyaya ica na,","poem":1},{"lineBreak":true},{"text":"ama timoyoltlalijtoc huan tinechtlasojtlatoc.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xiquitaca intlacame, Toteco Dios yajaya notemaquixtijca.","poem":1},{"lineBreak":true},{"text":"Huajca nimotemachis ipan ya huan ayoc nimajmahuis.","poem":1},{"lineBreak":true},{"text":"TOTECO itztoc tlen nechmaca nochicahualis huan yeca san para ya nihuicas.","poem":1},{"lineBreak":true},{"text":"San yajaya notemaquixtijca.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Queja se ajhuiyac atl quinmaca paquilistli tlen amiquij,","poem":1},{"lineBreak":true},{"text":"queja nopa tipaquij tojuanti, tiitlacajhua TOTECO tlen yajaya techmaquixtijtoc.”","poem":1}]},{"type":"verse","number":4,"content":["Huan ipan nopa tonal quiijtose:",{"text":"“¡Xijtlascamatica TOTECO!","poem":1},{"lineBreak":true},{"text":"¡Xijhueyitlalica ya!","poem":1},{"lineBreak":true},{"text":"¡Xitepohuilica ipan nochi tlaltini nopa huejhueyi tlamantli tlen yajaya quichijtoc!","poem":1},{"lineBreak":true},{"text":"¡Xiteilhuica para TOTECO yajaya nelía hueyi!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xihuicaca tiohuicatl para TOTECO pampa yajaya quichijtoc huejhueyi tlamantli.","poem":1},{"lineBreak":true},{"text":"Ma quimatica tlen quichijtoc nochi tlacame ipan tlaltepactli.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Huan ma huicaca huan ma tzajtzica ica paquilistli,","poem":1},{"lineBreak":true},{"text":"nochi tlen itztoque ipan altepetl Jerusalén.","poem":1},{"lineBreak":true},{"text":"Pampa tlatlajco tlen tojuanti itztoc TOTECO tlen nelía hueyi.","poem":1},{"lineBreak":true},{"text":"Quena, yajaya nopa Dios Tlen Tlatzejtzeloltic Huan Itztoc Tohuaya Tiisraelitame.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}