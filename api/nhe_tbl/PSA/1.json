{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":1,"content":[{"type":"heading","content":["Tlajtlacolchihuani huan tlacame tlen xitlahuaque iixpa Toteco"]},{"type":"verse","number":1,"content":[{"text":"Paqui nopa tlacatl tlen ax quitlacaquilía inintlajtol ax cuajcualme,","poem":1},{"lineBreak":true},{"text":"niyon ax quintoquilía tlajtlacolchihuani.","poem":1},{"lineBreak":true},{"text":"Niyon ax mohuica ininhuaya tlen ica paquij TOTECO.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nopa tlacatl quipantía hueyi paquilistli pampa quichijtinemi tlen quiijtohuaj itlanahuatilhua TOTECO,","poem":1},{"lineBreak":true},{"text":"huan ipan nopa tlanahuatili moyolilhuijtinemi tonaya huan tlayohua.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nopa tlacatl itztoc queja se cuahuitl tlen moscaltía nechca atemitl,","poem":1},{"lineBreak":true},{"text":"huan temaca itlajca quema ipohual huan ax quema xihuiyo tepehui.","poem":1},{"lineBreak":true},{"text":"Nochi tlen quichihua quisa cuali.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero ax queja nopa ica tlacame tlen ax cuajcualme,","poem":1},{"lineBreak":true},{"text":"pampa inijuanti itztoque queja tlasoli tlen quihuica ajacatl.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yeca quema TOTECO tetlajtolsencahuas,","poem":1},{"lineBreak":true},{"text":"nopa ax cuajcualme ax huelise quiijiyohuise,","poem":1},{"lineBreak":true},{"text":"pampa yajaya tlahuel chicahuac quintlatzacuiltis.","poem":1},{"lineBreak":true},{"text":"Quena, ipan nopa tonal tlajtlacolchihuani ayoc huelis mocahuase ininhuaya tlacame tlen itztoque xitlahuaque iixpa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pampa TOTECO quimati nopa ojtli tlen ipan nemij tlacame tlen itztoque xitlahuaque,","poem":1},{"lineBreak":true},{"text":"pero tlacame tlen quichihuaj tlen ax cuali, polihuise.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}