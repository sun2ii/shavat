{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":100,"content":[{"type":"heading","content":["Ma tijtlascamatica Toteco"]},{"type":"verse","number":1,"content":[{"text":"Xihuicaca ica paquilistli para TOTECO,","poem":1},{"lineBreak":true},{"text":"nochi intlacame tlen initztoque ipan ni tlaltepactli.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xijtequipanoca TOTECO ica paquilistli.","poem":1},{"lineBreak":true},{"text":"Huan quema inhualahuij iixtla, xihuicatihualaca.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xijmatica cuali para TOTECO, yajaya Toteco Dios.","poem":1},{"lineBreak":true},{"text":"Yajaya techchijchijqui.","poem":1},{"lineBreak":true},{"text":"Ax timochijchijtoque tojuanti.","poem":1},{"lineBreak":true},{"text":"Tojuanti tiitlacajhua huan tiitztoque queja tiiborregojhua tlen techpixtoc ipan ipotrero para techmocuitlahuis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quema ticalaquij ipan itiopa, ma tijtlascamatica miyac.","poem":1},{"lineBreak":true},{"text":"Huan quema tinemij icalixpa, ma tihuicaca.","poem":1},{"lineBreak":true},{"text":"Quena, ma tijtlascamatica huan ma tijpaquilismacaca.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pampa TOTECO yajaya nelía cuali.","poem":1},{"lineBreak":true},{"text":"Nochipa teicnelía huan tetlasojtla.","poem":1},{"lineBreak":true},{"text":"Yajaya itztos temachtli para nochipa ica nochi tlacame tlen tlacajtihualahuij.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}