{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":12,"content":[{"type":"heading","content":["Xitechpalehui, TOTECO"]},{"type":"verse","number":1,"content":[{"text":"Xitechpalehui, TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa ayoc aca tlen nelía mitzneltoquilía.","poem":1},{"lineBreak":true},{"text":"Ayoc acajme tlacame tlen quiijtohuaj tlen melahuac.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Se ica seyoc moistlacahuíaj.","poem":1},{"lineBreak":true},{"text":"Quipiyaj ome ininxayac queja nojquiya quipatlaj inintlajtol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"TOTECO quintzontlamiltis nochi tlen quipiyaj ome ininxayac huan tlen mohueyimatij quema camatij.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quintzontlamiltis tlen quiijtohuaj:","poem":1},{"lineBreak":true},{"text":"“San ica totlajtol titlatlanise.","poem":1},{"lineBreak":true},{"text":"Intla tijnequij tiistlacatise,","poem":1},{"lineBreak":true},{"text":"tojuanti tijmatij.","poem":1},{"lineBreak":true},{"text":"Axaca huelis technahuatis.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero quej ni quiijtojtoc TOTECO:","poem":1},{"lineBreak":true},{"text":"“Inijuanti tlen teicneltzitzi huan tlen ax quipiyaj fuerza nechtzajtzilíaj ipampa nopa fiero tlacame tlen quintlaijiyohuiltíaj.","poem":1},{"lineBreak":true},{"text":"Yeca ama nimotlalanas para niquinpalehuis.","poem":1},{"lineBreak":true},{"text":"Niquinmaquixtis ininmaco tlen quincocolíaj.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nelía temachtli tlen quiijtohua TOTECO.","poem":1},{"lineBreak":true},{"text":"Itlajtol senquistoc melahuac.","poem":1},{"lineBreak":true},{"text":"Quena, eltoc queja se cuali plata tlen quinelicxitijtoque,","poem":1},{"lineBreak":true},{"text":"huan quipajpactoque miyac hueltas hasta senquistoc cuali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"TOTECO, ta titechmocuitlahuía.","poem":1},{"lineBreak":true},{"text":"Titechmanahuis para nochipa ica tlacame tlen ax cuajcualme queja ama itztoque.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quena, yonque mosisinijca tlacame mooquichmajtinemij campa hueli huan nochi tlacame san quipatiitaj tlen ax cuali,","poem":1},{"lineBreak":true},{"text":"Ta titechmocuitlahuía.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}