{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":120,"content":[{"type":"heading","content":["Tlamaijtoli para Toteco ma quimanahui tlen nopa istlacatini"]},{"type":"verse","number":1,"content":[{"text":"Quema niitztoya ipan tlaijiyohuilistli,","poem":1},{"lineBreak":true},{"text":"nijtzajtzili TOTECO huan yajaya nechnanquili.","poem":1},{"lineBreak":true},{"text":"Niquilhui:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“TOTECO, xinechmanahui ininmaco nopa tlacame,","poem":1},{"lineBreak":true},{"text":"tlen nechistlacahuíaj huan nechijilnamiquij.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma moilhuica nopa istlacatini tlachque elis tlen ininpantis ipampa iniistlacaticayo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quintlamicocoyotzase ica cuatlamintli huan quintlatise ipan tlicoli.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nelía niteicneltzi na tlen niitztoc ininhuaya ni tlacame tlen tlali Mesec huan Cedar.","poem":1},{"lineBreak":true},{"text":"Nelía nitlaijiyohuía tlatlajco inijuanti,","poem":1},{"lineBreak":true},{"text":"pampa niyon se inijuanti ax mitztlepanita, Toteco.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya nisiyajqui para niitztoc ininhuaya ni tlacame tlen ax quinequij ma onca tlasehuilistli.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quema niquincamahuía quejatza hueli tiitztose ica tlasehuilistli,","poem":1},{"lineBreak":true},{"text":"inijuanti quisencahuaj quejatza tlatehuise.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}