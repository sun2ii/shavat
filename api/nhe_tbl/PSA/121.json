{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":121,"content":[{"type":"heading","content":["Toteco yajaya mitzmocuitlahuis"]},{"type":"verse","number":1,"content":[{"text":"Quema nijtlalanas noxayac huan nitlachiyas ipan nopa tepetini,","poem":1},{"lineBreak":true},{"text":"nimoilhuía:","poem":1},{"lineBreak":true},{"text":"“¿Canque huala notlapalehuil?”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Notlapalehuil huala tlen TOTECO,","poem":1},{"lineBreak":true},{"text":"yajaya tlen quichijchijqui elhuicactli huan tlaltepactli.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yajaya ax quema mitzcahuilis para timotepotlamis o tihuetzis.","poem":1},{"lineBreak":true},{"text":"Yajaya mitzmocuitlahuis huan ax monequi cochis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quena, TOTECO tlen quinmocuitlahuía israelitame ax ixijcopi,","poem":1},{"lineBreak":true},{"text":"niyon ax cochi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO yajaya mitzmocuitlahuía.","poem":1},{"lineBreak":true},{"text":"Yajaya itztoc monechca para mitzmanahuis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yajaya mitzmocuitlahuía tonaya huan tlayohua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"TOTECO mitzmocuitlahuis para ax mitzajsis niyon se tlamantli tlen ax cuali.","poem":1},{"lineBreak":true},{"text":"Quena, yajaya quimocuitlahuis moyolis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO yajaya mitzmocuitlahuis campa hueli tiyas o tihualas,","poem":1},{"lineBreak":true},{"text":"ama huan para nochipa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}