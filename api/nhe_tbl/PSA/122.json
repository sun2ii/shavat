{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":122,"content":[{"type":"heading","content":["Tlamaijtoli para ma onca tlasehuilistli ipan altepetl Jerusalén"]},{"type":"verse","number":1,"content":[{"text":"Na nipajqui quema nechilhuijque:","poem":1},{"lineBreak":true},{"text":"“Ma tiyacajya ichaj TOTECO.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pero ama ya tiitztoque nica ipan altepetl Jerusalén.","poem":1},{"lineBreak":true},{"text":"Quena, ya ticalactoque campa ipuertas ipan nopa tepamitl.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalén quisencajtoque para nopano nochi ma mosentilica.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nochi itlacajhua TOTECO ipan tlen hueli hueyi familia tlen israelitame hualahuij nica sesen xihuitl,","poem":1},{"lineBreak":true},{"text":"para quitlascamatise huan quipaquilismacase Toteco senquistoc queja quiijtohua itlajtol.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pampa nopano mosehuía para tetlajtolsencahuas nopa tlanahuatijquetl tlen iixhui David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ximomaijtoca ica TOTECO para ma onca tlasehuilistli ipan altepetl Jerusalén.","poem":1},{"lineBreak":true},{"text":"Xijtiochihua Jerusalén ica ni tlajtoli:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“Ma itztoca cuali nochi tlen quiicnelíaj ni altepetl Jerusalén.","poem":1},{"lineBreak":true},{"text":"Ma onca tlasehuilistli ica calijtic nopa tepamitl tlen quiyahualohua.","poem":1},{"lineBreak":true},{"text":"Ma itztoca ica paquilistli ipan nochi tequicaltini.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pampa niquinicnelía noicnihua huan nohuampoyohua tlen itztoque nica, niquijtohua:","poem":1},{"lineBreak":true},{"text":"“Ma quipiya tlasehuilistli ni altepetl.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pampa niquicnelía ichaj TOTECO tlen mocahua nica,","poem":1},{"lineBreak":true},{"text":"ma onca tlasehuilistli ipan ni altepetl.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}