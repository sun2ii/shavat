{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":123,"content":[{"type":"heading","content":["Tlamaijtoli para Toteco ma quitlasojtla"]},{"type":"verse","number":1,"content":[{"text":"Na nijtlalanas noxayac para nimitztlachilis ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"tlen timosehuijtoc ipan elhuicac.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tojuanti timitztlachilíaj ta,","poem":1},{"lineBreak":true},{"text":"TOTECO toDios, para ma titechtlasojtla san se queja se tlatequipanojquetl quitlachilía iteco,","poem":1},{"lineBreak":true},{"text":"o queja se sihua tlatequipanojquetl quitlachilía iteco isihua para ma quichihuili tlen cuali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"TOTECO, xitechtlasojtla.","poem":1},{"lineBreak":true},{"text":"Quena, xijpiya hueyi moyolo tohuaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ya tisiyajtoque ica nopa tlacame tlen techitaj queja ax tleno topati.","poem":1},{"lineBreak":true},{"text":"Inijuanti tlen mohueyimatij huan tlen itztoque ricos tlahuel techpinajtíaj,","poem":1},{"lineBreak":true},{"text":"hasta ya techyolajsi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}