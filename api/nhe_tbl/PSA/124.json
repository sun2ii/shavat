{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":124,"content":[{"type":"heading","content":["David quihueyimatqui Toteco pampa quimanahui tlen icualancaitacahua"]},{"type":"verse","number":1,"content":[{"text":"Nochi israelitame ma quiijtoca tlachque tijchijtosquíaj intla TOTECO ax itztosquía tohuaya huan ax techpalehuijtosquía.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Intla TOTECO ax itztosquía tohuaya quema nopa tlacame motlalanque para techtehuise,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"techtolojtosquíaj tiyoltoque huan techtzontlamiltijtosquíaj ica ininhueyi cualancayo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inijuanti techhuahuatatztosquíaj queja atl tlatilana,","poem":1},{"lineBreak":true},{"text":"huan huajca eltosquía queja atemitl panotosquía topani.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quena, eltosquía queja topani panotosquía se tlahuelatl tlen tetetztic,","poem":1},{"lineBreak":true},{"text":"tlen tehuahuatatza huan titzonpolijtosquíaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma tijtlascamatica TOTECO pampa ax quincahuili ma techcoco.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Queja se tototl cholohua tlen se tlaquetztli,","poem":1},{"lineBreak":true},{"text":"queja nopa nojquiya Toteco techchololti ininmaco tocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"tlen quinequiyayaj techmasiltise.","poem":1},{"lineBreak":true},{"text":"Nopa laso cotonqui huan tojuanti timocajque timalacantoque.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tojuanti totlapalehuil huala tlen TOTECO,","poem":1},{"lineBreak":true},{"text":"tlen quichijchijqui elhuicactli huan tlaltepactli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}