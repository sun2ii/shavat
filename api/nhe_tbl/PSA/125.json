{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":125,"content":[{"type":"heading","content":["Toteco quinmocuitlahuía itlacajhua"]},{"type":"verse","number":1,"content":[{"text":"Tlacame tlen motemachíaj ipan TOTECO itztoque neltemachme,","poem":1},{"lineBreak":true},{"text":"queja nopa tepetl Sion tlen ax mojmolinía,","poem":1},{"lineBreak":true},{"text":"huan ijcatoc cuali para nochipa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Queja Jerusalén quiyahualojtoque miyac tepetini para quimanahuise,","poem":1},{"lineBreak":true},{"text":"queja nopa nojquiya TOTECO quinyahualojtoc itlacajhua huan quinmanahuía.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toteco ax quincahuilis ma tlanahuatica tlacame tlen fiero inintlalnamiquilis,","poem":1},{"lineBreak":true},{"text":"pampa huelis itlacajhua tlen itztoque xitlahuaque nojquiya pehuasquíaj quichihuasquíaj tlamantli tlen ax cuali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"TOTECO, xiquinchihuili tlen cuali tlacame tlen cuajcualme,","poem":1},{"lineBreak":true},{"text":"huan tlen xitlahuac ininyolo moixtla.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero nopa tlacame tlen moiyocaquixtijtoque tlen nopa ojtli tlen cuali huan yohuij ipan se ojtli tlen ax cuali, xiquinhuica campa tiquintlatzacuiltis.","poem":1},{"lineBreak":true},{"text":"Huan ma onca paquilistli huan tlasehuilistli ipan tlali Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}