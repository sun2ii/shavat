{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":126,"content":[{"type":"heading","content":["Toteco quicualtlalis itlal"]},{"type":"verse","number":1,"content":[{"text":"Quema TOTECO sampa quinhualicas ipan Jerusalén nochi itlacajhua tlen tlatequipanohuaj ipan sequinoc tlaltini,","poem":1},{"lineBreak":true},{"text":"elis queja tijtemiquij.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Nelía tihuetzcase huan tihuicase ica paquilistli!","poem":1},{"lineBreak":true},{"text":"Huan nopa tlacame tlen sequinoc tlaltini quiijtose:","poem":1},{"lineBreak":true},{"text":"“¡Dios quichijtoc huejhueyi tlamantli para nopa israelitame!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quena, nelía melahuac TOTECO techchihuilis huejhueyi tlamantli.","poem":1},{"lineBreak":true},{"text":"¡Ma tipaquica!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"TOTECO, sampa techmacas tlamantli tlen cuali queja tijpixtoyaj achtohuiya.","poem":1},{"lineBreak":true},{"text":"Quena, queja nochi nopa atemitl tlen ajsij ipan nopa huactoc tlali huan quiyancuilía,","poem":1},{"lineBreak":true},{"text":"queja nopa xijyancuili toyolis, TOTECO.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tlen tocaj ica choquistli, ica paquilistli pixcase.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quena, yonque chocatiyase quema quitoctiyase ininxinach,","poem":1},{"lineBreak":true},{"text":"pero quema pixcatij huicatihualase ica paquilistli pampa ya quihualicase tlen quipixcatose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}