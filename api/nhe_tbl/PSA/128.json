{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":128,"content":[{"type":"heading","content":["Cuali ipanti nopa tlacatl tlen quitlepanita Toteco"]},{"type":"verse","number":1,"content":[{"text":"Nelía paqui nopa tlacatl tlen quiimacasi huan quitlepanita TOTECO.","poem":1},{"lineBreak":true},{"text":"Quena, paqui tlen nemi xitlahuac ipan iojhui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quiselis itlaxtlahuil pampa tequiti cuali.","poem":1},{"lineBreak":true},{"text":"Yajaya paquis miyac huan nochi tlen quichihuas quisas cuali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Isihua paquis ipan ichaj.","poem":1},{"lineBreak":true},{"text":"Yajaya elis queja se cuali xocomeca tzontli tlen achi más quimocuitlahuíaj, huan tlen temaca miyac itlajca.","poem":1},{"lineBreak":true},{"text":"Quinpiyas miyac ininconehua tlen mosehuise campa imesa huan quipiyase miyac chicahualistli.","poem":1},{"lineBreak":true},{"text":"Quena, itztose queja olivo cuatini tlen nelía cuali.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Queja nopa TOTECO quitiochihuas nopa tlacatl tlen quiimacasi huan quitlepanita.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO quitiochihuas tlen altepetl Sion.","poem":1},{"lineBreak":true},{"text":"Quicahuilis para quiitas para nochi eltoc cuali ipan Jerusalén nochi tonali tlen iyolis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quicahuilis para itztos hasta quinitas iixhuihua.","poem":1},{"lineBreak":true},{"text":"¡Toteco quimacas tlasehuilistli nopa tlali Israel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}