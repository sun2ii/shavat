{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":129,"content":[{"type":"heading","content":["Ma huetzica tlen quincocolíaj israelitame huan altepetl Jerusalén"]},{"type":"verse","number":1,"content":[{"text":"Nochi israelitame hueli quiijtose para hasta quema pejqui itztose israelitame,","poem":1},{"lineBreak":true},{"text":"huan pejqui timochihuaj se altepetl tlen san se toeso titlacame,","poem":1},{"lineBreak":true},{"text":"tocualancaitacahua techtepotztocatinentoque.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Techcuesolmacatoque hasta quema tiisraelita tlacame tionpejque timoscaltíaj queja se telpocatl.","poem":1},{"lineBreak":true},{"text":"Pero ax quema hueltoque techtzontlamiltíaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tocuitlapa techtlamicocojque quema techmaquiliyayaj hasta huejcajquiya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero TOTECO yajaya nelía xitlahuac,","poem":1},{"lineBreak":true},{"text":"quicotonqui nopa tepos cadenas tlen ica techtatacatzohuayayaj nopa tlacame tlen ax quitlepanitaj TOTECO.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma huetzica ipan se hueyi pinahualistli nochi tlen quicocolíaj altepetl Jerusalén.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma elica queja nopa xihuitl tlen nimantzi pilini huan huaqui pampa ixhuatoc ipan tlali tlen ax huejcatla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quena, ma elica queja nopa xihuitl tlen axaca quimehua,","poem":1},{"lineBreak":true},{"text":"niyon axaca quipixca itlajca pampa ax tleno ipati.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nimitztlajtlanía para niyon se tlen pano nopa fiero tlacame ma ax quintiochihuaca.","poem":1},{"lineBreak":true},{"text":"Axaca ma quiijto:","poem":1},{"lineBreak":true},{"text":"“Ma TOTECO inmechtiochihua.”","poem":1},{"lineBreak":true},{"text":"Niyon ma ax quiijtoca:","poem":1},{"lineBreak":true},{"text":"“Tojuanti timechtiochihuaj ica itequihuejcayo TOTECO.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}