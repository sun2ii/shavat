{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":13,"content":[{"type":"heading","content":["Se tlamaijtoli para quitlajtlanis itlapalehuil TOTECO"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, ¿para nochipa tinechilcajtos?","poem":1},{"lineBreak":true},{"text":"¿Ayoc quema tinechilnamiquis?","poem":1},{"lineBreak":true},{"text":"Nijmati timoixtlatía ica na quema nimitztemohua huan ax tinechchihuilía cuenta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Hasta quema nijpiyas cuesoli ipan noyolo huan noyoltzi tlaijiyohuijtinemis?","poem":1},{"lineBreak":true},{"text":"¿Hasta quema nocualancaitaca noja nechtlanis?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xinechtlachili huan xinechnanquili, TOTECO.","poem":1},{"lineBreak":true},{"text":"¡NoTeco Dios!","poem":1},{"lineBreak":true},{"text":"Xinechmaca tlahuili para nitlachiyas ipan ni tzintlayohuilotl huan ax nimiquis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amo xijcahuili nocualancaitaca ma quiijto nechtlanqui.","poem":1},{"lineBreak":true},{"text":"Amo xinechcahuili ma nihuetzi para ma ax noca huetzcaca inijuanti tlen nechcocolíaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na nimotemachijtoc ipan moteicnelijcayo tlen huejcahua para nochipa.","poem":1},{"lineBreak":true},{"text":"Nipaqui ipan noyolo pampa tinechmaquixtijtoc.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nihuicas para ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa miyac tlen cuali tinechchihuilijtoc.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}