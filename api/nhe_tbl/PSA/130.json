{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":130,"content":[{"type":"heading","content":["Ximotemachica ipan Toteco para inmechmanahuis"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, quema nimopantía ipan se hueyi tlaohuijcayotl,","poem":1},{"lineBreak":true},{"text":"na nimitztzajtzilía para xinechtitlanilis motlapalehuil.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Toteco, xinechtlacaquili quema nimitznojnotza.","poem":1},{"lineBreak":true},{"text":"Xinechchihuili cuenta tlen nimitztlajtlanía huan xinechpalehui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"TOTECO, intla tiquilnamiquisquía nochi totlajtlacolhua,","poem":1},{"lineBreak":true},{"text":"axaca huelisquía moquetzas moixtla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero ta nelía titetlapojpolhuía,","poem":1},{"lineBreak":true},{"text":"para nochi tlacame ma mitztlepanitaca.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na nimochiya ipan ta, TOTECO, para tinechpalehuis,","poem":1},{"lineBreak":true},{"text":"Quena, ica nochi noyolo nimotemachía ipan nopa tlen tinechtlajtolcahuilijtoc ipan motlajtol.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ipan noalma senquistoc nitlachixtoc para ta, TOTECO, xitequiti.","poem":1},{"lineBreak":true},{"text":"Nitlachixtoc para tinechpalehuis,","poem":1},{"lineBreak":true},{"text":"queja nopa tlamocuitlahuiani quichiyaj ma tlanesi.","poem":1},{"lineBreak":true},{"text":"Quena, más nitlachixtoc huan ax queja tlamocuitlahuiani tlen tlahuel quinequij ma tlanesi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nochi inisraelitame, ximotemachica ipan TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa san yajaya quipiya hueyi iyolo huan san yajaya temaquixtía ajachica.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yajaya quinmaquixtis israelitame tlen nochi inintlajtlacolhua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}