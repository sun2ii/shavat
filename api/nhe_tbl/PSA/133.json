footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}