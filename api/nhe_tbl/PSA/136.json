{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":136,"content":[{"type":"heading","content":["Ma tijtlascamatica Toteco"]},{"type":"verse","number":1,"content":[{"text":"Xijtlascamatica TOTECO pampa yajaya nelía cuali,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xijtlascamatica Toteco Dios tlen más hueyi tlen nochi sequinoc “tiotzitzi”,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xijtlascamatica Toteco Dios tlen ininTeco nochi tecojme,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xijtlascamatica TOTECO pampa san ya hueli quichihua huejhueyi tlamantli,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xijtlascamatica yajaya tlen quichijchijqui elhuicactli ica miyac tlalnamiquistli,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xijtlascamatica yajaya tlen quitlali ni tlali ipani atl,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xijtlascamatica yajaya tlen quinchijchijqui nopa tlahuili tlen onca nepa elhuicac,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quichijchijqui nopa tonati para ma tlahui tonaya,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Huan quichijchijqui metztli huan sitlalime para ma tlahuica tlayohua,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xijtlascamatica TOTECO tlen quintzontlamilti nopa achtohui ehuani tlen tlali Egipto,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xijtlascamatica tlen quinquixti israelitame ipan inintlal nopa egiptome,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Quena, quinquixti ica ihueyi chicahualis huan ica inejmatl quinpalehui,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xijtlascamatica yajaya tlen quixelo nopa Hueyi Atl Chichiltic para ma panoca itlacajhua,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Huan quinpanolti nopa israelitame ipan tlali huactoc tlatlajco nopa hueyi atl,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pero quinatzonpolihuilti Faraón huan isoldados ipan nopa hueyi atl,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xijtlascamatica Toteco tlen quinyacanqui itlacajhua ipan nopa huactoc tlali,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Xijtlascamatica yajaya tlen quinmanahui itlacajhua ininmaco tlanahuatiani tlen quipixque miyac chicahualistli,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yajaya quintzontlamilti huejhueyi tlanahuatiani tlen tlahuel quipiyayayaj chicahualistli,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Quitzontlamilti Sehón, inintlanahuatijca nopa amorreos,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nojquiya quimicti Og, tlanahuatijquetl tlen tlali Basán,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Huan inintlal nopa tlanahuatiani,","poem":1},{"lineBreak":true},{"text":"Toteco quinmacac itlacajhua queja se tlamantli tlen inintata quincahuilijtejqui,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Quena, quimacac itlatequipanojca Israel para ma moaxcati nopa tlali para nochipa,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yajaya tlen techilnamijqui tiisraelitame quema ayoc tijpiyayayaj chicahualistli,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yajaya techmanahui ininmaco tocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yajaya quinmaca tlacualistli nochi tlamantli tlen yoltoque,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Xijtlascamatica Toteco Dios tlen quinahuatía elhuicactli,","poem":1},{"lineBreak":true},{"text":"pampa iteicnelijcayo ax quema tlami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}