{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":138,"content":[{"type":"heading","content":["Tlascamatili ipampa itlapalehuil Toteco"]},{"type":"verse","number":1,"content":[{"text":"Ica nochi noyolo nimitztlascamatis, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan nihuicas para ta iniixtla nopa moelhuicac ejcahua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nimotlancuaquetza iixmelac motiopa tlen tlatzejtzeloltic,","poem":1},{"lineBreak":true},{"text":"huan nimitztlascamatis pampa nelía titetlasojtla huan titemachtli.","poem":1},{"lineBreak":true},{"text":"Nochi tlen tinechtlajtolcahuilijtoc para tijchihuas,","poem":1},{"lineBreak":true},{"text":"tijtlamichihuas pampa motlajtol nelía temachtli queja ta titemachtli.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quema nimitztzajtzilía,","poem":1},{"lineBreak":true},{"text":"ta tinechnanquilía huan tinechfuerzajmaca.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"TOTECO, nochi tlanahuatiani tlen itztoque ipan ni tlaltepactli mitztlascamatise,","poem":1},{"lineBreak":true},{"text":"pampa nochi inijuanti quicaquise tlen tijtlajtolcajtoc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Quena, huicase ipampa nochi nopa huejhueyi tlamantli tlen quichijtoc TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa ihueyitilis nelhueyi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yonque TOTECO tlahuel hueyi,","poem":1},{"lineBreak":true},{"text":"yajaya quintlacaquilía tlen moicnonequij.","poem":1},{"lineBreak":true},{"text":"Pero tlen mohueyimatij,","poem":1},{"lineBreak":true},{"text":"monequi moquetzase huejca tlen Toteco,","poem":1},{"lineBreak":true},{"text":"pampa yajaya ax quinequi quinitas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Intla niitztoc ipan tlaijiyohuilistli, ta TOTECO,","poem":1},{"lineBreak":true},{"text":"tinechmanahuía huan tinechmaquixtía.","poem":1},{"lineBreak":true},{"text":"Huan quema nechtehuíaj nocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"ta tijxitlahua moma huan tinechmaquixtía ica mohueyi chicahualis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO, ta tijchihuas nochi tlen timoilhuijtoc para tijchihuas ipan na noyolis.","poem":1},{"lineBreak":true},{"text":"Pampa nopa teicnelijcayotl tlen tijpiya ica na, TOTECO,","poem":1},{"lineBreak":true},{"text":"ax quema tlami.","poem":1},{"lineBreak":true},{"text":"Amo xinechtlahuelcahua pampa ta tinechchijchijqui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}