{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":17,"content":[{"type":"heading","content":["Se tlamaijtoli tlen quitlajtlanía TOTECO ma quimanahuis"]},{"type":"verse","number":1,"content":[{"text":"Xinechtlacaquili, TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa nimitznojnotza.","poem":1},{"lineBreak":true},{"text":"Nijchijtoc tlen xitlahuac,","poem":1},{"lineBreak":true},{"text":"huan ax niistlacati.","poem":1},{"lineBreak":true},{"text":"Xinechtlacaquili tlen nimitztlajtlanía huan xinechpalehui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xinechtlajtolsencahua iniixtla nochi tlacame.","poem":1},{"lineBreak":true},{"text":"Xiquinnextili para ax tleno nijchijtoc,","poem":1},{"lineBreak":true},{"text":"pampa nochipa tijmati tlen xitlahuac.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yonque tijhualtlachilía noyolo ica yohuali huan tinechyejyecojtoc,","poem":1},{"lineBreak":true},{"text":"ax tleno ax cuali tijpantijtoc.","poem":1},{"lineBreak":true},{"text":"Ax niquijtojtoc tlen ax monequi,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"queja quichihuaj ne sequinoc.","poem":1},{"lineBreak":true},{"text":"Na nimoiyocatlalijtoc tlen nopa iniojhui tlen ax cuajcualme.","poem":1},{"lineBreak":true},{"text":"Nijchijtoc senquistoc queja quiijtohua motlanahuatil.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nijtoquilijtoc moojhui huan ax nihuetztoc ipan tlajtlacoli.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nimitznojnotza, noTeco Dios, pampa nijmati tinechnanquilis.","poem":1},{"lineBreak":true},{"text":"Xinechtlacaquili huan xinechchihuili cuenta.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xinechnextili moteicnelijcayo tlen yejyectzi.","poem":1},{"lineBreak":true},{"text":"Taja tiquinmaquixtía ica mochicahualis tlen motemachiyaj ipan ta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xinechmocuitlahui queja se quimocuitlahuía iixsitlal.","poem":1},{"lineBreak":true},{"text":"Queja se piyo quintlatía ipilconehua ieltlapaltzala,","poem":1},{"lineBreak":true},{"text":"nojquiya queja nopa xinechmocuitlahui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xinechtlati tlen nopa ax cuajcualme tlen nechyahualojtoque para nechmictise.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nelía mocualnequij huan quema camatij,","poem":1},{"lineBreak":true},{"text":"san mohueyimatij.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nechtoquilijtinemij campa ninentinemi huan san quichiyaj nopa tlalochtli quema huelise nechmajcahuase tlalchi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Inijuanti itztoque queja tecuanime tlen tlahuel mayanaj huan quinequij tecuase,","poem":1},{"lineBreak":true},{"text":"huan motlatijtoque tlacoyoijtic para quema se tlacatl panos.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ximotlalana, TOTECO,","poem":1},{"lineBreak":true},{"text":"xiquinnamiquiti.","poem":1},{"lineBreak":true},{"text":"Xiquinchihuili ma motlancuaquetzaca moixtla.","poem":1},{"lineBreak":true},{"text":"Ica momachete, xinechmanahui tlen nopa ax cuajcualme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ica mochicahualis, TOTECO,","poem":1},{"lineBreak":true},{"text":"xinechmaquixti ininmaco inijuanti tlen san quipiyaj tlen eltoc ipan ni tlaltepactli.","poem":1},{"lineBreak":true},{"text":"Tijmiyaquilijtoc tlen iniaxca nica.","poem":1},{"lineBreak":true},{"text":"Nojquiya xiquinmaca miyac tlatzacuiltili hasta mocahuas para ininconehua.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pero na niitztoc xitlahuac moixpa,","poem":1},{"lineBreak":true},{"text":"huan se tonal nimitzitas, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan yeca nipaqui.","poem":1},{"lineBreak":true},{"text":"Se tonal quema niisas, nijpiyas nochi tlen nijtemojtinentoc,","poem":1},{"lineBreak":true},{"text":"pampa niitztos monechca huan ica paquilistli timoixtlachilise.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}