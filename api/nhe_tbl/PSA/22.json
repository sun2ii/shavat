{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":22,"content":[{"type":"heading","content":["Se tlacatl quitzajtzilía Toteco huan teipa quipaquilismaca"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios! ¡NoTeco Dios!","poem":1},{"lineBreak":true},{"text":"¿Para tlen tinechtlahuelcajtoc?","poem":1},{"lineBreak":true},{"text":"¿Para tlen timohuejcachijtoc huan ax tihualajtoc para tinechmanahuiqui?","poem":1},{"lineBreak":true},{"text":"Ax tijtlacaquilía quema nimitztzajtzilía.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"NoTeco, tonali huan yohuali ax nimosiyajcahua nimitznotza,","poem":1},{"lineBreak":true},{"text":"pero ax tinechnanquilía.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Huan yonque queja nopa eltoc,","poem":1},{"lineBreak":true},{"text":"ta quejipa titlatzejtzeloltic.","poem":1},{"lineBreak":true},{"text":"Nochi tohuejcapan tatahua tiisraelitame mitzyahualojque huan mitzhueyichijque.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Totatahua mochixque ipan ta.","poem":1},{"lineBreak":true},{"text":"Quena, motemachijque mopan ta huan ta tiquinmanahui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mitznojnotzque quema tlaijiyohuiyayaj huan tiquinmaquixti.","poem":1},{"lineBreak":true},{"text":"Mopan ta motemachijque huan ax tiquinpinahualti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pero na nimomati queja se pilocuiltzi huan ax queja se tlacatl.","poem":1},{"lineBreak":true},{"text":"Sequin san nechhuetzquilíaj huan sequinoc nechcocolíaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nochi tlen nechitaj san noca paquij,","poem":1},{"lineBreak":true},{"text":"huan tlancuitzihuij huan mocuahuihuixohua,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"huan quiijtohuaj:","poem":1},{"lineBreak":true},{"text":"“Yajaya tlen motemachía ipan TOTECO,","poem":1},{"lineBreak":true},{"text":"huajca ma tiquitaca intla quimaquixtis.","poem":1},{"lineBreak":true},{"text":"Intla nelía quiicnelía,","poem":1},{"lineBreak":true},{"text":"ma quimanahuiqui.”","poem":1},"Queja nopa quiijtohuaj tlacame."]},{"type":"verse","number":9,"content":[{"text":"Pero TOTECO, na nijmati para tinechpalehuijtoc.","poem":1},{"lineBreak":true},{"text":"Tinechquixti iijtico nonana.","poem":1},{"lineBreak":true},{"text":"Tinechmocuitlahuijtoc hasta tlen quema noja nichichiyaya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Huan quema nitlacatqui ya ipa nimotemachijtoc ipan ta.","poem":1},{"lineBreak":true},{"text":"Nochi tonali tieltihualajtoc tinoTeco Dios.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amo xinechtlalcahui pampa hualajtoc ni cuesoli huan axaca seyoc tlen huelis nechpalehuis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Miyac nocualancaitacahua nechyahualojtoque queja torojme tlen mosisiníaj.","poem":1},{"lineBreak":true},{"text":"Quena, nesij queja nopa huejhueyi torojme tlen itztoque ipan tlali Basán.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanalcaj queja tecuanime tlen mosisiníaj.","poem":1},{"lineBreak":true},{"text":"Camachalohuaj huan nechmelactlachilíaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Na nimomati queja atl tlen mopatzcatoc huan campa hueli toyajtoc.","poem":1},{"lineBreak":true},{"text":"Nochi noomiyo san lelecuecatoc.","poem":1},{"lineBreak":true},{"text":"Noyolo eltoc queja cera tlen atiya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tlantoc nochi nochicahualis.","poem":1},{"lineBreak":true},{"text":"Nijpiya nocamac huactoc queja se chachapal tepalcatl,","poem":1},{"lineBreak":true},{"text":"huan nonenepil tlatzquitoc ica nocamacholec.","poem":1},{"lineBreak":true},{"text":"Tinechtlalijtoc campa tlahuactoc huan campa onca miquistli.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tlacame tlen ax cuajcualme nechyahualojtoque queja chichime.","poem":1},{"lineBreak":true},{"text":"Quicocoyotztoque noma huan noicxihua.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hasta huelis nijpohuas noomiyohua,","poem":1},{"lineBreak":true},{"text":"pampa sesen nechcocohua.","poem":1},{"lineBreak":true},{"text":"Nocualancaitacahua nechsentlachilijtoque huan san noca paquij.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Momajmacaj tlen nimoquentiyaya.","poem":1},{"lineBreak":true},{"text":"Quena, mahuiltíaj ica piltetzitzi para quiitase ajqueya quitocaros sesen noyoyohua.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pero ta, TOTECO, amo xinechtlalcahui,","poem":1},{"lineBreak":true},{"text":"pampa na niitztoc momaco.","poem":1},{"lineBreak":true},{"text":"Xihuala nimantzi xinechpalehuiqui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Xinechmanahui tlen ininmachete ni mosisinijca tlacame tlen itztoque queja chichime.","poem":1},{"lineBreak":true},{"text":"Amo xiquincahuili ma nechmictica.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Eltoc queja niitztoc inincamaco tecuanime,","poem":1},{"lineBreak":true},{"text":"huajca xinechmaquixti. Nopa tlacame itztoque queja torojme,","poem":1},{"lineBreak":true},{"text":"ma ax nechtompojhuica.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Huan na niquinpohuilis noicnihua tlen ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan quema oncas tlasentilistli,","poem":1},{"lineBreak":true},{"text":"nimitzhueyichihuas iniixpa nochi tlacame.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"TOTECO, tojuanti tlen timitztlepanitaj huan tiquimacasij timitzixpanose timitzpaquilismacaj.","poem":1},{"lineBreak":true},{"text":"Nochi tiiteipa ixhuihua Israel,","poem":1},{"lineBreak":true},{"text":"timitzhueyichihuaj.","poem":1},{"lineBreak":true},{"text":"Quena, timitzhueyimatij nochi tiisraelitame.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Pampa ax titechilcajtoc quema titlaijiyohuíaj,","poem":1},{"lineBreak":true},{"text":"niyon ax titechhuejcamajcajtoc.","poem":1},{"lineBreak":true},{"text":"Ax neli titechixtlatilía.","poem":1},{"lineBreak":true},{"text":"¡Axtle! Ta tinechtlacaquilía quema timitztlajtlaníaj xitechpalehuiqui.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Huajca, TOTECO, ipan nopa hueyi tlasentililistli nimitzpaquilismacas iniixtla nochi motlacajhua,","poem":1},{"lineBreak":true},{"text":"pampa ta titemachtli.","poem":1},{"lineBreak":true},{"text":"Iniixtla tlen mitztlepanitaj huan quiimacasij mitzixpanose,","poem":1},{"lineBreak":true},{"text":"na nijchihuas tlen nimitztencahuilijtoc para nijchihuas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Huajca nochi tlen teicneltzitzi tlacuase huan ixhuise.","poem":1},{"lineBreak":true},{"text":"Nochi tlen quitemohuaj TOTECO quipantise huan quipaquilismacase.","poem":1},{"lineBreak":true},{"text":"Quena, paquise para nochipa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tlacame ipan nochi tlaltini campa hueli ipan tlaltepactli motepotztocase huan quiilnamiquise TOTECO.","poem":1},{"lineBreak":true},{"text":"Inijuanti pehuase quihueyimatise huan motlancuaquetzase iixpa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Pampa TOTECO, yajaya nopa tlanahuatijquetl tlen quinahuatía nochi tlaltini.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nochi tlen quipiyaj tomi huan nochi tlen teicneltzitzi ipan ni tlaltepactli motlancuaquetzase iixpa.","poem":1},{"lineBreak":true},{"text":"Quena, nochi tlaltepac ehuani tlen teipa miquise, quihueyimatise.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nojquiya noteipa ixhuihua quihueyimatise TOTECO huan tepohuilise tlen ya nochi ininnemilis.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Quema toteipa ixhuihua tlacajtiyase,","poem":1},{"lineBreak":true},{"text":"tepohuilise para xitlahuac TOTECO huan nochi nopa huejhueyi tlamantli tlen techchihuilijtoc.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}