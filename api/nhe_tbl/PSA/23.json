{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":23,"content":[{"type":"heading","content":["TOTECO nechmocuitlahuía"]},{"type":"verse","number":1,"content":[{"text":"Queja se tlamocuitlahuijquetl quinmocuitlahuía pilborregojtzitzi,","poem":1},{"lineBreak":true},{"text":"TOTECO nechmocuitlahuía.","poem":1},{"lineBreak":true},{"text":"Huan yeca ax tleno nechpolohua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yajaya nechsehuía campa onca yejyectzi sacatl tlen xoxohuic.","poem":1},{"lineBreak":true},{"text":"Nechhuica campa onca cuali atl tlen ax mahuilili.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quema ayoc hueli nimotlalana,","poem":1},{"lineBreak":true},{"text":"nechmaca yancuic chicahualistli.","poem":1},{"lineBreak":true},{"text":"Yajaya nechyacana ipan ojtli xitlahuac para nijchijtinemis tlen cuali,","poem":1},{"lineBreak":true},{"text":"huan queja nopa nochi quihueyitlalise.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yonque ninemis ipan tzintlayohuilotl nechca miquistli,","poem":1},{"lineBreak":true},{"text":"ax tleno niquimacasis, pampa ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"tiitztoc nohuaya.","poem":1},{"lineBreak":true},{"text":"Ica mocuatopil tinechmanahuía ica tlen ax cuali.","poem":1},{"lineBreak":true},{"text":"Huan ica mocuachijcol tlen huehueyac tinechtilana quema seyoc ojtli nijtoquilisnequi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tinechsencahuilía se cuali tlacualistli iniixtla nocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Ica aceite tinechpajtía campa nimococojtoc.","poem":1},{"lineBreak":true},{"text":"Tinechtiochijtoc hasta mocahua.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nijmati para ta, TOTECO, tinechyacanas nochi noyolis ica moteicnelijcayo,","poem":1},{"lineBreak":true},{"text":"pampa tijpiya hueyi moyolo nohuaya.","poem":1},{"lineBreak":true},{"text":"Huan teipa nimocahuas mohuaya ipan mochaj nepa elhuicac para nochipa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}