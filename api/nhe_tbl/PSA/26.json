{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":26,"content":[{"type":"heading","content":["Nopa nemilistli tlen tlahuel tlapajpactic"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, xinechtlajtolsencahua.","poem":1},{"lineBreak":true},{"text":"Xiteyolmelahua para ax tleno tlen fiero nijchijtoc.","poem":1},{"lineBreak":true},{"text":"Nimotemachijtoc san ipan ta huan ax quema nimoilhuijtoc nimitzcahuas.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xinechyoltlachili, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan xinechyejyeco.","poem":1},{"lineBreak":true},{"text":"Xijtlachili cuali noyolo huan notlalnamiquilis tlen más noyolijtic eltoc.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pampa na nijpatiita moteicnelilis, huan nochipa nijtoquilía motlajtol tlen melahuac.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ax quema ninejnentoc ininhuaya tlacame tlen tlacajcayahuaj,","poem":1},{"lineBreak":true},{"text":"niyon ax nimohuicatoc ininhuaya tlen quipiyaj ome ininxayac.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nijcocolía inintlasentililis ax cuajcualme.","poem":1},{"lineBreak":true},{"text":"Ax quema nimosentilijtoc ininhuaya tlen fiero quichihuaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tlapajpactli noma tlen nochi tlajtlacoli,","poem":1},{"lineBreak":true},{"text":"huan san queja nopa nimonechcahuis motlaixpa, TOTECO.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nepa nihuicas huicatl para nimitzhueyitlalis huan niteyolmelahuas nochi tlen yejyectzi tlen ta tijchijtoc.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tlahuel niquicnelía mochaj campa tiitztoc, TOTECO,","poem":1},{"lineBreak":true},{"text":"campa monextía motlatlanex.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amo xinechchihuili queja tiquinchihuilía tlajtlacolchihuani huan temictiani.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Inijuanti quisencahuaj quejatza huelis tetlacuijcuilise.","poem":1},{"lineBreak":true},{"text":"Quipiyaj ininma temitoc ica tomi tlen tlaixtaca tlainantoque.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pero na ninemi xitlahuac.","poem":1},{"lineBreak":true},{"text":"Xijpiya hueyi moyolo noca na,","poem":1},{"lineBreak":true},{"text":"huan xinechmaquixti.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ipampa ta, cuali niijcatoc,","poem":1},{"lineBreak":true},{"text":"huan ax tinechcahuilijtoc ma nihuetzi.","poem":1},{"lineBreak":true},{"text":"Tlamiyacapa, TOTECO, nimitzhueyichihuas.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}