{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":27,"content":[{"type":"heading","content":["TOTECO nechtlahuilía huan nechmaquixtía"]},{"type":"verse","number":1,"content":[{"text":"TOTECO nechtlahuilía huan nechmaquixtía.","poem":1},{"lineBreak":true},{"text":"¿Ajqueya ma niquimacasis?","poem":1},{"lineBreak":true},{"text":"TOTECO yajaya nochicahualis,","poem":1},{"lineBreak":true},{"text":"huan na niitztoc imaco.","poem":1},{"lineBreak":true},{"text":"Axaca niquimacasis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quema ax cuajcualme quinequise nechtehuise huan quinequise nechmictise,","poem":1},{"lineBreak":true},{"text":"motepotlamise huan huetzise.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yonque nochi isoldados se hueyi tlali motlalanase noixtla,","poem":1},{"lineBreak":true},{"text":"ax niyolmajmahuis.","poem":1},{"lineBreak":true},{"text":"Yonque nechtehuise,","poem":1},{"lineBreak":true},{"text":"na nimotemachijtos ipan TOTECO pampa yajaya itztoc nohuaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"San se tlamantli nijtlajtlanijtoc TOTECO.","poem":1},{"lineBreak":true},{"text":"San se tlamantli nijnequi.","poem":1},{"lineBreak":true},{"text":"Nijnequi niitztos ipan ichaj TOTECO nochi tonali.","poem":1},{"lineBreak":true},{"text":"Nijnequi nijhueyichihuas nepa huan nimopaquilismacas ica nochi ihueyitilis huan itlatlanex.","poem":1},{"lineBreak":true},{"text":"Quena, ipan ichaj nijtemos tlen ya ipaquilis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quema ajsis tonali tlen ax cuali,","poem":1},{"lineBreak":true},{"text":"TOTECO nechmocuitlahuis.","poem":1},{"lineBreak":true},{"text":"Nechtlatis ipan itiopancal campa más tlatzejtzeloltic,","poem":1},{"lineBreak":true},{"text":"huan teipa nechquetzas ipan se hueyi tetl para nechhueyitlalis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quena, nechhueyitlalis iniixtla nocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Yeca na nijtencahuas tlacajcahualistli ipan itiopacal,","poem":1},{"lineBreak":true},{"text":"huan nitzajtzis ica paquilistli.","poem":1},{"lineBreak":true},{"text":"Nihuicas huan nitlatzotzonas para nijpaquilismacas TOTECO.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"TOTECO, xinechtlacaquili pampa nimitznojnotza.","poem":1},{"lineBreak":true},{"text":"Xijpiya hueyi moyolo noca na,","poem":1},{"lineBreak":true},{"text":"huan xinechnanquili.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO, quema tinechilhuía:","poem":1},{"lineBreak":true},{"text":"“Xinechcamahuiqui”,","poem":1},{"lineBreak":true},{"text":"na nimitznanquilía:","poem":1},{"lineBreak":true},{"text":"“Nimitzcamahuiti”.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Amo xinechnenetlatili!","poem":1},{"lineBreak":true},{"text":"¡Amo xinechhuejcamajcahua pampa ticualantoc nohuaya!","poem":1},{"lineBreak":true},{"text":"San ta tlen tinechpalehuía,","poem":1},{"lineBreak":true},{"text":"noTeco Dios, ta tlen tinotemaquixtijca.","poem":1},{"lineBreak":true},{"text":"Amo xinechiyocacahua, niyon amo xinechcajtehua noselti.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yonque notata huan nonana nechtlahuelcahuase,","poem":1},{"lineBreak":true},{"text":"TOTECO, ta nochipa tinechmocuitlahuis.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"TOTECO, xinechnextili tlen tijnequi ma nijchihua.","poem":1},{"lineBreak":true},{"text":"Xinechyacana san ipan nopa ojtli cuali campa tijnequi ma ninejnemi,","poem":1},{"lineBreak":true},{"text":"pampa nocualancaitacahua nechyahualohuaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Amo xinechtemactili ininmaco queja inijuanti quinequij,","poem":1},{"lineBreak":true},{"text":"pampa noca na motlalantoque tlacame tlen istlacatij huan san quimatij tlen más fiero nechchihuilise.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pero na cuali nijmati TOTECO nechmanahuis,","poem":1},{"lineBreak":true},{"text":"huan sampa niquitas quejatza cuali iyolo nohuaya ipan ni tlaltepactli campa niitztoc.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ximochiya ipan TOTECO.","poem":1},{"lineBreak":true},{"text":"Ximotemaca huan ximosemaca huan amo ximomajmati.","poem":1},{"lineBreak":true},{"text":"Quena, ximotemachi ipan TOTECO.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}