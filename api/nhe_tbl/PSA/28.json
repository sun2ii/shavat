{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":28,"content":[{"type":"heading","content":["Toteco quitlacaquilía quema timomaijtohuaj"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, tinotlamanahuijca.","poem":1},{"lineBreak":true},{"text":"San ipan ta nimotlatía.","poem":1},{"lineBreak":true},{"text":"Ta tlen nimitztzajtzilía xinechpalehuiqui.","poem":1},{"lineBreak":true},{"text":"Amo ximotlahuelnequi para tinechnanquilis,","poem":1},{"lineBreak":true},{"text":"pampa intla ax tinechnanquilis,","poem":1},{"lineBreak":true},{"text":"san nimotemacas para ma nechmictica.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xijcaqui notlajtol quema nimitztlajtlanía tlapalehuili.","poem":1},{"lineBreak":true},{"text":"Xinechchihuili cuenta quema nimomatlalanas huan nijmelactlachilis mocaltiopa tlen tlahuel tlatzejtzeloltic.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amo xinechtlatzacuilti ininhuaya tlacame tlen ax cuajcualme tlen san quichihuaj tlen ax monequi.","poem":1},{"lineBreak":true},{"text":"Inijuanti camatij yejyectzi ica sequinoc,","poem":1},{"lineBreak":true},{"text":"pero quipiyaj nochi tlen ax cuali ipan ininyolo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xiquincuepili nochi tlen ax cuali quichijtoque ica tlen ax cuali nojquiya.","poem":1},{"lineBreak":true},{"text":"Xiquintlaxtlahui ica tlen fiero san se queja fiero quinchihuilijtoque sequinoc.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO, inijuanti ax quichihuilíaj cuenta nochi tlen tijchijtoc,","poem":1},{"lineBreak":true},{"text":"huajca tiquintzontlamiltis huan ax quema tiquintlalanas sampa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"TOTECO, nimitzpaquilismacas pampa tijtlacaquilijtoc tlen nimitztlajtlanijtoc.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"TOTECO, yajaya nochicahualis huan notlamanahuijca ica nochi tlen mahuilili.","poem":1},{"lineBreak":true},{"text":"Ipan ya nimoneltemachijtoc huan nechpalehuijtoc,","poem":1},{"lineBreak":true},{"text":"yeca ipan noyolo nijpiya miyac paquilistli.","poem":1},{"lineBreak":true},{"text":"Nihuicas huan nimitztlascamatis, TOTECO.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO, ta tiquinpixtoc momaco nochi motlacajhua.","poem":1},{"lineBreak":true},{"text":"Yeca san ipan ta motemachía motlanahuatijca tlen tijtlapejpenijtoc.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xijmaquixti moaltepe, TOTECO.","poem":1},{"lineBreak":true},{"text":"Huan xiquintiochihua inijuanti tlen moaxcahua.","poem":1},{"lineBreak":true},{"text":"Xitechmocuitlahui queja se quinmocuitlahuía ipilborregojhua.","poem":1},{"lineBreak":true},{"text":"Xitechhuica momaco para nochipa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}