{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":3,"content":[{"type":"heading","content":["Se tlamaijtoli para Toteco Dios ma quipalehui"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, nelía momiyaquilíaj nocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Quena, nelmiyac motlalanaj para nechtehuise.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Miyac quiijtohuaj para ta ax quema tinechpalehuis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pero TOTECO, ta tinechyahualohua para tinechmanahuis.","poem":1},{"lineBreak":true},{"text":"Ta tlen tinechhueyitlalía huan san ta tlen tihueli tinechyolchicahua.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chicahuac nimitztzajtzili, TOTECO,","poem":1},{"lineBreak":true},{"text":"para tinechpalehuis.","poem":1},{"lineBreak":true},{"text":"Huan ta tinechnanquili hasta campa tionitztoc nepa ipan motepe tlen tlatzejtzeloltic.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yeca nimotejqui huan cuali nicochqui.","poem":1},{"lineBreak":true},{"text":"Huan quema niisac,","poem":1},{"lineBreak":true},{"text":"ax tleno nopantitoya pampa ta, TOTECO, tinechmocuitlahuía.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ama ayoc nechmajmatise yonque majtlactli mil nocualancaitacahua nechyahualose para nechtehuise.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ximotlalana, TOTECO.","poem":1},{"lineBreak":true},{"text":"Xinechmaquixti, ta tinoTeco Dios.","poem":1},{"lineBreak":true},{"text":"Chicahuac xiquinmaquili nochi nocualancaitacahua ipan ininxayac.","poem":1},{"lineBreak":true},{"text":"Xiquintlanpojpostequi nopa mosisinijca tlacame,","poem":1},{"lineBreak":true},{"text":"para tlamis nochi ininchicahualis huan ax tleno huelis nechchihuilise.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"San ta, TOTECO, hueli titemaquixtía.","poem":1},{"lineBreak":true},{"text":"Hueyi paquilistli quipiyaj nochi motlacajhua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}