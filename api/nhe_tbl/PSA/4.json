{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":4,"content":[{"type":"heading","content":["Monequi timotemachise ipan Toteco Dios"]},{"type":"verse","number":1,"content":[{"text":"Toteco Dios, ta tinechchijtoc nixitlahuac moixpa,","poem":1},{"lineBreak":true},{"text":"Nimitztlajtlanía, xinechnanquili quema nimitznojnotza.","poem":1},{"lineBreak":true},{"text":"Ta tlen nochipa tinechpalehuía quema nitlaijiyohuía,","poem":1},{"lineBreak":true},{"text":"ama sampa xinechtlasojtla huan xijcaqui quema nimomaijtohua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Huan Toteco quinanquili:","poem":1},{"lineBreak":true},{"text":"“Intlacame, xijtlacaquilica ya ni:","poem":1},{"lineBreak":true},{"text":"¿Hasta quema tlamis para noca inpaquise,","poem":1},{"lineBreak":true},{"text":"tlen más quinamiqui nijselis tlatlepanitacayotl?","poem":1},{"lineBreak":true},{"text":"¿Hasta quema tlamis inquinhueyichihuase tlaixcopincayome tlen ax neli ya Tecojtli?","poem":1},{"lineBreak":true},{"text":"¿Hasta quema tlamis inmocahuilise ma inmechcajcayahuaca?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Intlacame, xijmatica ya ni.","poem":1},{"lineBreak":true},{"text":"TOTECO techiyocatlalijtoc para tiiaxcahuaj nochi tojuanti tlen techcojtoc.","poem":1},{"lineBreak":true},{"text":"Huan yajaya nechtlacaquilía quema nijnojnotza huan nechchihuilía tlen nijtlajtlanía.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yonque inhuihuipicaj ica cualantli,","poem":1},{"lineBreak":true},{"text":"amo xitlajtlacolchihuaca.","poem":1},{"lineBreak":true},{"text":"Quema inmotectose ipan imotlapech huan ax tleno molinía,","poem":1},{"lineBreak":true},{"text":"ximoyolilhuica tlen eltoc ipan imoyolo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xijchihuaca tlen quinequi TOTECO huan ya nopa elis queja inquimacasquíaj se tlacajcahualistli tlen quipactía.","poem":1},{"lineBreak":true},{"text":"Quena, ximotemachica ipan ya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Miyac quiijtohuaj:","poem":1},{"lineBreak":true},{"text":"“Axaca huelis techpalehuis.”","poem":1},{"lineBreak":true},{"text":"Pero ta tihueli, TOTECO.","poem":1},{"lineBreak":true},{"text":"Titechcualita huan titechtiochihua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ta tijtlalijtoc ipan noyolo más paquilistli,","poem":1},{"lineBreak":true},{"text":"huan ax queja tlen quipiyaj tlacame tlen quipixcaj miyac trigo,","poem":1},{"lineBreak":true},{"text":"o quipiyaj miyac xocomecatl iayo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yeca na nimotecas ica paquilistli ipan noyolo huan ica cuali nicochis,","poem":1},{"lineBreak":true},{"text":"pampa nijmati san ta, TOTECO, tinechmanahuía huan axaca huelis tleno nechchihuilis.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}