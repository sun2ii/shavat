{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":42,"content":[{"type":"heading","content":["Israelitame tlen quinhuicatoque ipan seyoc tlali quiilnamiquij inintlal"]},{"type":"verse","number":1,"content":[{"text":"Queja se masatl tlen tlahuel amiqui quitemojtinemi se atlajtli para atlis,","poem":1},{"lineBreak":true},{"text":"queja nopa na nimitzyoltemohua, noTeco Dios.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quena, queja se tlen tlahuel amiqui,","poem":1},{"lineBreak":true},{"text":"na ipan noyolo nimitznequi Toteco,","poem":1},{"lineBreak":true},{"text":"ta tlen nelnelía tiitztoc.","poem":1},{"lineBreak":true},{"text":"¿Hasta quema huelis niyas huan nimonextis moixpa?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yohuali huan tonali nichoca huan ax nitlacua.","poem":1},{"lineBreak":true},{"text":"Nocualancaitacahua ajachica nechtlatzintoquilíaj:","poem":1},{"lineBreak":true},{"text":"“¿Canque itztoc moDios?","poem":1},{"lineBreak":true},{"text":"¿Para tlen ax mitzpalehuía?”","poem":1},{"lineBreak":true},{"text":"Queja nopa nechilhuía.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Quema niquilnamiqui queja eliyaya achtohuiya nepa ipan notlal, eltoc queja atiya noyolo.","poem":1},{"lineBreak":true},{"text":"Niyohuiyaya ininhuaya miyac tlacame hasta ichaj Toteco Dios.","poem":1},{"lineBreak":true},{"text":"Na niquinyacanayaya nochi tlacame hasta ichaj ipan nopa hueyi ilhuitl.","poem":1},{"lineBreak":true},{"text":"Titzajtzitiyohuiyayaj ica paquilistli,","poem":1},{"lineBreak":true},{"text":"huan tijtlascamatiyayaj Toteco Dios pampa para ya tiilhuichihuayayaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Huajca nimoilhuía:","poem":1},{"lineBreak":true},{"text":"Ax monequi nimocuesos.","poem":1},{"lineBreak":true},{"text":"Na nimotemachijtoc ipan noTeco Dios,","poem":1},{"lineBreak":true},{"text":"huan sampa nijpaquilismacas,","poem":1},{"lineBreak":true},{"text":"pampa yajaya noDios huan notemaquixtijca.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pero noTeco, nelía nimocuesohua nica campa niitztoc ipan ni tlali tlen huejca.","poem":1},{"lineBreak":true},{"text":"Yeca nimitzilnamiquis,","poem":1},{"lineBreak":true},{"text":"huan niquilnamiquis queja tijpixqui hueyi moyolo tohuaya tlen tiehuaj ipan motlal.","poem":1},{"lineBreak":true},{"text":"Niquilnamiqui nopa tlali yejyectzi tlen pehua campa motlalohua nopa atlajtli Jordán,","poem":1},{"lineBreak":true},{"text":"huan ontlami hasta campa motlalantoc nopa tepetini Hermón huan Mizar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ama ta tinechtitlanilijtoc cuesoli tlen nechijiyomictía.","poem":1},{"lineBreak":true},{"text":"Quena, miyac cuesoli nechajsitoc queja imiyaca atl tlen huetzi tlen tepexico hasta ipan na.","poem":1},{"lineBreak":true},{"text":"Caquisti queja miyac atl tlen ajcahuacatoc,","poem":1},{"lineBreak":true},{"text":"huan nochi nopa atl nopan panotoc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Pero ica ijnaloc TOTECO nechtitlanilis iteicnelilis.","poem":1},{"lineBreak":true},{"text":"Huan ica tlayohua yajaya nechmacas se huicatl para nijhueyichihuas,","poem":1},{"lineBreak":true},{"text":"huan nimomaijtohua ica ya.","poem":1},{"lineBreak":true},{"text":"Quena, nijnojnotza NoTeco tlen mojmostla nechmaca yolistli.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Niquilhuis Toteco Dios:","poem":1},{"lineBreak":true},{"text":"“Ipan ta nimotlatía huan axaca hueli nechajsis.","poem":1},{"lineBreak":true},{"text":"¿Para tlen tinechilcajtoc?","poem":1},{"lineBreak":true},{"text":"Na san nimocuesojtinemi,","poem":1},{"lineBreak":true},{"text":"pampa nocualancaitacahua nechtlaijiyohuiltíaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tlen nocualancaitacahua nechchihuilíaj nechcocohua hasta ajsi ipan noomiyohua,","poem":1},{"lineBreak":true},{"text":"pampa nechtlaijilhuíaj huan nechtlatzintoquilíaj ajachica:","poem":1},{"lineBreak":true},{"text":"‘¿Canque itztoc moDios?","poem":1},{"lineBreak":true},{"text":"¿Para tlen ax mitzpalehuía?’”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pero ax monequi nimocuesolmacas,","poem":1},{"lineBreak":true},{"text":"niyon nimocuesos.","poem":1},{"lineBreak":true},{"text":"Na nimotemachijtoc ipan noTeco Dios,","poem":1},{"lineBreak":true},{"text":"huan teipa sampa nijpaquilismacas pampa yajaya noDios huan noTemaquixtijca.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}