{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":43,"content":[{"type":"heading","content":["Se tlamaijtoli para Toteco ma quincuepa ipan inintlal"]},{"type":"verse","number":1,"content":[{"text":"NoTeco Dios, xinechtlajtolsencahua xitlahuac huan xitenextili para ax tleno nijchijtoc.","poem":1},{"lineBreak":true},{"text":"Xinechmanahui tlen ni istlacatica tlacame huan ax cuajcualme tlen nechtelhuíaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pampa san ta tinoTeco huan tinoDios huan notlamanahuijca na.","poem":1},{"lineBreak":true},{"text":"¿Para tlen tinechtlahuelcajtoc?","poem":1},{"lineBreak":true},{"text":"Nimocuesojtinemi huan más nechtlaijiyohuiltíaj nocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"huan ax tleno tijchihua.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toteco Dios, xinechyacana ica motlahuil huan xinechnextili tlen melahuac.","poem":1},{"lineBreak":true},{"text":"Queja nopa, quena, huelis nimocuepas motlal huan campa motepe tlen tlatzejtzeloltic campa ta tiitztoc ipan motiopancal.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quena, noTeco Dios, nicalaquis huan niajsiti hasta motlaixpa campa tlacame mitzhueyichihuaj.","poem":1},{"lineBreak":true},{"text":"Nepa nimitzpaquilismacas ica arpa, ta tlen tinechmaca paquilistli,","poem":1},{"lineBreak":true},{"text":"pampa ta tinoTeco Dios.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"San tlapic nimocuesos.","poem":1},{"lineBreak":true},{"text":"Na nimotemachijtoc ipan ta, noTeco Dios, huan sampa nimitzpaquilismacas,","poem":1},{"lineBreak":true},{"text":"pampa, ta tinoDios, huan tinotemaquixtijca.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}