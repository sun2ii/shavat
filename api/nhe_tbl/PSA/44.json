{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":44,"content":[{"type":"heading","content":["Se tlacatl quitlajtlanía Toteco ma quimocuitlahuis"]},{"type":"verse","number":1,"content":[{"text":"Toteco Dios, tijcactoque tlachque techpohuilijtoque tohuejcapan tatahua tlen ta,","poem":1},{"lineBreak":true},{"text":"huan nochi nopa tlamantli tlen tiquinchihuili huejcajquiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quena, Toteco Dios, ica mohueyi chicahualis ta tiquintojtocac nopa fiero tlacame tlen quinhueyichihuayayaj teteyome ipan nopa tlali,","poem":1},{"lineBreak":true},{"text":"huan nopa tlali tiquinmacac totatahua.","poem":1},{"lineBreak":true},{"text":"Quena, tiquintlatzacuilti ne sequinoc huan tiquinpalehui tohuejcapan tatahua para ma momiyaquilica,","poem":1},{"lineBreak":true},{"text":"huan ma moaxcatica.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tohuejcapan tatahua ax quitlanque nopa tlali ica ininmachete, niyon ica ininchicahualis.","poem":1},{"lineBreak":true},{"text":"Tlatlanque ica nopa hueyi chicahualistli tlen ta tijpiya ipan monejmatl,","poem":1},{"lineBreak":true},{"text":"huan pampa hueyi moyolo ininhuaya,","poem":1},{"lineBreak":true},{"text":"huan achi más tiquinicnelía.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ta tinotlanahuatijca huan tinoTeco Dios.","poem":1},{"lineBreak":true},{"text":"Ta tiquinmanahuía huan tijchihua ma tlatlanica motlacajhua.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quena, ica motlapalehuil tiquintlanise tocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Huan ica mochicahualis ininpan timoquejquetzase tlen techtehuíaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pampa ax timotemachíaj ipan tocuahuitol huan tomachete para ma timomanahuica huan titlatlanise.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Eltoc ta, Toteco, tlen tijchihua ma tiquintlanica tocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Ta tiquinpinahualtijtoc nochi tlen techcocolíaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mojmostla timitzpaquilismacase Toteco Dios.","poem":1},{"lineBreak":true},{"text":"Huan timitzhueyichihuase ica huicatl para nochipa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pero amantzi eltoc queja titechtlahuelcajtoc huan titechpinahualtijtoc.","poem":1},{"lineBreak":true},{"text":"Niyon ayoc tinemi ininhuaya tosoldados quema tiontlatehuíaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tijchijqui ma ticholoca iniixpa tocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Quena, inijuanti tlen techcocolíaj techtlaxtequilíaj huan quihuicaj nochi tlen quinequij.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Titechtemactilijtoc queja tipilborregojtzitzi tlen san quichiyaj para quinhuicase campa quinmictise.","poem":1},{"lineBreak":true},{"text":"Huan titechsemantoc campa hueli ipan sequinoc tlaltini campa quinhueyichihuaj teteyome.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Titechnamacatoc timotlacajhua ica nelquentzi queja ax tleno topati elisquía.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nochi tlacame ipan nopa tlaltini tlen itztoque tonechca quiitaque tlen titechchihuilijtoc.","poem":1},{"lineBreak":true},{"text":"Yeca techtlaijilhuíaj huan toca paquij.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tijchijtoc para inijuanti tlen quinhueyichihuaj tlaixcopincayome ma toca huetzcaca.","poem":1},{"lineBreak":true},{"text":"Nochi quema techitaj, motzonhuihuixohuaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mojmostla toixpa eltoc nopa pinahualistli hasta tijnequisquíaj timoixtzacuase,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"pampa techtlaijilhuíaj huan techhuetzquilíaj nopa motlacuepilijca tlacame.","poem":1},{"lineBreak":true},{"text":"Quena, techpinahualtíaj tocualancaitacahua.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nochi ni tlamantli topantitoc,","poem":1},{"lineBreak":true},{"text":"yonque ax timitzilcajtoque,","poem":1},{"lineBreak":true},{"text":"niyon ax timoiyocacajtoque tlen nopa tlajtol sencahuali tlen tijchijqui ininhuaya tohuejcapan tatahua.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ax timoiyocatlalijtoque tlen ta,","poem":1},{"lineBreak":true},{"text":"niyon ax tijcajtejtoque moojhui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pero titechtlahuelcajtoc campa axaca itztoc,","poem":1},{"lineBreak":true},{"text":"campa san itztoque tlapiyalime tlen mosisiníaj.","poem":1},{"lineBreak":true},{"text":"Titechcajtoc ipan se tzintlayohuilotl tlen eltoc queja miquistli.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Toteco Dios, intla timitzilcajtosquíaj,","poem":1},{"lineBreak":true},{"text":"o tijhueyichijtosquíaj se totlaixcopincayo,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ta tijmajtosquía,","poem":1},{"lineBreak":true},{"text":"pampa ta tijmati nochi tlen ixtacatzi eltoc ipan toyolo.","poem":1},{"lineBreak":true},{"text":"Pero ax tijchijtoque, Toteco.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Pero yonque ax tleno tijchijtoque,","poem":1},{"lineBreak":true},{"text":"mopampa ta tiitztoque nechca miquistli.","poem":1},{"lineBreak":true},{"text":"Titechchihuilíaj queja tipilborregojtzitzi tlen san quichiyaj ajqueya quinmictis pampa timoaxcahua.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"¡Toteco ximotlalana!","poem":1},{"lineBreak":true},{"text":"¡Amo xicochi!","poem":1},{"lineBreak":true},{"text":"Amo ximoiyocatlali tlen tojuanti para nochipa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"¿Para tlen timoixtlatía?","poem":1},{"lineBreak":true},{"text":"Eltoc queja tiquilcajtoc para tojuanti titlaijiyohuíaj huan miyac techcocolíaj.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Techmajcajtoque tlalchi.","poem":1},{"lineBreak":true},{"text":"Toxayac mocahua ipan tlaltejpoctli huan ax hueli timotlalanase.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"¡Ximotlalana, Toteco!","poem":1},{"lineBreak":true},{"text":"Xitechpalehuiqui.","poem":1},{"lineBreak":true},{"text":"Xitechmaquixti pampa tlahuel titechicnelía.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}