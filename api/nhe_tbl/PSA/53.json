{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":53,"content":[{"type":"heading","content":["Tlacame tlen huihuitique"]},{"type":"verse","number":1,"content":[{"text":"San se tlacatl tlen tlahuel huihuitic moilhuisquía ipan iyolo para ax onca Dios.","poem":1},{"lineBreak":true},{"text":"¿Para tlen queja nopa quiijtosquía?","poem":1},{"lineBreak":true},{"text":"Eltoc pampa iyolo tlahuel fiero huan san quichihua tlen ax cuali.","poem":1},{"lineBreak":true},{"text":"Axaca se tlacatl tlen quichihua tlen nelxitlahuac.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Toteco Dios hasta nepa elhuicac quinhualtlachilía tlacame,","poem":1},{"lineBreak":true},{"text":"para quiitas intla onca se tlen nelía quitemohua huan quichihua tlen cuali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Pero axtle!","poem":1},{"lineBreak":true},{"text":"Nochi tlacame mocueptoque ipan tlajtlacoli.","poem":1},{"lineBreak":true},{"text":"Quena, nochi tlajtlacolchijtoque huan moijtlacojtoque.","poem":1},{"lineBreak":true},{"text":"Axaca quichihua tlen senquistoc cuali,","poem":1},{"lineBreak":true},{"text":"niyon se.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ax quipiyaj inintlalnamiquilis nopa tlajtlacolchijca tlacame.","poem":1},{"lineBreak":true},{"text":"Inijuanti quintzontlamiltíaj motlacajhua queja elisquíaj pantzi tlen quicuaj huan ax quinequij quitemose Toteco Dios.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero ajsis tonali quema Toteco Dios quinpinahualtis huan quintlatzacuiltis nopa tlacame.","poem":1},{"lineBreak":true},{"text":"Quena, quintzontlamiltis huan inintlacayohua mocahuase tepejtoque campa hueli.","poem":1},{"lineBreak":true},{"text":"Axaca quintlalpachos pampa yajaya quintlahuelcajtoc.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Cuali elisquía intla Toteco hualasquía tlen altepetl Jerusalén huan quinmaquixtis nochi israelitame!","poem":1},{"lineBreak":true},{"text":"Israelitame san huelis itztose ica paquilistli quema Toteco Dios quichihuas para inijuanti tlen itlacajhua ma tlatlanica.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}