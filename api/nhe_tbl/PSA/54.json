{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":54,"content":[{"type":"heading","content":["Se tlamaijtoli para Toteco ma quimanahui tlen icualancaitacahua"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios, xihuala xinechmaquixtiqui pampa nochi quimatij ta tihueyi!","poem":1},{"lineBreak":true},{"text":"¡Xinechmanahuiqui ica mohueyi chicahualis!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xinechtlacaquili quema nimomaijtohua ica ta.","poem":1},{"lineBreak":true},{"text":"Quena, xijtlacaquili tlen nimitzpohuilía,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"pampa tlatehuijca tlacame motlanantoque ica na.","poem":1},{"lineBreak":true},{"text":"Quena, tlacame tlen ax quema mitzilnamiquij nechtemohuaj para nechmictise.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pero Toteco Dios nochipa nechpalehuía,","poem":1},{"lineBreak":true},{"text":"huan ax quincahuilis ma nechmictica.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Toteco quincuepilis nocualancaitacahua nochi nopa tlamantli ax cuali tlen inijuanti quisencajtoque nechchihuilise.","poem":1},{"lineBreak":true},{"text":"Quena, TOTECO, ta tlen nelía titemachtli, xijchihua senquistoc queja tinechtencahuilijtoc,","poem":1},{"lineBreak":true},{"text":"huan xiquintzontlamilti nochi nocualancaitacahua.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ica paquilistli nimitzmacas notlacajcahualis.","poem":1},{"lineBreak":true},{"text":"Nimitzhueyimatis pampa ta nelía ticuali,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"pampa ta tinechmanahuijtoc tlen nochi tlaohuijcayotl,","poem":1},{"lineBreak":true},{"text":"huan niquitztoc quejatza tiquintlantoc nochi nocualancaitacahua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}