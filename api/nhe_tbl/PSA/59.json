{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":59,"content":[{"type":"heading","content":["Se tlamaijtoli para Toteco ma quimanahui David"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios, xinechmanahui ininmaco nocualancaitacahua!","poem":1},{"lineBreak":true},{"text":"¡Xinechmocuitlahui tlen inijuanti tlen hualajtoque para nechtzontlamiltise!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Xinechmanahui ininmaco tlajtlacolchijca tlacame,","poem":1},{"lineBreak":true},{"text":"inijuanti tlen temictíaj!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nechpijpiyaj para quiitase quejatza nechmictise.","poem":1},{"lineBreak":true},{"text":"Tlacame tlen quipiyaj chicahualistli nechchixtoque yahualtic.","poem":1},{"lineBreak":true},{"text":"Pero ax pampa niquinchihuilijtoc se tlamantli tlen ax cuali","poem":1},{"lineBreak":true},{"text":"o pampa niquinixpanotoc.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Axtle! Ax tleno tlen fiero niquinchihuilijtoc,","poem":1},{"lineBreak":true},{"text":"pero inijuanti mocualtlalíaj para nechmictise.","poem":1},{"lineBreak":true},{"text":"¡TOTECO, xiisa!","poem":1},{"lineBreak":true},{"text":"¡Xihuala xinechpalehuiqui!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO, Ta Tlen Tiquinyacana Moelhuicac Ejcahua Ma Tlatlanitij,","poem":1},{"lineBreak":true},{"text":"ta tlen titoDios tiisraelitame,","poem":1},{"lineBreak":true},{"text":"ximotlalana huan xiquintlatzacuilti nopa tlaltini tlen ax mitztlepanitaj.","poem":1},{"lineBreak":true},{"text":"Amo xiquintlapojpolhui nopa tlacame tlen mosisiníaj huan nimantzi tlaixpanoj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mojmostla ica tlapoyahui hualahuij para quitlachilise quejatza huelis techtlanise.","poem":1},{"lineBreak":true},{"text":"Tzajtzitinemij queja chichime tlen quiyahualojtinemij ni altepetl.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nijcaqui camatij fiero hasta camaposonij,","poem":1},{"lineBreak":true},{"text":"huan mitztelchihuaj Toteco,","poem":1},{"lineBreak":true},{"text":"pampa inijuanti quiijtohuaj:","poem":1},{"lineBreak":true},{"text":"“Axaca techcaqui.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pero ta TOTECO, san xiquinhuetzquili,","poem":1},{"lineBreak":true},{"text":"huan xiquinpinahualti ni tlacame tlen sequinoc tlaltini.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"NoTeco Dios, pampa nocualancaitacahua quipiyaj chicahualistli, ipan ta nimotemachis,","poem":1},{"lineBreak":true},{"text":"pampa ta tlen tinechmanahuía.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"NoTeco Dios, ta nochipa tinechicnelijtoc miyac,","poem":1},{"lineBreak":true},{"text":"yeca nijmati para temachtli tinechyacantiyas.","poem":1},{"lineBreak":true},{"text":"Tijchihuas ma niquitas tlen tlahuel nijnectoc ma ininpanti nocualancaitacahua.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"NoTeco, ta tlen tinechmanahuía,","poem":1},{"lineBreak":true},{"text":"amo xiquinmicti nimantzi ni nocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"pampa huelis ni notlacajhua nimantzi quiilcahuase tlen ininpantis nopa mosisinijca tlacame.","poem":1},{"lineBreak":true},{"text":"Más cuali san xiquinsemana ica mohueyi chicahualis huan xiquinechcapantlali.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Quena, xiquintlatzacuilti pampa nochi inijuanti tlahuel istlacatij, mohueyimatij huan tlatelchihuaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xiquintzontlamilti ica mohueyi cualancayo,","poem":1},{"lineBreak":true},{"text":"huan xiquintlamiixpolihuilti.","poem":1},{"lineBreak":true},{"text":"Huan queja nopa nochi tlacame quimatise para ta, Toteco Dios,","poem":1},{"lineBreak":true},{"text":"titlanahuatía ipan tlali Israel,","poem":1},{"lineBreak":true},{"text":"huan ipan nochi tlaltepactli.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nocualancaitacahua mocuepaj ica tiotlac huan tzajtzij queja chichime,","poem":1},{"lineBreak":true},{"text":"huan quiyahualojtinemij ni altepetl.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nentinemij campa hueli para quitemojtinemise inintlacualis.","poem":1},{"lineBreak":true},{"text":"Huan quema ax ixhuise,","poem":1},{"lineBreak":true},{"text":"tzajtzij seyohual queja chichime.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pero na sesen ijnaloc nihuicas ica nopa chicahualistli tlen tinechmaca.","poem":1},{"lineBreak":true},{"text":"Huan nimitzhueyimatis pampa tinechtlasojtla miyac.","poem":1},{"lineBreak":true},{"text":"San ta tinechmanahuía huan san ipan ta nimotemachía,","poem":1},{"lineBreak":true},{"text":"quema huala tlaohuijcayotl.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Toteco Dios, momaco ta niitztoc temachtli,","poem":1},{"lineBreak":true},{"text":"yeca nimitzhueyimatis huan nihuicas para ta,","poem":1},{"lineBreak":true},{"text":"pampa san ta tinechmocuitlahuía huan tinechicnelía.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}