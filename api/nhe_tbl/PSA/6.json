{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":6,"content":[{"type":"heading","content":["Quejatza ma timomaijtoca quema timocuesohuaj"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, amo xinechajhua quema ticualani.","poem":1},{"lineBreak":true},{"text":"Amo xinechtlatzacuilti quema tlahuel ticualantoc.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xinechtlasojtla, pampa nimococohua.","poem":1},{"lineBreak":true},{"text":"TOTECO, xinechchicahua, pampa tlahuel nechcocohua nochi notlacayo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nihuihuipica ica majmajtli huan ax nijmati tlachque nijchihuas.","poem":1},{"lineBreak":true},{"text":"Huan ta TOTECO, ¿hasta quema tihualas para tinechtlalanas?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xihuala, TOTECO, xinechmanahuiqui para ax nimiquis.","poem":1},{"lineBreak":true},{"text":"Xinechmaquixti pampa tlahuel tinechicnelía.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Axaca tlen mictoc huelis mitzilnamiquis.","poem":1},{"lineBreak":true},{"text":"¿Ajqueya huelis mitzhueyichihuas intla mictoc huan ya quitlalpachojtoque?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya tlanqui nofuerza ica choquistli.","poem":1},{"lineBreak":true},{"text":"Sesen yohuali nichoca miyac hasta nijtlamixolonía notzonteto.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nichocatoc miyac hasta nechcocohua noixtiyol huan ayoc hueli nitlachiya.","poem":1},{"lineBreak":true},{"text":"Quena, nichoca quema nimoilhuía tlen nocualancaitacahua nechchihuilijtoque.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xinechtlalcahuica, tlajtlacolchijca tlacame,","poem":1},{"lineBreak":true},{"text":"pampa TOTECO quicactoc queja nichoca.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yajaya quicactoc tlen nijtlajtlanijtoc,","poem":1},{"lineBreak":true},{"text":"huan quiselijtoc notlamaijtol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nochi nocualancaitacahua mopinahuase huan huetzise.","poem":1},{"lineBreak":true},{"text":"Ica se tlalochtli TOTECO quincuepas ica pinahualistli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}