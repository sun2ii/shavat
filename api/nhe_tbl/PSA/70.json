{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":70,"content":[{"type":"heading","content":["Se tlamaijtoli para Toteco ma quipalehuiqui"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios, xihuala xinechmanahuiqui ininmaco nocualancaitacahua!","poem":1},{"lineBreak":true},{"text":"¡Quena, ximoisihuilti, Toteco Dios!","poem":1},{"lineBreak":true},{"text":"¡Xihuala xinechpalehuiqui!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inijuanti nentinemij notepotzco huan paquij quema nechtlaijiyohuiltíaj.","poem":1},{"lineBreak":true},{"text":"Yeca nimitztlajtlanía xiquinpinahualti,","poem":1},{"lineBreak":true},{"text":"huan xiquincuepa para ayoc ma nechchihuilica tlen fiero.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xiquincuepa ica pinahualistli huan ayoc xiquincahuili ma nechpinajtica.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero nochi tlacame tlen mitztemohuaj,","poem":1},{"lineBreak":true},{"text":"xiquinmaca miyac paquilistli.","poem":1},{"lineBreak":true},{"text":"Nochi tlen paquij pampa tiquinmaquixtijtoc, ma quiijtoca:","poem":1},{"lineBreak":true},{"text":"“Ma tijhueyitlalica Toteco Dios.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero na tlen tlahuel nitlaijiyohuía,","poem":1},{"lineBreak":true},{"text":"nimitztlajtlanía xihuala nimantzi huan xinechmanahuiqui,","poem":1},{"lineBreak":true},{"text":"pampa san ta hueli tinechpalehuis huan tinechmaquixtis.","poem":1},{"lineBreak":true},{"text":"¡NoTeco Dios, amo xihuejcahua!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}