{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":87,"content":[{"type":"heading","content":["Nelía elis se hueyi paquilistli para tlen ehuaj altepetl Jerusalén"]},{"type":"verse","number":1,"content":[{"text":"Altepetl Jerusalén eltoc ipan nopa tepetl tlatzejtzeloltic tlen iaxca Toteco.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Huan TOTECO quiicnelía Jerusalén achi más que nopa sequinoc pilaltepetzitzi ipan tlali Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quena, Jerusalén eltoc ialtepe Toteco Dios,","poem":1},{"lineBreak":true},{"text":"huan quema tlacame quiilnamiquij,","poem":1},{"lineBreak":true},{"text":"camatij nelyejyectzi tlen nopa altepetl.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quema niquintocaxtía tlaltini tlen nechixmati, niquintocaxtis Egipto, Babilonia, Filistea, Tiro huan Etiopía.","poem":1},{"lineBreak":true},{"text":"Mohueyimatij tlen tlacatqui ipan sesen nopa tlaltini.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero ajsis tonali quema tlacame quiselise más hueyi tlatlepanitacayotl pampa tlacatque ipan altepetl Jerusalén,","poem":1},{"lineBreak":true},{"text":"pampa Toteco Tlen Más Hueyi quitiochihuas ni altepetl.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Huan TOTECO quiijcuilos inintoca nochi tlen itztoque ipan nopa altepetl.","poem":1},{"lineBreak":true},{"text":"Huan nochi tlen tlacatque nopano quintlalilis se tlanextili campa ijcuilijtos inintoca.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Huan quema ilhuichihuase inijuanti, huicase ica paquilistli huan quiijtose:","poem":1},{"lineBreak":true},{"text":"“Nochi noyolo nijtlalijtoc ipan Jerusalén.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}