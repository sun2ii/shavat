{"translation":{"id":"nhe_tbl","name":"Itlajtol toteco: Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nheBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Oriental Nahuatl Bible 2005","language":"nhe","textDirection":"ltr","sha256":"6a198ec2f8be9641f1f50a52026740d541cb19fc3cb8b85bb8fcdf7854fb8960","availableFormats":["json"],"listOfBooksApiLink":"/api/nhe_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Eastern Huasteca Nahuatl","languageEnglishName":"Eastern Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhe_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"84e0856659a30045c070ae2413bfe23dc0847bbe37e5fac8968adb2a390befcf","firstChapterNumber":1,"firstChapterApiLink":"/api/nhe_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhe_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":93,"content":[{"type":"heading","content":["Toteco tlahuel hueyi"]},{"type":"verse","number":1,"content":[{"text":"¡TOTECO tlanahuatía!","poem":1},{"lineBreak":true},{"text":"Yajaya tlahuel hueyi hasta quipiya itlatlanex tlen onpano yejyectzi.","poem":1},{"lineBreak":true},{"text":"Quitlatzquilti nelcuali ni tlaltepactli,","poem":1},{"lineBreak":true},{"text":"huan ax hueli mojmolinis tlen itlatzinpehualtil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nochipa hasta tlen huejcajquiya ta tijpixtoc tlanahuatili,","poem":1},{"lineBreak":true},{"text":"huan nochi tlen itztoque ipan motlanahuatilis mocahuaj temachme.","poem":1},{"lineBreak":true},{"text":"San ta tiitztoc para nochipa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"TOTECO, nochi atemitl caquisti para mitzpaquilismacaj quema mocoxoníaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero ta, TOTECO, tlen tiitztoc hasta huejcapa tijpiya más chicahualistli,","poem":1},{"lineBreak":true},{"text":"huan ax queja nopa atl tlen mocoxonía ipan nochi huejhueyi atl ipan tlaltepactli.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Motlanahuatilhua ax quema mopatlaj.","poem":1},{"lineBreak":true},{"text":"TOTECO, para nochi xihuitl huan para nochi tonali motequihuejcayo eltoc senquistoc tlatzejtzeloltic.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhe_tbl/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhe_tbl/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhe_tbl/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}