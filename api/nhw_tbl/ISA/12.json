{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"ISA","translationId":"nhw_tbl","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"9ef0a87604a4d428233e58250d48545408c73e5efb7e82d85773737e224297ee","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nhw_tbl/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["Huicatl tlen tlascamatili para TOTECO"]},{"type":"verse","number":1,"content":["Hualas se tonal quema masehualme huicase:",{"text":"“Nimitzhueyitlalía, TOTECO,","poem":1},{"lineBreak":true},{"text":"Masque tlahuel ticualaniyaya ica na,","poem":1},{"lineBreak":true},{"text":"ama timoyoltlalijtoc huan techtlasojtlatoc.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xiquitaca anmasehualme, Toteco Dios yaya notemaquixtijca.","poem":1},{"lineBreak":true},{"text":"Huajca nimotemachis ipan ya huan ayacmo nimajmahuis.","poem":1},{"lineBreak":true},{"text":"TOTECO itztoc catli nechmaca nochicahualis huan yeca san para ya nihuicas.","poem":1},{"lineBreak":true},{"text":"San yaya notemaquixtijca.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quen se ajhuiyac atl quinmaca paquilistli catli amiquij,","poem":1},{"lineBreak":true},{"text":"quej nopa tipaquij tojuanti, tiimasehualhua TOTECO catli yaya techmaquixtijtoc.”","poem":1}]},{"type":"verse","number":4,"content":["Huan ipan nopa tonal quiijtose:",{"text":"“¡Xijtlascamatica TOTECO!","poem":1},{"lineBreak":true},{"text":"¡Xijhueyitlalica ya!","poem":1},{"lineBreak":true},{"text":"¡Xitepohuilica ipan nochi tlalme nopa huejhueyi tlamantli catli yaya quichijtoc!","poem":1},{"lineBreak":true},{"text":"¡Xiteilhuica para TOTECO yaya nelía hueyi!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xihuicaca tiohuicatl para TOTECO pampa yaya quichijtoc huejhueyi tlamantli.","poem":1},{"lineBreak":true},{"text":"Ma quimatica catli quichijtoc nochime ipan tlaltipactli.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Huan ma huicaca huan ma tzajtzica ica paquilistli,","poem":1},{"lineBreak":true},{"text":"nochi catli itztoque ipan altepetl Jerusalén.","poem":1},{"lineBreak":true},{"text":"Pampa tlatlajco tlen tojuanti itztoc TOTECO catli nelía hueyi,","poem":1},{"lineBreak":true},{"text":"Quena, yaya nopa Dios catli Tlatzejtzeloltic huan itztoc tohuaya tiisraelitame.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}