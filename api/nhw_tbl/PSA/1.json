{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":1,"content":[{"type":"heading","content":["Tlajtlacolchihuani huan catli itztoque xitlahuaque iixpa Toteco"]},{"type":"verse","number":1,"content":[{"text":"Paqui nopa masehuali catli amo quitlacaquilía inincamanal amo cuajcualme,","poem":1},{"lineBreak":true},{"text":"niyon amo quintoquilía tlajtlacolchihuani.","poem":1},{"lineBreak":true},{"text":"Niyon amo mohuica ininhuaya catli ica paquij TOTECO.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nopa masehuali quipantía hueyi paquilistli pampa quichijtinemi catli quiijtohuaj itlanahuatilhua TOTECO,","poem":1},{"lineBreak":true},{"text":"huan ipan nopa tlanahuatilme monejnehuilijtinemi tonaya huan tlayohua.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nopa masehuali itztoc quen se cuahuitl catli moscaltía nechca atentli,","poem":1},{"lineBreak":true},{"text":"huan temaca itlajca quema ipohual huan amo quema xihuiyo tepehui.","poem":1},{"lineBreak":true},{"text":"Nochi catli quichihua quisa cuali.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero amo quej nopa ica masehualme catli amo cuajcualme,","poem":1},{"lineBreak":true},{"text":"pampa inijuanti itztoque quen tlasoli catli quihuica ajacatl.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yeca quema TOTECO tetlajtolsencahuas,","poem":1},{"lineBreak":true},{"text":"nopa amo cuajcualme amo huelise quiijiyohuise,","poem":1},{"lineBreak":true},{"text":"pampa yaya tlahuel chicahuac quintlatzacuiltis.","poem":1},{"lineBreak":true},{"text":"Quena, ipan nopa tonal tlajtlacolchihuani ayacmo huelis mocahuase ininhuaya masehualme catli itztoque xitlahuaque iixpa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pampa TOTECO quimati nopa ojtli catli ipan nemij masehualme catli itztoque xitlahuaque,","poem":1},{"lineBreak":true},{"text":"pero masehualme catli quichihuaj catli amo cuali,","poem":1},{"lineBreak":true},{"text":"polihuise.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}