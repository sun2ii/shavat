{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":100,"content":[{"type":"heading","content":["Ma tijtlascamatica Toteco"]},{"type":"verse","number":1,"content":[{"text":"Xihuicaca ica paquilistli para TOTECO,","poem":1},{"lineBreak":true},{"text":"nochi anmasehualme catli anitztoque ipan ni tlaltipactli.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xijtequipanoca TOTECO ica paquilistli.","poem":1},{"lineBreak":true},{"text":"Huan quema anhualahuij iixpa, xihuicatihualaca.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xijmatica cuali para TOTECO, yaya Toteco Dios.","poem":1},{"lineBreak":true},{"text":"Yaya techchijchijqui.","poem":1},{"lineBreak":true},{"text":"Amo timochijchijtoque tojuanti.","poem":1},{"lineBreak":true},{"text":"Tojuanti tiimasehualhua huan tiitztoque quen tiiborregojhua catli techpixtoc ipan ipotrero para techmocuitlahuis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quema ticalaquij ipan itiopa, ma tijtlascamatica miyac.","poem":1},{"lineBreak":true},{"text":"Huan quema tinemij icalixpa, ma tihuicaca.","poem":1},{"lineBreak":true},{"text":"Quena, ma tijtlascamatica huan ma tijpaquilismacaca.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pampa TOTECO yaya nelía cuali.","poem":1},{"lineBreak":true},{"text":"Nochipa teicnelía huan tetlasojtla.","poem":1},{"lineBreak":true},{"text":"Yaya itztos temachtli para nochipa ica nochi masehualme catli tlacajtihualahuij.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}