{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":113,"content":[{"type":"heading","content":["Toteco quitlanana se catli teicneltzi"]},{"type":"verse","number":1,"content":[{"text":"¡Xijpaquilismacaca TOTECO!","poem":1},{"lineBreak":true},{"text":"¡Quena, nochi amojuanti catli anitequipanojcahua TOTECO, xijhueyimatica!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma tijhueyimatica TOTECO ama huan para nochipa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quena, nochi masehualme tlen campa hualquisa tonati hasta campa oncalaqui ma quihueyimatica TOTECO.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"TOTECO quipiya tlanahuatili ica nochi catli itztoque ipan nochi tlalme.","poem":1},{"lineBreak":true},{"text":"Huan ihueyitilis conpano ilhuicactli.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Ajqueya seyoc más hueyi quen TOTECO toDios catli mosehuía nepa huejcapa para tlanahuatis?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tlatzintla tlen ya eltoc ilhuicactli huan tlaltipactli.","poem":1},{"lineBreak":true},{"text":"Huan yaya mohuijtzoma para tlachiyas ipan ni tlaltipactli.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Huan quitlanana nopa teicneltzi catli eltoc quen masitoc ipan soquitl catli huejcatla.","poem":1},{"lineBreak":true},{"text":"Huan catli huetztoc campa quitepehuaj tlasoli quitlanana huan quisehuía campa cuali.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quena, quitlanana huan quisehuía ininhuaya huejhueyi tlacame","poem":1},{"lineBreak":true},{"text":"catli quinyacanaj ialtepe ehuani.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yaya quichihua para nopa sihuatl catli amo quema conepixqui","poem":1},{"lineBreak":true},{"text":"ma quinpiya iconehua huan ichaj.","poem":1},{"lineBreak":true},{"text":"Quena, quichihua ma eli se tenantli catli senpactoc.","poem":1},{"lineBreak":true},{"text":"¡Paquilistli!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}