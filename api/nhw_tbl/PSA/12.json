{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":12,"content":[{"type":"heading","content":["Techpalehui, TOTECO"]},{"type":"verse","number":1,"content":[{"text":"Techpalehui, TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa ayacmo aqui catli nelía mitzneltoquilía.","poem":1},{"lineBreak":true},{"text":"Ayacmo aquime masehualme catli quiijtohuaj catli melahuac.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Se ica seyoc moistlacahuíaj.","poem":1},{"lineBreak":true},{"text":"Quipiyaj ome iniixayac quen nojquiya quipatlaj inincamanal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"TOTECO quintzontlamiltis nochi catli quipiyaj ome iniixayac huan catli mohueyimatij quema camanaltij.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quintzontlamiltis catli quiijtohuaj:","poem":1},{"lineBreak":true},{"text":"“San ica tocamanal titlatlanise.","poem":1},{"lineBreak":true},{"text":"Sintla tijnequij tiistlacatise,","poem":1},{"lineBreak":true},{"text":"tojuanti tijmatij.","poem":1},{"lineBreak":true},{"text":"Amo aqui huelis technahuatis.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero quej ni quiijtojtoc TOTECO:","poem":1},{"lineBreak":true},{"text":"“Inijuanti catli teicneltzitzi huan catli amo quipiyaj fuerza nechtzajtzilíaj por nopa fiero masehualme catli quintlaijiyohuiltíaj.","poem":1},{"lineBreak":true},{"text":"Yeca ama nimotlananas para niquinpalehuis.","poem":1},{"lineBreak":true},{"text":"Niquinmaquixtis ininmaco catli quincualancaitaj.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nelía temachtli catli quiijtohua TOTECO.","poem":1},{"lineBreak":true},{"text":"Icamanal senquistoc melahuac.","poem":1},{"lineBreak":true},{"text":"Quena, eltoc quen se cuali plata catli quinelicxitijtoque,","poem":1},{"lineBreak":true},{"text":"huan quipajpactoque miyac hueltas hasta senquistoc cuali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"TOTECO, ta techmocuitlahuía.","poem":1},{"lineBreak":true},{"text":"Techmanahuis para nochipa ica masehualme catli amo cuajcualme quen ama itztoque.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quena, masque mosisinijca masehualme mooquichmajtinemij campa hueli huan nochi masehualme san quipatiitaj catli amo cuali,","poem":1},{"lineBreak":true},{"text":"Ta techmocuitlahuía.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}