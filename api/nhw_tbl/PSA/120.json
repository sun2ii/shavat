{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":120,"content":[{"type":"heading","content":["Netlatlajtili para Toteco ma quimanahui tlen nopa istlacatini"]},{"type":"verse","number":1,"content":[{"text":"Quema niitztoya ipan tlaijiyohuilistli,","poem":1},{"lineBreak":true},{"text":"nijtzajtzili TOTECO huan yaya nechnanquili.","poem":1},{"lineBreak":true},{"text":"Niquilhui:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“TOTECO, techmanahui ininmaco nopa masehualme,","poem":1},{"lineBreak":true},{"text":"catli nechistlacahuíaj huan nechejelnamiquij.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma moilhuica nopa istlacatini tlaque elis catli ininpantis por iniistlacaticayo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quintlamicocoyotzase ica cuatlamintli huan quintlatise ipan tlicoli.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nelía niteicneltzi na catli niitztoc ininhuaya ni masehualme tlen tlali Mesec huan Cedar.","poem":1},{"lineBreak":true},{"text":"Nelía nitlaijiyohuía tlatlajco inijuanti,","poem":1},{"lineBreak":true},{"text":"pampa niyon se inijuanti amo mitztlepanita, Toteco.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya nisiyajqui para niitztoc ininhuaya ni masehualme catli amo quinequij ma onca tlasehuilistli.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quema niquincamanalhuía quenicatza hueli tiitztose ica tlasehuilistli,","poem":1},{"lineBreak":true},{"text":"inijuanti quisencahuaj quenicatza tlahuilanase.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}