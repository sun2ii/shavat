{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":121,"content":[{"type":"heading","content":["Toteco yaya mitzmocuitlahuis"]},{"type":"verse","number":1,"content":[{"text":"Quema nijtlanana noixayac,","poem":1},{"lineBreak":true},{"text":"huan nitlachiyas ipan nopa tepeme, nimoilhuía:","poem":1},{"lineBreak":true},{"text":"¿Canque huala notlapalehuil?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Notlapalehuil huala tlen TOTECO,","poem":1},{"lineBreak":true},{"text":"yaya catli quichijchijqui ilhuicactli huan tlaltipactli.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaya amo quema mitzcahuilis para timotepotlamis o tihuetzis.","poem":1},{"lineBreak":true},{"text":"Yaya mitzmocuitlahuis huan amo monequi cochis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quena, TOTECO catli quinmocuitlahuía israelitame amo ixijcopi,","poem":1},{"lineBreak":true},{"text":"niyon amo cochi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO yaya mitzmocuitlahuía.","poem":1},{"lineBreak":true},{"text":"Yaya itztoc monechca para mitzmanahuis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaya mitzmocuitlahuía tonaya huan tlayohua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"TOTECO mitzmocuitlahuis para amo mitzajsis niyon se tlamantli catli amo cuali.","poem":1},{"lineBreak":true},{"text":"Quena, yaya quimocuitlahuis monemilis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO yaya mitzmocuitlahuis campa hueli tiyas o tihualas,","poem":1},{"lineBreak":true},{"text":"ama huan para nochipa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}