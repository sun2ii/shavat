{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":122,"content":[{"type":"heading","content":["Netlatlajtili para ma onca tlasehuilistli ipan altepetl Jerusalén"]},{"type":"verse","number":1,"content":[{"text":"Na nipajqui quema nechilhuijque:","poem":1},{"lineBreak":true},{"text":"“Ma tiyacajya ichaj TOTECO.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pero ama ya tiitztoque nica ipan altepetl Jerusalén.","poem":1},{"lineBreak":true},{"text":"Quena, ya ticalactoque campa ipuertas ipan itepa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalén quisencajtoque para nopona nochi ma mosentilica.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nochi imasehualhua TOTECO tlen catli hueli hueyi familia tlen israelitame hualahuij nica sesen xihuitl,","poem":1},{"lineBreak":true},{"text":"para quitlascamatise huan quipaquilismacase Toteco senquistoc quen quiijtohua itlajtol.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pampa nopona mosehuía para tetlajtolsencahuas nopa tlanahuatijquetl catli iixhui David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ximotlatlajtica ica TOTECO para ma onca tlasehuilistli ipan altepetl Jerusalén.","poem":1},{"lineBreak":true},{"text":"Xijtiochihua Jerusalén ica ni camanali:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“Ma itztoca cuali nochi catli quiicnelíaj ni altepetl Jerusalén.","poem":1},{"lineBreak":true},{"text":"Ma onca tlasehuilistli ica calijtic nopa tepamitl catli quiyahualohua.","poem":1},{"lineBreak":true},{"text":"Ma itztoca ica paquilistli ipan nochi tequicalme.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pampa niquinicnelía noicnihua huan nohuampoyohua catli itztoque nica, niquijtohua:","poem":1},{"lineBreak":true},{"text":"“Ma quipiya tlasehuilistli ni altepetl.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pampa niquicnelía ichaj TOTECO catli mocahua nica,","poem":1},{"lineBreak":true},{"text":"ma onca tlasehuilistli ipan ni altepetl.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}