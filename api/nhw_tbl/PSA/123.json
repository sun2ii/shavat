{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":123,"content":[{"type":"heading","content":["Netlatlajtili para Toteco ma quitlasojtla"]},{"type":"verse","number":1,"content":[{"text":"Na nijtlananas noixayac para nimitztlachilis ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"catli timosehuijtoc ipan ilhuicac.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tojuanti timitztlachilíaj ta,","poem":1},{"lineBreak":true},{"text":"TOTECO toDios, para ma techtlasojtla san se quen se tequipanojquetl quitlachilía iteco,","poem":1},{"lineBreak":true},{"text":"o quen se sihua tequipanojquetl quitlachilía iteco isihua para ma quichihuili catli cuali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"TOTECO, techtlasojtla.","poem":1},{"lineBreak":true},{"text":"Quena, xijpiya hueyi moyolo tohuaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ya tisiyajtoque ica nopa masehualme catli techitaj quen amo tleno topati.","poem":1},{"lineBreak":true},{"text":"Inijuanti catli mohueyimatij huan catli ricos tlahuel techpinajtíaj,","poem":1},{"lineBreak":true},{"text":"hasta ya techyolajsic.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}