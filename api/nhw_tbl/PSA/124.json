{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":124,"content":[{"type":"heading","content":["David quihueyimatqui Toteco pampa quimanahui tlen icualancaitacahua"]},{"type":"verse","number":1,"content":[{"text":"Nochi israelitame ma quiijtoca tlaque tijchijtosquíaj sintla TOTECO amo itztosquía tohuaya huan amo techpalehuijtosquía.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sintla TOTECO amo itztosquía tohuaya quema nopa tlacame motlananque para techhuilanase,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"techtolojtosquíaj tiyoltoque huan techtzontlamiltijtosquíaj ica ininhueyi cualancayo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inijuanti techhuahuatatztosquíaj quen atl tlatilana,","poem":1},{"lineBreak":true},{"text":"huan huajca eltosquía quen hueyatl panotosquía ipan tojuanti.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quena, eltosquía quen panotosquía miyac atl catli tetetztic,","poem":1},{"lineBreak":true},{"text":"catli tehuahuatatztosquía huan titzontlantosquíaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma tijtlascamatica TOTECO pampa amo quincahuili ma techcococa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quen se tototl cholohua tlen se tlaquetztli,","poem":1},{"lineBreak":true},{"text":"quej nopa nojquiya Toteco techchololti ininmaco tocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"catli quinequiyayaj techmasiltise.","poem":1},{"lineBreak":true},{"text":"Nopa lazo cotonqui huan tojuanti timocajque timajcajtoque.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tojuanti totlapalehuil huala tlen TOTECO,","poem":1},{"lineBreak":true},{"text":"catli quichijchijqui ilhuicactli huan tlaltipactli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}