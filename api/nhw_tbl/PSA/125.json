eak"},{"type":"verse","number":4,"content":[{"text":"TOTECO, xiquinchihuili catli cuali masehualme catli cuajcualme,","poem":1},{"lineBreak":true},{"text":"huan catli xitlahuac ininyolo moixpa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero nopa masehualme catli moiyocatlalíaj ica tlamantli catli amo cuali xiquinhuica campa tiquintlatzacuiltis.","poem":1},{"lineBreak":true},{"text":"Huan ma onca paquilistli huan tlasehuilistli ipan tlali Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}