{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":126,"content":[{"type":"heading","content":["Toteco quicualtlalis itlal"]},{"type":"verse","number":1,"content":[{"text":"Quema TOTECO sempa quinhualicase ipan Jerusalén nochi imasehualhua catli tetequipanohuaj ipan sequinoc tlalme,","poem":1},{"lineBreak":true},{"text":"elis quen tijtemiquij.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Nelía tihuetzcase huan tihuicase ica paquilistli!","poem":1},{"lineBreak":true},{"text":"Huan nopa masehualme tlen sequinoc tlalme quiijtose:","poem":1},{"lineBreak":true},{"text":"“¡Dios quichijtoc huejhueyi tlamantli para nopa israelitame!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quena, nelía melahuac TOTECO techchihuilis huejhueyi tlamantli.","poem":1},{"lineBreak":true},{"text":"¡Ma tipaquica!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"TOTECO, sempa techmacas tlamantli catli cuali quen tijpixtoyaj achtihuiya.","poem":1},{"lineBreak":true},{"text":"Quena, quen nopa hueyame catli ajsi ipan nopa huactoc tlali huan quiyancuilía,","poem":1},{"lineBreak":true},{"text":"quej nopa xijyancuili tonemilis, TOTECO.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Catli tocaj ica choquistli, ica paquilistli pixcase.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quena, masque chocatiyase quema quitoctiyase ininxinach,","poem":1},{"lineBreak":true},{"text":"pero quema pixcatij huicatihualase ica paquilistli pampa ya quihualicase catli quipixcatose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}