{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":128,"content":[{"type":"heading","content":["Cuali ipanti nopa masehuali catli quitlepanita Toteco"]},{"type":"verse","number":1,"content":[{"text":"Nelía paqui nopa masehuali catli quiimacasi huan quitlepanita TOTECO.","poem":1},{"lineBreak":true},{"text":"Quena, paqui catli nemi xitlahuac ipan iojhui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quiselis itlaxtlahuil pampa tequiti cuali.","poem":1},{"lineBreak":true},{"text":"Yaya paquis miyac huan nochi catli quichihuas quisas cuali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Isihua paquis ipan ichaj.","poem":1},{"lineBreak":true},{"text":"Yaya elis quen se cuali xocomeca tzontli catli achi más quimocuitlahuíaj huan catli temaca miyac itlajca.","poem":1},{"lineBreak":true},{"text":"Quinpiyas miyac ininconehua catli mosehuise campa imesa huan quipiyase miyac chicahualistli.","poem":1},{"lineBreak":true},{"text":"Quena, itztose quen olivo cuame catli nelía cuali.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quej nopa TOTECO quitiochihuas nopa tlacatl catli quiimacasi huan quitlepanita.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO quitiochihuas tlen altepetl Sion.","poem":1},{"lineBreak":true},{"text":"Quicahuilis para quiitas para nochi eltoc cuali ipan Jerusalén nochi tonali tlen inemilis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quicahuilis para itztos hasta quinitas iixhuihua.","poem":1},{"lineBreak":true},{"text":"¡Toteco quimacas tlasehuilistli nopa tlali Israel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}