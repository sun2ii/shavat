{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":129,"content":[{"type":"heading","content":["Ma huetzica catli quincualancaitaj israelitame huan altepetl Jerusalén"]},{"type":"verse","number":1,"content":[{"text":"Nochi israelitame hueli quiijtose para hasta quema pejqui itztose israelitame,","poem":1},{"lineBreak":true},{"text":"huan pejqui timochihuaj se altepetl tlen san se toeso timasehualme,","poem":1},{"lineBreak":true},{"text":"tocualancaitacahua techtepotztocatinentoque.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Techcuesolmacatoque hasta quema tiisraelita masehualme tionpejque timoscaltíaj quen se telpocatl.","poem":1},{"lineBreak":true},{"text":"Pero amo quema hueltoque techtzontlamiltíaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tocuitlapa techtlamicocojque quema techmaquiliyayaj hasta huejcajya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero TOTECO yaya nelía xitlahuac,","poem":1},{"lineBreak":true},{"text":"quicotonqui nopa tepos cadenas catli ica techtatacatzohuayayaj nopa masehualme catli amo quitlepanitaj TOTECO.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma huetzica ipan se hueyi pinahualistli nochi catli quicualancaitaj altepetl Jerusalén.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma elica quen nopa xihuitl catli nimantzi pilini huan huaqui pampa ixhuatoc ipan tlali catli amo huejcatla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quena, ma elica quen nopa xihuitl catli amo aqui quimehua,","poem":1},{"lineBreak":true},{"text":"niyon amo aqui quipixca itlajca pampa amo tleno ipati.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nimitztlajtlanía para niyon se catli pano nopa fiero masehualme ma amo quintiochihuaca.","poem":1},{"lineBreak":true},{"text":"Amo aqui ma quiijto:","poem":1},{"lineBreak":true},{"text":"“Ma TOTECO anmechtiochihua.”","poem":1},{"lineBreak":true},{"text":"Niyon ma amo quiijtoca:","poem":1},{"lineBreak":true},{"text":"“Tojuanti timechtiochihuaj ica itequiticayo TOTECO.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}