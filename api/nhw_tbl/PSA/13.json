{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":13,"content":[{"type":"heading","content":["Se netlatlajtili para quitlajtlanis itlapalehuil TOTECO"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, ¿hasta quema techelcajtos?","poem":1},{"lineBreak":true},{"text":"¿Ayacmo quema techelnamiquis?","poem":1},{"lineBreak":true},{"text":"Nijmati techcuanetlatilía quema nimitztemohua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Hasta quema nijpiyas tequipacholi ipan noyolo huan noyoltzi tlaijiyohuijtinemis?","poem":1},{"lineBreak":true},{"text":"¿Hasta quema nocualancaitaca noja nechtlanis?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Techtlachili huan technanquili, TOTECO.","poem":1},{"lineBreak":true},{"text":"¡NoTeco Dios!","poem":1},{"lineBreak":true},{"text":"Techmaca tlahuili para nitlachiyas ipan ni tzintlayohuilotl huan amo nimiquis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amo xijcahuili nocualancaitaca ma quiijto nechtlanqui.","poem":1},{"lineBreak":true},{"text":"Amo techcahuili ma nihuetzi para ma amo noca huetzcaca inijuanti catli nechcualancaitaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na nimotemachijtoc ipan moteicnelijcayo catli huejcahua para nochipa.","poem":1},{"lineBreak":true},{"text":"Nipaqui ipan noyolo pampa techmaquixtijtoc.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nihuicas para ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa miyac catli cuali techchihuilijtoc.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}