{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":130,"content":[{"type":"heading","content":["Ximotemachica ipan Toteco para anmechmanahuis"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, quema nimopantía ipan se hueyi tlaohuijcayotl,","poem":1},{"lineBreak":true},{"text":"na nimitztzajtzilía para techtitlanilis motlapalehuil.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Toteco, techtlacaquili quema nimitznojnotza.","poem":1},{"lineBreak":true},{"text":"Techchihuili cuenta catli nimitztlajtlanía huan techpalehui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"TOTECO, sintla tiquelnamiquisquía nochi totlajtlacolhua,","poem":1},{"lineBreak":true},{"text":"amo aqui huelisquía moquetzas moixpa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero ta nelía titetlapojpolhuía,","poem":1},{"lineBreak":true},{"text":"para nochi masehualme ma mitztlepanitaca.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na nimochiya ipan ta, TOTECO, para techpalehuis,","poem":1},{"lineBreak":true},{"text":"Quena, ica nochi noyolo nimotemachía ipan nopa catli techtlajtolcahuilijtoc ipan mocamanal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ipan noalma senquistoc nitlachixtoc para ta, TOTECO, xitequiti.","poem":1},{"lineBreak":true},{"text":"Nitlachixtoc para techpalehuis,","poem":1},{"lineBreak":true},{"text":"quen nopa tlamocuitlahuiani quichiyaj ma tlanesi.","poem":1},{"lineBreak":true},{"text":"Quena, más nitlachixtoc huan amo quen tlamocuitlahuiani catli tlahuel quinequij ma tlanesi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nochi anisraelitame, ximotemachica ipan TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa san yaya quipiya hueyi iyolo huan san yaya temaquixtía tlatoctzitzi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yaya quinmaquixtis israelitame tlen nochi inintlajtlacolhua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}