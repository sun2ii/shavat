{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":136,"content":[{"type":"heading","content":["Ma tijtlascamatica Toteco"]},{"type":"verse","number":1,"content":[{"text":"Xijtlascamatica TOTECO pampa yaya nelía cuali,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xijtlascamatica Toteco Dios catli más hueyi tlen nochi sequinoc “dioses”,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xijtlascamatica Toteco Dios catli ininTeco nochi tecojme,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xijtlascamatica TOTECO pampa san ya hueli quichihua huejhueyi tlamantli,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xijtlascamatica yaya catli quichijchijqui ilhuicactli ica miyac tlalnamiquilistli,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xijtlascamatica yaya catli quitlali ni tlali ipani atl,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xijtlascamatica yaya catli quinchijchijqui nopa tlahuilme catli onca nepa ilhuicac,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quichijchijqui nopa tonati para ma tlahui tonaya,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Huan quichijchijqui metztli huan sitlalime para ma tlahuica tlayohua,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xijtlascamatica TOTECO catli quintzontlamilti nopa achtihui ehuani tlen tlali Egipto,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xijtlascamatica catli quinquixti israelitame ipan inintlal nopa egiptome,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Quena, quinquixti ica ihueyi chicahualis huan ica inejmac quinpalehui,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xijtlascamatica yaya catli quixelo nopa Hueyi Atl Chichiltic para ma panoca imasehualhua,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Huan quinpanolti nopa israelitame ipan tlali huactoc tlatlajco nopa hueyi atl,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pero quinatzonpolihuilti Faraón huan isoldados ipan nopa hueyi atl,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xijtlascamatica Toteco catli quinyacanqui imasehualhua ipan nopa huactoc tlali,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Xijtlascamatica yaya catli quinmanahui imasehualhua ininmaco tlanahuatiani catli quipixque miyac chicahualistli,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yaya quintzontlamilti huejhueyi tlanahuatiani catli tlahuel quipiyayayaj chicahualistli,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Quitzontlamilti Sehón, inintlanahuatijca nopa amorreos,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nojquiya quimicti Og, tlanahuatijquetl tlen tlali Basán,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Huan inintlal nopa tlanahuatiani,","poem":1},{"lineBreak":true},{"text":"Toteco quinmacac imasehualhua quen se tlamantli catli inintata quincahuilijtejqui,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Quena, quimacac itequipanojca Israel para ma moaxcati nopa tlali para nochipa,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yaya catli techelnamijqui tiisraelitame quema ayacmo tijpiyayayaj chicahualistli,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yaya techmanahui ininmaco tocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yaya quinmaca tlacualistli nochi tlamantli catli yoltoque,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Xijtlascamatica Toteco Dios catli quinahuatía ilhuicactli,","poem":1},{"lineBreak":true},{"text":"pampa itlaicnelijcayo amo quema tlami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}