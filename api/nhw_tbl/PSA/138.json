{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":138,"content":[{"type":"heading","content":["Tlascamatili por itlapalehuil Toteco"]},{"type":"verse","number":1,"content":[{"text":"Ica nochi noyolo nimitztlascamatis, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan nihuicas para ta iniixpa nopa motequihuajcahua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nimotlancuaquetza iixmelac motiopa catli tlatzejtzeloltic,","poem":1},{"lineBreak":true},{"text":"huan nimitztlascamatis pampa nelía titetlasojtla huan titemachtli.","poem":1},{"lineBreak":true},{"text":"Nochi catli techtlajtolcahuilijtoc para tijchihuas,","poem":1},{"lineBreak":true},{"text":"tijtlamichihuas pampa mocamanal nelía temachtli quen ta titemachtli.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quema nimitztzajtzilía,","poem":1},{"lineBreak":true},{"text":"ta technanquilía huan techfuerzajmaca.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"TOTECO, nochi tlanahuatiani catli itztoque ipan ni tlaltipactli mitztlascamatise,","poem":1},{"lineBreak":true},{"text":"pampa nochi inijuanti quicaquise catli tijtlajtolcajtoc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Quena, huicase por nochi nopa huejhueyi tlamantli catli quichijtoc TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa ihueyitilis nelhueyi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Masque TOTECO tlahuel hueyi,","poem":1},{"lineBreak":true},{"text":"yaya quintlacaquilía catli moechcapanohuaj.","poem":1},{"lineBreak":true},{"text":"Pero catli mohueyimatij,","poem":1},{"lineBreak":true},{"text":"monequi moquetzase huejca tlen Toteco,","poem":1},{"lineBreak":true},{"text":"pampa yaya amo quinequi quinitas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sintla niitztoc ipan tlaijiyohuilistli, ta TOTECO,","poem":1},{"lineBreak":true},{"text":"techmanahuía huan techmaquixtía.","poem":1},{"lineBreak":true},{"text":"Huan quema nechhuilanaj nocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"ta tijxitlahua momax huan techmaquixtía ica mohueyi chicahualis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO, ta tijchihuas nochi catli timoilhuijtoc para tijchihuas ipan na nonemilis.","poem":1},{"lineBreak":true},{"text":"Pampa nopa tlaicnelijcayotl catli tijpiya ica na, TOTECO,","poem":1},{"lineBreak":true},{"text":"amo quema tlami.","poem":1},{"lineBreak":true},{"text":"Amo techtlahuelcahua pampa ta techchijchijqui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}