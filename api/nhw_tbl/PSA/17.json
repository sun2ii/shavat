{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":17,"content":[{"type":"heading","content":["Se netlatlajtili catli quitlajtlanía TOTECO ma quimanahuis"]},{"type":"verse","number":1,"content":[{"text":"Techtlacaquili, TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa nimitznojnotza.","poem":1},{"lineBreak":true},{"text":"Nijchijtoc catli xitlahuac,","poem":1},{"lineBreak":true},{"text":"huan amo niistlacati.","poem":1},{"lineBreak":true},{"text":"Techtlacaquili catli nimitztlajtlanía huan techpalehui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Techtlajtolsencahua iniixpa nochi masehualme.","poem":1},{"lineBreak":true},{"text":"Xiquinnextili para amo tleno nijchijtoc,","poem":1},{"lineBreak":true},{"text":"pampa nochipa tijmati catli xitlahuac.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Masque tijhualtlachilía noyolo ica yohuali huan techyejyecojtoc,","poem":1},{"lineBreak":true},{"text":"amo tleno amo cuali tijpantijtoc.","poem":1},{"lineBreak":true},{"text":"Amo niquijtojtoc catli amo monequi,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"quen quichihuaj ne sequinoc.","poem":1},{"lineBreak":true},{"text":"Na nimoiyocatlalijtoc tlen nopa iniojhui catli amo cuajcualme.","poem":1},{"lineBreak":true},{"text":"Nijchijtoc senquistoc quen quiijtohua motlanahuatil.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nijtoquilijtoc moojhui huan amo nihuetztoc ipan tlajtlacoli.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nimitznojnotza, noTeco Dios, pampa nijmati technanquilis.","poem":1},{"lineBreak":true},{"text":"Techtlacaquili huan techchihuili cuenta.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Technextili moteicnelijcayo catli yejyectzi.","poem":1},{"lineBreak":true},{"text":"Taya tiquinmaquixtía ica mochicahualis catli motemachiyaj ipan ta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Techmocuitlahui quen se quimocuitlahuía iixsitlal.","poem":1},{"lineBreak":true},{"text":"Quen se piyo quintlatía ipilconehua ieltlapaltzala,","poem":1},{"lineBreak":true},{"text":"nojquiya quej nopa techmocuitlahui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Techtlati tlen nopa amo cuajcualme catli nechyahualojtoque para nechmictise.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nelía mocualnequij huan quema camanaltij,","poem":1},{"lineBreak":true},{"text":"san mohueyimatij.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nechtoquilijtinemij campa ninentinemi huan san quichiyaj nopa tlatoctzi quema huelise nechtlahuisose tlalchi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Inijuanti itztoque quen tecuanime catli tlahuel mayanaj huan quinequij tecuase,","poem":1},{"lineBreak":true},{"text":"huan motlatijtoque ostoijtic para quema se masehuali panos.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ximotlanana, TOTECO,","poem":1},{"lineBreak":true},{"text":"xiquinnamiquiti.","poem":1},{"lineBreak":true},{"text":"Xiquinchihualti ma motlancuaquetzaca moixpa.","poem":1},{"lineBreak":true},{"text":"Ica momachete, techmanahui tlen nopa amo cuajcualme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ica mochicahualis, TOTECO,","poem":1},{"lineBreak":true},{"text":"techmaquixti ininmaco inijuanti catli san quipiyaj catli eltoc ipan ni tlaltipactli.","poem":1},{"lineBreak":true},{"text":"Tijmiyaquilijtoc catli iniaxca nica.","poem":1},{"lineBreak":true},{"text":"Nojquiya xiquinmaca miyac tlatzacuiltili hasta mocahuas para ininconehua.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pero na niitztoc xitlahuac moixpa,","poem":1},{"lineBreak":true},{"text":"huan se tonal nimitzitas, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan yeca nipaqui.","poem":1},{"lineBreak":true},{"text":"Se tonal quema niisas nijpiyas nochi catli nijtemojtinentoc,","poem":1},{"lineBreak":true},{"text":"pampa niitztos monechca huan ica paquilistli timoixtlachilise.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}