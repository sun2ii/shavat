{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":22,"content":[{"type":"heading","content":["Se tlacatl quitzajtzilía Toteco huan teipa quipaquilismaca"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios! ¡NoTeco Dios!","poem":1},{"lineBreak":true},{"text":"¿Para tlen techtlahuelcajtoc?","poem":1},{"lineBreak":true},{"text":"¿Para tlen timohuejcachijtoc huan amo tihualajtoc para techmanahuiqui?","poem":1},{"lineBreak":true},{"text":"Amo tijtlacaquilía quema nitlatzajtzilía.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"NoTeco, tonali yohuali amo nimosiyajquetza nimitznotza,","poem":1},{"lineBreak":true},{"text":"pero amo technanquilía.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Huan masque quej nopa eltoc,","poem":1},{"lineBreak":true},{"text":"ta quejipa titlatzejtzeloltic.","poem":1},{"lineBreak":true},{"text":"Nochi tohuejcapan tatahua tiisraelitame mitzyahualojque huan mitzhueyichijque.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Totatahua mochixque ipan ta.","poem":1},{"lineBreak":true},{"text":"Quena, motemachijque mopan ta huan ta tiquinmanahui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mitznojnotzque quema tlaijiyohuiyayaj huan tiquinmaquixti.","poem":1},{"lineBreak":true},{"text":"Mopan ta motemachijque huan amo tiquinpinahualti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pero na nimomati quen se pilocuiltzi huan amo nise masehuali.","poem":1},{"lineBreak":true},{"text":"Sequin san nechhuetzquilíaj huan sequinoc nechcualancaitaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nochi catli nechitaj san noca paquij,","poem":1},{"lineBreak":true},{"text":"huan tlancuitzihuij huan motzonojolinía,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"huan quiijtohuaj:","poem":1},{"lineBreak":true},{"text":"“Yaya catli motemachía ipan TOTECO,","poem":1},{"lineBreak":true},{"text":"huajca ma tiquitaca sintla quimaquixtis.","poem":1},{"lineBreak":true},{"text":"Sintla nelía quiicnelía,","poem":1},{"lineBreak":true},{"text":"ma quimanahuiqui.”","poem":1},"Quej nopa quiijtohuaj masehualme."]},{"type":"verse","number":9,"content":[{"text":"Pero TOTECO, na nijmati para techpalehuijtoc.","poem":1},{"lineBreak":true},{"text":"Techquixti iijtico nonana.","poem":1},{"lineBreak":true},{"text":"Techmocuitlahuijtoc hasta tlen quema noja nichichiyaya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Huan quema nitlacatqui ya ipa nimotemachijtoc ipan ta.","poem":1},{"lineBreak":true},{"text":"Nochi tonali tieltihualajtoc tinoTeco Dios.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amo techtlalcahui san pampa hualajtoc ni tequipacholi huan amo aqui seyoc catli hueli nechpalehuis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Miyaqui nocualancaitacahua nechyahualojtoque quen torojme catli mosisiníaj.","poem":1},{"lineBreak":true},{"text":"Quena, nesij quen nopa huejhueyi torojme catli itztoque ipan tlali Basán.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanalcaj quen tecuanime catli mosisiníaj.","poem":1},{"lineBreak":true},{"text":"Camachalohuaj huan nechmelactlachilíaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Na nimomati quen atl catli mopatzcatoc huan campa hueli toyajtoc.","poem":1},{"lineBreak":true},{"text":"Nochi noomiyo lelecuecatoc.","poem":1},{"lineBreak":true},{"text":"Noyolo eltoc quen cera catli atiya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tlantoc nochi nochicahualis.","poem":1},{"lineBreak":true},{"text":"Nijpiya nocamac huactoc quen se chachapal tepalcatl,","poem":1},{"lineBreak":true},{"text":"huan nonenepil tlatzquitoc ica nocamacholec.","poem":1},{"lineBreak":true},{"text":"Techtlalijtoc campa tlahuactoc huan campa onca miquilistli.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Masehualme catli amo cuajcualme nechyahualojtoque quen chichime.","poem":1},{"lineBreak":true},{"text":"Quicocoyotztoque nomax huan noicxihua.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hasta huelis nijpohuas noomiyohua,","poem":1},{"lineBreak":true},{"text":"pampa sesen nechcocohua.","poem":1},{"lineBreak":true},{"text":"Nocualancaitacahua nechsentlachilijtoque huan san noca paquij.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Momajmacaj catli nimoquentiyaya.","poem":1},{"lineBreak":true},{"text":"Quena, mahuiltíaj ica piltetzitzi para quiitase ajqueya quitocaros sesen noyoyohua.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pero ta, TOTECO, amo techtlalcahui,","poem":1},{"lineBreak":true},{"text":"pampa na niitztoc momaco.","poem":1},{"lineBreak":true},{"text":"Xihuala nimantzi techpalehuiqui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Techmanahui tlen ininmachete ni mosisinijca masehualme catli itztoque quen chichime.","poem":1},{"lineBreak":true},{"text":"Amo xiquincahuili ma nechmictica.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Eltoc quen niitztoc inincamaco tecuanime,","poem":1},{"lineBreak":true},{"text":"huajca techmaquixti. Nopa masehualme itztoque quen torojme,","poem":1},{"lineBreak":true},{"text":"amo ma nechtompojhuica.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Huan na niquinpohuilis noicnihua tlen ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan quema oncas tlasentililistli,","poem":1},{"lineBreak":true},{"text":"nimitzhueyichihuas iniixtla nochi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"TOTECO, tojuanti catli timitztlepanitaj huan tiquimacasij timitzixpanose timitzpaquilismacaj.","poem":1},{"lineBreak":true},{"text":"Nochi tiiteipan ixhuihua Israel,","poem":1},{"lineBreak":true},{"text":"timitzhueyichihuaj.","poem":1},{"lineBreak":true},{"text":"Quena, timitzhueyimatij nochi tiisraelitame.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Pampa amo techelcajtoc quema titlaijiyohuíaj,","poem":1},{"lineBreak":true},{"text":"niyon amo techhuejcamajcajtoc.","poem":1},{"lineBreak":true},{"text":"Amo neli techcuanetlatilía.","poem":1},{"lineBreak":true},{"text":"¡Amo! Ta techtlacaquilía quema timitztlajtlaníaj techpalehuiqui.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Huajca, TOTECO, ipan nopa hueyi tlasentililistli nimitzpaquilismacas iniixtla nochi momasehualhua,","poem":1},{"lineBreak":true},{"text":"pampa ta titemachtli.","poem":1},{"lineBreak":true},{"text":"Iniixpa catli mitztlepanitaj huan quiimacasij mitzixpanose,","poem":1},{"lineBreak":true},{"text":"na nijchihuas catli nimitztencahuilijtoc para nijchihuas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Huajca nochi catli teicneltzitzi tlacuase huan ixhuise.","poem":1},{"lineBreak":true},{"text":"Nochi catli quitemohuaj TOTECO quipantise huan quipaquilismacase.","poem":1},{"lineBreak":true},{"text":"Quena, paquise para nochipa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Masehualme ipan nochi tlalme campa hueli ipan tlaltipactli motepotztocase huan quielnamiquise TOTECO.","poem":1},{"lineBreak":true},{"text":"Inijuanti pehuase quihueyimatise huan motlancuaquetzase iixpa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Pampa TOTECO, yaya nopa tlanahuatijquetl catli quinahuatía nochi tlalme.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nochi catli quipiyaj tomi huan nochi catli teicneltzitzi ipan ni tlaltipactli motlancuaquetzase iixpa.","poem":1},{"lineBreak":true},{"text":"Quena, nochi tlaltipac ehuani catli teipa miquise, quihueyimatise.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nojquiya noteipan ixhuihua quihueyimatise TOTECO huan tepohuilise tlen ya nochi ininnemilis.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Quema toteipan ixhuihua tlacajtiyase,","poem":1},{"lineBreak":true},{"text":"tepohuilise para xitlahuac TOTECO huan nochi nopa huejhueyi tlamantli catli techchihuilijtoc.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}