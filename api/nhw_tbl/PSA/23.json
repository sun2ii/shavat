{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":23,"content":[{"type":"heading","content":["TOTECO nechmocuitlahuía"]},{"type":"verse","number":1,"content":[{"text":"Quen se tlamocuitlahuijquetl quinmocuitlahuía pilborregojtzitzi,","poem":1},{"lineBreak":true},{"text":"TOTECO nechmocuitlahuía.","poem":1},{"lineBreak":true},{"text":"Huan yeca amo tleno nechpolohua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaya nechsiyajquetza campa onca yejyectzi sacatl catli xoxohuic.","poem":1},{"lineBreak":true},{"text":"Nechhuica campa mantoc cuali atl catli amo mahuilili.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quema ayacmo hueli nimotlanana,","poem":1},{"lineBreak":true},{"text":"nechmaca yancuic chicahualistli.","poem":1},{"lineBreak":true},{"text":"Yaya nechyacana ipan ojtli xitlahuac para nijchijtinemis catli cuali,","poem":1},{"lineBreak":true},{"text":"huan quej nopa nochi quihueyitlalise.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Masque ninemis ipan tzintlayohuilotl nechca miquilistli,","poem":1},{"lineBreak":true},{"text":"amo tleno niquimacasis, pampa ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"tiitztoc nohuaya.","poem":1},{"lineBreak":true},{"text":"Ica mocuatopil techmanahuía ica catli amo cuali.","poem":1},{"lineBreak":true},{"text":"Huan ica mocuachijcol catli huehueyac techtilana quema seyoc ojtli nijtoquilisnequi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Techsencahuilía se cuali tlacualistli iniixpa nocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Ica aceite techpajtía campa nimococojtoc.","poem":1},{"lineBreak":true},{"text":"Techtiochijtoc hasta mocahua.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nijmati para ta, TOTECO, techyacanas nochi nonemilis ica motlaicnelijcayo,","poem":1},{"lineBreak":true},{"text":"pampa tijpiya hueyi moyolo nohuaya.","poem":1},{"lineBreak":true},{"text":"Huan teipa nimocahuas mohuaya ipan mochaj nepa ilhuicac para nochipa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}