{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":26,"content":[{"type":"heading","content":["Nopa nemilistli catli tlahuel tlapajpactli"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, techtlajtolsencahua.","poem":1},{"lineBreak":true},{"text":"Xiteyolmelahua para amo tleno catli fiero nijchijtoc.","poem":1},{"lineBreak":true},{"text":"Nimotemachijtoc san ipan ta huan amo quema nimoilhuijtoc nimitzcahuas.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Techyoltlachili, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan techyejyeco.","poem":1},{"lineBreak":true},{"text":"Xijtlachili cuali noyolo huan notlalnamiquilis catli más noyolijtic eltoc.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pampa na nijpatiita motlaicnelilis, huan nochipa nijtoquilía mocamanal catli melahuac.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amo quema ninejnentoc ininhuaya masehualme catli tlacajcayahuaj,","poem":1},{"lineBreak":true},{"text":"niyon amo nimohuicatoc ininhuaya catli quipiyaj ome iniixayac.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nijcualancaita inintlasentililis amo cuajcualme.","poem":1},{"lineBreak":true},{"text":"Amo quema nimosentilijtoc ininhuaya catli fiero quichihuaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tlapajpactli nomax tlen nochi tlajtlacoli,","poem":1},{"lineBreak":true},{"text":"huan san quej nopa nimonechcahuis motlaixpa, TOTECO.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nepa nihuicas huicatl para nimitzhueyitlalis huan niteyolmelahuas nochi catli yejyectzi catli ta tijchijtoc.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tlahuel niquicnelía mochaj campa tiitztoc, TOTECO,","poem":1},{"lineBreak":true},{"text":"campa monextía motlatlanex.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amo techchihuili quen tiquinchihuilía tlajtlacolchihuani huan temictiani.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Inijuanti quisencahuaj quenicatza huelis tetlacuijcuilise.","poem":1},{"lineBreak":true},{"text":"Quipiyaj ininmax temitoc ica tomi catli tlaichtaca tlainantoque.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pero na ninemi xitlahuac.","poem":1},{"lineBreak":true},{"text":"Xijpiya hueyi moyolo noca na,","poem":1},{"lineBreak":true},{"text":"huan techmaquixti.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"TOTECO, nimitzhueyichihua tlamiyacapa.","poem":1},{"lineBreak":true},{"text":"Ica ta, cuali niijcatoc,","poem":1},{"lineBreak":true},{"text":"huan amo techcahuilijtoc ma nihuetzi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}