{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":27,"content":[{"type":"heading","content":["TOTECO nechtlahuilía huan nechmaquixtía"]},{"type":"verse","number":1,"content":[{"text":"TOTECO nechtlahuilía huan nechmaquixtía.","poem":1},{"lineBreak":true},{"text":"¿Ajqueya ma niquimacasis?","poem":1},{"lineBreak":true},{"text":"TOTECO yaya nochicahualis,","poem":1},{"lineBreak":true},{"text":"huan na niitztoc imaco.","poem":1},{"lineBreak":true},{"text":"Amo aqui niquimacasis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quema amo cuajcualme quinequise nechhuilanase huan quinequise nechmictise,","poem":1},{"lineBreak":true},{"text":"motepotlamise huan huetzise.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Masque nochi isoldados se hueyi tlali motlananase noixpa,","poem":1},{"lineBreak":true},{"text":"amo niyolmajmahuis.","poem":1},{"lineBreak":true},{"text":"Masque nechhuilanase,","poem":1},{"lineBreak":true},{"text":"na nimotemachijtos ipan TOTECO pampa yaya itztoc nohuaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"San se tlamantli nijtlajtlanijtoc TOTECO.","poem":1},{"lineBreak":true},{"text":"San se tlamantli nijnequi.","poem":1},{"lineBreak":true},{"text":"Nijnequi niitztos ipan ichaj TOTECO nochi tonali.","poem":1},{"lineBreak":true},{"text":"Nijnequi nijhueyichihuas nepa huan nimopaquilismacas ica nochi ihueyitilis huan itlatlanex.","poem":1},{"lineBreak":true},{"text":"Quena, ipan ichaj nijtemos catli ya ipaquilis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quema ajsis tonali catli amo cuali,","poem":1},{"lineBreak":true},{"text":"TOTECO nechmocuitlahuis.","poem":1},{"lineBreak":true},{"text":"Nechtlatis ipan icaltiopa campa más tlatzejtzeloltic,","poem":1},{"lineBreak":true},{"text":"huan teipa nechquetzas ipan se hueyi tetl para nechhueyitlalis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quena, nechhueyitlalis iniixpa nocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Yeca na nijtencahuas tlacajcahualistli ipan icaltiopa,","poem":1},{"lineBreak":true},{"text":"huan nicuatzajtzis ica paquilistli.","poem":1},{"lineBreak":true},{"text":"Nihuicas huan nitlatzotzonas para nijpaquilismacas TOTECO.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"TOTECO, techtlacaquili pampa nimitznojnotza.","poem":1},{"lineBreak":true},{"text":"Xijpiya hueyi moyolo noca na,","poem":1},{"lineBreak":true},{"text":"huan technanquili.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO, quema techilhuía:","poem":1},{"lineBreak":true},{"text":"“Techcamanalhuiqui”,","poem":1},{"lineBreak":true},{"text":"na nimitznanquilía:","poem":1},{"lineBreak":true},{"text":"“Nimitzcamanalhuiti”.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Amo techcuanetlatili!","poem":1},{"lineBreak":true},{"text":"¡Amo techhuejcamajcahua pampa ticualantoc nohuaya!","poem":1},{"lineBreak":true},{"text":"San ta catli techpalehuía,","poem":1},{"lineBreak":true},{"text":"noTeco Dios, ta catli tinotemaquixtijca.","poem":1},{"lineBreak":true},{"text":"Amo techiyocacahua, niyon amo techcajtehua noseltzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Masque notata huan nonana nechtlahuelcahuase,","poem":1},{"lineBreak":true},{"text":"TOTECO, ta nochipa techmocuitlahuis.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"TOTECO, technextili catli tijnequi ma nijchihua.","poem":1},{"lineBreak":true},{"text":"Techyacana san ipan nopa ojtli cuali campa tijnequi ma ninejnemi,","poem":1},{"lineBreak":true},{"text":"pampa nocualancaitacahua nechyahualohuaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Amo techtemactili ininmaco quen inijuanti quinequij,","poem":1},{"lineBreak":true},{"text":"pampa noca na motlanantoque masehualme catli istlacatij huan san quimatij catli más fiero nechchihuilise.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pero na cuali nijmati TOTECO nechmanahuis,","poem":1},{"lineBreak":true},{"text":"huan sempa niquitas quenicatza cuali iyolo nohuaya ipan ni tlaltipactli campa niitztoc.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ximochiya ipan TOTECO.","poem":1},{"lineBreak":true},{"text":"Ximotemaca huan ximoyolchicahua huan amo ximomajmati.","poem":1},{"lineBreak":true},{"text":"Quena, ximotemachi ipan TOTECO.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}