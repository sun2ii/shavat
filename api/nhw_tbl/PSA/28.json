{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":28,"content":[{"type":"heading","content":["Toteco quitlacaquilía quema timotlatlajtíaj"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, tinotlamanahuijca.","poem":1},{"lineBreak":true},{"text":"San ipan ta nimotlatía.","poem":1},{"lineBreak":true},{"text":"Ta catli nimitztzajtzilía techpalehuiqui.","poem":1},{"lineBreak":true},{"text":"Amo ximotlahuelnequi para technanquilis,","poem":1},{"lineBreak":true},{"text":"pampa sintla amo technanquilis,","poem":1},{"lineBreak":true},{"text":"san nimotemacas para ma nechmictica.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xijcaqui nocamanal quema nimitztlajtlanía tlapalehuili.","poem":1},{"lineBreak":true},{"text":"Techchihuili cuenta quema nimomatlananas huan nijmelactlachilis mocaltiopa catli tlahuel tlatzejtzeloltic.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amo techtlatzacuilti ininhuaya masehualme catli amo cuajcualme catli san quichihuaj catli amo monequi.","poem":1},{"lineBreak":true},{"text":"Inijuanti camanaltij yejyectzi ica sequinoc,","poem":1},{"lineBreak":true},{"text":"pero quipiyaj nochi catli amo cuali ipan ininyolo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xiquincuepili nochi catli amo cuali quichijtoque ica catli amo cuali nojquiya.","poem":1},{"lineBreak":true},{"text":"Xiquintlaxtlahui ica catli fiero san se quen fiero quinchihuilijtoque sequinoc.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO, inijuanti amo quichihuilíaj cuenta nochi catli tijchijtoc,","poem":1},{"lineBreak":true},{"text":"huajca tiquintzontlamiltis huan amo quema tiquintlananas sempa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"TOTECO, nimitzpaquilismacas pampa tijtlacaquilijtoc catli nimitztlajtlanijtoc.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"TOTECO, yaya nochicahualis huan notlamanahuijca ica nochi catli mahuilili.","poem":1},{"lineBreak":true},{"text":"Ipan ya nimoneltemachijtoc huan nechpalehuijtoc,","poem":1},{"lineBreak":true},{"text":"yeca ipan noyolo nijpiya miyac paquilistli.","poem":1},{"lineBreak":true},{"text":"Nihuicas huan nimitztlascamatis, TOTECO.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO, ta tiquinpixtoc momaco nochi momasehualhua.","poem":1},{"lineBreak":true},{"text":"Yeca san ipan ta motemachía motlanahuatijca catli tijtlapejpenijtoc.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xijmaquixti moaltepe, TOTECO.","poem":1},{"lineBreak":true},{"text":"Huan xiquintiochihua inijuanti catli moaxcahua.","poem":1},{"lineBreak":true},{"text":"Techmocuitlahui quen se quinmocuitlahuía ipilborregojhua.","poem":1},{"lineBreak":true},{"text":"Techhuica momaco para nochipa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}