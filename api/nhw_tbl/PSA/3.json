{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":3,"content":[{"type":"heading","content":["Se netlatlajtili para Toteco Dios ma quipalehui"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, nelía momiyaquilíaj nocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Quena, nelmiyaqui motlananaj para nechhuilanase.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Miyaqui quiijtohuaj para ta amo quema techpalehuis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pero TOTECO, ta techyahualohua para techmanahuis.","poem":1},{"lineBreak":true},{"text":"Ta catli techhueyitlalía huan san ta catli tihueli techyolchicahua.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chicahuac nimitztzajtzili, TOTECO,","poem":1},{"lineBreak":true},{"text":"para techpalehuis.","poem":1},{"lineBreak":true},{"text":"Huan ta technanquili hasta campa tionitztoc nepa ipan motepe catli tlatzejtzeloltic.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yeca nimotejqui huan cuali nicochqui.","poem":1},{"lineBreak":true},{"text":"Huan quema niisac,","poem":1},{"lineBreak":true},{"text":"amo tleno nopantitoya pampa ta, TOTECO, techmocuitlahuía.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ama ayacmo nechmajmatise masque majtlactli mil nocualancaitacahua nechyahualose para nechhuilanase.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ximotlanana, TOTECO.","poem":1},{"lineBreak":true},{"text":"Techmaquixti, ta tinoTeco Dios.","poem":1},{"lineBreak":true},{"text":"Chicahuac xiquinmaquili nochi nocualancaitacahua ipan iniixayac.","poem":1},{"lineBreak":true},{"text":"Xiquintlanpojpostequi nopa mosisinijca masehualme,","poem":1},{"lineBreak":true},{"text":"para tlamis nochi ininchicahualis huan amo tleno huelis nechchihuilise.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"San ta, TOTECO, hueli titemaquixtía.","poem":1},{"lineBreak":true},{"text":"Hueyi paquilistli quipiyaj nochi momasehualhua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}