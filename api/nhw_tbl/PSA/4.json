{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":4,"content":[{"type":"heading","content":["Monequi timotemachise ipan Toteco Dios"]},{"type":"verse","number":1,"content":[{"text":"Toteco Dios, ta techchijtoc nixitlahuac moixpa,","poem":1},{"lineBreak":true},{"text":"Se favor technanquili quema nimitznojnotza.","poem":1},{"lineBreak":true},{"text":"Ta catli nochipa techpalehuía quema nitlaijiyohuía,","poem":1},{"lineBreak":true},{"text":"ama sempa techtlasojtla huan xijcaqui quema nimotlatlajtía.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Huan Toteco quinanquilía.","poem":1},{"lineBreak":true},{"text":"“Anmasehualme, xijtlacaquilica ya ni:","poem":1},{"lineBreak":true},{"text":"¿Hasta quema tlamis para annoca paquise na,","poem":1},{"lineBreak":true},{"text":"catli más quinamiqui nijselis tlatlepanitacayotl?","poem":1},{"lineBreak":true},{"text":"¿Hasta quema noja anquinhueyichihuase tlaixcopincayome catli amo neli ya Dios?","poem":1},{"lineBreak":true},{"text":"¿Hasta quema noja anmocahuase ma anmechcajcayahuaca?”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Anmasehualme, xijmatica ya ni.","poem":1},{"lineBreak":true},{"text":"TOTECO techiyocatlalijtoc para tiiaxcahua nochi tojuanti catli techcojtoc.","poem":1},{"lineBreak":true},{"text":"Huan yaya nechtlacaquilía quema nijnojnotza huan nechchihuilía catli nijtlajtlanía.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Masque anhuihuipicaj ica cualantli,","poem":1},{"lineBreak":true},{"text":"amo xitlajtlacolchihuaca.","poem":1},{"lineBreak":true},{"text":"Quema anmotectose ipan amotlapech huan amo tleno molinía,","poem":1},{"lineBreak":true},{"text":"ximonejnehuilica catli eltoc ipan amoyolo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xijchihuaca catli quinequi TOTECO huan ya nopa elis quen anquimacasquíaj se tlacajcahualistli catli quipactía.","poem":1},{"lineBreak":true},{"text":"Quena, ximotemachica ipan ya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Miyac quiijtohuaj:","poem":1},{"lineBreak":true},{"text":"“Amo aqui huelis techpalehuis.”","poem":1},{"lineBreak":true},{"text":"Pero ta tihueli, TOTECO.","poem":1},{"lineBreak":true},{"text":"Techcualita huan techtiochihua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ta tijtlalijtoc ipan noyolo más paquilistli,","poem":1},{"lineBreak":true},{"text":"huan amo quen catli quipiyaj masehualme catli quipixcaj miyac trigo,","poem":1},{"lineBreak":true},{"text":"o quipiyaj miyac xocomecatl iayo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yeca na nimotecas ica paquilistli ipan noyolo huan ica cuali nicochis,","poem":1},{"lineBreak":true},{"text":"pampa nijmati san ta, TOTECO, techmanahuía huan amo aqui huelis tlen nechchihuilis.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}