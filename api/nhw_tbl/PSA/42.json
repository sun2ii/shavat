{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":42,"content":[{"type":"heading","content":["Israelitame catli quinhuicatoque seyoc tlali quielnamiquij inintlal"]},{"type":"verse","number":1,"content":[{"text":"Quen se masatl catli tlahuel amiqui quitemojtinemi se atlajtli para atlis,","poem":1},{"lineBreak":true},{"text":"quej nopa na nimitzyoltemohua, noTeco Dios.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quena, quen se catli tlahuel amiqui,","poem":1},{"lineBreak":true},{"text":"na ipan noyolo nimitznequi Toteco,","poem":1},{"lineBreak":true},{"text":"ta catli nelnelía tiitztoc.","poem":1},{"lineBreak":true},{"text":"¿Hasta quema huelis niyas huan nimonextis moixpa?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yohuali huan tonali nichoca huan amo nitlacua.","poem":1},{"lineBreak":true},{"text":"Nocualancaitacahua tlatoctzitzi nechtlatzintoquilíaj:","poem":1},{"lineBreak":true},{"text":"“¿Canque itztoc moDios?","poem":1},{"lineBreak":true},{"text":"¿Para tlen amo mitzpalehuía?”","poem":1},{"lineBreak":true},{"text":"Quen nopa nechilhuíaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Quema niquelnamiqui quen eliyaya achtihuiya nepa ipan notlal, eltoc quen atiya noyolo.","poem":1},{"lineBreak":true},{"text":"Niyohuiyaya ininhuaya miyaqui masehualme hasta ichaj Toteco Dios.","poem":1},{"lineBreak":true},{"text":"Na niquinyacanayaya nochime hasta ichaj ipan nopa hueyi ilhuitl.","poem":1},{"lineBreak":true},{"text":"Titzajtzitiyohuiyayaj ica paquilistli,","poem":1},{"lineBreak":true},{"text":"huan tijtlascamatiyayaj Toteco Dios pampa para ya tiilhuichihuayayaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Huajca nimoilhuía:","poem":1},{"lineBreak":true},{"text":"“Amo monequi nimotequipachos.","poem":1},{"lineBreak":true},{"text":"Na nimotemachijtoc ipan noTeco Dios,","poem":1},{"lineBreak":true},{"text":"huan sempa nijpaquilismacas,","poem":1},{"lineBreak":true},{"text":"pampa yaya noDios huan notemaquixtijca.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pero noTeco, nelía nimotequipachohua nica campa niitztoc ipan ni tlali catli huejca.","poem":1},{"lineBreak":true},{"text":"Yeca nimitzelnamiquis,","poem":1},{"lineBreak":true},{"text":"huan niquelnamiquis quen tijpixqui hueyi moyolo tohuaya catli tiehuaj ipan motlal.","poem":1},{"lineBreak":true},{"text":"Niquelnamiqui nopa tlali yejyectzi catli pehua campa motlalohua nopa atlajtli Jordán,","poem":1},{"lineBreak":true},{"text":"huan ontlami hasta campa motlanantoc nopa tepeme Hermón huan Mizar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ama ta techtitlanilijtoc tequipacholi catli nechijiyomictía.","poem":1},{"lineBreak":true},{"text":"Quena, miyac tequipacholi nechajsitoc quen imiyaca atl catli huetzi tlen tepeixco hasta ipan na.","poem":1},{"lineBreak":true},{"text":"Caquisti quen miyac atl catli tlacomontoc,","poem":1},{"lineBreak":true},{"text":"huan nochi nopa atl panotoc ipan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Pero ica ijnaloc TOTECO nechtitlanilis itlaicnelilis.","poem":1},{"lineBreak":true},{"text":"Huan ica tlayohua yaya nechmacas se huicatl para nijhueyichihuas,","poem":1},{"lineBreak":true},{"text":"huan nimotlatlajtía ica ya.","poem":1},{"lineBreak":true},{"text":"Quena, nijnojnotza NoTeco catli mojmostla nechmaca nemilistli.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Niquilhuis Toteco Dios:","poem":1},{"lineBreak":true},{"text":"“Ipan ta nimotlatía huan amo aqui hueli nechajsis.","poem":1},{"lineBreak":true},{"text":"¿Para tlen techelcajtoc?","poem":1},{"lineBreak":true},{"text":"Na san nimotequipachojtinemi,","poem":1},{"lineBreak":true},{"text":"pampa nocualancaitacahua nechtlaijiyohuiltíaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Catli nocualancaitacahua nechchihuilíaj nechcocohua hasta ajsi ipan noomiyohua,","poem":1},{"lineBreak":true},{"text":"pampa nechtlaijilhuíaj huan nechtlatzintoquilíaj tlatoctzitzi:","poem":1},{"lineBreak":true},{"text":"‘¿Canque itztoc moDios?","poem":1},{"lineBreak":true},{"text":"¿Para tlen amo mitzpalehuía?’ ”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pero amo monequi nimocuesihuilmacas,","poem":1},{"lineBreak":true},{"text":"niyon nimotequipachos.","poem":1},{"lineBreak":true},{"text":"Na nimotemachijtoc ipan noTeco Dios,","poem":1},{"lineBreak":true},{"text":"huan teipa sempa nijpaquilismacas pampa yaya noDios huan noTemaquixtijca.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}