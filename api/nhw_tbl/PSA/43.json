{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":43,"content":[{"type":"heading","content":["Se netlatlajtili catli quitlajtlanía Toteco ma quincuepa ipan inintlal"]},{"type":"verse","number":1,"content":[{"text":"NoTeco Dios, techtlajtolsencahua xitlahuac huan xitenextili para amo tleno nijchijtoc.","poem":1},{"lineBreak":true},{"text":"Techmanahui tlen ni istlacatica masehualme huan amo cuajcualme catli nechtelhuíaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pampa san ta tinoTeco huan tinoDios huan notlamanahuijca na.","poem":1},{"lineBreak":true},{"text":"¿Para tlen techtlahuelcajtoc?","poem":1},{"lineBreak":true},{"text":"Nimotequipachojtinemi huan más nechtlaijiyohuiltíaj nocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"huan amo tleno tijchihua.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toteco Dios, techyacana ica motlahuil huan technextili catli melahuac.","poem":1},{"lineBreak":true},{"text":"Quej nopa, quena, huelis nimocuepas motlal huan campa motepe catli tlatzejtzeloltic campa ta tiitztoc ipan mocaltiopa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quena, noTeco Dios, nicalaquis huan niajsiti hasta motlaixpa campa masehualme mitzhueyichihuaj.","poem":1},{"lineBreak":true},{"text":"Nepa nimitzpaquilismacas ica arpa, ta catli techmaca paquilistli,","poem":1},{"lineBreak":true},{"text":"pampa ta tinoTeco Dios.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"San tlapic nimotequipachos.","poem":1},{"lineBreak":true},{"text":"Na nimotemachijtoc ipan ta, noTeco Dios, huan sempa nimitzpaquilismacas,","poem":1},{"lineBreak":true},{"text":"pampa, ta tinoDios, huan tinotemaquixtijca.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}