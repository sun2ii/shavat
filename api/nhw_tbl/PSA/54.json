{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":54,"content":[{"type":"heading","content":["Se netlatlajtili para Toteco ma quimanahui tlen icualancaitacahua"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios, xihuala techmaquixtiqui pampa nochi quimatij ta tihueyi!","poem":1},{"lineBreak":true},{"text":"¡Techmanahuiqui ica mohueyi chicahualis!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Techtlacaquili quema nimotlatlajtía ica ta.","poem":1},{"lineBreak":true},{"text":"Quena, xijtlacaquili catli nimitzpohuilía,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"pampa tlahuilanca masehualme motlanantoque ica na.","poem":1},{"lineBreak":true},{"text":"Quena, masehualme catli amo quema mitzelnamiquij nechtemohuaj para nechmictise.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pero Toteco Dios nochipa nechpalehuía,","poem":1},{"lineBreak":true},{"text":"huan amo quincahuilis ma nechmictica.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Toteco quincuepilis nocualancaitacahua nochi nopa tlamantli amo cuali catli inijuanti quisencajtoque nechchihuilise.","poem":1},{"lineBreak":true},{"text":"Quena, TOTECO, ta catli nelía titemachtli, xijchihua senquistoc quen techtencahuilijtoc,","poem":1},{"lineBreak":true},{"text":"huan xiquintzontlamilti nochi nocualancaitacahua.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ica paquilistli nimitzmacas notlacajcahualis.","poem":1},{"lineBreak":true},{"text":"Nimitzhueyimatis pampa ta nelía ticuali,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"pampa ta techmanahuijtoc tlen nochi tlaohuijcayotl,","poem":1},{"lineBreak":true},{"text":"huan niquitztoc quenicatza tiquintlantoc nochi nocualancaitacahua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}