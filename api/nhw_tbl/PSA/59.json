{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":59,"content":[{"type":"heading","content":["Se netlatlajtili para Toteco ma quimanahui David"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios, techmanahui ininmaco nocualancaitacahua!","poem":1},{"lineBreak":true},{"text":"¡Techmocuitlahui tlen inijuanti catli hualajtoque para nechtzontlamiltise!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Techmanahui ininmaco tlajtlacolchijca masehualme,","poem":1},{"lineBreak":true},{"text":"inijuanti catli temictíaj!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nechpijpiyaj para quiitase quenicatza nechmictise.","poem":1},{"lineBreak":true},{"text":"Masehualme catli quipiyaj chicahualistli nechchixtoque yahualtic.","poem":1},{"lineBreak":true},{"text":"Pero amo pampa niquinchihuilijtoc se tlamantli catli amo cuali","poem":1},{"lineBreak":true},{"text":"o pampa niquinixpanotoc.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Amo! Amo tleno catli fiero niquinchihuilijtoc,","poem":1},{"lineBreak":true},{"text":"pero inijuanti mocualtlalíaj para nechmictise.","poem":1},{"lineBreak":true},{"text":"¡TOTECO, xiisa!","poem":1},{"lineBreak":true},{"text":"¡Xihuala techpalehuiqui!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO, Ta Catli Tijpiya Nochi Chicahualistli,","poem":1},{"lineBreak":true},{"text":"ta catli titoDios tiisraelitame,","poem":1},{"lineBreak":true},{"text":"ximotlanana huan xiquintlatzacuilti nopa tlalme campa itztoque masehualme catli amo israelitame,","poem":1},{"lineBreak":true},{"text":"pampa techyahualojtoque.","poem":1},{"lineBreak":true},{"text":"Amo xiquintlapojpolhui nopa masehualme catli mosisiníaj huan nimantzi tlaixpanoj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mojmostla ica tlapoyahui hualahuij para quitlachilise quenicatza huelis techtlanise.","poem":1},{"lineBreak":true},{"text":"Tzajtzitinemij quen chichime catli quiyahualojtinemij ni altepetl.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nijcaqui camanaltij fiero hasta camaposonij,","poem":1},{"lineBreak":true},{"text":"huan mitztelchihuaj Toteco,","poem":1},{"lineBreak":true},{"text":"pampa inijuanti quiijtohuaj:","poem":1},{"lineBreak":true},{"text":"“Amo aqui techcaqui.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pero ta TOTECO, san xiquinhuetzquili,","poem":1},{"lineBreak":true},{"text":"huan xiquinpinahualti ni masehualme tlen sequinoc tlalme catli nechyahualohuaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"NoTeco Dios, pampa nocualancaitacahua quipiyaj chicahualistli, ipan ta nimotemachis,","poem":1},{"lineBreak":true},{"text":"pampa ta catli techmanahuía.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"NoTeco Dios, ta nochipa techicnelijtoc miyac,","poem":1},{"lineBreak":true},{"text":"yeca nijmati para temachtli techyacantiyas.","poem":1},{"lineBreak":true},{"text":"Tijchihuas ma niquitas catli tlahuel nijnectoc ma ininpanti nocualancaitacahua.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"NoTeco, ta catli techmanahuía,","poem":1},{"lineBreak":true},{"text":"amo xiquinmicti nimantzi ni nocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"pampa huelis ni nomasehualhua nimantzi quielcahuase catli ininpantis nopa mosisinijca masehualme.","poem":1},{"lineBreak":true},{"text":"Más cuali san xiquinsemana ica mohueyi chicahualis huan xiquinechcapantlali.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Quena, xiquintlatzacuilti pampa nochi inijuanti tlahuel istlacatij, mohueyimatij huan tlatelchihuaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xiquintzontlamilti ica mohueyi cualancayo,","poem":1},{"lineBreak":true},{"text":"huan xiquintlamiixpolihuilti.","poem":1},{"lineBreak":true},{"text":"Huan quej nopa nochi masehualme quimatise para ta, Toteco Dios,","poem":1},{"lineBreak":true},{"text":"titlanahuatía ipan tlali Israel,","poem":1},{"lineBreak":true},{"text":"huan ipan nochi tlaltipactli.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nocualancaitacahua mocuepaj ica tiotlac huan tzajtzij quen chichime,","poem":1},{"lineBreak":true},{"text":"huan quiyahualojtinemij ni altepetl.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nentinemij campa hueli para quitemojtinemise inintlacualis.","poem":1},{"lineBreak":true},{"text":"Huan quema amo ixhuise,","poem":1},{"lineBreak":true},{"text":"tzajtzij seyohual quen chichime.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pero na sesen ijnaloc nihuicas ica nopa chicahualistli catli techmaca.","poem":1},{"lineBreak":true},{"text":"Huan nimitzhueyimatis pampa techtlasojtla miyac.","poem":1},{"lineBreak":true},{"text":"San ta techmanahuía huan san ipan ta nimotemachía,","poem":1},{"lineBreak":true},{"text":"quema huala tlaohuijcayotl.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Toteco Dios, momaco ta niitztoc temachtli,","poem":1},{"lineBreak":true},{"text":"yeca nimitzhueyimatis huan nihuicas para ta,","poem":1},{"lineBreak":true},{"text":"pampa san ta techmocuitlahuía huan techicnelía.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}