{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":6,"content":[{"type":"heading","content":["Quenicatza ma timotlatlajtica quema timotequipachohuaj"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, amo techajhua quema ticualani.","poem":1},{"lineBreak":true},{"text":"Amo techtlatzacuilti quema tlahuel ticualantoc.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Techtlasojtla, pampa nimococohua.","poem":1},{"lineBreak":true},{"text":"TOTECO, techchicahua, pampa tlahuel nechcocohua nochi notlacayo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nihuihuipica ica majmajtli huan amo nijmati tlaque nijchihuas.","poem":1},{"lineBreak":true},{"text":"Huan ta TOTECO, ¿hasta quema tihualas para techtlananas?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xihuala, TOTECO, techmanahuiqui para amo nimiquis.","poem":1},{"lineBreak":true},{"text":"Techmaquixti pampa tlahuel techicnelía.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amo aqui catli mictoc huelis mitzelnamiquis.","poem":1},{"lineBreak":true},{"text":"¿Ajqueya huelis mitzhueyichihuas sintla mictoc huan ya quitlalpachojtoque?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya tlanqui nofuerza ica choquistli.","poem":1},{"lineBreak":true},{"text":"Sesen yohuali nichoca miyac hasta nijtlamixolonía notzonteto.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nichocatoc miyac hasta nechcocohua noixteyol huan ayacmo hueli nitlachiya.","poem":1},{"lineBreak":true},{"text":"Quena, nichoca quema nimoilhuía catli nocualancaitacahua nechchihuilijtoque.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Techtlalcahuica, tlajtlacolchijca masehualme,","poem":1},{"lineBreak":true},{"text":"pampa TOTECO quicactoc quen nichoca.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yaya quicactoc catli nijtlajtlanijtoc,","poem":1},{"lineBreak":true},{"text":"huan quiselijtoc nonetlatlajtilis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nochi nocualancaitacahua mopinahuase huan huetzise.","poem":1},{"lineBreak":true},{"text":"Ica se tlatoctzi TOTECO quincuepas ica pinahualistli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}