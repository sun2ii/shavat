{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":67,"content":[{"type":"heading","content":["Se huicatl para quitlascamatis Toteco"]},{"type":"verse","number":1,"content":[{"text":"Toteco Dios, xijpiya hueyi moyolo ica tojuanti huan techtiochihua.","poem":1},{"lineBreak":true},{"text":"Ma petlani moixayac pampa tipaqui ica tojuanti quema techhualtlachilía hasta tlen nepa ilhuicac.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nochi masehualme ipan tlaltipactli ma quiiximatica moojhui.","poem":1},{"lineBreak":true},{"text":"Masehualme ipan nochi tlalme ma quimatica para ta titemaquixtía.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"NoTeco Dios, ma mitzpaquilismacaca nochi masehualme ipan tlaltipactli.","poem":1},{"lineBreak":true},{"text":"Quena, nochi masehualme ma mitzhueyimatica.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Ma paquica nochi masehualme ipan nochi tlalme huan ma huicaca pampa ta, tiinintlanahuatijca!","poem":1},{"lineBreak":true},{"text":"Ta tiquintlajtolsencahuas quen quinamiqui,","poem":1},{"lineBreak":true},{"text":"huan nochi tlalme tiquinyacanas xitlahuac.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡NoTeco Dios, ma mitzpaquilismacaca nochi ipan tlaltipactli!","poem":1},{"lineBreak":true},{"text":"¡Quena, nochi masehualme ma mitzhueyimatica!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ni tlali temacatoc miyac pixquistli, pampa ta, Toteco Dios,","poem":1},{"lineBreak":true},{"text":"catli titoDios tojuanti, tlahuel techtiochijtoc.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quena, noja más techtiochihuas, Toteco Dios,","poem":1},{"lineBreak":true},{"text":"huan masehualme campa hueli ipan ni tlaltipactli mitztlepanitase huan mitzimacasise mitzixpanose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}