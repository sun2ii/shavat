{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":70,"content":[{"type":"heading","content":["Se netlatlajtili para Toteco ma quipalehuiqui"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios, xihuala techmanahuiqui ininmaco nocualancaitacahua!","poem":1},{"lineBreak":true},{"text":"¡Quena, ximoisihuilti, Toteco Dios!","poem":1},{"lineBreak":true},{"text":"¡Xihuala techpalehuiqui!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inijuanti nentinemij notepotzco huan paquij quema nechtlaijiyohuiltíaj.","poem":1},{"lineBreak":true},{"text":"Yeca nimitztlajtlanía xiquinpinahualti,","poem":1},{"lineBreak":true},{"text":"huan xiquincuepalti para ayacmo ma nechchihuilica catli fiero.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xiquincuepa ica pinahualistli huan ayacmo xiquincahuili ma nechpinajtica.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero nochi masehualme catli mitztemohuaj,","poem":1},{"lineBreak":true},{"text":"xiquinmaca miyac paquilistli.","poem":1},{"lineBreak":true},{"text":"Nochi catli paquij pampa tiquinmaquixtijtoc, ma quiijtoca:","poem":1},{"lineBreak":true},{"text":"“Ma tijhueyitlalica Toteco Dios.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero na catli tlahuel nitlaijiyohuía,","poem":1},{"lineBreak":true},{"text":"nimitztlajtlanía xihuala nimantzi huan techmanahuiqui,","poem":1},{"lineBreak":true},{"text":"pampa san ta hueli techpalehuis huan techmaquixtis.","poem":1},{"lineBreak":true},{"text":"¡NoTeco Dios, amo xihuejcahua!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}