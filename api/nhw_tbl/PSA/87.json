{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":87,"content":[{"type":"heading","content":["Nelía elis se hueyi paquilistli para catli ehuaj altepetl Jerusalén"]},{"type":"verse","number":1,"content":[{"text":"Altepetl Jerusalén eltoc ipan nopa tepetl tlatzejtzeloltic catli iaxca Toteco.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Huan TOTECO quiicnelía Jerusalén achi más que nopa sequinoc pilaltepetzitzi ipan tlali Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quena, Jerusalén eltoc ialtepe Toteco Dios,","poem":1},{"lineBreak":true},{"text":"huan quema masehualme quielnamiquij,","poem":1},{"lineBreak":true},{"text":"camanaltij nelyejyectzi tlen nopa altepetl.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quema tlatlajco nohuampoyohua niquintocaxtía nopa tlalme catli inintoca Egipto, Babilonia, Filistea, Tiro huan Etiopía,","poem":1},{"lineBreak":true},{"text":"itztos se catli mohueyimatis pampa tlacatqui ipan se tlen nopa tlalme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero ajsis tonali quema masehualme quiselise más hueyi tlatlepanitacayotl pampa tlacatque ipan altepetl Jerusalén,","poem":1},{"lineBreak":true},{"text":"pampa Toteco Catli Más Hueyi quitiochihuas ni altepetl.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Huan TOTECO quiijcuilos inintoca nochi catli itztoque ipan nopa altepetl.","poem":1},{"lineBreak":true},{"text":"Huan nochi catli tlacatque nopona quintlalilis se tlanextili campa ijcuilijtos inintoca.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Huan quema ilhuichihuase inijuanti, huicase ica paquilistli huan quiijtose:","poem":1},{"lineBreak":true},{"text":"“Nochi noyolo nijtlalijtoc ipan Jerusalén.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}