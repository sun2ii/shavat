{"translation":{"id":"nhw_tbl","name":"Icamanal toteco; Santa Bíblia","website":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nhwBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Occidental Nahuatl Bible","language":"nhw","textDirection":"ltr","sha256":"769ebe62deb2ec06839a8259b360a9022dc19dd0b92a7737edf7495fbc682306","availableFormats":["json"],"listOfBooksApiLink":"/api/nhw_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Western Huasteca Nahuatl","languageEnglishName":"Western Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nhw_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"b3ca9d5fdc94a7eb9a0dfdea9d2c94729ebd2eecfd547150c344635f3f68f543","firstChapterNumber":1,"firstChapterApiLink":"/api/nhw_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nhw_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":93,"content":[{"type":"heading","content":["Toteco tlahuel hueyi"]},{"type":"verse","number":1,"content":[{"text":"¡TOTECO tlanahuatía!","poem":1},{"lineBreak":true},{"text":"Yaya tlahuel hueyi hasta quipiya itlatlanex catli onpano yejyectzi.","poem":1},{"lineBreak":true},{"text":"Quitlatzquilti nelcuali ni tlaltipactli,","poem":1},{"lineBreak":true},{"text":"huan amo hueli mojmolinis tlen itlatzinpehualtil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nochipa hasta tlen huejcajya ta tijpixtoc tlanahuatili,","poem":1},{"lineBreak":true},{"text":"huan nochi catli itztoque ipan motlanahuatilis mocahuaj temachme.","poem":1},{"lineBreak":true},{"text":"San ta tiitztoc para nochipa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"TOTECO, nopa hueyame caquisti para mitzpaquilismacaj quema mocoxoníaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero ta, TOTECO, catli tiitztoc hasta huejcapa tijpiya más chicahualistli,","poem":1},{"lineBreak":true},{"text":"huan amo quen nopa atl catli mocoxonía ipan nochi huejhueyi atl ipan tlaltipactli.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Motlanahuatilhua amo quema mopatlaj.","poem":1},{"lineBreak":true},{"text":"TOTECO, para nochi xihuitl huan para nochi tonali motequiticayo eltoc senquistoc tlatzejtzeloltic.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nhw_tbl/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nhw_tbl/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nhw_tbl/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}