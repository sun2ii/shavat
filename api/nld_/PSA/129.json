{"translation":{"id":"nld_","name":"De Heilige Schrift 1917","website":"https://ebible.org/Scriptures/details.php?id=nld","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nld","licenseNotes":null,"shortName":"","englishName":"Dutch Bible 1917","language":"nld","textDirection":"ltr","sha256":"5b232095bf927643d6624f12798418905316b3c7fc6f81dc71f625901e0ec35e","availableFormats":["json"],"listOfBooksApiLink":"/api/nld_/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Nederlands","languageEnglishName":"Dutch"},"book":{"id":"PSA","translationId":"nld_","name":"Psalmen","commonName":"Psalmen","title":"Psalmen","order":19,"numberOfChapters":150,"sha256":"fd391ac8e5b0db5129a2e2a8334e7f626d7248ffc871d89c68584b84784c93d9","firstChapterNumber":1,"firstChapterApiLink":"/api/nld_/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nld_/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":["Een lied Hammaaloth. Zij hebben mij dikwijls benauwd van mijn jeugd af, zegge nu Israel;"]},{"type":"verse","number":2,"content":["Zij hebben mij dikwijls van mijn jeugd af benauwd; evenwel hebben zij mij niet overmocht."]},{"type":"verse","number":3,"content":["Ploegers hebben op mijn rug geploegd; zij hebben hun voren lang getogen."]},{"type":"verse","number":4,"content":["De HEERE, Die rechtvaardig is, heeft de touwen der goddelozen afgehouwen."]},{"type":"verse","number":5,"content":["Laat hen beschaamd en achterwaarts gedreven worden, allen, die Sion haten."]},{"type":"verse","number":6,"content":["Laat hen worden als gras op de daken, hetwelk verdort, eer men het uittrekt;"]},{"type":"verse","number":7,"content":["Waarmede de maaier zijn hand niet vult, noch de garvenbinder zijn arm;"]},{"type":"verse","number":8,"content":["En die voorbijgaan, niet zeggen: De zegen des HEEREN zij bij u! Wij zegenen ulieden in den Naam des HEEREN."]}],"footnotes":[]},"thisChapterLink":"/api/nld_/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nld_/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nld_/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}