{"translation":{"id":"nld_1939","name":"De Heilige Schrift, Petrus Canisiusvertaling, 1939","website":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseNotes":null,"shortName":"1939","englishName":"Dutch Bible, Petrus Canisius","language":"nld","textDirection":"ltr","sha256":"eccaa987cda01c8a7652cff2eabab82acaef3e03508ec83181dd587939588fc7","availableFormats":["json"],"listOfBooksApiLink":"/api/nld_1939/books.json","numberOfBooks":65,"totalNumberOfChapters":1177,"totalNumberOfVerses":30743,"languageName":"Nederlands","languageEnglishName":"Dutch","numberOfApocryphalBooks":8,"totalNumberOfApocryphalChapters":151,"totalNumberOfApocryphalVerses":4592},"book":{"id":"PSA","translationId":"nld_1939","name":"Psalmen","commonName":"Psalmen","title":"De psalmen","order":19,"numberOfChapters":150,"sha256":"1800312358a54f0949b40a8dd815a91f44733f0eff3e59c23fae1d0bff404d24","firstChapterNumber":1,"firstChapterApiLink":"/api/nld_1939/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nld_1939/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Gelukkig de man, Die de raad der goddelozen niet volgt, Niet de weg der zondaars betreedt, Niet neerzit in de kring van de spotters;"]},{"type":"verse","number":2,"content":["Maar die zijn vreugde vindt in Jahweh’s wet, En dag en nacht zijn wet overweegt."]},{"type":"verse","number":3,"content":["Hij is als een boom, aan stromend water geplant, Die zijn vrucht geeft op tijd, Waarvan het blad niet verwelkt: Al wat hij doet zal gedijen."]},{"type":"verse","number":4,"content":["De goddelozen zal het heel anders gaan: Als kaf opgejaagd door de wind!"]},{"type":"verse","number":5,"content":["Daarom houden de bozen het bij het oordeel niet uit, De zondaars niet in de gemeenschap der vromen."]},{"type":"verse","number":6,"content":["Want Jahweh kent het pad der rechtvaardigen, Maar de weg der g