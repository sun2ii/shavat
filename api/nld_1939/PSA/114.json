{"translation":{"id":"nld_1939","name":"De Heilige Schrift, Petrus Canisiusvertaling, 1939","website":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseNotes":null,"shortName":"1939","englishName":"Dutch Bible, Petrus Canisius","language":"nld","textDirection":"ltr","sha256":"eccaa987cda01c8a7652cff2eabab82acaef3e03508ec83181dd587939588fc7","availableFormats":["json"],"listOfBooksApiLink":"/api/nld_1939/books.json","numberOfBooks":65,"totalNumberOfChapters":1177,"totalNumberOfVerses":30743,"languageName":"Nederlands","languageEnglishName":"Dutch","numberOfApocryphalBooks":8,"totalNumberOfApocryphalChapters":151,"totalNumberOfApocryphalVerses":4592},"book":{"id":"PSA","translationId":"nld_1939","name":"Psalmen","commonName":"Psalmen","title":"De psalmen","order":19,"numberOfChapters":150,"sha256":"1800312358a54f0949b40a8dd815a91f44733f0eff3e59c23fae1d0bff404d24","firstChapterNumber":1,"firstChapterApiLink":"/api/nld_1939/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nld_1939/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":["Halleluja! Toen Israël uit Egypte trok, Jakobs huis uit een volk van barbaren,"]},{"type":"verse","number":2,"content":["Werd Juda zijn heiligdom, En Israël zijn rijk."]},{"type":"verse","number":3,"content":["De zee zag het, en sloeg op de vlucht, De Jordaan deinsde terug;"]},{"type":"verse","number":4,"content":["Als rammen sprongen de bergen weg, Als lammeren de heuvels."]},{"type":"verse","number":5,"content":["Zee, wat was er, dat gij gingt vluchten, Jordaan, dat gij achteruit zijt geweken;"]},{"type":"verse","number":6,"content":["Bergen, dat gij wegsprongt als rammen, Gij heuvels als lammeren?"]},{"type":"verse","number":7,"content":["Voor den Heer kromp de aarde ineen, Voor het aangezicht van Jakobs God;"]},{"type":"verse","number":8,"content":["Die de rots in een vijver herschiep, De klip in een borrelende bron!"]}],"footnotes":[]},"thisChapterLink":"/api/nld_1939/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nld_1939/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nld_1939/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}