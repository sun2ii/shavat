{"translation":{"id":"nld_1939","name":"De Heilige Schrift, Petrus Canisiusvertaling, 1939","website":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseNotes":null,"shortName":"1939","englishName":"Dutch Bible, Petrus Canisius","language":"nld","textDirection":"ltr","sha256":"eccaa987cda01c8a7652cff2eabab82acaef3e03508ec83181dd587939588fc7","availableFormats":["json"],"listOfBooksApiLink":"/api/nld_1939/books.json","numberOfBooks":65,"totalNumberOfChapters":1177,"totalNumberOfVerses":30743,"languageName":"Nederlands","languageEnglishName":"Dutch","numberOfApocryphalBooks":8,"totalNumberOfApocryphalChapters":151,"totalNumberOfApocryphalVerses":4592},"book":{"id":"PSA","translationId":"nld_1939","name":"Psalmen","commonName":"Psalmen","title":"De psalmen","order":19,"numberOfChapters":150,"sha256":"1800312358a54f0949b40a8dd815a91f44733f0eff3e59c23fae1d0bff404d24","firstChapterNumber":1,"firstChapterApiLink":"/api/nld_1939/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nld_1939/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":["Een bedevaartslied. Toen Jahweh Sion uit de ballingschap bracht, Was het ons als een droom;"]},{"type":"verse","number":2,"content":["Toen werd onze mond met lachen gevuld, Onze tong met gejubel. Toen zei men onder de volken: “Jahweh heeft hun grote dingen gedaan!”"]},{"type":"verse","number":3,"content":["Ja, grote dingen heeft Jahweh ons gedaan; En daarom zijn wij verheugd!"]},{"type":"verse","number":4,"content":["Ach Jahweh, wend ons lot weer ten beste, Als voor de dorre greppels van Négeb:"]},{"type":"verse","number":5,"content":["Die nu zaaien met tranen, Laat ze maaien met jubel!"]},{"type":"verse","number":6,"content":["Met geween trekt men op, Om het zaad uit te strooien: Maar met gejuich keert men terug, Met schoven beladen!"]}],"footnotes":[]},"thisChapterLink":"/api/nld_1939/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nld_1939/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nld_1939/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}