{"translation":{"id":"nld_1939","name":"De Heilige Schrift, Petrus Canisiusvertaling, 1939","website":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseNotes":null,"shortName":"1939","englishName":"Dutch Bible, Petrus Canisius","language":"nld","textDirection":"ltr","sha256":"eccaa987cda01c8a7652cff2eabab82acaef3e03508ec83181dd587939588fc7","availableFormats":["json"],"listOfBooksApiLink":"/api/nld_1939/books.json","numberOfBooks":65,"totalNumberOfChapters":1177,"totalNumberOfVerses":30743,"languageName":"Nederlands","languageEnglishName":"Dutch","numberOfApocryphalBooks":8,"totalNumberOfApocryphalChapters":151,"totalNumberOfApocryphalVerses":4592},"book":{"id":"PSA","translationId":"nld_1939","name":"Psalmen","commonName":"Psalmen","title":"De psalmen","order":19,"numberOfChapters":150,"sha256":"1800312358a54f0949b40a8dd815a91f44733f0eff3e59c23fae1d0bff404d24","firstChapterNumber":1,"firstChapterApiLink":"/api/nld_1939/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nld_1939/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":["Halleluja! Zingt een nieuw lied ter ere van Jahweh, Zijn lof in de gemeenschap der vromen."]},{"type":"verse","number":2,"content":["Laat Israël zich in zijn Schepper verheugen, Sions kinderen zich in hun Koning verblijden;"]},{"type":"verse","number":3,"content":["Zijn Naam met reidansen vieren, Hem verheerlijken met pauken en citer!"]},{"type":"verse","number":4,"content":["Want Jahweh heeft zijn volk begenadigd, De verdrukten met zege gekroond;"]},{"type":"verse","number":5,"content":["Laat de vromen nu hun krijgsroem bezingen, En jubelen over hun wapens:"]},{"type":"verse","number":6,"content":["Met Gods lof in hun keel, En een tweesnijdend zwaard in hun hand!"]},{"type":"verse","number":7,"content":["Zich op de heidenen wreken, De volken richten,"]},{"type":"verse","number":8,"content":["Hun koningen in ketenen slaan, Hun vorsten in ijzeren boeien,"]},{"type":"verse","number":9,"content":["Aan hen het vonnis voltrekken, zoals het geveld is: Dìt is de glorie van al zijn vromen! Halleluja!"]}],"footnotes":[]},"thisChapterLink":"/api/nld_1939/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nld_1939/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nld_1939/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}