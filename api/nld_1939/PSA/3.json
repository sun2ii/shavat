{"translation":{"id":"nld_1939","name":"De Heilige Schrift, Petrus Canisiusvertaling, 1939","website":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseNotes":null,"shortName":"1939","englishName":"Dutch Bible, Petrus Canisius","language":"nld","textDirection":"ltr","sha256":"eccaa987cda01c8a7652cff2eabab82acaef3e03508ec83181dd587939588fc7","availableFormats":["json"],"listOfBooksApiLink":"/api/nld_1939/books.json","numberOfBooks":65,"totalNumberOfChapters":1177,"totalNumberOfVerses":30743,"languageName":"Nederlands","languageEnglishName":"Dutch","numberOfApocryphalBooks":8,"totalNumberOfApocryphalChapters":151,"totalNumberOfApocryphalVerses":4592},"book":{"id":"PSA","translationId":"nld_1939","name":"Psalmen","commonName":"Psalmen","title":"De psalmen","order":19,"numberOfChapters":150,"sha256":"1800312358a54f0949b40a8dd815a91f44733f0eff3e59c23fae1d0bff404d24","firstChapterNumber":1,"firstChapterApiLink":"/api/nld_1939/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nld_1939/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Een psalm van David, bij zijn vlucht voor zijn zoon Absalom. Jahweh, hoe talrijk zijn mijn belagers, Hoe talrijk, die tegen mij opstaan;"]},{"type":"verse","number":2,"content":["Hoe velen, die van mij zeggen: Voor hem geen heil bij zijn God!"]},{"type":"verse","number":3,"content":["Toch zijt Gij, Jahweh, het schild dat mij dekt, Mijn glorie en trots!"]},{"type":"verse","number":4,"content":["Ik behoef maar tot Jahweh te roepen, Dan verhoort Hij mij van zijn heilige berg."]},{"type":"verse","number":5,"content":["Ik leg mij neer, slaap rustig in, Ontwaak, want Jahweh beschut mij."]},{"type":"verse","number":6,"content":["Zo vrees ik de duizenden niet, Die van alle kant mij omringen."]},{"type":"verse","number":7,"content":["Sta op dan, Jahweh; Red mij, mijn God! Want Gij slaat al mijn vijanden in het gezicht, Stoot de bozen hun tanden stuk."]},{"type":"verse","number":8,"content":["Bij U, Jahweh, is redding; Op uw volk rust uw zegen."]}],"footnotes":[]},"thisChapterLink":"/api/nld_1939/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nld_1939/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nld_1939/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}