{"translation":{"id":"nld_1939","name":"De Heilige Schrift, Petrus Canisiusvertaling, 1939","website":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseNotes":null,"shortName":"1939","englishName":"Dutch Bible, Petrus Canisius","language":"nld","textDirection":"ltr","sha256":"eccaa987cda01c8a7652cff2eabab82acaef3e03508ec83181dd587939588fc7","availableFormats":["json"],"listOfBooksApiLink":"/api/nld_1939/books.json","numberOfBooks":65,"totalNumberOfChapters":1177,"totalNumberOfVerses":30743,"languageName":"Nederlands","languageEnglishName":"Dutch","numberOfApocryphalBooks":8,"totalNumberOfApocryphalChapters":151,"totalNumberOfApocryphalVerses":4592},"book":{"id":"PSA","translationId":"nld_1939","name":"Psalmen","commonName":"Psalmen","title":"De psalmen","order":19,"numberOfChapters":150,"sha256":"1800312358a54f0949b40a8dd815a91f44733f0eff3e59c23fae1d0bff404d24","firstChapterNumber":1,"firstChapterApiLink":"/api/nld_1939/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nld_1939/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":["Voor muziekbegeleiding; met harpen. Een leerdicht van David, toen de Zifieten Saül kwamen melden: “David houdt zich bij ons schuil.” O God, kom mij te hulp door uw Naam, En verschaf mij recht door uw kracht."]},{"type":"verse","number":2,"content":["Hoor naar mijn smeken, o God, Luister naar het gebed van mijn mond."]},{"type":"verse","number":3,"content":["Want vreemden staan tegen mij op, En geweldenaars belagen mijn leven; Neen, ze houden God niet voor ogen."]},{"type":"verse","number":4,"content":["Zie, God is mijn Helper; Het is de Heer, die mijn leven behoudt!"]},{"type":"verse","number":5,"content":["Wend de rampen op mijn vijanden af, Verniel ze om wille van uw trouw."]},{"type":"verse","number":6,"content":["Dan zal ik U gaarne offers brengen, En danken, o Jahweh, de goedertierenheid van uw Naam;"]},{"type":"verse","number":7,"content":["Omdat hij mij uit alle nood heeft verlost, En mijn oog zich aan mijn vijand verlustigt."]}],"footnotes":[]},"thisChapterLink":"/api/nld_1939/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nld_1939/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nld_1939/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}