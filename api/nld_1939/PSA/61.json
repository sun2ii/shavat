{"translation":{"id":"nld_1939","name":"De Heilige Schrift, Petrus Canisiusvertaling, 1939","website":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseNotes":null,"shortName":"1939","englishName":"Dutch Bible, Petrus Canisius","language":"nld","textDirection":"ltr","sha256":"eccaa987cda01c8a7652cff2eabab82acaef3e03508ec83181dd587939588fc7","availableFormats":["json"],"listOfBooksApiLink":"/api/nld_1939/books.json","numberOfBooks":65,"totalNumberOfChapters":1177,"totalNumberOfVerses":30743,"languageName":"Nederlands","languageEnglishName":"Dutch","numberOfApocryphalBooks":8,"totalNumberOfApocryphalChapters":151,"totalNumberOfApocryphalVerses":4592},"book":{"id":"PSA","translationId":"nld_1939","name":"Psalmen","commonName":"Psalmen","title":"De psalmen","order":19,"numberOfChapters":150,"sha256":"1800312358a54f0949b40a8dd815a91f44733f0eff3e59c23fae1d0bff404d24","firstChapterNumber":1,"firstChapterApiLink":"/api/nld_1939/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nld_1939/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":["Voor muziekbegeleiding; met harpen. Van David. Hoor toch, o God, mijn gejammer, En let op mijn smeken:"]},{"type":"verse","number":2,"content":["Van het einde der aarde roep ik tot U In de beklemmende angst van mijn hart. Stel mij hoog op de Rots, en laat mij daar rusten,"]},{"type":"verse","number":3,"content":["Want Gij zijt mijn toevlucht en sterkte tegen den vijand;"]},{"type":"verse","number":4,"content":["Laat mij in uw woontent voor eeuwig uw gast zijn, En mij verbergen in de schaduw uwer vleugelen."]},{"type":"verse","number":5,"content":["Want Gij hoort mijn beloften, o mijn God, En vervult de wens van hen, die uw Naam vrezen:"]},{"type":"verse","number":6,"content":["Vermeerder de dagen des konings, En zijn jaren van geslacht tot geslacht;"]},{"type":"verse","number":7,"content":["Moge hij altijd voor Gods aangezicht tronen, En liefde en trouw hem behoeden."]},{"type":"verse","number":8,"content":["Dan zal ik uw Naam in eeuwigheid prijzen, Dag aan dag U mijn dankoffer brengen!"]}],"footnotes":[]},"thisChapterLink":"/api/nld_1939/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nld_1939/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nld_1939/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}