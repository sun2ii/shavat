{"translation":{"id":"nld_1939","name":"De Heilige Schrift, Petrus Canisiusvertaling, 1939","website":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nld1939","licenseNotes":null,"shortName":"1939","englishName":"Dutch Bible, Petrus Canisius","language":"nld","textDirection":"ltr","sha256":"eccaa987cda01c8a7652cff2eabab82acaef3e03508ec83181dd587939588fc7","availableFormats":["json"],"listOfBooksApiLink":"/api/nld_1939/books.json","numberOfBooks":65,"totalNumberOfChapters":1177,"totalNumberOfVerses":30743,"languageName":"Nederlands","languageEnglishName":"Dutch","numberOfApocryphalBooks":8,"totalNumberOfApocryphalChapters":151,"totalNumberOfApocryphalVerses":4592},"book":{"id":"PSA","translationId":"nld_1939","name":"Psalmen","commonName":"Psalmen","title":"De psalmen","order":19,"numberOfChapters":150,"sha256":"1800312358a54f0949b40a8dd815a91f44733f0eff3e59c23fae1d0bff404d24","firstChapterNumber":1,"firstChapterApiLink":"/api/nld_1939/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nld_1939/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":["Een lied van Asaf. God staat op in de goddelijke raad, Houdt gericht te midden der goden!"]},{"type":"verse","number":2,"content":["Hoelang nog zult gij onrechtvaardige vonnissen vellen, En voor de bozen partij blijven trekken?"]},{"type":"verse","number":3,"content":["Neemt het op voor zwakken en wezen, Geef den geringe en verdrukte zijn recht:"]},{"type":"verse","number":4,"content":["Redt den behoeftige en arme, En rukt ze uit de handen der bozen!"]},{"type":"verse","number":5,"content":["Maar ze hebben verstand noch begrip; ze tasten in duisternis rond, En brengen alle grondslagen der aarde aan het wankelen!"]},{"type":"verse","number":6,"content":["Ik had gezegd: Gij zijt goden, Zonen van den Allerhoogste, gij allen;"]},{"type":"verse","number":7,"content":["Maar gij zult sterven als mensen, En als een der afgoden vallen!"]},{"type":"verse","number":8,"content":["Sta op, o God, en richt de aarde; Want alle volkeren behoren U toe!"]}],"footnotes":[]},"thisChapterLink":"/api/nld_1939/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nld_1939/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nld_1939/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}