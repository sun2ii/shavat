j bezit alle volken."]}],"footnotes":[]},"thisChapterLink":"/api/nld_nbg/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nld_nbg/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nld_nbg/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}