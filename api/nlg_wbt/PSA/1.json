{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Ghau, [na togotogo/nina vauto God] vanira","poem":1},{"lineBreak":true},{"text":"ara hei tara mua taonia didira na uhuhuli tara dika,","poem":1},{"lineBreak":true},{"text":"pa kara tughuru kolura rana tangohahi,","poem":1},{"lineBreak":true},{"text":"pa kara nira udu kolu rana tangotangodika.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma gaira tara lioni vamua na taoniani","poem":1},{"lineBreak":true},{"text":"na lei totobo te lioni a Lord;","poem":1},{"lineBreak":true},{"text":"na bongi mana dani tara ghanaghanai","poem":1},{"lineBreak":true},{"text":"vamua na lei nina vetena.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gaira te vaghara na lei ghai","poem":1},{"lineBreak":true},{"text":"tara subai lilighini na lei beti,","poem":1},{"lineBreak":true},{"text":"ma gaira tara vangagha tughu niulu,","poem":1},{"lineBreak":true},{"text":"te mua ghoi taho tua.","poem":1},{"lineBreak":true},{"text":"Mana rauraudira te mua ghoi dudu ghua,","poem":1},{"lineBreak":true},{"text":"mana hava tara gonighi vamua ilokani,","poem":1},{"lineBreak":true},{"text":"te maemane tona haliu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma eni gaia te mua utuni itadira rana kiko;","poem":1},{"lineBreak":true},{"text":"A gaira te vaghara na totobo lee vamua,","poem":1},{"lineBreak":true},{"text":"te havukaghini kolilira na ghuri.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma gaira kara dete matera tana bongi ni dete.","poem":1},{"lineBreak":true},{"text":"Rana tangotangodika te taho na maladira itadira rana uto.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na pukuna Lord te vatoghai na halautudira tara uto,","poem":1},{"lineBreak":true},{"text":"me vatoghai ghua na halautudira rana kiko te uhulira va tana totoro te sule.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/EST/10.json","previousChapterAudioLinks":{},"numberOfVerses":6}