","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}