{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Na linge nina David"]},{"type":"verse","number":1,"content":[{"text":"Lord, nigua na linge ni kabu sasara mana utuni,","poem":1},{"lineBreak":true},{"text":"Mi nau tu lingea vanigho gatu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na nilabugu ke mua palugha.","poem":1},{"lineBreak":true},{"text":"Mi ngiha vaho ko mai tagua.","poem":1},{"lineBreak":true},{"text":"Inau ku kabu marabu tana valegu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ku mua talana na dika ge ke mai tagua,","poem":1},{"lineBreak":true},{"text":"mu ku nighi sika na gehegehedira tara ririu keha vania God,","poem":1},{"lineBreak":true},{"text":"ku mua ghai haidu olu tua itadira.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inau ku mua taonia na volapego,","poem":1},{"lineBreak":true},{"text":"mu ku mua haidu kolura na vure dika.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inau ku lavi kehaa a hei te bosadika,","poem":1},{"lineBreak":true},{"text":"polopoloa na ahana siki sakai,","poem":1},{"lineBreak":true},{"text":"mu ku tiva kehaa gaia te magharo me talunagho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inau tu holoutora gaira tara lutu utuni vania God,","poem":1},{"lineBreak":true},{"text":"mu taladira ge kara ghanara lokana na valegu.","poem":1},{"lineBreak":true},{"text":"Gaira te utuni haliu na voladira,","poem":1},{"lineBreak":true},{"text":"tu taladira ge kara ghairau vaniu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gaia te sorisori ke mua ghanaa lokana na valegu,","poem":1},{"lineBreak":true},{"text":"ma gaia te pego ke mua kabu i lilighigu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Inau ku durakera tughu bongi rana dika lokana na bonada,","poem":1},{"lineBreak":true},{"text":"mu ku tivara rana tangohahi tana komuna a Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}