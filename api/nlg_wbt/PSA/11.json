{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Inau tu talua nigua na ghanaghana ni pilupilu itatana Lord.","poem":1},{"lineBreak":true},{"text":"Na pukuna keri, e ghua ge o bosa vaniu,","poem":1},{"lineBreak":true},{"text":"“Ko tona tana lei ghotu na va polopolo iga!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rana tangohahi tara lohighi didira na baghe","poem":1},{"lineBreak":true},{"text":"mara talui didira na kuali tana nilohi.","poem":1},{"lineBreak":true},{"text":"Ma gaira tara vania va tana ungaungadira","poem":1},{"lineBreak":true},{"text":"ara hei tara gonia na uto.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na banatana na vetena mana arelavaghi te parihai.","poem":1},{"lineBreak":true},{"text":"Mana hava kara nea rana maemane?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma Lord te ghaha tana valena te Tabu;","poem":1},{"lineBreak":true},{"text":"ma Lord te tona haliu so na huhuli ikokou.","poem":1},{"lineBreak":true},{"text":"Ma gaia te vatogha dutuvighi so na lei totobo","poem":1},{"lineBreak":true},{"text":"me tabotaboa sopasopa sakai tana maramana.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma Lord te tabotabora rana maemane maia rana tangohahi.","poem":1},{"lineBreak":true},{"text":"Ma gaia te nira sika arahei tara dolovia na dika.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Agaia te kovala horua inaghodira","poem":1},{"lineBreak":true},{"text":"te ruruhu ivuvungadira rana tangohahi,","poem":1},{"lineBreak":true},{"text":"me vahaghitailira nia na lake","poem":1},{"lineBreak":true},{"text":"te ruruhu mana ruruhuni na lei ghuri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na pukuna Lord te maemane;","poem":1},{"lineBreak":true},{"text":"Keri ge agaia te dolovia na maemane.","poem":1},{"lineBreak":true},{"text":"Agaira arahei tara gonia na maemane,","poem":1},{"lineBreak":true},{"text":"kara righia na matana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}