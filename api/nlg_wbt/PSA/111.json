{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Holoutoa Yahweh!","poem":1},{"lineBreak":true},{"text":"Inau ku holoutoa Yahweh nia na tobagu udolu,","poem":1},{"lineBreak":true},{"text":"tana bona tu sakai soni kolu itadira na lei nina vure God.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E haeharegha sughua na lei nina gehegehe Lord,","poem":1},{"lineBreak":true},{"text":"ahei tara nighi togotogo,","poem":1},{"lineBreak":true},{"text":"te manana sughua kara kene ghanaghanani,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na lei totobo soko te nei,","poem":1},{"lineBreak":true},{"text":"te tughu ni tatea iga nina rongoragha mana malei haba,","poem":1},{"lineBreak":true},{"text":"ma nina maemane ke tona haliu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma ahei ke nia ponolio nina lutu te haeharegha?","poem":1},{"lineBreak":true},{"text":"Dida na Lord te lio dolo maia te veiarovi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Agaia te vahera na vanga, gaira tara varava itatana,","poem":1},{"lineBreak":true},{"text":"me ghanaghana olia haia nina baubahu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Agaia te tatea nina maana laga vanira nina vure,","poem":1},{"lineBreak":true},{"text":"me vahera na pari ni tunuva.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na hava te ne tua te uto, maia te maemane,","poem":1},{"lineBreak":true},{"text":"mana lei nina vetena te utuni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma gaira udolu tara utuni haliu,","poem":1},{"lineBreak":true},{"text":"te manana na pangoti kikinimaani nia na lutu maemane.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma gaia te pelu horuna nina vure,","poem":1},{"lineBreak":true},{"text":"te ngasi nia nina baubahu ke va me va.","poem":1},{"lineBreak":true},{"text":"E tabu na mamataghugha na ahana.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na nia kikinima Lord na vuivunina na manaha.","poem":1},{"lineBreak":true},{"text":"Oliolina na manaha te mai vanira ahei tara lavipangotia.","poem":1},{"lineBreak":true},{"text":"Holoutoa na ahana ke va me va.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}