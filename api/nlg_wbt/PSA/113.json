{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Holoutoa Lord!","poem":1},{"lineBreak":true},{"text":"Eo, Holoutoa Lord, ighau nina vure Lord,","poem":1},{"lineBreak":true},{"text":"holoutoa na ahana Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bosa utoa na ahana Lord ke va me va.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ivei mi vei, i ulu mi Boko,","poem":1},{"lineBreak":true},{"text":"holoutoa na ahana Lord.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma gaia Lord te haba vulera na lei kema,","poem":1},{"lineBreak":true},{"text":"ma nina rongoragha te haba vulea na parako.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ivei ke nea na kageana Lord nia dida na God,","poem":1},{"lineBreak":true},{"text":"ma hei te sopou haba dato?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sarana gaia na kokou mana pari, me sighorotu me vatoghai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Me lavi kehara rana bona tana pari liliki,","poem":1},{"lineBreak":true},{"text":"ma gaira tara mua lologho tana vatei soni lololo","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Talua na vinahogho ghobudira, ge ke habadira nina vure heghena.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gaia te talu valena na vaivine te mua logho dalena,","poem":1},{"lineBreak":true},{"text":"ge ke kabu togotogo","poem":1},{"lineBreak":true},{"text":"Holoutoa Lord!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}