{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":["Tana bona ra Israel tara sogha sania Egypt,",{"text":"nina kemana Jacob tara tona keha tana komu keha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na pari ni Judea te liliu ni bona tabu nina God,","poem":1},{"lineBreak":true},{"text":"mi Israel te ghaha ga nina kinakabu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"na tahi te righira ge vilivoka, ge ra mina sogha halavu!","poem":1},{"lineBreak":true},{"text":"Ighoe na beti Jordan, ge o tave pulohi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na lei ghotu tara soghasogha, vagha na beti te tipotipo,","poem":1},{"lineBreak":true},{"text":"mana lei ghotu pile te vaghara na lei dale sheep.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na hava te negho ighoe na Tahi Sisi","poem":1},{"lineBreak":true},{"text":"ge o tave keha tana halautumu?","poem":1},{"lineBreak":true},{"text":"ge o tave keha, ighoe na beti Jordan?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ghau na lei ghotu,","poem":1},{"lineBreak":true},{"text":"E ghua ge au soghasogha vagha na beti ni tipotipo?","poem":1},{"lineBreak":true},{"text":"Mana lei ghotu pile vaghara na lei dale sheep.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Maramana, ko anuanu, tana matana Lord,","poem":1},{"lineBreak":true},{"text":"mi tana matana God ni Israel.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Maia te liliua na vatu, ge liliu ni kolo ni beti,","poem":1},{"lineBreak":true},{"text":"Eo, na vure ni beti te va mai tana vatu mauri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}