{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Na linge ni tona dato"]},{"type":"verse","number":1,"content":[{"text":"Ta nigua na lei vahola inau tu hea olia Lord,","poem":1},{"lineBreak":true},{"text":"mu ngangaraha vania me bosa tughui nigua na kokoeliulivuti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lord, ko volau, tadira tara kikokiko maia tadira na vure gueloguelo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na hava God ke gonia vanigho ighoe na lapi sorisori?","poem":1},{"lineBreak":true},{"text":"Ke savungighi vanigho nimua na vahaghitaili?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ge va ke vuke potagho nia na kuali [vangalua/ghala] ni malaghai,","poem":1},{"lineBreak":true},{"text":"me kere taghalaghinigho nia na vatu bera.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inau tu vahaghitaili kolua Meshech te dika na gehegehena!","poem":1},{"lineBreak":true},{"text":"Me vahaghitailiu ge ko kabu kolu tadira na vure ni Kedar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mu lugu tua na kabu iani,","poem":1},{"lineBreak":true},{"text":"ighobudira na vure tara nia sika na mabo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma vaniu inau, inau nina na mabo,","poem":1},{"lineBreak":true},{"text":"tana bona tu kokoe, agaira tara gonidilaa ni kisu mate.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}