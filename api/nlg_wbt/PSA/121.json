{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["Na linge ni tona dato"]},{"type":"verse","number":1,"content":[{"text":"Inau tu reitada tana ghotu,","poem":1},{"lineBreak":true},{"text":"Iga va mai nigua na hahanga?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nigua na hahanga te va butu mai tatana Lord,","poem":1},{"lineBreak":true},{"text":"te gonia na parako mana pari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ke mua lubatigho ge ko kabalaghi mo ko kutu,","poem":1},{"lineBreak":true},{"text":"gaia sakai ke vatoghagho, mo ko mua maturu!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E utuni, gaia te vatogha ghua Israel,","poem":1},{"lineBreak":true},{"text":"mete mua maturu me ke mua lugu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma Lord heghena vamua te vatoghagho ighoe.","poem":1},{"lineBreak":true},{"text":"Ma Lord te tughuru lilighimu","poem":1},{"lineBreak":true},{"text":"te vagha nimua na ungaunga ni puipungisi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na aho ke mua ghoi paregho ghua tana dani,","poem":1},{"lineBreak":true},{"text":"vagha ghua na vula tana bongi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma Lord ke pilupungisigho tana lei totobo dika soko,","poem":1},{"lineBreak":true},{"text":"me ke pabea na volamu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gaia Lord ke vatogha na rughu hagheamu mai","poem":1},{"lineBreak":true},{"text":"mana rughu horuani itaeni maia ke va me va.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}