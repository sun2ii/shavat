{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["Na linge ni tona dato, nina David."]},{"type":"verse","number":1,"content":[{"text":"Inau tu togotogo tara bosa vaniu te vagha eni,","poem":1},{"lineBreak":true},{"text":"“Mai ighita ka tona tana valena Lord.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi taeni tai tughuru lokani nimua na lei mataula ni peo, ighoe Jerusalem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem na komu tara kisugho, me talukolu ngasi ngangata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na vure ni Israel,","poem":1},{"lineBreak":true},{"text":"nina vure Lord,","poem":1},{"lineBreak":true},{"text":"gaira tara holohabana na ahana Lord,","poem":1},{"lineBreak":true},{"text":"te vagha na vetena te bosa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Iga te ghaha na malei sopou ni dete,","poem":1},{"lineBreak":true},{"text":"nina malei sopou na vunaghi David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kau kokoeliulivuti na mabo ni Jerusalem,","poem":1},{"lineBreak":true},{"text":"ma gaira tara dolovia na komu eni kara sepalaghi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ighoe Jerusalem, na mabo ke ghahai loka nina peomu,","poem":1},{"lineBreak":true},{"text":"mana halilaghi te ghahai tana lei vale ni haba.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mana pukuna na lei hoghogu mana ghagua na komu kolu,","poem":1},{"lineBreak":true},{"text":"inau ku ghaghua na mabo itamiu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na pukuna na valena Lord dida na God,","poem":1},{"lineBreak":true},{"text":"inau ku kenea na hava ke uto vanigho, ighoe Jerusalem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}