ana mavadira tara lionagho.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}