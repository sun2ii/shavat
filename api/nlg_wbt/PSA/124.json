{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["Na linge ni tona dato, nina David."]},{"type":"verse","number":1,"content":[{"text":"Ke vagha Lord ke mua nighita pala ke,","poem":1},{"lineBreak":true},{"text":"ma rana Israel kara bosa,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ke vagha Lord ke mua nighita levu pala ke,","poem":1},{"lineBreak":true},{"text":"ghua nighi na vure kara tughuru dato,","poem":1},{"lineBreak":true},{"text":"ma kara hughuhughu kolu i tatada.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Geva kara sonomi vola ghita,","poem":1},{"lineBreak":true},{"text":"na pukuna didira na rutu papara itatada.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ighai tai lulumi tana beti,","poem":1},{"lineBreak":true},{"text":"mana tave hogha te tao pungisia na volamami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Eo, te vagha ghua so na karaha ni tahi","poem":1},{"lineBreak":true},{"text":"te tao pungisia na volamami.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ka holoutoa Lord, te mua lubati[ghai]/[ra],","poem":1},{"lineBreak":true},{"text":"ge kara golu vokaghai nia na livodira.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mi ghai tai vagha na manu te lovo keha tana vugho.","poem":1},{"lineBreak":true},{"text":"Te tarosi mai tatavahale.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dida na hahanga te va mai itatana Lord,","poem":1},{"lineBreak":true},{"text":"te gonia na parako mana pari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}