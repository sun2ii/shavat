{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["Na linge ni tona dato."]},{"type":"verse","number":1,"content":[{"text":"Agaira tara varava itatana Lord,","poem":1},{"lineBreak":true},{"text":"tara tughuru ngasi vagha na ghotu Zion,","poem":1},{"lineBreak":true},{"text":"gaira kara mua laga vulera,","poem":1},{"lineBreak":true},{"text":"ma kara vadangitai ke va me va.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Te vagha na ghotu ta talighutia me pilupungisi Jerusalem,","poem":1},{"lineBreak":true},{"text":"ke vagha ghua Lord te talighutira me ke pilupungisira nina vure,","poem":1},{"lineBreak":true},{"text":"itaeni mai ke va me va.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na lei tinoni dika kara mua tangomana na uhuliadira nina vure God,","poem":1},{"lineBreak":true},{"text":"kara bei uhuli hahira gea.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lord, ko vahera na uto gaira tara uto,","poem":1},{"lineBreak":true},{"text":"mana tobadira te sakai soni kolu itamua.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lord, ko soni kehara gaira tara ririu keha,","poem":1},{"lineBreak":true},{"text":"mara taonighi na halautu te mua maemane.","poem":1},{"lineBreak":true},{"text":"Mo ko lavi kehara gaira ahei tara lutu hahihahi.","poem":1},{"lineBreak":true},{"text":"Mo ko lubatira Israel ge ke kabu beto tana mabo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}