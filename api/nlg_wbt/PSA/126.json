{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["Na linge ni tona dato"]},{"type":"verse","number":1,"content":[{"text":"Tana bona Lord te lavi olira nina vure pipiti Jerusalem,","poem":1},{"lineBreak":true},{"text":"[ighai tai]/[E] vagha vamua na maturu bole?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"me vonughighai na togotogo,","poem":1},{"lineBreak":true},{"text":"mai nia linge na rivurivu.","poem":1},{"lineBreak":true},{"text":"mana lei kema keha tara bosa,","poem":1},{"lineBreak":true},{"text":"“E maromangagha sughua eni na hava Lord te gonia vanira.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E utuni, gaia Lord te gonia vanighita","poem":1},{"lineBreak":true},{"text":"na lei totobo mamaromangagha.","poem":1},{"lineBreak":true},{"text":"Togotogo ighita!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lord, ko vaheghai mai na lei totobo uto,","poem":1},{"lineBreak":true},{"text":"te vagha na beti ni daidari te malobua na pari mamaha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gaira nia suba na dikalio mara nia togotogo na ghegheli.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gaira tara tangi mara subai didira na vuavua,","poem":1},{"lineBreak":true},{"text":"tana oli ni ghegheli gaira tara linge togotogo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}