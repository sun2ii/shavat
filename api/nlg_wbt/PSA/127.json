{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["Na linge ni tona dato. Nina Solomon."]},{"type":"verse","number":1,"content":[{"text":"A Lord mughua ke kisua na vale,","poem":1},{"lineBreak":true},{"text":"me ke mua luvu lee didira na lutu tara kiukisua.","poem":1},{"lineBreak":true},{"text":"Ma Lord sughua ke righitaonia na komu,","poem":1},{"lineBreak":true},{"text":"nia nina vatogha ge ke uto.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Taho na pukuna na lutu laga,","poem":1},{"lineBreak":true},{"text":"te vuivuni tana puipungi me sara tana nulavi bongi,","poem":1},{"lineBreak":true},{"text":"ma nia vaivarighohi na vanga,","poem":1},{"lineBreak":true},{"text":"Ma God te vahera na aheahe ahei te dolovira.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na lei gari pile a nina hevei lee Lord,","poem":1},{"lineBreak":true},{"text":"gaira te tunuvaghau nia mai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na lei gari pile tara sivuragha na lei tinoni vaolu,","poem":1},{"lineBreak":true},{"text":"te vagha na kuali vangalua tana lima ni malaghai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"God te holoutoa na tinoni te vonughighi na limadira!","poem":1},{"lineBreak":true},{"text":"gaira kara mua maa tana bona kara hughuhughu kolura","poem":1},{"lineBreak":true},{"text":"tara huru va tana mataula ni peo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}