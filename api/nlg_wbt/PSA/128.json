{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["Na linge ni tona dato."]},{"type":"verse","number":1,"content":[{"text":"Holoutora gaira ahei tara nia kikinima Lord,","poem":1},{"lineBreak":true},{"text":"mara taonighi na lei halautuna!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ighoe ko nia togotogo sule vaa,","poem":1},{"lineBreak":true},{"text":"mo ko lologho au va tana volamu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na taumu ke vagha na kaio te vuvungugha,","poem":1},{"lineBreak":true},{"text":"tara vatoro tana bebetemu.","poem":1},{"lineBreak":true},{"text":"Mo ko righira gaira na lei gari,","poem":1},{"lineBreak":true},{"text":"tara sopou talighutia na bela ni vanga,","poem":1},{"lineBreak":true},{"text":"tara kotukotu mara marabu vagha taotaro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vagha ghua keri nina hevei Lord","poem":1},{"lineBreak":true},{"text":"vanira gaira tara nia kikinima.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma nina vauto Lord ke tona haliu mai vuvungamu i Zion.","poem":1},{"lineBreak":true},{"text":"Mi ghoe ko righia Jerusalem ke halilaghi tana bongimu to vola.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mo ko righira mo ko nira togotogo na lei kukuamu,","poem":1},{"lineBreak":true},{"text":"ma gaia Israel ke todore tana mabo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}