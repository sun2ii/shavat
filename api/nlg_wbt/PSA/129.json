{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["Na linge ni tona dato"]},{"type":"verse","number":1,"content":[{"text":"Tana garimaneagu, mai ghagua na levunimate tara gunaliu,","poem":1},{"lineBreak":true},{"text":"mi taeni Israel te ghoi bosa,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tana gharimaneagu mai na ghagua na levunimate tara gunaliu,","poem":1},{"lineBreak":true},{"text":"Hauva mara mua ni tangomana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na murigu te bubuto,","poem":1},{"lineBreak":true},{"text":"te vagha na vatogha leghai","poem":1},{"lineBreak":true},{"text":"te ivui na vutuvutu daro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma Lord te uto, te kosai na lei tali halo tara pitiu nia.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gaira tara nia sika Jerusalem,","poem":1},{"lineBreak":true},{"text":"kara maa ma kara ririu pulohi,","poem":1},{"lineBreak":true},{"text":"na pukuna tara laga vulera.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ko nera gaira ge kara vagha na buburu tana vouvotu ni vale,","poem":1},{"lineBreak":true},{"text":"te sasagha vaho te tavuti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Te nia ponolio na tinoni te siosio,","poem":1},{"lineBreak":true},{"text":"me nia sika na na tinoni te vahikolu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma gaira tara sakutua padi tara hove na headira na vauto.","poem":1},{"lineBreak":true},{"text":"ma nina vauto Lord ke kabu i vuvungamiu.","poem":1},{"lineBreak":true},{"text":"Vauto ghau tana ahana Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}