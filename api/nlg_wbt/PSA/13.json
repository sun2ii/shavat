{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Aghe Lord, ivei vaho ke vagha na hauna ko niu ponolio?","poem":1},{"lineBreak":true},{"text":"Ke va me va? Mi vei vaho ke vagha na hauna","poem":1},{"lineBreak":true},{"text":"ge ko reirei va tana balu halautu?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi vei vaho ke vagha na hauna","poem":1},{"lineBreak":true},{"text":"ku ghutu vevehea na vahaghitaili tana tarungagu,","poem":1},{"lineBreak":true},{"text":"mi tana dikalio tana tobagu tughu bongi?","poem":1},{"lineBreak":true},{"text":"Mi vei vaho ke vagha na hauna","poem":1},{"lineBreak":true},{"text":"ge na ghagua na levunimate kara talu datoi na limadira?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ko ririu mai mo ko bosa tughu,","poem":1},{"lineBreak":true},{"text":"Aghe Lord, nigua na God!","poem":1},{"lineBreak":true},{"text":"Talugonia na marara mai tana matagu,","poem":1},{"lineBreak":true},{"text":"na pukuna ge ku bei mate gea.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bei lubatira na ghagua na levunimate","poem":1},{"lineBreak":true},{"text":"ge kara batobatou, ma kara ghaghua,","poem":1},{"lineBreak":true},{"text":"“Ighai tai laga vulea gaia!”","poem":1},{"lineBreak":true},{"text":"Mo ko bei lubatira ge kara togotogo tagua na kutu horu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mi nau tu varava ngasi so ta nimua na dolo ke mua tughu.","poem":1},{"lineBreak":true},{"text":"Mu ku nia togotogo na pukuna to lavi kehau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inau ku linge vania Lord,","poem":1},{"lineBreak":true},{"text":"na pukuna gaia te uto vaniu inau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}