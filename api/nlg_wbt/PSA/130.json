{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Na linge ni tona dato"]},{"type":"verse","number":1,"content":[{"text":"Lokana nigua na vahola, Ghe Lord,","poem":1},{"lineBreak":true},{"text":"Inau tu kenea nimua na hahanga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mo ko ronovighi mai nigua na ngangaraha,","poem":1},{"lineBreak":true},{"text":"mo ko talu kulimu mai tua nigua na kokoeliulivuti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ke vagha, ko pangotighi na gegereni na lei palumami ke,","poem":1},{"lineBreak":true},{"text":"Ghe Lord, [ma] ahei ghua ke vola?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ighoe vamua to nia hevei nimua na talukeha palu,","poem":1},{"lineBreak":true},{"text":"ge ighai kai naunaua na nigho kikinima.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gaia Lord ke pada maemaneu inau,","poem":1},{"lineBreak":true},{"text":"Eo, gaia ke pada maemaneu,","poem":1},{"lineBreak":true},{"text":"Inau tu talua nigua na ghanaghana mava tana bosana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inau tu pitu ngangata Lord,","poem":1},{"lineBreak":true},{"text":"vulera tana vatogha na marana na dani.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel, ko pitudila Lord,","poem":1},{"lineBreak":true},{"text":"itatana gaia na dolo te mua mautu,","poem":1},{"lineBreak":true},{"text":"mana vola tatavahale haliu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gaia heghena ke va tatavahalea Israel,","poem":1},{"lineBreak":true},{"text":"tana lei paluna soko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}