xt":"Itaeni maia ke va me va.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}