.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}