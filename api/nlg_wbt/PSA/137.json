{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Ighai tai sopou horu lilighina na beti sule Babylon,","poem":1},{"lineBreak":true},{"text":"mai tangitangi,","poem":1},{"lineBreak":true},{"text":"tai ghanaghana oligho Jerusalem.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mai talukehai nimami na ghalevu mai, ke","poem":1},{"lineBreak":true},{"text":"tari datoi tana otoni na ghai ni ungaunga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gaira tara sagu ghita,","poem":1},{"lineBreak":true},{"text":"tara kolughita nia na linge,","poem":1},{"lineBreak":true},{"text":"ma gaira tara dika ta ghita,","poem":1},{"lineBreak":true},{"text":"tara nongia na linge rivurivu itatada:","poem":1},{"lineBreak":true},{"text":"Kau linge vanighai, sakai itadira na linge ni Jerusalem.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ivei ka nea na lingeana,","poem":1},{"lineBreak":true},{"text":"na lingeana Lord tana komu keha eni?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ke vagha ku nigho ponolio ke Jerusalem,","poem":1},{"lineBreak":true},{"text":"lubatia ghua na lima madologu","poem":1},{"lineBreak":true},{"text":"ge ke nia ponolio nigua na ghalevu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na lapigu te rago dato tana ngongogu,","poem":1},{"lineBreak":true},{"text":"ke vagha ku nigho ponolio,","poem":1},{"lineBreak":true},{"text":"mu ku mua talua Jerusalem ge ke nigua na nagho ni togotogo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lord, ko ghanaghana olia,","poem":1},{"lineBreak":true},{"text":"na hava na vure ni Edom tara gonia,","poem":1},{"lineBreak":true},{"text":"tana bona na vure ni kisumate tara sagua Jerusalem,","poem":1},{"lineBreak":true},{"text":"Kau haurakea tua vaa!","poem":1},{"lineBreak":true},{"text":"Mana ngingili, itaeni ke tao tana pari.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Babylon geva kara haurakegho,","poem":1},{"lineBreak":true},{"text":"holoutoa gaia te pelu horugho nia na hava to gonia vanighai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Holoutoa gaia te holara na lei nimiu meomeo,","poem":1},{"lineBreak":true},{"text":"me nera rabo horu tana vatu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}