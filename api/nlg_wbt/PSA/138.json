{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["Na linge nina David."]},{"type":"verse","number":1,"content":[{"text":"Inau tu holoutogho, ighoe Lord,","poem":1},{"lineBreak":true},{"text":"nia na tobagu udolu,","poem":1},{"lineBreak":true},{"text":"mu ku lingei nimua na holouto","poem":1},{"lineBreak":true},{"text":"tana matadira na lei god keha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inau ku tongaghi vanigho tana valemu te tabu,","poem":1},{"lineBreak":true},{"text":"tana bona ku holohabagho,","poem":1},{"lineBreak":true},{"text":"mu ku holoutoa na ahamu,","poem":1},{"lineBreak":true},{"text":"na pukuna to nera tughuru kakai,","poem":1},{"lineBreak":true},{"text":"nimua na dolo mana baubahu te mua tughu","poem":1},{"lineBreak":true},{"text":"tana talu suleana na ahamu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tana bona tu kokoeliulivuti,","poem":1},{"lineBreak":true},{"text":"ighoe to bosa tughu,","poem":1},{"lineBreak":true},{"text":"mo vaheu mai na patupatu mana laga te managu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na lei vunaghi haba tana maramana,","poem":1},{"lineBreak":true},{"text":"kara holoutogho ighoe Lord,","poem":1},{"lineBreak":true},{"text":"gaira udolu kara rongovia na bosamu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Eo, gaira kara lingei na lei halautumu, Lord,","poem":1},{"lineBreak":true},{"text":"Na pukuna na rongoraghamu te sule ngangata.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E utuni gaia Lord te haba vule,","poem":1},{"lineBreak":true},{"text":"gaia te pangotira tana talu pilera,","poem":1},{"lineBreak":true},{"text":"me tabalili keha sanira tana lio nagho.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E utuni, na lei nigua vahola tara utu talighutui,","poem":1},{"lineBreak":true},{"text":"mi ghoe vamua to pilupungisiu","poem":1},{"lineBreak":true},{"text":"ta didira na rutu papara","poem":1},{"lineBreak":true},{"text":"na ghagua na kana,","poem":1},{"lineBreak":true},{"text":"mo kaputighi na limamu,","poem":1},{"lineBreak":true},{"text":"pungisira tara rutu,","poem":1},{"lineBreak":true},{"text":"ma nimua na maana te righitaoniu inau.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gaia Lord vamua ke padalaghi kaekagea vaniu na volagu,","poem":1},{"lineBreak":true},{"text":"na pukuna nimua na dolo kikinima te kabu kasila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}