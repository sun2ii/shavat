{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Na maskil nina David, tana bona te kabu tana vatuluma. Na kokoeliulivuti."]},{"type":"verse","number":1,"content":[{"text":"Inau tu tangitangi vania Lord,","poem":1},{"lineBreak":true},{"text":"mu nongia Lord nina veiarovi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inau tu bosa tatei vania nigua na lei vahola,","poem":1},{"lineBreak":true},{"text":"mu kokoe hughuhughu kolua tana matana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na pukuna te au vuleu tua,","poem":1},{"lineBreak":true},{"text":"mi ghoe vamua to ghilala na halautugu ku va iga,","poem":1},{"lineBreak":true},{"text":"ivei tua ku vaa na ghagua na levunimate tana liona na tari pitiagu.,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inau tu kene siki sakai ge ke mai hangau,","poem":1},{"lineBreak":true},{"text":"me taho tua ahei ke vaheu siki pile ghanaghana,","poem":1},{"lineBreak":true},{"text":"taho tua ahei ke niu ghaghua,","poem":1},{"lineBreak":true},{"text":"tana ghanaghana te kaleu eni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mi nau tu kokoeliulivuti vania Lord,","poem":1},{"lineBreak":true},{"text":"mu bosa vania, “ighoe na puipungisi,","poem":1},{"lineBreak":true},{"text":"ighoe vamua tu puku ni liomu tana volagu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ko rongovighi mai nigua na kokoeliulivuti,","poem":1},{"lineBreak":true},{"text":"na pukuna tu kabu sasara ngangata.","poem":1},{"lineBreak":true},{"text":"Ko volau mai itadira tara vahaghitailiu,","poem":1},{"lineBreak":true},{"text":"na pukuna tara laga vule ngangatau tua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ko hola horu lokana na vale pipiti ge ku holoutogho,","poem":1},{"lineBreak":true},{"text":"na lei nina vure God, tara talighutiu,","poem":1},{"lineBreak":true},{"text":"na pukuna to pabe utuniu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}