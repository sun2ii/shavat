{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Holohaba Lord!","poem":1},{"lineBreak":true},{"text":"Kau linge na linge vaolu vania Lord.","poem":1},{"lineBreak":true},{"text":"Linge vaukolu holohaba,","poem":1},{"lineBreak":true},{"text":"ghobudira tara nia kikinima.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Israel kau nia togotogo agaia, te gonighau.","poem":1},{"lineBreak":true},{"text":"Mi ghau Jerusalem, kau nia rivurivu nimiu na vunaghi haba.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kau nia ghavaighavai na holohabana na ahana,","poem":1},{"lineBreak":true},{"text":"nia na uvete mana ghalevu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gaia Lord te nira togotogo nina vure.","poem":1},{"lineBreak":true},{"text":"Me pitiuluadira tara talumuri nia na pitiulu ni vola.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lubatira tara kikinima kara rivurivu na talu habana,","poem":1},{"lineBreak":true},{"text":"gaira kara linge togotogo tana malei ghimedira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na lei nina holohaba God ke kabu tana mangadira,","poem":1},{"lineBreak":true},{"text":"mana ivi te vanga tana limadira.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ke matera nia ma kara nia bubuto na lei kema,","poem":1},{"lineBreak":true},{"text":"na deteadira na lei tinoni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kara pitira na lei vunaghi nia na tali,","poem":1},{"lineBreak":true},{"text":"ma didira tinoni uhuhuli nia na tali halo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ge na dete te bosa tua pungisira.","poem":1},{"lineBreak":true},{"text":"Ke dete matera eni [vania] didira na lada nina lei tabu.","poem":1},{"lineBreak":true},{"text":"Holohaba Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}