{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":15,"content":[{"type":"heading","content":["Na Vetena Vanira Tara Vola Ge kara Bei hurura Na Hava Te Liona God."]},{"type":"verse","number":1,"content":[{"text":"Lord, Ahei ke kokoeliulivuti kikinima ta valemu?","poem":1},{"lineBreak":true},{"text":"Ahei ke haghe gatu itamua ta nimua na ghotu te tabu?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gaira tara uhulia na nilabu te uto","poem":1},{"lineBreak":true},{"text":"mara gonighi na lei gehegehe uto haia,","poem":1},{"lineBreak":true},{"text":"mara nia kokoe na utuni tana toba maghora.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gaira tara mua liona","poem":1},{"lineBreak":true},{"text":"ge kara dikalara na lei tinoni nia na sori,","poem":1},{"lineBreak":true},{"text":"pa kara vahaghitailira na lei kuladira.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gaira tara hughulevu","poem":1},{"lineBreak":true},{"text":"mara nira sika rana tangohahi,","poem":1},{"lineBreak":true},{"text":"mara nira kikinima","poem":1},{"lineBreak":true},{"text":"tara taluutuni utunia mara taonia Lord,","poem":1},{"lineBreak":true},{"text":"mara righitaonighi didira na baubahu,","poem":1},{"lineBreak":true},{"text":"sakai vamua te vahaghitaili.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gaira tara mua nongia na rongo","poem":1},{"lineBreak":true},{"text":"au ivuvungana didira na rongo","poem":1},{"lineBreak":true},{"text":"tara nia hevei, mara mua liona","poem":1},{"lineBreak":true},{"text":"me ke taonia na taba itatana na tinoni te kabu maemane,","poem":1},{"lineBreak":true},{"text":"gaira tara gehetighi raini kara tughuru ngasi haia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}