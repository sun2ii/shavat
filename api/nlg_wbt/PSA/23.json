{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":23,"content":[{"type":"heading","content":["God Dida na Vatogha"]},{"type":"verse","number":1,"content":[{"text":"A Lord nigua na vatogha;","poem":1},{"lineBreak":true},{"text":"Inau ku mua kenea na hava te liogu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gaia te lubatiu ge ku aheahe tana buburu maumauri;","poem":1},{"lineBreak":true},{"text":"me uhuliu va tana daidari ni beti maghora.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gaia te vaheu na laga vaolu.","poem":1},{"lineBreak":true},{"text":"Gaia te huliu tana halautu maemane,","poem":1},{"lineBreak":true},{"text":"ge ku nia kikinima na ahana.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sakai vamua ku liu tana pui mana ungaunga ni mate ku mua mataghu;","poem":1},{"lineBreak":true},{"text":"na pukuna ighoe tana lilighigu.","poem":1},{"lineBreak":true},{"text":"nimua na toghona mana tila kara pilupiluu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ko gonidilaa vaniu na vanga kolu tana matadira tara kanahaghiniu.","poem":1},{"lineBreak":true},{"text":"Ighoe to lavipangotiu mo dolovia na ulugu nia na oil/oele.","poem":1},{"lineBreak":true},{"text":"Ma nigua na seu ke vonughia na vauto.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nimua na dolo mana vauto ke saritaoniu tana lei bongi ni volagu,","poem":1},{"lineBreak":true},{"text":"mi nau kabu kasila tana valena Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}