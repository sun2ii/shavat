{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["Nina David"]},{"type":"verse","number":1,"content":[{"text":"Lord, ighoe nigua na vatu ni vatei tuturi,","poem":1},{"lineBreak":true},{"text":"Inau ko hologho, mo ko bei hove gea na rongoviagu","poem":1},{"lineBreak":true},{"text":"Na pukuna ko mua nea mua ke,","poem":1},{"lineBreak":true},{"text":"mu ku vaghara tua ara hei tara kutu haghe tana gilu taho borona.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ko rongovia nigua na kokoeliulivuti","poem":1},{"lineBreak":true},{"text":"tu nongigho ge ko hangau.","poem":1},{"lineBreak":true},{"text":"Mi nau tu hau datoi na limagu vata nimua na malei tuturi","poem":1},{"lineBreak":true},{"text":"tana valemu te tabu","poem":1}]},{"type":"verse","number":3,"content":[]},{"type":"verse","number":4,"content":[]},{"type":"verse","number":5,"content":[]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Holouto Lord na pukuna te rongovia nigua nigua na tangi ge aroviu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma Lord nigua na laga","poem":1},{"lineBreak":true},{"text":"ma nigua na tako tana bona ni sosodo","poem":1},{"lineBreak":true},{"text":"mu ghanaghana mavaa nia na tobagu,","poem":1},{"lineBreak":true},{"text":"na pukuna ke hangau mana liogu te vonughia na togotogo","poem":1},{"lineBreak":true},{"text":"mu ku holohaba nia na lei linge ni holouto.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma Lord te righi taonira nina vure,","poem":1},{"lineBreak":true},{"text":"me vahera na laga vule nina na vunaghi haba.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ko vavolara nimua na vure ghe Lord,","poem":1},{"lineBreak":true},{"text":"ighau na lei tarunga vetena kau vahe na holouto","poem":1},{"lineBreak":true},{"text":"ta nina rongoragha mana laga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}