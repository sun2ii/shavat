{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Aghe Lord, ara subo na ghagua na levunimate;","poem":1},{"lineBreak":true},{"text":"mara subo ghua tara tughuru pungisiu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ara subo lee ghua tara bosa mara ghaghua:","poem":1},{"lineBreak":true},{"text":"A God ke mua ghoi tangomana na hangaana!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mi ghoe ghe Lord, a nigua na tako te pilupilu,","poem":1},{"lineBreak":true},{"text":"ma nigua na lada itatana gaia te ghaedatoa na ulugu tana oka.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inau tu tangi vania Lord,","poem":1},{"lineBreak":true},{"text":"ma gaia te bosa tughu vaniu mai ta nina ghotu te tabu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inau tu koli horu, mu tu maturu.","poem":1},{"lineBreak":true},{"text":"Mu rarai mai tana maboagu;","poem":1},{"lineBreak":true},{"text":"na pukuna Lord te righitaoniu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inau tu mua mataghunira","poem":1},{"lineBreak":true},{"text":"ara hangavulu na togha ni levunimate,","poem":1},{"lineBreak":true},{"text":"tara sama talighutiu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tughuru ghe Lord!","poem":1},{"lineBreak":true},{"text":"Mo ko vavolau, a nigua na God!","poem":1},{"lineBreak":true},{"text":"Tapoi na ngara dira gaira udolu na ghagua na levunimate;","poem":1},{"lineBreak":true},{"text":"mo ko karatai na livo dira tara tangotangodika.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Na laga vule te va mai itamua ghe Lord:","poem":1},{"lineBreak":true},{"text":"Lubatia nimua na vauto ke kabu itadira a nimua na vure.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}