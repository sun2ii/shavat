{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":30,"content":[{"type":"heading","content":["Linge ni Tabuana na Valetabu"]},{"type":"verse","number":1,"content":[{"text":"Mi nau tu nigho kikinima Lord,","poem":1},{"lineBreak":true},{"text":"na pukuna to ghate datou,","poem":1},{"lineBreak":true},{"text":"mo mua lubatira na ghagua na levunimate ge kara laga vuleu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma Lord nigua na God,","poem":1},{"lineBreak":true},{"text":"Inau tu tangi vanigho ge ko hangau,","poem":1},{"lineBreak":true},{"text":"mo vuha kisu volau so.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma Lord te lavi olia na tarungagu mai i betidalo","poem":1},{"lineBreak":true},{"text":"me righi tao niu so ge u mua tumu haghe ilokana.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kau linge vania Lord, ighau nina tabu,","poem":1},{"lineBreak":true},{"text":"Kau holoutoa na ahana te tabu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Te mua daro ni bona nina rutu,","poem":1},{"lineBreak":true},{"text":"ma nina dolo te tona haliu haia so,","poem":1},{"lineBreak":true},{"text":"mana dikalio ke soko buto","poem":1},{"lineBreak":true},{"text":"mana togotogo ke sivuragha tana dani vaolu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inau tu pukulaghi ni utoa mai tua keri ge u bosa","poem":1},{"lineBreak":true},{"text":"mu ghaghua, ke mua ghoi laga vuleu tua siki sakai","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ighoe Lord to uto vaniu","poem":1},{"lineBreak":true},{"text":"mo pilupilu nia na ghotu,","poem":1},{"lineBreak":true},{"text":"mo polo vaniu ge u mataghu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma keri ge u hoholo ghe Lord,","poem":1},{"lineBreak":true},{"text":"ge u kokoeliulivuti vanigho gatu, mu ghaghua,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na hava na uto ke gonia vanigho","poem":1},{"lineBreak":true},{"text":"na ghabugu tana bona ke horu i betidalo?","poem":1},{"lineBreak":true},{"text":"Ke tangomana so na pughu ni pari","poem":1},{"lineBreak":true},{"text":"ge ke holoutogho me ke bosaa to utuni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ko rongoviu ghe Lord, mo ko aroviu,","poem":1},{"lineBreak":true},{"text":"Ighoe na hahanga vaniu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"To liliua nigua na dikalio me togotogo","poem":1},{"lineBreak":true},{"text":"mo tughua nigua na lio ni roku me togotogo","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Me vagha keri ge na lei tinoni kara holohaba na ahamu","poem":1},{"lineBreak":true},{"text":"ma kara bei beto gea.","poem":1},{"lineBreak":true},{"text":"Ighoe nigua na Lord ma God,","poem":1},{"lineBreak":true},{"text":"Inau ku holoutogho haia ke vei ma va.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}