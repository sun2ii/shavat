{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":[{"text":"Inau ku holohabaa haia Lord:","poem":1},{"lineBreak":true},{"text":"mu ku bosa haia na holoutoana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi nau ku kokoe tate vania Lord:","poem":1},{"lineBreak":true},{"text":"ma rahei tara mua uto kara loghoa na toba te uto.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mai ma ka talu tatea nina rongoragha Lord.","poem":1},{"lineBreak":true},{"text":"Ma ka taludato koukolua na ahana.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inau tu kokoeliulivuti me rongoviu Lord","poem":1},{"lineBreak":true},{"text":"me lavi horuu ta nigua na mataghu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ra hei tara kenea ge ke hangara kara togotogo","poem":1},{"lineBreak":true},{"text":"ma kara mua loghoa na maa tana matadira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi nau tu ngangaraha vania Lord","poem":1},{"lineBreak":true},{"text":"ta nigua na vahaghitaili me rongoviu,","poem":1},{"lineBreak":true},{"text":"me lubati tatavahaleu ta nigua na mataghu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma nina tarunga vetena Lord","poem":1},{"lineBreak":true},{"text":"te righitaonira arahei tara nia kikinima, ge righitaonira.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Taboa, mo ko righia a Lord te uto sughua","poem":1},{"lineBreak":true},{"text":"ra rivurivu ara hei tara varava tatana.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lubatira nina tinoni Lord","poem":1},{"lineBreak":true},{"text":"kara tatea didira na ghanaghana mava","poem":1},{"lineBreak":true},{"text":"ma rahei tara holohaba,","poem":1},{"lineBreak":true},{"text":"kara loghoa na hava ke liodira","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sughua na dalei liona tara laga tara vitolo","poem":1},{"lineBreak":true},{"text":"ma rahei tara varava ngasi tatana","poem":1},{"lineBreak":true},{"text":"kara mua kenea na hava ke uto vanira.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kau mai ghau dalegu ma kau rongoviu","poem":1},{"lineBreak":true},{"text":"mu ku taraighau ma kau nia kikinima Lord.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Siki sakai tamiu te liona","poem":1},{"lineBreak":true},{"text":"ge ke uto me ke daro na volana?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ko righi taonia na lapimu","poem":1},{"lineBreak":true},{"text":"mo ko righi taonia ghidumu ge ke bei bosaa na kiko.","poem":1}]},{"type":"verse","number":14,"content":[]},{"type":"verse","number":15,"content":[]},{"type":"verse","number":16,"content":[]},{"type":"verse","number":17,"content":[]},{"type":"verse","number":18,"content":[]},{"type":"verse","number":19,"content":[]},{"type":"verse","number":20,"content":[]},{"type":"verse","number":21,"content":[]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Na maghutu te vavola nina tinoni ni lutu:","poem":1},{"lineBreak":true},{"text":"Mara hei tara taluutunia kara mua sivi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}