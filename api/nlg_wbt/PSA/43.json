{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Ghe God, Ko tatea vaniu na kabu marabu,","poem":1},{"lineBreak":true},{"text":"mo ko pilupungisiau itadira rana lei tinoni tangohahi,","poem":1},{"lineBreak":true},{"text":"Ko vavolau itadira na lei tinoni sorisori mana tangotangodika.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na pukuna Ighoe nigua na God,","poem":1},{"lineBreak":true},{"text":"Nigua na vatei vola itamua.","poem":1},{"lineBreak":true},{"text":"Me ghua ghe o tona saniu?","poem":1},{"lineBreak":true},{"text":"Me ghua ge u sakutua kolili tana pungi mi tana ungaunga ni mate,","poem":1},{"lineBreak":true},{"text":"itadira tara niu ghighirou tana lei ghaghua na levunimate?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mo nira vetena rughuhoru mai nimua na marara mana utuni.","poem":1},{"lineBreak":true},{"text":"ma kara righitaoniu","poem":1},{"lineBreak":true},{"text":"lubatira ge kara liuliu va ta nimua na ghotu tabu,","poem":1},{"lineBreak":true},{"text":"va tana bonamu to ghahagho iga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I kakeri ge ku tona ta nina malei sukaghi God,","poem":1},{"lineBreak":true},{"text":"Mi ga ta God te butu ni mai na rivurivu mana togotogo.","poem":1},{"lineBreak":true},{"text":"Inau ku holoutogho nia na tigitigi ge God, nigua na God!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E ghua ge o dikalio ngangata?","poem":1},{"lineBreak":true},{"text":"Inau tu talua nigua na ghanaghana mava itatana God!","poem":1},{"lineBreak":true},{"text":"Inau ku ghoi holoutoa so agaia","poem":1},{"lineBreak":true},{"text":"na pukuna gaia na vavolagu mana nigua na God!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}