{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"Mai ghau na lei vure soko,","poem":1},{"lineBreak":true},{"text":"Kau tapoi na limamiu nia na rivu!","poem":1},{"lineBreak":true},{"text":"Kau ghuu dato vania God nia na togotogo mana rivurivu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A Lord puku na maana te haba va,","poem":1},{"lineBreak":true},{"text":"Agaia na vunaghi haba tana maramana udolu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Agaia te taluhorura na lei kema i sarada;","poem":1},{"lineBreak":true},{"text":"me talura na ghada levunimate i sarana marevoda.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A gaia te vilia vanighita na komu ni baubahu te vagha na bonada;","poem":1},{"lineBreak":true},{"text":"Tana bonadira na lei kukuana Jacob te dolovira.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A God te nia dato na ngingili rivurivu","poem":1},{"lineBreak":true},{"text":"Ma Lord te nia dato na talama ni tavuli.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kau linge holouto vania God, linge holouto,","poem":1},{"lineBreak":true},{"text":"linge holouto vania dida na vunaghi,","poem":1},{"lineBreak":true},{"text":"kau linge holouto!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A God, gaia na vunaghi haba tana maramana talighu","poem":1},{"lineBreak":true},{"text":"kau holohabaa nia na Linge holouto.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A God te vunaghi pungisia na maramana udolu;","poem":1},{"lineBreak":true},{"text":"agaia te Kabu ta nina mali sopou te haba.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rana lei haba ni maramana tara kabu sakai sonikolu.","poem":1},{"lineBreak":true},{"text":"Agaira tara hangaghita tana holohabana na God ni Abraham.","poem":1},{"lineBreak":true},{"text":"Na lei vunaghi ni maramana a nina God.","poem":1},{"lineBreak":true},{"text":"Agaia ka nia kikinima ivei mi vei.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}