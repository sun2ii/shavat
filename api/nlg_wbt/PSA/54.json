{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Ko nia mai kolu na mana te laga, Ghe God,","poem":1},{"lineBreak":true},{"text":"mo ko vavolau na levunimate!","poem":1},{"lineBreak":true},{"text":"Ko pilupungisiu nia nimua na maana te laga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ghe God, ko rongoviu ta nigua na kokoeliulivuti.","poem":1},{"lineBreak":true},{"text":"Ko kabu vaovarongo mai ta nigua na nongi papara.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nia rana keha tu mua ghilalara","poem":1},{"lineBreak":true},{"text":"tara liona na labuagu nia na lei totobo ni matemate;","poem":1},{"lineBreak":true},{"text":"na lei mane laga tara liona na mateagu.","poem":1},{"lineBreak":true},{"text":"A gaira tara totobo lee vamua itatana God.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hauva ka, ma God a nigua na hahanga","poem":1},{"lineBreak":true},{"text":"A gaia Lord te pangotiu ge u vola!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ko nighi didira na lei padalaghi ni dika","poem":1},{"lineBreak":true},{"text":"na ghagua na lei levunimate ge ke ririu pulohi vanira.","poem":1},{"lineBreak":true},{"text":"ko gonia te vagha to nia baubahu tua mo ko soko laghinira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inau ku ni sukaghi nigua na hevei oli heghegu gatu vanigho.","poem":1},{"lineBreak":true},{"text":"Inau ku holoutogho na ahamu,","poem":1},{"lineBreak":true},{"text":"Ghe Lord nia te uto te vaghaa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nia ighoe ko vavolau ta nigua na lei vahola tara kauliu.","poem":1},{"lineBreak":true},{"text":"Mo hangau ge ku laga vulera na lei ghagua na kana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}