{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["Vania na tinoni gehe linge: na linge ke tona kolua na lei totobo ni gougonu tara logo ghalo."]},{"type":"verse","number":1,"content":[{"text":"God ke arovighita me ke va tabu ghita,","poem":1},{"lineBreak":true},{"text":"Me ke tatea na marara ni matana nia na kulakulagha i vuvungada.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma ge na lei nilabumu kara ghilalai talighutia na maramana","poem":1},{"lineBreak":true},{"text":"mana nimua na maana ni vavola tana lei baebasena na maramana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na lei kema kara holoutogho ghe God.","poem":1},{"lineBreak":true},{"text":"Eo, na lei kema soko kara holoutogho.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ivei vaho tua te vaghaa na rivurivu kara loghoa na lei kema soko,","poem":1},{"lineBreak":true},{"text":"kara nia lingelinge na togotogo,","poem":1},{"lineBreak":true},{"text":"na pukuna to hulira nia na lutu maemane","poem":1},{"lineBreak":true},{"text":"ma taghaoa na lei gehegehe ni maramana talighu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na lei kema kara holoutogho ghe God.","poem":1},{"lineBreak":true},{"text":"Eo, na lei kema kara holoutogho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ge na maramana ke nia hevei nina na halilaghi,","poem":1},{"lineBreak":true},{"text":"Ma God, dida na God, ke vaheghita nina na vauto ni sosodo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Eo, God ke vautoghita,","poem":1},{"lineBreak":true},{"text":"mana lei vure soko talighutia na maramana","poem":1},{"lineBreak":true},{"text":"kara nia kikinima gaia God.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}