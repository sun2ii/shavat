{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Vania na tinoni gehe linge: na linge ni David, Te nongia God vagha eni:"]},{"type":"verse","number":1,"content":[{"text":"U nongi ngangatagho, Ghe God, Ko vavolau.","poem":1},{"lineBreak":true},{"text":"Mina mina mai, Ghe Maghutu, mo ko hangau.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ko niu Inau ge ku laga vulera agaira tara mina na durakeagu","poem":1},{"lineBreak":true},{"text":"ge kara nia vatei mamaagha.","poem":1},{"lineBreak":true},{"text":"ko nira a gaira tara nia oboobo nigua na lei vahola","poem":1},{"lineBreak":true},{"text":"kara nia ririu pulohi na kaukauli.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ko lubatira ge kara nia kanoragha didira na maa,","poem":1},{"lineBreak":true},{"text":"Nia tara bosaa, “Aha! Ighita ta labe kalea tua.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ge ara hei kara kene taonigho ighoe","poem":1},{"lineBreak":true},{"text":"kara nia vonu na togotogo mana rivurivu.","poem":1},{"lineBreak":true},{"text":"Ma ge agaira tara dolovia nimua na maana ni vola","poem":1},{"lineBreak":true},{"text":"kara ghughu talu, ma kara ghaghua, “God te haba vule!”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hauva ka, mi nau tu bona mua liona na hahanga,","poem":1},{"lineBreak":true},{"text":"U nongi ngangatagho Ghe God, ko mina mo ko diki heu na pile hahanga.","poem":1},{"lineBreak":true},{"text":"Ighoe a nigua na hahanga mana togho luvu,","poem":1},{"lineBreak":true},{"text":"Ighoe Lord, ko bei motomoto.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}