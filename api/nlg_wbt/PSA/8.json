{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Ghe Lord, nimami na Lord,","poem":1},{"lineBreak":true},{"text":"puku ni maana, na ahamu te vonughia na maramana!","poem":1},{"lineBreak":true},{"text":"Mana lada mu te haba dato vulea na parako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ighoe to taraira na lei gari pile,","poem":1},{"lineBreak":true},{"text":"mana lei meomeo,","poem":1},{"lineBreak":true},{"text":"ge kara bosai puku ni holohaba.","poem":1},{"lineBreak":true},{"text":"Ma gaira kara talu betora ghamua na levunimate,","poem":1},{"lineBreak":true},{"text":"tara kenea na lavitughuamu/toroamu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mi tana bona inau tu reitada tana parako te bongi,","poem":1},{"lineBreak":true},{"text":"ge ku righia na lutu ni gigirimu-tana vula","poem":1},{"lineBreak":true},{"text":"mana lei veitughu tana sopa malani to talui ga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na hava vaho tua na mete vaghana","poem":1},{"lineBreak":true},{"text":"to ghanaghana dilaa vanighai tai huli vinahi","poem":1},{"lineBreak":true},{"text":"te manana ge ko righitaonighai?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na pukuna ighoe to gonighai pile kikia vamua isarana God,","poem":1},{"lineBreak":true},{"text":"mo pitiulumami nia na lada mana rongoragha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ighoe to talughai ge kai righitaonighi na lei totobo to gonighi,","poem":1},{"lineBreak":true},{"text":"mo vaheghai na maana vulera na lei totobo soko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na sheep mana buluka,","poem":1},{"lineBreak":true},{"text":"maia ghua na lei bolo matamata.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Na manu tana oka, mana igha tana tahi,","poem":1},{"lineBreak":true},{"text":"mana lei totobo vola tara olo’olo kolili tana harara oka.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ghe Lord, nimami na Lord puku ni maana,","poem":1},{"lineBreak":true},{"text":"na ahamu te vonughia na maramana!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}