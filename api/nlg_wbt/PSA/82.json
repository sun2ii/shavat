{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Nina linge Asaph"]},{"type":"verse","number":1,"content":[{"text":"God te sopoulia na dete i kokou:","poem":1},{"lineBreak":true},{"text":"me nia hevei horu mai nina bosa ni dete te detera,","poem":1},{"lineBreak":true},{"text":"rana ovu ni dete i kokou:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Ighau rana dete, kau sania na dete sorisori?","poem":1},{"lineBreak":true},{"text":"Ma kau bei nira pala rana dika,","poem":1},{"lineBreak":true},{"text":"tau nighi hevei horu nimiu na bosa ni dete!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kau na barebare na uto vanira rana bona,","poem":1},{"lineBreak":true},{"text":"ma tara mua tinagha ma ra tamagha:","poem":1},{"lineBreak":true},{"text":"kau kage utoa vanira te manadira na hahanga,","poem":1},{"lineBreak":true},{"text":"ma gaira te taho siki sakai ke hangara.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kau volara raini: tana limadira na vure dika.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gaira kiri tara mua manahagha,","poem":1},{"lineBreak":true},{"text":"mana vahaghitailira na tinoni,","poem":1},{"lineBreak":true},{"text":"na pukuna tara sakutua tana pungi.","poem":1},{"lineBreak":true},{"text":"Keri ge taho siki totobo uto pe ke utuni lokana na maramana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inau tu bosa, “Ighau ke na lei god,","poem":1},{"lineBreak":true},{"text":"tau tabe tughua God tana dete ni maramana.","poem":1},{"lineBreak":true},{"text":"Ighau udolu dalena na Haba i kokou.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kau mate udolu vaghara na lei tinoni soko,","poem":1},{"lineBreak":true},{"text":"ma kau tumu vaghaa so siki dale vunaghi.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"God, ko mai, mo ko detea na maramana:","poem":1},{"lineBreak":true},{"text":"a nimua udolu ighoe na lei kema soko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}