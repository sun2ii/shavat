{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Na linge nina kemana Korah"]},{"type":"verse","number":1,"content":[{"text":"A Lord te gonia na komuna,","poem":1},{"lineBreak":true},{"text":"i vuvungana na ghotu tabu i Jerusalem.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na volana udolu tua tana komu sule keri,","poem":1},{"lineBreak":true},{"text":"vulei na balu komu lokana Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem, na komuna God,","poem":1},{"lineBreak":true},{"text":"me subo na lei totobo uto tara bosagho nia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inau tu ghilalara na kema ni Egypt, ma rana Babylonia,","poem":1},{"lineBreak":true},{"text":"gaira ghua na balu, tara ghilalau nia na taonia na bosagu,","poem":1},{"lineBreak":true},{"text":"maia ghua na vure ni Philistia, Tyre mi Ethiopia","poem":1},{"lineBreak":true},{"text":"Gaira udolu tu idumi kolura nia na vure ni Jerusalem.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jerusalem kara nia bosa,","poem":1},{"lineBreak":true},{"text":"“Na vure udolu tara va komu tua igaa.”","poem":1},{"lineBreak":true},{"text":"ma gaia te haba vule ke vautoa na komu sule keri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi tana bona ke gerera na lei kema a Lord ke,","poem":1},{"lineBreak":true},{"text":"ge ke bosa, “A eni gaia na kema ke haghe mai Jerusalem.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tana lei bongi ni gougonu,","poem":1},{"lineBreak":true},{"text":"kara ghavai ma kara linge na vure,","poem":1},{"lineBreak":true},{"text":"“Na volagu te vuravura mai Jerusalem.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}