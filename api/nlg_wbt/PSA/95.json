{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Ighita ka linge vania a Lord,","poem":1},{"lineBreak":true},{"text":"Ighita ka linge togotogo vania God na vavolada.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ka mai tatana nia na holouto,","poem":1},{"lineBreak":true},{"text":"ma ka linge togotogo nia na holohaba.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gaia a Lord, God te haba,","poem":1},{"lineBreak":true},{"text":"na vunaghi haba tadira na lei god.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gaia te vunaghina na maramana talighu,","poem":1},{"lineBreak":true},{"text":"na lei vatuluma mana ghotu datogha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A nina te gonia na tahi,","poem":1},{"lineBreak":true},{"text":"na pari tina ghua te puputua heghena.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ighita ka nia kikinima ka holohabaa,","poem":1},{"lineBreak":true},{"text":"taulaghi tuturu vania te gonighita.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gaia dida God, te righitaonighita,","poem":1},{"lineBreak":true},{"text":"mi ghita nina lei sheep te vatoghaghita.","poem":1},{"lineBreak":true},{"text":"Itaeni, kau rongovia mughua na hava God te bosaa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kau rongovia na bosana itaeni te ghaghua,","poem":1},{"lineBreak":true},{"text":"“Kau bei kutuvatu vaghara kukuamiu i Meribah,","poem":1},{"lineBreak":true},{"text":"tana bongidira i Massah tana bona mamaha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rana kukuamiu tara tabotabou igaa,","poem":1},{"lineBreak":true},{"text":"tara righia maanagu ta na hava tu gonia.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E vati hangavulu na niulu tu rutu vanira,","poem":1},{"lineBreak":true},{"text":"keri ge u bosa,","poem":1},{"lineBreak":true},{"text":"“Gaira na vure tara loghoa na tobadira te ririu keha itagua haia.","poem":1},{"lineBreak":true},{"text":"Tara mua lioni na taoniana na hava tu bosai vanira.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mi nau tu baubahu rutu vanira,","poem":1},{"lineBreak":true},{"text":"“Agaira kara mua tangomana tua na rughuhaghe ta nigua na malei aheahe igaa.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}