{"translation":{"id":"nlg_wbt","name":"Na Rongorongo Uto nina Jesus Christ","website":"https://ebible.org/Scriptures/details.php?id=nlg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nlg","licenseNotes":null,"shortName":"WBT","englishName":"Gela Bible","language":"nlg","textDirection":"ltr","sha256":"09dc5bbfecc74e758c11238d5780c7b8fbffd77c3e2bd2be7642a37cc89d1737","availableFormats":["json"],"listOfBooksApiLink":"/api/nlg_wbt/books.json","numberOfBooks":36,"totalNumberOfChapters":568,"totalNumberOfVerses":14617,"languageName":"Gela","languageEnglishName":"Gela"},"book":{"id":"PSA","translationId":"nlg_wbt","name":"LINGE","commonName":"LINGE","title":"Linge","order":19,"numberOfChapters":150,"sha256":"a82d23eb747c737da1cdc653e64b5f54bc876d68afde3232a7a1046974da08b8","firstChapterNumber":1,"firstChapterApiLink":"/api/nlg_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nlg_wbt/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Na linge"]},{"type":"verse","number":1,"content":[{"text":"Kau lingea na linge vaolu vania a Lord,","poem":1},{"lineBreak":true},{"text":"gaia te goni sokoi na lei totobo haeharegha,","poem":1},{"lineBreak":true},{"text":"ma nia nina maana mana laga heghena,","poem":1},{"lineBreak":true},{"text":"ge lagavulea na maramana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A Lord te bosa tatea nina laga vule,","poem":1},{"lineBreak":true},{"text":"me ladavaghinia nina maana ni vola tadira na lei kema.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gaia te pangotia so nina baubahu vanira na vure ni Israel,","poem":1},{"lineBreak":true},{"text":"nia na kabu rurughu mana dolo vanira haia,","poem":1},{"lineBreak":true},{"text":"na lei vure soko tara righia tua nina lagavule dida God.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Linge vania a Lord, na maramana talighu,","poem":1},{"lineBreak":true},{"text":"holohabaa nia na lei linge mana ngingili rivurivu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Linge holohaba vania a Lord,","poem":1},{"lineBreak":true},{"text":"kau nighi tigitigi na ukalele mana gita.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kau lovui na ghau mana tavuli,","poem":1},{"lineBreak":true},{"text":"ma kau ngingili vania Lord na vunaghida.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na tahi, ko tagumu, ma na lei totobo vola itamua,","poem":1},{"lineBreak":true},{"text":"na maramana ko linge, ma gaira tara kabu itamua.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ghau na lei beti tavetave mana lei ghotu,","poem":1},{"lineBreak":true},{"text":"kau tapotapo limamiu ma kau linge koukolu","poem":1},{"lineBreak":true},{"text":"nia na togotogo vania a Lord.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na pukuna gaia ke mai me ke vunaghina na maramana","poem":1},{"lineBreak":true},{"text":"kolura na lei vure ni maramana talighu nia na maemane mana utuni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nlg_wbt/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nlg_wbt/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nlg_wbt/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}