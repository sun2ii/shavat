{"translation":{"id":"nmw_swb","name":"Metiu ge Efeso","website":"https://ebible.org/Scriptures/details.php?id=nmws","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nmws","licenseNotes":null,"shortName":"SWB","englishName":"Saisai Matthew + Ephesians","language":"nmw","textDirection":"ltr","sha256":"bf4bfc921382d2763216af0aa29d2431ec2601146deefb5ab442dc6dd118fa03","availableFormats":["json"],"listOfBooksApiLink":"/api/nmw_swb/books.json","numberOfBooks":2,"totalNumberOfChapters":34,"totalNumberOfVerses":1221,"languageName":"Nimoa","languageEnglishName":"Nimoa"},"book":{"id":"MAT","translationId":"nmw_swb","name":"METIU","commonName":"METIU","title":"Yeisu Wasane Dodohobine Metiu wana Luluweli","order":40,"numberOfChapters":28,"sha256":"bee3aa2084991f6e93cff9dfb8f20c5fdbb8679ef9275d91160b094ec3f0c91d","firstChapterNumber":1,"firstChapterApiLink":"/api/nmw_swb/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/nmw_swb/MAT/28.json","totalNumberOfVerses":1068},"chapter":{"number":1,"content":[{"type":"heading","content":["Yeisu hana Tubu Lihuine"]},{"type":"verse","number":1,"content":["Yeisu Keriso hana tubu lihuine sohode ti ya. Yeisu Keriso iye Deivid tubutubuine, Deivid iye Eibraham tubutubuine."]},{"type":"verse","number":2,"content":[{"text":"Eibraham natune Aisak,","poem":1},{"lineBreak":true},{"text":"Aisak natune Jeikob,","poem":1},{"lineBreak":true},{"text":"Jeikob he-nanatune Juda ge he-hauhavane,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Juda he-nanatune Peres ge Jera, tinadiye Tama,","poem":1},{"lineBreak":true},{"text":"Peres natune Hesron,","poem":1},{"lineBreak":true},{"text":"Hesron natune Ram,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ram natune Aminadab,","poem":1},{"lineBreak":true},{"text":"Aminadab natune Nason,","poem":1},{"lineBreak":true},{"text":"Nason natune Salmon,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salmon natune Bowasa, tinane iye Reihab,","poem":1},{"lineBreak":true},{"text":"Bowasa natune Obeda, tinane iye Rut,","poem":1},{"lineBreak":true},{"text":"Obeda natune Jesi,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jesi natune Kin Deivid.","poem":1},{"lineBreak":true},{"text":"Deivid natune Solomon, tinane gane iye veto Uraiya poniyene,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Solomon natune Rehobowam,","poem":1},{"lineBreak":true},{"text":"Rehobowam natune Abaija,","poem":1},{"lineBreak":true},{"text":"Abaija natune Asa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa natune Jehosefet,","poem":1},{"lineBreak":true},{"text":"Jehosefet natune Jehoram,","poem":1},{"lineBreak":true},{"text":"Jehoram natune Usaiya,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Usaiya natune Jotem,","poem":1},{"lineBreak":true},{"text":"Jotem natune Ahas,","poem":1},{"lineBreak":true},{"text":"Ahas natune Hesekaiya,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hesekaiya natune Manasa,","poem":1},{"lineBreak":true},{"text":"Manasa natune Eimon,","poem":1},{"lineBreak":true},{"text":"Eimon natune Josaiya,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Josaiya he-nanatune Jehoyasin ge he-hauhavane,","poem":1},{"text":"saugeine Babilon si luwom si yawanid Juda ge si yomoteiid Babilon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Si yawanid Juda ge si yomoteiid Babilon he muine:","poem":1},{"lineBreak":true},{"text":"Jehoyasin natune Seyaltiyel,","poem":1},{"lineBreak":true},{"text":"Seyaltiyel natune Serababel,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Serababel natune Abiud,","poem":1},{"lineBreak":true},{"text":"Abiud natune Elayakim,","poem":1},{"lineBreak":true},{"text":"Elayakim natune Eiso,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Eiso natune Jeidok,","poem":1},{"lineBreak":true},{"text":"Jeidok natune Akim,","poem":1},{"lineBreak":true},{"text":"Akim natune Eliud,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliud natune Eliyesa,","poem":1},{"lineBreak":true},{"text":"Eliyesa natune Meitan,","poem":1},{"lineBreak":true},{"text":"Meitan natune Jeikob,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ge Jeikob natune Josep, Meri mwaniyene.","poem":1},{"lineBreak":true},{"text":"Meri i hab Yeisu, iye ta nga Mesaiya.","poem":1}]},{"type":"verse","number":17,"content":["Iye te heine Eibraham hana had Deivid ta paidi sai ge sai wedi hohoyowate potin (14), Deivid hana had sauge gane si yomoteiid Juda Babilon sai ge sai wedi hohoyowate potin (14), ge sauge ga yake hana had Mesaiya i youmate sai ge sai wedi hohoyowate potin (14)."]},{"type":"heading","content":["Yeisu Keriso wana Youmate"]},{"type":"verse","number":18,"content":["Yeisu Keriso wana youmate sohode ti ya. Tinane Meri bwaine ge Josep si kaukauwaroru. Taine habe si dehaduwe, si paidi Meri hobak i matabuwon Yayaluwo Gagabubine wana gaisi heine."]},{"type":"verse","number":19,"content":["Josep wana page i dohob ge taine nuwane i depamwadine-yan Meri boda he matadiye, iloke i nuwotu tage wedi kaukauwaroru i elake sumo."]},{"type":"verse","number":20,"content":["I nunuwotu sohode ti yo, habe he wana heneluluwo Guyau wana anelose i youmate heine ge i nga, “Josep, Deivid tubune, tab u ematok u howo Meri poniyem, kaiwane wana matabuwon i luwom Yayaluwo Gagabubine heine."]},{"type":"verse","number":21,"content":["Bwele i hab natune tolomo, ge hidane u tin Yeisu,",{"noteId":0},"kaiwane bwele i pwamwadid wana bobode he wedi gegi.”"]},{"type":"verse","number":22,"content":["I youmate sohode ti yo, iloke Guyau wana lihu gane profet hotiya i payoumate i tabwa tolosuwok,"]},{"type":"verse","number":23,"content":["i nga, “Hehoi tan i delotolomo benan habe i matabuwon ge i hab natune tolomo, iloke hidane si tin Imanuwel.” Imanuwel hana sapu te “Helak iye bwaide.”"]},{"type":"verse","number":24,"content":["Sauge Josep i hene suwoyuk, bwen i hadaenge Meri sohode Guyau wana anelose wana lihu heine."]},{"type":"verse","number":25,"content":["Agegene taine bwaine si dehene toyao hana had i hab natune tolomo. Bwen Josep i tin memai hidane Yeisu."]}],"footnotes":[{"noteId":0,"caller":"*","text":"Ide “Yeisu” hana sapu i gan iye te “Guyau topamwad.”","reference":{"chapter":1,"verse":21}}]},"thisChapterLink":"/api/nmw_swb/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nmw_swb/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}