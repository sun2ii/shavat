{"translation":{"id":"nna_wbt","name":"Nyangumarta Bible","website":"https://ebible.org/Scriptures/details.php?id=nna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nna","licenseNotes":null,"shortName":"WBT","englishName":"Nyangumarta Bible","language":"nna","textDirection":"ltr","sha256":"a5410aa937a3997920086be8c84955aa0ebdbf45c09c9a8d640de4ad5f2f154c","availableFormats":["json"],"listOfBooksApiLink":"/api/nna_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":134,"totalNumberOfVerses":2156,"languageName":"Nyangumarta","languageEnglishName":"Nyangumarta"},"book":{"id":"PSA","translationId":"nna_wbt","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":4,"sha256":"d3712690792942424ec60e0bf0ad61f469299bb2a2eb4c14722d8a83d6dae126","firstChapterNumber":1,"firstChapterApiLink":"/api/nna_wbt/PSA/1.json","lastChapterNumber":32,"lastChapterApiLink":"/api/nna_wbt/PSA/32.json","totalNumberOfVerses":18},"chapter":{"number":1,"content":[{"type":"heading","content":["Psalm 1"]},{"type":"verse","number":1,"content":[{"text":"Pikaly yiji nyarrarrangu marrngurrangu yakal manakata kurlujartiny jinakatarrangumilaku muwarrku,","poem":1},{"lineBreak":true},{"text":"munu manal-manal jarrinyayijanaku kurlujartinyarrangumilingi jinangapa","poem":1},{"lineBreak":true},{"text":"munu kulurnayijaninyi palarrangu nyurni manakata Ngarrkaku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pikaly yiji waninyayi kurlkarri manajalu Ngarrkamilaku muwarrku, pinakarrinyayalu ngarrakunyju.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Miranu nyurra nyarra mungka yintamartaji waninyi,","poem":1},{"lineBreak":true},{"text":"ngalypa kakuputu,","poem":1},{"lineBreak":true},{"text":"mayi karrinyili ngalypakatapa","poem":1},{"lineBreak":true},{"text":"parrka munu tikirl jarrinyakayi.","poem":1},{"lineBreak":true},{"text":"Ngalypakata marrngurrangu palajunngarra mungkakapali.","poem":1},{"lineBreak":true},{"text":"Jurtulu jinayi nganiwarralpirti, ngalypa jarrulinyjanaku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Munu yiji yakujun kurlujartiny jinakatarrangu marrngurrangu;","poem":1},{"lineBreak":true},{"text":"jana nyarra ngapikapali, yapinajakapali mayikurnukapali, wangalju kanganyi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ngarrkalu marrjalu wirlalkulinyjaninyi.","poem":1},{"lineBreak":true},{"text":"Palinyju jinta pilkulinyjaninyi,","poem":1},{"lineBreak":true},{"text":"jana munu wantulupiyijanaku palinymilirrangungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngarrkalu tukulu kalkunajaninyi palinymilirrangu jurtungu ruwurtungu.","poem":1},{"lineBreak":true},{"text":"Wariny yiji kurlujartiny jinakatarranguku,","poem":1},{"lineBreak":true},{"text":"jana yananyayi yijakarti yiji kurluny-kurlunykarti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nna_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nna_wbt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nna_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}