{"translation":{"id":"nna_wbt","name":"Nyangumarta Bible","website":"https://ebible.org/Scriptures/details.php?id=nna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nna","licenseNotes":null,"shortName":"WBT","englishName":"Nyangumarta Bible","language":"nna","textDirection":"ltr","sha256":"a5410aa937a3997920086be8c84955aa0ebdbf45c09c9a8d640de4ad5f2f154c","availableFormats":["json"],"listOfBooksApiLink":"/api/nna_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":134,"totalNumberOfVerses":2156,"languageName":"Nyangumarta","languageEnglishName":"Nyangumarta"},"book":{"id":"PSA","translationId":"nna_wbt","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":4,"sha256":"d3712690792942424ec60e0bf0ad61f469299bb2a2eb4c14722d8a83d6dae126","firstChapterNumber":1,"firstChapterApiLink":"/api/nna_wbt/PSA/1.json","lastChapterNumber":32,"lastChapterApiLink":"/api/nna_wbt/PSA/32.json","totalNumberOfVerses":18},"chapter":{"number":32,"content":[{"type":"heading","content":["Psalm 32"]},{"type":"verse","number":1,"content":[{"text":"Jinta marrngu kurlu jiniyi.","poem":1},{"lineBreak":true},{"text":"Palaja wurrarnayalu Ngarrkanga, “Kurntany jarrinyarnangu”.","poem":1},{"lineBreak":true},{"text":"Puru yakarnajaninyi.","poem":1},{"lineBreak":true},{"text":"Palaja pikaly waninyayi ngarramarnti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jinta marrngu kurlu jiniyi.","poem":1},{"lineBreak":true},{"text":"Palaja wurrarnayalu Ngarrkanga, “Kurntanyja jarrinyayirni.”","poem":1},{"lineBreak":true},{"text":"Munu mitu marnamayi,","poem":1},{"lineBreak":true},{"text":"munu warnta marnamajaninyi.","poem":1},{"lineBreak":true},{"text":"Kuwarri pikaly waninyiyi kakuputu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Purlpi kurlu jinirni,","poem":1},{"lineBreak":true},{"text":"munu wurrarnamarnalu Ngarrkanga.","poem":1},{"lineBreak":true},{"text":"Palajalu ngangkurl jinikinyirni kara wurrpu.","poem":1},{"lineBreak":true},{"text":"Ngangkurlaja manyurla jarrinyirni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Karrpurrangu karrpungu, warrukartirrangu warrukarti,","poem":1},{"lineBreak":true},{"text":"nyuntulu kararr jinijin, nyampali!","poem":1},{"lineBreak":true},{"text":"Manyurla yija-yiji jarrinyirni.","poem":1},{"lineBreak":true},{"text":"Yurranga karrpulu yarntalkuliny janpa, punarra jilkuliny.","poem":1},{"lineBreak":true},{"text":"Palakapali warnta marninyin, Nyampali,","poem":1},{"lineBreak":true},{"text":"palangulu tirtirti pinirni, murrjin jarrinyirni,","poem":1},{"lineBreak":true},{"text":"marlkarri jarrimarna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Palangulu wurrarnarnangu yija,","poem":1},{"lineBreak":true},{"text":"palakapali jinirni, kurlu jinirni.","poem":1},{"lineBreak":true},{"text":"Munu kuku jarrrimarnangu nyuntunga,","poem":1},{"lineBreak":true},{"text":"kurlka jarrinyirni wurralamarnangu kurlurrangu jinirni. Wurrarnarnangu,","poem":1},{"lineBreak":true},{"text":"“Milya kaniny jarrinyarnangu kurntanyjartiny.”","poem":1},{"lineBreak":true},{"text":"Palajalu puru ngakarninyin ngalypalu kakuputu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Palajalu nyuntumili marrngurrangu,","poem":1},{"lineBreak":true},{"text":"palarrangu marrngu miranu nyuntuku,","poem":1},{"lineBreak":true},{"text":"wurranaku nyuntungu nganijartiny muwarrjartiny.","poem":1},{"lineBreak":true},{"text":"Janalu japirr manaku nyuntu,","poem":1},{"lineBreak":true},{"text":"“Ngarrka, ngani jilamarnajanaku nyungurrangu?”","poem":1},{"lineBreak":true},{"text":"Palaja jilipiyi, ngalypa yankulupiyi.","poem":1},{"lineBreak":true},{"text":"Nganipa kurlu milpulinyjanaku,","poem":1},{"lineBreak":true},{"text":"ngapikapali mangkurtu mirti jarrulkuliny marrja pijunga,","poem":1},{"lineBreak":true},{"text":"nyuntulu kalkulumanjaninyi tukulu.","poem":1},{"lineBreak":true},{"text":"Pala mangkurtu munu kanka jarrulinyjanaku,","poem":1},{"lineBreak":true},{"text":"munu kangkulinyjaninyi warnan-warnan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tuku waninyarni nyuntunga.","poem":1},{"lineBreak":true},{"text":"Nganingamarrapa tuku kalkuluminyin.","poem":1},{"lineBreak":true},{"text":"Purntu marnanyin.","poem":1},{"lineBreak":true},{"text":"Palajalu kurntarnarni marrjalu,","poem":1},{"lineBreak":true},{"text":"“Ngarrkalu tukulu kalkurninyi!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nyampalilu wurrarnaji, “Pinakarraji ngajuku!","poem":1},{"lineBreak":true},{"text":"Munu ngakumpa jarrinyaku yawartakapalipa tangkikapali.","poem":1},{"lineBreak":true},{"text":"Wirriliman purayitul yirranga.","poem":1},{"lineBreak":true},{"text":"Munujalu yankulupiyi warinykurnu.","poem":1},{"lineBreak":true},{"text":"Munu ngakumpa jarruluman janakapali.","poem":1},{"lineBreak":true},{"text":"Wirrilimarnanga purayitul nyuntunga? Munu yiji!","poem":1},{"lineBreak":true},{"text":"Ngajumili muwarrjartinyju miranu jilamarnanta,","poem":1},{"lineBreak":true},{"text":"ngani jilaman.","poem":1},{"lineBreak":true},{"text":"Nyuntulu yirrkulu pinakarrlupijin ngajuku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kurlujartinyju marrngulu yirrkulu kurlu jinayarninyi.","poem":1},{"lineBreak":true},{"text":"Ngarrka yirrkulu karrinyijanaku yajarnayipa punjalu,","poem":1},{"lineBreak":true},{"text":"palinyju tukulu kalkulinyjaninyi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nyurra marrngu ngalypa jininyurru,","poem":1},{"lineBreak":true},{"text":"parrjalayi Ngarrka ngani jini!","poem":1},{"lineBreak":true},{"text":"Pikaly jarrayi, raka jarrayi!","poem":1},{"lineBreak":true},{"text":"Nyurra marrngurrangu, nyurralu yajarnakinyinyurra Ngarrka,","poem":1},{"lineBreak":true},{"text":"kamalayi pikalyjartinyju.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nna_wbt/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nna_wbt/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nna_wbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}