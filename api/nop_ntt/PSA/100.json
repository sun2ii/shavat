{"translation":{"id":"nop_ntt","name":"Bepaŋ'Walaŋ Folofolok Kobuli","website":"https://ebible.org/Scriptures/details.php?id=nop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nop","licenseNotes":null,"shortName":"NTT","englishName":"Numanggang Bible","language":"nop","textDirection":"ltr","sha256":"5e0daa9bdaf86c90b718726bdeb00aeb05ccf8a76ca4dd6db9cb09c3147ba0f4","availableFormats":["json"],"listOfBooksApiLink":"/api/nop_ntt/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11850,"languageName":"Numanggang","languageEnglishName":"Numanggang"},"book":{"id":"PSA","translationId":"nop_ntt","name":"Kap","commonName":"Kap","title":"Judahi’walaŋ Kap","order":19,"numberOfChapters":150,"sha256":"b402c64e3366f2920d74cebf34b06450a6c2ca33dfae1045b30308027a3679d6","firstChapterNumber":1,"firstChapterApiLink":"/api/nop_ntt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nop_ntt/PSA/150.json","totalNumberOfVerses":2441},"chapter":{"number":100,"content":[{"type":"heading","content":["Yahwe wou nintiloloŋdok kap"]},{"type":"verse","number":1,"content":["Metam hogohogok kwetkwet hatiiŋ, hidi Yahwedok nadifo tiŋa kap toneŋ."]},{"type":"verse","number":2,"content":["Hidi Yahwe welemomooŋ nadimiŋa niutumbaneŋ. Eŋ yamaiŋgoŋ wo-tubudulaaŋ nadifo kap tomineŋ."]},{"type":"verse","number":3,"content":["Hidi indiŋ yohautaneŋ. Yahwe kubugoŋdi Bepaŋ hinek. Adigoŋ nihitubu-mintaguk, unduŋ doktiŋa indi adi netok gigit hatiyam. Memetamŋiye indi adi dompaŋiye dabugoŋ."]},{"type":"verse","number":4,"content":["Indi adi’walaŋ Siloŋyotneŋ fofoŋdok niutumba tiŋa fonim. Eŋ yoli maaneŋ fooŋ wou nintilonim. Unduŋ tiŋa niutumbaaŋ wougigitŋiŋ nintilo tinim."]},{"type":"verse","number":5,"content":["Maŋgande, Yahwe adi titiŋ momooŋ hogok tilak. Tiŋa helemahelemaŋ weleŋdi hinek nibukahilelak. Adi yadi helemahelemaŋ medeŋiŋ yofafaŋeguk u baigoŋ didimeniŋgoŋ hinek takalilak."]}],"footnotes":[]},"thisChapterLink":"/api/nop_ntt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nop_ntt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nop_ntt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}