{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"AMO","translationId":"npi_ncb","name":"आमोस","commonName":"आमोस","title":"आमोसको भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"b9ea96289726beb36d09c05b0f580ff89d979dc99ad43579edc56c1353e6506d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/npi_ncb/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["आमोसका वचनहरू, जो तकोका गोठालाहरूमध्येका एक जना थिए। जब उज्जियाह यहूदाका राजा थिए र यारोबामका छोरा योआशचाहिँ इस्राएलका राजा थिए, तब भुइँचालो जानुभन्दा दुई वर्षअगि आमोसले इस्राएलको बारेमा यस्तो दर्शन देखेका थिए।"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":["तिनले भने:",{"text":"“याहवेह सियोन पर्वतदेखि सिंहझैँ गर्जनुहुन्छ,","poem":1},{"text":"र यरूशलेमबाट चर्को आवाजमा गर्जनुहुन्छ;","poem":2},{"text":"गोठालाका खर्कहरू सुकेर जान्छन्","poem":1},{"text":"र कर्मेलको टाकुरा ओइलाउँछ।”","poem":2}]},{"type":"heading","content":["इस्राएलका छिमेकीहरूमाथि न्याय"]},{"type":"verse","number":3,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“दमस्कसका तीन वटा पापहरूका कारण,","poem":1},{"text":"अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।","poem":2},{"text":"किनकि त्यसले फलामका दाँतहरू भएका","poem":1},{"text":"डण्डाले गिलादलाई दाइँ गरेकी छे;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"म हजाएलको घरमा आगो पठाउनेछु,","poem":1},{"text":"जसले बेन-हददका किल्‍लाहरूलाई भस्म पार्नेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"म दमस्कसका ढोकालाई फोरिदिनेछु;","poem":1},{"text":"म अवेनको बेँसीमा बस्‍ने राजालाई नाश गर्नेछु;","poem":2},{"text":"अनि बेथ-अदनमा राजदण्ड लिने राजालाई म नाश गर्नेछु।","poem":1},{"text":"अरामका मानिसहरू निर्वासित भएर कीर देशमा जानेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेहले भन्‍नुहुन्छ।","poem":2}]},{"type":"verse","number":6,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“गाजाका तीन वटा पापहरूका कारण,","poem":1},{"text":"अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।","poem":2},{"text":"किनकि गाजाले सारा समुदायलाई कैदमा लगेकी छे;","poem":1},{"text":"अनि एदोमको हातमा तिनीहरूलाई बेचेकी छे;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म गाजाका पर्खालहरूमाथि आगो पठाउनेछु,","poem":1},{"text":"जसले त्यसका किल्‍लाहरू भस्म पार्नेछ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"म अश्दोदको राजा","poem":1},{"text":"र अश्कलोनको राजदण्ड लिनेलाई नाश गर्नेछु।","poem":2},{"text":"सबै पलिश्तीहरू नमरेसम्म,","poem":1},{"text":"म मेरो हात एक्रोनको सहरको विरुद्धमा उठाउनेछु,”","poem":2},{"lineBreak":true},{"text":"प्रभु याहवेह भन्‍नुहुन्छ।","poem":2}]},{"type":"verse","number":9,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“टायरका तीन वटा पापहरूका कारण,","poem":1},{"text":"अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।","poem":2},{"text":"किनकि त्यसले मित्रताको सन्धिलाई अनादर गर्दै","poem":1},{"text":"एदोमलाई कैदीको सारा समुदाय बेचेकी छे;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"म टायरका पर्खालहरूमाथि आगो पठाउनेछु,","poem":1},{"text":"जसले त्यसका बलिया किल्‍लाहरूलाई भस्म पार्नेछ।”","poem":2}]},{"type":"verse","number":11,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“एदोमका तीन वटा पापहरूका कारण,","poem":1},{"text":"अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।","poem":2},{"text":"किनकि एदोमले आफ्नो भाइलाई तरवारले खेद्‌यो,","poem":1},{"text":"र देशका स्त्रीहरूलाई मार्‍यो;","poem":2},{"text":"किनभने त्यसको रिस निरन्तर उठिरह्‍यो,","poem":1},{"text":"र त्यसको रिसको ज्वाला दन्किरह्‍यो।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"म तेमानमाथि आगो पठाउनेछु;","poem":1},{"text":"त्यसले बोज्राका किल्‍लाहरूलाई भस्म पार्नेछ।”","poem":2}]},{"type":"verse","number":13,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“अम्मोनका तीन वटा पापहरूका कारण,","poem":1},{"text":"अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।","poem":2},{"text":"किनकि अम्मोनले आफ्ना सिमानाहरू बढाउनका निम्ति","poem":1},{"text":"गिलादका गर्भवती स्त्रीहरूका पेट तरवारले चिरिदियो।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"म रब्बाका पर्खालहरूमाथि आगो पठाउनेछु,","poem":1},{"text":"जसले त्यसको किल्‍लाहरू भस्म पार्नेछ;","poem":2},{"text":"लडाइँको दिनमा युद्ध ध्वनिहरूका बीचमा,","poem":1},{"text":"र आँधीबेहरीको दिनमा प्रचण्ड बतासको बीचमा भस्म पार्नेछ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"रब्बाका राजाका","poem":1},{"noteId":0},{"text":"साथै तिनी र तिनका अधिकारीहरू","poem":1},{"text":"सबै एकसाथ निर्वासनमा लगिनेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह भन्‍नुहुन्छ।","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"अथवा मोलेखका","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/npi_ncb/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}