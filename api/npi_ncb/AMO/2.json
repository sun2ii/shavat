{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"AMO","translationId":"npi_ncb","name":"आमोस","commonName":"आमोस","title":"आमोसको भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"b9ea96289726beb36d09c05b0f580ff89d979dc99ad43579edc56c1353e6506d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/npi_ncb/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“मोआबका तीन वटा पापहरू,","poem":1},{"text":"अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।","poem":2},{"text":"किनकि त्यसले एदोमको राजाका","poem":1},{"text":"हड्डीहरू जलाएर खरानी पारिदियो;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"म मोआबमाथि आगो पठाउनेछु,","poem":1},{"text":"जसले किर्योतका किल्‍लाहरूलाई भस्म पार्नेछ।","poem":2},{"text":"मोआबको पतन ठूलो होहल्‍लाका साथ","poem":1},{"text":"युद्ध-ध्वनिको बीचमा र तुरहीका आवाजका साथ हुनेछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"म त्यसको शासकलाई नाश गर्नेछु,","poem":1},{"text":"र त्यसका सबै अधिकारीहरूलाई त्योसितै मार्नेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह भन्‍नुहुन्छ।","poem":2}]},{"type":"verse","number":4,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“यहूदाका तीन वटा पापहरू,","poem":1},{"text":"अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।","poem":2},{"text":"किनकि तिनीहरूले याहवेहको व्यवस्थालाई अस्वीकार गरेका छन्,","poem":1},{"text":"र उहाँका आदेशहरूलाई पालन गरेका छैनन्;","poem":2},{"text":"किनकि तिनीहरू झूटा देवताहरूको कारण बाटो बिराएका छन्,","poem":1},{"text":"जसका पितापुर्खाहरूले तिनीहरूलाई पछ्याएका थिए,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"म यहूदामाथि आगो पठाउनेछु;","poem":1},{"text":"त्यसले यरूशलेमका किल्‍लाहरू भस्म पार्नेछ।”","poem":2}]},{"type":"heading","content":["इस्राएलमाथि न्याय"]},{"type":"verse","number":6,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“इस्राएलका तीन वटा पापहरूका कारण,","poem":1},{"text":"अथवा चार वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।","poem":2},{"text":"तिनीहरूले निर्दोषलाई चाँदीमा,","poem":1},{"text":"र खाँचोमा परेकाहरूलाई एक जोर जुत्तामा बेच्छन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरूले भुइँको धुलोमा कुल्चेझैँ","poem":1},{"text":"गरिबका टाउकोमाथि कुल्चन्छन्;","poem":2},{"lineBreak":true},{"text":"अनि अत्याचारमा परेकाहरूलाई न्याय दिँदैनन्।","poem":2},{"text":"बुबा र छोराले एउटै स्त्रीलाई प्रयोग गर्छन्;","poem":1},{"text":"अनि यसरी मेरो पवित्र नामलाई अपवित्र बनाउँछन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरू हरेक वेदीको छेउमा","poem":1},{"text":"बन्धकको रूपमा राखेका लुगाहरूमा ढल्किन्छन्।","poem":2},{"text":"तिनीहरू आफ्ना देवताको मन्दिरमा","poem":1},{"text":"जरिमानाको रूपमा उठाएको दाखमद्य पिउँछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“मैले तिनीहरूकै सामु एमोरीहरूलाई नाश गरेँ,","poem":1},{"text":"तर पनि त्यो देवदारुको रूखजस्तै अल्गो,","poem":2},{"lineBreak":true},{"text":"र फलाँटको रूखजस्तै बलियो थियो।","poem":2},{"text":"मैले ती रूखहरूमाथि रहेका फलहरू,","poem":1},{"text":"र त्यसको तल रहेका जराहरू नाश गरिदिएँ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिमीहरूलाई एमोरीहरूको देश अधिकारमा दिनका निम्ति","poem":1},{"text":"मैले तिमीहरूलाई इजिप्टबाट निकालेर ल्याएँ;","poem":2},{"lineBreak":true},{"text":"अनि मैले तिमीहरूलाई चालीस वर्षसम्म उजाडस्थानमा डोर्‍याएँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"मैले तिमीहरूका छोराहरूका बीचबाट अगमवक्ताहरू","poem":1},{"text":"र तिमीहरूका जवान पुरुषहरूका बीचबाट नाजिरीहरू खडा गरेँ।","poem":2},{"text":"“हे इस्राएलका मानिसहरू हो, के यो साँचो होइन र?”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“तर तिमीहरूले नाजिरीहरूलाई दाखमद्य पिउन बाध्य गरायौ,","poem":1},{"text":"र अगमवक्ताहरूलाई अगमवाणी नबोल भनी आदेश दियौ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“त्यसैले अब म अन्‍नले लादिएको गाडाले किचेझैँ","poem":1},{"text":"तिमीहरूलाई जमिनमा किचिदिनेछु।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"वेगसित दगुर्ने पनि उम्कनेछैन;","poem":1},{"text":"बलवान्‌हरूको बल पनि काम लाग्नेछैन,","poem":2},{"lineBreak":true},{"text":"र योद्धाहरूले पनि आफ्नो प्राण बचाउन सक्नेछैनन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"धनु चलाउने पनि आफ्नो ठाउँमा टिक्नेछैन;","poem":1},{"text":"र अति वेगसित दौडने सिपाही उम्कनेछैन;","poem":2},{"lineBreak":true},{"text":"अनि घोडसवारले पनि आफ्नो प्राण बचाउन सक्नेछैन।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"बहादुर योद्धाहरू नै भए तापनि","poem":1},{"text":"त्यो दिन तिनीहरू नाङ्गै भाग्नेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}