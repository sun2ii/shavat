{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"AMO","translationId":"npi_ncb","name":"आमोस","commonName":"आमोस","title":"आमोसको भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"b9ea96289726beb36d09c05b0f580ff89d979dc99ad43579edc56c1353e6506d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/npi_ncb/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["इस्राएलको विरुद्धमा साक्षीहरू बोलाइएको"]},{"type":"verse","number":1,"content":["हे इस्राएलका मानिसहरू हो, यो वचन सुन, जुन वचन याहवेहले तिमीहरूको विरुद्धमा बोल्नुभएको छ—मैले इजिप्टबाट ल्याएका सम्पूर्ण परिवारको विरुद्धमा:"]},{"type":"verse","number":2,"content":[{"text":"“पृथ्वीका सारा घरानाका बीचबाट","poem":1},{"text":"मैले केवल तिमीहरूलाई मात्र चुनेको छु;","poem":2},{"text":"यसकारण म तिमीहरूलाई तिमीहरूका","poem":1},{"text":"सबै पापहरूको दण्ड दिनेछु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"के एक-आपसमा सहमत नभएसम्म","poem":1},{"text":"दुई जना सँगसँगै हिँड्छन् र?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"के जङ्गलमा शिकार नै नभेटी","poem":1},{"text":"सिंह गर्जन्छ र?","poem":2},{"text":"के सिंहले केही फेला नपारीकन","poem":1},{"text":"त्यो आफ्नो गुफाभित्र गर्जन्छ र?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"के पासोमा चारो राखिएको छैन भने,","poem":1},{"text":"चरो पासोमा पर्छ र?","poem":2},{"text":"के पासोमा केही परेको छैन भने,","poem":1},{"text":"त्यो पासो भुइँबाट माथि आफैँ उछिटिन्छ र?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जब सहरमा तुरही फुकिन्छ,","poem":1},{"text":"तब के मानिसहरू डरले काम्दैनन् र?","poem":2},{"text":"जब सहरमा विपत्ति आउँछ,","poem":1},{"text":"के त्यो याहवेहले नपठाउनुभएसम्म आउँछ र?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"निश्‍चय नै प्रभु याहवेहले","poem":1},{"text":"आफ्नो योजना उहाँका सेवक अगमवक्ताहरूलाई","poem":2},{"lineBreak":true},{"text":"प्रकट नगरी केही पनि गर्नुहुन्‍न।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"सिंह गर्जेको सुनेर,","poem":1},{"text":"को भयभीत नहोला र?","poem":2},{"text":"प्रभु याहवेहले बोल्नुभएको छ;","poem":1},{"text":"अनि कसले अगमवाणी गर्दैन र?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"अश्दोदका किल्‍लाहरू","poem":1},{"text":"र इजिप्टका किल्‍लाहरूलाई घोषणा गर:","poem":2},{"text":"“सामरियाका पर्वतहरूमा एकसाथ भेला होओ;","poem":1},{"text":"त्यसभित्र भएको ठूलो अशान्ति","poem":2},{"lineBreak":true},{"text":"र त्यसका आफ्नै मानिसहरूका बीचको थिचोमिचो हेर।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"text":"“कसरी उचित काम गर्ने भन्‍ने कुरा तिनीहरूलाई थाहा नै छैन;","poem":2},{"text":"तिनीहरूले खोसेका र लुटेका मालसामानहरू","poem":1},{"text":"तिनीहरूका किल्‍लाहरूमा थुपार्छन्।”","poem":2}]},{"type":"verse","number":11,"content":["यसकारण प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“शत्रुले तिमीहरूको देशमाथि आक्रमण गर्नेछ;","poem":1},{"text":"त्यसले तिमीहरूका बलिया गढहरूलाई नाश गर्नेछ,","poem":2},{"lineBreak":true},{"text":"र तिमीहरूका किल्‍लाहरूलाई लुटपाट गर्नेछ।”","poem":2}]},{"type":"verse","number":12,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“जसरी एउटा गोठालोले सिंहको मुखबाट भेडाका","poem":1},{"text":"खुट्टाका दुई वटा हड्डीहरू अथवा एउटा कानको टुक्रा मात्र बचाउँछ,","poem":2},{"text":"त्यसरी नै सामरियामा बस्‍ने इस्राएलीहरू,","poem":1},{"text":"पलङको कुना र गद्दीमा बस्‍ने","poem":2},{"lineBreak":true},{"text":"थोरै मानिसहरू मात्र बचाइनेछन्।”","poem":2}]},{"type":"verse","number":13,"content":["प्रभु याहवेह, सेनाहरूका परमेश्‍वर घोषणा गर्नुहुन्छ, “यो सुन, र याकोबको घरानाको विरुद्धमा यो चेतावनी देओ।"]},{"type":"verse","number":14,"content":[{"text":"“जुन दिन इस्राएललाई त्यसका पापहरूका निम्ति दण्ड दिन्छु,","poem":1},{"text":"म बेथेल सहरका वेदीहरू ध्वस्त गर्नेछु;","poem":2},{"text":"वेदीका चारैतिरका सिङहरू काटिनेछन्,","poem":1},{"text":"र ती भुइँमा खस्‍नेछन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"म गर्मीका महल सँगसँगै हिउँदका","poem":1},{"text":"महललाई पनि भत्काउनेछु;","poem":2},{"text":"हस्तीदन्तले सजिएका भवनहरू ध्वस्त पारिनेछन्,","poem":1},{"text":"र दरबारहरू भत्काइनेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}