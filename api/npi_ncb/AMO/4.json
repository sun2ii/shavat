{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"AMO","translationId":"npi_ncb","name":"आमोस","commonName":"आमोस","title":"आमोसको भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"b9ea96289726beb36d09c05b0f580ff89d979dc99ad43579edc56c1353e6506d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/npi_ncb/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["इस्राएल परमेश्‍वरतिर फर्केको छैन"]},{"type":"verse","number":1,"content":[{"text":"हे सामरिया पर्वतमाथि बस्‍ने बाशानका गाईहरू हो, यो वचन सुन!","poem":1},{"text":"हे स्त्रीहरू हो, जसले गरिबहरूलाई थिचोमिचो गर्दछौ र खाँचोमा परेकाहरूलाई सताउँदछौ;","poem":2},{"lineBreak":true},{"text":"अनि आफ्ना पतिहरूलाई भन्दछौ, “हाम्रो निम्ति केही पेय पदार्थ ल्याइदिनुहोस्!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"प्रभु याहवेहले आफ्नो पवित्रताको शपथ खानुभएको छ:","poem":1},{"text":"“अवश्य नै समय आउनेछ,","poem":2},{"text":"जब तिमीहरू अङ्कुसेले तानेर निकालिनेछौ,","poem":1},{"text":"र बाँकी रहेका तिमीहरू पनि बल्छीले समातेर लगिनेछौ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिमीहरू हरेक पर्खालका धाँदाहरूबाट","poem":1},{"text":"सीधै बाहिर निस्कनेछौ।","poem":2},{"text":"तिमीहरू हर्मोनतिर फ्याँकिनेछौ,”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“बेथेलमा जाओ र पाप गर;","poem":1},{"text":"गिलगालमा जाओ र अझ बढी पाप गर।","poem":2},{"text":"हरेक बिहान तिमीहरूका बलिदानहरू ल्याओ!","poem":1},{"text":"हरेक तीन वर्षमा","poem":2},{"noteId":1},{"text":"तिमीहरूका दशांश भेटी पनि ल्याओ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"खमिर हालेको रोटीलाई धन्यवादको भेटीको रूपमा चढाओ,","poem":1},{"text":"र स्वेच्छा भेटीहरूका निम्ति धाक लगाओ;","poem":2},{"text":"अर्थात् हे इस्राएलीहरू हो, तिनीहरूका निम्ति घमण्ड गर;","poem":1},{"text":"किनकि तिमीहरू यसै गर्न रुचाउँछौ,”","poem":2},{"lineBreak":true},{"text":"प्रभु याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“मैले हरेक सहरमा तिमीहरूलाई भोको पेट राखेँ,","poem":1},{"text":"र हरेक नगरमा रोटीको अभाव गरिदिएँ;","poem":2},{"text":"तापनि तिमीहरू मकहाँ फर्केर आएनौ,”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“फसलको समय अझै तीन महिना बाँकी रहँदै","poem":1},{"text":"मैले तिमीहरूका निम्ति वर्षा पनि रोकिदिएँ।","poem":2},{"text":"मैले एउटा सहरमा वर्षाको पानी पठाएँ,","poem":1},{"text":"तर अर्को सहरमा रोकिदिएँ।","poem":2},{"text":"एउटा खेतमा पानी पर्‍यो;","poem":1},{"text":"तर अर्को खेतमाथि परेन, त्यो सुक्यो।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मानिसहरू पानी पिउनका निम्ति सहर-सहरमा धरमरिँदै हिँडे,","poem":1},{"text":"तर प्रशस्त पिउनलाई पानी पाएनन्,","poem":2},{"text":"तापनि तिमीहरू मकहाँ फर्केर आएनौ,”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“धेरै पटक मैले तिमीहरूका बगैँचाहरू र दाखबारीहरूलाई प्रहार गरेँ;","poem":1},{"text":"मैले तिनीहरूलाई रोग र ढुसीले नाश पारेँ।","poem":2},{"text":"सलहहरूले तिमीहरूका नेभारा र जैतुनका रूखहरूलाई सखाप पारिदिए,","poem":1},{"text":"तापनि तिमीहरू मकहाँ फर्केर आएनौ,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“मैले इजिप्टमा पठाएझैँ","poem":1},{"text":"तिमीहरूका बीचमा विपत्तिहरू पठाएँ।","poem":2},{"text":"मैले तिमीहरूका जवान मानिसहरूलाई तरवारले मारेँ","poem":1},{"text":"र तिमीहरूका घोडाहरूसमेत कब्जा गरेँ।","poem":2},{"text":"मैले तिमीहरूका छाउनी मृतक शरीरका दुर्गन्धले भरिदिएँ,","poem":1},{"text":"तापनि तिमीहरू मकहाँ फर्केर आएनौ,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“मैले सदोम र गमोरालाई ध्वस्त पारेजस्तै गरी","poem":1},{"text":"तिमीहरूमध्ये कतिलाई ध्वस्त पारेको छु।","poem":2},{"text":"तिमीहरू जल्दैगरेको आगोबाट निकालिएको अगुल्टोजस्तै थियौ,","poem":1},{"text":"तापनि तिमीहरू मकहाँ फर्केर आएनौ,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“यसकारण हे इस्राएलीहरू हो, म तिमीहरूलाई यसो गर्नेछु;","poem":1},{"text":"किनकि मैले तिमीहरूलाई यसो गर्न लागेको हुनाले,","poem":2},{"lineBreak":true},{"text":"तिमीहरू आफ्ना परमेश्‍वरलाई भेट्न तयार होओ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"जसले पर्वतहरू बनाउनुहुन्छ,","poem":1},{"text":"जसले बतासलाई सृजना गर्नुहुन्छ;","poem":2},{"lineBreak":true},{"text":"अनि उहाँले आफ्ना विचारहरू मानिस जातिलाई प्रकट गर्नुहुन्छ;","poem":2},{"text":"उहाँले नै बिहानीको प्रभातलाई अन्धकारमा परिवर्तन गर्नुहुन्छ,","poem":1},{"text":"र पृथ्वीका अग्ला-अग्ला स्थानहरूमा कुल्चनुहुन्छ;","poem":2},{"lineBreak":true},{"text":"उहाँको नाम याहवेह सेनाहरूका परमेश्‍वर हो।","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"अथवा दिनहरूमा","reference":{"chapter":4,"verse":4}}]},"thisChapterLink":"/api/npi_ncb/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}