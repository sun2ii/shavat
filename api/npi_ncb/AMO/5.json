{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"AMO","translationId":"npi_ncb","name":"आमोस","commonName":"आमोस","title":"आमोसको भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"b9ea96289726beb36d09c05b0f580ff89d979dc99ad43579edc56c1353e6506d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/npi_ncb/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["विलाप र पश्‍चात्तापको निम्ति आह्वान"]},{"type":"verse","number":1,"content":["हे इस्राएलको घराना हो, मैले तिमीहरूका निम्ति गरेको विलापको गीत सुन:"]},{"type":"verse","number":2,"content":[{"text":"“कन्ये इस्राएल फेरि","poem":1},{"text":"कहिल्यै नउठ्ने गरी लडेकी छे;","poem":2},{"text":"आफ्नै देशमा त्यागिएकी छे;","poem":1},{"text":"त्यसलाई उठाउने कोही पनि छैन।”","poem":2}]},{"type":"verse","number":3,"content":["प्रभु याहवेह इस्राएललाई यसो भन्‍नुहुन्छ:",{"text":"“तेरो सहरबाट एक हजार जना सेनाहरू निस्कन्छन्,","poem":1},{"text":"तर केवल एक सय मात्र छोडिनेछन्;","poem":2},{"text":"तेरो सहरबाट एक सय जना सेनाहरू निस्कन्छन्,","poem":1},{"text":"तर केवल दश जना मात्र छोडिनेछन्।”","poem":2}]},{"type":"verse","number":4,"content":["याहवेहले इस्राएलको घरानालाई यसो भन्‍नुहुन्छ:",{"text":"“मलाई खोज र तिमीहरू जीवित रहो;","poem":1}]},{"type":"verse","number":5,"content":[{"text":"बेथेललाई नखोज,","poem":2},{"text":"गिलगालमा नजाओ","poem":1},{"text":"र बेर्शेबातिर यात्रा नगर।","poem":2},{"text":"किनकि गिलगाल निश्‍चय नै निर्वासनमा लगिनेछ;","poem":1},{"text":"अनि बेथेल काम नलाग्ने हुनेछ।”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"याहवेहलाई खोज र जीवित रहो,","poem":1},{"text":"नत्रता उहाँ योसेफको घरानामा आगोजस्तै दन्किएर आउनुहुनेछ;","poem":2},{"text":"जुन आगोले तिनीहरूलाई भस्म पार्नेछ,","poem":1},{"text":"र त्यसलाई निभाउन बेथेलमा कोही पनि हुनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"त्यहाँ न्यायलाई तितो बनाउने,","poem":1},{"text":"र धार्मिकतालाई माटोमा मिलाउने दुवै हुनेछैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"उहाँले किरकिटी र मृगशिरा तारामण्डललाई सृजना गर्नुभयो,","poem":1},{"text":"जसले मध्य रातलाई बिहानीमा र","poem":2},{"lineBreak":true},{"text":"र मध्य दिनलाई रातमा परिवर्तन गर्नुहुन्छ;","poem":2},{"text":"जसले समुद्रको पानीलाई बोलाउनुहुन्छ,","poem":1},{"text":"र ती पानीहरूलाई जमिनमाथि खन्याउनुहुन्छ;","poem":2},{"lineBreak":true},{"text":"उहाँको नाम याहवेह हो।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"उहाँले बलिया किल्‍लाहरूलाई अचानक सर्वनाश गर्नुहुन्छ,","poem":1},{"text":"र बलिया गढ भएको सहरलाई तहसनहस पार्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"तिमीहरू अदालतमा साँचो न्याय गर्नेलाई घृणा गर्छौ,","poem":1},{"text":"र सत्य बोल्नेलाई तुच्छ ठान्छौ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"तिमीहरू गरिबमाथि परालको समेत कर लगाउँछौ,","poem":1},{"text":"र तिनीहरूका अन्‍नमा कर थोपर्छौ।","poem":2},{"text":"यसकारण तिमीहरूले ढुङ्गाका महलहरू बनाएका छौ,","poem":1},{"text":"तर तिमीहरू ती महलहरूमा बस्‍नेछैनौ;","poem":2},{"text":"तिमीहरूले सुन्दर दाखबारी लगाएका छौ,","poem":1},{"text":"तर तिमीहरूले त्यसको दाखरस पिउनेछैनौ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"किनकि म जान्दछु, तिमीहरूका अपराधहरू कति धेरै छन्,","poem":1},{"text":"र तिमीहरूका पापहरू निकै गम्भीर छन्।","poem":2},{"lineBreak":true},{"text":"तिमीहरू जसले धर्मीहरूलाई सताउँछौ र घूस लिन्छौ;","poem":1},{"text":"अनि गरिबलाई अदालतमा न्याय पाउनबाट रोक्छौ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"यसकारण यस्तो समयमा बुद्धिमान् मानिस पनि चुपचाप बस्‍नेछ;","poem":1},{"text":"किनकि समय खराब छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"भलाइको खोजी गर, दुष्‍टताको होइन,","poem":1},{"text":"ताकि तिमीहरू बाँचिरहो।","poem":2},{"text":"तब तिमीहरूले भन्‍ने गरेझैँ,","poem":1},{"text":"याहवेह सेनाहरूका परमेश्‍वर तिमीहरूसँग हुनुहुनेछ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"दुष्‍टतालाई घृणा गर, भलाइलाई प्रेम गर;","poem":1},{"text":"अदालतमा न्यायलाई कायम राख।","poem":2},{"text":"सायद याहवेह सेनाहरूका परमेश्‍वरले","poem":1},{"text":"योसेफका बाँकी रहेकाहरूमाथि अनुग्रह गर्नुहुनेछ।","poem":2}]},{"type":"verse","number":16,"content":["यसकारण याहवेह सेनाहरूका परमेश्‍वर भन्‍नुहुन्छ:",{"text":"“सबै सडकहरूमा रुवाबासी","poem":1},{"text":"र हरेक सार्वजनिक चोकहरूमा वेदनाका रोदनहरू हुनेछन्।","poem":2},{"text":"खेती गर्ने किसानहरूलाई रुन","poem":1},{"text":"र शोक गर्नेहरूलाई विलाप गर्न बोलाइनेछ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"त्यहाँ सबै दाखबारीहरूमा रुवाबासी हुनेछ;","poem":1},{"text":"किनकि म तिमीहरूका बीचबाट भएर जानेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह भन्‍नुहुन्छ।","poem":2}]},{"type":"heading","content":["याहवेहको दिन"]},{"type":"verse","number":18,"content":[{"text":"धिक्‍कार तिमीहरूलाई, जसले","poem":1},{"text":"याहवेहको दिनको तिर्सना गर्दछौ!","poem":2},{"text":"तिमीहरू याहवेहको दिनको किन तिर्सना गर्दछौ?","poem":1},{"text":"त्यो दिन उज्यालो होइन, तर अन्धकारको दिन हुनेछ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"कुनै मानिस सिंहबाट भागेर","poem":1},{"text":"भालुलाई भेटे जस्तै,","poem":2},{"text":"र घरभित्र पस्दा,","poem":1},{"text":"र विश्रामको लागि आफ्नो हात भित्तामा राख्दा","poem":2},{"lineBreak":true},{"text":"त्यसलाई सर्पले डसेजस्तै, त्यो दिन हुनेछ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"हो, याहवेहको दिन उज्यालो होइन, तर अन्धकारमय हुनेछ;","poem":1},{"text":"अर्थात् उज्यालोको किरण विनाको घोर अन्धकार।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“म तिमीहरूका धार्मिक चाडहरूलाई तुच्छ ठान्छु;","poem":1},{"text":"मेरा लागि तिमीहरूका सभाहरू दुर्गन्धजस्तै हो।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तिमीहरूले मेरा निम्ति होमबलि र अन्‍नबलिहरू चढाए पनि,","poem":1},{"text":"म ती बलिहरू ग्रहण गर्नेछैनँ।","poem":2},{"text":"तिमीहरूले अति असल बाछाको मेलबलिहरू चढाए तापनि","poem":1},{"text":"म ती बलिहरूलाई वास्ता गर्नेछैनँ।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तिमीहरूका प्रशंसाको होहल्‍ला मबाट टाढा राख!","poem":1},{"text":"म तिमीहरूका वीणाको सङ्गीत सुन्‍नेछैनँ।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"तर न्याय एउटा नदीझैँ बगोस्,","poem":1},{"text":"र धार्मिकताचाहिँ कहिल्यै नसुक्ने मुहानझैँ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“हे इस्राएलका घराना हो, के तिमीहरूले उजाडस्थानमा चालीस वर्षसम्म","poem":1},{"text":"मेरा निम्ति बलिदानहरू र भेटीहरू चढायौ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"तर तिमीहरूले आफ्ना राज-देव सक्‍कूत,","poem":1},{"text":"र तिमीहरूको तारा-देव कीयूनका","poem":2},{"noteId":2},{"lineBreak":true},{"text":"देवस्थानलाई उचालेका छौ,","poem":2},{"lineBreak":true},{"text":"जसलाई तिमीहरूले आफ्नै निम्ति बनाएका थियौ।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"यसकारण म तिमीहरूलाई दमस्कसभन्दा टाढा निर्वासनमा पठाउनेछु,”","poem":1},{"text":"याहवेह भन्‍नुहुन्छ, जसको नाम सेनाहरूका परमेश्‍वर हो।","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"केही प्राचीन पा.लि.हरूमा मोलेखको थान वा तारा-देव राफान वा तिनीहरूका मूर्तिहरू","reference":{"chapter":5,"verse":26}}]},"thisChapterLink":"/api/npi_ncb/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}