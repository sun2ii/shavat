{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"AMO","translationId":"npi_ncb","name":"आमोस","commonName":"आमोस","title":"आमोसको भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"b9ea96289726beb36d09c05b0f580ff89d979dc99ad43579edc56c1353e6506d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/npi_ncb/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["आत्मसन्तुष्‍ट भएकाहरूलाई धिक्‍कार"]},{"type":"verse","number":1,"content":[{"text":"धिक्‍कार तिमीहरूलाई, जो सियोनमा निर्धक्‍कसाथ बसेका छौ;","poem":1},{"text":"अनि धिक्‍कार तिमीहरूलाई, जो सामरियाको पर्वतमाथि आफूलाई सुरक्षित ठान्छौ;","poem":2},{"text":"धिक्‍कार तिमीहरू प्रमुख राष्ट्रका प्रसिद्ध मानिसहरू,","poem":1},{"text":"जसकहाँ इस्राएलका मानिसहरू आउँछन्!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"कल्नेह सहरमा जाओ र त्यसलाई हेर;","poem":1},{"text":"त्यहाँबाट हमात सहरमा जाओ;","poem":2},{"lineBreak":true},{"text":"अनि तल पलिश्तीको गातमा जाओ।","poem":2},{"text":"के तिमीहरूका दुई राज्यहरूभन्दा ती असल छन् र?","poem":1},{"text":"के तिनीहरूको देश तिमीहरूको भन्दा ठूलो छ र?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिमीहरूले विपत्तिको दिनलाई टाढा पन्छाउँछौ,","poem":1},{"text":"र एउटा आतङ्कको शासन नजिक ल्याउँछौ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिमीहरू हस्तीदन्तले जडेको पलङमा सुत्छौ,","poem":1},{"text":"र सोफाहरूमा ढल्कन्छौ।","poem":2},{"text":"तिमीहरू असल भेडाहरू","poem":1},{"text":"र मोटा बाछाहरू खान्छौ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिमीहरू दावीदले झैँ वीणा बजाउँछौ,","poem":1},{"text":"र सङ्गीतका बाजाहरूमा तत्कालै धुन रच्दछौ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिमीहरू कचौरा भरेर दाखमद्य पिउँछौ,","poem":1},{"text":"र उत्तम सुगन्धित तेलहरू प्रयोग गर्छौ,","poem":2},{"lineBreak":true},{"text":"तर योसेफको विनाशमाथि शोक गर्दैनौ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यसकारण तिमीहरू नै पहिले निर्वासनमा जानेछौ;","poem":1},{"text":"तिमीहरूका भोज र मोजमज्जाहरूको अन्त्य हुनेछ।","poem":2}]},{"type":"heading","content":["याहवेहले इस्राएलको घमण्डलाई घृणा गर्नुहुन्छ"]},{"type":"verse","number":8,"content":["प्रभु याहवेहले आफ्नै नाममा शपथ खानुभएको छ—याहवेह सेनाहरूका परमेश्‍वर घोषणा गर्नुहुन्छ:",{"text":"“म याकोबको घमण्डलाई घृणा गर्छु,","poem":1},{"text":"र त्यसका किल्‍लाहरूलाई घृणा गर्छु;","poem":2},{"text":"म यस सहर र यसमा भएका सबैलाई","poem":1},{"text":"शत्रुको हातमा सुम्पिदिनेछु।”","poem":2}]},{"type":"verse","number":9,"content":["यदि एउटा घरमा दश जना मानिसहरू मात्रै बाँकी रहे तापनि तिनीहरू मर्नेछन्।"]},{"type":"verse","number":10,"content":["यदि लासहरू घरबाट बाहिर निकालेर जलाउन भनी आफन्त आएर त्यहाँ लुकेकाहरूलाई, “तिमीसित अझै कोही छ?” भनी सोध्छ र उसले भन्छ, “अहँ, कोही पनि छैन,” तब त्यसले भन्‍नेछ, “चुप लाग! हामीले याहवेहको नाम लिनुहुँदैन।”"]},{"type":"verse","number":11,"content":[{"text":"किनकि याहवेहले आज्ञा दिनुभएको छ;","poem":1},{"text":"अनि उहाँले विशाल भवनहरूलाई चकनाचुर","poem":2},{"lineBreak":true},{"text":"र साना घरहरूलाई तहसनहस पार्नुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"के घोडाहरू चट्टानहरूमाथि दौडन्छन् र?","poem":1},{"text":"के कसैले समुद्रमा गोरुहरूले जोत्छ र?","poem":2},{"text":"तर तिमीहरूले त न्यायलाई विषमा","poem":1},{"text":"र धार्मिकताका फलचाहिँ तितोमा परिणत गरिदिएका छौ,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"अर्थात् तिमीहरू लो-देबार","poem":1},{"noteId":3},{"text":"सहरलाई जितेकोमा आनन्द मनाउँछौ,","poem":1},{"text":"र भन्छौ, “के हामीले आफ्नै बलले कार्नैम","poem":2},{"noteId":4},{"text":"सहरलाई कब्जा गरेका होइनौँ र?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"किनकि याहवेह सेनाहरूका परमेश्‍वर घोषणा गर्नुहुन्छ,","poem":1},{"text":"“हे इस्राएल, म एउटा देशलाई तिमीहरूका विरुद्धमा उचाल्नेछु;","poem":2},{"text":"त्यसले लेबो-हमातदेखि अराबाको बेँसीसम्मै","poem":1},{"text":"तिमीहरूमाथि अत्याचार गर्नेछ।”","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"जसको अर्थ हो व्यर्थ","reference":{"chapter":6,"verse":13}},{"noteId":4,"caller":"+","text":"कार्नैम जसको अर्थ हो सिङ; शक्तिको प्रतिक।","reference":{"chapter":6,"verse":13}}]},"thisChapterLink":"/api/npi_ncb/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}