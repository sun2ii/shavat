{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"AMO","translationId":"npi_ncb","name":"आमोस","commonName":"आमोस","title":"आमोसको भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"b9ea96289726beb36d09c05b0f580ff89d979dc99ad43579edc56c1353e6506d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/npi_ncb/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["पाकेका फलको डालो"]},{"type":"verse","number":1,"content":["प्रभु याहवेहले मलाई यस्तो देखाउनुभयो: पाकेका फलको एउटा डालो।"]},{"type":"verse","number":2,"content":["उहाँले मलाई सोध्नुभयो, “आमोस, तँ के देख्दैछस्?” मैले जवाफ दिए, “पाकेको फलको एउटा डालो।” त्यसपछि याहवेहले मलाई भन्‍नुभयो, “मेरा मानिस इस्राएलीहरूको समय पूरा भएको छ; म तिनीहरूलाई अब उसो छोड्नेछैनँ।”"]},{"type":"verse","number":3,"content":["प्रभु याहवेहले घोषणा गर्नुहुन्छ, “त्यस दिन मन्दिरका गीतहरू विलापमा परिवर्तन हुनेछन्। जताततै लाशका थुप्रा हुनेछन्! सन्‍नाटा हुनेछ!”"]},{"type":"verse","number":4,"content":[{"text":"खाँचोमा परेकाहरूलाई कुल्चनेहरू,","poem":1},{"text":"हे देशका गरिबहरूलाई त्याग्नेहरू हो, यो कुरा सुन।","poem":2}]},{"type":"verse","number":5,"content":["तिमीहरू यसो भन्छौ,",{"text":"“औँसीको दिन कहिले बित्छ","poem":1},{"text":"र हामी अन्‍न बेच्न सक्छौँ;","poem":2},{"text":"अनि शब्बाथ दिन कहिले समाप्‍त हुन्छ","poem":1},{"text":"र हामी गहुँ बेच्न सक्छौँ?”","poem":2},{"text":"अर्थात् नापतौलमा ठगेर,","poem":1},{"text":"मूल्य बढाएर","poem":2},{"lineBreak":true},{"text":"र छली ढक तराजु चलाएर ठग्न सक्छौँ;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"गरिबलाई चाँदीले,","poem":1},{"text":"र खाँचोमा परेकालाई एक जोडी जुत्तामा किनेर","poem":2},{"lineBreak":true},{"text":"कसिङ्गर सरहको गहुँ बेच्न सक्छौँ।","poem":2}]},{"type":"verse","number":7,"content":["याहवेह आफैँले याकोबको घमण्डको शपथ खानुभएको छ: “म तिनीहरूले गरेका हरेक कुराहरूलाई बिर्सनेछैनँ।"]},{"type":"verse","number":8,"content":[{"text":"“के यसको निम्ति देश काम्दैन र?","poem":1},{"text":"अनि त्यहाँ बस्‍ने सबैले विलाप गर्दैनन् र?","poem":2},{"text":"सारा देश नील नदीझैँ उठ्नेछ;","poem":1},{"text":"इजिप्टको नदीझैँ","poem":2},{"lineBreak":true},{"text":"यो उर्लनेछ र घट्नेछ।”","poem":2}]},{"type":"verse","number":9,"content":["प्रभु याहवेहले घोषणा गर्नुहुन्छ, “त्यस दिन,",{"text":"“म सूर्यलाई मध्यदिनमा नै अस्ताइदिनेछु,","poem":1},{"text":"र दिनको उज्यालोमा नै पृथ्वीलाई अन्धकार तुल्याइदिनेछु।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"म तिमीहरूका धार्मिक चाडहरूलाई रुवाबासीमा","poem":1},{"text":"र तिमीहरूका सबै गीतहरू विलापमा परिवर्तन गरिदिनेछु।","poem":2},{"text":"म तिमीहरू सबैलाई भाङ्ग्राको कपडा पहिरन लगाउनेछु,","poem":1},{"text":"र तिमीहरूका कपाल खौरन लगाउनेछु।","poem":2},{"text":"म त्यस समयलाई एउटै छोराको निम्ति शोक गरेझैँ बनाइदिनेछु,","poem":1},{"text":"र त्यस दिनको अन्त्य सारै तितो हुनेछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"प्रभु याहवेहले घोषणा गर्नुहुन्छ, “ती दिनहरू आउँदैछन्,","poem":1},{"text":"जब म देशमा अनिकाल पठाउनेछु;","poem":2},{"text":"तब अन्‍न अथवा पानीको तिर्खाको अनिकाल होइन,","poem":1},{"text":"तर याहवेहको वचन सुन्‍ने तिर्सनाको अनिकाल हुनेछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"याहवेहको वचनको खोजी गर्दै मानिसहरू,","poem":1},{"text":"एक समुद्रदेखि अर्को समुद्रसम्म भौँतारिँदै हिँड्नेछन्;","poem":2},{"text":"अनि उत्तरदेखि पूर्वसम्म घुमिहिँड्नेछन्,","poem":1},{"text":"तर तिनीहरूले भेट्टाउनेछैनन्।”","poem":2}]},{"type":"verse","number":13,"content":["त्यस दिन,",{"text":"“सुन्दरी युवतीहरू र बलिया युवाहरू","poem":1},{"text":"तिर्खाले मूर्च्छा पर्नेछन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"सामरियाको पापको शपथ खानेहरूले यसो भन्छन्,","poem":1},{"text":"‘तिम्रो देवता दानको जीवनको शपथ,’","poem":2},{"lineBreak":true},{"text":"‘बेर्शेबाको देवताको जीवनको शपथ,’","poem":2},{"lineBreak":true},{"text":"तिनीहरू सबै ढल्नेछन्, फेरि कहिल्यै उठ्न सक्नेछैनन्।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}