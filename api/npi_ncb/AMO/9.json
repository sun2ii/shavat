{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"AMO","translationId":"npi_ncb","name":"आमोस","commonName":"आमोस","title":"आमोसको भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"b9ea96289726beb36d09c05b0f580ff89d979dc99ad43579edc56c1353e6506d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/npi_ncb/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["इस्राएल ध्वस्त पारिनेछ"]},{"type":"verse","number":1,"content":["मैले प्रभुलाई वेदीको छेउमा उभिरहनुभएको देखेँ; अनि उहाँले भन्‍नुभयो:",{"text":"“खम्बाका टुप्पाहरूमा हिर्का,","poem":1},{"text":"ताकि सँघारहरू हल्‍लिऊन्।","poem":2},{"text":"सबै मानिसहरूका टाउकोमाथि ती ढालिऊन्;","poem":1},{"text":"बाँकी बचेकाहरूलाई म तरवारले मार्नेछु।","poem":2},{"text":"एकै जना पनि भाग्न पाउनेछैन;","poem":1},{"text":"एउटै पनि उम्कन पाउनेछैन।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तिनीहरू पातालको गहिराइसम्म गए तापनि","poem":1},{"text":"मेरो हातले तिनीहरूलाई त्यहाँबाट निकाल्नेछ।","poem":2},{"text":"तिनीहरू माथि स्वर्गमा उक्ले तापनि","poem":1},{"text":"म तिनीहरूलाई तल झार्नेछु।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरू कर्मेलको टाकुरामा लुके तापनि","poem":1},{"text":"त्यहाँ म तिनीहरूलाई खोज्नेछु र पक्रिनेछु।","poem":2},{"text":"तिनीहरू मेरो दृष्‍टिबाट समुद्रको पीँधमा लुके तापनि","poem":1},{"text":"त्यहाँ म तिनीहरूलाई डस्‍न सर्पहरूलाई आज्ञा दिनेछु।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरूका शत्रुहरूले तिनीहरूलाई निर्वासनमा लगे तापनि","poem":1},{"text":"त्यहाँ म तिनीहरूलाई मार्न तरवारलाई आज्ञा दिनेछु।","poem":2},{"lineBreak":true},{"text":"“म मेरो नजर तिनीहरूमाथि राख्नेछु,","poem":1},{"text":"भलाइको निम्ति होइन, तर खराबीको निम्ति।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"प्रभु, सेनाहरूका याहवेह,","poem":1},{"lineBreak":true},{"text":"उहाँ जसले पृथ्वीलाई छुनुहुन्छ, र त्यो पग्लन्छ;","poem":1},{"text":"अनि त्यहाँ बस्‍नेहरू सबै विलाप गर्छन्;","poem":2},{"text":"सारा देश नील नदीझैँ माथि उठ्नेछ,","poem":1},{"text":"त्यसपछि इजिप्ट नदीझैँ डुब्नेछ;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"उहाँले आफ्नो भव्य दरबार आकाशमा बनाउनुहुन्छ,","poem":1},{"text":"र यसको जग पृथ्वीमा बसाल्नुहुन्छ;","poem":2},{"text":"उहाँ जसले समुद्रको पानीलाई बोलाउनुहुन्छ,","poem":1},{"text":"र ती पानीलाई जमिनको सतहमाथि खन्याउनुहुन्छ,","poem":2},{"lineBreak":true},{"text":"उहाँको नाम याहवेह हो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“के तिमी इस्राएलीहरू मेरा निम्ति","poem":1},{"text":"कूशका सन्तानजस्ता छैनौ र?”","poem":2},{"lineBreak":true},{"text":"याहवेहले घोषणा गर्नुहुन्छ।","poem":2},{"text":"“के मैले इस्राएललाई इजिप्टबाट,","poem":1},{"text":"पलिश्तीहरूलाई कप्‍तोरबाट,","poem":2},{"lineBreak":true},{"text":"र अरामीहरूलाई कीरबाट निकालेर ल्याएको होइन?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“निश्‍चय नै प्रभु याहवेहको दृष्‍टि","poem":1},{"text":"यो दुष्‍ट राज्यमाथि छ।","poem":2},{"text":"म यसलाई पृथ्वीको","poem":1},{"text":"सतहबाट ध्वस्त गर्नेछु।","poem":2},{"text":"तापनि म याकोबको घरानालाई","poem":1},{"text":"सम्पूर्ण रूपले नाश गर्नेछैनँ,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“किनकि म आज्ञा दिनेछु,","poem":1},{"text":"र इस्राएलको घरानालाई","poem":2},{"lineBreak":true},{"text":"सबै राष्ट्रहरूका बीचमा यसरी हल्‍लाउनेछु,","poem":2},{"text":"जसरी चाल्नीमा अन्‍नलाई चालिन्छ;","poem":1},{"text":"तर एउटा ढुङ्गाको टुक्रा पनि भुइँमा खस्‍नेछैन।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मेरा मानिसहरूका बीचमा भएका","poem":1},{"text":"सबै पापीहरू तरवारले मारिनेछन्;","poem":2},{"text":"तिनीहरू सबै जना, जसले यसो भन्छन्,","poem":1},{"text":"‘विपत्ति हामी नजिक आउनेछैन, न त विपत्तिले हामीलाई छुने नै छ।’","poem":2}]},{"type":"heading","content":["इस्राएलको पुनर्स्थापन"]},{"type":"verse","number":11,"content":["“त्यस दिन,",{"text":"“म दावीदको भत्केको पाललाई फेरि स्थापित गर्नेछु,","poem":1},{"text":"अर्थात् म यसका भत्केका पर्खालहरू मर्मत गर्नेछु;","poem":2},{"lineBreak":true},{"text":"अनि यसका भग्नावशेषहरूलाई फेरि निर्माण गर्नेछु,","poem":2},{"lineBreak":true},{"text":"अर्थात् योजस्तो पहिले थियो, त्यस्तै फेरि निर्माण गर्नेछु,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ताकि तिनीहरूले एदोमका बाँकी बचेकाहरूलाई","poem":1},{"text":"र मेरो नाम लिने सबै राष्ट्रहरूमाथि अधिकार गर्न सकून्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ, जसले यी कुराहरू गर्न सक्नुहुन्छ।","poem":2}]},{"type":"verse","number":13,"content":["याहवेह घोषणा गर्नुहुन्छ, ती दिनहरू आउँदैछन्,",{"text":"“जब जोत्नेले कटनी गर्नेलाई उछिन्‍नेछ,","poem":1},{"text":"र बिउ छर्नेले दाख पेल्नेलाई उछिन्‍नेछ।","poem":2},{"text":"नयाँ दाखमद्य पर्वतहरूबाट चुहुनेछन्,","poem":1},{"text":"र सबै डाँडाहरूबाट ती बग्नेछन्।","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"म मेरो जाति इस्राएललाई निर्वासनबाट फर्काएर ल्याउनेछु।","poem":2},{"lineBreak":true},{"text":"“तिनीहरूले भत्केका सहरहरू फेरि पुनर्निर्माण गर्नेछन्,","poem":1},{"text":"र ती सहरहरूमा बसोबास गर्नेछन्।","poem":2},{"text":"तिनीहरूले दाखबारीहरू लगाउनेछन् र तिनीहरूका दाखमद्य पिउनेछन्;","poem":1},{"text":"तिनीहरूले बगैँचाहरू बनाउनेछन् र त्यहाँका फलहरू खानेछन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"म इस्राएललाई तिनीहरूको आफ्नै देशमा बसाल्नेछु,","poem":1},{"text":"मैले तिनीहरूलाई दिएको","poem":2},{"lineBreak":true},{"text":"देशबाट फेरि कहिल्यै पनि नउखेलिने गरी बसाल्नेछु,”","poem":2},"याहवेह तिमीहरूका परमेश्‍वर यसो भन्‍नुहुन्छ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}