{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"DEU","translationId":"npi_ncb","name":"व्यवस्था","commonName":"व्यवस्था","title":"व्यवस्थाको पुस्तक","order":5,"numberOfChapters":34,"sha256":"9296aa95aa58fa88eb2f2af6ef787cb70404fca5403fa953a339399ace9c0e81","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/npi_ncb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["मोशाले बाह्र कुललाई आशिष् दिएका"]},{"type":"verse","number":1,"content":["परमेश्‍वरका जन मोशाले आफ्नो मृत्युभन्दा अगि इस्राएलीहरूलाई दिएका आशीर्वाद यही हो।"]},{"type":"verse","number":2,"content":["तिनले भने:",{"text":"“याहवेह सीनै पर्वतबाट आउनुभयो,","poem":1},{"text":"र तिनीहरूमाथि सेइरमा झुल्कनुभयो;","poem":2},{"lineBreak":true},{"text":"उहाँ पारान पर्वतबाट चम्कनुभयो।","poem":2},{"text":"उहाँको पर्वतको ओरालो,","poem":1},{"text":"दक्षिणबाट दशौँ हजार पवित्र जनहरूसँग उहाँ आउनुभयो।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"निश्‍चय नै तपाईं, जसले मानिसहरूलाई प्रेम गर्नुहुन्छ;","poem":1},{"text":"सबै पवित्र जनहरू तपाईंका हातमा छन्।","poem":2},{"text":"तिनीहरू सबै तपाईंको पाउमा दण्डवत् गर्नेछन्;","poem":1},{"text":"र तपाईंबाट नै अर्तीहरू प्राप्‍त गर्दछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"याकोबका मानिसहरूका सम्पत्ति भनेको नै","poem":1},{"text":"मोशाले हामीलाई दिएका व्यवस्थाहरू हुन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उहाँ यशूरूनमाथि","poem":1},{"noteId":16},{"text":"राजा हुनुहुन्थ्यो,","poem":1},{"text":"जब इस्राएलका कुलहरूको साथमा","poem":2},{"lineBreak":true},{"text":"मानिसहरूका अगुवाहरू भेला भएका थिए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“रूबेन बाँचिरहून्, र कहिल्यै नमरून्;","poem":1},{"text":"न त त्यसका मानिसहरू थोरै होऊन्।”","poem":2}]},{"type":"verse","number":7,"content":["अनि यहूदाको बारेमा तिनले यो भने:",{"text":"“हे याहवेह यहूदाको पुकार सुन्‍नुहोस्;","poem":1},{"text":"त्यसलाई आफ्ना मानिसहरूकहाँ ल्याउनुहोस्;","poem":2},{"text":"त्यसले आफ्नै हातले आफ्नो रक्षा गर्छ।","poem":1},{"text":"हे प्रभु, त्यसका शत्रुहरूको विरुद्धमा त्यसको सहायक हुनुहोस्!”","poem":2}]},{"type":"verse","number":8,"content":["लेवीको बारेमा तिनले भने:",{"text":"“तपाईंको तुम्मीम र ऊरीम","poem":1},{"text":"तपाईंको विश्‍वासयोग्य सेवकका हुन्।","poem":2},{"text":"तपाईंले त्यसलाई मस्साहमा जाँच्नुभयो;","poem":1},{"text":"तपाईंले त्यससँग मेरीबाको पानीमा लड्नुभयो।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यसले आफ्नो बुबा र आमालाई भन्यो,","poem":1},{"text":"‘म तिनीहरूको कुनै वास्ता गर्दिनँ।’","poem":2},{"text":"त्यसले आफ्ना दाजुभाइहरूलाई चिनेन,","poem":1},{"text":"र आफ्नै छोराछोरीहरूलाई स्वीकार गरेन;","poem":2},{"text":"तर त्यसले तपाईंको वचनमा ध्यान दियो,","poem":1},{"text":"र तपाईंको करारको रक्षा गर्‍यो।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"त्यसले याकोबलाई तपाईंको विधि","poem":1},{"text":"र इस्राएललाई तपाईंको व्यवस्था सिकाउँछ।","poem":2},{"text":"त्यसले तपाईंको सामु धूप","poem":1},{"text":"र तपाईंको वेदीमा सम्पूर्ण होमबलि चढाउँछ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हे याहवेह, त्यसका सबै धनसम्पत्तिहरूमा आशिष् दिनुहोस्,","poem":1},{"text":"र त्यसका हातका परिश्रमहरूमा प्रसन्‍न हुनुहोस्।","poem":2},{"text":"त्यसको विरुद्धमा उठ्ने शत्रुहरूलाई प्रहार गर्नुहोस्,","poem":1},{"text":"र त्यसका शत्रुहरू फेरि कहिल्यै उठ्न नसकून्!”","poem":2}]},{"type":"verse","number":12,"content":["बेन्यामीनको बारेमा तिनले भने:",{"text":"“याहवेहको प्रिय उहाँमा सुरक्षित रहून्;","poem":1},{"text":"किनकि त्यसको दिनभरिको ढाल उहाँ हुनुहुन्छ।","poem":2},{"lineBreak":true},{"text":"अनि याहवेहले प्रेम गर्नुहुनेचाहिँ उहाँका काँधमा विश्राम लिन्छन्।”","poem":2}]},{"type":"verse","number":13,"content":["योसेफको बारेमा तिनले भने:",{"text":"“याहवेहले त्यसको भूमिलाई","poem":1},{"text":"माथि आकाशका बहुमूल्य शीत","poem":2},{"lineBreak":true},{"text":"र तल रहेको गहिरो पानीले आशिष् दिनुहुन्छ;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"सूर्यले ल्याउने उत्तम कुराहरूले,","poem":1},{"text":"र चन्द्रमाबाट प्राप्‍त हुने अति असल कुराहरूले;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"प्राचीन पहाडहरूका मूल्यवान् उपहारहरूले,","poem":1},{"text":"अनि अनन्तका पर्वतहरूको फलदायक परिपूर्णताले;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"पृथ्वीका सर्वोत्तम उपहारहरू र त्यसको प्रसस्ताले,","poem":1},{"text":"अनि जल्दैगरेको पोथ्रामा बास गर्नुहुनेको कृपाले।","poem":2},{"text":"यी सबै योसेफको शिरमाथि,","poem":1},{"text":"तिनका दाजुभाइहरूमध्येका राजकुमारको निधारमा रहून्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"वैभवमा त्यो पहिले जन्मेको साँढेजस्तै छ;","poem":1},{"text":"त्यसका सिङहरू जङ्गली गोरुका सिङहरूझैँ छन्।","poem":2},{"text":"ती सिङहरूद्वारा त्यसले जातिहरूलाई हान्‍नेछ;","poem":1},{"text":"पृथ्वीका अन्तिम भागसम्म रहेकाहरूलाई पनि,","poem":2},{"text":"ती सिङहरू एफ्राइमका दश हजारजस्तै छन्;","poem":1},{"text":"मनश्शेका हजारौँ-हजारझैँ छन्।”","poem":2}]},{"type":"verse","number":18,"content":["जबूलूनको बारेमा तिनले भने:",{"text":"“जबूलून, तँ बाहिर जाँदा आनन्द गर्,","poem":1},{"text":"अनि इस्साखार, तँ आफ्नो पालभित्र आनन्द गर्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तिनीहरूले मानिसहरूलाई पर्वतमा बोलाउनेछन्।","poem":1},{"text":"र त्यहाँ धार्मिकताका बलिदानहरू चढाउनेछन्।","poem":2},{"text":"तिनीहरूले समुद्रका प्रचुरतामा","poem":1},{"text":"र बालुवामा लुकेका गुप्‍त धनमा भोज गर्नेछन्।”","poem":2}]},{"type":"verse","number":20,"content":["गादको बारेमा तिनले भने:",{"text":"“गादको राज्य विस्तार गर्ने जन धन्यको हो!","poem":1},{"text":"गादचाहिँ पाखुरा वा शिर चिथोर्ने","poem":2},{"lineBreak":true},{"text":"सिंहझैँ बस्छ।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"त्यसले आफ्ना निम्ति सबैभन्दा असल ठाउँ छान्यो;","poem":1},{"text":"अगुवाको भाग त्यसका निम्ति राखिएको थियो।","poem":2},{"text":"जब मानिसहरूका मुख्य व्यक्तिहरू भेला भए,","poem":1},{"text":"तब त्यसले याहवेहका धार्मिक इच्छा","poem":2},{"lineBreak":true},{"text":"र इस्राएल सम्बन्धी उहाँका नीति-नियमहरू कार्यान्वयन गरायो।”","poem":2}]},{"type":"verse","number":22,"content":["दानको बारेमा तिनले भने:",{"text":"“दान बाशानबाट उफ्रँदै आउने","poem":1},{"text":"सिंहको डमरुजस्तै हो।”","poem":2}]},{"type":"verse","number":23,"content":["नप्‍तालीको बारेमा तिनले भने:",{"text":"“नप्‍ताली याहवेहको कृपाको प्रशस्ततामा छ,","poem":1},{"text":"र त्यो उहाँको आशिष्‌ले भरिपूर्ण छ।","poem":2},{"lineBreak":true},{"text":"त्यसले गालील तालको दक्षिणतिरको भाग अधिकार गर्नेछ।”","poem":2}]},{"type":"verse","number":24,"content":["आश्शेरको बारेमा तिनले भने:",{"text":"छोराहरूमध्ये सबैभन्दा आशिषित चाहिँ आशेर हो;","poem":1},{"text":"त्यसका दाजुभाइहरूले त्यसमाथि कृपा देखाऊन्;","poem":2},{"lineBreak":true},{"text":"र त्यसले आफ्ना पाउ जैतुनको तेलमा चोपोस्।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तेरा मूलढोकाका आग्लाहरू फलाम र काँसो होऊन्।","poem":1},{"text":"अनि तेरो बलचाहिँ तेरा दिनहरू बराबर होस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"यशूरूनका परमेश्‍वरसमान अरू कोही छैन;","poem":1},{"text":"जो तँलाई सहायता गर्नलाई आकाशबाट आउनुहुन्छ।","poem":2},{"lineBreak":true},{"text":"अनि आफ्नो महिमाको बादलमा सवार गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"अनन्तका परमेश्‍वर तेरो शरणस्थान हुनुहुन्छ,","poem":1},{"text":"र तलतिर चाहिँ अनन्तका बाहुलीहरू तेरो सहारा छन्।","poem":2},{"text":"उहाँले तेरा शत्रुहरूलाई तेरो सामुबाट धपाउनुहुनेछ।","poem":1},{"text":"उहाँले भन्‍नुहुन्छ, “तिनीहरूलाई नष्‍ट पार्!”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"यसकारण इस्राएल सुरक्षित रहनेछ;","poem":1},{"text":"याकोबको मूल सुरक्षित रहनेछ;","poem":2},{"text":"अन्‍न र नयाँ दाखमद्यको देशमा,","poem":1},{"text":"आकाशबाट शीत झर्ने ठाउँमा।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"हे इस्राएल, तँ धन्यको छस्!","poem":1},{"text":"याहवेहद्वारा बचाइएको,","poem":2},{"lineBreak":true},{"text":"तँजस्तो अरू जाति को छ र?","poem":2},{"text":"“उहाँ तेरो ढाल र सहायक,","poem":1},{"text":"अनि तेरा महिमित तरवार हुनुहुन्छ।","poem":2},{"text":"तेरा शत्रुहरू तेरो सामु डराउनेछन्;","poem":1},{"text":"अनि तैँले तिनीहरूका अल्गा स्थानहरू टेक्नेछस्।”","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"यसको अर्थ धर्मी हुन्छ र यसले इस्राएललाई जनाउँदछ; हेर्नुहोस् 26मा पनि।","reference":{"chapter":33,"verse":5}}]},"thisChapterLink":"/api/npi_ncb/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}