{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ECC","translationId":"npi_ncb","name":"उपदेशक","commonName":"उपदेशक","title":"उपदेशकको पुस्तक","order":21,"numberOfChapters":12,"sha256":"c7480da0b30cdfb97c54ac4434a55274a49c8b8aca4ea76a51103b9e6cae7cf1","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/npi_ncb/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["सबै थोक अर्थहीन छन्"]},{"type":"verse","number":1,"content":["दावीदका पुत्र, यरूशलेमका राजा, उपदेशकका",{"noteId":0},"वचनहरू:"]},{"type":"verse","number":2,"content":[{"text":"“अर्थहीन नै अर्थहीन!”","poem":1},{"text":"उपदेशकले भन्दछन्,","poem":2},{"text":"“पूर्ण रूपमा अर्थहीन!","poem":1},{"text":"सबै थोक अर्थहीन हुन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"मानिसहरूले सूर्यमुनि गरेका सबै परिश्रमबाट तिनीहरूलाई","poem":1},{"text":"के नै लाभ हुन्छ र?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पुस्ताहरू आउँछन्, र पुस्ताहरू जान्छन्;","poem":1},{"text":"तर पृथ्वी सदासर्वदा रहिरहन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"सूर्य उदाउँछ, र सूर्य अस्ताउँछ;","poem":1},{"text":"अनि जुन ठाउँबाट उदाएको थियो फेरि हतारिँदै आफ्नै ठाउँतिर फर्किजान्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"बतास दक्षिणतिर बहन्छ,","poem":1},{"text":"र फेरि उत्तरतिर फर्कन्छ;","poem":2},{"text":"त्यो फन्को मार्दै,","poem":1},{"text":"फेरि फन्को मार्दै फर्केर आउँछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"सबै नदीनालाहरू बगेर समुद्रमै जान्छन्,","poem":1},{"text":"र पनि समुद्र कहिल्यै भरिँदैन;","poem":2},{"text":"जुन स्थानबाट ती नदीनालाहरू आउँछन्,","poem":1},{"text":"ती फेरि त्यतैतिर फर्केर जान्छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"सबै थोक विरक्तलाग्दा छन्,","poem":1},{"text":"कसैले ती वर्णन गर्न सक्दैन।","poem":2},{"text":"देखेर आँखा कहिल्यै सन्तुष्‍ट हुँदैन;","poem":1},{"text":"न त सुनेर कान तृप्‍त हुन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जे भएको थियो, त्यही फेरि हुनेछ;","poem":1},{"text":"जे गरिएको थियो, फेरि त्यही गरिनेछ;","poem":2},{"lineBreak":true},{"text":"सूर्यमुनि कुनै कुरा नयाँ छैन।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"के कुनै कुरो यस्तो छ, जसबारे कसैले भन्‍न सक्छ,","poem":1},{"text":"“हेर! योचाहिँ नयाँ कुरा हो?”","poem":2},{"text":"त्यो धेरै पहिलेदेखि नै यहाँ थियो,","poem":1},{"text":"हाम्रो समयभन्दा पनि धेरै पहिलेदेखि।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"विगतका पुस्ताहरूलाई कसैले सम्झनेछैन,","poem":1},{"text":"र आउनेवालाहरूलाई पनि","poem":2},{"text":"कसैले सम्झनेछैन;","poem":1},{"text":"त्यसपछि आउनेहरूले पनि सम्झना गर्नेछैनन्।","poem":2}]},{"type":"heading","content":["बुद्धि पनि अर्थहीन हो"]},{"type":"verse","number":12,"content":["म उपदेशक, यरूशलेममा इस्राएलको राजा थिएँ।"]},{"type":"verse","number":13,"content":["आकाशमुनि जे जति गरिन्छन्, ती सबै बुद्धिद्वारा अध्ययन र अनुसन्धान गर्न भनेर मैले मेरो मनलाई लगाएँ। परमेश्‍वरले मानिस जातिलाई कति कठिन बोझ दिनुभएको छ, ताकि तिनीहरू त्यसैमा अल्झिरहून्।"]},{"type":"verse","number":14,"content":["सूर्यमुनि गरिने सबै काम मैले देखेको छु; ती सबै अर्थहीन हुन्, बतासलाई खेदेको जस्तो मात्र हो।"]},{"type":"verse","number":15,"content":[{"text":"जे बाङ्गो छ, त्यसलाई सीधा पार्न सकिँदैन;","poem":1},{"text":"अनि जे कुरा छँदैछैन, त्यसको गन्ती हुँदैन।","poem":2}]},{"type":"verse","number":16,"content":["मैले मनमनै भनेँ, “हेर, मभन्दा अगि यरूशलेममा राज्य गर्ने सबैले भन्दा धेरै बुद्धि मैले प्राप्‍त गरेको छु; धेरै बुद्धि र ज्ञान मैले अनुभव गरेको छु।”"]},{"type":"verse","number":17,"content":["तब बुद्धि के रहेछ भनी बुझ्नलाई आफ्नो मन लगाएँ; यसै गरी पागलपन र मूर्खतामा पनि; अनि यो पनि बतासलाई खेदेको जस्तो मात्र रहेछ भनी मैले जानेँ।"]},{"type":"verse","number":18,"content":[{"text":"किनकि धेरै बुद्धिले धेरै शोक ल्याउँछ;","poem":1},{"text":"र धेरै ज्ञानले त्यससँगै धेरै कष्‍ट पनि बढाउँछ।","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"अथवा सभाको अध्यक्ष; 2र 12पदमा पनि","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/npi_ncb/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}