{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ECC","translationId":"npi_ncb","name":"उपदेशक","commonName":"उपदेशक","title":"उपदेशकको पुस्तक","order":21,"numberOfChapters":12,"sha256":"c7480da0b30cdfb97c54ac4434a55274a49c8b8aca4ea76a51103b9e6cae7cf1","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/npi_ncb/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["धेरै उद्यममा लगानी गर्नु"]},{"type":"verse","number":1,"content":[{"text":"आफ्नो अन्‍न समुद्रपारि पठाऊ;","poem":1},{"text":"धेरै दिनपछि तिमीले त्यसको नाफा पाउनेछौ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"सात, आठ भागमा लगानी गर;","poem":1},{"text":"किनकि पृथ्वीमाथि के कस्ता विपत्ति आइपर्ला, त्यो तिमी जान्दैनौ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"यदि बादलहरू पानीले भरिएका छन् भने मात्र","poem":1},{"text":"तिनीहरूले पृथ्वीमा पानी बर्साउँछन्।","poem":2},{"text":"रूख चाहे दक्षिणपट्टि वा उत्तरपट्टि ढलोस्,","poem":1},{"text":"त्यो ढलेकै ठाउँमा लडिरहन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जसले बतासको गतिलाई विचार गरिबस्छ, त्यसले कहिल्यै बिउ छर्नेछैन;","poem":1},{"text":"अनि जसले बादलहरू हेरिबस्छ, त्यस मानिसले कटनी गर्नेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"जसरी बतासको बाटो तिमी जान्दैनौ,","poem":1},{"text":"अथवा आमाको गर्भमा बच्‍चा कसरी बन्दछ बुझ्दैनौ;","poem":2},{"text":"त्यसरी नै तिमीले सबै थोक बनाउनुहुने","poem":1},{"text":"परमेश्‍वरका कामहरू बुझ्न सक्दैनौ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"बिहानै तिमीले आफ्नो बिउ छर,","poem":1},{"text":"साँझमा आफ्ना हातहरूलाई अल्छे हुन नदेऊ;","poem":2},{"text":"किनकि कुनचाहिँ सप्रन्छ,","poem":1},{"text":"यो कि त्यो;","poem":2},{"lineBreak":true},{"text":"वा दुवै नै राम्ररी सप्रन्छन्, सो तिमी जान्दैनौ।","poem":2}]},{"type":"heading","content":["युवाअवस्थामा आफ्ना सृष्‍टिकर्ताको सम्झना"]},{"type":"verse","number":7,"content":[{"text":"ज्योति मनमोहक हुन्छ,","poem":1},{"text":"सूर्यलाई देख्दा आँखाहरू प्रसन्‍न हुन्छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मानिस जतिसुकै वर्ष बाँचोस्,","poem":1},{"text":"त्यो ती सबैमा आनन्दित होस्।","poem":2},{"text":"तर अन्धकारका समयहरू पनि","poem":1},{"text":"धेरै हुन्छन् भनी स्मरण गरोस्।","poem":2},{"lineBreak":true},{"text":"जे कुरा हुन आउँछ, सबै अर्थहीन छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"हे जवान मानिस, आफ्नो युवावस्थामा छँदै खुशी होऊ;","poem":1},{"text":"जवान रहुन्जेल तिम्रो हृदयले तिमीलाई आनन्द देओस्।","poem":2},{"text":"आफ्ना हृदयले चाहेको","poem":1},{"text":"र आँखाहरूले देखेका बाटोलाई पछ्याऊ!","poem":2},{"text":"तर याद राख: यी सबै कुराहरूका लागि","poem":1},{"text":"परमेश्‍वरले तिमीलाई लेखा लिनुहुनेछ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"यसकारण अब आफ्ना हृदयबाट चिन्ता-फिक्रीलाई पर राख,","poem":1},{"text":"र शरीरका कष्‍टहरूलाई पनि फ्याँकिदेऊ;","poem":2},{"lineBreak":true},{"text":"किनकि युवावस्था र जोश पनि अर्थहीन हुन्।","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}