{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ECC","translationId":"npi_ncb","name":"उपदेशक","commonName":"उपदेशक","title":"उपदेशकको पुस्तक","order":21,"numberOfChapters":12,"sha256":"c7480da0b30cdfb97c54ac4434a55274a49c8b8aca4ea76a51103b9e6cae7cf1","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/npi_ncb/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"आफ्नो युवाअवस्थामा नै","poem":1},{"text":"आफ्नो सृष्‍टिकर्तालाई सम्झ!","poem":2},{"text":"दुःखको समय र वृद्धावस्था आउनुभन्दा पहिल्यै,","poem":1},{"text":"“यस समयमा मेरो मन लाग्दैन”","poem":2},{"lineBreak":true},{"text":"भन्‍ने वर्षहरू आउनुभन्दा अगि नै—","poem":2}]},{"type":"verse","number":2,"content":[{"text":"सूर्य र प्रकाश,","poem":1},{"text":"चन्द्रमा र ताराहरू अँध्यारो हुन अगि,","poem":2},{"lineBreak":true},{"text":"वर्षापछि बादल फर्कनुभन्दा अगि नै,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जब घरको हेरचाह गर्नेहरू काम्दछन्,","poem":1},{"text":"र बलिया मानिसहरू कुप्रो पर्छन्,","poem":2},{"text":"जाँतोका दाँतहरू झरेर कम भएका कारण जाँतो पिँध्नेहरूले काम बन्द गर्दछन्,","poem":1},{"text":"र झ्यालबाट हेर्नेहरूका आँखा धमिला हुन्छन्;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जब गल्‍लीतिर जाने ढोकाहरू बन्द हुन्छन्,","poem":1},{"text":"र जाँतोको आवाज कम हुँदैजान्छ,","poem":2},{"text":"जब चराको चिरबिर आवाजमा मानिसहरू उठ्छन्,","poem":1},{"text":"तर तिनीहरूका सबै गीत मधुरो हुन्छन्;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जब मानिसहरू अग्लो ठाउँसित","poem":1},{"text":"र बाटाका खतरासित डराउँछन्,","poem":2},{"text":"जब हाडे-बदामका बोटमा सेतै फूल फुल्दछन्,","poem":1},{"text":"र फट्याङ्ग्राले आफैँलाई घिसारेर हिँड्दछ,","poem":2},{"lineBreak":true},{"text":"अनि मनको चाहना अब उसो जाग्दैन;","poem":2},{"text":"किनकि मानिस आफ्ना अनन्तको घरमा जान्छन्,","poem":1},{"text":"अनि शोक गर्ने मलामीहरू गल्‍लीमा यताउता लाग्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"आफ्नो सृष्‍टिकर्तालाई सम्झ—चाँदीका तार चुँडिनुअगि,","poem":1},{"text":"र सुनको कचौरा फुट्नुअगि,","poem":2},{"text":"पँधेरामा गाग्रो फुट्नुअगि","poem":1},{"text":"र इनारमा चक्‍का भाँचिनुअगि,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"धुलो माटैमा फर्केर जानुअगि,","poem":1},{"text":"र आत्मा परमेश्‍वरकहाँ फर्किजानेछ; जसले त्यो दिनुभयो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“अर्थहीन! अर्थहीन!” उपदेशक भन्दछन्।","poem":1},{"text":"“सबै अर्थहीन छन्!”","poem":2}]},{"type":"heading","content":["उपदेशकको निष्कर्ष"]},{"type":"verse","number":9,"content":["उपदेशक बुद्धिमान् मात्र थिएनन्, तिनले मानिसहरूलाई ज्ञानका कुरा पनि सिकाउँथे। तिनले विचार गरे, खोजी गरेर धेरै हितोपदेशहरू क्रमबद्ध रूपमा राखे।"]},{"type":"verse","number":10,"content":["तिनले ठिक वचनहरू खोजी गरे, र जे लेखिए, ती वास्तविक र सत्य थिए।"]},{"type":"verse","number":11,"content":["बुद्धिमान्‌का वचनहरू गोठालोको लहुराजस्तै छन्। तिनीहरूले सङ्कलन गरेका भनाइहरू ठिकसित ठोकेका किलाझैँ छन्—ती एउटै गोठालोबाट प्राप्‍त भएका हुन्।"]},{"type":"verse","number":12,"content":["हे मेरा छोराछोरीहरू हो, यीबाहेक अरू कुरामा पनि होसियार होओ! किनकि धेरै पुस्तकहरूको लेखाइको अन्त्य छैन; अनि धेरै अध्ययनले शरीरलाई थकाउँछ।"]},{"type":"verse","number":13,"content":[{"text":"अब जति पनि सुनियो:","poem":1},{"text":"सबै कुराको निष्कर्ष यही हो:","poem":2},{"text":"परमेश्‍वरको भय मान र उहाँका आज्ञापालन गर;","poem":1},{"text":"किनकि समस्त मानव-जातिको कर्तव्य यही हो।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"किनकि परमेश्‍वरले हामीले गरेका हरेक कामको न्याय गर्नुहुनेछ,","poem":1},{"text":"प्रत्येक गुप्‍त कुरासमेत,","poem":2},{"lineBreak":true},{"text":"चाहे त्यो असल होस् वा खराब।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}