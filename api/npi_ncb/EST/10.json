{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"EST","translationId":"npi_ncb","name":"एस्तर","commonName":"एस्तर","title":"एस्तरको पुस्तक","order":17,"numberOfChapters":10,"sha256":"0f7ec37be2809e4de892819db91b19f07dce2c29a800ec231d26c81dacf441c4","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/npi_ncb/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"heading","content":["मोर्दकैको महानता"]},{"type":"verse","number":1,"content":["राजा अहासूरसले राज्यभरि अन्तिम सिमानासम्म राजकर तिर्न लगाए।"]},{"type":"verse","number":2,"content":["अनि तिनको शक्ति र पराक्रमका सबै कामहरू, राजाले मोर्दकैलाई पदोन्‍नति गरेका कुराहरू, साथै तिनको महानताका सम्पूर्ण विवरणहरू, मादी र परसीयाका राजाहरूका इतिहासका पुस्तकहरूमा लेखिएका छन्।"]},{"type":"verse","number":3,"content":["यहूदी मोर्दकै, राजा अहासूरसपछि दोस्रो दर्जामा थिए। यहूदीहरूका बीचमा सर्वश्रेष्‍ठ र आफ्ना सबै यहूदीहरूद्वारा सम्मानित थिए; किनकि तिनले आफ्ना मानिसहरूका भलाइको काम गरेका थिए, र सारा यहूदीहरूको भलाइका निम्ति बोलेका थिए।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}