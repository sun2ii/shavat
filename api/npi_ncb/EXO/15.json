{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"EXO","translationId":"npi_ncb","name":"प्रस्थान","commonName":"प्रस्थान","title":"प्रस्थानको पुस्तक","order":2,"numberOfChapters":40,"sha256":"55015b276eba1a043e86a4a06c715b2d657a2866b323a9b838cd619b3019e13c","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/npi_ncb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["मोशा र मिरियमको गीत"]},{"type":"verse","number":1,"content":["तब मोशा र इस्राएलीहरूले याहवेहका निम्ति यो गीत गाए:",{"text":"“म याहवेहको निम्ति गाउनेछु;","poem":1},{"text":"किनकि उहाँ अति नै उच्‍च पारिनुभएको छ।","poem":2},{"text":"घोडा र त्यसको सवारलाई","poem":1},{"text":"उहाँले समुद्रमा फालिदिनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“याहवेह नै मेरो बल, सुरक्षा र गीत","poem":1},{"noteId":12},{"text":"हुनुहुन्छ;","poem":1},{"text":"उहाँ मेरा मुक्ति हुनुभएको छ।","poem":2},{"text":"उहाँ मेरा परमेश्‍वर हुनुहुन्छ, र म उहाँको प्रशंसा गर्नेछु;","poem":1},{"text":"मेरा पिताका परमेश्‍वर, र म उहाँको नामलाई उच्‍च पार्नेछु।”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"याहवेह योद्धा हुनुहुन्छ;","poem":1},{"text":"उहाँको नाम याहवेह हो।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"फारोका रथहरू र तिनका सेनालाई","poem":1},{"text":"उहाँले समुद्रमा फालिदिनुभएको छ।","poem":2},{"text":"फारोका सर्वोत्तम पदाधिकारीहरू","poem":1},{"text":"लाल समुद्रमा डुबाइएका छन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"गहिरा पानीले तिनीहरूलाई छोपिदिएका छन्;","poem":1},{"text":"तिनीहरू ढुङ्गाझैँ गहिराइमा डुबेका छन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"हे याहवेह, तपाईंको दाहिने हात,","poem":1},{"text":"शक्तिमा गौरवशाली थियो।","poem":2},{"text":"हे याहवेह, तपाईंको दाहिने हातले,","poem":1},{"text":"शत्रुलाई चकनाचुर पारेको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“तपाईंका गौरवको महानतामा","poem":1},{"text":"तपाईंले विरोधीहरूलाई फ्याँकिदिनुभएको छ।","poem":2},{"text":"तपाईंले आफ्नो क्रोधको ज्वाला पोख्नुभयो;","poem":1},{"text":"जसले तिनीहरूलाई परालझैँ भस्म पार्‍यो।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तपाईंका नाकको सासको वेगले","poem":1},{"text":"पानी एक ठाउँमा थुप्रो लाग्यो,","poem":2},{"text":"तरङ्गले भरिएका पानीहरू दृढ पर्खालझैँ खडा भए;","poem":1},{"text":"गहिरो पानी समुद्रको गहिराइमा जमिहाल्यो।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"शत्रुले घमण्ड गर्‍यो,","poem":1},{"text":"‘म तिनीहरूलाई खेद्नेछु, म तिनीहरूलाई भेट्नेछु।","poem":2},{"text":"म लुटिएका सामानहरू बाँड्नेछु;","poem":1},{"text":"म तिनीहरूलाई निल्नेछु।","poem":2},{"text":"म आफ्नो तरवार थुत्नेछु,","poem":1},{"text":"र मेरो हातले तिनीहरूलाई नाश पार्नेछु।’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तर तपाईंले आफ्नो सास फुक्नुभयो;","poem":1},{"text":"र समुद्रले तिनीहरूलाई ढाकिहाल्यो।","poem":2},{"text":"तिनीहरू शक्तिशाली पानीमा","poem":1},{"text":"सिसाझैँ डुबे।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हे याहवेह,","poem":1},{"text":"देवी-देवताहरूमा तपाईंजस्तो को छ र?","poem":2},{"text":"पवित्रतामा अति गौरवशाली,","poem":1},{"text":"महिमामा भययोग्य,","poem":2},{"text":"र अद्‌भुत कार्यहरू गर्नुहुने अरू को छ र?","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“तपाईंले आफ्नो दाहिने हात पसार्नुभयो;","poem":1},{"text":"अनि पृथ्वीले हाम्रा शत्रुहरूलाई निलिहाल्यो।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तपाईंले आफ्नो अचुक प्रेममा,","poem":1},{"text":"आफूले छुटाउनुभएका मानिसहरूलाई डोर्‍याउनुहुनेछ।","poem":2},{"text":"तपाईंको शक्तिमा तपाईंले तिनीहरूलाई","poem":1},{"text":"आफ्नो पवित्र वासस्थानमा अगुवाइ गर्नुहुनेछ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जातिहरूले सुन्‍नेछन् र काँप्नेछन्;","poem":1},{"text":"पलिश्तीहरूलाई वेदनाले पक्रनेछ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"एदोमका अगुवाहरू भयभीत हुनेछन्;","poem":1},{"text":"मोआबका शक्तिशाली अगुवाहरू काँप्नेछन्;","poem":2},{"text":"कनानका सारा मानिसहरू","poem":1},{"noteId":13},{"text":"बिलाइजानेछन्;","poem":1}]},{"type":"verse","number":16,"content":[{"text":"उनीहरूलाई आतङ्क र डरले छोप्नेछ।","poem":2},{"text":"हे याहवेह, तपाईंका प्रजा पार नहोउन्जेल,","poem":1},{"text":"तपाईंले किन्‍नुभएका","poem":2},{"noteId":14},{"text":"यी प्रजा पार नहोउन्जेल—","poem":2},{"text":"तपाईंका पाखुराको शक्तिले","poem":1},{"text":"उनीहरू पत्थरझैँ अचल हुनेछन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तपाईंले तिनीहरूलाई भित्र ल्याउनुहुनेछ र","poem":1},{"text":"तपाईंको आफ्नो उत्तराधिकारको पर्वतमा रोप्नुहुनेछ—","poem":2},{"text":"हे याहवेह, त्यो ठाउँ, जसलाई तपाईंले आफ्नो लागि वासस्थान बनाउनुभएको छ;","poem":1},{"text":"त्यो समागम पालमा, हे प्रभु, जसलाई तपाईंका हातहरूले स्थापित गर्नुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“याहवेहले सदासर्वदा","poem":1},{"text":"राज्य गर्नुहुन्छ।”","poem":2}]},{"type":"verse","number":19,"content":["जब फारोका घोडा, रथ र घोडसवारहरू समुद्रभित्र पसे, तब याहवेहले समुद्रको पानी फर्काएर तिनीहरूमाथि ल्याइदिनुभयो; तर इस्राएलीहरू त समुद्रको बीचबाट ओबानो जमिनमाथि हिँडे।"]},{"type":"verse","number":20,"content":["तब हारूनकी दिदी अगमवादिनी मिरियमले आफ्नो हातमा एउटा खैँजडी लिइन्; अनि अरू स्त्रीहरू पनि खैँजडी लिएर नाच्दै तिनको पछि-पछि लागे।"]},{"type":"verse","number":21,"content":["मिरियमले यसरी गीत गाउन थालिन्:",{"text":"“याहवेहका निम्ति गाओ;","poem":1},{"text":"किनकि उहाँ अति उच्‍च पारिनुभएको छ।","poem":2},{"text":"घोडा र त्यसको सवार दुवैलाई","poem":1},{"text":"उहाँले समुद्रमा फालिदिनुभएको छ।”","poem":2}]},{"type":"heading","content":["मारा र एलीमको पानी"]},{"type":"verse","number":22,"content":["तब मोशाले इस्राएललाई लाल समुद्रबाट लगे, र तिनीहरू शूरको उजाडस्‍थानभित्र पसे। तीन दिनसम्म तिनीहरू उजाडस्थानमा पिउने पानीविना यात्रा गरे।"]},{"type":"verse","number":23,"content":["जब तिनीहरू मारा आइपुगे, तिनीहरूले त्यहाँको पानी पिउन सकेनन्; किनकि त्यो तितो थियो। (त्यसैकारण त्यस ठाउँलाई मारा",{"noteId":15},"भनिन्छ।)"]},{"type":"verse","number":24,"content":["यसकारण मानिसहरू मोशाको विरुद्धमा यसो भन्दै गनगन गर्न थाले, “हामीले के पिऔँ?”"]},{"type":"verse","number":25,"content":["तब मोशाले याहवेहलाई पुकारे; अनि याहवेहले तिनलाई एउटा काठको टुक्रा देखाउनुभयो। जब तिनले त्यसलाई पानीमा फाले, तब त्यो पानी मिठो भयो। त्यहाँ याहवेहले तिनीहरूका निम्ति एउटा नियम र निर्देशन बनाउनुभयो; अनि त्यहीँ नै उहाँले तिनीहरूको जाँच लिनुभयो।"]},{"type":"verse","number":26,"content":["उहाँले भन्‍नुभयो, “तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरको कुरा ध्यानसित सुन्यौँ र उहाँको दृष्‍टिमा जे ठिक छ, त्यही गर्‍यौ, र तिमीहरूले उहाँका आज्ञाहरूमा ध्यान दियौ, र उहाँका सबै उर्दीहरू पालन गर्‍यौ भने मैले इजिप्टियनहरूमाथि ल्याएका रोगहरू म तिमीहरूमाथि ल्याउनेछैनँ; किनकि तिमीहरूलाई निको पार्ने याहवेह म नै हुँ।”"]},{"type":"verse","number":27,"content":["त्यसपछि तिनीहरू एलीममा आइपुगे, जहाँ बाह्र वटा पानीका मूल र सत्तरी वटा खजूरका रूखहरू थिए। तिनीहरूले त्यहीँ पानीको नजिक पाल टाँगे।"]}],"footnotes":[{"noteId":12,"caller":"+","text":"अथवा सुरक्षा","reference":{"chapter":15,"verse":2}},{"noteId":13,"caller":"+","text":"अथवा शासकहरू","reference":{"chapter":15,"verse":15}},{"noteId":14,"caller":"+","text":"अथवा सृजनुभएका","reference":{"chapter":15,"verse":16}},{"noteId":15,"caller":"+","text":"मारा जसको अर्थ तितो हुन्छ।","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/npi_ncb/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}