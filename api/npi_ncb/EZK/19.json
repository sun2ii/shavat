{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"EZK","translationId":"npi_ncb","name":"इजकिएल","commonName":"इजकिएल","title":"इजकिएलको भविष्यवाणी","order":26,"numberOfChapters":48,"sha256":"ab6a110a2b21652f118e0ae033e83b3d0c9ce242aae075a3773f203a476b0c3f","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/npi_ncb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["इस्राएलका राजकुमारहरूका निम्ति विलाप"]},{"type":"verse","number":1,"content":["“इस्राएलका राजकुमारहरूका निम्ति एउटा विलापको गीत सुना,"]},{"type":"verse","number":2,"content":["र भन्:",{"text":"“सिंहहरूमध्ये तेरी आमा","poem":1},{"text":"कस्ती सिंहिनी थिई!","poem":2},{"text":"जवान सिंहहरूको बीचमा बसेर","poem":1},{"text":"त्यसले आफ्ना डमरुहरूलाई हुर्काई।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्यसले आफ्ना डमरुहरूमध्ये एउटालाई हुर्काई;","poem":1},{"text":"अनि त्यो एउटा बलियो सिंह भयो।","poem":2},{"text":"त्यसले शिकारलाई फहराउन जान्यो,","poem":1},{"text":"र त्यसले मानिसहरूलाई खान थाल्यो।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जाति-जातिहरूले त्यसको बारेमा सुने,","poem":1},{"text":"र त्यो तिनीहरूको खाडलको पासोमा पर्‍यो।","poem":2},{"text":"तिनीहरूले त्यसलाई अङ्कुसेले तानेर","poem":1},{"text":"इजिप्ट देशमा लगे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘जब त्यस सिंहिनीले आफ्नो आशा पूरा नभएको,","poem":1},{"text":"आफ्नो अपेक्षा टुटेको देखी;","poem":2},{"text":"तब त्यसले आफ्ना डमरुहरूमध्ये अर्को एउटालाई लिई","poem":1},{"text":"र त्यसलाई एउटा बलियो सिंह बनाई।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"त्यो सिंहहरूको बीचमा शिकारको खोजीमा यताउता हिँड्‍डुल गर्न थाल्यो;","poem":1},{"text":"किनकि अब त्यो एउटा बलवान् सिंह भएको थियो।","poem":2},{"text":"त्यसले शिकारलाई फहराउन जान्यो,","poem":1},{"text":"र त्यो मानिस खाने भयो।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्यसले तिनीहरूका बलियो किल्‍लाहरू भत्काइदियो,","poem":1},{"text":"र तिनीहरूका सहरहरू ध्वस्त पारिदियो।","poem":2},{"text":"देश र त्यसमा भएका सबै जना","poem":1},{"text":"त्यसको गर्जनद्वारा त्रसित भए।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तब त्यसको चारैतिर भएका","poem":1},{"text":"जाति-जातिहरू त्यसको विरुद्धमा आए।","poem":2},{"text":"तिनीहरूले त्यसको विरुद्धमा तिनीहरूका जाल फिँजाए,","poem":1},{"text":"र त्यो तिनीहरूको खाडलको पासोमा फस्यो।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरूले त्यसलाई अङ्कुसेले तानेर खोरमा हाले","poem":1},{"text":"र त्यसलाई बेबिलोनका राजाकहाँ ल्याए।","poem":2},{"text":"तिनीहरूले त्यसलाई थुनेर राखे।","poem":1},{"text":"त्यसैले त्यसको गर्जन इस्राएलका","poem":2},{"lineBreak":true},{"text":"पर्वतहरूमा फेरि सुनिएन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘पानीको छेउमा रोपिएको तेरो दाखबारीको","poem":1},{"text":"दाखको बोटजस्तै तेरी आमा थिई;","poem":2},{"text":"प्रशस्त पानी भएको कारण","poem":1},{"text":"त्यो फलदायक र हाँगाहरूले भरिएको थियो।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यसका हाँगाहरू बलिया थिए,","poem":1},{"text":"र शासकको राजदण्डको निम्ति योग्यका थिए।","poem":2},{"text":"बाक्ला पातहरूमाथि","poem":1},{"text":"त्यो अग्लो बोट भएर बढ्यो;","poem":2},{"text":"अनि त्यसका हाँगाहरू धेरै थिए,","poem":1},{"text":"र त्यो उचाइमा अग्लो देखिन्थ्यो।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तर क्रोधमा त्यो उखेलियो,","poem":1},{"text":"र जमिनमा त्यो फ्याँकियो।","poem":2},{"text":"अनि पूर्वीय बतासले त्यसलाई सुकाइदियो,","poem":1},{"text":"र त्यसका फलहरू सबै झारिदियो;","poem":2},{"text":"त्यसका बलिया हाँगाहरू सुकिहाले,","poem":1},{"text":"र आगोले ती भस्म पार्‍यो।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"अब त त्यो सुक्खा र पानी नभएको ठाउँ,","poem":1},{"text":"मरुभूमिमा रोपिएको छ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"त्यसका मुख्य हाँगाहरूमध्ये एउटाबाट आगो फैलियो","poem":1},{"text":"र त्यसका फलहरूलाई भस्म पारिदियो।","poem":2},{"text":"शासकको राजदण्डको निम्ति योग्य,","poem":1},{"text":"कुनै पनि बलियो हाँगा त्यसमा छोडिएन।’","poem":2},"यो एक विलापको गीत हो, र यो विलापको गीतको रूपमा प्रयोग हुनुपर्छ।”"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}