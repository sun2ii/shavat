{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"EZK","translationId":"npi_ncb","name":"इजकिएल","commonName":"इजकिएल","title":"इजकिएलको भविष्यवाणी","order":26,"numberOfChapters":48,"sha256":"ab6a110a2b21652f118e0ae033e83b3d0c9ce242aae075a3773f203a476b0c3f","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/npi_ncb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["टायरको राजाको विरुद्धमा अगमवाणी"]},{"type":"verse","number":1,"content":["याहवेहको वचन मकहाँ आयो:"]},{"type":"verse","number":2,"content":["“हे मानिसको छोरा, टायरको शासकलाई भन्, ‘प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘आफ्नो हृदयको घमण्डमा","poem":1},{"text":"तैँले भन्छस्, “म एक ईश्‍वर हुँ;","poem":2},{"text":"म समुद्रको बीचमा","poem":1},{"text":"एक ईश्‍वरको सिंहासनमा बस्छु।”","poem":2},{"text":"तर तँ एउटा साधारण मानिस मात्र होस्, ईश्‍वर होइनस्;","poem":1},{"text":"यद्यपि तैँले आफूलाई ईश्‍वर जत्तिकै बुद्धिमान् सम्झन्छस्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"के तँ दानिएलभन्दा","poem":1},{"noteId":17},{"text":"बुद्धिमान् छस्?","poem":1},{"text":"के तँबाट कुनै पनि रहस्य लुकेको छैन?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तेरो बुद्धि र समझशक्तिद्वारा","poem":1},{"text":"तैँले आफ्नै निम्ति धनसम्पत्ति कमाएको छस्,","poem":2},{"text":"र तेरो भण्डारमा आफ्नो निम्ति","poem":1},{"text":"सुन र चाँदी थुपारेको छस्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तेरो व्यापारको धेरै सिपहरूद्वारा","poem":1},{"text":"तैँले आफ्नो धनसम्पत्ति बढाएको छस्;","poem":2},{"text":"अनि तेरो धनसम्पत्तिको कारण","poem":1},{"text":"तेरो हृदय घमण्डले फुलेको छ।","poem":2}]},{"type":"verse","number":6,"content":["“ ‘यसकारण प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘किनकि तैँले आफूलाई ईश्‍वर जत्तिकै","poem":1},{"text":"बुद्धिमान् सम्झन्छस्;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यसैकारण म जातिहरूमध्ये","poem":1},{"text":"सबैभन्दा निष्‍ठुर विदेशीहरूलाई तेरो विरुद्धमा ल्याउनेछु;","poem":2},{"text":"तिनीहरूले तेरो सुन्दरता र बुद्धिको विरुद्धमा आफ्नो तरवार निकाल्नेछन्,","poem":1},{"text":"र तेरो चम्किलो गौरवलाई छेड्नेछन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरूले तँलाई तल खाडलमा ल्याउनेछन्;","poem":1},{"text":"अनि समुद्रको बीचमा तेरो मरण","poem":2},{"lineBreak":true},{"text":"एक हिंसक मृत्यु हुनेछ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यस बेला तँलाई मार्नेहरूको उपस्थितिमा,","poem":1},{"text":"“म ईश्‍वर हुँ” भनी के तैँले भन्‍नेछस्?","poem":2},{"text":"तँलाई मार्नेहरूको हातमा तँ ईश्‍वर होइनस्,","poem":1},{"text":"तर एउटा मरणशील मानिस मात्र हुनेछस्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तँ परदेशीहरूको हातमा","poem":1},{"text":"एउटा खतना नभएको मानिसजस्तै मर्नेछस्।","poem":2},"किनकि मैले नै यो भनेको हुँ, प्रभु याहवेह घोषणा गर्नुहुन्छ।’ ”"]},{"type":"line_break"},{"type":"verse","number":11,"content":["याहवेहको यो वचन मकहाँ आयो:"]},{"type":"verse","number":12,"content":["“हे मानिसको छोरा, टायरका राजाको बारेमा एउटा विलाप गीत गा, र त्यसलाई भन्: ‘प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘तँ पूर्णताको नमुना,","poem":1},{"text":"बुद्धिले भरिपूर्ण र सुन्दरतामा सिद्ध थिइस्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तँ परमेश्‍वरको बगैँचा","poem":1},{"text":"अदनमा थिइस्;","poem":2},{"text":"सबै प्रकारका बहुमूल्य पत्थरले तँ आभूषित थिइस्:","poem":1},{"text":"माणिक, पुष्पराज, हीरा,","poem":2},{"lineBreak":true},{"text":"फिरोजा, गोमेद र स्फटिक,","poem":2},{"lineBreak":true},{"text":"नीलमणि, हरितमणि र बहुमूल्य पत्थरले सजिएको थिइस्।","poem":2},{"text":"तेरा गरगहनाहरू सुनले बनिएका थिए;","poem":1},{"text":"तँ सृष्‍टि गरिएको दिनमा नै ती चीजहरू तयार गरिएका थिए।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"अभिभावक करूबको रूपमा तँ अभिषेक गरिएको थिइस्;","poem":1},{"text":"किनकि मैले तँलाई नियुक्त गरेको थिएँ;","poem":2},{"text":"तँ परमेश्‍वरको पवित्र पर्वतमा थिइस्;","poem":1},{"text":"तँ आगोजस्तै चम्किलो पत्थरहरूको बीचमा हिँड्थिस्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तँ सृष्‍टि गरिएको दिनदेखि","poem":1},{"text":"तँमा दुष्‍टता नपाउन्जेलसम्म","poem":2},{"lineBreak":true},{"text":"तँ आफ्ना चालहरूमा निर्दोष थिइस्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तेरो चौतर्फी फैलिएको व्यापारद्वारा","poem":1},{"text":"तँ अत्याचारले भरिइस्;","poem":2},{"lineBreak":true},{"text":"अनि तैँले पाप गरिस्।","poem":2},{"text":"यसकारण मैले तँलाई परमेश्‍वरको पर्वतबाट अपमानित गरेर धपाइदिएँ;","poem":1},{"text":"अनि हे अभिभावक करूब, मैले तँलाई","poem":2},{"lineBreak":true},{"text":"ती आगोजस्तै चम्किलो पत्थरहरूको बीचबाट निकालिदिएँ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तेरो सुन्दरताको कारण","poem":1},{"text":"तेरो हृदय घमण्डी भयो;","poem":2},{"text":"अनि आफ्नो गौरवको कारण","poem":1},{"text":"तैँले आफ्नो बुद्धिलाई भ्रष्‍ट पारिस्।","poem":2},{"text":"यसकारण मैले तँलाई पृथ्वीमा फ्याँकिदिएँ;","poem":1},{"text":"मैले तँलाई राजाहरूको सामु एक तमाशा बनाइदिएँ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तेरा धेरै पापहरू र बेइमान व्यापारद्वारा","poem":1},{"text":"तैँले आफ्ना पवित्रस्थानहरू अपवित्र बनाएको छस्।","poem":2},{"text":"यसकारण मैले टायरको बीचबाट आगो निस्कन दिएँ,","poem":1},{"text":"र त्यस आगोले तँलाई भस्म पारिदियो;","poem":2},{"text":"मैले तँलाई भुइँमा खरानी तुल्याएँ,","poem":1},{"text":"ती सबै मानिसहरूको आँखाको अगाडि, जसले तँलाई हेरिरहेका थिए।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तँलाई चिन्‍ने सबै राष्ट्रहरू","poem":1},{"text":"तँलाई देखेर भयभीत भए;","poem":2},{"text":"तँ डरलाग्दो अन्त्यमा आइपुगेको छस्,","poem":1},{"text":"र तेरो अस्तित्व अब रहनेछैन।’ ”","poem":2}]},{"type":"heading","content":["सीदोनको विरुद्धमा अगमवाणी"]},{"type":"verse","number":20,"content":["याहवेहको यो वचन मकहाँ आयो:"]},{"type":"verse","number":21,"content":["“हे मानिसको छोरा, तेरो अनुहार सीदोनको विरुद्धमा फर्का,"]},{"type":"verse","number":22,"content":["र भन्, ‘प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘हे सीदोन, म तेरो विरुद्धमा छु,","poem":1},{"text":"र तेरो बीचमा म आफ्नो महिमा प्रकट गर्नेछु।","poem":2},{"text":"जब म तँलाई दण्ड दिन्छु,","poem":1},{"text":"र तेरै सामु आफूलाई पवित्र प्रमाणित गर्छु,","poem":2},{"lineBreak":true},{"text":"तब म नै याहवेह हुँ भनी तैँले जान्‍नेछस्।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"म तँमाथि महामारी पठाउनेछु,","poem":1},{"text":"र तेरा सडकहरूमा रगत बग्न दिनेछु।","poem":2},{"text":"तेरो विरुद्धमा चारैतिर भएको तरवारले","poem":1},{"text":"तेरै बीचमा मरिएकाहरू ढल्नेछन्।","poem":2},{"text":"तब म नै याहवेह हुँ भनी तैँले जान्‍नेछस्।","poem":1}]},{"type":"verse","number":24,"content":["“ ‘अब उप्रान्त इस्राएलका मानिसहरूसँग तिनीहरूलाई घृणा गर्ने छिमेकीहरू हुनेछैनन्, जो सिउँडी काँडा र तीखा काँडाहरू हुन्। तब म नै प्रभु याहवेह हुँ भनी तिनीहरूले जान्‍नेछन्।"]},{"type":"verse","number":25,"content":["“ ‘प्रभु याहवेह यसो भन्‍नुहुन्छ: जब म इस्राएलका मानिसहरूलाई तिनीहरू तितरबितर भएका राष्ट्रहरूबाट भेला गर्छु, म जाति-जातिहरूका दृष्‍टिमा तिनीहरूद्वारा पवित्र प्रमाणित हुनेछु। तब तिनीहरू तिनीहरूका आफ्नै देशमा बस्‍नेछन्, जुन देश मैले आफ्नो सेवक याकोबलाई दिएको थिएँ।"]},{"type":"verse","number":26,"content":["त्यहाँ तिनीहरू सुरक्षित बस्‍नेछन्, घरहरू बनाउनेछन् र दाखबारीहरू लगाउनेछन्; जब म इस्राएलीहरूलाई बदनाम गर्ने तिनीहरूका ती सबै छिमेकीहरूलाई दण्ड दिनेछु, तब म नै याहवेह तिनीहरूका परमेश्‍वर हुँ भनी तिनीहरूले जान्‍नेछन्।’ ”"]}],"footnotes":[{"noteId":17,"caller":"+","text":"अथवा दानेल प्राचीन साहित्यका प्रसिद्ध व्यक्ति","reference":{"chapter":28,"verse":3}}]},"thisChapterLink":"/api/npi_ncb/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}