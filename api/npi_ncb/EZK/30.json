{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"EZK","translationId":"npi_ncb","name":"इजकिएल","commonName":"इजकिएल","title":"इजकिएलको भविष्यवाणी","order":26,"numberOfChapters":48,"sha256":"ab6a110a2b21652f118e0ae033e83b3d0c9ce242aae075a3773f203a476b0c3f","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/npi_ncb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["इजिप्टको निम्ति विलाप"]},{"type":"verse","number":1,"content":["याहवेहको यो वचन मकहाँ आयो:"]},{"type":"verse","number":2,"content":["“हे मानिसको छोरा, अगमवाणी गरेर भन्: ‘प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘विलाप गरेर भन्,","poem":1},{"text":"“हाय त्यो दिन!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"किनकि त्यो दिन नजिकै छ;","poem":1},{"text":"याहवेहको दिन नजिकै छ!","poem":2},{"text":"बादलहरूको दिन,","poem":1},{"text":"जाति-जातिहरूका निम्ति विनाशको दिन।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"इजिप्टको विरुद्धमा एउटा तरवार आउनेछ;","poem":1},{"text":"अनि कूशमाथि वेदना आउनेछ।","poem":2},{"text":"जब इजिप्टमा मारिएकाहरूले जमिन ढाक्छन्,","poem":1},{"text":"तब त्यसका धनसम्पत्ति लगिनेछ,","poem":2},{"lineBreak":true},{"text":"र त्यसका जगहरू पूर्ण रूपमा भत्काइनेछ।","poem":2}]},{"type":"verse","number":5,"content":["कूश, लिबिया, लूद र सारा अरब, कुब र करारको देशका मानिसहरू इजिप्टसितै तरवारद्वारा ढल्नेछन्।"]},{"type":"verse","number":6,"content":["“ ‘याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘इजिप्टका सहयोगी राष्ट्रहरू ढल्नेछन्,","poem":1},{"text":"र त्यसको शक्तिको घमण्ड असफल हुनेछ।","poem":2},{"text":"मिग्दोलदेखि आश्‍वानसम्म","poem":1},{"noteId":20},{"text":"तिनीहरू इजिप्ट सहरभित्र तरवारले ढल्नेछन्,","poem":2},{"lineBreak":true},{"text":"प्रभु याहवेह भन्‍नुहुन्छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरू उजाड","poem":1},{"text":"देशहरूका बीचमा उजाड हुनेछन्;","poem":2},{"text":"अनि तिनीहरूका सहरहरू","poem":1},{"text":"ध्वस्त भएका सहरहरूका बीचमा रहिरहनेछन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जब मैले इजिप्टमा आगो लगाएर","poem":1},{"text":"त्यसका सबै सहयोगीहरू नष्‍ट हुनेछन्,","poem":2},{"lineBreak":true},{"text":"तब तिनीहरूले म नै याहवेह हुँ भनी जान्‍नेछन्।","poem":2}]},{"type":"verse","number":9,"content":["“ ‘त्यस दिन सुरक्षित भई ढुक्‍क बसेको कूशलाई डर देखाउन मबाट सन्देश वाहकहरू जहाजमा जानेछन्। इजिप्टको विनाशको दिन तिनीहरूलाई वेदनाले छोप्नेछ; किनकि त्यो निश्‍चय आउनेछ।"]},{"type":"line_break"},{"type":"verse","number":10,"content":["“ ‘प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘म बेबिलोनको राजा नबूकदनेसरको हातबाट","poem":1},{"text":"इजिप्टको सेना दलको अन्त्य गरिदिनेछु।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यो र त्यसका सेना, जाति-जातिहरूमा अत्यन्तै निष्‍ठुर छन्,","poem":1},{"text":"देशलाई नाश गर्नको निम्ति भित्र ल्याइनेछ।","poem":2},{"text":"तिनीहरूले इजिप्टको विरुद्धमा आफ्ना तरवारहरू निकाल्नेछन्,","poem":1},{"text":"र मारिएकाहरूले देशलाई ढाकिदिनेछन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"म नील नदीको पानीलाई सुकाइदिनेछु,","poem":1},{"text":"र देशलाई दुष्‍ट मानिसहरूकहाँ बेचिदिनेछु;","poem":2},{"text":"विदेशीहरूका हातद्वारा म देशलाई","poem":1},{"text":"र त्यसमा भएका सबै कुरालाई उजाड पारिदिनेछु।","poem":2},"म याहवेहले नै भनेको हुँ।"]},{"type":"line_break"},{"type":"verse","number":13,"content":["“ ‘प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘म मूर्तिहरूलाई नाश गर्नेछु,","poem":1},{"text":"र मेम्फिसमा भएका आकृतिहरूलाई नष्‍ट गरिदिनेछु।","poem":2},{"text":"इजिप्टमा अब फेरि कुनै राजकुमार रहनेछैन;","poem":1},{"text":"अनि म इजिप्टभरि डर फैलाइदिनेछु।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"म माथिल्‍लो इजिप्टलाई उजाड पार्नेछु,","poem":1},{"text":"सोअनमा आगो लगाउनेछु,","poem":2},{"lineBreak":true},{"text":"र थेबेस सहरलाई दण्ड दिनेछु।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"इजिप्टको किल्‍ला पेलुसियममा","poem":1},{"text":"म मेरो क्रोध पोखाउनेछु;","poem":2},{"lineBreak":true},{"text":"अनि थेबेस सहरका सेना दलहरूलाई नष्‍ट पार्नेछु।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"म इजिप्टमा आगो लगाउनेछु;","poem":1},{"text":"पेलुसियम वेदनाले छटपटिनेछ।","poem":2},{"text":"थेबेस सहरलाई आँधीले लैजानेछ;","poem":1},{"text":"मेम्फिस लगातार कष्‍टमा रहनेछ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"हेलिओपोलिस र बुबास्तीसका","poem":1},{"noteId":21},{"text":"जवान मानिसहरू तरवारले ढल्नेछन्;","poem":2},{"lineBreak":true},{"text":"अनि सहरहरू आफैँ कैदमा जानेछन्।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"जब तहपनेसको दिन अँध्यारो हुनेछ,","poem":1},{"text":"तब म इजिप्टको जुवा भाँचिदिन्छु;","poem":2},{"lineBreak":true},{"text":"त्यहाँ त्यसको शक्तिको घमण्डको अन्त्य हुनेछ।","poem":2},{"text":"इजिप्ट बादलले छोपिनेछ;","poem":1},{"text":"अनि त्यसका गाउँहरू कैदमा जानेछन्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"यसरी म इजिप्टमाथि दण्ड ल्याउनेछु;","poem":1},{"text":"अनि तिनीहरूले म नै याहवेह हुँ भनी जान्‍नेछन्।’ ”","poem":2}]},{"type":"heading","content":["फारोका हातहरू भाँचिएका"]},{"type":"verse","number":20,"content":["एघारौँ वर्षको पहिलो महिनाको सातौँ दिनमा, याहवेहको वचन मकहाँ आयो:"]},{"type":"verse","number":21,"content":["“हे मानिसको छोरा, मैले इजिप्टको राजा फारोको हात भाँचिदिएको छु। यसलाई निको पार्न बाँधिएको छैन, अथवा त्यसमा मलमपट्टी लगाइएको छैन, ताकि त्यो तरवार समाउन सक्ने बलियो बनोस्।"]},{"type":"verse","number":22,"content":["यसकारण प्रभु याहवेह यसो भन्‍नुहुन्छ: म इजिप्टको राजा फारोको विरुद्धमा छु। म त्यसका दुवै पाखुराहरू, अर्थात् राम्रो र भाँचिएका दुवै पाखुराहरू भाँचिदिनेछु; अनि त्यसको हातबाट तरवार खस्‍न लगाउनेछु।"]},{"type":"verse","number":23,"content":["म इजिप्टवासीहरूलाई जाति-जातिहरूको बीचमा तितरबितर पारिदिनेछु, र तिनीहरूलाई विभिन्‍न देशभरि छरपस्ट पारिदिनेछु।"]},{"type":"verse","number":24,"content":["म बेबिलोनको राजाका पाखुराहरू बलिया पार्नेछु; अनि मेरो तरवार त्यसको हातमा राखिदिनेछु, तर म फारोका हातहरू भाँचिदिनेछु; अनि नबूकदनेसरको सामु मर्न लागेको घाइते मानिसझैँ त्यसले सुस्केरा हाल्नेछ।"]},{"type":"verse","number":25,"content":["म बेबिलोनको राजाका पाखुराहरू बलिया बनाइदिनेछु, तर फारोका हातहरू लत्रक्‍क झुण्डिनेछन्। जब तिनीहरूले म नै याहवेह हुँ भनी जान्‍नेछन्, तब म बेबिलोनको राजाको हातमा मेरो तरवार राखिदिन्छु; अनि त्यसले त्यो इजिप्टको विरुद्धमा चलाउनेछ।"]},{"type":"verse","number":26,"content":["म इजिप्टवासीहरूलाई जाति-जातिहरूको बीचमा तितरबितर पारिदिनेछु, र तिनीहरूलाई विभिन्‍न देशभरि छरपस्ट पारिदिनेछु। तब तिनीहरूले म नै याहवेह हुँ भनी जान्‍नेछन्।”"]}],"footnotes":[{"noteId":20,"caller":"+","text":"मूल भाषामा सेइन","reference":{"chapter":30,"verse":6}},{"noteId":21,"caller":"+","text":"मूल भाषामा ओन र पी-बेसेथ पी-बेसेतका","reference":{"chapter":30,"verse":17}}]},"thisChapterLink":"/api/npi_ncb/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}