{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"EZK","translationId":"npi_ncb","name":"इजकिएल","commonName":"इजकिएल","title":"इजकिएलको भविष्यवाणी","order":26,"numberOfChapters":48,"sha256":"ab6a110a2b21652f118e0ae033e83b3d0c9ce242aae075a3773f203a476b0c3f","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/npi_ncb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":7,"content":[{"type":"heading","content":["अन्त्य आइपुगेको छ"]},{"type":"verse","number":1,"content":["याहवेहको वचन मकहाँ आयो:"]},{"type":"verse","number":2,"content":["“हे मानिसको छोरा, प्रभु याहवेह इस्राएल देशलाई यसो भन्‍नुहुन्छ:",{"text":"“ ‘अन्त्य! देशका चारै कुनामाथि","poem":1},{"text":"अन्त्य आइपुगेको छ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"अब अन्त्य तँमाथि छ,","poem":1},{"text":"र म आफ्नो रिस तेरो विरुद्धमा ल्याउनेछु।","poem":2},{"text":"म तेरा चालअनुसार तेरो न्याय गर्नेछु;","poem":1},{"text":"अनि तेरा सबै घृणित कामहरूका निम्ति तँसित बदला लिनेछु।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"म तँलाई दयाको नजरले हेर्नेछैनँ;","poem":1},{"text":"म तँलाई छोड्नेछैनँ।","poem":2},{"text":"म निश्‍चय नै तेरा चाल र तेरा बीचमा भएका","poem":1},{"text":"घृणित कामहरूका निम्ति तँसित बदला लिनेछु।","poem":2},"“ ‘तब तैँले जान्‍नेछस्, कि म नै याहवेह हुँ।’"]},{"type":"line_break"},{"type":"verse","number":5,"content":["“प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘विपत्ति! कहिल्यै नसुनिएको विपत्ति!","poem":1},{"text":"हेर्, यो विपत्ति आउँदैछ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"अन्त्य आएको छ!","poem":1},{"text":"अन्त्य आएको छ!","poem":2},{"text":"यो तेरो विरुद्धमा आफैँ सुरिइएको छ।","poem":1},{"text":"हेर्, त्यो आउँदैछ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यो देशमा बसोबास गर्नेहरू,","poem":1},{"text":"तिमीहरूमाथि सर्वनाश आएको छ।","poem":2},{"text":"समय आएको छ! दिन नजिकै छ!","poem":1},{"text":"पर्वतहरूमा आनन्द होइन, तर त्रास छ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मैले मेरो क्रोध तँमाथि खन्याउन लागेको छु,","poem":1},{"text":"र तेरो विरुद्धमा मेरो रिस पोखाउन आँटेको छु।","poem":2},{"text":"म तेरा चालअनुसार तेरो न्याय गर्नेछु,","poem":1},{"text":"र तेरा सबै घृणित कामहरूका निम्ति तँसित बदला लिनेछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"म तँलाई दयाको नजरले हेर्नेछैनँ;","poem":1},{"text":"म तँलाई छोड्नेछैनँ।","poem":2},{"text":"म तेरा चालअनुसार र तेरा बीचमा भएका","poem":1},{"text":"घृणित कामहरूका निम्ति तँसित बदला लिनेछु।","poem":2},{"lineBreak":true},"“ ‘तब तैँले जान्‍नेछस्, कि तँलाई प्रहार गर्ने याहवेह म नै हुँ।"]},{"type":"verse","number":10,"content":[{"text":"“ ‘हेर्, त्यो दिन!","poem":1},{"text":"हेर्, त्यो आएको छ!","poem":2},{"text":"सर्वनाश निस्केर आएको छ;","poem":1},{"text":"लट्ठीमा टुसा पलाएको छ,","poem":2},{"lineBreak":true},{"text":"अहङ्कार फक्रेको छ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"दुष्‍टलाई दण्ड दिनलाई,","poem":1},{"text":"लट्ठी बनेको छ;","poem":2},{"text":"कुनै पनि मानिस छोडिनेछैन;","poem":1},{"text":"त्यस भीडका कोही पनि रहनेछैन।","poem":2},{"text":"तिनीहरूका धनसम्पत्ति,","poem":1},{"text":"कुनै पनि बहुमूल्य कुरा, केही पनि छोडिनेछैन।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्यो समय आइपुगेको छ!","poem":1},{"text":"त्यो दिन आइपुगेको छ!","poem":2},{"text":"किन्‍नेले हर्ष नमनाओस्,","poem":1},{"text":"न त बेच्नेले शोक गरोस्;","poem":2},{"lineBreak":true},{"text":"किनभने मेरो क्रोध सारा भीडमाथि परेको छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"बेच्ने र किन्‍ने दुवै बाँचुन्जेल—","poem":1},{"text":"बेच्नेले बेचेको जमिन","poem":2},{"lineBreak":true},{"text":"फेरि पाउन सक्दैन।","poem":2},{"text":"किनकि सम्पूर्ण भीडहरूका निम्ति","poem":1},{"text":"न्यायको दर्शन बदलिनेछैन।","poem":2},{"text":"तिनीहरूका पापको कारण तिनीहरूमध्ये","poem":1},{"text":"एउटैले पनि आफ्नो जीवन जोगाइराख्न सक्दैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘तिनीहरूले तुरही फुकेका छन्;","poem":1},{"text":"तिनीहरूले सबै कुरा तयार गरेर राखेका छन्,","poem":2},{"text":"तर कोही पनि लडाइँमा जानेछैनन्;","poem":1},{"text":"किनकि मेरो क्रोध सम्पूर्ण भीडमाथि नै परेको छ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"बाहिर तरवार छ;","poem":1},{"text":"भित्र रूढी र अनिकाल छन्।","poem":2},{"text":"गाउँमा भएकाहरू","poem":1},{"text":"तरवारद्वारा मर्नेछन्;","poem":2},{"text":"सहरभित्र हुनेहरू","poem":1},{"text":"रूढी र अनिकालले मर्नेछन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"बाँचेका र उम्केकाहरू","poem":1},{"text":"पहाडहरूतिर भाग्नेछन्।","poem":2},{"text":"बेँसीका ढुकुरहरूझैँ,","poem":1},{"text":"तिनीहरू सबैले","poem":2},{"lineBreak":true},{"text":"आ-आफ्ना पापका निम्ति विलाप गर्दै रहनेछन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"हरेकका हात डरले शिथिल हुनेछन्;","poem":1},{"text":"हरेकका खुट्टा पिसाबले भिज्नेछन्!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तिनीहरूले भाङ्ग्रा लगाउनेछन्,","poem":1},{"text":"र तिनीहरूले त्रासको लुगा पहिरनेछन्।","poem":2},{"text":"तिनीहरू सबैका अनुहार शर्मले ढाकिनेछन्;","poem":1},{"text":"अनि तिनीहरू सबैका कपाल खौराइनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ ‘तिनीहरूले आफ्ना चाँदी सडकहरूमा फ्याँकिदिनेछन्,","poem":1},{"text":"र तिनीहरूका सुन अशुद्ध कुरो हुनेछ।","poem":2},{"text":"याहवेहको क्रोधको दिनमा","poem":1},{"text":"तिनीहरूका सुनचाँदीले","poem":2},{"lineBreak":true},{"text":"तिनीहरूलाई बचाउन सक्नेछैन।","poem":2},{"text":"सुनचाँदीले तिनीहरूका भोक मेटाउनेछैन","poem":1},{"text":"अथवा तिनीहरूको पेट भर्नेछैन;","poem":2},{"lineBreak":true},{"text":"किनकि सुनचाँदी नै तिनीहरूका पापको निम्ति ठक्‍करको कारण बनेको थियो।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तिनीहरूले आफ्ना सुन्दर गहनामा घमण्ड गरे,","poem":1},{"text":"र त्यसलाई तिनीहरूका घृणित मूर्तिहरू बनाउन प्रयोग गरे।","poem":2},{"text":"तिनीहरूले अशुद्ध आकृतिहरू बनाउनमा प्रयोग गरे;","poem":1},{"text":"यसकारण म ती कुराहरूलाई तिनीहरूका निम्ति अशुद्ध बनाइदिनेछु।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"म तिनीहरूका धनसम्पत्ति विदेशीहरूलाई लुटको सामानझैँ दिनेछु,","poem":1},{"text":"पृथ्वीका सबैभन्दा दुष्‍टका हातमा दिनेछु,","poem":2},{"lineBreak":true},{"text":"उनीहरूले ती धनसम्पत्तिलाई अपवित्र पार्नेछन्।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"म आफ्नो अनुहार मानिसहरूदेखि फर्काउनेछु,","poem":1},{"text":"र डाँकुहरूले मेरो बहुमूल्य ठाउँलाई अशुद्ध पारिदिनेछन्।","poem":2},{"text":"डाँकुहरू यरूशलेमको भवनभित्र पस्‍नेछन्,","poem":1},{"text":"र त्यसलाई अशुद्ध पारिदिनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ ‘साङ्लाहरू तयार गर्!","poem":1},{"text":"किनकि देश रक्तपातले भरिएको छ,","poem":2},{"lineBreak":true},{"text":"र सहर हिंसाले भरिएको छ।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"जातिहरूमध्ये सबैभन्दा दुष्‍ट मानिसहरूलाई","poem":1},{"text":"म इस्राएलीहरूका घरहरू कब्जा गर्नलाई ल्याउनेछु।","poem":2},{"text":"म तिनीहरूका बलिया योद्धाहरूका घमण्डको अन्त्य गरिदिनेछु;","poem":1},{"text":"अनि तिनीहरूका पवित्र ठाउँहरू अशुद्ध पारिनेछन्।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"जब तिनीहरू त्रसित हुनेछन्,","poem":1},{"text":"तब तिनीहरूले व्यर्थमा शान्ति खोज्नेछन्,","poem":2},{"lineBreak":true},{"text":"तर सुरक्षित ठाउँ कहीँ पनि पाउनेछैनन्।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"विपत्तिमाथि विपत्ति आउनेछ;","poem":1},{"text":"अनि हल्‍लामाथि हल्‍ला आउनेछ।","poem":2},{"text":"तिनीहरू अगमवक्ताबाट दर्शनको खोज गर्नेछन्;","poem":1},{"text":"तर पुजारीबाट शिक्षा लोप भइजानेछन्,","poem":2},{"lineBreak":true},{"text":"र प्रधानहरूका परामर्शको पनि अन्त्य हुनेछ।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"राजाले शोक गर्नेछन्,","poem":1},{"text":"राजकुमारलाई निराशाले ढाक्नेछ,","poem":2},{"lineBreak":true},{"text":"र देशका मानिसहरूका हातहरू त्रासले थरथर काम्नेछन्।","poem":2},{"text":"म तिनीहरूका चालअनुसार तिनीहरूसित व्यवहार गर्नेछु,","poem":1},{"text":"र म तिनीहरूकै स्तरअनुसार तिनीहरूको न्याय गर्नेछु।","poem":2},{"lineBreak":true},"“ ‘तब म नै याहवेह हुँ भनी तिनीहरूले जान्‍नेछन्।’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}