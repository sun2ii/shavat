{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"GEN","translationId":"npi_ncb","name":"उत्पत्ति","commonName":"उत्पत्ति","title":"उत्पत्तिको पुस्तक","order":1,"numberOfChapters":50,"sha256":"b3f722b6c8c7c857262dad20cbaf0736a77645dc6304ed5d2fb2324d939d5670","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/npi_ncb/GEN/50.json","totalNumberOfVerses":1532},"chapter":{"number":49,"content":[{"type":"heading","content":["याकोबले आफ्ना छोराहरूलाई आशिष् दिएका"]},{"type":"verse","number":1,"content":["तब याकोबले आफ्ना छोराहरूलाई बोलाएर भने: “तिमीहरू भेला होओ, र आउँदा दिनहरूमा तिमीहरूलाई के-के हुनेछ, त्यो म भन्‍नेछु।"]},{"type":"verse","number":2,"content":[{"text":"“याकोबका छोराहरू हो! भेला होओ, र सुन;","poem":1},{"text":"तिमीहरूका पिता इस्राएलका कुरा सुन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“रूबेन, तँ मेरो जेठा छोरा होस्,","poem":1},{"text":"मेरो शक्ति, मेरो बलको पहिलो चिन्ह,","poem":2},{"lineBreak":true},{"text":"सम्मानमा विशिष्‍ट, र शक्तिमा विशिष्‍ट।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तँ पानीझैँ चञ्चल छस्; यसैले तेरो इज्जत रहनेछैन;","poem":1},{"text":"किनकि तँ आफ्ना पिताको ओछ्यानमा चढिस्,","poem":2},{"lineBreak":true},{"text":"मेरो पलङमा चढिस् र त्यसलाई अशुद्ध पारिस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“शिमियोन र लेवी दाजुभाइहरू हुन्;","poem":1},{"text":"तिनीहरूका तरवारहरू हिंसाका हतियारहरू हुन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"म तिनीहरूको सभामा नपसूँ,","poem":1},{"text":"म तिनीहरूका परिषद्‌मा सामेल नबनूँ;","poem":2},{"text":"किनकि तिनीहरूले रिसमा मानिसहरू मारेका छन्।","poem":1},{"text":"अनि खेलवाड गरेर गोरुहरूका ढोडनसा काटेका छन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरूको यति डरलाग्दो रिस,","poem":1},{"text":"तिनीहरूको निष्‍ठुर क्रोधमाथि श्राप परोस्!","poem":2},{"text":"म तिनीहरूलाई याकोबमा छरपस्ट पार्नेछु,","poem":1},{"text":"र इस्राएलमा तितरबितर पार्नेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“यहूदा, तेरा दाजुभाइहरूले तँलाई प्रशंसा गर्नेछन्;","poem":1},{"text":"तेरो हात तेरा शत्रुहरूको गर्दनमा हुनेछ;","poem":2},{"lineBreak":true},{"text":"तेरा पिताका छोराहरूले तँलाई दण्डवत् गर्नेछन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ए यहूदा, तँ सिंहको डमरुजस्तै छस्;","poem":1},{"text":"मेरो छोरा, तँ शिकारबाट फर्कन्छस्।","poem":2},{"text":"त्यो सिंहझैँ झुक्दछ,","poem":1},{"text":"सिंहनीझैँ आराम गर्न लमतन्‍न पर्दछ—कसले उसलाई जगाउने आँट गर्ला?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"यहूदाको हातबाट राजदण्ड हट्नेछैन,","poem":1},{"text":"न त शासकको लहुरो त्यसका खुट्टाहरूका बीचबाट","poem":2},{"noteId":111},{"text":"हट्नेछ,","poem":2},{"text":"जबसम्म यी जसका हुन्, ती आउँदैनन्,","poem":1},{"text":"अनि जातिहरू उहाँमा आज्ञाकारी बन्‍नेछन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यसले आफ्नो गधालाई दाखको बोटमा,","poem":1},{"text":"र त्यसको बछेडोलाई त्यसले उत्तम हाँगामा बाँध्नेछ;","poem":2},{"text":"त्यसले आफ्नो वस्त्र दाखमद्यमा,","poem":1},{"text":"र आफ्नो लबेदा दाखको रसमा धुनेछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्यसका आँखा दाखमद्यभन्दा गाढा रङ्गका,","poem":1},{"text":"र त्यसका दाँतहरू दूधभन्दा सेता हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“जबूलून समुद्री किनारमा बस्‍नेछ,","poem":1},{"text":"र ऊ जहाजहरूका लागि बन्दरगाह बन्‍नेछ;","poem":2},{"lineBreak":true},{"text":"त्यसको सिमाना सीदोनतिर फैलिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“इस्साखार दुई काठीका बीचमा","poem":1},{"text":"आराम गर्ने बलियो गधा हो।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"जब त्यसले आफू बिसाएको ठाउँ कति असल छ,","poem":1},{"text":"र आफ्नो देश कति आनन्दपूर्ण छ भनी देख्छ,","poem":2},{"text":"त्यसले आफ्नो काँध भारी बोक्नको लागि झुकाउनेछ,","poem":1},{"text":"र कडा परिश्रमको लागि समर्पित हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“दानले इस्राएलको एउटा कुलको हैसियतले","poem":1},{"text":"आफ्ना मानिसहरूलाई न्याय दिनेछ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"दान बाटो छेउको एउटा सर्प,","poem":1},{"text":"र गोरेटोमा बसेको विषालु सर्प हो,","poem":2},{"text":"जसले घोडाको कुर्कुच्‍चा डस्छ,","poem":1},{"text":"र यसमा सवार हुने मानिस पछिल्तिर पछारिन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“हे याहवेह, म तपाईंको छुटकारालाई अपेक्षा गर्दछु।","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“गादलाई आक्रमणकारीहरूको दलले आक्रमण गर्नेछ;","poem":1},{"text":"तर त्यसले चाहिँ तिनीहरूलाई उल्टो खेदेर तिनीहरूका कुर्कुच्‍चामा आक्रमण गर्नेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“आशेरको भोजन उत्तम हुनेछ;","poem":1},{"text":"त्यसले राजालाई सुहाउने स्वादिलो भोजन जुटाउनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“नप्‍ताली स्वतन्त्र भएकी मुडुली मृग हो,","poem":1},{"text":"जसले सुन्दर पाठाहरू बियाउँछे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“योसेफ एउटा फलदायक दाखको बोट हो,","poem":1},{"text":"पानीको मूलको नजिक भएको फलदायक दाखको बोट,","poem":2},{"lineBreak":true},{"text":"जसका हाँगाहरू पर्खाल नाघेर फैलिन्छन्।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"धनुर्धारीहरूले निर्दयतासाथ त्यसलाई आक्रमण गरे;","poem":1},{"text":"तिनीहरूले दुश्मनी राखेर त्यसलाई काँडले हाने।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"तर त्यसको धनु स्थिर रह्‍यो;","poem":1},{"text":"त्यसका बलिया पाखुराहरू फूर्तिला रहे;","poem":2},{"text":"त्यो याकोबका सर्वशक्तिमान्‌को हातले गर्दा","poem":1},{"text":"त्यो गोठाला, इस्राएलका चट्टानले गर्दा भएको थियो;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तेरा पिताका परमेश्‍वर, जसले तँलाई सहायता गर्नुहुन्छ,","poem":1},{"text":"सर्वशक्तिमान्, जसले तँलाई","poem":2},{"text":"माथि स्वर्गका आशिष्‌हरू,","poem":1},{"text":"तल भएको समुद्रका आशिष्‌हरू,","poem":2},{"lineBreak":true},{"text":"स्तन र गर्भका आशिष्‌हरू दिनुहुन्छ।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"तेरा पिताका आशिष्‌हरू","poem":1},{"text":"प्राचीन पर्वतहरूका आशिष्‌हरूभन्दा","poem":2},{"lineBreak":true},{"text":"र पुराना पहाडहरूका प्रचुरताहरूभन्दा महान् छन्;","poem":2},{"text":"यी सबै आशिष्‌हरू योसेफका शिरमा होऊन्;","poem":1},{"text":"आफ्ना दाजुभाइहरूका बीचमा भएका राजकुमारका आँखीभौँमाथि बसून्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“बेन्यामीन साह्रै भोकाएको ब्वाँसो हो;","poem":1},{"text":"बिहान त्यसले शिकार खान्छ;","poem":2},{"lineBreak":true},{"text":"साँझमा त्यसले लुटको माल बाँड्छ।”","poem":2}]},{"type":"verse","number":28,"content":["यी सबै इस्राएलका बाह्र कुल हुन्; र यसरी उनीहरूका पिताले उनीहरू प्रत्येकलाई सुहाउँदो आशिष् दिए।"]},{"type":"heading","content":["याकोबको मृत्यु"]},{"type":"verse","number":29,"content":["तब याकोबले उनीहरूलाई यी निर्देशन दिए: “म आफ्ना मानिसहरूसित मिल्न जान लागिरहेको छु। मलाई हित्ती एप्रोनको खेतमा भएको ओडारमा मेरा पितापुर्खाहरूसित गाड्नू,"]},{"type":"verse","number":30,"content":["जुन ओडारचाहिँ कनानमा मम्रेको छेउमा मक्पेलाको खेतमा छ। अनि त्यो ठाउँ अब्राहामले हित्ती एप्रोनबाट चिहान घारीको रूपमा खेतसमेत किनेका थिए।"]},{"type":"verse","number":31,"content":["त्यहीँ नै अब्राहाम र तिनकी पत्नी सारा गाडिए; त्यहीँ इसहाक र तिनकी पत्नी रिबेका गाडिए; र त्यहीँ नै मैले लेआलाई गाडेँ।"]},{"type":"verse","number":32,"content":["त्यो जमिन र त्यो ओडार हित्तीहरूबाट किनिएको हो।”"]},{"type":"verse","number":33,"content":["अनि याकोबले आफ्ना छोराहरूलाई निर्देशन दिइसकेपछि उनले आफ्ना खुट्टा पलङमा पसारेर आफ्नो अन्तिम सास फेरे। यसरी उनी आफ्ना मानिससित मिल्न गए।"]}],"footnotes":[{"noteId":111,"caller":"+","text":"अथवा तिनका सन्तानहरूबाट।","reference":{"chapter":49,"verse":10}}]},"thisChapterLink":"/api/npi_ncb/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}