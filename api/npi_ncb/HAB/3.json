{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HAB","translationId":"npi_ncb","name":"हबकूक","commonName":"हबकूक","title":"हबकूकको भविष्यवाणी","order":35,"numberOfChapters":3,"sha256":"c4b38b6c25431f242b32674053eedc6e1e072ad46ccf2fa1ef2e12c509f5dae3","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/npi_ncb/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["हबकूकको प्रार्थना"]},{"type":"verse","number":1,"content":[{"text":"शिग्गिओनोथको रागमा हबकूक अगमवक्ताको प्रार्थना।","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"हे याहवेह, मैले तपाईंको कीर्ति सुनेको छु;","poem":1},{"text":"हे याहवेह, म तपाईंका कामहरूद्वारा अचम्मित भएको छु!","poem":2},{"text":"हाम्रो समयमा पनि त्यस्ता कामहरू फेरि गर्नुहोस्;","poem":1},{"text":"हाम्रो समयमा ती कार्यहरू फेरि प्रकट गर्नुहोस्।","poem":2},{"lineBreak":true},{"text":"तपाईंको क्रोधमा आफ्नो दया सम्झनुहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"परमेश्‍वर तेमानबाट आउनुभयो,","poem":1},{"text":"पवित्र परमेश्‍वर पारान पर्वतबाट आउनुभयो। सेला","poem":2},{"text":"उहाँको गौरवले आकाशमण्डललाई ढाक्यो;","poem":1},{"text":"अनि उहाँको प्रशंसाले सारा पृथ्वी भरियो।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उहाँको गौरव सूर्योदय जस्तै थियो;","poem":1},{"text":"उहाँका हातबाट ज्योतिको किरण चम्कन्थ्यो,","poem":2},{"lineBreak":true},{"text":"जहाँ उहाँको शक्ति लुकेको थियो।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उहाँको अगाडि महामारी फैलिँदै गयो;","poem":1},{"text":"उहाँको पछि-पछि रूढी लाग्यो।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"उहाँ उभिनुभयो र पृथ्वीलाई हल्‍लाउनुभयो;","poem":1},{"text":"उहाँले हेर्नुभयो र राष्ट्रहरू थरथर काँप्न थाले।","poem":2},{"text":"प्राचीन पर्वतहरू चकनाचुर भए;","poem":1},{"text":"अनि पुराना पहाडहरू ध्वस्त भए।","poem":2},{"lineBreak":true},{"text":"तर उहाँका मार्गहरू अनन्तकालसम्म उस्तै छन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मैले कूशनका पालहरू कष्‍टमा परेका देखेँ;","poem":1},{"text":"मिद्यानका वासस्थानहरू त्रासले काँपिरहेको देखेँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे याहवेह, के तपाईं नदीहरूसँग रिसाउनुभएको थियो?","poem":1},{"text":"के तपाईंको क्रोध खोलानालाको विरुद्धमा थियो?","poem":2},{"text":"जब तपाईं आफ्ना घोडा","poem":1},{"text":"र विजयका रथहरूमा सवार हुनुहुन्थ्यो,","poem":2},{"lineBreak":true},{"text":"तब के तपाईं समुद्रको विरुद्धमा क्रोधित हुनुहुन्थ्यो?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तपाईंले आफ्नो धनु निकाल्नुभयो,","poem":1},{"text":"र तपाईंले ताँदोमा धेरै वाणहरू चढाउनुभयो। सेला","poem":2},{"text":"तपाईंले पृथ्वीलाई नदीहरूले विभाजन गर्नुभयो;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"तपाईंलाई देखेर पर्वतहरू थर्किए।","poem":2},{"text":"प्रचण्ड जलस्रोतहरू वेगले बगेर गए;","poem":1},{"text":"गहिरो समुद्र गर्ज्यो","poem":2},{"lineBreak":true},{"text":"र त्यसका छालहरू माथिसम्म उठे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"वेगले उडेका तपाईंका वाणहरू चम्कँदा,","poem":1},{"text":"तपाईंको चम्किलो भाला बिजुलीझैँ चम्कँदा,","poem":2},{"lineBreak":true},{"text":"आकाशमा सूर्य र चन्द्रमा टक्‍क अडिए।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"क्रोधमा तपाईं पृथ्वी पार गर्दै हिँड्नुभयो,","poem":1},{"text":"र रिसमा तपाईंले राष्ट्रहरूलाई दाइँ गर्नुभयो।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तपाईं आफ्नो जातिलाई छुटकारा दिन","poem":1},{"text":"र आफ्ना अभिषिक्त जनलाई उद्धार गर्नका लागि निस्केर आउनुभयो।","poem":2},{"text":"तपाईंले दुष्‍टताको देशका मुख्य अगुवालाई कुल्चनुभएर","poem":1},{"text":"त्यसलाई टाउकोदेखि पैतालासम्म नाङ्गो पार्नुभयो।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जब त्यसका योद्धाहरू हामीलाई तितरबितर पार्नलाई खनिएका थिए,","poem":1},{"text":"र लुकिबसेका दुःखीहरूलाई निल्न रमाउँदै आएका थिए,","poem":2},{"text":"तब तपाईंले त्यसको आफ्नै भालाले","poem":1},{"text":"त्यसको टाउको छेडिदिनुभयो।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तपाईंले महासागरलाई मन्थन गर्दै,","poem":1},{"text":"आफ्ना घोडाहरूले समुद्रलाई कुल्चनुभयो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"मैले यी सबै सुन्दा मेरो मुटुको ढुकढुकी बढ्यो;","poem":1},{"text":"त्यो आवाज सुनेर मेरा ओठहरू कामे;","poem":2},{"text":"मेरा हाडहरू भित्रभित्रै मक्‍किए,","poem":1},{"text":"र मेरा खुट्टाहरू थरथर कामे।","poem":2},{"text":"तरै पनि म त्यो विपत्तिको दिनलाई धैर्यतासाथ पर्खनेछु,","poem":1},{"text":"जुन हामीलाई आक्रमण गर्ने राष्ट्रमाथि आउनेछ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"चाहे नेभाराको रूखमा मुनाहरू नलागोस्,","poem":1},{"text":"र अङ्‌गुरको बोटमा फल नफलोस्;","poem":2},{"text":"चाहे जैतुनको रूखले फल नफलाओस्,","poem":1},{"text":"र खेतबारीले अन्‍नबाली नउब्जाओस्,","poem":2},{"text":"चाहे खोरमा भेडाबाख्रा","poem":1},{"text":"र गोठहरूमा गाईबस्तु नरहून्।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तापनि म याहवेहमा रमाउनेछु।","poem":1},{"text":"मेरो उद्धारकर्ता परमेश्‍वरमा आनन्दित हुनेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"प्रभु याहवेह मेरो बल हुनुहुन्छ;","poem":1},{"text":"उहाँले मेरा खुट्टालाई हरिणीका खुट्टाझैँ बनाउनुहुन्छ;","poem":2},{"lineBreak":true},{"text":"उहाँले मलाई अग्ला-अग्ला स्थानहरूमा हिँड्न सक्षम बनाउनुहुन्छ।","poem":2},{"text":"सङ्गीत निर्देशकको निम्ति। मेरो तारवाला बाजामा बजाइने राग।","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}