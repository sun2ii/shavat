{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"इस्राएल एउटा लहलहाउँदो दाखको बोट थियो;","poem":1},{"text":"त्यसले आफ्नै निम्ति प्रशस्त फल फलायो।","poem":2},{"text":"जब त्यसको प्रशस्त फलहरू बढ्दैगयो,","poem":1},{"text":"तब त्यसले धेरै वेदीहरू बनायो;","poem":2},{"text":"जब त्यसको देशको समृद्धि भयो,","poem":1},{"text":"तब त्यसले आफ्नो पवित्र ढुङ्गाहरूलाई सिँगार्‍यो।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तिनीहरूको हृदय छली छ;","poem":1},{"text":"अब तिनीहरूले आफ्नो दोषको दण्ड पाउनैपर्छ।","poem":2},{"text":"याहवेहले तिनीहरूका वेदीहरू भत्काउनुहुनेछ;","poem":1},{"text":"अनि तिनीहरूले पवित्र मानिएका ढुङ्गाहरूलाई नष्‍ट पार्नुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"तब तिनीहरूले भन्‍नेछन्, “हामीले याहवेहलाई","poem":1},{"text":"आदर गरेनौँ; यसकारण हामीसित राजा छैनन्।","poem":2},{"text":"तर यदि हामीसित राजा भए तापनि","poem":1},{"text":"तिनले हाम्रा निम्ति के गर्न सक्थे र?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरूले धेरै प्रतिज्ञाहरू गर्छन्,","poem":1},{"text":"झूटो शपथ खान्छन्","poem":2},{"lineBreak":true},{"text":"र सहमति जनाउँछन्;","poem":2},{"text":"त्यसैले जोतिएको जमिनमा उम्रेका","poem":1},{"text":"विषालु झारहरूझैँ अन्याय मौलाउँछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"सामरियामा बसोबास गर्ने मानिसहरू","poem":1},{"text":"बेथ-आवेनको सुनको बाछाको मूर्तिसँग डराउँछन्।","poem":2},{"text":"र मूर्तिपूजक पुजारीहरूले पनि त्यसै गर्नेछन्;","poem":1},{"text":"तिनीहरू जसले मूर्तिको गौरवमा आनन्द मनाएका थिए;","poem":2},{"text":"त्यसका मानिसहरू त्यसको निम्ति विलाप गर्नेछन्;","poem":1},{"text":"किनकि देशबाट मूर्ति निकालेर कैदमा लगिएको छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"त्यसलाई महान् राजाको निम्ति","poem":1},{"text":"सौगातको रूपमा अश्शूर देशमा लगिनेछ।","poem":2},{"text":"एफ्राइम अपमानित हुनेछ;","poem":1},{"text":"इस्राएल आफ्ना पराई देवताको कारण लज्जित हुनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"सामरियाको राजा नष्‍ट हुनेछ,","poem":1},{"text":"त्यो पानीले बगाएको काठको टुक्राझैँ बगेर जानेछ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"दुष्‍टताका अग्ला-अग्ला डाँडाहरू नष्‍ट पारिनेछन्;","poem":1},{"text":"यो इस्राएलको पाप हो।","poem":2},{"text":"काँडा र सिउँडीहरू बढ्नेछन्,","poem":1},{"text":"र तिनीहरूका वेदीहरूलाई ढाक्नेछन्।","poem":2},{"text":"त्यसपछि तिनीहरूले पर्वतहरूलाई भन्‍नेछन्, “हामीलाई छोप!”","poem":1},{"text":"र पहाडहरूलाई भन्‍नेछन्, “हामीमाथि खस!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“हे इस्राएल, तिमीहरूले गेबाको दिनदेखि नै पाप गरेका छौ,","poem":1},{"text":"र तिमीहरू त्यही पापमा छौ।","poem":2},{"text":"के गेबामा भएका दुष्‍ट काम गर्ने मानिसहरू","poem":1},{"text":"फेरि युद्धमा पर्दैनन् र?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"म आफ्नो इच्छाअनुसार तिनीहरूलाई दण्ड दिनेछु;","poem":1},{"text":"तिनीहरूलाई आफ्ना दोबर पापको निम्ति बन्धनमा पार्नलाई","poem":2},{"lineBreak":true},{"text":"तिनीहरूको विरुद्धमा राष्ट्रहरू भेला हुनेछन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"एफ्राइम दाइँ गर्न रुचाउने","poem":1},{"text":"तालिमद्वारा सधाइएकी कोरली हो;","poem":2},{"text":"यसकारण म त्यसको सुन्दर काँधमाथि","poem":1},{"text":"गह्रौँ जुवा हालिदिनेछु।","poem":2},{"text":"म एफ्राइमलाई धपाउनेछु,","poem":1},{"text":"यहूदाले चाहिँ जोत्नुपर्छ","poem":2},{"lineBreak":true},{"text":"र याकोबले जमिन फुटाउनुपर्नेछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"आफ्नो निम्ति धार्मिकताको बिउ छर!","poem":1},{"text":"अचुक प्रेमको फसलको कटनी गर!","poem":2},{"text":"र तिमीहरूका नजोतिएका जमिनलाई जोत;","poem":1},{"text":"किनकि याहवेहलाई खोज्ने समय अहिले नै हो;","poem":2},{"text":"अनि उहाँ आउनुहुन्छ","poem":1},{"text":"र तिमीहरूमाथि धार्मिकता बर्साउनुहुन्छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तर तिमीहरूले दुष्‍टता रोपेका छौ,","poem":1},{"text":"र तिमीहरूले पापको कटनी गरेका छौ;","poem":2},{"lineBreak":true},{"text":"तिमीहरूले छलको फल खाएका छौ।","poem":2},{"text":"अनि तिमीहरूले आफ्नै सामर्थ्य","poem":1},{"text":"र आफ्ना योद्धाहरूको संख्यामा भरोसा राखेको कारण","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तिमीहरूका मानिसहरूको विरुद्धमा लडाइँका गर्जनहरू उठ्नेछन्;","poem":1},{"text":"युद्धको दिनमा शल्मनले बेथ-आर्बेललाई नाश गरेझैँ","poem":2},{"text":"तिमीहरूका सबै बलिया किल्‍लाहरू नष्‍ट हुनेछन्;","poem":1},{"text":"जुन समयमा आमाहरू आफ्ना छोराछोरीहरूसँगै","poem":2},{"lineBreak":true},{"text":"भुइँमा पछारिएर टुक्रा-टुक्रा पारिएका थिए।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"हे बेथेल, तँमाथि पनि त्यस्तै हुनेछ;","poem":1},{"text":"किनकि तेरो दुष्‍टता धेरै छ।","poem":2},{"text":"त्यो दिन आएपछि,","poem":1},{"text":"इस्राएलको राजा पूर्ण रूपमा सर्वनाश हुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}