{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["इस्राएलको निम्ति परमेश्‍वरको प्रेम"]},{"type":"verse","number":1,"content":[{"text":"“इस्राएल बालक छँदा, मैले त्यसलाई प्रेम गरेँ,","poem":1},{"text":"मैले आफ्नो पुत्रलाई इजिप्टबाट बोलाएँ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तर मैले इस्राएललाई जति धेरै बोलाएँ,","poem":1},{"text":"तिनीहरू मदेखि उति नै धेरै टाढा गए।","poem":2},{"text":"तिनीहरूले बाल-देवताहरूलाई बलिदान चढाए,","poem":1},{"text":"र तिनीहरूले मूर्तिहरूलाई धूप बाले।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"एफ्राइमलाई आफ्नो अँगालोमा राखेर,","poem":1},{"text":"तिनीहरूलाई हिँड्न सिकाउने म नै हुँ;","poem":2},{"text":"तर तिनीहरूले जानेनन्,","poem":1},{"text":"कि मैले नै तिनीहरूलाई निको पारेको हुँ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मैले तिनीहरूलाई मानवीय प्रेम","poem":1},{"text":"र दयाको डोरीले बाँधेर डोर्‍याएँ;","poem":2},{"text":"मैले तिनीहरूलाई एउटा सानो बालकलाई जस्तै","poem":1},{"text":"मायाले उठाएर आफ्नो गालामा टसाएँ","poem":2},{"lineBreak":true},{"text":"र तिनीहरूलाई खुवाउन म निहुरेँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“तिनीहरूले पश्‍चात्ताप गर्न अस्वीकार गरेको कारण","poem":1},{"text":"के तिनीहरू इजिप्टमा फर्कनेछैनन्","poem":2},{"lineBreak":true},{"text":"र अश्शूरले तिनीहरूमाथि शासन गर्नेछैन र?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिनीहरूका सहरहरूमा तरवार घुम्‍नेछ;","poem":1},{"text":"तिनीहरूका झूटा अगमवक्ताहरू मारिनेछन्,","poem":2},{"lineBreak":true},{"text":"र तिनीहरूका योजनाहरूको अन्त्य गरिदिनेछन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मेरा मानिसहरूले मबाट तर्किएर जाने निश्‍चय गरेका छन्।","poem":1},{"text":"तिनीहरूले मलाई सर्वोच्‍च परमेश्‍वर भनी पुकारे तापनि","poem":2},{"lineBreak":true},{"text":"म कुनै पनि हालतमा तिनीहरूलाई उचाल्ने छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“हे एफ्राइम, म तँलाई कसरी त्याग्न सक्छु?","poem":1},{"text":"हे इस्राएल, म तँलाई कसरी शत्रुको हातमा सुम्पिदिन सक्छु?","poem":2},{"text":"म तँलाई कसरी अदमा सहरलाई झैँ व्यवहार गर्न सक्छु?","poem":1},{"text":"म तँलाई कसरी सबोयीम सहरझैँ बनाउन सक्छु?","poem":2},{"text":"मेरो हृदय मभित्र बदलिएको छ;","poem":1},{"text":"मेरो मनमा दया जागेको छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"म मेरो भयानक क्रोध पोख्नेछैनँ;","poem":1},{"text":"म एफ्राइमलाई फेरि सर्वनाश गर्नेछैनँ।","poem":2},{"text":"किनकि म त परमेश्‍वर हुँ, मानिस होइनँ;","poem":1},{"text":"तिमीहरूका बीचमा रहने पवित्र परमेश्‍वर हुँ।","poem":2},{"lineBreak":true},{"text":"म तिनीहरूका सहरहरूको विरुद्धमा क्रोधित भएर आउनेछैनँ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिनीहरूले याहवेहलाई पछ्याउनेछन्;","poem":1},{"text":"उहाँ सिंहजस्तै गर्जनुहुनेछ।","poem":2},{"text":"जब उहाँ गर्जनुहुन्छ, तब उहाँका छोराछोरीहरू","poem":1},{"text":"काम्दै पश्‍चिमबाट आउनेछन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तिनीहरू इजिप्टबाट आउनेछन्,","poem":1},{"text":"भँगेराहरूझैँ काँप्दै आउनेछन्,","poem":2},{"lineBreak":true},{"text":"र अश्शूरबाट ढुकुरहरूझैँ फटफटाउँदै आउनेछन्।","poem":2},{"text":"म तिनीहरूलाई तिनीहरूका घरहरूमा बसाल्नेछु,”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"heading","content":["इस्राएलको पाप"]},{"type":"verse","number":12,"content":[{"text":"एफ्राइमले मलाई झूटले,","poem":1},{"text":"र इस्राएलले मलाई छलले घेरेको छ।","poem":2},{"text":"यहूदाले अझै परमेश्‍वरको विरुद्धमा,","poem":1},{"text":"विश्‍वासयोग्य पवित्र परमेश्‍वरको विरुद्धमा विद्रोह गर्छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}