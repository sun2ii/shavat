{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"एफ्राइमले बतासले आफ्नो पेट भर्छ;","poem":1},{"text":"त्यसले दिनभरि पूर्वीय बतासलाई पछ्याउँछ;","poem":2},{"lineBreak":true},{"text":"अनि झूट र हिंसा बढाउँछ।","poem":2},{"text":"त्यसले अश्शूरसँग सन्धि गर्छ,","poem":1},{"text":"र त्यसले इजिप्टमा जैतुनको तेल पठाउँछ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेहले यहूदाको विरुद्धमा अभियोग लगाउनुहुन्छ;","poem":1},{"text":"उहाँले याकोबलाई उसको व्यवहारअनुसारको दण्ड दिनुहुनेछ,","poem":2},{"lineBreak":true},{"text":"र उहाँले उसको कामअनुसारको प्रतिफल दिनुहुनेछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उसले आमाको गर्भमा हुँदा नै आफ्ना दाजुको कुर्कुच्‍चा पक्रेको थियो;","poem":1},{"text":"मानिस भएर पनि उसले परमेश्‍वरसित कुश्ती खेल्यो।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उसले स्वर्गदूतसित कुश्ती खेल्यो र उसलाई जित्यो;","poem":1},{"text":"ऊ रोयो र दूतसँग निगाहको निम्ति बिन्ती गर्‍यो।","poem":2},{"text":"उहाँले उसलाई बेथेलमा भेट्नुभयो,","poem":1},{"text":"र उहाँले त्यहाँ उससँग कुरा गर्नुभयो,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"अर्थात् याहवेह सेनाहरूका परमेश्‍वर हुनुहुन्छ,","poem":1},{"text":"र याहवेह उहाँको नाम हो!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तर तँ आफ्ना परमेश्‍वरकहाँ फर्कनुपर्छ;","poem":1},{"text":"प्रेम र न्याय कायम राख्,","poem":2},{"lineBreak":true},{"text":"र सधैँ तेरा परमेश्‍वरको प्रतीक्षा गर्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"व्यापारीले छलको तराजु प्रयोग गर्छ,","poem":1},{"text":"र त्यसले छल गर्न रुचाउँछ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"एफ्राइमले घमण्डसित भन्छ,","poem":1},{"text":"“म अति धनी छु; म धनाढ्य भएको छु।","poem":2},{"text":"मेरा सबै धनसम्पत्तिले गर्दा तिनीहरूले","poem":1},{"text":"ममा कुनै अधर्म अथवा पाप भेट्टाउनेछैनन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“म याहवेह तेरा परमेश्‍वर हुँ,","poem":1},{"text":"जसले तँलाई इजिप्टबाट ल्याएको हुँ;","poem":2},{"text":"तेरा तोकिएका चाडहरूका दिनहरूमा झैँ","poem":1},{"text":"म तँलाई फेरि पालहरूमा बस्‍न लगाउनेछु।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मैले अगमवक्ताहरूसँग कुरा गरेको छु,","poem":1},{"text":"तिनीहरूलाई धेरै दर्शनहरू पनि दिएको छु;","poem":2},{"lineBreak":true},{"text":"अनि तिनीहरूद्वारा दृष्‍टान्तहरू भनेको छु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"के गिलाद दुष्‍ट हो?","poem":1},{"text":"त्यहाँका मानिसहरू व्यर्थका छन्!","poem":2},{"text":"के तिनीहरूले गिलगालमा साँढेहरूको बलि चढाउँछन्?","poem":1},{"text":"तिनीहरूका वेदीहरू जोतिएका जमिनमा","poem":2},{"lineBreak":true},{"text":"थुपारिएका ढुङ्गाका थुप्राहरूजस्ता हुनेछन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"याकोब अराम","poem":1},{"noteId":11},{"text":"देशमा भागेर गयो;","poem":1},{"text":"इस्राएलले पत्नी पाउनलाई सेवा गर्‍यो,","poem":2},{"lineBreak":true},{"text":"र तिनको ज्यालाको निम्ति भेडाहरू चरायो।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"याहवेहले इस्राएललाई इजिप्टबाट निकालेर ल्याउन","poem":1},{"text":"एक जना अगमवक्तालाई प्रयोग गर्नुभयो;","poem":2},{"lineBreak":true},{"text":"उहाँले एक जना अगमवक्ताद्वारा नै त्यसको हेरचाह गर्नुभयो।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तर एफ्राइमले परमेश्‍वरलाई साह्रै रिस उठाएको छ;","poem":1},{"text":"त्यसले बगाएको रक्तपातको दोष याहवेहले त्यसैमाथि छोड्नुहुनेछ;","poem":2},{"lineBreak":true},{"text":"अनि त्यसले उहाँलाई गरेको अपमानको बदला लिनुहुनेछ।","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"यो उत्तर-पश्‍चिमी मेसोपोटामिया हो।","reference":{"chapter":12,"verse":12}}]},"thisChapterLink":"/api/npi_ncb/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}