{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["इस्राएलको विरुद्धमा याहवेहको रिस"]},{"type":"verse","number":1,"content":[{"text":"जब एफ्राइम बोल्थ्यो, मानिसहरू काम्थे;","poem":1},{"text":"त्यो इस्राएलमा उच्‍च पारियो।","poem":2},{"lineBreak":true},{"text":"तर त्यो बाल-देवताको दोषी ठहरियो र मर्‍यो।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"अहिले तिनीहरूले अझ बढी पाप गरिरहेका छन्;","poem":1},{"text":"तिनीहरूले आफ्ना चाँदीबाट आफ्नै निम्ति मूर्तिहरू बनाउँछन्,","poem":2},{"text":"अर्थात् निपुणतासाथ बनाइएका मूर्तिहरू,","poem":1},{"text":"ती सबै मूर्तिहरू कारिगरहरूका काम हुन्।","poem":2},{"text":"यी मानिसहरूको विषयमा यसो भनिएको छ,","poem":1},{"text":"“तिनीहरूले मानवबलि चढाउँछन्!","poem":2},{"lineBreak":true},{"text":"अनि बाछाको मूर्तिहरूलाई चुम्बन गर्छन्।”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"यसकारण तिनीहरू बिहानको कुइरोझैँ,","poem":1},{"text":"बिहान सबेरै बिलाउने तुसारोझैँ,","poem":2},{"lineBreak":true},{"text":"खलाबाट उडिजाने भुसझैँ,","poem":2},{"lineBreak":true},{"text":"चिम्नीबाट निस्केको धुवाँझैँ हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“तर तिमीहरू इजिप्टबाट निस्केर आएको समयदेखि नै,","poem":1},{"text":"म याहवेह तिमीहरूका परमेश्‍वर हुँ;","poem":2},{"text":"अनि तिमीहरूले मबाहेक अरू कसैलाई पनि परमेश्‍वर भनी स्वीकार नगर्नू,","poem":1},{"text":"मबाहेक अर्को कोही पनि मुक्तिदाता छँदैछैन।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मैले तिमीहरूलाई उजाडस्थानमा","poem":1},{"text":"चर्को गर्मीको ठाउँमा हेरचाह गरेँ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जब मैले तिनीहरूलाई खुवाएँ, तिनीहरू सन्तुष्‍ट भए;","poem":1},{"text":"तर जब तिनीहरू सन्तुष्‍ट भए, त्यसपछि तिनीहरू झन् घमण्डी भए;","poem":2},{"lineBreak":true},{"text":"अनि तिनीहरूले मलाई बिर्से।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यसकारण म तिनीहरूमाथि सिंहजस्तै झम्टिनेछु;","poem":1},{"text":"म चितुवाझैँ तिनीहरूका बाटोमा ढुकिबस्‍नेछु।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"आफ्नो बच्‍चा खोसिएकी भालुजस्तै,","poem":1},{"text":"म तिनीहरूलाई आक्रमण गर्नेछु, र तिनीहरूलाई च्यातचुत पार्नेछु;","poem":2},{"text":"बाघले जस्तै म तिनीहरूलाई निल्नेछु,","poem":1},{"text":"जङ्गली जनावरले जस्तै तिनीहरूलाई फहराउनेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“हे इस्राएल, तँ सर्वनाश भएको छस्;","poem":1},{"text":"किनकि तँ मेरो विरुद्धमा, तेरो सहयोगीको विरुद्धमा छस्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिमीहरूको राजा कहाँ छ, जसले तिमीहरूलाई बचाउन सकोस्?","poem":1},{"text":"तिमीहरूका सबै सहरहरूका शासकहरू कहाँ छन्?","poem":2},{"text":"जसको बारेमा तिमीहरूले भन्थ्यौ,","poem":1},{"text":"‘मलाई एउटा राजा र राजकुमारहरू दिनुहोस्।’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"यसकारण मैले मेरो रिसमा तिमीहरूलाई राजा दिएँ;","poem":1},{"text":"अनि मेरो क्रोधमा मैले त्यसलाई टाढा पठाएँ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"एफ्राइमका दोषहरूलाई भण्डारण गरिएको छ;","poem":1},{"text":"त्यसका पापहरूको हिसाब राखिएको छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"स्त्रीको प्रसव वेदनाजस्तै त्यसमाथि दुःख आउनेछ,","poem":1},{"text":"तर त्यो त बुद्धिविनाको बालक हो;","poem":2},{"text":"जन्मने समय हुँदा पनि त्यसमा","poem":1},{"text":"गर्भको मुखबाट बाहिर आउने समझ त्यसमा हुँदैन।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"म तिनीहरूलाई चिहानको शक्तिबाट मोल तिरेर छुटाउनेछु;","poem":1},{"text":"म तिनीहरूलाई मृत्युबाट छुटकारा दिनेछु।","poem":2},{"text":"हे मृत्यु, तेरा विपत्तिहरू कहाँ छन्?","poem":1},{"text":"हे चिहान, तेरो विनाश कहाँ छ?","poem":2},{"lineBreak":true},{"text":"“म अलिकति पनि दया देखाउनेछैनँ;","poem":1}]},{"type":"verse","number":15,"content":[{"text":"यदि त्यो आफ्ना दाजुभाइहरूको बीचमा फलदायी भए तापनि","poem":2},{"lineBreak":true},{"text":"म त्यसप्रति दयालु बन्‍नेछैनँ।","poem":2},{"text":"पूर्वीय बतास याहवेहबाट आउनेछ,","poem":1},{"text":"र त्यसलाई उजाडस्थानबाट उडाएर लैजानेछ;","poem":2},{"text":"त्यसको पानीको मूल बन्द हुनेछ,","poem":1},{"text":"र त्यसको पानीको कुवा सुक्नेछ।","poem":2},{"text":"त्यसको भण्डारबाट त्यसका सबै","poem":1},{"text":"बहुमूल्य कुराहरू लुटिनेछन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"सामरियाका मानिसहरूले तिनीहरूका अपराधको प्रतिफल भोग्नुपर्छ;","poem":1},{"text":"किनकि तिनीहरूले आफ्ना परमेश्‍वरको विरुद्धमा विद्रोह गरेका छन्।","poem":2},{"text":"तिनीहरू तरवारद्वारा मारिनेछन्;","poem":1},{"text":"तिनीहरूका साना छोराछोरीहरू भुइँमा पछारिनेछन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूका गर्भवती स्त्रीहरूका पेट चिरेर उदाङ्गो पारिनेछन्।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}