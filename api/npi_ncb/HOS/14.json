{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["आशिष् ल्याउनका लागि पश्‍चात्ताप"]},{"type":"verse","number":1,"content":[{"text":"हे इस्राएल, याहवेह आफ्ना परमेश्‍वरकहाँ फर्की।","poem":1},{"text":"तेरा पापहरू नै तेरा पतनका कारण हुन्!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"आफूसँग वचनहरू लिएर","poem":1},{"text":"याहवेहतिर फर्क।","poem":2},{"text":"उहाँलाई भन:","poem":1},{"text":"“हाम्रा सबै पापहरू क्षमा गर्नुहोस्,","poem":2},{"text":"र हामीलाई अनुग्रहसाथ स्वीकार गर्नुहोस्,","poem":1},{"text":"ताकि हामी हाम्रा ओठका भेटीहरू चढाउन सकौँ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"अश्शूर देशले हामीलाई बचाउन सक्दैन;","poem":1},{"text":"हामी युद्धका घोडाहरूमाथि सवार हुनेछैनौँ।","poem":2},{"text":"हामी फेरि कहिल्यै पनि आफ्ना हातले बनाएका कुराहरूलाई","poem":1},{"text":"‘हाम्रा देवताहरू’ भन्‍ने छैनौँ;","poem":2},{"lineBreak":true},{"text":"किनकि तपाईंबाट नै टुहुरा-टुहुरीले दया पाउँछन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“म तिनीहरूको पथभ्रष्‍टतालाई निको पार्नेछु,","poem":1},{"text":"र तिनीहरूलाई स्वेच्छाले प्रेम गर्नेछु;","poem":2},{"lineBreak":true},{"text":"किनकि मेरो रिस तिनीहरूबाट हटिसकेको छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"म इस्राएलको निम्ति शीतजस्तो बन्‍नेछु;","poem":1},{"text":"त्यो लिली फूलझैँ फुल्नेछ।","poem":2},{"text":"लेबनानको देवदारुझैँ","poem":1},{"text":"त्यसले आफ्ना जराहरू गहिराइसम्म फैलाउनेछ;","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"त्यसका कलिला मुनाहरू बढ्नेछन्।","poem":2},{"text":"त्यसको शोभा जैतुनको रूखझैँ हुनेछ,","poem":1},{"text":"र त्यसको बास्‍ना लेबनानको देवदारुझैँ हुनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मानिसहरू फेरि त्यसको छहारीमा बस्‍नेछन्;","poem":1},{"text":"तिनीहरू अन्‍नझैँ लहलहाउने छन्;","poem":2},{"text":"तिनीहरू दाखको बोटझैँ फक्रनेछन्;","poem":1},{"text":"इस्राएलको प्रसिद्धि लेबनानको दाखमद्यजस्तै हुनेछ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हे एफ्राइम, मूर्तिहरूसँग मेरो के काम?","poem":1},{"text":"म त्यसलाई जवाफ दिनेछु र त्यसको हेरचाह गर्नेछु।","poem":2},{"text":"म हरियो धूपी सल्‍लाको रूखझैँ छु;","poem":1},{"text":"तेरो फल मबाट नै आउँछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"बुद्धिमान् को छ? तिनीहरूले यी कुराहरू थाहा गरून्।","poem":1},{"text":"समझदार को छ? तिनीहरूले यी कुराहरू बुझ्न सकून्।","poem":2},{"text":"याहवेहका मार्गहरू ठिक छन्;","poem":1},{"text":"धर्मी जनहरू त्यसैमा हिँड्छन्,","poem":2},{"lineBreak":true},{"text":"तर विद्रोहीहरूले भने त्यसैमा ठक्‍कर खान्छन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}