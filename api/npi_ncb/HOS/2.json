{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["“आफ्ना दाजुभाइहरूलाई ‘अम्मी’",{"noteId":2},"र दिदीबहिनीहरूलाई ‘रूहामा’",{"noteId":3},"भन्।"]},{"type":"heading","content":["इस्राएलको दण्ड र पुनर्स्थापना"]},{"type":"verse","number":2,"content":[{"text":"“आफ्नी आमालाई हप्काओ, त्यसलाई हप्काओ;","poem":1},{"text":"किनकि त्यो मेरी पत्नी होइनँ,","poem":2},{"lineBreak":true},{"text":"र म पनि त्यसको पति होइनँ।","poem":2},{"text":"त्यसले आफ्नो अनुहारबाट व्यभिचारको रूप","poem":1},{"text":"र आफ्नो स्तनको बीचबाट विश्‍वासघातलाई हटाओस्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"नत्रता म त्यसलाई वस्त्रहीन पार्नेछु,","poem":1},{"text":"र त्यसलाई जन्मेको दिनमा जस्तै नाङ्गै पार्नेछु;","poem":2},{"text":"म त्यसलाई मरुभूमिजस्तै बनाइदिनेछु;","poem":1},{"text":"त्यसलाई सुक्खा भूमिमा परिणत गरिदिनेछु,","poem":2},{"lineBreak":true},{"text":"र त्यसलाई तिर्खाले मार्नेछु।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"म त्यसका कुनै छोराछोरीहरूलाई दया देखाउनेछैनँ;","poem":1},{"text":"किनकि तिनीहरू व्यभिचारबाट जन्मिएका सन्तान हुन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिनीहरूकी आमाले विश्‍वासघात गरेकी छे,","poem":1},{"text":"र तिनीहरूलाई कलङ्कित अवस्थामा गर्भधारण गरेकी छे।","poem":2},{"text":"त्यसले भनी, ‘म मेरा प्रेमीहरूको पछि जानेछु,","poem":1},{"text":"जसले मलाई मेरो भोजन, पानी,","poem":2},{"lineBreak":true},{"text":"ऊन, सुती कपडा, तेल र दाखरस दिन्छन्।’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यसकारण म त्यसको बाटो काँडाघारीले बन्द गरिदिनेछु;","poem":1},{"text":"त्यसले कुनै पनि बाटो नपाओस् भनेर म त्यसलाई पर्खालले बन्द गरिदिनेछु।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्यो आफ्ना प्रेमीहरूलाई पछ्याउँदै जानेछे,","poem":1},{"text":"तर त्यसले तिनीहरूलाई भेट्टाउन सक्दिन;","poem":2},{"lineBreak":true},{"text":"त्यसले प्रेमीहरूलाई खोज्नेछे, तर तिनीहरूलाई भेट्टाउनेछैन।","poem":2},{"text":"तब त्यसले भन्‍नेछे,","poem":1},{"text":"“म पहिलेझैँ मेरो पतिकहाँ फर्केर जानेछु;","poem":2},{"lineBreak":true},{"text":"किनकि अहिलेभन्दा त पहिलाको अवस्था नै राम्रो थियो।”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"त्यसले बुझेकै छैन,","poem":1},{"text":"त्यसलाई अन्‍न, नयाँ दाखरस र जैतुन तेल दिने म नै हुँ;","poem":2},{"text":"मैले त्यसलाई प्रशस्त सुन र चाँदी दिएँ,","poem":1},{"text":"तर त्यसले त्यो बाल-देवताको निम्ति प्रयोग गरी।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“यसकारण जब मेरो अन्‍न पाक्छ,","poem":1},{"text":"र मेरो नयाँ दाखरस तयार हुन्छ, तब म लैजानेछु।","poem":2},{"text":"त्यसको नग्नता ढाक्नलाई तयार गरिएको","poem":1},{"text":"मेरो ऊन र मेरो सुती कपडा म खोसेर लैजानेछु।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"यसकारण अब म त्यसका प्रेमीहरूका आँखाको सामु","poem":1},{"text":"त्यसलाई नाङ्गो पारिदिनेछु;","poem":2},{"lineBreak":true},{"text":"कसैले त्यसलाई मेरो हातबाट छुटाउन सक्नेछैन।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"म त्यसका सबै उत्सवहरू:","poem":1},{"text":"त्यसका वार्षिक चाडहरू, त्यसका औँसीहरू,","poem":2},{"lineBreak":true},{"text":"त्यसका शब्बाथ दिनहरू; अनि त्यसका सबै तोकिएका चाडहरूको अन्त गर्नेछु।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"म त्यसका दाखहरू र नेभाराका बोटहरू नष्‍ट गरिदिनेछु,","poem":1},{"text":"जुन त्यसले आफ्ना प्रेमीहरूको सेवा गरेर मैले ज्याला पाएकी हुँ भनेकी छे;","poem":2},{"text":"म तिनीहरूलाई बाक्लो झाडी बनाइदिनेछु,","poem":1},{"text":"र जङ्गली जनावरहरूले ती खानेछन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"बाल-देवताहरूका निम्ति धूप बालेका हुनाले","poem":1},{"text":"म त्यसलाई दण्ड दिनेछु;","poem":2},{"text":"त्यसले आफूलाई गरगहनाहरूले सिँगारी,","poem":1},{"text":"र आफ्ना प्रेमीहरूको पछि लागी,","poem":2},{"lineBreak":true},{"text":"तर त्यसले मलाई बिर्सी, याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“यसकारण अब म त्यसलाई लोभ्याउन लागेको छु;","poem":1},{"text":"म त्यसलाई उजाडस्थानमा डोर्‍याउनेछु,","poem":2},{"lineBreak":true},{"text":"र त्यससँग मायालु कुरा गर्नेछु।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"त्यहाँ म त्यसलाई त्यसका दाखबारीहरू फर्काइदिनेछु,","poem":1},{"text":"र आकोरको","poem":2},{"noteId":4},{"text":"बेँसीलाई एउटा आशाको ढोका बनाइदिनेछु।","poem":2},{"text":"त्यहाँ त्यसले आफ्नो जवानीको दिनमा झैँ,","poem":1},{"text":"इजिप्टबाट निस्किआएको दिनमा झैँ गाउनेछे।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"text":"“त्यस दिन तैँले मलाई ‘मेरो मालिक’;","poem":2},{"lineBreak":true},{"text":"भन्‍न छोडेर ‘मेरा पति’ भन्‍नेछस्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"म त्यसको मुखबाट बाल-देवताहरूका नाम हटाइदिनेछु;","poem":1},{"text":"तिनीहरूका नामको उच्‍चारण फेरि कहिल्यै पनि हुनेछैन।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"त्यस दिन म तिनीहरूका निम्ति जङ्गलका जनावरहरू,","poem":1},{"text":"आकाशका चराचुरुङ्गीहरू","poem":2},{"lineBreak":true},{"text":"र जमिनमा हलचल गर्ने पशुप्राणीहरूसँग करार बाँध्नेछु।","poem":2},{"text":"म देशबाट धनु, तरवार","poem":1},{"text":"र युद्ध हटाइदिनेछु,","poem":2},{"lineBreak":true},{"text":"ताकि सबै जना सुरक्षित भएर विश्राम लिन सकून्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"म तँलाई सदाका निम्ति पत्नी तुल्याउनेछु;","poem":1},{"text":"म तँलाई धार्मिकतामा र न्यायमा,","poem":2},{"lineBreak":true},{"text":"प्रेममा र दयामा दुलही बनाउनेछु।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"म तँलाई विश्‍वासयोग्यतामा दुलही बनाउनेछु;","poem":1},{"text":"अनि तैँले याहवेहलाई चिन्‍नेछस्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"text":"“त्यस दिन म जवाफ दिनेछु,","poem":2},{"text":"म आकाशलाई जवाफ दिनेछु,","poem":1},{"text":"र आकाशले पृथ्वीलाई जवाफ दिनेछ;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"अनि पृथ्वीले अन्‍नलाई;","poem":1},{"text":"नयाँ दाखरस र जैतुन तेललाई जवाफ दिनेछ,","poem":2},{"lineBreak":true},{"text":"र तिनीहरूले यिजरेललाई","poem":2},{"noteId":5},{"text":"जवाफ दिनेछन्।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"म त्यसलाई आफ्नै निम्ति त्यस देशमा रोप्नेछु;","poem":1},{"text":"मैले जसलाई ‘मेरो प्रिय होइनँ’ भनेको थिएँ, त्यसलाई प्रेम देखाउनेछु।","poem":2},{"text":"मैले जसलाई ‘मेरो जाति होइनँ,’ भनेको थिएँ,","poem":1},{"text":"त्यसलाई ‘तिमीहरू मेरा जाति हौ,’ भन्‍नेछु;","poem":2},{"lineBreak":true},{"text":"अनि तिनीहरूले भन्‍नेछन्, ‘तपाईं मेरो परमेश्‍वर हुनुहुन्छ।’ ”","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"अथवा मेरा मानिसहरू","reference":{"chapter":2,"verse":1}},{"noteId":3,"caller":"+","text":"अथवा मेरा प्रिय","reference":{"chapter":2,"verse":1}},{"noteId":4,"caller":"+","text":"जसको अर्थ हो, दुःख","reference":{"chapter":2,"verse":15}},{"noteId":5,"caller":"+","text":"जसको अर्थ हो, परमेश्‍वरको बिरुवा","reference":{"chapter":2,"verse":22}}]},"thisChapterLink":"/api/npi_ncb/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}