{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["इस्राएलको विरुद्धमा आरोप"]},{"type":"verse","number":1,"content":[{"text":"हे इस्राएलका मानिसहरू हो, याहवेहको वचन सुन,","poem":1},{"text":"देशमा बस्‍नेहरूको विरुद्धमा","poem":2},{"lineBreak":true},{"text":"याहवेहले दोष लगाउनुभएको छ:","poem":2},{"text":"“यस देशमा विश्‍वासयोग्यता छैन, न त प्रेम नै छ;","poem":1},{"text":"परमेश्‍वरलाई स्वीकार गर्ने कोही पनि छैन।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"यहाँ श्राप, झूट र हत्या,","poem":1},{"text":"चोरी र व्यभिचार मात्र छन्;","poem":2},{"text":"तिनीहरूले सबै सीमाहरू नाघेका छन्;","poem":1},{"text":"अनि रक्तपातमाथि रक्तपात गर्दछन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"यसकारण देश उजाड भएको छ;","poem":1},{"text":"अनि देशमा बस्‍ने सबै मानिसहरू नष्‍ट भएका छन्;","poem":2},{"text":"जङ्गली जनावरहरू, आकाशमा उड्ने चराचुरुङ्गीहरू","poem":1},{"text":"र समुद्रका माछाहरू समेत नष्‍ट भएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“तर कुनै पनि मानिसले आरोप नलगाओस्,","poem":1},{"text":"न त कुनै मानिसले एक-अर्कालाई दोष लगाओस्;","poem":2},{"text":"किनकि तिमीहरूका मानिसहरू","poem":1},{"text":"पुजारीको विरुद्धमा दोष लगाउनेहरूजस्ता छन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिमीहरू दिनरात ठक्‍कर खान्छौ;","poem":1},{"text":"अनि अगमवक्ताहरू पनि तिमीहरूसँगै ठक्‍कर खान्छन्।","poem":2},{"text":"यसकारण म तिमीहरूकी आमालाई नाश गर्नेछु—","poem":1}]},{"type":"verse","number":6,"content":[{"text":"मेरा मानिसहरू ज्ञानको अभावले नष्‍ट भएका छन्।","poem":2},{"lineBreak":true},{"text":"“तिमीहरूले ज्ञानलाई इन्कार गरेको कारण,","poem":1},{"text":"म पनि तिमीहरूलाई मेरो पुजारी हुनलाई इन्कार गर्नेछु;","poem":2},{"text":"किनभने तिमीहरूले आफ्ना परमेश्‍वरको आज्ञालाई वास्ता गरेका छैनौ;","poem":1},{"text":"तसर्थ म पनि तिमीहरूका छोराछोरीहरूलाई वास्ता गर्नेछैनँ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"जति धेरै पुजारीहरू भए,","poem":1},{"text":"तिनीहरूले त्यत्ति नै मेरो विरुद्धमा धेरै पाप गरे;","poem":2},{"lineBreak":true},{"text":"तिनीहरूले आफ्ना महिमित परमेश्‍वरलाई घृणित कुराहरूसँग साटे।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरू मेरा मानिसहरूका पापद्वारा पोसिन्छन्,","poem":1},{"text":"र तिनीहरूका दुष्‍टताको स्वाद लिन्छन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"अनि यस्तो हुनेछ: जस्ता प्रजाहरू छन्, त्यस्तै पुजारीहरू हुनेछन्।","poem":1},{"text":"म ती दुवैलाई तिनीहरूको खराब चालचलनको निम्ति दण्ड दिनेछु,","poem":2},{"lineBreak":true},{"text":"र तिनीहरूका कामहरूको प्रतिफल तिनीहरूलाई दिनेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“तिनीहरूले खानेछन्, तर सन्तुष्‍टि हुनेछैनन्;","poem":1},{"text":"तिनीहरू वेश्यावृत्तिमा संलग्न हुनेछन्, तर तृप्‍त हुनेछैनन्;","poem":2},{"text":"तिनीहरू वेश्यावृत्तिमा सामेल हुनका लागि","poem":1},{"text":"तिनीहरूले","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेहलाई त्यागेका छन्;","poem":2},{"text":"पुरानो दाखमद्य र नयाँ दाखमद्यले","poem":1},{"text":"मेरा प्रजाको समझशक्ति नष्‍ट पारिदिन्छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मेरा मानिसहरूले काठको मूर्तिसित सल्‍लाह लिन्छन्,","poem":1},{"text":"र तिनीहरूका जोखना हेर्नेले काठको लहुरोसँग कुराकानी गर्छन्।","poem":2},{"text":"वेश्यावृत्तिको आत्माले तिनीहरूलाई बहकाउँछ;","poem":1},{"text":"तिनीहरू आफ्ना परमेश्‍वरप्रति अविश्‍वासयोग्य छन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तिनीहरूले पर्वतका टाकुराहरूमा बलिदान चढाउँछन्;","poem":1},{"text":"अनि डाँडाहरूमा होमबलिहरू चढाउँछन्;","poem":2},{"text":"तिनीहरूले राम्रो छाया भएको ठाउँ, झ्याम्म परेका फलाँट, लहरे-पीपल","poem":1},{"text":"र तारपीनको रूखमुनि बलिदान चढाउँछन्।","poem":2},{"text":"यसकारण तिमीहरूका छोरीहरू वेश्यावृत्तिमा","poem":1},{"text":"र तिमीहरूका बुहारीहरू व्यभिचारमा लागेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“जब तिमीहरूका छोरीहरूले वेश्यावृत्ति गर्छन्,","poem":1},{"text":"म तिमीहरूका छोरीहरूलाई दण्ड दिनेछैनँ;","poem":2},{"text":"न त तिमीहरूका बुहारीहरूलाई नै दण्ड दिनेछु;","poem":1},{"text":"जसले व्यभिचार गर्छन्;","poem":2},{"text":"किनकि पुरुषहरू आफैँ वेश्याहरूतिर लागेका छन्,","poem":1},{"text":"र देवदासीहरूसँग बलिदान चढाउँछन्—","poem":2},{"lineBreak":true},{"text":"समझशक्ति नभएका मानिसहरू नष्‍ट हुनेछन्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“हे इस्राएल, तैँले व्यभिचार गरे तापनि","poem":1},{"text":"यहूदाचाहिँ दोषी नठहरिओस्।","poem":2},{"lineBreak":true},{"text":"“तिमीहरू गिलगालमा नजाओ;","poem":1},{"text":"न त बेथ-आवेनमा","poem":2},{"noteId":8},{"text":"उक्लेर जाओ।","poem":2},{"lineBreak":true},{"text":"न त ‘जीवित याहवेहको नाममा,’ शपथ खाओ!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"इस्राएलका मानिसहरू हठी छन्;","poem":1},{"text":"ढीट कोरलीझैँ छन्।","poem":2},{"text":"तब कसरी याहवेहले तिनीहरूलाई चरनमा","poem":1},{"text":"थुमालाई चराएजस्तै चराउन सक्नुहुनेछ त?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"एफ्राइम मूर्तिसँग जोडिएको छ;","poem":1},{"text":"त्यसलाई आफ्नै चालमा छोडिदेओ!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तिनीहरूको मद्य सकिए तापनि","poem":1},{"text":"तिनीहरू वेश्यावृत्तिमा निरन्तर लागिरहन्छन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूका शासकहरू लाजलाग्दो मार्गलाई अति मन पराउँछन्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"आँधीबेहरीले तिनीहरूलाई उडाएर लैजानेछ;","poem":1},{"text":"अनि तिनीहरूका बलिदानहरूले तिनीहरूलाई लाजमा पार्नेछ।","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"जसको अर्थ हो, दुष्‍टताको घर","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/npi_ncb/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}