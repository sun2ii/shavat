{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["इस्राएलको विरुद्धमा न्याय"]},{"type":"verse","number":1,"content":[{"text":"“हे पुजारीहरू हो, यो कुरा सुन!","poem":1},{"text":"हे इस्राएलीहरू हो, ध्यान दिएर सुन!","poem":2},{"text":"हे राजकीय घराना हो, ध्यानसित सुन!","poem":1},{"text":"यो न्याय तिमीहरूको विरुद्धमा छ:","poem":2},{"text":"तिमीहरू मिस्पामा पासोझैँ बनेका छौ,","poem":1},{"text":"र तिमीहरू तबोरमा फिँजाइराखेका जाल भएका छौ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"विद्रोहीहरू हत्याको गहिराइमा फसेका छन्;","poem":1},{"text":"म तिनीहरू सबैलाई अनुशासित तुल्याउनेछु।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"म एफ्राइमको बारेमा सबै कुरा जान्दछु;","poem":1},{"text":"इस्राएल मदेखि लुकेको छैनँ।","poem":2},{"text":"एफ्राइम, तँ अब वेश्यावृत्तिमा लागेको छस्;","poem":1},{"text":"इस्राएल भ्रष्‍ट भएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“तिनीहरूका कामहरूले तिनीहरूलाई","poem":1},{"text":"आफ्ना परमेश्‍वरतर्फ फर्कन दिँदैन।","poem":2},{"text":"तिनीहरूका हृदयमा वेश्यावृत्तिको आत्मा छ;","poem":1},{"text":"तिनीहरूले याहवेहलाई मान्यता दिँदैनन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"इस्राएलको अहङ्कारले तिनीहरूको विरुद्धमा साक्षी दिन्छ;","poem":1},{"text":"इस्राएल र एफ्राइम पनि आ-आफ्नो पापमा ठक्‍कर खानेछन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूसँग यहूदाले पनि ठक्‍कर खानेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जब तिनीहरू याहवेहलाई खोज्न","poem":1},{"text":"आफ्ना बगालहरू र बथानहरूसँग जान्छन्,","poem":2},{"text":"तब तिनीहरूले उहाँलाई भेट्टाउनेछैनन्;","poem":1},{"text":"उहाँले आफैँलाई तिनीहरूदेखि अलग गर्नुभएको छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरू याहवेहप्रति विश्‍वासघाती भएका छन्;","poem":1},{"text":"तिनीहरूले अवैध छोराछोरीहरू जन्माउँछन्।","poem":2},{"text":"जब तिनीहरूले नयाँ औँसीका चाडपर्वहरू मनाउँछन्,","poem":1},{"text":"तब ती चाडपर्वहरूले तिनीहरूका खेतहरू निल्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“गेबामा तुरही फुक,","poem":1},{"text":"रामामा बिगुल फुक।","poem":2},{"text":"बेथ-आवेनमा युद्धको ध्वनि उठाओ;","poem":1},{"text":"हे बेन्यामीन, अगुवाइ गर।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"न्यायको दिनमा","poem":1},{"text":"एफ्राइमलाई उजाड पारिनेछ।","poem":2},{"text":"इस्राएलका कुलहरूका बीचमा","poem":1},{"text":"यी कुराहरू निश्‍चित छन्, म घोषणा गर्दछु।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"यहूदाका अगुवाहरू","poem":1},{"text":"सिमानाका ढुङ्गाहरू हटाउनेहरूजस्ता छन्।","poem":2},{"text":"म तिनीहरूमाथि वर्षाको बाढीजस्तै","poem":1},{"text":"मेरो क्रोध खन्याउनेछु।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"एफ्राइम थिचोमिचोमा परेको छ,","poem":1},{"text":"न्यायमा त्यो कुल्चीमिल्ची भएको छ;","poem":2},{"lineBreak":true},{"text":"त्यसले मूर्तिको पछि हिँड्नलाई अठोट गरेको छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"म एफ्राइमको निम्ति कपडा खाने किराजस्तै छु,","poem":1},{"text":"र यहूदाका मानिसहरूका निम्ति म ढुसीजस्तै छु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“जब एफ्राइमले आफ्नो रोग देख्यो","poem":1},{"text":"र यहूदाले आफ्नो चोट देख्यो,","poem":2},{"text":"तब एफ्राइम अश्शूरतिर फर्क्यो,","poem":1},{"text":"र महान् राजाकहाँ सहायताको निम्ति मानिस पठायो।","poem":2},{"text":"तर त्यसले तँलाई निको पार्न सक्दैन;","poem":1},{"text":"त्यसले तेरा घाउ निको पार्न सक्दैन।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"किनकि म एफ्राइमको निम्ति एउटा सिंहजस्तै","poem":1},{"text":"र यहूदाको निम्ति एउटा ठूलो सिंहजस्तै हुनेछु।","poem":2},{"text":"म तिनीहरूलाई टुक्रा-टुक्रा पार्नेछु र गइहाल्नेछु;","poem":1},{"text":"म तिनीहरूलाई उठाएर लैजानेछु, र तिनीहरूलाई छुटाउने कोही पनि हुनेछैन।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"जबसम्म तिनीहरूले आफ्नो दोष स्वीकार गर्दैनन्,","poem":1},{"text":"र तिनीहरूले मेरो अनुहार खोज्दैनन्,","poem":2},{"lineBreak":true},{"text":"तबसम्म म फर्केर आफ्नै ठाउँमा रहनेछु;","poem":2},{"text":"अनि आफ्नो कष्‍टमा","poem":1},{"text":"तिनीहरूले मलाई यत्नपूर्वक खोज्नेछन्।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}