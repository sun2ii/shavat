{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["पश्‍चात्ताप नगर्ने इस्राएल"]},{"type":"verse","number":1,"content":[{"text":"“आओ, हामी याहवेहतिर फर्कौँ।","poem":1},{"lineBreak":true},{"text":"उहाँले हामीलाई टुक्रा-टुक्रा पार्नुभएको छ,","poem":1},{"text":"तर उहाँले हामीलाई निको पार्नुहुनेछ;","poem":2},{"text":"उहाँले हामीलाई चोट पार्नुभएको छ,","poem":1},{"text":"तर उहाँले हाम्रा चोटहरूमा मलमपट्टी बाँध्नुहुनेछ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"दुई दिनपछि उहाँले हामीलाई पुनर्जीवित पार्नुहुनेछ;","poem":1},{"text":"तेस्रो दिन उहाँले हामीलाई पुनर्स्थापित गर्नुहुनेछ,","poem":2},{"lineBreak":true},{"text":"र हामी उहाँको उपस्थितिमा जीवित रहनेछौँ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हामी याहवेहलाई स्वीकार गरौँ;","poem":1},{"text":"हामी दृढतासाथ उहाँलाई स्वीकार गरौँ।","poem":2},{"text":"निश्‍चय नै सूर्य उदाएझैँ","poem":1},{"text":"उहाँ देखा पर्नुहुनेछ;","poem":2},{"text":"उहाँ हामीकहाँ हिउँदको झरीझैँ","poem":1},{"text":"र पृथ्वीलाई भिजाउने बसन्तको वर्षाझैँ आउनुहुनेछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“हे एफ्राइम, म तँलाई के गरूँ?","poem":1},{"text":"हे यहूदा, म तँलाई के गरूँ?","poem":2},{"text":"तेरो प्रेम बिहानको कुइरोझैँ","poem":1},{"text":"र मिरमिरे बिहानको शीतजस्तै बिलाएर जान्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यसकारण मैले तँलाई मेरा अगमवक्ताहरूसँग काटेर टुक्रा-टुक्रा पारेको छु;","poem":1},{"text":"मैले तँलाई मेरो मुखका वचनहरूद्वारा मारेको छु;","poem":2},{"lineBreak":true},{"text":"त्यसपछि मेरो न्याय सूर्यजस्तै अगाडि बढ्छ।","poem":2},{"noteId":9}]},{"type":"verse","number":6,"content":[{"text":"किनकि म बलिदान होइन, तर दया चाहन्छु,","poem":1},{"text":"र होमबलिहरूभन्दा परमेश्‍वरलाई चिनेको म चाहन्छु।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"आदमले जस्तै","poem":1},{"noteId":10},{"text":"तिनीहरूले मेरो करार भङ्ग गरेका छन्;","poem":1},{"text":"तिनीहरूले त्यहाँ मप्रति विश्‍वासघात गरेका छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"गिलाद दुष्‍ट मानिसहरूको सहर हो,","poem":1},{"text":"र त्यो सहर रगतका पाइलाहरूले भरिएको छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जसरी लुटेराहरूले मानिसलाई ढुकिबस्छन्,","poem":1},{"text":"त्यसरी नै पुजारीहरूको समूहले ढुकिबस्छन्;","poem":2},{"text":"आफ्ना दुष्‍ट योजनाहरू पूरा गर्न","poem":1},{"text":"तिनीहरूले शेकेमको पवित्रस्थानतिर जाने मानिसहरूलाई बाटोमा हत्या गर्छन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मैले इस्राएलको घरानामा एउटा भयानक कुरा देखेको छु:","poem":1},{"text":"त्यहाँ एफ्राइमलाई वेश्यावृत्तिको लागि दिइएको छ,","poem":2},{"lineBreak":true},{"text":"इस्राएल अपवित्र पारिएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“मैले मेरा मानिसहरूको सुदिन पुनर्स्थापित गर्दा,","poem":1},{"text":"हे यहूदा, तेरो निम्ति पनि","poem":2},{"lineBreak":true},{"text":"कटनीको समय तोकिएको छ।","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"हिब्रूमा यसको अर्थ अनिश्‍चित छ।","reference":{"chapter":6,"verse":5}},{"noteId":10,"caller":"+","text":"आदमले जस्तै अथवा मानव जातिले जस्तै","reference":{"chapter":6,"verse":7}}]},"thisChapterLink":"/api/npi_ncb/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}