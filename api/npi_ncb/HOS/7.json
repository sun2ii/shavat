{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"“जब म इस्राएललाई निको पार्नेछु,","poem":1},{"text":"एफ्राइमको पाप उदाङ्गो हुन्छ;","poem":2},{"lineBreak":true},{"text":"र सामरियाका अपराधहरू प्रकट हुन्छन्।","poem":2},{"text":"तिनीहरूले छलपूर्ण व्यवहार गर्छन्;","poem":1},{"text":"चोरहरू घर फोरेर घरभित्र पस्छन्,","poem":2},{"lineBreak":true},{"text":"डाँकुहरूले सडकहरूमा लुटपाट गर्छन्;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तर तिनीहरूले यो बुझ्दैनन्,","poem":1},{"text":"म तिनीहरूका सबै दुष्‍ट कामहरूको स्मरण गर्छु।","poem":2},{"text":"तिनीहरूका पापहरूले तिनीहरूलाई ढाकेका छन्;","poem":1},{"text":"तिनीहरू सधैँ मेरो सामु छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“तिनीहरूले राजालाई आफ्ना दुष्‍टताले","poem":1},{"text":"र शासकहरूलाई झूटले खुशी तुल्याउँछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरू जलिरहेका भट्टीजस्तै","poem":1},{"text":"सबै व्यभिचारीहरू छन्,","poem":2},{"text":"जसको आगो पकाउनेले पिठो मुछेदेखि रोटी नपाकुन्जेल","poem":1},{"text":"त्यसले दाउरा नचलाए तापनि सल्किरहन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हाम्रा राजाको चाडको दिनमा","poem":1},{"text":"शासकहरू मद्य पिएर चुर हुन्छन्,","poem":2},{"lineBreak":true},{"text":"र तिनले गिल्‍ला गर्नेहरूसँग पनि हात मिलाउँछन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिनीहरूको हृदय भट्टीजस्तै छ;","poem":1},{"text":"तिनीहरूले त्यसलाई षड्यन्त्रका साथ भेट्छन्।","poem":2},{"text":"तिनीहरूको क्रोध रातभरि जलिरहन्छ;","poem":1},{"text":"बिहान त्यो दन्किरहेको आगोजस्तै हुन्छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरू सबै आगोको भट्टीजस्तै ताता छन्;","poem":1},{"text":"तिनीहरूले आफ्ना शासकहरूलाई भस्म पार्छन्।","poem":2},{"text":"तिनीहरूका सबै राजाहरू मारिन्छन्,","poem":1},{"text":"तर तिनीहरू कसैले पनि मलाई पुकार्दैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“एफ्राइम अन्य राष्ट्रहरूसँग घुलमिल हुन्छ;","poem":1},{"text":"एफ्राइम एकापट्टि मात्र पोलेको रोटीजस्तै हो।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"विदेशीहरूले त्यसको शक्ति नाश पारेका छन्,","poem":1},{"text":"तर पनि त्यसले त्यो जान्दैन।","poem":2},{"text":"त्यसका केश फूलेका छन्,","poem":1},{"text":"तर पनि त्यसले त्यो जान्दैन।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"इस्राएलको अहङ्कारले उहाँको विरुद्धमा गवाही दिन्छ,","poem":1},{"text":"तर यी सबै कुराहरू भए तापनि","poem":2},{"text":"त्यो याहवेह आफ्ना परमेश्‍वरकहाँ फर्कंदैन,","poem":1},{"text":"न त उहाँको खोजी गर्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“एफ्राइम ढुकुरजस्तो छ,","poem":1},{"text":"सजिलै बहकाउन सकिने मूर्ख,","poem":2},{"text":"त्यसले कहिले इजिप्टलाई पुकार्छ भने,","poem":1},{"text":"कहिले त्यो अश्शूरतिर फर्कन्छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जब तिनीहरू जान्छन्, म तिनीहरूमाथि मेरो जाल फिँजाउनेछु;","poem":1},{"text":"म तिनीहरूलाई आकाशका पक्षीहरूलाई जस्तै तल झार्नेछु।","poem":2},{"text":"जब तिनीहरू एक ठाउँमा सँगै भेला भएको सुन्छु,","poem":1},{"text":"तब म तिनीहरूलाई पक्रनेछु।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"धिक्‍कार तिनीहरूलाई!","poem":1},{"text":"किनकि तिनीहरू मदेखि तर्किगएका छन्!","poem":2},{"text":"तिनीहरू नष्‍ट होऊन्;","poem":1},{"text":"किनकि तिनीहरूले मेरो विरुद्धमा विद्रोह गरेका छन्!","poem":2},{"text":"म तिनीहरूलाई छुटकारा दिने उत्कट इच्छा राख्दछु,","poem":1},{"text":"तर तिनीहरू मेरो विरुद्धमा झूट बोल्छन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तिनीहरू आफ्ना हृदयदेखि मलाई पुकार गर्दैनन्,","poem":1},{"text":"तर तिनीहरू आफ्ना ओछ्यानमा विलाप गर्छन्।","poem":2},{"text":"तिनीहरू अन्‍न र नयाँ दाखमद्यका","poem":1},{"text":"निम्ति आफैँलाई घाइते पार्छन्, तिनीहरूका देवताहरूसँग पुकार गर्छन्,","poem":2},{"lineBreak":true},{"text":"तर मदेखि भने तिनीहरू तर्किएर जान्छन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"मैले तिनीहरूलाई तालिम दिएँ र तिनीहरूका पाखुरा बलियो बनाएँ,","poem":1},{"text":"तर तिनीहरू मेरो विरुद्धमा दुष्‍ट युक्ति रच्दछन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तिनीहरू सर्वोच्‍चकहाँ फर्कंदैनन्;","poem":1},{"text":"तिनीहरू व्यर्थैको बाङ्गो धनुजस्तै छन्।","poem":2},{"text":"तिनीहरूका अगुवाहरू तिनीहरूका अहङ्कारी","poem":1},{"text":"कुराहरूको कारण तरवारद्वारा नष्‍ट हुनेछन्।","poem":2},{"text":"यसको कारण तिनीहरू","poem":1},{"text":"इजिप्ट देशमा हाँसोको पात्र बन्‍नेछन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}