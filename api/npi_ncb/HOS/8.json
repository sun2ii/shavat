{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["इस्राएलले भुमरीको कटनी गरेको"]},{"type":"verse","number":1,"content":[{"text":"“तुरहीलाई आफ्नो ओठमा राख!","poem":1},{"text":"शत्रु चीलजस्तै याहवेहको भवनमाथि घुम्दैछ,","poem":2},{"text":"किनकि मानिसहरूले मेरो करार भङ्ग गरेका छन्,","poem":1},{"text":"र मेरो व्यवस्थाको विरुद्धमा विद्रोही भएका छन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"इस्राएलले मलाई पुकार गर्छ,","poem":1},{"text":"‘हे हाम्रा परमेश्‍वर, हामी तपाईंलाई स्वीकार गर्छौँ!’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तर इस्राएलले असल कुरालाई तिरस्कार गरेको कारण","poem":1},{"text":"शत्रुले त्यसलाई खेद्नेछ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरूले मेरो स्वीकृतिविना राजाहरू खडा गर्छन्;","poem":1},{"text":"तिनीहरूले मेरो सहमतिविना राजकुमारहरू नियुक्त गर्छन्।","poem":2},{"text":"तिनीहरूले आफ्नै विनाशको निम्ति","poem":1},{"text":"आफ्ना सुन र चाँदीबाट","poem":2},{"lineBreak":true},{"text":"आफ्ना निम्ति मूर्तिहरू बनाउँछन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे सामरिया, तिमीहरूको बाछाको मूर्ति फ्याँकिदेओ!","poem":1},{"text":"तिनीहरूको विरुद्धमा मेरो रिस दन्केको छ।","poem":2},{"text":"कहिलेसम्म तिनीहरू अशुद्ध भइरहन्छन्?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"तिनीहरू इस्राएलका हुन्!","poem":2},{"text":"यो बाछा एक जना कारिगरले बनाएको हो;","poem":1},{"text":"त्यो परमेश्‍वर हुँदै होइन।","poem":2},{"text":"तर सामरियाको त्यो बाछा","poem":1},{"text":"टुक्रा-टुक्रा पारिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“तिनीहरूले बतास छर्दछन्,","poem":1},{"text":"र आँधीबेहरीको कटनी गर्दछन्।","poem":2},{"text":"गहुँको डाँठमा बाला छैन;","poem":1},{"text":"त्यसबाट पिठो पनि निस्कनेछैन।","poem":2},{"text":"यदि त्यसले अन्‍न फलाए तापनि","poem":1},{"text":"विदेशीहरूले त्यसलाई निलिदिनेछन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"इस्राएल निलिएको छ;","poem":1},{"text":"अब त्यो राष्ट्रहरूको बीचमा","poem":2},{"lineBreak":true},{"text":"कसैले नचाहने वस्तुजस्तै भएको छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"किनकि तिनीहरू एकलै डुलिहिँड्ने","poem":1},{"text":"जङ्गली गधाजस्तै अश्शूरतिर गएका छन्।","poem":2},{"lineBreak":true},{"text":"एफ्राइमले आफूलाई प्रेमीहरूका हातमा ज्यालामा बेचेकी छ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिनीहरूले आफूलाई राष्ट्रहरूमा बेचे तापनि","poem":1},{"text":"अब म तिनीहरूलाई एकसाथ भेला गर्नेछु।","poem":2},{"text":"शक्तिशाली राजाको थिचोमिचोमा","poem":1},{"text":"परेर तिनीहरू नाश हुन थाल्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“एफ्राइमले पापबलिका निम्ति धेरै वेदीहरू बनाए तापनि","poem":1},{"text":"ती वेदीहरू त्यसका निम्ति पाप गर्ने कारण भएका छन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मैले तिनीहरूका निम्ति मेरा व्यवस्थाका धेरै कुराहरू लेखिदिएको छु;","poem":1},{"text":"तर तिनीहरूले ती व्यवस्थालाई कुनै विदेशी वस्तुझैँ ठाने।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तिनीहरूले मलाई बलिदानहरू चढाउँछन्,","poem":1},{"text":"र मासुचाहिँ तिनीहरूले खान्छन्;","poem":2},{"lineBreak":true},{"text":"त्यसैले याहवेह तिनीहरूसँग प्रसन्‍न हुनुहुन्‍न।","poem":2},{"text":"यसकारण उहाँले तिनीहरूको दुष्‍टता सम्झनुहुनेछ,","poem":1},{"text":"र तिनीहरूका पापको दण्ड दिनुहुनेछ:","poem":2},{"lineBreak":true},{"text":"तिनीहरू फेरि इजिप्टमा फर्किजानेछन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"इस्राएलले आफ्ना सृष्‍टिकर्तालाई बिर्सिएको छ,","poem":1},{"text":"र महलहरू बनाएको छ;","poem":2},{"lineBreak":true},{"text":"यहूदाले धेरै सहरहरूलाई सुरक्षित पर्खालले घेरेको छ।","poem":2},{"text":"तर म तिनीहरूका सहरहरूमा आगो पठाउनेछु,","poem":1},{"text":"जसले तिनीहरूका गढहरूलाई भस्म पार्नेछ।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}