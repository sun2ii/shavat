{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"HOS","translationId":"npi_ncb","name":"होशे","commonName":"होशे","title":"होशेको भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"983d1da1eae982935d064859f6d1d8f4549f88c8341ccd448d65eab9667af525","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["इस्राएलको निम्ति दण्ड"]},{"type":"verse","number":1,"content":[{"text":"हे इस्राएल, रमाइलो नगर्;","poem":1},{"text":"अरू राष्ट्रहरूजस्तै हर्षले उत्सव नमना।","poem":2},{"text":"किनकि तँ आफ्ना परमेश्‍वरप्रति विश्‍वासघाती भएको छस्;","poem":1},{"text":"तैँले हरेक खलामा वेश्यावृत्तिको","poem":2},{"lineBreak":true},{"text":"ज्याला मन पराएको छस्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"खला र दाखरसको कोलहरूले मानिसहरूलाई खुवाउने छैनन्;","poem":1},{"text":"तिनीहरूलाई नयाँ दाखरसको अभाव हुनेछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरू याहवेहको देशमा बस्‍नेछैनन्;","poem":1},{"text":"एफ्राइम फेरि इजिप्टतिर फर्कनेछ,","poem":2},{"lineBreak":true},{"text":"र अश्शूरमा अशुद्ध भोजन खानेछ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरूले याहवेहकहाँ दाखरसको भेटी चढाउनेछैनन्,","poem":1},{"text":"न त तिनीहरूका बलिदानहरूले उहाँलाई खुशी तुल्याउनेछ।","poem":2},{"text":"यस्ता बलिदानहरू तिनीहरूका निम्ति विलाप गर्नेहरूको रोटीजस्ता हुनेछन्;","poem":1},{"text":"ती रोटी खाने सबै अशुद्ध हुनेछन्।","poem":2},{"text":"त्यो भोजन तिनीहरूकै भोकको निम्ति मात्र हुनेछ;","poem":1},{"text":"त्यो याहवेहको मन्दिरमा आउनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“तेरा निम्ति तोकिएका चाडहरूको दिनमा,","poem":1},{"text":"याहवेहका चाडका दिनहरूमा, तैँले के गर्नेछस्?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यदि तिनीहरू विनाशबाट भागे तापनि","poem":1},{"text":"इजिप्टले तिनीहरूलाई जम्मा गर्नेछ,","poem":2},{"lineBreak":true},{"text":"र मेम्फिसका मानिसहरूले तिनीहरूलाई गाड्नेछन्।","poem":2},{"text":"तिनीहरूका चाँदीका भण्डारहरूलाई सिस्‍नुघारीले छोप्नेछ,","poem":1},{"text":"र तिनीहरूका पालहरूलाई काँडाघारीले ढाक्नेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"इस्राएलले यो कुरा थाहा गरोस्,","poem":1},{"text":"दण्डका दिनहरू आइरहेका छन्;","poem":2},{"lineBreak":true},{"text":"प्रतिशोधका दिनहरू ज्यादै नजिकै छन्।","poem":2},{"text":"किनभने तेरा पापहरू अति धेरै छन्,","poem":1},{"text":"तेरो शत्रुता धेरै भएको कारण","poem":2},{"text":"तैँले अगमवक्तालाई मूर्ख र प्रेरणा पाएको","poem":1},{"text":"मानिसलाई बौलाहासरह ठान्छस्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"अगमवक्ता मेरा परमेश्‍वरको साथसाथै","poem":1},{"text":"एफ्राइमको पनि पहरेदार हो;","poem":2},{"text":"तरै पनि त्यसका सबै बाटोहरूमा त्यसलाई पासो","poem":1},{"text":"र त्यसका परमेश्‍वरको भवनमा शत्रुताले पर्खिरहेको हुन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरू गेबाका दिनमा जस्तै,","poem":1},{"text":"भ्रष्‍टाचारमा चुर्लुम्म डुबेका छन्।","poem":2},{"text":"परमेश्‍वरले तिनीहरूको दुष्‍टता याद गर्नुहुनेछ,","poem":1},{"text":"र उहाँले तिनीहरूका पापको निम्ति दण्ड दिनुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“जब मैले इस्राएललाई भेट्टाएँ,","poem":1},{"text":"त्यो त मरुभूमिमा अङ्‌गुर भेट्टाएझैँ थियो,","poem":2},{"text":"जब मैले तिमीहरूका पितापुर्खाहरूलाई देखेँ,","poem":1},{"text":"त्यो नेभाराको रूखमा भएको पहिलो फलझैँ थियो।","poem":2},{"text":"तर जब तिनीहरू बाल-पिओरमा आए,","poem":1},{"text":"तब तिनीहरूले आफूलाई त्यस घिनलाग्दो मूर्तिमा समर्पण गरे,","poem":2},{"lineBreak":true},{"text":"र तिनीहरू ती घृणित वस्तुझैँ बने, जसलाई तिनीहरूले प्रेम गर्थे।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"एफ्राइमको महिमा चराझैँ उडेर जानेछ,","poem":1},{"text":"अर्थात् तिनीहरूमा न त कसैको जन्म, न कोही गर्भावस्था, न त कसैको गर्भधारण हुनेछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"यदि तिनीहरूले छोराछोरी जन्माए तापनि","poem":1},{"text":"म तिनीहरूलाई प्रत्येक बालकको निम्ति शोकित तुल्याउनेछु।","poem":2},{"text":"तिनीहरूलाई धिक्‍कार!","poem":1},{"text":"जब म तिनीहरूबाट टाढा जान्छु।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"मैले एफ्राइमलाई टायरजस्तै सुन्दर ठाउँमा","poem":1},{"text":"रोपिएको देखेको छु।","poem":2},{"text":"तर एफ्राइमले आफ्ना छोराछोरीहरूलाई","poem":1},{"text":"वधशालामा मारिनका निम्ति ल्याउनेछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"हे याहवेह, तिनीहरूलाई दण्ड दिनुहोस्,","poem":1},{"text":"अर्थात् तपाईं तिनीहरूलाई के दिनुहुन्छ?","poem":2},{"text":"तिनीहरूलाई तुहुने गर्भहरू,","poem":1},{"text":"र सुकेका स्तनहरू दिनुहोस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“गिलगालमा तिनीहरूका सबै दुष्‍टताहरूको कारण","poem":1},{"text":"मैले तिनीहरूलाई घृणा गरेँ।","poem":2},{"text":"तिनीहरूका दुष्‍ट कामहरूको कारण","poem":1},{"text":"म तिनीहरूलाई मेरो भवनदेखि निकालिदिनेछु।","poem":2},{"text":"अब उसो म तिनीहरूलाई प्रेम गर्नेछैनँ;","poem":1},{"text":"तिनीहरूका सबै अगुवाहरू विद्रोही छन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"एफ्राइम काटिएर ढलेको छ,","poem":1},{"text":"तिनीहरूका जरा ओइलाएका छन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूले कुनै पनि फल फलाउँदैनन्।","poem":2},{"text":"यदि तिनीहरूले छोराछोरी जन्माए तापनि","poem":1},{"text":"म तिनीहरूका प्रिय सन्तानहरूलाई मारिदिनेछु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"मेरा परमेश्‍वरले तिनीहरूलाई अस्वीकार गर्नुहुनेछ;","poem":1},{"text":"किनकि तिनीहरूले उहाँका वचनहरू पालन गरेनन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरू राष्ट्रहरूबीच भौँतारिँदै हिँड्नेछन्।","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}