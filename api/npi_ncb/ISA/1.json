{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["यो आमोजका छोरा यशैयाले यहूदाका राजाहरू उज्जियाह, योताम, आहाज र हिजकियाका शासनकालमा यहूदा र यरूशलेमको विषयमा देखेको दर्शन हो।"]},{"type":"line_break"},{"type":"heading","content":["बागी जाति"]},{"type":"verse","number":2,"content":[{"text":"हे आकाश, सुन्! हे पृथ्वी, ध्यान दिएर सुन्!","poem":1},{"text":"किनकि याहवेह भन्‍नुहुन्छ:","poem":2},{"text":"“मैले छोराछोरीहरूलाई पालनपोषण गरेर हुर्काएँ,","poem":1},{"text":"तर तिनीहरूले मेरो विरुद्धमा विद्रोह गरेका छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"गोरुले आफ्नो मालिकलाई चिन्छ,","poem":1},{"text":"र गधाले आफ्नो मालिकको डुँड चिन्छ।","poem":2},{"text":"तर इस्राएलले चिन्दैन,","poem":1},{"text":"मेरा मानिसहरूले बुझ्दैनन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"धिक्‍कार, त्यस पापी जाति,","poem":1},{"text":"अपराधले लादिएको जाति,","poem":2},{"text":"दुष्‍ट काम गर्नेहरूका सन्तान,","poem":1},{"text":"भ्रष्‍ट भएका सन्तान!","poem":2},{"text":"तिनीहरूले याहवेहलाई त्यागेका छन्;","poem":1},{"text":"तिनीहरूले इस्राएलका पवित्र परमेश्‍वरलाई लत्याएका छन्,","poem":2},{"lineBreak":true},{"text":"र उहाँतिर आफ्ना पिठिउँ फर्काएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तिमीहरू किन अझै पिटाइ खान्छौ?","poem":1},{"text":"तिमीहरू किन बागी भइरहन्छौ?","poem":2},{"text":"तिमीहरूका शिरभरि चोट-चोटै छ;","poem":1},{"text":"तिमीहरूका मुटुभरि पीडा छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"खुट्टाको पैतालादेखि","poem":1},{"text":"शिरसम्म स्वस्थता छैन।","poem":2},{"text":"चोटहरू र निलो डामहरू,","poem":1},{"text":"र उदाङ्गो घाउहरू छन्;","poem":2},{"text":"ती घाउहरू सफा नगरिएका र पट्टी नबाँधिएका","poem":1},{"text":"अथवा तेलले सेकिएका छैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"तिमीहरूको देश उजाड छ,","poem":1},{"text":"तिमीहरूका सहरहरू आगोले जलाइएका छन्;","poem":2},{"text":"तिमीहरूका खेतहरू तिमीहरूकै सामु","poem":1},{"text":"परदेशीहरूले उजाड पारिदिएका छन्;","poem":2},{"lineBreak":true},{"text":"अपरिचितहरूले नाश पारिदिएझैँ, त्यो उजाड भएको छ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"सियोनकी छोरी","poem":1},{"text":"दाखबारीको छाप्रोजस्तै,","poem":2},{"text":"काँक्राबारीमा भएको छाप्रोजस्तै,","poem":1},{"text":"घेरा हालिएको सहरजस्तै त्यागिएकी छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यदि सेनाहरूका याहवेहले","poem":1},{"text":"हामी कसैलाई बचाएर नराख्नुभएको भए","poem":2},{"text":"हामी सदोमझैँ हुनेथियौँ,","poem":1},{"text":"हामी गमोराजस्ता बन्‍नेथियौँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"हे सदोमका शासकहरू हो,","poem":1},{"text":"याहवेहको वचन सुन;","poem":2},{"text":"हे गमोराका मानिसहरू हो,","poem":1},{"text":"हाम्रा परमेश्‍वरको व्यवस्था ध्यानसित सुन!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेह भन्‍नुहुन्छ,","poem":1},{"text":"“तिमीहरूका बलिदानहरूको थुप्रो","poem":2},{"lineBreak":true},{"text":"मेरा निम्ति के कामको छ र?","poem":2},{"text":"मसित चाहिने भन्दा बढी","poem":1},{"text":"साँढे र मोटा-मोटा पशुहरूका होमबलि छन्।","poem":2},{"text":"साँढेहरू, थुमाहरू","poem":1},{"text":"र बाख्राहरूको रगतले म प्रसन्‍न हुँदिनँ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जब तिमीहरू मसँग भेट्नलाई आउँछौ,","poem":1},{"text":"के तिमीहरूलाई कसैले","poem":2},{"lineBreak":true},{"text":"मेरा आँगनहरू खुट्टाले कुल्चीमिल्ची गर्न भनेको छ र?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"व्यर्थैका बलिहरू ल्याउन बन्द गर!","poem":1},{"text":"तिमीहरूका धूप त मेरा निम्ति घृणित छ।","poem":2},{"text":"औँसी, शब्बाथ दिन र सभाहरूका साथसाथै","poem":1},{"text":"तिमीहरूका खराब जमघटहरू म सहन सक्दिनँ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तिमीहरूका औँसीका चाडहरू,","poem":1},{"text":"र तिमीहरूले ठहराएका चाडहरूलाई म मेरो सारा प्राणले घृणा गर्छु।","poem":2},{"text":"ती मेरा निम्ति बोझ भएका छन्;","poem":1},{"text":"ती बोक्दा-बोक्दै म थकित भइसकेको छु।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तिमीहरूले प्रार्थनामा आफ्ना हात फैलाउँदा,","poem":1},{"text":"म आफ्ना आँखाहरू तिमीहरूबाट लुकाउनेछु;","poem":2},{"text":"तिमीहरूले धेरै प्रार्थना गरे तापनि","poem":1},{"text":"म त्यो सुन्‍नेछैनँ।","poem":2},{"lineBreak":true},{"text":"तिमीहरूका हातहरू रगतले भरिएका छन्!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"आफूलाई धोएर शुद्ध पार।","poem":1},{"text":"तिमीहरूका दुष्‍ट कर्महरू मेरो दृष्‍टिबाट टाढा लैजाओ;","poem":2},{"lineBreak":true},{"text":"खराबी गर्न छोड।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"भलाइ गर्न सिक; न्याय खोज।","poem":1},{"text":"थिचोमिचोमा परेकाहरूलाई ढाडस देओ।","poem":2},{"text":"अनाथहरूका पक्षमा बोल;","poem":1},{"text":"विधवाहरूको मुद्दा लडिदेओ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"याहवेह भन्‍नुहुन्छ,","poem":1},{"text":"“अब आओ, हामी एकसाथ विचार गरौँ।","poem":2},{"text":"तिमीहरूका पाप सिन्दूरे रङ्गका भए तापनि","poem":1},{"text":"ती हिउँजस्तै सेता हुनेछन्;","poem":2},{"text":"ती गाढा राता रङ्गका भए तापनि","poem":1},{"text":"ती ऊनजस्तै सेता हुनेछन्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"यदि तिमीहरू इच्छुक र आज्ञाकारी भयौ भने,","poem":1},{"text":"तिमीहरूले देशका सर्वोत्तम कुराहरू खानेछौ;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तर यदि तिमीहरूले विरोध गर्‍यौ र बागी भयौ भने,","poem":1},{"text":"तिमीहरू तरवारले काटिनेछौ।”","poem":2},{"text":"किनकि याहवेहले बोल्नुभएको छ।","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"हेर, एउटा विश्‍वासयोग्य सहर","poem":1},{"text":"कसरी वेश्याजस्तै भयो!","poem":2},{"text":"कुनै समय त्यो न्यायपूर्ण थियो;","poem":1},{"text":"धार्मिकताले त्यसमा वास गर्थ्यो,","poem":2},{"lineBreak":true},{"text":"तर अहिले हत्याराहरूले वास गर्छन्!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तेरो चाँदी फोहोर भएको छ,","poem":1},{"text":"तेरो उत्तम दाखमद्यमा पानी मिसाइएको छ।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तेरा शासकहरू बागी,","poem":1},{"text":"र चोरहरूका साथीहरू बनेका छन्;","poem":2},{"text":"तिनीहरू सबैले घूस मन पराउँछन्,","poem":1},{"text":"र उपहारहरूको पछि लाग्छन्।","poem":2},{"text":"तिनीहरूले अनाथहरूका पक्ष लिदैनन्;","poem":1},{"text":"विधवाहरूको उजुर तिनीहरूकहाँ पुग्दैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"यसकारण प्रभु, सेनाहरूका याहवेह","poem":1},{"text":"इस्राएलका सर्वशक्तिमान् परमेश्‍वर घोषणा गर्नुहुन्छ:","poem":2},{"text":"“आह! म आफ्ना शत्रुहरूमाथि क्रोध खन्याउनेछु।","poem":1},{"text":"आफ्ना शत्रुहरूसँग म आफैँ बदला लिनेछु।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"म आफ्नो हात तेरो विरुद्ध फर्काउनेछु;","poem":1},{"noteId":0},{"text":"म तेरो फोहोरलाई पूर्ण रूपमा सफा गर्नेछु,","poem":2},{"lineBreak":true},{"text":"र तेरा सबै अशुद्धताहरूलाई हटाइदिनेछु।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"म तेरा न्यायकर्ताहरूलाई पुरानो समयमा भएकाजस्तै,","poem":1},{"text":"तेरा सल्‍लाहकारहरूलाई","poem":2},{"text":"सुरुका समयमा भएकाजस्तै फेरि स्थापित गर्नेछु।","poem":1},{"text":"त्यसपछि तँ धार्मिकताको सहर;","poem":2},{"lineBreak":true},{"text":"एउटा विश्‍वासयोग्य सहर भनिनेछस्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"सियोन न्यायसित छुटाइनेछ।","poem":1},{"text":"त्यहाँका पश्‍चात्ताप गर्नेहरू धार्मिकतासँगै छुटाइनेछन्।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"तर बागीहरू र पापीहरू दुवै तोडिनेछन्;","poem":1},{"text":"याहवेहलाई त्याग्नेहरू नाश हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“तिमीहरूले आनन्द मानेका ती फलाँटका पवित्र रूखहरूको कारण","poem":1},{"text":"तिमीहरू लज्जित हुनेछौ;","poem":2},{"text":"तिमीहरूले रोजेका ती बगैँचाहरूको कारण नै","poem":1},{"text":"तिमीहरू अपमानित हुनेछौ।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"तिमीहरू पात झर्दै गरेका फलाँटका रूखहरूजस्तै,","poem":1},{"text":"पानी नभएका बगैँचाजस्तै हुनेछौ।","poem":2}]},{"type":"verse","number":31,"content":[{"text":"शक्तिशाली मानिस सुकेको दाउरा","poem":1},{"text":"र त्यसको काम झिल्काजस्तै हुनेछ;","poem":2},{"text":"ती दुवै एकैसाथ जल्नेछन्,","poem":1},{"text":"त्यो आगोलाई निभाउने कोही हुनेछैन।”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"योचाहिँ यरूशलेमको विरुद्धमा थियो।","reference":{"chapter":1,"verse":25}}]},"thisChapterLink":"/api/npi_ncb/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}