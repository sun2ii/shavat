{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"धिक्‍कार तिनीहरूलाई, जसले अन्यायी नियम-कानुनहरू बनाउँछन्,","poem":1},{"text":"जसले अत्याचारपूर्ण आदेशहरू निकाल्छन्;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"गरिबहरूबाट अधिकार खोस्‍न","poem":1},{"text":"र सताइएका मेरा मानिसहरूबाट न्याय रोक्न,","poem":2},{"text":"विधवाहरूलाई आफ्ना शिकार बनाउन,","poem":1},{"text":"र अनाथहरूलाई लुट्नका निम्ति तिनीहरू यसो गर्छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"लेखा दिनुपर्ने दिनमा विपत्ति टाढाबाट आउँदा","poem":1},{"text":"तिमीहरू के गर्छौ?","poem":2},{"text":"तिमीहरू सहायताका लागि कसकहाँ दौडेर जान्छौ?","poem":1},{"text":"तिमीहरू आफ्ना सम्पत्ति कहाँ छोड्छौ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कैदीहरूको बीचमा झुक्नुबाहेक","poem":1},{"text":"र मारिएकाहरूका बीचमा लोट्नुबाहेक केही पनि छोडिनेछैन।","poem":2},{"lineBreak":true},{"text":"यति भएर पनि उहाँको क्रोध शान्त भएको छैन,","poem":1},{"text":"तर उहाँको हात अझै उठिराखेकै छ।","poem":2}]},{"type":"heading","content":["अश्शूरमाथि परमेश्‍वरको न्याय"]},{"type":"verse","number":5,"content":[{"text":"“धिक्‍कार अश्शूरलाई, मेरो रिसको लहुरो,","poem":1},{"text":"जसको हातमा भएको लहुरोचाहिँ मेरो क्रोध हो!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"लुटको माल खोस्‍न र लुटपाट गरी ध्वस्त गर्न;","poem":1},{"text":"अनि गल्‍लीको हिलोझैँ कुल्चीमिल्ची गर्न,","poem":2},{"text":"ईश्‍वरहीन जाति तथा मलाई रिस उठाउने मानिसहरूको विरुद्धमा,","poem":1},{"text":"मैले त्यसलाई पठाएको छु।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तर त्यसको यस्तो विचार छैन,","poem":1},{"text":"र त्यसले आफ्नो मनमा यस्तो सोचेको छैन;","poem":2},{"text":"त्यसको उद्देश्य नाश गर्नु हो,","poem":1},{"text":"धेरै जातिहरूलाई नाश गर्नु हो।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"त्यसले भन्छ, ‘के मेरा सेनापतिहरू सबै राजाहरू होइनन् र?","poem":1}]},{"type":"verse","number":9,"content":[{"text":"के कल्नोको दशा कर्कमीशको जस्तै भएन र?","poem":2},{"text":"के हमात अर्पादझैँ","poem":1},{"text":"र सामरिया दमस्कसझैँ छैन र?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"जसरी मेरो हातले मूर्तिहरूका राज्यहरूलाई कब्जा गर्‍यो,","poem":1},{"text":"जसको खोपेर बनाएका मूर्तिहरू यरूशलेम र सामरियाका मूर्तिहरूभन्दा धेरै थिए—","poem":2}]},{"type":"verse","number":11,"content":[{"text":"मैले सामरिया र त्यसका मूर्तिहरूसित व्यवहार गरेझैँ","poem":1},{"text":"के म यरूशलेम र त्यसका मूर्तिहरूसित पनि त्यस्तै नगरूँ?’ ”","poem":2}]},{"type":"verse","number":12,"content":["प्रभुले सियोन पर्वत र यरूशलेमको विरुद्धमा आफ्ना सबै कामहरू सिद्ध्याउनुभएपछि उहाँले भन्‍नुहुनेछ, “म अश्शूरको राजालाई त्यसको हृदयको इच्छाअनुसारको घमण्ड र त्यसको आँखामा चढेको अभिमानी हेराइका निम्ति दण्ड दिनेछु।"]},{"type":"verse","number":13,"content":["किनकि त्यसले भन्छ:",{"text":"“ ‘मेरो हातको बलले","poem":1},{"text":"र मेरो बुद्धिले मैले यो गरेको हुँ; किनकि मसित समझशक्ति छ।","poem":2},{"text":"मैले राष्ट्रहरूका सिमानाहरू हटाइदिएको छु,","poem":1},{"text":"मैले तिनीहरूका खजाना लुटेको छु;","poem":2},{"lineBreak":true},{"text":"एक शूरवीरले झैँ मैले तिनीहरूका राजाहरूलाई वशमा पारेको छु।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"कसैले चराका गुँड फेला पारेझैँ,","poem":1},{"text":"मेरो हात जातिहरूको धनसम्पत्तिमा पुग्यो;","poem":2},{"text":"मानिसहरूले छोडेका अण्डाहरू बटुलेझैँ,","poem":1},{"text":"मैले सबै देशहरूलाई भेला गरेको छु;","poem":2},{"text":"एउटैले पनि पखेटा फ्याट-फ्याट गरेन,","poem":1},{"text":"अथवा चूँ-चूँ गर्नलाई मुख खोलेन।’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"के बन्चरो आफैँ त्यसलाई चलाउनेभन्दा माथि उठ्न सक्छ,","poem":1},{"text":"अथवा आराले त्यसलाई प्रयोग गर्नेभन्दा बढी घमण्ड गर्न सक्छ?","poem":2},{"text":"मानौँ, लहुरो उठाउनेलाई लहुरोले नै चलाएजस्तो,","poem":1},{"text":"अथवा जो काठ होइन, त्यसलाई मुङ्ग्रोले चलाएजस्तो!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"यसकारण प्रभु, सेनाहरूका याहवेहले","poem":1},{"text":"त्यसका प्रबल योद्धाहरूमाथि कमजोर हुने रोग पठाउनुहुनेछ;","poem":2},{"text":"त्यसको गौरवमुनि बल्दो ज्वालाजस्तै","poem":1},{"text":"आगो सल्काउनुहुनेछ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"इस्राएलको ज्योति आगो हुनेछ,","poem":1},{"text":"र तिनीहरूका पवित्र परमेश्‍वर ज्वाला बन्‍नुहुनेछ;","poem":2},{"text":"एकै दिनमा काँडाहरू","poem":1},{"text":"र त्यसका सिउँडीहरूलाई जलाएर भस्म पारिदिनुहुनेछ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"वनहरू र मलिलो खेतहरू","poem":1},{"text":"सम्पूर्ण रूपले नष्‍ट हुनेछ,","poem":2},{"lineBreak":true},{"text":"त्यो बिरामी मानिस दुब्लाएर गएझैँ हुनेछ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"अनि त्यसका वनका रूखहरू यति थोरै हुनेछन्,","poem":1},{"text":"कि एउटा बालकले पनि ती गन्ती गरेर लेख्न सक्छ।","poem":2}]},{"type":"heading","content":["इस्राएलको बाँकी भाग"]},{"type":"verse","number":20,"content":[{"text":"त्यस दिन इस्राएलको अवशेष,","poem":1},{"text":"याकोबका घरानाका बचेका भागले","poem":2},{"text":"तिनीहरूलाई प्रहार गर्नेमाथि","poem":1},{"text":"फेरि भरोसा गर्नेछैनन्,","poem":2},{"text":"तर साँचो रूपले याहवेह,","poem":1},{"text":"इस्राएलका पवित्र परमेश्‍वरमाथि भरोसा गर्नेछन्।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"बाँकी मानिसहरू फर्कनेछन्,","poem":1},{"text":"याकोबका बचेका मानिसहरू सर्वशक्तिमान् परमेश्‍वरतिर फर्कनेछन्।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"हे इस्राएल, तेरा मानिसहरू समुद्रको किनारको बालुवासरी भए तापनि","poem":1},{"text":"केवल एउटा अवशेष मात्र फर्कनेछ।","poem":2},{"text":"सर्वनाश प्रचुरता र धार्मिकतासित ठहराइएको छ।","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"प्रभु, सेनाहरूका याहवेहले","poem":1},{"text":"सम्पूर्ण देशमाथि ठहराएअनुसारको सर्वनाश ल्याउनुहुनेछ।","poem":2}]},{"type":"verse","number":24,"content":["यसकारण प्रभु, सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:",{"text":"“हे सियोनमा बस्‍ने मेरो प्रजा हो,","poem":1},{"text":"अश्शूरसित तिमीहरू नडराओ,","poem":2},{"text":"जसले तिमीहरूलाई लाठोले हिर्काउनेछ;","poem":1},{"text":"अनि तिमीहरूको विरुद्ध इजिप्टले गरेझैँ मुङ्ग्रो उठाउनेछ।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"अनि चाँडै तिमीहरूका विरुद्ध मेरो रिस शान्त हुनेछ,","poem":1},{"text":"र मेरो क्रोध तिनीहरूको सर्वनाशतिर लाग्नेछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"उहाँले मिद्यानलाई ओरेबको चट्टानमा प्रहार गर्नुभएझैँ,","poem":1},{"text":"सेनाहरूका याहवेहले तिनीहरूलाई कोर्रा लाउनुहुनेछ;","poem":2},{"text":"अनि उहाँले इजिप्टमा गर्नुभएझैँ,","poem":1},{"text":"आफ्नो लहुरो पानीमाथि उठाउनुहुनेछ।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"त्यस दिन तिमीहरूका काँधबाट तिनीहरूका भार उठाइनेछ;","poem":1},{"text":"तिमीहरूका घिच्रोबाट तिनीहरूका जुवाको बोझ उठाइनेछ;","poem":2},{"text":"अनि तिमीहरू मोटाएको कारणले","poem":1},{"text":"जुवा भाँचिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"तिनीहरू अय्यातभित्र पस्छन्;","poem":1},{"text":"तिनीहरू मिग्रोनबाट भएर जान्छन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूले आफ्नो खाद्य-सामग्री मिकमाशमा जम्मा गर्छन्।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"तिनीहरू घाटीबाट गएर भन्‍नेछन्,","poem":1},{"text":"“हामी रातभरि गेबामा छाउनी लगाएर बस्‍नेछौँ।”","poem":2},{"text":"रामा डराएको छ;","poem":1},{"text":"शाऊलको गेबा भागेको छ।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"हे गल्‍लीमकी छोरी सोर उचालेर चिच्‍या!","poem":1},{"text":"हे लैशा, ध्यान दिएर सुन्!","poem":2},{"lineBreak":true},{"text":"बिचरा अनातोत!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"मदमेना भाग्दैछ;","poem":1},{"text":"गेबीमका मानिसहरू लुक्दैछन्।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"त्यस दिन तिनीहरू नोबमा अडिनेछन्;","poem":1},{"text":"तिनीहरूले आफ्ना मुक्‍का","poem":2},{"text":"सियोनकी छोरीको पर्वततिर,","poem":1},{"text":"यरूशलेमको डाँडातिर देखाउनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"हेर, प्रभु, सेनाहरूका याहवेहले","poem":1},{"text":"डरलाग्दो आवाज निस्कने गरी हाँगाहरू लाछ्नुहुनेछ।","poem":2},{"text":"अग्ला-अग्ला रूखहरू ढालिनेछन्,","poem":1},{"text":"र उच्‍च पारिएकाहरूलाई होच्याइनेछ।","poem":2}]},{"type":"verse","number":34,"content":[{"text":"उहाँले जङ्गलको बाक्लो झाडीलाई बन्चरोले काट्नुहुनेछ;","poem":1},{"text":"परमेश्‍वरको सामु लेबनान ढल्नेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}