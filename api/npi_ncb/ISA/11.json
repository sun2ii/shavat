{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["यिशैबाटको हाँगा"]},{"type":"verse","number":1,"content":[{"text":"यिशैको ठुटाबाट एउटा टुसा पलाउनेछ;","poem":1},{"text":"त्यसका जराहरूबाट एउटा हाँगाले फल फलाउनेछ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेहका आत्मा उहाँमा रहनुहुनेछ;","poem":1},{"text":"बुद्धि र समझका आत्मा,","poem":2},{"lineBreak":true},{"text":"सल्‍लाह र शक्तिका आत्मा,","poem":2},{"lineBreak":true},{"text":"ज्ञान र याहवेहको भयको आत्मा,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"र उहाँ याहवेहको भयमा प्रसन्‍न हुनुहुनेछ।","poem":1},{"lineBreak":true},{"text":"उहाँले आफ्ना आँखाले देखेअनुसार न्याय गर्नुहुनेछैन,","poem":1},{"text":"अथवा आफ्ना कानले सुनेअनुसार निर्णय लिनुहुनेछैन;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तर उहाँले खाँचोमा परेकाहरूको न्याय धार्मिकतासित गर्नुहुनेछ;","poem":1},{"text":"पृथ्वीका गरिबहरूका निम्ति न्यायसित उहाँले निर्णय दिनुहुनेछ।","poem":2},{"text":"उहाँले पृथ्वीलाई आफ्नो मुखको वचनले प्रहार गर्नुहुनेछ;","poem":1},{"text":"आफ्ना ओठको सासले उहाँले दुष्‍टलाई मार्नुहुनेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"धार्मिकता उहाँको कम्मरको पेटी हुनेछ;","poem":1},{"text":"अनि विश्‍वासयोग्यता उहाँको पटुका हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ब्वाँसो थुमासँग बस्‍नेछ,","poem":1},{"text":"र चितुवा बाख्रासित ढल्कनेछ;","poem":2},{"text":"बाछा र सिंह एकसाथ रहनेछन्;","poem":1},{"text":"र एउटा सानो बालकले तिनीहरूलाई डोर्‍याउनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"गाई र भालु एकैसाथ चर्नेछन्;","poem":1},{"text":"तिनीहरूका बच्‍चाहरू एकैसाथ ढल्किनेछन्;","poem":2},{"lineBreak":true},{"text":"सिंहले गोरुले झैँ पराल खानेछ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"दुधे-बालक गोमन सर्पको दुलोको छेउमा खेल्नेछ;","poem":1},{"text":"र शिशुले विषालु सर्पको दुलोमा आफ्नो हात हाल्नेछ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मेरा सम्पूर्ण पवित्र पर्वतमा","poem":1},{"text":"तिनीहरूले न हानि गर्नेछन्, न त नष्‍ट गर्नेछन्;","poem":2},{"text":"किनकि समुद्र पानीले भरिएझैँ,","poem":1},{"text":"याहवेहको ज्ञानले पृथ्वी भरिनेछ।","poem":2}]},{"type":"verse","number":10,"content":["त्यस दिन जातिहरूका बीचमा यिशैको वंशबाट एउटा झण्डाजस्तै खडा हुनेछ; जातिहरू उहाँकहाँ भेला हुनेछन् र उहाँको विश्रामस्थल महिमामय हुनेछ।"]},{"type":"verse","number":11,"content":["त्यस दिन अश्शूर, इजिप्टको तल्‍लो भाग, माथिल्‍लो इजिप्ट, पत्रोस, कूश,",{"noteId":7},"एलाम, बेबिलोन,",{"noteId":8},"हमात र भुमध्यसागरका टापुहरूबाट उहाँको बाँचेको भागलाई लैजानका निम्ति प्रभुले दोस्रोपल्ट आफ्नो हात पसार्नुहुनेछ।"]},{"type":"verse","number":12,"content":[{"text":"उहाँले जातिहरूका निम्ति झण्डा खडा गर्नुहुनेछ,","poem":1},{"text":"र देशबाट निकालिएका इस्राएलीहरूलाई बटुल्नुहुनेछ;","poem":2},{"text":"उहाँले पृथ्वीका चारै छेउहरूबाट तितरबितर भएका","poem":1},{"text":"यहूदाका मानिसहरूलाई भेला गराउनुहुनेछ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"एफ्राइमको डाह लोप हुनेछ;","poem":1},{"text":"अनि यहूदाका शत्रुहरू नाश हुनेछन्;","poem":2},{"text":"एफ्राइमले यहूदासित डाह गर्नेछैन,","poem":1},{"text":"र यहूदाले एफ्राइमसित शत्रुता राख्नेछैन।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तिनीहरू पलिश्तीको पश्‍चिमी भिरमा झम्टेर जानेछन्;","poem":1},{"text":"तिनीहरूले एकसाथ पूर्वतिरका मानिसहरूलाई लुट्नेछन्।","poem":2},{"text":"तिनीहरूले एदोम र मोआबलाई हराउनेछन्;","poem":1},{"text":"अनि अम्मोनीहरू तिनीहरूको अधीनमा हुनेछन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"याहवेहले इजिप्टको सामुन्द्रिक खाडीलाई सुकाइदिनुहुनेछ;","poem":1},{"text":"उहाँले प्रचण्ड बतासले","poem":2},{"text":"यूफ्रेटिस नदीमाथि आफ्नो हात चलाउनुहुनेछ।","poem":1},{"text":"मानिसहरू जुत्ता लगाएरै तर्न सकून् भनेर","poem":2},{"text":"उहाँले त्यसलाई सात वटा","poem":1},{"text":"खोलामा विभाजित गराइदिनुहुनेछ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"इजिप्टबाट इस्राएल निस्केर आएको दिनजस्तै","poem":1},{"text":"अश्शूरबाट आउने उहाँको बचेको भागका","poem":2},{"text":"मानिसहरूका निम्ति","poem":1},{"text":"एउटा राजमार्ग हुनेछ।","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"यो देशचाहिँ इजिप्टको दक्षिणपट्टि पर्थ्यो।","reference":{"chapter":11,"verse":11}},{"noteId":8,"caller":"+","text":"बेबिलोनलाई शिनार पनि भनिन्छ।","reference":{"chapter":11,"verse":11}}]},"thisChapterLink":"/api/npi_ncb/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}