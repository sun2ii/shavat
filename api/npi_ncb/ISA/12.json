{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["प्रशंसाका गीतहरू"]},{"type":"verse","number":1,"content":["त्यस दिन तिमीहरू भन्‍नेछौ:",{"text":"“हे याहवेह, म तपाईंको प्रशंसा गर्नेछु।","poem":1},{"text":"तपाईं मसित रिसाउनुभए तापनि","poem":2},{"text":"तपाईंको रिस अब मरेको छ;","poem":1},{"text":"अनि तपाईंले मलाई सान्त्वना दिनुभएको छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"निश्‍चय नै परमेश्‍वर मेरा उद्धार हुनुहुन्छ;","poem":1},{"text":"म भरोसा गर्नेछु र डराउनेछैनँ।","poem":2},{"text":"याहवेह, याहवेह नै मेरा सामर्थ्य र मेरा रक्षक","poem":1},{"noteId":9},{"text":"हुनुहुन्छ;","poem":1},{"text":"निश्‍चय नै उहाँ मेरा उद्धार हुनुहुन्छ।”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"आनन्दसित तिमीहरूले","poem":1},{"text":"उद्धारको इनारबाट पानी भर्नेछौ।","poem":2}]},{"type":"verse","number":4,"content":["त्यस दिन तिमीहरू भन्‍नेछौ:",{"text":"“याहवेहलाई धन्यवाद देओ, उहाँको नामलाई पुकार;","poem":1},{"text":"उहाँले गर्नुभएका कुराहरू जातिहरूलाई बताइदेओ;","poem":2},{"lineBreak":true},{"text":"अनि उहाँको नाम उच्‍च पारिएको छ भनी घोषणा गर।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेहका निम्ति भजन गाओ; किनकि उहाँले महिमापूर्ण कामहरू गर्नुभएको छ;","poem":1},{"text":"यो कुरा सारा संसारले जानोस्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"हे सियोनका मानिस हो, उच्‍च सोरले कराओ र आनन्दले गाओ;","poem":1},{"text":"किनकि तिमीहरूका बीचमा इस्राएलका पवित्र परमेश्‍वर महान् हुनुहुन्छ।”","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"अथवा गीत","reference":{"chapter":12,"verse":2}}]},"thisChapterLink":"/api/npi_ncb/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}