{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["बेबिलोनको विरुद्ध भविष्यवाणी"]},{"type":"verse","number":1,"content":["आमोजको छोरा यशैयाले बेबिलोनको विषयमा देखेका भविष्यवाणी:"]},{"type":"verse","number":2,"content":[{"text":"नाङ्गो डाँडाको टुप्पामाथि एउटा झण्डा खडा गर;","poem":1},{"text":"तिनीहरूतर्फ उच्‍च सोरले कराओ;","poem":2},{"text":"तिनीहरू कुलीन मानिसहरूका","poem":1},{"text":"मूलढोकाभित्र प्रवेश गरून्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मैले आफ्नो क्रोध खन्याउन आफ्ना पवित्र जनहरूलाई बोलाइपठाएको छु:","poem":1},{"text":"युद्धका निम्ति तयार पारेका आफ्ना योद्धाहरूलाई आज्ञा गरेको छु,","poem":2},{"lineBreak":true},{"text":"जो मेरो विजयमा रमाउँछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"पहाडहरूमा ठूलो भीडको खैलाबैलाजस्तो","poem":1},{"text":"होहल्‍ला सुन्!","poem":2},{"text":"जातिहरू एकसाथ भेला भएझैँ,","poem":1},{"text":"राज्यहरूको बीचमा होहल्‍ला सुन्!","poem":2},{"text":"सेनाहरूका याहवेहले युद्धका निम्ति","poem":1},{"text":"सेना बटुल्दै हुनुहुन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेह र उहाँका रिसका हतियारहरू","poem":1},{"text":"टाढा देश, आकाशको पल्‍लो छेउदेखि","poem":2},{"text":"सारा देशलाई नाश गर्न आउँछन्।","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"विलाप गर्! किनकि याहवेहको दिन नजिकै छ;","poem":1},{"text":"सर्वशक्तिमान्‌को तर्फबाट सर्वनाशजस्तै त्यो आउनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यसैले सबै हातहरू लुला हुनेछन्।","poem":1},{"text":"हरेक मानिसको हृदय पग्लनेछ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरू त्रसित हुनेछन्;","poem":1},{"text":"तिनीहरूलाई कष्‍ट र वेदनाले पक्रनेछन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरू प्रसव-वेदनामा परेकी स्त्रीझैँ छटपटाउनेछन्।","poem":2},{"text":"तिनीहरू हैरान भएर एक-अर्कातिर हेर्नेछन्;","poem":1},{"text":"तिनीहरूका अनुहारहरू डरले गर्दा फिका हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"हेर, याहवेहको दिन देशलाई उजाड पार्न","poem":1},{"text":"र त्यहाँभित्र भएका पापीहरूलाई सर्वनाश गर्न,","poem":2},{"text":"रिस र भयानक क्रोधको साथ","poem":1},{"text":"निष्‍ठुर दिन आइरहेछ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"आकाशका ताराहरू र तिनीहरूका नक्षत्रहरूले","poem":1},{"text":"आफ्ना प्रकाश देखाउनेछैनन्।","poem":2},{"text":"उदाउँदै गरेको सूर्य अँध्यारो हुनेछ;","poem":1},{"text":"अनि चन्द्रमाले आफ्नो प्रकाश दिनेछैन।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"म संसारलाई त्यसको दुष्‍टताको लागि,","poem":1},{"text":"र दुष्‍टहरूलाई तिनीहरूका पापको लागि दण्ड दिनेछु।","poem":2},{"text":"म अभिमानीहरूको घमण्डको अन्त्य गरिदिनेछु,","poem":1},{"text":"र निष्‍ठुरहरूको घमण्डलाई चुर पारिदिनेछु।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"म मानिसहरूलाई निखुर सुनभन्दा दुर्लभ बनाउनेछु,","poem":1},{"text":"ओपीरको सुनभन्दा दुर्लभ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"यसकारण म आकाशहरूलाई थरथर काम्ने तुल्याउनेछु;","poem":1},{"text":"सेनाहरूका याहवेहको क्रोधको दिनमा,","poem":2},{"text":"उहाँको बल्दो रिसको दिनमा","poem":1},{"text":"पृथ्वी आफ्नो ठाउँमा हल्‍लिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"खेदिएको हरिणझैँ,","poem":1},{"text":"गोठाला नभएको भेडाहरूझैँ,","poem":2},{"text":"सबै आफ्नै मानिसकहाँ फर्कनेछन्;","poem":1},{"text":"आफ्नै जन्मभूमिमा भागेर जानेछन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"पक्राउ परेका जोसुकै पनि रोपिनेछन्;","poem":1},{"text":"समातिएका जति सबै तरवारद्वारा मारिनेछन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तिनीहरूका शिशुहरू तिनीहरूकै आँखाहरूका सामु पछारेर टुक्रा-टुक्रा पारिनेछन्;","poem":1},{"text":"तिनीहरूका घरहरू लुटिनेछन् र तिनीहरूका पत्नीहरू बलात्कृत हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"हेर, म तिनीहरूको विरुद्ध मादीहरूलाई सुर्‍याउनेछु,","poem":1},{"text":"जसले चाँदीको वास्तै गर्दैनन्,","poem":2},{"lineBreak":true},{"text":"र सुनमा प्रसन्‍न हुँदैनन्।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तिनीहरूका धनुले जवान मानिसहरूलाई लडाउनेछन्;","poem":1},{"text":"शिशुहरूमाथि तिनीहरूले दया देखाउनेछैनन्,","poem":2},{"lineBreak":true},{"text":"न त तिनीहरूले बालबालिकाहरूप्रति कृपा देखाउनेछन्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"राज्यहरूको रत्न बेबिलोन,","poem":1},{"text":"बेबिलोनीहरूका","poem":2},{"noteId":10},{"text":"घमण्डको गौरवलाई","poem":2},{"text":"परमेश्‍वरले सदोम र गमोराझैँ","poem":1},{"text":"पल्टाइदिनुहुनेछ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"त्यहाँ कहिल्यै कोही बसोबास गर्नेछैन,","poem":1},{"text":"अथवा पुस्तौँसम्म कोही बस्‍नेछैनन्;","poem":2},{"text":"कुनै घुमन्तेलेधरि","poem":1},{"noteId":11},{"text":"त्यहाँ आफ्नो पाल टाँग्नेछैन;","poem":1},{"text":"कुनै गोठालाले त्यहाँ आफ्नो बगाललाई विश्राम दिनेछैन।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तर जङ्गली जनावरहरूले त्यहाँ विश्राम गर्नेछन्;","poem":1},{"text":"तिनका घरहरू स्यालहरूले भरिनेछन्;","poem":2},{"text":"उल्‍लुहरू त्यहाँ बस्‍नेछन्,","poem":1},{"text":"र जङ्गली बाख्राहरू त्यहाँ उफ्रँदै खेल्नेछन्।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"हुँडारहरू तिनका किल्‍लाहरूमा","poem":1},{"text":"तिनका आनन्दको महलहरूमा स्यालहरू कराउनेछन्।","poem":2},{"text":"बेबिलोनको समय नजिक आएको छ,","poem":1},{"text":"चाँडै यी सबै पूरा हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":10,"caller":"+","text":"अथवा कल्दीहरू","reference":{"chapter":13,"verse":19}},{"noteId":11,"caller":"+","text":"मूल भाषामा अरबीहरू","reference":{"chapter":13,"verse":20}}]},"thisChapterLink":"/api/npi_ncb/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}