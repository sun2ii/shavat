{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहले याकोबमाथि दया देखाउनुहुनेछ;","poem":1},{"text":"फेरि एकपल्ट उहाँले इस्राएललाई चुन्‍नुहुनेछ;","poem":2},{"lineBreak":true},{"text":"अनि तिनीहरूलाई तिनीहरूका आफ्नै देशमा बसाल्नुहुनेछ।","poem":2},{"text":"परदेशीहरू तिनीहरूसित मिल्नेछन्","poem":1},{"text":"र याकोबका घरानासित तिनीहरू मिलेर बस्‍नेछन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"राष्ट्रहरूले तिनीहरूलाई लगेर","poem":1},{"text":"तिनीहरूको आफ्नै ठाउँमा ल्याइदिनेछन्।","poem":2},{"text":"अनि इस्राएलले जातिहरूलाई याहवेहको देशमा","poem":1},{"text":"आफ्ना दास-दासीहरू बनाउनेछ।","poem":2},{"text":"तिनीहरूलाई पक्रनेहरूलाई तिनीहरूले आफ्ना कैदी बनाउनेछन्;","poem":1},{"text":"अनि तिनीहरूमाथि थिचोमिचो गर्नेहरूमाथि शासन गर्नेछन्।","poem":2}]},{"type":"verse","number":3,"content":["याहवेहले तिमीहरूलाई कष्‍ट, चिन्ता र कठिन परिश्रमबाट मुक्त गर्नुभएको दिन,"]},{"type":"verse","number":4,"content":["तिमीहरूले बेबिलोनको राजाको विरुद्धमा यसरी खिसी गर्नेछौ:",{"text":"अत्याचारी कसरी नाश भयो!","poem":1},{"text":"त्यसको अत्याचार कसरी समाप्‍त भयो!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेहले दुष्‍टको लहुरो,","poem":1},{"text":"शासकहरूको राजदण्ड भाँचिदिनुभएको छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जसले रिसमा मानिसहरूलाई","poem":1},{"text":"लगातार मुक्‍का लगाइरहन्थ्यो;","poem":2},{"text":"अनि रिसमा राष्ट्रहरूलाई","poem":1},{"text":"लगातार आक्रमणद्वारा अधीनमा राखेको थियो।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"सारा देश विश्राम र शान्तिमा छ;","poem":1},{"text":"तिनीहरू गीत गाइउठ्छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"सल्‍लाका रूखहरू र लेबनानका देवदारुसमेत","poem":1},{"text":"तिमीहरूको अवस्था देखेर रमाउँछन् र भन्छन्,","poem":2},{"text":"“अब तँ ढलिगएको कारणले काठको काम गर्ने","poem":1},{"text":"कोही पनि आएर हामीलाई ढाल्दैनन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"तेरो आगमनको प्रतीक्षामा","poem":1},{"text":"पाताल पनि उत्प्रेरित भएको छ;","poem":2},{"text":"त्यसले तँलाई अभिवादन गर्न मरेका आत्माहरूलाई जगाउँछ—","poem":1},{"text":"संसारका अगुवा भएर रहेका थिए;","poem":2},{"text":"यसले एकपल्ट जातिहरूमाथि राजा भएकाहरूलाई","poem":1},{"text":"तिनीहरूका सिंहासनबाट उठाउँछ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिनीहरू सबैले जवाफ दिएर","poem":1},{"text":"तँलाई यसो भन्‍नेछन्,","poem":2},{"text":"“तँ अब हामीजस्तै कमजोर भएको छस्;","poem":1},{"text":"तँ हामीजस्तै भइस्।”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तेरा सबै रवाफ,","poem":1},{"text":"र तेरा वीणाहरूको सोरसितै पातालमा खसालिएको छ;","poem":2},{"text":"तेरो ओछ्यानमा औँसाहरू छरिएका छन्;","poem":1},{"text":"अनि किराहरूले तँलाई ढाकेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"हे बिहानको तारा, प्रभातको पुत्र,","poem":1},{"text":"तँ कसरी स्वर्गबाट खसेको छस्!","poem":2},{"text":"जातिहरूलाई होच्याउने,","poem":1},{"text":"तँ पृथ्वीमा फ्याँकिएको छस्!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तैँले आफ्नो हृदयमा भनिस्,","poem":1},{"text":"“म स्वर्गमा उक्लनेछु;","poem":2},{"text":"म आफ्नो सिंहासनलाई","poem":1},{"text":"परमेश्‍वरका ताराहरूभन्दा माथि उचाल्नेछु;","poem":2},{"text":"म सभाको पर्वतमाथि सिंहासनमा,","poem":1},{"text":"शाफोन पर्वतको सर्वोच्‍च स्थानमा विराजमान हुनेछु।","poem":2},{"noteId":12}]},{"type":"verse","number":14,"content":[{"text":"म बादलहरूभन्दा माथि उक्लनेछु;","poem":1},{"text":"म आफैँलाई सर्वोच्‍च परमेश्‍वर बराबर बनाउनेछु।”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तर तँलाई चिहानसम्म,","poem":1},{"text":"खाडलको गहिराइसम्मै होच्याइयो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"तँलाई देख्नेहरूले तँलाई नियालेर हेर्नेछन्,","poem":1},{"text":"तेरो दशामा तिनीहरूले विचार गर्नेछन्:","poem":2},{"text":"“के यो त्यही मानिस हो, जसले पृथ्वीलाई हल्‍लायो;","poem":1},{"text":"अनि राज्यहरूलाई थर्कमान बनायो।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"त्यो मानिस, जसले संसारलाई मरुभूमि बनायो,","poem":1},{"text":"जसले सहरहरूलाई हरायो;","poem":2},{"lineBreak":true},{"text":"र आफ्ना कैदीहरूलाई घरमा जान दिएन?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"सबै राष्ट्रहरूका राजाहरू आ-आफ्नो","poem":1},{"text":"चिहानमा पस्रिरहन्छन्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तर तँ एउटा त्यागिएको हाँगाझैँ","poem":1},{"text":"आफ्नो चिहानमा फालिएको छस्;","poem":2},{"text":"तँ तरवारले रोपिएकाहरूसँग,","poem":1},{"text":"खाडलका ढुङ्गाहरूमा खसेकाहरूसँग","poem":2},{"lineBreak":true},{"text":"मारिएकाहरूले ढाकिएको छस्।","poem":2},{"text":"तँ खुट्टाले कुल्चिएर पैतालामुनि परेको लासझैँ भएको छस्।","poem":1}]},{"type":"verse","number":20,"content":[{"text":"तँ तिनीहरूसित गाडिनेछैनस्;","poem":2},{"text":"किनकि तैँले आफ्नो देशलाई नाश गरेको छस्;","poem":1},{"text":"अनि तेरा मानिसहरूलाई मारेको छस्।","poem":2},{"lineBreak":true},{"lineBreak":true},{"text":"दुष्‍टका सन्तानहरूको उल्‍लेख","poem":1},{"text":"अब कहिल्यै गरिनेछैन।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तिनीहरूका पुर्खाहरूका पापको कारण","poem":1},{"text":"त्यसका छोराहरूलाई मार्ने ठाउँ तयार गर्;","poem":2},{"text":"देशमाथि अधिकार गर्न र पृथ्वीका सहरहरू ढाक्न","poem":1},{"text":"तिनीहरू उठ्न पाउनेछैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"सेनाहरूका याहवेह घोषणा गर्नुहुन्छ:","poem":1},{"text":"“म तिनीहरूको विरुद्ध उठ्नेछु।","poem":2},{"text":"म बेबिलोनबाट बाँचेकाहरू,","poem":1},{"text":"त्यसका सन्तान र त्यसको नाम मेटिदिनेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“म त्यसलाई उल्‍लुको स्थानमा,","poem":1},{"text":"र सिमसार धापमा परिणत गर्नेछु;","poem":2},{"text":"म त्यसलाई विनाशको कुचोले बढार्नेछु,”","poem":1},{"text":"सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":24,"content":["सेनाहरूका याहवेहले शपथ खानुभएको छ,",{"text":"“मैले जे योजना बनाएको छु, त्यो निश्‍चय पूरा हुनेछ;","poem":1},{"text":"अनि मैले जे इच्छा गरेको छु, त्यो अटल रहनेछ।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"म आफ्नो देशमा अश्शूरलाई धुलोपिठो पार्नेछु;","poem":1},{"text":"म आफ्ना पर्वतहरूमा त्यसलाई कुल्चनेछु।","poem":2},{"text":"मेरा मानिसहरूबाट त्यसको जुवा निकालिनेछ;","poem":1},{"text":"अनि तिनीहरूका काँधबाट त्यसको भारी हटाइनेछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"सारा संसारका निम्ति तोकिएको योजना यही हो;","poem":1},{"text":"सारा जातिहरूमाथि फैलाइएको हात यही हो।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"सेनाहरूका याहवेहले नै यो विचार गर्नुभएको हो, कसले उहाँलाई विफल बनाउन सक्ला र?","poem":1},{"text":"उहाँले हात फैलाउनुभएको छ, कसले त्यसलाई फर्काउन सक्ला र?","poem":2}]},{"type":"heading","content":["पलिश्तीहरूको विरुद्ध भविष्यवाणी"]},{"type":"verse","number":28,"content":["आहाज राजा मरेको वर्षमा यो भविष्यवाणी आयो:"]},{"type":"verse","number":29,"content":[{"text":"हे सबै पलिश्ती हो,","poem":1},{"text":"तिमीहरूलाई प्रहार गर्ने लहुरो भाँचियो भनेर नरमाओ;","poem":2},{"text":"त्यस सर्पको वंशबाट अति विषालु सर्प निस्कनेछ,","poem":1},{"text":"र प्रहार गर्ने विषालु सर्प त्यसको फल हुनेछ।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"गरिबहरूभन्दा गरिबले खर्क पाउनेछ,","poem":1},{"text":"र खाँचोमा परेकाहरू सुरक्षामा रहनेछन्।","poem":2},{"text":"तर तेरो वंशलाई म अनिकालले नाश पार्नेछु,","poem":1},{"text":"त्यसले तेरा बाँचेकाहरूलाई मार्नेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"हे मूलढोका, विलाप गर्! हे सहर, चीत्कार गर्!","poem":1},{"text":"हे सबै पलिश्ती हो, पग्लेर जाओ!","poem":2},{"text":"उत्तर दिशाबाट धुवाँको बादल आउँछ;","poem":1},{"text":"अनि त्यसको सेनामा बरालिने कोही छैन।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"त्यस जातिका राजदूतहरूलाई","poem":1},{"text":"कस्तो जवाफ दिइनेछ?","poem":2},{"text":"“याहवेहले सियोनलाई स्थापित गर्नुभएको छ;","poem":1},{"text":"अनि कष्‍ट पाएका जातिले त्यसमा आश्रय पाउनेछन्।”","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"शाफोन कनानीहरूको अति पवित्र पर्वत मानिन्थ्यो","reference":{"chapter":14,"verse":13}}]},"thisChapterLink":"/api/npi_ncb/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}