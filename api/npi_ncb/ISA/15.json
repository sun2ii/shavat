{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["मोआबको विरुद्ध भविष्यवाणी"]},{"type":"verse","number":1,"content":["मोआबको बारेमा भविष्यवाणी:",{"text":"मोआबको आर सहर नष्‍ट पारिएको छ,","poem":1},{"text":"त्यो एकै रातमा नाश भएको छ!","poem":2},{"text":"मोआबको कीर सहर नष्‍ट भएको छ;","poem":1},{"text":"त्यो एकै रातमा नाश भएको छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"दीबोन त्यसको मन्दिरमा हुन्छ,","poem":1},{"text":"त्यसका देवस्थानहरूमा रुनलाई उक्लिएको छ;","poem":2},{"lineBreak":true},{"text":"मोआब नेबो र मेदेबाको निम्ति बिलौना गर्छ।","poem":2},{"text":"प्रत्येक शिर खौरिएको छ;","poem":1},{"text":"अनि प्रत्येक दाह्री काटिएको छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"सडकहरूमा तिनीहरूले भाङ्ग्रा लगाएर बस्छन्;","poem":1},{"text":"घरका कौसीहरू र सार्वजनिक चोकहरूमा","poem":2},{"text":"तिनीहरू सबै लम्पसार परेर,","poem":1},{"text":"रुँदै विलाप गर्छन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हेश्बोन र एलालेह चीत्कार गर्छन्;","poem":1},{"text":"तिनीहरूका सोर यहसासम्म नै सुनिन्छ।","poem":2},{"text":"यसकारण मोआबका हतियारधारी मानिसहरू चीत्कार गर्छन्;","poem":1},{"text":"र तिनीहरूका हृदय व्याकुल भएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मेरो हृदय मोआबको दुर्दशा देखेर रुन्छ;","poem":1},{"text":"त्यसका भगुवाहरू सोअरसम्म नै,","poem":2},{"lineBreak":true},{"text":"एग्लत-शलीशियाहसम्म नै भागेर जान्छन्।","poem":2},{"text":"तिनीहरू लूहीत जाने उकालो,","poem":1},{"text":"रुँदै-रुँदै चढ्छन्;","poem":2},{"text":"होरोनैम जाने बाटोमा तिनीहरू","poem":1},{"text":"आफ्ना सर्वनाशको लागि विलाप गर्छन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"निम्रीमका पानी सुकिगएका छन्,","poem":1},{"text":"र घाँस ओइलाएको छ;","poem":2},{"text":"घाँसपात छँदैछैन,","poem":1},{"text":"र कुनै हरियो थोक छँदैछैन।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यसरी तिनीहरूले प्राप्‍त गरेर थुपारेका धन","poem":1},{"text":"तिनीहरूले लहरे पीपलहरूको खोल्सामा ओसार्छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरूका चीत्कार मोआबको सिमानाभरि सुनिन्छ;","poem":1},{"text":"तिनीहरूका रुवाइ एग्लैमसम्म सुनिन्छ;","poem":2},{"lineBreak":true},{"text":"तिनीहरूका विलाप बेअर-एलीमसम्मै सुनिन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"दिमोनका पानी रक्ताम्मे छन्,","poem":1},{"text":"तर म दिमोनमाथि अझ बढी ल्याउनेछु—","poem":2},{"text":"मोआबका भगुवाहरूमाथि","poem":1},{"text":"र देशमा रहेकाहरूमाथि म एउटा सिंह ल्याउनेछु।","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}