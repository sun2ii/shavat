{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"सेलाबाट सियोनका छोरीहरूको पर्वतमा","poem":1},{"text":"देशका शासककहाँ","poem":2},{"text":"सौगातको रूपमा","poem":1},{"text":"थुमाहरू पठाओ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"अर्नोनका जँघारमा सियोनका स्त्रीहरू,","poem":1},{"text":"गुँडबाट धपाइएर","poem":2},{"text":"यताउता उडिरहने","poem":1},{"text":"चराहरूझैँ भएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"मोआबले भन्छ, “हामीलाई सल्‍लाह देओ,","poem":1},{"text":"एउटा निर्णय लेओ।","poem":2},{"text":"मध्यदिनमा तिम्रो छाया","poem":1},{"text":"रातझैँ बनाओ!","poem":2},{"text":"भगुवाहरूलाई लुकाओ,","poem":1},{"text":"शरणार्थीहरूलाई धोका नदेओ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मोआबी भगुवाहरूलाई तिमीहरूसित बस्‍न देओ;","poem":1},{"text":"नाश गर्नेहरूको सामु तिनीहरूका निम्ति आश्रय बनिदेओ।”","poem":2},{"lineBreak":true},{"text":"थिचोमिचो गर्नेहरूको अन्त्य हुनेछ,","poem":1},{"text":"र सर्वनाश समाप्‍त हुनेछ;","poem":2},{"lineBreak":true},{"text":"आक्रमणकारी देशबाट लोप हुनेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"प्रेममा एउटा सिंहासन स्थापित हुनेछ;","poem":1},{"text":"त्यसमा दावीदको घरानाबाट","poem":2},{"lineBreak":true},{"text":"विश्‍वासयोग्य एक मानिस विराजमान हुनुहुनेछ;","poem":2},{"text":"उहाँले न्याय गर्दा निष्पक्षतासाथ गर्नुहुनेछ;","poem":1},{"text":"र धार्मिकतामा काम गर्न ढिलो गर्नुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"हामीले मोआबको अहङ्कारको कुरा सुनेका छौँ,","poem":1},{"text":"त्यसका प्रचण्ड अहङ्कार र आत्मभिमान,","poem":2},{"text":"त्यसको अभिमान, घमण्ड र त्यसको धाक;","poem":1},{"text":"तर त्यसका घमण्डहरू खोक्रा छन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यसकारण मोआबीहरू विलाप गर्नेछन्;","poem":1},{"text":"तिनीहरू एकसाथ मोआबकै निम्ति विलाप गर्नेछन्।","poem":2},{"text":"कीर-हरेशेतका किसमिसका निम्ति","poem":1},{"text":"विलौना र शोक गर।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हेश्बोनका खेतहरू","poem":1},{"text":"र सिब्माका दाखहरू पनि ओइलाउँछन्।","poem":2},{"text":"जातिहरूका शासकहरूले","poem":1},{"text":"अति सुन्दर दाखहरू कुल्चेका छन्,","poem":2},{"text":"जो एक समय याजेरसम्म नै पुगेका थिए;","poem":1},{"text":"अनि मरुभूमिभरि फैलिएका थिए।","poem":2},{"text":"तिनीहरूका टुसाहरू फैलिएर","poem":1},{"text":"समुद्रसम्म पुगेका थिए।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यसकारण सिब्माका दाखहरूका निम्ति","poem":1},{"text":"याजेर रोएझैँ म रुन्छु।","poem":2},{"text":"हे हेश्बोन, हे एलाले,","poem":1},{"text":"म तँलाई आँसुले भिजाउँछु!","poem":2},{"text":"तेरा पाकेको फलहरूका निम्ति","poem":1},{"text":"निकालिएका आनन्दका चीत्कारहरू चकमन्‍न पारिएका छन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"फलका बगैँचाहरूबाट हर्ष र आनन्द लगिएका छन्;","poem":1},{"text":"दाखबारीहरूमा कसैले पनि गाउँदैन, न त कराउँछ;","poem":2},{"text":"कसैले पनि कोमल दाखमद्य कोलमा पेल्दैन;","poem":1},{"text":"किनकि मैले हर्षको आवाज समाप्‍त गरिदिएको छु।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"मेरो हृदयले मोआबका निम्ति,","poem":1},{"text":"र मेरो अन्तस्करणले कीर-हरेशेतका निम्ति वीणाले झैँ विलाप गर्दछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मोआब आफ्नो पूजाको अग्ला ठाउँहरूमा देखा पर्दा,","poem":1},{"text":"ऊ आफूभित्र खिन्‍न मात्र हुन्छ;","poem":2},{"text":"आफ्नो पवित्रस्थानमा प्रार्थना गर्न जाँदा,","poem":1},{"text":"त्यसलाई केही फाइदा हुँदैन।","poem":2}]},{"type":"verse","number":13,"content":["मोआबको विषयमा पहिल्यै भन्‍नुभएको याहवेहको वचन यही हो।"]},{"type":"verse","number":14,"content":["तर अब याहवेह भन्‍नुहुन्छ: “वाचा-बन्धनमा परेको सेवकले आफ्ना दिनहरू गनेझैँ, तीन वर्षभित्रमा मोआबको गौरव र त्यसका सबै मानिसहरू तुच्छ ठहरिनेछन्; अनि त्यसका बाँचेकाहरू अति थोरै र कमजोर हुनेछन्।”"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}