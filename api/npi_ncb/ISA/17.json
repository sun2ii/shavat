{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":17,"content":[{"type":"heading","content":["दमस्कसको विरुद्धमा भविष्यवाणी"]},{"type":"verse","number":1,"content":["दमस्कसको विषयमा भविष्यवाणी:",{"text":"“हेर, अब उसो दमस्कस एउटा सहर रहनेछैन,","poem":1},{"text":"तर त्यो भग्नावशेष थुप्रोको रास हुनेछ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"अरोएरका सहरहरू उजाड पारिनेछन्,","poem":1},{"text":"त्यहाँ बगाल चर्नेछन् र आराम गर्नेछन्;","poem":2},{"lineBreak":true},{"text":"अनि कसैले तिनीहरूलाई तर्साउनेछैन।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"सुरक्षित सहर एफ्राइमबाट हराउनेछ,","poem":1},{"text":"र दमस्कसबाट राजकीय शक्ति हटाइनेछ;","poem":2},{"text":"अरामका बाँचेको भाग","poem":1},{"text":"इस्राएलीहरूको गौरवझैँ हुनेछ,”","poem":2},{"lineBreak":true},{"text":"सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“त्यस दिन याकोबको गौरव लोप हुनेछ;","poem":1},{"text":"त्यसको शरीरको बोसो बिलाएर जानेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"कटनी गर्नेले खडा रहेको बाली जम्मा गरेजस्तो त्यो हुनेछ;","poem":1},{"text":"त्यसको हातले अन्‍न टिपेझैँ","poem":2},{"text":"रपाईहरूको बेँसीमा","poem":1},{"text":"कुनै मानिसले शिला-बाला टिपेझैँ त्यो हुनेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तापनि जैतुनको रूखबाट फल झारेपछि","poem":1},{"text":"दुई-तीन वटा फल हाँगाको टुप्पाका रहेझैँ,","poem":2},{"text":"चार-पाँच वटा फलदायक हाँगाहरूमा रहेझैँ,","poem":1},{"text":"केही शिला-बालाचाहिँ रहनेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह, इस्राएलका परमेश्‍वर घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"त्यस दिन मानिसहरूले आफ्ना सृष्‍टिकर्तालाई हेर्नेछन्;","poem":1},{"text":"अनि तिनीहरूका आँखा इस्राएलका पवित्र परमेश्‍वरतिर फर्काउनेछन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरूले वेदीहरूतिर हेर्नेछैनन्","poem":1},{"text":"जो तिनीहरूका आफ्ना हातका कामहरू हुन्;","poem":2},{"text":"अनि अशेरा देवीका खम्बाहरू र आफ्ना औँलाले बनाएको धूप-वेदीहरूप्रति","poem":1},{"text":"तिनीहरूको श्रद्धा हुनेछैन।","poem":2}]},{"type":"verse","number":9,"content":["त्यस दिन तिनीहरूले इस्राएलीहरूका कारण छोडेका आफ्ना बलिया सहरहरू जङ्गलका निम्ति त्यागिएका ठाउँहरूझैँ हुनेछन्। अनि सबै उजाडस्थान भइजानेछ।"]},{"type":"verse","number":10,"content":[{"text":"तिमीहरूले परमेश्‍वर आफ्ना उद्धारकर्तालाई बिर्सेका छौ;","poem":1},{"text":"तिमीहरूले आफ्ना चट्टान र किल्‍लालाई सम्झेका छैनौ।","poem":2},{"text":"यसकारण तिमीहरूले उत्तम बोटहरू","poem":1},{"text":"र परदेशी कलमीहरू रोप्छौ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तिमीहरूले रोपेकै दिन ती हुर्काए तापनि;","poem":1},{"text":"अनि तिमीहरूले ती बिहान रोपेर कोपिला लागे तापनि","poem":2},{"text":"रोग र निको नहुने कष्‍टको दिनमा","poem":1},{"text":"कटनी शून्य हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"हाय! धेरै राष्ट्रहरूका खैलाबैला,","poem":1},{"text":"तिनीहरू जो समुद्रझैँ हल्‍ला मच्‍चाउँछन्!","poem":2},{"text":"सुन! जातिहरूका खैलाबैला—","poem":1},{"text":"तिनीहरू जो समुद्रको गर्जनझैँ गर्जन्छन्!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"पानीको बेग गर्जेझैँ मानिसहरू गर्जिए तापनि","poem":1},{"text":"परमेश्‍वरले तिनीहरूलाई हप्काउनुहुँदा तिनीहरू टाढा-टाढा भाग्नेछन्;","poem":2},{"text":"अनि डाँडाहरूमा हावाले उडाएका भुसझैँ,","poem":1},{"text":"र आँधीको सामु सानो झारझैँ हुर्‍याइनेछन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"साँझमा अचानक आतङ्क हुन्छ!","poem":1},{"text":"बिहान उज्यालो हुनुअगि नै तिनीहरू गइसकेका हुन्छन्!","poem":2},{"text":"हामीलाई लुट्नेहरूको भाग यस्तै हुनेछ;","poem":1},{"text":"हामीलाई लुटपाट गर्नेहरूको गति यही हुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}