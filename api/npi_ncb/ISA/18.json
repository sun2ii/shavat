{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["कूश देशको विरुद्धमा भविष्यवाणी"]},{"type":"verse","number":1,"content":[{"text":"धिक्‍कार, कूशका नदीहरूका किनारमा भएको","poem":1},{"text":"हुरुरु आवाज","poem":2},{"noteId":13},{"text":"निकाल्नेहरूको देश,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जसले पानीमाथि निगालोका डुङ्गाहरूमा","poem":1},{"text":"समुद्री बाटोद्वारा दूतहरू पठाउँछ।","poem":2},{"lineBreak":true},{"text":"फूर्तिला दूतहरू,","poem":1},{"lineBreak":true},{"text":"अग्ला र चिल्‍ला छाला भएका मानिसहरूकहाँ जाओ;","poem":1},{"text":"चारैतिर डर मानिएका जातिकहाँ,","poem":2},{"text":"अनौठो बोली भएका आक्रमणकारी जातिकहाँ,","poem":1},{"text":"जसको देशलाई नदीहरूले भाग-भाग गरेको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे संसारका सबै मानिसहरू हो,","poem":1},{"text":"जो यस पृथ्वीमा बस्दछौ,","poem":2},{"text":"जब पर्वतहरूमा एउटा झण्डा उठाइन्छ,","poem":1},{"text":"तिमीहरूले त्यसलाई देख्नेछौ;","poem":2},{"text":"अनि तुरही बज्दा","poem":1},{"text":"तिमीहरूले त्यो सुन्‍नेछौ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"याहवेहले मलाई यसो भन्‍नुहुन्छ:","poem":1},{"text":"“म चुपचाप रहनेछु र घाम चर्केको तापझैँ,","poem":2},{"text":"र कटनीको समय गर्मीमा शीतको बादलझैँ","poem":1},{"text":"आफ्नो वासस्थानबाट हेर्नेछु।”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"किनकि जब कटनीको अगि कोपिला फक्रिसकेको हुन्छ,","poem":1},{"text":"र फूलबाट बढेर अङ्‌गुर पाकेको हुन्छ,","poem":2},{"text":"तब उहाँले टुसालाई हँसियाले छिँवल्नुहुनेछ;","poem":1},{"text":"अनि फैलिएका ती हाँगाहरूलाई काटेर लैजानुहुनेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिनीहरू पर्वतका शिकारी पक्षीहरूकहाँ","poem":1},{"text":"र वन-पशुहरूकहाँ छोडिनेछन्;","poem":2},{"text":"तब पक्षीहरूले ग्रीष्मकालभरि","poem":1},{"text":"र वन-पशुहरूले चाहिँ हिउँदभरि खानेछन्।","poem":2}]},{"type":"verse","number":7,"content":["त्यस समय सेनाहरूका याहवेहको अगि उपहार ल्याइनेछ।",{"text":"अग्ला र चिल्‍ला छाला भएका मानिसहरूबाट","poem":1},{"text":"चारैतिर डर मानिएका जातिबाट,","poem":2},{"text":"अनौठो बोली भएका आक्रमणकारी जातिबाट,","poem":1},{"text":"जसको देशलाई नदीहरूले भाग गरेको छ।","poem":2},"सेनाहरूका याहवेहको नाम भएको ठाउँमा सियोन पर्वतमा नै याहवेहकहाँ उपहार ल्याइनेछ।"]}],"footnotes":[{"noteId":13,"caller":"+","text":"अथवा सलह","reference":{"chapter":18,"verse":1}}]},"thisChapterLink":"/api/npi_ncb/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}