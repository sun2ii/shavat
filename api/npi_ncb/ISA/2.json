{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["याहवेहको पर्वत"]},{"type":"verse","number":1,"content":["यहूदा र यरूशलेमको विषयमा आमोजका छोरा यशैयाले देखेका दर्शन यही हो:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["अन्तिम दिनहरूमा",{"text":"याहवेहको मन्दिरको पर्वत","poem":1},{"text":"अरू पर्वतहरूमध्ये प्रमुख भएर स्थापित गरिनेछ,","poem":2},{"text":"र पहाडहरूभन्दा माथि उठाइनेछ;","poem":1},{"text":"अनि सबै जातिहरू त्यसमा ओइरिएर आउनेछन्।","poem":2}]},{"type":"verse","number":3,"content":["धेरै जातिहरू आएर भन्‍नेछन्,",{"text":"“आओ, हामीहरू याहवेहको पर्वतमा,","poem":1},{"text":"याकोबका परमेश्‍वरको मन्दिरमा जाऔँ।","poem":2},{"text":"उहाँले हामीलाई उहाँका मार्गहरू सिकाउनुहुनेछ,","poem":1},{"text":"ताकि हामी उहाँका मार्गहरूमा हिँड्न सकौँ।”","poem":2},{"text":"व्यवस्था सियोनबाट","poem":1},{"text":"र याहवेहको वचन यरूशलेमबाट निस्कनेछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उहाँले राष्ट्रहरूका बीचमा न्याय गर्नुहुनेछ;","poem":1},{"text":"अनि धेरै जतिहरूका वाद-विवाद सुल्झाउनुहुनेछ।","poem":2},{"text":"तिनीहरूले आफ्ना तरवारहरू पिटेर हलोका फालीहरू बनाउनेछन्,","poem":1},{"text":"र भालाहरू पिटेर हँसियाहरू बनाउनेछन्।","poem":2},{"text":"एउटा राष्ट्रले अर्को राष्ट्रको विरुद्धमा तरवार उठाउनेछैन,","poem":1},{"text":"न त तिनीहरूले फेरि कहिल्यै युद्धका निम्ति तालिम दिनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे याकोबका घराना, आओ,","poem":1},{"text":"र हामी याहवेहको ज्योतिमा हिँडौँ।","poem":2}]},{"type":"heading","content":["याहवेहको दिन"]},{"type":"verse","number":6,"content":[{"text":"हे याहवेह, तपाईंले आफ्नो प्रजा","poem":1},{"text":"याकोबका घरानालाई त्याग्नुभएको छ।","poem":2},{"text":"तिनीहरू पूर्वका अन्धविश्‍वासले भरिएका छन्;","poem":1},{"text":"तिनीहरू पलिश्तीहरूले झैँ जोखना हेर्छन्","poem":2},{"lineBreak":true},{"text":"र तिनीहरूका रीतिरिवाज अपनाउँछन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरूको देश चाँदी र सुनले भरिएको छ,","poem":1},{"text":"तिनीहरूको धनसम्पत्ति अपार छ।","poem":2},{"text":"तिनीहरूको देशमा घोडाहरू प्रशस्त छन्;","poem":1},{"text":"तिनीहरूका रथहरूको गन्ती छैन।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरूको देशभरि मूर्तिहरू छन्;","poem":1},{"text":"तिनीहरू आफ्ना हातका कामहरू,","poem":2},{"lineBreak":true},{"text":"र आफ्ना औँलाले बनाएका कुराहरूका सामु निहुरिन्छन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यसकारण मानिस होच्याइनेछ,","poem":1},{"text":"र हरेकलाई नम्र तुल्याइनेछ—","poem":2},{"lineBreak":true},{"text":"यसकारण तिनीहरूलाई क्षमा नगर्नुहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"याहवेहको डरबाट","poem":1},{"text":"र उहाँको सर्वश्रेष्‍ठताको प्रतापबाट","poem":2},{"lineBreak":true},{"text":"चट्टानभित्र पस्, माटोमुनि लुक्!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"घमण्डीका आँखालाई नम्र तुल्याइनेछ;","poem":1},{"text":"अनि मानिसहरूको अहङ्कार तल झारिनेछ।","poem":2},{"text":"त्यस दिन याहवेह मात्र उच्‍च पारिनुहुनेछ।","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"सबै अभिमानी र वैभवशालीहरूका निम्ति,","poem":1},{"text":"र उच्‍च पारिएकाहरू सबैका निम्ति,","poem":2},{"text":"सेनाहरूका याहवेहले एउटा दिन साँचेर राख्नुभएको छ।","poem":1},{"text":"त्यस दिन तिनीहरू विनम्र तुल्याइनेछन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"लेबनानका सबै अग्ला र ठूला देवदारु,","poem":1},{"text":"र बाशानका सबै फलाँटका रूखहरूका निम्ति,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"धरहराझैँ उठेका सबै पर्वत,","poem":1},{"text":"र सबै अग्ला डाँडाहरूका निम्ति,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"प्रत्येक ठूला धरहरा,","poem":1},{"text":"र प्रत्येक सुरक्षित पर्खालका निम्ति,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तर्शीशको प्रत्येक व्यापारी जहाज,","poem":1},{"text":"र प्रत्येक राजकीय जहाजको निम्ति।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"मानिसको अभिमान चूर्ण पारिनेछ,","poem":1},{"text":"र मानिसहरूको घमण्ड नम्र बनाइनेछ;","poem":2},{"text":"त्यस दिन याहवेह मात्र उच्‍च पारिनुहुनेछ;","poem":1}]},{"type":"verse","number":18,"content":[{"text":"अनि मूर्तिहरू सम्पूर्ण रूपले लोप हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"जब पृथ्वी हल्‍लाउनलाई","poem":1},{"text":"याहवेह उठ्नुहुन्छ,","poem":2},{"text":"तब उहाँको डर र उहाँको वैभवको प्रतापबाट","poem":1},{"text":"मानिसहरू चट्टानका गुफाहरूतिर","poem":2},{"lineBreak":true},{"text":"र पृथ्वीका प्वालहरूभित्र पस्‍नेछन्।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"त्यस दिन मानिसहरूले","poem":1},{"text":"आफ्ना लागि पुज्न भनी बनाएका","poem":2},{"text":"चाँदीका मूर्तिहरू र सुनका मूर्तिहरू","poem":1},{"text":"छुचुन्द्रा र चमेराहरूको अगि फालिदिनेछन्।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"याहवेहले पृथ्वीलाई हल्‍लाउनलाई उठ्नुहुँदा","poem":1},{"text":"उहाँको डर र उहाँको वैभवको प्रतापबाट","poem":2},{"text":"तिनीहरू चट्टानका कन्दराहरूतिर","poem":1},{"text":"र चट्टानका धाँदाहरूभित्र भागेर जानेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"नाकको प्वालमा सास भएको मानिसमा","poem":1},{"text":"भरोसा राख्न छोडिदेओ,","poem":2},{"lineBreak":true},{"text":"त्यसको के मूल्य छ र?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}