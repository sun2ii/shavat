{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["बेबिलोनको विरुद्धमा भविष्यवाणी"]},{"type":"verse","number":1,"content":["समुद्रको किनारमा भएको उजाडस्थानको विषयमा भविष्यवाणी:",{"text":"भुमरीले दक्षिण देशलाई स्वात्तै लगेझैँ,","poem":1},{"text":"उजाडस्थानबाट, आतङ्कको देशबाट","poem":2},{"lineBreak":true},{"text":"एउटा आक्रमणकारी आउँछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"मलाई एउटा डरलाग्दो दर्शन देखाइएको छ:","poem":1},{"text":"देशद्रोहीले विश्‍वासघात गर्छ, लुटेराले लुटेर लैजान्छ।","poem":2},{"text":"एलाम, आक्रमण गर्! मादी घेरा हाल्!","poem":1},{"text":"म त्यसका सबै क्रन्दनहरू समाप्‍त गरिदिनेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"यस दर्शनले मेरो शरीर कष्‍टले भरिएको छ,","poem":1},{"text":"मलाई प्रसव-वेदनामा परेकी स्त्रीलाई झैँ व्यथा लागेको छ;","poem":2},{"text":"म जे सुन्छु, त्यसको कारण म धरमराएको छु,","poem":1},{"text":"म जे देख्छु, त्यसको कारण म हडबडाएको छु।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मेरो हृदय काम्छ,","poem":1},{"text":"डरले मलाई ढुक-ढुक बनाउँछ;","poem":2},{"text":"मैले इच्छा गरेको साँझ","poem":1},{"text":"मेरा निम्ति त्रास भएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तिनीहरू टेबुल सजाउँछन्,","poem":1},{"text":"तिनीहरू गलैँचा ओछ्याउँछन्,","poem":2},{"lineBreak":true},{"text":"तिनीहरू खान्छन्, तिनीहरू पिउँछन्!","poem":2},{"text":"अधिकृतहरू उठ,","poem":1},{"text":"ढालमा तेल लगाओ!","poem":2}]},{"type":"verse","number":6,"content":["प्रभु मलाई यसो भन्‍नुहुन्छ:",{"text":"“जा, पहरेदार खटा,","poem":1},{"text":"र त्यसले के देख्छ, त्यो बताओस्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"जब त्यसले घोडाको टोलीसित रथहरू,","poem":1},{"text":"गधामाथि सवार भएकाहरू","poem":2},{"text":"अथवा ऊँटमाथि सवार भएकाहरूलाई देख्छ,","poem":1},{"text":"तब त्यो सावधान,","poem":2},{"text":"खूबै सावधान रहोस्।”","poem":1}]},{"type":"verse","number":8,"content":["तब पहरेदार",{"noteId":16},"चिच्यायो,",{"text":"“मेरा प्रभु, म दिनहुँ धरहरामा खडा रहन्छु;","poem":1},{"text":"प्रत्येक रात म आफ्नो चौकीमा बस्छु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हेर्नुहोस्, एउटा मानिस घोडाहरूको टोलीसित","poem":1},{"text":"रथमा सवार भएर आइरहेछ।","poem":2},{"text":"अनि त्यसले प्रत्युत्तर दिन्छ:","poem":1},{"text":"‘बेबिलोन ढलेको छ, ढलेको छ!","poem":2},{"text":"त्यसका देवताहरूका सबै मूर्तिहरू","poem":1},{"text":"चकनाचुर पारिएर भुइँमा छरिएका छन्।’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"हे खलामा दाइँ गरिएका मेरा मानिस हो,","poem":1},{"text":"मैले सेनाहरूका याहवेह, इस्राएलका परमेश्‍वरबाट","poem":2},{"text":"जे सुनेको छु,","poem":1},{"text":"त्यो म तिमीहरूलाई भन्छु।","poem":2}]},{"type":"heading","content":["एदोमको विरुद्धमा भविष्यवाणी"]},{"type":"verse","number":11,"content":["दुमाको",{"noteId":17},"विरुद्धमा भविष्यवाणी:",{"text":"सेइरबाट मलाई कसैले बोलाउँछ,","poem":1},{"text":"“पहरेदार, रात कति बाँकी छ?","poem":2},{"lineBreak":true},{"text":"पहरेदार, रात कति बाँकी छ?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"पहरेदारले जवाफ दिन्छ,","poem":1},{"text":"“बिहान हुन लाग्यो, तर पनि रात आउँदैछ।","poem":2},{"text":"यदि तिमीलाई केही सोधखोज गर्ने हो भने सोध;","poem":1},{"text":"र फेरि फर्केर सोध्न आऊ।”","poem":2}]},{"type":"heading","content":["अरबको विरुद्धमा भविष्यवाणी"]},{"type":"verse","number":13,"content":["अरब देशको विषयमा भविष्यवाणी:",{"text":"ददानीहरूका यात्री दलहरू,","poem":1},{"text":"जो अरबका झाडीहरूमा छाउनी हालेर बस्छौ,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"तिर्खाएकाहरूको निम्ति पानी ल्याओ;","poem":2},{"text":"तेमामा बस्‍नेहरू,","poem":1},{"text":"शरणार्थीहरूका निम्ति भोजन ल्यायो।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तिनीहरू तरवारबाट,","poem":1},{"text":"नाङ्गो तरवारबाट,","poem":2},{"text":"नुहेका धनुबाट,","poem":1},{"text":"र घोर लडाइँबाट भाग्छन्।","poem":2}]},{"type":"verse","number":16,"content":["प्रभु मलाई यसो भन्‍नुहुन्छ: “वाचा-बन्धनमा परेको सेवकले दिन गनेझैँ एक वर्षभित्रमा केदारका सबै रवाफ समाप्‍त हुनेछ।"]},{"type":"verse","number":17,"content":["धनुर्धारीहरू र केदारका योद्धाहरू थोरै मात्र बाँच्नेछन्।” याहवेह, इस्राएलका परमेश्‍वर बोल्नुभएको छ।"]}],"footnotes":[{"noteId":16,"caller":"+","text":"केही प्राचीन पा.लि.हरूमा सिंह","reference":{"chapter":21,"verse":8}},{"noteId":17,"caller":"+","text":"दुमाको एदोमको अर्को नाम हो, अर्थ शान्त","reference":{"chapter":21,"verse":11}}]},"thisChapterLink":"/api/npi_ncb/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}