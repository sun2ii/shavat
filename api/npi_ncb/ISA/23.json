{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["टायरको विरुद्धमा भविष्यवाणी"]},{"type":"verse","number":1,"content":["टायरको विषयमा भविष्यवाणी:",{"text":"हे तर्शीशका जहाज हो, विलाप गर!","poem":1},{"text":"किनकि टायर नाश भएको छ,","poem":2},{"lineBreak":true},{"text":"र घर वा बन्दरगाहरहित भएको छ।","poem":2},{"text":"कित्तीम","poem":1},{"noteId":18},{"text":"देशबाट,","poem":1},{"text":"तिनीहरूकहाँ यो वचन आएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"हे टापुका मानिसहरू","poem":1},{"text":"र सीदोनका व्यापारीहरू हो, चुप लाग!","poem":2},{"lineBreak":true},{"text":"तिमीहरूलाई समुद्री व्यवसायीहरूले धनी तुल्याएका छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"विशाल समुद्रमा","poem":1},{"text":"शीहोरका अन्‍न आयो;","poem":2},{"text":"नील नदीको कटनी टायरको कर थियो;","poem":1},{"text":"अनि त्यो जातिहरूको व्यापार-केन्द्र भएको थियो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे सीदोन र सामुद्रिक किल्‍ला, लज्जित होओ;","poem":1},{"text":"किनकि समुद्रले यसो भनेको छ:","poem":2},{"text":"“न म सुत्केरी वेदनामा परेकी छु, न त मैले बालक जन्माएकी छु;","poem":1},{"text":"न त मैले छोराहरू हुर्काएकी छु, न छोरीहरूलाई पालनपोषण गरेकी छु।”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जब इजिप्टमा वचन आउँछ,","poem":1},{"text":"तब तिनीहरू टायरको समाचार सुनेर दुःखित हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"तिमीहरू तर्शीशतिर जाओ;","poem":1},{"text":"हे टापुका मानिसहरू हो, विलाप गर।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"के तिमीहरूका मनोरञ्जनको सहर यही हो?","poem":1},{"text":"त्यो पुरानो, अति पुरानो सहर,","poem":2},{"text":"जसका खुट्टाले त्यसलाई","poem":1},{"text":"टाढा देशहरूमा गएर बसोबास गर्न लगायो!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मुकुटहरू प्रदान गर्ने","poem":1},{"text":"टायरको विरुद्धमा कसले यो योजना बनायो?","poem":2},{"text":"जसका व्यापारीहरू राजकुमारहरू हुन्,","poem":1},{"text":"जसका व्यापारीहरू संसारमा प्रख्यात छन्!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यसका सबै प्रतापको घमण्डलाई होच्याउन,","poem":1},{"text":"र संसारमा प्रख्यात भएकाहरूलाई नम्र तुल्याउन","poem":2},{"lineBreak":true},{"text":"सेनाहरूका याहवेहले नै यो योजना बनाउनुभएको हो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"हे तर्शीशकी छोरी,","poem":1},{"text":"नील नदीको किनारमा जस्तै आफ्नो जमिन जोत्,","poem":2},{"lineBreak":true},{"text":"किनकि अब तँसित कुनै बन्दरगाह रहेन।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेहले आफ्नो हात समुद्रमाथि पसार्नुभएको छ,","poem":1},{"text":"र त्यसका राज्यहरूलाई हल्‍लाउनुभएको छ।","poem":2},{"text":"उहाँले त्यसको किल्‍ला नष्‍ट होस् भनेर","poem":1},{"text":"फोनिकेको विषयमा आज्ञा दिनुभएको छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"उहाँले भन्‍नुभयो, “हे सीदोनकी कन्या छोरी,","poem":1},{"text":"अब तेरा निम्ति खुशी आउनेछैन, तँ श्रापित भइस्!","poem":2},{"lineBreak":true},{"text":"“उठ्, कित्तीम र पश्‍चिमी किनारमा जा;","poem":1},{"text":"त्यहाँ पनि तैँले विश्राम पाउनेछैनस्।”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"बेबिलोनीहरूको","poem":1},{"noteId":19},{"text":"देशलाई हेर्,","poem":1},{"text":"यो जाति, जसको अब कुनै मूल्य छैन!","poem":2},{"text":"अश्शूरहरूले त्यसलाई","poem":1},{"text":"मरुभूमिका जन्तुहरूको ठाउँ बनाएका छन्;","poem":2},{"text":"तिनीहरूले आफ्ना घेराबन्दीका धरहराहरू अग्ला बनाए;","poem":1},{"text":"तिनीहरूले त्यसका किल्‍लाहरू नाङ्गो पारिदिए,","poem":2},{"lineBreak":true},{"text":"र त्यसलाई नष्‍ट गरिदिए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"हे तर्शीशका जहाजहरू हो, विलाप गर;","poem":1},{"text":"तिमीहरूको किल्‍ला नष्‍ट पारिएको छ!","poem":2}]},{"type":"verse","number":15,"content":["त्यस समय टायर सत्तरी वर्षसम्म, अर्थात् एउटा राजाको जीवन अवधिसम्म बिर्सिईनेछ। तर सत्तरी वर्ष बितेपछि टायरको दशा एउटी वेश्याको गीतजस्तै हुनेछ।"]},{"type":"verse","number":16,"content":[{"text":"“हे बिर्सिएकी वेश्या,","poem":1},{"text":"वीणा लिएर सहरको बीचमा वरिपरि घुमिहिँड्;","poem":2},{"text":"सुमधुर वीणा बजा,","poem":1},{"text":"धेरै गीत गा, र तेरो फेरि स्मरण गरियोस्!”","poem":2}]},{"type":"verse","number":17,"content":["सत्तरी वर्ष बितेपछि यस्तो हुनेछ: याहवेहले टायरसित व्यवहार गर्नुहुनेछ। त्यो आफ्नो वेश्यावृत्तिको पेशातिर फर्किनेछे, र त्यसले पृथ्वीभरिका राज्यहरूसित आफ्नो व्यापार गर्नेछे।"]},{"type":"verse","number":18,"content":["र पनि त्यसको लाभ र त्यसको कमाइ याहवेहको निम्ति छुट्याइनेछ; ती भण्डारमा राखिनेछैनन् अथवा थुपारिनेछैनन्। त्यसका लाभहरू याहवेहको सामु रहनेहरूका निम्ति प्रशस्त भोजन र मसिनो वस्त्रको लागि जानेछन्।"]}],"footnotes":[{"noteId":18,"caller":"+","text":"अथवा साइप्रस","reference":{"chapter":23,"verse":1}},{"noteId":19,"caller":"+","text":"अथवा कल्दीहरूको","reference":{"chapter":23,"verse":13}}]},"thisChapterLink":"/api/npi_ncb/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}