{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["समस्त पृथ्वीमा विनाश"]},{"type":"verse","number":1,"content":[{"text":"हेर, याहवेहले पृथ्वीलाई उजाड पार्न","poem":1},{"text":"र त्यसलाई विनाश गर्न लाग्नुभएको छ;","poem":2},{"text":"उहाँले त्यसको सतह नष्‍ट पारिदिनुहुनेछ;","poem":1},{"text":"अनि त्यसका बासिन्दाहरूलाई छरपस्ट पारिदिनुहुनेछ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"यस्तो हालतचाहिँ सबैका निम्ति","poem":1},{"text":"एकैनास हुनेछ:","poem":2},{"lineBreak":true},{"text":"जस्तो सर्वसाधारणको हालत, पुजारीहरूको पनि त्यस्तै हालत,","poem":2},{"lineBreak":true},{"text":"जस्तो कमाराको हालत, मालिकको पनि त्यस्तै हालत,","poem":2},{"lineBreak":true},{"text":"जस्तो कमारीको हालत, मालिक्नीको पनि त्यस्तै हालत,","poem":2},{"lineBreak":true},{"text":"जस्तो किन्‍नेको हालत, बेच्नेको पनि त्यस्तै हालत,","poem":2},{"lineBreak":true},{"text":"जस्तो ऋण दिनेको हालत, ऋण लिनेको पनि त्यस्तै हालत हुनेछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"पृथ्वी पूर्ण रूपले उजाड रहनेछ;","poem":1},{"text":"अनि पूर्ण रूपले लुटपाट गरिनेछ।","poem":2},{"text":"याहवेहले यो वचन बोल्नुभएको हो।","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"पृथ्वी सुक्नेछ र ओइलाउनेछ;","poem":1},{"text":"संसारले विलाप गर्नेछ र ओइलाउनेछ;","poem":2},{"lineBreak":true},{"text":"पृथ्वीका उच्‍च मानिसहरू दुर्बल हुनेछन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"पृथ्वी त्यसमा भएका मानिसहरूद्वारा अशुद्ध भएको छ;","poem":1},{"text":"तिनीहरूले व्यवस्था भङ्ग गरेका छन्,","poem":2},{"text":"आज्ञाहरू उल्‍लङ्घन गरेका छन्;","poem":1},{"text":"अनि अनन्तको करार तोडेका छन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यसकारण श्रापले पृथ्वीलाई निलिहाल्छ;","poem":1},{"text":"यसका मानिसहरूले आफ्ना दोषको दण्ड भोग्नुपर्छ।","poem":2},{"text":"यसकारण पृथ्वीका बासिन्दाहरू जलाइएका छन्;","poem":1},{"text":"अनि थोरै मात्र बाँकी रहेका छन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"नयाँ दाखमद्य सुकेर जान्छ र दाख ओइलाउँछ;","poem":1},{"text":"आनन्द मनाउनेहरू सबै सुस्केरा हाल्छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"खैँजडीको हर्ष बन्द भएको छ,","poem":1},{"text":"हर्ष मनाउनेहरूको हल्‍ला रोकिएको छ,","poem":2},{"lineBreak":true},{"text":"हर्षपूर्ण वीणाको आवाज बन्द छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरूले गीतसित मद्य पिउन छोडे;","poem":1},{"text":"मद्य पिउनेहरूलाई त्यो तितो लाग्छ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ध्वंस भएको सहर उजाड भएको छ;","poem":1},{"text":"हरेक घरको प्रवेशद्वार बन्द भएको छ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"सडकहरूमा तिनीहरू मद्यको निम्ति कराउँछन्;","poem":1},{"text":"सबै आनन्द शोकमा परिणत हुन्छन्,","poem":2},{"lineBreak":true},{"text":"सबै उल्‍लास पृथ्वीबाट हराइसक्यो।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"सहर ध्वंस भएको अवस्थामा छोडिएको छ,","poem":1},{"text":"त्यसका मूलढोकाहरू टुक्रा-टुक्रा पारिएका छन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"जैतुनको रूख हल्‍लाउँदा","poem":1},{"text":"फलहरू झरे जस्तो,","poem":2},{"text":"अथवा अङ्‌गुर टिपिसकेपछि शिला छोडिएको जस्तो,","poem":1},{"text":"त्यो पृथ्वीमा र जाति-जातिहरूमा हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"तिनीहरूले आफ्ना सोर उचाल्छन्, तिनीहरू आनन्दसाथ कराउँछन्;","poem":1},{"text":"पश्‍चिमबाट तिनीहरूले याहवेहको महानताको जयजयकार गर्छन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"यसकारण पूर्वमा याहवेहलाई महिमा देओ;","poem":1},{"text":"याहवेह, इस्राएलका परमेश्‍वरको नाम","poem":2},{"lineBreak":true},{"text":"समुद्रका टापुहरूमा पनि उच्‍च पार।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"पृथ्वीको अन्तिम छेउबाट हामी गाएका सुन्छौँ:","poem":1},{"text":"“धर्मीलाई महिमा होस्।”","poem":2},{"lineBreak":true},{"text":"तर मैले भनेँ, “म सुकेर जाँदैछु, म सुकेर जाँदैछु!","poem":1},{"text":"मलाई धिक्‍कार छ!","poem":2},{"text":"धोकाबाजीहरूले विश्‍वासघात गर्छन्!","poem":1},{"text":"बेइमानीसाथ धोकाबाजीहरूले विश्‍वासघात गर्छन्!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"हे पृथ्वीका मानिस हो,","poem":1},{"text":"तिमीहरूलाई आतङ्क, खाडल र पासोले पर्खिरहेका छन्।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"आतङ्कको सोरमा भाग्नेहरू","poem":1},{"text":"खाडलमा पर्नेछन्;","poem":2},{"text":"खाडलबाट माथि चढ्नेहरू","poem":1},{"text":"पासोमा पर्नेछन्।","poem":2},{"lineBreak":true},{"text":"स्वर्गका भलका मूलढोकाहरू उघारिनेछन्,","poem":1},{"text":"पृथ्वीका जगहरू हल्‍लिन्छन्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"पृथ्वी टुक्रिएको छ,","poem":1},{"text":"पृथ्वी भाग-भाग भएको छ,","poem":2},{"lineBreak":true},{"text":"पृथ्वी जोडसित हल्‍लिएको छ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"पृथ्वी मतवालाझैँ धरमराउँछ,","poem":1},{"text":"झुप्रोलाई हावाले हल्‍लाएझैँ त्यो हल्‍लिन्छ;","poem":2},{"text":"त्यसको विद्रोहको दोष यति गह्रौँ छ कि","poem":1},{"text":"त्यो ढल्नेछ—कहिल्यै उठ्नेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"त्यस दिन याहवेहले","poem":1},{"text":"माथि आकाशका शक्तिहरूलाई","poem":2},{"lineBreak":true},{"text":"र तल पृथ्वीमा भएका राजाहरूलाई दण्ड दिनुहुनेछ।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तिनीहरू खाडलभित्र बाँधेर राखिएका कैदीहरूझैँ","poem":1},{"text":"एकसाथ थुपारिनेछन्;","poem":2},{"text":"तिनीहरू झ्यालखानामा बन्द गरिनेछन्,","poem":1},{"text":"र धेरै दिनपछि दण्ड भोग्नेछन्।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"चन्द्रमाले शर्म मान्‍नेछ,","poem":1},{"text":"र सूर्य लज्जित हुनेछ;","poem":2},{"text":"किनकि सेनाहरूका याहवेहले","poem":1},{"text":"सियोन पर्वतमा, यरूशलेममा,","poem":2},{"lineBreak":true},{"text":"र त्यसका प्रधानहरूको सामु महिमासित शासन गर्नुहुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}