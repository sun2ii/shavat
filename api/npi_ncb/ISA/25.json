{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["याहवेहलाई प्रशंसा"]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, तपाईं मेरा परमेश्‍वर हुनुहुन्छ;","poem":1},{"text":"म तपाईंलाई उच्‍च पार्नेछु र तपाईंको नामको प्रशंसा गर्नेछु;","poem":2},{"text":"किनकि पूर्ण विश्‍वासयोग्यतामा","poem":1},{"text":"तपाईंले अद्‌भुत कार्यहरू गर्नुभएको छ;","poem":2},{"lineBreak":true},{"text":"ती कामहरू धेरै अगि योजना गरिएका कुराहरू थिए।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तपाईंले सहरलाई ढुङ्गाको थुप्रोझैँ पारिदिनुभयो।","poem":1},{"text":"अनि सुरक्षित नगरलाई ध्वंस बनाइदिनुभएको छ।","poem":2},{"text":"परदेशीहरूका शक्तिशाली गढ अब सहर रहेन;","poem":1},{"text":"त्यो फेरि कहिल्यै बनाइनेछैन।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"यसकारण बलवान् मानिसहरूले तपाईंलाई आदर गर्नेछन्;","poem":1},{"text":"निष्‍ठुर जातिहरूका सहरहरूले तपाईंलाई सम्मान गर्नेछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तपाईं गरिबहरूका निम्ति,","poem":1},{"text":"कष्‍टमा परेकाहरूका निम्ति,","poem":2},{"text":"आँधीबतासमा शरण","poem":1},{"text":"र गर्मीबाट जोगाउने छाया हुनुभएको छ।","poem":2},{"text":"किनकि निष्‍ठुरहरूको सास","poem":1},{"text":"पर्खालमा ठोक्‍किने आँधी,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"र मरुभूमिको गर्मीझैँ हो।","poem":2},{"text":"तपाईंले परदेशीहरूको खैलाबैला बन्द गराउनुहुन्छ;","poem":1},{"text":"गर्मीलाई बादलको छायाले कम गरिदिएझैँ,","poem":2},{"lineBreak":true},{"text":"निष्‍ठुरहरूको गीत बन्द गराइन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"यस पर्वतमा सेनाहरूका याहवेहले","poem":1},{"text":"सबै मानिसहरूका निम्ति मिठा-मिठा थोकहरू,","poem":2},{"text":"छिप्पिएको मद्यको ठूलो भोज,","poem":1},{"text":"सर्वोत्तम मासु र सर्वोत्तम मद्य तयार पार्नुहुनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यस पर्वतमा उहाँले","poem":1},{"text":"सबै मानिसहरूलाई ढाक्ने वस्त्र,","poem":2},{"text":"र सबै जातिहरूलाई छोप्ने तन्‍ना नष्‍ट गर्नुहुनेछ;","poem":1}]},{"type":"verse","number":8,"content":[{"text":"उहाँले मृत्युलाई सधैँको निम्ति निलिदिनुहुनेछ।","poem":2},{"text":"प्रभु याहवेहले सबै अनुहारहरूबाट","poem":1},{"text":"आँसु पुछिदिनुहुनेछ;","poem":2},{"text":"उहाँले समस्त पृथ्वीबाट","poem":1},{"text":"आफ्ना मानिसहरूका अपमान हटाइदिनुहुनेछ।","poem":2},{"text":"याहवेह बोल्नुभएको छ।","poem":1}]},{"type":"verse","number":9,"content":["त्यस दिन तिनीहरूले यसो भन्‍नेछन्,",{"text":"“निश्‍चय उहाँ हाम्रा परमेश्‍वर हुनुहुन्छ;","poem":1},{"text":"हामीले उहाँमा भरोसा राख्यौँ, र उहाँले हामीलाई बचाउनुभयो।","poem":2},{"text":"उहाँ नै याहवेह हुनुहुन्छ, र हामीले उहाँमाथि भरोसा राख्यौँ;","poem":1},{"text":"हामी उहाँले दिनुभएको मुक्तिमा आनन्दित होऔँ र रमाऔँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"किनकि यस पर्वतमा याहवेहको हात रहनेछ;","poem":1},{"text":"तर मोआबचाहिँ मलमा पराल","poem":2},{"lineBreak":true},{"text":"कुल्चीमिल्ची पारिएझैँ तिनीहरूको देशमा कुल्चीमिल्ची पारिनेछ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"पौडी खेल्नेले पौडी खेल्दा आफ्ना हात पसारेझैँ,","poem":1},{"text":"तिनीहरूले त्यसमा आफ्ना हात पसार्नेछन्।","poem":2},{"text":"तिनीहरूले आफ्ना हातको चतुरता देखाए तापनि","poem":1},{"text":"परमेश्‍वरले तिनीहरूका घमण्ड चुर पार्नुहुनेछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"उहाँले तेरा अग्ला-अग्ला सुरक्षित पर्खालहरू ढालिदिनुहुनेछ,","poem":1},{"text":"र ती होच्याइनेछन्;","poem":2},{"text":"उहाँले ती भुइँमा खसाइदिनुहुनेछ,","poem":1},{"text":"र ती धुलोमै मिलाउनुहुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}