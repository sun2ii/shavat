{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["प्रशंसाको गीत"]},{"type":"verse","number":1,"content":["त्यस दिन यहूदा देशमा यो गीत गाइनेछ:",{"text":"हाम्रो एउटा बलियो सहर छ;","poem":1},{"text":"परमप्रभुले हाम्रो सुरक्षाको लागि त्यसको भित्री","poem":2},{"lineBreak":true},{"text":"र बाहिरी पर्खालहरू बनाउनुभएको छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मूलढोकाहरू खोल,","poem":1},{"text":"र धार्मिक जाति,","poem":2},{"lineBreak":true},{"text":"विश्‍वास राख्ने जाति भित्र पसोस्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जसको मन तपाईंमा अडिएको छ,","poem":1},{"text":"त्यसलाई तपाईंले पूरा शान्तिमा राख्नुहुन्छ;","poem":2},{"lineBreak":true},{"text":"किनकि त्यसले तपाईंमाथि भरोसा राख्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"सदासर्वदा याहवेहमा भरोसा राख;","poem":1},{"text":"किनकि याहवेह, याहवेह नै अनन्तका चट्टान हुनुहुन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उहाँले उच्‍चमा बस्‍नेहरूलाई नम्र तुल्याउनुहुन्छ,","poem":1},{"text":"उहाँले विशाल सहरलाई तल खसाल्नुहुन्छ;","poem":2},{"text":"उहाँले त्यसलाई जमिनमा मिलाइदिनुहुन्छ,","poem":1},{"text":"र धुलोमा फालिदिनुहुन्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"खुट्टाले त्यसलाई कुल्चिन्छ,","poem":1},{"text":"थिचोमिचोमा परेकाहरूका खुट्टाले","poem":2},{"lineBreak":true},{"text":"र गरिबका पाइलाले कुल्चीमिल्ची पार्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"धर्मी जनको मार्ग समतल हुन्छ;","poem":1},{"text":"हे धर्मी प्रभु, तपाईंले नै धर्मी जनको मार्ग समतल तुल्याउनुहुन्छ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हो, हे याहवेह, तपाईंका व्यवस्थाको मार्गमा हिँड्दै,","poem":1},{"text":"हामी तपाईंको प्रतीक्षा गर्छौँ;","poem":2},{"text":"तपाईंको नाम र ख्याति नै","poem":1},{"text":"हाम्रा हृदयका इच्छा हुन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"राति मेरो प्राणले तपाईंको चाहना गर्दछ;","poem":1},{"text":"बिहान मेरो आत्माले तपाईंको चाहना गर्छ।","poem":2},{"text":"तपाईंका न्याय पृथ्वीमा आउँदा,","poem":1},{"text":"संसारका मानिसहरूले धार्मिकता सिक्छन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"दुष्‍टहरूलाई अनुग्रह देखाइए तापनि","poem":1},{"text":"तिनीहरूले धार्मिकता सिक्दैनन्।","poem":2},{"text":"सोझाहरूको देशमा पनि तिनीहरू दुष्‍टता गरिनै रहन्छन्,","poem":1},{"text":"र याहवेहको महानताको कदर गर्दैनन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हे याहवेह, तपाईंको हात माथि उचालिएको छ,","poem":1},{"text":"तर तिनीहरूले त्यो देख्दैनन्।","poem":2},{"text":"तिनीहरूले तपाईंका मानिसहरूप्रति तपाईंको जोश देखून्, र शर्ममा परून्;","poem":1},{"text":"तपाईंका शत्रुहरूका निम्ति साँचिएको आगोले तिनीहरूलाई भस्म पारोस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"याहवेह, तपाईंले हाम्रा निम्ति शान्ति स्थापित गर्नुहुन्छ;","poem":1},{"text":"हामीले पाएका सबै उपलब्धीहरू, ती सबै तपाईंले हाम्रै निम्ति गर्नुभएको हो।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"हे याहवेह, हाम्रा परमेश्‍वर, तपाईंबाहेक अरू प्रभुहरूले हामीमाथि शासन गरे,","poem":1},{"text":"तर तपाईंको नामलाई मात्र हामी आदर गर्छौँ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तिनीहरू अब मरेर गएका छन्, तिनीहरू फेरि बाँच्नेछैनन्;","poem":1},{"text":"ती गइसकेका आत्माहरू उठ्दैनन्।","poem":2},{"text":"तपाईंले तिनीहरूलाई दण्ड दिनुभयो र तिनीहरूलाई सर्वनाश पार्नुभयो;","poem":1},{"text":"तपाईंले तिनीहरूको सबै सम्झना मेटिदिनुभयो।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"हे याहवेह, तपाईंले हाम्रो जातिलाई वृद्धि गर्नुभएको छ;","poem":1},{"text":"तपाईंले हाम्रो जातिलाई वृद्धि गर्नुभएको छ।","poem":2},{"text":"तपाईंले आफ्नै महिमा लिनुभएको छ;","poem":1},{"text":"तपाईंले देशका सबै सिमानाहरू फराकिलो पार्नुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"हे याहवेह, सङ्कष्‍टमा तिनीहरू तपाईंकहाँ आए;","poem":1},{"text":"तपाईंले तिनीहरूलाई ताडना दिनुहुँदा","poem":2},{"lineBreak":true},{"text":"तिनीहरूले मुस्किलले प्रार्थना","poem":2},{"noteId":20},{"text":"गर्न सके।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"बालक जन्माउन आँटेकी स्त्री","poem":1},{"text":"छटपटाउँदै कष्‍टमा कराएझैँ,","poem":2},{"lineBreak":true},{"text":"हामी पनि हे याहवेह, तपाईंको उपस्थितिमा त्यस्तै भएका थियौँ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"हामीले गर्भधारण गर्‍यौँ, हामी कष्‍टमा छटपटायौँ,","poem":1},{"text":"तर हामीले त बतास मात्र जन्मायौँ।","poem":2},{"text":"हामीले पृथ्वीमा मुक्ति ल्याएका छैनौँ,","poem":1},{"text":"न त हामीले संसारका मानिसहरूलाई नै जन्मायौँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"तर तपाईंका मरेकाहरू जिउनेछन्;","poem":1},{"text":"तिनीहरूका शरीरहरू उठ्नेछन्।","poem":2},{"text":"तिमीहरू धुलोमा बस्‍नेहरू, जाग","poem":1},{"text":"र आनन्दले कराऊ;","poem":2},{"text":"तपाईंका शीत बिहानका शीतझैँ छन्;","poem":1},{"text":"पृथ्वीले आफ्नो मृतकहरूलाई जन्म दिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"हे मेरा मानिस हो, जाओ, आफ्ना कोठाभित्र पस,","poem":1},{"text":"र पछिल्तिरबाट ढोका बन्द गर;","poem":2},{"text":"उहाँको क्रोध शान्त नहोउन्जेल","poem":1},{"text":"केही समयका निम्ति लुकिबस।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"हेर, पृथ्वीका मानिसहरूलाई तिनीहरूका पापका निम्ति दण्ड दिनलाई,","poem":1},{"text":"याहवेह आफ्ना वासस्थानबाट बाहिर निस्की आउनुहुँदैछ।","poem":2},{"text":"पृथ्वीले त्यसमाथि बगाएको रगत देखाइदिनेछ;","poem":1},{"text":"त्यसले अब आफ्ना मृतकहरूलाई अझै लुकाइराख्नेछैन।","poem":2}]}],"footnotes":[{"noteId":20,"caller":"+","text":"मूल भाषामा यस शब्दको अर्थ अनिश्‍चित छ।","reference":{"chapter":26,"verse":16}}]},"thisChapterLink":"/api/npi_ncb/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}