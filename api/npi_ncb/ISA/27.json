{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["इस्राएलको छुटकारा"]},{"type":"verse","number":1,"content":["त्यस दिन",{"text":"याहवेहले आफ्नो कठोर,","poem":1},{"text":"उहाँको डरलाग्दो, महान् र शक्तिशाली तरवारले","poem":2},{"text":"त्यस घस्रेर हिँड्ने सर्प लिव्यातनलाई","poem":1},{"text":"दण्ड दिनुहुनेछ;","poem":2},{"text":"त्यो समुद्रमा गुँडुलेर बस्‍ने लिव्यातनलाई मार्नुहुनेछ।","poem":1}]},{"type":"verse","number":2,"content":["त्यस दिन,",{"text":"“फलवन्त दाखबारीको विषयमा गीत गाओ:","poem":1}]},{"type":"verse","number":3,"content":[{"text":"म, याहवेहले त्यसको हेरचाह गर्छु;","poem":2},{"lineBreak":true},{"text":"म त्यसमा निरन्तर पानी हाल्छु।","poem":2},{"text":"त्यसलाई कसैले हानि नगरोस् भनेर","poem":1},{"text":"म त्यसलाई दिनरात पहरा दिन्छु।","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"म रिसाएको छैनँ।","poem":2},{"text":"यदि त्यहाँ सिउँडी र काँडाहरू मलाई रोक्न उम्रेका भए त!","poem":1},{"text":"म तिनीहरूका विरुद्ध लडाइँ गर्न जाइलाग्नेथिएँ;","poem":2},{"lineBreak":true},{"text":"म तिनीहरूलाई जलाउनेथिएँ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"त्यसैले तिनीहरू शरणका निम्ति मकहाँ आऊन्;","poem":1},{"text":"तिनीहरूले मसित मिलाप गरून्,","poem":2},{"lineBreak":true},{"text":"हो, तिनीहरूले मसित मिलाप गरून्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"आउँदा दिनहरूमा याकोबले जरा हाल्नेछ,","poem":1},{"text":"इस्राएल पलाउनेछ, र त्यो फुल्नेछ;","poem":2},{"lineBreak":true},{"text":"अनि सारा संसार त्यसको फलद्वारा भरिइनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"के त्यसलाई हिर्काउनेहरूलाई याहवेहले हिर्काउनुभएझैँ,","poem":1},{"text":"उहाँले त्यसलाई हिर्काउनुभएको छ?","poem":2},{"text":"के त्यसलाई मार्नेहरू मारिएझैँ,","poem":1},{"text":"त्यो मारिएको छ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"युद्ध र निर्वासनद्वारा तपाईं त्यससित युद्ध गर्नुहुन्छ,","poem":1},{"text":"पूर्वीय बतास चलेको दिनझैँ,","poem":2},{"lineBreak":true},{"text":"आफ्नो प्रचण्ड सासद्वारा उहाँले तिनीहरूलाई हटाइदिनुहुन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तब यसद्वारा याकोबको अपराधको प्रायश्‍चित हुनेछ;","poem":1},{"text":"अनि यसरी त्यसको पाप हटाएको सम्पूर्ण परिणाम यही हुनेछ:","poem":2},{"text":"जब उहाँले वेदीका ढुङ्गाहरूलाई","poem":1},{"text":"खरी ढुङ्गाझैँ धुलोपिठो पार्नुहुन्छ;","poem":2},{"text":"त्यहाँ कुनै अशेरा देवीको खम्बा","poem":1},{"text":"अथवा धूपको वेदी खडा हुनेछैन।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"सुरक्षित सहर निर्जन भयो,","poem":1},{"text":"निर्जन र त्यागिएका वासस्थान उजाड भूमिझैँ भयो;","poem":2},{"text":"त्यहाँ बाछाहरू चर्छन्,","poem":1},{"text":"त्यहाँ तिनीहरू विश्राम गर्छन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूले त्यसका हाँगाहरू लुछेर नाङ्गा पारिदिन्छन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यसका हाँगाहरू सुक्छन् र ती भाँचिन्छन्;","poem":1},{"text":"अनि स्त्रीहरूले आएर ती आगो सल्काउने काममा प्रयोग गर्छन्।","poem":2},{"text":"किनकि यो एउटा निर्बुद्धि जाति हो;","poem":1},{"text":"यसकारण तिनीहरूलाई बनाउनुहुनेको केही दया तिनीहरूप्रति छैन;","poem":2},{"lineBreak":true},{"text":"तिनीहरूका सृष्‍टिकर्ताले तिनीहरूमाथि निगाह राख्नुहुन्‍न।","poem":2}]},{"type":"verse","number":12,"content":["त्यस दिन याहवेहले बग्दै गरेको यूफ्रेटिसदेखि इजिप्टको नदीसम्म झाँट्नुहुनेछ; अनि हे इस्राएलीहरू हो, तिमीहरू एक-एक गरी भेला गरिनेछौ।"]},{"type":"verse","number":13,"content":["त्यस दिन ठूलो तुरही बज्नेछ। अश्शूरमा नष्‍ट हुनेहरू र इजिप्टमा निर्वासित भएकाहरू आएर यरूशलेममा पवित्र पर्वतमाथि याहवेहलाई आराधना गर्नेछन्।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}