{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["एफ्राइमलाई धिक्‍कार"]},{"type":"verse","number":1,"content":[{"text":"एफ्राइमका मतवालाहरूको घमण्डका शिरको मुकुटलाई,","poem":1},{"text":"र त्यसको महिमित शोभाको ओइलाउने फूललाई धिक्‍कार,","poem":2},{"text":"जो मलिलो उपत्यकाको सिरानमा राखिएको छ;","poem":1},{"text":"त्यो सहर, जसको घमण्डलाई दाखमद्यले होच्याइएको छ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हेर, प्रभुको एक जना शक्तिशाली र बलवान् जन छन्।","poem":1},{"text":"तिनले असिना र नाश गर्ने हुरीजस्तै,","poem":2},{"text":"मुसलधार वर्षाको उर्लंदो पानीको बाढीजस्तै,","poem":1},{"text":"त्यसलाई जबरजस्ती भुइँमा फाल्नेछन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"एफ्राइमका मतवालाहरूको घमण्डका शिरको मुकुट,","poem":1},{"text":"खुट्टामुनि कुल्चीमिल्ची पारिनेछ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यो ओइलाउँदै गरेको फूल,","poem":1},{"text":"मलिलो बेँसीको शिरमाथि लगाएको त्यसको महिमा,","poem":2},{"text":"कटनीको अगि नै पाकेको नेभाराझैँ हुनेछ;","poem":1},{"text":"मानिसहरूले यसलाई देख्नेबित्तिकै हातमा लिन्छन्,","poem":2},{"lineBreak":true},{"text":"र तिनीहरूले यसलाई निलिहाल्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"त्यस दिन सेनाहरूका याहवेह","poem":1},{"text":"एउटा महिमित मुकुट,","poem":2},{"text":"र आफ्ना बाँकी रहेका मानिसहरूका निम्ति","poem":1},{"text":"एउटा सुन्दर माला बन्‍नुहुनेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"न्याय गर्न बस्‍नेका निम्ति","poem":1},{"text":"उहाँ न्यायको आत्मा,","poem":2},{"text":"र लडाइँ मूलढोकातिर नै फर्काइदिनेहरूका निम्ति","poem":1},{"text":"उहाँ सामर्थका स्रोत हुनुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"तिनीहरू पनि मद्यले लरबरिन्छन्,","poem":1},{"text":"र मदिरा पिएर भड्किएका छन्:","poem":2},{"text":"पुजारी र अगमवक्ताहरू मताउने पेय पदार्थ पिएर धरमरिन्छन्,","poem":1},{"text":"र मद्यले उन्मत्त हुन्छन्;","poem":2},{"text":"तिनीहरू मद्यले धरमराएका छन्,","poem":1},{"text":"दर्शन देख्दा तिनीहरू धरमरिएका छन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरू निर्णय दिँदा भड्किन्छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"सबै टेबुलहरू बान्ताले भरिएका छन्;","poem":1},{"text":"अनि फोहोर नभएको ठाउँ एउटै पनि छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“त्यसले कसलाई सिकाउन चाहेको छ?","poem":1},{"text":"आफ्नो सन्देश कसलाई बयान गरिरहेको छ?","poem":2},{"text":"भर्खर दूध छोडेका बच्‍चाहरू,","poem":1},{"text":"भर्खर स्तनबाट अलग गरिएकाहरूलाई?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"किनकि त्यो यस्तो हो:","poem":1},{"text":"यो गर, त्यो गर;","poem":2},{"lineBreak":true},{"text":"यसमाथि नियम, त्यसमाथि नियम,","poem":2},{"lineBreak":true},{"text":"अलिकति यहाँ, अलिकति त्यहाँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"त्यसो हो भने परमेश्‍वरले यस जातिसित","poem":1},{"text":"परदेशीका ओठ र अनौठो भाषाद्वारा बोल्नुहुनेछ;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जसलाई उहाँले भन्‍नुभयो,","poem":1},{"text":"“विश्रामस्थल यही हो; थाकेकाहरूले यहीँ नै विश्राम गरून्;”","poem":2},{"text":"अनि “थकाइ मार्ने स्थान यही हो,”","poem":1},{"text":"तर तिनीहरूले सुन्‍न इन्कार गरे।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"यसकारण याहवेहको वचन तिनीहरूलाई यस्तो हुनेछ:","poem":1},{"text":"यो गर, त्यो गर,","poem":2},{"lineBreak":true},{"text":"यसमाथि नियम, त्यसमाथि नियम,","poem":2},{"lineBreak":true},{"text":"अलिकति यहाँ, अलिकति त्यहाँ,","poem":2},{"text":"यसरी तिनीहरू अगि बढ्दा पछिल्तिर लोटून्;","poem":1},{"text":"घाइते होऊन् र पासोमा परेर पक्राउ परून्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"यसकारण हे गिल्‍ला गर्नेहरू हो, याहवेहको वचन सुन,","poem":1},{"text":"जसले यी मानिसहरूमाथि यरूशलेममा शासन गर्छौ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तिमीहरू घमण्ड गर्छौ, “हामीले मृत्युसित करार बाँधेका छौँ;","poem":1},{"text":"चिहानसित हामीले सम्झौता गरेका छौँ।","poem":2},{"text":"कुनै भयानक विपत्ति छेउमा आइपर्दा,","poem":1},{"text":"त्यसले हामीलाई छुन सक्दैन;","poem":2},{"text":"किनकि हामीले झूटलाई आफ्नो शरणस्थान","poem":1},{"text":"र असत्यलाई","poem":2},{"noteId":21},{"text":"आफ्नो लुक्ने स्थान बनाएका छौँ।”","poem":2}]},{"type":"verse","number":16,"content":["यसकारण प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“हेर, मैले सियोनमा एउटा ढुङ्गा बसालेको छु, एउटा जाँचिएको ढुङ्गा,","poem":1},{"text":"एउटा दृढ जगको बहुमूल्य कुनेढुङ्गा,","poem":2},{"text":"त्यसमा भरोसा गर्ने","poem":1},{"text":"कहिल्यै निराश हुनेछैन।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"म न्यायलाई नाप्‍ने डोरी,","poem":1},{"text":"र धार्मिकतालाई साहुल बनाउनेछु;","poem":2},{"text":"तिमीहरूको झूटको शरणस्थान असिनाले सोहोरेर लानेछ;","poem":1},{"text":"अनि पानीले तिमीहरूको लुक्ने ठाउँलाई बगाइदिनेछ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"मृत्युसितको तिमीहरूको करार नष्‍ट पारिनेछ;","poem":1},{"text":"चिहानसितको तिमीहरूको सम्झौता स्थिर रहनेछैन।","poem":2},{"text":"जब विपत्तिको बाढी यताबाट जानेछ,","poem":1},{"text":"त्यसले तिमीहरूलाई डुबाउनेछ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"जतिपल्ट त्यो आउँछ, त्यसले तिमीहरूलाई बगाएर लैजानेछ;","poem":1},{"text":"हरेक बिहान, दिन र रातमा","poem":2},{"lineBreak":true},{"text":"त्यो बगिरहनेछ।”","poem":2},{"lineBreak":true},{"text":"यस सन्देशको बुझाइले","poem":1},{"text":"आतङ्क मात्र ल्याउनेछ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"लम्पसार पर्नलाई पलङ साह्रै छोटो छ,","poem":1},{"text":"र तिमीहरूलाई ढाक्न कम्बल साह्रै सानो छ।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"पराजीम पर्वतमा उठ्नुभएझैँ याहवेह उठ्नुहुनेछ,","poem":1},{"text":"गिबोनको बेँसीमा उहाँ जाग्नुभएझैँ जाग्नुहुनेछ—","poem":2},{"text":"आफ्नो काम, आफ्नो अनौठो काम गर्न र आफ्नो कार्य,","poem":1},{"text":"आफ्नो अद्‌भुत कार्य पूरा गर्न।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"अब तिमीहरूको ठट्टा रोक,","poem":1},{"text":"नत्रता तिमीहरूका साङ्लाहरू अझ गह्रौँ हुनेछन्;","poem":2},{"text":"प्रभु, सेनाहरूका याहवेहले","poem":1},{"text":"मलाई सारा देशको विरुद्ध उर्दी जारी गर्नुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ध्यान दिएर सुन, र मेरो सोर सुन;","poem":1},{"text":"ध्यान देऊ, र म के भन्छु, सो सुन।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"जब किसानले केही रोप्न जमिन जोत्छ, के उसले निरन्तर जोतिरहन्छ?","poem":1},{"text":"के त्यसले निरन्तर माटो खनेर डल्‍लाहरू फुटाउँदै रहन्छ?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"उसले माटो सम्म पारेपछि","poem":1},{"text":"के उसले सुँप र जीरा छर्दैन र?","poem":2},{"text":"के उसले त्यसकै ठाउँमा गहुँ,","poem":1},{"text":"जौ त्यसकै ठाउँमा","poem":2},{"lineBreak":true},{"text":"र कठियालाई त्यसकै ठाउँमा छर्दैन र?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"उसका परमेश्‍वरले उसलाई अह्राउनुहुन्छ;","poem":1},{"text":"अनि उसलाई ठिक तरिका सिकाउनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"किनकि कुनै तीखो हतियारले सुँप झाँटिदैन,","poem":1},{"text":"न त जीरालाई गाडाको चक्‍काले दाइँ गरिन्छ;","poem":2},{"text":"तर लहुरोले सुँप चुटिन्छ,","poem":1},{"text":"र जीराचाहिँ लठ्ठीले चुटिन्छ।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"रोटी बनाउने अन्‍न पिसिनुपर्छ;","poem":1},{"text":"यसकारण कसैले त्यसलाई सधैँ झाँटिरहँदैन।","poem":2},{"text":"न त उसले त्यसमाथि गाडाको चक्‍का गुडाएर","poem":1},{"text":"उसका घोडाहरूले त्यसलाई पिँध्छ।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"यी सबै सेनाहरूका याहवेहबाट नै आउँदछ,","poem":1},{"text":"जसको योजना अचम्मका","poem":2},{"lineBreak":true},{"text":"र बुद्धि महान् छ।","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"अथवा झूटो ईश्‍वर","reference":{"chapter":28,"verse":15}}]},"thisChapterLink":"/api/npi_ncb/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}