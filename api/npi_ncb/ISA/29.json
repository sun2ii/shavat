{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["दावीदको सहरलाई धिक्‍कार"]},{"type":"verse","number":1,"content":[{"text":"हाय अरीएल, अरीएल तँलाई धिक्‍कार!","poem":1},{"text":"त्यो सहर, जहाँ दावीदले बसोबास गर्थे।","poem":2},{"text":"वर्षमाथि वर्ष थप्दै जा।","poem":1},{"text":"र तेरा चाडहरूको चक्र चलिरहोस्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तापनि म अरीएललाई घेर्नेछु;","poem":1},{"text":"उसले बिलौना र विलाप गर्नेछ,","poem":2},{"lineBreak":true},{"text":"र ऊ मेरा निम्ति वेदीको चुल्होझैँ हुनेछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"म तेरो विरुद्ध चारैतिर छाउनी हाल्नेछु;","poem":1},{"text":"म तँलाई धरहराहरूले चारैतिरबाट घेर्नेछु,","poem":2},{"lineBreak":true},{"text":"र तेरो विरुद्धको घेरालाई स्थापित गर्नेछु।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तँ होच्याइनेछेस्, र भुइँबाट बोल्नेछेस्;","poem":1},{"text":"धुलोबाट तेरो बोली अस्पष्‍ट सुनिनेछ।","poem":2},{"text":"तेरो सोर प्रेतको जस्तो पृथ्वीबाट आउनेछ;","poem":1},{"text":"धुलोबाट तेरो कानेखुसी सुनिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तर तेरा धेरै शत्रुहरू धुलोझैँ हुनेछन्,","poem":1},{"text":"र निर्दयी दलहरू उडाइएको भुसझैँ हुनेछन्।","poem":2},{"text":"अचानक एकै क्षणमा,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"सेनाहरूका याहवेह मेघ गर्जन,","poem":2},{"text":"भुइँचालो र ठूलो आवाजसित, भुमरी,","poem":1},{"text":"आँधीबेहरी र भस्म गर्ने आगोको ज्वालासित आउनुहुनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तब अरीएलको विरुद्धमा लडाइँ गर्ने,","poem":1},{"text":"र त्यसका किल्‍लामाथि आक्रमण गरेर त्यसलाई घेरा हाल्ने,","poem":2},{"text":"सबै राष्ट्रहरूका दलहरू सपनाझैँ,","poem":1},{"text":"र रातको दर्शनझैँ हुनेछन्;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जसरी भोकाएको मानिसले सपनामा खाएको देख्छ,","poem":1},{"text":"तर बिउँझँदा त्यो भोकै हुन्छ;","poem":2},{"text":"अथवा जसरी तिर्खाएको मानिसले सपनामा पानी पिएको देख्छ,","poem":1},{"text":"तर त्यो बिउँझँदा आफू तिर्खाएको र दुर्बल रहेको हुन्छ।","poem":2},{"text":"सियोन पर्वतको विरुद्ध लडाइँ गर्ने","poem":1},{"text":"सबै राष्ट्रहरूका दलहरू पनि त्यस्तै हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"व्याकुल होओ, चकित होओ,","poem":1},{"text":"आफूलाई अन्धा बनाओ र दृष्‍टिविहीन होओ;","poem":2},{"text":"मतवाला होओ, तर मद्यले भने होइन,","poem":1},{"text":"धरमराओ, तर मताउने पेयले होइन।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"याहवेहले तिमीहरूमाथि एउटा गहिरो निद्रा ल्याउनुभएको छ:","poem":1},{"text":"उहाँले अगमवक्ताहरूका आँखा बन्द गरिदिनुभएको छ;","poem":2},{"lineBreak":true},{"text":"उहाँले दर्शीहरूका शिरहरू छोपिदिनुभएको छ।","poem":2}]},{"type":"verse","number":11,"content":["तिमीहरूका निम्ति यो सम्पूर्ण दर्शन अरू केही होइन, तर चर्मपत्रमा छाप लगाएर राखिएका शब्दहरू मात्र हुन्। अनि यदि तिमीहरूले लेखपढ गर्न सक्ने कसैलाई यो चर्मपत्र दिएर, “दया गरी यसलाई पढिदिनुहोस्” भन्यौ भने, त्यसले, “म सक्दिनँ, यसमा छाप लगाइएको छ” भनेर जवाफ दिनेछ।"]},{"type":"verse","number":12,"content":["अथवा तिमीहरूले लेखपढ गर्न नजान्‍ने कसैलाई यो चर्मपत्र दिएर, “दया गरी यसलाई पढिदिनुहोस्” भन्यौ भने त्यसले “म पढ्नै जान्दिनँ” भनेर जवाफ दिनेछ।"]},{"type":"line_break"},{"type":"verse","number":13,"content":["प्रभु भन्‍नुहुन्छ:",{"text":"“यी मानिसहरू मकहाँ आफ्ना मुख देखाउन आउँछन्;","poem":1},{"text":"अनि मलाई तिनीहरूका ओठहरूले आदर गर्छन्,","poem":2},{"lineBreak":true},{"text":"तर तिनीहरूका हृदय मदेखि टाढा छन्।","poem":2},{"text":"मप्रति तिनीहरूका आराधना","poem":1},{"text":"मानवीय नियम मात्र हुन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"यसकारण म फेरि एकपल्ट यी मानिसहरूलाई","poem":1},{"text":"अद्‌भुत कार्यमाथि अद्‌भुत कार्यले छक्‍क पार्नेछु;","poem":2},{"text":"बुद्धिमानीहरूका बुद्धि नष्‍ट हुनेछ,","poem":1},{"text":"र ज्ञानीहरूका ज्ञान लोप भएर जानेछ।”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तिनीहरूलाई धिक्‍कार! जो आफ्ना योजनाहरू","poem":1},{"text":"याहवेहदेखि लुकाउनलाई गहिराइको खोज गर्छन्,","poem":2},{"text":"जसले आफ्ना काम अन्धकारमा गरेर सोच्छन्,","poem":1},{"text":"“हामीलाई कसले देख्छ? कसले थाहा पाउँछ?”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"कुमालेलाई माटो सरह ठानेर","poem":1},{"text":"तिमीहरू कुराहरू उल्टापुल्टा पार्छौ!","poem":2},{"text":"के बनिएको चीजले आफूलाई बनाउनेलाई","poem":1},{"text":"“उसले मलाई बनाएको होइन” भन्छ?","poem":2},{"text":"के भाँडाले कुमालेलाई,","poem":1},{"text":"“त्यसले केही जान्दैन” भन्‍न सक्छ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"केही समयमै के लेबनान एउटा मलिलो खेतमा परिणत हुनेछैन र?","poem":1},{"text":"अनि मलिलो खेतचाहिँ एउटा जङ्गलमा बदलिँदैन र?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"त्यस दिन बहिराहरूले चर्मपत्रका वचनहरू सुन्‍नेछन्;","poem":1},{"text":"अनि धमिलोपन र अन्धाकारबाट","poem":2},{"lineBreak":true},{"text":"अन्धाहरूका आँखाले देख्नेछन्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"फेरि एकपल्ट नम्रहरू याहवेहमा रमाउनेछन्;","poem":1},{"text":"खाँचोमा परेकाहरू इस्राएलका पवित्र परमेश्‍वरमा आफ्नो आनन्द मनाउनेछन्।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"निर्दयीहरू लोप हुनेछन्,","poem":1},{"text":"ठट्टा गर्नेहरू हराएर जानेछन्;","poem":2},{"lineBreak":true},{"text":"अनि दुष्‍टतामा ध्यान दिनेहरू सबै काटिएर ढालिनेछन्;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तिनीहरू, जसले मानिसलाई बोलीद्वारा दोषी ठहराउँछन्,","poem":1},{"text":"जसले अदालतमा प्रतिवादीलाई पासो थाप्छन्;","poem":2},{"lineBreak":true},{"text":"अनि झूटो गवाहीद्वारा निर्दोषहरूका न्याय खोस्छन्।","poem":2}]},{"type":"verse","number":22,"content":["यसकारण अब्राहामलाई उद्धार गर्नुहुने याहवेह, याकोबको घरानालाई यसो भन्‍नुहुन्छ:",{"text":"“अब उसो याकोब शर्ममा पर्नेछैन;","poem":1},{"text":"अब उसो तिनीहरूका अनुहार पहेँलो हुनेछैन।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तिनीहरूले आफ्ना बीचमा आफ्नै छोराछोरीहरू,","poem":1},{"text":"मेरा हातको कामलाई देख्नेछन्;","poem":2},{"text":"तिनीहरूले मेरो नामलाई पवित्र राख्नेछन्;","poem":1},{"text":"तिनीहरूले याकोबका पवित्र परमेश्‍वरको पवित्रता स्वीकार गर्नेछन्;","poem":2},{"lineBreak":true},{"text":"अनि इस्राएलका परमेश्‍वरको डर श्रद्धासाथ राख्नेछन्।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"आत्मामा पथभ्रष्‍ट भएकाहरूले समझ पाउनेछन्;","poem":1},{"text":"गनगनेहरूले सल्‍लाह ग्रहण गर्नेछन्।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}