{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["यरूशलेम र यहूदामाथि न्याय"]},{"type":"verse","number":1,"content":[{"text":"अब हेर, प्रभु","poem":1},{"text":"सेनाहरूका याहवेहले","poem":2},{"text":"यरूशलेम र यहूदाबाट","poem":1},{"text":"सर-सामान र सहारा दुवै लैजान लाग्नुभएको छ:","poem":2},{"text":"सबै भोजनका सरसामानहरू र पानीका मुहानहरू,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"वीर र योद्धा,","poem":2},{"text":"न्यायकर्ता र अगमवक्ता,","poem":1},{"text":"जोखना हेर्ने र वृद्ध मानिसहरू,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"पचास माथिका सेनापति र उच्‍च पदाधिकारी,","poem":1},{"text":"सल्‍लाहकार, सिपालु कारिगर र चतुर जादुगर।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“म ठिटाहरूलाई तिनीहरूका शासक बनाउनेछु;","poem":1},{"text":"बालबालिकाहरूले तिनीहरूमाथि शासन गर्नेछन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मानिसहरूले एक-अर्कालाई अत्याचार गर्नेछन्;","poem":1},{"text":"मानिसको विरुद्धमा मानिस, छिमेकीको विरुद्धमा छिमेकी उठ्नेछ।","poem":2},{"text":"वृद्धको विरुद्धमा जवान,","poem":1},{"text":"र सम्मानितको विरुद्धमा तुच्छ खडा हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"एउटा मानिसले आफ्ना दाजुभाइहरूमध्ये","poem":1},{"text":"एक जनालाई आफ्ना बुबाको घरमा समातेर भन्‍नेछ,","poem":2},{"text":"“तिमीसित राम्रो पहिरन छ, तिमी नै हाम्रो अगुवा बन,","poem":1},{"text":"र यस भग्नावशेषको जिम्मा लेऊ!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तर त्यस दिन त्यसले कराएर भन्‍नेछ,","poem":1},{"text":"“म उपचार गर्ने मानिस होइन।","poem":2},{"text":"मेरो घरमा भोजन र वस्त्र केही पनि छैन;","poem":1},{"text":"मलाई मनिसहरूका अगुवा नबनाओ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"यरूशलेम धरमरिँदैछ,","poem":1},{"text":"यहूदा लड्दैछ;","poem":2},{"text":"तिनीहरूका वचन र कामहरू याहवेहको विरुद्ध छन्;","poem":1},{"text":"तिनीहरू उहाँको महिमित उपस्थितिको बेवास्ता गर्छन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरूका अनुहारले तिनीहरूकै विरुद्धमा साक्षी दिन्छ;","poem":1},{"text":"तिनीहरूले सदोमले झैँ आफ्ना पापको प्रदर्शन गरेका छन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूले ती लुकाउँदैनन्।","poem":2},{"text":"तिनीहरूलाई धिक्‍कार!","poem":1},{"text":"तिनीहरू आफैँले आफूमाथि विपत्ति ल्याएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"धर्मीहरूलाई भन, तिनीहरूलाई राम्रै हुनेछ;","poem":1},{"text":"किनकि तिनीहरूले आफ्ना कामहरूको फल उपभोग गर्नेछन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"दुष्‍टहरूलाई धिक्‍कार!","poem":1},{"text":"तिनीहरूमाथि विपत्ति आउनेछ।","poem":2},{"text":"तिनीहरूले आफ्ना हातहरूले","poem":1},{"text":"गरेअनुसार नै भोग्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"जवानहरूले मेरा मानिसहरूमाथि थिचोमिचो गरेका छन्;","poem":1},{"text":"स्त्रीहरूले तिनीहरूमाथि शासन गर्छन्।","poem":2},{"text":"हे मेरा मानिसहरू, तिमीहरूका पथ-प्रदर्शकहरूले नै तिमीहरूलाई बरालिदिएका छन्;","poem":1},{"text":"तिनीहरूले तिमीहरूलाई बाटोबाट फर्काउँछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"याहवेहले न्यायालयमा आफ्नो आसन ग्रहण गर्नुहुन्छ;","poem":1},{"text":"उहाँ मानिसहरूको न्याय गर्न खडा हुनुहुन्छ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"याहवेहले आफ्ना मानिसहरूका","poem":1},{"text":"प्रधानहरू र अगुवाहरूको विरुद्ध न्याय गर्नुहुन्छ:","poem":2},{"text":"“मेरो दाखबारी नष्‍ट पार्ने तिमीहरू नै हौ;","poem":1},{"text":"गरिबहरूबाट लिइएका लुटको माल तिमीहरूका घरहरूमा छ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"मेरा मानिसहरूलाई धुलोपिठो बनाएको","poem":1},{"text":"अनि गरिबहरूका अनुहारहरू पिँधेको तिमीहरूले के अर्थ लाउँछौ?”","poem":2},{"lineBreak":true},{"text":"प्रभु, सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"याहवेह भन्‍नुहुन्छ,","poem":1},{"text":"“सियोनका स्त्रीहरू अभिमानी छन्,","poem":2},{"text":"तिनीहरू गर्दन ठड्याउँदै","poem":1},{"text":"र विलासी आँखाहरू तर्काउँदै,","poem":2},{"text":"नक्‍कल पार्दै कल्‍ली लगाएर","poem":1},{"text":"छमछम गर्दै हिँड्छन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"यसकारण प्रभु याहवेहले सियोनका स्त्रीहरूका शिरमा घाउहरू ल्याउनुहुनेछ,","poem":1},{"text":"र तिनीहरूका तालु केशविहीन बनाइदिनुहुनेछ।”","poem":2}]},{"type":"verse","number":18,"content":["त्यस दिन प्रभुले तिनीहरूका सिङ्गारका चीजहरू जस्तै: चुराहरू र शिरबन्दीहरू, चन्द्रहारहरू,"]},{"type":"verse","number":19,"content":["झुम्काहरू र बालाहरू र घुम्टाहरू,"]},{"type":"verse","number":20,"content":["शिरका सिङ्गारहरू, कल्‍ली, पटुकाहरू, अत्तरदानीहरू, जन्तरहरू,"]},{"type":"verse","number":21,"content":["छाप-औँठीहरू र नत्थहरू,"]},{"type":"verse","number":22,"content":["मसिनो वस्त्रहरू, अलखा र ओढ्नेहरू, थैलीहरू,"]},{"type":"verse","number":23,"content":["अनि ऐनाहरू, मलमलका वस्त्रहरू, मुकुटहरू र दोसल्‍लाहरू खोसेर लैजानुहुनेछ।"]},{"type":"verse","number":24,"content":[{"text":"सुगन्धको सट्टामा दुर्गन्ध हुनेछ;","poem":1},{"text":"पटुकाको साटो डोरी;","poem":2},{"text":"राम्ररी कोरिएको केशको साटो मुडुलो टाउको हुनेछ;","poem":1},{"text":"मसिनो वस्त्रको साटो भाङ्ग्रा;","poem":2},{"lineBreak":true},{"text":"सुन्दरताको साटो डामै-डाम हुनेछ।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तेरा मानिसहरू तरवारद्वारा मारिनेछन्;","poem":1},{"text":"तेरा योद्धाहरू लडाइँमा मारिनेछन्।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"सियोनका मूलढोकाहरूले बिलौना र शोक गर्नेछन्;","poem":1},{"text":"आश्रयविहीन भई तिनी भुइँमा बस्‍नेछिन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}