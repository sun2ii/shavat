{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":30,"content":[{"type":"heading","content":["अटेरी जातिलाई धिक्‍कार"]},{"type":"verse","number":1,"content":[{"text":"“धिक्‍कार! ती हठी सन्तानलाई,”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ,","poem":2},{"text":"“जसले योजनाहरू चलाउँछन्, जुन मेरा होइनन्;","poem":1},{"text":"जसले मित्रता गाँस्छन्, तर मेरो आत्माद्वारा होइन;","poem":2},{"lineBreak":true},{"text":"पापमाथि पाप थुपार्छन्;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मसित सल्‍लाह नलिएर,","poem":1},{"text":"जो इजिप्टमा जान्छन्;","poem":2},{"text":"जसले फारोदेखि सुरक्षाको आशा गर्छन्;","poem":1},{"text":"शरणका निम्ति इजिप्टको छहारी खोज्छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तर फारोको सुरक्षा तिमीहरूका निम्ति लज्जास्पद हुनेछ;","poem":1},{"text":"इजिप्टको छहारीले तिमीहरूमा अपमान ल्याउनेछ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरूसित सोअनमा अधिकृतहरू भए तापनि","poem":1},{"text":"र तिनीहरूका दूतहरू हानेसमा आइपुगे तापनि","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिनीहरूका निम्ति काम नलाग्ने जातिहरूको कारण,","poem":1},{"text":"जसले, न त सहायता ल्याउँछन्, न त लाभ नै दिन्छन्;","poem":2},{"text":"तर खाली शर्म र अपमान मात्र ल्याउँछन्;","poem":1},{"text":"तिनीहरूको कारण हरेक शर्ममा पर्नेछन्।”","poem":2}]},{"type":"verse","number":6,"content":["दक्षिणी भागका जन्तुहरूको विरुद्ध भविष्यवाणी:",{"text":"दुःख र वेदनाको देशबाट भएर,","poem":1},{"text":"जहाँबाट सिंह र सिंहनी, विषालु सर्प र उड्ने सर्पहरू निस्कन्छन्;","poem":2},{"lineBreak":true},{"text":"राजदूतहरूले आफ्ना धनसम्पत्ति","poem":2},{"text":"गधाहरूका पिठिउँमा र आफ्ना बहुमूल्य भण्डारहरू","poem":1},{"text":"ऊँटहरूका जुरोमा लदाएर त्यस जातिकहाँ लैजान्छन्,","poem":2},{"text":"जसले तिनीहरूलाई केही लाभ दिँदैनन्।","poem":1}]},{"type":"verse","number":7,"content":[{"text":"किनभने इजिप्टमा जसको सहायता एकदमै व्यर्थको छ,","poem":2},{"text":"यसकारण मैले त्यसलाई","poem":1},{"text":"केही नगर्ने राहाब","poem":2},{"noteId":22},{"text":"भनेको छु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"अब जा, आउँदा दिनहरूका निम्ति","poem":1},{"text":"यो सधैँ साक्षी होस् भनेर,","poem":2},{"text":"तिनीहरूको सामु यो एउटा पाटीमा लेख;","poem":1},{"text":"यसलाई एउटा किताबमा लेखिराख।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यिनीहरू बागी मानिसहरू हुन्, छली सन्तान,","poem":1},{"text":"याहवेहको आज्ञा नसुन्‍ने सन्तान हुन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"यिनीहरू दर्शीहरूलाई भन्छन्,","poem":1},{"text":"“अब उसो दर्शन नदेख!”","poem":2},{"text":"अनि अगमवक्ताहरूलाई भन्छन्,","poem":1},{"text":"“अबदेखि ठिक कुराहरूको दर्शन हामीलाई नदेओ!","poem":2},{"text":"हामीलाई चाखलाग्दा कुराहरू भनिदेओ,","poem":1},{"text":"छलका अगमवाणी भनिदेओ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"यस मार्गलाई त्यागिदेओ,","poem":1},{"text":"यस मार्गबाट हटिदेओ;","poem":2},{"text":"अनि हामीलाई इस्राएलका पवित्र परमेश्‍वरसित","poem":1},{"text":"आमने-सामने गराउन छोडिदेओ!”","poem":2}]},{"type":"verse","number":12,"content":["यसकारण इस्राएलका पवित्र परमेश्‍वर भन्‍नुहुन्छ:",{"text":"“तिमीहरूले यस समाचारलाई इन्कार गरेका हुनाले,","poem":1},{"text":"र अत्याचारमा भरोसा गरेका हुनाले,","poem":2},{"lineBreak":true},{"text":"र छलमा भर परेका हुनाले,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"यो पाप तिमीहरूका निम्ति","poem":1},{"text":"अग्लो पर्खाल चर्किएर ढल्न लागेजस्तै हुनेछ,","poem":2},{"lineBreak":true},{"text":"जुन अचानक एकै क्षणमा भत्किएर जानेछ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"यो माटाका भाँडाझैँ टुक्रा-टुक्रा भएर","poem":1},{"text":"जताततै छरपस्ट हुनेछ,","poem":2},{"text":"जसले गर्दा चुलोबाट कोइला झिक्नलाई,","poem":1},{"text":"अथवा इनारबाट पानी उघाउनलाई","poem":2},{"lineBreak":true},{"text":"एउटा सानो टुक्राधरि पाइनेछैन।”","poem":2}]},{"type":"verse","number":15,"content":["प्रभु याहवेह, इस्राएलका पवित्र परमेश्‍वर यही भन्‍नुहुन्छ:",{"text":"“पश्‍चात्ताप र विश्राममा तिमीहरूको मुक्ति छ।","poem":1},{"text":"मौनता र भरोसामा तिमीहरूको सामर्थ्य छ,","poem":2},{"lineBreak":true},{"text":"तर तिमीहरूले यी कुनै पनि कुरा चाहँदैनौ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तिमीहरूले भन्यौ, ‘होइन, हामी घोडामा चढेर भाग्नेछौँ।’","poem":1},{"text":"यसकारण तिमीहरू भाग्नेछौ!","poem":2},{"text":"तिमीहरूले भन्यौ, ‘हामी चाँडो दगुर्ने घोडामा सवार हुनेछौँ।’","poem":1},{"text":"यसकारण तिमीहरूलाई खेद्नेहरू फूर्तिला हुनेछन्!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"एक जनाले धम्काउँदा","poem":1},{"text":"एक हजार भाग्नेछन्;","poem":2},{"text":"पाँच जनाले धम्काउँदा","poem":1},{"text":"तिमीहरू सबै भागेर जानेछौ;","poem":2},{"text":"जबसम्म तिमीहरू पर्वतको टाकुरामा","poem":1},{"text":"रहेको झण्डाको डण्डाजस्तै,","poem":2},{"lineBreak":true},{"text":"डाँडामा भएको एउटा झण्डाझैँ रहँदैनौ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"तरै पनि याहवेह तिमीहरूप्रति अनुग्रहकारी हुने इच्छा राख्नुहुन्छ;","poem":1},{"text":"उहाँ तिमीहरूलाई दया देखाउन खडा हुनुहुनेछ।","poem":2},{"text":"किनकि याहवेह न्यायको परमेश्‍वर हुनुहुन्छ।","poem":1},{"text":"उहाँको बाटो हेर्नेहरू सबै धन्यका हुन्!","poem":2}]},{"type":"verse","number":19,"content":["हे यरूशलेममा बस्‍ने सियोनका मानिसहरू हो, तिमीहरू फेरि रुनेछैनौ। तिमीहरू सहायताको लागि रुँदा उहाँ अति अनुग्रहकारी हुनुहुनेछ! उहाँले सुन्‍नेबित्तिकै तिमीहरूलाई जवाफ दिनुहुनेछ।"]},{"type":"verse","number":20,"content":["प्रभुले तिमीहरूलाई विपत्तिको रोटी र कष्‍टको पानी दिनुभए तापनि तिमीहरूका शिक्षकहरू फेरि लुकाइनेछैनन्; तिमीहरूका आफ्नै आँखाले तिनीहरूलाई देख्नेछौ।"]},{"type":"verse","number":21,"content":["तिमीहरू दाहिने अथवा देब्रेतिर फर्के तापनि तिमीहरूका कानले आफ्ना पछिल्तिरबाट, “बाटो यही हो, यसमा हिँड” भन्‍ने सोर सुन्‍नेछन्।"]},{"type":"verse","number":22,"content":["तब आफूले चाँदीले मोहोरेका मूर्तिहरू र सुनले ढालेका प्रतिमाहरूलाई तिमीहरूले अपवित्र तुल्याउनेछौ। तिमीहरूले त्यसलाई रजस्वलाको लुगाझैँ फ्याँकेर त्यसलाई, “पर जा!” भन्‍नेछौ।"]},{"type":"line_break"},{"type":"verse","number":23,"content":["तिमीहरूले जमिनमा छरेका बिउ उमार्नका निम्ति उहाँले वर्षा पनि पठाइदिनुहुनेछ; अनि जमिनबाट आएको भोजन उत्तम र प्रशस्त हुनेछ। त्यस दिन तिमीहरूका गाईबस्तु ठूला मैदानहरूमा चर्नेछन्।"]},{"type":"verse","number":24,"content":["खेतमा जोत्ने गोरुहरू र गधाहरूले काँटा र बेल्चाले मिसाएको घाँस र दाना खानेछन्।"]},{"type":"verse","number":25,"content":["त्यस भयानक संहारको दिनमा धरहराहरू ढल्दा प्रत्येक अग्लो पर्वत र हरेक ठूलो डाँडामा पानीका खोलाहरू बग्नेछन्।"]},{"type":"verse","number":26,"content":["याहवेहले आफ्ना मानिसहरूका घाउहरूमा पट्टी बाँध्नुहुँदा र उहाँले दिनुभएका चोटहरू निको पार्नुहुँदा, त्यस दिन चन्द्रमा सूर्यजस्तै लाग्नेछ; अनि सूर्य सधैँभन्दा सात गुणा बढी चम्किलो, सात दिनको उज्यालो एकै दिनमा चम्केजस्तो हुनेछ।"]},{"type":"verse","number":27,"content":[{"text":"हेर, याहवेहको नाम टाढाबाट","poem":1},{"text":"बल्दो रिस र धुवाँको बाक्लो बादलसित आउँछ;","poem":2},{"text":"उहाँका ओठहरू क्रोधले पूर्ण छन्;","poem":1},{"text":"उहाँको जिब्रो भस्म पार्ने आगोजस्तो छ।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"उहाँको सास गर्दनसम्म उठ्ने","poem":1},{"text":"मुसलधारे पानीजस्तो छ।","poem":2},{"text":"उहाँले राष्ट्रहरूलाई नाश गर्ने नाङ्लोले निफन्‍नुहुन्छ;","poem":1},{"text":"र उहाँले मानिसहरूका बङ्गारामा फलामको लगाम लगाइदिनुहुनेछ,","poem":2},{"lineBreak":true},{"text":"जसले तिनीहरूलाई दिशाहीन बनाइदिनेछ।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"तिमीहरूले पवित्र चाड","poem":1},{"text":"मनाएको रातमा झैँ गीत गाउनेछौ;","poem":2},{"text":"मानिसहरू बाँसुरी लिएर याहवेहको पर्वतमा,","poem":1},{"text":"इस्राएलका चट्टानकहाँ जाँदा,","poem":2},{"text":"तिमीहरूका हृदय","poem":1},{"text":"आनन्दित हुनेछ।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"रिसको झोँक, भस्म गर्ने आगोको ज्वाला,","poem":1},{"text":"गड्याङ-गुडुङ, आँधीबेहरी र असिनासहित","poem":2},{"text":"याहवेहले मानिसहरूलाई आफ्नो प्रतापको वाणी सुन्‍न","poem":1},{"text":"र आफ्नो बाहुबलको शक्ति हेर्न लगाउनुहुनेछ।","poem":2}]},{"type":"verse","number":31,"content":[{"text":"याहवेहको सोरले अश्शूरलाई चकनाचुर पार्नेछ;","poem":1},{"text":"आफ्नो राजदण्डले उहाँले तिनीहरूलाई प्रहार गर्नुहुनेछ।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"याहवेहले आफ्नो पाखुराले तिनीहरूको विरुद्धमा युद्धमा लड्नुहुँदा,","poem":1},{"text":"उहाँले आफ्नो दण्डको लहुरोले","poem":2},{"text":"प्रत्येक चोटि तिनीहरूलाई सजायको रूपमा प्रहार गर्नुहुँदा,","poem":1},{"text":"चोट खैँजडी र वीणाको सङ्गीतको तालमा हुनेछ।","poem":2}]},{"type":"verse","number":33,"content":[{"text":"तोपेत तयार भइसकेको छ;","poem":1},{"text":"राजाका निम्ति त्यो तयार पारिएको छ।","poem":2},{"text":"त्यसको अग्निकुण्ड प्रशस्त आगो र दाउरासित;","poem":1},{"text":"गहिरो र चौडा तयार पारिएको छ;","poem":2},{"text":"बल्दैगरेको गन्धकको खोलाझैँ","poem":1},{"text":"याहवेहको सासले","poem":2},{"lineBreak":true},{"text":"त्यसलाई दन्काइदिनेछ।","poem":2}]}],"footnotes":[{"noteId":22,"caller":"+","text":"राहाब यो प्राचीन साहित्यको काल्पनिक सामुद्रिक जन्तु हो","reference":{"chapter":30,"verse":7}}]},"thisChapterLink":"/api/npi_ncb/ISA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}