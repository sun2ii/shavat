{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["इजिप्टमाथि भरोसा राख्नेलाई धिक्‍कार"]},{"type":"verse","number":1,"content":[{"text":"धिक्‍कार तिनीहरूलाई, जो सहायता पाउनका निम्ति इजिप्टमा जान्छन्,","poem":1},{"text":"घोडाहरूमाथि भर पर्दछन्,","poem":2},{"text":"तिनीहरू आफ्ना असंख्य रथहरू","poem":1},{"text":"र घोडसवारहरूका सामर्थ्यमा भरोसा राख्छन्,","poem":2},{"text":"तर इस्राएलका पवित्र परमेश्‍वरतिर हेर्दैनन्;","poem":1},{"text":"न त याहवेहबाट सहायता खोज्छन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"यद्यपि उहाँ पनि बुद्धिमान् हुनुहुन्छ र विपत्ति ल्याउन सक्नुहुन्छ;","poem":1},{"text":"उहाँले आफ्नो वचन फिर्ता लिनुहुन्‍न।","poem":2},{"text":"उहाँ दुष्‍ट राष्ट्रको विरुद्ध उठ्नुहुनेछ,","poem":1},{"text":"तिनीहरूको विरुद्ध, जसले दुष्‍ट काम गर्नेहरूलाई सहायता दिन्छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"इजिप्टियनहरू मानिस मात्र हुन्, परमेश्‍वर होइनन्;","poem":1},{"text":"तिनीहरूका घोडाहरू शरीर हुन्, आत्मा होइनन्।","poem":2},{"text":"जब याहवेहले आफ्नो हात पसार्नुहुन्छ,","poem":1},{"text":"तब सहायता गर्नेले ठेस खानेछ;","poem":2},{"lineBreak":true},{"text":"र सहायता पाउने पनि लोट्नेछ;","poem":2},{"lineBreak":true},{"text":"ती दुवै एकैसाथ नष्‍ट हुनेछन्।","poem":2}]},{"type":"verse","number":4,"content":["याहवेहले मलाई यो कुरो भन्‍नुहुन्छ:",{"text":"“जसरी सिंह गर्जन्छ,","poem":1},{"text":"अथवा जवान सिंहले आफ्नो शिकारमाथि गर्जन्छ—","poem":2},{"text":"अनि गोठालाहरूको सम्पूर्ण दल,","poem":1},{"text":"त्यसको विरुद्ध एकजुट भएर,","poem":2},{"text":"तिनीहरू कराए तापनि त्यो तर्सिँदैन,","poem":1},{"text":"अथवा तिनीहरूका हल्‍लाखल्‍लाले विचलित हुँदैन।","poem":2},{"text":"त्यसरी नै सेनाहरूका याहवेह सियोन पर्वतमा,","poem":1},{"text":"र त्यसको उचाइमा युद्ध गर्न आउनुहुनेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"चराहरूले आफ्नो गुँडको रक्षा गरेझैँ","poem":1},{"text":"सेनाहरूका याहवेहले यरूशलेमको रक्षा गर्नुहुनेछ।","poem":2},{"text":"उहाँले त्यसलाई रक्षा गर्नुहुनेछ, र त्यसलाई छुटाउनुहुनेछ।","poem":1},{"text":"उहाँ त्यसबाट भएर जानुहुनेछ र त्यसलाई छुटाउनुहुनेछ।”","poem":2}]},{"type":"verse","number":6,"content":["हे इस्राएलीहरू हो, उहाँको विरुद्ध तिमीहरूले यति धेरै विद्रोह गरेका छौ, उहाँकहाँ फर्क।"]},{"type":"verse","number":7,"content":["किनकि त्यस दिन तिमीहरूले आफ्ना पापी हातले बनाएका चाँदी र सुनका मूर्तिहरू त्याग्नेछौ।"]},{"type":"verse","number":8,"content":[{"text":"“अश्शूरीहरू तरवारद्वारा नाश पारिनेछन्,","poem":1},{"text":"तर मानिसबाटको तरवारले होइन।","poem":2},{"text":"तिनीहरू तरवारको सामु भाग्नेछन्;","poem":1},{"text":"अनि तिनीहरूका जवानहरू बेगारी काममा लगाइनेछन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरूका किल्‍ला आतङ्कको कारणले ढल्नेछ;","poem":1},{"text":"लडाइँको झण्डा देखेर तिनीहरूका सेनापतिहरू त्रासित हुनेछन्।”","poem":2},{"text":"याहवेह यो घोषणा गर्नुहुन्छ,","poem":1},{"text":"जसको आगो सियोनमा छ,","poem":2},{"lineBreak":true},{"text":"जसको भट्टी यरूशलेममा छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}