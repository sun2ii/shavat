{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["धार्मिकताको राज्य"]},{"type":"verse","number":1,"content":[{"text":"हेर, एउटा राजाले धार्मिकतामा राज्य गर्नुहुनेछ;","poem":1},{"text":"अनि शासकहरूले न्यायपूर्वक शासन गर्नेछन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हरेक मानिस बतासबाट जोगिने आश्रय","poem":1},{"text":"र आँधीबाट जोगिने शरणस्थानझैँ,","poem":2},{"text":"मरुभूमिमा पानीको खोलाझैँ,","poem":1},{"text":"र तिर्खाएको जमिनमा एउटा ठूलो चट्टानको छायाझैँ हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"तब देख्नेहरूका आँखा फेरि बन्द गरिनेछैन;","poem":1},{"text":"अनि सुन्‍नेहरूका कानले सुन्‍नेछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"अविवेकीको मनले समझशक्तिसाथ बुझ्नेछ;","poem":1},{"text":"अनि भकभकाउने जिब्रोले स्पष्‍ट र सफासँग बोल्नेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मूर्खलाई फेरि भद्र भनिनेछैन,","poem":1},{"text":"न त बदमासलाई उच्‍च आदर दिइनेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"किनकि मूर्खले अज्ञानताको कुरा गर्छ,","poem":1},{"text":"त्यसको मन दुष्‍ट कुराहरूमा लागिरहन्छ;","poem":2},{"text":"त्यसले भक्तिहीनताका कामहरू गर्छ;","poem":1},{"text":"अनि याहवेहको विषयमा गलत कुरा फैलाउँछ;","poem":2},{"text":"भोकोलाई त्यसले भोकै छोड्छ,","poem":1},{"text":"र तिर्खाएकोलाई त्यसले पानी दिँदैन।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"बदमासका काम गर्ने तरिकाहरू दुष्‍ट हुन्छन्,","poem":1},{"text":"र खाँचोमा परेकाहरूको बिन्ती न्यायोचित भए तापनि","poem":2},{"text":"गरिबहरूलाई झूटले नाश गर्नलाई","poem":1},{"text":"त्यसले दुष्‍ट योजनाहरू बनाउँछ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तर भलादमीले भलो युक्ति रच्दछ;","poem":1},{"text":"अनि भलो कामहरूद्वारा नै त्यो खडा रहन्छ।","poem":2}]},{"type":"heading","content":["यरूशलेमका स्त्रीहरू"]},{"type":"verse","number":9,"content":[{"text":"हे ढुक्‍कसित बस्‍ने स्त्रीहरू हो,","poem":1},{"text":"उठ र मेरो कुरा सुन;","poem":2},{"text":"आफूलाई सुरक्षित ठान्‍ने छोरीहरू हो,","poem":1},{"text":"मैले भन्‍नुपर्ने कुरा सुन!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"एक वर्षभन्दा केही बढी समयमा","poem":1},{"text":"तिमीहरू सुरक्षित ठान्‍नेहरू काँप्नेछौ;","poem":2},{"text":"अङ्‌गुरको फसलै हुनेछैन,","poem":1},{"text":"र फलको कटनी हुनेछैन।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हे ढुक्‍क बस्‍ने स्त्रीहरू हो, थरथर होओ;","poem":1},{"text":"आफूलाई सुरक्षित ठान्‍ने हे छोरीहरू हो, थरथर काम!","poem":2},{"text":"आफ्ना राम्रा लुगा फुकाल,","poem":1},{"text":"र आफ्ना कम्मरमा भाङ्ग्रा लगाओ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"असल खेतहरूका निम्ति,","poem":1},{"text":"फलदायक दाखको निम्ति आफ्ना छाती पिट;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"अनि मेरो जातिका देशको निम्ति,","poem":1},{"text":"काँडा र सिउँडीले ढाकेको देशका निम्ति—","poem":2},{"text":"हो, सबै आनन्द मनाउने घरहरूका निम्ति,","poem":1},{"text":"र यो आनन्दको सहरको निम्ति बिलौना गर।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"किल्‍ला त्यागिनेछ,","poem":1},{"text":"हल्‍लाको सहर शून्य हुनेछ;","poem":2},{"text":"किल्‍ला र रक्षा-धरहरा सदाका निम्ति बेकामका रहनेछन्;","poem":1},{"text":"जङ्गली गधाको निम्ति हर्ष र गाईबस्तुका निम्ति चरन हुनेछन्;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"जबसम्म माथिबाट हामीमा आत्मा खन्याइदैन,","poem":1},{"text":"र मरुभूमि मलिलो खेत हुँदैन,","poem":2},{"lineBreak":true},{"text":"र मलिलो खेत जङ्गलझैँ देखिँदैन;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"याहवेहको न्यायले त्यस मरुभूमिमा वास गर्नेछ।","poem":1},{"text":"अनि मलिलो खेतमा उहाँको धार्मिकता रहनेछ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"धार्मिकताको फल शान्ति हुनेछ;","poem":1},{"text":"अनि धार्मिकताको प्रभाव सदाको निम्ति चैन र भरोसा हुनेछ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"मेरा मानिसहरू शान्तिपूर्ण वासस्थानहरूमा,","poem":1},{"text":"सुरक्षित घरहरूमा र","poem":2},{"lineBreak":true},{"text":"शान्त विश्राम स्थलहरूमा बस्‍नेछन्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"असिनाले जङ्गललाई पूरै ढाके तापनि","poem":1},{"text":"सहर पूर्ण रूपले समतल भए तापनि","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तिमीहरू आफ्ना बिउहरू प्रत्येक खोलाको किनारमा छर्दै,","poem":1},{"text":"अनि आफ्ना गाईबस्तु र गधाहरूलाई ढुक्‍कै चर्नका निम्ति दिन पाउँदा","poem":2},{"lineBreak":true},{"text":"तिमीहरू कति धन्यका हुनेछौ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}