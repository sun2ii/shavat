{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["सङ्कष्‍ट र सहायता"]},{"type":"verse","number":1,"content":[{"text":"धिक्‍कार तँ नाशकर्तालाई,","poem":1},{"text":"जो नष्‍ट पारिएको छैनस्!","poem":2},{"text":"धिक्‍कार तँ विश्‍वासघातीलाई,","poem":1},{"text":"जसले धोका पाएको छैनस्!","poem":2},{"text":"जब तैँले नष्‍ट गर्न छोड्छस्,","poem":1},{"text":"तब तँ नष्‍ट पारिनेछस्;","poem":2},{"text":"जब तैँले विश्‍वासघात गर्न छोड्छस्,","poem":1},{"text":"तब तिनीहरूले तँसँग विश्‍वासघात गर्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"हे याहवेह, हामीप्रति अनुग्रही हुनुहोस्;","poem":1},{"text":"हामी तपाईंको बाटो हेरिरहन्छौँ;","poem":2},{"text":"हरेक बिहान हाम्रो सामर्थ्य","poem":1},{"text":"र विपत्तिमा हाम्रो मुक्ति बन्‍नुहोस्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तपाईंको सेनाको गर्जनको आवाजमा मानिसहरू भाग्छन्;","poem":1},{"text":"तपाईं खडा हुनुहुँदा राष्ट्रहरू तितरबितर हुन्छन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हे राष्ट्रहरू हो, तिमीहरूका लुटका सामान सलहहरूले झैँ कटनी गरिएको छ;","poem":1},{"text":"मानिसहरू लुटका सामानमा सलहका बथानझैँ झम्टन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"याहवेह अति महान् हुनुहुन्छ; किनकि उहाँ उच्‍च स्थानमा विराजमान हुनुहुन्छ;","poem":1},{"text":"उहाँले सियोनलाई न्याय र धार्मिकताले भरिदिनुहुनेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"उहाँ तिमीहरूका समयमा तिमीहरूका दृढ जग;","poem":1},{"text":"मुक्ति, बुद्धि र ज्ञानका मूल्यवान् भण्डार हुनुहुनेछ;","poem":2},{"lineBreak":true},{"text":"याहवेहको भय नै यस भण्डारको साँचो हो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हेर, तिनीहरूका वीर मानिसहरू सडकहरूमा जोडसित रुन्छन्;","poem":1},{"text":"शान्तिका दूतहरू धुरुधुरु रुन्छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"राजमार्गहरू त्यागिएका छन्;","poem":1},{"text":"बाटोमा कुनै यात्री छैन।","poem":2},{"text":"सन्धि तोडिएको छ;","poem":1},{"text":"त्यसका गवाहीहरूलाई घृणा गरिन्छ;","poem":2},{"lineBreak":true},{"text":"कसैको आदर छैन।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"देशले विलाप गर्छ र चिन्तामा छ;","poem":1},{"text":"लेबनान लज्जित भएर ओइलाउँछ;","poem":2},{"text":"शारोन अराबाझैँ छ,","poem":1},{"text":"बाशान र कर्मेलले आफ्ना पातहरू झार्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“अब म उठ्नेछु” याहवेह भन्‍नुहुन्छ।","poem":1},{"text":"“अब म उच्‍च पारिनेछु;","poem":2},{"lineBreak":true},{"text":"अब म उचालिनेछु।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तिमीहरूले भुसलाई गर्भधारण गर्छौ,","poem":1},{"text":"तिमीहरूले पराल जन्माउँछौ;","poem":2},{"lineBreak":true},{"text":"तिमीहरूका सास तिमीहरूलाई नै भस्म पार्ने आगो हो।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मानिसहरू चून जलेझैँ जल्नेछन्;","poem":1},{"text":"काटिएका काँडाघारी आगोमा जलाइएझैँ तिनीहरू जलाइनेछन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"हे टाढा-टाढाका मानिसहरू हो, मैले के-के गरेको छु, सो कुरा सुन!","poem":1},{"text":"तिमीहरू नजिक हुनेहरू, मेरो सामर्थ्य स्वीकार गर!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"सियोनमा भएका पापीहरू आतङ्कित छन्;","poem":1},{"text":"भक्तिहीनलाई कम्पनले समातेको छ;","poem":2},{"text":"“हामीमध्ये को भस्म पार्ने आगोको साथमा बस्‍न सक्ला?","poem":1},{"text":"हामीमध्ये को अनन्तको जलनसित बस्‍न सक्ला?”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"त्यही मानिस, जो धार्मिकतामा चल्छ,","poem":1},{"text":"र जे ठिक छ, त्यही बोल्छ;","poem":2},{"text":"जसले लुटको लाभलाई इन्कार गर्छ,","poem":1},{"text":"र आफ्नो हातलाई घूस लिनबाट अलग राख्छ,","poem":2},{"text":"जसले हत्याको षड्यन्त्रको विरुद्ध आफ्ना कान बन्द गर्छ,","poem":1},{"text":"र आफ्ना आँखा दुष्‍टता हेर्नबाट बन्द गर्छ;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"यस्तो मानिस उच्‍च स्थानहरूमा वास गर्नेछ,","poem":1},{"text":"जसको शरणस्थान पहाडको किल्‍ला हुनेछ।","poem":2},{"text":"त्यसलाई रोटी जुटाइनेछ,","poem":1},{"text":"र त्यसलाई पानीको अभाव हुनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"तेरा आँखाले राजालाई उहाँको सुन्दरतामा देख्नेछ,","poem":1},{"text":"र टाढासम्म फैलिएको देशलाई देख्नेछ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तेरा विचारहरूमा तैँले पहिलेका आतङ्क सोच्नेछस्:","poem":1},{"text":"“त्यो प्रमुख अधिकृत कहाँ छ?","poem":2},{"text":"कर असुल गर्ने खोइ?","poem":1},{"text":"धरहराहरूको जिम्मामा रहेका अधिकृत कहाँ छन्?”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तैँले ती घमण्डी मानिसहरूलाई अब उसो देख्नेछैनस्;","poem":1},{"text":"ती अस्पष्‍ट बोली भएका मानिसहरूलाई,","poem":2},{"lineBreak":true},{"text":"जसको बोली बुझिँदैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"हाम्रा चाडहरूको सहर, सियोनलाई हेर;","poem":1},{"text":"तिमीहरूका आँखाले यरूशलेमलाई देख्नेछ;","poem":2},{"lineBreak":true},{"text":"एउटा शान्तिपूर्ण वासस्थान, त्यो पाललाई सारिनेछैन;","poem":2},{"text":"त्यसका किलाहरू कहिल्यै उखेलिनेछैनन्;","poem":1},{"text":"न त त्यसका कुनै डोरी चुँडाइनेछ।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"त्यहाँ याहवेह हाम्रो पराक्रमी परमेश्‍वर हुनुहुनेछ।","poem":1},{"text":"त्यो चौडा नदीहरू र खोलाहरू भएको ठाउँजस्तै हुनेछ।","poem":2},{"text":"पतवारले चलाइने कुनै युद्ध जहाज त्यहाँ चल्नेछैन;","poem":1},{"text":"कुनै शक्तिशाली जहाज त्यहाँबाट भएर चल्नेछैन।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"किनकि याहवेह हाम्रा न्यायकर्ता हुनुहुन्छ;","poem":1},{"text":"याहवेह हाम्रो व्यवस्थादाता हुनुहुन्छ;","poem":2},{"text":"याहवेह हाम्रा राजा हुनुहुन्छ;","poem":1},{"text":"हामीलाई बचाउनुहुने उहाँ नै हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"तेरा डोरीहरू खुकुला भएका छन्:","poem":1},{"text":"मस्तुल सुरक्षित राखिएको छैन,","poem":2},{"lineBreak":true},{"text":"पाल फिँजिएको छैन।","poem":2},{"text":"तब लुटका प्रशस्त माल बाँडिनेछ,","poem":1},{"text":"र लङ्गडाहरू समेतले लुटको माल लैजानेछन्।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"सियोनमा बस्‍ने कसैले पनि, “म बिरामी छु” भन्‍नेछैन;","poem":1},{"text":"अनि त्यहाँ बस्‍नेहरू सबैका पाप क्षमा गरिनेछन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}