{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["राष्ट्रहरूका विरुद्धमा न्याय"]},{"type":"verse","number":1,"content":[{"text":"हे जाति-जातिका मानिसहरू हो, नजिक आएर सुन;","poem":1},{"text":"हे मानिसहरू हो, ध्यान देओ!","poem":2},{"text":"पृथ्वी र यसमा भएका सबैले,","poem":1},{"text":"संसार र यसबाट निस्किआउने सबैले सुनून्!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेह सबै जातिहरूसित रिसाउनुभएको छ;","poem":1},{"text":"उहाँको क्रोध तिनीहरूका सबै सेनाहरूमाथि छ।","poem":2},{"text":"उहाँले तिनीहरूलाई सम्पूर्ण रूपले नाश गर्नुहुनेछ;","poem":1},{"text":"उहाँले तिनीहरूलाई मारिनलाई दिनुहुनेछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरूका मारिएकाहरू फालिनेछन्,","poem":1},{"text":"र तिनीहरूका मृत शरीरहरूले दुर्गन्ध फैलाउनेछन्;","poem":2},{"lineBreak":true},{"text":"पहाडहरू तिनीहरूका रगतले भिज्नेछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"आकाशका सबै ताराहरू विलीन हुनेछन्,","poem":1},{"text":"र आकाशचाहिँ चर्मपत्रझैँ बेरिनेछ;","poem":2},{"text":"सम्पूर्ण तारामण्डल","poem":1},{"text":"अङ्‌गुरको बोटबाट ओइलिएका पातहरू झरेजस्तै,","poem":2},{"lineBreak":true},{"text":"र नेभाराको बोटबाट चाउरी परेका नेभाराहरूझैँ खस्‍नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मेरो तरवार आकाशमण्डलमा पिएर तृप्‍त भएको छ;","poem":1},{"text":"हेर, न्यायका लागि एदोममाथि त्यसले प्रहार गर्नेछ;","poem":2},{"lineBreak":true},{"text":"त्यस जातिमाथि, जसलाई मैले नाशका निम्ति अलग गरेको छु।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"याहवेहको तरवार रगतमा चोपिएको छ;","poem":1},{"text":"त्यो बोसोले पुष्‍ट भएको छ—","poem":2},{"text":"थुमा र बाख्राहरूका रगत,","poem":1},{"text":"भेडाहरूका मिर्गौलाको बोसोले लतपतिएको छ।","poem":2},{"text":"किनकि बोज्रामा याहवेहको एउटा बलिदान छ;","poem":1},{"text":"अनि एदोममा ठूलो संहार भएको छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरूसित जङ्गली साँढेहरू,","poem":1},{"text":"बाछाहरू र ठूला साँढेहरू लड्नेछन्।","poem":2},{"text":"तिनीहरूको देश रगतले निथ्रुक्‍क भिज्नेछ;","poem":1},{"text":"अनि धुलो बोसोसित मिसिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"किनकि याहवेहको बदला लिने एउटा दिन छ,","poem":1},{"text":"सियोनको मुद्दा अटल राख्नलाई दण्ड दिने वर्ष छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"एदोमका खोलाहरू अलकत्रामा परिवर्तन हुनेछन्;","poem":1},{"text":"त्यसका धुलो बल्दैगरेको गन्धकमा परिवर्तन हुनेछ;","poem":2},{"lineBreak":true},{"text":"त्यसको देश बल्दैगरेको अलकत्रा हुनेछ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"त्यो रात वा दिन, कहिल्यै निभ्नेछैन;","poem":1},{"text":"त्यसको धुवाँ निरन्तर उँभो उठिरहनेछ।","poem":2},{"text":"पुस्ता-पुस्तासम्म त्यो उजाड भएर रहनेछ;","poem":1},{"text":"त्यसबाट भएर फेरि कोही जानेछैन।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यसलाई मरुभूमिको उल्‍लु र दुम्सीले अधिकार गर्नेछन्;","poem":1},{"text":"ठूलो उल्‍लु र कागहरूले त्यसमा गुँड बनाउनेछन्।","poem":2},{"text":"परमेश्‍वरले एदोममाथि","poem":1},{"text":"गोलमालको नापडोरी","poem":2},{"lineBreak":true},{"text":"र उजाडको साहुल तेर्साइदिनुहुनेछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्यसका कुलीन मानिसहरूका निम्ति राज्य भन्‍न लायक त्यहाँ केही पनि हुनेछैन;","poem":1},{"text":"त्यसका सबै राजकुमारहरू बेपत्ता हुनेछन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"त्यसका किल्‍लाका बुर्जाहरूमा काँडा,","poem":1},{"text":"र त्यसका किल्‍लाहरूमा सिस्‍नु र सिउँडीहरू उम्रनेछन्।","poem":2},{"text":"त्यो स्यालहरू","poem":1},{"text":"र उल्‍लुहरूका वासस्थान हुनेछ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"मरुभूमिका जन्तुहरू हुँडारहरूसित भेट गर्नेछन्;","poem":1},{"text":"अनि जङ्गली बाख्राहरू आपसमा म्याँ-म्याँ गर्नेछन्;","poem":2},{"text":"त्यहाँ रातका पशुहरू पनि ढल्किनेछन्;","poem":1},{"text":"अनि आफ्नै निम्ति विश्रामस्थल भेट्टाउनेछन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"उल्‍लुले त्यहाँ गुँड बनाएर अण्डा पार्नेछे,","poem":1},{"text":"त्यसले बचेरा काढेर त्यसलाई","poem":2},{"lineBreak":true},{"text":"आफ्ना पखेटाको छहारीमा हुर्काउँछे;","poem":2},{"text":"त्यहाँ बाजहरू पनि","poem":1},{"text":"आ-आफ्ना जोडीसित भेट गर्नेछन्।","poem":2}]},{"type":"verse","number":16,"content":["याहवेहको चर्मपत्रमा हेर र पढ:",{"text":"तीमध्ये एउटै पनि हराउनेछैन,","poem":1},{"text":"कसैलाई आफ्नो जोडीको अभाव हुनेछैन।","poem":2},{"text":"किनकि यो हुकुम उहाँको मुखले दिएको हो;","poem":1},{"text":"अनि उहाँका आत्माले ती एकसाथ बटुल्नुहुनेछ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"उहाँले तिनीहरूका भाग छुट्ट्याइदिनुहुनेछ;","poem":1},{"text":"उहाँको हातले नाप्‍ने डोरी तानेर बाँडिदिनुभएको छ।","poem":2},{"text":"तिनीहरूले त्यसलाई सदाको निम्ति आफ्नो बनाउनेछन्","poem":1},{"text":"र पुस्तादेखि पुस्तासम्मै त्यहाँ बस्‍नेछन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}