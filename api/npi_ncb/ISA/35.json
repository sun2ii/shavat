{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["उद्धार पाएकाहरूको आनन्द"]},{"type":"verse","number":1,"content":[{"text":"मरुभूमि र निर्जलभूमि खुशी हुनेछन्;","poem":1},{"text":"उजाडस्थान रमाएर फक्रनेछ।","poem":2},{"text":"र अति आनन्दित हुनेछन्; अनि केशरझैँ","poem":1}]},{"type":"verse","number":2,"content":[{"text":"हर्षले फुल्नेछ;","poem":1},{"text":"त्यो अति खुशी भएर आनन्दले कराउनेछ।","poem":2},{"text":"लेबनानको महिमा;","poem":1},{"text":"कर्मेल र शारोनको गौरव त्यसलाई दिइनेछ;","poem":2},{"text":"तिनीहरूले याहवेहको महिमा","poem":1},{"text":"र हाम्रा परमेश्‍वरको प्रताप देख्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"दुर्बल हातहरू बलियो बनाओ!","poem":1},{"text":"कमजोर घुँडाहरू दह्रिला पार;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हृदयमा डर बोकेकाहरूलाई भन,","poem":1},{"text":"“बलियो होओ, नडराओ;","poem":2},{"text":"तिमीहरूका परमेश्‍वर आउनुहुनेछ;","poem":1},{"text":"उहाँ बदला लिन आउनुहुनेछ;","poem":2},{"text":"उहाँ तिमीहरूलाई बचाउन","poem":1},{"text":"ईश्‍वरीय प्रतिशोधसित आउनुहुनेछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तब अन्धाहरूका आँखा खोलिनेछन्;","poem":1},{"text":"अनि बहिराहरूका कान बन्द रहनेछैनन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तब लङ्गडाहरू मृगझैँ उफ्रनेछन्;","poem":1},{"text":"अनि गुँगाहरूको जिब्रोले स्तुति गर्नेछ।","poem":2},{"text":"उजाडस्थानमा पानी फुटेर निस्कनेछ;","poem":1},{"text":"अनि मरुभूमिमा खोला बग्नेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तातो बालुवा ठूलो तलाउ बन्‍नेछ,","poem":1},{"text":"तिर्खाएको जमिनमा कलकल गर्ने पानीका मूल फुट्नेछन्।","poem":2},{"text":"कुनै समय स्याल बस्‍ने ठाउँमा","poem":1},{"text":"घाँस, निगालो र काँस हुर्कनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"त्यहाँ एउटा राजमार्ग हुनेछ;","poem":1},{"text":"त्यसलाई पवित्रताको मार्ग भनिनेछ;","poem":2},{"lineBreak":true},{"text":"अशुद्ध त्यसबाट भएर जानेछैन।","poem":2},{"text":"तर त्यसबाट भएर हिँड्नेहरूका लागि मात्र त्यो हुनेछ;","poem":1},{"text":"दुष्‍ट मूर्खहरू त्यसबाट भएर जानेछैनन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यहाँ कुनै सिंह हुनेछैन,","poem":1},{"text":"न त कुनै हिंसक पशु त्यहाँ पुग्न सक्नेछ;","poem":2},{"lineBreak":true},{"text":"तिनीहरू त्यहाँ भेट्टाइनेछैनन्।","poem":2},{"text":"तर छुटकारा पाएकाहरू मात्र त्यहाँ हिँड्नेछन्।","poem":1}]},{"type":"verse","number":10,"content":[{"text":"याहवेहका मोल तिरेर छुटाइएकाहरू फर्कनेछन्।","poem":2},{"text":"तिनीहरू सियोनमा गाउँदै पस्‍नेछन्;","poem":1},{"text":"तिनीहरूका शिरमा सदासर्वदाको आनन्दको मुकुट हुनेछ।","poem":2},{"text":"तिनीहरू आनन्द र हर्षमा चुर्लुम्म डुब्नेछन्;","poem":1},{"text":"अनि दुःख र सुस्केरा हराएर जानेछन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}