{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"त्यस दिन सात जना स्त्रीहरूले","poem":1},{"text":"एक जना मानिसलाई समात्नेछन्,","poem":2},{"text":"र यसो भन्‍नेछन्, “हामी आफ्नै भोजन खानेछौँ;","poem":1},{"text":"अनि आफ्ना लुगाको प्रबन्ध आफैँ गर्नेछौँ;","poem":2},{"text":"तपाईं हाम्रो पति हुनुहोस्।","poem":1},{"text":"हाम्रो अपमान तपाईंले हटाइदिनुहोस्!”","poem":2}]},{"type":"heading","content":["याहवेहको हाँगा"]},{"type":"verse","number":2,"content":["त्यस दिन याहवेहको हाँगा सुन्दर र महिमित हुनेछ; अनि जमिनको फल इस्राएलमा बाँचेकाहरूका निम्ति गर्व र महिमा हुनेछ।"]},{"type":"verse","number":3,"content":["सियोनमा छोडिएका यरूशलेममा रहनेहरू सबै, जो यरूशलेममा बस्‍नेहरूको गन्तीमा आएका छन्, तिनीहरू पवित्र भनिनेछन्।"]},{"type":"verse","number":4,"content":["प्रभुले सियोनका स्त्रीहरूको मैला धोइदिनुहुनेछ; उहाँले न्यायको आत्मा र आगोको आत्माले यरूशलेमबाट रगतका दागहरू सफा गरिदिनुहुनेछ।"]},{"type":"verse","number":5,"content":["त्यसपछि याहवेहले सियोन पर्वतमाथि र त्यहाँ भेला हुने जातिमाथि दिनमा धुवाँको बादल अनि राति बल्दो आगोको ज्योति सृष्‍टि गरिदिनुहुनेछ; त्यस सम्पूर्ण महिमामाथि एउटा मण्डप हुनेछ।"]},{"type":"verse","number":6,"content":["त्यो दिनको गर्मीबाट बच्ने आश्रय र छाया; अनि आँधी र वर्षाबाट बचाउने शरणस्थान र लुक्ने ठाउँ हुनेछ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}