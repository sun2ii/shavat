{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["परमेश्‍वरका प्रजालाई सान्त्वना"]},{"type":"verse","number":1,"content":[{"text":"सान्त्वना, मेरा प्रजालाई सान्त्वना देओ!","poem":1},{"text":"तिमीहरूका परमेश्‍वर भन्‍नुहुन्छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"यरूशलेमसित कोमलतासाथ कुरा गर।","poem":1},{"text":"त्यसलाई भन,","poem":2},{"text":"त्यसका कठिन सेवा पूरा भइसकेको छ,","poem":1},{"text":"त्यसका पापको मूल्य तिरिएको छ;","poem":2},{"text":"त्यसले याहवेहको हातबाट","poem":1},{"text":"आफ्ना सबै पापका निम्ति दोबर पाएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"एक जना कराउनेको आवाज सुनिन्छ:","poem":1},{"lineBreak":true},{"text":"“उजाडस्थानमा याहवेहको निम्ति","poem":1},{"text":"बाटो तयार पार;","poem":2},{"text":"उजाडस्थानमा हाम्रा परमेश्‍वरका निम्ति","poem":1},{"text":"राजमार्ग सीधा बनाओ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"प्रत्येक उपत्यका अग्लो पारिनेछ,","poem":1},{"text":"प्रत्येक पर्वत र डाँडा होचो बनाइनेछ;","poem":2},{"text":"टेढामेढा जमिन मिलाइनेछ,","poem":1},{"text":"खाल्टाखुल्टी समतल बनाइनेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तब याहवेहको महिमा प्रकट हुनेछ,","poem":1},{"text":"र सारा मानव जातिले त्यसलाई एकसाथ देख्नेछन्।","poem":2},{"text":"किनकि याहवेहको मुखले यो भनेको छ।”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"एउटा आवाजले भन्छ, “करा।”","poem":1},{"text":"अनि मैले भनेँ, “म के भनेर कराऊँ?”","poem":2},{"lineBreak":true},{"text":"“सारा मानिसहरू घाँसजस्तै हुन्,","poem":1},{"text":"र तिनीहरूका गौरव मैदानका फूलहरूझैँ हुन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"घाँस ओइलाउँछ र फूल झरिहाल्छ;","poem":1},{"text":"किनकि याहवेहको सास तीमाथि फुकिन्छ।","poem":2},{"lineBreak":true},{"text":"निश्‍चय नै मानिसहरू घाँस नै हुन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"घाँस ओइलाउँछ र फूल झरिहाल्छ,","poem":1},{"text":"तर हाम्रा परमेश्‍वरको वचन सदासर्वदा रहिरहन्छ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"हे सियोनमा शुभ समाचार ल्याउने,","poem":1},{"text":"अग्लो पर्वतमा चढ्!","poem":2},{"text":"हे यरूशलेममा शुभ समाचार ल्याउने,","poem":1},{"text":"आफ्नो सोर जोडले उचाल्,","poem":2},{"text":"सोर उचाल्, नडरा;","poem":1},{"text":"यहूदाका नगरहरूलाई भन्,","poem":2},{"lineBreak":true},{"text":"“तिमीहरूका परमेश्‍वर यहाँ हुनुहुन्छ!”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"हेर, सार्वभौम याहवेह शक्तिसाथ आउनुहुन्छ,","poem":1},{"text":"र आफ्नो बाहुलीले शासन गर्नुहुन्छ।","poem":2},{"text":"हेर, उहाँको पुरस्कार उहाँसितै छ,","poem":1},{"text":"र उहाँको प्रतिफल उहाँको साथमा छ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"उहाँले आफ्ना बगाललाई गोठालाले झैँ हेरचाह गर्नुहुन्छ:","poem":1},{"text":"उहाँले थुमाहरूलाई आफ्ना अँगालोमा लिनुहुन्छ;","poem":2},{"text":"तिनीहरूलाई आफ्नो मुटुको नजिक राख्नुहुन्छ;","poem":1},{"text":"उहाँले स-साना बच्‍चा भएकाहरूलाई बिस्तारै डोर्‍याउनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"कसले आफ्नो अञ्जुलीमा पानीलाई नापेको छ,","poem":1},{"text":"अथवा आफ्ना हातको चौडाइले आकाश नापेको छ?","poem":2},{"text":"कसले पृथ्वीको धुलोलाई एउटा डालोमा भरेको छ,","poem":1},{"text":"अथवा पर्वतहरू","poem":2},{"lineBreak":true},{"text":"र डाँडाहरूलाई तराजुमा जोखेको छ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"कसले याहवेहको मनलाई बुझेको छ,","poem":1},{"text":"वा उहाँको सल्‍लाहकार भएर उहाँलाई शिक्षा दिएको छ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"समझको निम्ति याहवेहले कससित सल्‍लाह लिनुभयो,","poem":1},{"text":"र कसले उहाँलाई उचित मार्ग देखायो?","poem":2},{"text":"उहाँलाई ज्ञान सिकाउने","poem":1},{"text":"अथवा समझको मार्ग देखाउने को हो?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"निश्‍चय नै जातिहरू त बाल्टीमा भएको एक थोपा पानीजस्ता हुन्;","poem":1},{"text":"तिनीहरू त तराजुमा भएको धुलोझैँ ठानिएका छन्;","poem":2},{"lineBreak":true},{"text":"उहाँले टापुहरूलाई धुलोजस्तै तौलिनुहुन्छ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"वेदीका दाउराको निम्ति लेबनान पर्याप्‍त छैन,","poem":1},{"text":"न त त्यसका जन्तुहरू होमबलिको निम्ति प्रशस्त छन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"उहाँको सामु सबै जातिहरू केही होइनन्;","poem":1},{"text":"तिनीहरूलाई उहाँले व्यर्थको","poem":2},{"lineBreak":true},{"text":"र शून्यभन्दा पनि थोरै ठान्‍नुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"तब तिमीहरू परमेश्‍वरलाई कोसित तुलना गर्छौ?","poem":1},{"text":"तिमीहरूले उहाँलाई कुन आकृतिसित तुलना गर्छौ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"मूर्तिलाई कारिगरले खोपेर बनाउँछ,","poem":1},{"text":"सुनारले त्यसलाई सुनले मोहर्छ,","poem":2},{"lineBreak":true},{"text":"र त्यसको निम्ति चाँदीको सिक्रीहरू बनाउँछ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"यस्तो भेटी चढाउन नसक्ने","poem":1},{"text":"अति गरिबले चाहिँ एउटा नकुहिने काठ छान्छ;","poem":2},{"text":"त्यसले नहल्‍लिने किसिमको एउटा मूर्ति बनाउन","poem":1},{"text":"एक जना सिपालु कारिगर खोज्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"के तिमीहरूले जानेका छैनौ?","poem":1},{"text":"के तिमीहरूले सुनेका छैनौ?","poem":2},{"text":"के तिमीहरूलाई यो सुरुदेखि नै भनिएको थिएन?","poem":1},{"text":"के तिमीहरूले पृथ्वीको जग बसालिएदेखि नै बुझेका छैनौ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"उहाँ पृथ्वीको गोलाइमाथि सिंहासनमा विराजमान हुनुहुन्छ;","poem":1},{"text":"पृथ्वीका मानिसहरू फट्याङ्ग्राजस्ता छन्।","poem":2},{"text":"उहाँले आकाशलाई मण्डपझैँ तन्काउनुहुन्छ;","poem":1},{"text":"अनि त्यसमा बास गर्नलाई त्यो पालझैँ फिँजाउनुहुन्छ।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"उहाँले राजकुमारहरूलाई शून्य ठहराउनुहुन्छ,","poem":1},{"text":"र यस संसारका शासकहरूलाई हटाएर बेकम्मा तुल्याउनुहुन्छ।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"तिनीहरू रोपिनेबित्तिकै, छरिनासाथ,","poem":1},{"text":"तिनीहरूले जमिनमा जरा हाल्नसाथ,","poem":2},{"lineBreak":true},{"text":"उहाँले तिनीहरूलाई फुकिदिनुहुन्छ,","poem":2},{"text":"र तिनीहरू ओइलिन्छन्;","poem":1},{"text":"अनि भुमरीले तिनीहरूलाई भुसझैँ उडाएर लैजान्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“तिमीहरू मलाई कससित तुलना गर्छौ?","poem":1},{"text":"अथवा को म समान छ?” पवित्र परमेश्‍वर भन्‍नुहुन्छ।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"आफ्ना आँखा उठाएर आकाशतिर हेर:","poem":1},{"text":"कसले यी सबै कुराहरू सृष्‍टि गरे?","poem":2},{"text":"उहाँ, जसले तारामण्डललाई एक-एक गरी ल्याउनुहुन्छ,","poem":1},{"text":"र प्रत्येकलाई नामद्वारा बोलाउनुहुन्छ।","poem":2},{"text":"उहाँको महान् पराक्रम र बलवान् शक्तिको कारण","poem":1},{"text":"तीमध्ये एउटै पनि हराएको छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"हे याकोब, तँ किन गुनासो पोख्छस्,","poem":1},{"text":"हे इस्राएल, तँ किन यस्तो भन्छस्,","poem":2},{"text":"“मेरो मार्ग याहवेहबाट लुकेको छ;","poem":1},{"text":"मेरो मुद्दा मेरा परमेश्‍वरले बेवास्ता गर्नुभएको छ?”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"के तँ जान्दैनस्?","poem":1},{"text":"के तैँले सुनेको छैनस्?","poem":2},{"text":"याहवेह अनन्तका परमेश्‍वर हुनुहुन्छ,","poem":1},{"text":"सारा पृथ्वीका सृष्‍टिकर्ता हुनुहुन्छ।","poem":2},{"text":"उहाँ थाक्नुहुन्‍न, न त गल्नु हुन्छ,","poem":1},{"text":"उहाँको बुद्धि अपरम्पार छ।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"उहाँले थकितहरूलाई सामर्थ्य दिनुहुन्छ,","poem":1},{"text":"र दुर्बलहरूको शक्ति बढाइदिनुहुन्छ।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"जवानहरू पनि थाक्छन् र गल्छन्;","poem":1},{"text":"अनि जवान मानिसहरू ठक्‍कर खाएर लड्छन्;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"तर याहवेहमा आशा राख्नेहरूले","poem":1},{"text":"नयाँ सामर्थ्य पाउँछन्।","poem":2},{"text":"तिनीहरू चीलझैँ पखेटाले माथि उड्नेछन्;","poem":1},{"text":"तिनीहरू दगुर्ने छन्, तर पनि थाक्नेछैनन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरू हिँड्नेछन्, तर बेहोस हुनेछैनन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}