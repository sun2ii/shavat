{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["इस्राएलका सहायक"]},{"type":"verse","number":1,"content":[{"text":"“हे टापुहरू हो, मेरो सामु चुप लागेर बस!","poem":1},{"text":"राष्ट्रहरूले नयाँ सामर्थ्य प्राप्‍त गरून्!","poem":2},{"text":"तिनीहरू अगि आएर बोलून्;","poem":1},{"text":"हामी न्यायको ठाउँमा भेट गरौँ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“कसले पूर्वबाट एक जनालाई","poem":1},{"text":"उहाँको सेवाको निम्ति धार्मिकतामा बोलाएर सुर्‍याएको छ?","poem":2},{"text":"उहाँले त्यसलाई राष्ट्रहरू दिनुहुन्छ,","poem":1},{"text":"र राजाहरूलाई त्यसको वशमा पार्नुहुन्छ।","poem":2},{"text":"जसले आफ्नो तरवारले तिनीहरूलाई माटोमा परिणत गरिदिनुहुन्छ,","poem":1},{"text":"तथा आफ्नो धनुले बतासलाई उडाएको भुसमा परिणत गरिदिनुहुन्छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्यसले तिनीहरूलाई खेद्छ र विनारोकटोक अगि बढ्छ;","poem":1},{"text":"यस्तो बाटोबाट, जसमा त्यसका खुट्टाले पहिले हिँडेका थिएनन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पुस्ताहरूलाई सुरुदेखि बोलाएर,","poem":1},{"text":"यो काम कसले गर्‍यो र पूरा गर्‍यो?","poem":2},{"text":"म याहवेह नै हुँ, जो तिनीहरूका पहिलो","poem":1},{"text":"र पछिल्‍लोसित रहन्छु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"टापुहरूले त्यो देखे, र डराए;","poem":1},{"text":"पृथ्वीको पल्‍लो छेउहरू काँप्छन्।","poem":2},{"text":"तिनीहरू नजिक आएर अगाडि आउँछन्;","poem":1}]},{"type":"verse","number":6,"content":[{"text":"एक-अर्कालाई सघाउँछन्,","poem":2},{"lineBreak":true},{"text":"र एउटाले अरू दाजुभाइलाई भन्छ, “बलियो होउ!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"कारिगरले सुनारलाई ढाडस दिन्छ,","poem":1},{"text":"र धातु पिट्न घन प्रहार गर्नेले","poem":2},{"lineBreak":true},{"text":"लिहिमा धातु पिटेर चिल्‍लो पार्नेलाई प्रोत्साहन दिन्छ।","poem":2},{"text":"त्यसले लिहिको विषयमा यसो भन्छ, “यो असलै छ।”","poem":1},{"text":"त्यसले मूर्तिलाई किला ठोकेर बलियो पार्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“तर तँ, हे मेरो सेवक इस्राएल,","poem":1},{"text":"याकोब, जसलाई मैले चुनेको छु।","poem":2},{"lineBreak":true},{"text":"मेरा मित्र, अब्राहामका सन्तान,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मैले तँलाई पृथ्वीको पल्‍लो छेउबाट लिएँ,","poem":1},{"text":"र त्यसका सुदूर कुनाबाट मैले तँलाई बोलाएँ।","poem":2},{"text":"अनि मैले भनेँ, ‘तँ मेरो दास होस्’","poem":1},{"text":"मैले तँलाई चुनेको छु, र तँलाई इन्कार गरेको छैनँ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"यसकारण नडरा; किनकि म तँसित छु;","poem":1},{"text":"निराश नहो, किनकि म तेरो परमेश्‍वर हुँ।","poem":2},{"text":"म तँलाई सामर्थी बनाउनेछु, र सहायता दिनेछु;","poem":1},{"text":"म तँलाई आफ्ना धार्मिकताको दाहिने हातले सम्हाल्नेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“तेरो विरुद्ध रिस गर्ने","poem":1},{"text":"सबै लाजमा पर्नेछन्, र अपमानित हुनेछन्;","poem":2},{"text":"तेरो विरोध गर्नेहरू","poem":1},{"text":"नाश भएर मेटिनेछन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तैँले तेरा शत्रुहरूलाई खोजे तापनि","poem":1},{"text":"तिनीहरूलाई भेट्टाउनेछैनस्।","poem":2},{"text":"तेरो विरुद्धमा लडाइँ गर्नेहरू","poem":1},{"text":"नाश भएर मेटिनेछन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"किनकि म याहवेह नै तेरा परमेश्‍वर हुँ,","poem":1},{"text":"जसले तेरो दाहिने हात समातेर","poem":2},{"text":"तँलाई भन्दछु, नडरा;","poem":1},{"text":"म तँलाई सहायता गर्नेछु।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"हे किरासमान याकोब,","poem":1},{"text":"हे सानो इस्राएल, नडरा;","poem":2},{"text":"किनकि म आफैँ तँलाई सहायता गर्नेछु”","poem":1},{"text":"तेरो उद्धारक, इस्राएलका पवित्र परमेश्‍वर, याहवेह घोषणा गर्नुहुन्छ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“हेर, म तँलाई दाँदेजस्तै हतियार बनाउनेछु;","poem":1},{"text":"नयाँ र तीखा धेरै दाँतहरू भएको धारिलो दाँदेजस्तै बनाउनेछु।","poem":2},{"text":"तैँले पर्वतहरूलाई दाइँ गर्नेछस् र तिनीहरूलाई पेल्नेछस्;","poem":1},{"text":"अनि पर्वतहरूलाई घटाएर भुस बनाउनेछस्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तैँले तिनीहरूलाई नाङ्लोले निफन्‍नेछस्,","poem":1},{"text":"र हावाले तिनीहरूलाई उडाइलैजानेछ, र आँधीले तिनीहरूलाई","poem":2},{"lineBreak":true},{"text":"छरपस्ट पारिदिनेछ।","poem":2},{"text":"तर तँचाहिँ याहवेहमा आनन्दित हुनेछस्,","poem":1},{"text":"र तैँले इस्राएलका पवित्र परमेश्‍वरलाई प्रशंसा गर्नेछस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“गरिब र खाँचोमा परेकाहरूले पानी खोज्छन्,","poem":1},{"text":"तर पानी कतै छैन;","poem":2},{"lineBreak":true},{"text":"तिनीहरूका जिब्रा प्यासले सुकेका छन्।","poem":2},{"text":"तर म याहवेहले नै तिनीहरूलाई जवाफ दिनेछु;","poem":1},{"text":"म इस्राएलका परमेश्‍वर भएको कारण तिनीहरूलाई त्याग्नेछैनँ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"म बाँझो अग्ला ठाउँहरूमा नदीहरू बग्न लगाउनेछु;","poem":1},{"text":"अनि बेँसीमा खोलाहरू बग्न लगाउनेछु।","poem":2},{"text":"म मरुभूमिलाई पानीको पोखरीमा","poem":1},{"text":"र डढेको जमिनलाई खोलाहरूमा परिणत गर्नेछु।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"म मरुभूमिमा देवदारु र बबुल,","poem":1},{"text":"मेहदी र जैतुन लगाउनेछु।","poem":2},{"text":"म बाँझो जमिनमा सल्‍ला,","poem":1},{"text":"धूपी र सिसौ एकैसाथ उमार्नेछु,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ताकि मानिसहरूले देखून् र जानून्,","poem":1},{"text":"विचार गरून् र बुभून्,","poem":2},{"text":"कि यो याहवेहको हातको काम हो;","poem":1},{"text":"इस्राएलका पवित्र परमेश्‍वरले यो सृजनुभएको हो।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"याहवेह भन्‍नुहुन्छ,","poem":1},{"text":"“तिमीहरूका मुद्दा पेश गर।”","poem":2},{"text":"याकोबका राजा भन्‍नुहुन्छ,","poem":1},{"text":"“तिमीहरूका तर्क पेश गर।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तिमीहरूका मूर्तिहरूलाई लिएर आओ","poem":1},{"text":"भविष्यका कुरा तिनीहरूले भनून्।","poem":2},{"text":"अगिका कुराहरू के थिए, हामीलाई भन,","poem":1},{"text":"र हामी तिनीहरूमाथि विचार गरौँ;","poem":2},{"lineBreak":true},{"text":"अनि तिनीहरूका अन्तिम नतिजा जान्‍न सकौँ।","poem":2},{"text":"अथवा भविष्यमा हुने कुराहरू घोषणा गर;","poem":1}]},{"type":"verse","number":23,"content":[{"text":"भविष्यमा के हुने हो, हामीलाई भन,","poem":2},{"lineBreak":true},{"text":"र तिमीहरू देवताहरू हौ भनी हामी जान्‍न सकौँ।","poem":2},{"text":"असल वा खराब केही गर","poem":1},{"text":"ताकि हामी चकित भएर डराउनु परोस्।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"तर तिमीहरू त केही होइनौ,","poem":1},{"text":"र तिमीहरूका कामहरू पूर्ण व्यर्थ छन्;","poem":2},{"lineBreak":true},{"text":"तिमीहरूलाई छान्‍नेहरू घृणित हुन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“मैले उत्तरबाट एक जनालाई सुर्‍याएको छु; अनि त्यो आउँछ,","poem":1},{"text":"घाम उदाउने दिशाबाट, जसले मेरो नामको पुकार गर्छ।","poem":2},{"text":"त्यसले शासकहरूलाई यसरी कुल्चनेछ,","poem":1},{"text":"जसरी कुमालेले माटो कुल्चन्छ।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"यस विषयमा सुरुदेखि कसले भन्यो र हामी जान्‍न सकौँ,","poem":1},{"text":"अथवा पहिले नै बताएको छ र हामी ‘त्यो ठिक छ’ भन्‍न सकौँ?","poem":2},{"text":"यसबारे कसैले भनेनन्,","poem":1},{"text":"कसैले कहिल्यै भनेनन्;","poem":2},{"lineBreak":true},{"text":"तिमीहरूबाट कसैले केही कुरा सुनेनन्।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"सियोनलाई, ‘हेर, तिनीहरू यहाँ छन्!’ भन्‍ने म नै पहिलो हुँ।","poem":1},{"text":"यरूशलेमलाई शुभ समाचार दिने दूत म नै हुँ।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"म हेर्छु, तर कोही छैन;","poem":1},{"text":"तिनीहरूमा सल्‍लाह दिने कोही पनि छैन;","poem":2},{"lineBreak":true},{"text":"मैले तिनीहरूलाई प्रश्न गर्दा जवाफ दिने कोही पनि छैन।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"हेर, तिनीहरू सबै झूटा हुन्!","poem":1},{"text":"तिनीहरूका काम व्यर्थैका हुन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूका मूर्तिहरू हावा र व्यर्थका मात्र हुन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}