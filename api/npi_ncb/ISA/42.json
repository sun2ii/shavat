{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["याहवेहको सेवक"]},{"type":"verse","number":1,"content":[{"text":"“हेर मेरो सेवक, जसलाई म सम्हाल्दछु,","poem":1},{"text":"मैले चुनेको जन, जसमा म प्रसन्‍न छु;","poem":2},{"text":"म तिनमा मेरो आत्मा हाल्नेछु,","poem":1},{"text":"र तिनले जाति-जातिहरूबीच न्याय ल्याउनेछन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तिनी चिच्याउने वा जोरले कराउने छैनन्,","poem":1},{"text":"न त आफ्नो सोर सडकतिर सुनाउनेछन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"फुटेको निगालोलाई तिनले भाँच्नेछैनन्,","poem":1},{"text":"र निभ्न लागेको सलेदोलाई तिनले फुकिदिनेछैनन्।","poem":2},{"text":"तिनले विश्‍वासयोग्यतामा न्याय गर्नेछन्;","poem":1}]},{"type":"verse","number":4,"content":[{"text":"जबसम्म तिनले पृथ्वीमा न्याय स्थापित गर्नेछैनन्;","poem":2},{"text":"तिनी कमजोर हुने निरुत्साहित हुनेछैनन्।","poem":1},{"text":"तिनको व्यवस्थामा टापुहरूले समेत आफ्नो आशा राख्नेछन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"याहवेह परमेश्‍वर यसो भन्‍नुहुन्छ:","poem":1},{"lineBreak":true},{"text":"जसले आकाशहरू सृष्‍टि गरेर तिनलाई फैलाउनुभयो,","poem":1},{"text":"जसले पृथ्वी र त्यसबाट आउने सबैलाई फिँजाउनुभयो,","poem":2},{"lineBreak":true},{"text":"जसले यसका मानिसहरूलाई सास","poem":2},{"lineBreak":true},{"text":"र त्यसमा हिँड्नेहरूलाई जीवन दिनुहुन्छ:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“म याहवेहले नै तँलाई धार्मिकतामा बोलाएको छु,","poem":1},{"text":"म तेरो हात पक्रनेछु।","poem":2},{"text":"म तेरो रक्षा गर्नेछु;","poem":1},{"text":"अनि तँलाई जाति-जातिहरूका निम्ति करार","poem":2},{"lineBreak":true},{"text":"र गैरयहूदीहरूका निम्ति ज्योति बनाउनेछु;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तब तैँले अन्धाहरूका आँखा खोल्न,","poem":1},{"text":"कैदीहरूलाई कैदबाट छुटकारा दिन","poem":2},{"lineBreak":true},{"text":"र अन्धकारको खाडलमा बस्‍नेहरूलाई निकाल्न सक्नेछस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“म नै याहवेह हुँ; मेरो नाम त्यही हो!","poem":1},{"text":"म मेरो महिमा अर्कोलाई दिनेछैनँ,","poem":2},{"lineBreak":true},{"text":"न त मेरो प्रशंसा मूर्तिहरूलाई दिनेछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हेर, पहिलेका कुराहरू बितिसके,","poem":1},{"text":"अब नयाँ कुराहरू म घोषणा गर्छु;","poem":2},{"text":"तिनीहरू आउनुभन्दा पहिल्यै","poem":1},{"text":"म ती तिमीहरूलाई बताउँछु।”","poem":2}]},{"type":"heading","content":["याहवेहलाई प्रशंसाको गीत"]},{"type":"verse","number":10,"content":[{"text":"याहवेहको लागि एउटा नयाँ गीत गाओ,","poem":1},{"text":"र पृथ्वीको छेउबाट उहाँको प्रशंसा गर;","poem":2},{"text":"हे समुद्र यात्रा गर्नेहरू, र त्यसमा भएका सबै थोक,","poem":1},{"text":"टापुहरू र तिनका सबै बासिन्दा हो।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"मरुभूमि र त्यसका नगरहरूले आफ्ना सोर उचालून्;","poem":1},{"text":"केदारमा बसेका बस्तीहरू आनन्दित होऊन्।","poem":2},{"text":"सेलाका मानिसहरू आनन्दले गाऊन्;","poem":1},{"text":"तिनीहरू पर्वतका टाकुराहरूबाट चिच्याऊन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तिनीहरूले याहवेहलाई महिमा देऊन्,","poem":1},{"text":"र टापुहरूमा उहाँको प्रशंसा घोषणा गरून्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"याहवेह पराक्रमी मानिसझैँ अगि बढ्नुहुनेछ;","poem":1},{"text":"योद्धाझैँ उहाँले आफ्नो जोश देखाउनुहुनेछ;","poem":2},{"text":"चर्को सोरले उहाँले युद्ध-ध्वनि निकाल्नुहुनेछ;","poem":1},{"text":"अनि उहाँले आफ्ना शत्रुहरूमाथि विजय पाउनुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“धेरै समयसम्म म चुप रहेँ,","poem":1},{"text":"म शान्त भएर आफूलाई रोकिराखेँ।","poem":2},{"text":"तर अब, प्रसव वेदना लागेकी स्त्रीझैँ म चिच्याउँछु;","poem":1},{"text":"म स्वाँ-स्वाँ गर्छु र छिटो-छिटो सास फेर्छु।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"म पर्वतहरू र डाँडाहरूलाई उजाड पारिदिनेछु,","poem":1},{"text":"र तिनका सबै वनस्पतिहरूलाई सुकाइदिनेछु;","poem":2},{"text":"म नदीहरूलाई टापुहरूमा परिणत गरिदिनेछु;","poem":1},{"text":"अनि पोखरीहरू सुकाइदिनेछु।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"म अन्धाहरूलाई तिनीहरूले नजानेका बाटोहरूमा डोर्‍याउनेछु;","poem":1},{"text":"नचिनेका बाटोहरूमा म तिनीहरूलाई डोर्‍याउनेछु;","poem":2},{"text":"म तिनीहरूको सामु अन्धकारलाई उज्यालोमा परिणत गरिदिनेछु;","poem":1},{"text":"अनि खाल्टाखुल्टी ठाउँहरूलाई समतल बनाउनेछु।","poem":2},{"text":"म यी कुराहरू गर्नेछु;","poem":1},{"text":"म तिनीहरूलाई त्याग्नेछैनँ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तर मूर्तिहरूमाथि भरोसा राख्नेहरू,","poem":1},{"text":"जसले मूर्तिहरूलाई ‘तपाईंहरू हाम्रा ईश्‍वर हुनुहुन्छ’ भनेर भन्छन्,","poem":2},{"lineBreak":true},{"text":"तिनीहरू अन्त्यमा शर्ममा पारिनेछन्।","poem":2}]},{"type":"heading","content":["अन्धा र बहिरा इस्राएल"]},{"type":"verse","number":18,"content":[{"text":"“हे बहिराहरू हो, सुन;","poem":1},{"text":"हे अन्धाहरू हो, हेर र देख!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"मेरो सेवकबाहेक अरू को अन्धो छ?","poem":1},{"text":"मैले पठाएको दूतझैँ अरू को बहिरो छ?","poem":2},{"text":"मसँग करारमा बाँधिएको व्यक्तिझैँ अन्धो को छ?","poem":1},{"text":"याहवेहको सेवकझैँ अन्धो को छ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तिमीहरूले धेरै कुरा देखेका छौ, तर त्यसमा ध्यान दिएका छैनौ;","poem":1},{"text":"तिमीहरूका कान खुल्‍ला छन्, तर तिमीहरू केही सुन्दैनौ।”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"आफ्ना धार्मिकताको खातिर","poem":1},{"text":"उहाँको व्यवस्था महान् र महिमित बनाउन","poem":2},{"lineBreak":true},{"text":"याहवेहलाई प्रसन्‍न लाग्यो।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तर यो जाति खोसिएको र लुटिएको छ;","poem":1},{"text":"ती सबै खाडलमा परेका छन्,","poem":2},{"lineBreak":true},{"text":"अथवा झ्यालखानामा लुकाइएका छन्।","poem":2},{"text":"कसैले छुटाउन नसक्ने गरी","poem":1},{"text":"तिनीहरू लुटिएका छन्;","poem":2},{"text":"तिनीहरू लुट बनाइएका छन्,","poem":1},{"text":"कसैले पनि ती फर्काओ भन्दैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"तिमीहरूबीच कसले यो सुन्‍नेछौ,","poem":1},{"text":"अथवा आउने समयमा ध्यान दिनेछौ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"कसले याकोबलाई लुटिन दियो,","poem":1},{"text":"र इस्राएललाई कसले खोसिन दियो?","poem":2},{"text":"के याहवेहले नै होइन?","poem":1},{"text":"जसका विरुद्ध हामीले पाप गरेका छौँ?","poem":2},{"text":"किनकि तिनीहरू उहाँका मार्गमा हिँडेनन्;","poem":1},{"text":"तिनीहरूले उहाँको व्यवस्था पालन गरेनन्।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"यसकारण उहाँले तिनीहरूमाथि आफ्नो बल्दो रिस खन्याइदिनुभयो,","poem":1},{"text":"र युद्धको प्रचण्डता पोखाउनुभयो।","poem":2},{"text":"त्यसले तिनीहरूलाई ज्वालामा लपेट्यो,","poem":1},{"text":"तर पनि तिनीहरूले बुझेनन्;","poem":2},{"text":"त्यसले तिनीहरूलाई भस्म पारिदियो,","poem":1},{"text":"तर पनि तिनीहरूले त्यो कुरा मतलब राखेनन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}