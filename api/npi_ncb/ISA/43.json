{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["इस्राएलका एक मात्र मुक्तिदाता"]},{"type":"verse","number":1,"content":[{"text":"तर अब, हे याकोब, तँलाई रच्नुहुने,","poem":1},{"text":"हे इस्राएल, तँलाई सृष्‍टि गर्नुहुने,","poem":2},{"lineBreak":true},{"text":"याहवेह यसो भन्‍नुहुन्छः","poem":2},{"text":"“नडरा, किनकि मैले तँलाई मोल तिरेर छुटाएको छु;","poem":1},{"text":"मैले तँलाई नाम काढेर बोलाएको छु; तँ मेरै होस्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तँ पानीबाट भएर जाँदा","poem":1},{"text":"म तँसित हुनेछु;","poem":2},{"text":"अनि तँ नदीहरूबाट भएर जाँदा","poem":1},{"text":"तिनले तँलाई बगाउनेछैनन्।","poem":2},{"text":"तँ आगोबाट हिँडेर जाँदा","poem":1},{"text":"तँ जल्नेछैनस्;","poem":2},{"lineBreak":true},{"text":"त्यसको ज्वालाले तँलाई भस्म पार्नेछैन।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"किनकि म याहवेह नै तेरा परमेश्‍वर हुँ;","poem":1},{"text":"इस्राएलका पवित्र परमेश्‍वर, तेरा उद्धारकर्ता हुनुहुन्छ।","poem":2},{"text":"तेरो छुटकाराको मोलको निम्ति मैले इजिप्ट दिएको छु;","poem":1},{"text":"तेरो सट्टामा कूश र सेबा दिएँ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मेरो दृष्‍टिमा तँ बहुमूल्य र आदरणीय छस्;","poem":1},{"text":"अनि मैले तँलाई प्रेम गरेको कारणले","poem":2},{"text":"म मानिसहरूलाई तेरो सट्टामा र राष्ट्रहरूलाई","poem":1},{"text":"तेरो जीवनको सट्टामा दिनेछु।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"नडरा, किनकि म तँसित छु;","poem":1},{"text":"म तेरा सन्तानहरूलाई पूर्वबाट ल्याउनेछु,","poem":2},{"lineBreak":true},{"text":"र तँलाई पश्‍चिमबाट भेला गराउनेछु।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"म उत्तरलाई भन्‍नेछु, ‘तिनीहरू मलाई दिइहाल्!’","poem":1},{"text":"र दक्षिणलाई भन्‍नेछु, ‘तिनीहरूलाई नरोक्।’","poem":2},{"text":"मेरा छोराहरूलाई टाढा-टाढाबाट ल्याओ;","poem":1},{"text":"अनि मेरा छोरीहरूलाई पृथ्वीको छेउ-छेउबाट ल्याओ;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मेरो नामले बोलाइएको हरेकलाई,","poem":1},{"text":"जसलाई मैले आफ्नो महिमाको निम्ति सृष्‍टि गरेँ,","poem":2},{"lineBreak":true},{"text":"जसलाई मैले नै रचेँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"आँखा भएर अन्धा र कान भएर पनि","poem":1},{"text":"बहिरा हुनेहरूलाई डोर्‍याएर निकाल।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"सबै जातिहरू एकसाथ जम्मा होऊन्;","poem":1},{"text":"अनि मानिसहरू भेला होऊन्।","poem":2},{"text":"तिनीहरूमध्ये कसले यो अगिबाटै बतायो;","poem":1},{"text":"अनि अगिका कुराहरूको हामीलाई घोषणा गर्‍यो?","poem":2},{"text":"तिनीहरू ठिक हुन् भनेर प्रमाणित गर्न तिनीहरूले साक्षीहरू ल्याऊन्,","poem":1},{"text":"ताकि अरूले सुनून् र “यो साँचो हो” भनून्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“तिमीहरू मेरा साक्षी हौ; याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"text":"मैले चुनेको मेरा सेवक,","poem":2},{"text":"ताकि म उही हुँ भनी तिमीहरूले जान्‍न सक;","poem":1},{"text":"अनि मलाई विश्‍वास गर्न र बुझ्न सक।","poem":2},{"text":"मभन्दा पहिले कुनै ईश्‍वर रचिएको थिएन,","poem":1},{"text":"न त मपछि कोही हुनेछ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"म हुँ, म नै याहवेह हुँ।","poem":1},{"text":"मबाहेक अरू कुनै उद्धारकर्ता छैन।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मैले प्रकट गरेको छु, बचाएको छु र घोषणा गरेको छु—","poem":1},{"text":"तिमीहरूबीच भएको कुनै परदेशी देवताले होइन।","poem":2},{"text":"मेरा साक्षी तिमीहरू नै हौ,” भनी याहवेह घोषणा गर्नुहुन्छ, कि, “म नै परमेश्‍वर हुँ,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"हो, प्राचीनकालदेखि म उही हुँ।","poem":2},{"text":"मेरो हातबाट कसैले छुटाउन सक्दैन।","poem":1},{"text":"जब म काम गर्छु, कसले त्यसलाई उल्टाउन सक्छ?”","poem":2}]},{"type":"heading","content":["परमेश्‍वरको कृपा र इस्राएलको अविश्‍वास"]},{"type":"verse","number":14,"content":[{"text":"याहवेह, तिमीहरूका उद्धारक,","poem":1},{"text":"इस्राएलका पवित्र परमेश्‍वर भन्‍नुहुन्छ—","poem":2},{"text":"“तिमीहरूको खातिर म बेबिलोनमा मानिसहरू पठाउनेछु;","poem":1},{"text":"अनि सबै बेबिलोनीहरूलाई तिनीहरूले गर्व गरेका जहाजहरूमा","poem":2},{"lineBreak":true},{"text":"शरणार्थीहरूलाई झैँ ल्याउनेछु।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"म नै याहवेह, तिमीहरूका पवित्र परमेश्‍वर,","poem":1},{"text":"इस्राएलका सृष्‍टिकर्ता, तिमीहरूका राजा हुँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"याहवेह यसो भन्‍नुहुन्छ,","poem":1},{"text":"जो समुद्रबाट बाटो बनाउनुहुने,","poem":2},{"lineBreak":true},{"text":"शक्तिशाली सागरमा मार्ग बनाउनुहुने,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"रथ र घोडाहरू,","poem":1},{"text":"सेना र थप सेनालाई एकैसाथ निकाल्नुहुने,","poem":2},{"text":"तिनीहरू, जो फेरि उठ्न नसक्ने गरी लोटेका थिए;","poem":1},{"text":"सलेदो निभाइएझैँ निभाइएका थिए:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“पहिलेका कुराहरू नसम्झ,","poem":1},{"text":"बितेका कुराहरूमा नअल्झ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"हेर, म एउटा नयाँ काम गर्दैछु!","poem":1},{"text":"अहिले नै यो प्रष्‍ट हुन्छ; के तिमीहरू यसलाई देख्दैनौ?","poem":2},{"text":"म मरुभूमिमा एउटा बाटो","poem":1},{"text":"र उजाडभूमिमा खोलाहरू बनाउँदैछु।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"जङ्गली जनावरहरू, स्यालहरू","poem":1},{"text":"र उल्‍लुहरूले मलाई आदर गर्छन्;","poem":2},{"text":"किनकि म आफ्नो चुनिएको जातिलाई पिउनका निम्ति","poem":1},{"text":"मरुभूमिमा पानी","poem":2},{"text":"र उजाडस्थानमा खोलाहरू प्रबन्ध गर्छु।","poem":1}]},{"type":"verse","number":21,"content":[{"text":"मैले आफ्नै निम्ति रचेको जातिको निम्ति,","poem":2},{"lineBreak":true},{"text":"ताकि तिनीहरूले मेरो प्रशंसा घोषणा गरून्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“तापनि हे याकोब, तैँले मलाई पुकार गरेको छैनस्;","poem":1},{"text":"हे इस्राएल, तैँले मेरो निम्ति आफैँलाई थकित पारेको छैनस्।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तैँले मेरो निम्ति होमबलिको भेडा ल्याएको छैनस्,","poem":1},{"text":"न त आफ्ना बलिदानहरूद्वारा मेरो आदर नै गरेको छस्।","poem":2},{"text":"मैले तँलाई अन्‍नबलिको बोझ बोकाएको छैनँ,","poem":1},{"text":"न त धूपको माग गरेर तँलाई थकित पारेको छु।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"तैँले मेरा निम्ति बास्‍ना आउने बोझो ल्याएको छैनस्,","poem":1},{"text":"न त बलिदानका बोसोहरूमा धेरै खर्च गरेको छस्।","poem":2},{"text":"तर तैँले मलाई आफ्ना पाप बोकाएको छस्;","poem":1},{"text":"अनि तेरा अपराधहरूले मलाई थकित पारेको छस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“म उही हुँ,","poem":1},{"text":"जसले आफ्नै खातिर तेरा अधर्महरू मेटिदिन्छु,","poem":2},{"lineBreak":true},{"text":"र तेरा पापहरू कहिल्यै स्मरण गर्नेछैनँ।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"मेरो निम्ति पहिलेका कुरा विचार गर्,","poem":1},{"text":"हामी आपसमा यस विषयमा तर्क गरौँ;","poem":2},{"lineBreak":true},{"text":"तेरो निर्दोषताको मुद्दा बता।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"पहिलेका तेरो पुर्खाले पाप गरे;","poem":1},{"text":"तेरा प्रवक्ताहरूले मेरो विद्रोह गरे।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"यसकारण म तेरो मन्दिरका उच्‍च शासकहरूलाई अपमान गर्नेछु;","poem":1},{"text":"अनि याकोबलाई नाशको निम्ति","poem":2},{"lineBreak":true},{"text":"र इस्राएललाई गिल्‍लाहका निम्ति सुम्पिदिनेछु।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}