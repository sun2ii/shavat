{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"“याहवेह आफ्नो अभिषिक्त जन कोरेसलाई यसो भन्‍नुहुन्छ,","poem":1},{"text":"मैले त्यसको दाहिने हात थामेको छु,","poem":2},{"text":"त्यसको सामु जातिहरूलाई पराजित गर्न;","poem":1},{"text":"अनि राजाहरूको हतियार खोस्‍न,","poem":2},{"text":"मूलढोकाहरू बन्द नहोस् भनेर","poem":1},{"text":"त्यसको सामु ढोकाहरू खोलिदिन:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"म तेरो अगि-अगि जानेछु,","poem":1},{"text":"र पर्वतहरूलाई समतल पारिदिनेछु;","poem":2},{"text":"म काँसाका मूलढोकाहरू भत्काइदिनेछु;","poem":1},{"text":"अनि फलामका बारहरू म काटिदिनेछु।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"म नै याहवेह हुँ, म नै इस्राएलका परमेश्‍वर हुँ;","poem":1},{"text":"मैले नै तँलाई तेरो नाम काढेर बोलाएको छु भनेर तैँले थाहा पाउनलाई","poem":2},{"text":"म तँलाई अँध्यारो ठाउँमा भएको भण्डार","poem":1},{"text":"र गुप्‍त स्थानमा जम्मा गरेका धन दिनेछु।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मेरो सेवक याकोब,","poem":1},{"text":"र मैले चुनेको इस्राएलको खातिर","poem":2},{"text":"तैँले मलाई स्वीकार नगरे तापनि","poem":1},{"text":"मैले तँलाई नाम काढेर बोलाएको छु;","poem":2},{"lineBreak":true},{"text":"र तँलाई सम्मानको उपाधी प्रदान गरेको छु।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"म नै याहवेह हुँ, र मबाहेक अरू कुनै परमेश्‍वर छैन;","poem":1},{"text":"मबाहेक अरू कोही परमेश्‍वर छैन।","poem":2},{"text":"तैँले मलाई स्वीकार नगरेको भए तापनि","poem":1},{"text":"म तँलाई बलियो पार्नेछु,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ताकि सूर्योदयदेखि सूर्यास्तसम्म","poem":1},{"text":"मानिसहरूले जानून् कि","poem":2},{"text":"मबाहेक अरू कोही छैन।","poem":1},{"text":"म नै याहवेह हुँ, र मबाहेक अरू कोही छैन।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म ज्योति र अन्धकार सृष्‍टि गर्दछु;","poem":1},{"text":"म सुख-शान्ति ल्याउँछु, र विपत्ति सृष्‍टि गर्छु;","poem":2},{"lineBreak":true},{"text":"यी सबै कुराहरू गर्ने म याहवेह नै हुँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“हे आकाश हो, माथिबाट धार्मिकताको वृष्‍टि खन्या;","poem":1},{"text":"बादलहरूले त्यो बर्साओस्;","poem":2},{"text":"पृथ्वी चौडा गरी उघारिओस्,","poem":1},{"text":"र उद्धार उम्रेर आओस्;","poem":2},{"text":"त्यससित धार्मिकता बढोस्;","poem":1},{"text":"म याहवेहले नै यसलाई सृष्‍टि गरेको हुँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“धिक्‍कार त्यसलाई, जसले आफ्नो सृष्‍टिकर्तासित झगडा गर्छ!","poem":1},{"text":"त्यो पनि भुइँमा भएका","poem":2},{"lineBreak":true},{"text":"माटोका खपटाहरूमध्ये एउटा खपटा मात्र हो।","poem":2},{"text":"के माटोले कुमालेलाई","poem":1},{"text":"‘तैँले के बनाउँदैछस्’ भनी सोध्छ?","poem":2},{"text":"के तेरो कामले","poem":1},{"text":"‘त्यसको हातै छैन’ भनी भन्छ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"धिक्‍कार त्यसलाई, जसले आफ्नो बुबालाई","poem":1},{"text":"‘तपाईंले कस्तो सन्तान जन्माउनुभयो?’ भनी भन्छ,","poem":2},{"text":"अथवा आमालाई,","poem":1},{"text":"‘तपाईंले के जन्माउनुभयो?’ भनी भन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“आउने कुराहरूका विषयमा इस्राएलका पवित्र परमेश्‍वर,","poem":1},{"text":"त्यसलाई बनाउनुहुने याहवेह भन्‍नुहुन्छ—","poem":2},{"text":"के मेरो सन्तानको विषयमा","poem":1},{"text":"तँ मलाई प्रश्न गर्छस्,","poem":2},{"lineBreak":true},{"text":"अथवा मेरा हातका कामहरूको विषयमा मलाई आज्ञा दिन्छस्?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"पृथ्वी बनाउने र","poem":1},{"text":"त्यसमा मानिसहरूलाई सृष्‍टि गर्ने म नै हुँ।","poem":2},{"text":"मेरा आफ्नै हातहरूले आकाश फिँजाएँ;","poem":1},{"text":"त्यसमा भएका तारामण्डललाई मैले ठिकसँग मिलाएर राखेको हुँ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"म कोरेसलाई मेरो धार्मिकतामा उचाल्नेछु;","poem":1},{"text":"म त्यसका मार्गहरू सोझा बनाइदिनेछु;","poem":2},{"text":"त्यसले मेरो सहर पुनर्निर्माण गर्नेछ;","poem":1},{"text":"अनि देश निकाला भएका मेरा मानिसहरूलाई मुक्त गर्नेछ,","poem":2},{"text":"तर कुनै मूल्य र पुरस्कारको लागि होइन,","poem":1},{"text":"सेनाहरूका याहवेह भन्‍नुहुन्छ।”","poem":2}]},{"type":"verse","number":14,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“इजिप्टको उब्जनी र कूशको व्यापारको धन","poem":1},{"text":"र ठूला कद भएका","poem":2},{"text":"सेबाका मानिसहरू तँकहाँ आउनेछन्,","poem":1},{"text":"र ती तेरा हुनेछन्;","poem":2},{"text":"तिनीहरू साङ्लाले बाँधिएर कष्‍टसाथ तेरो पछि-पछि आउनेछन्।","poem":1},{"text":"तिनीहरू तेरो सामु झुक्नेछन् र बिन्ती गर्दै यसो भन्‍नेछन्ः","poem":2},{"text":"‘निश्‍चय परमेश्‍वर तपाईंसित हुनुहुन्छ, र अरू कोही पनि छैन;","poem":1},{"text":"अर्को ईश्‍वर छँदैछैन।’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"हे इस्राएलका परमेश्‍वर र उद्धारकर्ता,","poem":1},{"text":"साँच्‍चै तपाईं आफूलाई अदृश्य पार्नुहुने परमेश्‍वर हुनुहुन्छ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"मूर्ति बनाउने सबै जना शर्ममा पर्नेछन् र अपमानित हुनेछन्;","poem":1},{"text":"तिनीहरू एकसाथ अपमानित भएर जानेछन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तर इस्राएल अनन्तको उद्धारसित","poem":1},{"text":"याहवेहद्वारा बचाइनेछ;","poem":2},{"text":"तँ कहिल्यै शर्ममा पर्नेछैनस्,","poem":1},{"text":"अथवा युग-युगसम्म अपमानित हुनेछैनस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"किनकि याहवेह भन्‍नुहुन्छ—","poem":1},{"lineBreak":true},{"text":"जसले स्वर्ग सृजनुभयो,","poem":1},{"text":"उहाँ परमेश्‍वर हुनुहुन्छ;","poem":2},{"text":"उहाँ, जसले पृथ्वीलाई आकार दिएर बनाउनुभयो;","poem":1},{"text":"उहाँले त्यसलाई स्थापित गर्नुभयो;","poem":2},{"text":"त्यसलाई रित्तो हुनलाई सृष्‍टि गर्नुभएको होइन,","poem":1},{"text":"तर त्यसलाई बसोबास गराउनको लागि बनाउनुभयो—","poem":2},{"text":"उहाँ भन्‍नुहुन्छ: “म नै याहवेह हुँ,","poem":1},{"text":"मबाहेक अर्को कोही परमेश्‍वर छैन।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"मैले गुप्‍तमा वा कुनै अन्धकारको","poem":1},{"text":"ठाउँबाट बोलेको छैनँ;","poem":2},{"text":"मैले याकोबका सन्तानलाई","poem":1},{"text":"‘मलाई व्यर्थमा खोज्’ भनेको छैनँ।","poem":2},{"text":"म याहवेह सत्य बोल्छु;","poem":1},{"text":"जे ठिक छ, त्यही घोषणा गर्छु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“एकसाथ भेला भएर आओ;","poem":1},{"text":"हे जाति-जातिका शरणार्थीहरू हो, भेला होओ।","poem":2},{"text":"काठका मूर्तिहरू बोकिहिँड्नेहरू सबै अज्ञानी हुन्,","poem":1},{"text":"जसले बचाउन नसक्ने देवताहरूसित प्रार्थना गर्दछन्।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"अब के हुनेछ, घोषणा गर्, त्यसलाई प्रस्तुत गर्—","poem":1},{"text":"तिनीहरूले एकसाथ सल्‍लाह लिऊन्।","poem":2},{"text":"कसले यो धेरै पहिले बतायो,","poem":1},{"text":"कसले यो धेरै पहिले नै घोषणा गर्‍यो?","poem":2},{"text":"के म याहवेहले नै होइन?","poem":1},{"text":"मबाहेक अरू कोही परमेश्‍वर छैन;","poem":2},{"text":"धर्मी र उद्धारकर्ता","poem":1},{"text":"परमेश्‍वर म नै हुँ; मबाहेक अरू परमेश्‍वर कोही छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“मकहाँ फर्क र बाँच,","poem":1},{"text":"हे पृथ्वीका पल्‍लो छेउका मानिसहरू हो;","poem":2},{"lineBreak":true},{"text":"किनकि परमेश्‍वर म नै हुँ, र अरू कोही पनि छैन।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"मैले आफ्नै शपथ खाएको छु;","poem":1},{"text":"मेरो मुखले सम्पूर्ण इमानदारीमा रद्द नहुने","poem":2},{"lineBreak":true},{"text":"हरेक कुरा उच्‍चारण गरेको छु;","poem":2},{"text":"मेरो सामु हरेक घुँडा टेकिनेछ,","poem":1},{"text":"र हरेक जिब्रोले शपथ खानेछ।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"तिनीहरूले मेरो विषयमा यसो भन्‍नेछन्,","poem":1},{"text":"‘याहवेहमा मात्र धार्मिकता र शक्ति छ।’ ”","poem":2},{"text":"उहाँको विरुद्धमा रिस गर्नेहरू सबै उहाँकहाँ नै आउनेछन्,","poem":1},{"text":"र शर्ममा पर्नेछन्।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तर याहवेहमा इस्राएलका","poem":1},{"text":"सबै सन्तानहरू धार्मिक भेट्टाइनेछन्,","poem":2},{"lineBreak":true},{"text":"र उहाँमा गर्व गर्नेछन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}