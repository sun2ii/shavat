{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["बेबिलोनको पतन"]},{"type":"verse","number":1,"content":[{"text":"“हे बेबिलोनकी कन्ये छोरी,","poem":1},{"text":"तल गएर धुलोमा बस्;","poem":2},{"text":"बेबिलोनीहरूकी छोरी,","poem":1},{"text":"सिंहासनविना नै भुइँमा बस्।","poem":2},{"text":"अब उसो तँ कलिलो र कोमल भनिनेछैनस्।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"जाँतो लिएर पिठो पिँध्;","poem":1},{"text":"आफ्नो घुम्टो निकाल्।","poem":2},{"text":"तेरो फरिया माथि सार्,","poem":1},{"text":"नाङ्गो जाँघ नछोपी खोलाहरू तर्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तेरो नग्नता उघारिनेछ,","poem":1},{"text":"र तेरो लाज प्रकट हुनेछ।","poem":2},{"text":"म बदला लिनेछु;","poem":1},{"text":"एउटैलाई पनि म बाँकी छोड्नेछैनँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हाम्रा उद्धारकको नाम सेनाहरूका याहवेह हो।","poem":1},{"text":"उहाँ इस्राएलका पवित्र परमेश्‍वर हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“बेबिलोनीहरूकी छोरी,","poem":1},{"text":"चुपचाप बस्, अन्धकारभित्र जा;","poem":2},{"text":"अब उसो तँलाई","poem":1},{"text":"राज्यहरूकी रानी भनिनेछैन।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"म आफ्ना मानिसहरूसित रिसाएको थिएँ,","poem":1},{"text":"र मैले आफ्नो उत्तराधिकारलाई अशुद्ध तुल्याएँ;","poem":2},{"text":"मैले तिनीहरूलाई तेरो हातमा दिएँ,","poem":1},{"text":"तर तैँले तिनीहरूलाई दया देखाइनस्;","poem":2},{"text":"वृद्धहरूमाथि पनि तैँले","poem":1},{"text":"गह्रौँ जुवा लादिदिइस्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तैँले, ‘म सदाको निम्ति","poem":1},{"text":"अनन्तकी रानी भइरहनेछु’ भनिस्;","poem":2},{"text":"तर तैँले यी कुराहरू विचार गरिनस्,","poem":1},{"text":"अथवा के होला भनी ध्यान दिइनस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“आफ्नो सुरक्षामा आराम गरिरहने","poem":1},{"text":"र आफूलाई, ‘म नै हुँ,","poem":2},{"text":"मबाहेक अरू कोही पनि छैन।","poem":1},{"text":"म कहिल्यै विधवा हुनेछैनँ,","poem":2},{"text":"न त छोराछोरी नै गुमाउनेछु’ भनी ठान्‍ने","poem":1},{"text":"हे विलासी, अब सुन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यी दुवै कुराहरू, छोराछोरीको वियोग","poem":1},{"text":"र विधवापन एकै दिनमा तँमाथि आइपर्नेछ।","poem":2},{"lineBreak":true},{"text":"तेरा धेरै तन्त्रमन्त्रहरू","poem":2},{"text":"र सबै शक्तिशाली टुनामुनाहरू हुँदा-हुँदै पनि","poem":1},{"text":"ती तँमाथि पूर्ण रूपले आइपर्नेछन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तैँले आफ्नो दुष्‍टतामाथि भरोसा राखेकी छेस्,","poem":1},{"text":"र ‘मलाई कसैले देख्नेछैन’ भनेकी छेस्।","poem":2},{"text":"तैँले आफूलाई, ‘म नै हुँ,","poem":1},{"text":"र मबाहेक अरू कोही पनि छैन’ भनेकी छेस्;","poem":2},{"lineBreak":true},{"text":"तेरो बुद्धि र ज्ञानले तँलाई कुबाटोमा लगेको छ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"विपत्ति तँमाथि आइपर्नेछ;","poem":1},{"text":"त्यसलाई तैँले हटाउन जान्‍नेछैनस्।","poem":2},{"text":"प्रकोप तँमाथि आउनेछ,","poem":1},{"text":"जसलाई तैँले मोल तिरेर पनि भगाउन सक्दिनस्;","poem":2},{"text":"तैँले पहिलेबाटै देख्न नसकेको प्रलय","poem":1},{"text":"तँमाथि अचानक आइपर्नेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“तैँले बाल्यकालदेखि","poem":1},{"text":"परिश्रम गर्दैआएको टुनामुना","poem":2},{"lineBreak":true},{"text":"र तेरा धेरै तन्त्रमन्त्रमा नै लागिबस्।","poem":2},{"text":"सायद तँ सफल हुनेछेस्,","poem":1},{"text":"सायद तैँले आतङ्कित पार्न सक्छेस् कि!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तैँले सुनेका सबै सल्‍लाहहरूले तँलाई खिन्‍न मात्र पारेको छ!","poem":1},{"text":"तेरा ज्योतिषीहरू अगि आऊन्;","poem":2},{"text":"ती तारा हेर्नेहरू, जसले महिनैपिच्छे भविष्यका कुरा भन्छन्,","poem":1},{"text":"तिनीहरूले तँमाथि आउन लागेको कुराहरूबाट तँलाई बचाऊन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तिनीहरू निश्‍चय नै ठुटाझैँ हुन्;","poem":1},{"text":"आगोले तिनीहरूलाई जलाइदिनेछ।","poem":2},{"text":"तिनीहरूले आफूलाई","poem":1},{"text":"ज्वालाको शक्तिबाट बचाउनसमेत सक्दैनन्।","poem":2},{"text":"यो कसैलाई न्यानो पार्ने कोइला होइन;","poem":1},{"text":"न त नजिक बस्‍ने आगो नै हो।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तिनीहरूले तँलाई गर्न सक्ने यति नै हो—","poem":1},{"text":"तिनीहरू जोसित तैँले परिश्रम गरिस्","poem":2},{"lineBreak":true},{"text":"र तेरो बाल्यकालदेखि नै कारोबार गरिस्।","poem":2},{"text":"तिनीहरू हरेक आफ्नै गल्तीमा लागि बस्छन्;","poem":1},{"text":"तँलाई बचाउन सक्ने कोही पनि हुनेछैन।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}