{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["दाखबारीको गीत"]},{"type":"verse","number":1,"content":[{"text":"अब म मेरो प्रियको निम्ति","poem":1},{"text":"र उहाँको दाखबारीको निम्ति एउटा गीत गाउनेछु:","poem":2},{"text":"एउटा मलिलो डाँडामा","poem":1},{"text":"मेरा प्रियको एउटा दाखबारी थियो।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"उहाँले त्यसलाई खनेर ढुङ्गाहरू हटाउनुभयो;","poem":1},{"text":"अनि त्यसमा अति उत्तम दाख रोप्नुभयो।","poem":2},{"text":"उहाँले त्यसमा एउटा मचान बनाउनुभयो;","poem":1},{"text":"अनि एउटा कोल पनि खोप्नुभयो।","poem":2},{"text":"तब उहाँले असल दाखको आशा राख्नुभयो,","poem":1},{"text":"तर त्यसले खराब फल फलायो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“अब हे यरूशलेमका बासिन्दा र यहूदाका मानिसहरू हो,","poem":1},{"text":"म र मेरो दाखबारीका बीचमा न्याय गरिदेओ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मेरो दाखबारीका निम्ति मैले जति गरेँ,","poem":1},{"text":"त्योभन्दा बढी के गरिनुपर्नेथियो र?","poem":2},{"text":"मैले असल दाखको आशा गर्दा","poem":1},{"text":"किन त्यसले खराब फल फलायो?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"अब म तिमीहरूलाई भन्‍नेछु,","poem":1},{"text":"कि आफ्नो दाखबारीलाई म के गर्नेछु।","poem":2},{"text":"म त्यसको बार निकालिदिनेछु,","poem":1},{"text":"र त्यो नाश हुनेछ;","poem":2},{"text":"म त्यसको पर्खाल भत्काइदिनेछु,","poem":1},{"text":"र त्यो कुल्चीमिल्ची पारिनेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"म त्यसलाई नछिमलेको र नगोडिएको","poem":1},{"text":"उजाडभूमि बनाइदिनेछु;","poem":2},{"lineBreak":true},{"text":"अनि त्यसमा सिउँडी र काँडाहरू उम्रनेछन्।","poem":2},{"text":"त्यसमा पानी नपरोस् भनेर,","poem":1},{"text":"म बादललाई आज्ञा गर्नेछु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"सेनाहरूका याहवेहको दाखबारी","poem":1},{"text":"इस्राएलको घराना हो,","poem":2},{"text":"र यहूदाका मानिसहरू","poem":1},{"text":"उहाँलाई मनपर्ने बगैँचा हो।","poem":2},{"text":"उहाँले न्यायको आशा गर्नुभयो, तर रक्तपात देख्नुभयो;","poem":1},{"text":"धार्मिकताको आशा गर्नुभयो, तर सङ्कष्‍टको रुवाइ पो सुन्‍नुभयो।","poem":2}]},{"type":"heading","content":["धिक्‍कार र न्याय"]},{"type":"verse","number":8,"content":[{"text":"धिक्‍कार तिमीहरूलाई,","poem":1},{"text":"जसले केही जग्गा नरहने गरी घरमा घर थप्छौ;","poem":2},{"text":"अनि खेतमा खेत जोड्छौ,","poem":1},{"text":"र देशमा आफू मात्र बस्छौ।","poem":2}]},{"type":"verse","number":9,"content":["सेनाहरूका याहवेहले मैले सुन्‍ने गरी घोषणा गर्नुभएको छ:",{"text":"“निश्‍चय नै ठूला घरहरू उजाड हुनेछन्,","poem":1},{"text":"सुन्दर भवनहरू निर्जन हुनेछन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"पाँच बिघा दाखबारीले एक बाथ","poem":1},{"noteId":1},{"text":"दाखरस मात्र दिनेछ;","poem":1},{"text":"एक होमेर","poem":2},{"noteId":2},{"text":"बिउले एक एपा","poem":2},{"noteId":3},{"text":"अन्‍न मात्र दिनेछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"धिक्‍कार तिनीहरूलाई,","poem":1},{"text":"जो मद्यको निम्ति एकाबिहानै उठ्छन्,","poem":2},{"text":"जो मद्यले नमातुन्जेल","poem":1},{"text":"आधा रातसम्म बस्छन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तिनीहरूसित भोजमा वीणा र सारङ्गी,","poem":1},{"text":"खैँजडी, बाँसुरी र मद्य हुन्छन्,","poem":2},{"text":"तर तिनीहरूसित याहवेहका कार्यहरूका निम्ति कुनै श्रद्धा हुँदैन;","poem":1},{"text":"उहाँका हातका कामप्रति कुनै आदर हुँदैन।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"यसकारण समझशक्तिको अभावले गर्दा","poem":1},{"text":"मेरा प्रजा देशबाट निकालिनेछन्;","poem":2},{"text":"तिनीहरूका प्रतिष्‍ठित मानिसहरू भोकले मर्नेछन्;","poem":1},{"text":"अनि तिनीहरूका सर्वसाधारण तिर्खाले सुक्नेछन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"यसकारण चिहानले आफ्नो मुख खोल्छ,","poem":1},{"text":"र आफ्नो मुख ठूलो उघार्छ;","poem":2},{"text":"त्यसभित्र तिनीहरूका कुलीन व्यक्तिहरू र जनसमूह","poem":1},{"text":"तिनीहरूका झगडालु र विलासीहरूसितै पस्‍नेछन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"यसरी मानिस होच्याइनेछ;","poem":1},{"text":"अनि हरेक जन नम्र बनाइनेछ,","poem":2},{"lineBreak":true},{"text":"अभिमानीका आँखा नम्र पारिनेछन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तर सेनाहरूका याहवेह आफ्नो न्यायद्वारा उच्‍च पारिनुहुनेछ,","poem":1},{"text":"पवित्र परमेश्‍वरले आफ्नो धार्मिकताद्वारा आफूलाई पवित्र प्रकट गर्नुहुनेछ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तब भेडाहरू आफ्नै खर्कमा झैँ चर्नेछन्;","poem":1},{"text":"तथा धनीहरूका खाली ठाउँहरूमा परदेशीहरूले खानेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"धिक्‍कार तिनीहरूलाई जसले छलका डोरीहरूले पाप निकाल्छन्;","poem":1},{"text":"अनि गाडाका डोरीहरूले झैँ दुष्‍टता निकाल्छन्,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"जसले यसो भन्छन्, “परमेश्‍वरले हतार गरून्;","poem":1},{"text":"उहाँले आफ्नो काम चाँडो गरून्,","poem":2},{"lineBreak":true},{"text":"ताकि हामीले त्यो देख्न सकौँ।","poem":2},{"text":"इस्राएलका पवित्र परमेश्‍वरको योजना आओस्,","poem":1},{"text":"त्यो नजिक आओस्,","poem":2},{"lineBreak":true},{"text":"ताकि हामीले जान्‍न सकौँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"धिक्‍कार तिनीहरूलाई, जसले दुष्‍टलाई असल","poem":1},{"text":"र असललाई दुष्‍ट भन्छन्,","poem":2},{"text":"जसले उज्यालोको सट्टा अँध्यारोलाई","poem":1},{"text":"र अँध्यारोको सट्टा उज्यालोलाई राख्छन्;","poem":2},{"text":"जसले मिठोको सट्टामा तितो,","poem":1},{"text":"र तितोको सट्टा मिठो राख्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"धिक्‍कार तिनीहरूलाई, जो आफ्नै नजरमा बुद्धिमान् छन्;","poem":1},{"text":"अनि आफ्नै दृष्‍टिमा चतुर छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"धिक्‍कार तिनीहरूलाई, जो मद्य पिउन बहादुर छन्;","poem":1},{"text":"अनि मद्य मिसाउन सिपालु छन्,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"जसले घूस लिएर दोषीलाई छोडिदिन्छन्,","poem":1},{"text":"तर निर्दोषलाई न्याय दिँदैनन्।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"यसकारण पराललाई आगोका जिब्राहरूले चाटेझैँ","poem":1},{"text":"र ज्वालामा सुक्खा घाँस खरानी भएझैँ","poem":2},{"text":"तिनीहरूका जरा सडिजाने छन्,","poem":1},{"text":"र तिनीहरूका फूलहरू धुलोझैँ उडिजानेछन्;","poem":2},{"text":"किनकि तिनीहरूले सेनाहरूका याहवेहको व्यवस्थालाई इन्कार गरेका छन्;","poem":1},{"text":"अनि इस्राएलका पवित्र परमेश्‍वरको वचनलाई लत्याएका छन्।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"यसकारण याहवेहको क्रोध आफ्ना जातिको विरुद्ध दन्केको छ;","poem":1},{"text":"उहाँको हात उठेको छ र उहाँले तिनीहरूलाई प्रहार गर्नुहुन्छ।","poem":2},{"text":"पर्वतहरू काँप्छन्,","poem":1},{"text":"र मृतक शरीरहरू सडकतिर कसिङ्गरझैँ छन्।","poem":2},{"lineBreak":true},{"text":"यति भएर पनि उहाँको क्रोध शान्त भएको छैन,","poem":1},{"text":"तर उहाँको हात अझै पनि उठिराखेकै छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"उहाँले टाढाका जातिहरूको निम्ति","poem":1},{"text":"एउटा झण्डा खडा गर्नुहुनेछ;","poem":2},{"text":"उहाँले पृथ्वीको पल्‍लो छेउमा भएकाहरूका निम्ति भनेर सुसेली मार्नुहुनेछ।","poem":1},{"text":"तिनीहरू द्रूत गतिले आउँछन्!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"तिनीहरूमध्ये एक जना पनि थाक्दैनन्, र धरमराउँदैनन्,","poem":1},{"text":"कोही पनि झुल्दैनन्, न त निदाउँछन्।","poem":2},{"text":"एउटै पेटी पनि खुकुलो हुँदैन,","poem":1},{"text":"जुत्ताका एउटै फित्ता पनि चुँडिदैन।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"तिनीहरूका काँडहरू तीखा छन्,","poem":1},{"text":"सबै धनुहरूमा ताँदो चढाइएका छन्;","poem":2},{"text":"तिनीहरूका घोडाका टाप बज्रझैँ छन्,","poem":1},{"text":"तिनीहरूका रथका चक्‍काहरूको आवाज आँधीबेहरीझैँ छ।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"तिनीहरूका गर्जन सिंहको झैँ छ,","poem":1},{"text":"तिनीहरू जवान सिंहझैँ गर्जन्छन्;","poem":2},{"text":"आफ्नो शिकारलाई पक्रँदा तिनीहरू ङ्वार-ङ्वार गर्छन्;","poem":1},{"text":"अनि त्यसलाई कसैले नछुटाउने गरी लैजान्छन्।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"त्यस दिन तिनीहरू","poem":1},{"text":"त्यसमाथि समुद्र गर्जेझैँ गर्जनेछन्।","poem":2},{"text":"अनि यदि कसैले देशलाई हेर्‍यो भने,","poem":1},{"text":"त्यसले अन्धकार र सङ्कष्‍ट देख्नेछ;","poem":2},{"lineBreak":true},{"text":"यहाँसम्म कि प्रकाशलाई पनि बादलले अँध्यारो बनाइदिनेछ।","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"लगभग 22 लिटर","reference":{"chapter":5,"verse":10}},{"noteId":2,"caller":"+","text":"लगभग 160 किलो","reference":{"chapter":5,"verse":10}},{"noteId":3,"caller":"+","text":"लगभग 16 किलो","reference":{"chapter":5,"verse":10}}]},"thisChapterLink":"/api/npi_ncb/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}