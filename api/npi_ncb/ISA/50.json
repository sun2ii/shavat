{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["इस्राएलको पाप र सेवकको आज्ञाकारिता"]},{"type":"verse","number":1,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“मैले तेरी आमासितै पठाइदिएको","poem":1},{"text":"त्यसको त्यागपत्र कहाँ छ?","poem":2},{"text":"अथवा तँलाई मैले","poem":1},{"text":"कुन ऋणदाताकहाँ बेचेँ?","poem":2},{"text":"तेरा पापहरूको कारण तँ बेचिएको थिइस्;","poem":1},{"text":"तेरा अर्धमहरूको कारण तेरी आमा पठाइएकी थिइन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"म आउँदा किन कोही थिएन?","poem":1},{"text":"मैले बोलाउँदा किन जवाफ दिने कोही मानिस थिएन?","poem":2},{"text":"के मेरो हात तँलाई छुटाउन नसक्ने गरी साह्रै छोटो थियो?","poem":1},{"text":"के तँलाई बचाउने शक्ति मसित छैन र?","poem":2},{"text":"मेरो एउटा हप्कीले म समुद्र सुकाउन सक्छु,","poem":1},{"text":"म नदीलाई मरुभूमि बनाउन सक्छु;","poem":2},{"text":"पानीको कमीले गर्दा माछाहरू कुहिन्छन्","poem":1},{"text":"र तिर्खाले मर्छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"म आकाशलाई अन्धकारले ढाक्छु,","poem":1},{"text":"र भाङ्ग्रालाई त्यसको ओढ्ने बनाउँछु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"थाकेकाहरूलाई उत्साह दिने शब्द जान्‍नका निम्ति","poem":1},{"text":"प्रभु याहवेहले मलाई सिकाउने जिब्रो दिनुभएको छ।","poem":2},{"text":"उहाँले मलाई बिहानैपिच्छे बिउँझाउनुहुन्छ,","poem":1},{"text":"मेरो कानलाई सिक्नेलाई झैँ बिउँझाउनुहुन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"प्रभु याहवेहले मेरा कानहरू खोलिदिनुभएको छ,","poem":1},{"text":"म बागी भएको छैनँ;","poem":2},{"lineBreak":true},{"text":"म पछि हटेको छैनँ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मलाई पिट्नेहरूतिर मैले आफ्नो पिठिउँ नाङ्गो देखाइदिएँ,","poem":1},{"text":"मेरो दाह्री लुछ्नेहरूलाई मैले आफ्नो गाला फर्काइदिएँ;","poem":2},{"text":"गिल्‍ला र थुकाइदेखि","poem":1},{"text":"मैले आफ्नो अनुहार लुकाइनँ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"प्रभु याहवेहले मलाई सहायता दिनुभएकोले","poem":1},{"text":"म अपमानित हुनेछैनँ।","poem":2},{"text":"यसकारण मैले आफ्नो अनुहारलाई चकमके ढुङ्गाझैँ स्थिर पारेको छु,","poem":1},{"text":"र म शर्ममा पर्नेछैनँ भनी जान्दछु।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मलाई निर्दोष ठहराउनुहुने मेरो छेउमा हुनुहुन्छ।","poem":1},{"text":"यसकारण कसले मेरो विरुद्धमा अभियोग लगाउन सक्छ र?","poem":2},{"lineBreak":true},{"text":"हामी एक-आपसको सामना गरौँ!","poem":2},{"text":"मलाई दोष लगाउने को हो?","poem":1},{"text":"त्यसले मेरो सामना गरोस्!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मलाई सहायता गर्नुहुने प्रभु याहवेह नै हुनुहुन्छ।","poem":1},{"text":"कसले मलाई दोषी ठहराउँछ?","poem":2},{"text":"तिनीहरू सबै लुगाझैँ थोत्रा भएर जानेछन्;","poem":1},{"text":"तिनीहरूलाई किराहरूले खाइदिनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"तिमीहरूमा कसले याहवेहको डर मान्छ","poem":1},{"text":"र उहाँको सेवकका कुराहरू कसले पालन गर्छ?","poem":2},{"text":"अन्धकारमा हिँड्ने,","poem":1},{"text":"जससित ज्योति छैन,","poem":2},{"text":"याहवेहको नाममा विश्‍वास राखोस्,","poem":1},{"text":"र उसको परमेश्‍वरमाथि भरोसा राखोस्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तर अब तिमीहरू जसले आगो बाल्छौ,","poem":1},{"text":"र आफ्नो निम्ति जलिरहेको राँको प्रबन्ध गर्छौ,","poem":2},{"text":"जाओ र आफ्नो आगोका उज्यालोमा","poem":1},{"text":"तिमीहरूले बालेको राँकोको उज्यालोमा हिँड।","poem":2},{"text":"तिमीहरूले मेरो हातबाट यही पाउनेछौ;","poem":1},{"text":"तिमीहरू यातनामा रहिरहनेछौ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}