{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["सियोनको निम्ति अनन्तको उद्धार"]},{"type":"verse","number":1,"content":[{"text":"“हे धार्मिकताको पछि लाग्नेहरू","poem":1},{"text":"र याहवेहलाई खोज्नेहरू हो, मेरो कुरा सुन:","poem":2},{"text":"तिमीहरू जुन चट्टानबाट निकालिएका","poem":1},{"text":"र जुन खानिबाट कुँदिएका थियौ, त्यसलाई हेर।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तिमीहरूका पुर्खा अब्राहाम,","poem":1},{"text":"र तिमीहरूलाई जन्माउने सारालाई हेर।","poem":2},{"text":"मैले उसलाई बोलाउँदा ऊ एकलै थियो;","poem":1},{"text":"अनि मैले उसलाई आशिष् दिएँ, उसलाई संख्यामा बढाएँ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"निश्‍चय नै याहवेहले सियोनलाई सान्त्वना दिनुहुनेछ,","poem":1},{"text":"र त्यसका सबै भग्नावशेषहरूलाई दयाको नजरले हेर्नुहुनेछ;","poem":2},{"text":"उहाँले त्यसका मरुभूमिहरूलाई","poem":1},{"text":"अदनझैँ र त्यसका बाँझो जमिनहरूलाई याहवेहको बगैँचाजस्तै बनाउनुहुनेछ।","poem":2},{"text":"अनि त्यसमा आनन्द, खुशीयाली,","poem":1},{"text":"धन्यवाद र गीतको ध्वनि पाइनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“हे मेरा प्रजा हो, मेरा कुरामा ध्यान देओ;","poem":1},{"text":"हे मेरो जाति हो, मेरो कुरा सुन:","poem":2},{"text":"मबाट व्यवस्था निस्कनेछ;","poem":1},{"text":"मेरो न्याय राष्ट्रहरूको ज्योति हुनेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मेरो धार्मिकता नजिक छ,","poem":1},{"text":"मेरो उद्धार आउँदैछ;","poem":2},{"lineBreak":true},{"text":"अनि मेरो बाहुलीले राष्ट्रहरूमा न्याय ल्याउनेछ।","poem":2},{"text":"टापुहरूले मतिर हेर्नेछन्,","poem":1},{"text":"र मेरो बाहुलीको निम्ति आशा लिएर प्रतीक्षा गर्नेछन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिमीहरूका आँखा आकाशतिर उठाओ,","poem":1},{"text":"तल पृथ्वीमा हेर;","poem":2},{"text":"आकाश धुवाँझैँ लोप भइजानेछ;","poem":1},{"text":"पृथ्वी लुगाझैँ मक्‍किएर जानेछ,","poem":2},{"lineBreak":true},{"text":"र यसका बासिन्दाहरू झिँगाझैँ मरिजाने छन्।","poem":2},{"text":"तर मेरो उद्धार सदासर्वदा रहनेछ;","poem":1},{"text":"मेरो धार्मिकता कहिल्यै चुक्नेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“जे असल छ, त्यो जान्‍नेहरू","poem":1},{"text":"र तिमीहरू, जसको हृदयमा मेरो व्यवस्था छ, मेरो कुरा सुन।","poem":2},{"text":"मानिसहरूका बदनामदेखि नडराओ,","poem":1},{"text":"न त तिनीहरूको अपमानदेखि भयभीत होओ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"किनकि तिनीहरूलाई किराले लुगा खाएझैँ खानेछन्;","poem":1},{"text":"अनि तिनीहरूलाई किराले ऊन खाएझैँ खानेछन्।","poem":2},{"text":"तर मेरो धार्मिकता सदासर्वदा रहिरहनेछ;","poem":1},{"text":"मेरो उद्धार पुस्तादेखि पुस्तासम्मै रहिरहनेछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"जाग, जाग! हे याहवेहको बाहुली,","poem":1},{"text":"आफैँलाई शक्ति धारण गर;","poem":2},{"text":"बितेका समयमा झैँ,","poem":1},{"text":"पुराना पुस्ताहरूमा झैँ जाग!","poem":2},{"text":"के राहाबलाई टुक्रा-टुक्रा पार्ने तपाईं नै हुनुहुन्‍न?","poem":1},{"text":"जसले त्यस अजिङ्गरलाई वारपार छेडिदिनुभयो।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"के तपाईं त्यही हुनुहुन्‍न? जसले समुद्र सुकाउनुभयो,","poem":1},{"text":"अथाह समुद्रको पानी सुकाउनुभयो;","poem":2},{"text":"अनि आफूले उद्धार गर्नुभएकाहरूलाई पार गर्नका निम्ति","poem":1},{"text":"समुद्रको गहिराइमा मार्ग बनाइदिनुभयो?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेहका मोल तिरेर छुटाइएकाहरू फर्कनेछन्।","poem":1},{"text":"तिनीहरू सियोनमा गाउँदै पस्‍नेछन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूका शिरमा सदासर्वदाको आनन्दको मुकुट हुनेछ।","poem":2},{"text":"तिनीहरू आनन्द र हर्षमा चुर्लुम्म डुब्नेछन्;","poem":1},{"text":"अनि दुःख र सुस्केरा हराएर जानेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“म, हो! म नै हुँ, जसले तिमीहरूलाई सान्त्वना दिन्छु।","poem":1},{"text":"मरणशील मानिसदेखि घाँसजस्तै ओइलाउने","poem":2},{"lineBreak":true},{"text":"मानिसका सन्तानदेखि डराउने तिमीहरू को हौ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तिमीहरू आफ्नो सृष्‍टिकर्ता याहवेहलाई भुल्छौ,","poem":1},{"text":"जसले आकाश फिँजाउनुभयो","poem":2},{"lineBreak":true},{"text":"र पृथ्वीका जगहरू बसाल्नुभयो;","poem":2},{"text":"तिमीहरूलाई नाश गर्न इच्छुक रहने","poem":1},{"text":"अत्याचारीहरूका क्रोधसित","poem":2},{"lineBreak":true},{"text":"तिमीहरू दिनहुँ डराएर बस्छौ?","poem":2},{"text":"ती अत्याचारीहरूका क्रोध कहाँ छ?","poem":1}]},{"type":"verse","number":14,"content":[{"text":"डरले काँपिरहेका कैदीहरू चाँडै मुक्त भइजानेछन्;","poem":2},{"text":"तिनीहरू आफ्ना खाडलहरूमा मर्नेछैनन्,","poem":1},{"text":"न त तिनीहरूलाई रोटीको अभाव हुनेछ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"किनकि म याहवेह नै तिमीहरूका परमेश्‍वर हुँ,","poem":1},{"text":"जसले समुद्रलाई उथलपुथल गर्छ, र त्यसका छालहरू गर्जन्छन्;","poem":2},{"lineBreak":true},{"text":"जसको नाम सेनाहरूका याहवेह हो।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"मैले तेरो मुखमा आफ्नो वचन हालिदिएको छु;","poem":1},{"text":"अनि तँलाई आफ्नो हातको छायाले ढाकेको छु;","poem":2},{"text":"मैले आकाशलाई त्यसको ठाउँमा राखेको छु,","poem":1},{"text":"जसले पृथ्वीको जग बसालेको छु,","poem":2},{"lineBreak":true},{"text":"र सियोनलाई, ‘तँ मेरो प्रजा होस् भनेको छु।’ ”","poem":2}]},{"type":"heading","content":["याहवेहको क्रोधको कचौरा"]},{"type":"verse","number":17,"content":[{"text":"जाग्, जाग्!","poem":1},{"text":"हे यरूशलेम उठ्,","poem":2},{"text":"तिमीहरू जसले याहवेहको हातबाट,","poem":1},{"text":"उहाँको क्रोधको कचौरा पिएका छौ;","poem":2},{"text":"तिमीहरू जसले कचौरामा भएको धरमराइदिने मद्य","poem":1},{"text":"पूरै पिएर रित्याएका छौ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"त्यसले जन्माएका छोराहरूमध्ये","poem":1},{"text":"त्यसलाई अगुवाइ गर्ने कोही पनि थिएन;","poem":2},{"text":"त्यसले हुर्काएका छोराहरूमध्ये","poem":1},{"text":"त्यसको हात समात्ने कोही पनि थिएन।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"यी दुवै विपत्तिहरू तँमाथि आएका छन्—","poem":1},{"text":"तँलाई कसले सान्त्वना दिन सक्छ?","poem":2},{"text":"विध्वंश र सर्वनाश, अनिकाल र तरवार—","poem":1},{"text":"कसले तँलाई सान्त्वना दिन सक्छ र?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तेरा छोराहरू बेहोस छन्;","poem":1},{"text":"तिनीहरू पासोमा परेका मृगझैँ","poem":2},{"lineBreak":true},{"text":"हरेक गल्‍लीका कुनामा पल्टिरहेका छन्।","poem":2},{"text":"तिनीहरू याहवेहको क्रोध,","poem":1},{"text":"र तेरा परमेश्‍वरको हप्कीले भरिएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"यसकारण यो कुरा सुन्, तँ दुःखित","poem":1},{"text":"र दाखमद्यविना मात्तिएकी होस्।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"आफ्ना मानिसहरूलाई रक्षा गर्नुहुने,","poem":1},{"text":"तेरा सर्वशक्तिमान् परमेश्‍वर, प्रभु याहवेह यसो भन्‍नुहुन्छ:","poem":2},{"text":"“हेर्, तँलाई धरमराइदिने कचौरालाई","poem":1},{"text":"मैले तेरो हातबाट निकालिदिएको छु;","poem":2},{"text":"त्यस कचौराबाट, मेरो क्रोधको कचौराबाट","poem":1},{"text":"तैँले फेरि कहिल्यै पिउनेछैनस्।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तिमीहरूलाई सताउनेहरूको हातमा म क्रोधको कचौरा राखिदिनेछु,","poem":1},{"text":"जसले तँलाई भने,","poem":2},{"lineBreak":true},{"text":"‘घोप्टो पर्, र हामी तँमाथि टेकेर हिँडौँ।’","poem":2},{"text":"अनि तैँले आफ्नो पिठिउँलाई जमिनझैँ,","poem":1},{"text":"हिँड्नलाई सडकझैँ बनाइस्।”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}