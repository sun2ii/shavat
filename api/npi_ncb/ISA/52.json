{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"हे सियोन, जाग्, जाग्,","poem":1},{"text":"तेरो बल धारण गर्।","poem":2},{"text":"हे पवित्र सहर यरूशलेम,","poem":1},{"text":"तेरो महिमाको पोशाक लगा;","poem":2},{"text":"खतना नभएकाहरू र अशुद्धहरू","poem":1},{"text":"तँभित्र फेरि पस्‍नेछैनन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे यरूशलेम, तेरो धुलो टक्टक्या;","poem":1},{"text":"उठ्, र सिंहासनमा बस्।","poem":2},{"text":"हे सियोनकी कैदी छोरी","poem":1},{"text":"तेरो घाँटीका बन्धनका साङ्लाहरूबाट आफूलाई मुक्त पार्।","poem":2}]},{"type":"verse","number":3,"content":["किनकि याहवेह यसो भन्‍नुहुन्छ:",{"text":"“तँ सित्तैँमा बेचिएकी थिइस्,","poem":1},{"text":"र तँ रकमविना नै छुटाइनेछस्।”","poem":2}]},{"type":"verse","number":4,"content":["किनकि प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“सुरुमा मेरा मानिसहरू बसोबास गर्न भनी इजिप्टमा गए;","poem":1},{"text":"अनि पछि अश्शूरले तिनीहरूमाथि अत्याचार गर्‍यो।","poem":2}]},{"type":"verse","number":5,"content":["“अब यहाँ मेरो के छ र?” याहवेह घोषणा गर्नुहुन्छ।",{"text":"“किनकि मेरा मानिसहरू विनाकारण लगिएका छन्;","poem":1},{"text":"अनि शासन गर्नेहरूले तिनीहरूलाई ठट्टा गर्छन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"text":"“अनि दिनभरि नै","poem":1},{"text":"मेरो नामको निन्दा लगातार भइरहन्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यसकारण मेरा मानिसहरूले मेरो नाम जान्‍नेछन्;","poem":1},{"text":"यसकारण यो पहिलेबाटै बताउने म नै हुँ भनी","poem":2},{"text":"त्यस दिन तिनीहरूले जान्‍नेछन्।","poem":1},{"text":"हो, त्यो म नै हुँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"सुसमाचार ल्याउनेहरू,","poem":1},{"text":"शान्ति घोषणा गर्नेहरू,","poem":2},{"text":"उद्धार घोषणा गर्नेहरू,","poem":1},{"text":"सियोनलाई “तेरा परमेश्‍वरले राज्य गर्नुहुन्छ!”","poem":2},{"lineBreak":true},{"text":"सुसमाचार ल्याउनेहरूका पाउ","poem":2},{"text":"पहाडहरूहुँदो कति सुन्दर!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"सुन्! तेरा पहरेदारहरू आफ्ना सोर उचाल्छन्;","poem":1},{"text":"तिनीहरू आनन्दले एकसाथ चिच्याउँछन्।","poem":2},{"text":"जब याहवेह सियोनमा फर्केर आउनुहुन्छ,","poem":1},{"text":"तब तिनीहरूले त्यो आफ्नै आँखाले छर्लङ्गै देख्नेछन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे यरूशलेमका भग्नावशेषहरू हो,","poem":1},{"text":"आनन्दका गीतहरू जोडसित एकसाथ गाओ;","poem":2},{"text":"किनकि याहवेहले उहाँका मानिसहरूलाई सान्त्वना दिनुभएको छ;","poem":1},{"text":"उहाँले यरूशलेमलाई मोल तिरेर छुटाउनुभएको छ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"सबै जातिहरूले देख्ने गरी","poem":1},{"text":"याहवेहले आफ्ना पवित्र बाहुली देखाउनुभएको छ;","poem":2},{"text":"पृथ्वीको पल्‍लो छेउका मानिसहरूले","poem":1},{"text":"हाम्रा परमेश्‍वरको उद्धार देख्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"गइहाल! गइहाल! त्यहाँबाट निस्केर गइहाल!","poem":1},{"text":"कुनै अशुद्ध थोक नछोओ!","poem":2},{"text":"तिमीहरू जो याहवेहका पात्र बोक्छौ,","poem":1},{"text":"त्यसबाट निस्केर आओ र शुद्ध होओ!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तर तिमीहरू हतार-हतार गरी जानेछैनौ;","poem":1},{"text":"अनि न त भागेर जानेछौ;","poem":2},{"text":"किनकि याहवेह तिमीहरूका अगि-अगि जानुहुनेछ,","poem":1},{"text":"र इस्राएलका परमेश्‍वर तिमीहरूका पछिल्तिर रक्षक बन्‍नुहुनेछ।","poem":2}]},{"type":"heading","content":["सेवकको कष्‍ट र गौरव"]},{"type":"verse","number":13,"content":[{"text":"हेर, मेरो सेवकले बुद्धिमानीसाथ काम गर्नेछ;","poem":1},{"text":"ऊ उठाइनेछ र उच्‍च पारिनेछ, र ऊ अति सम्मानित पारिनेछ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जसरी उसदेखि धेरै जना चकित थिए—","poem":1},{"text":"उसको अनुहार चिन्‍नै नसकिने गरी","poem":2},{"lineBreak":true},{"text":"र उसको रूप मानिसको भन्दा पनि कुरूप बनाइएको थियो—","poem":2}]},{"type":"verse","number":15,"content":[{"text":"त्यसरी नै उसले धेरै जातिहरूलाई पवित्र पार्नेछ;","poem":1},{"text":"उसको कारण राजाहरूले आफ्ना मुख बन्द गर्नेछन्।","poem":2},{"text":"किनकि तिनीहरूलाई नभनिएको कुराहरू तिनीहरूले देख्नेछन्;","poem":1},{"text":"तिनीहरूले नसुनेका कुराहरू तिनीहरूले नै बुझ्नेछन्।","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}