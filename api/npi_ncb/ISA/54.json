{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["सियोनको भावी महिमा"]},{"type":"verse","number":1,"content":[{"text":"“हे बाँझी स्त्री, गीत गा!","poem":1},{"text":"तँ, जसले कहिल्यै बच्‍चा जन्माएकी छैनस्;","poem":2},{"text":"आनन्दसाथ र चर्को सोरमा करा;","poem":1},{"text":"तँ, जो प्रसव-वेदनामा कहिल्यै परेकी छैनस्;","poem":2},{"text":"किनकि त्यागिएकी स्त्रीका सन्तानचाहिँ","poem":1},{"text":"पति भएकी स्त्रीको भन्दा धेरै छन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह भन्‍नुहुन्छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“तेरो पालको ठाउँ बढा,","poem":1},{"text":"आफ्नो पालको पर्दाहरू तन्का,","poem":2},{"lineBreak":true},{"text":"बाँकी नराख्;","poem":2},{"text":"तेरा डोरीहरू लामो पार्,","poem":1},{"text":"तेरा किलाहरू बलियो पार्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"किनकि तँ दाहिने र देब्रेतिर फैलिनेछस्;","poem":1},{"text":"तेरा सन्तानहरूले राष्ट्रहरूलाई अधिकार गर्नेछन्;","poem":2},{"lineBreak":true},{"text":"अनि तिनीहरूका त्यागिएका सहरहरूमा बसोबास गर्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“नडरा, तँ शर्ममा पर्नेछैनस्।","poem":1},{"text":"अपमानसित नडरा, तँ होच्याइनेछैनस्।","poem":2},{"text":"तैँले आफ्नो जवानीको शर्म भुल्नेछस्;","poem":1},{"text":"अनि तेरो विधवापनको निन्दा फेरि सम्झनेछैनस्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"किनकि तेरो सृष्‍टिकर्ता तेरो पति हुनुहुन्छ;","poem":1},{"text":"उहाँको नाम सेनाहरूका याहवेह हो;","poem":2},{"text":"इस्राएलका पवित्र परमेश्‍वर तेरा उद्धारकर्ता हुनुहुन्छ;","poem":1},{"text":"उहाँ सारा पृथ्वीका परमेश्‍वर कहलाइनुहुन्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तेरा परमेश्‍वर भन्‍नुहुन्छ,","poem":1},{"text":"त्यागिएकी र आत्मामा दुःखित स्त्रीलाई झैँ","poem":2},{"text":"र जवानीमा विवाह भएर त्यागिएकी पत्नीलाई झैँ","poem":1},{"text":"याहवेहले तँलाई फेरि बोलाउनुहुनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"केही समयको लागि मैले तँलाई त्यागेको थिएँ,","poem":1},{"text":"तर ठूलो कृपासाथ म तँलाई फेरि फर्काइल्याउनेछु।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"रिसको झोँकमा मैले आफ्नो अनुहार","poem":1},{"text":"केही समयको निम्ति तँदेखि लुकाएँ;","poem":2},{"text":"तर अनन्तको करूणासहित","poem":1},{"text":"म तँमाथि कृपा देखाउनेछु”","poem":2},{"lineBreak":true},{"text":"याहवेह तेरा उद्धारकर्ता भन्‍नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“यो मेरो निम्ति नोआको समयजस्तै हो;","poem":1},{"text":"किनभने नोआका समयमा पानीजस्तै फेरि","poem":2},{"lineBreak":true},{"text":"पृथ्वीमा जलप्रलय कहिल्यै हुनेछैन भनी मैले शपथ खाएको छु।","poem":2},{"text":"यसकारण तँसित कहिल्यै रिसाउनेछैनँ;","poem":1},{"text":"तँलाई फेरि हप्काउनेछैनँ भनी मैले अहिले शपथ खाएको छु।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"पहाडहरू हल्‍लाइए","poem":1},{"text":"र डाँडाहरू हटाइए तापनि","poem":2},{"text":"तँप्रतिको मेरो अचुक प्रेम कहिल्यै हटाइनेछैन,","poem":1},{"text":"न त शान्तिको मेरो करार हटाइनेछ”","poem":2},{"lineBreak":true},{"text":"तँलाई कृपा गर्नुहुने याहवेह भन्‍नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“हे दुःखमा परेकी, आँधीबेहरीले पछारिएकी र सान्त्वना नपाएकी सहर,","poem":1},{"text":"म तँलाई बहुमूल्य पत्थरहरूले निर्माण गर्नेछु;","poem":2},{"lineBreak":true},{"text":"तेरा जगहरू नीलमणिले निर्माण गर्नेछु।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"म तेरा सुरक्षा पर्खालहरू लालमणिले,","poem":1},{"text":"तेरा मूलढोकाहरू जगमगाउने रत्नहरूले,","poem":2},{"lineBreak":true},{"text":"र तेरा पर्खालहरू बहुमूल्य पत्थरहरूले बनाउनेछु।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तेरा सबै छोराहरू याहवेहद्वारा सिकाइनेछन्;","poem":1},{"text":"अनि तेरा छोराछोरीहरूलाई ठूलो शान्ति मिल्नेछ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तँ धार्मिकतामा स्थापित गरिनेछस्:","poem":1},{"lineBreak":true},{"text":"अत्याचार तँबाट टाढा रहनेछ;","poem":1},{"text":"तँ कुनै कुरामा डराउनुपर्नेछैन।","poem":2},{"text":"आतङ्क टाढा हटाइनेछ,","poem":1},{"text":"र त्यो तेरो छेउ पर्नेछैन।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"यदि कसैले तँमाथि आक्रमण गर्‍यो भने त्यो मेरो काम हुनेछैन;","poem":1},{"text":"तँलाई जसले आक्रमण गरे तापनि त्यसले तेरो सामु आत्मसमर्पण गर्नेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“हेर्, लोहारलाई सृष्‍टि गर्ने म नै हुँ,","poem":1},{"text":"जसले कोइला फुकेर ज्वाला बनाउँछ,","poem":2},{"lineBreak":true},{"text":"र काम गर्ने ठिक हतियार बनाउँछ।","poem":2},{"text":"उत्पात गरेर नष्‍ट पार्नेलाई मैले नै सृष्‍टि गरेको हुँ;","poem":1}]},{"type":"verse","number":17,"content":[{"text":"तेरो विरुद्धमा बनाइएको हतियार पनि काम लाग्नेछैन;","poem":2},{"lineBreak":true},{"text":"अनि तँलाई दोष लगाउने हरेक जिब्रोलाई तैँले चुप लगाउनेछस्।","poem":2},{"text":"याहवेहका सेवकहरूका पैतृक सम्पत्ति यही हो,","poem":1},{"text":"र तिनीहरूप्रति मेरो धार्मिकताको प्रमाण यही हो”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}