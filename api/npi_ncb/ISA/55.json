{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["तिर्खाएकाहरूलाई निमन्त्रणा"]},{"type":"verse","number":1,"content":[{"text":"“हे सबै तिर्खाएकाहरू हो,","poem":1},{"text":"पानीनिर आओ;","poem":2},{"text":"जससित धन छैन, तिमीहरू पनि आओ,","poem":1},{"text":"र किनेर खाओ!","poem":2},{"text":"आओ, विनाधन, विनामूल्य","poem":1},{"text":"दाखमद्य र दूध किन!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जे कुरा रोटी होइन, त्यसका निम्ति तिमीहरू किन रकम खर्च गर्छौ;","poem":1},{"text":"अनि जुन कुराले सन्तुष्‍ट पार्दैन, त्यसको निम्ति किन परिश्रम गर्छौ?","poem":2},{"text":"सुन, मेरो कुरा सुन, र जे असल छ, त्यो खाओ,","poem":1},{"text":"ताकि तिमीहरूको प्राण उत्तम भोजनमा तृप्‍त हुन सकोस्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"कान थाप र मकहाँ आओ;","poem":1},{"text":"मेरो कुरा सुन, ताकि तिमीहरू जीवित रहन सक।","poem":2},{"text":"म तिमीहरूसित अनन्तको करार बाँध्नेछु;","poem":1},{"text":"दावीदलाई प्रतिज्ञा गरेको मेरो विश्‍वासयोग्य प्रेम।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हेर, मैले त्यसलाई जातिहरूका बीच साक्षी बनाएको छु;","poem":1},{"text":"मानिसहरूका शासक र सेनापति ठहराएको छु।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"निश्‍चय तिमीहरूले नजानेका राष्ट्रहरूलाई तिमीहरू बोलाइपठाउनेछौ;","poem":1},{"text":"अनि याहवेह इस्राएलका पवित्र परमेश्‍वरका कारण","poem":2},{"text":"तिमीहरूलाई नचिनेका जातिहरू","poem":1},{"text":"तिमीहरूतिर हतारसाथ आउनेछन्;","poem":2},{"lineBreak":true},{"text":"किनकि उहाँले तिमीहरूलाई गौरवले भर्नुभएको छ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"जबसम्म याहवेहलाई पाउन सक्छौ, तबसम्म उहाँलाई खोज!","poem":1},{"text":"उहाँ नजिक हुनुहुँदा नै उहाँलाई पुकार!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"दुष्‍टले आफ्नो चाल,","poem":1},{"text":"र अधर्मीले आफ्नो विचार त्यागोस्।","poem":2},{"text":"तिनीहरू याहवेहतिर फर्कून्,","poem":1},{"text":"र उहाँले तिनीहरूमाथि कृपा देखाउनुहुनेछ;","poem":2},{"text":"अनि हाम्रा परमेश्‍वरतर्फ फर्कून्;","poem":1},{"text":"किनकि उहाँले सित्तैँमा क्षमा दिनुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“किनकि मेरा विचार तिमीहरूका विचार होइनन्,","poem":1},{"text":"न त मेरा मार्गहरू तिमीहरूका मार्गहरू हुन्”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“जसरी आकाश पृथ्वीभन्दा उच्‍च छ,","poem":1},{"text":"त्यसरी नै मेरा मार्गहरू तिमीहरूका मार्गहरूभन्दा उच्‍च छन्;","poem":2},{"lineBreak":true},{"text":"अनि मेरा विचारहरू तिमीहरूका विचारहरूभन्दा उच्‍च छन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"जसरी वर्षा र हिउँ","poem":1},{"text":"आकाशबाट झर्छ,","poem":2},{"text":"र पृथ्वीलाई नभिजाएसम्म","poem":1},{"text":"र त्यसमा कोपिला लागेर उब्जनी नदिएसम्म,","poem":2},{"text":"त्यसले छर्नेलाई बिउ","poem":1},{"text":"र खानेलाई भोजन नदिएसम्म फर्केर जाँदैन;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यसरी नै मेरो मुखबाट निस्केको वचन पनि त्यस्तै हुनेछ:","poem":1},{"text":"त्यो मकहाँ व्यर्थै फर्कनेछैन,","poem":2},{"text":"तर त्यसले मैले इच्छा गरेको काम सम्पन्‍न गर्छ;","poem":1},{"text":"अनि मैले जुन उद्देश्यले त्यसलाई पठाएँ, त्यो प्राप्‍त गर्छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तिमीहरू आनन्दमा जानेछौ,","poem":1},{"text":"र शान्तिमा डोर्‍याइनेछौ;","poem":2},{"text":"पर्वतहरू र डाँडाहरूले तिमीहरूको सामु","poem":1},{"text":"जोडसित गीत गाउनेछन्;","poem":2},{"text":"अनि वनका रूखहरूले","poem":1},{"text":"ताली बजाउनेछन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"काँडाहरूको सट्टा सल्‍लाका रूखहरू उम्रनेछन्;","poem":1},{"text":"अनि लुहुँडेकाँडाको सट्टामा मेहदी उम्रनेछ;","poem":2},{"text":"त्यो कुरा याहवेहको ख्यातिको निम्ति","poem":1},{"text":"अनन्तको चिन्हको रूपमा हुनेछ,","poem":2},{"lineBreak":true},{"text":"जुन सदाको निम्ति रहनेछ।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}