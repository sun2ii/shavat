{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["सबै राष्ट्रहरूलाई आशिष्"]},{"type":"verse","number":1,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“न्याय पालना गर,","poem":1},{"text":"जे ठिक छ, त्यही गर;","poem":2},{"text":"किनकि मेरो उद्धार नजिकै छ,","poem":1},{"text":"र मेरो धार्मिकता चाँडै प्रकट गरिनेछ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"त्यो मानिस धन्यको हो, जसले यो गर्छ;","poem":1},{"text":"त्यो मानिस, जसले यसलाई स्थिर राख्छ;","poem":2},{"text":"जसले शब्बाथ दिनलाई अपवित्र नपारी पालन गर्छ,","poem":1},{"text":"र आफ्नो हातलाई दुष्‍ट काम गर्नबाट रोकिराक्छ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेहमा समर्पित भएको कुनै परदेशीले यसो नभनोस्,","poem":1},{"text":"“याहवेहले मलाई निश्‍चय उहाँका मानिसहरूबाट अलग गर्नुहुनेछ।”","poem":2},{"text":"कुनै नपुंसकले यस्तो नभनोस्,","poem":1},{"text":"“म त एउटा सुकेको रूख मात्र हुँ!”","poem":2}]},{"type":"verse","number":4,"content":["किनकि याहवेह यसो भन्‍नुहुन्छ:",{"text":"“मेरा शब्बाथ दिनहरू पालन गर्ने,","poem":1},{"text":"मैले मन पराएका कुराहरू चुन्‍ने,","poem":2},{"lineBreak":true},{"text":"र मेरो करारमा स्थिर बस्‍ने नपुंसकहरूका निम्ति—","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिनीहरूलाई मेरो मन्दिर र त्यसका पर्खालहरूभित्र","poem":1},{"text":"छोराछोरीहरूभन्दा पनि अझ उत्तम स्मारक तुल्याउनेछु;","poem":2},{"lineBreak":true},{"text":"र तिनीहरूलाई अझ असल नाम दिनेछु।","poem":2},{"text":"म तिनीहरूलाई कहिल्यै नमेटिने","poem":1},{"text":"अनन्तको नाम दिनेछु।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"आफूलाई याहवेहमा समर्पित गरेका परदेशीहरू,","poem":1},{"text":"जसले उहाँको सेवा गर्ने,","poem":2},{"text":"याहवेहको नामलाई प्रेम गर्ने","poem":1},{"text":"र उहाँलाई आराधना गर्ने;","poem":2},{"text":"शब्बाथ दिनलाई अपवित्र नगरी पालन गर्ने,","poem":1},{"text":"र मेरो करारमा स्थिर रहनेहरू—","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरूलाई म आफ्नो पवित्र पर्वतमा ल्याउनेछु।","poem":1},{"text":"म तिनीहरूलाई मेरो प्रार्थनाको घरमा आनन्द दिनेछु।","poem":2},{"text":"तिनीहरूले मेरो वेदीमा चढाएका","poem":1},{"text":"होमबलि र बलिदानहरू म ग्रहण गर्नेछु;","poem":2},{"text":"किनकि मेरो घर सबै जातिहरूका लागि","poem":1},{"text":"प्रार्थनाको घर हुनेछ।”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"इस्राएलका निर्वासितहरूलाई बटुल्नुहुने","poem":1},{"text":"प्रभु याहवेह घोषणा गर्नुहुन्छ:","poem":2},{"text":"“भेला गरिएकाहरूबाहेक म अझ अरूलाई","poem":1},{"text":"तिनीहरूमा भेला गर्नेछु।”","poem":2}]},{"type":"heading","content":["दुष्‍टहरूको विरुद्ध परमेश्‍वरको अभियोग"]},{"type":"verse","number":9,"content":[{"text":"हे मैदानका सबै पशुहरू हो, आओ!","poem":1},{"text":"हे वनका सबै पशुहरू हो, खानलाई आओ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"इस्राएलका पहरेदारहरू अन्धा छन्;","poem":1},{"text":"तिनीहरू सबैमा ज्ञानको अभाव छ;","poem":2},{"text":"तिनीहरू सबै भुक्न नसक्ने","poem":1},{"text":"लाटा कुकुरहरूजस्ता छन्;","poem":2},{"text":"जो पल्टिरहने र सपना देख्नेहरू हुन्,","poem":1},{"text":"र तिनीहरू सुत्न मात्र रुचाउँछन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तिनीहरू असाध्यै भोकाएका कुकुरहरू हुन्;","poem":1},{"text":"तिनीहरू कहिल्यै अघाउँदैनन्।","poem":2},{"text":"तिनीहरू समझ नै नभएका गोठालाहरू हुन्;","poem":1},{"text":"सबै आफ्नै बाटो लाग्ने","poem":2},{"lineBreak":true},{"text":"र आफ्नै लाभ खोज्नेहरू हुन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"प्रत्येक यसो भनेर कराउँछन्, “आओ, मलाई मद्य देओ!","poem":1},{"text":"हामी लट्ठ हुने गरी मद्यपान गरौँ!","poem":2},{"text":"अनि भोलि आजको दिनजस्तै हुनेछ,","poem":1},{"text":"झन् राम्रो हुनेछ।”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}