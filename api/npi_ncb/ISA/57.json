{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"धर्मी जनहरू नाश हुन्छन्,","poem":1},{"text":"र यस कुराको कसैले आफ्नो हृदयमा विचार गर्दैन;","poem":2},{"text":"भक्तहरू उठाइलगिन्छन्,","poem":1},{"text":"र धर्मीहरूलाई दुष्‍टताबाट","poem":2},{"text":"बचाइनका निम्ति लगिँदैछन् भनेर","poem":1},{"text":"कसैले बुझ्दैनन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"धर्मको मार्गमा हिँड्नेहरू","poem":1},{"text":"शान्तिमा प्रवेश गर्छन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरू मृत्युमा सुत्दा विश्राम पाउनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“तर हे टुनामुना गर्ने स्त्रीका सन्तान,","poem":1},{"text":"व्यभिचारी र वेश्याका सन्तान हो, यहाँ आओ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिमीहरू कसलाई गिल्‍ला गर्दछौ?","poem":1},{"text":"कसका विरुद्धमा मुख खोल्छौ र जिब्रो निकाल्छौ?","poem":2},{"lineBreak":true},{"text":"के तिमीहरू बागी वा झूटाहरूका सन्तान होइनौ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिमीहरू फलाँटका रूखहरूको बीचमा","poem":1},{"text":"हरेक झ्याम्म परेको रूखमुनि कामवासनाले उत्तेजित हुन्छौ;","poem":2},{"text":"तिमीहरू आफ्ना छोराछोरीहरूलाई खोल्सा","poem":1},{"text":"र चट्टानका धाँदाहरूमा बलिदान गर्छौ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"खोल्साका चिल्‍ला ढुङ्गाहरूको बीचमा भएका मूर्तिहरू तिमीहरूका भाग हुन्;","poem":1},{"text":"तिनीहरू नै तिमीहरू भाग हुन्।","poem":2},{"text":"हो, तिनीहरूलाई तिमीहरूले अर्घबलि र अन्‍नबलि चढाएका छौ।","poem":1},{"text":"यस्ता कुराहरू जान्दाजान्दै पनि के म खुशी होऊँ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिमीहरूले आफ्नो ओछ्यान अग्ला डाँडाहरूमा बिछ्याएका छ्यौ;","poem":1},{"text":"तिमीहरू त्यहाँ आफ्ना बलिदानहरू चढाउन उक्लेर गयौ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिमीहरूका ढोका र चौकसहरूको पछिल्तिर","poem":1},{"text":"तिमीहरूले आफ्नो देवताहरूका चिन्हहरू राख्यौ।","poem":2},{"text":"मलाई त्यागेर तिमीहरूले आफ्नो ओछ्यान उघार्‍यौ!","poem":1},{"text":"त्यसमा चढेर तिमीहरूले त्यसलाई उदाङ्गो पार्‍यौ;","poem":2},{"text":"तिमीहरूले जसका ओछ्यान मन परायौ, तिनीहरूसित सम्बन्ध गाँस्यौ,","poem":1},{"text":"र तिमीहरूले तिनीहरूको नग्नता हेर्‍यौ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिमीहरू मोलोखकहाँ","poem":1},{"noteId":26},{"text":"जैतुनको तेल लिएर गयौ;","poem":1},{"text":"अनि तिमीहरूले सुगन्धित तेलहरू लगायौ।","poem":2},{"text":"तिमीहरूले आफ्नो राजदूतहरू","poem":1},{"noteId":27},{"text":"टाढा पठायौ,","poem":1},{"text":"र तिमीहरू पातालसम्मै ओर्लेर गयौ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिमीहरू आफ्नो लामो मार्गले गर्दा थकित भयौ,","poem":1},{"text":"तर तिमीहरूले, ‘यो व्यर्थको हो’ भनेनौ।","poem":2},{"text":"तिमीहरूले नयाँ सामर्थ्य पायौ,","poem":1},{"text":"यसैकारण तिमीहरू मूर्च्छा परेनौ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“कोसित तिमीहरू यति साह्रो डरायौ र त्रसित भयौ,","poem":1},{"text":"कि तिमीहरू मप्रति झूटो भयौ;","poem":2},{"text":"अनि न त मलाई सम्झना गर्‍यौ,","poem":1},{"text":"न त आफ्ना हृदयमा यस विषयमा विचार गर्‍यौ?","poem":2},{"text":"के धेरै बेरसम्म म चुप रहेँ भनेर नै","poem":1},{"text":"तिमीहरूले मलाई आदर गर्न छाडेका हौ त?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"म तिमीहरूका धार्मिकता र तिमीहरू कामहरू देखाइदिनेछु,","poem":1},{"text":"तर यसबाट तिमीहरूलाई कुनै लाभ हुनेछैन।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तिमीहरूले सहायताको निम्ति पुकार्दा","poem":1},{"text":"तिमीहरूले थुपारेका मूर्तिहरूले नै तिमीहरूलाई बचाऊन्!","poem":2},{"text":"हावाले तिनीहरू सबैलाई उडाइलानेछ;","poem":1},{"text":"एकै सासले पनि तिनीहरूलाई टाढा लानेछ।","poem":2},{"text":"तर मलाई शरणस्थान बनाउने मानिसले","poem":1},{"text":"देशमाथि अधिकार गर्नेछ,","poem":2},{"lineBreak":true},{"text":"र मेरो पवित्र पर्वतलाई प्राप्‍त गर्नेछ।”","poem":2}]},{"type":"heading","content":["पश्‍चात्तापी हुनेलाई सान्त्वना"]},{"type":"verse","number":14,"content":["तब यसो भनिनेछ:",{"text":"“बनाओ, बनाओ, बाटो तयार गर!","poem":1},{"text":"मेरा प्रजाको निम्ति बाटोदेखि बाधाहरू हटाओ।”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"किनकि उच्‍च र सर्वश्रेष्‍ठ परमेश्‍वर भन्‍नुहुन्छ:","poem":1},{"text":"जो सदाकालको निम्ति रहनुहुन्छ, जसको नाम पवित्र होः","poem":2},{"text":"“म उच्‍च र पवित्र ठाउँमा बस्छु,","poem":1},{"text":"तर नम्रहरूको आत्मा","poem":2},{"text":"र पश्‍चात्तापीहरूको हृदयलाई जागृत पार्न,","poem":1},{"text":"आत्मामा नम्र र पश्‍चात्तापी भएकाहरूसित पनि बस्दछु।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"म सदाको निम्ति दोष दिइरहनेछैनँ,","poem":1},{"text":"न त सधैँ रिसाउनेछु;","poem":2},{"text":"किनकि त्यसो गर्दा मानिसको आत्मा,","poem":1},{"text":"मैले सृष्‍टि गरेको मानिसको सास, मेरो सामु शिथिल हुनेछ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"मलाई त्यसको पापपूर्ण लोभले रिस उठायो;","poem":1},{"text":"मैले त्यसलाई दण्ड दिएँ, र रिसमा आफ्नो अनुहार लुकाएँ;","poem":2},{"lineBreak":true},{"text":"तापनि त्यो आफ्नै इच्छाको मार्गमा चलिरह्‍यो।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"मैले त्यसका चालहरू देखेको छु,","poem":1},{"text":"तर म त्यसलाई निको पार्नेछु;","poem":2},{"text":"म त्यसलाई डोर्‍याउनेछु,","poem":1},{"text":"र त्यसको चैन त्यसकहाँ फर्काइल्याउनेछु;","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"म शोक गर्नेहरूका ओठमा प्रशंसा सृष्‍टि गरिदिनेछु।”","poem":2},{"text":"याहवेह भन्‍नुहुन्छ, “नजिक र टाढा भएकाहरूलाई शान्ति! शान्ति!","poem":1},{"text":"अनि म तिनीहरूलाई निको पार्नेछु।”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तर दुष्‍टहरू अस्थिर समुद्रझैँ हुन्,","poem":1},{"text":"जसले विश्राम लिन सक्दैन,","poem":2},{"lineBreak":true},{"text":"जसका छालहरूले हिलो र माटो फ्याँक्छन्।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"मेरा परमेश्‍वर भन्‍नुहुन्छ, “दुष्‍टहरूलाई शान्ति हुँदैन।”","poem":1}]}],"footnotes":[{"noteId":26,"caller":"+","text":"अथवा राजाकहाँ","reference":{"chapter":57,"verse":9}},{"noteId":27,"caller":"+","text":"अथवा मूर्तिहरू","reference":{"chapter":57,"verse":9}}]},"thisChapterLink":"/api/npi_ncb/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}