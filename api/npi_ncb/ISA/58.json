{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["साँचो उपवास"]},{"type":"verse","number":1,"content":[{"text":"“उच्‍च सोरले करा, चुप लागेर नबस्।","poem":1},{"text":"तुरहीको जस्तै तेरो सोर उचाल्।","poem":2},{"text":"मेरो प्रजालाई तिनीहरूका विद्रोह","poem":1},{"text":"र याकोबका घरानालाई तिनीहरूका पाप घोषणा गरिदे।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"किनकि तिनीहरूले मलाई दिनहुँ खोज्छन्;","poem":1},{"text":"तिनीहरू जे ठिक छ, त्यही गर्ने","poem":2},{"text":"र आफ्ना परमेश्‍वरको आज्ञा नत्याग्ने,","poem":1},{"text":"तर मेरा मार्ग जान्‍न इच्छा गर्ने जातिजस्तै देखिन्छन्।","poem":2},{"text":"तिनीहरू मसँग उचित निर्णयहरू सोध्छन्,","poem":1},{"text":"र परमेश्‍वर तिनीहरूका नजिक आऊन् भनी इच्छा राख्छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरू भन्छन्, ‘हामीहरूले उपवास बस्यौँ,","poem":1},{"text":"तपाईंले किन त्यो देख्नुहुन्‍न?","poem":2},{"text":"हामीले आफूलाई नम्र तुल्यायौँ,","poem":1},{"text":"तपाईंले किन ध्यान दिनुहुन्‍न?’","poem":2},{"lineBreak":true},{"text":"“तर तिमीहरू उपवास बस्दा आफूखुशी गर्छौ,","poem":1},{"text":"र तिमीहरूका सबै कामदारहरूलाई शोषण गर्छौ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिमीहरूका उपवास वाद-विवाद,","poem":1},{"text":"झगडा र हात हालाहालमा टुङ्गिन्छ।","poem":2},{"text":"यस प्रकारको उपवास बस्दा","poem":1},{"text":"तिमीहरूको प्रार्थना ग्रहणयोग्य हुँदैन।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"के मानिसले एक दिन मात्र आफूलाई विनम्र तुल्याउने","poem":1},{"text":"किसिमको उपवास मैले चाहेको हो र?","poem":2},{"text":"के यो आफ्नो शिर निगालोझैँ निहुराएर","poem":1},{"text":"भाङ्ग्रा र खरानीमा बस्‍ने मात्र हो?","poem":2},{"text":"के यसैलाई तिमीहरू उपवास भन्छौ,","poem":1},{"text":"के यस्तो उपवास याहवेहले ग्रहण गर्नुहुन्छ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“मैले चाहेको उपवास:","poem":1},{"lineBreak":true},{"text":"अन्यायका बन्धन, र जुवाको डोरी फुकाल्नु,","poem":1},{"text":"शोषणमा परेकाहरूलाई स्वतन्त्र गरिदिनु","poem":2},{"text":"र प्रत्येक जुवा भाँचिदिनु होइन र?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"के तिमीहरूका भोजन भोकाएकाहरूसित बाँड्नु,","poem":1},{"text":"घरबार नभएका गरिबलाई आश्रय दिनु,","poem":2},{"text":"नाङ्गोलाई देख्दा त्यसलाई ढाकिदिनु,","poem":1},{"text":"र आफ्ना खाँचोमा परेका","poem":2},{"lineBreak":true},{"text":"नातेदारहरूसँग नलुक्नु नै उपवास होइन र?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जब तिमीहरू यी सबै गर्न थाल्छौ,","poem":1},{"text":"तब तिमीहरूको ज्योति सूर्योदयझैँ चम्कनेछ,","poem":2},{"text":"तिमीहरू चाँडै निको हुनेछौ;","poem":1},{"text":"धार्मिकता तिमीहरूको अगि-अगि जानेछ,","poem":2},{"lineBreak":true},{"text":"र याहवेहको महिमा तिमीहरूको पछिल्तिर रक्षक हुनेछ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जब तिमीहरूले पुकार्नेछौ, र याहवेहले जवाफ दिनुहुनेछ;","poem":1},{"text":"तिमीहरू सहायताको निम्ति गुहार्नेछौ, तब उहाँले, ‘म यहाँ छु’ भन्‍नुहुनेछ।","poem":2},{"lineBreak":true},{"text":"“यदि तिमीहरूले अत्याचारको जुवा भाँचिदियौ,","poem":1},{"text":"एक-अर्कालाई दोष लगाउने काम र दुष्‍ट कुरा त्यागिदियौ भने,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"यदि तिमीहरू भोकाहरूका पक्षमा खडा भयौ,","poem":1},{"text":"र शोषणमा परेकाहरूका खाँचो पूरा गरिदियौ भने,","poem":2},{"text":"तिमीहरूका ज्योति अन्धकारमा चम्कनेछ;","poem":1},{"text":"अनि अन्धकारचाहिँ मध्यदिनझैँ हुनेछ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेहले तिमीहरूलाई सधैँ अगुवाइ गर्नुहुनेछ;","poem":1},{"text":"उहाँले सुक्खा भूमिमा पनि तिमीहरूलाई तृप्‍त पार्नुहुनेछ;","poem":2},{"lineBreak":true},{"text":"अनि तिमीहरूको शरीर बलिया पार्नुहुनेछ।","poem":2},{"text":"तिमीहरू प्रशस्त पानी सिँचेको बगैँचाझैँ,","poem":1},{"text":"र कहिल्यै नसुक्ने पानीको मूलझैँ हुनेछौ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तिमीहरूका मानिसहरूले प्राचीन भग्नावशेषहरू पुनर्निर्माण गर्नेछन्;","poem":1},{"text":"अनि पुस्तौँदेखिका जगहरू खडा गर्नेछन्;","poem":2},{"text":"तिमीहरू भत्किएका पर्खाल मर्मत गर्नेहरू,","poem":1},{"text":"सडकहरूमा बसोबास गर्नलाई सडकहरू बनाउनेहरू भनिनेछौ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“यदि तिमीहरूले आफ्ना खुट्टाहरूलाई शब्बाथ दिन उल्‍लङ्घन गर्नबाट,","poem":1},{"text":"र मेरो पवित्र दिनमा आफूखुशी गर्नबाट रोक्यौ भने,","poem":2},{"text":"तिमीहरूले शबाथ दिनलाई प्रसन्‍नता,","poem":1},{"text":"र याहवेहको पवित्र दिनलाई आदरणीय ठान्यौ,","poem":2},{"text":"र तिमीहरूले आफ्ना इच्छाअनुसार नचली, आफ्नो इच्छाअनुसार नगरी,","poem":1},{"text":"अथवा व्यर्थको कुरा नबोलेर त्यस दिनलाई चाहिँ आदर गर्‍यौ भने,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तब तिमीहरूले आफ्नो आनन्द याहवेहमा पाउनेछौ,","poem":1},{"text":"र म तिमीहरूलाई देशका उचाइहरूमा सवार हुन लाउनेछु;","poem":2},{"lineBreak":true},{"text":"तिमीहरूका पुर्खा याकोबको पैतृक सम्पत्ति उपभोग गर्न दिनेछु।”","poem":2},{"text":"म याहवेहको मुखले बोलेको हुँ।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}