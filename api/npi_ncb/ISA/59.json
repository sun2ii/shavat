{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["पाप, पश्‍चात्ताप र छुटकारा"]},{"type":"verse","number":1,"content":[{"text":"हेर, याहवेहको हात बचाउन नसक्ने गरी छोटो भएको छैन,","poem":1},{"text":"न त उहाँको कान सुन्‍न नसक्ने गरी बहिरो भएको छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तर तिमीहरूका अपराधहरूले","poem":1},{"text":"तिमीहरूलाई आफ्ना परमेश्‍वरबाट अलग गरेका छन्;","poem":2},{"text":"तिमीहरूका पापहरूले गर्दा उहाँको अनुहार तिमीहरूबाट लुकाइएको छ,","poem":1},{"text":"त्यसैकारण उहाँले सुन्‍नुहुन्‍न।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"किनकि तिमीहरूका हातहरू रगतले","poem":1},{"text":"र तिमीहरूका औँलाहरू दोषले अशुद्ध भएका छन्।","poem":2},{"text":"तिमीहरूका ओठहरूले झूट बोलेका छन्,","poem":1},{"text":"र तिमीहरूका जिब्राले दुष्‍ट कुराहरू बोल्दछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कसैले पनि न्यायको माग गर्दैन;","poem":1},{"text":"कसैले पनि मुद्दा न्यायपूर्वक लड्दैन।","poem":2},{"text":"तिनीहरू व्यर्थका तर्कहरूमाथि भर पर्छन् र झूट बोल्छन्;","poem":1},{"text":"तिनीहरूले समस्या गर्भधारण गर्छन् र दुष्‍टता जन्माउँछन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिनीहरू विषालु सर्पका अण्डा ओथ्राउँछन्,","poem":1},{"text":"र माकुराको जाल बुन्छन्।","poem":2},{"text":"तिनीहरूका अण्डा खाने जोसुकै पनि मर्छ,","poem":1},{"text":"र अण्डा फुटायो भने विषालु सर्पको बच्‍चा निस्कन्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिनीहरूका जालले कपडा बनाउन सकिँदैन;","poem":1},{"text":"तिनीहरूले बनाएका थोकले मानिसहरूले आफूलाई ढाक्न सक्दैनन्।","poem":2},{"text":"तिनीहरूका काम दुष्‍टतापूर्ण छन्,","poem":1},{"text":"र तिनीहरूका हातमा हिंसाका कामहरू छन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरूका खुट्टा पाप गर्न दौडिन्छन्;","poem":1},{"text":"तिनीहरू निर्दोष रगत बगाउन हतारिन्छन्।","poem":2},{"text":"तिनीहरूका विचार दुष्‍ट विचार हुन्;","poem":1},{"text":"तिनीहरूका मार्ग बरबादी र विनाशले भरिएका छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरू शान्तिको मार्ग जान्दैनन्;","poem":1},{"text":"तिनीहरूका मार्गमा न्याय छैन।","poem":2},{"text":"तिनीहरूले आफ्ना मार्ग बाङ्गो बनाएका छन्;","poem":1},{"text":"त्यसमा हिँड्ने कसैले पनि शान्ति पाउनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"यसकारण न्याय हामीबाट टाढा छ,","poem":1},{"text":"र धार्मिकता हामीकहाँ आइपुग्दैन।","poem":2},{"text":"हामी ज्योतिको आशा गर्छौँ, तर अन्धकार छ;","poem":1},{"text":"हामी उज्यालोको बाटो हेर्छौँ, तर घोर अन्धकारमा हिँड्छौँ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"अन्धाले जस्तै हामी भित्ता छामछाम-छुमछुम गर्छौँ,","poem":1},{"text":"आँखा नभएको मानिसजस्तै हामी आफ्नो बाटो छामिहिँड्छौँ।","poem":2},{"text":"मध्यदिनमा पनि साँझमा जस्तै हामी ठक्‍कर खान्छौँ;","poem":1},{"text":"बलियाहरूको बीचमा हामी मरेका मानिसहरूजस्ता छौँ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हामी भालुजस्तै कराउँछौँ;","poem":1},{"text":"हामी ढुकुरजस्तै विलाप गर्छौँ,","poem":2},{"text":"हामी न्याय खोज्छौँ, तर पाउँदैनौँ;","poem":1},{"text":"हामी छुटकारा खोज्छौँ, तर त्यो हामीदेखि टाढा छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"किनकि हाम्रा अपराधहरू तपाईंको दृष्‍टिमा धेरै छन्,","poem":1},{"text":"र हाम्रा पापहरूले हाम्रै विरुद्धमा गवाही दिन्छन्।","poem":2},{"text":"हाम्रा अपराधहरू सधैँ हामीसँग छन्,","poem":1},{"text":"र हामी आफ्ना अपराधहरू स्वीकार गर्छौँ:","poem":2}]},{"type":"verse","number":13,"content":[{"text":"हामीले याहवेहको विरुद्ध विश्‍वासघात र विद्रोह गरेका छौँ;","poem":1},{"text":"हाम्रा पिठिउँ परमेश्‍वरतिर फर्काएका छौँ;","poem":2},{"text":"विद्रोह र अत्याचार गरेका छौँ,","poem":1},{"text":"र हाम्रा हृदयभित्र सोचेका झूटहरू मुखले उच्‍चारण गरेका छौँ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"यसरी न्यायलाई पछिल्तिर पन्छाएका छौँ,","poem":1},{"text":"र धार्मिकता टाढा भएको छ;","poem":2},{"text":"सत्यताले चाहिँ बाटोमा ठक्‍कर खाएको छ,","poem":1},{"text":"र इमानदारीताले प्रवेश गर्न सक्दैन।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"सत्यता कहीँ पनि पाइँदैन,","poem":1},{"text":"र दुष्‍टतादेखि अलग बस्‍ने जोसुकै पनि शिकार हुन्छन्।","poem":2},{"lineBreak":true},{"text":"याहवेहले देख्नुभयो, र न्याय हुँदै नभएकोले","poem":1},{"text":"उहाँलाई दुःख लाग्यो।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"उहाँले कोही पनि नभएको देख्नुभयो;","poem":1},{"text":"मध्यस्थ गर्ने कोही पनि नभएकोले उहाँले अचम्म मान्‍नुभयो;","poem":2},{"text":"यसैले उहाँकै बाहुलीले उद्धारको काम गर्नुभयो,","poem":1},{"text":"र उहाँकै धार्मिकताले सम्हाल्नुभयो।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"उहाँले आफ्नो धार्मिकताको छाती-पाता","poem":1},{"text":"र आफ्नो शिरमाथि मुक्तिको टोप पहिरिनुभयो;","poem":2},{"text":"उहाँले बदलाको वस्त्र लगाउनुभयो","poem":1},{"text":"र जोशलाई पोशाकझैँ पहिरनुभयो।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तिनीहरूले गरेअनुसार","poem":1},{"text":"उहाँले बदला लिनुहुनेछ;","poem":2},{"text":"उहाँका शत्रुहरूमाथि क्रोध","poem":1},{"text":"र बैरीहरूलाई प्रतिशोध दिनुहुनेछ;","poem":2},{"lineBreak":true},{"text":"उहाँले टापुहरूलाई तिनीहरूले पाउनुपर्ने दण्ड दिनुहुनेछ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"पश्‍चिमबाट, विदेशीहरूले याहवेहको नामको डर मान्‍नेछन्,","poem":1},{"text":"र सूर्योदयदेखि नै तिनीहरूले उहाँको महिमा गर्नेछन्।","poem":2},{"text":"किनकि उहाँ याहवेहको सासले ठेल्दै ल्याएको","poem":1},{"text":"उर्लंदो भेलजस्तै आउनुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“आफ्ना पापको पश्‍चात्ताप गरी फर्कने","poem":1},{"text":"याकोबका सन्तानहरूका निम्ति मुक्तिदाता सियोन पर्वतमा आउनुहुनेछ,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":21,"content":["याहवेह भन्‍नुहुन्छ, “मेरो करार तिनीहरूसित चाहिँ यही नै हो। तँमाथि मेरो जुन आत्मा छ, त्यो तँबाट हट्नेछैन; अनि मैले तेरो मुखमा राखिदिएको मेरो वचन तेरो मुखबाट अथवा तेरा छोराछोरीहरूका मुखबाट, न त अब उसो तिनीहरूका सन्तानहरूका मुखबाट सदासर्वदाका निम्ति हट्नेछ,” याहवेह भन्‍नुहुन्छ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}