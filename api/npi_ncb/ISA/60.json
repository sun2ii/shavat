{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["सियोनको महिमा"]},{"type":"verse","number":1,"content":[{"text":"“प्रकाशमान् हो, उठ्; किनकि तेरो ज्योति आएको छ,","poem":1},{"text":"र याहवेहको महिमा तँमाथि उदाएको छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हेर्, अन्धकारले पृथ्वीलाई ढाक्छ,","poem":1},{"text":"र मानिसहरूमाथि बाक्लो अन्धकार छ,","poem":2},{"text":"तर याहवेह तँमाथि उदाउनुहुनेछ;","poem":1},{"text":"अनि उहाँको महिमा तँमाथि देखा पर्नेछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जातिहरू तेरो प्रकाशमा आउनेछन्,","poem":1},{"text":"र राजाहरू तेरो प्रभातको उज्यालोमा आउनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“तेरा आँखा उठाएर चारैतिर हेर्:","poem":1},{"text":"सबै भेला भएर तँकहाँ आउँछन्;","poem":2},{"text":"तेरा छोराहरू टाढाबाट आउनेछन्,","poem":1},{"text":"र तेरा छोरीहरूलाई हात समाएर ल्याइनेछन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तब तैँले हेर्नेछस् र चम्कनेछस्;","poem":1},{"text":"तेरो हृदय उल्‍लासित हुनेछ र आनन्दले फुल्नेछ;","poem":2},{"text":"समुद्रको सम्पत्ति तँकहाँ ल्याइनेछ;","poem":1},{"text":"जातिहरूका धन तँकहाँ आउनेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ऊँटहरूका बथान, मिद्यान र एपाका","poem":1},{"text":"साना-साना सवारी ऊँटहरूले तेरो देश ढाकिनेछ।","poem":2},{"text":"शेबाबाट सबै मानिसहरू","poem":1},{"text":"याहवेहको प्रशंसाको घोषणा गर्दै","poem":2},{"lineBreak":true},{"text":"सुन र धूप बोकेर आउनेछन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"केदारका सबै बगालहरू तँकहाँ भेला गराइनेछन्;","poem":1},{"text":"नबायोतका भेडाहरूले तेरो सेवा गर्नेछन्;","poem":2},{"text":"मेरो वेदीमा ती भेटीस्वरूप ग्रहण गरिनेछन्,","poem":1},{"text":"र म आफ्नो महिमित मन्दिरलाई सिँगार्नेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“बादलझैँ उड्ने,","poem":1},{"text":"र आफ्ना गुँडतिर उड्ने ढुकुरहरूजस्ता यी को हुन्?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"निश्‍चय नै टापुहरूले मलाई हेर्नेछन्;","poem":1},{"text":"टाढाबाट तेरा बालबच्‍चाहरूलाई ल्याउँछन्,","poem":2},{"text":"तिनीहरूका सुन र चाँदी लिएका","poem":1},{"text":"तर्शीशका जहाजहरू अगि-अगि छन्;","poem":2},{"text":"ती सबै याहवेह तेरा परमेश्‍वर,","poem":1},{"text":"इस्राएलका पवित्र परमेश्‍वरलाई सम्मान दिनका निम्ति हो;","poem":2},{"lineBreak":true},{"text":"किनकि उहाँले तँलाई गौरवले सम्मानित तुल्याउनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“विदेशीहरूले तेरा पर्खालहरू पुनर्निर्माण गर्नेछन्,","poem":1},{"text":"र तिनीहरूका राजाहरूले तेरो सेवा गर्नेछन्।","poem":2},{"text":"मैले रिसमा तँलाई प्रहार गरे तापनि","poem":1},{"text":"मेरो निगाहमा म तँलाई दया देखाउनेछु।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तेरा सहरका मूलढोकाहरू सधैँ खुला रहनेछन्;","poem":1},{"text":"ती मुलढोकाहरू दिन र रात कहिल्यै बन्द हुनेछैनन्,","poem":2},{"text":"ताकि मानिसहरूले तँकहाँ जातिहरूका धनसम्पत्ति ल्याउन सकून्,","poem":1},{"text":"अर्थात् तिनीहरूका राजाहरू विजयी जुलूसको साथ पस्‍न सकून्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"किनकि तेरो सेवा नगर्ने जाति र राज्य सर्वनाश हुनेछन्;","poem":1},{"text":"त्यो पूर्ण रूपमा सर्वनाश पारिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“लेबनानको गौरव तँकहाँ आउनेछ,","poem":1},{"text":"सल्‍ला, धूपी र सिसौका रूखहरूसमेत,","poem":2},{"text":"मेरो पवित्रस्थानलाई सिँगार्न ल्याइनेछन्;","poem":1},{"text":"अनि म आफ्ना पवित्रस्थानलाई महिमित तुल्याउनेछु।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तँलाई अत्याचार गर्नेहरूका छोराछोरीहरू तेरो सामु निहुरेर आउनेछन्;","poem":1},{"text":"तँलाई घृणा गर्ने सबै तेरो पाउमा झुक्नेछन्,","poem":2},{"text":"र तँलाई याहवेहको सहर,","poem":1},{"text":"इस्राएलका पवित्र परमेश्‍वरको सियोन भन्‍नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“तँ त्यागिएकी र घृणित भएकी,","poem":1},{"text":"तँबाट भएर यात्रा गर्ने कोही नगए तापनि","poem":2},{"text":"म तँलाई अनन्तको निम्ति महान्","poem":1},{"text":"र पुस्तौँ-पुस्ताहरूका निम्ति आनन्द बनाउनेछु।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तैँले जातिहरूको दूध पिउनेछस्,","poem":1},{"text":"र राजकीय स्तन चुस्‍नेछस्।","poem":2},{"text":"तब तैँले जान्‍नेछस्, कि म याहवेह नै तेरो मुक्तिदाता,","poem":1},{"text":"तेरो उद्धारकर्ता, याकोबका सर्वशक्तिमान् परमेश्‍वर हुँ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"म तँलाई काँसाको सट्टामा सुन","poem":1},{"text":"र फलामको सट्टामा चाँदी ल्याइदिनेछु।","poem":2},{"text":"म तँलाई काठको सट्टामा काँसा","poem":1},{"text":"र ढुङ्गाको सट्टामा फलाम ल्याइदिनेछु।","poem":2},{"text":"म शान्तिलाई तेरा राज्यपाल","poem":1},{"text":"र धार्मिकतालाई तेरा शासक तुल्याइदिनेछु।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तेरो देशमा फेरि हिंसा सुनिनेछैन,","poem":1},{"text":"न त तेरा सिमानाहरूमा विध्वंश र सर्वनाश सुनिनेछ,","poem":2},{"text":"तर तैँले आफ्ना पर्खालहरूलाई मुक्ति भन्‍नेछस्","poem":1},{"text":"र तेरा मूलढोकाहरूलाई प्रशंसा नाम राख्नेछस्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"अब उसो दिनमा तेरो निम्ति सूर्यले ज्योति दिनेछैन,","poem":1},{"text":"न त चन्द्रमाको उज्यालो तँमाथि चम्कनेछ;","poem":2},{"text":"किनकि याहवेह नै तेरो निम्ति अनन्तको ज्योति हुनुहुनेछ;","poem":1},{"text":"अनि तेरा परमेश्‍वर तेरो महिमा हुनुहुनेछ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तेरो सूर्य फेरि कहिल्यै अस्ताउनेछैन,","poem":1},{"text":"र तेरो चन्द्रमा फेरि धमिलो हुनेछैन;","poem":2},{"text":"याहवेह नै तेरो अनन्तको ज्योति हुनुहुनेछ;","poem":1},{"text":"अनि तेरा दुःखका दिनहरू समाप्‍त हुनेछन्।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तब तेरा सबै मानिसहरू धार्मिक हुनेछन्;","poem":1},{"text":"अनि तिनीहरूले सदाको निम्ति देशमाथि अधिकार गर्नेछन्।","poem":2},{"text":"मेरो महानता देखाउनको निम्ति,","poem":1},{"text":"मैले रोपेका बिरुवाहरू,","poem":2},{"lineBreak":true},{"text":"मेरा हातका कामहरू तिनीहरू नै हुन्।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तिमीहरूमध्ये सबैभन्दा थोरैचाहिँ हजार हुनेछ;","poem":1},{"text":"अनि सबैभन्दा सानोचाहिँ एउटा शक्तिशाली जाति हुनेछ।","poem":2},{"text":"म नै याहवेह हुँ;","poem":1},{"text":"म यी प्रतिज्ञाहरू त्यसको समयमा र चाँडै पूरा गर्नेछु।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}