{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["याहवेहको निगाहको वर्ष"]},{"type":"verse","number":1,"content":[{"text":"प्रभु याहवेहको आत्मा ममाथि छ;","poem":1},{"text":"किनकि गरिबहरूलाई सुसमाचार सुनाउनका निम्ति","poem":2},{"lineBreak":true},{"text":"याहवेहले मलाई अभिषेक गर्नुभएको छ।","poem":2},{"text":"उहाँले मलाई टुटेका हृदयहरूलाई जोड्न,","poem":1},{"text":"कैदमा परेकाहरूलाई स्वतन्त्रताको घोषणा गर्न,","poem":2},{"lineBreak":true},{"text":"र बन्धनमा परेकाहरूलाई","poem":2},{"noteId":28},{"text":"अन्धकारबाट मुक्त गर्न,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेहको निगाहको वर्ष","poem":1},{"text":"र हाम्रा परमेश्‍वरको बदलाको घोषणा गर्न,","poem":2},{"text":"शोक गर्नेहरूलाई सान्त्वना दिन,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"र सियोन पर्वतमा शोकाकुल हुनेहरूलाई प्रबन्ध गरिदिन,","poem":2},{"text":"तिनीहरूलाई खरानीको सट्टा","poem":1},{"text":"सुन्दरताको मुकुट प्रदान गर्न,","poem":2},{"text":"विलापको सट्टा","poem":1},{"text":"आनन्दको तेल दिन,","poem":2},{"text":"निराशाको आत्माको सट्टा","poem":1},{"text":"प्रशंसाको पोशाक पहिराइदिन पठाउनुभएको छ।","poem":2},{"text":"उहाँको गौरव प्रदर्शन गर्न","poem":1},{"text":"तिनीहरूलाई याहवेहले रोप्नुभएको","poem":2},{"lineBreak":true},{"text":"धार्मिकताका फलाँटहरू भनिनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"तिनीहरूले प्राचीन भग्नावशेषहरूलाई पुनर्निर्माण गर्नेछन्;","poem":1},{"text":"अनि धेरै पहिले भत्काइएका ठाउँहरूलाई पुनर्स्थापित गर्नेछन्;","poem":2},{"text":"पुस्तौँसम्म भत्काएर उजाड र ध्वस्त पारिएका सहरहरूलाई","poem":1},{"text":"तिनीहरूले मर्मत गरेर फेरि बसाल्नेछन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"परदेशीहरूले तिमीहरूका बगालहरूलाई चराउनेछन्;","poem":1},{"text":"विदेशीहरूले तिमीहरूका खेतहरू र दाखबारीमा काम गर्नेछन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिमीहरू याहवेहका पुजारीहरू भनिनेछौ;","poem":1},{"text":"तिमीहरूलाई हाम्रा परमेश्‍वरका सेवकहरूको नाम दिइनेछ।","poem":2},{"text":"तिमीहरूले जाति-जातिहरूका सम्पत्ति खानेछौ;","poem":1},{"text":"अनि तिनीहरूकै धनमा तिमीहरूले गर्व गर्नेछौ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"तिमीहरूका शर्मको सट्टामा","poem":1},{"text":"तिमीहरूले दोबर भाग पाउनेछौ;","poem":2},{"text":"अनि तिमीहरूले अपमानको सट्टामा","poem":1},{"text":"तिमीहरूका उत्तराधिकारमा आनन्द मनाउनेछौ;","poem":2},{"text":"यसरी तिमीहरूले आफ्ना देशमा दोबर भाग अधिकार गर्नेछौ,","poem":1},{"text":"र सदाको निम्ति आनन्दित हुनेछौ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“किनकि म याहवेहले न्यायलाई प्रेम गर्छु;","poem":1},{"text":"डकैती र अधर्मलाई घृणा गर्छु।","poem":2},{"text":"म मेरो विश्‍वासयोग्यतामा मेरा प्रजालाई प्रतिफल दिनेछु,","poem":1},{"text":"र तिनीहरूसँग सदाको करार बाँध्नेछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरूका सन्तानहरू जातिहरूका बीचमा","poem":1},{"text":"र तिनीहरूका बालबच्‍चाहरू मानिसहरूका बीचमा चिनिनेछन्।","poem":2},{"text":"तिनीहरूलाई देख्ने सबैले जान्‍नेछन्,","poem":1},{"text":"कि तिनीहरू याहवेहले आशिष् दिनुभएको जाति हुन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"म याहवेहमा अत्यन्त आनन्दित हुन्छु;","poem":1},{"text":"मेरो प्राणले मेरा परमेश्‍वरमा आनन्द गर्छ।","poem":2},{"text":"किनकि दुलहाले आफ्नो शिरलाई पुजारीले सिँगारेझैँ,","poem":1},{"text":"र दुलहीले आफूलाई गहनाहरूले सिँगारेझैँ,","poem":2},{"text":"उहाँले मलाई मुक्तिको पोशाक लगाइदिनुभएको छ,","poem":1},{"text":"र धार्मिकताको पोशाकले मलाई सजाउनुभएको छ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"जसरी माटोले टुसालाई उम्रन दिन्छ,","poem":1},{"text":"र बगैँचाले बिउलाई बढ्न दिन्छ,","poem":2},{"text":"त्यसरी नै प्रभु याहवेहले","poem":1},{"text":"धार्मिकता र प्रशंसालाई सबै जातिहरूका बीच बढाउनुहुनेछ।","poem":2}]}],"footnotes":[{"noteId":28,"caller":"+","text":"केही प्राचीन पा.लि.हरूमा अन्धाहरूलाई","reference":{"chapter":61,"verse":1}}]},"thisChapterLink":"/api/npi_ncb/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}