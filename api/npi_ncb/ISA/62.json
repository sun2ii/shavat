{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["सियोनको नयाँ नाम"]},{"type":"verse","number":1,"content":[{"text":"यरूशलेमको धार्मिकता प्रभातझैँ नचम्केसम्म,","poem":1},{"text":"त्यसको मुक्ति राँकोझैँ चहकिलो नबलेसम्म,","poem":2},{"text":"म सियोनको खातिर चुप रहनेछैनँ;","poem":1},{"text":"म यरूशलेमको खातिर मौन रहनेछैनँ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जाति-जातिहरूले तेरो धार्मिकता,","poem":1},{"text":"सबै राजाहरूले तेरो गौरव देख्नेछन्;","poem":2},{"text":"याहवेहले आफ्नै मुखले दिनुहुने","poem":1},{"text":"नयाँ नामद्वारा तँ बोलाइनेछस्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तँ याहवेहको हातमा गौरवको एउटा मुकुट,","poem":1},{"text":"र आफ्नो परमेश्‍वरको हातमा राजकीय शिरपेच हुनेछस्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"अब उसो तिनीहरूले तँलाई त्यागिएकी भन्‍नेछैनन्,","poem":1},{"text":"न त तेरो देशलाई उजाड भन्‍नेछन्।","poem":2},{"text":"तर तँलाई हेप्सीबा,","poem":1},{"noteId":29},{"text":"र तेरो देशलाई ब्युलाह","poem":2},{"noteId":30},{"text":"भनिनेछ;","poem":2},{"text":"किनकि याहवेह तँसित प्रसन्‍न हुनुहुनेछ,","poem":1},{"text":"र तेरो देशलाई विवाह गरिनेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जसरी एउटा जवान मानिसले एउटी कन्ये-केटीलाई विवाह गर्छ,","poem":1},{"text":"त्यसरी नै तेरा निर्माणकर्ताले","poem":2},{"noteId":31},{"text":"तँलाई विवाह गर्नुहुनेछ;","poem":2},{"text":"जसरी दुलहा आफ्नी दुलहीमा रमाउँछ,","poem":1},{"text":"त्यसरी नै तेरा परमेश्‍वर तँसित रमाउनुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"हे यरूशलेम, मैले तेरा पर्खालहरूमाथि पहरेदारहरू खटाएको छु;","poem":1},{"text":"तिनीहरू दिनरात कहिल्यै चुपचाप बस्‍न पाउनेछैनन्।","poem":2},{"text":"हे याहवेहलाई पुकार्नेहरू हो,","poem":1},{"text":"आफूलाई विश्राम नदेओ;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उहाँले यरूशलेमलाई स्थापित नगर्नुभएसम्म","poem":1},{"text":"र त्यसलाई पृथ्वीको प्रशंसा नबनाउनुभएसम्म उहाँलाई विश्राम नदेओ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेहले आफ्नो दाहिने हात","poem":1},{"text":"र आफ्ना शक्तिशाली बाहुलीको शपथ लिनुभएको छ:","poem":2},{"text":"“म फेरि कहिल्यै तेरो अन्‍न तेरा शत्रुहरूलाई","poem":1},{"text":"भोजनको निम्ति दिनेछैनँ;","poem":2},{"text":"अनि नयाँ दाखमद्य, जसको निम्ति तैँले परिश्रम गरेको थिइस्,","poem":1},{"text":"त्यो विदेशीहरूले कहिल्यै पिउन पाउनेछैनन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तर त्यसको कटनी गर्नेहरूले नै त्यो खानेछन्,","poem":1},{"text":"र याहवेहको प्रशंसा गर्नेछन्;","poem":2},{"text":"अनि जसले अङ्‌गुर बटुल्नेछन्,","poem":1},{"text":"तिनीहरूले नै मेरो पवित्रस्थानका चोकहरूमा ती पिउनेछन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"जाओ, मूलढोकाहरूबाट भएर जाओ!","poem":1},{"text":"मानिसहरूका निम्ति बाटो तयार पार।","poem":2},{"text":"बनाओ, राजमार्ग बनाओ!","poem":1},{"text":"ढुङ्गाहरू हटाओ।","poem":2},{"text":"जाति-जातिहरूका निम्ति झण्डा खडा गर।","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"याहवेहले पृथ्वीको पल्‍लो छेउसम्म","poem":1},{"text":"घोषणा गर्नुभएको छ:","poem":2},{"text":"“सियोनकी छोरीलाई भन,","poem":1},{"text":"‘हेर्, तेरा मुक्तिदाता आउनुहुन्छ!","poem":2},{"text":"हेर्, उहाँको पुरस्कार उहाँसित छ,","poem":1},{"text":"र उहाँको प्रतिफल उहाँको साथमा नै छ।’ ”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तिनीहरू पवित्र जाति,","poem":1},{"text":"याहवेहबाट छुटकारा पाएकाहरू भनिनेछन्;","poem":2},{"text":"तिमीहरूलाई अब उसो परमेश्‍वरले खोज्नुभएको सहर,","poem":1},{"text":"नत्यागिएको सहर भनिनेछ।","poem":2}]}],"footnotes":[{"noteId":29,"caller":"+","text":"हेप्सीबा जसको अर्थ उसमा मेरो खुशी छ।","reference":{"chapter":62,"verse":4}},{"noteId":30,"caller":"+","text":"ब्युलाह जसको अर्थ विवाहित","reference":{"chapter":62,"verse":4}},{"noteId":31,"caller":"+","text":"अथवा छोराहरू","reference":{"chapter":62,"verse":5}}]},"thisChapterLink":"/api/npi_ncb/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}