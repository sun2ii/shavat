{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["न्याय र उद्धार"]},{"type":"verse","number":1,"content":[{"text":"याहवेहले भन्‍नुहुन्छ, “मलाई सोधखोज नगर्नेहरूकहाँ मैले आफूलाई प्रकट गरेको छु;","poem":1},{"text":"मलाई खोजी नगर्नेहरूले मलाई भेट्टाएका छन्।","poem":2},{"text":"मेरो नाम पुकार नगर्ने जातिलाई,","poem":1},{"text":"मैले भनेँ, ‘म यहाँ छु, म यहाँ छु।’","poem":2}]},{"type":"verse","number":2,"content":[{"text":"दिनभरि मैले यस्तो अटेरी जातितिर","poem":1},{"text":"आफ्ना हात पसारेँ,","poem":2},{"text":"जो आफ्नै कल्पनाको पछि लागेर","poem":1},{"text":"कुबाटोमा हिँड्छन्;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"यस्तो जाति, जसले मेरो सामु","poem":1},{"text":"मलाई निरन्तर रिस उठाउँछन्,","poem":2},{"text":"जसले बगैँचाहरूमा बलिदान चढाउँछन्,","poem":1},{"text":"र इँटाका वेदीहरूमा धूप बाल्छन्;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जो चिहानहरूका बीचमा बस्दछन्,","poem":1},{"text":"र गुप्‍त ठाउँमा रात बिताउँछन्;","poem":2},{"text":"जसले सुँगुरको मासु खान्छन्,","poem":1},{"text":"र जसका भाँडाहरूमा अशुद्ध मासुका झोल राखिएका हुन्छन्;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जसले भन्छन्, ‘टाढै बस्; मेरो नजिक नआइज;","poem":1},{"text":"किनकि म तेरो निम्ति अति पवित्र छु!’","poem":2},{"text":"यस्ता मानिसहरू मेरो नाकका धुवाँजस्ता हुन्,","poem":1},{"text":"जुन धुवाँ दिनभरि आगोजस्तै जलिरहन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“हेर, मेरो सामु यस्तो लेखिएको छ:","poem":1},{"text":"म चुपचाप रहनेछैनँ, तर पूरै बदला लिनेछु;","poem":2},{"lineBreak":true},{"text":"निश्‍चय नै म तिनीहरूकै काखमा साटो लिनेछु—","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिमीहरूका र तिमीहरूका पितापुर्खाहरूका पापको बदला म लिनेछु,”","poem":1},{"text":"याहवेह भन्‍नुहुन्छ।","poem":2},{"text":"“किनभने तिनीहरूले पर्वतहरूमा बलिदान जलाए,","poem":1},{"text":"र डाँडाहरूमा मेरो निन्दा गरे।","poem":2},{"text":"म तिनीहरूका पहिलेका कामहरूको बदला","poem":1},{"text":"तिनीहरूकै काखमा हालिदिनेछु।”","poem":2}]},{"type":"verse","number":8,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“अङ्‌गुरको झुप्पामा अझ रसिलो अङ्‌गुर छँदै","poem":1},{"text":"मानिसहरूले भने, ‘त्यसलाई नष्‍ट नगर;","poem":2},{"lineBreak":true},{"text":"किनकि त्यसमा अझ दाखरस असल छ,’","poem":2},{"text":"यसरी नै म मेरा सेवकहरूको पक्षमा त्यसै गर्नेछु;","poem":1},{"text":"म तिनीहरू सबैलाई नाश गर्नेछैनँ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"म याकोबका सन्तानहरूलाई ल्याउनेछु,","poem":1},{"text":"र यहूदाका सन्तानहरूलाई मेरो पर्वतहरूमाथि उत्तराधिकार बनाउनेछु;","poem":2},{"text":"मेरा छानिएका मानिसहरूले ती पर्वतहरूमाथि अधिकार गर्नेछन्,","poem":1},{"text":"र मेरा सेवकहरू त्यहाँ बस्‍नेछन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मलाई खोज्ने मानिसहरूका निम्ति,","poem":1},{"text":"शारोनको मैदान बगालहरूको लागि खर्क","poem":2},{"lineBreak":true},{"text":"र आकोरको बेँसी विश्रामस्थल हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“तर याहवेहलाई त्याग्नेहरूका निम्ति,","poem":1},{"text":"जसले मेरो पवित्र पर्वतलाई बिर्सन्छन्,","poem":2},{"text":"जसले गाद","poem":1},{"noteId":33},{"text":"देवताको निम्ति टेबुल तयार गर्छन्,","poem":1},{"text":"र मेनी","poem":2},{"noteId":34},{"text":"देवीको निम्ति मिसाएको मद्यको कचौरा भर्छन्;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"म तिमीहरूलाई तरवारको निम्ति दिनेछु,","poem":1},{"text":"र तिमीहरू सबै काटिनलाई घुँडा टेक्नेछौ;","poem":2},{"text":"किनकि मैले तिमीहरूलाई बोलाएँ, तर तिमीहरूले जवाफ दिएनौ;","poem":1},{"text":"मैले बोलाएँ, तर तिमीहरूले सुनेनौ।","poem":2},{"text":"तिमीहरूले मेरो नजरमा दुष्‍ट काम गर्‍यौ","poem":1},{"text":"र मलाई मन नपर्ने कुराहरू रोज्यौ।”","poem":2}]},{"type":"verse","number":13,"content":["यसकारण प्रभु याहवेह यसो भन्‍नुहुन्छ:",{"text":"“मेरा सेवकहरूले खानेछन्,","poem":1},{"text":"तर तिमीहरूचाहिँ भोकै रहनेछौ;","poem":2},{"text":"मेरा सेवकहरूले पिउनेछन्,","poem":1},{"text":"तर तिमीहरूचाहिँ तिर्खाउनेछौ;","poem":2},{"text":"मेरा सेवकहरू रमाउनेछन्,","poem":1},{"text":"तर तिमीहरूचाहिँ शर्ममा पर्नेछौ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"मेरा सेवकहरूले","poem":1},{"text":"आफ्ना हृदयको आनन्दमा गाउनेछन्;","poem":2},{"text":"तर तिमीहरू हृदयको वेदनामा","poem":1},{"text":"कराएर रुनेछौ,","poem":2},{"lineBreak":true},{"text":"र हृदयको वेदनामा विलाप गर्नेछौ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तिमीहरूले आफ्नो नाम","poem":1},{"text":"मेरा चुनिएका मानिसहरूका निम्ति सरापको रूपमा छोड्नेछौ;","poem":2},{"text":"प्रभु याहवेहले तिमीहरूलाई मृत्युमा पार्नुहुनेछ,","poem":1},{"text":"तर उहाँले आफ्ना सेवकहरूलाई अर्को नाम दिनुहुनेछ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"जब देशमा कसैले आशिष्‌को माग गर्छ,","poem":1},{"text":"त्यसले सत्य परमेश्‍वरको नामद्वारा माग गर्नेछ;","poem":2},{"text":"जसले देशमा शपथ खान्छ;","poem":1},{"text":"त्यसले सत्य परमेश्‍वरको नामद्वारा शपथ खानेछ।","poem":2},{"text":"किनकि बितेका दुःखहरू भुलिनेछन्,","poem":1},{"text":"र मेरा आँखाबाट लुकाइनेछन्।","poem":2}]},{"type":"heading","content":["नयाँ आकाश र नयाँ पृथ्वी"]},{"type":"verse","number":17,"content":[{"text":"“हेर, म नयाँ आकाश","poem":1},{"text":"र नयाँ पृथ्वी सृष्‍टि गर्नेछु।","poem":2},{"text":"बितेका कुराहरू स्मरण गरिनेछैनन्,","poem":1},{"text":"न त तिनीहरू मनमा नै आउनेछन्।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तर म जे सृष्‍टि गर्नेछु,","poem":1},{"text":"त्यसमा सधैँ खुशी होओ र हर्ष मनाओ;","poem":2},{"text":"किनकि म यरूशलेमलाई हर्षोल्‍लास","poem":1},{"text":"र त्यसका मानिसहरूलाई आनन्दित तुल्याउनेछु।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"म यरूशलेमसँग खुशी हुनेछु,","poem":1},{"text":"र मेरा प्रजामा हर्षित हुनेछु;","poem":2},{"text":"यरूशलेममा रोएको र कराएको सोर","poem":1},{"text":"फेरि कहिल्यै सुनिनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“थोरै दिनसम्म बाँच्ने बालक,","poem":1},{"text":"वा आफ्नो पूरा उमेरसम्म नबाँच्ने वृद्ध मानिस","poem":2},{"lineBreak":true},{"text":"त्यहाँ कहिल्यै हुनेछैन;","poem":2},{"text":"सय वर्ष बाँच्ने मानिस","poem":1},{"text":"जवान मानिनेछ;","poem":2},{"text":"र सय वर्षसम्म नबाँच्ने मानिसचाहिँ","poem":1},{"text":"श्रापित मानिनेछ।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तिनीहरूले घर बनाउनेछन्, र त्यसमा बस्‍नेछन्;","poem":1},{"text":"तिनीहरूले दाखबारी लगाउनेछन्, र त्यसका फल खानेछन्।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तिनीहरूले बनाएका घरहरूमा अरूहरू नै आएर बस्‍नेछैनन्,","poem":1},{"text":"वा तिनीहरूले लगाएका दाखबारीको फल फेरि कहिल्यै अरूहरूले खानेछैनन्।","poem":2},{"text":"किनकि रूखको आयु जति लामो हुन्छ,","poem":1},{"text":"त्यति नै धेरै आयु मेरा प्रजाको हुनेछ;","poem":2},{"text":"मेरा चुनिएका प्रजाले आफ्ना हातका काम","poem":1},{"text":"लामो समयसम्म उपभोग गर्नेछन्।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तिनीहरूले व्यर्थमा परिश्रम गर्नेछैनन्,","poem":1},{"text":"न त तिनीहरूले विपत्तिको निम्ति छोराछोरीहरू जन्माउनेछन्;","poem":2},{"text":"किनकि तिनीहरू र तिनीहरूका सन्तानहरूसमेत","poem":1},{"text":"याहवेहद्वारा आशिष् पाएका मानिसहरू हुनेछन्।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"तिनीहरूले पुकार गर्नुभन्दा अगाडि म जवाफ दिनेछु;","poem":1},{"text":"तिनीहरूले बोल्दाबोल्दै म सुन्‍नेछु।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ब्वाँसो र थुमाले एउटै ठाउँमा एकैसाथ खानेछन्,","poem":1},{"text":"सिंहले गोरुले झैँ पराल खानेछ;","poem":2},{"lineBreak":true},{"text":"अनि सर्पको आहारा धुलो हुनेछ।","poem":2},{"text":"तिनीहरूले मेरा सबै पवित्र पर्वतहरूमा","poem":1},{"text":"न त हानि गर्नेछन्, न त नाश गर्नेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह भन्‍नुहुन्छ।","poem":2}]}],"footnotes":[{"noteId":33,"caller":"+","text":"अथवा भाग्य","reference":{"chapter":65,"verse":11}},{"noteId":34,"caller":"+","text":"अथवा भावी","reference":{"chapter":65,"verse":11}}]},"thisChapterLink":"/api/npi_ncb/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}