{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ISA","translationId":"npi_ncb","name":"यशैया","commonName":"यशैया","title":"यशैयाको भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"5dc9cc5b422ca08188b4b50a491f781ddd704e42e357e0f1be78f0462823961d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/npi_ncb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["तरै पनि त्यो सङ्कष्‍टमा परेकाहरूका निम्ति निराशा हुनेछैन। बितेका समयमा उहाँले जबूलून र नप्‍तालीको मुलुकलाई नम्र तुल्याउनुभयो। तर भविष्यमा उहाँले यर्दनतिरको समुद्र छेउको गैरयहूदीहरूको गालीललाई सम्मानित पार्नुहुनेछ—"]},{"type":"verse","number":2,"content":[{"text":"अन्धकारमा जिउनेहरूले","poem":1},{"text":"एउटा ठूलो ज्योति देखेका छन्;","poem":2},{"text":"घोर अन्धकारमा बस्‍नेहरूमाथि","poem":1},{"text":"ज्योति उदाएको छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तपाईंले जातिलाई फराकिलो पार्नुभएको छ;","poem":1},{"text":"अनि तिनीहरूका आनन्द बढाइदिनुभएको छ;","poem":2},{"text":"मानिसहरूले कटनीमा रमाएझैँ","poem":1},{"text":"लुटको माल बाँड्दा रमाएझैँ,","poem":2},{"text":"तिनीहरू तपाईंको सामु","poem":1},{"text":"रमाउनेछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"किनकि मिद्यानको पराजयको दिनमा झैँ","poem":1},{"text":"तपाईंले तिनीहरूलाई भार भएको जुवा,","poem":2},{"text":"र तिनीहरूका काँधमा परेको बोझ,","poem":1},{"text":"साथै तिनीहरूलाई सताउनेहरूका लहुरोलाई","poem":2},{"lineBreak":true},{"text":"भाँचिदिनुभएको छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"प्रत्येक योद्धाले लडाइँमा लगाएको जुत्ता,","poem":1},{"text":"र रगतमा लतपतिएको","poem":2},{"text":"हरेक वस्त्र आगोमा भस्म हुनेछ।","poem":1},{"text":"त्यो आगोको निम्ति इन्धन हुनेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"किनकि हाम्रा निम्ति एउटा बालकको जन्म भएको छ;","poem":1},{"text":"हाम्रा निम्ति एउटा पुत्र दिइएको छ।","poem":2},{"lineBreak":true},{"text":"शासन उहाँको काँधमा हुनेछ।","poem":2},{"text":"उहाँलाई उदेकको सल्‍लाहकार,","poem":1},{"text":"शक्तिशाली परमेश्‍वर,","poem":2},{"lineBreak":true},{"text":"सनातनका पिता, शान्तिका राजकुमार भनिनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उहाँको शासन वृद्धि र शान्तिको","poem":1},{"text":"अन्त्य हुनेछैन।","poem":2},{"text":"उहाँले दावीदको सिंहासनमाथि","poem":1},{"text":"र तिनका राज्यमाथि शासन गर्नुहुनेछ।","poem":2},{"text":"उहाँले राज्यलाई त्यस समयदेखि अनन्तसम्म","poem":1},{"text":"न्याय र धार्मिकतासँग स्थापित गर्नुहुनेछ र दृढ पार्नुहुनेछ।","poem":2},{"lineBreak":true},{"text":"सेनाहरूका याहवेहको जोशले","poem":2},{"text":"यसलाई सम्पन्‍न गर्नेछ।","poem":1}]},{"type":"heading","content":["इस्राएलमाथि याहवेहको क्रोध"]},{"type":"verse","number":8,"content":[{"text":"प्रभुले याकोबको विरुद्धमा एउटा सन्देश पठाउनुभएको छ;","poem":1},{"text":"जुन इस्राएलमाथि पर्नेछ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"सबै मानिसहरूले त्यसलाई जान्‍नेछन्;","poem":1},{"text":"एफ्राइम र सामरियाका बासिन्दाहरू,","poem":2},{"text":"जो घमण्ड र अभिमानको","poem":1},{"text":"हृदयले यसो भन्छन्,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“इँटाहरू लडेका छन्,","poem":1},{"text":"तर हामी काटेका ढुङ्गाहरूले बनाउनेछौँ;","poem":2},{"text":"नेभाराका रूखहरू ढालिएका छन्,","poem":1},{"text":"तर हामी त्यसको सट्टामा देवदारुका रूखहरू लगाउनेछौँ।”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तर याहवेहले तिनीहरूको विरुद्ध रसीनका शत्रुहरूलाई बलियो पार्नुभएको छ;","poem":1},{"text":"अनि तिनीहरूका शत्रुहरूलाई सुर्‍याउनुभएको छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"पूर्वबाट अरामीहरू र पश्‍चिमबाट पलिश्तीहरूले","poem":1},{"text":"मुख खोलेर इस्राएललाई खाएका छन्।","poem":2},{"lineBreak":true},{"text":"यति भएर पनि उहाँको क्रोध शान्त भएको छैन,","poem":1},{"text":"तर उहाँको हात अझै पनि उठिराखेकै छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"तर उहाँले प्रहार गर्नुभएका मानिसहरू उहाँतिर फर्केका छैनन्,","poem":1},{"text":"न त तिनीहरूले सेनाहरूका याहवेहलाई खोजेका छन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"यसकारण याहवेहले इस्राएलबाट शिर र पुच्छर,","poem":1},{"text":"खजूरको हाँगा र निगालो दुवै एकै दिनमा अलग गरिदिनुहुनेछ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"प्रधानहरू र विशिष्‍ट व्यक्तिहरू शिर हुन्;","poem":1},{"text":"अनि झूट सिकाउने अगमवक्ताहरूचाहिँ पुच्छर हुन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"यस जातिलाई डोर्‍याउनेहरूले तिनीहरूलाई पथभ्रष्‍ट पार्छन्,","poem":1},{"text":"र डोर्‍याइएकाहरू बरालिएका छन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"यसकारण प्रभु जवान मानिसहरूसित प्रसन्‍न हुनुहुनेछैन।","poem":1},{"text":"न त उहाँले अनाथ र विधवाहरूलाई टिठाउनुहुनेछ।","poem":2},{"text":"किनकि हरेक मानिस ईश्‍वरहीन र दुष्‍ट छ;","poem":1},{"text":"प्रत्येक मुखले नीच कुरा बोल्छ।","poem":2},{"lineBreak":true},{"text":"यति भएर पनि उहाँको क्रोध शान्त भएको छैन;","poem":1},{"text":"उहाँको हात उठिराखेकै छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"किनकि निश्‍चय नै दुष्‍टता आगोझैँ बल्छ;","poem":1},{"text":"यसले सिउँडी र काँडालाई भस्म पार्नेछ;","poem":2},{"text":"यसले वनका झाडीहरू आगो लगाइदिनेछ,","poem":1},{"text":"र त्यो धुवाँको मुस्लोमा बटारिँदै उँभो-उँभो जानेछ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"सेनाहरूका याहवेहको क्रोधद्वारा","poem":1},{"text":"सबै देश भस्म हुनेछ;","poem":2},{"text":"अनि मानिसहरू आगोको निम्ति दाउरा हुनेछन्;","poem":1},{"text":"कसैले पनि आफ्नो दाजुभाइलाई बाँकी राख्नेछैन।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तिनीहरूले आफ्ना दाहिनेतिर खानेछ,","poem":1},{"text":"र पनि अझ भोकै रहनेछ;","poem":2},{"text":"देब्रेतिर तिनीहरूले खानेछन्,","poem":1},{"text":"तर तृप्‍त हुनेछैनन्।","poem":2},{"text":"प्रत्येकले आफ्नै सन्तानको मासु खानेछ:","poem":1}]},{"type":"verse","number":21,"content":[{"text":"मनश्शेले एफ्राइमलाई खानेछ र एफ्राइमले मनश्शेलाई खानेछ;","poem":2},{"lineBreak":true},{"text":"ती दुवै एकसाथ यहूदाको विरुद्ध जाइलाग्नेछन्।","poem":2},{"lineBreak":true},{"text":"यति भएर पनि उहाँको क्रोध शान्त भएको छैन,","poem":1},{"text":"तर उहाँको हात अझै उठिराखेकै छ।","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}