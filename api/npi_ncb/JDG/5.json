{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JDG","translationId":"npi_ncb","name":"न्यायकर्ता","commonName":"न्यायकर्ता","title":"न्यायकर्ताहरूको पुस्तक","order":7,"numberOfChapters":21,"sha256":"3b65084faa2ef505fdcbce76a4e43d5dfe712b5e26b64bc755aaf29a8d5614e8","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/npi_ncb/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["दबोराको गीत"]},{"type":"verse","number":1,"content":["त्यस दिन दबोरा र अबीनोअमका छोरा बाराकले यो गीत गाए:"]},{"type":"verse","number":2,"content":[{"text":"“जब इस्राएलका राजकुमारहरू अगि सरे,","poem":1},{"text":"जब मानिसहरूले स्वेच्छापूर्वक आफूलाई दिए—","poem":2},{"lineBreak":true},{"text":"याहवेहको प्रशंसा गर!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“हे राजाहरू हो, सुन! हे शासकहरू हो, ध्यान देओ!","poem":1},{"text":"याहवेहका निम्ति म गाउनेछु;","poem":2},{"lineBreak":true},{"text":"याहवेह, इस्राएलका परमेश्‍वरका निम्ति म सङ्गीत बजाउनेछु।","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“हे याहवेह, तपाईं सेइरबाट बाहिर जानुभयो,","poem":1},{"text":"जब तपाईं एदोमको देशबाट सवार हुनुभयो,","poem":2},{"text":"तब पृथ्वी काँप्यो, आकाशले मूल फुटायो,","poem":1},{"text":"बादलले पानी बर्सायो।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"सीनै पर्वतका अद्वितीय याहवेहको सामु,","poem":1},{"text":"याहवेह इस्राएलका परमेश्‍वरको सामु पहाडहरू पनि डरले काँपे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“अनातका छोरा शमगरको समयमा,","poem":1},{"text":"याएलका समयमा, मूलमार्गहरू सुनसान थिए;","poem":2},{"lineBreak":true},{"text":"मानिसहरू घुमाउरो बाटाहरूमा हिँड्न लागे।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"इस्राएलका गाउँलेहरूले युद्ध गरेनन्,","poem":1},{"text":"जबसम्म म दबोरा, खडा भइनँ,","poem":2},{"lineBreak":true},{"text":"तबसम्म इस्राएलमा एउटी आमाझैँ म खडा भएँ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जब परमेश्‍वरले नयाँ अगुवाहरू चुन्‍नुभयो,","poem":1},{"text":"तब सहरका मूलढोकाहरूमा लडाइँ आइपुग्यो,","poem":2},{"text":"तर इस्राएलका चालीस हजारसित","poem":1},{"text":"न ढाल, न त भाला देखिए।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मेरो हृदय इस्राएलका राजकुमारहरूसित,","poem":1},{"text":"मानिसहरूबीच भएका इच्छुक स्वयम्‌सेवकहरूसित छ,","poem":2},{"lineBreak":true},{"text":"याहवेहको प्रशंसा गर!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“तिमीहरू जो सेता गधाहरूमाथि सवार हुन्छौ,","poem":1},{"text":"जो महँगा गलैँचामाथि बस्छौ,","poem":2},{"lineBreak":true},{"text":"र तिमीहरू, जो पैदल बाटो लाग्दछौ,","poem":2},{"text":"कुरालाई राम्ररी विचार गर,","poem":1}]},{"type":"verse","number":11,"content":[{"text":"गीत गाउनेहरूको सोर सुनिँदैछ, जहाँ स्त्रीहरू पानी भर्नलाई आउँछन्।","poem":1},{"text":"त्यहाँ तिनीहरू याहवेहका विजयहरूका वर्णन गर्छन्,","poem":2},{"lineBreak":true},{"text":"इस्राएलमा गाँउलेहरूका विजयहरू।","poem":2},{"lineBreak":true},{"text":"“त्यसपछि याहवेहका जनहरू","poem":1},{"text":"तल सहरका मूलढोकाहरूमा गए।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"‘उठ, दबोरा, उठ!","poem":1},{"text":"उठ-उठ, मुख खोलेर गीत गाऊ।","poem":2},{"text":"हे अबीनोअमका छोरा बाराक, उठ!","poem":1},{"text":"धेरैलाई कैदी बनाऊ।’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“तब छोडिएका मानिसहरू भारदारहरूकहाँ ओर्लेर आए;","poem":1},{"text":"याहवेहका मानिसहरू शक्तिशाली भएर मकहाँ आए।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"एफ्राइमबाट अमालेकको बीचमा जरा बसालिएकाहरू आए;","poem":1},{"text":"बेन्यामीनचाहिँ ती मानिसहरूसित थिए, जसले तिमीहरूलाई पछ्याए।","poem":2},{"text":"माकीरबाट सेनापतिहरू ओर्लेर आए।","poem":1},{"text":"जबूलूनबाट चाहिँ सेनापतिका लहुरो बोक्ने मानिसहरू आए।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"इस्साखारका राजकुमारहरू दबोरासित थिए;","poem":1},{"text":"हो, इस्साखार बाराकसित थिए;","poem":2},{"lineBreak":true},{"text":"बाराकको आज्ञामा बेँसीमा पठाइएको।","poem":2},{"text":"रूबेनका जिल्‍लाहरूमा","poem":1},{"text":"हृदय जाँच्ने काम धेरै भएको थियो।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"गोठालाहरूले बोलाएको तीखो सोर सुन्‍नलाई","poem":1},{"text":"तिमीहरू भेडागोठहरूमा किन बसिरह्‍यौ?","poem":2},{"text":"रूबेनका जिल्‍लाहरूमा","poem":1},{"text":"हृदय जाँच्ने धेरै काम भयो।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"गिलाद यर्दनपारि नै बसे।","poem":1},{"text":"अनि दान, त्यो किन जहाजहरूमा बसिरह्‍यो?","poem":2},{"text":"आशेर समुद्रको किनारमा रह्‍यो","poem":1},{"text":"र आफ्नै गुफाहरूमा बस्यो।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"जबूलूनका मानिसहरूले आफ्नो प्राणलाई जोखिममा पारे;","poem":1},{"text":"त्यसरी नै नप्‍तालीले पनि रणभूमिको मुखैमा होमिदिए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“राजाहरू आए, तिनीहरूले युद्ध गरे;","poem":1},{"text":"कनानका राजाहरूले मगिद्दोको","poem":2},{"text":"पानीहरूको छेउमा भएको तानाकमा युद्ध गरे,","poem":1},{"text":"तर तिनीहरूले लुटमा चाँदी लगेनन्।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"आकाशबाट ताराहरूले युद्ध गरे,","poem":1},{"text":"तिनीहरूका मार्गबाट तिनीहरूले सीसराको विरुद्धमा युद्ध गरे।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"कीशोन नदीले तिनीहरूलाई बगाएर लग्यो।","poem":1},{"text":"त्यो प्राचीन नदी, कीशोन नदी।","poem":2},{"lineBreak":true},{"text":"हे मेरो प्राण, अगि बढ्; बलियो हो!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तब घोडाका टापहरू गर्जिउठे—","poem":1},{"text":"उनीहरूका शक्तिशाली घोडाहरू चाँडो गरी दगुरे।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"याहवेहका दूतले भने, ‘मेरोजलाई श्राप,","poem":1},{"text":"त्यसका बासिन्दाहरूमाथि नराम्रोसँग श्राप!","poem":2},{"text":"किनभने तिनीहरू याहवेहको सहायताको लागि आएनन्;","poem":1},{"text":"याहवेहलाई बलियाहरूका विरुद्ध सहायता दिएनन्।’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“याएल स्त्रीहरूमध्ये सबैभन्दा आशिषित होऊन्,","poem":1},{"text":"केनी हेबेरकी पत्नी,","poem":2},{"lineBreak":true},{"text":"पालमा बस्‍ने स्त्रीहरूमध्ये सबैभन्दा आशिषित।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"सीसराले पानी माग्यो, र तिनले दूध दिइन्;","poem":1},{"text":"कुलिनहरूलाई सुहाउने बटुकोमा तिनले दही ल्याइदिइन्।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"तिनको हातमा पालको किला पर्‍यो;","poem":1},{"text":"तिनको दाहिने हातमा काम गर्नेको मुङ्ग्रो पर्‍यो।","poem":2},{"text":"तिनले सीसरामाथि प्रहार गरिन्, र त्यसको शिर फोरिदिइन्,","poem":1},{"text":"तिनले त्यसको कन्चटलाई छेडेर छताछुल्‍ल पारिदिइन्।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"तिनका खुट्टामा त्यो घोप्ट्यो,","poem":1},{"text":"त्यो लोट्यो, र पल्टियो।","poem":2},{"text":"तिनकै खुट्टामा त्यो घोप्टेर पल्टिरह्‍यो;","poem":1},{"text":"त्यो पल्टेको ठाउँमा त्यो मर्‍यो, र त्यहीँ पल्टिरह्‍यो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“सीसराकी आमाले झ्यालदेखि बाहिर चियाइन्;","poem":1},{"text":"आँखीझ्यालको पछिल्तिरबाट तिनी चिच्याएर भनिन्,","poem":2},{"text":"‘तिनका रथ आउनलाई किन ढिलो भयो?","poem":1},{"text":"तिनको रथका खटखट आवाज आउन किन ढिलो भयो?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"तब तिनका सबैभन्दा बुद्धिमती स्त्रीले जवाफ दिइन्;","poem":1},{"text":"साँच्‍चै उनले आफूसित भन्‍ने गर्छिन्,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘के तिनीहरूले लुटका माल बटुलेर भाग लगाउँदैनन् र?","poem":1},{"text":"प्रत्येक मानिसका निम्ति एउटी वा दुईटी स्त्रीहरू,","poem":2},{"text":"सीसराका निम्ति लुटेका रङ्गीन कपडाहरू,","poem":1},{"text":"बुट्टेदार रङ्गीन कपडाहरू;","poem":2},{"text":"मेरो गलाको निम्ति अति बुट्टेदार कपडाहरू—","poem":1},{"text":"यो सबै लुटसरह हुँदैनन् र?’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“हे याहवेह, तपाईंका सबै शत्रुहरू यसरी नै नाश होऊन्!","poem":1},{"text":"तर तपाईंलाई प्रेम गर्नेहरूचाहिँ","poem":2},{"lineBreak":true},{"text":"आफ्नो पराक्रममा उदय भएको सूर्यझैँ होऊन्।”","poem":2},"त्यसपछि देशमा चालीस वर्षसम्म शान्ति भयो।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}