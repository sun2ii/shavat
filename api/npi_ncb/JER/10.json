{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["परमेश्‍वर र मूर्तिहरू"]},{"type":"verse","number":1,"content":["हे इस्राएलका घराना हो, याहवेहले तिमीहरूलाई के भन्दै हुनुहुन्छ, सो सुन।"]},{"type":"verse","number":2,"content":["उहाँले तिमीहरूलाई यसो भन्‍नुहुन्छ:",{"text":"“अरू राष्ट्रहरूका मार्गहरू नसिक,","poem":1},{"text":"अथवा आकाशका चिन्हहरूद्वारा नआत्तिओ;","poem":2},{"lineBreak":true},{"text":"यद्यपि ती राष्ट्रहरूचाहिँ ती चिन्हहरूद्वारा आत्तिन्छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"किनकि तिनीहरूका रीतिरिवाजहरू व्यर्थका छन्;","poem":1},{"text":"तिनीहरूले जङ्गलबाट एउटा रूख काट्छन्;","poem":2},{"lineBreak":true},{"text":"अनि शिल्पकारले आफ्नो हतियारले त्यसलाई आकार दिन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरूले त्यसलाई चाँदी र सुनले सिँगार्छन्;","poem":1},{"text":"हथौडाले काँटी ठोकेर तिनीहरूले त्यसलाई जोड्छन्,","poem":2},{"lineBreak":true},{"text":"ताकि त्यो यताउता नहल्‍लिओस्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"काँक्राबारीमा काग धपाउन राखिएको पुत्लाझैँ,","poem":1},{"text":"तिनीहरूका मूर्तिहरू बोल्न सक्दैनन्;","poem":2},{"text":"किनकि ती हिँड्न सक्दैनन्।","poem":1},{"text":"ती मूर्तिहरूलाई बोकेर लैजानुपर्छ।","poem":2},{"text":"तिनीहरूदेखि नडराओ;","poem":1},{"text":"तिनीहरूले कुनै पनि हानि गर्न सक्दैनन्,","poem":2},{"lineBreak":true},{"text":"न त तिनीहरूले कुनै असल कुरा नै गर्न सक्छन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"हे याहवेह, तपाईंजस्तो अरू कोही पनि छैन;","poem":1},{"text":"तपाईं महान् हुनुहुन्छ;","poem":2},{"lineBreak":true},{"text":"अनि तपाईंको नाम महान् र शक्तिशाली छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"हे राष्ट्रहरूका राजा,","poem":1},{"text":"तपाईंसँग कोचाहिँ डराउँदैन र?","poem":2},{"lineBreak":true},{"text":"किनकि तपाईं आदरयोग्य हुनुहुन्छ।","poem":2},{"text":"राष्ट्रहरूका सबै बुद्धिमान् मानिसहरू","poem":1},{"text":"र तिनीहरूका सबै राज्यहरूमा","poem":2},{"lineBreak":true},{"text":"तपाईंजस्तो अरू कोही छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"तिनीहरू सबै विवेकहीन र मूर्ख छन्;","poem":1},{"text":"तिनीहरू काम नलाग्ने काठका मूर्तिहरूद्वारा सिकाइएका छन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मूर्ति बनाउन तर्शीशबाट पिटिएको चाँदी र","poem":1},{"text":"उपाजबाट सुन ल्याइन्छ।","poem":2},{"text":"शिल्पकार र सुनारद्वारा त्यसलाई बनाइन्छ;","poem":1},{"text":"अनि त्यसमा निलो र बैजनी रङ्गको लुगा लगाइन्छ।","poem":2},{"lineBreak":true},{"text":"ती सबै थोक सिपालु कारिगरहरूद्वारा बनाइएका छन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तर याहवेह सत्य परमेश्‍वर हुनुहुन्छ;","poem":1},{"text":"उहाँ जीवित र अनन्तसम्मका राजा हुनुहुन्छ।","poem":2},{"text":"जब उहाँ रिसाउनुहुन्छ, पृथ्वी थरथर काँप्छ;","poem":1},{"text":"राष्ट्रहरूले उहाँको क्रोध सहनै सक्दैनन्।","poem":2}]},{"type":"verse","number":11,"content":["“तिनीहरूलाई यसो भन्: ‘यी देवताहरू, जसले स्वर्ग र पृथ्वी बनाएनन्, ती पृथ्वी र आकाशमुनिबाट नष्‍ट हुनेछन्।’ ”"]},{"type":"verse","number":12,"content":[{"text":"तर परमेश्‍वरले पृथ्वी आफ्नो शक्तिद्वारा बनाउनुभयो;","poem":1},{"text":"उहाँले संसारलाई आफ्नो बुद्धिले स्थापित गर्नुभयो;","poem":2},{"lineBreak":true},{"text":"र उहाँले आकाशलाई आफ्नो समझशक्तिले फैलाउनुभयो।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"जब उहाँ बोल्नुहुन्छ, तब आकाशमा पानीको गर्जन हुन्छ;","poem":1},{"text":"उहाँले बादललाई पृथ्वीको अन्तिम छेउबाट उठाउनुहुन्छ।","poem":2},{"text":"उहाँले झरीसँग बिजुली पठाउनुहुन्छ;","poem":1},{"text":"अनि हावालाई उहाँको भण्डारहरूबाट निकाल्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"हरेक मानिस विवेकहीन र ज्ञानहीन छ;","poem":1},{"text":"हरेक सुनार आफ्नै मूर्तिहरूद्वारा शर्ममा पर्नेछ।","poem":2},{"text":"किनकि त्यसले बनाएका मूर्तिहरू झूटा हुन्;","poem":1},{"text":"तिनीहरूमा जीवनको सास हुँदैन।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ती मूर्तिहरू सबै व्यर्थका र ठट्टाका पात्र हुन्;","poem":1},{"text":"जब तिनीहरूको न्याय आउँछ, तब तिनीहरू नष्‍ट हुनेछन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"उहाँ, जो याकोबका अंश हुनुहुन्छ, उहाँ ती मूर्तिहरूजस्ता हुनुहुन्‍न;","poem":1},{"text":"किनकि उहाँ सबै कुराहरूको सृष्‍टिकर्ता हुनुहुन्छ,","poem":2},{"text":"जसमा इस्राएल, उहाँको उत्तराधिकारका मानिसहरू पनि सामेल छन्;","poem":1},{"text":"सेनाहरूका याहवेह उहाँको नाम हो।","poem":2}]},{"type":"heading","content":["आउन लागेको विनाश"]},{"type":"verse","number":17,"content":[{"text":"हे घेराउमा परेर बसेका यरूशलेमका बासिन्दाहरू हो,","poem":1},{"text":"देश छोड्नलाई आफ्ना सरसामानहरू बटुल।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"किनकि याहवेह यसो भन्‍नुहुन्छ:","poem":1},{"text":"“यसै समयमा म यस देशमा बस्‍नेहरूलाई","poem":2},{"lineBreak":true},{"text":"झटारो हानेर निकालिदिनेछु;","poem":2},{"text":"म तिनीहरूमाथि सङ्कष्‍ट ल्याउनेछु,","poem":1},{"text":"ताकि तिनीहरू पक्राउ परून्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"मेरो चोटको खातिर मलाई धिक्‍कार छ!","poem":1},{"text":"मेरो चोट निको नहुने किसिमको छ!","poem":2},{"text":"तापनि मैले आफूलाई भनेँ,","poem":1},{"text":"“यो मेरो रोग हो, र मैले यसलाई सहनैपर्छ।”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"मेरो पाल भत्काइएको छ;","poem":1},{"text":"पालका सबै डोरीहरू चुडाइएका छन्।","poem":2},{"text":"मेरा छोराछोरीहरू मबाट गइसकेका छन् र अब कोही पनि छैन;","poem":1},{"text":"अब मेरो पाल टाँगिदिने","poem":2},{"lineBreak":true},{"text":"अथवा मेरो वासस्थान ठिक गरिदिने कोही पनि बाँकी छैन।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"गोठालाहरू विवेकहीन भएका छन्,","poem":1},{"text":"र तिनीहरू याहवेहको खोजी गर्दैनन्;","poem":2},{"text":"यसैकारण तिनीहरू सफल हुँदैनन्;","poem":1},{"text":"अनि तिनीहरूका सबै बगालहरू छरपस्ट भएका छन्।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"सुन! यस्तो खबर आइरहेको छ,","poem":1},{"text":"उत्तरको देशबाट एउटा ठूलो होहल्‍ला आइरहेछ!","poem":2},{"text":"यसले यहूदाका सहरहरूलाई उजाड पार्नेछ,","poem":1},{"text":"र स्यालहरूका ओडार बनाउनेछ।","poem":2}]},{"type":"heading","content":["यर्मियाको प्रार्थना"]},{"type":"verse","number":23,"content":[{"text":"हे याहवेह, म जान्दछु, मानिसको जीवन उसको आफ्नो हातमा छैन;","poem":1},{"text":"तिनीहरू आफैँले आफ्ना पाइलाहरूलाई निर्देशन गर्दैनन्।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"हे याहवेह, मलाई सुधार्नुहोस्, तर तपाईंको न्यायअनुसार,","poem":1},{"text":"तपाईंको रिसमा चाहिँ होइन;","poem":2},{"lineBreak":true},{"text":"नत्रता तपाईंले मलाई भष्म पारिदिनुहुनेछ।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तपाईंको क्रोध ती राष्ट्रहरूमाथि खन्याइदिनुहोस्,","poem":1},{"text":"जसले तपाईंलाई परमेश्‍वर भनी स्वीकार गर्दैनन्;","poem":2},{"lineBreak":true},{"text":"ती मानिसहरूमाथि, जसले तपाईंको नाम पुकार्दैनन्।","poem":2},{"text":"किनकि तिनीहरूले याकोबलाई निलेका छन्;","poem":1},{"text":"तिनीहरूले तिनलाई सर्लक्‍कै निलेका छन्;","poem":2},{"lineBreak":true},{"text":"अनि तिनको जन्मभूमिलाई उजाड पारिदिएका छन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}