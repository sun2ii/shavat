{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["यर्मियाको गुनासो"]},{"type":"verse","number":1,"content":[{"text":"जब म मेरो मुद्दा तपाईंकहाँ राख्दछु,","poem":1},{"text":"तब याहवेह, तपाईं सदैव धर्मी हुनुहुन्छ।","poem":2},{"text":"तापनि म तपाईंसँग तपाईंको न्यायको बारेमा कुरा गर्न चाहन्छु:","poem":1},{"text":"किन दुष्‍ट मानिसहरू सफल हुन्छन्?","poem":2},{"lineBreak":true},{"text":"किन सबै अधर्मीहरू सुखी जीवन जिउँछन्?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तपाईंले तिनीहरूलाई रोप्नुभयो र तिनीहरूले जरा हाले;","poem":1},{"text":"तिनीहरू बढ्छन् र फल फलाउँछन्।","poem":2},{"text":"तिनीहरूको मुखले त सधैँ तपाईंको नाम लिन्छन्,","poem":1},{"text":"तर तिनीहरूका हृदयबाट भने तपाईं टाढा हुनुहुन्छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तर हे याहवेह, तपाईंले मलाई जान्‍नुहुन्छ;","poem":1},{"text":"तपाईंले मलाई देख्नुहुन्छ र तपाईंप्रतिका मेरा विचारहरू जाँच्नुहुन्छ।","poem":2},{"text":"तिनीहरूलाई काट्न लगिएका भेडालाई जस्तै तानेर लैजानुहोस्!","poem":1},{"text":"तिनीहरूलाई मारिने दिनको निम्ति अलग गर्नुहोस्!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कहिलेसम्म देश उजाड अवस्थामा रहिरहने","poem":1},{"text":"र मैदानको घाँस ओइलिरहने?","poem":2},{"text":"किनकि त्यस ठाउँमा बस्‍नेहरू दुष्‍ट छन्;","poem":1},{"text":"जनावरहरू र चराहरू नष्‍ट भएका छन्।","poem":2},{"text":"यसबाहेक, मानिसहरूले यसो भनिरहेका छन्,","poem":1},{"text":"“हामीमाथि के हुँदैछ, परमेश्‍वरले देख्नुहुनेछैन।”","poem":2}]},{"type":"heading","content":["परमेश्‍वरको जवाफ"]},{"type":"verse","number":5,"content":[{"text":"“तँ मानिसहरूसँग दगुर्दा","poem":1},{"text":"तिनीहरूले तँलाई थकाए भने,","poem":2},{"lineBreak":true},{"text":"कसरी तँ घोडाहरूसित दगुर्न सक्छस्?","poem":2},{"text":"यदि तँ सुरक्षित देशमा त ठेस खान्छस् भने,","poem":1},{"text":"यर्दनका छेउछाउका काँढे झाडीहरूमा झन् के गर्छस्?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तेरा दाजुभाइहरू, तेरा आफ्नै परिवारका सदस्यहरू,","poem":1},{"text":"तिनीहरूले समेत तँलाई धोका दिएका छन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूले तेरो विरुद्धमा बोलेका छन्।","poem":2},{"text":"तिनीहरूले तँसँग मिठा-मिठा कुरा गरेका छन्,","poem":1},{"text":"तापनि तिनीहरूलाई विश्‍वास नगर्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“म आफ्नो घर इस्राएललाई त्यागिदिनेछु,","poem":1},{"text":"म आफ्नो उत्तराधिकारलाई छोडिदिनेछु;","poem":2},{"text":"मैले प्रेम गरेका मानिसहरूलाई","poem":1},{"text":"म तिनीहरूका शत्रुहरूका हातमा सुम्पिदिनेछु।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मेरो उत्तराधिकारीहरू मेरा निम्ति","poem":1},{"text":"जङ्गलको सिंहजस्तै भएका छन्।","poem":2},{"text":"तिनीहरू मसित गर्जन्छन्;","poem":1},{"text":"यसैकारण म तिनीहरूलाई घृणा गर्दछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"के मेरो उत्तराधिकार, मेरा निम्ति","poem":1},{"text":"शिकारी पक्षीहरूले वरिपरि घेरेर आक्रमण गरी","poem":2},{"lineBreak":true},{"text":"चोट लागेको चराझैँ भएको छैन?","poem":2},{"text":"जा, गएर सबै जङ्गली पशुहरूलाई भेला गर्;","poem":1},{"text":"तिनीहरूलाई खान ती पशुहरूलाई लिएर आइज।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"धेरै विदेशी शासकहरूले मेरो दाखबारीलाई नष्‍ट गर्नेछन्,","poem":1},{"text":"र मेरो भूमि कुल्चीमिल्ची पार्नेछन्;","poem":2},{"text":"तिनीहरूले मेरो सुन्दर भूमिलाई उजाड","poem":1},{"text":"र बाँझो बनाइदिनेछन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यो भूमि मेरो सामु सुक्खा,","poem":1},{"text":"उजाड र बाँझो बनाइनेछ;","poem":2},{"text":"समस्त देश उजाड पारिनेछ;","poem":1},{"text":"किनकि त्यसको हेरचाह गर्ने कोही पनि छैन।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मरुभूमिका सम्पूर्ण अग्ला नाङ्गा डाँडाहरूमाथि","poem":1},{"text":"नाश गर्नेहरू हुल लागेर आउनेछन्;","poem":2},{"text":"किनकि याहवेहको तरवारले देशको","poem":1},{"text":"एक छेउदेखि अर्को छेउसम्म नाश गर्नेछ;","poem":2},{"lineBreak":true},{"text":"कोही पनि सुरक्षित रहनेछैन।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तिनीहरूले गहुँ छर्नेछन्, तर काँडाहरूको कटनी गर्नेछन्;","poem":1},{"text":"तिनीहरूले कडा परिश्रम गर्नेछन्, तर केही फाइदा हुनेछैन।","poem":2},{"text":"याहवेहको डरलाग्दो रिसको कारण,","poem":1},{"text":"तिनीहरू आफ्नो फसलमा लज्जित हुनेछन्।”","poem":2}]},{"type":"verse","number":14,"content":["याहवेह यसो भन्‍नुहुन्छ: “मैले आफ्ना मानिस, इस्राएलीहरूलाई दिएको उत्तराधिकारमाथि हात लगाउने मेरा सबै दुष्‍ट छिमेकीहरूलाई, म तिनीहरूका देशबाट उखेल्नेछु, र म तिनीहरूका बीचबाट यहूदाका घरानालाई उखेल्नेछु।"]},{"type":"verse","number":15,"content":["तर तिनीहरूलाई उखेलेपछि म तिनीहरूमाथि फेरि दया देखाउनेछु; अनि तिनीहरू हरेकलाई तिनीहरूका आफ्नै उत्तराधिकारको भूमि र तिनीहरूका आफ्नै देशमा फर्काएर ल्याउनेछु।"]},{"type":"verse","number":16,"content":["यदि तिनीहरूले मेरा मानिसहरूका चालचलनहरू राम्रोसँग सिकेर, ‘जीवित याहवेहको नाममा भनेर शपथ’ खाए भने तिनीहरूले एक पटक मेरा मानिसहरूलाई बाल-देवताको नाममा शपथ खान सिकाएका भए तापनि तिनीहरू मेरा मानिसहरूको बीचमा स्थापित हुनेछन्।"]},{"type":"verse","number":17,"content":["तर यदि कुनै पनि राष्ट्रले वचन पालन गरेन भने म त्यसलाई सम्पूर्ण रूपले उखेलेर नाश गर्नेछु,” याहवेह घोषणा गर्नुहुन्छ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}