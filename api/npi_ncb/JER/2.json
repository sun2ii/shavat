{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["इस्राएलले याहवेहलाई त्यागेको"]},{"type":"verse","number":1,"content":["याहवेहको वचन मकहाँ आयो:"]},{"type":"verse","number":2,"content":["“जा, र यरूशलेमका मानिसहरूले सुन्‍ने गरी घोषणा गर्:",{"lineBreak":true},"“याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘तेरो युवा अवस्थाको भक्ति म सम्झना गर्छु;","poem":1},{"text":"कसरी तैँले एउटी दुलहीले झैँ मलाई प्रेम गर्थिस्;","poem":2},{"text":"अनि बिउ नछरिएको भूमिमा,","poem":1},{"text":"मलाई मरुभूमिमा पछ्याइस्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"याहवेहका निम्ति इस्राएल पवित्र थियो;","poem":1},{"text":"उहाँको फसलको पहिलो फल थियो;","poem":2},{"text":"इस्राएललाई निल्नेहरू सबै दोषी ठहरिए;","poem":1},{"text":"अनि तिनीहरूमाथि विपत्ति आइलाग्यो,’ ”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे याकोबका सन्तान, इस्राएलका सबै वंशहरू हो,","poem":1},{"text":"याहवेहको वचन सुन।","poem":2}]},{"type":"verse","number":5,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“तिमीहरूका पितापुर्खाहरूले ममा के दोष भेट्टाए,","poem":1},{"text":"र तिनीहरू मबाट यति धेरै टाढा भए?","poem":2},{"text":"तिनीहरू काम नलाग्ने मूर्तिहरूका पछि लागेर","poem":1},{"text":"तिनीहरू आफैँ काम नलाग्ने भए।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिनीहरूले यसो भनी सोधेनन्, ‘याहवेह कहाँ हुनुहुन्छ?","poem":1},{"text":"जसले हामीलाई इजिप्टबाट ल्याउनुभयो;","poem":2},{"text":"र हामीलाई उजाडस्थानबाट","poem":1},{"text":"मरुभूमिको ठाउँ र खाडलबाट,","poem":2},{"text":"सुक्खा भूमि र घोर अन्धकार ठाउँबाट,","poem":1},{"text":"कुनै मानिस नहिँडेको र कोही नबसेको देशबाट डोर्‍याउनुभयो?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मैले तिमीहरूलाई मलिलो देशमा","poem":1},{"text":"त्यसका फलहरू र असल उब्जनी खानका निम्ति ल्याएँ।","poem":2},{"text":"तर तिमीहरू आयौ र मेरो देशलाई अशुद्ध पार्‍यौ;","poem":1},{"text":"अनि मेरो उत्तराधिकारलाई घृणित बनायौ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"पुजारीहरूले,","poem":1},{"text":"‘याहवेह कहाँ हुनुहुन्छ?’ भनी सोधेनन्;","poem":2},{"text":"व्यवस्थाका काम गर्नेहरूले मलाई चिनेनन्;","poem":1},{"text":"अगुवाहरूले मेरो विरुद्धमा विद्रोह गरे।","poem":2},{"text":"काम नलाग्ने मूर्तिहरूका पछि लागेर,","poem":1},{"text":"अगमवक्ताहरूले बाल-देवताको नाममा अगमवाणी गरे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“यसकारण म फेरि तिमीहरूको विरुद्धमा मुद्दा लगाउनेछु,”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"lineBreak":true},{"text":"“अनि म तिमीहरू, तिमीहरूका छोराछोरी","poem":2},{"lineBreak":true},{"text":"र नातिनातिनाहरूका विरुद्धमा मुद्दा लगाउनेछु।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"कित्तीमको","poem":1},{"noteId":1},{"text":"किनारपारि गएर हेर्,","poem":1},{"text":"केदार","poem":2},{"noteId":2},{"text":"मरुभूमिमा पठा, र ध्यानपूर्वक हेर्;","poem":2},{"lineBreak":true},{"text":"त्यहाँ यस्तो कहिल्यै भएको छ कि छैन, सो पत्ता लगा:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"के कुनै राष्ट्रले आफ्ना देवी-देवताहरू बदली गरेका छन्?","poem":1},{"text":"(यद्यपि तिनीहरू देवता नै होइनन्।)","poem":2},{"text":"तर मेरो आफ्नै जातिले आफ्ना महिमित परमेश्‍वरलाई","poem":1},{"text":"व्यर्थका मूर्तिहरूसित साटेका छन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"हे आकाशमण्डल हो, तिमीहरू यस कुरामा चकित होओ;","poem":1},{"text":"अनि भयानक डरले थरथर काम,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“मेरा मानिसहरूले दुई वटा पापहरू गरेका छन्:","poem":1},{"lineBreak":true},{"text":"तिनीहरूले मलाई त्यागेका छन्,","poem":1},{"text":"जिउँदो पानीको मूललाई;","poem":2},{"text":"अनि तिनीहरूले पानी नअडिने","poem":1},{"text":"आफ्नै कुवाहरू खनेका छन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"के इस्राएल एउटा सेवक, जन्मजात दास हो र?","poem":1},{"text":"तब किन त्यो लुटिएको छ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"सिंहहरू गर्जेका छन्;","poem":1},{"text":"तिनीहरूले इस्राएललाई झम्टेका छन्।","poem":2},{"text":"तिनीहरूले त्यसको भूमिलाई उजाड पारिदिएका छन्;","poem":1},{"text":"त्यसका सहरहरू जलाइएका र त्यागिएका छन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"मेम्फिस र तहपनेसका मानिसहरूले पनि","poem":1},{"text":"तिमीहरूका खप्परलाई कुच्याइदिएका छन्।”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"जब तिमीहरूलाई याहवेह तिमीहरूका परमेश्‍वरले बाटोमा डोर्‍याउँदै हुनुहुन्थ्यो,","poem":1},{"text":"तब उहाँलाई तिमीहरूले त्यागेर,","poem":2},{"lineBreak":true},{"text":"यो कुरा आफैँमाथि ल्याएका होइनौ र?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"अब नील","poem":1},{"noteId":3},{"text":"नदीबाट पानी पिउन","poem":1},{"text":"इजिप्टमा किन जान्छौ?","poem":2},{"text":"अनि यूफ्रेटिस नदीबाट पानी पिउन","poem":1},{"text":"अश्शूरमा किन जान्छौ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तिमीहरूको दुष्‍टताले तिमीहरूलाई दण्ड दिनेछ;","poem":1},{"text":"“तिमीहरूको धर्म-त्यागले तिमीहरूलाई हप्काउनेछ।","poem":2},{"text":"तिमीहरूले याहवेह","poem":1},{"text":"तिमीहरूका आफ्ना परमेश्‍वरलाई त्यागेर मेरो भय नराख्दा","poem":2},{"text":"त्यो तिमीहरूका निम्ति कति दुष्‍टता","poem":1},{"text":"र तितोपना हुनेछ भनी विचार गरेर जान,”","poem":2},{"lineBreak":true},{"text":"सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“धेरै समयअगि नै तैँले आफ्नो जुवा भाँचिस्","poem":1},{"text":"र आफ्ना बन्धनहरू फुकाइस्;","poem":2},{"lineBreak":true},{"text":"तैँले भनिस्, ‘म तपाईंको सेवा गर्नेछैनँ!’","poem":2},{"text":"अनि प्रत्येक अग्ला डाँडाहरूमाथि","poem":1},{"text":"र हरेक झ्याम्म परेको रूखमुनि","poem":2},{"lineBreak":true},{"text":"तँ वेश्याजस्तै ढल्किस्।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"मैले तँलाई एक असल र भरपर्दो बोटबाट","poem":1},{"text":"एउटा उत्तम दाखको बोटझैँ रोपेको थिएँ।","poem":2},{"text":"तर कसरी तँ मेरो विरुद्धमा खडा भएर,","poem":1},{"text":"भ्रष्‍ट जङ्गली दाखको बोट भइस्?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तैँले आफूलाई कडा साबुन","poem":1},{"text":"र सोडाले धोए तापनि","poem":2},{"lineBreak":true},{"text":"तेरो अपराधको दाग अझै पनि मेरो सामु रहेको छ,”","poem":2},{"lineBreak":true},{"text":"प्रभु याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“कसरी तैँले भन्‍न सक्छस्, ‘म अशुद्ध भएको छैनँ;","poem":1},{"text":"म बाल-देवताहरूका पछि लागेको छैनँ?’","poem":2},{"text":"हेर्, तैँले बेँसीमा कस्तो व्यवहार गरेको थिइस्;","poem":1},{"text":"तैँले के गरेको थिइस्, सो विचार गर्।","poem":2},{"text":"तँ त यताउता दौडिहिँड्ने","poem":1},{"text":"उत्तेजित ऊँटजस्तै छस्,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"उजाडस्थानमा रहने बानी भएकी, कामुक भएर","poem":1},{"text":"हावा सुँघिहिँड्ने जङ्गली गधैनीजस्तै।","poem":2},{"lineBreak":true},{"text":"त्यसको उन्मात कामुकतालाई कसले रोक्न सक्छ?","poem":2},{"text":"त्यसलाई पछ्याउने गधाहरूले आफूलाई थकाउनुपर्दैन;","poem":1},{"text":"कामवासनाको समयमा तिनीहरूले त्यसलाई भेट्टाइहाल्छन्।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तेरा खुट्टा नाङ्गो नभएसम्म","poem":1},{"text":"र तेरो घाँटी तिर्खाले सुक्खा नहुन्जेल नकुद्।","poem":2},{"text":"तर तैँले भनिस्, ‘म फर्कन सक्दिनँ!","poem":1},{"text":"म विदेशी देवताहरूलाई प्रेम गर्छु;","poem":2},{"lineBreak":true},{"text":"अनि मैले तिनीहरूलाई पछ्याउनैपर्छ।’","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“पक्राउ पर्दा चोर लज्जित भएझैँ,","poem":1},{"text":"इस्राएलको घराना लज्जित भएको छ;","poem":2},{"text":"अर्थात् तिनीहरू, आफ्ना राजाहरू र तिनीहरूका अधिकारीहरू,","poem":1},{"text":"तिनीहरूका पुजारीहरू र तिनीहरूका अगमवक्ताहरू सबै लज्जित भएका छन्।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"तिनीहरूले काठलाई भन्छन्, ‘तपाईं मेरा पिता हुनुहुन्छ,’","poem":1},{"text":"अनि ढुङ्गालाई भन्छन्, ‘तपाईंले मलाई जन्माउनुभयो।’","poem":2},{"text":"तिनीहरूले मतिर मुख होइन,","poem":1},{"text":"तर आफ्नो पिठिउँ फर्काएका छन्;","poem":2},{"text":"तापनि तिनीहरू विपत्तिमा पर्दा तिनीहरू भन्छन्,","poem":1},{"text":"‘आएर हामीलाई बचाउनुहोस्!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"त्यसो भए तिमीहरूले आफ्ना निम्ति बनाएका देवी-देवताहरू चाहिँ कहाँ छन् त?","poem":1},{"text":"तिमीहरू विपत्तिमा परेको बेला","poem":2},{"lineBreak":true},{"text":"तिनीहरूले बचाउन सक्छन् भने तिनीहरू आऊन्!","poem":2},{"text":"किनकि हे यहूदा, तँसित जति सहरहरू छन्,","poem":1},{"text":"त्यति नै धेरै देवी-देवताहरू पनि छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“तिमीहरू मेरो विरुद्धमा किन अभियोग लगाउँछौ?","poem":1},{"text":"तिमीहरू सबै मेरो विरुद्धमा बागी भएका छौ,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“मैले व्यर्थैमा तिम्रा मानिसहरूलाई दण्ड दिएँ;","poem":1},{"text":"किनकि तिनीहरूले सुध्रिन मानेनन्।","poem":2},{"text":"तिमीहरूका तरवारले तिमीहरूका अगमवक्ताहरूलाई","poem":1},{"text":"निलिहाल्ने शिकारी सिंहले जस्तै नाश गरेका छौ।","poem":2}]},{"type":"verse","number":31,"content":["“यस पुस्ताका मानिसहरू, तिमीहरूले याहवेहको वचन विचार गर:",{"text":"“के म इस्राएलका निम्ति मरुभूमि","poem":1},{"text":"अथवा घोर अन्धकारको देशजस्तै भएको छु?","poem":2},{"text":"किन मेरा मानिसहरूले यसो भन्छन्, ‘हामी आफूखुशी गर्न स्वतन्त्र छौँ;","poem":1},{"text":"हामी तपाईंकहाँ फेरि फर्केर आउनेछैनौँ?’","poem":2}]},{"type":"verse","number":32,"content":[{"text":"के एउटी कन्याले आफ्ना गरगहना, वा","poem":1},{"text":"एउटी दुलहीले आफ्नो विवाहका गरगहनाहरू बिर्सन सक्छे र?","poem":2},{"text":"तापनि मेरा मानिसहरूले,","poem":1},{"text":"धेरै समयदेखि मलाई बिर्सेका छन्।","poem":2}]},{"type":"verse","number":33,"content":[{"text":"तँ प्रेमिका पछि लाग्नलाई कति सिपालु छेस्!","poem":1},{"text":"अति दुष्‍ट स्त्रीहरूले पनि तेरो चालहरूबाट सिक्न सक्छन्।","poem":2}]},{"type":"verse","number":34,"content":[{"text":"तेरा लुगाहरूमा निर्दोष गरिबहरूको","poem":1},{"text":"रगत भेटिन्छ,","poem":2},{"lineBreak":true},{"text":"यद्यपि तैँले तिनीहरूले घर फोर्दै गरेको भेट्टाइनस्।","poem":2},{"text":"तर यी सबै कुरा हुँदा-हुँदै पनि","poem":1}]},{"type":"verse","number":35,"content":[{"text":"तँ भन्छस्, ‘म त निर्दोष छु;","poem":2},{"lineBreak":true},{"text":"उहाँ मसित रिसाउनुभएको छैन।’","poem":2},{"text":"तर तैँले, ‘मैले पाप गरेकी छैनँ’","poem":1},{"text":"भनेकै कारण म तेरो न्याय गर्नेछु।","poem":2}]},{"type":"verse","number":36,"content":[{"text":"तँ किन आफ्ना मार्गहरू बदलेर,","poem":1},{"text":"यताउता डुलिहिँड्छस्?","poem":2},{"text":"अश्शूरले तँलाई निराश तुल्याएजस्तै","poem":1},{"text":"तँ इजिप्टबाट पनि निराश हुनेछस्।","poem":2}]},{"type":"verse","number":37,"content":[{"text":"तैँले त्यो ठाउँलाई पनि","poem":1},{"text":"आफ्ना हात आफ्नै थाप्लोमा राखेर छाड्नेछस्;","poem":2},{"text":"किनकि तैँले भरोसा राखेकाहरूलाई याहवेहले त्याग्नुभएको छ;","poem":1},{"text":"तैँले तिनीहरूबाट सहायता पाउनेछैनस्।","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":1,"caller":"+","text":"साइप्रस र पश्‍चिमी किनारपारि","reference":{"chapter":2,"verse":10}},{"noteId":2,"caller":"+","text":"सिरिया-अरबी मरुभूमि","reference":{"chapter":2,"verse":10}},{"noteId":3,"caller":"+","text":"मूल भाषामा शीहोर","reference":{"chapter":2,"verse":18}}]},"thisChapterLink":"/api/npi_ncb/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}