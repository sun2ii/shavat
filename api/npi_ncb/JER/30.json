{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["इस्राएलको पुनर्स्थापन"]},{"type":"verse","number":1,"content":["यर्मियाकहाँ आएको याहवेहको वचन यही हो:"]},{"type":"verse","number":2,"content":["“याहवेह इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘मैले तँलाई भनेका सबै कुराहरू एउटा पुस्तकमा लेख्।"]},{"type":"verse","number":3,"content":["हेर, दिनहरू आउँदैछन्,’ याहवेह घोषणा गर्नुहुन्छ, ‘जब म मेरो प्रजा इस्राएल र यहूदालाई कैदबाट फर्काएर ल्याउनेछु, तब मैले तिनीहरूका पितापुर्खाहरूलाई अधिकारमा दिएको देशमा तिनीहरूलाई पुनर्स्थापित गर्नेछु,’ याहवेह भन्‍नुहुन्छ।”"]},{"type":"verse","number":4,"content":["इस्राएल र यहूदाको बारेमा याहवेहले भन्‍नुभएको कुराहरू यिनै हुन्:"]},{"type":"verse","number":5,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“डराएकाहरूका चीत्कार सुनिँदैछ—","poem":1},{"text":"त्रासको चीत्कार, शान्तिको होइन।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"अहिले सोध र हेर:","poem":1},{"text":"के कुनै पुरुषले छोराछोरी जन्माउन सक्छ?","poem":2},{"text":"त्यसो भए किन म हरेक बलियो पुरुषले","poem":1},{"text":"सुत्केरी व्यथामा परेकी स्त्रीले जस्तै आफ्नो हात आफ्नो पेटमाथि राखेको,","poem":2},{"lineBreak":true},{"text":"र हरेक अनुहार मरेको जस्तै पहेँलो भएको देख्छु?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"हाय! त्यो दिन अति भयानक दिन हुनेछ!","poem":1},{"text":"त्यस्तो अरू कुनै दिन पनि हुनेछैन।","poem":2},{"text":"त्यो दिन याकोबका निम्ति सङ्कष्‍टको समय हुनेछ;","poem":1},{"text":"तर ऊ त्यसबाट बचाइनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘त्यस दिन,’ सेनाहरूका याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"text":"‘म तिनीहरूका काँधबाट जुवा भाँचिदिनेछु;","poem":2},{"text":"अनि तिनीहरूका बन्धन फुकाइदिनेछु;","poem":1},{"text":"अब फेरि तिनीहरूलाई विदेशीहरूले कमारा बनाउने छैनन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यसको सट्टामा तिनीहरूले याहवेह आफ्ना परमेश्‍वरको","poem":1},{"text":"र तिनीहरूका राजा दावीदको सेवा गर्नेछन्,","poem":2},{"lineBreak":true},{"text":"जसलाई म तिनीहरूका निम्ति खडा गर्नेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘यसकारण हे मेरो सेवक याकोब, नडरा;","poem":1},{"text":"हे इस्राएल, हताश नहो,’","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"text":"‘म निश्‍चय नै तँलाई टाढाको ठाउँबाट र","poem":1},{"text":"तेरा सन्तानहरूलाई बेबिलोनको कैदबाट बचाउनेछु।","poem":2},{"text":"याकोब फेरि शान्ति र सुरक्षामा हुनेछ;","poem":1},{"text":"अनि कसैले पनि इस्राएललाई भयभीत पार्न सक्नेछैन।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"म तेरो साथमा छु, र तँलाई बचाउनेछु,’","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"text":"‘मैले तँलाई जुन राष्ट्रहरूको बीचमा छरपस्ट पारेँ,","poem":1},{"text":"ती राष्ट्रहरूलाई सम्पूर्ण रूपले नाश गरे तापनि","poem":2},{"lineBreak":true},{"text":"म तँलाईचाहिँ पूर्ण रूपले नाश गर्नेछैनँ।","poem":2},{"text":"तर म तँलाई विनादण्ड चाहिँ छोड्नेछैनँ;","poem":1},{"text":"म तँलाई न्यायपूर्वक दण्ड दिनेछु।’","poem":2}]},{"type":"verse","number":12,"content":["“याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘तेरो चोट निको नहुने खालको छ;","poem":1},{"text":"तेरो घाउ पीडादायी छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तेरो पक्षमा बोलिदिने कोही पनि छैन;","poem":1},{"text":"तेरो घाउको निम्ति कुनै उपचार छैन;","poem":2},{"lineBreak":true},{"text":"अनि तेरो निम्ति कुनै चङ्गाइ छैन।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तेरा सबै मित्रहरूले तँलाई बिर्सेका छन्;","poem":1},{"text":"तिनीहरूले तेरो कुनै वास्ता गर्दैनन्।","poem":2},{"text":"मैले तँलाई शत्रुले झैँ प्रहार गरेको छु;","poem":1},{"text":"अनि निष्‍ठुरीले झैँ तँलाई दण्ड दिएको छु;","poem":2},{"text":"किनकि तेरो अपराध अति ठूलो","poem":1},{"text":"र तेरा पापहरू अति धेरै छन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तँ आफ्नो घाउले गर्दा","poem":1},{"text":"र तेरो निको नहुने पीडाको निम्ति किन रुन्छस्?","poem":2},{"text":"तेरो ठूलो अपराध र धेरै पापहरूका कारण","poem":1},{"text":"मैले तँसँग यी कुराहरू गरेको हुँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ ‘तर तँलाई निल्नेहरू सबै अरूद्वारा निलिनेछन्;","poem":1},{"text":"तेरा सबै शत्रुहरू निर्वासनमा जानेछन्।","poem":2},{"text":"तँलाई लुट्नेहरू अरूद्वारा लुटिनेछन्;","poem":1},{"text":"तँलाई बिगार्नेहरूलाई म बिगारिदिनेछु।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तर म तँलाई फेरि स्वस्थ तुल्याउनेछु,","poem":1},{"text":"र तेरा घाउहरू निको पार्नेछु,’ याहवेह घोषणा गर्नुहुन्छ;","poem":2},{"text":"‘किनकि तँलाई बहिष्कृत गरिएका भनिनेछ,","poem":1},{"text":"सियोन, जसको कसैले वास्ता गर्दैन।’","poem":2}]},{"type":"verse","number":18,"content":["“याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ ‘हेर, म याकोबको पालको सुख-शान्ति पुनर्स्थापित गर्नेछु,","poem":1},{"text":"र त्यसको वासस्थानमाथि दया देखाउनेछु;","poem":2},{"text":"त्यो सहर त्यसकै भग्नावशेषमाथि पुनर्निर्माण हुनेछ;","poem":1},{"text":"अनि राजमहल पहिलेकै आफ्नै स्थानमा खडा हुनेछ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तिनीहरूबाट धन्यवादका स्तुतिगान","poem":1},{"text":"र आनन्दको सोर निस्कनेछ।","poem":2},{"text":"म तिनीहरूका संख्याको वृद्धि गर्नेछु;","poem":1},{"text":"अनि तिनीहरू घट्नेछैनन्;","poem":2},{"text":"म तिनीहरूलाई आदर दिनेछु;","poem":1},{"text":"अनि तिनीहरू अपहेलित हुनेछैनन्।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तिनीहरूका छोराछोरीहरू पहिलेकै जस्तै हुनेछन्;","poem":1},{"text":"अनि तिनीहरूको समुदाय मेरो सामु स्थापित गरिनेछ;","poem":2},{"lineBreak":true},{"text":"तिनीहरूलाई थिचोमिचो गर्ने सबैलाई म दण्ड दिनेछु।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तिनीहरूको अगुवा तिनीहरूकै आफ्नै जातिबाट हुनेछ;","poem":1},{"text":"तिनीहरूको शासक तिनीहरूमध्येबाट खडा हुनेछ।","poem":2},{"text":"म त्यसलाई मेरो नजिक ल्याउनेछु र त्यो मेरो नजिक आउनेछ;","poem":1},{"text":"किनकि आफैँले साहस गरेर","poem":2},{"lineBreak":true},{"text":"को मेरो नजिक आउनसक्छ र?’","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"‘यसरी तिमीहरू मेरो प्रजा हुनेछौ;","poem":1},{"text":"अनि म तिमीहरूले सेवा गर्ने परमेश्‍वर हुनेछु।’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"हेर, याहवेहको रिस","poem":1},{"text":"आँधीबेहरीजस्तै फुटेर निस्कनेछ;","poem":2},{"text":"अनि दुष्‍टहरूका टाउकोमाथि","poem":1},{"text":"त्यो बतासको भुमरी जोडसित बजारिनेछ।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"जबसम्म याहवेहले उहाँको हृदयको उद्देश्यहरू","poem":1},{"text":"पूर्ण रूपमा पूरा गर्नुहुन्‍न,","poem":2},{"lineBreak":true},{"text":"तबसम्म उहाँको भयानक रिस शान्त हुनेछैन।","poem":2},{"text":"आउने दिनहरूमा","poem":1},{"text":"तिमीहरूले यो कुरा बुझ्नेछौ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}