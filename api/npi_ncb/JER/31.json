{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["याहवेह घोषणा गर्नुहुन्छ, “त्यस बेला म इस्राएलका सबै घरानाहरूका परमेश्‍वर हुनेछु, र तिनीहरू मेरा मानिसहरू हुनेछन्।”"]},{"type":"verse","number":2,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“तरवारबाट बाँचेका मानिसहरूले","poem":1},{"text":"मरुभूमिमा निगाह पाउनेछन्;","poem":2},{"lineBreak":true},{"text":"म इस्राएललाई विश्राम दिनका लागि आउनेछु।”","poem":2}]},{"type":"verse","number":3,"content":["बितेको समयमा याहवेह हामीकहाँ देखा पर्नुभयो र भन्‍नुभयो:",{"text":"“अनन्त प्रेमले मैले तँलाई प्रेम गरेको छु;","poem":1},{"text":"अचुक कृपाले मैले तँलाई आकर्षित गरेको छु।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"म तँलाई फेरि निर्माण गर्नेछु;","poem":1},{"text":"अनि हे कन्या इस्राएल, तँ फेरि निर्माण गरिनेछस्।","poem":2},{"text":"तँ फेरि आफ्नो खैँजडी लिएर","poem":1},{"text":"आनन्दसाथ नाच्दै निक्लनेछस्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तैँले फेरि सामरियाका डाँडाहरूमा","poem":1},{"text":"दाखबारीहरू लगाउनेछस्;","poem":2},{"text":"किसानहरूले दाखबारीहरू लगाउनेछन्,","poem":1},{"text":"र तिनीहरूले आफ्ना फलहरूबाट आनन्द लिनेछन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यस्तो दिन आउनेछ, जब पहरेदारहरू","poem":1},{"text":"एफ्राइमका डाँडाहरूमा यसरी कराउनेछन्,","poem":2},{"text":"‘आओ, हामी याहवेह हाम्रा परमेश्‍वरकहाँ","poem":1},{"text":"सियोनमा जाऔँ।’ ”","poem":2}]},{"type":"verse","number":7,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“याकोबका निम्ति आनन्दसाथ गाओ;","poem":1},{"text":"राष्ट्रहरूका प्रमुखका निम्ति चर्को सोरले कराओ।","poem":2},{"text":"उच्‍च सोरले प्रशंसा गरेर भन,","poem":1},{"text":"‘हे याहवेह, तपाईंको जाति","poem":2},{"lineBreak":true},{"text":"इस्राएलका बाँकी रहेकाहरूलाई बचाउनुहोस्।’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हेर, म तिनीहरूलाई उत्तरको देशबाट यहाँ फर्काएर ल्याउनेछु,","poem":1},{"text":"र तिनीहरूलाई पृथ्वीको पल्‍लो छेउबाट एकसाथ भेला गर्नेछु।","poem":2},{"text":"तिनीहरूका बीचमा अन्धा र लङ्गडा,","poem":1},{"text":"गर्भवती आमाहरू र प्रसुती वेदनामा परेका स्त्रीहरू हुनेछन्;","poem":2},{"lineBreak":true},{"text":"एउटा विशाल भीड फर्किनेछ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरू रुँदै-रुँदै फर्किआउनेछन्;","poem":1},{"text":"मैले तिनीहरूलाई फर्काएर ल्याउँदा तिनीहरूले प्रार्थना गर्नेछन्।","poem":2},{"text":"म तिनीहरूलाई पानीको मुहानका छेउबाट डोर्‍याउनेछु;","poem":1},{"text":"समतल बाटोबाट, जहाँ तिनीहरूले ठेस खानेछैनन्;","poem":2},{"text":"किनकि म इस्राएलका पिता हुँ,","poem":1},{"text":"र एफ्राइम मेरो जेठा छोरा हो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“हे राष्ट्रहरू हो, याहवेहको वचन सुन;","poem":1},{"text":"वचनलाई टाढा-टाढाका टापुसम्म घोषणा गर:","poem":2},{"text":"‘इस्राएललाई छरपस्ट पार्नुहुनेले तिनीहरूलाई भेला गर्नुहुनेछ,","poem":1},{"text":"र उहाँले आफ्नो बगाललाई गोठालोले झैँ हेरचाह गर्नुहुनेछ।’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"किनकि याहवेहले याकोबलाई छुटाउनुहुनेछ,","poem":1},{"text":"र तिनीहरूभन्दा बलिया शत्रुहरूका हातबाट तिनीहरूलाई मोल तिरेर छुटाउनुहुनेछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तिनीहरू आउनेछन् र सियोनका उच्‍च ठाउँहरूमा आनन्दसाथ गाउनेछन्;","poem":1},{"text":"याहवेहबाट प्रशस्ततामा तिनीहरू आनन्दित हुनेछन्—","poem":2},{"text":"अन्‍न, नयाँ दाखमद्य र जैतुनको तेल,","poem":1},{"text":"भेडाबाख्राका पाठापाठी र गाईबस्तुका बाछाबाछीहरूका कारण रमाहट गर्नेछन्।","poem":2},{"text":"तिनीहरू पानीले सिँचेको बगैँचाझैँ हुनेछन्,","poem":1},{"text":"अनि तिनीहरू फेरि दुःखी हुनेछैनन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तब तरुणीहरू, जवानहरू, वृद्धहरू","poem":1},{"text":"नाच्नेछन् र आनन्दित हुनेछन्।","poem":2},{"text":"म तिनीहरूको शोकलाई आनन्दमा परिणत गरिदिनेछु;","poem":1},{"text":"म तिनीहरूको शोकलाई सान्त्वना र आनन्दमा परिणत गरिदिनेछु।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"म पुजारीहरूलाई प्रशस्त भोजनले तृप्‍त पारिदिनेछु;","poem":1},{"text":"अनि मेरा मानिसहरू मेरो प्रशस्तताले भरिपूर्ण हुनेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":15,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“रामामा एउटा सोर सुनियो,","poem":1},{"text":"शोक र घोर विलापको सोर;","poem":2},{"text":"राहेल आफ्ना बालबच्‍चाको निम्ति रोइरहेकी,","poem":1},{"text":"र तिनले सान्त्वनालाई इन्कार गरेकी छिन्;","poem":2},{"lineBreak":true},{"text":"किनकि तिनीहरू अब रहेनन्।”","poem":2}]},{"type":"verse","number":16,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“तेरो रोदनको सोरलाई","poem":1},{"text":"र तेरो आँखाको आँसुलाई रोक्;","poem":2},{"text":"किनकि तेरो कामको इनाम पाउनेछेस्,”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"lineBreak":true},{"text":"“तिनीहरू शत्रुको देशबाट फर्कनेछन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"text":"“भविष्यको निम्ति तिमीहरूका सन्तानलाई आशा छ,","poem":2},{"lineBreak":true},{"text":"तिमीहरूका छोराछोरीहरू तिनीहरूका आफ्नै देशमा फर्कनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“वास्तवमै मैले एफ्राइमको विलाप सुनेको छु:","poem":1},{"text":"‘तपाईंले नसधाइएको बाछोलाई झैँ मलाई अनुशासन सिकाउनुभयो,","poem":2},{"lineBreak":true},{"text":"र म अनुशासित भएको छु।","poem":2},{"text":"मलाई पुनर्स्थापित गर्नुहोस्, र म फर्कनेछु;","poem":1},{"text":"किनकि तपाईं याहवेह नै मेरा परमेश्‍वर हुनुहुन्छ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"म बरालिएर गएपछि","poem":1},{"text":"मैले पश्‍चात्ताप गरेँ;","poem":2},{"text":"मैले बुझेपछि","poem":1},{"text":"मैले आफ्नो छाती पिटेँ।","poem":2},{"text":"म लज्जित भएँ, र शिर झुकाएँ;","poem":1},{"text":"किनकि मेरो युवावस्थाको अपमान मैले बोकेको थिएँ।’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"text":"के एफ्राइम मैले मन पराएको बालक,","poem":2},{"text":"मेरो प्यारो छोरा होइन र?","poem":1},{"text":"मैले त्यसको विरुद्धमा बोले तापनि","poem":2},{"text":"म अझै पनि त्यसको याद गर्छु।","poem":1},{"text":"यसकारण मेरो हृदय त्यसको निम्ति तड्पिन्छ;","poem":2},{"lineBreak":true},{"text":"म त्यसलाई निश्‍चय नै दया देखाउनेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“बाटोको निम्ति सङ्केत चिन्हहरू बना;","poem":1},{"text":"मार्गदर्शन गर्ने खम्बाहरू खडा गर्।","poem":2},{"text":"तैँले हिँड्नलाई छानेको बाटो,","poem":1},{"text":"त्यो राजमार्गतिर ध्यान लगा।","poem":2},{"text":"हे कन्या इस्राएल, फर्की,","poem":1},{"text":"तेरा आफ्नै सहरहरूमा फर्की।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ए अविश्‍वासी छोरी इस्राएल,","poem":1},{"text":"तँ कहिलेसम्म बरालिन्छेस्?","poem":2},{"text":"याहवेहले पृथ्वीमा एउटा नयाँ कुरा सृष्‍टि गर्नुहुनेछ—","poem":1},{"text":"अब स्त्री पुरुषकहाँ फर्किनेछे।”","poem":2}]},{"type":"verse","number":23,"content":["इस्राएलका परमेश्‍वर, सेनाहरूका याहवेह यसो भन्‍नुहुन्छ: “जब म तिनीहरूलाई कैदबाट फर्काएर ल्याउनेछु, तब यहूदाको देश र त्यसका सहरहरूमा भएका मानिसहरूले फेरि यी वचनहरू भन्‍नेछन्: ‘हे समृद्ध यरूशलेम, हे पवित्र पर्वत, याहवेहले तँलाई आशिष् देऊन्।’"]},{"type":"verse","number":24,"content":["यहूदा र त्यसका सबै सहरहरूमा भएका मानिसहरू, किसानहरू र आफ्ना बगालहरू लिएर यताउता डुलिहिँड्नेहरू सबै एकसाथ बस्‍नेछन्।"]},{"type":"verse","number":25,"content":["थाकेकाहरूलाई म फेरि ताजा बनाउनेछु र मूर्च्छा परेकाहरूलाई तृप्‍त पार्नेछु।”"]},{"type":"verse","number":26,"content":["यतिकैमा म बिउँझेँ, र मैले चारैतिर हेरेँ। मेरो निन्द्रा मलाई मिठो लागेको थियो।"]},{"type":"verse","number":27,"content":["याहवेह घोषणा गर्नुहुन्छ, “हेर, यस्ता दिनहरू आउँछन्, जब म इस्राएल र यहूदाका मानिसहरूलाई तिनीहरूका सन्तान र पशुहरूका बच्‍चाहरूसमेत वृद्धि गर्नेछु।"]},{"type":"verse","number":28,"content":["जसरी मैले तिनीहरूलाई उखेल्न, च्यातचुत पार्न र फ्याँक्न, विनाश गर्न र विपत्ति ल्याउन नियालेर हेरेँ; त्यसरी नै म तिनीहरूलाई निर्माण गर्न र रोप्नलाई पनि नियालेर हेर्नेछु,” याहवेह घोषणा गर्नुहुन्छ।"]},{"type":"verse","number":29,"content":["“ती दिनहरूमा मानिसहरूले फेरि यसो कहिल्यै भन्‍नेछैनन्,",{"text":"‘अमिलो अङ्‌गुर खाने आमाबुबा;","poem":1},{"text":"अनि दाँत कुँडिने छोराछोरीहरूको।’","poem":2}]},{"type":"verse","number":30,"content":["त्यसको सट्टामा, हरेक मानिस उसको आफ्नै पापको कारणले मर्नेछ; जसले अमिलो अङ्‌गुर खान्छ, त्यसकै दाँत कुँडिनेछ।"]},{"type":"verse","number":31,"content":[{"text":"“हेर, यस्ता दिनहरू आउनेछन्,” याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"text":"“जब म इस्राएलका मानिसहरू","poem":2},{"text":"र यहूदाका मानिसहरूसँग","poem":1},{"text":"नयाँ करार स्थापित गर्नेछु।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"यो त्यो करारजस्तै हुनेछैन,","poem":1},{"text":"जुन मैले तिनीहरूका पुर्खाहरूसँग बाँधेँ;","poem":2},{"text":"जब मैले तिनीहरूलाई हात समातेर,","poem":1},{"text":"इजिप्टबाट डोर्‍याएर ल्याएको थिएँ;","poem":2},{"text":"किनकि म तिनीहरूको पति भए तापनि","poem":1},{"text":"तिनीहरूले मेरो करार भङ्ग गरे,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“त्यसपछि म इस्राएलका मानिसहरूसँग यो करार बाँध्नेछु,”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"text":"“म आफ्नो व्यवस्था तिनीहरूका मनमा राखिदिनेछु,","poem":1},{"text":"र त्यसलाई तिनीहरूका हृदयमा लेखिदिनेछु।","poem":2},{"text":"म तिनीहरूका परमेश्‍वर हुनेछु;","poem":1},{"text":"र तिनीहरू मेरा मानिसहरू हुनेछन्।","poem":2}]},{"type":"verse","number":34,"content":[{"text":"अब उसो कुनै पनि मानिसले आफ्नो छिमेकीलाई","poem":1},{"text":"अथवा एक-अर्कालाई, ‘याहवेहलाई चिन,’ भनी सिकाउनेछैन;","poem":2},{"text":"किनकि सानादेखि लिएर","poem":1},{"text":"ठूलासम्म सबैले मलाई चिन्‍नेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"text":"“किनकि म तिनीहरूका दुष्‍टता क्षमा गरिदिनेछु,","poem":1},{"text":"र तिनीहरूका पापहरू फेरि सम्झनेछैनँ।”","poem":2}]},{"type":"verse","number":35,"content":["याहवेह यसो भन्‍नुहुन्छ,",{"text":"जसले सूर्यलाई","poem":1},{"text":"दिउँसो प्रकाश दिन नियुक्त गर्नुहुन्छ,","poem":2},{"text":"जसले जुन र ताराहरूलाई","poem":1},{"text":"राति चम्कनलाई आदेश दिनुहुन्छ,","poem":2},{"text":"जसले समुद्रलाई हल्‍लाउनुहुन्छ,","poem":1},{"text":"ताकि छालहरू गर्जून्;","poem":2},{"lineBreak":true},{"text":"उहाँको नाम सेनाहरूका याहवेह हो:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"text":"“जसरी मेरो दृष्‍टिबाट यी उर्दीहरू कहिल्यै रद्द हुँदैनन्,","poem":2},{"text":"त्यसरी नै इस्राएल मेरो सामु","poem":1},{"text":"सधैँभरि एक स्थिर राष्ट्र भई रहनेछ।”","poem":2}]},{"type":"verse","number":37,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“यदि माथिका आकाशहरू नाप्‍न सकिन्छ,","poem":1},{"text":"र मुनि पृथ्वीका जगहरू खोजेर निकाल्न सकिन्छ भने मात्र,","poem":2},{"text":"म इस्राएलले गरेका पापहरूको कारण","poem":1},{"text":"तिनीहरूका सन्तानहरूलाई इन्कार गर्नेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":38,"content":["याहवेह घोषणा गर्नुहुन्छ, “यस्ता दिनहरू आउँदैछन्, जब हननेलको धरहरादेखि कुने मूलढोकासम्म यो सहर मेरा निम्ति पुनर्निर्माण हुनेछ।"]},{"type":"verse","number":39,"content":["नाप्‍ने डोरी त्यहाँबाट सीधा गारेबको डाँडामा पुगेर गोआसम्म जानेछ।"]},{"type":"verse","number":40,"content":["समस्त बेँसीमा लासहरू र खरानीहरू फ्याँकिनेछ। अनि यरूशलेमको पूर्वतिरको किद्रोन खोल्सामाथि भएका मृत्युका खेतहरू र घोडे-ढोकासम्म भएका सबै इलाका याहवेहका निम्ति पवित्र हुनेछन्। त्यो सहर फेरि कहिल्यै उखेलिनेछैन, न त भत्काइनेछ।”"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}