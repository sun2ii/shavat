{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["इजिप्टको बारेमा सन्देश"]},{"type":"verse","number":1,"content":["राष्ट्रहरूको बारेमा यर्मिया अगमवक्ताकहाँ आएको याहवेहको वचन यही हो:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["इजिप्टको सम्बन्धमा:",{"lineBreak":true},"यहूदाका राजा योशियाहका छोरा, यहोयाकीमको शासनकालको चौथो वर्षमा, बेबिलोनका राजा नबूकदनेसरद्वारा यूफ्रेटिस नदीको कर्कमीशमा पराजित भएका इजिप्टका राजा फारो नेकोका सेनाको विरुद्धमा आएको सन्देश यही हो:"]},{"type":"verse","number":3,"content":[{"text":"“तेरा ठूला र साना दुवै ढालहरू तयार गर्;","poem":1},{"text":"अनि युद्ध गर्नका निम्ति मोर्चा बाँधेर अगि बढ्!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"घोडाहरूमा जीन-लगाम कस्,","poem":1},{"text":"र घोडाहरूमाथि चढ्!","poem":2},{"text":"लडाइँका टोप लगाएर","poem":1},{"text":"आफ्नो पङ्‌क्तिमा खडा हो!","poem":2},{"text":"आफ्ना भालाहरू टल्का;","poem":1},{"text":"आफ्ना हातहतियारहरूले सुसज्जित हो!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तर म के देख्दैछु?","poem":1},{"text":"ती इजिप्टियन सेनाहरू त्रसित भएका छन्;","poem":2},{"text":"तिनीहरू पछि हट्दैछन्;","poem":1},{"text":"तिनीहरूका योद्धाहरू हारेका छन्।","poem":2},{"text":"तिनीहरू पछाडि नहेरी हतार-हतार भाग्दैछन्;","poem":1},{"text":"अनि त्यहाँ चारैतिर त्रास नै त्रास फैलिएको छ,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“चाँडो भाग्ने पनि भाग्न सक्दैन,","poem":1},{"text":"न त योद्धाहरू नै उम्कन सक्छन्।","poem":2},{"text":"उत्तर दिशामा यूफ्रेटिस नदीको किनारमा","poem":1},{"text":"तिनीहरू ठक्‍कर खानेछन् र लड्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“नील नदीजस्तै बढेर आउने,","poem":1},{"text":"नदीहरूको बाढीझैँ उर्लेर आउने त्यो को हो?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"नील नदीजस्तै बढेर आउने,","poem":1},{"text":"पानीको नदीजस्तै उर्लेर आउने त्यो इजिप्ट हो।”","poem":2},{"text":"इजिप्टले भन्छे, “म उठ्नेछु र पृथ्वीलाई ढाकिदिनेछु;","poem":1},{"text":"म सहरहरू र तिनीहरूका मानिसहरूलाई नाश गरिदिनेछु।”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे घोडाहरू हो, आक्रमण गर!","poem":1},{"text":"हे रथ हाक्नेहरू हो, वेगसँग अगाडि बढ!","poem":2},{"text":"हे योद्धाहरू हो, अगि बढ। ढाल बोक्ने कूश र पूतका मानिसहरू,","poem":1},{"text":"धनु हान्‍न सिपालु लूदीमका मानिसहरू अगि बढ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तर त्यो दिन प्रभु, सेनाहरूका याहवेहको दिन हो।","poem":1},{"text":"बदलाको दिन, उहाँको शत्रुहरूमाथि बदला लिने दिन हो।","poem":2},{"text":"तरवार सन्तुष्‍ट नभएसम्म त्यसले नाश गर्नेछ;","poem":1},{"text":"रगतले तिर्खा नमेटेसम्म त्यो चल्नेछ।","poem":2},{"text":"किनकि सेनाहरूका याहवेहले उत्तरको देशलाई","poem":1},{"text":"यूफ्रेटिस नदीको किनारमा बलिदान चढाउनुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“हे इजिप्टकी कन्या छोरी,","poem":1},{"text":"माथि गिलादमा गएर मलम ली,","poem":2},{"text":"तर तैँले व्यर्थैमा धेरै औषधीहरू प्रयोग गरिस्;","poem":1},{"text":"तँ निको हुनेछैनस्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"राष्ट्रहरूले तेरो अपमानको बारेमा सुन्‍नेछन्;","poem":1},{"text":"तेरो रोदन पृथ्वीभरि सुनिनेछ।","poem":2},{"text":"एउटा योद्धा अर्कोमाथि ठक्‍कर खानेछ;","poem":1},{"text":"दुवै योद्धा एकसाथ जमिनमा लोट्नेछन्।”","poem":2}]},{"type":"verse","number":13,"content":["बेबिलोनका राजा नबूकदनेसरले इजिप्टलाई आक्रमण गर्न आउने बारेमा याहवेहले यर्मिया अगमवक्तासँग बोल्नुभएको सन्देश यही हो:"]},{"type":"verse","number":14,"content":[{"text":"“यो सन्देश इजिप्टमा भन्, र यसलाई मिग्दोलमा घोषणा गर्;","poem":1},{"text":"यसलाई मेम्फिसमा र तहपनेसमा पनि घोषणा गर्:","poem":2},{"text":"‘आफ्नो सुरक्षाको निम्ति आ-आफ्ना स्थानमा तयार होओ;","poem":1},{"text":"किनकि तेरा चारैतिर भएकाहरूलाई तरवारले नाश गर्नेछ।’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तेरा योद्धाहरू किन सोत्तर हुनेछन्?","poem":1},{"text":"तिनीहरू खडा हुन सक्दैनन्; किनकि याहवेहले तिनीहरूलाई जमिनमा ठेलिदिनुहुनेछ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तिनीहरू घरी-घरी ठक्‍कर खानेछन्;","poem":1},{"text":"तिनीहरू एक-अर्कामाथि लड्नेछन्।","poem":2},{"text":"तिनीहरूले भन्‍नेछन्, ‘उठ, हामी शत्रुहरूका","poem":1},{"text":"तरवारदेखि टाढा आफ्नै मानिसहरूकहाँ","poem":2},{"lineBreak":true},{"text":"र आफ्नो जन्मभूमिमा फर्केर जाऔँ।’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"त्यहाँ तिनीहरू चिच्याउनेछन्,","poem":1},{"text":"‘इजिप्टका राजा फारो चर्को आवाज मात्र हो;","poem":2},{"lineBreak":true},{"text":"फारोले आफ्नो मौका गुमाएको छ।’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“म जीवित भएझैँ,” राजाले यसरी घोषणा गर्नुहुन्छ,","poem":1},{"text":"जसको नाम सेनाहरूका याहवेह हो,","poem":2},{"text":"पहाडहरूमध्ये उच्‍च तबोरजस्तै,","poem":1},{"text":"समुद्रभन्दा उच्‍च कर्मेल पर्वतजस्तै एक जना शक्तिशाली आउनुहुनेछ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"हे इजिप्टमा बस्‍ने मानिसहरू हो,","poem":1},{"text":"तिमीहरू कैदमा जान आ-आफ्ना सरसामानहरू पोको पार;","poem":2},{"text":"किनकि मेम्फिस उजाड हुनेछ,","poem":1},{"text":"र कोही पनि नबस्‍ने रुखो भग्नावशेष हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“इजिप्ट एउटी सुन्दरी कोरली हो,","poem":1},{"text":"तर त्यसको विरुद्धमा","poem":2},{"lineBreak":true},{"text":"उत्तर दिशाबाट एउटा डाँस आउँदैछ।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"त्यसका ज्यालादार सिपाहीहरू","poem":1},{"text":"मोटाएर पोसिएका बाछाहरूजस्तै छन्।","poem":2},{"text":"तिनीहरू एकसाथ पीठ फर्काएर भाग्नेछन्;","poem":1},{"text":"तिनीहरू आफ्नो स्थानमा खडा भएर लड्दैनन्;","poem":2},{"text":"किनकि तिनीहरूका निम्ति दण्ड पाउने समय आएको छ;","poem":1},{"text":"तिनीहरूमाथि विपत्तिका दिनहरू आउँदैछन्।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"जब शत्रुहरू अगि बढ्दै आउँछन्,","poem":1},{"text":"तब भाग्ने सर्पझैँ सुलुलु आवाज इजिप्टले निकाल्नेछ;","poem":2},{"text":"तिनीहरू त्यसको विरुद्धमा रूख काट्ने मानिसहरूझैँ","poem":1},{"text":"बन्चरो लिएर आउनेछन्।”","poem":2}]},{"type":"verse","number":23,"content":[{"text":"याहवेह घोषणा गर्नुहुन्छ, “तिनीहरूका जङ्गलहरू जति नै बाक्लो भए तापनि","poem":1},{"text":"तिनीहरूले ती काटेर ढालिदिनेछन्।","poem":2},{"text":"तिनीहरू संख्यामा सलहभन्दा धेरै छन्,","poem":1},{"text":"तिनीहरू अनगन्ती छन्।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"इजिप्टकी छोरी शर्ममा पर्नेछे;","poem":1},{"text":"त्यसलाई उत्तर दिशाबाट आएका शत्रुहरूका हातमा सुम्पिइनेछ।”","poem":2}]},{"type":"verse","number":25,"content":["सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर भन्‍नुहुन्छ: “म थेबेसको देवता अमोन, फारो, इजिप्ट र यसका देवताहरू र यसका राजाहरू र फारोमाथि भरोसा राख्नेहरूमाथि दण्ड ल्याउन लागेको छु।"]},{"type":"verse","number":26,"content":["म तिनीहरूलाई मार्न चाहनेहरूका हातमा—बेबिलोनको राजा नबूकदनेसर र त्यसका अधिकारीहरूको हातमा सुम्पिदिनेछु। त्यसपछि इजिप्टमा पहिलेजस्तै मानिसहरू बसोबास गर्नेछन्,” याहवेह घोषणा गर्नुहुन्छ।"]},{"type":"verse","number":27,"content":[{"text":"“हे मेरो सेवक याकोब, तँ नडरा!","poem":1},{"text":"हे इस्राएल निरुत्साहित नहो।","poem":2},{"text":"म निश्‍चय नै तँलाई टाढाको ठाउँबाट","poem":1},{"text":"तेरा सन्तानहरूलाई तिनीहरूका बेबिलोनको कैदबाट बचाउनेछु।","poem":2},{"text":"याकोब फेरि शान्ति र सुरक्षामा बस्‍नेछ;","poem":1},{"text":"अनि कसैले पनि इस्राएललाई डर देखाउन सक्नेछैन।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"हे मेरो सेवक याकोब, तँ भयभीत नहो;","poem":1},{"text":"किनकि म तँसँग छु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"text":"“मैले तँलाई जुन राष्ट्रहरूको बीचमा छरपस्ट पारेँ,","poem":1},{"text":"मैले ती राष्ट्रहरूलाई सम्पूर्ण रूपले नाश गरे तापनि","poem":2},{"lineBreak":true},{"text":"तँलाईचाहिँ पूर्ण रूपले नाश गर्नेछैनँ।","poem":2},{"text":"म तँलाई न्यायपूर्वक ताडना दिनेछु;","poem":1},{"text":"तर म तँलाई विनादण्ड छोड्छैनँ।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}