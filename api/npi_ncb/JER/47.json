{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["पलिश्तीको बारेमा सन्देश"]},{"type":"verse","number":1,"content":["फारोले गाजा सहरमाथि आक्रमण गर्नुअगि पलिश्तीहरूको विषयमा यर्मिया अगमवक्ताकहाँ आएको याहवेहको वचन यही हो:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“हेर, उत्तर दिशामा पानीका छालहरू कसरी उठिरहेका छन्;","poem":1},{"text":"तिनीहरू डुबाउने बाढीको भलजस्तै हुनेछन्।","poem":2},{"text":"त्यसले जमिन र त्यसमा भएका सबै थोकलाई","poem":1},{"text":"सहरहरू र त्यसमा बस्‍नेहरू सबैलाई डुबाउनेछ।","poem":2},{"text":"मानिसहरू सहायताको निम्ति चिच्याउनेछन्;","poem":1},{"text":"देशमा बस्‍नेहरू सबै विलाप गर्नेछन्,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"दौडिरहेका घोडाहरूका खुरहरूको आवाजमा","poem":1},{"text":"वेगसित दगुर्ने शत्रुहरूका","poem":2},{"lineBreak":true},{"text":"रथहरूका चक्‍काका गडगडाहट सुनेर","poem":2},{"text":"आमाबुबाहरू आफ्ना छोराछोरीलाई सहायता गर्न फर्केर हेर्नेछैनन्;","poem":1},{"text":"तिनीहरूका हातहरू लुला हुनेछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"किनकि सबै पलिश्तीहरूलाई","poem":1},{"text":"नाश गर्ने दिन आएको छ,","poem":2},{"text":"टायर र सीदोनलाई सहायता दिन सक्ने","poem":1},{"text":"बाँचेकाहरू सबैलाई नष्‍ट गर्ने दिन आएको छ।","poem":2},{"text":"याहवेहले कप्‍तोरका","poem":1},{"noteId":25},{"text":"किनारमा","poem":1},{"text":"बाँकी रहेका सबै पलिश्तीहरूलाई नष्‍ट गर्न लाग्नुभएको छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"गाजाले शोकमा आफ्नो कपाल खौरनेछ;","poem":1},{"text":"अश्कलोन मौन हुनेछ।","poem":2},{"text":"हे तराईका अवशेष हो,","poem":1},{"text":"तँ कहिलेसम्म आफूलाई चोट पारिरहन्छस्?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"रुँदै तैँले भन्‍नेछस्,","poem":1},{"text":"“ ‘ओह, याहवेहको तरवार, तँ कहिले शान्त हुन्छस्?","poem":2},{"text":"ए तरवार, तँ आफ्नो म्यानमा फर्किजा,","poem":1},{"text":"र शान्तसँग बस्।’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तर यो कसरी शान्त बस्‍न सक्छ?","poem":1},{"text":"किनकि याहवेहले यसलाई","poem":2},{"text":"अश्कलोन र समुद्री किनारको विरोधमा","poem":1},{"text":"आक्रमण गर्न आदेश दिनुभएको छ।”","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"अर्थात्, क्रेट","reference":{"chapter":47,"verse":4}}]},"thisChapterLink":"/api/npi_ncb/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}