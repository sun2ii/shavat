{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["मोआबको विषयमा सन्देश"]},{"type":"verse","number":1,"content":["मोआबको विषयमा:",{"lineBreak":true},"सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर, यसो भन्‍नुहुन्छ:",{"text":"“धिक्‍कार नेबोलाई! किनकि त्यो नष्‍ट हुनेछ,","poem":1},{"text":"किर्यातैम अपमानित हुनेछ र कब्जा गरिनेछ;","poem":2},{"lineBreak":true},{"text":"शत्रुहरूले तिनीहरूको बलियो गढ नष्‍ट गरेर चकनाचुर पार्नेछन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मोआबको प्रशंसा फेरि कहिल्यै हुनेछैन;","poem":1},{"text":"हेश्बोनमा मानिसहरूले मोआबको विरुद्धमा पतनको षड्यन्त्र गर्दछन्:","poem":2},{"lineBreak":true},{"text":"‘आओ, हामी त्यस राष्ट्रको अस्तित्व मेटिदिऔँ।’","poem":2},{"text":"हे मदमेनका मानिसहरू, तँलाई पनि चुप गराइनेछ;","poem":1},{"text":"तँलाई तरवारले खेद्नेछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"होरोनैमबाट पीडाको चीत्कार उठ्नेछ,","poem":1},{"text":"ठूलो विध्वंस र सर्वनाशको चीत्कार।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मोआब नष्‍ट हुनेछ;","poem":1},{"text":"त्यसका बालकहरू चर्को सोरले रुनेछन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिनीहरू दुःखी भएर रुँदै","poem":1},{"text":"लूहीत सहरतिर जाने उकालोमा चढ्नेछन्;","poem":2},{"text":"होरोनैमतिर झर्ने ओरालो बाटोमा","poem":1},{"text":"सर्वनाशको कारण दर्दनाक चीत्कार सुनिन्छन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"भाग! आफ्नो जीवन बचाउनलाई दौड;","poem":1},{"text":"मरुभूमिमा भएको पोथ्राजस्तै होओ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"किनकि तिमीहरूले आफ्ना कामहरू र धनसम्पत्तिहरूमा भरोसा राखेका कारण,","poem":1},{"text":"तिमीहरू पनि कैदमा लगिनेछौ;","poem":2},{"text":"अनि कमोश देवता आफ्ना पुजारीहरू","poem":1},{"text":"र अधिकारीहरूसँग निर्वासनमा जानेछ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"विनाशकर्ता प्रत्येक सहरको विरुद्धमा आउनेछ;","poem":1},{"text":"अनि एउटै सहर पनि उम्कनेछैन।","poem":2},{"text":"उपत्यका ध्वस्त हुनेछ,","poem":1},{"text":"र बेँसी नष्‍ट पारिनेछ;","poem":2},{"lineBreak":true},{"text":"किनकि याहवेहले भन्‍नुभएको छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मोआबमा नुन छरिदेओ;","poem":1},{"text":"किनकि त्यो उजाड हुनेछ","poem":2},{"noteId":26},{"text":";","poem":2},{"text":"त्यसका सहरहरू कोही पनि नबस्‍ने गरी","poem":1},{"text":"उजाड हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“याहवेहको काममा लापर्बाही गर्ने व्यक्ति श्रापित होस्!","poem":1},{"text":"तिनीहरूको तरवारलाई रक्तपात गर्न नदिने व्यक्ति श्रापित होस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“मोआब त्यसको युवाअवस्थादेखि नै आराममा छ;","poem":1},{"text":"एउटा भाँडाबाट अर्को भाँडामा नखन्याई","poem":2},{"text":"भाँडामा छोडिराखेको दाखमद्यजस्तै,","poem":1},{"text":"अर्थात् मोआब निर्वासनमा गएकी छैन।","poem":2},{"text":"त्यसको स्वाद पहिलेको जस्तै छ;","poem":1},{"text":"अनि त्यसको वासना बदलिएको छैन।”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"यसकारण, “हेर, दिनहरू आउँदैछन्,” याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"lineBreak":true},{"text":"जब म मानिसहरू पठाउनेछु, जसले मशकबाट दाखमद्य खन्याउनेछन्,","poem":1},{"text":"त्यसरी नै तिनीहरूले मोआबलाई पोखाइदिनेछन्;","poem":2},{"text":"तिनीहरूले त्यसका मशकहरू रित्याइदिनेछन्,","poem":1},{"text":"र त्यसका मशकहरू चकनाचुर पारिदिनेछन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"जसरी इस्राएलीहरूले बेथेल झूटो देवतामाथि भरोसा गर्दा","poem":1},{"text":"इस्राएलको घराना लाजमा परेको थियो,","poem":2},{"lineBreak":true},{"text":"त्यसरी नै मोआब पनि कमोश देवताको कारण लज्जित हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“तिमीहरूले कसरी भन्‍न सक्छौ,","poem":1},{"text":"‘हामी लडाइँका वीर योद्धाहरू वा बहादुर मानिसहरू हौँ?’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"मोआब नष्‍ट हुनेछ र त्यसका सहरहरूमा आक्रमण गरिनेछ;","poem":1},{"text":"त्यसका अति असल जवानहरू शत्रुहरूले काटेर मर्नेछन्,”","poem":2},{"lineBreak":true},{"text":"राजाले घोषणा गर्नुहुन्छ, जसको नाम सेनाहरूका याहवेह हो।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“मोआबको पतन नजिकै आइपुगेको छ;","poem":1},{"text":"त्यसको विनाश चाँडै आउनेछ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"त्यसका वरिपरि बस्‍नेहरू,","poem":1},{"text":"त्यसको ख्याति थाहा पाउनेहरू सबैले त्यसको निम्ति शोक गर;","poem":2},{"text":"र यसो भन, ‘शक्तिशाली राजदण्ड कसरी तोडिएको छ,","poem":1},{"text":"गौरवशाली राज्यको लहुरो कसरी भाँचिएको छ!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“हे दीबोन सहरकी छोरीहरू वा बासिन्दाहरू हो,","poem":1},{"text":"तिमीहरूका गौरवको उचाइबाट ओर्लेर आओ,","poem":2},{"lineBreak":true},{"text":"र सुक्खा धुलोमा बस;","poem":2},{"text":"किनकि मोआबलाई विनाश गर्ने शत्रुहरू","poem":1},{"text":"तिमीहरूको विरुद्धमा आउनेछन्,","poem":2},{"lineBreak":true},{"text":"र तिमीहरूका सुरक्षित सहरहरू ध्वस्त पारिदिनेछन्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"हे अरोएरका बासिन्दाहरू हो,","poem":1},{"text":"सडकको छेउमा खडा होओ र ध्यानसित हेर।","poem":2},{"text":"भाग्दै गरेका मानिसहरू र उम्कँदै गरेकी स्त्रीहरूलाई सोध,","poem":1},{"text":"तिनीहरूलाई, ‘के भयो?’ भनेर सोध।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"मोआब अपमानित भएकी छे; किनकि ऊ चकनाचुर पारिएकी छे;","poem":1},{"text":"विलाप गर र रोओ!","poem":2},{"text":"अर्नोन नदीको छेउमा गएर बताइदेओ,","poem":1},{"text":"मोआब नष्‍ट पारिएकी छे।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"उच्‍च पठारमाथि न्याय आएको छ—","poem":1},{"text":"अर्थात् होलोन, यहसा र मेपातमाथि,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"दीबोन, नेबो र बेथ-दिब्लातैममाथि,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"किर्यातैम, बेथ-गामूल र बेथ-मोनमाथि,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"किर्योत र बोज्रामाथि—","poem":2},{"lineBreak":true},{"text":"मोआबका टाढा र नजिकका सबै सहरहरूमाथि न्याय आएको छ।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"मोआबको सिङ","poem":1},{"noteId":27},{"text":"काटियो;","poem":1},{"text":"त्यसको पाखुरा भाँचिएको छ,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“मोआबलाई दाखमद्यले मताओ;","poem":1},{"text":"किनकि त्यसले याहवेहको विरुद्धमा विद्रोह गरेको छ।","poem":2},{"text":"मोआबलाई त्यसकै बान्तामा लडीबुडी गर्न देओ;","poem":1},{"text":"मोआबलाई हाँसोको पात्र हुन देओ।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ए मोआब, के तैँले इस्राएलको हाँसो उडाएको थिइनस् र?","poem":1},{"text":"के त्यो चोरहरूसँग पक्राउ परेकी थिई,","poem":2},{"text":"त्यसको बारेमा कुरा गर्दा","poem":1},{"text":"त्यसको ठट्टा गर्दै तैँले आफ्नो टाउको हल्‍लाउने गर्थिस्?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ए मोआबमा बस्‍नेहरू हो, तिमीहरूले आफ्ना सहरहरू छोडेर","poem":1},{"text":"चट्टानको ओडारहरूमा बस।","poem":2},{"text":"तिमीहरू ओडारको मुखमा","poem":1},{"text":"आफ्नो गुँड बनाउने ढुकुरजस्तै होओ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“हामीले मोआबको घमण्डको बारेमा सुनेका छौँ—","poem":1},{"text":"त्यसको घमण्ड अति ठूलो छ!","poem":2},{"text":"त्यसको अहङ्कार, त्यसको घमण्ड र अभिमान;","poem":1},{"text":"अनि त्यसका हृदयको सेखीको बारेमा सुनेका छौँ।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘म त्यसको अहङ्कार जान्दछु,","poem":1},{"text":"तर त्यसको अहङ्कार व्यर्थको छ,’ याहवेह घोषणा गर्नुहुन्छ;","poem":2},{"lineBreak":true},{"text":"अनि त्यसको घमण्डले केही गर्न सक्दैन।","poem":2}]},{"type":"verse","number":31,"content":[{"text":"यसकारण म मोआबको निम्ति बिलौना गर्छु;","poem":1},{"text":"किनकि म सम्पूर्ण मोआबको निम्ति रुन्छु;","poem":2},{"lineBreak":true},{"text":"म कीर-हरेशेतका मानिसहरूका निम्ति विलाप गर्छु।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"म याजेरको निम्ति भन्दा तेरो निम्ति धेरै रुन्छु;","poem":1},{"text":"हे सिब्माका दाखका बोटहरू,","poem":2},{"text":"तेरा हाँगाहरू समुद्रसम्म पुगेका छन्;","poem":1},{"text":"ती हाँगाहरू याजेरसम्मै पुगेका छन्।","poem":2},{"text":"विनाशकर्ताहरू","poem":1},{"text":"तेरा पाकेका फलहरू र अङ्‌गुरहरूमाथि आइलागेका छन्।","poem":2}]},{"type":"verse","number":33,"content":[{"text":"मोआबका बगैँचाहरू र खेतबारीहरूबाट","poem":1},{"text":"आनन्द र खुशीयाली गइसकेका छन्।","poem":2},{"text":"मैले कोलहरूबाट रस बग्न बन्द गरिदिएको छु;","poem":1},{"text":"कसैले पनि आनन्दको आवाजसँग ती पेल्दैनन्।","poem":2},{"text":"यद्यपि त्यहाँ चर्को आवाजमा कराइरहेका छन्,","poem":1},{"text":"तर ती आवाजहरू खुशीका होइनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“हेश्बोनदेखि एलाले र यहससम्म","poem":1},{"text":"सोअरदेखि टाढा होरोनैम र एग्लत-शलीशियाहसम्म नै","poem":2},{"text":"तिनीहरूको चीत्कारको आवाज सुनिन्छ;","poem":1},{"text":"किनकि निम्रीमको पानीसमेत सुकिसकेको छ।","poem":2}]},{"type":"verse","number":35,"content":[{"text":"म मोआबका अग्ला-अग्ला ठाउँहरूमा भेटी चढाउनेहरू","poem":1},{"text":"र तिनीहरूका देवताहरूलाई धूप बाल्नेहरूको","poem":2},{"lineBreak":true},{"text":"अन्त्य गरिदिनेछु,” याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“यसकारण मोआबका निम्ति मेरो हृदयले बाँसुरीको सोरजस्तै विलाप गर्छ;","poem":1},{"text":"यसले कीर-हरेशेतका मानिसहरूको निम्ति बाँसुरीजस्तै विलाप गर्छ।","poem":2},{"lineBreak":true},{"text":"तिनीहरूले आर्जन गरेका धनसम्पत्ति सबै नष्‍ट भएको छ।","poem":2}]},{"type":"verse","number":37,"content":[{"text":"हरेक मानिसको कपाल खौरिएको छ,","poem":1},{"text":"र हरेक मानिसको दाह्री काटिएको छ;","poem":2},{"text":"हरेक हात ताछिएको छ,","poem":1},{"text":"र हरेक कम्मरमा भाङ्ग्रा बेरिएको छ।","poem":2}]},{"type":"verse","number":38,"content":[{"text":"मोआबका सबै छानाहरूमा","poem":1},{"text":"र सबै सार्वजनिक चोकहरूमा","poem":2},{"text":"मानिसहरूको विलापबाहेक त्यहाँ अरू केही छैन;","poem":1},{"text":"किनकि मैले मोआबलाई कसैले मन नपराएको","poem":2},{"lineBreak":true},{"text":"भाँडालाई जस्तै फुटाइदिएको छु,” याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“मोआब कति छरपस्ट भएको छ! तिनीहरू कसरी विलाप गर्दैछन्!","poem":1},{"text":"मोआब लाजले कसरी आफ्नो पिठिउँ फर्काउँछ!","poem":2},{"text":"मोआब एक हाँसोको पात्र भएको छ,","poem":1},{"text":"त्यसको वरिपरि भएका सबै राष्ट्रहरूका निम्ति एक त्रासको पात्र बनेको छ।”","poem":2}]},{"type":"verse","number":40,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“हेर! एउटा चील आफ्ना पखेटा फैलाएर","poem":1},{"text":"मोआबमाथि वेगसित आउँदैछ।","poem":2}]},{"type":"verse","number":41,"content":[{"text":"किर्योत सहर कब्जा गरिनेछ,","poem":1},{"text":"र बलिया किल्‍लाहरू लिइनेछन्।","poem":2},{"text":"त्यस दिन मोआबका योद्धाहरूका हृदय","poem":1},{"text":"प्रसव-वेदनामा परेकी स्त्रीको हृदयजस्तै हुनेछ।","poem":2}]},{"type":"verse","number":42,"content":[{"text":"मोआब राष्ट्र नाश हुनेछ;","poem":1},{"text":"किनकि त्यसले याहवेहको अवहेलना गरेको छ।","poem":2}]},{"type":"verse","number":43,"content":[{"text":"हे मोआबका मानिसहरू हो,","poem":1},{"text":"तिमीहरूलाई त्रास, खाडल र पासोले पर्खिरहेका छन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“जो आतङ्कबाट भाग्छ,","poem":1},{"text":"त्यो खाडलमा खस्‍नेछ;","poem":2},{"text":"जो खाडलबाट बाहिर निस्कन्छ,","poem":1},{"text":"त्यो पासोमा पर्नेछ;","poem":2},{"text":"किनकि म मोआबमाथि","poem":1},{"text":"त्यसको दण्डको वर्ष ल्याउनेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“हेश्बोनका छायामा","poem":1},{"text":"भाग्नेहरू असहाय भएर उभिन्छन्;","poem":2},{"text":"किनकि हेश्बोनबाट आगोबाहिर निस्केको छ;","poem":1},{"text":"सीहोनको बीचबाट ज्वाला निस्केको छ;","poem":2},{"text":"यसले मोआबका निधारहरू,","poem":1},{"text":"दुःख दिने अहङ्कारीहरूका थाप्लाहरू जलाइदिनेछ।","poem":2}]},{"type":"verse","number":46,"content":[{"text":"हे मोआब, तँलाई धिक्‍कार छ!","poem":1},{"text":"कमोश देवताका मानिसहरू नष्‍ट भएका छन्;","poem":2},{"text":"तिमीहरूका छोराहरू निर्वासनमा","poem":1},{"text":"र तिमीहरूका छोरीहरू कैदी बनाएर दासत्वमा लगिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“तरै पनि पछिल्‍ला दिनहरूमा","poem":1},{"text":"म मोआबको सुख-शान्ति फर्काइल्याउनेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},"मोआबको न्यायको बारेमा यर्मियाले गरेका अगमवाणी यहीँ समाप्‍त हुन्छ।"]},{"type":"line_break"}],"footnotes":[{"noteId":26,"caller":"+","text":"अथवा मोआबलाई पखेटा देओ, ताकि उडेर टाढा जाओस्।","reference":{"chapter":48,"verse":9}},{"noteId":27,"caller":"+","text":"सिङ यहाँ शक्ति भन्‍ने जनाउँछ।","reference":{"chapter":48,"verse":25}}]},"thisChapterLink":"/api/npi_ncb/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}