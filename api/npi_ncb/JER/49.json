{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["अम्मोनको बारेमा सन्देश"]},{"type":"verse","number":1,"content":["अम्मोनीहरूको विषयमा:",{"lineBreak":true},"याहवेह यसो भन्‍नुहुन्छ:",{"text":"“के इस्राएलका छोराहरू छैनन्?","poem":1},{"text":"के त्यसका उत्तराधिकारीहरू छैनन्?","poem":2},{"text":"त्यसो भए किन मोलेखले","poem":1},{"noteId":28},{"text":"गादमाथि अधिकार जमाएको छ?","poem":1},{"text":"उहाँका मानिसहरू किन त्यसका सहरहरूमा बस्छन्?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तर दिनहरू आउँदैछन्,” याहवेह घोषणा गर्नुहुन्छ।","poem":1},{"lineBreak":true},{"text":"“जब म अम्मोनीहरूका रब्बाको","poem":1},{"text":"विरुद्धमा युद्धको ध्वनि सुनाउनेछु;","poem":2},{"text":"अनि त्यो एउटा भग्नावशेषको थुप्रो हुनेछ,","poem":1},{"text":"र त्यसका चारैतिरका गाउँहरूमा आगो लगाइनेछ।","poem":2},{"text":"तब जसले इस्राएललाई धपाएका थिए,","poem":1},{"text":"तिनीहरूलाई इस्राएलले धपाउनेछ,”","poem":2},{"lineBreak":true},{"text":"याहवेह भन्‍नुहुन्छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“हे हेश्बोन, विलाप गर्; किनकि ऐ नाश भएको छ!","poem":1},{"text":"हे रब्बाका छोरीहरू हो, चर्कोगरी रोओ!","poem":2},{"text":"भाङ्ग्रा लगाएर शोक गर;","poem":1},{"text":"पर्खालभित्र यताउता दगुर;","poem":2},{"text":"किनकि मोलेख आफ्ना पुजारीहरू","poem":1},{"text":"र अधिकारीहरूसँग कैदमा जानेछ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तँ किन आफ्ना उपत्यकाहरूमा घमण्ड गर्छस्?","poem":1},{"text":"तँ आफ्ना फलदायक उपत्यकाका निम्ति किन घमण्ड गर्छस्?","poem":2},{"text":"हे विश्‍वासीघाती आमोनका छोरी,","poem":1},{"text":"तँ आफ्ना धनसम्पत्तिमा भरोसा राख्छेस् र भन्छेस्,","poem":2},{"lineBreak":true},{"text":"‘हामीलाई कसले आक्रमण गर्ला?’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"म तेरा चारैतिरबाट","poem":1},{"text":"तँमाथि आतङ्क ल्याउनेछु,”","poem":2},{"lineBreak":true},{"text":"प्रभु सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"text":"“तिमीहरू हरेक धपाइनेछौ;","poem":1},{"text":"अनि भागेर जानेहरूलाई कसैले पनि भेला गर्नेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“अनि त्यसपछि म अम्मोनीहरूको सुख-शान्ति फर्काइदिनेछु,”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"heading","content":["एदोमको बारेमा सन्देश"]},{"type":"verse","number":7,"content":["एदोमको विषयमा:",{"lineBreak":true},"सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:",{"text":"“के अब तेमानमा बुद्धि छैन?","poem":1},{"text":"के बुद्धिमान्‌हरूबाट परामर्श नष्‍ट भएर गएको छ?","poem":2},{"lineBreak":true},{"text":"के तिनीहरूको बुद्धि भ्रष्‍ट भएकै हो?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हे ददानमा बस्‍नेहरू हो, भाग, फर्केर जाओ!","poem":1},{"text":"र गहिरा ओडारहरूमा गएर लुक;","poem":2},{"text":"किनकि एसावलाई दण्ड दिने समयमा","poem":1},{"text":"म एसावमाथि विपत्ति ल्याउनेछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यदि तँकहाँ अङ्‌गुर टिप्नेहरू आए भने,","poem":1},{"text":"के तिनीहरूले केही अङ्‌गुरहरू छोड्दैनन् र?","poem":2},{"text":"यदि रातको समयमा चोरहरू आए भने,","poem":1},{"text":"के तिनीहरूले आफूलाई चाहिए जति मात्र चोर्दैनन् र?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तर म एसावलाई पूर्ण रूपमा नाङ्गो बनाइदिनेछु;","poem":1},{"text":"म त्यसका लुक्ने ठाउँहरू उदाङ्गो पारिदिनेछु,","poem":2},{"lineBreak":true},{"text":"ताकि त्यसले आफूलाई लुकाउन नसकोस्।","poem":2},{"text":"त्यसका हतियारधारीहरू","poem":1},{"text":"र त्यसका छोराछोरी, आफन्तहरू र छिमेकीहरू नष्‍ट हुनेछन्;","poem":2},{"lineBreak":true},{"text":"यसकारण यसो भन्‍ने मान्छे कोही पनि हुनेछैन,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"‘तिमीहरूका टुहुरा-टुहुरीहरूलाई छोडिराख्; म तिनीहरूको हेरचाह गर्नेछु।","poem":1},{"text":"तिमीहरूका विधवाहरूले पनि ममाथि भरोसा राखून्।’ ”","poem":2}]},{"type":"verse","number":12,"content":["याहवेह यसो भन्‍नुहुन्छ: “यदि कोही कचौराबाट पिउन योग्यको नभए तापनि त्यसले पिउनैपर्छ भने, के तँ दण्ड नपाई उम्कनेछस् र? दण्डबाट तँ उम्कनेछैनस्, तर तैँले दण्डको कचौराबाट पिउनैपर्छ।"]},{"type":"verse","number":13,"content":["म आफ्नै नाममा शपथ खान्छु,” याहवेह घोषणा गर्नुहुन्छ, “बोज्रा ध्वस्त हुनेछ; त्यो त्रास, निन्दा र सरापको पात्र हुनेछ; अनि त्यसका सबै सहरहरू सदाका निम्ति ध्वस्त हुनेछन्।”"]},{"type":"verse","number":14,"content":[{"text":"मैले याहवेहबाट एउटा सन्देश सुनेको छु;","poem":1},{"text":"राष्ट्रहरूलाई यसो भन्‍ने एक जना दूत पठाइयो,","poem":2},{"text":"“आफ्ना सेनाहरू युद्धको निम्ति भेला गर!","poem":1},{"text":"एदोमसँग लडाइँ गर्नका निम्ति तयार होओ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“हेर्, अब म तँलाई राष्ट्रहरूमध्ये सबैभन्दा सानो तुल्याउनेछु;","poem":1},{"text":"तँ मानव-जातिहरू बीच घृणित हुनेछस्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तेरो डरलाग्दो व्यवहार","poem":1},{"text":"र तेरो हृदयको घमण्डले तँलाई धोका दिएको छ;","poem":2},{"text":"हे चट्टानका दरारहरूमा बस्‍ने,","poem":1},{"text":"हे डाँडाका अग्ला-अग्ला ठाउँहरू ओगट्ने,","poem":2},{"text":"तैँले चीलको गुँड झैँ अग्लो ठाउँमा बास बनाए तापनि","poem":1},{"text":"म तँलाई त्यहाँबाट तल झारिदिनेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“एदोम त्रासको पात्र हुनेछ;","poem":1},{"text":"त्यसका सबै घाउहरूका कारण","poem":2},{"lineBreak":true},{"text":"त्यसका छेउबाट भएर जाने हरेक तर्सनेछ, र त्यसलाई खिसी गर्नेछ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"जसरी सदोम र गमोरा तिनीहरूका छेउछाउका","poem":1},{"text":"सहरहरूसहित नष्‍ट भएका थिए,” याहवेह भन्‍नुहुन्छ,","poem":2},{"text":"“त्यसरी नै त्यहाँ कोही पनि बस्‍नेछैन;","poem":1},{"text":"त्यहाँ कोही पनि बसोबास गर्नेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“हेर, यर्दन नदीका झाडीहरूबाट","poem":1},{"text":"हरियो खर्कबाट निस्केर आइरहेको सिंहझैँ, म निस्कनेछु;","poem":2},{"text":"र म एदोमलाई झट्टै त्यसकै देशबाट खेद्नेछु।","poem":1},{"text":"यस देशको निम्ति जसलाई चुन्छु, उसैलाई नियुक्त गर्नेछु।","poem":2},{"text":"मजस्तो को छ र? मलाई कसले चुनौती दिन सक्छ?","poem":1},{"text":"अनि कुनचाहिँ गोठालो मेरो विरुद्धमा खडा हुन सक्छ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"यसकारण एदोमको विरुद्धमा याहवेहको योजना,","poem":1},{"text":"र तेमानमा बस्‍नेहरूको विरुद्धमा उहाँको उद्देश्य के छ, त्यो कुरा सुन:","poem":2},{"text":"बगालका कलिला पाठाहरूलाई घिसारेर लगिनेछ;","poem":1},{"text":"तिनीहरूको खर्क पूर्ण रूपमा उजाड हुनेछ।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तिनीहरूको पतनको आवाजले पृथ्वी थरथर काँप्‍नेछ;","poem":1},{"text":"तिनीहरूको चीत्कार लाल समुद्रसम्म गुञ्जिनेछ।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"हेर! एउटा चील आफ्ना पखेटा फैलाउँदै वेगसित","poem":1},{"text":"बोज्रामाथि झम्टेर आउनेछ।","poem":2},{"text":"त्यस दिन एदोमका योद्धाहरूका हृदय","poem":1},{"text":"प्रसव-वेदनामा परेकी स्त्रीको हृदयजस्तै हुनेछ।","poem":2}]},{"type":"heading","content":["दमस्कसको बारेमा सन्देश"]},{"type":"verse","number":23,"content":["दमस्कसको विषयमा:",{"text":"“हमात र अर्पाद हतोत्साहित भएका छन्;","poem":1},{"text":"किनकि तिनीहरूले खराब समाचार सुनेका छन्।","poem":2},{"text":"तिनीहरू निराश भएका छन्,","poem":1},{"text":"अशान्त समुद्रजस्तै विचलित भएका छन्।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"दमस्कसका मानिसहरू कमजोर भएका छन्;","poem":1},{"text":"तिनीहरू भाग्नलाई पछि फर्केका छन्,","poem":2},{"lineBreak":true},{"text":"र तिनीहरूलाई त्रासले समातेको छ;","poem":2},{"text":"कष्‍ट र वेदनाले तिनीहरूलाई पक्रेको छ,","poem":1},{"text":"प्रसव-वेदनामा परेकी स्त्रीको जस्तै पीडाले पक्रेको छ।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"त्यो प्रसिद्ध सहर कसरी त्यागिएको छैन;","poem":1},{"text":"त्यो सहर जसमा म प्रसन्‍न हुन्छु?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"निश्‍चय नै तिनीहरूका जवान मानिसहरू सडकहरूमा ढल्नेछन्;","poem":1},{"text":"त्यस दिन त्यसका सबै सेनाहरू मारिनेछन्,”","poem":2},{"lineBreak":true},{"text":"सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"“म दमस्कसका पर्खालहरूमा आगो लगाइदिनेछु;","poem":1},{"text":"त्यो आगोले बेन-हददको किल्‍लालाई भस्म पारिदिनेछ।”","poem":2}]},{"type":"heading","content":["केदार र हासोरको बारेमा सन्देश"]},{"type":"verse","number":28,"content":["बेबिलोनका राजा नबूकदनेसरले आक्रमण गरेका केदार र हासोरका राज्यहरूको बारेमा:",{"lineBreak":true},"याहवेह यसो भन्‍नुहुन्छ:",{"text":"“उठ र केदारलाई आक्रमण गर,","poem":1},{"text":"र पूर्वका मानिसहरूलाई नाश गर।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"तिनीहरूका पालहरू र तिनीहरूका बगालहरू लगिनेछन्;","poem":1},{"text":"तिनीहरूका ओत लाग्ने छाप्राहरू,","poem":2},{"lineBreak":true},{"text":"तिनीहरूका सबै मालसामानहरू र ऊँटहरूसमेत लगिनेछन्।","poem":2},{"text":"मानिसहरूले तिनीहरूलाई भन्‍नेछन्,","poem":1},{"text":"‘चारैतिर त्रासै-त्रास छ!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“छिटो टाढा भाग!","poem":1},{"text":"हे हासोरमा बस्‍नेहरू हो, तिमीहरू गहिरा ओडारहरूमा बस,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"text":"बेबिलोनको राजा नबूकदनेसरले तिमीहरूको विरुद्धमा षड्यन्त्र रचेको छ;","poem":1},{"text":"त्यसले तिमीहरूको विरुद्धमा एउटा योजना बनाएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“उठ र शान्तिमा रहेको राष्ट्रलाई आक्रमण गर,","poem":1},{"text":"जो आरामसँग ढुक्‍क भएर बसेको छ,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"text":"“एउटा राष्ट्र, जसका न मूलढोकाहरू, न त गजबारहरू नै छन्;","poem":1},{"text":"त्यस राष्ट्रका मानिसहरू खतराबाट टाढा बस्छन्।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"तिनीहरूका ऊँटहरू लुटका माल हुनेछन्;","poem":1},{"text":"अनि तिनीहरूका ठूला-ठूला बथानहरू लुटिएका माल हुनेछन्।","poem":2},{"text":"म टाढा ठाउँमा रहेकाहरूलाई बतासमा छरपस्ट पारिदिनेछु","poem":1},{"noteId":29},{"text":"र म तिनीहरूमाथि चारैतिरबाट विपत्ति ल्याउनेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“हासोर सहर स्यालको वासस्थान हुनेछ;","poem":1},{"text":"सदाको निम्ति उजाडस्थान बन्‍नेछ।","poem":2},{"text":"त्यहाँ कोही पनि बस्‍नेछैन;","poem":1},{"text":"त्यहाँ कुनै पनि मानिस बसोबास गर्नेछैन।”","poem":2}]},{"type":"heading","content":["एलामको बारेमा सन्देश"]},{"type":"verse","number":34,"content":["यहूदाका राजा सिदकियाहको शासनकालको सुरुका समयमा एलामको बारेमा अगमवक्ता यर्मियाकहाँ आएको याहवेहको वचन यही हो:"]},{"type":"line_break"},{"type":"verse","number":35,"content":["सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:",{"text":"“हेर, म एलामको धनु,","poem":1},{"text":"तिनीहरूको शक्तिको मुख्य आधार भाँचिदिनेछु।","poem":2}]},{"type":"verse","number":36,"content":[{"text":"म एलामको विरुद्धमा आकाशका चारै दिशाबाट","poem":1},{"text":"चार वटा बतासहरू ल्याउनेछु;","poem":2},{"text":"म तिनीहरूलाई चार वटा बतासहरूमा छरपस्ट पार्नेछु;","poem":1},{"text":"अनि एलामबाट निर्वासनमा","poem":2},{"lineBreak":true},{"text":"नगएको कुनै राष्ट्र हुनेछैन।","poem":2}]},{"type":"verse","number":37,"content":[{"text":"म एलामलाई तिनीहरूका शत्रुहरूको सामु चकनाचुर पार्नेछु;","poem":1},{"text":"तिनीहरूको शत्रुहरूको सामु, जसले तिनीहरूलाई मार्न चाहन्छन्;","poem":2},{"text":"म मेरो भयानक क्रोधमा,","poem":1},{"text":"तिनीहरूमाथि विनाश ल्याउनेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"text":"“म तिनीहरूलाई पूर्ण रूपले नष्‍ट नपारुन्जेल,","poem":1},{"text":"तिनीहरूलाई तरवार लिएर खेद्नेछु।","poem":2}]},{"type":"verse","number":38,"content":[{"text":"म एलाममा आफ्नो सिंहासन खडा गर्नेछु;","poem":1},{"text":"अनि त्यसका राजा र अधिकारीहरूलाई नाश गर्नेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“तापनि आउँदा दिनहरूमा","poem":1},{"text":"म एलामको सुख-शान्ति फर्काइल्याउनेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]}],"footnotes":[{"noteId":28,"caller":"+","text":"अर्थात् तिनीहरूका राजा","reference":{"chapter":49,"verse":1}},{"noteId":29,"caller":"+","text":"अथवा कन्चटनेरको कपाल खौरनेहरू।","reference":{"chapter":49,"verse":32}}]},"thisChapterLink":"/api/npi_ncb/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}