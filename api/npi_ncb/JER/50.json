{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["बेबिलोनको बारेमा सन्देश"]},{"type":"verse","number":1,"content":["बेबिलोन र बेबिलोनीहरूको देशको विषयमा यर्मिया अगमवक्ताद्वारा याहवेहले बोल्नुभएको वचन यही हो:"]},{"type":"verse","number":2,"content":[{"text":"“राष्ट्रहरू बीचमा सूचना दे, र घोषणा गर्;","poem":1},{"text":"झण्डा उठाएर यो घोषणा गर्;","poem":2},{"lineBreak":true},{"text":"केही कुरा नलुकाई भनिदे,","poem":2},{"text":"‘बेबिलोन कब्जा गरिनेछ;","poem":1},{"text":"बेल शर्ममा पर्नेछ,","poem":2},{"lineBreak":true},{"text":"मारोदक त्रासले भरिनेछ।","poem":2},{"text":"त्यसका प्रतिमाहरू लाजमा पारिनेछन्,","poem":1},{"text":"र त्यसका मूर्तिहरू त्रासले भरिनेछन्।’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उत्तर दिशाबाट एउटा राष्ट्रले त्यसलाई आक्रमण गर्नेछ,","poem":1},{"text":"र त्यसलाई उजाड पारिदिनेछ।","poem":2},{"text":"त्यहाँ कोही पनि बस्‍नेछैन;","poem":1},{"text":"मानिसहरू र पशुहरू दुवै भागेर जानेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ती दिनहरूमा र त्यस समयमा,” याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"lineBreak":true},{"text":"“इस्राएलका र यहूदाका मानिसहरू एकसाथ","poem":1},{"text":"याहवेह तिनीहरूका परमेश्‍वरलाई खोज्न रुँदै जानेछन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिनीहरूले सियोन जाने बाटो सोध्नेछन्","poem":1},{"text":"र आफ्ना अनुहार त्यस दिशातिर फर्काउनेछन्।","poem":2},{"text":"तिनीहरू आउनेछन् र आफूलाई","poem":1},{"text":"अनन्तको करारमा याहवेहसँग बाँध्नेछन्,","poem":2},{"lineBreak":true},{"text":"जुन कहिल्यै बिर्सिइनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“मेरा मानिसहरू हराएका भेडाहरूजस्तै भएका छन्;","poem":1},{"text":"तिनीहरूका गोठालाहरूले तिनीहरूलाई कुबाटोतिर लगाएका छन्,","poem":2},{"lineBreak":true},{"text":"र पर्वततिर डुलिहिँड्ने बनाइदिएका छन्।","poem":2},{"text":"तिनीहरू डाँडा र पहाडतिर बरालिएका छन्,","poem":1},{"text":"र तिनीहरूले आफ्ना बासस्थानलाई बिर्सेका छन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"जजसले तिनीहरूलाई भेट्टाए, तिनीहरूलाई निले;","poem":1},{"text":"तिनीहरूका शत्रुहरूले भने, ‘हामी दोषी छैनौँ;","poem":2},{"text":"किनकि तिनीहरूले याहवेह, तिनीहरूको साँचो खर्क,","poem":1},{"text":"याहवेह, तिनीहरूका पितापुर्खाहरूका आशाको विरुद्धमा पाप गरेका छन्।’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“बेबिलोनबाट भाग,","poem":1},{"text":"बेबिलोनीहरूको देशलाई छोडेर भाग;","poem":2},{"lineBreak":true},{"text":"अनि बगाललाई बाटो देखाउने बाख्राहरूजस्तै होओ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"किनकि हेर, म उत्तरको देशबाट महान् जातिहरूको जमातलाई","poem":1},{"text":"सुर्‍याएर बेबिलोनको विरुद्धमा ल्याउनेछु।","poem":2},{"text":"तिनीहरू त्यसको विरुद्धमा युद्धको निम्ति तयार हुनेछन्;","poem":1},{"text":"अनि उत्तर दिशाबाट त्यसलाई कब्जा गर्नेछन्।","poem":2},{"text":"तिनीहरूका काँडहरू सिपालु योद्धाहरूजस्ता हुनेछन्,","poem":1},{"text":"जो रित्तो हात फर्कँदैनन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"यसरी बेबिलोनिया लुटिनेछ;","poem":1},{"text":"बेबिलोनलाई लुट्नेहरू सबैसँग प्रशस्त हुनेछ,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“मेरो उत्तराधिकारलाई लुट्ने तिमीहरू,","poem":1},{"text":"आनन्दित भएर खुशी मनाएको कारण","poem":2},{"text":"तिमीहरू अन्‍न दाइँ गर्दा खलामा हर्षले उफ्रने कोरलीजस्तै रमाएको कारण","poem":1},{"text":"र घोडाजस्तै तिमीहरू हिनहिनाएको कारण,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तिमीहरूकी आमा ठूलो शर्ममा पर्नेछे;","poem":1},{"text":"तिमीहरूलाई जन्म दिने आमा अपमानित हुनेछे।","poem":2},{"text":"त्यो राष्ट्रहरूमा सबैभन्दा सानो हुनेछे—","poem":1},{"text":"एउटा उजाडस्थान, रुखो जमिन र मरुभूमिजस्तै हुनेछे।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"याहवेहको रिसको कारण त्यसमा कोही बसोबास गर्नेछैन,","poem":1},{"text":"तर पूर्ण रूपमा सदाको निम्ति उजाड हुनेछ।","poem":2},{"text":"बेबिलोनबाट भएर जानेहरू सबै चकित हुनेछन्;","poem":1},{"text":"तिनीहरूले त्यसका चोटहरूमा खिसी गर्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“हे सबै धर्नुधारीहरू हो,","poem":1},{"text":"बेबिलोनको चारैतिर मोर्चा बाँध।","poem":2},{"text":"त्यसलाई हान! एउटै काँड बाँकी नरहने गरी हान;","poem":1},{"text":"किनकि त्यसले याहवेहको विरुद्धमा पाप गरेकी छे।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"त्यसको विरुद्धमा चारैतिर युद्धको निम्ति कराओ!","poem":1},{"text":"त्यसले आत्मसमर्पण गर्नेछे र त्यसका धरहराहरू ढल्नेछन्;","poem":2},{"lineBreak":true},{"text":"त्यसका पर्खालहरू भत्काएर ढालिनेछन्।","poem":2},{"text":"किनकि योचाहिँ याहवेहको बदला हो।","poem":1},{"text":"त्यससँग बदला लेओ;","poem":2},{"lineBreak":true},{"text":"त्यसले अरूलाई जस्तो गरेकी छे, त्यससँग पनि त्यस्तै गर।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"बेबिलोनबाट छर्नेहरूलाई,","poem":1},{"text":"र फसलमा हँसिया लिएर कटनी गर्नेहरूलाई नाश गर।","poem":2},{"text":"आक्रमणकारीहरूका तरवारको कारण","poem":1},{"text":"हरेक व्यक्ति आफ्नै मानिसहरूकहाँ फर्किएर जाऊन्,","poem":2},{"lineBreak":true},{"text":"र हरेक व्यक्ति आफ्नै देशमा भागेर जाऊन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“इस्राएल सिंहले खेदेर","poem":1},{"text":"छरपस्ट भएको भेडाको बगालजस्तै छ।","poem":2},{"text":"तिनीहरूलाई निल्ने पहिलो सिंहचाहिँ","poem":1},{"text":"अश्शूरको राजा थियो;","poem":2},{"text":"तिनीहरूको हड्डी चुर-चुर पार्ने अन्तिम सिंहचाहिँ","poem":1},{"text":"बेबिलोनको राजा नबूकदनेसर थियो।”","poem":2}]},{"type":"verse","number":18,"content":["यसकारण सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर, यसो भन्‍नुहुन्छ:",{"text":"“अश्शूरको राजालाई मैले दण्ड दिएझैँ,","poem":1},{"text":"बेबिलोनको राजा र त्यसको देशलाई पनि म दण्ड दिनेछु।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तर म इस्राएललाई तिनीहरूको आफ्नै खर्कमा फर्काएर ल्याउनेछु;","poem":1},{"text":"अनि त्यो कर्मेल र बाशानमा चर्नेछ;","poem":2},{"text":"तिनीहरूको भोक एफ्राइम र गिलादका","poem":1},{"text":"पहाडहरूमा तृप्‍त हुनेछ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ती दिनहरूमा र त्यस समयमा,” याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"lineBreak":true},{"text":"“इस्राएलको अपराध खोजिनेछ,","poem":1},{"text":"तर त्यहाँ एउटै पनि पाइनेछैन;","poem":2},{"text":"अनि यहूदाका पापहरू पनि खोजिनेछ,","poem":1},{"text":"तर केही पनि फेला पर्नेछैन;","poem":2},{"lineBreak":true},{"text":"किनकि मैले बचाइराखेको बाँकी मानिसहरूलाई म क्षमा गर्नेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“मरातैमको देशलाई","poem":1},{"text":"र पेकोदमा बस्‍नेहरूलाई आक्रमण गर।","poem":2},{"text":"तिनीहरूलाई लखेट, मार र सम्पूर्ण रूपले नष्‍ट गर,”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"lineBreak":true},{"text":"मैले तिमीहरूलाई आज्ञा गरेको सबै कुरा पूरा गर।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"देशमा युद्धको हल्‍ला सुनिँदैछ,","poem":1},{"text":"ठूलो विनाशको होहल्‍ला भएको छ!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"हेर, सारा पृथ्वीको घन बेबिलोन","poem":1},{"text":"कसरी टुक्रिएकी छे र चकनाचुर भएकी छे!","poem":2},{"text":"राष्ट्रहरूका बीचमा","poem":1},{"text":"बेबिलोन कति उजाड भएकी छे!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"हे बेबिलोन, मैले तेरा लागि पासो थापेको छु;","poem":1},{"text":"अनि तैँले थाहा पाउन अगि नै तँ पासोमा परिसकेकी छेस्;","poem":2},{"text":"तँ फेला परिस् र कब्जामा परिस्;","poem":1},{"text":"किनकि तँ याहवेहको विरोधमा खडा भइस्।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"याहवेहले आफ्नो अस्त्रभण्डार खोल्नुभएको छ,","poem":1},{"text":"र आफ्नो क्रोधका हतियारहरू निकाल्नुभएको छ;","poem":2},{"text":"किनकि प्रभु सेनाहरूका याहवेहले","poem":1},{"text":"बेबिलोनीहरूका देशमा आफ्नो काम गर्नुपर्नेछ।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"टाढा देशबाट बेबिलोनको विरुद्धमा आओ।","poem":1},{"text":"त्यसका अन्‍नका भण्डारहरू भत्काइदेओ;","poem":2},{"lineBreak":true},{"text":"बेबिलोनलाई अन्‍नको थुप्रोझैँ थुपारी देओ।","poem":2},{"text":"त्यसलाई पूर्ण रूपमा नाश गरिदेओ,","poem":1},{"text":"र त्यसको लागि कसैलाई बाँकी नराख।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"त्यसका सबै जवान साँढेहरूलाई मारिदेओ;","poem":1},{"text":"तिनीहरू काटिने ठाउँमा जाऊन्!","poem":2},{"text":"तिनीहरूलाई धिक्‍कार छ!","poem":1},{"text":"किनकि तिनीहरूको समय आएको छ;","poem":2},{"text":"तिनीहरूको दण्डको समय आएको छ।","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"बेबिलोनबाट भाग्नेहरू र शरण लिने मानिसहरूले","poem":1},{"text":"सियोन पर्वतमा घोषणा गरिरहेका छन्, सो कुरा सुन,","poem":2},{"text":"“याहवेह हाम्रा परमेश्‍वरले बेबिलोनीहरूलाई उहाँको मन्दिर भत्काएको कारण","poem":1},{"text":"उहाँले कसरी बदला लिनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“धनुकाँड चलाउन सक्ने सबै सिपालु धनुर्धारीहरूलाई","poem":1},{"text":"बेबिलोनको विरुद्धमा बोलाओ।","poem":2},{"text":"त्यसका चारैतिर छाउनी बनाएर घेरा लगाओ;","poem":1},{"text":"एउटै पनि भाग्न नपाओस्।","poem":2},{"text":"त्यसले गरेका कामहरूको बदला लेओ;","poem":1},{"text":"त्यसले जस्तो गरेकी छे, त्यसलाई त्यस्तै व्यवहार गर।","poem":2},{"text":"किनकि त्यसले इस्राएलका याहवेह","poem":1},{"text":"पवित्र परमेश्‍वरलाई घमण्डसाथ अवहेलना गरेकी छे।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"यसकारण त्यसका जवान मानिसहरू सडकहरूमा ढल्नेछन्;","poem":1},{"text":"त्यस दिन त्यसका सबै सेनाहरू मारिनेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“हेर, हे अहङ्कारी बेबिलोन, म तेरो विरुद्धमा छु,”","poem":1},{"text":"प्रभु, सेनाहरूका याहवेह घोषणा गर्नुहुन्छ;","poem":2},{"text":"“किनकि तेरो दिन आएको छ,","poem":1},{"text":"तेरो दण्ड पाउने समय आएको छ।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"त्यो अहङ्कारी बेबिलोन ठक्‍कर खाएर लड्नेछे,","poem":1},{"text":"र त्यसलाई कसैले पनि उठ्न सहायता गर्नेछैन;","poem":2},{"text":"म त्यसका सहरहरूमा आगो लगाइदिनेछु,","poem":1},{"text":"र त्यस आगोले त्यसका चारैतिर भएका अहङ्कारीहरू सबैलाई भस्म पारिदिनेछ।”","poem":2}]},{"type":"verse","number":33,"content":["सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:",{"text":"“इस्राएलका मानिसहरू थिचोमिचोमा परेका छन्;","poem":1},{"text":"अनि यहूदाका मानिसहरू पनि थिचोमिचोमा छन्।","poem":2},{"text":"तिनीहरू दुवैलाई कैद गरेर लैजानेहरू सबैले","poem":1},{"text":"तिनीहरू दुवैलाई छोडिदिन इन्कार गर्छन्।","poem":2}]},{"type":"verse","number":34,"content":[{"text":"तापनि तिनीहरूका उद्धारकर्ता शक्तिशाली हुनुहुन्छ;","poem":1},{"text":"उहाँको नाम सेनाहरूका याहवेह हो।","poem":2},{"text":"उहाँले तिनीहरूको पक्षमा लड्नुहुनेछ,","poem":1},{"text":"ताकि उहाँले पृथ्वीमा भएका सबै मानिसहरूमाथि शान्ति ल्याउनुहुनेछ,","poem":2},{"lineBreak":true},{"text":"तर बेबिलोनमा बस्‍ने मानिसहरूमा चाहिँ अशान्ति ल्याउनुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“बेबिलोनीहरूको विरुद्धमा एउटा तरवार परेको छ!”","poem":1},{"text":"याहवेह घोषणा गर्नुहुन्छ—","poem":2},{"text":"“बेबिलोनमा बस्‍ने मनिसहरूको विरुद्धमा,","poem":1},{"text":"त्यसका अधिकारीहरू र बुद्धिमान् मानिसहरूको विरुद्धमा!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"तिनीहरूका झूटा अगमवक्ताहरूको विरुद्धमा तरवार चलेको छ!","poem":1},{"text":"तिनीहरू मूर्ख हुनेछन्।","poem":2},{"text":"त्यसका योद्धाहरूको विरुद्धमा तरवार परेको छ!","poem":1},{"text":"तिनीहरू त्रासले भरिनेछन्।","poem":2}]},{"type":"verse","number":37,"content":[{"text":"त्यसका घोडाहरू, रथहरू","poem":1},{"text":"र त्यसका साथमा रहेका सबै विदेशीहरूको विरुद्धमा तरवार चलेको छ!","poem":2},{"lineBreak":true},{"text":"तिनीहरू स्त्रीहरूझैँ दुर्बल हुनेछन्।","poem":2},{"text":"तिनीहरूका धनका भण्डारहरूको विरुद्धमा तरवार परेको छ!","poem":1},{"text":"ती धनका भण्डारहरू लुटिनेछन्।","poem":2}]},{"type":"verse","number":38,"content":[{"text":"देशका पानीका मुहानहरूमा खडेरी परोस्!","poem":1},{"text":"त्यसका नदीहरू सबै सुकोस्।","poem":2},{"text":"किनकि बेबिलोन मूर्तिहरूको देश हो,","poem":1},{"text":"ती मूर्तिहरूले मानिसहरूलाई त्रसित बनाएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“यसकारण त्यहाँ मरुभूमिका जङ्गली जनावर र हुँडारहरू बस्‍नेछन्;","poem":1},{"text":"अनि त्यहाँ उल्‍लुहरू बास गर्नेछन्।","poem":2},{"text":"त्यहाँ फेरि पुस्तादेखि पुस्तासम्म,","poem":1},{"text":"मानिसहरूले फेरि कहिल्यै बास बस्‍नेछैनन्।","poem":2}]},{"type":"verse","number":40,"content":[{"text":"जसरी मैले सदोम र गमोरालाई","poem":1},{"text":"तिनीहरूका चारैतिरका सहरहरूसितै नाश गरेँ,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ,","poem":2},{"text":"“त्यसरी नै त्यहाँ कोही पनि मानिस बास बस्‍नेछैन;","poem":1},{"text":"त्यहाँ कुनै मानव-जाति बसोबास गर्नेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“हेर! उत्तरबाट एक दल सेना आउँदैछ;","poem":1},{"text":"पृथ्वीको अन्तिम सिमानाबाट एउटा ठूलो राष्ट्रलाई","poem":2},{"lineBreak":true},{"text":"र धेरै राजाहरूलाई सुर्‍याइरहेको छ।","poem":2}]},{"type":"verse","number":42,"content":[{"text":"तिनीहरू धनु र भालाहरूले सुसज्जित छन्;","poem":1},{"text":"तिनीहरू निष्‍ठुर र निर्दयी छन्।","poem":2},{"text":"तिनीहरू आ-आफ्ना घोडाहरूमा सवार गर्दा","poem":1},{"text":"तिनीहरूको घोडसवारको आवाज समुद्रको गर्जनझैँ सुनिन्छ;","poem":2},{"text":"हे बेबिलोनकी छोरी, तिनीहरूले तिमीहरूलाई आक्रमण गर्न आउँदा","poem":1},{"text":"लडाइँको मोर्चा बाँधेर तिनीहरू मानिसहरूझैँ आउनेछन्।","poem":2}]},{"type":"verse","number":43,"content":[{"text":"बेबिलोनको राजाले तिनीहरूको बारेमा खबर सुनेको छ;","poem":1},{"text":"अनि त्यसका हातहरू लल्याकलुलुक भएका छन्।","poem":2},{"text":"प्रसव-वेदनामा परेकी स्त्रीलाई जस्तै","poem":1},{"text":"पीडाले त्यसलाई पक्रेको छ।","poem":2}]},{"type":"verse","number":44,"content":[{"text":"हेर, यर्दन नदीका झाडीहरूबाट","poem":1},{"text":"हरियो खर्कबाट निस्केर आइरहेको सिंहझैँ म निस्कनेछु,","poem":2},{"text":"र म बेबिलोनलाई झट्टै त्यसकै देशबाट खेद्नेछु;","poem":1},{"text":"यस देशको निम्ति जसलाई चुन्छु, उसैलाई नियुक्त गर्नेछु।","poem":2},{"text":"मजस्तो को छ र? कसले मलाई चुनौती दिन सक्छ?","poem":1},{"text":"अनि कुनचाहिँ गोठालो मेरो विरुद्धमा खडा हुन सक्छ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"यसकारण बेबिलोनको विरुद्धमा याहवेहले जे योजना गर्नुभएको छ,","poem":1},{"text":"उहाँले बेबिलोनीहरूको देशको विरुद्धमा जे उद्देश्य राख्नुभएको छ, सुन:","poem":2},{"text":"बगालका कलिला बालबालिकाहरू तानेर लगिनेछन्;","poem":1},{"text":"तिनीहरूका खर्कहरू पूर्ण रूपमा सर्वनाश हुनेछन्।","poem":2}]},{"type":"verse","number":46,"content":[{"text":"बेबिलोन कब्जा गरिएको आवाजले पृथ्वी थरथर काँप्‍नेछ;","poem":1},{"text":"तिनीहरूको चीत्कार राष्ट्रहरूका बीचमा गुञ्जिनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}