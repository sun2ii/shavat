{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“हेर, बेबिलोन र लेब-कमाईका मानिसहरूका विरुद्धमा","poem":1},{"text":"म एक विनाश गर्ने आत्मालाई उक्साउनेछु।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"म बेबिलोनलाई निफन्‍न र","poem":1},{"text":"त्यस देशलाई नष्‍ट गर्नलाई विदेशीहरू पठाउनेछु;","poem":2},{"text":"त्यसको विपत्तिको दिनमा","poem":1},{"text":"शत्रुहरूले चारैतिरबाट त्यसको विरोध गर्नेछन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"धनुर्धारीले आफ्नो धनुमा ताँदो नचढाओस्,","poem":1},{"text":"न त त्यो आफ्नो कवच लगाएर खडा होस्।","poem":2},{"text":"तिनीहरूका जवानहरूलाई बाँकी नराख;","poem":1},{"text":"तिनीहरूका सेनाहरूलाई पूर्ण रूपले सर्वनाश गर।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरू बेबिलोनका सडकहरूमा घाइते भएर लड्नेछन्,","poem":1},{"text":"र तिनीहरू बेबिलोनमै मारिनेछन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"किनकि इस्राएल र यहूदा तिनीहरूका परमेश्‍वर,","poem":1},{"text":"सेनाहरूका याहवेहद्वारा त्यागिएका छैनन्;","poem":2},{"text":"यद्यपि बेबिलोनीहरूको देश इस्राएलका","poem":1},{"text":"पवित्र परमेश्‍वरको सामु अपराधले भरिएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“बेबिलोनबाट भाग!","poem":1},{"text":"आ-आफ्नो प्राण बचाउनलाई भाग!","poem":2},{"lineBreak":true},{"text":"त्यसका पापहरूको कारण तिमीहरू नाश नहोओ।","poem":2},{"text":"यो त याहवेहले बदला लिने समय हो;","poem":1},{"text":"उहाँले त्यसलाई उचित दण्ड दिनुहुनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"बेबिलोन याहवेहको हातमा एउटा सुनको कचौरा थियो;","poem":1},{"text":"त्यसले सारा पृथ्वीलाई मतायो।","poem":2},{"text":"राष्ट्रहरूले त्यसको मद्य पिएका छन्;","poem":1},{"text":"यसकारण अहिले तिनीहरू पागल भएका छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"बेबिलोन एक्‍कासि पतन हुनेछ र टुक्रिनेछ।","poem":1},{"text":"त्यसको निम्ति विलाप गर!","poem":2},{"text":"त्यसको कष्‍टका निम्ति मलम ल्याओ;","poem":1},{"text":"सायद त्यो निको हुन्छे कि!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“हामी बेबिलोनलाई निको पार्नेथियौँ,","poem":1},{"text":"तर त्यो निको हुन सक्दैन;","poem":2},{"text":"त्यसलाई छोडिदियौँ र हामी आ-आफ्नो देशमा जाऔँ;","poem":1},{"text":"किनकि त्यसको दण्ड आकाशसम्म पुगेको छ,","poem":2},{"lineBreak":true},{"text":"त्यो स्वर्गसम्मै चुलिएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“याहवेहले हामीलाई निर्दोष ठहराउनुभएको छ;","poem":1},{"text":"आओ, हामी सियोनमा जाऔँ,","poem":2},{"lineBreak":true},{"text":"र याहवेह हाम्रा परमेश्‍वरको काम बयान गरौँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“धनुकाँडहरू तीखा पार!","poem":1},{"text":"ढालहरू उठाओ!","poem":2},{"text":"याहवेहले मादीका राजाहरूलाई उक्साउनुभएको छ;","poem":1},{"text":"किनकि उहाँको उद्देश्य बेबिलोनलाई नष्‍ट गर्नु हो।","poem":2},{"text":"याहवेहले बदला लिनुहुनेछ;","poem":1},{"text":"उहाँको मन्दिर नष्‍ट गर्नेहरूलाई बदला लिनुहुनेछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"बेबिलोनका पर्खालहरूको विरुद्धमा झण्डा उठाओ!","poem":1},{"text":"पहरा-चौकी बलियो बनाओ;","poem":2},{"text":"पहरेदारहरूलाई खटाओ,","poem":1},{"text":"ढुकेर आक्रमण गर्नेहरूलाई तयार गर!","poem":2},{"text":"याहवेहले आफ्नो उद्देश्य पूरा गर्नुहुनेछ;","poem":1},{"text":"अनि बेबिलोनका मानिसहरूको विरुद्धमा उहाँले आफ्नो उर्दी पूरा गर्नुहुनेछ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तँ बेबिलोन, जो धेरै नदीहरूको नजिक बस्छेस्","poem":1},{"text":"र धेरै धनसम्पत्तिको भण्डारले पूर्ण भएकी छेस्,","poem":2},{"text":"तर तेरो अन्त्य आएको छ।","poem":1},{"text":"तेरो विनाशको समय आएको छ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"सेनाहरूका याहवेहले आफ्नै नामको शपथ खानुभएको छ:","poem":1},{"text":"म निश्‍चय नै बेबिलोनलाई आक्रमण गर्न सलहको बथानझैँ सेनाहरूको भीडले भरिदिनेछु;","poem":2},{"lineBreak":true},{"text":"अनि तिनीहरूले तँमाथि विजयी भएर जयजयकार गर्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“याहवेहले पृथ्वी आफ्नो शक्तिद्वारा बनाउनुभयो;","poem":1},{"text":"उहाँले संसारलाई आफ्नो बुद्धिले स्थापित गर्नुभयो","poem":2},{"lineBreak":true},{"text":"र उहाँले आकाशलाई आफ्नो समझशक्तिले फैलाउनुभयो।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"जब उहाँ बोल्नुहुन्छ, तब आकाशमा पानीको गर्जन हुन्छ;","poem":1},{"text":"उहाँले बादललाई पृथ्वीको अन्तिम छेउबाट उठाउनुहुन्छ।","poem":2},{"text":"उहाँले झरीसँग बिजुली पठाउनुहुन्छ,","poem":1},{"text":"अनि हावालाई उहाँको भण्डारहरूबाट निकाल्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“हरेक मानिस विवेकहीन र ज्ञानहीन छ;","poem":1},{"text":"हरेक सुनार आफ्नै मूर्तिहरूद्वारा शर्ममा पर्नेछ।","poem":2},{"text":"किनकि त्यसले बनाएका मूर्तिहरू झूटा हुन्;","poem":1},{"text":"तिनीहरूमा जीवनको सास हुँदैन।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ती मूर्तिहरू सबै व्यर्थका र ठट्टाका पात्र हुन्;","poem":1},{"text":"जब तिनीहरूको न्याय आउँछ, तब तिनीहरू नष्‍ट हुनेछन्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"उहाँ, जो याकोबका अंश हुनुहुन्छ, उहाँ ती मूर्तिहरूजस्ता हुनुहुन्‍न;","poem":1},{"text":"किनकि उहाँ सबै कुराहरूको सृष्‍टिकर्ता हुनुहुन्छ,","poem":2},{"text":"जसमा उहाँको उत्तराधिकारका मानिसहरू पनि सामेल छन्;","poem":1},{"text":"सेनाहरूका याहवेह उहाँको नाम हो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“तँ मेरो युद्धको मुङ्ग्रो,","poem":1},{"text":"मेरो लडाइँका निम्ति हतियार होस्;","poem":2},{"text":"तँद्वारा म राष्ट्रहरूलाई चकनाचुर पार्छु;","poem":1},{"text":"र तँद्वारा नै म राज्यहरूलाई नष्‍ट गर्छु।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तँद्वारा म घोडा र घोडसवारहरूलाई टुक्रा-टुक्रा पार्छु;","poem":1},{"text":"तँद्वारा म रथहरू र रथ-सवारहरूलाई चकनाचुर पार्छु।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तँद्वारा म पुरुषहरू र स्त्रीहरूलाई चकनाचुर पार्छु।","poem":1},{"text":"तँद्वारा म वृद्ध मानिस र जवानलाई चकनाचुर पार्छु।","poem":2},{"lineBreak":true},{"text":"तँद्वारा म जवान केटाहरू र कन्या केटीहरूलाई चकनाचुर पार्छु।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तँद्वारा म गोठाला र भेडाबाख्राको बगाललाई चकनाचुर पार्छु;","poem":1},{"text":"तँद्वारा म किसान र गोरुहरूलाई चकनाचुर पार्छु।","poem":2},{"lineBreak":true},{"text":"तँद्वारा म राज्यपालहरू र अधिकारीहरूलाई चकनाचुर पार्छु।","poem":2}]},{"type":"verse","number":24,"content":["“तेरो आँखाको सामु म बेबिलोन र बेबिलोनमा बस्‍ने सबै मानिसहरूलाई सियोनमा तिनीहरूले गरेका सबै खराबीको निम्ति दण्ड दिनेछु,” याहवेह घोषणा गर्नुहुन्छ।"]},{"type":"verse","number":25,"content":[{"text":"“हे, विनाशकारी पर्वत, म तेरो विरुद्धमा छु;","poem":1},{"text":"तैँले सारा पृथ्वीलाई नष्‍ट गर्छस्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2},{"text":"“म तेरो विरुद्धमा मेरो हात पसार्नेछु,","poem":1},{"text":"तँलाई भिरबाट तल गुडाइदिनेछु;","poem":2},{"lineBreak":true},{"text":"अनि तँलाई एउटा डढेको उजाड पहाड तुल्याउनेछु।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"तँबाट कुनाको निम्ति कुनै ढुङ्गा लिइनेछैन,","poem":1},{"text":"न त जगको निम्ति कुनै ढुङ्गा लिइनेछ;","poem":2},{"lineBreak":true},{"text":"किनकि तँ सदाको निम्ति उजाड रहनेछस्,” याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“देशमा एउटा झण्डा उठाओ!","poem":1},{"text":"राष्ट्रहरूका बीचमा तुरही बजाओ!","poem":2},{"text":"त्यसको विरुद्धमा लडाइँको निम्ति राष्ट्रहरूलाई तयार पार;","poem":1},{"text":"यी राज्यहरूलाई त्यसको विरुद्धमा आक्रमण गर्नलाई बोलाओ:","poem":2},{"lineBreak":true},{"text":"अरारात, मिन्‍नी र अश्कनजलाई बोलाओ।","poem":2},{"text":"त्यसको विरुद्धमा एउटा सेनापति नियुक्त गर;","poem":1},{"text":"सलहको बथानझैँ घोडाहरूलाई पठाओ।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"त्यसको विरुद्धमा युद्ध गर्नलाई राष्ट्रहरूलाई तयार गर!","poem":1},{"text":"मादीका राजाहरूलाई,","poem":2},{"text":"तिनीहरूका राज्यपालहरूलाई र तिनीहरूका सबै अधिकारीहरूलाई,","poem":1},{"text":"र तिनीहरूले शासन गर्ने देशहरूलाई तयार गर।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"देश थरथर काम्छ र छटपटिन्छ;","poem":1},{"text":"किनकि बेबिलोनको विरुद्धमा याहवेहको उद्देश्य अटल छ!","poem":2},{"text":"बेबिलोनको देशलाई उजाड पार्नलाई,","poem":1},{"text":"त्यहाँ कोही पनि नबसून्।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"बेबिलोनका सेनाहरूले युद्ध गर्न बन्द गरेका छन्;","poem":1},{"text":"तिनीहरू आफ्ना किल्‍लाहरूमा रहन्छन्।","poem":2},{"text":"तिनीहरूको बल शिथिल भएको छ;","poem":1},{"text":"तिनीहरू दुर्बल भएका छन्।","poem":2},{"text":"त्यसका वासस्थानहरूमा आगो लगाइएका छन्;","poem":1},{"text":"त्यसका मूलढोकाका गजबारहरू भत्काइएका छन्।","poem":2}]},{"type":"verse","number":31,"content":[{"text":"एक हुलाकी अर्को हुलाकीको पछि दौडन्छ;","poem":1},{"text":"एक सन्देशवाहक अर्को सन्देशवाहकको पछि दौडन्छ।","poem":2},{"text":"बेबिलोनको राजालाई यो खबर दिन","poem":1},{"text":"उसको सम्पूर्ण सहर कब्जा गरिएका छन्;","poem":2}]},{"type":"verse","number":32,"content":[{"text":"अनि नदीका घाटहरूलाई कब्जा गरिएका छन्;","poem":1},{"text":"धापहरूमा आगो लगाइएका छन्;","poem":2},{"lineBreak":true},{"text":"अनि योद्धाहरू त्रसित भएका छन्।”","poem":2}]},{"type":"verse","number":33,"content":["सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ:",{"text":"“बेबिलोनकी छोरी दाइँ गर्ने समयमा","poem":1},{"text":"कुल्चिएको खलाझैँ भएकी छे;","poem":2},{"lineBreak":true},{"text":"त्यसको कटनी गर्ने समय चाँडै आउँदैछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“बेबिलोनको राजा नबूकदनेसरले हामीलाई निलेको छ;","poem":1},{"text":"त्यसले हामीलाई अलमलमा पारिदिएको छ।","poem":2},{"lineBreak":true},{"text":"त्यसले हामीलाई रित्तो भाँडाजस्तै बनाइदिएको छ।","poem":2},{"text":"त्यसले हामीलाई अजिङ्गरले झैँ निलेको छ,","poem":1},{"text":"र त्यसले हाम्रो स्वादिष्‍ठ भोजनले आफ्नो पेट भरेको छ;","poem":2},{"lineBreak":true},{"text":"त्यसपछि हामीलाई बान्ता गरेर फ्याँकिदिएको छ।","poem":2}]},{"type":"verse","number":35,"content":[{"text":"सियोनका बासिन्दाहरूले भन्छन्,","poem":1},{"text":"हामी र हाम्रा छोराछोरीहरूमाथि जस्तो अत्याचार परेको छ,","poem":2},{"lineBreak":true},{"text":"त्यस्तै बेबिलोनमाथि पनि परोस्”।","poem":2},{"text":"यरूशलेमले भन्छ,","poem":1},{"text":"“हाम्रो रगत बगाएको बदला बेबिलोनमा बस्‍ने मानिसहरूमाथि परोस्”।","poem":2}]},{"type":"verse","number":36,"content":["यसकारण याहवेह भन्‍नुहुन्छ:",{"text":"“हेर, म तेरो पक्ष लिनेछु,","poem":1},{"text":"र तेरो बदला लिनेछु;","poem":2},{"text":"म त्यसको समुद्र सुकाइदिनेछु;","poem":1},{"text":"अनि त्यसको पानीका मुहानहरू सुकाइदिनेछु।","poem":2}]},{"type":"verse","number":37,"content":[{"text":"बेबिलोन भग्नावशेषको थुप्रो हुनेछ;","poem":1},{"text":"स्यालहरूको ओडार हुनेछ;","poem":2},{"text":"त्रास र गिल्‍लाको पात्र,","poem":1},{"text":"कोही पनि नबस्‍ने एउटा उजाड ठाउँ हुनेछ।","poem":2}]},{"type":"verse","number":38,"content":[{"text":"त्यसका मानिसहरू सबै सिंहझैँ गर्जन्छन्।","poem":1},{"text":"तिनीहरू सिंहका डमरुझैँ ङुर्र-ङुर्र गर्छन्।","poem":2}]},{"type":"verse","number":39,"content":[{"text":"तर जब तिनीहरू उत्तेजित हुन्छन्,","poem":1},{"text":"म तिनीहरूका निम्ति भोज तयार पार्नेछु,","poem":2},{"lineBreak":true},{"text":"र तिनीहरूलाई मताउनेछु,","poem":2},{"text":"ताकि तिनीहरू हाँस्दै चिच्याउनेछन्;","poem":1},{"text":"अनि सदाको निम्ति सुत्नेछन् र निन्द्राबाट कहिल्यै बिउँझनेछैनन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":40,"content":[{"text":"“म तिनीहरूलाई काटिनका निम्ति लगिएका","poem":1},{"text":"थुमाहरू, भेडाहरू र बाख्राहरूझैँ तल लैजानेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“शेशक","poem":1},{"noteId":30},{"text":"कसरी कब्जा हुनेछ;","poem":1},{"text":"सारा पृथ्वीको प्रशंसाको पात्र बेबिलोन कब्जा गरिनेछ!","poem":2},{"text":"राष्ट्रहरूको बीचमा","poem":1},{"text":"बेबिलोन एउटा भयानक दृश्य हुनेछ!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"बेबिलोनमाथि समुद्र उठ्नेछ;","poem":1},{"text":"त्यसका गर्जने छालहरूले त्यसलाई छोपिदिनेछन्।","poem":2}]},{"type":"verse","number":43,"content":[{"text":"त्यसका सहरहरू उजाड हुनेछन्,","poem":1},{"text":"सुक्खा र मरुभूमिको देश,","poem":2},{"text":"जहाँ कोही पनि नबस्‍ने देश,","poem":1},{"text":"जुन देशबाट भएर कसैले पनि यात्रा गर्नेछैन।","poem":2}]},{"type":"verse","number":44,"content":[{"text":"म बेबिलोनमा बेललाई दण्ड दिनेछु;","poem":1},{"text":"अनि त्यसले जे निलेको छ, त्यो बान्ता गर्न लगाउनेछु।","poem":2},{"text":"फेरि राष्ट्रहरू ताँती लगाएर आउनेछैनन्,","poem":1},{"text":"र बेबिलोनको पर्खाल ढल्नेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“हे मेरा मानिसहरू हो!","poem":1},{"text":"आफ्ना प्राण बचाउनलाई भाग!","poem":2},{"lineBreak":true},{"text":"याहवेहको भयानक क्रोधदेखि भाग।","poem":2}]},{"type":"verse","number":46,"content":[{"text":"जब देशमा हल्‍ला सुन्छौ,","poem":1},{"text":"तब हतोत्साही नहोओ, अथवा नडराओ;","poem":2},{"text":"यस वर्ष एउटा हल्‍ला र अर्को वर्ष अर्कै हल्‍ला आउँछ;","poem":1},{"text":"देशमा अत्याचारको हल्‍ला","poem":2},{"lineBreak":true},{"text":"र शासकको विरुद्धमा शासक भएको हल्‍ला।","poem":2}]},{"type":"verse","number":47,"content":[{"text":"किनकि हेर, समय निश्‍चय नै आउनेछ,","poem":1},{"text":"जब म बेबिलोनका मूर्तिहरूलाई दण्ड दिनेछु;","poem":2},{"text":"तब त्यसको सम्पूर्ण देश अपमानित हुनेछ,","poem":1},{"text":"र त्यसका मारिएकाहरू सबै त्यसकै भूमिमा ढलिरहनेछन्।","poem":2}]},{"type":"verse","number":48,"content":[{"text":"तब स्वर्ग, पृथ्वी र तिनीहरूमा भएका सबै","poem":1},{"text":"बेबिलोनको यस्तो स्थितिमा रमाउनेछन्;","poem":2},{"text":"किनकि उत्तर दिशातिरबाट","poem":1},{"text":"विनाशकर्ताहरूले त्यसलाई आक्रमण गर्नेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“बेबिलोनको कारण पृथ्वीभरि मानिसहरू मारिएझैँ,","poem":1},{"text":"इस्राएलका मानिसहरूको हत्या गरिएको कारण","poem":2},{"lineBreak":true},{"text":"बेबिलोनको पतन हुनैपर्छ।","poem":2}]},{"type":"verse","number":50,"content":[{"text":"तिमीहरू, जो तरवारबाट उम्केछौ,","poem":1},{"text":"ढिलो नगरी भागिहाल!","poem":2},{"text":"टाढा देशबाट याहवेहलाई स्मरण गर;","poem":1},{"text":"अनि यरूशलेमको बारेमा याद गर।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“हामी लज्जित भएका छौँ;","poem":1},{"text":"किनकि हामी बदनामी भएका छौँ,","poem":2},{"lineBreak":true},{"text":"र हाम्रा अनुहार शर्मले ढाकिएका छन्;","poem":2},{"text":"किनकि विदेशीहरू हाम्रा याहवेहको भवनका","poem":1},{"text":"पवित्र ठाउँहरूमा प्रवेश गरेका छन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"“तर हेर, दिनहरू आउँदैछन्,” याहवेह घोषणा गर्नुहुन्छ।","poem":1},{"text":"“जब म त्यसका मूर्तिहरूलाई दण्ड दिनेछु,","poem":2},{"text":"तब त्यसको देशभरि नै","poem":1},{"text":"घाइतेहरूले सुस्केरा हाल्नेछन्।","poem":2}]},{"type":"verse","number":53,"content":[{"text":"यदि बेबिलोनले आकाशसम्मै पुगेर","poem":1},{"text":"आफ्ना अग्ला किल्‍लाहरूलाई बलियो पारे तापनि","poem":2},{"lineBreak":true},{"text":"म त्यसको विरुद्धमा विनाश गर्नेहरू पठाउनेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“बेबिलोनबाट चीत्कारको आवाज निस्कन्छ;","poem":1},{"text":"बेबिलोनीहरूको देशबाट","poem":2},{"lineBreak":true},{"text":"आएको ठूलो विनाशको आवाज।","poem":2}]},{"type":"verse","number":55,"content":[{"text":"याहवेहले बेबिलोनलाई नाश गर्नुहुनेछ;","poem":1},{"text":"उहाँले त्यसको ठूलो होहल्‍लालाई बन्द गराउनुहुनेछ।","poem":2},{"text":"शत्रुहरू समुद्रका विशाल छालहरूझैँ गर्जनेछन्;","poem":1},{"text":"तिनीहरूका आवाजको गर्जन गुञ्जिनेछ।","poem":2}]},{"type":"verse","number":56,"content":[{"text":"बेबिलोनको विरुद्धमा एउटा विनाशकर्ता आउनेछ;","poem":1},{"text":"त्यसका योद्धाहरू कब्जा गरिनेछन्;","poem":2},{"lineBreak":true},{"text":"अनि तिनीहरूका धनुकाँडहरू भाँचिनेछन्।","poem":2},{"text":"किनकि याहवेह उचित प्रतिफल दिनुहुने परमेश्‍वर हुनुहुन्छ;","poem":1},{"text":"उहाँले पूर्ण रूपमा दण्ड दिनुहुनेछ।","poem":2}]},{"type":"verse","number":57,"content":[{"text":"म तिनीहरूका अधिकारीहरू, बुद्धिमान् मानिसहरूलाई मताइदिनेछु;","poem":1},{"text":"त्यसका राज्यपालहरू, अधिकारीहरू र योद्धाहरू समेतलाई मताइदिनेछु;","poem":2},{"text":"तिनीहरू सदाको निम्ति निदाउनेछन् र कहिल्यै पनि उठ्नेछैनन्,”","poem":1},{"text":"राजा घोषणा गर्नुहुन्छ, “जसको नाम सेनाहरूका याहवेह हो।”","poem":2}]},{"type":"verse","number":58,"content":["सेनाहरूका याहवेह भन्‍नुहुन्छ:",{"text":"“बेबिलोनको चौडा पर्खाल समतल बनाइनेछ;","poem":1},{"text":"अनि त्यसका अग्ला मूलढोकाहरूमा आगो लगाइनेछन्;","poem":2},{"text":"मानिसहरू व्यर्थैमा थाकेर शिथिल हुन्छन्,","poem":1},{"text":"र राष्ट्रको परिश्रमचाहिँ ज्वालाको निम्ति इन्धन मात्र हुनेछन्।”","poem":2}]},{"type":"verse","number":59,"content":["यहूदाका राजा सिदकियाहको शासनकालको चौथो वर्षमा महसेयाहका नाति, नेरियाहका छोरा प्रमुख अधिकारी सरायाहलाई, राजासित बेबिलोनमा जाँदा यर्मियाले तिनलाई दिएको सन्देश यही हो।"]},{"type":"verse","number":60,"content":["बेबिलोनमाथि आउने सबै विपत्तिहरूको बारेमा यर्मियाले एउटा चर्मपत्रमा लेखेका थिए—बेबिलोनको विषयमा सबै कुराहरू लेखे।"]},{"type":"verse","number":61,"content":["यर्मियाले सरायाहलाई भने, “जब तिमी बेबिलोनमा पुग्छौ, तब तिमीले यी सबै वचनहरू अवश्य चर्को आवाजमा मानिसहरूलाई पढेर सुनाउनू।"]},{"type":"verse","number":62,"content":["त्यसपछि यसो भन, ‘हे याहवेह, तपाईंले यस ठाउँलाई नाश गर्नेछु भन्‍नुभएको छ। यसमा न मानिस, न त पशु बसोबास गर्नेछ; यो सदाको निम्ति उजाड हुनेछ।’"]},{"type":"verse","number":63,"content":["जब तिमीले यो चर्मपत्र पढिसक्छौ, तब यसमा एउटा ढुङ्गा बाँध र यसलाई यूफ्रेटिस नदीमा फालिदेऊ।"]},{"type":"verse","number":64,"content":["तब यसो भन, ‘मैले बेबिलोनमाथि ल्याउने विपत्तिको कारण यसरी नै बेबिलोन कहिल्यै नउठ्ने गरी डुब्नेछ। अनि त्यसका मानिसहरूको पतन हुनेछ।’ ”",{"lineBreak":true},{"lineBreak":true},"यर्मियाको सन्देश यहीँ समाप्‍त हुन्छ।"]},{"type":"line_break"}],"footnotes":[{"noteId":30,"caller":"+","text":"शेशक बेबिलोनको साङ्केतिक नाम हो।","reference":{"chapter":51,"verse":41}}]},"thisChapterLink":"/api/npi_ncb/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}