{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JER","translationId":"npi_ncb","name":"यर्मिया","commonName":"यर्मिया","title":"यर्मियाको भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"ef1a9aa5e971270c3335201b1d8afaf8a3c3da486c25686516f8bafc384ef8b2","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/npi_ncb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["यरूशलेम घेरामा परेको"]},{"type":"verse","number":1,"content":[{"text":"“हे बेन्यामीनीहरू हो, सुरक्षाको निम्ति","poem":1},{"text":"यरूशलेमबाट भाग!","poem":2},{"text":"तको सहरमा तुरही फुक!","poem":1},{"text":"बेथ-हक्‍केरेममा खतराको सङ्केत देओ!","poem":2},{"text":"किनकि उत्तर दिशाबाट विपत्ति,","poem":1},{"text":"डरलाग्दो विनाश आउँदैछ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"सियोनकी छोरी, जो सुन्दरी र कोमल छे,","poem":1},{"text":"म त्यसलाई नाश गर्नेछु।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"गोठालाहरू आ-आफ्ना बगाल लिएर त्यसको विरुद्धमा आउनेछन्;","poem":1},{"text":"तिनीहरूले यरूशलेमको चारैतिर आफ्ना पालहरू टाँग्नेछन्;","poem":2},{"lineBreak":true},{"text":"हरेकले आफ्नै बगालको हेरचाह गर्नेछन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“यरूशलेमको विरुद्धमा लडाइँको तयारी गर!","poem":1},{"text":"उठ, हामी मध्यदिनमा आक्रमण गरौँ!","poem":2},{"text":"तर, हाय! दिन ढल्किँदैछ;","poem":1},{"text":"अनि बेलुकीको छाया लामो हुँदैछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यसकारण उठ, हामी राति त्यसमाथि आक्रमण गरौँ,","poem":1},{"text":"र यरूशलेमका किल्‍लाहरू नाश पारिदिऔँ!”","poem":2}]},{"type":"verse","number":6,"content":["सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:",{"text":"“रूखहरू काटेर ढालिदेओ,","poem":1},{"text":"र यरूशलेमको विरुद्धमा घेरा-मचान बनाओ।","poem":2},{"text":"यो सहरले दण्ड पाउनैपर्छ;","poem":1},{"text":"यो सहर अत्याचारले भरिएको छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"जसरी इनारबाट पानी निस्कन्छ,","poem":1},{"text":"त्यसरी नै त्यसले आफ्नो दुष्‍टता निकाल्छे।","poem":2},{"text":"त्यसभित्र हिंसा र विनाश गुञ्जिन्छ;","poem":1},{"text":"त्यसका रोगहरू र चोटहरू सधैँ मेरा सामु छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हे यरूशलेम यो चेतावनी सुन्,","poem":1},{"text":"नत्रता म तँदेखि टाढा हुनेछु,","poem":2},{"text":"र तेरो देशलाई उजाड पारिदिनेछु;","poem":1},{"text":"अनि त्यहाँ कोही पनि बास गर्नेछैन।”","poem":2}]},{"type":"verse","number":9,"content":["सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:",{"text":"“तिनीहरूले इस्राएलका बाँकी रहेकाहरूलाई","poem":1},{"text":"दाखको बोटमा छोडिएका फल नछोडी टिपेझैँ टिपून्;","poem":2},{"text":"कुनै मानिसले अङ्‌गुरहरू बटुलेझैँ,","poem":1},{"text":"आफ्नो हात फेरि ती दाखका हाँगाहरूमा लगा।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"म कोसँग बोलूँ र कसलाई चेतावनी दिऊँ?","poem":1},{"text":"मेरो कुरा कसले सुन्ला?","poem":2},{"text":"तिनीहरूका कान बन्द","poem":1},{"noteId":4},{"text":"भएका छन्।","poem":1},{"text":"त्यसैले तिनीहरू सुन्‍न सक्दैनन्।","poem":2},{"text":"याहवेहको वचन तिनीहरूलाई मन पर्दैन;","poem":1},{"text":"तिनीहरू वचन सुन्‍नै चाहँदैनन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"यसकारण म याहवेहको क्रोधले भरिएको छु;","poem":1},{"text":"अनि म यसलाई थामिराख्न सक्दिनँ।","poem":2},{"lineBreak":true},{"text":"“यसलाई सडकमा भएका केटाकेटीहरू","poem":1},{"text":"र एकसाथ भेला भएका जवान मानिसहरूमाथि;","poem":2},{"text":"पति र पत्नी दुवै,","poem":1},{"text":"र वृद्धहरूमाथि खन्याइदेओ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जब मेरो हात","poem":1},{"text":"यस देशमा बाँचेकाहरूका विरुद्धमा बढाउँछु,","poem":2},{"text":"तब तिनीहरूका घर, खेतबारी","poem":1},{"text":"र पत्नीहरूसमेत अरू मानिसहरूलाई दिइनेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“सबैभन्दा सानादेखि लिएर सबैभन्दा ठूलासम्म","poem":1},{"text":"हरेक अनुचित धन कमाइको निम्ति लोभी छन्।","poem":2},{"text":"अगमवक्ता र पुजारीहरू","poem":1},{"text":"सबै छलका कुरा गर्छन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तिनीहरूले मेरा मानिसहरूका घाउहरूमा","poem":1},{"text":"लापर्बाही तरिकाले मलमपट्टी बाँधिदिन्छन्।","poem":2},{"text":"शान्ति नहुँदा पनि","poem":1},{"text":"तिनीहरूले, ‘शान्ति, शान्ति’ भन्दछन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"के तिनीहरू आफ्ना घृणित आचरणहरूप्रति लज्जित छन् र?","poem":1},{"text":"अहँ, तिनीहरूलाई अलिकति पनि लाज लाग्दैन।","poem":2},{"lineBreak":true},{"text":"तिनीहरू कसरी लाज मान्‍ने भन्‍ने पनि जान्दैनन्।","poem":2},{"text":"यसकारण तिनीहरू पतन भएकाहरूसँग पतन हुनेछन्;","poem":1},{"text":"जब म तिनीहरूलाई दण्ड दिन्छु, तब तिनीहरू नष्‍ट हुनेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह भन्‍नुहुन्छ।","poem":2}]},{"type":"verse","number":16,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“चौबाटोमा उभिएर हेर,","poem":1},{"text":"र प्राचीन मार्गको बारेमा सोध;","poem":2},{"text":"त्यो असल मार्ग कहाँ छ, सोध र त्यसैमा हिँड,","poem":1},{"text":"तब तिमीहरूले आफ्नो आत्मामा विश्राम पाउनेछौ।","poem":2},{"lineBreak":true},{"text":"तर तिमीहरूले भन्यौ, ‘हामी यस मार्गमा हिँड्नेछैनौँ।’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"मैले तिमीहरूमाथि पहरेदारहरू नियुक्त गरेर भनेँ,","poem":1},{"text":"‘तुरहीको आवाजलाई ध्यानसित सुन!’","poem":2},{"lineBreak":true},{"text":"तर तिमीहरूले भन्यौ, ‘हामी सुन्‍नेछैनौँ।’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"यसकारण हे राष्ट्रहरू हो, सुन;","poem":1},{"text":"हे साक्षीहरू हो,","poem":2},{"lineBreak":true},{"text":"तिनीहरूलाई के हुँदोरहेछ, सो ध्यानसित हेर।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"हे पृथ्वी, सुन्;","poem":1},{"text":"तिनीहरूकै योजनाको फलस्वरूप,","poem":2},{"lineBreak":true},{"text":"म यस जातिमाथि विपत्ति ल्याउँदैछु;","poem":2},{"text":"किनकि तिनीहरूले मेरा वचनहरू सुनेनन्,","poem":1},{"text":"र मेरा व्यवस्थाहरूलाई इन्कार गरे।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"शेबादेखि ल्याएको धूप","poem":1},{"text":"अथवा टाढा देशबाट ल्याएको बोझो मलाई के मतलब छ र?","poem":2},{"text":"तिमीहरूका होमबलिहरू ग्रहणयोग्य छैनन्;","poem":1},{"text":"तिमीहरूका बलिदानहरू मेरा निम्ति मनपर्दा छैनन्।”","poem":2}]},{"type":"verse","number":21,"content":["यसकारण याहवेह यसो भन्‍नुहुन्छ:",{"text":"“म यस जातिको सामु ठेस लाग्ने कुराहरू राखिदिनेछु।","poem":1},{"text":"बुबा र छोराछोरीहरू एकसाथ ती कुरामा ठेस खानेछन्;","poem":2},{"lineBreak":true},{"text":"छिमेकीहरू र मित्रहरू नष्‍ट हुनेछन्।”","poem":2}]},{"type":"verse","number":22,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“हेर, उत्तर देशबाट","poem":1},{"text":"एक दल सेना आउँदैछ।","poem":2},{"text":"पृथ्वीको अन्तिम सिमानाबाट","poem":1},{"text":"एउटा ठूलो राष्ट्रलाई सुर्‍याइरहेको छ।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तिनीहरू धनु र भालाले सुसज्जित भएका छन्;","poem":1},{"text":"तिनीहरू निर्दयी छन् र दया देखाउँदैनन्।","poem":2},{"text":"तिनीहरू आफ्ना घोडाहरूमाथि सवार हुँदा","poem":1},{"text":"तिनीहरूको आवाज समुद्रको गर्जनजस्तै सुनिन्छ;","poem":2},{"text":"हे यरूशलेमकी छोरी, तँलाई आक्रमण गर्नका लागि","poem":1},{"text":"तिनीहरू युद्धको पङ्‌क्ति बाँधेर आइरहेका छन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"हामीले तिनीहरूको बारेमा खबर सुन्यौँ,","poem":1},{"text":"र हाम्रा हातहरू लल्याकलुलुक भए।","poem":2},{"text":"प्रसुती वेदनामा परेकी स्त्रीझैँ","poem":1},{"text":"हामी छटपटिएका छौँ।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"खेततिर काम गर्न नजाओ,","poem":1},{"text":"न त सडकतिर हिँड्‍डुल गर;","poem":2},{"text":"किनकि शत्रुसित तरवार छ,","poem":1},{"text":"र चारैतिर डरैडर देखिँदैछ।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"हे मेरा मानिसहरू हो, भाङ्ग्रा लगाओ;","poem":1},{"text":"अनि खरानीमा लडीबुडी गर।","poem":2},{"text":"एक मात्र छोराका निम्ति","poem":1},{"text":"विलाप गरेझैँ शोक गर;","poem":2},{"text":"किनकि विनाशकारी","poem":1},{"text":"हामीमाथि अचानक आइलाग्नेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“मैले तँलाई धातु जाँच्ने वस्तु","poem":1},{"text":"र मानिसहरूलाई कच्‍चा धातु बनाएको छु,","poem":2},{"text":"ताकि तैँले तिनीहरूलाई ध्यानसित हेर्न","poem":1},{"text":"र तिनीहरूका मार्गहरू जाँच गर्न सक्।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"तिनीहरू सबै निन्दा गर्दै,","poem":1},{"text":"यताउति डुलिहिँड्ने कठोर विद्रोहीहरू हुन्।","poem":2},{"text":"तिनीहरू काँसा र फलाम हुन्;","poem":1},{"text":"तिनीहरू सबै भ्रष्‍ट चालहरूमा चल्दछन्।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"आरनमा सिसा जलाउनका लागि खूब जोडसित आगो फुकिन्छ,","poem":1},{"text":"तर खार्ने काम व्यर्थै जान्छ;","poem":2},{"text":"त्यसरी नै मेरा मानिसहरू यति दुष्‍ट छन्, कि","poem":1},{"text":"तिनीहरूबाट दुष्‍ट्याइँ हटाउन सकिँदैन।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"तिनीहरूलाई खोट लागेको चाँदी भनिन्छ;","poem":1},{"text":"किनकि याहवेहले तिनीहरूलाई त्याग्नुभएको छ।”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"मूल भाषामा बेखतना","reference":{"chapter":6,"verse":10}}]},"thisChapterLink":"/api/npi_ncb/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}