{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JOB","translationId":"npi_ncb","name":"इयोब","commonName":"इयोब","title":"इयोबको पुस्तक","order":18,"numberOfChapters":42,"sha256":"3de0a293e7ef031b2c818dfde84603dd4b2226cd508617e3cb5be007607d7a61","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/npi_ncb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["बिल्ददको संवाद"]},{"type":"verse","number":1,"content":["तब बिल्दद शुहीले यस्तो जवाफ दिए:"]},{"type":"verse","number":2,"content":[{"text":"“तपाईंले यी भाषणहरू कहिले समाप्‍त गर्नुहुन्छ?","poem":1},{"text":"संवेदनशील हुनुहोस् र मात्र हामी कुरा गर्न सक्छौँ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हामीलाई किन पशुझैँ व्यवहार गर्नुहुन्छ,","poem":1},{"text":"र तपाईंको दृष्‍टिमा हामीलाई मूर्ख सोच्नुहुन्छ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तपाईं जसले आफ्नो रिसमा स्वयम्‌लाई टुक्रा-टुक्रा पार्नुभएको छ;","poem":1},{"text":"के तपाईंको खातिर पृथ्वीलाई त्यागिदिने?","poem":2},{"lineBreak":true},{"text":"अथवा के चट्टानहरूलाई तिनीहरूका ठाउँबाट हटाइदिने?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“दुष्‍ट मानिसको बत्ती निभाइन्छ;","poem":1},{"text":"त्यसको आगोको ज्वाला बल्न छोड्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"त्यसको पालमा भएको उज्यालो अँध्यारो हुन्छ;","poem":1},{"text":"त्यसको छेउमा भएको बत्ती निभेर जान्छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्यसको बलियो पाइला कमजोर हुन्छ;","poem":1},{"text":"त्यसका आफ्नै युक्तिहरूले त्यसलाई लडाइदिन्छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"त्यसका खुट्टाले त्यसलाई पासोमा पार्छ;","poem":1},{"text":"त्यो त्यसको फन्दामा भौँतारिन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"धरापले त्यसको कुर्कुच्‍चामा पक्रन्छ;","poem":1},{"text":"पासोले त्यसलाई जोडसित समातेर राख्छ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"त्यसका निम्ति एउटा पासो जमिनमा लुकाइएको छ;","poem":1},{"text":"त्यसका बाटोमा एउटा धराप थापिएको छ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यसलाई त्रासले चारैतिरबाट तर्साउँछ,","poem":1},{"text":"र त्यसको हरेक पाइलालाई खेद्‌दछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"विपत्ति त्यसको निम्ति भोकाएको छ;","poem":1},{"text":"जब त्यो लड्छ, तब प्रकोपले त्यसलाई पर्खिरहेको हुन्छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"रोगले त्यसका छालाका भागहरू खाइदिन्छ;","poem":1},{"text":"मृत्युको पहिलो सन्तानले त्यसका अङ्गहरू निल्दछ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"त्यसको पालको सुरक्षाबाट त्यसलाई टाढा लैजान्छ;","poem":1},{"text":"र आतङ्कहरूको राजाकहाँ लगिन्छ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"त्यसको पालमा आगोले बास गर्छ,","poem":1},{"noteId":11},{"text":"त्यसका वासस्थानमा बल्दैगरेको गन्धक छरिएको छ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तल फेदमा त्यसका जराहरू सुकेर जान्छन्,","poem":1},{"text":"र माथि त्यसका हाँगाहरू बोटमै ओइलिएर जान्छन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"त्यसको सम्झना पृथ्वीबाटै मेटिएर जानेछ;","poem":1},{"text":"देशमा त्यसको नामनिशानै रहनेछैन।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"त्यसलाई उज्यालोबाट अन्धकारमा धपाइनेछ","poem":1},{"text":"र त्यसलाई संसारबाटै निकालिनेछ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"त्यसका मानिसहरूको बीचमा त्यसका कुनै सन्तानहरू अथवा वंशहरू छैनन्;","poem":1},{"text":"एक समय जहाँ त्यो बसेको थियो, त्यहाँ बाँचेकाहरू कोही पनि छैनन्।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"त्यसको दशामा पश्‍चिमका मानिसहरू चकित हुनेछन्;","poem":1},{"text":"र पूर्वका मानिसहरू त्रसित हुनेछन्।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"साँच्‍चै दुष्‍ट मानिसको घरको दशा यस्तै हुनेछ;","poem":1},{"text":"परमेश्‍वरलाई नचिन्‍नेहरूको घरको दशा पनि यस्तै हुनेछ।”","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"अथवा त्यससँग केही पनि बाँकी रहनेछैन।","reference":{"chapter":18,"verse":15}}]},"thisChapterLink":"/api/npi_ncb/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}