{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JOB","translationId":"npi_ncb","name":"इयोब","commonName":"इयोब","title":"इयोबको पुस्तक","order":18,"numberOfChapters":42,"sha256":"3de0a293e7ef031b2c818dfde84603dd4b2226cd508617e3cb5be007607d7a61","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/npi_ncb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["बिल्ददको संवाद"]},{"type":"verse","number":1,"content":["तब बिल्दद शुहीले जवाफ दिए:"]},{"type":"verse","number":2,"content":[{"text":"“प्रभुत्व र श्रद्धा परमेश्‍वरकै हुन्;","poem":1},{"text":"उहाँले आकाशको उचाइमा शान्ति स्थापना गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"के उहाँका सेनाहरूलाई गन्‍न सकिन्छ?","poem":1},{"text":"उहाँको ज्योति कसमाथि पर्दैन र?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यसो भए कसरी मरणशील मानिस परमेश्‍वरको अगि धर्मी हुन सक्छ?","poem":1},{"text":"स्त्रीबाट जन्मने कसरी शुद्ध हुन सक्छ र?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उहाँको दृष्‍टिमा त चन्द्रमा पनि चहकिलो छैन,","poem":1},{"text":"र ताराहरू पनि शुद्ध छैनन् भने,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मरणशील मानिस त झन् कति अशुद्ध होला, जो एउटा चुर्ना मात्र हो—","poem":1},{"text":"परमेश्‍वरको दृष्‍टिमा मानिस जाति किरा मात्रै हो!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}