{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JOB","translationId":"npi_ncb","name":"इयोब","commonName":"इयोब","title":"इयोबको पुस्तक","order":18,"numberOfChapters":42,"sha256":"3de0a293e7ef031b2c818dfde84603dd4b2226cd508617e3cb5be007607d7a61","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/npi_ncb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"“यस्ता कुराले गर्दा मेरो मुटुको ढुकढुकी ज्यादै बढ्छ,","poem":1},{"text":"अनि यो आफ्नो ठाउँबाट उफ्रन्छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"सुन्‍नुहोस्! उहाँको आवाजको गर्जनलाई सुन्‍नुहोस्,","poem":1},{"text":"उहाँको मुखबाट निस्केको गडगडाहट सुन्‍नुहोस्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उहाँले आफ्नो बिजुली सारा स्वर्गमुनि छोडिदिनुहुन्छ;","poem":1},{"text":"र यसलाई पृथ्वीको अन्तिमसम्म पठाइदिनुहुन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यसपछि उहाँको गर्जनको आवाज आउँछ;","poem":1},{"text":"उहाँ आफ्नो प्रतापी आवाजमा गर्जनुहुन्छ।","poem":2},{"text":"जब उहाँको आवाज गुञ्जन्छ,","poem":1},{"text":"तब उहाँले केही पनि रोकेर राख्नुहुन्‍न।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"परमेश्‍वरको आवाज अद्‌भुत किसिमले गर्जन्छ;","poem":1},{"text":"उहाँले हाम्रो समझभन्दा बाहिरका महान् कामहरू गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"उहाँले हिउँलाई भन्‍नुहुन्छ, ‘पृथ्वीमा झर्,’","poem":1},{"text":"भारी वर्षालाई भन्‍नुहुन्छ, ‘मुसलधारे झरी पर्।’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यसर्थ उहाँले सृष्‍टि गर्नुभएका हरेक मानिसहरूले उहाँका कामलाई जानून्,","poem":1},{"text":"उहाँले सबै मानिसहरूलाई तिनीहरूका परिश्रमबाट रोक्नुहुन्छ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"पशुहरू ओडारमा पस्छन्;","poem":1},{"text":"तिनीहरू आफ्ना गुफामा बस्छन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"प्रचण्ड आँधी आफ्नो स्थानबाट निस्कन्छ,","poem":1},{"text":"र तेज बतासबाट धेरै जाडो आउँछ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"परमेश्‍वरको सासले बरफ उत्पादन गर्छ,","poem":1},{"text":"र फराकिलो समुद्रको पानी जम्छ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"उहाँले बादललाई ओसको भारी बोकाउनुहुन्छ;","poem":1},{"text":"उहाँले आफ्नो बिजुली बादलद्वारा छर्नुहुन्छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"उहाँको आदेशमा","poem":1},{"text":"उहाँले खटाउनुभए अनुसार","poem":2},{"lineBreak":true},{"text":"तिनीहरू पृथ्वीको सतहभरि मडारिन्छन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"परमेश्‍वरले मानिसहरूलाई दण्ड दिन,","poem":1},{"text":"अथवा उहाँको पृथ्वीलाई भिजाउन र उहाँको प्रेम देखाउन बादललाई पठाउनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“इयोब, यो कुरा सुन्‍नुहोस्;","poem":1},{"text":"रोकिनुहोस्, र परमेश्‍वरका अद्‌भुत कार्यहरूमा विचार गर्नुहोस्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"परमेश्‍वरले बादललाई कसरी वशमा राख्नुहुन्छ,","poem":1},{"text":"अनि कसरी आफ्नो बिजुली चम्काउनुहुन्छ भनी के तपाईं जान्‍नुहुन्छ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"बादल कसरी शान्त भएर एक ठाउँमा अडिरहन्छ,","poem":1},{"text":"ज्ञानमा सिद्ध हुनुहुनेले कसरी ती अद्‌भुत कार्यहरू","poem":2},{"lineBreak":true},{"text":"गर्नुहुन्छ भन्‍ने कुरा के तपाईं जान्‍नुहुन्छ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"देश दक्षिणी बतासको प्रभावमा परेको बेला","poem":1},{"text":"तपाईं आफ्ना वस्त्रहरूभित्र न्यानो भएर रहनुहुन्छ,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"के तपाईं काँसोको ऐनाजस्तै कडा आकाशलाई,","poem":1},{"text":"फैलाउने काममा उहाँलाई साथ दिन सक्नुहुन्छ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“हामीले उहाँलाई के भन्‍नुपर्छ, भन्‍नुहोस्;","poem":1},{"text":"हामी अन्धकारमा रहेको कारण आफ्नो तर्क प्रस्तुत गर्न सक्दैनौँ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"के उहाँलाई म केही बोल्न चाहन्छु भनेर बताउनुपर्छ र?","poem":1},{"text":"के कुनै मानिसले आफू निलिएको चाहन्छ र?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तर अब बतासलाई बढारेर सफा पारेको","poem":1},{"text":"आकाशमा भएको चम्किलो सूर्यलाई","poem":2},{"lineBreak":true},{"text":"कसैले पनि हेर्न सक्दैन।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"उत्तरतिरबाट उहाँ सुनौलो भव्यतामा आउनुहुन्छ;","poem":1},{"text":"परमेश्‍वर अद्‌भुत महिमामा आउनुहुन्छ।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"सर्वशक्तिमान् हाम्रो पहुँचभन्दा बाहिर र शक्तिमा उच्‍च हुनुहुन्छ;","poem":1},{"text":"उहाँको न्याय र महान् धार्मिकतामा उहाँले मानिसहरूलाई थिचोमिचो गर्नुहुन्‍न।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"यसकारण मानिसहरूले उहाँलाई श्रद्धा गर्दछन्;","poem":1},{"text":"किनकि उहाँले हृदयमा बुद्धिमान् छु भनेर दाबी गर्नेहरू सबैलाई आदर गर्नुहुन्‍न।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}