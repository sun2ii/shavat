{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JOB","translationId":"npi_ncb","name":"इयोब","commonName":"इयोब","title":"इयोबको पुस्तक","order":18,"numberOfChapters":42,"sha256":"3de0a293e7ef031b2c818dfde84603dd4b2226cd508617e3cb5be007607d7a61","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/npi_ncb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“यदि तपाईं चाहनुहुन्छ भने एक चोटि पुकारेर हेर्नुहोस्, तर तपाईंलाई कसले जवाफ देला र?","poem":1},{"text":"तपाईं कुनचाहिँ पवित्र जनकहाँ फर्कनुहुन्छ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"रिसले मूर्खलाई मार्छ,","poem":1},{"text":"र डाहले सोझा मानिसलाई मार्छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"म आफैँले मूर्खले जरा गाडेको देखेको छु,","poem":1},{"text":"तर अचानक त्यसको घर श्रापित भयो।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यसका छोराछोरीहरू असुरक्षित छन्;","poem":1},{"text":"अदालतमा तिनीहरूलाई छुटाउनेवाला कोही नभएर पेलिएका छन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"त्यसको अन्‍नबारी भोकाएका मानिसहरूले खाइदिन्छन्,","poem":1},{"text":"काँडाहरूका बीचबाट पनि निकालेर लगिदिन्छन्;","poem":2},{"lineBreak":true},{"text":"र लोभीले त्यसको धन हडप्ने लालसा गर्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"किनकि कठिनाइ माटोबाट उम्रँदैन,","poem":1},{"text":"न त विपत्ति भुइँबाट पलाउँछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तरै पनि आगोको झिल्का माथि उडेझैँ","poem":1},{"text":"मानिस विपत्तिकै निम्ति जन्मन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“तर यदि म तपाईंको ठाउँमा भएको भए, परमेश्‍वरलाई बिन्ती चढाउनेथिएँ;","poem":1},{"text":"मेरो मामिला उहाँको सामु पेश गर्नेथिएँ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"परमेश्‍वरले हामीले बुझ्नै नसकिने अद्‌भुत कार्यहरू,","poem":1},{"text":"गन्‍नै नसकिने अचम्मका कामहरू गर्नुहुन्छ,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"उहाँले पृथ्वीको लागि वर्षा पठाउनुहुन्छ;","poem":1},{"text":"उहाँले खेतबारीमा पानी पठाउनुहुन्छ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"उहाँले नम्रहरूलाई उच्‍च पार्नुहुन्छ,","poem":1},{"text":"र विलाप गर्नेहरूलाई सुरक्षामा उठाउनुहुन्छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"उहाँले धूर्तहरूका युक्तिलाई विफल पार्नुहुन्छ,","poem":1},{"text":"ताकि तिनीहरूका हातले सफलता नपाऊन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"उहाँले बुद्धिमान्‌लाई त्यसकै धूर्ततामा पक्रनुहुन्छ;","poem":1},{"text":"र बठ्याइँ गर्नेहरूका योजनाहरूको चाँडै अन्त्य हुन्छ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तिनीहरूमाथि दिउँसै अन्धकार आइलाग्नेछ;","poem":1},{"text":"मध्यदिनमै तिनीहरू रातमा झैँ छामछाम-छुमछुम गरी हिँड्छन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"उहाँले खाँचोमा परेकाहरूलाई तिनीहरूका मुखमा भएको तरवारबाट बचाउनुहुन्छ;","poem":1},{"text":"उहाँले तिनीहरूलाई शक्तिशालीहरूका पञ्जाबाट बचाउनुहुन्छ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"त्यसकारण गरिबको निम्ति आशा छ;","poem":1},{"text":"र अन्यायले आफ्नो मुख बन्द गर्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“धन्यको हो त्यो मानिस, जसलाई परमेश्‍वरले सुधार गर्नुहुन्छ;","poem":1},{"text":"यसकारण सर्वशक्तिमान् परमेश्‍वरको अनुशासनलाई तिरस्कार नगर्नुहोस्।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"किनकि उहाँले घाउ पार्नुहुन्छ, तर उहाँले नै मलमपट्टी बाँध्नु पनि हुन्छ;","poem":1},{"text":"उहाँले चोट पार्नुहुन्छ, तर उहाँको हातले निको पनि पार्नुहुन्छ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"उहाँले तपाईंलाई छ वटा विपत्तिहरूबाट छुटाउनुहुनेछ;","poem":1},{"text":"सातौँ विपत्तिले समेत तपाईंलाई छुनेछैन।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"उहाँले तपाईंलाई अनिकालमा मृत्युबाट,","poem":1},{"text":"र युद्धमा तरवारको प्रहारबाट बचाउनुहुनेछ।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तपाईं जिब्रोको प्रहारबाट जोगाइनुहुनेछ,","poem":1},{"text":"र विनाश आउँदा पनि डराउनुपर्नेछैन।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तपाईं विनाश र अनिकालमा हास्‍नुहुनेछैन;","poem":1},{"text":"र जङ्गली जनावरहरूसँग पनि डराउनुपर्नेछैन।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"किनकि खेतका ढुङ्गाहरूसँग पनि तपाईंको करार बाँधिनेछ;","poem":1},{"text":"र जङ्गली जनावरहरू तपाईंसँग मेलमिलापमा रहनेछन्।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"तपाईंको पाल सुरक्षित छ भनी तपाईंले जान्‍नुहुनेछ;","poem":1},{"text":"तपाईंले आफ्नो सम्पत्तिको हिसाब लिनुहुनेछैन,","poem":2},{"lineBreak":true},{"text":"र त्यस सम्पत्तिबाट केही पनि चीज हराएको भेट्टाउनुहुनेछैन।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तपाईंका छोराछोरी धेरै हुनेछन्,","poem":1},{"text":"र तपाईंका सन्तानहरू पृथ्वीका घाँसजस्तै हुनेछन् भनी तपाईंले थाहा पाउनुहुनेछ।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ठिक ऋतुमा बाली बटुलेझैँ,","poem":1},{"text":"तपाईं चिहानमा जाँदा पूरा बुढेसकालमा लगिनुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“हामीले यी कुरा जाँचेका छौँ, र यो सत्य हो।","poem":1},{"text":"यसैले यो कुरा सुन्‍नुहोस् र आफैँमा यो लागू गर्नुहोस्।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}