{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JOL","translationId":"npi_ncb","name":"योएल","commonName":"योएल","title":"योएलको भविष्यवाणी","order":29,"numberOfChapters":3,"sha256":"b0eb5332fbbc5e19d6b2f61ab952baadc352ee81e37a149c88b61bc235d0562d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/npi_ncb/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["पतूएलका छोरो योएलकहाँ आएको याहवेहको वचन।"]},{"type":"line_break"},{"type":"heading","content":["सलहको आक्रमण"]},{"type":"verse","number":2,"content":[{"text":"हे प्रधानहरू हो, यो कुरा सुन;","poem":1},{"text":"यस देशमा बस्‍ने सबैले सुन।","poem":2},{"text":"के तिमीहरूका समयमा","poem":1},{"text":"अथवा तिमीहरूका पितापुर्खाहरूका समयमा यस प्रकारको घटना कहिल्यै घटेको थियो?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिमीहरूका छोराछोरीहरूलाई यो कुरा भन,","poem":1},{"text":"र तिमीहरूका छोराछोरीले तिनीहरूका छोराछोरीहरूलाई बताऊन्;","poem":2},{"lineBreak":true},{"text":"अनि उनीहरूका छोराछोरीहरूले त्यसपछिका पुस्तालाई बताऊन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जे सलहको झुण्डले छोडेको थियो,","poem":1},{"text":"ती ठूला सलहहरूले खाइदिए;","poem":2},{"text":"जे ठूला सलहहरूले छोडेका थिए,","poem":1},{"text":"ती साना सलहहरूले खाइदिए;","poem":2},{"text":"जे साना सलहहरूले छोडेका थिए,","poem":1},{"text":"ती अरू सलहहरूले","poem":2},{"noteId":0},{"text":"खाइदिए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"जाग, हे मतवालाहरू हो, र रोओ!","poem":1},{"text":"हे सबै मद्य पिउनेहरू हो, विलाप गर;","poem":2},{"text":"नयाँ मद्यको कारण विलौना गर;","poem":1},{"text":"किनकि यो तिमीहरूका ओठबाट खोसिएको छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"एउटा राष्ट्रले मेरो देशलाई आक्रमण गरेको छ,","poem":1},{"text":"जसका अनगन्ती शक्तिशाली सेना छन्;","poem":2},{"text":"तिनीहरूका दाँतहरू सिंहका जस्तै छन्;","poem":1},{"text":"तिनीहरूका तीखा दाह्राहरू सिंहिनीका झैँ छन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्यसले मेरा दाखका बोटहरू उजाड पारेको छ,","poem":1},{"text":"र मेरा नेभाराका रूखहरू नष्‍ट गरेको छ।","poem":2},{"text":"त्यसले हाँगाहरूलाई लाछेको छ,","poem":1},{"text":"र बोक्राहरू लाछेर फ्याँकिदिएको छ;","poem":2},{"lineBreak":true},{"text":"हाँगाहरूलाई सेतै पारिदिएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"आफ्नो युवाअवस्थामा मगनी गरेको पुरुषको निम्ति,","poem":1},{"text":"शोक गरिरहेकी कन्या केटीले झैँ भाङ्ग्रा लगाएर विलाप गर।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेहको भवनबाट","poem":1},{"text":"अन्‍नबलि र अर्घबलिहरू चढाउन बन्द भएका छन्।","poem":2},{"text":"याहवेहको सामु सेवा गर्ने","poem":1},{"text":"पुजारीहरू शोक गरिरहेका छन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"खेतहरू ध्वस्त पारिएका छन्,","poem":1},{"text":"र जमिन सुक्खा भएको छ;","poem":2},{"text":"अन्‍न नष्‍ट भएको छ,","poem":1},{"text":"नयाँ दाखमद्य सुकेको छ;","poem":2},{"lineBreak":true},{"text":"अनि जैतुनको तेल समाप्‍त भएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"हे किसानहरू हो, निराश होओ।","poem":1},{"text":"दाखबारीका किसानहरू, विलौना गर;","poem":2},{"text":"गहुँ र जौको निम्ति शोक गर;","poem":1},{"text":"किनकि खेतबारीको फसल नष्‍ट भएको छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"दाखको बोट सुकेको छ,","poem":1},{"text":"र नेभाराको रूख ओइलाएको छ;","poem":2},{"text":"अनार, खजूर र स्याउका रूखहरू,","poem":1},{"text":"खेतबारीका सबै रूखहरू सुकेका छन्।","poem":2},{"text":"निश्‍चय नै मानिसको","poem":1},{"text":"आनन्दको अन्त्य भएको छ।","poem":2}]},{"type":"heading","content":["पश्‍चात्तापको निम्ति आह्वान"]},{"type":"verse","number":13,"content":[{"text":"हे पुजारीहरू हो, भाङ्ग्रा लगाओ र शोक गर;","poem":1},{"text":"हे वेदीका सेवकहरू हो, विलौना गर।","poem":2},{"text":"तिमीहरू जसले मेरा परमेश्‍वरको अगि सेवा गर्छौ,","poem":1},{"text":"आओ, भाङ्ग्रा लगाएर रात कटाओ;","poem":2},{"text":"किनकि याहवेहको भवनबाट","poem":1},{"text":"अन्‍नबलि र अर्घबलिहरू चढाउन बन्द भएका छन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"पवित्र उपवासको घोषणा गर;","poem":1},{"text":"पवित्र सभाको घोषणा गर।","poem":2},{"text":"अगुवाहरूलाई बोलाओ","poem":1},{"text":"र यस देशमा बस्‍नेहरू सबैलाई","poem":2},{"text":"तिमीहरूका परमेश्‍वर याहवेहको भवनमा ल्याओ,","poem":1},{"text":"र याहवेहलाई पुकार।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"हाय! त्यो दिन,","poem":1},{"text":"किनकि याहवेहको दिन नजिक छ;","poem":2},{"lineBreak":true},{"text":"त्यो दिन सर्वशक्तिमान् परमेश्‍वरबाट विनाशझैँ आउनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"के हाम्रा आँखाकै सामु","poem":1},{"text":"खानाहरू नष्‍ट गरिएको छैन र?","poem":2},{"text":"आनन्द र हर्ष","poem":1},{"text":"परमेश्‍वरको भवनमा बन्द गरिएको छैन र?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"माटोका डल्‍लामुनि नै","poem":1},{"text":"बिउहरू चाउरिएका छन्।","poem":2},{"text":"भण्डारहरू उजाड भएका छन्,","poem":1},{"text":"र अन्‍नका ढुकुटीहरू तोडिएका छन्;","poem":2},{"lineBreak":true},{"text":"किनकि अन्‍न सुकेको छ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"कष्‍टले पशुप्राणीहरू कराउँदैछन्!","poem":1},{"text":"गाईबस्तुका बथानहरू विचलित भएका छन्;","poem":2},{"text":"किनकि तिनीहरूका निम्ति चर्ने खर्क छैन;","poem":1},{"text":"भेडाहरूका बगालले समेत कष्‍ट भोगिरहेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"हे याहवेह, म तपाईंलाई पुकार्छु;","poem":1},{"text":"किनकि आगोले उजाडस्थानका खर्कहरू भस्म पारेको छ,","poem":2},{"lineBreak":true},{"text":"र आगोको ज्वालाले खेतका सबै रूखहरूलाई भस्म पारेको छ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"जङ्गली जनावरहरू समेतले तपाईंलाई गुहार्छन्;","poem":1},{"text":"किनकि पानीका खोलाहरू सुकेका छन्,","poem":2},{"lineBreak":true},{"text":"र आगोले उजाडस्थानका खर्कहरूलाई भस्म पारेको छ।","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"यहाँ सलहका निम्ति प्रयोग गरिएका चार हिब्रू शब्दहरूको सही अर्थ के हो भन्‍ने निश्‍चित छैन।","reference":{"chapter":1,"verse":4}}]},"thisChapterLink":"/api/npi_ncb/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}