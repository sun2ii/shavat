{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JOL","translationId":"npi_ncb","name":"योएल","commonName":"योएल","title":"योएलको भविष्यवाणी","order":29,"numberOfChapters":3,"sha256":"b0eb5332fbbc5e19d6b2f61ab952baadc352ee81e37a149c88b61bc235d0562d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/npi_ncb/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["सलहहरूको एक सेना"]},{"type":"verse","number":1,"content":[{"text":"सियोनमा तुरही फुक;","poem":1},{"text":"मेरो पवित्र पर्वतमा खतराको घण्टी बजाओ।","poem":2},{"lineBreak":true},{"text":"यहूदामा रहने सबै मानिसहरू थरथर कामून्,","poem":1},{"text":"किनकि याहवेहको दिन आउँदैछ।","poem":2},{"text":"त्यो दिन अति नजिकै छ—","poem":1}]},{"type":"verse","number":2,"content":[{"text":"अन्धकारमय र उदासी दिन,","poem":2},{"lineBreak":true},{"text":"कालो बादल र अँध्यारोले ढाकेको दिन।","poem":2},{"text":"झिसमिसे बिहानी पर्वतहरूतिर फैलिँदै गएजस्तो","poem":1},{"text":"एउटा शक्तिशाली र विशाल सेना आउँछ;","poem":2},{"text":"यस्तो त पहिले कहिल्यै भएको थिएन,","poem":1},{"text":"न त आउने युगहरूमा नै यस्तो हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"तिनीहरूका अगि आगोले भस्म पार्छ;","poem":1},{"text":"तिनीहरूका पछि आगोको ज्वाला दन्कन्छ।","poem":2},{"text":"तिनीहरूका अगि भूमि अदनको बगैँचाजस्तै छ;","poem":1},{"text":"तिनीहरूका पछि एउटा उजाड मरुभूमिजस्तै छ,","poem":2},{"lineBreak":true},{"text":"अर्थात् तिनीहरूबाट कोही उम्कन सक्नेछैनन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरू घोडाहरूजस्ता देखिन्छन्;","poem":1},{"text":"तिनीहरू युद्धका घोडसवारहरूझैँ दगुर्छन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"रथहरूका आवाजसँगै","poem":1},{"text":"पराल भस्म गर्नलाई दन्केको आगोजस्तै,","poem":2},{"text":"युद्धको निम्ति तयार शक्तिशाली सेनाहरूजस्तै,","poem":1},{"text":"तिनीहरू पहाडका टाकुराहरूमाथि उफ्रन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"यिनीहरूलाई देखेर राष्ट्रहरू डरले थरथर काप्छन्;","poem":1},{"text":"प्रत्येक अनुहार पहेँलो हुन्छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरू योद्धाले जस्तै जाइलाग्छन्;","poem":1},{"text":"तिनीहरू सिपाहीहरूले जस्तै पर्खाल चढ्छन्।","poem":2},{"text":"तिनीहरू सबै मोर्चा बाँधेर पङ्‌क्तिमा अगाडि बढ्छन्;","poem":1},{"text":"तिनीहरू आफ्नो पङ्‌क्तिबाट हट्दैनन्,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरू हिँड्दा एक-अर्कासँग नठोकी,","poem":1},{"text":"सीधा अगाडि बढ्छन्।","poem":2},{"text":"तिनीहरू आफ्नो पङ्‌क्ति नबिगारी","poem":1},{"text":"प्रतिरक्षाको निम्ति शत्रुहरूमाथि जाइलाग्छन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरू सहरभित्र जाइलाग्छन्;","poem":1},{"text":"तिनीहरू पर्खालमाथि दौडन्छन्।","poem":2},{"text":"तिनीहरू घरहरूमाथि चढ्छन्;","poem":1},{"text":"तिनीहरू चोरहरूजस्तै गरी झ्यालहरूबाट भित्र पस्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"तिनीहरूका सामु पृथ्वी थर्किन्छ;","poem":1},{"text":"आकाश थरथर काम्छ,","poem":2},{"text":"सूर्य र चन्द्रमा अँध्यारा हुन्छन्;","poem":1},{"text":"अनि ताराहरू पनि चम्कँदैनन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेह आफ्नो सेनाको","poem":1},{"text":"सामु चर्को सोरमा गर्जनुहुन्छ;","poem":2},{"text":"उहाँका सेनाहरू अनगन्ती छन्,","poem":1},{"text":"र उहाँका आज्ञापालन गर्ने सेनाहरू शक्तिशाली छन्।","poem":2},{"text":"याहवेहको दिन महान् छ;","poem":1},{"text":"यो अति डरलाग्दो छ।","poem":2},{"lineBreak":true},{"text":"त्यो दिन कसले सहन सक्छ र?","poem":2}]},{"type":"heading","content":["पश्‍चात्तापको निम्ति बोलावट"]},{"type":"verse","number":12,"content":[{"text":"“अहिले पनि,” याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"text":"“तिमीहरूको सारा हृदयले,","poem":2},{"lineBreak":true},{"text":"उपवास बसेर रुँदै र विलाप गर्दै मतिर फर्क।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"तिमीहरूको कपडा होइन,","poem":1},{"text":"तर आफ्नो हृदय फटाओ।","poem":2},{"text":"अनि याहवेह तिमीहरूका परमेश्‍वरतिर फर्क;","poem":1},{"text":"किनकि उहाँ अनुग्रही र कृपालु हुनुहुन्छ,","poem":2},{"text":"रिसाउनमा ढिला र प्रेममा भरिपूर्ण हुनुहुन्छ;","poem":1},{"text":"अनि विपत्ति ल्याउने कुरामा पुनर्विचार गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"कसले जान्दछ र? उहाँ फर्केर पुनर्विचार गर्नुहोला;","poem":1},{"text":"र प्रशस्त आशिष् दिनुहोला,","poem":2},{"text":"अनि तिमीहरूले आफ्ना परमेश्‍वर याहवेहको निम्ति","poem":1},{"text":"फेरि अन्‍नबलि र अर्घबलिहरू चढाउन सकौला।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"सियोन पर्वतमा तुरही फुक,","poem":1},{"text":"र पवित्र उपवासको घोषणा गर;","poem":2},{"lineBreak":true},{"text":"पवित्र महासभा बोलाओ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"मानिसहरू भेला गर,","poem":1},{"text":"महासभालाई शुद्ध गर;","poem":2},{"text":"बुढापाकाहरूलाई एकसाथ जम्मा गर,","poem":1},{"text":"र केटाकेटीहरूलाई भेला गर;","poem":2},{"lineBreak":true},{"text":"अनि दुधे बालकहरूलाई पनि जम्मा गर।","poem":2},{"text":"दुलहाले आफ्नो कोठा छोडोस्","poem":1},{"text":"र दुलहीले पनि आफ्नो भित्री कोठा छोडोस्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"याहवेहको सामु सेवा गर्ने पुजारीहरू,","poem":1},{"text":"मन्दिरको दलान र वेदीको बीचमा बसेर विलाप गरून्।","poem":2},{"text":"तिनीहरूले भनून्, “हे याहवेह, तपाईंका मानिसहरूलाई बचाउनुहोस्।","poem":1},{"text":"तपाईंको आफ्नो उत्तराधिकारलाई गिल्‍लाको पात्र बन्‍न नदिनुहोस्,","poem":2},{"lineBreak":true},{"text":"राष्ट्रहरूका बीचमा उपहासको उखान नबनोस्।","poem":2},{"text":"मानिसहरूले किन यसो भन्‍ने मौका पाउन्,","poem":1},{"text":"‘तिनीहरूका परमेश्‍वर कहाँ छन्?’ ”","poem":2}]},{"type":"heading","content":["याहवेहको जवाफ"]},{"type":"verse","number":18,"content":[{"text":"त्यसपछि याहवेह आफ्नो देशको निम्ति डाही हुनुभयो,","poem":1},{"text":"र उहाँले आफ्ना मानिसहरूलाई कृपा गर्नुभयो।","poem":2}]},{"type":"verse","number":19,"content":["याहवेहले तिनीहरूलाई जवाफ दिनुभयो:",{"text":"“म तिमीहरूका निम्ति अन्‍न, नयाँ दाखमद्य र जैतुन तेल पठाउँदैछु,","poem":1},{"text":"तिमीहरू प्रशस्तताले पूर्ण भएर तृप्‍त हुनेछौ;","poem":2},{"text":"म तिमीहरूलाई अरू राष्ट्रहरूका सामु","poem":1},{"text":"फेरि कहिल्यै पनि गिल्‍लाको पात्र हुन दिनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“म उत्तरको सेनालाई तिमीहरूदेखि टाढा लखेट्नेछु,","poem":1},{"text":"त्यसलाई रुखो, उजाड र बाँझो देशमा धपाउनेछु,","poem":2},{"text":"यसको पूर्वीय सेनालाई पूर्वको मृत सागरमा","poem":1},{"text":"र पश्‍चिमी सेनालाई पश्‍चिमको महासागरमा डुबाइदिनेछु।","poem":2},{"text":"अनि त्यसको गन्धमाथि उठ्नेछ;","poem":1},{"text":"त्यसको दुर्गन्ध सबैतिर फैलिनेछ।”","poem":2},{"lineBreak":true},{"text":"निश्‍चय नै याहवेहले महान् कामहरू गर्नुभएको छ!","poem":1}]},{"type":"verse","number":21,"content":[{"text":"हे यहूदाको देश, भयभीत नहो;","poem":2},{"lineBreak":true},{"text":"हर्षित र आनन्दित हो।","poem":2},{"text":"निश्‍चय नै याहवेहले महान् कामहरू गर्नुभएको छ!","poem":1}]},{"type":"verse","number":22,"content":[{"text":"हे जङ्गली जनावरहरू हो, नडराओ;","poem":2},{"lineBreak":true},{"text":"किनकि उजाडस्थानका खुला चर्ने खर्कहरू हरिया हुँदैछन्।","poem":2},{"text":"रूखहरूमा फलहरू फल्दैछन्;","poem":1},{"text":"नेभाराको रूख र दाखका बोटहरूले प्रशस्तसँग फल फलाउनेछन्।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"हे सियोनका मानिसहरू हो, हर्षित होओ,","poem":1},{"text":"तिमीहरूका परमेश्‍वर याहवेहमा रमाओ;","poem":2},{"text":"किनकि उहाँले तिमीहरूका निम्ति शरदको झरी दिनुभएको छ;","poem":1},{"text":"किनभने उहाँ विश्‍वासयोग्य परमेश्‍वर हुनुहुन्छ।","poem":2},{"text":"उहाँले तिमीहरूलाई प्रशस्त झरी पठाउनुहुन्छ,","poem":1},{"text":"शरद र वसन्त दुवै ऋतुहरूमा पहिलेझैँ झरी पठाउनुहुन्छ।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"तिमीहरूका खलाहरू अन्‍नले भरिनेछन्;","poem":1},{"text":"कोलहरू नयाँ दाखमद्य र तेलले भरिएर पोखिनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“म तिमीहरूलाई सलहले खाइदिएका वर्षहरूको क्षतिपूर्ति दिनेछु—","poem":1},{"text":"जुन ठूला सलहहरू र जवान सलहहरूले,","poem":2},{"lineBreak":true},{"text":"अथवा अरू सलहहरूका हुलहरूले,","poem":2},{"text":"अर्थात् मैले तिमीहरूका बीचमा पठाएको ठूला सेनाहरूले खाएका थिए।","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"तिमीहरू अघाउन्जेल खानलाई तिमीहरूसँग प्रशस्त भोजन हुनेछ;","poem":1},{"text":"अनि तिमीहरूले याहवेह आफ्ना परमेश्‍वरको नामको प्रशंसा गर्नेछौ,","poem":2},{"lineBreak":true},{"text":"जसले तिमीहरूका निम्ति अद्‌भुत कार्यहरू गर्नुभएको छ;","poem":2},{"text":"अब फेरि मेरा मानिसहरू कहिल्यै पनि शर्ममा पर्नेछैनन्।","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"त्यसपछि तिमीहरूले जान्‍नेछौ, कि म इस्राएलमा छु,","poem":1},{"text":"म याहवेह नै तिमीहरूका परमेश्‍वर हुँ;","poem":2},{"lineBreak":true},{"text":"अनि मबाहेक कोही पनि परमेश्‍वर छैन;","poem":2},{"text":"मेरा मानिसहरू फेरि कहिल्यै पनि शर्ममा पर्नेछैनन्।","poem":1}]},{"type":"heading","content":["याहवेहको दिन"]},{"type":"verse","number":28,"content":[{"text":"“अनि यसपछि,","poem":1},{"text":"म मेरो आत्मा सबै मानिसहरूमाथि खन्याउनेछु।","poem":2},{"text":"तिमीहरूका छोरा र छोरीहरूले अगमवाणी गर्नेछन्;","poem":1},{"text":"तिमीहरूका बुढापाकाहरूले सपना देख्नेछन्;","poem":2},{"lineBreak":true},{"text":"तिमीहरूका जवानहरूले दर्शनहरू देख्नेछन्।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ती दिनहरूमा म मेरो आत्मा मेरा सेवकहरू,","poem":1},{"text":"स्त्री र पुरुषहरू दुवैमाथि खन्याउनेछु।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"म आकाशमा र पृथ्वीमा","poem":1},{"text":"अद्‌भुत कार्यहरू देखाउनेछु;","poem":2},{"lineBreak":true},{"text":"रगत, आगो र धुवाँका मुस्लाहरू।","poem":2}]},{"type":"verse","number":31,"content":[{"text":"याहवेहको महान् र डरलाग्दो दिन आउनअगि","poem":1},{"text":"सूर्य अन्धकारमा परिवर्तन हुनेछ,","poem":2},{"lineBreak":true},{"text":"र चन्द्रमा रगतजस्तै रातो हुनेछ।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"अनि याहवेहको नाम पुकार्ने","poem":1},{"text":"हरेक मानिसले उद्धार पाउनेछ;","poem":2},{"text":"किनकि सियोन पर्वतमा","poem":1},{"text":"र यरूशलेममा छुटकारा हुनेछ,","poem":2},{"lineBreak":true},{"text":"जसरी याहवेहले भन्‍नुभएको छ,","poem":2},{"text":"बाँचेकाहरूका बीचमा ती व्यक्तिहरू हुनेछन्;","poem":1},{"text":"जसलाई याहवेहले बोलाउनुहुन्छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}