{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JOL","translationId":"npi_ncb","name":"योएल","commonName":"योएल","title":"योएलको भविष्यवाणी","order":29,"numberOfChapters":3,"sha256":"b0eb5332fbbc5e19d6b2f61ab952baadc352ee81e37a149c88b61bc235d0562d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/npi_ncb/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["राष्ट्रहरूको न्याय"]},{"type":"verse","number":1,"content":[{"text":"“ती दिनहरूमा र त्यस समयमा,","poem":1},{"text":"जब म यहूदा र यरूशलेमका समृद्धिहरू फर्काउँछु,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तब म सबै राष्ट्रहरूलाई एकसाथ भेला गर्नेछु,","poem":1},{"text":"र तिनीहरूलाई यहोशापातको","poem":2},{"noteId":1},{"text":"बेँसीमा तल ल्याउनेछु।","poem":2},{"text":"त्यहाँ म तिनीहरूलाई परीक्षा गर्नेछु;","poem":1},{"text":"किनकि तिनीहरूले मेरो उत्तराधिकार र मेरो जाति इस्राएललाई जेजस्तो गरे,","poem":2},{"text":"तिनीहरूले मेरो जातिलाई राष्ट्रहरूका बीचमा तितरबितर पारे;","poem":1},{"text":"अनि तिनीहरूले मेरो देशलाई विभाजन गरे।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरूले मेरा मानिसहरूमाथि चिट्ठा हाले,","poem":1},{"text":"वेश्यावृत्तिको निम्ति केटाहरूको व्यापार गरे;","poem":2},{"lineBreak":true},{"text":"तिनीहरूले दाखमद्यको निम्ति केटीहरूलाई बेचे।","poem":2}]},{"type":"verse","number":4,"content":["“अब हे टायर र सीदोन, र पलिश्तीका सारा मानिसहरू हो, मेरो विरुद्धमा तिमीहरूको के छ? के तिमीहरूले मैले जे गरेको छु, त्यसको बदला लिँदैछौ? यदि तिमीहरूले बदला लिइरहेका छौ भने तिमीहरूले जे गरेका छौ, त्यो तिमीहरूकै टाउकोमा म चाँडै नै खन्याइदिनेछु।"]},{"type":"verse","number":5,"content":["किनकि तिमीहरूले मेरो चाँदी र मेरो सुन, साथै मेरा बहुमूल्य सम्पत्तिहरू तिमीहरूका दरबारहरूमा लगेका छौ।"]},{"type":"verse","number":6,"content":["तिमीहरूले यहूदा र यरूशलेमका मानिसहरूलाई आफ्ना मातृभूमिदेखि टाढा पठाउन ग्रीकहरूका हातमा बेचेका छौ।"]},{"type":"verse","number":7,"content":["“हेर, तिमीहरूले तिनीहरूलाई बेचेको ठाउँदेखि, म तिनीहरूलाई फिर्ता ल्याउनेछु; अनि तिमीहरूले जे गरेका छौ, त्यो म तिमीहरूका टाउकोमा खन्याइदिनेछु।"]},{"type":"verse","number":8,"content":["म तिमीहरूका छोरा र छोरीहरूलाई यहूदाका मानिसहरूका हातमा बेचिदिनेछु; अनि तिनीहरूले यिनीहरूलाई एउटा टाढाको राष्ट्र शबीहरूको हातमा बेचिदिनेछन्।” याहवेहले बोल्नुभएको छ।"]},{"type":"verse","number":9,"content":[{"text":"राष्ट्रहरूका बीचमा यो घोषणा गर:","poem":1},{"text":"युद्धको निम्ति तयारी गर!","poem":2},{"text":"शूरवीरहरूलाई आह्वान गर!","poem":1},{"text":"सारा लडाकु योद्धाहरू नजिक आऊन् र आक्रमण गरून्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिमीहरूका हलोका फालीहरूलाई पिटेर तरवार","poem":1},{"text":"र हँसियाहरूलाई भाला बनाओ।","poem":2},{"text":"कमजोर मानिसहरूले भनून्,","poem":1},{"text":"“म बलियो छु!”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"चाँडो गरी आओ, हे चारैतिरका सारा राष्ट्रहरू हो;","poem":1},{"text":"अनि त्यहाँ एकसाथ भेला होओ।","poem":2},{"lineBreak":true},{"text":"हे याहवेह! तपाईंका महान् योद्धाहरू तल ल्याउनुहोस्!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“राष्ट्रहरू तयार होऊन्;","poem":1},{"text":"तिनीहरू यहोशापातको बेँसीतिर अगि बढून्;","poem":2},{"text":"किनकि चारैतिरबाट आएका सारा राष्ट्रहरूलाई","poem":1},{"text":"न्याय गर्न म त्यहाँ न्यायआसनमा बस्‍नेछु।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"हँसिया लगाओ,","poem":1},{"text":"किनकि फसल पाकेको छ।","poem":2},{"text":"आओ, दाखहरूलाई कुल्च;","poem":1},{"text":"किनकि दाखले कोल भरिएको छ,","poem":2},{"lineBreak":true},{"text":"र घैलाहरू भरिएर पोखिन्छन्;","poem":2},{"text":"किनकि तिनीहरूको दुष्‍टता ठूलो छ!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"फैसला गरिने बेँसीमा","poem":1},{"text":"भीडका भीड मानिसहरू छन्!","poem":2},{"text":"किनकि फैसलाको बेँसीमा","poem":1},{"text":"याहवेहको दिन नजिक छ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"सूर्य र चन्द्रमा अँध्यारो हुनेछन्,","poem":1},{"text":"र ताराहरू अब उसो चम्कने छैनन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"सियोनको पर्वतदेखि याहवेह गर्जनुहुनेछ,","poem":1},{"text":"र उहाँ यरूशलेमको सहरबाट पनि गर्जनुहुन्छ;","poem":2},{"lineBreak":true},{"text":"पृथ्वी र आकाश थरथर काम्नेछन्।","poem":2},{"text":"तर याहवेह आफ्ना मानिसहरूका निम्ति शरणस्थान","poem":1},{"text":"र इस्राएलका मानिसहरूका निम्ति एउटा बलियो किल्‍ला हुनुहुनेछ।","poem":2}]},{"type":"heading","content":["परमेश्‍वरका जनहरूका निम्ति आशिष्"]},{"type":"verse","number":17,"content":[{"text":"“त्यसपछि तिमीहरूले जान्‍नेछौ, म याहवेह नै तिमीहरूका परमेश्‍वर हुँ;","poem":1},{"text":"मेरो पवित्र पर्वत, सियोनमा म वास गर्छु।","poem":2},{"text":"यरूशलेम पवित्र हुनेछ;","poem":1},{"text":"विदेशीहरूले फेरि कहिल्यै त्यसलाई आक्रमण गर्नेछैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ती दिनमा पर्वतहरूले नयाँ दाखमद्य चुहाउनेछन्;","poem":1},{"text":"अनि डाँडाहरूमा दूध बहनेछ;","poem":2},{"lineBreak":true},{"text":"यहूदाका सबै खोल्साहरूमा पानी बहनेछ।","poem":2},{"text":"अनि याहवेहको भवनदेखि पानीको फोहोरा बगेर निस्कनेछ,","poem":1},{"text":"र अखैयाको बेँसीलाई","poem":2},{"noteId":2},{"text":"भिजाउनेछ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तर इजिप्ट उजाड हुनेछ,","poem":1},{"text":"र एदोम उजाड मरुभूमि हुनेछ;","poem":2},{"text":"किनकि तिनीहरूले यहूदाका मानिसहरूलाई अत्याचार गरेका थिए,","poem":1},{"text":"जसको देशमा तिनीहरूले निर्दोष रगत बगाएका थिए।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"यहूदामा मानिसहरू सदासर्वदा बसोबास गर्नेछन्;","poem":1},{"text":"अनि यरूशलेममा पुस्तौँ-पुस्तासम्म मानिसहरूको बसोबास हुनेछ।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"के म निर्दोषहरूका रगतको बदला नलिई छोडौँ?","poem":1},{"text":"अहँ, म छोड्नेछैनँ।”","poem":2},{"lineBreak":true},"किनकि याहवेह सियोन पर्वतमा बास गर्नुहुन्छ!"]}],"footnotes":[{"noteId":1,"caller":"+","text":"जसको अर्थ याहवेहले न्याय गर्नुहुन्छ।","reference":{"chapter":3,"verse":2}},{"noteId":2,"caller":"+","text":"अथवा शित्तीम बेँसीलाई","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/npi_ncb/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}