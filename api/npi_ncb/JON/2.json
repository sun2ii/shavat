{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JON","translationId":"npi_ncb","name":"योना","commonName":"योना","title":"योनाको भविष्यवाणी","order":32,"numberOfChapters":4,"sha256":"28efd9227105f5f30a12b8c20525f7ee2059bf33fb994d4b0df21349ca30bbb1","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/npi_ncb/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["योनाले माछाको पेटभित्रबाट याहवेह आफ्ना परमेश्‍वरलाई प्रार्थना गरे।"]},{"type":"verse","number":2,"content":["तिनले यसरी याहवेहसँग प्रार्थना गरेर भने:",{"text":"“मेरो सङ्कष्‍टको समयमा मैले याहवेहलाई पुकारेँ,","poem":1},{"text":"र उहाँले मलाई जवाफ दिनुभयो।","poem":2},{"text":"मृतकहरूको गहिरो पातालबाट मैले सहायताको निम्ति पुकारेँ;","poem":1},{"text":"अनि तपाईंले मेरो क्रन्दन सुन्‍नुभयो।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तपाईंले मलाई समुद्रको गहिराइमा फालिदिनुभयो,","poem":1},{"text":"समुद्रको मुटुभित्र म डुबेँ;","poem":2},{"lineBreak":true},{"text":"अनि पानीका छालहरूले मलाई घेरे;","poem":2},{"text":"अनि तपाईंका पानीका छालहरू र लहरहरू","poem":1},{"text":"ममाथि उर्लेर आए।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मैले भनेँ, ‘म तपाईंको","poem":1},{"text":"दृष्‍टिबाट निकालिएको छु;","poem":2},{"text":"तापनि म फेरि पनि तपाईंको","poem":1},{"text":"पवित्र मन्दिरतिर हेर्नेछु।’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"डुबाउने पानीले मलाई भयभीत तुल्याए,","poem":1},{"text":"र समुद्रको गहिराइले मलाई चारैतिर घेरेका थिए;","poem":2},{"lineBreak":true},{"text":"समुद्रका झारहरू मेरो टाउकोमा बेह्रिएका थिए।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"म डुबेर तल पर्वतहरूका फेदसम्मै पुगेँ;","poem":1},{"text":"पृथ्वीले मलाई सदाको निम्ति थुनिदियो।","poem":2},{"text":"तर पनि तपाईंले, हे याहवेह मेरा परमेश्‍वर,","poem":1},{"text":"मेरो प्राणलाई खाल्डोबाट निकालेर ल्याउनुभयो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“जब मेरो प्राण जानै लागेको थियो,","poem":1},{"text":"हे याहवेह, मैले तपाईंलाई सम्झेँ;","poem":2},{"text":"अनि मेरो प्रार्थना तपाईंकहाँ,","poem":1},{"text":"तपाईंको पवित्र मन्दिरसम्म पुग्यो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“जजसले व्यर्थका मूर्तिहरूमा भरोसा गर्छन्,","poem":1},{"text":"तिनीहरू परमेश्‍वरको अचुक प्रेमबाट टाढा हुन्छन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तर म धन्यवादको स्तुतिसहित","poem":1},{"text":"तपाईंलाई बलिदान चढाउनेछु।","poem":2},{"text":"मैले जे भाकल गरेको छु, त्यो म पूरा गर्नेछु।","poem":1},{"text":"म भन्‍नेछु, ‘उद्धार याहवेहबाट नै आउँछ।’ ”","poem":2}]},{"type":"verse","number":10,"content":["अनि याहवेहले माछालाई आज्ञा दिनुभयो र त्यसले योनालाई सुक्खा जमिनमा उकेलिदियो।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}