{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"LAM","translationId":"npi_ncb","name":"विलाप","commonName":"विलाप","title":"विलापको पुस्तक","order":25,"numberOfChapters":5,"sha256":"b8c5605f384922e14d782949eadcaa511e3fad2ac961e31a823a02f3719b99bd","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/npi_ncb/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"एक समय मानिसले भरिएको त्यो सहर,","poem":1},{"text":"अहिले कस्तो सुनसान भएको छ!","poem":2},{"text":"त्यो सहर एक समयमा राष्ट्रहरूको बीचमा महान् राजकुमारी थिई,","poem":1},{"text":"अहिले त्यो विधवाजस्ती भएकी छे!","poem":2},{"text":"प्रदेशहरूको बीचमा त्यो रानीजस्ती थिई,","poem":1},{"text":"अहिले दासत्वमा परेकी छे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"रातभरि त्यो धुरुधुरु रुन्छे;","poem":1},{"text":"त्यसका गालामा आँसु बगिरहन्छ।","poem":2},{"text":"त्यसका सबै प्रेमीहरूमध्ये","poem":1},{"text":"त्यसलाई सान्त्वना दिने कोही पनि छैन।","poem":2},{"text":"त्यसका सबै साथीहरूले त्यसलाई विश्‍वासघात गरेका छन्;","poem":1},{"text":"तिनीहरू सबै त्यसका शत्रु भएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"कष्‍ट र कठोर परिश्रमपछि","poem":1},{"text":"यहूदालाई निर्वासनमा लगिएको छ।","poem":2},{"text":"अब त्यो राष्ट्रहरूको बीचमा रहन्छे;","poem":1},{"text":"त्यसले आराम गर्ने ठाउँ पाउँदिन।","poem":2},{"text":"त्यसलाई खेद्नेहरू सबैले","poem":1},{"text":"त्यसलाई आपत् परेकै बेला पक्रेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"सियोनमा जाने बाटोहरूले शोक गर्छन्;","poem":1},{"text":"किनकि त्यसका तोकिएका चाडहरूमा कोही पनि आउँदैनन्।","poem":2},{"text":"त्यसका सबै मूलढोकाहरू उजाड भएका छन्;","poem":1},{"text":"त्यसका पुजारीहरू सुस्केरा हाल्छन्,","poem":2},{"text":"त्यसका जवान केटीहरू शोक गर्छन्;","poem":1},{"text":"अनि त्यो कठोर वेदनामा छे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"त्यसका शत्रुहरू त्यसका मालिक भएका छन्;","poem":1},{"text":"त्यसका शत्रुहरू विजयी भएका छन्;","poem":2},{"text":"त्यसका धेरै पापहरूको कारण","poem":1},{"text":"याहवेहले त्यसलाई दुःखमा पार्नुभएको छ।","poem":2},{"text":"त्यसका छोराछोरीहरू शत्रुहरूकै सामु","poem":1},{"text":"निर्वासनमा लगिएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"सियोनकी छोरीबाट","poem":1},{"text":"सबै गौरव हटिसकेको छ।","poem":2},{"text":"त्यसका राजकुमारहरू घाँसे खर्क नपाएका","poem":1},{"text":"कमजोर मृगहरूजस्तै भएका छन्;","poem":2},{"text":"तिनीहरू दुर्बल भएर","poem":1},{"text":"तिनीहरूलाई खेद्नेहरूको अगि-अगि भागेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"यरूशलेमले सङ्कष्‍ट र भौँतारिएको बेलामा","poem":1},{"text":"आफ्ना धनसम्पत्तिको सम्झना गर्दछे,","poem":2},{"lineBreak":true},{"text":"जुन धनसम्पत्ति त्यसका बितेका पुराना दिनहरूमा थिए।","poem":2},{"text":"जब त्यसका मानिसहरू शत्रुहरूका हातमा परे,","poem":1},{"text":"तब त्यसलाई मदत दिने कोही पनि थिएन।","poem":2},{"text":"त्यसका शत्रुहरूले त्यसलाई देखे,","poem":1},{"text":"र त्यसको विनाशमा ठट्टा गरे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"यरूशलेमले घोर अपराध गरेकी छे;","poem":1},{"text":"यसैकारण त्यो अशुद्ध भएकी छे।","poem":2},{"text":"त्यसलाई आदर गर्नेहरू सबैले त्यसलाई घृणा गर्छन्;","poem":1},{"text":"किनकि तिनीहरूले त्यसको नग्नता देखेका छन्;","poem":2},{"text":"त्यसले सुस्केरा मार्छे,","poem":1},{"text":"र लाजले आफ्नो मुख लुकाउँछे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"त्यसको अशुद्धपन त्यसको फरियामा टाँसिएको थियो;","poem":1},{"text":"त्यसले आफ्नो भविष्यको बारेमा सम्झिन।","poem":2},{"text":"त्यसको पतन भयङ्कर थियो;","poem":1},{"text":"त्यसलाई सान्त्वना दिने कोही पनि थिएन।","poem":2},{"text":"“हे याहवेह, मेरो सङ्कष्‍टमा मलाई सहायता गर्नुहोस्;","poem":1},{"text":"किनकि शत्रुहरू विजयी भएका छन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"त्यसका सबै धनसम्पत्तिहरू","poem":1},{"text":"शत्रुले हात पारेका छन्;","poem":2},{"text":"त्यसले यरूशलेमको पवित्रस्थानमा","poem":1},{"text":"गैरयहूदीहरू प्रवेश गरेको देखेकी छे,","poem":2},{"text":"जसलाई आफ्नो सभामा पस्‍न","poem":1},{"text":"तपाईंले निषेध गर्नुभएको थियो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"त्यसका सबै मानिसहरू सुस्केरा मार्दै","poem":1},{"text":"रोटीको खोजी गर्दछन्;","poem":2},{"text":"तिनीहरू जीवित रहनका निम्ति","poem":1},{"text":"आफ्ना धनसम्पत्तिहरू खानेकुरासँग साट्दछन्।","poem":2},{"text":"“हे याहवेह, हेर्नुहोस् र विचार गर्नुहोस्;","poem":1},{"text":"किनकि म त तुच्छ भएको छु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“यहाँबाट भएर जाने तिमीहरू सबै,","poem":1},{"text":"के तिमीहरूलाई यी कुराहरूको वास्ता छैन?","poem":2},{"text":"चारैतिर आँखा लगाएर हेर।","poem":1},{"text":"उहाँको भयङ्कर क्रोधको दिनमा","poem":2},{"text":"उहाँले मलाई दिनुभएको","poem":1},{"text":"मेरो कष्‍टजस्तो अर्को कुनै कष्‍ट छ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“उहाँले माथिबाट आगो पठाउनुभएको छ;","poem":1},{"text":"त्यो आगो मेरा हड्डीभित्र सल्किएको छ।","poem":2},{"text":"उहाँले मेरा पाउका निम्ति जाल फैलाउनुभएको छ,","poem":1},{"text":"र उहाँले मलाई फर्काउनुभएको छ।","poem":2},{"text":"उहाँले मलाई उजाड पार्नुभएको छ,","poem":1},{"text":"र अटुट पीडामा छोड्नुभएको छ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“मेरा अपराधहरू मेरै जुवामा बाँधिएका छन्;","poem":1},{"text":"उहाँकै हातद्वारा ती एकसाथ मेरो घाँटीमा बुनिएका छन्।","poem":2},{"text":"त्यसको भार मेरो घाँटीमा झुण्डाइदिनुभएको छ;","poem":1},{"text":"अनि प्रभुले मेरो शक्ति घटाइदिनुभएको छ।","poem":2},{"text":"उहाँले मलाई तिनीहरूका हातमा सुम्पिदिनुभएको छ,","poem":1},{"text":"जसको म सामना नै गर्न सक्दिनँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"प्रभुले मेरो बीचमा रहेका सबै वीर","poem":1},{"text":"योद्धाहरूलाई इन्कार गर्नुभएको छ;","poem":2},{"text":"मेरा जवानहरूलाई धुलोपिठो पार्नलाई","poem":1},{"text":"उहाँले मेरो विरुद्धमा सेना जम्मा गर्नुभएको छ।","poem":2},{"text":"उहाँले यहूदाका कुमारीहरूलाई आफ्नो","poem":1},{"text":"दाखको कोलमा पेल्नुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“यी सबै कारणले म रुन्छु,","poem":1},{"text":"र मेरा आँखाबाट आँसुका धारा बग्छन्।","poem":2},{"text":"मलाई सान्त्वना दिने कोही पनि नजिक छैन,","poem":1},{"text":"र मेरो आत्मा पुनर्जीवित गर्ने कोही पनि छैन।","poem":2},{"text":"मेरो शत्रु विजयी भएको कारण","poem":1},{"text":"मेरा छोराछोरीहरू बेसहारा भएका छन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"सियोनले आफ्नो हात फैलाउँछे,","poem":1},{"text":"तर त्यसलाई सान्त्वना दिने कोही पनि छैन।","poem":2},{"text":"याहवेहले याकोबको विरुद्धमा आज्ञा दिनुभएको छ;","poem":1},{"text":"त्यसका छिमेकीहरू त्यसका शत्रु होऊन्;","poem":2},{"text":"यरूशलेम तिनीहरूका बीचमा","poem":1},{"text":"एक अशुद्ध कुरा भएकी छे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“याहवेह न्यायी हुनुहुन्छ,","poem":1},{"text":"तर पनि मैले उहाँका आज्ञाको विरुद्धमा विद्रोह गरेँ।","poem":2},{"text":"हे सारा जातिहरू हो, सुन;","poem":1},{"text":"मेरो पीडालाई हेर।","poem":2},{"text":"मेरा जवान मानिस र कुमारीहरू","poem":1},{"text":"निर्वासनमा लगिएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“मैले मेरा मित्रहरूलाई बोलाएँ,","poem":1},{"text":"तर तिनीहरूले मलाई धोका दिए।","poem":2},{"text":"मेरा पुजारीहरू र मेरा अगुवाहरू","poem":1},{"text":"आफू जीवित रहनका निम्ति","poem":2},{"text":"खानेकुरा खोज्दा-खोज्दै","poem":1},{"text":"सहरमा नै नष्‍ट भए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“हेर्नुहोस्, हे याहवेह, म कस्तो कष्‍टमा छु!","poem":1},{"text":"मेरो प्राण मभित्र पीडामा मडारिन्छ,","poem":2},{"text":"र मेरो हृदय व्याकुल छ;","poem":1},{"text":"किनकि म अति विद्रोही भएको छु।","poem":2},{"text":"घरबाहिर तरवार नष्‍ट गर्नमा सक्रिय छ भने,","poem":1},{"text":"घरभित्र पनि मृत्यु मात्र छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“मानिसहरूले मेरो सुस्केरा सुनेका छन्,","poem":1},{"text":"तर मलाई सान्त्वना दिने कोही पनि छैन।","poem":2},{"text":"मेरा सबै शत्रुहरूले मेरो कष्‍टको बारेमा सुनेका छन्;","poem":1},{"text":"तपाईंले जे गर्नुभयो, त्यसमा शत्रुहरू रमाउँछन्।","poem":2},{"text":"तपाईंले घोषणा गर्नुभएको दण्डको दिन ल्याउनुहोस्,","poem":1},{"text":"र मेरा शत्रुहरू पनि मजस्तै कष्‍टमा परून्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“शत्रुहरूका सबै दुष्‍ट कामहरू तपाईंको सामु आऊन्;","poem":1},{"text":"मेरा पापहरूको कारण","poem":2},{"text":"मसँग जस्तो व्यवहार गर्नुभयो,","poem":1},{"text":"तिनीहरूसँग पनि त्यस्तै व्यवहार गर्नुहोस्।","poem":2},{"text":"मेरा सुस्केरा धेरै छन्","poem":1},{"text":"र मेरो हृदय दुर्बल छ।”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}