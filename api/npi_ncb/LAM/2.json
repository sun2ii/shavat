{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"LAM","translationId":"npi_ncb","name":"विलाप","commonName":"विलाप","title":"विलापको पुस्तक","order":25,"numberOfChapters":5,"sha256":"b8c5605f384922e14d782949eadcaa511e3fad2ac961e31a823a02f3719b99bd","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/npi_ncb/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"प्रभुले आफ्नो रिसको बादलले","poem":1},{"text":"कसरी सियोनकी छोरीलाई ढाकिदिनुभएको छ!","poem":2},{"text":"उहाँले इस्राएलको स्वर्गीय गौरवलाई","poem":1},{"text":"तल पृथ्वीमा खसालिदिनुभएको छ;","poem":2},{"text":"उहाँले आफ्नो रिसको दिनमा","poem":1},{"text":"आफ्नो पाउदानलाई सम्झनुभएन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"प्रभुले याकोबका सबै वासस्थानहरूलाई","poem":1},{"text":"दया नदेखाई नष्‍ट पार्नुभयो;","poem":2},{"text":"उहाँले आफ्नो रिसमा यहूदाका छोरीका","poem":1},{"text":"बलिया किल्‍लाहरू ध्वस्त गर्नुभयो।","poem":2},{"text":"उहाँले त्यसको राज्य र त्यसका राजकुमारलाई","poem":1},{"text":"भुइँको धुलोसँग मिलाएर अपमानित तुल्याउनुभयो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"उहाँको डरलाग्दो क्रोधमा इस्राएलको","poem":1},{"text":"सबै शक्तिलाई उहाँले नष्‍ट पार्नुभयो।","poem":2},{"text":"उहाँले इस्राएलीहरूको शत्रु नजिक आइपुग्दा,","poem":1},{"text":"आफ्नो सहयोगी हात पछिल्तिर सार्नुभयो।","poem":2},{"text":"उहाँ याकोबमाथि दन्केको आगोझैँ दन्कनुभयो,","poem":1},{"text":"जसले वरिपरिका सबै कुरा भस्म पार्‍यो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"उहाँले शत्रुले जस्तै आफ्नो धनुमा ताँदो चढाउनुभएको छ;","poem":1},{"text":"निशाना लगाउन उहाँको दाहिने हात तयार छ।","poem":2},{"text":"उहाँले आफ्ना नजरमा प्रिय ठानेकाहरूलाई","poem":1},{"text":"शत्रुलाई झैँ संहार गर्नुभयो;","poem":2},{"text":"उहाँले सियोनकी छोरीको पालमा","poem":1},{"text":"आफ्नो रिस आगोजस्तै बर्साउनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"प्रभु शत्रुजस्तै बन्‍नुभएको छ;","poem":1},{"text":"उहाँले इस्राएललाई निल्नुभएको छ।","poem":2},{"text":"उहाँले यरूशलेमका सबै महलहरू नष्‍ट गर्नुभएको छ;","poem":1},{"text":"अनि त्यसका किल्‍लाहरू भत्काइदिनुभएको छ।","poem":2},{"text":"यहूदाका छोरीको निम्ति उहाँले शोक","poem":1},{"text":"र विलाप बढाइदिनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"उहाँले आफ्नो यरूशलेमको बासस्थानलाई बगैँचाको छाप्रोलाई झैँ भत्काइदिनुभएको छ;","poem":1},{"text":"अनि उहाँले आफ्नो सभाको स्थानलाई नष्‍ट पारिदिनुभएको छ।","poem":2},{"text":"याहवेहले सियोनबाट तोकिएका","poem":1},{"text":"चाडहरू र शब्बाथ दिनहरूको सम्झना मेटिदिनुभएको छ;","poem":2},{"text":"उहाँले आफ्नो डरलाग्दो क्रोधमा राजा र पुजारी","poem":1},{"text":"दुवैलाई तिरस्कार गर्नुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"प्रभुले आफ्नो वेदीलाई इन्कार गर्नुभएको छ,","poem":1},{"text":"र आफ्नो पवित्रस्थानलाई त्याग्नुभएको छ।","poem":2},{"text":"उहाँले त्यसका महलका पर्खालहरू","poem":1},{"text":"शत्रुका हातमा दिनुभएको छ;","poem":2},{"text":"तिनीहरूले तोकिएको चाडको दिनमा झैँ","poem":1},{"text":"याहवेहको भवनमा उत्सवको उच्‍च आवाज उठाएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेहले सियोनको छोरीका वरिपरिको","poem":1},{"text":"पर्खाल भत्काउने अठोट गर्नुभयो।","poem":2},{"text":"उहाँले एउटा नाप्‍ने फित्ताले नाप लिनुभयो","poem":1},{"text":"र त्यसलाई नष्‍ट गर्न आफ्नो हातलाई रोक्नुभएन।","poem":2},{"text":"उहाँले किल्‍लाहरू र पर्खालहरूलाई विलाप गर्न लगाउनुभयो;","poem":1},{"text":"अनि ती पर्खालहरू एकैसाथ ढले।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"त्यसका मूलढोकाहरू जमिनमा भासिए;","poem":1},{"text":"त्यसका गजबारहरू भत्काएर नष्‍ट पारिए।","poem":2},{"text":"त्यसका राजा र राजकुमारहरू गैरयहूदीहरूका बीचमा निर्वासित भएका छन्।","poem":1},{"text":"अब व्यवस्था रहँदैन,","poem":2},{"text":"न त तिनीहरूका अगमवक्ताहरूले","poem":1},{"text":"याहवेहबाट कुनै दर्शन नै पाउँछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"सियोनका छोरीका धर्मगुरुहरू","poem":1},{"text":"चुपचाप भुइँमा बसेका छन्;","poem":2},{"text":"तिनीहरूले आफ्ना शिरमा धुलो छरेका छन्,","poem":1},{"text":"र भाङ्ग्राका वस्त्र पहिरिएका छन्।","poem":2},{"text":"यरूशलेमका कुमारीहरूले","poem":1},{"text":"आफ्नो शिर भुइँतिर झुकाएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"मेरा आँखा रुँदा-रुँदा टट्टाइसकेका छन्,","poem":1},{"text":"मेरो प्राण मभित्र व्याकुल छ;","poem":2},{"text":"मेरो हृदय छिया-छिया भएको छ;","poem":1},{"text":"किनकि मेरा मानिसहरू नष्‍ट भएका छन्;","poem":2},{"text":"अनि बालबालिकाहरू र दुधे बच्‍चाहरू","poem":1},{"text":"सहरका गल्‍लीहरूमा बेहोश भएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"जब तिनीहरू गल्‍लीहरूमा","poem":1},{"text":"घाइते ढलेझैँ ढल्छन्,","poem":2},{"text":"जब तिनीहरूको प्राण","poem":1},{"text":"आफ्ना आमाका काखमा शिथिल हुन्छन्,","poem":2},{"text":"तब आफ्ना आमाहरूलाई यसो भन्छन्,","poem":1},{"text":"“खोइ, भोजन र दाखमद्य कहाँ छन्?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"हे यरूशलेमकी छोरी,","poem":1},{"text":"तँलाई म के भनूँ?","poem":2},{"lineBreak":true},{"text":"म तँलाई केसँग तुलना गरूँ?","poem":2},{"text":"हे सियोनकी कुमारी छोरी,","poem":1},{"text":"म तँलाई केसँग तुलना गरूँ?","poem":2},{"lineBreak":true},{"text":"ताकि म तँलाई सान्त्वना दिन सकूँ?","poem":2},{"text":"तेरो विनाशको चोट सागरझैँ गहिरो छ।","poem":1},{"text":"तँलाई कसले निको पार्न सक्ला?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"तिमीहरूका अगमवक्ताहरूका दर्शनहरू","poem":1},{"text":"झूटा र व्यर्थका थिए;","poem":2},{"text":"तँलाई कैदमा जानबाट जोगाउनलाई","poem":1},{"text":"तिनीहरूले तेरो पाप प्रकट गरिदिएनन्।","poem":2},{"text":"बरु तिनीहरूले तेरा लागि","poem":1},{"text":"झूटो र भ्रामक ईश्‍वरवाणी गरे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"तेरो बाटो छेउभएर जाने मानिसहरू","poem":1},{"text":"सबैले तँलाई खिसी गर्दै ताली बजाउँछन्;","poem":2},{"text":"यरूशलेमकी छोरीको विरुद्ध खिसी गर्दै","poem":1},{"text":"टाउको हल्‍लाउँछन्:","poem":2},{"text":"“के यो त्यही सहर हो,","poem":1},{"text":"जसलाई अति सुन्दर","poem":2},{"lineBreak":true},{"text":"र सारा पृथ्वीको आनन्द भनेर चिनिन्थ्यो?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"तेरा सबै शत्रुहरू आफ्ना मुख","poem":1},{"text":"खोलेर तेरो विरुद्धमा बोल्छन्;","poem":2},{"text":"तिनीहरूले खिसी गर्छन्; आफ्ना दाह्रा किट्छन्,","poem":1},{"text":"र भन्छन्, “हामीले त्यसलाई निलिसक्यौँ।","poem":2},{"text":"हामीले प्रतीक्षा गरेको दिन यही हो;","poem":1},{"text":"हामी यो दिन हेर्नलाई नै बाँचेका थियौँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"याहवेहले जे योजना गर्नुभएको थियो;","poem":1},{"text":"उहाँले त्यही आफ्नो वचन पूरा गर्नुभएको छ,","poem":2},{"lineBreak":true},{"text":"जुन वचन उहाँले धेरै समयअगि घोषणा गर्नुभएको थियो।","poem":2},{"text":"उहाँले तँलाई दयाविना ध्वस्त गर्नुभएको छ;","poem":1},{"text":"उहाँले तेरा शत्रुहरूलाई तँमाथि रमाउन दिनुभएको छ,","poem":2},{"lineBreak":true},{"text":"र उहाँले तेरा शत्रुहरूका सिङ","poem":2},{"noteId":0},{"text":"उच्‍च पारिदिनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"मानिसका हृदयले","poem":1},{"text":"प्रभुलाई चर्को सोरले पुकार्दछन्।","poem":2},{"text":"हे सियोनकी छोरीको पर्खाल,","poem":1},{"text":"तेरो आँसु नदीझैँ","poem":2},{"lineBreak":true},{"text":"दिनरात बगोस्;","poem":2},{"text":"तैँले आफूलाई अलिकति पनि विश्राम नदे!","poem":1},{"text":"अनि आफ्ना आँखाहरूलाई पनि आराम नदे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"जब रातको पहिलो पहर सुरु हुन्छ,","poem":1},{"text":"तब रातभरि उठेर करा;","poem":2},{"text":"तेरो हृदय पानीझैँ","poem":1},{"text":"प्रभुको उपस्थितिमा पोख्।","poem":2},{"text":"तेरा बालबालिकाको जीवनको निम्ति","poem":1},{"text":"आफ्ना हातहरू उहाँतिर उठा,","poem":2},{"text":"ती बालकहरू, जो हरेक गल्‍लीका मोडमा","poem":1},{"text":"भोकले मूर्च्छा परेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“हे याहवेह हेर्नुहोस् र विचार गर्नुहोस्:","poem":1},{"text":"तपाईंले कोसँग यस्तो व्यवहार गर्नुभएको छ?","poem":2},{"text":"के स्त्रीहरूले आफ्ना सन्तानहरूलाई,","poem":1},{"text":"आफूले स्याहारेका आफ्नै गर्भका फलहरूलाई खाऊन्?","poem":2},{"text":"के प्रभुका पवित्रस्थानका पुजारीहरू","poem":1},{"text":"र अगमवक्ताहरू दुवै मारिऊन्?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“बुढापाका र जवानहरू सडकको धुलोमा","poem":1},{"text":"एकसाथ लडिरहेका छन्;","poem":2},{"text":"मेरा जवान केटा र केटीहरू","poem":1},{"text":"शत्रुका तरवारले मारिएका छन्।","poem":2},{"text":"तपाईंको क्रोधको दिनमा तपाईंले तिनीहरूलाई मार्नुभएको छ;","poem":1},{"text":"तपाईंले तिनीहरूलाई नटिठ्याई मार्नुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“तपाईंले चाडको दिनमा मानिसहरूलाई बोलाएझैँ,","poem":1},{"text":"तपाईंले चारैतिरबाट मेरो विरुद्धमा त्रास निम्त्याउनुभयो।","poem":2},{"text":"याहवेहको क्रोधको दिनमा","poem":1},{"text":"कोही पनि भाग्न वा बाँच्न सकेनन्;","poem":2},{"text":"जसलाई मैले हुर्काएँ र स्याहारेँ;","poem":1},{"text":"तिनीहरूलाई मेरा शत्रुहरूले सर्वनाश गरेका छन्।”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"सिङ यहाँ शक्ति भन्‍ने जनाउँछ।","reference":{"chapter":2,"verse":17}}]},"thisChapterLink":"/api/npi_ncb/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}