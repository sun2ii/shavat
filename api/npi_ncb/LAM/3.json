{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"LAM","translationId":"npi_ncb","name":"विलाप","commonName":"विलाप","title":"विलापको पुस्तक","order":25,"numberOfChapters":5,"sha256":"b8c5605f384922e14d782949eadcaa511e3fad2ac961e31a823a02f3719b99bd","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/npi_ncb/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहको क्रोधको लाठोद्वारा","poem":1},{"text":"दुःख भोग्ने मानिस म नै हुँ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"उहाँले मलाई खेद्नुभयो, र उज्यालोको सट्टा","poem":1},{"text":"अन्धकारमा हिँड्न लगाउनुभएको छ;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"वास्तवमा उहाँले आफ्नो हात","poem":1},{"text":"दिनभरि नै घरी-घरी मेरो विरुद्धमा उठाउनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"उहाँले मेरो छाला र मासु धुजा-धुजा पारिदिनुभएको छ;","poem":1},{"text":"अनि मेरा हड्डीहरू भाँचिदिनुभएको छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उहाँले मलाई तितोपना र कष्‍टले","poem":1},{"text":"चारैतिर घेरेर कब्जामा पार्नुभएको छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"उहाँले मलाई धेरै अगि मरेकाहरूलाईझैँ","poem":1},{"text":"अन्धकारमा राख्नुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"म भाग्न नसकूँ भनेर उहाँले मेरो चारैतिर पर्खालले घेर्नुभएको छ;","poem":1},{"text":"उहाँले मलाई गह्रौँ साङ्लाले बाँध्नुभएको छ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मैले उहाँलाई सहायताको निम्ति पुकार्दा र रुँदा पनि","poem":1},{"text":"उहाँले मेरो प्रार्थनालाई इन्कार गर्नुभयो।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"उहाँले ठूला-ठूला ढुङ्गाले मेरो बाटो थुनिदिनुभएको छ;","poem":1},{"text":"उहाँले मेरो बाटो बाङ्गो-टिङ्गो बनाइदिनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"आक्रमण गर्नलाई ढुकिरहेको भालुजस्तै","poem":1},{"text":"र लुकिरहेको सिंहले जस्तै","poem":2}]},{"type":"verse","number":11,"content":[{"text":"उहाँले मलाई बाटोबाट घिसारेर लैजानुभयो,","poem":1},{"text":"र उहाँले मलाई टुक्रा-टुक्रा पार्नुभयो र सहाराहीन तुल्याउनुभयो।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"उहाँले आफ्नो धनुमा ताँदो चढाउनुभयो,","poem":1},{"text":"र मलाई नै उहाँको काँडको निसाना बनाउनुभयो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"उहाँले आफ्नो ठोक्रोको काँडले","poem":1},{"text":"मेरो मुटु छेडिदिनुभयो।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"म सबै मानिसहरूको हाँसोको पात्र भएको छु;","poem":1},{"text":"दिनभरि नै म तिनीहरूको गिल्‍लाको गीत भएको छु।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"उहाँले मलाई तितो जडीबुटीले भरिदिनुभयो","poem":1},{"text":"र पित्त पिउन दिनुभयो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"उहाँले रोडा चपाउन लगाएर मेरा दाँतहरू भाँचिदिनुभयो;","poem":1},{"text":"उहाँले मलाई धुलोमा कुल्चीमिल्ची गर्नुभयो।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"मेरो आत्माबाट शान्ति खोसिएको छ;","poem":1},{"text":"सुख के हो, त्यो मैले बिर्सिसकेको छु।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"यसकारण म भन्दछु, “मेरो गौरव","poem":1},{"text":"र मैले याहवेहबाट गरेको आशा टुटिसकेको छ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"म मेरो कष्‍ट र मेरो घरविहीनको अवस्था,","poem":1},{"text":"तितोपन र पित्तको स्मरण गर्दछु।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"म तिनीहरूलाई राम्ररी स्मरण गर्दछु,","poem":1},{"text":"र मेरो आत्मा मभित्र हताश हुन्छ।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तर पनि जब म यो कुरा स्मरण गर्दछु,","poem":1},{"text":"तब यसैले मलाई आशा दिन्छ:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"याहवेहको महान् प्रेमको कारण हामी भस्म भएका छैनौँ;","poem":1},{"text":"किनकि उहाँको कृपाको अन्त्य कहिल्यै हुँदैन।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"हरेक बिहान ती नयाँ भएर आउँछन्;","poem":1},{"text":"तपाईंको विश्‍वसनीयता महान् छ।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"म आफूलाई भन्दछु, “याहवेह मेरो सर्वस्व हुनुहुन्छ;","poem":1},{"text":"यसैकारण म उहाँको प्रतीक्षा गर्नेछु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"याहवेहमा आशा राख्नेहरू","poem":1},{"text":"र उहाँको खोजी गर्नेहरूसँग उहाँ भलो हुनुहुन्छ;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"याहवेहको उद्धारका निम्ति","poem":1},{"text":"चुपचाप प्रतीक्षा गर्नु असल कुरा हो।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"आफ्नो जवान अवस्थामा नै जुवा बोक्नु","poem":1},{"text":"मानिसका निम्ति असल हुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"त्यो एकलै शान्त भएर बसोस्;","poem":1},{"text":"किनकि याहवेहले त्यसलाई जुवा बोकाउनुभएको छ।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"त्यसले आफ्नो मुख भुइँसम्म झुकाओस्,","poem":1},{"text":"अझै पनि त्यसमा आशा होस्।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"उसलाई प्रहार गर्नेलाई त्यसले आफ्नो गाला थापिदिओस्;","poem":1},{"text":"अनि त्यसले अपमान गिल्‍ला सहँदै रहोस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"किनकि प्रभुले","poem":1},{"text":"मानिसलाई सधैँभरिको निम्ति कहिल्यै पनि त्याग्नुहुनेछैन।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"उहाँले दुःख दिनुभए तापनि उहाँले कृपा देखाउनुहुन्छ;","poem":1},{"text":"किनकि उहाँको अटुट प्रेम अति महान् छ।","poem":2}]},{"type":"verse","number":33,"content":[{"text":"किनकि उहाँले स्वइच्छाले","poem":1},{"text":"कसैमाथि पनि दुःख वा कष्‍ट दिनुहुन्‍न।","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"यहूदा देशका सबै कैदीहरूलाई","poem":1},{"text":"पैतालामुनि कुल्चँदा,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"सर्वोच्‍च परमेश्‍वरको सामु","poem":1},{"text":"मानिसको अधिकार खोसिँदा,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"र तिनीहरूले न्याय नपाउँदा","poem":1},{"text":"के यी सबै कुराहरू प्रभुले देख्न सक्नुहुन्‍न र?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"प्रभुले आज्ञा गर्नुभएन भने","poem":1},{"text":"कसले पो बोलेको कुरा पूरा गर्न सक्छ?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"के सर्वोच्‍चका मुखबाट नै","poem":1},{"text":"विपत्ति र असल कुरा दुवै आउँदैनन् र?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"जीवित मानिसले आफ्ना पापको","poem":1},{"text":"दण्ड पाउँदा किन गनगन गर्नु?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"हामीले हाम्रा चालहरू जाँच गरेर हेरौँ,","poem":1},{"text":"र हामी याहवेहतिर फर्कौँ।","poem":2}]},{"type":"verse","number":41,"content":[{"text":"हामी हाम्रा हात र हृदय स्वर्गका","poem":1},{"text":"परमेश्‍वरतिर उचालौँ र भनौँ:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“हामीले पाप गरेका छौँ र विद्रोह गरेका छौँ,","poem":1},{"text":"अनि तपाईंले क्षमा गर्नुभएको छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“तपाईं क्रोधले भरिनुभयो र हामीलाई खेद्नुभयो;","poem":1},{"text":"तपाईंले हामीलाई निर्दयतापूर्वक मार्नुभयो।","poem":2}]},{"type":"verse","number":44,"content":[{"text":"तपाईंले आफैँलाई बादलले ढाक्नुभएको छ,","poem":1},{"text":"ताकि तपाईंकहाँ कुनै पनि प्रार्थना नपुगोस्।","poem":2}]},{"type":"verse","number":45,"content":[{"text":"तपाईंले हामीलाई राष्ट्रहरूका बीचमा","poem":1},{"text":"फोहोर-कसिङ्गरको थुप्रोझैँ बनाउनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“हाम्रा सबै शत्रुहरूले","poem":1},{"text":"ठूलो मुख खोलेर हाम्रा विरुद्धमा बोलेका छन्।","poem":2}]},{"type":"verse","number":47,"content":[{"text":"हामीले त्रास र खतराको पासो,","poem":1},{"text":"नाश र विनाशको कष्‍ट भोगेका छौँ।”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"मेरा आँखाबाट आँसुका धारा निरन्तर बग्दछन्;","poem":1},{"text":"किनकि मेरा मानिसहरू सर्वनाश भएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"मेरा आँखाबाट आँसु नरोकी,","poem":1},{"text":"निरन्तर बगिरहनेछ,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"जबसम्म याहवेहले स्वर्गबाट","poem":1},{"text":"तल हेर्नुहुन्‍न र देख्नुहुन्‍न।","poem":2}]},{"type":"verse","number":51,"content":[{"text":"मैले देखेको कुराले मलाई शोकित बनाउँदछ;","poem":1},{"text":"किनकि म मेरो सहरका सबै स्त्रीहरूको दुर्दशा देख्छु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"मेरा शत्रुहरूले विनाकारण","poem":1},{"text":"मलाई चरालाई झैँ शिकार गरिहिँडे।","poem":2}]},{"type":"verse","number":53,"content":[{"text":"तिनीहरूले एउटा खाडलमा मेरो जीवनको","poem":1},{"text":"अन्त्य गर्न खोजे र मलाई ढुङ्गाले हाने;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"पानी मेरो टाउकोसम्म नै आइपुग्यो;","poem":1},{"text":"तब मैले सोचेँ कि अब मेरो अन्त्य आइपुग्यो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"हे याहवेह, मैले खाडलको गहिराइबाट,","poem":1},{"text":"तपाईंको नाममा पुकारेँ।","poem":2}]},{"type":"verse","number":56,"content":[{"text":"तपाईंले मेरो बिन्ती सुन्‍नुभयो: “छुटकाराको मेरो पुकारप्रति","poem":1},{"text":"आफ्नो कान बन्द नगर्नुहोस्!”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"मैले पुकारेको दिनमा तपाईं मेरो छेउमा आउनुभयो,","poem":1},{"text":"र तपाईंले भन्‍नुभयो, “नडरा!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"हे प्रभु, तपाईंले मेरो मुद्दाहरू लिएर लड्नुभयो;","poem":1},{"text":"र तपाईंले मेरो जीवनको उद्धार गर्नुभयो।","poem":2}]},{"type":"verse","number":59,"content":[{"text":"हे याहवेह, तपाईंले ममाथि भएको अत्याचार देख्नुभएको छ।","poem":1},{"text":"मेरो न्याय गरिदिनुहोस्!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"तिनीहरूले मसित लिएको बदलाको गहिराइ","poem":1},{"text":"र मेरो विरुद्धमा गरेका सबै युक्तिहरू देख्नुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"हे याहवेह, तिनीहरूले ममाथि गरेका अपमान","poem":1},{"text":"र तिनीहरूका सबै युक्तिहरू तपाईंले सुन्‍नुभएको छ;","poem":2}]},{"type":"verse","number":62,"content":[{"text":"मेरा शत्रुहरूले दिनभरि","poem":1},{"text":"मेरो विरुद्धमा गरेका कानेखुसी र गनगनलाई सुन्‍नुभएको छ।","poem":2}]},{"type":"verse","number":63,"content":[{"text":"तिनीहरूको उठाइ र बसाइ हेर्नुहोस्!","poem":1},{"text":"तिनीहरू गीत गाएर मेरो गिल्‍ला गर्दछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"हे याहवेह, तिनीहरूका हातले जे गरेका छन्,","poem":1},{"text":"तिनीहरूले पाउनुपर्ने उचित दण्ड तिनीहरूलाई दिनुहोस्।","poem":2}]},{"type":"verse","number":65,"content":[{"text":"तिनीहरूका हृदयमा पर्दा लगाइदिनुहोस्;","poem":1},{"text":"अनि तपाईंको श्राप तिनीहरूमाथि परोस्!","poem":2}]},{"type":"verse","number":66,"content":[{"text":"हे याहवेह, आफ्नो रिसमा तिनीहरूलाई खेद्नुहोस्,","poem":1},{"text":"र तपाईंको स्वर्गमुनिबाट नाश गर्नुहोस्!","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}