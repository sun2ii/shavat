{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"LAM","translationId":"npi_ncb","name":"विलाप","commonName":"विलाप","title":"विलापको पुस्तक","order":25,"numberOfChapters":5,"sha256":"b8c5605f384922e14d782949eadcaa511e3fad2ac961e31a823a02f3719b99bd","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/npi_ncb/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"सुनले कसरी आफ्नो चमक हरायो!","poem":1},{"text":"निखुर सुन कसरी फिक्‍का भएको छ!","poem":2},{"text":"हरेक पवित्र पत्थरहरू","poem":1},{"text":"सडकको कुनामा छरपस्ट भएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"सियोनका बहुमूल्य छोराहरू,","poem":1},{"text":"जो एक पटक सुन जत्तिकै उत्कृष्‍ट थिए,","poem":2},{"text":"तर अहिले तिनीहरू कुमालेका हातले बनेका","poem":1},{"text":"माटाका भाँडा समान गनिएका छन्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"स्यालका माउले पनि तिनीहरूका","poem":1},{"text":"बच्‍चालाई आफ्ना स्तनपान गराउँछन्,","poem":2},{"text":"तर मेरा प्रजा मरुभूमिका","poem":1},{"text":"शुतुरमुर्गजस्तै हृदयविहीन भएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"किनकि दुधे बालकको जिब्रो","poem":1},{"text":"तिर्खाले त्यसको मुखको तालुमा टाँसिन्छ;","poem":2},{"text":"केटाकेटीहरूले खानेकुरा माग्छन्,","poem":1},{"text":"तर कसैले पनि तिनीहरूलाई केही दिँदैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"कुनै समय मिठा-मिठा खानेकुरा खानेहरू","poem":1},{"text":"अहिले सडकहरूमा बेसहारा भएका छन्।","poem":2},{"text":"राजकीय बैजनी वस्त्र पहिरेर हुर्केकाहरू","poem":1},{"text":"अहिले खरानीको घुरानमा बसिरहेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मेरो प्रजाको दण्ड","poem":1},{"text":"सदोमको दण्डभन्दा ठूलो छ,","poem":2},{"text":"जुन सहर क्षणभरमा विनाश भयो,","poem":1},{"text":"जसलाई गुहार गर्ने मान्छे एउटै पनि भएन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"त्यसका राजकुमारहरू हिउँभन्दा","poem":1},{"text":"चम्किला र दूधभन्दा सेता थिए;","poem":2},{"text":"तिनीहरूको शरीर बहुमूल्य रत्नमणीभन्दा राता","poem":1},{"text":"र तिनीहरूको रूप नीलमणिको जस्तो तेजस्वी थियो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"तर अहिले तिनीहरूको रूप मोसोभन्दा कालो भएको छ;","poem":1},{"text":"तिनीहरू सडकहरूमा चिनिँदैनन्।","poem":2},{"text":"तिनीहरूका छाला हड्डीहरूमा टाँसिएको छ;","poem":1},{"text":"त्यो काठझैँ सुक्खा भएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"अनिकालले मर्नेहरूभन्दा","poem":1},{"text":"तरवारले मारिएकाहरू झन् असल हुन्छन्;","poem":2},{"text":"तिनीहरू जमिनका फसलको अभाव","poem":1},{"text":"र भोकले पीडित भएर सुक्दै गइरहेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"जब मेरा प्रजाहरू सर्वनाश भइरहेका थिए,","poem":1},{"text":"तब दयालु हृदय भएका स्त्रीहरूले पनि","poem":2},{"text":"आफ्नै हातले आफ्ना छोराछोरीहरूलाई पकाए;","poem":1},{"text":"आफ्नै सन्तानहरू तिनीहरूका भोजन भए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"याहवेहले आफ्नो क्रोध पूर्ण रूपमा प्रकट गर्नुभएको छ;","poem":1},{"text":"उहाँले आफ्नो भयङ्कर रिस पोख्नुभएको छ।","poem":2},{"text":"उहाँले सियोनमा रिसको आगो सल्काउनुभएको छ,","poem":1},{"text":"र आगोले त्यसका जगहरू भस्म भएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"कुनै पनि शत्रु र विरोधीहरू","poem":1},{"text":"यरूशलेमका मूलढोकाहरूबाट भित्र पस्लान् भनी","poem":2},{"text":"न पृथ्वीका राजाहरूले,","poem":1},{"text":"न त संसारका कुनै मानिसले नै विश्‍वास गरेका थिए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"तर त्यस देशका अगमवक्ताहरूका पाप","poem":1},{"text":"र पुजारीहरूका अपराधको कारणले गर्दा त्यसो भएको हो।","poem":2},{"text":"तिनीहरूले यरूशलेमभित्र","poem":1},{"text":"धर्मीहरूका रगत बगाएका थिए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"अहिले तिनीहरू अन्धा मानिसहरूजस्ता","poem":1},{"text":"सडकहरूमा छामछुम गरेर हिँड्छन्।","poem":2},{"text":"तिनीहरू रगत लागेर यति अशुद्ध भएका छन्,","poem":1},{"text":"कि तिनीहरूका वस्त्रहरू कसैले पनि छुन चाहँदैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"मानिसहरूले अगमवक्ता र पुजारीहरूलाई कराएर भन्छन्,","poem":1},{"text":"“टाढा जाओ! तिमीहरू अशुद्ध छौ!”","poem":2},{"lineBreak":true},{"text":"“टाढा जाओ! टाढा जाओ! हामीलाई नछोओ!”","poem":2},{"text":"जब तिनीहरू भगुवा र फिरन्ते भए,","poem":1},{"text":"तब राष्ट्रहरूको बीचमा विदेशी मानिसहरूले यसो भने,","poem":2},{"lineBreak":true},{"text":"“तिनीहरू अब हामीसित बसोबास गर्न पाउनेछैनन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"याहवेह आफैँले तिनीहरूलाई छरपस्ट पार्नुभएको छ;","poem":1},{"text":"अब उहाँले तिनीहरूको वास्ता गर्न छोड्नुभएको छ।","poem":2},{"text":"न पुजारीहरूलाई सम्मान दिइएको छ,","poem":1},{"text":"न त अगुवाहरूलाई नै कृपादृष्‍टि देखाइएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"गुहारका निम्ति व्यर्थै बाटो हेर्दा-हेर्दा","poem":1},{"text":"हाम्रा आँखा टट्टाइसके;","poem":2},{"text":"हामीले आफ्नो धरहराबाट यस्तो राष्ट्रको बाटो हेरिबस्यौँ,","poem":1},{"text":"जसले हामीलाई बचाउन सकेन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"मानिसहरूले हाम्रो हरेक पाइलाको सुराकी गरेको कारण","poem":1},{"text":"हामी आफ्ना बाटोहरूमा पनि हिँड्न सकेनौँ।","poem":2},{"text":"हाम्रो अन्त्य नजिक थियो, हाम्रा दिनहरूको गन्ती भइसकेको थियो;","poem":1},{"text":"किनकि हाम्रो अन्त्यको समय आइपुगेको थियो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"हामीलाई खेदो गर्नेहरू आकाशका","poem":1},{"text":"चीलहरूभन्दा पनि फूर्तिला थिए;","poem":2},{"text":"तिनीहरूले हामीहरूलाई पर्वतहरूमा खेदे,","poem":1},{"text":"र मरुभूमिमा हामीलाई ढुकेर बसे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"याहवेहको अभिषिक्त राजा,","poem":1},{"text":"हाम्रो जीवनको सास, तिनकै पासोमा थियो।","poem":2},{"text":"हामीले सोच्यौँ कि राजाकै छायामुनि","poem":1},{"text":"हामी राष्ट्रहरूका बीचमा सुरक्षित बसोबास गर्नेछौँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"हे ऊज देशमा बसोबास गर्ने एदोमकी छोरी,","poem":1},{"text":"रमा र आनन्दित हो।","poem":2},{"text":"तर पनि त्यो कचौरा तँलाई पिउनलाई दिइनेछ;","poem":1},{"text":"त्यो कचौरा पिएर तँ मात्तिनेछस्, र आफैँलाई नाङ्गो पार्नेछस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"हे सियोनकी छोरी, तेरो दण्डको अन्त्य हुनेछ;","poem":1},{"text":"उहाँले तेरो निर्वासनको अवधि लम्ब्याउनुहुनेछैन।","poem":2},{"text":"तर हे एदोमकी छोरी, उहाँले तेरो पापको दण्ड दिनुहुनेछ;","poem":1},{"text":"अनि उहाँले तेरो दुष्‍टता प्रकट गरिदिनुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}