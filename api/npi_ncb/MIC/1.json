{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"MIC","translationId":"npi_ncb","name":"मीका","commonName":"मीका","title":"मीकाको भविष्यवाणी","order":33,"numberOfChapters":7,"sha256":"ff96d2c8229c42a67bbce43375052fda8a493d4be759cbda5d8b66695ae54674","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/npi_ncb/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["याहवेहको यो वचन, यहूदाका राजाहरू योताम, आहाज र हिजकियाका शासनकालमा, मोरेशेतमा बस्‍ने मीकाकहाँ आयो। जुन वचन तिनले सामरिया र यरूशलेमको बारेमा दर्शनमा देखेका थिए।"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"हे जाति-जातिका मानिस हो, तिमीहरू सबैले सुन!","poem":1},{"text":"हे पृथ्वी र त्यसमा बसोबास गर्ने सबै मानिसहरू हो, सुन!","poem":2},{"text":"याहवेह आफ्नो पवित्र मन्दिरबाट,","poem":1},{"text":"प्रभु याहवेह नै तिमीहरूका विरुद्धमा साक्षी होऊन्!","poem":2}]},{"type":"heading","content":["सामरिया र यरूशलेमका विरुद्धमा न्याय"]},{"type":"verse","number":3,"content":[{"text":"हेर, याहवेह आफ्नो वासस्थानबाट आउँदैहुनुहुन्छ।","poem":1},{"text":"उहाँ तल ओर्लिआउनुहुन्छ र पृथ्वीका उच्‍च स्थानहरूलाई टेक्नुहुन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उहाँको पाइलामुनि पर्वतहरू पग्लिन्छन्,","poem":1},{"text":"र उपत्यकाहरू टुक्रिन्छन्;","poem":2},{"text":"आगोको सामु मैन पग्लिएझैँ,","poem":1},{"text":"र भिरबाट पानी बगेजस्तै हुन्छन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यो सबै कुरा याकोबको अपराधको कारणले गर्दा हो।","poem":1},{"text":"इस्राएलका मानिसहरूका पापहरूको कारणले गर्दा हो।","poem":2},{"text":"याकोबको अपराध के हो त?","poem":1},{"text":"के यो सामरिया होइन र?","poem":2},{"text":"यहूदाको उच्‍च स्थान के हो?","poem":1},{"text":"के त्यो यरूशलेम होइन र?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“यसकारण म सामरियालाई भग्नावशेष,","poem":1},{"text":"र दाखबारी रोप्ने ठाउँजस्तै तुल्याइदिनेछु।","poem":2},{"text":"म त्यसका भग्नावशेषहरू बेँसीमा फालिदिनेछु,","poem":1},{"text":"र त्यसका जगहरूलाई उदाङ्गो पारिदिनेछु।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्यसका सबै मूर्तिहरू टुक्रा-टुक्रा पारिनेछन्;","poem":1},{"text":"त्यसका मन्दिरका सबै उपहारहरू आगोले जलाइनेछन्;","poem":2},{"lineBreak":true},{"text":"म त्यसका सबै मूर्तिहरूलाई ध्वस्त पारिदिनेछु।","poem":2},{"text":"किनकि त्यसले आफ्ना उपहारहरू वेश्यावृत्तिको ज्यालाद्वारा जम्मा गरेकी थिई;","poem":1},{"text":"अनि फेरि पनि तिनीहरू वेश्यावृत्तिकै ज्यालाको रूपमा प्रयोग गरिनेछन्।”","poem":2}]},{"type":"heading","content":["रुवाबासी र विलाप"]},{"type":"verse","number":8,"content":[{"text":"यसैकारण म रुँदै विलाप गर्नेछु;","poem":1},{"text":"म नाङ्गै भई खाली खुट्टाले हिँड्नेछु।","poem":2},{"text":"म स्यालले जस्तै कराउनेछु,","poem":1},{"text":"र उल्‍लुले जस्तै बिलौना गर्नेछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"किनकि सामरियाको घाउ निको नहुने किसिमको छ;","poem":1},{"text":"त्यो यहूदासम्म नै फैलिएको छ।","poem":2},{"text":"त्यो मेरा मानिसहरूका ढोकासम्म नै आइपुगेको छ।","poem":1},{"text":"त्यो यरूशलेमको सहरसम्म नै आइपुगेको छ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"गातलाई यो कुरा नसुनाओ;","poem":1},{"text":"तिमीहरू रुँदै नरोओ!","poem":2},{"text":"बेथ-ओप्रामा","poem":1},{"noteId":0},{"text":"धुलोमा लडीबुडी गर।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हे शाफीरका","poem":1},{"noteId":1},{"text":"बासिन्दाहरू हो,","poem":1},{"text":"नाङ्गा र लज्जित भएर निस्किजाओ।","poem":2},{"text":"सानानका बासिन्दाहरू,","poem":1},{"text":"बाहिर आउनेछैनन्।","poem":2},{"text":"बेथ-एजेल शोकमा छ;","poem":1},{"text":"अब त्यसले तिमीहरूलाई सुरक्षा गर्दैन।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मारोतमा बस्‍नेहरू सहायताको पर्खाइमा","poem":1},{"text":"पीडाले छटपटाइरहेका छन्;","poem":2},{"text":"किनकि याहवेहबाट आएको विपत्ति","poem":1},{"text":"यरूशलेमको ढोकासम्म नै आइपुगेको छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"हे लाकीशमा बस्‍नेहरू हो,","poem":1},{"text":"वेगले दौडने घोडाहरूलाई रथमा कस।","poem":2},{"text":"सियोनकी छोरीका निम्ति लाकीशबाट नै पाप सुरु भएको थियो;","poem":1},{"text":"किनकि तिमीहरूमा नै इस्राएलले गरेजस्तै अपराधहरू भेट्टाइएको थियो।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"यसकारण तिमीहरूले नै","poem":1},{"text":"मोरेशेत-गातलाई बिदाइका उपहारहरू दिनेछौ।","poem":2},{"text":"इस्राएलका राजाहरूका निम्ति","poem":1},{"text":"अक्जीबको सहर धोका दिने सहरको रूपमा प्रमाणित हुनेछ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"हे मारेशामा बस्‍नेहरू हो,","poem":1},{"text":"म तिमीहरूका विरुद्धमा एक जना विजेतालाई ल्याउनेछु।","poem":2},{"text":"इस्राएलका प्रतिष्‍ठित अगुवाहरू","poem":1},{"text":"अदुल्‍लाम सहरमा भाग्नेछन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"आफ्ना प्यारा छोराछोरीहरू, जससँग तिमीहरू रमाउँछौ,","poem":1},{"text":"तिनीहरूको शोकमा आफ्नो केश खौर;","poem":2},{"text":"तिमीहरूले आफूलाई तालु खुइले गिद्धजस्तै बनाओ;","poem":1},{"text":"किनकि तिनीहरूलाई तिमीहरूदेखि टाढा निर्वासनमा लगिनेछ।","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"जसको अर्थ हो धुलोको घर","reference":{"chapter":1,"verse":10}},{"noteId":1,"caller":"+","text":"जसको अर्थ हो सुखद","reference":{"chapter":1,"verse":11}}]},"thisChapterLink":"/api/npi_ncb/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}