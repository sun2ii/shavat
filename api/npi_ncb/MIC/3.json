{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"MIC","translationId":"npi_ncb","name":"मीका","commonName":"मीका","title":"मीकाको भविष्यवाणी","order":33,"numberOfChapters":7,"sha256":"ff96d2c8229c42a67bbce43375052fda8a493d4be759cbda5d8b66695ae54674","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/npi_ncb/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["अगुवाहरू र अगमवक्ताहरूलाई हप्की"]},{"type":"verse","number":1,"content":["त्यसपछि मैले भनेँ,",{"text":"“हे याकोबका अगुवाहरू,","poem":1},{"text":"इस्राएलका शासकहरू हो, सुन।","poem":2},{"text":"के तिमीहरूले न्यायलाई मान्‍नुपर्ने होइन र?","poem":1}]},{"type":"verse","number":2,"content":[{"text":"तिमीहरू जसले भलाइलाई घृणा गर्छौ र दुष्‍टतालाई प्रेम गर्छौ;","poem":2},{"text":"जसले मेरा मानिसहरूका छाला काढ्छौ,","poem":1},{"text":"र तिनीहरूका हड्डीहरूबाट मासु लुछेर निकाल्छौ;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिमीहरू जसले मेरा मानिसहरूका मासु खान्छौ,","poem":1},{"text":"तिनीहरूका छाला काढ्छौ,","poem":2},{"lineBreak":true},{"text":"र तिनीहरूका हड्डीहरूलाई चकनाचुर पार्दछौ;","poem":2},{"text":"जसलाई तिमीहरूले भाँडामा हालेर","poem":1},{"text":"पकाउने मासुजस्तै टुक्रा-टुक्रा पार्छौ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"त्यस समय तिनीहरूले याहवेहलाई गुहार्नेछन्,","poem":1},{"text":"तर उहाँले तिनीहरूलाई जवाफ दिनुहुनेछैन।","poem":2},{"text":"त्यस समय उहाँले आफ्नो मुहार तिनीहरूबाट लुकाउनुहुनेछ;","poem":1},{"text":"किनकि तिनीहरूले दुष्‍ट काम गरेका छन्।","poem":2}]},{"type":"verse","number":5,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“ती अगमवक्ताहरू,","poem":1},{"text":"जसले मेरा मानिसहरूलाई कुमार्गमा डोर्‍याउँछन्।","poem":2},{"text":"यदि तिनीहरूले केही खानेकुरा पाए भने,","poem":1},{"text":"तिनीहरूले ‘तिमीहरूलाई शान्ति होस्,’ भनेर घोषणा गर्छन्।","poem":2},{"text":"तर यदि कसैले तिनीहरूलाई खानेकुरा दिएनन् भने,","poem":1},{"text":"तिनीहरू त्यसको विरुद्धमा युद्धको तयारी गर्छन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यसकारण तिमीहरूमाथि दर्शनबिनाको रात,","poem":1},{"text":"र जोखनाबिनाको अन्धकार हुनेछ।","poem":2},{"text":"अगमवक्ताहरूका निम्ति सूर्य अस्ताउनेछ;","poem":1},{"text":"अनि तिनीहरूका निम्ति दिन अन्धकार हुनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"दर्शीहरू लज्जित हुनेछन्,","poem":1},{"text":"र जोखना हेर्नेहरू अपमानित हुनेछन्।","poem":2},{"text":"तिनीहरू सबैले आफ्ना अनुहारहरू ढाक्नेछन्;","poem":1},{"text":"किनकि तिनीहरूले परमेश्‍वरबाट कुनै पनि जवाफ पाउनेछैनन्।”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तर मचाहिँ शक्तिले भरिएको छु,","poem":1},{"text":"म याकोबलाई त्यसको अपराध","poem":2},{"lineBreak":true},{"text":"र इस्राएललाई त्यसको पाप बताइदिन","poem":2},{"text":"याहवेहको आत्माले","poem":1},{"text":"सामर्थ्य र न्यायले भरिएको छु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"हे याकोबका अगुवाहरू,","poem":1},{"text":"र इस्राएलका शासकहरू हो, यो कुरा सुन!","poem":2},{"text":"जसले न्यायलाई घृणा गर्दछौ","poem":1},{"text":"र ठिक कुरालाई बङ्ग्याउँदछौ;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"जसले सियोनलाई रक्तपातले","poem":1},{"text":"र यरूशलेमलाई दुष्‍टताद्वारा निर्माण गर्दछौ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यसका न्यायाधीशहरूले घूसका लागि न्याय गर्छन्;","poem":1},{"text":"त्यसका पुजारीहरूले कमाउनलाई सिकाउँदछन्।","poem":2},{"lineBreak":true},{"text":"अनि त्यसका अगमवक्ताहरूले पैसाको लागि भाग्य बताउँछन्।","poem":2},{"text":"तर पनि तिनीहरूले याहवेहमा दावी गर्छन् र भन्छन्,","poem":1},{"text":"“के याहवेह हाम्रो बीचमा हुनुहुन्‍न र?","poem":2},{"lineBreak":true},{"text":"हामीमाथि कुनै विपत्ति आउनेछैन।”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"यसैकारण तिमीहरूले गर्दा","poem":1},{"text":"सियोन खेतजस्तै जोतिनेछ;","poem":2},{"text":"यरूशलेम भग्नावशेष हुनेछ,","poem":1},{"text":"र मन्दिरको डाँडाचाहिँ झाडीले भरिएको ढिस्कोझैँ हुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}