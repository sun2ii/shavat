{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"MIC","translationId":"npi_ncb","name":"मीका","commonName":"मीका","title":"मीकाको भविष्यवाणी","order":33,"numberOfChapters":7,"sha256":"ff96d2c8229c42a67bbce43375052fda8a493d4be759cbda5d8b66695ae54674","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/npi_ncb/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["याहवेहको पर्वत"]},{"type":"verse","number":1,"content":["अन्तिम दिनहरूमा",{"text":"याहवेहको मन्दिरको पर्वत","poem":1},{"text":"अरू पर्वतहरूमध्ये प्रमुख भएर स्थापित गरिनेछ;","poem":2},{"text":"र पहाडहरूभन्दा माथि उठाइनेछ;","poem":1},{"text":"अनि सबै मानिसहरू त्यसमा ओइरिएर आउनेछन्।","poem":2}]},{"type":"verse","number":2,"content":["धेरै राष्ट्रहरू आएर भन्‍नेछन्,",{"text":"“आओ, हामीहरू याहवेहको पर्वतमा,","poem":1},{"text":"याकोबका परमेश्‍वरको मन्दिरमा जाऔँ।","poem":2},{"text":"उहाँले हामीलाई उहाँका मार्गहरू सिकाउनुहुनेछ,","poem":1},{"text":"ताकि हामी उहाँका मार्गहरूमा हिँड्न सकौँ।”","poem":2},{"text":"व्यवस्था सियोनबाट,","poem":1},{"text":"र याहवेहको वचन यरूशलेमबाट निस्कनेछन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उहाँले धेरै मानिसहरूका बीचमा न्याय गर्नुहुनेछ,","poem":1},{"text":"र टाढाका शक्तिशाली राष्ट्रहरूका वाद-विवाद सुल्झाउनुहुनेछ।","poem":2},{"text":"तिनीहरूले आफ्ना तरवारहरू पिटेर हलोका फालीहरू बनाउनेछन्,","poem":1},{"text":"र भालाहरू पिटेर हँसियाहरू बनाउनेछन्।","poem":2},{"text":"एउटा राष्ट्रले अर्को राष्ट्रको विरुद्धमा तरवार उठाउनेछैन,","poem":1},{"text":"न त तिनीहरूले फेरि कहिल्यै युद्धका निम्ति तालिम दिनेछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हरेक मान्छे आफ्नै दाखको बोटमुनि","poem":1},{"text":"र आफ्नै नेभाराको रूखमुनि बस्‍नेछ;","poem":2},{"text":"अनि कसैले पनि तिनीहरूलाई भयभीत तुल्याउनेछैन;","poem":1},{"text":"किनकि सेनाहरूका याहवेहले बोल्नुभएको छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"सबै राष्ट्रहरू तिनीहरूका","poem":1},{"text":"आफ्नै देवताहरूका नाममा हिँडून्;","poem":2},{"text":"तर हामीचाहिँ याहवेह हाम्रा परमेश्‍वरको","poem":1},{"text":"नाममा सदासर्वदै हिँड्नेछौँ।","poem":2}]},{"type":"heading","content":["याहवेहको योजना"]},{"type":"verse","number":6,"content":[{"text":"याहवेहले घोषणा गर्नुहुन्छ, “त्यस दिन","poem":1},{"text":"म लङ्गडाहरूलाई एकसाथ भेला गर्नेछु;","poem":2},{"text":"म निर्वासितहरूलाई एक ठाउँमा भेला गर्नेछु,","poem":1},{"text":"जसमाथि मैले शोक ल्याएको थिएँ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म लङ्गडालाई मेरो बाँकी भाग बनाउनेछु,","poem":1},{"text":"देश निकाला गरिएकाहरूलाई बलियो राष्ट्र तुल्याउनेछु।","poem":2},{"text":"त्यसपछि याहवेहले सियोन पर्वतमा,","poem":1},{"text":"तिनीहरूमाथि सदासर्वदा राज्य गर्नुहुनेछ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तेरो बारेमा चाहिँ, हे बगालको धरहरा,","poem":1},{"text":"हे सियोनकी छोरीको सुरक्षाको गढ,","poem":2},{"text":"तँलाई फेरि पहिलेको अधिकार फर्काइनेछ;","poem":1},{"text":"त्यो राजपद यरूशलेमकी छोरीकहाँ फेरि आउनेछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"अहिले तँ किन ठूलो सोरले चिच्याउँछेस्,","poem":1},{"text":"के तेरा निम्ति कुनै राजा छैनन्?","poem":2},{"text":"के तेरो शासक नष्‍ट भएको छ?","poem":1},{"text":"के तँ प्रसव-वेदनामा परेकी एउटी स्त्रीजस्तै पीडामा परेकी छेस्?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"हे सियोनकी छोरी यरूशलेम,","poem":1},{"text":"एउटी प्रसव-वेदनामा परेकी स्त्रीजस्तै व्यथामा छटपटा;","poem":2},{"text":"किनकि अब तैँले यो सहर छोड्नुपर्छ,","poem":1},{"text":"र तैँले खुला मैदानमा छाउनी हाल्नुपर्छ।","poem":2},{"text":"तँ बेबिलोनमा जानेछस्;","poem":1},{"text":"त्यहाँ तँलाई छुटकारा दिइनेछ।","poem":2},{"text":"त्यहाँ याहवेहले तँलाई","poem":1},{"text":"तेरा शत्रुहरूका हातबाट उद्धार गर्नुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"तर अहिले धेरै राष्ट्रहरू","poem":1},{"text":"तेरो विरुद्धमा एकसाथ भेला भएका छन्।","poem":2},{"text":"तिनीहरू भन्छन्, “त्यसलाई भ्रष्‍ट पारियोस्","poem":1},{"text":"र हाम्रा आँखाहरूले सियोनको दुर्गतिलाई नियालोस्!”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तर तिनीहरूले याहवेहका","poem":1},{"text":"विचारहरू जान्दैनन्;","poem":2},{"text":"तिनीहरूले उहाँका योजनाहरू बुझ्दैनन्;","poem":1},{"text":"किनकि उहाँले तिनीहरूलाई खलामा बिटाहरूजस्तै जम्मा गर्नुभएको छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“हे सियोनकी छोरी, उठ् र दाइँ गर्;","poem":1},{"text":"किनकि म तँलाई फलामका सिङहरू दिनेछु;","poem":2},{"text":"म तँलाई पित्तलका खुरहरू दिनेछु,","poem":1},{"text":"र तैँले धेरै राष्ट्रहरूलाई चकनाचुर पार्नेछस्।”","poem":2},{"text":"तैँले तिनीहरूका अर्धमले कमाएको सम्पत्ति याहवेहलाई,","poem":1},{"text":"तिनीहरूको धन सारा पृथ्वीका प्रभुलाई समर्पित गर्नेछस्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}