{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"MIC","translationId":"npi_ncb","name":"मीका","commonName":"मीका","title":"मीकाको भविष्यवाणी","order":33,"numberOfChapters":7,"sha256":"ff96d2c8229c42a67bbce43375052fda8a493d4be759cbda5d8b66695ae54674","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/npi_ncb/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["इस्राएलको दुर्गति"]},{"type":"verse","number":1,"content":[{"text":"मलाई कस्तो दुर्गति आइलागेको छ!","poem":1},{"lineBreak":true},{"text":"म दाखबारीमा ग्रीष्म ऋतुको","poem":1},{"text":"फल बटुल्ने मानिसजस्तै छु;","poem":2},{"text":"खानलाई कुनै अङ्‌गुरको झुप्पा नै छैन;","poem":1},{"text":"मैले चाहेको पहिलो नेभाराको फल एउटै पनि छैन।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"धर्मी मानिसहरू देशबाट नष्‍ट भइसकेका छन्;","poem":1},{"text":"धर्मी एउटै पनि बाँकी छैन।","poem":2},{"text":"हरेक मानिस हत्या गर्न ढुकिबस्छन्;","poem":1},{"text":"तिनीहरू एक-अर्कालाई पासो थाप्छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"दुवै हातहरू दुष्‍ट काम गर्न सिपालु छन्;","poem":1},{"text":"शासकहरूले उपहारको माग गर्छन्,","poem":2},{"text":"न्यायकर्ताहरू न्यायालयमा घूस लिन्छन्;","poem":1},{"text":"शक्तिशालीहरू आफूले इच्छा लागेअनुसारको हुकुम चलाउँछन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरू सबै जना मिलेर षड्यन्त्र रच्दछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरूमा सबैभन्दा असल मानिस पनि तीखो काँडाजस्तै छ,","poem":1},{"text":"सबैभन्दा सोझो पनि झाडीको काँडाभन्दा खराब छ।","poem":2},{"text":"परमेश्‍वरले तिमीहरूलाई भेट गर्ने समय आएको छ;","poem":1},{"text":"तिमीहरूका पहरेदारहरूका चेतावनीको आवाज आएको छ।","poem":2},{"lineBreak":true},{"text":"अहिले तिमीहरूको अन्योलको समय हो।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिमीहरू आफ्नो छिमेकीमाथि भरोसा नगर;","poem":1},{"text":"न त मित्रमाथि नै विश्‍वास गर।","poem":2},{"text":"आफ्नो अँगालोमा सुत्ने पत्नीसँग बोल्दासमेत","poem":1},{"text":"होसियार भएर बोल।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"किनकि छोराले आफ्नो बुबालाई अनादर गर्छ,","poem":1},{"text":"छोरी आफ्नै आमाको विरुद्धमा उठ्छे;","poem":2},{"text":"बुहारी आफ्नै सासूको विरुद्धमा—","poem":1},{"text":"मानिसका शत्रुहरू आफ्नै घरका सदस्यहरू हुन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"तर मचाहिँ याहवेहमा आशा लिएर प्रतीक्षा गर्छु;","poem":1},{"text":"म मेरो उद्धारकर्ता परमेश्‍वरलाई पर्खन्छु;","poem":2},{"lineBreak":true},{"text":"मेरा परमेश्‍वरले मेरो बिन्ती सुन्‍नुहुनेछ।","poem":2}]},{"type":"heading","content":["इस्राएल फेरि उठ्नेछ"]},{"type":"verse","number":8,"content":[{"text":"हे मेरो शत्रु, मेरो खिसी नगर्!","poem":1},{"text":"म लडेको छु, तर पनि म खडा हुनेछु।","poem":2},{"text":"म अन्धकारमा छु,","poem":1},{"text":"तर पनि याहवेह मेरा निम्ति ज्योति हुनुहुनेछ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"किनकि मैले उहाँको विरुद्धमा पाप गरेको छु,","poem":1},{"text":"जबसम्म उहाँले मेरा निम्ति मुद्दा लड्नुहुन्‍न,","poem":2},{"text":"र मेरो अधिकार स्थापित गर्नुहुन्‍न,","poem":1},{"text":"तबसम्म म याहवेहको क्रोधलाई सहनेछु।","poem":2},{"text":"उहाँले मलाई निकालेर ज्योतिमा ल्याउनुहुनेछ;","poem":1},{"text":"म उहाँको धार्मिकतालाई हेर्नेछु।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"त्यसपछि मेरा शत्रुले यो देख्नेछन्,","poem":1},{"text":"र तिनीहरू लज्जित हुनेछन्,","poem":2},{"text":"जसले मलाई यसो भनेकी थिई,","poem":1},{"text":"“याहवेह तेरो परमेश्‍वर कहाँ छन्?”","poem":2},{"text":"मेरो आँखाले त्यसको पतन देख्नेछ;","poem":1},{"text":"अहिले पनि त्यो गल्‍लीहरूमा","poem":2},{"lineBreak":true},{"text":"हिलोजस्तै खुट्टामुनि कुल्चिइन्छे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"तिमीहरूका पर्खालहरू निर्माण गर्ने दिन,","poem":1},{"text":"तिमीहरूका सिमानाहरू बढाउने दिन आउनेछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्यस दिन मानिसहरू तिमीहरूकहाँ आउनेछन्;","poem":1},{"text":"अश्शूर र इजिप्टका सहरहरूबाट","poem":2},{"text":"इजिप्टदेखि लिएर यूफ्रेटिस नदिसम्मका","poem":1},{"text":"र टाढा-टाढाका समुद्रदेखि लिएर","poem":2},{"lineBreak":true},{"text":"टाढा-टाढाका पर्वतसम्मका मानिसहरू तिमीहरूकहाँ आउनेछन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तिमीहरूका बासिन्दाहरूका दुष्‍ट कामहरूका","poem":1},{"text":"परिणामको कारणले गर्दा पृथ्वी उजाड हुनेछ।","poem":2}]},{"type":"heading","content":["प्रार्थना र प्रशंसा"]},{"type":"verse","number":14,"content":[{"text":"तपाईंका प्रजाहरूलाई आफ्नो लहुरो लिएर चराउनुहोस्;","poem":1},{"text":"तपाईंको उत्तराधिकारका भेडाका बगाललाई चराउनुहोस्,","poem":2},{"text":"जो एकलै वनमा,","poem":1},{"text":"कार्मेल पर्वतको मलिलो खर्कमा बस्छन्।","poem":2},{"text":"तिनीहरूलाई पहिलेका दिनहरूमा जस्तै","poem":1},{"text":"बाशान र गिलादमा गएर चर्न दिनुहोस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“तिमीहरू इजिप्टबाट निस्केर आएका दिनहरूमा जस्तै","poem":1},{"text":"म तिनीहरूलाई मेरा अद्‌भुत कार्यहरू देखाउनेछु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"राष्ट्रहरूले देख्नेछन् र लज्जित हुनेछन्।","poem":1},{"text":"तिनीहरूका पूरै शक्ति काम नलाग्ने हुनेछन्।","poem":2},{"text":"तिनीहरूका हातहरूले आफ्ना मुख छोप्नेछन्,","poem":1},{"text":"र तिनीहरूका कानहरू बहिरा हुनेछन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तिनीहरूले सर्पले जस्तै","poem":1},{"text":"र जमिनमा घस्रने प्राणीहरूले जस्तै धुलो चाट्नेछन्।","poem":2},{"text":"तिनीहरू थरथर काम्दै आफ्ना गुफाहरूबाट निस्केर आउनेछन्;","poem":1},{"text":"तिनीहरू याहवेह हाम्रा परमेश्‍वरकहाँ डरसहित फर्कनेछन्,","poem":2},{"lineBreak":true},{"text":"र तिनीहरू उहाँसँग डराउनेछन्।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तपाईंजस्तो परमेश्‍वर को छ र?","poem":1},{"text":"जसले उहाँका उत्तराधिकारका बाँकी रहेकाहरूको पाप क्षमा गर्नुहुन्छ,","poem":2},{"lineBreak":true},{"text":"र अपराधहरू बिर्सिदिनुहुन्छ।","poem":2},{"text":"तपाईं सधैँभरि रिसाइरहनुहुन्‍न,","poem":1},{"text":"तर अटुट प्रेम देखाउनमा प्रसन्‍न हुनुहुन्छ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तपाईंले हामीमाथि फेरि दया देखाउनुहुनेछ;","poem":1},{"text":"हाम्रा पापहरूलाई तपाईंले खुट्टामुनि कुल्चनुहुनेछ;","poem":2},{"lineBreak":true},{"text":"अनि हाम्रा सबै अधर्महरू समुद्रको गहिराइमा फालिदिनुहुनेछ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"जसरी तपाईंले धेरै अगिका दिनहरूमा","poem":1},{"text":"हाम्रा पुर्खाहरूसँग शपथ खाएर प्रतिज्ञा गर्नुभएको थियो,","poem":2},{"text":"त्यसरी नै तपाईं याकोबप्रति विश्‍वासयोग्य रहनुहुनेछ,","poem":1},{"text":"र अब्राहामलाई अचुक प्रेम देखाउनुहुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}