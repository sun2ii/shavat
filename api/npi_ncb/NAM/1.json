{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"NAM","translationId":"npi_ncb","name":"नहूम","commonName":"नहूम","title":"नहूमको भविष्यवाणी","order":34,"numberOfChapters":3,"sha256":"13ab9e7829925a616644e26df9900d1cd6c63a7c46837ab63ef4ce4712637000","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/npi_ncb/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["निनवे सहरको विषयमा अगमवाणी। एल्कोशवासी नहूमले देखेका दर्शनको पुस्तक।"]},{"type":"line_break"},{"type":"heading","content":["निनवेको विरुद्धमा याहवेहको क्रोध"]},{"type":"verse","number":2,"content":[{"text":"याहवेह डाही र बदला लिने परमेश्‍वर हुनुहुन्छ;","poem":1},{"text":"याहवेहले बदला लिनुहुन्छ र क्रोधले भरिनुहुन्छ।","poem":2},{"text":"याहवेहले आफ्ना शत्रुहरूलाई बदला लिनुहुन्छ,","poem":1},{"text":"र उहाँले आफ्ना शत्रुहरू विरुद्ध क्रोध साँचेर राख्नुहुन्छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"याहवेह रिस गर्नमा धीरजी, तर पराक्रममा महान् हुनुहुन्छ।","poem":1},{"text":"याहवेहले दोषीलाई दण्ड नदिई छोड्नुहुन्‍न।","poem":2},{"text":"उहाँको मार्ग भुमरी र आँधीमा छ;","poem":1},{"text":"अनि बादलहरू उहाँका पाउको धुलो हुन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उहाँले समुद्रलाई हप्काउनुहुन्छ र त्यसलाई सुकाइदिनुहुन्छ;","poem":1},{"text":"उहाँले सबै नदीहरूलाई सुक्खा पारिदिनुहुन्छ।","poem":2},{"text":"बाशान र कर्मेलका खर्कहरू उजाड हुन्छन्,","poem":1},{"text":"र लेबनानका फूलहरू ओइलिन्छन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उहाँको सामु पर्वतहरू काँप्छन्","poem":1},{"text":"र पहाडहरू पग्लिएर जान्छन्।","poem":2},{"text":"उहाँको उपस्थितिमा पृथ्वी,","poem":1},{"text":"संसार र त्यसमा भएका सबै कुरा डरले थरथर काँप्छन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"उहाँको बल्दो रिसको सामु को उभिन सक्छ र?","poem":1},{"text":"उहाँको भयङ्कर क्रोध कसले सहन सक्छ?","poem":2},{"text":"उहाँको क्रोध आगोझैँ खन्याइन्छ;","poem":1},{"text":"उहाँको सामु चट्टानहरू फुटेर चकनाचुर हुन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेह भलो हुनुहुन्छ,","poem":1},{"text":"दुःखको समयमा एक शरणस्थान।","poem":2},{"text":"उहाँमाथि भरोसा गर्नेहरूलाई उहाँले वास्ता गर्नुहुन्छ,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"तर उहाँले उर्लंदो बाढीले","poem":2},{"text":"निनवे सहरको अन्त्य गरिदिनुहुनेछ;","poem":1},{"text":"उहाँले आफ्ना शत्रुहरूलाई अन्धकारमा खेद्नुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"तिनीहरूले याहवेहका विरुद्धमा जस्तोसुकै षड्यन्त्र रचे तापनि","poem":1},{"text":"उहाँले त्यसको अन्त्य गरिदिनुहुनेछ;","poem":2},{"lineBreak":true},{"text":"सङ्कष्‍ट दोस्रोपल्ट फेरि आउनेछैन।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिनीहरू काँडाघारीभित्र अल्झिनेछन्,","poem":1},{"text":"र तिनीहरूका दाखमद्यले मात्तिनेछन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरू सुकेका ठोसाझैँ भस्म हुनेछन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हे निनवे, तँबाट याहवेहका विरुद्धमा दुष्‍ट युक्ति रच्ने,","poem":1},{"text":"र खराब सल्‍लाह दिने","poem":2},{"lineBreak":true},{"text":"एक जना निस्केर आएको छ।","poem":2}]},{"type":"verse","number":12,"content":["याहवेह यसो भन्‍नुहुन्छ:",{"text":"“तिनीहरू अनगन्ती र धेरै मित्रराष्ट्रहरूका साथ भए तापनि","poem":1},{"text":"तिनीहरू नष्‍ट हुनेछन् र मरेर जानेछन्।","poem":2},{"text":"हे यहूदा, मैले तँलाई कष्‍ट दिए तापनि","poem":1},{"text":"अब उसो म तँलाई फेरि कष्‍ट दिनेछैनँ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"अब म तिनीहरूको जुवा तेरो काँधबाट भाँचिदिनेछु,","poem":1},{"text":"र तेरा साङ्लाका बन्धनहरू चुँडाइदिनेछु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"हे निनवे, याहवेहले तेरो बारेमा एउटा आज्ञा दिनुभएको छ;","poem":1},{"text":"“तेरो वंश थाम्नलाई तेरो कोही सन्तान हुनेछैन।","poem":2},{"text":"म तेरा देवताहरूका मन्दिरमा भएका","poem":1},{"text":"तेरा प्रतिमा र मूर्तिहरूलाई नष्‍ट पार्नेछु।","poem":2},{"text":"म तेरो चिहान तयार पार्नेछु,","poem":1},{"text":"किनकि तँ दुष्‍ट छस्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"हेर, पर्वतहरूमाथि सुसमाचार ल्याउने","poem":1},{"text":"एउटा मानिसका पाउहरू,","poem":2},{"lineBreak":true},{"text":"जसले शान्तिको प्रचार गर्दछ!","poem":2},{"text":"हे यहूदा, तेरा चाडहरू मना,","poem":1},{"text":"र आफ्ना भाकलहरू पूरा गर्।","poem":2},{"text":"दुष्‍टहरूले तँलाई फेरि कहिल्यै आक्रमण गर्नेछैनन्;","poem":1},{"text":"तिनीहरू पूर्ण रूपमा सर्वनाश हुनेछन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}