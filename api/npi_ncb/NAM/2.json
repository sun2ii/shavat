{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"NAM","translationId":"npi_ncb","name":"नहूम","commonName":"नहूम","title":"नहूमको भविष्यवाणी","order":34,"numberOfChapters":3,"sha256":"13ab9e7829925a616644e26df9900d1cd6c63a7c46837ab63ef4ce4712637000","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/npi_ncb/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["निनवेको पतन"]},{"type":"verse","number":1,"content":[{"text":"हे निनवे, तेरो विरुद्धमा एक जना आक्रमणकारी आउँदैछ।","poem":1},{"text":"किल्‍लाको रक्षा गर्,","poem":2},{"lineBreak":true},{"text":"बाटोमा पहरा दे,","poem":2},{"lineBreak":true},{"text":"आफ्नो कम्मर कस्,","poem":2},{"lineBreak":true},{"text":"र आफ्नो पूरा शक्ति लगाएर लडाइँको तयारी गर्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"याहवेहले याकोबको वैभवलाई","poem":1},{"text":"इस्राएलको वैभवलाई झैँ पुनर्स्थापित गर्नुहुनेछ।","poem":2},{"text":"यद्यपि विनाशकारीहरूले तिनीहरूलाई उजाड पारेका छन्,","poem":1},{"text":"र दाखका हाँगाहरूलाई नष्‍ट गरिदिएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"त्यसका सेनाहरूका ढालहरू राता-राता छन्;","poem":1},{"text":"त्यसका वीर योद्धाहरूले रातो रङ्गका पोशाकहरू पहिरेका छन्।","poem":2},{"text":"लडाइँको तयारीको दिनमा","poem":1},{"text":"रथका धातुहरू चम्कन्छन्;","poem":2},{"lineBreak":true},{"text":"देवदारुको काठका भालाहरू नचाउँछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यसका रथहरू सडकहरूमा वेगसँग दौडिन्छन्;","poem":1},{"text":"ती चोकको बीचबाट यता र उता दौडिरहन्छन्।","poem":2},{"text":"तिनीहरू बलिरहेको राँकोजस्तै देखिन्छन्;","poem":1},{"text":"तिनीहरू बिजुली चम्केझैँ वेगले दौडन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"निनवेले आफ्ना चुनिएका सेनाहरूलाई बोलाउँछ,","poem":1},{"text":"तर पनि तिनीहरू आफ्नो बाटोमा ठक्‍कर खाएर लड्छन्।","poem":2},{"text":"तिनीहरू सहरका पर्खालतिर ठोकिन्छन्;","poem":1},{"text":"रक्षा गर्ने ढाल ठिक ठाउँमा राखिन्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"नदीका मूलढोकाहरू खोलिन्छन्,","poem":1},{"text":"र राजदरबार ढल्छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यस्तो फैसला भएको छ,","poem":1},{"text":"त्यो निनवेलाई कैद गरी लगिनेछ।","poem":2},{"text":"त्यसका सेविकाहरू ढुकुरहरूझैँ विलाप गर्छन्,","poem":1},{"text":"र आ-आफ्ना छाती पिट्छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"निनवे एउटा पोखरीजस्तै छ,","poem":1},{"text":"जसको पानी सुकेर गइरहेको छ।","poem":2},{"text":"“पर्ख! पर्ख!” भन्दै तिनीहरू कराउँछन्,","poem":1},{"text":"तर कोही पनि पछि फर्केर हेर्दैनन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"चाँदी लुट!","poem":1},{"text":"सुन लुट!","poem":2},{"text":"त्यसका सबै प्रकारका बहुमूल्य खजानाहरूले,","poem":1},{"text":"त्यसको भण्डार असीमित छ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"त्यो उजाड भएकी छे, लुटिएकी छे, निर्वस्त्र पारिएकी छे!","poem":1},{"text":"अनि हृदयहरू पग्लन्छन्, घुँडाहरू काँप्दछन्,","poem":2},{"lineBreak":true},{"text":"शरीरहरू काँप्छन् र प्रत्येक अनुहार डरले पहेँलो हुन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"अहिले सिंहको गुफा कहाँ छ,","poem":1},{"text":"जहाँ सिंह र सिंहनीले आफ्ना डमरुहरूलाई खुवाउँथे,","poem":2},{"text":"जहाँ सिंह, सिंहनी,","poem":1},{"text":"र डमरुहरू समेत नडराई हिँड्दथे।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जहाँ सिंहले आफ्ना डमरुहरूका निम्ति प्रशस्त शिकार गर्थ्यो,","poem":1},{"text":"र सिंहनीको निम्ति शिकारको घाँटी निमोठ्थ्यो;","poem":2},{"text":"त्यसले आफ्ना गुफाहरू शिकार गरेका पशुहरूले","poem":1},{"text":"र आफ्ना ओडारहरू शिकारहरूको मासुले भरिराख्थ्यो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“हेर्, म तेरो विरुद्धमा छु,”","poem":1},{"text":"सेनाहरूका याहवेह भन्‍नुहुन्छ।","poem":2},{"text":"“म तेरा रथहरू जलाएर धुवाँमा उडाइदिनेछु,","poem":1},{"text":"अनि तरवारले तेरा जवान सिंहहरूलाई खाइदिनेछ।","poem":2},{"lineBreak":true},{"text":"मैले तेरो निम्ति पृथ्वीमा केही पनि शिकार छोड्नेछैन।","poem":2},{"text":"तेरा राजदूतहरूको सोर","poem":1},{"text":"अब उसो सुनिनेछैन।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}