{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"NAM","translationId":"npi_ncb","name":"नहूम","commonName":"नहूम","title":"नहूमको भविष्यवाणी","order":34,"numberOfChapters":3,"sha256":"13ab9e7829925a616644e26df9900d1cd6c63a7c46837ab63ef4ce4712637000","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/npi_ncb/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["निनवेलाई धिक्‍कार"]},{"type":"verse","number":1,"content":[{"text":"रक्तपातले भरिएको सहरलाई धिक्‍कार!","poem":1},{"text":"जो झूटले भरिएको छ,","poem":2},{"text":"र लुटपाटका धनले भरिएको छ।","poem":1},{"text":"जो पीडितबाट कहिल्यै मुक्त छैन!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"कोर्राहरूको आवाज,","poem":1},{"text":"चक्‍काहरूको गडगडाहट,","poem":2},{"text":"घोडाहरूको दौड","poem":1},{"text":"र रथहरू थर्केका आवाज!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"युद्धका घोडचढीहरूको हमला,","poem":1},{"text":"चम्किला तरवारहरू","poem":2},{"lineBreak":true},{"text":"र टल्किने भालाहरू!","poem":2},{"text":"मारिएका धेरै-धेरै छन्;","poem":1},{"text":"लासहरूका रासमाथि रास,","poem":2},{"text":"अनगन्ती मृत शरीरहरू,","poem":1},{"text":"मानिसहरू लासहरूमा ठेस खाँदै हिँड्छन्—","poem":2}]},{"type":"verse","number":4,"content":[{"text":"यी सबै त्यस वेश्याको कामुकताको कारणले गर्दा हो;","poem":1},{"text":"त्यो टुनामुनाद्वारा लोभ्याउने मालिक्नी हो,","poem":2},{"text":"जसले आफ्नो वेश्यावृत्तिद्वारा राष्ट्रहरूलाई","poem":1},{"text":"र आफ्नो तन्त्रमन्त्रले जातिहरूलाई दास बनाउँथी।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“म तेरो विरुद्धमा छु,” सेनाहरूका याहवेह भन्‍नुहुन्छ।","poem":1},{"text":"“मुखैसम्म म तेरा फरिया उचाल्नेछु।","poem":2},{"text":"म तेरो नाङ्गोपना राष्ट्रहरूलाई","poem":1},{"text":"र तेरो लाज राज्यहरूलाई देखाउनेछु।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"म तँलाई घिनलाग्दो फोहोरले ढाक्नेछु,","poem":1},{"text":"म तँलाई घृणित व्यवहार गर्नेछु,","poem":2},{"lineBreak":true},{"text":"र तँलाई मानिसहरूका सामु तमाशा ठहराउनेछु।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तँलाई देख्नेहरू सबै तँबाट तर्केर भाग्नेछन्, र भन्‍नेछन्,","poem":1},{"text":"‘निनवे ध्वस्त भएको छ। त्यसका निम्ति कसले विलौना गर्ला?’","poem":2},{"lineBreak":true},{"text":"तँलाई सान्त्वना दिने व्यक्ति मैले कहाँ भेट्टाउँला?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"के तँ नील नदीका किनारामा अवस्थित","poem":1},{"text":"चारैपट्टि पानीले घेरिएको","poem":2},{"lineBreak":true},{"text":"इजिप्टको राजधानी थेबेसभन्दा असल छस्?","poem":2},{"text":"त्यसको सुरक्षा नील नदी थियो;","poem":1},{"text":"अनि पानी सहरको पर्खालजस्तै थियो।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"कूश र इजिप्ट त्यसको असीम शक्ति थिए;","poem":1},{"text":"पूत र लिबिया त्यसका मित्र राष्ट्रहरू थिए।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तापनि त्यसलाई कैदमा लगियो,","poem":1},{"text":"र त्यो निर्वासनमा गयो।","poem":2},{"text":"त्यसका स-साना बालबच्‍चाहरू","poem":1},{"text":"सडकका कुना-कुनामा पछारी-पछारी मारिए।","poem":2},{"text":"त्यसका अगुवाहरूमाथि चिट्ठा हालियो,","poem":1},{"text":"र त्यसका सबै अगुवाहरूलाई साङ्लाहरूले बाँधिए।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तँ निनवे पनि मात्तिनेछेस्;","poem":1},{"text":"तँ लुकेर भाग्नेछस्,","poem":2},{"lineBreak":true},{"text":"र शत्रुहरूबाट बच्न शरण खोजी गर्नेछस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"तेरा सबै बलिया किल्‍लाहरू नेभाराका रूखहरूजस्तै,","poem":1},{"text":"पाकेका पहिलो फलले भरिएका छन्;","poem":2},{"text":"जब ती बोटहरूलाई हल्‍लाइन्छ,","poem":1},{"text":"तब ती नेभाराहरू खानेहरूका मुखैमा झर्दछन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तेरा सेनाका दलहरूलाई हेर्,","poem":1},{"text":"ती सबै बेसहारा स्त्रीहरूजस्ता मात्र छन्!","poem":2},{"text":"तेरा देशका मूलढोकाहरू","poem":1},{"text":"तेरा शत्रुहरूका निम्ति उदाङ्गै खोलिएका छन्;","poem":2},{"lineBreak":true},{"text":"तिनका गजबारहरू आगोले भस्म पारेको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"शत्रुको घेराबन्दीमा पर्नुअगि आफ्ना निम्ति पानी भरेर राख्;","poem":1},{"text":"आफ्ना प्रतिरक्षालाई बलियो पार्!","poem":2},{"text":"माटो मुछेर तयार गर्;","poem":1},{"text":"हिलो माटोलाई कुल्चीमिल्ची पार्,","poem":2},{"lineBreak":true},{"text":"र इँटाको साँचाहरू मर्मत गर्!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"त्यहाँ तँलाई आगोले जलाएर भस्म पार्नेछ;","poem":1},{"text":"तरवारले तँलाई टुक्रा-टुक्रा पार्नेछ;","poem":2},{"lineBreak":true},{"text":"तिनीहरूले तँलाई सलहले जस्तै स्वाहा पार्नेछन्।","poem":2},{"text":"फट्याङ्ग्राले जस्तो आफ्नो संख्या बढा;","poem":1},{"text":"सलहले जस्तै आफ्नो अनगन्ती संख्या बढा!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तैँले आफ्ना व्यापारीहरूको संख्या","poem":1},{"text":"आकाशका अनगन्ती ताराहरू जत्तिकै बढाएको छस्;","poem":2},{"text":"तर सलहले झैँ तिनीहरूले देशलाई नाङ्गो पार्छन्,","poem":1},{"text":"र त्यसपछि तिनीहरू उडेर जान्छन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तेरा पहरेदारहरू सलहहरूजस्ता छन्,","poem":1},{"text":"तेरा अधिकारीहरू सलहहरूका बथानजस्ता छन्,","poem":2},{"lineBreak":true},{"text":"जो जाडोमा भित्ताहरूमा टाँसिएर बस्छन्;","poem":2},{"text":"तर जब घाम उदाउँछ, तिनीहरू उडेर टाढा जान्छन्,","poem":1},{"text":"र ती कहाँ जान्छन्, सो कसैले जान्दैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"हे अश्शूरको राजा, तेरा गोठालाहरू निदाउँछन्;","poem":1},{"text":"तेरा भारदारहरू आराम गर्नलाई ढल्किन्छन्।","poem":2},{"text":"तेरा मानिसहरू पर्वतहरूहुँदो छरपस्ट छन्।","poem":1},{"text":"तिनीहरूलाई एकसाथ जम्मा गर्ने कोही पनि छैन।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"कुनै पनि कुराले तँलाई निको पार्न सक्दैन;","poem":1},{"text":"तेरो चोट प्राणघातक छ।","poem":2},{"text":"जसले तेरो बारेमा सुन्छन्,","poem":1},{"text":"तेरो पतनमा आफ्नो हातले ताली बजाउँछन्;","poem":2},{"text":"किनकि तेरो कहिल्यै अन्त्य नहुने","poem":1},{"text":"क्रूरता कसले भोगेको छैन र?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}