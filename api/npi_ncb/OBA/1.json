{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"OBA","translationId":"npi_ncb","name":"ओबदिया","commonName":"ओबदिया","title":"ओबदियाको भविष्यवाणी","order":31,"numberOfChapters":1,"sha256":"c8cee9365c5667a1050346b1b31f7d8fa1880850dc3a090249d750528da18852","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/npi_ncb/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"heading","content":["ओबदियाको दर्शन"]},{"type":"verse","number":1,"content":["ओबदियाले देखेको दर्शन।",{"lineBreak":true},{"lineBreak":true},"प्रभु याहवेहले एदोमको बारेमा यसो भन्‍नुहुन्छ—",{"text":"हामीले याहवेहबाट एउटा सन्देश सुनेका छौँ:","poem":1},{"text":"एउटा राजदूतलाई राष्ट्रहरूकहाँ यसो भन्‍न पठाइएको थियो,","poem":2},{"text":"“उठ, हामी त्यसको विरुद्धमा लडाइँ गर्नलाई जाऔँ।”","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“हेर्, म तँलाई अरू राष्ट्रहरूका बीचमा सानो तुल्याउनेछु;","poem":1},{"text":"तँलाई ज्यादै घृणा गरिनेछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तेरो हृदयको अहङ्कारले तँलाई धोका दिएको छ।","poem":1},{"text":"तँ चट्टानका धाँदाहरूमा बास बस्छस्,","poem":2},{"lineBreak":true},{"text":"र आफ्ना घर अल्गा-अल्गा स्थानहरूमा बनाउँछस्।","poem":2},{"text":"तैँले मनमनै आफूलाई भन्छस्,","poem":1},{"text":"‘मलाई भुइँमा कसले झार्न सक्छ?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तँ चीलझैँ माथि उडेर गइस् भने पनि,","poem":1},{"text":"र ताराहरूका बीचमा आफ्नो गुँड बनाइस् भने पनि,","poem":2},{"lineBreak":true},{"text":"त्यहाँबाट म तँलाई तल झार्नेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“यदि चोरहरू तँकहाँ आए भने,","poem":1},{"text":"यदि रातमा डाँकुहरू आए भने,","poem":2},{"text":"ओह! तँलाई कस्तो विपत्तिले पर्खिरहेको हुन्छ—","poem":1},{"text":"के तिनीहरूले आफूलाई चाहिए जति मात्र चोर्दैनन् र?","poem":2},{"text":"यदि अङ्‌गुर टिप्नेहरू तँकहाँ आए भने,","poem":1},{"text":"के तिनीहरूले सिला-अङ्‌गुरहरू छोड्दैनन् र?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तर एसाव कसरी लुटिनेछ,","poem":1},{"text":"त्यसका लुकाएर राखिएका गाडधनहरू कसरी लुटिनेछ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तेरा सबै मित्र राष्ट्रहरूले तँलाई सिमानासम्म नै खेद्नेछन्;","poem":1},{"text":"तेरा साथीहरूले तँलाई धोका दिनेछन्, र तँलाई अधीनमा पार्नेछन्;","poem":2},{"text":"जसले तेरो रोटी खान्छन्, उनीहरूले नै तेरो निम्ति पासो थाप्नेछन्;","poem":1},{"text":"तर तैँले यस कुराको बारेमा थाहै पाउनेछैनस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“त्यस दिन,” याहवेह घोषणा गर्नुहुन्छ,","poem":1},{"text":"“के म एदोमका ज्ञानी मानिसहरूलाई,","poem":2},{"lineBreak":true},{"text":"एसावका पर्वतहरूमा बस्‍ने समझदार मानिसहरूलाई नाश पार्नेछैनँ र?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे तेमान, तेरा वीर योद्धाहरू भयभीत हुनेछन्,","poem":1},{"text":"र एसावका पर्वतहरूमा रहने","poem":2},{"lineBreak":true},{"text":"सबै मानिसहरू काटेर ढालिनेछन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तेरो भाइ याकोबको विरुद्धमा भएको","poem":1},{"text":"हिंसाको कारणले गर्दा तँलाई शर्मले ढाक्नेछ;","poem":2},{"lineBreak":true},{"text":"तँ सदाको निम्ति नष्‍ट पारिनेछस्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"जुन दिन तँ टाढै उभिएर हेरिरहेको थिइस्,","poem":1},{"text":"त्यसै बेला विदेशीहरू त्यसको ढोकाभित्र पसे;","poem":2},{"text":"अनि विदेशीहरूले त्यसका धनसम्पत्तिहरू खोसेर लगे","poem":1},{"text":"र यरूशलेमको निम्ति चिट्ठा हाले;","poem":2},{"lineBreak":true},{"text":"त्यस दिन तँ पनि तिनीहरूमध्ये एउटाजस्तै थिइस्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तैँले आफ्नो भाइलाई","poem":1},{"text":"त्यसको दुर्दशाको समयमा तुच्छ ठान्‍नु हुँदैनथ्यो;","poem":2},{"text":"यहूदाका मानिसहरूका","poem":1},{"text":"सर्वनाशको दिनमा रमाउनु हुँदैनथ्यो,","poem":2},{"text":"र तिनीहरूका सङ्कष्‍टको दिनमा","poem":1},{"text":"यति धेरै घमण्ड गर्नु हुँदैनथ्यो।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तिनीहरूको विपत्तिको दिनमा","poem":1},{"text":"मेरा मानिसहरूका ढोकाहरूबाट पसेर तैँले खुशी मनाउनु हुँदैनथ्यो;","poem":2},{"text":"अनि तिनीहरूको सर्वनाशको दिनमा","poem":1},{"text":"तिनीहरूको दुर्दशामा तिनीहरूको अवहेलना गर्नु हुँदैनथ्यो,","poem":2},{"text":"न त तिनीहरूका सर्वनाशको दिनमा","poem":1},{"text":"तिनीहरूको धनसम्पत्ति खोसेर लैजानुहुन्थ्यो।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तैँले तिनीहरूका भाग्नेहरूलाई काटेर ढाल्न","poem":1},{"text":"चौबाटोमा ढुकेर बसिरहनु हुँदैनथ्यो,","poem":2},{"text":"न त तिनीहरूका सङ्कटको दिनमा","poem":1},{"text":"तिनीहरूका बाँचेकाहरूलाई पक्राइदिनु नै हुन्थ्यो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“याहवेहको दिन","poem":1},{"text":"सबै राष्ट्रहरूका निम्ति नजिकै आइपुगेको छ।","poem":2},{"text":"तैँले जस्तो गरेको छस्, तँलाई पनि त्यस्तै गरिनेछ;","poem":1},{"text":"तैँले गरेको कामको प्रतिफल तेरो आफ्नै शिरमाथि फर्केर आउनेछ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"जसरी यहूदाका मानिसहरूले मेरो पवित्र पर्वतमा तितो कचौरा पिए,","poem":1},{"text":"त्यसरी नै सबै राष्ट्रहरूले तितो कचौरा पिइरहनेछन्।","poem":2},{"text":"तिनीहरूले निरन्तर पिउनेछन्, र पिइरहनेछन्;","poem":1},{"text":"अनि तिनीहरू कहिल्यै नभएझैँ गरेर लोप हुनेछन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तर सियोनको पर्वतमा छुटकारा हुनेछ;","poem":1},{"text":"यो पवित्र रहनेछ,","poem":2},{"lineBreak":true},{"text":"र याकोबले आफ्नै सम्पत्तिमाथि अधिकार गर्नेछ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"याकोबको घराना आगोजस्तै हुनेछ,","poem":1},{"text":"र योसेफको घराना ज्वालाजस्तै हुनेछ;","poem":2},{"text":"एसावको घराना डाँठको ठोसाजस्तै हुनेछ;","poem":1},{"text":"अनि तिनीहरूले यसमा आगो लगाउनेछन्, र यसलाई भस्म पार्नेछन्।","poem":2},{"text":"एसावको घरानाबाट","poem":1},{"text":"एउटै पनि जीवित रहनेछैन।”","poem":2},{"text":"याहवेहले यसो भन्‍नुभएको छ।","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"दक्षिणका मानिसहरूले","poem":1},{"text":"एसावका पर्वतहरू कब्जा गर्नेछन्,","poem":2},{"text":"र पहाडको फेदीमा बसेका मानिसहरूले","poem":1},{"text":"पलिश्तीहरूका देशलाई अधिकार गर्नेछन्।","poem":2},{"text":"तिनीहरूले एफ्राइम र सामरियाका भूमिहरू कब्जा गर्नेछन्;","poem":1},{"text":"अनि बेन्यामीनले गिलादमाथि अधिकार गर्नेछ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"कैदमा रहेका इस्राएली दल, जो कनानमा छन्,","poem":1},{"text":"तिनीहरूले सारपतसम्मको भूमिमाथि अधिकार गर्नेछन्;","poem":2},{"text":"यरूशलेमबाट लगिएका निर्वासितहरू, जो सपारादमा छन्,","poem":1},{"text":"तिनीहरूले दक्षिणका सहरहरूमाथि अधिकार गर्नेछन्।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"छुटकारा दिनेहरू सियोन पर्वतमाथि जानेछन्","poem":1},{"text":"र एसावका पर्वतहरूमाथि शासन गर्नेछन्।","poem":2},{"lineBreak":true},{"text":"अनि राज्य याहवेहको हुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}