{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PRO","translationId":"npi_ncb","name":"हितोपदेश","commonName":"हितोपदेश","title":"हितोपदेशको पुस्तक","order":20,"numberOfChapters":31,"sha256":"9767e7e75f15aa9070c707826e3b29a54b0552e170bbc5d89edcd97b1d0a1338","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/npi_ncb/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["सोलोमनका हितोपदेश:",{"text":"बुद्धिमान् छोराछोरीले आफ्ना बुबालाई खुशी तुल्याउँछन्,","poem":1},{"text":"तर मूर्ख छोराछोरीले आफ्नी आमालाई पिरोल्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"अन्यायसँग कमाएको धन केही मूल्यको हुँदैन,","poem":1},{"text":"तर धार्मिकताले मृत्युबाट छुटाउँछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेहले धर्मीहरूलाई भोकै राख्नुहुन्‍न;","poem":1},{"text":"तर उहाँले दुष्‍टको लालसालाई विफल पार्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"अल्छी हातहरूले मानिसलाई गरिब बनाउँछन्,","poem":1},{"text":"तर परिश्रमी हातहरूले सम्पत्ति आर्जन गर्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ग्रीष्म ऋतुमा अन्‍नको प्रबन्ध गर्ने छोराछोरी बुद्धिमान् हुन्;","poem":1},{"text":"तर कटनीको समयमा सुत्ने छोराछोरी शर्म लाग्दा हुन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"धर्मीको शिरमाथि आशिष्‌हरूका मुकुट रहन्छन्,","poem":1},{"text":"तर दुष्‍ट मानिसको मुखमा हिंसा लुकेको हुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"धर्मीको नाम आशिष्‌मा","poem":1},{"noteId":5},{"text":"प्रयोग गरिन्छ,","poem":1},{"text":"तर दुष्‍टको नामचाहिँ कुहिएर जानेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हृदयमा बुद्धिमान् हुनेहरूले आज्ञाहरू ग्रहण गर्छन्,","poem":1},{"text":"तर बकबके मूर्खको विनाश हुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"इमानदार मानिस निर्धक्‍क भई जिउँछ;","poem":1},{"text":"तर टेढो मार्गमा हिँड्ने पक्राउ पर्नेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"कपटपूर्ण आँखा झिम्काउनेले शोक ल्याउँछ;","poem":1},{"text":"अनि बकबक गर्ने मूर्ख सर्वनाशमा पुग्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"धर्मीको मुख जीवनको फोहोरा हो,","poem":1},{"text":"तर दुष्‍टको मुखमा हिंसा लुकेको हुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"घृणाले फाटो उब्जाउँछ;","poem":1},{"text":"तर प्रेमले सबै अपराधहरू ढाक्दछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"समझदार व्यक्तिका ओठमा बुद्धिका कुरा पाइन्छ;","poem":1},{"text":"तर विवेकहीनहरूका पिठिउँमा त छडी पर्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"बुद्धिमान् मानिसहरूले ज्ञान सञ्चय गर्छन्;","poem":1},{"text":"तर मूर्खको मुखले विनाश निम्त्याउँछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"धनीको धन नै तिनीहरूका किल्‍ला भएको सहर हो,","poem":1},{"text":"तर दरिद्रता गरिबहरूको विनाश हो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"धर्मीको ज्याला तिनीहरूको जीवन हो,","poem":1},{"text":"तर दुष्‍टको कमाइ पाप र मृत्यु हो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"अनुशासन पालन गर्ने जीवनको बाटोमा जान्छ,","poem":1},{"text":"तर जसले सुधारलाई बेवास्ता गर्छ, त्यसले अरूलाई पथभ्रष्‍ट पार्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"जसले आफूमा घृणा लुकाएर राख्छ, उसको जिब्रो छली हुन्छ","poem":1},{"text":"र जसले निन्दा फैलाउँछ, त्यो मूर्ख हो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"जब बढ्ता बोलिन्छ, पापले बढी स्थान पाउँछ;","poem":1},{"text":"तर बुद्धिमान्‌ले आफ्नो जिब्रोमा लगाम लगाउँछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"धर्मीको जिब्रो निखुर चाँदी हो;","poem":1},{"text":"तर दुष्‍टको हृदय भने केही मूल्यको हुँदैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"धर्मीको ओठले धेरैलाई उत्साह दिन्छ,","poem":1},{"text":"तर मूर्खहरू विवेकको अभावले मर्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"याहवेहको आशिष्‌ले धनसम्पत्ति ल्याउँछ;","poem":1},{"text":"अनि उहाँले यसमा दुःख थप्नुहुन्‍न।","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"मूर्खहरू दुष्‍ट चालमा आनन्दित हुन्छन्,","poem":1},{"text":"तर समझशक्ति भएको मानिस बुद्धिमा प्रसन्‍न हुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"तिनीहरूलाई त्रसित बनाउने कुरा नै दुष्‍टमाथि आइपर्नेछ;","poem":1},{"text":"धर्मीले जे इच्छा गर्छ, त्यो पूरा गरिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"आँधीबेहरी आएपछि दुष्‍टहरू सोहोरिएर गइहाल्छन्;","poem":1},{"text":"तर धर्मीचाहिँ अन्त्यसम्मै स्थिर रहन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"दाँतलाई सिर्का र आँखालाई धुवाँजस्तै,","poem":1},{"text":"अल्छे पनि त्यसलाई पठाउनेको निम्ति त्यस्तै हुन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"याहवेहप्रति गरिएको श्रद्धाले जीवनको आयु लामो पार्छ;","poem":1},{"text":"तर दुष्‍टका आयुचाहिँ घटाइन्छ,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"धर्मीका आशा आनन्दमय हुन्छ;","poem":1},{"text":"तर दुष्‍टहरूको आशा पूरा हुनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"याहवेहको मार्ग धर्मीहरूको निम्ति शरणस्थान हो;","poem":1},{"text":"तर दुष्‍ट काम गर्नेहरूको निम्ति त्यो विनाश हो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"धर्मी कहिल्यै उखेलिनेछैन;","poem":1},{"text":"तर दुष्‍ट पृथ्वीमा स्थिर रहनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"धर्मीको मुखबाट बुद्धिका कुरा निस्किन्छ,","poem":1},{"text":"तर भड्काउने जिब्रो काटिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"धर्मीका ओठले उचित कुरा जान्दछन्;","poem":1},{"text":"तर दुष्‍टको मुखले टेढामेढा कुराहरू मात्र जान्दछ।","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":5,"caller":"+","text":"हेर्नुहोस् उत्प 48:20","reference":{"chapter":10,"verse":7}}]},"thisChapterLink":"/api/npi_ncb/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}