{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PRO","translationId":"npi_ncb","name":"हितोपदेश","commonName":"हितोपदेश","title":"हितोपदेशको पुस्तक","order":20,"numberOfChapters":31,"sha256":"9767e7e75f15aa9070c707826e3b29a54b0552e170bbc5d89edcd97b1d0a1338","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/npi_ncb/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"राजाको हृदय याहवेहको हातमा हुन्छ;","poem":1},{"text":"उहाँले खोलाको पानीलाई आफ्नो मनपर्दो दिशातिर डोर्‍याएजस्तै, त्यसलाई डोर्‍याउनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"मानिसलाई आफ्ना सबै चालहरू ठिक लाग्ला,","poem":1},{"text":"तर हृदय जाँच्नुहुने याहवेह नै हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ठिक र न्यायोचित काम गर्नुचाहिँ","poem":1},{"text":"याहवेहको सामु बलिदानभन्दा बढी ग्रहणयोग्य हुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"अहङ्कारी आँखा र अभिमानी हृदय","poem":1},{"text":"तथा दुष्‍टका नजोतिएका जमिनले पाप उब्जाउँछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"परिश्रमीको योजनाले लाभ दिन्छ;","poem":1},{"text":"हतारले अवश्य नै गरिबीमा पुर्‍याउँछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"झूटो जिब्रोद्वारा कमाएको धन","poem":1},{"text":"उडिजाने वाफ र घातक पासो हो।","poem":2},{"noteId":12}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"दुष्‍टहरूका हिंसाले नै तिनीहरूलाई पखाल्छ;","poem":1},{"text":"किनकि जे ठिक हो, त्यो गर्न तिनीहरूले अस्वीकार गर्दछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"दोषीको चाल बाङ्गो हुन्छ;","poem":1},{"text":"तर निर्दोषको चालचलन ठिक हुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"कचकचे पत्नीसित एउटै घरमा बस्‍नुभन्दा,","poem":1},{"text":"घरको कौसीको एउटा कुनामा बस्‍नु असल हो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"दुष्‍ट मानिसले दुष्‍टताको चाहना गर्छ;","poem":1},{"text":"त्यसको छिमेकीले त्यसबाट दया पाउँदैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"गिल्‍ला गर्नेले दण्ड पाउँदा सोझाले बुद्धि प्राप्‍त गर्छ;","poem":1},{"text":"बुद्धिमान्‌लाई अर्ती दिँदा त्यसले ज्ञान प्राप्‍त गर्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"धर्मी जनले","poem":1},{"noteId":13},{"text":"दुष्‍टको घरलाई चिनिराख्छ;","poem":1},{"text":"तर परमेश्‍वरले दुष्‍टहरूलाई पतन गराउनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"जसले गरिबको चीत्कार सुन्दैन,","poem":1},{"text":"त्यसले पनि पुकार गर्दा जवाफ पाउनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"गुप्‍तमा दिएको उपहारले क्रोधलाई शान्त गर्छ;","poem":1},{"text":"लुकाएर दिएको घूसले ठूलो क्रोध शान्त गर्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"उचित न्यायले धर्मी जनको हृदयमा आनन्द ल्याउँछ;","poem":1},{"text":"तर कुकर्मीहरू भने त्रसित हुन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"समझशक्तिदेखि कुमार्गतिर लाग्ने मानिस","poem":1},{"text":"मृतकहरूको साथमा विश्राम गर्न पुग्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"सुख-विलास मन पराउने गरिब हुनेछ;","poem":1},{"text":"दाखमद्य र विलासिता","poem":2},{"noteId":14},{"text":"मन पराउने कहिल्यै धनी हुनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"दुष्‍टहरू धर्मीहरूको उद्धारको मोल,","poem":1},{"text":"र विश्‍वासघाती निर्दोषहरूको उद्धारको मोल हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"झगडालु र गनगने पत्नीसित बस्‍नुभन्दा त","poem":1},{"text":"बरु मरुभूमिमा बस्‍नु असल हुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"बुद्धिमान् मानिसको घरमा मनपर्दो धन र तेल हुन्छ;","poem":1},{"text":"तर मूर्ख मानिसले आफूसँग भएको सबै उडाउँछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"धार्मिकता र प्रेमको पछि लाग्नेले","poem":1},{"text":"जीवन, उन्‍नति","poem":2},{"noteId":15},{"text":"र सम्मान पाउँछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"बुद्धिमान् मानिसले पराक्रमीको सहरमा आक्रमण गर्छ,","poem":1},{"text":"र तिनीहरूले भरोसा गरेको किल्‍ला भत्काइदिन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"आफ्नो मुख र जिब्रो सम्हाल्नेले","poem":1},{"text":"आफूलाई विपत्तिबाट जोगाउँछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"अहङ्कारी र अभिमानी मानिसको नाम, “गिल्‍ला गर्ने” हो,","poem":1},{"text":"त्यसले अभिमानसाथ व्यवहार गर्दछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"अल्छेको इच्छा त्यसकै मृत्यु हुनेछ;","poem":1},{"text":"किनकि त्यसका हातहरूले काम गर्न इन्कार गर्छन्।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"दिनभरि नै त्यसले अझ बढी चाहना गर्छ,","poem":1},{"text":"तर धर्मीले नसाँचिकन उदारतापूर्वक दिन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"दुष्‍टको बलिदान घिनलाग्दो हुन्छ;","poem":1},{"text":"त्यसले दुष्‍ट विचारले ल्याएको छ भने झन् कति बढी घृणित हुनेछ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"झूटो गवाही दिने नष्‍ट हुनेछ;","poem":1},{"text":"तर साँचो साक्षीलाई सधैँ सुनिनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"दुष्‍ट मानिसले आफ्नो अनुहारमा साहसीपना देखाउँछ;","poem":1},{"text":"तर धर्मी जीवन जिउनेहरूले आफ्ना चालहरूमा विचार पुर्‍याउँछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"कुनै पनि बुद्धि, अन्तर्दृष्‍टि र योजना,","poem":1},{"text":"याहवेहको विरुद्ध सफल हुन सक्दैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"घोडा युद्धको निम्ति तयार राखिन्छ;","poem":1},{"text":"तर विजयचाहिँ याहवेहकै हातमा हुन्छ।","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":12,"caller":"+","text":"केही प्राचीन पा.लि.हरूमा मृत्यु खोज्नेहरूका निम्ति वाफ हो।","reference":{"chapter":21,"verse":6}},{"noteId":13,"caller":"+","text":"अथवा परमेश्‍वर","reference":{"chapter":21,"verse":12}},{"noteId":14,"caller":"+","text":"मूल भाषामा तेल","reference":{"chapter":21,"verse":17}},{"noteId":15,"caller":"+","text":"अथवा धार्मिकता","reference":{"chapter":21,"verse":21}}]},"thisChapterLink":"/api/npi_ncb/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}