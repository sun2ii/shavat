{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PRO","translationId":"npi_ncb","name":"हितोपदेश","commonName":"हितोपदेश","title":"हितोपदेशको पुस्तक","order":20,"numberOfChapters":31,"sha256":"9767e7e75f15aa9070c707826e3b29a54b0552e170bbc5d89edcd97b1d0a1338","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/npi_ncb/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":7,"content":[{"type":"heading","content":["व्यभिचारिणी स्त्रीको विरुद्ध चेतावनी"]},{"type":"verse","number":1,"content":[{"text":"हे मेरो छोरा, मेरा वचनहरू पालन गर,","poem":1},{"text":"र मेरा आज्ञाहरूलाई आफूभित्र साँचिराख।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मेरा आज्ञाहरू पालन गर, र तिमी जिउनेछौ,","poem":1},{"text":"मेरा अर्तीहरूलाई आफ्नो आँखाको नानीजस्तै जोगाइराख।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनलाई तिम्रा औँलाहरूमा बाँधिराख,","poem":1},{"text":"तिनलाई आफ्नो हृदयको पाटीमा लेखिराख।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"बुद्धिलाई भन, “तिमी मेरी बहिनी हौ,”","poem":1},{"text":"र समझशक्तिलाई चाहिँ “तिमी मेरो आफन्त हौ।”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिनले तिमीलाई व्यभिचारिणी स्त्रीबाट","poem":1},{"text":"र स्वेच्छाचारी स्त्रीको चिप्ले कुराबाट बचाउनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"आफ्नो घरको झ्यालमा","poem":1},{"text":"त्यसको आँखीझ्यालबाट मैले बाहिर हेरेँ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मैले सोझाहरूको बीचमा,","poem":1},{"text":"मैले जवान मानिसहरूमध्ये","poem":2},{"lineBreak":true},{"text":"विवेक नभएको एउटा जवानलाई देखेँ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"त्यो तल सडक छेउको त्यस स्त्रीको घरको कुनामा जाँदैथियो;","poem":1},{"text":"त्यो त्यसकै घरको कुनातिर हिँड्दैथियो।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"दिन ढल्दै गरेको साँझको समय थियो,","poem":1},{"text":"रातको अन्धकार बढ्दै थियो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"तब एउटी स्त्री त्यसलाई भेट्न आई,","poem":1},{"text":"चरित्रहीन स्त्रीको जस्तै वस्त्र पहिरेकी र धूर्त नियत भएकी,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"(त्यो चञ्चल र अभिमानी छे;","poem":1},{"text":"त्यसका पाउहरू कहिल्यै घरमा बास बस्दैनन्,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्यो कहिले सडकमा त कहिले चोकहरूमा हुन्छे;","poem":1},{"text":"त्यो प्रत्येक कुनाकाप्चामा ढुकिबस्छे।)","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तब त्यसले त्यसलाई समाती र चुम्बन गरी,","poem":1},{"text":"अनि लाजै नमानी त्यसले भनी:","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“मैले घरमा मेलबलि चढाउनु परेको छ;","poem":1},{"text":"आज मैले आफ्नो भाकल पूरा गरेकी छु।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"त्यसैले म तपाईंलाई भेट्न बाहिर आएकी हुँ,","poem":1},{"text":"मैले तपाईंलाई खोजेँ, र अहिले भेट्टाएकी छु!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"मैले मेरो ओछ्यानमा","poem":1},{"text":"इजिप्टबाट ल्याएको मलमलको रङ्गीन तन्‍ना बिछ्याएकी छु।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"मैले मेरो ओछ्यानमा","poem":1},{"text":"मूर्र, एलवा र दालचिनीको सुघन्धित अत्तर छर्केकी छु।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"आउनुहोस्, हामी बिहानसम्मै प्रेमले तृप्‍त बनौँ,","poem":1},{"text":"हामी प्रेममा मस्त होऔँ!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"मेरा पति घरमा हुनुहुन्‍न,","poem":1},{"text":"उहाँ लामो यात्रामा जानुभएको छ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"उहाँले आफ्नो थैलीभरि रकम लानुभएको छ,","poem":1},{"text":"र उहाँ पूर्णिमाको अगि घर फर्कनुहुन्‍न।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"लोभ्याउने वचनहरूले उसले त्यसलाई बहकाई;","poem":1},{"text":"उसले त्यसलाई मोहित कुराले फसाई।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"मारिनका निम्ति लगिएको गोरुझैँ,","poem":1},{"text":"पासोमा फस्‍न लागेको मृगझैँ,","poem":2},{"text":"त्यो तुरुन्तै त्यस स्त्रीको पछि लाग्यो,","poem":1}]},{"type":"verse","number":23,"content":[{"text":"काँडले त्यसको कलेजो नरोपिएसम्म,","poem":2},{"text":"एउटा चरा पासोमा पर्नलाई वेगसित उडिआए जस्तै,","poem":1},{"text":"त्यसलाई आफ्नो प्राण गुमाउनुपर्छ भन्‍ने थाहा हुँदैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"अब हे मेरा छोराहरू हो, मेरो कुरा सुन,","poem":1},{"text":"म जे भन्छु, त्यसमा ध्यान देओ।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"त्यस्ता स्त्रीतर्फ आफ्ना हृदय नफर्काओ,","poem":1},{"text":"न त त्यसका मार्गहरूतिर हिँड।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"त्यसले धेरैलाई शिकार बनाएकी छे;","poem":1},{"text":"त्यसद्वारा नष्‍ट पारिएकाहरू असंख्य छन्।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"त्यसको घर चिहानको राजमार्ग हो,","poem":1},{"text":"जसले मृत्युका कोठाहरूतिर पुर्‍याउँछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}