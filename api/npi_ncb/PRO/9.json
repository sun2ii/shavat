{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PRO","translationId":"npi_ncb","name":"हितोपदेश","commonName":"हितोपदेश","title":"हितोपदेशको पुस्तक","order":20,"numberOfChapters":31,"sha256":"9767e7e75f15aa9070c707826e3b29a54b0552e170bbc5d89edcd97b1d0a1338","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/npi_ncb/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":9,"content":[{"type":"heading","content":["बुद्धि र मूर्खताको निम्तो"]},{"type":"verse","number":1,"content":[{"text":"बुद्धिले आफ्नो घर बनाएको छ;","poem":1},{"text":"त्यसले सात वटा खाँबो काटेर गाडेको छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"त्यसले मासु पकाएको छ, र दाखमद्य तयार पारेको छ,","poem":1},{"text":"त्यसले आफ्नो टेबुल पनि ठिक पारेको छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्यसले आफ्नो सेवकहरूलाई बाहिर पठाएको छ,","poem":1},{"text":"र सहरमा सबैभन्दा अग्लो ठाउँबाट बोलाउँछ।","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“सोझाहरू सबै मेरो घरभित्र आओ!”","poem":2},{"text":"ती समझ नभएकाहरूलाई त्यसले भन्छ:","poem":1}]},{"type":"verse","number":5,"content":[{"text":"“आओ, मसँग खाओ,","poem":2},{"lineBreak":true},{"text":"र मैले मिसाएको दाखमद्य पिओ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"आफ्ना सोझा चालहरू त्याग, र तिमीहरू बाँच्नेछौ।”","poem":1},{"text":"समझशक्तिको मार्गमा हिँड।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"गिल्‍ला गर्नेलाई सुधार्नेले अपमान निम्त्याउँछ,","poem":1},{"text":"जसले दुष्‍टलाई हप्काउँछ, त्यसले दुर्व्यवहार बेहोर्नुपर्छ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"गिल्‍ला गर्नेलाई नहप्काऊ, नत्रता त्यसले तिमीलाई घृणा गर्नेछ;","poem":1},{"text":"बुद्धिमान् मानिसलाई हप्काऊ, र त्यसले तिमीलाई प्रेम गर्नेछ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"बुद्धिमान्‌लाई अर्ती देऊ, र ऊ अझ बुद्धिमान् हुनेछ;","poem":1},{"text":"धर्मी मानिसलाई शिक्षा देऊ, र उसले आफ्नो ज्ञान अझ बढाउँछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"याहवेहको भय नै बुद्धिको सुरुवात हो,","poem":1},{"text":"र पवित्र परमेश्‍वरको ज्ञान नै समझशक्ति हो।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"किनकि बुद्धिद्वारा नै तिमी दीर्घायु हुनेछौ,","poem":1},{"text":"र तिम्रो जीवनका वर्षहरू थपिनेछन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"यदि तिमी बुद्धिमान् हौ भने तिमीलाई बुद्धिले इनाम दिनेछ;","poem":1},{"text":"यदि तिमी गिल्‍ला गर्ने हौ भने तिमीले दुःख मात्र पाउनेछौ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"अज्ञानी स्त्री कोलाहलपूर्ण हुन्छे;","poem":1},{"text":"त्यो सोझी र अज्ञानी हुन्छे।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"त्यो आफ्नो घरको ढोकामा बस्छे,","poem":1},{"text":"सहरका सबैभन्दा अग्लो ठाउँमा बस्छे,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"आफ्नो बाटो सरासर हिँडिरहेकाहरूलाई","poem":1},{"text":"त्यसले नजिकबाट बोलाउँछे।","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"“सोझाहरू सबै मेरो घरभित्र आओ!”","poem":2},{"text":"ती समझ नभएकाहरूलाई त्यसले भन्छे:","poem":1}]},{"type":"verse","number":17,"content":[{"text":"“चोरीको पानी मिठो हुन्छ,","poem":2},{"lineBreak":true},{"text":"गुप्‍तमा खाएको भोजन स्वादिष्‍ठ हुन्छ!”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तर तिनीहरूले त्यहाँ मृतकहरू छन्,","poem":1},{"text":"र त्यसका पाहुनाहरू गहिरा चिहानभित्र छन् भन्‍ने कुरा जान्दैनन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}