{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"धन्य हुन् तिनीहरू,","poem":1},{"text":"जो दुष्‍टहरूको सल्‍लाहमा हिँड्दैनन्,","poem":2},{"text":"जो पापीहरूको मार्गमा खडा हुँदैनन्,","poem":1},{"text":"जो गिल्‍ला गर्नेहरूको सङ्गतमा बस्दैनन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तर तिनीहरू याहवेहको व्यवस्थामा नै प्रसन्‍न रहन्छन्,","poem":1},{"text":"र दिनरात उहाँकै व्यवस्थामा नै मनन गर्छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरू नदीको किनारमा रोपेको रूखजस्तै हुन्छन्,","poem":1},{"text":"जसले आफ्नो ऋतुमा फल दिन्छ;","poem":2},{"text":"र जसको पात कहिल्यै ओइलाउँदैन;","poem":1},{"text":"तिनीहरूले जे काम गर्छन्, त्यसमा सफल हुन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"दुष्‍टहरू त्यस्ता हुँदैनन्;","poem":1},{"text":"तर तिनीहरूचाहिँ बतासले उडाइलैजाने","poem":2},{"lineBreak":true},{"text":"भुसजस्तै हुन्छन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यसकारण दुष्‍टहरू न्यायमा खडा रहनेछैनन्,","poem":1},{"text":"न त धर्मीहरूको सभामा पापीहरूले स्थान पाउनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"किनकि याहवेहले धर्मीहरूको मार्गको रक्षा गर्नुहुन्छ;","poem":1},{"text":"तर दुष्‍टहरूको मार्गले विनाशमा पुर्‍याउँछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}