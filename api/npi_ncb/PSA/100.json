{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["प्रशंसाको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे सारा पृथ्वी, आनन्दको निम्ति याहवेहको जयजयकार गर!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"हर्षकासाथ याहवेहको आराधना गर;","poem":2},{"lineBreak":true},{"text":"आनन्दका गीतहरू गाउँदै उहाँको सामु आओ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"याहवेह नै परमेश्‍वर हुनुहुन्छ भनी जान।","poem":1},{"text":"उहाँले हामीलाई बनाउनुभयो, र हामी उहाँकै हौँ;","poem":2},{"lineBreak":true},{"text":"हामी उहाँका प्रजा, र उहाँका खर्कका भेडाहरू हौँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"धन्यवादसाथ उहाँका मूलढोकाहरूभित्र पस;","poem":1},{"text":"र प्रशंसा गर्दै उहाँका चोकहरूमा प्रवेश गर;","poem":2},{"lineBreak":true},{"text":"उहाँलाई धन्यवाद देओ, र उहाँको नामको प्रशंसा गर!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"किनकि याहवेह भलो हुनुहुन्छ, र उहाँको अचुक प्रेम सधैँभरि रहिरहन्छ;","poem":1},{"text":"उहाँको विश्‍वासयोग्यता सबै पुस्ताहरूमा रहिरहन्छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}