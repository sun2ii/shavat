{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"म तपाईंको अचुक प्रेम र न्यायको गीत गाउनेछु;","poem":1},{"text":"हे याहवेह, म तपाईंको प्रशंसा गाउनेछु।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"म निर्दोष जीवन बिताउनलाई होसियार रहनेछु,","poem":1},{"text":"तपाईं मकहाँ कहिले आउनुहुनेछ?","poem":2},{"lineBreak":true},{"text":"म निर्दोष हृदय लिएर","poem":1},{"text":"आफ्नो घरको कामकाज गर्नेछु।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"म आफ्नो आँखाहरू अगि","poem":1},{"text":"कुनै पनि अनुचित कुराहरू राख्नेछैनँ।","poem":2},{"lineBreak":true},{"text":"पथभ्रष्‍ट भएकाहरूका कामलाई म घृणा गर्छु;","poem":1},{"text":"यसमा मेरो कुनै सरोकार हुनेछैन।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कुटिल हृदय भएकाहरू मबाट टाढा रहनेछन्;","poem":1},{"text":"दुष्‍टसँग मेरो कुनै सरोकार रहनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"जसले गुप्‍तमा आफ्ना छिमेकीको निन्दा गर्दछ,","poem":1},{"text":"म त्यसलाई नाश गर्नेछु;","poem":2},{"text":"अहङ्कारी दृष्‍टि भएका र घमण्डी हृदय भएकालाई,","poem":1},{"text":"म सहनेछैनँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"देशका विश्‍वासयोग्य जनहरूमाथि म मेरो नजर राख्नेछु;","poem":1},{"text":"ताकि तिनीहरू मसित बास गरून्;","poem":2},{"text":"त्यो, जसको चालचलन निर्दोष छ,","poem":1},{"text":"उसले नै मेरो सेवा गर्नेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"छली काम गर्ने कसैले पनि","poem":1},{"text":"मेरो घरमा बास पाउनेछैन;","poem":2},{"text":"झूटो बोल्ने कोही पनि","poem":1},{"text":"मेरो उपस्थितिमा खडा हुनेछैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हरेक बिहान म","poem":1},{"text":"देशका दुष्‍ट काम गर्नेहरू सबैलाई नाश पार्नेछु;","poem":2},{"text":"याहवेहको सहरबाट","poem":1},{"text":"म हरेक दुष्कर्मीलाई नष्‍ट पार्नेछु।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}