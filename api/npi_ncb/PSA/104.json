{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"हे मेरो प्राण, याहवेहको प्रशंसा गर्!","poem":1},{"lineBreak":true},{"text":"हे याहवेह, मेरा परमेश्‍वर, तपाईं अति महान् हुनुहुन्छ;","poem":1},{"text":"तपाईंले वैभव र प्रतापको पोशाक पहिरनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"पोशाक पहिरेझैँ उहाँले आफूलाई ज्योतिले ढाक्नुभएको छ;","poem":1},{"text":"उहाँले आकाशलाई पालझैँ तन्काउनुभएको छ;","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"उहाँले आफ्नो माथिल्‍लो कोठाका दलिनहरू पानीमाथि बसाल्नुभएको छ।","poem":2},{"text":"उहाँले बादललाई आफ्ना रथ बनाउनुहुन्छ;","poem":1},{"text":"र उहाँ बतासका पखेटामा सवार हुनुहुन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उहाँले बतासलाई आफ्ना दूत,","poem":1},{"text":"र आगोका ज्वालालाई आफ्ना सेवक बनाउनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"उहाँले पृथ्वीलाई त्यसको जगमा बसाल्नुभयो;","poem":1},{"text":"त्यो कहिल्यै डगमगाउनेछैन।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तपाईंले त्यसलाई वस्त्रले झैँ गहिरो पानीले ढाक्नुभयो;","poem":1},{"text":"पानी पर्वतहरूमाथि पुगेको थियो।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तर तपाईंको हप्कीमा पानी भागे,","poem":1},{"text":"तपाईंको गर्जनको सोरमा ती तुरुन्तै हटेर गए;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"पर्वतहरू खडा भए र तल बेँसीहरू देखा परे,","poem":1},{"text":"तपाईंले तिनीहरूलाई तोकिदिनुभएको ठाउँमा ती बनिए।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"पानीले फेरि पृथ्वीलाई नडुबाओस् भनी","poem":1},{"text":"तपाईंले त्यसले नाघ्न नसक्ने सिमाना राखिदिनुभयो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"उहाँले खोल्साहरूमा पानीका मूलहरू फुटाउनुहुन्छ;","poem":1},{"text":"ती पर्वतका बीच भएर बग्दछन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तिनीहरूले मैदानका सबै जीवजन्तुलाई पानी दिन्छन्;","poem":1},{"text":"अनि जङ्गली गधाहरूले पनि आफ्नो तिर्खा त्यहीँ मेटाउँछन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"आकाशका चराचुरुङ्गीहरूले त्यसकै छेउमा आफ्ना गुँड बनाउँछन्;","poem":1},{"text":"हाँगाहरूका बीचमा तिनीहरू गीत गाउँछन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"उहाँले आफ्ना उच्‍च कक्षबाट पर्वतहरूमा पानी बर्साउनुहुन्छ;","poem":1},{"text":"उहाँको कामका फलबाट पृथ्वी तृप्‍त हुन्छ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"उहाँले गाईबस्तुका निम्ति घाँस,","poem":1},{"text":"र मानिसले खेतबारीमा परिश्रम गरोस् भनी बोटबिरुवा उमार्नुहुन्छ;","poem":2},{"lineBreak":true},{"text":"र जमिनबाट आहारा ल्याउनुहुन्छ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"मानिसका हृदय हर्षित पार्नलाई दाखमद्य,","poem":1},{"text":"त्यसको मुख चहकिलो पार्नलाई तेल,","poem":2},{"lineBreak":true},{"text":"र त्यसको हृदय बलियो तुल्याउनलाई उहाँले रोटी दिनुहुन्छ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"याहवेहका रूखहरू","poem":1},{"text":"र उहाँले लगाउनुभएका लेबनानका देवदारुका रूखहरूले पर्याप्‍त पानी पाउँछन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"त्यहाँ चराहरूले आफ्ना गुँड लगाउँछन्;","poem":1},{"text":"सारसले पनि सल्‍लाका रूखहरूमा आफ्नो गुँड बनाउँछ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"अग्ला पर्वतहरू जङ्गली बाख्राहरूका निम्ति हुन्;","poem":1},{"text":"पहराहरू खरायोहरूका निम्ति शरणस्थान हुन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ऋतु छुट्ट्याउन उहाँले चन्द्रमा बनाउनुभयो;","poem":1},{"text":"सूर्यले आफ्नो अस्ताउने बेला जान्दछ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तपाईंले अँध्यारो ल्याउनुहुन्छ, र रात पर्छ;","poem":1},{"text":"र सबै जङ्गली पशुहरू निस्किआउँछन्।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"सिंहहरू आफ्ना शिकारका निम्ति गर्जन्छन्","poem":1},{"text":"र तिनीहरूले परमेश्‍वरबाट आफ्ना आहारा खोज्छन्।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"सूर्य उदाउँदा ती जङ्गली पशुहरू गइहाल्छन्;","poem":1},{"text":"तिनीहरू आफ्ना ओडारमा फर्कन्छन् र आराम गर्छन्।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तब मानिसहरू आफ्ना काममा जान्छन्,","poem":1},{"text":"र साँझसम्म परिश्रम गर्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"हे याहवेह, तपाईंले कति धेरै जीवित प्राणीहरू बनाउनुभएको छ!","poem":1},{"text":"ती सबै तपाईंले आफ्ना बुद्धिले बनाउनुभएको छ;","poem":2},{"lineBreak":true},{"text":"पृथ्वी तपाईंको सृष्‍टिले भरिपूर्ण छ।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"त्यहाँ विशाल र फराकिलो समुद्र छ,","poem":1},{"text":"जसमा अनगन्ती जीवजन्तुहरू छन्—","poem":2},{"lineBreak":true},{"text":"साना र ठूला दुवै किसिमका जीवित प्राणीहरू त्यहाँ छन्।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"त्यसमाथि जहाजहरू ओहोर-दोहोर गर्दछन्;","poem":1},{"text":"त्यहाँ लिव्यातन छ, जसलाई त्यहाँ खेल्नलाई तपाईंले बनाउनुभयो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ठिक समयमा आफ्ना आहारा पाउने आशाले","poem":1},{"text":"तिनीहरू सबैले तपाईंको बाटो हेर्छन्।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"जब तपाईंले त्यो तिनीहरूलाई दिनुहुन्छ,","poem":1},{"text":"तब तिनीहरूले त्यो बटुल्छन्;","poem":2},{"text":"जब तपाईंले आफ्नो मुट्ठी खोल्नुहुन्छ,","poem":1},{"text":"तिनीहरू उत्तम पदार्थहरूले तृप्‍त हुन्छन्।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"जब तपाईंले आफ्ना मुहार लुकाउनुहुन्छ,","poem":1},{"text":"तिनीहरू भयभीत हुन्छन्;","poem":2},{"text":"जब तपाईंले तिनीहरूको सास लिनुहुन्छ,","poem":1},{"text":"तिनीहरू मर्छन् र माटोमा फर्किजान्छन्।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"जब तपाईंले आफ्नो आत्मा","poem":1},{"noteId":84},{"text":"पठाउनुहुन्छ,","poem":1},{"text":"तब तिनीहरूको सृष्‍टि हुन्छ;","poem":2},{"lineBreak":true},{"text":"र तपाईंले पृथ्वीको रूपलाई नयाँ तुल्याउनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"याहवेहको महिमा सदासर्वदा रहिरहोस्;","poem":1},{"text":"याहवेह आफ्ना कार्यहरूमा प्रसन्‍न होऊन्—","poem":2}]},{"type":"verse","number":32,"content":[{"text":"उहाँले पृथ्वीलाई हेर्नुहुन्छ, र त्यो थरथरी काम्दछ;","poem":1},{"text":"उहाँले पर्वतहरूलाई छुनुहुन्छ, र तीबाट धुवाँ निस्कन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"म मेरो जीवनभरि याहवेहको भजन गाइरहनेछु;","poem":1},{"text":"म बाँचुन्जेल परमेश्‍वरको प्रशंसा गाउनेछु।","poem":2}]},{"type":"verse","number":34,"content":[{"text":"जब म याहवेहमा आनन्दित हुन्छु;","poem":1},{"text":"मेरो ध्यान उहाँलाई मनपर्दो होस्।","poem":2}]},{"type":"verse","number":35,"content":[{"text":"तर पापीहरू पृथ्वीबाट नाश भएर जाऊन्,","poem":1},{"text":"र दुष्‍टहरू रहँदै नरहून्!","poem":2},{"lineBreak":true},{"text":"हे मेरो प्राण, याहवेहको प्रशंसा गर्!","poem":1},{"lineBreak":true},{"text":"याहवेहको प्रशंसा गर्!","poem":1},{"noteId":85}]}],"footnotes":[{"noteId":84,"caller":"+","text":"आत्मा अथवा जीवनको सास","reference":{"chapter":104,"verse":30}},{"noteId":85,"caller":"+","text":"मूल भाषामा हल्‍लेलूयाह","reference":{"chapter":104,"verse":35}}]},"thisChapterLink":"/api/npi_ncb/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}