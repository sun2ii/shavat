{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["एउटा गीत, दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्‍वर, मेरो हृदय स्थिर छ;","poem":1},{"text":"म गाउनेछु र मेरो सम्पूर्ण प्राणले धुन बजाउनेछु।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे सारङ्गी र वीणा जाग्!","poem":1},{"text":"म प्रभातलाई जगाउनेछु।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हे याहवेह, राष्ट्र-राष्ट्रहरूका बीचमा म तपाईंको प्रशंसा गर्नेछु;","poem":1},{"text":"जाति-जातिहरूबीच म तपाईंको स्तुति गाउनेछु।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"किनकि तपाईंको प्रेम महान् छ, आकाशभन्दा पनि उच्‍च छ;","poem":1},{"text":"तपाईंको विश्‍वासयोग्यता आकाशसम्मै पुग्दछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे परमेश्‍वर, स्वर्गभन्दा उच्‍च हुनुहोस्;","poem":1},{"text":"सारा पृथ्वीमाथि तपाईंको महिमा रहोस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"तपाईंको दाहिने हातले हामीलाई बचाउनुहोस्, र मदत गर्नुहोस्;","poem":1},{"text":"ताकि तपाईंका प्रियजनहरूले छुटकारा पाऊन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"परमेश्‍वरले उहाँको वासस्थानबाट बोल्नुभएको छ:","poem":1},{"text":"“विजयमा म शेकेमलाई विभाजन गर्नेछु,","poem":2},{"lineBreak":true},{"text":"र सुक्‍कोतको बेँसीलाई नापेर छुट्ट्याउनेछु।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"गिलाद मेरो हो, मनश्शे पनि मेरै हो;","poem":1},{"text":"एफ्राइम मेरो टोप हो,","poem":2},{"lineBreak":true},{"text":"यहूदा मेरो राजदण्ड हो।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मोआब मेरो हात धुने भाँडो हो;","poem":1},{"text":"एदोममा म आफ्नो जुत्ता फाल्नेछु;","poem":2},{"lineBreak":true},{"text":"पलिश्तीमाथिको विजयमा म कराउनेछु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"किल्‍ला भएको सहरमा मलाई कसले पुर्‍याइदेला?","poem":1},{"text":"कसले मलाई एदोमसम्म डोर्‍याउला?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हे परमेश्‍वर, तपाईं नै होइन, जसले हामीलाई त्याग्नुभएको छ,","poem":1},{"text":"र अहिले हाम्रा सेनाहरूका साथमा पनि जानुभएन?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"शत्रुहरूका विरुद्धमा हामीलाई सहायता गर्नुहोस्;","poem":1},{"text":"किनकि मानिसको सहायता व्यर्थ छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"परमेश्‍वरको सहायताद्वारा हामीले विजय प्राप्‍त गर्नेछौँ;","poem":1},{"text":"र उहाँले हाम्रा शत्रुहरूलाई कुल्चनुहुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}