{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"याहवेहमा म शरण लिन्छु,","poem":1},{"text":"तिमीहरू कसरी मलाई यसो भन्‍न सक्छौ:","poem":2},{"lineBreak":true},{"text":"“चराझैँ तिम्रो डाँडामा उडिजाऊ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"किनकि हेर, दुष्‍टहरूले आफ्नो धनुमा ताँदो चढाउँछन्;","poem":1},{"text":"अँध्यारोबाट काँड ताकेर","poem":2},{"text":"सोझो हृदय भएकाहरूलाई हान्‍नका निम्ति","poem":1},{"text":"तिनीहरूले आफ्नो काँड ताँदोमा चढाएका छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जब जगहरू नै नष्‍ट पारिन्छन् भने,","poem":1},{"text":"धर्मी जनहरूले के गर्न सक्छन् र?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"याहवेह आफ्नो पवित्र मन्दिरमा हुनुहुन्छ;","poem":1},{"text":"याहवेह आफ्नो स्वर्गीय सिंहासनमा विराजमान हुनुहुन्छ।","poem":2},{"text":"उहाँले पृथ्वीका सबै मानिसहरूलाई नियालेर हेर्नुहुन्छ;","poem":1},{"text":"उहाँले आफ्ना आँखाले तिनीहरूको जाँच गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेहले धर्मीहरूलाई जाँच गर्नुहुन्छ;","poem":1},{"text":"तर दुष्‍टहरू, जसले हिंसा रुचाउँछन्,","poem":2},{"lineBreak":true},{"text":"उहाँले तिनीहरूलाई घृणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"दुष्‍टहरूमाथि उहाँले","poem":1},{"text":"प्रचण्ड आगो र बल्दो गन्धक बर्साउनुहुनेछ;","poem":2},{"lineBreak":true},{"text":"र पोल्ने हावा तिनीहरूको भाग हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"किनकि याहवेह धर्मी हुनुहुन्छ,","poem":1},{"text":"उहाँले न्यायलाई प्रेम गर्नुहुन्छ;","poem":2},{"lineBreak":true},{"text":"धर्मी मानिसहरूले उहाँको मुहारको दर्शन गर्नेछन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}