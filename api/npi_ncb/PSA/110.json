{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"याहवेहले मेरा प्रभुलाई भन्‍नुहुन्छ:","poem":1},{"lineBreak":true},{"text":"“जबसम्म म तिम्रा शत्रुहरूलाई","poem":1},{"text":"तिम्रा खुट्टाको पाउदान बनाउँदिनँ,","poem":2},{"lineBreak":true},{"text":"तबसम्म तिमी मेरो दाहिने हातपट्टि बस।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"याहवेहले सियोनबाट यसो भन्दै आफ्नो महान् पराक्रमको राजदण्ड विस्तार गर्नुहुनेछ,","poem":1},{"text":"“आफ्ना शत्रुहरूका बीच तपाईंले राज्य गर्नुहुनेछ!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तपाईंका युद्धको दिनमा","poem":1},{"text":"तपाईंका प्रजा राजीखुशीले तयार हुनेछन्।","poem":2},{"text":"पवित्रताको वैभवमा सुशोभित भई,","poem":1},{"text":"तपाईंका जवानहरू","poem":2},{"lineBreak":true},{"text":"बिहानीको गर्भबाट","poem":2},{"noteId":88},{"text":"निस्केको शीतझैँ तपाईंकहाँ आउनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"याहवेहले शपथ खानुभएको छ,","poem":1},{"text":"र उहाँले आफ्नो करार भङ्ग गर्नुहुनेछैन:","poem":2},{"text":"“तिमी सदासर्वदाको निम्ति,","poem":1},{"text":"मल्कीसेदेकको दर्जाबमोजिम पुजारी हौ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"प्रभु तिम्रो दाहिने हाततर्फ हुनुहुन्छ;","poem":1},{"text":"उहाँले आफ्नो क्रोधको दिनमा राजाहरूलाई चकनाचुर पार्नुहुनेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"उहाँले लासको थुप्रो लगाएर राष्ट्रहरूको न्याय गर्नुहुनेछ;","poem":1},{"text":"अनि पृथ्वीका सबै शासकहरूलाई चकनाचुर पार्नुहुनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उहाँले बाटो छेउको खोलाबाट","poem":1},{"noteId":89},{"text":"पानी पिउनुहुनेछ;","poem":1},{"text":"यसरी उहाँले आफ्नो शिर उच्‍च पार्नुहुनेछ।","poem":2}]}],"footnotes":[{"noteId":88,"caller":"+","text":"मूल भाषामा यस खण्डको अर्थ अनिश्‍चित छ","reference":{"chapter":110,"verse":3}},{"noteId":89,"caller":"+","text":"मूल भाषामा यस खण्डको अर्थ अनिश्‍चित छ","reference":{"chapter":110,"verse":7}}]},"thisChapterLink":"/api/npi_ncb/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}