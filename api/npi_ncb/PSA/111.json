{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहको प्रशंसा गर!","poem":1},{"noteId":90},{"lineBreak":true},{"text":"म मेरो सारा हृदयले,","poem":1},{"text":"धर्मी मानिसहरूको सभामा र समुदायमा म याहवेहलाई उच्‍च पार्नेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"याहवेहका कार्यहरू महान् छन्;","poem":1},{"text":"ती कार्यहरूमा प्रसन्‍न हुनेहरू सबैले तीमाथि मनन गर्छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उहाँका कार्य महिमामय र ऐश्‍वर्यपूर्ण छन्;","poem":1},{"text":"र उहाँको धार्मिकता सदासर्वदा रहिरहन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उहाँले आफ्ना अद्‌भुत कार्यहरूको स्मरण गराउनुभएको छ;","poem":1},{"text":"याहवेह अनुग्रही र दयालु हुनुहुन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उहाँको भय मान्‍नेहरूलाई उहाँले भोजन जुटाउनुहुन्छ;","poem":1},{"text":"र उहाँ आफ्नो करार सदासर्वदा सम्झनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"अन्य राष्ट्रहरूको भूमि आफ्ना प्रजालाई दिएर,","poem":1},{"text":"उहाँले तिनीहरूलाई आफ्ना कार्यको शक्ति प्रकट गर्नुभएको छ,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उहाँका हातका कार्य विश्‍वासयोग्य र न्यायपूर्ण छन्;","poem":1},{"text":"उहाँका सबै विधिहरू भरपर्दा छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ती सदासर्वदाको लागि अटल छन्,","poem":1},{"text":"ती धार्मिकता र विश्‍वासयोग्यतामा लागू गरिएका छन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"उहाँले आफ्ना प्रजाको निम्ति छुटकारा उपलब्ध गराउनुभयो;","poem":1},{"text":"उहाँले आफ्नो करार सदाकालको निम्ति स्थिर होस् भनी आज्ञा दिनुभयो—","poem":2},{"lineBreak":true},{"text":"उहाँको नाम पवित्र र भययोग्य छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"याहवेहको भय नै बुद्धिको सुरुवात हो;","poem":1},{"text":"उहाँका विधिहरू पालन गर्नेहरू सबैले ठिक समझशक्ति पाउँछन्।","poem":2},{"lineBreak":true},{"text":"उहाँको प्रशंसा अनन्तसम्म भइरहनेछ।","poem":2}]}],"footnotes":[{"noteId":90,"caller":"+","text":"मूल भाषामा हल्‍लेलूयाह","reference":{"chapter":111,"verse":1}}]},"thisChapterLink":"/api/npi_ncb/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}