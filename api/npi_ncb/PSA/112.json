{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहको प्रशंसा गर!","poem":1},{"noteId":91},{"lineBreak":true},{"text":"त्यो मानिस धन्यको हो, जसले याहवेहको भय मान्दछ,","poem":1},{"text":"जो उहाँका आज्ञाहरूमा ज्यादै प्रसन्‍न हुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"त्यसका सन्तानहरू पृथ्वीमाथि शक्तिशाली हुनेछन्;","poem":1},{"text":"धर्मी मानिसहरूका पुस्ताले आशिष् पाउनेछन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्यसको घरमा धन र सम्पत्ति रहन्छ,","poem":1},{"text":"र त्यसको धार्मिकता सदाकाल रहिरहन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"सत्यनिष्‍ठ मानिसहरू, जो अनुग्रही, दयालु, र धर्मी छन्,","poem":1},{"text":"तिनीहरूका निम्ति अन्धकारमा पनि ज्योति चम्कन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उदार चित्तले ऋण दिनेहरू,","poem":1},{"text":"र इमानदारीतासाथ आफ्नो कारोबार चलाउने मानिसहरूको भलो हुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"अवश्य नै धर्मी जनहरू कहिल्यै डगमगाउनेछैनन्;","poem":1},{"text":"तिनीहरूको सम्झना सदासर्वदा गरिनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"खराब समाचारले तिनीहरू कहिल्यै डराउनेछैनन्;","poem":1},{"text":"याहवेहमा भरोसा गरेकोले तिनीहरूका हृदय दृढ रहन्छ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरूका हृदय निर्धक्‍क रहन्छ, र तिनीहरूलाई कुनै डर हुनेछैन;","poem":1},{"text":"अन्त्यमा तिनीहरूले आफ्ना वैरीहरू हार भएको देख्नेछन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरूले गरिबहरूलाई उदारतापूर्वक दान दिएका छन्;","poem":1},{"text":"तिनीहरूका धार्मिकता सदासर्वदा रहिरहन्छ;","poem":2},{"lineBreak":true},{"text":"तिनीहरूका शिर सम्मानले उच्‍च रहनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"दुष्‍ट मानिस त्यो देखेर कुँडिनेछ;","poem":1},{"text":"तिनीहरूले आफ्ना दाह्रा किट्नेछन्, र नष्‍ट हुनेछन्;","poem":2},{"lineBreak":true},{"text":"दुष्‍टहरूका अभिलाषाहरू विफल हुन्छन्।","poem":2}]}],"footnotes":[{"noteId":91,"caller":"+","text":"मूल भाषामा हल्‍लेलूयाह","reference":{"chapter":112,"verse":1}}]},"thisChapterLink":"/api/npi_ncb/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}