{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहको प्रशंसा गर!","poem":1},{"noteId":92},{"lineBreak":true},{"text":"हे याहवेहका सेवकहरू हो, उहाँको प्रशंसा गर!","poem":1},{"text":"याहवेहको नामको प्रशंसा गर!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"अहिलेदेखि लिएर सदासर्वदा,","poem":1},{"text":"याहवेहको नामको प्रशंसा भइरहोस्!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"सूर्योदयदेखि सूर्यास्तसम्म नै","poem":1},{"text":"याहवेहको नामको प्रशंसा हुनुपर्छ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"याहवेह सबै राष्ट्रहरूमाथि सर्वोच्‍च हुनुहुन्छ;","poem":1},{"text":"र उहाँको महिमा आकाशभन्दा उच्‍च छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेह हाम्रा परमेश्‍वरजस्तो को छ र?","poem":1},{"text":"उहाँ उच्‍च सिंहासनमा विराजमान हुनुहुन्छ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जो स्वर्ग र पृथ्वीलाई हेर्न भनी","poem":1},{"text":"तल निहुरनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"उहाँले गरिबहरूलाई धुलोबाट उठाउनुहुन्छ,","poem":1},{"text":"अनि खाँचोमा परेकाहरूलाई खरानीको राशबाट उचाल्नुहुन्छ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"उहाँले तिनीहरूलाई राजकुमारहरूसित,","poem":1},{"text":"आफ्नै प्रजाका राजकुमारहरूसित बसाउनुहुन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"उहाँले बाँझी स्त्रीलाई सन्तान दिनुभएर","poem":1},{"text":"उनलाई सुखी आमाको रूपमा उनको घरमा स्थिर गरिदिनुहुन्छ।","poem":2},{"lineBreak":true},{"text":"याहवेहको प्रशंसा गर!","poem":1}]}],"footnotes":[{"noteId":92,"caller":"+","text":"मूल भाषामा हल्‍लेलूयाह ; 9पदमा पनि","reference":{"chapter":113,"verse":1}}]},"thisChapterLink":"/api/npi_ncb/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}