ber":6,"content":[{"text":"शान्तिलाई घृणा गर्नेहरूका बीचमा","poem":1},{"text":"म बसेको धेरै समय भयो।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म त शान्तिप्रिय व्यक्ति हुँ;","poem":1},{"text":"तर मैले बोल्दा, तिनीहरू लडाइँ गर्न तम्सिन्छन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}