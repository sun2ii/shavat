{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["आरोहणको गीत।"]},{"type":"verse","number":1,"content":[{"text":"म मेरा आँखाहरू पर्वतहरूतिर उचाल्छु—","poem":1},{"text":"मेरो सहायता कहाँबाट आउँछ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मेरो सहायता याहवेहबाट आउँछ,","poem":1},{"text":"जो स्वर्ग र पृथ्वीका सृष्‍टिकर्ता हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"उहाँले तिम्रा खुट्टाहरू चिप्लन दिनुहुनेछैन—","poem":1},{"text":"तिम्रो रक्षा गर्नुहुने कहिल्यै उँघ्नुहुनेछैन;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"साँच्‍चै, इस्राएललाई रक्षा गर्नुहुनेचाहिँ","poem":1},{"text":"न उँघ्नुहुन्छ, न त निदाउनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"याहवेहले नै तिमीलाई रक्षा गर्नुहुनेछ—","poem":1},{"text":"याहवेह नै तिम्रो दाहिने हातपट्टिको तिम्रो छहारी हुनुहुन्छ;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"दिउँसोको घामले तिमीलाई पोल्नेछैन,","poem":1},{"text":"न त राति चन्द्रमाले तिमीलाई हानि गर्नेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेहले तिमीलाई सबै हानिबाट जोगाउनुहुनेछ—","poem":1},{"text":"उहाँले तिम्रो जीवनको रक्षा गर्नुहुनेछ;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिमी बाहिर जाँदा र भित्र आउँदा,","poem":1},{"text":"अहिले अनि सदासर्वदा, याहवेहले तिम्रो रक्षा गर्नुहुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}