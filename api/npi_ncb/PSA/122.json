{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["दावीदको आरोहणको गीत।"]},{"type":"verse","number":1,"content":[{"text":"जब तिनीहरूले मलाई, “याहवेहका भवनमा हामी जाऔँ” भने,","poem":1},{"text":"तब म तिनीहरूसँगै आनन्दित भएँ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे यरूशलेम, तेरा मूलढोकाहरूभित्र","poem":1},{"text":"हाम्रा खुट्टाहरू उभिएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"यरूशलेम एउटा सहरजस्तै,","poem":1},{"text":"एकै ठाउँमा टम्‍म गरी मिलाएर बसालिएको छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"इस्राएललाई दिइएको कानुनअनुसार","poem":1},{"text":"याहवेहका कुलहरू","poem":2},{"text":"याहवेहको नामको प्रशंसा गर्न","poem":1},{"text":"त्यहाँ जान्छन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"किनकि त्यहाँ न्यायका सिंहासनहरू स्थापित छन्;","poem":1},{"text":"त्यहाँ दावीदका वंशका सिंहासनहरू छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"यरूशलेमको शान्तिको निम्ति प्रार्थना गर:","poem":1},{"text":"“तँलाई प्रेम गर्नेहरू सुरक्षित रहून्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तेरा पर्खालहरूभित्र शान्ति रहोस्;","poem":1},{"text":"र तेरा दरबारहरूभित्र सुरक्षा रहोस्!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मेरा परिवार र मेरा मित्रहरूका खातिर","poem":1},{"text":"म, “तिमीहरूमा शान्ति रहोस्!” भन्‍नेछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेह हाम्रा परमेश्‍वरको भवनको खातिर,","poem":1},{"text":"म तेरो भलो चिताउनेछु।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}