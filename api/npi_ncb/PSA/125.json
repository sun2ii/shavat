{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["आरोहणको गीत।"]},{"type":"verse","number":1,"content":[{"text":"याहवेहमा भरोसा राख्नेहरू सियोन पर्वतझैँ छन्,","poem":1},{"text":"जो कहिल्यै डगमगाउँदैनन्; तर सदासर्वदा स्थिर रहन्छन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जसरी पहाडहरूले यरूशलेमलाई घेरेका छन्,","poem":1},{"text":"त्यसरी नै याहवेहले आफ्ना मानिसहरूलाई","poem":2},{"lineBreak":true},{"text":"आज अनि सदासर्वदा घेरिराख्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"धर्मीहरूलाई छुट्ट्याइएको देशमा,","poem":1},{"text":"दुष्‍टहरूको राजदण्ड रहनेछैन।","poem":2},{"text":"नत्रता धर्मीहरूले","poem":1},{"text":"आफ्ना हात अधर्मतिर लगाउलान्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे याहवेह, जो असल छन्, तिनीहरूलाई असल गर्नुहोस्;","poem":1},{"text":"तिनीहरूलाई, जसका हृदय सोझो छन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तर खराब मार्गतिर जो फर्कन्छन्,","poem":1},{"text":"याहवेहले तिनीहरूलाई दुष्कर्मीहरूसितै धपाउनुहुनेछ।","poem":2},{"lineBreak":true},{"text":"इस्राएलमाथि शान्ति कायम रहोस्!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}