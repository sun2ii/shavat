{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["आरोहणको गीत।"]},{"type":"verse","number":1,"content":[{"text":"जब याहवेहले निर्वासितहरूलाई सियोनमा फर्काएर ल्याउनुभयो,","poem":1},{"text":"यो त सपनाजस्तो थियो।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"त्यस बेला हाम्रा मुहारहरू हाँसोले भरिए;","poem":1},{"text":"हाम्रा जिब्राहरू हर्षका गीतले भरिए।","poem":2},{"text":"तब जाति-जातिहरूका बीच यसो भनियो,","poem":1},{"text":"“याहवेहले तिनीहरूका निम्ति महान् कार्यहरू गर्नुभएको छ।”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"याहवेहले हाम्रा निम्ति महान् कार्यहरू गर्नुभएको छ,","poem":1},{"text":"र हामी आनन्दले भरिएका छौँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे याहवेह, दक्षिण देशका पानीका मुहानहरूझैँ,","poem":1},{"text":"निर्वासितहरूलाई स्थापित गरिदिनुहोस्!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जसले आँसु बहाउँदै बिउ छर्दछन्,","poem":1},{"text":"तिनीहरू हर्षका गीत गाउँदै कटनी गर्नेछन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जो रुँदै-रुँदै बिउ बोकेर","poem":1},{"text":"छर्नको लागि बाहिर जान्छन्,","poem":2},{"text":"तिनीहरू हर्षका गीत गाउँदै","poem":1},{"text":"अन्‍नका बिटाहरू बोकेर फर्कनेछन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}