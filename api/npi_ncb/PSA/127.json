se","number":5,"content":[{"text":"त्यो मानिस धन्यको हो,","poem":1},{"text":"जसको ठोक्रो काँडहरूले भरिएको हुन्छ।","poem":2},{"text":"मूलढोकामा आफ्ना शत्रुहरूको सामना गर्नुपर्दा","poem":1},{"text":"तिनीहरू लाजमा पर्नेछैनन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}