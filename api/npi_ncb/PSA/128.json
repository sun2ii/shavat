{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["आरोहणको गीत।"]},{"type":"verse","number":1,"content":[{"text":"याहवेहको भय मान्‍नेहरू","poem":1},{"text":"र उहाँमा आज्ञाकारी भएर हिँड्नेहरू सबै धन्यका हुन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तिमीले आफ्ना परिश्रमको कमाइ खानेछौ;","poem":1},{"text":"भलाइ र समृद्धि तिम्रा हुनेछन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिम्रो घरमा तिम्री पत्नी","poem":1},{"text":"फलवन्त दाखको बोटझैँ हुनेछिन्;","poem":2},{"text":"र तिम्रा छोराछोरीहरू तिम्रो टेबुलको वरिपरि","poem":1},{"text":"जैतुनका मुनाहरूजस्तै हुनेछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हो, याहवेहको भय मान्‍ने जन","poem":1},{"text":"यसरी नै आशिषित हुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"याहवेहले तिमीलाई सियोनबाट आशिष् देऊन्;","poem":1},{"text":"तिम्रो जीवनभरि नै","poem":2},{"lineBreak":true},{"text":"तिमीले यरूशलेमको समृद्धि देख्नेछौ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिमी आफ्ना नातिनातिनाहरूलाई देख्ने गरी बाँच—","poem":1},{"text":"इस्राएलमाथि शान्ति रहोस्!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}