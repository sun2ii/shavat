{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["आरोहणको गीत।"]},{"type":"verse","number":1,"content":[{"text":"“मेरो युवावस्थादेखि तिनीहरूले मलाई धेरै सताएका छन्,”","poem":1},{"text":"इस्राएलले यसो भनोस्;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“तिनीहरूले मेरो युवावस्थादेखि मलाई धेरै सताएका छन्;","poem":1},{"text":"तर तिनीहरूले मलाई जित्न सकेका छैनन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हलो जोत्नेहरूले मेरो पिठिउँमा जोतेका छन्;","poem":1},{"text":"र पिठिउँभरि लामा फालिहरूले कोरेका छन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तर याहवेह धार्मिक हुनुहुन्छ;","poem":1},{"text":"उहाँले दुष्‍टहरूका बन्धन तोडेर मलाई मुक्त गर्नुभएको छ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"सियोनलाई घृणा गर्नेहरू सबै","poem":1},{"text":"लज्जित भएर फर्किऊन्!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिनीहरू छानामाथिका घाँसजस्ता होऊन्,","poem":1},{"text":"जो बढ्न नपाउँदै ओइलाइहाल्छन्;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्यसबाट काट्नेले आफ्नो एक मुट्ठी पनि भर्न सक्दैन,","poem":1},{"text":"न बिटा बटुल्नेले एक अँगालो नै भर्न सक्दछ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"त्यहाँबाट भएर जानेहरूले तिनीहरूका निम्ति यस्तो कामना नगरून्,","poem":1},{"text":"“याहवेहको आशिष् तिमीहरूमाथि रहोस्;","poem":2},{"lineBreak":true},{"text":"याहवेहका नाममा हामी तिमीहरूलाई आशिष् दिन्छौँ।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}