{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, कहिलेसम्म? के सधैँभरिको लागि तपाईंले बिर्सनुहुन्छ?","poem":1},{"text":"तपाईंले आफ्नो मुहार मसँग कहिलेसम्म लुकाउनुहुन्छ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"कहिलेसम्म मैले आफ्नो चिन्ता बोक्ने,","poem":1},{"text":"र दिनहुँ मेरो हृदयमा शोक बोकिराख्ने?","poem":2},{"lineBreak":true},{"text":"मेरा शत्रुहरू कहिलेसम्म ममाथि विजयी भइरहने?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे याहवेह, मेरा परमेश्‍वर, मलाई हेर्नुहोस् र मलाई जवाफ दिनुहोस्;","poem":1},{"text":"मेरा आँखालाई ज्योति दिनुहोस्, नत्रता म मृत्युको निद्रामा पर्नेछु।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"नत्रता मेरो वैरीहरूले भन्‍नेछ, “मैले त्यसमाथि विजय पाएको छु,”","poem":1},{"text":"र जब म डगमगाउँछु, मेरा वैरीहरू रमाउनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तर मैले तपाईंको अचुक प्रेममा भरोसा राखेको छु;","poem":1},{"text":"मेरो हृदय तपाईंको मुक्तिमा रमाउँछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"म याहवेहको स्तुति गाउनेछु;","poem":1},{"text":"किनकि उहाँ मप्रति भलो हुनुहुन्छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}