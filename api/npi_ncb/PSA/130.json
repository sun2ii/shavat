{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["आरोहणको गीत।"]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, गहिराइहरूबाट म तपाईंलाई पुकार्छु;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"हे प्रभु, मेरो सोर सुन्‍नुहोस्;","poem":2},{"text":"दयाको निम्ति गरिएको मेरो पुकारलाई","poem":1},{"text":"तपाईंका कानहरूले ध्यान देऊन्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे याहवेह, यदि तपाईंले पापको लेखा राख्नुभयो भने,","poem":1},{"text":"हे प्रभु, को खडा हुन सक्छ र?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तर तपाईं क्षमाशील हुनुहुन्छ,","poem":1},{"text":"त्यसैले हामी श्रद्धापूर्वक तपाईंको सेवा गर्दछौँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"म याहवेहलाई पर्खन्छु, मेरा सारा जीवनले उहाँको बाटो हेर्दछ,","poem":1},{"text":"अनि उहाँको वचनमा म आशा राख्दछु।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"पालेले बिहानको प्रतीक्षा गरेको भन्दा बढी,","poem":1},{"text":"हो, पालेले बिहानको प्रतीक्षा गरेको भन्दा बढी,","poem":2},{"lineBreak":true},{"text":"म प्रभुको प्रतीक्षा गर्दछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे इस्राएल, याहवेहमा आफ्नो आशा राख्;","poem":1},{"text":"किनकि याहवेहसँग नै अचुक प्रेम छ;","poem":2},{"lineBreak":true},{"text":"र उहाँसित नै पूर्ण उद्धार छ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"उहाँ आफैँले इस्राएललाई","poem":1},{"text":"तिनीहरूका सबै पापहरूबाट छुटाउनुहुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}