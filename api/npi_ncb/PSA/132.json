{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["आरोहणको गीत।"]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, दावीद","poem":1},{"text":"र तिनले भोगेका सबै दुःखलाई सम्झनुहोस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"तिनले याहवेहसँग शपथ खाए,","poem":1},{"text":"तिनले याकोबका सर्वशक्तिमान्‌सँग भाकल गरे:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“म, तबसम्म आफ्नो घरमा पस्‍नेछैनँ,","poem":1},{"text":"वा आफ्नो ओछ्यानमा सुत्नेछैनँ,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"म मेरा आँखाहरूमा निद्रा आउन दिनेछैनँ,","poem":1},{"text":"र आँखाहरूका पलकहरूलाई उँघ्न पनि दिनेछैनँ;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जबसम्म याहवेहका निम्ति एउटा ठाउँ","poem":1},{"text":"र याकोबका सर्वशक्तिमान्‌को निम्ति म एउटा वासस्थान भेट्टाउँदिनँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"हामीले एप्रातामा त्यसको","poem":1},{"noteId":98},{"text":"विषयमा सुन्यौँ;","poem":1},{"text":"हामीले याआरको","poem":2},{"noteId":99},{"text":"मैदानमा त्यसलाई भेट्टायौँ:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“हामी उहाँका वासस्थानमा जाऔँ;","poem":1},{"text":"यसो भन्दै उहाँका पाउदानमा दण्डवत् गरौँ,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"‘हे याहवेह, उठ्नुहोस्, तपाईं र तपाईंको शक्तिको चिन्ह सन्दुकसमेत,","poem":1},{"text":"तपाईंको विश्रामस्थलभित्र आउनुहोस्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तपाईंका पुजारीहरूले तपाईंको धार्मिकताको वस्त्र पहिरिऊन्;","poem":1},{"text":"र तपाईंका विश्‍वासयोग्य जनहरू आनन्दले जयजयकार गरून्!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"आफ्ना सेवक दावीदको निम्ति,","poem":1},{"text":"तपाईंका अभिषिक्त जनलाई अस्वीकार नगर्नुहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"याहवेहले दावीदसँग शपथ खानुभयो;","poem":1},{"text":"एउटा पक्‍का शपथ, जुन उहाँले फिर्ता लिनुहुनेछैन:","poem":2},{"text":"“म तेरो सिंहासनमा","poem":1},{"text":"तेरा सन्तानहरूमध्ये एक जनालाई बसाल्नेछु।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"यदि तेरा छोराहरूले मेरो करार","poem":1},{"text":"र मैले सिकाएका मेरा विधिहरू पालन गरे भने,","poem":2},{"text":"तिनीहरूका छोराहरू पनि","poem":1},{"text":"सदासर्वदाको निम्ति तेरो सिंहासनमा बस्‍नेछन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"किनकि याहवेहले सियोनलाई चुन्‍नुभएको छ;","poem":1},{"text":"उहाँले त्यसलाई आफ्नो वासस्थान बनाउने इच्छा गर्नुभएको छ;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“यो सदासर्वदाको निम्ति मेरो विश्रामको स्थान हो;","poem":1},{"text":"म यहीँ सिंहासनमा बस्‍नेछु; किनकि मैले यस्तै इच्छा गरेको छु।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"प्रशस्त खानपानका थोकले म त्यसलाई आशिष् दिनेछु;","poem":1},{"text":"र त्यसका गरिबहरूलाई म रोटीले तृप्‍त पार्नेछु।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"त्यसका पुजारीहरूलाई पनि म मुक्तिको वस्त्र पहिराउनेछु;","poem":1},{"text":"र त्यसका विश्‍वासयोग्य जनहरू आनन्दले सधैँ जयजयकार गर्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“यहाँ दावीदको निम्ति म एउटा सिङको","poem":1},{"noteId":100},{"text":"टुसा उमार्नेछु;","poem":1},{"text":"र मेरा अभिषिक्त जनको निम्ति बत्ती तयार गर्नेछु।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"म त्यसका शत्रुहरूलाई शर्मको वस्त्र पहिराउनेछु;","poem":1},{"text":"तर त्यसको शिर भने प्रकाशमय मुकुटले शोभायमान हुनेछ।”","poem":2}]}],"footnotes":[{"noteId":98,"caller":"+","text":"अथवा करारको सन्दुक","reference":{"chapter":132,"verse":6}},{"noteId":99,"caller":"+","text":"1 इति 13:5, 6मा हेर्नुहोस्","reference":{"chapter":132,"verse":6}},{"noteId":100,"caller":"+","text":"सिङ यसले शक्तिशाली भन्‍ने जनाउँछ, जो राजा हुन्","reference":{"chapter":132,"verse":17}}]},"thisChapterLink":"/api/npi_ncb/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}