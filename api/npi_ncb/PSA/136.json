{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहलाई धन्यवाद देओ, किनकि उहाँ भलो हुनुहुन्छ।","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":2,"content":[{"text":"देवताहरूका परमेश्‍वरलाई धन्यवाद देओ;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":3,"content":[{"text":"प्रभुहरूका प्रभुलाई धन्यवाद देओ:","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"उहाँलाई धन्यवाद देओ, उहाँले मात्र ठूला अद्‌भुत कार्यहरू गर्नुहुन्छ;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":5,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले आफ्ना समझशक्तिले आकाश सृष्‍टि गर्नुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":6,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले पानीमाथि पृथ्वी फैलाउनुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":7,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले विशाल ज्योतिहरू बनाउनुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":8,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले दिनमा प्रभुत्व गर्नलाई सूर्य बनाउनुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":9,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले रातमा प्रभुत्व गर्नलाई चन्द्रमा र ताराहरू बनाउनुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले इजिप्टका पहिले जन्मेकाहरूलाई प्रहार गर्नुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":11,"content":[{"text":"र उहाँलाई धन्यवाद देओ, जसले तिनीहरूको बीचबाट इस्राएललाई निकालेर ल्याउनुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":12,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले शक्तिशाली हात","poem":1},{"text":"र पराक्रमी पाखुराले तिनीहरूलाई निकालेर ल्याउनुभयो;","poem":2},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले लाल समुद्रलाई","poem":1},{"noteId":102},{"text":"दुई भागमा विभाजन गर्नुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":14,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले इस्राएललाई त्यसको बीचबाट पार गराउनुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":15,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले फारो र तिनका सेनालाई लाल समुद्रमा डुबाइदिनुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले आफ्ना प्रजालाई उजाडस्थानबाट भएर डोर्‍याउनुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले ठूला-ठूला राजालाई नाश पार्नुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":18,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले शक्तिशाली राजालाई मार्नुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":19,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले एमोरीहरूका राजा सीहोनलाई मार्नुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":20,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले बाशानका राजा ओगलाई मार्नुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":21,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले तिनीहरूका देश पैतृक सम्पत्तिको रूपमा दिनुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":22,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले आफ्ना सेवक","poem":1},{"text":"इस्राएललाई पैतृक सम्पत्तिको रूपमा दिनुभयो।","poem":2},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले हामी सबैलाई हाम्रा दुर्दशामा स्मरण गर्नुभयो;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":24,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले हाम्रा शत्रुहरूबाट हामीलाई छुटाउनुभयो।","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"verse","number":25,"content":[{"text":"उहाँलाई धन्यवाद देओ, जसले हरेक प्राणीलाई भोजन दिनुहुन्छ।","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"स्वर्गका परमेश्‍वरलाई धन्यवाद देओ;","poem":1},"उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।"]}],"footnotes":[{"noteId":102,"caller":"+","text":"अथवा निगालोहरू भएको समुद्र","reference":{"chapter":136,"verse":13}}]},"thisChapterLink":"/api/npi_ncb/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}