{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"बेबिलोनका नदीहरूको किनारमा बसेर,","poem":1},{"text":"हामी सियोनलाई सम्झँदै रोयौँ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"त्यहाँका लहरे पीपलहरूमा","poem":1},{"text":"हामीले आफ्ना वीणाहरू झुण्ड्यायौँ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"किनकि हामीलाई बन्दी बनाएर लानेहरूले त्यहाँ हामीलाई गीत गाउन लगाए;","poem":1},{"text":"हामीलाई यातना दिनेहरूले हर्षका गीतको माग गरे।","poem":2},{"lineBreak":true},{"text":"तिनीहरूले भने, “हाम्रा निम्ति सियोनका गीतहरूमध्ये एउटा गीत गाओ!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"बिरानो देशमा हुँदा कसरी हामी","poem":1},{"text":"याहवेहको गीत गाउन सक्छौँ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे यरूशलेम, यदि मैले तँलाई बिर्सेको भए,","poem":1},{"text":"मेरो दाहिने हातले आफ्नो सिप भूलोस्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यदि मैले तँलाई नसम्झेको भए,","poem":1},{"text":"यदि मैले यरूशलेमलाई","poem":2},{"text":"आफ्नो सर्वोच्‍च आनन्द नमानेको भए,","poem":1},{"text":"मेरो जिब्रो मुखको तालुमा टाँसिजाओस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे याहवेह, यरूशलेमको पतन भएको दिन,","poem":1},{"text":"एदोमीहरूले के गरे, सम्झनुहोस्।","poem":2},{"text":"तिनीहरूले चीत्कार गरे,","poem":1},{"text":"“त्यसलाई भत्काओ, जगदेखि नै त्यसलाई भत्काओ!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"सर्वनाश हुन लागेकी, हे बेबिलोनकी छोरी,","poem":1},{"text":"तैँले हामीमाथि जे गरिस्, त्यसको लागि","poem":2},{"lineBreak":true},{"text":"तँमाथि प्रतिशोध लिने मानिस धन्य हुनेछ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यो धन्य हुनेछ, जसले तेरा स-साना बच्‍चाहरूलाई खोस्छ","poem":1},{"text":"र तिनीहरूलाई चट्टानमा पछार्दछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}