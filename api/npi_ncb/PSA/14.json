{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"मूर्खले","poem":1},{"noteId":15},{"text":"आफ्नो मनमा भन्छ,","poem":1},{"text":"“परमेश्‍वर छँदैछैन।”","poem":2},{"text":"तिनीहरू भ्रष्‍ट छन्, तिनीहरूले नीच काम गर्दछन्;","poem":1},{"text":"असल काम गर्ने कोही पनि छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"याहवेहले स्वर्गबाट","poem":1},{"text":"सबै मानिस जातिलाई हेर्नुहुन्छ,","poem":2},{"text":"यो जान्‍नलाई कि कोही त समझदार होला,","poem":1},{"text":"जसले परमेश्‍वरको खोजी गर्दछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरू सबै भड्किगएका छन्, सबै जना भ्रष्‍ट भएका छन्","poem":1},{"noteId":16},{"text":";","poem":1},{"text":"असल गर्ने कोही छैन;","poem":2},{"lineBreak":true},{"text":"एक जना पनि छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"के यी सबै दुष्‍ट काम गर्नेहरूले केही पनि जान्दैनन्?","poem":1},{"lineBreak":true},{"text":"रोटी खाएझैँ तिनीहरूले मेरा मानिसहरूलाई खान्छन्;","poem":1},{"text":"तिनीहरूले याहवेहलाई कहिल्यै पुकार्दैनन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तर त्यहाँ तिनीहरू डरले काम्छन्;","poem":1},{"text":"किनकि धर्मीहरूको समूहमा परमेश्‍वर उपस्थित हुनुहुन्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिमी दुष्‍ट काम गर्नेहरूले गरिबका योजनाहरूलाई विफल पार्छौ;","poem":1},{"text":"तर याहवेह नै तिनीहरूका शरणस्थान हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"अहो, इस्राएलको मुक्ति सियोनबाट आएको भए त कति असल हुनेथियो!","poem":1},{"text":"जब याहवेहले आफ्नो मानिसहरूको सुदिन फर्काइदिनुहुन्छ,","poem":2},{"lineBreak":true},{"text":"तब याकोब रमाओस्, र इस्राएल आनन्दित होस्।","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"भजनसंग्रहअनुसार नैतिकताको कमी भएको व्यक्तिलाई मूर्ख भनिन्छ।","reference":{"chapter":14,"verse":1}},{"noteId":16,"caller":"+","text":"रोमी 3:12","reference":{"chapter":14,"verse":3}}]},"thisChapterLink":"/api/npi_ncb/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}