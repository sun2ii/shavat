{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["दावीदको मस्किल;",{"noteId":104},"गुफामा हुँदा उनको प्रार्थना।"]},{"type":"verse","number":1,"content":[{"text":"उच्‍च सोरले म याहवेहलाई पुकार्दछु;","poem":1},{"text":"दयाको निम्ति याहवेहमा म आफ्नो आवाज उचाल्छु।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"उहाँको सामु म आफ्नो उजुर पोख्दछु;","poem":1},{"text":"उहाँको सामु म आफ्नो पीडा प्रकट गर्दछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"मेरो आत्मा मभित्र व्याकुल हुँदा,","poem":1},{"text":"त्यो तपाईं नै हुनुहुन्छ, जसले मेरो मार्ग जान्‍नुहुन्छ।","poem":2},{"text":"म हिँड्ने मार्गमा","poem":1},{"text":"मानिसहरूले मेरो निम्ति पासो थापेका छन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मेरो दाहिने हातपट्टि हेर्नुहोस्;","poem":1},{"text":"कसैलाई मेरो वास्ता छैन।","poem":2},{"text":"मेरो शरणस्थान कहीँ छैन;","poem":1},{"text":"कसैले मेरो जीवनको वास्ता गर्दैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे याहवेह, म तपाईंलाई पुकार गर्छु;","poem":1},{"text":"म भन्दछु, “तपाईं मेरो शरणस्थान हुनुहुन्छ,","poem":2},{"lineBreak":true},{"text":"अनि जीवितहरूका देशमा मेरो भाग हुनुहुन्छ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मेरो पुकार सुनिदिनुहोस्;","poem":1},{"text":"किनकि म ज्यादै नम्र भएको छु;","poem":2},{"text":"मलाई खेद्नेहरूबाट मलाई बचाउनुहोस्;","poem":1},{"text":"किनकि तिनीहरू मभन्दा धेरै बलिया छन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मेरो कैदबाट मलाई छुटाउनुहोस्;","poem":1},{"text":"ताकि म तपाईंको नामको प्रशंसा गर्न सकूँ।","poem":2},{"text":"म प्रतिको तपाईंको भलाइको कारण,","poem":1},{"text":"धर्मीहरू मेरा चारैतिर भेला हुनेछन्।","poem":2}]}],"footnotes":[{"noteId":104,"caller":"+","text":"शीर्षक: सम्भवतः एक साहित्यिक वा साङ्गीतिक शब्द।","reference":{"chapter":142,"verse":0}}]},"thisChapterLink":"/api/npi_ncb/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}