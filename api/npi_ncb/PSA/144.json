{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":144,"content":[{"type":"hebrew_subtitle","content":["दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"याहवेह मेरा चट्टानलाई प्रशंसा होस्,","poem":1},{"text":"जसले मेरा हातहरूलाई युद्धकला,","poem":2},{"lineBreak":true},{"text":"र मेरा औँलाहरूलाई लडाइँ गर्न सिकाउनुहुन्छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"उहाँ मेरो प्रेमिलो परमेश्‍वर, र मेरो किल्‍ला हुनुहुन्छ;","poem":1},{"text":"उहाँ मेरो बलियो किल्‍ला र मेरो उद्धारक,","poem":2},{"text":"मेरो ढाल, जसमा म शरण लिन्छु,","poem":1},{"text":"उहाँले जाति-जातिहरूलाई मेरो अधीनमा राख्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे याहवेह, मानव-जाति के हो र तपाईं त्यसको वास्ता गर्नुहुन्छ,","poem":1},{"text":"मरणशील मानिस को हो, र तपाईं त्यसको विचार गर्नुहुन्छ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरू त केवल सासजस्तो मात्र हुन्;","poem":1},{"text":"तिनीहरूका आयु ढलिजाने छायाजस्तै मात्र हुन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे याहवेह, आफ्ना स्वर्गहरूलाई खोल्नुहोस् र तल ओर्लनुहोस्;","poem":1},{"text":"पर्वतहरूलाई छुनुहोस् र तीबाट धुवाँ उठोस्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"बिजुली चम्काउनुहोस् र मेरा शत्रुहरूलाई तितरबितर पार्नुहोस्!","poem":1},{"text":"आफ्ना काँडहरू छोडेर तिनीहरूलाई अलमलमा पारिदिनुहोस्!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उच्‍च स्थानबाट आफ्ना हात लम्काउनुहोस्;","poem":1},{"text":"अनि उर्लंदो बाढीबाट","poem":2},{"text":"र विदेशीहरूका हातबाट","poem":1},{"text":"मलाई उद्धार गर्नुहोस् र छुटाउनुहोस्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जसका मुख झूटले भरिएका छन्,","poem":1},{"text":"जसका दाहिने हात छली छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"हे मेरा परमेश्‍वर, म तपाईंको निम्ति एउटा नयाँ गीत गाउनेछु;","poem":1},{"text":"दशतारे वीणा बजाएर म तपाईंको निम्ति सङ्गीत बजाउनेछु,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"उहाँलाई, जसले राजाहरूलाई विजय दिनुहुन्छ;","poem":1},{"text":"जसले आफ्नो सेवक दावीदलाई छुटकारा दिनुहुन्छ।","poem":2},{"lineBreak":true},{"text":"घातक तरवारबाट","poem":1}]},{"type":"verse","number":11,"content":[{"text":"मलाई छुटकारा दिनुहोस्;","poem":1},{"text":"विदेशीहरूका हातबाट उद्धार गरिदिनुहोस्;","poem":2},{"text":"जसको मुख झूटले भरिएको छ,","poem":1},{"text":"जसको दाहिने हात छली छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"तब हाम्रा छोराहरू तिनीहरूका युवाअवस्थामा","poem":1},{"text":"मौलाउँदा रूखहरूजस्ता हुनेछन्,","poem":2},{"text":"र हाम्रा छोरीहरू दरबार सिँगार्न कुँदिएका","poem":1},{"text":"स्तम्भहरूजस्ता हुनेछन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"हाम्रा धनसारहरू","poem":1},{"text":"हरेक किसिमका अन्‍नले भरिभराउ हुनेछन्;","poem":2},{"text":"हाम्रा भेडाहरू हजारौँ गुणा बढ्नेछन्,","poem":1},{"text":"हाम्रा खेतमा ती लाखौँ हुनेछन्;","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"हाम्रा गोरुहरूले गह्रौँ भारी बोक्नेछन्।","poem":2},{"text":"जहाँ पर्खालहरू फोरिनेछैनन्;","poem":1},{"text":"हामी निर्वासनमा जानुपर्नेछैन;","poem":2},{"lineBreak":true},{"text":"हाम्रा सडकहरूमा विलापको रुवाइ हुनेछैन।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"धन्यका हुन् ती प्रजाहरू; जसको जीवनमा यो सत्य साबित भएको छ;","poem":1},{"text":"धन्यका हुन् ती प्रजाहरू, जसका परमेश्‍वर याहवेह हुनुहुन्छ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}