{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहको प्रशंसा गर!","poem":1},{"noteId":106},{"lineBreak":true},{"text":"हे मेरो प्राण, याहवेहको प्रशंसा गर्!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"म मेरो जीवनभरि याहवेहको प्रशंसा गर्नेछु;","poem":1},{"text":"म बाँचुन्जेल मेरा परमेश्‍वरको प्रशंसा गाउनेछु।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"शासकहरूमाथि भरोसा नगर;","poem":1},{"text":"मानव-जातिमाथि, जसले बचाउन सक्दैन।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जब तिनीहरूको आत्मा निस्कन्छ; तिनीहरू माटोमै फर्कन्छन्;","poem":1},{"text":"त्यही दिन नै तिनीहरूका योजनाहरू पनि व्यर्थ हुन्छन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"धन्य हुन् तिनीहरू, जसका सहायक याकोबका परमेश्‍वर हुनुहुन्छ,","poem":1},{"text":"जसको आशा याहवेह तिनीहरूका परमेश्‍वरमा हुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"उहाँ स्वर्ग र पृथ्वी,","poem":1},{"text":"समुद्र र त्यसमा भएका सबै थोकका सृष्‍टिकर्ता हुनुहुन्छ;","poem":2},{"lineBreak":true},{"text":"उहाँ सदाकाल विश्‍वासयोग्य रहनुहुन्छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उहाँले थिचोमिचोमा परेकाहरूको पक्षमा भएर न्याय गर्नुहुन्छ;","poem":1},{"text":"र भोकाएकाहरूलाई भोजन दिनुहुन्छ।","poem":2},{"text":"याहवेहले कैदीहरूलाई स्वतन्त्र गरिदिनुहुन्छ;","poem":1}]},{"type":"verse","number":8,"content":[{"text":"याहवेहले दृष्‍टिविहीनहरूका आँखा खोलिदिनुहुन्छ;","poem":2},{"text":"र दबिएकाहरूलाई उठाउनुहुन्छ;","poem":1},{"text":"याहवेहले धर्मी जनहरूलाई प्रेम गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेहले विदेशीहरूको रक्षा गर्नुहुन्छ;","poem":1},{"text":"अनाथ र विधवाहरूलाई सम्हाल्नुहुन्छ;","poem":2},{"lineBreak":true},{"text":"तर दुष्‍टहरूको योजनालाई विफल पारिदिनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"याहवेहले सदासर्वदा राज्य गर्नुहुन्छ।","poem":1},{"text":"हे सियोन, तेरा परमेश्‍वरले सारा पुस्तौँ-पुस्तासम्म राज्य गर्नुहुनेछ।","poem":2},{"lineBreak":true},{"text":"याहवेहको प्रशंसा गर!","poem":1}]}],"footnotes":[{"noteId":106,"caller":"+","text":"मूल भाषामा हल्‍लेलूयाह ; 10पदमा पनि","reference":{"chapter":146,"verse":1}}]},"thisChapterLink":"/api/npi_ncb/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}