{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहको प्रशंसा गर!","poem":1},{"noteId":107},{"lineBreak":true},{"text":"हाम्रा परमेश्‍वरको स्तुति गाउनु असल हो;","poem":1},{"text":"उहाँको प्रशंसा गर्नु कत्ति आनन्दमय र उचित छ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"याहवेहले यरूशलेमलाई पुनर्निर्माण गर्नुहुन्छ;","poem":1},{"text":"उहाँले इस्राएलका निर्वासितहरूलाई एकिकृत गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उहाँले हृदय टुटेकाहरूलाई निको पार्नुहुन्छ,","poem":1},{"text":"र तिनीहरूका चोटहरूमा मलमपट्टी बाँधिदिनुहुन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उहाँले ताराहरूको संख्या तोक्नुहुन्छ;","poem":1},{"text":"र ती सबैलाई नामद्वारा बोलाउनुहुन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हाम्रा प्रभु महान् र शक्तिशाली हुनुहुन्छ;","poem":1},{"text":"उहाँको समझशक्तिको कुनै सीमा छैन।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"याहवेहले नम्रहरूलाई सम्हाल्नुहुन्छ;","poem":1},{"text":"तर दुष्‍टलाई भुइँमा खसाल्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"कृतज्ञतासहित याहवेहका निम्ति गाओ;","poem":1},{"text":"वीणाको सङ्गीत बजाउँदै हाम्रा परमेश्‍वरको स्तुति गाओ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"उहाँले आकाशलाई बादलले ढाक्नुहुन्छ,","poem":1},{"text":"र पृथ्वीलाई वर्षा दिनुहुन्छ;","poem":2},{"lineBreak":true},{"text":"अनि पहाडहरूमा घाँस उमार्नुहुन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"उहाँले पशुहरूलाई आहारा दिनुहुन्छ,","poem":1},{"text":"र कागका बचेराहरू कराउँदा तिनीहरूलाई खुवाउनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"उहाँको आनन्द घोडाको बलमा होइन,","poem":1},{"text":"न त योद्धाका खुट्टामा उहाँ प्रसन्‍न हुनुहुन्छ;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तर याहवेह उहाँको भय मान्‍नेहरूसँग,","poem":1},{"text":"उहाँको अचुक प्रेममाथि भरोसा राख्नेहरूसँग प्रसन्‍न हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"हे यरूशलेम, याहवेहको स्तुति गर्!","poem":1},{"text":"हे सियोन, आफ्ना परमेश्‍वरको प्रशंसा गर्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"उहाँले तेरा ढोकाहरूका आग्लोहरू बलियो पारिदिनुहुन्छ;","poem":1},{"text":"अनि तँभित्र बास गर्ने जातिलाई आशिष् दिनुहुन्छ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"उहाँले तेरा सिमानाहरूमा शान्ति ल्याउनुहुन्छ,","poem":1},{"text":"उहाँले तँलाई असल गहुँले सन्तुष्‍ट पार्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"उहाँले पृथ्वीमा आफ्नो आदेश पठाउनुहुन्छ;","poem":1},{"text":"उहाँको उर्दी द्रूत गतिमा प्रसार हुन्छ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"उहाँले हिउँलाई ऊनजस्तै फैलाउनुहुन्छ;","poem":1},{"text":"अनि तुसारोलाई खरानीझैँ छरिदिनुहुन्छ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"उहाँले असिना कङ्कढझैँ बर्साउनुहुन्छ;","poem":1},{"text":"उहाँका कठ्याङग्रिने चिसोमा को टिक्न सक्छ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"उहाँले आफ्ना वचन पठाउनुहुन्छ र ती पगाल्नुहुन्छ;","poem":1},{"text":"उहाँले आफ्नो बतास चलाउनुहुन्छ, र पानी बग्न थाल्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"उहाँले आफ्नो वचन याकोबलाई,","poem":1},{"text":"अनि आफ्ना नियम र आदेशहरू इस्राएललाई प्रकट गर्नुभएको छ।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"उहाँले अरू जातिको निम्ति यस्तो कार्य गर्नुभएको छैन;","poem":1},{"text":"तिनीहरूले उहाँका नियमहरू जान्दैनन्।","poem":2},{"lineBreak":true},{"text":"याहवेहको प्रशंसा गर!","poem":1}]}],"footnotes":[{"noteId":107,"caller":"+","text":"मूल भाषामा हल्‍लेलूयाह ; 20पदमा पनि","reference":{"chapter":147,"verse":1}}]},"thisChapterLink":"/api/npi_ncb/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}