{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहको प्रशंसा गर!","poem":1},{"noteId":110},{"lineBreak":true},{"text":"याहवेहको निम्ति एउटा नयाँ गीत गाओ,","poem":1},{"text":"उहाँको प्रशंसा उहाँका विश्‍वासयोग्य जनहरूका सभामा छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"इस्राएल आफ्ना सृष्‍टिकर्तामा आनन्दित होओस्;","poem":1},{"text":"सियोनका मानिसहरू तिनीहरूका राजामा रमाऊन्!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरूले नाच्दै उहाँको नामको प्रशंसा गरून्;","poem":1},{"text":"र उहाँको निम्ति खैँजडी र वीणाको सङ्गीत बजाऊन्!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"किनकि याहवेह आफ्ना प्रजासित प्रसन्‍न हुनुहुन्छ;","poem":1},{"text":"उहाँले नम्रहरूलाई विजयको मुकुट पहिर्‍याइदिनुहुन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उहाँका विश्‍वासयोग्य जनहरूले यस्तो सम्मानमा आनन्द मनाऊन्;","poem":1},{"text":"र तिनीहरूले आनन्दको निम्ति आ-आफ्ना ओछ्यानमा गाऊन्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"तिनीहरूका मुखमा परमेश्‍वरको प्रशंसा होस्,","poem":1},{"text":"र तिनीहरूका हातमा दुईधारे तरवार होस्,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ताकि राष्ट्रहरूका विरुद्धमा तिनीहरूले बदला लिनका निम्ति,","poem":1},{"text":"र जाति-जातिहरूलाई दण्ड दिन;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरूका राजालाई साङ्लाहरूले,","poem":1},{"text":"र तिनीहरूका भारदारलाई फलामका साङ्लाहरूले बाँध्न;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरूका विरुद्ध लेखिएका मृत्युदण्ड दिन सकून्—","poem":1},{"text":"यही नै उहाँका सबै विश्‍वासयोग्य जनहरूको महिमा हो।","poem":2},{"lineBreak":true},{"text":"याहवेहको प्रशंसा गर!","poem":1}]}],"footnotes":[{"noteId":110,"caller":"+","text":"मूल भाषामा हल्‍लेलूयाह ; 9पदमा पनि","reference":{"chapter":149,"verse":1}}]},"thisChapterLink":"/api/npi_ncb/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}