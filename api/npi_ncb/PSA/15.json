{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, तपाईंको पवित्र वासस्थानमा कसले बास गर्न पाउनेछ?","poem":1},{"text":"तपाईंको पवित्र पर्वतमा कसले बस्‍न पाउनेछ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"त्यो मानिस, जसको जीवन निर्दोष छ;","poem":1},{"text":"जसले धर्मी काम गर्छ,","poem":2},{"lineBreak":true},{"text":"जसले आफ्नो हृदयबाट सत्य बोल्छ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जसको जिब्रोले अरूको निन्दा गर्दैन,","poem":1},{"text":"जसले आफ्नो छिमेकीको खराबी गर्दैन,","poem":2},{"lineBreak":true},{"text":"र मित्रहरूको अपमान गर्दैन;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जसले दुष्‍ट मानिसलाई घृणा गर्दछ,","poem":1},{"text":"तर याहवेहको भय मान्‍नेहरूलाई आदर गर्दछ;","poem":2},{"text":"जसले आफ्नो हानि हुँदा पनि आफूले शपथ खाएको कुरा बदल्दैन,","poem":1},{"text":"र जसले आफ्नो मन बदल्दैन;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जसले आफ्नो रकम खाँचोमा परेकालाई ब्याजमा लाउँदैन;","poem":1},{"text":"र जसले निर्दोषको विरुद्धमा घूस लिँदैन।","poem":2},{"lineBreak":true},{"text":"यस्ता जीवन जिउनेहरू","poem":1},{"text":"कहिल्यै पनि डगमगाउनेछैन।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}