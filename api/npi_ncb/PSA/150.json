":6,"content":[{"text":"सास हुने हरेकले याहवेहको प्रशंसा गरून्!","poem":1},{"lineBreak":true},{"text":"याहवेहको प्रशंसा गर!","poem":1}]}],"footnotes":[{"noteId":111,"caller":"+","text":"मूल भाषामा हल्‍लेलूयाह ; 6पदमा पनि","reference":{"chapter":150,"verse":1}}]},"thisChapterLink":"/api/npi_ncb/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}