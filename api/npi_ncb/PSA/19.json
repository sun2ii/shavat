{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"आकाशले परमेश्‍वरको महिमाको वर्णन गर्दछ;","poem":1},{"text":"अन्तरिक्ष मण्डलले उहाँका हातका कामहरू प्रकट गर्दछन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हरेक दिनले अर्को दिनसँग परमेश्‍वरको महिमाको चर्चा गर्दछ;","poem":1},{"text":"हरेक रातले अर्को रातलाई उहाँका ज्ञानको प्रदर्शन गर्दछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरू बोल्दैनन्, न त तिनीहरूको बोल्ने शब्दहरू नै छन्;","poem":1},{"text":"तिनीहरूबाट कुनै सोर सुनिँदैन।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तरै पनि तिनीहरूका सोर","poem":1},{"noteId":25},{"text":"सारा पृथ्वीभरि पुग्दछ;","poem":1},{"text":"तिनीहरूका आवाज संसारको अन्त्यसम्म पुगेका छन्।","poem":2},{"text":"परमेश्‍वरले आकाशमा सूर्यको निम्ति एउटा वासस्थान बनाउनुभएको छ।","poem":1}]},{"type":"verse","number":5,"content":[{"text":"जुनचाहिँ विवाह-मण्डपबाट निस्केको दुलहाझैँ छ,","poem":2},{"lineBreak":true},{"text":"दौडमा दौडिने धावकको विजयमा झैँ रमाउँछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"त्यो आकाशको एक कुनाबाट उदाउँछ,","poem":1},{"text":"र अर्को कुनासम्म चक्‍कर लगाउँछ;","poem":2},{"lineBreak":true},{"text":"त्यसको तापबाट कुनै कुरो लुकिरहन सक्दैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेहका व्यवस्थाहरू सिद्ध छन्,","poem":1},{"text":"प्राणलाई ताजा गराउने,","poem":2},{"text":"याहवेहका कानुनहरू विश्‍वासयोग्य छन्;","poem":1},{"text":"सोझा व्यक्तिलाई बुद्धिमान् तुल्याउने।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"याहवेहका नियमहरू ठिक छन्,","poem":1},{"text":"हृदयलाई आनन्दित गराउने,","poem":2},{"text":"याहवेहका आज्ञाहरू उज्ज्वल छन्,","poem":1},{"text":"आँखालाई ज्योति दिने।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेहको भय स्वच्छ छ,","poem":1},{"text":"अनन्तकाल सम्मै स्थिर रहिरहने;","poem":2},{"text":"याहवेहका उर्दीहरू अटल छन्,","poem":1},{"text":"ती सबै धार्मिक सत्य छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ती सुनभन्दा पनि ज्यादै बहुमूल्य,","poem":1},{"text":"निखुर सुनभन्दा, अझ ज्यादा बहुमूल्य छन्;","poem":2},{"text":"ती महभन्दा मिठा,","poem":1},{"text":"चाकाबाट झर्दै गरेको महभन्दा मिठा छन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तीद्वारा तपाईंका सेवकले चेतावनी पाउँछ;","poem":1},{"text":"ती पालन गर्दा ठूलो प्रतिफल मिल्छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तर कसले आफ्ना भूलहरू छुट्ट्याउन सक्छन्?","poem":1},{"text":"मेरा गुप्‍त दोषहरू क्षमा गरिदिनुहोस्!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"आफ्नै स्वइच्छाले गरेका पापहरूबाट तपाईंले आफ्नो सेवकलाई जोगाउनुहोस्;","poem":1},{"text":"ममाथि ती प्रभुत्व हुन नपाओस्;","poem":2},{"text":"अनि म दोषरहित","poem":1},{"text":"र घोर अपराधहरूबाट निर्दोष हुनेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"हे याहवेह, मेरा चट्टान र मेरा उद्धारक!","poem":1},{"text":"मेरा मुखका वचनहरू र मेरा हृदयका ध्यान","poem":2},{"lineBreak":true},{"text":"तपाईंका दृष्‍टिमा ग्रहणयोग्य हुन सकून्।","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"मूल भाषामा नाप्‍ने रेखा","reference":{"chapter":19,"verse":4}}]},"thisChapterLink":"/api/npi_ncb/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}