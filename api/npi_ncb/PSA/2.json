{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"राष्ट्रहरू किन षड्यन्त्र","poem":1},{"noteId":0},{"text":"रच्दछन्,","poem":1},{"text":"अनि जाति-जातिहरू किन व्यर्थमा जाल रच्छन्?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेह र उहाँका अभिषिक्त जनका विरुद्धमा","poem":1},{"text":"पृथ्वीका राजाहरू खडा हुन्छन्,","poem":2},{"lineBreak":true},{"text":"र शासकहरू एकजुट भएर भेला भएका छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरू यसो भन्छन्, “आओ, हामी तिनीहरूका साङ्लाहरू छिनालौँ,","poem":1},{"text":"र तिनीहरूका बन्धनहरू फुकालौँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"स्वर्गमा विराजमान हुनुहुनेचाहिँ हाँस्‍नुहुन्छ;","poem":1},{"text":"प्रभुले तिनीहरूको उपहास गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"आफ्नो क्रोधमा उहाँले तिनीहरूलाई हप्काउनुहुन्छ,","poem":1},{"text":"र आफ्ना क्रोधमा तिनीहरूलाई यसो भन्दै भयभीत पार्नुहुन्छ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“मैले मेरो राजालाई नियुक्त गरेको छु,","poem":1},{"text":"मेरो पवित्र सियोन","poem":2},{"noteId":1},{"text":"पर्वतमा”, प्रभु घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":["म याहवेहको उर्दी घोषणा गर्नेछु:",{"lineBreak":true},{"text":"उहाँले मलाई आज्ञा गर्नुभयो, “तिमी मेरा पुत्र हौ;","poem":1},{"text":"आज म तिम्रो पिता भएको छु।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मसँग माग","poem":1},{"text":"र म राष्ट्रहरूलाई तिम्रो उत्तराधिकार तुल्याइदिनेछु,","poem":2},{"lineBreak":true},{"text":"र पृथ्वीको अन्तसम्म तिम्रो निज सम्पत्ति तुल्याइदिनेछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिमीले फलामको राजदण्डले तिनीहरूलाई पिस्‍नेछौ,","poem":1},{"noteId":2},{"text":"कुमालेको भाँडाझैँ तिनीहरूलाई टुक्रा-टुक्रा पार्नेछौ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"यसकारण हे राजाहरू हो, बुद्धिमान् होओ;","poem":1},{"text":"पृथ्वीका शासकहरू हो, सचेत होओ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"भयसाथ याहवेहको सेवा गर,","poem":1},{"text":"र कम्पनसाथ उहाँको आनन्द मनाओ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"उहाँको पुत्रलाई सम्मान","poem":1},{"noteId":3},{"text":"गर, नत्रता उहाँ क्रोधित हुनुहुनेछ,","poem":1},{"text":"र तिमीहरूको व्यवहारले विनाशमा पुर्‍याउला;","poem":2},{"text":"किनकि उहाँको क्रोध चाँडै दन्कन्छ।","poem":1},{"text":"धन्य हुन् तिनीहरू सबै, जो उहाँको शरणमा पर्दछन्।","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"केही प्राचीन पा.लि.हरूमा क्रोध भनिएको छ।","reference":{"chapter":2,"verse":1}},{"noteId":1,"caller":"+","text":"अथवा यरूशलेम","reference":{"chapter":2,"verse":6}},{"noteId":2,"caller":"+","text":"अथवा शासन गर्नेछौ।","reference":{"chapter":2,"verse":9}},{"noteId":3,"caller":"+","text":"यसले चुम्बन पनि जनाउन सक्छ, तर मूल भाषामा यो शब्दको अर्थ स्पष्‍ट छैन।","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/npi_ncb/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}