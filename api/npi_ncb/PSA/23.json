{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"याहवेह मेरा गोठाला हुनुहुन्छ, मलाई केही कुराको घटी हुँदैन।","poem":1}]},{"type":"verse","number":2,"content":[{"text":"उहाँले मलाई हरियो खर्कमा सुताउनुहुन्छ;","poem":2},{"text":"उहाँले मलाई शान्त पानीतिर डोर्‍याउनुहुन्छ।","poem":1}]},{"type":"verse","number":3,"content":[{"text":"उहाँले मेरो प्राणलाई पुनः ताजा पार्नुहुन्छ।","poem":2},{"text":"उहाँले आफ्नो नामको खातिर","poem":1},{"text":"मलाई धार्मिकताका मार्गहरूमा अगुवाइ गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मृत्युको अन्धकारमय","poem":1},{"text":"घाटीबाट भएर जानुपरे तापनि","poem":2},{"text":"म कुनै खतरादेखि डराउनेछैनँ;","poem":1},{"text":"किनकि तपाईं मेरो साथमा हुनुहुन्छ;","poem":2},{"text":"तपाईंको लहुरो र तपाईंको छडीले","poem":1},{"text":"मलाई सान्त्वना दिन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तपाईंले मेरा शत्रुहरूको सामु,","poem":1},{"text":"मेरो निम्ति भोज तयार पार्नुहुन्छ।","poem":2},{"text":"तपाईंले मेरो शीरलाई तेलले अभिषेक गर्नुहुन्छ;","poem":1},{"text":"मेरो कचौरा भरिएर पोखिन्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"निश्‍चय नै तपाईंको भलाइ र प्रेम","poem":1},{"text":"मेरो जीवनभरि हरेक दिन मेरो पछि लाग्नेछन्,","poem":2},{"text":"र म सधैँभरि","poem":1},{"text":"याहवेहको भवनमा बास गर्नेछु।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}