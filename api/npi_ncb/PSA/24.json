{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"पृथ्वी र यसमा भएका सबै थोक,","poem":1},{"text":"यो संसार र यसमा बास गर्ने सबै प्राणीहरू याहवेहकै हुन्;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"किनकि उहाँले पृथ्वीलाई समुद्रमाथि बसाल्नुभयो,","poem":1},{"text":"र पानीमाथि स्थापित गर्नुभयो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेहको डाँडामा को उक्लिन सक्ला?","poem":1},{"text":"उहाँको पवित्रस्थानमा को उभिन सक्ला?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यही नै, जसको हात निर्दोष छ, र जसको हृदय शुद्ध छ;","poem":1},{"text":"जसले मूर्तिमाथि भरोसा राख्दैन,","poem":2},{"lineBreak":true},{"text":"अथवा जसले झूटो ईश्‍वरको नाममा शपथ खाँदैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तिनीहरूले याहवेहबाट आशिष् पाउनेछन्,","poem":1},{"text":"र मुक्तिदाता परमेश्‍वरले तिनीहरूलाई धर्मी ठहराउनुहुनेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"उहाँलाई खोज्ने पुस्ताका मानिसहरू यस्तै हुन्छन्,","poem":1},{"text":"जसले तपाईंको दर्शन खोज्दछन्, हे याकोबका परमेश्‍वर। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे मूलढोकाहरू हो, आफ्ना शिर उच्‍च पार;","poem":1},{"text":"हे सनातनका द्वारहरू हो, आफ्ना शिर उठाओ,","poem":2},{"lineBreak":true},{"text":"ताकि महिमाका महाराजा प्रवेश गरून्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"यी महिमाका राजा को हुनुहुन्छ?","poem":1},{"text":"याहवेह, जो बलियो र शक्तिशाली हुनुहुन्छ,","poem":2},{"lineBreak":true},{"text":"याहवेह, जो लडाइँमा पराक्रमी हुनुहुन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे मूलढोकाहरू हो, आफ्ना शिर उच्‍च पार;","poem":1},{"text":"हे सनातनका ढोकाहरू हो, आफ्ना शिर उठाओ;","poem":2},{"lineBreak":true},{"text":"ताकि महिमाका महाराजा प्रवेश गरून्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"महिमाका यी महाराजाचाहिँ को हुनुहुन्छ?","poem":1},{"text":"सेनाहरूका याहवेह—","poem":2},{"lineBreak":true},{"text":"उहाँ नै महिमाका महाराजा हुनुहुन्छ। सेला","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}