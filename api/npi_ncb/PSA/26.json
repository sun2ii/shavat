{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, मलाई निर्दोष प्रमाणित गर्नुहोस्;","poem":1},{"text":"किनकि मैले दोषरहित जीवन जिएको छु;","poem":2},{"text":"ढलपल नभइकन","poem":1},{"text":"मैले याहवेहमा भरोसा राखेको छु।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे याहवेह, मलाई जाँच्नुहोस्; र मेरो पारख गर्नुहोस्।","poem":1},{"text":"मेरो हृदय र मन जाँचेर हेर्नुहोस्;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"किनकि तपाईंको अचुक प्रेम सधैँ मेरो सामु छ;","poem":1},{"text":"र म तपाईंको विश्‍वासयोग्यतामा हिँडेको छु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"म छली मानिसहरूसँग बस्दिनँ,","poem":1},{"text":"न त पाखण्डीहरूसँग म सङ्गत गर्छु।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"कुकर्मीहरूको झुण्डलाई म घृणा गर्दछु;","poem":1},{"text":"म दुष्‍ट काम गर्नेहरूसँग बस्‍न इन्कार गर्दछु।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"हे याहवेह, म आफ्ना हात निर्दोषतामा धुन्छु,","poem":1},{"text":"र तपाईंका वेदीको परिक्रमा गर्दछु।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उच्‍च सोरले म तपाईंको प्रशंसाको घोषणा गर्दछु,","poem":1},{"text":"र म तपाईंका सबै अचम्मका कामहरूको वर्णन गर्दछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे याहवेह, तपाईंको वासस्थान,","poem":1},{"text":"र तपाईंको महिमा रहने ठाउँलाई म प्रेम गर्दछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"पापीहरूसँग मेरो प्राण,","poem":1},{"text":"रक्तपिपासुहरूसँग मेरो जीवन नलिनुहोस्;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"जसका हातहरू दुष्‍ट योजनाहरूले भरिएका छन्,","poem":1},{"text":"र जसका दाहिने हात घूसले भरिएका छन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तर म त निर्दोष जीवन जिउँछु;","poem":1},{"text":"मेरो उद्धार गर्नुहोस् र ममाथि कृपालु हुनुहोस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"मेरा खुट्टाहरू समतल ठाउँमा खडा छन्;","poem":1},{"text":"ठूलो महासभामा म याहवेहको प्रशंसा गर्नेछु।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}