{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"याहवेह मेरो ज्योति र मेरो मुक्ति हुनुहुन्छ;","poem":1},{"text":"मैले कसको भय मान्‍नु?","poem":2},{"text":"याहवेह नै मेरो जीवनको किल्‍ला हुनुहुन्छ;","poem":1},{"text":"म कोसँग भयभीत हुनु?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"जब दुष्‍टहरू मलाई आक्रमण गर्न","poem":1},{"text":"मेरो विरुद्धमा अगि बढ्छन्,","poem":2},{"text":"जब मेरा शत्रुहरू र मेरा वैरीहरू ममाथि आइलाग्दछन्;","poem":1},{"text":"तब तिनीहरू ठक्‍कर खाएर लड्नेछन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"सेनाले मेरो विरुद्धमा छाउनी बनाए तापनि","poem":1},{"text":"मेरो हृदय डराउनेछैनँ;","poem":2},{"text":"मेरो विरुद्धमा लडाइँ चले तापनि","poem":1},{"text":"त्यस बेलामा पनि म पूरा निर्धक्‍क रहनेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"याहवेहसँग म एउटै कुरा माग्दछु,","poem":1},{"text":"म त्यसैको मात्र खोजी गर्दछु:","poem":2},{"text":"कि म आजीवन याहवेहको भवनमा रहन पाऊँ,","poem":1},{"text":"उहाँको सुन्दरता हेर्न पाऊँ,","poem":2},{"text":"र याहवेहको भवनमा उहाँलाई खोजी गर्न पाऊँ।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"किनकि सङ्कष्‍टका दिनमा","poem":1},{"text":"उहाँले मलाई उहाँको वासस्थानमा सुरक्षित राख्नुहुनेछ;","poem":2},{"text":"उहाँले आफ्नो पवित्र वासस्थानको छहारीमा मलाई लुकाउनुहुनेछ;","poem":1},{"text":"र एउटा चट्टानमाथि उच्‍च राख्नुहुनेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"तब मेरो वरिपरिका शत्रुहरूमाथि","poem":1},{"text":"मेरो शिर उच्‍च पारिनेछ;","poem":2},{"text":"उहाँको पवित्र वासस्थानमा म आनन्दको सोर सुनाउँदै बलिदान चढाउनेछु;","poem":1},{"text":"म भजन गाउनेछु, र याहवेहलाई प्रशंसा गर्नेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे याहवेह, जब म पुकार गर्छु, मेरो सोर सुन्‍नुहोस्;","poem":1},{"text":"ममाथि कृपालु हुनुहोस् र मलाई जवाफ दिनुहोस्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मेरो हृदयले तपाईंको विषयमा भन्दछ, “उहाँको मुहारको खोजी गर्।”","poem":1},{"text":"हे याहवेह, म तपाईंको मुहारको खोजी गर्नेछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मबाट तपाईंको मुहार नलुकाउनुहोस्;","poem":1},{"text":"तपाईंको सेवकलाई क्रोधमा नहटाउनुहोस्;","poem":2},{"lineBreak":true},{"text":"तपाईं मेरा सहायक हुनुभएको छ।","poem":2},{"text":"हे परमेश्‍वर, मेरा मुक्तिदाता,","poem":1},{"text":"मलाई नत्याग्नुहोस्; मलाई तिरस्कार नगर्नुहोस्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मेरा बुबाआमाले मलाई त्यागे तापनि","poem":1},{"text":"याहवेहले मलाई सम्हाल्नुहुनेछ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हे याहवेह, मलाई तपाईंका मार्ग सिकाउनुहोस्;","poem":1},{"text":"र मलाई अत्याचार गर्ने मानिसहरूको कारण,","poem":2},{"lineBreak":true},{"text":"मलाई सोझो मार्गमा अगुवाइ गर्नुहोस्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मेरा वैरीहरूका इच्छामा मलाई नछोडिदिनुहोस्;","poem":1},{"text":"किनकि मेरो विरुद्धमा झूटा साक्षीहरू खडा भएका छन्,","poem":2},{"lineBreak":true},{"text":"तिनीहरू खराब आरोप लगाउँछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"म यसमा अझ विश्‍वस्त छु:","poem":1},{"text":"म जीवितहरूको देशमा","poem":2},{"lineBreak":true},{"text":"याहवेहको भलाइ देख्नेछु।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"याहवेहको प्रतीक्षा गर;","poem":1},{"text":"बलियो र हृदयमा साहसिलो होऊ;","poem":2},{"lineBreak":true},{"text":"र याहवेहको प्रतीक्षा गर।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}