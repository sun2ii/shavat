{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["दावीदको भजन; आफ्नो छोरा अब्शालोमदेखि भाग्दा उनले लेखेको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, मेरा विरोधीहरू कति धेरै छन्!","poem":1},{"text":"मेरो विरुद्धमा कति धेरै जना खडा भएका छन्!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"धेरैले मेरो विषयमा यसो भन्दैछन्,","poem":1},{"text":"“परमेश्‍वरले त्यसलाई सहायता गर्नहुनेछैन।” सेला","poem":2},{"noteId":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"तर हे याहवेह, तपाईं मेरो चारैतिर ढाल हुनुहुन्छ;","poem":1},{"text":"तपाईं मेरो गौरव र मेरो शिर उच्‍च पारिदिने हुनुहुन्छ।","poem":2},{"noteId":5}]},{"type":"verse","number":4,"content":[{"text":"म ठूलो सोरमा याहवेहलाई पुकार गर्दछु,","poem":1},{"text":"र उहाँले आफ्नो पवित्र पर्वतबाट मलाई जवाफ दिनुहुन्छ। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"म पल्टन्छु र निदाउँछु;","poem":1},{"text":"म फेरि उठ्छु; किनकि याहवेहले नै मलाई सम्हाल्नुहुन्छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मेरो विरुद्धमा मेरा वरिपरि घेरा हाल्ने","poem":1},{"text":"दसौँ हजार शत्रुहरूसँग पनि म डराउनेछैनँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे याहवेह, उठ्नुहोस्;","poem":1},{"text":"हे मेरा परमेश्‍वर, मलाई उद्धार गर्नुहोस्!","poem":2},{"text":"मेरा सबै शत्रुहरूका गालामा चड्काउनुहोस्;","poem":1},{"text":"दुष्‍टहरूका दाँत भाँचिदिनुहोस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेहबाट छुटकारा आउँछ,","poem":1},{"text":"तपाईंको आशिष् तपाईंका प्रजामाथि रहोस्। सेला","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"मूल भाषामा यहाँ सेला शब्दको अर्थ अनिश्‍चित छ; सम्भवतः यो शब्दले यहाँ कुनै सङ्गीत सूचकलाई जनाएको हुनुपर्दछ।","reference":{"chapter":3,"verse":2}},{"noteId":5,"caller":"+","text":"मेरो शिर उच्‍च पारिदिने ले मलाई विजय दिने जनाउँछ","reference":{"chapter":3,"verse":3}}]},"thisChapterLink":"/api/npi_ncb/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}