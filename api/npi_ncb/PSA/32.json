{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["दावीदको मस्किल।",{"noteId":33}]},{"type":"verse","number":1,"content":[{"text":"धन्य हो त्यो मानिस,","poem":1},{"text":"जसका अपराधहरू क्षमा भएका छन्;","poem":2},{"lineBreak":true},{"text":"जसका पापहरू ढाकिएका छन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"त्यो मानिस धन्यको हो,","poem":1},{"text":"जसको पापको लेखा याहवेहले राख्नुहुन्‍न,","poem":2},{"lineBreak":true},{"text":"जसको मनमा कुनै छलकपट छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"जब म आफ्नो पाप स्वीकार नगरी मौन रहेँ,","poem":1},{"text":"तब मेरो दिनभरिको विलौनाले गर्दा","poem":2},{"lineBreak":true},{"text":"मेरा हाडहरू मक्‍किए।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"किनकि दिनरात","poem":1},{"text":"तपाईंको बाहुलीको भार ममाथि रह्‍यो;","poem":2},{"text":"मेरो शरीरको शक्ति","poem":1},{"text":"गर्मीको तापलेझैँ सुकिगएको छ। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तब मैले आफ्नो पाप तपाईंको सामु स्वीकार गरेँ,","poem":1},{"text":"र मेरो अधर्म लुकाइ राखिनँ।","poem":2},{"text":"मैले भनेँ, “म याहवेहको सामु","poem":1},{"text":"मेरो अपराधहरू स्वीकार गर्नेछु।”","poem":2},{"lineBreak":true},{"text":"र तपाईंले मेरो पापको दोष क्षमा गर्नुभयो। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"यसकारण, जबसम्म तपाईंलाई भेट्न सकिन्छ,","poem":1},{"text":"सबै भक्तजनहरूले तपाईंमा प्रार्थना गरून्;","poem":2},{"text":"निश्‍चय नै उर्लेको डरलाग्दो भेलले","poem":1},{"text":"तिनीहरूलाई छुनेछैन।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तपाईं मेरो लुक्ने ठाउँ हुनुहुन्छ;","poem":1},{"text":"तपाईंले मलाई सङ्कष्‍टबाट रक्षा गर्नुहुन्छ;","poem":2},{"lineBreak":true},{"text":"तपाईंले मलाई उद्धारका गीतले चारैतिर घेर्नुहुन्छ। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"म तँलाई शिक्षा दिनेछु; र तँ कुन मार्गमा हिँड्नुपर्ने हो, सो तँलाई सिकाउनेछु;","poem":1},{"text":"म तँलाई सल्‍लाह दिनेछु, र तँमाथि मेरो नजर राख्नेछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"घोडा वा खच्‍चरझैँ नहोऊ, जसको समझशक्ति हुँदैन,","poem":1},{"text":"जसलाई रोक्न लगाम","poem":2},{"text":"र डोकरी चाहिन्छ,","poem":1},{"text":"नत्रता तिनीहरू तेरो वशमा आउनेछैनन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"दुष्‍टहरूले धेरै कष्‍ट भोग्छन्,","poem":1},{"text":"तर याहवेहमा भरोसा राख्नेहरूलाई","poem":2},{"lineBreak":true},{"text":"उहाँको अचुक प्रेमले चारैतिर घेर्दछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"हे धर्मी जनहरू हो, याहवेहमा आनन्दित होओ र हर्ष मनाओ;","poem":1},{"text":"सोझो मन भएकाहरू हो, तिमीहरू सबैले आनन्दसाथ जयजयकार गर!","poem":2}]}],"footnotes":[{"noteId":33,"caller":"+","text":"शीर्षक: सम्भवतः एक साहित्यिक वा साङ्गीतिक शब्द","reference":{"chapter":32,"verse":0}}]},"thisChapterLink":"/api/npi_ncb/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}