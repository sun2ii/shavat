{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, मलाई विरोध गर्नेहरूको विरोध गरिदिनुहोस्;","poem":1},{"text":"मसँग युद्ध गर्नेहरूका विरुद्धमा युद्ध गरिदिनुहोस्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ढाल लिनुहोस् र कवच पहिरनुहोस्;","poem":1},{"text":"उठ्नुहोस् र मेरो सहायताको निम्ति खडा हुनुहोस्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मलाई खेद्नेहरूका विरुद्धमा","poem":1},{"text":"तपाईंको भाला र बर्छा उठाउनुहोस्।","poem":2},{"text":"मलाई भन्‍नुहोस्,","poem":1},{"text":"“म तेरो मुक्ति हुँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"मेरो प्राण लिन खोज्नेहरू","poem":1},{"text":"अपमानित होऊन् र शर्ममा परून्;","poem":2},{"text":"मेरा विरुद्धमा हानि रच्नेहरू","poem":1},{"text":"पछाडि फर्कून् र शर्ममा परून्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेहका स्वर्गदूतले तिनीहरूलाई टाढा लखेटून्;","poem":1},{"text":"तिनीहरू बतासले उडाएका भुसजस्ता होऊन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"याहवेहका स्वर्गदूतले तिनीहरूलाई लखेटिरहून्;","poem":1},{"text":"तिनीहरूको बाटो अँध्यारो र चिप्लो होस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"किनकि कारणविना तिनीहरूले मलाई फसाउनलाई पासो बिछाए;","poem":1},{"text":"र कारणविना मलाई फसाउनलाई तिनीहरूले खाडल खने,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"अचानक तिनीहरूमाथि विनाश आइपरोस्;","poem":1},{"text":"तिनीहरूले लुकाएर थापेको पासोमा तिनीहरू आफैँ परून्,","poem":2},{"lineBreak":true},{"text":"तिनीहरूले खनेका खाडलमा आफैँ परेर नष्‍ट होऊन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तब मेरो प्राणचाहिँ याहवेहमा आनन्दित हुनेछ,","poem":1},{"text":"र उहाँको मुक्तिमा हर्षित हुनेछ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मेरो पूरा बलले भन्‍नेछु,","poem":1},{"text":"“हे याहवेह, तपाईंजस्तो को छ र?","poem":2},{"text":"तपाईंले दुर्बलहरूलाई तिनीहरूभन्दा शक्तिशालीहरूबाट बचाउनुहुन्छ,","poem":1},{"text":"अनि दुर्बल र खाँचोमा परेकाहरूलाई लुटेराहरूबाट बचाउनुहुन्छ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"निर्दयी साक्षीहरू अगि आउँछन्;","poem":1},{"text":"तिनीहरूले मैले जान्दै नजानेका कुराहरू मलाई सोध्छन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तिनीहरूले मलाई भलाइको बदलामा खराबी गर्छन्,","poem":1},{"text":"तपाईंले मेरो प्राणलाई आफन्त गुमाएझैँ शोकमा डुबाउनुभएको छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तापनि जब तिनीहरू बिरामी भए, मैले भाङ्ग्राको वस्त्र लगाएँ;","poem":1},{"text":"र उपवास बसेर आफूलाई दुःखित बनाएँ,","poem":2},{"text":"जब मेरा प्रार्थना उत्तरविना नै फर्केर आयो,","poem":1}]},{"type":"verse","number":14,"content":[{"text":"मेरा मित्र वा भाइको निम्ति शोक गरेझैँ,","poem":2},{"lineBreak":true},{"text":"म तिनीहरूको निम्ति शोक गर्दै हिँडेँ।","poem":2},{"text":"आफ्नी आमाको निम्ति विलाप गरेझैँ","poem":1},{"text":"मैले शोकमा शिर झुकाएँ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तर जब मैले ठेस खाएँ, तिनीहरू मेरो विरुद्धमा एकमत भएर हाँसो गरे;","poem":1},{"text":"मैले थाहै नपाई आक्रमणकारीहरू मेरो विरुद्धमा जम्मा भए।","poem":2},{"lineBreak":true},{"text":"तिनीहरूले नथाकी लगातार मेरो निन्दा गरे।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"भक्तिहीनलेझैँ तिनीहरूले क्रूरतासाथ निन्दा गरे;","poem":1},{"text":"तिनीहरूले ममाथि दाह्रा किटे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"हे प्रभु, कहिलेसम्म तपाईं हेरिरहनुहुन्छ?","poem":1},{"text":"तिनीहरूका आक्रमणबाट,","poem":2},{"lineBreak":true},{"text":"र ती सिंहहरूबाट मलाई छुटाउनुहोस्।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"म तपाईंलाई ठूलो महासभामा धन्यवाद चढाउनेछु;","poem":1},{"text":"विशाल जनसमूहमा म तपाईंको प्रशंसा गर्नेछु।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"मेरा शत्रुहरू कारणविना","poem":1},{"text":"मेरो विरुद्धमा रमाउन नपाऊन्;","poem":2},{"text":"मलाई घृणा गर्नेहरूले कारणविना","poem":1},{"text":"एकनासै मेरो खिल्‍ली गर्न नपाऊन्","poem":2},{"noteId":35},{"text":"।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तिनीहरू त शान्तिको कुरै गर्दैनन्;","poem":1},{"text":"तर देशमा शान्तिसँग बस्‍ने","poem":2},{"lineBreak":true},{"text":"मानिसहरूका विरुद्धमा झूटो आरोपहरू रच्दछन्।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तिनीहरूले ठूलो मुख बाएर मेरो विरुद्धमा भन्छन्, “ओहो! ओहो!","poem":1},{"text":"हामीले आफ्नै आँखाले यो देख्न पायौँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"हे याहवेह, तपाईंले यो देख्नुभएको छ; अब चुप लागेर नबस्‍नुहोस्।","poem":1},{"text":"हे प्रभु, मदेखि टाढा नहुनुहोस्!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"हे प्रभु, मेरा परमेश्‍वर, उठ्नुहोस्; र मेरो रक्षाको निम्ति जाग्नुहोस्!","poem":1},{"text":"मेरो निम्ति लडिदिनुहोस्।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"हे याहवेह, मेरा परमेश्‍वर, तपाईंको धार्मिकतामा मलाई निर्दोष ठहराउनुहोस्;","poem":1},{"text":"तिनीहरू ममाथि रमाउन नपाऊन्।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तिनीहरूले आफ्ना मनमा भन्‍न नपाऊन् कि, “आहा! हामीले चिताएजस्तै पुग्यो!”","poem":1},{"text":"अथवा भन्‍न नपाऊन्, “हामीले त्यसलाई निलिदियौँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"मेरो विपतको समयमा मेरो हाँसो उडाउनेहरू","poem":1},{"text":"सबै लाजमा र अन्योलमा परून्;","poem":2},{"text":"मभन्दा ठूलो हुँ भनी घमण्डले धाक दिनेहरू","poem":1},{"text":"सबै शर्म र अपमानले ढाकिऊन्।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"म निर्दोष साबित भएको कामना राख्नेहरू","poem":1},{"text":"आनन्दले जयजयकार गरून् र हर्षित होऊन्;","poem":2},{"text":"तिनीहरूले निरन्तर यसो भनिरहून् कि, “याहवेह उच्‍च पारिनुभएको होस्,","poem":1},{"text":"उहाँ, जो आफ्नो सेवकको भलाइमा प्रसन्‍न हुनुहुन्छ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"मेरो जिब्रोले तपाईंको धार्मिकताको घोषणा गर्नेछ,","poem":1},{"text":"र तपाईंको प्रशंसा दिनभरि गरिरहनेछ।","poem":2}]}],"footnotes":[{"noteId":35,"caller":"+","text":"मूल भाषामा आँखा झिम्काउनु","reference":{"chapter":35,"verse":19}}]},"thisChapterLink":"/api/npi_ncb/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}