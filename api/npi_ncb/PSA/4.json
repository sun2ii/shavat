{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति तारवाद्यको साथ, दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे मेरा धार्मिक परमेश्‍वर,","poem":1},{"text":"मैले पुकार गर्दा मलाई जवाफ दिनुहोस्।","poem":2},{"text":"मेरो सङ्कष्‍टबाट मलाई मुक्त गर्नुहोस्;","poem":1},{"text":"ममाथि दया गर्नुहोस् र मेरो प्रार्थना सुन्‍नुहोस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"हे मानिसहरू हो, तिमीहरू मेरो महिमालाई कहिलेसम्म शर्ममा परिवर्तन गरिरहन्छौ?","poem":1},{"text":"तिमीहरू कहिलेसम्म व्यर्थका कुराहरू मन पराउँछौ र असत्यको","poem":2},{"noteId":6},{"text":"पछि लागिरहन्छौ? सेला","poem":2}]},{"type":"verse","number":3,"content":[{"text":"याद राख: याहवेहले आफ्नो निम्ति विश्‍वासयोग्य सेवकहरू छुट्ट्याउनुभएको छ;","poem":1},{"text":"मैले पुकार गर्दा याहवेहले सुन्‍नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"रिसमा पर्दा पाप नगर।","poem":1},{"text":"जब तिमी ओछ्यानमा पल्टन्छौ,","poem":2},{"lineBreak":true},{"text":"आफ्नो हृदयभित्र मनन गर, र शान्त रहो। सेला","poem":2}]},{"type":"verse","number":5,"content":[{"text":"धार्मिकताका बलिदानहरू चढाओ,","poem":1},{"text":"र याहवेहमाथि भरोसा राख।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"धेरैले सोध्दछन्, “हामीलाई कसले असल कुरा देखाउन सक्ला?”","poem":1},{"text":"हे याहवेह, तपाईंको मुहारको ज्योति हामीमाथि चम्काउनुहोस्!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तपाईंले तिनीहरूका कटनी र नयाँ दाखमद्यको प्रशस्ततामा हुने, आनन्दभन्दा बढी","poem":1},{"text":"आनन्दले मेरो हृदय भरिदिनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"म शान्तिसँग पल्टिनेछु र निदाउनेछु;","poem":1},{"text":"किनकि हे याहवेह, तपाईंले मात्र","poem":2},{"lineBreak":true},{"text":"मलाई सुरक्षित राख्नुहुन्छ।","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"अथवा असत्य देवताहरूको","reference":{"chapter":4,"verse":2}}]},"thisChapterLink":"/api/npi_ncb/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}