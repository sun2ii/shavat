{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, कोरहका छोराहरूका मस्किल।",{"noteId":37}]},{"type":"verse","number":1,"content":[{"text":"जसरी हरिणले खोलाको पानीको तिर्सना गर्दछ,","poem":1},{"text":"त्यसरी नै हे मेरा परमेश्‍वर, म तपाईंको तिर्सना गर्दछु।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मेरो प्राण परमेश्‍वरको निम्ति, जीवित परमेश्‍वरको निम्ति तिर्खाउँछ।","poem":1},{"text":"म कहिले जाऊँ र परमेश्‍वरलाई भेटूँ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मेरो आँसु दिनरात","poem":1},{"text":"मेरो भोजन बनेको छ,","poem":2},{"text":"मानिसहरू निरन्तर मलाई भनिरहन्छन्,","poem":1},{"text":"“खोइ त तेरो परमेश्‍वर?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मेरो हृदयका कुराहरू पोखाउँदा,","poem":1},{"text":"यी कुराहरू म सम्झन्छु:","poem":2},{"text":"कसरी ती उत्सव मनाउने जन समूहहरूसँग","poem":1},{"text":"जयजयकार र धन्यवादसाथ,","poem":2},{"text":"महान् परमेश्‍वरको सुरक्षामा म अगुवा भएर","poem":1},{"text":"तिनीहरूलाई परमेश्‍वरको भवनतर्फ लाने गर्थेँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे मेरो प्राण, तँ किन उदास हुन्छस्?","poem":1},{"text":"मेरो अन्तस्करण तँ किन यति व्याकुल हुन्छस्?","poem":2},{"text":"परमेश्‍वरमा आशा राख्,","poem":1},{"text":"हे मेरा मुक्तिदाता, हे मेरा परमेश्‍वर,","poem":2},{"lineBreak":true},{"text":"म अझै पनि तपाईंको प्रशंसा गर्नेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मेरो प्राण मभित्र उदास भएको छ;","poem":1},{"text":"यसकारण म यर्दनको देशबाट","poem":2},{"text":"हेर्मोन पर्वत—मिसारको डाँडाबाट","poem":1},{"text":"तपाईंलाई सम्झनेछु।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तपाईंको छाँगाहरूका गर्जनमा,","poem":1},{"text":"सागरले सागरलाई पुकार्दछ;","poem":2},{"text":"तपाईंका सम्पूर्ण छालहरू र तरङ्गहरूले","poem":1},{"text":"मलाई छोपेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेहले दिनमा उहाँको अचुक प्रेम पठाउनुहुन्छ,","poem":1},{"text":"राति उहाँले मलाई एउटा गीत दिनुहुन्छ,","poem":2},{"lineBreak":true},{"text":"जुनचाहिँ मेरो जीवनको परमेश्‍वरलाई प्रार्थना हो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"परमेश्‍वर मेरा चट्टानलाई म भन्छु,","poem":1},{"text":"“तपाईंले मलाई किन बिर्सनुभएको?","poem":2},{"text":"शत्रुको थिचोमिचोले गर्दा","poem":1},{"text":"म किन शोक गरेर हिँडिरहनुपर्ने?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मेरा हाडहरूमा गहिरो चोट पर्छ,","poem":1},{"text":"जब मेरा वैरीहरूले","poem":2},{"text":"मलाई गिल्‍ला गर्दै दिनभरि भन्छन्,","poem":1},{"text":"“खोइ त तेरो परमेश्‍वर?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"हे मेरो प्राण, तँ किन उदास हुन्छस्?","poem":1},{"text":"हे मेरो अन्तस्करण, तँ किन यति धेरै व्याकुल हुन्छस्?","poem":2},{"text":"परमेश्‍वरमा आशा राख्,","poem":1},{"text":"हे मेरा मुक्तिदाता, हे मेरा परमेश्‍वर,","poem":2},{"lineBreak":true},{"text":"म अझै पनि तपाईंको प्रशंसा गर्नेछु।","poem":2}]}],"footnotes":[{"noteId":37,"caller":"+","text":"शीर्षक: सम्भवतः एक साहित्यिक वा साङ्गीतिक शब्द।","reference":{"chapter":42,"verse":0}}]},"thisChapterLink":"/api/npi_ncb/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}