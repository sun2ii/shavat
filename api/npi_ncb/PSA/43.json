{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"हे मेरा परमेश्‍वर, मलाई निर्दोष प्रमाणित गर्नुहोस्,","poem":1},{"text":"र भक्तिहीन जातिको विरुद्धमा","poem":2},{"lineBreak":true},{"text":"मेरो पक्षमा बोलिदिनुहोस्;","poem":2},{"text":"छली र दुष्‍टहरूबाट","poem":1},{"text":"मलाई छुटाउनुहोस्!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"किनकि तपाईं परमेश्‍वर हुनुहुन्छ, जसमा मेरो शक्ति","poem":1},{"noteId":38},{"text":"छ।","poem":1},{"text":"तपाईंले मलाई किन त्याग्नुभएको छ?","poem":2},{"text":"शत्रुबाट थिचोमिचोमा परेर","poem":1},{"text":"मैले किन विलाप गर्दै हिँड्नुपर्छ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तपाईंको ज्योति र तपाईंको विश्‍वासयोग्यतालाई पठाइदिनुहोस्;","poem":1},{"text":"तिनले मलाई डोर्‍याऊन्;","poem":2},{"text":"तिनले नै मलाई तपाईंको पवित्र पर्वतमा पुर्‍याऊन्;","poem":1},{"text":"त्यस स्थानमा, जहाँ तपाईं बास गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तब म परमेश्‍वरको वेदीमा जानेछु,","poem":1},{"text":"परमेश्‍वरकहाँ, जो मेरो आनन्द र हर्ष हुनुहुन्छ।","poem":2},{"text":"म वीणा बजाएर तपाईंको प्रशंसा गर्नेछु,","poem":1},{"text":"हे परमेश्‍वर, मेरा परमेश्‍वर।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे मेरो प्राण, तँ किन उदास हुन्छस्?","poem":1},{"text":"हे मेरो अन्तस्करण, तँ किन यति धेरै व्याकुल हुन्छस्?","poem":2},{"text":"परमेश्‍वरमा आशा राख्,","poem":1},{"text":"हे मेरा मुक्तिदाता, हे मेरा परमेश्‍वर,","poem":2},{"lineBreak":true},{"text":"म अझै पनि तपाईंको प्रशंसा गर्नेछु।","poem":2}]}],"footnotes":[{"noteId":38,"caller":"+","text":"मूल भाषामा किल्‍ला","reference":{"chapter":43,"verse":2}}]},"thisChapterLink":"/api/npi_ncb/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}