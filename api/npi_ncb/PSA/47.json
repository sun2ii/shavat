{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, कोरहको छोराहरूका भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे सबै जाति-जातिका मानिसहरू हो, ताली बजाओ;","poem":1},{"text":"उच्‍च सोरले परमेश्‍वरको निम्ति जयजयकार गर!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"सर्वोच्‍च याहवेह कस्तो महान् हुनुहुन्छ,","poem":1},{"text":"सारा पृथ्वीभरिका महाराजा।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उहाँले राष्ट्रहरूलाई हाम्रा अधीनमा,","poem":1},{"text":"र जाति-जातिहरूलाई हाम्रा पैतालामुनि पार्नुभएको छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उहाँले हाम्रा निम्ति उत्तराधिकारको भाग छान्‍नुभयो,","poem":1},{"text":"याकोबको गौरव, जसलाई उहाँले प्रेम गर्नुहुन्थ्यो। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"परमेश्‍वर आनन्दको सोरसित,","poem":1},{"text":"याहवेह तुरहीको आवाजसित माथि उक्लनुभएको छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"परमेश्‍वरको निम्ति गीत गाओ, गीत गाओ;","poem":1},{"text":"हाम्रा राजाको निम्ति गीत गाओ, गीत गाओ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"किनकि परमेश्‍वर सारा पृथ्वीका राजा हुनुहुन्छ;","poem":1},{"text":"उहाँको निम्ति प्रशंसाको भजन गाओ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"परमेश्‍वरले राष्ट्रहरूमाथि शासन गर्नुहुन्छ;","poem":1},{"text":"परमेश्‍वर उहाँको पवित्र सिंहासनमा विराजमान हुनुहुन्छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"अब्राहामका परमेश्‍वरका मानिसहरूझैँ","poem":1},{"text":"राष्ट्रहरूका श्रेष्‍ठ व्यक्तिहरू भेला भएका छन्;","poem":2},{"text":"किनकि पृथ्वीका","poem":1},{"noteId":41},{"text":"शासकहरू परमेश्‍वरकै हुन्;","poem":1},{"text":"परमेश्‍वर अति उच्‍च हुनुहुन्छ।","poem":2}]}],"footnotes":[{"noteId":41,"caller":"+","text":"अथवा ढालहरू","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/npi_ncb/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}