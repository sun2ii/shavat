{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["एउटा गीत, कोरहका छोराहरूको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हाम्रा परमेश्‍वरको सहरमा, उहाँको पवित्र पर्वतमा,","poem":1},{"text":"याहवेह महान् र प्रशंसाको योग्य हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"उचाइमा सुन्दर,","poem":1},{"text":"सारा पृथ्वीको आनन्द सियोन पर्वत हो,","poem":2},{"text":"जो सापोनको","poem":1},{"noteId":42},{"text":"उचाइझैँ छ,","poem":1},{"text":"जो हाम्रा महाराजाको सहर हो।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनका","poem":1},{"noteId":43},{"text":"किल्‍लाहरूमा परमेश्‍वर हुनुहुन्छ;","poem":1},{"text":"तिनका रक्षक परमेश्‍वर आफैँ हुनुहुन्छ भनी उहाँले देखाउनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"जब राजाहरूले एकसाथ दल बाँधे;","poem":1},{"text":"जब तिनीहरूसँगै अगि बढे,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिनीहरूले तिनलाई देखे; र तिनीहरू छक्‍क परे;","poem":1},{"text":"तिनीहरू डराएर भागे।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिनीहरू त्यहीँ नै डरले थरथर काँप्न लागे,","poem":1},{"text":"प्रसवपीडामा भएकी स्त्रीजस्तै तिनीहरू पीडामा परे।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तर्शीशको जहाजहरूलाई झैँ","poem":1},{"text":"तपाईंले तिनीहरूलाई पूर्वीय बतासले नष्‍ट पार्नुभयो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"सेनाहरूका याहवेहको सहरमा,","poem":1},{"text":"हाम्रा परमेश्‍वरको नगरमा,","poem":2},{"text":"जस्तो हामीले सुनेका थियौँ,","poem":1},{"text":"त्यस्तै देखेका छौँः","poem":2},{"text":"परमेश्‍वरले तिनलाई","poem":1},{"text":"सदासर्वदा सुरक्षित राख्नुहुन्छ। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"हे परमेश्‍वर, तपाईंको मन्दिरभित्र,","poem":1},{"text":"हामी तपाईंको अचुक प्रेमको ध्यान गर्छौँ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"हे परमेश्‍वर, तपाईंको नामजस्तै,","poem":1},{"text":"तपाईंको प्रशंसा पृथ्वीको छेउसम्मै पुग्दछ;","poem":2},{"lineBreak":true},{"text":"तपाईंको दाहिने बाहुली धार्मिकताले भरिएको छ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तपाईंका सही न्यायहरूका कारण,","poem":1},{"text":"सियोन पर्वत आनन्दित हुन्छ;","poem":2},{"lineBreak":true},{"text":"यहूदाका सहरहरू","poem":2},{"noteId":44},{"text":"हर्षित हुन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"सियोनको चारैतिर हिँड, र यसको परिक्रमा गर;","poem":1},{"text":"यसका धरहराहरू गन,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"यसको सुरक्षाको पर्खालहरूमाथि ध्यानसाथ हेर;","poem":1},{"text":"यसका किल्‍लाहरूमाथि दृष्‍टि लगाओ;","poem":2},{"text":"तब तिमीहरूले अर्को पुस्तालाई यसको बारेमा","poem":1},{"text":"राम्ररी वर्णन गर्न सक्छौ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"किनकि यिनै परमेश्‍वर हाम्रा सदासर्वदाका परमेश्‍वर हुनुहुन्छ;","poem":1},{"text":"अनन्तसम्मै उहाँले हामीलाई अगुवाइ गर्नुहुनुहुनेछ।","poem":2}]}],"footnotes":[{"noteId":42,"caller":"+","text":"सापोन कनानीहरूको अति पवित्र पर्वत थियो।","reference":{"chapter":48,"verse":2}},{"noteId":43,"caller":"+","text":"यसले यरूशलेम सहरलाई जनाउँदछ","reference":{"chapter":48,"verse":3}},{"noteId":44,"caller":"+","text":"मूल भाषामा यहूदाका छोरीहरू","reference":{"chapter":48,"verse":11}}]},"thisChapterLink":"/api/npi_ncb/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}