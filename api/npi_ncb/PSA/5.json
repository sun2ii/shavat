{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति बाँसुरीसहित गाइने, दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, मेरा शब्दहरूमा कान लगाइदिनुहोस्;","poem":1},{"text":"मेरो सुस्केरामा ध्यान दिनुहोस्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे मेरा राजा, मेरा परमेश्‍वर,","poem":1},{"text":"सहायताको निम्ति मेरो पुकार सुनिदिनुहोस्;","poem":2},{"lineBreak":true},{"text":"किनकि तपाईंलाई म प्रार्थना गर्दछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे याहवेह, बिहानै तपाईंले मेरो सोर सुन्‍नुहुन्छ;","poem":1},{"text":"सबेरै तपाईंको अगि मेरो बिन्ती राख्दछु,","poem":2},{"lineBreak":true},{"text":"र आशामा प्रतीक्षा गर्दछु।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तपाईं दुष्‍टतासँग प्रसन्‍न हुनुहुने परमेश्‍वर हुनुहुन्‍न;","poem":1},{"text":"दुष्‍ट मानिसहरू तपाईंसँग बास गर्न सक्दैनन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"घमण्डी मानिसहरू तपाईंको सामु खडा हुन सक्दैनन्।","poem":1},{"text":"दुष्‍ट काम गर्नेहरू सबैलाई","poem":2},{"text":"तपाईं घृणा गर्नुहुन्छ।","poem":1}]},{"type":"verse","number":6,"content":[{"text":"झूटो बोल्नेहरूलाई तपाईंले नष्‍ट पार्नुहुन्छ;","poem":2},{"text":"रक्तपात गर्ने र छलीहरूलाई","poem":1},{"text":"तपाईं याहवेहले घृणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तर मचाहिँ तपाईंको अचुक प्रेमद्वारा","poem":1},{"text":"तपाईंको भवनभित्र आउनेछु;","poem":2},{"text":"तपाईंको पवित्र मन्दिरतिर","poem":1},{"text":"म श्रद्धासाथ दण्डवत् गर्नेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे याहवेह, तपाईंको धार्मिकतामा मलाई डोर्‍याउनुहोस्;","poem":1},{"text":"मेरा शत्रुहरूका कारण,","poem":2},{"lineBreak":true},{"text":"तपाईंको मार्ग मेरो सामु सोझो पारिदिनुहोस्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरूका मुखका एउटै शब्दमा पनि सत्यता छैन;","poem":1},{"text":"तिनीहरूका हृदय विनाशले","poem":2},{"noteId":7},{"text":"भरिएको छ।","poem":2},{"text":"तिनीहरूका घोक्रो खुल्‍ला चिहानजस्तै छ;","poem":1},{"text":"तिनीहरूका जिब्राले छलका कुरा बोल्छन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"हे परमेश्‍वर, तिनीहरूलाई दोषी ठहराउनुहोस्;","poem":1},{"text":"तिनीहरूका आफ्नै जाल पतनको कारण होस्।","poem":2},{"text":"तिनीहरूका अनेक अपराधको कारण तिनीहरूलाई त्यागिदिनुहोस्;","poem":1},{"text":"किनकि तिनीहरूले तपाईंका विरुद्धमा विद्रोह गरेका छन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तर तपाईंमा शरण लिनेहरूचाहिँ खुशी होऊन्;","poem":1},{"text":"र तिनीहरू आनन्दले गीत गाऊन्।","poem":2},{"text":"तपाईंले नै तिनीहरूको रक्षा गर्नुहोस्;","poem":1},{"text":"र तपाईंको नामलाई प्रेम गर्नेहरू तपाईंमा आनन्दित होऊन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"निश्‍चय नै, हे याहवेह, तपाईंले धर्मीहरूलाई आशिष् दिनुहुन्छ;","poem":1},{"text":"तपाईंले ढाललेझैँ, तपाईंको कृपादृष्‍टिले तिनीहरूलाई घेरिराख्नुहुन्छ।","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"रोमी 3:13","reference":{"chapter":5,"verse":9}}]},"thisChapterLink":"/api/npi_ncb/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}