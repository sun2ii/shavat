{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, महलत",{"noteId":49},"शैली, दावीदको मस्किल।",{"noteId":50}]},{"type":"verse","number":1,"content":[{"text":"मूर्खले आफ्नो मनमा भन्छ,","poem":1},{"text":"“परमेश्‍वर छँदैछैन।”","poem":2},{"text":"तिनीहरू भ्रष्‍ट छन्, र तिनीहरूका चाल लाजमर्दो छ;","poem":1},{"text":"असल काम गर्ने कोही पनि छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"परमेश्‍वरले स्वर्गबाट","poem":1},{"text":"सबै मानिस जातिलाई हेर्नुहुन्छ","poem":2},{"text":"यो जान्‍नलाई कि कोही त समझदार होला,","poem":1},{"text":"जसले परमेश्‍वरको खोजी गर्दछ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तर हरेक मानिस भड्किगएका छन्, सबै जना भ्रष्‍ट भएका छन्;","poem":1},{"text":"असल गर्ने कोही छैन,","poem":2},{"lineBreak":true},{"text":"एक जना पनि छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"के यी सबै दुष्‍ट काम गर्नेहरूले केही पनि जान्दैनन्?","poem":1},{"lineBreak":true},{"text":"रोटी खाएझैँ तिनीहरूले मेरा मानिसहरूलाई खान्छन्;","poem":1},{"text":"तिनीहरूले परमेश्‍वरलाई कहिल्यै पुकार्दैनन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तर जहाँ डराउनुपर्ने कुनै कारण नै थिएन,","poem":1},{"text":"त्यहीँ नै तिनीहरू डरले व्याकुल भए।","poem":2},{"text":"परमेश्‍वरले तिमीहरूलाई आक्रमण गर्नेहरूका हड्डीहरू छरपस्ट पार्नुभएको छ;","poem":1},{"text":"तिमीहरूले तिनीहरूलाई शर्ममा पारेका छौ;","poem":2},{"text":"किनभने परमेश्‍वरले तिनीहरूलाई इन्कार गर्नुभएको थियो।","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"अहो, इस्राएलको मुक्ति सियोनबाट आएको भए त कति असल हुनेथियो!","poem":1},{"text":"जब परमेश्‍वरले आफ्नो मानिसहरूको सुदिन फर्काइदिनुहुन्छ,","poem":2},{"lineBreak":true},{"text":"तब याकोब रमाओस्, र इस्राएल आनन्दित होस्।","poem":2}]}],"footnotes":[{"noteId":49,"caller":"+","text":"शीर्षक: सम्भवतः एक साङ्गीतिक शब्द","reference":{"chapter":53,"verse":0}},{"noteId":50,"caller":"+","text":"शीर्षक: सम्भवतः एक साहित्यिक वा साङ्गीतिक शब्द।","reference":{"chapter":53,"verse":0}}]},"thisChapterLink":"/api/npi_ncb/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}