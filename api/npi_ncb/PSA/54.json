{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, तारवाद्यमा आधारित, दावीदको मस्किल",{"noteId":51},"—जब जीपीहरू शाऊलकहाँ गएर भनेका थिए, “के दावीद हामीहरूका माझमा लुकेका छैनन् र?”"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्‍वर, तपाईंको नामद्वारा मलाई बचाउनुहोस्;","poem":1},{"text":"तपाईंको शक्तिद्वारा मलाई निर्दोष साबित गर्नुहोस्!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे परमेश्‍वर, मेरो प्रार्थना सुन्‍नुहोस्;","poem":1},{"text":"मेरा मुखका शब्दहरू सुनिदिनुहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"मलाई परदेशीहरूले आक्रमण गर्छन्;","poem":1},{"text":"मलाई निर्दयी मानिसहरूले मार्न खोज्छन्—","poem":2},{"lineBreak":true},{"text":"ती मानिसहरूले परमेश्‍वरको श्रद्धा गर्दैनन्। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हेर, परमेश्‍वर मेरा सहायक हुनुहुन्छ;","poem":1},{"text":"प्रभुले नै मलाई सहारा दिनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मेरा विरोधीहरूका खराबी तिनीहरूमाथि नै फर्किऊन्;","poem":1},{"text":"तपाईंको विश्‍वसनीयतामा तिनीहरूलाई सर्वनाश गर्नुहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"म तपाईंलाई स्वेच्छाबलि चढाउनेछु;","poem":1},{"text":"हे याहवेह, तपाईंको नामको प्रशंसा म गर्नेछु; किनकि त्यो असल कुरा हो।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तपाईंले मलाई मेरा सबै सङ्कष्‍टहरूबाट छुटाउनुभएको छ;","poem":1},{"text":"र मेरा आँखाहरूले मेरा वैरीहरूमाथि मेरो विजयी देख्दछु।","poem":2}]}],"footnotes":[{"noteId":51,"caller":"+","text":"शीर्षक: सम्भवतः एक साहित्यिक वा साङ्गीतिक शब्द।","reference":{"chapter":54,"verse":0}}]},"thisChapterLink":"/api/npi_ncb/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}