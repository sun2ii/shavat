{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, तारवाद्यमा आधारित, दावीदको मस्किल।",{"noteId":52}]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्‍वर, मेरो प्रार्थना सुन्‍नुहोस्;","poem":1},{"text":"मेरो बिन्तीलाई बेवास्ता नगर्नुहोस्!","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मलाई सुन्‍नुहोस्, र मलाई जवाफ दिनुहोस्।","poem":2},{"text":"मेरो मन धेरै दुःखित छ, र म व्याकुल भएको छु,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"मेरा शत्रुहरूको आवाजको कारणले,","poem":2},{"lineBreak":true},{"text":"दुष्‍टहरूका धम्कीले गर्दा।","poem":2},{"text":"किनकि तिनीहरूले ममाथि कष्‍ट ल्याएका छन्,","poem":1},{"text":"र तिनीहरूका क्रोधमा मलाई सताउने गर्दछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"मेरो हृदय मभित्र धेरै पीडामा छ;","poem":1},{"text":"मृत्युको त्रास ममा परेको छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"डर र कम्पनले मलाई डुबाएको छ;","poem":1},{"text":"त्रासले मलाई व्याकुल बनाएको छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मैले भनेँ, “ओह, ढुकुरको जस्तै मेरा पखेटा भए त!","poem":1},{"text":"म उडेर टाढा जानेथिएँ, र विश्राम लिनेथिएँ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म उडेर धेरै टाढासम्म जानेथिएँ,","poem":1},{"text":"र मरुभूमिमा बस्‍नेथिएँ। सेला","poem":2}]},{"type":"verse","number":8,"content":[{"text":"डरलाग्दा आँधीबेहरी र हुरीबाट धेरै टाढा,","poem":1},{"text":"मेरो शरणस्थानतिर आतुरीसाथ जानेथिएँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"हे प्रभु, दुष्‍टहरूलाई खलबल्याइदिनुहोस्;","poem":1},{"text":"तिनीहरूका योजनालाई निरुत्साहित पारिदिनुहोस्;","poem":2},{"lineBreak":true},{"text":"किनकि मैले सहरमा हिंसा र झैझगडा देख्दछु।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिनीहरू सहरका पर्खालहरूमा चढेर शिकारको खोजमा दिनरात वरिपरि घुम्छन्;","poem":1},{"text":"त्यस सहरभित्र दुष्‍टता र उपद्रव छन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"सहरभित्र विनाशकारी शक्तिहरू सक्रिय छन्;","poem":1},{"text":"त्यसका गल्‍लीहरूलाई धम्की र झूटले कहिल्यै छोड्दैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"यदि मेरा शत्रुहरूले मलाई अपमान गरेका भए,","poem":1},{"text":"म त्यो सहन सक्नेथिएँ;","poem":2},{"text":"यदि मेरा वैरीहरू मेरो विरुद्धमा उठेका भए,","poem":1},{"text":"म लुक्न सक्नेथिएँ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तर त्यो त मजस्तै मानिस, तँ नै होस्,","poem":1},{"text":"मेरो सहकर्मी, मेरो घनिष्‍ठ साथी,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जससँग मेरो एक समय मिठो सम्बन्ध थियो;","poem":1},{"text":"मानिसहरूको भीडमा,","poem":2},{"text":"हामी एकसाथ हिँड्थ्यौँ,","poem":1},{"text":"परमेश्‍वरको भवनमा सँगै जान्थ्यौँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"मेरा शत्रुहरूलाई मृत्युले अचानक लैजाओस्;","poem":1},{"text":"तिनीहरू चिहानमा जीवितै जाऊन्;","poem":2},{"lineBreak":true},{"text":"किनकि तिनीहरूका बीच दुष्‍टताले बास गर्दछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"तर मचाहिँ परमेश्‍वरलाई पुकार्छु;","poem":1},{"text":"र याहवेहले मलाई बचाउनुहुन्छ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"साँझ, बिहान र दिउँसो","poem":1},{"text":"दुःख-कष्‍टमा म उहाँलाई पुकार्छु,","poem":2},{"lineBreak":true},{"text":"र उहाँले मेरो सोर सुन्‍नुहुन्छ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"विरोधीहरूका विरुद्धमा लडिरहेको युद्धबाट","poem":1},{"text":"उहाँले मलाई विनाचोट बचाउनुहुन्छ,","poem":2},{"lineBreak":true},{"text":"यद्यपि मेरो विरुद्धमा धेरै विरोधीहरू छन्।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"परमेश्‍वर, जो सनातनदेखि सिंहासनमा विराजमान हुनुहुन्छ,","poem":1},{"text":"जो कहिल्यै पनि बदलिनुहुन्‍न,","poem":2},{"text":"उहाँले तिनीहरूलाई सुन्‍नुहुनेछ र तिनीहरूलाई नम्र तुल्याउनुहुनेछ;","poem":1},{"text":"किनकि तिनीहरूले परमेश्‍वरको डर मान्दैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"मेरा सहकर्मीले उसका आफ्नै मित्रहरूलाई आक्रमण गर्छ;","poem":1},{"text":"उसले आफ्नो प्रतिज्ञा भङ्ग गर्छ।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"उसको मुखको बोली घिउजस्तै चिप्लो छ,","poem":1},{"text":"तर उसको हृदयमा युद्ध हुन्छ;","poem":2},{"text":"उसका कुराहरू तेलभन्दा चिप्ला छन्,","poem":1},{"text":"तर ती नाङ्गा तरवारहरू हुन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"आफ्नो बोझ याहवेहमा राख;","poem":1},{"text":"र उहाँले तिमीलाई सम्हाल्नुहुनेछ।","poem":2},{"text":"उहाँले कहिल्यै","poem":1},{"text":"धर्मीहरूलाई हार्न दिनुहुनेछैन।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तर हे परमेश्‍वर, तपाईंले दुष्‍टहरूलाई","poem":1},{"text":"विनाशको खाडलमा खसाल्नुहुनेछ;","poem":2},{"text":"हत्यारा र छली मानिसहरू","poem":1},{"text":"तिनीहरूका आयुको अवधिको आधा समयसम्म पनि बाँच्नेछैनन्।","poem":2},{"lineBreak":true},{"text":"तर मचाहिँ तपाईंमा भरोसा राख्दछु।","poem":1}]}],"footnotes":[{"noteId":52,"caller":"+","text":"शीर्षक: सम्भवतः एक साहित्यिक वा साङ्गीतिक शब्द।","reference":{"chapter":55,"verse":0}}]},"thisChapterLink":"/api/npi_ncb/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}