{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, “विनाश नगर” लयमा आधारित, शाऊलबाट भागेर ओडारमा बास बस्दा दावीदको मिक्ताम।"]},{"type":"verse","number":1,"content":[{"text":"ममाथि कृपा गर्नुहोस्, हे मेरा परमेश्‍वर, ममाथि कृपा गर्नुहोस्;","poem":1},{"text":"किनकि म तपाईंमा शरण लिन्छु।","poem":2},{"text":"जबसम्म यो विपत्ति हट्दैन,","poem":1},{"text":"तबसम्म म तपाईंको पखेटाको छायामुनि शरण लिनेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"म सर्वोच्‍च परमेश्‍वरलाई पुकार्छु,","poem":1},{"text":"परमेश्‍वरलाई, जसले मलाई निर्दोष प्रमाणित गर्नुहुन्छ","poem":2},{"noteId":53},{"text":"।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उहाँले स्वर्गबाट सहायता पठाउनुहुन्छ र मलाई बचाउनुहुन्छ;","poem":1},{"text":"मलाई खेदो गर्नेहरूलाई उहाँले हप्काउनुहुन्छ, सेला","poem":2},{"lineBreak":true},{"text":"परमेश्‍वरले आफ्नो अचुक प्रेम र विश्‍वसनीयता पठाउनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"म सिंहहरूको बीचमा छु;","poem":1},{"text":"हिँस्रक जनावरहरूजस्ता मानिसहरूका बीचमा बस्‍न म बाध्य छु;","poem":2},{"text":"जसका दाँतहरू धारिला तरवार र काँड हुन्,","poem":1},{"text":"जसका जिब्रा धारिलो तरवारजस्तै छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे परमेश्‍वर, स्वर्गभन्दा उच्‍च हुनुहोस्;","poem":1},{"text":"सारा पृथ्वीमाथि तपाईंको महिमा रहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"तिनीहरूले मेरा पाउहरूका निम्ति जाल बिछाएका छन्;","poem":1},{"text":"म सङ्कष्‍टले झुकेको छु।","poem":2},{"text":"तिनीहरूले मेरो मार्गमा खाडल खनेका छन्,","poem":1},{"text":"तर तिनीहरू त्यस खाडलमा आफैँ परेका छन्। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे परमेश्‍वर, मेरो हृदय स्थिर छ,","poem":1},{"text":"मेरो हृदय स्थिर छ;","poem":2},{"lineBreak":true},{"text":"म गाउनेछु र धुन बजाउनेछु।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हे मेरो प्राण, उठ्!","poem":1},{"text":"हे सारङ्गी र वीणा जाग्!","poem":2},{"lineBreak":true},{"text":"म प्रभातलाई जगाउनेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"हे प्रभु, राष्ट्र-राष्ट्रहरूका बीचमा म तपाईंको प्रशंसा गर्नेछु;","poem":1},{"text":"जाति-जातिहरूबीच म तपाईंको स्तुति गाउनेछु।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"किनकि तपाईंको प्रेम महान् छ, आकाशझैँ उच्‍च छ;","poem":1},{"text":"तपाईंको विश्‍वासयोग्यता आकाशसम्मै पुग्दछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"हे परमेश्‍वर, स्वर्गभन्दा उच्‍च हुनुहोस्;","poem":1},{"text":"सारा पृथ्वीमाथि तपाईंको महिमा रहोस्!","poem":2}]}],"footnotes":[{"noteId":53,"caller":"+","text":"मूल भाषामा मेरो निम्ति बदला लिनुहुन्छ","reference":{"chapter":57,"verse":2}}]},"thisChapterLink":"/api/npi_ncb/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}