{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, “विनाश नहोस्” को रागमा आधारित, दावीदको मिक्ताम, जब शाऊलले दावीदलाई मार्न भनी उनका घरमा सुराकी गर्न पठाएका थिए।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्‍वर, मलाई मेरा शत्रुहरूबाट छुटाउनुहोस्;","poem":1},{"text":"मलाई आक्रमण गर्नेहरूबाट रक्षा गर्नुहोस्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"दुष्‍ट कार्य गर्नेहरूबाट मलाई छुटकारा दिनुहोस्,","poem":1},{"text":"र मेरो प्राण लिन खोज्नेहरूबाट मलाई बचाउनुहोस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हेर्नुहोस्, मेरो प्राण लिनलाई तिनीहरू कसरी ढुकेर बसेका छन्!","poem":1},{"text":"हे याहवेह, मेरो दोष वा पाप नभए तापनि","poem":2},{"lineBreak":true},{"text":"कारणविना क्रूर मानिसहरू मेरो विरुद्धमा षड्यन्त्र रच्दछन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मेरो कुनै दोषविना नै तिनीहरू मलाई आक्रमण गर्न तयार छन्।","poem":1},{"text":"मलाई सहायता गर्न उठ्नुहोस्; मेरो दुर्गतिमा दृष्‍टि गर्नुहोस्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे याहवेह, सेनाहरूका परमेश्‍वर,","poem":1},{"text":"हे इस्राएलका परमेश्‍वर,","poem":2},{"text":"सबै राष्ट्रहरूलाई दण्ड दिन तपाईं जाग्नुहोस्;","poem":1},{"text":"विश्‍वासघातीहरूमाथि कुनै दया नदेखाउनुहोस्। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"तिनीहरू साँझपख","poem":1},{"text":"कुकुरहरूजस्तै घुर्दै,","poem":2},{"lineBreak":true},{"text":"सहरको चारैतिर आउँछन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"हेर्नुहोस्, तिनीहरूको मुखबाट के निकाल्छन्—","poem":1},{"text":"तिनीहरूका ओठबाट निक्लेका शब्दहरू तरवारजस्तै धारिला छन्;","poem":2},{"lineBreak":true},{"text":"अनि तिनीहरू सोच्दछन्, “हामीलाई कसले सुन्‍न सक्छ र?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तर हे याहवेह, तपाईं तिनीहरूमाथि हाँस्‍नुहुन्छ;","poem":1},{"text":"तपाईं सबै राष्ट्रहरूको उपहास गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"तपाईं मेरो शक्ति हुनुहुन्छ, म तपाईंको प्रतीक्षा गर्दछु;","poem":1},{"text":"हे परमेश्‍वर, तपाईं मेरो शरणस्थान हुनुहुन्छ।","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मेरो परमेश्‍वरको अचुक प्रेममा, उहाँ मसँग खडा हुनुहुनेछ,","poem":2},{"text":"र परमेश्‍वर मेरो अगाडि जानुहुनेछ।","poem":1},{"lineBreak":true},{"text":"उहाँले मलाई मेरा शत्रुहरूमाथि विजय देख्न दिनुहुनेछ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तर हे प्रभु, हाम्रा ढाल,","poem":1},{"noteId":55},{"text":"तिनीहरूलाई नमार्नुहोस्,","poem":1},{"text":"नत्रता मेरा मानिसहरूले भुल्नेछन्।","poem":2},{"text":"तपाईंको शक्तिले तिनीहरूलाई उखेल्नुहोस्","poem":1},{"text":"र तिनीहरूलाई होच्याउनुहोस्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तिनीहरूका मुखको पापको फल,","poem":1},{"text":"तिनीहरूका ओठका शब्दहरूका कारण,","poem":2},{"lineBreak":true},{"text":"तिनीहरू आफ्नै घमण्डमा फसून्।","poem":2},{"text":"तिनीहरूले बोलेका श्राप र झूटका कारण,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"तपाईंको क्रोधमा तिनीहरूलाई भस्म पार्नुहोस्,","poem":2},{"lineBreak":true},{"text":"तिनीहरू पूरै नष्‍ट नहोउन्जेल भस्म गर्नुहोस्।","poem":2},{"text":"तब पृथ्वीको छेउसम्मै मानिसहरूले जान्‍नेछन्,","poem":1},{"text":"कि परमेश्‍वरले इस्राएलमाथि","poem":2},{"noteId":56},{"text":"र संसारभरि राज्य गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"तिनीहरू साँझपख","poem":1},{"text":"कुकुरहरूजस्तै घुर्दै","poem":2},{"lineBreak":true},{"text":"सहरको चारैतिर आउँछन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तिनीहरू आहाराको खोजीमा भौँतारिन्छन्,","poem":1},{"text":"अनि तिनीहरू आहाराले सन्तुष्‍ट नहुँदा कराउँछन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तर म तपाईंको शक्तिको गुणगान गाउनेछु,","poem":1},{"text":"बिहानै म तपाईंको अचुक प्रेमको गीत गाउनेछु;","poem":2},{"text":"किनकि तपाईं मेरा किल्‍ला हुनुहुन्छ,","poem":1},{"text":"सङ्कष्‍टको दिनमा मेरो शरणस्थान हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"तपाईं मेरो बल हुनुहुन्छ, म तपाईंको प्रशंसा गाउनेछु;","poem":1},{"text":"हे परमेश्‍वर, तपाईं मेरो शरणस्थान हुनुहुन्छ,","poem":2},{"lineBreak":true},{"text":"मेरो प्रेमिला परमेश्‍वरमा म भरोसा गर्न सक्छु।","poem":2}]}],"footnotes":[{"noteId":55,"caller":"+","text":"अथवा सार्वभौम","reference":{"chapter":59,"verse":11}},{"noteId":56,"caller":"+","text":"मूल भाषामा याकोबमाथि","reference":{"chapter":59,"verse":13}}]},"thisChapterLink":"/api/npi_ncb/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}