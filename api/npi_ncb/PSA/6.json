{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति तारवाला बाजाहरूमा शिमिनिथ,",{"noteId":8},"दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, मलाई तपाईंको रिसमा नहप्काउनुहोस्;","poem":1},{"text":"न त तपाईंको क्रोधमा मलाई ताडना नै दिनुहोस्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे याहवेह, ममाथि कृपा गर्नुहोस्, किनकि म दुर्बल भएको छु;","poem":1},{"text":"हे याहवेह, मलाई निको पार्नुहोस्, किनकि मेरा हाडहरूमा घोर पीडा छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मेरो प्राण गहिरो वेदनामा छ;","poem":1},{"text":"कहिलेसम्म, हे याहवेह, कहिलेसम्म?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे याहवेह, मतिर फर्कनुहोस्, मेरो उद्धार गर्नुहोस्;","poem":1},{"text":"तपाईंको अचुक प्रेमको कारण मलाई बचाउनुहोस्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मृतकहरू कसैले तपाईंको नामको स्मरण गर्दैनन्,","poem":1},{"text":"चिहानबाट कसले तपाईंको प्रशंसा गर्छ र?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मेरो पीडाले गर्दा म थाकिसकेको छु।","poem":1},{"lineBreak":true},{"text":"रातभरि मेरो आँसुको बाढीले ओछ्यान तैरिन्छ।","poem":1},{"text":"र मेरो आँसुले सिरानी डुबाउँछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मेरा आँखाहरू शोकले गर्दा कमजोर भएका छन्;","poem":1},{"text":"मेरा वैरीहरूका कारणले ती कमजोर भएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे सबै दुष्‍ट काम गर्नेहरू हो, मबाट टाढा जाओ;","poem":1},{"text":"किनकि याहवेहले मेरो रुवाइ सुन्‍नुभएको छ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेहले दयाको निम्ति मेरो पुकार सुन्‍नुभएको छ;","poem":1},{"text":"याहवेहले मेरो प्रार्थना ग्रहण गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मेरा सबै शत्रुहरू ज्यादै लज्जित हुनेछन् र डराउनेछन्;","poem":1},{"text":"तिनीहरू एकै क्षणमा लज्जित भएर पछि हट्नेछन्।","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"शीर्षक: सम्भवतः एक साङ्गीतिक शब्द","reference":{"chapter":6,"verse":0}}]},"thisChapterLink":"/api/npi_ncb/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}