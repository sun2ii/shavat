{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, तारवाद्यमा आधारित, दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्‍वर, मेरो पुकार सुन्‍नुहोस्;","poem":1},{"text":"मेरो प्रार्थना सुनिदिनुहोस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"जब मेरो हृदय धेरै व्याकुल हुन्छ,","poem":1},{"text":"तब म पृथ्वीको छेउदेखि तपाईंलाई पुकार्दछु;","poem":2},{"lineBreak":true},{"text":"मभन्दा धेरै अग्लो चट्टानमा मलाई लैजानुहोस्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"किनकि तपाईं मेरा लागि शरणस्थान हुनुहुन्छ,","poem":1},{"text":"तपाईं मेरा वैरीका विरुद्धमा एक बलियो धरहरा हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"तपाईंको पालमा सदासर्वदा रहिरहन,","poem":1},{"text":"र तपाईंको पखेटामुनि शरण लिन पाऊँ भन्‍ने मेरो चाहना छ। सेला","poem":2}]},{"type":"verse","number":5,"content":[{"text":"किनकि हे परमेश्‍वर, तपाईंले मेरा भाकलहरू सुन्‍नुभएको छ;","poem":1},{"text":"तपाईंको नामको भय मान्‍नेहरूका उत्तराधिकार मलाई दिनुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"राजाको आयु बढाइदिनुहोस्;","poem":1},{"text":"पुस्तौँसम्म उनको आयु बढाउनुहोस्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उनी परमेश्‍वरको उपस्थितिमा सदासर्वदा राज गरून्;","poem":1},{"text":"तपाईंको अचुक प्रेम र विश्‍वासयोग्यताले उनको सुरक्षा गर्नुहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"तब म यसरी सदासर्वदा तपाईंको नामको स्तुतिगान गाउनेछु","poem":1},{"text":"र प्रत्येक दिन मेरा भाकलहरू पूरा गर्नेछु।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}