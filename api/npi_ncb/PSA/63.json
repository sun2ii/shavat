{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["यहूदाको मरुभूमिमा हुँदा दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्‍वर, तपाईं मेरो परमेश्‍वर हुनुहुन्छ;","poem":1},{"text":"म दिलोज्यानले तपाईंलाई खोज्दछु;","poem":2},{"text":"पानी नभएको सुक्खा र बाँझो जमिनमा,","poem":1},{"text":"मेरो प्राण तपाईंका निम्ति तिर्खाउँछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"पवित्रस्थानमा मैले तपाईंको दर्शन गरेको छु,","poem":1},{"text":"र तपाईंको शक्ति र महिमालाई देखेको छु।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तपाईंको अचुक प्रेम जीवनभन्दा पनि उत्तम छ;","poem":1},{"text":"यसैले मेरा ओठले तपाईंको महिमा गर्नेछ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मेरो जीवनभरि नै म तपाईंको प्रशंसा गर्नेछु,","poem":1},{"text":"र तपाईंको नाममा म मेरो हात उचाल्नेछु।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मेरो प्राण अति उत्तम भोजनझैँ पूर्ण रूपमा सन्तुष्‍ट हुनेछ;","poem":1},{"text":"स्तुतिगान गाउँदै मेरो मुखले तपाईंको प्रशंसा गर्नेछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मेरो ओछ्यानमा म तपाईंलाई सम्झन्छु;","poem":1},{"text":"रातको हरेक पहरमा म तपाईंलाई मनन गर्छु।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"किनकि तपाईं मेरो सहायक हुनुहुन्छ;","poem":1},{"text":"म तपाईंको पखेटाको छायामुनि आनन्दले गाउँछु।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मेरो सम्पूर्ण शक्तिले तपाईंलाई समात्छ;","poem":1},{"text":"तपाईंको दाहिने हातले मलाई सम्हालेर राख्दछ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"मलाई मार्न खोज्नेहरूचाहिँ नष्‍ट पारिनेछन्;","poem":1},{"text":"तिनीहरू पृथ्वीको गहिराइ भागहरूमा जानेछन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिनीहरू तरवारद्वारा मारिनेछन्;","poem":1},{"text":"र स्यालहरूको आहारा हुनेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"तर राजा परमेश्‍वरमा आनन्दित हुनेछन्;","poem":1},{"text":"परमेश्‍वरको नाममा शपथ लिनेहरू सबैले उहाँलाई महिमा दिनेछन्;","poem":2},{"lineBreak":true},{"text":"जबकि झूटो बोल्ने मुख थुनिनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}