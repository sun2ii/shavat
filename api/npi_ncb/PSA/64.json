{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे मेरा परमेश्‍वर, मैले गुनासो गर्दा मेरो सोर सुन्‍नुहोस्;","poem":1},{"text":"शत्रुको धम्कीबाट मेरो प्राणलाई बचाउनुहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"दुष्‍टहरूको गुप्‍त पासोहरूबाट","poem":1},{"text":"कुकर्मीहरूको षड्यन्त्रहरूबाट मलाई लुकाउनुहोस्!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरूले आफ्नो जिब्रोलाई तरवारझैँ धारिलो पार्छन्,","poem":1},{"text":"र तिनीहरूका निर्दयी शब्दहरूले प्राणघातक काँडझैँ ताकेका छन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरूले निर्दोषहरूलाई ढुकि पासोमा पारेर काँड हान्छन्;","poem":1},{"text":"तिनीहरूले डरैविना अचानक काँड हान्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तिनीहरूले एक-अर्कालाई आफ्ना दुष्‍ट षड्यन्त्रहरूबाट प्रोत्साहन दिन्छन्;","poem":1},{"text":"तिनीहरूले लुकाएर पासो थाप्ने कुरा गर्छन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूले भन्छन्, “यसलाई कसले देख्छ र","poem":2},{"noteId":60},{"text":"?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिनीहरू अन्याय रच्छन् र भन्छन्,","poem":1},{"text":"“हामीले सिद्ध योजना बनाएका छौँ!”","poem":2},{"lineBreak":true},{"text":"मानिसको मन र हृदय साँच्‍चै धूर्त छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"तर परमेश्‍वरले उहाँका काँडहरूले तिनीहरूलाई हान्‍नुहुनेछ;","poem":1},{"text":"तिनीहरू अचानक घाइते हुनेछन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"उहाँले तिनीहरूका जिब्रोलाई तिनीहरूकै विरुद्धमा बोल्न लगाउनुहुनेछ,","poem":1},{"text":"र तिनीहरूलाई नष्‍ट पार्नुहुनेछ;","poem":2},{"lineBreak":true},{"text":"तिनीहरूलाई देख्ने सबैले गिल्‍ला गर्दै टाउको हल्‍लाउनेछन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"सबै मानिसहरू परमेश्‍वरसँग डराउनेछन्;","poem":1},{"text":"तिनीहरूले परमेश्‍वरको कामको घोषणा गर्नेछन्;","poem":2},{"lineBreak":true},{"text":"र उहाँले गर्नुभएका कामहरू विचार गर्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"धर्मी जनहरू याहवेहमा आनन्दित हुनेछन्,","poem":1},{"text":"र उहाँमा शरण लिनेछन्;","poem":2},{"lineBreak":true},{"text":"साँचो हृदय भएकाहरू सबैले उहाँको महिमा गर्नेछन्!","poem":2}]}],"footnotes":[{"noteId":60,"caller":"+","text":"अथवा हामीलाई","reference":{"chapter":64,"verse":5}}]},"thisChapterLink":"/api/npi_ncb/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}