{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, तारवाद्यमा आधारित, एउटा भजन; एउटा गीत।"]},{"type":"verse","number":1,"content":[{"text":"परमेश्‍वर हामीप्रति अनुग्रही होऊन्, र हामीलाई आशिष् देऊन्;","poem":1},{"text":"अनि उहाँको मुहार हामीमाथि चम्काऊन्— सेला","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ताकि तपाईंको मार्ग पृथ्वीमाथि प्रकट होस्,","poem":1},{"text":"अनि तपाईंको मुक्ति सबै राष्ट्रहरूको बीचमा थाहा होस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे परमेश्‍वर, तपाईंको प्रशंसा मानिसहरूले गरून्;","poem":1},{"text":"सबै जाति-जातिहरूले तपाईंको प्रशंसा गरून्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जाति-जातिहरू रमाऊन् र आनन्दले गाऊन्;","poem":1},{"text":"किनकि तपाईंले जाति-जातिहरूलाई निष्पक्षसाथ शासन गर्नुहुन्छ,","poem":2},{"lineBreak":true},{"text":"र पृथ्वीका राष्ट्रहरूलाई अगुवाइ गर्नुहुन्छ। सेला","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे परमेश्‍वर, तपाईंको प्रशंसा मानिसहरूले गरून्;","poem":1},{"text":"सबै जाति-जातिहरूले तपाईंको प्रशंसा गरून्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"भूमिले आफ्नो बाली उब्जनी गर्छ;","poem":1},{"text":"परमेश्‍वर, हाम्रा परमेश्‍वरले हामीलाई आशिष् दिनुहुन्छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"परमेश्‍वरले हामीलाई अझै आशिष् देऊन्,","poem":1},{"text":"कि समस्त पृथ्वीका मानिसहरूले उहाँको डर मानून्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}