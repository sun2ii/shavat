{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, “लिली फूल” को रागमा आधारित, दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्‍वर, मलाई बचाउनुहोस्;","poem":1},{"text":"किनकि पानी मेरो घाँटीसम्म आइसकेको छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"म गहिरो दलदलमा डुब्दैछु,","poem":1},{"text":"जहाँ उभिने ठाउँ नै छैन।","poem":2},{"text":"म गहिरो पानीमा डुबेको छु;","poem":1},{"text":"बाढीहरू ममाथि उर्लन्छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"सहायताको लागि पुकार गर्दा-गर्दा म थाकिसकेको छु;","poem":1},{"text":"मेरो घाँटी सुकेको छ।","poem":2},{"text":"मेरा परमेश्‍वरको खोजी गर्दा-गर्दा","poem":1},{"text":"मेरा आँखाहरू कमजोर भएका छन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कारणविना मलाई घृणा गर्नेहरू","poem":1},{"text":"मेरो टाउकोका केशभन्दा धेरै छन्;","poem":2},{"text":"कारणविना मेरा शत्रुहरू धेरै छन्,","poem":1},{"text":"जसले मलाई मार्न खोजिहिँड्छन्।","poem":2},{"text":"जुन कुरा मैले चोरेकै छैनँ,","poem":1},{"text":"मलाई त्यसको भरपाई गर्न बाध्य तुल्याइएको छु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे परमेश्‍वर, तपाईं मेरो मूर्खता जान्‍नुहुन्छ;","poem":1},{"text":"मेरा दोषहरू तपाईंबाट लुकेका छैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"हे प्रभु, सेनाहरूका याहवेह,","poem":1},{"text":"तपाईंमा आशा राख्नेहरू","poem":2},{"lineBreak":true},{"text":"मेरो कारणले शर्ममा नपरून्;","poem":2},{"text":"हे इस्राएलका परमेश्‍वर,","poem":1},{"text":"तपाईंलाई खोज्नेहरू","poem":2},{"lineBreak":true},{"text":"मेरो कारणले लाजमा नपरून्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"किनकि तपाईंको खातिर मैले तिरस्कार सहेको छु;","poem":1},{"text":"मेरो अनुहार लाजले ढाकेको छ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मेरा आफन्तका बीचमा म विदेशी भएको छु,","poem":1},{"text":"मेरा साक्खै दाजुभाइ-दिदीबहिनीहरूका बीच म बिरानो भएको छु;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"किनकि तपाईंको घरप्रतिको जोशले मलाई खाएको छ,","poem":1},{"text":"र तपाईंलाई अपमान गर्नेहरूको अपमान ममाथि आइपरेको छ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"जब म रुन्छु, र उपवास बस्छु,","poem":1},{"text":"मैले अपमान सहनैपर्छ;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"जब म भाङ्ग्रा","poem":1},{"noteId":62},{"text":"लगाउँछु,","poem":1},{"text":"मानिसहरू मेरो हाँसो गर्दछन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"सहरको मूलढोकामा बस्‍ने मानिसहरूले मेरो ठट्टा उडाउँछन्;","poem":1},{"text":"अनि म मतवालाहरूको गीत बनेको छु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"तर हे याहवेह, तपाईंको ग्रहणयोग्य समयमा,","poem":1},{"text":"म तपाईंलाई प्रार्थना गर्दछु;","poem":2},{"text":"हे परमेश्‍वर, तपाईंको अचुक प्रेममा,","poem":1},{"text":"तपाईंको निश्‍चित छुटकाराले मलाई उत्तर दिनुहोस्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"मलाई दलदले हिलोबाट बचाउनुहोस्!","poem":1},{"text":"मलाई डुब्न नदिनुहोस्,","poem":2},{"text":"घृणा गर्नेहरूबाट,","poem":1},{"text":"गहिरो पानीबाट मलाई बचाउनुहोस्!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"मलाई पानीको बाढीले नछोपोस्","poem":1},{"text":"वा पानीको गहिराइले मलाई ननिलोस्,","poem":2},{"lineBreak":true},{"text":"वा चिहानको मुख ममाथि बन्द नहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"हे याहवेह, तपाईंको अचुक प्रेमको उत्तमतामा मलाई जवाफ दिनुहोस्;","poem":1},{"text":"तपाईंको महान् कृपामा मतिर फर्कनुहोस्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तपाईंको सेवकबाट आफ्नो मुहार नलुकाउनुहोस्;","poem":1},{"text":"मलाई चाँडै जवाफ दिनुहोस्, किनकि म सङ्कटमा परेको छु।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"मेरो नजिक आएर मेरो उद्धार गर्नुहोस्;","poem":1},{"text":"मेरा शत्रुहरूका कारण मलाई छुटाउनुहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"म अपमानित भएको, म शर्ममा परेको, र मेरो बेइज्जत भएको तपाईंलाई थाहा छ;","poem":1},{"text":"मेरा सबै शत्रुहरू तपाईंकै सामु छन्।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"अपमानले गर्दा मेरो मन टुटेको छ;","poem":1},{"text":"र म निरीह भएको छु;","poem":2},{"text":"मलाई सहानुभूति देखाउने कोही छन् कि भनेर खोजी गरेँ, तर कोही थिएनन्;","poem":1},{"text":"र सान्त्वना दिनेहरू पनि खोजेँ, तर कोही भेटिनँ।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"मेरो खानामा तिनीहरूले पित्त हाले,","poem":1},{"text":"म तिर्खाउँदा सिर्का पिउन दिए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"तिनीहरूका अगि राखिएको भोजन तिनीहरूका निम्ति पासो बनोस्;","poem":1},{"text":"र तिनीहरूका समृद्धि नै तिनीहरूको पासो बनोस्!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तिनीहरूका आँखाहरू अँध्यारा होऊन्, र तिनीहरूले नदेखून्;","poem":1},{"text":"तिनीहरूका ढाड सदा कुप्रिरहून्!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"तपाईंको क्रोध तिनीहरूमाथि खन्याउनुहोस्;","poem":1},{"text":"तपाईंको रिसको आगो तिनीहरूमाथि आइपरोस्!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तिनीहरूको स्थान उजाड भइजाओस्;","poem":1},{"text":"तिनीहरूका पालहरूमा बास गर्ने कोही नहोस्।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"किनकि तपाईंले ताडना दिनु भएकाहरूलाई तिनीहरूले सताउँछन्,","poem":1},{"text":"र तपाईंले घाइते पार्नुभएकाहरूका बारेमा तिनीहरूले कुरा काट्छन्।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"तपाईंले तिनीहरूको अपराधमाथि अपराधको हिसाब राख्नुहोस्;","poem":1},{"text":"र तिनीहरू तपाईंको मुक्तिमा सहभागी हुन नपाऊन्।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"जीवनको पुस्तकबाट तिनीहरूका नाम मेटिओस्,","poem":1},{"text":"र धर्मी जनहरूसँग तिनीहरू गन्ती नहोऊन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"तर म त दुःखित र पीडित छु—","poem":1},{"text":"हे परमेश्‍वर, तपाईंको मुक्तिले मलाई सुरक्षा गरोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"गीत गाएर म परमेश्‍वरको नामको प्रशंसा गर्नेछु,","poem":1},{"text":"र धन्यवादसाथ उहाँलाई महिमा गर्नेछु।","poem":2}]},{"type":"verse","number":31,"content":[{"text":"यस कुराले याहवेहलाई साँढेको बलिभन्दा बढी","poem":1},{"text":"सिङ र खुर भएको बहरको बलिले भन्दा बढी प्रसन्‍न पार्नेछ।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"थिचोमिचोमा परेकाहरू यो कुरा देखेर रमाउनेछन्—","poem":1},{"text":"हे परमेश्‍वरलाई खोज्नेहरू हो, तिमीहरूको हृदय नयाँ जोसले भरियोस्।","poem":2}]},{"type":"verse","number":33,"content":[{"text":"याहवेहले अभावमा परेकाहरूको पुकार सुन्‍नुहुन्छ,","poem":1},{"text":"र बन्धनमा परेका आफ्ना मानिसहरूलाई अवहेलना गर्नुहुन्‍न।","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"स्वर्ग, पृथ्वी, समुद्र","poem":1},{"text":"र तिनमा हिँड्‍डुल गर्ने सारा सृष्‍टिले परमेश्‍वरको प्रशंसा गरून्!","poem":2}]},{"type":"verse","number":35,"content":[{"text":"किनकि परमेश्‍वरले सियोनलाई बचाउनुहुनेछ,","poem":1},{"text":"र यहूदाका सहरहरूलाई पुनर्निर्माण गर्नुहुनेछ।","poem":2},{"text":"तब उहाँका मानिसहरू त्यहाँ बस्‍नेछन्, र त्यसमाथि कब्जा गर्नेछन्;","poem":1}]},{"type":"verse","number":36,"content":[{"text":"उहाँका सेवकहरूका सन्तानहरू त्यहाँ उत्तराधिकार हुनेछन्;","poem":2},{"lineBreak":true},{"text":"अनि उहाँको नामलाई प्रेम गर्नेहरू त्यहाँ बास गर्नेछन्।","poem":2}]}],"footnotes":[{"noteId":62,"caller":"+","text":"इस्राएलीहरूले आफ्नो गहिरो शोक प्रकट गर्न लगाउने वस्त्र","reference":{"chapter":69,"verse":11}}]},"thisChapterLink":"/api/npi_ncb/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}