{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, दावीदको बिन्ती भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्‍वर, मलाई बचाउनुहोस्;","poem":1},{"text":"हे याहवेह, मलाई सहायता गर्न चाँडै आउनुहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"मेरो प्राण लिन खोज्नेहरू","poem":1},{"text":"सबै जना शर्ममा र अन्योलमा परून्;","poem":2},{"text":"मेरो विनाश चाहनेहरू","poem":1},{"text":"सबै पिठिउँ फर्काएर भागून् र अपमानित होऊन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मलाई “खुच्‍चिङ! खुच्‍चिङ!” भन्दै ठट्टा उडाउनेहरू,","poem":1},{"text":"लाजको कारण पछि फर्कून्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तर तपाईंलाई खोज्नेहरू सबै,","poem":1},{"text":"तपाईंमा रमाऊन् र आनन्दित होऊन्;","poem":2},{"text":"तपाईंको मुक्तिको चाहना गर्नेहरू सबैले सधैँ यसो भनून्,","poem":1},{"text":"“परमेश्‍वर महान् हुनुहुन्छ!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तर म त गरिबी र अभावमा छु;","poem":1},{"text":"हे परमेश्‍वर, मकहाँ चाँडो आउनुहोस्;","poem":2},{"text":"तपाईं मेरा सहायक र छुटकारा दिने हुनुहुन्छ;","poem":1},{"text":"हे याहवेह, ढिलो नगर्नुहोस्!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}