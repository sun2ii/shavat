{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":72,"content":[{"type":"hebrew_subtitle","content":["सोलोमनको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्‍वर, राजालाई तपाईंको न्याय,","poem":1},{"text":"र राजाका छोरालाई तपाईंको धार्मिकता दिनुहोस्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"राजाले तपाईंका मानिसहरूलाई धार्मिकतासाथ","poem":1},{"text":"र तपाईंका पीडित जनहरूलाई धार्मिकतासाथ न्याय गरून्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"पर्वतहरूले मानिसहरूका लागि समृद्धि ल्याऊन्;","poem":1},{"text":"पहाडहरूले धार्मिकताका फल ल्याऊन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उहाँले पीडितलाई मानिसहरूबीच रक्षा गरून्,","poem":1},{"text":"र अभावमा हुनेहरूका सन्तानहरूलाई बचाऊन्;","poem":2},{"lineBreak":true},{"text":"उहाँले अत्याचारीहरूलाई नाश गरून्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जबसम्म सूर्य रहन्छ, र जबसम्म चन्द्रमा रहन्छ,","poem":1},{"text":"सबै पुस्ताका मानिसहरूले राजाको भय मानून्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिनी काटिएको घाँसको चउरमाथि बर्सने पानीजस्तै,","poem":1},{"text":"र जमिनलाई भिजाउन सिँचाइ गरिने झरीहरूझैँ होऊन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"राजाको शासनकालमा धर्मीहरूको उन्‍नति होस्,","poem":1},{"text":"र चन्द्रमा रहुन्जेल देशमा प्रसस्तता होस्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"राजाले एक समुद्रदेखि अर्को समुद्रसम्म, यूफ्रेटिस नदीदेखि","poem":1},{"text":"पृथ्वीको अन्तिम छेउ-छाउसम्म शासन गरून्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"राजाको सामु मरुभूमिमा बस्‍नेहरूले दण्डवत् गरून्,","poem":1},{"text":"र उनका शत्रुहरूले धुलो चाटून्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तर्शीश र टाढा सामुद्रिक किनारका राजाहरूले","poem":1},{"text":"उनलाई सलामी","poem":2},{"noteId":63},{"text":"ल्याऊन्;","poem":2},{"text":"शेबा र सेबाका राजाहरूले","poem":1},{"text":"उनलाई भेटी चढाऊन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"सबै राजाहरू उनको अगाडि निहुरिऊन्;","poem":1},{"text":"र सबै राष्ट्रहरूले उनको सेवा गरून्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"किनकि उनले अभावमा हुनेहरूलाई उद्धार गर्छन्, जसले उहाँलाई पुकार गर्छन्;","poem":1},{"text":"पीडितहरू जसको सहायता गर्ने कोही छैन।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"दुर्बल र अभावमा भएकाहरूलाई उनले दया देखाउनेछन्,","poem":1},{"text":"र अभावमा हुनेहरूको प्राण मृत्युदेखि बचाउनेछन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"उनले तिनीहरूलाई हिंसा र अत्याचारबाट छुटाउनेछन्;","poem":1},{"text":"किनकि उनको दृष्‍टिमा तिनीहरूको रगत बहुमूल्य छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"तिनी दीर्घायु होऊन्!","poem":1},{"text":"तिनलाई शेबाको सुन भेटीस्वरूप दिइयोस्।","poem":2},{"text":"तिनको निम्ति मानिसहरूले सधैँ प्रार्थना गरून्,","poem":1},{"text":"र दिनभरि नै तिनलाई आशिष् देऊन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"देशभरि नै प्रशस्त अन्‍न होस्;","poem":1},{"text":"पर्वतका टाकुराहरू समेतलाई प्रभावित पारून्।","poem":2},{"text":"तिनको बाली लेबनानझैँ फस्टाओस्;","poem":1},{"text":"र सहरका मानिसहरू जमिनको घाँसझैँ फस्टाऊन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तिनको नाम सदासर्वदा रहिरहोस्;","poem":1},{"text":"सूर्य रहुन्जेलसम्म तिनको नाम रहिरहोस्।","poem":2},{"lineBreak":true},{"text":"तब तिनीद्वारा सबै राष्ट्रहरूले आशिष् पाउनेछन्;","poem":1},{"text":"र तिनलाई धन्यका भन्‍नेछन्।","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"इस्राएलका परमेश्‍वर, याहवेह परमेश्‍वरलाई प्रशंसा होस्!","poem":1},{"text":"उहाँले मात्र अचम्मका काम गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"उहाँको महिमायोग्य नामको सदासर्वदा प्रशंसा होस्;","poem":1},{"text":"उहाँको महिमाले सारा पृथ्वी भरियोस्।","poem":2},"आमेन! आमेन!"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"यिशैका छोरा दावीदका प्रार्थनाहरू यहीँ समाप्‍त हुन्छ।","poem":1}]}],"footnotes":[{"noteId":63,"caller":"+","text":"राजाहरूले शासन गर्ने समयमा ठूला राजा वा सम्राटलाई साना राजाले सम्मान स्वरूप उपहार वा सलामी दिनुपर्थ्यो","reference":{"chapter":72,"verse":10}}]},"thisChapterLink":"/api/npi_ncb/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}