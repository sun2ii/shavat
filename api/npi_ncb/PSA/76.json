{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, तारवाद्यमा आधारित, आसापको भजन; एक गीत।"]},{"type":"verse","number":1,"content":[{"text":"यहूदामा परमेश्‍वर प्रसिद्ध हुनुभएको छ;","poem":1},{"text":"इस्राएलमा उहाँको नाम महान् छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"उहाँको पाल शालेममा","poem":1},{"noteId":69},{"text":"छ,","poem":1},{"text":"उहाँको वासस्थान सियोनमा छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्यहाँ उहाँले अग्निकाँडहरू भाँच्नुभयो,","poem":1},{"text":"ढाल, तरवार र युद्धका हतियारहरू भाँच्नुभयो। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"तपाईं ज्योतिले चम्किलो हुनुहुन्छ,","poem":1},{"text":"र शिकारले भरिएका पर्वतहरूभन्दा पनि भव्य हुनुहुन्छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"साहसी मानिसहरू लुटिएका छन्;","poem":1},{"text":"तिनीहरू गहिरो निद्रामा परेका छन्;","poem":2},{"text":"एउटै पनि शूरवीरले","poem":1},{"text":"आफ्नो हात उचाल्न सक्दैन।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"हे याकोबका परमेश्‍वर, तपाईंको हप्काइमा","poem":1},{"text":"घोडा र रथ दुवै चीर निद्रामा परेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"तपाईं मात्र भययोग्य हुनुहुन्छ;","poem":1},{"text":"तपाईं रिसाउनुहुँदा तपाईंको अगि को खडा रहन सक्छ र?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"स्वर्गबाट तपाईंले न्याय घोषणा गर्नुभयो;","poem":1},{"text":"र पृथ्वी डरायो र चुपचाप भयो—","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे परमेश्‍वर, जब तपाईं पृथ्वीमा पीडितहरू","poem":1},{"text":"सबैलाई बचाउन न्याय गर्न उठ्नुभयो। सेला","poem":2}]},{"type":"verse","number":10,"content":[{"text":"निश्‍चय नै मानव-जाति विरुद्ध तपाईंको क्रोधले तपाईंलाई प्रशंसा ल्याउँदछ;","poem":1},{"text":"र तपाईंको क्रोधबाट बाँचेकाहरू रोकिएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"तिमीहरूका परमेश्‍वर, याहवेहलाई भाकल गर, र त्यो पूरा गर;","poem":1},{"text":"उहाँलाई, जो भययोग्य हुनुहुन्छ, देशको चारैपट्टि रहने मानिसहरू","poem":2},{"lineBreak":true},{"text":"सबैले भेटी ल्याऊन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"उहाँले शासकहरूको घमण्डलाई तोडिदिनुहुन्छ;","poem":1},{"text":"पृथ्वीका राजाहरू उहाँसँग डराउँछन्।","poem":2}]}],"footnotes":[{"noteId":69,"caller":"+","text":"शालेम यरूशलेम सहरको छोटो नाम हो, (उत्प 14:18)","reference":{"chapter":76,"verse":2}}]},"thisChapterLink":"/api/npi_ncb/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}