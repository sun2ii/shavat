{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["आसापको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्‍वर, राष्ट्रहरूले तपाईंका उत्तराधिकारलाई आक्रमण गरेका छन्;","poem":1},{"text":"तिनीहरूले तपाईंका पवित्र मन्दिरलाई अपवित्र पारेका छन्;","poem":2},{"lineBreak":true},{"text":"तिनीहरूले यरूशलेमलाई भग्नावशेषका थुप्राहरू पारिदिएका छन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तिनीहरूले तपाईंका सेवकहरूका लासलाई","poem":1},{"text":"आकाशका पक्षीहरूलाई आहाराको निम्ति छोडेका छन्,","poem":2},{"lineBreak":true},{"text":"तपाईंका आफ्ना मानिसका शरीर जङ्गली जनावरहरूलाई दिएका छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरूले उनीहरूका रगत","poem":1},{"text":"यरूशलेमको चारैतिर पानीजस्तै बगाएका छन्,","poem":2},{"lineBreak":true},{"text":"र उनीहरूका लासलाई गाड्ने कोही छैनन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हाम्रा छिमेकीहरूका सामु हामी गिल्‍लाका पात्र;","poem":1},{"text":"र हाम्रा वरिपरिका मानिसहरूका बीच तिरस्कार र हाँसोका पात्र भएका छौँ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे याहवेह, तपाईं कहिलेसम्म क्रोधित भइरहनुहुन्छ? के सधैँभरिको लागि?","poem":1},{"text":"तपाईंको डाह कहिलेसम्म आगोझैँ दन्किनेछ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तपाईंको क्रोध ती राष्ट्रहरूमाथि खन्याउनुहोस्,","poem":1},{"text":"जसले तपाईंलाई स्वीकार गर्दैनन्;","poem":2},{"text":"ती राज्यहरूमाथि,","poem":1},{"text":"जसले तपाईंको नामलाई पुकार्दैनन्;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"किनकि तिनीहरूले याकोबलाई निलेका छन्,","poem":1},{"text":"र तिनको वासस्थान उजाड पारेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हाम्रा पितापुर्खाहरूका पापको दण्ड हामीलाई नदिनुहोस्;","poem":1},{"text":"तपाईंको कृपा चाँडै हामीलाई भेट्न आओस्,","poem":2},{"lineBreak":true},{"text":"किनकि हामी अत्यन्तै अभावमा छौँ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे हाम्रा उद्धारक परमेश्‍वर,","poem":1},{"text":"तपाईंको नामको महिमाको खातिर, हामीलाई सहायता गर्नुहोस्;","poem":2},{"text":"तपाईंको नामको खातिर हामीलाई छुटाउनुहोस्","poem":1},{"text":"र हाम्रा पाप क्षमा गर्नुहोस्!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“तिनीहरूका परमेश्‍वर कहाँ छन्?”","poem":1},{"text":"भन्‍ने मौका राष्ट्रहरूले नपाऊन्।","poem":2},{"lineBreak":true},{"text":"तपाईंका आफ्ना सेवकहरूको बगाइएका","poem":1},{"text":"रगतको बदला लिनुहुन्छ भन्‍ने कुरा","poem":2},{"lineBreak":true},{"text":"हाम्रै आँखाको अगि राष्ट्रहरूलाई थाहा गराउनुहोस्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"कैदीहरूका विलाप तपाईंको सामु पुगोस्;","poem":1},{"text":"तपाईंको शक्तिशाली हातद्वारा मृत्युको दण्डमा परेकाहरूको रक्षा गर्नुहोस्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"हे प्रभु, तिनीहरूले तपाईंलाई गरेका तिरस्कारको सट्टा,","poem":1},{"text":"हाम्रा छिमेकीहरूसँग सात गुणा बदला लिनुहोस्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तब हामी, तपाईंका मानिसहरू, तपाईंको खर्कका भेडाहरूले,","poem":1},{"text":"सदासर्वदा तपाईंको प्रशंसा गर्नेछौँ;","poem":2},{"text":"पुस्तौँ-पुस्तासम्म","poem":1},{"text":"हामी तपाईंको प्रशंसाको घोषणा गर्नेछौँ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}