{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति गित्तीथ",{"noteId":10},"मा आधारित, दावीदको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, हाम्रा प्रभु,","poem":1},{"text":"सारा पृथ्वीभरि तपाईंको नाम कति प्रतापी छ!","poem":2},{"lineBreak":true},{"text":"स्वर्गभन्दा उच्‍चमा","poem":1},{"text":"तपाईंले आफ्नो महिमा स्थापित गर्नुभएको छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तपाईंले केटाकेटीहरू र शिशुहरूका प्रशंसाबाट,","poem":1},{"text":"आफ्ना शत्रुहरू र विरोधीहरूलाई चुप गराउनलाई","poem":2},{"lineBreak":true},{"text":"शत्रुहरूका विरुद्ध बलियो किल्‍ला स्थापना गर्नुभएको छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जब म तपाईंका औँलाहरूद्वारा","poem":1},{"text":"बनाइएको आकाशलाई,","poem":2},{"text":"तपाईंले स्थापित गर्नुभएका चन्द्रमा","poem":1},{"text":"र ताराहरूमाथि विचार गर्छु,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मानिस जाति के नै हो र तपाईं त्यसको वास्ता गर्नुहुन्छ?","poem":1},{"text":"मनुष्यहरू के नै हुन् र तपाईं तिनीहरूको फ्रिक्री गर्नुहुन्छ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तपाईंले तिनीहरूलाई","poem":1},{"noteId":11},{"text":"स्वर्गदूतहरूभन्दा","poem":1},{"noteId":12},{"text":"केही कम बनाउनुभएको छ,","poem":1},{"text":"र तिनीहरूलाई","poem":2},{"noteId":13},{"text":"महिमा र आदरको मुकुट पहिर्‍याइदिनुभएको छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तपाईंका हातका कार्यहरूमाथि तपाईंले तिनीहरूलाई शासक बनाउनुभएको छ;","poem":1},{"text":"र तपाईंले सबै थोक तिनीहरूका पैतालामुनि राखिदिनुभएको छ:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"सबै भेडाबाख्रा र गाईगोरुहरू,","poem":1},{"text":"र सबै जङ्गली पशुपक्षीहरू,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"आकाशका चराचुरुङ्गीहरू","poem":1},{"text":"र समुद्रका माछाहरू","poem":2},{"lineBreak":true},{"text":"र समुद्रभित्र पौडने सबै जन्तुहरू।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"हे याहवेह, हाम्रा प्रभु,","poem":1},{"text":"सारा पृथ्वीभरि तपाईंको नाम कति प्रतापी छ!","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"शीर्षक: सम्भवतः एक साहित्यिक वा साङ्गीतिक शब्द","reference":{"chapter":8,"verse":0}},{"noteId":11,"caller":"+","text":"अथवा उहाँलाई","reference":{"chapter":8,"verse":5}},{"noteId":12,"caller":"+","text":"अथवा परमेश्‍वरभन्दा","reference":{"chapter":8,"verse":5}},{"noteId":13,"caller":"+","text":"अथवा उहाँलाई","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/npi_ncb/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}