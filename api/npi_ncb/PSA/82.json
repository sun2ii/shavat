{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["आसापको भजन।"]},{"type":"verse","number":1,"content":[{"text":"परमेश्‍वर विशाल समुदायमा आफ्नो स्थान ग्रहण गर्नुहुन्छ;","poem":1},{"text":"“देवताहरूका” बीचमा उहाँले न्याय गर्नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"कहिलेसम्म तिमीहरू अन्यायीहरूको पक्ष लिइबस्छौ?","poem":1},{"text":"र दुष्‍टहरूको पक्ष लिइरहन्छौ? सेला","poem":2}]},{"type":"verse","number":3,"content":[{"text":"दुर्बल र अनाथहरूका पक्षमा खडा होऊ;","poem":1},{"text":"गरिब र अत्याचारमा परेकाहरूको हकको रक्षा गर!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"दुर्बल र गरिबहरूलाई छुटाओ;","poem":1},{"text":"दुष्‍टहरूका हातबाट तिनीहरूलाई मुक्त गर!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“तिनीहरू न केही जान्दछन्, न त केही बुझ्दछन्;","poem":1},{"text":"तिनीहरू अन्धकारमा यताउता डुल्छन्;","poem":2},{"lineBreak":true},{"text":"पृथ्वीका सारा जग नै डगमगाएका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“मैले भनेँ, ‘तिमीहरू “देवहरू” हौ;","poem":1},{"text":"तिमीहरू सबै सर्वोच्‍च परमेश्‍वरका छोराहरू हौ।’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तर तिमीहरू साधारण मानिसहरूझैँ मर्नेछौ;","poem":1},{"text":"अरू शासकझैँ तिमीहरूको पतन हुनेछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे परमेश्‍वर, उठ्नुहोस्, पृथ्वीको न्याय गर्नुहोस्;","poem":1},{"text":"किनकि सारा राष्ट्रहरू तपाईंका उत्तराधिकार हुन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}