{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["एउटा गीत, आसापको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्‍वर, तपाईं मौन नरहनुहोस्;","poem":1},{"text":"हे परमेश्‍वर, आफ्नो कान नथुन्‍नुहोस्;","poem":2},{"lineBreak":true},{"text":"तपाईं निष्क्रिय नहुनुहोस्!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हेर्नुहोस्, तपाईंका शत्रुहरूले कस्तो हुङ्कार गरेका छन्,","poem":1},{"text":"तपाईंलाई घृणा गर्नेहरूले कसरी शिर ठाडो पारेका छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरूले धूर्ततासाथ तपाईंका मानिसहरूका विरुद्धमा षड्यन्त्र रच्तछन्;","poem":1},{"text":"तिनीहरू तपाईंले अनमोल ठान्‍नुभएकाहरूको विरुद्धमा मतो गर्छन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिनीहरू भन्छन्, “आओ, हामी तिनीहरूको राष्ट्रलाई ध्वंस पारौँ;","poem":1},{"text":"ताकि इस्राएल भन्‍ने नामको सम्झना नै नरहोस्!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तिनीहरू एकमत भएर षड्यन्त्र रच्दछन्;","poem":1},{"text":"तिनीहरू तपाईंको विरुद्ध गठबन्धन गर्दछन्—","poem":2}]},{"type":"verse","number":6,"content":[{"text":"एदोमीहरू र इश्माएलीहरूका पालहरू,","poem":1},{"text":"मोआबीहरू र हग्रीहरू,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"गबालीहरू, अम्मोनीहरू र अमालेकीहरू,","poem":1},{"text":"पलिश्तीहरू र टायरका निवासीहरू।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"लोतका सन्तानलाई सशक्त पार्न,","poem":1},{"text":"अश्शूर पनि तिनीहरूसँग मिलेको छ। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"मिद्यानीहरूलाई गर्नुभएझैँ तिनीहरूलाई पनि गर्नुहोस्,","poem":1},{"text":"कीशोन खोलामा सीसरा र याबीनलाई गरेझैँ गर्नुहोस्,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"जो एन्दोरमा नाश पारिएका थिए,","poem":1},{"text":"र जमिनमा फोहोर भएका थिए।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तिनीहरूका भारदारहरूलाई ओरेब र जीबझैँ,","poem":1},{"text":"राजकुमारहरूलाई जेबह र सल्मुन्‍नाजस्तै बनाउनुहोस्;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जसले भने, “हामी परमेश्‍वरका खर्कलाई","poem":1},{"text":"कब्जा गरौँ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"हे मेरा परमेश्‍वर, तिनीहरूलाई भुमरीमा परेको धुलोझैँ,","poem":1},{"text":"बतासले उडाएको भुसझैँ तुल्याउनुहोस्!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जसरी आगोले जङ्गल भस्म पार्छ,","poem":1},{"text":"र ज्वालाले पहाड जलाउँछ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"त्यसरी नै तिनीहरूलाई तपाईंको प्रचण्ड आँधीले खेद्नुहोस्","poem":1},{"text":"र आँधीबेहरीले तिनीहरूलाई भयभीत पार्नुहोस्!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तिनीहरूका मुहार लाजले ढाकिदिनुहोस्; ताकि हे याहवेह,","poem":1},{"text":"तिनीहरूले तपाईंको नामको खोजी गरून्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"तिनीहरू सधैँ शर्ममा परून्, र भयभीत होऊन्;","poem":1},{"text":"तिनीहरू अपमानमा नष्‍ट होऊन्।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तिनीहरूले जानून्, कि तपाईं जसको नाम याहवेह हो—","poem":1},{"text":"तपाईं मात्र सारा पृथ्वीमा सर्वोच्‍च परमेश्‍वर हुनुहुन्छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}