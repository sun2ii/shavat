{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["सङ्गीत निर्देशकको निम्ति, गित्तित, कोरहका छोराहरूको भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे सेनाहरूका याहवेह!","poem":1},{"text":"तपाईंको वासस्थान कति मनोहर छ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेहको मन्दिरका चोकहरूको निम्ति","poem":1},{"text":"मेरो प्राणले तिर्सना गर्दछ, र मूर्च्छा नै पर्छ;","poem":2},{"text":"मेरो हृदय र मेरो शरीर दुवैले","poem":1},{"text":"जीवित परमेश्‍वरको पुकार गर्दछ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हे सेनाहरूका याहवेह, मेरा राजा अनि मेरा परमेश्‍वर,","poem":1},{"text":"तपाईंका वेदीको नजिक","poem":2},{"lineBreak":true},{"text":"भँगेरीले पनि घर पाउँछे,","poem":2},{"text":"अनि गौँथलीले गुँड पाउँछे,","poem":1},{"text":"जहाँ आफ्ना बचेराहरूलाई हुर्काउँछे।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तपाईंको वासस्थानमा बस्‍ने धन्यका हुन्;","poem":1},{"text":"तिनीहरू सदा तपाईंको प्रशंसा गर्छन्। सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तिनीहरू धन्यका हुन्, जसको बल तपाईंमा छ;","poem":1},{"text":"जसले आफ्ना मन सियोनको यात्रामा लगाएका छन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिनीहरू बाकाको","poem":1},{"noteId":72},{"text":"बेँसीबाट भएर जाँदा,","poem":1},{"text":"तिनीहरूले त्यसलाई जलस्रोत बनाउँछन्;","poem":2},{"lineBreak":true},{"text":"शरद ऋतुको वर्षाले त्यहाँ आशिष्","poem":2},{"noteId":73},{"text":"हुँदछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरूले बलमाथि बल प्राप्‍त गर्दै जान्छन्;","poem":1},{"text":"जबसम्म प्रत्येक सियोनमा परमेश्‍वरको सामु उपस्थित हुँदैनन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे याहवेह सेनाहरूका परमेश्‍वर, मेरो प्रार्थना सुन्‍नुहोस्;","poem":1},{"text":"हे याकोबका परमेश्‍वर, मेरो बिन्ती सुन्‍नुहोस्! सेला","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे परमेश्‍वर, जो हाम्रो ढाल हुनुहुन्छ, हामीलाई हेर्नुहोस्;","poem":1},{"text":"तपाईंको आफ्नो अभिषिक्तमाथि कृपादृष्‍टि गर्नुहोस्!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"तपाईंको मन्दिरको चोकमा एक दिन","poem":1},{"text":"अरू ठाउँको हजार दिनभन्दा उत्तम छ;","poem":2},{"text":"दुष्‍टहरूका पालहरूमा बस्‍नुभन्दा त,","poem":1},{"text":"बरु मेरा परमेश्‍वरको भवनको ढोके हुन मलाई मन पर्छ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"किनकि याहवेह परमेश्‍वर सूर्य र ढाल हुनुहुन्छ;","poem":1},{"text":"याहवेहले निगाह र इज्जत दिनुहुन्छ;","poem":2},{"text":"सत्य मार्गमा हिँड्नेहरूलाई","poem":1},{"text":"याहवेहले कुनै भलो कुराबाट वञ्चित राख्नुहुन्‍न।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"हे सेनाहरूका याहवेह,","poem":1},{"text":"तपाईंमा भरोसा राख्ने मानिसहरू धन्यका हुन्।","poem":2}]}],"footnotes":[{"noteId":72,"caller":"+","text":"बाकाको अर्थ हो आँसु","reference":{"chapter":84,"verse":6}},{"noteId":73,"caller":"+","text":"अथवा तलाउहरू","reference":{"chapter":84,"verse":6}}]},"thisChapterLink":"/api/npi_ncb/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}