{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहले राज्य गर्नुहुन्छ, उहाँ वैभवले आभूषित हुनुहुन्छ;","poem":1},{"text":"याहवेह वैभवले आभूषित हुनुहुन्छ; र शक्तिले सुसज्जित हुनुहुन्छ;","poem":2},{"lineBreak":true},{"text":"निश्‍चय नै संसार दृढ र सुरक्षित स्थापित गरिएको छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"अनादिदेखि तपाईंको सिंहासन स्थापित भएको छ;","poem":1},{"text":"तपाईं अनन्तदेखि हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे याहवेह, समुद्रहरू उर्लिआएका छन्,","poem":1},{"text":"समुद्रहरूले आफ्नो गर्जन उच्‍च पारेका छन्;","poem":2},{"lineBreak":true},{"text":"तिनका भयानक छालहरू उर्लिएका छन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"महासमुद्रको गर्जनभन्दा शक्तिशाली,","poem":1},{"text":"समुद्रका तरङ्गहरूभन्दा पनि शक्तिशाली—","poem":2},{"lineBreak":true},{"text":"उच्‍चमा हुनुहुने याहवेह शक्तिशाली हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे याहवेह, तपाईंका कानुनहरू दृढ रहन्छन्;","poem":1},{"text":"अनन्तकालको निम्ति","poem":2},{"lineBreak":true},{"text":"तपाईंको भवन पवित्रताले सुसज्जित छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}