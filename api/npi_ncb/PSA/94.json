{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"हे याहवेह, बदला लिनुहुने परमेश्‍वर,","poem":1},{"text":"हे बदला लिनुहुने परमेश्‍वर, चम्कनुहोस्!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे पृथ्वीका न्यायाधीश, उठ्नुहोस्;","poem":1},{"text":"अहङ्कारीहरूलाई तिनीहरूले पाउनुपर्ने प्रतिफल दिनुहोस्!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हे याहवेह, कहिलेसम्म दुष्‍टहरू,","poem":1},{"text":"आखिर कहिलेसम्म दुष्‍टहरू उल्‍लासित भइरहून्?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"तिनीहरू अहङ्कारले भरिएको कुरा गर्छन्;","poem":1},{"text":"सबै कुकर्मीहरू घमण्डले भरिएका छन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे याहवेह, तिनीहरूले तपाईंका प्रजालाई कुल्चीमिल्ची पार्छन्;","poem":1},{"text":"तपाईंका उत्तराधिकारीहरूमाथि अत्याचार गर्छन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिनीहरू विधवा र विदेशीहरूलाई मार्दछन्;","poem":1},{"text":"अनाथहरूलाई हत्या गर्दछन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिनीहरू भन्छन्, “याहवेहले देख्नुहुन्‍न;","poem":1},{"text":"याकोबका परमेश्‍वरले चाल पाउनुहुन्‍न।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"मानिसहरूका माझमा ए विवेकहीनहरूहो; केही त विचार गर,","poem":1},{"text":"ए मूर्खहरू हो, तिमीहरू कहिले बुद्धिमान् हुन्छौ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जसले कान दिनुभयो के उहाँले सुन्‍नुहुन्‍न र?","poem":1},{"text":"जसले आँखा बनाउनुभयो के उहाँले देख्नुहुन्‍न र?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"के राष्ट्रहरूलाई अनुशासन गर्नुहुनेले दण्ड दिनुहुन्‍न र?","poem":1},{"text":"के मानव-जातिलाई शिक्षा दिनुहुनेलाई ज्ञानको अभाव हुन्छ र?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेहले मानिसका सबै योजनाहरू जान्‍नुहुन्छ;","poem":1},{"text":"ती व्यर्थ हुन्, भनी उहाँ जान्‍नुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"हे याहवेह, त्यो धन्यको हो, जसलाई तपाईंले अनुशासनमा राख्नुहुन्छ,","poem":1},{"text":"जसलाई आफ्नो व्यवस्थाबाट सिकाउनुहुन्छ;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"दुष्‍टहरूका निम्ति खाडल नखनिएसम्म","poem":1},{"text":"तपाईंले त्यसलाई कष्‍टका दिनमा आराम दिनुहुनेछ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"किनकि याहवेहले आफ्ना प्रजालाई तिरस्कार गर्नुहुनेछैन।","poem":1},{"text":"उहाँले आफ्ना उत्तराधिकारीहरूलाई त्याग्नुहुनेछैन।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"न्याय फेरि धार्मिकतामा स्थापित गरिनेछ,","poem":1},{"text":"र सबै सोझो हृदय भएकाहरू त्यसको पछि लाग्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"दुष्‍टहरूका विरुद्धमा मसँग को उठ्नेछ?","poem":1},{"text":"कुकर्मीहरूका विरुद्ध मेरो पक्षमा को खडा हुनेछ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"याहवेहले मलाई सहायता नगर्नुभएको भए,","poem":1},{"text":"म चाँडै मृत्युको शून्यतामा बास गर्न पुग्नेथिएँ।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"जब मैले भनेँ, “मेरो खुट्टा चिप्लँदैछ”","poem":1},{"text":"तब हे याहवेह, तपाईंको अचुक प्रेमले मलाई थाम्यो।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"जब मेरो मनमा ज्यादै चिन्ता-फिक्री भयो,","poem":1},{"text":"तब तपाईंको सान्त्वनाले मलाई आनन्दित तुल्यायो।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"के भ्रष्‍ट शासकहरू तपाईंसँग मिल्न सक्छन्,","poem":1},{"text":"जसले आफ्ना उर्दीद्वारा विपत्ति ल्याउँछन्?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तिनीहरू धर्मीहरूका विरुद्ध एकजुट हुन्छन्,","poem":1},{"text":"र निर्दोषमाथि मृत्युदण्डको आज्ञा गर्छन्।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तर याहवेह मेरो किल्‍ला हुनुभएको छ,","poem":1},{"text":"र परमेश्‍वर मेरो चट्टान हुनुहुन्छ, जसमा म शरण लिन्छु।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"उहाँले तिनीहरूका पाप तिनीहरूमाथि नै खन्याइदिनुहुनेछ,","poem":1},{"text":"र तिनीहरूका दुष्‍टताको लागि तिनीहरूलाई नाश गर्नुहुनेछ;","poem":2},{"lineBreak":true},{"text":"याहवेह हाम्रा परमेश्‍वरले तिनीहरूलाई नाश गर्नुहुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}