{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"आओ, हामी याहवेहको निम्ति आनन्दले गाऔँ;","poem":1},{"text":"हाम्रा मुक्तिका चट्टानको निम्ति उच्‍च सोरले जयजयकार गरौँ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"धन्यवाद चढाउँदै उहाँको सामु आऔँ,","poem":1},{"text":"भजन र सङ्गीतले उहाँको प्रशंसा गरौँ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"किनकि याहवेह महान् परमेश्‍वर हुनुहुन्छ,","poem":1},{"text":"सबै देवहरूमाथि महान् राजा।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पृथ्वीका गहिराइहरू उहाँको हातमा छ;","poem":1},{"text":"र पर्वतका चुचुराहरू उहाँकै हुन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"समुद्र उहाँकै हो, किनकि त्यो उहाँले नै बनाउनुभएको हो,","poem":1},{"text":"र सुक्खा जमिन उहाँकै हातद्वारा बनिए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"आओ, हामी उहाँलाई दण्डवत् गरौँ र आराधना गरौँ;","poem":1},{"text":"याहवेह हाम्रा सृष्‍टिकर्ताको अगि घुँडा टेकौँ;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"किनकि उहाँ नै हाम्रा परमेश्‍वर हुनुहुन्छ;","poem":1},{"text":"अनि हामी उहाँको खर्कका प्रजा र","poem":2},{"lineBreak":true},{"text":"उहाँको रेख-देखमा रहेको बगाल हौँ।","poem":2},{"lineBreak":true},{"text":"यदि आज तिमीहरूले उहाँको सोर सुन्यौ भने,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“तिमीहरूले मेरीबामा","poem":1},{"noteId":82},{"text":"गरेजस्तो आफ्नो हृदय कठोर नपार;","poem":1},{"text":"जस्तो तिमीहरूले त्यस दिन मरुभूमिमा भएको मस्सामा","poem":2},{"noteId":83},{"text":"गरेका थियौ,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जहाँ तिमीहरूका पुर्खाहरूले मलाई परीक्षा गरे;","poem":1},{"text":"तिनीहरूले मेरो काम देख्दादेख्दै पनि मेरो जाँच गरेका थिए।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"चालीस वर्षसम्म म त्यस पुस्तासँग रिसाएँ,","poem":1},{"text":"र मैले भनेँ, ‘यी यस्ता मानिसहरू हुन्, जसका हृदय बरालिएर जान्छन्,","poem":2},{"lineBreak":true},{"text":"र तिनीहरूले मेरा मार्गहरू चिनेका छैनन्।’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"यसकारण मैले आफ्नो क्रोधमा शपथ खाएर घोषणा गरेँ,","poem":1},{"text":"‘तिनीहरू कहिल्यै पनि मेरो विश्राममा पस्‍नेछैनन्।’ ”","poem":2}]}],"footnotes":[{"noteId":82,"caller":"+","text":"जसको अर्थ हो झगडा","reference":{"chapter":95,"verse":8}},{"noteId":83,"caller":"+","text":"जसको अर्थ हो परीक्षा गर्नु","reference":{"chapter":95,"verse":8}}]},"thisChapterLink":"/api/npi_ncb/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}