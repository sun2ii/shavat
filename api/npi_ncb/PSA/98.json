{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["एउटा भजन।"]},{"type":"verse","number":1,"content":[{"text":"याहवेहको निम्ति एउटा नयाँ गीत गाओ;","poem":1},{"text":"किनकि उहाँले अद्‌भुत कार्य गर्नुभएको छ;","poem":2},{"text":"उहाँका दाहिने हात र पवित्र पाखुराले","poem":1},{"text":"उहाँको निम्ति विजयका कामहरू गरेका छन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेहले आफ्नो मुक्तिको घोषणा गर्नुभएको छ;","poem":1},{"text":"र उहाँले आफ्नो धार्मिकता जाति-जातिहरूमा प्रकट गर्नुभएको छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उहाँले इस्राएलका घरानाप्रतिको आफ्नो अचुक प्रेम,","poem":1},{"text":"र उहाँको विश्‍वासयोग्यता स्मरण गर्नुभएको छ;","poem":2},{"text":"पृथ्वीका सम्पूर्ण सिमानाहरूले","poem":1},{"text":"हाम्रा परमेश्‍वरका मुक्तिलाई देखेका छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे सारा पृथ्वी, आनन्दसाथ उच्‍च सोरले याहवेहको जयजयकार गर;","poem":1},{"text":"सङ्गीतद्वारा उहाँको जयको घोषणा गर;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"वीणा बजाएर याहवेहको भजन गाओ!","poem":1},{"text":"वीणा र सुमधुर गीतकासाथ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तुरहीहरू र भेडाका सिङ फुकेर,","poem":1},{"text":"राजा याहवेहको सामु आनन्दले जयजयकार गर!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"समुद्र र त्यसमा भएका सबै थोकले,","poem":1},{"text":"संसार, र त्यहाँ बास गर्ने सबैले गुञ्जायमान गरून्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"नदीहरूका तरङ्गहरूले ताली बजाऊन्;","poem":1},{"text":"पर्वतहरूले एकसाथ आनन्दले गाऊन्;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिनीहरूले याहवेहको सामु गाऊन्;","poem":1},{"text":"किनकि, उहाँ पृथ्वीको न्याय गर्न आउनुहुन्छ।","poem":2},{"text":"उहाँले संसारलाई धार्मिकताकोसाथ","poem":1},{"text":"र जातिहरूलाई निष्पक्षतासाथ न्याय गर्नुहुनेछ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}