{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ncb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"6a417a5bdd02d4d6ea2c4de775ead90197f7db095963d21d4b575a910406643d","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ncb/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहले राज्य गर्नुहुन्छ;","poem":1},{"text":"राष्ट्रहरू थरथर कामून्;","poem":2},{"text":"उहाँ करूबहरूका बीचमा विराजमान हुनुहुन्छ;","poem":1},{"text":"पृथ्वी हल्‍लियोस्!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"सियोनमा याहवेह महान् हुनुहुन्छ;","poem":1},{"text":"उहाँ सबै राष्ट्रहरूमाथि सर्वोच्‍च हुनुहुन्छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिनीहरूले तपाईंको महान् र भययोग्य नामको प्रशंसा गरून्—","poem":1},{"text":"उहाँ पवित्र हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"राजा सर्वशक्तिमान् हुनुहुन्छ, उहाँले न्यायलाई मन पराउनुहुन्छ—","poem":1},{"text":"तपाईंले निष्पक्षता स्थापना गर्नुभएको छ;","poem":2},{"text":"तपाईंले याकोबमा","poem":1},{"text":"न्याय र धार्मिकता सम्पन्‍न गर्नुभएको छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेह हाम्रा परमेश्‍वरलाई उच्‍च पार,","poem":1},{"text":"र उहाँको पाउदानमा आराधना गर;","poem":2},{"lineBreak":true},{"text":"उहाँ पवित्र हुनुहुन्छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"उहाँका पुजारीहरूमध्ये मोशा र हारून थिए,","poem":1},{"text":"र शमूएल उहाँका नाम पुकार गर्नेहरू मध्येका एक थिए;","poem":2},{"text":"तिनीहरूले याहवेहलाई पुकारे,","poem":1},{"text":"र उहाँले तिनीहरूलाई जवाफ दिनुभयो।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उहाँले बादलको खाँबोबाट तिनीहरूसँग बोल्नुभयो;","poem":1},{"text":"उहाँले तिनीहरूलाई दिनुभएका विधान र उर्दीहरूको तिनीहरूले पालन गरे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे याहवेह, हाम्रा परमेश्‍वर,","poem":1},{"text":"तपाईंले तिनीहरूलाई जवाफ दिनुभयो;","poem":2},{"text":"तपाईं इस्राएलीहरूका निम्ति क्षमाशील परमेश्‍वर हुनुहुन्थ्यो,","poem":1},{"text":"यद्यपि तपाईंले तिनीहरूका दुष्कर्महरूलाई दण्ड दिनुभयो।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेह, हाम्रा परमेश्‍वरलाई उच्‍च पार,","poem":1},{"text":"र उहाँको पवित्र पर्वतमा आराधना गर;","poem":2},{"lineBreak":true},{"text":"किनकि याहवेह हाम्रा परमेश्‍वर पवित्र हुनुहुन्छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}