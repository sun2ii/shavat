{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"SNG","translationId":"npi_ncb","name":"श्रेष्‍ठगीत","commonName":"श्रेष्‍ठगीत","title":"श्रेष्‍ठगीतको पुस्तक","order":22,"numberOfChapters":8,"sha256":"972ee552f10f5b70747640b680dcf6846680458938fa742cf8d89750e0a8d549","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/npi_ncb/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["सोलोमनको श्रेष्‍ठगीत।"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"उहाँले मलाई आफ्ना ओठका चुम्बनहरूले चुम्बन गरून्—","poem":1},{"text":"किनकि तपाईंको प्रेम दाखमद्यभन्दा ज्यादा आनन्दमय छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तपाईंका अत्तरहरूका सुबास्‍ना सुगन्धित छ;","poem":1},{"text":"अत्तर खन्याइएको बास्‍नाजस्तै तपाईंको नाम सुगन्धित छ।","poem":2},{"lineBreak":true},{"text":"यसैकारण कन्याहरूले तपाईंलाई प्रेम गर्छन् भनेर अचम्म मान्‍नुपर्दैन!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मलाई तपाईंसित लैजानुहोस्—हामी हतार गरौँ!","poem":1},{"text":"राजाले मलाई आफ्ना भित्री कोठामा ल्याऊन्।","poem":2},"मित्रहरू",{"text":"तिमीमा","poem":1},{"noteId":0},{"text":"हामी रमाउनेछौँ, र आनन्द गर्नेछौँ;","poem":1},{"text":"दाखमद्यभन्दा बढी तिम्रो प्रेमको प्रशंसा हामी गर्नेछौँ।","poem":2},"प्रेमिका",{"text":"तपाईंको प्रशंसा गरेर तिनीहरूले कति उचित गर्छन्!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे यरूशलेमका छोरीहरू हो,","poem":1},{"text":"म काली वर्णकी भए तापनि हिस्सी परेकी छु;","poem":2},{"text":"केदारका पालहरूजस्तै,","poem":1},{"text":"सोलोमनको","poem":2},{"noteId":1},{"text":"पालका पर्दाजस्तै।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"म काली भएकीले छक्‍क परेर मलाई नहेर;","poem":1},{"text":"किनकि चर्को घामले डढेर म यस्ती भएकी हुँ।","poem":2},{"text":"मेरी आमाका छोराहरू मसित रिसाएकाले","poem":1},{"text":"मलाई तिनीहरूले दाखबारीको हेरचाह गर्ने जिम्मा दिए;","poem":2},{"lineBreak":true},{"text":"तर मैले आफ्नै दाखबारीचाहिँ बेवास्ता गर्नुपर्‍यो।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"हे मेरा प्रियतम, जसलाई म प्रेम गर्दछु, मलाई बताइदिनुहोस्;","poem":1},{"text":"तपाईंले आफ्ना भेडाबाख्राहरू कहाँ चराउनुहुन्छ,","poem":2},{"lineBreak":true},{"text":"मध्यदिनमा तिनीहरूलाई कहाँ विश्राम गराउनुहुन्छ,","poem":2},{"text":"तपाईंका साथीहरूका बगालहरूका छेउमा","poem":1},{"text":"म किन अनुहार छोपेकी स्त्रीझैँ बनूँ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हे स्त्रीहरूमा सबैभन्दा सुन्दरी, तिमी त्यो जान्दिनौ भने,","poem":1},{"text":"भेडाबाख्राका पाइलाहरू पहिल्‍याउँदै जाऊ,","poem":2},{"text":"र गोठालाहरूका पालहरूको छेउमै","poem":1},{"text":"आफ्ना बाख्राका पाठाहरूलाई चराऊ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे मेरी प्रिय, म तिमीलाई फारोको रथमा नारिएकी","poem":1},{"text":"घोडीसित तुलना गर्दछु।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिम्रा गाला कानका झुम्काले,","poem":1},{"text":"र तिम्रो गला रत्न जडेको हारले सुन्दर देखिन्छन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हामी तिम्रा लागि चाँदीका दाना जडिएका","poem":1},{"text":"सुनका लुर्कनहरू बनाउनेछौँ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"महाराजा आफ्नो भोजका टेबुलमा बस्‍नुहुँदा,","poem":1},{"text":"मेरो अत्तरको सुबास्‍ना फैलिन्छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"मेरा प्रियतम, मेरा निम्ति मूर्रको थैलीजस्तै हुनुहुन्छ,","poem":1},{"text":"जो मेरा छातीको बीचमा ढल्कनुहुन्छ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"मेरा प्रेमी, मेरा निम्ति एन-गदीका दाखबारीहरूमा फुल्ने","poem":1},{"text":"मेहदी फूलको गुच्छाझैँ हुनुहुन्छ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"हे मेरी प्रियसी, तिमी कत्ति सुन्दरी छ्यौ,","poem":1},{"text":"ओह, कत्ति सुन्दरी!","poem":2},{"lineBreak":true},{"text":"तिम्रा आँखाहरू ढुकुरजस्तै छन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"हे मेरा प्रियतम, तपाईं कत्ति सुन्दर हुनुहुन्छ!","poem":1},{"text":"कत्ति सुन्दर हुनुहुन्छ!","poem":2},{"lineBreak":true},{"text":"हाम्रो ओछ्यान लहलहाउँदो छ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"हाम्रा घरका दलिनहरू देवदारुका छन्;","poem":1},{"text":"अनि सल्‍ला रूखका छाना छन्।","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"मूल भाषामा पुरुषको एक वचन भन्‍ने हुन्छ।","reference":{"chapter":1,"verse":4}},{"noteId":1,"caller":"+","text":"अथवा सल्मा","reference":{"chapter":1,"verse":5}}]},"thisChapterLink":"/api/npi_ncb/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}