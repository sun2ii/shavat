{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"SNG","translationId":"npi_ncb","name":"श्रेष्‍ठगीत","commonName":"श्रेष्‍ठगीत","title":"श्रेष्‍ठगीतको पुस्तक","order":22,"numberOfChapters":8,"sha256":"972ee552f10f5b70747640b680dcf6846680458938fa742cf8d89750e0a8d549","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/npi_ncb/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"म त शारोनको गुलाफ,","poem":1},{"noteId":2},{"text":"बेँसीहरूको लिली फूल हुँ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"युवतीहरूका बीचमा","poem":1},{"text":"मेरी प्रिय काँडाहरू बीचको लिली फूलझैँ छिन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"युवकहरूका बीचमा मेरा प्रिय,","poem":1},{"text":"जङ्गलका रूखहरूका बीचमा स्याउको","poem":2},{"noteId":3},{"text":"बोटजस्तै हुनुहुन्छ।","poem":2},{"text":"उहाँका छायामुनि बस्दा मलाई आनन्द लाग्दछ;","poem":1},{"text":"अनि उहाँको फल मलाई साह्रै मिठो लाग्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उहाँले मलाई महाभोजको कोठामा लैजानुभयो;","poem":1},{"text":"र ममाथि उहाँको झण्डाचाहिँ उहाँको प्रेम हो।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"प्रेम रोगले गर्दा म शिथिल भएकी छु,","poem":1},{"text":"यसकारण मलाई किसमिस खुवाएर बलियो बनाउनुहोस्;","poem":2},{"lineBreak":true},{"text":"स्याउ दिएर ताजा पार्नुहोस्!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"उहाँको देब्रे हात मेरो शिरमुनि छ,","poem":1},{"text":"र दाहिने हातले मलाई अँगालो हाल्नुभएको छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"हे यरूशलेमका छोरीहरू हो, म तिमीहरूलाई","poem":1},{"text":"मैदानका मुडुली मृगीहरू र हरिणीहरूको नाममा शपथ खुवाएर आज्ञा गर्छु;","poem":2},{"text":"उचित समय नभएसम्म","poem":1},{"text":"प्रेमलाई नजगाओ, अथवा नबिउँझाओ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"सुन, मेरा प्रियतम!","poem":1},{"text":"हेर, उहाँ आउँदैहुनुहुन्छ;","poem":2},{"text":"पर्वतहरूलाई पार गर्दै, डाँडाहरूमाथि फड्को मार्दै,","poem":1},{"text":"उहाँ आउँदैहुनुहुन्छ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मेरा प्रिय एक मृगझैँ, अथवा जवान जरायोझैँ हुनुहुन्छ।","poem":1},{"text":"हेर, उहाँ हाम्रा पर्खालको पछिल्तिर उभिनुभएको छ;","poem":2},{"text":"झ्यालहरूबाट हेर्दै हुनुहुन्छ;","poem":1},{"text":"अनि आँखीझ्याल भित्रबाट चियाउँदै हुनुहुन्छ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मेरा प्रियले बोल्नुभयो र मलाई भन्‍नुभयो,","poem":1},{"text":"“हे मेरी प्रियसी उठ,","poem":2},{"lineBreak":true},{"text":"हे मेरी सुन्दरी, मसित आऊ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हेर, हिउँद बित्यो,","poem":1},{"text":"वर्षा पनि सकियो।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"पृथ्वीमा फूलहरू देखा परेका छन्;","poem":1},{"text":"गीत गाउने समय आएको छ।","poem":2},{"text":"हाम्रो भूमिमा ढुकुरहरू","poem":1},{"text":"कुर्लेको सोर सुनिन्छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"अञ्जीरको बोटमा फलहरू फल्न थाल्यो;","poem":1},{"text":"दाखले त फुलेर बास्‍ना फैलाउन थाल्यो।","poem":2},{"text":"उठ, आऊ, मेरी प्रिय,","poem":1},{"text":"हे मेरी सुन्दरी, मसित आऊ!”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"चट्टानका चिराहरूमा,","poem":1},{"text":"भिरपहराका गुप्‍त ठाउँहरूमा, लुकेर बसेकी मेरी ढुकुर;","poem":2},{"text":"मलाई तिम्रो अनुहार देखाऊ!","poem":1},{"text":"तिम्रो सोर सुन्‍न पाऊँ;","poem":2},{"text":"किनकि तिम्रो सोर मिठो छ;","poem":1},{"text":"र तिम्रो मुहार सुन्दर छ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"हाम्रा निम्ति फ्याउराहरू समातिदेऊ;","poem":1},{"text":"साना फ्याउराहरू,","poem":2},{"text":"जसले दाखबारीमा फूलहरू फुलेका बेला","poem":1},{"text":"हाम्रा दाखबारीहरू नाश पार्दछन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"मेरा प्रिय मेरै हुनुहुन्छ, र म उहाँकी हुँ;","poem":1},{"text":"उहाँ लिली फूलहरूका बीचमा टहल्नुहुन्छ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"जबसम्म बिहान हुँदैन,","poem":1},{"text":"र छायाहरू हराउँदैनन्,","poem":2},{"text":"हे मेरा प्रियतम, फर्कनुहोस्;","poem":1},{"text":"र मृगझैँ,","poem":2},{"text":"अथवा भिरालो डाँडाहरूमाथि हुने","poem":1},{"text":"घोर्ले जरायोझैँ हुनुहोस्","poem":2},{"noteId":4},{"text":"!","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"सायद क्रोकस जातिको फूल हुन सक्छ।","reference":{"chapter":2,"verse":1}},{"noteId":3,"caller":"+","text":"स्याउ यहाँ र श्रेष्‍ठ गीतका अन्य भागमा एप्रिकोट नामको फल हुन सक्छ।","reference":{"chapter":2,"verse":3}},{"noteId":4,"caller":"+","text":"अथवा बेथेरका डाँडाहरू","reference":{"chapter":2,"verse":17}}]},"thisChapterLink":"/api/npi_ncb/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}