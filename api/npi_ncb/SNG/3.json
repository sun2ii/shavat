{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"SNG","translationId":"npi_ncb","name":"श्रेष्‍ठगीत","commonName":"श्रेष्‍ठगीत","title":"श्रेष्‍ठगीतको पुस्तक","order":22,"numberOfChapters":8,"sha256":"972ee552f10f5b70747640b680dcf6846680458938fa742cf8d89750e0a8d549","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/npi_ncb/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"रातभरि मैले मेरो ओछ्यानमा","poem":1},{"text":"मेरा हृदयको प्रेमीलाई खोजेँ;","poem":2},{"lineBreak":true},{"text":"मैले उहाँको खोजी गरेँ, तर उहाँलाई भेट्टाइनँ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"अब म उठेर सहरतिर जानेछु,","poem":1},{"text":"गल्‍ली र चोकहरूहुँदो;","poem":2},{"text":"मेरा हृदयको प्रेमीलाई खोज्नेछु।","poem":1},{"text":"मैले उहाँलाई खोजेँ, तर उहाँलाई भेट्टाइनँ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"सहरमा घुम्‍दै गरेका पहरेदारहरूले","poem":1},{"text":"मलाई भेट्टाए;","poem":2},{"lineBreak":true},{"text":"मैले सोधेँ, “तपाईंहरूले मेरा हृदयको प्रेमीलाई देख्नुभयो?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"म तिनीहरूबाट केही पर मात्र के गएको थिएँ;","poem":1},{"text":"मैले मेरा हृदयको प्रेमीलाई फेला पारेँ।","poem":2},{"text":"मैले उहाँलाई च्याप्पै समातेँ र कतै जान दिइनँ,","poem":1},{"text":"मेरी आमाको घरमा,","poem":2},{"lineBreak":true},{"text":"मलाई जन्माउने मेरी आमाको कोठामा नपुगुन्जेल सँगै लिएर आएँ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे यरूशलेमका छोरीहरू हो,","poem":1},{"text":"म तिमीहरूलाई मैदानका मुडुली मृगीहरू र हरिणीहरूको नाममा शपथ खुवाएर आज्ञा गर्छु:","poem":2},{"text":"उचित समय नभएसम्म","poem":1},{"text":"प्रेमलाई नजगाओ, अथवा नबिउँझाओ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"व्यापारीहरूका सबै मसलाहरूबाट बनिएका","poem":1},{"text":"धूप र मूर्रको सुगन्धले","poem":2},{"text":"धुवाँको मुस्लोजस्तै,","poem":1},{"text":"उजाडस्थानबाट माथि आइरहेका को हुन्?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"हेर, सोलोमनको सवारी पालकी;","poem":1},{"text":"इस्राएलका सुयोग्य,","poem":2},{"lineBreak":true},{"text":"साठी जना योद्धाहरूको सुरक्षामा आइरहेका छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिनीहरू सबैले तरवार भिरेका छन्,","poem":1},{"text":"सबै जना युद्धकलामा पोख्त छन्;","poem":2},{"text":"रातको हरेक खतरादेखि बचाउन,","poem":1},{"text":"हरेकले आफ्ना कम्मरमा तरवार भिरेका छन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"सोलोमन राजाले आफ्नो निम्ति त्यो पालकी बनाएका हुन्;","poem":1},{"text":"त्यो लेबनानको काठले बनिएको छ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"त्यसका डण्डाहरू चाँदीले,","poem":1},{"text":"र आधार सुनले बनिएका छन्।","poem":2},{"text":"त्यसको आसन बैजनी लुगाले सजाइएको छ।","poem":1},{"text":"अनि भित्री भागमा चाहिँ","poem":2},{"text":"प्रेमसाथ यरूशलेमका छोरीहरूले बुट्टा भरेका छन्।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"हे सियोनका छोरीहरू हो, बाहिर आओ,","poem":1},{"text":"सोलोमन राजाले मुकुट पहिरेका हेर;","poem":2},{"text":"त्यो त्यही मुकुट हो, जुन तिनकी आमाले","poem":1},{"text":"तिनको विवाहको दिनमा,","poem":2},{"text":"तिनको हृदय आनन्दले पूर्ण भएको दिनमा,","poem":1},{"text":"तिनको शिरमा लगाइदिएकी थिइन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}