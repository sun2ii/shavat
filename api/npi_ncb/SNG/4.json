{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"SNG","translationId":"npi_ncb","name":"श्रेष्‍ठगीत","commonName":"श्रेष्‍ठगीत","title":"श्रेष्‍ठगीतको पुस्तक","order":22,"numberOfChapters":8,"sha256":"972ee552f10f5b70747640b680dcf6846680458938fa742cf8d89750e0a8d549","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/npi_ncb/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"हे मेरी प्रियसी, तिमी कत्ति सुन्दरी छौ,","poem":1},{"text":"ओह, कत्ति सुन्दरी!","poem":2},{"lineBreak":true},{"text":"घुम्टोभित्र तिम्रा आँखाहरू ढुकुरजस्तै छन्।","poem":2},{"text":"तिम्रा केश गिलाद डाँडाबाट","poem":1},{"text":"ओरालो झरेको बाख्राको बगालजस्तै छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तिम्रा दाँतहरू भर्खर ऊन कत्रेर नुहाएर","poem":1},{"text":"उकालो लागेका भेडाहरूको बगालजस्तै छन्।","poem":2},{"text":"हरेकका जुम्ल्याहा छन्;","poem":1},{"text":"कुनै पनि एकलो छैन।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिम्रा ओठ राता रिबनझैँ छन्;","poem":1},{"text":"तिम्रो मुख कत्ति सुन्दर छ।","poem":2},{"text":"घुम्टोभित्र लुकेको तिम्रो गाला","poem":1},{"text":"दुई फ्याक पारेको अनारझैँ छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिम्रो गला दावीदको धरहराजस्तै छ,","poem":1},{"text":"जो ढुङ्गैढुङ्गाले","poem":2},{"noteId":5},{"text":"मिलाएर बनाइएको थियो;","poem":2},{"text":"त्यसमा हजार वटा ढालहरू झुण्ड्याइएका छन्।","poem":1},{"text":"ती सबै वीर योद्धाहरूका ढाल हुन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिम्रा दुई स्तन जुम्ल्याहा पाठाजस्तै छन्,","poem":1},{"text":"मृगीका दुई पाठाजस्तै,","poem":2},{"lineBreak":true},{"text":"जो लिली फूलहरूको बीचमा चर्दछन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जबसम्म बिहान हुँदैन,","poem":1},{"text":"र अन्धकार हराउँदैन;","poem":2},{"text":"म मूर्र भएको पहाड","poem":1},{"text":"र धूपको डाँडामा जानेछु।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"हे मेरी मायालु, तिमी असाध्यै सुन्दरी छ्यौ;","poem":1},{"text":"तिमीमा कुनै खोट छैन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे मेरी दुलही, मसित लेबनानबाट आऊ,","poem":1},{"text":"लेबनानबाट मसित आऊ!","poem":2},{"text":"अमानाको शिखरबाट,","poem":1},{"text":"सेनीर र हेर्मोनका टाकुराबाट,","poem":2},{"text":"सिंहका गुफाबाट","poem":1},{"text":"र चितुवाका पहाडी ओडारबाट तल आऊ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे मेरी प्रिय,","poem":1},{"noteId":6},{"text":"मेरी दुलही, तिमीले मेरो हृदय चोरेकी छ्यौ;","poem":1},{"text":"तिम्रा आँखाको एक नजरले,","poem":2},{"text":"तिम्रो हारको एउटा रत्नले","poem":1},{"text":"तिमीले मेरो हृदय चोरेकी छ्यौ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तिम्रो प्रेम कति आनन्दमय छ,","poem":1},{"text":"मेरी प्रिय, मेरी दुलही!","poem":2},{"text":"तिम्रो प्रेम दाखमद्यभन्दा धेरै उत्तम छ!","poem":1},{"text":"अनि तिम्रो अत्तरको बास्‍नाचाहिँ","poem":2},{"text":"अरू मसलाभन्दा धेरै सुगन्धित छ!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"मेरी दुलही, तिम्रा ओठबाट मौरीका चाकाको मिठास चुहुन्छ;","poem":1},{"text":"तिम्रो जिब्रोमुनि दूध र मह छन्।","poem":2},{"text":"अनि तिम्रा वस्त्रहरूको बास्‍नाचाहिँ","poem":1},{"text":"लेबनानको बास्‍नाझैँ छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मेरी प्रिय, मेरी दुलही, तिमी बन्द गरी राखिएको बगैँचाझैँ छ्यौ;","poem":1},{"text":"तिमी छोपिएको पानीको मूल, मोहर लगाएर बन्द राखेको पानीको मुहानझैँ छ्यौ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तिम्रा बोटहरू अनारको बगैँचाजस्तै छन्;","poem":1},{"text":"जसमा उत्तम फलहरू,","poem":2},{"lineBreak":true},{"text":"मेहदी र जटामसीको बगैँचा;","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"जटामसी र केशर,","poem":2},{"lineBreak":true},{"text":"बोझो र दालचिनी,","poem":2},{"lineBreak":true},{"text":"सबै प्रकारका सुगन्धित धूपका रूखहरू,","poem":2},{"lineBreak":true},{"text":"मूर्र र चन्दन","poem":2},{"lineBreak":true},{"text":"अनि सर्वोत्तम मसालाहरूले भरिभराउ बगैँचा छन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तिमी बगैँचाको मुहान,","poem":1},{"text":"लेबनानका पहाडी क्षेत्रबाट बगेर आउने","poem":2},{"lineBreak":true},{"text":"पानीको मुहान हौ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"हे उत्तरको बतास, जाग्!","poem":1},{"text":"हे दक्षिणको बतास, आइज!","poem":2},{"text":"मेरो बगैँचाबाट भएर बहिदे,","poem":1},{"text":"ताकि यसको बास्‍ना चारैतिर फैलियोस्।","poem":2},{"text":"मेरा प्रिय आफ्नो बगैँचामा आऊन्,","poem":1},{"text":"र त्यहाँका उत्तम फलहरू चाखून्!","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"मूल भाषामा यो वाक्यांशको अर्थ अनिश्‍चित छ।","reference":{"chapter":4,"verse":4}},{"noteId":6,"caller":"+","text":"मूल भाषामा बहिनी","reference":{"chapter":4,"verse":9}}]},"thisChapterLink":"/api/npi_ncb/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}