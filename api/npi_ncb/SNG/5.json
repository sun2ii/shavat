{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"SNG","translationId":"npi_ncb","name":"श्रेष्‍ठगीत","commonName":"श्रेष्‍ठगीत","title":"श्रेष्‍ठगीतको पुस्तक","order":22,"numberOfChapters":8,"sha256":"972ee552f10f5b70747640b680dcf6846680458938fa742cf8d89750e0a8d549","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/npi_ncb/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"हे मेरी प्रिय, मेरी दुलही, म मेरो बगैँचामा आएको छु;","poem":1},{"text":"मैले आफ्नो मूर्र मसलाहरूसहित बटुलेको छु।","poem":2},{"text":"मैले मेरो महको चाका र मेरो मह खाएको छु,","poem":1},{"text":"मैले मेरो दाखमद्य र मेरो दूध पिएको छु।","poem":2},"मित्रहरू",{"text":"हे मित्रहरू हो, खाओ र पिओ;","poem":1},{"text":"प्रेमीहरू हो, अघाउन्जेल पिओ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"म त सुतेँ, तर मेरो हृदय जागै रह्‍यो;","poem":1},{"text":"सुन! मेरा प्रियले ढोका ढकढकाउँदै हुनुहुन्छः","poem":2},{"text":"“मेरी प्रेमी, मेरी प्रिय, मेरो निम्ति ढोका खोलिदेऊ;","poem":1},{"text":"मेरी ढुकुर, मेरी निष्खोट सुन्दरी,","poem":2},{"text":"मेरो शिर शीतले भिजेको छ;","poem":1},{"text":"रातको शितले मेरो कपाल भिजेको छ।”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मैले मेरो वस्त्र फुकालीसकेकी छु—","poem":1},{"text":"के मैले त्यो फेरि लगाउनू?","poem":2},{"text":"मैले मेरा खुट्टा धोएकी छु—","poem":1},{"text":"के मैले ती फेरि मैला बनाउनू?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मेरा प्रियले ढोका खोल्न चेपबाट हात भित्र छिराउँदा,","poem":1},{"text":"उहाँको निम्ति मेरो मुटु धड्कन लाग्यो।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मेरा प्रियको निम्ति ढोका खोल्न म उठेँ,","poem":1},{"text":"मेरो हात र औँलाहरूबाट मूर्र चुहुँदैथियो;","poem":2},{"text":"र मेरा औँलाहरूबाट","poem":1},{"text":"ढोका समात्ने ठाउँमा मूर्र चुहियो।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मैले मेरा प्रियको निम्ति ढोका खोलेँ,","poem":1},{"text":"तर मेरा प्रिय हिँडिसक्नुभएछ; उहाँ गइसक्नुभएछ।","poem":2},{"lineBreak":true},{"text":"उहाँको बिदाइमा मेरो हृदय खिन्‍न भयो।","poem":2},{"text":"मैले उहाँलाई खोजेँ, तर भेट्टाइनँ।","poem":1},{"text":"मैले उहाँलाई बोलाएँ, तर उहाँले केही जवाफ दिनुभएन।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"सहरमा गस्ती गरिरहेका","poem":1},{"text":"पहरेदारहरूले मलाई भेट्टाए।","poem":2},{"text":"अनि तिनीहरूले मलाई हिर्काए र घाइते पारिदिए;","poem":1},{"text":"ती पर्खालहरूका पहरेदारहरूले","poem":2},{"lineBreak":true},{"text":"मेरो खास्टो खोसेर लगे!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हे यरूशलेमका छोरीहरू हो, म तिमीहरूलाई अनुरोध गर्दछु—","poem":1},{"text":"यदि तिमीहरूले मेरा प्रियलाई भेट्टायौ भने,","poem":2},{"text":"उहाँलाई के भनौला?","poem":1},{"text":"म प्रेमले पागल भइसकेकी छु भनेर भनिदेओ।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे नारीहरूमध्ये परमसुन्दरी,","poem":1},{"text":"तिम्रा प्रिय कसरी अरूहरूभन्दा असल छन्?","poem":2},{"text":"तिम्रा प्रियचाहिँ कसरी अरूहरूभन्दा असल छन्,","poem":1},{"text":"र तिमी हामीलाई यसरी आग्रह गर्दछ्यौ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"हे यरूशलेमका छोरीहरू हो,","poem":1},{"text":"दश हजारमध्ये पनि मेरा प्रेमी श्रेष्‍ठ, उज्ज्वल र रातो-पिरो हुनुहुन्छ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"उहाँको शिर निखुर सुनको छ;","poem":1},{"text":"उहाँको केश घुम्रिएको","poem":2},{"lineBreak":true},{"text":"र कागझैँ कालो छ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"उहाँका आँखाहरू","poem":1},{"text":"पानीका जलकुण्डको छेउमा बसेका ढुकुरहरूजस्ता,","poem":2},{"text":"दूधले पखालिएको,","poem":1},{"text":"बहुमूल्य पत्थर जडिएका जस्ता छन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"उहाँका गाला सुगन्ध फैलाउने","poem":1},{"text":"मसलाहरूका ड्याङझैँ छन्।","poem":2},{"text":"उहाँका ओठ मूर्र चुहाउने","poem":1},{"text":"लिली फूलसमान छन्।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"उहाँका पाखुरा पीतमणि जडेका","poem":1},{"text":"सुनका डण्डाजस्तै छन्।","poem":2},{"text":"शरीर नीलमणि जडेको चिल्‍लो,","poem":1},{"text":"टल्कने हस्तीदन्तझैँ छ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"उहाँका गोडा निखुर सुनको जगमा बसालिएका","poem":1},{"text":"सिङ्गमरमरका खम्बा हुन्।","poem":2},{"text":"उहाँको रूप लेबनानका","poem":1},{"text":"उत्तम देवदारुजस्तै देखिन्छ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"उहाँको मुख मिठासपूर्ण छ;","poem":1},{"text":"उहाँ सम्पूर्ण रूपले सुन्दर हुनुहुन्छ।","poem":2},{"text":"उहाँ नै मेरा प्रिय, मेरा मित्र हुनुहुन्छ,","poem":1},{"text":"हे यरूशलेमका छोरीहरू हो।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}