{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"SNG","translationId":"npi_ncb","name":"श्रेष्‍ठगीत","commonName":"श्रेष्‍ठगीत","title":"श्रेष्‍ठगीतको पुस्तक","order":22,"numberOfChapters":8,"sha256":"972ee552f10f5b70747640b680dcf6846680458938fa742cf8d89750e0a8d549","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/npi_ncb/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"हे नारीहरूमा परमसुन्दरी,","poem":1},{"text":"तिम्रा प्रिय कहाँ गएका छन्?","poem":2},{"text":"तिनी कुन बाटोतिर गएका छन्,","poem":1},{"text":"हामीलाई भन, ताकि हामी पनि तिमीसँगै तिनलाई खोज्जौँ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मेरा प्रिय आफ्नो बगैँचामा,","poem":1},{"text":"मसलाहरूको ड्याङहरूमा,","poem":2},{"text":"त्यहाँ टहल्न","poem":1},{"text":"र लिली फूल टिप्नलाई जानुभएको छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"म मेरा प्रियकी हुँ, र मेरा प्रिय मेरै हुनुहुन्छ;","poem":1},{"text":"उहाँ लिली फूलहरूका बीचमा टहल्नुहुन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मेरी प्रिय, तिमी तिर्सा सहरजस्तै सुन्दरी,","poem":1},{"text":"र यरूशलेमजस्तै राम्री छ्यौ;","poem":2},{"lineBreak":true},{"text":"आफ्ना झण्डा लिएर हिँड्ने सेनाझैँ गौरवशाली छ्यौ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिम्रा आँखाहरू मबाट हटाऊ;","poem":1},{"text":"तिनले मलाई व्याकुल पार्दछन्,","poem":2},{"text":"तिम्रा कपाल गिलाद डाँडाबाट ओरालो लागेका","poem":1},{"text":"बाख्राहरूको बगालसरह छन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तिम्रा दाँतहरू नुहाएर उकालो लागेका","poem":1},{"text":"भेडाहरूको बगालजस्तै छन्।","poem":2},{"text":"हरेकका जुम्ल्याहा छन्,","poem":1},{"text":"कुनै पनि एकलो छैन।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"घुम्टोभित्र लुकेका तिम्रा दुई गाला","poem":1},{"text":"दुई फ्याक पारेका अनारझैँ छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"चाहे साठी वटा रानीहरू होऊन्,","poem":1},{"text":"चाहे असीवटा उपपत्नीहरू,","poem":2},{"lineBreak":true},{"text":"चाहे अनगन्ती कन्ये केटीहरू होऊन्;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तर मेरी ढुकुर, मेरी सर्वश्रेष्‍ठ, तिनी विशेष छिन्;","poem":1},{"text":"तिनकी आमाकी एउटी मात्र,","poem":2},{"lineBreak":true},{"text":"मनपर्दो सन्तान हुन्।","poem":2},{"text":"कन्याहरूले तिनलाई देखे, र तिनलाई आशिषित भने;","poem":1},{"text":"रानीहरू र उपपत्नीहरूले तिनको प्रशंसा गरे।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"चन्द्रमाझैँ स्वच्छ, सूर्यझैँ उज्ज्वल,","poem":1},{"text":"झण्डा फहराउने प्रतापी सेनाझैँ,","poem":2},{"lineBreak":true},{"text":"प्रभातजस्तो देखा पर्ने ऊनी को हुन्?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"बदामका बोटहरू भएका बेँसीतिर","poem":1},{"text":"नयाँ पालुवा लागे कि,","poem":2},{"text":"दाखको बोटमा कोपिला लागेको छ कि छैन,","poem":1},{"text":"वा अनारको फूल फुलेको छ कि छैन भनेर म तल हेर्न गएँ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मैले थाहा पाउनुअगि","poem":1},{"text":"मेरा प्रजाका","poem":2},{"noteId":7},{"text":"राजकीय रथमा सवार हुन मलाई मेरो इच्छाले पुर्‍याइसकेको छ।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"हे शूलम्मी, फर्केर आऊ, फर्केर आऊ,","poem":1},{"text":"फर्केर आऊ, फर्केर आऊ, र हामी तिमीलाई एक टक लगाएर हेरिरहन सकौँ!","poem":2},"प्रेमी",{"text":"महानोमको नाच हेरेझैँ","poem":1},{"text":"किन तिमीहरू शूलम्मीलाई एक टक लगाएर हेर्न रहर गर्छौ?","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":7,"caller":"+","text":"अथवा अम्मीनादाबका रथहरू; अथवा राजकुमारका मानिसहरूका रथहरू","reference":{"chapter":6,"verse":12}}]},"thisChapterLink":"/api/npi_ncb/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}