{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"SNG","translationId":"npi_ncb","name":"श्रेष्‍ठगीत","commonName":"श्रेष्‍ठगीत","title":"श्रेष्‍ठगीतको पुस्तक","order":22,"numberOfChapters":8,"sha256":"972ee552f10f5b70747640b680dcf6846680458938fa742cf8d89750e0a8d549","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/npi_ncb/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"हे राजकुमारकी छोरी,","poem":1},{"text":"चप्पल लगाइएका तिम्रा पाउ कत्ति सुन्दर छन्!","poem":2},{"text":"तिम्रा तिघ्राहरूका आकार","poem":1},{"text":"शिल्पकारका हातले बनाइएका रत्नजस्तै छन्।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तिम्रो नाभी गोलो प्यालाजस्तै छ,","poem":1},{"text":"जसमा मिसाएका दाखमद्यको अभाव कहिल्यै हुँदैन।","poem":2},{"text":"तिम्रो कम्मर लिली फूलले घेरेको","poem":1},{"text":"गहुँको थुप्रोजस्तै छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिम्रा दुई स्तन जुम्ल्याहा पाठाजस्तै छन्,","poem":1},{"text":"मृगीका दुई पाठाजस्तै।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिम्रो गला हस्तीदन्तको धरहराजस्तै छ।","poem":1},{"lineBreak":true},{"text":"तिम्रा आँखा बाथ-रब्बीमको छेउको","poem":1},{"text":"हेश्बोनका पोखरीजस्तै छन्,","poem":2},{"text":"तिम्रो नाक दमस्कसतिर हेरिराखेको","poem":1},{"text":"लेबनानको धरहराजस्तै छ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिम्रो शिर कर्मेल पर्वतजस्तै मुकुट पहिरिएको देखिन्छ।","poem":1},{"text":"तिम्रो कपाल हातले बुनेका राजकीय वस्त्रसमान छ;","poem":2},{"lineBreak":true},{"text":"त्यसका चुल्ठाले राजालाई मोहित पारेको छ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"हे प्रिय, आनन्दले पूर्ण,","poem":1},{"text":"र मनलाई खुशी पार्ने तिमी बिछट्टै राम्री छ्यौ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिम्रो शारीरिक कद खजूरको रूखझैँ छ,","poem":1},{"text":"र तिम्रा स्तनहरू फलका झुप्पाहरूजस्ता छन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मैले भनेँ, “म खजूरको रूखमा चढ्नेछु;","poem":1},{"text":"म त्यसका फल समात्नेछु।”","poem":2},{"text":"तिम्रा स्तनहरू अङ्‌गुरका झुप्पाहरूजस्तै होऊन्,","poem":1},{"text":"तिम्रो सासको बास्‍ना स्याउका बास्‍नाझैँ,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"र तिम्रो मुख उत्तम दाखमद्यझैँ मगमगाऊन्।","poem":2},"प्रेमिका",{"text":"ओठ र दाँतबाट सलल बग्दै","poem":1},{"text":"दाखमद्य सीधै मेरा प्रेमीकहाँ पुगोस्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"म मेरा प्रियकी हुँ,","poem":1},{"text":"र उहाँले मेरो तिर्सना गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हे मेरा प्रिय, आउनुहोस्! हामी खेतबारीतिर जाऔँ;","poem":1},{"text":"गाउँहरूमा","poem":2},{"noteId":8},{"text":"हामी रात बिताऔँ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"दाखमा कोपिला लाग्यो कि,","poem":1},{"text":"तिनमा फूल फुल्यो कि,","poem":2},{"text":"अनारहरूमा फूल फुल्यो कि,","poem":1},{"text":"भनेर हेर्न हामी बिहानै दाखबारीमा जाऔँ—","poem":2},{"lineBreak":true},{"text":"त्यहाँ म तपाईंलाई मेरो प्रेम प्रकट गर्नेछु।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"दूधेफलले बास्‍ना दिँदैछ,","poem":1},{"text":"मैले तपाईंको निम्ति जम्मा गरेका हरेक स्वादिष्‍ठ,","poem":2},{"text":"नयाँ र पुराना फलहरू,","poem":1},{"text":"हाम्रा ढोकामा तयार छन्, हे मेरा प्रिय।","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":8,"caller":"+","text":"अथवा मेहदीका झ्याङहरू","reference":{"chapter":7,"verse":11}}]},"thisChapterLink":"/api/npi_ncb/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}