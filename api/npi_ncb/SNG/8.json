{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"SNG","translationId":"npi_ncb","name":"श्रेष्‍ठगीत","commonName":"श्रेष्‍ठगीत","title":"श्रेष्‍ठगीतको पुस्तक","order":22,"numberOfChapters":8,"sha256":"972ee552f10f5b70747640b680dcf6846680458938fa742cf8d89750e0a8d549","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/npi_ncb/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"यदि तपाईं मेरी आमाको दूध खाएर हुर्केको,","poem":1},{"text":"मेरा दाजुभाइझैँ हुनुहुँदो हो त!","poem":2},{"text":"तपाईंलाई बाहिर भेट्दा","poem":1},{"text":"म म्वाइँ खानेथिएँ,","poem":2},{"lineBreak":true},{"text":"र कसैले मेरो निन्दा गर्ने थिएन।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तपाईंलाई डोर्‍याएर","poem":1},{"text":"म मेरी आमाको घरमा ल्याउनेथिएँ—","poem":2},{"lineBreak":true},{"text":"जुन आमाले मलाई शिक्षा दिएकी छन्।","poem":2},{"text":"म तपाईंलाई मसाला मिसाएको दाखमद्य,","poem":1},{"text":"मेरा अनारका रस पिउन दिनेथिएँ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उहाँको देब्रे हात मेरो शिरमुनि छ,","poem":1},{"text":"र दाहिने हातले मलाई अँगालो हाल्नुभएको छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हे यरूशलेमका छोरीहरू हो, म तिमीहरूलाई शपथ खुवाएर आज्ञा गर्छु:","poem":1},{"text":"उचित समय नभएसम्म","poem":2},{"lineBreak":true},{"text":"प्रेमलाई नजगाओ अथवा नबिउँझाओ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"आफ्ना प्रेमीसित अडेसिएर","poem":1},{"text":"उजाडस्थानबाट आउँदैगरेका यिनी को हुन्?","poem":2},"प्रेमिका",{"text":"स्याउको रूखमुनि मैले तपाईंलाई जगाएँ;","poem":1},{"text":"त्यहीँ तपाईंकी आमाले तपाईंलाई गर्भधारण गरेकी थिइन्;","poem":2},{"lineBreak":true},{"text":"त्यहीँ नै तिनले सुत्केरी व्यथा लागेर तपाईंलाई जन्म दिएकी थिइन्।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मलाई तपाईंका हृदयमा छापझैँ राख्नुहोस्,","poem":1},{"text":"तपाईंका पाखुरामा छापझैँ लगाउनुहोस्;","poem":2},{"text":"किनकि प्रेम मृत्युसमान प्रबल हुँदछ;","poem":1},{"text":"यसको तिर्सना चिहानझैँ कठोर हुन्छ।","poem":2},{"text":"यो दन्कने आगोसमान दन्कन्छ,","poem":1},{"text":"यो शक्तिशाली ज्वाला","poem":2},{"noteId":9},{"text":"जस्तै हुन्छ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उर्लेको पानीले पनि प्रेमलाई निभाउन सक्दैन;","poem":1},{"text":"नदीले पनि त्यसलाई बगाउन सक्दैन।","poem":2},{"text":"यदि मानिसले प्रेमको निम्ति","poem":1},{"text":"आफ्नो घरको सारा धनसम्पत्ति दिइहाले तापनि","poem":2},{"lineBreak":true},{"text":"यो","poem":2},{"noteId":10},{"text":"पूर्ण अवहेलना हुनेछ।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हाम्री एउटी जवान बहिनी छिन्,","poem":1},{"text":"जसका छाती उठेका छैनन्।","poem":2},{"text":"उनको विवाहको लागि कोही माग्न आएको दिनमा,","poem":1},{"text":"आफ्नी बहिनीको लागि हामी के गरौँ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यदि ऊ पर्खाल भए त,","poem":1},{"text":"हामी ऊमाथि चाँदीका बुर्जा बनाउने थियौँ।","poem":2},{"text":"यदि ऊ ढोका हुँदो हो त,","poem":1},{"text":"हामी देवदारुका फल्याकले बारेर बन्द गर्ने थियौँ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"म एक पर्खाल हुँ,","poem":1},{"text":"र मेरा स्तनहरू धरहराहरूजस्तै छन्।","poem":2},{"text":"यसरी उहाँका नजरमा म","poem":1},{"text":"सन्तुष्‍टि तुल्याउने ठहरिएकी छु।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"बाल-हामोनमा सोलोमनको एउटा दाखबारी थियो;","poem":1},{"text":"आफ्नो दाखबारी मोहीहरूलाई दिए।","poem":2},{"text":"हरेकले दाखबारीका फलको सट्टामा","poem":1},{"text":"हजार सेकेल","poem":2},{"noteId":11},{"text":"चाँदी ल्याउनुपर्थ्यो।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तर मेरो दाखबारी, जो मेरै अधिकार हो;","poem":1},{"text":"हे सोलोमन, ती हजार सेकेल तपाईंकै निम्ति हुन्,","poem":2},{"lineBreak":true},{"text":"र दुई सय ती फलफूल रेखदेख गर्नेहरूका निम्ति हुन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तिमी, जो दाखबारीमा","poem":1},{"text":"आफ्ना मित्रहरूका साथमा बास गर्दछौ,","poem":2},{"lineBreak":true},{"text":"तिम्रो सोरलाई सुन्‍न देऊ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"हे मेरा प्रेमी, बाहिर आउनुहोस्,","poem":1},{"text":"र सुगन्धित मसलाले भरिएका पर्वतहरूमा","poem":2},{"text":"हुने हरिणजस्तै अथवा","poem":1},{"text":"जवान मृगजस्तै हुनुहोस्!","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"अथवा याहवेको ज्वालाजस्तै","reference":{"chapter":8,"verse":6}},{"noteId":10,"caller":"+","text":"अथवा उसको","reference":{"chapter":8,"verse":7}},{"noteId":11,"caller":"+","text":"लगभग 12 किलो","reference":{"chapter":8,"verse":11}}]},"thisChapterLink":"/api/npi_ncb/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}