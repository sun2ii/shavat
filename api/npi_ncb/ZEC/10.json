{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ZEC","translationId":"npi_ncb","name":"जकरिया","commonName":"जकरिया","title":"जकरियाको भविष्यवाणी","order":38,"numberOfChapters":14,"sha256":"f719ad9103e3bf55b7536217a390be9e552d2941f185863b1fb1c4170710a138","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["याहवेहले यहूदाको वास्ता गर्नुहुनेछ"]},{"type":"verse","number":1,"content":[{"text":"वसन्त ऋतुको समयमा याहवेहसित झरी माग;","poem":1},{"text":"याहवेह नै हुनुहुन्छ, जसले आँधीबेहरीलाई पठाउनुहुन्छ।","poem":2},{"text":"उहाँले नै सबै मानिसहरूका लागि वर्षाको झरी बर्साइदिनुहुन्छ;","poem":1},{"text":"अनि सबैका लागि खेतमा बोटबिरुवाहरू उमारीदिनुहुन्छ।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मूर्तिहरूले छलका कुरा गर्छन्,","poem":1},{"text":"जोखना हेर्नेहरूले झूटो दर्शन देख्छन्;","poem":2},{"text":"तिनीहरूले झूटो सपना भन्छन्,","poem":1},{"text":"तिनीहरूले व्यर्थमा सान्त्वना दिन्छन्।","poem":2},{"text":"यसैकारण गोठालाको कमीले गर्दा","poem":1},{"text":"मानिसहरू अत्याचारमा परेका भेडाझैँ बरालिन्छन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“गोठालाहरूको विरुद्धमा मेरो रिस दन्कन्छ;","poem":1},{"text":"अनि म अगुवाहरूलाई दण्ड दिनेछु;","poem":2},{"text":"किनकि सेनाहरूका याहवेहले","poem":1},{"text":"आफ्नो बगाल यहूदाको घरानालाई हेरचाह गर्नुहुनेछ;","poem":2},{"lineBreak":true},{"text":"अनि तिनीहरूलाई लडाइँका जङ्गी घोडासमान तुल्याउनुहुनेछ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"यहूदाको कुलबाट कुनेढुङ्गा आउनेछ;","poem":1},{"text":"तिनीबाट पालको खाँबो,","poem":2},{"text":"लडाइँको धनु,","poem":1},{"text":"र हरेक शासक आउनेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिनीहरूले लडाइँका पराक्रमी योद्धाहरूझैँ","poem":1},{"text":"तिनीहरूका शत्रुहरूलाई सडकका हिलोमा कुल्चनेछन्।","poem":2},{"text":"तिनीहरूले लडाइँ गर्नेछन्; किनकि याहवेह तिनीहरूसँग हुनुहुन्छ;","poem":1},{"text":"अनि शत्रुहरूका घोडसवारहरूलाई शर्ममा पर्नेछन्।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“म यहूदाको घरानालाई शक्तिशाली बनाउनेछु,","poem":1},{"text":"र योसेफको घरानालाई बचाउनेछु।","poem":2},{"text":"म तिनीहरूलाई पुनर्स्थापित गर्नेछु;","poem":1},{"text":"किनकि मलाई तिनीहरूप्रति दया भएको कारण","poem":2},{"text":"तिनीहरू यस्ता हुनेछन्, मानौ","poem":1},{"text":"मैले तिनीहरूलाई कहिल्यै त्यागेकै थिइनँ;","poem":2},{"text":"किनकि म याहवेह तिनीहरूका परमेश्‍वर हुँ;","poem":1},{"text":"अनि म तिनीहरूलाई जवाफ दिनेछु।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"एफ्राएमीहरू शक्तिशाली योद्धाहरूझैँ हुनेछन्;","poem":1},{"text":"अनि तिनीहरूका हृदय मद्य पिएर आनन्दित भएझैँ हुनेछन्।","poem":2},{"text":"तिनीहरूका सन्तानले पनि त्यो देख्नेछन् र आनन्दित हुनेछन्;","poem":1},{"text":"तिनीहरूका हृदय याहवेहमा रमाउनेछन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"म तिनीहरूलाई इशारा गर्नेछु,","poem":1},{"text":"र तिनीहरूलाई भित्र भेला गर्नेछु।","poem":2},{"text":"निश्‍चय नै म तिनीहरूलाई छुटाउनेछु;","poem":1},{"text":"तिनीहरू पहिलेको जस्तै संख्यामा धेरै हुनेछन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मैले तिनीहरूलाई मानिसहरूको बीचमा तितरबितर पारे तापनि","poem":1},{"text":"तिनीहरूले मलाई टाढा देशहरूमा सम्झना गर्नेछन्।","poem":2},{"text":"तिनीहरू र तिनीहरूका सन्तानहरू जीवित रहनेछन्;","poem":1},{"text":"अनि तिनीहरू फर्कनेछन्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"म तिनीहरूलाई इजिप्टबाट फर्काइल्याउनेछु,","poem":1},{"text":"र तिनीहरूलाई अश्शूरबाट जम्मा गर्नेछु।","poem":2},{"text":"म तिनीहरूलाई गिलाद र लेबनानमा ल्याउनेछु;","poem":1},{"text":"अनि ती ठाउँहरूमा समेत तिनीहरू अटाउनेछैनन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तिनीहरू कष्‍टको सागरबाट पार भएर जाँदा,","poem":1},{"text":"छाल उर्लेको सागरलाई शान्त गराइनेछ;","poem":2},{"lineBreak":true},{"text":"अनि नील नदीका सबै गहिराइहरू सुकिजानेछन्।","poem":2},{"text":"अश्शूरको अहङ्कार चकनाचुर पारिनेछ,","poem":1},{"text":"र इजिप्टले आफ्नो राजदण्ड गुमाउनेछ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"म तिनीहरूलाई याहवेहमा शक्तिशाली बनाउनेछु;","poem":1},{"text":"अनि उहाँकै नाममा तिनीहरू सुरक्षित रहनेछन्,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}