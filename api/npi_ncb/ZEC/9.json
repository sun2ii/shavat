{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ZEC","translationId":"npi_ncb","name":"जकरिया","commonName":"जकरिया","title":"जकरियाको भविष्यवाणी","order":38,"numberOfChapters":14,"sha256":"f719ad9103e3bf55b7536217a390be9e552d2941f185863b1fb1c4170710a138","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/npi_ncb/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["इस्राएलका शत्रुहरूमाथि दण्ड"]},{"type":"verse","number":1,"content":["एक अगमवाणी:",{"text":"याहवेहको वचन हद्राक सहरको विरुद्धमा छ,","poem":1},{"text":"र उहाँ दमस्कसमा आएर विश्राम गर्नुहुनेछ;","poem":2},{"text":"किनकि सबै मानिसहरू र इस्राएलका सबै कुलहरूका","poem":1},{"text":"आँखा याहवेहमाथि नै छन्;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"अनि उहाँको दृष्‍टि हमातमाथि पनि छ, जो त्यसको सिमानामा छ;","poem":1},{"text":"अनि टायर र सीदोनमाथि छ, तथापि तिनीहरू अति धेरै दक्ष छन्।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"टायरले आफ्नो लागि एउटा बलियो किल्‍ला बनाएको छ;","poem":1},{"text":"त्यसले चाँदी धुलोझैँ,","poem":2},{"lineBreak":true},{"text":"र सुन सडकको फोहोरझैँ थुपारेको छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तर प्रभुले त्यसको सम्पत्ति खोस्‍नुहुनेछ,","poem":1},{"text":"र त्यसको शक्तिलाई समुद्रमा नाश पारिदिनुहुनेछ;","poem":2},{"lineBreak":true},{"text":"अनि त्यो आगोद्वारा भस्म हुनेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"अश्कलोनले त्यो देख्नेछ र डराउनेछ;","poem":1},{"text":"गाजा सहर कष्‍टले छटपटाउनेछ;","poem":2},{"lineBreak":true},{"text":"अनि एक्रोन सहर पनि त्यसको आशा हराउनेछ,","poem":2},{"text":"र गाजा सहरले आफ्नो राजा गुमाउनेछ;","poem":1},{"text":"अनि अश्कलोन उजाड हुनेछ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"विदेशीहरूले अश्दोदलाई कब्जा गर्नेछन्;","poem":1},{"text":"अनि म पलिश्तीहरूको घमण्डलाई नष्‍ट गरिदिनेछु।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म तिनीहरूका मुखबाट रगत","poem":1},{"text":"र तिनीहरूका दाँतका बीचबाट घृणित कुरा खोस्‍नेछु।","poem":2},{"text":"तिनीहरूबाट बचेका जतिचाहिँ हाम्रा परमेश्‍वरका हुनेछन्,","poem":1},{"text":"र तिनीहरू यहूदाको वंशजस्तै हुनेछन्;","poem":2},{"lineBreak":true},{"text":"एक्रोनचाहिँ यबूसीहरूजस्ता हुनेछन्।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तर म मेरो भवनलाई आक्रमणकारीबाट","poem":1},{"text":"रक्षा गर्न चारैतिर छाउनी बनाउनेछु।","poem":2},{"text":"कुनै पनि अत्याचारीले मेरा मानिसहरूलाई फेरि कहिल्यै जित्नेछैन;","poem":1},{"text":"किनकि अहिले मैले निगरानी गरिरहेको छु।","poem":2}]},{"type":"heading","content":["सियोनका राजाको आगमन"]},{"type":"verse","number":9,"content":[{"text":"हे सियोनकी छोरी, खूब आनन्द गर्!","poem":1},{"text":"यरूशलेमकी छोरी, चर्को सोरमा करा!","poem":2},{"text":"हेर्, तेरो राजा तँकहाँ आउँदैहुनुहुन्छ;","poem":1},{"text":"उहाँ धार्मिक र विजयी हुनुहुन्छ;","poem":2},{"text":"नम्र र गधामाथि सवार हुनुभएर आउनुहुन्छ;","poem":1},{"text":"गधाको एउटा बछेडामाथि सवार भएर आउँदैहुनुहुन्छ।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"म एफ्राइमबाट लडाइँका रथहरू","poem":1},{"text":"र यरूशलेमबाट युद्धका घोडाहरू नष्‍ट गर्नेछु;","poem":2},{"lineBreak":true},{"text":"अनि युद्धको धनु भाँचिनेछ।","poem":2},{"text":"उहाँले राष्ट्रहरूलाई शान्ति घोषणा गर्नुहुनेछ।","poem":1},{"text":"उहाँको राज्य शासन एउटा समुद्रदेखि अर्को समुद्रसम्म","poem":2},{"lineBreak":true},{"text":"र यूफ्रेटिस नदीदेखि पृथ्वीको अन्तसम्म नै फैलिनेछ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तेरो विषयमा चाहिँ तँसँग भएको मेरो रगतको करारको कारण,","poem":1},{"text":"म तेरा कैदीहरूलाई पानीविनाको खाडलबाट मुक्त गरिदिनेछु।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"हे आशावादी कैदीहरू, तिमीहरू आफ्ना बलियो किल्‍लातिर फर्क;","poem":1},{"text":"अहिले पनि म घोषणा गर्छु, कि म तिमीहरूलाई दोबर गरी पुनर्स्थापित गर्नेछु।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"म यहूदालाई मेरो धनु दोबारेझैँ दोबार्नेछु,","poem":1},{"text":"र त्यसलाई एफ्राइमले भरिदिनेछु।","poem":2},{"text":"हे सियोन, म तेरा छोराहरूलाई,","poem":1},{"text":"ग्रीसका छोराहरूको विरुद्धमा सुर्‍याउनेछु;","poem":2},{"lineBreak":true},{"text":"अनि सियोनलाई एउटा योद्धाको तरवारझैँ बनाउनेछु।","poem":2}]},{"type":"heading","content":["याहवेह देखा पर्नुहुनेछ"]},{"type":"verse","number":14,"content":[{"text":"त्यसपछि याहवेह तिनीहरूमाथि देखा पर्नुहुनेछ;","poem":1},{"text":"उहाँको वाण बिजुलीझैँ चम्कनेछ।","poem":2},{"text":"सर्वशक्तिमान् याहवेहले तुरही फुक्नुहुनेछ;","poem":1},{"text":"उहाँ दक्षिणका आँधीहरूमा आउनुहुनेछ;","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"अनि सेनाहरूका याहवेहले तिनीहरूलाई रक्षा गर्नुहुनेछ।","poem":2},{"text":"तिनीहरूले नाश गर्नेछन्,","poem":1},{"text":"र घुयेँत्रोका ढुङ्गाहरूले परास्त गर्नेछन्।","poem":2},{"text":"तिनीहरूले पिउनेछन् र मद्य पिएझैँ गर्जनेछन्;","poem":1},{"text":"तिनीहरू वेदीका कुनाहरूमा राखिएका","poem":2},{"lineBreak":true},{"text":"ठूला-ठूला छर्कने कचौराजस्तै भरिनेछन्।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"त्यस दिन याहवेह तिनीहरूका परमेश्‍वरले","poem":1},{"text":"गोठालोले आफ्ना बगाललाई बचाएझैँ बचाउनुहुनेछ।","poem":2},{"text":"उहाँको देशमा तिनीहरू","poem":1},{"text":"मुकुटका चम्किला रत्नझैँ चम्कनेछन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तिनीहरू अति आकर्षित र सुन्दर हुनेछन्!","poem":1},{"text":"जवान मानिसहरू अन्‍नले हृष्‍टपुष्‍ट हुनेछन्,","poem":2},{"lineBreak":true},{"text":"र जवान स्त्रीहरूचाहिँ नयाँ दाखमद्यले आनन्दित हुनेछन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}