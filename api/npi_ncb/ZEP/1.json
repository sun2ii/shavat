{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ZEP","translationId":"npi_ncb","name":"सपन्याह","commonName":"सपन्याह","title":"सपन्याहको भविष्यवाणी","order":36,"numberOfChapters":3,"sha256":"0c780a17a6e51b06e4337e54ccbe913b1f30b52050d0e264f17e2a55d33cc3d8","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/npi_ncb/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["आमोनका छोरा यहूदाका राजा योशियाहको शासनकालमा राजा हिजकियाका खनाति, अमर्याहका पनाति, गदल्याहका नाति, कूशीका छोरा सपन्याहकहाँ आएको याहवेहको वचन यही हो:"]},{"type":"line_break"},{"type":"heading","content":["याहवेहको दिनमा सारा पृथ्वीको न्याय"]},{"type":"verse","number":2,"content":[{"text":"“म पृथ्वीको सतहबाट","poem":1},{"text":"सबै थोक नाश गर्नेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“म मानिस र पशुप्राणी दुवैलाई नाश गर्नेछु;","poem":1},{"text":"म आकाशका पक्षीहरू","poem":2},{"lineBreak":true},{"text":"र समुद्रका माछाहरूलाई नाश गर्नेछु।","poem":2},{"lineBreak":true},{"text":"दुष्‍टलाई ठेस लगाउने ती मूर्तिहरूलाई पनि नाश गर्नेछु।”","poem":2},{"noteId":0},{"lineBreak":true},{"text":"“अनि म सबै मानव-जातिलाई","poem":1},{"text":"पृथ्वीको सतहबाट मेटिदिनेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा गर्नुहुन्छ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“म यहूदाको विरुद्धमा","poem":1},{"text":"र यरूशलेममा बास गर्ने सबै मानिसहरूका विरुद्धमा मेरो हात पसार्नेछु।","poem":2},{"text":"यस ठाउँमा बाल-देवताको पूजा गर्न बचेका हरेकलाई,","poem":1},{"text":"र त्यसका मूर्तिपूजक पुजारीहरूका नामनिशानै मेटिदिनेछु;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तिनीहरूलाई, जसले आफ्ना घरका छानामाथि","poem":1},{"text":"आकाशका तारामण्डललाई दण्डवत् गर्दै पूजा गर्नेहरू,","poem":2},{"text":"दण्डवत् गर्ने र याहवेहको नाममा शपथ खानेहरू","poem":1},{"text":"र मोलेख","poem":2},{"noteId":1},{"text":"देवताको नाममा पनि शपथ खानेहरू,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"याहवेहबाट पछि फर्केर तर्किएर जानेहरू;","poem":1},{"text":"अनि याहवेहको खोजी नगर्नेहरू,","poem":2},{"lineBreak":true},{"text":"र उहाँको बारेमा सोधपुछ नगर्नेहरूलाई समेत म नाश गरिदिनेछु।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"प्रभु याहवेहको सामु चुपचाप बस;","poem":1},{"text":"किनकि याहवेहको दिन नजिकै छ।","poem":2},{"text":"याहवेहले एउटा बलिदान तयार पार्नुभएको छ;","poem":1},{"text":"अनि उहाँले निमन्त्रणा गर्नुभएकाहरूलाई पवित्र पार्नुभएको छ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“याहवेहको बलिदानको दिन,","poem":1},{"text":"म अगुवाहरू","poem":2},{"lineBreak":true},{"text":"र राजाका छोराहरू;","poem":2},{"text":"अनि विदेशी कपडा लगाउनेहरू","poem":1},{"text":"सबैलाई दण्ड दिनेछु।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यस दिन सँघारमाथि पाइला टेक्न इन्कार गर्नेहरू,","poem":1},{"text":"आफ्ना देवताहरूका मन्दिरलाई हिंसा","poem":2},{"text":"र छलले भर्नेहरू सबैलाई","poem":1},{"text":"म दण्ड दिनेछु।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“त्यस दिन”","poem":1},{"text":"याहवेह भन्‍नुहुन्छ,","poem":2},{"text":"“माछा मूलढोकाबाट रुवाबासी सुनिनेछ;","poem":1},{"text":"सहरका नयाँ टोलबाट विलाप","poem":2},{"lineBreak":true},{"text":"र डाँडाहरूबाट ठूलो आवाज सुनिनेछ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तिमी बजारमा बास बस्‍नेहरू, विलाप गर;","poem":1},{"text":"तिम्रा सारा व्यापारीहरूको नामनिशानै मेटिनेछन्,","poem":2},{"lineBreak":true},{"text":"चाँदीका व्यापार गर्नेहरू सबै नाश हुनेछन्।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्यस बेला म यरूशलेमलाई बत्ती बालेर खोज्नेछु,","poem":1},{"text":"र आफैँमा ढुक्‍क भएर बस्‍नेहरू,","poem":2},{"lineBreak":true},{"text":"जो मद्यका थिग्राजस्तै छन्,","poem":2},{"text":"जसले, ‘याहवेहले न असल, न त खराब नै","poem":1},{"text":"गर्नुहुन्छ’ भन्‍नेहरूलाई दण्ड दिनेछु।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तिनीहरूका धनसम्पत्तिहरू लुटिनेछन्,","poem":1},{"text":"तिनीहरूका घरहरू भत्काइनेछन्।","poem":2},{"text":"तिनीहरूले घर बनाउनेछन्,","poem":1},{"text":"तर त्यसमा तिनीहरू बस्‍न पाउनेछैनन्;","poem":2},{"text":"तिनीहरूले दाखबारी लगाउनेछन्,","poem":1},{"text":"तर तिनीहरूले दाखमद्य पिउन पाउनेछैनन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"याहवेहको महान् दिन नजिकै छ—","poem":1},{"text":"त्यो नजिकै छ, र अब त्यो चाँडै आउँदैछ।","poem":2},{"text":"याहवेहको त्यो दिनको रुवाइ-कराइ अत्यन्तै तितो हुनेछ;","poem":1},{"text":"त्यो दिन वीर योद्धा पनि आफ्नो युद्धको निम्ति चिच्याउँदै रुनेछन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"त्यो दिन क्रोधको दिन हुनेछ—","poem":1},{"text":"सङ्कष्‍ट र वेदनाको दिन,","poem":2},{"text":"कष्‍ट र सर्वनाशको दिन,","poem":3},{"text":"अन्धकार र निराशाको दिन,","poem":2},{"text":"बादल र घोर अन्धकारको दिन।","poem":3}]},{"type":"verse","number":16,"content":[{"text":"सुरक्षित किल्‍ला भएका सहरहरूका विरुद्धमा","poem":2},{"text":"र कुनाहरूमा रहेका धरहराहरूको विरुद्धमा","poem":1},{"text":"तुरही र लडाइँको आवाज सुनिने दिन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“म सबै मानिसहरूमाथि यस्तो सङ्कष्‍ट ल्याउनेछु,","poem":1},{"text":"कि तिनीहरू अन्धा मानिसहरूजस्तै छामछाम-छुमछुम गर्नेछन्;","poem":2},{"lineBreak":true},{"text":"किनकि तिनीहरूले याहवेहको विरुद्धमा पाप गरेका छन्।","poem":2},{"text":"तिनीहरूको रगत धुलोझैँ","poem":1},{"text":"र तिनीहरूका आन्द्राभुँडी गोबरझैँ फ्याँकिनेछन्।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तिनीहरूलाई याहवेहको क्रोधको दिनमा,","poem":1},{"text":"न त तिनीहरूका सुनले,","poem":2},{"lineBreak":true},{"text":"न त तिनीहरूका चाँदीले तिनीहरूलाई बचाउनसक्नेछ।”","poem":2},{"lineBreak":true},{"text":"उहाँको डाहको आगोमा","poem":1},{"text":"सारा संसार भस्म पारिनेछ;","poem":2},{"text":"किनकि यस पृथ्वीमा बसोबास गर्ने","poem":1},{"text":"सबैलाई उहाँले अचानक अन्त्य गर्नुहुनेछ।","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"मूल भाषामा यो पङ्‌क्तिको अर्थ निश्‍चित छैन।","reference":{"chapter":1,"verse":3}},{"noteId":1,"caller":"+","text":"मोलेख जसको अर्को नाम हो मल्काम","reference":{"chapter":1,"verse":5}}]},"thisChapterLink":"/api/npi_ncb/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}