{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ZEP","translationId":"npi_ncb","name":"सपन्याह","commonName":"सपन्याह","title":"सपन्याहको भविष्यवाणी","order":36,"numberOfChapters":3,"sha256":"0c780a17a6e51b06e4337e54ccbe913b1f30b52050d0e264f17e2a55d33cc3d8","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/npi_ncb/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["यहूदा र यरूशलेमको पनि अरू राष्ट्रहरूसँगै न्याय गरिएको"]},{"type":"heading","content":["यहूदालाई पश्‍चात्ताप गर्नलाई बोलाइयो"]},{"type":"verse","number":1,"content":[{"text":"ए लाज नभएको राष्ट्र,","poem":1},{"text":"एकसाथ जम्मा होओ! आफूलाई एकसाथ भेला गराओ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जारी गरिएको उर्दी जारी हुनुभन्दा अगि,","poem":1},{"text":"र त्यो दिन हावाले उडाएको भुसझैँ बितेर जानुभन्दा अगि,","poem":2},{"text":"याहवेहको भयङ्कर क्रोध","poem":1},{"text":"तिमीहरूमाथि आउनुभन्दा अगि,","poem":2},{"text":"र याहवेहको क्रोधको दिन","poem":1},{"text":"तिमीहरूमाथि आइपर्नुभन्दा अगि नै।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हे देशका सबै नम्रहरू हो, जसले उहाँका आज्ञाहरू पालन गर्दछौ,","poem":1},{"text":"तिमीहरूले याहवेहको खोजी गर।","poem":2},{"text":"धार्मिकता र नम्रताको खोजी गर;","poem":1},{"text":"सायद याहवेहको क्रोधको दिनमा","poem":2},{"lineBreak":true},{"text":"तिमीहरूले शरण पाउनेछौ।","poem":2}]},{"type":"heading","content":["पलिश्ती"]},{"type":"verse","number":4,"content":[{"text":"गाजालाई त्यागिनेछ,","poem":1},{"text":"र अश्कलोनलाई उजाड पारिनेछ।","poem":2},{"text":"मध्यदिनमा अश्दोदलाई खाली पारिनेछ","poem":1},{"text":"र एक्रोनचाहिँ जरैदेखि उखेलिनेछ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"समुद्रका छेउमा बसोबास गर्ने,","poem":1},{"text":"हे करेतीहरू हो, तिमीहरूलाई धिक्‍कार छ;","poem":2},{"text":"हे पलिश्तीहरूको देश, कनान,","poem":1},{"text":"याहवेहका यी वचन तिमीहरूका विरुद्ध छ,","poem":2},{"text":"उहाँले भन्‍नुहुन्छ, “म तँलाई नाश पार्नेछु,","poem":1},{"text":"कोही पनि जीवित छोडिनेछैन।”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"समुद्री किनारको देशचाहिँ खर्क हुनेछ,","poem":1},{"text":"जहाँ गोठालाहरूका निम्ति इनार हुनेछ","poem":2},{"lineBreak":true},{"text":"र भेडाहरूका निम्ति गोठ हुनेछ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्यो समुद्री किनारको भूमि","poem":1},{"text":"यहूदाका बाँकी रहेकाहरूका निम्ति हुनेछ;","poem":2},{"lineBreak":true},{"text":"त्यहाँ तिनीहरूले हरियो खर्क भेट्टाउनेछन्।","poem":2},{"text":"राति तिनीहरू अश्कलोनका","poem":1},{"text":"घरहरूमा सुत्नेछन्।","poem":2},{"text":"याहवेह, तिनीहरूका परमेश्‍वरले तिनीहरूको हेरचाह गर्नुहुनेछ;","poem":1},{"text":"उहाँले तिनीहरूका सुदिन फर्काएर ल्याउनुहुनेछ।","poem":2}]},{"type":"heading","content":["मोआब र अम्मोन"]},{"type":"verse","number":8,"content":[{"text":"“मैले मोआबले गरेको अपमान","poem":1},{"text":"र अम्मोनीहरूले गरेको निन्दा सुनेको छु,","poem":2},{"text":"जसले मेरा मानिसहरूलाई अपमान गरेका छन्,","poem":1},{"text":"र तिनीहरूको देशको विरुद्धमा धम्की दिएका छन्।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यसकारण म जीवित भएझैँ,”","poem":1},{"text":"सेनाहरूका याहवेह,","poem":2},{"lineBreak":true},{"text":"इस्राएलका परमेश्‍वर घोषणा गर्नुहुन्छ,","poem":2},{"text":"“निश्‍चय नै मोआब सदोमजस्तै र","poem":1},{"text":"अम्मोनीहरू गमोराजस्तै हुनेछन्;","poem":2},{"text":"सामा र नुनका खाडलैखाडल भएको ठाउँ,","poem":1},{"text":"र सधैँका निम्ति रुखो जमिन हुनेछन्।","poem":2},{"text":"मेरा बाँकी रहेका मानिसहरूले तिनीहरूलाई लुट्नेछन्;","poem":1},{"text":"मेरा राष्ट्रमा जीवित रहेकाहरूले तिनीहरूको देश अधिकार गर्नेछन्।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"तिनीहरूको घमण्ड र सेनाहरूका याहवेहका","poem":1},{"text":"मानिसहरूलाई गरेको अपमान र खिसीको सट्टामा","poem":2},{"lineBreak":true},{"text":"तिनीहरूले यही कुरा फिर्ता पाउनेछन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेह तिनीहरूका निम्ति डरलाग्दो हुनुहुनेछ,","poem":1},{"text":"जब उहाँले पृथ्वीका सबै देवताहरूलाई नष्‍ट गर्नुहुन्छ।","poem":2},{"text":"उहाँलाई टाढाका राष्ट्रहरूले","poem":1},{"text":"आ-आफ्नो भूमिबाट दण्डवत् गर्नेछन्।","poem":2}]},{"type":"heading","content":["कूश"]},{"type":"verse","number":12,"content":[{"text":"“हे कूशका मानिसहरू हो,","poem":1},{"text":"तिमीहरू पनि मेरो तरवारले काटिनेछौ।”","poem":2}]},{"type":"heading","content":["अश्शूर"]},{"type":"verse","number":13,"content":[{"text":"उहाँले उत्तरको विरुद्धमा आफ्ना हात पसार्नुहुन्छ,","poem":1},{"text":"र अश्शूरलाई नाश गर्नुहुनेछ;","poem":2},{"text":"अनि निनवेलाई पूरै उजाड","poem":1},{"text":"र मरुभूमिझैँ सुक्खा पारेर छोडिदिनुहुनेछ।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"त्यहाँ सबै किसिमका जीवजन्तुका","poem":1},{"text":"बथान र बगालले आराम गर्नेछन्;","poem":2},{"text":"मरुभूमिको उल्‍लु र कराउने उल्‍लुहरूले","poem":1},{"text":"त्यसको रूखका प्वालहरूमा बसोबास गर्नेछन्।","poem":2},{"text":"झ्यालहरूबाट ती उल्‍लुहरूले कराएको आवाज प्रतिध्वनित हुनेछन्;","poem":1},{"text":"ढोकाहरू ढुङ्गाका थुप्राहरूले भरिनेछन्,","poem":2},{"lineBreak":true},{"text":"र देवदारुका चौकसहरू उदाङ्गिनेछन्।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"यो त्यही घमण्डी सहर हो,","poem":1},{"text":"जुन सुरक्षितसाथ निर्धक्‍क बस्दथ्यो।","poem":2},{"text":"त्यसले आफूलाई भनेकी थिई,","poem":1},{"text":"“म नै हुँ, र मबाहेक अरू कोही छैन!”","poem":2},{"text":"अहिले त्यसको कस्तो विनाश भएको छ!","poem":1},{"text":"त्यो जङ्गली जनावरहरूका निम्ति गुफा भएकी छ!","poem":2},{"text":"त्यहाँबाट भएर जानेहरू सबैले","poem":1},{"text":"त्यसलाई आफ्नो मुक्‍का देखाएर खिसी गर्नेछन्।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}