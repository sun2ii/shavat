{"translation":{"id":"npi_ncb","name":"Biblica® नेपाली समकालीन सर्वसुलभ संस्करण","website":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npioncb","licenseNotes":null,"shortName":"NCB","englishName":"Nepali Contemporary Bible","language":"npi","textDirection":"ltr","sha256":"a352d6ccca813b137c729f45377a0fda8005579568bfca078916ed230806f5ba","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ncb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"ZEP","translationId":"npi_ncb","name":"सपन्याह","commonName":"सपन्याह","title":"सपन्याहको भविष्यवाणी","order":36,"numberOfChapters":3,"sha256":"0c780a17a6e51b06e4337e54ccbe913b1f30b52050d0e264f17e2a55d33cc3d8","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ncb/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/npi_ncb/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["यरूशलेम"]},{"type":"verse","number":1,"content":[{"text":"धिक्‍कार छ, त्यस अत्याचारी सहरलाई,","poem":1},{"text":"जो विद्रोही र अशुद्ध छे!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"त्यसले कसैको कुरा पनि मानिन;","poem":1},{"text":"त्यसले अनुशासनलाई स्वीकार गर्दिन।","poem":2},{"text":"त्यसले याहवेहमाथि भरोसा राख्दिन;","poem":1},{"text":"अनि त्यो आफ्नो परमेश्‍वरको नजिकमा आउँदिन।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्यसका अधिकारीहरू","poem":1},{"text":"भोकाएका गर्जने सिंहहरूजस्ता छन्;","poem":2},{"text":"अनि त्यसका शासकहरूचाहिँ साँझका ब्वाँसाहरूजस्ता हुन्,","poem":1},{"text":"जसले बिहानको निम्ति हड्डीसम्म बाँकी राख्दैनन्।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यसका अगमवक्ताहरू झूटा र अहङ्कारी छन्;","poem":1},{"text":"तिनीहरू विश्‍वासघाती मानिसहरू हुन्।","poem":2},{"text":"त्यसका पुजारीहरूले पवित्रस्थानलाई अपवित्र पार्दछन्,","poem":1},{"text":"र परमेश्‍वरको नियमलाई तोड्दछन्।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"त्यसको बीचमा रहनुहुने याहवेह धर्मी हुनुहुन्छ;","poem":1},{"text":"उहाँले कहिल्यै खराबी गर्नुहुन्‍न।","poem":2},{"text":"बिहानैपिच्छे उहाँले आफ्नो न्याय प्रकट गर्नुहुन्छ;","poem":1},{"text":"अनि हरेक नयाँ दिन उहाँ चुक्नुहुन्‍न,","poem":2},{"lineBreak":true},{"text":"तर पनि अधर्मीले लज्जित हुन जान्दैन।","poem":2}]},{"type":"heading","content":["पश्‍चात्ताप नगरी रहने यरूशलेम"]},{"type":"verse","number":6,"content":[{"text":"“मैले राष्ट्रहरूलाई नाश गरेको छु;","poem":1},{"text":"तिनीहरूका बलिया किल्‍लाहरू ध्वस्त भएका छन्।","poem":2},{"text":"त्यस सहरबाट भएर कोही हिँड्दैन;","poem":1},{"text":"मैले तिनीहरूका सडकहरूलाई उजाड पारेको छु;","poem":2},{"text":"तिनीहरूका सहरहरू बिरानो भएका छन्;","poem":1},{"text":"ती उजाड र खाली भएका छन्।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मैले यरूशलेम सहरको बारेमा भनेँ,","poem":1},{"text":"‘निश्‍चय नै तैँले मेरो भय मान्‍नेछस्,","poem":2},{"lineBreak":true},{"text":"र मेरो सुधारको अनुशासन ग्रहण गर्नेछस्!’","poem":2},{"text":"तब त्यसको शरणस्थानलाई नाश पारिनेछैन,","poem":1},{"text":"न त मेरा सबै तोकिएका दण्डहरू त्यसमाथि पर्नेछन्।","poem":2},{"text":"तर तिनीहरू आफूले गर्ने सबै कामहरूमा","poem":1},{"text":"झन् भ्रष्‍टतापूर्वक उत्सुक थिए।”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"याहवेह घोषणा गर्नुहुन्छ, “साक्षी दिन म खडा हुनेछु,","poem":1},{"text":"यसकारण त्यस दिनसम्म तिमीहरू मलाई पर्खिरहो।","poem":2},{"text":"राष्ट्रहरूलाई एकसाथ भेला गर्न,","poem":1},{"text":"र राज्य राज्यलाई एक ठाउँमा जम्मा गर्न;","poem":2},{"text":"अनि मेरो क्रोधको आगो तिनीहरूमाथि खन्याउने निर्णय गरेको छु—","poem":1},{"text":"मेरो सबै बल्दो रिस तिनीहरूमाथि खन्याउने मैले निर्णय गरेको छु।","poem":2},{"text":"समस्त पृथ्वी मेरो डाहको","poem":1},{"text":"आगोले भस्म हुनेछ।","poem":2}]},{"type":"heading","content":["इस्राएलको अवशेषको पुनर्स्थापना"]},{"type":"verse","number":9,"content":[{"text":"“त्यसपछि म मानिसहरूका ओठ शुद्ध पार्नेछु,","poem":1},{"text":"ताकि तिनीहरू सबैले याहवेहका नामको पुकार गरून्,","poem":2},{"lineBreak":true},{"text":"र एउटै मनले उहाँको सेवा गरून्।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"कूश देशका नदीहरूभन्दा पारिबाट","poem":1},{"text":"मेरा छरपस्ट भएका मेरा आराधकहरूले","poem":2},{"lineBreak":true},{"text":"मेरा निम्ति भेटी ल्याउनेछन्।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यस दिन तिमीहरूले मेरो विरुद्धमा गरेका","poem":1},{"text":"सारा दुष्कर्मको निम्ति यरूशलेम शर्ममा पर्नेछैन;","poem":2},{"text":"किनकि म तिमीहरूको बीचबाट","poem":1},{"text":"धाक लगाउने अहङ्कारीहरूलाई निकाल्नेछु।","poem":2},{"text":"तिमीहरू फेरि कहिल्यै","poem":1},{"text":"मेरा पवित्र पहाडमा अहङ्कारी हुनेछैनौ।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तर म तेरो बीचमा","poem":1},{"text":"नम्र र दीनहरूलाई छोड्नेछु।","poem":2},{"text":"इस्राएलका बाँकी रहेकाहरूले","poem":1},{"text":"याहवेहको नाममा भरोसा गर्नेछन्।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"इस्राएलमा बाँचेकाहरूले कुनै पनि अधर्म गर्नेछैनन्;","poem":1},{"text":"तिनीहरूले कुनै झूटो बोल्नेछैनन्।","poem":2},{"text":"तिनीहरूका मुखमा","poem":1},{"text":"कुनै पनि छलका कुरा पाइनेछैन।","poem":2},{"text":"तिनीहरू खानेछन्, सुत्नेछन्","poem":1},{"text":"र कसैले पनि तिनीहरूलाई भयभीत पार्नेछैन।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"हे सियोनकी छोरी, गीत गा;","poem":1},{"text":"हे इस्राएल, उच्‍च सोरमा करा!","poem":2},{"text":"हे यरूशलेमकी छोरी,","poem":1},{"text":"आफ्नो सारा हृदयले आनन्दित हो, र रमाहट गर्!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"याहवेहले तेरो दण्ड हटाइदिनुभएको छ;","poem":1},{"text":"तेरा शत्रुहरूलाई फर्काइदिनुभएको छ।","poem":2},{"text":"याहवेह इस्राएलका राजा तँसित हुनुहुन्छ;","poem":1},{"text":"अब फेरि तैँले कुनै खराबीको डर मान्‍नुपर्दैन।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"त्यस दिन","poem":1},{"text":"तिनीहरूले यरूशलेमलाई भन्‍नेछन्,","poem":2},{"text":"“हे सियोन, नडरा;","poem":1},{"text":"तेरा हातहरू लुला हुन नपाऊन्।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"याहवेह, तेरा परमेश्‍वर तँसित हुनुहुन्छ;","poem":1},{"text":"तँलाई बचाउने सामर्थी योद्धा हुनुहुन्छ।","poem":2},{"text":"उहाँ तँसँग धेरै खुशी हुनुहुनेछ;","poem":1},{"text":"उहाँले तँलाई आफ्नो प्रेममा कहिल्यै हप्काउनुहुनेछैन,","poem":2},{"lineBreak":true},{"text":"तर तँप्रति प्रसन्‍न भएर उहाँले गीत गाउनुहुनेछ।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“जो तोकिएका चाडहरूमा सहभागी हुन नपाउँदा शोकित छन्,","poem":1},{"text":"जो तेरा निम्ति बोझ र बदनामी भएका छन्,","poem":2},{"lineBreak":true},{"text":"म तँबाट हटाइदिनेछु।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"त्यस बेला तँलाई अत्याचार गर्नेहरूसित","poem":1},{"text":"म बदला लिनेछु।","poem":2},{"text":"म लङ्गडाहरूलाई उद्धार गर्नेछु;","poem":1},{"text":"अनि निर्वासितहरूलाई जम्मा गर्नेछु।","poem":2},{"text":"तिनीहरू जुन-जुन देशमा शर्ममा परेका थिए,","poem":1},{"text":"म तिनीहरूलाई ती हरेक देशहरूमा प्रशंसा र सम्मान दिनेछु।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"त्यस बेला म तिमीहरूलाई जम्मा गर्नेछु;","poem":1},{"text":"म त्यस बेला तिमीहरूलाई घरमा ल्याउनेछु।","poem":2},{"text":"जब म तिमीहरूका सुदिन","poem":1},{"text":"तिमीहरूकै आँखाको अगाडि फर्काएर ल्याउनेछु,","poem":2},{"text":"तब म तिमीहरूलाई पृथ्वीका","poem":1},{"text":"समस्त जातिहरूका बीचमा प्रशंसा र सम्मान दिनेछु,”","poem":2},{"lineBreak":true},{"text":"याहवेह भन्‍नुहुन्छ।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/npi_ncb/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ncb/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ncb/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}