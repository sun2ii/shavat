{"translation":{"id":"npi_ulb","name":"पवित्र बाइबल","website":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseNotes":null,"shortName":"ULB","englishName":"Nepali Bible","language":"npi","textDirection":"ltr","sha256":"e85f83a4e9c862ba4acd255666e7eb82b700e149bbbdbbecaeeca9537d472708","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31109,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"JOB","translationId":"npi_ulb","name":"अय्यूब","commonName":"अय्यूब","title":"अय्यूबको पुस्तक","order":18,"numberOfChapters":42,"sha256":"42e346f3a988f760547384380fa78170d175a1cf2eb0d3ff65cac1169ce9ff93","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ulb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/npi_ulb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["तब बिल्दद शुहीले जवाफ दिए र यसो भने,"]},{"type":"verse","number":2,"content":["“प्रभुत्व र डर उहाँसित छन् । उहाँले स्वर्गमा भएका आफ्‍नो उच्‍च स्थानहरूमा शान्ति कायम गर्नुहुन्छ ।"]},{"type":"verse","number":3,"content":["के उहाँको फौजको गन्ति गर्न सकिन्छ र ? कसमाथि उहाँको ज्योति चम्कँदैन र ?"]},{"type":"verse","number":4,"content":["तब कसरी मानिस परमेश्‍वरसित धर्मी ठहरिन सक्छ त ? स्‍त्रीबाट जन्मेको मानिस कसरी उहाँको सामु शुद्ध, ग्रहणयोग्य हुन सक्छ ?"]},{"type":"verse","number":5,"content":["हेर्नुहोस्, उहाँलाई चन्द्रले पनि उज्यालो पार्न सक्‍दैन । उहाँको दृष्‍टिमा ताराहरू सिद्ध छैनन् ।"]},{"type":"verse","number":6,"content":["मानिस त झन् नगन्‍य हो, जो एउटा किरा हो— मानिसको पुत्र त, जो किरा एउटा हो !"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ulb/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ulb/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ulb/JOB/24.json","previousChapterAudioLinks":{},"numberO