{"translation":{"id":"npi_ulb","name":"पवित्र बाइबल","website":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseNotes":null,"shortName":"ULB","englishName":"Nepali Bible","language":"npi","textDirection":"ltr","sha256":"e85f83a4e9c862ba4acd255666e7eb82b700e149bbbdbbecaeeca9537d472708","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31109,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ulb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"5cbf29b2b4c9e2e78dd6edd19f9fa9f8bed11a5d532740584e37faf3b2ba7c45","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ulb/PSA/150.json","totalNumberOfVerses":2468},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":["परमप्रभुको प्रशंसा गर । हे परमप्रभुका सेवकहरू हो, उहाँको प्रशंसा गर । परमप्रभुको नाउँको प्रशंसा गर ।"]},{"type":"verse","number":2,"content":["परमप्रभुको नाउँ अहिले र सदासर्वदा धन्यको होस् ।"]},{"type":"verse","number":3,"content":["सूर्य उदायदेखि त्‍यो नअस्‍ताएसम्म नै, परमप्रभुको नाउँको प्रशंसा हुनुपर्छ ।"]},{"type":"verse","number":4,"content":["परमप्रभु सबै जातिभन्दा उच्‍च हुनुहुन्‍छ र उहाँको महिमा आकाशसम्‍म पुग्‍छ ।"]},{"type":"verse","number":5,"content":["परमप्रभु हाम्रा परमेश्‍वरझैं को छ र, जसको आफ्‍नो आसन उच्‍चमा छ,"]},{"type":"verse","number":6,"content":["जसले तल आकाश र पृथ्वीमा हे्र्नुहुन्छ?"]},{"type":"verse","number":7,"content":["उहाँले गरीबलाई फोहोरबाट उठाउनुहुन्‍छ र दरिद्रलाई खरानीको थुप्रोबाट उचाल्‍नुहुन्‍छ,"]},{"type":"verse","number":8,"content":["ताकि उहाँले त्यसलाई शासकहरूसित, त्यसका मानिसहरूका शासकहरूसित बसाल्‍नुहुन्छ ।"]},{"type":"verse","number":9,"content":["उहाँले घरकी बाँझी स्‍त्रीलाई घर दिनुहुन्छ । उहाँले त्यसलाई छोराछोरीकी आनन्‍दित आमा बनाउनुहुन्छ । परमप्रभुको प्रशंसा गर ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ulb/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ulb/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ulb/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}