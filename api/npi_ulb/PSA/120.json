{"translation":{"id":"npi_ulb","name":"पवित्र बाइबल","website":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseNotes":null,"shortName":"ULB","englishName":"Nepali Bible","language":"npi","textDirection":"ltr","sha256":"e85f83a4e9c862ba4acd255666e7eb82b700e149bbbdbbecaeeca9537d472708","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31109,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ulb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"5cbf29b2b4c9e2e78dd6edd19f9fa9f8bed11a5d532740584e37faf3b2ba7c45","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ulb/PSA/150.json","totalNumberOfVerses":2468},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":["मेरो संकष्‍टमा मैले परमप्रभुमा पुकारा गरें र उहाँले मलाई जवाफ दिनुभयो ।"]},{"type":"verse","number":2,"content":["हे परमप्रभु, आफ्‍ना ओठहरूले झुटा बोल्नेहरू र आफ्‍ना जिब्राहरूले छल गर्नेहरूबाट मेरो जीवनलाई बचाउनुहोस् ।"]},{"type":"verse","number":3,"content":["ए झुटा बोल्ने जिब्रो, उहाँले तँलाई कस्तो दण्ड दिनुहुनेछ र तँलाई अझ धेरै के गर्नुहुनेछ ?"]},{"type":"verse","number":4,"content":["झाडीको भुङ्‍ग्रोमा तताएर धारिलो बनाइएको योद्धाका काँडहरूले उहाँले तँलाई दण्ड दिनुहुनेछ ।"]},{"type":"verse","number":5,"content":["मलाई धिक्‍कार होस्, किनभने म मेशेकमा अस्थायी रूपमा मात्र बस्छु । पहिले केदारका पालहरूका माझमा म बस्थें ।"]},{"type":"verse","number":6,"content":["किनकि शान्तिलाई घृणा गर्नेहरूसँग म धेरै लामो समय बसेको छु ।"]},{"type":"verse","number":7,"content":["म शान्तिको पक्षमा छु, तर जब म बोल्छु, तिनीहरू युद्धको निम्ति हुन्छन् ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ulb/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ulb/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ulb/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}