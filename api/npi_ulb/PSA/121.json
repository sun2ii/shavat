{"translation":{"id":"npi_ulb","name":"पवित्र बाइबल","website":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseNotes":null,"shortName":"ULB","englishName":"Nepali Bible","language":"npi","textDirection":"ltr","sha256":"e85f83a4e9c862ba4acd255666e7eb82b700e149bbbdbbecaeeca9537d472708","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31109,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ulb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"5cbf29b2b4c9e2e78dd6edd19f9fa9f8bed11a5d532740584e37faf3b2ba7c45","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ulb/PSA/150.json","totalNumberOfVerses":2468},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":["पर्वतहरूतिर म आफ्‍ना आँखाहरू उचाल्नेछु । मेरो सहायता कहाँबाट आउनेछ?"]},{"type":"verse","number":2,"content":["मेरो सहायता परमप्रभुबाट आउँछ, जसले स्वर्ग र पृथ्वी बनाउनुभयो ।"]},{"type":"verse","number":3,"content":["उहाँले तिम्रो खुट्टा चिप्‍लन दिनुहुनेछैन । तिमीलाई सुरक्षा दिनुहुने, उहाँ उँघ्‍नुहुनेछैन ।"]},{"type":"verse","number":4,"content":["हेर, इस्राएलको रक्षक न त उँघ्‍नुहुन्छ न त सुत्‍नुहुन्छ ।"]},{"type":"verse","number":5,"content":["परमप्रभु तिम्रो रक्षक हुनुहुन्छ । परमप्रभु तिम्रो दाहिने हातपट्टिको छहारी हुनुहुन्छ ।"]},{"type":"verse","number":6,"content":["दिनमा तिमीलाई सूर्यले हानि गर्नेछैन, न त रातमा चन्द्रमाले कुनै हानि गर्नेछ ।"]},{"type":"verse","number":7,"content":["पमरप्रभुले तिमीलाई सबै हानिबाट सुरक्षा दिनुहुनेछ र उहाँले तिम्रो जीवनलाई सुरक्षा दिनुहुनेछ ।"]},{"type":"verse","number":8,"content":["तिमीले गर्ने सबै कुरामा परमप्रभुले तिमीलाई अहिले र सदासर्वदा रक्षा गर्नुहुनेछ ।"]}],"footnotes":[]},"thisChapterLink":"/api/