{"translation":{"id":"npi_ulb","name":"पवित्र बाइबल","website":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseNotes":null,"shortName":"ULB","englishName":"Nepali Bible","language":"npi","textDirection":"ltr","sha256":"e85f83a4e9c862ba4acd255666e7eb82b700e149bbbdbbecaeeca9537d472708","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31109,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ulb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"5cbf29b2b4c9e2e78dd6edd19f9fa9f8bed11a5d532740584e37faf3b2ba7c45","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ulb/PSA/150.json","totalNumberOfVerses":2468},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":["तिनीहरूले मलाई, “हामी परमप्रभुको मन्‍दिरमा जाऔं” भन्दा म खुसी हुन्थें ।"]},{"type":"verse","number":2,"content":["ए यरूशलेम, हाम्रा खुट्टाहरू तेरा ढोकाहरूभित्र खडा छन् ।"]},{"type":"verse","number":3,"content":["ए यरूशलेम, होसियार भएर योजना गरी बनाइएको सहर हो ।"]},{"type":"verse","number":4,"content":["कुलहरू, परमप्रभुका कुलहरू, इस्राएलको साक्षीको रूपमा परमप्रभुको नाउँमा धन्यवाद दिनलाई यरूशलेममा जान्छन् ।"]},{"type":"verse","number":5,"content":["त्यहाँ न्यायका सिंहासनहरू, दाऊदको घरानाको सिंहासनहरू खडा गरिएका थिए ।"]},{"type":"verse","number":6,"content":["यरूशलेमको शन्तिको निम्ति प्रार्थना गर । “तँलाई प्रेम गर्नेहरूलाई शान्ति मिलोस् ।"]},{"type":"verse","number":7,"content":["तेरो रक्षा गर्ने पर्खालहरूभित्र शान्ति रहोस् र तिनीहरूले तेरा किल्लाहरूभित्र शान्ति पाऊन् ।”"]},{"type":"verse","number":8,"content":["मेरा दाजुभाइ र मित्रहरूका खातिर, म भन्‍नेछु, “तँभित्र शान्ति होस् ।”"]},{"type":"verse","number":9,"content":["परमप्रभु हाम्रा परमेश्‍वरको मन्‍दिरको खातिर, म तेरो भलाइ खोज्‍नेछु ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ulb/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ulb/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ulb/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}