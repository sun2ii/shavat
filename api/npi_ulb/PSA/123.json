{"translation":{"id":"npi_ulb","name":"पवित्र बाइबल","website":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseNotes":null,"shortName":"ULB","englishName":"Nepali Bible","language":"npi","textDirection":"ltr","sha256":"e85f83a4e9c862ba4acd255666e7eb82b700e149bbbdbbecaeeca9537d472708","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31109,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ulb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"5cbf29b2b4c9e2e78dd6edd19f9fa9f8bed11a5d532740584e37faf3b2ba7c45","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ulb/PSA/150.json","totalNumberOfVerses":2468},"chapter":{"number":123,"content":[{"type":"verse","number":1,"content":["तपाईंतिर म आफ्‍ना आँखा उचल्छु, तपाईं जो स्वर्गमा विराजमान हुनुहुन्छ ।"]},{"type":"verse","number":2,"content":["हेर, जसरी कमाराहरूका आँखाले आफ्‍ना मालिकको हाततिर हेर्छन्, कमारीहरूका आँखाले आफ्‍ना मालिक्‍नीको हाततिर हेर्छन्, त्यसरी नै हाम्रा आँखाले परमप्रभु हाम्रा परमेश्‍वरतिर हेर्छन्, जबसम्म उहाँले हामीलाई कृपा गर्नुहुन्‍न ।"]},{"type":"verse","number":3,"content":["हामीमाथि दया गर्नुहोस्, हे परमप्रभु, हामीमाथि दया गर्नुहोस्, किनकि हामी अपमानले भरिएका छौं ।"]},{"type":"verse","number":4,"content":["अभिमानीहरूका गिल्ला र घमण्डीहरूका घृणाले भरिएको भन्दा पनि धेरै हामी भएका छौं ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ulb/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ulb/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ulb/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}