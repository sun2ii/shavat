{"translation":{"id":"npi_ulb","name":"पवित्र बाइबल","website":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseNotes":null,"shortName":"ULB","englishName":"Nepali Bible","language":"npi","textDirection":"ltr","sha256":"e85f83a4e9c862ba4acd255666e7eb82b700e149bbbdbbecaeeca9537d472708","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31109,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ulb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"5cbf29b2b4c9e2e78dd6edd19f9fa9f8bed11a5d532740584e37faf3b2ba7c45","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ulb/PSA/150.json","totalNumberOfVerses":2468},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":["परमप्रभुले नै घर बनाउनुभएन भने, त्‍यसलाई बनाउनेहरूले व्यर्थमा काम गर्छन् । परमप्रभुले नै सहरको रक्षा गर्नुभएन भने, रक्षकले व्यर्थमा रक्षा गर्छ ।"]},{"type":"verse","number":2,"content":["बिहान सबेरै उठ्नु, घर ढिला आउनु वा कडा परिश्रमको रोटी खानु तिम्रो निम्ति व्यार्थ हुन्‍छ, किनकि परमप्रभुका प्रियजन सुत्‍दा, उहाँले तिनीहरूला जुटाउनुहुन्छ ।"]},{"type":"verse","number":3,"content":["हेर, छोराछोरी परमप्रभुबाट प्राप्‍त उत्तराधिकार हुन् र गर्भको फल उहाँको इनाम हो ।"]},{"type":"verse","number":4,"content":["योद्धाको हातका काँडहरूझैं जवानी अवस्थाका छोराछोरी हुन्छन् ।"]},{"type":"verse","number":5,"content":["त्यो मानिस धन्यको हो,जसको ठोक्रो काँडहरूले भरिएको छ । त्यसले ढोकामा त्यसका शत्रुहरूको सामना गर्दा त्यो लज्‍जित हुनेछैन ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ulb/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ulb/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ulb/PSA/126.json","