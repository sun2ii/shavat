{"translation":{"id":"npi_ulb","name":"पवित्र बाइबल","website":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseNotes":null,"shortName":"ULB","englishName":"Nepali Bible","language":"npi","textDirection":"ltr","sha256":"e85f83a4e9c862ba4acd255666e7eb82b700e149bbbdbbecaeeca9537d472708","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31109,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ulb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"5cbf29b2b4c9e2e78dd6edd19f9fa9f8bed11a5d532740584e37faf3b2ba7c45","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ulb/PSA/150.json","totalNumberOfVerses":2468},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":["हे परमप्रभु, गहिराइबाट तपाईंमा म पुकारा गर्छु ।"]},{"type":"verse","number":2,"content":["हे परमप्रभु, मेरो सोर सुन्‍नुहोस् । दयाको निम्ति मेरो बिन्‍ती सुन्‍नलाई तपाईंका कानहरू सचेत होऊन् ।"]},{"type":"verse","number":3,"content":["हे परमप्रभु, तपाईंले अधर्महरू उल्लेख गर्नुभयो भने, हे पमरप्रभु, को खडा हुन सक्थ्यो र?"]},{"type":"verse","number":4,"content":["तर तपाईंमा क्षमा छ, जसले गर्दा तपाईंको आदर गरिन्‍छ ।"]},{"type":"verse","number":5,"content":["म परमप्रभुमा पर्खिन्‍छु, मेरो प्राणले पर्खिन्‍छु र उहाँको वचनमा म आसा गर्छु ।"]},{"type":"verse","number":6,"content":["रक्षकले बिहानको प्रतीक्षा गर्नेभन्दा धेरै मेरो प्राणले परमप्रभुको प्रतीक्षा गर्छ ।"]},{"type":"verse","number":7,"content":["ए इस्राएल, परमप्रभुमा आसा गर । परमप्रभु कृपालु हुनुहुन्छ र उहाँ क्षमा दिन तत्पर हुनुहुन्छ ।"]},{"type":"verse","number":8,"content":["इस्राएललाई त्यसका सबै पापहरूबाट उद्धार गर्नुहुने उहाँ नै हुनुहुन्छ ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ulb/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ulb/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ulb/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}