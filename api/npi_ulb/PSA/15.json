{"translation":{"id":"npi_ulb","name":"पवित्र बाइबल","website":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseNotes":null,"shortName":"ULB","englishName":"Nepali Bible","language":"npi","textDirection":"ltr","sha256":"e85f83a4e9c862ba4acd255666e7eb82b700e149bbbdbbecaeeca9537d472708","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31109,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ulb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"5cbf29b2b4c9e2e78dd6edd19f9fa9f8bed11a5d532740584e37faf3b2ba7c45","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ulb/PSA/150.json","totalNumberOfVerses":2468},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["हे परमप्रभु, तपाईंको पवित्रस्थानमा को बस्‍न सक्छ? तपाईंको पवित्र पर्वतमा को वास गर्न सक्छ?"]},{"type":"verse","number":2,"content":["जो निर्दोष भएर हिंड्छ, जसले ठिक काम गर्छ र आफ्‍नो हृदयले सत्य बोल्छ ।"]},{"type":"verse","number":3,"content":["त्यसले आफ्नो जिब्रोले निन्दा गर्दैन, त्यसले अरूको हानि गर्दैन र त्यसले आफ्नो छिमेकीलाई होच्‍याउँदैन ।"]},{"type":"verse","number":4,"content":["उसको दृष्‍टिमा व्‍यर्थको व्‍यक्‍ति घृणित हुन्छ, तर परमप्रभुको भय मान्‍नेहरूलाई त्यसले आदर गर्छ । त्यसले आफ्नो हानि हुँदा पनि शपथ खान्छ र आफ्‍नो प्रतिज्ञाहरूबाट पछि हट्दैन ।"]},{"type":"verse","number":5,"content":["त्यसले रुपियाँ दिंदा ब्याज लिंदैन । निर्दोषको विरुद्ध साक्षी दिन त्यसले घूस लिंदैन । यी कुरा गर्नेहरू कहिल्यै डग्‍नेछैनन् ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ulb/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ulb/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ulb/PSA/14.json","previo