{"translation":{"id":"npi_ulb","name":"पवित्र बाइबल","website":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=npiulb","licenseNotes":null,"shortName":"ULB","englishName":"Nepali Bible","language":"npi","textDirection":"ltr","sha256":"e85f83a4e9c862ba4acd255666e7eb82b700e149bbbdbbecaeeca9537d472708","availableFormats":["json"],"listOfBooksApiLink":"/api/npi_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31109,"languageName":"नेपाली","languageEnglishName":"Nepali"},"book":{"id":"PSA","translationId":"npi_ulb","name":"भजनसंग्रह","commonName":"भजनसंग्रह","title":"भजनसंग्रहको पुस्तक","order":19,"numberOfChapters":150,"sha256":"5cbf29b2b4c9e2e78dd6edd19f9fa9f8bed11a5d532740584e37faf3b2ba7c45","firstChapterNumber":1,"firstChapterApiLink":"/api/npi_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/npi_ulb/PSA/150.json","totalNumberOfVerses":2468},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":["हे परमेश्‍वर, मलाई बचाउनुहोस्! हे परमप्रभु, चाँडो आउनुहोस् र मलाई सहायता गर्नुहोस् ।"]},{"type":"verse","number":2,"content":["मेरो ज्‍यान लिन खोज्‍नेहरू लज्‍जित र अपमानित होऊन् । तिनीहरूलाई फर्काइयोस् र अनादर गरियोस्, जो मेरो पीडामा आनन्‍दित हुन्‍छन् ।"]},{"type":"verse","number":3,"content":["तिनीहरूका लाजको कारणले तिनीहरूलाई फर्काइयोस्, जसले भन्छन्, “आहा, आहा !”"]},{"type":"verse","number":4,"content":["तपाईंको खोजी गर्नेहरू आनन्‍दित होऊन् र तपाईंमा खुसी होऊन् । तपाईंको उद्धार मन पराउनेहरूले सधैं भनून्, “परमेश्‍वरको स्तुति होस् ।”"]},{"type":"verse","number":5,"content":["तर म गरीब र दरिद्र छु । हे परमेश्‍वर, मकहाँ चाँडो आउनुहोस् । तपाईं मेरो सहायता हुनुहुन्छ र तपाईंले मलाई छुटाउनुहुन्छ । हे परमप्रभु, ढिलो नगर्नुहोस् ।"]}],"footnotes":[]},"thisChapterLink":"/api/npi_ulb/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ulb/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ulb/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}