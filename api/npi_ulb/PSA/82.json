otes":[]},"thisChapterLink":"/api/npi_ulb/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/npi_ulb/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/npi_ulb/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}