{"translation":{"id":"nrz_nar","name":"Luva'ana'i Namana Makamakana","website":"https://ebible.org/Scriptures/details.php?id=nrz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nrz","licenseNotes":null,"shortName":"NAR","englishName":"Nara NT","language":"nrz","textDirection":"ltr","sha256":"3415e38577d2acdc1f7e6da84f7e04ca2871090577e079bf5c0c4408673c9aec","availableFormats":["json"],"listOfBooksApiLink":"/api/nrz_nar/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7957,"languageName":"Lala","languageEnglishName":"Lala"},"book":{"id":"HEB","translationId":"nrz_nar","name":"'Ebelu","commonName":"'Ebelu","title":"Malele 'EBELU Kauta Kevatai","order":58,"numberOfChapters":13,"sha256":"7036c3ac8200c18678202f92d4a755ae83f35f1d1455b127a6173337f3965d92","firstChapterNumber":1,"firstChapterApiLink":"/api/nrz_nar/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/nrz_nar/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Dilava Ena LuvaNakuna E'outa."]},{"type":"verse","number":1,"content":["Siako vaika koanai Dilava eta'u enolea kauta nututai melala doutamo dala edeata edeatai 'ava'avata e'outa."]},{"type":"verse","number":2,"content":["Beia vali'u melala katania to'otai 'eva Nakuna nutunai ita e'outa. Dilava eta'u Nakuna dainai vutuvutu mai kanobata evavaita, ia eta'u Nakuna edilaia avuna davata boutai evenia ia ena."]},{"type":"verse","number":3,"content":["Nakuna kanania Dilava ena nuavi 'amale 'amalena evala'asia, ia 'eva Dilava vitaitana umauna, ia ena luva siavunai dava boutai e'imata. Ia kau eta si'avana edeinita ovo mulinai vutuvutuai siavu boutai Dilavana idibana duasi 'olana iakuna 'abunai emia divo emia."]},{"type":"heading","content":["Dilava Nakuna 'EvaAnelu Ekeinita."]},{"type":"verse","number":4,"content":["Ia 'eva anelu ekeinita 'olana Dilava ia vana evenia vana 'eva anelu vata ekeinita."]},{"type":"verse","number":5,"content":["Dilava eta'u ia e'ouia ediaka,",{"text":"“Oni 'eva lau Naku'u.","poem":1},{"lineBreak":true},{"text":"Vali'u melala kanania'i Lau oni","poem":1},{"lineBreak":true},{"text":"avapulumu,”","poem":1},"Sal 2.7 ia anelu sia ka kevanai kanaua eluva koma, mune'e ediaka,",{"text":"“Lau 'eva ia Kamanai ba'ao,","poem":1},{"lineBreak":true},{"text":"ia vaka Lau Naku'u ai be'ao.”","poem":1},"2 Sam 7.14"]},{"type":"verse","number":6,"content":["Mai vaka Nakuna batani kauna esinia easi kanobatai koanai eluva ediaka,",{"text":"“Dilava ena anelu boutai","poem":1},{"lineBreak":true},{"text":"'eva ia bekukudivo venia.”","poem":1},"Deu 32.43"]},{"type":"verse","number":7,"content":["Anelu lovata eaku ediaka,",{"text":"“Dilava ena anelu 'eva","poem":1},{"lineBreak":true},{"text":"lani ai evaota, ena anelu vaida","poem":1},{"lineBreak":true},{"text":"da'alana deabi aneluta 'eva","poem":1},{"lineBreak":true},{"text":"'alova vulenai evaota.”","poem":1},"Sal 104.4"]},{"type":"verse","number":8,"content":["Ia Nakuna lovana eakuia ediaka,",{"text":"“Oni 'eva Dilava, emu","poem":1},{"lineBreak":true},{"text":"lovia imia'auna bemia keinikeini,","poem":1},{"lineBreak":true},{"text":"oni 'eva komolo ai emu vanua","poem":1},{"lineBreak":true},{"text":"o'ola vaia.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vinaula komolo oula venia,","poem":1},{"lineBreak":true},{"text":"si'avana 'eva ovaivivia.","poem":1},{"lineBreak":true},{"text":"Kanaua 'ounai Dilava emu Dilava","poem":1},{"lineBreak":true},{"text":"eta'u lalonama deolonai esisimu","poem":1},{"lineBreak":true},{"text":"emu lovia koana,","poem":1},{"lineBreak":true},{"text":"vamu eabiaisi banomu vailatai.”","poem":1},"Sal 45.6, 7"]},{"type":"verse","number":10,"content":["Mai mune'e ediaka,",{"text":"“Lovia namana e,","poem":1},{"lineBreak":true},{"text":"makavana umaunai kanobata","poem":1},{"lineBreak":true},{"text":"'eva oni ovavaia, vutuvutu vaka","poem":1},{"lineBreak":true},{"text":"oni imamuai ovavaia.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vutuvutu mai kanobata","poem":1},{"lineBreak":true},{"text":"'eva betaule, beia oni 'eva","poem":1},{"lineBreak":true},{"text":"bomia keinikeini,","poem":1},{"lineBreak":true},{"text":"mai dava boutai bevuluvulu","poem":1},{"lineBreak":true},{"text":"tubu'a 'ana'ina boina.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vutuvutu mai kanobata bolo'uta","poem":1},{"lineBreak":true},{"text":"ikalu boina, ikata bedeana","poem":1},{"lineBreak":true},{"text":"tubu'a 'ana'ina boina.","poem":1},{"lineBreak":true},{"text":"Ia oni 'eva 'abumuai mo,","poem":1},{"lineBreak":true},{"text":"emu mauli vikauta 'eva","poem":1},{"lineBreak":true},{"text":"sia be'ole.”","poem":1},"Sal 102.25-27"]},{"type":"verse","number":13,"content":["Sia melala ka Dilava anelu ka kanania e'ouia koma ediaka,",{"text":"“Idiba'u duasi miadivo","poem":1},{"lineBreak":true},{"text":"beda'amo oni ivaivivimu kauta","poem":1},{"lineBreak":true},{"text":"aemu palapalana ine'ena 'au","poem":1},{"lineBreak":true},{"text":"davanai bava aota.”","poem":1},"Sal 110.1"]},{"type":"verse","number":14,"content":["Anelu 'eva dava? Ia boutai 'eva idume, Dilava da'alana deabi kauta, esinita vamauli beabia kauta beduluta."]}],"footnotes":[]},"thisChapterLink":"/api/nrz_nar/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nrz_nar/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nrz_nar/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}