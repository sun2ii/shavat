{"translation":{"id":"nrz_nar","name":"Luva'ana'i Namana Makamakana","website":"https://ebible.org/Scriptures/details.php?id=nrz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nrz","licenseNotes":null,"shortName":"NAR","englishName":"Nara NT","language":"nrz","textDirection":"ltr","sha256":"3415e38577d2acdc1f7e6da84f7e04ca2871090577e079bf5c0c4408673c9aec","availableFormats":["json"],"listOfBooksApiLink":"/api/nrz_nar/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7957,"languageName":"Lala","languageEnglishName":"Lala"},"book":{"id":"HEB","translationId":"nrz_nar","name":"'Ebelu","commonName":"'Ebelu","title":"Malele 'EBELU Kauta Kevatai","order":58,"numberOfChapters":13,"sha256":"7036c3ac8200c18678202f92d4a755ae83f35f1d1455b127a6173337f3965d92","firstChapterNumber":1,"firstChapterApiLink":"/api/nrz_nar/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/nrz_nar/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["Iesu 'Eva Ita Eta Kabukabu KaunaNamana Vutuvutu Ai."]},{"type":"verse","number":1,"content":["Lau aluvavai luvata anita 'eva katania, ita maieta kabukabu kauna namana kanania boina kauna ka emimia. Ia vutuvutuai siavu Dilavana ena mia'au 'abuna idibana duasi i'olaku vaina 'abunai 'ani emia'au."]},{"type":"verse","number":2,"content":["Ia 'abu kabukabuna umaunai kabukabu kauna namana ena vinaula evavaia, lo'e umauna kanaua 'eva sia kau devalavala, Lovia namana Dilava eta'u evalavala."]},{"type":"verse","number":3,"content":["Kabukabu kauta namata boutai deabita isi 'eva ainama davata mai veniveni davata beveveni Dilava kevanai, kanaua 'ounai eta kabukabu kauna namana kanania vaka dava ka beveveni."]},{"type":"verse","number":4,"content":["Iesu kanobatai bemamia koanai ia kabukabu kaunai sia bemao, 'olana kabukabu kauta demia ia deta'u ainama davata deveni Mose ena talavatu vitaitanai."]},{"type":"verse","number":5,"content":["Kabukabu kauta eta vinaula 'eva vutuvutuai devavaia vinaulana vitaitana umauna va'ava'ana koana boina, vinaula kanaua 'eva vitaitana Dilava Mose e'ouia pasisi lo'e kabukabuna evalavala boina ediaka, “Bo'ika, loloai avaikamu davata boutai ikaikata vitaitata umautai bovavai.”"]},{"type":"verse","number":6,"content":["Beia vali'u Iesu kabukabu vinaulana eabia 'eva kabukabu kauta eta vinaula ekeinita, 'olana ia luva'ana'i namana kanaua vaka'ona kaunai eao, luva'ana'i namana kanania 'eva kena enama'ina vakaia luva'ana'i namana 'ana'ina, 'olana ua 'eva luva'ana'i nama'ita vaika akatai evalavala."]},{"type":"heading","content":["Luva'ana'i Namana Makamakana'Eva 'Ana'ina Ekeinia."]},{"type":"verse","number":7,"content":["Luva'ana'i namana lava'ana'ina itoinai bemanama'ina koanai, ivaluana sia kamaula venia."]},{"type":"verse","number":8,"content":["Beia Dilava ena kau kevatai va'eva eikaia 'ounai e'outa ediaka,",{"text":"“Lau, Lovia namana Dilava,","poem":1},{"lineBreak":true},{"text":"aluluva, Melala 'ani e'asi,","poem":1},{"lineBreak":true},{"text":"luva'ana'i namana makamakana","poem":1},{"lineBreak":true},{"text":"bavavaia Isalaela kauta kevatai","poem":1},{"lineBreak":true},{"text":"maivaka Iuda iduvuna laloanai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lau, Lovia namana Dilava,","poem":1},{"lineBreak":true},{"text":"aluluva, Luva'ana'i namana","poem":1},{"lineBreak":true},{"text":"kanania 'eva sia ia 'ava'avata","poem":1},{"lineBreak":true},{"text":"ita aluva'ana'i luvana boina,","poem":1},{"lineBreak":true},{"text":"ia imatai abi Aikupito kanonai","poem":1},{"lineBreak":true},{"text":"avala'asita koanai.","poem":1},{"lineBreak":true},{"text":"Ia e'u luva'ana'i namana","poem":1},{"lineBreak":true},{"text":"sia deabivenia 'ounai","poem":1},{"lineBreak":true},{"text":"lau vaka leleta sia aika.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lau, Lovia namana Dilava,","poem":1},{"lineBreak":true},{"text":"mune'e aluluva,","poem":1},{"lineBreak":true},{"text":"Kanaua mulinai luva'ana'i","poem":1},{"lineBreak":true},{"text":"namana kanania 'eva Isalaela","poem":1},{"lineBreak":true},{"text":"kauta kevatai bavavaia.","poem":1},{"lineBreak":true},{"text":"Lau e'u talavatu ia nuatai","poem":1},{"lineBreak":true},{"text":"bane'ea divo mai","poem":1},{"lineBreak":true},{"text":"ia nuata 'otoitai baleleta.","poem":1},{"lineBreak":true},{"text":"Lau 'eva ia eta Dilava ai ba'ao,","poem":1},{"lineBreak":true},{"text":"ia 'eva lau e'u kau ai be'ao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sia kau ka bo'akalana 'o","poem":1},{"lineBreak":true},{"text":"kevanai kauna bevaikabasia","poem":1},{"lineBreak":true},{"text":"bediaka,","poem":1},{"lineBreak":true},{"text":"‘Lovia namana boikabasia’.","poem":1},{"lineBreak":true},{"text":"'Olana kikinai eda'amo","poem":1},{"lineBreak":true},{"text":"namana koana boutai","poem":1},{"lineBreak":true},{"text":"'ani beikabasi'u.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Eta va'eva vinaulata laloatai","poem":1},{"lineBreak":true},{"text":"balalota inoku eta si'avana","poem":1},{"lineBreak":true},{"text":"babolabolata.”","poem":1},"Ier 31.31-34"]},{"type":"verse","number":13,"content":["Dilava luva'ana'i namana makamakana eluvavaia koanai, lava'ana'ina kanaua 'eva 'ana'inai evaoa, inoku dava e'ana'ia mai evuluvulu davana 'eva betaule."]}],"footnotes":[]},"thisChapterLink":"/api/nrz_nar/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nrz_nar/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nrz_nar/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}