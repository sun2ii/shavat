{"translation":{"id":"nrz_nar","name":"Luva'ana'i Namana Makamakana","website":"https://ebible.org/Scriptures/details.php?id=nrz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nrz","licenseNotes":null,"shortName":"NAR","englishName":"Nara NT","language":"nrz","textDirection":"ltr","sha256":"3415e38577d2acdc1f7e6da84f7e04ca2871090577e079bf5c0c4408673c9aec","availableFormats":["json"],"listOfBooksApiLink":"/api/nrz_nar/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7957,"languageName":"Lala","languageEnglishName":"Lala"},"book":{"id":"MAT","translationId":"nrz_nar","name":"Mataio","commonName":"Mataio","title":"Vali Nama'ina MATAIO Eleleia Kauna","order":40,"numberOfChapters":28,"sha256":"3e97b52a502ef68745826a7ad3dfa05d0e5164191020d942f76ec921d3948e20","firstChapterNumber":1,"firstChapterApiLink":"/api/nrz_nar/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/nrz_nar/MAT/28.json","totalNumberOfVerses":1070},"chapter":{"number":1,"content":[{"type":"heading","content":["Iesu Keliso Ena Pulu Kubu Idolina."]},{"type":"verse","number":1,"content":["Iesu Keliso ena pulu kubu idolina, ia Abela'amo mai Davida 'ava'avatai easi."]},{"type":"verse","number":2,"content":["Abela'amo eta'u Isa'ako evapulua,",{"text":"Isa'ako eta'u Iakobo evapulua,","poem":1},{"lineBreak":true},{"text":"Iakobo nakuna 'eva Iuda mai bo'akalana ita.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iuda eta'u Pelese mai Sela evapuluta, sinata 'eva Tamala,","poem":1},{"lineBreak":true},{"text":"Pelese eta'u 'Esalona evapulua,","poem":1},{"lineBreak":true},{"text":"'Esalona eta'u Lama evapulua.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lama eta'u Aminadaba evapulua,","poem":1},{"lineBreak":true},{"text":"Aminadaba eta'u Nasona evapulua,","poem":1},{"lineBreak":true},{"text":"Nasona eta'u Salamona evapulua.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salamona eta'u Boasi evapulua, sinana 'eva La'aba pulu edea ateatena.","poem":1},{"lineBreak":true},{"text":"Boasi eta'u Obeda evapulua, sinana 'eva Luta pulu edea ateatena.","poem":1},{"lineBreak":true},{"text":"Obeda eta'u Iese evapulua.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Iese eta'u vanua Lovia 'olana Davida evapulua.","poem":1},{"lineBreak":true},{"text":"Davida eta'u Solomona evapulua,","poem":1},{"lineBreak":true},{"text":"ia sinana 'eva 'ana'inai Ulia adana.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Solomona eta'u Le'oboama evapulua,","poem":1},{"lineBreak":true},{"text":"Le'oboama eta'u Abia evapulua,","poem":1},{"lineBreak":true},{"text":"Abia eta'u Asa evapulua.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa eta'u Ie'osabata evapulua,","poem":1},{"lineBreak":true},{"text":"Ie'osabata eta'u Iolama evapulua,","poem":1},{"lineBreak":true},{"text":"Iolama eta'u Usia evapulua.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Usia eta'u Iotama evapulua,","poem":1},{"lineBreak":true},{"text":"Iotama eta'u A'asa evapulua,","poem":1},{"lineBreak":true},{"text":"A'asa eta'u 'Esekia evapulua.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"'Esekia eta'u Manase evapulua,","poem":1},{"lineBreak":true},{"text":"Manase eta'u Amona evapulua,","poem":1},{"lineBreak":true},{"text":"Amona eta'u Iosia evapulua.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Iosia eta'u Iekonia mai bo'akalana evapuluta,","poem":1},{"lineBreak":true},{"text":"melala kanaua'i Babulono kauta deta'u Isalaela kauta deabita devuata deda'a eta kanobatai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vaida devuata deda'a Babulono mulinai Iekonia eta'u Sealetiele evapulua,","poem":1},{"lineBreak":true},{"text":"Sealetiele eta'u Selubabele evapulua.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Selubabele eta'u Abiuda evapulua,","poem":1},{"lineBreak":true},{"text":"Abiuda eta'u Eliakima evapulua,","poem":1},{"lineBreak":true},{"text":"Eliakima eta'u Asolo evapulua.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Asolo eta'u Sadoka evapulua,","poem":1},{"lineBreak":true},{"text":"Sadoka eta'u Akimi evapulua,","poem":1},{"lineBreak":true},{"text":"Akimi eta'u 'Eliuda evapulua.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"'Eliuda eta'u Eleasala evapulua,","poem":1},{"lineBreak":true},{"text":"Eleasala eta'u Matana evapulua,","poem":1},{"lineBreak":true},{"text":"Matana eta'u Iakobo evapulua.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Iakobo eta'u Iosepa evapulua.","poem":1},{"lineBreak":true},{"text":"Iosepa adana Malia eta'u Iesu evapulua, kau vana de'aeia Keliso vamauli kauna.","poem":1}]},{"type":"verse","number":17,"content":["Kanaua'i Abela'amo enai eda'a Davida enai 'eva ulu 'ouka vani, Davida enai eda'amo deda'a vaita Babulono melalanai vaka ulu 'ouka vani, mune'e devuata deda'a Babulono mulinai eda'amo Keliso enai vaka 'eva ulu 'ouka vani."]},{"type":"heading","content":["Iesu Keliso Ena Pulu."]},{"type":"verse","number":18,"content":["Iesu Keliso a epulu koma valina 'eva kanania. Sinana Malia 'eva deluva 'ana'i vaia Iosepa beadavala, beia asido'o devaka'onamo laloanai eikabasi Idume Kabukabuna siavunai melo ka beabia."]},{"type":"verse","number":19,"content":["Iosepa 'eva komolo kauna, sia eula Malia bevamalalaia kau mato vailatai 'ounai, eula luva 'ana'i kanaua vunivuniai bevavaia si'asi'a."]},{"type":"verse","number":20,"content":["Lalovai kanaua elalovaia laloanai, Lovia namana ena Anelu niviai kevanai ela'asi e'ouia ediaka, “Iosepa Davida 'ava'avana e, Malia iadavana sia bomakau, 'olana Idume Kabukabuna siavunai melo kanaua beabia."]},{"type":"verse","number":21,"content":["Ia 'eva melo ka bevapulua, vana oi bo'aea Iesu, 'olana ia 'eva ena kau eta si'avanai bevamaulita.”"]},{"type":"verse","number":22,"content":["Koa kanania epulu 'eva Lovia namana ena enolea kauna e'ouia luvana evamomo'aia."]},{"type":"verse","number":23,"content":[{"text":"“Vato makamaka ka besivabu melo ka bevapulua,","poem":1},{"lineBreak":true},{"text":"vana be'aea 'Emanuela.”","poem":1},{"lineBreak":true},{"text":"Anina 'eva ‘Dilava ita kevatai’.","poem":1},"Isa 7.14"]},{"type":"verse","number":24,"content":["Iosepa eibi mulinai, Lovia namana ena Anelu eluva vitaitana evavaia Malia eadavala."]},{"type":"verse","number":25,"content":["Ia laluana sia deno ka'ona kovo eda'amo Malia melo evapulua. Iosepa melo vana e'aeia Iesu."]}],"footnotes":[]},"thisChapterLink":"/api/nrz_nar/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nrz_nar/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}