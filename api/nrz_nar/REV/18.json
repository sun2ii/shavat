{"translation":{"id":"nrz_nar","name":"Luva'ana'i Namana Makamakana","website":"https://ebible.org/Scriptures/details.php?id=nrz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nrz","licenseNotes":null,"shortName":"NAR","englishName":"Nara NT","language":"nrz","textDirection":"ltr","sha256":"3415e38577d2acdc1f7e6da84f7e04ca2871090577e079bf5c0c4408673c9aec","availableFormats":["json"],"listOfBooksApiLink":"/api/nrz_nar/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7957,"languageName":"Lala","languageEnglishName":"Lala"},"book":{"id":"REV","translationId":"nrz_nar","name":"Ivala'asina","commonName":"Ivala'asina","title":"Keliso Ena Luva IVALA'ASINA Ioane Kevanai","order":66,"numberOfChapters":22,"sha256":"2df2dbe6a8d32d0873a3df6288ca0a9b2781e5f8c0f6bff6dc2a97aaf1b2d26c","firstChapterNumber":1,"firstChapterApiLink":"/api/nrz_nar/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/nrz_nar/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["Babulonia Vanua NamanaAni E'ekoasi."]},{"type":"verse","number":1,"content":["Katania mulitai anelu edeana ka vutuvutuai e'ovu easi aikaia. Ia ena siavu 'eva nama vaikana mai ena nuaviai kanobata itoina eva'ailalala."]},{"type":"verse","number":2,"content":["Lelena evakula'ilala evaoi 'unu'unu ediaka,",{"text":"“'Ani e'ekoasi! Babulonia","poem":1},{"lineBreak":true},{"text":"vanuana namana 'ani e'ekoasi!","poem":1},{"lineBreak":true},{"text":"Ia 'eva diabolo mai ka'uba si'avata","poem":1},{"lineBreak":true},{"text":"boutai eta mia 'abunai e'ao,","poem":1},{"lineBreak":true},{"text":"manumanu si'avata mai","poem":1},{"lineBreak":true},{"text":"ulata sia de'ula davata","poem":1},{"lineBreak":true},{"text":"eta mia 'abunai e'ao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"'Olana kanobata kauta boutai","poem":1},{"lineBreak":true},{"text":"ita kulakula koakoata si'avata","poem":1},{"lineBreak":true},{"text":"vaika devavai","poem":1},{"lineBreak":true},{"text":"itani ena mulamula pasisinai","poem":1},{"lineBreak":true},{"text":"deinu ba boina.","poem":1},{"lineBreak":true},{"text":"Kanobatai lovia 'olata kauta vaka","poem":1},{"lineBreak":true},{"text":"ia ita deno ka'ona,","poem":1},{"lineBreak":true},{"text":"mai kanobatai tavatava kauta","poem":1},{"lineBreak":true},{"text":"'eva ena dava mediata tavata","poem":1},{"lineBreak":true},{"text":"namatai delovia.”","poem":1}]},{"type":"verse","number":4,"content":["Inoku lele edeana ka vutuvutuai aika ediaka,",{"text":"“E'u kau e, vanua kanana","poem":1},{"lineBreak":true},{"text":"laloanai ola'asi omai.","poem":1},{"lineBreak":true},{"text":"Inoku ia ita si'avana","poem":1},{"lineBreak":true},{"text":"sia oi bovavai ka'ona.","poem":1},{"lineBreak":true},{"text":"Mai ena anaana si'avata vaika","poem":1},{"lineBreak":true},{"text":"sia ka oi boabia.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"'Olana ena si'avana 'eva","poem":1},{"lineBreak":true},{"text":"'ani edouia eda'amo vutuvutuai,","poem":1},{"lineBreak":true},{"text":"mai Dilava 'eva ia ena vavai","poem":1},{"lineBreak":true},{"text":"si'asi'a boutai elalovai 'ini.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ena veniveni vitaitanaimo","poem":1},{"lineBreak":true},{"text":"oi bovenia 'udai.","poem":1},{"lineBreak":true},{"text":"Evavaia davana 'eva","poem":1},{"lineBreak":true},{"text":"melala lua tavana oi boveveni.","poem":1},{"lineBreak":true},{"text":"Mulamula pasisina evenimui","poem":1},{"lineBreak":true},{"text":"davana 'eva melala lua","poem":1},{"lineBreak":true},{"text":"ena 'ouai oi bolaiauda","poem":1},{"lineBreak":true},{"text":"bekula'ila inoku beinua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Anaana namavaikana mai","poem":1},{"lineBreak":true},{"text":"vilalo namavaikana oi bovenia","poem":1},{"lineBreak":true},{"text":"itani nuavi mai dava tavata","poem":1},{"lineBreak":true},{"text":"namata sibona evenia boina.","poem":1},{"lineBreak":true},{"text":"Sibona nuanai eapa ediaka,","poem":1},{"lineBreak":true},{"text":"‘Lau 'eva lovia 'olana ateate'u","poem":1},{"lineBreak":true},{"text":"amimia, lau 'eva sia obu,","poem":1},{"lineBreak":true},{"text":"mai lau 'eva sia bakani kovo.’","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kanaua 'ounai melala ka'onamo","poem":1},{"lineBreak":true},{"text":"laloanai ia bana davata boutai","poem":1},{"lineBreak":true},{"text":"bedavalita,","poem":1},{"lineBreak":true},{"text":"ba, kani mai doe.","poem":1},{"lineBreak":true},{"text":"Ia 'eva 'alova laloanai beani palu.","poem":1},{"lineBreak":true},{"text":"'Olana Lovia namana Dilava","poem":1},{"lineBreak":true},{"text":"ia ilavuaina Dilavana 'eva","poem":1},{"lineBreak":true},{"text":"ekula'ila vaika.","poem":1}]},{"type":"verse","number":9,"content":["“Kanobatai lovia 'olata ia ita deno ka'ona mai ena lavo delalonama vaia ka'ona kauta 'eva 'alova kanaua vaitabuna beikala koanai belaloa mai bekanidiala."]},{"type":"verse","number":10,"content":["Ena anaana bevamakauta, inoku ia 'eva dau'ai vaika belalava bekakani beluluva,",{"text":"‘Esi'avana vaika!","poem":1},{"lineBreak":true},{"text":"Kula'ila vanuana namana e,","poem":1},{"lineBreak":true},{"text":"esi'avana vaika!","poem":1},{"lineBreak":true},{"text":"Babulonia e,","poem":1},{"lineBreak":true},{"text":"siavu vanuana namana!","poem":1},{"lineBreak":true},{"text":"Melala koana ka'onamo laloanai","poem":1},{"lineBreak":true},{"text":"Dilava evaanaanamu vaika.’","poem":1}]},{"type":"verse","number":11,"content":["“Kanobatai tavatava kauta vaka belaloa mai bekanidiala 'olana eta tavatava davata 'eva sia kau ka 'ani betava 'udai."]},{"type":"verse","number":12,"content":["Tavatava davata kataua 'eva kolo mai siliva, bika'a koevata mai kutukutu 'amale'amaleta, tubu'a koevata vaika, tubu'a pepolota, tubu'a kevekeveta nama'ita, tubu'a a'olata, au bonata nama'itai devavai davata edeata edeata, sisi vana elepant kusivanai devavai davata boutai, au tavata namata auta, kopa, 'auli mai bika'a pasisina medianai devavaita davata,"]},{"type":"verse","number":13,"content":["iani bonata ivanama'inata mulamulata vata sinemoni mai spaisi, mulamula bonata nama'ita vata inisenese mai mila, mai mulamula kula'ilana kauani beuku mulamulana, mulamula pasisina mai olive deolona, palaoa nama'ita, witi, bolomakau mai mamoe, osi, mai kaliota, da'alabi kauta, mai kau eta mauli."]},{"type":"verse","number":14,"content":["Dava detavatava vai kauta be'oua bediaka,",{"text":"‘Babulonia e,","poem":1},{"lineBreak":true},{"text":"dava nama'ita oula venita davata","poem":1},{"lineBreak":true},{"text":"mai emu lovia davata mai emu","poem":1},{"lineBreak":true},{"text":"nuavi davata boutai 'eva","poem":1},{"lineBreak":true},{"text":"'ani detaule,","poem":1},{"lineBreak":true},{"text":"inoku sia 'ani bodavalita 'udai.’","poem":1}]},{"type":"verse","number":15,"content":["“Tavatava kauta dava ia kevanai detavatava vaita inoku monitai delovia kauta 'eva dau'ai vaika belalava, 'olana ena anaana bevamakauta. Belaloa mai bekanidiala"]},{"type":"verse","number":16,"content":["Bekakani bediaka,",{"text":"‘Esi'avana vaika!","poem":1},{"lineBreak":true},{"text":"Esi'avana vaika, Vanua namana e'","poem":1},{"lineBreak":true},{"text":"Tubu'a koevana vaika vana linen,","poem":1},{"lineBreak":true},{"text":"pepolona, mai 'aolana ovadodota,","poem":1},{"lineBreak":true},{"text":"kolo 'amale'amaletai,","poem":1},{"lineBreak":true},{"text":"bika'a koevata vaika mai","poem":1},{"lineBreak":true},{"text":"kutukutu nama'itai ovanama.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Melala koana ka'onamo","poem":1},{"lineBreak":true},{"text":"laloanai emu lovia davata","poem":1},{"lineBreak":true},{"text":"katania boutai 'eva 'ani deole.’","poem":1},"“Aunakoi kapena kauta boutai, mai dele'au dekalima kauta boutai, aunakoiai devinaula kauta boutai, mai 'atuai deda'a to'ato'a eta dava detavatava vai kauta boutai dau'ai belalava."]},{"type":"verse","number":18,"content":["Ia be'ani vaitabuna bele'au beikala koanai, bevaoi bediaka,",{"text":"‘Vanua davana 'eva vanua namana kanania boina?’","poem":1}]},{"type":"verse","number":19,"content":["Apulolo 'olata akatai bene'e'au mai belaloa mai bekakani 'unu'unu bediaka,",{"text":"‘Esi'avana vaika!","poem":1},{"lineBreak":true},{"text":"Esi'avana vaika, Vanua namana e,","poem":1},{"lineBreak":true},{"text":"maieta aunakoi 'atuai deveau","poem":1},{"lineBreak":true},{"text":"kauta boutai ena lovia davatai","poem":1},{"lineBreak":true},{"text":"lavo kautai de'ao,","poem":1},{"lineBreak":true},{"text":"melala koana ka'onamo laloanai","poem":1},{"lineBreak":true},{"text":"ia 'eva 'ani eole.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Vutuvutu e. Lalonama!","poem":1},{"lineBreak":true},{"text":"Olalonama,","poem":1},{"lineBreak":true},{"text":"Dilava ena kabukabu kaumui,","poem":1},{"lineBreak":true},{"text":"mai veauneke kaumui,","poem":1},{"lineBreak":true},{"text":"mai enolea kaumui!","poem":1},{"lineBreak":true},{"text":"Evavaimui si'asi'a 'ounai","poem":1},{"lineBreak":true},{"text":"Dilava ia mekau evakoala.’”","poem":1}]},{"type":"verse","number":21,"content":["Inoku anelu kula'ilana ka eta'u bika'a 'otoina nama vaikana ka eabia isi 'atu laloanai ekapoa uku inoku ediaka,",{"text":"“Kanania boina vitaitanai","poem":1},{"lineBreak":true},{"text":"Babulonia vanua namana","poem":1},{"lineBreak":true},{"text":"'atu laloanai bekapoa uku,","poem":1},{"lineBreak":true},{"text":"inoku sia bedavalia 'udai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Oni emuai 'eva,","poem":1},{"lineBreak":true},{"text":"Kita vana 'apa demonevai kauta","poem":1},{"lineBreak":true},{"text":"mai masi kauta, siau","poem":1},{"lineBreak":true},{"text":"mai bisi uvani kauta 'uluta","poem":1},{"lineBreak":true},{"text":"sia 'ani ika 'udai beao.","poem":1},{"lineBreak":true},{"text":"Vinaula edeata edeata kauta","poem":1},{"lineBreak":true},{"text":"sia ka 'ani idavali 'udai beao.","poem":1},{"lineBreak":true},{"text":"Iani ivakali mukamukata","poem":1},{"lineBreak":true},{"text":"'uluta sia ka vaka","poem":1},{"lineBreak":true},{"text":"'ani ika 'udai beao.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Lamepa 'ailalana sia ka emuai","poem":1},{"lineBreak":true},{"text":"'ani beani 'udai.","poem":1},{"lineBreak":true},{"text":"Kamoane makamaka kauna","poem":1},{"lineBreak":true},{"text":"mai ateatena leleta","poem":1},{"lineBreak":true},{"text":"emuai sia 'ani beika 'udai.","poem":1},{"lineBreak":true},{"text":"Dava katania bepupulu","poem":1},{"lineBreak":true},{"text":"'olana emu tavatava kauta 'eva","poem":1},{"lineBreak":true},{"text":"kanobatai kau namata deao,","poem":1},{"lineBreak":true},{"text":"mai emu menai 'eva","poem":1},{"lineBreak":true},{"text":"kanobata boutai olebata.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Babulonia vanua namana","poem":1},{"lineBreak":true},{"text":"anaana eabia 'olana 'eva","poem":1},{"lineBreak":true},{"text":"ia laloanai 'eva enolea kauta","poem":1},{"lineBreak":true},{"text":"mai Dilava ena kabukabu kauta","poem":1},{"lineBreak":true},{"text":"lalata dedavalita,","poem":1},{"lineBreak":true},{"text":"mai kanobatai deaku bata kauta","poem":1},{"lineBreak":true},{"text":"boutai lalata vaka.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nrz_nar/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nrz_nar/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nrz_nar/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}