{"translation":{"id":"nrz_nar","name":"Luva'ana'i Namana Makamakana","website":"https://ebible.org/Scriptures/details.php?id=nrz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nrz","licenseNotes":null,"shortName":"NAR","englishName":"Nara NT","language":"nrz","textDirection":"ltr","sha256":"3415e38577d2acdc1f7e6da84f7e04ca2871090577e079bf5c0c4408673c9aec","availableFormats":["json"],"listOfBooksApiLink":"/api/nrz_nar/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7957,"languageName":"Lala","languageEnglishName":"Lala"},"book":{"id":"REV","translationId":"nrz_nar","name":"Ivala'asina","commonName":"Ivala'asina","title":"Keliso Ena Luva IVALA'ASINA Ioane Kevanai","order":66,"numberOfChapters":22,"sha256":"2df2dbe6a8d32d0873a3df6288ca0a9b2781e5f8c0f6bff6dc2a97aaf1b2d26c","firstChapterNumber":1,"firstChapterApiLink":"/api/nrz_nar/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/nrz_nar/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":7,"content":[{"type":"heading","content":["Dilava Ena Da'alaabi Kauta Sinavu Boutai Sinavu Ka Vaninavui Vani (144,000) Ba'utai Loi Deabi."]},{"type":"verse","number":1,"content":["Kanaua mulinai anelu vani kanobata 'unipuata vani delavata avu aikata, kanobata ena lani vani deabita kao, sia lani ka kanoai 'o 'atuai be'unu 'o au ka bevivua."]},{"type":"verse","number":2,"content":["Inoku anelu edeana ka vaka dae duasi ele'au easi aikaia, mauli Dilavana ena koa i'ulena davana eabia. E'ae lao 'unu'unu anelu vani kataua Dilava eta'u siavu evenita kanobata mai 'atu bevasi'avanata aneluta e'outa ediaka,"]},{"type":"verse","number":3,"content":["“Oi kanobata 'o 'atu 'o au sia oi bovasi'avanata beda'amo eta Dilava ena da'alaabi kauta ba'utai koa i'ulena davana lai bane'ea.”"]},{"type":"verse","number":4,"content":["Inoku koa i'uleta davata deabi kauta devakuta leleta aika 'eva da boutai sinavu ka sinavu vaninavui vani (144,000), ia boutai 'eva Isalaela iduvuna 'ouka lua etai deasi."]},{"type":"verse","number":5,"content":[{"text":"Iuda iduvuna kauta kataua koa i'uleta davata deabita kauta 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000),","poem":1},{"lineBreak":true},{"text":"Lubena iduvunai 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000),","poem":1},{"lineBreak":true},{"text":"Kado iduvunai 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000),","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Asele iduvunai 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000),","poem":1},{"lineBreak":true},{"text":"Napatali iduvunai 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000),","poem":1},{"lineBreak":true},{"text":"Manase iduvunai 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000),","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Simeona iduvunai 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000),","poem":1},{"lineBreak":true},{"text":"Levi iduvunai 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000),","poem":1},{"lineBreak":true},{"text":"Isakala iduvunai 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000),","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sebuluna iduvunai 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000),","poem":1},{"lineBreak":true},{"text":"Iosepa iduvunai 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000),","poem":1},{"lineBreak":true},{"text":"mai Beniamina iduvunai 'eva","poem":1},{"lineBreak":true},{"text":"da boutai 'ouka lua (12,000).","poem":1}]},{"type":"heading","content":["Kau Mato Namavaikana Tubu'ata Deva'ita Devadodo Dilava Dekukudivo Venia."]},{"type":"verse","number":9,"content":["Dava katania mulitai akailao 'eva kau mato namavaikana sia kau ka bemavakuta bemadaia, kanobata ka ka ai, iduvu ka ka ai, kau edeata edeata mai lele edeata edeata, lovia imia'auna 'abuna vailanai mai Mamoe nakuna vailanai delava aikata. Ia 'eva tubu'a deva'ita lakavaikata devadodo mai imatai 'eva vakolo uauata deabi."]},{"type":"verse","number":10,"content":["Inoku devaoi 'unu'unu dediaka,",{"text":"“Vamauli 'eva eta Dilava,","poem":1},{"lineBreak":true},{"text":"lovia imia'auna 'abunai","poem":1},{"lineBreak":true},{"text":"emia'au kauna,","poem":1},{"lineBreak":true},{"text":"mai Mamoe nakuna","poem":1},{"lineBreak":true},{"text":"etai e'asi.”","poem":1}]},{"type":"verse","number":11,"content":["Anelu boutai 'eva lovia imia'auna 'abuna, 'aida'aidata kauta mai mauli davata vani delavata kaiu. Mai Lovia imia'auna 'abuna vailanai dekuidula vailata kua eda'aia inoku Dilava dekukudivo venia,"]},{"type":"verse","number":12,"content":["dediaka,",{"text":"“Amen!","poem":1},{"lineBreak":true},{"text":"Akuabalai, nuavi, nuakomolo,","poem":1},{"lineBreak":true},{"text":"vanama'ina luvata, 'olaaku,","poem":1},{"lineBreak":true},{"text":"siavu mai kula'ila 'eva","poem":1},{"lineBreak":true},{"text":"eta Dilava enai bemia keini keini.","poem":1},{"lineBreak":true},{"text":"Amen.”","poem":1}]},{"type":"verse","number":13,"content":["Inoku 'aida'aidata kauna ka elavuai'u ediaka, “Tubu'a laka'ita deva'ita devadodota kauta katania 'eva kau davata? Maivaka a'ia'i de'asi?”"]},{"type":"verse","number":14,"content":["Lau ena luva avamuea adiaka, “Loviamu e, oni oikabasi.” Inoku e'ou'u ediaka, “Kau katania 'eva anaana namavaikana laloanai dela'asi deasi kauta, ia eta tubu'a laka'ita 'eva Mamoe nakuna lalanai 'ani dedeinita inoku devadeva'ita."]},{"type":"verse","number":15,"content":["Kanaua dainai,",{"text":"ia 'eva Dilava ena lovia imia'auna 'abuna vailanai delalava,","poem":1},{"lineBreak":true},{"text":"inoku ena luma kabukabuna laloanai boni mai lani","poem":1},{"lineBreak":true},{"text":"ia da'alana de'abi.","poem":1},{"lineBreak":true},{"text":"Inoku lovia imia'auna 'abuna","poem":1},{"lineBreak":true},{"text":"akanai emia'au Dilavana 'eva ena","poem":1},{"lineBreak":true},{"text":"aiole ai bevaaota akatai beva'auta.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ia 'eva sia bevikolo kovo,","poem":1},{"lineBreak":true},{"text":"sia vei bata beba kovo.","poem":1},{"lineBreak":true},{"text":"Melala siavuna sia bekalata 'o","poem":1},{"lineBreak":true},{"text":"sia siavu davata ka bevalo'olo'ota.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"'Olana Mamoe nakuna lovia","poem":1},{"lineBreak":true},{"text":"imia'auna 'abuna bo'adanai","poem":1},{"lineBreak":true},{"text":"emimia 'eva ia beikata kao itani","poem":1},{"lineBreak":true},{"text":"mamoe i'imata kauna boina,","poem":1},{"lineBreak":true},{"text":"ia betata'u be'ana'ia vaita","poem":1},{"lineBreak":true},{"text":"bedada'a mauli veina","poem":1},{"lineBreak":true},{"text":"ebubudi kevanai,","poem":1},{"lineBreak":true},{"text":"inoku Dilava betata'u ilulu","poem":1},{"lineBreak":true},{"text":"makata boutai makatai","poem":1},{"lineBreak":true},{"text":"beukuta ovo.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nrz_nar/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nrz_nar/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nrz_nar/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}