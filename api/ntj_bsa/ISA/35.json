{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"ISA","translationId":"ntj_bsa","name":"Yatjayaku Tjukurrpa","commonName":"Yatjayaku Tjukurrpa","title":"Yatjayaku Tjukurrpa","order":23,"numberOfChapters":13,"sha256":"df03942dbff912c1c722c18a4ee3ed8f7b3e31764a38a1f974b73718970cf515","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/ntj_bsa/ISA/61.json","totalNumberOfVerses":116},"chapter":{"number":35,"content":[{"type":"heading","content":["Ngurra Yayilurru Walykumunurriku Ngarama"]},{"type":"verse","number":1,"content":[{"text":"Nyangka ngurra nyarra yayilurru ngaralanytja,","poem":1},{"text":"palunyanya pukurlarriku kapi purlkanya punkannyangka,","poem":2},{"lineBreak":true},{"text":"tjiinyamarntu yitjarnu purlkanya ngarama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yukiri purlkanya yirnuntjitarrartu ngarama.","poem":1},{"text":"Nyangka-ya yarnangu pirnilutarrartu-ya pukurltu mirrawarnima.","poem":2},{"text":"Palunyangka warta wirrmira tjultjulpa ngarama,","poem":1},{"text":"ngurra nyarra Lapananta tjultjulpa ngarapayi, palunyapirinypa.","poem":2},{"text":"Nyangka-ya mirrka purlkanya kaatanpangka kanyinma,","poem":1},{"text":"ngurra nyarra Kaamulta Tjarantatarrartu-ya mirrka purlkanya kanyira, palunyapirinypa.","poem":2},{"text":"Nyangka-ya pirnilu nintilu kulilku","poem":1},{"text":"tjiinya Mama Kuurrtu yayirninytjulu ngurra kutjupanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nyangka-tjinguru-ya mara patalypa nyinarra puru murtitarrartu tiltirrmankupayi,","poem":1},{"text":"puru kurrurnpa ngurlunytju-ngurlunytju nyinarra.","poem":2},{"text":"Nyangka-tjananya watjala,","poem":1},{"lineBreak":true},{"text":"“Wiya, ngurlumaalpa-ya kurrurnpa rapa nyinama.","poem":1},{"lineBreak":true},{"text":"Mama Kuurrtu-tjananyanta pitjaku wankarura kanyinma.","poem":1},{"text":"Palunyalu-tjananya mirri pungkupayi pirninya ngaparrtjika pungku wiyalku.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nyangka-ya kurutjarra nyinapayilu kuru yarlarringkulalpi nyangama.","poem":1},{"text":"Puru-ya pinatjarra nyinapayilu pina yarlarringkulalpi kulinma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nyangka-ya wawanypa nyinapayi pirninya pakaralpi wuurlmara parrawirrtjanma.","poem":1},{"text":"Nyangka-ya purtu wangkapayi pirninya wangkatjarrarringkulalpi pukurlpa mirrama.","poem":2},{"text":"Nyangka kapi warla pilawana kukurrmanama.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Nyangka parna nyarra tjina kampapayinya","poem":2},{"lineBreak":true},{"text":"kutjuparrinyangka yirrala purlkanya ngarrima.","poem":2},{"text":"Nyangka parna nyarra kapimaalpa ngarapayinya","poem":1},{"text":"kutjuparringkulalpi kapi pirnitjarra ngarama.","poem":2},{"text":"Nyangka yirriya paka-pakaralpi parltju-parltjungka ngarama","poem":1},{"text":"ngurra nyarra ngupanu-ya kurranyulpi nyinapayingka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nyangka yiwarra walykumunu palunyangka ngarama.","poem":1},{"text":"Nyangka-ya tjapilku, “Mama Kuurrku yiwarra walykumununya.”","poem":2},{"text":"Nyangka-ya palyamunu palyalpayinya","poem":1},{"text":"yiwarra palunyangka kamu mapitjaku.","poem":2},{"text":"Tjiinya-ya tungun-tungunpa pirninya","poem":1},{"text":"yiwarra palunyawana mapitjakitjamunu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nyangka-ya layinpa ngupanu pirninyatarrartu","poem":1},{"text":"yiwarra palunyangka kamu mapitjaku.","poem":2},{"text":"Ngarna-ya yarnangu nyarra Mama Kuurrtu wankarnu","poem":1},{"text":"palunyanyakutju-ya yiwarra palunyangka mapitjaku.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mapitjalayilku-ya turlku pukurltu yinkarrayilku parratjarrpaku Tjurutjamala.","poem":1},{"text":"Palunyalu-ya pukurlpa tirtu nyinama.","poem":2},{"text":"Tjiinya-ya tjuni kartakatikitjamunu","poem":1},{"text":"pukurlpa nyinaku nyinama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/ISA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":9}