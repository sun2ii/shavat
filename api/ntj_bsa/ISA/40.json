{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"ISA","translationId":"ntj_bsa","name":"Yatjayaku Tjukurrpa","commonName":"Yatjayaku Tjukurrpa","title":"Yatjayaku Tjukurrpa","order":23,"numberOfChapters":13,"sha256":"df03942dbff912c1c722c18a4ee3ed8f7b3e31764a38a1f974b73718970cf515","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/ntj_bsa/ISA/61.json","totalNumberOfVerses":116},"chapter":{"number":40,"content":[{"type":"heading","content":["Mama Kuurrtu-lanyanta Mukulyanytjulu Kanyilpayi"]},{"type":"verse","number":1,"content":[{"text":"Mama Kuurrnga tjiinya pupakatirra-lan marninypungkupayilu watjarnu,","poem":1},{"text":"“Ngayuku-tju katja yurntalpirti-tjananya watjala pukurlmarra.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Walykumunulu-tjananya watjala yarnangu nyarra Tjurutjamala nyinapayi.","poem":1},{"text":"Ngaapirinypa-tjananya watjala,","poem":2},{"lineBreak":true},{"text":"‘Nyuntulu-yan palyamunu palyaranytja.","poem":2},{"text":"Nyangka-tjananyarnanta ngaparrtjika pika purlkanya yutirayirnu wiyarringu.","poem":1},{"text":"Palunyalu kuwarrinya-tjanamparnanku kalyparringkulalpi nyinarra.’”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tjiinya kutjupalu mirrarra watjara,","poem":1},{"lineBreak":true},{"text":"“Mayu-mayuwana-ya yiwarra tamarlmarra wanti Puurrku.","poem":1},{"text":"Yiwarra tjukarurru-ya palyala wanti Mama Kuurrku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Parna yapu wararrangkatja-ya tjutira-wanala lawuwanalu wanti.","poem":1},{"text":"Nyangkayi tjukarurru ngarama.","poem":2},{"text":"Parna-ya tjutira-wanala kakal-kakalwanalu wanti.","poem":1},{"text":"Nyangkayi tjukarurru ngarama.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nyangka Mama Kuurrku tili purlkanya yartakarriku.","poem":1},{"text":"Nyangka-ya yarnangu pirnilu nyaku.","poem":2},{"text":"Tjiinya Mama Kuurrtu watjarnu wantingu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yuwa, kutjupalu-rni watjarnu tjukurrpa-rna watjaltjaku.","poem":1},{"lineBreak":true},{"text":"Nyangka-rna tjapirnu, “Nyaapirinypa-rna watjalku?”","poem":1},{"lineBreak":true},{"text":"Nyangka-rni watjarnu ngaapirinypa watjaltjaku, “Yarnangu pirninya-lan yukiripirinypa.","poem":1},{"text":"Tjiinyakurlu yukiri ngara rawamaalpartu pikirriwa, palunyapirinypa.","poem":2},{"text":"Nyangka-lan puru yirnuntjipirinypartu nyinarra.","poem":1},{"text":"Tjiinyakurlu walykumunu ngaralalpi punkala wiyarriwa, palunyapirinypa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tjiinya Mama Kuurrtu watjannyangka","poem":1},{"text":"yukiri pikirriku puru yirnuntji punkalku wiyarriku.","poem":2},{"text":"Nyangka-lan palunyapirinypa nyinarra wiyarringama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yuwa, yukiri ngaraku pikirriku.","poem":1},{"text":"Nyangka yirnuntji punkalku wiyarriku.","poem":2},{"text":"Nyangka Mama Kuurrku wangka tirtu ngaraku ngarama.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yarnangu Tjurutjamanyamartatji pirni,","poem":1},{"text":"tjukurrpa walykumunu-ya mirrarra watjanma.","poem":2},{"text":"Purlingka-ya tatiralpi mirrarra watjanma.","poem":1},{"lineBreak":true},{"text":"Ngurlumaaltu-ya rapalu mirrarra watjanma,","poem":1},{"text":"“Mama Kuurrnga pitjalayirni.”","poem":2},{"text":"Nyangka-yayi yarnangu ngurra pirningkatjalu kulila, ngurra nyarra Tjuutalawana nyinarranytjalu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nyawa-ya. Mama Kuurrnga Puurrpa Purlkanya pitjalayirni.","poem":1},{"text":"Palunyalu-lanyanta puurrarringkulalpi kanyinma.","poem":2},{"lineBreak":true},{"text":"Palunyalu-lampa kutjupa-kutjupa walykumunu","poem":2},{"lineBreak":true},{"text":"nintilku katja yurntalpirtiku.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yuwa, Mama Kuurrtu-lanyanta katja yurntalpirti tjiipupirinypa miranykanyira katirrayinma.","poem":1},{"text":"Tjiinyakurlu tjiipu warlangu kurlunypa yampura katirrayinma.","poem":2},{"lineBreak":true},{"text":"Palunyalu-tjananya tjiipu ngunytju kurlunytjarra purinytju walara parrakatirrayinma.","poem":2},{"lineBreak":true},{"text":"Palunyapirinypa-lanya walara parrakatirrayinma.","poem":2}]},{"type":"heading","content":["Mama Kuurrtu-lanyanta Kanyira Patalymaalpa-lan Parrapitjalayiltjaku"]},{"type":"verse","number":27,"content":[{"text":"Yitjurayilku tjamupirti-yan tirtu watjalpayi,","poem":1},{"text":"“Wiya, yarnangu kutjupalu-lanyantaya kurraranyangka","poem":2},{"lineBreak":true},{"text":"Mama Kuurrtu-lanyanta kulira wantipayi.”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ngurrpa-munta-yan? Kulintjamaalpa-munta-yan?","poem":1},{"lineBreak":true},{"text":"Tjiinya Mama Kuurrnga kutjulpirtu nyinarranytja.","poem":1},{"text":"Palunyalu tirtu nyinaku nyinama.","poem":2},{"lineBreak":true},{"text":"Kutju-palunyalu parna yilkari palyarnu.","poem":2},{"text":"Palunyalu talypurringkulanytjamunu puru nyuurrukatirranytjamunu.","poem":1},{"text":"Yuwa, yarnangu pirnilu-lan purtu kulilpayi","poem":2},{"lineBreak":true},{"text":"tjiinya Mama Kuurrtu nintipukalu kuliranyangka.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nyangka-tjinguru-rna patalyarringkulalpi talypurriku.","poem":1},{"text":"Nyangka-rni Mama Kuurrtu walykumunulku.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tjiinya-ya yangupalatarrartu patalyarringkulalpi","poem":1},{"text":"punkalkutarrartu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nyangka-ya Mama Kuurrnga mularrkuliranytjalu patalyarrinytjatjanu walykumunurriku.","poem":1},{"text":"Palunyalu-ya patalymaalpa tirtu parrapitjalayinma.","poem":2},{"text":"Tjiinyakurlu-ya warlawurru patalymaalpa yilkaringka tirtu parrapitjalayinma.","poem":1},{"text":"Palunyapirinypa-ya Mama Kuurrnga mularrkuliranytjalu","poem":2},{"lineBreak":true},{"text":"talypumaalpa kukurrpa parrapitjalayinma.","poem":2},{"lineBreak":true},{"text":"Puru-ya patalymaalpa tirtu parrawirrtjarayinma.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/ISA/35.json","previousChapterAudioLinks":{},"numberOfVerses":16}