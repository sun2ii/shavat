{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"ISA","translationId":"ntj_bsa","name":"Yatjayaku Tjukurrpa","commonName":"Yatjayaku Tjukurrpa","title":"Yatjayaku Tjukurrpa","order":23,"numberOfChapters":13,"sha256":"df03942dbff912c1c722c18a4ee3ed8f7b3e31764a38a1f974b73718970cf515","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/ntj_bsa/ISA/61.json","totalNumberOfVerses":116},"chapter":{"number":42,"content":[{"type":"heading","content":["Mama Kuurrku Waarka Palyalpayinya"]},{"type":"verse","number":1,"content":["Mama Kuurrtu watjarnu,",{"text":"“Ngaanya-tju ngayuku waarka palyalpayinya.","poem":1},{"text":"Ngayulu-rnalu ngurrkarntanu wantingu.","poem":2},{"lineBreak":true},{"text":"Palunyalu-rna tirtu miranykanyira.","poem":2},{"lineBreak":true},{"text":"Palunyalu-rna tirtu pukurltu nyakula.","poem":2},{"text":"Kuurti Walykumununya-rnalu tjarrpatjunu wantingu.","poem":1},{"lineBreak":true},{"text":"Nyangka-tjananya yarnangu pirninya ngurra kutjupa-kutjupangkatja walykumunulu kanyinma.","poem":1},{"text":"Nyangka-ya tjukarurru nyinama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tjiinya wati palunyanya lingkirrpa mirrakitjamunu.","poem":1},{"text":"Palunyalu karnany-karnanytju watjalkitjamunu pirnilu-ya kuliltjaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tjiinya nyaku-tjananya tjiinya-ya wanara punkaranyangka puntura watjalkitjamunu.","poem":1},{"lineBreak":true},{"text":"Palunyalu-tjananya nyaku kurltjirr-kurltjirrpa-ya nyinarranyangka payilkitjamunu wantiku.","poem":1},{"lineBreak":true},{"text":"Palunyalu-tjananya yarnangu pirninya walykumunulu kanyinma.","poem":1},{"text":"Nyangka-ya tjukarurru nyinama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tjiinya talypurringkula wantinytjamaaltu ngayuku waarka palyarayilku,","poem":1},{"text":"nyangka-ya manta lipingkatjanya tjukarurru nyinama.","poem":2},{"lineBreak":true},{"text":"Palunyatjanu-ya palunyaku wangkaku mukurringama.”","poem":2},"Palunyapirinypa Mama Kuurrtu watjarnu."]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":4}