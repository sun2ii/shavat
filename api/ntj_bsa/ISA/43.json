{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"ISA","translationId":"ntj_bsa","name":"Yatjayaku Tjukurrpa","commonName":"Yatjayaku Tjukurrpa","title":"Yatjayaku Tjukurrpa","order":23,"numberOfChapters":13,"sha256":"df03942dbff912c1c722c18a4ee3ed8f7b3e31764a38a1f974b73718970cf515","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/ntj_bsa/ISA/61.json","totalNumberOfVerses":116},"chapter":{"number":43,"content":[{"type":"heading","content":["Mama Kuurrtu-lanyanta Miranykanyira Kanyilpayi"]},{"type":"verse","number":1,"content":["Mama Kuurrtu-tjananya Yitjurayilku tjamupirti watjarnu,",{"text":"“Kulila-rniya. Ngayulu-tjananyarnanta lurrtjurnu","poem":1},{"text":"ngayuku katja yurntalpirti-yan nyinarratjaku.","poem":2},{"text":"Nyangka-ya ngurlumaalpa nyinama.","poem":1},{"text":"Ngayulu-tjananyarnanta wankarura kanyinma.","poem":2},{"text":"Tjiinya ngayulu-tjananyarnanta ngurrkarntaralpi yini tjapirnu.","poem":1},{"text":"Nyangka-tjuyan ngayuku nyinarra.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tjinguru-yan tjarrparra mapitjaku kapi warnanpa purlkanya kukurrmaranyangka.","poem":1},{"text":"Nyangka-tjananyarnanta ngayulu yirringkara kanyinma.","poem":2},{"lineBreak":true},{"text":"Nyangka-yan kapingka tjarrparra mirrirrikitjamunu.","poem":2},{"text":"Puru-yan warungka tjarrparra mapitjanyangka","poem":1},{"text":"kampakitjamunu-tjananyanta.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kutjulpirtu Mama Kuurrtu yiwarra palyarnu wantingu","poem":1},{"text":"kapi purlkanyawana-ya mapitjatjaku.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Palunyalu-tjananya warrmarla pirni wuyurrmanu","poem":1},{"text":"kapiwanalu-ya wanaltjaku.","poem":2},{"lineBreak":true},{"text":"Nyangka-ya purni kaarrtjarra tjarrpangu punkarnu mirrirringu.","poem":2},{"text":"Pirninyartu-ya tjarrparralpi palunya wiyarringu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Nyangka Mama Kuurrtu watjarnu,",{"text":"“Tirtu-kurlu-yan kulinma","poem":1},{"text":"nyarra kutjulpirtu ngarangu. Wanti-ya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nyangama-ya. Ngayulu-tjananyarnanta kuwarri-kuwarri kutjupa-kutjupa nintitjunku.","poem":1},{"text":"Yuwa, wiyangkalpi ngarala. Nyakula-munta-yan?","poem":2},{"text":"Ngayulu-tjanamparnanku yiwarra mayu-mayuwanalu palyara.","poem":1},{"text":"Puru-tjanamparnanku kapi pirni yartakanku.","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nyangka-rniya ngupanulu, karlayalutarrartu marninypungama.","poem":2},{"text":"Tjiinyamarntu kapi warla purlkanya pilawana kukurrmanama","poem":1},{"text":"ngayuku katja yurntalpirtilu-ya tjikiltjaku.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngayulu-tjananyarna lurrtjurnu","poem":1},{"text":"ngayuku katja yurntalpirti-ya nyinarratjaku.","poem":2},{"lineBreak":true},{"text":"Tjiinya-rniyayi yinkarra marninypungama.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":8}