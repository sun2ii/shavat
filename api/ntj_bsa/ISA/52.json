{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"ISA","translationId":"ntj_bsa","name":"Yatjayaku Tjukurrpa","commonName":"Yatjayaku Tjukurrpa","title":"Yatjayaku Tjukurrpa","order":23,"numberOfChapters":13,"sha256":"df03942dbff912c1c722c18a4ee3ed8f7b3e31764a38a1f974b73718970cf515","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/ntj_bsa/ISA/61.json","totalNumberOfVerses":116},"chapter":{"number":52,"content":[{"type":"heading","content":["Mama Kuurrku Waarka Palyalpayilu Pika Purlkanya Mantjirnu"]},{"type":"verse","number":13,"content":["Nyangka Mama Kuurrtu watjarnu,",{"text":"“Ngayuku-tju waarka palyalpayilu palyalku wiyalku","poem":1},{"text":"nyarra ngayulu-rna watjarnu wantinyangka.","poem":2},{"lineBreak":true},{"text":"Nyangka-luya yarnangu kutjupa-kutjupalu marninypungama.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yuwa, yarnangu pirnilu-ya nyakulalpi kata paarnarrarnu.","poem":1},{"text":"Tjiinyamarntu-ya pungkulayirnu wantinyangka yawarra pirnitjarra ngaralanytja.","poem":2},{"lineBreak":true},{"text":"Tjiinya kutjupa-kutjuparringkulalpi ngaralanytja.","poem":2},{"lineBreak":true},{"text":"Nyangka-ya purtu ngurrkarntaranytja.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nyangka kuwarrinya-ya yarnangu ngurra kutjupa-kutjupangkatjalu","poem":1},{"text":"wati palunyanya nyakulalpi kata paarnarralku.","poem":2},{"text":"Nyangka-ya puurrpa pirnilutarrartu kanmarrtu ngarala nyangama.","poem":1},{"text":"Tjiinya-ya kutjupa-kutjupa nyakula wantirranytjamunulu nyaku.","poem":2},{"lineBreak":true},{"text":"Puru-ya kutjupa-kutjupa kulira wantirranytjamunulu tjurrkurlmara kulilku.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":3}