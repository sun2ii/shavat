{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"ISA","translationId":"ntj_bsa","name":"Yatjayaku Tjukurrpa","commonName":"Yatjayaku Tjukurrpa","title":"Yatjayaku Tjukurrpa","order":23,"numberOfChapters":13,"sha256":"df03942dbff912c1c722c18a4ee3ed8f7b3e31764a38a1f974b73718970cf515","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/ntj_bsa/ISA/61.json","totalNumberOfVerses":116},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":["Nyangka-ya yarnangu pirnilu watjarnu,",{"text":"“Tjinguru-yan purtu mula-mularriku ngaapirinypa-latju watjaranyangka.","poem":1},{"text":"Tjinguru-yan purtu kulira tjiinya Mama Kuurrtu kutjulpirtu kulirnu ngarnmanymanu ngaapirinypa ngaratjaku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mama Kuurrtu waarka palyalpayi palunyanya ngalyawiturnu.","poem":1},{"text":"Parturtu-ya pirnilu nyangu purlkamunu nyinarranyangka.","poem":2},{"text":"Tjiinyakurlu warta kurlunypa pakala manta witu-witungka.","poem":1},{"text":"Nyangkakurlu-ya nyawa pawun-pawunpa pikirrikitja ngaralanyangka.","poem":2},{"text":"Palunyapirinypa-ya waarka palyalpayi palunyanya nyangu pawun-pawunpa mirrirrikitjapirinypa.","poem":1},{"lineBreak":true},{"text":"Wati palunyanya puurrpirinypa nyinarranytjamunu","poem":1},{"text":"Puru yiiku walykumunu nyinarranytjamunu.","poem":2},{"text":"Nyangka-lan nyakula wantirranytja mungutjakukantjalu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yarnangu pirnilu-ya yanyan-yanyantu wantingu.","poem":1},{"text":"Nyangka wati palunyalu pika purlkanya mantjirnu.","poem":2},{"text":"Nyangka-ya nyakukitjamunulu wantingu.","poem":1},{"text":"Nyangka-lan kulirnu wantingu purlkamunulkanyu nyinarranytja.","poem":2},{"text":"Ngurra-watjala purlkanya nyinarranytja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tjiinya wati palunyalu pika purlkanya mantjirnu","poem":1},{"text":"ngayulanguru-lanya.","poem":2},{"lineBreak":true},{"text":"Nyangka-lan kulirnu Mama Kuurrtu-ra pika yutirnu palyamunu palyannyangka, palunyakukantja.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wiya, wati palunyalu pika purlkanya mantjirnu","poem":1},{"text":"tjiinyamarntu ngayulu-lan kutjupa-kutjupa palyamunu palyarnu palunyangka.","poem":2},{"text":"Wati palunyanya-ya pika purlkanya pungkulanytja.","poem":1},{"text":"Palunyangka-lan pikatjarra nyinanytjatjanu walykumunurringu nyinarra.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngayulu-lan tjiipupirinypa kawarnarrara kutipitjangu.","poem":1},{"text":"Pinkurraara-lan yungarra kutipitjangu yiwarra kutjupangka.","poem":2},{"text":"Tjinguru-lan ngayulu mirrirringama","poem":1},{"text":"kutjupa-kutjupa palyamunu palyaranytjatjanulu.","poem":2},{"text":"Ngarna Mama Kuurrtu watjarnu wati palunyanya mirrirritjaku,","poem":1},{"text":"tjiinyamarntu-lan kutjupa-kutjupa palyamunu palyaranytja palunyangka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tjiinya-ya wati palunyanya lingkirrtu pungkulanytja.","poem":1},{"text":"Nyangka kanmarrpa ngaralanytja.","poem":2},{"text":"Tjiinyakurlu-ya tjiipu warlangu kati ngaratjurra mirri pungkukitjalu.","poem":1},{"text":"Nyangka kanmarrpa ngarama, palunyapirinypa.","poem":2},{"text":"Nyangkakurlu tjiipu kanmarrpa ngarama","poem":1},{"text":"purrmu katapungkukitjangka, palunyapirinypa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tjiinya-ya kunpu-kunpu kuurrpangka mirritjunkulalpi","poem":1},{"text":"mantjira makatingu mirri pungkukitjalu.","poem":2},{"lineBreak":true},{"text":"Tjiinya-ra kutjupa ngarltuwangkanytjamunu wiyartu.","poem":2},{"text":"Nyangka-ya pungu mirrirntanu","poem":1},{"text":"tjiinyamarntu ngayuku yungarrapirtilu-ya kutjupa-kutjupa palyamunu palyaranyangka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nyangka-ya mirri katingu tjarrpatjunu","poem":1},{"text":"wati nyarra tjimarri purlkanyatjarraku pulpangka.","poem":2},{"text":"Tjiinya wati palunyalu kutjupa-kutjupa palyamunu palyaranytjamunurtu.","poem":1},{"text":"Puru kutjuwarra mayuranytjamunu.","poem":2},{"text":"Nyangka mirrirrinyangka-ya palyamunu palyalpayi pirniku tjuulwanalu tjarrpatjunu.”","poem":1},"Palunyapirinypa-ya watjarnu."]},{"type":"line_break"},{"type":"verse","number":10,"content":["Nyangka Mama Kuurrtu watjarnu,",{"text":"“Ngayulu-rna kutjulpirtu watjarnu","poem":1},{"text":"wati palunyanya pika mantjira mirrirritjaku,","poem":2},{"lineBreak":true},{"text":"tjiinya yarnangu palyamunu pirniku-tjanampa yangarrakatirra mirrirritjaku.","poem":2},{"text":"Nyangka wati palunyalu nyaku palunyaku tjamu kaparlipirti.","poem":1},{"text":"Palunyalu rawa nyinarra-wanarayinma.","poem":2},{"text":"Wati palunyalu pirninyartu palyalku wiyalku","poem":1},{"text":"nyarra ngayulu-rnalu watjarnu wantitjanya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tjiinya wati walykumununya kunkanypa nyinarranytjatjanu","poem":1},{"text":"mirrirringu yarnangu palyamunu pirniku.","poem":2},{"lineBreak":true},{"text":"Palunyangka ngayulu-tjanamparna kalyparriku.","poem":2},{"text":"Palunyangka wati palunyalu nyakulalpi pukurlarriku.","poem":1},{"lineBreak":true},{"text":"Palunyalu kulilku, ‘Yuwa, palya-rna pika purlkanya mantjirnu mirrirringu.","poem":1},{"text":"Nyangka Mamanya-tjanampa kalyparringu.’”","poem":2}]},{"type":"verse","number":12,"content":["Puru Mama Kuurrtu watjarnu,",{"text":"“Ngayulu-rnara kutjupa-kutjupa walykumunu nintilku.","poem":1},{"text":"Palunyalu-rnalu nyinatjunku puurrpa purlkanya nyinarratjaku.","poem":2},{"text":"Tjiinya yarnangu pirnilu-ya kuliranytja","poem":1},{"text":"wati palunyanya palyamunu nyinarranytja, palunyakukantjalu.","poem":2},{"text":"Wiya, yarnangu palyamunu pirniku-tjanampa yangarrakatingu mirrirringu.","poem":1},{"text":"Palunyalu-tjanampa tjapiranytja ngayulu-rna kalyparritjaku.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}