{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"ISA","translationId":"ntj_bsa","name":"Yatjayaku Tjukurrpa","commonName":"Yatjayaku Tjukurrpa","title":"Yatjayaku Tjukurrpa","order":23,"numberOfChapters":13,"sha256":"df03942dbff912c1c722c18a4ee3ed8f7b3e31764a38a1f974b73718970cf515","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/ntj_bsa/ISA/61.json","totalNumberOfVerses":116},"chapter":{"number":55,"content":[{"type":"heading","content":["Mama Kuurrtu-tjananya Watjarnu Walykumunura Kanyilkitjalu"]},{"type":"verse","number":1,"content":["Nyangka Mama Kuurrtu-tjananya palunyaku katja yurntalpirti nyarra Papulanta nyinarranytjanya ngaapirinypa watjarnu,",{"text":"“Kapitjirratja-munta-yan nyinarra?","poem":1},{"text":"Wiya, pitja-ya tjikila kapi purlkanya ngaanya ngarrirranyangka.","poem":2},{"text":"Tjinguru-yan tjimarri wiya nyinarra.","poem":1},{"text":"Wiya, pitja-ya mirrka pirninya mantjiralpi ngala.","poem":2},{"text":"Pitja-ya wayinpa, miilki mantjiralpi tjikila,","poem":1},{"text":"tjimarri nintintjamaaltu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nyaaku-yan tjimarri tirtu wiyara mirrka palyamunungka?","poem":1},{"text":"Waarka purlkanya-yan palyara.","poem":2},{"lineBreak":true},{"text":"Palunyalu parltjamaalpa tirtu nyinarra.","poem":2},{"text":"Pina yarlarringkulalpi-rniya kulila.","poem":1},{"text":"Palunyalu-yan mirrka walykumunu pukurltu ngalkuma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pina yarlarringkulalpi-rniya kulila.","poem":1},{"text":"Ngayulakutu-rniya pitja wanka nyinakitjalu.","poem":2},{"text":"Palunyalu-tjananyarnanta kalkulku wantiku","poem":1},{"text":"walykumunura tirtu kanyilkitjalu.","poem":2},{"text":"Tjiinya-rna puurrpa Tayipirrnga kutjulpirtu kalkurnu wantingu","poem":1},{"text":"walykumunura kanyilkitjalu, palunyapirinypa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tjiinya-rnalu Tayipirrnga puurrpa nyinatjunu wantingu","poem":1},{"text":"yarnangu kutjupa-kutjupa pirniku.","poem":2},{"text":"Nyangka-ya puurrpa palunyanya nyakulalpi","poem":1},{"text":"ngayukutarrartu-ya nintirringu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yuwa, tjiinya-yan yarnangu kutjupa-kutjupa maliki pirninya yarltiku.","poem":1},{"text":"Nyangka-ya kukurrpa pitja-pitjama lurrtjurringkukitja.","poem":2},{"text":"Ngayulu-rna Mama Kuurrnga tjukarurru nyinapayinya","poem":1},{"text":"tjiinya Yitjurayilku tjamupirti-yan pupakatirra marninypungkupayinya.","poem":2},{"text":"Palunyalu-tjananyarna wuyurrmanku nyuntulakutu-ya pitjatjaku.","poem":1},{"text":"Palunyalu-tjananyarnanta nyinatjunku puurrpirinypa-yan nyinarratjaku.”","poem":2},"Palunyapirinypa Mama Kuurrtu watjarnu."]},{"type":"heading","content":["Mama Kuurrku Wangka Walykumunu"]},{"type":"verse","number":6,"content":[{"text":"Pinkurraala-ya Mama Kuurrtakutu pitja tjiinya-tjananyanta watjaranyangka.","poem":1},{"text":"Tjiinya ngamurringu ngaralanyangka-ya tjapila.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kutjupa-kutjupa palyamunu-ya palyaranytjatjanu wanti.","poem":1},{"text":"Puru-ya kutjupa-kutjupa palyamunu kuliranytjalu wanti.","poem":2},{"text":"Palunyatjanu-ya marlaku pitja Mama Kuurrtakutu.","poem":1},{"text":"Nyangka-tjanampankuyi ngarltunytju purlkanya waarrpungkulalpi kalyparriwa.","poem":2}]},{"type":"verse","number":8,"content":["Nyangka Mama Kuurrtu ngaapirinypa watjaranytja,",{"text":"“Nyuntulu-yankun yungarralu kulilpayi.","poem":1},{"text":"Nyangka-rna ngayulu kutjupartu kulilpayi.","poem":2},{"text":"Nyuntulu-yankun yara yungarra wanalpayi.","poem":1},{"text":"Nyangka ngayuku-tju yara kutjupartu ngarala.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tjiinya yilkari katu mularrpa ngarala.","poem":1},{"text":"Nyangka-yan parnangurulu purtu nyakula.","poem":2},{"text":"Palunyapirinytju-yan ngayuku yara purtu kulira.","poem":1},{"text":"Tjiinyamarntu nyuntuku yarangka munkarra ngarala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngayuku-tju wangka kapipirinypa.","poem":1},{"text":"Tjiinyakurlu kapi yilkaringuru tjutima, palunyapirinypa.","poem":2},{"lineBreak":true},{"text":"Tjiinya yarlaku punkalkitjamunu.","poem":2},{"text":"Kapi punkalku wantinyangka mirrka pakalpayi.","poem":1},{"text":"Nyangka-ya yurninypa purlkanya yurralpayi","poem":2},{"lineBreak":true},{"text":"ngalkukitjalu puru mantangka tjunkukitjalu.","poem":2},{"text":"Tjiinya yarlaku punkalkitjamunu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nyangka-tju ngayuku wangka kapipirinypa ngarala.","poem":1},{"text":"Tjiinya-rna yarlaku watjalkitjamunu.","poem":2},{"text":"Tjiinya ngayulu-rna watjaranyangka kutjupa-kutjupa yartakarripayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yuwa, nyuntulu-yan ngurra nyarra Papulannga wantirra","poem":1},{"text":"pukurlpa kutipitjaku ngurra yungarrakutu.","poem":2},{"lineBreak":true},{"text":"Nyangka-tjananyantaya kalypalu ma-wanarayilku wantiku kutipitjanyangka-yan.","poem":2},{"text":"Nyangka purli purlkalu puru purli kurluny-kurlunypa pirnilu-tjananyanta","poem":1},{"text":"nyakula pukurltu turlku yinkama.","poem":2},{"text":"Nyangka-ya warta pirnilu-tjananyanta nyakula-wanarayilku","poem":1},{"text":"pukurltu-yanku mara pungama.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nyangka-ya warta walykumunu pirni paka-pakaralpi","poem":1},{"text":"tjultjulpa ngarama tjiinya tjilka-tjilka purlkanya ngarapayingka.","poem":2},{"text":"Nyangka-ya yarnangu pirnilu nyaku warta palunyanya tirtu ngaralanyangka","poem":1},{"text":"kulilku tjiinya-rna Mama Kuurrtu yayirninytjulu palyarnu.”","poem":2},"Palunyapirinypa Mama Kuurrtu watjarnu."]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":13}