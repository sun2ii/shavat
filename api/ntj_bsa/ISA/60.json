{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"ISA","translationId":"ntj_bsa","name":"Yatjayaku Tjukurrpa","commonName":"Yatjayaku Tjukurrpa","title":"Yatjayaku Tjukurrpa","order":23,"numberOfChapters":13,"sha256":"df03942dbff912c1c722c18a4ee3ed8f7b3e31764a38a1f974b73718970cf515","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/ntj_bsa/ISA/61.json","totalNumberOfVerses":116},"chapter":{"number":60,"content":[{"type":"heading","content":["Tjurutjamala Nyinapayi Pirnilu-ya Kuliltjaku"]},{"type":"verse","number":1,"content":[{"text":"Tjurutjamala nyinapayi pirni, kulila-ya.","poem":1},{"lineBreak":true},{"text":"Kurltjirr-kurltjirrpa-ya nyinarranytjamaalpa pakala nyawa","poem":1},{"text":"Mama Kuurrku tililu-tjananyanta yutira kanyiranyangka.","poem":2},{"text":"Nyangka-tjananyantayayi pirnilu nyawa","poem":1},{"text":"tjirntulupirinypa yirrnyaranyangka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yuwa, Mama Kuurrku tililu-tjananyanta yutira kanyinma.","poem":1},{"lineBreak":true},{"text":"Nyangka-ya yarnangu kutjupa-kutjupa mungalurrta nyinarra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Palunyalu-ya tili nyakula nyuntulakutu-tjananyanta wirrtjalku.","poem":1},{"text":"Puurrpa pirnilutarra-ya nyakula wirrtjalku","poem":2},{"lineBreak":true},{"text":"nyuntulawana-tjananyanta pirlpirlarrarnu-wanarayinnyangka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Parranyawa-ya.","poem":1},{"lineBreak":true},{"text":"Yarnangu pirninya-ya lurrtjurringu-lurrtjurringu ngurrakutu pitjalayirni.","poem":1},{"text":"Nyuntuku-tjanampanku katjapirti tiwanguru pitjalayirni.","poem":2},{"lineBreak":true},{"text":"Yuwa, yurntalpatarrartu-ya lurrtju pitjalayirni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nyangka-yan nyakulalpi kurrurnpa pukurlarriku.","poem":1},{"lineBreak":true},{"text":"Tjiinyamarntu-ya yarnangu nyarra lurrtju pitjalayintjalu yulytja pirni katiku.","poem":1},{"text":"Kapingka munkarranguru-ya katiku-tjanampanku nintilku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":5}