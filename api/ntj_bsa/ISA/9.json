{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"ISA","translationId":"ntj_bsa","name":"Yatjayaku Tjukurrpa","commonName":"Yatjayaku Tjukurrpa","title":"Yatjayaku Tjukurrpa","order":23,"numberOfChapters":13,"sha256":"df03942dbff912c1c722c18a4ee3ed8f7b3e31764a38a1f974b73718970cf515","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/ntj_bsa/ISA/61.json","totalNumberOfVerses":116},"chapter":{"number":9,"content":[{"type":"heading","content":["Puurrpa Walykumunu Ngula Nyinama"]},{"type":"verse","number":1,"content":["Kutjulpirtu-ya yarnangu pirnilu kuliranytja ngurra nyarra Kalalinya palyamunu ngaralanytja. Tjiinya-ya Tjipulanku tjamu kaparlipirti puru Natjaliku tjamu kaparlipirti ngurra palunyangkartu nyinarranytja. Nyangka-ya pirnilu kulilpayi ngurra palyamunu. Palunyangka-ya ngula marlangkatja-marlangkatjalu marninypungkula watjanma, “Ngurra walykumunu.” Ngurra palunyanya lipi purlkanya ngarala kapi kantilywana pururtu kapi yini Tjuutantawana. Ngurra palunyangka-ya malikitarrartu nyinapayi."]},{"type":"verse","number":2,"content":["Nyangka-ya ngaapirinypa watjalku,",{"text":"“Yarnangu-ya mungalurrta nyinarranytjalu","poem":1},{"text":"nyangu tili purlkanya yirrnyaranyangka.","poem":2},{"text":"Munga purlkanyangka-ya purtu kuliranytja.","poem":1},{"text":"Nyangka-tjananya tili purlkalu yartakanu kanyira.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yuwa Mama Kuurr, nyuntulu-tjananyan miranykanyira kanyiranytja.","poem":1},{"text":"Nyangka-ya yarnangu pirnirringu.","poem":2},{"lineBreak":true},{"text":"Palunyangurunta-ya pukurltu marninypungkula.","poem":2},{"lineBreak":true},{"text":"Tjiinyakurlu-ya mirrka purlkanya yurraralpi pukurlpa nyinama, palunyapirinypa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tjiinya tjilku yirti-lampa ngarriku.","poem":1},{"text":"Mama Kuurrtu-lampa katja nintilku","poem":2},{"lineBreak":true},{"text":"puurrarringkula-lanyanta kanyiratjaku.","poem":2},{"text":"Nyangka-ya katja palunyanya yini pirni tjapinma,","poem":1},{"text":"“Yayirninytjulu watjalpayinya”,","poem":2},{"lineBreak":true},{"text":"“Mama Kuurrnga yayirninytjulu palyalpayinya”,","poem":2},{"lineBreak":true},{"text":"“Mamanya tirtu nyinapayinya”,","poem":2},{"lineBreak":true},{"text":"“Puurrpa rapara kanyilpayinya”.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nyangka puurrpa palunyalu yarnangu pirninyartu puurrarringkula kanyinma.","poem":1},{"text":"Nyangka-ya kurrurnpa rapa tirtu nyinama.","poem":2},{"text":"Puurrpa palunyanya Tayipirrta yarangka nyinama,","poem":1},{"text":"Tayipirrnga nyarra puurrpa kutjulpirtu nyinarranytja, palunyala yarangka.","poem":2},{"lineBreak":true},{"text":"Puurrpa palunyalu tjukarurru nyinarranytjalu yarnangu pirninya walykumunulu kanyinma.","poem":2},{"lineBreak":true},{"text":"Palunyalu puurrpa nyinarrayilku tirtu nyinaku nyinama.","poem":2},{"text":"Tjiinya Mama Kuurrnga tjiinya Yayirninytjulu Palyalpayilu","poem":1},{"text":"puurrpa palunyanya nyinatjunkulalpi tirtu nyakula kanyinma.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/ISA/6.json","previousChapterAudioLinks":{},"numberOfVerses":5}