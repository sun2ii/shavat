{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"JON","translationId":"ntj_bsa","name":"Tjawunanyatjarra","commonName":"Tjawunanyatjarra","title":"Tjukurrpa Tjawunanyatjarra","order":32,"numberOfChapters":4,"sha256":"de9790046708537694594528e5f561a6517f5374c1093d567289c9b3c3dd2ba2","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/ntj_bsa/JON/4.json","totalNumberOfVerses":44},"chapter":{"number":2,"content":[{"type":"heading","content":["Tjawunalu Kuka Kapingkatjaku Tjuninguru Mama Kuurrnga Marninypungkulanytja"]},{"type":"verse","number":1,"content":["Nyangka Tjawunalu kuka kapingkatjaku tjuninguru Mama Kuurrnga ngaapirinypa marninypungkula-lu watjaranytja,"]},{"type":"verse","number":2,"content":[{"text":"“Yuwa Puurr, kapingka mirrirrikitjalu-rnanta tjapirnu,","poem":1},{"text":"nyangka-rnin kuliralpi yirringkanu.","poem":2},{"text":"Mirrirrikitjalu-rnanta mirrangu watjarnu,","poem":1},{"text":"‘Wankala-rni!’","poem":2},{"lineBreak":true},{"text":"Nyangka-rnin kuliralpi wankarnu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tjiinya-rnin warningu kapi kaninytjarra tjarrpatjunu,","poem":1},{"text":"nyangka-rni kapi purlkanyalu tjuturnu kanyiranytja.","poem":2},{"text":"Nyangkan kapi purlkanya yurritjingaranyangka","poem":1},{"text":"tirtu-rni rulyupungkula kanyiranytja.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tjiinya-rna yarlaku kuliranytja","poem":1},{"text":"nyuntulu-rnin payira witura-wanarnu wantingu","poem":2},{"lineBreak":true},{"text":"tiwa-rna yankula nyinatjaku,","poem":2},{"text":"puru tjurrtju purlkanyangka","poem":1},{"text":"tjarrpanytjamaaltu wantitjaku.","poem":2},{"lineBreak":true},{"text":"Palunyakukantjalu-rna kuliranytja.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kapi kaninytjarra-rna tjarrpangu","poem":1},{"text":"ngita-ngitarringkulalpi purtu ngaalymaranytja.","poem":2},{"lineBreak":true},{"text":"Tjiinya kapilu-rni tjutura kanyiranytja.","poem":2},{"lineBreak":true},{"text":"Nyangka-rni yukiri kapingkatjalu kata karrpirnu kanyiranytja.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tjiinya-rna kapi kaninytjarra pitjalayirnu","poem":1},{"text":"yapu kaninytjarrangkatja pampurnu.","poem":2},{"text":"Palunyalu-rna kulirnu, ‘Wartalpitjanu-rna mirrirriku.","poem":1},{"text":"Palunyalu-rna marlaku pakalkitjamunu.’","poem":2},{"text":"Nyangka-rnin nyuntulu wankarnu pakaltjingarnu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yuwa Puurr, nguwanpa mirrirringkulalpi-rnanta tjapirnu","poem":1},{"text":"nyangka-rnin yilkaringuru kulirnu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nyangka kutjupatjarralu-ya yapu wartatarrartu","poem":1},{"text":"kunpu-kunpu pupakatirra marninypungkula.","poem":2},{"lineBreak":true},{"text":"Tjiinya-ya nyuntuku mula-mularringkutjamaalarringu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nyangka-rnanta ngayulu yinkaku marninypungku.","poem":1},{"text":"Kuka-rna pungku tililku tjunkulalpi nyuntuku nintilku.","poem":2},{"lineBreak":true},{"text":"Puru-rna kalkurnu wantitjalu palyalku.","poem":2},{"text":"Yuwa Mama Kuurr, nyuntulu kutjulun wankalpayi.”","poem":1},"Palunyapirinypa Tjawunalu marninypungkula watjaranytja."]},{"type":"verse","number":10,"content":["Nyangka Mama Kuurrtu kuka kapingkatja watjarnu Tjawunanya mantangka yulkapatjunkutjaku. Nyangka mularrpartu mapitjangu mantangka-lu yulkapatjunu."]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}