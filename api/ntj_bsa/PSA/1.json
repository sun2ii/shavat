{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"PSA","translationId":"ntj_bsa","name":"Turlku","commonName":"Turlku","title":"Turlku Pirninya","order":19,"numberOfChapters":11,"sha256":"e1388eb04c73964cd3e7b6ae89993022eefdcd17523ca25f0a6fd290ea1f83d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/PSA/1.json","lastChapterNumber":146,"lastChapterApiLink":"/api/ntj_bsa/PSA/146.json","totalNumberOfVerses":120},"chapter":{"number":1,"content":[{"type":"heading","content":["Mama Kuurrku Wangka Kuliranytjalu Warta Purlkurnpirinypa Nyinama"]},{"type":"verse","number":1,"content":[{"text":"Yuwa, yarnangu palyamunuku wangka-ya kulira nyinanytjamaaltu wantima.","poem":1},{"lineBreak":true},{"text":"Palunyalu-ya palyamunu pirningka yarangka wanarayintjamaaltu wantima.","poem":1},{"lineBreak":true},{"text":"Palunyalu-ya lurrtjurringkula nyinarranytjamaaltu wantima","poem":1},{"text":"Mama Kuurrnga-ya panypuratjarralu watjaranyangka.","poem":2},{"text":"Wiya, Mama Kuurrku wangka mukulyanytjulu-ya","poem":1},{"text":"karlarla mungangka pukurltu kulinma.","poem":2},{"text":"Yuwa, palunyapirinypa-yan tirtu nyinarranyangka","poem":1},{"text":"Mama Kuurrtu-tjananyanta walykumunura kanyinma.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yuwa, palunyapirinypa-yan nyinarranytjalu warta purlkurnpirinypa nyinama.","poem":1},{"text":"Tjiinyakurlu warta kapingkartu pakala mirrka purlkanya kanyinma, palunyapirinypa.","poem":2},{"text":"Palunyalu-yan kutjupa-kutjupa walykumunura palyanma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nyangka-ya yarnangu palyamunu tjanmarta minyarrapirinypa nyinama.","poem":1},{"text":"Tjiinyakurlu tjanmarta rurrmupungama. Nyangka pirriyalu minyarra katima, palunyapirinypa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tjiinya yarnangu palyamunu pirnilu-ya purtu kulilku","poem":1},{"text":"tjiinya Mama Kuurrtu yarnangu pirninya tjarraranyangka.","poem":2},{"text":"Tjiinya-tjananya yarnangu palyamunu pirninya tjarralku.","poem":1},{"text":"Palunyangka-ya purtu kulilku Mama Kuurrku yungarrapirtingka nyinakitjalu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nyangka-ya yarnangu nyarra yiwarra tjurrkurlwana mapitjalayirni,","poem":1},{"text":"palunyanya-tjananya Mama Kuurrtu miranykanyira kanyinma.","poem":2},{"text":"Nyangka yarnangu palyamunu pirninya-ya","poem":1},{"text":"mirrikutu mapitjalayirni yiwarra palyamunuwana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}