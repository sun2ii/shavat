{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"PSA","translationId":"ntj_bsa","name":"Turlku","commonName":"Turlku","title":"Turlku Pirninya","order":19,"numberOfChapters":11,"sha256":"e1388eb04c73964cd3e7b6ae89993022eefdcd17523ca25f0a6fd290ea1f83d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/PSA/1.json","lastChapterNumber":146,"lastChapterApiLink":"/api/ntj_bsa/PSA/146.json","totalNumberOfVerses":120},"chapter":{"number":100,"content":[{"type":"heading","content":["Turlku Ngaanya Yinkarra Mama Kuurrnga Marninypungkulatjaku"]},{"type":"verse","number":1,"content":[{"text":"Yarnangu pirni, Mama Kuurrnga-ya pukurltu marninypungama.","poem":1},{"lineBreak":true},{"text":"Ngurra kutjupa-kutjupangkatja pirni,","poem":1},{"text":"turlku-ya yinkarra Mama Kuurrnga marninypungama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yuwa, tjurrtjungka-ya turlku yinkarra tjarrpama.","poem":1},{"text":"Palunyalu Mama Kuurrnga pukurltu marninypungama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nintilu-yan kulira","poem":1},{"text":"Mama Kuurrnga Puurrpa Purlkanya nyinarranyangka.","poem":2},{"text":"Kutju-palunyalu-lampa tjamupirti lurrtjurnu","poem":1},{"text":"palunyaku katja yurntalpirti-ya nyinarratjaku.","poem":2},{"lineBreak":true},{"text":"Nyangka ngayulutarrartu-lan palunyaku nyinarra.","poem":2},{"text":"Ngayulu-lan Mama Kuurrku tjiipupirinypa nyinarra.","poem":1},{"text":"Nyangka-lanya katja yurntalpirti kurrurnkurlu kanyira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mapitja-ya tjurrtju kayirrpangka tjarrparralpi watjala,","poem":1},{"text":"“Mama, walykumunulu-lanyatjun miranykanyira kanyiranytja.”","poem":2},{"lineBreak":true},{"text":"Palunyatjanulu-ya tjurrtjungka ma-tjarrparralpi","poem":2},{"lineBreak":true},{"text":"Mama Kuurrnga marninypungkuma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yuwa, Mama Kuurrnga walykumunu mularrpa.","poem":1},{"text":"Palunyalu-lanya mukulyanytjulu miranykanyira kanyira.","poem":2},{"text":"Mama Kuurrtu-lanya tirtu kanyinma watjarnu wantinytjatjanulu.","poem":1},{"text":"Puru-tjananya katja yurntalpirti","poem":2},{"lineBreak":true},{"text":"marlangkatja-marlangkatjanya pakaranyangka miranykanyira kanyinma.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":5}