nintipukarringu nyinarra,","poem":2},{"lineBreak":true},{"text":"tjiinya nyalpa pirningka munkarra.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Yiwarra lipinya-rna wantipayi","poem":1},{"text":"tjiinya nyuntuku wangka wangarnarralu kulira palyalkitjalu.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Nyuntuku wangka-rna wantikitjamunu.","poem":1},{"text":"Nyuntulumarntu-rnin nintipungkulanyangka.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Nyuntuku wangka pukarapirinypa","poem":1},{"text":"tjiinya yirliltungka munkarra.","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Nyuntuku wangka kuliranytjatjanu-rna","poem":1},{"text":"nintipukarringu nyinarra.","poem":2},{"lineBreak":true},{"text":"Palunyalanguru-rna yiwarra nyarra lipiku yanyan-yanyanpa nyinarra.","poem":2}]},{"type":"heading","content":["Mama Kuurrku Wangka Tilipirinypa"]},{"type":"verse","number":105,"content":[{"text":"Yuwa Mama, nyuntuku wangka tilipirinypa","poem":1},{"text":"tjiinya yiwarra-tju pirntaltjingara kanyilpayi.","poem":2},{"text":"Nyuntuku wangka pirntal-pirntalpirinypa.","poem":1},{"text":"Nyangka-rna palunyatjarra tjukarurru mapitjalayilku parrapitjaku.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Nyuntuku wangka tjukarurru mularrpa ngarala.","poem":1},{"lineBreak":true},{"text":"Nyangka-rnanta watjarnu wantingu wangka palunyanya","poem":1},{"text":"wangarnarralu kulira palyalkitjalu.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Wiya, yarnangu pirnilu-rniya parrawanarayirni mirri pungkula tjunkukitjalu.","poem":1},{"lineBreak":true},{"text":"Palunyakutarra-rni wankarura kanyila,","poem":1},{"text":"tjiinya-rnin watjarnu wantitjalu.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Yuwa Mama, pukurlarriku-munta-tjun","poem":1},{"text":"tjiinya-rnanta marninypungkulanyangka?","poem":2},{"text":"Pukurlarrirralpi-rni nyuntuku wangka tirtu nintipungama.","poem":1}]},{"type":"verse","number":109,"content":[{"lineBreak":true},{"text":"Wiya, tirtu-rniya parrawanarayirni pungkula mirri tjunkukitjalu.","poem":1},{"text":"Nyangka nyuntuku wangkaku-rna watarrkurrikitjamunu.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Nyangka yarnangu palyamunu pirninya-ya mukurringkula piwarrtjingalkitjalu-rniya.","poem":1},{"text":"Parturtu-rna nyuntuku wangka wantikitjamunu.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Yuwa, nyuntulu-rnin wangka walykumunu nintirnu.","poem":1},{"text":"Nyangka-rnanku tirtu kanyilku kanyinma.","poem":2},{"text":"Tjiinya-rni wangka palunyalu tirtu pukurlmara kanyira.","poem":1}]},{"type":"verse","number":112,"content":[{"lineBreak":true},{"text":"Nyangka-rna wangarnarralu kulira palyarayilku ma-mirrirriku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":16}