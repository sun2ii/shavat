{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"PSA","translationId":"ntj_bsa","name":"Turlku","commonName":"Turlku","title":"Turlku Pirninya","order":19,"numberOfChapters":11,"sha256":"e1388eb04c73964cd3e7b6ae89993022eefdcd17523ca25f0a6fd290ea1f83d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/PSA/1.json","lastChapterNumber":146,"lastChapterApiLink":"/api/ntj_bsa/PSA/146.json","totalNumberOfVerses":120},"chapter":{"number":126,"content":[{"type":"heading","content":["Pukurlpa-ya Marlaku Pitjangu"]},{"type":"verse","number":1,"content":[{"text":"Mama Kuurrtu-lanyatju ngurra nyarra Papulantanguru marlakulu katingu Tjurutjamalakutu.","poem":1},{"text":"Palunyangka-latju kulirnu tjukurrtjuranytja-latju.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yikarringkula-latju pukurlpa mirrarranytja.","poem":1},{"text":"Nyangka yarnangu kutjupatjarralu-lanyatjuya tjumara watjaranytja,","poem":2},{"lineBreak":true},{"text":"“Mama Kuurrtu-tjanampa yayirninytjulu kutjupa-kutjupa palyarnu.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yuwa mularrpa Mama Kuurrtu-lampatju yayirninytjulu kutjupa-kutjupa yutirnu.","poem":1},{"text":"Nyangka-latju pukurlpa mularrpa nyinarranytja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yuwa Mama, yungarrapirti nyarra Papulanta-ya tirtu nyinarra,","poem":1},{"text":"palunyanya-tjananya marlakulu kati.","poem":2},{"lineBreak":true},{"text":"Nyangka-latjuyi pirni nyinama.","poem":2},{"text":"Tjiinyakurlu kapi punkannyangka warnanpa kukurrmanama karrungka, palunyapirinypa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yuwa Mama, nyawa-tjananya nyarra-ya yulatawarralu yurninypa pirni makatingu parnangka tjunkulanyangka.","poem":1},{"text":"Nyangkayi paka-pakannyangka mirrka purlkarriwa.","poem":2},{"lineBreak":true},{"text":"Nyangka-yayi ngula mirrka purlkanya yurraralpi pukurlpa pitjama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yuwa, yarnangu pirni nyarra yulatawarralu-ya yurninypa pirni makatingu mantangka tjunu.","poem":1},{"text":"Palunyatjinnga-ya nyinarrayilku ngula mirrka purlkanya yutirrinyangka mirratawarralu yurrara pukurltu katima.","poem":2},{"lineBreak":true},{"text":"Pukurl-pukurlpa-ya ngurrakutu pitjama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":6}