{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"PSA","translationId":"ntj_bsa","name":"Turlku","commonName":"Turlku","title":"Turlku Pirninya","order":19,"numberOfChapters":11,"sha256":"e1388eb04c73964cd3e7b6ae89993022eefdcd17523ca25f0a6fd290ea1f83d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/PSA/1.json","lastChapterNumber":146,"lastChapterApiLink":"/api/ntj_bsa/PSA/146.json","totalNumberOfVerses":120},"chapter":{"number":146,"content":[{"type":"heading","content":["Mama Kuurrnga-la Pukurltu Marninypungama"]},{"type":"verse","number":1,"content":[{"text":"Mama Kuurrnga-rna marninypungama.","poem":1},{"text":"Kurrurntutarrartu-rna Mama Kuurrnga marninypungama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Turlku yinkarra-rna Mama Kuurrnga marninypungama.","poem":1},{"lineBreak":true},{"text":"Marninypungkulayilku-rna ma-mirrirriku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kulilku-kurlu-yan mula-mularriku wati-ya puurrpa nyinarranyangka. Wanti-ya.","poem":1},{"text":"Tjiinyanta-ya yarnangulu wankalkitjamunu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tjiinya-ya mirrirringkulalpi marlaku mantarriku.","poem":1},{"text":"Nyangka ngarnmanymara-ya watjaranytjanya yutirrikitjamunu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mama Kuurrnga tjiinya Tjayikapalu pupakatirra marninypungkulanytja,","poem":1},{"text":"palunyalu-lanya yirringkankupayi tjiinya-lan mula-mularringkula kuliranyangka.","poem":2},{"lineBreak":true},{"text":"Nyangka palunyalanguru-la walykumunu nyinama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mama Kuurrtu manta yilkari puru kapi purlkanyatarrartu palyarnu,","poem":1},{"text":"puru kutjupa-kutjupa mantangkatja yilkaringkatja kapingkatjatarrartu nyinarranytjanya.","poem":2},{"lineBreak":true},{"text":"Palunyalu watjarnu wantitjatjanulu tjukarurrulu palyalpayi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mama Kuurrtu-tjananya yarnangu mungutja pirni yirringkankupayi","poem":1},{"text":"kutjupalu-tjananya kurrara kanyiranyangka.","poem":2},{"text":"Palunyalu nungkumunu pirniku mirrka nintilpayi.","poem":1},{"lineBreak":true},{"text":"Mama Kuurrtu tjayilpangka nyinarranytjanya walatjunkupayi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Palunyalu kurutjarra pirninya kuru yarlalpayi.","poem":1},{"lineBreak":true},{"text":"Nyangka-tjinguru kutjupanya punkannyangka","poem":1},{"text":"Mama Kuurrtu katura katirrayilpayi.","poem":2},{"text":"Palunyalu yarnangu nyarra tjukarurru-ya nyinapayinya","poem":1},{"text":"mukulyanytjulu kanyilpayi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mama Kuurrtu maliki pirninya miranykanyira kanyilpayi","poem":1},{"text":"ngurra kutjupanguru-ya pitjangu nyinarranyangka.","poem":2},{"text":"Puru Mama Kuurrtu-tjananya yirringkara kanyilpayi","poem":1},{"text":"tjiinya-ya minyma parnaltji puru tjilku wangulyara nyinarranyangka.","poem":2},{"text":"Palunyalu yarnangu nyarra palyamunu pirninya wiyalpayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nyangka Mama Kuurrnga puurrpa purlkanya tirtu nyinaku nyinama.","poem":1},{"lineBreak":true},{"text":"Yarnangu pirni, ngurra ngaa Yitjurayilta-yan nyinarra,","poem":1},{"text":"kulila-ya.","poem":2},{"text":"Mama Kuurrnga, tjiinya-yan pupakatirra marninypungkupayinya","poem":1},{"text":"puurrpa purlkanya tirtu nyinaku nyinama.","poem":2},{"text":"Nyangka-ya Mama Kuurrnga tirtu marninypungama.","poem":1},{"lineBreak":true},"Yuwa, palunya."]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":10}