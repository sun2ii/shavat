{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"PSA","translationId":"ntj_bsa","name":"Turlku","commonName":"Turlku","title":"Turlku Pirninya","order":19,"numberOfChapters":11,"sha256":"e1388eb04c73964cd3e7b6ae89993022eefdcd17523ca25f0a6fd290ea1f83d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/PSA/1.json","lastChapterNumber":146,"lastChapterApiLink":"/api/ntj_bsa/PSA/146.json","totalNumberOfVerses":120},"chapter":{"number":23,"content":[{"type":"heading","content":["Puurr, Nyuntulu-rnin Miranykanyira Kanyilpayi"]},{"type":"verse","number":1,"content":[{"text":"Yuwa Puurr, nyuntulu-rnin miranykanyira kanyilpayi.","poem":1},{"text":"Tjiinyakurlu watilu tjiipu miranykanyinma.","poem":2},{"lineBreak":true},{"text":"Palunyapirinytju-rnin miranykanyira kanyilpayi.","poem":2},{"text":"Nyangka-rna pirnipurlka kanyira","poem":1},{"text":"nyuntulu-tjun nintiranyangka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Patalypa-rna nyinarranyangka nyuntulu-rnin nyinatjunkupayi","poem":1},{"text":"yukiri walykumunungka.","poem":2},{"text":"Palunyalu-rnin walara katipayi","poem":1},{"text":"kapi warla walykumunukutu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kurltjirr-kurltjirrpa-rna nyinarranyangka","poem":1},{"text":"nyuntulu-rnin kurrurnpa yipilymara kanyilpayi.","poem":2},{"text":"Puru-rnin yiwarra tjukarurruwanalu walara katipayi,","poem":1},{"text":"tjiinyamarntu-rnin kalkurnu wantinytjatjanulu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kamu-rna ngurlurriku mirrirrikitja.","poem":1},{"text":"Tjiinyamarntu-lin lurrtjurtu yankulayirni.","poem":2},{"text":"Nyuntulu-rnin wartatjarralu paalytjura kanyilpayi.","poem":1},{"lineBreak":true},{"text":"Tjiinyakurlu tjiipu miranykanyilpayilu warta kanyinma","poem":1},{"text":"papa nganyirri purlkanya pungkukitjalu.","poem":2},{"text":"Palunyapirinytju-rnin walara katirrayilpayi.","poem":1},{"text":"Nyangka-rnanta kurrurnpa rapalu wanarayirni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nyuntulu-tjun mirrka kutjupa-kutjupa pirni palyara tjunkupayi,","poem":1},{"text":"yanyan-yanyanpa pirnilu-rniya nyakulanyangka.","poem":2},{"text":"Palunyalu-rnin pukurltu yarltipayi pitjala-rna mirrka ngalkulatjaku.","poem":1},{"text":"Puru-tjun panikinta tjutira mulyawiilymankula tjunkupayi purlkanya-rna tjikiltjaku.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yuwa, nyuntulu-rnin ngarltunytjulu tirtu kanyinma.","poem":1},{"text":"Nyangka-rna nyuntuku ngurrangka tirtu nyinaku nyinama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":6}