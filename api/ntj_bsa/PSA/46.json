{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"PSA","translationId":"ntj_bsa","name":"Turlku","commonName":"Turlku","title":"Turlku Pirninya","order":19,"numberOfChapters":11,"sha256":"e1388eb04c73964cd3e7b6ae89993022eefdcd17523ca25f0a6fd290ea1f83d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/PSA/1.json","lastChapterNumber":146,"lastChapterApiLink":"/api/ntj_bsa/PSA/146.json","totalNumberOfVerses":120},"chapter":{"number":46,"content":[{"type":"heading","content":["Mama Kuurrtu-lanya Yangatjura Kanyilpayi"]},{"type":"verse","number":1,"content":[{"text":"Mama Kuurrtu-lanya yangatjura kanyilpayi.","poem":1},{"text":"Nyangka-lan kurrurnpa rapa nyinarra.","poem":2},{"text":"Tjiinya-lanya tirtu yirringkara kanyilpayi","poem":1},{"text":"kutjupa-kutjupa ngaralanyangka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Palunyangka-lan ngurlumaalpa nyinama.","poem":1},{"lineBreak":true},{"text":"Nyangka mantatarrartu yurrirranyangka","poem":1},{"text":"purli wararra kartakatirra yuru purlkanyangka","poem":2},{"lineBreak":true},{"text":"punka-punkara tjarrparranyangka-lan","poem":2},{"lineBreak":true},{"text":"ngurlumaalpa nyinama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tjinguru kapi warnanpa purlkanya wirtatjarra","poem":1},{"text":"rurrku kukurrmanku.","poem":2},{"lineBreak":true},{"text":"Wiya, ngurlumaalpa-lan nyinama.","poem":2},{"text":"Tjiinya yapu wararratarrartu tiltirr-tiltirrmaranyangka,","poem":1},{"text":"ngurlumaalpa-lan nyinama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yuwa, kapi warla walykumunulu","poem":1},{"text":"yarnangu Tjurutjamanyamartatji pirninya pukurlmara kanyilpayi.","poem":2},{"text":"Yiwarla nyarra Mama Kuurrnga-ya lurrtjurringkula marninypungkupayi, palunyangka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mama Kuurrnga yiwarla palunyangka tirtu nyinama.","poem":1},{"text":"Nyangka-ya pungkula wiyalkitjalu purtulinku wantiku.","poem":2},{"lineBreak":true},{"text":"Tjiinyamarntu Mama Kuurrtu waarrpungkulalpi yangatjunku kanyinma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yuwa, ngurra kutjupa-kutjupangkatjalu-yanku","poem":1},{"text":"pika pungkulanyangka","poem":2},{"text":"Mama Kuurrnga tuturapirinypa wangkama.","poem":1},{"text":"Nyangka-ya manta lipingkatjalu kuliralpi ngurluny-ngurlunyarriku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yuwa, Mama Kuurrtu Yayirninytjulu Palyalpayilu-lanya miranykanyira kanyira.","poem":1},{"lineBreak":true},{"text":"Mama Kuurrnga, tjiinya Tjayikapalu pupakatirra marninypungkupayi,","poem":1},{"text":"palunyalu-lanya yangatjura kanyilpayi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pitjalalpi-yan nyaku kata paarnarralku","poem":1},{"text":"Mama Kuurrtu manta lipiwanalu","poem":2},{"lineBreak":true},{"text":"kutjupa-kutjupa palyarnu wantinyangka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tjiinya Mama Kuurrtu marrkulpayi","poem":1},{"text":"yarnangu pirnilu-yanku warrmarlara","poem":2},{"lineBreak":true},{"text":"manta lipiwanalu pika pungkulanyangka.","poem":2},{"text":"Palunyalu kurlarta, kupulu pirninya kartarntankupayi,","poem":1},{"text":"puru tjara pirninya tilira tjarrpatjunkupayi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mama Kuurrtu watjarnu, “Wiya, tjurlpilyarrinytjamaalpa-ya","poem":1},{"text":"kurrurnpa yipilyarri.","poem":2},{"text":"Palunyalu-rniya ngayunya ruukulila","poem":1},{"text":"tjiinya-tjanamparnanku puurrpa purlkanya nyinarranyangka.","poem":2},{"text":"Nyangka yarnangu ngurra kutjupa-kutjupangkatjalu-rniya","poem":1},{"text":"manta lipingkatjalurtu marninypungama.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yuwa, Mama Kuurrtu Yayirninytjulu Palyalpayilu-lanya miranykanyira kanyira.","poem":1},{"lineBreak":true},{"text":"Mama Kuurrnga, tjiinya Tjayikapalu pupakatirra marninypungkupayi,","poem":1},{"text":"palunyalu-lanya yangatjura kanyilpayi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":11}