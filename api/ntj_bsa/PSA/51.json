{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"PSA","translationId":"ntj_bsa","name":"Turlku","commonName":"Turlku","title":"Turlku Pirninya","order":19,"numberOfChapters":11,"sha256":"e1388eb04c73964cd3e7b6ae89993022eefdcd17523ca25f0a6fd290ea1f83d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/PSA/1.json","lastChapterNumber":146,"lastChapterApiLink":"/api/ntj_bsa/PSA/146.json","totalNumberOfVerses":120},"chapter":{"number":51,"content":[{"type":"hebrew_subtitle","content":["Wati yini Tayipirrnga kampangkartu ngarringu wati kutjupaku kurringka. Nyangka wati yini Nayitjintu tjiinya Mama Kuurrku wangka kulira tjakultjunkupayilu pitjangu Tayipirrnga-lu punturnu watjarnu tjiinya wati kutjupaku kurri pampunnyangka. Nyangka palunyalanguru Tayipirrtu turlku ngaanya walkatjunu."]},{"type":"heading","content":["Tayipirrtu tjapirnu Mama Kuurrnga-ra kalyparritjaku"]},{"type":"verse","number":1,"content":[{"text":"Yuwa Mama, ngarlturriwa-tju ngayuku.","poem":1},{"text":"Tjiinya-rnin mukulyanytjulu miranykanyira kanyilpayi.","poem":2},{"text":"Yuwa, nyuntulun walkatjunu wantingu palyamunu-rna palyaranyangka.","poem":1},{"text":"Nyangka-munta-tjun ruwarrpungku wiyalku?","poem":2},{"lineBreak":true},{"text":"Tjiinyamarntun ngarltunytju purlkanya nyinarra.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Parltjila-rni walykumunula","poem":1},{"text":"palyamunu-rna palyarnu palunyangka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tjiinya-rna nintilu kulira palyamunu palyantjatjanulu.","poem":1},{"text":"Palunyalu-rna purtu watarrkurringkula.","poem":2},{"text":"Tirtu-rna kulira palyamunu palyantjatjanulu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nyuntuku wangka-rna tungun-tunguntu wantingu.","poem":1},{"lineBreak":true},{"text":"Nyuntula mirangka-rna palyamunu palyarnu.","poem":1},{"lineBreak":true},{"text":"Nyangka-rnin tjurrkurltu watjara palyamunu-rna palyannyangka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yuwa, pilyirrngurulpi-rna palyamunu tirtu palyaranytja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yuwa Mama, nyuntulun mukurringkula","poem":1},{"text":"tjiinya-rna mayuranytjamaalpa tjukarurru nyinarratjaku.","poem":2},{"text":"Palunyanguru-rni nyuntuku wangka pinangka tjarrpatjurra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Parltjila-rni. Nyangka-rna walykumunu nyinama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mama, watjala-rni kalyparringkutjatjanulu.","poem":1},{"text":"Nyangka-rna pukurlarri nyinama.","poem":2},{"text":"Nyuntulu-rnin kurltjirr-kurltjirrmanu.","poem":1},{"text":"Kuwarrinya-rni kurrurnpa pukurlmara kanyinma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tirtu-kurlun kulinma","poem":1},{"text":"palyamunu-rna palyarnu palunyangka. Wanti.","poem":2},{"text":"Yuwa Mama, nyuntuku walkangka ngarala.","poem":1},{"text":"Nyangka-tju ruwarrpuwa wiyala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wiya Mama, kurrurnpa-rni parltjila walykumunula.","poem":1},{"lineBreak":true},{"text":"Palunyalu-rni wuyurrpa tjurrkurlmara kanyinma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wiya Mama, wituntjamaaltu-rni ngamulu kanyinma.","poem":1},{"lineBreak":true},{"text":"Nyuntuku Kuurti Walykumununya katinytjamaaltu wanti.","poem":1},{"text":"Nyangka-rni ngayula nyinama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pukurlmara-rni kanyinma,","poem":1},{"text":"nyarra wankarunkulalpi-rnin pukurlpa kanyiranytja,","poem":2},{"lineBreak":true},{"text":"palunyapirinypa.","poem":2},{"text":"Palunyalu-rni wuyurrmarra nyuntuku wangka wangarnarralu kulira palyaratjaku.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nyangka-rnayi nyuntuku wangka nintipungama","poem":1},{"text":"yarnangu nyarra palyamunu pirningka.","poem":2},{"text":"Nyangka-yayi pinkurraara marlaku pitja nyuntulakutu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mama, nyuntulu-rnin kutjulu wankarunku.","poem":1},{"lineBreak":true},{"text":"Nyangka-kurlu-rnin ngaparrtjika pungku tjunku","poem":1},{"text":"tjiinya-rna wati nyarranya pungu tjunkunyangka.","poem":2},{"text":"Palunyangka-rna mirrarra yinkama","poem":1},{"text":"nyuntulu-rnin wankarunkunyangka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mama, yirringkala-rni wangkarra-rna","poem":1},{"text":"nyuntunya marninypungkulatjaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tjinguru-rnanku mirrka kuka katiku witaralpi nintilku.","poem":1},{"text":"Wiya, pukurlarrikitjamunu-tjun.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tjiinya-rna kurrurnpa tjirturu-tjirturu palyamununguru kurntarringku,","poem":1},{"text":"palunyangka-tjun pukurlarriku.","poem":2},{"text":"Palunyalu-rnin wituntjamaaltu ngamuntinku kanyinma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yuwa Mama, walykumunura-tjananya kanyinma","poem":1},{"text":"yarnangu pirninya nyarra Tjurutjamala nyinarranytjanya.","poem":2},{"lineBreak":true},{"text":"Palunyalu-tjananya yirringkanama.","poem":2},{"lineBreak":true},{"text":"Nyangka-yayi yaarrpa purlkanya yiwarlawana marlakulu parrapalyanma.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Palunyalu-latju palyamunu palyaralpi","poem":1},{"text":"kurntarringkula nyinanytjatjanulu","poem":2},{"lineBreak":true},{"text":"puluka pungku witalku nyuntuku nintilku.","poem":2},{"text":"Nyangkan pukurlarriku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":19}