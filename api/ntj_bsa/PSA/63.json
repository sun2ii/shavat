{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"PSA","translationId":"ntj_bsa","name":"Turlku","commonName":"Turlku","title":"Turlku Pirninya","order":19,"numberOfChapters":11,"sha256":"e1388eb04c73964cd3e7b6ae89993022eefdcd17523ca25f0a6fd290ea1f83d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/PSA/1.json","lastChapterNumber":146,"lastChapterApiLink":"/api/ntj_bsa/PSA/146.json","totalNumberOfVerses":120},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Turlku ngaanya Tayipirrtu mayu-mayu nyinarranytjalu walkatjunu wantingu."]},{"type":"heading","content":["Tayipirrnga Kurrurnpatarrartu Mama Kuurrku Mukurringkulanytja"]},{"type":"verse","number":1,"content":[{"text":"Yuwa Mama, nyuntunya-rnanta pupakatirra marninypungkupayi.","poem":1},{"lineBreak":true},{"text":"Palunyalu-rnanku kurrurnpatarra mukurringkula.","poem":1},{"lineBreak":true},{"text":"Tjiinyakurlu-ya ngurra yayilurrungka pitjalayila","poem":1},{"text":"purtu mukurringkula pinalukutju kulinma, “Kapipalka ngarrima.","poem":2},{"lineBreak":true},{"text":"Nyangka-rna waarrpungkulalpi tjikila.” Palunyapirinypa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yuwa, mukurringkula-rnanta nyuntunya nyakukitjalu.","poem":1},{"lineBreak":true},{"text":"Puru-rna mukurringkula nyuntuku tili purlkanya nyakukitjalu","poem":1},{"text":"tjurrtjungka yirrnyaranyangka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Walykumunu tjiinya wanka-rna nyinarratjaku.","poem":1},{"text":"Nyangka palunyangka munkarra ngarala","poem":2},{"lineBreak":true},{"text":"tjiinya-rnin mukulyanytjulu kanyiratjaku.","poem":2},{"text":"Palunyalangurulta-rnanta marninypungama.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yuwa, nyuntunya-rnanta marninypungkulayilku ma-mirrirriku.","poem":1},{"lineBreak":true},{"text":"Puru-rnanta mara katura warlkura tjapinma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yuwa, kurrurnpa-rna pukurlpa nyinama.","poem":1},{"text":"Tjiinyakurlu kukatjanu parltjarringkulalpi pukurlpa nyinama, palunyapirinypa.","poem":2},{"lineBreak":true},{"text":"Palunyalu-rnanta pukurltu yinkarra marninypungama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mungangka-rnanta ngarrirra kulilpayi.","poem":1},{"text":"Wankalu-rnanta kulira tjirnturringkupayi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yuwa, tirtu-rnin yirringkara kanyilpayi.","poem":1},{"text":"Palunyangka-rnanku turlku pukurltu yinkapayi,","poem":2},{"lineBreak":true},{"text":"tjiinyamarntu-rnin yangatjura kanyiranyangka.","poem":2},{"lineBreak":true},{"text":"Tjiinyakurlu tjurlpulunku kurlunypa pirninya nyarlpilu yangatjura kanyinma.","poem":2},{"lineBreak":true},{"text":"Palunyapirinytju-rnin kanyira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lurrtju-rnanta tirtu nyinama.","poem":1},{"text":"Nyangka-rnin waku purlkanyalu patjurira kanyinma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yarnangu nyarra nyinarra-rniya yurakanyira pungkula tjunkukitjalu,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"palunyanya-tjananya warrmarlalu pungku tjunku.","poem":1},{"text":"Nyangka ngupanulu pitjaku ngalku wiyalku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yuwa Mama, ngayulu-rnanta puurrpa purlkalu pukurltu marninypungama,","poem":1},{"text":"tjiinya-rnin yirringkaranyangka.","poem":2},{"text":"Nyangkanta-ya yarnangu nyarra nyuntunya mularrkuliranytjalu marninypungama.","poem":1},{"text":"Nyangka-ya mayulpayi pirninya kanmarrarriku nyinama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}