{"translation":{"id":"ntj_bsa","name":"Mama Kuurrku Wangka","website":"https://ebible.org/Scriptures/details.php?id=ntj","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntj","licenseNotes":null,"shortName":"BSA","englishName":"Ngaanyatjarra Shorter Bible","language":"ntj","textDirection":"ltr","sha256":"9d7d067abcae17fa4a2da192a5e16d97adad5e2e59e6a3f65558fd859f03cb00","availableFormats":["json"],"listOfBooksApiLink":"/api/ntj_bsa/books.json","numberOfBooks":50,"totalNumberOfChapters":502,"totalNumberOfVerses":11578,"languageName":"Ngaanyatjarra","languageEnglishName":"Ngaanyatjarra"},"book":{"id":"PSA","translationId":"ntj_bsa","name":"Turlku","commonName":"Turlku","title":"Turlku Pirninya","order":19,"numberOfChapters":11,"sha256":"e1388eb04c73964cd3e7b6ae89993022eefdcd17523ca25f0a6fd290ea1f83d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ntj_bsa/PSA/1.json","lastChapterNumber":146,"lastChapterApiLink":"/api/ntj_bsa/PSA/146.json","totalNumberOfVerses":120},"chapter":{"number":91,"content":[{"type":"heading","content":["Mama Kuurrtu-rni Yangatjura Kanyinma"]},{"type":"verse","number":1,"content":[{"text":"Ngayulu-tjinguru-rna Mama Kuurrnga tjiinya yayirninytjulu palyalpayingka ngamu nyinama.","poem":1},{"text":"Nyangka-rni yangatjura kanyinma.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nyangkalta-rna Mama Kuurrta watjalku,","poem":1},{"text":"“Nyuntulu-rnin tjarapirinytju yangatjura kanyilpayi.","poem":2},{"text":"Nyangka-rnanta nyuntunyakutju pupakatirra marninypungama.","poem":1},{"text":"Palunyalu-rnanta mula-mularringkula kulinma.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kulila. Kutjupalu-tjingurunta punkatjingalku.","poem":1},{"text":"Wiya, Mama Kuurrtunta katulku.","poem":2},{"text":"Nyangka-tjinguru-ya pirninya pika purlkanyatjarra ngarrima.","poem":1},{"text":"Nyangkanta Mama Kuurrtu wankarura kanyinma mirrirritjakutarra.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yuwa, Mama Kuurrtunta yangatjura kanyinma.","poem":1},{"lineBreak":true},{"text":"Tjiinyakurlu tjurlpulunku kurlunypa pirninya nyarlpilu yangatjura kanyinma, palunyapirinytju.","poem":1},{"lineBreak":true},{"text":"Mama Kuurrtunta watjarnu wantinytjatjanulu kanyinma.","poem":1},{"text":"Tjiinyanta tjurlpu nyarlpipirinytju yangatjura kanyinma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wiya, nyaakun ngurlurringkula","poem":1},{"text":"mamulunta mungangka pitjala pungkutjaku?","poem":2},{"text":"Wiya, Mama Kuurrtunta miranykanyinma.","poem":1},{"lineBreak":true},{"text":"Nyaakunykan ngurlurringkula","poem":1},{"text":"karlarla-ya kurlarta warnirranyangka?","poem":2},{"text":"Wiya, Mama Kuurrtunta yangatjura kanyinma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nyaakun ngurlurringkula mungangka pikatjarrarritjaku?","poem":1},{"lineBreak":true},{"text":"Wiya, Mama Kuurrtunta miranykanyinma.","poem":1},{"lineBreak":true},{"text":"Nyaakun ngurlurringkula","poem":1},{"text":"kutjupa-kutjupa karlarla yutirringkulanyangka?","poem":2},{"text":"Wiya, Mama Kuurrtunta yangatjura kanyinma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tjinguru yarnangu pirninya nyuntula yitingkartu punkalku mirrirriku.","poem":1},{"text":"Nyangkan kutjuwanka ngarama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Palunyalun nyaku","poem":1},{"text":"Mama Kuurrtu-tjananya palyamunu pirninya ngaparrtjika pungku wiyannyangka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yuwa, kurrurnpa rapalun kulira Mama Kuurrtunta purlkanya nyinarranytjalu yangatjura kanyiratjaku.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Palunyangka kutjupa-kutjupalu pikanku nintilkitjamunu.","poem":1},{"text":"Nyangka nyuntuku ngurrangka palyamunu ngarakitjamunu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nyangka Mama Kuurrtunku palunyaku yayintjulpa pirninya witulku","poem":1},{"text":"miranykanyiranta-ya kanyiratjaku,","poem":2},{"lineBreak":true},{"text":"tjiinyan ngurra kutjupa-kutjupakutu yankulanyangka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nyangka yayintjulpa pirnilunta-ya maralu katura kanyinma","poem":1},{"text":"yapulunta tjina pikarntankutjakutarrartu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Purun layinpa nganyirri purlkanyawana lirruwanatarrartu parrangarama.","poem":1},{"text":"Nyangkanta-ya patjalkitjamunu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yuwa, Mama Kuurrtu watjarnu,","poem":1},{"lineBreak":true},{"text":"“Nyuntulu-tjun mukulyanytju nyinarranyangka","poem":1},{"text":"ngayulu-rnanta wankarura kanyinma.","poem":2},{"text":"Ngayulu-rnanta yangatjura kanyinma","poem":1},{"text":"nyuntulu-rnin puurrpa warlkuranyangka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nyangka-tjingurunku palyamunu yartakarrinyangka","poem":1},{"text":"ngayula-rni tjapinma.","poem":2},{"lineBreak":true},{"text":"Nyangka kuliralpi-rnanta yampura kanyinma.","poem":2},{"text":"Palunyalu-rnanta walykumunura kanyinma wanka nyinarratjaku.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ngayulu-rnanta wankarura kanyinma.","poem":1},{"text":"Palunyangkan rawa nyinarrayilku ma-mirrirriku.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntj_bsa/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntj_bsa/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntj_bsa/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":16}