{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":11,"content":[{"type":"heading","content":["Yawe Nide Me Rlakitrx"]},{"type":"hebrew_subtitle","content":["Nabz ne Devet kx yrbzle mz kxrmailz ngr dzbe kxnzngrng."]},{"type":"verse","number":1,"content":[{"text":"Kztengeng, Yawe nide me rlakitrx.","poem":1},{"text":"A' myx kxmule tqrpi-ngrnamu kx, “Ngrlrlz mz newz mz nzrlapx-krm.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Murde leplz kxdrka'-ngrng nzmnc-kapqti-zvzlr leplz kxnztubqng,","poem":1},{"text":"Mz nzpnz-krdr nidr mz nipna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Trpengr doa x da kx na-abrkitrku drtwrgu,","poem":1},{"text":"X nigu kxnabzdr lqngi, trpengr da kx na-aleku.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bzkq kxmu nzycmne-krmamu lc bange, murde Yawe kc tqmncbe mz Mangr-nzangiongr nide,","poem":1},{"text":"X sc tqwxbube mz tron nyzde Heven mz nzobqplx-krde nabz leplz amrlx.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawe sc tqobqtr zvz mz nzmnckr kxnztubqng x kxdrka'-ngrng.","poem":1},{"text":"X pxtxpx-ngrde nzrmcngr kxnzrnibqng.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"X mz nzayrplapx-krde nidr, sa nartctio-ngrbzle badr muli rplz kxngc na-apule nzdckr tewa.","poem":1},{"text":"X sa na-abxutile nidr mz nzulr nenq kxpq.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A' krkcng nabzdr tqlqngi sa namncng badr,","poem":1},{"text":"Murde Gct tubq-esz'ngr x mrlz bade da kxtubq.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}