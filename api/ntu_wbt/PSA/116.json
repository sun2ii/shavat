content":[{"text":"Amnc-zpwx-moule ninge. Trmetx-ngrpwc'u mz enqmi.","poem":1},{"text":"Trbz-ngrneu, tryrni-ngrneu. Amnc-zpwx-moule ninge.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Navz-nqblq-zvzx nide x me pnz drtwrde.","poem":1},{"text":"Mz nzmnc-krnge mz nrlc navz-nqblq-zvzx nide.","poem":2}]},{"type":"heading","content":["Nzawingr"]},{"type":"verse","number":10,"content":[{"text":"Kxmule-esz' ycpe pipz nzmwxlrti-lzbq-krnge,","poem":1},{"text":"A' mzli kc tqkxpu-zlwz-ngrne,","poem":2},{"text":"Pipxx murde abrtrpo drtwrnge mz Yawe,","poem":1},{"text":"X krlzx kx mane nzbrtikr drtwrnge leplz.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kxmule-esz' rblx nzayzlu-krbo mz Yawe","poem":1},{"text":"Da kxmrlzting kcng tqaletimleng bange,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"A' sa natwzmc bade waen,","poem":1},{"text":"Nangi dalr nzawi-krbo bade mz nzarlapx-krde ninge.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"X sa nakabo bade nike esalz-ngrbo bade,","poem":1},{"text":"Mz nzangiopx-lxblrkr leplz nedeng.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"X napipxbo badr kx, “Drtwr Yawe vztx zlwz","poem":1},{"text":"Mz nzmc-krde nzbzkr kzdq doa nedeng.","poem":2},{"text":"Delc tqmrlz-ngrbzle bade nzarlapx-krde nigu,","poem":1},{"text":"Tqmyaszpx-ngrde nzrlrpx-krde nzbz-krgu.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawe, ninge kxnzawz nem, da kc tqwai lxenge mzli kc.","poem":1},{"text":"Awi mz nzarlapx-krm ninge mz nzbzngr.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kabo bam blz kx na-awi-ngrbo bam,","poem":1},{"text":"Mz nzkrka'-krbo bam.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Delc tqka-ngrbo bam da kc tqesalz-ngrbo bam,","poem":1},{"text":"Mz mzlir leplz nemqng,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mz nzamrlue-lxblr-krgr nim Mangr-nzangiongr Jerusalem.","poem":1},{"text":"Naglqlzku Yawe!","poem":2}]}],"