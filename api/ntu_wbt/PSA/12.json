{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":12,"content":[{"type":"heading","content":["Da Kxtrka Mz Nrlc Tulvzo"]},{"type":"hebrew_subtitle","content":["Nabz ne Devet kx yrbzle mz kxrmailz ngr dzbe kxnzngrng."]},{"type":"verse","number":1,"content":[{"text":"Yawe, okatrp ninge murde trpengr mrlx kxtubq kx mnc mzli ka.","poem":1},{"text":"Murde mz nrlc tulvzo leplz kxnzmrlzng nzayrkrtxtrpeng.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Leplz amrlx mz nrlc nzapokiati-lzbqng.","poem":1},{"text":"Nzalqngitilr nzycmnengr mz drtwr kx xlva.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rlxtibo bam nzaesaki-krm natq leplz kxnzpokiang,","poem":1},{"text":"X odati nidr mz nzglqpx-lzbq-krdr.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Murde nzrpilr kx, “Naogr nalctwz txpwz mz nztwz-krgr da kx suti drtwrgr.","poem":1},{"text":"X trpnzngr kx naetum bagr.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A' Yawe rpile kx, “Mcpex nzaetq-ngrbz drtq kxnzkxpung,","poem":1},{"text":"X nztangqgxkr kxnzmwati drtwrng.","poem":2},{"text":"Delc na-arlapxx nidr mzli ka.","poem":1},{"text":"Da kc tqwai nzsutikr drtwrdr le.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawe, abrtrpzkr drtwrgr mz natqm lcng, tqtubq tqlq.","poem":1},{"text":"Murde nzopx-krdr apule silvz kc tzayrleni-ebirngr mz nyr.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kxmule-esz' leplz lcng trmya-ngru drtqdr nzglqpx-lzbq-krdr,","poem":1},{"text":"X nzrglqlz-krdr da kxtrka mz nrlc tulvzo,","poem":2},{"text":"A' lxngitikr kx sa na-aclve-zpwxq nigr,","poem":1},{"text":"X sa na-arlapx-zvzbzme nigr mz mq leplz lcng tzdrka'ngr.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":7}