Gct rgr, aclve zpwx nigr lr Jerusalem,","poem":1},{"text":"Murde leplz nemqng kcng tzmrlztilr nim","poem":2},{"text":"Namnc-zpwxng mz ma nyzdr,","poem":1},{"text":"X narmctilr nrwx mz nzmncpx-krmlr mz drkq ngr mzteadau nyzm.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawe, rlxtibzkr bam","poem":1},{"text":"Kx na-aclve-kzpzme lr mrnyzgr x kztegrng kcng tzmncng elr.","poem":2},{"text":"Amrlz zvz leplz amrlx kcng tzmncng elr","poem":1},{"text":"Mz nzmrlzti-krdr Mangr-nzangiongr nim. Eu, angida.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":6}