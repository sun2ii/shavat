{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":125,"content":[{"type":"heading","content":["Kxnztubqng X Kxdrka'-ngrng"]},{"type":"hebrew_subtitle","content":["Nabz kx nzngrnelzngr Jerusalem mz nzangiongr."]},{"type":"verse","number":1,"content":[{"text":"Nigu kcng nzabrtrpzlr drtwrdr mz Yawe,","poem":1},{"text":"Apuku Newz Saeon kx trycngrlru, a' tutx alo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"X Yawe apule newz kcng tztu-ngalelvzlr Jerusalem,","poem":1},{"text":"Murde vz zvz nztu-krmle mz nibrgu, nigu leplz nedeng.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"X tr-rlr-ngrpwzleu mz kxdrka'-ngrng nzaclve-alo-krdr mrnyzgu, nigu kxnztubqng.","poem":1},{"text":"Murde ma tqvz-nqblqku nqmq krdr kxtrka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Delc Yawe, krka'-ngrgr kx na-amrlzq nigr lr Israel kxnztubqng","poem":1},{"text":"Mz nzyrlq-angidr-krgr natqm.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A' mzli kc na-ayrplapx-ngrn kxdrka'-ngrng,","poem":1},{"text":"Mrlzm bagr nzayrplapx-kz-krm kzdung nigr","poem":2},{"text":"Kcng tzpxtxpx-ngrdr nzvz-nqblqngr nim.","poem":1},{"text":"A' amnc zpwx nigr lang.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}