em":2},{"text":"Murde mzli kc kzdq ncblo narnqniti-lzbq-ngrdr bade,","poem":1},{"text":"Mrlxdeng sa natubzng mz nibrde.","poem":2},{"text":"X mz nzrka-krbz kxnzrmailzng drtwr kxtubq,","poem":1},{"text":"Drtqde trnamyau murde nztu-krbz mrlxdeng lcng mz nibrde.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":3}