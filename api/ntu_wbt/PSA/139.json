{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":139,"content":[{"type":"heading","content":["Nzrkrlzkr Yawe Myatxlz-esz'ngr X Krlz-kzle Nqmq Nr Nabzm"]},{"type":"hebrew_subtitle","content":["Nabz ne Devet kx yrbzle mz kxrmailz ngr dzbe kxnzngrng."]},{"type":"heading","content":["Obqplxq Nabznge"]},{"type":"verse","number":1,"content":[{"text":"Yawe, obqplxq nabznge,","poem":1},{"text":"X krlz-atwrnr-ngrn ninge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Krlzq da amrlx kcng tqalex.","poem":1},{"text":"Kxmule-esz' mncme rlru, a' krlz-zvzq nzao-krnge drtwrnge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kxmule-esz' wzx o amax, a' sa tqmc-zvzq ninge.","poem":1},{"text":"X krlz-kaiq da amrlx kcng nartrngztibo mz zbq kxesz'.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abzo pnz mzli kc trycmneka-ngrne","poem":1},{"text":"Nzkrlz-kai-krm natq kznike napixng.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zmatq ngrm okatrle ninge","poem":1},{"text":"Mz nztu-ngalelvz-krde ninge.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nzkrlz-krm ninge etu zlwz.","poem":1},{"text":"X trtakitrpwc'u nzrkrlz-krm.","poem":2}]},{"type":"heading","content":["Esz'-ngrn Nrlc"]},{"type":"verse","number":7,"content":[{"text":"?Drlve kc navzkix murde trnamcwq ninge?","poem":1},{"text":"Trpnzngr kxnamule lc murde esz'-ngrn nrlc.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"X kxmule-esz' vzdzx Heven, a' sc tqmncq elr.","poem":1},{"text":"X kxmule-esz' bzx x nzyrtzmqnge, a' sc tqmnc-kzq elr.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kxmule-esz' alilvc-kzx me prkilzm nepi","poem":1},{"text":"O me takiole,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"A' sc tqmncq elr mz nzokatr-krm ninge","poem":1},{"text":"X nzrmailz-krm ninge mz mqm.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kxmule-esz' mnc-kapqx mz nzlo","poem":1},{"text":"X mz drtwrnge nrlckxngrlx nangitx nrlckxbq,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"A' nzlo x nrlckxbq rblx nzamnc-kapq-krdr ninge,","poem":1},{"text":"Murde nzlo x zyzlr kxnamu-txpwzlr esz' mz nzobq-krm.","poem":2}]},{"type":"heading","content":["Nzlrmztio-krm Ninge"]},{"type":"verse","number":13,"content":[{"text":"Murde mzli kc tqmclq ninge mz nelz lxenge","poem":1},{"text":"Nim txpwz kx rkrlz nzmnc-lrpipx-krmc mrlcde.","poem":2},{"text":"Wz-ngrn dalr nrkrdrtqnge x nrvr rngeng.","poem":1},{"text":"X amwitr-lxblr-kzqng amrlx, mz nzvz-nqblq-krde me pnz drtwrm.","poem":2},{"text":"X kctipxx x awitx-ngrbo bam","poem":1},{"text":"Nzlrmztio-krm ninge.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"X mzli kc trnzmckangr mzke',","poem":1},{"text":"Yrlqpe-kaiq me nakrlzbz me nangi bz ngr nzlu-krnge.","poem":2}]},{"type":"heading","content":["Rblxm Bange Nzao-krm Drtwrm"]},{"type":"verse","number":17,"content":[{"text":"A' rblxm bange nzkrlz-angidr-krnge nzao-krm drtwrm","poem":1},{"text":"Murde nzkqlu-zlwzng.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"A' nzmu narlwxxleng drtwrnge mrbrtrpz,","poem":1},{"text":"Murde nzmyaszpxlr drta' ngr prla amrlx.","poem":2},{"text":"X kxmule-esz' nayrkrpx nzrlwx-krngeleng,","poem":1},{"text":"A' tryatrkapc' nzkrlz-angidr-krnge nim.","poem":2}]},{"type":"heading","content":["Kxdrka'-ngrng"]},{"type":"verse","number":19,"content":[{"text":"Murde rblxbep bange drtwr ngr nqmq krm.","poem":1},{"lineBreak":true},{"text":"?Memule tqasa-ngrn nzayrplapx-krm kxdrka'-ngrng?","poem":1},{"text":"?Myx kxmule trnamilxtxokalq nidr?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Murde nzpiti-ngrdr nim natq kxtrka,","poem":1},{"text":"X nzrnzlvzolr nqmq krm.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yawe, pxtxpx-ngrne krkcng tzpxtxpx-ngrdr nim x ni-kzdr enqmi rngeng.","poem":1},{"text":"Murde trnzmnclzpwzung mz zmatq ngrm.","poem":2}]},{"type":"heading","content":["Aelwa-ngrm Bange Nqmq Krnge Kxtrka"]},{"type":"verse","number":23,"content":[{"text":"Gct, obqplxti zpwx nqmq nr nabznge","poem":1},{"text":"Mz nzkrlz-krm nzao-krnge drtwrnge.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Murde na-aelwa-ngrme bange nqmq krnge kxtrka,","poem":1},{"text":"X namailzq ninge mz nzti kxtubq.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":21}