{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":14,"content":[{"type":"heading","content":["Nzngqngukr Kxtrnzrlxngitiung"]},{"type":"hebrew_subtitle","content":["Nabz ne Devet kx yrbzle mz kxrmailz ngr dzbe kxnzngrng."]},{"type":"verse","number":1,"content":[{"text":"Leplz kxnzngqngung mz drtwrdr nzrpilr kx, “Trpnzngr Gct.”","poem":1},{"text":"Leplz lcng nzvz-rbrng x nzale-txpwzng da kxtrka zlwz.","poem":2},{"lineBreak":true},{"text":"Trpnzngr leplz lcng kxtubq.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawe mncom Heven, x sc tqmcomle leplz amrlx,","poem":1},{"text":"Mz nzmc-krde neke yrplapx mz nzrtangrti-krde nide.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"A' nzesablqtilr Gct amrlx ngrdrx drtwrdr esz'ti mz nzale-krdr da kxtrka.","poem":1},{"text":"Trpnzngr nidr kxesz' kxtubq.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Delc tqrpingr Yawe kx, “Leplz lcng tztrkang nznibqtitxdr leplz nengeng","poem":1},{"text":"Nzapulr kx nzrnibqng da kx nangqdr.","poem":2},{"text":"X mrbrtr mz drtwrdr nzkrka'-krmlr bange.","poem":1},{"text":"?Myx kxmule, trnzkrlzlru da kxtubq?”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A' narngidrtio-lzbqng x namwxlrlvzti-lzbqng,","poem":1},{"text":"Murde Gct tedr badr kxnztubqng.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vz zvz nzrpwa'-krbzlr me pnz drtwr kxnzrlxngiting.","poem":1},{"text":"A' Yawe mnc-ngalelvzle leplz nedeng.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sutitx zlwz drtwrnge kx Gct rgu kc Saeon na-arlapxle leplz nedeng.","poem":1},{"text":"Murde mzli kc nayzlu-mou-ngrmle, namnc-zpwxku badr.","poem":2},{"text":"X nigu lr Jekop drtwrgu sa naelalzm.","poem":1},{"text":"X nigu lr Israel sa na-abrtz-ngrgu da lc.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}