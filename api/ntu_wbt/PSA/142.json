ber":6,"content":[{"text":"Ayzlum natqnge","poem":1},{"text":"Murde nabznge talvzo zlwz.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aopxbz drtqnge mz nzkxpu-krngeng murde na-awibo bam,","poem":1},{"text":"X kxnztubqng natu-ngalelvzlr ninge mz nzglqlz-krdr nim mz nzamrlz-zlwz-krm ninge.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}