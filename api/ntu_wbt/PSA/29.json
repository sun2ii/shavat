{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":29,"content":[{"type":"heading","content":["Natq Yawe Mz Trlipu"]},{"type":"hebrew_subtitle","content":["Nabz ne Devet."]},{"type":"verse","number":1,"content":[{"text":"Nimu enjrl ngr Heven nayrngzobzmu mz Yawe,","poem":1},{"text":"Mz nzmc-krmu nzmyalz-krde x zmatq ngrde.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Napipxamu kx takitrde nzamrluengr drtqde,","poem":1},{"text":"Mz nzangio-krmu nztr-esz'ngr-krde.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Murde natq Yawe aelwapx-lzbqngr mz trlipu.","poem":1},{"text":"Nate kxmatq o-zlile dcpwe mz nzapu-krde bzlrmei prla.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Natq Yawe matq-esz'ngr.","poem":1},{"text":"Eu. Natqde xplr zlwz.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Natq Yawe rpesaliti nc trpili,","poem":1},{"text":"Mz nzapu-krdr nounc kx nzlapizting.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Natq Yawe aycngrlrle newz nyzgung,","poem":1},{"text":"Mz nzapu-krdr ncblo kx nzelang.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Natq Yawe batrpzle bzlrpc.","poem":1},{"text":"X bzlrmei ngrde aycngrlrle peto.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Natq Yawe apule nenq kc tqrkqtuti nc yrni x krlxpqtile leu rdr.","poem":1},{"text":"X kxnzangiong amrlx mz Mangr-nzangiongr nzrpilr kx, “Gct, nzmyalz-esz'ngr-krm glqlz-ngrgr nim!”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nubla ngr tewa kxetu yclzbz mz zmatq ngr Yawe,","poem":1},{"text":"Mz nzngini-krde King kc tqaclve alo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"X mz zmatq lc axplrle nigu leplz nedeng","poem":1},{"text":"Murde namnc-zpwxku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":10}