{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":3,"content":[{"type":"heading","content":["Nou Nzarlapxngr X Nzaovxiongr"]},{"type":"hebrew_subtitle","content":["Nabz ne Devet,"]},{"type":"hebrew_subtitle","content":["kc tqyrle mzli kc tqdwasz-ngrde mrlxde Absalom."]},{"type":"verse","number":1,"content":[{"text":"Yawe, enqmi rngeng nzkqlu-zlwzng,","poem":1},{"text":"X nztutitr zvz nardr ninge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nzrpilr mz nzyapwxti-krdr ninge kx,","poem":1},{"text":"“Gct trtxpnzngr nzokatr-krde nide.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"A' Yawe, nim kx mnc-ngale-zvzle ninge.","poem":1},{"text":"Nim nou nzaovxio-krnge x nim kx apqtrp drtwrnge.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Delc tqrlxti-ngrbo nzokatr-krm ninge,","poem":1},{"text":"X ayzluome natqnge mz newz kxtr nyzm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Murde namwi-angidrx mz nrlckxbq x melz-mopwc' mz nourla,","poem":1},{"text":"Mz nzaclve-angidrq ninge.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kxmule-esz' nztu-ngalelvzlr ninge siu ngr enqmi,","poem":1},{"text":"A' trtxpnzngr nzmwxlr-krnge.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Murde krka'-ngrne kx, “Yawe, Gct rnge, vzm arlapx ninge,","poem":1},{"text":"X katxpxbz zmatq ngrdrng.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawe, nim nou nzarlapxngr,","poem":1},{"text":"X da kxmrlzting amrlx kabzme mz leplz nemqng.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}