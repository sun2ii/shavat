{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":38,"content":[{"type":"heading","content":["Zmrlepu R Alwx Rngeng X Nzatrkatikr Enqmi Rngeng Ninge"]},{"type":"hebrew_subtitle","content":["Nabz ne Devet."]},{"type":"heading","content":["Alwx"]},{"type":"verse","number":1,"content":[{"text":"Yawe, kxmule-esz' ngyati drtwrm ninge,","poem":1},{"text":"A' bzkq ayrplapxq ninge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Murde nipna scmqng tupe bange,","poem":1},{"text":"X pnzplrope-ngrn ninge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xngitxtr-zlwzpex nzngyatikr drtwrm ninge.","poem":1},{"text":"X yangrnga-zlwz-ngrne alwx rngeng.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zmrlepu r alwx lcng sc tqayrngzpupele ninge,","poem":1},{"text":"X apupex ncblo kx boo mz alwx ngrdeng.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nzngqngu-plxsr-krnge aetqpemle drtqnge,","poem":1},{"text":"Apule kxsqki kx mibi x brtu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Alwx rngeng nzyrlamyro-ngrdr ninge.","poem":1},{"text":"Delc drle mzke' tqtao zvz mz zbq kang kqlu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nzyagox-krnge apule nyr kx ngcpxm mz nrkrdrtqnge.","poem":1},{"text":"X nzxplr-krnge yrkrtxpxpebz.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nzetqkr drtqnge wibrti-zlwzpe-ngrde ninge.","poem":1},{"text":"X bztipenge nzyrningr murde drtqnge rkrkx-zlwzpe.","poem":2}]},{"type":"heading","content":["Zyagox"]},{"type":"verse","number":9,"content":[{"text":"Yawe, krlzpeq da amrlx kcng tqpq zlwz mz drtwrnge murde namnc-zpwxx.","poem":1},{"text":"X xlrpe-kzpe' nzyrke-zlwz-krnge.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mzli ka drtqnge mewepe x nzycmini-krnge vz-ebirpengr,","poem":1},{"text":"X mzke' obqkipele mrkzble.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kztengeng nzngangrpe-ngrdr ninge murde kxsqki rngeng.","poem":1},{"text":"X kxnginingeng trnzesotrpepqngqu bange.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Krkcng tzrpilr nanibqlr ninge,","poem":1},{"text":"Nzamwipelr trtxki rnge.","poem":2},{"text":"X krkcng tzaetqmlr drtqnge, sc tzrpilr naodatilr ninge.","poem":1},{"text":"X sc tzryrlq-zvzng drtwr mz nzatrkati-krdr ninge.","poem":2}]},{"type":"heading","content":["Enqmi"]},{"type":"verse","number":13,"content":[{"text":"A' opxm kx trxlrwxu nzycmnekr enqmi rngeng.","poem":1},{"text":"X trkrlzwxu nzycmnengr.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Eu, apubo badr kx nradrtqde ngq,","poem":1},{"text":"X trayzlupwc'u natqdr.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Murde nim Yawe kx na-ayzlubzle nike nzalemlr bange,","poem":1},{"text":"Mz nzngini-krm Gct rnge kc tqabrtrpo drtwrnge bade.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bzkq rlr-ngrbzme nzabrtzlvz-krdr nzetqkr drtqnge.","poem":1},{"text":"X bzkq nzglqpx-lzbqng mz nzaovxio-krdr ninge.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Murde ycpe pipz nzodati-krdr ninge,","poem":1},{"text":"X nzetq-zvzkr drtqnge tryrkrtxpxpeu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naplztxpxx nzvz-rbr-krngeng,","poem":1},{"text":"Murde nzbatrplr nzkxnekr drtqnge.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Enqmi rngeng nzxplrng x nzlu-zpwxng.","poem":1},{"text":"X nzkqlung kx nztrkati nivz lrdr ninge.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Da kxmrlz kcng tqalebo badr, nzayzlumlr mz da kxtrka.","poem":1},{"text":"Nzpxtxpx-ngrdr ninge murde vz-nqblqx nzmncngr kxtubq.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yawe, bzkq amnctxnq ninge esz'-krnge,","poem":1},{"text":"X bzkq mnc-zvzme rlru.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kxetu, vz-anim mz nzokatr-krm ninge,","poem":1},{"text":"Murde nim Mevalu rnge.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}