{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":4,"content":[{"type":"heading","content":["Abrtrpzmu Drtwrmu Mz Gct"]},{"type":"hebrew_subtitle","content":["Nabz ne Devet."]},{"type":"heading","content":["Gct Rnge"]},{"type":"verse","number":1,"content":[{"text":"Gct, ayzlum nzkrka'-krnge,","poem":1},{"text":"Murde dwaki-zvzme bange.","poem":2},{"text":"X mzli kc tqkxpu-ngrne, okatrq ninge.","poem":1},{"text":"Delc naycngr mz drtwrm ninge x naxlr-ngrme natqnge.","poem":2}]},{"type":"heading","content":["Kxnzmnc-mrbrng"]},{"type":"verse","number":2,"content":[{"text":"?Nimu leplz, myx mzli kx naesakingr nzatrkati-krmu nzmyalz-krnge?","poem":1},{"text":"?X myx mzli kx naesakingr nzmrlzkr bamu da kx ngi brmrda x nzpokiangr?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Murde nakrlzamu kx Yawe mcpxle nigr leplz kxnztubqng kx nanginedeng.","poem":1},{"text":"X mzli kc nakrka'-ngrbo bade, sa na-ayzlumle natqnge.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bzkq nabztq ngr nelzmu mailzle nimu mz alwx.","poem":1},{"text":"A' na-aoti drtwrmu nqmq krmu mz nzyrbq-lrpi-krmu mz nelvq nyzmu mz nrlckxbq.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zbz na-abrtrpzmu drtwrmu bade,","poem":1},{"text":"X nakabzmu bade blz, mz nzvz-nqblq-krgu natq kc tqkapxmle bagu.","poem":2}]},{"type":"heading","content":["Gct Rnge"]},{"type":"verse","number":6,"content":[{"text":"Yawe, leplz nemqng nzkqlung kx nzrpimlr bange kx, “?Myx mzli kx namnc-zpwx-ngrgu?”","poem":1},{"text":"Delc tqkrka'-ngrbo kx na-amrlzq nigr.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Murde mzli kc tqamrlz-ngrn ninge, abrtz-zlwzx","poem":1},{"text":"Myaszpxle nzabrtzkr leplz kx dakxnzng nadr x waen mqdr kqlu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mzli kc tqyrbq-ngrne, mwi-angidrx mz nrlckxbq,","poem":1},{"text":"Murde nim kx aclve-zpwxle ninge.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}