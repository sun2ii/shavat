 nelznge vzdzm,","poem":1},{"text":"A' sa na-abrtxtrpwo drtwrnge bam.","poem":2},{"text":"Murde naglqlz-mou-ngrne nim kalr,","poem":1},{"text":"Mzli kc na-arlapxq ninge.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}