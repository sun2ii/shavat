{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":44,"content":[{"type":"heading","content":["Drtwrgr Esz'tipe Kx Sa Nabzpekr"]},{"type":"hebrew_subtitle","content":["Nabz ne nqvi lr Kora kx nzyrbzlr mz kxrmailz ngr dzbe kxnzngrng."]},{"type":"heading","content":["Be Ngr Melrmqgung"]},{"type":"verse","number":1,"content":[{"text":"Gct, xlrpekr nrpa ngr da kxetuting kcng tqalebzme mz melrmqgrng mzli kc bqnc,","poem":1},{"text":"Mz nzpi-krmlrle bagr mzli kc.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nzayrplapx-krm lr mrkzbleng apule lxbi kc tzbolvzti mz nrlanc nyzm.","poem":1},{"text":"X petio-alzuq leplz nemqng mz drtc' nyzdr mz nzamnc-zpwx-krm nidr.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Melrmqgr lcng trnzaovxiolru enqmi rdrng mz toki r vea scdr x mz zmatq ngrdr esz'-krdr.","poem":1},{"text":"A' leplz nemqng nzaovxiong mz zmatq ngrm, mz nzxplr-krm, x mz nzmnc-krbzme badr mz nzaodu-krm nidr.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gct, nim King rnge.","poem":1},{"text":"Nim kx rngi-batrp nzaovxio-krgr, nigr neidu lr Jekop.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Milxtxopekr enqmi rgrng mz nzxplr-krm.","poem":1},{"text":"X rnzlvzokr kxnzatrkatilr nigr mz zmatq ngr drtqm.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Murde trbrtiu drtwrnge popz' x toki r vea scnge","poem":1},{"text":"Nzarlapx-krdr ninge mz nzotangr.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A' ni-txpwzme kx arlapxle nigr mz enqmi rgrng,","poem":1},{"text":"Mz nzamyati-krbzme drtqdr.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sa naglqlz-zvzkr nim.","poem":1},{"text":"X nzawi-krbzkr bam tqvzpe tqvzpe.","poem":2}]},{"type":"heading","content":["Enqmi Rgung"]},{"type":"verse","number":9,"content":[{"text":"?A' memule drtqm tqsatrpe-ngrmle bagr, trokatrpe-ngrnqu ncblo ngr vea negrng?","poem":1},{"text":"Mzli ka rlrtx-ngrpwzme mz enqmi rgrng nzamyati-krmlr drtqgr.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"X ngi-batrpeme nzdwasz-krgr nidr,","poem":1},{"text":"X nztwz-krdr dztugrng amrlx.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"X rlr-ngrbzme badr nznibq-krdr nigr mz nzapu-krgr sip,","poem":1},{"text":"X nzvzmilr nigr mz drtc' nyzdrng mz nzwz-nrbalqtr-krbzkr badr.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Apule kx amwabzme nigr badr mz narncbr kx topwzne,","poem":1},{"text":"Mz nzapusr-krm nigr brmrda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lr mrkzbleng kcng tzmnc-aepztrpqng bagr nznelvzlr nigr mz nzamyati-krmlr drtqgr,","poem":1},{"text":"X nzxtrnga-ngrdr nigr.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"X neidu mz nrlc tulvzo nzobqszo-ngrdr nigr","poem":1},{"text":"Mz nzyrpalelvz-krdr nigr.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Aputr-zvzbo da kxtrka mz nzobqkr leplz lcng,","poem":1},{"text":"X drtqnge mya zvz.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Murde xlrx natq kxtrka kcng tzpimlr bange,","poem":1},{"text":"X mcx nzmnc-krm enqmi rngeng.","poem":2}]},{"type":"heading","content":["Vz-nqblq-zvzku Gct"]},{"type":"verse","number":17,"content":[{"text":"Kxmule-esz' nzprtzmqng bagr da lcng","poem":1},{"text":"A' trmrbrtru mz drtwrgr nim x Nzesz'tikr Drtwrgu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kxmule-esz' traxtxpekru nim,","poem":1},{"text":"X o-zli-zvzkr nzti rm,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"A' katrpzme nigr mz mq enqmi rgrng mz nzrnzbrti-krdr nigr, mz nzapu-krdr kuli kzpetong.","poem":1},{"text":"X nzaovxiolr nigr x kzdung nigr nzyrtzmqpeng mz gq.","poem":2}]},{"type":"heading","content":["Nzkrka'-krgu"]},{"type":"verse","number":20,"content":[{"text":"Gct rgr, nzmu navecpx-lzbqmgr bam,","poem":1},{"text":"Mz nzangio-krgr gct kzble,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tryc-kapqpwzu bam,","poem":1},{"text":"Murde obqplxq nabzgr.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"A' mz nzngini-krgr doa nemqng, vz zvz nznibqti-krdr nigr,","poem":1},{"text":"Mz nzapusr-krdr nigr sip kcng tzmnc-nabung mz nzrnibqngr nidr.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kxetu rgr, bzkq esablqme. ?Memule tro-lxlvr-ngrpwe'u bagr?","poem":1},{"text":"Vz-anim, x bzkq pxtxpx-ngrn nigr.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lxlvrm bagr,","poem":1},{"text":"Mz nzdcpxkr mz drtwrm nzetqkr drtqgr x nzkxpu-krgr.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Drtwrgr esz'tipe kx sa nabzpekr,","poem":1},{"text":"Mz nztangqgxlz-krmgr mz drtc'.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Gct, vz-anim x okatrp nigr.","poem":1},{"text":"Arlapx nigr murde aodu-zvzq nigr.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}