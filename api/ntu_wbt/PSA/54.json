:[{"text":"Yawe Gct, ayzlu-mopwz badr da kxtrka kcng tzwaisr-ngrdr ninge.","poem":1},{"text":"X nibq nidr murde nim kx brti drtwr.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zbz sa na-abrtzlvzx nzrka-krbo bam blz mz olta nyzm.","poem":1},{"text":"X na-awi-ngrbo bam nzmrlz-zlwz-krm.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Murde arlapxq ninge mz nzkxpu-krngeng amrlx,","poem":1},{"text":"X okatrq ninge mz nzaovxio-krnge enqmi rngeng.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}