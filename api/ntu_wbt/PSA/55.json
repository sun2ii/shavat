{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":55,"content":[{"type":"heading","content":["Kxdrka'-ngrng X Kxamwale Kztede"]},{"type":"hebrew_subtitle","content":["Nabz ne Devet kx yrbzle mz kxrmailz ngr dzbe kxnzngrng, mz nzayrningr gita."]},{"type":"heading","content":["Nzkrka'ngr"]},{"type":"verse","number":1,"content":[{"text":"Gct, xlrm nzkrka'-krbo bam.","poem":1},{"text":"X bzkq drtqm satrp nzycmne-krbo bam.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lalztqm bange x ayzlum natqnge,","poem":1},{"text":"Murde nabznge tropxpeu mz nztalvzo-krde.","poem":2}]},{"type":"heading","content":["Nzetqkr Drtq"]},{"type":"verse","number":3,"content":[{"text":"Enqmi rngeng nzrkatrpqng bange nzkxpungr,","poem":1},{"text":"Mz nzxngitr-krnge nzycmne-kato-krdr,","poem":2},{"text":"Mz nzrnzlvzo-krdr ninge,","poem":1},{"text":"X nzobq-krmlr bange mz zngya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nelznge vzdz-zlwzm,","poem":1},{"text":"Murde ycpe pipz nzbz-krnge.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rnrcti-lzbqpenge mz zmwxlr,","poem":1},{"text":"X nrkrdrtqnge esz'pe-ngrde.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"X rpix mz drtwrnge kx, “Nzmu nabxnge naycbzle, da kc tqwai bona,","poem":1},{"text":"Nalvcx x nartangrx me namnc-zpwx-ngrne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nalvctr-rlrux lzke,","poem":1},{"text":"X namnc-lrpix esz'-krnge mrlcde.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na-anitxpwo nzrtangrti-krnge me narlakitrx","poem":1},{"text":"Mz tewa x nounenq.”","poem":2}]},{"type":"heading","content":["Nzkrka'ngr"]},{"type":"verse","number":9,"content":[{"text":"Kxetu, akipx kxdrka'-ngrng mz nzarlxlvrti-krbzme natqdr.","poem":1},{"text":"Murde nzota-zvzng x nznani-lzbq-zvzng mz mztea.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mz nrlckxngrlx x nrlckxbq","poem":1},{"text":"Mztea esz'tx-ngrpwz nzxpqbrlrngr lou x nzkxpungr.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nzodangr prtz-zvzm mrlcng kqlu mz mztea.","poem":1},{"text":"X me nzamwangr da tresakipxpuu nzpokiangr x nzangqngutingr leplz.","poem":2}]},{"type":"heading","content":["Kxamwa Kztede"]},{"type":"verse","number":12,"content":[{"text":"Kztenge, mzli kc ryapwx-angidrki mz nzodu-krgi,","poem":1},{"text":"X vztr-lxblrki mz Mangr-nzangiongr Gct.","poem":2},{"text":"A' mzli ka trngiu enqmi rnge kc tqxtrnga-ngrde ninge,","poem":1},{"text":"A' krlc nim, kc tqmuki me esz' x line-zvzki.","poem":2},{"text":"X trngiu kxpxtxpx-ngrde ninge kc tqyrpalelvzle ninge,","poem":1},{"text":"A' krlc nim, mrlxkztenge.","poem":2},{"text":"Mz nzatrkatikr enqmi rnge ninge","poem":1},{"text":"Nabznge trtalvzou x krlzx nzmnc-kapqngr,","poem":2},{"text":"A' nzamwa-krm lc ninge, kx mzlenge,","poem":1},{"text":"Delc tqvztx-zlwzngr drtwrnge.","poem":2}]},{"type":"heading","content":["Nzkrka'ngr"]},{"type":"verse","number":15,"content":[{"text":"Gct, ayrkrpx-anibz enqmi lcng nabzdr x nzao-krdr drtwrdr tqdrka'ngr,","poem":1},{"text":"Murde napwrkilvc-ngrdr nzbz-krdr.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawe, mzli kc nayrni-ngrbo bam,","poem":1},{"text":"Krlzx kx sa na-arlapxq ninge.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Murde sa naxlrme natqnge mz nourla, bea, x mz nrlckxbq,","poem":1},{"text":"Mz nzkalz-zvz-krbo bam nzlckr drtwrnge x nztalvzokr nabznge.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kxmule-esz' enqmi rngeng nzkqlung, a' mzli kcpe naota-ngrgr badr,","poem":1},{"text":"Sa na-amnc-zpwxq ninge mz mzlirdr.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Murde nim Gct kc nzaclve-krde tqyc tqyc.","poem":1},{"text":"X sa na-ayzlume natqnge lcng mz nzaovxio-krm nidr mz nzotangr.","poem":2},{"text":"Murde nzpxtxpx-ngrdr nztekqtr-krdr nqmq krdr,","poem":1},{"text":"X trnzamrlue-kzlru nim.","poem":2}]},{"type":"heading","content":["Kxamwa Kztede"]},{"type":"verse","number":20,"content":[{"text":"Mrlxkztenge lc, mzli kc nigr badr dzbede kxesz', a' mzli ka yrlqpx-lzbq mz nzesz'tikr drtwrgr badr.","poem":1},{"text":"A' se tqrtwztipele nigr zngya tqotapekr badr.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nzprlxpx-krde nivz narpi-ngrbz nide ncblo ngrde,","poem":1},{"text":"A' mz nabzde la poi kx mu ncblo.","poem":2},{"text":"Mz nzycmne-krde nide pakrle,","poem":1},{"text":"A' natqdeng malc apule toki r vea.","poem":2}]},{"type":"heading","content":["Nzkrka'ngr"]},{"type":"verse","number":22,"content":[{"text":"Yawe, napipxbzkr nzkxpu-krgrng bam, murde nalolvz-amqngiq nigr.","poem":1},{"text":"X tr-rlrpx-ngrwq leplz kxnztubqng nzaxtx-krbzlr nzlxngiti-krdr nim.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Murde sa nartco-ngrn mz gq lrdr","poem":1},{"text":"Krkcng tzrnibqng x tzpokiang,","poem":2},{"text":"Mzli lc tznginibe-ngrdr obla.","poem":1},{"text":"A' sa na-abrtr-zvzbo drtwrnge bam.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":21}