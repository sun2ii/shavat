{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":6,"content":[{"type":"heading","content":["Drle Mzke'"]},{"type":"hebrew_subtitle","content":["Nabz ne Devet kx yrbzle mz kxrmailz ngr dzbe kxnzngrng."]},{"type":"heading","content":["Nzkrka'ngr"]},{"type":"verse","number":1,"content":[{"text":"Yawe, kxmule-esz' drtwrm ngya,","poem":1},{"text":"A' bzkq pnanatiq x ayrplapxq ninge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kxetu, nayc mz drtwrm ninge murde yangrngapex.","poem":1},{"text":"X axplr mou nrkrdrtqnge murde yagox-zlwzx.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"?Rnrcti-lzbqtrpo bam mz zmwxlr,","poem":1},{"text":"X aenzli-alopex nzokatr-krm ninge?","poem":2}]},{"type":"heading","content":["Nzarlapxngr"]},{"type":"verse","number":4,"content":[{"text":"Yawe, tekqtr drtwrm x arlapx ninge,","poem":1},{"text":"Mz nzaodu-krm kc tqyc tqyc.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Murde mz nzbzngr trpengr nzrglqlzngr nim.","poem":1},{"text":"X mz gq nzangiongr nim kc tqyrkrpxpebz.","poem":2}]},{"type":"heading","content":["Nzyrningr"]},{"type":"verse","number":6,"content":[{"text":"Drtqnge mewepe mz nzkrka'-zvz-krbo bam.","poem":1},{"text":"X mz nrlckxbq kang kqlu, nqni x pilo pnrngenzlrpr-ngrdr drle mzke'.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mzke' vaotxtrpebz x tropxpeu,","poem":1},{"text":"Murde nzyrni-krnge lc nzngi-batrplr enqmi rngeng.","poem":2}]},{"type":"heading","content":["Nzaovxiongr"]},{"type":"verse","number":8,"content":[{"text":"Nimu leplz kxdrka'-ngrng amrlx, dwaszpeamu ninge!","poem":1},{"text":"Murde Yawe sa tqlalztqpem mz nzyrni-krnge.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xlrpemle nike rlxtibo,","poem":1},{"text":"X sa na-ayzlumle natqnge.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Krka'-ngrne kx drtq enqmi rngeng namya x narnrcti-lzbq-kzng mz zmwxlr,","poem":1},{"text":"X naplc-aning mz nzaovxio-krnge nidr.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}