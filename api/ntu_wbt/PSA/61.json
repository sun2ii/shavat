{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":61,"content":[{"type":"heading","content":["Vzmibz Ninge Mz Butqbr Kxmqngi"]},{"type":"hebrew_subtitle","content":["Nabz ne Devet kx yrbzle mz kxrmailz ngr dzbe kxnzngrng."]},{"type":"verse","number":1,"content":[{"text":"Gct, xlrm nzyrni-krnge,","poem":1},{"text":"X lalztqm mz nzkrka'-krnge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kqlex nim murde mncx esz'-krnge, x nabznge talvzo zlwz.","poem":1},{"text":"Vzmibz ninge mz butqbr kxmqngi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Murde nim lrpalvc nyznge,","poem":1},{"text":"Me rlakitrx mz mq enqmi rngeng.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Rlr-ngrm bange nzmncpx-alo-krmc mz ma nyzm.","poem":1},{"text":"Murde na-apux nei kio kx mnc-kapqlzbz mz nabx lxede.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gct, abrtzlvzq nzesalz-krnge nzangrlvz-zvz-krnge nim.","poem":1},{"text":"Murde krlc takitrde leplz kcng tzamrluelr nim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kam bange nzlungr kxboi, ninge king nem,","poem":1},{"text":"Murde nzmnc-krnge navz zvz.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Okatrp ninge mz nzaclve-angidr-krnge leplz nengeng mz nzmnclz-krbo mz zmatq ngrm.","poem":1},{"text":"Ayrbqpx ninge mz nzaodu-zvz-krm ninge x nzangidati-krm natqm.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Delc na-angrlvz-zvzx nim,","poem":1},{"text":"Mz nzale-krnge da kc tqesalz-ngrbo bam.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}