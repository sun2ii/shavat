oem":2}]},{"type":"verse","number":6,"content":[{"text":"Nimu kxnzetung murde kapebo bamu zmatq ngr nzrmailz-krmu.","poem":1},{"text":"X nimu amrlx apuamu mrlxng Gct kc tqmyalz-esz'ngr.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kxmule-esz', a' mrbrtr mz drtwrmu","poem":1},{"text":"Kx zmatq kc tqwz-xgleamu nzkrlz nzrkatxpx-ngrbz,","poem":2},{"text":"Da kc tzwai nzrkatxpxpe-ngrbz zmatq mz kzdung kxnzetung.","poem":1},{"text":"X nabz-kzamu da kc tzwai leplz amrlx mz nzbz-krdr.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gct, vzm mz nzaclve-krm leplz mz nrlc tulvzo,","poem":1},{"text":"Murde lr drtc' amrlx nzmnclzbzng mz zmatq ngrm.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}