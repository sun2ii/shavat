{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":87,"content":[{"type":"heading","content":["Jerusalem Apule Lxe Neidu Amrlx"]},{"type":"hebrew_subtitle","content":["Nabz ne nqvi lr Kora."]},{"type":"verse","number":1,"content":[{"text":"Yawe wz-ngrde mzteadau Jerusalem","poem":1},{"text":"Mz newz kxtr nyzde.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"X mzteadau lc nzmrlzba-krdele","poem":1},{"text":"Myaszpxle mztea kc-kzng ngr Israel.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Delc nimu lr mztea nyzde,","poem":1},{"text":"Naxlr-ngrnamu natq kxmrlz kcng tzycmnetr-ngrdr Jerusalem.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gct rpile kx, “Mzli kc na-aplxtipx-ngrbo leplz nengeng, lr mrkzble kcng tzmnc-ngalelr Israel sa naprtr-kzng mz dzbede nenge,","poem":1},{"text":"Krlcng Ijipt, Bxbilon, Filistia, Taea, x Itiopia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"X sa narpibzlr kx Jerusalem lxe neidu amrlx murde nzrmctitrpzlr nzlungr bade.","poem":1},{"text":"X ninge, Yawe kc tqmyatxlz-esz'ngr, sa na-atu-amqngix nide.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"X sa nayrox drtq leplz amrlx kcng tzbrti drtwrdr ninge,","poem":1},{"text":"Mz nzprtr-krdr mz neidu lr Israel.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"X mzli lcde, leplz nengeng lcng amrlx sa naelang x narpilr mz nzngr-krdr kx,","poem":1},{"text":"‘Mztea nyzgu, Jerusalem, ngi narlue ngr me vzkipxm da kxmrlzting amrlx.’”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}