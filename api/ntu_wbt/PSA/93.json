{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":93,"content":[{"type":"heading","content":["King Kc Tqmyatxlz-esz'ngr"]},{"type":"verse","number":1,"content":[{"text":"Yawe, nim King kc tqmyatxlz-esz'ngr, x rngiscm zmatq.","poem":1},{"text":"Wz-ngrn nrlc x tu-amqngio me yc-ngrde x trycngrlru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nzmnc-krm tqyc tqyc.","poem":1},{"text":"X nzngini-krm King yc pnz kai, x sc tqwz-ate-ngrn dalr nrlc ka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawe, srkau ngr prla, nzalxlvrti-ebir-ngrdr da.","poem":1},{"text":"X natq nrc ngrde aycngrlrle nrlc, mz zmatq kx xplr.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A' nzmyalz-krm myaszpxle srkau.","poem":1},{"text":"X zmatq ngrm myaszpxle nzmatqkr natq nrc, murde nim kc tqmnctxlz tqmatq-esz'ngrn.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawe, Loukxtr scmqng tqvzpe, tqvzpe.","poem":1},{"text":"X Mangr-nzangiongr nim nztr-zlwz-krde tqyc, tqyc.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}