nzbzszng,","poem":1},{"text":"X lr mrkzbleng kx mnckrng badr.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nzrpilr kx, “Trtxpnzngr nzmckr Yawe nigu.","poem":1},{"text":"X trycneu mz drtwr Gct rdr da lcng tqaletikung.”","poem":2}]},{"type":"heading","content":["Yawe Obqplxle Nzaokr Drtwr Leplz"]},{"type":"verse","number":8,"content":[{"text":"A' nimu kx nardr mqngi, nalalztqmamu bange.","poem":1},{"text":"?Myx mzli kx nayrplapx-krlzu-rnamu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"?Mz drtwrmu rpiamu kx Gct kc tqwz-ngrde nradrtqgu x mzku,","poem":1},{"text":"Nradrtqde ngq x mzte mwi?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"X sc tqayrplapxpele lr mrkzbleng.","poem":1},{"text":"?Myx kxmule, trtxpnzngr nzayrplapx-kz-krde nimu?","poem":2},{"text":"X alvztrle leplz amrlx.","poem":1},{"text":"?Mz drtwrmu trpnzngr da kx krlzle?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawe obqplxle nzaokr drtwr leplz,","poem":1},{"text":"X krlzle kx drtwr kx nzyrlqlr mane.","poem":2}]},{"type":"heading","content":["Mrlz Nzpnanatikr Yawe Leplz Nedeng"]},{"type":"verse","number":12,"content":[{"text":"Yawe, namrlzbz mz krkcng tqpnanatiqng,","poem":1},{"text":"Mz nzalvztr-krm nidr mz loukxtr scm.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"X trnarlrpx-ngrnqu nzkxpu-krdr, a' amnc-zpwxq nidr,","poem":1},{"text":"Vz vz mzli kx ayrkro-ngrn kxdrka'-ngrng mz gq.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawe, trpxtxpx-ngrnqu leplz nemqng,","poem":1},{"text":"X tr-rlasz-ngrnqu nigr kcng tqmcpxq.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mzli kc navzm, nzaclvekr kxnzrmailzng sa natubq,","poem":1},{"text":"X krkcng nabzdr tqlqngi sc tzabrtz-ateng.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawe, nim txpwz kx tum mz nibrnge,","poem":1},{"text":"X nim kztenge mz nzarlapx-krbzme ninge mz kxdrka'-ngrng.","poem":2}]},{"type":"heading","content":["Yawe Tu-zvzbzle Mz Nibr Kxnztubqng"]},{"type":"verse","number":17,"content":[{"text":"Nzmu trnaokatrwq ninge,","poem":1},{"text":"Mzli trnaboiu x ninge kc tqbzpex.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"A' mzli kc tqkqle-ngrne nim mz nzkxpu-krnge,","poem":1},{"text":"Lolvz-amqngiq ninge mz nivz lrm.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"X mzli kc tqtalvzongr drtwrnge,","poem":1},{"text":"Zvz amqtrpe' drtwrnge x abrtz-moux.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Px-ngrn nzngi-te-krmu badr kxnzetung kxdrka'-ngrng","poem":1},{"text":"Mz nzrnzlvzo-krdr loukxtr scm.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Murde nzyrlwrpx-lxblr-ngrdr mz nzrpwa'-krdr kxnztubqng,","poem":1},{"text":"X nzaprc-krdr kxnzmrlzng mz nzrnibqngr.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"A' Yawe, Gct rnge, nide lrpalvc nyznge,","poem":1},{"text":"X butqbr kc tqrlakitrx.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yawe, Gct rgr, sa naodatile nidr mz nqmq krdr kc tqtrka,","poem":1},{"text":"Mz nzrtxlvzlz-krdr alwx ngrdrng amrlx.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}