{"translation":{"id":"ntu_wbt","name":"Nzryrngrkxtr Kc Ate Rut x Sam","website":"https://ebible.org/Scriptures/details.php?id=ntu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ntu","licenseNotes":null,"shortName":"WBT","englishName":"Natqgu NT+Ruth and Psalms","language":"ntu","textDirection":"ltr","sha256":"fab2eba156d5f1665e6e89ec9f41c1e849f50b3607cc8da2c37a8343a5e1f7de","availableFormats":["json"],"listOfBooksApiLink":"/api/ntu_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":414,"totalNumberOfVerses":10028,"languageName":"Natügu","languageEnglishName":"Natügu"},"book":{"id":"PSA","translationId":"ntu_wbt","name":"Sam","commonName":"Sam","title":"Buk Ngr Sam","order":19,"numberOfChapters":150,"sha256":"5914475595822b1b258cd9c63510267655669c1d9928171e46ef62e9d590f37f","firstChapterNumber":1,"firstChapterApiLink":"/api/ntu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ntu_wbt/PSA/150.json","totalNumberOfVerses":2295},"chapter":{"number":98,"content":[{"type":"heading","content":["Na-angrlvzku Yawe, King Kc Tqmatq-esz'ngr"]},{"type":"heading","content":["Na-angrlvzku Yawe"]},{"type":"verse","number":1,"content":[{"text":"Nangr-ngrbzku mz Yawe nabz kxmrna mz nzale-krde da kcng tqmyapxbzng.","poem":1},{"text":"Murde aovxiole enqmi rdeng mz nzetukr zmatq ngrde.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"X sc tqaelwapxpe-ngrbzle nztubq-krde mz lr mrkzbleng amrlx,","poem":1},{"text":"Mz nzarlapx-krbzle leplz nedeng mz mq enqmi rdrng.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"X aodule nigu lr Israel mz nzatutr-zvz-krde natqde.","poem":1},{"text":"Murde leplz mz nrlc tulvzo nakrlzlr kx arlapxle nigu.","poem":2}]},{"type":"heading","content":["Naglqpxku Nide"]},{"type":"verse","number":4,"content":[{"text":"Nigu leplz amrlx mz nrlc na-angrlvzku Yawe","poem":1},{"text":"Mz nabz kx yrlvi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naglqpxku nide","poem":1},{"text":"Mz nzayrni-krbzku bade gita,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"X mz nzvxu-krbzku trpu.","poem":1},{"text":"Na-angrlvzku Yawe, kc tqngi King!","poem":2}]},{"type":"heading","content":["Nangrbzku Bade"]},{"type":"verse","number":7,"content":[{"text":"Nimu prla x drtc' x dalrmung amrlx","poem":1},{"text":"Drtwrmu naelalzm!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nimu lue na-amqmq-lzbqamu mz nztalio-krmu mz nabzde.","poem":1},{"text":"X nimu newz na-angrlvzamu Yawe!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nigu amrlx nangrbzku bade.","poem":1},{"lineBreak":true},{"text":"Murde sa tqvzm mz nzaclve-krde lr nrlc,","poem":1},{"text":"X nzayzlu-krbzle da mz leplz sa natubq x narsakrlrngr.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ntu_wbt/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ntu_wbt/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ntu_wbt/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}