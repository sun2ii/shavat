{"translation":{"id":"nuy_bsa","name":"Ana-Maṉngulg Ana-Wubiba -- Anu-gadhuwa Ana-lhaawu","website":"https://ebible.org/Scriptures/details.php?id=nuy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nuy","licenseNotes":null,"shortName":"BSA","englishName":"Wubuy Shorter  Bible","language":"nuy","textDirection":"ltr","sha256":"49afb1977bd7528a914d3cbc7e0694ba8dfe1edd0bf4c4d32e9406e801f6b5f2","availableFormats":["json"],"listOfBooksApiLink":"/api/nuy_bsa/books.json","numberOfBooks":30,"totalNumberOfChapters":279,"totalNumberOfVerses":8266,"languageName":"Nunggubuyu","languageEnglishName":"Nunggubuyu"},"book":{"id":"JON","translationId":"nuy_bsa","name":"Jonah","commonName":"Jonah","title":"JONAH","order":32,"numberOfChapters":4,"sha256":"4938371a9b74b1064b210d6fb843505e6a4e69acc782feefe0c4bb5dab84f635","firstChapterNumber":1,"firstChapterApiLink":"/api/nuy_bsa/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/nuy_bsa/JON/4.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Na-Jonah aniiḏii na-God-guy."]},{"type":"verse","number":1,"content":["Naagi-yung na-Jonah ni-bu-burri ana-lhirribala a-ngujija-rruj. Marri ni-yambini na-Yawei-wuy na-God. Ni-yamaa,"]},{"type":"verse","number":2,"content":[{"text":"“Nga-wurrij-galadi-wiiyn anaani Yawei,","poem":1},{"text":"marri ngaaḏangi nugawi-wuy.","poem":2},{"text":"Marri nimba-yaynjangani ngaya, amaar-lhirribala-wala a-lhal wubani-rruj wu-ngawina-yinyung, ngaya ngaaḏangi ‘Nimba-maṉmang!’","poem":1},{"text":"marri nagang nimba-yaynjangani ngaya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nugawaj numba-barawudiyn amaar-lhirribala-wuy.","poem":1},{"text":"Nga lhirribala ama-lhagayag-duj, nga mana-lhagayag ngamaambamadhiyn ngaya,","poem":2},{"text":"nugawi-nyinyung maar-waladhaa ma-wadbarrini,","poem":1},{"text":"marri ngamaambamadhiyn ngaya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngaya yingga ngaan-jamayn, nimba-barawudiyn nugawi-wala,","poem":1},{"text":"nga yagi ngawu-ni nugawi-nyinyung ana-maṉngulg ana-wumurrng ngijang,","poem":2},{"lineBreak":true},{"text":"anubani-rruj ngayawi-nyinyung ana-lhal.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mana-lhagayag ngamaambamadhiyn, nga ngama-yingalandi ngaya.","poem":1},{"text":"Mana-lhagayag ngamaambamadhiyn-bindiyung, nga mana-mungulu ngama-yinag-gabaabaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngaya nga-dhirridiyn ama-mangujang-guy ama-ṉuga,","poem":1},{"text":"wubani-yung a-lhal wudhawang wu-dhidina-yinyung wuguuguni.","poem":2},{"text":"Ngaya anaani ngaaḻamin-jamaa, ana-wiri anggu-jadugini,","poem":1},{"text":"yagu Yawei, ngayawi-nyinyung na-God, ngaya nga-yambiyn nugawi-wuy,","poem":2},{"text":"marri nagang Yawei, nimba-yaynjangani ngaya, nugawi-wala a-maṉngulg-gala a-wumurrng.","poem":1},{"text":"Marri nagang nimba-wiri-gayn ngaya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wugurraayung warruburru-yung wurru-maṉdhangi-yinyung ana-rangag marri aynba-gaynbaj-jinyung wurru-warraarriwana-yinyung,","poem":1},{"text":"waari ambi-ngaynbandang nagang.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yagu ngaya-waj nga-mayana warraarriwana nugawi-wuy, ngaya wiiyn wujiigurung nga ngunu-lhalamayana.","poem":1},{"text":"Yawei, nagang nimba-wiri-gana-yinyung nurru anaani.”","poem":2},"Dani-yung ni-yamaa na-Jonah, ana-lhaawu."]},{"type":"verse","number":10,"content":["Anubanila-wala, na-Yawei ni-yamijgayn ana-ngujija, nga ninggu-lhagaliyn na-Jonah ama-madhaḻag-duj."]}],"footnotes":[]},"thisChapterLink":"/api/nuy_bsa/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nuy_bsa/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nuy_bsa/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":9}