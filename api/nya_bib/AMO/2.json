{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"AMO","translationId":"nya_bib","name":"AMOSI","commonName":"AMOSI","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"f807829ea7406ae15bf121db8a2b075a7a0d0d8bc6c420d48fdce3a4ae04fe61","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/nya_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Yehova akuti,",{"text":"“Chifukwa anthu a ku Mowabu akunka nachimwirachimwira,","poem":1},{"text":"Ine sindileka kuwalanga.","poem":2},{"text":"Popeza anatentha mafupa a mfumu ya ku Edomu,","poem":1},{"text":"mpaka kuwasandutsa phulusa,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ine ndidzatumiza moto pa Mowabu,","poem":1},{"text":"umene udzanyeketsa nyumba zaufumu za ku Keriyoti.","poem":2},{"text":"Mowabu adzafera pakati pa nkhondo yoopsa,","poem":1},{"text":"mʼkati mwa mfuwu wa nkhondo ndi kuliza malipenga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndidzawononga wolamulira wake","poem":1},{"text":"ndi kupha akuluakulu onse amene ali pamodzi ndi iye,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":4,"content":["Yehova akuti,",{"text":"“Chifukwa anthu a ku Yuda akunka nachimwirachimwira,","poem":1},{"text":"Ine sindileka kuwalanga.","poem":2},{"text":"Popeza iwo akana lamulo la Yehova","poem":1},{"text":"ndipo sanasunge malangizo ake,","poem":2},{"text":"popeza asocheretsedwa ndi milungu yabodza,","poem":1},{"text":"milungu imene makolo awo ankayitsatira,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ine ndidzatumiza moto pa Yuda,","poem":1},{"text":"umene udzanyeketsa nyumba zaufumu za ku Yerusalemu.”","poem":2}]},{"type":"heading","content":["Chilango cha Anthu a ku Israeli"]},{"type":"verse","number":6,"content":["Yehova akuti,",{"text":"“Chifukwa anthu a ku Israeli akunka nachimwirachimwira,","poem":1},{"text":"Ine sindileka kuwalanga.","poem":2},{"text":"Iwo amagulitsa anthu olungama ndi siliva,","poem":1},{"text":"ndi osauka ndi nsapato.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amapondereza anthu osauka","poem":1},{"text":"ngati akuponda fumbi,","poem":2},{"lineBreak":true},{"text":"ndipo sawaweruza mwachilungamo anthu oponderezedwa.","poem":2},{"text":"Abambo ndi mwana wawo amagonana ndi mtsikana mmodzi yemweyo,","poem":1},{"text":"ndipo potero amanyozetsa dzina langa loyera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anthuwo amakagonana mʼmbali mwa guwa lililonse la nsembe","poem":1},{"text":"pa zovala zimene anatenga ngati chikole.","poem":2},{"text":"Mʼnyumba ya mulungu wawo","poem":1},{"text":"amamweramo vinyo amene analipiritsa anthu pa milandu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ine ndinawononga Aamori pamaso pawo,","poem":1},{"text":"ngakhale iwo anali anthu ataliatali ngati mikungudza","poem":2},{"lineBreak":true},{"text":"ndiponso amphamvu ngati mitengo ya thundu.","poem":2},{"text":"Ndinawononga zipatso zawo","poem":1},{"text":"ndiponso mizu yawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ine ndinakutulutsani ku Igupto,","poem":1},{"text":"ndipo ndinakutsogolerani mʼchipululu kwa zaka makumi anayi,","poem":2},{"lineBreak":true},{"text":"kudzakupatsani dziko la Aamori.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ine ndinawutsanso ena mwa ana ako kuti akhale aneneri,","poem":1},{"text":"ndi ena mwa anyamata ako kuti akhale anaziri.","poem":2},{"text":"Kodi si choncho, inu Aisraeli?”","poem":1},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"“Koma inu munawamwetsa vinyo anaziri aja,","poem":1},{"text":"ndipo munalamula aneneri kuti asanenere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Tsono Ine ndidzakupsinjani","poem":1},{"text":"monga imapsinjikira ngolo imene yadzaza ndi tirigu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Munthu waliwiro sadzatha kuthawa,","poem":1},{"text":"munthu wamphamvu sadzakhalanso ndi nyonga,","poem":2},{"lineBreak":true},{"text":"wankhondo sadzapulumutsa moyo wake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Munthu wa uta sadzalimbika,","poem":1},{"text":"msilikali wothamanga kwambiri sadzapulumuka,","poem":2},{"lineBreak":true},{"text":"ndipo wokwera pa akavalo sadzapulumutsa moyo wake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngakhale asilikali olimba mtima kwambiri","poem":1},{"text":"adzathawa ali maliseche pa tsikulo,”","poem":2},{"text":"akutero Yehova.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}