{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"AMO","translationId":"nya_bib","name":"AMOSI","commonName":"AMOSI","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"f807829ea7406ae15bf121db8a2b075a7a0d0d8bc6c420d48fdce3a4ae04fe61","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/nya_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Mboni Zotsutsa Israeli"]},{"type":"verse","number":1,"content":["Inu Aisraeli, imvani mawu awa amene Yehova wayankhula kutsutsana nanu, kutsutsana ndi banja lonse limene analitulutsa mu Igupto:"]},{"type":"verse","number":2,"content":[{"text":"“Inu nokha ndi amene ndinakusankhani","poem":1},{"text":"pakati pa mabanja onse a dziko lapansi;","poem":2},{"text":"nʼchifukwa chake ndidzakulangani","poem":1},{"text":"chifukwa cha machimo anu onse.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kodi anthu awiri nʼkuyendera limodzi","poem":1},{"text":"asanapangane?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kodi mkango umabangula mʼnkhalango","poem":1},{"text":"usanagwire nyama?","poem":2},{"text":"Kodi msona wamkango umalira mʼphanga mwake","poem":1},{"text":"pamene sunagwire kanthu?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kodi mbalame nʼkutera pa msampha","poem":1},{"text":"pamene palibe nyambo yake?","poem":2},{"text":"Kodi msampha umafwamphuka","poem":1},{"text":"usanakole kanthu?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kodi pamene lipenga la nkhondo lalira mu mzinda,","poem":1},{"text":"anthu sanjenjemera?","poem":2},{"text":"Pamene tsoka lafika mu mzinda,","poem":1},{"text":"kodi si Yehova amene wachititsa zimenezo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zoonadi Ambuye Yehova sachita kanthu","poem":1},{"text":"asanawulule zimene akufuna kuchita","poem":2},{"lineBreak":true},{"text":"kwa atumiki ake, aneneri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mkango wabangula,","poem":1},{"text":"ndani amene sachita mantha?","poem":2},{"text":"Ambuye Yehova wayankhula,","poem":1},{"text":"ndani amene sanganenere?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lengezani zimenezi ku nyumba zaufumu za ku Asidodi","poem":1},{"text":"ndiponso ku nyumba zaufumu za ku Igupto:","poem":2},{"text":"“Sonkhanani ku mapiri a ku Samariya;","poem":1},{"text":"onani chisokonezo pakati pake","poem":2},{"lineBreak":true},{"text":"ndiponso kuponderezana pakati pa anthu ake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Iwo sadziwa kuchita zolungama,","poem":1},{"text":"ndipo amadzaza malo awo otetezedwa ndi zinthu zolanda ku nkhondo ndi zakuba,” akutero Yehova.","poem":2}]},{"type":"verse","number":11,"content":["Nʼchifukwa chake Ambuye Yehova akunena izi:",{"text":"“Mdani adzalizungulira dzikoli;","poem":1},{"text":"iye adzagwetsa malinga ako,","poem":2},{"lineBreak":true},{"text":"ndi kufunkha nyumba zako zaufumu.”","poem":2}]},{"type":"verse","number":12,"content":["Yehova akuti,",{"text":"“Monga mʼbusa amalanditsa mʼkamwa mwa mkango","poem":1},{"text":"miyendo iwiri yokha kapena msonga yokha ya khutu,","poem":2},{"lineBreak":true},{"text":"moteronso ndimo mmene adzapulumukire Aisraeli","poem":2},{"text":"amene amakhala mu Samariya","poem":1},{"text":"pa msonga za mabedi awo,","poem":2},{"lineBreak":true},{"text":"ndi ku Damasiko pa akakhutagona awo.”","poem":2}]},{"type":"verse","number":13,"content":["“Imvani izi ndipo mupereke umboni wotsutsa nyumba ya Yakobo,” akutero Ambuye, Yehova Mulungu Wamphamvuzonse."]},{"type":"verse","number":14,"content":[{"text":"“Pa tsiku limene ndidzalange Israeli chifukwa cha machimo ake,","poem":1},{"text":"ndidzagumula maguwa ansembe a ku Beteli;","poem":2},{"text":"nyanga za guwa zidzathyoka","poem":1},{"text":"ndipo zidzagwa pansi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndidzagwetsa nyumba ya pa nthawi yozizira","poem":1},{"text":"pamodzi ndi nyumba ya pa nthawi yotentha;","poem":2},{"text":"nyumba zokongoletsedwa ndi minyanga ya njovu zidzawonongedwa","poem":1},{"text":"ndipo nyumba zikuluzikulu zidzaphwasulidwa,”","poem":2},{"text":"akutero Yehova.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}