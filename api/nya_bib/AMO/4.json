{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"AMO","translationId":"nya_bib","name":"AMOSI","commonName":"AMOSI","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"f807829ea7406ae15bf121db8a2b075a7a0d0d8bc6c420d48fdce3a4ae04fe61","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/nya_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["Israeli Sanabwerere kwa Mulungu"]},{"type":"verse","number":1,"content":[{"text":"Imvani mawu awa, inu ngʼombe zazikazi za ku Basani, okhala pa Phiri la Samariya,","poem":1},{"text":"inu akazi amene mumapondereza anthu osauka ndi kuzunza anthu osowa","poem":2},{"lineBreak":true},{"text":"ndi kumanena kwa amuna anu kuti, “Tipatseni zakumwa!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ambuye Yehova, mwa kuyera mtima kwake walumbira kuti,","poem":1},{"text":"“Nthawi idzafika ndithu","poem":2},{"text":"pamene adzakukokani ndi ngowe,","poem":1},{"text":"womaliza wa inu adzakokedwa ndi mbedza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mudzatulukira mʼmingʼalu ya pa khoma","poem":1},{"text":"aliyense payekhapayekha,","poem":2},{"lineBreak":true},{"text":"ndipo mudzatayidwa ku Harimoni,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"“Bwerani ku Beteli mudzachimwe;","poem":1},{"text":"ndi ku Giligala kuti mudzapitirize kuchimwa.","poem":2},{"text":"Bweretsani nsembe zanu mmawa uliwonse,","poem":1},{"text":"bweretsani chakhumi chanu masiku atatu aliwonse.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wotchani buledi wokhala ndi yisiti ngati nsembe yachiyamiko","poem":1},{"text":"ndi kumanyadira poyera za zopereka zanu zaufulu.","poem":2},{"text":"Inu Aisraeli, zinyadireni nsembezo,","poem":1},{"text":"pakuti izi ndi zimene mumakonda kuchita,”","poem":2},{"text":"akutero Ambuye Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ndine amene ndinakusendetsani milomo mʼmizinda yanu yonse,","poem":1},{"text":"ndipo munasowa chakudya mʼmizinda yanu.","poem":2},{"lineBreak":true},{"text":"Komatu inu simunabwerere kwa Ine,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ndinenso amene ndinamanga mvula","poem":1},{"text":"patangotsala miyezi itatu kuti mukolole.","poem":2},{"text":"Ndinagwetsa mvula pa mzinda wina,","poem":1},{"text":"koma pa mzinda wina ayi,","poem":2},{"text":"mvula inkagwa pa munda wina;","poem":1},{"text":"koma sinagwe pa munda wina ndipo mbewu zinawuma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anthu ankayenda mzinda ndi mzinda kufuna madzi,","poem":1},{"text":"koma sanapeze madzi okwanira kumwa.","poem":2},{"lineBreak":true},{"text":"Komabe inu simunabwerere kwa Ine,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Nthawi zambiri ndinakantha mbewu zanu ndiponso minda ya mpesa,","poem":1},{"text":"ndinayikantha ndi chinsikwi ndiponso ndi chiwawu.","poem":2},{"text":"Dzombe linawononga mikuyu yanu ndi mitengo ya olivi.","poem":1},{"text":"Komabe inu simunabwerere kwa Ine,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ine ndinabweretsa miliri pakati panu","poem":1},{"text":"monga ndinachitira ku Igupto.","poem":2},{"text":"Ndinapha anyamata anu ndi lupanga,","poem":1},{"text":"ndinapereka akavalo anu kwa adani.","poem":2},{"text":"Ndinakununkhitsani fungo la mitembo lochokera mʼmisasa yanu ya nkhondo.","poem":1},{"text":"Komatu inu simunabwerere kwa Ine,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ndinawononga ena mwa inu","poem":1},{"text":"monga ndinawonongera Sodomu ndi Gomora.","poem":2},{"text":"Inu munali ngati chikuni choyaka chimene chafumulidwa pa moto.","poem":1},{"text":"Komabe inu simunabwerere kwa Ine,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Choncho izi ndi zimene ndidzakuchitire iwe Israeli,","poem":1},{"text":"chifukwa ndidzakuchitira zimenezi,","poem":2},{"lineBreak":true},{"text":"konzekera kukumana ndi Mulungu wako, iwe Israeli.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Iye amene amawumba mapiri,","poem":1},{"text":"amalenga mphepo,","poem":2},{"lineBreak":true},{"text":"ndipo amawululira munthu za mʼmaganizo ake,","poem":2},{"text":"Iye amene amasandutsa usana kuti ukhale mdima,","poem":1},{"text":"ndipo amayenda pa zitunda za dziko lapansi,","poem":2},{"lineBreak":true},{"text":"dzina lake ndi Yehova Mulungu Wamphamvuzonse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}