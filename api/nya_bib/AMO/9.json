{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"AMO","translationId":"nya_bib","name":"AMOSI","commonName":"AMOSI","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"f807829ea7406ae15bf121db8a2b075a7a0d0d8bc6c420d48fdce3a4ae04fe61","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/nya_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["Israeli Adzawonongedwa"]},{"type":"verse","number":1,"content":["Ine ndinaona Ambuye atayima pambali pa guwa lansembe, ndipo anati:",{"text":"“Kantha mitu ya nsanamira","poem":1},{"text":"kuti ziwundo za nyumba zigwedezeke.","poem":2},{"text":"Muzigwetsere pa mitu ya anthu onse,","poem":1},{"text":"onse amene atsalira ndidzawapha ndi lupanga.","poem":2},{"text":"Palibe ndi mmodzi yemwe amene adzathawe,","poem":1},{"text":"palibe amene adzapulumuke.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngakhale atakumba pansi mpaka ku malo a anthu akufa,","poem":1},{"text":"dzanja langa lidzawatulutsa kumeneko.","poem":2},{"text":"Ngakhale atakwera kumwamba","poem":1},{"text":"Ine ndidzawatsakamutsa kumeneko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngakhale atakabisala pamwamba pa phiri la Karimeli,","poem":1},{"text":"Ine ndidzawasaka kumeneko ndi kuwagwira.","poem":2},{"text":"Ngakhale atakabisala pansi pa nyanja yayikulu,","poem":1},{"text":"ndidzalamula njoka kuti iwalume kumeneko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngakhale adani awo awakusire ku ukapolo,","poem":1},{"text":"ndidzalamula lupanga kuti liwaphe kumeneko.","poem":2},{"text":"Ndidzawayangʼanitsitsa","poem":1},{"text":"kuti zoyipa ziwagwere; osati zabwino.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ambuye Yehova Wamphamvuzonse","poem":1},{"text":"amene amakhudza dziko lapansi ndipo dzikolo limasungunuka,","poem":2},{"lineBreak":true},{"text":"onse amene amakhala mʼmenemo amalira.","poem":2},{"text":"Dziko lonse lidzadzaza ngati mtsinje wa Nailo,","poem":1},{"text":"kenaka nʼkuphwera ngati mtsinje wa ku Igupto.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iye amene amamanga malo ake okhalamo kumwamba,","poem":1},{"text":"ndi kuyika maziko ake pa dziko lapansi,","poem":2},{"text":"Iye amene amayitana madzi a ku nyanja","poem":1},{"text":"ndikuwakhuthulira pa dziko lapansi,","poem":2},{"lineBreak":true},{"text":"dzina lake ndiye Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Kodi kwa Ine, inu Aisraeli, simuli","poem":1},{"text":"chimodzimodzi ndi Akusi?”","poem":2},{"text":"Akutero Yehova.","poem":4},{"text":"“Kodi sindine amene ndinatulutsa Israeli ku Igupto,","poem":1},{"text":"Afilisti ku Kafitori","poem":2},{"lineBreak":true},{"text":"ndi Aaramu ku Kiri?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Taonani, maso a Ambuye Yehova","poem":1},{"text":"ali pa ufumu wochimwawu.","poem":2},{"text":"Ndidzawufafaniza","poem":1},{"text":"pa dziko lapansi.","poem":2},{"text":"Komabe sindidzawononga kotheratu","poem":1},{"text":"nyumba ya Yakobo,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"“Pakuti ndidzalamula,","poem":1},{"text":"ndipo ndidzagwedeza nyumba ya Israeli","poem":2},{"lineBreak":true},{"text":"pakati pa mitundu yonse ya anthu","poem":2},{"text":"monga momwe amasefera ufa mʼsefa,","poem":1},{"text":"koma palibe nʼkamwala kamodzi komwe kamene kadzagwe pansi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anthu onse ochimwa pakati pa anthu anga","poem":1},{"text":"adzaphedwa ndi lupanga,","poem":2},{"text":"onse amene amanena kuti,","poem":1},{"text":"‘Tsoka silidzatigwera ife kapena kutiwononga.’","poem":2}]},{"type":"heading","content":["Kubwezeretsedwa kwa Israeli"]},{"type":"verse","number":11,"content":[{"text":"“Tsiku limenelo ndidzabwezeretsa","poem":1},{"text":"nyumba ya Davide imene inagwa.","poem":2},{"text":"Ndidzakonzanso malo amene anagumuka,","poem":1},{"text":"ndi kuyimanganso","poem":2},{"lineBreak":true},{"text":"monga inalili poyamba,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kuti adzatengenso otsala a Edomu","poem":1},{"text":"ndi mitundu yonse imene imatchedwa ndi dzina langa,”","poem":2},{"text":"akutero Yehova amene adzachita zinthu izi.","poem":4}]},{"type":"verse","number":13,"content":["Yehova akunena kuti",{"text":"“Nthawi ikubwera pamene mlimi wotipula adzapyola wokolola","poem":1},{"text":"ndipo woponda mphesa adzapyola wodzala mbewu.","poem":2},{"text":"Mapiri adzachucha vinyo watsopano","poem":1},{"text":"ndi kuyenderera pa zitunda zonse.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndidzawabwezeranso pabwino anthu anga Aisraeli;","poem":1},{"text":"mizinda imene inali mabwinja idzamangidwanso ndipo azidzakhalamo.","poem":2},{"text":"Adzalima minda ya mpesa ndipo adzamwa vinyo wake;","poem":1},{"text":"adzalima minda ndipo adzadya zipatso zake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndidzakhazika Aisraeli mʼdziko mwawo,","poem":1},{"text":"ndipo sadzachotsedwamonso mʼdziko","poem":2},{"lineBreak":true},{"text":"limene Ine ndawapatsa,”","poem":2},{"lineBreak":true},{"text":"akutero Yehova Mulungu wako.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}