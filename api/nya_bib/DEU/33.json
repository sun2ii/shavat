{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"DEU","translationId":"nya_bib","name":"DEUTERONOMO","commonName":"DEUTERONOMO","title":"Deuteronomo","order":5,"numberOfChapters":34,"sha256":"cca2b5b76c1e77f63014e5b8c22aece30b7cb52035257428cd9ba14259a56d3f","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/nya_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Mose Adalitsa Mafuko a Aisraeli"]},{"type":"verse","number":1,"content":["Awa ndi madalitso amene Mose, munthu wa Mulungu, anawapereka kwa Aisraeli asanafe."]},{"type":"verse","number":2,"content":["Iye anati:",{"text":"“Yehova anabwera kuchokera ku Sinai","poem":1},{"text":"ndipo anatulukira kuchokera ku Seiri;","poem":2},{"lineBreak":true},{"text":"anawala kuchokera pa Phiri la Parani.","poem":2},{"text":"Iye anabwera ndi chiwunyinji cha angelo","poem":1},{"text":"kuchokera kummwera, moto woyaka uli mʼdzanja mwake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndithu ndinu amene mumakonda anthu anu;","poem":1},{"text":"opatulika ake onse ali mʼmanja mwake.","poem":2},{"text":"Onse amagwada pansi pa mapazi anu","poem":1},{"text":"kuchokera kwa inu amalandira malangizo,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"malamulo amene Mose anatipatsa,","poem":1},{"text":"chuma chopambana cha mtundu wa Yakobo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iye anali mfumu ya Yesuruni","poem":1},{"text":"pamene atsogoleri a anthu anasonkhana,","poem":2},{"lineBreak":true},{"text":"pamodzi ndi mafuko a Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Lolani Rubeni akhale ndi moyo ndipo asafe,","poem":1},{"text":"anthu ake asachepe pa chiwerengero.”","poem":2}]},{"type":"verse","number":7,"content":["Ndipo ponena za Yuda anati:",{"text":"“Inu Yehova, imvani kulira kwa Yuda;","poem":1},{"text":"mubweretseni kwa anthu ake.","poem":2},{"text":"Ndi manja ake omwe adziteteze yekha.","poem":1},{"text":"Inu khalani thandizo lake polimbana ndi adani ake!”","poem":2}]},{"type":"verse","number":8,"content":["Za fuko la Alevi anati:",{"text":"“Tumimu wanu ndi Urimu ndi za","poem":1},{"text":"mtumiki wanu wokhulupirika.","poem":2},{"text":"Munamuyesa ku Masa;","poem":1},{"text":"munalimbana naye ku madzi a ku Meriba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iye ananena za abambo ake ndi amayi ake kuti,","poem":1},{"text":"‘Sindilabadira za iwo.’","poem":2},{"text":"Sanasamale za abale ake","poem":1},{"text":"kapena ana ake,","poem":2},{"text":"koma anayangʼanira mawu anu","poem":1},{"text":"ndipo anateteza pangano lanu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iye amaphunzitsa Yakobo malangizo anu","poem":1},{"text":"ndi malamulo anu kwa Israeli.","poem":2},{"text":"Amafukiza lubani pamaso panu","poem":1},{"text":"ndiponso amapereka nsembe zanu zonse zopsereza pa guwa lanu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inu Yehova, dalitsani luso lake lonse","poem":1},{"text":"ndipo mukondwere ndi ntchito za manja ake.","poem":2},{"text":"Menyani adani awo mʼchiwuno","poem":1},{"text":"kanthani amene amuwukira kuti asadzukenso.”","poem":2}]},{"type":"verse","number":12,"content":["Za fuko la Benjamini anati:",{"text":"“Wokondedwa wa Yehova akhale mwamtendere mwa Iye,","poem":1},{"text":"pakuti amamuteteza tsiku lonse,","poem":2},{"lineBreak":true},{"text":"ndipo amene Yehova amamukonda amawusa pa mapewa ake.”","poem":2}]},{"type":"verse","number":13,"content":["Za fuko la Yosefe anati:",{"text":"“Yehova adalitse dziko lake","poem":1},{"text":"ndi mame ambiri ochokera kumwamba","poem":2},{"lineBreak":true},{"text":"ndiponso madzi ambiri ochokera pansi pa nthaka;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ndi zinthu zambiri zimene zimacha ndi dzuwa","poem":1},{"text":"ndiponso ndi zokolola zabwino kwambiri zimene zimacha ndi mwezi uliwonse;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ndi zipatso zabwino kwambiri zochokera mʼmapiri amakedzanawa","poem":1},{"text":"ndiponso zokolola zochuluka zochokera ku zitunda zakalekale;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ndi mphatso zabwino kwambiri zochokera pa dziko lapansi ndi zonse zimene zili mʼmenemo","poem":1},{"text":"ndiponso kukoma mtima kwa Iye amene amakhala mʼchitsamba choyaka moto.","poem":2},{"text":"Madalitso onsewa akhale pa mutu pa Yosefe,","poem":1},{"text":"wapaderadera pakati pa abale ake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ulemerero wake uli ngati ngʼombe yayimuna yoyamba kubadwa;","poem":1},{"text":"nyanga zake zili ngati za njati.","poem":2},{"text":"Ndi nyanga zakezo adzapirikitsa anthu a mitundu ina,","poem":1},{"text":"ngakhale iwo amene akukhala ku malekezero a dziko lapansi.","poem":2},{"text":"Nyanga zimenezi ndiye anthu miyandamiyanda a Efereimu;","poem":1},{"text":"nyanga zimenezi ndiye anthu 1,000 a Manase.”","poem":2}]},{"type":"verse","number":18,"content":["Za fuko la Zebuloni anati:",{"text":"“Kondwera Zebuloni, pamene ukutuluka,","poem":1},{"text":"ndipo iwe, Isakara, kondwera mʼmatenti ako.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Adzayitanira mitundu ya anthu kumapiri,","poem":1},{"text":"kumeneko adzaperekako nsembe zachilungamo;","poem":2},{"text":"kumeneko adzadyerera zinthu zochuluka zochokera ku nyanja,","poem":1},{"text":"chuma chobisika mu mchenga.”","poem":2}]},{"type":"verse","number":20,"content":["Za fuko la Gadi anati:",{"text":"“Wodala amene amakulitsa malire a Gadi!","poem":1},{"text":"Gadi amakhala kumeneko ngati mkango,","poem":2},{"lineBreak":true},{"text":"kukhadzula mkono kapena mutu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iye anadzisankhira dziko labwino kwambiri;","poem":1},{"text":"gawo la mtsogoleri anasungira iye.","poem":2},{"text":"Pamene atsogoleri a anthu anasonkhana,","poem":1},{"text":"anachita chifuniro cha Yehova molungama,","poem":2},{"lineBreak":true},{"text":"ndiponso malamulo onena za Israeli.”","poem":2}]},{"type":"verse","number":22,"content":["Za fuko la Dani anati:",{"text":"“Dani ndi mwana wamkango,","poem":1},{"text":"amene akutuluka ku Basani.”","poem":2}]},{"type":"verse","number":23,"content":["Za fuko la Nafutali anati:",{"text":"“Nafutali wadzaza ndi kukoma mtima kwa Yehova","poem":1},{"text":"ndipo ndi wodzaza ndi madalitso ake;","poem":2},{"lineBreak":true},{"text":"cholowa chake chidzakhala mbali ya kummwera kwa nyanja.”","poem":2}]},{"type":"verse","number":24,"content":["Za fuko la Aseri anati:",{"text":"“Mwana wodalitsika kwambiri ndi Aseri;","poem":1},{"text":"abale ake amukomere mtima,","poem":2},{"lineBreak":true},{"text":"ndipo asambe mapazi ake mʼmafuta.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Zotsekera za zipata zako zidzakhala za chitsulo ndi za mkuwa,","poem":1},{"text":"ndi mphamvu zako zidzakhala ngati masiku a moyo wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Palibe wina wofanana ndi Mulungu wa Yesuruni,","poem":1},{"text":"amene amakwera pa thambo kukuthandizani","poem":2},{"lineBreak":true},{"text":"ndiponso pa mitambo ya ulemerero wake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mulungu wamuyaya ndiye pothawirapo pathu,","poem":1},{"text":"ndipo pa dziko lapansi amakusungani ndi mphamvu zosatha.","poem":2},{"text":"Adzathamangitsa patsogolo panu mdani wanu,","poem":1},{"text":"adzanena kuti, ‘Muwonongeni!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Motero Israeli adzakhala yekha mwamtendere;","poem":1},{"text":"zidzukulu za Yakobo zili pa mtendere","poem":2},{"text":"mʼdziko la tirigu ndi vinyo watsopano,","poem":1},{"text":"kumene thambo limagwetsa mame.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Iwe Israeli, ndiwe wodala!","poem":1},{"text":"Wofanana nanu ndani","poem":2},{"lineBreak":true},{"text":"anthu opulumutsidwa ndi Yehova?","poem":2},{"text":"Iye ndiye chishango ndi mthandizi wanu","poem":1},{"text":"ndi lupanga lanu la ulemerero.","poem":2},{"text":"Adani ako adzakugonjera,","poem":1},{"text":"ndipo iwe udzapondereza pansi malo awo achipembedzo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}