{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ECC","translationId":"nya_bib","name":"MLALIKI","commonName":"MLALIKI","title":"Mlaliki","order":21,"numberOfChapters":12,"sha256":"6af4f9995f169a350ce7d99961f3bf964522f3d77ad1758d9eea2ca7227ff08f","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/nya_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["Zapansipano Nʼzopandapake"]},{"type":"verse","number":1,"content":["Mawu a Mlaliki, mwana wa Davide, mfumu ya ku Yerusalemu:"]},{"type":"verse","number":2,"content":[{"text":"“Zopandapake! Zopandapake!”","poem":1},{"text":"atero Mlaliki.","poem":2},{"text":"“Zopandapake kotheratu!","poem":1},{"text":"Zopandapake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kodi munthu amapindulanji pa ntchito zake zonse","poem":1},{"text":"zimene amasautsidwa nazo pansi pano?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mibado imabwera ndipo mibado imapita,","poem":1},{"text":"koma dziko lapansi limakhalapobe nthawi zonse.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dzuwa limatuluka ndipo dzuwa limalowa","poem":1},{"text":"ndipo limapita mwamsanga kumene limatulukira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mphepo imawombera cha kummwera","poem":1},{"text":"ndi kukhotera cha kumpoto;","poem":2},{"text":"imawomba mozungulirazungulira,","poem":1},{"text":"kumangobwererabwerera komwe yachokera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mitsinje yonse imakathira ku nyanja,","poem":1},{"text":"koma nyanjayo sidzaza;","poem":2},{"text":"kumene madziwo amachokera,","poem":1},{"text":"amabwereranso komweko.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zinthu zonse ndi zotopetsa,","poem":1},{"text":"kutopetsa kwake ndi kosaneneka.","poem":2},{"text":"Maso satopa ndi kuona","poem":1},{"text":"kapena khutu kukwaniritsidwa ndi kumva.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zomwe zinalipo kale zidzakhalaponso,","poem":1},{"text":"zomwe zinachitika kale zidzachitikanso.","poem":2},{"lineBreak":true},{"text":"Ndiye kuti chatsopano palibiretu pansi pano.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodi chilipo chinthu chimene wina anganene kuti,","poem":1},{"text":"“Taona! Ichi ndiye chatsopano?”","poem":2},{"text":"Chinalipo kale, kalekale;","poem":1},{"text":"chinalipo ife kulibe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anthu akale sakumbukiridwa,","poem":1},{"text":"ngakhale amene adzabwera mʼtsogolomu","poem":2},{"text":"sadzakumbukiridwa ndi iwo","poem":1},{"text":"amene adzabwere pambuyo pawo.","poem":2}]},{"type":"heading","content":["Nzeru Nʼzopandapake"]},{"type":"verse","number":12,"content":["Ine, Mlalikine, ndinali mfumu ya Israeli mu Yerusalemu."]},{"type":"verse","number":13,"content":["Ndinayika mtima wanga pophunzira ndi kufunafuna mwa nzeru zinthu zonse zimene zimachitika pansi pa thambo. Ndi ntchito yolemetsa ndithu imene Mulungu anayipereka kwa anthu!"]},{"type":"verse","number":14,"content":["Ine ndaona zinthu zonse zochitika pansi pano; zinthu zonsezo ndi zopandapake, nʼkungodzivuta chabe."]},{"type":"verse","number":15,"content":[{"text":"Chinthu chokhota sichingathe kuwongoledwa;","poem":1},{"text":"chimene palibe sichingathe kuwerengedwa.","poem":2}]},{"type":"verse","number":16,"content":["Ine ndinaganiza mu mtima mwanga, “Taona, ine ndakula ndi kukhala wa nzeru zochuluka kupambana aliyense amene analamulirapo Yerusalemu ndisanabadwe; ndaphunzira nzeru zochuluka ndi luntha.”"]},{"type":"verse","number":17,"content":["Ndipo ndinadzipereka kuti ndithe kumvetsa kuti nzeru nʼchiyani, misala nʼchiyani, uchitsiru nʼchiyani, koma ndinazindikira ichi, kuti kuteronso nʼkungodzivuta chabe."]},{"type":"verse","number":18,"content":[{"text":"Pakuti nzeru zochuluka zimabweretsa chisoni chochulukanso:","poem":1},{"text":"chidziwitso chochuluka, zowawa zochulukanso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}