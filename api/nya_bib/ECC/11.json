{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ECC","translationId":"nya_bib","name":"MLALIKI","commonName":"MLALIKI","title":"Mlaliki","order":21,"numberOfChapters":12,"sha256":"6af4f9995f169a350ce7d99961f3bf964522f3d77ad1758d9eea2ca7227ff08f","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/nya_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["Kuponya Chakudya pa Madzi"]},{"type":"verse","number":1,"content":[{"text":"Ponya chakudya chako pa madzi,","poem":1},{"text":"udzachipezanso patapita masiku ambiri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndalama zako uzisungitse kwa anthu asanu ndi awiri, inde kwa anthu asanu ndi atatu,","poem":1},{"text":"pakuti sudziwa ndi tsoka lanji limene likubwera pa dziko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngati mitambo yadzaza ndi madzi,","poem":1},{"text":"imagwetsa mvula pa dziko lapansi.","poem":2},{"text":"Mtengo ukagwera cha kummwera kapena cha kumpoto,","poem":1},{"text":"ndiye kuti udzagonera kumene wagwerako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amene amayangʼana mphepo sadzadzala;","poem":1},{"text":"amene amayangʼana mitambo sadzakolola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Momwe sudziwira mayendedwe a mphepo,","poem":1},{"text":"kapena momwe mzimu umalowera mʼthupi la mwana mʼmimba mwa amayi,","poem":2},{"text":"momwemonso sungathe kudziwa ntchito za Mulungu,","poem":1},{"text":"Mlengi wa zinthu zonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dzala mbewu zako mmawa","poem":1},{"text":"ndipo madzulo usamangoti manja lobodo,","poem":2},{"text":"pakuti sudziwa chimene chidzapindula,","poem":1},{"text":"mwina ichi kapena icho,","poem":2},{"lineBreak":true},{"text":"kapena mwina zonse ziwiri zidzachita bwino.","poem":2}]},{"type":"heading","content":["Kumbukira Mlengi Wako"]},{"type":"verse","number":7,"content":[{"text":"Kuwala nʼkwabwino,","poem":1},{"text":"ndipo maso amasangalala kuona dzuwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Munthu akakhala wa zaka zambiri,","poem":1},{"text":"mulekeni akondwerere zaka zonsezo,","poem":2},{"text":"koma iye azikumbukira masiku a mdima,","poem":1},{"text":"pakuti adzakhala ochuluka.","poem":2},{"lineBreak":true},{"text":"Chilichonse chimene chikubwera ndi chopanda phindu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kondwera mnyamata iwe, pamene ukanali wamngʼono,","poem":1},{"text":"ndipo mtima wako usangalale pa nthawi ya unyamata wako.","poem":2},{"text":"Tsatira zimene mtima wako ukufuna,","poem":1},{"text":"ndiponso zimene maso ako akuona,","poem":2},{"text":"koma dziwa kuti pa zinthu zonsezo","poem":1},{"text":"Mulungu adzakuweruza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Choncho uchotse zokusautsa mu mtima mwako,","poem":1},{"text":"upewe zokupweteka mʼthupi mwako,","poem":2},{"lineBreak":true},{"text":"pakuti unyamata ndi ubwana ndi zopandapake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}