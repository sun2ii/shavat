{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ECC","translationId":"nya_bib","name":"MLALIKI","commonName":"MLALIKI","title":"Mlaliki","order":21,"numberOfChapters":12,"sha256":"6af4f9995f169a350ce7d99961f3bf964522f3d77ad1758d9eea2ca7227ff08f","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/nya_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Uzikumbukira mlengi wako","poem":1},{"text":"masiku a unyamata wako,","poem":2},{"text":"masiku oyipa asanafike,","poem":1},{"text":"nthawi isanafike pamene udzanena kuti,","poem":2},{"lineBreak":true},{"text":"“Izi sizikundikondweretsa.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nthawi ya ukalamba wako, dzuwa ndi kuwala,","poem":1},{"text":"mwezi ndi nyenyezi zidzada.","poem":2},{"lineBreak":true},{"text":"Mitambo idzabweranso mvula itagwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nthawi imene manja ako adzanjenjemera,","poem":1},{"text":"miyendo yako idzafowoka,","poem":2},{"text":"pamene mano ako adzalephera kutafuna chifukwa ndi owerengeka,","poem":1},{"text":"ndipo maso ako adzayamba kuchita chidima.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Makutu ako adzatsekeka,","poem":1},{"text":"ndipo sudzamva phokoso lakunja;","poem":2},{"text":"sudzamvanso kusinja kwa pa mtondo","poem":1},{"text":"kapena kulira kwa mbalame mmawa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Imeneyi ndiyo nthawi imene anthu amaopa kupita kumalo okwera,","poem":1},{"text":"amaopa kuyenda mʼmisewu;","poem":2},{"text":"Mutu umatuwa kuti mbuu,","poem":1},{"text":"amayenda modzikoka ngati ziwala","poem":2},{"lineBreak":true},{"text":"ndipo chilakolako chimatheratu.","poem":2},{"text":"Nthawi imeneyo munthu amapita ku nyumba yake yamuyaya","poem":1},{"text":"ndipo anthu olira maliro amayendayenda mʼmisewu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kumbukira Iye chingwe cha siliva chisanaduke,","poem":1},{"text":"kapena mbale yagolide isanasweke;","poem":2},{"text":"mtsuko usanasweke ku kasupe,","poem":1},{"text":"kapena mkombero usanathyoke ku chitsime.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iyi ndi nthawi imene thupi lidzabwerera ku dothi, kumene linachokera,","poem":1},{"text":"mzimu udzabwerera kwa Mulungu amene anawupereka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Zopanda phindu! Zopandapake!” akutero Mlaliki.","poem":1},{"text":"“Zonse ndi zopandapake!”","poem":2}]},{"type":"heading","content":["Mawu Otsiriza"]},{"type":"verse","number":9,"content":["Mlaliki sanali wozindikira zinthu kokha ayi, komanso ankaphunzitsa anthu. Iye ankasinkhasinkha ndi kufufuzafufuza ndi kulemba mwadongosolo miyambi yambiri."]},{"type":"verse","number":10,"content":["Mlaliki anafufuzafufuza kuti apeze mawu oyenera, ndipo zimene analemba zinali zolondola ndiponso zoona."]},{"type":"verse","number":11,"content":["Mawu a anthu anzeru ali ngati zisonga, zokamba zawo zimene anasonkhanitsa zili ngati misomali yokhomera, yoperekedwa ndi mʼbusa mmodzi."]},{"type":"verse","number":12,"content":["Samalira mwana wanga, za kuwonjezera chilichonse pa zimenezi. Kulemba mabuku ambiri sikutha, ndipo kuphunzira kwambiri kumatopetsa thupi."]},{"type":"verse","number":13,"content":[{"text":"Basi zonse zamveka; mathero a nkhaniyi ndi awa:","poem":1},{"text":"uziopa Mulungu ndi kusunga malamulo ake,","poem":2},{"text":"pakuti umenewu ndiwo udindo","poem":1},{"text":"wa anthu onse.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pakuti Mulungu adzaweruza zochita zonse,","poem":1},{"text":"kuphatikizanso zinthu zonse zobisika,","poem":2},{"lineBreak":true},{"text":"kaya zabwino kapena zoyipa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}