{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ECC","translationId":"nya_bib","name":"MLALIKI","commonName":"MLALIKI","title":"Mlaliki","order":21,"numberOfChapters":12,"sha256":"6af4f9995f169a350ce7d99961f3bf964522f3d77ad1758d9eea2ca7227ff08f","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/nya_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"heading","content":["Matsoka ndi Mavuto a Moyo Uno"]},{"type":"verse","number":1,"content":["Ndinayangʼananso ndi kuona chipsinjo chimene chimachitika pansi pano:",{"text":"ndinaona misozi ya anthu opsinjika,","poem":1},{"text":"ndipo iwo alibe owatonthoza;","poem":2},{"text":"mphamvu zinali ndi anthu owapsinjawo","poem":1},{"text":"ndipo iwonso analibe owatonthoza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndipo ndinanena kuti akufa,","poem":1},{"text":"amene anafa kale,","poem":2},{"text":"ndi osangalala kuposa amoyo,","poem":1},{"text":"amene akanalibe ndi moyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Koma wopambana onsewa","poem":1},{"text":"ndi amene sanabadwe,","poem":2},{"text":"amene sanaone zoyipa","poem":1},{"text":"zimene chimachitika pansi pano.","poem":2}]},{"type":"verse","number":4,"content":["Ndipo ndinazindikira kuti ntchito zonse zolemetsa ndiponso ntchito zonse zaluso zimachitika chifukwa choti wina akuchitira nsanje mnzake. Izinso ndi zopandapake, nʼkungodzivuta chabe."]},{"type":"verse","number":5,"content":[{"text":"Chitsiru chimangoti manja ake lobodo","poem":1},{"text":"ndi kudzipha chokha ndi njala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nʼkwabwino kukhala ndi dzanja limodzi lodzaza uli pa mtendere,","poem":1},{"text":"kuposa kukhala ndi manja awiri odzaza uli pa mavuto,","poem":2},{"lineBreak":true},{"text":"ndipo uku nʼkungodzivuta chabe.","poem":2}]},{"type":"verse","number":7,"content":["Ndinaonanso chinthu china chopanda phindu pansi pano:"]},{"type":"verse","number":8,"content":[{"text":"Panali munthu amene anali yekhayekha;","poem":1},{"text":"analibe mwana kapena mʼbale.","poem":2},{"text":"Ntchito yake yolemetsa sinkatha,","poem":1},{"text":"ndipo maso ake sankakhutitsidwa ndi chuma chake.","poem":2},{"text":"Iye anadzifunsa kuti, “Kodi ntchito yosautsayi ndikuyigwirira yani?","poem":1},{"text":"Nanga nʼchifukwa chiyani ndikudzimana chisangalalo?”","poem":2},{"text":"Izinso ndi zopandapake,","poem":1},{"text":"zosasangalatsa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kukhala awiri nʼkwabwino kuposa kukhala wekha,","poem":1},{"text":"chifukwa ntchito ya anthu awiri ili ndi phindu:","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngati winayo agwa,","poem":1},{"text":"mnzakeyo adzamudzutsa.","poem":2},{"text":"Koma tsoka kwa munthu amene agwa","poem":1},{"text":"ndipo alibe wina woti amudzutse!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Komanso ngati anthu awiri agona malo amodzi, adzafunditsana.","poem":1},{"text":"Koma nanga mmodzi angadzifunditse yekha?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Munthu mmodzi angathe kugonjetsedwa,","poem":1},{"text":"koma anthu awiri akhoza kudziteteza.","poem":2},{"text":"Chingwe cha maulusi atatu sichidukirapo.","poem":1}]},{"type":"heading","content":["Kutukuka Nʼkopandapake"]},{"type":"verse","number":13,"content":["Wachinyamata wosauka koma wanzeru aposa mfumu yokalamba koma yopusa imene simvanso malangizo."]},{"type":"verse","number":14,"content":["Wachinyamatayo angathe kuchokera ku ndende ndi kudzakhala mfumu, kapena angathe kubadwa wosauka mʼdziko la mfumuyo."]},{"type":"verse","number":15,"content":["Ndipo ndinaona kuti iwo onse amene anakhala ndi moyo ndi kuyenda pansi pano anatsatira wachinyamatayo, amene anatenga malo a mfumu."]},{"type":"verse","number":16,"content":["Mfumu ikhoza kulamulira anthu osawerengeka, komabe itamwalira, palibe amene adzayamikire zomwe mfumuyo inachita. Izinso ndi zopandapake, nʼkungozivuta chabe."]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}