{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"EXO","translationId":"nya_bib","name":"EKSODO","commonName":"EKSODO","title":"Eksodo","order":2,"numberOfChapters":40,"sha256":"5dab849447f1eaaccb0564a7ba264205607cbe3f8d7f56822937c82097ee10a4","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/nya_bib/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Nyimbo ya Mose ndi Miriamu"]},{"type":"verse","number":1,"content":["Ndipo Mose ndi Aisraeli anayimbira Yehova nyimbo iyi:",{"text":"“Ine ndidzayimbira Yehova","poem":1},{"text":"pakuti wakwezeka mʼchigonjetso.","poem":2},{"text":"Kavalo ndi wokwera wake,","poem":1},{"text":"Iye wawaponya mʼnyanja.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yehova ndiye mphamvu yanga ndi nyimbo yanga;","poem":1},{"text":"ndiye chipulumutso changa.","poem":2},{"text":"Iye ndiye Mulungu wanga, ndipo ndidzamutamanda,","poem":1},{"text":"Mulungu wa makolo anga, ine ndidzamukweza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yehova ndi wankhondo;","poem":1},{"text":"Yehova ndilo dzina lake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Magaleta a Farao ndi asilikali ake ankhondo","poem":1},{"text":"Iye wawaponya mʼnyanja.","poem":2},{"text":"Akatswiri ankhondo amphamvu a Farao","poem":1},{"text":"amizidwa mʼNyanja Yofiira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nyanja yakuya inawaphimba;","poem":1},{"text":"Iwo anamira pansi ngati mwala.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yehova, dzanja lanu lamanja","poem":1},{"text":"ndi laulemerero chifukwa cha mphamvu zake.","poem":2},{"text":"Ndithu Yehova, dzanja lanu lamanja","poem":1},{"text":"linaphwanya mdani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndi ulemerero wanu waukulu,","poem":1},{"text":"munagonjetsa okutsutsani.","poem":2},{"text":"Inu munatumiza mkwiyo wanu waukulu;","poem":1},{"text":"ndipo unawapsereza ngati udzu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndi mpweya wotuluka mʼmphuno mwanu","poem":1},{"text":"madzi anawunjikana pamodzi.","poem":2},{"text":"Nyanja yakuya ija inasanduka","poem":1},{"text":"madzi owuma gwaa kufika pansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mdaniyo anati,","poem":1},{"text":"“Ine ndidzawalondola, ndipo ndidzawagwira.","poem":2},{"text":"Ndidzagawa chuma chawo;","poem":1},{"text":"ndiye chokhumba changa chidzakwaniritsidwa.","poem":2},{"text":"Ine ndidzasolola lupanga langa,","poem":1},{"text":"ndi mkono wanga ndidzawawononga.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Koma Inu munawuzira mphepo yanu,","poem":1},{"text":"ndipo nyanja inawaphimba.","poem":2},{"text":"Iwo anamira ngati chitsulo","poem":1},{"text":"mʼmadzi amphamvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ndithu Yehova, pakati pa milungu,","poem":1},{"text":"ndani afanana nanu? Inu amene muli woyera,","poem":2},{"text":"ndiponso wotamandika wolemekezeka,","poem":3},{"lineBreak":true},{"text":"chifukwa cha ntchito zanu,","poem":3},{"lineBreak":true},{"text":"zazikulu ndi zodabwitsa?","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Munatambasula dzanja lanu lamanja","poem":1},{"text":"ndipo dziko linawameza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndi chikondi chanu chosasinthika mudzatsogolera","poem":1},{"text":"anthu amene munawawombola.","poem":2},{"text":"Ndi mphamvu zanu munawatsogolera","poem":1},{"text":"ku malo anu woyera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anthu amitundu ina anamva za mbiriyi ndipo ananjenjemera ndi mantha,","poem":1},{"text":"mantha woopsa agwira anthu a dziko la Filisiti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tsopano mafumu a ku Edomu agwidwa ndi mantha aakulu,","poem":1},{"text":"otsogolera a dziko la Mowabu akunjenjemera ndi mantha,","poem":2},{"text":"ndipo anthu a ku Kanaani asungunuka ndi mantha.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Onse agwidwa ndi mantha woopsa.","poem":2},{"text":"Popeza anaona mphamvu zanu zazikulu,","poem":1},{"text":"iwo ayima chilili ngati mwala mpaka anthu anu,","poem":2},{"text":"Inu Yehova atadutsa;","poem":1},{"text":"inde mpaka atadutsa anthu amene munawagula.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inu mudzawalowetsa ndi kuwakhazikitsa","poem":1},{"text":"pa phiri lanu.","poem":2},{"text":"Pa malo pamene Inu Yehova munawapanga kuti muzikhalapo;","poem":1},{"text":"malo wopatulika amene Inu Ambuye munawakonza ndi manja anu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Yehova adzalamula","poem":1},{"text":"mpaka muyaya.”","poem":2}]},{"type":"verse","number":19,"content":["Akavalo a Farao, magaleta ndi oyendetsa akavalo atalowa mʼnyanja, Yehova anawabwezera madziwo mʼnyanja ndi kuwamiza, koma Aisraeli anawoloka nyanjayo powuma."]},{"type":"verse","number":20,"content":["Ndipo Miriamu mneneri wamkazi, mlongo wa Aaroni anatenga zoyimbira ndipo akazi onse anamutsatira pambuyo, akuyimba ndi zoyimbira ndi kuvina."]},{"type":"verse","number":21,"content":["Miriamu anawayimbira nyimbo iyi:",{"text":"“Imbirani Yehova,","poem":1},{"text":"chifukwa iye wapambana.","poem":2},{"text":"Kavalo ndi wokwerapo wake","poem":1},{"text":"Iye wawamiza mʼnyanja.”","poem":2}]},{"type":"heading","content":["Madzi a ku Mara ndi Elimu"]},{"type":"verse","number":22,"content":["Ndipo Mose anatsogolera Israeli kuchoka ku nyanja yofiira ndi kupita ku chipululu cha Suri. Anayenda mʼchipululu masiku atatu wosapeza madzi."]},{"type":"verse","number":23,"content":["Ndipo anafika ku Mara. Koma sanathe kumwa madzi akumeneko chifukwa anali owawa. (Ndi chifukwa chake malowo amatchedwa Mara)."]},{"type":"verse","number":24,"content":["Tsono anthu aja anadandaulira Mose ndi kumufunsa kuti, “Kodi tikumwa chiyani?”"]},{"type":"verse","number":25,"content":["Ndipo Mose anapemphera kwa Yehova, ndipo Yehova anamuonetsa kamtengo. Iye anakaponya mʼmadzimo ndipo madzi anakhala abwino. Kumeneko Yehova anawayikira lamulo ndi maweruziro. Kumenekonso Yehova anawayesa."]},{"type":"verse","number":26,"content":["Yehova anati, “Ngati inu mudzamvetsa bwino mawu anga, kuchita zolungama, kumvera malamulo anga ndi kusamalitsa zimene ndikukuwuzani ndiye kuti Ine sindidzayika pa inu matenda amene ndinayika pa anthu a ku Igupto popeza ndine Yehova amene ndimakuchiritsani.”"]},{"type":"verse","number":27,"content":["Kenaka anafika ku Elimu, kumene kunali akasupe khumi ndi awiri ndi mitengo ya migwalangwa makumi asanu ndi awiri, ndipo anamanga misasa yawo kumeneko pafupi ndi madzi."]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}