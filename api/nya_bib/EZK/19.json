{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"EZK","translationId":"nya_bib","name":"EZEKIELI","commonName":"EZEKIELI","title":"Ezekieli","order":26,"numberOfChapters":48,"sha256":"67b048c860af9a8118e3d1b92fb09c03bd7a9fefe15134f189a6231b03ee3ecf","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/nya_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Nyimbo ya Maliro a Akalonga a Israeli"]},{"type":"verse","number":1,"content":["“Imba nyimbo ya madandawulo, kuyimbira akalonga a ku Israeli."]},{"type":"verse","number":2,"content":["Uzinena kuti,",{"text":"“ ‘Amayi ako anali ndani?","poem":1},{"text":"Anali ngati mkango waukazi!","poem":2},{"text":"Iwo unabwatama pakati pa mikango yayimuna;","poem":1},{"text":"unkalera ana ake pakati pa misona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unalera mmodzi mwa ana ake,","poem":1},{"text":"ndipo mwanayo anasanduka mkango wamphamvu.","poem":2},{"text":"Unaphunzira kugwira nyama,","poem":1},{"text":"ndipo unayamba kudya anthu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anthu amitundu anamva za mkangowo,","poem":1},{"text":"ndipo tsiku lina unagwa mʼmbuna mwawo.","poem":2},{"text":"Iwo anawukoka ndi ngowe","poem":1},{"text":"kupita nawo ku dziko la Igupto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘Amayi aja ataona kuti mwana ankamukhulupirira uja wagwidwa ndi kuti chiyembekezo chake chapita padera,","poem":1},{"lineBreak":true},{"text":"amayiwo anatenganso mwana wina","poem":1},{"text":"namusandutsa mkango wamphamvu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unkayendayenda pakati pa mikango inzake,","poem":1},{"text":"pakuti tsopano unali mkango wamphamvu.","poem":2},{"text":"Unaphunzira kugwira nyama","poem":1},{"text":"ndipo unayamba kudya anthu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Unagwetsa malinga awo,","poem":1},{"text":"ndikuwononga mizinda yawo.","poem":2},{"text":"Onse a mʼdzikomo","poem":1},{"text":"anachita mantha chifukwa cha kubangula kwake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pamenepo mitundu ya anthu, makamaka ochokera madera ozungulira,","poem":1},{"text":"inabwera kudzalimbana nawo.","poem":2},{"text":"Anawutchera ukonde wawo,","poem":1},{"text":"ndipo tsiku lina unagwera mʼmbuna mwawo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anawukoka ndi ngowe nawuponya mʼchitatanga.","poem":1},{"text":"Anabwera nawo kwa mfumu ya ku Babuloni","poem":2},{"text":"ndipo mfumuyo inawuponya mʼndende","poem":1},{"text":"ndi cholinga choti liwu lake lisamamvekenso","poem":2},{"lineBreak":true},{"text":"ku mapiri a Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Amayi ako anali ngati mpesa mʼmunda wamphesa","poem":1},{"text":"wodzalidwa mʼmbali mwa madzi.","poem":2},{"text":"Unabereka bwino ndipo unali ndi nthambi zambiri","poem":1},{"text":"chifukwa cha kuchuluka kwa madzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nthambi zake zinali zolimba,","poem":1},{"text":"zoyenera kupangira ndodo yaufumu.","poem":2},{"text":"Unatalika nusomphoka pakati pa","poem":1},{"text":"zomera zina.","poem":2},{"text":"Unkaoneka bwino chifukwa cha kutalika kwake,","poem":1},{"text":"ndi nthambi zake zambiri.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Koma unazulidwa mwaukali","poem":1},{"text":"ndipo unagwetsedwa pansi.","poem":2},{"text":"Unawuma ndi mphepo ya kummawa,","poem":1},{"text":"zipatso zake zinayoyoka;","poem":2},{"text":"nthambi zake zolimba zinafota","poem":1},{"text":"ndipo moto unapsereza mtengo wonse.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndipo tsopano anawuwokeranso ku chipululu,","poem":1},{"text":"dziko lowuma ndi lopanda madzi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Moto unatulukanso mu mtengomo","poem":1},{"text":"ndi kupsereza nthambi ndi zipatso zake.","poem":2},{"text":"Palibe nthambi yolimba inatsala pa mtengowo","poem":1},{"text":"yoyenera kupangira ndodo yaufumu.","poem":2},"Imeneyi ndi nyimbo yachisoni ndipo yasanduka nyimbo ya pa maliro.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}