{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"EZK","translationId":"nya_bib","name":"EZEKIELI","commonName":"EZEKIELI","title":"Ezekieli","order":26,"numberOfChapters":48,"sha256":"67b048c860af9a8118e3d1b92fb09c03bd7a9fefe15134f189a6231b03ee3ecf","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/nya_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["Mawu Odzudzula Mfumu ya Turo"]},{"type":"verse","number":1,"content":["Yehova anandiyankhula nati:"]},{"type":"verse","number":2,"content":["“Iwe mwana wa munthu, iwuze mfumu ya ku Turo mawu a Ine Ambuye Yehova akuti,",{"text":"“ ‘Iwe ndi mtima wako wodzikuza","poem":1},{"text":"umanena kuti, ‘Ine ndine mulungu;","poem":2},{"text":"ndimakhala pa mpando wa mulungu","poem":1},{"text":"pakati pa nyanja.’","poem":2},{"text":"Koma ndiwe munthu chabe osati mulungu,","poem":1},{"text":"ngakhale ukuganiza kuti ndiwe wanzeru ngati mulungu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taona, ndiwedi wanzeru kupambana Danieli.","poem":1},{"text":"Ndipo palibe chinsinsi chobisika kwa iwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwa nzeru zako ndi kumvetsa kwako","poem":1},{"text":"unadzipezera chuma","poem":2},{"text":"ndipo unasonkhanitsa golide ndi siliva","poem":1},{"text":"mʼnyumba zosungira chuma chako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndi nzeru zako zochitira malonda","poem":1},{"text":"unachulukitsa chuma chako","poem":2},{"text":"ndipo wayamba kunyada","poem":1},{"text":"chifukwa cha chuma chakocho.","poem":2}]},{"type":"verse","number":6,"content":["“ ‘Choncho Ine Ambuye Yehova ndikuti,",{"text":"“ ‘Popeza umadziganizira","poem":1},{"text":"kuti ndiwe mulungu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ine ndidzabwera ndi anthu achilendo, anthu ankhanza,","poem":1},{"text":"kuti adzalimbane nawe.","poem":2},{"text":"Adzakuthira nkhondo kuti awononge zonse zimene unazipeza ndi nzeru zako,","poem":1},{"text":"ndipo adzawononga kunyada kwakoko.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iwo adzakuponyera ku dzenje","poem":1},{"text":"ndipo udzafa imfa yoopsa","poem":2},{"lineBreak":true},{"text":"mʼnyanja yozama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kodi udzanenabe kuti, ‘Ine ndine mulungu,’","poem":1},{"text":"pamaso pa iwo amene akukupha?","poem":2},{"text":"Iwe udzaoneka kuti ndiwe munthu chabe, osati mulungu,","poem":1},{"text":"mʼmanja mwa iwo amene akukuphawo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Udzafa imfa ya anthu osachita mdulidwe","poem":1},{"text":"mʼmanja mwa anthu achilendo.","poem":2},"Ine ndayankhula zimenezi, akutero Ambuye Yehova.’ ”"]},{"type":"line_break"},{"type":"verse","number":11,"content":["Yehova anandiyankhula kuti:"]},{"type":"verse","number":12,"content":["“Iwe mwana wa munthu, imba nyimbo yodandaulira mfumu ya Turo ndipo uyiwuze mawu a Ine Ambuye Yehova akuti,",{"text":"“ ‘Iwe unali chitsanzo cha ungwiro weniweni,","poem":1},{"text":"wodzaza ndi nzeru ndi wokongola kwambiri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iwe unkakhala ngati mu Edeni,","poem":1},{"text":"munda wa Mulungu.","poem":2},{"text":"Miyala yokongola ya mitundu yonse:","poem":1},{"text":"rubi, topazi ndi dayimondi,","poem":2},{"lineBreak":true},{"text":"kirisoliti, onikisi, yasipa,","poem":2},{"lineBreak":true},{"text":"safiro, kalineliyoni ndi berili ndiwo inali zofunda zako.","poem":2},{"text":"Ndipo zoyikamo miyalayo zinali zagolide.","poem":1},{"text":"Anakupangira zonsezi pa tsiku limene unalengedwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndinayika kerubi kuti azikulondera.","poem":1},{"text":"Unkakhala pa phiri langa lopatulika,","poem":2},{"text":"ndipo unkayendayenda","poem":1},{"text":"pakati pa miyala ya moto.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Makhalidwe ako anali abwino","poem":1},{"text":"kuyambira pamene unalengedwa","poem":2},{"lineBreak":true},{"text":"mpaka nthawi imene unayamba kuchita zoyipa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Unatanganidwa ndi zamalonda.","poem":1},{"text":"Zotsatira zake zinali zoti unachulukitsa zandewu","poem":2},{"lineBreak":true},{"text":"ndi kumachimwa.","poem":2},{"text":"Choncho ndinakuchotsa ku phiri langa lopatulika.","poem":1},{"text":"Mkerubi amene ankakulondera uja anakupirikitsa","poem":2},{"lineBreak":true},{"text":"kukuchotsa ku miyala yamoto.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unkadzikuza mu mtima mwako","poem":1},{"text":"chifukwa cha kukongola kwako,","poem":2},{"text":"ndipo unayipitsa nzeru zako","poem":1},{"text":"chifukwa chofuna kutchuka.","poem":2},{"text":"Kotero Ine ndinakugwetsa pansi","poem":1},{"text":"kuti ukhala chenjezo pamaso pa mafumu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndi malonda ako achinyengo unachulukitsa machimo ako.","poem":1},{"text":"Motero unayipitsa malo ako achipembedzo.","poem":2},{"text":"Choncho ndinabutsa moto pakati pako,","poem":1},{"text":"ndipo unakupsereza,","poem":2},{"text":"ndipo unasanduka phulusa pa dziko lapansi","poem":1},{"text":"pamaso pa anthu onse amene amakuona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Anthu onse amitundu amene ankakudziwa","poem":1},{"text":"akuchita mantha chifukwa cha iwe.","poem":2},{"text":"Watheratu mochititsa mantha","poem":1},{"text":"ndipo sudzakhalaponso mpaka muyaya.’ ”","poem":2}]},{"type":"heading","content":["Za Chilango cha Sidoni"]},{"type":"verse","number":20,"content":["Yehova anandiyankhula nati:"]},{"type":"verse","number":21,"content":["“Iwe mwana wa munthu, utembenukire ku mzinda wa Sidoni ndipo unenere mowudzudzula kuti,"]},{"type":"verse","number":22,"content":["‘Ine Ambuye Yehova ndikuti,",{"text":"“ ‘Ndine mdani wako, iwe Sidoni,","poem":1},{"text":"ndipo ndidzalemekezedwa chifukwa cha iwe.","poem":2},{"text":"Anthu adzadziwa kuti Ine ndine Yehova","poem":1},{"text":"ndikadzakulanga ndi kudzionetsa kuti","poem":2},{"lineBreak":true},{"text":"ndine woyera pakati pako.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndidzatumiza mliri pa iwe","poem":1},{"text":"ndi kuchititsa magazi kuti ayende mʼmisewu yako.","poem":2},{"text":"Anthu ophedwa ndi lupanga","poem":1},{"text":"adzagwa mbali zonse.","poem":2},{"text":"Pamenepo iwo adzadziwa kuti Ine ndine Yehova.","poem":1}]},{"type":"verse","number":24,"content":["“ ‘Nthawi imeneyo Aisraeli sadzakhalanso ndi anthu pafupi achipongwe amene ali ngati nthula zowawa ndi ngati minga zopweteka. Pamenepo iwo adzadziwa kuti Ine ndine Ambuye Yehova."]},{"type":"verse","number":25,"content":["“ ‘Ine Ambuye Yehova mawu anga ndi awa: Nditasonkhanitsa Aisraeli kuchoka ku mayiko kumene anamwazikira, ndidzadzionetsa kuti ndine woyera pakati pawo pamaso pa anthu a mitundu ina. Adzakhala mʼdziko lawo, limene ndinalipereka kwa mtumiki wanga Yakobo."]},{"type":"verse","number":26,"content":["Adzakhala kumeneko mwamtendere ndipo adzamanga nyumba ndi kulima minda ya mpesa. Adzakhala kumeneko mwamtendere pamene ndidzalange anthu oyandikana nawo, amene ankawanyoza. Motero iwo adzadziwa kuti Ine ndine Yehova Mulungu wawo.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}