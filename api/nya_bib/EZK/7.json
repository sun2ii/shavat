{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"EZK","translationId":"nya_bib","name":"EZEKIELI","commonName":"EZEKIELI","title":"Ezekieli","order":26,"numberOfChapters":48,"sha256":"67b048c860af9a8118e3d1b92fb09c03bd7a9fefe15134f189a6231b03ee3ecf","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/nya_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":7,"content":[{"type":"heading","content":["Chimaliziro Chafika"]},{"type":"verse","number":1,"content":["Yehova anandipatsa uthenga uwu kuti,"]},{"type":"verse","number":2,"content":["“Iwe mwana wa munthu, Ine Ambuye Yehova ndikuwuza dziko la Israeli kuti:",{"text":"“Chimaliziro! Chimaliziro chafika","poem":1},{"text":"ku ngodya zinayi za dziko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Chimaliziro chili pa iwe tsopano.","poem":1},{"text":"Mkwiyo wanga ndidzawuthira pa iwe.","poem":2},{"text":"Ndidzakuweruza molingana ndi machitidwe ako","poem":1},{"text":"ndi kukulanga chifukwa cha zonyansa zako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ine sindidzakumvera chisoni","poem":1},{"text":"kapena kukuleka.","poem":2},{"text":"Ndidzakulanga ndithu chifukwa cha ntchito zako zoyipa","poem":1},{"text":"komanso chifukwa cha miyambo yako yonyansa imene ili pakati pako.","poem":2},"Pamenepo udzadziwa kuti Ine ndine Yehova.”"]},{"type":"line_break"},{"type":"verse","number":5,"content":["“Zimene ndikunena Ine Ambuye Yehova ndi izi:",{"text":"“Chiwonongeko! Chiwonongeko chimene sichinamvekepo!","poem":1},{"text":"Taona chikubwera!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Chimaliziro chafika!","poem":1},{"text":"Chimaliziro chafika!","poem":2},{"text":"Chiwonongeko chakugwera.","poem":1},{"text":"Taona chafika!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inu anthu okhala mʼdziko,","poem":1},{"text":"chiwonongeko chakugwerani.","poem":2},{"text":"Nthawi yafika, tsiku layandikira; tsiku la chisokonezo osati la chimwemwe pa mapiri.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ine ndili pafupi kukukwiyirani,","poem":1},{"text":"ndipo ukali wanga udzathera pa iwe;","poem":2},{"text":"Ine ndidzakuweruza molingana ndi machitidwe ako","poem":1},{"text":"ndiponso ndidzakulanga chifukwa cha miyambo yako yonyansa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ine sindidzakumvera chisoni","poem":1},{"text":"kapena kukuleka.","poem":2},{"text":"Ndidzakulanga malingana ndi ntchito zako","poem":1},{"lineBreak":true},{"text":"ndiponso chifukwa cha miyambo yako yonyansa pakati pako.","poem":1},"‘Pamenepo udzadziwa kuti Ine Yehova ndine amene ndimakantha.’"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Taona, tsikulo!","poem":1},{"text":"Taona, lafika!","poem":2},{"text":"Chiwonongeko chako chabwera.","poem":1},{"text":"Ndodo yaphuka mphundu za maluwa.","poem":2},{"lineBreak":true},{"text":"Kudzitama kwaphuka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Chiwawa chasanduka ndodo","poem":1},{"text":"yowakwapulira chifukwa cha kuyipa kwawo.","poem":2},{"text":"Palibe mwa anthu amenewo amene adzatsale.","poem":1},{"text":"Palibe ndi mmodzi yemwe mwa unyinji wawo.","poem":2},{"text":"Palibiretu ndipo sipadzapezeka","poem":1},{"text":"munthu wowalira maliro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nthawi yafika!","poem":1},{"text":"Tsiku layandikira!","poem":2},{"text":"Munthu wogula asakondwere","poem":1},{"text":"ndipo wogulitsa asamve chisoni,","poem":2},{"lineBreak":true},{"text":"popeza ukali wanga uli pa gulu lonse.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wogulitsa sadzazipezanso zinthu","poem":1},{"text":"zimene anagulitsa kwa wina","poem":2},{"lineBreak":true},{"text":"chinkana onse awiri akanali ndi moyo,","poem":2},{"text":"pakuti chilango chidzagwera onsewo","poem":1},{"text":"ndipo sichingasinthike.","poem":2},{"text":"Chifukwa cha machimo awo, palibe aliyense","poem":1},{"text":"amene adzapulumutsa moyo wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Lipenga lalira,","poem":1},{"text":"ndipo zonse zakonzeka.","poem":2},{"text":"Koma palibe ndi mmodzi yemwe amene akupita ku nkhondo,","poem":1},{"text":"pakuti mkwiyo wanga uli pa gulu lonse.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ku bwalo kuli kumenyana","poem":1},{"text":"ndipo mʼkati muli mliri ndi njala.","poem":2},{"text":"Anthu okhala ku midzi","poem":1},{"text":"adzafa ndi nkhondo.","poem":2},{"text":"Iwo okhala ku mizinda","poem":1},{"text":"adzafa ndi mliri ndi njala.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Onse amene adzapulumuka","poem":1},{"text":"ndi kumakakhala ku mapiri,","poem":2},{"text":"azidzalira ngati nkhunda za ku zigwa.","poem":1},{"text":"Aliyense azidzabuwula chifukwa cha machimo ake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dzanja lililonse lidzalefuka,","poem":1},{"text":"ndipo bondo lililonse lidzalobodoka ngati madzi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iwo adzavala ziguduli","poem":1},{"text":"ndipo adzagwidwa ndi mantha.","poem":2},{"text":"Adzakhala ndi nkhope zamanyazi","poem":1},{"text":"ndipo mitu yawo adzameta mpala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Iwo adzataya siliva wawo mʼmisewu","poem":1},{"text":"ndipo golide wawo adzakhala chinthu chonyansa.","poem":2},{"text":"Siliva ndi golide wawo","poem":1},{"text":"sizidzatha kuwapulumutsa","poem":2},{"lineBreak":true},{"text":"pa tsiku la ukali wa Yehova.","poem":2},{"text":"Chuma chawochi sichidzawathandiza kuthetsa njala,","poem":1},{"text":"kapena kukhala okhuta,","poem":2},{"lineBreak":true},{"text":"pakuti ndicho chinawagwetsa mʼmachimo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iwo ankanyadira zodzikongoletsera zawo zamakaka","poem":1},{"text":"ndipo ankazigwiritsa ntchito kupanga mafano awo onyansa ndi zonyansa zawo zina.","poem":2},{"text":"Nʼchifukwa chake Ine ndidzazisandutsa","poem":1},{"text":"kukhala zowanyansa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndidzazipereka kwa alendo kuti azifunkhe.","poem":1},{"text":"Anthu oyipa a dziko lapansi adzazilanda","poem":2},{"lineBreak":true},{"text":"ndi kudziyipitsa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ine ndidzawalekerera anthuwo","poem":1},{"text":"ndipo adzayipitsa malo anga apamtima.","poem":2},{"text":"Adzalowamo ngati mbala","poem":1},{"text":"ndi kuyipitsamo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":["“Konzani maunyolo,",{"text":"chifukwa dziko ladzaza ndi anthu opha anzawo","poem":2},{"lineBreak":true},{"text":"ndipo mzinda wadzaza ndi chiwawa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndidzabweretsa mitundu ya anthu oyipitsitsa","poem":1},{"text":"kuti idzalande nyumba zawo.","poem":2},{"text":"Ndidzathetsa kunyada kwa anthu amphamvu","poem":1},{"text":"pamene anthu akunja adzalowa mʼmalo awo achipembedzo ndi kuyipitsamo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nkhawa ikadzawafikira","poem":1},{"text":"adzafunafuna mtendere koma osawupeza.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tsoka lidzatsatana ndi tsoka linzake,","poem":1},{"text":"ndipo mphekesera idzatsatana ndi mphekesera inzake.","poem":2},{"text":"Iwo adzayesa kufuna masomphenya kuchokera kwa mneneri.","poem":1},{"text":"Adzasowa ansembe owaphunzitsa malamulo,","poem":2},{"lineBreak":true},{"text":"ndipo anthu akuluakulu sadzakhalanso ndi uphungu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mfumu idzalira,","poem":1},{"text":"kalonga adzagwidwa ndi mantha.","poem":2},{"lineBreak":true},{"text":"Manja a anthu a mʼdzikomo azidzangonjenjemera ndi mantha.","poem":2},{"text":"Ine ndidzawalanga molingana ndi machitidwe awo,","poem":1},{"text":"ndipo ndidzawaweruza molingana ndi momwe anaweruzira anzawo.","poem":2},"Choncho adzadziwa kuti Ine ndine Yehova.”"]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}