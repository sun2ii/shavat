{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HAB","translationId":"nya_bib","name":"HABAKUKU","commonName":"HABAKUKU","title":"Habakuku","order":35,"numberOfChapters":3,"sha256":"472b27f8cfd17d869902386dbaf669cf1700d3995602f9f68d687db469e62da8","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Uthenga umene mneneri Habakuku analandira mʼmasomphenya."]},{"type":"heading","content":["Dandawulo la Habakuku"]},{"type":"verse","number":2,"content":[{"text":"Kodi inu Yehova, ndidzakhala ndikukupemphani thandizo kwa nthawi yayitali motani,","poem":1},{"text":"koma wosayankha?","poem":2},{"text":"Kapena kufuwulira kwa inu kuti, “Chiwawa kuno!”","poem":1},{"text":"koma wosatipulumutsa?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Chifukwa chiyani mukundionetsa zinthu zoyipa?","poem":1},{"text":"Chifukwa chiyani mukundionetsa mavutowa?","poem":2},{"text":"Ndikuona chiwonongeko ndi chiwawa;","poem":1},{"text":"pali ndewu ndi kukangana kwambiri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kotero malamulo anu atha mphamvu,","poem":1},{"text":"ndipo chilungamo sichikugwira ntchito.","poem":2},{"text":"Anthu oyipa aposa olungama,","poem":1},{"text":"kotero apotoza chilungamo.","poem":2}]},{"type":"heading","content":["Yankho la Yehova"]},{"type":"verse","number":5,"content":[{"text":"“Yangʼanani pakati pa mitundu ya anthu, ndipo penyetsetsani,","poem":1},{"text":"ndipo muthedwe nazo nzeru.","poem":2},{"text":"Pakuti ndidzachitadi zinthu pa nthawi yanu","poem":1},{"text":"zimene inu simudzazikhulupirira,","poem":2},{"lineBreak":true},{"text":"ngakhale wina atakufotokozerani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pakuti taonani, Ine ndikuwutsa Ababuloni,","poem":1},{"text":"anthu ankhanza ndiponso amphamvu,","poem":2},{"text":"amene amapita pa dziko lonse lapansi","poem":1},{"text":"kukalanda malo amene si awo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iwowa ndi anthu ochititsa mantha, ndipo ndi owopsa;","poem":1},{"text":"amadzipangira okha malamulo","poem":2},{"lineBreak":true},{"text":"ndi kudzipezera okha ulemu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akavalo awo ndi aliwiro kwambiri kupambana akambuku","poem":1},{"text":"ndi owopsa kupambana mimbulu yolusa nthawi ya madzulo.","poem":2},{"text":"Okwerapo awo akuthamanga molunjika;","poem":1},{"text":"a pa akavalo awo ndi ochokera kutali,","poem":2},{"text":"akuwuluka ngati chiwombankhanga chofuna kugwira nyama;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"onse akubwera atakonzekera zachiwawa.","poem":2},{"text":"Gulu la ankhondo likubwera ngati mphepo ya mʼchipululu","poem":1},{"text":"ndi kugwira akapolo ochuluka ngati mchenga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akunyoza mafumu","poem":1},{"text":"ndiponso kuchitira chipongwe olamulira.","poem":2},{"text":"Akupeputsa mizinda yonse yotetezedwa;","poem":1},{"text":"akumanga mitumbira ndi kulanda mizindayo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kenaka amasesa mofulumira ngati mphepo nʼkumangopitirirabe,","poem":1},{"text":"anthu ochimwa, amene mphamvu zawo ndiye mulungu wawo.”","poem":2}]},{"type":"heading","content":["Dandawulo Lachiwiri la Habakuku"]},{"type":"verse","number":12,"content":[{"text":"Inu Yehova, kodi sindinu wachikhalire?","poem":1},{"text":"Mulungu wanga, Woyera wanga, ife sitidzafa.","poem":2},{"text":"Inu Yehova, munawasankha anthuwo kuti abweretse chiweruzo;","poem":1},{"text":"Inu Thanthwe, munawayika iwowo kuti atilange.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Maso anu ndi oyera kwambiri safuna kuona choyipa;","poem":1},{"text":"Inu simulekerera cholakwa.","poem":2},{"text":"Chifukwa chiyani nanga mukulekerera anthu ochita zachinyengowa?","poem":1},{"text":"Chifukwa chiyani muli chete pamene anthu oyipa","poem":2},{"lineBreak":true},{"text":"akuwononga anthu olungama kupambana iwowo?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mwasandutsa anthu kukhala ngati nsomba zamʼnyanja,","poem":1},{"text":"ngati zolengedwa zamʼnyanja zimene zilibe wolamulira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mdani wawo woyipa amakoka anthu onse ndi mbedza,","poem":1},{"text":"amawakola mu ukonde wake,","poem":2},{"text":"amawasonkhanitsa mu khoka lake;","poem":1},{"text":"kotero iyeyo amakondwa ndi kusangalala.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Choncho iye amaperekera nsembe ukonde wake","poem":1},{"text":"ndiponso kufukizira lubani khoka lake,","poem":2},{"text":"popeza ukonde wakewo ndiye umamubweretsera moyo wapamwamba","poem":1},{"text":"ndipo amadya chakudya chabwino kwambiri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kodi iye azipitirabe kugwiritsa ntchito makoka akewo,","poem":1},{"text":"kuwononga mitundu ya anthu mopanda chifundo?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}