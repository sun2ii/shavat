{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HAB","translationId":"nya_bib","name":"HABAKUKU","commonName":"HABAKUKU","title":"Habakuku","order":35,"numberOfChapters":3,"sha256":"472b27f8cfd17d869902386dbaf669cf1700d3995602f9f68d687db469e62da8","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ndidzakhala pa malo anga aulonda,","poem":1},{"text":"ndi kuyima pa mitumbira ya nkhondo;","poem":2},{"text":"ndidzadikira kuti ndimve zimene Iye adzandiwuze,","poem":1},{"text":"ndi yankho limene ndidzapatsidwe pa madandawulo anga.","poem":2}]},{"type":"heading","content":["Yankho la Yehova"]},{"type":"verse","number":2,"content":["Tsono Yehova anandiyankha, nati:",{"text":"“Lemba masomphenyawa","poem":1},{"text":"ndipo uwalembe mooneka bwino pa mapale","poem":2},{"lineBreak":true},{"text":"kuti wowerenga awawerenge mosavuta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pakuti masomphenyawa akudikira nthawi yake;","poem":1},{"text":"masomphenyawa akunena zamʼtsogolo","poem":2},{"lineBreak":true},{"text":"ndipo sizidzalephera kuchitika.","poem":2},{"text":"Ngakhale achedwe kukwaniritsidwa, uwayembekezere;","poem":1},{"text":"zidzachitika ndithu ndipo sadzachedwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Taona, mdani wadzitukumula;","poem":1},{"text":"zokhumba zake sizowongoka,","poem":2},{"lineBreak":true},{"text":"koma wolungama adzakhala ndi moyo mwachikhulupiriro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndithu, wasokonezeka ndi vinyo;","poem":1},{"text":"ndi wodzitama ndiponso wosakhazikika.","poem":2},{"text":"Pakuti ngodzikonda ngati manda,","poem":1},{"text":"ngosakhutitsidwa ngati imfa,","poem":2},{"text":"wadzisonkhanitsira mitundu yonse ya anthu","poem":1},{"text":"ndipo wagwira ukapolo anthu a mitundu yonse.","poem":2}]},{"type":"verse","number":6,"content":["“Kodi onse ogwidwawo sadzamunyoza ndi kumunyogodola ponena kuti,",{"text":"“Tsoka kwa amene amadzikundikira katundu amene si wake","poem":1},{"text":"ndipo amadzilemeretsa ndi chuma cholanda!","poem":2},{"lineBreak":true},{"text":"Kodi izi zidzachitika mpaka liti?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodi angongole ako sadzakuwukira mwadzidzidzi?","poem":1},{"text":"Kodi sadzadzuka ndi kukuchititsa mantha?","poem":2},{"lineBreak":true},{"text":"Pamenepo iwe udzalandidwa kalikonse.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pakuti unafunkha mitundu yambiri ya anthu,","poem":1},{"text":"mitundu ina imene inatsala idzakufunkha iweyo.","poem":2},{"text":"Pakuti wakhetsa magazi a anthu;","poem":1},{"text":"wawononga mayiko ndi mizinda ndi aliyense wokhala mʼmenemo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Tsoka kwa amene amalemera ndi chuma chochipeza mwachinyengo,","poem":1},{"text":"kukweza malo ake okhalapo,","poem":2},{"lineBreak":true},{"text":"kuthawa mavuto!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wakonzekera kuwononga mitundu yambiri ya anthu,","poem":1},{"text":"kuchititsa manyazi nyumba yako yomwe ndi kuwononga moyo wako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwala pa khoma udzafuwula,","poem":1},{"text":"ndipo mitanda ya matabwa idzavomereza zimenezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Tsoka kwa amene amanga mzinda pokhetsa magazi","poem":1},{"text":"ndi kukhazikitsa mzinda pochita zoyipa!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kodi Yehova Wamphamvuzonse sanatsimikize","poem":1},{"text":"kuti ntchito za anthu zili ngati nkhuni pa moto,","poem":2},{"lineBreak":true},{"text":"ndi kuti mitundu ya anthu imadzitopetsa popanda phindu?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pakuti dziko lapansi lidzadzaza ndi chidziwitso cha ulemerero wa Yehova,","poem":1},{"text":"monga momwe madzi amadzazira nyanja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Tsoka kwa amene amamwetsa anzake zakumwa zoledzeretsa,","poem":1},{"text":"kutsanula mʼbotolo mpaka ataledzera,","poem":2},{"lineBreak":true},{"text":"kuti aone umaliseche wawo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Udzachita manyazi mʼmalo mokhala ndi ulemerero.","poem":1},{"text":"Tsopano ino ndi nthawi yako! Imwa mpaka umaliseche wako uwonekere!","poem":2},{"text":"Chikho chochokera mʼdzanja lamanja la Yehova chikubwera kwa iwe,","poem":1},{"text":"ndipo manyazi adzaphimba ulemerero wako.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Udzathedwa nzeru ndi chiwawa chimene unachita ku Lebanoni,","poem":1},{"text":"ndiponso udzachita mantha ndi nyama zimene unaziwononga.","poem":2},{"text":"Pakuti wakhetsa magazi a anthu;","poem":1},{"text":"wawononga mayiko ndi mizinda ndi aliyense wokhala mʼmenemo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Kodi fano lili ndi phindu lanji, poti analisema ndi munthu,","poem":1},{"text":"kapena chifanizo chimene chimaphunzitsa mabodza?","poem":2},{"text":"Pakuti munthu amene walipanga amakhulupirira ntchito ya manja ake;","poem":1},{"text":"amapanga mafano amene samatha kuyankhula.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tsoka kwa amene amawuza mtengo kuti, ‘Khala wamoyo!’","poem":1},{"text":"Kapena mwala wopanda moyo kuti, ‘Dzuka!’","poem":2},{"text":"Kodi zimenezi zingathe kulangiza?","poem":1},{"text":"Ndi zokutidwa ndi golide ndi siliva;","poem":2},{"lineBreak":true},{"text":"mʼkati mwake mulibe mpweya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Koma Yehova ali mʼNyumba yake yopatulika;","poem":1},{"text":"dziko lonse lapansi likhale chete pamaso pake.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}