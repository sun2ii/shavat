{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HAB","translationId":"nya_bib","name":"HABAKUKU","commonName":"HABAKUKU","title":"Habakuku","order":35,"numberOfChapters":3,"sha256":"472b27f8cfd17d869902386dbaf669cf1700d3995602f9f68d687db469e62da8","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Pemphero la Habakuku"]},{"type":"verse","number":1,"content":["Pemphero la mneneri Habakuku potsata mayimbidwe a Sigionoti."]},{"type":"verse","number":2,"content":[{"text":"Inu Yehova, ndamva za kutchuka kwanu;","poem":1},{"text":"Inu Yehova, ntchito zanu zandiopsa.","poem":2},{"text":"Muzichitenso masiku athu ano,","poem":1},{"text":"masiku athu ano zidziwike;","poem":2},{"lineBreak":true},{"text":"mu ukali wanu mukumbukire kuchita chifundo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mulungu anabwera kuchokera ku Temani,","poem":1},{"text":"Woyerayo kuchokera ku Phiri la Parani.","poem":2},{"text":"Sela","poem":4},{"text":"Ulemerero wake unaphimba mlengalenga","poem":1},{"text":"ndipo dziko lapansi linadzaza ndi matamando ake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuwala kwa ulemerero wake kunali ngati kutuluka kwa dzuwa;","poem":1},{"text":"kunyezimira kunkatuluka mʼdzanja lake,","poem":2},{"lineBreak":true},{"text":"mʼmene anabisamo mphamvu zake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Patsogolo pake pankagwa mliri;","poem":1},{"text":"nthenda yoopsa inkagwa kumbuyo kwake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iye anayimirira ndi kugwedeza dziko lapansi;","poem":1},{"text":"anayangʼana ndipo mitundu ya anthu inanjenjemera.","poem":2},{"text":"Mapiri okhazikika anagumuka","poem":1},{"text":"ndipo zitunda zakalekale zinatitimira.","poem":2},{"lineBreak":true},{"text":"Njira zake ndi zachikhalire.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndinaona matenti a ku Kusani ali pa mavuto,","poem":1},{"text":"mokhala a ku Midiyani muli ululu waukulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Inu Yehova, kodi munakwiyira mitsinje?","poem":1},{"text":"Kodi munakalipira timitsinje?","poem":2},{"text":"Kodi munapsera mtima nyanja","poem":1},{"text":"pamene munakwera pa akavalo anu","poem":2},{"lineBreak":true},{"text":"ndiponso magaleta anu achipulumutso?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Munasolola uta wanu mʼchimake,","poem":1},{"text":"munayitanitsa mivi yambiri.","poem":2},{"text":"Sela","poem":4},{"text":"Munagawa dziko lapansi ndi mitsinje;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"mapiri anakuonani ndipo anagwedezeka.","poem":2},{"text":"Madzi amphamvu anasefukira;","poem":1},{"text":"nyanja yozama inakokoma","poem":2},{"lineBreak":true},{"text":"ndipo mafunde ake anakwera kwambiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dzuwa ndi mwezi zinayima chilili mlengalenga,","poem":1},{"text":"pa kungʼanima kwa mivi yanu yowulukayo,","poem":2},{"lineBreak":true},{"text":"pa kunyezimira kwa mkondo wanu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Munayendayenda mʼdziko lapansi muli ndi ukali,","poem":1},{"text":"ndipo munapondereza mitundu ya anthu muli ndi mkwiyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Munapita kukalanditsa anthu anu,","poem":1},{"text":"kukapulumutsa wodzozedwa wanu.","poem":2},{"text":"Munakantha mtsogoleri wa dziko la anthu oyipa,","poem":1},{"text":"munawononga anthu ake onse.","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Ndi mkondo wake womwe munalasa mtsogoleri wake","poem":1},{"text":"pamene ankhondo ake anabwera mwamphamvu kudzatibalalitsa,","poem":2},{"text":"ankasangalala ngati kuti akudzawononga","poem":1},{"text":"osauka amene akubisala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Munapondaponda pa nyanja ndi akavalo anu,","poem":1},{"text":"kuvundula madzi amphamvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ndinamva ndipo mtima wanga unagunda kwambiri,","poem":1},{"text":"milomo yanga inanjenjemera pakumva phokosolo;","poem":2},{"text":"mafupa anga anaguluka,","poem":1},{"text":"ndipo mawondo anga anawombana.","poem":2},{"text":"Komabe ndikuyembekezera mofatsa,","poem":1},{"text":"tsiku la masautso limene lidzafike pa mtundu wa anthu umene ukutithira nkhondo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngakhale mtengo wa mkuyu usachite maluwa,","poem":1},{"text":"ndipo mipesa ikhale yopanda mphesa.","poem":2},{"text":"Ngakhale mitengo ya olivi isabereke zipatso,","poem":1},{"text":"ndipo mʼminda musatuluke kanthu.","poem":2},{"text":"Ngakhale nkhosa","poem":1},{"text":"ndi ngʼombe zithe mʼkhola,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"komabe ine ndidzakondwera mwa Yehova,","poem":1},{"text":"ndidzasangalala mwa Mulungu Mpulumutsi wanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ambuye Yehova ndiye mphamvu yanga;","poem":1},{"text":"amalimbitsa miyendo yanga ngati ya mbawala yayikazi,","poem":2},{"lineBreak":true},{"text":"amandithandiza kukafika pamwamba pa phiri.","poem":2},{"lineBreak":true},{"text":"Kwa mtsogoleri wa mayimbidwe. Pa zoyimbira za nsambo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}