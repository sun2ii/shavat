{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Israeli anali mpesa wotambalala;","poem":1},{"text":"anabereka zipatso zambiri.","poem":2},{"text":"Pamene zipatso zawo zinanka zichuluka,","poem":1},{"text":"anawonjezera kumanga maguwa ansembe.","poem":2},{"text":"Pamene dziko lake linkatukuka,","poem":1},{"text":"anakongoletsa miyala yake yopatulika.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mtima wawo ndi wonyenga","poem":1},{"text":"ndipo tsopano ayenera kulangidwa chifukwa cha kulakwa kwawo.","poem":2},{"text":"Yehova adzagumula maguwa awo ansembe","poem":1},{"text":"ndi kuwononga miyala yawo yopatulika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pamenepo anthuwo adzanena kuti, “Ife tilibe mfumu","poem":1},{"text":"chifukwa sitinaope Yehova.","poem":2},{"text":"Koma ngakhale tikanakhala ndi mfumu,","poem":1},{"text":"kodi mfumuyo ikanatichitira chiyani?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mafumu amalonjeza zambiri,","poem":1},{"text":"amalumbira zabodza","poem":2},{"lineBreak":true},{"text":"pochita mapangano.","poem":2},{"text":"Kotero maweruzo amaphuka","poem":1},{"text":"ngati zitsamba zakupha mʼmunda umene walimidwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anthu amene amakhala mu Samariya akuchita mantha","poem":1},{"text":"chifukwa cha fano la mwana wangʼombe ku Beti-Aveni.","poem":2},{"text":"Anthu ake adzalirira fanolo,","poem":1},{"text":"chimodzimodzinso ansembe ake adamawo,","poem":2},{"text":"amene anakondwera ndi kukongola kwake,","poem":1},{"text":"chifukwa lachotsedwa pakati pawo ndi kupita ku ukapolo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Fanolo lidzatengedwa kupita ku Asiriya","poem":1},{"text":"ngati mphatso kwa mfumu yayikulu.","poem":2},{"text":"Efereimu adzachititsidwa manyazi","poem":1},{"text":"chifukwa cha mafano ake amitengo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Samariya ndi mfumu yake adzatengedwa kupita kutali","poem":1},{"text":"ngati kanthambi koyenda pa madzi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Malo opembedzerako mafano a ku Aveni adzawonongedwa.","poem":1},{"text":"Ili ndiye tchimo la Israeli.","poem":2},{"text":"Minga ndi mitungwi zidzamera","poem":1},{"text":"ndi kuphimba maguwa awo ansembe.","poem":2},{"text":"Kenaka anthu adzawuza mapiri kuti, “Tiphimbeni!”","poem":1},{"text":"ndipo adzawuza zitunda kuti, “Tigwereni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Iwe Israeli, wachimwa kuyambira mʼmasiku a Gibeya,","poem":1},{"text":"ndipo wakhala uli pomwepo.","poem":2},{"text":"Kodi nkhondo sinagonjetse anthu","poem":1},{"text":"ochita zoyipa ku Gibeya?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pamene ndifunire, ndidzalanga anthuwo;","poem":1},{"text":"mitundu ya anthu idzasonkhanitsidwa kudzalimbana nawo,","poem":2},{"lineBreak":true},{"text":"kuwayika mʼndende chifukwa cha uchimo wawo waukulu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efereimu ndi mwana wangʼombe wamkazi wophunzitsidwa","poem":1},{"text":"amene amakonda kupuntha tirigu,","poem":2},{"text":"choncho Ine ndidzayika goli","poem":1},{"text":"mʼkhosi lake lokongolalo.","poem":2},{"text":"Ndidzasenzetsa Efereimu goli,","poem":1},{"text":"Yuda ayenera kulima,","poem":2},{"lineBreak":true},{"text":"ndipo Yakobo ayenera kutipula.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mufese nokha chilungamo","poem":1},{"text":"ndipo mudzakolola chipatso cha chikondi changa chosasinthika.","poem":2},{"text":"Ndipo tipulani munda wanu wosalimidwawo;","poem":1},{"text":"pakuti ino ndi nthawi yofunafuna Yehova,","poem":2},{"text":"mpaka Iye atabwera","poem":1},{"text":"kudzakugwetserani mivumbi ya chilungamo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Koma inu munadzala zolakwa,","poem":1},{"text":"mwakolola zoyipa;","poem":2},{"lineBreak":true},{"text":"mwadya chipatso cha chinyengo.","poem":2},{"text":"Chifukwa mumadalira mphamvu zanu","poem":1},{"text":"ndiponso ankhondo anu ochulukawo,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"phokoso lankhondo lidzamveka pakati pa anthu anga","poem":1},{"text":"kotero kuti malinga anu onse adzawonongeka,","poem":2},{"text":"monga momwe Salimani anawonongera Beti-Aribeli pa nthawi ya nkhondo;","poem":1},{"text":"pamene anapha amayi pamodzi ndi ana awo omwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Momwemonso zidzakuchitikira, iwe Beteli","poem":1},{"text":"chifukwa kuyipa kwako ndi kwakukulu.","poem":2},{"text":"Tsiku limeneli likadzafika,","poem":1},{"text":"mfumu ya Israeli idzawonongedwa kwathunthu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}