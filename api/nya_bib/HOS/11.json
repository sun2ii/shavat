{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Chikondi cha Mulungu pa Israeli"]},{"type":"verse","number":1,"content":[{"text":"“Israeli ali mwana, ndinamukonda,","poem":1},{"text":"ndipo ndinayitana mwana wanga kuti atuluke mu Igupto.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Koma ndimati ndikamapitiriza kuyitana","poem":1},{"text":"iwo amandithawa kupita kutali.","poem":2},{"text":"Ankapereka nsembe kwa Abaala","poem":1},{"text":"ndipo ankafukiza lubani kwa mafano.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndi Ine amene ndinaphunzitsa Efereimu kuyenda,","poem":1},{"text":"ndipo ndinawagwira pa mkono;","poem":2},{"text":"koma iwo sanazindikire","poem":1},{"text":"kuti ndine amene ndinawachiritsa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndinawatsogolera ndi zingwe zachifundo cha anthu","poem":1},{"text":"ndi zomangira za chikondi;","poem":2},{"text":"ndinachotsa goli mʼkhosi mwawo","poem":1},{"text":"ndipo ndinawerama nʼkuwadyetsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Sadzabwerera ku Igupto,","poem":1},{"text":"koma Asiriya ndiye adzakhala mfumu yawo","poem":2},{"lineBreak":true},{"text":"pakuti akana kutembenuka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Malupanga adzangʼanima mʼmizinda yawo,","poem":1},{"text":"ndipo adzawononga mipiringidzo ya zipata zawo","poem":2},{"lineBreak":true},{"text":"nadzathetseratu malingaliro awo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anthu anga atsimikiza zondifulatira Ine.","poem":1},{"text":"Ngakhale atayitana Wammwambamwamba,","poem":2},{"lineBreak":true},{"text":"sizidzatheka kuti Iye awakwezenso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Kodi ndingakusiye bwanji iwe Efereimu?","poem":1},{"text":"Kodi ndingakupereke bwanji iwe Israeli?","poem":2},{"text":"Kodi ndingakuchitire bwanji zimene ndinachitira Adima?","poem":1},{"text":"Kodi ndingathe bwanji kukuchitira zimene ndinachitira Zeboimu?","poem":2},{"text":"Mtima wanga wakana kutero;","poem":1},{"text":"chifundo changa chonse chikusefukira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sindidzalola kuti ndikulange ndi mkwiyo wanga woopsa,","poem":1},{"text":"kapena kutembenuka ndi kuwononga Efereimu.","poem":2},{"text":"Pakuti Ine ndine Mulungu osati munthu,","poem":1},{"text":"Woyerayo pakati panu.","poem":2},{"lineBreak":true},{"text":"Sindidzabwera mwaukali.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iwo adzatsatira Yehova;","poem":1},{"text":"Iye adzabangula ngati mkango.","poem":2},{"text":"Akadzabangula,","poem":1},{"text":"ana ake adzabwera akunjenjemera kuchokera kumadzulo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Adzabwera akunjenjemera","poem":1},{"text":"ngati mbalame kuchokera ku Igupto,","poem":2},{"lineBreak":true},{"text":"ngati nkhunda kuchokera ku Asiriya.","poem":2},{"text":"Ine ndidzawakhazikanso mʼnyumba zawo,”","poem":1},{"text":"akutero Yehova.","poem":2}]},{"type":"heading","content":["Tchimo la Israeli"]},{"type":"verse","number":12,"content":[{"text":"Efereimu wandizungulira ndi mabodza,","poem":1},{"text":"nyumba ya Israeli yandizungulira ndi chinyengo.","poem":2},{"text":"Ndipo Yuda wawukira Mulungu,","poem":1},{"text":"wawukira ngakhale Woyerayo amene ndi wokhulupirika.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}