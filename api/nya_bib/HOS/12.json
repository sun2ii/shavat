{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Efereimu amadya mpweya;","poem":1},{"text":"tsiku lonse amasaka mphepo ya kummawa","poem":2},{"lineBreak":true},{"text":"ndipo amachulukitsa mabodza ndi chiwawa.","poem":2},{"text":"Amachita mgwirizano ndi Asiriya","poem":1},{"text":"ndipo amatumiza mphatso za mafuta a olivi ku Igupto.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yehova akuyimba mlandu Yuda;","poem":1},{"text":"Iye adzalanga Yakobo molingana ndi makhalidwe ake,","poem":2},{"lineBreak":true},{"text":"adzamulanga molingana ndi ntchito zake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akali mʼmimba mwa amayi ake, Yakobo anagwira chidendene cha mʼbale wake;","poem":1},{"text":"iye atakula analimbana ndi Mulungu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yakobo analimbana ndi mngelo ndipo anapambana;","poem":1},{"text":"analira napempha kuti amukomere mtima.","poem":2},{"text":"Mulungu anakumana naye ku Beteli","poem":1},{"text":"ndipo anayankhula naye kumeneko,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yehova Mulungu Wamphamvuzonse,","poem":1},{"text":"Yehova ndiye dzina lake lotchuka!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Koma inu muyenera kubwerera kwa Mulungu wanu;","poem":1},{"text":"pitirizani chikondi ndi chiweruzo cholungama,","poem":2},{"lineBreak":true},{"text":"ndipo muzidikira Mulungu wanu nthawi zonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Munthu wamalonda amagwiritsa ntchito masikelo achinyengo;","poem":1},{"text":"iyeyo amakonda kubera anthu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efereimu amadzitama ponena kuti,","poem":1},{"text":"“Ndine wolemera kwambiri; ndili ndi chuma chambiri.","poem":2},{"text":"Palibe amene angandiloze chala","poem":1},{"text":"chifukwa cha kulemera kwanga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ine ndine Yehova Mulungu wako","poem":1},{"text":"amene ndinakutulutsa mu Igupto.","poem":2},{"text":"Ndidzakukhazikaninso mʼmatenti,","poem":1},{"text":"monga munkachitira masiku aja pa nthawi ya zikondwerero zanu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndinayankhula ndi aneneri,","poem":1},{"text":"ndinawaonetsa masomphenya ambiri,","poem":2},{"lineBreak":true},{"text":"ndipo ndinawawuza mafanizo kudzera mwa iwo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kodi Giliyadi ndi woyipa?","poem":1},{"text":"Anthu ake ndi achabechabe!","poem":2},{"text":"Kodi amapereka nsembe za ngʼombe zazimuna ku Giligala?","poem":1},{"text":"Maguwa awo ansembe adzakhala ngati milu ya miyala","poem":2},{"lineBreak":true},{"text":"mʼmunda molimidwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yakobo anathawira ku dziko la Aramu,","poem":1},{"text":"Israeli anagwira ntchito kuti apeze mkazi,","poem":2},{"lineBreak":true},{"text":"ndipo anaweta nkhosa kuti akwatire mkaziyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yehova anagwiritsa ntchito mneneri kuti atulutse Israeli mu Igupto;","poem":1},{"text":"kudzera mwa mneneriyo Iye anawasamalira.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Koma Efereimu wamukwiyitsa kwambiri.","poem":1},{"text":"Nʼchifukwa chake Yehova adzawalanga ndi imfa.","poem":2},{"lineBreak":true},{"text":"Adzawalanga chifukwa anamuchititsa manyazi kwambiri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}