{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Mkwiyo wa Yehova pa Israeli"]},{"type":"verse","number":1,"content":[{"text":"Kale Efereimu ankati akayankhula, anthu ankanjenjemera;","poem":1},{"text":"anali wolemekezeka mu Israeli.","poem":2},{"lineBreak":true},{"text":"Koma analakwa popembedza Baala, motero anafa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsopano akunka nachimwirachimwirabe;","poem":1},{"text":"akudzipangira mafano pogwiritsa ntchito siliva wawo,","poem":2},{"text":"zifanizo zopangidwa mwaluso,","poem":1},{"text":"zonsezo zopangidwa ndi amisiri.","poem":2},{"text":"Amanena za anthu awa kuti,","poem":1},{"text":"“Amatenga munthu ndi kumupereka nsembe","poem":2},{"lineBreak":true},{"text":"ndipo amapsompsona fano la mwana wangʼombe.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Choncho adzakhala ngati nkhungu yammawa,","poem":1},{"text":"ngati mame amene amakamuka msanga,","poem":2},{"lineBreak":true},{"text":"ngati mungu wowuluka kuchokera pa malo opunthira tirigu,","poem":2},{"lineBreak":true},{"text":"ngati utsi umene ukutulukira pa zenera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Koma Ine ndine Yehova Mulungu wanu,","poem":1},{"text":"amene ndinakutulutsani mu Igupto.","poem":2},{"text":"Simuyenera kudziwa Mulungu wina, koma Ine ndekha,","poem":1},{"text":"palibe Mpulumutsi wina kupatula Ine.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndinakusamalira mʼchipululu,","poem":1},{"text":"mʼdziko lotentha kwambiri.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pamene ndinawadyetsa, iwo anakhuta;","poem":1},{"text":"iwo atakhuta anayamba kunyada;","poem":2},{"lineBreak":true},{"text":"ndipo anandiyiwala Ine.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Motero ndidzawalumphira ngati mkango,","poem":1},{"text":"ndidzawabisalira mu msewu ngati kambuku.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngati chimbalangondo cholandidwa ana ake,","poem":1},{"text":"ndidzawambwandira ndi kuwathyolathyola.","poem":2},{"text":"Ndidzawapwepweta ngati mkango;","poem":1},{"text":"chirombo chakuthengo chidzawakhadzula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Iwe Israeli, wawonongedwa,","poem":1},{"text":"chifukwa ukutsutsana ndi Ine, ukutsutsana ndi mthandizi wako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodi mfumu yako ili kuti, kuti ikupulumutse?","poem":1},{"text":"Olamulira ako a mʼmizinda yonse ali kuti,","poem":2},{"text":"amene iwe unanena za iwo kuti,","poem":1},{"text":"‘Patseni mfumu ndi akalonga?’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Choncho Ine ndinakupatsani mfumu mwachipseramtima,","poem":1},{"text":"ndipo ndinayichotsa mwaukali.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kulakwa kwa Efereimu kwasungidwa,","poem":1},{"text":"machimo ake alembedwa mʼbuku.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zowawa zonga za mayi pa nthawi yobala mwana zamugwera,","poem":1},{"text":"koma iye ndi mwana wopanda nzeru,","poem":2},{"text":"pamene nthawi yake yobadwa yafika","poem":1},{"text":"iyeyo safuna kutuluka mʼmimba mwa amayi ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ndidzawapulumutsa ku mphamvu ya manda;","poem":1},{"text":"ndidzawawombola ku imfa.","poem":2},{"text":"Kodi iwe imfa, miliri yako ili kuti?","poem":1},{"text":"Kodi iwe manda, kuwononga kwako kuli kuti?","poem":2},{"lineBreak":true},{"text":"“Sindidzachitanso chifundo,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"ngakhale Efereimu akondwe pakati pa abale ake,","poem":2},{"text":"mphepo ya kummawa yochokera kwa Yehova idzabwera,","poem":1},{"text":"ikuwomba kuchokera ku chipululu.","poem":2},{"text":"Kasupe wake adzaphwa","poem":1},{"text":"ndipo chitsime chake chidzawuma.","poem":2},{"text":"Chuma chake chonse chamtengowapatali","poem":1},{"text":"chidzafunkhidwa ndipo chidzatengedwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Anthu a ku Samariya adzalangidwa chifukwa cha zolakwa zawo,","poem":1},{"text":"chifukwa anawukira Mulungu wawo.","poem":2},{"text":"Adzaphedwa ndi lupanga;","poem":1},{"text":"ana awo adzaphedwa mowamenyetsa pansi,","poem":2},{"lineBreak":true},{"text":"akazi awo oyembekezera adzatumbulidwa pa mimba.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}