{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Kulapa Kubweretsa Madalitso"]},{"type":"verse","number":1,"content":[{"text":"Iwe Israeli bwerera kwa Yehova Mulungu wako.","poem":1},{"text":"Machimo anu ndi amene akugwetsani!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bweretsani zopempha zanu","poem":1},{"text":"ndipo bwererani kwa Yehova.","poem":2},{"text":"Munene kwa Iye kuti,","poem":1},{"text":"“Tikhululukireni machimo athu onse","poem":2},{"text":"ndi kutilandira mokoma mtima,","poem":1},{"text":"kuti tithe kukuyamikani ndi mawu a pakamwa pathu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asiriya sangatipulumutse;","poem":1},{"text":"ife sitidzakwera pa akavalo ankhondo,","poem":2},{"text":"sitidzanenanso kuti, ‘Milungu yathu’","poem":1},{"text":"kwa zimene manja athu omwe anazipanga,","poem":2},{"lineBreak":true},{"text":"pakuti ndinu amene mumachitira chifundo ana amasiye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ine ndidzachiza kusakhulupirika kwawo","poem":1},{"text":"ndipo ndidzawakonda mwaufulu","poem":2},{"lineBreak":true},{"text":"pakuti ndaleka kuwakwiyira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndidzakhala ngati mame kwa Israeli","poem":1},{"text":"Ndipo iye adzachita maluwa ngati kakombo.","poem":2},{"text":"Adzazika mizu yake pansi","poem":1},{"text":"ngati mkungudza wa ku Lebanoni;","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"mphukira zake zidzakula.","poem":2},{"text":"Kukongola kwake kudzakhala ngati mtengo wa olivi,","poem":1},{"text":"kununkhira kwake ngati mkungudza wa ku Lebanoni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anthu adzakhalanso mu mthunzi wake.","poem":1},{"text":"Iye adzakula bwino ngati tirigu.","poem":2},{"text":"Adzachita maluwa ngati mphesa","poem":1},{"text":"ndipo kutchuka kwake kudzakhala ngati vinyo wochokera ku Lebanoni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efereimu adzati, “Ndidzachita nawonso chiyani mafano?","poem":1},{"text":"Ine ndidzamuyankha ndi kumusamalira.","poem":2},{"text":"Ine ndili ngati mtengo wa payini wobiriwira;","poem":1},{"text":"zipatso zako zimachokera kwa Ine.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndani ali ndi nzeru? Adzazindikire zinthu izi.","poem":1},{"text":"Ndani amene amamvetsa zinthu? Adzamvetse izi.","poem":2},{"text":"Njira za Yehova ndi zolungama;","poem":1},{"text":"anthu olungama amayenda mʼmenemo,","poem":2},{"lineBreak":true},{"text":"koma anthu owukira amapunthwamo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}