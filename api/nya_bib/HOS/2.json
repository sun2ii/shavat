{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["“Nena kwa abale ako kuti, ‘Ndinu anthu anga,’ kwa alongo ako kuti ‘Ndinu okondedwa anga.’ ”"]},{"type":"heading","content":["Kulangidwa ndi Kubwezeretsedwa kwa Israeli"]},{"type":"verse","number":2,"content":[{"text":"“Dzudzulani amayi anu, adzudzuleni iwo,","poem":1},{"text":"pakuti si mkazi wanga,","poem":2},{"lineBreak":true},{"text":"ndipo ine sindine mwamuna wake.","poem":2},{"text":"Iyeyo achotse maonekedwe adama pa nkhope yake,","poem":1},{"text":"ndi kusakhulupirika pa mawere ake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akapanda kutero ndidzamuvula,","poem":1},{"text":"ndipo adzakhala wamaliseche monga tsiku limene anabadwa;","poem":2},{"text":"ndidzamuwumitsa ngati chipululu,","poem":1},{"text":"adzakhala ngati dziko lopanda madzi,","poem":2},{"lineBreak":true},{"text":"ndi kumupha ndi ludzu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sindidzaonetsa chikondi changa pa ana ake,","poem":1},{"text":"chifukwa ndi ana a mʼchiwerewere.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amayi awo akhala akuchita zachiwerewere","poem":1},{"text":"ndipo anawabereka anawo akuchita zinthu zochititsa manyazi.","poem":2},{"text":"Iwo anati, ‘Ine ndidzatsatira zibwenzi zanga,","poem":1},{"text":"zimene zimandipatsa chakudya ndi madzi,","poem":2},{"lineBreak":true},{"text":"ubweya ndi thonje, mafuta ndi chakumwa.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Choncho njira yake ndidzayitseka ndi minga;","poem":1},{"text":"ndidzamuzinga ndi khoma kotero kuti sadzapezanso njira yotulukira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Adzathamangira zibwenzi zake koma sadzazipeza;","poem":1},{"text":"adzazifunafuna koma sadzazipeza.","poem":2},{"text":"Pamenepo iye adzati,","poem":1},{"text":"‘Ndibwerera kwa mwamuna wanga woyamba uja,","poem":2},{"lineBreak":true},{"text":"pakuti ndinali pabwino ndi iyeyo kusiyanitsa ndi pano.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iye sanazindikire kuti ndine amene","poem":1},{"text":"ndinkamupatsa tirigu, vinyo watsopano ndi mafuta.","poem":2},{"text":"Ndine amene ndinkamukhuthulira siliva ndi golide,","poem":1},{"text":"zimene ankapangira mafano a Baala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Choncho Ine ndidzamulanda tirigu wanga pa nthawi yokolola,","poem":1},{"text":"ndi vinyo wanga watsopano pa nthawi yopsinya mphesa.","poem":2},{"text":"Ndidzamulanda ubweya ndi thonje langa,","poem":1},{"text":"zomwe akanaphimba nazo umaliseche wake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Motero tsopano ndidzaonetsa maliseche ake","poem":1},{"text":"pamaso pa zibwenzi zake;","poem":2},{"lineBreak":true},{"text":"palibe ndi mmodzi yemwe adzamupulumutse mʼmanja mwanga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndidzathetsa zikondwerero zake zonse:","poem":1},{"text":"zikondwerero zake za chaka ndi chaka, za mwezi watsopano,","poem":2},{"lineBreak":true},{"text":"za pa masiku a Sabata ndi maphwando ake onse a pa masiku okhazikitsidwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndidzawononga mitengo yake ya mpesa ndi mitengo yake yamkuyu,","poem":1},{"text":"imene iye ankanena kuti inali malipiro ake ochokera kwa zibwenzi zake.","poem":2},{"text":"Ndidzayisandutsa chithukuluzi,","poem":1},{"text":"ndipo zirombo zakuthengo zidzadya zipatsozo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndidzamulanga chifukwa cha masiku","poem":1},{"text":"amene anafukiza lubani kwa Abaala;","poem":2},{"text":"anadzikongoletsa povala mphete ndi mikanda yamtengowapatali","poem":1},{"text":"ndipo anathamangira zibwenzi zake,","poem":2},{"lineBreak":true},{"text":"koma Ine anandiyiwala,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Koma tsopano ndidzamukopa mkaziyo;","poem":1},{"text":"ndidzapita naye ku chipululu","poem":2},{"lineBreak":true},{"text":"ndipo ndidzamuyankhula mwachikondi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kumeneko ndidzamubwezera minda yake ya mpesa,","poem":1},{"text":"ndipo ndidzasandutsa Chigwa cha Akori kukhala khomo la chiyembekezo.","poem":2},{"text":"Kumeneko iye adzayimba nyimbo monga mʼmasiku a ubwana wake,","poem":1},{"text":"monga tsiku limene anatuluka ku Igupto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Tsiku limeneli,” Yehova akuti,","poem":1},{"text":"“udzandiyitana kuti, ‘Amuna anga;’","poem":2},{"lineBreak":true},{"text":"sudzandiyitananso kuti, ‘Mbuye wanga.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndidzachotsa mayina a Abaala pakamwa pake;","poem":1},{"text":"sadzatchulanso mayina awo popemphera.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tsiku limenelo ndidzachita pangano","poem":1},{"text":"ndi zirombo zakuthengo ndi mbalame zamumlengalenga","poem":2},{"lineBreak":true},{"text":"ndiponso zolengedwa zokwawa pansi kuti ziyanjane ndi anthu anga.","poem":2},{"text":"Ndidzachotsa mʼdzikomo uta,","poem":1},{"text":"lupanga ndi zida zonse zankhondo,","poem":2},{"lineBreak":true},{"text":"kuti onse apumule mwamtendere.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndidzakutomera kuti ukhale mkazi wanga mpaka muyaya;","poem":1},{"text":"ndidzakutomera mwachilungamo, mwaungwiro,","poem":2},{"lineBreak":true},{"text":"mwachikondi ndi mwachifundo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndidzakutomera mokhulupirika","poem":1},{"text":"ndipo udzadziwa Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Tsiku limenelo Ine ndidzayankha,”","poem":1},{"text":"akutero Yehova.","poem":2},{"text":"“Ndidzayankha mlengalenga pempho lake lofuna mitambo","poem":1},{"text":"ndipo mvula idzagwa pa dziko lapansi;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ndipo nthaka idzamvera kupempha kwa tirigu,","poem":1},{"text":"vinyo ndi mafuta,","poem":2},{"lineBreak":true},{"text":"ndipo zidzamvera Yezireeli.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndidzadzala Israeli mʼdziko kuti akhale wanga:","poem":1},{"text":"ndidzaonetsa chikondi changa kwa anthu amene ndinkawatchula dzina loti, ‘Sakondedwa.’","poem":2},{"text":"Ndidzawawuza amene ndinkawatchula dzina loti, ‘Si anthu anga,’ kuti, ‘Ndinu anthu wanga;’","poem":1},{"text":"ndipo adzanena kuti, ‘ndinu Mulungu wathu,’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}