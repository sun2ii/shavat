{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Yehova Ayimba Mlandu Israeli"]},{"type":"verse","number":1,"content":[{"text":"Inu Aisraeli, imvani mawu a Yehova,","poem":1},{"text":"chifukwa Yehova ali ndi mlandu ndi inu","poem":2},{"lineBreak":true},{"text":"amene mumakhala mʼdzikoli:","poem":2},{"text":"“Mʼdziko mwanu mulibe kukhulupirika, mulibe chikondi","poem":1},{"text":"mulibe kulabadira za Mulungu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muli kutemberera kokha, kunama ndi kupha.","poem":1},{"text":"Kuba ndi kuchita chigololo;","poem":2},{"text":"machimo achita kunyanya","poem":1},{"text":"ndipo akungokhalira kuphana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Chifukwa chake dziko likulira","poem":1},{"text":"ndipo onse amene amakhalamo akuvutika;","poem":2},{"text":"zirombo zakuthengo ndi mbalame zamumlengalenga","poem":1},{"text":"ndiponso nsomba zamʼnyanja zikufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Koma wina asapeze mnzake chifukwa,","poem":1},{"text":"wina aliyense asayimbe mlandu mnzake,","poem":2},{"text":"pakuti anthu ako ali ngati anthu","poem":1},{"text":"amene amayimba mlandu wansembe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mumapunthwa usana ndi usiku","poem":1},{"text":"ndipo aneneri amapunthwa nanu pamodzi.","poem":2},{"text":"Choncho ndidzawononga amayi anu.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Anthu anga akuwonongeka chifukwa chosadziwa.","poem":2},{"lineBreak":true},{"text":"“Pakuti mwakana kudziwa,","poem":1},{"text":"Inenso ndidzakukanani monga ansembe anga;","poem":2},{"text":"chifukwa mwayiwala lamulo la Mulungu wanu,","poem":1},{"text":"Inenso ndidzayiwala ana anu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ansembe ankati akachuluka","poem":1},{"text":"iwo ankandichimwiranso kwambiri;","poem":2},{"lineBreak":true},{"text":"iwo anasinthanitsa ulemerero wawo ndi chinthu china chonyansa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amalemererapo pa machimo a anthu anga","poem":1},{"text":"ndipo amafunitsitsa kuti anthuwo azipitiriza kuchimwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndipo zidzakhala motere: zochitikira anthu ena, zidzachitikiranso ansembe.","poem":1},{"text":"Ndidzawalanga onsewo chifukwa cha njira zawo,","poem":2},{"lineBreak":true},{"text":"ndidzawabwezera chifukwa cha machitidwe awo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Iwo azidzadya koma sadzakhuta;","poem":1},{"text":"azidzachita zachiwerewere koma sadzachulukana,","poem":2},{"text":"chifukwa anasiya Yehova","poem":1},{"text":"kuti adzipereke","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ku zachiwerewere,","poem":2},{"text":"ku vinyo wakale ndi watsopano,","poem":1},{"text":"zimene zimachotsa nzeru zomvetsa zinthu","poem":2}]},{"type":"verse","number":12,"content":[{"text":"za anthu anga.","poem":1},{"lineBreak":true},{"text":"Anthu anga amapempha nzeru ku fano lamtengo","poem":1},{"text":"ndipo ndodo yawo yamtengo imawayankha.","poem":2},{"text":"Mzimu wachiwerewere umawasocheretsa;","poem":1},{"text":"iwo sakukhulupirika kwa Mulungu wawo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amapereka nsembe pamwamba pa mapiri","poem":1},{"text":"ndi kufukiza lubani pa zitunda,","poem":2},{"text":"pa tsinde pa mtengo wa thundu, mnjale ndi mkundi,","poem":1},{"text":"pamene pali mthunzi wabwino.","poem":2},{"text":"Nʼchifukwa chake ana anu aakazi akuchita zachiwerewere","poem":1},{"text":"ndipo akazi a ana anu akuchita zigololo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ine sindidzalanga ana anu aakazi","poem":1},{"text":"pamene iwo adzachita zachiwerewere,","poem":2},{"text":"kapena akazi a ana anu","poem":1},{"text":"pamene adzachita zigololo.","poem":2},{"text":"Paja inu nomwe amunanu mumayenda ndi akazi achiwerewere,","poem":1},{"text":"ndipo mumapereka nsembe pamodzi ndi akazi achiwerewere a ku malo opembedzerako.","poem":2},{"lineBreak":true},{"text":"Anthu amene alibe nzeru adzawonongeka ndithu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ngakhale umachita chigololo, iwe Israeli,","poem":1},{"text":"Yuda asapezeke ndi mlandu wotere.","poem":2},{"lineBreak":true},{"text":"“Usapite ku Giligala.","poem":1},{"text":"Usapite ku Beti-Aveni.","poem":2},{"lineBreak":true},{"text":"Ndipo usalumbire kuti, ‘Pali Yehova wamoyo!’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Aisraeli ndi nkhutukumve,","poem":1},{"text":"ngosamva ngati ana angʼombe.","poem":2},{"text":"Kodi Yehova angathe kuwaweta bwanji","poem":1},{"text":"ngati ana ankhosa pa msipu wabwino?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Efereimu waphathana ndi mafano;","poem":1},{"text":"mulekeni!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngakhale pamene zakumwa zawo zatha,","poem":1},{"text":"amapitiriza kuchita zachiwerewere;","poem":2},{"lineBreak":true},{"text":"atsogoleri awo amakonda kwambiri njira zawo zochititsa manyazi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Adzachotsedwa ndi kamvuluvulu","poem":1},{"text":"ndipo adzachita manyazi chifukwa cha nsembe zawo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}