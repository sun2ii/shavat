{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Chiweruzo cha Israeli"]},{"type":"verse","number":1,"content":[{"text":"“Ansembe inu, imvani izi!","poem":1},{"text":"Inu Aisraeli, tcherani khutu!","poem":2},{"text":"Inu nyumba yaufumu, mvetserani!","poem":1},{"text":"Chiweruzo ichi ndi chotsutsa inu:","poem":2},{"text":"Inu munali ngati msampha ku Mizipa,","poem":1},{"text":"munali ngati ukonde woyalidwa pa phiri la Tabori.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Owukira azama mʼmoyo wakupha,","poem":1},{"text":"Ine ndidzawalanga onsewo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndimadziwa zonse za Efereimu;","poem":1},{"text":"Aisraeli ndi osabisika kwa Ine.","poem":2},{"text":"Efereimu wayamba tsopano kuchita zachiwerewere;","poem":1},{"text":"Israeli wadziyipitsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ntchito zawo siziwalola","poem":1},{"text":"kubwerera kwa Mulungu wawo.","poem":2},{"text":"Mʼmitima mwawo muli mzimu wachiwerewere;","poem":1},{"text":"Iwo sadziwa Yehova.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kudzikuza kwa Israeli kwakhala umboni womutsutsa;","poem":1},{"text":"Aisraeli, ngakhale Aefereimu, anagwa mʼmachimo awo;","poem":2},{"lineBreak":true},{"text":"Yudanso anagwa nawo pamodzi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pamene adzapita ndi nkhosa zawo ndi ngʼombe zawo","poem":1},{"text":"kukapereka nsembe kwa Yehova,","poem":2},{"text":"iwo sadzamupeza;","poem":1},{"text":"Iye wawachokera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iwo ndi osakhulupirika kwa Yehova;","poem":1},{"text":"amabereka ana amʼchigololo","poem":2},{"text":"ndipo chikondwerero chawo cha mwezi watsopano","poem":1},{"text":"chidzawawononga pamodzi ndi minda yawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Womba lipenga mu Gibeya,","poem":1},{"text":"liza mbetete mu Rama.","poem":2},{"text":"Fuwulani mfuwu wankhondo mu Beti-Aveni;","poem":1},{"text":"iwe Benjamini tsogolera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efereimu adzasanduka bwinja","poem":1},{"text":"pa tsiku la chilango.","poem":2},{"text":"Ine ndikulengeza zomwe zidzachitikadi","poem":1},{"text":"pakati pa mafuko a Israeli.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Atsogoleri a Yuda ali ngati anthu","poem":1},{"text":"amene amasuntha miyala ya mʼmalire.","poem":2},{"text":"Ndidzawakhutulira ukali wanga","poem":1},{"text":"ngati madzi a chigumula.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efereimu waponderezedwa,","poem":1},{"text":"akulangidwa chifukwa chotsatira","poem":2},{"lineBreak":true},{"text":"mafano.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ine ndili ngati njenjete kwa Efereimu,","poem":1},{"text":"ngati chinthu chowola kwa anthu a ku Yuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Efereimu ataona nthenda yake,","poem":1},{"text":"ndi Yuda ataona zilonda zake,","poem":2},{"text":"pamenepo Efereimu anatembenukira kwa Asiriya,","poem":1},{"text":"ndipo anawatumizira mfumu yayikulu kudzawathandiza.","poem":2},{"text":"Koma mfumuyo singathe kukuchizani,","poem":1},{"text":"singathe kuchiritsa mabala anu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pakuti Ine ndidzakhala ngati mkango kwa Efereimu.","poem":1},{"text":"Ngati mkango wamphamvu kwa Yuda.","poem":2},{"text":"Ndidzawakhadzula nʼkuchokapo;","poem":1},{"text":"ndidzawatenga ndipo palibe amene adzawalanditse.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndipo ndidzabwerera ku malo anga","poem":1},{"text":"mpaka anthu anga atavomereza kulakwa kwawo.","poem":2},{"text":"Ndipo iwo adzafunafuna nkhope yanga;","poem":1},{"text":"mʼmasautso awo adzandifunitsitsa Ine.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}