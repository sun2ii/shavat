{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Kusalapa kwa Israeli"]},{"type":"verse","number":1,"content":[{"text":"“Bwerani, tiyeni tibwerere kwa Yehova.","poem":1},{"lineBreak":true},{"text":"Iye watikhadzula,","poem":1},{"text":"koma adzatichiritsa.","poem":2},{"text":"Iye wativulaza,","poem":1},{"text":"koma adzamanga mabala athu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pakapita masiku awiri adzatitsitsimutsa;","poem":1},{"text":"pa tsiku lachitatu Iye adzatiukitsa","poem":2},{"lineBreak":true},{"text":"kuti tikhale ndi moyo pamaso pake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tiyeni timudziwe Yehova,","poem":1},{"text":"tiyeni tilimbike kumudziwa Iye.","poem":2},{"text":"Adzabwera kwa ife mosakayikira konse","poem":1},{"text":"ngati kutuluka kwa dzuwa;","poem":2},{"text":"adzabwera kwa ife ngati mvula ya mʼchilimwe,","poem":1},{"text":"ngati mvula ya nthawi yamphukira imene imakhathamiritsa nthaka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iwe Efereimu, kodi ndichite nawe chiyani?","poem":1},{"text":"Kodi ndichite nawe chiyani, iwe Yuda?","poem":2},{"text":"Chikondi chanu chili ngati nkhungu yammawa,","poem":1},{"text":"ngati mame a mmamawa amene amakamuka msanga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Choncho ndakuwazani ngati nkhuni kudzera mwa aneneri anga,","poem":1},{"text":"ndakuphani ndi mawu a pakamwa panga;","poem":2},{"lineBreak":true},{"text":"chigamulo changa chinangʼanima ngati mphenzi pa inu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pakuti Ine ndimafuna chifundo osati nsembe,","poem":1},{"text":"ndi kudziwa Mulungu kulekana ndi nsembe zopsereza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Monga Adamu, anthuwa aphwanya pangano langa,","poem":1},{"text":"iwo sanakhulupirike kwa Ine.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Giliyadi ndi mzinda wa anthu ochita zoyipa,","poem":1},{"text":"okhala ndi zizindikiro za kuphana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Monga momwe mbala zimadikirira anthu,","poem":1},{"text":"magulu a ansembe amachitanso motero;","poem":2},{"text":"iwo amapha anthu pa njira yopita ku Sekemu,","poem":1},{"text":"kupalamula milandu yochititsa manyazi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndaona chinthu choopsa kwambiri","poem":1},{"text":"mʼnyumba ya Israeli.","poem":2},{"text":"Kumeneko Efereimu akuchita zachiwerewere,","poem":1},{"text":"ndipo Israeli wadzidetsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Kunenanso za iwe Yuda,","poem":1},{"text":"udzakolola chilango.","poem":2},{"lineBreak":true},{"text":"“Pamene ndiwabwezere anthu anga zinthu zabwino.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}