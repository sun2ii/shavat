{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Pamene ndichiritsa Israeli,","poem":1},{"lineBreak":true},{"text":"machimo a Efereimu amaonekera poyera","poem":1},{"text":"ndiponso milandu ya Samariya sibisika.","poem":2},{"text":"Iwo amachita zachinyengo,","poem":1},{"text":"mbala zimathyola nyumba,","poem":2},{"lineBreak":true},{"text":"achifwamba amalanda anthu katundu mʼmisewu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Koma sazindikira kuti Ine","poem":1},{"text":"ndimakumbukira zoyipa zawo zonse.","poem":2},{"text":"Azunguliridwa ndi zolakwa zawo;","poem":1},{"text":"ndipo sizichoka mʼmaso mwanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Anthuwa amasangalatsa mfumu ndi zoyipa zawozo,","poem":1},{"text":"akalonga amasekerera mabodza awo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onsewa ndi anthu azigololo,","poem":1},{"text":"otentha ngati moto wa mu uvuni,","poem":2},{"text":"umene wophika buledi sasonkhezera","poem":1},{"text":"kuyambira pamene akukanda buledi mpaka atafufuma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pa tsiku la chikondwerero cha mfumu yathu","poem":1},{"text":"akalonga amaledzera ndi vinyo,","poem":2},{"lineBreak":true},{"text":"ndipo amalowa mʼgulu la anthu achipongwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mitima yawo ili ngati uvuni;","poem":1},{"text":"amayandikira Mulungu mwachiwembu.","poem":2},{"text":"Ukali wawo umanyeka usiku wonse,","poem":1},{"text":"mmawa umayaka ngati malawi a moto.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onsewa ndi otentha ngati uvuni,","poem":1},{"text":"amapha olamulira awo.","poem":2},{"text":"Mafumu awo onse amagwa,","poem":1},{"text":"ndipo palibe ndi mmodzi yemwe amandiyitana Ine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Efereimu wasakanikirana ndi mitundu ya anthu ena;","poem":1},{"text":"Efereimu ndi buledi amene wapsa mbali imodzi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Alendo atha mphamvu zake,","poem":1},{"text":"koma iye sakuzindikira.","poem":2},{"text":"Tsitsi lake layamba imvi","poem":1},{"text":"koma iye sakudziwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kunyada kwake Israeli kukumutsutsa,","poem":1},{"text":"koma pa zonsezi","poem":2},{"text":"iye sakubwerera kwa Yehova Mulungu wake","poem":1},{"text":"kapena kumufunafuna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Efereimu ali ngati nkhunda","poem":1},{"text":"yopusa yopanda nzeru.","poem":2},{"text":"Amayitana Igupto","poem":1},{"text":"namapita ku Asiriya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akamadzapita, ndidzawakola ndi ukonde wanga;","poem":1},{"text":"ndidzawagwetsa pansi ngati mbalame zamumlengalenga.","poem":2},{"text":"Ndikadzamva kuti asonkhana pamodzi","poem":1},{"text":"ndidzawakola.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tsoka kwa iwo,","poem":1},{"text":"chifukwa andisiya Ine!","poem":2},{"text":"Chiwonongeko kwa iwo,","poem":1},{"text":"chifukwa andiwukira!","poem":2},{"text":"Ndimafunitsitsa kuwapulumutsa","poem":1},{"text":"koma amayankhula za Ine monama.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iwo salirira kwa Ine kuchokera pansi pa mtima,","poem":1},{"text":"koma amalira mofuwula ali pa bedi pawo.","poem":2},{"text":"Amadzichekacheka chifukwa chofuna tirigu ndi vinyo watsopano,","poem":1},{"text":"koma amandifulatira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ine ndinawaphunzitsa ndikuwalimbitsa,","poem":1},{"text":"koma amandikonzera chiwembu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iwo satembenukira kwa Wammwambamwamba;","poem":1},{"text":"ali ngati uta woonongeka.","poem":2},{"text":"Atsogoleri awo adzaphedwa ndi lupanga","poem":1},{"text":"chifukwa cha mawu awo achipongwe.","poem":2},{"text":"Motero iwo adzasekedwa","poem":1},{"text":"mʼdziko la Igupto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}