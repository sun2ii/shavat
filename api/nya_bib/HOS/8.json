{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Israeli Akolola Kamvuluvulu"]},{"type":"verse","number":1,"content":[{"text":"“Ika lipenga pakamwa pako.","poem":1},{"text":"Ngati chiwombankhanga, kutsutsana ndi nyumba ya Yehova","poem":2},{"text":"chifukwa anthu aphwanya pangano langa","poem":1},{"text":"ndiponso agalukira lamulo langa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Israeli akulirira kwa Ine kuti,","poem":1},{"text":"‘Inu Mulungu wathu, ife timakudziwani!’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Koma Israeli wakana zabwino;","poem":1},{"text":"mdani adzamuthamangitsa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amalonga mafumu mosatsata kufuna kwanga.","poem":1},{"text":"Amasankha akalonga popanda chilolezo changa.","poem":2},{"text":"Amadzipangira mafano","poem":1},{"text":"asiliva ndi agolide","poem":2},{"lineBreak":true},{"text":"koma adzawonongeka nawo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iwe Samariya, taya fano lako la mwana wangʼombe!","poem":1},{"text":"Mkwiyo wanga wayakira anthuwo.","poem":2},{"text":"Padzapita nthawi yayitali chotani asanasinthike kukhala oyera mtima?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Mafanowa ndi ochokera ku Israeli!","poem":2},{"text":"Mwana wa ngʼombe uyu anapangidwa ndi munthu waluso;","poem":1},{"text":"si Mulungu amene anamupanga.","poem":2},{"text":"Adzaphwanyidwa nʼkukhala zidutswa,","poem":1},{"text":"mwana wangʼombe wa ku Samariya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Aisraeli amadzala mphepo","poem":1},{"text":"ndipo amakolola kamvuluvulu.","poem":2},{"text":"Tirigu alibe ngala;","poem":1},{"text":"sadzabala chakudya.","poem":2},{"text":"Akanabala chakudya","poem":1},{"text":"alendo akanadya chakudyacho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Israeli wamezedwa,","poem":1},{"text":"tsopano ali pakati pa anthu a mitundu ina","poem":2},{"lineBreak":true},{"text":"ngati chinthu cha chabechabe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pakuti iwo anapita ku Asiriya","poem":1},{"text":"ngati mbidzi yongodziyendera pa yokha.","poem":2},{"lineBreak":true},{"text":"Efereimu wadzigulitsa kwa zibwenzi zake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngakhale wadzigulitsa pakati pa mitundu ya anthu,","poem":1},{"text":"Ine ndidzawasonkhanitsa pamodzi.","poem":2},{"text":"Iwo adzayamba kuzunzika pansi pa","poem":1},{"text":"ulamuliro wankhanza wa mfumu yamphamvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ngakhale Efereimu anamanga maguwa ambiri a nsembe zoperekedwa chifukwa cha tchimo,","poem":1},{"text":"maguwa amenewa akhala malo ochimwirapo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndinawalembera zinthu zambiri za malamulo anga,","poem":1},{"text":"koma iwo anaziyesa ngati zinthu zachilendo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amapereka nsembe za nyama kwa Ine","poem":1},{"text":"ndipo iwo amadya nyamayo,","poem":2},{"lineBreak":true},{"text":"koma Yehova sakondwera nazo.","poem":2},{"text":"Tsopano Iye adzakumbukira zoyipa zawo","poem":1},{"text":"ndi kuwalanga chifukwa cha machimo awo:","poem":2},{"lineBreak":true},{"text":"iwowo adzabwerera ku Igupto.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israeli wayiwala Mlengi wake","poem":1},{"text":"ndipo wamanga nyumba zaufumu;","poem":2},{"lineBreak":true},{"text":"Yuda wachulukitsa mizinda ya malinga.","poem":2},{"text":"Koma Ine ndidzaponya moto pa mizinda yawoyo,","poem":1},{"text":"moto umene udzatenthe malinga awo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}