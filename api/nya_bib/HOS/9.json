{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"HOS","translationId":"nya_bib","name":"HOSEYA","commonName":"HOSEYA","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"22d2826a6ee9d0278e9d5b90084d9ae744526fbfb1ba97b1e470c6f10e2ca501","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Chilango cha Israeli"]},{"type":"verse","number":1,"content":[{"text":"Iwe Israeli, usakondwere;","poem":1},{"text":"monga imachitira mitundu ina.","poem":2},{"text":"Pakuti wakhala wosakhulupirika kwa Mulungu wako;","poem":1},{"text":"umakonda malipiro a chiwerewere","poem":2},{"lineBreak":true},{"text":"pa malo aliwonse opunthira tirigu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Malo opunthira tirigu ndi malo opsinyira mphesa sadzadyetsa anthu;","poem":1},{"text":"adzasowa vinyo watsopano.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sadzakhalanso mʼdziko la Yehova.","poem":1},{"text":"Efereimu adzabwerera ku Igupto","poem":2},{"lineBreak":true},{"text":"ndipo mudzadya chakudya chodetsedwa ku Asiriya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iwo sadzaperekanso chopereka cha chakumwa kwa Yehova,","poem":1},{"text":"kapena nsembe zawo kuti akondweretse Yehovayo.","poem":2},{"text":"Nsembe zotere zidzakhala kwa iwo ngati chakudya cha anamfedwa;","poem":1},{"text":"onse akudya chakudya chimenechi adzakhala odetsedwa.","poem":2},{"text":"Chakudya ichi chidzakhala chodya okha,","poem":1},{"text":"sichidzalowa mʼnyumba ya Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kodi mudzachita chiyani pa tsiku la maphwando anu oyikika;","poem":1},{"text":"pa masiku a zikondwerero za Yehova?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngakhale iwo atathawa chiwonongeko,","poem":1},{"text":"Igupto adzawasonkhanitsa,","poem":2},{"lineBreak":true},{"text":"ndipo Mefisi adzawayika mʼmanda.","poem":2},{"text":"Khwisa adzamera pa ziwiya zawo zasiliva,","poem":1},{"text":"ndipo minga idzamera mʼmatenti awo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Masiku achilango akubwera,","poem":1},{"text":"masiku obwezera ali pafupi.","poem":2},{"lineBreak":true},{"text":"Israeli adziwe zimenezi.","poem":2},{"text":"Chifukwa machimo anu ndi ochuluka kwambiri","poem":1},{"text":"ndipo udani wanu pa Mulungu ndi waukulu kwambiri.","poem":2},{"text":"Mneneri amamuyesa chitsiru,","poem":1},{"text":"munthu wanzeru za kwa Mulungu ngati wamisala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mneneri pamodzi ndi Mulungu wanga","poem":1},{"text":"ndiwo alonda a Efereimu,","poem":2},{"text":"koma mneneri amutchera misampha mʼnjira zake zonse,","poem":1},{"text":"ndipo udani ukumudikira mʼnyumba ya Mulungu wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iwo azama mu zachinyengo","poem":1},{"text":"monga masiku a Gibeya.","poem":2},{"text":"Mulungu adzakumbukira zolakwa zawo","poem":1},{"text":"ndipo adzawalanga chifukwa cha machimo awo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Pamene ndinamupeza Israeli","poem":1},{"text":"zinali ngati kupeza mphesa mʼchipululu.","poem":2},{"text":"Nditaona makolo anu,","poem":1},{"text":"zinali ngati ndikuona nkhuyu zoyambirira kupsa.","poem":2},{"text":"Koma atafika ku Baala Peori,","poem":1},{"text":"anadzipereka ku fano lija lochititsa manyazi","poem":2},{"lineBreak":true},{"text":"ndipo anakhala onyansa ngati chinthu chimene anachikondacho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ulemerero wa Efereimu udzawuluka ngati mbalame.","poem":1},{"text":"Sipadzakhalanso kubereka ana, kuyembekezera kapena kutenga pathupi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngakhale atalera ana","poem":1},{"text":"ndidzachititsa kuti mwana aliyense amwalire.","poem":2},{"text":"Tsoka kwa anthuwo","poem":1},{"text":"pamene Ine ndidzawafulatira!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndaona Efereimu ngati Turo,","poem":1},{"text":"atadzalidwa pa nthaka ya chonde.","poem":2},{"text":"Koma Efereimu adzatsogolera","poem":1},{"text":"ana ake kuti akaphedwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Inu Yehova, muwapatse.","poem":1},{"text":"Kodi mudzawapatsa chiyani?","poem":2},{"text":"Apatseni mimba yomangopita padera","poem":1},{"text":"ndi mawere owuma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Chifukwa cha zoyipa zawo zonse ku Giligala,","poem":1},{"text":"Ine ndinawada kumeneko.","poem":2},{"text":"Chifukwa cha machitidwe awo auchimo,","poem":1},{"text":"ndidzawapirikitsa mʼnyumba yanga.","poem":2},{"text":"Sindidzawakondanso;","poem":1},{"text":"atsogoleri awo onse ndi owukira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Efereimu wathedwa,","poem":1},{"text":"mizu yake yauma","poem":2},{"lineBreak":true},{"text":"sakubalanso zipatso.","poem":2},{"text":"Ngakhale atabereka ana,","poem":1},{"text":"Ine ndidzapha ana awo okondedwawo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mulungu wanga adzawakana","poem":1},{"text":"chifukwa sanamumvere Iye;","poem":2},{"lineBreak":true},{"text":"adzakhala oyendayenda pakati pa anthu a mitundu ina.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}