{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Masomphenya wonena za Yuda ndi Yerusalemu, amene Yesaya mwana wa Amozi, anaona pa nthawi ya ulamuliro wa Uziya, Yotamu, Ahazi ndi Hezekiya, mafumu a Yuda."]},{"type":"heading","content":["Anthu Owukira"]},{"type":"verse","number":2,"content":[{"text":"Tamverani, miyamba inu! Tchera khutu, iwe dziko lapansi!","poem":1},{"text":"Pakuti Yehova wanena kuti,","poem":2},{"text":"“Ndinabala ana ndi kuwalera,","poem":1},{"text":"koma anawo andiwukira Ine.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngʼombe imadziwa mwini wake,","poem":1},{"text":"bulu amadziwa kumene kuli gome la mbuye wake,","poem":2},{"text":"koma Israeli sadziwa,","poem":1},{"text":"anthu anga samvetsa konse.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Haa, mtundu wochimwa,","poem":1},{"text":"anthu olemedwa ndi machimo,","poem":2},{"text":"obadwa kwa anthu ochita zoyipa,","poem":1},{"text":"ana odzipereka ku zoyipa!","poem":2},{"text":"Iwo asiya Yehova;","poem":1},{"text":"anyoza Woyerayo wa Israeli","poem":2},{"lineBreak":true},{"text":"ndipo afulatira Iyeyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Chifukwa chiyani mukufuna kuti muzingolangidwabe?","poem":1},{"text":"Chifukwa chiyani mukupitirira kukhala mʼmoyo wowukira?","poem":2},{"text":"Mutu wanu wonse uli ndi mabala,","poem":1},{"text":"mtima wanu wonse wafowokeratu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuchokera ku phazi mpaka ku mutu","poem":1},{"text":"palibe pabwino,","poem":2},{"text":"paliponse pali mikwingwirima ndi zilonda,","poem":1},{"text":"mabala ali magazi chuchuchu,","poem":2},{"text":"mabala ake ngosatsuka, ngosamanga","poem":1},{"text":"ndiponso ngosapaka mafuta ofewetsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dziko lanu lasanduka bwinja,","poem":1},{"text":"mizinda yanu yatenthedwa ndi moto;","poem":2},{"text":"minda yanu ikukololedwa ndi alendo","poem":1},{"text":"inu muli pomwepo,","poem":2},{"lineBreak":true},{"text":"dziko lanu lasanduka bwinja monga ngati lagonjetsedwa ndi alendo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwana wamkazi wa Ziyoni watsala yekha","poem":1},{"text":"ngati nsanja mʼmunda wampesa,","poem":2},{"text":"ngati chisimba mʼmunda wa minkhaka,","poem":1},{"text":"ngati mzinda wozingidwa ndi nkhondo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yehova Wamphamvuzonse akanapanda","poem":1},{"text":"kutisiyira opulumuka,","poem":2},{"text":"tikanawonongeka ngati Sodomu,","poem":1},{"text":"tikanakhala ngati anthu a ku Gomora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Imvani mawu a Yehova,","poem":1},{"text":"inu olamulira Sodomu;","poem":2},{"text":"mverani lamulo la Mulungu wathu,","poem":1},{"text":"inu anthu a ku Gomora!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yehova akuti, “Kodi ndili nazo chiyani","poem":1},{"text":"nsembe zanu zochuluka?”","poem":2},{"text":"“Zandikola nsembe zanu zopsereza","poem":1},{"text":"za nkhosa zazimuna ndiponso mafuta a nyama zonenepa;","poem":2},{"text":"sindikusangalatsidwanso","poem":1},{"text":"ndi magazi angʼombe zamphongo ndi a ana ankhosa ndi ambuzi zazimuna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndani anakulamulirani kuti","poem":1},{"text":"mubwere nazo pamaso panga?","poem":2},{"lineBreak":true},{"text":"Ndani anakuwuzani kuti muzipondaponda mʼmabwalo a nyumba yanga?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Siyani kubweretsa nsembe zachabechabezo!","poem":1},{"text":"Nsembe zanu zofukiza zimandinyansa Ine.","poem":2},{"text":"Sindingapirire misonkhano yanu yoyipa,","poem":1},{"text":"kapenanso zikondwerero za Mwezi Watsopano ndi Masabata.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Zikondwerero zanu za Mwezi Watsopano ndi masiku anu opatulika","poem":1},{"text":"ndimadana nazo.","poem":2},{"text":"Zasanduka katundu wondilemera;","poem":1},{"text":"ndatopa kuzinyamula.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mukamatambasula manja anu popemphera,","poem":1},{"text":"Ine sindidzakuyangʼanani;","poem":2},{"text":"ngakhale muchulukitse mapemphero anu,","poem":1},{"text":"sindidzakumverani.","poem":2},{"text":"Manja anu ndi odzaza ndi magazi;","poem":1}]},{"type":"verse","number":16,"content":[{"text":"sambani, dziyeretseni.","poem":2},{"text":"Chotsani pamaso panu","poem":1},{"text":"ntchito zanu zoyipa!","poem":2},{"text":"Lekani kuchita zoyipa,","poem":1}]},{"type":"verse","number":17,"content":[{"text":"phunzirani kuchita zabwino!","poem":2},{"text":"Funafunani chilungamo,","poem":1},{"text":"thandizani oponderezedwa.","poem":2},{"text":"Tetezani ana amasiye,","poem":1},{"text":"muwayimirire akazi amasiye pa milandu yawo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yehova akuti,","poem":1},{"text":"“Tiyeni tsono tikambe mlandu wanu.","poem":2},{"text":"Ngakhale machimo anu ali ofiira,","poem":1},{"text":"adzayera ngati thonje.","poem":2},{"text":"Ngakhale ali ofiira ngati kapezi,","poem":1},{"text":"adzayera ngati ubweya wankhosa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngati muli okonzeka kundimvera","poem":1},{"text":"mudzadya zinthu zabwino za mʼdziko;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"koma mukakana ndi kuwukira","poem":1},{"text":"mudzaphedwa ndi lupanga.”","poem":2},{"text":"Pakuti Yehova wayankhula.","poem":4}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Taonani momwe mzinda wokhulupirika","poem":1},{"text":"wasandukira wadama!","poem":2},{"text":"Mzinda umene kale unali wodzaza ndi chiweruzo cholungama;","poem":1},{"text":"mu mzindamo munali chilungamo,","poem":2},{"lineBreak":true},{"text":"koma tsopano muli anthu opha anzawo!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Siliva wako wasanduka wachabechabe,","poem":1},{"text":"vinyo wako wabwino wasungunulidwa ndi madzi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Atsogoleri ako ndi owukira,","poem":1},{"text":"anthu ogwirizana ndi mbala;","poem":2},{"text":"onse amakonda ziphuphu","poem":1},{"text":"ndipo amathamangira mphatso.","poem":2},{"text":"Iwo sateteza ana amasiye;","poem":1},{"text":"ndipo samvera madandawulo a akazi amasiye.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nʼchifukwa chake Ambuye Yehova Wamphamvu,","poem":1},{"text":"Wamphamvuyo wa Israeli, akunena kuti,","poem":2},{"text":"“Haa, odana nane ndidzawatha,","poem":1},{"text":"ndipo ndidzawabwezera ndekha adani anga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndidzatambasula dzanja langa kuti ndilimbane nawe;","poem":1},{"text":"ndidzasungunula machimo ako nʼkuwachotsa,","poem":2},{"lineBreak":true},{"text":"monga mmene amachotsera dzimbiri ndi mankhwala.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndidzabwezeretsa oweruza ako ngati masiku amakedzana,","poem":1},{"text":"aphungu ako ndidzawabwezeretsa ngati poyamba paja.","poem":2},{"text":"Kenaka iweyo udzatchedwa","poem":1},{"text":"mzinda wolungama,","poem":2},{"lineBreak":true},{"text":"mzinda wokhulupirika.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ziyoni adzawomboledwa mwa chiweruzo cholungama,","poem":1},{"text":"anthu ake olapadi adzapulumutsidwa mwachilungamo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Koma owukira ndi ochimwa adzawawonongera pamodzi,","poem":1},{"text":"ndipo amene asiya Yehova adzatheratu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Mudzachita nayo manyazi mitengo ya thundu","poem":1},{"text":"imene inkakusangalatsani;","poem":2},{"text":"mudzagwetsa nkhope chifukwa cha minda","poem":1},{"text":"imene munayipatula.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mudzakhala ngati mtengo wa thundu umene masamba ake akufota,","poem":1},{"text":"mudzakhala ngati munda wopanda madzi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Munthu wamphamvu adzasanduka ngati udzu wowuma,","poem":1},{"text":"ndipo ntchito zake zidzakhala ngati mbaliwali;","poem":2},{"text":"motero zonse zidzayakira limodzi,","poem":1},{"text":"popanda woti azimitse motowo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}