{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Nyimbo za Mayamiko"]},{"type":"verse","number":1,"content":["Tsiku limenelo aliyense wa inu adzati:",{"text":"“Ndikukuyamikani, Inu Yehova;","poem":1},{"text":"chifukwa ngakhale munandipsera mtima,","poem":2},{"text":"mkwiyo wanu wachoka,","poem":1},{"text":"ndipo mwanditonthoza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zoonadi, Mulungu ndiye Mpulumutsi wanga;","poem":1},{"text":"ndidzamudalira ndipo sindidzachita mantha.","poem":2},{"text":"Yehova ndiye mphamvu yanga ndi nyimbo yanga;","poem":1},{"text":"Iye wakhala chipulumutso changa.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mudzakondwera popeza Yehova","poem":1},{"text":"ali ngati chitsime cha chipulumutso chanu.","poem":2}]},{"type":"verse","number":4,"content":["Tsiku limenelo mudzati:",{"text":"“Yamikani Yehova, tamandani dzina lake;","poem":1},{"text":"mulengeze ntchito zake pakati pa mitundu ya anthu,","poem":2},{"lineBreak":true},{"text":"ndipo mulalike kuti dzina lake ndi lopambana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Imbirani Yehova, pakuti wachita ntchito zazikulu;","poem":1},{"text":"zimenezi zidziwike pa dziko lonse lapansi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Fuwulani ndi kuyimba mwachimwemwe, inu anthu a ku Ziyoni;","poem":1},{"text":"pakuti Woyerayo wa Israeli ndi wamkulu pakati panu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}