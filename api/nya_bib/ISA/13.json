{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["Kulangidwa Kwa Babuloni"]},{"type":"verse","number":1,"content":["Uthenga onena za Babuloni umene Yesaya mwana wa Amozi anawulandira:"]},{"type":"verse","number":2,"content":[{"text":"Kwezani mbendera yankhondo pa phiri loti see,","poem":1},{"text":"muwafuwulire ankhondo;","poem":2},{"text":"muwakodole kuti adzalowe pa zipata","poem":1},{"text":"za anthu olemekezeka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ine Yehova, ndalamulira ankhondo anga;","poem":1},{"text":"ndasonkhanitsa ankhondo anga kuti akhale zida zanga zolangira","poem":2},{"lineBreak":true},{"text":"amene amadzikuza ndi chipambano changa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tamvani phokoso ku mapiri,","poem":1},{"text":"likumveka ngati phokoso la gulu lalikulu la anthu!","poem":2},{"text":"Tamvani phokoso pakati pa maufumu,","poem":1},{"text":"ngati kuti mitundu ya anthu ikusonkhana pamodzi!","poem":2},{"text":"Yehova Wamphamvuzonse akukhazika asilikali ake mokonzekera","poem":1},{"text":"kuchita nkhondo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iwo akuchokera ku mayiko akutali,","poem":1},{"text":"kuchokera kumalekezero a dziko","poem":2},{"text":"Yehova ali ndi zida zake za nkhondo","poem":1},{"text":"kuti adzawononge dziko la Babuloni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lirani mofuwula, pakuti tsiku la Yehova layandikira;","poem":1},{"text":"lidzabwera ngati chiwonongeko chochokera kwa Wamphamvuzonse.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zimenezi zinafowoketsa manja onse,","poem":1},{"text":"mtima wa munthu aliyense udzachokamo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anthu adzagwidwa ndi mantha aakulu,","poem":1},{"text":"zowawa ndi masautso zidzawagwera;","poem":2},{"lineBreak":true},{"text":"adzamva zowawa zonga amamva mayi pobereka.","poem":2},{"text":"Adzayangʼanana mwamantha,","poem":1},{"text":"nkhope zawo zikufiira ngati malawi amoto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Taonani, tsiku la Yehova likubwera,","poem":1},{"text":"tsiku lopanda chisoni, lawukali ndi lamkwiyo;","poem":2},{"text":"kudzasandutsa dziko kuti likhale chipululu","poem":1},{"text":"ndi kuwononga anthu ochimwa a mʼmenemo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nyenyezi zakumwamba ndiponso zonse zamlengalenga","poem":1},{"text":"sizidzaonetsa kuwala kwawo.","poem":2},{"text":"Dzuwa lidzada potuluka,","poem":1},{"text":"ndipo mwezi sudzawala konse.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndidzalanga dziko lonse chifukwa cha zolakwa zake,","poem":1},{"text":"anthu oyipa ndidzawalanga chifukwa cha machimo awo.","poem":2},{"text":"Ndidzathetsa kunyada kwa odzikuza,","poem":1},{"text":"ndipo ndidzatsitsa kudzitukumula kwa anthu ankhanza.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndidzasandutsa anthu kukhala ovuta kupeza kuposa mmene amasowera golide wabwino.","poem":1},{"text":"Iwo sazidzapezekapezeka kuposa mmene amasowera golide wa ku Ofiri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tsono ndidzagwedeza miyamba","poem":1},{"text":"ndipo dziko lapansi lidzachoka pa maziko ake.","poem":2},{"text":"Izi zidzachitika chifukwa cha ukali wa Wamphamvuzonse","poem":1},{"text":"pa tsiku la mkwiyo wake woopsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ngati mbawala zosakidwa,","poem":1},{"text":"ngati nkhosa zopanda wozikusa,","poem":2},{"text":"munthu aliyense adzabwerera kwa anthu akwawo,","poem":1},{"text":"aliyense adzathawira ku dziko lake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Aliyense amene atadzapezeke ndi kugwidwa","poem":1},{"text":"adzaphedwa momubaya ndi lupanga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ana awo akhanda adzaphwanyidwa iwo akuona;","poem":1},{"text":"nyumba zawo zidzafunkhidwa ndipo akazi awo adzagwiriridwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Taona, Ine ndidzadzutsa Amedi amene safuna siliva","poem":1},{"text":"ndipo sasangalatsidwa ndi golide,","poem":2},{"lineBreak":true},{"text":"kuti amenyane ndi Ababuloni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Adzapha anyamata ndi mauta awo;","poem":1},{"text":"sadzachitira chifundo ana","poem":2},{"lineBreak":true},{"text":"ngakhale kumvera chisoni ana akhanda.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Babuloni, ufumu wake ndi waulemerero kuposa mafumu onse.","poem":1},{"text":"Anthu ake amawunyadira.","poem":2},{"text":"Koma Yehova adzawuwononga","poem":1},{"text":"ngati mmene anawonongera Sodomu ndi Gomora.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Anthu sadzakhalamonso","poem":1},{"text":"kapena kukhazikikamo pa mibado yonse;","poem":2},{"text":"palibe Mwarabu amene adzayimike tenti yake,","poem":1},{"text":"palibe mʼbusa amene adzawetamo ziweto zake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Koma nyama zakuthengo ndizo zidzakhale kumeneko,","poem":1},{"text":"nyumba zake zidzadzaza ndi nkhandwe;","poem":2},{"text":"mu mzindamo muzidzakhala akadzidzi,","poem":1},{"text":"ndipo atonde akuthengo azidzalumphalumphamo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mu nsanja zake muzidzalira afisi,","poem":1},{"text":"mʼnyumba zake zokongola muzidzalira nkhandwe.","poem":2},{"text":"Nthawi yake yayandikira","poem":1},{"text":"ndipo masiku ake ali pafupi kutha.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}