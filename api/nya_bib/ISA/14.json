{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Yehova adzachitira chifundo Yakobo;","poem":1},{"text":"adzasankhanso Israeli","poem":2},{"lineBreak":true},{"text":"ndi kuwalola kuti akhalenso mʼdziko lawo.","poem":2},{"text":"Alendo adzabwera kudzakhala nawo","poem":1},{"text":"ndi kudziphatika okha kukhala ngati a mʼnyumba ya Yakobo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anthu a mitundu ina adzaperekeza a Israeli","poem":1},{"text":"ku dziko lawo.","poem":2},{"text":"Tsono Aisraeli adzasandutsa anthu a mitundu ina aja","poem":1},{"text":"kukhala antchito awo aamuna ndi aakazi mʼdziko la Yehova.","poem":2},{"text":"Ndiye kuti Aisraeli adzasandutsa akapolo anthu amene kale anali ambuye awo.","poem":1},{"text":"Iwo adzasandutsa akapolo anthu amene kale ankawalamulira ndi kuwazunza.","poem":2}]},{"type":"verse","number":3,"content":["Yehova akadzakupumitsani ku zowawa ndi mavuto, ndiponso kuntchito yakalavulagaga imene ankakugwiritsani,"]},{"type":"verse","number":4,"content":["mudzayankhula monyogodola mfumu ya Babuloni kuti,",{"text":"Wopsinja uja watha!","poem":1},{"text":"Ukali wake uja watha!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yehova wathyola chikwapu cha anthu oyipa,","poem":1},{"text":"Iye waphwanya ndodo ya olamulira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mfumu ya ku Babuloni inkakantha mitundu ya anthu mwaukali","poem":1},{"text":"powamenya kosalekeza,","poem":2},{"text":"Iyo inkagonjetsa anthu a mitundu ina mwaukali","poem":1},{"text":"ndikuwazunza kosalekeza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Koma tsopano mayiko onse ali pa mpumulo ndi pa mtendere;","poem":1},{"text":"ndipo akuyimba mokondwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngakhale mitengo ya payini ndi mikungudza ya ku Lebanoni","poem":1},{"text":"ikuyimba za iwe mokondwa ndipo ikuti,","poem":2},{"text":"“Chigwetsedwere chako pansi,","poem":1},{"text":"palibe wina anabwera kudzatigwetsa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ku manda kwatekeseka","poem":1},{"text":"kuti akulandire ukamabwera;","poem":2},{"text":"mizimu ya anthu akufa, aja amene anali atsogoleri","poem":1},{"text":"a dziko lapansi, yadzutsidwa.","poem":2},{"text":"Onse amene anali mafumu a mitundu ya anthu","poem":1},{"text":"ayimiritsidwa pa mipando yawo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Onse adzayankha;","poem":1},{"text":"adzanena kwa iwe kuti,","poem":2},{"text":"“Iwenso watheratu mphamvu ngati ife;","poem":1},{"text":"Iwe wafanana ndi ife.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ulemerero wako wonse walowa mʼmanda,","poem":1},{"text":"pamodzi ndi nyimbo za azeze ako;","poem":2},{"text":"mphutsi zayalana pogona pako","poem":1},{"text":"ndipo chofunda chako ndi nyongolotsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wagwa pansi bwanji kuchoka kumwamba,","poem":1},{"text":"iwe nthanda, mwana wa mʼbandakucha!","poem":2},{"text":"Wagwetsedwa pansi pa dziko lapansi,","poem":1},{"text":"Iwe amene unagonjetsapo mitundu ya anthu!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mu mtima mwako unkanena kuti,","poem":1},{"text":"“Ndidzakwera mpaka kumwamba;","poem":2},{"text":"ndidzakhazika mpando wanga waufumu","poem":1},{"text":"pamwamba pa nyenyezi za Mulungu;","poem":2},{"text":"ndidzakhala pa mpando waufumu pa phiri losonkhanirako,","poem":1},{"text":"pamwamba penipeni pa phiri la kumpoto.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndidzakwera pamwamba pa mitambo;","poem":1},{"text":"ndidzafanana ndi Wammwambamwamba.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Koma watsitsidwa mʼmanda","poem":1},{"text":"pansi penipeni pa dzenje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Anthu akufa adzakupenyetsetsa","poem":1},{"text":"nadzamalingalira za iwe nʼkumati,","poem":2},{"text":"“Kodi uyu ndi munthu uja anagwedeza dziko lapansi","poem":1},{"text":"ndi kunjenjemeretsa maufumu,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"munthu amene anasandutsa dziko lonse chipululu,","poem":1},{"text":"amene anagwetsa mizinda yake","poem":2},{"lineBreak":true},{"text":"ndipo sankalola kuti anthu ogwidwa abwerere kwawo?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mafumu onse a mitundu ya anthu akugona mwaulemu","poem":1},{"text":"aliyense mʼmanda akeake.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Koma iwe watayidwa kunja kwa manda ako,","poem":1},{"text":"ngati nthambi yowola ndi yonyansa.","poem":2},{"text":"Mtembo wako waphimbidwa ndi anthu ophedwa;","poem":1},{"text":"amene anabayidwa ndi lupanga,","poem":2},{"lineBreak":true},{"text":"anatsikira mʼdzenje lamiyala","poem":2},{"text":"ngati mtembo woponderezedwa.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Sudzayikidwa nawo mʼmanda mwaulemu,","poem":2},{"text":"chifukwa unawononga dziko lako","poem":1},{"text":"ndi kupha anthu ako.","poem":2},{"lineBreak":true},{"text":"Zidzukulu za anthu oyipa","poem":1},{"text":"sizidzakumbukika nʼpangʼono pomwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Konzani malo woti muphere ana ake aamuna","poem":1},{"text":"chifukwa cha machimo a makolo awo;","poem":2},{"text":"kuti angadzuke ndi kulanda dziko lapansi","poem":1},{"text":"ndi kulidzaza dziko lonselo ndi mizinda yawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yehova Wamphamvuzonse akuti,","poem":1},{"text":"“Ine ndidzathira nkhondo mzinda wa Babuloni.","poem":2},{"text":"Ndidzachotseratu mu Babuloni dzina lake ndi onse otsaliramo.","poem":1},{"text":"Ndiye kuti sipadzakhala ana kapena zidzukulu,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":23,"content":[{"text":"“Ndidzawusandutsa mzindawo malo okhalamo anungu","poem":1},{"text":"ndiponso dambo lamatope;","poem":2},{"text":"ndidzawusesa ndi tsache lowononga,”","poem":1},{"text":"akutero Yehova Wamphamvuzonse.","poem":2}]},{"type":"heading","content":["Za Kulangidwa kwa Asiriya"]},{"type":"verse","number":24,"content":["Yehova Wamphamvuzonse walumbira kuti,",{"text":"“Ndithudi, monga ndaganizira ndidzachitadi choncho,","poem":1},{"text":"ndipo monga momwe ndatsimikizira zidzakhala momwemo ndithu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndidzawawononga Asiriya mʼdziko langa;","poem":1},{"text":"ndidzawapondereza ndi mapazi pa mapiri anga;","poem":2},{"text":"ndidzachotsa goli lawo pa anthu anga,","poem":1},{"text":"ndipo ndidzachotsa katundu wawo pa mapewa awo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Izi ndizo ndakonza kuti zichitike pa dziko lonse lapansi,","poem":1},{"text":"ndatambasula dzanja pa anthu a mitundu yonse.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Pakuti Yehova Wamphamvuzonse watsimikiza, ndipo ndani angamuletse?","poem":1},{"text":"Dzanja lake latambasulidwa ndipo ndani angalibweze?","poem":2}]},{"type":"heading","content":["Za Kulangidwa kwa Afilisti"]},{"type":"verse","number":28,"content":["Uthenga uwu unabwera chaka chimene mfumu Ahazi anamwalira:"]},{"type":"verse","number":29,"content":[{"text":"Musakondwere inu Afilisti nonse","poem":1},{"text":"kuti Asiriya amene anali ngati ndodo yokukanthani anathedwa;","poem":2},{"text":"chifukwa kuchokera ku njoka yomweyi (mfumu ya Aasiriya) mudzatuluka mphiri,","poem":1},{"text":"ndipo chipatso chake chidzakhala njoka yaliwiro ndiponso yaululu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Osaukitsitsa adzapeza chakudya","poem":1},{"text":"ndipo amphawi adzakhala mwamtendere.","poem":2},{"text":"Koma anthu ako ndidzawawononga ndi njala,","poem":1},{"text":"ndipo njalayo idzapha ngakhale opulumuka ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Lirani kwambiri, anthu a pa chipata! Fuwulani kwambiri, anthu a mu mzinda!","poem":1},{"text":"Njenjemerani ndi mantha, inu Afilisti nonse!","poem":2},{"text":"Mtambo wa utsi ukuchokera kumpoto,","poem":1},{"text":"ndipo palibe wamantha pakati pa ankhondo ake.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kodi tidzawayankha chiyani","poem":1},{"text":"amithenga a ku Filisitiya?","poem":2},{"text":"“Yehova wakhazikitsa Ziyoni,","poem":1},{"text":"ndipo mu mzinda wakewu, anthu ozunzika apeza populumukira.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}