{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Za Kulangidwa kwa Mowabu"]},{"type":"verse","number":1,"content":["Uthenga wonena za Mowabu:",{"text":"Popeza kuti mu usiku umodzi wokha mzinda wa Ari wa ku Mowabu wawonongedwa,","poem":1},{"text":"wawonongedwa pa usiku umodzi wokha.","poem":2},{"text":"Mzinda wa Kiri wawonongedwa,","poem":1},{"text":"wawonongedwa pa usiku umodzi wokha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anthu a ku Diboni akupita ku nyumba ya milungu yawo,","poem":1},{"text":"akupita ku malo awo achipembedzo kukalira;","poem":2},{"lineBreak":true},{"text":"anthu a ku Mowabu akulirira mofuwula mzinda wa Nebo ndi wa Medeba.","poem":2},{"text":"Mutu uliwonse wametedwa mpala,","poem":1},{"text":"ndipo ndevu zonse zametedwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mʼmisewu akuvala ziguduli;","poem":1},{"text":"pa madenga ndi mʼmabwalo","poem":2},{"text":"aliyense akulira mofuwula,","poem":1},{"text":"misozi ili pupupu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anthu a ku Hesiboni ndi Eleali akulira mofuwula,","poem":1},{"text":"mawu awo akumveka mpaka ku Yahazi.","poem":2},{"text":"Kotero asilikali a ku Mowabu akulira mofuwula,","poem":1},{"text":"ndipo ataya mtima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Inenso ndikulirira Mowabu;","poem":1},{"text":"chifukwa othawa nkhondo ake akupita akulira ku chikweza cha Luluti mpaka ku Zowari","poem":2},{"lineBreak":true},{"text":"ndi Egilati-Selisiya","poem":2},{"text":"akupita akulira ku chikweza cha Luhiti,","poem":1},{"text":"Akulira mosweka mtima","poem":2},{"text":"pa njira yopita ku Horonaimu;","poem":1},{"text":"akulira mosweka mtima chifukwa cha chiwonongeko chawo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Madzi a ku Nimurimu aphwa","poem":1},{"text":"ndipo udzu wauma;","poem":2},{"text":"zomera zawonongeka","poem":1},{"text":"ndipo palibe chomera chobiriwira chatsala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kotero kuti chuma chomwe anachipeza ndi kuchisunga,","poem":1},{"text":"achitenga kuti awoloke nacho chigwembe cha Misondozi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kulira kwawo kukumveka mʼdziko lonse la Mowabu;","poem":1},{"text":"kulira kwawo kosweka mtima kukumveka","poem":2},{"lineBreak":true},{"text":"mpaka ku Egilaimu ndi Beeri-Elimu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Madzi a ku Dimoni afiira ndi magazi,","poem":1},{"text":"komabe ndidzabweretsa zina zambiri pa Dimoni,","poem":2},{"text":"mkango woti udzagwire aliyense othawa mu Mowabu","poem":1},{"text":"ndi aliyense wotsala mʼdzikomo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}