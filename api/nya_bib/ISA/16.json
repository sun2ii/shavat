{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Anthu a ku Mowabu","poem":1},{"text":"atumiza mphatso za ana ankhosa onenepa,","poem":2},{"text":"kuchokera ku Sela kudutsa chipululu","poem":1},{"text":"mpaka kukafika ku phiri la Ziyoni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Monga momwe mbalame zimawulukira uku ndi uku","poem":1},{"text":"akazimwaza mʼchisa,","poem":2},{"text":"momwemonso akazi a ku Mowabu","poem":1},{"text":"akuyendayenda ku madooko a Arinoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amowabu aja anawuza a ku Yuda kuti,","poem":1},{"text":"“Tiwuzeni chochita, gamulani zoti tichite.","poem":2},{"text":"Inu mutiteteze kwa adani anthu.","poem":1},{"text":"Mukhale ngati mthunzi wathu dzuwa lili pa liwombo.","poem":2},{"text":"Mutibise,","poem":1},{"text":"musatipereke ife othawa nkhondo kwa adani athu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lolani kuti anthu othawa nkhondo a ku Mowabu azikhala pakati panu;","poem":1},{"text":"mukhale populumukira pawo kwa wowonongayo.”","poem":2},{"lineBreak":true},{"text":"Nthawi idzafika ndipo wozunzayo sadzakhalaponso,","poem":1},{"text":"kuwononga kudzaleka;","poem":2},{"lineBreak":true},{"text":"waukaliyo adzachoka mʼdzikomo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mpando waufumu udzakhazikitsidwa mwachikondi;","poem":1},{"text":"mmodzi mwa zidzukulu za Davide adzakhalapo mokhulupirika.","poem":2},{"text":"Iyeyo poweruza adzatsata chilungamo","poem":1},{"text":"ndipo adzalimbikitsa kuchita zachilungamo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tinamva kuti Mowabu anadzikuza kwambiri.","poem":1},{"text":"Kunyada kwawo","poem":2},{"text":"ndi kunyogodola kwawo ndi kudzitama kwawo,","poem":1},{"text":"zonse ndi zopanda phindu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nʼchifukwa chake Amowabu akulira kwambiri;","poem":1},{"text":"iwo akulirira dziko lawo.","poem":2},{"text":"Akubuma momvetsa chisoni","poem":1},{"text":"chifukwa cha makeke a mphesa a ku Kiri Hareseti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Minda ya ku Hesiboni yauma,","poem":1},{"text":"minda ya mpesa ya ku Sibina yaguga.","poem":2},{"text":"Atsogoleri a mitundu ina anapondaponda","poem":1},{"text":"minda ya mpesa wabwino,","poem":2},{"text":"imene nthambi zake zinakafika ku Yazeri,","poem":1},{"text":"mpaka kutambalalira ku chipululu.","poem":2},{"text":"Mizu yake inakafika","poem":1},{"text":"mpaka ku tsidya la nyanja.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kotero Ine ndikulira, monga mmene akulirira anthu a ku Yazeri,","poem":1},{"text":"chifukwa cha minda ya mpesa ya ku Sibima.","poem":2},{"text":"Inu anthu a ku Hesiboni, inu anthu a ku Eleali,","poem":1},{"text":"ndikukunyowetsani ndi misozi!","poem":2},{"text":"Mwalephera kupeza zokolola,","poem":1},{"text":"chifukwa cha nkhondo imene inawononga zokolola zonse.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Chimwemwe ndi chisangalalo zalekeka ku minda yanu ya zipatso;","poem":1},{"text":"palibe amene akuyimba kapena kufuwula mʼminda ya mpesa;","poem":2},{"text":"palibe amene akupsinya vinyo ku malo opsinyira mphesa,","poem":1},{"text":"pakuti ndathetsa kufuwula.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Chifukwa chake moyo wanga ukulira ngati pangwe kulirira Mowabu,","poem":1},{"text":"mtima wanga ukubuwula chifukwa cha Kiri Hareseti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngakhale anthu a ku Mowabu","poem":1},{"text":"apite ku malo awo achipembedzo","poem":2},{"text":"koma amangodzitopetsa ndi kutaya nthawi chabe","poem":1},{"text":"chifukwa sizidzatheka.","poem":2}]},{"type":"verse","number":13,"content":["Awa ndi mawu amene Yehova wayankhula kale zokhudza Mowabu."]},{"type":"verse","number":14,"content":["Koma tsopano Yehova akuti, “Zisanathe zaka zitatu, potsata mʼmene munthu waganyu amawerengera, ulemerero wa Mowabu udzakhala utatheratu ndipo anthu ake ambiri adzakhala atawonongeka, ndipo opulumuka ake adzakhala ochepa ndi ofowoka.”"]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}