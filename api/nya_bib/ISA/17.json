{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":17,"content":[{"type":"heading","content":["Uthenga Wotsutsa Damasiko"]},{"type":"verse","number":1,"content":["Uthenga wonena za Damasiko:",{"text":"“Taonani, mzinda wa Damasiko sudzakhalanso mzinda,","poem":1},{"text":"koma udzasanduka bwinja.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mizinda ya Aroeri idzakhala yopanda anthu","poem":1},{"text":"ndipo idzakhala ya ziweto, zimene zidzagona pansi","poem":2},{"lineBreak":true},{"text":"popanda wina woziopseza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ku Efereimu sikudzakhalanso linga,","poem":1},{"text":"ndipo ku Damasiko sikudzakhalanso ufumu;","poem":2},{"text":"Otsalira a ku Siriya adzachotsedwa ulemu","poem":1},{"text":"monga anthu a ku Israeli,”","poem":2},{"text":"akutero Yehova Wamphamvuzonse.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Tsiku limenelo ulemerero wa Yakobo udzazimirira;","poem":1},{"text":"ndipo chuma chake chidzasanduka umphawi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Israeli adzakhala ngati munda wa tirigu","poem":1},{"text":"umene anatsiriza kukolola.","poem":2},{"text":"Adzakhalanso ngati munda wa mʼchigwa cha Refaimu","poem":1},{"text":"anthu atatha kukunkha ngala za tirigu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Komabe Aisraeli ochepa okha ndiwo ati adzatsale","poem":1},{"text":"monga mʼmene zimatsalira zipatso ziwiri kapena zitatu pa nthambi ya pamwamba penipeni","poem":2},{"text":"kapena zipatso zisanu pa nthambi za mʼmunsi","poem":1},{"text":"mwa mtengo wa olivi akawugwedeza,”","poem":2},{"text":"akutero Yehova, Mulungu wa Israeli.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tsiku limenelo anthu adzayangʼana Mlengi wawo","poem":1},{"text":"ndipo adzatembenukira kwa Woyerayo wa Israeli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iwo sadzakhulupiriranso maguwa ansembe,","poem":1},{"text":"ntchito ya manja awo,","poem":2},{"text":"ndipo sadzadaliranso mitengo ya mafano a Asera,","poem":1},{"text":"ndiponso maguwa ofukizirapo lubani amene manja awo anapanga.","poem":2}]},{"type":"verse","number":9,"content":["Tsiku limenelo mizinda yawo yamphamvu, imene anasiya chifukwa cha Aisraeli, idzakhala ngati malo osiyidwa kuti awirire ndi kumera ziyangoyango. Ndipo yonse idzakhala mabwinja."]},{"type":"verse","number":10,"content":[{"text":"Inu mwayiwalatu Mulungu Mpulumutsi wanu;","poem":1},{"text":"simunakumbukire Thanthwe, linga lanu.","poem":2},{"text":"Choncho, ngakhale munadzala mbewu zabwino,","poem":1},{"text":"ndi kuyitanitsa kunja mitengo ya mpesa,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"nimuyembekeza kuti zikule tsiku lomwelo","poem":1},{"text":"ndi kuphukira maluwa mmawa mwake,","poem":2},{"text":"komabe zimenezi sizidzakupindulirani","poem":1},{"text":"pa tsiku la mavuto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Aa, mkokomo wa anthu a mitundu yambiri,","poem":1},{"text":"akusokosa ngati kukokoma kwa nyanja!","poem":2},{"text":"Aa, phokoso la anthu a mitundu ina,","poem":1},{"text":"akusokosa ngati mkokomo wa madzi amphamvu!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngakhale ankhondo a mitundu ina akubwera ndi mkokomo ngati wa madzi ambiri,","poem":1},{"text":"koma adzathawira kutali Mulungu akadzawadzudzula.","poem":2},{"text":"Yehova adzawapirikitsa ngati mankhusu owuluka ndi mphepo pa phiri,","poem":1},{"text":"ndi ngati fumbi la kamvuluvulu asanayambe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pofika nthawi yamadzulo zoopsa zidzayamba kuchitika,","poem":1},{"text":"ndipo zidzakhala zitatha pofika mmawa.","poem":2},{"text":"Izi ndizo zidzachitikire anthu otilanda zinthu,","poem":1},{"text":"gawo la amene amatibera zinthu zathu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}