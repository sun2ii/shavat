{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Phiri la Yehova"]},{"type":"verse","number":1,"content":["Nazi zinthu zokhudza Yuda ndi Yerusalemu, zimene Yesaya mwana wa Amozi anaziona mʼmasomphenya:"]},{"type":"verse","number":2,"content":["Mʼmasiku otsiriza,",{"text":"phiri la Nyumba ya Yehova adzalikhazikitsa","poem":1},{"text":"kukhala lalitali kuposa mapiri ena onse,","poem":2},{"text":"lidzaonekera pamwamba pa mapiri ena onse,","poem":1},{"text":"ndipo mayiko onse adzathamangira kumeneko.","poem":2}]},{"type":"verse","number":3,"content":["Anthu ambiri adzabwera ndikunena kuti,",{"text":"“Tiyeni tikwere ku phiri la Yehova,","poem":1},{"text":"ku nyumba ya Mulungu wa Yakobo.","poem":2},{"text":"Iye adzatiphunzitsa njira zake,","poem":1},{"text":"ndipo tidzayenda mʼnjira zakezo.”","poem":2},{"text":"Malangizo adzachokera ku Ziyoni,","poem":1},{"text":"mawu a Yehova adzachokera ku Yerusalemu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iye adzaweruza pakati pa mayiko,","poem":1},{"text":"ndipo adzathetsa kusamvana pakati pa anthu ambiri.","poem":2},{"text":"Anthuwo adzasandutsa malupanga awo kukhala makasu","poem":1},{"text":"ndiponso mikondo yawo kukhala zomwetera.","poem":2},{"text":"Mtundu wina sudzatenganso lupanga kumenyana ndi mtundu wina,","poem":1},{"text":"kapena kuphunziranso za nkhondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Inu nyumba ya Yakobo, bwerani,","poem":1},{"text":"tiyeni tiyende mʼkuwala kwa Yehova.","poem":2}]},{"type":"heading","content":["Tsiku la Yehova"]},{"type":"verse","number":6,"content":[{"text":"Inu Yehova mwawakana anthu anu,","poem":1},{"text":"nyumba ya Yakobo.","poem":2},{"text":"Iwo adzaza ndi zamatsenga zochokera Kummawa;","poem":1},{"text":"amawombeza mawula ngati Afilisti,","poem":2},{"lineBreak":true},{"text":"ndipo amayanjana ndi anthu osapembedza Mulungu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dziko lawo ndi lodzaza ndi siliva ndi golide;","poem":1},{"text":"ndipo chuma chawo ndi chosatha.","poem":2},{"text":"Dziko lawo ndi lodzaza ndi akavalo;","poem":1},{"text":"ndipo magaleta awo ankhondo ngosawerengeka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dziko lawo ndi lodzaza ndi mafano;","poem":1},{"text":"iwo amapembedza ntchito ya manja awo,","poem":2},{"lineBreak":true},{"text":"amagwadira zomwe anapanga ndi zala zawo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tsono munthu aliyense adzachepetsedwa","poem":1},{"text":"ndi kutsitsidwa.","poem":2},{"lineBreak":true},{"text":"Inu Yehova musawakhululukire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lowani mʼmatanthwe,","poem":1},{"text":"bisalani mʼmaenje,","poem":2},{"text":"kuthawa kuopsa kwa Yehova","poem":1},{"text":"ndi ulemerero wa ufumu wake!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kudzikuza kwa anthu kudzatha,","poem":1},{"text":"ndipo kudzitama kwa anthu kudzawonongedwa;","poem":2},{"text":"Yehova yekha ndiye adzapatsidwe ulemu pa tsiku limenelo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yehova Wamphamvuzonse wakonzeratu tsiku","poem":1},{"text":"limene adzatsitse onse onyada ndi odzitama,","poem":2},{"lineBreak":true},{"text":"ndipo adzagonjetsa","poem":2},{"lineBreak":true},{"text":"onse amphamvu,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"tsiku la mikungudza yonse ya ku Lebanoni, yayitali ndi yoonekera patali,","poem":1},{"text":"ndiponso la mitengo yonse ya thundu ya ku Basani,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"tsiku la mapiri onse ataliatali","poem":1},{"text":"ndiponso la zitunda zonse zazitali,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"tsiku la nsanja zonse zazitali","poem":1},{"text":"ndiponso malinga onse olimba,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"tsiku la sitima zapamadzi zonse za ku Tarisisi","poem":1},{"text":"ndiponso la mabwato onse okongola.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kudzikuza kwa munthu kudzatha","poem":1},{"text":"ndipo kudzitama kwa anthu kudzawonongedwa,","poem":2},{"text":"Yehova yekha ndiye adzapatsidwe ulemu tsiku limenelo,","poem":1}]},{"type":"verse","number":18,"content":[{"text":"ndipo mafano onse adzatheratu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Anthu adzathawira mʼmapanga a matanthwe","poem":1},{"text":"ndi mʼmaenje a nthaka,","poem":2},{"text":"kuthawa mkwiyo wa Yehova,","poem":1},{"text":"ndiponso ulemerero wa ufumu wake,","poem":2},{"lineBreak":true},{"text":"pamene Iye adzuka kugwedeza dziko lapansi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tsiku limenelo anthu adzatayira","poem":1},{"text":"mfuko ndi mileme","poem":2},{"text":"mafano awo asiliva ndi mafano awo agolide,","poem":1},{"text":"amene anawapanga kuti aziwapembedza.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Adzathawira mʼmapanga a matanthwe","poem":1},{"text":"ndiponso mʼmingʼalu ya nthaka","poem":2},{"text":"kuthawa mkwiyo wa Yehova","poem":1},{"text":"ndiponso ulemerero wa ufumu wake,","poem":2},{"lineBreak":true},{"text":"pamene Iye adzuka kugwedeza dziko lapansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Lekani kudalira munthu,","poem":1},{"text":"amene moyo wake sukhalira kutha.","poem":2},{"text":"Iye angathandize bwanji wina aliyense?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}