{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Za Chilango cha Babuloni"]},{"type":"verse","number":1,"content":["Uthenga wonena za chipululu cha mʼmbali mwa Nyanja.",{"text":"Ankhondo a ku Elamu ndi Mediya adzabwera ngati kamvuluvulu amene akuwomba modutsa mʼmbali ya nyanja,","poem":1},{"text":"kuchokera ku chipululu,","poem":2},{"lineBreak":true},{"text":"dziko lochititsa mantha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ine ndaona zinthu zoopsa mʼmasomphenya:","poem":1},{"text":"Wonyenga akunyenga, wofunkha akufunkha komanso owononga akuwononga.","poem":2},{"text":"Elamu, yambani nkhondo! Mediya, zingani mzinda!","poem":1},{"text":"Ine ndidzathetsa mavuto onse amene anayambitsa Ababuloni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Chifukwa cha zimenezi thupi langa likunjenjemera ndi mantha,","poem":1},{"text":"ndikumva ululu ngati wa mayi amene akubereka;","poem":2},{"text":"ndikuvutika kwambiri ndi zimene ndikumva,","poem":1},{"text":"ndathedwa nzeru ndi zimene ndikuziona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mtima wanga ukugunda,","poem":1},{"text":"ndipo ndikunjenjemera ndi mantha;","poem":2},{"text":"chisisira chimene ndakhala ndikuchifuna","poem":1},{"text":"chasanduka chinthu choopsa kwa ine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ankhondo a ku Elamu ndi Mediya akukonza matebulo,","poem":1},{"text":"akuyala mphasa,","poem":2},{"lineBreak":true},{"text":"akudya komanso kumwa!","poem":2},{"text":"Mwadzidzidzi anamva mawu akuti, “Dzukani inu ankhondo,","poem":1},{"text":"pakani mafuta zishango zanu!”","poem":2}]},{"type":"verse","number":6,"content":["Zimene Ambuye akunena kwa ine ndi izi;",{"text":"“Pita, kayike mlonda","poem":1},{"text":"kuti azinena zimene akuziona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taonani, anthu akubwera ali pa akavalo","poem":1},{"text":"ndipo akuyenda awiriawiri,","poem":2},{"text":"okwera pa bulu","poem":1},{"text":"kapena okwera pa ngamira,","poem":2},{"text":"mlondayo akhale tcheru kwambiri.”","poem":1}]},{"type":"verse","number":8,"content":["Ndipo mlondayo anafuwula kuti,",{"text":"“Ambuye anga, tsiku ndi tsiku ndimakhala pa nsanja yolondera;","poem":1},{"text":"Usiku uliwonse ndimakhala pa malo anga olondera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taonani, uyo munthu akubwera atakwera pa galeta","poem":1},{"text":"ali ndi gulu la akavalo.","poem":2},{"text":"Mmodzi wa iwo akuti,","poem":1},{"text":"‘Babuloni wagwa, wagwa!","poem":2},{"text":"Mafano onse a milungu yake","poem":1},{"text":"agwa pansi ndipo aphwanyika!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Inu anthu anga opunthidwa ndi kupetedwa ngati tirigu,","poem":1},{"text":"ine ndikukuwuzani zimene ndamva","poem":2},{"text":"ndikukuwuzani Uthenga wochokera kwa Yehova Wamphamvuzonse,","poem":1},{"text":"Mulungu wa Israeli.","poem":2}]},{"type":"heading","content":["Za Chilango cha Edomu"]},{"type":"verse","number":11,"content":["Uthenga wonena za Duma:",{"text":"Munthu wina akundiyitana kuchokera ku Seiri kuti,","poem":1},{"text":"“Iwe mlonda, usikuwu utha liti?","poem":2},{"lineBreak":true},{"text":"Iwe mlonda, utha liti kodi usikuwu?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mlonda akuyankha kuti,","poem":1},{"text":"“Kukucha, koma kudanso.","poem":2},{"text":"Ngati ukufuna kufunsa, funsa tsopano;","poem":1},{"text":"ndipo ubwerenso udzafunse.”","poem":2}]},{"type":"heading","content":["Za Chilango cha Arabiya"]},{"type":"verse","number":13,"content":["Uthenga wonena za Arabiya:",{"text":"Inu anthu amalonda a ku Dedani,","poem":1},{"text":"amene usiku mumagona mʼzithukuluzi za ku Arabiya,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"perekani madzi kwa anthu aludzu.","poem":2},{"text":"Inu anthu a ku Tema","poem":1},{"text":"perekani chakudya kwa anthu othawa nkhondo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iwo akuthawa malupanga,","poem":1},{"text":"lupanga losololedwa,","poem":2},{"text":"akuthawa uta wokokakoka","poem":1},{"text":"ndiponso nkhondo yoopsa.","poem":2}]},{"type":"verse","number":16,"content":["Zimene Ambuye akunena kwa ine ndi izi: “Chaka chimodzi chisanathe, potsata mmene amawerengera munthu waganyu, ulemerero wonse wa Kedara udzatheratu."]},{"type":"verse","number":17,"content":["Mwa anthu okoka uta, ankhondo a ku Kedara opulumuka adzakhala owerengeka.” Wayankhula ndi Yehova Mulungu wa Israeli."]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}