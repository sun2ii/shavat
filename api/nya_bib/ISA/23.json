{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Za Chilango cha Turo"]},{"type":"verse","number":1,"content":["Uthenga wonena za Turo:",{"text":"Lirani mofuwula, inu oyendetsa sitima za pa madzi za ku Tarisisi:","poem":1},{"text":"pakuti mzinda wa Turo wawonongedwa","poem":2},{"lineBreak":true},{"text":"ndipo mulibe nyumba kapena dooko.","poem":2},{"text":"Zimenezi anazimva","poem":1},{"text":"pochokera ku Kitimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Khalani chete inu anthu okhala mʼmbali mwa nyanja,","poem":1},{"text":"inu amalonda a ku Sidoni,","poem":2},{"lineBreak":true},{"text":"iwe amene unalemera ndi anthu oyenda pa nyanja.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pa nyanja zazikulu","poem":1},{"text":"panabwera tirigu wa ku Sihori;","poem":2},{"text":"zokolola za ku Nailo, ndipo munachita malonda","poem":1},{"text":"ndi anthu a mitundu ina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chita manyazi, iwe Sidimu","poem":1},{"text":"pakuti nyanja yayankhula, linga la ku nyanja (Turo) layankhula kuti,","poem":2},{"text":"“Sindinamvepo zowawa za kubereka kapena kuberekapo mwana;","poem":1},{"text":"sindinalerepo ana aamuna kapena kulera ana aakazi.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mawuwa akadzamveka ku Igupto,","poem":1},{"text":"iwo adzachita mantha akadzamva kuti Turo wawonongeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wolokerani ku Tarisisi,","poem":1},{"text":"lirani mofuwula, inu anthu okhala mʼmbali mwa nyanja.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodi uwu si mzinda wachisangalalo uja,","poem":1},{"text":"mzinda wakalekale,","poem":2},{"text":"umene anthu ake ankapita","poem":1},{"text":"kukakhala ku mayiko akutali?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kodi ndani anakonza zimenezi kuti zigwere Turo, mzinda umene unakhazikitsa mizinda ina,","poem":1},{"text":"mzinda umene amalonda ake ndi akalonga","poem":2},{"text":"ndi otchuka","poem":1},{"text":"pa dziko lapansi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yehova Wamphamvuzonse anakonza zimenezi","poem":1},{"text":"kuti athetse kunyada kwawo","poem":2},{"lineBreak":true},{"text":"ndi kutsitsa anthu otchuka a pa dziko lapansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mubalalike mʼdziko mwanu ngati mtsinje wa Nailo","poem":1},{"text":"inu anthu a ku Tarisisi,","poem":2},{"lineBreak":true},{"text":"pakuti mulibenso chokutetezani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yehova watambasula dzanja lake kuloza ku nyanja","poem":1},{"text":"ndipo wagwedeza maufumu ake.","poem":2},{"text":"Iye walamula kuti Kanaani","poem":1},{"text":"agwetse malinga ake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iye anati, “Simudzakondwanso konse,","poem":1},{"text":"inu anthu opanikizidwa a ku Sidoni, tsopano wamphwanyidwa!","poem":2},{"lineBreak":true},{"text":"“Ngakhale muwolokere ku Kitimu,","poem":1},{"text":"kumeneko simukapezako mpumulo.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onani dziko la Ababuloni,","poem":1},{"text":"anthu amenewa tsopano atheratu!","poem":2},{"text":"Asiriya asandutsa Turo kukhala","poem":1},{"text":"malo a zirombo za ku chipululu;","poem":2},{"text":"anamanga nsanja zawo za nkhondo,","poem":1},{"text":"anagumula malinga ake","poem":2},{"lineBreak":true},{"text":"ndipo anawasandutsa bwinja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lirani mofuwula, inu anthu oyendetsa sitima za pa madzi za ku Tarisisi;","poem":1},{"text":"chifukwa malinga ako agwetsedwa!","poem":2}]},{"type":"verse","number":15,"content":["Pa nthawi imeneyo Turo adzayiwalika pa zaka 70, amene ndi masiku a moyo wa mfumu. Koma potsiriza pa zaka 70 zimenezi, Turo adzakhala ngati mkazi wachiwerewere woyimbidwa mu nyimbo:"]},{"type":"verse","number":16,"content":[{"text":"“Tenga zeze wako uzungulire mzinda,","poem":1},{"text":"iwe mkazi wachiwerewere woyiwalika;","poem":2},{"text":"imba zeze mokometsera, imba nyimbo zambiri,","poem":1},{"text":"kuti anthu akukumbukire.”","poem":2}]},{"type":"verse","number":17,"content":["Pakutha pa zaka 70, Yehova adzachitapo kanthu pa Turo. Iye adzabwerera ku ntchito yake yakale monga mkazi wachiwerewere ndipo adzachita zachiwerewere ndi maufumu onse a dziko lapansi."]},{"type":"verse","number":18,"content":["Koma phindu lake ndi malipiro ake adzazipereka kwa Yehova; sadzazikundika kapena kuzisunga. Phindu lake lidzapita kwa mtumiki wa Yehova kuti agule zakudya zambiri ndi zovala zokongola."]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}