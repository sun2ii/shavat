{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["Chilango cha Yehova pa Dziko Lapansi"]},{"type":"verse","number":1,"content":[{"text":"Taonani, Yehova adzawononga dziko lapansi","poem":1},{"text":"ndi kulisandutsa chipululu;","poem":2},{"text":"Iye adzasakaza maonekedwe ake","poem":1},{"text":"ndi kumwaza anthu ake onse.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aliyense zidzamuchitikira mofanana:","poem":1},{"text":"wansembe chimodzimodzi munthu wamba,","poem":2},{"lineBreak":true},{"text":"antchito aamuna mofanananso ndi ambuye awo aamuna,","poem":2},{"lineBreak":true},{"text":"antchito aakazi chimodzimodzi ambuye awo aakazi,","poem":2},{"lineBreak":true},{"text":"wogula chimodzimodzi wogulitsa,","poem":2},{"lineBreak":true},{"text":"wobwereka chimodzimodzi wobwereketsa,","poem":2},{"lineBreak":true},{"text":"okongola chimodzimodzi okongoza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dziko lapansi lidzawonongedwa kwathunthu","poem":1},{"text":"ndi kusakazikiratu.","poem":2},{"text":"Yehova wanena mawu awa.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dziko lapansi likulira ndipo likufota,","poem":1},{"text":"dziko lonse likuvutika ndipo likuwuma,","poem":2},{"lineBreak":true},{"text":"anthu omveka a dziko lapansi akuvutika.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anthu ayipitsa dziko lapansi;","poem":1},{"text":"posamvera malangizo ake;","poem":2},{"text":"pophwanya mawu ake","poem":1},{"text":"ndi pangano lake lamuyaya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nʼchifukwa chake matemberero akuwononga dziko lapansi;","poem":1},{"text":"anthu a mʼdzikomo akuzunzika chifukwa cha kulakwa kwawo,","poem":2},{"text":"iwo asakazika","poem":1},{"text":"ndipo atsala ochepa okha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vinyo watsopano watha ndipo mphesa zikufota;","poem":1},{"text":"onse okonda zosangalatsa ali ndi chisoni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kulira kokometsera kwa matambolini kwatha,","poem":1},{"text":"phokoso la anthu osangalala latha,","poem":2},{"lineBreak":true},{"text":"zeze wosangalatsa wati zii.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anthu sadzayimbanso akumwa vinyo;","poem":1},{"text":"akadzamwa zaukali zidzakhala zowawa mʼkamwa mwawo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mzinda wachisokonezo uja wawonongeka;","poem":1},{"text":"nyumba iliyonse yatsekedwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anthu akulira mʼmisewu kufuna vinyo;","poem":1},{"text":"chimwemwe chonse chatheratu,","poem":2},{"lineBreak":true},{"text":"palibenso chisangalalo pa dziko lapansi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mzinda wasanduka bwinja","poem":1},{"text":"zipata zake zagumuka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zimenezi ndizo zidzachitikire mitundu yonse ya dziko lapansi","poem":1},{"text":"ndiponso pakati pa mitundu ya anthu.","poem":2},{"text":"Zidzakhala ngati pamene mitengo ya olivi yayoyoledwa,","poem":1},{"text":"kapena ngati nthawi ya kunkha la mphesa atatsiriza kukolola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Koma otsala onse akufuwula ndi kuyimba mwachimwemwe;","poem":1},{"text":"anthu akumadzulo akutamanda ukulu wa Yehova.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nʼchifukwa chake inu akummawa, tamandani Yehova;","poem":1},{"text":"ndi inu okhala mʼmphepete mwa nyanja kwezani dzina la Yehova, Mulungu wa Israeli.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kuchokera kumalekezero a dziko lapansi tikumva kuyimba kotamanda","poem":1},{"text":"“Wolungamayo.”","poem":2},{"lineBreak":true},{"text":"Koma ine ndinati, “Ndatheratu, ndatheratu!","poem":1},{"text":"Tsoka kwa ine!","poem":2},{"text":"Anthu achinyengo akupitirizabe kuchita zachinyengo,","poem":1},{"text":"inde chinyengo chawo chikunkerankera mʼtsogolo.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inu anthu adziko lapansi, zoopsa, dzenje","poem":1},{"text":"ndi msampha zikukudikirani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Aliyense wothawa phokoso la zoopsa","poem":1},{"text":"adzagwa mʼdzenje;","poem":2},{"text":"ndipo aliyense wotuluka mʼdzenjemo","poem":1},{"text":"adzakodwa ndi msampha.","poem":2},{"lineBreak":true},{"text":"Zitseko zakumwamba zatsekulidwa,","poem":1},{"text":"ndipo maziko a dziko lapansi agwedezeka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dziko lapansi lathyokathyoka,","poem":1},{"text":"ndipo lagawika pakati,","poem":2},{"lineBreak":true},{"text":"dziko lapansi lagwedezeka kotheratu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dziko lapansi likudzandira ngati munthu woledzera","poem":1},{"text":"likugwedezeka ndi mphepo ngati chisimba;","poem":2},{"text":"lalemedwa ndi machimo ake.","poem":1},{"text":"Lidzagwa ndipo silidzadzukanso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tsiku limenelo Yehova adzalanga","poem":1},{"text":"amphamvu a kumwamba","poem":2},{"lineBreak":true},{"text":"ndiponso mafumu apansi pano.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mulungu adzawasonkhanitsa pamodzi","poem":1},{"text":"ngati amʼndende amene ali mʼdzenje.","poem":2},{"text":"Adzawatsekera mʼndende","poem":1},{"text":"ndipo adzalangidwa patapita nthawi yayitali.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mwezi udzanyazitsidwa, dzuwa lidzachita manyazi;","poem":1},{"text":"pakuti Yehova Wamphamvuzonse adzakhala mfumu ndipo adzalamulira;","poem":2},{"text":"pa Phiri la Ziyoni ndi ku Yerusalemu,","poem":1},{"text":"ndipo adzaonetsa ulemerero wake pamaso pa akuluakulu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}