{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["Nyimbo Yotamanda Yehova"]},{"type":"verse","number":1,"content":[{"text":"Yehova ndinu Mulungu wanga;","poem":1},{"text":"ine ndidzakukwezani ndi kutamanda dzina lanu,","poem":2},{"text":"pakuti mwachita zodabwitsa","poem":1},{"text":"zimene munakonzekeratu kalekale","poem":2},{"lineBreak":true},{"text":"mokhulupirika kwambiri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inu mwasandutsa mzinda uja kukhala mulu wamiyala.","poem":1},{"text":"Ndipo mzinda wamalinga wasanduka bwinja,","poem":2},{"text":"linga la anthu achilendo lero si mzindanso","poem":1},{"text":"ndipo sidzamangidwanso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nʼchifukwa chake anthu amphamvu adzakulemekezani;","poem":1},{"text":"mizinda ya mitundu ya anthu ankhanza idzakuopani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inu mwakhala ngati populumukira pa anthu osauka,","poem":1},{"text":"mwakhala ngati kobisalirako munthu wovutika pa nthawi ya masautso ake.","poem":2},{"text":"Mwakhala ngati pobisalirapo","poem":1},{"text":"pa nthawi ya mphepo yamkuntho ndi mthunzi pa nthawi ya dzuwa.","poem":2},{"text":"Pakuti anthu ankhanza","poem":1},{"text":"ali ngati mphepo yamkuntho yowomba pa khoma,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ndiponso ngati kutentha mʼdziko lowuma.","poem":2},{"text":"Inu mumaletsa phokoso la anthu achilendo.","poem":1},{"text":"Monga momwe mthunzi wa mtambo umachepetsa kutentha,","poem":2},{"lineBreak":true},{"text":"inu munaletsa nyimbo za anthu ankhanza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pa phiri ili Yehova Wamphamvuzonse adzakonzera","poem":1},{"text":"anthu a mitundu yonse madyerero a zakudya zokoma ndi vinyo wabwino.","poem":2},{"text":"Phwando la nyama yonona","poem":1},{"text":"ndi vinyo wabwino kwambiri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iye adzachotsa kulira","poem":1},{"text":"kumene kwaphimba anthu ngati nsalu.","poem":2},{"text":"Adzachotsa chinsalu chimene chakuta mitundu yonse ya anthu.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Yehova adzathetsa imfa mpaka muyaya,","poem":2},{"text":"Ambuye Yehova adzapukuta misozi mʼmaso","poem":1},{"text":"mwa munthu aliyense;","poem":2},{"text":"adzachotsa manyazi a anthu ake","poem":1},{"text":"pa dziko lonse lapansi,","poem":2},{"text":"Yehova wayankhula.","poem":4}]},{"type":"verse","number":9,"content":["Tsiku limenelo iwo adzati,",{"text":"“Ndithudi, uyu ndiye Mulungu wathu;","poem":1},{"text":"ife tinamudalira ndipo anatipulumutsa.","poem":2},{"text":"Uyu ndiye Yehova, ife tinamudalira;","poem":1},{"text":"tiyeni tikondwe ndi kusangalala chifukwa watipulumutsa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yehova adzateteza phiri limeneli ndi dzanja lake;","poem":1},{"text":"ndipo Amowabu adzawapondereza pomwe alilipo,","poem":2},{"lineBreak":true},{"text":"ngati mmene amapondera manyowa mʼdzenje.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amowabuwo adzatambasula manja awo mʼmenemo,","poem":1},{"text":"ngati mmene amachitira munthu wosambira.","poem":2},{"text":"Koma Mulungu adzathetsa kunyada kwawo","poem":1},{"text":"ngakhale luso la manja awo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iye adzagumula malinga awo ataliatali","poem":1},{"text":"ndipo adzawagwetsa","poem":2},{"text":"ndi kuwaponya pansi,","poem":1},{"text":"pa fumbi penipeni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}