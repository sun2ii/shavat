{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Nyimbo ya Matamando"]},{"type":"verse","number":1,"content":["Tsiku limenelo anthu a mʼdziko la Yuda adzayimba nyimbo iyi.",{"text":"Tili ndi mzinda wolimba.","poem":1},{"text":"Mulungu amawuteteza ndi zipupa","poem":2},{"lineBreak":true},{"text":"ndi malinga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsekulani zipata za mzinda","poem":1},{"text":"kuti mtundu wolungama","poem":2},{"lineBreak":true},{"text":"ndi wokhulupirika ulowemo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inu mudzamupatsa munthu","poem":1},{"text":"wa mtima wokhazikika","poem":2},{"lineBreak":true},{"text":"mtendere weniweni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mudalireni Yehova mpaka muyaya,","poem":1},{"text":"chifukwa Yehova Mulungu ndiye Thanthwe losatha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iye amatsitsa anthu amene amadziyika pamwamba,","poem":1},{"text":"iye amagwetsa pansi mzinda wodzitukumula,","poem":2},{"text":"amagumula makoma ake","poem":1},{"text":"ndi kuwagwetsa pansi pa fumbi penipeni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mapazi a anthu akuwupondereza,","poem":1},{"text":"mapazi a anthu oponderezedwa,","poem":2},{"lineBreak":true},{"text":"mapazi anthu osauka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Njira ya munthu wolungama ndi yosalaza,","poem":1},{"text":"Inu Wolungamayo, mumasalaza njira ya wolungama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inde Yehova, timayenda mʼnjira zanu zolungama,","poem":1},{"text":"ife timayembekezera Inu;","poem":2},{"text":"mitima yathu imakhumba kukumbukira","poem":1},{"text":"ndi kulemekeza dzina lanu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moyo wanga umalakalaka Inu usiku wonse;","poem":1},{"text":"nthawi yammawa ndimafunafuna Inu.","poem":2},{"text":"Pamene muweruza dziko lapansi","poem":1},{"text":"anthu amaphunzira kuchita chilungamo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngakhale mukomere mtima anthu oyipa,","poem":1},{"text":"saphunzira chilungamo.","poem":2},{"text":"Amachita zoyipa mʼdziko la chilungamo,","poem":1},{"text":"ndipo sazindikira ululu wa Yehova.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inu Yehova, mwatukula dzanja lanu kuti muwalange,","poem":1},{"text":"koma iwo sakuliona dzanjalo.","poem":2},{"text":"Aloleni anthu aone ndi kuchita manyazi poona mmene mukondera anthu anu;","poem":1},{"text":"ndipo moto umene mwasonkhera adani anu uwapsereze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yehova, mumatipatsa mtendere;","poem":1},{"text":"ndipo zonse zimene ife tinazichita munatichitira ndinu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inu Yehova Mulungu wathu, ngakhale takhala tikulamulidwa ndi ena mʼmalo mwanu,","poem":1},{"text":"koma ife timalemekeza dzina lanu lokha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iwo tsopano sadzadzukanso;","poem":1},{"text":"mizimu yawo sidzabwera kudzativutitsa","poem":2},{"text":"pakuti mwawalanga ndipo mwawawononga;","poem":1},{"text":"palibenso amene amawakumbukira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inu Yehova, mwaukulitsa mtundu wathu;","poem":1},{"text":"mwauchulukitsa ndithu","poem":2},{"text":"ndipo mwalandirapo ulemu;","poem":1},{"text":"mwaukuza mbali zonse za dziko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yehova, anthu anu anabwera kwa Inu pamene anali mʼmasautso;","poem":1},{"text":"pamene munawalanga,","poem":2},{"lineBreak":true},{"text":"iwo anapemphera kwa Inu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Monga mayi woyembekezera pamene nthawi yake yobereka yayandikira","poem":1},{"text":"amamva kupweteka ndipo amalira ndi ululu,","poem":2},{"lineBreak":true},{"text":"ifenso tinali chimodzimodzi pamaso panu, Inu Yehova.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ife chimodzimodzi tinamva ululu, ngati mayi pa nthawi yobala mwana,","poem":1},{"text":"koma sitinapindulepo kanthu,","poem":2},{"text":"kapena kupulumutsa dziko lapansi;","poem":1},{"text":"sitinabadwitse anthu atsopano pa dziko pano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Koma anthu anu amene anafa adzakhalanso ndi moyo;","poem":1},{"text":"matupi awo adzadzuka.","poem":2},{"text":"Iwo amene ali ku fumbi tsopano","poem":1},{"text":"adzadzuka ndi kuyimba mosangalala.","poem":2},{"text":"Monga mame amafewetsa pansi kutsitsimutsa zomera,","poem":1},{"text":"momwenso Yehova adzaukitsa anthu amene anafa kale.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Abale anga, pitani mukalowe mʼnyumba zanu","poem":1},{"text":"ndipo mukadzitsekere;","poem":2},{"text":"mukabisale kwa kanthawi kochepa","poem":1},{"text":"mpaka ukali wake utatha.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taonani, Yehova akubwera kuchokera kumene amakhala;","poem":1},{"text":"akubwera kudzalanga anthu a dziko lapansi chifukwa cha machimo awo.","poem":2},{"text":"Dziko lapansi lidzawulula magazi amene anakhetsedwa pa dzikolo;","poem":1},{"text":"dziko lapansi silidzabisanso mitembo ya anthu ophedwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}