{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["Za Munda Wamphesa wa Yehova"]},{"type":"verse","number":1,"content":["Tsiku limenelo,",{"text":"Yehova ndi lupanga lake","poem":1},{"text":"lakuthwa, lalikulu ndi lamphamvu,","poem":2},{"text":"adzalanga Leviyatani chinjoka chothawa chija,","poem":1},{"text":"Leviyatani chinjoka chodzikulunga;","poem":2},{"text":"adzapha chirombo choopsa cha mʼnyanja.","poem":1}]},{"type":"verse","number":2,"content":["Tsiku limenelo Yehova adzati,",{"text":"“Tidzayimba nyimbo ya munda wamphesa wobereka bwino:","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Ine, Yehova, ndimawuyangʼanira;","poem":2},{"lineBreak":true},{"text":"ndimawuthirira nthawi zonse.","poem":2},{"text":"Ndimawulondera usana ndi usiku","poem":1},{"text":"kuti wina angawononge.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ine sindinakwiye.","poem":2},{"text":"Ngati mkandankhuku ndi minga zikanaoneka ndikanalimbana nazo!","poem":1},{"text":"Ndikachita nazo nkhondo;","poem":2},{"lineBreak":true},{"text":"ndikanazitentha zonse ndi moto.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Koma ngati apo ayi, abweretu kwa Ine adani angawo kuti ndidzawateteze;","poem":1},{"text":"apangane nane za mtendere,","poem":2},{"lineBreak":true},{"text":"ndithu, apangane nane za mtendere.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Masiku akubwerawo Yakobo adzazika mizu,","poem":1},{"text":"Israeli adzaphukira ndi kuchita maluwa,","poem":2},{"lineBreak":true},{"text":"ndipo adzadzaza dziko lonse lapansi ndi zipatso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kodi Yehova anakantha Israeli","poem":1},{"text":"ngati momwe anakanthira anthu amene anazunza Israeli?","poem":2},{"text":"Kapena kodi Yehova anapha Israeli","poem":1},{"text":"ngati mmene anthu ena anaphera Israeli?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yehova mwawalanga powapirikitsa ndi kuwatumiza ku ukapolo,","poem":1},{"text":"mwawachotsa ndi mpweya wanu woopsa,","poem":2},{"lineBreak":true},{"text":"monga zimachitikira pa tsiku la mkuntho wochokera kummawa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yehova adzakhululuka kulakwa kwa Yakobo.","poem":1},{"text":"Iwo adzaonetsa kuti alapadi pamene adzaphwanya miyala yonse ya guwa lachikunja,","poem":2},{"text":"ngati mmene anthu amaphwanyira miyala yanjereza","poem":1},{"text":"mpaka kukhala ngati fumbi lokhalokha.","poem":2},{"text":"Sipadzapezekanso mafano a Asera","poem":1},{"text":"kapena maguwa ofukiza lubani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mzinda wamalinga uja wasanduka bwinja,","poem":1},{"text":"wasanduka malo osiyidwa, ndi kutayidwa ngati chipululu;","poem":2},{"text":"kumeneko amadyetselako ana angʼombe","poem":1},{"text":"kumeneko zimapumulako ziweto","poem":2},{"lineBreak":true},{"text":"ndi kumwetula nthambi za mitengo kotheratu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pamene nthambi za mitengoyo zauma, zimathyoka","poem":1},{"text":"ndipo amayi amabwera nazitola ndi kuzisandutsa nkhuni.","poem":2},{"text":"Pakuti awa ndi anthu opanda nzeru;","poem":1},{"text":"kotero Mulungu amene anawapanga sadzachitira chisoni,","poem":2},{"lineBreak":true},{"text":"ndipo Mlengi wawo sawakomera mtima.","poem":2}]},{"type":"verse","number":12,"content":["Tsiku limenelo Yehova adzasonkhanitsa pamodzi anthu ake mmodzimmodzi kumalo opunthira tirigu, kuchokera ku mtsinje wa Yufurate mpaka ku mtsinje wa ku Igupto."]},{"type":"verse","number":13,"content":["Ndipo tsiku limenelo lipenga lalikulu lidzalira. Amene akuzunzika ku Asiriya iwo amene ali ku ukapolo ku Igupto adzabwera ndi kudzalambira Yehova pa phiri lopatulika mu Yerusalemu."]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}