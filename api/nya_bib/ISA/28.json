{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["Tsoka kwa Efereimu"]},{"type":"verse","number":1,"content":[{"text":"Tsoka ufumu wonyada wa zidakwa za ku Efereimu.","poem":1},{"text":"Tsoka kwa ulemerero wake wokongola umene ukufota ngati duwa","poem":2},{"text":"limene lili pa mutu pa anthu","poem":1},{"text":"oledzera a mʼchigwa chachonde.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taonani, ambuye ali naye wina wamphamvu ndi nyonga.","poem":1},{"text":"Iye adzabwera ngati mkuntho wamatalala ndi namondwe wowononga,","poem":2},{"text":"ngati madzi amphamvu osefukira a mvula yamkuntho;","poem":1},{"text":"ndipo adzawagwetsa pansi mwankhanza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ulamuliro wa atsogoleri oledzera","poem":1},{"text":"a ku Efereimu adzawuthetsa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndipo ulemerero wokongola wa mzinda umene uli ngati duwa","poem":1},{"text":"lofota pamutu pa anthu oledzera a mʼchigwa chachonde uja,","poem":2},{"text":"udzakhala ngati nkhuyu yoyambirira kupsa","poem":1},{"text":"imene munthu akangoyiona amayithyola","poem":2},{"lineBreak":true},{"text":"nthawi yokolola isanakwane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tsiku limenelo Yehova Wamphamvuzonse","poem":1},{"text":"adzakhala ngati nkhata yaufumu,","poem":2},{"text":"chipewa chokongola","poem":1},{"text":"kwa anthu ake otsala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iye adzapereka mtima","poem":1},{"text":"wachilungamo kwa oweruza,","poem":2},{"text":"adzakhala chilimbikitso kwa","poem":1},{"text":"amene amabweza adani pa zipata za mzinda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nawonso awa ali dzandidzandi chifukwa cha vinyo","poem":1},{"text":"ndipo akusochera chifukwa cha mowa:","poem":2},{"text":"ansembe ndi aneneri akudzandira chifukwa cha mowa","poem":1},{"text":"ndipo akusokonezeka chifukwa cha vinyo;","poem":2},{"text":"akusochera chifukwa cha mowa,","poem":1},{"text":"akudzandira pamene akuona masomphenya,","poem":2},{"lineBreak":true},{"text":"kupunthwa pamene akupereka chigamulo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pa matebulo onse pali masanzi okhaokha","poem":1},{"text":"ndipo palibenso malo wopanda zonyansa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Iwo akuti, “Kodi munthu ameneyu akufuna aphunzitse ndani?","poem":1},{"text":"Uthengawu akufuna kufotokozera yani?","poem":2},{"text":"Ndi kwa ana amene aleka kuyamwa,","poem":1},{"text":"kwa makanda ongowachotsa kumene ku bere?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akuyesa kumatiphunzitsa pangʼonopangʼono","poem":1},{"text":"lemba ndi lemba, mzere ndi mzere,","poem":2},{"lineBreak":true},{"text":"phunziro ndi phunziro.","poem":2},{"lineBreak":true},{"text":"Zonsezi akungoti apa pangʼono apa pangʼono.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mulungu adzayankhula kwa anthu ake kudzera mwa anthu aziyankhulo zachilendo, ziyankhulo zosamveka bwino.","poem":1},{"text":"Mulungu adzayankhula kwa anthu awa, amene","poem":2}]},{"type":"verse","number":12,"content":[{"text":"anakuwuzani kuti,","poem":1},{"text":"“Malo opumulira ndi ano,","poem":2},{"text":"otopa apumule, malo owusira ndi ano.”","poem":1},{"text":"Koma inu simunamvere.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Choncho Yehova adzakuphunzitsani","poem":1},{"text":"pangʼonopangʼono lemba ndi lemba,","poem":2},{"lineBreak":true},{"text":"mzere ndi mzere, phunziro ndi phunziro.","poem":2},{"lineBreak":true},{"text":"Kotero mudzayenda ndi kugwa chambuyo,","poem":2},{"text":"adzapweteka ndi kukodwa mu msampha","poem":1},{"text":"ndipo adzakutengani ku ukapolo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nʼchifukwa chake imvani mawu a Yehova,","poem":1},{"text":"inu anthu achipongwe amene mumalamulira anthu awa mu Yerusalemu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inu mumayankhula monyada kuti, “Ife tinachita pangano ndi imfa,","poem":1},{"text":"ife tachita mgwirizano ndi manda.","poem":2},{"text":"Pamene mliri woopsa ukadzafika","poem":1},{"text":"sudzatikhudza ife,","poem":2},{"text":"chifukwa timadalira bodza ngati pothawirapo pathu","poem":1},{"text":"ndi chinyengo ngati malo anthu obisalapo.”","poem":2}]},{"type":"verse","number":16,"content":["Tsono zimene Ambuye Yehova akunena ndi izi:",{"text":"“Taonani, ndikuyika mwala wovomerezeka ndi amisiri","poem":1},{"text":"ngati maziko mu Ziyoni,","poem":2},{"text":"mwala wapangodya, wamtengowapatali wopanga maziko amphamvu;","poem":1},{"text":"munthu amene awukhulupirira sadzagwedezeka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ntchito zolungama zidzakhala ngati chingwe choyezera maziko ake,","poem":1},{"text":"ndipo chilungamo chidzakhala chowongolera mzere;","poem":2},{"text":"matalala adzawononga malo anu othawirapo, amene ndi mabodza,","poem":1},{"text":"ndipo madzi adzamiza malo anu obisalako.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pangano limene munachita ndi imfa lidzathetsedwa;","poem":1},{"text":"mgwirizano wanu ndi manda udzachotsedwa.","poem":2},{"text":"Pakuti mliri woopsa udzafika,","poem":1},{"text":"ndipo udzakugonjetsani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndipo ukadzangofika udzakutengani.","poem":1},{"text":"Udzafika mmawa uliwonse,","poem":2},{"lineBreak":true},{"text":"usiku ndi usana.”","poem":2},{"lineBreak":true},{"text":"Anthu akadzamvetsetsa uthenga umenewu","poem":1},{"text":"adzaopsedwa kwambiri.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mudzakhala ngati munthu wogona pa bedi lalifupi kwambiri kuti sangathe kutambalitsapo miyendo;","poem":1},{"text":"ndiponso mudzakhala ngati munthu amene wafunda bulangeti lochepa kwambiri kuti sangathe nʼkufunda komwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yehova adzamenya nkhondo monga anachitira ku phiri la Perazimu","poem":1},{"text":"adzakalipa monga anachitira ku chigwa cha Gibiyoni;","poem":2},{"text":"adzagwira ntchito yake yooneka ngati yachilendo,","poem":1},{"text":"ndipo zimene ati adzachite zidzakhala ngati zodabwitsa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tsopano lekani kunyoza,","poem":1},{"text":"mukapanda kutero maunyolo anu adzakuthinani kwambiri;","poem":2},{"text":"Ambuye, Yehova Wamphamvuzonse wandiwuza kuti,","poem":1},{"text":"“Ndagamula kuti ndidzawononga dziko lapansi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tcherani khutu ndipo mumve mawu anga;","poem":1},{"text":"mvetserani ndipo mumve zimene ndikunena.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kodi mlimi wofuna kudzala mbewu amangokhalira kutipula kokhakokha?","poem":1},{"text":"Kodi amangokhalira kugawula ndi kugalawuza kokhakokha?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Pamene iye wasalaza mundawo,","poem":1},{"text":"kodi samafesa mawere ndi chitowe?","poem":2},{"text":"Kodi suja samadzala tirigu","poem":1},{"text":"ndi barele mʼmizere yake,","poem":2},{"lineBreak":true},{"text":"nadzala mchewere mʼphepete mwa mundawo?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mulungu wake amamulangiza","poem":1},{"text":"ndi kumuphunzitsa njira yabwino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Mawere sapunthira chopunthira cha galeta lopanda mikombero,","poem":1},{"text":"kapena chitowe sapuntha popondetsapo mikombero ya galeta;","poem":2},{"text":"mawere amapuntha ndi ndodo","poem":1},{"text":"ndipo chitowe amapuntha ndi kamtengo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Tirigu ayenera kusinjidwa kuti apangire buledi,","poem":1},{"text":"komabe munthu samangokhalira kupuntha tiriguyo osalekeza, kuopa kuti angatekedzeke.","poem":2},{"text":"Ngakhale kuti amapuntha tiriguyo poyendetsapo mikombero ya galeta,","poem":1},{"text":"koma akavalo ake satekedza tiriguyo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Izinso zimachokera kwa Yehova Wamphamvuzonse,","poem":1},{"text":"wa uphungu wodabwitsa ndi wa nzeru zopambana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}