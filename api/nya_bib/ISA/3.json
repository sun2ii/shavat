{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Chiweruzo pa Yerusalemu ndi Yuda"]},{"type":"verse","number":1,"content":[{"text":"Taonani tsopano, Ambuye","poem":1},{"text":"Yehova Wamphamvuzonse,","poem":2},{"text":"ali pafupi kuchotsa mu Yerusalemu ndi mu Yuda","poem":1},{"text":"zinthu pamodzi ndi thandizo;","poem":2},{"text":"adzachotsa chakudya chonse ndi madzi onse,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"anthu amphamvu ndi asilikali ankhondo,","poem":2},{"text":"oweruza ndi aneneri,","poem":1},{"text":"anthu olosera ndi akuluakulu,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"atsogoleri a ankhondo makumi asanu ndi anthu olemekezeka,","poem":1},{"text":"aphungu ndi anthu amatsenga ndi akatswiri pa za kulosera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndidzawayikira anyamata kuti akhale mafumu awo;","poem":1},{"text":"ana akhanda ndiwo adzawalamulire.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anthu adzazunzana,","poem":1},{"text":"munthu ndi munthu mnzake, mnansi ndi mnansi wake.","poem":2},{"text":"Anthu wamba adzanyoza","poem":1},{"text":"akuluakulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Munthu adzagwira mʼbale wake","poem":1},{"text":"mʼnyumba ya abambo awo, ndipo adzati,","poem":2},{"text":"“Iwe uli nawo mwinjiro, ndiye ukhale mtsogoleri wathu;","poem":1},{"text":"lamulira malo opasuka ano!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Koma tsiku limenelo mʼbale wakeyo adzafuwula kuti,","poem":1},{"text":"“Ayi, mavuto oterewa ndilibe mankhwala ake.","poem":2},{"text":"Ndilibe chakudya kapena chovala mʼnyumba mwanga;","poem":1},{"text":"musasankhe ine kukhala mtsogoleri wa anthu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusalemu akudzandira,","poem":1},{"text":"Yuda akugwa;","poem":2},{"text":"zokamba zawo ndi ntchito zawo nʼzotsutsana ndi Yehova,","poem":1},{"text":"sakulabadira ulemerero wa Mulungu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maonekedwe a nkhope zawo amawatsutsa;","poem":1},{"text":"amaonetsera poyera tchimo lawo ngati Sodomu;","poem":2},{"lineBreak":true},{"text":"salibisa tchimo lawolo.","poem":2},{"text":"Tsoka kwa iwo","poem":1},{"text":"odziputira okha mavuto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nena kwa olungama kuti zonse zidzawayendera bwino,","poem":1},{"text":"pakuti adzakondwera ndi phindu la ntchito zawo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsoka kwa anthu oyipa! Mavuto ali pa iwo!","poem":1},{"lineBreak":true},{"text":"Adzalandira malipiro a zimene manja awo anachita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Achinyamata akupondereza anthu anga,","poem":1},{"text":"ndipo amene akuwalamulira ndi akazi.","poem":2},{"text":"Aa, anthu anga, atsogoleri anu akukusocheretsani;","poem":1},{"text":"akukuchotsani pa njira yanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yehova wakhala pamalo pake mʼbwalo la milandu;","poem":1},{"text":"wakonzeka kuti aweruze anthu ake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yehova akuwazenga milandu","poem":1},{"text":"akuluakulu ndi atsogoleri a anthu ake:","poem":2},{"text":"“Ndinu amene mwawononga munda wanga wa mpesa;","poem":1},{"text":"nyumba zanu zadzaza ndi zolanda kwa amphawi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nʼchifukwa chiyani inu mukupsinja anthu anga,","poem":1},{"text":"nʼkudyera masuku pamutu amphawi?”","poem":2},{"text":"Akutero Ambuye Yehova Wamphamvuzonse.","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yehova akunena kuti,","poem":1},{"text":"“Akazi a ku Ziyoni ngodzikuza kwambiri,","poem":2},{"text":"akuyenda atakweza makosi awo,","poem":1},{"text":"akukopa amuna ndi maso awo","poem":2},{"text":"akuyenda monyangʼama","poem":1},{"text":"akuliza zigwinjiri za mʼmiyendo yawo","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nʼchifukwa chake Ambuye, adzatulutsa zipere pa mitu ya akazi a ku Ziyoniwo;","poem":1},{"text":"Yehova adzachititsa dazi mitu yawo.”","poem":2}]},{"type":"verse","number":18,"content":["Tsiku limenelo Ambuye adzawachotsera zodzikongoletsera zawo: za mʼmiyendo, za ku mutu za mʼkhosi,"]},{"type":"verse","number":19,"content":["ndolo ndi zibangiri, nsalu zophimba pa nkhope,"]},{"type":"verse","number":20,"content":["maduku, zigwinjiri za mʼmiyendo ndi malamba, mabotolo a zonunkhira ndi zithumwa,"]},{"type":"verse","number":21,"content":["mphete ndi zipini,"]},{"type":"verse","number":22,"content":["zovala za pa mphwando, zipewa ndi mwinjiro, zikwama,"]},{"type":"verse","number":23,"content":["magalasi oyangʼanira, zovala zosalala, nduwira ndiponso nsalu za mʼmapewa."]},{"type":"verse","number":24,"content":[{"text":"Mʼmalo mwa kununkhira azidzanunkha,","poem":1},{"text":"mʼmalo mwa lamba, adzavala chingwe;","poem":2},{"text":"mʼmalo mwa tsitsi lopesa bwino, adzakhala ndi dazi;","poem":1},{"text":"mʼmalo mwa zovala zabwino, adzavala chiguduli;","poem":2},{"lineBreak":true},{"text":"mʼmalo mwa kunyadira kukongola adzachita manyazi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Iwe Yerusalemu anthu ako aamuna adzaphedwa ndi lupanga,","poem":1},{"text":"asilikali ako adzafera ku nkhondo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Pa zipata za Ziyoni padzakhala kubuma ndi kulira;","poem":1},{"text":"Iweyo udzasakazidwa nʼkukhala pansi, ukugubuduzika pa fumbi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}