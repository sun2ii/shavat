{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["Tsoka kwa Amene Amadalira Igupto"]},{"type":"verse","number":1,"content":[{"text":"Tsoka kwa amene amapita ku Igupto kukapempha chithandizo,","poem":1},{"text":"amene amadalira akavalo,","poem":2},{"text":"nakhulupirira kuchuluka kwa magaleta awo ankhondo","poem":1},{"text":"ndiponso mphamvu za asilikali awo okwera pa akavalo,","poem":2},{"text":"koma sakhulupirira Woyerayo wa Israeli,","poem":1},{"text":"kapena kupempha chithandizo kwa Yehova.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Komatu Yehovayo ndi wanzeru ndipo angathe kuwononga,","poem":1},{"text":"ndipo sasintha chimene wanena.","poem":2},{"text":"Adzalimbana ndi anthu ochita zoyipa,","poem":1},{"text":"komanso ndi amene amathandiza anthu ochita zoyipa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aigupto ndi anthu chabe osati Mulungu;","poem":1},{"text":"akavalo awo ndi nyama chabe osati mizimu.","poem":2},{"text":"Yehova akangotambasula dzanja lake,","poem":1},{"text":"amene amapereka chithandizo adzapunthwa,","poem":2},{"lineBreak":true},{"text":"amene amalandira chithandizocho adzagwa;","poem":2},{"lineBreak":true},{"text":"onsewo adzathera limodzi.","poem":2}]},{"type":"verse","number":4,"content":["Zimene Yehova akunena kwa ine ndi izi:",{"text":"“Monga mkango kapena msona wamkango umabangula","poem":1},{"text":"ukagwira nyama yake,","poem":2},{"text":"ndipo suopsedwa kapena kusokonezeka","poem":1},{"text":"ndi kufuwula kwa abusa amene akulimbana nayo,","poem":2},{"text":"momwemonso palibe chingaletse","poem":1},{"text":"Yehova Wamphamvuzonse","poem":2},{"text":"kubwera kudzatchinjiriza","poem":1},{"text":"phiri la Ziyoni ndi zitunda zake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Monga mbalame zowuluka pamwamba pa zisa zake,","poem":1},{"text":"Yehova Wamphamvuzonse adzatchinjiriza Yerusalemu;","poem":2},{"text":"ndi kumupulumutsa,","poem":1},{"text":"iye adzawupitirira ndi kuwulanditsa.”","poem":2}]},{"type":"verse","number":6,"content":["Inu Aisraeli, bwererani kwa Iye amene munamuwukira kwakukulu."]},{"type":"verse","number":7,"content":["Pakuti tsiku limenelo nonsenu mudzataya mafano anu a siliva ndi golide amene mumapanga ndi manja anu auchimo."]},{"type":"verse","number":8,"content":[{"text":"“Aasiriya adzaphedwa ku nkhondo ndi mphamvu osati za munthu.","poem":1},{"text":"Lupanga, osati la munthu, lidzawawononga.","poem":2},{"text":"Adzathawa ku nkhondo ndipo anyamata awo","poem":1},{"text":"adzagwira ntchito yathangata.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mfumu yawo idzamwalira ndi mantha,","poem":1},{"text":"ndipo atsogoleri awo ankhondo adzathawa ndi mantha","poem":2},{"text":"kusiya pambuyo mbendera yawo ya nkhondo.”","poem":1},{"text":"Akutero Yehova, amene moto wake uli mu Ziyoni,","poem":2},{"lineBreak":true},{"text":"ndipo ngʼanjo yake ili mu Yerusalemu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}