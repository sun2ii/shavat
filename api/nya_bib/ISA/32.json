{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["Ufumu Wachilungamo"]},{"type":"verse","number":1,"content":[{"text":"Taonani, kudzakhala mfumu ina imene idzalamulira mwachilungamo,","poem":1},{"text":"ndipo akalonga ake adzaweruza molungama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Munthu aliyense adzakhala ngati pothawirapo mphepo","poem":1},{"text":"ndi malo obisalirapo namondwe,","poem":2},{"text":"adzakhala ngati mitsinje ya mʼchipululu,","poem":1},{"text":"ngati mthunzi wa thanthwe lalikulu la mʼdziko lowuma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ndipo maso a anthu openya sadzakhalanso otseka,","poem":1},{"text":"ndipo makutu a anthu akumva adzamvetsetsa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anthu a mtima wopupuluma adzadziwa ndi kuchita zinthu mofatsa,","poem":1},{"text":"ndipo anthu ovutika kuyankhula adzayankhula mosadodoma ndi momveka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Chitsiru sichidzatchedwanso munthu waulemu wake","poem":1},{"text":"ndipo munthu woyipa sadzalemekezedwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pakuti munthu opusa amayankhula zauchitsiru,","poem":1},{"text":"amaganiza kuchita zoyipa:","poem":2},{"text":"Iye amachita zoyipira Mulungu,","poem":1},{"text":"ndipo amafalitsa zolakwika zokhudza Yehova;","poem":2},{"text":"anjala sawapatsa chakudya","poem":1},{"text":"ndipo aludzu sawapatsa madzi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Munthu woyipa njira zake ndi zoyipanso,","poem":1},{"text":"iye kwake nʼkulingalira zinthu zoyipa.","poem":2},{"text":"Amalingalira zakuti awononge anthu aumphawi ndi mabodza ake","poem":1},{"text":"ngakhale kuti waumphawiyo akuyankhula zoona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Koma munthu wolemekezeka amalingaliranso kuchita zinthu zabwino,","poem":1},{"text":"Iye amakhazikika pa zinthu zabwinozo.","poem":2}]},{"type":"heading","content":["Akazi a ku Yerusalemu"]},{"type":"verse","number":9,"content":[{"text":"Khalani maso, inu akazi","poem":1},{"text":"amene mukungokhala wopanda kulingalira kuti kunja kulinji","poem":2},{"text":"ndipo imvani mawu anga.","poem":1},{"text":"Inu akazi odzitama, imvani zimene ndikunena!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pakapita chaka ndi masiku pangʼono","poem":1},{"text":"inu akazi amatama mudzanjenjemera;","poem":2},{"text":"chifukwa mitengo ya mphesa idzakanika","poem":1},{"text":"ndipo zipatso sizidzaoneka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nthunthumirani inu okhala mosatekesekanu;","poem":1},{"text":"ndipo njenjemerani, inu akazi omadzikhulupirira nokhanu.","poem":2},{"text":"Vulani zovala zanu,","poem":1},{"text":"ndipo valani ziguduli mʼchiwuno mwanu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dzigugudeni pachifuwa mwachisoni chifukwa minda yachonde,","poem":1},{"text":"ndi mphesa yawonongeka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mʼdziko la anthu anga","poem":1},{"text":"mwamera minga ndi mkandankhuku.","poem":2},{"text":"Zoona, mulilire nyumba zonse zachikondwerero","poem":1},{"text":"ndi mzinda uno umene unali wachisangalalo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nyumba yaufumu idzasiyidwa,","poem":1},{"text":"mzinda waphokoso udzakhala wopanda anthu;","poem":2},{"text":"malinga ndi nsanja zidzasanduka chipululu mpaka muyaya.","poem":1},{"text":"Abulu adzasangalalamo ndipo ziweto zidzapezamo msipu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yehova adzatipatsa mzimu wake,","poem":1},{"text":"ndipo dziko lachipululu lidzasanduka munda wachonde,","poem":2},{"lineBreak":true},{"text":"ndipo munda wachonde udzakhala ngati nkhalango.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tsono mʼchipululu mudzakhala chiweruzo cholungama","poem":1},{"text":"ndipo mʼminda yachonde mudzakhala chilungamo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mtendere udzakhala chipatso chachilungamo;","poem":1},{"text":"zotsatira za chilungamo zidzakhala bata ndi kudzidalira mpaka muyaya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anthu anga adzakhala mʼmidzi yamtendere,","poem":1},{"text":"mʼnyumba zodalirika,","poem":2},{"lineBreak":true},{"text":"ndi malo osatekeseka a mpumulo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngakhale nkhalango idzawonongedwa ndi matalala","poem":1},{"text":"ndipo mzinda udzagwetsedwa mpaka pansi,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"inutu mudzakhala odalitsika ndithu.","poem":1},{"text":"Mudzadzala mbewu zanu mʼmbali mwa mtsinje uliwonse,","poem":2},{"lineBreak":true},{"text":"ndipo ngʼombe zanu ndi abulu anu zidzadya paliponse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}