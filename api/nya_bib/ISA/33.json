{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["Msautso ndi Thandizo"]},{"type":"verse","number":1,"content":[{"text":"Tsoka kwa iwe, iwe wowonongawe,","poem":1},{"text":"amene sunawonongedwepo!","poem":2},{"text":"Tsoka kwa iwe, iwe mthirakuwiri,","poem":1},{"text":"iwe amene sunanyengedwepo!","poem":2},{"text":"Iwe ukadzaleka kuwononga,","poem":1},{"text":"udzawonongedwa,","poem":2},{"text":"ukadzasiya umʼthirakuwiri, adzakuwononga,","poem":1},{"text":"ndipo ukadzaleka kuchita zachinyengo adzakunyenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Inu Yehova, mutikomere mtima ife;","poem":1},{"text":"tikulakalaka Inu.","poem":2},{"text":"Tsiku ndi tsiku mutitchinjirize ndi mkono wanu,","poem":1},{"text":"ndipo mutipulumutse pa nthawi ya masautso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mukatulutsa liwu lanu longa bingu mitundu ya anthu imathawa;","poem":1},{"text":"pamene Inu mwadzambatuka mitundu ya anthu imabalalika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zofunkha za ku nkhondo za mitundu ina Aisraeli adzazisonkhanitsa ngati mmene limachitira dzombe.","poem":1},{"text":"Iwo adzalumphira zofunkhazo monga mmene limachitira dzombe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yehova wakwezeka kwambiri pakuti amakhala pamwamba pa zonse","poem":1},{"text":"adzadzaza Ziyoni ndi chilungamo ndi chipulumutso.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iye adzakupatsani mtendere pa nthawi yanu,","poem":1},{"text":"adzakupatsani chipulumutso chochuluka, nzeru zambiri ndi chidziwitso chochuluka;","poem":2},{"lineBreak":true},{"text":"kuopa Yehova ngati madalitso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Taonani, anthu awo amphamvu akulira mofuwula mʼmisewu;","poem":1},{"text":"akazembe okhazikitsa mtendere akulira kwambiri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mʼmisewu yayikulu mulibe anthu,","poem":1},{"text":"mʼmisewu mulibe anthu a paulendo.","poem":2},{"text":"Mdaniyo ndi wosasunga pangano.","poem":1},{"text":"Iye amanyoza mboni.","poem":2},{"lineBreak":true},{"text":"Palibe kulemekezana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dziko likulira ndipo likunka likutha.","poem":1},{"text":"Nkhalango ya Lebanoni ikuchita manyazi, yafota.","poem":2},{"text":"Chigwa cha chonde cha Saroni chasanduka chachidalala.","poem":1},{"text":"Masamba a mitengo ya ku Basani ndi Karimeli akuyoyoka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yehova akunena kuti, “Tsopano ndidzadzambatuka","poem":1},{"text":"ndipo ndidzaonetsa mphamvu zanga,","poem":2},{"lineBreak":true},{"text":"ndipo ndidzakwezedwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zolingalira zanu nʼzachabechabe","poem":1},{"text":"ngati udzu wamanyowa.","poem":2},{"lineBreak":true},{"text":"Mpweya wamoto udzakupserezani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anthu a mitundu ina adzatenthedwa ngati miyala ya njereza;","poem":1},{"text":"ndi ngati minga yodulidwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Inu amene muli kutali, imvani zimene ndachita;","poem":1},{"text":"inu amene muli pafupi, dziwani mphamvu zanga","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mu mzinda wa Ziyoni anthu ochimwa agwidwa ndi mantha;","poem":1},{"text":"anthu osapembedza Mulungu akunjenjemera:","poem":2},{"text":"Iwo akunena kuti, “Ndani wa ife angathe kukhala mʼmoto wonyeketsa?","poem":1},{"text":"Ndani wa ife angathe kukhala moto wosatha?”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Angathe kuti ndi amene amachita zolungama","poem":1},{"text":"ndi kuyankhula zoona,","poem":2},{"text":"amene amakana phindu lolipeza monyenga","poem":1},{"text":"ndipo salola manja ake kulandira ziphuphu,","poem":2},{"text":"amene amatseka makutu ake kuti angamve mawu opangana kupha anzawo","poem":1},{"text":"ndipo amatsinzina kuti angaone zoyipa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Munthu wotere ndiye adzakhale pa nsanja,","poem":1},{"text":"kothawira kwake kudzakhala mʼmalinga a mʼmapiri.","poem":2},{"text":"Azidzalandira chakudya chake","poem":1},{"text":"ndipo madzi sadzamusowa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nthawi imeneyo maso a ana adzaona mfumu ya maonekedwe wokongola","poem":1},{"text":"ndi kuona dziko lotambasukira kutali.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mu mtima mwanu muzidzalingalira zoopsa zinachitika kale zija:","poem":1},{"text":"“Ali kuti mkulu wa Asilikali uja?","poem":2},{"lineBreak":true},{"text":"Ali kuti wokhometsa misonkho uja?","poem":2},{"lineBreak":true},{"text":"Ali kuti mkulu woyangʼanira nsanja?”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Simudzawaonanso anthu odzikuza aja,","poem":1},{"text":"anthu aja achiyankhulo chosadziwika,","poem":2},{"lineBreak":true},{"text":"chachilendo ndi chosamveka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Taonani Ziyoni, mzinda wa zikondwerero zachipembedzo chathu;","poem":1},{"text":"maso anu adzaona Yerusalemu,","poem":2},{"lineBreak":true},{"text":"mzinda wamtendere, tenti imene sidzachotsedwa,","poem":2},{"text":"zikhomo zake sizidzazulidwa,","poem":1},{"text":"kapena zingwe zake kuduka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kumeneko Yehova adzaonetsa ulemerero wake","poem":1},{"text":"ndipo mzindawo udzakhala kasupe wa mitsinje yayikulu.","poem":2},{"text":"Ngalawa za zopalasa sizidzapitamo,","poem":1},{"text":"sitima zapamadzi zikuluzikulu sizidzayendamo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Pakuti Yehova ndi woweruza wathu,","poem":1},{"text":"Yehova ndiye wotilamulira,","poem":2},{"text":"Yehova ndiye mfumu yathu;","poem":1},{"text":"ndipo ndiye amene adzatipulumutse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Zingwe za sitima zapamadzi za adani athu zamasuka,","poem":1},{"text":"sizikutha kulimbitsa mlongoti wake,","poem":2},{"lineBreak":true},{"text":"matanga ake sakutheka kutambasuka.","poem":2},{"text":"Ngakhale tidzagawana zofunkha zochuluka kwambiri","poem":1},{"text":"ndipo ngakhale olumala adzatenga zofunkhazo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Palibe ndi mmodzi yemwe wokhala mʼZiyoni adzanene kuti, “Ndikudwala”","poem":1},{"text":"ndipo anthu onse okhala mʼmenemo machimo awo adzakhululukidwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}