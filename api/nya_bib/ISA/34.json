{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Chiweruzo cha Anthu a Mitundu Yonse"]},{"type":"verse","number":1,"content":[{"text":"Inu anthu a mitundu yonse, bwerani pafupi kuti mumve:","poem":1},{"text":"tcherani khutu, inu anthu a mitundu ina yonse:","poem":2},{"text":"Limvetsere dziko lapansi pamodzi ndi zonse zili mʼmenemo,","poem":1},{"text":"dziko lonse pamodzi ndi zonse zochokera mʼmenemo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yehova wayipidwa ndi anthu a mitundu yonse;","poem":1},{"text":"wapsera mtima magulu awo onse ankhondo.","poem":2},{"text":"Iye adzawawononga kotheratu,","poem":1},{"text":"nawapereka kuti aphedwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anthu awo ophedwa adzatayidwa kunja,","poem":1},{"text":"mitembo yawo idzawola ndi kununkha;","poem":2},{"lineBreak":true},{"text":"mapiri adzafiira ndi magazi awo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dzuwa, mwezi ndi nyenyezi zidzasungunuka","poem":1},{"text":"ndipo mlengalenga mudzakulungidwa ngati chipepala;","poem":2},{"text":"nyenyezi zonse zidzayoyoka","poem":1},{"text":"ngati masamba ofota a mphesa,","poem":2},{"lineBreak":true},{"text":"ngati masamba onyala a mtengo wa mkuyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yehova akuti, “Lupanga langa lakhutiratu magazi kumwamba;","poem":1},{"text":"taonani, likutsika kudzalanga anthu a ku Edomu,","poem":2},{"lineBreak":true},{"text":"anthu amene ndawawononga kotheratu.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lupanga la Yehova lakhuta magazi,","poem":1},{"text":"lakutidwa ndi mafuta;","poem":2},{"text":"magazi a ana ankhosa onenepa ndi ambuzi,","poem":1},{"text":"mafuta a ku impsyo za nkhosa zazimuna.","poem":2},{"text":"Pakuti Yehova ali ndi nsembe mu Bozira","poem":1},{"text":"ndiko kuphedwa kwa anthu ambiri mʼdziko la Edomu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pamodzi ndi anthuwo zidzaphedwanso njati,","poem":1},{"text":"ngʼombe zazimuna zazingʼono ndi zazikulu zomwe.","poem":2},{"text":"Dziko lawo lidzakhala magazi okhaokha,","poem":1},{"text":"ndipo nthaka idzakutidwa ndi mafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Iyi ndi nthawi imene Yehova adzalipsira","poem":1},{"text":"ndi kulanga adani a Ziyoni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Madzi a mʼmitsinje ya Edomu adzasanduka phula,","poem":1},{"text":"ndipo fumbi lake lidzasanduka sulufule;","poem":2},{"lineBreak":true},{"text":"dziko lake lidzasanduka phula lamoto!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Motowo sudzazimitsidwa usiku ndi usana;","poem":1},{"text":"utsi wake udzafuka kosalekeza.","poem":2},{"text":"Dzikolo lidzakhala chipululu pa mibado ndi mibado;","poem":1},{"text":"palibe ndi mmodzi yemwe amene adzadutsemo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mʼdzikomo mudzakhala akabawi ndi anungu;","poem":1},{"text":"amantchichi ndi akhwangwala adzapanga zisa zawo mʼmenemo.","poem":2},{"text":"Mulungu adzatambalitsa pa Edomu","poem":1},{"text":"chingwe choyezera cha chisokonezo","poem":2},{"lineBreak":true},{"text":"ndi chingwe chowongolera cha chiwonongeko.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anthu olemekezeka ake sadzatchedwanso mfumu kumeneko;","poem":1},{"text":"akalonga ake onse adzachotsedwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Minga idzamera mʼnyumba zake zankhondo zotetezedwa,","poem":1},{"text":"khwisa ndi mitungwi zidzamera mʼmalinga ake.","poem":2},{"text":"Ankhandwe azidzadya mʼmenemo;","poem":1},{"text":"malo okhalamo akadzidzi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Avumbwe adzakumana ndi afisi,","poem":1},{"text":"ndipo zirombo za mʼchipululu zizidzayitanizana.","poem":2},{"text":"Kumeneko kudzafikanso mizimu yoyipa","poem":1},{"text":"ndi kupeza malo opumulirako.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kadzidzi adzamangako chisa chake nʼkuyikirako mazira,","poem":1},{"text":"adzaswa ana ake ndi kusamalira ana ake mu mthunzi wa mapiko ake;","poem":2},{"text":"akamtema adzasonkhananso kumeneko,","poem":1},{"text":"awiriawiri.","poem":2}]},{"type":"verse","number":16,"content":["Funafunani mʼbuku la Yehova ndi kuwerenga:",{"text":"mwa zolengedwazi palibe chimene chidzasowa;","poem":1},{"text":"sipadzakhala nʼchimodzi chomwe chopanda chinzake.","poem":2},{"text":"Pakuti Yehova walamula kuti zitero,","poem":1},{"text":"ndipo Mzimu wake udzawasonkhanitsa pamodzi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yehova wagawa dziko lawo;","poem":1},{"text":"wapatsa chilichonse chigawo chake.","poem":2},{"text":"Dziko lidzakhala lawo mpaka muyaya","poem":1},{"text":"ndipo zidzakhala mʼmenemo pa mibado yonse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}