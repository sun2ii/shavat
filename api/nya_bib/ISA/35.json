{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Chimwemwe cha Opulumutsidwa"]},{"type":"verse","number":1,"content":[{"text":"Chipululu ndi dziko lopanda madzi zidzasangalala;","poem":1},{"text":"dziko lowuma lidzakondwa","poem":2},{"text":"ndi kuchita maluwa.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Dzikolo lidzakhala ndi maluwa ochuluka","poem":1},{"text":"lidzasangalala kwambiri ndi kufuwula mwachimwemwe.","poem":2},{"text":"Lidzakhala ndi ulemerero monga wa ku mapiri a ku Lebanoni,","poem":1},{"text":"maonekedwe ake wokongola adzakhala ngati a ku Karimeli ndi a ku Saroni.","poem":2},{"lineBreak":true},{"text":"Aliyense adzaona ulemerero wa Yehova,","poem":1},{"text":"ukulu wa Mulungu wathu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Limbitsani manja ofowoka,","poem":1},{"text":"limbitsani mawondo agwedegwede;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"nenani kwa a mitima yamantha kuti;","poem":1},{"text":"“Limbani mtima, musachite mantha;","poem":2},{"text":"Mulungu wanu akubwera,","poem":1},{"text":"akubwera kudzalipsira;","poem":2},{"text":"ndi kudzabwezera chilango adani anu;","poem":1},{"text":"akubwera kudzakupulumutsani.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pamenepo maso a anthu osaona adzapenyanso","poem":1},{"text":"ndipo makutu a anthu osamva adzatsekuka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anthu olumala adzalumpha ngati mbawala,","poem":1},{"text":"ndipo osayankhula adzayimba mokondwera.","poem":2},{"text":"Akasupe adzatumphuka mʼchipululu","poem":1},{"text":"ndipo mitsinje idzayenda mʼdziko lowuma,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"mchenga wotentha udzasanduka dziwe,","poem":1},{"text":"nthaka yowuma idzasanduka ya akasupe.","poem":2},{"text":"Pamene panali mbuto ya ankhandwe","poem":1},{"text":"padzamera udzu ndi bango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ndipo kumeneko kudzakhala msewu waukulu;","poem":1},{"text":"ndipo udzatchedwa Msewu Wopatulika.","poem":2},{"text":"Anthu odetsedwa","poem":1},{"text":"sadzayendamo mʼmenemo;","poem":2},{"lineBreak":true},{"text":"zitsiru sizidzasochera mʼmenemo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kumeneko sikudzakhala mkango,","poem":1},{"text":"ngakhale nyama yolusa sidzafikako;","poem":2},{"lineBreak":true},{"text":"sidzapezeka konse kumeneko.","poem":2},{"text":"Koma okhawo amene Yehova anawapulumutsa adzayenda mu msewu umenewu.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Iwo amene Yehova anawawombola adzabwerera.","poem":2},{"text":"Adzalowa mu mzinda wa Ziyoni akuyimba;","poem":1},{"text":"kumeneko adzakondwa mpaka muyaya.","poem":2},{"text":"Adzakutidwa ndi chisangalalo ndi chimwemwe,","poem":1},{"text":"ndipo chisoni ndi kudandaula zidzatheratu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}