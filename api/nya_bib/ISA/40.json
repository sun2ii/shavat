{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Mawu a Chitonthozo kwa Anthu a Mulungu"]},{"type":"verse","number":1,"content":[{"text":"Atonthozeni, atonthozeni anthu anga,","poem":1},{"text":"akutero Mulungu wanu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayankhuleni moleza mtima anthu a ku Yerusalemu","poem":1},{"text":"ndipo muwawuzitse","poem":2},{"text":"kuti nthawi ya ukapolo wawo yatha,","poem":1},{"text":"tchimo lawo lakhululukidwa.","poem":2},{"text":"Ndawalanga mokwanira","poem":1},{"text":"chifukwa cha machimo awo onse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mawu a wofuwula mʼchipululu akuti,","poem":1},{"lineBreak":true},{"text":"“Konzani njira ya Yehova","poem":1},{"text":"mʼchipululu;","poem":2},{"text":"wongolani njira zake;","poem":1},{"text":"msewu owongoka wa Mulungu wathu mʼdziko lopanda kanthu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Chigwa chilichonse achidzaze.","poem":1},{"text":"Phiri lililonse ndi chitunda chilichonse azitsitse;","poem":2},{"text":"Dziko lokumbikakumbika alisalaze,","poem":1},{"text":"malo azitundazitunda awasandutse zidikha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndipo ulemerero wa Yehova udzaonekera,","poem":1},{"text":"ndipo mitundu yonse ya anthu idzawuona,","poem":2},{"text":"pakuti wanena zimenezi ndi Yehova.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wina ananena kuti, “Lengeza.”","poem":1},{"text":"Ndipo ine ndinati, “Kodi ndifuwule chiyani?","poem":2},{"lineBreak":true},{"text":"“Pakuti anthu onse ali ngati udzu","poem":1},{"text":"ndipo kukongola kwawo kuli ngati maluwa akuthengo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Udzu umanyala ndipo maluwa amafota","poem":1},{"text":"chifukwa cha kuwomba kwa mpweya wa Yehova.”","poem":2},{"lineBreak":true},{"text":"Mawu aja anatinso, “Ndithudi anthu sasiyana ndi udzu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Udzu umanyala ndipo maluwa amafota,","poem":1},{"text":"koma mawu a Mulungu wathu adzakhalapo mpaka muyaya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Iwe amene ukulengeza nkhani yabwino ku Ziyoni,","poem":1},{"text":"kwera pa phiri lalitali.","poem":2},{"text":"Iwe amene ukulengeza nkhani yabwino ku Yerusalemu,","poem":1},{"text":"fuwula kwambiri,","poem":2},{"text":"kweza mawu, usachite mantha;","poem":1},{"text":"uza mizinda ya ku Yuda kuti,","poem":2},{"lineBreak":true},{"text":"“Mulungu wanu akubwera!”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taonani, Ambuye Yehova akubwera mwamphamvu,","poem":1},{"text":"ndipo dzanja lake likulamulira,","poem":2},{"text":"taonani akubwera ndi mphotho yake","poem":1},{"text":"watsogoza zofunkha zako za ku nkhondo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iye adzasamalira nkhosa zake ngati mʼbusa:","poem":1},{"text":"Iye adzasonkhanitsa ana ankhosa aakazi mʼmanja mwake","poem":2},{"text":"ndipo Iye akuwanyamula pachifuwa chake","poem":1},{"text":"ndi kutsogolera bwinobwino nkhosa zoyamwitsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kodi ndani akhoza kuyeza kuchuluka kwa madzi a mʼnyanja ndi chikhatho chake,","poem":1},{"text":"kapena kuyeza kutalika kwa mlengalenga ndi dzanja lake?","poem":2},{"text":"Ndani akhoza kuyeza dothi lonse la dziko lapansi mʼdengu,","poem":1},{"text":"kapena kuyeza kulemera kwa","poem":2},{"lineBreak":true},{"text":"mapiri ndi zitunda ndi pasikelo?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndani anapereka malangizo kwa Mzimu wa Yehova","poem":1},{"text":"kapena kumuphunzitsa Iye monga phungu wake?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kodi Yehova anapemphapo nzeru kwa yani kuti akhale wopenya,","poem":1},{"text":"kapena kuti aphunzire njira yoyenera ndi nzeru?","poem":2},{"text":"Iye anapempha nzeru kwa yani","poem":1},{"text":"ndi njira ya kumvetsa zinthu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ndithudi mitundu ya anthu ili ngati dontho la madzi ochoka mu mtsuko.","poem":1},{"text":"Iwo akungoyesedwa ngati fumbi chabe pa sikelo;","poem":2},{"lineBreak":true},{"text":"mʼmanja mwa Yehova zilumba nʼzopepuka ngati fumbi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nkhalango ya ku Lebanoni singakwanire nkhuni zosonkhera moto pa guwa lansembe,","poem":1},{"text":"ngakhale nyama zake sizingakwanire kupereka nsembe zopsereza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Pamaso pa Yehova mitundu yonse ya anthu ili ngati chinthu chopandapake;","poem":1},{"text":"Iye amayiwerengera ngati chinthu chopanda phindu","poem":2},{"lineBreak":true},{"text":"ndi cha chabechabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kodi tsono Mulungu mungamuyerekeze ndi yani?","poem":1},{"text":"Kodi mungamufanizire ndi chiyani?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Likakhala fano, mʼmisiri ndiye analipanga","poem":1},{"text":"ndipo mʼmisiri wa golide amalikuta ndi golide","poem":2},{"lineBreak":true},{"text":"naliveka mkanda wasiliva.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mʼmphawi amene sangathe kupeza ngakhale chopereka nsembe chotere","poem":1},{"text":"amasankha mtengo umene sudzawola,","poem":2},{"text":"nafunafuna mʼmisiri waluso woti","poem":1},{"text":"amupangire fano limene silingasunthike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kodi simukudziwa?","poem":1},{"text":"Kodi simunamve?","poem":2},{"text":"Kodi sanakuwuzeni kuyambira pachiyambi pomwe?","poem":1},{"text":"Kodi simunamvetsetse chiyambire cha dziko lapansi?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yehova amene amakhala pa mpando wake waufumu kumwamba ndiye analenga dziko lapansi,","poem":1},{"text":"Iye amaona anthu a dziko lapansi ngati ziwala.","poem":2},{"text":"Ndipo anafunyulula mlengalenga ngati nsalu yotchinga,","poem":1},{"text":"nayikunga ngati tenti yokhalamo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Amatsitsa pansi mafumu amphamvu","poem":1},{"text":"nasandutsa olamula a dziko kukhala achabechabe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Inde, iwo ali ngati mbewu zimene zangodzalidwa kumene","poem":1},{"text":"kapena kufesedwa chapompano,","poem":2},{"lineBreak":true},{"text":"ndi kungoyamba kuzika mizu kumene","poem":2},{"text":"ndi pamene mphepo imawombapo nʼkuziwumitsa","poem":1},{"text":"ndipo kamvuluvulu amaziwulutsa ngati mankhusu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Woyera uja akuti, “Kodi mudzandiyerekeza Ine ndi yani?","poem":1},{"text":"Kapena kodi alipo wofanana nane?”","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tayangʼanani mlengalenga ndipo onani.","poem":1},{"text":"Kodi ndani analenga zonsezi mukuzionazi?","poem":2},{"text":"Yehova ndiye amene amazitsogolera ngati gulu la ankhondo,","poem":1},{"text":"nayitana iliyonse ndi dzina lake.","poem":2},{"text":"Ndipo popeza Iye ali ndi nyonga zambiri,","poem":1},{"text":"palibe ndi imodzi yomwe imene inasowapo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Iwe Yakobo, chifukwa chiyani umanena","poem":1},{"text":"ndi kumadandaula iwe Israeli, kuti,","poem":2},{"text":"“Yehova sakudziwa mavuto anga,","poem":1},{"text":"Mulungu wanga sakusamala zomwe zikundichitikira ine?”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kodi simukudziwa?","poem":1},{"text":"Kodi simunamve?","poem":2},{"text":"Yehova ndiye Mulungu wamuyaya,","poem":1},{"text":"ndiyenso Mlengi wa dziko lonse lapansi.","poem":2},{"text":"Iye sadzatopa kapena kufowoka","poem":1},{"text":"ndipo palibe amene angadziwe maganizo ake.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Iye amalimbitsa ofowoka","poem":1},{"text":"ndipo otopa amawawonjezera mphamvu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ngakhale achinyamata amalefuka ndi kufowoka,","poem":1},{"text":"ndipo achinyamata amapunthwa ndi kugwa;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"koma iwo amene amakhulupirira Yehova","poem":1},{"text":"adzalandira mphamvu zatsopano.","poem":2},{"text":"Adzawuluka ngati chiwombankhanga;","poem":1},{"text":"adzathamanga koma sadzalefuka,","poem":2},{"lineBreak":true},{"text":"adzayenda koma sadzatopa konse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}