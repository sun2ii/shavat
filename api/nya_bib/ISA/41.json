{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["Mulungu Thandizo la Israeli"]},{"type":"verse","number":1,"content":[{"text":"“Khalani chete pamaso panga, inu mayiko a mʼmbali mwa nyanja!","poem":1},{"text":"Alekeni ayandikire ndi kuyankhula;","poem":2},{"text":"tiyeni tikhale pamodzi","poem":1},{"text":"kuti atiweruze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Ndani anadzutsa wochokera kummawa","poem":1},{"text":"uja amene ananka napambana kulikonse kumene ankapita?","poem":2},{"text":"Iye amapereka anthu a mitundu ina mʼmanja mwake","poem":1},{"text":"ndipo ndi lupanga lake anagonjetsa","poem":2},{"text":"ndi kusandutsa mafumu kukhala ngati fumbi","poem":1},{"text":"nawamwaza ngati mankhusu ndi uta wake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amawalondola namayenda mosavutika,","poem":1},{"text":"mʼnjira imene mapazi ake sanayendemo kale.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndani anachita zimenezi ndi kuzitsiriza,","poem":1},{"text":"si uja amene anayambitsa mitundu ya anthu?","poem":2},{"text":"Ine Yehova, ndine chiyambi","poem":1},{"text":"ndipo potsiriza pake ndidzakhalapo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mayiko amʼmbali mwa nyanja aona zimenezi ndipo akuopa;","poem":1},{"text":"anthu a ku mathero a dziko lapansi akunjenjemera.","poem":2},{"text":"Akuyandikira pafupi, akubwera;","poem":1}]},{"type":"verse","number":6,"content":[{"text":"aliyense akuthandiza mnzake","poem":2},{"lineBreak":true},{"text":"ndipo akuwuza mʼbale wake kuti, “Limba mtima!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mʼmisiri wa matabwa amalimbikitsa mʼmisiri wa golide,","poem":1},{"text":"ndipo iye amene amasalaza fano ndi nyundo","poem":2},{"lineBreak":true},{"text":"amalimbikitsa amene amalisanja pa chipala.","poem":2},{"text":"Ponena za kuwotcherera iye amati, “Zili bwino.”","poem":1},{"text":"Iye amalikhomerera fanolo ndi misomali kuti lisagwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Koma Iwe Israeli mtumiki wanga,","poem":1},{"text":"Yakobo amene ndakusankha,","poem":2},{"lineBreak":true},{"text":"Ndiwe chidzukulu cha Abrahamu bwenzi langa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndinakutengani kuchokera ku mapeto a dziko lapansi,","poem":1},{"text":"ndinakuyitanani kuchokera ku mbali za kutali za dziko lapansi.","poem":2},{"text":"Ine ndinati, ‘Iwe ndiwe mtumiki wanga;’","poem":1},{"text":"Ndinakusankha ndipo sindinakutaye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tsono usaope, pakuti Ine ndili nawe;","poem":1},{"text":"usataye mtima chifukwa Ine ndine Mulungu wako.","poem":2},{"text":"Ndidzakupatsa mphamvu ndipo ndidzakuthandiza,","poem":1},{"text":"ndidzakutchinjiriza ndi dzanja langa lamanja logonjetsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Onse amene akupsera mtima","poem":1},{"text":"adzachita manyazi ndithu ndi kunyazitsidwa;","poem":2},{"text":"onse amene akukangana nawe","poem":1},{"text":"sadzakhalanso kanthu, adzawonongeka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Udzafunafuna adani ako,","poem":1},{"text":"koma sadzapezeka.","poem":2},{"text":"Iwo amene akuchita nawe nkhondo","poem":1},{"text":"sadzakhalanso kanthu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pakuti Ine Yehova, ndine Mulungu wako,","poem":1},{"text":"amene ndikukugwira dzanja lako lamanja","poem":2},{"text":"ndipo ndikuti, usaope;","poem":1},{"text":"ndidzakuthandiza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Usachite mantha, iwe Yakobo wofowoka ngati nyongolotsi,","poem":1},{"text":"iwe wochepa mphamvu Israeli,","poem":2},{"text":"chifukwa Ine ndidzakuthandiza,”","poem":1},{"text":"akutero Yehova Mpulumutsi wako, Woyerayo wa Israeli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Taona, ndidzakusandutsa ngati chipangizo chopunthira tirigu","poem":1},{"text":"chatsopano, chakunthwa ndi cha mano ambiri.","poem":2},{"text":"Udzanyenya mapiri ndi kuwaphwanyaphwanya,","poem":1},{"text":"ndipo zitunda adzazisandutsa ngati mankhusu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Udzawapeta ndipo adzawuluka ndi mphepo komanso","poem":1},{"text":"adzamwazika ndi kamvuluvulu.","poem":2},{"text":"Koma iwe udzakondwera chifukwa Ine ndine Mulungu wako,","poem":1},{"text":"ndipo udzanyadira chifukwa cha Ine Woyerayo wa Israeli:","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Pamene amphawi ndi osauka akufunafuna madzi,","poem":1},{"text":"koma sakuwapeza;","poem":2},{"lineBreak":true},{"text":"ndipo kummero kwawo kwawuma ndi ludzu.","poem":2},{"text":"Ine Yehova ndidzayankha pemphero lawo;","poem":1},{"text":"Ine, Mulungu wa Israeli, sindidzawasiya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndidzayendetsa mitsinje mʼmalo owuma,","poem":1},{"text":"ndi akasupe adzatumphuka mu zigwa.","poem":2},{"text":"Ndidzasandutsa chipululu kukhala dziwe la madzi","poem":1},{"text":"ndipo dziko lowuma kukhala akasupe a madzi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mʼchipululu ndidzameretsa","poem":1},{"text":"mkungudza, kasiya mchisu ndi mtengo wa Olivi.","poem":2},{"text":"Mʼdziko lowuma ndidzaza mitengo","poem":1},{"text":"ya payini, ya mkuyu ndi ya mlombwa,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kuti anthu aone ndi kudziwa;","poem":1},{"text":"inde, alingalire ndi kumvetsa,","poem":2},{"text":"kuti Yehova ndiye wachita zimenezi;","poem":1},{"text":"kuti Woyera wa Israeli ndiye anakonza zimenezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Yehova akuwuza milungu ina kuti, ‘Fotokozani mlandu wanu.’","poem":1},{"text":"Mfumu ya Yakobo ikuti, ‘Perekani umboni wanu.’","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bwerani ndi milungu yanu kuti idzatiwuze","poem":1},{"text":"zomwe zidzachitike mʼtsogolo.","poem":2},{"text":"Tifotokozereni zinthu zamakedzana","poem":1},{"text":"tiziganizire","poem":2},{"lineBreak":true},{"text":"ndi kudziwa zotsatira zake.","poem":2},{"text":"Kapena tiwuzeni zimene zidzachitike mʼtsogolo,","poem":1}]},{"type":"verse","number":23,"content":[{"text":"tiwuzeni kuti kutsogolo kuli zotani,","poem":2},{"lineBreak":true},{"text":"ndipo ife tidziwa kuti ndinu milungu.","poem":2},{"text":"Chitani chinthu chabwino kapena choyipa,","poem":1},{"text":"ndipo mutidabwitsa ndi kutichititsa mantha.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Koma inu sindinu kanthu","poem":1},{"text":"ndipo zochita zanu nʼzopandapake;","poem":2},{"lineBreak":true},{"text":"amene amapembedza inu ali ngati chinthu chokanidwa chifukwa ndi choyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Ndinawutsa munthu wina kumpoto ndipo anabwera,","poem":1},{"text":"munthu wochokera kummawa amene ndinamuyitana.","poem":2},{"text":"Amapondaponda olamulira ngati matope,","poem":1},{"text":"ngati ndi wowumba mbiya amene akuponda dongo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndani anawululiratu zimenezi poyamba pomwe, kuti ife tidziwe,","poem":1},{"text":"kapena kutiwuziratu zisanachitike kuti ife tinene kuti, ‘Analondola?’","poem":2},{"text":"Palibe amene ananena,","poem":1},{"text":"palibe analengeza zimenezi,","poem":2},{"lineBreak":true},{"text":"palibe anamva mawu anu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ine ndinali woyamba kumuwuza Ziyoni kuti, ‘Taona, si awa akubwera apawa!’","poem":1},{"text":"Ndinatumiza mthenga wa nkhani yabwino ku Yerusalemu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Koma ndikayangʼana palibe ndi mmodzi yemwe,","poem":1},{"text":"palibe ndi mmodzi yemwe pakati pawo wotha kupereka uphungu,","poem":2},{"lineBreak":true},{"text":"palibe woti ayankhe pamene ine ndawafunsa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Taonani, milungu yonseyi ndi yachinyengo!","poem":1},{"text":"Zochita zawo si kanthu konse;","poem":2},{"lineBreak":true},{"text":"mafano awo ali ngati mphepo yachabechabe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}