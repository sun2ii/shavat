{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["Mtumiki wa Yehova"]},{"type":"verse","number":1,"content":[{"text":"“Nayu mtumiki wanga, amene ndimamuchirikiza,","poem":1},{"text":"amene ndamusankha, amenenso ndimakondwera naye.","poem":2},{"text":"Ndayika Mzimu wanga mwa Iyeyo,","poem":1},{"text":"ndipo adzaweruza anthu a mitundu yonse mwachilungamo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iye sadzafuwula, sadzamveka mawu,","poem":1},{"text":"kapena mawu ake kumveka mʼmisewu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bango lophwanyika sadzalithyola,","poem":1},{"text":"ndipo moto wozilala sadzawuzimitsa.","poem":2},{"text":"Motero adzaonetsa kuti chilungamo ndicho choonadi;","poem":1}]},{"type":"verse","number":4,"content":[{"text":"sadzafowoka kapena kukhumudwa","poem":2},{"text":"mpaka atakhazikitsa chilungamo pa dziko lapansi,","poem":1},{"text":"ndi mpaka mayiko a mʼmbali mwa nyanja atafika poyembekezera malangizo ake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yehova Mulungu","poem":1},{"lineBreak":true},{"text":"amene analenga zamlengalenga ndi kuziyalika,","poem":1},{"text":"amene analenga dziko lapansi ndi zonse zimene zimabereka,","poem":2},{"text":"amenenso amapereka mpweya kwa anthu ake okhala mʼdzikomo,","poem":1},{"text":"ndi moyo kwa onse oyendamo, akuti,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ine Yehova, ndakuyitana chifukwa Ine ndine wolungama;","poem":1},{"text":"ndikugwira dzanja ndipo","poem":2},{"text":"ndidzakuteteza.","poem":1},{"text":"Ndakupereka kukhala pangano langa kwa anthu","poem":2},{"lineBreak":true},{"text":"ndi kuwunika kwa anthu a mitundu ina.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Udzatsekula maso a anthu osaona,","poem":1},{"text":"udzamasula anthu a mʼndende","poem":2},{"lineBreak":true},{"text":"ndi kutulutsa mʼndende anthu okhala mu mdima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ine ndine Yehova: dzina langa ndi limenelo!","poem":1},{"text":"Sindidzapereka ulemerero wanga kwa wina aliyense","poem":2},{"lineBreak":true},{"text":"kapena matamando anga kwa mafano.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taonani, zinthu zimene ndinalosera kale zachitikadi,","poem":1},{"text":"ndipo ndikuwuzani zinthu zatsopano;","poem":2},{"text":"zinthuzo zisanaonekere","poem":1},{"text":"Ine ndakudziwitsani.”","poem":2}]},{"type":"heading","content":["Nyimbo Yotamanda Yehova"]},{"type":"verse","number":10,"content":[{"text":"Imbirani Yehova nyimbo yatsopano,","poem":1},{"text":"mutamandeni inu okhala mʼdziko lonse lapansi,","poem":2},{"text":"inu amene mumayenda pa nyanja, nyanja ikokome ndi zonse zili mʼmenemo.","poem":1},{"text":"Inu okhala pa zilumba tamandani Yehova.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Chipululu ndi mizinda yake zikweze mawu awo;","poem":1},{"text":"midzi ya Akedara ikondwere.","poem":2},{"text":"Anthu a ku Sela ayimbe mwachimwemwe;","poem":1},{"text":"afuwule kuchokera pamwamba pa mapiri.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Atamande Yehova","poem":1},{"text":"ndipo alalike matamando ake kwa anthu apazilumba zonse.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yehova adzapita ku nkhondo ngati munthu wamphamvu,","poem":1},{"text":"adzawutsa ukali wake ngati munthu wankhondo;","poem":2},{"text":"akukuwa ndiponso akufuwula mfuwu wankhondo","poem":1},{"text":"ndipo adzagonjetsa adani ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yehova akuti, “Ndakhala ndili chete kwa nthawi yayitali,","poem":1},{"text":"ndakhala ndili phee osachita kanthu.","poem":2},{"text":"Koma tsopano, ngati mayi pa nthawi yochira,","poem":1},{"text":"ndi kubuwula ndi kupuma modukizadukiza ndipo ndili wefuwefu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndidzawononga mapiri ndi zitunda","poem":1},{"text":"ndipo ndidzawumitsa zomera zawo zonse;","poem":2},{"text":"ndidzasandutsa mitsinje kukhala zilumba","poem":1},{"text":"ndipo ndidzawumitsa maiwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndidzatsogolera anthu osaona mʼmisewu imene sanayidziwe,","poem":1},{"text":"ndidzawatsogolera mʼnjira zimene sanayendepo;","poem":2},{"text":"ndidzasandutsa mdima wa kutsogolo kwawo kuti ukhale kuwala","poem":1},{"text":"ndipo ndidzasalaza malo osalala.","poem":2},{"text":"Zimenezi ndizo ndidzachite;","poem":1},{"text":"sindidzawataya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Koma onse amene amadalira mafano","poem":1},{"text":"amene amanena kwa mafanowo kuti, ‘ndinu milungu yathu,’","poem":2},{"lineBreak":true},{"text":"ndidzawachititsa manyazi kotheratu.","poem":2}]},{"type":"heading","content":["Aisraeli Alephera Kuphunzira"]},{"type":"verse","number":18,"content":[{"text":"“Imvani, agonthi inu;","poem":1},{"text":"yangʼanani osaona inu, kuti muone!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ali wosaona ndani, si mtumiki wanga kodi?","poem":2},{"lineBreak":true},{"text":"Ndipo ndani ali wosamva ngati mthenga amene ndamutuma?","poem":2},{"text":"Kodi ndani ali wosaona ngati uja ndinachita naye pangano,","poem":1},{"text":"kapena wosaona ndani ngati mtumiki wa Yehova?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iwe waona zinthu zambiri, koma sunazisamale;","poem":1},{"text":"makutu ako ndi otsekuka koma sumva kanthu.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Chinamukomera Yehova","poem":1},{"text":"chifukwa cha chilungamo chake,","poem":2},{"lineBreak":true},{"text":"kapena lamulo lake kukhala lalikulu ndi lopambana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Koma awa ndi anthu amene afunkhidwa ndi kuwalanda zinthu zawo,","poem":1},{"text":"onsewa anawakola mʼmaenje","poem":2},{"lineBreak":true},{"text":"kapena akuwabisa mʼndende.","poem":2},{"text":"Tsono asanduka chofunkha","poem":1},{"text":"popanda wina wowapulumutsa","poem":2},{"text":"kapena kunena kuti,","poem":1},{"text":"“Abwezeni kwawo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kodi ndani wa inu amene adzamvetsera zimenezi","poem":1},{"text":"kapena kutchera khutu ndi kumva za mʼtsogolomo?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndani anapereka Yakobo kwa ofunkha,","poem":1},{"text":"ndi Israeli kwa anthu akuba?","poem":2},{"text":"Kodi si Yehova,","poem":1},{"text":"amene ife tamuchimwirayu?","poem":2},{"text":"Pakuti sanathe kutsatira njira zake;","poem":1},{"text":"ndipo sanamvere malangizo ake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Motero anawakwiyira kwambiri,","poem":1},{"text":"nawavutitsa ndi nkhondo.","poem":2},{"text":"Anayatsa moto ponseponse mowazungulira komabe iwo sanamvetse;","poem":1},{"text":"motowo unawapsereza, koma iwo sanatengepo phunziro ayi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}