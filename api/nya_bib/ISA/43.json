{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["Yehova Yekha Mpulumutsi wa Israeli"]},{"type":"verse","number":1,"content":[{"text":"Koma tsopano, Yehova","poem":1},{"text":"amene anakulenga, iwe Yakobo,","poem":2},{"lineBreak":true},{"text":"amene anakuwumba, iwe Israeli akuti,","poem":2},{"text":"“Usaope, pakuti ndakuwombola;","poem":1},{"text":"Ndinakuyitanitsa mokutchula dzina lako, ndiwe wanga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pamene ukuwoloka nyanja,","poem":1},{"text":"ndidzakhala nawe;","poem":2},{"text":"ndipo pamene ukuwoloka mitsinje,","poem":1},{"text":"sidzakukokolola.","poem":2},{"text":"Pamene ukudutsa pa moto,","poem":1},{"text":"sudzapsa;","poem":2},{"lineBreak":true},{"text":"lawi la moto silidzakutentha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Chifukwa Ine Yehova, Mulungu wako,","poem":1},{"text":"Woyera wa Israeli, ndine Mpulumutsi wako.","poem":2},{"text":"Ndinapereka Igupto pofuna kuti ndiwombole iwe,","poem":1},{"text":"ndinapereka Kusi ndi Seba mʼmalo mwa iwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Popeza kuti ndiwe wamtengowapatali wolemekezeka ndi wapamtima panga,","poem":1},{"text":"ndipo chifukwa ndimakukonda,","poem":2},{"text":"ndidzapereka anthu mʼmalo mwa iwe,","poem":1},{"text":"ndidzapereka mitundu ya anthu pofuna kuwombola moyo wako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Usachite mantha, pakuti Ine ndili nawe;","poem":1},{"text":"ndidzabweretsa ana ako kuchokera kummawa,","poem":2},{"lineBreak":true},{"text":"ndipo ndidzakusonkhanitsani kuchokera kumadzulo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndidzawuza a kumpoto kuti, ‘Amasuleni,’","poem":1},{"text":"ndidzawuza akummwera kuti, ‘Musawagwire.’","poem":2},{"text":"Bweretsani ana anga aamuna kuchokera ku mayiko akutali,","poem":1},{"text":"ana anga a akazi kuchokera kumalekezero a dziko lapansi;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"onsewo amadziwika ndi dzina langa;","poem":1},{"text":"ndinawalenga chifukwa cha ulemerero wanga,","poem":2},{"lineBreak":true},{"text":"ndinawawumba, inde ndinawapanga.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tulutsa anthu amene ali nawo maso koma sakupenya,","poem":1},{"text":"anthu amene ali nawo makutu koma sakumva.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mitundu yonse ya anthu isonkhane pamodzi,","poem":1},{"text":"anthu a mitundu ina akhale pamodzi pabwalo la milandu.","poem":2},{"text":"Ndani wa iwo amene ananeneratu zimenezi?","poem":1},{"text":"Ndani wa iwo anatifotokozerapo zinthu zakalekale?","poem":2},{"text":"Abweretu ndi mboni zawo kuti adzatsimikizire kuti ananena zoona,","poem":1},{"text":"kuti anthu ena amve ndi kunena kuti, “Ndi zoona.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yehova akunena kuti, “Inu Aisraeli ndinu mboni zanga,","poem":1},{"text":"ndi mtumiki wanga amene ndinakusankha,","poem":2},{"text":"kuti mundidziwe ndi kundikhulupirira, ndipo mudzamvetsa kuti Mulungu ndine ndekha.","poem":1},{"text":"Patsogolo panga sipanapangidwepo mulungu wina,","poem":2},{"text":"ngakhale pambuyo panga","poem":1},{"text":"sipadzakhalaponso wina.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akutero Yehova, “Ine, Inetu ndine Yehova,","poem":1},{"text":"ndipo palibe Mpulumutsi wina koma Ine ndekha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndine amene ndinaneneratu, amene ndinakupulumutsa;","poem":1},{"text":"ndine, osati mulungu wina wachilendo pakati panu amene ndinalengezeratu.","poem":2},{"text":"Inu ndinu mboni zanga, kuti Ine ndine Mulungu,” akutero Yehova.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"“Ine ndine Mulungu kuyambira nthawi yamakedzana, ndipo ndidzakhalabe Mulungu ku nthawi zonse.","poem":2},{"text":"Palibe amene angathe kuthawa mʼmanja mwanga,","poem":1},{"text":"ndipo chimene ndachita palibe angathe kuchisintha.”","poem":2}]},{"type":"heading","content":["Chifundo cha Mulungu ndi Kusakhulupirika kwa Israeli"]},{"type":"verse","number":14,"content":[{"text":"Yehova akuti,","poem":1},{"text":"Mpulumutsi wanu, Woyerayo wa Israeli akuti,","poem":2},{"text":"“Chifukwa cha inu ndidzatuma gulu lankhondo kukalimbana ndi Babuloni","poem":1},{"text":"ndi kukupulumutsani.","poem":2},{"lineBreak":true},{"text":"Ndidzagwetsa zitseko zonse za mzindawo, ndipo kukondwa kwa anthu ake kudzasanduka kulira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ine ndine Yehova, Woyera wanu uja,","poem":1},{"text":"Mlengi wa Israeli. Ine ndine Mfumu yanu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yehova","poem":1},{"text":"anapanga njira pa nyanja,","poem":2},{"lineBreak":true},{"text":"anapanga njira pakati pa madzi amphamvu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iye anasonkhanitsa magaleta, akavalo,","poem":1},{"text":"gulu lankhondo ndi asilikali amphamvu,","poem":2},{"text":"ndipo onse anagwa pamenepo, osadzukanso","poem":1},{"text":"anazimitsidwa kutheratu ngati chingwe cha nyale. Yehova ameneyu akuti,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Iwalani zinthu zakale;","poem":1},{"text":"ndipo musaganizirenso zinthu zimene zinachitika kale.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taonani, Ine ndikuchita zinthu zatsopano!","poem":1},{"text":"Tsopano zayamba kale kuoneka; kodi simukuziona?","poem":2},{"text":"Ine ndikulambula msewu mʼchipululu","poem":1},{"text":"ndi kupanga mitsinje mʼdziko lowuma.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nyama zakuthengo, nkhandwe ndi akadzidzi","poem":1},{"text":"zinandilemekeza.","poem":2},{"text":"Ndidzayendetsa mitsinje mʼdziko lowuma","poem":1},{"text":"kuti ndiwapatse madzi anthu anga","poem":2},{"text":"osankhidwa.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Anthu amene ndinadziwumbira ndekha","poem":2},{"lineBreak":true},{"text":"kuti aziyimba nyimbo yotamanda Ine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Komatu simunapemphera kwa Ine, Inu a mʼbanja la Yakobo,","poem":1},{"text":"munatopa nane, Inu Aisraeli.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Simunabweretse kwa Ine nkhosa za nsembe zopsereza,","poem":1},{"text":"kapena kundilemekeza ndi nsembe zanu.","poem":2},{"text":"Ine sindinakulemetseni pomakupemphani zopereka za chakudya","poem":1},{"text":"kapena kukutopetsani pomakupemphani nsembe zofukiza.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Simunandigulire bango lonunkhira","poem":1},{"text":"kapena kundipatsa Ine mafuta okwanira a nsembe zanu.","poem":2},{"text":"Koma inu mwandilemetsa Ine ndi machimo anu","poem":1},{"text":"ndipo mwanditopetsa Ine ndi zolakwa zanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Ine, Inetu, ndi amene ndimafafaniza","poem":1},{"text":"zolakwa zanu, chifukwa cha Ine mwini,","poem":2},{"lineBreak":true},{"text":"ndipo sindidzakumbukiranso machimo anu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mundikumbutse zakale,","poem":1},{"text":"ndipo titsutsane nkhaniyi pamodzi;","poem":2},{"lineBreak":true},{"text":"fotokozani mlandu wanu kuti muonetse kuti ndinu osalakwa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kholo lanu loyamba linachimwa;","poem":1},{"text":"ndipo Atsogoleri anu achipembedzo anandiwukira.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Chifukwa chake Ine ndidzanyazitsa akuluakulu a Nyumba yanu ya mapemphero,","poem":1},{"text":"ndipo ndidzapereka Yakobo kuti awonongedwe","poem":2},{"lineBreak":true},{"text":"ndi Israeli kuti achitidwe chipongwe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}