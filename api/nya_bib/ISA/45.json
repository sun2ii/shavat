{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"Yehova akuyankhula ndi wodzozedwa wake","poem":1},{"text":"Koresi amene anamugwira dzanja lamanja","poem":2},{"text":"kuti agonjetse mitundu ya anthu","poem":1},{"text":"ndi kuwalanda mafumu zida zawo zankhondo,","poem":2},{"text":"ndi kutsekula zitseko","poem":1},{"text":"kuti zipatazo zisadzatsekedwenso ndi ichi:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ine ndidzayenda patsogolo pako,","poem":1},{"text":"ndi kusalaza mapiri;","poem":2},{"text":"ndidzaphwanya zitseko za mkuwa","poem":1},{"text":"ndi kuthyola mipiringidzo ya chitsulo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndidzakupatsa chuma chobisika mu mdima,","poem":1},{"text":"katundu wa pamalo obisika,","poem":2},{"text":"kotero kuti udziwe kuti Ine ndine Yehova","poem":1},{"text":"Mulungu wa Israeli, amene ndakuyitana pokutchula dzina.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Chifukwa cha mtumiki wanga Yakobo,","poem":1},{"text":"chifukwa cha wosankhidwa wanga Israeli,","poem":2},{"text":"Ine ndakuyitana pokutchula dzina","poem":1},{"text":"ndipo ndakupatsa dzina laulemu","poem":2},{"lineBreak":true},{"text":"ngakhale iwe sukundidziwa Ine.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ine ndine Yehova ndipo palibenso wina;","poem":1},{"text":"kupatula Ine palibenso Mulungu wina.","poem":2},{"text":"Ndidzakupatsa mphamvu,","poem":1},{"text":"ngakhale sukundidziwa Ine,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kotero kuti kuchokera kummawa mpaka kumadzulo","poem":1},{"text":"anthu adzadziwa kuti palibe wina koma Ine ndekha.","poem":2},{"text":"Ine ndine Yehova,","poem":1},{"text":"ndipo palibenso wina.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndimalenga kuwala ndi mdima,","poem":1},{"text":"ndimabweretsa madalitso ndi tsoka;","poem":2},{"lineBreak":true},{"text":"ndine Yehova, amene ndimachita zonsezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Iwe thambo gwetsa mvula kuchokera kumwamba;","poem":1},{"text":"mitambo ivumbwe mivumbi ya chilungamo.","poem":2},{"text":"Dziko lapansi litsekuke,","poem":1},{"text":"ndipo chipulumutso chiphuke kuti","poem":2},{"text":"chilungamo chimereponso;","poem":1},{"text":"Ine Yehova, ndine ndalenga zimenezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Tsoka kwa wokangana ndi mlengi wake,","poem":1},{"text":"ngakhale kuti ali ngati phale chabe pakati pa mapale anzake.","poem":2},{"text":"Kodi dongo lingafunse munthu wowumba kuti,","poem":1},{"text":"‘Kodi ukuwumba chiyani?’","poem":2},{"text":"Kodi ntchito yako inganene kuti,","poem":1},{"text":"‘Ulibe luso?’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tsoka kwa wofunsa abambo ake kuti,","poem":1},{"text":"‘Kodi munabereka chiyani?’","poem":2},{"text":"Kapena amayi ake kuti,","poem":1},{"text":"‘Kodi mufuna kubereka chiyani?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Yehova","poem":1},{"text":"Woyerayo wa Israeli, ndiponso Mlengi wake akunena,","poem":2},{"text":"zokhudza zinthu zimene zikubwera ndi izi:","poem":1},{"text":"Kodi iwe ukundifunsa za ana anga,","poem":2},{"lineBreak":true},{"text":"kapena kundilamula pa zokhudza ntchito zanga?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndine amene ndinapanga dziko lapansi","poem":1},{"text":"ndikulenga munthu kuti akhalemo.","poem":2},{"text":"Ine ndi manja anga ndinayalika thambo;","poem":1},{"text":"ndimalamulira zolengedwa zonse za mlengalenga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndine amene ndidzawutsa Koresi kuti chilungamo changa chikwaniritsidwe:","poem":1},{"text":"ndipo ndidzawongolera njira zake zonse.","poem":2},{"text":"Iye adzamanganso mzinda wanga","poem":1},{"text":"ndi kumasula anthu anga amene ali mu ukapolo,","poem":2},{"text":"wopanda kupereka ndalama kapena mphotho,","poem":1},{"text":"akutero Yehova Wamphamvuzonse.”","poem":2}]},{"type":"verse","number":14,"content":["Yehova akuti,",{"text":"“Chuma cha ku Igupto ndi chuma cha malonda cha Kusi chidzakhala chanu.","poem":1},{"text":"Anthu amphamvu zawo ndi athanzi a ku Seba","poem":2},{"text":"adzabwera kwa inu","poem":1},{"text":"ndipo adzakhala anthu anu;","poem":2},{"text":"iwo adzidzakutsatani pambuyo panu","poem":1},{"text":"ali mʼmaunyolo.","poem":2},{"text":"Adzakugwadirani","poem":1},{"text":"ndi kukupemphani, ponena kuti,","poem":2},{"text":"‘Ndithudi Mulungu ali ndi inu, ndipo palibenso wina;","poem":1},{"text":"palibenso mulungu wina.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zoonadi inu muli ndi Mulungu wobisika","poem":1},{"text":"amene ali Mulungu ndi Mpulumutsi wa Israeli.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Onse amene amapanga mafano adzawachititsa manyazi ndi kuwanyozetsa.","poem":1},{"text":"Adzakhala osokonezeka maganizo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Koma Yehova adzapulumutsa Israeli","poem":1},{"text":"ndi chipulumutso chamuyaya;","poem":2},{"text":"simudzachitanso manyazi kapena kunyozeka","poem":1},{"text":"mpaka kalekale.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yehova","poem":1},{"lineBreak":true},{"text":"analenga zinthu zakumwamba,","poem":1},{"text":"Iye ndiye Mulungu;","poem":2},{"text":"amene akulenga dziko lapansi,","poem":1},{"text":"ndi kulikhazikitsa,","poem":2},{"text":"sanalipange kuti likhale lopanda kanthu,","poem":1},{"text":"koma analipanga kuti anthu akhalemo.","poem":2},{"text":"Iyeyu akunena kuti:","poem":1},{"lineBreak":true},{"text":"Ine ndine Yehova,","poem":1},{"text":"ndipo palibenso wina.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ine sindinayankhule mwachinsinsi,","poem":1},{"text":"pamalo ena a mdima;","poem":2},{"text":"Ine sindinaziwuze zidzukulu za Yakobo kuti,","poem":1},{"text":"“Ndifunefuneni ku malo kopanda kanthu.”","poem":2},{"text":"Ine Yehova, ndimayankhula zoona;","poem":1},{"text":"ndikunena zolungama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yehova akuti, “Sonkhanani pamodzi ndipo mubwere;","poem":1},{"text":"yandikirani, inu amene munapulumuka pothawa nkhondo kwa anthu a mitundu ina.","poem":2},{"text":"Ndinu opanda nzeru amene mumanyamula mafano a mitengo,","poem":1},{"text":"amene mumapemphera kwa milungu imene singathe kupulumutsa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Fotokozani mlandu wanu,","poem":1},{"text":"mupatsane nzeru nonse pamodzi.","poem":2},{"text":"Kodi ndani ananeneratu zimenezi kalekale?","poem":1},{"text":"Ndani anazifotokozeratu zimenezi nthawi yamakedzana?","poem":2},{"text":"Kodi si Ineyo Yehova?","poem":1},{"text":"Ndipo palibenso Mulungu wina kupatula Ine,","poem":2},{"text":"Mulungu wolungama ndi Wopulumutsa,","poem":1},{"text":"palibenso wina kupatula Ine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Tembenukirani kwa Ine kuti mupulumuke,","poem":1},{"text":"inu anthu onse a pa dziko lapansi,","poem":2},{"lineBreak":true},{"text":"pakuti Ine ndine Mulungu ndipo palibenso wina.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndalumbira ndekha,","poem":1},{"text":"pakamwa panga patulutsa mawu owona,","poem":2},{"lineBreak":true},{"text":"mawu amene sadzasinthika konse akuti,","poem":2},{"text":"bondo lililonse lidzagwada pamaso panga;","poem":1},{"text":"anthu onse adzalumbira potchula dzina langa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Iwo adzanene kwa Ine kuti,","poem":1},{"text":"‘Chilungamo ndi mphamvu zimapezeka mwa Yehova yekha.’ ”","poem":2},{"text":"Onse amene anamuwukira Iye","poem":1},{"text":"adzabwera kwa Iye ndipo adzachita manyazi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Koma mwa Yehova zidzukulu zonse za Israeli","poem":1},{"text":"zidzapambana ndi kupeza ulemerero.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}