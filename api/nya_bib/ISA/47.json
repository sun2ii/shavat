{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Kugwa kwa Babuloni"]},{"type":"verse","number":1,"content":[{"text":"“Tsika, ndi kukhala pa fumbi,","poem":1},{"text":"iwe namwali, Babuloni;","poem":2},{"text":"khala pansi wopanda mpando waufumu,","poem":1},{"text":"iwe namwali, Kaldeya","poem":2},{"text":"pakuti sadzakutchulanso wanthete kapena woyenera","poem":1},{"text":"kumugwira mosamala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tenga mphero ndipo upere ufa;","poem":1},{"text":"chotsa nsalu yako yophimba nkhope","poem":2},{"text":"kwinya chovala chako mpaka ntchafu","poem":1},{"text":"ndipo woloka mitsinje.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maliseche ako adzakhala poyera","poem":1},{"text":"ndipo udzachita manyazi.","poem":2},{"text":"Ndidzabwezera chilango","poem":1},{"text":"ndipo palibe amene adzandiletse.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Woyerayo wa Israeli ndiye Mpulumutsi wathu,","poem":1},{"text":"dzina lake ndi Yehova Wamphamvuzonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Khala chete, ndipo lowa mu mdima,","poem":1},{"text":"iwe namwali, Kaldeya;","poem":2},{"text":"chifukwa sadzakutchulanso","poem":1},{"text":"mfumukazi ya maufumu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndinawakwiyira anthu anga,","poem":1},{"text":"osawasamalanso.","poem":2},{"text":"Ndinawapereka manja mwako,","poem":1},{"text":"ndipo iwe sunawachitire chifundo.","poem":2},{"text":"Iwe unachitira nkhanza","poem":1},{"text":"ngakhale nkhalamba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iwe unati, ‘Ine ndidzakhalapo nthawi zonse","poem":1},{"text":"ngati mfumukazi.’","poem":2},{"text":"Koma sunaganizire zinthu izi","poem":1},{"text":"kapena kusinkhasinkha za mmene ziti zidzathere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ndipo tsopano, tamvera, iwe wongokonda zokondweretsawe,","poem":1},{"text":"amene ukukhala mosatekesekawe,","poem":2},{"text":"umaganiza mu mtima mwako kuti,","poem":1},{"text":"‘Ine ndi Ine, ndipo kupatula ine palibenso wina.","poem":2},{"text":"Sindidzakhala konse mkazi wamasiye,","poem":1},{"text":"ndipo ana anga sadzamwalira.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Koma mʼkamphindi, ndiponso tsiku limodzi,","poem":1},{"text":"zinthu ziwiri izi zidzakuchitikira:","poem":2},{"lineBreak":true},{"text":"ana ako kukufera komanso kukhala mkazi wamasiye.","poem":2},{"text":"Zimenezi zidzakuchitikira kwathunthu","poem":1},{"text":"ngakhale ali ndi amatsenga ambiri","poem":2},{"lineBreak":true},{"text":"ndi mawula amphamvu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iwe unkadalira kuyipa kwako","poem":1},{"text":"ndipo unati, ‘Palibe amene akundiona.’","poem":2},{"text":"Kuchenjera ndi nzeru zako zidzakusokoneza,","poem":1},{"text":"choncho ukuganiza mu mtima mwako kuti,","poem":2},{"lineBreak":true},{"text":"‘Ine ndine basi, ndipo kupatula ine palibenso wina.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngozi yayikulu idzakugwera","poem":1},{"text":"ndipo sudzadziwa momwe ungayipewere ndi matsenga ako.","poem":2},{"text":"Mavuto adzakugwera","poem":1},{"text":"ndipo sudzatha kuwachotsa;","poem":2},{"text":"chipasupasu chimene iwe sukuchidziwa","poem":1},{"text":"chidzakugwera mwadzidzidzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Pitiriza tsono kukhala ndi matsenga ako,","poem":1},{"text":"pamodzi ndi nyanga zako zochulukazo,","poem":2},{"lineBreak":true},{"text":"wakhala ukuzigwiritsa ntchito kuyambira ubwana wako.","poem":2},{"text":"Mwina udzatha kupambana","poem":1},{"text":"kapena kuopsezera nazo adani ako.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Malangizo onse amene unalandira angokutopetsa basi!","poem":1},{"text":"Abwere patsogolopa anthu amene amatanthauzira za kumwamba kuti adzakupulumutseni.","poem":2},{"text":"Abwere amene amayangʼana nyenyezi, ndi kumalosera mwezi ndi mwezi","poem":1},{"text":"zimene ziti zidzakuchitikire.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndithudi, anthuwo ali ngati phesi;","poem":1},{"text":"adzapsa ndi moto.","poem":2},{"text":"Sangathe kudzipulumutsa okha","poem":1},{"text":"ku mphamvu ya malawi a moto.","poem":2},{"text":"Awa si makala a moto woti wina nʼkuwotha;","poem":1},{"text":"kapena moto woti wina nʼkuwukhalira pafupi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Umu ndi mmene adzachitire amatsenga,","poem":1},{"text":"anthu amene wakhala ukugwira nawo ntchito","poem":2},{"lineBreak":true},{"text":"ndi kuchita nawo malonda chiyambire cha ubwana wako.","poem":2},{"text":"Onse adzamwazika ndi mantha,","poem":1},{"text":"sipadzakhala ndi mmodzi yemwe wokupulumutsa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}