{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["Israeli ndi Nkhutukumve"]},{"type":"verse","number":1,"content":[{"text":"“Mverani izi, inu nyumba ya Yakobo,","poem":1},{"text":"inu amene amakutchani dzina lanu Israeli,","poem":2},{"lineBreak":true},{"text":"ndinu a fuko la Yuda,","poem":2},{"text":"inu mumalumbira mʼdzina la Yehova,","poem":1},{"text":"ndi kupemphera kwa Mulungu wa Israeli,","poem":2},{"lineBreak":true},{"text":"ngakhale osati mʼchoonadi kapena mʼchilungamo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Komabe inu mumadzitcha nzika za mzinda wopatulika","poem":1},{"text":"ndipo mumadalira Mulungu wa Israeli,","poem":2},{"lineBreak":true},{"text":"amene dzina lake ndi Yehova Wamphamvuzonse:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zimene zinachitika poyamba ndinalosera kalekale,","poem":1},{"text":"zinatuluka mʼkamwa mwanga ndipo ndinazilengeza;","poem":2},{"lineBreak":true},{"text":"tsono mwadzidzidzi ndinachitapo kanthu ndipo zinachitikadi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pakuti Ine ndinadziwa kuti iwe ndiwe nkhutukumve","poem":1},{"text":"wa nkhongo gwaa,","poem":2},{"lineBreak":true},{"text":"wa mutu wowuma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ine ndinakuwuziratu zinthu izi kalekale lomwe;","poem":1},{"text":"zisanachitike ndinazilengezeratu kwa iwe","poem":2},{"text":"kuti unganene kuti,","poem":1},{"text":"‘Fano langa ndilo lachita zimenezi,","poem":2},{"lineBreak":true},{"text":"kapena kuti fano langa losema ndi kamulungu kanga kachitsulo ndiwo analamula kuti zimenezi zichitike.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inu munamva zinthu zimenezi.","poem":1},{"text":"Kodi inu simungazivomereze?","poem":2},{"lineBreak":true},{"text":"“Kuyambira tsopano mpaka mʼtsogolo ndidzakuwuzani zinthu zatsopano","poem":1},{"text":"zinthu zobisika zimene simunazidziwe konse.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zinthu zimenezi zikulengedwa tsopano lino, osati kalekale;","poem":1},{"text":"munali musanazimve mpaka lero lino.","poem":2},{"text":"Choncho inu simunganene kuti,","poem":1},{"text":"‘Zimenezi ndiye ayi, ndinazidziwa kale.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inu simunazimvepo kapena kuzidziwa;","poem":1},{"text":"makutu anu sanali otsekuka.","poem":2},{"text":"Tsono Ine ndinadziwa bwino kuti ndinu anthu achiwembu ndi kuti","poem":1},{"text":"chiyambire ubwana wanu munatchedwa owukira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ine ndikuchedwetsa mkwiyo wanga chifukwa cha dzina langa.","poem":1},{"text":"Ndikukulezerani ukali wanga kuti anthu andilemekeze.","poem":2},{"lineBreak":true},{"text":"Sindidzakuwonongani kotheratu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taonani, ndinakuyeretsani ngati siliva;","poem":1},{"text":"ndinakuyesani mʼngʼanjo yamasautso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Chifukwa cha ulemu wanga, chifukwa cha ulemu wanga Ine ndikuchita zimenezi.","poem":1},{"text":"Ndingalole bwanji kuti ndinyozeke?","poem":2},{"lineBreak":true},{"text":"Ulemerero wanga sindidzawupereka kwa wina.","poem":2}]},{"type":"heading","content":["Kumasulidwa kwa Israeli"]},{"type":"verse","number":12,"content":[{"text":"“Tamvera Ine, iwe Yakobo,","poem":1},{"text":"Israeli, amene ndinakuyitana:","poem":2},{"text":"Mulungu uja Woyamba","poem":1},{"text":"ndi Wotsiriza ndine.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inde dzanja langa linamanga maziko a dziko lapansi,","poem":1},{"text":"dzanja langa lamanja linafunyulula mlengalenga.","poem":2},{"text":"Ndi mawu anga ndinalenga kumwamba","poem":1},{"text":"ndi dziko lapansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Sonkhanani pamodzi inu nonse ndipo mvetserani:","poem":1},{"text":"Ndani mwa mafano anu amene analoseratu za zinthu izi?","poem":2},{"text":"Wokondedwa wa Yehova uja adzachita","poem":1},{"text":"zomwe Iye anakonzera Babuloni;","poem":2},{"lineBreak":true},{"text":"dzanja lake lidzalimbana ndi Kaldeya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ine, Inetu, ndayankhula;","poem":1},{"text":"ndi kumuyitana","poem":2},{"text":"ndidzamubweretsa ndine","poem":1},{"text":"ndipo adzakwaniritsa zolinga zake.","poem":2}]},{"type":"verse","number":16,"content":["“Bwerani pafupi ndipo mvetserani izi:",{"text":"“Kuyambira pachiyambi sindinayankhule mobisa;","poem":1},{"text":"pa nthawi imene zinkachitika zimenezi Ine ndinali pomwepo.”","poem":2},{"lineBreak":true},{"text":"Ndipo tsopano Ambuye Yehova wandipatsa Mzimu wake","poem":1},{"text":"ndi kundituma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yehova, Mpulumutsi wanu,","poem":1},{"text":"Woyerayo wa Israeli akuti,","poem":2},{"text":"“Ine ndine Yehova Mulungu wanu,","poem":1},{"text":"amene ndimakuphunzitsa kuti upindule,","poem":2},{"lineBreak":true},{"text":"ndimakutsogolera pa njira yoyenera kuyitsata.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngati iwe ukanangosamalira zolamulira zanga,","poem":1},{"text":"bwenzi mtendere wako ukanakhala ngati mtsinje,","poem":2},{"lineBreak":true},{"text":"ndi chipulumutso chako ngati mafunde a pa nyanja.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zidzukulu zako zikanachuluka ngati mchenga,","poem":1},{"text":"ana ako akanachuluka ngati fumbi;","poem":2},{"text":"dzina lawo silikanachotsedwa pamaso panga","poem":1},{"text":"ndipo silikanafafanizidwa konse.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tulukani mʼdziko la Babuloni!","poem":1},{"text":"Thawani dziko la Kaldeya!","poem":2},{"text":"Lengezani zimenezi ndi mawu a chisangalalo","poem":1},{"text":"ndipo muzilalikire","poem":2},{"text":"mpaka kumathero a dziko lapansi;","poem":1},{"text":"muzinena kuti, “Yehova wawombola Yakobo mtumiki wake.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iwo sanamve ludzu pamene Yehova ankawatsogolera mʼchipululu;","poem":1},{"text":"anawapatsa madzi otuluka mʼthanthwe;","poem":2},{"text":"anangʼamba thanthwelo ndipo","poem":1},{"text":"munatuluka madzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Palibe mtendere kwa anthu ochimwa,” akutero Yehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}