{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["Mtumiki wa Yehova"]},{"type":"verse","number":1,"content":[{"text":"Mverani Ine, inu anthu a pa zilumba","poem":1},{"text":"tcherani khutu, inu anthu a mayiko akutali:","poem":2},{"text":"Yehova anandiyitana ine ndisanabadwe,","poem":1},{"text":"ananditchula dzina ndili mʼmimba ya amayi anga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iye anasandutsa pakamwa panga kukhala ngati lupanga lakuthwa,","poem":1},{"text":"anandibisa mu mthunzi wa dzanja lake;","poem":2},{"text":"Iye anandisandutsa ngati muvi wakuthwa","poem":1},{"text":"ndipo anandibisa mʼchimake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iye anati kwa ine, “Ndiwe mtumiki wanga, Israeli.","poem":1},{"text":"Anthu adzanditamanda chifukwa cha iwe.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Koma Ine ndinati, “Ine ndinkaganiza kuti ndinagwira ntchito","poem":1},{"text":"ndi kuwononga mphamvu zanga pachabe,","poem":2},{"text":"koma ayi, zondiyenera zili mʼmanja a Yehova,","poem":1},{"text":"ndipo mphotho yanga ili mʼmanja mwa Mulungu wanga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yehova anandiwumba ine","poem":1},{"text":"mʼmimba mwa amayi anga kuti ndikhale mtumiki wake","poem":2},{"text":"kuti ndibweze fuko la Yakobo kwa Iye","poem":1},{"text":"ndi kusonkhanitsa Israeli kwa Iye,","poem":2},{"text":"choncho ndimalemekezeka mʼmaso mwa Yehova,","poem":1},{"text":"ndipo ndimapeza mphamvu mwa Mulungu wanga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yehovayo tsono akuti,","poem":1},{"lineBreak":true},{"text":"“Nʼchinthu chochepa kwambiri kwa iwe kuti ukhale mtumiki wanga,","poem":1},{"text":"kuti udzutse mafuko a Yakobo","poem":2},{"lineBreak":true},{"text":"ndi kuwabweretsa kwawo Aisraeli amene anapulumuka.","poem":2},{"text":"Choncho iwe udzakhala ngati chowunikira,","poem":1},{"text":"udzafikitsa uthenga wa chipulumutso changa ku mathero a dziko lapansi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yehova Mpulumutsi ndi Woyerayo wa Israeli akuyankhula,","poem":1},{"text":"Woyerayo wa Israeli akunena,","poem":2},{"text":"amene mitundu ya anthu inamuda,","poem":1},{"text":"amenenso anali kapolo wa mafumu ankhanza uja kuti,","poem":2},{"text":"“Mafumu adzaona ntchito ya chipulumutso changa ndipo adzayimirira.","poem":1},{"text":"Akalonga nawonso adzagwada pansi.","poem":2},{"text":"Zimenezi zidzachitika chifukwa cha Yehova amene ndi wokhulupirika","poem":1},{"text":"ndi Woyerayo wa Israeli amene wakusankha iwe.”","poem":2}]},{"type":"heading","content":["Kubwezeretsedwa kwa Israeli"]},{"type":"verse","number":8,"content":["Yehova akuti,",{"text":"“Pa nthawi imene ndinakukomera mtima ndinakuyankha,","poem":1},{"text":"ndipo pa tsiku lachipulumutso ndinakuthandiza;","poem":2},{"text":"ndinakusunga ndi kukusandutsa","poem":1},{"text":"kuti ukhale pangano kwa anthu,","poem":2},{"text":"kuti dziko libwerere mwakale","poem":1},{"text":"ndi kuti cholowa changa chowonongeka chija ndichigawegawenso.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndidzawuza a mʼndende kuti atuluke","poem":1},{"text":"ndi a mu mdima kuti aonekere poyera.","poem":2},{"lineBreak":true},{"text":"“Adzapeza chakudya mʼmphepete mwa njira","poem":1},{"text":"ndi msipu pa mʼmalo owuma.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iwo sadzamva njala kapena ludzu,","poem":1},{"text":"kutentha kwa mʼchipululu kapena dzuwa silidzawapsereza;","poem":2},{"text":"chifukwa Iye amene amawachitira chifundo adzawatsogolera","poem":1},{"text":"ndi kuwaperekeza ku akasupe a madzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mapiri anga onse ndidzawasandutsa njira yoyendamo,","poem":1},{"text":"ndipo misewu yanga yayikulu ndidzayikweza.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taonani, anthu anga adzachokera kutali,","poem":1},{"text":"ena kumpoto, ena kumadzulo,","poem":2},{"lineBreak":true},{"text":"enanso adzachokera ku chigawo cha Asuwani.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Imbani mwachimwemwe, inu zolengedwa zamlengalenga;","poem":1},{"text":"kondwera, iwe dziko lapansi;","poem":2},{"lineBreak":true},{"text":"imbani nyimbo inu mapiri!","poem":2},{"text":"Pakuti Yehova watonthoza mtima anthu ake,","poem":1},{"text":"ndipo wachitira chifundo anthu ake ovutika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Koma Ziyoni anati, “Yehova wandisiya,","poem":1},{"text":"Ambuye wandiyiwala.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Kodi amayi angathe kuyiwala mwana wawo wakubere","poem":1},{"text":"ndi kusachitira chifundo mwana amene anabereka iwo eni?","poem":2},{"text":"Ngakhale iye angathe kuyiwala,","poem":1},{"text":"Ine sindidzakuyiwala iwe!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taona, ndakulemba iwe mʼzikhantho zanga;","poem":1},{"text":"makoma ako ndimawaona nthawi zonse.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Amisiri odzakumanganso akubwerera mofulumira,","poem":1},{"text":"ndipo amene anakupasula akuchokapo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kweza maso ako ndipo uyangʼaneyangʼane","poem":1},{"text":"ana ako onse akusonkhana ndipo akubwera kwa iwe.","poem":2},{"text":"Yehova akuti, ‘Ine Yehova wamoyo,","poem":1},{"text":"anthu ako adzakhala ngati chinthu chodzikongoletsa","poem":2},{"lineBreak":true},{"text":"chimene mkwatibwi wavala pa mkono pake.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ngakhale unasanduka bwinja ndi kuwonongedwa","poem":1},{"text":"ndipo dziko lako ndi kusakazidwa,","poem":2},{"text":"chifukwa cha kuchuluka kwa anthu malo okhalamo adzakhala operewera","poem":1},{"text":"ndipo amene anakuwononga iwe aja adzakhala kutali.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ana obadwa nthawi yako yachisoni","poem":1},{"text":"adzanena kuti,","poem":2},{"text":"‘Malo ano atichepera,","poem":1},{"text":"tipatse malo ena woti tikhalemo.’","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tsono iwe udzadzifunsa kuti,","poem":1},{"text":"‘Kodi ndani anandiberekera ana amenewa?","poem":2},{"text":"Ana anga onse anamwalira ndipo sindinathenso kukhala ndi ana ena;","poem":1},{"text":"ndinapita ku ukapolo ndipo ndinachotsedwa.","poem":2},{"lineBreak":true},{"text":"Ndani anawalera ana amenewa?","poem":2},{"text":"Ndinatsala ndekha,","poem":1},{"text":"nanga awa, achokera kuti?’ ”","poem":2}]},{"type":"verse","number":22,"content":["Zimene Ambuye Yehova akunena ndi izi,",{"text":"“Taonani, Ine ndidzakodola Anthu a mitundu ina kuti abwere.","poem":1},{"text":"Ndidzawakwezera anthu a mitundu ina mbendera yanga kuti abwere.","poem":2},{"text":"Tsono adzabwera ndi ana ako aamuna atawanyamula mʼmanja mwawo","poem":1},{"text":"ndipo adzanyamula ana ako aakazi pa mapewa awo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mafumu adzakhala abambo wongokulera","poem":1},{"text":"ndipo akazi a mafumu adzakhala amayi wongokulera.","poem":2},{"text":"Iwo adzagwetsa nkhope","poem":1},{"text":"zawo pansi.","poem":2},{"text":"Ndiye inu mudzazindikira kuti Ine ndine Yehova;","poem":1},{"text":"iwo amene amadalira Ine sadzakhumudwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kodi mungathe kulanda anthu ankhondo zofunkha zawo,","poem":1},{"text":"kapena kupulumutsa anthu ogwidwa mʼdzanja la munthu wankhanza?","poem":2}]},{"type":"verse","number":25,"content":["Koma zimene Yehova akunena ndi izi,",{"text":"“Ankhondo adzawalanda amʼndende awo,","poem":1},{"text":"ndipo munthu woopsa adzamulanda zofunkha zawo;","poem":2},{"text":"ndidzalimbana ndi amene amalimbana nanu,","poem":1},{"text":"ndipo ndidzapulumutsa ana anu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Anthu amene anakuponderezani adzadya mnofu wawo omwe;","poem":1},{"text":"adzamwa magazi awo omwe ngati aledzera ndi vinyo.","poem":2},{"text":"Zikadzatero anthu onse adzadziwa","poem":1},{"text":"kuti Ine Yehova, ndine Mpulumutsi wanu,","poem":2},{"lineBreak":true},{"text":"Momboli wanu, Wamphamvu wa Yakobo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}