{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["Tchimo la Israeli, Kumvera kwa Mtumiki"]},{"type":"verse","number":1,"content":["Yehova akuti,",{"text":"“Kalata imene ndinasudzulira amayi","poem":1},{"text":"anu ili kuti?","poem":2},{"text":"Kapena mwa anthu amene ndili nawo ngongole,","poem":1},{"text":"ndinakugulitsani kwa ati?","poem":2},{"text":"Inu munagulitsidwa ku ukapolo chifukwa cha machimo anu;","poem":1},{"text":"amayi anu anachotsedwa chifukwa cha kulakwa kwanu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nʼchifukwa chiyani pamene ndinabwera kudzakupulumutsani panalibe munthu?","poem":1},{"text":"Pamene ndinayitana, nʼchifukwa chiyani panalibe wondiyankha?","poem":2},{"text":"Kodi dzanja langa ndi lalifupi kuti nʼkulephera kukuwombolani?","poem":1},{"text":"Kodi ndilibe mphamvu zokupulumutsirani?","poem":2},{"text":"Ndi kudzudzula kokha ndinawumitsa nyanja yayikulu,","poem":1},{"text":"mitsinje ndinayisandutsa chipululu;","poem":2},{"text":"nsomba za mʼmenemo zinawola chifukwa chosowa madzi;","poem":1},{"text":"ndipo zinafa ndi ludzu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndinaphimba thambo ndi mdima","poem":1},{"text":"ndipo chiguduli chinakhala chofunda chake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ambuye Yehova anandiphunzitsa mawu oyenera kuyankhula","poem":1},{"text":"kudziwa mawu olimbitsa mtima anthu ofowoka.","poem":2},{"text":"Mmawa mulimonse amandidzutsa,","poem":1},{"text":"amathwetsa khutu langa kuti ndimve monga amachitira munthu amene akuphunzira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ambuye Yehova wanditsekula makutu anga,","poem":1},{"text":"ndipo sindinakhale munthu wowukira","poem":2},{"lineBreak":true},{"text":"ndipo sindinabwerere mʼmbuyo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndinapereka msana wanga kwa ondimenya","poem":1},{"text":"masaya anga ndinawapereka kwa anthu ondizula ndevu;","poem":2},{"text":"sindinawabisire nkhope yanga","poem":1},{"text":"anthu ondinyoza ndi ondilavulira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Popeza Ambuye Yehova amandithandiza,","poem":1},{"text":"sindidzachita manyazi.","poem":2},{"text":"Tsono ndalimba mtima ngati msangalabwi,","poem":1},{"text":"chifukwa ndikudziwa kuti sindidzachita manyazi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wondikhalira kumbuyo ali pafupi,","poem":1},{"text":"ndaninso amene adzandiyimba mlandu?","poem":2},{"lineBreak":true},{"text":"Abwere kuti tionane maso ndi maso!","poem":2},{"text":"Mdani wanga ndi ndani?","poem":1},{"text":"Abweretu kuti tilimbane!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ambuye Yehova ndiye amene amandithandiza.","poem":1},{"text":"Ndaninso amene adzanditsutsa?","poem":2},{"text":"Onse adzatha ngati chovala","poem":1},{"text":"chodyedwa ndi njenjete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndani mwa inu amaopa Yehova","poem":1},{"text":"ndi kumvera mawu a mtumiki wake?","poem":2},{"text":"Aliyense woyenda mu mdima,","poem":1},{"text":"popanda chomuwunikira,","poem":2},{"text":"iye akhulupirire dzina la Yehova","poem":1},{"text":"ndi kudalira Mulungu wake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Koma tsopano inu nonse amene mumasonkha moto","poem":1},{"text":"ndi kuyatsa sakali za moto kufuna kuwononga anzanu,","poem":2},{"text":"lowani mʼmoto wanu womwewo.","poem":1},{"text":"Pitani mu sakali za moto zimene mwayatsa.","poem":2},{"text":"Ndipo ine Yehova","poem":1},{"text":"ndiye amene ndidzakugwetsereni mazunzowo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}