{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Chipulumutso Chamuyaya cha Ziyoni"]},{"type":"verse","number":1,"content":[{"text":"“Mverani Ine, inu amene mukufuna chipulumutso","poem":1},{"text":"ndiponso amene mumafunafuna Yehova:","poem":2},{"text":"Taganizani za thanthwe kumene munasemedwa","poem":1},{"text":"ndipo ku ngwenya kumene anakukumbani;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"taganizani za Abrahamu, kholo lanu,","poem":1},{"text":"ndi Sara, amene anakubalani.","poem":2},{"text":"Pamene ndinkamuyitana nʼkuti alibe mwana,","poem":1},{"text":"koma ndinamudalitsa ndi kumupatsa ana ambiri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yehova adzatonthozadi Ziyoni,","poem":1},{"text":"ndipo adzachitira chifundo mabwinja ake onse;","poem":2},{"text":"Dziko lake la chipululu adzalisandutsa ngati Edeni,","poem":1},{"text":"malo ake owuma ngati munda wa Yehova.","poem":2},{"text":"Anthu adzayimba nyimbo zonditamanda","poem":1},{"text":"ndi kundiyamika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mverani Ine, anthu anga:","poem":1},{"text":"tcherani khutu, inu mtundu wanga:","poem":2},{"text":"malangizo adzachokera kwa Ine;","poem":1},{"text":"cholungama changa chidzawunikira anthu a mitundu yonse.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndili pafupi kubwera kudzawombola anthu anga.","poem":1},{"text":"Ndidzabwera mofulumira ngati kuwunika kudzapulumutsa anthu anga;","poem":2},{"lineBreak":true},{"text":"ndipo ndidzalamulira anthu a mitundu yonse.","poem":2},{"text":"Mayiko akutali akundiyembekezera.","poem":1},{"text":"Iwo akudikira kuti ndidzawapulumutse.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwezani maso anu mlengalenga,","poem":1},{"text":"yangʼanani pansi pa dziko;","poem":2},{"text":"mlengalenga udzazimirira ngati utsi,","poem":1},{"text":"dziko lapansi lidzatha ngati chovala","poem":2},{"lineBreak":true},{"text":"ndipo anthu ake adzafa ngati nsabwe.","poem":2},{"text":"Koma chipulumutso changa chidzakhala mpaka muyaya,","poem":1},{"text":"chilungamo changa chidzakhala cha nthawi zonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Mverani Ine, inu amene mukudziwa choonadi,","poem":1},{"text":"anthu inu amene mukusunga malangizo anga mʼmitima yanu;","poem":2},{"text":"musaope kudzudzulidwa ndi anthu","poem":1},{"text":"kapena kuopsezedwa akamakulalatirani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pakuti njenjete idzawadya ngati chovala;","poem":1},{"text":"mbozi idzawadya ngati thonje.","poem":2},{"text":"Koma chilungamo changa chidzakhala mpaka muyaya,","poem":1},{"text":"chipulumutso changa chidzakhala mpaka mibadomibado.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dzambatukani, dzambatukani! Valani zilimbe,","poem":1},{"text":"Inu Yehova;","poem":2},{"text":"dzambatukani, monga munkachitira masiku amakedzana,","poem":1},{"text":"monga nthawi ya mibado yakale.","poem":2},{"text":"Si ndinu kodi amene munaduladula Rahabe,","poem":1},{"text":"amene munabaya chinjoka cha mʼnyanja chija?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodi sindinu amene munawumitsa nyanja yayikulu,","poem":1},{"text":"madzi ozama kwambiri aja?","poem":2},{"text":"Kodi sindinu amene munapanga njira pa madzi ozama,","poem":1},{"text":"kuti anthu amene munawapulumutsa awoloke powuma?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anthu amene Yehova anawawombola adzabwerera","poem":1},{"text":"nakafika ku Ziyoni nyimbo ili pakamwa;","poem":2},{"lineBreak":true},{"text":"chimwemwe chamuyaya chizidzaonekera pa nkhope zawo.","poem":2},{"text":"Adzakhala ndi chikondwerero ndi chimwemwe,","poem":1},{"text":"chisoni ndi kubuwula zidzathawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yehova akuti, “Ndinetu amene ndimakutonthozani mtima.","poem":1},{"text":"Chifukwa chiyani mukuopa munthu woti adzafa?","poem":2},{"lineBreak":true},{"text":"Mukuopa munthu woti monga udzu sadzakhalitsa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Koma inu mumayiwala Yehova Mlengi wanu,","poem":1},{"text":"amene anayala za mlengalenga","poem":2},{"lineBreak":true},{"text":"ndi kuyika maziko a dziko lapansi.","poem":2},{"text":"Inu nthawi zonse mumaopsezedwa","poem":1},{"text":"chifukwa cha ukali wa anthu okuponderezani","poem":2},{"lineBreak":true},{"text":"amene angofuna kukuwonongani.","poem":2},{"text":"Kodi uli kuti tsopano ukali wa anthu okuponderezaniwo?","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Amʼndende adzamasulidwa posachedwa;","poem":2},{"text":"sadzalowa mʼmanda awo,","poem":1},{"text":"kapena kusowa chakudya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pakuti Ine ndine Yehova Mulungu wanu,","poem":1},{"text":"amene ndimavundula nyanja kotero mafunde ake amakokoma.","poem":2},{"lineBreak":true},{"text":"Dzina lake ndi Yehova Wamphamvuzonse.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndayika mawu anga mʼkamwa mwanu","poem":1},{"text":"ndipo ndakuphimbani ndi mthunzi wa dzanja langa.","poem":2},{"text":"Ine ndimayika pa malo pake zinthu za mlengalenga,","poem":1},{"text":"ndipo ndinayika maziko a dziko lapansi,","poem":2},{"lineBreak":true},{"text":"ndimawuza anthu a ku Ziyoni kuti, ‘Ndinu anthu anga.’ ”","poem":2}]},{"type":"heading","content":["Kutha kwa Mavuto A Yerusalemu"]},{"type":"verse","number":17,"content":[{"text":"Dzambatuka, dzambatuka!","poem":1},{"text":"Imirira iwe Yerusalemu.","poem":2},{"text":"Iwe amene wamwa chikho cha mkwiyo","poem":1},{"text":"chimene Yehova anakupatsa.","poem":2},{"text":"Iwe amene unagugudiza","poem":1},{"text":"chikho chochititsa chizwezwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mwa ana onse amene anabereka,","poem":1},{"text":"panalibe ndi mmodzi yemwe anamutsogolera;","poem":2},{"text":"mwa ana onse amene analera,","poem":1},{"text":"panalibe ndi mmodzi yemwe anamugwira dzanja.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mavuto awiriwa akugwera iwe.","poem":1},{"text":"Dziko lako lasakazika ndi kuwonongeka. Anthu afa ndi njala ndi lupanga.","poem":2},{"text":"Ndani angakumvere chisoni?","poem":1},{"text":"Ndani angakutonthoze?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ana ako akomoka;","poem":1},{"text":"ali lambalamba pa msewu,","poem":2},{"lineBreak":true},{"text":"ngati mphoyo yogwidwa mu ukonde.","poem":2},{"text":"Ukali wa Yehova","poem":1},{"text":"ndi chidzudzulo chake zidzawagwera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Nʼchifukwa chake imva izi iwe amene ukuvutika,","poem":1},{"text":"iwe amene waledzera, koma osati ndi vinyo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ambuye Yehova wanu,","poem":1},{"text":"Mulungu amene amateteza anthu ake akuti,","poem":2},{"text":"“Taona, ndachotsa mʼdzanja lako","poem":1},{"text":"chikho chimene chimakuchititsa kudzandira;","poem":2},{"text":"sudzamwanso chikho","poem":1},{"text":"cha ukali wanga.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndidzapereka chikhocho kwa anthu amene amakuzunza,","poem":1},{"text":"amene ankakuwuza kuti,","poem":2},{"lineBreak":true},{"text":"‘gona pansi tikuyende pa msana.’","poem":2},{"text":"Ndipo msana wako anawuyesa pansi popondapo,","poem":1},{"text":"ngati msewu woti ayendepo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}