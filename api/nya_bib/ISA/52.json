{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Dzambatuka, dzambatuka iwe Ziyoni,","poem":1},{"text":"vala zilimbe.","poem":2},{"text":"Vala zovala zako zokongola,","poem":1},{"text":"iwe Yerusalemu, mzinda wopatulika.","poem":2},{"text":"Pakuti kuyambira tsopano anthu osachita mdulidwe ndi odetsedwa","poem":1},{"text":"sadzalowanso pa zipata zako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sasa fumbi lako;","poem":1},{"text":"imirira nukhale pa mpando waufumu, iwe Yerusalemu.","poem":2},{"text":"Inu omangidwa a ku Ziyoni,","poem":1},{"text":"masulani maunyolo amene ali mʼkhosi mwanumo.","poem":2}]},{"type":"verse","number":3,"content":["Pakuti Yehova akuti,",{"text":"“Sindinalandirepo kanthu pamene ndinakugulitsani,","poem":1},{"text":"choncho mudzawomboledwa wopanda ndalama.”","poem":2}]},{"type":"verse","number":4,"content":["Pakuti Ambuye Yehova akuti,",{"text":"“Poyamba paja anthu anga anapita kukakhala ku Igupto;","poem":1},{"text":"nawonso Asiriya awapondereza popanda chifukwa.”","poem":2}]},{"type":"verse","number":5,"content":["Tsopano Ine Yehova ndikuti,",{"text":"“Kodi nditani pakuti anthu anga atengedwa ukapolo osaperekapo kanthu,","poem":1},{"text":"amene amawalamulira amawanyoza,”","poem":2},{"text":"akutero Yehova.","poem":4},{"text":"“Ndipo tsiku lonse, akungokhalira","poem":1},{"text":"kuchita chipongwe dzina langa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsono tsiku limenelo anthu anga adzadziwa dzina langa;","poem":1},{"text":"kotero adzadziwa","poem":2},{"text":"kuti ndi Ine amene ndikuyankhula,","poem":1},{"text":"Indedi, ndine.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngokongoladi mapazi a","poem":1},{"text":"amithenga obweretsa nkhani yabwino amene akuyenda pa mapiri.","poem":2},{"text":"Iwo akukubweretserani nkhani zabwino za mtendere,","poem":1},{"text":"chisangalalo ndi chipulumutso.","poem":2},{"lineBreak":true},{"text":"Iwo akubwera kudzawuza anthu","poem":2},{"text":"a ku Ziyoni kuti,","poem":1},{"text":"“Mulungu wako ndi mfumu!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mverani! Alonda anu akukweza mawu awo;","poem":1},{"text":"akuyimba pamodzi mwachimwemwe.","poem":2},{"text":"Popeza akuona chamaso","poem":1},{"text":"kubwera kwa Yehova ku Yerusalemu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Imbani pamodzi mofuwula nyimbo zachimwemwe,","poem":1},{"text":"inu mabwinja a Yerusalemu,","poem":2},{"text":"pakuti Yehova watonthoza mtima anthu ake,","poem":1},{"text":"wapulumutsa Yerusalemu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yehova wagwiritsa ntchito mphamvu zake zopatulika","poem":1},{"text":"pamaso pa anthu a mitundu yonse,","poem":2},{"text":"ndipo anthu onse a dziko lapansi","poem":1},{"text":"adzaona chipulumutso cha Mulungu wathu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nyamukani, nyamukani, chokaniko ku Babuloniko!","poem":1},{"text":"Musakhudze kanthu kodetsedwa!","poem":2},{"text":"Inu amene mumanyamula ziwiya za Yehova","poem":1},{"text":"tulukanimo ndipo mudziyeretse.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Koma simudzachoka mofulumira","poem":1},{"text":"kapena kuchita chothawa;","poem":2},{"text":"pakuti Yehova adzayenda patsogolo panu,","poem":1},{"text":"Mulungu wa Israeli adzakutetezani kumbuyo kwanu.","poem":2}]},{"type":"heading","content":["Kuzunzika ndi Ulemerero wa Mtumiki"]},{"type":"verse","number":13,"content":[{"text":"Taonani, mtumiki wanga adzapambana pa ntchito yake","poem":1},{"text":"adzakwezedwa ndi kulemekezedwa ndipo adzalandira ulemu waukulu kwambiri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anthu ambiri atamuona anadzidzimuka,","poem":1},{"text":"chifukwa nkhope yake inali itasakazika; sinalinso ngati ya munthu.","poem":2},{"lineBreak":true},{"text":"Ndipo thupi lake linasakazika; silinalinso ngati la munthu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Momwemonso anthu a mitundu yonse adzadodoma naye,","poem":1},{"text":"ndipo mafumu adzatseka pakamwa pawo kusowa chonena chifukwa cha iye.","poem":2},{"text":"Pakuti zinthu zimene iwo sanawuzidwepo, adzaziona,","poem":1},{"text":"ndipo zimene sanazimvepo, adzazimvetsa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}