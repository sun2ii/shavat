{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["Ulemerero Wamʼtsogolo wa Ziyoni"]},{"type":"verse","number":1,"content":[{"text":"“Sangalala, iwe mayi wosabala,","poem":1},{"text":"iwe amene sunabalepo mwana;","poem":2},{"text":"imba nyimbo, ndi kufuwula mwachimwemwe,","poem":1},{"text":"iwe amene sunamvepo ululu wa pobereka;","poem":2},{"text":"chifukwa mkazi wosiyidwa adzakhala ndi ana ambiri","poem":1},{"text":"kuposa mkazi wokwatiwa,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Kulitsa malo omangapo tenti yako,","poem":1},{"text":"tambasula kwambiri nsalu zake,","poem":2},{"lineBreak":true},{"text":"usaleke;","poem":2},{"text":"talikitsa zingwe zako,","poem":1},{"text":"limbitsa zikhomo zako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pakuti udzasendeza malire ako kumanja ndi kumanzere;","poem":1},{"text":"ndipo zidzukulu zako zidzalanda dziko la anthu a mitundu ina","poem":2},{"lineBreak":true},{"text":"ndipo zidzakhala mʼmizinda yawo yosiyidwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Usachite mantha; sadzakunyozanso.","poem":1},{"text":"Usakhumudwe; sudzapeputsidwanso.","poem":2},{"text":"Udzayiwala za manyazi zimene zinakuchitikira nthawi ya unyamata wako","poem":1},{"text":"ndipo za manyazi zimene zinakuchitikira pa nthawi ya umasiye wako sudzazikumbukanso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pakuti Mlengi wako ali ngati mwamuna wako,","poem":1},{"text":"dzina lake ndi Yehova Wamphamvuzonse.","poem":2},{"text":"Woyerayo wa Israeli ndiye Mpulumutsi wanu;","poem":1},{"text":"dzina lake ndi Mulungu wa dziko lonse lapansi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yehova wakuyitananso,","poem":1},{"text":"uli ngati mkazi wosiyidwa ndi wodzaza ndi chisoni mu mtima,","poem":2},{"text":"mkazi amene anakwatiwa pa unyamata wake kenaka nʼkukanidwa,”","poem":1},{"text":"akutero Mulungu wako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Kwa kanthawi kochepa, Ine ndinakusiya,","poem":1},{"text":"koma ndidzakutenganso chifukwa ndimakukonda kwambiri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndinakufulatira kwa kanthawi kochepa","poem":1},{"text":"ndili wokwiya kwambiri.","poem":2},{"text":"Koma ndi kukoma mtima kwanga kwa muyaya,","poem":1},{"text":"ndidzakuchitira chifundo,”","poem":2},{"lineBreak":true},{"text":"akutero Yehova Mpulumutsi wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kwa ine zimenezi zili ngati mmene zinalili mʼnthawi ya Nowa.","poem":1},{"text":"Monga ndinalumbira nthawi imeneyo kuti sindidzawononganso dziko lapansi ndi madzi.","poem":2},{"text":"Kotero tsopano ndalumbira kuti sindidzakupseraninso mtima,","poem":1},{"text":"sindidzakudzudzulaninso.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngakhale mapiri atagwedezeka","poem":1},{"text":"ndi zitunda kusunthidwa,","poem":2},{"text":"koma chikondi changa chosasinthika pa iwe sichidzatha.","poem":1},{"text":"Pangano langa lamtendere silidzasintha,”","poem":2},{"lineBreak":true},{"text":"akutero Yehova amene amakuchitira chifundo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Iwe mzinda wozunzika, wokunthidwa ndi namondwe ndiponso wopanda wokutonthoza,","poem":1},{"text":"Ine ndidzakongoletsa miyala yako.","poem":2},{"lineBreak":true},{"text":"Maziko ako ndidzamanga ndi miyala ya safiro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndidzamanga nsanja zako zankhondo ndi miyala yokongola ya rubi.","poem":1},{"text":"Ndidzamanga zipata zako ndi miyala yonyezimira ngati moto,","poem":2},{"lineBreak":true},{"text":"ndipo linga lako lonse lidzakhala la miyala yamtengowapatali.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yehova adzaphunzitsa ana ako onse,","poem":1},{"text":"ndipo ana ako adzakhala ndi mtendere wochuluka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Udzakhazikika mʼchilungamo chenicheni:","poem":1},{"lineBreak":true},{"text":"Sudzakhalanso wopanikizika,","poem":1},{"text":"chifukwa sudzaopa kanthu kalikonse.","poem":2},{"text":"Sudzakhalanso ndi mantha","poem":1},{"text":"chifukwa manthawo sadzafika pafupi ndi iwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngati wina adzakuthirani nkhondo, si ndine amene ndachititsa;","poem":1},{"text":"aliyense amene adzalimbana nanu adzagonja chifukwa cha iwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Taona, ndi Ine amene ndinalenga munthu wosula zitsulo","poem":1},{"text":"amene amakoleza moto wamakala","poem":2},{"lineBreak":true},{"text":"ndi kusula zida zoti azigwiritse ntchito.","poem":2},{"text":"Ndipo ndine amene ndinalenga munthu wosakaza kuti awononge;","poem":1}]},{"type":"verse","number":17,"content":[{"text":"palibe chida chopangidwa ndi mdani chimene chidzakupweteke,","poem":2},{"lineBreak":true},{"text":"ndipo onse okuneneza pa mlandu udzawatsutsa.","poem":2},{"text":"Umu ndimo adzapezekere atumiki a Yehova.","poem":1},{"text":"Chipambano chawo chichokera kwa Ine,”","poem":2},{"text":"akutero Yehova.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}