{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Kuyitanidwa kwa Womva Ludzu"]},{"type":"verse","number":1,"content":[{"text":"“Bwerani, inu nonse amene muli ndi ludzu,","poem":1},{"text":"bwerani madzi alipo;","poem":2},{"text":"ndipo inu amene mulibe ndalama","poem":1},{"text":"bwerani, mudzagule chakudya kuti mudye!","poem":2},{"text":"Bwerani mudzagule vinyo ndi mkaka","poem":1},{"text":"osalipira ndalama, osalipira chilichonse.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Chifukwa chiyani ndalama zanu mukuwonongera zinthu zimene samadya,","poem":1},{"text":"ndipo mukuwononga malipiro anu pa zinthu zimene sizikhutitsa?","poem":2},{"text":"Tamverani, mvetsetsani zimene ndikunena kuti mudye zimene zili zabwino;","poem":1},{"text":"ndipo mudzisangalatse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tcherani makutu ndipo mubwere kwa Ine;","poem":1},{"text":"mvereni Ine, kuti mukhale ndi moyo.","poem":2},{"text":"Ndidzachita nanu pangano losatha,","poem":1},{"text":"chikondi changa chija chosasinthika ndi chodalirika ndinalonjeza Davide.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taonani, ine ndamusankha kuti akhale mboni yanga kwa mitundu ya anthu,","poem":1},{"text":"kuti akhale mtsogoleri ndi wolamulira mitundu ya anthu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndithu inu mudzayitanitsa mitundu ya anthu imene simuyidziwa,","poem":1},{"text":"ndipo mitundu ya anthu imene sikudziwani idzabwera ndi liwiro kwa inu.","poem":2},{"text":"Izi zidzatero chifukwa Yehova Mulungu wanu,","poem":1},{"text":"Woyerayo wa Israeli,","poem":2},{"lineBreak":true},{"text":"wakuvekani ulemerero.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Funafunani Yehova pamene Iye akupezeka.","poem":1},{"text":"Mupemphere kwa Iye pamene ali pafupi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Woyipa asiye makhalidwe ake oyipa,","poem":1},{"text":"ndipo wosalungama asinthe maganizo ake oyipa.","poem":2},{"text":"Abwerere kwa Yehova, ndipo adzamuchitira chifundo,","poem":1},{"text":"ndi kwa Mulungu wathu, pakuti adzamukhululukira koposa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Pakuti maganizo anga siwofanana ndi maganizo anu,","poem":1},{"text":"ngakhale njira zanu si njira zanga,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"“Monga momwe mlengalenga muli kutali ndi dziko lapansi,","poem":1},{"text":"momwemonso zochita zanga nʼzolekana kutali ndi zochita zanu,","poem":2},{"lineBreak":true},{"text":"ndipo maganizo anga ndi osiyana kutali ndi maganizo anu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Monga mvula ndi chisanu chowundana","poem":1},{"text":"zimatsika kuchokera kumwamba,","poem":2},{"text":"ndipo sizibwerera komweko","poem":1},{"text":"koma zimathirira dziko lapansi.","poem":2},{"text":"Ndipo zimameretsa ndi kukulitsa zomera","poem":1},{"text":"kenaka nʼkupatsa mlimi mbewu ndi chakudya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndi mmenenso amachitira mawu ochokera mʼkamwa mwanga.","poem":1},{"text":"Sadzabwerera kwa Ine kopanda phindu lake,","poem":2},{"text":"koma adzachita zonse zimene ndifuna,","poem":1},{"text":"ndipo adzakwaniritsa cholinga chimene ndinawatumira.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inu mudzatuluka mu mzindawo mwachimwemwe","poem":1},{"text":"ndipo adzakutsogolerani mwamtendere;","poem":2},{"text":"mapiri ndi zitunda","poem":1},{"text":"zidzakuyimbirani nyimbo,","poem":2},{"text":"ndipo mitengo yonse yamʼthengo","poem":1},{"text":"idzakuwombereni mʼmanja.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mʼmalo mʼmene tsopano muli mitengo ya minga mudzamera mitengo ya payini,","poem":1},{"text":"ndipo kumene kuli mkandankhuku kudzamera mchisu.","poem":2},{"text":"Zimenezi zidzakhala chikumbutso cha Yehova,","poem":1},{"text":"ngati chizindikiro chamuyaya,","poem":2},{"lineBreak":true},{"text":"chimene sichidzafafanizika konse.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}