{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Chipulumutso kwa Anthu Ena Onse"]},{"type":"verse","number":1,"content":["Yehova akuti,",{"text":"“Chitani chilungamo","poem":1},{"text":"ndi zinthu zabwino,","poem":2},{"text":"chifukwa chipulumutso changa chili pafupi","poem":1},{"text":"ndipo ndidzakuwombolani posachedwapa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndi wodala munthu amene amachita zimenezi,","poem":1},{"text":"munthu amene amalimbika kuzichita,","poem":2},{"text":"amene amasunga Sabata osaliyipitsa,","poem":1},{"text":"ndipo amadziletsa kuchita zoyipa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mlendo amene waphatikana ndi Yehova asanene kuti,","poem":1},{"text":"“Ndithu Yehova wandichotsa pakati pa anthu ake.”","poem":2},{"text":"Ndipo munthu wofulidwa asanene kuti,","poem":1},{"text":"“Ine ndine mtengo wowuma basi.”","poem":2}]},{"type":"verse","number":4,"content":["Popeza Yehova akuti,",{"text":"“Wofulidwa amene amasunga masabata anga,","poem":1},{"text":"nachita zokomera Ine","poem":2},{"lineBreak":true},{"text":"ndi kusunga pangano langa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ndidzawapatsa dzina ndi mbiri yabwino","poem":1},{"text":"mʼkati mwa Nyumba yanga ndi makoma ake,","poem":2},{"lineBreak":true},{"text":"kuposa kukhala ndi ana aamuna ndi aakazi.","poem":2},{"text":"Ndidzawapatsa dzina labwino,","poem":1},{"text":"losatha ndi losayiwalika.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yehova akuti, “Alendo amene amadziphatika kwa Yehova,","poem":1},{"text":"motero kuti amamutumikira Iye,","poem":2},{"text":"amakonda dzina la Yehova,","poem":1},{"text":"amamugwirira ntchito,","poem":2},{"text":"komanso kusunga Sabata osaliyipitsa","poem":1},{"text":"ndi kusunga bwino pangano langa,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"amenewa Ine ndidzawafikitsa ku phiri langa lopatulika,","poem":1},{"text":"ndidzawapatsa chimwemwe mʼnyumba yanga ya mapemphero.","poem":2},{"text":"Zopereka zawo zopsereza ndi nsembe zawo","poem":1},{"text":"ndidzazilandira pa guwa langa la nsembe.","poem":2},{"text":"Paja nyumba yanga idzatchedwa","poem":1},{"text":"nyumba ya mapemphero ya anthu a mitundu yonse.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ambuye Yehova, amene amasonkhanitsa","poem":1},{"text":"Aisraeli onse ali ku ukapolo akunena kuti,","poem":2},{"text":"“Ndidzasonkhanitsano anthu ena","poem":1},{"text":"kuwonjezera amene anasonkhana kale.”","poem":2}]},{"type":"heading","content":["Mulungu Adzazula Anthu Oyipa"]},{"type":"verse","number":9,"content":[{"text":"Bwerani, inu zirombo zonse zakuthengo,","poem":1},{"text":"inu nonse zirombo zamʼnkhalango bwerani mudzadye!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Atsogoleri onse a Israeli ndi akhungu,","poem":1},{"text":"onse ndi opanda nzeru;","poem":2},{"text":"onse ndi agalu opanda mawu,","poem":1},{"text":"samatha kuwuwa:","poem":2},{"text":"amagona pansi nʼkumalota","poem":1},{"text":"amakonda kugona tulo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ali ngati agalu amene ali ndi njala yayikulu;","poem":1},{"text":"sakhuta konse.","poem":2},{"text":"Abusa nawonso samvetsa zinthu;","poem":1},{"text":"onse amachita monga akufunira,","poem":2},{"lineBreak":true},{"text":"aliyense amafunafuna zomupindulitsa iye mwini.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aliyense amafuwulira mnzake kuti, “Bwera, tiye timwe vinyo!","poem":1},{"text":"Tiyeni timwe mowa mpaka kukhuta!","poem":2},{"text":"Mawa lidzakhala ngati leroli,","poem":1},{"text":"kapena kuposa lero lino.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}