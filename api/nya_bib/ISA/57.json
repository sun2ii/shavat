{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"Anthu olungama amafa,","poem":1},{"text":"ndipo palibe amene amalingalira mu mtima mwake;","poem":2},{"text":"anthu odzipereka amatengedwa,","poem":1},{"text":"ndipo palibe amene amamvetsa chifukwa chake.","poem":2},{"text":"Anthu olungama amatengedwa","poem":1},{"text":"kuti tsoka lisawagwere.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iwo amene amakhala moyo wolungama","poem":1},{"text":"amafa mwamtendere;","poem":2},{"lineBreak":true},{"text":"amapeza mpumulo pamene agona mu imfa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Bwerani kuno, anthu ochita zoyipa,","poem":1},{"text":"inu muli ngati zidzukulu za mkazi wachigololo ndi wadama!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kodi inu mukuseka yani?","poem":1},{"text":"Kodi mukumunena ndani","poem":2},{"lineBreak":true},{"text":"ndi kupotoza pakamwa panu?","poem":2},{"text":"Kodi inu si ana owukira,","poem":1},{"text":"zidzukulu za anthu abodza?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inu mumapembedza mafano pamene mumalobodoka ndi zilakolako zanu pakati pa mitengo ya thundu,","poem":1},{"text":"ndiponso pa tsinde pa mtengo uliwonse wa nthambi zambiri.","poem":2},{"text":"Mumapereka ana anu ngati nsembe mu zigwa","poem":1},{"text":"ndiponso mʼmingʼalu ya mʼmatanthwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mafano a pakati pa miyala yosalala ya mu zigwa ndiye chuma chanu. Inde, ndiye gawo lanu.","poem":1},{"text":"Mumapereka chopereka cha chakumwa kwa mafanowo,","poem":2},{"text":"ndipo mumaperekanso chopereka cha chakudya.","poem":1},{"text":"Kodi zimenezi","poem":2},{"lineBreak":true},{"text":"zingandichititse kuti ndikukomereni mtima?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inu munayiwala bedi lanu pa phiri lalitali ndi looneka kutali.","poem":1},{"text":"Mumapita kumeneko kukapereka nsembe zanu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mʼnyumba mwanu mwayika","poem":1},{"text":"mafano kuseri kwa zitseko ndiponso pa mphuthu.","poem":2},{"text":"Mwandisiya Ine, mwavula zovala zanu.","poem":1},{"text":"Bedi lanu mwalikulitsa ndipo mwakwera ndi zibwenzi zanu,","poem":2},{"text":"ndiye mwazilipira kuti mugone nazo.","poem":1},{"text":"Kumene mwakwaniritsa zilakolako zanu zoyipa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mumapita kukapembedza fano la Moleki mutatenga mafuta","poem":1},{"text":"ndi zonunkhira zochuluka.","poem":2},{"text":"Munachita kutumiza akazembe anu kutali;","poem":1},{"text":"inu ngakhale munapita ku manda kwenikweniko!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inu mumatopa ndi maulendo anu,","poem":1},{"text":"koma simunathe kunena kuti, ‘Nʼzopanda phindu.’","poem":2},{"text":"Munapezako kumeneko zokhumba zanu","poem":1},{"text":"nʼchifukwa chake simunalefuke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Kodi ndani amene mwachita naye mantha ndi kumuopa,","poem":1},{"text":"kotero kuti mwakhala mukundinamiza,","poem":2},{"text":"ndipo Ine simundikumbukira nʼkomwe,","poem":1},{"text":"kapena kuganizirapo mʼmitima yanu za Ine?","poem":2},{"text":"Kodi mwaleka kundiopa chifukwa choti","poem":1},{"text":"ndakhala chete nthawi yayitali?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Koma ndaonetsa poyera ntchito zanu zomwe mumati nʼzolungama,","poem":1},{"text":"ndi mafano anu kuti nʼzosathandiza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pamene mufuwula kupempha thandizo,","poem":1},{"text":"mafano anu amene munasonkhanitsawo ndiyetu akupulumutseni!","poem":2},{"text":"Mphepo idzanyamula mafano anu onsewo,","poem":1},{"text":"mpweya chabe udzawulutsa mafanowo.","poem":2},{"text":"Koma munthu amene amadalira ine","poem":1},{"text":"adzalandira dziko lokhalamo.","poem":2},{"lineBreak":true},{"text":"Phiri langa lopatulika lidzakhala lakelake.”","poem":2}]},{"type":"heading","content":["Mpumulo kwa Anthu Osweka Mtima"]},{"type":"verse","number":14,"content":["Ndipo panamveka mawu akuti,",{"text":"“Undani, undani, konzani msewu!","poem":1},{"text":"Chotsani zotchinga pa njira yoyendamo anthu anga.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pakuti Iye amene ali Wamkulu ndi Wopambanazonse,","poem":1},{"text":"amene alipo nthawi zonse, amene dzina lake ndi Woyerayo,","poem":2},{"text":"akunena kuti, “Ndimakhala pamalo aulemu ndi opatulika,","poem":1},{"text":"koma ndimakhalanso ndi munthu wodzichepetsa ndi wosweka mtima","poem":2},{"text":"kuti odzichepetsawo ndiwalimbitse","poem":1},{"text":"ndi kuwachotsa mantha osweka mtima.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sindidzawatsutsa anthu mpaka muyaya","poem":1},{"text":"kapena kuwapsera mtima nthawi zonse,","poem":2},{"text":"popeza kuti ndinalenga anthu anga","poem":1},{"text":"ndi kuwapatsa mpweya wamoyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ine ndinakwiya kwambiri chifukwa cha tchimo lawo ladyera;","poem":1},{"text":"ndinawalanga ndi kuwafulatira mokwiya,","poem":2},{"lineBreak":true},{"text":"koma iwo anapitirirabe kuchita ntchito zawo zoyipa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndaona zochita zawo, komabe ndidzawachiritsa;","poem":1},{"text":"kuwapumulitsa ndi kuwapatsa mtendere,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"anthu olira a mu Israeli adzanditamanda ndi milomo yawo.","poem":2},{"text":"Anthu amene ali kutali ndi apafupi pomwe ndidzawapatsa mtendere,”","poem":1},{"text":"“Ndipo ndidzawachiritsa.”","poem":2},{"text":"Akutero Yehova.","poem":4}]},{"type":"verse","number":20,"content":[{"text":"Koma anthu oyipa ali ngati nyanja yowinduka,","poem":1},{"text":"yosatha kukhala bata,","poem":2},{"lineBreak":true},{"text":"mafunde ake amaponya matope ndi ndere.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Palibe mtendere kwa oyipa,” akutero Mulungu wanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}