{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["Tchimo, Kuvomereza ndi Chipulumutso"]},{"type":"verse","number":1,"content":[{"text":"Taonani, mkono wa Yehova si waufupi kuti sungathe kupulumutsa,","poem":1},{"text":"kapena khutu lake kuti ndilogontha kuti sangamve.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Koma zoyipa zanu zakulekanitsani","poem":1},{"text":"ndi Mulungu wanu;","poem":2},{"text":"ndipo wakufulatirani chifukwa cha machimo anu,","poem":1},{"text":"kotero Iye sadzamva.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pakuti manja anu ali psuu ndi magazi.","poem":1},{"text":"Munayipitsa zala zanu ndi zamphulupulu.","poem":2},{"text":"Pakamwa panu payankhula zabodza,","poem":1},{"text":"ndipo lilime lanu lanena zinthu zoyipa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Palibe amene akuyimba mnzake mlandu molungama,","poem":1},{"text":"palibe amene akupita ku mlandu moona mtima.","poem":2},{"text":"Iwo amadalira mawu opanda pake ndipo amayankhula mabodza;","poem":1},{"text":"amalingalira za mphulupulu ndipo amachita zoyipa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iwo amayikira mazira a mamba","poem":1},{"text":"ndipo amaluka ukonde wakangawude.","poem":2},{"text":"Aliyense amene adzadya mazira awo adzafa,","poem":1},{"text":"ndipo ngati dzira limodzi lasweka limatulutsa mphiri.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ukonde wawo wa kangawude sangawuvale ngati chovala;","poem":1},{"text":"ndipo chimene apangacho sangachifunde.","poem":2},{"text":"Ntchito zawo ndi zoyipa,","poem":1},{"text":"ndipo amakonda kuchita zandewu ndi manja awo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amathamangira kukachita zoyipa;","poem":1},{"text":"sachedwa kupha anthu osalakwa.","poem":2},{"text":"Maganizo awo ndi maganizo oyipa;","poem":1},{"text":"kulikonse kumene amapita amasiyako bwinja ndi chiwonongeko.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iwo sadziwa kuchita za mtendere;","poem":1},{"text":"zonse zimene amachita nʼzopanda chilungamo.","poem":2},{"text":"Njira zawo zonse nʼzokhotakhota;","poem":1},{"text":"aliyense oyenda mʼnjira zimenezo sadzapeza mtendere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Anthu akuti, “Chifukwa cha zimenezi chilungamo chatitalikira;","poem":1},{"text":"ndipo chipulumutso sichitifikira.","poem":2},{"text":"Timafunafuna kuwala koma timangopeza mdima okhaokha;","poem":1},{"text":"tinayembekezera kuyera koma timayenda mu mdima wandiweyani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Timapapasapapasa khoma ngati munthu wosaona,","poem":1},{"text":"kuyangʼanayangʼana njira ngati anthu opanda maso.","poem":2},{"text":"Timapunthwa dzuwa lili paliwombo ngati kuti ndi usiku;","poem":1},{"text":"timakhala pansi mu mdima ngati anthu akufa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tonse timabangula ngati zimbalangondo:","poem":1},{"text":"Timalira modandaula ngati nkhunda.","poem":2},{"text":"Tinayembekezera kuweruza kolungama; koma sitikupeza.","poem":1},{"text":"Timayembekezera chipulumutso koma chimakhala nafe kutali.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Pakuti zolakwa zathu nʼzochuluka pamaso panu,","poem":1},{"text":"ndipo machimo athu akutsutsana nafe.","poem":2},{"text":"Zolakwa zathu zili ndi ife nthawi zonse","poem":1},{"text":"ndipo tikuvomereza machimo athu:","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tawukira ndi kumukana Yehova.","poem":1},{"text":"Tafulatira Mulungu wathu,","poem":2},{"text":"pa kupondereza anzathu ndi kupandukira Yehova,","poem":1},{"text":"ndi pa kuyankhula mabodza amene tawaganiza mʼmitima mwathu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Motero kuweruza kolungama kwalekeka","poem":1},{"text":"ndipo choonadi chili kutali ndi ife;","poem":2},{"text":"kukhulupirika sikukupezekanso mʼmabwalo a milandu,","poem":1},{"text":"ndipo kuona mtima sikukupezekanso mʼmenemo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Choonadi sichikupezeka kumeneko,","poem":1},{"text":"ndipo wina akakana kuchita nawo zoyipa amapeza mavuto.","poem":2},{"lineBreak":true},{"text":"Yehova anaziona zimenezi ndipo zinamunyansa","poem":1},{"text":"kuti panalibe chiweruzo cholungama.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yehova anaona kuti panalibe ndi mmodzi yemwe,","poem":1},{"text":"Iye anadabwa kuti panalibe ndi mmodzi yemwe woti nʼkupembedzera;","poem":2},{"text":"Choncho mphamvu zake zomwe zinamuthandiza,","poem":1},{"text":"ndipo anadzilimbitsa ndi kulungama kwake;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iye anavala chilungamo ngati chovala chachitsulo chapachifuwa,","poem":1},{"text":"ndipo kumutu kwake amavala chipewa chachipulumutso;","poem":2},{"text":"anavala kulipsira ngati chovala","poem":1},{"text":"ndipo anadzikuta ndi mkwiyo ngati chofunda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iye adzawabwezera chilango adani a anthu ake","poem":1},{"text":"molingana ndi zimene anachita,","poem":2},{"text":"adzaonetsa ukali kwa adani ake","poem":1},{"text":"ndi kubwezera chilango odana naye.","poem":2},{"lineBreak":true},{"text":"Adzalanga ngakhale okhala mayiko akutali.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Choncho akadzabwera ngati madzi","poem":1},{"text":"oyendetsedwa ndi mphepo yamphamvu yamkuntho.","poem":2},{"text":"Anthu onse kuyambira kumadzulo mpaka kummawa","poem":1},{"text":"adzaopa dzina la Yehova ndi ulemerero wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mpulumutsi adzabwera ku Ziyoni","poem":1},{"text":"kudzapulumutsa anthu a fuko la Yakobo amene analapa machimo awo,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":21,"content":["Yehova akuti, “Kunena za pangano lake ndi iwo, Mzimu wanga umene uli pa inu, ndiponso mawu anga amene ndayika mʼkamwa mwanu sadzachoka mʼkamwa mwanu, kapena kuchoka mʼkamwa mwa ana anu, kapena mʼkamwa mwa zidzukulu zawo kuyambira tsopano mpaka kalekale,”",{"text":"akutero Yehova.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}