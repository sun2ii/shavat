{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Dzina Latsopano la Ziyoni"]},{"type":"verse","number":1,"content":[{"text":"Chifukwa chokonda Ziyoni sindidzakhala chete,","poem":1},{"text":"chifukwa chokonda Yerusalemu sindidzakhala chete,","poem":2},{"text":"mpaka chilungamo chake chitaoneka poyera ngati kuwala,","poem":1},{"text":"ndi chipulumutso chake chitaoneka ngati sakali yoyaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mitundu ya anthu idzaona iwe utapambana pa nkhondo","poem":1},{"text":"ndipo mafumu onse adzaona ulemerero wako.","poem":2},{"text":"Adzakuyitanira dzina latsopano","poem":1},{"text":"limene adzakupatse ndi Yehova.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Udzakhala ngati chipewa chaulemerero mʼdzanja la Yehova,","poem":1},{"text":"ndi ngati nduwira yaufumu mʼdzanja la Mulungu wako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sadzakutchanso “Wosiyidwa,”","poem":1},{"text":"ndipo dziko lako silidzatchedwanso “Chipululu.”","poem":2},{"text":"Koma dzina lako latsopano lidzakhala “Ndakondwera naye.”","poem":1},{"text":"Ndipo dziko lako lidzatchedwa “Wokwatiwa.”","poem":2},{"text":"Chifukwa Yehova akukondwera nawe,","poem":1},{"text":"ndipo adzakhala ngati mwamuna wa dziko lako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Monga mnyamata amakwatira namwali,","poem":1},{"text":"momwenso mmisiri wodzakumanga adzakukwatira;","poem":2},{"text":"monga mkwati amakondwera ndi mkwatibwi,","poem":1},{"text":"chonchonso Mulungu adzakondwera nawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iwe Yerusalemu, pa malinga ako ndayikapo alonda;","poem":1},{"text":"sadzakhala chete usana kapena usiku.","poem":2},{"text":"Inu amene mumakumbutsa Yehova za malonjezo ake","poem":1},{"text":"musapumule.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Musamupatse mpata wopuma mpaka atakhazikitsa Yerusalemu","poem":1},{"text":"kukhala mzinda umene dziko lapansi lidzawutamande.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yehova analumbira atakweza dzanja lake.","poem":1},{"text":"Anati,","poem":2},{"text":"“Sindidzaperekanso tirigu wako","poem":1},{"text":"kuti akhale chakudya cha adani ako,","poem":2},{"text":"ndipo alendo sadzamwanso vinyo wako watsopano","poem":1},{"text":"pakuti unamuvutikira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Koma amene amakakolola ndiwo amene adzadye buledi","poem":1},{"text":"ndi kutamanda Yehova,","poem":2},{"text":"ndipo amene amasonkhanitsa pamodzi mphesa ndiwo amene adzamwe vinyo","poem":1},{"text":"mʼmabwalo a Nyumba yanga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tulukani, dutsani pa zipata!","poem":1},{"text":"Konzerani anthu njira.","poem":2},{"text":"Lambulani, lambulani msewu waukulu!","poem":1},{"text":"Chotsani miyala.","poem":2},{"text":"Kwezani mbendera kuti mitundu ya anthu izione.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yehova walengeza","poem":1},{"text":"ku dziko lonse lapansi kuti,","poem":2},{"text":"Awuzeni anthu a ku Yerusalemu kuti,","poem":1},{"text":"“Taonani, chipulumutso chanu chikubwera;","poem":2},{"text":"Yehova akubwera ndi mphotho yake","poem":1},{"text":"akubwera nazo zokuyenerani.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iwo adzatchedwa Anthu Opatulika,","poem":1},{"text":"owomboledwa a Yehova;","poem":2},{"text":"ndipo adzakutchani “Okondwa a Yehova”","poem":1},{"text":"“Mzinda umene Yehova sanawusiye.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}