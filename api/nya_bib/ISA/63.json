{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["Yehova Agonjetsa Anthu a Mitundu Ina"]},{"type":"verse","number":1,"content":[{"text":"Kodi ndani uyo akubwera kuchokera ku Edomu,","poem":1},{"text":"atavala zovala za ku Bozira za madontho ofiira?","poem":2},{"text":"Kodi uyu ndani, amene wavala zovala zokongola,","poem":1},{"text":"akuyenda mwa mphamvu zake?","poem":2},{"lineBreak":true},{"text":"“Ndi Ineyo, woyankhula zachilungamo","poem":1},{"text":"ndiponso wamphamvu zopulumutsa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nanga bwanji zovala zanu zili psuu,","poem":1},{"text":"ngati za munthu wofinya mphesa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Ndapondereza ndekha anthu a mitundu ina ngati mphesa,","poem":1},{"text":"palibe ndi mmodzi yemwe anali nane.","poem":2},{"text":"Ndinawapondereza ndili wokwiya","poem":1},{"text":"ndipo ndinawapondereza ndili ndi ukali;","poem":2},{"text":"magazi awo anadothera pa zovala zanga,","poem":1},{"text":"ndipo zovala zanga zonse zinathimbirira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pakuti ndinatsimikiza mu mtima mwanga kuti lafika tsiku lolipsira anthu anga;","poem":1},{"text":"ndipo chaka cha kuwomboledwa kwanga chafika.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndinayangʼana ndipo panalibe munthu wondithandiza.","poem":1},{"text":"Ndinadabwa kwambiri kuti panalibe wondichirikiza;","poem":2},{"text":"choncho ndinapambana ndi mphamvu zanga,","poem":1},{"text":"ndipo mkwiyo wanga unandilimbitsa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndinapondereza mitundu ya anthu ndili wokwiya;","poem":1},{"text":"ndipo ndinawasakaza","poem":2},{"lineBreak":true},{"text":"ndipo ndinathira magazi awo pansi.”","poem":2}]},{"type":"heading","content":["Matamando ndi Pemphero"]},{"type":"verse","number":7,"content":[{"text":"Ndidzafotokoza za kukoma mtima kwa Yehova,","poem":1},{"text":"ntchito zimene Iye ayenera kutamandidwa.","poem":2},{"lineBreak":true},{"text":"Ndidzatamanda Yehova chifukwa cha zonse zimene watichitira.","poem":2},{"text":"Inde, mwa chifundo ndi kukoma mtima kwake","poem":1},{"text":"Yehova wachitira nyumba ya Israeli","poem":2},{"lineBreak":true},{"text":"zinthu zabwino zambiri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yehova anati, “Ndithu awa ndi anthu anga,","poem":1},{"text":"ana anga amene sadzandinyenga Ine.”","poem":2},{"lineBreak":true},{"text":"Choncho anawapulumutsa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iyenso anasautsidwa mʼmasautso awo onse,","poem":1},{"text":"ndipo mngelo wochokera kwa Iye anawapulumutsa.","poem":2},{"text":"Mwa chikondi ndi chifundo chake iye anawapulumutsa,","poem":1},{"text":"anawanyamula ndikuwatenga","poem":2},{"lineBreak":true},{"text":"kuyambira kale lomwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Komabe iwo anawukira","poem":1},{"text":"ndi kumvetsa chisoni Mzimu Woyera.","poem":2},{"text":"Motero Yehova anatembenuka nakhala mdani wawo","poem":1},{"text":"ndipo Iye mwini anamenyana nawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Pamenepo anthu ake anakumbukira masiku amakedzana,","poem":1},{"text":"masiku a Mose mtumiki wake;","poem":2},{"text":"ndipo anafunsa kuti, “Ali kuti Yehova amene anawawolotsa pa nyanja,","poem":1},{"text":"pamodzi ndi Mose mʼbusa wawo?","poem":2},{"text":"Ali kuti Iye amene anayika","poem":1},{"text":"Mzimu Woyera pakati pawo?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ali kuti amene anachita zinthu zodabwitsa","poem":1},{"text":"ndi mphamvu zake zazikulu kudzera mwa Mose?","poem":2},{"text":"Ali kuti amene anagawa madzi pa nyanja anthu ake akuona,","poem":1},{"text":"kuti dzina lake limveke mpaka muyaya,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"amene anawayendetsa pa nyanja yozama?","poem":1},{"lineBreak":true},{"text":"Monga kavalo woyendayenda mʼchipululu,","poem":1},{"text":"iwo sanapunthwe;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mzimu Woyera unawapumulitsa","poem":1},{"text":"ngati mmene ngʼombe zimapumulira.","poem":2},{"text":"Umu ndi mmene Inu munatsogolera anthu anu","poem":1},{"text":"kuti dzina lanu lilemekezeke.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Inu Yehova amene muli kumwambako, pa mpando wanu wolemekezeka,","poem":1},{"text":"wopatulika ndi waulemerero, tiyangʼaneni ife.","poem":2},{"text":"Kodi changu chanu ndi mphamvu zanu zili kuti?","poem":1},{"text":"Simukutionetsanso kukoma mtima kwanu ndi chifundo chanu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Koma Inu ndinu Atate athu,","poem":1},{"text":"ngakhale Abrahamu satidziwa","poem":2},{"lineBreak":true},{"text":"kapena Israeli kutivomereza ife;","poem":2},{"text":"Inu Yehova, ndinu Atate athu,","poem":1},{"text":"kuyambira kale dzina lanu ndinu Mpulumutsi wathu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Chifukwa chiyani, Inu Yehova, mukutisocheretsa pa njira zanu?","poem":1},{"text":"Bwanji mukutilola kuti tikhale owuma mitima kotero kuti sitikukuopaninso?","poem":2},{"text":"Bwererani chifukwa cha atumiki anu;","poem":1},{"text":"mafuko a anthu amene ali cholowa chanu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anthu anu atangokhala pa malo anu opatulika pa kanthawi kochepa,","poem":1},{"text":"adani athu anasakaza malo anu opatulika.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ife tili ngati anthu amene","poem":1},{"text":"simunawalamulirepo","poem":2},{"lineBreak":true},{"text":"ngati iwo amene sanakhalepo anthu anu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}