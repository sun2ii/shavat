{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["Chiweruzo ndi Chipulumutso"]},{"type":"verse","number":1,"content":[{"text":"“Ndinali wokonzeka kumva mapemphero a amene sankandipempha kanthu;","poem":1},{"text":"ndipo ndinalola kuti anthu amene ankandifunafuna kuti andipeze.","poem":2},{"text":"Kwa mtundu wa anthu umene sunkapempha chithandizo kwa Ine,","poem":1},{"text":"ndinati, ‘Ine ndili pano, Ine ndili pano.’","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsiku lonse ndatambasulira manja anga","poem":1},{"text":"anthu owukira aja,","poem":2},{"text":"amene amachita zoyipa,","poem":1},{"text":"natsatira zokhumba zawo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndatambasulira manja anga anthu aja amene nthawi zonse amandikwiyitsa","poem":1},{"text":"mopanda manyazi.","poem":2},{"text":"Iwo amapereka nsembe mʼminda","poem":1},{"text":"ndi kufukiza lubani pa maguwa ansembe a njerwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amakatandala ku manda","poem":1},{"text":"ndipo amakachezera usiku wonse kumalo obisika.","poem":2},{"text":"Amadya nyama ya nkhumba,","poem":1},{"text":"ndipo mʼmiphika mwawo muli msunzi wa nyama yodetsedwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amawuza ena kuti, ‘Khala patali usandiyandikire,","poem":1},{"text":"chifukwa ungatengere kupatulika kwanga!’","poem":2},{"text":"Ukali wanga pa anthu otere uli ngati utsi mphuno zanga,","poem":1},{"text":"ngati moto umene umayaka tsiku lonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Taonani, ndatsimikiza kale mlandu ndi chilango chawo;","poem":1},{"text":"sindidzakhala chete koma ndidzawalanga kwathunthu","poem":2},{"lineBreak":true},{"text":"chifukwa cha machimo awo","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ndi a makolo awo,”","poem":1},{"text":"akutero Yehova.","poem":2},{"text":"“Chifukwa anapereka nsembe zopsereza pa mapiri","poem":1},{"text":"ndi kundinyoza Ine pa zitunda zawo,","poem":2},{"text":"Ine ndidzawalanga kwathunthu potsata","poem":1},{"text":"zimene anachita kale.”","poem":2}]},{"type":"verse","number":8,"content":["Yehova akuti,",{"text":"“Pamene madzi akanapezeka mu phava la mphesa","poem":1},{"text":"ndipo anthu amati, ‘Musawononge phavalo,","poem":2},{"lineBreak":true},{"text":"popeza madzi ena abwino akanalimobe mʼphavalo,’","poem":2},{"text":"Inenso chifukwa cha mtumiki wanga;","poem":1},{"text":"sindidzawononga onse.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndidzatulutsa zidzukulu mʼbanja la Yakobo,","poem":1},{"text":"ndipo a banja la Yuda adzalandira mapiri anga ngati cholowa chawo.","poem":2},{"text":"Anthu anga osankhidwa adzalandira zimenezi,","poem":1},{"text":"ndipo atumiki anga adzakhala kumeneko.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Chigwa cha Saroni chidzakhala kodyetserako nkhosa,","poem":1},{"text":"ndipo chigwa cha Akori chidzakhala malo opumirako ngʼombe","poem":2},{"lineBreak":true},{"text":"kwa anthu anga ondifunafuna Ine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Koma inu amene mumasiya Yehova","poem":1},{"text":"ndi kuyiwala phiri langa lopatulika,","poem":2},{"text":"amene munamukonzera Gadi chakudya","poem":1},{"text":"ndi kuthirira Meni chakumwa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ndidzakuperekani ku lupanga ngati nsembe,","poem":1},{"text":"ndipo nonse mudzaphedwa;","poem":2},{"text":"chifukwa simunayankhe pamene ndinakuyitanani,","poem":1},{"text":"ndinayankhula koma simunamvere.","poem":2},{"text":"Munachita zoyipa pamaso panga","poem":1},{"text":"ndipo munasankha kuchita zoyipa zomwe sindikondwera nazo.”","poem":2}]},{"type":"verse","number":13,"content":["Nʼchifukwa chake Ambuye Yehova akuti,",{"text":"“Atumiki anga adzadya,","poem":1},{"text":"koma inu mudzakhala ndi njala;","poem":2},{"text":"atumiki anga adzamwa,","poem":1},{"text":"koma inu mudzakhala ndi ludzu;","poem":2},{"text":"atumiki anga adzakondwa,","poem":1},{"text":"koma inu mudzakhala ndi manyazi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Atumiki anga adzayimba","poem":1},{"text":"mosangalala,","poem":2},{"text":"koma inu mudzalira kwambiri","poem":1},{"text":"chifukwa chovutika mu mtima","poem":2},{"lineBreak":true},{"text":"ndipo mudzalira mofuwula chifukwa mudzamva kuwawa mu mtima.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anthu anga osankhidwa","poem":1},{"text":"adzatchula dzina lanu potemberera.","poem":2},{"text":"Ambuye Yehova adzakuphani,","poem":1},{"text":"koma atumiki ake adzawapatsa dzina lina.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Aliyense wopempha dalitso mʼdzikomo","poem":1},{"text":"adzachita zimenezo kwa Mulungu woona;","poem":2},{"text":"ndipo aliyense wochita malumbiro mʼdzikomo","poem":1},{"text":"adzalumbira mwa Mulungu woona.","poem":2},{"text":"Pakuti mavuto akale adzayiwalika","poem":1},{"text":"ndipo adzachotsedwa pamaso panga.","poem":2}]},{"type":"heading","content":["Chilengedwe Chatsopano"]},{"type":"verse","number":17,"content":[{"text":"“Taonani, ndikulenga","poem":1},{"text":"mlengalenga mwatsopano ndi dziko lapansi latsopano.","poem":2},{"text":"Zinthu zakale sizidzakumbukika,","poem":1},{"text":"zidzayiwalika kotheratu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Koma inu mukhale osangalala ndi okondwa mpaka muyaya","poem":1},{"text":"chifukwa cha zimene ndikulenga,","poem":2},{"text":"pakuti ndikulenga Yerusalemu kukhala malo wosangalatsa","poem":1},{"text":"ndipo anthu ake adzakhala achimwemwe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ine ndidzakondwa chifuwa cha Yerusalemu","poem":1},{"text":"ndipo ndidzasangalala chifukwa cha anthu anga.","poem":2},{"text":"Kumeneko sikudzamvekanso kulira","poem":1},{"text":"ndi mfuwu wodandaula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ana sadzafa ali akhanda","poem":1},{"text":"ndipo nkhalamba zonse zidzakwaniritsa zaka zawo zonse.","poem":2},{"lineBreak":true},{"text":"Wamngʼono mwa iwo","poem":2},{"text":"adzafa ali ndi zaka 100.","poem":1},{"text":"Amene adzalephere kufika zaka 100","poem":2},{"text":"adzatengedwa kukhala","poem":1},{"text":"wotembereredwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Anthu adzamanga nyumba ndi kukhalamo,","poem":1},{"text":"adzadzala mpesa ndipo adzadya zipatso zake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sadzamanganso nyumba anthu ena nʼkukhalamo,","poem":1},{"text":"kapena kudzala ndi ena nʼkudya.","poem":2},{"text":"Pakuti anthu anga adzakhala ndi moyo","poem":1},{"text":"wautali ngati mitengo.","poem":2},{"text":"Osankhidwa anga adzakondwera ndi ntchito","poem":1},{"text":"ya manja awo nthawi yayitali.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sadzagwira ntchito pachabe","poem":1},{"text":"kapena kubereka ana kuti aone tsoka;","poem":2},{"text":"chifukwa adzakhala anthu odalitsidwa ndi Yehova,","poem":1},{"text":"iwowo pamodzi ndi adzukulu awo omwe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndidzawayankha ngakhale asanathe nʼkupempha komwe.","poem":1},{"text":"Pamene akuyankhula kumene Ine ndidzakhala nditamva kale.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mʼmbulu ndi mwana wankhosa wamkazi zidzadyera pamodzi.","poem":1},{"text":"Mkango udzadya udzu monga ngʼombe,","poem":2},{"lineBreak":true},{"text":"koma fumbi ndiye chidzakhale chakudya cha njoka.","poem":2},{"text":"Pa phiri langa lopatulika sipadzakhala","poem":1},{"text":"chinthu chopweteka kapena chowononga,”","poem":2},{"text":"akutero Yehova.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}