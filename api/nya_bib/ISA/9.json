{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ISA","translationId":"nya_bib","name":"YESAYA","commonName":"YESAYA","title":"Yesaya","order":23,"numberOfChapters":66,"sha256":"6452da369c2b71a39850c39607c1e027c94d4833b8ea565559b20c72f6332114","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nya_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Ufumu wa Mesiya"]},{"type":"verse","number":1,"content":["Anthu amene anali ndi nkhawa, sadzakhalanso otaya mtima. Masiku amakedzana Mulungu ananyozetsa dziko la Zebuloni ndi dziko la Nafutali, koma kutsogolo kuno dera lonse la Galileya, limene lili dziko la anthu a mitundu ina, kuyambira ku nyanja yayikulu, mʼmbali mwa Yorodani, adzalisandutsa laulemu."]},{"type":"verse","number":2,"content":[{"text":"Anthu oyenda mu mdima","poem":1},{"text":"awona kuwala kwakukulu;","poem":2},{"text":"kwa iwo okhala mʼdziko la mdima wandiweyani","poem":1},{"text":"kuwunika kwawafikira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inu mwauchulukitsa mtundu wanu","poem":1},{"text":"ndipo mwawonjezera chimwemwe chawo.","poem":2},{"text":"Iwo akukondwa pamaso panu,","poem":1},{"text":"ngati mmene anthu amakondwera nthawi yokolola,","poem":2},{"text":"ngatinso mmene anthu amakondwera","poem":1},{"text":"pamene akugawana zolanda ku nkhondo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Monga munachitira pogonjetsa Amidiyani,","poem":1},{"text":"inu mwathyola goli","poem":2},{"text":"limene limawalemera,","poem":1},{"text":"ndodo zimene amamenyera mapewa awo,","poem":2},{"lineBreak":true},{"text":"ndiponso mikwapulo ya anthu owazunza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nsapato iliyonse ya munthu wankhondo,","poem":1},{"text":"ndiponso chovala chilichonse chodonthekera magazi","poem":2},{"text":"zidzatenthedwa pa moto","poem":1},{"text":"ngati nkhuni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Chifukwa mwana watibadwira,","poem":1},{"text":"mwana wamwamuna wapatsidwa kwa ife,","poem":2},{"lineBreak":true},{"text":"ndipo ulamuliro udzakhala pa phewa lake.","poem":2},{"text":"Ndipo adzamutcha dzina lake lakuti","poem":1},{"text":"Phungu Wodabwitsa, Mulungu Wamphamvu,","poem":2},{"lineBreak":true},{"text":"Atate Amuyaya, ndi Mfumu ya Mtendere.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ulamuliro ndi mtendere wake","poem":1},{"text":"zidzakhala zopanda malire.","poem":2},{"text":"Iye adzalamulira ufumu wake ali pa","poem":1},{"text":"mpando waufumu wa Davide,","poem":2},{"text":"ndipo adzawukhazikitsa ndi kuwuchirikiza","poem":1},{"text":"mwa chiweruzo cholungama ndi pochita zachilungamo","poem":2},{"lineBreak":true},{"text":"kuyambira nthawi imeneyo mpaka muyaya.","poem":2},{"text":"Ndi mtima wake wonse, Yehova Wamphamvuzonse","poem":1},{"text":"watsimikiza kuchita zimenezi.","poem":2}]},{"type":"heading","content":["Mkwiyo wa Yehova pa Israeli"]},{"type":"verse","number":8,"content":[{"text":"Ambuye atumiza mawu otsutsa Yakobo;","poem":1},{"text":"ndipo mawuwo agwera pa Israeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anthu onse okhala mu","poem":1},{"text":"Efereimu ndi okhala mu Samariya,","poem":2},{"text":"adzadziwa zimenezi.","poem":1},{"text":"Iwo amayankhula modzikuza kuti,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Ngakhale njerwa zagumuka,","poem":1},{"text":"koma ife tidzamanga ndi miyala yosema.","poem":2},{"text":"Mitanda ya mkuyu yagwetsedwa,","poem":1},{"text":"koma ife tidzayika mitanda ya mkungudza mʼmalo mwake.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Koma Yehova wadzutsa adani kuti alimbane nawo","poem":1},{"text":"ndipo wawafulumiza adani awo kuti amenyane nawo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asiriya ochokera kummawa ndi Afilisti ochokera kumadzulo ndipo","poem":1},{"text":"ayasama pakamwa kuti adye a Israeli.","poem":2},{"lineBreak":true},{"text":"Komabe, mkwiyo wake sunawachokere,","poem":1},{"text":"mkono wake uli chitambasulire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Koma anthu sanabwerere kwa amene anawakantha uja,","poem":1},{"text":"ngakhale kufunafuna Yehova Wamphamvuzonse.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Choncho Yehova adzadula mutu wa Israeli pamodzi ndi mchira womwe,","poem":1},{"text":"nthambi ya kanjedza ndi bango lomwe tsiku limodzi;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"mutuwo ndiye akuluakulu ndi olemekezeka,","poem":1},{"text":"mchira ndiye aneneri ophunzitsa zabodza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Amene amatsogolera anthuwa ndiwo amawasocheretsa,","poem":1},{"text":"ndipo otsogoleredwa amatayika.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nʼchifukwa chake Ambuye adzakondwera nawo achinyamata,","poem":1},{"text":"ngakhale kuwachitira chifundo ana amasiye ndi akazi amasiye,","poem":2},{"text":"pakuti aliyense ndi wosapembedza Mulungu ndiponso ndi wochimwa ndipo","poem":1},{"text":"aliyense amayankhula zopusa.","poem":2},{"lineBreak":true},{"text":"Komabe, mkwiyo wake sunawachokere,","poem":1},{"text":"mkono wake uli chitambasulire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ndithu kuyipa kwa anthuwo kumayaka ngati moto;","poem":1},{"text":"moto wake umanyeketsa mkandankhuku ndi minga,","poem":2},{"text":"umayatsa nkhalango yowirira,","poem":1},{"text":"ndipo utsi wake umachita kuti toloo ngati mtambo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dziko lidzatenthedwa ndi ukali wa Yehova Wamphamvuzonse,","poem":1},{"text":"dziko lidzatenthedwa","poem":2},{"text":"ndipo anthu adzakhala ngati nkhuni zosonkhera moto;","poem":1},{"text":"palibe munthu amene adzachitire chifundo mʼbale wake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kudzanja lamanja adzapeza chakudya nʼkudya,","poem":1},{"text":"koma adzakhalabe ndi njala;","poem":2},{"text":"kudzanja lamanzere adzapeza chakudya nʼkudya,","poem":1},{"text":"koma sadzakhuta.","poem":2},{"text":"Aliyense azidzadya ana ake omwe.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Manase adzadya Efereimu ndipo Efereimu adzadya Manase;","poem":2},{"lineBreak":true},{"text":"onsewa pamodzi adzadya Yuda.","poem":2},{"lineBreak":true},{"text":"Komabe pa zonsezi, mkwiyo wake sunawachokere,","poem":1},{"text":"mkono wake uli chitambasulire.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}