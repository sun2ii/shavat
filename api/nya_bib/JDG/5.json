{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JDG","translationId":"nya_bib","name":"OWERUZA","commonName":"OWERUZA","title":"Oweruza","order":7,"numberOfChapters":21,"sha256":"7f223a2d262330c8ab28dd26530933e8743da4187ded0a06258def55ec1130a6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/nya_bib/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Nyimbo ya Debora"]},{"type":"verse","number":1,"content":["“Tsiku limenelo Debora ndi Baraki mwana wa Abinoamu anayimba nyimbo iyi:"]},{"type":"verse","number":2,"content":[{"text":"“Popeza kuti atsogoleri anatsogoleradi mʼdziko la Israeli;","poem":1},{"text":"ndipo anthu anadzipereka okha mwa ufulu,","poem":2},{"lineBreak":true},{"text":"tamandani Yehova:","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Imvani inu mafumu! Tcherani khutu, atsogoleri inu!","poem":1},{"text":"Ndidzayimba nyimbo, ndidzayimbira Yehova,","poem":2},{"lineBreak":true},{"text":"Mulungu wa Israeli nyimbo yokoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Inu Yehova, pamene munkatuluka mu Seiri,","poem":1},{"text":"pamene mumayenda kuchokera mʼdziko la Edomu,","poem":2},{"text":"dziko linagwedezeka, mitambo inasungunuka","poem":1},{"text":"nigwetsa madzi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mapiri anagwedezeka pamaso pa Yehova,","poem":1},{"text":"Mulungu wa Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Pa nthawi ya Samugara mwana wa Anati,","poem":1},{"text":"pa nthawi ya Yaeli, misewu inasiyidwa;","poem":2},{"lineBreak":true},{"text":"alendo ankangoyenda mʼtinjira takumbali.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anthu a ku midzi anathawa; mu Israeli munalibe midzi","poem":1},{"text":"mpaka pamene iwe Debora unafika;","poem":2},{"lineBreak":true},{"text":"unafika ngati mayi ku Israeli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pamene anasankha milungu ina,","poem":1},{"text":"nkhondo inabwera ku zipata za mzinda,","poem":2},{"text":"ndipo chishango kapena mkondo sizinapezeke","poem":1},{"text":"pakati pa anthu 40,000 mu Israeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mtima wanga uli ndi atsogoleri a Israeli,","poem":1},{"text":"uli ndi anthu amene anadzipereka okha mwaufulu pakati pa anthu.","poem":2},{"lineBreak":true},{"text":"Tamandani Yehova!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Inu okwera pa abulu oyera,","poem":1},{"text":"okhala pa zishalo,","poem":2},{"lineBreak":true},{"text":"ndi inu oyenda pa msewu,","poem":2},{"text":"yankhulani.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Ku zitsime, kutali ndi phokoso la a mauta;","poem":1},{"text":"kumeneko akusimba za kuti Yehova wapambana;","poem":2},{"lineBreak":true},{"text":"akusimba kuti Yehova walipsira anthu ake mu Israeli.","poem":2},{"lineBreak":true},{"text":"“Choncho anthu a Yehova","poem":1},{"text":"anasonkhana ku zipata za mzinda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anati, ‘Tsogolera ndiwe, Debora, tsogolera;","poem":1},{"text":"tsogolera ndiwe, tsogolera, imba nyimbo.","poem":2},{"text":"Iwe Baraki! nyamuka","poem":1},{"text":"Tsogolera akapolo ako, iwe mwana wa Abinoamu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Kenaka anthu okhulupirika anatsatira atsogoleri awo;","poem":1},{"text":"anthu a Yehova anapita","poem":2},{"text":"kukamenyera Yehova nkhondo","poem":1},{"text":"kulimbana ndi adani amphamvu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anakalowa mʼchigwa kuchokera ku Efereimu;","poem":1},{"text":"akutsatira iwe Benjamini ndi abale ako.","poem":2},{"text":"Akulu a ankhondo anachokera ku Makiri,","poem":1},{"text":"ndipo onyamula ndodo ya udindo anachokera ku Zebuloni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Olamulira a Isakara anali pamodzi ndi Debora;","poem":1},{"text":"inde, anthu ochokera ku Isakara anatsatanso Baraki,","poem":2},{"lineBreak":true},{"text":"ndipo anathamangira ku chigwa akumutsatira.","poem":2},{"text":"Koma pakati pa mafuko a Rubeni","poem":1},{"text":"panali kusinkhasinkha mtima kwambiri osadziwa chenicheni choyenera kuchita.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Chifukwa chiyani munangokhala ku makola a nkhosa nʼkumangomvetsera","poem":1},{"text":"zitoliro zoyitanira nkhosa?","poem":2},{"text":"Pakati pa anthu a fuko la Rubeni","poem":1},{"text":"panali kusinkhasinkha mtima kwambiri osadziwa chenicheni choyenera kuti achite.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Agiliyadi anatsala pa tsidya la Yorodani.","poem":1},{"text":"Ndipo nʼchifukwa chiyani anthu afuko la Dani anatsarira mʼsitima za pa madzi?","poem":2},{"text":"Aseri anali pa gombe la Nyanja;","poem":1},{"text":"anangokhala mʼmadooko mwawo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Azebuloni ndi anthu amene anayika moyo wawo mʼzoopsa.","poem":1},{"text":"Nawonso anthu a fuko la Nafutali anayika miyoyo yawo pa chiswe pomenya nkhondo pamwamba pa mapiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Mafumu anabwera, anachita nkhondo;","poem":1},{"text":"mafumu Akanaani anachita nkhondo","poem":2},{"text":"ku Tanaki pafupi ndi madzi a ku Megido,","poem":1},{"text":"koma sanatengeko zofunkha zasiliva.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngakhalenso nyenyezi zakumwamba zinachita nkhondo,","poem":1},{"text":"zinathira nkhondo Sisera, zikuyenda mʼnjira zake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mtsinje wa Kisoni unawakokolola,","poem":1},{"text":"chigumula cha mtsinje wa Kisoni chinawakokolola.","poem":2},{"lineBreak":true},{"text":"Mtima wanga, yenda mwamphamvu, limbika!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ndipo ziboda za ngʼombe zazimuna zinachita phokoso lalikulu,","poem":1},{"text":"akavalo ali pa liwiro, akuthamanga kwambiri.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mngelo wa Yehova anati ‘Tembererani Merozi.’","poem":1},{"text":"‘Tembererani nzika zake mwaukali,","poem":2},{"text":"chifukwa sanabwere kudzathandiza Yehova,","poem":1},{"text":"kulimbana ndi adani ake amphamvu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Akhale wodala kupambana akazi onse,","poem":1},{"text":"Yaeli mkazi wa Heberi Mkeni;","poem":2},{"lineBreak":true},{"text":"inde mwa akazi onse okhala mʼdziko, akhale wodala iyeyu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Munthu uja anapempha madzi akumwa, koma iye anamupatsa mkaka;","poem":1},{"text":"anamupatsa chambiko mʼchikho cha wolemekezeka.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Anatenga chikhomo cha tenti mʼdzanja lake,","poem":1},{"text":"anatenganso nyundo ndi dzanja lake lamanja.","poem":2},{"text":"Ndipo anakhoma nacho Sisera, anamuphwanya mutu wake,","poem":1},{"text":"ndi kumubowola mu litsipa mwake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Anathifukira ku mapazi a mkaziyo nagwa,","poem":1},{"text":"anagwa; iye anagona pamenepo.","poem":2},{"text":"Anagwera pa mapazi a mkaziyo, iye anagwa;","poem":1},{"text":"pamene anagwera, pamenepo anaferapo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Amayi ake a Sisera anasuzumira pa zenera;","poem":1},{"text":"nafuwula mokweza kuti,","poem":2},{"text":"‘Nʼchifukwa chiyani galeta lake lachedwa kufika?","poem":1},{"text":"Nʼchifukwa chiyani phokoso la magaleta ake silikumveka?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Amayi ake anzeru kwambiri anamuyankha,","poem":1},{"text":"ndithudi, mwiniwake anadziyankha yekha kuti,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘Kodi iwo sakufunafuna zofunkha kuti agawane;","poem":1},{"text":"akugawana wankhondo aliyense mtsikana mmodzi kapena awiri.","poem":2},{"lineBreak":true},{"text":"Sisera akumupatsa zofunkha:","poem":2},{"lineBreak":true},{"text":"zovala zonyikidwa mu utoto,","poem":2},{"lineBreak":true},{"text":"zoti ndizivala mʼkhosi","poem":2},{"text":"zovala zopeta zonyika mu utoto, ndi zopeta zomavala mʼkhosi?’","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Choncho Yehova! adani anu onse awonongeke,","poem":1},{"text":"koma iwo amene amakukondani inu akhale ngati dzuwa","poem":2},{"lineBreak":true},{"text":"pamene lituluka ndi mphamvu zake.”","poem":2},"Ndipo dziko linakhala pa mtendere zaka makumi anayi."]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}