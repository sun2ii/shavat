{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["Mulungu ndi Mafano"]},{"type":"verse","number":1,"content":["Inu Aisraeli, imvani zimene Yehova akunena."]},{"type":"verse","number":2,"content":["Yehova akuti,",{"text":"“Musatsatire makhalidwe a anthu a mitundu ina","poem":1},{"text":"kapena kuchita mantha ndi zizindikiro zamlengalenga,","poem":2},{"lineBreak":true},{"text":"ngakhale anthu a mitundu ina amachita nazo mantha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pakuti miyambo ya mitundu inayo ndiyachabechabe.","poem":1},{"text":"Iwo amakadula mtengo ku nkhalango","poem":2},{"lineBreak":true},{"text":"ndipo mmisiri amawusema ndi sompho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amakongoletsa chosemacho ndi siliva ndi golide;","poem":1},{"text":"kenaka amachikhomerera ndi misomali","poem":2},{"lineBreak":true},{"text":"kuti chisagwedezeke.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mafano awo ali ngati mtengo wakanjedza woopsezera mbalame mʼmunda wa minkhaka.","poem":1},{"text":"Mafanowo sangathe nʼkuyankhula komwe","poem":2},{"text":"ndipo ayenera kunyamulidwa","poem":1},{"text":"popeza sangathe nʼkuyenda komwe.","poem":2},{"text":"Musachite nawo mantha","poem":1},{"text":"popeza sangathe kukuchitani choyipa","poem":2},{"lineBreak":true},{"text":"ndiponso alibe mphamvu yochitira chabwino chilichonse.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Palibe wofanana nanu, Inu Yehova;","poem":1},{"text":"Inu ndinu wamkulu,","poem":2},{"lineBreak":true},{"text":"ndipo dzina lanu lili ndi mphamvu yayikulu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndani amene angaleke kukuopani,","poem":1},{"text":"inu Mfumu ya mitundu ya anthu?","poem":2},{"lineBreak":true},{"text":"Chimenechi ndicho chokuyenerani.","poem":2},{"text":"Pakati pa anthu anzeru onse komanso mafumu onse","poem":1},{"text":"a mitundu ya anthu,","poem":2},{"lineBreak":true},{"text":"palibe wina wofanana nanu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onsewo ndi opusa ndi opanda nzeru;","poem":1},{"text":"malangizo awo amawatenga kuchokera kwa mafano achabechabe opanga ndi mitengo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Siliva wosula amabwera naye kuchokera ku Tarisisi","poem":1},{"text":"ndipo golide amachokera naye ku Ufazi.","poem":2},{"text":"Mafanowo ndi ntchito ya anthu aluso ndi odziwa kuzokota golide.","poem":1},{"text":"Tsono mafanowo amawaveka zovala za mtundu wamtambo ndi pepo.","poem":2},{"lineBreak":true},{"text":"Yonseyo ndi ntchito ya anthu a luso.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Koma Yehova ndiye Mulungu woona;","poem":1},{"text":"Iyeyo ndiye Mulungu wamoyo, Mfumu yamuyaya.","poem":2},{"text":"Akakwiya, dziko limagwedezeka;","poem":1},{"text":"anthu a mitundu ina sangathe kupirira ukali wakewo.","poem":2}]},{"type":"verse","number":11,"content":["“Awuze anthu awa kuti, ‘Milungu iyi, imene sinalenge dziko lakumwamba ndi dziko lapansi, idzawonongeka pa dziko lapansi ndi pansi pa thambo.’ ”"]},{"type":"verse","number":12,"content":[{"text":"Koma Mulungu analenga dziko lapansi ndi mphamvu zake;","poem":1},{"text":"Iye anapanga dziko lonse ndi nzeru zake","poem":2},{"lineBreak":true},{"text":"ndipo anayala thambo mwaluso lake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iye akayankhula, kumamveka mkokomo wamadzi akumwamba;","poem":1},{"text":"Iyeyo amabweretsa mitambo kuchokera ku malekezero a dziko lapansi.","poem":2},{"text":"Amabweretsa mphenzi pamodzi ndi mvula","poem":1},{"text":"ndi kutulutsa mphepo yamkuntho kumalo kumene osungirako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Anthu onse ndi opusa ndiponso opanda nzeru;","poem":1},{"text":"mmisiri aliyense wosula golide akuchita manyazi ndi mafano ake.","poem":2},{"text":"Mafano akewo ndi abodza;","poem":1},{"text":"alibe moyo mʼkati mwawo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mafanowo ndi achabechabe, zinthu zosekedwa nazo.","poem":1},{"text":"Pamene anthuwo azidzaweruzidwa, mafanowo adzawonongedwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Koma Yehova amene ndi Cholowa cha Yakobo sali ngati mafanowo.","poem":1},{"text":"Iyeyu ndi Mlengi wa zinthu zonse","poem":2},{"text":"kuphatikizapo Israeli, mtundu umene anawusankha kuti ukhale anthu ake.","poem":1},{"text":"Dzina lake ndi Yehova Wamphamvuzonse.","poem":2}]},{"type":"heading","content":["Chiwonongeko Chikubwera"]},{"type":"verse","number":17,"content":[{"text":"Sonkhanitsani katundu wanu,","poem":1},{"text":"inu amene mukukhala mʼlinga la ankhondo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pakuti Yehova akuti,","poem":1},{"text":"“Tsopano Ine ndidzachotsa anthu onse","poem":2},{"lineBreak":true},{"text":"amene akukhala mʼdziko lino;","poem":2},{"text":"adzakhala pa mavuto","poem":1},{"text":"mpaka adzamvetsa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Aliyense ankangoti, “Mayo ine, chifukwa cha kupweteka kwanga!","poem":1},{"text":"Chilonda changa nʼchachikulu!”","poem":2},{"text":"Koma ine ndinkaganiza kuti, “Ndithu, ili ndi vuto langa basi,","poem":1},{"text":"choncho ndingolipirira.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tenti yanga yawonongeka,","poem":1},{"text":"zingwe zake zonse zaduka.","poem":2},{"text":"Ana anga andisiya ndipo kulibenso.","poem":1},{"text":"Palibenso amene adzandimangire tenti,","poem":2},{"lineBreak":true},{"text":"kapena kufunyulula nsalu yake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abusa ndi opusa","poem":1},{"text":"ndipo sanapemphe nzeru kwa Yehova;","poem":2},{"text":"choncho palibe chimene anapindula","poem":1},{"text":"ndipo nkhosa zawo zonse zabalalika.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tamvani! kukubwera mphekesera,","poem":1},{"text":"phokoso lalikulu la gulu la a ankhondo likumveka kuchokera kumpoto!","poem":2},{"text":"Lidzasandutsa bwinja mizinda ya ku Yuda,","poem":1},{"text":"malo okhala nkhandwe.","poem":2}]},{"type":"heading","content":["Pemphero la Yeremiya"]},{"type":"verse","number":23,"content":[{"text":"Inu Yehova, ndikudziwa kuti moyo umene munthu ali nawo si wake;","poem":1},{"text":"munthuyo sangathe kuwongolera mayendedwe ake.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Inu Yehova, langizeni, komatu mwachilungamo,","poem":1},{"text":"osati ndi mkwiyo wanu,","poem":2},{"lineBreak":true},{"text":"mungandiwononge kotheratu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tsanulirani ukali wanu pa mitundu ya anthu amene sakudziwani,","poem":1},{"text":"ndiye kuti mitundu ya anthu amene satama pa dzina lanu mopemba.","poem":2},{"text":"Iwo aja anasakaza Yakobo;","poem":1},{"text":"amusakaza kotheratu","poem":2},{"lineBreak":true},{"text":"ndipo awononga dziko lake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}