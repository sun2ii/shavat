{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Madandawulo a Yeremiya"]},{"type":"verse","number":1,"content":[{"text":"Yehova, Inu mumakhala wokhoza nthawi zonse","poem":1},{"text":"ndikati nditsutsane nanu.","poem":2},{"text":"Komabe ndikufuna kuyankhula nanu za mlandu wanga.","poem":1},{"text":"Chifukwa chiyani anthu oyipa zinthu zimawayendera bwino?","poem":2},{"lineBreak":true},{"text":"Chifukwa chiyani anthu achinyengo amakhala pabwino?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inu munawadzala ndipo anamera mizu;","poem":1},{"text":"amakula ndi kubereka zipatso.","poem":2},{"text":"Dzina lanu limakhala pakamwa pawo nthawi zonse,","poem":1},{"text":"koma mitima yawo imakhala kutali ndi Inu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Koma Inu Yehova, ine mumandidziwa;","poem":1},{"text":"mumandiona ndipo mumayesa zolingalira zanga.","poem":2},{"text":"Akokeni anthu oyipawo ngati nkhosa zokaphedwa!","poem":1},{"text":"Ayikeni padera mpaka tsiku loti akaphedwe!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kodi dziko lidzakhala likulirabe mpaka liti","poem":1},{"text":"ndipo udzu mʼmunda uliwonse udzakhalabe ofota mpaka liti?","poem":2},{"text":"Nyama ndi mbalame kulibiretu","poem":1},{"text":"chifukwa anthu amene amakhalamo ndi oyipa.","poem":2},{"text":"Iwo amati:","poem":1},{"text":"“Yehova sangathe kuona ntchito zathu.”","poem":2}]},{"type":"heading","content":["Yankho la Mulungu"]},{"type":"verse","number":5,"content":[{"text":"Yehova anayankha kuti, “Ngati kukutopetsa kuthamanga pamodzi ndi anthu","poem":1},{"text":"nanga ungapikisane bwanji ndi akavalo?","poem":2},{"lineBreak":true},{"text":"Ngati ukupunthwa ndi kugwa pa malo abwino,","poem":2},{"text":"udzatha bwanji kuthamanga mʼnkhalango","poem":1},{"text":"za ku Yorodani?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngakhale abale ako","poem":1},{"text":"ndi anansi akuwukira,","poem":2},{"lineBreak":true},{"text":"onsewo amvana zokuyimba mlandu.","poem":2},{"text":"Usawakhulupirire,","poem":1},{"text":"ngakhale ayankhule zabwino ndi iwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ine ndawasiya anthu anga;","poem":1},{"text":"anthu amene ndinawasankha ndawataya.","poem":2},{"text":"Ndapereka okondedwa anga","poem":1},{"text":"mʼmanja mwa adani awo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anthu amene ndinawasankha","poem":1},{"text":"asanduka ngati mkango wa mʼnkhalango.","poem":2},{"text":"Akundibangulira mwaukali;","poem":1},{"text":"nʼchifukwa chake Ine ndikudana nawo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anthu anga amene ndinawasankha","poem":1},{"text":"asanduka ngati mbalame yolusa yamawangamawanga","poem":2},{"lineBreak":true},{"text":"imene akabawi ayizinga.","poem":2},{"text":"Pitani, kasonkhanitseni nyama zakuthengo.","poem":1},{"text":"Mubwere nazo kuti zidzadye mbalameyo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abusa ambiri anawononga munda wanga wa mpesa,","poem":1},{"text":"anapondereza munda wanga;","poem":2},{"text":"munda wanga wabwino uja","poem":1},{"text":"anawusandutsa chipululu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unawusandutsadi chipululu.","poem":1},{"text":"Ukanali wokhawokha chomwecho ukundilirira Ine.","poem":2},{"text":"Dziko lonse lasanduka chipululu","poem":1},{"text":"chifukwa palibe wolisamalira.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anthu onse owononga abalalikira","poem":1},{"text":"ku zitunda zonse za mʼchipululu.","poem":2},{"text":"Yehova watuma ankhondo ake","poem":1},{"text":"kudzawatha kuyambira kumalire ena a dziko mpaka ku malire enanso a dziko,","poem":2},{"lineBreak":true},{"text":"ndipo palibe amene adzakhale pa mtendere.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anthu anafesa tirigu koma anatuta minga;","poem":1},{"text":"anadzitopetsa kugwira ntchito koma osapeza phindu lililonse.","poem":2},{"text":"Choncho mudzachita manyazi ndi zokolola zanu","poem":1},{"text":"chifukwa cha mkwiyo wa Yehova.”","poem":2}]},{"type":"verse","number":14,"content":["“Anthu oyipa oyandikana ndi anthu anga Aisraeli, akuwalanda Aisraeliwo dziko, cholowa chimene ndinawapatsa. Nʼchifukwa chake ndidzawachotsa mʼdziko limenelo, ndipo ndidzachotsa banja la Yuda pakati pawo."]},{"type":"verse","number":15,"content":["Komabe nditawachotsa, ndidzawachitiranso chifundo, ndipo ndidzabwezera aliyense cholowa chake ndi dziko lake."]},{"type":"verse","number":16,"content":["Ndipo ngati iwo adzaphunzira bwino njira za anthu anga ndi kulumbira mʼdzina langa, namanena kuti, ‘Pali Yehova wamoyo,’ monga iwo anaphunzitsira anthu anga kulumbira mʼdzina la Baala, Ine ndidzawakhazikitsa pakati pa anthu anga."]},{"type":"verse","number":17,"content":["Koma ngati mtundu wina uliwonse sudzamvera, Ine ndidzawuchotsa ndi kuwuwonongeratu,” akutero Yehova."]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}