{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Kenaka Yehova anandiwuza kuti, “Ngakhale Mose ndi Samueli akanayima pamaso panga kupempherera anthu awa, Ine sindikanawachitira chisoni. Achotseni ndipo ndisawaonenso! Aleke apite!"]},{"type":"verse","number":2,"content":["Ndipo ngati akufunsa iwe kuti, ‘Kodi tipite kuti?’ uwawuze kuti, ‘Yehova akuti,",{"text":"“ ‘Oyenera kufa adzafa;","poem":1},{"lineBreak":true},{"text":"oyenera kufa ndi lupanga adzafa ndi lupanga;","poem":1},{"lineBreak":true},{"text":"oyenera kufa ndi njala adzafa ndi njala;","poem":1},{"lineBreak":true},{"text":"oyenera kupita ku ukapolo adzapita ku ukapolo.’","poem":1}]},{"type":"verse","number":3,"content":["“Ine ndidzawatumizira mitundu inayi ya zinthu zowononga,” akutero Yehova, “lupanga lowapha, agalu owaluma, mbalame zamumlengalenga ndiponso zirombo zoti ziwadye ndi kuwawononga."]},{"type":"verse","number":4,"content":["Ndidzawasandutsa kukhala chinthu chonyansa kwa anthu a maufumu onse a dziko lapansi chifukwa cha zimene Manase mwana wa Hezekiya mfumu ya Yuda anachita mu Yerusalemu."]},{"type":"verse","number":5,"content":[{"text":"“Kodi adzakumvera chisoni ndani, Yerusalemu?","poem":1},{"text":"Kodi adzakulira ndani?","poem":2},{"lineBreak":true},{"text":"Kodi ndani amene adzapatuka kufunsa za moyo wako?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inu mwandikana Ine,” akutero Yehova.","poem":1},{"text":"“Inu mukubwererabe mʼmbuyo.","poem":2},{"text":"Choncho Ine ndidzakukanthani.","poem":1},{"text":"Ndatopa ndi kukuchitirani chifundo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ine ndidzakubalalitsani kukuchotsani mʼmizinda ya mʼdzikomo","poem":1},{"text":"monga mmene amachitira ndi mankhusu popeta ndi lichero.","poem":2},{"text":"Anthu anga ndinawaliritsa ndi kuwawononga","poem":1},{"text":"chifukwa sanasinthe makhalidwe awo oyipa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndinachulukitsa amayi awo amasiye","poem":1},{"text":"kupambana mchenga wa kunyanja.","poem":2},{"text":"Amayiwo ndinawawonongera ana awo aamuna","poem":1},{"text":"dzuwa lili pamutu.","poem":2},{"text":"Mwadzidzidzi ndinawagwetsera","poem":1},{"text":"kuwawa mtima ndi mantha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mayi wa ana asanu ndi awiri wakomoka","poem":1},{"text":"ndipo akupuma wefuwefu.","poem":2},{"text":"Dzuwa lake lalowa ukanali usana;","poem":1},{"text":"anamuchititsa manyazi ndipo wathedwa nzeru.","poem":2},{"text":"Otsala ndidzawapereka mʼmanja mwa adani awo","poem":1},{"text":"kuti awaphe ndi lupanga,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kalanga ine, amayi pakuti munandibereka ine,","poem":1},{"text":"munthu amene ndikutsutsana ndi kulimbana ndi anthu pa dziko lonse!","poem":2},{"text":"Ine sindinakongoze kapena kukongola kanthu,","poem":1},{"text":"komatu aliyense akunditemberera.","poem":2}]},{"type":"verse","number":11,"content":["Yehova anati,",{"text":"“Ndithudi, Ine ndidzakulanditsa kuti upeze bwino.","poem":1},{"text":"Ndithudi, adani ako adzakupempha pa nthawi ya tsoka","poem":2},{"lineBreak":true},{"text":"ndi ya mavuto awo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Palibe munthu amene angathe kudula chitsulo,","poem":1},{"text":"makamaka chitsulo chochokera kumpoto chosakaniza ndi mkuwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anthu ako ndi chuma chako","poem":1},{"text":"ndidzazipereka kwa ofunkha popanda malipiro,","poem":2},{"text":"chifukwa cha machimo anu onse","poem":1},{"text":"a mʼdziko lanu lonse.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndidzakusandutsani akapolo a adani anu","poem":1},{"text":"mʼdziko limene inu simulidziwa,","poem":2},{"text":"chifukwa mkwiyo wanga wayaka ngati moto","poem":1},{"text":"umene udzakutenthani.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ine ndinati, “Inu Yehova, mumadziwa zonse;","poem":1},{"text":"kumbukireni ndi kundisamalira.","poem":2},{"lineBreak":true},{"text":"Ndilipsireni anthu ondizunza.","poem":2},{"text":"Ndilezereni mtima musandilande moyo wanga.","poem":1},{"text":"Onani momwe ndi kuvutikira chifukwa cha Inu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Munandiyankhula ndipo mawu anu ndinawalandira bwino.","poem":1},{"text":"Mawu anu anandipatsa chimwemwe ndipo mtima wanga unasangalala.","poem":2},{"text":"Paja ine, Yehova Mulungu Wamphamvuzonse,","poem":1},{"text":"ndimadziwika ndi dzina lanu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sindinakhale nawo mʼgulu la anthu amadyera,","poem":1},{"text":"sindinasangalale nawo anthu amenewo.","poem":2},{"text":"Ndinakhala ndekha chifukwa choti dzanja lanu linali pa ine","poem":1},{"text":"ndipo munadzaza mu mtima mwanga ndi mkwiyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nanga nʼchifukwa chiyani mavuto anga sakutha?","poem":1},{"text":"Bwanji chilonda changa sichikupola?","poem":2},{"text":"Kodi inu mudzakhala ngati mtsinje wowuma nthawi yachilimwe,","poem":1},{"text":"kapena ngati kasupe wopanda madzi?”","poem":2}]},{"type":"verse","number":19,"content":["Tsono Yehova anandiyankha kuti,",{"text":"“Ukabwerera kwa Ine, ndidzakulandiranso","poem":1},{"text":"ndipo udzakhalanso mtumiki wanga.","poem":2},{"text":"Ngati udzayankhula mawu oyenera osati achabechabe,","poem":1},{"text":"udzakhalanso mneneri wanga.","poem":2},{"text":"Anthu adzabwera kwa iwe","poem":1},{"text":"ndipo sipadzafunika kuti iwe upite kwa iwo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndidzakusandutsa ngati khoma lolimba","poem":1},{"text":"ngati mkuwa kwa anthu awa.","poem":2},{"text":"Adzalimbana nawe","poem":1},{"text":"koma sadzakugonjetsa,","poem":2},{"text":"pakuti Ine ndili nawe","poem":1},{"text":"kukulanditsa ndi kukupulumutsa,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":21,"content":[{"text":"“Ndidzakupulumutsa mʼdzanja la anthu oyipa","poem":1},{"text":"ndipo ndidzakuwombola kwa anthu ankhanza.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}