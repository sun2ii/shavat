{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Aisraeli Asiya Mulungu"]},{"type":"verse","number":1,"content":["Yehova anandiwuza kuti,"]},{"type":"verse","number":2,"content":["“Pita ukalengeze kwa anthu a ku Yerusalemu kuti Yehova akuti,",{"text":"“ ‘Ine ndikukumbukira mmene umakhulupirikira pa unyamata wako,","poem":1},{"text":"mmene unkandikondera ngati momwe amachitira mkwatibwi,","poem":2},{"text":"mmene unkanditsata mʼchipululu muja;","poem":1},{"text":"mʼdziko losadzalamo kanthu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Israeli anali wopatulika wa Yehova,","poem":1},{"text":"anali ngati zipatso zake zoyamba kucha pa nthawi yokolola;","poem":2},{"text":"onse amene anamuzunza anapezeka kuti ndi olakwa","poem":1},{"text":"ndipo mavuto anawagwera,’ ”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Imvani mawu a Yehova, inu zidzukulu za Yakobo,","poem":1},{"text":"inu mafuko onse a Israeli.","poem":2}]},{"type":"verse","number":5,"content":["Yehova akuti,",{"text":"“Kodi makolo anu anandipeza nʼcholakwa chanji,","poem":1},{"text":"kuti andithawe?","poem":2},{"text":"Iwo anatsata milungu yachabechabe,","poem":1},{"text":"nawonso nʼkusanduka achabechabe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iwo sanafunse nʼkomwe kuti, ‘Kodi Yehova ali kuti,","poem":1},{"text":"amene anatitulutsa mʼdziko la Igupto","poem":2},{"text":"natitsogolera mʼchipululu mʼdziko lowuma","poem":1},{"text":"ndi lokumbikakumbika,","poem":2},{"text":"mʼdziko lopanda mvula ndi la mdima,","poem":1},{"text":"dziko limene munthu sadutsamo ndipo simukhala munthu aliyense?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndinakufikitsani ku dziko lachonde","poem":1},{"text":"kuti mudye zipatso zake ndi zabwino zake zina.","poem":2},{"text":"Koma inu mutafika munaliyipitsa dziko langa","poem":1},{"text":"ndi kusandutsa cholowa changa kukhala chonyansa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ansembe nawonso sanafunse kuti,","poem":1},{"text":"‘Yehova ali kuti?’","poem":2},{"text":"Iwo amene amaphunzitsa malamulo sanandidziwe;","poem":1},{"text":"atsogoleri anandiwukira.","poem":2},{"text":"Aneneri ankanenera mʼdzina la Baala,","poem":1},{"text":"ndi kutsatira mafano achabechabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Chifukwa chake Ine ndidzakuyimbaninso mlandu,”","poem":1},{"text":"akutero Yehova.","poem":4},{"text":"“Ndipo ndidzayimbanso mlandu zidzukulu zanu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pitani kumadzulo ku chilumba cha Kitimu, ndipo mukaone,","poem":1},{"text":"tumizani anthu ku Kedara kuti akafufuze bwino;","poem":2},{"lineBreak":true},{"text":"ndipo muona kuti zinthu zoterezi sizinachitikepo nʼkale lomwe:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodi ulipo mtundu wa anthu uliwonse umene unasinthapo milungu yake?","poem":1},{"text":"(Ngakhale kuti si milungu nʼkomwe).","poem":2},{"text":"Koma anthu anga asinthitsa Mulungu wawo waulemerero","poem":1},{"text":"ndi mafano achabechabe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inu mayiko akumwamba, dabwani ndi zimenezi,","poem":1},{"text":"ndipo njenjemerani ndi mantha aakulu,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"“Popeza anthu anga achita machimo awiri:","poem":1},{"lineBreak":true},{"text":"Andisiya Ine","poem":1},{"text":"kasupe wa madzi a moyo,","poem":2},{"text":"ndi kukadzikumbira zitsime zawo,","poem":1},{"text":"zitsime zongʼaluka, zomwe sizingathe kusunga madzi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israeli si wantchito kapena kapolo wobadwira mʼnyumba, ayi.","poem":1},{"text":"Nanga nʼchifukwa chiyani amuwononga chotere?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Adani ake abangulira","poem":1},{"text":"ndi kumuopseza ngati mikango.","poem":2},{"text":"Dziko lake analisandutsa bwinja;","poem":1},{"text":"mizinda yake anayitentha popanda wokhalamo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndiponso Aigupto a ku Mefisi ndi a ku Tapanesi","poem":1},{"text":"akuphwanyani mitu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Zimenezitu zakuchitikirani","poem":1},{"text":"chifukwa munasiya Yehova Mulungu wanu","poem":2},{"lineBreak":true},{"text":"pamene Iye ankakutsogolerani pa njira yanu?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tsopano mudzapindula chiyani mukapita ku Igupto,","poem":1},{"text":"kukamwa madzi a mu Sihori?","poem":2},{"text":"Ndipo mudzapindulanji mukapita ku Asiriya,","poem":1},{"text":"kukamwa madzi a mu mtsinje wa Yufurate?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kuyipa kwanuko kudzakulangani;","poem":1},{"text":"kubwerera mʼmbuyo kwanuko kudzakutsutsani.","poem":2},{"text":"Tsono ganizirani bwino,","poem":1},{"text":"popeza ndi chinthu choyipa","poem":2},{"text":"kundisiya Ine Yehova Mulungu wanu;","poem":1},{"text":"ndi chinthu chowawa ndithu kusandiopa Ine Mulungu wanu.","poem":2},{"text":"Akutero Ambuye Yehova Wamphamvuzonse.","poem":4}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Kuyambira kalekale inu munathyola goli lanu","poem":1},{"text":"ndi kudula msinga zanu;","poem":2},{"lineBreak":true},{"text":"munanena kuti, ‘Sitidzakutumikirani!’","poem":2},{"text":"Ndithudi, inu mwakhala ngati mkazi wachiwerewere.","poem":1},{"text":"Mukupembedza milungu ina pa phiri lililonse lalitali","poem":2},{"lineBreak":true},{"text":"ndiponso pansi pa mtengo uliwonse wa masamba ambiri.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ine ndinakudzala iwe ngati mtengo wampesa wosankhika;","poem":1},{"text":"unali mpesa wabwino kwambiri ndi wodalirika.","poem":2},{"text":"Nanga nʼchifukwa chiyani wasanduka mpesa","poem":1},{"text":"wachabechabe wonga wa kutchire?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ngakhale utasamba ndi soda","poem":1},{"text":"kapena kusambira sopo wambiri,","poem":2},{"lineBreak":true},{"text":"kuthimbirira kwa machimo ako kumaonekabe pamaso panga,”","poem":2},{"text":"akutero Ambuye Yehova.","poem":4}]},{"type":"verse","number":23,"content":[{"text":"“Iwe ukunena bwanji kuti, ‘Ine sindinadziyipitse;","poem":1},{"text":"sindinatsatire Abaala’?","poem":2},{"text":"Takumbukira mmene unkandichimwira mʼchigwa muja;","poem":1},{"text":"zindikira bwino zomwe wachita.","poem":2},{"text":"Iwe uli ngati ngamira yayikazi yaliwiro","poem":1},{"text":"yomangothamanga uku ndi uku,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"wakhala ngati mbidzi yozolowera mʼchipululu,","poem":1},{"text":"yonka ninunkhiza pa nthawi yachisika.","poem":2},{"lineBreak":true},{"text":"Ndani angayiretse chilakolako chakecho?","poem":2},{"text":"Mphongo iliyonse yoyikhumba sidzavutika.","poem":1},{"text":"Pa nthawi yachisika chakecho mphongoyo idzayipeza.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Iwe usathamange, nsapato zingakuthere kuphazi","poem":1},{"text":"ndi kukhosi kwako kuwuma ndi ludzu.","poem":2},{"text":"Koma unati, ‘Zamkutu!","poem":1},{"text":"Ine ndimakonda milungu yachilendo,","poem":2},{"lineBreak":true},{"text":"ndipo ndidzayitsatira.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Monga momwe mbala imachitira manyazi pamene yagwidwa,","poem":1},{"text":"moteronso nyumba ya Israeli idzachita manyazi;","poem":2},{"text":"Aisraeliwo, mafumu ndi akuluakulu awo,","poem":1},{"text":"ansembe ndi aneneri awo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Iwo amawuza mtengo kuti, ‘Iwe ndiwe abambo athu,’","poem":1},{"text":"ndipo amawuza mwala kuti, ‘Iwe ndiye amene unatibala.’","poem":2},{"text":"Iwo andifulatira Ine,","poem":1},{"text":"ndipo safuna kundiyangʼana;","poem":2},{"text":"Koma akakhala pa mavuto amati,","poem":1},{"text":"‘Bwerani mudzatipulumutse!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nanga ili kuti milungu yanu imene munadzipangira nokha?","poem":1},{"text":"Ibweretu ngati ingathe kukupulumutsani","poem":2},{"lineBreak":true},{"text":"pamene muli pamavuto!","poem":2},{"text":"Inu anthu a ku Yuda,","poem":1},{"text":"milungu yanu ndi yambiri kuchuluka kwake ngati mizinda yanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Kodi mukundizengeranji mlandu?","poem":1},{"text":"Nonse mwandiwukira,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":30,"content":[{"text":"“Ine ndinalanga anthu ako popanda phindu;","poem":1},{"text":"iwo sanaphunzirepo kanthu.","poem":2},{"text":"Monga mkango wolusa,","poem":1},{"text":"lupanga lanu lapha aneneri anu.","poem":2}]},{"type":"verse","number":31,"content":["“Inu anthu a mʼbado uno, ganizirani bwino mawu a Yehova:",{"text":"“Kodi Ine ndinakhalapo ngati chipululu kwa Israeli","poem":1},{"text":"kapena ngati dziko la mdima wandiweyani?","poem":2},{"text":"Chifukwa chiyani anthu anga akunena kuti, ‘Ife tili ndi ufulu omayendayenda;","poem":1},{"text":"sitidzabweranso kwa Inu’?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kodi namwali amayiwala zokongoletsera zake,","poem":1},{"text":"kapena kuyiwala zovala zake za ukwati?","poem":2},{"text":"Komatu anthu anga andiyiwala","poem":1},{"text":"masiku osawerengeka.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mumadziwa bwino njira zopezera zibwenzi!","poem":1},{"text":"Choncho ngakhale akazi oyipa omwe mumawaphunzitsa njira zanu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ngakhale pa zovala zako anthu amapezapo","poem":1},{"text":"magazi a anthu osauka osalakwa.","poem":2},{"lineBreak":true},{"text":"Anthuwo simunawapeze akuthyola nyumba.","poem":2},{"text":"Komabe ngakhale zinthu zili chomwechi,","poem":1}]},{"type":"verse","number":35,"content":[{"text":"inu mukunena kuti, ‘Ndife osalakwa,","poem":2},{"lineBreak":true},{"text":"sadzatikwiyira.’","poem":2},{"text":"Ndidzakuyimbani mlandu","poem":1},{"text":"chifukwa mukunena kuti, ‘Ife sitinachimwe.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Chifukwa chiyani","poem":1},{"text":"mukunkabe nimusinthasintha njira zanu?","poem":2},{"text":"Aigupto adzakukhumudwitsani","poem":1},{"text":"monga momwe Asiriya anakuchititsani manyazi.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Mudzachokanso kumeneko","poem":1},{"text":"manja ali kunkhongo.","poem":2},{"text":"Popeza Ine Yehova ndawakana anthu amene munkawadalira,","poem":1},{"text":"choncho sadzakuthandizani konse.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}