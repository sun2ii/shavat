{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Kubwezeretsedwa kwa Israeli"]},{"type":"verse","number":1,"content":["Yehova anawuza Yeremiya kuti,"]},{"type":"verse","number":2,"content":["“Ine Yehova, Mulungu wa Israeli ndikuti, ‘Lemba mʼbuku mawu onse amene ndakuwuza."]},{"type":"verse","number":3,"content":["Nthawi ikubwera pamene ndidzachotse anthu anga, Israeli ndi Yuda kuchokera ku ukapolo ndi kuwabwezera dziko limene ndinapatsa makolo awo,’ akutero Yehova.”"]},{"type":"verse","number":4,"content":["Nawa mawu amene Yehova anayankhula ndi anthu a ku Israeli ndi Yuda:"]},{"type":"verse","number":5,"content":["“Yehova akuti:",{"text":"“Ndamva kulira chifukwa cha nkhawa,","poem":1},{"text":"ndamva kulira kwa mantha popeza palibe mtendere.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsono khalani pansi ndi kudzifunsa kuti:","poem":1},{"text":"Kodi munthu wamwamuna angathe kubereka mwana?","poem":2},{"text":"Nanga nʼchifukwa chiyani ndikuona munthu aliyense wamwamuna","poem":1},{"text":"atagwira manja ake pa mimba pake ngati mayi pa nthawi yake yochira?","poem":2},{"lineBreak":true},{"text":"Chifukwa chiyani nkhope iliyonse ili yakugwa?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mayo ine! Tsiku limeneli ndi lalikulu kwambiri!","poem":1},{"text":"Sipadzakhala lina lofanana nalo.","poem":2},{"text":"Idzakhala nthawi ya masautso kwa Yakobo,","poem":1},{"text":"koma adzapulumuka ku masautsowo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yehova Wamphamvuzonse akuti, “Pa tsiku limenelo,","poem":1},{"text":"ndidzathyola goli la ukapolo mʼkhosi mwawo","poem":2},{"text":"ndipo ndidzadula zingwe zowamanga;","poem":1},{"text":"Aisraeli sadzakhalanso akapolo a alendo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mʼmalo mwake, adzatumikira Yehova Mulungu wawo","poem":1},{"text":"ndiponso Davide mfumu yawo,","poem":2},{"lineBreak":true},{"text":"amene ndidzawasankhira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Tsono usachite mantha, iwe mtumiki wanga Yakobo;","poem":1},{"text":"usade nkhawa, iwe Israeli,’","poem":2},{"text":"akutero Yehova.","poem":4},{"text":"‘Ndithu ndidzakupulumutsa kuchokera ku dziko lakutali,","poem":1},{"text":"zidzukulu zako kuchokera ku dziko la ukapolo wawo.","poem":2},{"text":"Yakobo adzabwerera ndipo adzakhala modekha pa mtendere,","poem":1},{"text":"ndipo palibe amene adzamuchititsa mantha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ine ndili nanu ndipo ndidzakupulumutsani,’","poem":1},{"text":"akutero Yehova.","poem":2},{"text":"‘Ngakhale ndidzawononga kotheratu mitundu yonse ya anthu","poem":1},{"text":"kumene ndinakubalalitsirani,","poem":2},{"lineBreak":true},{"text":"koma inu sindidzakuwonongani kotheratu.","poem":2},{"text":"Sindidzakulekani kuti mukhale osalangidwa.","poem":1},{"text":"Koma ndidzakulangani mwachilungamo.’ ”","poem":2}]},{"type":"verse","number":12,"content":["Yehova akuti,",{"text":"“Chilonda chanu nʼchosachizika,","poem":1},{"text":"bala lanu ndi lonyeka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Palibe amene angathe kukutetezani pa mlandu wanu,","poem":1},{"text":"palibe chiyembekezo choti inu nʼkuchira,","poem":2},{"lineBreak":true},{"text":"palibe mankhwala ochiritsa inu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abwenzi anu onse akuyiwalani;","poem":1},{"text":"sasamalanso za inu.","poem":2},{"text":"Ndakukanthani ngati mmene mdani akanachitira.","poem":1},{"text":"Ndipo ndakulangani mwa nkhanza,","poem":2},{"text":"chifukwa machimo anu ndi ambiri,","poem":1},{"text":"ndipo kulakwa kwanu ndi kwakukulu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Chifukwa chiyani mukulira nacho chilonda chanu?","poem":1},{"text":"Bala lanu silingapole ayi.","poem":2},{"text":"Ine ndakuchitani zimenezi chifukwa machimo anu ndi ambiri","poem":1},{"text":"ndipo kulakwa kwanu nʼkwakukulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Tsono onse amene anakuwonongani, nawonso adzawonongedwa;","poem":1},{"text":"adani anu onse adzapita ku ukapolo.","poem":2},{"text":"Iwo amene anafunkha zinthu zanu, zinthu zawo zidzafunkhidwanso;","poem":1},{"text":"onse amene anakusakazani nawonso adzasakazidwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndidzachiza matenda anu","poem":1},{"text":"ndi kupoletsa zilonda zanu,","poem":2},{"text":"akutero Yehova,","poem":4},{"text":"‘chifukwa mukutchedwa anthu otayika.","poem":1},{"text":"Amati, ndi anthu a ku Ziyoni awa amene alibe wowasamala.’ ”","poem":2}]},{"type":"verse","number":18,"content":["Yehova akuti,",{"text":"“Ndidzabwera nalo banja la Yakobo ku dziko lawo","poem":1},{"text":"ndipo ndidzachitira chifundo malo ake okhalamo;","poem":2},{"text":"mzinda wa Yerusalemu udzamangidwanso pa bwinja pake,","poem":1},{"text":"nyumba yaufumu idzamangidwanso pa malo pake penipeni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Anthuwo adzayimba nyimbo zoyamika Yehova","poem":1},{"text":"ndipo kudzamveka phokoso lachisangalalo.","poem":2},{"text":"Ndidzawachulukitsa,","poem":1},{"text":"ndipo chiwerengero chawo sichidzatsika;","poem":2},{"text":"ndidzawapatsa ulemerero,","poem":1},{"text":"ndipo sadzanyozedwanso.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ana awo adzakhalanso monga mmene analili kale,","poem":1},{"text":"ndipo gulu lawo ndidzalikhazikitsa pamaso panga;","poem":2},{"lineBreak":true},{"text":"ndidzalanga onse owazunza.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mtsogoleri wawo adzakhala mmodzi mwa iwo.","poem":1},{"text":"Wodzawalamulira adzachokera pakati pawo.","poem":2},{"text":"Choncho ndidzawakokera kufupi ndi Ine ndipo iye adzandiyandikira.","poem":1},{"text":"Ndani angalimbe mtima payekha kuyandikana nane","poem":2},{"lineBreak":true},{"text":"popanda kuyitanidwa?”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"“Choncho inu mudzakhala anthu anga,","poem":1},{"text":"ndipo Ine ndidzakhala Mulungu wanu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Taonani ukali wa Yehova wowomba","poem":1},{"text":"ngati mphepo ya mkuntho.","poem":2},{"text":"Mphepo ya namondwe","poem":1},{"text":"ikuwomba pa mitu ya anthu oyipa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mkwiyo woopsa wa Yehova sudzachoka","poem":1},{"text":"mpaka atakwaniritsa zolinga","poem":2},{"lineBreak":true},{"text":"za mu mtima mwake.","poem":2},{"text":"Mudzamvetsa zimenezi","poem":1},{"text":"masiku akubwerawo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}