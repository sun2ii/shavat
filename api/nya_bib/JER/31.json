{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["“Pa nthawi imeneyo,” akutero Yehova, “Ndidzakhala Mulungu wa mafuko onse a Israeli, ndipo iwo adzakhala anthu anga.”"]},{"type":"verse","number":2,"content":["Yehova akuti,",{"text":"“Anthu amene anapulumuka ku nkhondo","poem":1},{"text":"ndinawakomera mtima mʼchipululu;","poem":2},{"lineBreak":true},{"text":"pamene Aisraeli ankafuna kupumula.”","poem":2}]},{"type":"verse","number":3,"content":["Ine ndinawaonekera ndili chapatali ndipo ndinati,",{"text":"“Ine ndakukondani ndi chikondi chopanda malire.","poem":1},{"text":"Nʼchifukwa chake ndipitiriza kukukondani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndidzakusamaliraninso, inu anthu a Israeli;","poem":1},{"text":"mudzasangalala poyimba tizitoliro tanu,","poem":2},{"text":"ndipo mudzapita kukavina nawo","poem":1},{"text":"anthu ovina mwachimwemwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mudzalimanso minda ya mpesa","poem":1},{"text":"pa mapiri a Samariya;","poem":2},{"text":"alimi adzadzala mphesa","poem":1},{"text":"ndipo adzadya zipatso zake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lidzafika tsiku pamene alonda adzafuwula","poem":1},{"text":"pa mapiri a Efereimu nati,","poem":2},{"text":"‘Tiyeni tipite ku Ziyoni,","poem":1},{"text":"kwa Yehova Mulungu wathu.’ ”","poem":2}]},{"type":"verse","number":7,"content":["Yehova akuti,",{"text":"“Imbani mosangalala chifukwa cha Yakobo,","poem":1},{"text":"fuwulani chifukwa cha mtundu wopambana mitundu yonse.","poem":2},{"text":"Matamando anu amveke, ndipo munene kuti,","poem":1},{"text":"‘Yehova wapulumutsa anthu ake","poem":2},{"lineBreak":true},{"text":"otsala a Israeli.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taonani, ndidzabwera nawo kuchokera ku dziko la kumpoto,","poem":1},{"text":"ndidzawasonkhanitsa kuchokera ku malekezero a dziko lapansi.","poem":2},{"text":"Anthu osaona, olumala, amayi oyembekezera","poem":1},{"text":"ndi amene ali pa nthawi yawo yochira adzabwera nawo pamodzi.","poem":2},{"lineBreak":true},{"text":"Chidzakhala chikhamu cha anthu obwerera kuno.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Adzabwera akulira;","poem":1},{"text":"koma Ine ndikuwatonthoza mtima, ndidzawaperekeza.","poem":2},{"text":"Ndidzawatsogolera ku mitsinje yamadzi","poem":1},{"text":"mʼnjira yosalala mmene sadzapunthwamo.","poem":2},{"text":"Chifukwa ndine abambo ake a Israeli,","poem":1},{"text":"ndipo Efereimu ndi mwana wanga woyamba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Imvani mawu a Yehova inu anthu a mitundu ina;","poem":1},{"text":"lalikirani mawuwa kwa anthu a mayiko akutali a mʼmbali mwa nyanja;","poem":2},{"text":"‘Iye amene anabalalitsa Israeli adzawasonkhanitsanso","poem":1},{"text":"ndipo adzayangʼanira nkhosa zake ngati mʼbusa.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pakuti Yehova wawombola fuko la Yakobo","poem":1},{"text":"anawapulumutsa mʼdzanja la anthu owaposa mphamvu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anthuwo adzabwera akuyimba mofuwula pa mapiri a Ziyoni;","poem":1},{"text":"adzasangalala ndi zinthu zabwino zochokera kwa Yehova.","poem":2},{"text":"Zinthu zabwinozo ndi izi: tirigu, vinyo watsopano ndi mafuta,","poem":1},{"text":"ana ankhosa ndi ana angʼombe.","poem":2},{"text":"Iwo adzakhala ngati munda wothiriridwa bwino,","poem":1},{"text":"ndipo sadzamvanso chisoni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pamenepo anamwali adzavina ndi kusangalala.","poem":1},{"text":"Anyamata ndi okalamba nawonso adzasangalala.","poem":2},{"text":"Kulira kwawo ndidzakusandutsa chisangalalo;","poem":1},{"text":"ndidzawasangalatsa nʼkuchotsa chisoni chawo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ansembe ndidzawadyetsa chakudya chabwino,","poem":1},{"text":"ndipo anthu anga adzakhuta ndi zabwino zanga,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":15,"content":["Yehova akuti,",{"text":"“Kulira kukumveka ku Rama,","poem":1},{"text":"kulira kwakukulu,","poem":2},{"text":"Rakele akulirira ana ake.","poem":1},{"text":"Sakutonthozeka","poem":2},{"lineBreak":true},{"text":"chifukwa ana akewo palibe.”","poem":2}]},{"type":"verse","number":16,"content":["Yehova akuti,",{"text":"“Leka kulira","poem":1},{"text":"ndi kukhetsa misozi","poem":2},{"text":"pakuti udzalandira mphotho ya ntchito yako,”","poem":1},{"text":"akutero Yehova.","poem":4},{"text":"“Iwo adzabwerako ku dziko la adani.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tsono chiyembekezo chilipo pa zamʼtsogolo,”","poem":1},{"text":"akutero Yehova.","poem":4},{"text":"“Ana ako adzabwerera ku dziko lawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Ndithu ndamva Efereimu akubuwula kuti,","poem":1},{"text":"‘Ife tinali ngati ana angʼombe osamva.","poem":2},{"lineBreak":true},{"text":"Koma inu mwatiphunzitsa kumvera.","poem":2},{"text":"Mutibweze kuti tithe kubwerera,","poem":1},{"text":"chifukwa ndinu Yehova Mulungu wanga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Popeza tatembenuka mtima,","poem":1},{"text":"ndiye tikumva chisoni;","poem":2},{"text":"popeza tazindikira","poem":1},{"text":"ndiye tikudziguguda pachifukwa.","poem":2},{"text":"Tachita manyazi ndipo tanyazitsidwa","poem":1},{"text":"chifukwa tinachimwa paubwana wathu.’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kodi Efereimu si mwana wanga wokondedwa,","poem":1},{"text":"mwana amene Ine ndimakondwera naye?","poem":2},{"text":"Ngakhale nthawi zambiri ndimamudzudzula,","poem":1},{"text":"ndimamukumbukirabe.","poem":2},{"text":"Kotero mtima wanga ukumufunabe;","poem":1},{"text":"ndimamumvera chifundo chachikulu kwambiri,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Muyike zizindikiro za mu msewu;","poem":1},{"text":"muyimike zikwangwani.","poem":2},{"text":"Yangʼanitsitsani msewuwo,","poem":1},{"text":"njira imene mukuyendamo.","poem":2},{"text":"Bwerera, iwe namwali wa Israeli,","poem":1},{"text":"bwerera ku mizinda yako ija.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Udzakhala jenkha mpaka liti,","poem":1},{"text":"iwe mwana wa mkazi wosakhulupirika?","poem":2},{"text":"Yehova walenga chinthu chatsopano pa dziko lapansi; mkazi ndiye tsopano aziteteza mwamuna.”","poem":1}]},{"type":"verse","number":23,"content":["Yehova Wamphamvuzonse, Mulungu wa Israeli akuti, “Ndikadzabwera nawo anthuwa kuchokera ku ukapolo, anthu a mʼdziko la Yuda ndi amene akukhala mʼmizinda yake adzayankhulanso mawu akuti, ‘Yehova akudalitse, iwe malo achilungamo, iwe phiri lopatulika.’"]},{"type":"verse","number":24,"content":["Anthu adzakhala ku Yuda ndi ku mizinda yake pamodzi ndi alimi ndi oweta nkhosa."]},{"type":"verse","number":25,"content":["Ndidzatsitsimutsa anthu otopa ndipo ndidzadyetsa anthu anjala.”"]},{"type":"verse","number":26,"content":["Pamenepo ndinadzuka nʼkuyangʼana uku ndi uku. Tulo tanga tinali tokoma."]},{"type":"verse","number":27,"content":["“Masiku akubwera,” akutero Yehova, “pamene ndidzachulukitsa anthu pamodzi ndi ziweto mʼdziko la Israeli ndi la Yuda."]},{"type":"verse","number":28,"content":["Monga momwe ndinasamalira powazula, powagwetsa, powagumula, powawononga ndi powachita zoyipa, momwemonso ndidzasamala powamanga ndi powadzala” akutero Yehova."]},{"type":"verse","number":29,"content":["“Mʼmasiku amenewo anthu sadzanenanso kuti,",{"text":"“Makolo adya mphesa zosapsa,","poem":1},{"text":"koma mano a ana ndiye achita dziru.","poem":2}]},{"type":"verse","number":30,"content":["Mʼmalo wake, munthu aliyense adzafa chifukwa cha tchimo lake. Iye amene adzadye mphesa zosapsazo ndiye amene mano ake adzachite dziru.”"]},{"type":"verse","number":31,"content":[{"text":"“Masiku akubwera,” akutero Yehova,","poem":1},{"text":"“pamene ndidzachita pangano latsopano","poem":2},{"text":"ndi Aisraeli","poem":1},{"text":"ndiponso nyumba ya Yuda.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Silidzakhala ngati pangano","poem":1},{"text":"limene ndinachita ndi makolo awo","poem":2},{"text":"pamene ndinawagwira padzanja","poem":1},{"text":"nʼkuwatulutsa ku Igupto;","poem":2},{"text":"chifukwa anaphwanya pangano langa,","poem":1},{"text":"ngakhale ndinali mwamuna wawo,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":33,"content":[{"text":"“Ili ndi pangano limene ndidzachita ndi Aisraeli","poem":1},{"text":"atapita masiku amenewo,” akutero Yehova.","poem":2},{"text":"“Ndidzayika lamulo langa mʼmitima mwawo","poem":1},{"text":"ndi kulilemba mʼmaganizo mwawo.","poem":2},{"text":"Ine ndidzakhala Mulungu wawo","poem":1},{"text":"ndipo iwo adzakhala anthu anga.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Sipadzafunikanso kuti wina aphunzitse mnzake,","poem":1},{"text":"kapena munthu wina kuphunzitsa mʼbale wake, kunena kuti, ‘Mudziwe Yehova,’","poem":2},{"text":"chifukwa onse adzandidziwa Ine,","poem":1},{"text":"kuyambira wamngʼono mpaka wamkulu,”","poem":2},{"text":"akutero Yehova.","poem":4},{"text":"“Ndidzawakhululukira zoyipa zawo","poem":1},{"text":"ndipo sindidzakumbukiranso machimo awo.”","poem":2}]},{"type":"verse","number":35,"content":["Yehova akuti,",{"text":"Iye amene amakhazikitsa dzuwa","poem":1},{"text":"kuti liziwala masana,","poem":2},{"text":"amene amalamula kuti mwezi ndi nyenyezi","poem":1},{"text":"ziziwala usiku,","poem":2},{"text":"amene amavundula nyanja","poem":1},{"text":"kuti mafunde akokome,","poem":2},{"lineBreak":true},{"text":"dzina lake ndi Yehova Wamphamvuzonse:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ngati zimenezi zilekeka pamaso panga, akutero Yehova, pamenepo padzakhala pamathero a fuko la Israeli pamaso panga.","poem":1}]},{"type":"verse","number":37,"content":["Yehova akuti,",{"text":"“Ndidzataya fuko la Israeli chifukwa cha machimo awo.","poem":1},{"text":"Ngati patapezeka munthu","poem":2},{"text":"amene angathe kupima zakuthambo","poem":1},{"text":"nʼkufufuza maziko a dziko lapansi.”","poem":2}]},{"type":"verse","number":38,"content":["“Taonani masiku akubwera,” akutero Yehova, “pamene mzinda wa Yehova udzamangidwanso kuyambira ku Nsanja ya Hananeli mpaka ku Chipata cha Ngodya."]},{"type":"verse","number":39,"content":["Malire ake adzayambira pamenepo kupita ku phiri la Garebu, nʼkudzakhota kuloza ku Gowa."]},{"type":"verse","number":40,"content":["Chigwa chonse mʼmene amatayiramo mitembo ndi phulusa, ndiponso minda yonse kuyambira ku Chigwa cha Kidroni mpaka ku ngodya ya Chipata cha Akavalo mbali ya kummawa, adzakhala malo opatulika a Yehova. Mzindawu sadzawuzulanso kapena kuwuwononga.”"]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}