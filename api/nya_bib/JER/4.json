{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"“Ngati mukufuna kubwerera, inu Aisraeli,","poem":1},{"text":"bwererani kwa Ine,”","poem":2},{"text":"akutero Yehova.","poem":4},{"text":"“Chotsani mafano anu onyansa pamaso panga","poem":1},{"text":"ndipo musasocherenso.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muzilumbira mokhulupirika ndiponso mwa chilungamo","poem":1},{"text":"kuti, ‘Pali Yehova wamoyo.’","poem":2},{"text":"Mukatero anthu a mitundu ina yonse adzandipempha kuti ndiwadalitse","poem":1},{"text":"ndipo adzanditamanda.”","poem":2}]},{"type":"verse","number":3,"content":["Zimene Yehova akunena kwa anthu a ku Yuda ndi a ku Yerusalemu ndi izi:",{"text":"“Limani masala anu","poem":1},{"text":"musadzale pakati pa minga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dziperekeni nokha kwa Ine","poem":1},{"text":"kuti munditumikire ndi mtima wanu wonse,","poem":2},{"lineBreak":true},{"text":"inu anthu a ku Yuda ndi ku Yerusalemu.","poem":2},{"text":"Muzichita zimenezi kuopa kuti mkwiyo wanga ungabuke ngati moto ndi kukutenthani,","poem":1},{"text":"chifukwa cha ntchito zanu zoyipazo","poem":2},{"lineBreak":true},{"text":"popanda wina wowuzimitsa.","poem":2}]},{"type":"heading","content":["Adani Ochokera Kumpoto kwa Yuda"]},{"type":"verse","number":5,"content":[{"text":"“Lengeza ku Yuda ndi kulalikira mu Yerusalemu kuti,","poem":1},{"text":"‘Lizani lipenga mʼdziko lonse!’","poem":2},{"text":"Ndipo fuwulani kuti,","poem":1},{"text":"‘Sonkhanani!","poem":2},{"lineBreak":true},{"text":"Tiyeni tithawire ku mizinda yotetezedwa!’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwezani mbendera kuyangʼana ku Ziyoni!","poem":1},{"text":"Musachedwe, thawani kuti mupulumuke!","poem":2},{"text":"Pakuti Ine ndikubweretsa chilango kuchokera kumpoto,","poem":1},{"text":"kudzakhala chiwonongeko choopsa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Monga mkango umatulukira mʼngaka yake","poem":1},{"text":"momwemonso wowononga mayiko","poem":2},{"text":"wanyamuka ndi kutuluka ku mbuto yake.","poem":1},{"text":"Watero kuti awononge dziko lanu.","poem":2},{"text":"Mizinda yanu idzakhala mabwinja","poem":1},{"text":"popanda wokhalamo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Choncho valani ziguduli,","poem":1},{"text":"lirani ndi kubuwula,","poem":2},{"text":"pakuti mkwiyo waukulu wa Yehova","poem":1},{"text":"sunatichokere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Pa tsiku limenelo, mfumu ndi nduna zake adzataya mtima,","poem":1},{"text":"ansembe adzachita mantha kwambiri,","poem":2},{"text":"ndipo aneneri adzathedwa nzeru,”","poem":1},{"text":"akutero Yehova.","poem":2}]},{"type":"verse","number":10,"content":["Ndipo ine ndinati, “Haa, Ambuye Yehova, ndithu munawanyenga anthu awa pamodzi ndi Yerusalemu pamene munanena kuti, ‘Mudzakhala pa mtendere,’ chonsecho lupanga lili pakhosi pathu.”"]},{"type":"verse","number":11,"content":["Nthawi imeneyo anthu awa ndi Yerusalemu adzawawuza kuti, “Mphepo yotentha yochokera ku magomo a mʼchipululu ikuwomba pa anthu anga, osati mphepo yopeta kapena yoyeretsa;"]},{"type":"verse","number":12,"content":["koma mphepo yamphamvu kwambiri yochokera kwa Ine. Tsono ndi Ineyo amene ndikuwaweruza.”"]},{"type":"verse","number":13,"content":[{"text":"Taonani, adani akubwera ngati mitambo,","poem":1},{"text":"magaleta awo akubwera ngati kamvuluvulu,","poem":2},{"text":"akavalo awo ndi aliwiro kupambana chiwombankhanga.","poem":1},{"text":"Tsoka ilo! Tawonongeka!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iwe Yerusalemu, tsuka mtima wako kuchotsa zoyipa kuti upulumuke.","poem":1},{"text":"Kodi maganizo ako oyipawo udzakhala nawo mpaka liti?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pakuti amithenga akulalika mawu mʼdziko la Dani;","poem":1},{"text":"akulengeza za masautso kuchokera ku mapiri a Efereimu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iwo akuti, “Fotokozani zimenezi kwa anthu a mitundu ina,","poem":1},{"text":"lengezani zimenezi mu Yerusalemu kuti,","poem":2},{"text":"‘Ankhondo akubwera kuchokera ku dziko lakutali,","poem":1},{"text":"akufuwula ndi kudzazinga mizinda ya Yuda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Azinga Yerusalemu ngati anthu olondera munda,","poem":1},{"text":"chifukwa Yerusalemu wandiwukira,’ ”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"“Makhalidwe anu ndi zochita zanu","poem":1},{"text":"zakubweretserani zimenezi.","poem":2},{"text":"Chimenechi ndiye chilango chanu.","poem":1},{"text":"Nʼchowawa kwambiri!","poem":2},{"lineBreak":true},{"text":"Nʼcholasa mpaka mu mtima!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mayo, mayo,","poem":1},{"text":"ndikumva kupweteka!","poem":2},{"text":"Aa, mtima wanga ukupweteka,","poem":1},{"text":"ukugunda kuti thi, thi, thi.","poem":2},{"lineBreak":true},{"text":"Sindingathe kukhala chete.","poem":2},{"text":"Pakuti ndamva kulira kwa lipenga;","poem":1},{"text":"ndamva mfuwu wankhondo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tsoka limatsata tsoka linzake;","poem":1},{"text":"dziko lonse lasanduka bwinja.","poem":2},{"text":"Mwadzidzidzi matenti athu awonongedwa,","poem":1},{"text":"mwa kanthawi kochepa nsalu zake zotchinga zagwetsedwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kodi ndikhale ndikuona mbendera ya nkhondo,","poem":1},{"text":"ndi kumva kulira kwa lipenga mpaka liti?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yehova akuti, “Anthu anga ndi zitsiru;","poem":1},{"text":"iwo sandidziwa.","poem":2},{"text":"Iwo ndi ana opanda nzeru;","poem":1},{"text":"samvetsa chilichonse.","poem":2},{"text":"Ali ndi luso lochita zoyipa,","poem":1},{"text":"koma sadziwa kuchita zabwino.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ndinayangʼana dziko lapansi,","poem":1},{"text":"ndipo linali lopanda anthu ndi lopanda kanthu;","poem":2},{"text":"ndinayangʼana thambo,","poem":1},{"text":"koma linalibe kuwala kulikonse.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndinayangʼana mapiri,","poem":1},{"text":"ndipo ankagwedezeka;","poem":2},{"lineBreak":true},{"text":"magomo onse ankangosunthira uku ndi uku.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndinayangʼana, ndipo sindinaone anthu;","poem":1},{"text":"mbalame iliyonse ya mlengalenga inali itathawa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndinayangʼana, dziko lachonde linali litasanduka chipululu;","poem":1},{"text":"mizinda yake yonse inali itasanduka bwinja","poem":2},{"lineBreak":true},{"text":"pamaso pa Yehova, chifukwa cha mkwiyo wake.","poem":2}]},{"type":"verse","number":27,"content":["Yehova akuti,",{"text":"“Dziko lonse lidzasanduka chipululu","poem":1},{"text":"komabe sindidzaliwononga kotheratu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Chifukwa chake dziko lapansi lidzalira","poem":1},{"text":"ndipo thambo lidzachita mdima,","poem":2},{"text":"pakuti ndayankhula ndipo sindidzafewa mtima,","poem":1},{"text":"ndatsimikiza ndipo sindidzabwerera mʼmbuyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Pakumva phokoso la okwera pa akavalo ndi la anthu oponya mivi,","poem":1},{"text":"anthu a mʼmizinda adzathawa.","poem":2},{"text":"Ena adzabisala ku nkhalango;","poem":1},{"text":"ena adzakwera mʼmatanthwe","poem":2},{"text":"mizinda yonse nʼkuyisiya;","poem":1},{"text":"popanda munthu wokhalamo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Iwe Yerusalemu, ndiwe bwinja!","poem":1},{"text":"Ukutanthauza chiyani kuvala zovala zofiira","poem":2},{"lineBreak":true},{"text":"ndi kuvalanso zokometsera zagolide?","poem":2},{"text":"Ngakhale udzikonze maso ako powapaka zokometsera,","poem":1},{"text":"ukungodzivuta chabe.","poem":2},{"text":"Zibwenzi zako zikukunyoza;","poem":1},{"text":"zikufuna kuchotsa moyo wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ndikumva kulira ngati kwa mayi pa nthawi yake yobereka,","poem":1},{"text":"kubuwula ngati kwa mayi amene akubereka mwana wake woyamba.","poem":2},{"text":"Kuliraku ndi kwa anthu a mu Ziyoni, wefuwefu.","poem":1},{"text":"Atambalitsa manja awo nʼkumati,","poem":2},{"text":"“Kalanga ife! Tikukomoka.","poem":1},{"text":"Moyo wathu waperekedwa kwa anthu otipha.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}