{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":["Yehova anamupatsa Yeremiya uthenga wonena za anthu a mitundu ina."]},{"type":"heading","content":["Uthenga Wonena za Igupto"]},{"type":"verse","number":2,"content":["Kunena za Igupto:",{"lineBreak":true},"Yehova ananena za gulu lankhondo la Farao Neko mfumu ya ku Igupto limene Nebukadinezara mfumu ya ku Babuloni analigonjetsa ku Karikemesi ku mtsinje wa Yufurate mʼchaka cha chinayi cha Yehoyakimu mwana wa Yosiya mfumu ya Yuda,"]},{"type":"verse","number":3,"content":[{"text":"anati, “Konzani zishango zanu ndi malihawo,","poem":1},{"text":"ndipo yambanipo kupita ku nkhondo!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mangani akavalo,","poem":1},{"text":"ndipo kwerani inu okwerapo!","poem":2},{"text":"Khalani pa mzere","poem":1},{"text":"mutavala zipewa!","poem":2},{"text":"Nolani mikondo yanu,","poem":1},{"text":"valani malaya anu ankhondo!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yeremiya anati: Kodi ndikuona chiyani?","poem":1},{"text":"Achita mantha","poem":2},{"text":"akubwerera,","poem":1},{"text":"ankhondo awo agonjetsedwa.","poem":2},{"text":"Akuthawa mofulumirapo","poem":1},{"text":"osayangʼananso mʼmbuyo,","poem":2},{"lineBreak":true},{"text":"ndipo agwidwa ndi mantha ponseponse,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Waliwiro sangathe kuthawa","poem":1},{"text":"ngakhale wankhondo wamphamvu sangathe kupulumuka.","poem":2},{"text":"Akunka napunthwa ndi kugwa","poem":1},{"text":"kumpoto kwa mtsinje wa Yufurate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Kodi ndani amene akukwera ngati Nailo,","poem":1},{"text":"ngati mtsinje wa madzi amkokomo?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Igupto akusefukira ngati Nailo,","poem":1},{"text":"ngati mitsinje ya madzi amkokomo.","poem":2},{"text":"Iye akunena kuti, ‘Ndidzadzuka ndi kuphimba dziko lapansi;","poem":1},{"text":"ndidzawononga mizinda ndi anthu ake.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tiyeni, inu akavalo!","poem":1},{"text":"Thamangani inu magaleta!","poem":2},{"text":"Tulukani, inu ankhondo,","poem":1},{"text":"ankhondo a ku Kusi ndi Puti amene mumanyamula zishango,","poem":2},{"lineBreak":true},{"text":"ankhondo a ku Ludi amene mumaponya uta.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Koma tsikulo ndi la Ambuye Yehova Wamphamvuzonse;","poem":1},{"text":"tsiku lolipsira, lolipsira adani ake.","poem":2},{"text":"Lupanga lake lidzawononga ndi kukhuta magazi,","poem":1},{"text":"lidzaledzera ndi magazi.","poem":2},{"text":"Pakuti Yehova, Yehova Wamphamvuzonse, adzapereka adani ake ngati nsembe","poem":1},{"text":"mʼdziko la kumpoto mʼmbali mwa mtsinje wa Yufurate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Pita ku Giliyadi ukatenge mankhwala","poem":1},{"text":"iwe namwali Igupto.","poem":2},{"text":"Wayesayesa mankhwala ambiri koma osachira;","poem":1},{"text":"palibe mankhwala okuchiritsa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anthu a mitundu ina amva za manyazi ako;","poem":1},{"text":"kulira kwako kwadzaza dziko lapansi.","poem":2},{"text":"Ankhondo akunka nagwetsanagwetsana,","poem":1},{"text":"onse awiri agwa pansi limodzi.”","poem":2}]},{"type":"verse","number":13,"content":["Uthenga umene Yehova anapatsa mneneri Yeremiya wonena za kubwera kwa Nebukadinezara mfumu ya ku Babuloni kudzathira nkhondo Igupto ndi uwu:"]},{"type":"verse","number":14,"content":[{"text":"“Mulengeze ku Igupto. Mulengeze ku Migidoli.","poem":1},{"text":"Mulengezenso ku Mefisi ndi ku Tapanesi.","poem":2},{"text":"Muwawuze anthu akumeneko kuti, ‘Imani pamalo panu ndi kukhala okonzeka kudziteteza,","poem":1},{"text":"chifukwa lupanga lidzawononga zonse zimene muli nazo.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Chifukwa chiyani mulungu wanu wamphamvu uja Apisi wathawa?","poem":1},{"text":"Iye sakanatha kulimba chifukwa Yehova anamugwetsa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ankhondo anu apunthwa ndi kugwa.","poem":1},{"text":"Aliyense akuwuza mnzake kuti,","poem":2},{"text":"‘Tiyeni tibwerere kwathu,","poem":1},{"text":"ku dziko kumene tinabadwira,","poem":2},{"lineBreak":true},{"text":"tithawe lupanga la adani athu.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kumeneku iwo adzafuwula kuti,","poem":1},{"text":"‘Farao, mfumu ya ku Igupto mupatseni dzina lakuti,","poem":2},{"lineBreak":true},{"text":"Waphokoso, Wotaya mwayi wake.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Pali Ine wamoyo,” ikutero Mfumu,","poem":1},{"text":"imene dzina lake ndi Yehova Wamphamvuzonse,","poem":2},{"text":"“wina adzabwera amene ali ngati Tabori phiri lopambana mapiri ena,","poem":1},{"text":"ngati phiri la Karimeli loti njoo mʼmbali mwa nyanja.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Konzani katundu wanu wopita naye ku ukapolo","poem":1},{"text":"inu anthu a ku Igupto,","poem":2},{"text":"pakuti Mefisi adzasanduka chipululu","poem":1},{"text":"ndipo adzakhala bwinja mopanda wokhalamo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Igupto ali ngati mwana wangʼombe wokongola,","poem":1},{"text":"koma chimphanga chikubwera","poem":2},{"lineBreak":true},{"text":"kuchokera kumpoto kudzalimbana naye.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngakhale ankhondo aganyu amene ali naye","poem":1},{"text":"ali ngati ana angʼombe onenepa.","poem":2},{"text":"Nawonso abwerera mʼmbuyo, nathawa pamodzi.","poem":1},{"text":"Palibe amene wachirimika.","poem":2},{"text":"Ndithu, tsiku la tsoka lawafikira;","poem":1},{"text":"ndiyo nthawi yowalanga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Aigupto akuthawa ndi liwu lawo lili ngati la njoka yothawa","poem":1},{"text":"pamene adani abwera ndi zida zawo,","poem":2},{"text":"abwera ndi nkhwangwa","poem":1},{"text":"ngati anthu odula mitengo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Iwo adzadula nkhalango ya Igupto,”","poem":1},{"text":"akutero Yehova,","poem":4},{"text":"“ngakhale kuti ndi yowirira.","poem":2},{"text":"Anthuwo ndi ochuluka kupambana dzombe,","poem":1},{"text":"moti sangatheke kuwerengeka.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Anthu a ku Igupto achita manyazi","poem":1},{"text":"atengedwa ukapolo ndi anthu a kumpoto.”","poem":2}]},{"type":"verse","number":25,"content":["Yehova Wamphamvuzonse, Mulungu wa Israeli, akunena kuti, “Ndili pafupi kulanga Amoni mulungu wa Tebesi. Ndidzalanganso Farao ndi Igupto pamodzi ndi milungu yake yonse, mafumu ake ndi onse amene amamukhulupirira."]},{"type":"verse","number":26,"content":["Ndidzawapereka kwa amene akufuna kuwapha, ndiye kuti kwa Nebukadinezara mfumu ya ku Babuloni ndi atsogoleri ake ankhondo. Komabe, mʼtsogolomo Igupto adzakhalanso ndi anthu monga kale,” akutero Yehova."]},{"type":"verse","number":27,"content":[{"text":"“Iwe mtumiki wanga Yakobo, usachite mantha;","poem":1},{"text":"usataye mtima, iwe Israeli.","poem":2},{"text":"Ndithu Ine ndidzakupulumutsa kuchokera ku mayiko akutali,","poem":1},{"text":"ndidzapulumutsanso zidzukulu zako kuchokera ku mayiko kumene anapita nazo ku ukapolo.","poem":2},{"text":"Yakobo adzabwerera ndipo adzakhala motakasuka ndi pa mtendere,","poem":1},{"text":"ndipo palibenso wina amene adzamuopsa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Iwe mtumiki wanga Yakobo, usachite mantha,","poem":1},{"text":"pakuti Ine ndili nawe,” akutero Yehova.","poem":2},{"text":"“Ndidzawonongeratu mitundu yonse ya anthu","poem":1},{"text":"a ku mayiko kumene ndakupirikitsira,","poem":2},{"lineBreak":true},{"text":"Koma iwe sindidzakuwononga kotheratu.","poem":2},{"text":"Ndidzakulanga iwe ndithu koma moyenerera;","poem":1},{"text":"sindidzakulekerera osakulanga.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}