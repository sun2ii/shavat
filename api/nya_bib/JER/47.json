{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Uthenga Wonena za Afilisti"]},{"type":"verse","number":1,"content":["Uthenga umene Yehova anamupatsa mneneri Yeremiya wonena za Afilisti, Farao asanathire nkhondo Gaza ndi uwu:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["Yehova akuti,",{"text":"“Taonani mmene madzi akubwerera kuchokera kumpoto;","poem":1},{"text":"adzasanduka mtsinje wosefukira ndi a mkokomo.","poem":2},{"text":"Adzasefukira mʼdziko monse ndi kumiza chilichonse mʼmenemo,","poem":1},{"text":"mizinda ndi onse okhala mʼmenemo.","poem":2},{"text":"Anthu adzafuwula;","poem":1},{"text":"anthu onse okhala mʼdzikomo adzalira","poem":2}]},{"type":"verse","number":3,"content":[{"text":"akadzamva mgugu wa ngʼombe zazimuna zothamanga,","poem":1},{"text":"phokoso la magaleta ake","poem":2},{"lineBreak":true},{"text":"ndi kulira kwa mikombero yake.","poem":2},{"text":"Makolo sadzatembenuka kuti athandize ana awo;","poem":1},{"text":"manja awo adzangoti khoba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pakuti tsiku lafika","poem":1},{"text":"lowononga Afilisti onse","poem":2},{"text":"ndi kupha onse otsala,","poem":1},{"text":"onse amene akanatha kuthandiza Turo ndi Sidoni.","poem":2},{"text":"Yehova ali pafupi kuwononga Afilisti,","poem":1},{"text":"otsala ochokera ku zilumba za ku Kafitori.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anthu a ku Gaza ameta mipala;","poem":1},{"text":"anthu a ku Asikeloni akhala chete.","poem":2},{"text":"Inu otsala a ku chigwa,","poem":1},{"text":"mudzakhala mukudzichekacheka mpaka liti?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mukulira kuti, ‘Aa, lupanga la Yehova,","poem":1},{"text":"kodi udzapumula liti?","poem":2},{"text":"Bwerera mʼmalo ako;","poem":1},{"text":"ukhale momwemo ndipo ukhale chete.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Koma lupangalo lidzapumula bwanji","poem":1},{"text":"pamene Yehova walilamulira","poem":2},{"text":"kuti lithire nkhondo","poem":1},{"text":"Asikeloni ndi anthu a mʼmbali mwa nyanja?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}