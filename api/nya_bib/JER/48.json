{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Uthenga Wonena za Mowabu"]},{"type":"verse","number":1,"content":["Ponena za Mowabu:",{"lineBreak":true},"Yehova Wamphamvuzonse, Mulungu wa Israeli akuti,",{"text":"“Tsoka kwa mzinda wa Nebo, chifukwa wawonongedwa.","poem":1},{"text":"Mzinda wa Kiriyataimu wachititsidwa manyazi ndipo wagonjetsedwa;","poem":2},{"lineBreak":true},{"text":"linga lichititsidwa manyazi ndipo lagumulidwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Palibenso amene akutamanda Mowabu;","poem":1},{"text":"ku Hesiboni anthu anamupanganira zoyipa:","poem":2},{"lineBreak":true},{"text":"‘Bwerani, tiyeni timuwonongeretu kuti asakhalenso mtundu wa anthu.’","poem":2},{"text":"Inunso anthu a ku Madimena, adzakukhalitsani chete;","poem":1},{"text":"ankhondo adzakupirikitsani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tamvani mfuwu wa anthu a ku Horonaimu.","poem":1},{"text":"Iwo akulira kuti, ‘Kusakazika ndi kuwonongeka kwakukulu.’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mowabu wawonongeka;","poem":1},{"text":"ana ake angʼonoangʼono akulira kwambiri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anthu akukwera chikweza cha ku Luhiti,","poem":1},{"text":"akulira kwambiri pamene akupita.","poem":2},{"text":"Kulira chifukwa cha chiwonongeko kukumveka","poem":1},{"text":"pa njira yotsikira ku Horonaimu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Thawani! Dzipulumutseni;","poem":1},{"text":"khalani ngati mbidzi ya mʼchipululu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Popeza inu munkadalira ntchito zanu ndi chuma chanu,","poem":1},{"text":"nanunso mudzatengedwa ukapolo,","poem":2},{"text":"ndipo Kemosi adzapita ku ukapolo,","poem":1},{"text":"pamodzi ndi ansembe ake ndi akuluakulu ake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wowononga adzabwera ndi kusakaza mzinda uliwonse,","poem":1},{"text":"ndipo palibe mzinda umene udzapulumuke.","poem":2},{"text":"Chigwa chidzasanduka bwinja","poem":1},{"text":"ndipo malo athyathyathya a pamwamba pa phiri adzawonongedwa","poem":2},{"lineBreak":true},{"text":"monga Yehova wayankhulira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mtsineni khutu Mowabu","poem":1},{"text":"chifukwa adzasakazika;","poem":2},{"text":"mizinda yake idzasanduka mabwinja,","poem":1},{"text":"wopanda munthu wokhalamo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Wotembereredwa munthu amene amagwira ntchito ya Yehova monyinyirika!","poem":1},{"text":"Wotembereredwa munthu amene amaletsa lupanga lake kupha anthu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Mowabu wakhala pa mtendere kuyambira ubwana wake,","poem":1},{"text":"ngati vinyo wokhazikika pa masese ake,","poem":2},{"text":"osapungulidwa kuchoka mu mtsuko wina kuthira mu mtsuko wina;","poem":1},{"text":"iye sanatengedwepo ukapolo.","poem":2},{"text":"Nʼchifukwa chake kukoma kwake nʼkomwe kuja","poem":1},{"text":"ndipo fungo lake silinasinthe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nʼchifukwa chake masiku akubwera,”","poem":1},{"text":"akutero Yehova,","poem":2},{"text":"“pamene ndidzatuma anthu amene amakhuthula vinyo mʼmitsuko","poem":1},{"text":"ndipo adzamukhutula;","poem":2},{"text":"adzakhuthula vinyo yense mitsuko yake","poem":1},{"text":"pambuyo pake nʼkuphwanya mitsukoyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pamenepo Mowabu adzachita manyazi ndi Kemosi,","poem":1},{"text":"monga momwe Aisraeli anachitira manyazi","poem":2},{"lineBreak":true},{"text":"ndi Beteli amene ankamukhutulira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Kodi munganene bwanji kuti, ‘Ife ndife asilikali.","poem":1},{"text":"Ife ndife ngwazi, anthu amphamvu pa nkhondo?’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Owononga Mowabu ndi mizinda yake abwera ndipo ankhondo adzalowa mʼmidzi yake;","poem":1},{"text":"anyamata ake okongola apita kukaphedwa,”","poem":2},{"lineBreak":true},{"text":"ikutero Mfumu, imene dzina lake ndi Yehova Wamphamvuzonse.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kugwa kwa Mowabu kuli pafupi;","poem":1},{"text":"masautso ake akubwera posachedwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mulireni kwambiri, inu nonse amene mwamuzungulira,","poem":1},{"text":"inu nonse amene mumadziwa za kutchuka kwake;","poem":2},{"text":"nenani kuti, “Taonani momwe yathyokera ndodo yamphamvu yaufumu ija,","poem":1},{"text":"taonani momwe ndodo yaulemu yathyokera!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Tsikani pa ulemerero wanu","poem":1},{"text":"ndipo khalani pansi powuma,","poem":2},{"lineBreak":true},{"text":"inu anthu okhala ku Diboni,","poem":2},{"text":"pakuti wowononga Mowabu","poem":1},{"text":"wabwera kudzamenyana nanu,","poem":2},{"lineBreak":true},{"text":"wasakaza mizinda yanu yotetezedwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Inu amene mumakhala ku Aroeri,","poem":1},{"text":"imani mʼmbali mwa msewu ndi kumaonerera.","poem":2},{"text":"Funsani mwamuna amene akuthawa ndiponso mkazi amene wapulumuka,","poem":1},{"text":"afunseni kuti, ‘Kodi chachitika nʼchiyani?’ ”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iwo adzayankha kuti, “Mowabu wachititsidwa manyazi, pakuti wasakazika.","poem":1},{"text":"Lirani mwachisoni ndipo fuwulani!","poem":2},{"text":"Lengezani ku mtsinje wa Arinoni","poem":1},{"text":"kuti Mowabu wawonongedwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Chiweruzo chabwera ku mizinda ya ku mapiri,","poem":1},{"text":"ndiyo Holoni, Yaza, Mefaati,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Diboni, Nebo, Beti-Dibilataimu,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kiriyataimu, Beti-Gamuli, Beti-Meoni,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Keriyoti ndi Bozira","poem":2},{"lineBreak":true},{"text":"ndi mizinda yonse ya Mowabu, yakutali ndi yapafupi yomwe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mphamvu za Mowabu zawonongeka;","poem":1},{"text":"mkono wake wathyoka,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Muledzeretseni Mowabu,","poem":1},{"text":"chifukwa anadzikuza powukira Yehova.","poem":2},{"text":"Mulekeni Mowabu avivinizike mʼmasanzi ake;","poem":1},{"text":"mulekeni akhale chinthu chomachiseka.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kodi suja Israeli anali kwa iwe ngati chinthu chomachiseka?","poem":1},{"text":"Kodi Israeli anapezeka pakati pa akuba","poem":2},{"text":"kuti nthawi zonse poyankhula za iye,","poem":1},{"text":"iwe uzimupukusira mutu momunyoza?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Inu amene mumakhala ku Mowabu,","poem":1},{"text":"siyani mizinda yanu ndi kukakhala pakati pa matanthwe.","poem":2},{"text":"Khalani ngati nkhunda imene imamanga chisa chake","poem":1},{"text":"pa khomo la phanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Tamva za kunyada kwa Mowabu,","poem":1},{"text":"kunyada kwake nʼkwakukulu.","poem":2},{"text":"Ndi wodzitama, wonyada ndi wodzitukumula.","poem":1},{"text":"Ali ndi mtima wodzikweza.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ine ndikuzidziwa ntchito zake,","poem":1},{"text":"akutero Yehova.","poem":4},{"text":"Ntchitozo ndi nʼzosapindulitsa kanthu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nʼchifukwa chake ndidzamulira Mowabu,","poem":1},{"text":"ine ndikulira chifukwa cha anthu onse a ku Mowabu,","poem":2},{"lineBreak":true},{"text":"ndikubuwula chifukwa cha anthu a ku Kiri Heresi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ndikukhetsa misozi chifukwa cha inu, kupambana momwe ndinalirira Yazeri.","poem":1},{"text":"Inu anthu a ku Sibina muli ngati mipesa","poem":2},{"text":"imene nthambi zake zatambalala mpaka ku Nyanja;","poem":1},{"text":"zafika mpaka ku nyanja ya Yazeri.","poem":2},{"text":"Wowononga wasakaza","poem":1},{"text":"zipatso zake zachilimwe ndi mpesa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Chimwemwe ndi chisangalalo zatha","poem":1},{"text":"ku minda ya zipatso ya ku Mowabu.","poem":2},{"text":"Ndaletsa kuchucha kwa vinyo mopsinyira mphesa;","poem":1},{"text":"palibe amene akufuwula mokondwa akamapsinya mphesa.","poem":2},{"text":"Ngakhale kufuwula kulipo,","poem":1},{"text":"koma sikufuwula kwa chimwemwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“A ku Hesiboni ndi Eleali akulira","poem":1},{"text":"ndipo mfuwu wawo ukumveka mpaka ku Yahazi,","poem":2},{"text":"kuchokera ku Zowari mpaka ku Horonaimu ndi ku Egilati Selisiya.","poem":1},{"text":"Ngakhale madzi a ku Nimurimu aphwa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ndidzawaletsa anthu a ku Mowabu","poem":1},{"text":"kupereka nsembe mʼmalo awo opembedzera","poem":2},{"lineBreak":true},{"text":"ndi kufukiza lubani kwa milungu yawo,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":36,"content":[{"text":"“Nʼchifukwa chake mtima wanga ukulirira Mowabu ngati chitoliro.","poem":1},{"text":"Mtima wanga ukulirira anthu a ku Kiri Heresi ngati chitoliro","poem":2},{"lineBreak":true},{"text":"chifukwa chuma chimene anachipata chatha.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Aliyense wameta mutu wake","poem":1},{"text":"ndi ndevu zake;","poem":2},{"text":"manja a munthu aliyense ndi ochekacheka,","poem":1},{"text":"ndipo munthu aliyense wavala chiguduli mʼchiwuno mwake.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Pa madenga onse a ku Mowabu","poem":1},{"text":"ndiponso mʼmisewu yake","poem":2},{"text":"anthu akungolira,","poem":1},{"text":"pakuti ndaphwanya Mowabu","poem":2},{"lineBreak":true},{"text":"ngati mtsuko wopanda ntchito,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":39,"content":[{"text":"“Taonani mmene waphwanyikira! Tamvani momwe akulirira!","poem":1},{"text":"Taonani momwe Mowabu wachititsidwira manyazi.","poem":2},{"text":"Mowabu wasanduka chinthu chonyozeka,","poem":1},{"text":"chinthu chochititsa mantha kwa onse amene amuzungulira.”","poem":2}]},{"type":"verse","number":40,"content":["Yehova akuti,",{"text":"“Mtundu wina udzachita kuwuluka nʼkugwera pa Mowabu ngati chiwombankhanga","poem":1},{"text":"chimene chatambalitsa mapiko ake.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Mizinda idzagwidwa","poem":1},{"text":"ndipo malinga adzalandidwa.","poem":2},{"text":"Pa tsiku limenelo mitima ya ankhondo a ku Mowabu","poem":1},{"text":"idzakhala ngati mtima wa mayi pa nthawi yake yochira.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Mowabu sudzakhala mtundu wa anthu","poem":1},{"text":"chifukwa unadzikuza powukira Yehova.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Zoopsa, dzenje ndi msampha zikudikira","poem":1},{"text":"inu anthu a ku Mowabu,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":44,"content":[{"text":"“Aliyense wothawa zoopsa","poem":1},{"text":"adzagwera mʼdzenje,","poem":2},{"text":"aliyense wotuluka mʼdzenje","poem":1},{"text":"adzakodwa mu msampha.","poem":2},{"text":"Ndigwetsa zimenezi pa Mowabu","poem":1},{"text":"pa nthawi ya chilango chake,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Anthu othawa nkhondo ayima pa mthunzi wa Hesiboni","poem":1},{"text":"chifukwa chotopa.","poem":2},{"text":"Koma moto wayaka kuchokera ku Hesiboni,","poem":1},{"text":"malawi a moto abuka kuchokera ku nyumba ya mfumu Sihoni.","poem":2},{"text":"Motowo ukuwononga mapiri a ku Mowabu,","poem":1},{"text":"dziko la anthu onyada.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Tsoka kwa iwe Mowabu!","poem":1},{"text":"Anthu opembedza Kemosi awonongeka.","poem":2},{"text":"Ana ako aamuna ndi aakazi","poem":1},{"text":"atengedwa ukapolo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Komabe masiku akutsogolo","poem":1},{"text":"ndidzabwezeranso Mowabu chuma chake,”","poem":2},{"text":"akutero Yehova.","poem":4},"Chiweruzo cha Mowabu chathera pamenepa."]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}