{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Uthenga Wonena za Babuloni"]},{"type":"verse","number":1,"content":["Uthenga umene Yehova anayankhula ndi mneneri Yeremiya wonena za mzinda wa Babuloni ndi anthu ake ndi uwu:"]},{"type":"verse","number":2,"content":[{"text":"“Lengeza ndi kulalika pakati pa anthu a mitundu ina,","poem":1},{"text":"kweza mbendera ndipo ulengeze;","poem":2},{"lineBreak":true},{"text":"usabise kanthu, koma uwawuze kuti,","poem":2},{"text":"‘Babuloni wagwa;","poem":1},{"text":"mulungu wawo Beli wachititsidwa manyazi,","poem":2},{"lineBreak":true},{"text":"nayenso Mariduku wagwidwa ndi mantha.","poem":2},{"text":"Milungu yake yagwidwa ndi mantha","poem":1},{"text":"ndipo mafano ake adzagwidwa ndi mantha.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mtundu wa anthu wochokera kumpoto wadzathira nkhondo Babuloni","poem":1},{"text":"ndi kusandutsa bwinja dziko lake.","poem":2},{"text":"Kumeneko sikudzakhalanso","poem":1},{"text":"munthu kapena nyama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Masiku amenewo, nthawi imeneyo,”","poem":1},{"text":"akutero Yehova,","poem":2},{"text":"“anthu a ku Israeli ndi anthu a ku Yuda","poem":1},{"text":"onse pamodzi adzabwera akulira. Adzafunitsitsa kuchita zimene Yehova Mulungu wawo akufuna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Adzafunsa njira ya ku Ziyoni","poem":1},{"text":"ndi kuyamba ulendo wopita kumeneko.","poem":2},{"text":"Iwo adzadzipereka kwa Yehova","poem":1},{"text":"pochita naye pangano lamuyaya","poem":2},{"lineBreak":true},{"text":"limene silidzayiwalika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Anthu anga ali ngati nkhosa zotayika;","poem":1},{"text":"abusa awo","poem":2},{"lineBreak":true},{"text":"anawasocheretsa mʼmapiri.","poem":2},{"text":"Iwo anayendayenda mʼmapiri ndi mʼzitunda","poem":1},{"text":"mpaka kuyiwala kwawo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aliyense amene anawapeza anawawononga;","poem":1},{"text":"adani awo anati, ‘Ife si olakwa,","poem":2},{"text":"chifukwa iwo anachimwira Yehova, amene ali mpumulo wawo weniweni","poem":1},{"text":"ndi amene makolo awo anamukhulupirira.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Thawaniko ku Babuloni;","poem":1},{"text":"chokani mʼdziko la Ababuloni.","poem":2},{"lineBreak":true},{"text":"Muyambe inu kutuluka ngati atonde amene amatsogolera ziweto.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taonani, ndidzaukitsa gulu lankhondo lamphamvu la mitundu ina","poem":1},{"text":"ndi kubwera nalo kuchokera kumpoto","poem":2},{"text":"kudzamenyana ndi Babuloni.","poem":1},{"text":"Iwo adzandandalika ankhondo awo ndi kugonjetsa Babuloni.","poem":2},{"text":"Mivi yawo ili ngati ya ankhondo aluso,","poem":1},{"text":"yosapita padera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Motero Ababuloni adzafunkhidwa;","poem":1},{"text":"ndipo onse omufunkha adzakhuta,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Inu Ababuloni, munawononga anthu anga osankhika.","poem":1},{"text":"Ndiye pano mukukondwa, mukusangalala.","poem":2},{"text":"Mukulumphalumpha mokondwa ngati mwana wangʼombe wopuntha tirigu","poem":1},{"text":"ndiponso mukulira monyada ngati ngʼombe zazimuna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Koma mzinda wanu udzachititsidwa manyazi kwambiri.","poem":1},{"text":"Mzinda umene uli ngati mayi wanu udzanyazitsidwa.","poem":2},{"text":"Babuloni adzasanduka chitsirizira cha anthu onse.","poem":1},{"text":"Mzinda wawo udzakhala ngati thengo, ngati dziko lowuma lachipululu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Chifukwa cha mkwiyo wa Yehova Babuloni adzakhala wopanda anthu","poem":1},{"text":"ndipo adzakhala chipululu chokhachokha.","poem":2},{"text":"Onse odutsa kumeneko adzachita mantha ndipo azidzangotsonya","poem":1},{"text":"chifukwa cha chiwonongeko chake chachikulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Inu okoka uta,","poem":1},{"text":"konzekani kuti muthire nkhondo mzinda wa Babuloni mbali zonse.","poem":2},{"text":"Muponyereni mivi yanu yonse","poem":1},{"text":"chifukwa anachimwira Yehova.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mufuwulireni mbali zonse pakuti wagonja.","poem":1},{"text":"Nsanja zake zagwa.","poem":2},{"lineBreak":true},{"text":"Malinga ake agwetsedwa.","poem":2},{"text":"Kumeneku ndiko kulipsira kwa Yehova.","poem":1},{"text":"Mulipsireni,","poem":2},{"lineBreak":true},{"text":"mumuchite zomwe iye anachitira anthu ena.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Chotsani ku Babuloni munthu wofesa mbewu aliyense,","poem":1},{"text":"ndiponso wodula tirigu ndi chikwakwa chake pa nthawi yokolola.","poem":2},{"text":"Poona lupanga la ozunza anzawo,","poem":1},{"text":"aliyense adzabwerera kwa anthu ake;","poem":2},{"lineBreak":true},{"text":"adzathawira ku dziko la kwawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Aisraeli ali ngati nkhosa zomwe zabalalika","poem":1},{"text":"pothamangitsidwa ndi mikango.","poem":2},{"text":"Mfumu ya ku Asiriya ndiye inayamba kuwapha Aisraeliwo.","poem":1},{"text":"Wotsiriza anali Nebukadinezara","poem":2},{"text":"mfumu ya ku Babuloni","poem":1},{"text":"amene anachita ngati kuphwanya mafupa ake.”","poem":2}]},{"type":"verse","number":18,"content":["Nʼchifukwa chake Yehova Wamphamvuzonse, Mulungu wa Israeli akuti,",{"text":"“Ndidzalanga mfumu ya ku Babuloni pamodzi ndi dziko lake","poem":1},{"text":"monga momwe ndinalangira mfumu ya ku Asiriya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Koma ndidzabwezera Israeli ku msipu wake","poem":1},{"text":"ndipo adzadya mʼminda ya ku Karimeli ndi Basani;","poem":2},{"text":"adzadya nakhuta ku mapiri","poem":1},{"text":"a ku Efereimu ndi Giliyadi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Masiku amenewo, nthawi imeneyo,”","poem":1},{"text":"akutero Yehova,","poem":2},{"text":"“anthu adzafunafuna zolakwa za Israeli","poem":1},{"text":"koma sadzapeza nʼchimodzi chomwe,","poem":2},{"text":"ndipo adzafufuza machimo a Yuda,","poem":1},{"text":"koma sadzapeza ndi limodzi lomwe,","poem":2},{"lineBreak":true},{"text":"chifukwa otsala amene ndawasiya ndidzawakhululukira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Lithireni nkhondo dziko la Merataimu","poem":1},{"text":"ndi anthu okhala ku Pekodi.","poem":2},{"text":"Muwaphe ndi lupanga ndi kuwawonongeratu,”","poem":1},{"text":"akutero Yehova.","poem":4},{"text":"“Chitani zonse monga momwe ndakulamulani.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mʼdziko muli phokoso la nkhondo,","poem":1},{"text":"phokoso la chiwonongeko chachikulu!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taonani mʼmene waphwanyikira ndi kuwonongekera","poem":1},{"text":"uja amati ndi nyundo ya dziko lonse lapansi.","poem":2},{"text":"Mzinda wa Babuloni wasanduka chinthu chochititsa mantha","poem":1},{"text":"pakati pa mitundu ina!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndinakutchera msampha, iwe Babuloni,","poem":1},{"text":"ndipo wakodwamo iwe wosazindikira kanthu;","poem":2},{"text":"unapezeka ndiponso unakodwa","poem":1},{"text":"chifukwa unalimbana ndi Yehova.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yehova watsekula nyumba ya zida zake","poem":1},{"text":"ndipo watulutsa zida za ukali wake,","poem":2},{"text":"pakuti Ambuye Yehova Wamphamvuzonse ali ndi ntchito yoti agwire","poem":1},{"text":"mʼdziko la Ababuloni.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mumenyane naye Babuloni mbali zonse.","poem":1},{"text":"Anthu ake muwawunjike","poem":2},{"lineBreak":true},{"text":"ngati milu ya tirigu.","poem":2},{"text":"Muwawononge kotheratu","poem":1},{"text":"ndipo pasakhale wopulumuka ndi mmodzi yemwe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Iphani ankhondo ake onse.","poem":1},{"text":"Onse aphedwe ndithu.","poem":2},{"text":"Tsoka lawagwera","poem":1},{"text":"pakuti tsiku lawo lachilango lafika.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Tikumva anthu othawa nkhondo ochokera ku Babuloni","poem":1},{"text":"akulengeza mu Yerusalemu","poem":2},{"text":"za kulipsira kwa Yehova Mulungu wathu.","poem":1},{"text":"Iye akulipsira chifukwa chowononga Nyumba yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Itanani anthu oponya mivi kudzathira nkhondo Babuloni.","poem":1},{"text":"Muyitanenso onse amene amakoka mauta.","poem":2},{"text":"Mangani misasa ya nkhondo momuzungulira;","poem":1},{"text":"musalole munthu aliyense kuthawa.","poem":2},{"text":"Muchiteni monga momwe","poem":1},{"text":"iye anachitira anthu ena.","poem":2},{"text":"Iyeyu ananyoza","poem":1},{"text":"Yehova, Woyera wa Israeli.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nʼchifukwa chake, anyamata ake adzaphedwa mʼmabwalo ake;","poem":1},{"text":"ankhondo ake onse adzaphedwa tsiku limenelo,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":31,"content":[{"text":"“Taona, ndikukuthira nkhondo, iwe wodzikuzawe,”","poem":1},{"text":"akutero Ambuye Yehova Wamphamvuzonse,","poem":2},{"text":"“chifukwa tsiku lako lafika,","poem":1},{"text":"nthawi yoti ndikulange yakwana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Wodzikuzawe udzapunthwa nʼkugwa","poem":1},{"text":"ndipo palibe amene adzakudzutse;","poem":2},{"text":"ndidzayatsa moto mʼmizinda yake","poem":1},{"text":"umene udzanyeketsa onse amene amuzungulira.”","poem":2}]},{"type":"verse","number":33,"content":["Yehova Wamphamvuzonse akuti,",{"text":"“Anthu a ku Israeli akuzunzidwa,","poem":1},{"text":"pamodzi ndi anthu a ku Yuda,","poem":2},{"text":"ndipo onse amene anawagwira ukapolo awagwiritsitsa,","poem":1},{"text":"akukana kuwamasula.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Koma Mpulumutsi wawo ndi wamphamvu;","poem":1},{"text":"dzina lake ndi Yehova Wamphamvuzonse.","poem":2},{"text":"Iye adzawateteza molimba pa mlandu wawo","poem":1},{"text":"nʼcholinga choti abweretse mtendere mʼdziko lawo,","poem":2},{"lineBreak":true},{"text":"koma adzavutitsa okhala ku Babuloni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Yehova akuti,","poem":1},{"text":"“Imfa yalunjika pa Ababuloni,","poem":2},{"text":"pa akuluakulu ake","poem":1},{"text":"ndi pa anthu ake a nzeru!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Imfa yalunjika pa aneneri abodza","poem":1},{"text":"kuti asanduke zitsiru.","poem":2},{"text":"Imfa yalunjika pa ankhondo ake","poem":1},{"text":"kuti agwidwe ndi mantha aakulu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Imfa ilunjike pa akavalo ake ndi magaleta ake.","poem":1},{"text":"Ilunjikanso pa magulu ankhondo achilendo amene ali pakati pawo","poem":2},{"lineBreak":true},{"text":"kuti asanduke ngati akazi.","poem":2},{"text":"Chiwonongeko chilunjikenso pa chuma chake","poem":1},{"text":"kuti chidzafunkhidwe.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Chilala chilunjike pa madzi ake","poem":1},{"text":"kuti aphwe.","poem":2},{"text":"Babuloni ndi dziko la mafano,","poem":1},{"text":"ndipo anthu afika poyaluka nawo mafanowo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Nʼchifukwa chake nyama zakuthengo ndi afisi zidzakhala kumeneko","poem":1},{"text":"ndipo kudzakhalanso akadzidzi.","poem":2},{"text":"Kumeneko sikudzapezekako anthu,","poem":1},{"text":"ndithu anthu sadzakhalako pa mibado yonse.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Monga momwe Mulungu anawonongera Sodomu ndi Gomora","poem":1},{"text":"pamodzi ndi mizinda yonse yozungulira,”","poem":2},{"text":"akutero Yehova,","poem":4},{"text":"“momwemonso palibe amene adzakhale kumeneko;","poem":1},{"text":"anthu sadzayendanso mʼmenemo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Taonani! Gulu lankhondo likubwera kuchokera kumpoto;","poem":1},{"text":"mtundu wa anthu amphamvu pamodzi ndi mafumu ambiri,","poem":2},{"lineBreak":true},{"text":"wanyamuka kuchokera kumathero a dziko lapansi.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Atenga mauta ndi mikondo;","poem":1},{"text":"ndi anthu ankhanza ndipo alibe chifundo.","poem":2},{"text":"Phokoso lawo likumveka ngati mkokomo wa nyanja.","poem":1},{"text":"Akwera pa akavalo awo,","poem":2},{"text":"ndipo akonzekera kudzakuthira nkhondo","poem":1},{"text":"iwe Babuloni.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Mfumu ya ku Babuloni yamva za mbiri yawo,","poem":1},{"text":"ndipo yalobodokeratu.","poem":2},{"text":"Ikuda nkhawa,","poem":1},{"text":"ikumva ululu ngati wa mayi pa nthawi yake yochira.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Taonani, monga mkango wochokera ku nkhalango ya ku Yorodani","poem":1},{"text":"kupita ku msipu wobiriwira,","poem":2},{"text":"momwemonso ine ndidzapirikitsa Babuloni mʼdziko lake mwadzidzidzi.","poem":1},{"text":"Pambuyo pake ndidzawayikira wowalamulira amene ndamufuna Ine.","poem":2},{"text":"Wofanana nane ndani ndipo ndani amene angalimbane nane?","poem":1},{"text":"Ndi mtsogoleri wa dziko uti amene anganditengere ku bwalo la milandu?”","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Nʼchifukwa chake imvani.","poem":1},{"text":"Izi ndi zimene Ine Yehova ndakonza zolangira anthu a ku Babuloni.","poem":2},{"text":"Ngakhale ana omwe adzatengedwa ukapolo","poem":1},{"text":"ndipo aliyense adzachita mantha chifukwa cha iwo.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Akadzagwa Babuloni padzakhala mfuwu waukulu ndipo dziko lapansi lidzanjenjemera,","poem":1},{"text":"ndipo kulira kwawo kudzamveka pakati pa mitundu yonse ya anthu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}