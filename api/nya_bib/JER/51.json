{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["Yehova akuti,",{"text":"“Taonani, ndidzadzutsa mphepo yowononga","poem":1},{"text":"kuti iwononge Babuloni pamodzi ndi anthu a ku Lebi Kamai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndidzatuma alendo ku Babuloni","poem":1},{"text":"kudzamupeta ndi kuwononga dziko lake kotheratu.","poem":2},{"text":"Iwo adzalimbana naye ku mbali zonse","poem":1},{"text":"pa tsiku la masautso ake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Okoka uta musawalekerere","poem":1},{"text":"kapena wonyadira chovala chawo chankhondo.","poem":2},{"text":"Musawasiye anyamata ake kuti akhale ndi moyo;","poem":1},{"text":"koma muwononge ankhondo ake kotheratu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adzavulazidwa ndi kufera mʼdziko la Babuloni","poem":1},{"text":"lomwelo ndi mʼmisewu yawo yomwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pakuti Yuda ndi Israeli sanasiyidwe ngati amasiye","poem":1},{"text":"ndi Mulungu wawo, Yehova Wamphamvuzonse,","poem":2},{"text":"koma ngakhale dziko la Babuloni ndi lodzaza ndi machimo","poem":1},{"text":"pamaso pa Woyerayo wa Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Thawaniko ku Babuloni!","poem":1},{"text":"Aliyense apulumutse moyo wake!","poem":2},{"lineBreak":true},{"text":"Musawonongeke naye pamodzi chifukwa cha machimo ake.","poem":2},{"text":"Imeneyi ndi nthawi yoti Yehova amulange;","poem":1},{"text":"Yehova adzamulipsira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Babuloni anali ngati chikho cha golide mʼdzanja la Yehova;","poem":1},{"text":"kuti aledzeretse dziko lonse lapansi.","poem":2},{"text":"Mitundu yambiri ya anthu inamwa vinyo wake;","poem":1},{"text":"nʼchifukwa chake tsopano inachita misala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Babuloni wagwa mwadzidzidzi ndi kusweka.","poem":1},{"text":"Mulireni!","poem":2},{"text":"Mfunireni mankhwala opha ululu wake;","poem":1},{"text":"mwina iye nʼkuchira.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ena anati, “ ‘Ife tinayesa kumupatsa mankhwala Babuloni,","poem":1},{"text":"koma sanachire;","poem":2},{"text":"tiyeni timusiye ndipo aliyense apite ku dziko la kwawo,","poem":1},{"text":"pakuti mlandu wake wafika mpaka mlengalenga,","poem":2},{"lineBreak":true},{"text":"wafika mpaka kumwamba.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Yehova waonetsa poyera kuti ndife osalakwa;","poem":1},{"text":"tiyeni tilengeze mu Ziyoni","poem":2},{"lineBreak":true},{"text":"zimene Yehova Mulungu wathu wachita.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Yehova wadzutsa mitima ya mafumu a Amedi,","poem":1},{"text":"popeza cholinga chake ndi kuwononga Babuloni.","poem":2},{"text":"Motero adzalipsira Ababuloni","poem":1},{"text":"chifukwa chowononga Nyumba yake.","poem":2},{"text":"Ndiye Yehova akuti,","poem":1},{"text":"‘Nolani mivi, tengani zishango.’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwezani mbendera yankhondo kuti muwononge malinga a Babuloni!","poem":1},{"text":"Limbitsani oteteza,","poem":2},{"text":"ikani alonda pa malo awo,","poem":1},{"text":"konzekerani kulalira.","poem":2},{"text":"Pakuti Yehova watsimikiza","poem":1},{"text":"ndipo adzachitadi zomwe ananena za anthu a ku Babuloni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inu muli ndi mitsinje yambiri","poem":1},{"text":"ndi chuma chambiri.","poem":2},{"text":"Koma chimaliziro chanu chafika,","poem":1},{"text":"moyo wanu watha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yehova Wamphamvuzonse analumbira pali Iye mwini kuti:","poem":1},{"text":"Ndidzakutumizira adani ochuluka ngati dzombe,","poem":2},{"lineBreak":true},{"text":"kuti adzakuthire nkhondo ndipo adzafuwula kuonetsa kuti apambana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Yehova analenga dziko lapansi ndi mphamvu zake;","poem":1},{"text":"Iye anapanga dziko lonse ndi nzeru zake","poem":2},{"lineBreak":true},{"text":"ndipo anayala thambo mwaluso lake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iye akayankhula, kumamveka mkokomo wamadzi akumwamba.","poem":1},{"text":"Iyeyo amabweretsa mitambo kuchokera ku malekezero a dziko lapansi.","poem":2},{"text":"Amabweretsa mphenzi pamodzi ndi mvula","poem":1},{"text":"ndi kutulutsa mphepo yamkuntho kumalo kumene amasungira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Anthu onse ndi opusa ndiponso opanda nzeru;","poem":1},{"text":"mmisiri aliyense wosula golide akuchita manyazi ndi mafano ake.","poem":2},{"text":"Mafano akewo ndi abodza;","poem":1},{"text":"alibe moyo mʼkati mwawo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mafanowo ndi achabechabe, zinthu zosekedwa nazo.","poem":1},{"text":"Pamene anthuwo azidzaweruzidwa mafanowo adzawonongedwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Koma Yehova amene ndi Cholowa cha Yakobo sali ngati mafanowo.","poem":1},{"text":"Iyeyu ndi Mlengi wa zinthu zonse,","poem":2},{"text":"kuphatikizapo mtundu umene anawusankha kuti ukhale anthu ake.","poem":1},{"text":"Dzina lake ndi Yehova Wamphamvuzonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Iwe Babuloni ndi ndodo yanga,","poem":1},{"text":"chida changa chankhondo.","poem":2},{"text":"Ndi iwe ndimaphwanya mitundu ya anthu,","poem":1},{"text":"ndi iwe ndimawononga maufumu,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ndi iwe ndimaphwanya kavalo ndi wokwerapo,","poem":1},{"text":"ndi iwe ndimaphwanya galeta ndi woyendetsa wake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ndi iwe ndimaphwanya mwamuna ndi mkazi,","poem":1},{"text":"ndi iwe ndimaphwanya nkhalamba ndi wachinyamata,","poem":2},{"lineBreak":true},{"text":"ndi iwe ndimaphwanya mnyamata ndi namwali.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndi iwe ndimaphwanya mʼbusa ndi ziweto,","poem":1},{"text":"ndi iwe ndimaphwanya mlimi ndi ngʼombe,","poem":2},{"lineBreak":true},{"text":"ndi iwe ndimaphwanya abwanamkubwa ndi atsogoleri a ankhondo.","poem":2}]},{"type":"verse","number":24,"content":["“Inu mukuona ndidzalanga Babuloni ndi onse amene amakhala mʼdziko la Babuloni chifukwa cha zolakwa zonse anachita ku Ziyoni,” akutero Yehova."]},{"type":"verse","number":25,"content":[{"text":"“Taonani, ndikukuzenga mlandu, iwe phiri lowononga,","poem":1},{"text":"amene umawononga dziko lonse lapansi,”","poem":2},{"text":"akutero Yehova.","poem":4},{"text":"“Ndidzatambalitsa dzanja langa pofuna kukulanga,","poem":1},{"text":"kukugubuduzira pansi kuchokera pa matanthwe ako,","poem":2},{"lineBreak":true},{"text":"ndi kukusandutsa kukhala phiri lopserera.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Palibe ngakhale ndi mwala wako umodzi umene anthu adzawutenga","poem":1},{"text":"kuti awugwiritse ntchito kumangira nyumba,","poem":2},{"lineBreak":true},{"text":"chifukwa iwe udzakhala chipululu mpaka muyaya,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Kwezani mbendera ya nkhondo mʼdziko!","poem":1},{"text":"Lizani lipenga pakati pa mitundu ya anthu!","poem":2},{"text":"Konzekeretsani mitundu ya anthu kuti ikamuthire nkhondo;","poem":1},{"text":"itanani maufumu awa:","poem":2},{"lineBreak":true},{"text":"Ararati, Mini ndi Asikenazi kuti adzamuthire nkhondo.","poem":2},{"text":"Ikani mtsogoleri wankhondo kuti amenyane naye;","poem":1},{"text":"tumizani akavalo ochuluka ngati magulu a dzombe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Konzekeretsani mitundu ya anthu.","poem":1},{"text":"Amenewa ndiwo mafumu a Amedi,","poem":2},{"text":"abwanamkubwa awo, atsogoleri a ankhondo,","poem":1},{"text":"ndiponso ankhondo a mayiko amene amawalamulira, kuti idzathire nkhondo Babuloni.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Dziko likunjenjemera ndi kunthunthumira,","poem":1},{"text":"chifukwa zidzachitikadi zimene Yehova wakonzera Babuloni;","poem":2},{"text":"kusakaza dziko la Babuloni","poem":1},{"text":"kuti musapezeke wokhalamo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ankhondo a ku Babuloni aleka kuchita nkhondo;","poem":1},{"text":"iwo angokhala mʼmalinga awo.","poem":2},{"text":"Mphamvu zawo zatheratu;","poem":1},{"text":"ndipo akhala ngati akazi.","poem":2},{"text":"Malo ake wokhala atenthedwa;","poem":1},{"text":"mipiringidzo ya zipata zake yathyoka.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Othamanga akungopezanapezana,","poem":1},{"text":"amithenga akungotsatanatsatana","poem":2},{"text":"kudzawuza mfumu ya ku Babuloni","poem":1},{"text":"kuti alande mzinda wake wonse.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Madooko onse alandidwa,","poem":1},{"text":"malo onse obisalamo alonda atenthedwa ndi moto,","poem":2},{"lineBreak":true},{"text":"ndipo ankhondo onse asokonezeka.”","poem":2}]},{"type":"verse","number":33,"content":["Yehova Wamphamvuzonse, Mulungu wa Israeli akuti,",{"text":"“Babuloni wokongola uja wakhala ngati malo opunthirapo tirigu","poem":1},{"text":"pa nthawi yake yopuntha tirigu; A ku Yerusalemu akuti,","poem":2},{"lineBreak":true},{"text":"Posachedwapa nthawi yake yomukolola ifika.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"A ku Yerusalemu akuti, “Nebukadinezara mfumu ya ku Babuloni watiwononga,","poem":1},{"text":"watiphwanya,","poem":2},{"lineBreak":true},{"text":"ndi kutitaya ngati mbiya yopanda kanthu.","poem":2},{"text":"Watimeza ngati ngʼona,","poem":1},{"text":"wakhuta ndi zakudya zathu zokoma,","poem":2},{"lineBreak":true},{"text":"kenaka nʼkutilavula.”","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Anthu a ku Ziyoni anene kuti,","poem":1},{"text":"“Zankhanza zimene anatichitira ife ziwabwerere Ababuloni.”","poem":2},{"text":"Anthu okhala mu Yerusalemu anene kuti,","poem":1},{"text":"“Magazi athu amene anakhetsedwa akhale pa amene akukhala ku Babuloni.”","poem":2}]},{"type":"verse","number":36,"content":["Nʼchifukwa chake Yehova akuti,",{"text":"“Taona, ndidzakumenyera nkhondo","poem":1},{"text":"ndi kukulipsirira;","poem":2},{"text":"ndidzawumitsa nyanja yake","poem":1},{"text":"ndipo akasupe ake adzaphwa.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Motero Babuloni adzasanduka mulu wa nyumba zogumuka,","poem":1},{"text":"malo okhala nkhandwe,","poem":2},{"text":"malo ochititsa mantha ndi onyozedwa,","poem":1},{"text":"malo wopanda aliyense wokhalamo.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Anthu ake onse adzabangula ngati mkango,","poem":1},{"text":"adzadzuma ngati ana amkango.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ngati achita dyera","poem":1},{"text":"ndiye ndidzawakonzera madyerero","poem":2},{"lineBreak":true},{"text":"ndi kuwaledzeretsa,","poem":2},{"text":"kotero kuti adzasangalala,","poem":1},{"text":"kenaka nʼkugona tulo mpaka muyaya ndipo sadzadzukanso,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":40,"content":[{"text":"“Ine ndidzawatenga","poem":1},{"text":"kuti akaphedwe ngati ana ankhosa onenepa,","poem":2},{"lineBreak":true},{"text":"ngati nkhosa zazimuna ndi mbuzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Ndithu Babuloni walandidwa,","poem":1},{"text":"mzinda umene dziko lonse lapansi limanyadira wagwidwa!","poem":2},{"text":"Taonani, mmene Babuloni wasandukira chinthu chochititsa mantha","poem":1},{"text":"pakati pa mitundu ya anthu!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Nyanja yakwera ndi kumiza Babuloni;","poem":1},{"text":"mafunde ake okokoma aphimba Babuloni.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Mizinda yake yasanduka bwinja,","poem":1},{"text":"dziko lowuma ndi lachipululu,","poem":2},{"text":"dziko losakhalamo wina aliyense,","poem":1},{"text":"dziko losayendamo munthu aliyense.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ndidzalanga Beli mulungu wa Ababuloni,","poem":1},{"text":"ndidzamusanzitsa zimene anameza.","poem":2},{"text":"Mitundu ya anthu sidzapitanso kwa iye.","poem":1},{"text":"Malinga a Babuloni agwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Tulukani mʼBabuloni anthu anga!","poem":1},{"text":"Pulumutsani miyoyo yanu!","poem":2},{"lineBreak":true},{"text":"Thawani mkwiyo woopsa wa Yehova.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Musataye mtima kapena kuchita mantha","poem":1},{"text":"pamene mphekesera zikumveka mʼdziko mwanu.","poem":2},{"text":"Chaka ndi chaka pamabuka mphekesera","poem":1},{"text":"za ziwawa mʼdziko lapansi,","poem":2},{"lineBreak":true},{"text":"ndiponso yakuti mfumu yakuti ikuthira nkhondo mfumu ina.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Pakuti taonani, nthawi ikubwera ndithu","poem":1},{"text":"pamene ndidzalanga mafano a ku Babuloni;","poem":2},{"text":"dziko lake lonse lidzachita manyazi","poem":1},{"text":"ndi ophedwa ake onse adzakhala ngundangunda pakati pake.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Pamenepo kumwamba ndi dziko lapansi ndi zonse zili mʼmenemo","poem":1},{"text":"zidzayimba mokondwa chifukwa cha kugwa kwa Babuloni.","poem":2},{"text":"Anthu owononga ochokera kumpoto","poem":1},{"text":"adzamuthira nkhondo,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“Babuloni anapha anthu ambiri pa dziko lapansi.","poem":1},{"text":"Tsono, nawo anthu a ku Babuloni ayenera kuphedwa","poem":2},{"lineBreak":true},{"text":"chifukwa anapha anthu a ku Yerusalemu.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Inu amene munapulumuka ku nkhondo ya Babuloni,","poem":1},{"text":"chokani pano ndipo musazengereze!","poem":2},{"text":"Kumbukirani Yehova ngakhale muli ku mayiko akutali,","poem":1},{"text":"ganizirani za Yerusalemu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"Inu mukuti, “Tikuchita manyazi,","poem":1},{"text":"chifukwa tanyozedwa","poem":2},{"lineBreak":true},{"text":"ndipo nkhope zathu zili ndi manyazi,","poem":2},{"text":"chifukwa anthu achilendo alowa","poem":1},{"text":"malo opatulika a Nyumba ya Yehova.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Nʼchifukwa chake Yehova akuti,","poem":1},{"text":"“Masiku akubwera pamene ndidzalanga mafano ake,","poem":2},{"text":"ndipo mʼdziko lake lonse","poem":1},{"text":"anthu ovulala adzabuwula.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Ngakhale Babuloni atadzikweza mpaka mlengalenga","poem":1},{"text":"ndi kulimbitsa nsanja zake,","poem":2},{"lineBreak":true},{"text":"ndidzatuma anthu owononga kudzamenyana naye,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“Imvani mfuwu wolira kuchokera ku Babuloni.","poem":1},{"text":"Imvani phokoso lachiwonongeko chachikulu","poem":2},{"lineBreak":true},{"text":"kuchokera mʼdziko la Babuloni.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Pakuti Yehova akuwononga Babuloni,","poem":1},{"text":"ndipo akuthetsa phokoso lake lalikulu.","poem":2},{"text":"Mfuwu wa adani ukumveka ngati mkokomo wa madzi ambiri.","poem":1},{"text":"Phokoso lawo likunka likwererakwerera.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Pakuti wowononga wafika kudzamenyana ndi Babuloni,","poem":1},{"text":"ankhondo ake agwidwa,","poem":2},{"lineBreak":true},{"text":"ndipo mauta awo athyoka.","poem":2},{"text":"Paja Yehova ndi Mulungu wobwezera chilango;","poem":1},{"text":"adzabwezera kwathunthu.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Ndidzaledzeretsa akuluakulu ake pamodzi ndi anzeru ake,","poem":1},{"text":"abwanamkubwa ake, atsogoleri a ankhondo pamodzinso ndi ankhondo;","poem":2},{"text":"adzagona kwamuyaya osadzukanso,”","poem":1},{"text":"akutero Mfumu, amene dzina lake ndi Yehova Wamphamvuzonse.","poem":2}]},{"type":"verse","number":58,"content":["Yehova Wamphamvuzonse akuti,",{"text":"“Malinga aakulu a Babuloni adzasalazidwa","poem":1},{"text":"ndipo zipata zake zazitali zidzatenthedwa;","poem":2},{"text":"mitundu ya anthu inangogwira ntchito pachabe.","poem":1},{"text":"Anthu anatopa ndi kumanga zimene tsopano zikupsa ndi moto.”","poem":2}]},{"type":"verse","number":59,"content":["Zedekiya mfumu ya Yuda inali ndi phungu wake wamkulu amene dzina lake linali Seraya mwana wa Neriya chidzukulu cha Maseya. Mʼchaka chachinayi cha ulamuliro wake, Zedekiya anapita ndi Seraya ku Babuloni. Tsono mneneri Yeremiya anamupatsirako uthenga Serayayo."]},{"type":"verse","number":60,"content":["Yeremiya anali atalemba mʼbuku za masautso onse amene adzafike pa Babuloni ndi zina zonse zokhudza Babuloni."]},{"type":"verse","number":61,"content":["Yeremiya anawuza Seraya kuti, “Ukakafika ku Babuloni, ukaonetsetse kuti wawawerengera anthu onse mawu onsewa."]},{"type":"verse","number":62,"content":["Ndipo ukanene kuti, ‘Inu Yehova, mwanena kuti mudzawononga malo ano, kotero kuti simudzatsala munthu kapena nyama mʼdziko muno; lidzakhala chipululu mpaka muyaya.’"]},{"type":"verse","number":63,"content":["Ukakatha kuwerenga bukuli, ukalimangirire ku mwala ndipo ukaliponye pakati pa mtsinje wa Yufurate."]},{"type":"verse","number":64,"content":["Ndipo ukanene kuti, ‘Umu ndi mmene adzamirire Babuloni ndipo sadzadzukanso chifukwa cha masautso amene adzamugwere.’ ”",{"lineBreak":true},"Mawu a Yeremiya athera pamenepa."]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}