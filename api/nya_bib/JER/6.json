{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Kuzingidwa kwa Yerusalemu"]},{"type":"verse","number":1,"content":[{"text":"“Thawani, inu anthu a ku Benjamini!","poem":1},{"text":"Tulukani mu Yerusalemu!","poem":2},{"text":"Lizani lipenga ku Tekowa!","poem":1},{"text":"Kwezani mbendera ku Beti-Hakeremu!","poem":2},{"text":"Pakuti tsoka lalikulu likubwera kuchokera kumpoto,","poem":1},{"text":"ndipo chiwonongekocho nʼchachikulu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kodi mzinda wa Ziyoni suli ngati msipu wokongola kwambiri,","poem":1},{"text":"kumene abusa amafikako ndi ziweto zawo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abusa ndi nkhosa zawo adzabwera kudzalimbana nawo;","poem":1},{"text":"adzamanga matenti awo mowuzinga,","poem":2},{"lineBreak":true},{"text":"ndipo aliyense adzakhazika anthu ake pamalo pake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Adzanena kuti, “Konzekani kuwuthira nkhondo mzindawo!","poem":1},{"text":"Nyamukani, kuti tiwuthire nkhondo mzindawu masana ano.","poem":2},{"text":"Koma tili ndi tsoka, dzuwa lapendeka,","poem":1},{"text":"ndipo zithunzithunzi za kumadzulo zikunka zitalika.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tsono nyamukani kuti tiwuthire nkhondo mzindawu usiku uno","poem":1},{"text":"ndi kuwononga malinga ake!”","poem":2}]},{"type":"verse","number":6,"content":["Yehova Wamphamvuzonse akuti,",{"text":"“Dulani mitengo","poem":1},{"text":"ndipo mumange mitumbira yankhondo kulimbana ndi Yerusalemu.","poem":2},{"text":"Mzinda umenewu uyenera kulangidwa;","poem":1},{"text":"wadzaza ndi kuponderezana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Monga momwe chitsime chimatulutsira madzi","poem":1},{"text":"ndi mmenenso Yerusalemu amatulutsira zoyipa zake.","poem":2},{"text":"Chiwawa ndi chiwonongeko ndi zomwe zimamveka mu mzindamo;","poem":1},{"text":"nthenda yake ndi mabala ake ndimaziona nthawi zonse.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iwe Yerusalemu, tengapo phunziro,","poem":1},{"text":"kuopa kuti chikondi changa pa iwe chingakuchokere","poem":2},{"text":"ndi kusandutsa dziko lako kukhala bwinja","poem":1},{"text":"mopanda munthu wokhalamo.”","poem":2}]},{"type":"verse","number":9,"content":["Yehova Wamphamvuzonse anandiwuza kuti,",{"text":"“Adani adzawakunkha ndithu anthu otsala a Israeli,","poem":1},{"text":"monga momwe amachitira populula mphesa.","poem":2},{"text":"Tsono iwe yesetsa kupulumutsa amene ungathe","poem":1},{"text":"monga mmene amachitira munthu wokolola mphesa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kodi ndiyankhule ndi yani ndi kumuchenjeza?","poem":1},{"text":"Ndinene mawu ochenjeza kwa yani kuti amve?","poem":2},{"text":"Makutu awo ndi otsekeka","poem":1},{"text":"kotero kuti sangathe kumva.","poem":2},{"text":"Mawu a Yehova ndi onyansa kwa iwo;","poem":1},{"text":"sasangalatsidwa nawo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Koma ine ndadzazidwa ndi mkwiyo wa Yehova,","poem":1},{"text":"ndipo ndatopa ndi kusunga mkwiyo wa Yehova.","poem":2},{"lineBreak":true},{"text":"Yehova anandiwuza kuti, “Tsono ndidzawutulutsira mkwiyo umenewu pa ana oyenda mʼmisewu","poem":1},{"text":"ndi pa achinyamata amene asonkhana pamodzi;","poem":2},{"text":"pakutinso mwamuna ndi mkazi wake adzatengedwa,","poem":1},{"text":"pamodzi ndi okalamba amene ali ndi zaka zochuluka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nyumba zawo adzazipereka kwa ena,","poem":1},{"text":"pamodzi ndi minda yawo ndi akazi awo.","poem":2},{"text":"Ndidzatambasula dzanja langa kukantha","poem":1},{"text":"anthu okhala mʼdzikomo,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"“Kuyambira wamngʼono mpaka wamkulu,","poem":1},{"text":"onse ali ndi dyera lofuna kupeza phindu mwa kuba;","poem":2},{"text":"aneneri pamodzi ndi ansembe omwe,","poem":1},{"text":"onse amachita zachinyengo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amapoletsa zilonda za anthu anga","poem":1},{"text":"pamwamba pokha.","poem":2},{"text":"Iwo amanena kuti, ‘Mtendere, mtendere,’","poem":1},{"text":"pamene palibe mtendere.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kodi amachita manyazi akamachita zonyansazo?","poem":1},{"text":"Ayi, sachita manyazi ndi pangʼono pomwe;","poem":2},{"lineBreak":true},{"text":"sadziwa ndi kugwetsa nkhope komwe.","poem":2},{"text":"Choncho iwo adzagwera pakati pa anzawo amene agwa kale;","poem":1},{"text":"adzagwa pansi tsiku limene ndidzawalange,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":16,"content":["Yehova akuti,",{"text":"“Imani pa mphambano ndipo mupenye;","poem":1},{"text":"kumeneko ndiye kuli njira zakale,","poem":2},{"text":"funsani kumene kuli njira yabwino. Yendani mʼmenemo,","poem":1},{"text":"ndipo mudzapeza mpumulo wa miyoyo yanu.","poem":2},{"lineBreak":true},{"text":"Koma inu munati, ‘Ife sitidzayenda njira imeneyo.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ine ndinakupatsani alonda oti akuyangʼanireni","poem":1},{"text":"ndipo ndinati, ‘Imvani kulira kwa lipenga!’","poem":2},{"lineBreak":true},{"text":"koma inu munati, ‘Sitidzamvera.’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nʼchifukwa chake imvani, inu anthu a mitundu ina;","poem":1},{"text":"yangʼanitsitsani, inu amene mwasonkhana pano,","poem":2},{"lineBreak":true},{"text":"chimene chidzawachitikire anthuwo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Imvani, inu anthu okhala pa dziko lapansi,","poem":1},{"lineBreak":true},{"text":"ndikubweretsa masautso pa anthu awa.","poem":1},{"text":"Zimenezi ndi mphotho ya ntchito zawo.","poem":2},{"text":"Iwowa sanamvere mawu anga","poem":1},{"text":"ndipo anakana lamulo langa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kodi pali phindu lanji ngakhale mubwere ndi lubani kuchokera ku Seba,","poem":1},{"text":"kapena zonunkhira zina kuchokera ku dziko lakutali?","poem":2},{"text":"Nsembe zanu zopsereza Ine sindidzalandira;","poem":1},{"text":"nsembe zanu sizindikondweretsa.”","poem":2}]},{"type":"verse","number":21,"content":["Choncho Yehova akuti,",{"text":"“Ndidzayika zokhumudwitsa pamaso pa anthu awa.","poem":1},{"text":"Abambo ndi ana awo aamuna onse adzapunthwa ndi kugwa;","poem":2},{"lineBreak":true},{"text":"anansi awo ndi abwenzi awo adzawonongeka.”","poem":2}]},{"type":"verse","number":22,"content":["Yehova akunena kuti,",{"text":"“Taonani, gulu lankhondo likubwera","poem":1},{"text":"kuchokera kumpoto;","poem":2},{"text":"mtundu wa anthu amphamvu wanyamuka","poem":1},{"text":"kuchokera kumathero a dziko lapansi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Atenga mauta ndi mikondo;","poem":1},{"text":"ndi anthu ankhanza ndi opanda chifundo.","poem":2},{"text":"Phokoso lawo lili ngati mkokomo wa nyanja.","poem":1},{"text":"Akwera pa akavalo awo","poem":2},{"text":"ndipo akonzekera ngati anthu ankhondo,","poem":1},{"text":"kudzakuthirani nkhondo anthu a ku Ziyoni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"A ku Ziyoni akuti “Ife tamva mbiri yawo,","poem":1},{"text":"ndipo manja anthu alefukiratu.","poem":2},{"text":"Nkhawa yatigwira,","poem":1},{"text":"ndipo tikumva ululu ngati mayi pa nthawi yake yochira.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Musapite ku minda","poem":1},{"text":"kapena kuyenda mʼmisewu,","poem":2},{"text":"pakuti mdani ali ndi lupanga,","poem":1},{"text":"ndipo ponseponse anthu akuchita mantha.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inu anthu anga, valani ziguduli","poem":1},{"text":"ndipo gubudukani pa phulusa;","poem":2},{"text":"lirani mwamphamvu","poem":1},{"text":"ngati munthu wolirira mwana wake mmodzi yekha,","poem":2},{"text":"pakuti mwadzidzidzi wowonongayo","poem":1},{"text":"adzabwera kudzatipha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Iwe Yeremiya, ndakuyika kuti ukhale choyesera zitsulo.","poem":1},{"text":"Uwayese anthu anga","poem":2},{"text":"monga ungayesere chitsulo","poem":1},{"text":"kuti uwone makhalidwe awo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Onsewo ali ndi khalidwe lokanika ndi lowukira","poem":1},{"text":"ndipo akunka nanena zamiseche.","poem":2},{"text":"Iwo ndi olimba ngati mkuwa ndi chitsulo.","poem":1},{"text":"Onse amangochita zoyipa zokhazokha.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Moto mu mvukuto ukuyaka kwambiri;","poem":1},{"text":"mtovu watha kusungunuka ndi moto.","poem":2},{"text":"Koma ntchito yosungunulayo sikupindula","poem":1},{"text":"chifukwa zoyipa sizikuchokapo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Iwo ali ngati siliva wotayidwa,","poem":1},{"text":"chifukwa Yehova wawakana.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}