{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JER","translationId":"nya_bib","name":"YEREMIYA","commonName":"YEREMIYA","title":"Yeremiya","order":24,"numberOfChapters":52,"sha256":"f4f28aa90c2313b610604805703fae8890fb88e88bdb06840d8715e78d33af25","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nya_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Yehova akuti, “ ‘Pa nthawi imeneyo, mafupa a mafumu ndi a akuluakulu a ku Yuda, mafupa a ansembe ndi a aneneri, ndiponso mafupa a anthu a ku Yerusalemu adzafukulidwa."]},{"type":"verse","number":2,"content":["Adzawamwaza pa nthaka kuyangʼana dzuwa, mwezi ndi nyenyezi zonse zamlengalenga, zimene ankazikonda, kuzitumikira ndi kuzitsatira, kupemphako nzeru ndiponso kuzilambira. Mafupawo sadzawasonkhanitsa kapena kuwakwirira, koma adzakhala ngati ndowe pamwamba pa nthaka."]},{"type":"verse","number":3,"content":["Otsala onse a mtundu woyipawu adzafuna imfa kopambana moyo kulikonse kumene ndidzawapirikitsirako, akutero Yehova Wamphamvuzonse.’ ”"]},{"type":"heading","content":["Tchimo ndi Chilango Chake"]},{"type":"verse","number":4,"content":["“Tsono awuze anthuwa, ‘Yehova akuti:",{"text":"“ ‘Kodi anthu akagwa sangadzukenso?","poem":1},{"text":"Munthu akasochera kodi sangathe kubwereranso?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Chifukwa chiyani nanga anthu awa akupitirirabe kuchimwa, osabwerera?","poem":1},{"text":"Chifukwa chiyani Yerusalemu akubwerera mʼmbuyo?","poem":2},{"text":"Iwo akangamira chinyengo;","poem":1},{"text":"akukana kubwerera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ine ndinatchera khutu kumvetsera","poem":1},{"text":"koma iwo sanayankhulepo zoona.","poem":2},{"text":"Palibe woyipa amene analapapo zoyipa zake,","poem":1},{"text":"nʼkumati, ‘Ine ndachita chiyani?’","poem":2},{"text":"Aliyense akutsatira njira yake","poem":1},{"text":"ngati kavalo wothamangira nkhondo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mbalame yotchedwa kakowa ija imadziwa","poem":1},{"text":"nthawi yake mlengalenga.","poem":2},{"text":"Koma nkhunda, namzeze ndi chingalu","poem":1},{"text":"zimadziwa nthawi yonyamukira ulendo,","poem":2},{"text":"koma anthu anga sadziwa","poem":1},{"text":"malamulo a Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Inu mukunena bwanji kuti,","poem":1},{"text":"‘Ndife anzeru ndipo timasunga malamulo a Yehova?’","poem":2},{"text":"Koma ndi alembi anu","poem":1},{"text":"amene akulemba zabodza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anthu anzeru achita manyazi;","poem":1},{"text":"athedwa nzeru ndipo agwidwa.","poem":2},{"text":"Iwo anakana mawu a Yehova.","poem":1},{"text":"Nanga tsono nzeru zawo ziwapinduliranji?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nʼchifukwa chake akazi awo ndidzawapereka kwa amuna ena","poem":1},{"text":"ndipo minda yawo ndidzayipereka kwa amene adzawagonjetse.","poem":2},{"text":"Kuyambira wamngʼono mpaka wamkulu,","poem":1},{"text":"onse ali ndi khalidwe lofuna kupeza chuma mwakuba.","poem":2},{"text":"Aneneri pamodzi ndi ansembe omwe,","poem":1},{"text":"onse amachita zachinyengo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iwo amapoletsa zilonda za anthu anga","poem":1},{"text":"pamwamba chabe","poem":2},{"text":"nʼkumati, ‘Mtendere, mtendere,’","poem":1},{"text":"pamene palibe mtendere.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kodi amachita manyazi akamachita zonyansazi?","poem":1},{"text":"Ayi, alibe manyazi ndi pangʼono pomwe;","poem":2},{"lineBreak":true},{"text":"iwo sadziwa nʼkugwetsa nkhope komwe.","poem":2},{"text":"Choncho iwo adzagwera pakati pa anzawo amene agwa kale;","poem":1},{"text":"adzagwa pansi tsiku limene ndidzawalanga,","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ ‘Ndidzatenga zokolola zawo,","poem":1},{"text":"Sipadzakhalanso mphesa pa mpesa","poem":2},{"text":"kapena nkhuyu pa mkuyu,","poem":1},{"text":"ndipo masamba ake adzawuma.","poem":2},{"text":"Zinthu zimene ndinawapatsa","poem":1},{"text":"ndidzawachotsera.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Koma amati, “Tikukhala pano chifukwa chiyani?","poem":1},{"text":"Tiyeni tonse pamodzi","poem":2},{"text":"tithawire ku mizinda yotetezedwa","poem":1},{"text":"ndi kukafera kumeneko.","poem":2},{"text":"Pakuti Yehova Mulungu wathu watsimikiza kuti tiyenera kufa.","poem":1},{"text":"Watipatsa madzi aululu kuti timwe,","poem":2},{"lineBreak":true},{"text":"chifukwa tamuchimwira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tinkayembekezera mtendere","poem":1},{"text":"koma palibe chabwino chomwe chinachitika,","poem":2},{"text":"tinkayembekezera kuchira","poem":1},{"text":"koma tinakumana ndi zoopsa zokhazokha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kulira kwa ngʼombe zazimuna za mdani","poem":1},{"text":"kukumveka kuchokera ku Dani;","poem":2},{"text":"dziko lonse likunjenjemera","poem":1},{"text":"chifukwa cha kulira kwa akavalowo.","poem":2},{"text":"Akubwera kudzawononga dziko","poem":1},{"text":"ndi zonse zimene zili mʼmenemo.","poem":2},{"lineBreak":true},{"text":"Adzawononga mzinda ndi onse okhalamo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yehova akuti, “Onani, ndikukutumizirani njoka zaululu,","poem":1},{"text":"mphiri zimene munthu sangathe kuzilodza,","poem":2},{"lineBreak":true},{"text":"ndipo zidzakulumani,”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ndadzazidwa ndi chisoni kwambiri,","poem":1},{"text":"mtima wanga walefukiratu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Imvani kulira kwa anthu anga","poem":1},{"text":"kuchokera ku dziko lakutali:","poem":2},{"text":"akuti, “Kodi Yehova sali ku Ziyoni?","poem":1},{"text":"Kodi mfumu yake sili kumeneko?”","poem":2},{"lineBreak":true},{"text":"“Chifukwa chiyani akundiputa ndi mafano awo osema,","poem":1},{"text":"ndi milungu yawo yachilendo?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Nthawi yokolola yapita,","poem":1},{"text":"chilimwe chapita,","poem":2},{"lineBreak":true},{"text":"koma sitinapulumuke.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Chifukwa cha mavuto a anthu anga, ine ndikumva kuwawa;","poem":1},{"text":"ndikungolira ndipo mantha aakulu andigwira.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kodi ku Giliyadi kulibe mankhwala ochiritsa?","poem":1},{"text":"Kodi kumeneko kulibe singʼanga?","poem":2},{"text":"Nanga chifukwa chiyani mabala","poem":1},{"text":"a anthu anga sanapole?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}