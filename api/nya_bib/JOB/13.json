{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"“Ndaziona ndi maso anga zonsezi,","poem":1},{"text":"ndazimva ndi makutu anga ndipo ndazimvetsa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zimene inu mukudziwa, inenso ndimazidziwa;","poem":1},{"text":"ineyo sindine munthu wamba kwa inu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Koma ine ndikulakalaka nditayankhula ndi Wamphamvuzonse","poem":1},{"text":"ndi kukamba mlandu wanga ndi Mulungu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Koma inu mukundipaka mabodza;","poem":1},{"text":"nonsenu ndinu asingʼanga opanda phindu!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Achikhala munangokhala chete nonsenu!","poem":1},{"text":"Apo mukanachita zanzeru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsopano imvani kudzikanira kwanga;","poem":1},{"text":"imvani kudandaula kwa pakamwa panga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodi inu mudzayankhula moyipa kuyankhulira Mulungu?","poem":1},{"text":"Kodi mudzayankhulira Iyeyo mwachinyengo?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kodi mudzaonetsa kuti Iyeyo ngokondera?","poem":1},{"text":"Kodi inu mudzamuteteza Mulungu pa mlandu wake?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mulungu atayangʼanitsitsa, inu nʼkukupezani wosalakwa?","poem":1},{"text":"Kodi inu mungamunamize Iye monga momwe munganamizire munthu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndithudi, Iye angathe kukudzudzulani","poem":1},{"text":"ngati muchita zokondera mseri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodi ulemerero wake sungakuopseni?","poem":1},{"text":"Kodi kuopsa kwake sikungakuchititseni mantha?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mawu anu anzeru ali ngati miyambi yopanda tanthauzo;","poem":1},{"text":"mawu anu odzitchinjirizira ali ngati mpanda wadothi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Khalani chete ndipo ndilekeni ndiyankhule;","poem":1},{"text":"tsono zimene zindichitikire zichitike.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Chifukwa chiyani ndikuyika moyo wanga pa chiswe","poem":1},{"text":"ndi kutengera mʼmanja moyo wangawu?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngakhale Iye andiphe, komabe ndidzamukhulupirira;","poem":1},{"text":"ndithu, ndidzafotokoza mlandu wanga pamaso pake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zoonadi, ichi ndiye chidzakhala chipulumutso changa","poem":1},{"text":"pakuti palibe munthu wosapembedza amene angafike pamaso pake!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mvetserani mosamala mawu anga;","poem":1},{"text":"makutu anu amve zimene ndikunena.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pakuti tsopano ndawukonzekera mlandu wanga,","poem":1},{"text":"ndikudziwa ndipo adzandipeza wolungama.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kodi alipo wina amene angatsutsane nane?","poem":1},{"text":"ngati zili choncho, ndidzakhala chete ndi kufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Inu Mulungu, ndipatseni zinthu ziwiri izi,","poem":1},{"text":"ndipo pamenepo ine sindidzakubisalirani:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Muchotse dzanja lanu pa ine,","poem":1},{"text":"ndipo muleke kundichititsa mantha ndi kuopsa kwanuko.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tsono muyitane ndipo ndidzayankha,","poem":1},{"text":"kapena mulole kuti ine ndiyankhule ndipo Inu muyankhe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kodi zolakwa zanga ndi zingati ndipo machimo anga ndi angati?","poem":1},{"text":"Wonetseni kulakwa kwanga ndi machimo anga.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Chifukwa chiyani mukundifulatira","poem":1},{"text":"ndi kundiyesa ine mdani wanu?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kodi mudzazunza tsamba lowuluka ndi mphepo?","poem":1},{"text":"Kodi mudzathamangitsa mungu wowuma?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Pakuti Inu mwalemba zinthu zowawa zonditsutsa nazo","poem":1},{"text":"ndipo mukundipaka machimo a pa ubwana wanga.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Inu mwamanga miyendo yanga ndi maunyolo.","poem":1},{"text":"Mumayangʼanitsitsa mayendedwe anga onse","poem":2},{"lineBreak":true},{"text":"poyika zizindikiro pamene mapazi anga apondapo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Motero munthu amatha ngati chinthu chofumbwa,","poem":1},{"text":"ngati chovala chodyedwa ndi njenjete.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}