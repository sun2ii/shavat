{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“Munthu wobadwa mwa amayi","poem":1},{"text":"amakhala masiku owerengeka ndipo ndi odzaza ndi mavuto okhaokha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amaphuka ngati duwa ndipo kenaka amafota;","poem":1},{"text":"amathawa ngati mthunzi ndipo sakhalitsa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodi munthu wotereyo nʼkumuyangʼanitsitsa?","poem":1},{"text":"Kodi mungamubweretse pamaso panu kuti mumuzenge mlandu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndani angatulutse chabwino mʼchoyipa?","poem":1},{"text":"Palibe ndi mmodzi yemwe!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Masiku a munthu ndi odziwikiratu;","poem":1},{"text":"munakhazikitsa chiwerengero cha miyezi yake","poem":2},{"lineBreak":true},{"text":"ndipo munamulembera malire amene sangathe kuwalumpha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Choncho Inu mumufulatire ndipo mumuleke apumule","poem":1},{"text":"kufikira atakondwera nawo moyo ngati munthu waganyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Mtengo uli nacho chiyembekezo:","poem":1},{"text":"ngati wadulidwa, udzaphukiranso","poem":2},{"lineBreak":true},{"text":"ndipo nthambi zake sizidzaleka kuphukira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mizu yake ingathe kukalamba mʼnthaka","poem":1},{"text":"ndipo chitsa chake nʼkuwola pa dothi,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"koma pamene chinyontho chafika udzaphukira","poem":1},{"text":"ndipo udzaphuka nthambi ngati mtengo wanthete.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Koma munthu amafa nayikidwa mʼmanda,","poem":1},{"text":"amapuma mpweya wotsiriza ndipo kutha kwake nʼkomweko.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Monga madzi amaphwera mʼnyanja","poem":1},{"text":"kapena monga mtsinje umaphwera nuwuma,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"momwemonso munthu amagona ndipo sadzukanso;","poem":1},{"text":"mpaka zamlengalenga zidzathe, anthu sadzauka","poem":2},{"lineBreak":true},{"text":"kapena kudzutsidwa ku tulo tawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Aa, Inu mukanangondibisa mʼmanda","poem":1},{"text":"ndi kundiphimba kuti ndisaoneke mpaka mkwiyo wanu utapita!","poem":2},{"text":"Achikhala munandiyikira nthawi,","poem":1},{"text":"kuti pambuyo pake mundikumbukirenso.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Munthu akafa, kodi adzakhalanso ndi moyo?","poem":1},{"text":"Masiku anga onse a moyo wovutikawu","poem":2},{"lineBreak":true},{"text":"ndidzadikira mpaka itafika nthawi yomasulidwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inu mudzandiyitane ndipo ndidzakuyankhani;","poem":1},{"text":"inu mudzafunitsitsa kuona cholengedwa chimene munachipanga ndi manja anu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndithudi pamenepo mudzayangʼana mayendedwe anga","poem":1},{"text":"koma simudzalondola tchimo langa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Zolakwa zanga zidzakulungidwa mʼthumba;","poem":1},{"text":"inu mudzaphimba tchimo langa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Koma monga phiri limakokolokera ndi kuswekasweka","poem":1},{"text":"ndipo monga thanthwe limasunthira kuchoka pa malo ake,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"monganso madzi oyenda amaperesera miyala","poem":1},{"text":"ndipo madzi othamanga amakokololera nthaka,","poem":2},{"lineBreak":true},{"text":"momwemonso Inu mumawononga chiyembekezo cha munthu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Inu mumamugonjetsa kamodzinʼkamodzi ndipo munthuyo nʼkutheratu;","poem":1},{"text":"Inu mumasintha maonekedwe a nkhope yake ndipo mumamutaya kutali.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ana ake akamalemekezedwa, iyeyo sazidziwa zimenezo;","poem":1},{"text":"akamachititsidwa manyazi iye saziona zimenezo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Iye amangomva zowawa za mʼthupi lake","poem":1},{"text":"ndipo amangodzilirira yekha mwini wakeyo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}