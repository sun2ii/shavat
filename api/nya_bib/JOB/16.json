{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["Mawu a Yobu"]},{"type":"verse","number":1,"content":["Pamenepo Yobu anayankha kuti,"]},{"type":"verse","number":2,"content":[{"text":"“Ndinamvapo zambiri monga zimenezi;","poem":1},{"text":"nonsenu ndinu anthu osatha kutonthoza mtima mnzanu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodi mawu anu ochulukawo adzatha?","poem":1},{"text":"Kodi chikukuvutani nʼchiyani kuti muzingoyankhula mawu otsutsawa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inenso ndikanatha kuyankhula monga inu,","poem":1},{"text":"inuyo mukanakhala monga ndilili inemu;","poem":2},{"text":"Ine ndikanatha kuyankhula mawu omveka bwino kutsutsana nanu","poem":1},{"text":"ndi kukupukusirani mutu wanga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndipo mawu a pakamwa panga akanakulimbikitsani;","poem":1},{"text":"chitonthozo chochokera pa milomo yanga chikanachepetsa ululu wanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Koma ine ndikati ndiyankhule ululu wanga sukuchepa;","poem":1},{"text":"ndipo ndikati ndikhale chete, ululu wanga sukuchokabe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndithudi, Inu Mulungu mwanditha mphamvu;","poem":1},{"text":"mwawononga banja langa lonse.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inu mwandimanga ndipo kundimangako kwakhala umboni;","poem":1},{"text":"kuwonda kwanga kwandiwukira ndipo kukuchita umboni wonditsutsa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mulungu amabwera kwa ine mwankhanza ndipo amadana nane,","poem":1},{"text":"amachita kulumira mano;","poem":2},{"lineBreak":true},{"text":"mdani wanga amandituzulira maso.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anthu amatsekula pakamwa pawo kundikuwiza;","poem":1},{"text":"amandimenya pa tsaya mwachipongwe","poem":2},{"lineBreak":true},{"text":"ndipo amagwirizana polimbana nane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mulungu wandipereka kwa anthu ochita zoyipa","poem":1},{"text":"ndipo wandiponyera mʼmanja mwa anthu oyipa mtima.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ine ndinali pamtendere, koma Mulungu ananditswanya;","poem":1},{"text":"anandigwira pa khosi ndi kundiphwanya.","poem":2},{"text":"Iye anandisandutsa choponyera chandamale chake;","poem":1}]},{"type":"verse","number":13,"content":[{"text":"anthu ake oponya mauta andizungulira.","poem":2},{"text":"Mopanda kundimvera chisoni, Iye akulasa impsyo zanga","poem":1},{"text":"ndipo akutayira pansi ndulu yanga.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akundivulaza kawirikawiri,","poem":1},{"text":"akuthamangira pa ine monga munthu wankhondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ndasokerera chiguduli pa thupi langa","poem":1},{"text":"ndipo ndayika mphamvu zanga pa fumbi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Maso anga afiira ndi kulira,","poem":1},{"text":"ndipo zikope zanga zatupa;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"komatu manja anga sanachite zachiwawa","poem":1},{"text":"ndipo pemphero langa ndi lolungama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Iwe dziko lapansi, usakwirire magazi anga;","poem":1},{"text":"kulira kwanga kofuna thandizo kusalekeke!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngakhale tsopano mboni yanga ili kumwamba;","poem":1},{"text":"wonditchinjiriza pa mlandu wanga ali komweko.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wondipembedzera ndi bwenzi langa,","poem":1},{"text":"pamene maso anga akukhuthula misozi kwa Mulungu;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"iye, mʼmalo mwanga, amamudandaulira Mulungu","poem":1},{"text":"monga munthu amadandaulira bwenzi lake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Pakuti sipapita zaka zambiri","poem":1},{"text":"ndisanayende mʼnjira imene sindidzabwerera.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}