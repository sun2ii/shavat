{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"“Mtima wanga wasweka,","poem":1},{"text":"masiku anga atha,","poem":2},{"lineBreak":true},{"text":"manda akundidikira.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndithudi, anthu ondiseka andizungulira;","poem":1},{"text":"maso anga akupenyetsetsa mdani wanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Inu Mulungu, patseni chikole chimene mukufuna.","poem":1},{"text":"Ndani wina amene adzandiperekera ine chikole?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inu mwatseka maganizo awo kuti asamvetse zinthu;","poem":1},{"text":"choncho simudzawalola kuti apambane.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngati munthu apereka mnzake chifukwa cha chuma,","poem":1},{"text":"ana ake sadzaona mwayi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mulungu wandisandutsa chisudzo chochiseka aliyense,","poem":1},{"text":"munthu amene anthu amalavulira malovu nkhope yake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mʼmaso mwanga mwada ndi chisoni;","poem":1},{"text":"ndawonda ndi mutu womwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anthu olungama akudabwa nazo zimenezi;","poem":1},{"text":"anthu osachimwa akupsera mtima anthu osapembedza Mulungu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Komabe anthu olungama adzasunga njira zawo,","poem":1},{"text":"ndipo anthu a makhalidwe abwino mphamvu zawo zidzanka zikuchuluka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Tsono bwerani nonsenu, bwerezaninso mawu anuwo,","poem":1},{"text":"sindidzapezapo munthu wanzeru pakati panupo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Masiku anga atha, zimene ndinakonza zalephereka,","poem":1},{"text":"pamodzinso ndi zokhumba za mtima wanga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anthu awa amasandutsa usiku kukhala usana,","poem":1},{"text":"nthawi ya usiku iwo amati ‘kwatsala pangʼono kucha.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngati nyumba imene ndikuyiyembekezera ndi manda,","poem":1},{"text":"ngati ndiyala bedi langa mu mdima,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ngati ndinena kwa dzenje la manda ‘ndinu abambo anga,’","poem":1},{"text":"ndiponso kwa mphutsi kuti, ‘ndinu amayi anga’ kapena ‘mlongo wanga,’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"tsono chiyembekezo changa chili kuti?","poem":1},{"text":"Ndani angaone populumukira panga?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndithu sindidzakhalanso ndi chiyembekezo chilichonse,","poem":1},{"text":"polowa mʼmanda, pamene ndidzatsikira ku fumbi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}