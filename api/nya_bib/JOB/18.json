{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Mawu a Bilidadi"]},{"type":"verse","number":1,"content":["Pamenepo Bilidadi wa ku Suki anayankha kuti,"]},{"type":"verse","number":2,"content":[{"text":"“Kodi iwe Yobu utsiriza liti zoyankhula zakozi?","poem":1},{"text":"Khala munthu wozindikira zinthu ndipo ukatero ife tidzayankhula.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Chifukwa chiyani ukutiyesa ngati ngʼombe","poem":1},{"text":"ndi kuoneka ngati opusa mʼmaso mwako?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iwe amene ukudzipweteka wekha ndi mkwiyo wako,","poem":1},{"text":"kodi dziko lapansi lisanduke bwinja chifukwa cha iweyo?","poem":2},{"lineBreak":true},{"text":"Kodi kapena thanthwe lisunthidwe kuchoka pa malo ake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Nyale ya munthu woyipa yazimitsidwa;","poem":1},{"text":"malawi a moto wake sakuwalanso.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuwala kwa mʼnyumba mwake kwasanduka mdima;","poem":1},{"text":"nyale ya pambali pake yazima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mayendedwe ake amgugu azilala;","poem":1},{"text":"fundo zake zomwe zamugwetsa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mapazi ake amulowetsa mu ukonde","poem":1},{"text":"ndipo akungoyendayenda mu ukondewo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Msampha wamkola mwendo;","poem":1},{"text":"khwekhwe lamugwiritsitsa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amutchera msampha pansi mobisika;","poem":1},{"text":"atchera diwa pa njira yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zoopsa zikumuchititsa mantha kumbali zonse,","poem":1},{"text":"zikutsatira mayendedwe ake onse.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mphamvu zake zatha chifukwa cha njala,","poem":1},{"text":"tsoka likumudikira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wagwidwa nthenda yoopsa thupi lonse;","poem":1},{"text":"miyendo yake, manja ake, zonse zawola.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wachotsedwa mʼnyumba imene ankadalira,","poem":1},{"text":"ndipo amukokera ku imfa, mfumu ya zoopsa zonse.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mʼnyumba mwake zonse zachotsedwamo;","poem":1},{"text":"awazamo sulufule kuti aphe tizirombo ta matenda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mizu yake ikuwuma pansi","poem":1},{"text":"ndipo nthambi zake zikufota","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sadzakumbukiridwanso pa dziko lapansi;","poem":1},{"text":"sadzakhalanso ndi chinthu chomutchukitsa mʼdziko.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Amuchotsa pa malo owala ndi kumuponya ku mdima,","poem":1},{"text":"ndipo amupirikitsa pa dziko lonse.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iye alibe ana kapena zidzukulu pakati pa anthu ake,","poem":1},{"text":"kulibe wotsala kumene iye ankakhala.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Anthu akumadzulo adabwa kwambiri ndi tsoka lake;","poem":1},{"text":"anthu akummawa agwidwa ndi mantha aakulu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndithudi, izi ndiye zimagwera munthu woyipa;","poem":1},{"text":"amenewa ndiye mathero a munthu amene sadziwa Mulungu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}