{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["Mawu a Yobu"]},{"type":"verse","number":1,"content":["Pamenepo Yobu anayankha kuti,"]},{"type":"verse","number":2,"content":[{"text":"“Kodi mudzakhala mukundizunza mpaka liti,","poem":1},{"text":"ndi kundilasa ndi mawu anuwo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inuyo mwandinyoza kwambiri;","poem":1},{"text":"mwanditsutsa mopanda manyazi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngati ndi zoona kuti ine ndasochera,","poem":1},{"text":"cholakwachotu nʼchanga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngati ndithudi mukudziyika nokha pamwamba panga,","poem":1},{"text":"ndi kugwiritsa ntchito kunyozedwa kwanga polimbana nane,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"pamenepa dziwani kuti Mulungu wandilakwira","poem":1},{"text":"ndipo wandizinga ukonde wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ngakhale ndifuwule kuti, ‘Akundizunza!’ Palibe wondiyankha;","poem":1},{"text":"ngakhale ndipemphe thandizo, palibe wondichitira zolungama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mulungu wanditsekera njira yanga kotero sindingathe kudutsa;","poem":1},{"text":"waphimba njira zanga ndi mdima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iye wandilanda ulemu wanga","poem":1},{"text":"ndipo wandivula chipewa chaufumu pamutu panga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wandiphwanyaphwanya mbali zonse ndipo ndatheratu;","poem":1},{"text":"Iye wazula chiyembekezo changa ngati mtengo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wandikwiyira ndipo","poem":1},{"text":"akundiyesa mmodzi mwa adani ake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ankhondo ake akubwera kwa ine mwamphamvu,","poem":1},{"text":"akonzekera zodzalimbana nane","poem":2},{"lineBreak":true},{"text":"ndipo azungulira nyumba yanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Mulungu wandisiyanitsa ndi abale anga;","poem":1},{"text":"wasandutsa odziwana nane kukhala achilendo kwa ine.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abale anga andithawa;","poem":1},{"text":"abwenzi anga andiyiwala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anthu odzacheza ku nyumba kwanga ndiponso antchito anga aakazi andisandutsa mlendo;","poem":1},{"text":"ndasanduka mlendo mʼmaso mwawo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndikayitana wa ntchito wanga, iye sandiyankha,","poem":1},{"text":"ngakhale ndikapempha ndi pakamwa panga sandichitira kanthu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mpweya wanga umamunyansa mkazi wanga;","poem":1},{"text":"ndine chinthu chonyansa kwa abale anga a mimba imodzi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Inde, ngakhale ana amandinyoza;","poem":1},{"text":"akandiona amandinyodola.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Anzanga onse apamtima amanyansidwa nane;","poem":1},{"text":"iwo amene ndinkawakonda andiwukira.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndangotsala khungu ndi mafupa okhaokha;","poem":1},{"text":"ndapulumuka lokumbakumba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Mvereni chisoni, inu abwenzi anga, mvereni chisoni,","poem":1},{"text":"pakuti dzanja la Mulungu landikantha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Chifukwa chiyani mukundilondola ngati Mulungu?","poem":1},{"text":"Kodi simunatope nalo thupi langa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Aa, achikhala mawu anga analembedwa,","poem":1},{"text":"achikhala analembedwa mʼbuku,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"akanalembedwa pa mwala ndi chitsulo,","poem":1},{"text":"akanalembedwa pa thanthwe kuti sangathe kufufutidwa!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Koma ndikudziwa kuti mpulumutsi wanga ali ndi moyo,","poem":1},{"text":"ndipo pa nthawi yomaliza adzabwera kudzanditeteza.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndipo khungu langa litatha nʼkuwonongeka,","poem":1},{"text":"mʼthupi langa lomweli ndidzamuona Mulungu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ine ndemwe ndidzamuona Iye","poem":1},{"text":"ndi maso angawa, ineyo, osati wina ayi.","poem":2},{"lineBreak":true},{"text":"Ndithu mtima wanga ukufunitsitsadi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Koma inu mukuti, ‘Haa! Tingamuzunze bwanji,","poem":1},{"text":"popeza kuti zonsezi zaoneka chifukwa cha iye yemweyo?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Inu muyenera kuopa lupanga;","poem":1},{"text":"pakuti mkwiyo wake umalangadi ndi lupanga;","poem":2},{"lineBreak":true},{"text":"zikadzatero muzadziwa kuti chiweruzo chilipo ndithu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}