{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Mawu a Zofari"]},{"type":"verse","number":1,"content":["Pamenepo Zofari wa ku Naama anayankha kuti"]},{"type":"verse","number":2,"content":[{"text":"“Kuvutika kwa mʼmaganizo kwanga kwandifulumiza kuti ndiyankhe","poem":1},{"text":"chifukwa ndasautsidwa kwambiri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndikumva kudzudzula kondinyoza,","poem":1},{"text":"ndipo kumvetsetsa kwanga kwa zinthu kwandifulumiza kuti ndiyankhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ndithudi iwe ukudziwa momwe zinthu zakhala zikuchitikira kuyambira kale,","poem":1},{"text":"kuchoka nthawi imene munthu analengedwa pa dziko lapansi,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"kuti chisangalalo cha woyipa nʼchosachedwa kutha,","poem":1},{"text":"chimwemwe cha wosapembedza Mulungu nʼchakanthawi kochepa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngakhale atamayenda mapewa ake ali mmwamba","poem":1},{"text":"ndipo mutu wake uli nengʼaa,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"iye adzatheratu monga momwe imatayikira ndowe yake yomwe;","poem":1},{"text":"iwo amene ankamuona adzati, ‘Kodi uje uja ali kuti?’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Adzazimirira ngati maloto ndipo sadzapezekanso,","poem":1},{"text":"adzachotsedwa ngati masomphenya a usiku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Diso limene linamuona silidzamuonanso;","poem":1},{"text":"sadzapezekanso pamalo pake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ana ake adzabwezera zonse","poem":1},{"text":"zimene iyeyo analanda anthu osauka;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mphamvu zaunyamata zimene zili mʼthupi mwake","poem":1},{"text":"zidzagona naye limodzi mʼfumbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ngakhale zoyipa zili zozuna mʼkamwa mwake","poem":1},{"text":"ndipo amazibisa kunsi kwa lilime lake,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ngakhale salola kuzilavula,","poem":1},{"text":"ndipo amazisunga mʼkamwa mwake,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"koma chakudya chake chidzawawasa mʼmimba mwake;","poem":1},{"text":"chidzasanduka ngati ndulu ya njoka mʼkati mwa iyeyo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Adzachisanza chuma chimene anachimeza;","poem":1},{"text":"Mulungu adzachitulutsa mʼmimba mwa munthuyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iye adzayamwa ndulu ya njoka ndipo","poem":1},{"text":"ululu wa mphiri udzamupha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sadzasangalala ndi timitsinje,","poem":1},{"text":"mitsinje yoyenda uchi ndi mafuta.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ayenera kubweza zimene anazigwirira ntchito osazidya;","poem":1},{"text":"sadzasangalala ndi phindu la malonda ake.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Pakuti iye anapondereza anthu osauka ndipo anawasiya wopanda thandizo;","poem":1},{"text":"iyeyo analanda nyumba zimene sanamange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Chifukwa choti umbombo wake sutha,","poem":1},{"text":"sadzatha kusunga chilichonse chimene amakondwera nacho.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Palibe chatsala kuti iye adye;","poem":1},{"text":"chuma chake sichidzachedwa kutha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ngakhale ndi munthu wachuma, mavuto adzamugwera;","poem":1},{"text":"mavuto aakulu adzamugwera.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Akadya nʼkukhuta,","poem":1},{"text":"Mulungu adzamugwetsera ukali wamoto","poem":2},{"lineBreak":true},{"text":"ngati mvula yosalekeza.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngakhale athawe mkondo wachitsulo,","poem":1},{"text":"muvi wamkuwa wosongoka udzamulasa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Muviwo adzawutulutsira ku msana,","poem":1},{"text":"songa yake yowala kuchoka mʼmphafa mwake.","poem":2},{"text":"Adzagwidwa ndi mantha aakulu;","poem":1}]},{"type":"verse","number":26,"content":[{"text":"mdima wandiweyani ukudikira chuma chake.","poem":2},{"text":"Moto wopanda wowukoleza udzamupsereza","poem":1},{"text":"ndi kuwononga zonse zotsala mʼnyumba yake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Zamumlengalenga zidzawulula kulakwa kwake;","poem":1},{"text":"dziko lapansi lidzamuwukira.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Chigumula cha madzi chidzawononga nyumba yake,","poem":1},{"text":"katundu wake adzatengedwa pa tsiku la ukali wa Mulungu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Izi ndi zimene Mulungu amasungira anthu oyipa,","poem":1},{"text":"mphotho imene Mulungu amayikira iwowo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}