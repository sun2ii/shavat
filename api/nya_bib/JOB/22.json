{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["Mawu a Elifazi"]},{"type":"verse","number":1,"content":["Pamenepo Elifazi wa ku Temani anayankha kuti,"]},{"type":"verse","number":2,"content":[{"text":"“Kodi munthu nʼkukhala waphindu kwa Mulungu?","poem":1},{"text":"Kodi munthu wanzeru angamupindulire Iye?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodi Wamphamvuzonse akanapeza chabwino chotani iweyo ukanakhala wolungama?","poem":1},{"text":"Kodi iyeyo akanapeza phindu lanji makhalidwe ako akanakhala angwiro?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Kodi nʼchifukwa choti umamuopa, kuti azikudzudzula,","poem":1},{"text":"kuti azifuna kukukokera ku mlandu?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kodi osati nʼchifukwa chakuti kuyipa kwako nʼkwakukulu?","poem":1},{"text":"Kodi machimo ako si opanda malire?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iwe unkawumiriza abale ako kuti akupatse chikole popanda chifukwa;","poem":1},{"text":"umalanda anthu zovala zawo ndi kuwasiya amaliseche.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sunawapatse madzi anthu otopa,","poem":1},{"text":"ndipo unawamana chakudya anthu anjala,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ngakhale unali munthu wamphamvu, wokhala ndi malo akeake,","poem":1},{"text":"munthu waulemu wake, wokhala mʼdzikomo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndipo akazi amasiye unawachotsa wopanda kanthu,","poem":1},{"text":"ndipo unapondereza ana amasiye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nʼchifukwa chake misampha yakuzungulira,","poem":1},{"text":"nʼchifukwa chake tsoka ladzidzidzi lakuchititsa mantha,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"nʼchifukwa chake kuli mdima kuti sungathe kuona kanthu,","poem":1},{"text":"nʼchifukwa chakenso madzi achigumula akumiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kodi Mulungu sali kutalitali kumwamba?","poem":1},{"text":"Ndipo ona nyenyezi zili mmwamba kwambirizo, ona kutalika kwake pamene zililipo!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Komabe iweyo ukunena kuti, ‘Kodi Mulungu amadziwa chiyani?","poem":1},{"text":"Kodi Iye amaweruza mu mdima woterewu?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mitambo yakuda yamuphimba, kotero kuti Iye sakutiona","poem":1},{"text":"pamene akuyendayenda pamwamba pa thambopo.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kodi iwe udzayendabe mʼnjira yakale","poem":1},{"text":"imene anthu oyipa ankayendamo?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iwo anachotsedwa nthawi yawo isanakwane,","poem":1},{"text":"maziko awo anakokoloka ndi madzi achigumula.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Anthuwo anati kwa Mulungu, ‘Tichokereni!","poem":1},{"text":"Kodi Wamphamvuzonse angatichitire chiyani?’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Chonsecho ndi Iye amene anadzaza nyumba zawo ndi zinthu zabwino,","poem":1},{"text":"choncho ine sindigwirizana ndi uphungu wa anthu oyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Anthu olungama amaona kuwonongeka kwawo ndipo amakondwera;","poem":1},{"text":"anthu osalakwa amangoseka, akamuona woyipa akulangidwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Amanena kuti, ‘Ndithudi adani athu awonongeka","poem":1},{"text":"ndipo moto wawononga chuma chawo!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Gonjera Mulungu kuti ukhale naye pamtendere;","poem":1},{"text":"ukatero udzaona zabwino.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Landira malangizo a pakamwa pake","poem":1},{"text":"ndipo usunge mawu ake mu mtima mwako.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ukabwerera kwa Wamphamvuzonse udzabwezeretsedwa;","poem":1},{"text":"ukachotsa zoyipa zonse zimene zimachitika mʼnyumba mwako,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ndipo chuma chamtengowapatali nuchiona ngati fumbi,","poem":1},{"text":"golide wa ku Ofiri numutaya ku miyala ya ku zigwa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Pamenepo Wamphamvuzonseyo adzakhala golide wako,","poem":1},{"text":"siliva wako wamtengowapatali.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Pamenepo udzakondwera naye Wamphamvuzonse","poem":1},{"text":"ndipo udzakweza nkhope yako kwa Mulungu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Udzamupempha ndipo adzakumvera,","poem":1},{"text":"ndipo udzapereka zimene unalonjeza.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Chimene watsimikiza kuti uchite, chidzachitikadi,","poem":1},{"text":"kuwala kudzakuwunikira pa njira yako.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Pamene anthu agwetsedwa pansi, iwe nʼkunena kuti, ‘Akwezeni!’","poem":1},{"text":"Pamenepo Iye adzapulumutsa anthu oponderezedwa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Iye adzapulumutsa ngakhale munthu amene ndi wolakwa,","poem":1},{"text":"ameneyo adzapulumutsidwa kudzera mʼkulungama kwako.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}