{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["Yobu"]},{"type":"verse","number":1,"content":["Pamenepo Yobu anayankha kuti,"]},{"type":"verse","number":2,"content":[{"text":"“Leronso kudandaula kwanga nʼkwakukulu kwambiri;","poem":1},{"text":"Iye akundilanga kwambiri ngakhale ndi kubuwula.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndikanangodziwa kumene ndikanamupeza Mulungu;","poem":1},{"text":"ndikanangopita kumene amakhalako!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndikanafotokoza mlandu wanga pamaso pake","poem":1},{"text":"ndipo ndikanayankhula mawu odziteteza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndikanadziwa mawu amene Iye akanandiyankha,","poem":1},{"text":"ndi kulingalira bwino zimene akananena!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kodi Iye akanalimbana nane mwa mphamvu zake zazikulu?","poem":1},{"text":"Ayi, Iye sakanayankhula zinthu zotsutsana nane.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kumeneko munthu wolungama akanafotokoza mlandu wake pamaso pake,","poem":1},{"text":"ndipo woweruzayo akanandipeza wosalakwa nthawi zonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Taonani, ndikapita kummawa, Iye kulibe kumeneko,","poem":1},{"text":"ndikapita kumadzulo sinditha kumupeza kumeneko.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akamagwira ntchito kumpoto, sindimuona kumeneko","poem":1},{"text":"akapita kummwera, sindimuona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Koma Iye amadziwa mmene ndimayendera;","poem":1},{"text":"Iyeyo akandiyesa adzandipeza kuti ndili ngati golide.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mapazi anga akhala akuponda mʼmapazi ake;","poem":1},{"text":"ndasunga njira yake ndipo sindinayitaye.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sindinapatuke kusiya malamulo ochokera pakamwa pake;","poem":1},{"text":"ndasunga mawu a pakamwa pake kupambana chakudya changa cha tsiku ndi tsiku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Koma Iyeyo ndi wosasinthika, ndipo ndani angatsutsane naye?","poem":1},{"text":"Iye amachita chilichonse chimene wafuna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iye amachita chimene watsimikiza kuti chindichitikire,","poem":1},{"text":"ndipo malingaliro oterowa ali nawobe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nʼchifukwa chake ndikuchita mantha kwambiri pamaso pake;","poem":1},{"text":"ndikamaganiza zonsezi ndimamuopa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mulungu walefula mtima wanga;","poem":1},{"text":"Wamphamvuzonse wandiopseza kwambiri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Komatu sindinachititsidwe mantha ndi mdima,","poem":1},{"text":"ndi mdima wandiweyani umene waphimba nkhope yanga.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}