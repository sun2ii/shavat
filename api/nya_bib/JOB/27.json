{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["Ndipo Yobu anapitiriza kuyankhula kwake:"]},{"type":"verse","number":2,"content":[{"text":"“Ndithu pali Mulungu wamoyo, amene wakana kundiweruza molungama,","poem":1},{"text":"Wamphamvuzonse, amene wawawitsa mtima wanga,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"nthawi zonse pamene ndili ndi moyo,","poem":1},{"text":"mpweya wa Mulungu uli mʼmphuno mwanga,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"pakamwa panga sipadzatuluka mawu oyipa,","poem":1},{"text":"lilime langa silidzayankhula zachinyengo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sindidzavomereza kuti inu mukunena zoona;","poem":1},{"text":"mpaka imfa yanga, sindidzataya ungwiro wanga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndidzasunga chilungamo changa ndipo sindidzalola kuti chindichokere;","poem":1},{"text":"chikumbumtima changa sichidzanditsutsa nthawi yonse ya moyo wanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Mdani wanga akhale ngati woyipa,","poem":1},{"text":"wondiwukira akhale ngati munthu wosalungama!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nanga chiyembekezo cha munthu wosapembedza nʼchiyani pamene aphedwa,","poem":1},{"text":"pamene Mulungu achotsa moyo wake?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kodi Mulungu amamva kulira kwake","poem":1},{"text":"pamene zovuta zamugwera?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodi adzapeza chikondwerero mwa Wamphamvuzonse?","poem":1},{"text":"Kodi adzapemphera kwa Mulungu nthawi zonse?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ndidzakuphunzitsani za mphamvu ya Mulungu ndipo","poem":1},{"text":"sindidzabisa njira za Wamphamvuzonse.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inu mwadzionera nokha zonsezi.","poem":1},{"text":"Nanga bwanji mukuyankhula zopanda pake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Pano pali chilango chimene Mulungu amasungira woyipa,","poem":1},{"text":"cholowa chimene munthu wankhanza amalandira kuchokera kwa Wamphamvuzonse.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Angakhale ana ake achuluke chotani adzaphedwa ndi lupanga ndipo","poem":1},{"text":"zidzukulu zake zidzasowa zakudya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amene adzatsalireko adzafa ndi mliri,","poem":1},{"text":"ndipo akazi awo amasiye sadzawalira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngakhale aunjike siliva ngati fumbi,","poem":1},{"text":"ndi kukundika zovala ngati mchenga,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"zimene wasungazo wolungama ndiye adzavale,","poem":1},{"text":"ndipo anthu osalakwa ndiwo adzagawane siliva wakeyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nyumba imene akuyimanga ili ngati mokhala kadziwotche,","poem":1},{"text":"ili ngati msasa umene mlonda amamanga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Amapita kokagona ali wolemera koma kutha kwake nʼkomweko;","poem":1},{"text":"akatsekula maso ake, chuma chake chonse chapita.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Zoopsa zimamukokolola ngati madzi achigumula;","poem":1},{"text":"mphepo yamkuntho imamunyamula usiku.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mphepo ya kummawa imamuwulutsa ndipo iye saonekanso ndipo","poem":1},{"text":"imamuchotsa pamalo pake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Imakuntha pa iye osamuchitira chisoni,","poem":1},{"text":"pamene akuyesa kuthawa mphamvu zake mwaliwiro.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mphepoyo imamuwomba ndithu","poem":1},{"text":"ndipo kuchokera pamalo pake imamuopseza.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}