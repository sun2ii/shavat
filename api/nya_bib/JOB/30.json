{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"“Koma tsopano akundinyoza,","poem":1},{"text":"ana angʼonoangʼono kwa ine,","poem":2},{"text":"anthu amene makolo awo sindikanawalola","poem":1},{"text":"kuti azithandizana ndi agalu anga kuweta nkhosa zanga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kodi mphamvu zawo ndi za phindu lanji kwa ine,","poem":1},{"text":"pakuti mphamvu zawo zinatha kale?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anali atatheratu kuwonda ndi njala,","poem":1},{"text":"ankayendayenda mʼdziko lopanda madzi,","poem":2},{"lineBreak":true},{"text":"mʼchipululu usiku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ankathyola therere ndi masamba owawa,","poem":1},{"text":"ndipo chakudya chawo chinali mizu ya mitengo ya masache.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anapirikitsidwa pakati pa anthu anzawo,","poem":1},{"text":"akuwakuwiza ngati kuti anali akuba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anawumirizidwa kukhala ku zigwembe za mitsinje yowuma,","poem":1},{"text":"pakati pa matanthwe ndi mʼmaenje a mʼnthaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ankalira ngati nyama kuthengo","poem":1},{"text":"ndipo ankawunjikana pamodzi pa ziyangoyango.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anali anthu achabechabe ndi wopanda dzina,","poem":1},{"text":"anathamangitsidwa mʼdziko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ndipo tsopano ana awo akundiyimba nyimbo zachipongwe;","poem":1},{"text":"ineyo ndasanduka chisudzo chawo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iwo amanyansidwa nane ndipo amandithawa;","poem":1},{"text":"akandiona salephera kundilavulira mʼmaso mwangamu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsopano pakuti Mulungu wakhwefula uta wanga ndipo wandisautsa,","poem":1},{"text":"iwowo analekeratu kundiopa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ku dzanja langa lamanja anthu akulimbana nane;","poem":1},{"text":"andikumbira dzenje loti ndigweremo ndikamayenda,","poem":2},{"lineBreak":true},{"text":"andipangira mitumbira ya nkhondo kuti alimbane nane.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iwo anditsekera njira;","poem":1},{"text":"akufuna kundichititsa ngozi,","poem":2},{"lineBreak":true},{"text":"popanda wina aliyense wowaletsa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akundithamangitsa ngati madzi olowera pa mpanda wobowoka,","poem":1},{"text":"iwo akubwererabwerera pakati pa chipasupasu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zoopsa zandithetsa mphamvu;","poem":1},{"text":"ulemu wanga wachita ngati wauluzika ndi mphepo,","poem":2},{"lineBreak":true},{"text":"chuma changa chija chazimirira ngati mtambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Ndipo tsopano mtima wanga wachokamo;","poem":1},{"text":"ndili mʼmasiku amasautso.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mafupa anga akuphwanya usiku pakuti","poem":1},{"text":"zowawa zanga sizikuleka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mʼmphamvu zake Mulungu wakhala ngati chovala changa;","poem":1},{"text":"Iye wandigwira ngati chovala chondithina pa khosi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wandiponya mʼmatope,","poem":1},{"text":"ndipo ndasanduka ngati fumbi ndi phulusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Inu Mulungu, ine ndikulirira kwa Inu, koma simukundiyankha;","poem":1},{"text":"ndikayimirira, Inu simundiyangʼana nʼkomwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inuyo mumandichitira zankhanza;","poem":1},{"text":"mumandizunza ndi dzanja lanu lamphamvu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mwandinyamulira ku mphepo ndipo mwandiwulutsa ndi mphepoyo;","poem":1},{"text":"mwandiponya mʼmphepo ya mkuntho.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndikudziwa kuti Inu mudzandifikitsa ku imfa,","poem":1},{"text":"kumalo kumene amoyo onse adzapitako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Ndithudi palibe munthu amene amalanga munthu wosweka mtima,","poem":1},{"text":"amene akupempha thandizo mʼmasautso ake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kodi ine sindinalire nawo iwo amene anali pamavuto?","poem":1},{"text":"Kodi mtima wanga sunamvere chisoni anthu osauka?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Koma pamene ndinkayembekezera zabwino, zoyipa ndiye zinandigwera;","poem":1},{"text":"pamene ndinkafunafuna kuwala, mdima ndiye unandigwera.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kuwawa kwa mʼkati mwanga sikukuleka;","poem":1},{"text":"ndili mʼmasiku amasautso.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ndikuyenda wothimbirira, komatu osati ndi dzuwa;","poem":1},{"text":"ndimayimirira pa msonkhano ndi kupempha chithandizo molira.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ndasanduka mʼbale wa nkhandwe,","poem":1},{"text":"mnzawo wa akadzidzi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Khungu langa layamba kuda ndipo likufunduka;","poem":1},{"text":"thupi langa likutentha chifukwa cha kuphwanya kwa thupi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Pangwe wanga wasanduka woyimbira maliro,","poem":1},{"text":"ndipo chitoliro changa chikuyimbira anthu olira.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}