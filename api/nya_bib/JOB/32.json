{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"heading","content":["Mawu a Elihu"]},{"type":"verse","number":1,"content":["Tsono anthu atatuwa analeka kumuyankha Yobu, chifukwa chakuti iyeyo ankadziona kuti ndi wolungama."]},{"type":"verse","number":2,"content":["Koma Elihu, mwana wa Barakeli, wa fuko la Buzi, wa banja la Ramu, anapsera mtima kwambiri Yobu chifukwa choti Yobuyo anakana kuvomera kuti anachimwa ndi kuti Mulungu anakhoza pomulanga."]},{"type":"verse","number":3,"content":["Anapseranso mtima abwenzi ake atatu aja chifukwa sanapeze njira yomutsutsira Yobu, ngakhale iwo anamupeza kuti anali wolakwa."]},{"type":"verse","number":4,"content":["Tsono Elihu anadikira kuti ayankhule ndi Yobu chifukwa choti abwenziwo anali akuluakulu kupambana iyeyo."]},{"type":"verse","number":5,"content":["Koma Elihu ataona kuti anthu atatuwo analibe mawu oti ayankhulenso, iye anapsa mtima."]},{"type":"verse","number":6,"content":["Choncho Elihu mwana wa Barakeli wa fuko la Buzi anati:",{"text":"“Ine ndine wamngʼono,","poem":1},{"text":"inuyo ndinu akuluakulu,","poem":2},{"text":"nʼchifukwa chake ndimaopa,","poem":1},{"text":"ndimachita mantha kuti ndikuwuzeni zimene ndimadziwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndimaganiza kuti, ‘Ayambe ndi akuluakulu kuyankhula;","poem":1},{"text":"anthu amvulazakale ndiwo amaphunzitsa nzeru.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Koma mzimu wa Mulungu mwa munthu,","poem":1},{"text":"mpweya wa Wamphamvuzonse, ndi umene umapereka nzeru zomvetsa zinthu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Si okalamba amene ali ndi nzeru,","poem":1},{"text":"si amvulazakale okha amene ali ndi nzeru zomvetsa zinthu zimene zili zoyenera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Nʼchifukwa chake ndikuti, ‘Mvereni;","poem":1},{"text":"inenso ndikukuwuzani zimene ndikuzidziwa.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndadikira nthawi yonseyi,","poem":1},{"text":"ndimamvetsera mwachidwi zimene mumayankhula,","poem":2},{"text":"pamene mumafunafuna mawu oti muyankhule,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"ineyo ndinakumvetseranidi.","poem":2},{"text":"Koma palibe ndi mmodzi yemwe wa inu amene anatsutsa Yobu;","poem":1},{"text":"palibe aliyense wa inu amene anamuyankha mawu ake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Musanene kuti, ‘Ife tapeza nzeru;","poem":1},{"text":"Mulungu ndiye amutsutse, osati munthu.’","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Koma Yobu sanayankhule motsutsana ndi ine,","poem":1},{"text":"ndipo ine sindimuyankha monga mmene inu mwamuyankhira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Iwo asokonezeka ndipo alibe choti ayankhulenso;","poem":1},{"text":"mawu awathera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kodi ine ndidikire chifukwa iwo sakuyankhula tsopano,","poem":1},{"text":"pakuti angoyima phee wopanda yankho?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inenso ndiyankhulapo tsopano;","poem":1},{"text":"nanenso ndinena zimene ndikudziwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pakuti ndili nawo mawu ambiri,","poem":1},{"text":"ndipo mtima wanga ukundikakamiza;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"mʼkati mwanga ndili ngati botolo lodzaza ndi vinyo,","poem":1},{"text":"ngati matumba a vinyo watsopano amene ali pafupi kuphulika.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndiyenera kuyankhula kuti mtima utsike;","poem":1},{"text":"ndiyenera kutsekula pakamwa panga ndi kuyankha.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sindidzakondera munthu wina aliyense,","poem":1},{"text":"kapena kuyankhula zoshashalika,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"pakuti ndikanakhala wa luso loyankhula moshashalika,","poem":1},{"text":"Mlengi wanga akanandilanga msanga.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}