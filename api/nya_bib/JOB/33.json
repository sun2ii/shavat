{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"“Koma tsopano, inu abambo Yobu chonde mverani mawu anga;","poem":1},{"text":"mutcherere khutu zonse zimene ndinene.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsopano ndiyamba kuyankhula;","poem":1},{"text":"mawu anga ali pa msonga ya lilime langa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mawu anga akuchokera mu mtima wolungama;","poem":1},{"text":"pakamwa panga pakuyankhula zoonadi zimene ndikuzidziwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mzimu wa Mulungu wandiwumba,","poem":1},{"text":"mpweya wa Wamphamvuzonse umandipatsa moyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mundiyankhe ngati mungathe;","poem":1},{"text":"konzekani tsopano kuti munditsutse.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ine ndili monga inu pamaso pa Mulungu;","poem":1},{"text":"nanenso ndinachokera ku dothi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Musachite mantha ndipo musandiope ayi,","poem":1},{"text":"Ine sindikupanikizani kwambiri ayi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Koma inu mwayankhula ine ndikumva,","poem":1},{"text":"ndamva mawu anuwo onena kuti,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"‘Ndine wolungama mtima ndi wopanda tchimo;","poem":1},{"text":"ndine woyera mtima ndipo ndilibe cholakwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Komatu Mulungu wapeza zifukwa zoti anditsutsire nazo;","poem":1},{"text":"Iye akundiyesa ngati mdani wake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iyeyo wamanga mapazi anga mʼzigologolo,","poem":1},{"text":"akulonda mayendedwe anga onse.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Koma ine ndi kuti kwa inu, inuyo simukukhoza pa zimenezi,","poem":1},{"text":"pakuti Mulungu ndi wamkulu kupambana munthu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Chifukwa chiyani mukudandaula kwa Iye","poem":1},{"text":"kuti sayankha mawu ena aliwonse a munthu?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pajatu Mulungu amayankhula mwa njira zosiyanasiyana,","poem":1},{"text":"ngakhale munthu sazindikira zimenezi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mʼmaloto, mʼmasomphenya usiku,","poem":1},{"text":"pamene anthu ali mʼtulo tofa nato","poem":2},{"lineBreak":true},{"text":"pamene akungosinza chabe pa bedi,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"amawanongʼoneza mʼmakutu","poem":1},{"text":"ndi kuwaopseza ndi machenjezo ake,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kumuchotsa munthu ku zoyipa,","poem":1},{"text":"ndi kuthetseratu kunyada kwake,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kumulanditsa munthu ku manda,","poem":1},{"text":"kuti moyo wake usawonongeke ndi lupanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Mwina Mulungu amalanga munthu ndi matenda ndi ululu ali pa bedi pake,","poem":1},{"text":"nthawiyo thupi lake lonse limangophwanya,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kuti asakhalenso ndi chilakolako cha chakudya,","poem":1},{"text":"ndipo amanyansidwa ndi chakudya chabwino chomwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Thupi lake limawonda","poem":1},{"text":"ndipo mafupa ake, omwe anali obisika, tsopano amaonekera poyera.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Munthuyo amayandikira ku manda,","poem":1},{"text":"moyo wake umayandikira kwa amene amabweretsa imfa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Koma patakhala mngelo ngati mthandizi,","poem":1},{"text":"mmodzi mwa ambirimbiri oterewa,","poem":2},{"lineBreak":true},{"text":"adzafotokoza zimene zili zoyenera,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kudzamukomera mtima ndi kunena kuti,","poem":1},{"text":"‘Mupulumutseni kuti asapite ku manda;","poem":2},{"lineBreak":true},{"text":"ine ndapeza cholowa mʼmalo mwa moyo wake,’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"pamenepo thupi lake lidzasanduka lasee ngati la mwana;","poem":1},{"text":"ndipo adzabwezeretsedwanso kukhala ngati mʼmasiku a unyamata wake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Akapemphera kwa Mulungu, iyeyo adzalandiridwa.","poem":1},{"text":"Mulungu adzamulandira mwa chimwemwe","poem":2},{"lineBreak":true},{"text":"ndipo adzamubwezeretsa pamalo ake oyamba.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ndipo adzabwera kwa anzake ndi kunena kuti,","poem":1},{"text":"‘Ndinachimwa ndipo sindinachite zolungama,","poem":2},{"lineBreak":true},{"text":"koma sindinalangidwe koyenerana ndi kuchimwa kwanga.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Iye anapulumutsa moyo wanga kuti usapite ku manda,","poem":1},{"text":"ndipo ndidzakhala ndi moyo ndi kuonanso kuwala kwa dzuwa.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Mulungu amachita zonsezi kwa munthu","poem":1},{"text":"kawirikawiri,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"kupulumutsa moyo wa munthuyo ku manda,","poem":1},{"text":"kuti athe kuonanso kuwala kwa moyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Abambo Yobu, tcherani khutu ndipo mundimvere;","poem":1},{"text":"khalani chete kuti ndiyankhule.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngati muli nʼchoti munene, ndiyankheni;","poem":1},{"text":"yankhulani, pakuti ine ndikufuna mupezeke wolungama.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Koma ngati sichoncho, mundimvere;","poem":1},{"text":"khalani chete ndipo ine ndidzakuphunzitsani nzeru.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}