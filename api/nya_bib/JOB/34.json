{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":["Pamenepo Elihu anapitiriza kuyankhula kuti,"]},{"type":"verse","number":2,"content":[{"text":"“Imvani mawu anga, inu anthu anzeru;","poem":1},{"text":"tcherani khutu inu anthu ophunzira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pakuti khutu limayesa mawu","poem":1},{"text":"monga momwe mʼkamwa mumalawira chakudya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tsono tiyeni tizindikire chomwe chili choyenera;","poem":1},{"text":"tiphunzire pamodzi chomwe chili chabwino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Yobu akunena kuti, ‘Ndine wosalakwa,","poem":1},{"text":"koma Mulungu akukana kundiweruza molungama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngakhale ndine wolungama mtima,","poem":1},{"text":"akundiyesa wabodza;","poem":2},{"text":"ngakhale ndine wosachimwa,","poem":1},{"text":"mivi yake ikundichititsa mabala osachiritsidwa.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodi munthu wofanana ndi Yobu ndani,","poem":1},{"text":"amene amayankhula zamwano ngati akumwa madzi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iye amayenda ndi anthu ochita zoyipa;","poem":1},{"text":"amayanjana ndi anthu oyipa mtima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Paja iye amanena kuti, ‘Munthu sapindula kanthu","poem":1},{"text":"poyesetsa kukondweretsa Mulungu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Tsono mverani ine, inu anthu anzeru zomvetsa zinthu.","poem":1},{"text":"Mulungu sangachite choyipa ndi pangʼono pomwe,","poem":2},{"lineBreak":true},{"text":"Wamphamvuzonse sangathe kuchita cholakwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iye amamubwezera munthu molingana ndi ntchito zake;","poem":1},{"text":"Mulungu amabweretsa pa munthu molingana ndi zomwe amachita.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nʼchosayembekezeka kuti Mulungu achite cholakwa,","poem":1},{"text":"kuti Wamphamvuzonse apotoze chilungamo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kodi anapatsa Mulungu udindo wolamulira dziko lapansi ndani?","poem":1},{"text":"Ndani anayika Mulungu kuti azilamulira dziko lonse?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mulungu akanakhala ndi maganizo","poem":1},{"text":"oti achotse mzimu wake ndi mpweya wake,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"zamoyo zonse zikanawonongekeratu","poem":1},{"text":"ndipo munthu akanabwerera ku fumbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Ngati ndinu omvetsa zinthu, imvani izi;","poem":1},{"text":"mvetserani zimene ndikunena.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kodi Mulungu wodana ndi chilungamo angathe kukhala wolamulira?","poem":1},{"text":"Kodi iwe ungathe kuweruza Wolungama ndi Wamphamvuyo?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kodi si Iye amene amanena kwa mafumu kuti, ‘Ndinu opanda pake,’","poem":1},{"text":"ndipo amawuza anthu otchuka, ‘Ndinu oyipa,’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iye sakondera akalonga","poem":1},{"text":"ndipo salemekeza anthu olemera kupambana osauka,","poem":2},{"lineBreak":true},{"text":"pakuti onsewa ndi ntchito ya manja ake?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iwo amafa mwadzidzidzi, pakati pa usiku;","poem":1},{"text":"anthu amachita mantha ndipo amamwalira;","poem":2},{"lineBreak":true},{"text":"munthu wamphamvu amachotsedwa popanda dzanja la munthu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Maso a Mulungu amapenya njira za munthu;","poem":1},{"text":"amaona mayendedwe ake onse.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Palibe malo obisika kapena a mdima wandiweyani","poem":1},{"text":"kumene anthu ochita zoyipa angabisaleko.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mulungu sasowa kuti apitirizebe kufufuza munthu,","poem":1},{"text":"kuti abwere pamaso pake kudzaweruzidwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Popanda kufufuza, Iye amawononga anthu amphamvu","poem":1},{"text":"ndipo mʼmalo mwawo amayikamo ena.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Pakuti Iyeyo amadziwa bwino ntchito zawo","poem":1},{"text":"amawagubuduza usiku ndipo amatswanyika.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Iye amawalanga chifukwa cha kuyipa kwawo,","poem":1},{"text":"pamalo pamene aliyense akuwaona;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Chifukwa anasiya kumutsata","poem":1},{"text":"ndipo sasamaliranso njira zake zonse.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Anachititsa amphawi kuti kulira kwawo kufike pamaso pake,","poem":1},{"text":"kotero Iyeyo anamva kulira kwa amphawiwo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Koma ngati Mulungu akhala chete, ndani angamunene kuti walakwa?","poem":1},{"text":"Akabisa nkhope yake, ndani angathe kumupenyabe?","poem":2},{"text":"Komatu ndiye amene amayangʼana za munthu komanso mtundu wa anthu,","poem":1}]},{"type":"verse","number":30,"content":[{"text":"kuti asalamuliridwe ndi anthu osapembedza,","poem":2},{"lineBreak":true},{"text":"kuti asatchere anthu misampha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Mwina munthu atanena kwa Mulungu kuti,","poem":1},{"text":"‘Ndine wolakwa koma sindidzachimwanso,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ndiphunzitseni zimene sindikuziona","poem":1},{"text":"ngati ndachita choyipa, sindidzachitanso.’","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kodi Mulungu akuweruzeni potsata mmene inuyo mukuganizira,","poem":1},{"text":"pamene inu mukukana kulapa?","poem":2},{"text":"Chisankho nʼchanu, osati changa;","poem":1},{"text":"tsono ndiwuzeni zomwe mukudziwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Anthu omvetsa zinthu adzakambirana,","poem":1},{"text":"anthu anzeru amene akundimva adzandiwuza kuti,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"‘Yobu akuyankhula mopanda nzeru;","poem":1},{"text":"mawu ake ndi opanda fundo.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Aa, kunali bwino Yobu akanayesedwa mpaka kumapeto","poem":1},{"text":"chifukwa choyankha ngati munthu woyipa!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Pa tchimo lake amawonjezerapo kuwukira;","poem":1},{"text":"amawomba mʼmanja mwake monyoza pakati pathu,","poem":2},{"lineBreak":true},{"text":"ndipo amachulukitsa mawu otsutsana ndi Mulungu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}