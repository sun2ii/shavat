{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["Ndipo Elihu anapitirira kuyankhula nati:"]},{"type":"verse","number":2,"content":[{"text":"“Mundilole pangʼono pokha ndipo ndikuonetsani","poem":1},{"text":"kuti zilipo zambiri zoti ziyankhulidwe mʼmalo mwa Mulungu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nzeru zanga ndimazitenga kutali;","poem":1},{"text":"ndidzaonetsa kulungama kwa Mlengi wanga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndithudi mawu anga si abodza;","poem":1},{"text":"wanzeru zangwiro ali ndi inu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Mulungu ndi wamphamvu, koma sanyoza anthu;","poem":1},{"text":"Iye ndi wamphamvu, ndipo ndi wokhazikika pa cholinga chake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Salola oyipa kuti akhalebe ndi moyo","poem":1},{"text":"koma amapereka ufulu kwa anthu osautsidwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iye saleka kuyangʼanira anthu olungama;","poem":1},{"text":"amawayika kuti alamulire pamodzi ndi mafumu","poem":2},{"lineBreak":true},{"text":"ndipo amawalemekeza mpaka muyaya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Koma ngati anthu amangidwa ndi unyolo,","poem":1},{"text":"ndipo akondwa ndi zingwe zamasautso,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iye amawafotokozera zomwe anachita,","poem":1},{"text":"kuti iwo anachimwa modzikuza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mulungu amawatsekula makutu kuti amve malangizo ake","poem":1},{"text":"ndipo amawalamula kuti alape zoyipa zawo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngati iwo amumvera ndi kumutumikira,","poem":1},{"text":"adzatsiriza masiku a moyo wawo mwamtendere,","poem":2},{"lineBreak":true},{"text":"adzatsiriza zaka zawo mosangalala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Koma ngati samvera,","poem":1},{"text":"adzaphedwa ndi lupanga","poem":2},{"lineBreak":true},{"text":"ndipo adzafa osadziwa kanthu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Anthu osapembedza amasunga mkwiyo mu mtima mwawo;","poem":1},{"text":"akawalanga, safuwulira kwa Iye kupempha thandizo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amafa akanali achinyamata,","poem":1},{"text":"pakati pa amuna achiwerewere a kumalo azipembedzo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Koma ovutika, Iye amawapulumutsa pa mavuto awo;","poem":1},{"text":"Mulungu amawayankhula mʼmasautso awowo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Iye akukukopani inu kuti muchoke mʼmasautso,","poem":1},{"text":"kuti mupite ku malo aakulu kumene kulibe chokutchingani,","poem":2},{"lineBreak":true},{"text":"kumalo a mpumulo kumene kuli chakudya chabwino kwambiri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Koma tsopano inu mwapezeka wopalamula chifukwa cha kuyipa kwanu;","poem":1},{"text":"chiweruzo ndi chilungamo chakugwerani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Muchenjere kuti wina asakukopeni ndi chuma;","poem":1},{"text":"musalole kuti chiphuphu chachikulu chikusocheretseni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kodi chuma chanu","poem":1},{"text":"kapena mphamvu zanu zonse","poem":2},{"lineBreak":true},{"text":"zingakusungeni kotero kuti simungakhale pa masautso?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Musalakalake kuti usiku ubwere,","poem":1},{"text":"pakuti ndiyo nthawi imene anthu adzawonongeka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Muchenjere kuti musatembenukire ku uchimo,","poem":1},{"text":"chifukwa uchimowo ndiwo unabweretsa kuzunzika kwanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Taonani, Mulungu ndi wamkulu ndiponso ndi wamphamvu.","poem":1},{"text":"Kodi ndi mphunzitsi uti amene angafanane naye?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kodi ndani amene anamuwuzapo Mulungu zoti achite,","poem":1},{"text":"kapena kumuwuza kuti, ‘Inu mwachita chinthu cholakwa?’","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kumbukirani kutamanda ntchito zake","poem":1},{"text":"zimene anthu amaziyamika mʼnyimbo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Anthu onse amaziona ntchitozo;","poem":1},{"text":"anthuwo amaziona ali kutali.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndithudi, Mulungu ndi wamkulu, sitimudziwa nʼpangʼono pomwe!","poem":1},{"text":"Chiwerengero cha zaka zake nʼchosadziwika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Mulungu ndiye amakweza timadontho tamadzi kuthambo,","poem":1},{"text":"timene timasungunuka nʼkukhala mvula;","poem":2}]},{"type":"verse","number":28,"content":[{"text":"mitambo imagwetsa mvulayo","poem":1},{"text":"ndipo mvulayo imavumbwa pa anthu mokwanira.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kodi ndani amene angadziwe momwe mitambo imayendera,","poem":1},{"text":"momwe Iye amabangulira kuchokera kumalo ake?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Taonani momwe amawalitsira zingʼaningʼani pa malo ake onse,","poem":1},{"text":"zimafika ngakhale pansi pa nyanja.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Umu ndi mmene Iye amalamulira mitundu ya anthu","poem":1},{"text":"ndi kuwapatsa chakudya chochuluka.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Amadzaza manja ake ndi zingʼaningʼani,","poem":1},{"text":"ndipo amazilamulira kuti zigwe pamalo pamene Iye akufuna.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mabingu ake amalengeza za kubwera kwa mvula yamkuntho;","poem":1},{"text":"ngʼombe nazo zimalengeza za kubwera kwake.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}