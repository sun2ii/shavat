{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"“Kodi munthu sakhala ndi ntchito yowawa pa dziko lapansi?","poem":1},{"text":"Kodi masiku ake sali ngati munthu waganyu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Monga ngati kapolo wolakalaka mthunzi wa nthawi yamadzulo,","poem":1},{"text":"kapena ngati munthu waganyu woyembekezera malipiro ake,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"choncho ine ndapatsidwa nthawi yongovutika pachabe,","poem":1},{"text":"ndiponso usiku wamasautso wapatsidwa kwa ine.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndikamagona ndimaganiza kuti, ‘Kodi kucha liti?’","poem":1},{"text":"Usikuwo umatalika ndipo sindigona tulo mpaka mmawa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Thupi langa ladzala mphutsi ndi zipsera,","poem":1},{"text":"khungu langa langʼambika ndipo likutuluka mafinya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Masiku anga ndi othamanga kupambana makina wolukira nsalu,","poem":1},{"text":"ndipo amatha wopanda chiyembekezo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inu Mulungu kumbukirani kuti moyo wanga uli ngati mpweya;","poem":1},{"text":"sindidzaonanso masiku achisangalalo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amene akundiona tsopano akundiona;","poem":1},{"text":"mudzandifunafuna koma sindidzapezekanso.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Monga mtambo umazimirira ndi kukanganuka,","poem":1},{"text":"momwemonso munthu amene walowa mʼmanda sabwerera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iye sadzabweranso ku nyumba kwake","poem":1},{"text":"ndipo onse omudziwa adzamuyiwala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nʼchifukwa chake ine sindidzakhala chete;","poem":1},{"text":"ndidzayankhula mopsinjika mtima,","poem":2},{"lineBreak":true},{"text":"ndidzadandaula mowawidwa mtima.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kodi ine ndine nyanja kapena chirombo chamʼnyanja","poem":1},{"text":"kuti inu mundiyikire alonda?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pamene ndikuganiza kuti ndidzapeza chitonthozo pa bedi panga","poem":1},{"text":"ndipo pogona panga padzachepetsa madandawulo anga,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ngakhale nthawi imeneyo mumandiopseza ndi maloto","poem":1},{"text":"ndi kundichititsa mantha ndi masomphenya,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kotero kuti ndimalakalaka kudzikhweza kapena kufa,","poem":1},{"text":"kupambana kupirira zowawa zimene ndikuzimva mʼthupi mwanga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ine ndatopa nawo moyo wanga; sindingakonde kukhala moyo nthawi zonse.","poem":1},{"text":"Ndisiyeni ndekha pakuti moyo wanga ulibe tanthauzo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Kodi munthu nʼchiyani kuti muzimuganizira chotere,","poem":1},{"text":"kuti muzisamala zochita zake,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kuti muzimusanthula mmawa uliwonse","poem":1},{"text":"ndi kumamuyesa nthawi yonse?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kodi simudzaleka kumandizonda","poem":1},{"text":"kuti ndipezeko mpata wopumula?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngati ine ndachimwa, ndachita chiyani kwa Inu,","poem":1},{"text":"Inu wopenyetsetsa anthu?","poem":2},{"text":"Chifukwa chiyani mwachititsa kuti ndikhale ngati choponyera chandamale chanu?","poem":1},{"text":"Kodi ndasanduka katundu wolemera kwa Inu?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Chifukwa chiyani simukundikhululukira zolakwa zanga","poem":1},{"text":"ndi kundichotsera machimo anga?","poem":2},{"text":"Pakuti posachedwa ndilowa mʼmanda;","poem":1},{"text":"mudzandifunafuna ine koma simudzandionanso.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}