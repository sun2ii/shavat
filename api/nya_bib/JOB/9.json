{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOB","translationId":"nya_bib","name":"YOBU","commonName":"YOBU","title":"Yobu","order":18,"numberOfChapters":42,"sha256":"62328d849a98b98006c303956e3dda42961357c7197484e84f99af1e807981e6","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nya_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"heading","content":["Mawu a Yobu"]},{"type":"verse","number":1,"content":["Ndipo Yobu anayankha kuti,"]},{"type":"verse","number":2,"content":[{"text":"“Zoonadi, ndikudziwa kuti zimenezi ndi zoona.","poem":1},{"text":"Koma munthu angathe bwanji kukhala wolungama pamaso pa Mulungu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngakhale wina atafuna kutsutsana naye,","poem":1},{"text":"Iye sangamuyankhe munthuyo ngakhale mawu amodzi omwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mulungu ndi wa nzeru zambiri ndipo mphamvu zake ndi zochuluka.","poem":1},{"text":"Ndani analimbana naye popanda kupwetekeka?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iye amasuntha mapiri, mapiriwo osadziwa,","poem":1},{"text":"ndipo amawagubuduza ali wokwiya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iye amagwedeza dziko lapansi kulisuntha pamalo pake","poem":1},{"text":"ndipo amanjenjemeretsa mizati yake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iye amayankhula ndi dzuwa ndipo siliwala;","poem":1},{"text":"Iyeyo amaphimba kuwala kwa nyenyezi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndi Mulungu yekha amene anayala mayiko akumwamba","poem":1},{"text":"ndipo amayenda pa mafunde a pa nyanja.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iye ndiye mlengi wa nyenyezi zamlalangʼamba ndi akamwiniatsatana,","poem":1},{"text":"nsangwe ndi kumpotosimpita.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iye amachita zozizwitsa zimene sizimvetsetseka,","poem":1},{"text":"zodabwitsa zimene sizingawerengeke.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akapita pafupi ndi ine sindingathe kumuona;","poem":1},{"text":"akadutsa, sindingathe kumuzindikira.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngati Iye alanda zinthu, ndani angathe kumuletsa?","poem":1},{"text":"Ndani anganene kwa Iye kuti, ‘Mukuchita chiyani?’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mulungu sabweza mkwiyo wake;","poem":1},{"text":"ngakhale gulu lankhondo la Rahabe linawerama pa mapazi ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Nanga ine ndingathe kukangana naye bwanji?","poem":1},{"text":"Ndingawapeze kuti mawu oti nʼkutsutsana naye?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngakhale nditakhala wosalakwa, sindingamuyankhe;","poem":1},{"text":"ndikanangopempha chifundo kwa woweruza wanga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngakhale ndikanamuyitana ndipo Iye ndi kuvomera,","poem":1},{"text":"sindikhulupirira kuti akanamva mawu angawo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iye akanandikantha ndi mphepo yamkuntho,","poem":1},{"text":"ndipo akanandipweteka popanda chifukwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mulungu sakanandilola kuti ndipumenso","poem":1},{"text":"koma akanandichulukitsira zowawa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tikanena za mphamvu, Iye ndi wamphamvudi!","poem":1},{"text":"Ndipo tikanena za chiweruzo cholungama, ndani angamuzenge mlandu?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngakhale ndikanakhala wosalakwa, zoyankhula zanga zikananditsutsa;","poem":1},{"text":"ndikanakhala wopanda cholakwa, pakamwa panga pakanandipeza wolakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Ngakhale ine ndili wosalakwa,","poem":1},{"text":"sindidziyenereza ndekha;","poem":2},{"lineBreak":true},{"text":"moyo wanga ndimawupeputsa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Zonse nʼzofanana; nʼchifukwa chake ndikuti,","poem":1},{"text":"‘Iye amawononga anthu osalakwa ndi anthu oyipa omwe.’","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Pamene mkwapulo ubweretsa imfa yadzidzidzi,","poem":1},{"text":"Iye amaseka tsoka la munthu wosalakwayo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Pamene dziko lagwa mʼmanja mwa anthu oyipa","poem":1},{"text":"Iye amawatseka maso anthu oweruza dzikolo.","poem":2},{"lineBreak":true},{"text":"Ngati si Iyeyo, nanga ndani?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Masiku anga ndi othamanga kwambiri kupambana munthu waliwiro;","poem":1},{"text":"masikuwo amapita ine osaonapo zabwino.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Amayenda ngati mabwato a njedza pa nyanja,","poem":1},{"text":"ngati mphungu zothamangira nyama zoti zidye.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nʼtanena kuti, ‘Ndidzayiwala madandawulo anga,","poem":1},{"text":"ndidzasintha nkhope yanga ndipo ndidzasekerera,’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ndikuopabe mavuto anga onse,","poem":1},{"text":"popeza ndikudziwa kuti simudzavomereza kuti ndine wosalakwa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Popeza ndapezeka kale wolakwa","poem":1},{"text":"ndivutikirenji popanda phindu?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ngakhale nditasamba mʼmadzi oyera kwambiri","poem":1},{"text":"ndi kusamba mʼmanja mwanga ndi sopo,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"mutha kundiponyabe pa dzala,","poem":1},{"text":"kotero kuti ngakhale zovala zanga zomwe zidzandinyansa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Mulungu si munthu ngati ine kuti ndithe kumuyankha,","poem":1},{"text":"sindingathe kutsutsana naye mʼbwalo la milandu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Pakanapezeka munthu wina kuti akhale mʼkhalapakati wathu,","poem":1},{"text":"kuti atibweretse ife tonse pamodzi,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"munthu wina woti achotse ndodo ya Mulungu pa ine","poem":1},{"text":"kuti kuopsa kwake kusandichititsenso mantha!","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Pamenepo ine ndikanatha kuyankhula mosamuopa Mulunguyo,","poem":1},{"text":"koma monga zililimu, sindingathe.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}