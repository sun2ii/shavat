{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOL","translationId":"nya_bib","name":"Yoweli","commonName":"Yoweli","title":"Yoweli","order":29,"numberOfChapters":3,"sha256":"399849def92dda7d06b7575c6243651f21a0cf546166d69dc04f71211c53bfc7","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Yehova anayankhula ndi Yoweli mwana wa Petueli."]},{"type":"heading","content":["Kubwera kwa Dzombe"]},{"type":"verse","number":2,"content":[{"text":"Inu akuluakulu, imvani izi;","poem":1},{"text":"mvetserani, nonse amene mumakhala mʼdziko.","poem":2},{"text":"Kodi zinthu zokhala ngati izi zinayamba zaonekapo mʼnthawi yanu,","poem":1},{"text":"kapena mʼnthawi ya makolo anu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muwafotokozere ana anu,","poem":1},{"text":"ndipo ana anuwo afotokozere ana awo,","poem":2},{"lineBreak":true},{"text":"ndipo ana awo adzafotokozere mʼbado winawo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Chimene dzombe losamera mapiko lasiya","poem":1},{"text":"dzombe lowuluka ladya;","poem":2},{"text":"chimene dzombe lowuluka lasiya","poem":1},{"text":"dzombe lalingʼono ladya;","poem":2},{"text":"chimene dzombe lalingʼono lasiya","poem":1},{"text":"chilimamine wadya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dzukani, inu zidakwa ndipo mulire!","poem":1},{"text":"Lirani mofuwula, inu nonse amene mumamwa vinyo;","poem":2},{"text":"lirani mofuwula chifukwa cha vinyo watsopano,","poem":1},{"text":"pakuti wachotsedwa pakamwa panu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mtundu wa anthu wathira nkhondo dziko langa,","poem":1},{"text":"wamphamvu ndi wosawerengeka;","poem":2},{"text":"uli ndi mano a mkango,","poem":1},{"text":"zibwano za mkango waukazi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wawononga mphesa zanga","poem":1},{"text":"ndipo wathyola mitengo yanga ya mkuyu.","poem":2},{"text":"Wakungunula makungwa ake","poem":1},{"text":"ndi kuwataya,","poem":2},{"lineBreak":true},{"text":"kusiya nthambi zake zili mbee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lirani ngati namwali wovala chiguduli,","poem":1},{"text":"chifukwa cha mwamuna wa utsikana wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chopereka cha chakudya ndi cha chakumwa","poem":1},{"text":"sizikuperekedwa ku nyumba ya Yehova.","poem":2},{"text":"Ansembe akulira,","poem":1},{"text":"amene amatumikira pamaso pa Yehova.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Minda yaguga,","poem":1},{"text":"nthaka yauma;","poem":2},{"text":"tirigu wawonongeka,","poem":1},{"text":"vinyo watsopano watha,","poem":2},{"lineBreak":true},{"text":"mitengo ya mafuta yauma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Khalani ndi nkhawa, inu alimi,","poem":1},{"text":"lirani mofuwula inu alimi a mphesa;","poem":2},{"text":"imvani chisoni chifukwa cha tirigu ndi barele,","poem":1},{"text":"pakuti zokolola za mʼmunda zawonongeka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mpesa wauma","poem":1},{"text":"ndipo mtengo wamkuyu wafota;","poem":2},{"text":"makangadza, kanjedza ndi mitengo ya apulosi,","poem":1},{"text":"mitengo yonse ya mʼmunda yauma.","poem":2},{"text":"Ndithudi chimwemwe cha anthu","poem":1},{"text":"chatheratu.","poem":2}]},{"type":"heading","content":["Mulungu Ayitana Anthu kuti Atembenuke"]},{"type":"verse","number":13,"content":[{"text":"Inu ansembe, valani ziguduli ndipo lirani;","poem":1},{"text":"lirani mofuwula, inu amene mumatumikira pa guwa lansembe.","poem":2},{"text":"Bwerani, fundani ziguduli usiku wonse,","poem":1},{"text":"inu amene mumatumikira pamaso pa Mulungu wanga;","poem":2},{"text":"pakuti chopereka cha chakudya ndi cha chakumwa","poem":1},{"text":"sizikupezekanso mʼnyumba ya Mulungu wanu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lengezani tsiku lopatulika losala zakudya,","poem":1},{"text":"itanani msonkhano wopatulika.","poem":2},{"text":"Sonkhanitsani akuluakulu","poem":1},{"text":"ndi anthu onse okhala mʼdziko","poem":2},{"text":"ku nyumba ya Yehova Mulungu wanu","poem":1},{"text":"ndipo alirire Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kalanga ine tsikulo!","poem":1},{"text":"Pakuti tsiku la Yehova layandikira;","poem":2},{"lineBreak":true},{"text":"lidzabwera ngati chiwonongeko chochokera kwa Wamphamvuzonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kodi chakudya chathu sichachotsedwa","poem":1},{"text":"ife tikuona?","poem":2},{"text":"Kodi mʼnyumba ya Mulungu wathu","poem":1},{"text":"simulibe chimwemwe ndi chisangalalo?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mbewu zikunyala","poem":1},{"text":"poti pansi ndi powuma.","poem":2},{"text":"Nyumba zosungiramo zinthu zawonongeka;","poem":1},{"text":"nkhokwe zapasuka","poem":2},{"lineBreak":true},{"text":"popeza tirigu wauma.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taonani mmene zikulirira ziweto;","poem":1},{"text":"ngʼombe zikungoyenda uku ndi uku","poem":2},{"text":"chifukwa zilibe msipu;","poem":1},{"text":"ngakhalenso nkhosa zikusauka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kwa Inu Yehova ndilirira,","poem":1},{"text":"pakuti moto wapsereza msipu wakuthengo,","poem":2},{"lineBreak":true},{"text":"malawi amoto apsereza mitengo yonse ya mʼtchire.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngakhale nyama zakuthengo zikulirira Inu;","poem":1},{"text":"timitsinje tonse taphwa","poem":2},{"lineBreak":true},{"text":"ndipo moto wapsereza msipu wa kuthengo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}