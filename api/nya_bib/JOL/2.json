{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOL","translationId":"nya_bib","name":"Yoweli","commonName":"Yoweli","title":"Yoweli","order":29,"numberOfChapters":3,"sha256":"399849def92dda7d06b7575c6243651f21a0cf546166d69dc04f71211c53bfc7","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Chilango cha Mulungu"]},{"type":"verse","number":1,"content":[{"text":"Lizani lipenga mu Ziyoni.","poem":1},{"text":"Chenjezani pa phiri langa loyera.","poem":2},{"text":"Onse okhala mʼdziko anjenjemere,","poem":1},{"text":"pakuti tsiku la Yehova likubwera,","poem":2},{"text":"layandikira;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"tsiku la mdima ndi chisoni,","poem":2},{"lineBreak":true},{"text":"tsiku la mitambo ndi la mdima wandiweyani.","poem":2},{"text":"Ngati mʼbandakucha umene wakuta mapiri,","poem":1},{"text":"gulu lalikulu ndi la ankhondo amphamvu likubwera,","poem":2},{"text":"gulu limene nʼkale lomwe silinaonekepo","poem":1},{"text":"ngakhale kutsogolo kuno silidzaonekanso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Patsogolo pawo moto ukupsereza,","poem":1},{"text":"kumbuyo kwawo malawi amoto akutentha zinthu.","poem":2},{"text":"Patsogolo pawo dziko lili ngati munda wa Edeni,","poem":1},{"text":"kumbuyo kwawo kuli ngati chipululu,","poem":2},{"lineBreak":true},{"text":"kulibe kanthu kotsalapo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maonekedwe awo ali ngati akavalo;","poem":1},{"text":"akuthamanga ngati akavalo ankhondo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akulumpha pamwamba pa mapiri","poem":1},{"text":"ndi phokoso ngati la magaleta,","poem":2},{"text":"ngati moto wothetheka wonyeketsa ziputu,","poem":1},{"text":"ngati gulu lalikulu la ankhondo lokonzekera nkhondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Akangowaona, anthu a mitundu ina amazunzika mu mtima;","poem":1},{"text":"nkhope iliyonse imagwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amathamanga ngati ankhondo;","poem":1},{"text":"amakwera makoma ngati asilikali.","poem":2},{"text":"Onse amayenda pa mizere,","poem":1},{"text":"osaphonya njira yawo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iwo sakankhanakankhana,","poem":1},{"text":"aliyense amayenda molunjika.","poem":2},{"text":"Amadutsa malo otchingidwa","poem":1},{"text":"popanda kumwazikana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amakhamukira mu mzinda,","poem":1},{"text":"amathamanga mʼmbali mwa khoma.","poem":2},{"text":"Amakwera nyumba ndi kulowamo;","poem":1},{"text":"amalowera pa zenera ngati mbala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Patsogolo pawo dziko limagwedezeka,","poem":1},{"text":"thambo limanjenjemera,","poem":2},{"text":"dzuwa ndi mwezi zimachita mdima,","poem":1},{"text":"ndipo nyenyezi zimaleka kuwala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yehova amabangula","poem":1},{"text":"patsogolo pawo,","poem":2},{"text":"gulu lake lankhondo ndi losawerengeka,","poem":1},{"text":"ndipo amphamvu ndi amene amamvera kulamula kwake.","poem":2},{"text":"Tsiku la Yehova ndi lalikulu;","poem":1},{"text":"ndi loopsa.","poem":2},{"lineBreak":true},{"text":"Ndani adzapirira pa tsikulo?","poem":2}]},{"type":"heading","content":["Ngʼambani Mtima Wanu"]},{"type":"verse","number":12,"content":[{"text":"“Ngakhale tsopano,","poem":1},{"text":"bwererani kwa Ine ndi mtima wanu wonse","poem":2},{"lineBreak":true},{"text":"posala zakudya ndi kukhetsa misozi,” akutero Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngʼambani mtima wanu","poem":1},{"text":"osati zovala zanu.","poem":2},{"text":"Bwererani kwa Yehova Mulungu wanu,","poem":1},{"text":"pakuti Iye ndi wokoma mtima ndi wachifundo,","poem":2},{"text":"wosakwiya msanga ndi wachikondi chochuluka,","poem":1},{"text":"ndipo amaleka kubweretsa mavuto.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akudziwa ndani? Mwina adzasintha maganizo nʼkutimvera chisoni,","poem":1},{"text":"nʼkutisiyira madalitso,","poem":2},{"text":"a chopereka cha chakudya ndi cha chakumwa","poem":1},{"text":"kwa Yehova Mulungu wanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lizani lipenga mu Ziyoni,","poem":1},{"text":"lengezani tsiku losala zakudya,","poem":2},{"lineBreak":true},{"text":"itanitsani msonkhano wopatulika.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sonkhanitsani anthu pamodzi,","poem":1},{"text":"muwawuze kuti adziyeretse;","poem":2},{"text":"sonkhanitsani akuluakulu,","poem":1},{"text":"sonkhanitsani ana,","poem":2},{"lineBreak":true},{"text":"sonkhanitsani ndi oyamwa omwe.","poem":2},{"text":"Mkwati atuluke mʼchipinda chake,","poem":1},{"text":"mkwatibwi atuluke mokhala mwake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ansembe amene amatumikira pamaso pa Yehova,","poem":1},{"text":"alire pakati pa guwa lansembe ndi khonde la Nyumba ya Yehova.","poem":2},{"text":"Azinena kuti, “Inu Yehova, achitireni chifundo anthu anu.","poem":1},{"text":"Musalole kuti cholowa chanu chikhale chinthu chonyozeka,","poem":2},{"lineBreak":true},{"text":"kuti anthu a mitundu ina awalamulire.","poem":2},{"text":"Kodi nʼchifukwa chiyani anthu a mitundu ina amanena kuti,","poem":1},{"text":"‘Ali kuti Mulungu wawo?’ ”","poem":2}]},{"type":"heading","content":["Yankho la Yehova"]},{"type":"verse","number":18,"content":[{"text":"Pamenepo Yehova adzachitira nsanje dziko lake","poem":1},{"text":"ndi kuchitira chisoni anthu ake.","poem":2}]},{"type":"verse","number":19,"content":["Yehova adzawayankha kuti,",{"text":"“Ine ndikukutumizirani tirigu, vinyo watsopano ndi mafuta","poem":1},{"text":"ndipo mudzakhuta ndithu;","poem":2},{"text":"sindidzakuperekaninso kuti mukhale chitonzo","poem":1},{"text":"kwa anthu a mitundu ina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ine ndidzachotsa ankhondo akumpoto kuti apite kutali ndi inu,","poem":1},{"text":"kuwapirikitsira ku dziko lowuma ndi lachipululu,","poem":2},{"text":"gulu lawo lakutsogolo ndidzalipirikitsira ku nyanja ya kummawa","poem":1},{"text":"ndi gulu lawo lakumbuyo, ku nyanja ya kumadzulo.","poem":2},{"text":"Ndipo mitembo yawo idzawola,","poem":1},{"text":"fungo lake lidzamveka.”","poem":2},{"lineBreak":true},{"text":"Zoonadi Yehova wachita zinthu zazikulu.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Iwe dziko usachite mantha;","poem":2},{"lineBreak":true},{"text":"sangalala ndipo kondwera.","poem":2},{"text":"Zoonadi Yehova wachita zinthu zazikulu.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"Inu nyama zakuthengo, musachite mantha,","poem":2},{"lineBreak":true},{"text":"pakuti msipu wa ku chipululu ukuphukira.","poem":2},{"text":"Mitengo ikubala zipatso zake;","poem":1},{"text":"mitengo ya mkuyu ndi mpesa ikubereka kwambiri.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Inu anthu a ku Ziyoni sangalalani,","poem":1},{"text":"kondwerani mwa Yehova Mulungu wanu,","poem":2},{"text":"pakuti wakupatsani","poem":1},{"text":"mvula yoyambirira mwachilungamo chake.","poem":2},{"text":"Iye wakutumizirani mivumbi yochuluka,","poem":1},{"text":"mvula yoyambirira ndi mvula ya nthawi ya mphukira, monga poyamba paja.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Pa malo opunthira padzaza tirigu;","poem":1},{"text":"mʼmitsuko mudzasefukira vinyo watsopano ndi mafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Ine ndidzakubwezerani zonse zimene zinawonongedwa ndi dzombe,","poem":1},{"text":"dzombe lalikulu ndi dzombe lalingʼono,","poem":2},{"lineBreak":true},{"text":"dzombe lopanda mapiko ndi dzombe lowuluka;","poem":2},{"text":"gulu langa lalikulu la nkhondo limene ndinalitumiza pakati panu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mudzakhala ndi chakudya chambiri, mpaka mudzakhuta,","poem":1},{"text":"ndipo mudzatamanda dzina la Yehova Mulungu wanu,","poem":2},{"lineBreak":true},{"text":"amene wakuchitirani zodabwitsa;","poem":2},{"text":"ndipo anthu anga sadzachitanso manyazi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Pamenepo inu mudzadziwa kuti Ine ndili mu Israeli,","poem":1},{"text":"kuti Ine ndine Yehova Mulungu wanu,","poem":2},{"lineBreak":true},{"text":"ndi kuti palibenso wina;","poem":2},{"text":"ndipo anthu anga sadzachitanso manyazi.","poem":1}]},{"type":"heading","content":["Tsiku la Yehova"]},{"type":"verse","number":28,"content":[{"text":"“Ndipo patapita nthawi,","poem":1},{"text":"ndidzakhuthulira Mzimu wanga pa anthu onse.","poem":2},{"text":"Ana anu aamuna ndi ana anu aakazi adzanenera,","poem":1},{"text":"nkhalamba zanu zidzalota maloto,","poem":2},{"lineBreak":true},{"text":"anyamata anu adzaona masomphenya.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ngakhalenso pa antchito anga aamuna ndi aakazi","poem":1},{"text":"ndidzakhuthulira Mzimu wanga masiku amenewo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ndidzaonetsa zodabwitsa mlengalenga","poem":1},{"text":"ndi pa dziko lapansi,","poem":2},{"lineBreak":true},{"text":"ndizo magazi, moto ndi utsi watolotolo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Dzuwa lidzadetsedwa","poem":1},{"text":"ndipo mwezi udzaoneka ngati magazi","poem":2},{"lineBreak":true},{"text":"lisanafike tsiku lalikulu ndi loopsa la Ambuye.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ndipo aliyense amene adzayitana","poem":1},{"text":"pa dzina la Ambuye adzapulumuka;","poem":2},{"text":"pakuti chipulumutso chidzakhala pa Phiri la Ziyoni","poem":1},{"text":"ndi mu Yerusalemu,","poem":2},{"lineBreak":true},{"text":"monga Yehova wanenera,","poem":2},{"text":"pakati pa otsala","poem":1},{"text":"amene Yehova wawayitana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}