{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JOL","translationId":"nya_bib","name":"Yoweli","commonName":"Yoweli","title":"Yoweli","order":29,"numberOfChapters":3,"sha256":"399849def92dda7d06b7575c6243651f21a0cf546166d69dc04f71211c53bfc7","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Kuweruzidwa kwa Mitundu ya Anthu"]},{"type":"verse","number":1,"content":[{"text":"“Masiku amenewo ndiponso nthawi imeneyo,","poem":1},{"text":"nditadzabwezeretsanso Yerusalemu ndi Yuda mʼchimake,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ndidzasonkhanitsa anthu a mitundu yonse","poem":1},{"text":"ndipo ndidzawabweretsa ku Chigwa cha Yehosafati.","poem":2},{"text":"Kumeneko ndidzawaweruza","poem":1},{"text":"chifukwa cha cholowa changa, anthu anga Aisraeli,","poem":2},{"text":"pakuti anabalalitsa anthu anga pakati pa mitundu ya anthu","poem":1},{"text":"ndikugawa dziko langa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anagawana anthu anga pochita maere","poem":1},{"text":"ndipo anyamata anawasinthanitsa ndi akazi achiwerewere;","poem":2},{"text":"anagulitsa atsikana chifukwa cha vinyo","poem":1},{"text":"kuti iwo amwe.","poem":2}]},{"type":"verse","number":4,"content":["“Kodi tsopano inu a ku Turo ndi Sidoni ndi madera onse a Filisitiya, muli ndi chiyani chotsutsana nane? Kodi mukundibwezera pa zinthu zimene ndakuchitirani? Ngati inu mukundibwezera, Ine ndidzabwezera zochita zanu mofulumira ndi mwachangu pa mitu yanu."]},{"type":"verse","number":5,"content":["Pakuti munatenga siliva ndi golide wanga ndi kupita nacho chuma changa chamtengowapatali ku nyumba zanu zopembedzera mafano."]},{"type":"verse","number":6,"content":["Inu munagulitsa anthu a ku Yuda ndi Yerusalemu kwa Agriki, kuti apite kutali ndi malire a dziko lawo."]},{"type":"verse","number":7,"content":["“Taonani, Ine ndidzawachotsa kumalo kumene munawagulitsako, ndipo ndidzabwezera zimene mwachita pa mitu yanu."]},{"type":"verse","number":8,"content":["Ndidzagulitsa ana anu aamuna ndi ana anu aakazi kwa anthu a ku Yuda, ndipo iwo adzawagulitsa kwa Aseba, mtundu wa anthu okhala kutali.” Yehova wayankhula."]},{"type":"verse","number":9,"content":[{"text":"Lengezani izi pakati pa anthu a mitundu ina:","poem":1},{"text":"Konzekerani nkhondo!","poem":2},{"text":"Dzutsani ankhondo amphamvu!","poem":1},{"text":"Asilikali onse afike pafupi ndipo ayambe nkhondo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sulani makasu anu kuti akhale malupanga","poem":1},{"text":"ndipo zikwanje zanu zikhale mikondo.","poem":2},{"text":"Munthu wofowoka anene kuti,","poem":1},{"text":"“Ndine wamphamvu!”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bwerani msanga, inu anthu a mitundu yonse kuchokera ku mbali zonse,","poem":1},{"text":"ndipo musonkhane kumeneko.","poem":2},{"lineBreak":true},{"text":"Tumizani ankhondo anu Yehova!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Mitundu ya anthu idzuke;","poem":1},{"text":"ipite ku Chigwa cha Yehosafati,","poem":2},{"text":"pakuti kumeneko Ine ndidzakhala","poem":1},{"text":"ndikuweruza anthu a mitundu yonse yozungulira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tengani chikwakwa chodulira tirigu,","poem":1},{"text":"pakuti mbewu zakhwima.","poem":2},{"text":"Bwerani dzapondeni mphesa,","poem":1},{"text":"pakuti mopsinyira mphesa mwadzaza","poem":2},{"lineBreak":true},{"text":"ndipo mitsuko ikusefukira;","poem":2},{"text":"kuyipa kwa anthuwa nʼkwakukulu kwambiri!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Chigulu cha anthu, chigulu cha anthu,","poem":1},{"text":"mʼchigwa cha chiweruzo!","poem":2},{"text":"Pakuti tsiku la Yehova layandikira","poem":1},{"text":"mʼchigwa cha chiweruzo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dzuwa ndi mwezi zidzadetsedwa,","poem":1},{"text":"ndipo nyenyezi sizidzawalanso.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yehova adzabangula kuchokera mu Ziyoni","poem":1},{"text":"ndipo mawu ake adzamveka ngati bingu kuchokera mu Yerusalemu;","poem":2},{"lineBreak":true},{"text":"dziko lapansi ndi thambo zidzagwedezeka.","poem":2},{"text":"Koma Yehova adzakhala pothawira pa anthu ake,","poem":1},{"text":"linga la anthu a ku Israeli.","poem":2}]},{"type":"heading","content":["Madalitso a Anthu a Mulungu"]},{"type":"verse","number":17,"content":[{"text":"“Pamenepo inu mudzadziwa kuti Ine Yehova Mulungu wanu,","poem":1},{"text":"ndimakhala mu Ziyoni, phiri langa lopatulika.","poem":2},{"text":"Yerusalemu adzakhala wopatulika;","poem":1},{"text":"alendo sadzamuthiranso nkhondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Tsiku limenelo mapiri adzachucha vinyo watsopano,","poem":1},{"text":"ndipo zitunda zidzayenderera mkaka;","poem":2},{"lineBreak":true},{"text":"mitsinje yonse ya ku Yuda idzadzaza ndi madzi.","poem":2},{"text":"Kasupe adzatumphuka mʼnyumba ya Yehova","poem":1},{"text":"ndipo adzathirira Chigwa cha Sitimu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Koma Igupto adzasanduka bwinja,","poem":1},{"text":"Edomu adzasanduka chipululu,","poem":2},{"text":"chifukwa cha nkhondo imene anathira anthu a ku Yuda","poem":1},{"text":"mʼdziko limene anakhetsa magazi a anthu osalakwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Koma Yuda adzakhala ndi anthu mpaka muyaya","poem":1},{"text":"ndi Yerusalemu ku mibadomibado.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kukhetsa magazi kwawo kumene Ine sindinakhululuke","poem":1},{"text":"ndidzakhululuka.”","poem":2},{"lineBreak":true},"Yehova amakhala mu Ziyoni!"]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}