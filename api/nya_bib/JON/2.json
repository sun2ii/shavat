{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"JON","translationId":"nya_bib","name":"YONA","commonName":"YONA","title":"Yona","order":32,"numberOfChapters":4,"sha256":"414a03a11947bea9a3ebace28dd346b1c39c430f27190534add15f0e8ec12be8","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/nya_bib/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Pemphero la Yona"]},{"type":"verse","number":1,"content":["Yona ali mʼmimba mwa chinsomba chija anapemphera kwa Yehova Mulungu wake."]},{"type":"verse","number":2,"content":["Iye anati:",{"text":"“Pamene ndinali mʼmavuto anga ndinayitana Yehova,","poem":1},{"text":"ndipo Iye anandiyankha.","poem":2},{"text":"Ndili ku dziko la anthu akufa ndinapempha thandizo,","poem":1},{"text":"ndipo Inu munamva kulira kwanga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Munandiponya mʼnyanja yozama,","poem":1},{"text":"mʼkati mwenimweni mwa nyanja,","poem":2},{"lineBreak":true},{"text":"ndipo madzi oyenda anandizungulira;","poem":2},{"text":"mafunde anu onse ndi mkokomo wake","poem":1},{"text":"zinandimiza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndinati, ‘Ine ndachotsedwa","poem":1},{"text":"pamaso panu;","poem":2},{"text":"komabe ndidzayangʼananso","poem":1},{"text":"ku Nyumba yanu yopatulika.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Madzi wondimiza anandichititsa mantha,","poem":1},{"text":"nyanja yozama inandizungulira;","poem":2},{"lineBreak":true},{"text":"udzu wa mʼmadzi zinakuta mutu wanga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndinatsikira kunsi ndithu, mʼtsinde mwa mapiri;","poem":1},{"text":"mipiringidzo ya dziko inanditsekereza kosatha.","poem":2},{"text":"Koma Inu munatulutsa moyo wanga mʼmandamo,","poem":1},{"text":"Inu Yehova Mulungu wanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Pamene moyo wanga umachoka mwa ine,","poem":1},{"text":"ine ndinakumbukira Inu Yehova,","poem":2},{"text":"ndipo pemphero langa linafika kwa inu,","poem":1},{"text":"ku Nyumba yanu yopatulika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Iwo amene amagwiritsitsa mafano achabechabe","poem":1},{"text":"amataya chisomo chawo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Koma ine ndidzapereka kwa Inu nsembe","poem":1},{"text":"ndikuyimba nyimbo yamayamiko.","poem":2},{"text":"Chimene ndinalonjeza ndidzachikwaniritsa.","poem":1},{"text":"Chipulumutso chimachokera kwa Yehova.”","poem":2}]},{"type":"verse","number":10,"content":["Ndipo Yehova analamula chinsomba chija, ndipo chinakamusanza Yonayo mʼmbali mwa nyanja."]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}