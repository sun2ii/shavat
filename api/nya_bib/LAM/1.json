{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"LAM","translationId":"nya_bib","name":"MALIRO","commonName":"MALIRO","title":"Maliro","order":25,"numberOfChapters":5,"sha256":"3880d2ebbb0bdd25ad4bd7b0bb8cf92824dfbcd0cfacb929035115dc13d9743c","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/nya_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Haa! Mzinda uja wasiyidwa wokhawokha,","poem":1},{"text":"umene kale unali wodzaza ndi anthu!","poem":2},{"text":"Kale unali wotchuka pakati pa mitundu ya anthu!","poem":1},{"text":"Tsopano wasanduka ngati mkazi wamasiye.","poem":2},{"text":"Kale unali mfumukazi ya onse pa dziko lapansi,","poem":1},{"text":"tsopano wasanduka kapolo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ukulira mowawidwa mtima usiku wonse,","poem":1},{"text":"misozi ili pa masaya pake.","poem":2},{"text":"Mwa abwenzi ake onse,","poem":1},{"text":"palibe ndi mmodzi yemwe womutonthoza.","poem":2},{"text":"Abwenzi ake onse amuchitira chiwembu;","poem":1},{"text":"onse akhala adani ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yuda watengedwa ku ukapolo,","poem":1},{"text":"kukazunzika ndi kukagwira ntchito yolemetsa.","poem":2},{"text":"Iye akukhala pakati pa anthu a mitundu ina;","poem":1},{"text":"ndipo alibe malo opumulira.","poem":2},{"text":"Onse omuthamangitsa iye amupitirira,","poem":1},{"text":"ndipo alibe kwina kothawira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Misewu yopita ku Ziyoni ikulira,","poem":1},{"text":"chifukwa palibe ndi mmodzi yemwe akubwera ku maphwando ake.","poem":2},{"text":"Zipata zake zonse zili pululu,","poem":1},{"text":"ansembe akubuwula.","poem":2},{"text":"Anamwali ake akulira,","poem":1},{"text":"ndipo ali mʼmasautso woopsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Adani ake asanduka mabwana ake;","poem":1},{"text":"odana naye akupeza bwino.","poem":2},{"text":"Yehova wamubweretsera mavuto","poem":1},{"text":"chifukwa cha machimo ake ambiri.","poem":2},{"text":"Ana ake atengedwa ukapolo","poem":1},{"text":"pamaso pa mdani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ulemerero wonse wa mwana wamkazi wa Ziyoni","poem":1},{"text":"wachokeratu.","poem":2},{"text":"Akalonga ake ali ngati mbawala","poem":1},{"text":"zosowa msipu;","poem":2},{"text":"alibe mphamvu zothawira","poem":1},{"text":"owathamangitsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pa masiku a masautso ndi kuzunzika kwake,","poem":1},{"text":"Yerusalemu amakumbukira chuma chonse","poem":2},{"lineBreak":true},{"text":"chimene mʼmasiku amakedzana chinali chake.","poem":2},{"text":"Anthu ake atagwidwa ndi adani ake,","poem":1},{"text":"panalibe aliyense womuthandiza.","poem":2},{"text":"Adani ake ankamuyangʼana","poem":1},{"text":"ndi kumuseka chifukwa cha kuwonongeka kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusalemu wachimwa kwambiri","poem":1},{"text":"ndipo potero wakhala wodetsedwa.","poem":2},{"text":"Onse amene ankamulemekeza pano akumunyoza,","poem":1},{"text":"chifukwa aona umaliseche wake.","poem":2},{"text":"Iye mwini akubuwula","poem":1},{"text":"ndipo akubisa nkhope yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uve wake umaonekera pa zovala zake;","poem":1},{"text":"iye sanaganizire za tsogolo lake.","poem":2},{"text":"Nʼchifukwa chake kugwa kwake kunali kwakukulu;","poem":1},{"text":"ndipo analibe womutonthoza.","poem":2},{"text":"“Inu Yehova, taonani masautso anga,","poem":1},{"text":"pakuti mdani wapambana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Adani amulanda","poem":1},{"text":"chuma chake chonse;","poem":2},{"text":"iye anaona mitundu ya anthu achikunja ikulowa mʼmalo ake opatulika,","poem":1},{"text":"amene Inu Mulungu munawaletsa","poem":2},{"lineBreak":true},{"text":"kulowa mu msonkhano wanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Anthu ake onse akubuwula","poem":1},{"text":"pamene akufunafuna chakudya;","poem":2},{"text":"asinthanitsa chuma chawo ndi chakudya","poem":1},{"text":"kuti akhale ndi moyo.","poem":2},{"text":"“Inu Yehova, taonani ndipo ganizirani,","poem":1},{"text":"chifukwa ine ndanyozeka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kodi zimenezi mukuziyesa zachabe, inu nonse mukudutsa?","poem":1},{"text":"Yangʼanani ndipo muone.","poem":2},{"text":"Kodi pali mavuto ofanana ndi","poem":1},{"text":"amene andigwerawa,","poem":2},{"text":"amene Ambuye anandibweretsera","poem":1},{"text":"pa tsiku la ukali wake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Anatumiza moto kuchokera kumwamba,","poem":1},{"text":"unalowa mpaka mʼmafupa anga.","poem":2},{"text":"Anayala ukonde kuti ukole mapazi anga","poem":1},{"text":"ndipo anandibweza.","poem":2},{"text":"Anandisiya wopanda chilichonse,","poem":1},{"text":"wolefuka tsiku lonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Wazindikira machimo anga onse","poem":1},{"text":"ndipo ndi manja ake anawaluka pamodzi.","poem":2},{"text":"Machimowa afika pakhosi panga,","poem":1},{"text":"ndipo Ambuye wandithetsa mphamvu.","poem":2},{"text":"Iye wandipereka","poem":1},{"text":"kwa anthu amene sindingalimbane nawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ambuye wakana","poem":1},{"text":"anthu anga onse amphamvu omwe ankakhala nane:","poem":2},{"text":"wasonkhanitsa gulu lankhondo kuti lilimbane nane,","poem":1},{"text":"kuti litekedze anyamata anga;","poem":2},{"text":"mʼmalo ofinyira mphesa Ambuye wapondereza","poem":1},{"text":"anamwali a Yuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Chifukwa cha zimenezi ndikulira","poem":1},{"text":"ndipo maso anga adzaza ndi misozi.","poem":2},{"text":"Palibe aliyense pafupi woti anditonthoze,","poem":1},{"text":"palibe aliyense wondilimbitsa mtima.","poem":2},{"text":"Ana anga ali okhaokha","poem":1},{"text":"chifukwa mdani watigonjetsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Ziyoni wakweza manja ake,","poem":1},{"text":"koma palibe aliyense womutonthoza.","poem":2},{"text":"Yehova walamula kuti abale ake","poem":1},{"text":"a Yakobo akhale adani ake;","poem":2},{"text":"Yerusalemu wasanduka","poem":1},{"text":"chinthu chodetsedwa pakati pawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Yehova ndi wolungama,","poem":1},{"text":"koma ndine ndinawukira malamulo ake.","poem":2},{"text":"Imvani inu anthu a mitundu yonse;","poem":1},{"text":"onani masautso anga.","poem":2},{"text":"Anyamata ndi anamwali anga","poem":1},{"text":"agwidwa ukapolo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ndinayitana abwenzi anga","poem":1},{"text":"koma anandinyenga.","poem":2},{"text":"Ansembe ndi akuluakulu anga","poem":1},{"text":"anafa mu mzinda","poem":2},{"text":"pamene ankafunafuna chakudya","poem":1},{"text":"kuti akhale ndi moyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Inu Yehova, onani mmene ine ndavutikira!","poem":1},{"text":"Ndikuzunzika mʼkati mwanga,","poem":2},{"text":"ndipo mu mtima mwanga ndasautsidwa","poem":1},{"text":"chifukwa ndakhala osamvera.","poem":2},{"text":"Mʼmisewu anthu akuphedwa,","poem":1},{"text":"ndipo ku mudzi kuli imfa yokhayokha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Anthu amva kubuwula kwanga,","poem":1},{"text":"koma palibe wonditonthoza.","poem":2},{"text":"Adani anga onse amva masautso anga;","poem":1},{"text":"iwo akusangalala pa zimene Inu mwachita.","poem":2},{"text":"Lifikitseni tsiku limene munalonjeza lija","poem":1},{"text":"kuti iwonso adzakhale ngati ine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Lolani kuti ntchito zawo zoyipa zifike pamaso panu;","poem":1},{"text":"muwalange","poem":2},{"text":"ngati mmene mwandilangira ine","poem":1},{"text":"chifukwa cha machimo anga onse.","poem":2},{"text":"Ndikubuwula kwambiri","poem":1},{"text":"ndipo mtima wanga walefuka.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}