{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"LAM","translationId":"nya_bib","name":"MALIRO","commonName":"MALIRO","title":"Maliro","order":25,"numberOfChapters":5,"sha256":"3880d2ebbb0bdd25ad4bd7b0bb8cf92824dfbcd0cfacb929035115dc13d9743c","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/nya_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Haa, Ambuye waphimba mwana wamkazi wa Ziyoni","poem":1},{"text":"ndi mtambo wa mkwiyo wake!","poem":2},{"text":"Iye wataya pansi ulemerero wa Israeli","poem":1},{"text":"kuchoka kumwamba.","poem":2},{"text":"Pa tsiku la mkwiyo wake Iye sanakumbukirenso","poem":1},{"text":"popondapo mapazi ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ambuye anawononga midzi yonse ya Yakobo mopanda chifundo;","poem":1},{"lineBreak":true},{"text":"mu mkwiyo wake anagwetsa","poem":1},{"text":"malinga a mwana wamkazi wa Yuda.","poem":2},{"text":"Anagwetsa pansi mochititsa manyazi","poem":1},{"text":"maufumu ndi akalonga ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Atakwiya kwambiri, Ambuye anathyola","poem":1},{"text":"nyanga iliyonse ya Israeli.","poem":2},{"text":"Anabweza dzanja lake lamanja","poem":1},{"text":"pamene mdani anamuyandikira.","poem":2},{"text":"Ambuye anatentha fuko la Yakobo ngati moto wonyeketsa","poem":1},{"text":"umene umawononga zinthu zonse zomwe zili pafupi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wakokera uta wake pa ife ngati ndife adani;","poem":1},{"text":"wayimiritsa dzanja lake pa ife ngati ndife adani,","poem":2},{"text":"ndipo anapha onse amene tinkawayangʼana monyadira.","poem":1},{"lineBreak":true},{"text":"Ukali wake ukuyaka ngati moto","poem":1},{"text":"pa tenti ya mwana wamkazi wa Ziyoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ambuye ali ngati mdani;","poem":1},{"text":"wawonongeratu Israeli;","poem":2},{"text":"wawonongeratu nyumba zake zonse zaufumu","poem":1},{"text":"ndipo wawononga malinga ake.","poem":2},{"text":"Iye wachulukitsa kubuma ndi kulira","poem":1},{"text":"kwa mwana wamkazi wa Yuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wagwetsa malo ake okhalamo ngati khumbi la mʼmunda;","poem":1},{"text":"wawononga malo ake a msonkhano.","poem":2},{"text":"Yehova wayiwalitsa Ziyoni","poem":1},{"text":"maphwando ake oyikika ndi masabata ake.","poem":2},{"text":"Mokwiya kwambiri, Iye ananyoza","poem":1},{"text":"mfumu ndi wansembe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ambuye wakana guwa lake la nsembe","poem":1},{"text":"ndipo wasiya malo ake opatulika.","poem":2},{"text":"Iye wapereka makoma a nyumba zake zaufumu","poem":1},{"text":"kwa mdani wake;","poem":2},{"text":"adaniwo anafuwula mʼnyumba ya Yehova","poem":1},{"text":"ngati kuti ndi pa tsiku la chikondwerero.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yehova anatsimikiza kugwetsa","poem":1},{"text":"makoma a mwana wamkazi wa Ziyoni.","poem":2},{"text":"Anawayesa ndi chingwe","poem":1},{"text":"ndipo sanafune kuleka kuwagwetsa.","poem":2},{"text":"Analiritsa malinga ndi makoma;","poem":1},{"text":"onse anawonongeka pamodzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zipata za Yerusalemu zalowa pansi;","poem":1},{"text":"wathyola ndi kuwononga mipiringidzo yake.","poem":2},{"text":"Mfumu ndi akalonga ake agwidwa ukapolo pakati pa mitundu ya anthu,","poem":1},{"text":"palibenso lamulo,","poem":2},{"text":"ndipo aneneri ake sakupeza","poem":1},{"text":"masomphenya kuchokera kwa Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Akuluakulu a mwana wamkazi wa Ziyoni","poem":1},{"text":"akhala chete pansi;","poem":2},{"text":"awaza fumbi pa mitu yawo","poem":1},{"text":"ndipo avala ziguduli.","poem":2},{"text":"Anamwali a Yerusalemu","poem":1},{"text":"aweramitsa mitu yawo pansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Maso anga atopa ndi kulira,","poem":1},{"text":"ndazunzika mʼmoyo mwanga,","poem":2},{"text":"mtima wanga wadzaza ndi chisoni","poem":1},{"text":"chifukwa anthu anga akuwonongeka,","poem":2},{"text":"chifukwa ana ndi makanda akukomoka","poem":1},{"text":"mʼmisewu ya mu mzinda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Anawo akufunsa amayi awo kuti,","poem":1},{"text":"“Kodi tirigu ndi vinyo zili kuti?”","poem":2},{"text":"pamene akukomoka ngati anthu olasidwa","poem":1},{"text":"mʼmisewu ya mʼmizinda,","poem":2},{"text":"pamene miyoyo yawo ikufowoka","poem":1},{"text":"mʼmanja mwa amayi awo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndinganene chiyani za iwe?","poem":1},{"text":"Ndingakufanizire ndi chiyani,","poem":2},{"lineBreak":true},{"text":"iwe mwana wamkazi wa Yerusalemu?","poem":2},{"text":"Kodi ndingakufanizire ndi yani","poem":1},{"text":"kuti ndikutonthoze,","poem":2},{"lineBreak":true},{"text":"iwe namwali wa Ziyoni?","poem":2},{"text":"Chilonda chako ndi chozama ngati nyanja,","poem":1},{"text":"kodi ndani angakuchiritse?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Masomphenya a aneneri ako","poem":1},{"text":"anali abodza ndi achabechabe.","poem":2},{"text":"Iwo sanakupulumutse kuti usapite ku ukapolo","poem":1},{"text":"poyika poyera mphulupulu zako.","poem":2},{"text":"Mauthenga amene anakupatsa","poem":1},{"text":"anali achabechabe ndi osocheretsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Onse oyenda mʼnjira yako","poem":1},{"text":"akukuwombera mʼmanja;","poem":2},{"text":"akugwedeza mitu yawo ndi kukunyodola","poem":1},{"text":"iwe mwana wamkazi wa Yerusalemu:","poem":2},{"text":"“Kodi mzinda uja ndi uwu umene unkatchedwa","poem":1},{"text":"wokongola kotheratu,","poem":2},{"lineBreak":true},{"text":"chimwemwe cha dziko lonse lapansi?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Adani ako onse akutsekulira pakamwa ndi kukunyoza;","poem":1},{"lineBreak":true},{"text":"iwo akunyogodola ndi kukukuta mano awo,","poem":1},{"text":"ndipo akuti, “Tamumeza.","poem":2},{"text":"Tsiku ili ndi lomwe timayembekezera;","poem":1},{"text":"tili ndi moyo kuti tilione.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yehova wachita chimene anakonzeratu;","poem":1},{"text":"wakwaniritsa mawu ake,","poem":2},{"lineBreak":true},{"text":"amene anatsimikiza kale lomwe.","poem":2},{"text":"Wakuwononga mopanda chifundo,","poem":1},{"text":"walola mdani kuti akondwere chifukwa cha kugwa kwako,","poem":2},{"lineBreak":true},{"text":"wakweza mphamvu za adani ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mitima ya anthu","poem":1},{"text":"ikufuwulira Ambuye.","poem":2},{"text":"Iwe khoma la mwana wamkazi wa Ziyoni,","poem":1},{"text":"misozi yako itsike ngati mtsinje","poem":2},{"lineBreak":true},{"text":"usana ndi usiku;","poem":2},{"text":"usadzipatse wekha mpumulo,","poem":1},{"text":"maso ako asaleke kukhetsa misozi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dzuka, fuwula usiku,","poem":1},{"text":"pamene alonda ayamba kulondera;","poem":2},{"text":"khuthula mtima wako ngati madzi","poem":1},{"text":"pamaso pa Ambuye.","poem":2},{"text":"Kweza manja ako kwa Iye","poem":1},{"text":"chifukwa cha miyoyo ya ana ako,","poem":2},{"text":"amene akukomoka ndi njala","poem":1},{"text":"mʼmisewu yonse ya mu mzinda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Inu Yehova, onani, ndipo ganizirani:","poem":1},{"text":"kodi ndani amene mwamuchitirapo zinthu ngati izi?","poem":2},{"text":"Kodi amayi adye ana awo,","poem":1},{"text":"amene amawasamalira?","poem":2},{"text":"Kodi ansembe ndi aneneri awaphere","poem":1},{"text":"mʼmalo opatulika a Ambuye?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Anyamata ndi okalamba aligone pamodzi","poem":1},{"text":"pa fumbi la mʼmisewu ya mu mzinda;","poem":2},{"text":"anyamata anga ndi anamwali anga","poem":1},{"text":"aphedwa ndi lupanga.","poem":2},{"text":"Inu Yehova mwawapha pa tsiku la mkwiyo wanu;","poem":1},{"text":"mwawapha mopanda chifundo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ngati momwe mumayitanira pa tsiku la phwando,","poem":1},{"text":"chimodzimodzinso mwandiyitanira zoopsa mbali zonse.","poem":2},{"text":"Pa tsiku limene Yehova wakwiya","poem":1},{"text":"palibe amene angathawe ndi kukhala ndi moyo;","poem":2},{"text":"mdani wanga wawononga","poem":1},{"text":"onse amene ndinkawasamala ndi kuwalera.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}