{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"LAM","translationId":"nya_bib","name":"MALIRO","commonName":"MALIRO","title":"Maliro","order":25,"numberOfChapters":5,"sha256":"3880d2ebbb0bdd25ad4bd7b0bb8cf92824dfbcd0cfacb929035115dc13d9743c","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/nya_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Ine ndine munthu amene ndaona masautso","poem":1},{"text":"ndi ndodo ya ukali wake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wandipititsa kutali ndipo wandiyendetsa","poem":1},{"text":"mu mdima osati mʼkuwala;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"zoonadi anandikantha ndi dzanja lake","poem":1},{"text":"mobwerezabwereza tsiku lonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wakalambitsa khungu langa ndi mnofu wanga,","poem":1},{"text":"ndipo waphwanya mafupa anga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wandizinga ndi kundizungulira","poem":1},{"text":"ndi zowawa ndi zolemetsa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wandikhazika mu mdima","poem":1},{"text":"ngati amene anafa kale.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wandimangira khoma kotero kuti sindingathawe,","poem":1},{"text":"wandimanga ndi maunyolo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngakhale pamene ndifuwula kapena kupempha chithandizo,","poem":1},{"text":"amakana pemphero langa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wanditsekera njira yanga ndi miyala yosema;","poem":1},{"text":"ndipo wakhotetsa tinjira tanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wandidikirira ngati chimbalangondo,","poem":1},{"text":"wandibisalira ngati mkango.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wandikokera pambali ndi kundingʼambangʼamba,","poem":1},{"text":"ndipo wandisiya wopanda thandizo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wakoka uta wake","poem":1},{"text":"ndipo walunjikitsa mivi yake pa ine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Walasa mtima wanga","poem":1},{"text":"ndi mivi ya mʼphodo mwake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndinakhala choseketsa cha anthu anga onse;","poem":1},{"text":"amandinyodola mʼnyimbo zawo tsiku lonse.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wandidyetsa zowawa","poem":1},{"text":"ndipo wandimwetsa ndulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wathyola mano anga ndi miyala;","poem":1},{"text":"wandiviviniza mʼfumbi;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wandichotsera mtendere;","poem":1},{"text":"ndayiwala kuti kupeza bwino nʼchiyani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Choncho ndikuti, “Ulemerero wanga wachoka","poem":1},{"text":"ndi zonse zimene ndimayembekeza kwa Yehova.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kukumbukira masautso anga ndi kusowa pokhala,","poem":1},{"text":"zili ngati zowawa ndi ndulu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ine ndikuzikumbukira bwino izi,","poem":1},{"text":"ndipo moyo wanga wathedwa mʼkati mwanga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Komabe ndimakumbukira zimenezi,","poem":1},{"text":"nʼchifukwa chake ndili ndi chiyembekezo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ife sitinawonongekeretu chifukwa chikondi cha Yehova ndi chachikulu,","poem":1},{"text":"ndi chifundo chake ndi chosatha.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Zimaoneka zatsopano mmawa uliwonse;","poem":1},{"text":"kukhulupirika kwanu nʼkwakukulu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mu mtima mwanga ndimati, “Yehova ndiye zanga zonse;","poem":1},{"text":"motero ndimamuyembekezera.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Yehova ndi wabwino kwa amene amayembekezera Iye,","poem":1},{"text":"kwa munthu amene amafunafuna Iyeyo;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"nʼkwabwino kudikira chipulumutso cha","poem":1},{"text":"Yehova modekha.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nʼkwabwino kuti munthu asenze goli","poem":1},{"text":"pamene ali wamngʼono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Akhale chete pa yekha,","poem":1},{"text":"chifukwa Yehova wamusenzetsa golilo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Abise nkhope yake mʼfumbi","poem":1},{"text":"mwina chiyembekezo nʼkukhalapobe.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Apereke tsaya lake kwa iye amene angamumenye,","poem":1},{"text":"ndipo amuchititse manyazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Chifukwa Ambuye satayiratu","poem":1},{"text":"anthu nthawi zonse.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngakhale amabweretsa zowawa, Iye adzawachitira chifundo,","poem":1},{"text":"chifukwa chikondi chake ndi chosatha.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Pakuti sabweretsa masautso mwadala,","poem":1},{"text":"kapena zowawa kwa ana a anthu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Kuphwanya ndi phazi","poem":1},{"text":"a mʼndende onse a mʼdziko,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"kukaniza munthu ufulu wake","poem":1},{"text":"pamaso pa Wammwambamwamba,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"kumana munthu chiweruzo cholungama—","poem":1},{"text":"kodi Ambuye saona zonsezi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Kodi ndani angayankhule zinthu nʼkuchitika","poem":1},{"text":"ngati Ambuye sanavomereze?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Kodi zovuta ndi zabwino sizituluka","poem":1},{"text":"mʼkamwa mwa Wammwambamwamba?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Kodi nʼchifukwa chiyani munthu aliyense wamoyo amadandaula","poem":1},{"text":"akalangidwa chifukwa cha machimo ake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Tiyeni tisanthule ndi kuyesa njira zathu,","poem":1},{"text":"ndipo tiyeni tibwerere kwa Yehova.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Tiyeni tikweze mitima yathu ndi manja athu","poem":1},{"text":"kwa Mulungu kumwamba ndipo tinene kuti:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“Ife tachimwa ndi kuwukira","poem":1},{"text":"ndipo inu simunakhululuke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“Mwadzikuta ndi mkwiyo ndi kutilondola ndipo","poem":1},{"text":"mwatitha mopanda chifundo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Mwadzikuta mu mtambo","poem":1},{"text":"kotero mapemphero athu sakukufikani.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Mwatisandutsa zinyatsi ndi zinyalala","poem":1},{"text":"pakati pa mitundu ya anthu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“Adani anthu atitsekulira pakamwa.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Ife tadzazidwa ndi mantha pakuti tagwa mʼdzenje,","poem":1},{"text":"tapasuka ndi kuwonongedwa.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Misozi mʼmaso mwanga ikungoti mbwembwembwe","poem":1},{"text":"chifukwa anthu anga akuwonongedwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Misozi idzatsika kosalekeza,","poem":1},{"text":"ndipo sidzasiya,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"mpaka Yehova ayangʼane pansi","poem":1},{"text":"kuchokera kumwamba ndi kuona.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Mtima wanga ukupweteka poona zimenezi","poem":1},{"text":"chifukwa cha akazi onse a mu mzinda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Akundisaka ngati mbalame,","poem":1},{"text":"amene anali adani anga, popanda chifukwa.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Ayesa kundipha pondiponya mʼdzenje","poem":1},{"text":"ndi kundiponya miyala;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"madzi anamiza mutu wanga","poem":1},{"text":"ndipo ndinkaganiza kuti imfa yayandikira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Ndinayitana dzina lanu Inu Yehova,","poem":1},{"text":"kuchokera mʼdzenje lozama.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Inu munamva kudandaula kwanga. “Mundimvere","poem":1},{"text":"kulira kwanga kopempha thandizo.”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Munafika pafupi pamene ndinakuyitanani,","poem":1},{"text":"ndipo munati, “Usaope.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Inu Ambuye munandiwombola ku mlandu wanga;","poem":1},{"text":"munapulumutsa moyo wanga.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Yehova, mwaona zoyipa zimene andichitira.","poem":1},{"text":"Mundiweruzire ndinu!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Mwaona kuzama kwa kubwezera kwawo,","poem":1},{"text":"chiwembu chawo chonse pa ine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Inu Yehova mwamva kunyoza kwawo,","poem":1},{"text":"chiwembu chawo chonse pa ine,","poem":2}]},{"type":"verse","number":62,"content":[{"text":"manongʼonongʼo a adani anga","poem":1},{"text":"ondiwukira ine tsiku lonse.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Tawaonani! Kaya ali pansi kapena kuyimirira,","poem":1},{"text":"akundinyoza mu nyimbo zawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Inu Yehova, muwabwezere chowayenera,","poem":1},{"text":"chifukwa cha zimene manja awo achita.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Phimbani mitima yawo,","poem":1},{"text":"ndipo matemberero anu akhale pa iwo!","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Muwalondole mwaukali ndipo","poem":1},{"text":"muwawonongeretu pa dziko lapansi.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}