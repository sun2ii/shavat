{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"LAM","translationId":"nya_bib","name":"MALIRO","commonName":"MALIRO","title":"Maliro","order":25,"numberOfChapters":5,"sha256":"3880d2ebbb0bdd25ad4bd7b0bb8cf92824dfbcd0cfacb929035115dc13d9743c","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/nya_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Haa! Golide wathimbirira,","poem":1},{"text":"golide wosalala wasinthikiratu!","poem":2},{"text":"Amwazamwaza miyala yokongola ya kumalo opatulika","poem":1},{"text":"pamphambano ponse pa mzinda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Haa! Ana a Ziyoni amtengowapatali","poem":1},{"text":"amene kale anali ngati golide,","poem":2},{"text":"tsopano ali ngati miphika ya dothi,","poem":1},{"text":"ntchito ya owumba mbiya!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngakhale nkhandwe zimapereka bere","poem":1},{"text":"kuyamwitsa ana ake,","poem":2},{"text":"koma anthu anga asanduka ankhanza","poem":1},{"text":"ngati nthiwatiwa mʼchipululu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lilime la mwana lakangamira kukhosi","poem":1},{"text":"chifukwa cha ludzu,","poem":2},{"text":"ana akupempha chakudya,","poem":1},{"text":"koma palibe amene akuwapatsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iwo amene kale ankadya zonona","poem":1},{"text":"akupemphetsa mʼmisewu ya mu mzinda.","poem":2},{"text":"Iwo amene kale ankavala zokongola","poem":1},{"text":"tsopano akugona pa phulusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuyipa kwa anthu anga kunali kwakukulu","poem":1},{"text":"kuposa anthu a ku Sodomu,","poem":2},{"text":"amene anawonongedwa mʼkamphindi kochepa","poem":1},{"text":"popanda owathandiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Akalonga ake anali owala koposa chisanu chowundana","poem":1},{"text":"ndi oyera kuposa mkaka.","poem":2},{"text":"Matupi awo anali ofiira kuposa miyala ya rubi,","poem":1},{"text":"maonekedwe awo ngati miyala ya safiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Koma tsopano maonekedwe awo ndi akuda kuposa mwaye;","poem":1},{"text":"palibe angawazindikire mʼmisewu ya mu mzinda.","poem":2},{"text":"Khungu lawo lachita makwinyamakwinya pa mafupa awo;","poem":1},{"text":"lawuma gwaa ngati nkhuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amene anaphedwa ndi lupanga aliko bwino kuposa","poem":1},{"text":"amene anafa ndi njala;","poem":2},{"text":"chifukwa chosowa chakudya cha mʼmunda","poem":1},{"text":"iwowa ankafowoka ndi njala mpaka kufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Amayi achifundo afika","poem":1},{"text":"pophika ana awo enieni,","poem":2},{"text":"ndiwo anali chakudya chawo pamene anthu","poem":1},{"text":"anga anali kuwonongeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yehova wakwaniritsa ukali wake;","poem":1},{"text":"wagwetsa pansi mkwiyo wake woopsa.","poem":2},{"text":"Ndipo wayatsa moto mʼZiyoni","poem":1},{"text":"kuti uwononge maziko ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mafumu a pa dziko lapansi sanakhulupirire,","poem":1},{"text":"kapena wina aliyense wokhala pa dziko lonse,","poem":2},{"text":"kuti adani kapena ankhondo akhoza kulowa","poem":1},{"text":"pa zipata za Yerusalemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Koma izi zinachitika chifukwa cha kuchimwa kwa aneneri ake","poem":1},{"text":"ndi mphulupulu za ansembe ake,","poem":2},{"text":"amene ankapha anthu osalakwa pakati pawo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tsopano akungoyendayenda mʼmisewu ya mu mzinda","poem":1},{"text":"ngati anthu osaona.","poem":2},{"text":"Iwo ndi odetsedwa kwambiri ndi magazi","poem":1},{"text":"palibe yemwe angayerekeze nʼkukhudza komwe chovala chawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Anthu akuwafuwulira kuti, “Chokani! Inu anthu odetsedwa!”","poem":1},{"text":"“Chokani! Chokani! Musatikhudze ife!”","poem":2},{"text":"Akamathawa ndi kumangoyendayenda,","poem":1},{"text":"pakati pa anthu a mitundu yonse amati,","poem":2},{"lineBreak":true},{"text":"“Asakhalenso ndi ife.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yehova mwini wake wawabalalitsa;","poem":1},{"text":"Iye sakuwalabadiranso.","poem":2},{"text":"Ansembe sakulandira ulemu,","poem":1},{"text":"akuluakulu sakuwachitira chifundo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ndiponso maso athu atopa nʼkuyangʼana,","poem":1},{"text":"chithandizo chosabwera nʼkomwe,","poem":2},{"text":"kuchokera pa nsanja zathu tinadikirira mtundu","poem":1},{"text":"wa anthu umene sukanatipulumutsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Anthu ankalondola mapazi athu,","poem":1},{"text":"choncho sitikanayenda mʼmisewu yathu mu mzinda.","poem":2},{"text":"Chimaliziro chathu chinali pafupi, masiku athu anali owerengeka,","poem":1},{"text":"chifukwa chimaliziro chathu chinali chitafika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Otilondola akuthamanga kwambiri","poem":1},{"text":"kuposa ziwombankhanga mu mlengalenga;","poem":2},{"text":"anatithamangitsa mpaka ku mapiri","poem":1},{"text":"ndi kutibisalira mʼchipululu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wodzozedwa wa Yehova, mpweya wathu wotipatsa moyo,","poem":1},{"text":"anakodwa mʼmisampha yawo.","poem":2},{"text":"Tinaganiza kuti tidzakhala pansi pa mthunzi wake","poem":1},{"text":"pakati pa mitundu ya anthu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kondwera ndi kusangalala, mwana wamkazi wa Edomu.","poem":1},{"text":"Iwe amene umakhala mʼdziko la Uzi.","poem":2},{"text":"Koma iwenso chikho chidzakupeza;","poem":1},{"text":"udzaledzera mpaka kukhala maliseche.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Iwe mwana wamkazi wa Ziyoni, chilango chako chidzatha;","poem":1},{"text":"Iye sadzatalikitsa nthawi yako ya ukapolo.","poem":2},{"text":"Koma Yehova adzalanga machimo ako, iwe mwana wamkazi wa Edomu,","poem":1},{"text":"ndi kuyika poyera mphulupulu zako.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}