{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"LAM","translationId":"nya_bib","name":"MALIRO","commonName":"MALIRO","title":"Maliro","order":25,"numberOfChapters":5,"sha256":"3880d2ebbb0bdd25ad4bd7b0bb8cf92824dfbcd0cfacb929035115dc13d9743c","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/nya_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Inu Yehova, kumbukirani zimene zinatichitikira;","poem":1},{"text":"yangʼanani ndipo muone kunyozeka kwathu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Apereka cholowa chathu kwa obwera,","poem":1},{"text":"nyumba zathu kwa alendo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Takhala amasiye ndi wopanda abambo,","poem":1},{"text":"amayi athu ali ngati akazi amasiye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tiyenera kugula madzi amene timamwa,","poem":1},{"text":"nkhuni zathunso nʼzogula.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Otilondola atigwira pakhosi;","poem":1},{"text":"tafowoka ndipo sakutilola kupumula.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tinadzipereka kwa Aigupto ndi kwa Asiriya","poem":1},{"text":"kuti tipeze chakudya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Makolo athu anachimwa ndipo anafa kale,","poem":1},{"text":"koma chilango chawo chili pa ife.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akapolo akutilamulira,","poem":1},{"text":"ndipo palibe ndi mmodzi yemwe angatimasule mʼdzanja lawo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Timapeza chakudya chathu poyika miyoyo yathu pa chiswe","poem":1},{"text":"chifukwa cha lupanga mʼchipululu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Khungu lathu latentha ngati uvuni mʼngʼanjo,","poem":1},{"text":"chifukwa cha kuwawa kwa njala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amayi agwiriridwa mu Ziyoni,","poem":1},{"text":"ndi anamwali mʼmizinda ya Yuda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akalonga athu akuwapachika pomangirira manja awo,","poem":1},{"text":"akuluakulu sakuwalemekeza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Achinyamata akukakamizidwa kupera tirigu;","poem":1},{"text":"anyamata akudzandira ndi mitolo ya nkhuni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akuluakulu anachokapo pa chipata cha mzinda;","poem":1},{"text":"achinyamata aleka nyimbo zawo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Chimwemwe chachoka mʼmitima yathu;","poem":1},{"text":"kuvina kwathu kwasanduka maliro.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Chipewa chathu chaufumu chagwa pamutu pathu.","poem":1},{"text":"Tsoka kwa ife, chifukwa tachimwa!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mitima yathu yakomoka chifukwa cha zimenezi,","poem":1},{"text":"chifukwa cha zinthu zimenezi maso athu sakuona bwino,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"pakuti phiri la Ziyoni, limene lasanduka bwinja,","poem":1},{"text":"nkhandwe zikungoyendayendapo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Inu Yehova, lamulirani kwamuyaya;","poem":1},{"text":"mpando wanu waufumu udzakhalabe ku mibadomibado.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Chifukwa chiyani mumatiyiwala nthawi zonse?","poem":1},{"text":"Chifukwa chiyani mwatitaya nthawi yayitali chotere?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yehova mutitembenuzire kwa Inu, kuti tibwerere;","poem":1},{"text":"mukonzenso masiku athu akhale monga akale,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"pokhapokha ngati mwatitaya kotheratu,","poem":1},{"text":"ndi kuti mwatikwiyira kobzola muyeso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}