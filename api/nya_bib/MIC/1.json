{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"MIC","translationId":"nya_bib","name":"MIKA","commonName":"MIKA","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3c35af5bcbc3599fe90ee908a691ec7bf25ac1ace5cfe51edab2f8f9c76c1c9c","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/nya_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Yehova anayankhula ndi Mika wa ku Moreseti pa nthawi ya ulamuliro wa Yotamu, Ahazi ndi Hezekiya, mafumu a ku Yuda. Awa ndi masomphenya amene iye anaona onena za Samariya ndi Yerusalemu."]},{"type":"verse","number":2,"content":[{"text":"Tamverani, inu anthu a mitundu yonse,","poem":1},{"text":"mvetsera iwe dziko lapansi ndi okhala mʼmenemo,","poem":2},{"text":"pakuti Ambuye Yehova achitira umboni wokutsutsani,","poem":1},{"text":"Ambuye akuyankhula ali mʼnyumba yake yopatulika.","poem":2}]},{"type":"heading","content":["Chiweruzo cha Samariya ndi Yerusalemu"]},{"type":"verse","number":3,"content":[{"text":"Taonani! Yehova akubwera kuchokera ku malo ake;","poem":1},{"text":"Iye akutsika ndipo akuponda pa malo okwera a dziko lapansi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mapiri akusungunuka pansi pake,","poem":1},{"text":"ndipo zigwa zikugawikana","poem":2},{"text":"ngati phula pa moto,","poem":1},{"text":"ngati madzi ochokera mʼphiri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zonsezi ndi chifukwa cha cholakwa cha Yakobo,","poem":1},{"text":"chifukwa cha machimo a nyumba ya Israeli.","poem":2},{"text":"Kodi cholakwa cha Yakobo nʼchiyani?","poem":1},{"text":"Kodi si Samariya?","poem":2},{"text":"Kodi malo achipembedzo a Yuda ndi ati?","poem":1},{"text":"Kodi si Yerusalemu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Choncho Ine ndidzasandutsa Samariya kukhala bwinja,","poem":1},{"text":"malo odzalamo mphesa.","poem":2},{"text":"Miyala yake ndidzayitaya ku chigwa","poem":1},{"text":"ndipo ndidzafukula maziko ake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mafano ake onse ndidzawaphwanyaphwanya;","poem":1},{"text":"mphatso zake zonse ndidzazitentha ndi moto;","poem":2},{"lineBreak":true},{"text":"ndidzawononga zifanizo zonse za milungu yake.","poem":2},{"text":"Popeza analandira mphatso zake kuchokera ku malipiro a akazi achiwerewere,","poem":1},{"text":"mphatsozonso zidzagwiritsidwa ntchito ndi ena ngati malipiro a akazi achiwerewere.”","poem":2}]},{"type":"heading","content":["Kulira ndi Kumva Chisoni"]},{"type":"verse","number":8,"content":[{"text":"Chifukwa cha zimenezi ine ndidzalira momvetsa chisoni;","poem":1},{"text":"ndidzayenda wopanda nsapato ndi wamaliseche.","poem":2},{"text":"Ndidzafuwula ngati nkhandwe","poem":1},{"text":"ndi kulira ngati kadzidzi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pakuti chilonda cha Samariya nʼchosachizika;","poem":1},{"text":"chafika ku Yuda.","poem":2},{"text":"Chafika pa chipata chenicheni cha anthu anga,","poem":1},{"text":"mpaka mu Yerusalemu mwenimwenimo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Musanene zimenezi ku Gati;","poem":1},{"text":"musalire nʼkomwe.","poem":2},{"text":"Mugubuduzike mu fumbi","poem":1},{"text":"ku Beti-Leafura.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inu anthu okhala ku Safiro,","poem":1},{"text":"muzipita ku ukapolo muli amaliseche ndi amanyazi.","poem":2},{"text":"Iwo amene akukhala ku Zanaani","poem":1},{"text":"sadzatuluka.","poem":2},{"text":"Beti-Ezeli akulira mwachisoni;","poem":1},{"text":"chitetezo chake chakuchokerani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anthu amene amakhala ku Maroti akubuwula ndi ululu,","poem":1},{"text":"akuyembekezera thandizo,","poem":2},{"text":"chifukwa Yehova wabweretsa tsoka,","poem":1},{"text":"lafika mpaka pa chipata cha Yerusalemu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inu anthu okhala ku Lakisi","poem":1},{"text":"mangani akavalo ku magaleta.","poem":2},{"text":"Inu amene munayamba kuchimwitsa","poem":1},{"text":"mwana wamkazi wa Ziyoni,","poem":2},{"text":"pakuti zolakwa za Israeli","poem":1},{"text":"zinapezeka pakati panu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Chifukwa chake perekani mphatso zolawirana","poem":1},{"text":"ndi a ku Moreseti Gati.","poem":2},{"text":"Mzinda wa Akizibu udzaonetsa kunama","poem":1},{"text":"kwa mafumu a Israeli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndidzabweretsa mgonjetsi kudzalimbana ndi inu","poem":1},{"text":"okhala mu Maresa.","poem":2},{"text":"Ulemerero wa Israeli udzafika","poem":1},{"text":"ku Adulamu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Metani mipala mitu yanu kuonetsa kuti mukulirira","poem":1},{"text":"ana anu amene mumawakonda;","poem":2},{"text":"mudzichititse dazi ngati dembo,","poem":1},{"text":"pakuti anawo adzatengedwa pakati panu kupita ku ukapolo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}