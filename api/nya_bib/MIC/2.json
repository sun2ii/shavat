{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"MIC","translationId":"nya_bib","name":"MIKA","commonName":"MIKA","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3c35af5bcbc3599fe90ee908a691ec7bf25ac1ace5cfe51edab2f8f9c76c1c9c","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/nya_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Zokonzekera za Munthu ndi Zokonzekera za Mulungu"]},{"type":"verse","number":1,"content":[{"text":"Tsoka kwa amene amakonzekera chiwembu,","poem":1},{"text":"kwa amene amakonzekera kuchita zoyipa usiku pa mabedi awo!","poem":2},{"text":"Kukacha mmawa amakachitadi","poem":1},{"text":"chifukwa ali ndi mphamvu zochitira zimenezo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amasirira minda ndi kuyilanda,","poem":1},{"text":"amasirira nyumba ndi kuzilanda.","poem":2},{"text":"Amatenga nyumba ya munthu mwachinyengo,","poem":1},{"text":"munthu mnzawo kumulanda cholowa chake.","poem":2}]},{"type":"verse","number":3,"content":["Nʼchifukwa chake Yehova akuti,",{"text":"“Ine ndikukonzekera kubweretsa tsoka pa anthu awa,","poem":1},{"text":"tsoka limene simudzatha kudzipulumutsa nokha.","poem":2},{"text":"Inu simudzayendanso monyada,","poem":1},{"text":"pakuti idzakhala nthawi ya masautso.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tsiku limenelo anthu adzakuchitani chipongwe;","poem":1},{"text":"adzakunyogodolani ndi nyimbo iyi yamaliro:","poem":2},{"text":"‘Tawonongeka kotheratu;","poem":1},{"text":"dziko la anthu anga lagawidwa.","poem":2},{"text":"Iye wandilanda!","poem":1},{"text":"Wapereka minda yathu kwa anthu otiwukira.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nʼchifukwa chake simudzakhala ndi munthu mu msonkhano wa Yehova","poem":1},{"text":"kuti agawe dziko pochita maere.","poem":2}]},{"type":"heading","content":["Aneneri Onyenga"]},{"type":"verse","number":6,"content":[{"text":"Aneneri awo amanena kuti, “Usanenere!","poem":1},{"text":"Usanenere ndi pangʼono pomwe zimenezi;","poem":2},{"lineBreak":true},{"text":"ife sitidzachititsidwa manyazi.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inu nyumba ya Yakobo, monga zimenezi ndi zoyenera kuzinena:","poem":1},{"text":"“Kodi Mzimu wa Yehova wakwiya?","poem":2},{"lineBreak":true},{"text":"Kodi Iye amachita zinthu zotere?”","poem":2},{"lineBreak":true},{"text":"“Kodi mawu ake sabweretsa zabwino","poem":1},{"text":"kwa amene amayenda molungama?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Posachedwapa anthu anga andiwukira","poem":1},{"text":"ngati mdani.","poem":2},{"text":"Mumawavula mkanjo wamtengowapatali","poem":1},{"text":"anthu amene amadutsa mosaopa kanthu,","poem":2},{"lineBreak":true},{"text":"monga anthu amene akubwera ku nkhondo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mumatulutsa akazi a anthu anga","poem":1},{"text":"mʼnyumba zawo zabwino.","poem":2},{"text":"Mumalanda ana awo madalitso anga","poem":1},{"text":"kosatha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nyamukani, chokani!","poem":1},{"text":"Pakuti ano si malo anu opumulirapo,","poem":2},{"text":"chifukwa ayipitsidwa,","poem":1},{"text":"awonongedwa, sangatheke kuwakonzanso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngati munthu wabodza ndi wachinyengo abwera nʼkunena kuti,","poem":1},{"text":"‘Ine ndidzanenera ndipo mudzakhala ndi vinyo ndi mowa wambiri,","poem":2},{"lineBreak":true},{"text":"woteroyo adzakhala mneneri amene anthu awa angamukonde!’","poem":2}]},{"type":"heading","content":["Alonjeza Chipulumutso"]},{"type":"verse","number":12,"content":[{"text":"“Inu banja la Yakobo, ndidzakusonkhanitsani nonse;","poem":1},{"text":"ndidzawasonkhanitsa pamodzi otsala a ku Israeli.","poem":2},{"text":"Ndidzawabweretsa pamodzi ngati nkhosa mʼkhola,","poem":1},{"text":"ngati ziweto pa msipu wake;","poem":2},{"lineBreak":true},{"text":"malowo adzadzaza ndi chinamtindi cha anthu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amene adzawapulumutse adzayenda patsogolo pawo;","poem":1},{"text":"iwo adzathyola chipata ndipo adzatuluka.","poem":2},{"text":"Mfumu yawo idzawatsogolera,","poem":1},{"text":"Yehova adzakhala patsogolo pawo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}