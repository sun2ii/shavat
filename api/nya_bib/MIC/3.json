{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"MIC","translationId":"nya_bib","name":"MIKA","commonName":"MIKA","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3c35af5bcbc3599fe90ee908a691ec7bf25ac1ace5cfe51edab2f8f9c76c1c9c","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/nya_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Atsogoleri ndi Aneneri Adzudzulidwa"]},{"type":"verse","number":1,"content":["Ndipo ine ndinati,",{"text":"“Tamverani, inu atsogoleri a Yakobo,","poem":1},{"text":"inu olamulira nyumba ya Israeli.","poem":2},{"text":"Kodi sindinu oyenera kudziwa kuweruza molungama,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"inu amene mumadana ndi zabwino ndi kukonda zoyipa;","poem":2},{"text":"inu amene mumasenda khungu la anthu anga,","poem":1},{"text":"ndipo mumakungunula mnofu pa mafupa awo;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"inu amene mumadya anthu anga,","poem":1},{"text":"mumasenda khungu lawo","poem":2},{"lineBreak":true},{"text":"ndi kuphwanya mafupa awo;","poem":2},{"text":"inu amene mumawadula nthulinthuli","poem":1},{"text":"ngati nyama yokaphika?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pamenepo adzalira kwa Yehova,","poem":1},{"text":"koma Iye sadzawayankha.","poem":2},{"text":"Nthawi imeneyo Iye adzawabisira nkhope yake","poem":1},{"text":"chifukwa cha zoyipa zimene anazichita.","poem":2}]},{"type":"verse","number":5,"content":["Yehova akuti,",{"text":"“Aneneri amene","poem":1},{"text":"amasocheretsa anthu anga,","poem":2},{"text":"ngati munthu wina awapatsa chakudya","poem":1},{"text":"amamufunira ‘mtendere;’","poem":2},{"text":"ngati munthu wina sawapatsa zakudya","poem":1},{"text":"amamulosera zoyipa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nʼchifukwa chake kudzakuderani,","poem":1},{"text":"simudzaonanso masomphenya,","poem":2},{"text":"mdima udzakugwerani ndipo simudzawombezanso.","poem":1},{"text":"Dzuwa lidzawalowera aneneriwo, ndipo mdima udzawagwera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Alosi adzachita manyazi","poem":1},{"text":"ndipo owombeza mawula adzanyazitsidwa.","poem":2},{"text":"Onse adzaphimba nkhope zawo","poem":1},{"text":"chifukwa Mulungu sakuwayankha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Koma kunena za ine, ndadzazidwa ndi mphamvu,","poem":1},{"text":"ndi Mzimu wa Yehova,","poem":2},{"lineBreak":true},{"text":"ndi kulungama, ndi kulimba mtima,","poem":2},{"text":"kuti ndilalikire za kugalukira kwa Yakobo,","poem":1},{"text":"kwa Israeli za tchimo lake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Imvani izi, inu atsogoleri a nyumba ya Yakobo,","poem":1},{"text":"inu olamulira nyumba ya Israeli,","poem":2},{"text":"inu amene mumadana ndi kuweruza kolungama;","poem":1},{"text":"ndipo mumakhotetsa zinthu zonse zolondola;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"inu amene mukumanga Ziyoni pokhetsa magazi,","poem":1},{"text":"ndi Yerusalemu ndi kuyipa kwanu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Atsogoleri ake amalandira chiphuphu kuti aweruze,","poem":1},{"text":"ansembe ake amalandira malipiro kuti alalikire,","poem":2},{"lineBreak":true},{"text":"ndipo aneneri ake amanenera kuti alandire ndalama.","poem":2},{"text":"Komatu amatsamira pa Yehova nʼkumanena kuti,","poem":1},{"text":"“Kodi Yehova sali pakati pathu?","poem":2},{"lineBreak":true},{"text":"Palibe tsoka limene lidzatigwere.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Choncho chifukwa cha inu,","poem":1},{"text":"Ziyoni adzatipulidwa ngati munda,","poem":2},{"text":"Yerusalemu adzasanduka bwinja,","poem":1},{"text":"ndipo phiri la Nyumba ya Mulungu lidzasanduka nkhalango yowirira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}