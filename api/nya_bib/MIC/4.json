{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"MIC","translationId":"nya_bib","name":"MIKA","commonName":"MIKA","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3c35af5bcbc3599fe90ee908a691ec7bf25ac1ace5cfe51edab2f8f9c76c1c9c","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/nya_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Phiri la Yehova"]},{"type":"verse","number":1,"content":["Mʼmasiku otsiriza,",{"text":"phiri la Nyumba ya Yehova adzalikhazikitsa","poem":1},{"text":"kukhala lalitali kuposa mapiri ena onse.","poem":2},{"text":"Lidzaonekera pamwamba pa mapiri ena onse,","poem":1},{"text":"ndipo anthu amitundu yonse adzathamangira kumeneko.","poem":2}]},{"type":"verse","number":2,"content":["Mayiko ambiri adzabwera ndikunena kuti,",{"text":"“Tiyeni, tikwere ku phiri la Yehova,","poem":1},{"text":"ku nyumba ya Mulungu wa Yakobo.","poem":2},{"text":"Iye adzatiphunzitsa njira zake,","poem":1},{"text":"ndipo tidzayenda mʼnjira zakezo.”","poem":2},{"text":"Malangizo adzachokera ku Ziyoni,","poem":1},{"text":"mawu a Yehova adzachokera ku Yerusalemu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iye adzaweruza pakati pa anthu amitundu yambiri","poem":1},{"text":"ndipo adzathetsa kusamvana pakati pa anthu amphamvu akutali ndi apafupi omwe.","poem":2},{"text":"Anthuwo adzasandutsa malupanga awo kukhala makasu","poem":1},{"text":"ndiponso mikondo yawo kukhala zomwetera.","poem":2},{"text":"Mtundu wina sudzatenganso lupanga kumenyana ndi mtundu wina,","poem":1},{"text":"kapena kuphunziranso za nkhondo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Munthu aliyense adzakhala pansi pa tsinde pa mtengo wake wa mpesa","poem":1},{"text":"ndi pa tsinde pa mtengo wake wamkuyu,","poem":2},{"text":"ndipo palibe amene adzawachititse mantha,","poem":1},{"text":"pakuti Yehova Wamphamvuzonse wayankhula.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mitundu yonse ya anthu","poem":1},{"text":"itha kutsatira milungu yawo;","poem":2},{"text":"ife tidzayenda mʼnjira za Yehova","poem":1},{"text":"Mulungu wathu mpaka muyaya.","poem":2}]},{"type":"heading","content":["Cholinga cha Yehova"]},{"type":"verse","number":6,"content":["“Tsiku limenelo, Yehova akuti,",{"text":"“ndidzasonkhanitsa olumala;","poem":1},{"text":"ndidzasonkhanitsa pamodzi anthu ochotsedwa","poem":2},{"lineBreak":true},{"text":"ndiponso amene ndinawalanga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anthu olumalawo ndidzawasandutsa anthu anga otsala.","poem":1},{"text":"Anthu amene ndinawachotsa ndidzawasandutsa mtundu wamphamvu.","poem":2},{"text":"Yehova adzawalamulira mʼPhiri la Yehova","poem":1},{"text":"kuyambira tsiku limenelo mpaka muyaya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kunena za iwe, nsanja ya ziweto zanga,","poem":1},{"text":"iwe linga la mwana wamkazi wa Ziyoni,","poem":2},{"text":"ulamuliro wako wakale udzabwezeretsedwa kwa iwe;","poem":1},{"text":"ufumu udzabwera pa mwana wamkazi wa Yerusalemu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Chifukwa chiyani tsopano ukulira mofuwula,","poem":1},{"text":"kodi ulibe mfumu?","poem":2},{"text":"Kodi phungu wako wawonongedwa,","poem":1},{"text":"kotero kuti ululu wako uli ngati wa mayi amene akubereka?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gubuduka ndi ululu, iwe mwana wamkazi wa Ziyoni,","poem":1},{"text":"ngati mayi pa nthawi yake yobereka,","poem":2},{"text":"pakuti tsopano muyenera kuchoka mu mzinda","poem":1},{"text":"ndi kugona kunja kwa mzindawo.","poem":2},{"text":"Udzapita ku Babuloni;","poem":1},{"text":"kumeneko udzapulumutsidwa,","poem":2},{"text":"kumeneko Yehova adzakuwombola","poem":1},{"text":"mʼmanja mwa adani ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Koma tsopano mitundu yambiri ya anthu","poem":1},{"text":"yasonkhana kulimbana nawe.","poem":2},{"text":"Iwo akuti, “Tiyeni timudetse,","poem":1},{"text":"maso athu aone chiwonongeko cha Ziyoni!”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Koma iwo sakudziwa","poem":1},{"text":"maganizo a Yehova;","poem":2},{"text":"iwo sakuzindikira cholinga chake,","poem":1},{"text":"Iye amene amawatuta ngati mitolo ya tirigu ku malo opunthira tirigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Imirira, puntha, iwe mwana wamkazi wa Ziyoni,","poem":1},{"text":"pakuti ndidzakupatsa nyanga zachitsulo;","poem":2},{"text":"ndidzakupatsa ziboda zamkuwa","poem":1},{"text":"ndipo udzaphwanya mitundu yambiri ya anthu.”","poem":2},{"lineBreak":true},{"text":"Phindu lawo lolipeza molakwikalo udzalipereka kwa Yehova,","poem":1},{"text":"chuma chawo kwa Yehova wa dziko lonse lapansi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}