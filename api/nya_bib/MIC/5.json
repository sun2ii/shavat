{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"MIC","translationId":"nya_bib","name":"MIKA","commonName":"MIKA","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3c35af5bcbc3599fe90ee908a691ec7bf25ac1ace5cfe51edab2f8f9c76c1c9c","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/nya_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Wolamulira Wochokera ku Betelehemu"]},{"type":"verse","number":1,"content":[{"text":"Iwe mzinda wa anthu ankhondo, sonkhanitsa anthu ako ankhondo,","poem":1},{"text":"pakuti anthu atizungulira kuti alimbane nafe.","poem":2},{"text":"Adzakantha ndi ndodo pa chibwano","poem":1},{"text":"cha wolamulira wa Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Koma iwe Betelehemu Efurata,","poem":1},{"text":"ngakhale uli wonyozeka pakati pa mafuko a Yuda,","poem":2},{"text":"mwa iwe mudzatuluka","poem":1},{"text":"munthu amene adzalamulira Israeli,","poem":2},{"text":"amene chiyambi chake nʼchakalekale,","poem":1},{"text":"nʼchamasiku amakedzana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nʼchifukwa chake Israeli adzasiyidwa","poem":1},{"text":"mpaka pa nthawi imene mayi amene ali woyembekezera adzachire.","poem":2},{"text":"Ndipo abale ake onse otsalira adzabwerera","poem":1},{"text":"kudzakhala pamodzi ndi Aisraeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iye adzalimbika, ndipo adzaweta nkhosa zake","poem":1},{"text":"mwa mphamvu ya Yehova,","poem":2},{"lineBreak":true},{"text":"mu ulemerero wa dzina la Yehova Mulungu wake.","poem":2},{"text":"Ndipo iwo adzakhala mu mtendere,","poem":1},{"text":"pakuti ukulu wake udzakhala ponseponse pa dziko lapansi.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndipo Iye adzakhala mtendere wawo.","poem":2},"Chipulumutso ndi Chiwonongeko",{"text":"Asiriya akadzalowa mʼdziko lathu","poem":1},{"text":"ndi kuyamba kuthira nkhondo malo athu otetezedwa,","poem":2},{"text":"tidzawadzutsira abusa asanu ndi awiri,","poem":1},{"text":"ngakhalenso atsogoleri asanu ndi atatu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iwo adzagonjetsa dziko la Asiriya ndi lupanga,","poem":1},{"text":"dziko la Nimurodi adzalilamulira mwankhondo.","poem":2},{"text":"Adzatipulumutsa kwa Asiriya","poem":1},{"text":"akadzafika mʼmalire a mʼdziko lathu","poem":2},{"lineBreak":true},{"text":"kudzatithira nkhondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Otsalira a Yakobo adzakhala","poem":1},{"text":"pakati pa mitundu yambiri ya anthu","poem":2},{"text":"ngati mame ochokera kwa Yehova,","poem":1},{"text":"ngati mvumbi pa udzu,","poem":2},{"text":"omwe sulamulidwa ndi munthu","poem":1},{"text":"kapena kudikira lamulo la anthu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Otsala a Yakobo adzakhala pakati pa mitundu ya anthu,","poem":1},{"text":"mʼgulu la anthu a mitundu yambiri,","poem":2},{"text":"ngati mkango pakati pa nyama za mʼnkhalango.","poem":1},{"text":"Ngati mwana wa mkango pakati pa gulu la nkhosa,","poem":2},{"text":"amene pozidutsa amazidya ndi kuzikhadzula,","poem":1},{"text":"ndipo palibe angathe kuzilanditsa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mudzagonjetsa adani anu,","poem":1},{"text":"ndipo adani anu onse adzawonongeka.","poem":2}]},{"type":"verse","number":10,"content":["Yehova akuti,",{"text":"“Tsiku limenelo ndidzawononga akavalo anu onse","poem":1},{"text":"ndi kuphwasula magaleta anu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndidzawononga mizinda ya mʼdziko mwanu","poem":1},{"text":"ndi kugwetsa malinga anu onse.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndidzawononga ufiti wanu","poem":1},{"text":"ndipo sikudzakhalanso anthu owombeza mawula.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndidzawononga mafano anu osema","poem":1},{"text":"pamodzi ndi miyala yanu yopatulika imene ili pakati panu;","poem":2},{"text":"simudzagwadiranso zinthu zopanga","poem":1},{"text":"ndi manja anu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndidzazula mitengo ya mafano a Asera imene ili pakati panu,","poem":1},{"text":"ndipo ndidzawononga mizinda yanu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndidzayilanga mwaukali ndi mokwiya","poem":1},{"text":"mitundu imene sinandimvere Ine.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}