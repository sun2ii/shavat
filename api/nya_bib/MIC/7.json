{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"MIC","translationId":"nya_bib","name":"MIKA","commonName":"MIKA","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3c35af5bcbc3599fe90ee908a691ec7bf25ac1ace5cfe51edab2f8f9c76c1c9c","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/nya_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Chipsinjo cha Israeli"]},{"type":"verse","number":1,"content":[{"text":"Tsoka ine!","poem":1},{"lineBreak":true},{"text":"Ndili ngati munthu wokunkha zipatso nthawi yachilimwe,","poem":1},{"text":"pa nthawi yokolola mphesa;","poem":2},{"text":"palibe phava lamphesa loti nʼkudya,","poem":1},{"text":"palibe nkhuyu zoyambirira zimene ndimazilakalaka kwambiri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anthu opembedza atha mʼdziko;","poem":1},{"text":"palibe wolungama ndi mmodzi yemwe amene watsala.","poem":2},{"text":"Anthu onse akubisalirana kuti aphane;","poem":1},{"text":"aliyense akusaka mʼbale wake ndi khoka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Manja awo onse ndi aluso pochita zoyipa;","poem":1},{"text":"wolamulira amafuna mphatso,","poem":2},{"text":"woweruza amalandira ziphuphu,","poem":1},{"text":"anthu amphamvu amalamula kuti zichitike zimene akuzifuna,","poem":2},{"lineBreak":true},{"text":"onse amagwirizana zochita.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Munthu wabwino kwambiri pakati pawo ali ngati mtengo waminga,","poem":1},{"text":"munthu wolungama kwambiri pakati pawo ndi woyipa kuposa mpanda waminga.","poem":2},{"text":"Tsiku limene alonda ako ananena lafika,","poem":1},{"text":"tsiku limene Mulungu akukuchezera.","poem":2},{"lineBreak":true},{"text":"Tsopano ndi nthawi ya chisokonezo chawo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Usadalire mnansi;","poem":1},{"text":"usakhulupirire bwenzi.","poem":2},{"text":"Usamale zoyankhula zako","poem":1},{"text":"ngakhale kwa mkazi amene wamukumbatira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pakuti mwana wamwamuna akunyoza abambo ake,","poem":1},{"text":"mwana wamkazi akuwukira amayi ake,","poem":2},{"text":"mtengwa akukangana ndi apongozi ake,","poem":1},{"text":"adani a munthu ndi amene amakhala nawo mʼbanja mwake momwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Koma ine ndikudikira Yehova mwachiyembekezo,","poem":1},{"text":"ndikudikira Mulungu Mpulumutsi wanga;","poem":2},{"lineBreak":true},{"text":"Mulungu wanga adzamvetsera.","poem":2}]},{"type":"heading","content":["Kuuka kwa Israeli"]},{"type":"verse","number":8,"content":[{"text":"Iwe mdani wanga, usandiseke!","poem":1},{"text":"Ngakhale ndagwa, ndidzauka.","poem":2},{"text":"Ngakhale ndikukhala mu mdima,","poem":1},{"text":"Yehova ndiye kuwunika kwanga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndidzapirira mkwiyo wa Yehova,","poem":1},{"text":"chifukwa ndinamuchimwira,","poem":2},{"text":"mpaka ataweruza mlandu wanga","poem":1},{"text":"ndi kukhazikitsa chilungamo changa.","poem":2},{"text":"Iye adzanditulutsa ndi kundilowetsa mʼkuwunika;","poem":1},{"text":"ndidzaona chilungamo chake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndipo mdani wanga adzaona zimenezi","poem":1},{"text":"nadzagwidwa ndi manyazi,","poem":2},{"text":"iye amene anandifunsa kuti,","poem":1},{"text":"“Ali kuti Yehova Mulungu wako?”","poem":2},{"text":"Ndidzaona kugonjetsedwa kwake ndi maso anga;","poem":1},{"text":"ngakhale tsopano adzaponderezedwa","poem":2},{"lineBreak":true},{"text":"ngati matope mʼmisewu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Idzafika nthawi yomanganso makoma anu,","poem":1},{"text":"nthawi yokulitsanso malire anu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nthawi imeneyo anthu adzabwera kwa inu","poem":1},{"text":"kuchokera ku Asiriya ndi mizinda ya ku Igupto,","poem":2},{"text":"ngakhale kuchokera ku Igupto mpaka ku Yufurate","poem":1},{"text":"ndiponso kuchokera ku nyanja ina mpaka ku nyanja inanso","poem":2},{"lineBreak":true},{"text":"kuchokera ku phiri lina mpaka ku phiri linanso.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dziko lapansi lidzasanduka chipululu","poem":1},{"text":"chifukwa cha anthu okhala mʼdzikomo, potsatira zochita za anthuwo.","poem":2}]},{"type":"heading","content":["Pemphero ndi Matamando"]},{"type":"verse","number":14,"content":[{"text":"Wetani anthu anu ndi ndodo yanu yowateteza,","poem":1},{"text":"nkhosa zimene ndi cholowa chanu,","poem":2},{"text":"zimene zili zokha mʼnkhalango,","poem":1},{"text":"mʼdziko la chonde.","poem":2},{"text":"Muzilole kuti zidye mu Basani ndi mu Giliyadi","poem":1},{"text":"monga masiku akale.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ndidzawaonetsa zodabwitsa zanga,","poem":1},{"text":"ngati masiku amene ndinawatulutsa mʼdziko la Igupto.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mitundu ya anthu idzaona zimenezi ndipo idzachita manyazi,","poem":1},{"text":"ngakhale ali ndi mphamvu zotani.","poem":2},{"text":"Adzagwira pakamwa pawo","poem":1},{"text":"ndipo makutu awo adzagontha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Adzabwira fumbi ngati njoka,","poem":1},{"text":"ngati zolengedwa zomwe zimakwawa pansi.","poem":2},{"text":"Adzabwera akunjenjemera kuchokera mʼmaenje awo;","poem":1},{"text":"mwamantha adzatembenukira kwa Yehova Mulungu wathu","poem":2},{"lineBreak":true},{"text":"ndipo adzachita nanu mantha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kodi alipo Mulungu wofanana nanu,","poem":1},{"text":"amene amakhululukira tchimo ndi kuyiwala zolakwa","poem":2},{"lineBreak":true},{"text":"za anthu otsala amene ndi cholowa chake?","poem":2},{"text":"Inu simusunga mkwiyo mpaka muyaya","poem":1},{"text":"koma kwanu nʼkuonetsa chikondi chosasinthika.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Inu mudzatichitiranso chifundo;","poem":1},{"text":"mudzapondereza pansi machimo athu","poem":2},{"lineBreak":true},{"text":"ndi kuponyera zolakwa zathu zonse pansi pa nyanja.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mudzakhala wokhulupirika kwa Yakobo,","poem":1},{"text":"ndi kuonetsa chifundo chanu kwa Abrahamu,","poem":2},{"text":"monga munalonjeza molumbira kwa makolo athu","poem":1},{"text":"masiku amakedzana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}