{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"NAM","translationId":"nya_bib","name":"NAHUMU","commonName":"NAHUMU","title":"Nahumu","order":34,"numberOfChapters":3,"sha256":"b7346ab2149bf567994cf2f04619e46d9b5ca33e903ba4e31142d54e43ffe8da","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Uthenga wonena za Ninive. Buku la masomphenya a Nahumu wa ku Elikosi."]},{"type":"heading","content":["Mkwiyo wa Yehova pa Ninive"]},{"type":"verse","number":2,"content":[{"text":"Yehova ndi Mulungu wansanje","poem":1},{"lineBreak":true},{"text":"ndiponso wobwezera;","poem":1},{"text":"Yehova amabwezera ndipo ndi waukali.","poem":2},{"text":"Yehova amabwezera adani ake","poem":1},{"text":"ndipo ukali wake umakhala nthawi zonse pa adani akewo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yehova sakwiya msanga koma ndi wa mphamvu yayikulu;","poem":1},{"text":"ndipo sadzalola kuti munthu","poem":2},{"lineBreak":true},{"text":"wolakwa asalangidwe.","poem":2},{"text":"Iye amayenda mʼkamvuluvulu ndi mʼnamondwe,","poem":1},{"text":"ndipo mitambo ndi fumbi la ku mapazi ake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amalamulira nyanja ndipo imawuma;","poem":1},{"lineBreak":true},{"text":"amawumitsa mitsinje yonse.","poem":1},{"lineBreak":true},{"text":"Zomera za ku Basani ndi Karimeli zimawuma","poem":1},{"text":"ndipo maluwa a ku Lebanoni amafota.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mapiri amagwedera pamaso pake","poem":1},{"lineBreak":true},{"text":"ndipo zitunda zimasungunuka.","poem":1},{"lineBreak":true},{"text":"Dziko lapansi limanjenjemera pamaso pake,","poem":1},{"text":"dziko lonse ndi zonse zokhala mʼmenemo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndani angathe kuyima pamaso pake Iye akalusa?","poem":1},{"text":"Ndani angapirire mkwiyo wake woopsa?","poem":2},{"text":"Ukali wake ukuyaka ngati moto;","poem":1},{"text":"matanthwe akunyeka pamaso pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yehova ndi wabwino,","poem":1},{"text":"ndiye kothawirako nthawi ya masautso.","poem":2},{"text":"Amasamalira amene amamudalira,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"koma ndi madzi achigumula choopsa","poem":1},{"lineBreak":true},{"text":"Iye adzawononga adani ake (Ninive);","poem":1},{"text":"adzapirikitsira adani ake ku malo a mdima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Chiwembu chilichonse chimene akukonzekera kumuchitira Yehova","poem":1},{"text":"adzachiwononga kotheratu;","poem":2},{"lineBreak":true},{"text":"msautso sudzabweranso kachiwiri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iwo adzakodwa mu ziyangoyango za minga","poem":1},{"text":"ndipo adzaledzera ndi vinyo wawo;","poem":2},{"lineBreak":true},{"text":"adzatenthedwa ngati ziputu zowuma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa iwe, Ninive, kunachokera munthu wa cholinga choyipa,","poem":1},{"text":"wofuna kuchitira Yehova chiwembu,","poem":2},{"lineBreak":true},{"text":"amene amapereka uphungu woyipa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yehova akuti,","poem":1},{"lineBreak":true},{"text":"“Ngakhale Asiriyawo ali ndi abwenzi,","poem":1},{"text":"kaya iwowo ndi ambiri,","poem":2},{"lineBreak":true},{"text":"koma adzawonongedwa ndi kutheratu.","poem":2},{"text":"Ngakhale ndinakuzunza iwe Yuda,","poem":1},{"text":"sindidzakuzunzanso.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tsopano ndidzathyola goli lake pa khosi lako","poem":1},{"text":"ndipo ndidzadula maunyolo ako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yehova walamulira za iwe, Ninive kuti,","poem":1},{"text":"“Sudzakhala ndi zidzukulu","poem":2},{"lineBreak":true},{"text":"zimene zidzadziwike ndi dzina lako.","poem":2},{"text":"Ndidzawononga zifanizo zosema ndi mafano owumba","poem":1},{"text":"amene ali mʼnyumba ya milungu yako.","poem":2},{"text":"Ine ndidzakukumbira manda","poem":1},{"text":"chifukwa ndiwe woyipitsitsa.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taonani, pa phiripo,","poem":1},{"text":"mapazi a munthu amene akubweretsa nkhani yabwino,","poem":2},{"lineBreak":true},{"text":"amene akulengeza za mtendere!","poem":2},{"text":"Inu anthu a ku Yuda, chitani madyerero anu","poem":1},{"text":"ndipo kwaniritsani malumbiro anu.","poem":2},{"text":"Anthu oyipa sadzakuthiraninso nkhondo;","poem":1},{"text":"iwo adzawonongedwa kotheratu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}