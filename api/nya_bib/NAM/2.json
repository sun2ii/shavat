{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"NAM","translationId":"nya_bib","name":"NAHUMU","commonName":"NAHUMU","title":"Nahumu","order":34,"numberOfChapters":3,"sha256":"b7346ab2149bf567994cf2f04619e46d9b5ca33e903ba4e31142d54e43ffe8da","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Kugwa kwa Ninive"]},{"type":"verse","number":1,"content":[{"text":"Wodzathira nkhondo akubwera","poem":1},{"text":"kudzalimbana nawe, Ninive.","poem":2},{"lineBreak":true},{"text":"Tetezani malinga anu,","poem":2},{"lineBreak":true},{"text":"dziyangʼanani ku msewu,","poem":2},{"lineBreak":true},{"text":"konzekerani nkhondo,","poem":2},{"lineBreak":true},{"text":"valani dzilimbe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yehova adzabwezeretsa ulemerero wa Yakobo","poem":1},{"text":"ngati ulemerero wa Israeli,","poem":2},{"text":"ngakhale anthu owononga anawawononga kotheratu","poem":1},{"text":"ndipo anawononganso mpesa wawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zishango za ankhondo ake ndi zofiira;","poem":1},{"text":"asilikali ake avala zovala zofiirira.","poem":2},{"text":"Zitsulo za pa magaleta zikunyezimira","poem":1},{"text":"tsiku la kukonzekera kwake.","poem":2},{"lineBreak":true},{"text":"Akuonetsa mikondo ya mkungudza yonoledwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Magaleta akuthamanga mʼmisewu","poem":1},{"text":"akungothamangathamanga pa mabwalo.","poem":2},{"text":"Akuoneka ngati miyuni yoyaka;","poem":1},{"text":"akuthamanga ngati chingʼaningʼani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iye akuyitanitsa asilikali ake wolemekezeka,","poem":1},{"text":"koma iwo akubwera napunthwa.","poem":2},{"text":"Akuthamangira ku linga la mzinda;","poem":1},{"text":"akuyimika chodzitchinjirizira pamalo pake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Atsekula zipata zotchinga madzi a mu mtsinje","poem":1},{"text":"ndipo nyumba yaufumu yagwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zatsimikizika kuti mzinda","poem":1},{"text":"utengedwa ndi kupita ku ukapolo.","poem":2},{"text":"Akapolo aakazi akulira ngati nkhunda","poem":1},{"text":"ndipo akudziguguda pachifuwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ninive ali ngati dziwe,","poem":1},{"text":"ndipo madzi ake akutayika.","poem":2},{"text":"Iwo akufuwula kuti, “Imani! Imani!”","poem":1},{"text":"Koma palibe amene akubwerera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Funkhani siliva!","poem":1},{"text":"Funkhani golide!","poem":2},{"text":"Katundu wake ndi wochuluka kwambiri,","poem":1},{"text":"chuma chochokera pa zinthu zake zamtengowapatali!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iye wawonongedwa, wafunkhidwa ndipo wavulidwa!","poem":1},{"text":"Mitima yasweka, mawondo akuwombana,","poem":2},{"lineBreak":true},{"text":"anthu akunjenjemera ndipo","poem":2},{"lineBreak":true},{"text":"nkhope zasandulika ndi mantha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kodi tsopano dzenje la mikango lili kuti,","poem":1},{"text":"malo amene mikango inkadyetserako ana ake,","poem":2},{"text":"kumene mkango waumuna ndi waukazi unkapitako,","poem":1},{"text":"ndipo ana a mkango sankaopa kanthu kalikonse?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mkango waumuna unkapha nyama yokwanira ana ake","poem":1},{"text":"ndiponso kuphera nyama mkango waukazi,","poem":2},{"text":"kudzaza phanga lake ndi zimene wapha","poem":1},{"text":"ndiponso dzenje lake ndi nyama imene waphayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yehova Wamphamvuzonse akuti,","poem":1},{"text":"“Ine ndikutsutsana nawe.","poem":2},{"text":"Ndidzatentha magaleta ako mpaka utsi tolotolo,","poem":1},{"text":"ndipo lupanga lidzapha mikango yako yayingʼono;","poem":2},{"text":"sindidzakusiyira chilichonse choti udye pa dziko lapansi.","poem":1},{"lineBreak":true},{"text":"Mawu a amithenga anu sadzamvekanso.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}