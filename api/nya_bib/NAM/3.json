{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"NAM","translationId":"nya_bib","name":"NAHUMU","commonName":"NAHUMU","title":"Nahumu","order":34,"numberOfChapters":3,"sha256":"b7346ab2149bf567994cf2f04619e46d9b5ca33e903ba4e31142d54e43ffe8da","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Tsoka la Ninive"]},{"type":"verse","number":1,"content":[{"text":"Tsoka kwa mzinda wopha anthu,","poem":1},{"text":"mzinda wodzaza ndi mabodza,","poem":2},{"text":"mzinda wodzaza ndi anthu olanda zinthu anzawo,","poem":1},{"text":"mu mzinda mʼmene simusowa anthu osautsidwa nthawi zonse!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kulira kwa zikwapu,","poem":1},{"text":"mkokomo wa mikombero,","poem":2},{"text":"kufuwula kwa akavalo","poem":1},{"text":"ndiponso phokoso la magaleta!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kuthamanga kwa anthu okwera pa akavalo,","poem":1},{"text":"kungʼanima kwa malupanga","poem":2},{"lineBreak":true},{"text":"ndi kunyezimira kwa mikondo!","poem":2},{"text":"Anthu ambiri ophedwa,","poem":1},{"text":"milumilu ya anthu akufa,","poem":2},{"text":"mitembo yosawerengeka,","poem":1},{"text":"anthu akupunthwa pa mitemboyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zonsezi ndi chifukwa cha zilakolako za mkazi wachiwerewere,","poem":1},{"text":"wokopa anthu uja, mkazi wochita zamatsenga,","poem":2},{"text":"amene anakopa mitundu ya anthu ndi zachiwerewere zake,","poem":1},{"text":"ndiponso anthu a mitundu ina ndi zaufiti zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yehova Wamphamvuzonse akuti,","poem":1},{"lineBreak":true},{"text":"“Ine ndikutsutsana nawe.","poem":1},{"text":"Ndidzakuvula chovala chako.","poem":2},{"text":"Anthu a mitundu ina ndidzawaonetsa umaliseche wako","poem":1},{"text":"ndipo udzachita manyazi pamaso pa maufumu onse.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndidzakuthira zonyansa,","poem":1},{"text":"ndidzakuchititsa manyazi","poem":2},{"lineBreak":true},{"text":"ndiponso kukusandutsa chinthu choseketsa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onse amene adzakuona adzakuthawa ndipo adzati,","poem":1},{"text":"‘Ninive wasanduka bwinja,","poem":2},{"lineBreak":true},{"text":"adzamulira ndani?’","poem":2},{"text":"Kodi ndingamupeze kuti munthu woti nʼkukutonthoza?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kodi ndiwe wopambana Tebesi,","poem":1},{"text":"mzinda wokhala mʼmbali mwa Nailo,","poem":2},{"lineBreak":true},{"text":"wozunguliridwa ndi madzi?","poem":2},{"text":"Mtsinjewo unali chitetezo chake,","poem":1},{"text":"madziwo anali linga lake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mphamvu zake zinali Kusi ndi Igupto,","poem":1},{"text":"Puti ndi Libiya anali ena mwa abwenzi ake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Komabe anthu a ku Tebesi anagwidwa","poem":1},{"text":"ndipo anapita ku ukapolo.","poem":2},{"text":"Ana ake anawaphwanyitsa pansi","poem":1},{"text":"mʼmisewu yonse ya mu mzindamo.","poem":2},{"text":"Anachita maere ogawana anthu ake otchuka,","poem":1},{"text":"ndipo anthu ake onse amphamvu","poem":2},{"lineBreak":true},{"text":"anamangidwa ndi maunyolo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iwenso Ninive udzaledzera;","poem":1},{"text":"udzabisala","poem":2},{"lineBreak":true},{"text":"ndipo udzafunafuna malo othawirako kuopa mdani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Malo ako onse otetezedwa ali ngati mitengo ya mkuyu","poem":1},{"text":"yokhala ndi zipatso zoyambirira kucha;","poem":2},{"lineBreak":true},{"text":"pamene agwedeza mitengoyo,","poem":2},{"lineBreak":true},{"text":"nkhuyuzo zimagwera mʼkamwa mwa wofuna kuzidya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tayangʼana ankhondo ako,","poem":1},{"text":"onse ali ngati akazi!","poem":2},{"text":"Zipata za dziko lako zatsekukira adani ako;","poem":1},{"text":"moto wapsereza mipiringidzo yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tungani madzi woti mudzamwe nthawi ya kuzunguliridwa kwanu,","poem":1},{"text":"limbitsani chitetezo chanu!","poem":2},{"text":"Pondani dothi,","poem":1},{"text":"ikani mʼchikombole,","poem":2},{"lineBreak":true},{"text":"konzani khoma la njerwa!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kumeneko moto udzakupserezani;","poem":1},{"text":"lupanga lidzakukanthani","poem":2},{"lineBreak":true},{"text":"ndipo lidzakuwonongani ngati likuwononga ziwala.","poem":2},{"text":"Chulukanani ngati ziwala,","poem":1},{"text":"chulukanani ngati dzombe!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mwachulukitsa chiwerengero cha anthu a malonda anu","poem":1},{"text":"mpaka kupambana nyenyezi za mlengalenga,","poem":2},{"text":"koma iwo ngati dzombe akuwononga dziko","poem":1},{"text":"ndipo kenaka akuwuluka nʼkuchoka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akalonga ako ali ngati dzombe,","poem":1},{"text":"akuluakulu ako ali ngati gulu la dzombe","poem":2},{"lineBreak":true},{"text":"limene lamatirira pa khoma nthawi yozizira,","poem":2},{"text":"koma pamene dzuwa latuluka limawuluka,","poem":1},{"text":"ndipo palibe amene amadziwa komwe lapita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Iwe mfumu ya ku Asiriya,","poem":1},{"text":"abusa ako agona tulo;","poem":2},{"lineBreak":true},{"text":"anthu ako olemekezeka amwalira.","poem":2},{"text":"Anthu ako amwazikira ku mapiri","poem":1},{"text":"popanda ndi mmodzi yemwe wowasonkhanitsa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Palibe chimene chingachize bala lako;","poem":1},{"text":"chilonda chako sichingapole.","poem":2},{"text":"Aliyense amene amamva za iwe","poem":1},{"text":"amawomba mʼmanja chifukwa cha kugwa kwako,","poem":2},{"text":"kodi alipo amene sanazilawepo","poem":1},{"text":"nkhanza zako zosatha?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}