{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"OBA","translationId":"nya_bib","name":"OBADIYA","commonName":"OBADIYA","title":"Obadiya","order":31,"numberOfChapters":1,"sha256":"fcb727998ee9960a5dfc3e4d0434daa110ac69dc1e51b777c726039dc9c507ad","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/nya_bib/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"heading","content":["Masomphenya a Obadiya"]},{"type":"verse","number":1,"content":["Masomphenya a Obadiya.",{"lineBreak":true},"Ambuye Yehova akunena kwa Edomu kuti,",{"text":"Tamva uthenga wochokera kwa Yehova:","poem":1},{"text":"Nthumwi yatumidwa kupita kwa anthu a mitundu kukanena kuti,","poem":2},{"text":"“Konzekani, tiyeni tikachite nkhondo ndi Edomu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Taona, ndidzakuchepetsani pakati pa anthu a mitundu ina;","poem":1},{"text":"udzanyozedwa kwambiri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kudzikuza kwa mtima wako kwakusocheretsa,","poem":1},{"text":"iwe amene umakhala mʼmapanga a mʼmatanthwe","poem":2},{"lineBreak":true},{"text":"ndipo umamanga nyumba zako pa mapiri ataliatali,","poem":2},{"text":"iwe amene umanena mu mtima mwako kuti,","poem":1},{"text":"‘Ndani anganditsitse pansi?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Koma ngakhale umawuluka ngati chiwombankhanga","poem":1},{"text":"ndi kumanga chisa chako pakati pa nyenyezi,","poem":2},{"lineBreak":true},{"text":"ndidzakutsitsa pansi kuchokera kumeneko,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"“Anthu akuba akanabwera kwa iwe,","poem":1},{"text":"kapena anthu olanda zinthu akanafika usiku,","poem":2},{"text":"aa, tsoka lanji limene likukudikira iwe!","poem":1},{"text":"Kodi akanangotengako zimene akuzifuna zokha?","poem":2},{"text":"Ngati anthu othyola mphesa akanafika,","poem":1},{"text":"kodi akanakusiyiraniko mphesa pangʼono pokha?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Koma Esau adzalandidwa zinthu zonse,","poem":1},{"text":"chuma chake chobisika chidzabedwa!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anthu onse ogwirizana nawo adzakupirikitsira kumalire;","poem":1},{"text":"abwenzi ako adzakunyenga ndi kukugonjetsa;","poem":2},{"text":"amene amadya chakudya chako adzakutchera msampha,","poem":1},{"text":"koma iwe sudzazindikira zimenezi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yehova akunena kuti, “Tsiku limenelo,","poem":1},{"text":"kodi sindidzawononga anthu onse anzeru a ku Edomu,","poem":2},{"lineBreak":true},{"text":"anthu odziwa zinthu mʼmapiri a Esau?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ankhondo ako, iwe Temani, adzachita mantha,","poem":1},{"text":"ndipo aliyense amene ali mʼphiri la Esau","poem":2},{"lineBreak":true},{"text":"adzaphedwa pa nkhondo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Chifukwa cha nkhanza zimene unachitira mʼbale wako Yakobo,","poem":1},{"text":"udzakhala wamanyazi;","poem":2},{"lineBreak":true},{"text":"adzakuwononga mpaka muyaya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pamene adani","poem":1},{"text":"ankamulanda chuma chake","poem":2},{"text":"pamene alendo analowa pa zipata zake","poem":1},{"text":"ndi kuchita maere pa Yerusalemu,","poem":2},{"lineBreak":true},{"text":"pa tsikulo iwe unali ngati mmodzi wa iwo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iwe sunayenera kunyoza mʼbale wako","poem":1},{"text":"pa nthawi ya tsoka lake,","poem":2},{"text":"kapena kunyogodola Ayuda","poem":1},{"text":"chifukwa cha chiwonongeko chawo,","poem":2},{"text":"kapena kuwaseka pa nthawi ya","poem":1},{"text":"mavuto awo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iwe sunayenera kudutsa pa zipata za anthu anga","poem":1},{"text":"pa nthawi ya masautso awo,","poem":2},{"text":"kapena kuwanyogodola","poem":1},{"text":"pa tsiku la tsoka lawo,","poem":2},{"text":"kapena kulanda chuma chawo","poem":1},{"text":"pa nthawi ya masautso awo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sunayenera kudikirira pamphambano ya misewu","poem":1},{"text":"kuti uphe Ayuda othawa,","poem":2},{"text":"kapena kuwapereka kwa adani awo Ayuda opulumuka","poem":1},{"text":"pa nthawi ya mavuto awo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Tsiku la Yehova layandikira","poem":1},{"text":"limene adzaweruza mitundu yonse ya anthu.","poem":2},{"text":"Adzakuchitira zomwe unawachitira ena;","poem":1},{"text":"zochita zako zidzakubwerera wekha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iwe unamwa pa phiri langa loyera,","poem":1},{"text":"koteronso mitundu ina yonse idzamwa kosalekeza;","poem":2},{"text":"iwo adzamwa ndi kudzandira","poem":1},{"text":"ndipo adzayiwalika pa mbiri ya dziko lapansi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Koma pa Phiri la Ziyoni padzakhala chipulumutso;","poem":1},{"text":"phirilo lidzakhala lopatulika,","poem":2},{"text":"ndipo nyumba ya Yakobo","poem":1},{"text":"idzalandira cholowa chake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nyumba ya Yakobo idzasanduka moto","poem":1},{"text":"ndipo nyumba ya Yosefe idzasanduka lawi la moto;","poem":2},{"text":"nyumba ya Esau idzasanduka chiputu,","poem":1},{"text":"ndipo adzayitenthe pa moto ndi kuyipsereza.","poem":2},{"text":"Sipadzakhala anthu opulumuka","poem":1},{"text":"kuchokera mʼnyumba ya Esau.”","poem":2},{"text":"Yehova wayankhula.","poem":4}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Anthu ochokera ku Negevi adzakhala","poem":1},{"text":"ku mapiri a Esau,","poem":2},{"text":"ndipo anthu ochokera mʼmbali mwa mapiri","poem":1},{"text":"adzatenga dziko la Afilisti.","poem":2},{"text":"Adzakhala mʼminda ya Efereimu ndi Samariya,","poem":1},{"text":"ndipo Benjamini adzatenga Giliyadi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Aisraeli amene ali ku ukapolo","poem":1},{"text":"adzalandira dziko la Kanaani mpaka ku Zarefati;","poem":2},{"text":"a ku Yerusalemu amene ali ku ukapolo ku Sefaradi","poem":1},{"text":"adzalandira mizinda ya ku Negevi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Opulumukawo adzapita ku Phiri la Ziyoni","poem":1},{"text":"ndipo adzalamulira mapiri a Esau.","poem":2},{"lineBreak":true},{"text":"Koma ufumuwo udzakhala wa Yehova.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}