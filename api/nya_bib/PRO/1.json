{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PRO","translationId":"nya_bib","name":"MIYAMBO","commonName":"MIYAMBO","title":"Miyambo","order":20,"numberOfChapters":31,"sha256":"10cfb808d30948338f33000f704c6bc5047ed093fa5bb681caa113ec68b98373","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nya_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"heading","content":["Mawu Oyamba: Cholinga ndi Mutu"]},{"type":"verse","number":1,"content":["Iyi ndi miyambi ya Solomoni mwana wa Davide, mfumu ya Israeli:"]},{"type":"verse","number":2,"content":[{"text":"Ndi yothandiza kuti munthu adziwe nzeru ndi malangizo;","poem":1},{"text":"kuti amvetse mawu a matanthauzo ozama;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kuti alandire malangizo othandiza kuti achite zinthu mwanzeru,","poem":1},{"text":"akhale wangwiro, wachilungamo ndiponso wosakondera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndi yothandiza munthu wamba kuti aphunzire nzeru za kuchenjera,","poem":1},{"text":"achinyamata kudziwa zinthu bwino ndi kulingalira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Munthu wanzeru amvetse bwino miyamboyi kuti awonjezere kuphunzira kwake,","poem":1},{"text":"ndi munthu womvetsa zinthu bwino apatepo luso,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kuti azimvetsa miyambi ndi mafanizo,","poem":1},{"text":"mawu a anthu anzeru ndi mikuluwiko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kuopa Yehova ndiye chiyambi cha nzeru.","poem":1},{"text":"Zitsiru zimanyoza nzeru ndi malangizo.","poem":2}]},{"type":"heading","content":["Malangizo kuti Asunge Nzeru"]},{"type":"heading","content":["Malangizo kwa Achinyamata"]},{"type":"verse","number":8,"content":[{"text":"Mwana wanga, mvera malangizo a abambo ako","poem":1},{"text":"ndipo usakane mawu okuwongolera a amayi ako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ali ngati sangamutu yokongola ya maluwa pamutu pako","poem":1},{"text":"ndiponso ali ngati mkanda mʼkhosi mwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mwana wanga, ngati anthu oyipa afuna kukukopa","poem":1},{"text":"usamawamvere.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akadzati, “Tiye kuno;","poem":1},{"text":"tikabisale kuti tiphe anthu,","poem":2},{"lineBreak":true},{"text":"tikabisalire anthu osalakwa;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"tiwameze amoyo ngati manda,","poem":1},{"text":"ndi athunthu ngati anthu otsikira mʼdzenje.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Motero tidzapeza zinthu zosiyanasiyana zamtengowapatali","poem":1},{"text":"ndi kudzaza nyumba zathu ndi zolanda;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bwera, chita nafe maere,","poem":1},{"text":"ndipo tidzagawana chuma chathu tonse.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mwana wanga, usayende nawo pamodzi,","poem":1},{"text":"usatsagane nawo mʼnjira zawozo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iwowatu amangofuna zoyipa zokhazokha,","poem":1},{"text":"amathamangira kukhetsa magazi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nʼkopanda phindu kutchera msampha","poem":1},{"text":"mbalame zikuona!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Koma anthu amenewa amangobisalira miyoyo yawo yomwe;","poem":1},{"text":"amangodzitchera okha msampha!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Awa ndiwo mathero a anthu opeza chuma mwankhanza;","poem":1},{"text":"chumacho chimapha mwiniwake.","poem":2}]},{"type":"heading","content":["Chenjezo Pomwe Tikana Nzeru"]},{"type":"verse","number":20,"content":[{"text":"Nzeru ikufuwula mu msewu,","poem":1},{"text":"ikuyankhula mokweza mawu mʼmisika;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ikufuwula pa mphambano ya misewu,","poem":1},{"text":"ikuyankhula pa zipata za mzinda kuti,","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Kodi inu anthu osachangamukanu, mudzakondwera ndi kusachangamuka mpaka liti?","poem":1},{"text":"Nanga anthu onyogodola adzakondabe kunyogodola mpaka liti?","poem":2},{"lineBreak":true},{"text":"Kapena opusa adzadana ndi nzeru mpaka liti?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tamverani mawu anga a chidzudzulo.","poem":1},{"text":"Ine ndikukuwuzani maganizo anga","poem":2},{"lineBreak":true},{"text":"ndi kukudziwitsani mawu anga.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Popeza ndinakuyitanani koma inu munakana kumvera.","poem":1},{"text":"Ndinayesa kukuthandizani koma panalibe amene anasamala.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Uphungu wanga munawunyoza.","poem":1},{"text":"Kudzudzula kwanga simunakusamale.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndiye inenso ndidzakusekani mukadzakhala mʼmavuto;","poem":1},{"text":"ndidzakunyogodolani chikadzakugwerani chimene mumachiopacho.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Chiwonongeko chikadzakugwerani ngati namondwe,","poem":1},{"text":"tsoka likadzakufikirani ngati kamvuluvulu,","poem":2},{"lineBreak":true},{"text":"mavuto ndi masautso akadzakugwerani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Tsono mudzandiyitana koma sindidzayankha;","poem":1},{"text":"mudzandifunafuna, koma simudzandipeza.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Popeza iwo anadana ndi chidziwitso","poem":1},{"text":"ndipo sanasankhe kuopa Yehova,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"popeza iwo sanasamale malangizo anga","poem":1},{"text":"ndipo ananyoza chidzudzulo changa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tsono adzadya zipatso zoyenera mayendedwe awo","poem":1},{"text":"ndi kukhuta ndi ntchito zimene anachita kwa ena.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Pakuti anthu osachangamuka amaphedwa chifukwa cha kusochera kwawo,","poem":1},{"text":"ndipo zitsiru zimadziwononga zokha chifukwa cha mphwayi zawo.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Koma aliyense wondimvera adzakhala mwa bata;","poem":1},{"text":"adzakhala mosatekeseka posaopa chilichonse.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}