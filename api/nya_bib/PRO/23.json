{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PRO","translationId":"nya_bib","name":"MIYAMBO","commonName":"MIYAMBO","title":"Miyambo","order":20,"numberOfChapters":31,"sha256":"10cfb808d30948338f33000f704c6bc5047ed093fa5bb681caa113ec68b98373","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nya_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Ngati ukhala pansi kuti udye pamodzi ndi wolamulira,","poem":1},{"text":"uyangʼane bwino zimene zili pamaso pako,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ngati ndiwe munthu wadyera","poem":1},{"text":"udziletse kuti usaonetse dyera lakolo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Usasirire zakudya zake,","poem":1},{"text":"pakuti zimenezo ndi zakudya zachinyengo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Usadzitopetse wekha ndi kufuna chuma,","poem":1},{"text":"ukhale ndi nzeru ya kudziretsa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ukangoti wachipeza chumacho uwona posachedwa kuti palibepo.","poem":1},{"text":"Chumacho chimachita ngati chamera mapiko mwadzidzidzi","poem":2},{"lineBreak":true},{"text":"ndi kuwuluka kunka kumwamba ngati chiwombankhanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Usadye chakudya cha munthu waumbombo,","poem":1},{"text":"usalakalake zakudya zake zokoma;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"paja iye ndi munthu amene","poem":1},{"text":"nthawi zonse amaganizira za mtengo wake","poem":2},{"text":"ngakhale amati kwa iwe, “Idya ndi kumwa,”","poem":1},{"text":"koma sakondweretsedwa nawe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Udzasanza zimene wadyazo","poem":1},{"text":"ndipo mawu ako woyamikira adzapita pachabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Usayankhule munthu wopusa akumva,","poem":1},{"text":"pakuti adzanyoza mawu ako anzeru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Usasunthe mwala wa mʼmalire akalekale","poem":1},{"text":"kapena kulowerera mʼminda ya ana amasiye,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"paja Mpulumutsi wawo ndi wamphamvu;","poem":1},{"text":"iye adzawateteza pa milandu yawo kutsutsana nawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mtima wako uzikhala pa malangizo","poem":1},{"text":"ndipo makutu ako azimvetsera mawu a chidziwitso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Usaleke kumulangiza mwana;","poem":1},{"text":"ngati umulanga ndi chikwapu sadzafa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ukamukwapula ndi tsatsa","poem":1},{"text":"udzapulumutsa moyo wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mwana wanga, ngati mtima wako ukhala wanzeru,","poem":1},{"text":"inenso mtima wanga udzakondwera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mtima wanga udzakondwera","poem":1},{"text":"pamene ndidzakumva ukuyankhula zolungama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mtima wako usachite nsanje ndi anthu ochimwa,","poem":1},{"text":"koma uziopa Yehova tsiku ndi tsiku.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndithu za mʼtsogolo zilipo","poem":1},{"text":"ndipo chiyembekezo chakocho sichidzalephereka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tamvera mwana wanga, ndipo ukhale wanzeru,","poem":1},{"text":"mtima wako uwuyendetse mʼnjira yabwino.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Usakhale pakati pa anthu amene amaledzera","poem":1},{"text":"kapena pakati pa anthu amene amadya nyama mwadyera.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Paja anthu oledzera ndi adyera amadzakhala amphawi","poem":1},{"text":"ndipo aulesi adzavala sanza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mvera abambo ako amene anakubala,","poem":1},{"text":"usanyoze amayi ako pamene akalamba.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gula choonadi ndipo usachigulitse;","poem":1},{"text":"ugulenso nzeru, mwambo ndiponso kumvetsa zinthu bwino.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abambo a munthu wolungama ali ndi chimwemwe chachikulu;","poem":1},{"text":"Wobala mwana wanzeru adzakondwera naye.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Abambo ndi amayi ako asangalale;","poem":1},{"text":"amene anakubereka akondwere!","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mwana wanga, undikhulupirire","poem":1},{"text":"ndipo maso ako apenyetsetse njira zanga.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Paja mkazi wachiwerewere ali ngati dzenje lozama;","poem":1},{"text":"ndipo mkazi woyendayenda ali ngati chitsime chopapatiza.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Amabisala ngati mbala yachifwamba,","poem":1},{"text":"ndipo amuna amakhala osakhulupirika chifukwa cha iyeyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ndani ali ndi tsoka? Ndani ali ndi chisoni?","poem":1},{"text":"Ndani ali pa mkangano? Ndani ali ndi madandawulo?","poem":2},{"lineBreak":true},{"text":"Ndani ali ndi zipsera zosadziwika uko zachokera? Ndani ali ndi maso ofiira?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ndi amene amakhalitsa pa mowa,","poem":1},{"text":"amene amapita nalawa vinyo osakanizidwa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Usatengeke mtima ndi kufiira kwa vinyo,","poem":1},{"text":"pamene akuwira mʼchikho","poem":2},{"lineBreak":true},{"text":"pamene akumweka bwino!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Potsiriza pake amaluma ngati njoka,","poem":1},{"text":"ndipo amajompha ngati mphiri.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Maso ako adzaona zinthu zachilendo","poem":1},{"text":"ndipo maganizo ndi mawu ako adzakhala osokonekera.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Udzakhala ngati munthu amene ali gone pakati pa nyanja,","poem":1},{"text":"kapena ngati munthu wogona pa msonga ya mlongoti ya ngalawa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Iwe udzanena kuti, “Anandimenya, koma sindinapwetekedwe!","poem":1},{"text":"Andimenya koma sindinamve kanthu!","poem":2},{"text":"Kodi ndidzuka nthawi yanji?","poem":1},{"text":"Ndiye ndifunefunenso vinyo wina.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}