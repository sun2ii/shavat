{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PRO","translationId":"nya_bib","name":"MIYAMBO","commonName":"MIYAMBO","title":"Miyambo","order":20,"numberOfChapters":31,"sha256":"10cfb808d30948338f33000f704c6bc5047ed093fa5bb681caa113ec68b98373","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nya_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Phindu Lina la Nzeru"]},{"type":"verse","number":1,"content":[{"text":"Mwana wanga, usayiwale malangizo anga,","poem":1},{"text":"mtima wako usunge malamulo anga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ukatero zaka za moyo wako zidzachuluka","poem":1},{"text":"ndipo udzakhala pa mtendere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Makhalidwe ochitira ena chifundo ndi owonetsa kukhulupirika asakuchokere.","poem":1},{"text":"Uwamangirire mʼkhosi mwako ngati mkanda","poem":2},{"lineBreak":true},{"text":"ndi kuwalemba pa mtima pako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ukatero udzapeza kuyanja ndi mbiri yabwino","poem":1},{"text":"pamaso pa Mulungu ndi anthu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Uzikhulupirira Yehova ndi mtima wako wonse","poem":1},{"text":"ndipo usadalire nzeru zako za kumvetsa zinthu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pa zochita zako zonse uvomereze kuti Mulungu alipo,","poem":1},{"text":"ndipo Iye adzawongola njira zako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Usamadzione ngati wa nzeru.","poem":1},{"text":"Uziopa Yehova ndi kupewa zoyipa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ukatero thupi lako lidzakhala la moyo wabwino","poem":1},{"text":"ndi mafupa ako adzakhala olimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uzilemekeza Yehova ndi chuma chako chonse;","poem":1},{"text":"zokolola zonse zoyamba kucha uzilemekeza nazonso Yehova.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ukatero nkhokwe zako zidzadzaza ndi zinthu zambiri,","poem":1},{"text":"ndiponso mitsuko yako idzadzaza ndi vinyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwana wanga usanyoze malangizo a Yehova,","poem":1},{"text":"ndipo usayipidwe ndi chidzudzulo chake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Paja Yehova amadzudzula amene amamukonda,","poem":1},{"text":"monga abambo achitira mwana amene amakondwera naye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wodala munthu amene wapeza nzeru,","poem":1},{"text":"munthu amene walandira nzeru zomvetsa zinthu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"pakuti phindu la nzeru ndi labwino kuposa la siliva,","poem":1},{"text":"phindu lakelo ndi labwino kuposanso golide.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nzeru ndi yoposa miyala yamtengowapatali;","poem":1},{"text":"ndipo zonse zimene umazikhumba sizingafanane ndi nzeru.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mʼdzanja lake lamanja muli moyo wautali;","poem":1},{"text":"mʼdzanja lake lamanzere muli chuma ndi ulemu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Njira zake ndi njira zosangalatsa,","poem":1},{"text":"ndipo mu njira zake zonse muli mtendere.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nzeru ili ngati mtengo wopatsa moyo kwa oyigwiritsitsa;","poem":1},{"text":"wodala munthu amene amayigwiritsa kwambiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yehova anakhazikitsa dziko lapansi pogwiritsa ntchito nzeru.","poem":1},{"text":"Anagwiritsanso ntchito nzeru zakudziwa bwino zinthu pamene ankakhazikitsa zakumwamba.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mwa nzeru zake Yehova anatumphutsa madzi kuchokera mʼnthaka","poem":1},{"text":"ndiponso mitambo inagwetsa mvula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mwana wanga usunge nzeru yeniyeni ndi khalidwe lomalingarira zinthu bwino.","poem":1},{"text":"Zimenezi zisakuchokere.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Zimenezi zidzakupatsa moyo,","poem":1},{"text":"moyo wake wosangalatsa ndi wabwino ngati mkanda wa mʼkhosi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Choncho udzayenda pa njira yako mosaopa kanthu,","poem":1},{"text":"ndipo phazi lako silidzapunthwa;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"pamene ugona pansi, sudzachita mantha;","poem":1},{"text":"ukadzagona pansi tulo tako tidzakhala tokoma.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Usaope tsoka lobwera mwadzidzidzi","poem":1},{"text":"kapena chiwonongeko chimene chidzagwera anthu oyipa,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"pakuti Yehova adzakulimbitsa mtima","poem":1},{"text":"ndipo adzasunga phazi lako kuti lisakodwe mu msampha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Usaleke kuchitira zabwino amene ayenera kulandira zabwino,","poem":1},{"text":"pamene uli nazo mphamvu zochitira zimenezi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Usanene kwa mnansi wako kuti,","poem":1},{"text":"“Pita, uchite kubweranso. Ndidzakupatsa mawa”","poem":2},{"lineBreak":true},{"text":"pamene uli nazo tsopano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Usamukonzere chiwembu mnansi wako,","poem":1},{"text":"amene anakhala nawe pafupi mokudalira.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Usakangane ndi munthu wopanda chifukwa","poem":1},{"text":"pamene iye sanakuchitire zoyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Usachite naye nsanje munthu wachiwawa","poem":1},{"text":"kapena kutsanzira khalidwe lake lililonse.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Pakuti Yehova amanyansidwa ndi munthu woyipa","poem":1},{"text":"koma amayanjana nawo anthu olungama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Yehova amatemberera nyumba ya munthu woyipa,","poem":1},{"text":"koma amadalitsa nyumba ya anthu olungama.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Anthu onyoza, Iye amawanyoza,","poem":1},{"text":"koma amakomera mtima anthu odzichepetsa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Anthu anzeru adzalandira ulemu,","poem":1},{"text":"koma zitsiru adzazichititsa manyazi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}