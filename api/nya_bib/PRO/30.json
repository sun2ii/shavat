{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PRO","translationId":"nya_bib","name":"MIYAMBO","commonName":"MIYAMBO","title":"Miyambo","order":20,"numberOfChapters":31,"sha256":"10cfb808d30948338f33000f704c6bc5047ed093fa5bb681caa113ec68b98373","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nya_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"heading","content":["Mawu a Aguri"]},{"type":"verse","number":1,"content":["Nawa mawu a Aguri mwana wa Yake wa ku Masa:",{"text":"Munthuyo anati kwa Itieli, “Inu Mulungu, ine ndatopa.","poem":1},{"text":"Inu Mulungu, ine ndatopa. Ndalefukiratu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Ine ndine munthu wopusa kuposa anthu onse;","poem":1},{"text":"ndilibe nzeru zomvetsa zinthu zonga za munthu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sindinaphunzire nzeru,","poem":1},{"text":"ndipo Woyerayo sindimudziwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kodi ndani anakwera kumwamba ndi kutsikako?","poem":1},{"text":"Ndani anafumbatapo mphepo mʼmanja mwake?","poem":2},{"text":"Ndani anamanga madzi mʼchovala chake?","poem":1},{"text":"Ndani anakhazikitsa mathero onse a dziko lapansi?","poem":2},{"text":"Dzina lake ndani? Ndiwuze ngati ukudziwa!","poem":1},{"text":"Ndipo mwana wake dzina lake ndani?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Mawu ali wonse a Mulungu ndi opanda cholakwika;","poem":1},{"text":"Iye ndi chishango kwa amene amathawira kwa Iye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Usawonjezepo kanthu pa mawu ake,","poem":1},{"text":"kuopa kuti Iye angadzakudzudzule ndi kukupeza kuti ndiwe wabodza.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Inu Yehova, ndikukupemphani zinthu ziwiri","poem":1},{"text":"musandimane zimenezo ndisanafe:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Choyamba, mundichotsere kutali nane mabodza ndi chinyengo.","poem":1},{"text":"Chachiwiri, ndisakhale mʼmphawi kapena munthu wachuma.","poem":2},{"lineBreak":true},{"text":"Koma muzindidyetsa chakudya chondikwanira tsiku ndi tsiku","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kuopa kuti ndikakhuta kwambiri ndingayambe kukukanani,","poem":1},{"text":"nʼkumanena kuti, ‘Yehova ndiye yaninso?’","poem":2},{"text":"Kuopanso kuti ndikakhala wosauka ndingayambe kuba,","poem":1},{"text":"potero nʼkuyipitsa dzina la Mulungu wanga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Usamusinjirire wantchito kwa mbuye wake","poem":1},{"text":"kuopa kuti angakutemberere ndipo iweyo nʼkupezeka wolakwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Alipo ena amene amatemberera abambo awo,","poem":1},{"text":"ndipo sadalitsa amayi awo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pali ena amene amadziyesa okha oyera mtima","poem":1},{"text":"komatu sanachotse zoyipa zawo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pali ena ndi odzitukumula kwambiri,","poem":1},{"text":"amene amakweza zikope modzitukumula.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pali ena amene mano awo ali ngati malupanga","poem":1},{"text":"ndipo zibwano zawo zili ngati mipeni","poem":2},{"text":"moti amadya amphawi ndi kuwachotsa pa dziko lapansi.","poem":1},{"text":"Amachotsanso anthu osauka pakati pa anzawo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Msundu uli ndi ana aakazi awiri","poem":1},{"text":"iwo amalira kuti, ‘Tipatseni! Tipatseni!’ ”","poem":2},{"lineBreak":true},{"text":"“Pali zinthu zitatu zimene sizikhuta,","poem":1},{"text":"zinthu zinayi zimene sizinena kuti, ‘Takhuta!’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Manda, mkazi wosabala,","poem":1},{"text":"nthaka yosakhuta madzi","poem":2},{"lineBreak":true},{"text":"ndiponso moto womangoyakirayakira!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Aliyense amene amanyoza abambo ake,","poem":1},{"text":"ndi kunyozera kumvera amayi ake,","poem":2},{"text":"makwangwala a ku chigwa adzamukolowola maso","poem":1},{"text":"ndipo mphungu zidzadya mnofu wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Pali zinthu zitatu zimene zimandidabwitsa,","poem":1},{"text":"zinthu zinayi zimene ine sindizimvetsetsa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndipo ndi izi: mmene chiwulukira chiwombankhanga mlengalenga;","poem":1},{"text":"mmene iyendera njoka pa thanthwe;","poem":2},{"text":"mmene chiyendera chombo pa nyanja;","poem":1},{"text":"ndiponso mmene mwamuna achitira akakhala ndi namwali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Umu ndi mʼmene mkazi amachitira atachita chigololo:","poem":1},{"text":"Atatha kudya ndi kupukuta pakamwa pake","poem":2},{"lineBreak":true},{"text":"iye amanena kuti “Sindinachite kalikonse kolakwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Pali zinthu zitatu zimene zimanjenjemeretsa dziko lapansi,","poem":1},{"text":"pali zinthu zinayi zimene dziko lapansi silingathe kuzipirira:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kapolo amene wasanduka mfumu,","poem":1},{"text":"chitsiru chimene chakhuta,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"mkazi wonyozeka akakwatiwa","poem":1},{"text":"ndiponso wantchito wamkazi akalanda mwamuna wa mbuye wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Pali zinthu zinayi zingʼonozingʼono pa dziko lapansi,","poem":1},{"text":"komatu ndi zochenjera kwambiri:","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nyerere zili ngati anthu opanda mphamvu,","poem":1},{"text":"komatu zimasungiratu chakudya chake nthawi ya chilimwe;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"mbira zili ngati anthu opanda mphamvu","poem":1},{"text":"komatu zimakonza pokhalapo pawo mʼmiyala;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"dzombe lilibe mfumu,","poem":1},{"text":"komatu lonse limakhala mʼmagulumagulu poyenda.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Buluzi ungathe kumugwira mʼmanja","poem":1},{"text":"komatu amapezeka mʼnyumba za mafumu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Pali zinthu zitatu zimene zimayenda chinyachinya,","poem":1},{"text":"pali zinthu zinayi zimene zimayenda monyadira:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mkango umene uli wamphamvu kuposa nyama zonse,","poem":1},{"text":"ndipo suthawa kanthu kalikonse.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tambala woyenda chinyachinya, mbuzi yayimuna,","poem":1},{"text":"ndiponso mfumu yoyenda pakati pa anthu ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Ngati wakhala ukupusa ndi kumadzikweza wekha,","poem":1},{"text":"kapena ngati wakhala ukukonzekera zoyipa,","poem":2},{"lineBreak":true},{"text":"ndiye khala kaye chete, uganizire bwino!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Paja pakutha mkaka mafuta amapangidwa,","poem":1},{"text":"ndipo ukapsinya mphuno, magazi amatuluka,","poem":2},{"lineBreak":true},{"text":"ndipo mikangano imakhalapo ukalimbikira kukwiya.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}