{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PRO","translationId":"nya_bib","name":"MIYAMBO","commonName":"MIYAMBO","title":"Miyambo","order":20,"numberOfChapters":31,"sha256":"10cfb808d30948338f33000f704c6bc5047ed093fa5bb681caa113ec68b98373","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nya_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Nzeru Iposa Zonse"]},{"type":"verse","number":1,"content":[{"text":"Ananu, mverani malangizo a abambo anu;","poem":1},{"text":"tcherani khutu kuti mupeze nzeru zodziwira zinthu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zimene ndikukuphunzitsani ndi zabwino.","poem":1},{"text":"Choncho musasiye malangizo anga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Paja ndinalinso mwana mʼnyumba mwa abambo anga;","poem":1},{"text":"mwana mmodzi yekha wapamtima pa amayi anga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndipo abambo anandiphunzitsa ndi mawu akuti,","poem":1},{"text":"“Ugwiritse mawu anga pa mtima pako,","poem":2},{"lineBreak":true},{"text":"usunge malamulo anga kuti ukhale ndi moyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Upeze nzeru, upeze nzeru zomvetsa zinthu;","poem":1},{"text":"usayiwale mawu anga kapena kutayana nawo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Usasiye nzeru ndipo idzakusunga.","poem":1},{"text":"Uziyikonda ndipo idzakuteteza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Fundo yayikulu pa za nzeru ndi iyi: upeze nzeru.","poem":1},{"text":"Kaya pali china chilichonse chimene ungapeze, koma upeze nzeru yomvetsa bwino zinthu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uyilemekeze nzeruyo ndipo idzakukweza;","poem":1},{"text":"ikumbatire nzeruyo ndipo idzakupatsa ulemu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Idzayika sangamutu yokongola yamaluwa pamutu pako;","poem":1},{"text":"idzakupatsa chipewa chaufumu chaulemu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mwana wanga, umvere ndi kuvomereza zimene ndikunena,","poem":1},{"text":"ndipo zaka za moyo wako zidzakhala zochuluka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndakuphunzitsa njira yake ya nzeru.","poem":1},{"text":"Ndakutsogolera mʼnjira zolungama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pamene ukuyenda, mapazi ako sadzawombana;","poem":1},{"text":"ukamadzathamanga, sudzapunthwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ugwiritse zimene ndikukuphunzitsazi osazitaya ayi.","poem":1},{"text":"Uwasamale bwino pakuti moyo wako wagona pamenepa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Usayende mʼnjira za anthu oyipa","poem":1},{"text":"kapena kuyenda mʼnjira ya anthu ochimwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pewa njira zawo, usayende mʼmenemo;","poem":1},{"text":"uzilambalala nʼkumangopita.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pakuti iwo sagona mpaka atachita zoyipa;","poem":1},{"text":"tulo salipeza mpaka atapunthwitsa munthu wina.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Paja chakudya chawo ndicho kuchita zoyipa basi","poem":1},{"text":"ndipo chakumwa chawo ndi chiwawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Koma njira ya anthu olungama ili ngati kuwala kwa mʼbandakucha","poem":1},{"text":"kumene kumanka kuwalirawalira mpaka dzuwa litafika pa mutu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Koma njira ya anthu oyipa ili ngati mdima wandiweyani;","poem":1},{"text":"iwo sadziwa chomwe chimawapunthwitsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mwana wanga, mvetsetsa zimene ndikunena;","poem":1},{"text":"tchera khutu ku mawu anga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Usayiwale malangizo angawa,","poem":1},{"text":"koma uwasunge mu mtima mwako.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Pakuti amapatsa moyo kwa aliyense amene awapeza","poem":1},{"text":"ndipo amachiritsa thupi lake lonse.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndipotu mtima wako uziwuyangʼanira bwino ndithu","poem":1},{"text":"pakuti ndiwo magwero a moyo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Usiyiretu kuyankhula zokhotakhota;","poem":1},{"text":"ndipo ulekeretu kuyankhula zinthu zonyansa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Maso ako ayangʼane patsogolo;","poem":1},{"text":"uziyangʼana kutsogolo molunjika.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Uzilingalira bwino kumene kupita mapazi ako","poem":1},{"text":"ndipo njira zako zonse zidzakhala zosakayikitsa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Usapatukire kumanja kapena kumanzere;","poem":1},{"text":"usapite kumene kuli zoyipa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}