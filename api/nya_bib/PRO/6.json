{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PRO","translationId":"nya_bib","name":"MIYAMBO","commonName":"MIYAMBO","title":"Miyambo","order":20,"numberOfChapters":31,"sha256":"10cfb808d30948338f33000f704c6bc5047ed093fa5bb681caa113ec68b98373","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nya_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Za Moyo wa Uchitsiru"]},{"type":"verse","number":1,"content":[{"text":"Mwana wanga, ngati wamuperekera mnansi wako chikole,","poem":1},{"text":"ngati walonjeza kumulipirira mlendo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ngati wagwidwa ndi zimene iwe unanena,","poem":1},{"text":"wakodwa ndi mawu a mʼkamwa mwako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tsono popeza iwe mwana wanga","poem":1},{"text":"wadziponya mʼmanja mwa mnansi wako, chita izi kuti udzipulumutse:","poem":2},{"text":"pita msanga ukamupemphe mnansi wako;","poem":1},{"text":"kuti akumasule!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Usagone tulo,","poem":1},{"text":"usawodzere.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dzipulumutse monga imachitira mphoyo mʼdzanja la mlenje,","poem":1},{"text":"ndi monga imachitira mbalame mu msampha wa munthu wosaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pita kwa nyerere, mlesi iwe;","poem":1},{"text":"kaonetsetse njira zake kuti uphunzirepo kanthu!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zilibe mfumu,","poem":1},{"text":"zilibe woyangʼanira kapena wolamulira,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"komabe zimasungiratu chakudya chake nthawi ya chilimwe","poem":1},{"text":"ndipo zimatuta chakudyacho nthawi yokolola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kodi uzingogonabe pamenepo mpaka liti mlesi iwe?","poem":1},{"text":"Kodi tulo tako tidzatha liti?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ukati ndingogona pangʼono, ndingowodzera pangʼono","poem":1},{"text":"ndingopinda manjawa pangʼono kuti ndipumule,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"umphawi udzakugwira ngati mbala","poem":1},{"text":"ndipo usiwa udzafika ngati munthu wachifwamba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Munthu wachabechabe, munthu woyipa,","poem":1},{"text":"amangoyendayenda ndi kumayankhula zoyipa,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"amatsinzinira maso ake,","poem":2},{"lineBreak":true},{"text":"namakwakwaza mapazi ake","poem":2},{"lineBreak":true},{"text":"ndi kulozaloza ndi zala zake,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"amalingalira zoyipa ndi mtima wake wachinyengo","poem":2},{"lineBreak":true},{"text":"ndipo nthawi zonse amangokhalira kuyambitsa mikangano pakati pa anthu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nʼchifukwa chake tsoka lidzamugwera modzidzimutsa;","poem":1},{"text":"adzawonongeka msangamsanga popanda chomupulumutsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Pali zinthu zisanu ndi chimodzi zimene Yehova amadana nazo,","poem":1},{"text":"zinthu zisanu ndi ziwiri zimene zimamunyansa:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"maso onyada,","poem":3},{"lineBreak":true},{"text":"pakamwa pabodza,","poem":3},{"lineBreak":true},{"text":"manja akupha munthu wosalakwa,","poem":3}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"mtima wokonzekera kuchita zoyipa,","poem":3},{"lineBreak":true},{"text":"mapazi othamangira msanga ku zoyipa,","poem":3}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"mboni yonama yoyankhula mabodza","poem":3},{"lineBreak":true},{"text":"komanso munthu amene amayambitsa mikangano pakati pa abale.","poem":3}]},{"type":"heading","content":["Chenjezo pa za Chigololo"]},{"type":"verse","number":20,"content":[{"text":"Mwana wanga, usunge malamulo a abambo ako;","poem":1},{"text":"ndipo usataye zimene anakuphunzitsa amayi ako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Zimenezi uzimatirire pa mtima pako masiku onse,","poem":1},{"text":"uzimangirire mʼkhosi mwako.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ukamayenda, zidzakulozera njira;","poem":1},{"text":"ukugona, zidzakulondera;","poem":2},{"lineBreak":true},{"text":"ukudzuka, zidzakuyankhula.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Paja malamulo awa ali ngati nyale,","poem":1},{"text":"malangizowa ali ngati kuwunika,","poem":2},{"text":"ndipo chidzudzulo cha mwambo ndiwo","poem":1},{"text":"moyo weniweni,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kukupulumutsa kwa mkazi wadama,","poem":1},{"text":"zimenezi zidzakutchinjiriza kwa mkazi wadama, ndi kukuthandiza kuti usamvere mawu oshashalika a mkazi wachiwerewere.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mu mtima wako usakhumbire kukongola kwake,","poem":1},{"text":"asakukope ndi zikope zake,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"paja mkazi wadama amakusandutsa kukhala ngati nyenyeswa za buledi","poem":1},{"text":"ndipo mkazi wa mwini wake amasokonezeratu moyo wako wonse.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kodi munthu angathe kutenga moto","poem":1},{"text":"zovala zake osapsa?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kodi munthu angathe kuyenda pa makala amoto","poem":1},{"text":"mapazi ake osapserera?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ndizo zimachitikira munthu amene amagonana ndi mkazi wa munthu wina.","poem":1},{"text":"Aliyense wokhudza mkazi wotere adzalangidwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Paja anthu sayinyoza mbala ikaba","poem":1},{"text":"chifukwa chakuti ili ndi njala.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Komabe ngati mbalayo igwidwa iyenera kulipira kasanu nʼkawiri,","poem":1},{"text":"ngakhale kulandidwa katundu wa mʼnyumba mwake.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Munthu wochita chigololo ndi wopanda nzeru.","poem":1},{"text":"Wochita zimenezi amangodziwononga yekha.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Adzalandira mabala ndi mʼnyozo,","poem":1},{"text":"ndipo manyazi ake sadzamuchokera.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Paja nsanje imachititsa mwini mkaziyo kukalipa,","poem":1},{"text":"ndipo sadzachita chifundo pobwezera.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Iye savomera dipo lililonse;","poem":1},{"text":"sangapepeseke ngakhale umupatse mphatso zochuluka motani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}