{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PRO","translationId":"nya_bib","name":"MIYAMBO","commonName":"MIYAMBO","title":"Miyambo","order":20,"numberOfChapters":31,"sha256":"10cfb808d30948338f33000f704c6bc5047ed093fa5bb681caa113ec68b98373","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nya_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Za Mkazi Wachigololo"]},{"type":"verse","number":1,"content":[{"text":"Mwana wanga, mvera mawu anga;","poem":1},{"text":"usunge bwino malamulo angawa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Utsate malamulo anga ndipo udzakhala ndi moyo;","poem":1},{"text":"samala malangizo angawa monga uchitira ndi maso ako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uchite ngati wawamangirira pa zala zako,","poem":1},{"text":"ndiponso ngati kuti wawalemba pa mtima pako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nzeru uyiwuze kuti, “Iwe ndiwe mlongo wanga,”","poem":1},{"text":"ndipo khalidwe lomvetsa bwino zinthu ulitchule kuti, “Bwenzi langa lapamtima.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zidzakuteteza kwa mkazi wachigololo","poem":1},{"text":"ndiponso zidzakuthandiza kusamvera mawu oshashalika a mkazi wachilendo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tsiku lina pa zenera la nyumba yanga","poem":1},{"text":"ndinasuzumira pa zenera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndinaona pakati pa anthu opusa,","poem":1},{"text":"pakati pa anyamata,","poem":2},{"lineBreak":true},{"text":"mnyamata wina wopanda nzeru.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iye ankayenda njira yodutsa pafupi ndi nyumba ya mkaziyo,","poem":1},{"text":"kuyenda molunjika nyumba ya mkaziyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inali nthawi yachisisira madzulo,","poem":1},{"text":"nthawi ya usiku, kuli mdima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndipo mkaziyo anadzakumana naye,","poem":1},{"text":"atavala ngati munthu wachiwerewere wa mtima wonyenga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"(Mkaziyo ndi wolongolola ndiponso nkhutukumve,","poem":1},{"text":"iye ndi wosakhazikika pa khomo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mwina umupeza pa msewu, mwina umupeza pa msika,","poem":1},{"text":"ndipo amadikirira munthu pa mphambano iliyonse).","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tsono amagwira mnyamatayo ndi kupsompsona","poem":1},{"text":"ndi nkhope yake yopanda manyazi amamuwuza kuti,","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ndinayenera kupereka nsembe zachiyanjano.","poem":1},{"text":"Lero ndakwaniritsa malumbiro anga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Choncho ndinabwera kudzakumana nawe;","poem":1},{"text":"ndinkakufunafuna ndipo ndakupeza!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pa bedi panga ndayalapo","poem":1},{"text":"nsalu zosalala zokongola zochokera ku Igupto.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Pa bedi panga ndawazapo zonunkhira","poem":1},{"text":"za mure, mafuta onunkhira a aloe ndi sinamoni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bwera, tiye tikhale malo amodzi kukondwerera chikondi mpaka mmawa;","poem":1},{"text":"tiye tisangalatsane mwachikondi!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mwamuna wanga kulibe ku nyumbako;","poem":1},{"text":"wapita ulendo wautali:","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Anatenga thumba la ndalama","poem":1},{"text":"ndipo adzabwera ku nyumba mwezi ukakhwima.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ndi mawu ake onyengerera amamukakamiza mnyamatayo;","poem":1},{"text":"amukopa ndi mawu ake oshashalika.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nthawi yomweyo chitsiru chimamutsatira mkaziyo","poem":1},{"text":"ngati ngʼombe yopita kukaphedwa,","poem":2},{"text":"monga momwe mbawala ikodwera mu msampha,","poem":1}]},{"type":"verse","number":23,"content":[{"text":"mpaka muvi utalasa chiwindi chake,","poem":2},{"text":"chimakhala ngati mbalame yothamangira mʼkhwekhwe,","poem":1},{"text":"osadziwa kuti moyo wake uwonongeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Tsono ana inu, ndimvereni;","poem":1},{"text":"mvetsetsani zimene ndikunena.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Musatengeke mtima ndi njira za mkazi ameneyu;","poem":1},{"text":"musasochere potsata njira zake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Paja iye anagwetsa anthu ambiri;","poem":1},{"text":"wapha gulu lalikulu la anthu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nyumba yake ndi njira yopita ku manda,","poem":1},{"text":"yotsikira ku malo a anthu akufa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}