{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Wodala munthu","poem":1},{"text":"amene satsatira uphungu wa anthu ochimwa,","poem":2},{"text":"kapena kuyima mʼnjira ya anthu oyipa,","poem":1},{"text":"kapena kukhala mʼmagulu a anthu onyoza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Koma chikondwerero chake chili mʼmalamulo a Yehova","poem":1},{"text":"ndipo mʼmalamulo akewo amalingaliramo usana ndi usiku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iye ali ngati mtengo wodzalidwa mʼmbali mwa mitsinje ya madzi,","poem":1},{"text":"umene umabereka zipatso zake pa nyengo yake","poem":2},{"text":"ndipo masamba ake safota.","poem":1},{"text":"Chilichonse chimene amachita amapindula nacho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sizitero ndi anthu oyipa!","poem":1},{"text":"Iwo ali ngati mungu","poem":2},{"lineBreak":true},{"text":"umene umawuluzidwa ndi mphepo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kotero anthu oyipa sadzatha kuyima pa chiweruzo,","poem":1},{"text":"kapena anthu ochimwa mu msonkhano wa anthu olungama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pakuti Yehova amayangʼanira mayendedwe a anthu olungama,","poem":1},{"text":"koma mayendedwe a anthu oyipa adzawonongeka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}