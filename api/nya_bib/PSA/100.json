m":1},{"text":"kukhulupirika kwake nʼkokhazikika pa mibado ndi mibado.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}