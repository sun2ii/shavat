{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Ndidzayimba za chikondi ndi chiweruzo chanu cholungama;","poem":1},{"text":"kwa Inu Yehova ndidzayimba matamando.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndidzatsata njira yolungama;","poem":1},{"text":"nanga mudzabwera liti kwa ine?","poem":2},{"lineBreak":true},{"text":"Ndidzayenda mʼnyumba mwanga","poem":1},{"text":"ndi mtima wosalakwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sindidzayika chinthu chilichonse choyipa","poem":1},{"text":"pamaso panga.","poem":2},{"lineBreak":true},{"text":"Ine ndimadana ndi zochita za anthu opanda chikhulupiriro;","poem":1},{"text":"iwo sadzadziphatika kwa ine.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anthu a mtima wokhota adzakhala kutali ndi ine;","poem":1},{"text":"ine sindidzalola choyipa chilichonse kulowa mwa ine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aliyense wosinjirira mnansi wake mseri","poem":1},{"text":"ameneyo ndidzamuletsa;","poem":2},{"text":"aliyense amene ali ndi maso amwano ndi mtima wodzikuza,","poem":1},{"text":"ameneyo sindidzamulekerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Maso anga adzakhala pa okhulupirika mʼdziko,","poem":1},{"text":"kuti akhale pamodzi ndi ine;","poem":2},{"text":"iye amene mayendedwe ake ndi wosalakwa","poem":1},{"text":"adzanditumikira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aliyense wochita chinyengo","poem":1},{"text":"sadzakhala mʼnyumba mwanga.","poem":2},{"text":"Aliyense woyankhula mwachinyengo","poem":1},{"text":"sadzayima pamaso panga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mmawa uliwonse ndidzatontholetsa anthu","poem":1},{"text":"onse oyipa mʼdziko;","poem":2},{"text":"ndidzachotsa aliyense wochita zoyipa","poem":1},{"text":"mu mzinda wa Yehova.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}