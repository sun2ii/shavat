{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":103,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Tamanda Yehova, iwe moyo wanga;","poem":1},{"text":"ndi zonse zamʼkati mwanga zitamande dzina lake loyera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tamanda Yehova, iwe moyo wanga,","poem":1},{"text":"ndipo usayiwale zabwino zake zonse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amene amakhululuka machimo ako onse","poem":1},{"text":"ndi kuchiritsa nthenda zako zonse,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"amene awombola moyo wako ku dzenje","poem":1},{"text":"ndi kukuveka chikondi ndi chifundo chake ngati chipewa chaufumu,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"amene akwaniritsa zokhumba zako ndi zinthu zabwino,","poem":1},{"text":"kotero kuti umakhala wamphamvu zatsopano ngati mphungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yehova amachita chilungamo","poem":1},{"text":"ndipo amaweruza molungama onse opsinjika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iye anadziwitsa Mose njira zake,","poem":1},{"text":"ntchito zake kwa Aisraeli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yehova ndi wachifundo ndi wokoma mtima,","poem":1},{"text":"wosakwiya msanga ndi wachikondi chochuluka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iye sadzatsutsa nthawi zonse,","poem":1},{"text":"kapena kusunga mkwiyo wake kwamuyaya;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"satichitira molingana ndi machimo athu,","poem":1},{"text":"kapena kutibwezera molingana ndi mphulupulu zathu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pakuti monga kumwamba kuli kutali ndi dziko lapansi,","poem":1},{"text":"koteronso chikondi chake nʼchachikulu kwa iwo amene amamuopa;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"monga kummawa kutalikirana ndi kumadzulo,","poem":1},{"text":"koteronso Iye watichotsera mphulupulu zathu kuti zikhale kutali nafe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Monga bambo amachitira chifundo ana ake,","poem":1},{"text":"choncho Yehova ali ndi chifundo ndi iwo amene amamuopa;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"pakuti Iye amadziwa momwe tinawumbidwira,","poem":1},{"text":"amakumbukira kuti ndife fumbi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kunena za munthu, masiku ake ali ngati udzu,","poem":1},{"text":"amaphuka ngati duwa la mʼmunda;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"koma mphepo imawombapo ndipo silionekanso","poem":1},{"text":"ndipo malo ake sakumbukirikanso.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Koma kuchokera muyaya mpaka muyaya","poem":1},{"text":"chikondi cha Yehova chili ndi iwo amene amamuopa,","poem":2},{"lineBreak":true},{"text":"ndi chilungamo chake chili ndi ana a ana awo;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"iwo amene amasunga pangano lake","poem":1},{"text":"ndi kukumbukira kumvera malangizo ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yehova wakhazikitsa mpando wake waufumu mmwamba","poem":1},{"text":"ndipo ufumu wake umalamulira onse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tamandani Yehova, inu angelo ake,","poem":1},{"text":"amphamvu inu amene mumachita zimene amalamula,","poem":2},{"lineBreak":true},{"text":"amene mumamvera mawu ake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tamandani Yehova, zolengedwa zonse zakumwamba,","poem":1},{"text":"inu atumiki ake amene mumachita chifuniro chake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tamandani Yehova, ntchito yake yonse","poem":1},{"text":"kulikonse mu ulamuliro wake.","poem":2},{"lineBreak":true},{"text":"Tamanda Yehova, iwe moyo wanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}