{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"Tamanda Yehova, iwe moyo wanga.","poem":1},{"lineBreak":true},{"text":"Inu Yehova Mulungu wanga, ndinu wamkulu kwambiri;","poem":1},{"text":"mwavala ulemerero ndi ufumu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iye wadzifunditsa kuwala ngati chovala;","poem":1},{"text":"watambasula miyamba ngati tenti","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ndipo wayika pa madzi mitanda ya chipinda chake.","poem":2},{"text":"Iye amasandutsa mitambo kukhala galeta lake,","poem":1},{"text":"ndi kuwuluka pa mapiko a mphepo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amapanga mphepo kukhala amithenga ake,","poem":1},{"text":"malawi amoto kukhala atumiki ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Anakhazikitsa dziko lapansi pa maziko ake;","poem":1},{"text":"silingasunthike.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Munaliphimba ndi nyanja yozama ngati chovala;","poem":1},{"text":"madzi anayimirira pamwamba pa mapiri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Koma pakudzudzula kwanu madzi anathawa,","poem":1},{"text":"pa mkokomo wa bingu lanu iwo anamwazika;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inu munamiza mapiri,","poem":1},{"text":"iwo anatsikira ku zigwa","poem":2},{"lineBreak":true},{"text":"kumalo kumene munawakonzera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inu munayika malire ndipo sangathe kudutsa,","poem":1},{"text":"iwo sadzamizanso dziko lapansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Iye achititsa akasupe kutulutsa madzi kupita ku zigwa;","poem":1},{"text":"madziwo amayenda pakati pa mapiri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iwo amapereka madzi kwa zirombo zonse zakuthengo;","poem":1},{"text":"abulu akuthengo amapha ludzu lawo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mbalame zamlengalenga zimayika zisa mʼmbali mwa madzi;","poem":1},{"text":"zimayimba pakati pa thambo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iye amathirira mapiri kuchokera ku zipinda zake zapamwamba;","poem":1},{"text":"dziko lapansi limakhutitsidwa ndi chipatso cha ntchito yake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amameretsa udzu kuti ngʼombe zidye,","poem":1},{"text":"ndi zomera, kuti munthu azilima","poem":2},{"lineBreak":true},{"text":"kubweretsa chakudya kuchokera mʼdziko lapansi:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"vinyo amene amasangalatsa mtima wa munthu,","poem":1},{"text":"mafuta amene amachititsa nkhope yake kuwala,","poem":2},{"lineBreak":true},{"text":"ndi buledi amene amapereka mphamvu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mitengo ya Yehova ndi yothiriridwa bwino,","poem":1},{"text":"mikungudza ya ku Lebanoni imene Iye anadzala.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mbalame zimamanga zisa zawo;","poem":1},{"text":"kakowa ali ndi malo ake mʼmikungudzamo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mapiri ataliatali ndi a mbalale;","poem":1},{"text":"mʼmingʼalu ya miyala ndi mobisalamo mbira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mwezi umasiyanitsa nyengo","poem":1},{"text":"ndipo dzuwa limadziwa nthawi yake yolowera.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Inu mumabweretsa mdima nukhala usiku,","poem":1},{"text":"ndipo zirombo zonse za ku nkhalango zimatuluka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mikango imabangula kufuna nyama,","poem":1},{"text":"ndi kufunafuna chakudya chawo kuchokera kwa Mulungu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dzuwa limatuluka ndipo iyo imapita kukabisala;","poem":1},{"text":"imabwerera kukagona pansi mʼmapanga awo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Pamenepo munthu amapita ku ntchito yake,","poem":1},{"text":"kukagwira ntchito yake mpaka madzulo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ntchito zanu ndi zochulukadi Inu Yehova!","poem":1},{"text":"Munazipanga zonse mwanzeru,","poem":2},{"lineBreak":true},{"text":"dziko lapansi ladzaza ndi zolengedwa zanu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kuli nyanja yayikulu ndi yotambalala,","poem":1},{"text":"yodzaza ndi zolengedwa zosawerengeka,","poem":2},{"lineBreak":true},{"text":"zamoyo zanu zazikulu ndi zazingʼono zomwe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kumeneko sitima zapamadzi zimayenda uku ndi uku,","poem":1},{"text":"ndiponso Leviyatani amene munamulenga kuti asewere kumeneko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Zonsezi zimayangʼana kwa Inu","poem":1},{"text":"kuti muzipatse chakudya chawo pa nthawi yake yoyenera.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mukazipatsa,","poem":1},{"text":"zimachisonkhanitsa pamodzi;","poem":2},{"text":"mukatsekula dzanja lanu,","poem":1},{"text":"izo zimakhutitsidwa ndi zinthu zabwino.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mukabisa nkhope yanu,","poem":1},{"text":"izo zimachita mantha aakulu;","poem":2},{"text":"mukachotsa mpweya wawo,","poem":1},{"text":"zimafa ndi kubwerera ku fumbi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mukatumiza mzimu wanu,","poem":1},{"text":"izo zimalengedwa","poem":2},{"lineBreak":true},{"text":"ndipo mumakozanso maonekedwe a dziko lapansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ulemerero wa Yehova ukhalebe mpaka muyaya;","poem":1},{"text":"Yehova akondwere ndi ntchito ya manja ake;","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Iye amene amayangʼana dziko lapansi ndipo limanjenjemera,","poem":1},{"text":"amene amakhudza mapiri ndipo amatuluka utsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ine ndidzayimbira Yehova moyo wanga wonse;","poem":1},{"text":"ndidzayimbira matamando Mulungu wanga nthawi yonse imene ndili ndi moyo.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Zolingalira zanga zikhale zomukomera Iye,","poem":1},{"text":"pamene ndikusangalala mwa Yehova.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Koma anthu ochimwa awonongeke pa dziko lapansi","poem":1},{"text":"ndipo anthu oyipa asapezekenso.","poem":2},{"lineBreak":true},{"text":"Tamanda Yehova, Iwe moyo wanga.","poem":1},{"lineBreak":true},{"text":"Tamandani Yehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}