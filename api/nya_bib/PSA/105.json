{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"Yamikani Yehova, itanani dzina lake;","poem":1},{"text":"lalikirani pakati pa anthu a mitundu ina zimene Iye wachita.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Imbirani Iye, imbani matamando kwa Iyeyo;","poem":1},{"text":"fotokozani za machitidwe ake onse odabwitsa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Munyadire dzina lake loyera;","poem":1},{"text":"mitima ya iwo amene amafunafuna Yehova ikondwere.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dalirani Yehova ndi mphamvu zake;","poem":1},{"text":"funafunani nkhope yake nthawi yonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kumbukirani zodabwitsa zimene Iye anazichita,","poem":1},{"text":"zozizwitsa zake ndi maweruzo amene anapereka,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"inu zidzukulu za Abrahamu mtumiki wake,","poem":1},{"text":"inu ana a Yakobo, osankhika ake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iye ndiye Yehova Mulungu wathu;","poem":1},{"text":"maweruzo ake ali pa dziko lonse lapansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Iyeyo amakumbukira pangano lake kwamuyaya,","poem":1},{"text":"mawu amene analamula kwa mibado yonse,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"pangano limene Iye anapanga ndi Abrahamu,","poem":1},{"text":"lumbiro limene analumbira kwa Isake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iye analitsimikiza kwa Yakobo monga zophunzitsa,","poem":1},{"text":"kwa Israeli monga pangano lamuyaya:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Ndidzapereka kwa iwe dziko la Kanaani","poem":1},{"text":"ngati gawo la cholowa chako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Pamene iwo anali ngati anthu ochepa mʼchiwerengero,","poem":1},{"text":"ochepa ndithu, ndiponso alendo mʼdzikolo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ankayendayenda kuchoka ku mtundu wina wa anthu ndi kupita ku mtundu wina,","poem":1},{"text":"kuchoka mu ufumu wina kupita ku wina.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iye sanalole wina aliyense kuwapondereza;","poem":1},{"text":"anadzudzula mafumu chifukwa cha iwo:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Musakhudze odzozedwa anga;","poem":1},{"text":"musachitire choyipa aneneri anga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Iye anabweretsa njala pa dziko","poem":1},{"text":"ndipo anawononga chakudya chonse;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iyeyo anatumiza munthu patsogolo pawo,","poem":1},{"text":"Yosefe anagulitsidwa ngati kapolo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iwo anavulaza mapazi ake ndi matangadza,","poem":1},{"text":"khosi lake analiyika mʼzitsulo,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"mpaka zimene Iye ananeneratu zitakwaniritsidwa,","poem":1},{"text":"mpaka mawu a Yehova ataonetsa kuti Iye ananena zoona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mfumu inatuma munthu kukamumasula,","poem":1},{"text":"wolamulira wa mitundu ya anthu anamasula iyeyo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Anamuyika kukhala wolamulira nyumba yake,","poem":1},{"text":"wolamulira zonse zimene iye anali nazo,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kulangiza ana a mfumu monga ankafunira","poem":1},{"text":"ndi kuphunzitsa nzeru akuluakulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tsono Israeli analowa mu Igupto;","poem":1},{"text":"Yakobo anakhala monga mlendo mʼdziko la Hamu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yehova anachulukitsa anthu ake;","poem":1},{"text":"ndipo anachititsa kuti akhale ochuluka kwambiri kuposa adani awo;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"amene mitima yawo anayitembenuza kuti idane ndi anthu ake,","poem":1},{"text":"kukonzera chiwembu atumiki ake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yehova anatuma Mose mtumiki wake,","poem":1},{"text":"ndi Aaroni amene Iye anamusankha.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Iwo anachita zizindikiro zozizwitsa pakati pawo,","poem":1},{"text":"zodabwitsa zake mʼdziko la Hamu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yehova anatumiza mdima nasandutsa dziko kuti likhale la mdima.","poem":1},{"text":"Koma anthuwo anakaniratu mawu a Yehova.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yehova anasandutsa madzi awo kukhala magazi,","poem":1},{"text":"kuchititsa kuti nsomba zawo zife.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Dziko lawo linadzaza ndi achule","poem":1},{"text":"amene analowa mʼzipinda zogona za olamulira awo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Iye anayankhula, ndipo kunabwera ntchentche zochuluka","poem":1},{"text":"ndi nsabwe mʼdziko lawo lonse.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Iyeyo anatembenuza mvula yawo kukhala matalala,","poem":1},{"text":"ndi zingʼaningʼani mʼdziko lawo lonse;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Anagwetsa mitengo yawo ya mpesa ndi mitengo yawo ya mkuyu,","poem":1},{"text":"nawononganso mitengo ina ya mʼdziko lawolo.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Iye anayankhula, ndipo dzombe linabwera,","poem":1},{"text":"ziwala zosawerengeka;","poem":2}]},{"type":"verse","number":35,"content":[{"text":"zinadya chilichonse chobiriwira cha mʼdziko lawo,","poem":1},{"text":"zinadya zonse zotuluka mʼnthaka yawo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kenaka anakantha ana onse oyamba kubadwa a mʼdziko lawo,","poem":1},{"text":"zipatso zoyamba za umunthu wawo wonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Yehova anatulutsa Israeli, atatenga siliva ndi golide wambiri,","poem":1},{"text":"ndipo pakati pa mafuko awo palibe mmodzi amene anafowoka.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Dziko la Igupto linakondwa pamene iwo anachoka,","poem":1},{"text":"pakuti kuopsa kwa Israeli kunawagwera iwo.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Iye anatambasula mitambo ngati chofunda chawo,","poem":1},{"text":"ndi moto owawunikira usiku.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Iwo anapempha, ndipo Iye anawabweretsera zinziri","poem":1},{"text":"ndipo anawakhutitsa ndi chakudya chochokera kumwamba.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Iye anatsekula thanthwe, ndipo madzi anatuluka;","poem":1},{"text":"ngati mtsinje anayenda mʼchipululu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"Pakuti anakumbukira lonjezo lake loyera limene","poem":1},{"text":"linaperekedwa kwa Abrahamu mtumiki wake.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Iye anatulutsa anthu ake akukondwera,","poem":1},{"text":"osankhika ake akufuwula mwachimwemwe;","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Iye anawapatsa mayiko a anthu a mitundu ina","poem":1},{"text":"ndipo anakhala olowamʼmalo a zimene ena anazivutikira,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"kuti iwo asunge malangizo ake","poem":1},{"text":"ndi kutsatira malamulo ake.","poem":2},{"lineBreak":true},{"text":"Tamandani Yehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}