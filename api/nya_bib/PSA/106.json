{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"Tamandani Yehova.","poem":1},{"lineBreak":true},{"text":"Yamikani Yehova chifukwa ndi wabwino;","poem":1},{"text":"pakuti chikondi chake ndi chosatha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndani angathe kufotokoza za ntchito zamphamvu za Yehova","poem":1},{"text":"kapena kumutamanda mokwanira?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Odala ndi amene amasunga chilungamo,","poem":1},{"text":"amene amachita zolungama nthawi zonse.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mundikumbukire Yehova, pamene mukuonetsa kukoma mtima kwanu kwa anthu anu,","poem":1},{"text":"bwerani mudzandithandize pamene mukuwapulumutsa iwo,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"kuti ndidzasangalale ndi chuma cha anthu anu osankhika,","poem":1},{"text":"kuti ndidzakhale nacho chimwemwe cha anthu anu","poem":2},{"lineBreak":true},{"text":"ndi kukhala pamodzi ndi cholowa chanu pa kukutamandani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ife tachimwa monga momwe anachitira makolo athu;","poem":1},{"text":"tachita zolakwa ndipo tachita moyipa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pamene makolo athu anali mu Igupto,","poem":1},{"text":"sanalingalire za zozizwitsa zanu;","poem":2},{"text":"iwo sanakumbukire kukoma mtima kwanu kochuluka,","poem":1},{"text":"ndipo anawukira Inu pa Nyanja Yofiira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Komabe Iye anawapulumutsa chifukwa cha dzina lake,","poem":1},{"text":"kuti aonetse mphamvu zake zazikulu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anadzudzula Nyanja Yofiira, ndipo inawuma;","poem":1},{"text":"anawatsogolera mʼnyanja yakuya ngati akuyenda mʼchipululu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anawapulumutsa mʼdzanja la amaliwongo;","poem":1},{"text":"anawawombola mʼdzanja la mdani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Madzi anamiza adani awo,","poem":1},{"text":"palibe mmodzi wa iwo anapulumuka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kenaka iwo anakhulupirira malonjezo ake","poem":1},{"text":"ndi kuyimba nyimbo zamatamando.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Koma posachedwa anayiwala zimene Iye anachita,","poem":1},{"text":"ndipo sanayembekezere uphungu wake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mʼchipululu, anadzipereka ku zilakolako zawo;","poem":1},{"text":"mʼdziko lopanda kanthu anayesa Mulungu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Choncho Iye anawapatsa chimene anapempha,","poem":1},{"text":"koma anatumiza nthenda yowondetsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mʼmisasa, anachitira nsanje Mose ndi Aaroni,","poem":1},{"text":"amene Yehova anadzipatulira.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nthaka inatsekuka ndipo inameza Datani;","poem":1},{"text":"inakwirira gulu la Abiramu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Moto unayaka pakati pa otsatira awo;","poem":1},{"text":"lawi lamoto linapsereza anthu oyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Iwo anapanga mwana wangʼombe pa Horebu","poem":1},{"text":"ndi kulambira fano loyengedwa kuchokera ku chitsulo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Anasinthanitsa ulemerero wawo","poem":1},{"text":"ndi fano la ngʼombe yayimuna imene imadya udzu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Anayiwala Mulungu amene anawapulumutsa,","poem":1},{"text":"amene anachita zinthu zazikulu mu Igupto,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"zozizwitsa mʼdziko la Hamu","poem":1},{"text":"ndi machitidwe ake woopsa pa Nyanja Yofiira.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Choncho Iye anawawuza kuti adzawawononga,","poem":1},{"text":"pakanapanda Mose, mtumiki wake wosankhidwa,","poem":2},{"text":"kuyima pamaso pake,","poem":1},{"text":"ndi kuletsa mkwiyo wake kuti usawawononge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Motero iwo ananyoza dziko lokoma;","poem":1},{"text":"sanakhulupirire malonjezo ake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Anangʼungʼudza mʼmatenti mwawo","poem":1},{"text":"ndipo sanamvere Yehova.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kotero Iye analumbira atakweza dzanja lake,","poem":1},{"text":"kuti adzachititsa kuti iwowo afere mʼchipululu,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kuchititsa kuti zidzukulu zawo zifere pakati pa anthu a mitundu ina","poem":1},{"text":"ndi kuwabalalitsa mʼdziko lonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Iwo anayamba kupembedza Baala-Peori","poem":1},{"text":"ndi kudya nsembe zoperekedwa kwa milungu yopanda moyo;","poem":2}]},{"type":"verse","number":29,"content":[{"text":"anaputa mkwiyo wa Yehova pa machitidwe awo oyipa,","poem":1},{"text":"ndipo mliri unabuka pakati pawo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Koma Finehasi anayimirira ndi kulowererapo,","poem":1},{"text":"ndipo mliri unaleka.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Chimenechi ndicho chinayesedwa chilungamo chake,","poem":1},{"text":"kwa mibado yosatha imene ikubwera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Pa madzi a ku Meriba iwo anakwiyitsa Yehova","poem":1},{"text":"ndipo mavuto anabwera kwa Mose chifukwa cha anthuwo,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"pakuti iwowo anawukira mzimu wa Mulungu,","poem":1},{"text":"ndipo pa milomo ya Mose panatuluka mawu osayenera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Aisraeliwo sanawononge mitundu ya anthu","poem":1},{"text":"monga momwe Yehova anawalamulira.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Koma anasakanizana ndi anthu a mitundu inayo","poem":1},{"text":"ndi kuphunzira miyambo yawo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ndipo anapembedza mafano awo,","poem":1},{"text":"amene anakhala msampha kwa iwowo.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Anapereka nsembe ana awo aamuna","poem":1},{"text":"ndi ana awo aakazi kwa ziwanda.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Anakhetsa magazi a anthu osalakwa,","poem":1},{"text":"magazi a ana awo aamuna ndi a ana awo aakazi,","poem":2},{"text":"amene anawapereka nsembe kwa mafano a ku Kanaani,","poem":1},{"text":"ndipo dziko linayipitsidwa ndi magazi awo.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Iwo anadzidetsa okha ndi zimene anachita;","poem":1},{"text":"ndi machitidwe awo amakhala ngati munthu wachigololo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Tsono Yehova anakwiya ndi anthu ake","poem":1},{"text":"ndipo ananyansidwa ndi cholowa chake.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Iye anawapereka kwa anthu a mitundu ina,","poem":1},{"text":"ndipo adani awo anawalamulira.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Adani awo anawazunza","poem":1},{"text":"ndi kuwakhazika pansi pa mphamvu yawo.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Iye ankawapulumutsa nthawi zambiri,","poem":1},{"text":"koma iwo ankatsimikiza za kuwukira","poem":2},{"lineBreak":true},{"text":"ndipo anawonongeka mʼmachimo awo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Koma Iye anaona kuzunzika kwawo","poem":1},{"text":"pamene anamva kulira kwawo;","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Chifukwa cha iwo Iye anakumbukira pangano lake","poem":1},{"text":"ndipo anawalezera mtima chifukwa cha kukula kwa chikondi chake.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Iye anachititsa kuti amene anawagwira iwo ukapolo","poem":1},{"text":"awamvere chisoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Tipulumutseni Inu Yehova Mulungu wathu,","poem":1},{"text":"ndipo mutisonkhanitse kuchoka kwa anthu a mitundu ina","poem":2},{"text":"kuti tithe kuyamika dzina lanu loyera","poem":1},{"text":"ndi kunyadira mʼmatamando anu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Atamandike Yehova, Mulungu wa Israeli,","poem":1},{"text":"Kuyambira muyaya mpaka muyaya.","poem":2},{"text":"Anthu onse anene kuti, “Ameni!”","poem":1},{"lineBreak":true},{"text":"Tamandani Yehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}