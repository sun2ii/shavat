{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["Nyimbo. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Mtima wanga ndi wokhazikika, Inu Mulungu;","poem":1},{"text":"ndidzayimba nyimbo, inde ndidzayimba nyimbo zotamanda ndi moyo wanga wonse.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dzukani, zeze ndi pangwe!","poem":1},{"text":"Ine ndidzadzutsa mʼbandakucha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndidzakutamandani Yehova, pakati pa anthu a mitundu ina;","poem":1},{"text":"ndidzayimba za Inu pakati pa anthu a mitundu ina.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pakuti chikondi chanu nʼchachikulu, kutalika kwake kuposa kumwamba;","poem":1},{"text":"kukhulupirika kwanu kumafika mlengalenga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwezekani Inu Mulungu, kuposa mayiko akumwamba,","poem":1},{"text":"ndipo ulemerero wanu uphimbe dziko lonse lapansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tipulumutseni ndi kutithandiza ndi dzanja lanu lamanja","poem":1},{"text":"kuti iwo amene mumawakonda apulumutsidwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mulungu wayankhula kuchokera ku malo ake opatulika:","poem":1},{"text":"“Mwachipambano Ine ndidzagawa Sekemu","poem":2},{"lineBreak":true},{"text":"ndipo ndidzayesa chigwa cha Sukoti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Giliyadi ndi wanga, Manase ndi wanganso;","poem":1},{"text":"Efereimu ndi chipewa changa chodzitetezera,","poem":2},{"lineBreak":true},{"text":"Yuda ndi ndodo yanga yaufumu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mowabu ndi mbale yanga yosambiramo","poem":1},{"text":"ndidzaponya nsapato zanga pa Edomu;","poem":2},{"lineBreak":true},{"text":"ndidzafuwula mopambana pa Filisitiya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndani adzandifikitsa ku mzinda wotetezedwa?","poem":1},{"text":"Ndani adzanditsogolera ku Edomu?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodi sindinu Mulungu, Inu amene mwatikana","poem":1},{"text":"ndipo simuperekezanso magulu athu ankhondo?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tithandizeni ife kulimbana ndi mdani,","poem":1},{"text":"pakuti thandizo la munthu ndi lopanda pake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Chifukwa cha Mulungu wathu, ife tidzapeza chipambano,","poem":1},{"text":"ndipo adzapondereza pansi adani athu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}