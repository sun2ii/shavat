{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":109,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wamayimbidwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Mulungu amene ndimakutamandani,","poem":1},{"text":"musakhale chete,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"pakuti anthu oyipa ndi achinyengo","poem":1},{"text":"atsekula pakamwa pawo kutsutsana nane;","poem":2},{"lineBreak":true},{"text":"iwo ayankhula motsutsana nane ndi malilime abodza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Andizungulira ndi mawu audani,","poem":1},{"text":"amandinena popanda chifukwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mʼmalo mwa chikondi changa amandineneza,","poem":1},{"text":"koma ine ndine munthu wapemphero.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iwo amandibwezera zoyipa mʼmalo mwa zabwino,","poem":1},{"text":"ndi udani mʼmalo mwa chikondi changa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sankhani munthu woyipa kuti amutsutse iye;","poem":1},{"text":"lolani wotsutsa ayime ku dzanja lake lamanja.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pamene aweruzidwa, apezeke kuti ndi wolakwa,","poem":1},{"text":"ndipo mapemphero ake amutsutse.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Masiku ake akhale owerengeka;","poem":1},{"text":"munthu wina atenge malo ake a utsogoleri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ana ake akhale amasiye","poem":1},{"text":"ndipo mkazi wake akhale wopanda mwamuna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ana ake akhale oyendayenda ndi opemphapempha;","poem":1},{"text":"apirikitsidwe kuchoka pa mabwinja a nyumba zawo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wokongoza alande zonse zimene ali nazo;","poem":1},{"text":"alendo afunkhe ntchito za manja ake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pasapezeke ndi mmodzi yemwe womukomera mtima","poem":1},{"text":"kapena kumvera chisoni ana ake amasiye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zidzukulu zake zithe nʼkufa,","poem":1},{"text":"mayina awo afafanizidwe mu mʼbado wotsatirawo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mphulupulu za makolo ake zikumbukiridwe pamaso pa Yehova;","poem":1},{"text":"tchimo la amayi ake lisadzafafanizidwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Machimo awo akhale pamaso pa Yehova nthawi zonse,","poem":1},{"text":"kuti Iye achotse chikumbutso chawo pa dziko lapansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Pakuti iye sanaganizirepo zochita chifundo,","poem":1},{"text":"koma anazunza mpaka kuwapha anthu osauka","poem":2},{"lineBreak":true},{"text":"ndi osweka mtima.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Anakonda kutemberera,","poem":1},{"text":"matembererowo abwerere kwa iye;","poem":2},{"text":"sanakondwe nʼkudalitsa anthu ena,","poem":1},{"text":"choncho madalitso akhale kutali naye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anavala kutemberera ngati chovala;","poem":1},{"text":"kutemberera kunalowa mʼthupi lake ngati madzi,","poem":2},{"lineBreak":true},{"text":"kulowa mʼmafupa ake ngati mafuta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Matemberero akhale ngati chofunda chodzikutira nacho,","poem":1},{"text":"ngati lamba wovala tsiku ndi tsiku.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Awa akhale malipiro ochokera kwa Yehova pa onditsutsa anga,","poem":1},{"text":"kwa iwo amene amayankhula zoyipa za ine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Koma Inu Ambuye Wamphamvuzonse,","poem":1},{"text":"muchite nane molingana ndi dzina lanu,","poem":2},{"lineBreak":true},{"text":"chifukwa cha ubwino wa chikondi chanu, pulumutseni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Pakuti ndine wosauka ndi wosowa,","poem":1},{"text":"ndipo mtima wanga ukuwawa mʼkati mwanga.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndikuzimirira ngati mthunzi wa kumadzulo,","poem":1},{"text":"ndapirikitsidwa ngati dzombe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mawondo anga afowoka chifukwa cha kusala zakudya,","poem":1},{"text":"thupi langa lawonda ndi mutu wanga womwe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndine chinthu chotonzedwa kwa otsutsana nane;","poem":1},{"text":"akandiona, amapukusa mitu yawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Thandizeni Inu Yehova Mulungu wanga;","poem":1},{"text":"pulumutseni molingana ndi chikondi chanu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Adaniwo adziwe kuti limeneli ndi dzanja lanu,","poem":1},{"text":"kuti Inu Yehova mwachita zimenezi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Angathe kutemberera, koma Inu mudzadalitsa;","poem":1},{"text":"pamene iwo andiputa adzachititsidwa manyazi,","poem":2},{"lineBreak":true},{"text":"koma mtumiki wanu adzasangalala.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Onditsutsa adzavekedwa mnyozo,","poem":1},{"text":"ndipo adzadzifunditsa manyazi ngati chovala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ndi pakamwa panga ndidzathokoza Yehova kwambiri;","poem":1},{"text":"ndidzamutamanda mʼgulu lalikulu la anthu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Popeza Iye amayima ku dzanja lamanja la munthu wosowayo,","poem":1},{"text":"kupulumutsa moyo wake kwa iwo amene agamula molakwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}