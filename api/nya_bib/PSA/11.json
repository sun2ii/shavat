{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Mwa Yehova ine ndimathawiramo.","poem":1},{"text":"Nanga mungathe bwanji kunena kwa ine kuti,","poem":2},{"lineBreak":true},{"text":"“Thawira ku phiri lako ngati mbalame.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pakuti taona oyipa akunga mauta awo;","poem":1},{"text":"ayika bwino mivi yawo pa zingwe za uta,","poem":2},{"text":"pobisala pawo kuti alase","poem":1},{"text":"olungama mtima.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tsono ngati maziko awonongeka,","poem":1},{"text":"olungama angachite chiyani?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yehova ali mʼNyumba yake yoyera;","poem":1},{"text":"Yehova ali pa mpando wake waufumu kumwamba.","poem":2},{"text":"Iye amayangʼanitsitsa ana a anthu;","poem":1},{"text":"maso ake amawayesa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yehova amayesa olungama,","poem":1},{"text":"koma moyo wake umadana ndi oyipa,","poem":2},{"lineBreak":true},{"text":"amene amakonda zachiwawa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iye adzakhuthulira pa oyipa","poem":1},{"text":"makala amoto ndi sulufule woyaka;","poem":2},{"lineBreak":true},{"text":"mphepo yotentha idzakhala yowayenera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pakuti Yehova ndi wolungama,","poem":1},{"text":"Iye amakonda chilungamo;","poem":2},{"lineBreak":true},{"text":"ndipo anthu olungama adzaona nkhope yake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}