{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Yehova akuwuza Mbuye wanga kuti,","poem":1},{"text":"“Khala ku dzanja langa lamanja","poem":2},{"text":"mpaka nditasandutsa adani ako","poem":1},{"text":"kukhala chopondapo mapazi ako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yehova adzakuza ndodo yamphamvu ya ufumu wako kuchokera mʼZiyoni;","poem":1},{"text":"udzalamulira pakati pa adani ako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ankhondo ako adzakhala odzipereka","poem":1},{"text":"pa tsiku lako la nkhondo.","poem":2},{"text":"Atavala chiyero chaulemerero,","poem":1},{"text":"kuchokera mʼmimba ya mʼbandakucha,","poem":2},{"lineBreak":true},{"text":"udzalandira mame a unyamata wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yehova walumbira","poem":1},{"text":"ndipo sadzasintha maganizo ake:","poem":2},{"text":"“Ndiwe wansembe mpaka muyaya","poem":1},{"text":"monga mwa unsembe wa Melikizedeki.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ambuye ali kudzanja lako lamanja;","poem":1},{"text":"Iye adzaponda mafumu pa tsiku la ukali wake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Adzaweruza anthu a mitundu ina,","poem":1},{"text":"adzadzaza dziko lapansi ndi mitembo ndipo adzaphwanya olamulira a pa dziko lonse lapansi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iye adzamwa mu mtsinje wa mʼmbali mwa njira;","poem":1},{"text":"choncho adzaweramutsa mutu wake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}