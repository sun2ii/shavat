{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Tamandani Yehova.","poem":1},{"lineBreak":true},{"text":"Wodala munthu amene amaopa Yehova,","poem":1},{"text":"amene amakondwera kwambiri ndi malamulo ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ana ake adzakhala amphamvu mʼdziko;","poem":1},{"text":"mʼbado wa olungama mtima udzadalitsidwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kulemera ndi chuma zili mʼnyumba yake,","poem":1},{"text":"ndipo chilungamo chake ndi chosatha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngakhale mu mdima kuwala kumatulukira olungama mtima;","poem":1},{"text":"wokoma mtima, wachifundo ndi wowongoka mtima.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zinthu zabwino zidzabwera kwa iye amene amapereka mowolowamanja ndi wokongoletsa mwaufulu,","poem":1},{"text":"amene amachita ntchito yake mwachilungamo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndithu sadzagwedezeka;","poem":1},{"text":"munthu wolungama sadzayiwalika mpaka muyaya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Saopa akamva zoyipa zimene zachitika;","poem":1},{"text":"mtima wake ndi wokhazikika ndipo amadalira Yehova.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mtima wake ndi wotetezedwa, sadzakhala ndi mantha;","poem":1},{"text":"potsiriza pake adzayangʼana adani ake mwachipambano.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wopereka mphatso zake mowolowamanja kwa osauka,","poem":1},{"text":"chilungamo chake chimanka mpaka muyaya;","poem":2},{"lineBreak":true},{"text":"nyanga yake idzakwezedwa mwaulemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Munthu woyipa adzaona zimenezi ndipo adzapsa mtima;","poem":1},{"text":"adzakukuta mano ake ndipo adzasungunuka.","poem":2},{"lineBreak":true},{"text":"Zolakalaka za anthu oyipa sizidzachitika konse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}