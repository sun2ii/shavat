{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Tamandani Yehova.","poem":1},{"lineBreak":true},{"text":"Mutamandeni, inu atumiki a Yehova,","poem":1},{"text":"tamandani dzina la Yehova.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yehova atamandidwe,","poem":1},{"text":"kuyambira tsopano mpaka muyaya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kuyambira ku matulukiro a dzuwa mpaka ku malowero ake,","poem":1},{"text":"dzina la Yehova liyenera kutamandidwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yehova wakwezeka pa anthu a mitundu yonse,","poem":1},{"text":"ulemerero wake ndi woposa mayiko akumwamba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndani wofanana ndi Yehova Mulungu wathu,","poem":1},{"text":"Iye amene amakhala mwaufumu mmwamba?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"amene amawerama pansi kuyangʼana","poem":1},{"text":"miyamba ndi dziko lapansi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iye amakweza munthu wosauka kuchoka pa fumbi","poem":1},{"text":"ndi kutukula munthu wosowa kuchoka pa dzala;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"amawakhazika pamodzi ndi mafumu,","poem":1},{"text":"pamodzi ndi mafumu a anthu ake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amakhazikitsa mayi wosabereka mʼnyumba yake","poem":1},{"text":"monga mayi wa ana wosangalala.","poem":2},{"lineBreak":true},{"text":"Tamandani Yehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}