{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Pamene Israeli anatuluka mu Igupto,","poem":1},{"text":"nyumba ya Yakobo kuchoka ku mtundu wa anthu a chiyankhulo chachilendo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yuda anasanduka malo opatulika a Mulungu,","poem":1},{"text":"Israeli anasanduka ufumu wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nyanja inaona ndi kuthawa,","poem":1},{"text":"mtsinje wa Yorodani unabwerera mʼmbuyo;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"mapiri analumphalumpha ngati nkhosa zazimuna,","poem":1},{"text":"timapiri ngati ana ankhosa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nʼchifukwa chiyani iwe unathawa?","poem":1},{"text":"iwe mtsinje wa Yorodani unabwereranji mʼmbuyo?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"inu mapiri, munalumphalumphiranji ngati nkhosa zazimuna,","poem":1},{"text":"inu timapiri, ngati ana ankhosa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Njenjemera pamaso pa Ambuye iwe dziko lapansi,","poem":1},{"text":"pamaso pa Mulungu wa Yakobo,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"amene anasandutsa thanthwe kukhala chitsime,","poem":1},{"text":"thanthwe lolimba kukhala akasupe a madzi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}