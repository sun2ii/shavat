{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Kwa ife ayi Yehova, kwa ife ayi","poem":1},{"text":"koma ulemerero ukhale pa dzina lanu,","poem":2},{"lineBreak":true},{"text":"chifukwa cha chikondi chanu chosasinthika ndiponso chifukwa cha kukhulupirika kwanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Chifukwa chiyani anthu a mitundu ina akunena kuti,","poem":1},{"text":"“Mulungu wawo ali kuti?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mulungu wathu ali kumwamba;","poem":1},{"text":"Iye amachita chilichonse chimene chimamukondweretsa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Koma mafano awo ndi siliva ndi golide,","poem":1},{"text":"opangidwa ndi manja a anthu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pakamwa ali napo koma sayankhula,","poem":1},{"text":"maso ali nawo koma sapenya;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"makutu ali nawo koma samva,","poem":1},{"text":"mphuno ali nazo koma sanunkhiza;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"manja ali nawo koma akakhudza samva kanthu;","poem":1},{"text":"mapazi ali nawo koma sayenda;","poem":2},{"lineBreak":true},{"text":"kapena pakhosi pawo kutulutsa mawu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anthu amene amapanga mafanowo adzafanana nawo,","poem":1},{"text":"chimodzimodzinso onse amene amadalira mafanowo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Inu Aisraeli, dalirani Yehova;","poem":1},{"text":"Iye ndiye thandizo lanu ndi chishango chanu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iwe nyumba ya Aaroni, dalira Yehova;","poem":1},{"text":"Iye ndiye thandizo lako ndi chishango chako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inu amene mumaopa Iye, dalirani Yehova;","poem":1},{"text":"Iye ndiye thandizo lanu ndi chishango chanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yehova watikumbukira ndipo adzatidalitsa:","poem":1},{"text":"adzadalitsa nyumba ya Israeli,","poem":2},{"lineBreak":true},{"text":"adzadalitsa nyumba ya Aaroni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"adzadalitsa iwo amene amaopa Yehova;","poem":1},{"text":"aangʼono ndi aakulu omwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yehova akuwonjezereni madalitso;","poem":1},{"text":"inuyo pamodzi ndi ana anu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mudalitsidwe ndi Yehova,","poem":1},{"text":"Wolenga kumwamba ndi dziko lapansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kumwamba ndi kwa Yehova,","poem":1},{"text":"koma dziko lapansi Iye walipereka kwa anthu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Si anthu akufa amene amatamanda Yehova,","poem":1},{"text":"amene amatsikira kuli chete;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ndi ife amene timatamanda Yehova,","poem":1},{"text":"kuyambira tsopano mpaka muyaya.","poem":2},{"lineBreak":true},{"text":"Tamandani Yehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}