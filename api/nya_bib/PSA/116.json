{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Ndimakonda Yehova pakuti Iyeyo amamva mawu anga;","poem":1},{"text":"Iye amamva kulira kwanga kopempha chifundo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pakuti ananditchera khutu,","poem":1},{"text":"ndidzayitana Iye masiku onse a moyo wanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zingwe za imfa zinandizinga,","poem":1},{"text":"zoopsa za ku dziko la anthu akufa zinandigwera;","poem":2},{"lineBreak":true},{"text":"ndinapeza mavuto ndi chisoni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pamenepo ndinayitana dzina la Yehova:","poem":1},{"text":"“Inu Yehova, pulumutseni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yehova ndi wokoma mtima ndi wolungama","poem":1},{"text":"Mulungu wathu ndi wodzaza ndi chifundo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yehova amateteza munthu wodzichepetsa mtima;","poem":1},{"text":"pamene ndinali ndi chosowa chachikulu, Iye anandipulumutsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pumula iwe moyo wanga,","poem":1},{"text":"pakuti Yehova wakuchitira zokoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Pakuti Inu Yehova mwapulumutsa moyo wanga ku imfa,","poem":1},{"text":"maso anga ku misozi,","poem":2},{"lineBreak":true},{"text":"mapazi anga kuti angapunthwe,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kuti ine ndiyende pamaso pa Yehova","poem":1},{"text":"mʼdziko la anthu amoyo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ine ndinakhulupirira; choncho ndinati,","poem":1},{"text":"“Ndasautsidwa kwambiri.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndipo ndili mʼnkhawa yanga ndinati,","poem":1},{"text":"“Anthu onse ndi abodza.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndingamubwezere chiyani Yehova,","poem":1},{"text":"chifukwa cha zokoma zake zonse zimene wandichitira?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndidzakweza chikho cha chipulumutso","poem":1},{"text":"ndipo ndidzayitana dzina la Yehova.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndidzakwaniritsa malonjezo anga kwa Yehova","poem":1},{"text":"pamaso pa anthu ake onse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Imfa ya anthu oyera mtima","poem":1},{"text":"ndi yamtengowapatali pamaso pa Yehova.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inu Yehova, zoonadi ndine mtumiki wanu:","poem":1},{"text":"ndine mtumiki wanu, mwana wa mdzakazi wanu;","poem":2},{"lineBreak":true},{"text":"Inu mwamasula maunyolo anga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ndidzapereka nsembe yachiyamiko kwa Inu","poem":1},{"text":"ndipo ndidzayitanira pa dzina la Yehova.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndidzakwaniritsa malonjezo anga kwa Yehova","poem":1},{"text":"pamaso pa anthu ake onse,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"mʼmabwalo a nyumba ya Yehova,","poem":1},{"text":"mʼkati mwako iwe Yerusalemu.","poem":2},{"lineBreak":true},{"text":"Tamandani Yehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}