{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"Yamikani Yehova chifukwa ndi wabwino;","poem":1},{"text":"pakuti chikondi chake chosasinthika ndi chosatha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Israeli anene kuti:","poem":1},{"text":"“Chikondi chake ndi chosatha.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Banja la Aaroni linene kuti,","poem":1},{"text":"“Chikondi chake ndi chosatha.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iwo amene amaopa Yehova anene kuti:","poem":1},{"text":"“Chikondi chake ndi chosatha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndili mʼmasautso anga ndinalirira Yehova,","poem":1},{"text":"ndipo Iye anayankha pondichotsa mʼmasautsowo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yehova ali nane; sindidzachita mantha.","poem":1},{"text":"Munthu angandichite chiyani?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yehova ali nane; Iye ndiye thandizo langa.","poem":1},{"text":"Ndidzayangʼana adani anga mwachipambano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nʼkwabwino kuthawira kwa Yehova","poem":1},{"text":"kusiyana ndi kudalira munthu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nʼkwabwino kuthawira kwa Yehova","poem":1},{"text":"kusiyana ndi kudalira mafumu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Anthu a mitundu yonse anandizinga,","poem":1},{"text":"koma mʼdzina la Yehova ndinawawononga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anandizinga mbali zonse,","poem":1},{"text":"koma mʼdzina la Yehova ndinawawononga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anandizinga ngati njuchi,","poem":1},{"text":"koma anatha msanga ngati moto wapaminga;","poem":2},{"lineBreak":true},{"text":"mʼdzina la Yehova ndinawawononga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Anandikankha uku ndi uko ndipo ndinali pafupi kugwa,","poem":1},{"text":"koma Yehova anandithandiza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yehova ndiye mphamvu yanga ndi nyimbo yanga;","poem":1},{"text":"Iye wakhala chipulumutso changa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mfuwu wachimwemwe ndi chipambano","poem":1},{"text":"ukumveka mʼmatenti a anthu olungama mtima kuti:","poem":2},{"text":"“Dzanja lamanja la Yehova lachita zamphamvu!","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Dzanja lamanja la Yehova latukulidwa mmwamba","poem":2},{"lineBreak":true},{"text":"Dzanja lamanja la Yehova lachita zamphamvu!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sindidzafa koma ndidzakhala ndi moyo","poem":1},{"text":"ndipo ndidzalalika za ntchito ya Yehova.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yehova wandilanga koopsa,","poem":1},{"text":"koma sanandipereke ku imfa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tsekulireni zipata zachilungamo,","poem":1},{"text":"kuti ndifike kudzayamika Yehova.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ichi ndicho chipata cha Yehova","poem":1},{"text":"chimene olungama mtima okha adzalowerapo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndidzakuyamikani chifukwa Inu munandiyankha;","poem":1},{"text":"mwakhala chipulumutso changa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mwala umene amisiri omanga nyumba anawukana","poem":1},{"text":"wasanduka wapangodya;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yehova ndiye wachita zimenezi","poem":1},{"text":"ndipo nʼzodabwitsa pamaso pathu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lero ndiye tsiku limene Yehova walipanga;","poem":1},{"text":"tiyeni tikondwere ndi kusangalala nalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Inu Yehova, tipulumutseni;","poem":1},{"text":"Yehova, tipambanitseni.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Wodala amene akubwera mʼdzina la Yehova.","poem":1},{"text":"Tikukudalitsani kuchokera ku nyumba ya Yehova.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yehova ndi Mulungu,","poem":1},{"text":"ndipo kuwala kwake kwatiwunikira Ife.","poem":2},{"text":"Lowani nawo pa mʼdipiti wa ku chikondwerero mutanyamula nthambi mʼdzanja lanu,","poem":1},{"text":"mpaka ku nyanga za guwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Inu ndinu Mulungu wanga, ndipo ndidzakuyamikani;","poem":1},{"text":"Inu ndinu Mulungu wanga, ndipo ndidzakukwezani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Yamikani Yehova chifukwa ndi wabwino;","poem":1},{"text":"pakuti chikondi chake chosasinthika ndi chosatha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}