{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":119,"content":[{"type":"verse","number":1,"content":[{"text":"Odala ndi amene moyo wawo ulibe cholakwa,","poem":1},{"text":"amene amayenda monga mwa malamulo a Yehova.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Odala ndi amene amasunga malamulo ake,","poem":1},{"text":"amene amafunafuna Iyeyo ndi mtima wawo wonse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sachita cholakwa chilichonse;","poem":1},{"text":"amayenda mʼnjira zake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inu mwapereka malangizo","poem":1},{"text":"ndipo ayenera kutsatidwa kwathunthu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aa! Ndikanakonda njira zanga zikanakhala zokhazikika","poem":1},{"text":"pa kumvera zophunzitsa zanu!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pamenepo ine sindikanachititsidwa manyazi,","poem":1},{"text":"poganizira malamulo anu onse.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndidzakutamandani ndi mtima wolungama,","poem":1},{"text":"pamene ndikuphunzira malamulo anu olungama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndidzamvera zophunzitsa zanu;","poem":1},{"text":"musanditaye kwathunthu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kodi mnyamata angathe bwanji kuyeretsa mayendedwe ake?","poem":1},{"text":"Akawasamala potsata mawu anu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndimakufunafunani ndi mtima wanga wonse;","poem":1},{"text":"musalole kuti ndisochere kuchoka pa malamulo anu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndasunga mawu anu mu mtima mwanga","poem":1},{"text":"kuti ndisakuchimwireni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mutamandike Inu Yehova;","poem":1},{"text":"phunzitseni malamulo anu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndi milomo yanga ndimafotokoza malamulo anu onse","poem":1},{"text":"amene amachokera pakamwa panu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndimakondwera potsatira malamulo anu","poem":1},{"text":"monga momwe munthu amakondwera akakhala ndi chuma chambiri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndimalingalira malangizo anu","poem":1},{"text":"ndipo ndimaganizira njira zanu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndimakondwera ndi malamulo anu;","poem":1},{"text":"sindidzayiwala konse mawu anu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Chitirani zokoma mtumiki wanu, ndipo ndidzakhala ndi moyo;","poem":1},{"text":"kuti tsono ndisunge mawu anu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tsekulani maso anga kuti ndithe kuona","poem":1},{"text":"zinthu zodabwitsa mʼmalamulo anu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ine ndine mlendo pa dziko lapansi;","poem":1},{"text":"musandibisire malamulo anu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moyo wanga wafowoka polakalaka","poem":1},{"text":"malamulo anu nthawi zonse.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inu mumadzudzula onyada, otembereredwa,","poem":1},{"text":"amene achoka pa malamulo anu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mundichotsere chitonzo ndi mnyozo","poem":1},{"text":"pakuti ndimasunga malamulo anu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngakhale mafumu akhale pamodzi kundinyoza,","poem":1},{"text":"mtumiki wanu adzalingalirabe zophunzitsa zanu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Malamulo anu amandikondweretsa;","poem":1},{"text":"ndiwo amene amandilangiza.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Moyo wanga wakangamira fumbi;","poem":1},{"text":"tsitsimutseni molingana ndi mawu anu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndinafotokoza njira zanga ndipo Inu munandiyankha;","poem":1},{"text":"phunzitseni malamulo anu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mundidziwitse chiphunzitso cha malangizo anu;","poem":1},{"text":"pamenepo ndidzalingalira zodabwitsa zanu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Moyo wanga wafowoka ndi chisoni;","poem":1},{"text":"limbikitseni monga mwa mawu anu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mundichotse mʼnjira zachinyengo;","poem":1},{"text":"mundikomere mtima pondiphunzitsa malamulo anu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ndasankha njira ya choonadi;","poem":1},{"text":"ndayika malamulo anu pa mtima panga.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ndagwiritsitsa umboni wanu, Inu Yehova;","poem":1},{"text":"musalole kuti ndichititsidwe manyazi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ndimathamanga mʼnjira ya malamulo anu,","poem":1},{"text":"pakuti Inu mwamasula mtima wanga.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yehova, phunzitseni kutsatira zophunzitsa zanu;","poem":1},{"text":"ndipo ndidzazisunga mpaka kumapeto.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Mundipatse mtima womvetsa zinthu ndipo ndidzasunga malamulo anu","poem":1},{"text":"ndi kuwamvera ndi mtima wanga wonse.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Munditsogolere mʼnjira ya malamulo anu,","poem":1},{"text":"pakuti mʼmenemo ndimapezamo chikondwerero changa.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Tembenuzani mtima wanga kuti uzikonda malamulo anu,","poem":1},{"text":"osati chuma.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Tembenuzani maso anga kuchoka ku zinthu zachabechabe;","poem":1},{"text":"sungani moyo wanga monga mwa mawu anu.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Kwaniritsani lonjezo lanu kwa mtumiki wanu,","poem":1},{"text":"kuti Inu muopedwe.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Mundichotsere chipongwe chimene ndikuchiopa,","poem":1},{"text":"pakuti malamulo anu ndi abwino.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Taonani, ndimalakalakatu malangizo anu!","poem":1},{"text":"Sungani moyo wanga mʼchilungamo chanu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Chikondi chanu chosasinthika chibwere kwa ine, Inu Yehova,","poem":1},{"text":"chipulumutso chanu monga mwa lonjezo lanu;","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ndipo ndidzayankha amene amandinyoza,","poem":1},{"text":"popeza ndimadalira mawu anu.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Musakwatule mawu a choonadi mʼkamwa mwanga,","poem":1},{"text":"pakuti ndakhazikitsa chiyembekezo changa mʼmalamulo anu.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ndidzasunga malamulo anu nthawi zonse,","poem":1},{"text":"ku nthawi za nthawi.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Ndidzayendayenda mwaufulu,","poem":1},{"text":"chifukwa ndinafunafuna malangizo anu.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Ndidzayankhula za umboni wanu pamaso pa mfumu","poem":1},{"text":"ndipo sindidzachititsidwa manyazi,","poem":2}]},{"type":"verse","number":47,"content":[{"text":"popeza ndimakondwera ndi malamulo anu","poem":1},{"text":"chifukwa ndimawakonda.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ndikweza manja anga ku malamulo anu, ku malamulo amene ndimawakonda,","poem":1},{"text":"ndipo ndimalingalira malangizo anu.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Kumbukirani mawu anu kwa mtumiki wanu,","poem":1},{"text":"popeza mwandipatsa chiyembekezo.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Chitonthozo changa pa masautso anga ndi ichi:","poem":1},{"text":"lonjezo lanu limasunga moyo wanga.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Odzikuza amandinyoza popanda chowaletsa,","poem":1},{"text":"koma sindichoka pa malamulo anu.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Ndimakumbukira malamulo anu Yehova akalekale,","poem":1},{"text":"ndipo mwa iwo ndimapeza chitonthozo.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Ndayipidwa kwambiri chifukwa cha oyipa","poem":1},{"text":"amene ataya malamulo anu.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Zophunzitsa zanu ndi mitu ya nyimbo yanga","poem":1},{"text":"kulikonse kumene ndigonako.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Usiku ndimakumbukira dzina lanu Yehova,","poem":1},{"text":"ndipo ndidzasunga malamulo anu.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ichi ndicho ndakhala ndikuchita:","poem":1},{"text":"ndimasunga malangizo anu.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Yehova, Inu ndiye gawo langa;","poem":1},{"text":"ndalonjeza kumvera mawu anu.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Ndimafunafuna nkhope yanu ndi mtima wanga wonse;","poem":1},{"text":"mundikomere mtima monga mwa lonjezo lanu.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Ndinalingalira za njira zanga","poem":1},{"text":"ndipo ndatembenuza mayendedwe anga kutsatira umboni wanu.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Ndidzafulumira ndipo sindidzazengereza","poem":1},{"text":"kumvera malamulo anu.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Ngakhale oyipa andimange ndi zingwe,","poem":1},{"text":"sindidzayiwala lamulo lanu.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Ndimadzuka pakati pa usiku kuyamika Inu","poem":1},{"text":"chifukwa cha malamulo anu olungama.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Ine ndine bwenzi la onse amene amakukondani,","poem":1},{"text":"kwa onse amene amatsatira malangizo anu.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Dziko lapansi ladzaza ndi chikondi chanu chosasinthika,","poem":1},{"text":"phunzitseni malamulo anu.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Inu Yehova, chitirani chabwino mtumiki wanu","poem":1},{"text":"molingana ndi mawu anu.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Phunzitseni nzeru ndi chiweruzo chabwino,","poem":1},{"text":"pakuti ndimakhulupirira malamulo anu.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Ndisanayambe kuzunzika ndinasochera,","poem":1},{"text":"koma tsopano ndimamvera mawu anu.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Inu ndinu abwino ndipo zimene mumachita ndi zabwino;","poem":1},{"text":"phunzitseni malamulo anu.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Ngakhale odzikuza andipaka mabodza,","poem":1},{"text":"ine ndimasunga malangizo anu ndi mtima wanga wonse.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Mitima yawo ndi yowuma ndi yosakhudzidwa,","poem":1},{"text":"koma ine ndimakondwera ndi malamulo anu.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Ndi bwino kuti ndinasautsidwa","poem":1},{"text":"kuti ndithe kuphunzira malamulo anu.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Lamulo lochokera mʼkamwa mwanu limandikomera kwambiri","poem":1},{"text":"kuposa ndalama zambirimbiri za siliva ndi golide.","poem":2}]},{"type":"verse","number":73,"content":[{"text":"Manja anu anandilenga ndi kundiwumba;","poem":1},{"text":"patseni nzeru zomvetsa zinthu kuti ndiphunzire malamulo anu.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Iwo amene amakuopani akondwere akandiona,","poem":1},{"text":"chifukwa chiyembekezo changa chili mʼmawu anu.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Ine ndikudziwa, Inu Yehova, kuti malamulo anu ndi olungama","poem":1},{"text":"ndipo mwandizunza chifukwa cha kukhulupirika kwanu.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Chikondi chanu chosasinthika chikhale chitonthozo changa,","poem":1},{"text":"molingana ndi lonjezo lanu kwa mtumiki wanu.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Chifundo chanu chindifikire kuti ndikhale ndi moyo,","poem":1},{"text":"popeza malamulo anu ndiye chikondwerero changa.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Odzikuza achititsidwe manyazi chifukwa cha kundilakwira popanda chifukwa;","poem":1},{"text":"koma ine ndidzalingalira malangizo anu.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"Iwo amene amakuopani atembenukire kwa ine,","poem":1},{"text":"iwo amene amamvetsetsa umboni wanu.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Mtima wanga ukhale wopanda cholakwa pa chiphunzitso chanu","poem":1},{"text":"kuti ndisachititsidwe manyazi.","poem":2}]},{"type":"verse","number":81,"content":[{"text":"Moyo wanga wafowoka ndi kufunafuna chipulumutso chanu,","poem":1},{"text":"koma chiyembekezo changa chili mʼmawu anu.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Maso anga alefuka pofunafuna lonjezo lanu;","poem":1},{"text":"Ine ndikuti, “Kodi mudzanditonthoza liti?”","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Ngakhale ndili ngati thumba lachikopa la vinyo pa utsi","poem":1},{"text":"sindiyiwala zophunzitsa zanu.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Kodi mtumiki wanu ayenera kudikira mpaka liti?","poem":1},{"text":"Kodi mudzawalanga liti amene amandizunza?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Anthu osalabadira za Mulungu,","poem":1},{"text":"odzikuza amandikumbira dzenje motsutsana ndi malamulo anu.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Malamulo anu onse ndi odalirika;","poem":1},{"text":"thandizeni, pakuti anthu akundizunza popanda chifukwa.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Iwo anatsala pangʼono kundichotsa pa dziko lapansi","poem":1},{"text":"koma sindinataye malangizo anu.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"Sungani moyo wanga molingana ndi chikondi chanu chosasinthika,","poem":1},{"text":"ndipo ndidzamvera umboni wa pakamwa panu.","poem":2}]},{"type":"verse","number":89,"content":[{"text":"Mawu anu Yehova ndi amuyaya;","poem":1},{"text":"akhazikika kumwambako.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Kukhulupirika kwanu kumakhala mpaka ku mibado yonse;","poem":1},{"text":"Inu munakhazikitsa dziko lapansi ndipo lilipobe.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Malamulo anu alipobe mpaka lero lino,","poem":1},{"text":"pakuti zinthu zonse zimatumikira Inu.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Malamulo anu akanapanda kukhala chikondwerero changa,","poem":1},{"text":"ndikanawonongeka mʼmasautso anga.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Ine sindidzayiwala konse malangizo anu,","poem":1},{"text":"pakuti ndi malangizo anuwo munasunga moyo wanga.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Ndine wanu, ndipulumutseni;","poem":1},{"text":"pakuti ndasamala malangizo anu.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"Anthu oyipa akudikira kuti andiwononge,","poem":1},{"text":"koma ndidzalingalira umboni wanu.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Ndadziwa kuti zinthu zonse zili ndi malire,","poem":1},{"text":"koma malamulo anu alibe malire konse.","poem":2}]},{"type":"verse","number":97,"content":[{"text":"Ndithu, ine ndimakonda malamulo anu!","poem":1},{"text":"Ndimalingaliramo tsiku lonse.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"Malamulo anu amachititsa kuti ndikhale wanzeru kuposa adani anga,","poem":1},{"text":"popeza malamulowo ali ndi ine nthawi zonse.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Ndimamvetsa zinthu kwambiri kuposa aphunzitsi anga onse","poem":1},{"text":"popeza ndimalingalira umboni wanu.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Ndili ndi nzeru zochuluka zomvetsera zinthu kuposa anthu okalamba,","poem":1},{"text":"popeza ndimamvera malangizo anu.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Ndimaletsa miyendo yanga kuyenda mʼnjira iliyonse yoyipa","poem":1},{"text":"kuti ndithe kumvera mawu anu.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Sindinapatuke kuchoka pa malamulo anu,","poem":1},{"text":"pakuti Inu mwini munandiphunzitsa.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Mawu anu ndi otsekemera ndikawalawa,","poem":1},{"text":"otsekemera kuposa uchi mʼkamwa mwanga!","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Ndimapeza nzeru zodziwira zinthu kuchokera mʼmalangizo anu;","poem":1},{"text":"kotero ndimadana ndi njira iliyonse yoyipa.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"Mawu anu ndi nyale ya kumapazi kwanga","poem":1},{"text":"ndi kuwunika kwa pa njira yanga.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Ndalumbira ndipo ndatsimikiza,","poem":1},{"text":"kuti ndidzatsatira malamulo anu olungama.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Ndazunzika kwambiri;","poem":1},{"text":"Inu Yehova, sungani moyo wanga molingana ndi mawu anu.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Inu Yehova, landirani matamando aufulu ochokera pakamwa panga,","poem":1},{"text":"ndipo ndiphunzitseni malamulo anu.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Ngakhale moyo wanga umakhala mʼzoopsa nthawi ndi nthawi,","poem":1},{"text":"sindidzayiwala malamulo anu.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Anthu oyipa anditchera msampha,","poem":1},{"text":"koma sindinasochere kuchoka pa malangizo anu.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Umboni wanu ndiye cholowa changa kwamuyaya;","poem":1},{"text":"Iwo ndiye chimwemwe cha mtima wanga.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Mtima wanga wakhazikika pa kusunga zophunzitsa zanu","poem":1},{"text":"mpaka kumapeto kwenikweni.","poem":2}]},{"type":"verse","number":113,"content":[{"text":"Ndimadana ndi anthu apawiripawiri,","poem":1},{"text":"koma ndimakonda malamulo anu.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"Inu ndinu pothawirapo panga ndi chishango changa;","poem":1},{"text":"chiyembekezo changa chili mʼmawu anu.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Chokani kwa ine, inu anthu ochita zoyipa,","poem":1},{"text":"kuti ndisunge malamulo a Mulungu wanga!","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Mundichirikize molingana ndi lonjezo lanu, ndipo ndidzakhala ndi moyo;","poem":1},{"text":"musalole kuti chiyembekezo changa chipite pachabe.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"Gwirizizeni, ndipo ndidzapulumutsidwa;","poem":1},{"text":"nthawi zonse ndidzasamalira zophunzitsa zanu.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"Inu mumakana onse amene amasochera kuchoka pa zophunzitsa zanu,","poem":1},{"text":"pakuti chinyengo chawo ndi chopanda phindu.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Anthu onse oyipa a pa dziko lapansi mumawayesa ngati zinthu zakudzala;","poem":1},{"text":"nʼchifukwa chake ndimakonda umboni wanu.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Thupi langa limanjenjemera chifukwa cha kuopa Inu;","poem":1},{"text":"ndimachita mantha ndi malamulo anu.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"Ndachita zolungama ndi zabwino;","poem":1},{"text":"musandisiye mʼmanja mwa ondizunza.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"Onetsetsani kuti mtumiki wanu akukhala bwino,","poem":1},{"text":"musalole kuti anthu odzikuza andipondereze.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Maso anga alefuka, kufunafuna chipulumutso chanu,","poem":1},{"text":"kufunafuna lonjezo lanu lolungama.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Muchite naye mtumiki wanu molingana ndi chikondi chanu chosasinthika,","poem":1},{"text":"ndipo mundiphunzitse malamulo anu.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Ine ndine mtumiki wanu; patseni mzimu wondizindikiritsa,","poem":1},{"text":"kuti ndimvetsetse umboni wanu.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Yehova, ndi nthawi yoti muchitepo kanthu;","poem":1},{"text":"malamulo anu akuswedwa.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Chifukwa choti ndimakonda malamulo anu","poem":1},{"text":"kuposa golide, kuposa golide woyengeka bwino,","poem":2}]},{"type":"verse","number":128,"content":[{"text":"ndiponso chifukwa choti ndimaona kuti malangizo anu onse ndi wowongoka,","poem":1},{"text":"ndimadana ndi njira iliyonse yoyipa.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"Maumboni anu ndi odabwitsa","poem":1},{"text":"nʼchifukwa chake ndimawamvera.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Mawu anu akamaphunzitsidwa amapereka kuwunika;","poem":1},{"text":"ngakhale anthu wamba amamvetsetsa.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Ndimatsekula pakamwa panga ndi kupuma wefuwefu,","poem":1},{"text":"kufunafuna malamulo anu.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Tembenukirani kwa ine ndipo mundichitire chifundo,","poem":1},{"text":"monga mumachitira nthawi zonse kwa iwo amene amakonda dzina lanu.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Tsogolerani mayendedwe anga molingana ndi mawu anu;","poem":1},{"text":"musalole kuti tchimo lizindilamulira.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Ndiwomboleni mʼdzanja la anthu ondizunza,","poem":1},{"text":"kuti ndithe kumvera malangizo anu.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Nkhope yanu iwalire mtumiki wanu","poem":1},{"text":"ndipo mundiphunzitse malamulo anu.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Mitsinje ya misozi ikuyenda kuchoka mʼmaso mwanga,","poem":1},{"text":"chifukwa anthu sakumvera malamulo anu.","poem":2}]},{"type":"verse","number":137,"content":[{"text":"Yehova ndinu wolungama,","poem":1},{"text":"ndipo malamulo anu ndi abwino.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Maumboni amene munatipatsa ndi olungama;","poem":1},{"text":"ndi odalirika ndithu.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Ndikusautsidwa kwambiri mʼkati mwanga","poem":1},{"text":"chifukwa adani anu amanyalanyaza mawu anu.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Mawu anu ndi woyera kwambiri","poem":1},{"text":"nʼchifukwa chake mtumiki wanune ndimawakonda.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Ngakhale ndili wamngʼono ndi wonyozeka,","poem":1},{"text":"sindiyiwala malangizo anu.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"Chilungamo chanu nʼchamuyaya,","poem":1},{"text":"ndipo malamulo anu nʼchoona.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Mavuto ndi masautso zandigwera,","poem":1},{"text":"koma ndimakondwera ndi malamulo anu.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Umboni wanu ndi wabwino nthawi zonse;","poem":1},{"text":"patseni nzeru zomvetsa zinthu kuti ine ndikhale ndi moyo.","poem":2}]},{"type":"verse","number":145,"content":[{"text":"Ndimayitana ndi mtima wanga wonse; ndiyankheni Inu Yehova,","poem":1},{"text":"ndipo ndidzamvera zophunzitsa zanu.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"Ndikuyitana kwa Inu; pulumutseni","poem":1},{"text":"ndipo ndidzasunga umboni wanu.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"Ndimadzuka tambala asanalire kuti ndipemphe thandizo;","poem":1},{"text":"chiyembekezo changa chili mʼmawu anu.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Maso anga amakhala chipenyere nthawi yonse ya usiku,","poem":1},{"text":"kuti ndithe kulingalira malonjezo anu.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Imvani mawu anga molingana ndi chikondi chanu chosasinthika;","poem":1},{"text":"Yehova sungani moyo wanga, molingana ndi malamulo anu.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Iwo amene amakonza njira zoyipa andiyandikira,","poem":1},{"text":"koma ali kutali ndi malamulo anu.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"Koma Inu Yehova muli pafupi,","poem":1},{"text":"malamulo anu onse ndi woona.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Ndinaphunzira kalekale kuchokera mʼmaumboni anu","poem":1},{"text":"kuti maumboni amene munakhazikitsawo ndi amuyaya.","poem":2}]},{"type":"verse","number":153,"content":[{"text":"Yangʼanani masautso anga ndipo mundipulumutse,","poem":1},{"text":"pakuti sindinayiwale malamulo anu.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Mundiyimirire pa mlandu wanga ndi kundiwombola;","poem":1},{"text":"sungani moyo wanga molingana ndi lonjezo lanu.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Chipulumutso chili kutali ndi anthu oyipa,","poem":1},{"text":"pakuti iwowo safunafuna zophunzitsa zanu.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Chifundo chanu Yehova nʼchachikulu;","poem":1},{"text":"sungani moyo wanga molingana ndi malamulo anu.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Adani amene akundizunza ndi ambiri,","poem":1},{"text":"koma ine sindinatembenuke kuchoka pa umboni wanu.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"Ndimawayangʼana monyansidwa anthu opanda chikhulupiriro,","poem":1},{"text":"popeza samvera mawu anu.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"Onani momwe ndimakondera malangizo anu;","poem":1},{"text":"sungani moyo wanga, Inu Yehova, molingana ndi chikondi chanu chosanthika.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Mawu anu onse ndi owona;","poem":1},{"text":"malamulo anu onse olungama ndi amuyaya.","poem":2}]},{"type":"verse","number":161,"content":[{"text":"Olamulira amandizunza popanda chifukwa,","poem":1},{"text":"koma mtima wanga umanjenjemera ndi mawu anu.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Ine ndimakondwa ndi lonjezo lanu,","poem":1},{"text":"ngati munthu amene wapeza chuma chambiri.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Ndimadana ndi chinyengo, kwambiri ndimanyansidwa nacho,","poem":1},{"text":"koma ndimakonda malamulo anu.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Ndimakutamandani kasanu ndi kawiri pa tsiku","poem":1},{"text":"pakuti malamulo anu ndi olungama.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Amene amakonda malamulo anu ali ndi mtendere waukulu,","poem":1},{"text":"ndipo palibe chimene chingawapunthwitse","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Ndikudikira chipulumutso chanu, Inu Yehova,","poem":1},{"text":"ndipo ndimatsatira malamulo anu.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Ndimamvera umboni wanu","poem":1},{"text":"pakuti ndimawukonda kwambiri.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"Ndimamvera malangizo anu ndi umboni wanu,","poem":1},{"text":"pakuti njira zanga zonse ndi zodziwika pamaso panu.","poem":2}]},{"type":"verse","number":169,"content":[{"text":"Kulira kwanga kufike pamaso panu Yehova;","poem":1},{"text":"patseni nzeru zomvetsa zinthu molingana ndi mawu anu.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Kupempha kwanga kufike pamaso panu;","poem":1},{"text":"pulumutseni molingana ndi lonjezo lanu.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Matamando asefukire pa milomo yanga,","poem":1},{"text":"pakuti Inu mumandiphunzitsa malamulo anu.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Lilime langa liyimbe mawu anu,","poem":1},{"text":"popeza malamulo anu onse ndi olungama.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Dzanja lanu likhale lokonzeka kundithandiza","poem":1},{"text":"pakuti ndasankha malangizo anu.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Ndikufunitsitsa chipulumutso chanu Yehova,","poem":1},{"text":"ndipo ndimakondwera ndi malamulo anu.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Loleni kuti ndikhale ndi moyo kuti ndikutamandeni,","poem":1},{"text":"ndipo malamulo anu andichirikize.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Ndasochera ngati nkhosa yotayika,","poem":1},{"text":"funafunani mtumiki wanu,","poem":2},{"lineBreak":true},{"text":"pakuti sindinayiwale malamulo anu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}