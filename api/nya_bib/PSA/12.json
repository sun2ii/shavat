{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Monga mwa mayimbidwe seminiti. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Thandizeni Yehova pakuti palibe munthu wokhulupirika;","poem":1},{"text":"okhulupirika akusowa pakati pa anthu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aliyense amanamiza mʼbale wake;","poem":1},{"text":"ndi pakamwa pawo pabodza amayankhula zachinyengo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Inu Yehova tsekani milomo yonse yachinyengo","poem":1},{"text":"ndi pakamwa paliponse podzikuza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pakamwa pamene pamati, “Ife tidzapambana ndi kuyankhula kwathu;","poem":1},{"text":"pakamwapa ndi pathupathu, tsono mbuye wathu ndani?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Chifukwa cha kuponderezedwa kwa anthu opanda mphamvu","poem":1},{"text":"ndi kubuwula kwa anthu osowa,","poem":2},{"text":"Ine ndidzauka tsopano,” akutero Yehova,","poem":1},{"text":"“Ndidzawateteza kwa owazunza.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndipo mawu a Yehova ndi angwiro","poem":1},{"text":"monga siliva oyengedwa mʼngʼanjo yadothi,","poem":2},{"lineBreak":true},{"text":"oyengedwa kasanu nʼkawiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Inu Yehova mudzatitchinjiriza ndipo","poem":1},{"text":"mudzatiteteza kwa anthu otere kwamuyaya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Oyipa amangoyendayenda ponseponse","poem":1},{"text":"anthu akamayamikira zochita zawo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}