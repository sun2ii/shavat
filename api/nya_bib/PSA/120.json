{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Nyimbo yoyimba pokwera ku Yerusalemu."]},{"type":"verse","number":1,"content":[{"text":"Ndimafuwulira kwa Yehova mʼmasautso anga,","poem":1},{"text":"ndipo Iye amandiyankha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pulumutseni Yehova ku milomo yabodza,","poem":1},{"text":"ndi kwa anthu achinyengo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kodi adzakuchitani chiyani,","poem":1},{"text":"ndipo adzawonjezerapo zotani, inu anthu achinyengo?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adzakulangani ndi mivi yakuthwa ya munthu wankhondo,","poem":1},{"text":"ndi makala oyaka a mtengo wa tsanya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tsoka ine kuti ndimakhala ku Mesaki,","poem":1},{"text":"kuti ndimakhala pakati pa matenti a ku Kedara!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa nthawi yayitali ndakhala pakati","poem":1},{"text":"pa iwo amene amadana ndi mtendere.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ine ndine munthu wamtendere;","poem":1},{"text":"koma ndikamayankhula, iwo amafuna nkhondo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}