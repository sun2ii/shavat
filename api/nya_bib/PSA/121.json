ana,","poem":1},{"text":"kapena mwezi nthawi ya usiku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yehova adzakuteteza ku zoyipa zonse;","poem":1},{"text":"adzasunga moyo wako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yehova adzayangʼanira kutuluka kwako ndi kulowa kwako;","poem":1},{"text":"kuyambira tsopano mpaka muyaya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}