{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide. Nyimbo yoyimba pokwera ku Yerusalemu."]},{"type":"verse","number":1,"content":[{"text":"Ndinakondwera atandiwuza kuti,","poem":1},{"text":"“Tiyeni ku nyumba ya Yehova.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mapazi athu akuyima mʼzipata","poem":1},{"text":"zako, Iwe Yerusalemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yerusalemu anamangidwa ngati mzinda","poem":1},{"text":"umene uli wothithikana pamodzi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kumeneko ndiye kumene kumapita mafuko,","poem":1},{"text":"mafuko a Yehova,","poem":2},{"text":"umboni wa kwa Israeli,","poem":1},{"text":"kuti atamande dzina la Yehova.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kumeneko anayikako mipando yaufumu yachiweruzo,","poem":1},{"text":"mipando yaufumu ya nyumba ya Davide.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pemphererani mtendere wa Yerusalemu:","poem":1},{"text":"“Iwo amene amakukonda iwe zinthu ziwayendere bwino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mukhale mtendere mʼkati mwa makoma ako,","poem":1},{"text":"ndipo mʼnyumba zako zaufumu mukhale chitetezo.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Chifukwa cha abale anga ndi abwenzi anga","poem":1},{"text":"ndidzati, “Mtendere ukhale mʼkati mwako.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chifukwa cha Nyumba ya Yehova Mulungu wathu,","poem":1},{"text":"ndidzakufunira zabwino.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}