":5,"content":[{"text":"Wodala munthu","poem":1},{"text":"amene motengera mivi mwake mwadzaza.","poem":2},{"text":"Iwo sadzachititsidwa manyazi","poem":1},{"text":"pamene alimbana ndi adani awo pa zipata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}