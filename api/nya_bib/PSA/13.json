{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Mpaka liti Yehova? Kodi mudzandiyiwala mpaka kalekale?","poem":1},{"text":"Mpaka liti mudzandibisira nkhope yanu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndidzalimbana ndi maganizo anga","poem":1},{"text":"ndi kukhala ndi chisoni mu mtima mwanga tsiku lililonse mpaka liti?","poem":2},{"lineBreak":true},{"text":"Mpaka liti adani anga adzandipambana?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ndiyangʼaneni ndi kundiyankha, Inu Yehova Mulungu wanga.","poem":1},{"text":"Walitsani maso anga kuti ndingafe;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"mdani wanga adzati, “Ndamugonjetsa,”","poem":1},{"text":"ndipo adani anga adzakondwera pamene ine ndagwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Koma ndikudalira chikondi chanu chosasinthika;","poem":1},{"text":"mtima wanga umakondwera ndi chipulumutso chanu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ine ndidzayimbira Yehova","poem":1},{"text":"pakuti wandichitira zokoma.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}