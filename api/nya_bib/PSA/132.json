{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["Nyimbo yoyimba pokwera ku Yerusalemu."]},{"type":"verse","number":1,"content":[{"text":"Inu Yehova, kumbukirani Davide","poem":1},{"text":"ndi mavuto onse anapirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Iye analumbira kwa Yehova","poem":1},{"text":"ndi kulonjeza kwa Wamphamvu wa Yakobo kuti,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Sindidzalowa mʼnyumba mwanga","poem":1},{"text":"kapena kugona pa bedi langa:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"sindidzalola kuti maso anga agone,","poem":1},{"text":"kapena zikope zanga ziwodzere,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"mpaka nditamupezera malo Yehova,","poem":1},{"text":"malo okhala a Wamphamvu wa Yakobo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Zoonadi, tinamva za Bokosi la Chipangano ku Efurata,","poem":1},{"text":"tinalipeza mʼminda ya ku Yaara:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Tiyeni tipite ku malo ake okhalamo;","poem":1},{"text":"tiyeni tikamulambire pa mapazi ake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"‘Dzukani Yehova, ndipo bwerani ku malo anu opumulira,","poem":1},{"text":"Inuyo ndi Bokosi la Chipangano limene limafanizira mphamvu zanu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ansembe anu avekedwe chilungamo;","poem":1},{"text":"anthu anu oyera mtima ayimbe nyimbo mwachimwemwe.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Chifukwa cha Davide mtumiki wanu,","poem":1},{"text":"musakane wodzozedwa wanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yehova analumbira kwa Davide,","poem":1},{"text":"lumbiro lotsimikizika kuti Iye sadzasintha:","poem":2},{"text":"“Mmodzi wa ana ako","poem":1},{"text":"ndidzamuyika pa mpando waufumu;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ngati ana ako azisunga pangano langa","poem":1},{"text":"ndi malamulo amene ndiwaphunzitsa,","poem":2},{"text":"pamenepo ana awo adzakhala pa mpando","poem":1},{"text":"wako waufumu kwamuyaya ndi muyaya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pakuti Yehova wasankha Ziyoni,","poem":1},{"text":"Iye wakhumba kuti akhale malo ake okhalamo:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Awa ndi malo anga opumapo ku nthawi za nthawi;","poem":1},{"text":"ndidzakhala pano pa mpando waufumu, pakuti ndakhumba zimenezi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndidzadalitsa mzindawu ndi zinthu zambiri;","poem":1},{"text":"anthu ake osauka ndidzawakhutitsa ndi chakudya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndidzaveka ansembe ake chipulumutso,","poem":1},{"text":"ndipo anthu ake oyera mtima adzayimba nthawi zonse nyimbo zachimwemwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Pano ndidzachulukitsa mphamvu za Davide","poem":1},{"text":"ndi kuyikapo nyale ya wodzozedwa wanga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndidzaveka adani ake manyazi,","poem":1},{"text":"koma chipewa chaufumu pamutu pake chidzakhala chowala.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}