{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Yamikani Yehova chifukwa ndi wabwino.","poem":1},"Pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":2,"content":[{"text":"Yamikani Mulungu wa milungu.","poem":1},"Pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":3,"content":[{"text":"Yamikani Ambuye wa ambuye,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iye yekhayo amene amachita zodabwitsa zazikulu,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":5,"content":[{"text":"Amene mwachidziwitso chake anapanga mayiko akumwamba,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":6,"content":[{"text":"Amene anayala dziko lapansi pamwamba pa madzi,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":7,"content":[{"text":"Amene anapanga miyuni ikuluikulu,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":8,"content":[{"text":"Dzuwa lilamulire usana,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":9,"content":[{"text":"Mwezi ndi nyenyezi zilamulire usiku,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Amene anakantha ana woyamba kubadwa a Igupto,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":11,"content":[{"text":"Natulutsa Israeli pakati pawo,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":12,"content":[{"text":"Ndi dzanja lamphamvu ndi mkono wotambasuka,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Amene anagawa Nyanja Yofiira pakati,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":14,"content":[{"text":"Nadutsitsa Israeli pakati pa nyanjayo,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":15,"content":[{"text":"Koma anakokolola Farao ndi ankhondo ake mʼNyanja Yofiira,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Amene anatsogolera anthu ake mʼchipululu","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":17,"content":[{"text":"Amene anakantha mafumu akuluakulu,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":18,"content":[{"text":"Napha mafumu amphamvu,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":19,"content":[{"text":"Siloni mfumu ya Aamori,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":20,"content":[{"text":"Ogi mfumu ya Basani,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":21,"content":[{"text":"Napereka dziko lawo ngati cholowa,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":22,"content":[{"text":"Cholowa cha mtumiki wake Israeli;","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Amene anatikumbukira ife anthu opeputsidwa,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":24,"content":[{"text":"Amene anatimasula kwa adani athu,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"verse","number":25,"content":[{"text":"Amene amapereka chakudya kwa cholengedwa chilichonse,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Yamikani Mulungu wakumwamba,","poem":1},"pakuti chikondi chake chosasinthika nʼchamuyaya."]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}