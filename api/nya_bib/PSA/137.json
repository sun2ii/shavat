{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Mʼmbali mwa mitsinje ya ku Babuloni tinakhala pansi ndi kulira","poem":1},{"text":"pamene tinakumbukira Ziyoni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kumeneko, pa mitengo ya misondozi","poem":1},{"text":"tinapachika apangwe athu,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"pakuti anthu otigwira ukapolo anatipempha kuti tiyimbe nyimbo.","poem":1},{"text":"Otizunza athu anafuna nyimbo zachisangalalo;","poem":2},{"lineBreak":true},{"text":"iwo anati, “Tiyimbireni imodzi mwa nyimbo za ku Ziyoni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tingayimbe bwanji nyimbo za Yehova","poem":1},{"text":"mʼdziko lachilendo?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndikakuyiwala iwe Yerusalemu,","poem":1},{"text":"dzanja langa lamanja liyiwale luso lake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lilime langa limamatire ku nkhama za mʼkamwa mwanga","poem":1},{"text":"ndikapanda kukukumbukira iwe Yerusalemu,","poem":2},{"text":"ngati sindiyesa iwe","poem":1},{"text":"chimwemwe changa chachikulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kumbukirani, Inu Yehova, zimene Aedomu anachita","poem":1},{"text":"pa tsiku limene Yerusalemu anagonja.","poem":2},{"text":"Iwowo anafuwula kuti, “Mugwetseni pansi, mugwetseni pansi","poem":1},{"text":"mpaka pa maziko ake!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Iwe mwana wa mkazi wa Babuloni, woyenera kuwonongedwa,","poem":1},{"text":"wodalitsika ndi yemwe adzakubwezera","poem":2},{"lineBreak":true},{"text":"pa zimene watichitira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amene adzagwira makanda ako","poem":1},{"text":"ndi kuwakankhanthitsa pa miyala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}