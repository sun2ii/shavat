{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Inu Yehova, mwandisanthula","poem":1},{"text":"ndipo mukundidziwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inu mumadziwa pamene ndikhala pansi ndi pamene ndidzuka;","poem":1},{"text":"mumazindikira maganizo anga muli kutali.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mumapenyetsetsa pamene ndikutuluka ndi kugona kwanga;","poem":1},{"text":"mumadziwa njira zanga zonse.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mawu asanatuluke pa lilime langa","poem":1},{"text":"mumawadziwa bwinobwino, Inu Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mumandizinga kumbuyo ndi kutsogolo komwe;","poem":1},{"text":"mwasanjika dzanja lanu pa ine.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nzeru zimenezi ndi zopitirira nzeru zanga,","poem":1},{"text":"ndi zapamwamba kuti ine ndizipeze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kodi ndingapite kuti kufuna kuzemba Mzimu wanu?","poem":1},{"text":"Kodi ndingathawire kuti kuchoka pamaso panu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndikakwera kumwamba, Inu muli komweko;","poem":1},{"text":"ndikakagona ku malo a anthu akufa, Inu muli komweko.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngati ndiwulukira kotulukira dzuwa,","poem":1},{"text":"ngati ndikakhala ku malekezero a nyanja,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kumenekonso dzanja lanu lidzanditsogolera,","poem":1},{"text":"dzanja lanu lamanja lidzandigwiriziza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ndikanena kuti, “Zoonadi, mdima udzandibisa ndithu","poem":1},{"text":"ndipo kuwunika kukhale mdima mondizungulira,”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"komabe mdimawo sudzakhala mdima kwa Inu;","poem":1},{"text":"usiku udzawala ngati masana,","poem":2},{"lineBreak":true},{"text":"pakuti mdima uli ngati kuwunika kwa Inu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pakuti Inu munalenga za mʼkati mwanga;","poem":1},{"text":"munandiwumba pamodzi mʼmimba mwa amayi anga.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndimakuyamikani chifukwa ndinapangidwa mochititsa mantha ndi modabwitsa;","poem":1},{"text":"ntchito zanu ndi zodabwitsa,","poem":2},{"lineBreak":true},{"text":"zimenezi ndimazidziwa bwino lomwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mapangidwe anga sanabisike pamaso panu","poem":1},{"text":"pamene ndimapangidwa mʼmalo achinsinsi,","poem":2},{"text":"pamene ndinkawumbidwa mwaluso mʼmimba ya amayi anga.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Maso anu anaona thupi langa lisanawumbidwe.","poem":1},{"text":"Masiku onse amene anapatsidwa kwa ine, analembedwa mʼbuku lanu","poem":2},{"lineBreak":true},{"text":"asanayambe nʼkuwerengedwa komwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zolingalira zanu pa ine ndi zamtengowapatali, Inu Mulungu,","poem":1},{"text":"ndi zosawerengeka ndithu!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndikanaziwerenga,","poem":1},{"text":"zikanakhala zochuluka kuposa mchenga;","poem":2},{"lineBreak":true},{"text":"pamene ndadzuka, ndili nanube.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ndi bwino mukanangopha anthu oyipa, Inu Mulungu!","poem":1},{"text":"Chokereni inu anthu owononga anzanu!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Amayankhula za Inu ndi zolinga zoyipa;","poem":1},{"text":"adani anu amagwiritsa ntchito dzina lanu molakwika.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kodi ine sindidana nawo amene amakudani, Inu Yehova?","poem":1},{"text":"Kodi sindinyansidwa nawo amene amakuwukirani?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ndimadana nawo kwathunthu;","poem":1},{"text":"ndi adani anga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Santhuleni, Inu Mulungu ndipo mudziwe mtima wanga;","poem":1},{"text":"Yeseni ndipo mudziwe zolingalira zanga.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Onani ngati muli mayendedwe aliwonse oyipa mwa ine,","poem":1},{"text":"ndipo munditsogolere mʼnjira yanu yamuyaya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}