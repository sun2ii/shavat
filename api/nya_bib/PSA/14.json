{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Chitsiru chimati mu mtima mwake,","poem":1},{"text":"“Kulibe Mulungu.”","poem":2},{"text":"Oterewa ndi oyipa ndipo ntchito zawo ndi zonyansa;","poem":1},{"text":"palibe amene amachita zabwino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yehova kumwamba wayangʼana pansi,","poem":1},{"text":"kuyangʼana anthu onse","poem":2},{"text":"kuti aone ngati alipo wina wanzeru,","poem":1},{"text":"amene amafunafuna Mulungu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onse atembenukira kumbali,","poem":1},{"text":"onse pamodzi asanduka oyipa;","poem":2},{"text":"palibe amene amachita zabwino,","poem":1},{"text":"palibiretu ndi mmodzi yemwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kodi anthu ochita zoyipawa sadziwa chilichonse?","poem":1},{"text":"Akudya anthu anga ngati chakudya chawo","poem":2},{"lineBreak":true},{"text":"ndipo satamanda Yehova?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Awo ali apowo, agwidwa ndi mantha aakulu,","poem":1},{"text":"pakuti Mulungu ali mʼgulu la olungama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inu ochita zoyipa mumalepheretsa chikonzero cha anthu osauka,","poem":1},{"text":"koma Yehova ndiye pothawirapo pawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ndithu, chipulumutso cha Israeli chidzachokera ku Ziyoni!","poem":1},{"text":"Pamene Yehova abwezeretsa ufulu wa anthu ake,","poem":2},{"lineBreak":true},{"text":"Yakobo akondwere ndipo Israeli asangalale!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}