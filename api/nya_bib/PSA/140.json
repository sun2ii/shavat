{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Landitseni Yehova kwa anthu oyipa;","poem":1},{"text":"tetezeni kwa anthu ankhanza,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"amene mu mtima mwawo amakonza zinthu zoyipa","poem":1},{"text":"ndi kuyambitsa nkhondo tsiku lililonse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iwo amanola malilime awo kukhala akuthwa ngati a njoka;","poem":1},{"text":"pa milomo yawo pali ululu wa mamba.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tetezeni Inu Yehova, kwa anthu oyipa;","poem":1},{"text":"tchinjirizeni kwa anthu ankhanza","poem":2},{"lineBreak":true},{"text":"amene amakonza zokola mapazi anga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anthu odzikuza anditchera msampha mobisika;","poem":1},{"text":"iwo atchera zingwe za maukonde awo","poem":2},{"lineBreak":true},{"text":"ndipo anditchera misampha pa njira yanga.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Inu Yehova, ine ndikuti, “Ndinu Mulungu wanga.”","poem":1},{"text":"Imvani kupempha kwanga Yehova.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inu Ambuye Wamphamvuzonse, Mpulumutsi wanga wamphamvu,","poem":1},{"text":"mumateteza mutu wanga tsiku lankhondo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Musawapatse anthu oyipa zokhumba zawo, Inu Yehova;","poem":1},{"text":"musalole kuti zokonza zawo zitheke,","poem":2},{"lineBreak":true},{"text":"mwina iwo adzayamba kunyada.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mitu ya amene andizungulira","poem":1},{"text":"iphimbidwe ndi masautso amene milomo yawo yayambitsa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Makala amoto agwere pa iwo;","poem":1},{"text":"aponyedwe pa moto,","poem":2},{"lineBreak":true},{"text":"mʼmaenje amatope, asatulukemonso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Musalole kuti anthu achipongwe akhazikike mʼdziko;","poem":1},{"text":"choyipa chilondole anthu ankhanza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndikudziwa kuti Yehova amapereka chiweruzo cholungama kwa anthu osauka,","poem":1},{"text":"ndipo amateteza zolinga za anthu osowa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zoonadi anthu olungama adzatamanda dzina lanu,","poem":1},{"text":"ndipo anthu owongoka mtima adzakhala pamaso panu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}