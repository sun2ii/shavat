{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Ndakatulo ya Davide, pamene iyeyo anali mʼphanga. Pemphero."]},{"type":"verse","number":1,"content":[{"text":"Ndikulirira Yehova mofuwula;","poem":1},{"text":"ndikukweza mawu anga kwa Yehova kupempha chifundo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndikukhuthula madandawulo anga pamaso pake;","poem":1},{"text":"ndikufotokoza za masautso anga pamaso pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pamene mzimu wanga walefuka mʼkati mwanga,","poem":1},{"text":"ndinu amene mudziwa njira yanga.","poem":2},{"text":"Mʼnjira imene ndimayendamo","poem":1},{"text":"anthu anditchera msampha mobisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yangʼanani kumanja kwanga ndipo onani;","poem":1},{"text":"palibe amene akukhudzika nane.","poem":2},{"text":"Ndilibe pothawira;","poem":1},{"text":"palibe amene amasamala za moyo wanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndilirira Inu Yehova;","poem":1},{"text":"ndikuti, “Ndinu pothawirapo panga,","poem":2},{"lineBreak":true},{"text":"gawo langa mʼdziko la anthu amoyo.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mverani kulira kwanga","poem":1},{"text":"pakuti ndathedwa nzeru;","poem":2},{"text":"pulumutseni kwa amene akundithamangitsa","poem":1},{"text":"pakuti ndi amphamvu kuposa ine.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tulutseni mʼndende yanga","poem":1},{"text":"kuti nditamande dzina lanu.","poem":2},{"lineBreak":true},{"text":"Ndipo anthu olungama adzandizungulira","poem":1},{"text":"chifukwa cha zabwino zanu pa ine.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}