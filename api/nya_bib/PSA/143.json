{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Yehova imvani pemphero langa,","poem":1},{"text":"mvetserani kulira kwanga kopempha chifundo;","poem":2},{"text":"mwa kukhulupirika kwanu ndi chilungamo chanu","poem":1},{"text":"bwerani kudzandithandiza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Musazenge mlandu mtumiki wanu,","poem":1},{"text":"pakuti palibe munthu wamoyo amene ndi wolungama pamaso panu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mdani akundithamangitsa,","poem":1},{"text":"iye wandipondereza pansi;","poem":2},{"text":"wachititsa kuti ndikhale mu mdima","poem":1},{"text":"ngati munthu amene anafa kale.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Choncho mzimu wanga ukufowoka mʼkati mwanga;","poem":1},{"text":"mʼkati mwanga, mtima wanga uli ndi nkhawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndimakumbukira masiku amakedzana;","poem":1},{"text":"ndimalingalira za ntchito yanu yonse,","poem":2},{"lineBreak":true},{"text":"ndimaganizira zimene manja anu anachita.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndatambalitsa manja anga kwa Inu;","poem":1},{"text":"moyo wanga uli ndi ludzu lofuna Inu monga nthaka yowuma.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yehova ndiyankheni msanga;","poem":1},{"text":"mzimu wanga ukufowoka.","poem":2},{"text":"Musandibisire nkhope yanu,","poem":1},{"text":"mwina ndidzakhala ngati iwo amene atsikira ku dzenje.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lolani kuti mmawa ubweretse mawu achikondi chanu chosasinthika,","poem":1},{"text":"pakuti ine ndimadalira Inu.","poem":2},{"text":"Mundisonyeze njira yoti ndiyendemo,","poem":1},{"text":"pakuti kwa Inu nditukulira moyo wanga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pulumutseni kwa adani anga, Inu Yehova,","poem":1},{"text":"pakuti ndimabisala mwa Inu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Phunzitseni kuchita chifuniro chanu,","poem":1},{"text":"popeza ndinu Mulungu wanga;","poem":2},{"text":"Mzimu wanu wabwino unditsogolere","poem":1},{"text":"pa njira yanu yosalala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sungani moyo wanga Inu Yehova chifukwa cha dzina lanu;","poem":1},{"text":"mwa chilungamo chanu tulutseni mʼmasautso anga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mwa chikondi chanu chosasinthika khalitsani chete adani anga;","poem":1},{"text":"wonongani adani anga,","poem":2},{"lineBreak":true},{"text":"pakuti ndine mtumiki wanu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}