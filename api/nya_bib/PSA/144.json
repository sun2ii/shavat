{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Atamandike Yehova Thanthwe langa,","poem":1},{"text":"amene amaphunzitsa manja anga kuchita nkhondo;","poem":2},{"lineBreak":true},{"text":"zala zanga kumenya nkhondo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iye ndiye Mulungu wanga wachikondi ndi malo anga otetezedwa,","poem":1},{"text":"linga langa ndi mpulumutsi wanga,","poem":2},{"text":"chishango changa mmene ine ndimathawiramo,","poem":1},{"text":"amene amagonjetsa mitundu ya anthu pansi panga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Inu Yehova, munthu nʼchiyani kuti mumamusamalira,","poem":1},{"text":"mwana wa munthu kuti muzimuganizira?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Munthu ali ngati mpweya;","poem":1},{"text":"masiku ake ali ngati mthunzi wosakhalitsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngʼambani mayiko akumwamba, Inu Yehova, ndipo tsikani pansi;","poem":1},{"text":"khudzani mapiri kuti atulutse utsi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tumizani zingʼaningʼani ndi kubalalitsa adani;","poem":1},{"text":"ponyani mivi yanu ndi kuwathamangitsa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tambasulani dzanja lanu kuchokera kumwamba;","poem":1},{"text":"landitseni ndi kundipulumutsa,","poem":2},{"text":"ku madzi amphamvu,","poem":1},{"text":"mʼmanja mwa anthu achilendo,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"amene pakamwa pawo ndi podzala ndi mabodza,","poem":1},{"text":"amene dzanja lawo lamanja ndi lachinyengo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndidzakuyimbirani nyimbo yatsopano Inu Mulungu;","poem":1},{"text":"ndidzakuyimbirani nyimbo pa zeze wa nsambo khumi,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kwa Iye amene amapambanitsa mafumu,","poem":1},{"text":"amene amapulumutsa Davide mtumiki wake ku lupanga loopsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Landitseni ndi kundipulumutsa,","poem":1},{"text":"mʼmanja mwa anthu achilendo,","poem":2},{"text":"amene pakamwa pawo ndi podzaza ndi mabodza,","poem":1},{"text":"amene dzanja lawo lamanja ndi lachinyengo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndipo ana aamuna pa chinyamata chawo","poem":1},{"text":"adzakhala ngati mbewu yosamalidwa bwino,","poem":2},{"text":"ana athu aakazi adzakhala ngati zipilala","poem":1},{"text":"zosemedwa bwino, zokongoletsera nyumba yaufumu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nkhokwe zathu zidzakhala zodzaza","poem":1},{"text":"ndi zokolola za mtundu uliwonse.","poem":2},{"text":"Nkhosa zathu zidzaswana miyandamiyanda","poem":1},{"text":"pa mabusa athu.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ngʼombe zathu zidzanyamula katundu wolemera.","poem":2},{"text":"Sipadzakhala mingʼalu pa makoma,","poem":1},{"text":"sipadzakhalanso kupita ku ukapolo,","poem":2},{"lineBreak":true},{"text":"mʼmisewu mwathu simudzakhala kulira chifukwa cha mavuto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Odala anthu amene adzalandira madalitso awa;","poem":1},{"text":"odala anthu amene Mulungu wawo ndi Yehova.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}