{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Tamandani Yehova.","poem":1},{"lineBreak":true},{"text":"Tamanda Yehova, iwe moyo wanga.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ndidzatamanda Yehova ndi moyo wanga wonse;","poem":2},{"lineBreak":true},{"text":"ndidzayimba nyimbo zamatamando kwa Mulungu wanga nthawi yonse ya moyo wanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Musamadalire mafumu,","poem":1},{"text":"anthu osakhalitsa, amene sangathe kupulumutsa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pamene mizimu yawo yachoka, iwo amabwerera ku dothi;","poem":1},{"text":"zimene ankafuna kuchita zimatha tsiku lomwelo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wodala ndi amene thandizo lake ndi","poem":1},{"text":"Mulungu wa Yakobo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wolenga kumwamba ndi dziko lapansi,","poem":1},{"text":"nyanja ndi zonse zili mʼmenemo;","poem":2},{"lineBreak":true},{"text":"Yehova, amene ndi wokhulupirika kwamuyaya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iye amachitira chilungamo anthu oponderezedwa","poem":1},{"text":"ndipo amapereka chakudya kwa anthu anjala.","poem":2},{"text":"Yehova amamasula amʼndende,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Yehova amatsekula maso anthu osaona,","poem":2},{"text":"Yehova amadzutsa onse amene awerama pansi,","poem":1},{"text":"Yehova amakonda anthu olungama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yehova amasamalira alendo","poem":1},{"text":"ndipo amathandiza ana ndi akazi amasiye,","poem":2},{"lineBreak":true},{"text":"koma amasokoneza njira za anthu oyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yehova ndiye Mfumu mpaka muyaya,","poem":1},{"text":"Mulungu wako iwe Ziyoni, pa mibado yonse.","poem":2},{"lineBreak":true},{"text":"Tamandani Yehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}