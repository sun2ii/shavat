{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Tamandani Yehova.","poem":1},{"lineBreak":true},{"text":"Nʼkwabwino kwambiri kuyimba nyimbo zamatamando kwa Mulungu wathu,","poem":1},{"text":"nʼkokondweretsa ndi koyenera kumutamanda!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yehova akumanga Yerusalemu;","poem":1},{"text":"Iye akusonkhanitsa amʼndende a Israeli.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akutsogolera anthu osweka mtima","poem":1},{"text":"ndi kumanga mabala awo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Amadziwa chiwerengero cha nyenyezi,","poem":1},{"text":"ndipo iliyonse amayitchula dzina.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yehova ndi wamkulu ndi wamphamvu kwambiri;","poem":1},{"text":"nzeru zake zilibe malire.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yehova amagwiriziza anthu odzichepetsa,","poem":1},{"text":"koma amagwetsa pansi anthu oyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Imbirani Yehova ndi mayamiko;","poem":1},{"text":"imbani nyimbo kwa Mulungu ndi pangwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iye amaphimba mlengalenga ndi mitambo;","poem":1},{"text":"amapereka mvula ku dziko lapansi","poem":2},{"lineBreak":true},{"text":"ndi kumeretsa udzu mʼmapiri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iye amapereka chakudya kwa ngʼombe","poem":1},{"text":"ndi kwa ana a makwangwala pamene akulira chakudya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Chikondwerero chake sichili mʼmphamvu za kavalo,","poem":1},{"text":"kapena mʼmiyendo ya anthu amphamvu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yehova amakondwera ndi amene amamuopa,","poem":1},{"text":"amene chiyembekezo chawo chili mʼchikondi chake chosasinthika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lemekeza Yehova, iwe Yerusalemu;","poem":1},{"text":"tamanda Mulungu wako, iwe Ziyoni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"pakuti Iye amalimbitsa mipiringidzo ya zipata zako","poem":1},{"text":"ndi kudalitsa anthu ako mwa iwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iye amabweretsa mtendere mʼmalire mwako","poem":1},{"text":"ndi kukukhutitsa ndi ufa wa tirigu wosalala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Iyeyo amapereka lamulo pa dziko lapansi;","poem":1},{"text":"mawu ake amayenda mwaliwiro.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Amagwetsa chisanu ngati ubweya","poem":1},{"text":"ndi kumwaza chipale ngati phulusa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Amagwetsa matalala ngati miyala.","poem":1},{"text":"Kodi ndani angathe kupirira kuzizira kwake?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Amatumiza mawu ake ndipo chisanucho chimasungunuka;","poem":1},{"text":"amawombetsa mphepo ndipo madzi amayenda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Iye anawulula mawu ake kwa Yakobo,","poem":1},{"text":"malamulo ake ndi zophunzitsa zake kwa Israeli.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sanachitepo zimenezi kwa mtundu wina uliwonse wa anthu;","poem":1},{"text":"anthu enawo sadziwa malamulo ake.","poem":2},{"lineBreak":true},{"text":"Tamandani Yehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}