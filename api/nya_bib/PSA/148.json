{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Tamandani Yehova.","poem":1},{"lineBreak":true},{"text":"Tamandani Yehova, inu a kumwamba,","poem":1},{"text":"mutamandeni Iye, inu a mlengalenga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mutamandeni, inu angelo ake onse,","poem":1},{"text":"mutamandeni, mutamandeni, inu zolengedwa za mmwamba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mutamandeni, inu dzuwa ndi mwezi,","poem":1},{"text":"mutamandeni, inu nonse nyenyezi zowala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mutamandeni, inu thambo la kumwambamwamba","poem":1},{"text":"ndi inu madzi a pamwamba pa thambo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zonse zitamande dzina la Yehova","poem":1},{"text":"pakuti Iye analamula ndipo zinalengedwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iye anaziyika pa malo ake ku nthawi za nthawi;","poem":1},{"text":"analamula ndipo sizidzatha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tamandani Yehova pa dziko lapansi,","poem":1},{"text":"inu zolengedwa zikuluzikulu za mʼnyanja, ndi nyanja zonse zakuya,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"inu zingʼaningʼani ndi matalala, chipale ndi mitambo,","poem":1},{"text":"mphepo yamkuntho imene imakwaniritsa mawu ake,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"inu mapiri ndi zitunda zonse,","poem":1},{"text":"inu mitengo ya zipatso ndi mikungudza yonse,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"inu nyama zakuthengo ndi ngʼombe zonse,","poem":1},{"text":"inu zolengedwa zingʼonozingʼono ndi mbalame zowuluka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inu mafumu a dziko lapansi ndi anthu a mitundu yonse,","poem":1},{"text":"inu akalonga ndi olamulira a dziko lapansi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inu anyamata ndi anamwali,","poem":1},{"text":"inu nkhalamba ndi ana omwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Onsewo atamande dzina la Yehova","poem":1},{"text":"pakuti dzina lake lokha ndi lolemekezeka;","poem":2},{"lineBreak":true},{"text":"ulemerero wake ndi woopsa pa dziko lapansi pano ndi kumwamba komwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iye wakwezera nyanga anthu ake,","poem":1},{"text":"matamando a anthu ake onse oyera mtima,","poem":2},{"lineBreak":true},{"text":"Aisraeli, anthu a pamtima pake.","poem":2},{"lineBreak":true},{"text":"Tamandani Yehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}