pakamwa pawo,","poem":1},{"text":"ndi lupanga lakuthwa konsekonse mʼmanja mwawo,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kubwezera chilango anthu a mitundu ina,","poem":1},{"text":"ndi kulanga anthu a mitundu yonse,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kumanga mafumu awo ndi zingwe,","poem":1},{"text":"anthu awo otchuka ndi unyolo wachitsulo,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kuchita zimene zinalembedwa zotsutsana nawo","poem":1},{"text":"Uwu ndi ulemerero wa oyera mtima ake onse.","poem":2},{"lineBreak":true},{"text":"Tamandani Yehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}