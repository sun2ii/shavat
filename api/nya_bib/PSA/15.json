"verse","number":5,"content":[{"text":"amene amakongoletsa ndalama zake popanda chiwongoladzanja","poem":1},{"text":"ndipo salandira chiphuphu pofuna kutsutsa anthu osalakwa.","poem":2},{"lineBreak":true},{"text":"Iye amene amachita zinthu zimenezi","poem":1},{"text":"sadzagwedezeka konse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}