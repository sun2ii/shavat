{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Zakumwamba zimalengeza za ulemerero wa Mulungu;","poem":1},{"text":"thambo limalalikira ntchito za manja ake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsiku ndi tsiku zimayankhula mawu ambiri,","poem":1},{"text":"usiku ndi usiku zimaonetsa poyera nzeru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Palibe kuyankhula, palibe mawu aliwonse;","poem":1},{"text":"liwu lawo silimveka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Koma uthenga wawo umapita pa dziko lonse lapansi,","poem":1},{"text":"mawuwo amafika mpaka","poem":2},{"text":"kumalekezero a dziko lapansi.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Dzuwa lili ngati mkwatibwi wobwera kuchokera ku nsanja yake,","poem":2},{"lineBreak":true},{"text":"ngati katswiri wokondwerera kuthamanga pa mpikisano.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Limatuluka kuyambira mbali ina ya thambo","poem":1},{"text":"ndi kuzungulira mpaka mbali inanso;","poem":2},{"lineBreak":true},{"text":"palibe chinthu chotha kupewa kutentha kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lamulo la Yehova ndi langwiro,","poem":1},{"text":"kutsitsimutsa moyo.","poem":2},{"text":"Maumboni a Yehova ndi odalirika,","poem":1},{"text":"amapereka nzeru kwa wopanda nzeru.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Malangizo a Yehova ndi olungama,","poem":1},{"text":"amapereka chimwemwe mu mtima.","poem":2},{"text":"Malamulo a Yehova ndi onyezimira,","poem":1},{"text":"amapereka kuwala.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kuopa Yehova ndiye chinthu changwiro,","poem":1},{"text":"chimakhala mpaka muyaya.","poem":2},{"text":"Maweruzo a Yehova ndi owona","poem":1},{"text":"ndipo onse ndi olungama;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ndi a mtengowapatali kuposa golide,","poem":1},{"text":"kuposa golide weniweni;","poem":2},{"text":"ndi otsekemera kuposa uchi,","poem":1},{"text":"kuposa uchi wochokera pa chisa chake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mtumiki wanu amachenjezedwa nawo;","poem":1},{"text":"powasunga pali mphotho yayikulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndani angathe kudziwa zolakwa zake?","poem":1},{"text":"Mundikhululukire zolakwa zanga zobisika.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Muteteze mtumiki wanunso ku machimo ochita akudziwa;","poem":1},{"text":"iwo asandilamulire.","poem":2},{"text":"Kotero ndidzakhala wosalakwa,","poem":1},{"text":"wopanda mlandu wa tchimo lalikulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mawu a mʼkamwa mwanga ndi zolingalira za mu mtima mwanga","poem":1},{"text":"zikhale zokondweretsa pamaso panu,","poem":2},{"lineBreak":true},{"text":"Inu Yehova, Thanthwe langa ndi Mpulumutsi wanga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}