{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Nʼchifukwa chiyani anthu a mitundu ina akufuna kuchita chiwembu?","poem":1},{"text":"Akonzekeranji zopanda pake anthu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mafumu a dziko lapansi akugwirizana nazo;","poem":1},{"text":"ndipo olamulira asonkhana pamodzi","poem":2},{"text":"kulimbana ndi Ambuye","poem":1},{"text":"ndi wodzozedwa wakeyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iwo akunena kuti, “Tiyeni timasule magoli awo","poem":1},{"text":"ndipo titaye zingwe zawo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wokhala mmwamba akuseka;","poem":1},{"text":"Ambuye akuwanyoza iwowo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndipo iye awadzudzula mu mkwiyo wake","poem":1},{"text":"ndi kuwaopseza mu ukali wake, kunena kuti,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ine ndakhazikitsa mfumu yanga","poem":1},{"text":"pa Ziyoni, phiri langa loyera.”","poem":2}]},{"type":"verse","number":7,"content":["Ine ndidzalengeza zimene Yehova walamula:",{"text":"Iye anati kwa Ine, “Iwe ndiwe mwana wanga;","poem":1},{"text":"lero Ine ndakhala Atate ako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tandipempha,","poem":1},{"text":"ndipo ndidzachititsa kuti mitundu ya anthu ikhale cholowa chako;","poem":2},{"lineBreak":true},{"text":"malekezero a dziko lapansi kuti akhale chuma chako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iweyo udzawalamulira ndi ndodo yaufumu yachitsulo;","poem":1},{"text":"udzawaphwanya zidutswazidutswa ngati zowumba zadothi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kotero, inu mafumu, chenjerani;","poem":1},{"text":"chenjezedwani, inu olamulira a dziko lapansi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tumikirani Yehova mwa mantha","poem":1},{"text":"ndi kukondwerera ulamuliro wake monjenjemera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mpsopsoneni mwanayo kuti angakwiye;","poem":1},{"text":"kuti mungawonongedwe mʼnjira zanu,","poem":2},{"text":"pakuti ukali wake utha kuuka mʼkanthawi kochepa.","poem":1},{"text":"Odala ndi onse amene amathawira kwa Iye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}