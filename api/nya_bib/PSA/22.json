{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Monga mwa “Mbawala yayikazi ya Mmawa.” Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Mulungu wanga, Mulungu wanga, nʼchifukwa chiyani mwandisiya?","poem":1},{"text":"Chifuwa chiyani simukundithandiza ndi pangʼono pomwe?","poem":2},{"lineBreak":true},{"text":"Nʼchifukwa chiyani simukumva mawu a kudandaula kwanga?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inu Mulungu wanga, ine ndimalira masana, koma simuyankha,","poem":1},{"text":"usikunso, ndipo sindikhala chete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Inu ndinu Woyera, wokhala pa mpando waufumu;","poem":1},{"text":"ndinu matamando a Israeli.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pa inu makolo athu anadalira;","poem":1},{"text":"iwo anadalira ndipo Inu munawapulumutsa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Analirira kwa inu ndipo munawapulumutsa.","poem":1},{"text":"Iwo anakhulupirira Inu ndipo simunawakhumudwitse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Koma ine ndine nyongolotsi osati munthu,","poem":1},{"text":"wosekedwa ndi wonyozedwa ndi anthu onse.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onse amene amandiona amandiseka;","poem":1},{"text":"amandiyankhulira mawu achipongwe akupukusa mitu yawo kunena kuti","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Iyeyu amadalira Yehova,","poem":1},{"text":"musiyeni Yehovayo amulanditse.","poem":2},{"text":"Musiyeni Yehova amupulumutse","poem":1},{"text":"popeza amakondwera mwa Yehovayo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Komabe Inu ndinu amene munandibadwitsa, munanditulutsa mʼmimba mwa amayi anga.","poem":1},{"text":"Munachititsa kuti ndizikudalirani","poem":2},{"lineBreak":true},{"text":"ngakhale pa nthawi imene ndinkayamwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Chibadwire ine ndinaperekedwa kwa Inu;","poem":1},{"text":"kuchokera mʼmimba mwa amayi anga Inu mwakhala muli Mulungu wanga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Musakhale kutali ndi ine,","poem":1},{"text":"pakuti mavuto ali pafupi","poem":2},{"lineBreak":true},{"text":"ndipo palibe wina wondipulumutsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ngʼombe zazimuna zandizungulira;","poem":1},{"text":"ngʼombe zazimuna zamphamvu za ku Basani zandizinga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mikango yobangula pokadzula nyama,","poem":1},{"text":"yatsekula kwambiri pakamwa pawo kulimbana nane.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ine ndatayika pansi ngati madzi","poem":1},{"text":"ndipo mafupa anga onse achoka mʼmalo mwake.","poem":2},{"text":"Mtima wanga wasanduka phula;","poem":1},{"text":"wasungunuka mʼkati mwanga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mphamvu zanga zauma ngati phale,","poem":1},{"text":"ndipo lilime langa lamamatira ku nsagwada;","poem":2},{"lineBreak":true},{"text":"mwandigoneka mʼfumbi la imfa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Agalu andizungulira;","poem":1},{"text":"gulu la anthu oyipa landizinga.","poem":2},{"lineBreak":true},{"text":"Alasa manja ndi mapazi anga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ine nditha kuwerenga mafupa anga onse;","poem":1},{"text":"anthu amandiyangʼanitsitsa ndi kundidzuma.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iwo agawana zovala zanga pakati pawo","poem":1},{"text":"ndi kuchita maere pa zovala zangazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Koma Inu Yehova, musakhale kutali;","poem":1},{"text":"Inu mphamvu yanga, bwerani msanga kuti mudzandithandize.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Pulumutsani moyo wanga ku lupanga,","poem":1},{"text":"moyo wanga wopambanawu ku mphamvu ya agalu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndilanditseni mʼkamwa mwa mikango;","poem":1},{"text":"pulumutseni ku nyanga za njati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ine ndidzalengeza dzina lanu kwa abale anga;","poem":1},{"text":"ndidzakutamandani mu msonkhano.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Inu amene mumaopa Yehova mutamandeni!","poem":1},{"text":"Inu zidzukulu zonse za Yakobo, mulemekezeni!","poem":2},{"lineBreak":true},{"text":"Muopeni mwaulemu, inu zidzukulu zonse za Israeli!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Pakuti Iye sanapeputse kapena kunyoza","poem":1},{"text":"kuvutika kwa wosautsidwayo;","poem":2},{"text":"Iye sanabise nkhope yake kwa iye.","poem":1},{"text":"Koma anamvera kulira kwake kofuna thandizo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ndidzakutamandani pa msonkhano waukulu chifukwa cha zimene mwandichitira.","poem":1},{"text":"Ndidzakwaniritsa lonjezo langa pamaso pa amene amaopa Inu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Osauka adzadya ndipo adzakhuta;","poem":1},{"text":"iwo amene amafunafuna Yehova adzamutamanda.","poem":2},{"lineBreak":true},{"text":"Mitima yanu ikhale ndi moyo mpaka muyaya!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Malekezero onse a dziko lapansi","poem":1},{"text":"adzakumbukira Yehova ndi kutembenukira kwa Iye,","poem":2},{"text":"ndipo mabanja a mitundu ya anthu","poem":1},{"text":"adzawerama pamaso pake,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"pakuti ulamuliro ndi wake wa Yehova","poem":1},{"text":"ndipo Iye amalamulira anthu a mitundu yonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Anthu olemera onse a dziko lapansi adzachita phwando ndi kulambira;","poem":1},{"text":"onse amene amapita ku fumbi adzagwada pamaso pake;","poem":2},{"lineBreak":true},{"text":"iwo amene sangathe kudzisunga okha ndi moyo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Zidzukulu zamʼtsogolo zidzamutumikira Iye;","poem":1},{"text":"mibado ya mʼtsogolo idzawuzidwa za Ambuye.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Iwo adzalengeza za chilungamo chake","poem":1},{"text":"kwa anthu amene pano sanabadwe","poem":2},{"lineBreak":true},{"text":"pakuti Iye wachita zimenezi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}