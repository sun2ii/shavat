{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Dziko lapansi ndi la Yehova ndi zonse zimene zili mʼmenemo,","poem":1},{"text":"dziko ndi onse amene amakhala mʼmenemo;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"pakuti Iye ndiye anayika maziko ake pa nyanja","poem":1},{"text":"ndi kulikhazika pamwamba pa madzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ndani angakwere phiri la Yehova?","poem":1},{"text":"Ndani angathe kuyima pa malo ake opatulika?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iye amene ali ndi mʼmanja moyera ndi mtima woyera,","poem":1},{"text":"amene sapereka moyo wake kwa fano","poem":2},{"lineBreak":true},{"text":"kapena kulumbira mwachinyengo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iyeyo adzalandira madalitso kwa Yehova","poem":1},{"text":"ndipo Mulungu mpulumutsi wake adzagamula kuti alibe mlandu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Umenewo ndiwo mʼbado wa amene amafunafuna Yehova;","poem":1},{"text":"amene amafunafuna nkhope yanu, Inu Mulungu wa Yakobo.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tukulani mitu yanu inu zipata;","poem":1},{"text":"tsekukani, inu zitseko zakalekalenu,","poem":2},{"lineBreak":true},{"text":"kuti Mfumu yaulemerero ilowe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kodi Mfumu yaulemereroyo ndani?","poem":1},{"text":"Yehova Wamphamvuzonse,","poem":2},{"lineBreak":true},{"text":"Yehova ndiye wamphamvu pa nkhondo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tukulani mitu yanu, inu zipata;","poem":1},{"text":"tsekukani, inu zitseko zakalekalenu,","poem":2},{"lineBreak":true},{"text":"kuti Mfumu yaulemerero ilowe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodi Mfumu yaulemereroyo ndani?","poem":1},{"text":"Yehova Wamphamvuzonse,","poem":2},{"lineBreak":true},{"text":"Iye ndiye Mfumu yaulemerero.","poem":2},{"text":"Sela","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}