{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Kwa Inu Yehova, ndipereka moyo wanga.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ndimadalira Inu Mulungu wanga.","poem":2},{"text":"Musalole kuti ndichite manyazi","poem":1},{"text":"kapena kuti adani anga andipambane.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aliyense amene amayembekezera kwa Ambuye","poem":1},{"text":"sadzachititsidwa manyazi","poem":2},{"text":"koma achinyengo ndiwo adzachititsidwe manyazi","poem":1},{"text":"ndipo sadzakhala ndi chodzitetezera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndidziwitseni njira zanu Inu Yehova,","poem":1},{"text":"phunzitseni mayendedwe anu;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"tsogolereni mʼchoonadi chanu ndi kundiphunzitsa,","poem":1},{"text":"pakuti Inu ndinu Mulungu mpulumutsi wanga,","poem":2},{"lineBreak":true},{"text":"ndipo chiyembekezo changa chili mwa Inu tsiku lonse.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kumbukirani Inu Yehova chifundo ndi chikondi chanu chachikulu,","poem":1},{"text":"pakuti ndi zakalekale.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Musakumbukire machimo a ubwana wanga","poem":1},{"text":"ndi makhalidwe anga owukira;","poem":2},{"text":"molingana ndi chikondi chanu ndikumbukireni ine,","poem":1},{"text":"pakuti Inu Yehova ndinu wabwino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yehova ndi wabwino ndi wolungama;","poem":1},{"text":"choncho Iye akulangiza ochimwa mʼnjira yake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amatsogolera odzichepetsa kuti achite zolungama","poem":1},{"text":"ndipo amawaphunzitsa njira zake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Njira zonse za Yehova ndi zachikondi ndi zokhulupirika","poem":1},{"text":"kwa iwo amene amasunga zofuna za pangano lake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Chifukwa cha dzina lanu, Inu Yehova,","poem":1},{"text":"khululukireni mphulupulu zanga, ngakhale kuti ndi zochuluka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tsono ndani munthu amene amaopa Yehova?","poem":1},{"text":"Yehova adzamulangiza njira yoti ayitsate.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iye adzakhala pa ulemerero masiku ake onse,","poem":1},{"text":"ndipo zidzukulu zake zidzalandira dziko ngati cholowa chawo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yehova amawulula chinsinsi chake kwa iwo amene amamuopa;","poem":1},{"text":"amawulula pangano lake kwa iwowo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Maso anga ali pa Yehova nthawi zonse,","poem":1},{"text":"pakuti ndi Iye yekha amene adzawonjola mapazi anga mu msampha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tembenukirani kwa ine ndipo mundikomere mtima,","poem":1},{"text":"pakuti ndili ndekhandekha ndipo ndikuzunzika.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Masautso a mu mtima mwanga achulukirachulukira;","poem":1},{"text":"masuleni ku zowawa zanga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Penyani mazunzo anga ndi zovuta zanga","poem":1},{"text":"ndipo mufafanize machimo anga onse.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Onani mmene adani anga achulukira","poem":1},{"text":"ndi momwe chidani chawo ndi ine chakulira.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tetezani moyo wanga ndi kundilanditsa;","poem":1},{"text":"musalole kuti ndichite manyazi,","poem":2},{"lineBreak":true},{"text":"pakuti ndimathawira kwa Inu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kukhulupirika ndi kulungama kwanga kunditeteze,","poem":1},{"text":"chifukwa chiyembekezo changa chili mwa Inu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Wombolani Israeli Inu Mulungu,","poem":1},{"text":"ku mavuto ake onse!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}