{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Yehova ndiye kuwunika kwanga ndi chipulumutso changa;","poem":1},{"text":"ndidzaopa yani?","poem":2},{"text":"Yehova ndi linga la moyo wanga;","poem":1},{"text":"ndidzachita mantha ndi yani?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pamene anthu oyipa abwera kudzalimbana nane","poem":1},{"text":"kudzadya mnofu wanga,","poem":2},{"text":"pamene adani anga ndi achiwembu andithira nkhondo,","poem":1},{"text":"iwo adzapunthwa ndi kugwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngakhale gulu lankhondo lindizinge,","poem":1},{"text":"mtima wanga sudzaopa.","poem":2},{"text":"Ngakhale nkhondo itayambika kulimbana nane,","poem":1},{"text":"ngakhale nthawi imeneyo, ine ndidzalimbika mtima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chinthu chimodzi chokha chimene ndipempha kwa Yehova,","poem":1},{"text":"ichi ndi chimene ndidzachifunafuna:","poem":2},{"text":"kuti ndikhale mʼNyumba ya Yehova","poem":1},{"text":"masiku onse a moyo wanga,","poem":2},{"text":"ndi kuyangʼana kukongola kwa Yehova,","poem":1},{"text":"ndi kumufunafuna Iye mʼNyumba yake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pakuti pa tsiku la msautso","poem":1},{"text":"Iye adzanditeteza mʼmalo ake okhalamo;","poem":2},{"text":"adzandibisa mʼkati mwa Nyumba yake","poem":1},{"text":"ndi kukhazika ine pamwamba pa thanthwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kotero mutu wanga udzakwezedwa","poem":1},{"text":"kuposa adani anga amene andizungulira;","poem":2},{"text":"pa Nyumba yake ndidzapereka nsembe ndi mfuwu wachimwemwe;","poem":1},{"text":"ndidzayimba nyimbo kwa Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Imvani mawu anga pamene ndiyitana Inu Yehova","poem":1},{"text":"mundichitire chifundo ndipo mundiyankhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mtima wanga ukuti kwa Inu, “Funafuna nkhope yake!”","poem":1},{"text":"Nkhope yanu Yehova ndidzayifunafuna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Musandibisire nkhope yanu,","poem":1},{"text":"musamubweze mtumiki wanu mwamkwiyo;","poem":2},{"lineBreak":true},{"text":"mwakhala muli thandizo langa.","poem":2},{"text":"Musandikane kapena kunditaya,","poem":1},{"text":"Inu Mulungu Mpulumutsi wanga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngakhale abambo ndi amayi anga anditaya","poem":1},{"text":"Yehova adzandisamala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Phunzitseni njira yanu Inu Yehova,","poem":1},{"text":"munditsogolere mʼnjira yowongoka","poem":2},{"lineBreak":true},{"text":"chifukwa cha ondizunza.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Musandipereke ku zokhumba za adani anga,","poem":1},{"text":"pakuti mboni zambiri zauka kutsutsana nane","poem":2},{"lineBreak":true},{"text":"ndipo zikundiopseza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ine ndikutsimikiza mtima za zimenezi;","poem":1},{"text":"ndidzaona ubwino wa Yehova","poem":2},{"lineBreak":true},{"text":"mʼdziko la anthu amoyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dikirani pa Yehova;","poem":1},{"text":"khalani anyonga ndipo limbani mtima","poem":2},{"lineBreak":true},{"text":"nimudikire Yehova.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}