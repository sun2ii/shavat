{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide. Atathawa mwana wake Abisalomu."]},{"type":"verse","number":1,"content":[{"text":"Inu Yehova, achulukadi adani anga!","poem":1},{"text":"Achulukadi amene andiwukira!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ambiri akunena za ine kuti,","poem":1},{"text":"“Mulungu sadzamupulumutsa.”","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Koma Inu Yehova, ndinu chishango chonditeteza,","poem":1},{"text":"Inu mwandiveka ulemerero ndipo mwanditukula.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa Yehova, Ine ndilira mofuwula","poem":1},{"text":"ndipo Iye amandiyankha kuchokera ku phiri lake loyera.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ine ndimagona ndi kupeza tulo;","poem":1},{"text":"ndimadzukanso chifukwa Yehova amandichirikiza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sindidzaopa adani anga osawerengeka amene","poem":1},{"text":"abwera kulimbana nane kuchokera ku madera onse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dzukani, Inu Yehova!","poem":1},{"text":"Pulumutseni, Inu Mulungu wanga.","poem":2},{"text":"Akantheni adani anga onse pa msagwada;","poem":1},{"text":"gululani mano a anthu oyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Chipulumutso chimachokera kwa Yehova.","poem":1},{"text":"Madalitso akhale pa anthu anu.","poem":2},{"text":"Sela","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}