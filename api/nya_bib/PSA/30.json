{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide. Nyimbo yoyimba popereka Nyumba ya Mulungu."]},{"type":"verse","number":1,"content":[{"text":"Ndidzakukwezani Yehova,","poem":1},{"text":"chifukwa mwanditulutsa kwakuya,","poem":2},{"lineBreak":true},{"text":"ndipo simunalole kuti adani anga akondwere pa ine.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inu Yehova Mulungu wanga ndinapempha kwa Inu thandizo","poem":1},{"text":"ndipo Inu munandichiritsa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inu Yehova, munanditulutsa ku manda,","poem":1},{"text":"munandisunga kuti ndisatsalire mʼdzenje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Imbirani Yehova inu anthu ake okhulupirika;","poem":1},{"text":"tamandani dzina lake loyera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pakuti mkwiyo wake umakhala kwa kanthawi","poem":1},{"text":"koma kukoma mtima kwake ndi kwa moyo wonse;","poem":2},{"text":"utha kuchezera kulira usiku wonse,","poem":1},{"text":"koma chimwemwe chimabwera mmawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pamene ndinaona kuti ndili otetezedwa ndinati,","poem":1},{"text":"“Sindidzagwedezekanso.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inu Yehova, pamene munandikomera mtima,","poem":1},{"text":"munachititsa phiri langa kuyima chilili;","poem":2},{"text":"koma pamene munabisa nkhope yanu,","poem":1},{"text":"ndinataya mtima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kwa Inu Yehova ndinayitana;","poem":1},{"text":"kwa Ambuye ndinapempha chifundo;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Kodi pali phindu lanji powonongeka kwanga","poem":1},{"text":"ngati nditsikira ku dzenje?","poem":2},{"text":"Kodi fumbi lidzakutamandani Inu?","poem":1},{"text":"Kodi lidzalengeza za kukhulupirika kwanu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Imvani Yehova ndipo mundichitire chifundo;","poem":1},{"text":"Yehova mukhale thandizo langa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Inu munasandutsa kulira kwanga kukhala kuvina;","poem":1},{"text":"munachotsa chiguduli changa ndi kundiveka ndi chimwemwe,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kuti mtima wanga uthe kuyimbira Inu usakhale chete.","poem":1},{"text":"Yehova Mulungu wanga, ndidzapereka kwa Inu mayamiko kwamuyaya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}