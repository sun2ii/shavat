{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Mwa Inu Yehova, ine ndimathawiramo;","poem":1},{"text":"musalole nʼkomwe kuti ndichititsidwe manyazi;","poem":2},{"lineBreak":true},{"text":"mundipulumutse chifukwa cha chilungamo chanu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tcherani khutu lanu kwa ine,","poem":1},{"text":"bwerani msanga kudzandilanditsa;","poem":2},{"text":"mukhale thanthwe langa lothawirapo,","poem":1},{"text":"linga lolimba kundipulumutsa ine.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Popeza Inu ndinu thanthwe langa ndi linga langa,","poem":1},{"text":"chifukwa cha dzina lanu tsogolereni ndi kundiwongolera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndimasuleni mu msampha umene anditchera","poem":1},{"text":"pakuti ndinu pothawirapo panga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mʼmanja mwanu ndipereka mzimu wanga;","poem":1},{"text":"womboleni Yehova Mulungu wachoonadi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Koma ine ndimadana nawo amene amamamatira mafano achabechabe;","poem":1},{"text":"ine ndimadalira Yehova.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndidzakondwa ndi kusangalala mʼchikondi chanu","poem":1},{"text":"popeza Inu munaona masautso anga","poem":2},{"lineBreak":true},{"text":"ndipo mumadziwa kuwawa kwa moyo wanga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inu simunandipereke kwa mdani","poem":1},{"text":"koma mwayika mapazi anga pa malo otakasuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mundichitire chifundo Inu Yehova pakuti ndili pa mavuto;","poem":1},{"text":"maso anga akulefuka ndi chisoni,","poem":2},{"lineBreak":true},{"text":"mʼmoyo mwanga ndi mʼthupi mwanga momwe mukupweteka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Moyo wanga ukunyeka chifukwa cha kuwawidwa mtima","poem":1},{"text":"ndi zaka zanga chifukwa cha kubuwula;","poem":2},{"text":"mphamvu zanga zatha chifuwa cha masautso,","poem":1},{"text":"ndipo mafupa anga akulefuka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Chifukwa cha adani anga onse,","poem":1},{"text":"ndine wonyozeka kwambiri ndi anansi anga;","poem":2},{"text":"ndine chochititsa manyazi kwa abwenzi anga.","poem":1},{"text":"Iwo amene amandiona mu msewu amandithawa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ine ndinayiwalika kwa iwo ngati kuti ndinamwalira;","poem":1},{"text":"ndakhala ngati mʼphika wosweka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pakuti ine ndamva zonena zoyipa za anthu ambiri;","poem":1},{"text":"zoopsa zandizungulira mbali zonse;","poem":2},{"text":"iwo akukonza chiwembu kuti alimbane nane,","poem":1},{"text":"kuti atenge moyo wanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Koma ndikudalira Inu Yehova;","poem":1},{"text":"ndikunena kuti, “Ndinu Mulungu wanga.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Masiku anga ali mʼmanja mwanu;","poem":1},{"text":"ndipulumutseni kwa adani anga","poem":2},{"lineBreak":true},{"text":"ndi kwa iwo amene akundithamangitsa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Walitsani nkhope yanu pa mtumiki wanu;","poem":1},{"text":"pulumutseni mwa chikondi chanu chosatha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yehova musalole kuti ndichite manyazi,","poem":1},{"text":"pakuti ndalirira kwa Inu;","poem":2},{"text":"koma oyipa achititsidwe manyazi","poem":1},{"text":"ndipo agone chete mʼmanda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Milomo yawo yabodzayo ikhale chete,","poem":1},{"text":"pakuti chifukwa cha kunyada","poem":2},{"lineBreak":true},{"text":"ayankhula modzikuza kutsutsana ndi wolungama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ndi waukulu ubwino wanu","poem":1},{"text":"umene mwawasungira amene amakuopani,","poem":2},{"text":"umene mumapereka anthu akuona","poem":1},{"text":"kwa iwo amene amathawira kwa Inu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mu mthunzi wa pamalo popezeka panu muwabisa,","poem":1},{"text":"kuwateteza ku ziwembu za anthu;","poem":2},{"text":"mʼmalo anu okhalamo mumawateteza","poem":1},{"text":"kwa anthu owatsutsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Matamando akhale kwa Yehova,","poem":1},{"text":"pakuti anaonetsa chikondi chake chodabwitsa kwa ine","poem":2},{"lineBreak":true},{"text":"pamene ndinali mu mzinda wozingidwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ndili mʼnkhawa zanga ndinati,","poem":1},{"text":"“Ine ndachotsedwa pamaso panu!”","poem":2},{"text":"Komabe Inu munamva kupempha chifundo kwanga","poem":1},{"text":"pamene ndinapempha thandizo kwa Inu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kondani Yehova oyera mtima ake onse!","poem":1},{"text":"Yehova amasunga wokhulupirika","poem":2},{"lineBreak":true},{"text":"koma amalanga kwathunthu anthu odzikuza.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Khalani ndi nyonga ndipo limbani mtima,","poem":1},{"text":"inu nonse amene mumayembekezera Yehova.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}