{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide. Malangizo."]},{"type":"verse","number":1,"content":[{"text":"Ngodala munthu","poem":1},{"text":"amene zolakwa zake zakhululukidwa;","poem":2},{"lineBreak":true},{"text":"amene machimo ake aphimbidwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngodala munthu","poem":1},{"text":"amene machimo ake Yehova sawawerengeranso pa iye","poem":2},{"lineBreak":true},{"text":"ndipo mu mzimu mwake mulibe chinyengo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pamene ndinali chete,","poem":1},{"text":"mafupa anga anakalamba","poem":2},{"lineBreak":true},{"text":"chifukwa cha kubuwula kwanga tsiku lonse.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pakuti usana ndi usiku","poem":1},{"text":"dzanja lanu linandipsinja;","poem":2},{"text":"mphamvu zanga zinatha","poem":1},{"text":"monga nthawi yotentha yachilimwe.","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Kotero ine ndinavomereza tchimo langa kwa Inu,","poem":1},{"text":"sindinabise mphulupulu zanga.","poem":2},{"text":"Ndinati, “Ine ndidzawulula","poem":1},{"text":"zolakwa zanga kwa Yehova,","poem":2},{"text":"ndipo Inu munandikhululukira","poem":1},{"text":"mlandu wa machimo anga.”","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Choncho aliyense okhulupirika apemphere kwa Inuyo","poem":1},{"text":"pomwe mukupezeka;","poem":2},{"text":"ndithu pamene madzi amphamvu auka,","poem":1},{"text":"sadzamupeza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inu ndi malo anga obisala;","poem":1},{"text":"muzinditeteza ku mavuto ndipo muzindizinga","poem":2},{"lineBreak":true},{"text":"ndi nyimbo zachipulumutso.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ndidzakulangiza ndi kukuphunzitsa njira imene udzayendamo;","poem":1},{"text":"ndidzakupatsa uphungu ndi kukuyangʼanira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Usakhale ngati kavalo kapena bulu,","poem":1},{"text":"zimene zilibe nzeru,","poem":2},{"text":"koma ziyenera kuwongoleredwa ndi zitsulo za mʼkamwa ndi pamutu,","poem":1},{"text":"ukapanda kutero sizibwera kwa iwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zowawa ndi zambiri za anthu oyipa","poem":1},{"text":"koma chikondi chosatha cha Yehova","poem":2},{"lineBreak":true},{"text":"chimamuzinga munthu amene amadalira Iye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kondwerani mwa Yehova inu olungama;","poem":1},{"text":"imbani, inu nonse amene muli owongoka mtima!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}