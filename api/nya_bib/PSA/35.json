{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Inu Yehova, mulimbane nawo amene akulimbana nane;","poem":1},{"text":"mumenyane nawo amene akumenyana nane.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tengani chishango ndi lihawo;","poem":1},{"text":"dzukani ndipo bwerani mundithandize.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tengani mkondo ndi nthungo,","poem":1},{"text":"kulimbana ndi iwo amene akundithamangitsa.","poem":2},{"text":"Uzani moyo wanga kuti,","poem":1},{"text":"“Ine ndine chipulumutso chako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iwo amene akufunafuna moyo wanga","poem":1},{"text":"anyozedwe ndi kuchita manyazi;","poem":2},{"text":"iwo amene akukonza kuti moyo wanga uwonongeke","poem":1},{"text":"abwerere mʼmbuyo mochititsa mantha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akhale ngati mankhusu owuluka ndi mphepo","poem":1},{"text":"pamene mngelo wa Yehova akuwapirikitsa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Njira yawo ikhale ya mdima ndi yoterera","poem":1},{"text":"pamene mngelo wa Yehova akuwathamangitsa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Popeza ananditchera ukonde popanda chifukwa","poem":1},{"text":"ndipo popanda chifukwa andikumbira dzenje,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"chiwonongeko chiwapeza modzidzimutsa","poem":1},{"text":"ukonde umene iwo abisa uwakole,","poem":2},{"lineBreak":true},{"text":"agwere mʼdzenje kuti awonongedwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pamenepo moyo wanga udzakondwera mwa Yehova","poem":1},{"text":"ndi kusangalala ndi chipulumutso chake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Thupi langa lidzafuwula mokondwera,","poem":1},{"text":"“Ndani angafanane nanu Yehova?","poem":2},{"text":"Mumalanditsa osauka kwa amene ali ndi mphamvu zambiri,","poem":1},{"text":"osauka ndi osowa kwa iwo amene amawalanda.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mboni zopanda chisoni zinayimirira,","poem":1},{"text":"zinandifunsa zinthu zimene sindikuzidziwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iwo anandibwezera zoyipa pa zabwino","poem":1},{"text":"ndipo anasiya moyo wanga pa chisoni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Koma pamene iwo ankadwala, ine ndinavala chiguduli","poem":1},{"text":"ndi kudzichepetsa ndekha posala zakudya.","poem":2},{"text":"Pamene mapemphero anga anabwerera kwa ine osayankhidwa,","poem":1}]},{"type":"verse","number":14,"content":[{"text":"ndinayendayenda ndi kulira maliro,","poem":2},{"lineBreak":true},{"text":"kumulira ngati bwenzi langa kapena mʼbale wanga.","poem":2},{"text":"Ndinaweramitsa mutu wanga mosweka mtima","poem":1},{"text":"kukhala ngati ndikulira amayi anga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Koma pamene ndinaphunthwa, iwo anasonkhana mosangalala;","poem":1},{"text":"ondithira nkhondo anasonkhana kutsutsana nane, ineyo osadziwa.","poem":2},{"lineBreak":true},{"text":"Iwo sanasiye kundiyankhulira mawu onyoza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Monga anthu osapembedza, iwo anandinyoza mwachipongwe;","poem":1},{"text":"anandikukutira mano awo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ambuye, mpaka liti mudzakhala mukungoyangʼana?","poem":1},{"text":"Landitsani moyo wanga ku chiwonongeko chawo,","poem":2},{"lineBreak":true},{"text":"moyo wanga wopambana ku mikango.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndidzakuyamikani mu msonkhano waukulu;","poem":1},{"text":"pakati pa gulu lalikulu la anthu ndidzakutamandani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Musalole adani anga onyenga","poem":1},{"text":"akondwere chifukwa cha masautso anga;","poem":2},{"text":"musalole kuti amene amadana nane popanda chifukwa","poem":1},{"text":"andiyangʼane chamʼmbali mondinyoza.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iwowo sayankhula mwamtendere,","poem":1},{"text":"koma amaganizira zonamizira","poem":2},{"lineBreak":true},{"text":"iwo amene amakhala mwabata mʼdziko.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iwo amandiseka mofuwula ndipo amati, “Haa! Haa!","poem":1},{"text":"Ndipo ndi maso athuwa ife taziona.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yehova mwaona zimenezi; musakhale chete.","poem":1},{"text":"Ambuye musakhale kutali ndi ine.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dzukani, ndipo nyamukani kunditeteza!","poem":1},{"text":"Mulimbane nawo chifukwa cha ine, Mulungu wanga ndi Ambuye anga.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Onetsani kusalakwa kwanga mwa chilungamo chanu, Inu Yehova Mulungu wanga.","poem":1},{"text":"Musalole kuti akondwere chifukwa cha mavuto anga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Musalole kuti aganize kuti, “Amati atani, zachitika monga momwe timafunira!”","poem":1},{"text":"Kapena kunena kuti, “Tamutha ameneyu basi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Onse amene amakondwera ndi masautso anga","poem":1},{"text":"achite manyazi ndi kusokonezeka.","poem":2},{"text":"Onse amene amadzikweza kufuna kundipambana,","poem":1},{"text":"avekedwe manyazi ndi mnyozo ngati zovala.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Koma amene amakondwera chifukwa chakuti ndine wosalakwa,","poem":1},{"text":"afuwule mwachimwemwe ndi chisangalalo.","poem":2},{"text":"Nthawi zonse azinena kuti, “Yehova akwezeke,","poem":1},{"text":"Iye amene amakondwera ndi kupeza bwino kwa mtumiki wake.”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Pakamwa panga padzayankhula za chilungamo chanu","poem":1},{"text":"ndi za matamando anu tsiku lonse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}