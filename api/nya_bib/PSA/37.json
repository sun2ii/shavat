{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Usamavutike chifukwa cha anthu oyipa","poem":1},{"text":"kapena kuchitira nsanje amene akuchita cholakwa;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"pakuti monga udzu iwo adzafota msanga,","poem":1},{"text":"ngati mbewu zobiriwira adzanyala msanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Khulupirira Yehova ndipo uzichita zabwino;","poem":1},{"text":"khazikika mʼdziko ndi kutsata zokhulupirika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Udzikondweretse wekha mwa Yehova","poem":1},{"text":"ndipo Iye adzakupatsa zokhumba za mtima wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pereka njira yako kwa Yehova;","poem":1},{"text":"dalira Iye ndipo Iyeyo adzachita izi:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iye adzachititsa chilungamo chako kuwala ngati mʼbandakucha,","poem":1},{"text":"chiweruzo chako ngati dzuwa la masana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Khala chete pamaso pa Yehova ndipo umudikire mofatsa;","poem":1},{"text":"usavutike pamene anthu apambana mʼnjira zawo,","poem":2},{"lineBreak":true},{"text":"pamene iwo achita zinthu zawo zoyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Pewa kupsa mtima ndipo tembenuka kuchoka ku ukali,","poem":1},{"text":"usavutike chifukwa zimenezi zimatsogolera ku zoyipa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pakuti anthu oyipa adzachotsedwa,","poem":1},{"text":"koma iwo amene amayembekeza mwa Yehova adzalandira dziko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kwa kanthawi oyipa sadzapezekanso;","poem":1},{"text":"ngakhale muwafunefune, sadzapezekanso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Koma ofatsa adzalandira dziko","poem":1},{"text":"ndipo adzasangalala ndi mtendere waukulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Oyipa amakonza chiwembu kutsutsana ndi olungama","poem":1},{"text":"ndipo amawakukutira mano;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"koma Ambuye amaseka oyipa","poem":1},{"text":"pakuti Iye amadziwa kuti tsiku lawo likubwera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Oyipa amasolola lupanga","poem":1},{"text":"ndi kupinda uta","poem":2},{"text":"kugwetsa osauka ndi osowa,","poem":1},{"text":"kupha iwo amene njira zawo ndi zolungama.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Koma malupanga awo analasa mitima yawo yomwe,","poem":1},{"text":"ndipo mauta awo anathyoka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Zabwino zochepa zimene olungama ali nazo","poem":1},{"text":"ziposa chuma cha anthu oyipa ambiri;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"pakuti mphamvu ya oyipa idzasweka,","poem":1},{"text":"koma Yehova amasunga olungama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Masiku a anthu osalakwa amadziwika ndi Yehova,","poem":1},{"text":"ndipo cholowa chawo chidzakhala mpaka muyaya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Pa nthawi ya mavuto iwo sadzafota;","poem":1},{"text":"mʼmasiku a njala adzakhala ndi zinthu zambiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Koma oyipa adzawonongeka;","poem":1},{"text":"adani a Yehova adzakhala ngati kukongola kwa kuthengo,","poem":2},{"lineBreak":true},{"text":"iwo adzazimirira ngati utsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Oyipa amabwereka ndipo sabweza","poem":1},{"text":"koma olungama amapereka mowolowamanja.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Iwo amene Yehova amawadalitsa adzalandira dziko,","poem":1},{"text":"koma amene Iye amawatemberera adzachotsedwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ngati Yehova akondwera ndi njira ya munthu,","poem":1},{"text":"amakhazikitsa mayendedwe ake;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ngakhale atapunthwa sadzagwa,","poem":1},{"text":"pakuti Yehova amamutchinjiriza ndi dzanja lake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ine ndinali wamngʼono ndipo tsopano ndakalamba","poem":1},{"text":"koma sindinaonepo olungama akusiyidwa","poem":2},{"lineBreak":true},{"text":"kapena ana awo akupempha chakudya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Iwo ndi owolowamanja nthawi zonse ndipo amabwereketsa mwaufulu;","poem":1},{"text":"ana awo adzadalitsika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Tembenuka kuchoka ku zoyipa ndipo chita zabwino;","poem":1},{"text":"pamenepo udzakhazikika mʼdziko kwamuyaya.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Pakuti Yehova amakonda wolungama","poem":1},{"text":"ndipo sadzasiya okhulupirika ake.","poem":2},{"lineBreak":true},{"text":"Iwo adzatetezedwa kwamuyaya,","poem":1},{"text":"koma zidzukulu za oyipa zidzachotsedwa;","poem":2}]},{"type":"verse","number":29,"content":[{"text":"olungama adzalandira dziko","poem":1},{"text":"ndipo adzakhazikikamo kwamuyaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Pakamwa pa munthu wolungama pamayankhula za nzeru,","poem":1},{"text":"ndipo lilime lake limayankhula zolungama.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Lamulo la Mulungu wake lili mu mtima mwake;","poem":1},{"text":"mapazi ake saterereka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Oyipa amabisala kudikira olungama;","poem":1},{"text":"kufunafuna miyoyo yawoyo;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"koma Yehova sadzawasiya pansi pa mphamvu yawo","poem":1},{"text":"kapena kuti atsutsidwe pamene abweretsedwa pa milandu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Khulupirira Yehova,","poem":1},{"text":"ndipo sunga njira yake;","poem":2},{"text":"Iye adzakukweza ndipo udzalandira dziko kuti likhale lako;","poem":1},{"text":"udzaona anthu oyipa akuwonongeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Ine ndinaona munthu woyipa ndi munthu wopanda chifundo","poem":1},{"text":"akupeza bwino ngati mtengo wobiriwira pa nthaka ya makolo ake.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Koma sanachedwe kumwalira ndipo sanaonekenso;","poem":1},{"text":"ngakhale ndinamuyangʼanayangʼana, sanapezekenso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Ganizira za munthu wosalakwa, yangʼanitsitsa munthu wolungama;","poem":1},{"text":"udzaona kuti ali ndi tsogolo labwino ndipo ali ndi zidzukulu zambiri.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Koma anthu ochimwa adzawonongeka;","poem":1},{"text":"iwowo pamodzi ndi zidzukulu zawo zomwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Chipulumutso cha olungama chimachokera kwa Yehova;","poem":1},{"text":"Iye ndiye linga lawo pa nthawi ya masautso.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Yehova amawathandiza ndi kuwalanditsa;","poem":1},{"text":"Iye amawalanditsa kwa oyipa ndi kuwapulumutsa,","poem":2},{"lineBreak":true},{"text":"pakuti amathawira kwa Iye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}