{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide. Kupempha."]},{"type":"verse","number":1,"content":[{"text":"Yehova musandidzudzule mutapsa mtima","poem":1},{"text":"kapena kundilanga muli ndi ukali.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pakuti mivi yanu yandilasa,","poem":1},{"text":"ndipo dzanja lanu latsika ndipo landifikira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Chifukwa cha ukali wanu mulibe thanzi mʼthupi langa;","poem":1},{"text":"mafupa anga alibe mphamvu chifukwa cha tchimo langa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kulakwa kwanga kwandipsinja","poem":1},{"text":"ngati katundu wolemera kwambiri kuposa mphamvu zanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mabala anga akuwola ndipo akununkha","poem":1},{"text":"chifukwa cha uchitsiru wa moyo wanga wauchimo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ine ndapindika msana ndipo ndawerama kwambiri;","poem":1},{"text":"tsiku lonse ndimangolira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Msana wanga wagwidwa ndi ululu wosasimbika,","poem":1},{"text":"mulibe thanzi mʼthupi langa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndilibe mphamvu ndipo ndakunthidwa kwathunthu;","poem":1},{"text":"ndikubuwula ndi ululu wa mumtima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zokhumba zanga zonse zili poonekera pamaso panu Ambuye,","poem":1},{"text":"kusisima kwanga sikunabisike kwa Inu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mtima wanga ukugunda, mphamvu zanga zikutha;","poem":1},{"text":"ngakhale kuwala kwachoka mʼmaso mwanga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abwenzi anga ndi anzanga akundipewa chifukwa cha mabala anga;","poem":1},{"text":"anansi anga akhala kutali nane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iwo amene akufunafuna moyo wanga atchera misampha yawo,","poem":1},{"text":"oti andipwetekewo amayankhula za kuwonongeka kwanga;","poem":2},{"lineBreak":true},{"text":"tsiku lonse amakonza zachinyengo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ine ndili ngati munthu wosamva amene sangamve,","poem":1},{"text":"monga wosayankhula, amene sangathe kutsekula pakamwa pake;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndakhala ngati munthu amene samva,","poem":1},{"text":"amene pakamwa pake sipangathe kuyankha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndikudikira Inu Yehova;","poem":1},{"text":"mudzayankha, Inu Ambuye Mulungu wanga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pakuti Ine ndinati, “Musawalole kuti akondwere","poem":1},{"text":"kapena kudzikweza okha pa ine pamene phazi langa laterereka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Pakuti ndili pafupi kugwa,","poem":1},{"text":"ndipo ndikumva kuwawa nthawi zonse.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndikuvomereza mphulupulu zanga;","poem":1},{"text":"ndipo ndavutika ndi tchimo langa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ambiri ndi adani anga amphamvu;","poem":1},{"text":"amene amandida popanda chifukwa alipo ochuluka kwambiri.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iwo amene amandibwezera zoyipa mʼmalo mwa zabwino","poem":1},{"text":"amandinyoza pamene nditsatira zabwino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Inu Yehova, musanditaye;","poem":1},{"text":"musakhale kutali ndi ine Mulungu wanga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bwerani msanga kudzandithandiza,","poem":1},{"text":"Inu Ambuye Mpulumutsi wanga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}