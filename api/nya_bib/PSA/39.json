{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Kwa Yedutuni. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Ndinati, “Ndidzasamalira njira zanga","poem":1},{"text":"ndipo ndidzasunga lilime langa kuti ndisachimwe;","poem":2},{"text":"ndidzatseka pakamwa panga ndi chitsekerero","poem":1},{"text":"nthawi yonse imene woyipa ali pamaso panga.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Koma pamene ndinali chete","poem":1},{"text":"osanena ngakhale kanthu kalikonse kabwino","poem":2},{"lineBreak":true},{"text":"mavuto anga anachulukirabe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mtima wanga unatentha mʼkati mwanga,","poem":1},{"text":"ndipo pamene ndinkalingalira, moto unayaka;","poem":2},{"lineBreak":true},{"text":"kenaka ndinayankhula ndi lilime langa:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Yehova ndionetseni mathero a moyo wanga","poem":1},{"text":"ndi chiwerengero cha masiku anga;","poem":2},{"lineBreak":true},{"text":"mundidziwitse kuti moyo wanga ndi wosakhalitsa motani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inu mwachititsa kuti masiku anga akhale ochepa kwambiri,","poem":1},{"text":"kutalika kwa zaka zanga ndi kopanda phindu pamaso panu;","poem":2},{"lineBreak":true},{"text":"moyo wa munthu aliyense ndi waufupi.","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Munthu ali ngati chithunzithunzi chake pamene akuyenda uku ndi uku:","poem":1},{"text":"Iye amangovutika koma popanda phindu;","poem":2},{"lineBreak":true},{"text":"amadzikundikira chuma, osadziwa kuti chidzakhala chayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Koma tsopano Ambuye kodi ndifunanso chiyani?","poem":1},{"text":"Chiyembekezo changa chili mwa Inu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pulumutseni ku zolakwa zanga zonse;","poem":1},{"text":"musandisandutse chonyozeka kwa opusa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ine ndinali chete; sindinatsekule pakamwa panga","poem":1},{"text":"pakuti Inu ndinu amene mwachita zimenezi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Chotsani mkwapulo wanu pa ine;","poem":1},{"text":"ndagonjetsedwa ndi nkhonya ya dzanja lanu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inu mumadzudzula ndi kulanga anthu chifukwa cha tchimo lawo;","poem":1},{"text":"mumawononga chuma chawo monga njenjete;","poem":2},{"lineBreak":true},{"text":"munthu aliyense ali ngati mpweya.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Imvani pemphero langa Inu Yehova,","poem":1},{"text":"mverani kulira kwanga kopempha thandizo;","poem":2},{"lineBreak":true},{"text":"musakhale chete pamene ndikulirira kwa Inu,","poem":2},{"text":"popeza ndine mlendo wanu wosakhalitsa;","poem":1},{"text":"monga anachitira makolo anga onse.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Musandiyangʼane mwaukali, choncho ndidzatha kusangalala","poem":1},{"text":"ndisanafe ndi kuyiwalika.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}