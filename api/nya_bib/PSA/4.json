{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe wa zida za zingwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Ndiyankheni pamene ndiyitana Inu,","poem":1},{"text":"Inu Mulungu wa chilungamo changa.","poem":2},{"text":"Pumulitseni ku zowawa zanga;","poem":1},{"text":"chitireni chifundo ndi kumva pemphero langa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Anthu inu, mpaka liti mudzakhala mukusandutsa ulemerero wanga kukhala manyazi?","poem":1},{"text":"Mpaka liti mudzakonda zachabe ndi kufuna milungu yabodza?","poem":2},{"text":"Sela.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Dziwani kuti Yehova wadziyikira padera anthu okhulupirika;","poem":1},{"text":"Yehova adzamva pamene ndidzamuyitana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kwiyani koma musachimwe;","poem":1},{"text":"pamene muli pa mabedi anu,","poem":2},{"lineBreak":true},{"text":"santhulani mitima yanu ndi kukhala chete.","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Perekani nsembe zolungama","poem":1},{"text":"ndipo dalirani Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ambiri akufunsa kuti, “Ndani angationetse chabwino chilichonse?”","poem":1},{"text":"Kuwunika kwa nkhope yanu kutiwalire, Inu Yehova.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inu mwadzaza mtima wanga ndi chimwemwe chachikulu","poem":1},{"text":"kuposa kuchuluka kwa tirigu wawo ndi vinyo watsopano.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ine ndidzagona ndi kupeza tulo mwamtendere,","poem":1},{"text":"pakuti Inu nokha, Inu Yehova,","poem":2},{"lineBreak":true},{"text":"mumandisamalira bwino.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}