{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Mofatsa ndinadikira Yehova","poem":1},{"text":"Iye anatembenukira kwa ine ndipo anamva kulira kwanga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ananditulutsa mʼdzenje lachitayiko,","poem":1},{"text":"mʼthope ndi mʼchithaphwi;","poem":2},{"text":"Iye anakhazikitsa mapazi anga pa thanthwe","poem":1},{"text":"ndipo anandipatsa malo oyimapo olimba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iye anayika nyimbo yatsopano mʼkamwa mwanga,","poem":1},{"text":"nyimbo yamatamando kwa Mulungu wanga.","poem":2},{"text":"Ambiri adzaona,","poem":1},{"text":"nadzaopa ndipo adzakhulupirira Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndi wodala munthu","poem":1},{"text":"amakhulupirira Yehova;","poem":2},{"text":"amene sayembekezera kwa odzikuza,","poem":1},{"text":"kapena kwa amene amatembenukira kwa milungu yabodza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zambiri, Yehova Mulungu wanga,","poem":1},{"text":"ndi zodabwitsa zimene Inu mwachita.","poem":2},{"text":"Zinthu zimene munazikonzera ife","poem":1},{"text":"palibe amene angathe kukuwerengerani.","poem":2},{"text":"Nditati ndiyankhule ndi kufotokozera,","poem":1},{"text":"zidzakhala zambiri kuzifotokoza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nsembe ndi zopereka Inu simuzifuna,","poem":1},{"text":"koma makutu anga mwawatsekula;","poem":2},{"text":"zopereka zopsereza ndi zopereka chifukwa cha tchimo","poem":1},{"text":"Inu simunazipemphe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kotero ndinati, “Ndili pano, ndabwera.","poem":1},{"text":"Mʼbuku mwalembedwa za ine.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndikufuna kuchita chifuniro chanu, Inu Mulungu wanga;","poem":1},{"text":"lamulo lanu lili mu mtima mwanga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndikulalikira uthenga wa chilungamo chanu mu msonkhano waukulu;","poem":1},{"text":"sinditseka milomo yanga","poem":2},{"lineBreak":true},{"text":"monga mukudziwa Inu Yehova.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sindibisa chilungamo chanu mu mtima mwanga;","poem":1},{"text":"ndinayankhula za kukhulupirika kwanu ndi chipulumutso chanu.","poem":2},{"text":"Ine sindiphimba chikondi chanu ndi choonadi chanu","poem":1},{"text":"pa msonkhano waukulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Musandichotsere chifundo chanu Yehova;","poem":1},{"text":"chikondi chanu ndi choonadi chanu zinditeteze nthawi zonse.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pakuti mavuto osawerengeka andizungulira;","poem":1},{"text":"machimo anga andigonjetsa, ndipo sindingathe kuona.","poem":2},{"text":"Alipo ambiri kuposa tsitsi la mʼmutu mwanga,","poem":1},{"text":"ndipo mtima wanga ukufowoka mʼkati mwanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pulumutseni Yehova;","poem":1},{"text":"Bwerani msanga Yehova kudzandithandiza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onse amene akufunafuna kuchotsa moyo wanga","poem":1},{"text":"achititsidwe manyazi ndi kusokonezedwa;","poem":2},{"text":"onse amene amakhumba chiwonongeko changa","poem":1},{"text":"abwezedwe mwamanyazi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iwo amene amanena kwa ine kuti, “Hee! Hee!”","poem":1},{"text":"abwerere akuchita manyazi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Koma iwo amene amafunafuna Inu","poem":1},{"text":"akondwere ndi kusangalala mwa Inu;","poem":2},{"text":"iwo amene amakonda chipulumutso chanu","poem":1},{"text":"nthawi zonse anene kuti, “Yehova akwezeke!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Komabe Ine ndine wosauka ndi wosowa;","poem":1},{"text":"Ambuye andiganizire.","poem":2},{"text":"Inu ndinu thandizo langa ndi wondiwombola wanga;","poem":1},{"text":"Inu Mulungu wanga, musachedwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}