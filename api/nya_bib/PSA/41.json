{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Wodala ndi munthu amene amaganizira anthu osauka;","poem":1},{"text":"Yehova amamuwombola pa nthawi yamsautso.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yehova adzamuteteza ndi kusunga moyo wake;","poem":1},{"text":"Yehova adzamudalitsa iye mʼdziko","poem":2},{"lineBreak":true},{"text":"ndipo sadzamupereka ku zofuna za adani ake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yehova adzamuthandiza pamene akudwala","poem":1},{"text":"ndipo adzamuchiritsa pa bedi lake la matenda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndinati, “Inu Yehova, mundichitire chifundo;","poem":1},{"text":"chiritseni pakuti ndakuchimwirani.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Adani anga mwankhwidzi amanena za ine kuti,","poem":1},{"text":"“Kodi munthu ameneyu adzafa liti kuti ayiwalike?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pamene wina abwera kudzandiona,","poem":1},{"text":"amayankhula mwachinyengo, pomwe mtima wake ukusonkhanitsa zachipongwe;","poem":2},{"lineBreak":true},{"text":"kenaka iye amatuluka ndi kukalengeza kunja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Adani anga onse amanongʼonezana pamodzi kulimbana nane,","poem":1},{"text":"iwo amalingalira zoyipa kwambiri za ine, ponena kuti,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Matenda owopsa amugwira;","poem":1},{"text":"sadzaukapo pamalo pamene wagona.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngakhale bwenzi langa la pamtima amene ndinamudalira,","poem":1},{"text":"iye amene amadya pamodzi ndi ine","poem":2},{"lineBreak":true},{"text":"watukula chidendene chake kulimbana nane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Koma Yehova mundichititre chifundo,","poem":1},{"text":"dzutseni kuti ndiwabwezere.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ine ndikudziwa kuti mukukondwera nane,","poem":1},{"text":"pakuti mdani wanga sandigonjetsa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mu ungwiro wanga Inu mumandisunga","poem":1},{"text":"ndi kundiyimika pamaso panu kwamuyaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Atamandike Yehova Mulungu wa Israeli","poem":1},{"text":"kuchokera muyaya mpaka muyaya.","poem":2},{"text":"Ameni ndi Ameni.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}