{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Ndakatulo ya ana a Kora."]},{"type":"verse","number":1,"content":[{"text":"Monga mbawala ipuma wefuwefu kufunafuna mitsinje yamadzi,","poem":1},{"text":"kotero moyo wanga upuma wefuwefu kufunafuna Inu Mulungu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moyo wanga uli ndi ludzu lofuna Mulungu, lofuna Mulungu wamoyo.","poem":1},{"text":"Kodi ndipite liti kukakumana ndi Mulungu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Misozi yanga yakhala chakudya changa","poem":1},{"text":"usana ndi usiku,","poem":2},{"text":"pamene anthu akunena kwa ine tsiku lonse kuti,","poem":1},{"text":"“Mulungu wako ali kuti?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zinthu izi ndimazikumbukira","poem":1},{"text":"pamene ndikukhuthula moyo wanga:","poem":2},{"text":"momwe ndinkapitira ndi gulu lalikulu,","poem":1},{"text":"kutsogolera mayendedwe a ku Nyumba ya Mulungu","poem":2},{"text":"ndi mfuwu yachimwemwe ndi mayamiko","poem":1},{"text":"pakati pa anthu a pa chikondwerero.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nʼchifukwa chiyani uli ndi chisoni, iwe moyo wanga?","poem":1},{"text":"Nʼchifukwa chiyani wakhumudwa iwe mʼkati mwanga?","poem":2},{"text":"Yembekezera Mulungu,","poem":1},{"text":"pakuti ndidzamulambirabe,","poem":2},{"lineBreak":true},{"text":"Mpulumutsi wanga ndi","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mulungu wanga.","poem":2},{"lineBreak":true},{"text":"Moyo wanga uli ndi chisoni mʼkati mwanga","poem":1},{"text":"kotero ndidzakumbukira Inu","poem":2},{"text":"kuchokera ku dziko la Yorodani,","poem":1},{"text":"ku mitunda ya Herimoni kuchokera ku phiri la Mizara.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Madzi akuya akuyitana madzi akuya","poem":1},{"text":"mu mkokomo wa mathithi anu;","poem":2},{"text":"mafunde anu onse obwera mwamphamvu","poem":1},{"text":"andimiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Koma usana Yehova amalamulira chikondi chake,","poem":1},{"text":"nthawi ya usiku nyimbo yake ili nane;","poem":2},{"lineBreak":true},{"text":"pemphero kwa Mulungu wa moyo wanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ine ndikuti kwa Mulungu Thanthwe langa,","poem":1},{"text":"“Nʼchifukwa chiyani mwandiyiwala?","poem":2},{"text":"Nʼchifukwa chiyani ndiyenera kuyenda ndikulira,","poem":1},{"text":"woponderezedwa ndi mdani?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mafupa anga ali ndi ululu wakufa nawo","poem":1},{"text":"pamene adani anga akundinyoza,","poem":2},{"text":"tsiku lonse akunena kuti,","poem":1},{"text":"“Mulungu wako ali kuti?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bwanji ukumva chisoni,","poem":1},{"text":"iwe mtima wanga?","poem":2},{"text":"Chifukwa chiyani ukuvutika chonchi mʼkati mwanga?","poem":1},{"text":"Khulupirira Mulungu, pakuti ndidzamutamandanso,","poem":2},{"lineBreak":true},{"text":"Iye amene ali thandizo langa ndi Mulungu wanga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}