{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Onetsani kusalakwa kwanga Inu Mulungu;","poem":1},{"text":"ndipo mundinenere mlandu wanga kutsutsana ndi mtundu wosapembedza;","poem":2},{"lineBreak":true},{"text":"mundilanditse mʼmanja mwa achinyengo ndi anthu oyipa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pajatu Inu Mulungu ndinu mphamvu zanga.","poem":1},{"text":"Nʼchifukwa chiyani mwandikana ine?","poem":2},{"text":"Nʼchifukwa chiyani ndiyenera kuyenda ndikulira,","poem":1},{"text":"woponderezedwa ndi mdani?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tumizani kuwunika kwanu ndi choonadi chanu","poem":1},{"text":"kuti zinditsogolere;","poem":2},{"text":"mulole kuti zindifikitse ku phiri lanu loyera,","poem":1},{"text":"kumalo kumene inu mumakhala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndipo ndidzapita ku guwa lansembe la Mulungu,","poem":1},{"text":"kwa Mulungu, chimwemwe changa ndi chikondwerero changa.","poem":2},{"text":"Ndidzakutamandani ndi zeze,","poem":1},{"text":"Inu Mulungu wanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nʼchifukwa chiyani uli ndi chisoni iwe moyo wanga?","poem":1},{"text":"Nʼchifukwa chiyani wakhumudwa iwe mʼkati mwanga?","poem":2},{"text":"Khulupirira Mulungu,","poem":1},{"text":"pakuti ndidzamutamandabe Iye,","poem":2},{"lineBreak":true},{"text":"Mpulumutsi wanga ndi Mulungu wanga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}