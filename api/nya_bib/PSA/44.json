{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Ndakatulo ya ana a Kora."]},{"type":"verse","number":1,"content":[{"text":"Ife tamva ndi makutu athu, Inu Mulungu;","poem":1},{"text":"makolo athu atiwuza","poem":2},{"text":"zimene munachita mʼmasiku awo,","poem":1},{"text":"masiku akalekalewo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndi dzanja lanu munathamangitsa mitundu ya anthu ena","poem":1},{"text":"ndi kudzala makolo athu;","poem":2},{"text":"Inu munakantha mitundu ya anthu,","poem":1},{"text":"koma makolo athuwo Inu munawapatsa ufulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sanalande dziko ndi lupanga lawo,","poem":1},{"text":"si mkono wawo umene unawabweretsera chigonjetso,","poem":2},{"text":"koma ndi dzanja lanu lamanja, mkono wanu ndi kuwala kwa nkhope yanu,","poem":1},{"text":"pakuti munawakonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inu ndinu Mfumu yanga ndi Mulungu wanga","poem":1},{"text":"amene mumalamulira chigonjetso cha Yakobo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kudzera kwa inu ife timabweza adani athu;","poem":1},{"text":"kudzera mʼdzina lanu timapondereza otiwukirawo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sindidalira uta wanga,","poem":1},{"text":"lupanga langa silindibweretsera chigonjetso;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"koma Inu mumatigonjetsera adani athu,","poem":1},{"text":"mumachititsa manyazi amene amadana nafe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Timanyadira mwa Mulungu wathu tsiku lonse,","poem":1},{"text":"ndipo tidzatamanda dzina lanu kwamuyaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Koma tsopano mwatikana ndi kutichepetsa;","poem":1},{"text":"Inu simupitanso ndi ankhondo athu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Munachititsa ife kubwerera mʼmbuyo pamaso pa mdani","poem":1},{"text":"ndipo amene amadana nafe atilanda katundu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inu munatipereka kuti tiwonongedwe monga nkhosa","poem":1},{"text":"ndipo mwatibalalitsa pakati pa anthu a mitundu ina.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inu munagulitsa anthu anu pa mtengo wotsika,","poem":1},{"text":"osapindulapo kanthu pa malondawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mwachititsa kuti tikhale chochititsa manyazi kwa anthu a mitundu ina,","poem":1},{"text":"chonyozeka ndi chothetsa nzeru kwa iwo amene atizungulira.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mwachititsa kuti tikhale onyozeka pakati pa anthu a mitundu ina;","poem":1},{"text":"anthu amapukusa mitu yawo akationa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Manyazi anga ali pamaso panga tsiku lonse","poem":1},{"text":"ndipo nkhope yanga yaphimbidwa ndi manyazi","poem":2}]},{"type":"verse","number":16,"content":[{"text":"chifukwa cha mawu otonza a iwo amene amandinyoza ndi kundichita chipongwe,","poem":1},{"text":"chifukwa cha mdani amene watsimikiza kubwezera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zonsezi zinatichitikira","poem":1},{"text":"ngakhale kuti ifeyo sitinayiwale Inu","poem":2},{"lineBreak":true},{"text":"kapena kuonetsa kusakhulupirika pa pangano lanu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mitima yathu sinabwerere mʼmbuyo;","poem":1},{"text":"mapazi athu sanatayike pa njira yanu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Koma Inu mwatiphwanya ndi kuchititsa kuti tikhale ozunzidwa ndi ankhandwe","poem":1},{"text":"ndipo mwatiphimba ndi mdima waukulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tikanayiwala dzina la Mulungu wathu","poem":1},{"text":"kapena kutambasulira manja athu kwa mulungu wachilendo,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kodi Mulungu wathu sakanazidziwa zimenezi,","poem":1},{"text":"pakuti Iye amadziwa zinsinsi zamumtima?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Komabe chifukwa cha Inu timakumana ndi imfa tsiku lonse,","poem":1},{"text":"tili ngati nkhosa zoyenera kuti ziphedwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dzukani Ambuye! Nʼchifukwa chiyani mukugona!","poem":1},{"text":"Dziwutseni nokha! Musatikane kwamuyaya.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nʼchifukwa chiyani mukubisa nkhope yanu,","poem":1},{"text":"ndi kuyiwala mavuto athu ndi kuponderezedwa kwathu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Tatsitsidwa pansi mpaka pa fumbi;","poem":1},{"text":"matupi athu amatirira pa dothi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Imirirani ndi kutithandiza,","poem":1},{"text":"tiwomboleni chifukwa cha chikondi chanu chosasinthika.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}