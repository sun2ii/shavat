{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["Nyimbo. Salimo la ana a Kora."]},{"type":"verse","number":1,"content":[{"text":"Wamkulu ndi Yehova, ndi woyenera kwambiri matamando","poem":1},{"text":"mu mzinda wa Mulungu wathu, phiri lake loyera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lokongola mu utali mwake,","poem":1},{"text":"chimwemwe cha dziko lonse lapansi.","poem":2},{"text":"Malo aatali kwambiri a Zafoni ndiye Phiri la Ziyoni,","poem":1},{"text":"mzinda wa Mfumu yayikulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mulungu ali mu malinga ake;","poem":1},{"text":"Iye wadzionetsa yekha kuti ndiye malinga akewo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pamene mafumu anasonkhana pamodzi,","poem":1},{"text":"pamene anayendera pamodzi kudzalimbana nafe,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"iwo anaona mzindawo ndipo anadabwa kwambiri;","poem":1},{"text":"anathawa ndi mantha aakulu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pomwepo anagwidwa nako kunjenjemera,","poem":1},{"text":"ululu wonga wa mkazi woyembekezera pa nthawi yochira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inu munawawononga monga sitima zapamadzi za ku Tarisisi","poem":1},{"text":"zitawonongeka ndi mphepo ya kummawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Monga momwe tinamvera,","poem":1},{"text":"kotero ife tinaona","poem":2},{"text":"mu mzinda wa Yehova Wamphamvuzonse,","poem":1},{"text":"mu mzinda wa Mulungu wathu.","poem":2},{"lineBreak":true},{"text":"Mulungu adzawuteteza kwamuyaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mʼkati mwa Nyumba yanu Mulungu,","poem":1},{"text":"ife timalingaliramo zachikondi chanu chosasinthika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Monga dzina lanu, Inu Mulungu,","poem":1},{"text":"matamando anu amafika ku malekezero a dziko lapansi","poem":2},{"lineBreak":true},{"text":"dzanja lanu lamanja ladzaza ndi chilungamo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Phiri la Ziyoni likukondwera,","poem":1},{"text":"midzi ya Yuda ndi yosangalala","poem":2},{"lineBreak":true},{"text":"chifukwa cha maweruzo anu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yendayendani mu Ziyoni, uzungulireni mzindawo,","poem":1},{"text":"werengani nsanja zake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yangʼanitsitsani bwino mipanda yake,","poem":1},{"text":"penyetsetsani malinga ake,","poem":2},{"lineBreak":true},{"text":"kuti mudzafotokoze za izo ku mʼbado wotsatira.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pakuti Mulungu uyu ndi Mulungu wathu ku nthawi zosatha;","poem":1},{"text":"Iye adzakhala mtsogoleri wathu mpaka ku mapeto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}