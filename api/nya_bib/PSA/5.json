{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe zoyimbira za zitoliro. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Tcherani khutu ku mawu anga, Inu Yehova,","poem":1},{"text":"ganizirani za kusisima kwanga","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mverani kulira kwanga kofuna thandizo,","poem":1},{"text":"Mfumu yanga ndi Mulungu wanga,","poem":2},{"lineBreak":true},{"text":"pakuti kwa Inu, ine ndikupemphera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mmawa, Yehova mumamva mawu anga;","poem":1},{"text":"Mmawa ndimayala zopempha zanga pamaso panu","poem":2},{"lineBreak":true},{"text":"ndi kudikira mwachiyembekezo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inu si Mulungu amene mumasangalala ndi zoyipa;","poem":1},{"text":"choyipa sichikhala pamaso panu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onyada sangathe kuyima pamaso panu;","poem":1},{"text":"Inu mumadana ndi onse ochita zoyipa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mumawononga iwo amene amanena mabodza;","poem":1},{"text":"anthu akupha ndi achinyengo,","poem":2},{"lineBreak":true},{"text":"Yehova amanyansidwa nawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Koma Ine, mwa chifundo chanu chachikulu,","poem":1},{"text":"ndidzalowa mʼNyumba yanu;","poem":2},{"text":"mwa ulemu ndidzaweramira pansi","poem":1},{"text":"kuyangʼana ku Nyumba yanu yoyera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tsogolereni Inu Yehova, mwa chilungamo chanu","poem":1},{"text":"chifukwa cha adani anga ndipo","poem":2},{"lineBreak":true},{"text":"wongolani njira yanu pamaso panga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Palibe mawu ochokera mʼkamwa mwawo amene angadalirike;","poem":1},{"text":"mtima wawo wadzaza ndi chiwonongeko.","poem":2},{"text":"Kummero kwawo kuli ngati manda apululu;","poem":1},{"text":"ndi lilime lawo amayankhula zachinyengo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lengezani kuti ndi olakwa, Inu Mulungu!","poem":1},{"text":"Zochita zawo zoyipa zikhale kugwa kwawo.","poem":2},{"text":"Achotseni pamaso panu chifukwa cha machimo awo ambiri,","poem":1},{"text":"pakuti awukira Inu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Koma lolani kuti onse amene apeza chitetezo mwa Inu akondwere;","poem":1},{"text":"lolani kuti aziyimba nthawi zonse chifukwa cha chimwemwe.","poem":2},{"text":"Aphimbeni ndi chitetezo chanu,","poem":1},{"text":"iwo amene amakonda dzina lanu akondwere mwa Inu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndithu, Inu Yehova, mumadalitsa olungama;","poem":1},{"text":"mumawazungulira ndi kukoma mtima kwanu ngati chishango.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}