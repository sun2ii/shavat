{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide. Pamene Mneneri Natani anabwera kwa iye atachita chigololo ndi Batiseba."]},{"type":"verse","number":1,"content":[{"text":"Mundichitire chifundo, Inu Mulungu,","poem":1},{"text":"molingana ndi chikondi chanu chosasinthika;","poem":2},{"text":"molingana ndi chifundo chanu chachikulu","poem":1},{"text":"mufafanize mphulupulu zanga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Munditsuke zolakwa zanga zonse","poem":1},{"text":"ndipo mundiyeretse kuchotsa tchimo langa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pakuti ndikudziwa mphulupulu zanga,","poem":1},{"text":"ndipo tchimo langa lili pamaso panga nthawi zonse.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Motsutsana ndi Inu, Inu nokha, ndachimwa","poem":1},{"text":"ndipo ndachita zoyipa pamaso panu,","poem":2},{"text":"Kotero kuti inu mwapezeka kuti ndinu wolungama","poem":1},{"text":"pamene muyankhula ndi pamene muweruza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zoonadi ine ndinali wochimwa pomwe ndimabadwa,","poem":1},{"text":"wochimwa kuyambira pa nthawi imene amayi anga anakhala woyembekezera ine.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zoonadi inu mumafuna choonadi mu ziwalo zamʼkati mwanga;","poem":1},{"text":"mumandiphunzitsa nzeru mʼkati mwanga mwenimweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mundiyeretse ndi hisope ndipo ndidzayera,","poem":1},{"text":"munditsuke ndipo ndidzayera kuposa matalala","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mundilole ndimve chimwemwe ndi chisangalalo,","poem":1},{"text":"mulole kuti mafupa amene mwawamphwanya akondwere.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mufulatire machimo anga","poem":1},{"text":"ndi kufafaniza zolakwa zanga zonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mulenge mʼkati mwanga mtima woyera Inu Mulungu","poem":1},{"text":"ndi kukonzanso mzimu wokhazikika mwa ine.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Musandichotse pamaso panu","poem":1},{"text":"kapena kuchotsa Mzimu wanu Woyera mwa ine.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bwezeretsani mwa ine chimwemwe cha chipulumutso chanu","poem":1},{"text":"ndipo mundipatse mzimu wofuna kumvera kuti undilimbitse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pamenepo ndidzaphunzitsa anthu amphulupulu njira zanu","poem":1},{"text":"kuti ochimwa adzabwerere kwa inu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mundipulumutse ku tchimo lokhetsa magazi, Inu Mulungu,","poem":1},{"text":"Mulungu wa chipulumutso changa,","poem":2},{"lineBreak":true},{"text":"ndipo lilime langa lidzayimba zachilungamo chanu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inu Ambuye tsekulani milomo yanga,","poem":1},{"text":"ndipo pakamwa panga padzalengeza matamando anu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inu simusangalatsidwa ndi nsembe wamba.","poem":1},{"text":"Ndikanapereka nsembe yopsereza, Inu simukondwera nayo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nsembe za Mulungu ndi mzimu wosweka;","poem":1},{"text":"mtima wosweka ndi wachisoni","poem":2},{"lineBreak":true},{"text":"Inu Mulungu simudzawunyoza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mwa kukoma mtima kwanu mupange Ziyoni kuti alemere;","poem":1},{"text":"mumange makoma a Yerusalemu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kotero kudzakhala nsembe zachilungamo,","poem":1},{"text":"nsembe yonse yopsereza yokondweretsa Inu;","poem":2},{"lineBreak":true},{"text":"ndipo ngʼombe zazimuna zidzaperekedwa pa guwa lanu la nsembe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}