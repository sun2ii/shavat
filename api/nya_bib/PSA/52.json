{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe, ndakatulo ya Davide; pamene Doegi Mwedomu anapita kwa Sauli ndi kunena kuti “Davide wapita ku nyumba ya Ahimeleki.”"]},{"type":"verse","number":1,"content":[{"text":"Nʼchifukwa chiyani ukudzitamandira ndi zoyipa, iwe munthu wamphamvu?","poem":1},{"text":"Nʼchifukwa chiyani ukudzitamandira tsiku lonse,","poem":2},{"lineBreak":true},{"text":"iwe munthu wochititsa manyazi pamaso pa Mulungu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsiku lonse umakhalira kuganizira za kuwononga ena;","poem":1},{"text":"lilime lako lili ngati lumo lakuthwa,","poem":2},{"lineBreak":true},{"text":"ntchito yako nʼkunyenga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iwe umakonda choyipa mʼmalo mwa kuyankhula choonadi.","poem":1},{"text":"Umakonda kunama kupambana kuyankhula zoona.","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Umakonda mawu onse opweteka,","poem":1},{"text":"iwe lilime lachinyengo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zoonadi Mulungu adzakutsitsa kupita ku chiwonongeko chamuyaya:","poem":1},{"text":"iye adzakukwatula ndi kukuchotsa mʼtenti yako;","poem":2},{"lineBreak":true},{"text":"iye adzakuzula kuchoka mʼdziko la amoyo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Olungama adzaona zimenezi ndi kuchita mantha;","poem":1},{"text":"adzamuseka nʼkumanena kuti,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Pano tsopano pali munthu","poem":1},{"text":"amene sanayese Mulungu linga lake,","poem":2},{"text":"koma anakhulupirira chuma chake chambiri","poem":1},{"text":"nalimbika kuchita zoyipa!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Koma ine ndili ngati mtengo wa olivi","poem":1},{"text":"wobiriwira bwino mʼnyumba ya Mulungu;","poem":2},{"text":"ndimadalira chikondi chosatha cha Mulungu","poem":1},{"text":"kwa nthawi za nthawi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ine ndidzakutamandani kwamuyaya chifukwa cha zimene mwachita;","poem":1},{"text":"chifukwa cha zimene mwachita; mʼdzina lanu ndidzayembekezera","poem":2},{"lineBreak":true},{"text":"pakuti dzina lanulo ndi labwino. Ndidzakutamandani pamaso pa oyera mtima anu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}