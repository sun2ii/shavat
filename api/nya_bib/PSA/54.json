{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Pa zoyimbira za zingwe. Ndakatulo ya Davide. Pamene anthu a ku Zifi anapita kwa Sauli ndipo anati, “Kodi Davide sakubisala pakati pathu.”"]},{"type":"verse","number":1,"content":[{"text":"Pulumutseni Inu Mulungu, mwa dzina lanu;","poem":1},{"text":"onetsani kuti ndine wosalakwa mwamphamvu yanu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Imvani pemphero langa, Inu Mulungu","poem":1},{"text":"mvetserani mawu a pakamwa panga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Alendo akundithira nkhondo;","poem":1},{"text":"anthu ankhanza akufunafuna moyo wanga,","poem":2},{"lineBreak":true},{"text":"anthu amene salabadira za Mulungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Zoonadi Mulungu ndi thandizo langa;","poem":1},{"text":"Ambuye ndiye amene amandichirikiza ine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lolani kuti choyipa chifike pa iwo amene amandichita chipongwe;","poem":1},{"text":"mwa kukhulupirika kwanu awonongeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ine ndidzapereka nsembe yaufulu kwa Inu;","poem":1},{"text":"ndidzatamanda dzina lanu, Inu Yehova,","poem":2},{"lineBreak":true},{"text":"pakuti ndi labwino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pakuti Iyeyo wandipulumutsa ku masautso anga onse,","poem":1},{"text":"ndipo maso anga apenya kupambana kwa pa adani anga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}