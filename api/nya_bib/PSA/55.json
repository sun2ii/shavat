{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Ndakatulo ya Davide. Pa zoyimbira za zingwe."]},{"type":"verse","number":1,"content":[{"text":"Mvetserani pemphero langa, Inu Mulungu,","poem":1},{"text":"musakufulatire kupempha kwanga,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"mverani ndipo mundiyankhe.","poem":2},{"text":"Maganizo anga akundisautsa ndipo ndathedwa nzeru","poem":1}]},{"type":"verse","number":3,"content":[{"text":"chifukwa cha mawu a adani anga,","poem":2},{"lineBreak":true},{"text":"chifukwa cha kupondereza kwa anthu oyipa;","poem":2},{"text":"pakuti andidzetsera masautso","poem":1},{"text":"ndipo akundizunza mu mkwiyo wawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mtima wanga ukupweteka mʼkati mwanga;","poem":1},{"text":"mantha a imfa andigwera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mantha ndi kunjenjemera zandizinga;","poem":1},{"text":"mantha aakulu andithetsa nzeru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndinati, “Ndithu, ndikanakhala ndi mapiko ankhunda!","poem":1},{"text":"Ndikanawulukira kutali ndi kukapuma.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndikanathawira kutali","poem":1},{"text":"ndi kukakhala mʼchipululu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndikanathamangira kumalo anga a chitetezo;","poem":1},{"text":"kutali ndi mphepo yaukali ndi yamkuntho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sokonezani maganizo a oyipa, Inu Ambuye, tsutsani mawu awo;","poem":1},{"text":"pakuti ine ndikuona chiwawa ndi mkangano mu mzinda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Usana ndi usiku iwo akuzungulirazungulira pa makoma ake;","poem":1},{"text":"nkhwidzi ndi kuzunza kuli mʼkati mwake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mphamvu zowononga zili pa ntchito mu mzinda;","poem":1},{"text":"kuopseza ndi mabodza sizichoka mʼmisewu yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Akanakhala mdani akundinyoza, ine","poem":1},{"text":"ndikanapirira;","poem":2},{"text":"akanakhala mdani akudzikweza yekha kutsutsana nane,","poem":1},{"text":"ndikanakabisala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Koma iweyo mnzanga, mnzanga woyenda naye,","poem":1},{"text":"bwenzi langa la pondaapanʼpondepo, ndi amene ukuchita zimenezi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mnzanga amene nthawi ina tinkasangalala","poem":1},{"text":"pa chiyanjano chokoma ku nyumba ya Mulungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mulole imfa itenge adani anga mwadzidzidzi;","poem":1},{"text":"alowe mʼmanda ali amoyo","poem":2},{"lineBreak":true},{"text":"pakuti choyipa chili pakati pawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Koma ine ndinafuwulira kwa Mulungu,","poem":1},{"text":"ndipo Yehova anandipulumutsa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Madzulo, mmawa ndi masana","poem":1},{"text":"ndimalira mowawidwa mtima,","poem":2},{"lineBreak":true},{"text":"ndipo Iye amamva mawu anga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iye amandiwombola ine osavulazidwa","poem":1},{"text":"pa nkhondo imene yafika kulimbana nane,","poem":2},{"lineBreak":true},{"text":"ngakhale kuti ndi ambiri amene akunditsutsa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mulungu amene ali pa mpando wake kwamuyaya,","poem":1},{"text":"adzandimenyera nkhondo; adzawatsitsa adani anga,","poem":2},{"text":"chifukwa safuna kusintha njira zawo zoyipa","poem":1},{"text":"ndipo saopa Mulungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mnzanga woyenda naye wathira nkhondo abwenzi ake;","poem":1},{"text":"iye akuphwanya pangano ake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mawu ake ndi osalala kuposa batala","poem":1},{"text":"komabe nkhondo ili mu mtima mwake;","poem":2},{"text":"mawu ake ndi osalala kwambiri kuposa mafuta,","poem":1},{"text":"komatu mawuwo ndi malupanga osololoka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Tulani nkhawa zanu kwa Yehova","poem":1},{"text":"ndipo Iye adzakulimbitsani;","poem":2},{"lineBreak":true},{"text":"Iye sadzalola kuti wolungama agwe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Koma Inu Mulungu mudzawatsitsa anthu oyipa","poem":1},{"text":"kulowa mʼdzenje lachiwonongeko;","poem":2},{"text":"anthu okhetsa magazi ndi anthu achinyengo","poem":1},{"text":"sadzakhala moyo theka la masiku awo,","poem":2},{"lineBreak":true},{"text":"koma ine ndimadalira Inu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}