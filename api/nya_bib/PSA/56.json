{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a “Njiwa pa Mtengo wa Thundu wa Kutali.” Mikitamu ya Davide, pamene Afilisti anamugwira ku Gati."]},{"type":"verse","number":1,"content":[{"text":"Mundichitire chifundo Inu Mulungu, pakuti anthu akundithamangitsa kwambiri;","poem":1},{"text":"tsiku lonse akundithira nkhondo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ondinyoza akundithamangitsa tsiku lonse,","poem":1},{"text":"ambiri akumenyana nane monyada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ndikachita mantha","poem":1},{"text":"ndimadalira Inu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwa Mulungu, amene mawu ake ine ndimatamanda,","poem":1},{"text":"mwa Mulungu ine ndimadaliramo; sindidzachita mantha.","poem":2},{"lineBreak":true},{"text":"Kodi munthu amene amafa angandichite chiyani?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tsiku lonse amatembenuza mawu anga;","poem":1},{"text":"nthawi zonse amakonza zondivulaza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iwo amakambirana, amandibisalira,","poem":1},{"text":"amayangʼanitsitsa mayendedwe anga","poem":2},{"lineBreak":true},{"text":"ndipo amakhala ndi chidwi chofuna kuchotsa moyo wanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Musalole konse kuti athawe;","poem":1},{"text":"mu mkwiyo wanu Mulungu mugwetse mitundu ya anthu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mulembe za kulira kwanga,","poem":1},{"text":"mulembe chiwerengero cha misozi yanga mʼbuku lanu.","poem":2},{"lineBreak":true},{"text":"Kodi zimenezi sizinalembedwe mʼbuku lanulo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Adani anga adzabwerera mʼmbuyo","poem":1},{"text":"pamene ndidzalirira kwa Inu.","poem":2},{"lineBreak":true},{"text":"Pamenepo ndidzadziwa kuti Mulungu ali ku mbali yanga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mwa Mulungu amene mawu ake ndimawatamanda,","poem":1},{"text":"mwa Yehova amene mawu ake ndimawatamanda,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"mwa Mulungu ine ndimadalira ndipo sindidzachita mantha.","poem":1},{"text":"Kodi munthu angandichite chiyani?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndiyenera kuchita zomwe ndinalumbira kwa Mulungu;","poem":1},{"text":"ndidzapereka nsembe zanga zachiyamiko kwa inu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pakuti mwawombola moyo wanga ku imfa","poem":1},{"text":"ndi mapazi anga kuti ndingagwe,","poem":2},{"text":"kuti ndiyende pamaso pa Mulungu","poem":1},{"text":"mʼkuwala kwa moyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}