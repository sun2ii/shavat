{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a “Musawononge.” Ndakatulo ya Davide, pamene anathawa Sauli kupita ku phanga."]},{"type":"verse","number":1,"content":[{"text":"Mundichitire chifundo, Inu Mulungu mundichitire chifundo,","poem":1},{"text":"pakuti mwa Inu moyo wanga umathawiramo.","poem":2},{"text":"Ndidzathawira mu mthunzi wa mapiko anu","poem":1},{"text":"mpaka chiwonongeko chitapita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ine ndikufuwulira kwa Mulungu Wammwambamwamba,","poem":1},{"text":"kwa Mulungu amene amakwaniritsa cholinga chake pa ine.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mulungu amanditumizira kuchokera kumwamba ndi kundipulumutsa,","poem":1},{"text":"kudzudzula iwo amene akundithamangitsa kwambiri.","poem":2},{"lineBreak":true},{"text":"Mulungu amatumiza chikondi chake ndi kukhulupirika kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ine ndili pakati pa mikango,","poem":1},{"text":"ndagona pakati pa zirombo zolusa;","poem":2},{"text":"anthu amene mano awo ndi milomo yawo ndi mivi,","poem":1},{"text":"malilime awo ndi malupanga akuthwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mukwezekedwe Inu Mulungu, kuposa mayiko onse akumwamba;","poem":1},{"text":"mulole kuti ulemerero wanu ukhale pa dziko lonse lapansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iwo anatchera mapazi anga ukonde","poem":1},{"text":"ndipo ndinawerama pansi mosautsidwa.","poem":2},{"text":"Anakumba dzenje mʼnjira yanga","poem":1},{"text":"koma agweramo okha mʼmenemo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mtima wanga ndi wokhazikika, Inu Mulungu","poem":1},{"text":"mtima wanga ndi wokhazikika.","poem":2},{"lineBreak":true},{"text":"Ndidzayimba nyimbo, nyimbo yake yamatamando.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dzuka moyo wanga!","poem":1},{"text":"Dzukani zeze ndi pangwe!","poem":2},{"lineBreak":true},{"text":"Ndidzadzuka mʼbandakucha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndidzakutamandani Ambuye, pakati pa mitundu ya anthu,","poem":1},{"text":"ndidzayimba za Inu pakati pa mayiko.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pakuti chikondi chanu nʼchachikulu, kufikira ku mayiko akumwamba;","poem":1},{"text":"kukhulupirika kwanu kwafika ku mitambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mukwezekedwe Inu Mulungu kuposa mayiko akumwamba,","poem":1},{"text":"mulole kuti ulemerero wanu ukhale pa dziko lonse lapansi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}