{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a “Musawononge.” Ndakatulo ya Davide. Pamene Sauli anatumiza anthu kuti akalondere nyumba ya Davide ndi cholinga choti amuphe."]},{"type":"verse","number":1,"content":[{"text":"Landitseni kwa adani anga, Inu Mulungu;","poem":1},{"text":"munditeteze kwa anthu amene auka kutsutsana nane.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Landitseni kwa anthu ochita zoyipa","poem":1},{"text":"ndipo mundipulumutse kwa anthu okhetsa magazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Onani momwe iwo akundibisalira!","poem":1},{"text":"Anthu owopsa agwirizana zolimbana nane;","poem":2},{"lineBreak":true},{"text":"osati chifukwa cha mlandu kapena tchimo langa, Inu Yehova.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ine sindinachite cholakwa, koma iwo ndi okonzeka kundithira nkhondo.","poem":1},{"text":"Dzukani kuti mundithandize; penyani mavuto anga!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inu Yehova Mulungu Wamphamvuzonse, Mulungu wa Israeli,","poem":1},{"text":"dzidzutseni nokha kuti mulange anthu a mitundu ina yonse;","poem":2},{"lineBreak":true},{"text":"musaonetse chifundo chanu kwa anthu oyipa achinyengowa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iwo amabweranso madzulo","poem":1},{"text":"akuchita phokoso ngati agalu","poem":2},{"lineBreak":true},{"text":"ndi kumangoyendayenda mu mzinda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onani zomwe amalavula mʼkamwa mwawo;","poem":1},{"text":"iwo amalavula malupanga kuchokera pa milomo yawo,","poem":2},{"lineBreak":true},{"text":"ndipo amanena kuti, “Ndani angatimve?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Koma Inu Yehova, mumawaseka,","poem":1},{"text":"mumayinyoza mitundu yonseyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Inu mphamvu yanga, ine ndiyangʼana kwa inu;","poem":1},{"text":"Inu Mulungu, ndinu linga langa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mulungu wanga wachikondi.","poem":2},{"lineBreak":true},{"text":"Mulungu adzapita patsogolo panga","poem":1},{"text":"ndipo adzandilola kunyada pa iwo amene amandinyoza.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Koma musawaphe, Inu Ambuye chishango chathu,","poem":1},{"text":"kuopa kuti anthu anga angayiwale.","poem":2},{"text":"Mwa mphamvu zanu,","poem":1},{"text":"lolani kuti azingoyendayenda ndipo muwatsitse.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Chifukwa cha machimo a pakamwa pawo","poem":1},{"text":"chifukwa cha mawu a milomo yawo,","poem":2},{"lineBreak":true},{"text":"iwo akodwe mʼkunyada kwawo.","poem":2},{"text":"Chifukwa cha matemberero ndi mabodza amene ayankhula","poem":1}]},{"type":"verse","number":13,"content":[{"text":"muwawononge mu ukali (wanu)","poem":2},{"lineBreak":true},{"text":"muwawononge mpaka atheretu.","poem":2},{"text":"Pamenepo zidzadziwika ku malekezero a dziko lapansi","poem":1},{"text":"kuti Mulungu amalamulira Yakobo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Iwo amabweranso madzulo,","poem":1},{"text":"akuchita phokoso ngati agalu","poem":2},{"lineBreak":true},{"text":"ndi kumangoyenda mu mzinda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iwo amayendayenda kufuna chakudya","poem":1},{"text":"ndipo amawuwa ngati sanakhute.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Koma ine ndidzayimba za mphamvu yanu,","poem":1},{"text":"mmawa ndidzayimba zachikondi chanu;","poem":2},{"text":"pakuti ndinu linga langa,","poem":1},{"text":"pothawirapo panga mʼnthawi ya mavuto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Inu mphamvu yanga, ndiyimba matamando kwa inu;","poem":1},{"text":"Inu Mulungu, ndinu linga langa, Mulungu wanga wachikondi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}