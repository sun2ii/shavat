Inu Mulungu mwamva malumbiro anga;","poem":1},{"text":"mwandipatsa cholowa cha iwo amene amaopa dzina lanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wonjezerani masiku a moyo wa mfumu,","poem":1},{"text":"zaka zake kwa mibado yochuluka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iye akhale pa mpando waufumu pamaso pa Mulungu kwamuyaya;","poem":1},{"text":"ikani chikondi chanu ndi kukhulupirika kwanu kuti zimuteteze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kotero ndidzayimba matamando kwamuyaya pa dzina lanu","poem":1},{"text":"ndi kukwaniritsa malumbiro anga tsiku ndi tsiku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}