{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Kutsata mayimbidwe a Yedutuni. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Moyo wanga umapeza mpumulo mwa Mulungu yekha;","poem":1},{"text":"chipulumutso changa chimachokera kwa Iye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iye yekhayo ndiye thanthwe langa ndi chipulumutso changa;","poem":1},{"text":"Iye ndi linga langa, choncho sindidzagwedezeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kodi nonsenu mudzalimbana naye munthu mpaka liti?","poem":1},{"text":"Kodi mudzamugwetsa pansi ngati khoma losalimba,","poem":2},{"lineBreak":true},{"text":"ngati mpanda wogwedezeka?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iwo akufunitsitsa kumugwetsa","poem":1},{"text":"kuti achoke pa malo ake apamwamba.","poem":2},{"lineBreak":true},{"text":"Iwo amakondweretsedwa ndi mabodza.","poem":2},{"text":"Ndi pakamwa pawo amadalitsa","poem":1},{"text":"koma mʼmitima yawo amatemberera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Peza mpumulo mwa Mulungu yekhayo iwe moyo wanga;","poem":1},{"text":"chiyembekezo changa chichokera mwa Iye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iye yekhayo ndiye thanthwe langa ndi chipulumutso changa;","poem":1},{"text":"Iyeyo ndi linga langa; sindidzagwedezeka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Chipulumutso changa ndi ulemu wanga zimachokera kwa Mulungu:","poem":1},{"text":"Iye ndiye thanthwe langa lamphamvu; Mulungu ndiye pothawira panga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dalirani Iye nthawi zonse, inu anthu;","poem":1},{"text":"khuthulani mitima yanu kwa Iye,","poem":2},{"lineBreak":true},{"text":"pakuti Mulungu ndiye pothawirapo pathu.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Anthu wamba ndi mpweya chabe;","poem":1},{"text":"anthu apamwamba ndi bodza chabe;","poem":2},{"text":"ngati atayezedwa pa sikelo iwo ndi chabe;","poem":1},{"text":"iwowo pamodzi ndi mpweya ndi chabe","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Musadalire kulanda mwachinyengo","poem":1},{"text":"kapena katundu wobedwa;","poem":2},{"text":"ngakhale chuma chanu chichuluke,","poem":1},{"text":"musayike mtima wanu pa icho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mulungu wayankhula kamodzi,","poem":1},{"text":"ine ndamvapo zinthu ziwiri;","poem":2},{"text":"choyamba nʼchakuti Inu Mulungu ndinu wamphamvu,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"komanso Inu Ambuye, chikondi chanu nʼchosasinthika.","poem":2},{"text":"Chachiwiri nʼchakuti mumamuchitira munthu","poem":1},{"text":"molingana ndi ntchito zake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}