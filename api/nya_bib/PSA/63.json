{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Salimo la Davide. Pamene anali mʼchipululu cha Yuda."]},{"type":"verse","number":1,"content":[{"text":"Inu Mulungu, ndinu Mulungu wanga,","poem":1},{"text":"moona mtima ine ndimakufunafunani;","poem":2},{"text":"moyo wanga uli ndi ludzu lofuna Inu,","poem":1},{"text":"thupi langa likulakalaka inu,","poem":2},{"text":"mʼdziko lowuma ndi lotopetsa","poem":1},{"text":"kumene kulibe madzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Inu ndinakuonani ku malo anu opatulika","poem":1},{"text":"ndipo ndinapenya mphamvu zanu ndi ulemerero wanu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Chifukwa chikondi chanu","poem":1},{"text":"ndi choposa moyo, milomo yanga idzakulemekezani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndidzakutamandani masiku onse a moyo wanga,","poem":1},{"text":"ndipo mʼdzina lanu ndidzakweza manja anga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mudzakhutitsa moyo wanga ndi zonona.","poem":1},{"text":"Ine ndidzakutamandani ndi mawu anthetemya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pa bedi panga ndimakumbukira inu;","poem":1},{"text":"ndimaganiza za Inu nthawi yonse ya usiku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Chifukwa ndinu thandizo langa,","poem":1},{"text":"ine ndimayimba mu mthunzi wa mapiko anu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Moyo wanga umakangamira Inu;","poem":1},{"text":"dzanja lanu lamanja limandigwiriziza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Iwo amene akufunafuna moyo wanga adzawonongedwa;","poem":1},{"text":"adzatsikira kunsi kozama kwa dziko lapansi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iwo adzaperekedwa ku lupanga","poem":1},{"text":"ndi kukhala chakudya cha ankhandwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Koma mfumu idzakondwera mwa Mulungu;","poem":1},{"text":"onse amene amalumbira mʼdzina la Mulungu adzalemekeza Mulunguyo,","poem":2},{"lineBreak":true},{"text":"koma pakamwa pa anthu onama padzatsekedwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}