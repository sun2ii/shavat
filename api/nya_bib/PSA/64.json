{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Ndimvereni Mulungu pomwe ndikunena madandawulo anga;","poem":1},{"text":"tetezani moyo wanga ku chiopsezo cha mdani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndibiseni ku chiwembu cha anthu oyipa,","poem":1},{"text":"ku gulu laphokoso la anthu ochita zoyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iwo amanola malilime awo ngati malupanga,","poem":1},{"text":"amaponya mawu awo olasa ngati mivi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iwo amaponya mivi yawo ali pa malo wobisala kwa munthu wosalakwa;","poem":1},{"text":"amamulasa modzidzimutsa ndi mopanda mantha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iwo amalimbikitsana wina ndi mnzake pa chikonzero chawo choyipa,","poem":1},{"text":"amayankhula zobisa misampha yawo;","poem":2},{"lineBreak":true},{"text":"ndipo amati, “Adzayiona ndani?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iwo amakonzekera zosalungama ndipo amati,","poem":1},{"text":"“Takonza ndondomeko yabwino kwambiri!”","poem":2},{"lineBreak":true},{"text":"Ndithu maganizo ndi mtima wa munthu ndi zachinyengo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Koma Mulungu adzawalasa ndi mivi;","poem":1},{"text":"mwadzidzidzi adzakanthidwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iye adzatembenuza milomo yawoyo kuwatsutsa","poem":1},{"text":"ndi kuwasandutsa bwinja;","poem":2},{"lineBreak":true},{"text":"onse amene adzawaona adzagwedeza mitu yawo mowanyoza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Anthu onse adzachita mantha;","poem":1},{"text":"adzalengeza ntchito za Mulungu","poem":2},{"lineBreak":true},{"text":"ndi kulingalira mozama zomwe Iye wazichita.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lolani wolungama akondwere mwa Yehova","poem":1},{"text":"ndi kubisala mwa Iye,","poem":2},{"lineBreak":true},{"text":"owongoka mtima onse atamande Iye!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}