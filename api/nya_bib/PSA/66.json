{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo."]},{"type":"verse","number":1,"content":[{"text":"Fuwulani kwa Mulungu ndi chimwemwe, dziko lonse lapansi!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Imbani ulemerero wa dzina lake;","poem":2},{"lineBreak":true},{"text":"kumutamanda kwake kukhale kwaulemerero.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nenani kwa Mulungu, “Ntchito zanu ndi zoopsa ndithu!","poem":1},{"text":"Mphamvu yanu ndi yayikulu kwambiri","poem":2},{"lineBreak":true},{"text":"kotero kuti adani anu amawerama pamaso panu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dziko lonse lapansi limaweramira inu;","poem":1},{"text":"limayimba matamando kwa Inu;","poem":2},{"lineBreak":true},{"text":"limayimba matamando pa dzina lanu.”","poem":2},{"text":"Sela.","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bwerani mudzaone zimene Mulungu wachita,","poem":1},{"text":"ntchito zanu ndi zoopsa ndithu pakati pa anthu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iye anasandutsa nyanja kukhala malo owuma,","poem":1},{"text":"iwo anawoloka pa madzi ndi mapazi.","poem":2},{"lineBreak":true},{"text":"Bwerani, tiyeni tikondwere mwa Iye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iye amalamulira ndi mphamvu zake mpaka muyaya,","poem":1},{"text":"maso ake amayangʼanira anthu a mitundu ina.","poem":2},{"lineBreak":true},{"text":"Anthu owukira asadzitukumule.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tamandani Mulungu wathu, inu mitundu ya anthu,","poem":1},{"text":"mulole kuti mawu a matamando ake amveke;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iye watchinjiriza miyoyo yathu","poem":1},{"text":"ndi kusunga mapazi athu kuti angaterereke.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pakuti Inu Mulungu munatiyesa;","poem":1},{"text":"munatiyenga ngati siliva.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inu mwatilowetsa mʼndende","poem":1},{"text":"ndi kutisenzetsa zolemera pa misana yathu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inu munalola kuti anthu akwere pa mitu yathu;","poem":1},{"text":"ife tinadutsa mʼmoto ndi mʼmadzi,","poem":2},{"lineBreak":true},{"text":"koma Inu munatibweretsa ku malo a zinthu zochuluka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ine ndidzabwera ku Nyumba yanu ndi nsembe zopsereza","poem":1},{"text":"ndi kukwaniritsa malumbiro anga.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Malumbiro amene milomo yanga inalonjeza","poem":1},{"text":"ndi pakamwa panga panayankhula pamene ndinali pa mavuto.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndidzapereka nsembe nyama zonenepa kwa Inu","poem":1},{"text":"ndi chopereka cha nkhosa zazimuna;","poem":2},{"lineBreak":true},{"text":"ndidzapereka ngʼombe zamphongo ndi mbuzi.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bwerani ndipo mudzamve inu nonse amene mumaopa Mulungu.","poem":1},{"text":"Ndidzakuwuzani zimene Iyeyo wandichitira.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndinafuwula kwa Iye ndi pakamwa panga,","poem":1},{"text":"matamando ake anali pa lilime panga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndikanasekerera tchimo mu mtima mwanga","poem":1},{"text":"Ambuye sakanamvera;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"koma ndithu Mulungu wamvetsera","poem":1},{"text":"ndipo watchera khutu ku mawu a kupempha kwanga.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Matamando akhale kwa Mulungu","poem":1},{"text":"amene sanakane pemphero langa","poem":2},{"lineBreak":true},{"text":"kapena kuletsa chikondi chake pa ine!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}