i Inu Mulungu;","poem":1},{"text":"mitundu yonse ya anthu ikutamandeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nthaka yabereka zokolola zake;","poem":1},{"text":"tidalitseni Mulungu wathu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mulungu atidalitse","poem":1},{"text":"kuti pamenepo malekezero onse a dziko lapansi apembedze Iyeyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}