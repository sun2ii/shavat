{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide. Potsata mayimbidwe a “Akakombo.”"]},{"type":"verse","number":1,"content":[{"text":"Pulumutseni Inu Mulungu,","poem":1},{"text":"pakuti madzi afika mʼkhosi","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ine ndikumira mʼthope lozama","poem":1},{"text":"mʼmene mulibe popondapo.","poem":2},{"text":"Ndalowa mʼmadzi ozama;","poem":1},{"text":"mafunde andimiza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndafowoka ndikupempha chithandizo;","poem":1},{"text":"kummero kwanga kwawuma gwaa,","poem":2},{"text":"mʼmaso mwanga mwada","poem":1},{"text":"kuyembekezera Mulungu wanga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iwo amene amadana nane popanda chifukwa","poem":1},{"text":"ndi ochuluka kuposa tsitsi la kumutu kwanga;","poem":2},{"text":"ambiri ndi adani anga popanda chifukwa,","poem":1},{"text":"iwo amene akufunafuna kundiwononga.","poem":2},{"text":"Ndikukakamizidwa kubwezera","poem":1},{"text":"zomwe sindinabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mukudziwa uchitsiru wanga, Inu Mulungu,","poem":1},{"text":"kulakwa kwanga sikuli kobisika kwa Inu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iwo amene amadalira Inu","poem":1},{"text":"asanyozedwe chifukwa cha ine,","poem":2},{"lineBreak":true},{"text":"Inu Ambuye Wamphamvuzonse.","poem":2},{"text":"Iwo amene amafunafuna Inu","poem":1},{"text":"asachititsidwe manyazi chifukwa cha ine,","poem":2},{"lineBreak":true},{"text":"Inu Mulungu wa Israeli.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pakuti ndimapirira kunyozedwa chifukwa cha Inu,","poem":1},{"text":"ndipo manyazi amaphimba nkhope yanga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndine mlendo kwa abale anga,","poem":1},{"text":"munthu wakudza kwa ana aamuna a amayi anga;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"pakuti changu chochitira nyumba yanu chandiphetsa","poem":1},{"text":"ndipo chipongwe cha iwo amene amanyoza Inu chandigwera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pamene ndikulira ndi kusala kudya,","poem":1},{"text":"ndiyenera kupirira kunyozedwa;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"pomwe ndavala chiguduli,","poem":1},{"text":"anthu amandiseweretsa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iwo amene amakhala pa chipata amandinena,","poem":1},{"text":"ndipo ine ndine nyimbo ya zidakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Koma ndikupempha kwa Inu Ambuye,","poem":1},{"text":"pa nthawi yanu yondikomera mtima;","poem":2},{"text":"mwa chikondi chanu chachikulu","poem":1},{"text":"Inu Mulungu, mundiyankhe pondipulumutsa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mundilanditse kuchoka mʼmatope,","poem":1},{"text":"musalole kuti ndimire,","poem":2},{"text":"pulumutseni ine kwa iwo","poem":1},{"text":"amene amadana nane, kuchoka mʼmadzi ozama.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Musalole kuti chigumula chindimeze,","poem":1},{"text":"kuya kusandimeze","poem":2},{"lineBreak":true},{"text":"ndipo dzenje lisatseke pakamwa pake kundimiza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndiyankheni Inu Yehova mwa ubwino wanu wa chikondi chanu;","poem":1},{"text":"mwa chifundo chanu chachikulu tembenukirani kwa ine.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Musabisire nkhope yanu mtumiki wanu,","poem":1},{"text":"ndiyankheni msanga, pakuti ndili pa mavuto.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bwerani pafupi ndi kundilanditsa;","poem":1},{"text":"ndiwomboleni chifukwa cha adani anga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Inu mukudziwa momwe ndanyozedwera,","poem":1},{"text":"kunyozedwa ndi kuchititsidwa manyazi; adani anga onse ali pamaso panu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mnyozo waswa mtima wanga","poem":1},{"text":"ndipo wandisiya wopanda thandizo lililonse;","poem":2},{"text":"ndinafunafuna ena woti andichitire chisoni,","poem":1},{"text":"koma panalibe ndi mmodzi yemwe woti anditonthoze, sindinapeze ndi mmodzi yemwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iwo anayika ndulu mʼchakudya changa","poem":1},{"text":"ndi kundipatsa vinyo wosasa chifukwa cha ludzu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Chakudya chomwe chayikidwa patsogolo pawo chikhale msampha;","poem":1},{"text":"chikhale chobwezera chilango ndiponso khwekhwe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Maso awo adetsedwe kotero kuti asaonenso","poem":1},{"text":"ndipo misana yawo ipindike mpaka kalekale.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Khuthulirani ukali wanu pa iwo;","poem":1},{"text":"mkwiyo wanu woyaka moto uwathe mphamvu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Malo awo akhale wopanda anthu","poem":1},{"text":"pasapezeke ndi mmodzi yemwe wokhala mʼmatenti awo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Pakuti iwo amazunza amene inu munamuvulaza","poem":1},{"text":"ndi kuyankhula zowawa kwa amene munawapweteka.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Awonjezereni kulakwa pa kulakwa kwawo,","poem":1},{"text":"musalole kuti akhale ndi gawo pa chipulumutso chanu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Iwo afufutidwe mʼbuku la amoyo","poem":1},{"text":"ndipo asalembedwe pamodzi ndi olungama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ndikumva zowawa ndi kuzunzika;","poem":1},{"text":"lolani chipulumutso chanu, Inu Mulungu, chinditeteze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ine ndidzatamanda dzina la Mulungu mʼnyimbo,","poem":1},{"text":"ndidzalemekeza Iye ndi chiyamiko.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Izi zidzakondweretsa Yehova kupambana ngʼombe,","poem":1},{"text":"kupambananso ngʼombe yayimuna, pamodzi ndi nyanga ndi ziboda zake.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Wosauka adzaona ndipo adzasangalala,","poem":1},{"text":"Inu amene mumafunafuna Mulungu, mitima yanu ikhale ndi moyo!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yehova amamvera anthu osowa","poem":1},{"text":"ndipo sanyoza anthu ake omangidwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Kumwamba ndi dziko lapansi zitamanda Iye,","poem":1},{"text":"nyanja ndi zonse zomwe zimayenda mʼmenemo,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"pakuti Mulungu adzapulumutsa Ziyoni","poem":1},{"text":"ndi kumanganso mizinda ya Yuda,","poem":2},{"text":"anthu adzakhala kumeneko ndipo dzikolo lidzakhala lawo;","poem":1}]},{"type":"verse","number":36,"content":[{"text":"ana atumiki ake adzalitenga kukhala cholowa chawo,","poem":2},{"lineBreak":true},{"text":"ndipo iwo amene amakonda dzina lake adzakhala kumeneko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}