{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Salimo la Davide. Pempho."]},{"type":"verse","number":1,"content":[{"text":"Fulumirani Mulungu kundipulumutsa;","poem":1},{"text":"Yehova bwerani msanga kudzandithandiza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iwo amene akufunafuna moyo wanga","poem":1},{"text":"achititsidwe manyazi ndi kusokonezedwa;","poem":2},{"text":"onse amene akukhumba chiwonongeko changa","poem":1},{"text":"abwezedwe mopanda ulemu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onse amene akunena kwa ine kuti, “Aha, aha,”","poem":1},{"text":"abwerere chifukwa cha manyazi awo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Koma onse amene akufunafuna Inu","poem":1},{"text":"akondwere ndi kusangalala mwa Inu;","poem":2},{"text":"iwo amene amakonda chipulumutso chanu","poem":1},{"text":"nthawi zonse anene kuti, “Mulungu akuzike!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Koma ine ndine wosauka ndi wosowa;","poem":1},{"text":"bwerani msanga kwa ine Inu Mulungu.","poem":2},{"text":"Inu ndinu thandizo langa ndi momboli wanga;","poem":1},{"text":"Inu Yehova musachedwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}