{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"Mwa Inu Yehova ine ndathawiramo;","poem":1},{"text":"musalole kuti ndichititsidwe manyazi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mundilanditse ndi kundipulumutsa mwa chilungamo chanu,","poem":1},{"text":"mutchere khutu lanu ndi kundipulumutsa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mukhale thanthwe langa lothawirapo,","poem":1},{"text":"kumene ine nditha kupita nthawi zonse;","poem":2},{"text":"lamulani kuti ndipulumuke,","poem":1},{"text":"pakuti Inu ndinu thanthwe langa ndi linga langa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Landitseni Inu Mulungu wanga, kuchoka mʼdzanja la oyipa,","poem":1},{"text":"kuchoka mʼdzanja la oyipa ndi anthu ankhanza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pakuti Inu mwakhala chiyembekezo changa, Inu Ambuye Wamphamvuzonse,","poem":1},{"text":"chilimbikitso changa kuyambira ndili mwana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuyambira pamene ndinabadwa, ndakhala ndikudalira Inu;","poem":1},{"text":"Inu munanditulutsa mʼmimba mwa amayi anga,","poem":2},{"lineBreak":true},{"text":"ndipo ndidzakupembedzani nthawi zonse.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ine ndakhala chinthu chodabwitsa kwa anthu ambiri","poem":1},{"text":"koma Inu ndinu wonditchinjiriza wamphamvu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pakamwa panga padzaza ndi matamando anu,","poem":1},{"text":"kulengeza ulemerero wanu tsiku lonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Musanditaye pamene ndakalamba;","poem":1},{"text":"musandisiye pamene mphamvu zanga zatha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pakuti adani anga ayankhula motsutsana nane;","poem":1},{"text":"iwo amene amadikira kuti andiphe amapangana pamodzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iwo amati, “Mulungu wamusiya;","poem":1},{"text":"mutsatireni ndi kumugwira,","poem":2},{"lineBreak":true},{"text":"pakuti palibe amene adzamupulumutse.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Musakhale kutali ndi ine Inu Mulungu,","poem":1},{"text":"bwerani msanga, Inu Mulungu wanga; thandizeni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ondineneza anga awonongeke mwa manyazi,","poem":1},{"text":"iwo amene akufuna kundipweteka","poem":2},{"lineBreak":true},{"text":"avale chitonzo ndi manyazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Koma ine ndidzakhala ndi chiyembekezo mwa Inu nthawi zonse,","poem":1},{"text":"ndidzakutamandani mowirikizawirikiza.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pakamwa panga padzafotokoza za chilungamo chanu,","poem":1},{"text":"za chipulumutso chanu tsiku lonse,","poem":2},{"lineBreak":true},{"text":"ngakhale sindikudziwa muyeso wake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndidzabwera ndi kulengeza za machitidwe amphamvu zanu Inu Ambuye Wamphamvuzonse.","poem":1},{"text":"Ndidzalengeza chilungamo chanu, chanu chokha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuyambira ubwana wanga, Inu Mulungu mwakhala mukundiphunzitsa,","poem":1},{"text":"ndipo mpaka lero ine ndikulengeza za ntchito zanu zodabwitsa","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngakhale pamene ndakalamba ndipo imvi zili mbuu","poem":1},{"text":"musanditaye Inu Mulungu,","poem":2},{"text":"mpaka nditalengeza mphamvu zanu","poem":1},{"text":"kwa mibado yonse yakutsogolo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mphamvu zanu ndi kulungama kwanu zimafika mpaka kumwambamwamba.","poem":1},{"text":"Ndani wofanana nanu Inu Mulungu,","poem":2},{"lineBreak":true},{"text":"amene mwachita zazikulu?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngakhale mwandionetsa mavuto","poem":1},{"text":"ambiri owawa,","poem":2},{"text":"mudzabwezeretsanso moyo wanga;","poem":1},{"text":"kuchokera kunsi kwa dziko lapansi,","poem":2},{"lineBreak":true},{"text":"mudzandiukitsanso.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inu mudzachulukitsa ulemu wanga","poem":1},{"text":"ndi kunditonthozanso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ndidzakutamandani ndi zeze","poem":1},{"text":"chifukwa cha kukhulupirika kwanu Mulungu,","poem":2},{"text":"ndidzayimba matamando kwa Inu ndi pangwe,","poem":1},{"text":"Inu Woyera wa Israeli.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Milomo yanga idzafuwula ndi chimwemwe","poem":1},{"text":"pamene ndidzayimba matamando kwa Inu","poem":2},{"lineBreak":true},{"text":"amene mwandiwombola.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lilime langa lidzafotokoza za ntchito zanu zachilungamo","poem":1},{"text":"tsiku lonse,","poem":2},{"text":"pakuti iwo amene amafuna kundipweteka","poem":1},{"text":"achititsidwa manyazi ndi kusokonezedwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}