{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"hebrew_subtitle","content":["Salimo la Asafu."]},{"type":"verse","number":1,"content":[{"text":"Mulungu ndi wabwino ndithu kwa Israeli,","poem":1},{"text":"kwa iwo amene ndi oyera mtima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Koma kunena za ine, mapazi anga anali pafupi kuterereka;","poem":1},{"text":"ndinatsala pangʼono kugwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pakuti ndinkachitira nsanje odzitamandira,","poem":1},{"text":"pamene ndinaona mtendere wa anthu oyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iwo alibe zosautsa;","poem":1},{"text":"matupi awo ndi athanzi ndi amphamvu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Saona mavuto monga anthu ena;","poem":1},{"text":"sazunzika ngati anthu ena onse.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nʼchifukwa chake kunyada kuli monga mkanda wa mʼkhosi mwawo;","poem":1},{"text":"amadziveka chiwawa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mʼmitima yawo yokhota mumachokera zolakwa;","poem":1},{"text":"zoyipa zochokera mʼmaganizo awo sizidziwa malire.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iwowo amanyogodola ndi kumayankhula zoyipa;","poem":1},{"text":"mwa kudzikuza kwawo amaopseza ena nʼkumati, “Tikuponderezani.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pakamwa pawo pamayankhula monyoza Mulungu kumwamba","poem":1},{"text":"ndipo lilime lawo limayenda pa dziko lapansi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nʼchifukwa chake anthu awo amapita kwa iwowo","poem":1},{"text":"ndi kumwa madzi mochuluka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iwo amati, “Kodi Mulungu angadziwe bwanji?","poem":1},{"text":"Kodi Wammwambamwamba angadziwe kalikonse?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Umu ndi mmene oyipa alili;","poem":1},{"text":"nthawi zonse ali pabwino ndipo chuma chawo chimachulukirachulukira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndithudi ine ndawusunga pachabe mtima wanga woyera;","poem":1},{"text":"pachabe ndasamba mʼmanja mwanga mwa kusalakwa kwanga.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tsiku lonse ndapeza mavuto;","poem":1},{"text":"ndakhala ndi kulangidwa mmawa uliwonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ndikanati, “Ndidzayankhula motere,”","poem":1},{"text":"ndikanachita chosakhulupirika kwa ana anu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pamene ndinayesa kuti ndimvetse zonsezi,","poem":1},{"text":"zinandisautsa kwambiri","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kufikira nditalowa mʼmalo opatulika a Mulungu;","poem":1},{"text":"pamenepo ndinamvetsa mathero awo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Zoonadi Inu munawayika pa malo woterera;","poem":1},{"text":"Mumawagwetsa pansi kuti awonongeke.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mwamsangamsanga iwo amawonongedwa,","poem":1},{"text":"amasesedwa kwathunthu ndi mantha!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Monga loto pamene wina adzuka,","poem":1},{"text":"kotero pamene Inu muuka, Inu Ambuye,","poem":2},{"lineBreak":true},{"text":"mudzawanyoza ngati maloto chabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Pamene mtima wanga unasautsidwa","poem":1},{"text":"ndi kuwawidwa mu mzimu mwanga,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ndinali wopusa ndi wosadziwa;","poem":1},{"text":"ndinali chirombo chopanda nzeru pamaso panu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Komabe ineyo ndili ndi Inu nthawi zonse;","poem":1},{"text":"mumandigwira dzanja langa lamanja.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Inu mumanditsogolera ndi malangizo anu","poem":1},{"text":"ndipo pambuyo pake mudzanditenga ku ulemerero.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kodi kumwamba ndili ndi yani kupatula Inu?","poem":1},{"text":"Ndipo dziko lapansi lilibe chilichonse chimene ndimachilakalaka koposa Inuyo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Thupi ndi mtima wanga zitha kufowoka,","poem":1},{"text":"koma Mulungu ndiye mphamvu ya mtima wanga","poem":2},{"lineBreak":true},{"text":"ndi cholandira changa kwamuyaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Iwo amene ali kutali ndi Inu adzawonongeka;","poem":1},{"text":"Inu mumawononga onse osakhulupirika pamaso panu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Koma kunena za Ine ndi kwabwino kukhala pafupi ndi Mulungu.","poem":1},{"text":"Ndatsimikiza kuti Ambuye Yehova ndiwo pothawirapo panga","poem":2},{"lineBreak":true},{"text":"ndipo ndidzalalika ntchito zanu zonse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}