{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe, potsata mayimbidwe a “Musawononge.” Salimo la Asafu. Nyimbo."]},{"type":"verse","number":1,"content":[{"text":"Tikuthokoza Inu Mulungu,","poem":1},{"text":"tikuthokoza, pakuti dzina lanu lili pafupi nafe,","poem":2},{"lineBreak":true},{"text":"anthutu amafotokoza za ntchito zanu zodabwitsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mumati, “Ine ndimayika nthawi yoyenera,","poem":1},{"text":"ndine amene ndimaweruza mwachilungamo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pamene dziko lapansi ndi anthu ake onse anjenjemera,","poem":1},{"text":"ndine amene ndimagwiriziza mizati yake molimba.","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Kwa odzitama ndikuti, ‘Musadzitamenso,’","poem":1},{"text":"ndipo kwa oyipa, ‘Musatukulenso nyanga zanu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Musatukule nyanga zanu motsutsana ndi kumwamba;","poem":1},{"text":"musayankhule ndi khosi losololoka.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kugamula milandu sikuchokera kummawa kapena kumadzulo","poem":1},{"text":"kapena ku chipululu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Koma ndi Mulungu amene amaweruza:","poem":1},{"text":"Iyeyo amatsitsa wina, nakwezanso wina.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mʼdzanja la Yehova muli chikho","poem":1},{"text":"chodzaza ndi vinyo wochita thovu, wosakanizidwa ndi zokometsera;","poem":2},{"text":"Iye amamutsanulira pansi ndipo onse oyipa a dziko lapansi","poem":1},{"text":"amamwa ndi senga zake zonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kunena za ine, ndidzalengeza izi kwamuyaya;","poem":1},{"text":"ndidzayimba matamando kwa Mulungu wa Yakobo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndidzadula nyanga za onse oyipa","poem":1},{"text":"koma nyanga za olungama zidzakwezedwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}