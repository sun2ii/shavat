{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Pa zoyimbira za zingwe. Salimo la Asafu."]},{"type":"verse","number":1,"content":[{"text":"Mulungu amadziwika mu Yuda;","poem":1},{"text":"dzina lake ndi lotchuka mu Israeli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tenti yake ili mu Salemu,","poem":1},{"text":"malo ake okhalamo mu Ziyoni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kumeneko Iye anathyola mivi yowuluka,","poem":1},{"text":"zishango ndi malupanga, zida zankhondo.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wolemekezeka ndinu,","poem":1},{"text":"wamphamvu kuposa mapiri amene ali ndi nyama zambiri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anthu owuma mtima amagona atalandidwa chuma,","poem":1},{"text":"Iwowo amagona tulo tawo totsiriza;","poem":2},{"text":"palibe mmodzi wamphamvu","poem":1},{"text":"amene angatukule manja ake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pa kudzudzula kwanu, Inu Mulungu wa Yakobo,","poem":1},{"text":"kavalo pamodzi ndi galeta zimakhala chete zitagona pansi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inu nokha ndiye muyenera kuopedwa.","poem":1},{"text":"Angathe kuyima pamaso panu ndani mukakwiya?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kuchokera kumwamba Inu munalengeza chiweruzo,","poem":1},{"text":"ndipo dziko linaopa ndi kukhala chete,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"pamene Inu Mulungu munadzuka kuti muweruze,","poem":1},{"text":"kupulumutsa onse osautsidwa mʼdziko.","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Zoonadi, ukali wanu pa anthu umakubweretserani matamando","poem":1},{"text":"ndipo opulumuka ku ukali wanu mumawasunga pafupi nanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Chitani malumbiro kwa Yehova Mulungu wanu ndipo muwakwaniritse;","poem":1},{"text":"anthu onse omuzungulira abweretse mphatso","poem":2},{"lineBreak":true},{"text":"kwa Iye amene ayenera kuopedwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iye amaswa mzimu wa olamulira;","poem":1},{"text":"amaopedwa ndi mafumu a dziko lapansi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}