{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a Yedutuni. Salimo la Asafu."]},{"type":"verse","number":1,"content":[{"text":"Ndinafuwulira Mulungu kupempha thandizo;","poem":1},{"text":"ndinafuwula mokweza kwa Mulungu kuti anditcherere khutu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pamene ndinali pa masautso ndinafunafuna Ambuye;","poem":1},{"text":"usiku ndinatambasula manja mosalekeza","poem":2},{"lineBreak":true},{"text":"ndipo moyo wanga unakana kutonthozedwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ndinakumbukira Inu Mulungu, ndipo ndinabuwula;","poem":1},{"text":"ndinasinkhasinkha ndipo mzimu wanga unalefuka.","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Munagwira zikope zanga kuti ndisagone","poem":1},{"text":"ndipo ndinavutika kwambiri kuti ndiyankhule.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndinaganizira za masiku akale,","poem":1},{"text":"zaka zamakedzana;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndinakumbukira nyimbo zanga usiku.","poem":1},{"text":"Mtima wanga unasinkhasinkha ndipo mzimu wanga unafunsa kuti,","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Kodi Ambuye adzatikana mpaka muyaya?","poem":1},{"text":"Kodi Iwo sadzaonetsanso kukoma mtima kwawo?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kodi Chikondi chake chosatha chija chatheratu?","poem":1},{"text":"Kodi malonjezo ake alephera nthawi yonse?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kodi Mulungu wayiwala kukhala wokoma mtima?","poem":1},{"text":"Kodi mu mkwiyo wake waleka chifundo chake?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndipo ndinaganiza, “Pa izi ine ndidzapemphanso:","poem":1},{"text":"zaka za dzanja lamanja la Wammwambamwamba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ine ndidzakumbukira ntchito za Yehova;","poem":1},{"text":"Ine ndidzakumbukira zodabwitsa zanu za kalekale.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndidzakumbukira ntchito zanu","poem":1},{"text":"ndi kulingalira zodabwitsa zanu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Njira zanu Mulungu ndi zoyera.","poem":1},{"text":"Kodi ndi mulungu uti ali wamkulu kuposa Mulungu wathu?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inu ndinu Mulungu wochita zodabwitsa;","poem":1},{"text":"Mumaonetsera mphamvu yanu pakati pa mitundu ya anthu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndi dzanja lanu lamphamvu munawombola anthu anu,","poem":1},{"text":"zidzukulu za Yakobo ndi Yosefe.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Madzi anakuonani Mulungu,","poem":1},{"text":"madzi anakuonani ndipo anachita mantha;","poem":2},{"lineBreak":true},{"text":"nyanja yozama inakomoka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mitambo inakhuthula madzi ake pansi,","poem":1},{"text":"mu mlengalenga munamveka mabingu;","poem":2},{"lineBreak":true},{"text":"mivi yanu inawuluka uku ndi uku.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bingu lanu linamveka mʼmphepo ya kamvuluvulu,","poem":1},{"text":"mphenzi yanu inawalitsa dziko lonse;","poem":2},{"lineBreak":true},{"text":"dziko lapansi linanjenjemera ndi kugwedezeka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Njira yanu inadutsa pa nyanja,","poem":1},{"text":"njira yanu inadutsa pa madzi amphamvu,","poem":2},{"lineBreak":true},{"text":"ngakhale zidindo za mapazi anu sizinaoneke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Inu munatsogolera anthu anu ngati gulu la nkhosa","poem":1},{"text":"mwa dzanja la Mose ndi Aaroni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}