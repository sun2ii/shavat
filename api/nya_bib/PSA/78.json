{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":78,"content":[{"type":"hebrew_subtitle","content":["Ndakatulo ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Inu anthu anga imvani chiphunzitso changa;","poem":1},{"text":"mvetserani mawu a pakamwa panga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndidzatsekula pakamwa panga mʼmafanizo,","poem":1},{"text":"ndidzayankhula zinthu zobisika, zinthu zakalekale","poem":2}]},{"type":"verse","number":3,"content":[{"text":"zimene tinazimva ndi kuzidziwa,","poem":1},{"text":"zimene makolo athu anatiwuza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sitidzabisira ana awo,","poem":1},{"text":"tidzafotokozera mʼbado wotsatira","poem":2},{"text":"ntchito zotamandika za Yehova,","poem":1},{"text":"mphamvu zake, ndi zozizwitsa zimene Iye wachita.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iye anapereka mawu wodzichitira umboni kwa Yakobo","poem":1},{"text":"ndi kukhazikitsa lamulo mu Israeli,","poem":2},{"text":"zimene analamulira makolo athu","poem":1},{"text":"kuphunzitsa ana awo,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kotero kuti mʼbado wotsatira uthe kuzidziwa,","poem":1},{"text":"ngakhale ana amene sanabadwe,","poem":2},{"lineBreak":true},{"text":"ndi kuti iwo akafotokozere ana awonso.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Choncho iwo adzakhulupirira Mulungu","poem":1},{"text":"ndipo sadzayiwala ntchito zake","poem":2},{"lineBreak":true},{"text":"koma adzasunga malamulo ake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iwo asadzakhale monga makolo awo,","poem":1},{"text":"mʼbado wosamvera ndi wowukira,","poem":2},{"text":"umene mitima yake inali yosamvera Mulungu,","poem":1},{"text":"umene mizimu yake inali yosakhulupirika kwa Iye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Anthu a ku Efereimu, ngakhale ananyamula mauta,","poem":1},{"text":"anathawabe pa nthawi ya nkhondo;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"iwo sanasunge pangano la Mulungu","poem":1},{"text":"ndipo anakana kukhala mʼmoyo wotsatira lamulo lake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anayiwala zimene Iye anachita,","poem":1},{"text":"zozizwitsa zimene anawaonetsa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iyeyo anachita zodabwitsa makolo athu akuona,","poem":1},{"text":"mʼdziko la Igupto, mʼchigawo cha Zowani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anagawa nyanja pakati ndi kudutsitsapo iwowo,","poem":1},{"text":"Iye anachititsa madzi kuyima chilili ngati khoma.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anawatsogolera ndi mtambo masana","poem":1},{"text":"ndi kuwala kwa moto usiku wonse.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iye anangʼamba miyala mʼchipululu","poem":1},{"text":"ndi kuwapatsa madzi ochuluka ngati a mʼnyanja zambiri;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Anatulutsa mitsinje kuchokera mʼmingʼalu ya miyala","poem":1},{"text":"ndi kuyenda madzi ngati mitsinje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Komabe iwowo anapitiriza kumuchimwira Iye,","poem":1},{"text":"kuwukira Wammwambamwamba mʼchipululu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ananyoza Mulungu mwadala","poem":1},{"text":"pomuwumiriza kuti awapatse chakudya chimene anachilakalaka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iwo anayankhula motsutsana naye ponena kuti,","poem":1},{"text":"“Kodi Mulungu angatipatse chakudya mʼchipululu?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iye atamenya thanthwe","poem":1},{"text":"madzi anatuluka,","poem":2},{"lineBreak":true},{"text":"ndipo mitsinje inadzaza ndi madzi.","poem":2},{"text":"Koma iye angatipatsenso ife chakudya?","poem":1},{"text":"Kodi angapereke nyama kwa anthu akewa?”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yehova atawamva anakwiya kwambiri;","poem":1},{"text":"moto wake unayaka kutsutsana ndi Yakobo,","poem":2},{"lineBreak":true},{"text":"ndipo mkwiyo wake unauka kutsutsana ndi Israeli,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"pakuti iwo sanakhulupirire Mulungu","poem":1},{"text":"kapena kudalira chipulumutso chake.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Komabe Iye anapereka lamulo kwa mitambo mmwamba","poem":1},{"text":"ndi kutsekula makomo a mayiko akumwamba;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"anagwetsa mana kuti anthu adye,","poem":1},{"text":"anawapatsa tirigu wakumwamba.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Anthu anadya buledi wa angelo,","poem":1},{"text":"Iye anawatumizira chakudya chonse chimene akanatha kudya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Anamasula mphepo ya kummwera kuchokera kumwamba,","poem":1},{"text":"ndi kutsogolera mphepo ya kummwera mwa mphamvu zake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Iye anawagwetsera nyama ngati fumbi,","poem":1},{"text":"mbalame zowuluka ngati mchenga wa mʼmbali mwa nyanja.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Anazibweretsa kwa iwo mʼkati mwa misasa yawo,","poem":1},{"text":"kuzungulira matenti awo onse.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Iwo anadya mpaka anatsala nazo zochuluka","poem":1},{"text":"pakuti Iye anawapatsa zimene anazilakalaka.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Koma iwowo anasiya kudya chakudya anachilakalakacho,","poem":1},{"text":"chakudya chili mʼkamwa mwawobe,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"mkwiyo wa Mulungu unawayakira;","poem":1},{"text":"Iye anapha amphamvu onse pakati pawo,","poem":2},{"lineBreak":true},{"text":"kugwetsa anyamata abwino kwambiri mu Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Ngakhale zinali chomwechi, iwo anapitirira kuchimwa;","poem":1},{"text":"ngakhale anaona zozizwitsa zakezo iwowo sanakhulupirirebe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kotero Mulungu anachepetsa masiku awo kuti azimirire ngati mpweya.","poem":1},{"text":"Iye anachepetsa zaka zawo kuti zithere mʼmasautso.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Mulungu atawapha, iwo amamufunafuna Iyeyo;","poem":1},{"text":"iwo ankatembenukiranso kwa Iye mwachangu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ankakumbukira kuti Mulungu ndiye Thanthwe lawo,","poem":1},{"text":"kuti Mulungu Wammwambamwamba ndiye Mpulumutsi wawo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Komabe ankamuthyasika ndi pakamwa pawo,","poem":1},{"text":"kumunamiza ndi malilime awo;","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Mitima yawo sinali yokhazikika pa Iye,","poem":1},{"text":"iwo sanakhulupirike ku pangano lake.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Komabe Iye anali wachifundo;","poem":1},{"text":"anakhululukira mphulupulu zawo","poem":2},{"lineBreak":true},{"text":"ndipo sanawawononge.","poem":2},{"text":"Nthawi ndi nthawi Iye anabweza mkwiyo wake","poem":1},{"text":"ndipo sanawutse ukali wake wonse.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Iye anakumbukira kuti iwo anali anthu chabe,","poem":1},{"text":"mphepo yopita imene sibwereranso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Nthawi zambiri iwo ankamuwukira Iye mʼchipululu","poem":1},{"text":"ndi kumumvetsa chisoni mʼdziko lopanda kanthu!","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Kawirikawiri iwo ankamuyesa Mulungu;","poem":1},{"text":"ankamuputa Woyera wa Israeli.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Sanakumbukire mphamvu zake,","poem":1},{"text":"tsiku limene Iye anawawombola kwa ozunza,","poem":2}]},{"type":"verse","number":43,"content":[{"text":"tsiku limene Iyeyo anaonetsa poyera zizindikiro zozizwitsa zake mu Igupto,","poem":1},{"text":"zozizwitsa zake mʼchigawo cha Zowani.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Iye anasandutsa mitsinje yawo kukhala magazi;","poem":1},{"text":"Iwo sanathe kumwa madzi ochokera mʼmitsinje yawo.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Iye anawatumizira magulu a ntchentche zimene zinawawononga,","poem":1},{"text":"ndiponso achule amene anawasakaza.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Iye anapereka mbewu zawo kwa ziwala,","poem":1},{"text":"zokolola zawo kwa dzombe.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Iye anawononga mphesa zawo ndi matalala","poem":1},{"text":"ndiponso mitengo yawo yankhuyu ndi chisanu.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Iye anapereka ngʼombe zawo ku matalala,","poem":1},{"text":"zoweta zawo ku zingʼaningʼani.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Anakhuthula moto wa ukali wake pa iwo,","poem":1},{"text":"anawapsera mtima nawakwiyira nʼkuwabweretsera masautso.","poem":2},{"lineBreak":true},{"text":"Zimenezi zinali ngati gulu la angelo osakaza.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Analolera kukwiya,","poem":1},{"text":"sanawapulumutse ku imfa","poem":2},{"lineBreak":true},{"text":"koma anawapereka ku mliri.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Anakantha ana oyamba kubadwa a Igupto,","poem":1},{"text":"zipatso zoyamba kucha za mphamvu zawo mʼmatenti a Hamu","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Koma Iye anatulutsa anthu ake ngati ziweto;","poem":1},{"text":"anawatsogolera ngati nkhosa kudutsa mʼchipululu.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Anawatsogolera bwinobwino kotero kuti analibe mantha","poem":1},{"text":"koma nyanja inamiza adani awo.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Kotero anawafikitsa ku malire a dziko lake loyera,","poem":1},{"text":"ku dziko lamapiri limene dzanja lake lamanja linawatengera.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Iye anathamangitsa mitundu ya anthu patsogolo pawo","poem":1},{"text":"ndipo anapereka mayiko awo kwa Aisraeli kuti akhale awo;","poem":2},{"lineBreak":true},{"text":"Iye anakhazikitsa mafuko a Israeli mʼnyumba zawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"Koma iwo anayesa Mulungu","poem":1},{"text":"ndi kuwukira Wammwambamwamba;","poem":2},{"lineBreak":true},{"text":"sanasunge malamulo ake.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Anakhala okanika ndi osakhulupirika monga makolo awo,","poem":1},{"text":"anapotoka monga uta wosakhulupirika.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Anakwiyitsa Iyeyo ndi malo awo opembedzera mafano;","poem":1},{"text":"anawutsa nsanje yake ndi mafano awo.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Pamene Mulungu anamva zimenezi, anakwiya kwambiri;","poem":1},{"text":"Iye anakana Israeli kwathunthu.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Anasiya nyumba ya ku Silo,","poem":1},{"text":"tenti imene Iyeyo anayimanga pakati pa anthu.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Anatumiza mphamvu zake ku ukapolo,","poem":1},{"text":"ulemerero wake mʼmanja mwa adani.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Anapereka anthu ake ku lupanga;","poem":1},{"text":"anakwiya kwambiri ndi cholowa chake.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Moto unanyeketsa anyamata awo,","poem":1},{"text":"ndipo anamwali awo analibe nyimbo za ukwati;","poem":2}]},{"type":"verse","number":64,"content":[{"text":"ansembe awo anaphedwa ndi lupanga,","poem":1},{"text":"ndipo amayi awo amasiye sanathe kulira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Kenaka Ambuye anakhala ngati akudzuka kutulo,","poem":1},{"text":"ngati munthu wamphamvu wofuwula chifukwa cha vinyo.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Iye anathamangitsa adani ake;","poem":1},{"text":"anawachititsa manyazi ku nthawi zonse.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Kenaka Iye anakana matenti a Yosefe,","poem":1},{"text":"sanasankhe fuko la Efereimu;","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Koma anasankha fuko la Yuda,","poem":1},{"text":"phiri la Ziyoni limene analikonda.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Iye anamanga malo ake opatulika ngati zitunda,","poem":1},{"text":"dziko limene analikhazikitsa kwamuyaya.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Anasankha Davide mtumiki wake","poem":1},{"text":"ndi kumuchotsa pakati pa makola ankhosa;","poem":2}]},{"type":"verse","number":71,"content":[{"text":"kuchokera koyangʼanira nkhosa anamubweretsa","poem":1},{"text":"kuti akhale mʼbusa wa anthu ake, Yakobo,","poem":2},{"lineBreak":true},{"text":"wa Israeli cholowa chake.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Ndipo Davide anawaweta ndi mtima wolungama;","poem":1},{"text":"ndi manja aluso anawatsogolera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}