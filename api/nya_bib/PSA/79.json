{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["Salimo la Asafu."]},{"type":"verse","number":1,"content":[{"text":"Inu Mulungu, anthu a mitundu ina alowerera mʼcholowa chanu;","poem":1},{"text":"ayipitsa Nyumba yanu yoyera,","poem":2},{"lineBreak":true},{"text":"asandutsa Yerusalemu kukhala bwinja.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iwo anapereka mitembo ya atumiki anu","poem":1},{"text":"kwa mbalame zamlengalenga ngati chakudya,","poem":2},{"lineBreak":true},{"text":"matupi a oyera mtima anu kwa zirombo za dziko lapansi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akhetsa magazi monga madzi","poem":1},{"text":"kuzungulira Yerusalemu yense,","poem":2},{"lineBreak":true},{"text":"ndipo palibe wina woti ayike mʼmanda anthu akufa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ife ndife chinthu chonyozeka kwa anansi athu,","poem":1},{"text":"choseketsa ndi cholalatiridwa kwa iwo amene atizungulira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mpaka liti Inu Yehova? Kodi mudzakwiya mpaka muyaya?","poem":1},{"text":"Kodi mpaka liti nsanje yanu idzayaka ngati moto?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Khuthulirani ukali wanu pa anthu a mitundu ina","poem":1},{"text":"amene sakudziwani Inu,","poem":2},{"text":"pa maufumu","poem":1},{"text":"amene sayitana pa dzina lanu;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"pakuti iwo ameza Yakobo","poem":1},{"text":"ndi kuwononga dziko lawo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Musatilange chifukwa cha machimo a makolo athu","poem":1},{"text":"chifundo chanu chibwere msanga kukumana nafe,","poem":2},{"lineBreak":true},{"text":"pakuti tili ndi chosowa chachikulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tithandizeni Inu Mulungu Mpulumutsi wathu,","poem":1},{"text":"chifukwa cha ulemerero wa dzina lanu;","poem":2},{"text":"tipulumutseni ndi kutikhululukira machimo athu","poem":1},{"text":"chifukwa cha dzina lanu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Chifukwa chiyani anthu a mitundu ina akuti,","poem":1},{"text":"“Ali kuti Mulungu wawo?”","poem":2},{"text":"Ife tikuona, zidziwike pakati pa anthu a mitundu ina","poem":1},{"text":"kuti mumabwezera chilango chifukwa cha magazi amene anakhetsedwa a atumiki anu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kubuwula kwa anthu a mʼndende kufike pamaso panu;","poem":1},{"text":"ndi mphamvu ya dzanja lanu","poem":2},{"lineBreak":true},{"text":"muwasunge amene aweruzidwa kuti aphedwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mubwezere kwa anansi athu kasanu nʼkawiri","poem":1},{"text":"kunyoza kumene ananyoza Inu Ambuye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pamenepo ife anthu anu, nkhosa za pabusa panu,","poem":1},{"text":"tidzakutamandani kwamuyaya,","poem":2},{"text":"kuchokera mʼbado ndi mʼbado","poem":1},{"text":"tidzafotokoza za matamando anu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}