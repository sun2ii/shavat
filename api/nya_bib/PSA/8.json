{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Pa gititi. Salimo la Davide."]},{"type":"verse","number":1,"content":[{"text":"Inu Yehova Ambuye athu,","poem":1},{"text":"dzina lanu ndi la lamphamvudi pa dziko lonse lapansi!","poem":2},{"lineBreak":true},{"text":"Inu mwakhazikitsa ulemerero wanu","poem":1},{"text":"mʼmayiko onse akumwamba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kuchokera mʼkamwa mwa ana ndi makanda,","poem":1},{"text":"Inu mwakhazikitsa mphamvu","poem":2},{"text":"chifukwa cha adani anu,","poem":1},{"text":"kukhazikitsa bata adani ndi anthu obwezera zoyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pamene ndilingalira za mayiko anu akumwamba,","poem":1},{"text":"ntchito ya zala zanu,","poem":2},{"text":"mwezi ndi nyenyezi,","poem":1},{"text":"zimene mwaziyika pa malo ake,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"munthu ndani kuti Inu mumamukumbukira,","poem":1},{"text":"ndi mwana wa munthu kuti inu mumacheza naye?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inu munamupanga kukhala wocheperapo kusiyana ndi zolengedwa zakumwamba","poem":1},{"text":"ndipo mwamuveka ulemerero ndi ulemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Inu munamuyika wolamulira ntchito ya manja anu;","poem":1},{"text":"munayika zinthu zonse pansi pa mapazi ake;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nkhosa, mbuzi ndi ngʼombe pamodzi","poem":1},{"text":"ndi nyama zakuthengo,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"mbalame zamlengalenga","poem":1},{"text":"ndi nsomba zamʼnyanja","poem":2},{"lineBreak":true},{"text":"zonse zimene zimayenda pansi pa nyanja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Inu Yehova, Ambuye athu,","poem":1},{"text":"dzina lanu ndi lamphamvudi pa dziko lonse lapansi!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}