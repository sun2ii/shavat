{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a “Kakombo wa Pangano.” Salimo la Asafu."]},{"type":"verse","number":1,"content":[{"text":"Tcherani khutu Inu mʼbusa wa Israeli,","poem":1},{"text":"Inu amene mumatsogolera Yosefe monga nkhosa;","poem":2},{"text":"Inu amene mumakhala pa mpando waufumu pakati pa akerubi, walani","poem":1}]},{"type":"verse","number":2,"content":[{"text":"kwa Efereimu, Benjamini ndi Manase.","poem":2},{"text":"Utsani mphamvu yanu;","poem":1},{"text":"bwerani ndi kutipulumutsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tibwezereni mwakale Inu Mulungu;","poem":1},{"text":"nkhope yanu itiwalire","poem":2},{"lineBreak":true},{"text":"kuti tipulumutsidwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inu Mulungu Wamphamvuzonse,","poem":1},{"text":"mpaka liti mkwiyo wanu udzanyeka","poem":2},{"lineBreak":true},{"text":"kutsutsana ndi mapemphero a anthu anu?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwawadyetsa buledi wa misozi;","poem":1},{"text":"mwachitisa iwo kumwa misozi yodzaza mbale.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwachititsa kuti tikhale gwero la mikangano pakati pa anansi athu,","poem":1},{"text":"ndipo adani athu akutinyoza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tibwezereni mwakale Inu Mulungu Wamphamvuzonse,","poem":1},{"text":"nkhope yanu itiwalire","poem":2},{"lineBreak":true},{"text":"kuti tipulumutsidwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Munatulutsa mpesa kuchoka ku Igupto;","poem":1},{"text":"munathamangitsa anthu a mitundu ina ndi kuwudzala mpesawo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Munawulimira munda wamphesawo,","poem":1},{"text":"ndipo unamera ndi kudzaza dziko.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mapiri anaphimbidwa ndi mthunzi wake,","poem":1},{"text":"mikungudza yamphamvu ndi nthambi zake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unatambalitsa nthambi zake mpaka ku nyanja,","poem":1},{"text":"mphukira zake mpaka ku mtsinje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Chifukwa chiyani mwagwetsa makoma ake","poem":1},{"text":"kuti onse amene akudutsa athyole mphesa zake?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nguluwe zochokera mʼnkhalango zikuwononga","poem":1},{"text":"ndipo zirombo za mthengo zimawudya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bweraninso kwa ife Inu Mulungu Wamphamvuzonse!","poem":1},{"text":"Yangʼanani pansi muli kumwambako ndipo muone!","poem":2},{"text":"Uyangʼanireni mpesa umenewu,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"muzu umene dzanja lanu lamanja ladzala,","poem":2},{"lineBreak":true},{"text":"mwana amene inu munamukuza nokha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mpesa wanu wadulidwa ndi kutenthedwa ndi moto;","poem":1},{"text":"pakudzudzula kwanu anthu anu awonongeka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dzanja lanu likhale pa munthu amene ali ku dzanja lanu lamanja,","poem":1},{"text":"mwana wa munthu amene mwalera nokha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndipo ife sitidzatembenukira kumbali kuchoka kwa Inu;","poem":1},{"text":"titsitsimutseni ndipo tidzayitana pa dzina lanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tibwezereni mwakale Inu Yehova Mulungu Wamphamvuzonse","poem":1},{"text":"nkhope yanu itiwalire","poem":2},{"lineBreak":true},{"text":"kuti tipulumutsidwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}