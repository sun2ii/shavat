{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a gititi. Salimo la Asafu."]},{"type":"verse","number":1,"content":[{"text":"Imbani mwachimwemwe kwa Mulungu mphamvu yathu;","poem":1},{"text":"Fuwulani mokweza kwa Mulungu wa Yakobo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yambani nyimbo, imbani tambolini","poem":1},{"text":"imbani pangwe wolira bwino ndi zeze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Imbani lipenga la nyanga ya nkhosa yayimuna pa mwezi watsopano,","poem":1},{"text":"ndi pamene mwezi waoneka wonse, pa tsiku la phwando;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ili ndi lamulo kwa Israeli,","poem":1},{"text":"langizo la Mulungu wa Yakobo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iye anapereka lamulolo kwa zidzukulu za Yosefe","poem":1},{"text":"pamene anatuluka kulimbana ndi Igupto,","poem":2},{"lineBreak":true},{"text":"kumene tinamva chiyankhulo chimene sitinachidziwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iye akunena kuti, “Ine ndinachotsa zolemetsa pa mapewa awo;","poem":1},{"text":"Manja awo anamasulidwa mʼdengu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pa mavuto anu munayitana ndipo ndinakulanditsani,","poem":1},{"text":"ndinakuyankhani kuchokera mʼmitambo ya mabingu;","poem":2},{"lineBreak":true},{"text":"ndinakuyesani pa madzi a ku Meriba.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Imvani anthu anga, ndipo ndidzakuchenjezani","poem":1},{"text":"ngati mungathe kumvetsera, Inu Israeli!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Musadzakhale ndi mulungu wachilendo pakati panu;","poem":1},{"text":"musadzagwadire mulungu wina.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ine ndine Yehova Mulungu wanu,","poem":1},{"text":"amene ndinakutulutsani mʼdziko la Igupto.","poem":2},{"lineBreak":true},{"text":"Yasamani kukamwa kwanu ndipo ndidzakudyetsani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Koma anthu anga sanandimvere;","poem":1},{"text":"Israeli sanandigonjere.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kotero ndinawasiya ndi mitima yawo yosamverayo","poem":1},{"text":"kuti atsate zimene ankafuna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Anthu anga akanangondimvera,","poem":1},{"text":"Israeli akanatsatira njira zanga,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nʼkanafulumira motani kuti ndigonjetse adani awo","poem":1},{"text":"ndi kutembenuza mkono wanga kulimbana ndi amaliwongo!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iwo amene amadana ndi Yehova akanakhwinyata pamaso pake,","poem":1},{"text":"ndipo chilango chawo chinakakhala mpaka kalekale.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Koma inu mukanadyetsedwa tirigu wabwino kwambiri;","poem":1},{"text":"ndikanakukhutitsani ndi uchi wochokera pa thanthwe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}