{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Salimo la Asafu."]},{"type":"verse","number":1,"content":[{"text":"Mulungu akutsogolera msonkhano waukulu;","poem":1},{"text":"Iye akuweruza pakati pa “milungu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Mudzateteza osalungama mpaka liti,","poem":1},{"text":"ndi kukondera anthu oyipa?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tetezani anthu ofowoka ndi amasiye;","poem":1},{"text":"mukhazikitse ufulu wa anthu osauka ndi ozunzika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Landitsani anthu ofowoka ndi osowa;","poem":1},{"text":"apulumutseni mʼdzanja la anthu oyipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Iwo sadziwa kanthu, sazindikira kalikonse.","poem":1},{"text":"Amayendayenda mu mdima;","poem":2},{"lineBreak":true},{"text":"maziko onse a dziko lapansi agwedezeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ndinati, ‘Inu ndinu Mulungu,","poem":1},{"text":"nonsenu ndinu ana a Wammwambamwamba.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Koma mudzafa ngati anthu wamba;","poem":1},{"text":"mudzagwa ngati wolamula wina aliyense.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dzukani Inu Mulungu, weruzani dziko lapansi,","poem":1},{"text":"pakuti mayiko onse ndi cholowa chanu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}