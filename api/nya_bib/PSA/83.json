{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["Nyimbo. Salimo la Asafu."]},{"type":"verse","number":1,"content":[{"text":"Inu Mulungu musakhale chete;","poem":1},{"text":"musangoti phee, Mulungu musangoti duu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Onani adani anu akuchita chiwawa,","poem":1},{"text":"amene amadana nanu autsa mitu yawo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mochenjera iwo akukambirana za chiwembu kutsutsana ndi anthu anu;","poem":1},{"text":"Iwo akukonzekera kutsutsana ndi omwe mumawakonda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iwo akunena kuti, “Bwerani” akutero, “Tiyeni tiwononge mtundu wonsewu","poem":1},{"text":"kuti dzina la Israeli lisakumbukikenso.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndi mtima umodzi akukonzekera chiwembu;","poem":1},{"text":"Iwo achita mgwirizano kutsutsana nanu:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Matenti a Edomu ndi Aismaeli,","poem":1},{"text":"Mowabu ndi Ahagiri,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Agebala, Aamoni ndi Aamaleki,","poem":1},{"text":"Afilisti, pamodzi ndi anthu a ku Turo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngakhalenso Aasiriya aphatikizana nawo","poem":1},{"text":"kupereka mphamvu kwa ana a Loti.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Muwachitire zomwe munachitira Amidiyani,","poem":1},{"text":"monga munachitira Sisera ndi Yabini ku mtsinje wa Kisoni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amene anawonongedwa ku Endori","poem":1},{"text":"ndi kukhala ngati zinyalala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anthu awo otchuka muwachite zomwe munachita Orebu ndi Zeebu","poem":1},{"text":"ana a mafumu muwachite zomwe munachita Zeba ndi Zalimuna,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"amene anati, “Tiyeni tilande dziko","poem":1},{"text":"la msipu la Mulungu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Muwasandutse fumbi lowuluka, Inu Mulungu wanga,","poem":1},{"text":"ngati mankhusu owuluka ndi mphepo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Monga moto umatentha nkhalango,","poem":1},{"text":"kapena malawi a moto kuyatsa phiri,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kotero muwathamangitse ndi mphepo yamkuntho,","poem":1},{"text":"ndi kuwachititsa mantha ndi namondwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Muphimbe nkhope zawo ndi manyazi","poem":1},{"text":"kuti adzafunefune dzina lanu Yehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Achite manyazi ndi mantha nthawi zonse;","poem":1},{"text":"awonongeke mwa manyazi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Adziwe kuti Inu amene dzina lanu ndi Yehova,","poem":1},{"text":"ndinu nokha Wammwambamwamba pa dziko lonse lapansi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}