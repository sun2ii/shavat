{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a Gititi. Salimo la ana a Kora."]},{"type":"verse","number":1,"content":[{"text":"Malo anu okhalamo ndi okomadi,","poem":1},{"text":"Inu Yehova Wamphamvuzonse!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moyo wanga ukulakalaka, mpaka kukomoka,","poem":1},{"text":"kufuna mabwalo a Yehova;","poem":2},{"text":"Mtima wanga ndi thupi langa zikufuwulira","poem":1},{"text":"Mulungu wamoyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngakhale timba wapeza nyumba yokhalamo,","poem":1},{"text":"ndiponso namzeze wadzipezera yekha chisa,","poem":2},{"lineBreak":true},{"text":"kumene amagonekako ana ake","poem":2},{"text":"pafupi ndi guwa lanu la nsembe,","poem":1},{"text":"Inu Yehova Wamphamvuzonse, Mfumu yanga ndi Mulungu wanga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Odala amene amakhala mʼNyumba yanu;","poem":1},{"text":"nthawi zonse amakutamandani.","poem":2},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Odala amene mphamvu yawo ili mwa Inu,","poem":1},{"text":"mitima yawo ikufunitsitsa kuyenda mʼmisewu yopita ku Ziyoni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pamene akudutsa chigwa cha Baka,","poem":1},{"text":"amachisandutsa malo a akasupe;","poem":2},{"lineBreak":true},{"text":"mvula ya chizimalupsa imadzazanso mayiwe ake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iwo amanka nakulirakulira mphamvu","poem":1},{"text":"mpaka aliyense ataonekera pamaso pa Mulungu mu Ziyoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Imvani pemphero langa, Inu Yehova Mulungu Wamphamvuzonse;","poem":1},{"text":"mvereni Inu Mulungu wa Yakobo.","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Yangʼanani chishango chathu, Inu Mulungu;","poem":1},{"text":"yangʼanani mokoma mtima pa wodzozedwa wanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nʼkwabwino kukhala mʼmabwalo anu tsiku limodzi","poem":1},{"text":"kuposa kukhala kwina kwake kwa zaka 1,000;","poem":2},{"text":"Ine ndingakonde kukhala mlonda wa pa khomo la Nyumba ya Mulungu wanga","poem":1},{"text":"kuposa kukhala mʼmatenti a anthu oyipa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pakuti Yehova Mulungu ndi dzuwa ndi chishango;","poem":1},{"text":"Yehova amapereka chisomo ndi ulemu;","poem":2},{"text":"Iye sawamana zinthu zabwino","poem":1},{"text":"iwo amene amayenda mwangwiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Inu Yehova Wamphamvuzonse,","poem":1},{"text":"wodala ndi munthu amene amakhulupirira Inu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}