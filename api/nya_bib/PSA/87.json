{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Salimo la Ana a Kora."]},{"type":"verse","number":1,"content":[{"text":"Iye wakhazikitsa maziko ake pa phiri loyera;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Yehova amakonda zipata za Ziyoni","poem":2},{"lineBreak":true},{"text":"kupambana malo onse okhalamo a Yakobo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Za ulemerero wako zimakambidwa,","poem":1},{"text":"Iwe mzinda wa Mulungu:","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":4,"content":[{"text":"“Ndidzanena za Rahabe ndi Babuloni","poem":1},{"text":"pakati pa iwo amene amandidziwa.","poem":2},{"text":"Dzikonso la Filisitiya, Turo pamodzi ndi Kusi,","poem":1},{"text":"ndipo ndidzati, ‘Uyu anabadwira mʼZiyoni.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndithudi, za Ziyoni adzanena kuti,","poem":1},{"text":"“Uyu ndi uyo anabadwira mwa iye,","poem":2},{"lineBreak":true},{"text":"ndipo Wammwambamwamba adzakhazikitsa iyeyo.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yehova adzalemba mʼbuku la kawundula wa anthu a mitundu ina:","poem":1},{"text":"“Uyu anabadwira mʼZiyoni.”","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Oyimba ndi ovina omwe adzati,","poem":1},{"text":"“Akasupe anga onse ali mwa iwe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}