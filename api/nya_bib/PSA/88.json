{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"hebrew_subtitle","content":["Salimo la ana a Kora. Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a nyimbo yoti: “Pa Matenda ndi pa Mazunzo.” Ndakatulo ya Hemani, wa banja la Ezara."]},{"type":"verse","number":1,"content":[{"text":"Inu Yehova, Mulungu amene mumandipulumutsa,","poem":1},{"text":"usana ndi usiku ndimalira pamaso panu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pemphero langa lifike pamaso panu;","poem":1},{"text":"tcherani khutu lanu kuti mumve kulira kwanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pakuti ndili ndi mavuto ambiri","poem":1},{"text":"ndipo moyo wanga ukuyandikira ku manda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndikuwerengedwa pamodzi ndi iwo amene akutsikira ku dzenje;","poem":1},{"text":"ndine munthu wopanda mphamvu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndayikidwa pambali pamodzi ndi anthu akufa,","poem":1},{"text":"monga ophedwa amene agona mʼmanda,","poem":2},{"text":"amene Inu simuwakumbukiranso,","poem":1},{"text":"amene achotsedwa pa chisamaliro chanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mwandiyika pansi pa dzenje penipeni,","poem":1},{"text":"mʼmalo akuya a mdima waukulu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ukali wanu ukundipsinja kwambiri,","poem":1},{"text":"mwandiopseza kwambiri ndi mafunde anu onse.","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Mwandichotsa pakati pa abwenzi anga enieni","poem":1},{"text":"ndipo mwachititsa kuti ndikhale chonyansa kwa iwo.","poem":2},{"text":"Ndatsekerezedwa ndipo sindingathe kuthawa;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"maso anga ada ndi chisoni.","poem":2},{"lineBreak":true},{"text":"Ndimayitana Inu Yehova tsiku lililonse;","poem":1},{"text":"ndimakweza manja anga kwa Inu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodi mumaonetsa zozizwitsa zanu kwa anthu akufa?","poem":1},{"text":"Kodi iwo amene afa amaukanso ndi kutamanda Inu?","poem":2},{"text":"Sela","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Kodi chikondi chanu chimalalikidwa mʼmanda,","poem":1},{"text":"za kukhulupirika kwanu ku malo a chiwonongeko?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kodi zozizwitsa zanu zimadziwika ku malo a mdima,","poem":1},{"text":"kapena ntchito zanu zolungama ku dziko la anthu oyiwalika?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Inu Yehova, Ine ndimalirira thandizo;","poem":1},{"text":"mmawa mapemphero anga amafika pamaso panu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inu Yehova nʼchifukwa chiyani mukundikana","poem":1},{"text":"ndi kundibisira nkhope yanu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kuyambira ubwana wanga ndakhala ndikuzunzika pafupi kufa;","poem":1},{"text":"ndakhala ndikuchita mantha ndipo ndine wothedwa nzeru.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ukali wanu wandimiza;","poem":1},{"text":"zoopsa zanu zandiwononga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tsiku lonse zimandizungulira ngati chigumula;","poem":1},{"text":"zandimiza kwathunthu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Inu mwatenga anzanga ndi okondedwa anga kuwachotsa pamaso panga;","poem":1},{"text":"mdima ndiye bwenzi langa lenileni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}