{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"Iye amene amakhala mu mthunzi wa Wammwambamwamba","poem":1},{"text":"adzapuma mu mthunzi wa Wamphamvuzonse.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndidzanena za Yehova, “Iye ndiye pothawira panga ndi linga langa,","poem":1},{"text":"Mulungu wanga amene ndimadalira.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ndithu, Iye adzakupulumutsa ku msampha wa mlenje","poem":1},{"text":"ndi ku mliri woopsa;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adzakuphimba ndi nthenga zake,","poem":1},{"text":"ndipo udzapeza malo othawira mʼmapikomo;","poem":2},{"lineBreak":true},{"text":"kukhulupirika kwake kudzakhala chishango chako ndi lihawo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sudzachita mantha ndi zoopsa za usiku,","poem":1},{"text":"kapena muvi wowuluka masana,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kapena mliri umene umayenda mu mdima,","poem":1},{"text":"kapena zowononga za pa nthawi ya masana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anthu 1,000 atha kufa pambali pako,","poem":1},{"text":"anthu 10,000 kudzanja lako lamanja,","poem":2},{"lineBreak":true},{"text":"koma zoopsazo sizidzafika pafupi ndi iwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Udzapenya ndi maso ako","poem":1},{"text":"ndipo udzaona mmene anthu oyipa amalangidwira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Pakuti wasankha Wammwambamwamba kukhala malo ako okhalamo;","poem":1},{"text":"wavomera Yehova kukhala kothawira kwako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Choncho palibe choyipa chimene chidzakugwera,","poem":1},{"text":"zoopsa sizidzafika pafupi ndi tenti yako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pakuti adzalamulira angelo ake za iwe,","poem":1},{"text":"kuti akutchinjirize mosamala pa njira zako zonse;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ndipo adzakunyamula ndi manja awo,","poem":1},{"text":"kuti phazi lako lisagunde pa mwala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Udzapondaponda mkango ndi njoka,","poem":1},{"text":"udzapondereza mkango wamphamvu ndiponso chinjoka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Chifukwa iye amandikonda,” akutero Yehova, “Ndidzamulanditsa;","poem":1},{"text":"ndidzamuteteza pakuti wavomereza dzina langa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Adzandiyitana, ndipo ndidzamuyankha;","poem":1},{"text":"ndidzakhala naye pa mavuto,","poem":2},{"lineBreak":true},{"text":"ndidzamupulumutsa ndi kumulemekeza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndidzamupatsa moyo wautali","poem":1},{"text":"ndi kumupulumutsa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}