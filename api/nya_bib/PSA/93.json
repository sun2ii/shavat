{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Yehova akulamulira, wavala ulemerero;","poem":1},{"text":"Yehova wavala ulemerero ndipo wadzimangirira mphamvu,","poem":2},{"lineBreak":true},{"text":"dziko lonse lakhazikika kolimba; silingasunthidwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mpando wanu waufumu unakhazikika kalekale;","poem":1},{"text":"Inu ndinu wamuyaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nyanja zakweza Inu Yehova,","poem":1},{"text":"nyanja zakweza mawu ake;","poem":2},{"lineBreak":true},{"text":"nyanja zakweza mafunde ake ochita mkokomo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yehova ndi wamphamvu kupambana mkokomo wa madzi ambiri,","poem":1},{"text":"ndi wamphamvu kupambana mafunde a nyanja,","poem":2},{"lineBreak":true},{"text":"Yehova mmwamba ndi wamphamvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Malamulo anu Yehova ndi osasinthika;","poem":1},{"text":"chiyero chimakongoletsa nyumba yanu","poem":2},{"lineBreak":true},{"text":"mpaka muyaya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}