{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"Yehova akulamulira, dziko lapansi lisangalale;","poem":1},{"text":"magombe akutali akondwere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mitambo ndi mdima waukulu zamuzungulira;","poem":1},{"text":"chilungamo ndi kuweruza molungama ndiwo maziko a mpando wake waufumu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Moto umapita patsogolo pake","poem":1},{"text":"ndi kunyeketsa amaliwongo kumbali zonse.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zingʼaningʼani zake zimawalitsa dziko lonse;","poem":1},{"text":"dziko lapansi limaona ndipo limanjenjemera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mapiri amasungunuka ngati phula pamaso pa Yehova,","poem":1},{"text":"pamaso pa Ambuye a dziko lonse lapansi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mayiko akumwamba amalengeza za chilungamo chake,","poem":1},{"text":"ndipo mitundu yonse ya anthu imaona ulemerero wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Onse amene amalambira mafano osema amachititsidwa manyazi,","poem":1},{"text":"iwo amene amanyadira mafano;","poem":2},{"lineBreak":true},{"text":"mulambireni, inu milungu yonse!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ziyoni akumva ndipo akukondwera,","poem":1},{"text":"midzi ya Yuda ikusangalala","poem":2},{"lineBreak":true},{"text":"chifukwa cha maweruzo anu Yehova.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pakuti Inu Yehova ndi Wammwambamwamba pa dziko lonse lapansi;","poem":1},{"text":"ndinu wokwezeka kupambana milungu yonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Iwo amene amakonda Yehova adane ndi zoyipa","poem":1},{"text":"pakuti Iye amayangʼanira miyoyo ya amene amamukhulupirira","poem":2},{"lineBreak":true},{"text":"ndipo amawapulumutsa mʼdzanja la anthu oyipa","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kuwala kumafika pa anthu olungama,","poem":1},{"text":"ndi chimwemwe kwa olungama mtima.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kondwerani mwa Yehova Inu olungama","poem":1},{"text":"ndipo tamandani dzina lake loyera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}