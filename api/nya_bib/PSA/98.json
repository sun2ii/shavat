{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Salimo."]},{"type":"verse","number":1,"content":[{"text":"Imbirani Yehova nyimbo yatsopano,","poem":1},{"text":"pakuti Iyeyo wachita zinthu zodabwitsa;","poem":2},{"text":"dzanja lake lamanja ndi mkono wake woyera","poem":1},{"text":"zamuchitira chipulumutso.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yehova waonetsa chipulumutso chake","poem":1},{"text":"ndipo waulula chilungamo chake kwa anthu a mitundu ina.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iye wakumbukira chikondi chake","poem":1},{"text":"ndi kukhulupirika kwake pa Aisraeli;","poem":2},{"text":"malekezero onse a dziko lapansi aona","poem":1},{"text":"chipulumutso cha Mulungu wathu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Fuwulani mwachimwemwe kwa Yehova, dziko lonse lapansi,","poem":1},{"text":"muyimbireni nyimbo mofuwula ndi mokondwera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Imbirani Yehova nyimbo ndi zeze,","poem":1},{"text":"ndi zeze ndi mawu a kuyimba,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ndi malipenga ndi kuliza kwa nyanga ya nkhosa yayimuna","poem":1},{"text":"fuwulani mwachimwemwe pamaso pa Yehova Mfumu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nyanja ikokome pamodzi ndi zonse zili mʼmenemo,","poem":1},{"text":"dziko lonse ndi onse amene amakhala mʼmenemo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mitsinje iwombe mʼmanja mwawo,","poem":1},{"text":"mapiri ayimbe pamodzi mwachimwemwe;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"izo ziyimbe pamaso pa Yehova,","poem":1},{"text":"pakuti Iye akubwera kudzaweruza dziko lapansi.","poem":2},{"text":"Adzaweruza dziko lonse mwachilungamo,","poem":1},{"text":"ndi mitundu ya anthu mosakondera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}