{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"PSA","translationId":"nya_bib","name":"MASALIMO","commonName":"MASALIMO","title":"Masalimo","order":19,"numberOfChapters":150,"sha256":"1dd062b999243583df143687d4cdfa826065b821f18b045af24ec1fcd1678199","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nya_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Yehova akulamulira,","poem":1},{"text":"mitundu ya anthu injenjemere;","poem":2},{"text":"Iye wakhala pa mpando wake waufumu, pakati pa akerubi,","poem":1},{"text":"dziko lapansi ligwedezeke.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mʼziyoni wamkulu ndi Yehova;","poem":1},{"text":"Iye ndi wokwezeka pamwamba pa mitundu yonse ya anthu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anthu atamande dzina lanu lalikulu ndi loopsa kwambiri,","poem":1},{"text":"Iye ndi woyera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mfumu yamphamvu, iyo imakonda chilungamo","poem":1},{"text":"Inu mwakhazikitsa khalidwe losakondera;","poem":2},{"text":"mwachita zolungama ndi zoyenera mwa Yakobo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kwezani Yehova Mulungu wathu","poem":1},{"text":"ndipo mulambireni pa mapazi ake;","poem":2},{"lineBreak":true},{"text":"Iye ndi woyera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mose ndi Aaroni anali ena mwa ansembe ake,","poem":1},{"text":"Samueli anali pamodzi ndi iwo amene anayitana pa dzina lake;","poem":2},{"text":"iwo anayitana Yehova","poem":1},{"text":"ndipo Iyeyo anawayankha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iye anayankhula nawo kuchokera mʼchipilala cha mtambo;","poem":1},{"text":"iwo anasunga malamulo ake ndi zophunzitsa zomwe anawapatsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Inu Yehova Mulungu wathu,","poem":1},{"text":"munawayankha iwo;","poem":2},{"text":"Inu kwa Israeli munali Mulungu wokhululuka,","poem":1},{"text":"ngakhale munawalanga pa zochita zawo zoyipa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwezani Yehova Mulungu wathu","poem":1},{"text":"ndipo mumulambire pa phiri lake loyera,","poem":2},{"lineBreak":true},{"text":"pakuti Yehova Mulungu wathu ndi woyera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}