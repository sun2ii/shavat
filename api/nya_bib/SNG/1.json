{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"SNG","translationId":"nya_bib","name":"NYIMBO YA SOLOMONI","commonName":"NYIMBO YA SOLOMONI","title":"Nyimbo ya Solomoni","order":22,"numberOfChapters":8,"sha256":"4fccf43086e35c09115dfde5e84aa3358b2c5636a8345091516fba10ce884105","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nya_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Nyimbo ya Solomoni, nyimbo yoposa nyimbo zonse."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Undipsompsone ndi milomo yako","poem":1},{"text":"chifukwa chikondi chako nʼchokoma kuposa vinyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mafuta ako odzola ndi onunkhira bwino;","poem":1},{"text":"dzina lako lili ngati mafuta onunkhira otsanulidwa.","poem":2},{"lineBreak":true},{"text":"Nʼchifukwa chake atsikana amakukonda!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nditenge ndipo ndizikutsata, tiye tifulumire!","poem":1},{"text":"Mfumu indilowetse mʼchipinda chake.","poem":2},"Abwenzi",{"text":"Ife timasangalala ndi kukondwera nawe,","poem":1},{"text":"tidzatamanda chikondi chako kupambana vinyo.","poem":2},"Mkazi",{"text":"Amachita bwinotu potamanda iwe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndine wakuda, komatu ndine wokongola,","poem":1},{"text":"inu akazi a ku Yerusalemu,","poem":2},{"lineBreak":true},{"text":"ine ndine wakuda ngati tenti ya ku Kedara,","poem":2},{"lineBreak":true},{"text":"ngati makatani a tenti ya Solomoni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Musandiyangʼane monyoza chifukwa ndine wakuda,","poem":1},{"text":"ndine wakuda chifukwa cha dzuwa.","poem":2},{"text":"Alongo anga anandikwiyira","poem":1},{"text":"ndipo anandigwiritsa ntchito mʼminda ya mpesa;","poem":2},{"lineBreak":true},{"text":"munda wangawanga sindinawusamalire.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndiwuze iwe, amene ndimakukonda, kumene umadyetsa ziweto zako","poem":1},{"text":"ndi kumene umagoneka nkhosa zako nthawi yamasana.","poem":2},{"text":"Ndikhalirenji ngati mkazi wachiwerewere","poem":1},{"text":"pambali pa ziweto za abwenzi ako?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngati sukudziwa iwe wokongola kwambiri kuposa akazi ena,","poem":1},{"text":"ngati sukudziwa, tsatira makwalala a nkhosa","poem":2},{"text":"ndipo udyetse ana ambuzi","poem":1},{"text":"pambali pa matenti a abusa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iwe bwenzi langa,","poem":1},{"text":"uli ngati kavalo wamkazi ku magaleta a Farao.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Masaya ako ndi okongola ndi ndolo zamʼmakutuzo,","poem":1},{"text":"khosi lako likukongola ndi mikanda yamiyala yamtengowapatali.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tidzakupangira ndolo zagolide","poem":1},{"text":"zokongoletsedwa ndi mikanda yasiliva.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pamene mfumu inali pa malo ake odyera,","poem":1},{"text":"mafuta anga onunkhira anamveka fungo lake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wokondedwa wanga ali ngati kathumba ka mure kwa ine,","poem":1},{"text":"kamene kamakhala pakati pa mawere angawa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wokondedwa wanga ali ngati mpukutu wa maluwa ofiira,","poem":1},{"text":"ochokera ku minda ya mpesa ya ku Eni-Gedi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iwe wokondedwa wanga, ndiwe wokongoladi!","poem":1},{"text":"Ndithu, ndiwe chiphadzuwa,","poem":2},{"lineBreak":true},{"text":"maso ako ali ngati nkhunda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iwe bwenzi langa, ndiwe wokongoladi!","poem":1},{"text":"Ndithu, ndiwe wokongoladi kwambiri!","poem":2},{"lineBreak":true},{"text":"Ndipo malo athu ogonapo ndi msipu wobiriwira.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mitanda ya nyumba yathu ndi ya mkungudza,","poem":1},{"text":"phaso lake ndi la mtengo wa payini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}