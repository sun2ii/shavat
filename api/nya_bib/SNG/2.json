{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"SNG","translationId":"nya_bib","name":"NYIMBO YA SOLOMONI","commonName":"NYIMBO YA SOLOMONI","title":"Nyimbo ya Solomoni","order":22,"numberOfChapters":8,"sha256":"4fccf43086e35c09115dfde5e84aa3358b2c5636a8345091516fba10ce884105","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nya_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ine ndine duwa la ku Saroni,","poem":1},{"text":"duwa lokongola la ku zigwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Monga duwa lokongola pakati pa minga","poem":1},{"text":"ndi momwe alili wokondedwa wanga pakati pa atsikana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Monga mtengo wa apulosi pakati pa mitengo ya mʼnkhalango","poem":1},{"text":"ndi momwe alili bwenzi langa pakati pa anyamata.","poem":2},{"text":"Ndimakondwera kukhala pansi pa mthunzi wako,","poem":1},{"text":"ndipo chipatso chake ndi chokoma mʼkamwa mwanga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iye wanditengera ku nyumba yaphwando,","poem":1},{"text":"ndipo mbendera yake yozika pa ine ndi chikondi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Undidyetse keke ya mphesa zowuma,","poem":1},{"text":"unditsitsimutse ndi ma apulosi,","poem":2},{"lineBreak":true},{"text":"pakuti chikondi chandifowoketsa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mutu wanga watsamira dzanja lake lamanzere,","poem":1},{"text":"ndipo dzanja lake lamanja landikumbatira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inu akazi a ku Yerusalemu, ndithu ndikukupemphani","poem":1},{"text":"pali gwape ndi mbawala yayikazi zakuthengo:","poem":2},{"text":"Musachigwedeze chikondi kapena kuchiutsa","poem":1},{"text":"mpaka pamene chifunire ichocho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tamverani bwenzi langa!","poem":1},{"text":"Taonani! Uyu akubwera apayu,","poem":2},{"text":"akulumphalumpha pa mapiri,","poem":1},{"text":"akujowajowa pa zitunda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bwenzi langa ali ngati gwape kapena mwana wa mbawala.","poem":1},{"text":"Taonani! Uyo wayima kuseri kwa khoma lathulo,","poem":2},{"text":"akusuzumira mʼmazenera,","poem":1},{"text":"akuyangʼana pa mpata wa zenera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bwenzi langa anayankha ndipo anati kwa ine,","poem":1},{"text":"“Dzuka bwenzi langa,","poem":2},{"lineBreak":true},{"text":"wokongola wanga, ndipo tiye tizipita.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ona, nyengo yozizira yatha;","poem":1},{"text":"mvula yatha ndipo yapitiratu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maluwa ayamba kuoneka pa dziko lapansi;","poem":1},{"text":"nthawi yoyimba yafika,","poem":2},{"text":"kulira kwa njiwa kukumveka","poem":1},{"text":"mʼdziko lathu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mtengo wankhuyu ukubereka zipatso zake zoyambirira;","poem":1},{"text":"mitengo ya mpesa ya maluwa ikutulutsa fungo lake.","poem":2},{"text":"Dzuka bwenzi langa, wokongola wanga","poem":1},{"text":"tiye tizipita.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nkhunda yanga yokhala mʼmingʼalu ya thanthwe,","poem":1},{"text":"mʼmalo obisala a mʼmbali mwa phiri,","poem":2},{"text":"onetsa nkhope yako,","poem":1},{"text":"nʼtamvako liwu lako;","poem":2},{"text":"pakuti liwu lako ndi lokoma,","poem":1},{"text":"ndipo nkhope yako ndi yokongola.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mutigwirire nkhandwe,","poem":1},{"text":"nkhandwe zingʼonozingʼono","poem":2},{"text":"zimene zikuwononga minda ya mpesa,","poem":1},{"text":"minda yathu ya mpesa imene yayamba maluwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bwenzi langa ndi wangadi ndipo ine ndine wake;","poem":1},{"text":"amadyetsa gulu lake la ziweto pakati pa maluwa okongola.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kamphepo kamadzulo kakayamba kuwuzira","poem":1},{"text":"ndipo mithunzi ikayamba kuthawa,","poem":2},{"text":"unyamuke bwenzi langa,","poem":1},{"text":"ndipo ukhale ngati gwape","poem":2},{"text":"kapena ngati mwana wa mbawala","poem":1},{"text":"pakati pa mapiri azigwembezigwembe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}