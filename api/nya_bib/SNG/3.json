{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"SNG","translationId":"nya_bib","name":"NYIMBO YA SOLOMONI","commonName":"NYIMBO YA SOLOMONI","title":"Nyimbo ya Solomoni","order":22,"numberOfChapters":8,"sha256":"4fccf43086e35c09115dfde5e84aa3358b2c5636a8345091516fba10ce884105","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nya_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Usiku wonse ndili pa bedi langa","poem":1},{"text":"ndinafunafuna amene mtima wanga umamukonda;","poem":2},{"lineBreak":true},{"text":"ndinamufunafuna koma osamupeza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndikudzuka tsopano ndipo ndidzayendayenda mu mzinda,","poem":1},{"text":"mʼmisewu yake ndi mʼmabwalo ake;","poem":2},{"text":"ndidzamufunafuna amene mtima wanga umamukonda.","poem":1},{"text":"Kotero ine ndinamufunafuna iyeyo koma osamupeza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Alonda anandipeza","poem":1},{"text":"pamene ankayendera mzinda.","poem":2},{"lineBreak":true},{"text":"“Kodi mwamuonako amene mtima wanga umamukonda?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nditawapitirira pangʼono","poem":1},{"text":"ndinamupeza amene mtima wanga umamukonda.","poem":2},{"text":"Ndinamugwira ndipo sindinamulole kuti achoke","poem":1},{"text":"mpaka nditamulowetsa mʼnyumba ya amayi anga,","poem":2},{"lineBreak":true},{"text":"mʼchipinda cha amene anandibereka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inu akazi a ku Yerusalemu, ndithu ndikukupemphani","poem":1},{"text":"pali gwape ndi mbawala yayikazi zakuthengo:","poem":2},{"text":"Musachigwedeze chikondi kapena kuchiutsa","poem":1},{"text":"mpaka pamene chifunire ichocho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kodi ndani amene akubwera kuchokera ku chipululu","poem":1},{"text":"ngati utsi watolotolo,","poem":2},{"text":"wonunkhira mure ndi lubani,","poem":1},{"text":"zopangidwa kuchokera ku zonunkhira zonse za anthu amalonda?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ona! Chimenecho ndi chonyamulira Solomoni,","poem":1},{"text":"choperekezedwa ndi asilikali 60,","poem":2},{"lineBreak":true},{"text":"anthu amphamvu a ku Israeli,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"onse atanyamula lupanga,","poem":1},{"text":"onse odziwa bwino nkhondo,","poem":2},{"text":"aliyense ali ndi lupanga pambali pake,","poem":1},{"text":"kukonzekera zoopsa za usiku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mfumu Solomoni anadzipangira chonyamulirachi;","poem":1},{"text":"anachipanga ndi matabwa ochokera ku Lebanoni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Milongoti yake anayipanga yasiliva,","poem":1},{"text":"kumbuyo kwake kwa golide.","poem":2},{"text":"Mipando yake inakutidwa ndi nsalu yapepo,","poem":1},{"text":"anakongoletsa mʼkati mwake ndi chikondi","poem":2},{"lineBreak":true},{"text":"cha akazi a ku Yerusalemu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tukulani inu akazi a ku Ziyoni","poem":1},{"text":"ndipo mudzaone mfumu Solomoni atavala chipewa chaufumu,","poem":2},{"lineBreak":true},{"text":"chipewa chaufumu chimene amayi ake anamuveka","poem":2},{"text":"pa tsiku la ukwati wake,","poem":1},{"text":"tsiku limene mtima wake unasangalala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}