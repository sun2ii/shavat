{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"SNG","translationId":"nya_bib","name":"NYIMBO YA SOLOMONI","commonName":"NYIMBO YA SOLOMONI","title":"Nyimbo ya Solomoni","order":22,"numberOfChapters":8,"sha256":"4fccf43086e35c09115dfde5e84aa3358b2c5636a8345091516fba10ce884105","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nya_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Ndiwe wokongoladi wokondedwa wanga!","poem":1},{"text":"Ndithudi, ndiwe wokongola!","poem":2},{"lineBreak":true},{"text":"Maso ako ali ngati nkhunda kumbuyo kwa nsalu yophimba kumutu.","poem":2},{"text":"Tsitsi lako lili ngati gulu la mbuzi","poem":1},{"text":"zikutsetsereka kuchokera ku Giliyadi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mano ako ali ngati gulu la nkhosa zomwe zangometedwa kumene,","poem":1},{"text":"zochokera kozisambitsa kumene.","poem":2},{"text":"Iliyonse ili ndi ana amapasa;","poem":1},{"text":"palibe imene ili yokha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Milomo yako ili ngati mbota yofiira;","poem":1},{"text":"pakamwa pako ndi pokongola kwambiri.","poem":2},{"text":"Kukhalira kumbuyo kwa nsalu yako yophimba","poem":1},{"text":"kumutuyo, masaya ako akuoneka ngati mabandu a makangadza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Khosi lako lili ngati nsanja ya Davide,","poem":1},{"text":"yomangidwa bwino ndi yosalala;","poem":2},{"text":"pa nsanja imeneyo pali zishango 1,000,","poem":1},{"text":"zishango zonsezo za anthu ankhondo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mawere ako ali ngati tiana tiwiri ta nswala,","poem":1},{"text":"ngati ana amapasa a nswala","poem":2},{"lineBreak":true},{"text":"amene akudya pakati pa maluwa okongola.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kamphepo kamadzulo kakayamba kuwuzira","poem":1},{"text":"ndipo mithunzi ikayamba kuthawa,","poem":2},{"text":"ndidzapita ku phiri la mure","poem":1},{"text":"ndi ku chitunda cha lubani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndiwe wokongola kwambiri wokondedwa wanga;","poem":1},{"text":"palibe chilema pa iwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tiye tichoke ku Lebanoni iwe mkwatibwi wanga,","poem":1},{"text":"tiye tichoke ku Lebanoni,","poem":2},{"text":"utsikepo pa msonga ya Amana,","poem":1},{"text":"kuchoka pa msonga ya phiri la Seniri, pamwamba penipeni pa Herimoni,","poem":2},{"text":"kuchoka ku mapanga a mikango","poem":1},{"text":"ndiponso kumapiri kumene akambuku amavutitsa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iwe mlongo wanga, mkwatibwi wanga, wanditenga mtima,","poem":1},{"text":"iwe wanditenga mtima","poem":2},{"text":"ndi kapenyedwe ka maso ako,","poem":1},{"text":"ndiponso ndi umodzi mwa mikanda ya mʼkhosi mwako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iwe mlongo wanga, mkwatibwi wanga, chikondi chako nʼchosangalatsa!","poem":1},{"text":"Chikondi chako nʼchosangalatsa kwambiri kupambana vinyo,","poem":2},{"lineBreak":true},{"text":"ndiponso fungo la mafuta ako ndi lopambana zonunkhiritsa zonse!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iwe mkwatibwi wanga, milomo yako ikuchucha uchi ngati chisa cha njuchi;","poem":1},{"text":"pansi pa lilime lako pali mkaka ndi uchi.","poem":2},{"lineBreak":true},{"text":"Fungo lonunkhira la zovala zako likumveka ngati fungo la ku Lebanoni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iwe mlongo wanga, mkwatibwi wanga, ndiwe munda wopiringidzidwa;","poem":1},{"text":"ndiwe kasupe wotchingidwa, chitsime chotetezedwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zomera zako ndi munda wa zipatso za makangadza;","poem":1},{"text":"muli zipatso zokoma kwambiri,","poem":2},{"lineBreak":true},{"text":"muli hena ndi nadi,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nadi ndi safiro,","poem":2},{"lineBreak":true},{"text":"kalamusi ndi sinamoni,","poem":2},{"lineBreak":true},{"text":"komanso mtengo uliwonse wonunkhira bwino.","poem":2},{"lineBreak":true},{"text":"Mulinso mure ndi aloe","poem":2},{"lineBreak":true},{"text":"ndi zonunkhiritsa zonse zabwino kwambiri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iwe ndiwe kasupe wa mʼmunda,","poem":1},{"text":"chitsime cha madzi oyenda,","poem":2},{"lineBreak":true},{"text":"mtsinje wa madzi ochokera ku Lebanoni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dzuka, iwe mphepo yakumpoto,","poem":1},{"text":"ndipo bwera, iwe mphepo yakummwera!","poem":2},{"text":"Uzira pa munda wanga,","poem":1},{"text":"kuti fungo lake lonunkhira lifalikire ponseponse.","poem":2},{"text":"Bwenzi langa alowe mʼmunda mwake","poem":1},{"text":"ndi kudya zipatso zake zabwino kwambiri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}