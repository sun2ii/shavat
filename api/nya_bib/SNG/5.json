{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"SNG","translationId":"nya_bib","name":"NYIMBO YA SOLOMONI","commonName":"NYIMBO YA SOLOMONI","title":"Nyimbo ya Solomoni","order":22,"numberOfChapters":8,"sha256":"4fccf43086e35c09115dfde5e84aa3358b2c5636a8345091516fba10ce884105","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nya_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Ndalowa mʼmunda mwanga, iwe mlongo wanga, iwe mkwatibwi wanga;","poem":1},{"text":"ndasonkhanitsa mure wanga ndi zokometsera zakudya zanga.","poem":2},{"text":"Ndadya uchi wanga pamodzi ndi zisa zake zomwe;","poem":1},{"text":"ndamwa vinyo wanga ndi mkaka wanga.","poem":2},"Abwenzi",{"text":"Idyani abwenzi anga, imwani;","poem":1},{"text":"Inu okondana, imwani kwambiri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndinagona tulo koma mtima wanga unali maso.","poem":1},{"text":"Tamverani, bwenzi langa akugogoda:","poem":2},{"text":"“Nditsekulire, mlongo wanga, bwenzi langa,","poem":1},{"text":"nkhunda yanga, wangwiro wanga.","poem":2},{"text":"Mutu wanga wanyowa ndi mame,","poem":1},{"text":"tsitsi langa lanyowa chifukwa cha nkhungu ya usiku.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndavula kale zovala zanga,","poem":1},{"text":"kodi ndizivalenso?","poem":2},{"text":"Ndasamba kale mapazi anga","poem":1},{"text":"kodi ndiwadetsenso?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bwenzi langa anapisa dzanja lake pa chibowo cha pa chitseko;","poem":1},{"text":"mtima wanga unagunda chifukwa cha iye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndinanyamuka kukamutsekulira wachikondi wangayo,","poem":1},{"text":"ndipo manja anga anali noninoni ndi mure,","poem":2},{"text":"zala zanga zinali mure chuchuchu,","poem":1},{"text":"pa zogwirira za chotsekera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndinamutsekulira wachikondi wanga,","poem":1},{"text":"koma nʼkuti wachikondi wangayo atachoka; iye anali atapita.","poem":2},{"lineBreak":true},{"text":"Mtima wanga unafumuka chifukwa cha kuchoka kwake.","poem":2},{"text":"Ndinamuyangʼanayangʼana koma sindinamupeze.","poem":1},{"text":"Ndinamuyitana koma sanandiyankhe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Alonda anandipeza","poem":1},{"text":"pamene ankayendera mzindawo.","poem":2},{"text":"Anandimenya ndipo anandipweteka;","poem":1},{"text":"iwo anandilanda mwinjiro wanga,","poem":2},{"lineBreak":true},{"text":"alonda a pa khoma aja!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inu akazi a ku Yerusalemu ndithu ndikukupemphani,","poem":1},{"text":"mukapeza wokondedwa wangayo,","poem":2},{"text":"kodi mudzamuwuza chiyani?","poem":1},{"text":"Muwuzeni kuti ine ndadwala nacho chikondi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iwe wokongola kuposa akazi onsewa,","poem":1},{"text":"kodi wokondedwa wakoyo ndi wopambana wina aliyense bwanji?","poem":2},{"text":"Kodi wokondedwa wakoyo ndi wopambana ena onse chotani","poem":1},{"text":"kuti uzichita kutipempha motere?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wokondedwa wangayo ndi wowala kwambiri ndi wathanzi","poem":1},{"text":"pakati pa anthu 1,000.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mutu wake ndi golide woyengeka bwino;","poem":1},{"text":"tsitsi lake ndi lopotanapotana,","poem":2},{"lineBreak":true},{"text":"ndiponso lakuda bwino ngati khwangwala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maso ake ali ngati nkhunda","poem":1},{"text":"mʼmbali mwa mitsinje ya madzi,","poem":2},{"text":"ngati nkhunda zitasamba mu mkaka,","poem":1},{"text":"zitayima ngati miyala yamtengowapatali.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Masaya ake ali ngati timinda ta mbewu zokometsera zakudya","poem":1},{"text":"zopatsa fungo lokoma.","poem":2},{"text":"Milomo yake ili ngati maluwa okongola","poem":1},{"text":"amene akuchucha mure.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Manja ake ali ngati ndodo zagolide","poem":1},{"text":"zokongoletsedwa ndi miyala yamtengowapatali.","poem":2},{"text":"Thupi lake ndi losalala ngati mnyanga wanjovu","poem":1},{"text":"woyikamo miyala ya safiro.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Miyendo yake ili ngati mizati yamwala,","poem":1},{"text":"yokhazikika pa maziko a golide.","poem":2},{"text":"Maonekedwe ake ali ngati Lebanoni,","poem":1},{"text":"abwino kwambiri ngati mkungudza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Milomo yake ndi yosangalatsa kwambiri;","poem":1},{"text":"munthuyo ndi wokongola kwambiri!","poem":2},{"text":"Uyu ndiye wachikondi wanga ndi bwenzi langa,","poem":1},{"text":"inu akazi a ku Yerusalemu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}