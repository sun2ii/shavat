{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"SNG","translationId":"nya_bib","name":"NYIMBO YA SOLOMONI","commonName":"NYIMBO YA SOLOMONI","title":"Nyimbo ya Solomoni","order":22,"numberOfChapters":8,"sha256":"4fccf43086e35c09115dfde5e84aa3358b2c5636a8345091516fba10ce884105","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/nya_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Ukanakhala kuti ndiwe mlongo wanga,","poem":1},{"text":"amene anayamwa mawere a amayi anga!","poem":2},{"text":"Ndikanakumana nawe pa njira,","poem":1},{"text":"ndikanakupsompsona,","poem":2},{"lineBreak":true},{"text":"ndipo palibe wina aliyense akanandinyoza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndikanakutenga","poem":1},{"text":"ndi kukulowetsa mʼnyumba ya amayi anga,","poem":2},{"lineBreak":true},{"text":"amayi amene anandiphunzitsa,","poem":2},{"text":"ndikanakupatsa vinyo wotsekemera kuti umwe,","poem":1},{"text":"zotsekemera za makangadza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mutu wanga watsamira dzanja lake lamanzere","poem":1},{"text":"ndipo dzanja lake lamanja landikumbatira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inu akazi a ku Yerusalemu, ndithu ndikukupemphani:","poem":1},{"text":"musachigwedeze chikondi kapena kuchiutsa","poem":2},{"lineBreak":true},{"text":"mpaka pamene chifunire ichocho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kodi ndani uyo akutuluka ku chipululuyo,","poem":1},{"text":"atatsamira wokondedwa wakeyo?","poem":2},"Mkazi",{"text":"Ndinakudzutsa pa tsinde pa mtengo wa apulosi,","poem":1},{"text":"pamenepo ndi pamene amayi anachirira,","poem":2},{"lineBreak":true},{"text":"pamenepo ndi pamene wokubereka anamva ululu pokubala iweyo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Undiyike pamtima pako ngati chidindo,","poem":1},{"text":"ngati chidindo cha pa dzanja lako;","poem":2},{"text":"pakuti chikondi nʼchamphamvu ngati imfa,","poem":1},{"text":"nsanje ndiyaliwuma ngati manda.","poem":2},{"text":"Chikondi chimachita kuti lawilawi","poem":1},{"text":"ngati malawi a moto wamphamvu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Madzi ochuluka sangachizimitse chikondi,","poem":1},{"text":"mitsinje singachikokolole chikondicho.","poem":2},{"text":"Ngati wina apereka chuma chonse","poem":1},{"text":"cha mʼnyumba mwake chifukwa cha chikondi,","poem":2},{"lineBreak":true},{"text":"adzangonyozeka nazo kotheratu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ife tili naye mlongo wathu wamngʼono,","poem":1},{"text":"koma alibe mawere,","poem":2},{"text":"kodi tidzamuchitira chiyani mlongo wathuyu","poem":1},{"text":"pa tsiku limene adzamufunsire?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngati iye ndi khoma,","poem":1},{"text":"tidzamumangira nsanja ya siliva.","poem":2},{"text":"Ngati iye ndi chitseko,","poem":1},{"text":"tidzamutchinga ndi matabwa a mkungudza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ine ndili ngati khoma,","poem":1},{"text":"ndipo mawere anga ndi nsanja zake.","poem":2},{"text":"Tsono mʼmaso mwa bwenzi langa","poem":1},{"text":"ndine wobweretsa mtendere.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Solomoni anali ndi munda wampesa ku Baala-Hamoni;","poem":1},{"text":"iyeyo anabwereketsa munda wamphesawo kwa alimi,","poem":2},{"text":"aliyense mwa iwo ankayenera kupereka","poem":1},{"text":"ndalama zasiliva 1,000 mʼmalo mwa zipatso zake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Koma munda wanga wampesa ndi wangawanga ndiponso wa ine ndekha.","poem":1},{"text":"Iwe Solomoni, khala nazo ndalama zasiliva 1,000","poem":2},{"lineBreak":true},{"text":"ndipo ndalama zasiliva 200 ndi za amene akusamalira mundawo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iwe amene umakhala mʼminda","poem":1},{"text":"uli pamodzi ndi anzako,","poem":2},{"lineBreak":true},{"text":"ndilole kuti ndimve liwu lako!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Fulumira wokondedwa wanga,","poem":1},{"text":"ndipo ukhale ngati gwape","poem":2},{"text":"kapena mwana wa mbawala","poem":1},{"text":"wothamanga mʼmapiri mʼmene mumamera mbewu zokometsera chakudya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}