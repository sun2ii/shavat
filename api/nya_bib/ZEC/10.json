{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ZEC","translationId":"nya_bib","name":"ZEKARIYA","commonName":"ZEKARIYA","title":"Zekariya","order":38,"numberOfChapters":14,"sha256":"51912fe7df01aa03a2a8b6005c14f394a64836375deaba6405ed73f4b568142d","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["Yehova Adzasamalira Yuda"]},{"type":"verse","number":1,"content":[{"text":"Pemphani mvula kwa Yehova pa nthawi yamphukira;","poem":1},{"text":"ndi Yehova amene amapanga mitambo ya mvula.","poem":2},{"text":"Iye amagwetsa mivumbi ya mvula kwa anthu,","poem":1},{"text":"ndi kumeretsa mbewu za mʼmunda kwa aliyense.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mafano amayankhula zachinyengo,","poem":1},{"text":"owombeza mawula amaona masomphenya abodza;","poem":2},{"text":"amafotokoza maloto onama,","poem":1},{"text":"amapereka chitonthozo chopandapake.","poem":2},{"text":"Choncho anthu amangoyendayenda ngati nkhosa zozunzika","poem":1},{"text":"chifukwa chosowa mʼbusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Ine ndawakwiyira kwambiri abusa,","poem":1},{"text":"ndipo ndidzalanga atsogoleri;","poem":2},{"text":"pakuti Yehova Wamphamvuzonse adzasamalira","poem":1},{"text":"nkhosa zake, nyumba ya Yuda,","poem":2},{"lineBreak":true},{"text":"ndi kuwasandutsa ngati akavalo aulemerero ankhondo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mu Yuda mudzachokera mwala wapangodya,","poem":1},{"text":"mudzachokera chikhomo cha tenti,","poem":2},{"lineBreak":true},{"text":"mudzachokera uta wankhondo,","poem":2},{"lineBreak":true},{"text":"mudzachokera mtsogoleri aliyense.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onse pamodzi adzakhala ngati ngwazi zankhondo","poem":1},{"text":"zoponda mʼmatope a mʼmisewu nthawi yankhondo.","poem":2},{"text":"Chifukwa Yehova adzakhala nawo,","poem":1},{"text":"adzachita nkhondo ndi kugonjetsa okwera pa akavalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ndidzalimbitsa nyumba ya Yuda","poem":1},{"text":"ndi kupulumutsa nyumba ya Yosefe.","poem":2},{"text":"Ndidzawabwezeretsa","poem":1},{"text":"chifukwa ndawamvera chisoni.","poem":2},{"text":"Adzakhala ngati kuti","poem":1},{"text":"sindinawakane,","poem":2},{"text":"chifukwa ndine Yehova Mulungu wawo","poem":1},{"text":"ndipo ndidzawayankha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aefereimu adzakhala ngati ankhondo amphamvu","poem":1},{"text":"adzasangalala ngati anthu amene amwa vinyo.","poem":2},{"text":"Ana awo adzaziona zimenezi ndipo adzasangalala;","poem":1},{"text":"mʼmitima mwawo adzakondwa mwa Ambuye.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndidzaliza mluzu","poem":1},{"text":"ndi kuwasonkhanitsa pamodzi.","poem":2},{"text":"Ndithu ndawawombola;","poem":1},{"text":"adzachulukana ngati poyamba paja.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndinawamwaza pakati pa mitundu ina ya anthu,","poem":1},{"text":"koma ku mayiko akutaliwo adzandikumbukira.","poem":2},{"text":"Iwo pamodzi ndi ana awo adzapulumuka,","poem":1},{"text":"ndipo adzabwerera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndidzawabweretsa kuchokera ku Igupto","poem":1},{"text":"ndipo ndidzawasonkhanitsa kuchokera ku Asiriya.","poem":2},{"text":"Ndidzawabwezera ku Giliyadi ndi ku Lebanoni,","poem":1},{"text":"mpaka malo woti nʼkukhalamo adzatheratu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Adzawoloka nyanja ya masautso;","poem":1},{"text":"nyanja yokokoma idzagonja","poem":2},{"lineBreak":true},{"text":"ndipo madzi onse a mu Nailo adzaphwa.","poem":2},{"text":"Kudzikuza kwa Asiriya kudzatha","poem":1},{"text":"ndipo ndodo yaufumu ya Igupto idzathyoka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndidzalimbitsa iwo mwa Yehova","poem":1},{"text":"ndipo adzayenda mʼdzina lake,”","poem":2},{"text":"akutero Yehova.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}