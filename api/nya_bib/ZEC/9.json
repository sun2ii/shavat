{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ZEC","translationId":"nya_bib","name":"ZEKARIYA","commonName":"ZEKARIYA","title":"Zekariya","order":38,"numberOfChapters":14,"sha256":"51912fe7df01aa03a2a8b6005c14f394a64836375deaba6405ed73f4b568142d","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nya_bib/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["Chiweruzo pa Adani a Israeli"]},{"type":"heading","content":["Ulosi"]},{"type":"verse","number":1,"content":[{"text":"Mawu a Yehova odzudzula dziko la Hadiraki","poem":1},{"text":"ndi mzinda wa Damasiko","poem":2},{"text":"pakuti maso a anthu ndiponso mafuko onse a Israeli","poem":1},{"text":"ali pa Yehova—","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ndiponso mzinda wa Hamati, umene ukuchita malire ndi dzikoli,","poem":1},{"text":"komanso pa Turo ndi Sidoni, ngakhale kuti iwo ndi anzeru kwambiri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndipo Turo anadzimangira linga;","poem":1},{"text":"wadziwunjikira siliva ngati fumbi,","poem":2},{"lineBreak":true},{"text":"ndi golide ngati zinyalala za mʼmisewu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taonani Ambuye adzamulanda chuma chakecho","poem":1},{"text":"ndi kuwononga mphamvu zake mʼnyanja,","poem":2},{"lineBreak":true},{"text":"ndipo adzapserera ndi moto.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mzinda wa Asikeloni udzaona zimenezi, nʼkuchita mantha;","poem":1},{"text":"Gaza adzanjenjemera ndi ululu,","poem":2},{"lineBreak":true},{"text":"chimodzimodzinso Ekroni, chifukwa chiyembekezo chake chidzatheratu.","poem":2},{"text":"Mfumu ya ku Gaza idzaphedwa","poem":1},{"text":"ndipo Asikeloni adzakhala opanda anthu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mu Asidodi mudzakhala mlendo,","poem":1},{"text":"ndipo ndidzathetsa kunyada kwa Afilisti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndidzachotsa nyama ya magazi mʼkamwa mwawo,","poem":1},{"text":"chakudya choletsedwa mʼmano mwawo.","poem":2},{"text":"Amene atsala adzakhala anthu a Mulungu wathu,","poem":1},{"text":"adzasanduka atsogoleri mu Yuda,","poem":2},{"lineBreak":true},{"text":"ndipo Ekroni adzakhala ngati Ayebusi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Koma Ine ndidzalondera Nyumba yanga","poem":1},{"text":"ndi kuyiteteza kwa ankhondo osakaza.","poem":2},{"text":"Palibenso mdani amene adzagonjetse anthu anga,","poem":1},{"text":"pakuti tsopano ndikuwayangʼanira.","poem":2}]},{"type":"heading","content":["Kubwera kwa Mfumu ya Ziyoni"]},{"type":"verse","number":9,"content":[{"text":"Sangalala kwambiri, iwe mwana wamkazi wa Ziyoni!","poem":1},{"text":"Fuwula, mwana wamkazi wa Yerusalemu!","poem":2},{"text":"Taona, mfumu yako ikubwera kwa iwe,","poem":1},{"text":"yolungama ndi yogonjetsa adani,","poem":2},{"lineBreak":true},{"text":"yodzichepetsa ndi yokwera pa bulu,","poem":2},{"lineBreak":true},{"text":"pa mwana wamphongo wa bulu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndidzachotsa magaleta ankhondo ku Efereimu","poem":1},{"text":"ndi akavalo ankhondo ku Yerusalemu,","poem":2},{"lineBreak":true},{"text":"ndipo uta wankhondo udzathyoka.","poem":2},{"text":"Mfumuyo idzabweretsa mtendere pakati pa mitundu ya anthu.","poem":1},{"text":"Ulamuliro wake udzayambira ku nyanja ina mpaka ku nyanja ina,","poem":2},{"lineBreak":true},{"text":"ndipo kuchokera ku Mtsinje (Yufurate) mpaka ku malekezero a dziko lapansi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsono kunena za iwe, chifukwa cha magazi a pangano lako ndi Ine,","poem":1},{"text":"ndidzamasula amʼndende ako, ndidzawatulutsa mʼdzenje lopanda madzi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bwererani ku malo anu otetezedwa, inu amʼndende achiyembekezo;","poem":1},{"text":"ngakhale tsopano ndikulengeza kuti ndidzakubwezerani zabwino mowirikiza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndidzakoka Yuda monga ndimakokera uta wanga,","poem":1},{"text":"ndipo Efereimu ndiye muvi wake.","poem":2},{"text":"Ndidzadzutsa ana ako iwe Ziyoni,","poem":1},{"text":"kulimbana ndi ana ako iwe Grisi,","poem":2},{"lineBreak":true},{"text":"ndipo ndidzakusandutsa iwe lupanga la munthu wankhondo.","poem":2}]},{"type":"heading","content":["Kuoneka kwa Yehova"]},{"type":"verse","number":14,"content":[{"text":"Pamenepo Yehova adzaonekera kwa anthu ake;","poem":1},{"text":"mivi yake idzangʼanima ngati chingʼaningʼani.","poem":2},{"text":"Ambuye Yehova adzaliza lipenga;","poem":1},{"text":"ndipo adzayenda mu mkuntho wochokera kummwera,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ndipo Yehova Wamphamvuzonse adzawateteza.","poem":2},{"text":"Iwo adzawononga","poem":1},{"text":"ndipo adzagonjetsa ndi miyala ya legeni.","poem":2},{"text":"Adzamwa magazi ndi kubangula ngati amwa vinyo;","poem":1},{"text":"magazi adzayenderera ngati a mʼmbale yowazira magazi","poem":2},{"lineBreak":true},{"text":"pa ngodya za guwa lansembe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tsiku limenelo Yehova Mulungu wawo adzawapulumutsa","poem":1},{"text":"pakuti anthu ake ali ngati nkhosa.","poem":2},{"text":"Adzanyezimira mʼdziko lake","poem":1},{"text":"ngati miyala yokongola pa chipewa chaufumu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taonani chikoka ndi kukongola kwawo!","poem":1},{"text":"Tirigu adzasangalatsa anyamata,","poem":2},{"lineBreak":true},{"text":"ndi vinyo watsopano anamwali.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}