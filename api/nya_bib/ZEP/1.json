{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ZEP","translationId":"nya_bib","name":"ZEFANIYA","commonName":"ZEFANIYA","title":"Zefaniya","order":36,"numberOfChapters":3,"sha256":"3a60bc4aeabd4674cdf345f94c3028f511f7cf022638cf3cbe438884d88e9708","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Yehova anayankhula ndi Zefaniya mwana wa Kusi, mwana wa Gedaliya, mwana wa Amariya, mwana wa Hezekiya pa nthawi ya Yosiya, mwana wa Amoni, mfumu ya Yuda."]},{"type":"heading","content":["Yehova Adzaweruza Dziko Lapansi"]},{"type":"verse","number":2,"content":[{"text":"“Ndidzawononga kotheratu zinthu zonse","poem":1},{"text":"pa dziko lapansi,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"“Ndidzawononga anthu pamodzi ndi nyama zomwe;","poem":1},{"text":"ndidzawononga mbalame zamlengalenga","poem":2},{"lineBreak":true},{"text":"ndi nsomba za mʼnyanja.","poem":2},{"text":"Ndidzawononga anthu oyipa,","poem":1},{"text":"ndipo ndidzafafaniza mtundu wa anthu pa dziko lonse lapansi,”","poem":2},{"text":"akutero Yehova.","poem":4}]},{"type":"heading","content":["Chenjezo kwa Yuda"]},{"type":"verse","number":4,"content":[{"text":"Ndidzatambasula dzanja langa pa Yuda","poem":1},{"text":"ndi onse okhala mu Yerusalemu.","poem":2},{"text":"Ndidzawononga pamalo pano otsalira opembedza Baala,","poem":1},{"text":"mayina a anthu osapembedza pamodzi ndi ansembe a mafano:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"amene amagwada pa madenga a nyumba zawo","poem":1},{"text":"kupembedza zolengedwa zamumlengalenga,","poem":2},{"text":"amene amagwada ndi kulumbira mʼdzina la Yehova,","poem":1},{"text":"komanso mʼdzina la Moleki,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"amene abwerera mʼmbuyo osatsata Yehova,","poem":1},{"text":"osafunafuna kapena kupempha nzeru kwa Yehova.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Khalani chete pamaso pa Ambuye Yehova,","poem":1},{"text":"chifukwa tsiku la Yehova layandikira.","poem":2},{"text":"Yehova wakonzekera kupereka nsembe;","poem":1},{"text":"wapatula iwo amene wawayitana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pa tsiku la nsembe ya Yehova","poem":1},{"text":"ndidzalanga akalonga","poem":2},{"lineBreak":true},{"text":"ndi ana aamuna a mfumu","poem":2},{"text":"ndi onse amene amavala","poem":1},{"text":"zovala zachilendo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pa tsiku limenelo ndidzalanga","poem":1},{"text":"onse amene safuna kuponda pa chiwundo,","poem":2},{"text":"amene amadzaza nyumba ya ambuye awo","poem":1},{"text":"ndi chiwawa ndi chinyengo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Pa tsiku limenelo,” akutero Yehova,","poem":1},{"text":"“Kufuwula kwakukulu kudzamveka pa Chipata cha Nsomba,","poem":2},{"lineBreak":true},{"text":"kulira kwa chisoni kuchokera mʼChigawo Chatsopano,","poem":2},{"lineBreak":true},{"text":"ndi phokoso la kugumuka kochokera ku mapiri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lirani mwachisoni, inu amene mumakhala kumene kuli msika;","poem":1},{"text":"a malonda anu onse adzapululidwa,","poem":2},{"lineBreak":true},{"text":"ndiponso onse amene ali ndi siliva adzawonongedwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pa nthawi imeneyo ndidzafufuzafufuza mu Yerusalemu ndi nyale","poem":1},{"text":"ndi kulanga onse amene sakulabadira,","poem":2},{"lineBreak":true},{"text":"amene ali ngati vinyo wosakhutchumulidwa,","poem":2},{"text":"amene amaganiza kuti, ‘Yehova sadzachita chilichonse,","poem":1},{"text":"chabwino kaya choyipa.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Chuma chawo chidzafunkhidwa,","poem":1},{"text":"nyumba zawo zidzagwetsedwa.","poem":2},{"text":"Adzamanga nyumba,","poem":1},{"text":"koma osakhalamo;","poem":2},{"text":"adzadzala minda ya mpesa","poem":1},{"text":"koma sadzamwako vinyo wake.”","poem":2}]},{"type":"heading","content":["Tsiku Lalikulu la Yehova"]},{"type":"verse","number":14,"content":[{"text":"Tsiku lalikulu la Yehova layandikira,","poem":1},{"text":"layandikira ndipo lifika msanga.","poem":2},{"text":"Tamverani! Kulira kwa pa tsiku la Yehova kudzakhala kowawa,","poem":1},{"text":"ngakhale munthu wolimba mtima adzalira kwambiri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tsiku limenelo lidzakhala la ukali,","poem":1},{"text":"tsiku losautsa ndi lomvetsa chisoni,","poem":2},{"text":"tsiku la mavuto ndi la chiwonongeko,","poem":1},{"text":"tsiku la mdima ndi lachisoni,","poem":2},{"lineBreak":true},{"text":"tsiku la mitambo ndi la mdima wandiweyani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tsiku loliza lipenga ndi la mfuwu wankhondo,","poem":1},{"text":"tsiku la kugwa kwa mizinda yotetezedwa","poem":2},{"lineBreak":true},{"text":"ndi nsanja za pa ngodya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndidzabweretsa msautso pa anthu","poem":1},{"text":"ndipo adzayenda ngati anthu osaona,","poem":2},{"lineBreak":true},{"text":"chifukwa achimwira Yehova,","poem":2},{"text":"magazi awo adzamwazika ngati fumbi","poem":1},{"text":"ndi mnofu wawo ngati ndowe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngakhale siliva wawo kapena golide wawo","poem":1},{"text":"sadzatha kuwapulumutsa","poem":2},{"lineBreak":true},{"text":"pa tsiku la ukali wa Yehova.","poem":2},{"text":"Dziko lonse lapansi lidzanyeka","poem":1},{"text":"mʼmoto wa nsanje yake","poem":2},{"text":"chifukwa adzakantha modzidzimutsa","poem":1},{"text":"onse okhala pa dziko lapansi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}