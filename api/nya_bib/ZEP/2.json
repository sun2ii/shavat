{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ZEP","translationId":"nya_bib","name":"ZEFANIYA","commonName":"ZEFANIYA","title":"Zefaniya","order":36,"numberOfChapters":3,"sha256":"3a60bc4aeabd4674cdf345f94c3028f511f7cf022638cf3cbe438884d88e9708","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Sonkhanani pamodzi, sonkhanani pamodzi,","poem":1},{"text":"inu mtundu wochititsa manyazi,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"isanafike nthawi yachiweruzo,","poem":1},{"text":"nthawi yanu isanawuluke ngati mungu,","poem":2},{"text":"usanakufikeni mkwiyo woopsa wa Yehova,","poem":1},{"text":"tsiku la ukali wa Yehova lisanafike pa inu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Funafunani Yehova, inu nonse odzichepetsa a mʼdziko,","poem":1},{"text":"inu amene mumachita zimene amakulamulani.","poem":2},{"text":"Funafunani chilungamo, funafunani kudzichepetsa;","poem":1},{"text":"mwina mudzatetezedwa","poem":2},{"lineBreak":true},{"text":"pa tsiku la mkwiyo wa Yehova.","poem":2}]},{"type":"heading","content":["Za Afilisti"]},{"type":"verse","number":4,"content":[{"text":"Gaza adzasiyidwa","poem":1},{"text":"ndipo Asikeloni adzasanduka bwinja.","poem":2},{"text":"Nthawi yamasana Asidodi adzakhala wopanda anthu","poem":1},{"text":"ndipo Ekroni adzazulidwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tsoka inu okhala mʼmbali mwa nyanja,","poem":1},{"text":"inu mtundu wa Akereti;","poem":2},{"text":"mawu a Yehova akutsutsa","poem":1},{"text":"iwe Kanaani, dziko la Afilisti.","poem":2},{"text":"“Ndidzakuwononga","poem":1},{"text":"ndipo palibe amene adzatsale.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dziko la mʼmbali mwa nyanja, kumene kumakhala Akereti,","poem":1},{"text":"lidzakhala malo a abusa ndi la makola a nkhosa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Malowa adzakhala a anthu otsala a nyumba ya Yuda;","poem":1},{"text":"adzapezako msipu.","poem":2},{"text":"Nthawi ya madzulo adzagona","poem":1},{"text":"mʼnyumba za Asikeloni.","poem":2},{"text":"Yehova Mulungu wawo adzawasamalira;","poem":1},{"text":"adzabwezeretsa mtendere wawo.","poem":2}]},{"type":"heading","content":["Za Mowabu ndi Amoni"]},{"type":"verse","number":8,"content":[{"text":"“Ndamva kunyoza kwa Mowabu","poem":1},{"text":"ndi chipongwe cha Amoni,","poem":2},{"text":"amene ananyoza anthu anga","poem":1},{"text":"ndi kuopseza kuti alanda dziko lawo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Choncho, pali Ine Wamoyo,”","poem":1},{"text":"akutero Yehova Wamphamvuzonse, Mulungu wa Israeli,","poem":2},{"text":"“Ndithu, Mowabu adzasanduka ngati Sodomu,","poem":1},{"text":"Amoni adzasanduka ngati Gomora;","poem":2},{"text":"malo a zomeramera ndi maenje a mchere,","poem":1},{"text":"dziko la bwinja mpaka muyaya.","poem":2},{"text":"Anthu anga otsala adzawafunkha;","poem":1},{"text":"opulumuka a mtundu wanga adzalandira dziko lawo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ichi ndi chimene adzalandire chifukwa cha kunyada kwawo,","poem":1},{"text":"chifukwa chonyoza ndi kuchitira chipongwe anthu a Yehova Wamphamvuzonse.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yehova adzawachititsa mantha kwambiri","poem":1},{"text":"pamene adzawononga milungu yonse ya mʼdzikomo.","poem":2},{"text":"Ndipo mitundu ya anthu pa dziko lonse idzamulambira,","poem":1},{"text":"uliwonse ku dziko la kwawo.","poem":2}]},{"type":"heading","content":["Za Kusi"]},{"type":"verse","number":12,"content":[{"text":"“Inunso anthu a ku Kusi,","poem":1},{"text":"mudzaphedwa ndi lupanga.”","poem":2}]},{"type":"heading","content":["Za Asiriya"]},{"type":"verse","number":13,"content":[{"text":"Yehova adzatambasulira dzanja lake kumpoto","poem":1},{"text":"ndi kuwononga Asiriya,","poem":2},{"text":"kusiya Ninive atawonongekeratu","poem":1},{"text":"ndi owuma ngati chipululu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nkhosa ndi ngʼombe zidzagona pansi kumeneko,","poem":1},{"text":"pamodzi ndi nyama zakuthengo za mtundu uliwonse.","poem":2},{"text":"Akadzidzi a mʼchipululu ndi akanungu","poem":1},{"text":"adzakhala pa nsanamira zake.","poem":2},{"text":"Kulira kwawo kudzamveka mʼmazenera,","poem":1},{"text":"mʼmakomo mwawo mudzakhala zinyalala zokhazokha,","poem":2},{"lineBreak":true},{"text":"nsanamira za mkungudza zidzakhala poonekera.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Umenewu ndiye mzinda wosasamala","poem":1},{"text":"umene kale unali wotetezedwa.","poem":2},{"text":"Unkanena kuti mu mtima mwake,","poem":1},{"text":"“Ine ndine, ndipo palibenso wina wondiposa.”","poem":2},{"text":"Taonani lero wasanduka bwinja,","poem":1},{"text":"kokhala nyama zakutchire!","poem":2},{"text":"Onse owudutsa akuwunyoza","poem":1},{"text":"ndi kupukusa mitu yawo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}