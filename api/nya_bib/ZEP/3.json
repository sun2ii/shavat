{"translation":{"id":"nya_bib","name":"Biblica® Tsekulani Mawu a Mulungu mu Chichewa Chalero","website":"https://ebible.org/Scriptures/details.php?id=nya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nya","licenseNotes":null,"shortName":"BIB","englishName":"Chichewa Bible","language":"nya","textDirection":"ltr","sha256":"3b251059c217917a08093cd13dbecedfd50e5ab6a47a4e69708e7a18b01b7c0a","availableFormats":["json"],"listOfBooksApiLink":"/api/nya_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Nyanja","languageEnglishName":"Nyanja"},"book":{"id":"ZEP","translationId":"nya_bib","name":"ZEFANIYA","commonName":"ZEFANIYA","title":"Zefaniya","order":36,"numberOfChapters":3,"sha256":"3a60bc4aeabd4674cdf345f94c3028f511f7cf022638cf3cbe438884d88e9708","firstChapterNumber":1,"firstChapterApiLink":"/api/nya_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nya_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Tsogolo la Yerusalemu"]},{"type":"verse","number":1,"content":[{"text":"Tsoka kwa mzinda wa anthu opondereza,","poem":1},{"text":"owukira ndi odetsedwa!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sumvera aliyense,","poem":1},{"text":"sulandira chidzudzulo.","poem":2},{"text":"Sumadalira Yehova,","poem":1},{"text":"suyandikira pafupi ndi Mulungu wake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akuluakulu ake ali ngati mikango yobuma,","poem":1},{"text":"olamulira ake ndi olusa ngati mimbulu ya nthawi ya madzulo,","poem":2},{"lineBreak":true},{"text":"zimene pofika mmawa sizisiya chilichonse.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aneneri ake ndi odzikuza;","poem":1},{"text":"anthu achinyengo.","poem":2},{"text":"Ansembe ake amadetsa malo opatulika","poem":1},{"text":"ndipo amaphwanya lamulo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yehova amene ali pakati pawo ndi wolungama;","poem":1},{"text":"Iye salakwa.","poem":2},{"text":"Tsiku ndi tsiku amaweruza molungama,","poem":1},{"text":"ndipo tsiku lililonse salephera,","poem":2},{"lineBreak":true},{"text":"komabe ochita zoyipa sachita manyazi nʼkomwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ndachotseratu mitundu ya anthu;","poem":1},{"text":"ndagwetsa malinga awo.","poem":2},{"text":"Ndipo sindinasiye ndi mmodzi yemwe mʼmisewu mwawo,","poem":1},{"text":"popanda aliyense wodutsa.","poem":2},{"text":"Mizinda yawo yawonongedwa;","poem":1},{"text":"palibe aliyense adzatsalemo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndinati,","poem":1},{"text":"‘Ndithudi, anthu a mu mzindawu adzandiopa","poem":2},{"lineBreak":true},{"text":"ndi kumvera kudzudzula kwanga!’","poem":2},{"text":"Ndipo sindidzawononga nyumba zawo,","poem":1},{"text":"kapena kuwalanganso.","poem":2},{"text":"Koma iwo anali okonzeka","poem":1},{"text":"kuchita mwachinyengo zinthu zonse zimene amachita.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Choncho mundidikire,” akutero Yehova,","poem":1},{"text":"“chifukwa cha tsiku limene ndidzaperekera umboni.","poem":2},{"text":"Ndatsimikiza kusonkhanitsa pamodzi mitundu ya anthu,","poem":1},{"text":"kusonkhanitsa maufumu","poem":2},{"text":"ndi kutsanulira ukali wanga pa iwo;","poem":1},{"text":"mkwiyo wanga wonse woopsa.","poem":2},{"text":"Dziko lonse lidzatenthedwa","poem":1},{"text":"ndi moto wa mkwiyo wa nsanje yanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Pamenepo ndidzayeretsa milomo ya anthu a mitundu yonse","poem":1},{"text":"kuti anthu onsewo ayitane dzina la Yehova","poem":2},{"lineBreak":true},{"text":"ndi kumutumikira Iye pamodzi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kuchokera kutsidya kwa mitsinje ya ku Kusi","poem":1},{"text":"anthu anga ondipembedza, omwazikana,","poem":2},{"lineBreak":true},{"text":"adzandibweretsera zopereka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsiku limenelo simudzachita manyazi","poem":1},{"text":"chifukwa cha zoyipa zonse munandichitira,","poem":2},{"text":"popeza ndidzachotsa onse mu mzinda uwu","poem":1},{"text":"amene amakondwera chifukwa cha kunyada kwawo.","poem":2},{"text":"Simudzakhalanso odzikuza","poem":1},{"text":"mʼphiri langa lopatulika.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Koma ndidzasiya pakati panu","poem":1},{"text":"anthu ofatsa ndi odzichepetsa,","poem":2},{"lineBreak":true},{"text":"amene amadalira dzina la Yehova.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aisraeli otsala sadzachitanso zolakwika;","poem":1},{"text":"sadzayankhulanso zonama,","poem":2},{"lineBreak":true},{"text":"ngakhale chinyengo sichidzatuluka mʼkamwa mwawo.","poem":2},{"text":"Adzadya ndi kugona","poem":1},{"text":"ndipo palibe amene adzawachititse mantha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Imba, iwe mwana wamkazi wa Ziyoni;","poem":1},{"text":"fuwula mokweza, iwe Israeli!","poem":2},{"text":"Sangalala ndi kukondwera ndi mtima wako wonse,","poem":1},{"text":"iwe mwana wamkazi wa Yerusalemu!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yehova wachotsa chilango chako,","poem":1},{"text":"wabweza mdani wako.","poem":2},{"text":"Yehova, Mfumu ya Israeli, ali pakati pako;","poem":1},{"text":"sudzaopanso chilichonse.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pa tsiku limenelo adzanena kwa Yerusalemu kuti,","poem":1},{"text":"“Usaope, iwe Ziyoni;","poem":2},{"lineBreak":true},{"text":"usafowoke.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yehova Mulungu wako ali pakati pako,","poem":1},{"text":"ali ndi mphamvu yopulumutsa.","poem":2},{"text":"Adzakondwera kwambiri mwa iwe,","poem":1},{"text":"adzakukhalitsa chete ndi chikondi chake,","poem":2},{"lineBreak":true},{"text":"adzayimba mokondwera chifukwa cha iwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Ndidzakuchotserani zowawa","poem":1},{"text":"za pa zikondwerero zoyikika;","poem":2},{"lineBreak":true},{"text":"nʼzolemetsa ndi zochititsa manyazi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taonani, nthawi imeneyo ndidzathana ndi","poem":1},{"text":"onse amene anakuponderezani;","poem":2},{"text":"ndidzapulumutsa olumala","poem":1},{"text":"ndi kusonkhanitsa amene anamwazika.","poem":2},{"text":"Ndidzawayamikira ndi kuwachitira ulemu","poem":1},{"text":"mʼdziko lililonse mmene anachititsidwa manyazi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Pa nthawi imeneyo ndidzakusonkhanitsani;","poem":1},{"text":"pa nthawi imeneyo ndidzakubweretsani ku mudzi kwanu.","poem":2},{"text":"Ndidzakuyamikirani ndi kukuchitirani ulemu","poem":1},{"text":"pakati pa mitundu ya anthu a dziko lapansi","poem":2},{"text":"pamene ndidzabwezeretsa mtendere wanu","poem":1},{"text":"inu mukuona,”","poem":2},{"text":"akutero Yehova.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/nya_bib/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nya_bib/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nya_bib/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}