ntent":[{"text":"Huri a Huqe, nge u garea lawuagi","poem":1},{"text":"me a nona vaigarea vin eno randu,","poem":2},{"text":"a nona garohuri vin eno duruhi","poem":1},{"text":"na babagi doluegi vin tuei.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/omb_pbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/omb_pbt/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/omb_pbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":5}