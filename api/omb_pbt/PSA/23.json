{"translation":{"id":"omb_pbt","name":"Waratau Siaga Tatuei mo Vilegi","website":"https://ebible.org/Scriptures/details.php?id=omb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=omb","licenseNotes":null,"shortName":"PBT","englishName":"Ambae, East: Waratau Siaga Tatuei mo Vilegi (Old Testament)","language":"omb","textDirection":"ltr","sha256":"7965289fcf221c01d84092f16e6be9085cb4d3a8c353bf40f0399fd402705c2b","availableFormats":["json"],"listOfBooksApiLink":"/api/omb_pbt/books.json","numberOfBooks":15,"totalNumberOfChapters":64,"totalNumberOfVerses":1226,"languageName":"East Ambae","languageEnglishName":"East Ambae"},"book":{"id":"PSA","translationId":"omb_pbt","name":"Ahi","commonName":"Ahi","title":"Ahi","order":19,"numberOfChapters":7,"sha256":"247a39e550f6171d63a82f925fe4ecd40d5d18d9af29d7ee2f5c3e00f8374ffa","firstChapterNumber":1,"firstChapterApiLink":"/api/omb_pbt/PSA/1.json","lastChapterNumber":100,"lastChapterApiLink":"/api/omb_pbt/PSA/100.json","totalNumberOfVerses":70},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Ahi noi Devet."]},{"type":"verse","number":1,"content":[{"text":"A Huqe nge a nongu leo goro garea,","poem":1},{"text":"neu nain he mahogi tea.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mo vai eu nam eno lolo ute lombu,","poem":1},{"text":"me mo tomuegi eu lo mwararai wai matamata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mo vurugegi na nongu mwasoana,","poem":1},{"text":"me mo tomuegi eu sulo turegi vovohoiana huri na henana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hate huri nain dige turu na dodo,","poem":1},{"text":"a waluwelui asiana nain matagu tea gena gineu esi,","poem":2},{"lineBreak":true},{"text":"huri nigo mei eu;","poem":2},{"lineBreak":true},{"text":"a nom ruqi mena gaitigo ngere a gai turegu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gom rarai na hinaga","poem":1},{"text":"lo nagoi nongu tavului vuro,","poem":2},{"text":"gom lai gogogi eu","poem":1},{"text":"me a nongu laha mo horo mwalinglingi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"A hogo liu, a nom gareana me nom vaigarea vin huri eu vataha","poem":1},{"text":"na rani nongu mwasoana","poem":2},{"text":"me neu nain toga lolo valei Huqe","poem":1},{"text":"vagituei.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/omb_pbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/omb_pbt/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/omb_pbt/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":6}