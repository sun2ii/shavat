varo","poem":1},{"lineBreak":true},{"text":"Aminantaapuva Nasoninra qova varuvaro","poem":1},{"lineBreak":true},{"text":"Nasoniva Saramoninra qova varuvaro","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Saramoniva Mpoasira qova varura.","poem":1},{"lineBreak":true},{"text":"Mpoasira mwia nrova Rehaapiva varura.","poem":1},{"lineBreak":true},{"text":"Mpoasiva Ompetira qova varura.","poem":1},{"lineBreak":true},{"text":"Ompetira mwia nrova Rutiva varura.","poem":1},{"lineBreak":true},{"text":"Ompetiva Iesira qova varuvaro","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Iesiva Ntevitira qova varura.","poem":1},{"lineBreak":true},{"text":"Ntevitiva nronraqama viro vunyaa vaisivanto varura.","poem":1},{"lineBreak":true},{"text":"Ntevitiva Soromoninra qova varura.","poem":1},{"lineBreak":true},{"text":"Soromoninra nrova tauraaqama kyero","poem":1},{"lineBreak":true},{"text":"Iuraiaara nraatavanto varura.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Soromoniva Riampoaminra qova varuvaro","poem":1},{"lineBreak":true},{"text":"Riampoamiva Apaisaara qova varuvaro","poem":1},{"lineBreak":true},{"text":"Apaisaava Esara qova varuvaro","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Esava Sihosapatira qova varuvaro","poem":1},{"lineBreak":true},{"text":"Sihosapativa Soraaminra qova varuvaro","poem":1},{"lineBreak":true},{"text":"Soraamiva Asaiaara qova varuvaro","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asaiaava Sotaaminra qova varuvaro","poem":1},{"lineBreak":true},{"text":"Sotaamiva Ehaasira qova varuvaro","poem":1},{"lineBreak":true},{"text":"Ehaasiva Hesekaiaara qova varuvaro","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hesekaiaava Manasaara qova varuvaro","poem":1},{"lineBreak":true},{"text":"Manasaava Emosira qova varuvaro","poem":1},{"lineBreak":true},{"text":"Emosiva Sosaiaara qova varuvaro","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sosaiaava Sekonaiaaravata mwia","poem":1},{"lineBreak":true},{"text":"qatanramwuvata sova varura.","poem":1},{"lineBreak":true},{"text":"Mwi entara mpo mwatanaahua","poem":1},{"lineBreak":true},{"text":"ekyaa Isareri rupa kyeta sitaqita","poem":1},{"lineBreak":true},{"text":"mwatukya mpo Papironini uro kyovaro","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sekonaiaava Siatierira qova varuvaro","poem":1},{"lineBreak":true},{"text":"Siatieriva Serapaperira qova varuvaro","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Serapaperiva Apaiaatira qova varuvaro","poem":1},{"lineBreak":true},{"text":"Apaiaativa Eraiaakiminra qova varuvaro","poem":1},{"lineBreak":true},{"text":"Eraiaakimiva Esora qova varuvaro","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Esova Setokira qova varuvaro","poem":1},{"lineBreak":true},{"text":"Setokiva Ekiminra qova varuvaro","poem":1},{"lineBreak":true},{"text":"Ekimiva Eraiaatira qova varuvaro","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eraiaativa Eriesaara qova varuvaro","poem":1},{"lineBreak":true},{"text":"Eriesaava Mataaninra qova varuvaro","poem":1},{"lineBreak":true},{"text":"Maataniva Iaikopura qova varuvaro","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Iaikopuva Iosepira qova varuvaro","poem":1},{"lineBreak":true},{"text":"Iosepiva Mariaara mwia vaativanto varura.","poem":1},{"lineBreak":true},{"text":"Mariaava Iesusira mwata tora.","poem":1},"(Tirenramwu Iesusirara Karaisirave, Mesaiaave, Kotiva titai vaisirave tunanra.)"]},{"type":"verse","number":17,"content":["Iesusi Karaisira kuaa okyara vahirero Evarahaamunraqaatairo Ntevitiraqaa mwia haivaqahua 14 nramwu mwi okyarahua varura. Ntevitiraqaatairo Papironini rupaqita uro kyo entaraqaa mwia haivaqahua 14 nramwu mwi okyarahua varura. Papironini rupaqita uro kyoraqaatairo Karaisiva qovara hu entaraqaa mwia haivaqahua 14 nramwu mwi okyarahua varura."]},{"type":"heading","content":["Iosepiva taqovaro Mariaava nraaqiara tuaqama vura"]},{"type":"verse","number":18,"content":["Iesusi Karaisira mwatato okyarava mwataamama vahiro. Mwia nronra Mariaara Iosepira qati titovaro hia mwikyantiri nrohu vakya Mariaava taqovaro Kotira mwanraquravanto mwia nraaqiara mwuvaro mwiva nraaqiara tuaqama vura."]},{"type":"verse","number":19,"content":["Mwiva nraaqiara tuaqama viro varuvaro mwia vaativanto Iosepiva kyuqe vaisi ntapihi kyero nrohi varu vaisiva variqarora tiro, mwiva tiqaro, Nte nraakye qora suqaa Mariaara titaariro kyauruankyorave. Kyai mwia uqeta kyena titaariro quarive, tiro."]},{"type":"verse","number":20,"content":["Iosepiva mwitaama riero vaitero ruvaata taqe varuvaro Kotiva tito vaisiva, nyaamwunyaava mpovanto qovarama viro tiqaro, Ntevitira mwaaquo, Iosepio, hia aatu hiqara Mariaara varaante. Kotira mwanraqura mwiva nraahu mwia nraaqiara mwiharo mwiva nraaqiara tuaqama viho."]},{"type":"verse","number":21,"content":["I nraatavanto qoraisi nraaqiara mwata tairara e mwia nrutu nteqarama Iesusirave qiante. Iesusiva nraakye qora kyaahaqama nyatero mwihua uaqia hi kyaiqara uti quara nruka nyatero mwihua huvantu kyaaninranra tira, e mwia nrutu nteqara Iesusirave qiante, tura."]},{"type":"verse","number":22,"content":["Haaru Kotiva nai poropeti vaisi nroqitairo timwa to quava qutaa vahiarive tiro, Kotiva tito vaisiva qovarama viro mwitaa tura. Haaru Kotira qua qovarama kye varuva, poropeti vaisivanto mwitaama tiro:"]},{"type":"verse","number":23,"content":["Nraakiara hia qoraisivatama kyero nrohiari nraakyeva nraaqiara tuaqama viro nraaqiara mwataananrove. Mwihua mwianra Imaanuerivave tivarave, tura. (Aisaiaa 7:14) Imaanuerira mwi nrutura okyara vahirero mwataamama vahiro: Kotiva tirivata varivave, tura."]},{"type":"verse","number":24,"content":["Iosepiva vaitoraqitairo siviro mwiva Kotiva tito vaisiva tu quara riero mwiva tunte hiro Mariaara uro varatero varurama."]},{"type":"verse","number":25,"content":["Mwiva hia Mariaaravata nrohuvaro Mariaava qati variqiro viro uro qoraisi nraaqiara mwata tovaro Iosepiva mwia nrutu nteqaro, Iesusivave, tura."]}],"footnotes":[]},"thisChapterLink":"/api/omw_sta/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/omw_sta/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}