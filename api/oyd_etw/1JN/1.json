"type":"verse","number":10,"content":["ኑኒ ናጋራ ኦችካያ ጋይኮ ጾዛ ዎርዶ ማህነ፤ ኤ ቃልታን ኑ ግዳ ባያ።"]}],"footnotes":[]},"thisChapterLink":"/api/oyd_etw/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/oyd_etw/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/oyd_etw/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}