{"translation":{"id":"oyd_etw","name":"ክለ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=oyde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=oyde","licenseNotes":null,"shortName":"ETW","englishName":"Oyde NT Ethiopic","language":"oyd","textDirection":"ltr","sha256":"2b29a0246bc20f453dd2138735da1486f423736261c759dbe4204276d201c62d","availableFormats":["json"],"listOfBooksApiLink":"/api/oyd_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Oyda","languageEnglishName":"Oyda"},"book":{"id":"1TI","translationId":"oyd_etw","name":"1 ጢሞትዮሳ","commonName":"1 ጢሞትዮሳ","title":"ጳዉሎሳ ጢሞትዮሳስ ጻፍደ ቲኖ ኪታ","order":54,"numberOfChapters":6,"sha256":"f4ab79032e6e6d552c8cd7a74d742150517a88ebf69239dc16babac3f6b6215e","firstChapterNumber":1,"firstChapterApiLink":"/api/oyd_etw/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/oyd_etw/1TI/6.json","totalNumberOfVerses":113},"chapter":{"number":3,"content":[{"type":"heading","content":["ዎሳ ኬ ጭሙንና"]},{"type":"verse","number":1,"content":["ኦንን፥ «ዎሳ ኬ ካልዘ አስ ማቃደስ ኮይኮ ሎኦ ባዝ አሙነ» ጋዘ ኦህታ ቱሮ።"]},{"type":"verse","number":2,"content":["ዎሳ ኬ ካልዘ አስ ቦርንቶሳያ፥ ፈቲ ማቻ ጻላላ የዛያ፥ ዎጋራ የዛያ፥ ፋና ናግዛያ፥ ቤዛን ፋና ኦችዛያ፥ ዛቆ ሞክዛያ፥ ታማርሶደስ ዳንዳእዛያ፥"]},{"type":"verse","number":3,"content":["ማንቶሳያ፥ ካጭንቶሳያ፥ ላሎሳያ፥ ብራ ይቅስንቶሳያ፥"]},{"type":"verse","number":4,"content":["ኤ ናኡን ኤስ ኪትንትዙንናን ቦንችዙንና፥ ፋ ኬቶ አሆደስ ዳንዳእዛያ ማቃደስ ቤዛነ።"]},{"type":"verse","number":5,"content":["ፈቲ አስ ፋ ኬቶ አሆደስ ዳንዳአንጽኮ፥ ጾዘ ዎሳ ኬቶ ዋይዝ አሆደስ ዳንዳኤ?"]},{"type":"verse","number":6,"content":["ኡቱራራ ኩሚ፥ ጻላሄ ጾዘ ፍርዳራ ጎልእደ ፋና ጎልአመ ፋና፥ አማኖር ሚንግካይዘ አስ ማቆደስ ቤዞስ።"]},{"type":"verse","number":7,"content":["ቦረራን ጻላሄ ጽኬ ገላመ ጋር የ አ አማኖሰ አስ ካለ ሎኦ ማርካት የሳደስ ቤዛነ።"]},{"type":"heading","content":["ዎሳ ኬ ዲያቆናቱንና"]},{"type":"verse","number":8,"content":["ይኒ ፋና ማህ ዎሳ ኬ ዳቆናቱን ቦንችንትዱንና፥ ላምእ ዶና ኦህንቶሱንና፥ ጋማ ማዘ ኡሽ ኡዦሱንና፥ ብራ ይቅስንቶሱንና፥"]},{"type":"verse","number":9,"content":["አማኖ ሳዛ ቆፋ ጌሽ ዎዝናራ ናግዙንና ማቃደስ ቤዛነ።"]},{"type":"verse","number":10,"content":["ኡን ቲኖ ፋታንንቶደስ ቤዛነ፤ ኡንታላ አፋ ቦረ ባይዛ ማቅኮ፥ ዎሳ ኬ ዳቆነ ማቂ ኦቾ።"]},{"type":"verse","number":11,"content":["ይኒ ፋናን፥ ኡን ማቹን ቦንችንትዱንና፥ ዝግሮሱንና፥ ዎጋራ የዙንና፥ ኡባ ባዛ አምንንትዱንና ማቃደስ ቤዛነ።"]},{"type":"verse","number":12,"content":["ዎሳ ኬ ዳቆናቱን ፈቲ ማቻ ጻላላ የዙንና ማቆ። ፋ ናኡንናን ፋ ኬቶ ሎይ አህዙንና ማቃደስ ቤዛነ።"]},{"type":"verse","number":13,"content":["ዎሳ ኬ ዳቆነ ማቂ፥ ሎኦ ኦቻ ኦችዙን፥ ኡንትስ ዳማ ቦንቾን ክርስቶሳ የሱሳ ግዳ የዘ አማኖ ባዝ ኦሆደስ ምንትሞ ደንጎዳ።"]},{"type":"heading","content":["ዳማ ሳዛ ቆፋ"]},{"type":"verse","number":14,"content":["ታኒ Ꮉና ኪቶ ኔስ ጻፍተራ፥ ኤልሲ ኔጎ Ꮉንጎዳ ጋእ ኡፋይስ ጋዳነ።"]},{"type":"verse","number":15,"content":["የዝን ታኒ Ꮉንጋንጽ ጋምእኮ፥ ጾዘ ኬ አሱን ዋይዝ የሳደስ ቤዝዛኮ ኤሮደ ፋና Ꮉኖ ኔስ ጻፍዳ። ደኦ ጾዘ ኬታ ቱረትስ ቱስን ባሳን።"]},{"type":"verse","number":16,"content":["ኑ አማንትስ ሳዛ ቆፍታ ሶኤ ባይ ዳማ።",{"text":"ክርስቶሳ አሾር ቆንጭዳ፤","poem":1},{"text":"ኤ ቱረትቶ ጌሽ አያና ማርክዳ።","poem":2},{"lineBreak":true},{"text":"ኪታንቹንስ በንትዳ፤","poem":2},{"lineBreak":true},{"text":"ኤ ካእቱምታ ዎርዣ ኡባስ ሳባክንትዳ።","poem":2},{"lineBreak":true},{"text":"አላመ የዘ አሱን አማንዳ፤","poem":2},{"lineBreak":true},{"text":"ቦንቾር ሳሎ ኤክንትዳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/oyd_etw/1TI/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/oyd_etw/1TI/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/oyd_etw/1TI/2.json","previousChapterAudioLinks":{},"numberOfVerses":16}