{"translation":{"id":"oyd_etw","name":"ክለ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=oyde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=oyde","licenseNotes":null,"shortName":"ETW","englishName":"Oyde NT Ethiopic","language":"oyd","textDirection":"ltr","sha256":"2b29a0246bc20f453dd2138735da1486f423736261c759dbe4204276d201c62d","availableFormats":["json"],"listOfBooksApiLink":"/api/oyd_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Oyda","languageEnglishName":"Oyda"},"book":{"id":"HEB","translationId":"oyd_etw","name":"ዕብራዌ","commonName":"ዕብራዌ","title":"ዕብራዌ አሱንስ ጻፍንትደ ኪታ","order":58,"numberOfChapters":13,"sha256":"1318ad2bd11f95e55b00724cc224646546d1efd5a74653f6968b1d0acb5cb9f5","firstChapterNumber":1,"firstChapterApiLink":"/api/oyd_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/oyd_etw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["ፈቲ ፈቲ ካህኑን Ꮉላቃ አሱን ግዳፓ ዶርንት፥ ጾዛራ የልዘ ባዛ አስ ግሾ እሞን ናጋራ ዣርሾ ዣርሾደስ ሹሙንታነ።"]},{"type":"verse","number":2,"content":["ኤ ፋ ኦምተ ላብ ማቅደ ግሾ ኤሮሱንስን ባልንትዱንስ ይቅስንቶደስ ዳንዳአነ።"]},{"type":"verse","number":3,"content":["ኤ ፋ ናጋራ ግሾን አስ ኡባ ናጋራ ግሾ ዣርሾ ዣርሾደስ ቤዛና ይንስ።"]},{"type":"verse","number":4,"content":["ኦደን Ꮉና ቦንችቶ ፋስ ኤኮደስ ዳንዳኦስ፥ የዝን አሮና ካህኑን Ꮉላቃ ማቃደስ ጼግንትዳን ፋና ጾዛራ ጼግንቶደስ ቤዛነ።"]},{"type":"verse","number":5,"content":["ይኒ ፋና፥ ክርስቶሳ ካህኑን Ꮉላቃ ማቅዘ ቦንችቶ ፋስ ኤክካያ። የዝን ጾዚ ኤዛ፥",{"text":"«ኔኒ ታ ናአ።","poem":1},{"text":"Ꮉይኖ ታ ኔስ አደ ማቅዳ»","poem":2},"ያጋይዳ።"]},{"type":"verse","number":6,"content":["ማህ መለ በሳ፥",{"text":"«መልከጻድቀ ካህነ ሹማ ማቅዳን ጋራ፥","poem":1},{"text":"ኔኒ መናስ ካህነ ማቃዳ»","poem":2},"ያጋይዳ።"]},{"type":"verse","number":7,"content":["የሱሳ አስ ማቂ Ꮉና አላምተ የዘ ዎደ ፋና Ꮉይቆፓ አሾደስ ዳንዳእዘ ጾዛ ጋማ ዬፎራን አፉራ ዎስዳ። ኤ፥ ጾዝ ቦንቺ ኪትንትደ ግሾ ጾዚ ኤ ዎስቶ ስእዳ።"]},{"type":"verse","number":8,"content":["የሱሳ ጾዘ ናአ ማቅኮን ኤክደ ማተ ኪትንተ ታማርዳ።"]},{"type":"verse","number":9,"content":["ይነን፥ የሱሳ ፋ ኦችቶ ፎልዳንፓ ሱባ ፋስ ኪትንትዘ ኡባ መዽና አቶት ደማደ ፋና ኦገ ማቅዳ።"]},{"type":"verse","number":10,"content":["ይናን ጾዚ መልከጻድቀ ሹማ ፋና ካህኑን Ꮉላቃ ማህ ኤዛ ሹምዳ።"]},{"type":"heading","content":["አማኖራ ላባመ ፋና እንግንትደ ናግዘ"]},{"type":"verse","number":11,"content":["Ꮉና ኑ ኦህትላ አፋ ጉጂ ኦሆደባዝ ጋማ ባዝ የነ፥ የዝን ይን ቆፍታ ኤራ ማቅደ ግሾ ይንትስ ኦህ ገልደስ ዋይነ።"]},{"type":"verse","number":12,"content":["ይን Ꮉኒ ዎደ አስታማረ ማቃደስ ቤዛነ፥ የዝን ጾዘ ቃላ ቲኖ ትምርተ ይንታና ማህ ታማርስዘ መለ አስ ኮሻነ። ይን ምን ካ ማደስ ዳንዳኦሰ ግሾ ማ ኮሻነ።"]},{"type":"verse","number":13,"content":["ማ ሽችንትዘ ኦደን ዦጋ ናአ ማቅደ ግሾ ሎኦን ኢታ ሻኪ ኤሮስ።"]},{"type":"verse","number":14,"content":["የዝን ምን ካ ኮሽዘ ሎኦን ኢታ ሻክዘ ኤራ የዘ ዎዝናማ አስስ።"]}],"footnotes":[]},"thisChapterLink":"/api/oyd_etw/HEB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/oyd_etw/HEB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/oyd_etw/HEB/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}