{"translation":{"id":"oyd_etw","name":"ክለ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=oyde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=oyde","licenseNotes":null,"shortName":"ETW","englishName":"Oyde NT Ethiopic","language":"oyd","textDirection":"ltr","sha256":"2b29a0246bc20f453dd2138735da1486f423736261c759dbe4204276d201c62d","availableFormats":["json"],"listOfBooksApiLink":"/api/oyd_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Oyda","languageEnglishName":"Oyda"},"book":{"id":"HEB","translationId":"oyd_etw","name":"ዕብራዌ","commonName":"ዕብራዌ","title":"ዕብራዌ አሱንስ ጻፍንትደ ኪታ","order":58,"numberOfChapters":13,"sha256":"1318ad2bd11f95e55b00724cc224646546d1efd5a74653f6968b1d0acb5cb9f5","firstChapterNumber":1,"firstChapterApiLink":"/api/oyd_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/oyd_etw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["የሱሳ ኑ ካህኑን Ꮉላቃ"]},{"type":"verse","number":1,"content":["ኑኒ ኦህዘ ዳማ ባዝታ Ꮉኖ። ሳሎ ኡባፓ ካታራ ጾዘ አራታፓ ምዛቅ ባጋራ በትደ Ꮉይ ፋና የዘ ካህኑን Ꮉላቃ ኑስ የነ።"]},{"type":"verse","number":2,"content":["ኤ አሳራ ማቅካይዝን ላራ ኤቅደ ቱሪ ዱንካንተ ጾዘ ኬ ኦቻነ።"]},{"type":"verse","number":3,"content":["ካህኑን Ꮉላቃ ኡባና እሞን ዣርሾ ዣርሾደስ ሹሙንታነ። ይኒ ግሾ ማህ፥ የ ካህንዘ ዣርሾደስ ፈትባዝ የሳደስ ኮሻነ።"]},{"type":"verse","number":4,"content":["ህገ ኪትዛንፋና ዣርሽዘ ካህኑን የዘ ግሾ ክርስቶሳ ሳአ የዘ ባዝ ማቅዛኮ ካህነ ማቆስ።"]},{"type":"verse","number":5,"content":["ኡን ካህነት ኦችዘ ዱንካንታ ሳሎ የዘስ አዝዘን ዳሾ። ሙሴ ዱንካነ ኤስዘ ዎደ ጾዚ ኤጎ፥ «ታኒ ነና ደረላ አፋ ቤዝደ አዝዘ ካሊ ኦቾ» ያጋይዳ።"]},{"type":"verse","number":6,"content":["የዝን የሱሳ እግንዘ ግዳ ማቅደ ጫቆ፥ ቲኖ ጫቆፓ አዛንፋና ኤ ኤክደ ኦችታ ኡንትስትፓ አነ። ይና ኤቅዳና አዘ ጫቆ ቃላራ።"]},{"type":"verse","number":7,"content":["ቲኖ ጫቅተ ባላ ባይዘ ባዝ ማቅዛኮ ላምእን ጫቆ ኮሾስ።"]},{"type":"verse","number":8,"content":["የዝን ላ ኡንታና ቦሪ፥ Ꮉንጋራ ያጋይዳ፦",{"text":"«ታኒ እስራኤለ አሱንራን ይሁዳ አሱንራ","poem":1},{"text":"ክለ ጫቆ ጫቂዘ ዎደ የኦዳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ይና ጫቅታ ታ ኡን አዱንና ግብጸ ሳአፓ ኩሽቶ አይክ፥","poem":1},{"text":"ጎች ኬስደ ዎደ ኡንታራ ጫቂደ ጫቅት ጋር ባያ።","poem":2},{"lineBreak":true},{"text":"ኡን ታ ጫቅተ አማንንትካይዘ ግሾ","poem":2},{"lineBreak":true},{"text":"ታኒ ኡንታና ኦሊ አሽዳ ያጋይዳ ላ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"የዝን ይኬፓ ሱባ እስራኤለ አሱንራ","poem":1},{"text":"ታ ጫቆደ ጫቅታ Ꮉኖ ያጋይዳ ላ።","poem":2},{"lineBreak":true},{"text":"ታኒ ታ ህግቶ ኡን ጉግተ ጋዶዳ፤","poem":2},{"lineBreak":true},{"text":"ኡን ዎዝንተ ጻፎዳ።","poem":2},{"lineBreak":true},{"text":"ታኒ ኡን ጾዚ ማቃዳ፤","poem":2},{"lineBreak":true},{"text":"ኡንትን ታ አስ ማቃዳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኡንታፓ ኦደን ፋ ዶዛ ዎይ ፋ እሻ፥","poem":1},{"text":"‹ላ ኤሮ› ያጋእ ታማርሶስ።","poem":2},{"text":"ኡን ኤራፓ ዳማ የሎደስ","poem":1},{"text":"ኡቡን ታና ኤሮዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታኒ ኡን ቆህዳኖ አቶ ጋዉዳ፤","poem":1},{"text":"ኡን ናጋርቶ ማህ ቆፖስ» ያጋይዳ።","poem":2}]},{"type":"verse","number":13,"content":["ጾዚ Ꮉይ ጫቅዛ «ክለ» ጋእ ጼግተራ ቲኖሳያ ጋልእዝዳ። ይኬ፥ ጋልእዘን ጭንግደ ብዘ ዎደ የልዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/oyd_etw/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/oyd_etw/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/oyd_etw/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}