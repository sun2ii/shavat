{"translation":{"id":"oyd_etw","name":"ክለ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=oyde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=oyde","licenseNotes":null,"shortName":"ETW","englishName":"Oyde NT Ethiopic","language":"oyd","textDirection":"ltr","sha256":"2b29a0246bc20f453dd2138735da1486f423736261c759dbe4204276d201c62d","availableFormats":["json"],"listOfBooksApiLink":"/api/oyd_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Oyda","languageEnglishName":"Oyda"},"book":{"id":"REV","translationId":"oyd_etw","name":"ዋሐንሳ ቆንጭ","commonName":"ዋሐንሳ ቆንጭ","title":"ዋሐንሳ ቆንጭ","order":66,"numberOfChapters":22,"sha256":"7a521fe1056d572203e7a10f95fc33302be85ba22cdcb74a705674b13d37b11d","firstChapterNumber":1,"firstChapterApiLink":"/api/oyd_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/oyd_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":15,"content":[{"type":"heading","content":["ዉርሱ Ꮉንቆ"]},{"type":"verse","number":1,"content":["ታኒ ሳሎ መለ ዳማን ጋማ ቆፍዘ ማላ ብእዳ። ጾዘ ዉርሱ Ꮉንቆ ቆንጭዘ ላፑን ቦሹንና አይክደ ላፑን ኪታንቹንና ብእዳ።"]},{"type":"verse","number":2,"content":["ማህ ታማራ ዎርቂንትደ ቡርጩቆ አባ አዝዛ ብእዳ። ይና አባ ጋጽተ ጾን፥ ኤ ምስልቶን ኤ ሱንት ፋይድቶ ጋምዱንና ብእዳ። ጾዚ ኡንትስ እንግደ ባጋና አይኪ ኤቅዳ።"]},{"type":"verse","number":3,"content":["ኡን ጾዘ አርዘ ሙሴ ማዝሙረን ዱርዘ ማዝሙረ Ꮉኒ ጋር ያጋእ የጺዳ።",{"text":"«ላ፥ ኡባፓ ዳማ ጾዛዮ፥","poem":1},{"text":"ነ ኦችታ ዳማን ጋማ ቆፍዘ ባዝ።","poem":2},{"lineBreak":true},{"text":"ዎርዣ ኡባ ካታዮ፥","poem":2},{"lineBreak":true},{"text":"ነ ኦግታ ጽሎን ቱሮ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጌሽ ነ ጻላላ ማቅደ ግሾ","poem":1},{"text":"ላ፥ ኔስ ዣሽቶሰን","poem":2},{"lineBreak":true},{"text":"ነ ሱንቶ ቦንቾሰ ኦደ?","poem":2},{"lineBreak":true},{"text":"ነ ጽሎ ኦችታ ቆንጭደ ግሾ","poem":2},{"lineBreak":true},{"text":"ካእቱሞ ኡባ ነ ቲኖ ይእ ጎይኖዳ»","poem":2},"ያጋእ የጻነ።"]},{"type":"verse","number":5,"content":["ይንፓ ሱባ፥ ሳሎ ቡጉንትን ጾዘ ኬ፥ ማርካት ዱንካነ ብእዳ።"]},{"type":"verse","number":6,"content":["ላፑን ቦሹንና አይክደ ላፑን ኪታንቹን ጾዘ ኬፓ ከዝዳ። ኡን ጌሽን ፎጭዘ ሊኖ ማኦ ማእዳ፤ ፋ ዳዳብተ ዎርቃ ሳቀ ዳንጭዳ።"]},{"type":"verse","number":7,"content":["ኦይዲ መቱንፓ ፈታይ፥ መናስ የዘ ጾዘ Ꮉንቆ ኩምደ ላፑን ዎርቃ ጹኡቶ ላፑን ኪታንቹንስ እንግዳ።"]},{"type":"verse","number":8,"content":["ጾዘ ቦንቾፓን ኤ ዎልቂትፓ ደንድዳነ ጾዘ ኬታ ጩጋራ ኩምዳ። ላፑን ኪታንቹን አይክደ ላፑን ቦቹን ፎልንቶደ ዎንስ ጾዘ ኬ ኦደን ገሎደስ ዳንዳእካያ።"]}],"footnotes":[]},"thisChapterLink":"/api/oyd_etw/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/oyd_etw/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/oyd_etw/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}