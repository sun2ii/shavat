{"translation":{"id":"oyd_etw","name":"ክለ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=oyde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=oyde","licenseNotes":null,"shortName":"ETW","englishName":"Oyde NT Ethiopic","language":"oyd","textDirection":"ltr","sha256":"2b29a0246bc20f453dd2138735da1486f423736261c759dbe4204276d201c62d","availableFormats":["json"],"listOfBooksApiLink":"/api/oyd_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Oyda","languageEnglishName":"Oyda"},"book":{"id":"REV","translationId":"oyd_etw","name":"ዋሐንሳ ቆንጭ","commonName":"ዋሐንሳ ቆንጭ","title":"ዋሐንሳ ቆንጭ","order":66,"numberOfChapters":22,"sha256":"7a521fe1056d572203e7a10f95fc33302be85ba22cdcb74a705674b13d37b11d","firstChapterNumber":1,"firstChapterApiLink":"/api/oyd_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/oyd_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":5,"content":[{"type":"heading","content":["ዱርዛን ጻጽንትደ ማጻፍዛ"]},{"type":"verse","number":1,"content":["ይንፓ ሱባ፥ አራትዘላ አፋ በትዳይ ምዛቅ ኩሸራ ጋንጨራን ካታራ ጻፍንትደ ላፑን ማታመራ ጎርዱንትደ ጻጽንትደ ማጻፈ ብእዳ።"]},{"type":"verse","number":2,"content":["ፈቲ ምን ኪታንችዘ ፋ ቃልቶ ቅ ዪዚ፥ «ማህታምዛ ብሎደስን ማጻፍዛ ቡጎደስ ዳንዳእዘ ኦደ?» ያጋእ አዋጆደራ ብእዳ።"]},{"type":"verse","number":3,"content":["የዝን ሳሎ ማቅን ሳአ ዎይ ሳአፓ ኦሞራ ማቅን የ ጻጽንትደ ማጻፍዛ ብሎደስን ጋንጭቶ በአደስ ዳንዳእዘ ኦደን በንትካያ።"]},{"type":"verse","number":4,"content":["ጻ ማጻፍዛ ብሎደስን ኤ ጋንጭቶ በአደስ ቤዝዘ አስ በንትካይዘ ግሾ ታ ጋማ ዬክዳ።"]},{"type":"verse","number":5,"content":["ዬዝን፥ ጭሙንፓ ፈታይ ታጎ፥ «ዬክፐ! ይኬ፥ ይሁዳ ባጋ ማቅደ ጋሞ፥ ዳዉተ ኮች፥ ላፑን ማህታምቶ ብሎደስን ማጻፍዛ ቡጎደስ ዳንዳአነ» ጋይዳ።"]},{"type":"verse","number":6,"content":["ይንፓ ሱባ፥ ሹክንትደ ዱርዛይ አራትዘላ፥ ኦይዲ ሸምፖራ የዘ መቱንስን ጭሙንስ ግዳ፥ ኤቅዳያ ብእዳ። ኤስ ላፑን ጉሙርን ላፑን አፉን የነ። የንስ አላመ ኡባስ ኪትንትደ ጾዘ ላፑን አያኑና።"]},{"type":"verse","number":7,"content":["የ ዱርዛይ Ꮉንግ፥ አራትዘላ አፋ በትዳይ ምዛቅ ኩሸፓ ጻጽንትደ ማጻፍዛ ኤክዳ።"]},{"type":"verse","number":8,"content":["ኤ የ ጻጽንትደ ማጻፍዛ ኤክደ ዎደ ኦይዲ ሸምፖራ የዘ መቱንስን ላምእታም ኦይዲ ጭሙን ዱርዘ ቲኖ ጎልእዳ። ኡን ፈተ ፈተ ዲን ጌሹን ዎሳ ማቅደ እጻነ ኩምደ ዎርቃ ሻተ አይክዳ።"]},{"type":"verse","number":9,"content":["ኡን፥",{"text":"«ጻጽንትደ ማጻፍዛ ኤኮደስ፥","poem":1},{"text":"ማህታምዛ ብሎደስ ኔስ ቤዛነ።","poem":2},{"text":"አኮስ ጋይኮ፥ ኔኒ ሹክንትዳ፤","poem":1},{"text":"ኮች ኡባፓ፥ ዱማ ዱማ ዶናፓ፥","poem":2},{"lineBreak":true},{"text":"ኮቹንፓ ካእቱሞ ኡባፓ","poem":2},{"lineBreak":true},{"text":"ነ ሱተ ጾዝስ ዎዝዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኡን ኑ ጾዘ አደስ ኦቾደ ፋና","poem":1},{"text":"ኡንታና ካህኑን ካእቱሞ ማህዳ።","poem":2},{"text":"ኡንትን ሳአ ኡባ ካእቶዳ»","poem":1},"ያጋእ ክለ ማዝሙረ የጽዳ።"]},{"type":"verse","number":11,"content":["ታ ብእደ ዎደ ሙኩል ቶሄ ሙኩልን ታጶ ሙኩል ቶሄ ታጶ ሙኩል ማቃደ ኪታንቹን ኦ ስእዳ። ኡንትን አራትዘስ፥ ኦይዲ ሸምፖራ የዘ መቱንን፥ ጭሙን ካንቶ ዉትዳ።"]},{"type":"verse","number":12,"content":["የን ኪታንቹን ቅ ጋይደ ቃላራ፥",{"text":"«ሹክንትደ ዱርዛይ ዎልቃ፥ ዱርቱሞ፥","poem":1},{"text":"ጭንጫትን ምንትሞ፥","poem":2},{"lineBreak":true},{"text":"ቦንቾ፥ ሳባን ጋላታ ኤኮደስ ቤዛነ»","poem":2},"ጋይዳ።"]},{"type":"verse","number":13,"content":["ይንፓ ሱባ፥ ሳአን፥ ሳሎ፥ ሳአፓ ኦሞራ አባ ግዳ የዘ መት ኡባ፥",{"text":"«አራትዘላ አፋ በትዳይስን ዱርዘስ፥","poem":1},{"text":"ጋላታ፥ ቦንቾ፥ ሳባን ዎልቃ","poem":2},{"text":"መ መናስ ማቀ»","poem":1},"ጋእ የጾደራ ስእዳ።"]},{"type":"verse","number":14,"content":["ኦይዲ ሸምፖራ የዘ መቱን፥ «አምንኤ» ያጋይዳ፤ ማህ ጭሙን ስኖራ ዙጊ ጎይንዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/oyd_etw/REV/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/oyd_etw/REV/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/oyd_etw/REV/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}