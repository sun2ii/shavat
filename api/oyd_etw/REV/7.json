{"translation":{"id":"oyd_etw","name":"ክለ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=oyde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=oyde","licenseNotes":null,"shortName":"ETW","englishName":"Oyde NT Ethiopic","language":"oyd","textDirection":"ltr","sha256":"2b29a0246bc20f453dd2138735da1486f423736261c759dbe4204276d201c62d","availableFormats":["json"],"listOfBooksApiLink":"/api/oyd_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Oyda","languageEnglishName":"Oyda"},"book":{"id":"REV","translationId":"oyd_etw","name":"ዋሐንሳ ቆንጭ","commonName":"ዋሐንሳ ቆንጭ","title":"ዋሐንሳ ቆንጭ","order":66,"numberOfChapters":22,"sha256":"7a521fe1056d572203e7a10f95fc33302be85ba22cdcb74a705674b13d37b11d","firstChapterNumber":1,"firstChapterApiLink":"/api/oyd_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/oyd_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["144,000 አሱንላ ማህታመ ጋድንትዳ"]},{"type":"verse","number":1,"content":["ይንፓ ሱባ፥ ኦይዲ ኪታንቹን ኦይዲ ሳአ ጋጻ ኤቅዱንና ብእዳ። የን ኪታንቹን ሳአላ ዎይ አባላ ዎይ ምንጻላ አፋ አኮን ባቆ ኦይዲ ሳአ ጋጻፓ ባቃመ ጋር ተቂዳ።"]},{"type":"verse","number":2,"content":["ማህ ደኦ ጾዘ ማህታመ አይክደ መለ ኪታንቾ አዋ ኬስ ዛላፓ ኬዛያ ብእዳ። የ ኪታንችዘ ፋ ቃልቶ ቅ ዪዚ፥ ሳአን አባ ቆሆደስ ዎልቃ እንግንትደ ኦይዲ ኪታንቹንና፥"]},{"type":"verse","number":3,"content":["ጼጊ፥ «ኑኒ ጾዘ አሩን ስኖላ ማታመ ጋዶደ ዎንስ ሳአ ዎይ አባ ዎይ ምንጻ ቆህፐተ» ጋይዳ።"]},{"type":"verse","number":4,"content":["ታኒ ጾዘ ማህታመ ስኖላ ጋድዱን ፋይድቶ ስእዳ። እስራኤለ ኮች ኡባፕ ጼት ኦይታም ኦይዲ ሙኩል አሱንስ ስንተ ማህታመ ጋድዳ።"]},{"type":"verse","number":5,"content":[{"text":"ይሁዳ ኮቻፓ ታጶ ላምእ ሙኩል፥","poem":1},{"lineBreak":true},{"text":"ሮበላ ኮቻፓ ታጶ ላምእ ሙኩል፥","poem":1},{"lineBreak":true},{"text":"ጋደ ኮቻፓ ታጶ ላምእ ሙኩል፥","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"አሴረ ኮቻፓ ታጶ ላምእ ሙኩል፥","poem":1},{"lineBreak":true},{"text":"ንፍታለመ ኮቻፓ ታጶ ላምእ ሙኩል፥","poem":1},{"lineBreak":true},{"text":"ምናሰ ኮቻፓ ታጶ ላምእ ሙኩል፥","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ስሞና ኮቻፓ ታጶ ላምእ ሙኩል፤","poem":1},{"lineBreak":true},{"text":"ሌወ ኮቻፓ ታጶ ላምእ ሙኩል፥","poem":1},{"lineBreak":true},{"text":"ይሳኮረ ኮቻፓ ታጶ ላምእ ሙኩል፥","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ዛብሎነ ኮቻፓ ታጶ ላምእ ሙኩል፥","poem":1},{"lineBreak":true},{"text":"ዮሰፋ ኮቻፓ ታጶ ላምእ ሙኩል፥","poem":1},{"lineBreak":true},{"text":"ብንያመ ኮቻፓ ታጶ ላምእ ሙኩል፥","poem":1},"አሱን ስንተ ማህታመ ጋድዳ።"]},{"type":"heading","content":["ቦ ማኦ ማእደ ጋማ አሱንና"]},{"type":"verse","number":9,"content":["ይንፓ ሱባ፥ ኮች ኡባፓ፥ ካእቱሞ ኡባፓ፥ ዎርዣ ኡባፓን ዱማ ዱማ ዶናፓ ፋይዶ ባይዘ ጋማ አሱንና ብእዳ። የን አሱን ቦ ጳርጎ ማኦ ማእ፥ ቂለ Ꮉየ ፋ ኩሽተ አይኪ፥ አራትዘ ቲኖን ዱርዘ ቲኖ ኤቅዳ።"]},{"type":"verse","number":10,"content":["ኡን ፋ ቃልቶ ቅ ዪዚ፥ «አቶት አራታላ በትደ ኑ ጾዘፓን ዱርዘፓ የእነ» ጋይዳ።"]},{"type":"verse","number":11,"content":["ኪታንቹን ኡባ፥ አራትዘን፥ ጭሙንን ኦይዲ መቱን ካንቶ ዉቲ ኤቅዳ። ኡን አራትዘ ቲኖ ዙጊ ጾዝ ጎይንዳ።"]},{"type":"verse","number":12,"content":[{"text":"«አምንኤ!","poem":1},{"text":"አንጆ፥ ቦንቾ፥ ጭንጫት፥ ጋላታ፥ ሳባ","poem":2},{"lineBreak":true},{"text":"ዎልቃን፥ ምንትሞ መ መናስ","poem":2},{"lineBreak":true},{"text":"ኑ ጾዘስ ማቀ።","poem":2},{"lineBreak":true},{"text":"አምንኤ!»","poem":2},"ጋይዳ።"]},{"type":"verse","number":13,"content":["ጭሙንፓ ፈታይ ታጎ፥ «Ꮉና ቦ ማእቶ ማእደ አሱን ኡን ኦደ የሳ? ኡን አባፓ ይእዶ?» ጋእ ኦጭዳ።"]},{"type":"verse","number":14,"content":["ታኒ ማህ፥ «ላ፥ ነ ኤራነ» ጋይዳ። ኤዝን ታጎ፥ «Ꮉንስ ጋማ ዋየ ዋይ አዱንና። ኡን ፋ ማእቶ ዱርዘ ሱተ ሜጪ ቦዳ።"]},{"type":"verse","number":15,"content":["ይኒ ግሾ፥",{"text":"«ኡን ጾዘ አራትዘ ቲንተ","poem":1},{"text":"ቃማን አዋራ ኤ ኬተ ኦቻነ።","poem":2},{"lineBreak":true},{"text":"ማህ አራታላ በትደ ኡንትስ ዱንካነ ማቃዳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ይኬፓ ሱባ፥ ኡን ናይአማ፥ ባርማ።","poem":1},{"text":"አዋ ዎይ ምቻ ኡንታና ደንጋማ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አራትዘላ በትደ ዱርዘ ኡንትስ ዉደ አዳያ ማቃዳ።","poem":1},{"text":"ደኦ Ꮉ ኣፈጎ ኡንታና ካልዳ።","poem":2},{"lineBreak":true},{"text":"ጾዚ ኡን ኣፍትፓ አፉቶ ኡባ ኡጮዳ»","poem":2},"ጋይዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/oyd_etw/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/oyd_etw/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/oyd_etw/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}