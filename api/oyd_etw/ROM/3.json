{"translation":{"id":"oyd_etw","name":"ክለ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=oyde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=oyde","licenseNotes":null,"shortName":"ETW","englishName":"Oyde NT Ethiopic","language":"oyd","textDirection":"ltr","sha256":"2b29a0246bc20f453dd2138735da1486f423736261c759dbe4204276d201c62d","availableFormats":["json"],"listOfBooksApiLink":"/api/oyd_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Oyda","languageEnglishName":"Oyda"},"book":{"id":"ROM","translationId":"oyd_etw","name":"ሮመ","commonName":"ሮመ","title":"ጳዉሎሳ ሮመ አሱንስ ጻፍደ ኪታ","order":45,"numberOfChapters":16,"sha256":"968670b7817050870fe1581e9f3be2baef2b2bcc40cf4308a88e47c323cc5885","firstChapterNumber":1,"firstChapterApiLink":"/api/oyd_etw/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/oyd_etw/ROM/16.json","totalNumberOfVerses":433},"chapter":{"number":3,"content":[{"type":"heading","content":["አይሁዱን አማናንጺ እጸ"]},{"type":"verse","number":1,"content":["ዬዝን፥ አይሁደ ማቅዛና አኮ ማደ? ዎይ ጋራዝንተስ አኮ ማድዘ ባዝ የዘ?"]},{"type":"verse","number":2,"content":["ኡባፓ ቲኖ ጾዚ ፋ ቃላ Ꮉዳርቶ አይሁዱንስ እንግዳ።"]},{"type":"verse","number":3,"content":["ዬዝን፥ ኡንታፓ ፈታይ ፈታያ ቃላ አማናንጺ እጽኮ፥ ኡን እጽዛና ጾዚ አማንንትደ ጾዝ ማቅዛኖ ካያነነ?"]},{"type":"verse","number":4,"content":["ካዮስ! አስ ኡባ ዎርዶ ማቅኮን ጾዚ ቱሮ ማቀ። ጌሽ ማጻፍተ፥",{"text":"«ነ ቃልተ ነ ጽላነ፤","poem":1},{"text":"ነና ሞትዛያ ፍርዳራ ላነ»","poem":2},"ጋእንት ጻፍንትዳ።"]},{"type":"verse","number":5,"content":["ዬዝን፥ ኑ ናጋርታ ጾዘ ጽሎ ማቅዛኖ ቤዝዘ ባዝ ማቅኮን፥ ኑ ዋጋዉደ? ጾዚ ኑ ናጋርት ግሾ ኑላ አፋ ፍርድኮ፥ ልከ ባነ? ይኖ ታኒ አስ ቆፋ ፋና ጋነ።"]},{"type":"verse","number":6,"content":["ይኒ ፋና Ꮉንፐተ። ይኒ ጋር Ꮉንኮ፥ ጾዚ Ꮉና አላምትላ አፋ ዋይዝ ፍርዶደ?"]},{"type":"verse","number":7,"content":["የዝን ታ ዎርዶትታ ጾዘ ቱርቶ ቆንጭዝ፥ ኤ ቦንችቶ ጋን ቤዘባዝ ማቅኮ፥ ዬዝን፥ አኮስ ታላ ፋና ናጋራንቾ ፋና ፍርደ?"]},{"type":"verse","number":8,"content":["ፈቲ ፈቲ አሱን፥ «ሎኦ ዮኦደ ፋና ኢታ ኦቾዳ?» ያጋእ ታማርስዘ አስ ፋና ማህ ታና ሞታነ። ይኒ ግሾ ያጋዘ አሳላ አፋ የእዘ ጾዘ ፍርድታ ልከ።"]},{"type":"heading","content":["አስ ኡባ ናጋራንቾ"]},{"type":"verse","number":9,"content":["ዬዝን፥ ኑ ዋጋዉደ? ኑ አይሁዱን፥ ግርኬፓ አነነ? አደ! አይሁደ ማቅን፥ አይሁደ ማቃንጽን ኡቡን ናጋራንቾ ማቅዛኖ ታኒ ቲኒ ይንትስ ኦህዳ።"]},{"type":"verse","number":10,"content":["ጌሽ ማጻፍተ፥",{"text":"«ጽሎ አስ ፈቶን ባያ።","poem":1}]},{"type":"verse","number":11,"content":[{"text":"አካክዘ አስ ባያ፥","poem":2},{"lineBreak":true},{"text":"ጾዛ ኮይዘ ኦንን ባያ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አስ ኡባ ባልንትዳ፤","poem":1},{"text":"ኡቡን ፈትፓ ማዶሰ ባዝ ማቅዳ።","poem":2},{"lineBreak":true},{"text":"ሎኦ ኦችዘ ኦንን ባያ፤","poem":2},{"lineBreak":true},{"text":"ፈቲ አስን ባያ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኡን ዶንታ፥","poem":1},{"text":"ቡጉንትደ ቦዛ ፋና፤","poem":2},{"lineBreak":true},{"text":"ፋ እልአንተ ዎርድነ።","poem":2},{"lineBreak":true},{"text":"ኡን ዶንትፓ አስ ዎዘ፥","poem":2},{"lineBreak":true},{"text":"ሾሽ ማርዘ ከዛነ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኡን ዶንተ ጫሞን ባድ ኩምዳ።","poem":1}]},{"type":"verse","number":15,"content":[{"text":"ኡን ቶህታ ሱ ላሎደስ ኤልሳነ።","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ኡን ኦግተ በን ቆሄ የነ።","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ኡን ሳሮ ኦገ ኤሮስ።","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ፋ ደእተ ጾዝስ ዣሽቶስ»","poem":2},"ጋእንት ጻፍንትዳ።"]},{"type":"verse","number":19,"content":["አስ ኡባ ዶና ጎርድንቶደ ፋና ኩሙ አላምቶ ጾዘ ፍርዳፓ ኦሞራ ሺሾደስ፥ ህገ እንግንትደ ህገፓ ኦሞራ የዙንስ ማቅዳኖ ኑ ኤራነ።"]},{"type":"verse","number":20,"content":["ይኒ ግሾ፥ ኦደን ህገስ ኪትንቲ ጾዘ ቲኖ ጽሎደስ ዳንዳኦስ። ህገ አስ ኡባ ናጋራንቾ ማቅዛኖ ቤዛነ።"]},{"type":"heading","content":["ጽሎት አማኖራ"]},{"type":"verse","number":21,"content":["የዝን Ꮉተ ጾዚ አስ ጽልዘ ኦገ ህገ ባይ ቆንጭዝዳ። ይና ኦግቶ ሙሴ ህገን ናቡንን ማርክዳ።"]},{"type":"verse","number":22,"content":["ይና አማንዘ ኡባስ Ꮉንዳ፥ ጾዚ የሱስ ክርስቶሳ ባጋራ አስ ኡባስ ሻኮ ባይ እንግዳ።"]},{"type":"verse","number":23,"content":["አስ ኡባ ናጋራ ኦችዳ፤ ጾዘ ቦንቾ ፋጭዝዳ።"]},{"type":"verse","number":24,"content":["የዝን ኡን ጾዘ አ ኬሃትራ፥ አሽዘ ክርስቶሳ የሱሳ ባጋራ ጨር ጽልዳ።"]},{"type":"verse","number":25,"content":["ጾዚ የሱስ ክርስቶሳ ዣርሾ ማህ እንግዳ፥ ኤዛ አማንዘ ኡባ ኤ ሱተ ናጋራ አቶት ደንጎደ ፋና። ጾዚ ይኖ ኦችደ ፋ ዳንዳአራ ዛጋ ናጋርቶ ፋይድካይዛራ አሺ፥ ፋ ጽሎትቶ ቤሳደስ።"]},{"type":"verse","number":26,"content":["የሱሳ አማንዘ ኡባ ጽሎደ ፋና Ꮉተ ዎደ ጾዘ ፋ ኦምተ ጽሎ ማቅዛኖ ቤሳደስ።"]},{"type":"verse","number":27,"content":["ዬዝን፥ ኑ ጬቅንትዘ ባዝ አኮ የዘ? አኮን ባያ። ኑኒ ጬቅንትዛና ህገስ ኪትንትዘ ግሾነ? አደ! አማኖ ህገራ።"]},{"type":"verse","number":28,"content":["ጾዚ አስ ጽልዘ አማኖራፕ አትን ህገስ ኪትንተራ ባይዛኖ ኑ ቆፓነ።"]},{"type":"verse","number":29,"content":["ዎይ ጾዚ አይሁዱን ጻላላ ጾዞነ? አይሁደ ማቆሱንስን ጾዚ ባነ? ቱሮ፥ አይሁደ ማቆሱንስን ኤ ጾዚ።"]},{"type":"verse","number":30,"content":["ጾዚ ፈቶ፤ አይሁዱንናን አይሁደ ማቆሱንና አማኖራ ጽልዘ ኤዛ።"]},{"type":"verse","number":31,"content":["ዬዝን፥ ኑኒ ህገ አማኖ ግሾ ብሶዳነ? አደ! ህግቶ ምንነፕ አትን።"]}],"footnotes":[]},"thisChapterLink":"/api/oyd_etw/ROM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/oyd_etw/ROM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/oyd_etw/ROM/2.json","previousChapterAudioLinks":{},"numberOfVerses":31}