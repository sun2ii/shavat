{"translation":{"id":"oyd_ltw","name":"Kille Caaqo","website":"https://ebible.org/Scriptures/details.php?id=oydl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=oydl","licenseNotes":null,"shortName":"LTW","englishName":"Oyda NT Latin","language":"oyd","textDirection":"ltr","sha256":"b3c27f0faac10e2d158570b98c72511c725a5cfe2c4146b82e31bdc91f7c9981","availableFormats":["json"],"listOfBooksApiLink":"/api/oyd_ltw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Oyda","languageEnglishName":"Oyda"},"book":{"id":"HEB","translationId":"oyd_ltw","name":"Ibraawe","commonName":"Ibraawe","title":"Ibraawe Asuntsis Xaafinttide Kiita","order":58,"numberOfChapters":13,"sha256":"c1b785a85ef6467bb44c9e6702a9ff5e04ddc62f842ee72bae37ac8fa75d6870","firstChapterNumber":1,"firstChapterApiLink":"/api/oyd_ltw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/oyd_ltw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Na7ay kiitanchchuntsappa kattara"]},{"type":"verse","number":1,"content":["Zaga Xoozii, nu aduntsis nabunts baggara dumma dumma ogera gaama wode ohida."]},{"type":"verse","number":2,"content":["Yezin hyanna wurssutsi wodite ubbanno eza laatizide mahi alamito E baggara medhdhide fa Na7ay baggara nuus ohida."]},{"type":"verse","number":3,"content":["Na7ay Xoozze bonchcho foo7izen kumutsi Xoozze Xoozzetitsito ekkii, fa wolqqa qaalara hyanna alamito katii aykkida. Asuntsana un nagarappa geeshidannippa suuba Ubbappa kattara Xoozze mizaqi zalara salo bettida."]},{"type":"verse","number":4,"content":["Ees ingginttide suntsita kiitanchchuntsi suntsappa kattara maaqqidanni fana E unttappa kattara."]},{"type":"verse","number":5,"content":["Yikke, Xoozii kiitanchchuntsappa oodego,",{"text":"«Neenii ta Na7a;","poem":1},{"text":"ta hyayno nees ade maaqqida» gaydo?","poem":2},"Woy mahi oodego,",{"text":"«Taanii ees ade maaqqada;","poem":1},{"text":"ezin taas na7a maaqqada» gaydo?","poem":2}]},{"type":"verse","number":6,"content":["Mahi Xoozii fa anggis Na7aya hyanna alamite kiittitera,",{"text":"«Xoozze kiitanchchuntsi ubba ees goyno»","poem":1},"yagayda."]},{"type":"verse","number":7,"content":["Xoozii kiitanchchuntsi baz ohitera,",{"text":"«Xoozii fa Kiitanchchuntsana ayyaana,","poem":1},{"text":"fa aruntsana tama loxe mahine»","poem":2},"yagayda."]},{"type":"verse","number":8,"content":["Yezin fa Na7ay baz ohitera,",{"text":"«Xoozzayo, ne ka7itumtta medhinas yene.","poem":1},{"text":"Ne ka7itumtto ne xillotitsara aho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neenii xillotitsi kadhida; iita ixxida.","poem":1},{"text":"Xoozii, ne Laatstse, nena ne lagguntsappa aatsii doorida,","poem":2},{"lineBreak":true},{"text":"ufays zayte","poem":2},{"noteId":0},{"text":"nena tizhida»","poem":2},"yagayda."]},{"type":"verse","number":10,"content":["Xoozii mahi,",{"text":"«Laatstsayo, tiino neenii sa7a medhdhida;","poem":1},{"text":"saluntsi ne kushe oocha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yentses ubba dhaboda;","poem":1},{"text":"yezin ne yessada.","poem":2},{"lineBreak":true},{"text":"Un ubba afula fana hyal7oda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne magaraja fana xaaxoda;","poem":1},{"text":"mahi un afula fana cinggoda.","poem":2},{"text":"Yezin neenii ubba wode nena;","poem":1},{"text":"ne beritan hyal7oos»","poem":2},"yagayda."]},{"type":"verse","number":13,"content":["Yezin Xoozii kiitanchchuntsappa oodego,",{"text":"«Taanii ne morkkuntsana ne tohita","poem":1},{"text":"yedhdhize bessi mahode wontsis,","poem":2},{"text":"hyanne taappa mizaqi zalara betto» gaydo?","poem":1}]},{"type":"verse","number":14,"content":["Kiitanchchuntsi ubba atotitsi denggodes yeze asuntsana maaddodes Xoozii kiittide ayyaanuntsana baane?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ufays zayte: E ka7itize wode asuntsi ufayssara loytsi eza ka7itisizanno beezane.","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/oyd_ltw/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/oyd_ltw/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/oyd_ltw/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}