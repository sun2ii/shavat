{"translation":{"id":"oyd_ltw","name":"Kille Caaqo","website":"https://ebible.org/Scriptures/details.php?id=oydl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=oydl","licenseNotes":null,"shortName":"LTW","englishName":"Oyda NT Latin","language":"oyd","textDirection":"ltr","sha256":"b3c27f0faac10e2d158570b98c72511c725a5cfe2c4146b82e31bdc91f7c9981","availableFormats":["json"],"listOfBooksApiLink":"/api/oyd_ltw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Oyda","languageEnglishName":"Oyda"},"book":{"id":"MAT","translationId":"oyd_ltw","name":"Maatoosa","commonName":"Maatoosa","title":"Maatoosa Xaafide Yesuus Kiristtoosa Wonggele","order":40,"numberOfChapters":28,"sha256":"976217637a98fe361438cf0fcef960adfde9b01d2fe1546e0fe2266b35d258fb","firstChapterNumber":1,"firstChapterApiLink":"/api/oyd_ltw/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/oyd_ltw/MAT/28.json","totalNumberOfVerses":1068},"chapter":{"number":1,"content":[{"type":"heading","content":["Yesuusa yelintte xussii"]},{"type":"verse","number":1,"content":["Yinnippa kaallii xaafinttide Dawute na7a Abrahama na7a maaqqide Yesuus Kiristtoosa yelintto."]},{"type":"verse","number":2,"content":["Abrahama Yisaaqa yelida;",{"text":"Yisaaqa Yayqooba yelida;","poem":1},{"lineBreak":true},{"text":"Yayqooba Yihudan E ishuntsana yelida;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yihuda Ti7imarippa Faaresenen Zaaran yelida;","poem":1},{"lineBreak":true},{"text":"Faaresa Asroome yelida;","poem":1},{"lineBreak":true},{"text":"Asroome Raame yelida;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Raame Aminaadabe yelida;","poem":1},{"lineBreak":true},{"text":"Aminaadabe Na7asoona yelida;","poem":1},{"lineBreak":true},{"text":"Na7asoona Salmoone yelida;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salmoone Re7aabippa Boo7eza yelida;","poem":1},{"lineBreak":true},{"text":"Boo7eza Uruutippa Iyobeede yelida;","poem":1},{"lineBreak":true},{"text":"Iyobeede Issey yelida;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Isseyen kaati Dawute yelida;","poem":1},{"lineBreak":true},{"text":"Dawute Ooriyo machchitippa Solomone yelida;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Solomone Robi7aama yelida;","poem":1},{"lineBreak":true},{"text":"Robi7aama Abiya yelida;","poem":1},{"lineBreak":true},{"text":"Abiye Asaafa yelida;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asaappa Iyosaafixe yelida;","poem":1},{"lineBreak":true},{"text":"Iyosaafixe Iyoraame yelida;","poem":1},{"lineBreak":true},{"text":"Iyoraame Ooziyane yelida;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ooziyane Iyo7ataama yelida;","poem":1},{"lineBreak":true},{"text":"Iyo7ataama Akkaza yelida;","poem":1},{"lineBreak":true},{"text":"Akkaza Hiziqiyasa yelida;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hiziqiyasa Minaase yelida;","poem":1},{"lineBreak":true},{"text":"Minaase Amoona yelida;","poem":1},{"lineBreak":true},{"text":"Amoona Iyosiyaasa yelida;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Isra7eele asuntsi di7intti Baabiloone gaaze sa7a hyanggide wode Iyosiyaasa Ikoniyaanan E ishuntsana yelida.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Baabiloone sa7a Isra7eele asuntsi di7inttii hyanggideppa maaqqii Ikoniyaana Salatiyaale yelida.","poem":1},{"lineBreak":true},{"text":"Salatiyaale Zerubaabela yelida;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zerubaabela Abdiyu yelida;","poem":1},{"lineBreak":true},{"text":"Abdiyu Eliyaaqeme yelida;","poem":1},{"lineBreak":true},{"text":"Eliyaaqeme Azaara yelida;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azaara Sadooqe yelida;","poem":1},{"lineBreak":true},{"text":"Sadooqe Akime yelida;","poem":1},{"lineBreak":true},{"text":"Akime Eliyuuda yelida;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliyuuda Alaazare yelida;","poem":1},{"lineBreak":true},{"text":"Alaazare Maatane yelida;","poem":1},{"lineBreak":true},{"text":"Maatane Yayqooba yelida;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yayqooba Yoosefa yelida;","poem":1},{"lineBreak":true},{"text":"Yoosefa Kiristtoosa gaaze Yesuusa yelide Mayrami azini.","poem":1}]},{"type":"verse","number":17,"content":["Yikke, yelintta Abrahameppa Dawute yellodes taphpho oyddii. Dawuteppa hyanggi Baabiloone di7e yellodes taphpho oyddii. Baabiloone di7eppa hyanggi Kiristtoosa yellodes taphpho oyddii yelintte maaqqane."]},{"type":"heading","content":["Yesuus Kiristtoosa yelintto"]},{"type":"verse","number":18,"content":["Yesuus Kiristtoosa yelintta taarike hyannippa kaallizanno. E intta Mayrama Yoosefas oocintti yezite Yoosefa ekkikaayzin Geeshi Ayyaanappa wodaxida."]},{"type":"verse","number":19,"content":["Yoosefa xillo as maaqqide gisho izo as gidda kessodes koykaaya. Yinnii gisho aachchii izo ashshodes qoppida."]},{"type":"verse","number":20,"content":["E yinna qofite yezin Xoozze kiitanchcho abukkora qonccii, «Dawute na7ay, Yoosefa, ne oocide Mayrama wodaxide Geeshi Ayyaanappa maaqqide gisho izo ekkodes zhashtippe» yagayda."]},{"type":"verse","number":21,"content":["Iza dhiiratsi na7a yeloda, E fa worzhito un nagarttippa ashshize gisho E suntsito ne Yesuusa ga7i xeegoda."]},{"type":"verse","number":22,"content":["Laatstse nabe Isayaasa doona."]},{"type":"verse","number":23,"content":["«Yikke wudurtta wodaxoda; dhiiratsi na7an yeloda; E suntsita Ammanu7eela ga7inttoda» ga7inttidanna folinttode fana hyanna ubbanna hyanida. Ammanu7eela gaazannis bilitsita «Xoozii nuura yene» ga7e."]},{"type":"verse","number":24,"content":["Yoosefa genttoppa barkki Laatstse kiitanchchuntsi kiittidanni fana Mayramo fa kara kanggida."]},{"type":"verse","number":25,"content":["Yezin fa anggis na7aya yelode wontsis izo girmmikaaya;",{"noteId":0},"Yelinttide na7aya Yesuusa ga7i xeegida."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Izo girmmikaaya: Machchira azinara wolla aqizanni fana aqikaaya ga7e.","reference":{"chapter":1,"verse":25}}]},"thisChapterLink":"/api/oyd_ltw/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/oyd_ltw/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}