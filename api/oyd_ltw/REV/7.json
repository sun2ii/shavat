{"translation":{"id":"oyd_ltw","name":"Kille Caaqo","website":"https://ebible.org/Scriptures/details.php?id=oydl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=oydl","licenseNotes":null,"shortName":"LTW","englishName":"Oyda NT Latin","language":"oyd","textDirection":"ltr","sha256":"b3c27f0faac10e2d158570b98c72511c725a5cfe2c4146b82e31bdc91f7c9981","availableFormats":["json"],"listOfBooksApiLink":"/api/oyd_ltw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Oyda","languageEnglishName":"Oyda"},"book":{"id":"REV","translationId":"oyd_ltw","name":"Wahannisa Qonccitsi","commonName":"Wahannisa Qonccitsi","title":"Wahannisa Qonccitsi","order":66,"numberOfChapters":22,"sha256":"cbfb1048582f3b47554e49c54bd8511324fc444da524b0b1d37e1927c7d299f0","firstChapterNumber":1,"firstChapterApiLink":"/api/oyd_ltw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/oyd_ltw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["144, 000 Asuntsalla mahitame gaddinttida"]},{"type":"verse","number":1,"content":["Yinnippa suuba, oyddii kiitanchchuntsi oyddii sa7a gaxa eqqiduntsana bi7ida. Yentsi kiitanchchuntsi sa7alla woy abballa woy minxalla afa akkon baqo oyddii sa7a gaxappa baqqaame gaar teqqida."]},{"type":"verse","number":2,"content":["Mahi de7o Xoozze mahitame aykkide melle kiitanchcho awa kessi zalappa kezzaya bi7ida. Ye kiitanchchize fa qaaltto dhoqi yiizii, sa7an abba qohodes wolqqa ingginttide oyddii kiitanchchuntsana,"]},{"type":"verse","number":3,"content":["xeegii, «Nuunii Xoozze arunts sinolla mahitame gaddode wontsis sa7a woy abba woy minxa qohippete» gayda."]},{"type":"verse","number":4,"content":["Taanii Xoozze mahitame sinolla gaddiduntsi faydito si7ida. Isra7eele kochchi ubbap xeeti oyttam oyddii mukul asuntsis sintte mahitame gaddida."]},{"type":"verse","number":5,"content":[{"text":"Yihuda kochchappa taphpho lam77i mukul,","poem":1},{"lineBreak":true},{"text":"Roobela kochchappa taphpho lam77i mukul,","poem":1},{"lineBreak":true},{"text":"Gaade kochchappa taphpho lam77i mukul,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aseere kochchappa taphpho lam77i mukul,","poem":1},{"lineBreak":true},{"text":"Niftaaleme kochchappa taphpho lam77i mukul,","poem":1},{"lineBreak":true},{"text":"Minaase kochchappa taphpho lam77i mukul,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Simoona kochchappa taphpho lam77i mukul;","poem":1},{"lineBreak":true},{"text":"Leewe kochchappa taphpho lam77i mukul,","poem":1},{"lineBreak":true},{"text":"Yisaakore kochchappa taphpho lam77i mukul,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zaabiloone kochchappa taphpho lam77i mukul,","poem":1},{"lineBreak":true},{"text":"Yoosefa kochchappa taphpho lam77i mukul,","poem":1},{"lineBreak":true},{"text":"Biniyame kochchappa taphpho lam77i mukul,","poem":1},"asunts sintte mahitame gaddida."]},{"type":"heading","content":["Bootsi ma7o ma77ide gaama asuntsana"]},{"type":"verse","number":9,"content":["Yinnippa suuba, kochchi ubbappa, ka7itumo ubbappa, worizha ubbappan dumma dumma doonappa faydo baayze gaama asuntsana bi7ida. Yentsi asuntsi bootsi pharggo ma7o ma77i, qiile hyaye fa kushite aykkii, araatize tiinon Durize tiino eqqida."]},{"type":"verse","number":10,"content":["Un fa qaaltto dhoqi yiizii, «Atotitsi araatizella bettide nu Xoozzeppan Durizeppa ye7ine» gayda."]},{"type":"verse","number":11,"content":["Kiitanchchuntsi ubba, araatizen, cimuntsin oyddii medhetuntsi kantto wutii eqqida. Un araatize tiino zuggii Xooz goynida."]},{"type":"verse","number":12,"content":[{"text":"«Amin77e!","poem":1},{"text":"Anjjo, bonchcho, cinccatitsi, galata, saba","poem":2},{"lineBreak":true},{"text":"wolqqan, mintsitimo medhii medhinas","poem":2},{"lineBreak":true},{"text":"nu Xoozzes maaqqe.","poem":2},{"lineBreak":true},{"text":"Amin77e!»","poem":2},"gayda."]},{"type":"verse","number":13,"content":["Cimuntsappa fetay taago, «Hyanna bootsi ma7ito ma77ide asuntsi un oode yessa? Un abappa yi7ido?» ga7i oocida."]},{"type":"verse","number":14,"content":["Taanii mahi, «Laatstso, ne erane» gayda. Ezin taago, «Hyantses gaama waaye waayi aadhiduntsana. Un fa ma7ito Durize suutsite meeccii bootsida."]},{"type":"verse","number":15,"content":["Yinnii gisho,",{"text":"«Un Xoozze araatize tiintte","poem":1},{"text":"qamman awara E keetsite oochchane.","poem":2},{"lineBreak":true},{"text":"Mahi araatizella bettide unttis dunkkaane maaqqada.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yikkeppa suuba, un naydhdhaama, baridhdhaama.","poem":1},{"text":"Awa woy micha unttana denggaama.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Araatizella bettide Durize unttis wude adaya maaqqada.","poem":1},{"text":"De7o hyaatsi aafego unttana kaalitsoda.","poem":2},{"lineBreak":true},{"text":"Xoozii un aafitippa afutsito ubba uccoda»","poem":2},"gayda."]}],"footnotes":[]},"thisChapterLink":"/api/oyd_ltw/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/oyd_ltw/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/oyd_ltw/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}