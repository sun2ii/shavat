{"translation":{"id":"pan_irv","name":"ਇੰਡਿਅਨ ਰਿਵਾਇਜ਼ਡ ਵਰਜ਼ਨ (IRV) - ਪੰਜਾਬੀ","website":"https://ebible.org/Scriptures/details.php?id=pan","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pan","licenseNotes":null,"shortName":"IRV","englishName":"Punjabi Indian Revised Version Bible","language":"pan","textDirection":"ltr","sha256":"7bcf70d369a169a12ac867ce44def25b36147b72029339f8c8d3c7a06bab588d","availableFormats":["json"],"listOfBooksApiLink":"/api/pan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ਪੰਜਾਬੀ","languageEnglishName":"Punjabi"},"book":{"id":"PSA","translationId":"pan_irv","name":"ਜ਼ਬੂਰ","commonName":"ਜ਼ਬੂਰ","title":"ਜ਼ਬੂਰ","order":19,"numberOfChapters":150,"sha256":"8a1b7c5c3025a80671b87659256d14a42fb58ace987b687a83db2b26ac8a5d95","firstChapterNumber":1,"firstChapterApiLink":"/api/pan_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pan_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":133,"content":[{"type":"heading","content":["ਭਰਾਵਾਂ ਦੀ ਏਕਤਾ ਧੰਨ ਹੈ"]},{"type":"hebrew_subtitle","content":["ਦਾਊਦ ਦਾ ਯਾਤਰਾ ਦਾ ਗੀਤ"]},{"type":"verse","number":1,"content":[{"text":"ਵੇਖੋ, ਕਿੰਨ੍ਹਾਂ ਚੰਗਾ ਅਤੇ ਸੋਹਣਾ ਹੈ","poem":1},{"lineBreak":true},{"text":"ਕਿ ਵਿਸ਼ਵਾਸੀ ਮਿਲ-ਜੁਲ ਕੇ ਵੱਸਣ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ਇਹ ਉਸ ਖਾਲ਼ਸ ਤੇਲ ਦੀ ਤਰ੍ਹਾਂ ਹੈ,","poem":1},{"lineBreak":true},{"text":"ਜਿਹੜਾ ਸਿਰ ਉੱਤੋਂ ਚੋ ਕੇ ਦਾੜ੍ਹੀ ਉੱਤੇ,","poem":1},{"lineBreak":true},{"text":"ਅਰਥਾਤ ਹਾਰੂਨ ਦੀ ਦਾੜ੍ਹੀ ਉੱਤੋਂ ਚੋ ਕੇ","poem":1},{"lineBreak":true},{"text":"ਉਸ ਦੀ ਪੁਸ਼ਾਕ ਦੀ ਸਿਰੇ ਤੱਕ ਪਹੁੰਚ ਗਿਆ।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ਇਹ ਹਰਮੋਨ","poem":1},{"noteId":68},{"text":"ਦੀ ਤ੍ਰੇਲ ਦੀ ਤਰ੍ਹਾਂ ਹੈ,","poem":1},{"lineBreak":true},{"text":"ਜੋ ਸੀਯੋਨ ਦੇ ਪਰਬਤ ਉੱਤੇ ਪੈਂਦੀ ਹੈ,","poem":1},{"lineBreak":true},{"text":"ਤਾਂ ਹੀ ਉੱਥੇ ਯਹੋਵਾਹ ਨੇ ਬਰਕਤ ਦਾ,","poem":1},{"lineBreak":true},{"text":"ਅਰਥਾਤ ਸਦੀਪਕ ਜੀਵਨ ਦਾ ਹੁਕਮ ਦਿੱਤਾ ਹੈ।","poem":1}]}],"footnotes":[{"noteId":68,"caller":"+","text":"ਪਰਬਤ ਦੀ ਚੋਟੀ","reference":{"chapter":133,"verse":3}}]},"thisChapterLink":"/api/pan_irv/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pan_irv/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pan_irv/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}