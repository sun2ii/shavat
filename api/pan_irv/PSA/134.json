{"translation":{"id":"pan_irv","name":"ਇੰਡਿਅਨ ਰਿਵਾਇਜ਼ਡ ਵਰਜ਼ਨ (IRV) - ਪੰਜਾਬੀ","website":"https://ebible.org/Scriptures/details.php?id=pan","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pan","licenseNotes":null,"shortName":"IRV","englishName":"Punjabi Indian Revised Version Bible","language":"pan","textDirection":"ltr","sha256":"7bcf70d369a169a12ac867ce44def25b36147b72029339f8c8d3c7a06bab588d","availableFormats":["json"],"listOfBooksApiLink":"/api/pan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ਪੰਜਾਬੀ","languageEnglishName":"Punjabi"},"book":{"id":"PSA","translationId":"pan_irv","name":"ਜ਼ਬੂਰ","commonName":"ਜ਼ਬੂਰ","title":"ਜ਼ਬੂਰ","order":19,"numberOfChapters":150,"sha256":"8a1b7c5c3025a80671b87659256d14a42fb58ace987b687a83db2b26ac8a5d95","firstChapterNumber":1,"firstChapterApiLink":"/api/pan_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pan_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":134,"content":[{"type":"heading","content":["ਪਰਮੇਸ਼ੁਰ ਦੀ ਉਸਤਤ ਕਰਨ ਦਾ ਸੱਦਾ"]},{"type":"hebrew_subtitle","content":["ਯਾਤਰਾ ਦਾ ਗੀਤ।"]},{"type":"verse","number":1,"content":[{"text":"ਵੇਖੋ, ਹੇ ਯਹੋਵਾਹ ਦੇ ਸਾਰੇ ਸੇਵਕੋ,","poem":1},{"lineBreak":true},{"text":"ਯਹੋਵਾਹ ਨੂੰ ਮੁਬਾਰਕ ਆਖੋ,","poem":1},{"lineBreak":true},{"text":"ਤੁਸੀਂ ਜਿਹੜੇ ਯਹੋਵਾਹ ਦੇ ਭਵਨ ਵਿੱਚ ਰਾਤ ਨੂੰ ਸੇਵਾ ਕਰਦੇ ਰਹਿੰਦੇ ਹੋ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ਪਵਿੱਤਰ ਸਥਾਨ ਵੱਲ ਆਪਣੇ ਹੱਥ ਚੁੱਕ ਕੇ","poem":1},{"lineBreak":true},{"text":"ਯਹੋਵਾਹ ਨੂੰ ਮੁਬਾਰਕ ਆਖੋ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ਯਹੋਵਾਹ ਤੈਨੂੰ ਸੀਯੋਨ","poem":1},{"noteId":69},{"text":"ਤੋਂ ਬਰਕਤ ਦੇਵੇ,","poem":1},{"lineBreak":true},{"text":"ਜੋ ਅਕਾਸ਼ ਤੇ ਧਰਤੀ ਦਾ ਕਰਤਾ ਹੈ।","poem":1}]}],"footnotes":[{"noteId":69,"caller":"+","text":"ਪਰਬਤ","reference":{"chapter":134,"verse":3}}]},"thisChapterLink":"/api/pan_irv/PSA/134.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pan_irv/PSA/135.jso