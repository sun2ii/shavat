{"translation":{"id":"pes_opcb","name":"Biblica® Open Persian Contemporary Bible 2022","website":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseNotes":null,"shortName":"OPCB","englishName":"Open Persian Contemporary Bible","language":"pes","textDirection":"rtl","sha256":"58121d81cf9aadf4e1028e92ff7d0249eb8b58e0fb0d50e54994f6143699b561","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_opcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29469,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"JOB","translationId":"pes_opcb","name":"ایوب","commonName":"ایوب","title":"ایوب","order":18,"numberOfChapters":42,"sha256":"30bf89d07ed1a0618923ac6a2f77e4123f4f08299e06cdbaf43386c31371d6c0","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_opcb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/pes_opcb/JOB/42.json","totalNumberOfVerses":1010},"chapter":{"number":26,"content":[{"type":"heading","content":["نهمین گفتار ایوب: پاسخ به بلدد"]},{"type":"verse","number":1,"content":["آنگاه ایوب پاسخ داد:"]},{"type":"verse","number":2,"content":["چه مددکاران خوبی هستید! چه خوب مرا در هنگام سختی دلداری دادید!"]},{"type":"verse","number":3,"content":["چه خوب با پندهای خود مرا متوجهٔ حماقتم ساختید و چه حرفهای عاقلانه‌ای زدید!"]},{"type":"verse","number":4,"content":["چطور به فکرتان رسید این سخنان عالی را به زبان بیاورید؟"]},{"type":"verse","number":5,"content":["ارواح مردگان می‌لرزند، آنان که زیر آبهایند و همۀ ساکنانش."]},{"type":"verse","number":6,"content":["هاویه",{"noteId":7},"به حضور خدا عریان است، و اَبَدون",{"noteId":8},"را پوششی نیست."]},{"type":"verse","number":7,"content":["خدا آسمان شمالی را بر خلاء می‌گستراند و زمین را بر نیستی می‌آویزد."]},{"type":"verse","number":8,"content":["او آب را در ابرهای خود قرار می‌دهد و ابرها از سنگینی آن شکاف بر نمی‌دارند."]},{"type":"verse","number":9,"content":["خدا تخت خود را با ابرهایش می‌پوشاند."]},{"type":"verse","number":10,"content":["او برای اقیانوس حد می‌گذارد و برای روز و شب مرز قرار می‌دهد."]},{"type":"verse","number":11,"content":["ارکان آسمان از نهیب او به لرزه در می‌آیند."]},{"type":"verse","number":12,"content":["او با قدرت خویش دریا را مهار می‌کند و با حکمت خود هیولای دریا",{"noteId":9},"را در هم می‌شکند."]},{"type":"verse","number":13,"content":["دَم خدا آسمانها را صاف و شفاف می‌سازد، و دست او مار تیزرو را سوراخ می‌کند."]},{"type":"verse","number":14,"content":["اینها تنها بخش کوچکی از کارهای عظیم اوست و زمزمه‌ای از صدای غرش او. پس کیست که بتواند در برابر قدرت او بایستد؟"]}],"footnotes":[{"noteId":7,"caller":"+","text":"26‏:6 یا: «مکان مردگان». در عبری: «شِئول».","reference":{"chapter":26,"verse":6}},{"noteId":8,"caller":"+","text":"26‏:6 یعنی: «مکان نابودی».","reference":{"chapter":26,"verse":6}},{"noteId":9,"caller":"+","text":"26‏:12 در عبری: «رَهَب» که مظهر بدی است.","reference":{"chapter":26,"verse":12}}]},"thisChapterLink":"/api/pes_opcb/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_opcb/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_opcb/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}