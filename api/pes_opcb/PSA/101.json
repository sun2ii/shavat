{"translation":{"id":"pes_opcb","name":"Biblica® Open Persian Contemporary Bible 2022","website":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseNotes":null,"shortName":"OPCB","englishName":"Open Persian Contemporary Bible","language":"pes","textDirection":"rtl","sha256":"58121d81cf9aadf4e1028e92ff7d0249eb8b58e0fb0d50e54994f6143699b561","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_opcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29469,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_opcb","name":"مزامیر","commonName":"مزامیر","title":"مزامیر","order":19,"numberOfChapters":150,"sha256":"da213df408200338d539682eb18b5984c81c76ce24df4ebf7359574dd3ecc0d5","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_opcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_opcb/PSA/150.json","totalNumberOfVerses":2439},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["مزمور داوود."]},{"type":"verse","number":1,"content":["ای خداوند، محبت و عدالت تو را می‌ستایم و با سرود تو را می‌پرستم."]},{"type":"verse","number":2,"content":["مراقب خواهم بود تا راه درست و بی‌عیب را در پیش بگیرم. نزد من کِی خواهی آمد؟ در خانه خود، با دلی راست زندگی خواهم کرد."]},{"type":"verse","number":3,"content":["هر چیز بد و ناپسند را از پیش چشم خود دور خواهم نمود. کردار افراد نادرست را دوست نخواهم داشت و در کارهایشان سهیم نخواهم شد."]},{"type":"verse","number":4,"content":["نادرستی را از خود دور خواهم ساخت و با گناهکاران معاشرت نخواهم کرد."]},{"type":"verse","number":5,"content":["کسی را که از دیگران بدگویی کند ساکت خواهم کرد؛ شخص مغرور و خودخواه را متحمل نخواهم شد."]},{"type":"verse","number":6,"content":["من در پی اشخاص امین و خداشناس هستم تا آنها را به کاخ خود بیاورم. کسی که درستکار باشد، او را به کار خواهم گماشت."]},{"type":"verse","number":7,"content":["حیله‌گر به کاخ من راه نخواهد یافت و دروغگو نزد من نخواهد ماند."]},{"type":"verse","number":8,"content":["هر روز عده‌ای از شریران را نابود خواهم کرد تا شهر خدا را از وجود همهٔ آنها پاک سازم."]}],"footnotes":[]},"thisChapterLink":"/api/pes_opcb/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_opcb/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_opcb/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}