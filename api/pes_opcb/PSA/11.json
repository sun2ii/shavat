ر او خواهند زیست."]}],"footnotes":[]},"thisChapterLink":"/api/pes_opcb/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_opcb/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_opcb/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}