{"translation":{"id":"pes_opcb","name":"Biblica® Open Persian Contemporary Bible 2022","website":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseNotes":null,"shortName":"OPCB","englishName":"Open Persian Contemporary Bible","language":"pes","textDirection":"rtl","sha256":"58121d81cf9aadf4e1028e92ff7d0249eb8b58e0fb0d50e54994f6143699b561","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_opcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29469,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_opcb","name":"مزامیر","commonName":"مزامیر","title":"مزامیر","order":19,"numberOfChapters":150,"sha256":"da213df408200338d539682eb18b5984c81c76ce24df4ebf7359574dd3ecc0d5","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_opcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_opcb/PSA/150.json","totalNumberOfVerses":2439},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["سرود زائران به هنگام بالا رفتن به اورشلیم. مزمور داوود."]},{"type":"verse","number":1,"content":["هنگامی که به من می‌گفتند: «بیا تا به خانهٔ خداوند برویم» بسیار خوشحال می‌شدم!"]},{"type":"verse","number":2,"content":["و اینک اینجا در میان دروازه‌های اورشلیم ایستاده‌ایم!"]},{"type":"verse","number":3,"content":["اورشلیم اینک بازسازی شده و دیوارهایش به هم پیوسته است."]},{"type":"verse","number":4,"content":["قبایل اسرائیل به اورشلیم می‌آیند تا طبق دستوری که خداوند به ایشان داده است، او را سپاس گویند و پرستش کنند."]},{"type":"verse","number":5,"content":["در اینجا تختهای داوری برپاست، تختهایِ خاندان داوود."]},{"type":"verse","number":6,"content":["برای برقراری صلح و سلامتی در اورشلیم دعا کنید! همهٔ کسانی که این شهر را دوست دارند، کامیاب باشند."]},{"type":"verse","number":7,"content":["ای اورشلیم، صلح و سلامتی در حصارهای تو و رفاه و آسایش در قصرهایت برقرار باد!"]},{"type":"verse","number":8,"content":["به خاطر خانواده و دوستان خویش می‌گویم: «صلح و آرامش بر تو باد!»"]},{"type":"verse","number":9,"content":["ای اورشلیم، به خاطر خانهٔ یهوه خدای ما، سعادت تو را خواهانم."]}],"footnotes":[]},"thisChapterLink":"/api/pes_opcb/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_opcb/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_opcb/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}