{"translation":{"id":"pes_opcb","name":"Biblica® Open Persian Contemporary Bible 2022","website":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseNotes":null,"shortName":"OPCB","englishName":"Open Persian Contemporary Bible","language":"pes","textDirection":"rtl","sha256":"58121d81cf9aadf4e1028e92ff7d0249eb8b58e0fb0d50e54994f6143699b561","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_opcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29469,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_opcb","name":"مزامیر","commonName":"مزامیر","title":"مزامیر","order":19,"numberOfChapters":150,"sha256":"da213df408200338d539682eb18b5984c81c76ce24df4ebf7359574dd3ecc0d5","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_opcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_opcb/PSA/150.json","totalNumberOfVerses":2439},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"خداوند را شکر گویید، زیرا او نیکوست و محبتش ابدیست.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"خدای خدایان را شکر گویید،","poem":1},{"text":"زیرا محبتش ابدیست.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"خدای خدایان را شکر گویید،","poem":1},{"text":"زیرا محبتش ابدیست.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"او را که معجزات عظیم می‌کند شکر کنید،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":5,"content":[{"text":"او را که آسمانها را با حکمت خویش آفرید شکر گویید،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":6,"content":[{"text":"او را که خشکی را بر آبها قرار داد شکر گویید،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":7,"content":[{"text":"او را که خورشید و ماه را در آسمان آفرید شکر گویید،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":8,"content":[{"text":"آفتاب را برای فرمانروایی بر روز آفرید،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":9,"content":[{"text":"و ماه و ستارگان را برای فرمانروایی بر شب،","poem":1},{"text":"زیرا محبتش ابدیست.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"خدا را که پسران ارشد مصری‌ها را کشت شکر گویید،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":11,"content":[{"text":"او بنی‌اسرائیل را از مصر بیرون آورد،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":12,"content":[{"text":"با دستی قوی و بازویی بلند چنین کرد،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":13,"content":[{"text":"دریای سرخ را شکافت،","poem":2},{"lineBreak":true},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":14,"content":[{"text":"و بنی‌اسرائیل را از میان آن عبور داد،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":15,"content":[{"text":"فرعون و لشکر او را در دریای سرخ غرق ساخت،","poem":1},{"text":"زیرا محبتش ابدیست.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"او را که قوم خود را در صحرا رهبری کرد شکر گویید،","poem":1},{"text":"زیرا محبتش ابدیست.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"او پادشاهان بزرگ را زد،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":18,"content":[{"text":"و شاهان قدرتمند را از بین برد،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":19,"content":[{"text":"سیحون، پادشاه اموری‌ها،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":20,"content":[{"text":"و عوج، پادشاه باشان،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":21,"content":[{"text":"سرزمینهای ایشان را به میراث داد،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":22,"content":[{"text":"میراثی برای خادم خود اسرائیل،","poem":1},{"text":"زیرا محبتش ابدیست.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"خداوندْ ما را در مشکلاتمان به یاد آورد،","poem":1},{"text":"زیرا محبتش ابدیست؛","poem":2}]},{"type":"verse","number":24,"content":[{"text":"او ما را از دست دشمنانمان نجات داد،","poem":1},{"text":"زیرا محبتش ابدیست.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"او روزی همهٔ جانداران را می‌رساند،","poem":1},{"text":"زیرا محبتش ابدیست.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"خدای آسمانها را شکر گویید،","poem":1},{"text":"زیرا محبتش ابدیست.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pes_opcb/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_opcb/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_opcb/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}