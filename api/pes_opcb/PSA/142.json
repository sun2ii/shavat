{"translation":{"id":"pes_opcb","name":"Biblica® Open Persian Contemporary Bible 2022","website":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseNotes":null,"shortName":"OPCB","englishName":"Open Persian Contemporary Bible","language":"pes","textDirection":"rtl","sha256":"58121d81cf9aadf4e1028e92ff7d0249eb8b58e0fb0d50e54994f6143699b561","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_opcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29469,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_opcb","name":"مزامیر","commonName":"مزامیر","title":"مزامیر","order":19,"numberOfChapters":150,"sha256":"da213df408200338d539682eb18b5984c81c76ce24df4ebf7359574dd3ecc0d5","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_opcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_opcb/PSA/150.json","totalNumberOfVerses":2439},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["قصیدۀ داوود دربارۀ زمانی که در غار بود. دعا."]},{"type":"verse","number":1,"content":["با صدای بلند نزد خداوند فریاد می‌زنم و درخواست کمک می‌نمایم."]},{"type":"verse","number":2,"content":["تمام شکایات خود را به حضور او می‌آورم و مشکلات خود را برای او بازگو می‌کنم."]},{"type":"verse","number":3,"content":["وقتی جانم به لب می‌رسد او به کمکم می‌شتابد و راهی پیش پایم می‌نهد. دشمنانم بر سر راه من دام می‌گذارند."]},{"type":"verse","number":4,"content":["به اطراف خود نگاه می‌کنم و می‌بینم کسی نیست که مرا کمک کند. پناهی ندارم و کسی به فکر من نیست."]},{"type":"verse","number":5,"content":["ای خداوند، نزد تو فریاد برمی‌آورم، و می‌گویم، «تویی پناهگاه من. در زندگی، تنها تو را آرزو دارم."]},{"type":"verse","number":6,"content":["فریادم را بشنو، زیرا بسیار درمانده هستم. مرا از دست دشمنانم برهان، زیرا آنها بسیار قویتر از من هستند."]},{"type":"verse","number":7,"content":["مرا از این پریشانی و اسارت آزاد کن، تا تو را به سبب خوبی‌هایی که برایم کرده‌ای در جمع عادلان ستایش کنم.»"]}],"footnotes":[]},"thisChapterLink":"/api/pes_opcb/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_opcb/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_opcb/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}