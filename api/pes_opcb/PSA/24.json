{"translation":{"id":"pes_opcb","name":"Biblica® Open Persian Contemporary Bible 2022","website":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseNotes":null,"shortName":"OPCB","englishName":"Open Persian Contemporary Bible","language":"pes","textDirection":"rtl","sha256":"58121d81cf9aadf4e1028e92ff7d0249eb8b58e0fb0d50e54994f6143699b561","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_opcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29469,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_opcb","name":"مزامیر","commonName":"مزامیر","title":"مزامیر","order":19,"numberOfChapters":150,"sha256":"da213df408200338d539682eb18b5984c81c76ce24df4ebf7359574dd3ecc0d5","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_opcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_opcb/PSA/150.json","totalNumberOfVerses":2439},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["مزمور داوود."]},{"type":"verse","number":1,"content":["زمین و هر آنچه در آن است، از آن خداوند می‌باشد."]},{"type":"verse","number":2,"content":["او اساس و بنیاد زمین را بر آب دریاها قرار داد."]},{"type":"verse","number":3,"content":["چه کسی می‌تواند به خانهٔ مقدّس خداوند که بر کوه واقع است راه یابد؟"]},{"type":"verse","number":4,"content":["کسی که پندار و کردارش پاک باشد و از ناراستی و دروغ بپرهیزد."]},{"type":"verse","number":5,"content":["خداوند چنین کسی را نجات بخشیده، برکت خواهد داد و او را بی‌گناه اعلام خواهد نمود."]},{"type":"verse","number":6,"content":["اینها همان کسانی هستند که همیشه در طلب خدای یعقوب می‌باشند و مشتاق دیدار او هستند!"]},{"type":"verse","number":7,"content":["ای دروازه‌ها، باز شوید! ای درهای قدیمی اورشلیم باز شوید، تا پادشاه جلال وارد شود!"]},{"type":"verse","number":8,"content":["این پادشاه جلال کیست؟ خداوند است! خداوند قادر مطلق؛ خداوند فاتح همهٔ جنگها!"]},{"type":"verse","number":9,"content":["ای دروازه‌ها، باز شوید! ای درهای قدیمی اورشلیم باز شوید، تا پادشاه جلال وارد شود!"]},{"type":"verse","number":10,"content":["این پادشاه جلال کیست؟ خداوند است! خداوند لشکرهای آسمان! آری، اوست پادشاه جلال!"]}],"footnotes":[]},"thisChapterLink":"/api/pes_opcb/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_opcb/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_opcb/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}