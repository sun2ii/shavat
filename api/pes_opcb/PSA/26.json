er":9,"content":["پس با من مانند بدکاران و قاتلان رفتار نکن که رشوه می‌دهند و خون مردم را می‌ریزند."]},{"type":"verse","number":11,"content":["اما من راستی را پیشه کرده‌ام؛ بر من رحم کن و مرا نجات ده."]},{"type":"verse","number":12,"content":["خداوند را در حضور مردم سپاس خواهم گفت، زیرا مرا از خطر رهانیده است."]}],"footnotes":[]},"thisChapterLink":"/api/pes_opcb/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_opcb/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_opcb/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":11}