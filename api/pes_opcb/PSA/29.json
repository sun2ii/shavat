{"translation":{"id":"pes_opcb","name":"Biblica® Open Persian Contemporary Bible 2022","website":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseNotes":null,"shortName":"OPCB","englishName":"Open Persian Contemporary Bible","language":"pes","textDirection":"rtl","sha256":"58121d81cf9aadf4e1028e92ff7d0249eb8b58e0fb0d50e54994f6143699b561","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_opcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29469,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_opcb","name":"مزامیر","commonName":"مزامیر","title":"مزامیر","order":19,"numberOfChapters":150,"sha256":"da213df408200338d539682eb18b5984c81c76ce24df4ebf7359574dd3ecc0d5","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_opcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_opcb/PSA/150.json","totalNumberOfVerses":2439},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["مزمور داوود."]},{"type":"verse","number":1,"content":["ای فرشتگان",{"noteId":9},"، خداوند را ستایش کنید! شکوه و عظمت او را بستایید!"]},{"type":"verse","number":2,"content":["خداوند را به خاطر جلال نامش بپرستید. خداوند را در شکوه قدوسیتش پرستش کنید."]},{"type":"verse","number":3,"content":["صدای خداوند از فراز دریاها شنیده می‌شود؛ او همچون رعد می‌غرد! صدای او بر اقیانوسها طنین‌افکن است!"]},{"type":"verse","number":4,"content":["صدای خداوند پرقدرت و باشکوه است."]},{"type":"verse","number":5,"content":["صدای خداوند درختان سِدر را می‌شکند. خداوند درختان سِدر لبنان را خُرد می‌کند."]},{"type":"verse","number":6,"content":["او کوههای لبنان را می‌لرزاند و کوه حرمون را مانند گوساله به جست و خیز وا می‌دارد."]},{"type":"verse","number":7,"content":["صدای خداوند رعد و برق ایجاد می‌کند،"]},{"type":"verse","number":8,"content":["دشتها را به لرزه در می‌آورد و صحرای قادش را می‌جنباند."]},{"type":"verse","number":9,"content":["صدای خداوند درخت بلوط را می‌لرزاند و برگهای درختان جنگل را به زمین می‌ریزد. در خانهٔ خداوند، همه جلال و عظمت او را می‌ستایند."]},{"type":"verse","number":10,"content":["خداوند بر آبهای عمیق فرمان می‌راند و تا به ابد سلطنت می‌نماید."]},{"type":"verse","number":11,"content":["خداوند به قوم برگزیدهٔ خود قدرت می‌بخشد و صلح و سلامتی نصیب ایشان می‌کند."]}],"footnotes":[{"noteId":9,"caller":"+","text":"29‏:1 عبری: «پسران خدا».","reference":{"chapter":29,"verse":1}}]},"thisChapterLink":"/api/pes_opcb/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_opcb/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_opcb/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}