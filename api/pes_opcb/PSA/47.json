{"translation":{"id":"pes_opcb","name":"Biblica® Open Persian Contemporary Bible 2022","website":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseNotes":null,"shortName":"OPCB","englishName":"Open Persian Contemporary Bible","language":"pes","textDirection":"rtl","sha256":"58121d81cf9aadf4e1028e92ff7d0249eb8b58e0fb0d50e54994f6143699b561","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_opcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29469,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_opcb","name":"مزامیر","commonName":"مزامیر","title":"مزامیر","order":19,"numberOfChapters":150,"sha256":"da213df408200338d539682eb18b5984c81c76ce24df4ebf7359574dd3ecc0d5","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_opcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_opcb/PSA/150.json","totalNumberOfVerses":2439},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["برای رهبر سرایندگان. مزمور پسران قورَح."]},{"type":"verse","number":1,"content":["ای همهٔ مردم جهان، دست بزنید و شادی کنید! خدا را با سرودهای شاد پرستش کنید!"]},{"type":"verse","number":2,"content":["زیرا خداوند متعال، مهیب است. او پادشاهی است با عظمت که بر سراسر جهان فرمان می‌راند."]},{"type":"verse","number":3,"content":["او قومها را مغلوب ما ساخت، طایفه‌ها را به زیر پای ما انداخت."]},{"type":"verse","number":4,"content":["او سرزمین موعود را برای ما برگزید، سرزمینی که موجب افتخار نسل یعقوب، محبوب اوست."]},{"type":"verse","number":5,"content":["خداوند در میان غریو شادی و صدای شیپور، به تخت خود صعود نموده است!"]},{"type":"verse","number":6,"content":["در ستایش او سرود بخوانید! پادشاه ما را با سرود پرستش کنید!"]},{"type":"verse","number":7,"content":["خدا پادشاه تمام جهان است؛ او را با سرود ستایش کنید!"]},{"type":"verse","number":8,"content":["خدا بر قومهای جهان فرمان می‌راند. او بر تخت مقدّس خود نشسته است."]},{"type":"verse","number":9,"content":["رؤسای ممالک جهان با ما متحد شده‌اند تا با ما خدای ابراهیم را پرستش کنند، زیرا او قدرتمندتر از تمام جنگاوران و برتر از همه مردم جهان می‌باشد."]}],"footnotes":[]},"thisChapterLink":"/api/pes_opcb/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_opcb/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_opcb/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}