{"translation":{"id":"pes_opcb","name":"Biblica® Open Persian Contemporary Bible 2022","website":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseNotes":null,"shortName":"OPCB","englishName":"Open Persian Contemporary Bible","language":"pes","textDirection":"rtl","sha256":"58121d81cf9aadf4e1028e92ff7d0249eb8b58e0fb0d50e54994f6143699b561","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_opcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29469,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_opcb","name":"مزامیر","commonName":"مزامیر","title":"مزامیر","order":19,"numberOfChapters":150,"sha256":"da213df408200338d539682eb18b5984c81c76ce24df4ebf7359574dd3ecc0d5","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_opcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_opcb/PSA/150.json","totalNumberOfVerses":2439},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["برای رهبر سرایندگان: با همراهی سازهای زهی. قصیدۀ داوود دربارۀ زمانی که اهالی زیف نزد شائول رفته، گفتند: «ما می‌دانیم داوود کجا پنهان شده است.»",{"noteId":15}]},{"type":"verse","number":1,"content":["ای خدا، با قدرت خود مرا نجات ده و به قوت خویش از من دفاع کن."]},{"type":"verse","number":2,"content":["خدایا، دعای مرا بشنو و به سخنانم توجه فرما،"]},{"type":"verse","number":3,"content":["زیرا بدکاران بر ضد من برخاسته‌اند و ظالمان قصد جان مرا دارند. آنان کسانی‌اند که تو را نمی‌شناسند."]},{"type":"verse","number":4,"content":["اما خدا مددکار من است و جان مرا حفظ می‌کند."]},{"type":"verse","number":5,"content":["تو دشمنان مرا به سزای اعمالشان خواهی رساند. تو امین هستی و آنها را ریشه‌کن خواهی کرد."]},{"type":"verse","number":6,"content":["ای خداوند، با میل و رغبت قربانی به تو تقدیم خواهم کرد و تو را سپاس خواهم گفت زیرا تو نیکو هستی."]},{"type":"verse","number":7,"content":["تو مرا از همهٔ مشکلاتم رهانیده‌ای و من با چشمان خود شکست دشمنانم را دیده‌ام."]}],"footnotes":[{"noteId":15,"caller":"+","text":"54‏:0 نگاه کنید به ۱سموئیل ۲۳‏:۱۹ و ۲۶‏:۱.","reference":{"chapter":54,"verse":0}}]},"thisChapterLink":"/api/pes_opcb/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_opcb/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_opcb/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}