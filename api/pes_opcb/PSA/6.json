{"translation":{"id":"pes_opcb","name":"Biblica® Open Persian Contemporary Bible 2022","website":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesopcb","licenseNotes":null,"shortName":"OPCB","englishName":"Open Persian Contemporary Bible","language":"pes","textDirection":"rtl","sha256":"58121d81cf9aadf4e1028e92ff7d0249eb8b58e0fb0d50e54994f6143699b561","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_opcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29469,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_opcb","name":"مزامیر","commonName":"مزامیر","title":"مزامیر","order":19,"numberOfChapters":150,"sha256":"da213df408200338d539682eb18b5984c81c76ce24df4ebf7359574dd3ecc0d5","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_opcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_opcb/PSA/150.json","totalNumberOfVerses":2439},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["برای رهبر سرایندگان: مزمور داوود، با همراهی سازهای زهی، در مایۀ شِمینیت",{"noteId":1},"."]},{"type":"verse","number":1,"content":["ای خداوند، مرا در شدت خشم خود توبیخ و تنبیه نکن."]},{"type":"verse","number":2,"content":["ای خداوند، به من رحم کن زیرا پژمرده شده‌ام. خداوندا، مرا شفا ده، زیرا دردْ وجودم را فرا گرفته"]},{"type":"verse","number":3,"content":["و بسیار پریشانم. تا به کی ای خداوند، تا به کی؟"]},{"type":"verse","number":4,"content":["ای خداوند، بیا و مرا برهان؛ به خاطر محبت خود، مرا نجات ده."]},{"type":"verse","number":5,"content":["زیرا مردگان نمی‌توانند تو را به یاد آورند. کیست که در قبر",{"noteId":2},"تو را ستایش کند؟"]},{"type":"verse","number":6,"content":["از نالیدن خسته شده‌ام. هر شب بسترم را غرق اشک می‌سازم."]},{"type":"verse","number":7,"content":["از آزار دشمنانم آنقدر گریه کرده‌ام که چشمانم تار شده‌اند."]},{"type":"verse","number":8,"content":["ای همهٔ بدکاران، از من دور شوید؛ زیرا