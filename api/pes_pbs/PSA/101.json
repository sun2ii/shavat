{"translation":{"id":"pes_pbs","name":"ترجمه قدیم","website":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseNotes":null,"shortName":"PBS","englishName":"Old Persion Version Bible","language":"pes","textDirection":"rtl","sha256":"2d3ed67dd6234bd57932b9cfbd00e7e92fa2bdb25ee068befe463f6d702f0279","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_pbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_pbs","name":"مزامیر","commonName":"مزامیر","title":"کتاب مزامیر","order":19,"numberOfChapters":150,"sha256":"43aa014925bed6cd7984b34d8f0b5f4dc8d630fdcca84e9bb79b37aae9e657fb","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_pbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_pbs/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":101,"content":[{"type":"heading","content":["عهد پادشاه"]},{"type":"hebrew_subtitle","content":["مزمور داود"]},{"type":"verse","number":1,"content":["رحمت و انصاف را خواهم سرایید. نزد تو‌ای خداوند، تسبیح خواهم خواند."]},{"type":"verse","number":2,"content":["در طریق کامل به خردمندی رفتارخواهم نمود. نزد من کی خواهی آمد؟ در خانه خود با دل سلیم سالک خواهم شد."]},{"type":"verse","number":3,"content":["چیزی بد راپیش نظر خود نخواهم گذاشت. کار کج روان رامکروه می‌دارم، به من نخواهد چسبید."]},{"type":"verse","number":4,"content":["دل کج ازمن دور خواهد شد. شخص شریر را نخواهم شناخت."]},{"type":"verse","number":5,"content":["کسی را که در خفیه به همسایه خودغیبت‌گوید، هلاک خواهم کرد. کسی را که چشم بلند و دل متکبر دارد تحمل نخواهم کرد."]},{"type":"verse","number":6,"content":["چشمانم بر امنای زمین است تا بامن ساکن شوند. کسی‌که به طریق کامل سالک باشد خادم من خواهد بود."]},{"type":"verse","number":7,"content":["حیله گر در خانه من ساکن نخواهدشد. دروغ گو پیش نظر من نخواهد ماند."]},{"type":"verse","number":8,"content":["همه شریران زمین را صبحگاهان هلاک خواهم کرد. تاجمیع بدکاران را از شهر خداوند منقطع سازم."]}],"footnotes":[]},"thisChapterLink":"/api/pes_pbs/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_pbs/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_pbs/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}