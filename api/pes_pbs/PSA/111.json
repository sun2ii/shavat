{"translation":{"id":"pes_pbs","name":"ترجمه قدیم","website":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseNotes":null,"shortName":"PBS","englishName":"Old Persion Version Bible","language":"pes","textDirection":"rtl","sha256":"2d3ed67dd6234bd57932b9cfbd00e7e92fa2bdb25ee068befe463f6d702f0279","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_pbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_pbs","name":"مزامیر","commonName":"مزامیر","title":"کتاب مزامیر","order":19,"numberOfChapters":150,"sha256":"43aa014925bed6cd7984b34d8f0b5f4dc8d630fdcca84e9bb79b37aae9e657fb","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_pbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_pbs/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":111,"content":[{"type":"heading","content":["رحمت خداوند"]},{"type":"verse","number":1,"content":["هللویاه! خداوند را به تمامی دل حمد خواهم گفت، در مجلس راستان و در جماعت."]},{"type":"verse","number":2,"content":["کارهای خداوند عظیم است، و همگانی که به آنها رغبت دارند در آنهاتفتیش می‌کنند."]},{"type":"verse","number":3,"content":["کار او جلال و کبریایی است وعدالت وی پایدار تا ابدالاباد."]},{"type":"verse","number":4,"content":["یادگاری برای کارهای عجیب خود ساخته است. خداوند کریم و رحیم است."]},{"type":"verse","number":5,"content":["ترسندگان خود را رزقی نیکوداده است. عهد خویش را به یاد خواهد داشت تاابدالاباد."]},{"type":"verse","number":6,"content":["قوت اعمال خود را برای قوم خودبیان کرده است تا میراث امتها را بدیشان عطافرماید."]},{"type":"verse","number":7,"content":["کارهای دستهایش راستی و انصاف است و جمیع فرایض وی امین."]},{"type":"verse","number":8,"content":["آنها پایدار است تا ابدالاباد. در راستی و استقامت کرده شده."]},{"type":"verse","number":9,"content":["فدیه‌ای برای قوم خود فرستاد و عهد خویش راتا ابد امر فرمود. نام او قدوس و مهیب است."]},{"type":"verse","number":10,"content":["ترس خداوند ابتدای حکمت است. همه عاملین آنها را خردمندی نیکو است. حمد اوپایدار است تا ابدالاباد."]}],"footnotes":[]},"thisChapterLink":"/api/pes_pbs/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_pbs/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_pbs/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}