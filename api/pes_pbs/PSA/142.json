{"translation":{"id":"pes_pbs","name":"ترجمه قدیم","website":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseNotes":null,"shortName":"PBS","englishName":"Old Persion Version Bible","language":"pes","textDirection":"rtl","sha256":"2d3ed67dd6234bd57932b9cfbd00e7e92fa2bdb25ee068befe463f6d702f0279","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_pbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_pbs","name":"مزامیر","commonName":"مزامیر","title":"کتاب مزامیر","order":19,"numberOfChapters":150,"sha256":"43aa014925bed6cd7984b34d8f0b5f4dc8d630fdcca84e9bb79b37aae9e657fb","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_pbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_pbs/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":142,"content":[{"type":"heading","content":["دعا در تنگی"]},{"type":"hebrew_subtitle","content":["قصیده داود و دعا وقتیکه در مغاره بود"]},{"type":"verse","number":1,"content":["به آواز خود نزد خداوند فریادبرمی آورم. به آواز خود نزد خداوندتضرع می‌نمایم."]},{"type":"verse","number":2,"content":["ناله خود را در حضور اوخواهم ریخت. تنگی های خود را نزد او بیان خواهم کرد."]},{"type":"verse","number":3,"content":["وقتی که روح من در من مدهوش می‌شود. پس تو طریقت مرا دانسته‌ای. در راهی که می‌روم دام برای من پنهان کرده‌اند."]},{"type":"verse","number":4,"content":["به طرف راست بنگر و ببین که کسی نیست که مرا بشناسد. ملجا برای من نابود شد. کسی نیست که در فکرجان من باشد."]},{"type":"verse","number":5,"content":["نزد تو‌ای خداوند فریاد کردم وگفتم که تو ملجا و حصه من در زمین زندگان هستی."]},{"type":"verse","number":6,"content":["به ناله من توجه کن زیرا که بسیار ذلیلم! مرا از جفاکنندگانم برهان، زیرا که از من زورآورترند."]},{"type":"verse","number":7,"content":["جان مرا از زندان درآور تا نام تو را حمد گویم. عادلان گرداگرد من خواهند آمد زیراکه به من احسان نموده‌ای."]}],"footnotes":[]},"thisChapterLink":"/api/pes_pbs/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_pbs/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_pbs/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}