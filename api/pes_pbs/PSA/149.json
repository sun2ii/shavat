{"translation":{"id":"pes_pbs","name":"ترجمه قدیم","website":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseNotes":null,"shortName":"PBS","englishName":"Old Persion Version Bible","language":"pes","textDirection":"rtl","sha256":"2d3ed67dd6234bd57932b9cfbd00e7e92fa2bdb25ee068befe463f6d702f0279","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_pbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_pbs","name":"مزامیر","commonName":"مزامیر","title":"کتاب مزامیر","order":19,"numberOfChapters":150,"sha256":"43aa014925bed6cd7984b34d8f0b5f4dc8d630fdcca84e9bb79b37aae9e657fb","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_pbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_pbs/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":149,"content":[{"type":"heading","content":["سرود تازه برای خداوند"]},{"type":"verse","number":1,"content":["هللویاه! خداوند را سرود تازه بسرایید و تسبیح او را در جماعت مقدسان!"]},{"type":"verse","number":2,"content":["اسرائیل در آفریننده خود شادی کنندو پسران صهیون در پادشاه خویش وجد نمایند."]},{"type":"verse","number":3,"content":["نام او را با رقص تسبیح بخوانند. با بربط و عود اورا بسرایند."]},{"type":"verse","number":4,"content":["زیرا خداوند از قوم خویش رضامندی دارد. مسکینان را به نجات جمیل می‌سازد."]},{"type":"verse","number":5,"content":["مقدسان از جلال فخر بنمایند. و بربسترهای خود ترنم بکنند."]},{"type":"verse","number":6,"content":["تسبیحات بلند خدادر دهان ایشان باشد. و شمشیر دو‌دمه در دست ایشان."]},{"type":"verse","number":7,"content":["تا از امت‌ها انتقام بکشند و تادیب‌ها برطوایف بنمایند."]},{"type":"verse","number":8,"content":["و پادشاهان ایشان را به زنجیرها ببندند و سروران ایشان را به پابندهای آهنین."]},{"type":"verse","number":9,"content":["و داوری را که مکتوب است بر ایشان اجرا دارند. این کرامت است برای همه مقدسان او. هللویاه!"]}],"footnotes":[]},"thisChapterLink":"/api/pes_pbs/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_pbs/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_pbs/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}