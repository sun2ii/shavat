{"translation":{"id":"pes_pbs","name":"ترجمه قدیم","website":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseNotes":null,"shortName":"PBS","englishName":"Old Persion Version Bible","language":"pes","textDirection":"rtl","sha256":"2d3ed67dd6234bd57932b9cfbd00e7e92fa2bdb25ee068befe463f6d702f0279","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_pbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_pbs","name":"مزامیر","commonName":"مزامیر","title":"کتاب مزامیر","order":19,"numberOfChapters":150,"sha256":"43aa014925bed6cd7984b34d8f0b5f4dc8d630fdcca84e9bb79b37aae9e657fb","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_pbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_pbs/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":20,"content":[{"type":"heading","content":["نصرت از خدا"]},{"type":"hebrew_subtitle","content":["برای سالار مغنیان. مزمور داود"]},{"type":"verse","number":1,"content":["خداوند تو را در روز تنگی مستجاب فرماید. نام خدای یعقوب تو را سرافرازنماید."]},{"type":"verse","number":2,"content":["نصرت برای تو از قدس خود بفرستد وتو را از صهیون تایید نماید."]},{"type":"verse","number":3,"content":["جمیع هدایای تو رابه یاد آورد و قربانی های سوختنی تو را قبول فرماید. سلاه."]},{"type":"verse","number":4,"content":["موافق دل تو به تو عطا فرماید وهمه مشورتهای تو را به انجام رساند."]},{"type":"verse","number":5,"content":["به نجات تو خواهیم سرایید و به نام خدای خود، علم خود را خواهیم افراشت. خداوندتمامی مسالت تو را به انجام خواهد رسانید."]},{"type":"verse","number":6,"content":["الان دانسته‌ام که خداوند مسیح خود رامی رهاند. از فلک قدس خود او را اجابت خواهدنمود، به قوت نجات‌بخش دست راست خویش."]},{"type":"verse","number":7,"content":["اینان ارابه‌ها را و آنان اسبها را، اما ما نام یهوه خدای خود را ذکر خواهیم نمود."]},{"type":"verse","number":8,"content":["ایشان خم شده، افتاده‌اند و اما ما برخاسته، ایستاده‌ایم."]},{"type":"verse","number":9,"content":["‌ای خداوند نجات بده! پادشاه در روزی که بخوانیم، ما را مستجاب فرماید."]}],"footnotes":[]},"thisChapterLink":"/api/pes_pbs/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_pbs/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_pbs/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}