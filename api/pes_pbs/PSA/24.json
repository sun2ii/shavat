{"translation":{"id":"pes_pbs","name":"ترجمه قدیم","website":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseNotes":null,"shortName":"PBS","englishName":"Old Persion Version Bible","language":"pes","textDirection":"rtl","sha256":"2d3ed67dd6234bd57932b9cfbd00e7e92fa2bdb25ee068befe463f6d702f0279","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_pbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_pbs","name":"مزامیر","commonName":"مزامیر","title":"کتاب مزامیر","order":19,"numberOfChapters":150,"sha256":"43aa014925bed6cd7984b34d8f0b5f4dc8d630fdcca84e9bb79b37aae9e657fb","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_pbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_pbs/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":24,"content":[{"type":"heading","content":["دروازه های ابدی"]},{"type":"hebrew_subtitle","content":["مزمور داود"]},{"type":"verse","number":1,"content":["زمین و پری آن از آن خداوند است. ربع مسکون و ساکنان آن."]},{"type":"verse","number":2,"content":["زیرا که اواساس آن را بر دریاها نهاد. و آن را بر نهرها ثابت گردانید."]},{"type":"verse","number":3,"content":["کیست که به کوه خداوند برآید؟ وکیست که به مکان قدس او ساکن شود؟"]},{"type":"verse","number":4,"content":["او که پاک دست و صاف دل باشد، که جان خود را به بطالت ندهد و قسم دروغ نخورد."]},{"type":"verse","number":5,"content":["او برکت را ازخداوند خواهد یافت. و عدالت را از خدای نجات خود."]},{"type":"verse","number":6,"content":["این است طبقه طالبان او. طالبان روی تو‌ای (خدای ) یعقوب. سلاه."]},{"type":"verse","number":7,"content":["‌ای دروازه‌ها سرهای خود را برافرازید! ای درهای ابدی برافراشته شوید تا پادشاه جلال داخل شود!"]},{"type":"verse","number":8,"content":["این پادشاه جلال کیست؟ خداوندقدیر و جبار؟ خداوند که در جنگ جبار است."]},{"type":"verse","number":9,"content":["‌ای دروازه‌ها، سرهای خود را برافرازید! ای درهای ابدی برافرازید تا پادشاه جلال داخل شود!"]},{"type":"verse","number":10,"content":["این پادشاه جلال کیست؟ یهوه صبایوت پادشاه جلال اوست. سلاه."]}],"footnotes":[]},"thisChapterLink":"/api/pes_pbs/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_pbs/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_pbs/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}