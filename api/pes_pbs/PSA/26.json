{"translation":{"id":"pes_pbs","name":"ترجمه قدیم","website":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseNotes":null,"shortName":"PBS","englishName":"Old Persion Version Bible","language":"pes","textDirection":"rtl","sha256":"2d3ed67dd6234bd57932b9cfbd00e7e92fa2bdb25ee068befe463f6d702f0279","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_pbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_pbs","name":"مزامیر","commonName":"مزامیر","title":"کتاب مزامیر","order":19,"numberOfChapters":150,"sha256":"43aa014925bed6cd7984b34d8f0b5f4dc8d630fdcca84e9bb79b37aae9e657fb","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_pbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_pbs/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":26,"content":[{"type":"heading","content":["دعای مرد عادل"]},{"type":"hebrew_subtitle","content":["مزمور داود"]},{"type":"verse","number":1,"content":["ای خداوند مرا داد بده زیرا که من درکمال خود رفتار نموده‌ام و بر خداوندتوکل داشته‌ام، پس نخواهم لغزید."]},{"type":"verse","number":2,"content":["‌ای خداوندمرا امتحان کن و مرا بیازما. باطن و قلب مرا مصفی گردان."]},{"type":"verse","number":3,"content":["زیرا که رحمت تو در مد نظر من است ودر راستی تو رفتار نموده‌ام"]},{"type":"verse","number":4,"content":["با مردان باطل ننشسته‌ام و با منافقین داخل نخواهم شد."]},{"type":"verse","number":5,"content":["ازجماعت بدکاران نفرت می‌دارم و با طالحین نخواهم نشست."]},{"type":"verse","number":6,"content":["دستهای خود را در صفامی شویم. مذبح تو را‌ای خداوند طواف خواهم نمود."]},{"type":"verse","number":7,"content":["تا آواز حمد تو را بشنوانم و عجایب تو رااخبار نمایم."]},{"type":"verse","number":8,"content":["‌ای خداوند محل خانه تو را دوست می‌دارم و مقام سکونت جلال تو را."]},{"type":"verse","number":9,"content":["جانم را با گناهکاران جمع مکن و نه حیات مرا با مردمان خون ریز."]},{"type":"verse","number":10,"content":["که در دستهای ایشان آزار است و دست راست ایشان پر از رشوه است."]},{"type":"verse","number":11,"content":["و اما من درکمال خود سالک می‌باشم. مرا خلاصی ده و برمن رحم فرما."]},{"type":"verse","number":12,"content":["پایم در جای هموار ایستاده است. خداوند را در جماعت‌ها متبارک خواهم خواند."]}],"footnotes":[]},"thisChapterLink":"/api/pes_pbs/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_pbs/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_pbs/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}