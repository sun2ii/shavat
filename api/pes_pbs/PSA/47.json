{"translation":{"id":"pes_pbs","name":"ترجمه قدیم","website":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseNotes":null,"shortName":"PBS","englishName":"Old Persion Version Bible","language":"pes","textDirection":"rtl","sha256":"2d3ed67dd6234bd57932b9cfbd00e7e92fa2bdb25ee068befe463f6d702f0279","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_pbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_pbs","name":"مزامیر","commonName":"مزامیر","title":"کتاب مزامیر","order":19,"numberOfChapters":150,"sha256":"43aa014925bed6cd7984b34d8f0b5f4dc8d630fdcca84e9bb79b37aae9e657fb","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_pbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_pbs/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":47,"content":[{"type":"heading","content":["تسبیح خدایی که پادشاه است"]},{"type":"hebrew_subtitle","content":["برای سالار مغنیان. مزمور بنی قورح"]},{"type":"verse","number":1,"content":["ای جمیع امت‌ها دستک زنید. نزد خدابه آواز شادی بانگ برآورید."]},{"type":"verse","number":2,"content":["زیراخداوند متعال و مهیب است و بر تمامی جهان خدای بزرگ."]},{"type":"verse","number":3,"content":["قوم‌ها را در زیر ما مغلوب خواهدساخت و طایفه‌ها را در زیر پایهای ما."]},{"type":"verse","number":4,"content":["میراث مارا برای ما خواهد برگزید یعنی جلالت یعقوب راکه دوست می‌دارد، سلاه."]},{"type":"verse","number":5,"content":["خدا به آواز بلندصعود نموده است. خداوند به آواز کرنا."]},{"type":"verse","number":6,"content":["تسبیح بخوانید، خدا را تسبیح بخوانید. تسبیح بخوانید، پادشاه ما را تسبیح بخوانید."]},{"type":"verse","number":7,"content":["زیرا خدا پادشاه تمامی جهان است. به خردمندی تسبیح بخوانید."]},{"type":"verse","number":8,"content":["خدا بر امت‌ها سلطنت می‌کند. خدا بر تخت قدس خود نشسته است."]},{"type":"verse","number":9,"content":["سروران قوم‌ها با قوم خدای ابراهیم جمع شده‌اند زیرا که سپرهای جهان از آن خداست. او بسیار متعال می‌باشد."]}],"footnotes":[]},"thisChapterLink":"/api/pes_pbs/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_pbs/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_pbs/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}