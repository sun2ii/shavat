{"translation":{"id":"pes_pbs","name":"ترجمه قدیم","website":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseNotes":null,"shortName":"PBS","englishName":"Old Persion Version Bible","language":"pes","textDirection":"rtl","sha256":"2d3ed67dd6234bd57932b9cfbd00e7e92fa2bdb25ee068befe463f6d702f0279","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_pbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_pbs","name":"مزامیر","commonName":"مزامیر","title":"کتاب مزامیر","order":19,"numberOfChapters":150,"sha256":"43aa014925bed6cd7984b34d8f0b5f4dc8d630fdcca84e9bb79b37aae9e657fb","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_pbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_pbs/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":95,"content":[{"type":"heading","content":["سرود حمد و شادی"]},{"type":"verse","number":1,"content":["بیایید خداوند را بسراییم و صخره نجات خود را آواز شادمانی دهیم!"]},{"type":"verse","number":2,"content":["به حضور او با حمد نزدیک بشویم! و با مزامیر او راآواز شادمانی دهیم!"]},{"type":"verse","number":3,"content":["زیرا که یهوه، خدای بزرگ است،"]},{"type":"verse","number":4,"content":["و پادشاه عظیم بر جمیع خدایان. نشیبهای زمین در دست وی است و فرازهای کوهها از آن او."]},{"type":"verse","number":5,"content":["دریا از آن اوست، او آن رابساخت؛ و دستهای وی خشکی را مصور نمود."]},{"type":"verse","number":6,"content":["بیایید عبادت و سجده نماییم و به حضورآفریننده خود خداوند زانو زنیم!"]},{"type":"verse","number":7,"content":["زیرا که اوخدای ما است! و ما قوم مرتع و گله دست اومی باشیم! امروز کاش آواز او را می‌شنیدید!"]},{"type":"verse","number":8,"content":["دل خود را سخت مسازید، مثل مریبا، مانند یوم مسا در صحرا."]},{"type":"verse","number":9,"content":["چون اجداد شما مرا آزمودند وتجربه کردند و اعمال مرا دیدند."]},{"type":"verse","number":10,"content":["چهل سال ازآن قوم محزون بودم و گفتم: «قوم گمراه دل هستند که طرق مرا نشناختند."]},{"type":"verse","number":11,"content":["پس در غضب خود قسم خوردم، که به آرامی من داخل نخواهند شد.»"]}],"footnotes":[]},"thisChapterLink":"/api/pes_pbs/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_pbs/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_pbs/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}