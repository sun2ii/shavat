{"translation":{"id":"pes_pbs","name":"ترجمه قدیم","website":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pesOPV","licenseNotes":null,"shortName":"PBS","englishName":"Old Persion Version Bible","language":"pes","textDirection":"rtl","sha256":"2d3ed67dd6234bd57932b9cfbd00e7e92fa2bdb25ee068befe463f6d702f0279","availableFormats":["json"],"listOfBooksApiLink":"/api/pes_pbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"فارسی","languageEnglishName":"Persian"},"book":{"id":"PSA","translationId":"pes_pbs","name":"مزامیر","commonName":"مزامیر","title":"کتاب مزامیر","order":19,"numberOfChapters":150,"sha256":"43aa014925bed6cd7984b34d8f0b5f4dc8d630fdcca84e9bb79b37aae9e657fb","firstChapterNumber":1,"firstChapterApiLink":"/api/pes_pbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pes_pbs/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":98,"content":[{"type":"heading","content":["سرود تازه"]},{"type":"hebrew_subtitle","content":["مزمور"]},{"type":"verse","number":1,"content":["برای خداوند سرود تازه بسرایید زیراکارهای عجیب کرده است. دست راست و بازوی قدوس او، او را مظفر ساخته است."]},{"type":"verse","number":2,"content":["خداوند نجات خود را اعلام نموده، وعدالتش را به نظر امت‌ها مکشوف کرده است."]},{"type":"verse","number":3,"content":["رحمت و امانت خود را با خاندان اسرائیل به یادآورد. همه اقصای زمین نجات خدای ما رادیده‌اند."]},{"type":"verse","number":4,"content":["‌ای تمامی زمین، خداوند را آواز شادمانی دهید. بانگ زنید و ترنم نمایید و بسرایید."]},{"type":"verse","number":5,"content":["خداوند را با بربط بسرایید! با بربط و با آوازنغمات!"]},{"type":"verse","number":6,"content":["با کرناها و آواز سرنا! به حضور یهوه پادشاه آواز شادمانی دهید!"]},{"type":"verse","number":7,"content":["دریا و پری آن بخروشد! ربع مسکون و ساکنان آن!"]},{"type":"verse","number":8,"content":["نهرهادستک بزنند! و کوهها با هم ترنم نمایند."]},{"type":"verse","number":9,"content":["به حضور خداوند زیرا به داوری جهان می‌آید. ربع مسکون را به انصاف داوری خواهد کرد و قومهارا به راستی."]}],"footnotes":[]},"thisChapterLink":"/api/pes_pbs/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pes_pbs/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pes_pbs/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}