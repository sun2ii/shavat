{"translation":{"id":"pib_wbt","name":"Gerotu Tokanchi Gipiratkaluru","website":"https://ebible.org/Scriptures/details.php?id=pibNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pibNT","licenseNotes":null,"shortName":"WBT","englishName":"Yine NT","language":"pib","textDirection":"ltr","sha256":"33418da9437d3c58c89735ce1e23791066b6d7940496d158d44fd042839c24d0","availableFormats":["json"],"listOfBooksApiLink":"/api/pib_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7954,"languageName":"Yine","languageEnglishName":"Yine"},"book":{"id":"HEB","translationId":"pib_wbt","name":"Gewreyone","commonName":"Gewreyone","title":"Gewreyone Chinanu","order":58,"numberOfChapters":13,"sha256":"b1464d1da7fca5a0edb19c52f724e99c70b550247c951d518a48a834af5649ac","firstChapterNumber":1,"firstChapterApiLink":"/api/pib_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/pib_wbt/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Goyakalu goyaknu gatajiwniyachri"]},{"type":"verse","number":1,"content":["Muchikawa Goyakalu gixo kata ga wa pnumnu rixa giynumsaletna wutsrukatenni tokanchi geneklewatachinniya."]},{"type":"verse","number":2,"content":["Tye ralipregognekaka, Gituruya ruynumsatyawu. Walenwa rutakanru ptowrunanuka yoptotachripa. Waleya koxa psolchijnemnunanukaaka kamruta."]},{"type":"verse","number":3,"content":["Psolpotuyako Ruru goyaknu ratajiwniya. Wale pixkapotuko rixa, ga wa ptowrupotunanuka yostatachri ruyakle tokanuya. Wa powratmukochiretinitkawu, teno Gajeru kgoyagknuru potuklesretate tuplata."]},{"type":"verse","number":4,"content":["Goyakalutowrerune pnuterutu rixpotutatka, gi rixanu yoptogiwakatachri kiglepotlu wanna giwaka pnute."]},{"type":"heading","content":["Tsrunwa Geso Goyakalutowrerune pnute"]},{"type":"verse","number":5,"content":["Gi rixanu gi pagogneko gi satu gitowreru wane china Goyakalu:",{"text":"“Noturyi Pixa; tyegogne nwugenetyi.”","poem":1},"Ga wa wanepnute:",{"text":"“Rurupno Gita ga wa Walepni Noturu.”","poem":1}]},{"type":"verse","number":6,"content":["Ga wa wanepnute wa tyechijne ranikinitkalu muchinanu tsru Gituru, wane china:",{"text":"“Pejnuruneko Goyakalutowrerune yoptsojityegitanru.”","poem":1}]},{"type":"verse","number":7,"content":["Ga wa gitowrene wane chinpiranyegita:",{"text":"Giwekikalurune kamrutna gitowrene","poem":1},{"lineBreak":true},{"text":"ga wa kamrurewyegitjene katmerolkaka rixkaka.","poem":1}]},{"type":"verse","number":8,"content":["Seyni wa Gituru wane china:",{"text":"“Pogirewle tuplapijere, Goyakalu,","poem":1},{"text":"gwagognenatachripni gike rixiniko mnikawnakatupni.","poem":2},{"text":"Ga wa pogirewatyawaka kanojere,","poem":1},{"text":"poyagkaklewlu kanojerni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pushiniklu poyagkaklewlu,","poem":1},{"text":"ga wa payegixlu mukochri.","poem":2},{"lineBreak":true},{"text":"Giyagni Goyakalu, Poyakalute,","poem":2},{"text":"giyokgogotyi tsru gimjiklungi","poem":1},{"text":"pupxalune pnute.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ga wa","poem":1},{"lineBreak":true},{"text":"yinuwakikowakaya Pixa, Gitsrukaachi,","poem":1},{"text":"pekamruretlu psolchijneko.","poem":2},{"lineBreak":true},{"text":"Ga wa tengogne pumyo kamrutikalurni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tyekakapni nikawnanuna,","poem":1},{"lineBreak":true},{"text":"seyni Pixa gwagognenatanu.","poem":1},{"text":"Pejnurkakako mkachri pixka rutsrugananumtanu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ga wa sapwaklu pixka psaprurukanru.","poem":1},{"lineBreak":true},{"text":"Ga wa mkachri pixka kashrijetikolupa.","poem":1},{"lineBreak":true},{"text":"Seyni Pixa pixyawakakni Pixa.","poem":1},{"lineBreak":true},{"text":"Ga wa pwalaputkaka gi nikawnanu.”","poem":1}]},{"type":"verse","number":13,"content":["Gi rixanu gi pagogneko gi wane chinru satu gitowreru:",{"text":"“Npotuklesretate ptuplatanu,","poem":1},{"text":"pkamnixjene nutakinpotunanuko","poem":2},{"lineBreak":true},{"text":"pujixi gitspangaprepa.”","poem":2}]},{"type":"verse","number":14,"content":["Ga wa pejnuruneko giwekikalurune kamrurewaklerunni Goyakalu yokanata rupxakjetyapna gognewatikaluru yoptotachinepa."]}],"footnotes":[]},"thisChapterLink":"/api/pib_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pib_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pib_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}