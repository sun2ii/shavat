{"translation":{"id":"pib_wbt","name":"Gerotu Tokanchi Gipiratkaluru","website":"https://ebible.org/Scriptures/details.php?id=pibNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pibNT","licenseNotes":null,"shortName":"WBT","englishName":"Yine NT","language":"pib","textDirection":"ltr","sha256":"33418da9437d3c58c89735ce1e23791066b6d7940496d158d44fd042839c24d0","availableFormats":["json"],"listOfBooksApiLink":"/api/pib_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7954,"languageName":"Yine","languageEnglishName":"Yine"},"book":{"id":"HEB","translationId":"pib_wbt","name":"Gewreyone","commonName":"Gewreyone","title":"Gewreyone Chinanu","order":58,"numberOfChapters":13,"sha256":"b1464d1da7fca5a0edb19c52f724e99c70b550247c951d518a48a834af5649ac","firstChapterNumber":1,"firstChapterApiLink":"/api/pib_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/pib_wbt/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["Tengogne gajeru kpashiwakapji Sasertotete"]},{"type":"verse","number":1,"content":["Tyepirana gonra wane chinkalurkaka: Tye pixkalutu sasertote Gitsrukate potu waneywu. Walenwa tsru potu tengogne gajeru tuplapijere potuklesretate tuplatachri."]},{"type":"verse","number":2,"content":["Kpashiwaka ga wa Goyakalupji potu kamrurewatyachrini, wa Gitsrukaachi panatanruni. Gi wa yineru panatanruni."]},{"type":"verse","number":3,"content":["Gi rixanu pejnuruneko sasertote gitsrukatene potu gitaaka ranikyapluna genekashlukaka ga wa giylatkalurkaka. Giyagni galuukalurni waneya rixinripa tye Sasertote koxa pagixanu ranikinripa."]},{"type":"verse","number":4,"content":["Giyagni tyechijne gwachri rixkamka, gimka sasertotepni, gi rixanu wanena genekashlukaka ganikachine wa Tokanchi Yokanatkaluru chinyawaka."]},{"type":"verse","number":5,"content":["Tengogne gajerkaka yaglu ga wa mayawle kamrurewatyana wanna, wa Goyakalu gixa yokanretyawaklu Moysisi, wa wale kamrutinripatka Goyakalupji. Wane chinru:",{"text":"“Petpotutanru, wanepotuko pkamrutinripa yaglu pixka, magka pekakgitikolu pixka.”","poem":1}]},{"type":"verse","number":6,"content":["Ga wa xani Kristo gapkapatkalu wanepnute kigleru potu kamrurchi, wane rixa kigleru potu Gipiratkaluru Tokanchi chinanu kgiglepokyegiklerni. Wanepnute kigleru gipiratkalurkakapiranaya gitaakaluru."]},{"type":"verse","number":7,"content":["Gi rixanu wa muchinanu Tokanchi Gipiratkaluru ma magatkanumka, gimka galuukalurni wa gepi chininri."]},{"type":"verse","number":8,"content":["Gi rixanu ruklukanuwnakakinna, Goyakalu wane china:",{"text":"“Getanu. Gigogne ginanu,”","poem":1},{"lineBreak":true},{"text":"china wa Gitsrukaachi,","poem":1},{"lineBreak":true},{"text":"“Gerotu gipiratkaluru tokanchi nupiratinna","poem":1},{"lineBreak":true},{"text":"Gisrayiliklopishane ga wa Gotaklopishane.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“Gi wa gipiratkaluru tokanchi pixka","poem":1},{"lineBreak":true},{"text":"Wa nupiratyana wa rutsrukatennina","poem":1},{"text":"Walegogneni wa nkosemyomtna","poem":2},{"lineBreak":true},{"text":"wa Gigiptochijne nkoshpakyapna.","poem":2},{"text":"Gi rixanu wannani gi gomkagitlu","poem":1},{"text":"nupiratanru tokanchi.","poem":2},{"text":"Ga wa Gita gi wa nuslagyana,”","poem":1},{"lineBreak":true},{"text":"wane china Gitsrukaachi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"“Wanepnute ruknoogognetinitka walegognekaka,","poem":1},{"lineBreak":true},{"text":"tyepni wa gipiratkaluru tokanchi,","poem":1},{"text":"wa Gisrayiliklopishane nupiratinri,”","poem":2},{"text":"china wa Gitsrukaachi.","poem":1},{"lineBreak":true},{"text":"“Ginshinikanna nutakinna ntokankaka","poem":1},{"text":"yokanatkaluru.","poem":2},{"text":"Wale nyongajitanna.","poem":1},{"lineBreak":true},{"text":"Gitapni wa Royakalutna.","poem":1},{"lineBreak":true},{"text":"Wannapni wa nayinerutene.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"“Gi wa satkaka yimakanru gipokchi gajeru,","poem":1},{"lineBreak":true},{"text":"Gi wa satkaka gimoleneko,","poem":1},{"text":"wane chinachrimka,","poem":2},{"text":"‘Pumatanru Gitsrukaachi’.","poem":1},{"text":"Gi rixanu pejnuruneko gimatanutkano,","poem":2},{"lineBreak":true},{"text":"mturu potu ga wa tsrupotuymananuko.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gi rixanu kgetwamonuklerupno","poem":1},{"text":"ma poyagkaklewleyna.","poem":2},{"text":"Gi wa nushinikanutkalu mukochirna.”","poem":1}]},{"type":"verse","number":13,"content":["Wa gerotu chininri, kapokotu rixkaklu muchinanu chininri. Wa kapokotu ga wa tsrutsoleji gixachrinatka psotsotaji magata ramgamtinripa."]}],"footnotes":[]},"thisChapterLink":"/api/pib_wbt/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pib_wbt/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pib_wbt/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}