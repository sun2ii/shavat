{"translation":{"id":"pjt_bsa","name":"Tjukurpa Palya","website":"https://ebible.org/Scriptures/details.php?id=pjt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pjt","licenseNotes":null,"shortName":"BSA","englishName":"Pitjantjatjara Shorter Bible","language":"pjt","textDirection":"ltr","sha256":"753af00d5e7208d9438dce5b3e4a1ee992693624cf52cf8f0eee4ac512f64648","availableFormats":["json"],"listOfBooksApiLink":"/api/pjt_bsa/books.json","numberOfBooks":44,"totalNumberOfChapters":489,"totalNumberOfVerses":10980,"languageName":"Pitjantjatjara","languageEnglishName":"Pitjantjatjara"},"book":{"id":"PSA","translationId":"pjt_bsa","name":"Psalm","commonName":"Psalm","title":"Inma Psalm Tjuṯa Psalms","order":19,"numberOfChapters":19,"sha256":"3228c93f596b05794bbc915b7a52f681253c0adff300d10dc9d5e7d45e24ec9e","firstChapterNumber":1,"firstChapterApiLink":"/api/pjt_bsa/PSA/1.json","lastChapterNumber":146,"lastChapterApiLink":"/api/pjt_bsa/PSA/146.json","totalNumberOfVerses":180},"chapter":{"number":131,"content":[{"type":"verse","number":1,"content":[{"text":"Mayatja, ngayulu nyuntumpa kutjuku puḻkaṟa mulamularinganyi.","poem":1},{"text":"Munuṉatju walytjangku ngayulu kaṉany-kaṉanytju puḻkanmankupai wiya.","poem":2},{"text":"Nyuntu panya puḻka mulapa palyalpai,","poem":1},{"text":"kaṉa puṯu kulilpai.","poem":2},{"text":"Tjinguṟuṉa arkaṟampa puṯu palyanma,","poem":1},{"text":"panya nyuntu kutjungku nyanga puṟunypa palyalpai nintingku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Uwa, puṯuṉa kulilpai.","poem":1},{"text":"Palu palya, kurunpaṉi pukuḻpaṯu ngaṟanyi tjitji tjukutjuku puṟunypa,","poem":2},{"lineBreak":true},{"text":"panya ngunytjungku ampuṟa kanyinnyangka pilunpa ngaripai, palu puṟunypa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ka nyura Israelkunu tjuṯa Mayatja Godaku kutjuku mulamularingama.","poem":1},{"text":"Munuya tiṯutjarangku palunya kutju mulamulangku kulinma.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pjt_bsa/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pjt_bsa/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pjt_bsa/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":3}