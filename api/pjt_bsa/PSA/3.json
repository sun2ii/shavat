{"translation":{"id":"pjt_bsa","name":"Tjukurpa Palya","website":"https://ebible.org/Scriptures/details.php?id=pjt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pjt","licenseNotes":null,"shortName":"BSA","englishName":"Pitjantjatjara Shorter Bible","language":"pjt","textDirection":"ltr","sha256":"753af00d5e7208d9438dce5b3e4a1ee992693624cf52cf8f0eee4ac512f64648","availableFormats":["json"],"listOfBooksApiLink":"/api/pjt_bsa/books.json","numberOfBooks":44,"totalNumberOfChapters":489,"totalNumberOfVerses":10980,"languageName":"Pitjantjatjara","languageEnglishName":"Pitjantjatjara"},"book":{"id":"PSA","translationId":"pjt_bsa","name":"Psalm","commonName":"Psalm","title":"Inma Psalm Tjuṯa Psalms","order":19,"numberOfChapters":19,"sha256":"3228c93f596b05794bbc915b7a52f681253c0adff300d10dc9d5e7d45e24ec9e","firstChapterNumber":1,"firstChapterApiLink":"/api/pjt_bsa/PSA/1.json","lastChapterNumber":146,"lastChapterApiLink":"/api/pjt_bsa/PSA/146.json","totalNumberOfVerses":180},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Inma nyangatja Davidalu walkatjunkunytja panya paluṟu palumpa katja Absalomalanguṟu nguḻu wirtjapakantjatjanungku."]},{"type":"verse","number":1,"content":[{"text":"Mayatja, aṉangu panya tjuṯa mulapa ngayuku kuraringanyi,","poem":1},{"text":"munuṉiya kuwari winkingku pikangku wataparaṉi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tjana kunyu anaṟa wangkapai ngayunyatjara alatji,","poem":1},{"text":"“Godalu palunya wankaṟunkunytja wiya alatjiṯu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Palu Mayatja, nyuntun ngayunya kuṯitji puṟunytju anga-kanyilpai.","poem":1},{"text":"Munuṉin ngayunya witulyankupai tjananya pungkula waintarinytjaku,","poem":2},{"lineBreak":true},{"text":"munuṉin rapa ngaṟanytjaku palyalpai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Panya ngayulu nyuntula ulara tjapilpai wankaṟunkunytjaku,","poem":1},{"text":"ka nyuntu mulapaṯu ngayunya puḻi miḻmiḻṯanguṟu alpamilalpai ngura pala Tjayantanguṟu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mayatja, nyuntu panyan ngayunya aṯunymaṟa kanyilpai,","poem":1},{"text":"kaṉa mungangka wiṟuṟa kunkunaripai","poem":2},{"lineBreak":true},{"text":"munuṉa mungawinki wankaringkula pukuḻpa pakalpai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngayuku mirpaṉtju mungilyingkuṉiya para-angatjuṟa waṉaṟa pikangku wataparaṉi.","poem":1},{"text":"Palu ngayulu tjanampa nguḻuringkunytja wiya rapa alatjiṯu ngaṟanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mayatja God, pitjalaṉitju wankaṟunama!","poem":1},{"lineBreak":true},{"text":"Munu ngayuku nyanga mirpaṉtju tjuṯa kaṯiṯi pungkula minya-minyanma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mayatja, nyuntu panya nyuntumpa walytja tjuṯa wankaṟu kanyilpai.","poem":1},{"text":"Wanyu tjananya mukulyangku pukuḻmanama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pjt_bsa/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pjt_bsa/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pjt_bsa/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":8}