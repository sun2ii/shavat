m":2},{"text":"Munak kopar kat tounah en viau tas, kilea vamaat.","poem":1},{"text":"Ka munak kovitein viau etel, koanek keih avatali kotehei.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":4}