{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"ISA","translationId":"pma_wbt","name":"Aesea","commonName":"Aesea","title":"Aesea","order":23,"numberOfChapters":14,"sha256":"b763e2b4b3ff8a3c88b3ba61660e5c32ee9908cfce160394922c159da68d46d6","firstChapterNumber":6,"firstChapterApiLink":"/api/pma_wbt/ISA/6.json","lastChapterNumber":64,"lastChapterApiLink":"/api/pma_wbt/ISA/64.json","totalNumberOfVerses":109},"chapter":{"number":49,"content":[{"type":"verse","number":5,"content":["Meatin toumien onen Iahova viteni vit,",{"text":"“Mulamu, navong arvasitei nau mau,","poem":1},{"text":"Iahova rie lat nau tuai keke mahi meatin toumien onen.","poem":2},{"text":"Anatin, rie lat nau malah ris me-Isrel keil","poem":1},{"text":"koa amul soutin rani.","poem":2},{"text":"Iahova vati lat inau,","poem":1},{"text":"ka keihoen onak ka veni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iahova viteni minau vit,","poem":1},{"lineBreak":true},{"text":"“Keik kovi meatin toumien onak","poem":1},{"text":"ka kumon tounah keil koa hemariso mok.","poem":2},{"text":"Anatin, kilah ris me-Isrel keil koa aka rasil ka amoul veah,","poem":1},{"text":"keil imai ris ito en atan kati one.","poem":2},{"text":"Ka koa hetetamen imok, nisakinuk kimai kihi laet tai","poem":1},{"text":"koa hetitin revi heha en kantri vasi keil,","poem":2},{"lineBreak":true},{"text":"keke meatin vasi keil ilea suk keke sise ten mututien onen Ahi mai rokol meatin vasi keil ten out netan.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":2}