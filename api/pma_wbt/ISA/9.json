{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"ISA","translationId":"pma_wbt","name":"Aesea","commonName":"Aesea","title":"Aesea","order":23,"numberOfChapters":14,"sha256":"b763e2b4b3ff8a3c88b3ba61660e5c32ee9908cfce160394922c159da68d46d6","firstChapterNumber":6,"firstChapterApiLink":"/api/pma_wbt/ISA/6.json","lastChapterNumber":64,"lastChapterApiLink":"/api/pma_wbt/ISA/64.json","totalNumberOfVerses":109},"chapter":{"number":9,"content":[{"type":"verse","number":6,"content":[{"text":"“Anatin, tivava tai, ihasi ven ir.","poem":1},{"text":"Ehon koanek, Ahi hesani min ir.","poem":2},{"lineBreak":true},{"text":"Losilkatien vasi keil hel en hen.","poem":2},{"text":"Ihise en ‘More Meatin Tatie Sise en,’","poem":1},{"text":"‘Ahi ten Keihoen,’ ‘Ahi Tamer koa mul lisenges,’","poem":2},{"lineBreak":true},{"text":"ka ‘Hetetamen ten Tomat.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Losilkatien onen hemai hekeih imok.","poem":1},{"text":"Anatin, en hen, meatin keil vasi ito en tomat lisenges.","poem":2},{"text":"Losilkatien onen hesuval losilkatien onen asuv houlu Deved mulamu.","poem":1},{"text":"Kei hetondan en vulin ten keihoen onen","poem":2},{"lineBreak":true},{"text":"ka helei revi usite onen meatin keil ka houmoni hemal en keil.","poem":2},{"text":"Ka losilkatien onen hel lisenges","poem":1},{"text":"hetokol keite ten out netan.","poem":2},{"text":"Iahova, asuv houlu ten out nesa, en vati mok voumon koanek","poem":1},{"text":"veni envatien onen min ir marite mok.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":2}