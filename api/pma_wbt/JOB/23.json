{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"JOB","translationId":"pma_wbt","name":"Siob","commonName":"Siob","title":"Siob","order":18,"numberOfChapters":17,"sha256":"25f5837f7e7aa58fa15c0d048c33f569cf9237bedc918004e9280bce1c80a93e","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/pma_wbt/JOB/42.json","totalNumberOfVerses":173},"chapter":{"number":23,"content":[{"type":"heading","content":["Siob vit leini keke romumontei tounah koa tisa vasakini vales mahien onen"]},{"type":"verse","number":1,"content":["Siob vit kesi min keitel vit,"]},{"type":"verse","number":2,"content":[{"text":"“Avaseini mitviten sa minau, niles niselus kutut kat Ahi hekeih,","poem":1},{"text":"nasakras mahuli kat mahisien onak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hit eli varei mailea out mahotin Ahi ien","poem":1},{"text":"keke mailea maha en out kei ro ien.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vamukonek, mahit lein tounah keil en usite onak mini,","poem":1},{"text":"ka mahit kilea anatinien ten selusien keil onak mini.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ek vati mailea asa hehiteni,","poem":1},{"text":"ka kei hehit kesi minau hemukave.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"?Mukave, Ahi hesa vasi keihoen onen heha kat nau?","poem":1},{"text":"Vuo, helong nau navong niselus.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"En meten Ahi, meatin koa mutolas kilea vaselus retavoai vatal mini.","poem":1},{"text":"Kei hehitehiteni keke inau narmumon etai tounah vatisa keke meatin keil avalong kilea.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":7}