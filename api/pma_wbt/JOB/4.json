{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"JOB","translationId":"pma_wbt","name":"Siob","commonName":"Siob","title":"Siob","order":18,"numberOfChapters":17,"sha256":"25f5837f7e7aa58fa15c0d048c33f569cf9237bedc918004e9280bce1c80a93e","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/pma_wbt/JOB/42.json","totalNumberOfVerses":173},"chapter":{"number":4,"content":[{"type":"heading","content":["Elivas sel kat Siob ven selkututien onen"]},{"type":"verse","number":1,"content":["Evus, Elivas ten out Teman mea ka viteni min Siob vit,"]},{"type":"verse","number":2,"content":[{"text":"“?Munak niselus minuk, kivuroh?","poem":1},{"text":"Veni nasakras emun mato raeng.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Keik kovisein meatin keil houlu","poem":1},{"text":"ka kosan keihoen min koakeil he memerau.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Navong meatin tai mot vuo aven memerau vuo aven litu,","poem":1},{"text":"selusien onom katauni, ka kei mulomal eris.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ka kosa, vi avong onom komul en mahien,","poem":1},{"text":"ka keik korvinvintei kovahisu vatali.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Munak hehi anatin keke keik kuva netan min Ahi ka moulien onom mutolas en meten,","poem":1},{"text":"hesakin desien onom hel ka demkoen hetovuol enuk.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kosa, kindem usili.","poem":1},{"text":"?Meatin koa sakien onen mutolas","poem":2},{"lineBreak":true},{"text":"kilea vakur matien koa tisa? !Vuo!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inau nales koanik: meatin koa kil atan ten tisaen ka luh utiai keil tasakkalkalien ien,","poem":1},{"text":"kosa keil akur hei sakkalkalien ka hei tisaen.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Suval angu tai,","poem":1},{"text":"Ahi mu lin keil en vurohien onen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}