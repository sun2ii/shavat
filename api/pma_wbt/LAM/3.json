{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"LAM","translationId":"pma_wbt","name":"Rangisien","commonName":"Rangisien","title":"Rangisien","order":25,"numberOfChapters":3,"sha256":"a26f3355e3f6511b74e7bb2ec4b53924e04076c7fc00c9642173d8e191d9a1a5","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/LAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/pma_wbt/LAM/3.json","totalNumberOfVerses":10},"chapter":{"number":3,"content":[{"type":"verse","number":19,"content":[{"text":"Ka navong namundem usil tounah keil koa purunau kosa,","poem":1},{"text":"ka mukave tounah onak tovuol suval meatin tai koa out kati onen tovuol,","poem":2},{"lineBreak":true},{"text":"kun en moulien onak suval oai ten measen koa kun.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Rendemien keil ekek mul en moulien onak lises,","poem":1},{"text":"ka tinok mul mis veni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ka avaseini, navong narendem sakien onen Iahova,","poem":1},{"text":"mumonau namundem usil asa koa hemai hetal sien.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nakilea keke envatien onen hel lisenges, ka sakras vavus.","poem":1},{"text":"Ka enmahisien onen emun, keite teni hetovuol.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Keilu luvi heite hau en visokon vasi.","poem":1},{"text":"Hatkatien keil onen, kei mum vasi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Avaseini tounah onak tovuol,","poem":1},{"text":"demkatien onak keih en Iahova koa tahos imok mulin tounah keil vasi ten out netan.","poem":2},{"lineBreak":true},{"text":"Sakini, naling desien onak en kei enges.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Iahova mumoni tahos min koakeil aling desien one en kei,","poem":1},{"text":"min koakeil amul amusili.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Sakini, tahos keke ir reheto raeng,","poem":1},{"text":"ka rehetosin avong koa Iahova hemai houtut moulien orer.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/EZK/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}