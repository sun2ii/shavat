{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PRO","translationId":"pma_wbt","name":"Proveb","commonName":"Proveb","title":"Proveb","order":20,"numberOfChapters":15,"sha256":"b42a14310f0bb7d5832b3f693f41e567afcde48d7d2d1783257f68d5823adeba","firstChapterNumber":3,"firstChapterApiLink":"/api/pma_wbt/PRO/3.json","lastChapterNumber":31,"lastChapterApiLink":"/api/pma_wbt/PRO/31.json","totalNumberOfVerses":82},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Navong kosa kes selusien en sakien ten merauen, koanek hesakin vurohien heha netan.","poem":1},{"text":"Ka selusien takeih hesakin tin meatin sav heatiat.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Navong meatin koa vi meteisau selus, meatin sav keil asi keil avakur ileilien rani,","poem":1},{"text":"ka varu keil ason kalah en selusien koa vi varu enges.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Meatin koa tin tamurei mumon selkututien houlu,","poem":1},{"text":"ka kei koa merau mumon tin meatin va netan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Lingkatien keil onom hemai hetisa munak kirvistei meteisauen ran meatin sav keil,","poem":1},{"text":"ka munak kihis meteisauen, keik kiles heite teni koa hetahos.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":4}