{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PRO","translationId":"pma_wbt","name":"Proveb","commonName":"Proveb","title":"Proveb","order":20,"numberOfChapters":15,"sha256":"b42a14310f0bb7d5832b3f693f41e567afcde48d7d2d1783257f68d5823adeba","firstChapterNumber":3,"firstChapterApiLink":"/api/pma_wbt/PRO/3.json","lastChapterNumber":31,"lastChapterApiLink":"/api/pma_wbt/PRO/31.json","totalNumberOfVerses":82},"chapter":{"number":24,"content":[{"type":"heading","content":["Meteisauen usil sakien onen taripeng keil"]},{"type":"verse","number":30,"content":[{"text":"Inau, namual en sise vesesal en ah osen taripeng tai,","poem":1},{"text":"ka naka vasi neiai osen varu tai.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nalesi keke oumunai tatisa keil amusar koe ka viau tatisa keil apar vini.","poem":1},{"text":"Nalesi keke vieh teni mahoiahoi mules mukonek.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Munak nalesi mukonek, namundem usili,","poem":1},{"text":"ka koanek viseinau en tounah tai.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Munak em vati kovamatil lisenges, tahosis, kiles kimatil.","poem":1},{"text":"Kiha kihotin more out koa mandil ka kiseh revi ien.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ka navong komul komatil veah, tounah vasi keil onom hevupuol ranuk hesuval tarhena tai mai venani ranuk.","poem":1},{"text":"Anatin, kitimanin kimai kihi heite hon.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":5}