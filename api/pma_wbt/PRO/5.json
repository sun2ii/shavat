{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PRO","translationId":"pma_wbt","name":"Proveb","commonName":"Proveb","title":"Proveb","order":20,"numberOfChapters":15,"sha256":"b42a14310f0bb7d5832b3f693f41e567afcde48d7d2d1783257f68d5823adeba","firstChapterNumber":3,"firstChapterApiLink":"/api/pma_wbt/PRO/3.json","lastChapterNumber":31,"lastChapterApiLink":"/api/pma_wbt/PRO/31.json","totalNumberOfVerses":82},"chapter":{"number":5,"content":[{"type":"heading","content":["Selkatien va kat sakien ten hoeasoen"]},{"type":"verse","number":15,"content":[{"text":"Keik koa koretalihe, kitie lat envatien onom min ahin onom","poem":1},{"text":"ka kito hetal min kei enges.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"?Mukave? ?Tahos keke kiha kiles ahin sav keil?","poem":1},{"text":"?Mal keke kiha kisan asa koa vi onen ahin kati onom min teisav keil? !Vuo!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tahosien ten tetaliheien onamil enges.","poem":1},{"text":"Rovitei tounah koa kokilea kovasan heisav eni min mesav keil.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hetahos imok kisik ven ahin koa koretalihe ral mini mai vi asom navong kovi meatin hau veah,","poem":1},{"text":"ka kitos en sien hetal mini lisenges.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kimaen kei sasen hesakinuk kilonge hetahos lises.","poem":1},{"text":"Kihi vau en aven ahin onom enges ka kisik ven envatien onen.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"?Natkuli, vensa kitie lat envatien onom en ahin koa vi hoeaso tai?","poem":1},{"text":"?Vensa kiles aven ka kindemi keke kei tahos imok mulin ahin kati onom? !Konomontei vamukonek!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}