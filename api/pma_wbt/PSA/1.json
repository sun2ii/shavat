{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PSA","translationId":"pma_wbt","name":"Sam","commonName":"Sam","title":"Sam keil","order":19,"numberOfChapters":50,"sha256":"c7ecdc7662905f07dca188bd816068f226853a91ec19b8db23b2b62737c08783","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pma_wbt/PSA/150.json","totalNumberOfVerses":634},"chapter":{"number":1,"content":[{"type":"heading","content":["Sien onen koakeil ualien one mal"]},{"type":"verse","number":1,"content":[{"text":"Sien hel en koakeil:","poem":1},{"text":"asesein rendemien koa meatin tatisa keil amul asani;","poem":2},{"lineBreak":true},{"text":"armusiltei sakien onen meatin tisa keil,","poem":2},{"lineBreak":true},{"text":"vuo arkapiltei vatal koakeil amumon tohtohien en tounah keil onen Ahi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vuo, keil avotin sien","poem":1},{"text":"navong along kat mengkatien onen Ahi,","poem":2},{"lineBreak":true},{"text":"meneai ka vongien, amundem usili.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Keil asuval vatiai koa mul en vali oai,","poem":1},{"text":"son heite mal en avong teni,","poem":2},{"lineBreak":true},{"text":"ka oute sakras varei vakou.","poem":2},{"text":"Tounah vasi koa amumoni tahos imok.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ka meatin tatisa keil armukteinek.","poem":1},{"text":"Keil asuval sume uit koa rotahostei koa eang mul muh lini ran aneite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sakini, Ahi hesan mahien min meatin tatisa keil,","poem":1},{"text":"irtotei hetal koakeil ualien one tahos.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ven koakeil ualien one tahos,","poem":1},{"text":"Ahi helosil kat keil ka hekur koe keil.","poem":2},{"text":"Ka koakeil ualien one tisa, amul en sise ten matien.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}