{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PSA","translationId":"pma_wbt","name":"Sam","commonName":"Sam","title":"Sam keil","order":19,"numberOfChapters":50,"sha256":"c7ecdc7662905f07dca188bd816068f226853a91ec19b8db23b2b62737c08783","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pma_wbt/PSA/150.json","totalNumberOfVerses":634},"chapter":{"number":121,"content":[{"type":"heading","content":["Iahova vi out tatosuaien orer"]},{"type":"verse","number":1,"content":[{"text":"Nalele vina nesa en vatihou keil ka navit,","poem":1},{"text":"“?Kataunien hemai minau heka kave?”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nakilea keke kataunien hemai minau heka ven Iahova,","poem":1},{"text":"kei koa mumon out nesa ka out netan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kei hermaen etai tounah vakula kami,","poem":1},{"text":"mul ring koe kami ka romatiltei.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kei koa mul lei kokoe en me-Isrel keil,","poem":1},{"text":"rolongtei metalong.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iahova vi eikokoe onami.","poem":1},{"text":"Kei heto en usite matu onami keke tounah hetovuol vapurun kami.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"En meneai, meteiai sakras van vini kami,","poem":1},{"text":"ka en vongien, avati sakras vapurun kami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iahova heting koe moulien onami keke tounah keil tatisa napuruntei kami.","poem":1},{"text":"Kei heav koe kami hetal hen keke tounah sakras vamai vakula kami.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"En ualien keil onami, kei helei kat revi kami en usite vasi keil,","poem":1},{"text":"kosa ka lisenges.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PSA/135.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":8}