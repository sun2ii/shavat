{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PSA","translationId":"pma_wbt","name":"Sam","commonName":"Sam","title":"Sam keil","order":19,"numberOfChapters":50,"sha256":"c7ecdc7662905f07dca188bd816068f226853a91ec19b8db23b2b62737c08783","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pma_wbt/PSA/150.json","totalNumberOfVerses":634},"chapter":{"number":136,"content":[{"type":"heading","content":["Rehemasmas Iahova ven tounah keil koa kei mumoni"]},{"type":"verse","number":1,"content":[{"text":"Mihemasmas Iahova veni kei tahos.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":2,"content":[{"text":"Mihemasmas Ahi koa mulin ahi sav keil.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":3,"content":[{"text":"Mihemasmas Ahi Asuv koa mulin asuv sav keil.","poem":1},"Envatien onen hel lisenges."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kei sasen enges mumon mari tounah keil.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":5,"content":[{"text":"Ka en ileilien onen, kei mumon out nesa.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":6,"content":[{"text":"Kei varei sakin out netan mea ran atas.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":7,"content":[{"text":"Kei mumon tounah vasi keil koa ritin en teilang.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":8,"content":[{"text":"Ling meteiai keke valosil kat meneai.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":9,"content":[{"text":"Ka ling avati ka hitu keil keke avalosil kat vongien.","poem":1},"Envatien onen hel lisenges."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kei varei mu vini moeite keil ten out Isip.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":11,"content":[{"text":"Evus, lah lat me-Isrel keil ran out Isip.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":12,"content":[{"text":"Kei mumoni mukonek ral min keihoen koa mul en hen.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":13,"content":[{"text":"Kei sasen mumon Atas Tahilhili maseh va en usite elu.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":14,"content":[{"text":"Kei sakin meatin keil onen amual kotehei.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":15,"content":[{"text":"Ka sakin atas enek rein vini asuv houlu ten out Isip ral min meatin tavaeen vasi keil onen.","poem":1},"Envatien onen hel lisenges."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kei mulamun meatin keil onen aka vas out volvol.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":17,"content":[{"text":"Asuv houlu keil koa akur keihoen, kei vitan en keil vasi.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":18,"content":[{"text":"Mu vinvini asuv houlu keil koa avi hetetamen.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":19,"content":[{"text":"Anatin, mu vini asuv houlu Sihon ten out Amor.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":20,"content":[{"text":"Ka mumoni vatte tas min asuv houlu Og emun ten out Basan.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":21,"content":[{"text":"Evus, san atan ose min meatin keil onen vahi ose esuk.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":22,"content":[{"text":"Kei sani min me-Isrel keil koa avi meatin toumien keil onen.","poem":1},"Envatien onen hel lisenges."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kei mundem kat ir navong romul en hen mesav keil.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":24,"content":[{"text":"Mumon ir romaluv ran hen vativieh keil orer.","poem":1},"Envatien onen hel lisenges."]},{"type":"verse","number":25,"content":[{"text":"Ka mul vengan tounah vasi keil koa amoul en out netan.","poem":1},"Envatien onen hel lisenges."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mihemasmas Ahi ten out nesa.","poem":1},"Envatien onen hel lisenges."]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}