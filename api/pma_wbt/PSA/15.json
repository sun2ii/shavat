{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PSA","translationId":"pma_wbt","name":"Sam","commonName":"Sam","title":"Sam keil","order":19,"numberOfChapters":50,"sha256":"c7ecdc7662905f07dca188bd816068f226853a91ec19b8db23b2b62737c08783","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pma_wbt/PSA/150.json","totalNumberOfVerses":634},"chapter":{"number":15,"content":[{"type":"heading","content":["Sakien keil koa Ahi en vati"]},{"type":"hebrew_subtitle","content":["Asuv houlu Deved mutisi"]},{"type":"verse","number":1,"content":[{"text":"?Ahi Asuv, isei heha neim en Eim Votut onom?","poem":1},{"text":"?Isei heha netan minuk en Hou Saeon koa vi votut?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Vati meatin koa long kat Ahi en tounah vasi,","poem":1},{"text":"koa mumon sakien koa tahos.","poem":2},{"text":"Selusien onen vi anatin ka mal,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"romumontei hithitusilien vaha kat meatin sav keil.","poem":2},{"text":"Meatin enek romumtei vatisa min tunali keil,","poem":1},{"text":"ka rosel kututtei meatin sav keil.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kei en rovattei koakeil Ahi sesein keil,","poem":1},{"text":"ka vouhou min koakeil along kat ren Ahi.","poem":2},{"text":"Lises, meatin enek mumon asa koa vat kati,","poem":1},{"text":"ka rovilestei rani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kei maen mani min meatin sav keil ka rokurtei teisao eni.","poem":1},{"text":"Ka en rovattei vakur mani en sise koa valuvos meatin koa romumontei tounah vatisa.","poem":2},{"lineBreak":true},{"text":"Vati meatin koa mumon sakien keil koa amukonek,","poem":1},{"text":"lises, moulien onen helomal hekeih.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":5}