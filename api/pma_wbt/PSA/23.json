{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PSA","translationId":"pma_wbt","name":"Sam","commonName":"Sam","title":"Sam keil","order":19,"numberOfChapters":50,"sha256":"c7ecdc7662905f07dca188bd816068f226853a91ec19b8db23b2b62737c08783","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pma_wbt/PSA/150.json","totalNumberOfVerses":634},"chapter":{"number":23,"content":[{"type":"heading","content":["Ahi asuv mul losil kat inau"]},{"type":"hebrew_subtitle","content":["Asuv houlu Deved mutisi"]},{"type":"verse","number":1,"content":[{"text":"Ahi Asuv, kei mul losil kat inau","poem":1},{"text":"suval meatin koa losil kat sipsip keil osen.","poem":2},{"text":"Tounah vasi koa vakataun moulien onak,","poem":1},{"text":"kei sani minau.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kei kur nau nuva en uteral koa oumunai tahos mul ien,","poem":1},{"text":"ka mulamunau nuva en out koa oai mekaikai ka mandil.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kei san keihoen hau minau","poem":1},{"text":"ka mulamunau en sise koa mal,","poem":2},{"lineBreak":true},{"text":"suval koa kei vat kati.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Avaseini munak niha en mari mankoli, nirmetautei,","poem":1},{"text":"ven keik, Ahi Asuv, komusil inau.","poem":2},{"text":"Kolei kokoe enau ka koring koe nau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Komumon mari anien tai venau","poem":1},{"text":"en out koa vativieh keil onak akilea avales inau.","poem":2},{"text":"Kosan more amaien minau suval koa navi mari meatin tai,","poem":1},{"text":"ka kovus anien vilelau en pelet koa kosani minau.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nakilea keke tahosien ka more envatien onom housil kat inau en avong vasi,","poem":1},{"text":"ka nito en teim som lisenges.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":6}