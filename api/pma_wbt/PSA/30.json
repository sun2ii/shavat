{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PSA","translationId":"pma_wbt","name":"Sam","commonName":"Sam","title":"Sam keil","order":19,"numberOfChapters":50,"sha256":"c7ecdc7662905f07dca188bd816068f226853a91ec19b8db23b2b62737c08783","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pma_wbt/PSA/150.json","totalNumberOfVerses":634},"chapter":{"number":30,"content":[{"type":"heading","content":["Ahi asuv mul san kataunien min ir"]},{"type":"hebrew_subtitle","content":["Asuv houlu Deved mutisi ten avong asehen voiteh ten Eim Votut onen Ahi"]},{"type":"verse","number":1,"content":[{"text":"Ahi Asuv, namasmasuk veni keik kokataunau.","poem":1},{"text":"Kormaentei koakeil avahu vatal minau avali nau ka avaselus kutut kat nau.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ahi Asuv, napeahik eli ven kataunien onom,","poem":1},{"text":"ka kosakinau namoul.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kokur koe nau ran avul ten matien.","poem":1},{"text":"Vesesal mamat, ka kosan ris moulien minau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"!Kami koa mimusil Ahi Asuv! !Mihesau masmasi!","poem":1},{"text":"Ahi vi votut, mihendem kat asa koa kei mumoni min kami, ka mihehiten hihuri veni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vurohien onen mul tamureis,","poem":1},{"text":"ka tahosien onen mul taveah.","poem":2},{"text":"Avaseini simetomi houe en vongien;","poem":1},{"text":"en meneai teni, mihelonge hetahos eris.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mulamu, navong nales tahosien en moulien onak,","poem":1},{"text":"ka navit sasok eni navit, “Tounah hetovuol hesut nau.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ahi Asuv, en avong koanek, kotahos minau,","poem":1},{"text":"ka koring koe nau suval out tatosuaien.","poem":2},{"text":"Ka katau suk, koro suai ranau,","poem":1},{"text":"ka nametau houlu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sakini, navisok, Ahi Asuv.","poem":1},{"text":"Napeahik ven kataunien onom navit,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“?Munak nimat, heite teni hehi asa?","poem":1},{"text":"Heite hetovuol munak nihita en avul.","poem":2},{"text":"?Koakeil umatmat, imasmasuk?","poem":1},{"text":"!Vuo! Asakras avisohiso usil tahosien onom.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"!Sakini, Ahi Asuv, kitaengonau li ka kisan enmahisien minau!","poem":1},{"text":"!Ahi, navit mahisuk kikataunau!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ka keik, koviles tangien onak","poem":1},{"text":"mai vi holien ten sien.","poem":2},{"text":"Isien onak, kokulati ranau,","poem":1},{"text":"ka kosakinau numai nalonge tahos.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sakini, nirto raengtei,","poem":1},{"text":"nimasmas isom lises.","poem":2},{"text":"Ahi Asuv, kovi Ahi onak;","poem":1},{"text":"nil nihiten hihuri minuk lisenges.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}