{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PSA","translationId":"pma_wbt","name":"Sam","commonName":"Sam","title":"Sam keil","order":19,"numberOfChapters":50,"sha256":"c7ecdc7662905f07dca188bd816068f226853a91ec19b8db23b2b62737c08783","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pma_wbt/PSA/150.json","totalNumberOfVerses":634},"chapter":{"number":67,"content":[{"type":"heading","content":["Meatin vasi keil ten out netan ihati lat isen Ahi"]},{"type":"verse","number":1,"content":[{"text":"Ahi, kitokol kat komai en enmahisien onom,","poem":1},{"text":"kiles komai hetal min tahosien onom.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kitie lat rendemien onom min meatin keil ten out netan,","poem":1},{"text":"keke availea sise ten mututien onom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O Ahi, meatin keil ihati latuk.","poem":1},{"text":"Anatin, meatin vasi keil ihati lat isom.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Meatin ten kantri vasi keil isi keil ka isau en sien,","poem":1},{"text":"keil isau veni keik kosan mahien min meatin keil en sakien ten maluen,","poem":2},{"lineBreak":true},{"text":"keik komulamun meatin ten kantri vasi keil en out netan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O Ahi, meatin keil ihati latuk.","poem":1},{"text":"Anatin, meatin vasi keil ihati lat isom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ahi onomai, komul kosan tokolkatien min komai,","poem":1},{"text":"komul kosakin amas mul en atan osomai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anatin, tokolkatien onom mul en komai,","poem":1},{"text":"ka koakeil ten out netan ilesi ka ihouhou minuk.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}