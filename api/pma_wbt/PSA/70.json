n imok!”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O Ahi, avek memerau ka navi livere enges,","poem":1},{"text":"kikalah kimai venau li.","poem":2},{"text":"Keik kovi kataunien onak ka korali lat inau lises.","poem":1},{"text":"O Iahova, konatountei li.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":5}