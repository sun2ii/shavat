{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PSA","translationId":"pma_wbt","name":"Sam","commonName":"Sam","title":"Sam keil","order":19,"numberOfChapters":50,"sha256":"c7ecdc7662905f07dca188bd816068f226853a91ec19b8db23b2b62737c08783","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pma_wbt/PSA/150.json","totalNumberOfVerses":634},"chapter":{"number":8,"content":[{"type":"heading","content":["Ahi ling tounah vasi ten out netan en hen meatin keil"]},{"type":"hebrew_subtitle","content":["Asuv houlu Deved mutisi"]},{"type":"verse","number":1,"content":[{"text":"!Ahi Asuv onomai, isom marite mok en out vasi netan!","poem":1},{"text":"Muohien ten hetetamenien onom vilelau en out nesa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Masmasien heha minuk","poem":1},{"text":"heka en titiali keil ka tivava keil.","poem":2},{"text":"Keik koro en out tetahos ran koakeil uvae ral minuk;","poem":1},{"text":"Koring koe koakeil avit avapurunuk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Navong nales teilang koa komumoni,","poem":1},{"text":"naseipat nales more avati ka hitu keil koa kolingi en vulie,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"narendem usil meatin enges ten out netan.","poem":1},{"text":"?Vensa komundem keil?","poem":2},{"lineBreak":true},{"text":"?Komul kolei kat keil vensa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Keik komumon meatin keil amulin tounah sav keil,","poem":1},{"text":"kosan keihoen, muohien ka houhouen min keil.","poem":2},{"lineBreak":true},{"text":"Keikos Ahi, kovi hetamen en keil.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Koling tounah vasi keil koa komumoni en hen meatin keil;","poem":1},{"text":"korie lat keil avi hetetamen imok mulin tounah vasi ten out netan:","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"sipsip ka buluk ka tirendan vasi keil koa amual;","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"aman keil koa amuka en teilang,","poem":2},{"lineBreak":true},{"text":"ka mesau keil ka tounah vasi keil emun ten atas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"!Ahi Asuv onomai, isom marite mok en out vasi netan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":9}