{"translation":{"id":"pma_wbt","name":"Paama Bible","website":"https://ebible.org/Scriptures/details.php?id=pma","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pma","licenseNotes":null,"shortName":"WBT","englishName":"Paama Bible","language":"pma","textDirection":"ltr","sha256":"7125a4889292dfdf4aef141e09abfbaeff206a4f9b60916a80058479d3785f64","availableFormats":["json"],"listOfBooksApiLink":"/api/pma_wbt/books.json","numberOfBooks":54,"totalNumberOfChapters":519,"totalNumberOfVerses":11001,"languageName":"Paama","languageEnglishName":"Paama"},"book":{"id":"PSA","translationId":"pma_wbt","name":"Sam","commonName":"Sam","title":"Sam keil","order":19,"numberOfChapters":50,"sha256":"c7ecdc7662905f07dca188bd816068f226853a91ec19b8db23b2b62737c08783","firstChapterNumber":1,"firstChapterApiLink":"/api/pma_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pma_wbt/PSA/150.json","totalNumberOfVerses":634},"chapter":{"number":93,"content":[{"type":"heading","content":["Iahova vi asuv houlu orer"]},{"type":"verse","number":1,"content":[{"text":"Iahova, keik vi asuv houlu orer.","poem":1},{"text":"Komusin en keihoen ka hetetamenien.","poem":2},{"text":"Keik komum revi out netan,","poem":1},{"text":"ka tounah tovuol kilea vakaikai eni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iahova, tounah vasi keil amul en hem.","poem":1},{"text":"Ka en avong telamu koa out netan tovuol veah, keik komul tuai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iahova, navong atas mea ka mavul kat veien, verien teni marite.","poem":1},{"text":"Navong atas mul mea en mari tahe keil koa amavul kat tounah,","poem":2},{"lineBreak":true},{"text":"suval koa amul avitehiten usil keihoen onom ral min mari ren.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iahova, isom hetetamen imok en out nesa.","poem":1},{"text":"Kokeih imok mulin keihoen ten atas,","poem":2},{"lineBreak":true},{"text":"ka komarite imok mulin marmari tahe keil koa amavul en out ut.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mengkatien onom sakras vavuol,","poem":1},{"text":"ka Eim Votut koa koro ien vi votut vis vi votut imok lisenges.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pma_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pma_wbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pma_wbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}