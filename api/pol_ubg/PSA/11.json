{"translation":{"id":"pol_ubg","name":"Święta Biblia","website":"https://ebible.org/Scriptures/details.php?id=polubg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=polubg","licenseNotes":null,"shortName":"UBG","englishName":"Polish Updated Gdansk Bible","language":"pol","textDirection":"ltr","sha256":"da748a366f8056d56dd8ea2b5c60b8ca91b2834f2cecbf57caa3eb3f6450883b","availableFormats":["json"],"listOfBooksApiLink":"/api/pol_ubg/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"polski","languageEnglishName":"Polish"},"book":{"id":"PSA","translationId":"pol_ubg","name":"Psalmów","commonName":"Psalmów","title":"Księga Psalmów","order":19,"numberOfChapters":150,"sha256":"a45bdb37e003d7ac6bca140b3df6e573828f4517b2a42f498874837cd7595ac2","firstChapterNumber":1,"firstChapterApiLink":"/api/pol_ubg/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pol_ubg/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Przewodnikowi chóru. Psalm Dawida."]},{"type":"verse","number":1,"content":["W PANU pokładam ufność. Jakże więc możecie mówić mojej duszy: Odleć jak ptak na twoją górę?"]},{"type":"verse","number":2,"content":["Bo oto niegodziwi napinają łuk, kładą strzałę na cięciwę, aby w ciemności strzelać do tych, którzy są prawego serca."]},{"type":"verse","number":3,"content":["Gdy zostaną zburzone fundamenty, cóż może zrobić sprawiedliwy?"]},{"type":"verse","number":4,"content":["PAN jest w swym świętym przybytku, tron PANA jest w niebie, jego oczy patrzą, jego powieki badają synów ludzkich."]},{"type":"verse","number":5,"content":["PAN doświadcza sprawiedliwego, ale jego dusza nienawidzi niegodziwego i tego, kto kocha bezprawie."]},{"type":"verse","number":6,"content":["Spuści na niegodziwych deszcz sideł, ognia i siarki, a palący wicher będzie udziałem ich kielicha."]},{"type":"verse","number":7,"content":["Bo sprawiedliwy PAN kocha sprawiedliwość, jego oczy patrzą na prawego."]}],"footnotes":[]},"thisChapterLink":"/api/pol_ubg/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pol_ubg/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pol_ubg/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}