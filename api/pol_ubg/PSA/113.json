_ubg/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pol_ubg/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pol_ubg/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}