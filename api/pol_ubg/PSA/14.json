wróci niewolę swego ludu, Jakub się rozraduje i Izrael się rozweseli."]}],"footnotes":[]},"thisChapterLink":"/api/pol_ubg/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pol_ubg/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pol_ubg/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}