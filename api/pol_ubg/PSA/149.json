. Taka jest chwała wszystkich jego świętych. Alleluja."]}],"footnotes":[]},"thisChapterLink":"/api/pol_ubg/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pol_ubg/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pol_ubg/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}