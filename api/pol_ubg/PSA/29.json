{"translation":{"id":"pol_ubg","name":"Święta Biblia","website":"https://ebible.org/Scriptures/details.php?id=polubg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=polubg","licenseNotes":null,"shortName":"UBG","englishName":"Polish Updated Gdansk Bible","language":"pol","textDirection":"ltr","sha256":"da748a366f8056d56dd8ea2b5c60b8ca91b2834f2cecbf57caa3eb3f6450883b","availableFormats":["json"],"listOfBooksApiLink":"/api/pol_ubg/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"polski","languageEnglishName":"Polish"},"book":{"id":"PSA","translationId":"pol_ubg","name":"Psalmów","commonName":"Psalmów","title":"Księga Psalmów","order":19,"numberOfChapters":150,"sha256":"a45bdb37e003d7ac6bca140b3df6e573828f4517b2a42f498874837cd7595ac2","firstChapterNumber":1,"firstChapterApiLink":"/api/pol_ubg/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pol_ubg/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["Psalm Dawida."]},{"type":"verse","number":1,"content":["Oddajcie PANU, synowie mocarzy, oddajcie PANU chwałę i moc."]},{"type":"verse","number":2,"content":["Oddajcie PANU chwałę należną jego imieniu, oddajcie PANU pokłon w ozdobie świętości."]},{"type":"verse","number":3,"content":["Głos PANA nad wodami; zagrzmiał Bóg chwały, PAN nad wielkimi wodami."]},{"type":"verse","number":4,"content":["Głos PANA potężny, głos PANA pełen majestatu."]},{"type":"verse","number":5,"content":["Głos PANA łamie cedry, PAN łamie cedry Libanu;"]},{"type":"verse","number":6,"content":["I sprawia, że skaczą jak cielę, Liban i Sirion jak młody jednorożec."]},{"type":"verse","number":7,"content":["Głos PANA krzesze płomienie ognia."]},{"type":"verse","number":8,"content":["Głos PANA wstrząsa pustynią, PAN wstrząsa pustynią Kadesz."]},{"type":"verse","number":9,"content":["Głos PANA sprawia, że z bólem rodzą łanie i ogołacają się lasy, a w jego świątyni każdy opowiada o jego chwale."]},{"type":"verse","number":10,"content":["PAN zasiada nad potopem, PAN zasiada jako Król na wieki."]},{"type":"verse","number":11,"content":["PAN doda mocy swojemu ludowi, PAN pobłogosławi swój lud pokojem."]}],"footnotes":[]},"thisChapterLink":"/api/pol_ubg/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pol_ubg/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pol_ubg/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}