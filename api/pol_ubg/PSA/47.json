{"translation":{"id":"pol_ubg","name":"Święta Biblia","website":"https://ebible.org/Scriptures/details.php?id=polubg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=polubg","licenseNotes":null,"shortName":"UBG","englishName":"Polish Updated Gdansk Bible","language":"pol","textDirection":"ltr","sha256":"da748a366f8056d56dd8ea2b5c60b8ca91b2834f2cecbf57caa3eb3f6450883b","availableFormats":["json"],"listOfBooksApiLink":"/api/pol_ubg/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"polski","languageEnglishName":"Polish"},"book":{"id":"PSA","translationId":"pol_ubg","name":"Psalmów","commonName":"Psalmów","title":"Księga Psalmów","order":19,"numberOfChapters":150,"sha256":"a45bdb37e003d7ac6bca140b3df6e573828f4517b2a42f498874837cd7595ac2","firstChapterNumber":1,"firstChapterApiLink":"/api/pol_ubg/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pol_ubg/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Przewodnikowi chóru. Psalm dla synów Korego."]},{"type":"verse","number":1,"content":["Klaszczcie w dłonie, wszystkie narody, wykrzykujcie Bogu radosnym głosem."]},{"type":"verse","number":2,"content":["Gdyż PAN Najwyższy budzi grozę, jest wielkim Królem nad całą ziemią."]},{"type":"verse","number":3,"content":["Podda nam ludzi i narody pod nasze stopy."]},{"type":"verse","number":4,"content":["Wybrał nam nasze dziedzictwo, chlubę Jakuba, którego umiłował. Sela."]},{"type":"verse","number":5,"content":["Wstąpił Bóg wśród okrzyków, PAN przy dźwięku trąby."]},{"type":"verse","number":6,"content":["Śpiewajcie Bogu, śpiewajcie; śpiewajcie naszemu Królowi, śpiewajcie."]},{"type":"verse","number":7,"content":["Bóg bowiem jest Królem całej ziemi, śpiewajcie pieśni pouczające."]},{"type":"verse","number":8,"content":["Bóg króluje nad narodami, Bóg zasiada na swym świętym tronie."]},{"type":"verse","number":9,"content":["Władcy narodów zebrali się z ludem Boga Abrahama, bo do Boga należą tarcze ziemi; on jest wielce wywyższony."]}],"footnotes":[]},"thisChapterLink":"/api/pol_ubg/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pol_ubg/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pol_ubg/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}