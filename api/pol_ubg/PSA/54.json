trapienia, a moje oko widziało zemstę nad moimi wrogami."]}],"footnotes":[]},"thisChapterLink":"/api/pol_ubg/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pol_ubg/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pol_ubg/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}