{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"MEID pai ol o, me jota alialu ni padak en me doo jan Kot akan o me jo duki on me dipan akan, o me jo mondi ren me malaun akan,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A me kin peren kida kapun en leowa o madamadaua duen a kapun ni ran o ni pon!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A rajon tuka pot, me padedier ni kailan pilap akan me kin kapareda wa ni a anjau, o ta kan jota kin monala, a karoj a wiawia pwaida.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Me doo jan Kot akan jota kin dueta, a re rajon dip me an kin iririp jili.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I me doo jan Kot akan jota pan pwai kida nan kadeik, o me dipan akan nan momod en me pun kan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pwe leowa kotin mani al en me pun kan; a al en ir, me doo jan Kot akan, pan joredi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":6}