{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"NIJINIJ on Ieowa jap karoj!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Papan Ieowa ki peren; koki don mon jilan i nijinij!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Komail en aja, me Ieowa Kot. I me kotin wia kitail dar a kaidin pein kitail pwen japwilim a aramaj o jip en japwilim a pwin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pedelon on nan japwilim a wanim laud ki danke, o kaul en kapin mon japwilim a pera jaraui. Danke i o kapina mar a!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pwe leowa me mau, a kalanan joutuk, o a melel pan duedueta kokolata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}