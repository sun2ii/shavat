{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":101,"content":[{"type":"verse","number":1,"content":[{"text":"I pan kauleki duen kalanan o pun; i pan kauleki pjalm akan on komui. Main leowa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I men inen eweita ni al pun iad kom pan koti don ia? i men weweid ni melel ren toun im ai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I jota men wia morjued; i tataki wiawian me dipan akan, a jota pan pat on ia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Monion japun pan muei jan ia; i jota men aja duen me jued.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Me kin rir karaunemali men impa, i pan kamela; i juedeki me aklapalap ni maj ar o monion arail.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maj ai pan apapwali me melel akan nan jap o, pwe ren kaujon re i; me kin weweid ni al pun, pan papa ia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Me kin kotaue, jota pan kaujon nan im ai, me kin likam, jota pan pwaida mon maj ai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni manjan karoj i pan kawela me katiwo nan jap o, pwen kokojan kanim en leowa karoj, me kin wia japun.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}