{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"I LIKI Ieowa, a menda komail indan nen i: Piridalan pon omail nana dueta manpir amen?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe kilan, me doo jan Kot akan kaonopadar kajik katieu o pwilikidi ar kanan en kajik katieu pon jal o, pwen rir kajikiedi me melel ni monion arail.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe ma ur akan ronk pajan, da me aramaj pun en wiada?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ieowa kotikot nan tanpaj a jaraui, mol en Ieowa mimi nanlan, jilan i kin mamajani jili, kil en jilan i kin jojon aramaj akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ieowa kotin jon me pun, ap kotin tataki me japun o morjued.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A pan kotin kamoredi on me doo jan Kot akan liol, o kijiniai, o jwepel, o a pan katine kin irail melimel.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ieowa me pun o a kotin pok on me pun. Jilan i ireron on me melel o.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}