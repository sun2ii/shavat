{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"IEOWA kotin majani on ai Kaun, mondi on ni pali maun i, lao I pan wia kida om imwintiti utipan na om.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ieowa pan kotin kadarado jokon en wei omui jan nan Jion; kakaun nan pun en omui imwintiti kan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Murin omui poedier, japwilim omui kan pan pereperen, wia mairon on komui ni ar kapwat jaraui. Japwilim omui jeri kan pan ipwidi on komui dueta poik en ni manjan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ieowa kotin kaula, o a jota pan kalula: Komui jamero joutuk amen, duen al en Melkijedek.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kaun o kotikot ni pali maun om a pan kamela nanmarki kan ni ran en a onion.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A pan kotin kaunda nan pun en men liki kan, a pan kadir kila kalep akan waja karoj, a kotin palan pajan tapwi en wei lapalap.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A pan nima jan pil ni kailan al, i me a pan jara kida.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}