{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"I PAN kapina Ieowa jan nan monion i nan pun en me lelapok kan o nan momodijou.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Meid laud wiawian Ieowa kan, ir me injenoki, pan dedeki due.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A wiawia kan me pun o linan, o a pun pan duedueta kokolata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A manaman akan men kataman eu. Ieowa me dir en mak o kalanan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A kotin kamana ir, me majak i, a kin kolekol japwilim a inau kokolata.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A kotin kajanjale on japwilim a aramaj akan mana en a wiawia kan, pwen kotiki on ir jojo en men liki kan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dodok en lim a kan me melel o pun; japwilim a majan kan karoj me melel.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Re pan duedueta kokolata, o re wiauier ni melel o pun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A kotiki on japwilim a kan jaunkamaur, o a kupureda, me a inau pan duedueta kokolata; mar a me jaraui o kalom.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Majak Ieowa iei tapin lolekon; irail meid pai, me kin wia due met, pwe a pai potopot eta.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}