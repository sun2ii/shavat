{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"MEID pai ol o me majak Ieowa, me kin peren kola a kujoned akan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kadaudok a pan kelail nan jap o; kainok en me melel akan pan pwaida.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Im a pan dir en dipijou melel o a pun pan potopot eta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Marain kin daka dan me melel akan nan waja rotorot, a kin dir en mak o kalanan o pun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Meid pai ol o me kalanan, o kin kijakija wei; a pan pwaida ni anjaun kadeik.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pwe a jota pan luetala kokolata; me pun amen iei men kataman joutuk eu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A jota pan majak ron jued monion i me kelail ni a kaporoporeki Ieowa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Monion i me kelail, a jota km majak, lao a pan peren kida a imwintiti kan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A kin kamoredi o kijakij on me jamama kan; a pun pan potopot eta; oj a pan kokoda o indand mau.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Me doo jan Kot pan kilan ap makara kida; a pan teterokki ni akan ap joredi; inon en me doo jan Kot akan pan nikila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}