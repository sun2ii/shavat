{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"MAIN kom kotin jauaja, pwe me lelapok kan malaulaular, o me melel akan me malaulau ren aramaj akan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Irail kin lokaia likam, amen amen on men impa, re lokaiaki lol riapot.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ieowa pan kotin ujada kil en au karoj me linkapin o lo, me kin lokaia wei ni aklapalap.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Me kin indinda: Lo atail, me kit pan pwai kida, o kil en au at me kit keleki; ij at kaun?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ieowa kotin majani: I pan uda, pweki kankaneraner en me luet akan o janejan en me jamama kan: I pan jauaja i, me kin inon ion.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Majan en Ieowa me makelekeleta jilper, me kamakelekel kidar nan dal pwel en kijiniai pan pak iju.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Komui Main, pan kotin pera irail, o jinjila mon di wet kokolata.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pwe me japun kan pan totolar waja karoj, ma aramaj jued pukat kin kaunda aramaj akan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}