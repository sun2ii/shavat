{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"NI ai apwal akan i likwir won Ieowa, a ap kotin mani ia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Main Ieowa, kotin dore ia la, jan au en me kin likam, o lo en kotaue.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Da me lo likam kak wiai on uk, o da me a kak kapwaiada!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A rajon kananan kajik katieu kon kan ren me kelail amen, dueta kijiniai nan alek.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Meid apwal on ia, ai kairu nan Mejek, o ai kaujon impan im en men Kedar!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Meid warai on ai kaukaujon ren aramaj akan me kin tataki muei mau.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I inon ion muei mau, a ni ai pan lokaia, re kin mauki mauin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}