{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"I PEREN kida ar indai on ia: Kitail en kolan nan tanpaj en Ieowa!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na at akan pan mi ni wanim en kel en Ierujalem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ierujalem kanim eu me kakaudar, pwen kanim kelail eu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waja me kainok kan kin momaitala ia, kainok en Ieowa kan, jaunkadede en Ijrael, pwen kapina mar en Ieowa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pwe i waja me mol en kadeik mi ia, mol en kadaudok en Dawid.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Poeki on Ierujalem a pai kan! Me kin pok on uk, en paida!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Muei mau en mi ni om kel, o pai nan om im akan!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I pan kapakapa kin uk pweki ri ai o kompoke pai kan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I pan rapaki on uk me mau melel, pweki tanpaj en Ieowa at Kot.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}