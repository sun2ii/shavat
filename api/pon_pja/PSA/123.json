{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":123,"content":[{"type":"verse","number":1,"content":[{"text":"I KIN jarada won komui, me kotikot nanlan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kilan, duen maj en ladu kan kin kilekilan lim en ar jaumaj akan, o duen maj en lidu kan kin kilekilan a jaumaj li, iduen maj at kin ariri Ieowa at Kol, a lao kotin maki on kit.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Main Ieowa, kom kotin maki on, kotin maki on kit! Two kit me dir en namenok.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Monion i toutouki en me jued akan ar mamale kin kit o en me aklapalap akan ar kanamenok kin kit.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}