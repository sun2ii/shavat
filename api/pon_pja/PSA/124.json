{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":[{"text":"IJRAEL en inda: Ma Ieowa jota pan kotin ieian kit.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma Ieowa jota pan kotin ieian kit, ni en aramaj akan ni palian kit.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Re pan katala kit ala ni at memaur, ni ar linaranar kin kit.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pil akan ap pan kamop kit ala, pilap akan kadupwaledi nen it.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pil akan itida melel lao kadupwaledi nen it.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kapin on Ieowa, me jota mueid on, ni arail en ter kit pajan!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nen it piti jan injar en jaun injar dueta manpir amen; injar ola, a kit pitila.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jauaj pat iei mar en Ieowa, me kotin kapikadar lan o jappa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}