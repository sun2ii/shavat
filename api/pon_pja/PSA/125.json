{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"Me liki Ieowa kin rajon dol Jion, me jota kin mokid, a pan potopot eta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Duen dol akan kin kapil pena Ierujalem, iduen Ieowa kin kotikot ren japwilim a aramaj akan, jan met o kokolata.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe jokon en me doo jan Kot akan jota pan mimieta ren kijin pwin en me pun kan, pwe me pun kan ender kapa won pa ar an nin japun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Main Ieowa, kotin kajanjaleda omui kalanan on me mau kan o on ir, me melel nan monion arail.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A me kin wuki won ni al japun, Ieowa pan kotin paki irail wei ianaki me jued akan, Ijrael en popol!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}