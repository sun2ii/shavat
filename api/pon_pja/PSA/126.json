{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"NI anjau Ieowa kotin kapuredor me jalidi en Ijrael akan, kit rajon ir, me auramen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I anjau au at me dir en kaurur, o Io at me dir en nijinij. I anjau men iki kan ap inda: Meid laud dodok en Ieowa re ’rail!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Melel, dodok en Ieowa meid Iaud on kit er, o i me je kin peren kida.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Main Ieowa, re kotin kapuredo at jalidi kan dueta pilap en jap en pali air akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Me kamore kidi pil en maj arail, pan dolun ni peren.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Re kin weweidki janejan, o kin wewa wa kajampwal, a ni ar puredo, re pan peren, wad oar kap en wa kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}