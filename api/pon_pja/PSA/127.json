{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"MA Ieowa jota pan kauada im o, dodok en pwin jauje jota pan katepa; ma Ieowa jota pan jinjila kanim o, jaunmajamajan pan majamajan mal.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jota katepa on komail, ma komail pan paurida nin joran, ap pil pwand kamol ni pon, o toutouki okotme, ni omail manamana, pwe a kin kakepwapwala japwilim a kompokepa kan ni ar mamair.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kilan, jeri ko iei kijakij eu jan ren Ieowa, o wan aramaj pai eu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Duen kananan kajik katieu nan pa en ol komad amen, iduen putak ko ar pan pwaida.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Meid pai ol o, me a lepan me direki mepukat! Re jota pan jarodi, ni ar kapun pena ren ar imwintiti kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}