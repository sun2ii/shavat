{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"IJRAEL en inda: Re katoutou ia melel jan ni ai tikitik lel met pak toto.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pan pak toto re katoutou ia melel jan ni ai tikitik lel met; ari jo, re jota kak kaloe ia di.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Men japajap weirada pon tinjau ai, wiadar warawar reirei.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A Ieowa me pun, a kotin lepuk pajaner jal en me doo jan Kot akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Karoj me kin tataki Jion, en jarodi o tanwei!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ren rajon ra pon oj en im o, me kin mon pena mon a pan ujujda!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Me jota kin kadirela kumut en pa en jaundolun, de pa en me kin pir pena kap akan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pwe me kin daulul waja o, ren der inda: Kot en kotin kupura maui komail! Kit kapai komail da ni mar en Ieowa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}