{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"MAIN arai da kom pan kotin malie ia la? Arai da komui pan kotin karirila jilan omui mo i?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Arai da i en perki nan lol ai o jalo mi nan monion i ran karoj? Arai da ai imwintiti en kaurur kin ia?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Main ai Kot, kom kotin majan don ia o japen ia. Kom kotin kamaraini maj ai, pwe i ender mela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pwe ai imwintiti ender inda: I kaloedier i. O me palian ia ender perenki ai pupedier.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A i kin liki omui kalanan; monion i en peren kida omui kotin jauaja ia. I pan kauleki Ieowa duen a kotin wiawia mau on ia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":5}