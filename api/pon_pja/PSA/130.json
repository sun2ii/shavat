{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"MAIN Ieowa, i kin likwirda won komui jan nan waja lol.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Main, kotin ereki nil ai! Karon omui en mamani ai nidinid!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma komui Ieowa, pan kotin kapokonki on aramaj dip akan, Main, ij me ap pan kak kajinenda mo ’mui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A komui kin kotin mak, pwe aramaj en majak komui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I kin auiaui Ieowa, nen i kin auiaui, o i kin auiaui a inau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nen i kin auiaui Kaun o, jan jaunmajamajan kin auiaui manjan, jaunmajamajan kin auiaui manjan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ijrael auiaui Ieowa, pwe Ieowa me kalanan, o waja en kamaio mi re a.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A pan kotin dorela Ijael jan dip a kan karoj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}