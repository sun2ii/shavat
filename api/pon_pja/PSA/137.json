{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"KIT momoder ni kailan pilap en Papel o janejan, ni ni tamanda Jion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kit lanadar at arp akan nin tuka kan, me mi waja o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe me jali kit edi inda, jen kaul, o jen pereperen ni at mamaiei: Komail wiai on kit kaul apot duen Jion.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iaduen at pan kak wiada kaul nil leowa nan jap en men wai?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma i pan monoke uk ala Ierujalem, pa i pali maun ap pil pun monokinokla.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lo i pan paj on pan natanat ai, ma i jolar pan taman uk adar, ma i jolar pan peren kida Ierujalem mon meakaroj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Main leowa, kom kotin tamanda en men Edom ar lokolokaia ni ran apwal en lerujalem Kawela, kawela lao Iel on nan pwel!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Toun Papel, morjued koe, re meid pai, me pan wiai on uk duen me koe wiadar!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Meid pai ir, me pan koledi noum jeri pwelel o kajuk pajan nin takai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}