{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"KAULEKI kaul kap pot on Ieowa; pokon jaraui en kapina i.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ijrael en peren kida i, me kotin wia irail da; jeri en Jion en peren kida arail Nanmarki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ren kapina mar a ni pwin en pokol; ren wia aip o arp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pwe Ieowa kotin peren kida japwilim a aramaj akan; a kotin kapwate kin me luet akan linan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lelapok kan en pereperen o kapina, o nijinij pon ki arail akan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Au arail en kapina Kot, o kodlaj kon en mi nan pa arail.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pwe ren depuk on men liki kan, o kaloke wei kan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pwen jalie kidi arail nanmarkikan jal, o me kajampwal re ’rail ki jal mata.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pwe ren kapwaiada kalokolok, me kileledi on irail er maj o. Iduen wau en japwilim a lelapok kan. Aleluia!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}