{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"IEOWA en kotin mani om kapakap ni ran apwal o; mar en Kot en Iakop en pera uk!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A en kotin porone don uk jauaj pam jan nan tanpaj jaraui o kamana uk ada jan nan Jion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A en kotin kupura om mairon karoj, o om mairon ijij en konkon re a.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A en kotiki on uk, me monion om anane, o kotin kapaiada om inon karoj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Je pan nijinijki omui jauaja kit, o ni mar en atail Kot kit pan kida at plak. Ieowa en kotin kapwaiada om poekipoek karoj!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I ap ajaer, me Ieowa kin kotin dorela japwilim a me keiedier, o a pan mani i jan nan japwilim a lan jaraui, lim a pali maun kin jauaja kaualap.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mo kan kin kaporoporeki war o oj akan; a kit kin keleki mar en Ieowa atail Kot.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Irail lodier o pupedier, a kit uda o kajinenda.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Main kom kotin jauaja nanmarki o, o kotin mani at likwir on komui!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}