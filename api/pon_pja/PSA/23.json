{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"IEOWA jile pa i, i jota pan anane meakot.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A kotin kamana ia nan moj kajelel o kalua ia won ni pil lamelamur.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A kotin kamanada nen i, a kalua ia pon al pun pweki mar a.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I lao weid nan mot en mela, i jota pan majak me jued kot, pwe kom kotin ieian ia, omui irar o lepin jaipali kamait ia la.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kom kotin kaonop dan ia tepel eu jalon ai imwintiti kan. Kom kotin keiekidi mon ai le, o ai dal kin wudewudok.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pai o kalanan pan idauen ia arain ai maur, o i pan mimieta nan tanpaj en leowa kokolata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}