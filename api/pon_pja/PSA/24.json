{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"JAPWILIM en leowa jappa o audepa kan, jap o meakaroj me kaujon poa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe a kotin pajonedier ni kailan madau, o a kotin wiadar pon pil akan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ij me pan kodalan pon dol en leowa? O ij me pan kak uda ni mol en Ieowa jaraiui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"me pa a kan jota japun o kin mauki padak japun, o me jota kin kaula likam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I me pan kamaula ren Ieowa, o a pan pun kila ren Kot a jaunkamaur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I kainok, me kin peiki on Kot, me kin rapaki jilan omui, Kot en Iakop.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Komail ritinada wanim laud o lanada wanim nin jappa, pwe Nammarki linan en kotilon!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ij Nanmarki linan men et? I Ieowa rojon o manaman, Ieowa me rajon nan mauin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Komail ritinda wanim laud o lanada wanim ni jappa, pwe Nanmarki linan en kotilon!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ij Nanmarki linan men et? I Ieowa Jepaot; I Nanmarki linan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}