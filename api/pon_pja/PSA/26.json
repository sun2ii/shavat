{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"IEOWA kom kotin jauaja ia, pwe I kekeit wei ni melel, I kin liki Ieowa, i jota pan luetala","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Main kom kotin kajaui ia da o kajonejon ia, o kamakelekele mudilik I kan o monion i.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe I aja duen omui kalanan, o I kin weweid ni omui melel.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I jota kin mondi ren aramaj aklapalap akan, o I jota kin waroki on me morjued akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I kin tataki pokon en mejued akan, o i jota kin mondi ren me japun kan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I omiomi ki makelekel o i kin pok on japwilim omui pei jaraui, Main, Ieowa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waja I pan kapikapina, nil laudeta o padak duen omui manaman akan karoj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Main Ieowa, I kin pok on wajan tanpaj omui, o wajan ar linan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kom der kotin kajapoke ia la ianaki me dipan akan, de maur I ianaki me kamela aramaj akan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pwe pa arail me dir en morjued o re ki men ale kijakij.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A nai kin weweid ni makelekel. Dore ia la o kotin maki on ia!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Na I kin aluwei pun. I pan kapina Ieowa nan momodijo kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}