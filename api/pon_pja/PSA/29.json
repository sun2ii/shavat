{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"KOMAIL lapalap akan, wa don leowa, wa don Ieowra wau o manaman!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wa don leowa wau en mar a, poni leowa ni omail kapwat jaraui!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kapiti en leowa mi pon pil akan; Kot en linan kin wiada nanjapwe, iei leowa en pil kalaimun akan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kapiti en leowa me manaman, kapiti en leowa me linan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kapiti en leowa kin katip pajan jeder akan; leowa kin kotin katip pajan jeder akan en Lipanon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A kin kotin kalukaluj irail dueta kau pul amen, Lipanon o Jirion dueta kau pul ol amen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kapiti en leowa kin lujwei dueta umpul en kijiniai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kapiti en leowa kin kamokidada jap tan; leowa kotin kamokidada jap tan en Kadej.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kapiti en leowa kin kamokidada tia kan o kakilejauiada nana kan, o nan tanpaj a im en kaudok karoj kin kapina i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ieowa kotikot pon pil akan o Ieowa pan Nanmarki kokolata.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ieowa pan kamanada japwilim a aramaj akan; Ieowa pan kotin kamaui japwilim a aramaj akan ki popol.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}