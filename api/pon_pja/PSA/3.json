{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"O IEOWA, ai imwintiti me toto, o ir me toto, me kanudi on ia!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Me toto kin inda duen nen i, me dene jota jauaj pa i ren Kot. Jela.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A komui Ieowa pere pa i, o komui pan kotin kalinana ia da, o kamait ia la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I kin likwiri on Ieowa ki nil laud; o a kotin mani ai nidinid jan ni japwilim a dol jaraui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I kin wonon, o mamair, o pirida, pwe Ieowa kin kotin kolekol ia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I jota kin majak jaunpei nen pak toto, me kin kapil ia pena.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kom kotida Main, Ieowa o jauaj a ia, ai Kot! Pwe kom kotin pikir ai imwintiti karoj, o kawelar ni en me japun kan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ieowa me jauaj patail Kom kotin kamauiada japwilim omui aramaj akan! Jela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}