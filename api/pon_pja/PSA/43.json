{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"MAIN Kot! Kotin jauaja ai pun, o kotin ieian ia nan kapun on aramaj jued pukat, o kotin dore ia la jan aramaj likam o morjued akan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe komui Kot en ai kel; da me kom kotin kaje kin ia la? Da me kom kotin mueid on, i en weweidwei ni ai injenjued, ma ai imwintiti kelail on ia?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kom kotin kadarado omui marain o melel, pwe ira en kalua ia, o wa ia lan ni omui dol jaraui o tanpaj omui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pwe i en pedelon on nan pei jaraui en Kot, iei Kot me kaperen pa i o kapol pa i, o i en danke komui Kot ki arp, ai Kot.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nen i, da me koe injenjuedeki o jota moleileiki? Aui aui Kot! Pwe i pan danke i, pwe i jauaj pan maj ai o ai Kot.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}