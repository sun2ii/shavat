{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"KOMAIL kainok karoj lopolop o kapina Kot ki nil kaperen!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe leowa me lapalap kaualap, a meid kalank; i Nanmarki lapalap nin jap akan karoj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A kotin kaloedi on kitail wei kan o aramaj akan pan na atail.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A kotin piladan kitail atail jojo, linan en Iakop, me a kotin pok on.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kot kotida nijinij, o leowa ki nil en koronete kelail.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kauli on Kot pjalm ko! Kaulki pjalm ko! Kauli on atail Nanmarki! Kakaul!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pwe Kot Nanmarki nan jap karoj; komail kaul ki pjalm ni lolekon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kot Nanmarki en men liki kan; Kot kotikot pon mol a jaraui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Jaupeidi en wei kan pokon pena wiala wein Kot en Apraam; pwe pere en mauin nin jappa me japwilim en Kot. A kotin lapalap melel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}