{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"KOE ol weit, da me koe juaikeki me jued, pwe kalanan en leowa kin duedueta ni ran karoj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lo om inon ion me jued, o kin raj on naip kon pot, ni a wia likam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Koe kin mauki lokaia jued jan me mau, o lokaia likam jan me pun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koe kin men lokaiaki me jued lo om likam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I me Kot pil pan kawe uk ala, o lepuk uk pajan, o waik uk jan nan im om, o koko uk jan nan jap en me maur akan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A me pun kan pan kilan o majapwekada, o re pan kaurureki i:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kilan, iei ol o, me jota kaporoporeki leowa, pwe a keleki a dipijou toto o a kelail on a wiada me jued.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A nai dueta tuka oliwe pot nan tanpaj en Kot, i kaporoporeki kalanan en Kot kokolata.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I pan kapina komui kokolata, pwe kom kak kotin wiada; i pan kapina mar omui, pwe a linan ren japwilim omui lelapok kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}