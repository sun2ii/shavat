{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"MAIN Kot, kom kotin jauaj a ia ki mar omui, o kotin kajanjaleda ai pun ki omui manaman.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Main Kot, kom kotin ereki ai kapakap, o kotin mani lokaia en au i.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe men wai kai palian ia, o me weit akan majamajan maur i, o re jota weweid mon Kot.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kilan, Kot jauaj pa i, leowa kin kolekol nen i.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A pan kotin depuk on ai imwintiti kan ar me jued. Kom kotin kawe ir ala ki omui melel.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I ap pan wiai on komui mairon kaperen, o kapina mar omui, pwe a me mau.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pwe a kotin dore ia la jan nan ai apwal akan karoj, o maj ai peren kidar ai imwintiti kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}