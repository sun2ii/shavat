{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"MAIiN, kom der kotin kaloke kin ia omui onion, o der kame kin ia omui onion lapala!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Main, kom kotin maki on ia, pwe nai me luet. Main, kom kotin kamau ia la, Main Ieowa, pwe ti kan me luetalar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Main, kom kotin jaupei don ia, dorela nen i. Kom kotin jauaja ia ni omui kalanan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Main, kom kotin jaupei don ia, dorela nen i. Kom kotin jauaja ia ni omui kalanan!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pwe murin melar jolar me pan tamanda komui; o ij me pan kapina komui wajan mela?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I pana kida ai janejan jan jautik lel manjan; i kawijoki jokela ai loj pil en maj ai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mom ai juede kilar ai injenjued, o i malar, pweki kamakama jak pai me toto.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Komail aramaj morjued akan karoj kaiwei jan ia, pwe Ieowa kotin mani ai janejan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ieowa kotin mani ai nidinid, o Ieowa kotin manier ai kapakap.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ai imwintiti karoj pan namenokela o majakada melel, re pan tanwei o madan jarodi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}