{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"MAIN Kot, kom kotin ereki ai likelikwir o kotin mani ai kapakap!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jan ni imwin jappa i pan likwir won komui, ma monion i majakada, kom pan kotin kalua ia pon paip ileile eu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe komui kapore pa i o imaten kelail on ai imwintiti kan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kom kotin mueid on ia, i en mimieta nan japwilim tanpaj omui kokolata, o diar wajan kamaur pan lim omui kan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pwe komui Kot mani duen ai inau; kom kin kotiki on ia er jojo en ir, me majak mar omui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Komui en kotiki on nanmarki maur warai, pwe a jaunpar akan en totola kokolata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pwe a en mimieta mon Kot kokolata; kom kotin kajale on I kalanan o melel, me pan jinjila i.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I ap pan kauli on mar omui kokolata, pwe i en kapwaiada ai inau kan ni ran karoj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}