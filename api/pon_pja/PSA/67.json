{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"KOT en kotin maki on kit, o kotin kapaia kin kit. A kotin kamaraine kin kit, jilan i.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe japwilim a al akan me janjaleda nin jappa o ren men liki kan a maur.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Main Kot, wei kan pan kapina komui, wei kan karoj pan kapina komui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wei kan pan peren kida o nijinij, pwe kom kin kotin kapun on wei kan ni tiak pun, o kom kotin kaunda aramaj akan nin jappa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Main Kot, wei kan pan kapina komui, wei kan karoj pan kapina komui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jap o kin kapwaiada a tuka kan. Kot pan kotin kapai kit ada, at Kot.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kot pan kotin kapai kit ada, o toun jappa karoj pan majak i!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}