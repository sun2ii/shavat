{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"MAIN Kot kom kotin mada do, dore ia la, Main Ieowa, pwen jauaja ia!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Me kin majamajan ia, en namenokala o jarodi, o me kin peren kida ai apwal akan, en ponjeker wei o lejila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe irail me kin indinda due ai: Io ol o! ren namenokala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A me kin idok komui, en pereperen o popolki komui, o me kin pok on omui maur, en indinda anjau karoj: Kot meid kapinan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A nai me luet o jamama. Main Kot, kom kotin madan don ia, pwe komui ta jauaj pa i o ai jaundor; Main Ieowa, kom der kotin pwand!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}