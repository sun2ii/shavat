{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":75,"content":[{"type":"verse","number":1,"content":[{"text":"Je kapina komui, Main Kot, je kapina komui, pwe mar omui me koren, o omui manaman akan kaloki jili due.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe ni a anjau I pan wiada kapun pun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jap o tou a kan kin rerer; a I kin kolekol a ur akan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I indan me aklapalap akan: Komail der aklapalap! O on me doo jan Kot akan: Komail der keleki omail manaman!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Komail der kaileilada mon omial, komail der kokaia jued ni omail aklapalap.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pwe jota jauajpa jan ni maj en lan de kapin lan, de jan nana en jap tan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pwe Kot, me kin kadeikada, o me kin kajapwilidi amen, o kajapwilada amen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pwe dal eu mi nan lim en Ieowa, me dir en wain kelail, me a kotin kodidodie; a me doo jan Kot akan karoj nan jappa pan nim jan, o re pan nimala moroke.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A I pan padapadak kokolata, o kaulion Kot en Iakop.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I pan kawela mana en me doo jan Kot akan karoj, a mana en me pun kan pan kakairida.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}