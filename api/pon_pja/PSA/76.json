{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":76,"content":[{"type":"verse","number":1,"content":[{"text":"KOT me indand mau ren Iuda, o mar a me linan ren men Ijrael.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tanpaj a im pwal mi nan Jalem, o tanpaj a mi Jion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I waja a kotin katip pajan ia kananan kajik katieu, o pere, o kodlaj, O tatan mauin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Komui me linan o manaman jan dol en mauin kan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Me aklapalap akan lodier on men kul akan o mela, o jaunpei komad karoj en kidi pa arail.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Main Kot en Iakop oj o war kin pupekidi omui majan akan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Komui meid kamajapwek. Ij me kak u mo ’mui ni omui onion?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni omui kotin kajaledar omui kadeik jan nanlan, jappa ap majapwekadar o nenenlar,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ni en Kot a kotidar, pwen kadeik, o jauaja me luet akan karoj nin jappa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pwe makar en aramaj kin kalinanada komui, o ma re pan pur on moromoron, luan omui onion pan itar on irail.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Komail inau on Ieowa omail Kot o kapwaiada. Komail karoj, me mi impa, wa don ren me kalom omail kijakij akan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I me pan atia jan jaupeidi kan ar komad, a meid kalom on nanmarki en jappa kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}