{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"MAIN at Kaun, mar omui meid linan nan jap karoj! Irail kin kapina komui nanlan!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jan nan au en jeri pwelel, o ir me kin kankan didi, re kotin wia kidar manaman eu on omui imwintiti kan, pwe komui en kamela me imwintiti o, o me aktuau o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma i kilekilan lan, dodok en lim omui, jaunipon o uju kan, me re kotin wiadar:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dakot aramaj o, pwe komui kin kotin kupkupura i, de nain aramaj, pwe komui kin kotin apapwali i?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Re kotin kajapwilidier i anjau kij pan tounlan kan, a re kalinanadar i, o kawauialar i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Re kajapwiladaner i wiawia en lim omui kan. Kom kotin kaloedier karoj pan na a kan:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jip o kau kan, o pil man en jap akan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O manpir en pan lan, o mam en nan jed, karoj me kin memaureki nan madau.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"leowa at Kaun, mar omui meid linan nan jap karoj!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}