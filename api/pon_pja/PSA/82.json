{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"KOT kotikot nan momodijou en Kot, o I jaunkapun en kaun akan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Arai da komail pan kadeik japun o kajampwaleki me doo jan Kot akan?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jauaja pun en jamama o japoupou kan, o jauaja me luet o jamama kan ni ar pun!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Komail dorela me tikitik o jamama o, o kamaioda jan nan pa en me doo jan Kot akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A re jota kin duki on, o jota ar lokekon; re kin weweid nan rotorot; pajon en jappa kan karoj mokimokideda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nai indada: Komail rajon kot akan, o nain me lapalap;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ari jo, komail pan mela dueta aramaj akan, o komail pan lokidokila dueta me weit amen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Main Kot, kom kotida o kotin kadeikada jappa, pwe komui pan jojoki men liki kan karoj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}