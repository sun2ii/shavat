madomadon re pan kauleki: Ai parer karoj mi re om!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}