{"translation":{"id":"pon_pja","name":"Kadede Kap Pjam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon","licenseNotes":null,"shortName":"PJA","englishName":"Pohnpeian NT & Psalms, old alphabet","language":"pon","textDirection":"ltr","sha256":"c22b50182be0b7e4667fdf5396aba34f20eb5e8d3fe1a492ade07cdbe54e3dec","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_pja/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_pja","name":"Pjalm","commonName":"Pjalm","title":"PUK EN PJALM.","order":19,"numberOfChapters":150,"sha256":"674ba2093b66729d0cee67f8f4f32edbdaeafe5e19a43f44db9a73fafc8843c5","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_pja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_pja/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":98,"content":[{"type":"verse","number":1,"content":[{"text":"KAKAULEKI on Ieowa kaul kap pot; pwe a kotin wiadar dodok kapuriamui. A kotin kaloe kidi lim a pali maun o lim a jaraui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ieowa kotin kajaledar a kamaur, o mon maj en kainok kan a koti kajanjaledar a pun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A kotin kolekol on men Ijrael a kalanan o melel; imwin jap karoj kin kilan pai en atail Kot.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jap karoj en nijinij on Ieowa! Popol o kauleki pjalm!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kauleki on Ieowa pjalm ianaki laute, wiada laute o kaul!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ian trompete o nil en koronete, komail nijinij on Nanmarki Ieowa!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Madau en nirinirjok o audepa, jappa o tou akan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pilap akan en lopolopeki pa arail; o nana kan en pereperenki.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ieowa, ni a kotidon kadeikada jappa. A pan kotin kadeikada jappa nin tiak pun o kainok kan nin tiak inen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_pja/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_pja/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_pja/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}