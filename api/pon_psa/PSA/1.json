{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"MEID pai ol o, me sota alialu ni padak en me doo sang Kot akan, o me so duki ong me dipan akan, o me so mondi ren me malaun akan,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A me kin peren kida kapung en Ieowa o madamadaua duen a kapung ni ran o ni pong!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A rasong tuka pot, me padedier ni kailan pilap akan, me kin kapareda wa ni a ansau, o ta kan sota kin mongala, a karos a wiawia pwaida.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Me doo sang Kot akan sota kin dueta, a re rasong dip me ang kin iririp sili.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I me doo sang Kot akan sota pan pwai kida nan kadeik, o me dipan akan nan momod en me pung kan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pwe Ieowa kotin mangi al en me pung kan; a al en ir, me doo sang Kot akan, pan soredi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":6}