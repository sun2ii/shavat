{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":101,"content":[{"type":"verse","number":1,"content":[{"text":"I pan kauleki duen kalangan o pung; i pan kauleki psalm akan ong komui. Maing Ieowa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I men inen eweita ni al pung — iad kom pan koti dong ia? — i men weweid ni melel ren toun im ai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I sota men wia morsued; i tataki wiawian me dipan akan, a sota pan pat ong ia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mongiong sapung pan muei sang ia; i sota men asa duen me sued.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Me kin rir karaunemali men impa, i pan kamela; i suedeki me aklapalap ni mas ar o mongiong arail.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mas ai pan apapwali me melel akan nan sap o, pwe ren kauson re i; me kin weweid ni al pung, pan papa ia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Me kin kotaue, sota pan kauson nan im ai, me kin likam, sota pan pwaida mon mas ai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni mansang karos i pan kawela me katiwo nan sap o, pwen kokosang kanim en Ieowa karos, me kin wia sapung.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}