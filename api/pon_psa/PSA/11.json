{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"I LIKI Ieowa, a menda komail indang ngen i: Piridalang pon omail nana dueta manpir amen?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe kilang, me doo sang Kot akan kaonopadar kasik katieu o pwilikidi ar kanang en kasik katieu pon sal o, pwen rir kasikiedi me melel ni mongiong arail.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe ma ur akan rongk pasang, da me aramas pung en wiada?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ieowa kotikot nan tanpas a saraui, mol en Ieowa mimi nanlang, silang i kin mamasani sili, kil en silang i kin sosong aramas akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ieowa kotin song me pung, ap kotin tataki me sapung o morsued.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A pan kotin kamoredi ong me doo sang Kot akan liol, o kisiniai, o swepel, o a pan katinge kin irail melimel.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ieowa me pung o a kotin pok ong me pung. Silang i irerong ong me melel o.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}