{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"IEOWA kotin masani ong ai Kaun, mondi ong ni pali maun i, lao I pan wia kida om imwintiti utipan nä om.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ieowa pan kotin kadarado sokon en wei omui sang nan Sion; kakaun nan pung en omui imwintiti kan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Murin omui poedier, sapwilim omui kan pan pereperen, wia mairong ong komui ni ar kapwat saraui. Sapwilim omui seri kan pan ipwidi ong komui dueta poik en ni mansang.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ieowa kotin kaula, o a sota pan kalula: Komui samero soutuk amen, duen al en Melkisedek.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kaun o kotikot ni pali maun om a pan kamela nanmarki kan ni ran en a ongiong.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A pan kotin kaunda nan pung en men liki kan, a pan kadir kila kalep akan wasa karos, a kotin palang pasang tapwi en wei lapalap.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A pan nima sang pil ni kailan al, i me a pan sara kida.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}