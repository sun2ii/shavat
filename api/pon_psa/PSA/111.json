{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"I PAN kapinga Ieowa sang nan mongiong i nan pung en me lelapok kan o nan momodisou.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Meid laud wiawian Ieowa kan, ir me insenoki, pan dedeki due.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A wiawia kan me pung o lingan, o a pung pan duedueta kokolata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A manaman akan men kataman eu. Ieowa me dir en mak o kalangan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A kotin kamanga ir, me masak i, a kin kolekol sapwilim a inau kokolata.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A kotin kasansale ong sapwilim a aramas akan mana en a wiawia kan, pwen kotiki ong ir soso en men liki kan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dodok en lim a kan me melel o pung; sapwilim a masan kan karos me melel.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Re pan duedueta kokolata, o re wiauier ni melel o pung.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A kotiki ong sapwilim a kan saunkamaur, o a kupureda, me a inau pan duedueta kokolata; mar a me saraui o kalom.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Masak Ieowa iei tapin pan lolekong; irail meid pai, me kin wia due met, pwe a pai pan potopot eta.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}