{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"KOMAIL ladun Ieowa kapinga mar en Ieowa!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mar en Ieowa en pakapingala sang met o kokolata!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mar en Ieowa en pakapingala sang wasan katipin a dakada ia lel wong wasa me a kin kirila ia!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ieowa me ileila sang men liki kan karos, a lingan mi ponangin nanlang.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Is me rasong Ieowa atail Kot, me kotikot pon mol a ileile melel?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Me kotin irerong me tikitik kan nanlang o nin sappa?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Me kotin kasapwilada me tikikit o sang nan pwel par, o sang nan pwel me samama o,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pwen kamondi i ren me lapalap akan, ren me lapalap en sapwilim a aramas akan;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Me kotin sauasa li dapwan men, pwen wiala en ol oko ar nono peren amen. Aleluia!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}