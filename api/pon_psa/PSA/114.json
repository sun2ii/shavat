{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Ni ansau men Israel lipa sang Äkipten, kadaudok en Iakop sang nan wai,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I ansau men Iuda wiala sapwilim a saraui kan, o men Israel sapwilim a wei.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Madau kilanger, ap tangwei, o Iordan pal pasanger;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nana kan lusilus dueta sip ol, o dol akan dueta sippul akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Madau, da me koe tangweier ki? Koe Iordan, da me koe palki pasanger?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Komail nana kan, da me komail lusiluski dueta sip ol, o komail dol akan dueta sippul akan?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sappa, koe en rerer mon Ieowa, mon Kot en Iakop,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Me kotin kawuki ong len pil paip o, o kantakai ong utun pil.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}