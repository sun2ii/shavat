{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"MAING kom kotin sauasa, pwe me lelapok kan malaulaular, o me melel akan me malaulau ren aramas akan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Irail kin lokaia likam, amen amen ong men impa, re lokaiaki lol riapot.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ieowa pan kotin usada kil en au karos me lingkaping o lo, me kin lokaia wei ni aklapalap.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Me kin indinda: Lo atail, me kit pan pwai kida, o kil en au at me kit keleki; is at kaun?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ieowa kotin masani: I pan uda, pweki kankangeranger en me luet akan o sangesang en me samama kan: I pan sauasa i, me kin inong iong.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Masan en Ieowa me makelekeleta silper, me kamakelekel kidar nan dal pwel en kisiniai pan pak isu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Komui Maing, pan kotin pera irail, o sinsila mon di wet kokolata.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pwe me sapung kan pan totolar wasa karos, ma aramas sued pukat kin kaunda aramas akan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}