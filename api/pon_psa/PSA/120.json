{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"NI ai apwal akan i likwir wong Ieowa, a ap kotin mangi ia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maing Ieowa, kotin dore ia la, sang au en me kin likam, o lo en kotaue.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Da me lo likam kak wiai ong uk, o da me a kak kapwaiada?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A rasong kanangan kasik katieu kong kan ren me kelail amen, dueta kisiniai nan alek.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Meid apwal ong ia, ai kairu nan Mesek, o ai kauson impan im en men Kedar!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Meid warai ong ai kaukauson ren aramas akan me kin tataki muei mau.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I inong iong muei mau, a ni ai pan lokaia, re kin mauki mauin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}