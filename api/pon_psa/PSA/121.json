{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"I SARADANG nana kan, wasa sauas pa i pan pwarado sang ia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sauas pa i pan pwarado sang ren Ieowa, me kotin kapikadar lang o sappa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A sota pan kotin mueid ong nä om, en krisedi; o me kin sinsila uk, sota kin saimokala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kilang, sile pan Israel sota kin saimok de saimok kalik.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ieowa iei sile pa om, Ieowa iei motan pa om pali maun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Katipin sota pan dakar uk nin ran de maram ni pong.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ieowa pan kotin pera wei sang uk song en sued karos, a pan kotin sinsila ngen om.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ieowa pan kotin sinsila uk ni om pedoi o pedelong, sang met o kokolata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}