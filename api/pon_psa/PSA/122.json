{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"I PEREN kida ar indai ong ia: Kitail en kolang nan tanpas en Ieowa!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nä at akan pan mi ni wanim en kel en Ierusalem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ierusalem kanim eu me kakaudar, pwen kanim kelail eu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wasa me kainok kan kin momaitala ia, kainok en Ieowa kan, saunkadede en Israel, pwen kapinga mar en Ieowa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pwe i wasa me mol en kadeik mi ia, mol en kadaudok en Dawid.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Poeki ong Ierusalem a pai kan! Me kin pok ong uk, en paida!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Muei mau en mi ni om kel, o pai nan om im akan!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I pan kapakapa kin uk pweki ri ai o kompoke pai kan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I pan rapaki ong uk me mau melel, pweki tanpas en Ieowa at Kot.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}