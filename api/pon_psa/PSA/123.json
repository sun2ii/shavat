{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":123,"content":[{"type":"verse","number":1,"content":[{"text":"I KIN sarada wong komui, me kotikot nanlang.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kilang, duen mas en ladu kan kin kilekilang lim en ar saumas akan, o duen mas en lidu kan kin kilekilang a saumas li, iduen mas at kin ariri Ieowa at Kot, a lao kotin maki ong kit.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maing Ieowa, kom kotin maki ong, kotin maki ong kit! Pwe kit me dir en namenok.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Moniong i toutouki en me sued akan ar mamale kin kit o en me aklapalap akan ar kanamenok kin kit.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}