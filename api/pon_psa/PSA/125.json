{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"Me liki Ieowa kin rasong dol Sion, me sota kin mokid, a pan potopot eta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Duen dol akan kin kapil pena Ierusalem, iduen Ieowa kin kotikot ren sapwilim a aramas akan, sang met o kokolata.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe sokon en me doo sang Kot akan sota pan mimieta ren kisin pwin en me pung kan, pwe me pung kan ender kapa wong pa ar kan nin sapung.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Maing Ieowa, kotin kasansaleda omui kalangan ong me mau kan o ong ir, me melel nan mongiong arail.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A me kin wuki wong ni al sapung, Ieowa pan kotin paki irail wei iangaki me sued akan. Israel en popol!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}