{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"NI ansau Ieowa kotin kapuredor me salidi en Israel akan, kit rasong ir, me auramen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I ansau au at me dir en kaurur, o lo at me dir en ngisingis. I ansau men iki kan ap inda: Meid laud dodok en Ieowa re ’rail!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Melel, dodok en Ieowa meid laud ong kit er, o i me se kin peren kida.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Maing Ieowa, re kotin kapuredo at salidi kan dueta pilap en sap en pali air akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Me kamore kidi pil en mas arail, pan dolung ni peren.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Re kin weweidki sangesang, o kin wewa wa kasampwal, a ni ar puredo, re pan peren, wado ar kap en wa kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}