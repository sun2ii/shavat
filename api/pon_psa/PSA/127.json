{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"MA Ieowa sota pan kauada im o, dodok en pwin sause sota pan katepa; ma Ieowa sota pan sinsila kanim o, saunmasamasan pan masamasan mal.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sota katepa ong komail, ma komail pan paurida nin soran, ap pil pwand kamol ni pong, o toutouki okotme, ni omail mangamanga, pwe a kin kakepwapwala sapwilim a kompokepa kan ni ar mamair.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kilang, seri ko iei kisakis eu sang ren Ieowa, o wan aramas pai eu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Duen kanangan kasik katieu nan pa en ol komad amen, iduen putak ko ar pan pwaida.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Meid pai ol o, me a lepan me direki mepukat! Re sota pan sarodi, ni ar kapung pena ren ar imwintiti kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}