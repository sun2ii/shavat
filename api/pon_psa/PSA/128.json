{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"MEID pai karos, me kin masak Ieowa, me kin weweid nan sapwilim a al akan!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe koe pan memaureki dodok en pa om akan, koe meid pai o pwaida mau.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Om paud pan rasong tuka en wain pot, me wa mau nan im om, o noum seri kan pan dueta paini, me kapwata om tepel.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kilang, iduen ol o, me masak Ieowa, a pan pwaida.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ieowa pan kapai uk ada sang nan Sion, pwe koe en kilang pai en Ierusalem arain om maur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O koe pan kilang seri eu noum seri ko. Israel en popol!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}