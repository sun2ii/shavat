{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"ISRAEL en inda: Re katoutou ia melel sang ni ai tikitik lel met pak toto.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pan pak toto re katoutou ia melel sang ni ai tikitik lel met; ari so, re sota kak kaloe ia di.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Men sapasap weirada pon tinsau ai, wiadar warawar reirei.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A Ieowa me pung, a kotin lepuk pasanger sal en me doo sang Kot akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Karos me kin tataki Sion, en sarodi o tangwei!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ren rasong rä pon os en im o, me kin mong pena mon a pan ususda!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Me sota kin kadirela kumut en pa en saundolung, de pa en me kin pir pena kap akan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pwe me kin daulul wasa o, ren der inda: Kot en kotin kupura maui komail! Kit kapai komail da ni mar en Ieowa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}