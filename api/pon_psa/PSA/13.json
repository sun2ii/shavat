{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"MAING arai da kom pan kotin malie ia la? Arai da komui pan kotin karirila silang omui mo i?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Arai da i en perki nan lol ai o salo mi nan mongiong i ran karos? Arai da ai imwintiti en kaurur kin ia?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maing ai Kot, kom kotin masan dong ia o sapeng ia. Kom kotin kamaraini mas ai, pwe i ender mela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pwe ai imwintiti ender inda: I kaloedier i. O me palian ia ender perenki ai pupedier.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A i kin liki omui kalangan; mongiong i en peren kida omui kotin sauasa ia. I pan kauleki Ieowa duen a kotin wiawia mau ong ia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":5}