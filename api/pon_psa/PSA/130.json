{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"MAING Ieowa, i kin likwirda wong komui sang nan wasa lol.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maing, kotin ereki ngil ai! Karong omui en mamangi ai ngidingid!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma komui Ieowa, pan kotin kapokonki ong aramas dip akan, Maing, is me ap pan kak kasinenda mo ’mui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A komui kin kotin mak, pwe aramas en masak komui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I kin auiaui Ieowa, ngen i kin auiaui, o i kin auiaui a inau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ngen i kin auiaui Kaun o, sang saunmasamasan kin auiaui mansang, saunmasamasan kin auiaui mansang.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel auiaui Ieowa, pwe Ieowa me kalangan, o wasa en kamaio mi re a;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A pan kotin dorela Israel sang dip a kan karos.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}