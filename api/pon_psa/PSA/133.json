{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":133,"content":[{"type":"verse","number":1,"content":[{"text":"KILANG, meid kaselel, ma pirien eu kauson pena ni limpok!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A dueta le pon kadokenmai, me kin kerekeredi nan alis en Aron, me kin kerekeredi ni imwin a likau;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dueta poik en Ermon, me kin moredi pon dol en Sion kan, pwe i wasa, me Ieowa pan kotin kapaiada o kamaurada kokolata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}