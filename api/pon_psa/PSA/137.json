{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"KIT momoder ni kailan pilap en Papel akan o sangesang, ni at tamanda Sion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kit langadar at arp akan nin tuka kan, me mi wasa o,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe me sali kit edi inda, sen kaul, o sen pereperen ni at mamaiei: Komail wiai ong kit kaul apot duen Sion.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iaduen at pan kak wiada kaul ong Ieowa nan sap en men wai?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma i pan monoke uk ala Ierusalem, pa i pali maun ap pil pan monokinokla.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lo i pan pas ong pan ngatangat ai, ma i solar pan taman uk adar, ma i solar pan peren kida Ierusalem mon meakaros.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Maing Ieowa, kom kotin tamanda en men Edom ar lokolokaia ni ran apwal en Ierusalem: Kawela, kawela lao lel ong nan pwel!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Toun Papel, morsued koe, re meid pai, me pan wiai ong uk duen me koe wiadar!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Meid pai ir, me pan koledi noum seri pwelel o kasuk pasang nin takai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}