{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":142,"content":[{"type":"verse","number":1,"content":[{"text":"I LIKWIRKI ngil laud ong Ieowa. Ki ngil ai i kin ngidingideki ong Ieowa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I kin kasansale ong i ai apwal akan, o i padaki ong i katoutou pa i kan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ngen i lao luetala, kom ap pan kotin apapwali. Irail rir wiai ong ia insar eu liman al, me i kin weid ia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I kilang ni pali maun i, ari sota, me men sauasa ia; i sota kak pitila, pwe sota me kin idok ia.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maing Ieowa, i likwir wong komui, o potoan: Komui me ai paip, o pwais ai nan sap en me maur akan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kom kotin mangi ai weriwer, pwe ngai meid luet; dore ia la sang me kin pakipaki ia; pwe ngai sota itar ong ir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kalua sang ngen i nan imateng, pwe i en kapinga mar omui. Me pung kan pan pokon dong ia, ma kom pan kotin sauasa ia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}