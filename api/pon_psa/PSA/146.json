{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"NGEN i kapinga Ieowa!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I pan kapinga Ieowa arain ai maur, i pan kauleki psalm akan ong ai Kot arain maur i.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Der kaporoporeki saupeidi kan, pwe irail aramas o sota kak sauasa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pwe ngen en aramas udan a pan kokola, o a pan pur ong wiala pwel, i ran ota a solar kak madamadaua meakot.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Meid pai me sauas parail Kot en Iakop, me kin kaporoporeki Ieowa a Kot,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Me kotin kapikadar lang o sappa, o madau, o audepa rail karos, me kin melel potopot eta,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Me kotin sauasa pung en me lodi ong kalokolok mal, me kamanga me men mangadar. Ieowa kin kotin lapwada me salidi kan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ieowa kin kotin kapad pasang mas en me maskun akan. Ieowa kin kotin kainsenemaula me mauk; Ieowa kin kotin pok ong me pung kan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ieowa kin kotin sinsila men wai kan, o sauasa me sapoupou o li odi kan, ap kotin kawela al en me doo sang Kot akan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ieowa iei Nanmarki soutuk, om Kot Sion kokolata. Aleluia!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}