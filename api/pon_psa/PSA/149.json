{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"KAULEKI kaul kap pot ong Ieowa; pokon saraui en kapinga i.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Israel en peren kida i, me kotin wia irail da; seri en Sion en peren kida arail Nanmarki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ren kapinga mar a ni pwin en pokol; ren wia aip o arp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pwe Ieowa kotin peren kida sapwilim a aramas akan; a kotin kapwate kin me luet akan lingan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lelapok kan en pereperen o kapinga, o ngisingis pon ki arail akan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Au arail en kapinga Kot, o kodlas kong en mi nan pa arail.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pwe ren depuk ong men liki kan, o kaloke wei kan,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pwen salie kidi arail nanmarki kan sal, o me kasampwal re ’rail ki sal mata,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pwe ren kapwaiada kalokolok, me kileledi ong irail er mas o. Iduen wau en sapwilim a lelapok kan. Aleluia!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}