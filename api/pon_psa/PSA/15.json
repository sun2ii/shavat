{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"MAING, is me pan kaukauson nan tanpas omui? Is me pan mimieta pon sapwilim omui dol saraui?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Me kin kekeitwei ni makelekel, o me kin wia me pung, o me kin lokaia melel sang nan mongiong;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Me sota karaun mal ki lo a, o me sota kin wia mesued ong men imp a;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Me kin mamaleki me lokidokilar o, ap kakaki me masak Ieowa kan, o me kin kaula melel, menda ma a suedi ong pein i;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Me sota pan piti sang en amen na moni, o me sota pan ale kisakis, pwen kawela me pung amen. Ari, me kin apwali mepukat, sota pan luetala kokolata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}