{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"IEOWA en kotin mangi om kapakap ni ran apwal o; mar en Kot en Iakop en pera uk!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A en kotin porone dong uk sauas pam sang nan tanpas saraui o kamana uk ada sang nan Sion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A en kotin kupura om mairong karos, o om mairong isis en konkon re a. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A en kotiki ong uk, me mongiong om anane, o kotin kapaiada om inong karos.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Se pan ngisingiski omui sauasa kit, o ni mar en atail Kot kit pan kida at plak. Ieowa en kotin kapwaiada om poekipoek karos!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I ap asaer, me Ieowa kin kotin dorela sapwilim a me keiedier, o a pan mangi i sang nan sapwilim a lang saraui, lim a pali maun kin sauasa kaualap.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mo kan kin kaporoporeki war o os akan; a kit kin keleki mar en Ieowa atail Kot.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Irail lodier o pupedier, a kit uda o kasinenda.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Maing kom kotin sauasa nanmarki o, o kotin mangi at likwir ong komui!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}