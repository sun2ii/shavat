{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"IEOWA sile pa i, i sota pan anane meakot.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A kotin kamanga ia nan mos kaselel o kalua ia wong ni pil lamelamur.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A kotin kamanada ngen i, a kalua ia pon al pung pweki mar a.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I lao weid nan mot en mela, i sota pan masak mesued kot, pwe kom kotin ieiang ia, omui irar o lepin saipali kamait ia la.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kom kotin kaonop dang ia tepel eu salong ai imwintiti kan. Kom kotin keiekidi mong ai le, o ai dal kin wudewudok.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pai o kalangan pan idauen ia arain ai maur, o i pan mimieta nan tanpas en Ieowa kokolata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}