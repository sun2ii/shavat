{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"SAPWILIM en Ieowa sappa o audepa kan, sap o meakaros me kauson poa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe a kotin pasonedier ni kailan madau, o a kotin wiadar pon pil akan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Is me pan kodalang pon dol en Ieowa? O is me pan kak uda ni mol en Ieowa saraui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Me pa a kan sota sapung o mongiong i makelekel; me sota kin mauki padak sapung, o me sota kin kaula likam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I me pan kamaula ren Ieowa, o a pan pung kila ren Kot a saunkamaur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I kainok, me kin peiki ong Kot, me kin rapaki silang omui, Kot en Iakop. Sela.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Komail ritingada wanim laud o langada wanim nin sappa, pwe Nammarki lingan en kotilong!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Is Nanmarki lingan men et? I Ieowa roson o manaman, Ieowa me rasong nan mauin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Komail ritingada wanim laud o langada wanim nin sappa, pwe Nanmarki lingan en kotilong!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Is Nanmarki lingan men et? I Ieowa Sepaot; I Nanmarki lingan. Sela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}