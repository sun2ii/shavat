{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"IEOWA kom kotin sauasa ia, pwe i kekeit wei ni melel. I kin liki Ieowa, i sota pan luetala.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maing kom kotin kasaui ia da o kasongesong ia, o kamakelekele mudilik i kan o mongiong i.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe i asa duen omui kalangan, o i kin weweid ni omui melel.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I sota kin mondi ren aramas aklapalap akan, o i sota kin waroki ong me morsued akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I kin tataki pokon en mesued akan, o i sota kin mondi ren me sapung kan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I omiomi ki makelekel o i kin pok ong sapwilim omui pei saraui, Maing, Ieowa,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wasa i pan kapikapinga, ngil laudeta o padak duen omui manaman akan karos.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Maing Ieowa, i kin pok ong wasan tanpas omui, o wasan ar lingan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kom der kotin kasapoke ia la iangaki me dipan akan, de maur i iangaki me kamela aramas akan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pwe pa arail me dir en morsued o re ki men ale kisakis.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A ngai kin weweid ni makelekel. Dore ia la o kotin maki ong ia!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nä i kin aluwei pung. I pan kapinga Ieowa nan momodisou kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}