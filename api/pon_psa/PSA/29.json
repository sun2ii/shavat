{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"KOMAIL lapalap akan, wa dong Ieowa, wa dong Ieowa wau o manaman!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wa dong Ieowa wau en mar a, pongi Ieowa ni omail kapwat saraui!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kapiti en Ieowa mi pon pil akan; Kot en lingan kin wiada nansapwe, iei Ieowa en pil kalaimun akan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kapiti en Ieowa me manaman, kapiti en Ieowa me lingan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kapiti en Ieowa kin katip pasang seder akan; Ieowa kin kotin katip pasang seder akan en Lipanon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A kin kotin kalukalus irail dueta kau pul amen, Lipanon o Sirion dueta kau pul ol amen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kapiti en Ieowa kin luswei dueta umpul en kisiniai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kapiti en Ieowa kin kamokidada sap tan; Ieowa kotin kamokidada sap tan en Kades.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kapiti en Ieowa kin kamokidada tia kan o kakilesauiada nana kan, o nan tanpas a im en kaudok karos kin kapinga i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ieowa kotikot pon pil akan o Ieowa pan Nanmarki kokolata.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ieowa pan kamanada sapwilim a aramas akan; Ieowa pan kotin kamaui sapwilim a aramas akan ki popol.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}