{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"O IEOWA, ai imwintiti me toto, o ir me toto, me kangudi ong ia!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Me toto kin inda duen ngen i, me dene sota sauas pa i ren Kot. Sela.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A komui Ieowa pere pa i, o komui pan kotin kalingana ia da, o kamait ia la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I kin likwiri ong Ieowa ki ngil laud; o a kotin mangi ai ngidingid sang ni sapwilim a dol saraui. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I kin wonon, o mamair, o pirida, pwe Ieowa kin kotin kolekol ia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I sota kin masak saunpei nen pak toto, me kin kapil ia pena.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kom kotida Maing, Ieowa o sauasa ia, ai Kot! Pwe kom kotin pikir ai imwintiti karos, o kawelar ngi en me sapung kan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ieowa me sauas patail. Kom kotin kamauiada sapwilim omui aramas akan! Sela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}