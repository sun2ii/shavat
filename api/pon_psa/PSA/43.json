{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"MAING Kot! Kotin sauasa ai pung, o kotin ieiang ia nan kapung ong aramas sued pukat, o kotin dore ia la sang aramas likam o morsued akan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe komui Kot en ai kel; da me kom kotin kase kin ia la? Da me kom kotin mueid ong, i en weweidwei ni ai insensued, ma ai imwintiti kelail ong ia?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kom kotin kadarado omui marain o melel, pwe ira en kalua ia, o wa ia lang ni omui dol saraui o tanpas omui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pwe i en pedelong ong nan pei saraui en Kot, iei Kot me kaperen pa i o kapol pa i, o i en danke komui Kot ki arp, ai Kot.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ngen i, da me koe insensuedeki o sota moleileiki? Auiaui Kot! Pwe i pan danke i, pwe i sauas pan mas ai o ai Kot.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}