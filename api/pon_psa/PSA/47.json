{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"KOMAIL kainok karos lopolop o kapinga Kot ki ngil kaperen!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe Ieowa me lapalap kaualap, a meid kalank; i Nanmarki lapalap nin sap akan karos.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A kotin kaloedi ong kitail wei kan o aramas akan pan nä atail.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A kotin piladang kitail atail soso, lingan en Iakop, me a kotin pok ong. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kot kotida ngisingis, o Ieowa ki ngil en koronete kelail.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kauli ong Kot psalm ko! Kaulki psalm ko! Kauli ong atail Nanmarki! Kakaul!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pwe Kot Nanmarki nan sap karos; komail kaul ki psalm ni lolekong.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kot Nanmarki en men liki kan; Kot kotikot pon mol a saraui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Saupeidi en wei kan pokon pena wiala wein Kot en Apraam; pwe pere en mauin nin sappa me sapwilim en Kot. A kotin lapalap melel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}