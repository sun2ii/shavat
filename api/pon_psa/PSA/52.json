{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"KOE ol weit, da me koe suaikeki me sued, pwe kalangan en Ieowa kin duedueta ni ran karos.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lo om inong iong me sued, o kin rasong naip kong pot, ni a wia likam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Koe kin mauki lokaia sued sang me mau, o lokaia likam sang me pung. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koe kin men lokaiaki me sued lo om likam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I me Kot pil pan kawe uk ala, o lepuk uk pasang, o waik uk sang nan im om, o koko uk sang nan sap en me maur akan. Sela.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A me pung kan pan kilang o masapwekada, o re pan kaurureki i:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kilang, iei ol o, me sota kaporoporeki Ieowa, pwe a keleki a dipisou toto o a kelail ong a wiada me sued.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A ngai dueta tuka oliwe pot nan tanpas en Kot, i kaporoporeki kalangan en Kot kokolata.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I pan kapinga komui kokolata, pwe kom kak kotin wiada; i pan kapinga mar omui, pwe a lingan ren sapwilim omui lelapok kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}