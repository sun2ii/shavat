{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"MAING Kot, kom kotin sauasa ia ki mar omui, o kotin kasansaleda ai pung ki omui manaman.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maing Kot, kom kotin ereki ai kapakap, o kotin mangi lokaia en au i.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe men wai kai palian ia, o me weit akan masamasan maur i, o re sota weweid mon Kot. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kilang, Kot sauas pa i, Ieowa kin kolekol ngen i.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A pan kotin depuk ong ai imwintiti kan ar me sued. Kom kotin kawe ir ala ki omui melel.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I ap pan wiai ong komui mairong kaperen, o kapinga mar omui, pwe a me mau.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pwe a kotin dore ia la sang nan ai apwal akan karos, o mas ai peren kidar ai imwintiti kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}