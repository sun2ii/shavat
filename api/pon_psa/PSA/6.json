{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"MAING, kom der kotin kaloke kin ia omui ongiong, o der kame kin ia omui ongiong lapala!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maing, kom kotin maki ong ia, pwe ngai me luet. Maing, kom kotin kamau ia la, Maing Ieowa, pwe ti kan me luetalar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O ngen i waponda melel. O Maing, arai da?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Maing, kom kotin saupei dong ia, dorela ngen i. Kom kotin sauasa ia ni omui kalangan!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pwe murin melar solar me pan tamanda komui; o is me pan kapinga komui wasan mela?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I panga kida ai sangesang sang sautik lel mansang; i kawisokisokela ai los pil en mas ai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mom ai suede kilar ai insensued, o i malar, pweki kamakamasak pai me toto.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Komail aramas morsued akan karos kaiwei sang ia, pwe Ieowa kotin mangi ai sangesang.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ieowa kotin mangi ai ngidingid, o Ieowa kotin mangier ai kapakap.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ai imwintiti karos pan namenokela o masakada melel, re pan tangwei o madang sarodi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}