{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"MAING Kot, kom kotin ereki ai likelikwir o kotin mangi ai kapakap!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sang ni imwin sappa i pan likwir wong komui, ma mongiong i masakada, kom pan kotin kalua ia pon paip ileile eu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe komui kapore pa i o imateng kelail ong ai imwintiti kan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kom kotin mueid ong ia, i en mimieta nan sapwilim tanpas omui kokolata, o diar wasan kamaur pan lim omui kan. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pwe komui Kot mangi duen ai inau; kom kin kotiki ong ia er soso en ir, me masak mar omui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Komui en kotiki ong nanmarki maur warai, pwe a saunpar akan en totola kokolata,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pwe a en mimieta mon Kot kokolata; kom kotin kasale ong i kalangan o melel, me pan sinsila i.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I ap pan kauli ong mar omui kokolata, pwe i en kapwaiada ai inau kan ni ran karos.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}