{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"KOT en kotin maki ong kit, o kotin kapaia kin kit. A kotin kamaraine kin kit, silang i. Sela.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe sapwilim a al akan me sansaleda nin sappa o ren men liki kan a maur.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maing Kot, wei kan pan kapinga komui, wei kan karos pan kapinga komui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wei kan pan peren kida o ngisingis, pwe kom kin kotin kapung ong wei kan ni tiak pung, o kom kotin kaunda aramas akan nin sappa. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maing Kot, wei kan pan kapinga komui, wei kan karos pan kapinga komui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sap o kin kapwaiada a tuka kan. Kot pan kotin kapai kit ada, at Kot.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kot pan kotin kapai kit ada, o toun sappa karos pan masak i!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}