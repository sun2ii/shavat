{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"MAING Kot kom kotin madangdo, dore ia la, Maing Ieowa, pwen sauasa ia!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Me kin masamasan ia, en namenokala o sarodi, o me kin peren kida ai apwal akan, en ponseker wei o lesila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pwe irail me kin indinda due ai: Io ol o! Ren namenokala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A me kin idok komui, en pereperen o popolki komui, o me kin pok ong omui maur, en indinda ansau karos: Kot meid kapingan!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A ngai me luet o samama. Maing Kot, kom kotin madang dong ia, pwe komui ta sauas pa i o ai saundor; Maing Ieowa, kom der kotin pwand!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}