{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":75,"content":[{"type":"verse","number":1,"content":[{"text":"Se kapinga komui, Maing Kot, se kapinga komui, pwe mar omui me koren, o omui manaman akan kaloki sili due.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwe ni a ansau I pan wiada kapung pung.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sap o tou a kan kin rerer; a I kin kolekol a ur akan. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I indang me aklapalap akan: Komail der aklapalap! O ong me doo sang Kot akan: Komail der keleki omail manaman!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Komail der kaileilada mong omail, komail der lokaia sued ni omail aklapalap.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pwe sota sauaspa sang ni mas en lang de kapin lang, de sang nana en sap tan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pwe Kot, me kin kadeikada, o me kin kasapwilidi amen, o kasapwilada amen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pwe dal eu mi nan lim en Ieowa, me dir en wain kelail, me a kotin kodidodie; a me doo sang Kot akan karos nan sappa pan nim sang, o re pan nimala moroke.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A i pan padapadak kokolata, o kauli ong Kot en Iakop.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I pan kawela mana en me doo sang Kot akan karos, a mana en me pung kan pan kakairida.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}