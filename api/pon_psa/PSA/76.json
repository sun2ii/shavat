{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":76,"content":[{"type":"verse","number":1,"content":[{"text":"KOT me indand mau ren Iuda, o mar a me lingan ren men Israel.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tanpas a im pwal mi nan Salem, o tanpas a mi Sion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I wasa a kotin katip pasang ia kanangan kasik katieu, o pere, o kodlas, o tatan mauin. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Komui me lingan o manaman sang dol en mauin kan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Me aklapalap akan lodier ong men kul akan o mela, o saunpei komad karos en kidi pa arail.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maing Kot en Iakop os o war kin pupekidi omui masan akan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Komui meid kamasapwek. Is me kak u mo ’mui ni omui ongiong?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni omui kotin kasaledar omui kadeik sang nanlang, sappa ap masapwekadar o nenenlar,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ni en Kot a kotidar, pwen kadeik, o sauasa me luet akan karos nin sappa. Sela.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pwe makar en aramas kin kalinganada komui, o ma re pan pur ong moromorong, luan omui ongiong pan itar ong irail.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Komail inau ong Ieowa omail Kot o kapwaiada. Komail karos, me mi impa, wa dong ren me kalom omail kisakis akan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I me pan atia sang saupeidi kan ar komad, a meid kalom ong nanmarki en sappa kan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}