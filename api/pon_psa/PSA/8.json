{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"MAING at Kaun, mar omui meid lingan nan sap karos! Irail kin kapinga komui nanlang!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sang nan au en seri pwelel, o ir me kin kangkang didi, re kotin wia kidar manaman eu ong omui imwintiti kan, pwe komui en kamela me imwintiti o, o me aktuau o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma i kilekilang lang, dodok en lim omui, saunipong o usu kan, me re kotin wiadar:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dakot aramas o, pwe komui kin kotin kupkupura i, de nain aramas, pwe komui kin kotin apapwali i?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Re kotin kasapwilidier i ansau kis pan tounlang kan, a re kalinganadar i, o kawauialar i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Re kasapwiladanger i wiawia en lim omui kan. Kom kotin kaloedier karos pan nä a kan:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sip o kau kan, o pil man en sap akan,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O manpir en pan lang, o mam en nan sed, karos me kin memaureki nan madau.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ieowa at Kaun, mar omui meid lingan nan sap karos!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}