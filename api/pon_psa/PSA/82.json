{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"KOT kotikot nan momodisou en Kot, o i saunkapung en kaun akan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Arai da komail pan kadeik sapung o kasampwaleki me doo sang Kot akan? Sela.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sauasa pung en samama o sapoupou kan, o sauasa me luet o samama kan ni ar pung!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Komail dorela me tikitik o samama o, o kamaioda sang nan pa en me doo sang Kot akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A re sota kin duki ong, o sota ar lokekong; re kin weweid nan rotorot; pason en sappa kan karos mokimokideda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ngai indada: Komail rasong kot akan, o nain me lapalap;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ari so, komail pan mela dueta aramas akan, o komail pan lokidokila dueta me weit amen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Maing Kot, kom kotida o kotin kadeikada sappa, pwe komui pan sosoki men liki kan karos.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}