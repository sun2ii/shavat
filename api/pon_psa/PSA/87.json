{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"A kakaudar mau pon dol saraui kan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ieowa kotin kupura wanim en Sion sang wasan kauson en Iakop karos.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kasoi kaselel mia duen koe kanim en Kot. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I pan kasokasoi duen Raap o Papel, me asa ia. Kilang, Pilista o Tirus, o pil men Atiopia: Mepukat ipwidier wasa o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A kasokasoi duen Sion indinda, me song en aramas karos ipwidi wasa o, o me Lapalap o pan kotin kamanada i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ieowa pan kotin wadok, ni a pan kotin kileledi aramas akan: Mepukat ipwidier wasa o. Sela.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O ni ar madomadong re pan kauleki: Ai parer karos mi re om!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}