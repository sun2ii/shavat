{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"IEOWA kotin kaunda, a kotin kapwateki pein i manaman, Ieowa kotin kalikauwiada pein i, a kotin piraki pein i manaman; pil sappa me tengeteng o sota pan mokimokid.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sang mas lel met mol omui me tengeteng; komui me soutuk.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maing Ieowa pil akan lalaudala, pil akan ngiringirsok, pil akan pil pan kokodo o ngiringirsok.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ieowa kotikot wasa ileile. A manaman sang ngil en pil kalaimun akan o iluk en madau kalaimun akan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Omui masan akan meid pung. Tanpas omui me linganaki saraui kokolata, Maing Ieowa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}