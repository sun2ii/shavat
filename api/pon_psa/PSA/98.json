{"translation":{"id":"pon_psa","name":"Kadede Kap Psam Akan","website":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon-pdn","licenseNotes":null,"shortName":"PSA","englishName":"Pohnpeian NT & Psalms, new alphabet","language":"pon","textDirection":"ltr","sha256":"44957677e84100135c81bf32aea35989311fa14f1adce68493137d17ccec65be","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_psa/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_psa","name":"Psalm","commonName":"Psalm","title":"PUK EN PSALM.","order":19,"numberOfChapters":150,"sha256":"8365887fd20c3baaaa24661fcb47a0a98df65a952380902c20e049eab55a5d82","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_psa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_psa/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":98,"content":[{"type":"verse","number":1,"content":[{"text":"KAKAULEKI ong Ieowa kaul kap pot; pwe a kotin wiadar dodok kapuriamui. A kotin kaloe kidi lim a pali maun o lim a saraui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ieowa kotin kasaledar a kamaur, o mon mas en kainok kan a kotin kasansaledar a pung.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A kotin kolekol ong men Israel a kalangan o melel; imwin sap karos kin kilang pai en atail Kot.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sap karos en ngisingis ong Ieowa! Popol o kauleki psalm!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kauleki ong Ieowa psalm iangaki laute, wiada laute o kaul!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Iang trompete o ngil en koronete, komail ngisingis ong Nanmarki Ieowa!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Madau en ngiringirsok o audepa, sappa o tou a kan;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pilap akan en lopolopeki pa arail; o nana kan en pereperenki.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ieowa, ni a kotidon kadeikada sappa. A pan kotin kadeikada sappa nin tiak pung o kainok kan nin tiak inen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_psa/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_psa/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_psa/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}