{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"ISA","translationId":"pon_ssp","name":"AISEIA","commonName":"AISEIA","title":"AISEIA","order":23,"numberOfChapters":66,"sha256":"fcc274669f965a9b941e5a8227657e8a6a2707e769fc9f2376e8270adc953c99","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/pon_ssp/ISA/66.json","totalNumberOfVerses":1286},"chapter":{"number":12,"content":[{"type":"heading","content":["Melkahkahn Kapingkalahngan"]},{"type":"verse","number":1,"content":["Rahn ehu pahn kohdo me aramas akan pahn koulki koul pwoatet,",{"text":"“I kapinga komwi, Maing KAUN! Komwi ketin engieng pahi,","poem":2},{"lineBreak":true},{"text":"ahpw met komwi ketin kansenamwahwihiehla oh solahr ketin engieng.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Koht me ei sounkomour;","poem":1},{"text":"I pahn liki oh sohte masak mehkot.","poem":2},{"text":"KAUN-O me ketikihdo ei manaman oh ei kehl;","poem":1},{"text":"iei ih me ei sounkomour.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Duwen pihl lemwulemwur eh kin kansenamwahwih me men nimpildahr,","poem":1},{"text":"iei duwen sapwellimen Koht aramas akan ar pahn perenda ni eh pahn ketin komourirailla.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Rahn ehu pahn kohdo me aramas akan pahn koulki koul pwoatet,",{"text":"“Kumwail kapingkalahngan ong KAUN-O! Kumwail likwerih pwehn ketin sewesei kumwail!","poem":1},{"text":"Kumwail lohkiong wehi koaros wiepen nin lime kan!","poem":2},{"lineBreak":true},{"text":"Kumwail lohkiong irail uwen sapwellime roson!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kumwail kouliong KAUN-O pwehki wiepen nin lime lapalap akan.","poem":1},{"text":"Sampah pwon en rong rohng pwukat.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Koaros me kin kousoan nan Saion en ngisingis oh kokoul!","poem":1},{"text":"Koht sarawien Israel me manaman,","poem":2},{"lineBreak":true},{"text":"oh e kin ketin ieiang sapwellime aramas akan.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}