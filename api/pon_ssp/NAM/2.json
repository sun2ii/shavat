{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"NAM","translationId":"pon_ssp","name":"NAHUM","commonName":"NAHUM","title":"Pwuhken NAHUM","order":34,"numberOfChapters":3,"sha256":"9677f551cfa36d61a490b00ac5b635f1f71a95089fac05ee46419368898ccd9a","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/pon_ssp/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Ohlahn Ninipe"]},{"type":"verse","number":1,"content":[{"text":"Ninipe, ke miher nan apwal en mahwen!","poem":1},{"lineBreak":true},{"text":"Wehi me pahn kauweiukala samwodohr.","poem":1},{"text":"Onopada tehtehn mahwen kan!","poem":2},{"lineBreak":true},{"text":"Silehdi ahl akan!","poem":2},{"lineBreak":true},{"text":"Kaunopada ong mahwen!","poem":2},"("]},{"type":"verse","number":2,"content":["KAUN-O pahn ketin onehda sapahl lingan en Israel, duwehte lingan me e ahneki mwohn eh imwintihti eh kauwelahr.)"]},{"type":"verse","number":3,"content":[{"text":"Sounpei en imwintihti ko wa mehn sansar weitahta","poem":1},{"text":"oh mi nan likou weitahta.","poem":2},{"text":"Re kaukaunop re en mahwen!","poem":1},{"text":"Wararail werennansapw en mahwen wie piripir rasehng kisiniei!","poem":2},{"lineBreak":true},{"text":"Neirail oahs kan wie lusulusseli!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Werennansapw en mahwen kan maramarahra kohwei nanial akan,","poem":1},{"text":"tangatangseli nan wasahn kapokon en aramas akan.","poem":2},{"text":"Re wie piripir rasehng mehn ndil kei","poem":1},{"text":"oh maramarahraseli rasehng lioal.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lapalap en sounpei kan likwerpenehr;","poem":1},{"text":"re dipdipekelekel ni ar kohkohwei.","poem":2},{"lineBreak":true},{"text":"Me mahmahwen kan maramarahralahng ni kehlo","poem":1},{"text":"oh re kihda mehn perehla sounpei kan me weuwa lepin tuhkehn kauwehla ewen kehlo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ewen kehl kan limwahn pillapo ohlahr oh langadahr;","poem":1},{"text":"nan tehnpaso direkilahr masepwehk.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lih nanmwarkio selidier;","poem":1},{"text":"nah sounpapah kan wie sengiseng duwehte ngilen mwuroi kan","poem":2},{"lineBreak":true},{"text":"oh pikipikir nan mwaremwarerail kan nan ar nsensuwed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aramas akan tangodohsang Ninipe","poem":1},{"text":"rasehng pillap me pwilsang wasahn nahk pihl me rengkpesengier!","poem":2},{"text":"Likwer wiewiawi, ndinda, “Kumwail uhdi! Kumwail uhdi!”","poem":1},{"text":"ahpw sohte emen me pweiekla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kumwail kulihasang silper kan!","poem":1},{"text":"Kumwail kulihasang kohl kan!","poem":2},{"text":"Kahnimwo me diren kepwe mwahu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ninipe mwomwlahr, solahr towe, e tehnlahr!","poem":1},{"text":"Mohngiong kan peikipesengier masepwehk;","poem":2},{"lineBreak":true},{"text":"nehn aramas akan rerrer, solahr angirail;","poem":2},{"lineBreak":true},{"text":"pohn masarail kan reireilahr.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Eri met, ia kahnimwo","poem":1},{"text":"me rasehng pesen laion ehu,","poem":2},{"lineBreak":true},{"text":"wasa me laion pwulopwul kan kin mwengemwenge ie,","poem":2},{"lineBreak":true},{"text":"wasa me laion ohl oh lih kan iangahki","poem":2},{"lineBreak":true},{"text":"neirail kan kin onepek mwahu ie?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Laiono kemelahr seikeo","poem":1},{"text":"oh ngalispeseng pwehn kihong eh werek oh nah kan;","poem":2},{"lineBreak":true},{"text":"e audekilahr nan peseo uduk en seikeo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":["KAUN-O, Wasa Lapalap, mahsanih, “Ngehi amwail imwintihti! I pahn isikala waramwail werennansapw en mahwen kan. Noumwail sounpei kan pahn mehla nan mahwen, oh I pahn ketikihsang mehkoaros me kumwail kihsangehr meteikan. Oh solahr me pahn rong ngilen noumw meninkeder kan.”"]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}