{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":1,"content":[{"type":"heading","content":["Pai mehlel"]},{"type":"verse","number":1,"content":[{"text":"Meid pai aramas akan","poem":1},{"text":"me kin soikala kaweid en aramas suwed kan,","poem":2},{"lineBreak":true},{"text":"me sohte kin men kalemengih me dipan akan,","poem":2},{"lineBreak":true},{"text":"de patehng irail akan me sohte kin wauneki Koht;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ahpw re kin perenki peikiong Kosonned en KAUN-O,","poem":1},{"text":"oh medemedewe nan kapehdihr nin rahn oh nipwong.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Re rasehng tuhke kan limwahn pihl akan,","poem":1},{"text":"me kin materek nan rahk koaros,","poem":2},{"lineBreak":true},{"text":"oh tehrail kan sohte kin mengila.","poem":2},{"text":"Re kin pweida mwahu ni soahng koaros me re kin wia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ahpw aramas suwed akan sohte mwahn kin duwehte;","poem":1},{"text":"re rasehng teh meng kan me kisinieng kin ipihpirseli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Koht pahn ketin kaloke me dipan akan","poem":1},{"text":"oh re pahn katohrohrsang sapwellime aramas akan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"KAUN-O pahn ketin kawekaweid oh sinsile me pwung kan,","poem":1},{"text":"a aramas suwed akan pahn lekdekla kohkohlahte.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}