{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":100,"content":[{"type":"heading","content":["Melkahkahn Kaping 100.0 TITLE NI MAHSEN EN IPRU: Melkahkahn kapingkalahngan."]},{"type":"verse","number":1,"content":[{"text":"Tohn sampah koaros, kumwail kokouliong KAUN-O!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kumwail pereperen kaudokiong KAUN-O","poem":1},{"text":"oh patohdo mwohn silangi ngisingiski amwail koul!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dehr manokehla me KAUN-O, iei ih Koht.","poem":1},{"text":"Ih me ketin wieikitailda, oh ih me kin sapwellimankin kitail;","poem":2},{"lineBreak":true},{"text":"kitail me sapwellime aramas, kitail me sapwellime pelin sihpw.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kumwail pedokihlong nan kelen Tehnpaso amwail koulen kaping;","poem":1},{"text":"kumwail patohlong nan sapwellime mwoahl sarawi ni kapingkalahngan.","poem":2},{"lineBreak":true},{"text":"Kumwail patohwanohng amwail kapingkalahngan oh kapikapinga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"KAUN-O me kalahngan;","poem":1},{"text":"sapwellime limpoak kin poatopoatete","poem":2},{"lineBreak":true},{"text":"oh e kin ketin dadaurete sapwellime loalopwoat kohkohlahte.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}