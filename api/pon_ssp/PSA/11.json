tehnpese sarawi;","poem":1},{"text":"mwoahle kin mi nanleng.","poem":2},{"text":"E kin mamahsanih aramas akan wasa koaros","poem":1},{"text":"oh mwahngih dahme re kin wiewia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"E kin ketin kasawih aramas mwahu oh me suwed kan koaros;","poem":1},{"text":"e kin ketin kalahdeki kowahlap me kin keid likin sapwellime kosonned akan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"E kin ketin kamwerehdi kisiniei oh suwepel","poem":1},{"noteId":2},{"text":"okohk pohn aramas suwed kan;","poem":1},{"text":"e kin ketin kalokehkin irail kisinieng mpwumpwul.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"KAUN-O me pwung oh kin kupwurki wiewia mwahu kan;","poem":1},{"text":"me kin peikiong pahn kin momour mwohn silangi.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"k","text":"11.6 SUWEPEL: Tehk nan kawehwehpen lepin mahsen kan.","reference":{"chapter":11,"verse":6}}]},"thisChapterLink":"/api/pon_ssp/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}