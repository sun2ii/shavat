{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":110,"content":[{"type":"heading","content":["KAUN-O oh Sapwellime Nanmwarki me Pilipildahr 110.0 TITLE NI MAHSEN EN IPRU: En Depit melkahka."]},{"type":"verse","number":1,"content":[{"text":"KAUN-O ketin mahsanihong ei kaun, nanmwarkio,","poem":1},{"text":"“Komw ketidiong ni palimauniet","poem":2},{"lineBreak":true},{"text":"I lao wiahkihda omwi imwintihti kan utupen aluweluwomwi kan.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"KAUN-O pahn ketin katelapahla sapwellimomwi manaman en kaunda wehi pokon sang Saion.","poem":1},{"text":"E mahsanih, “Komwi en kaunda sapwellimomwi imwintihti kan.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rahnen omwi mahweniong omwi imwintihti kan,","poem":1},{"text":"sapwellimomwi aramas akan pil pahn iang mahweno.","poem":2},{"text":"Sapwellimomwi mwahnakapw akan pahn patohdo rehmwi nin nahna sarawi kan,","poem":1},{"text":"rasehng pwoaiken nimensehngie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"KAUN-O ketin inoukidahr kehlail, oh sohte pahn ketin koluhkihla:","poem":1},{"text":"“Komwi pahn wiahla samworo sang met kohkohlahte","poem":2},{"lineBreak":true},{"text":"nin duwen koasoandien samworo Melkisedek.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kaun-o kin ketiket ni palimaunomwien;","poem":1},{"text":"e pahn ketin kalowehdi nanmwarki kan ni rahn me e pahn engiengda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E pahn ketin kadeikada wehi kan","poem":1},{"text":"oh ketin kadirehkihla wasahn mahwen kahlep en aramas akan;","poem":2},{"lineBreak":true},{"text":"e pahn ketin kalowehdi nanmwarki kan en sampah pwon.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nanmwarkio pahn ketin nimpil sang piletik en ni keilenial,","poem":1},{"text":"oh ketin rosonkihda, e ahpw pahn ketin uh ni roson en powehdi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}