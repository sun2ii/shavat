{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":112,"content":[{"type":"heading","content":["Paien Aramas Mwahu"]},{"type":"verse","number":1,"content":[{"text":"Kapinga KAUN-O!","poem":1},{"lineBreak":true},{"text":"Meid pai aramas me kin wauneki KAUN-O,","poem":1},{"text":"me kin alehki eh peren sang ni eh kin kapwaiada sapwellime kosonned akan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nein aramas mwahu seri kan pahn ahneki manaman nan sahpwo;","poem":1},{"text":"kadaudoke kan pahn ale kupwuramwahu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eh peneinei pahn paiamwahu oh kepwehpwe,","poem":1},{"text":"oh e pahn paiamwahu kohkohlahte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Marain kin dakerada rotorot ong aramas mwahu kan,","poem":1},{"text":"ong irail kan me kalahngan, kadek, oh pwung.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Meid pai aramas me kin kadek ni eh kin kihwei lohn,","poem":1},{"text":"me kin wia eh doadoahk en netinet ni mehlel.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aramas mwahu sohte pahn sapwungala;","poem":1},{"text":"e sohte pahn manokonokla kohkohlahte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E sohte kin masak rong rohng suwed akan;","poem":1},{"text":"eh pwoson me kehlail, oh e kin likih KAUN-O.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E sohte kin pwunod de masepwehk;","poem":1},{"text":"e koapworpworki me e pahn kilang eh imwintihti kan ar pahn lohdi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E kin sapan ong me paisuwed akan,","poem":1},{"text":"oh eh kadek kin duweduwehte;","poem":2},{"lineBreak":true},{"text":"e pahn ahneki manaman oh wahun.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aramas suwed kan re kilang met oh lingeringerkihda;","poem":1},{"text":"re kangkakilkin irail ar kailok oh irail kohkohla;","poem":2},{"lineBreak":true},{"text":"arail koapworopwor sohralahr kohkohlahte.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}