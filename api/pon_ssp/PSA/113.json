"text":"E kin ketiket powe wasa ileilehie,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"ahpw kin ketin mahsendihdo","poem":2},{"lineBreak":true},{"text":"oh ireirong nanleng oh sampah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"E kin ketin pwekada me semwehmwe kan sang nanpwel;","poem":1},{"text":"e kin ketin kasapwilada me paisuwedlahr akan sang ar apwal","poem":2}]},{"type":"verse","number":8,"content":[{"text":"oh kin ketin wiahkinirailla werek en me lapalap akan,","poem":1},{"text":"me lapalap en sapwellime aramas akan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E kin ketin kawauwihala lih depwen kan nan imwarail kan;","poem":1},{"text":"oh kapaiahkin irail seri.","poem":2},{"lineBreak":true},{"text":"Kapinga KAUN-O!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}