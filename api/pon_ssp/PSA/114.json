,{"text":"Ah kowe Sordan, dahme ke pweiengkihdi sohla pwilipwilwei?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kumwail nahna kan, dahme kumwail mwusimwusikengki duwehte kuht kei?","poem":1},{"text":"Oh kumwail dohl kan, dahme kumwail lusuluskiseli duwehte sihmpwul kei?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kowe, sampah, ke en rerrada ni KAUN-O eh pahn ketido,","poem":1},{"text":"ke en rerrada mwohn silangin Koht en Seikop,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"me kin ketin wekidohng takai kan ni pwarer en pihl","poem":1},{"text":"oh paip akan ni kahng en pihl.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}