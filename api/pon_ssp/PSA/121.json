{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":121,"content":[{"type":"heading","content":["KAUN-O, iei Silepatail"]},{"type":"verse","number":1,"content":[{"text":"I saradahng nahna kan;","poem":1},{"text":"ia wasa me sawasepei pahn kohdo sang ie?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sawasepei pahn pwarodo sang rehn KAUN-O,","poem":1},{"text":"me ketin kapikada nanleng oh sampah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"E sohte pahn mweidohng ke en pwupwudi;","poem":1},{"text":"silepomw sohte kin ketin seimwokla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Silepen Israel","poem":1},{"text":"sohte kin ketin lusoi de seimwok!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"KAUN-O, iei ih me pahn ketin sinsileiuk;","poem":1},{"text":"e kin ketiket limwahmw pwe en ketin apwalihiuk.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ketipin sohte pahn kauweiukala nin rahn,","poem":1},{"text":"de maram nipwong.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"KAUN-O pahn ketin silehsang uhk soahng keper koaros;","poem":1},{"text":"e pahn ketin sinsileiuk mehlel.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E pahn ketin sinsileiuk ni omw kohwei oh kohdo,","poem":1},{"text":"met oh pil kohkohlahte.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}