ehpwe kan","poem":1},{"text":"oh mwamwahlahr pahn me kin kahrehiong kiht nan kehnaudek kan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}