{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":124,"content":[{"type":"heading","content":["Koht me Silepen Sapwellime Aramas akan 124.0 TITLE NI MAHSEN EN IPRU: En Depit."]},{"type":"verse","number":1,"content":[{"text":"Ia duwe, ma KAUN-O sohte ketin uhpalihkin kitail?","poem":1},{"text":"Israel, sapeng ie!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Ma KAUN-O sohte ketin uhpalihkinkitailehr","poem":1},{"text":"ni ahnsou me atail imwintihti kan mahweniong kitail,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"re uhdahn kadalleikitaillahr ni atail momour","poem":1},{"text":"nan arail lingeringer kowahlap;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"eri, kitail ahpw pahn peikihla ahden pillap akan,","poem":1},{"text":"oh mwopwla nan pihlo,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ahden lapake pahn kamwopwkitailla.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kitail kasapahlkalahngan ong KAUN-O,","poem":1},{"text":"me sohte ketin mweidohng atail imwintihti kan en kamwomwkitailla.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kitail pitlahr rasehng menpihr men me pitsang nan lidip en sounwie lidip kan;","poem":1},{"text":"lidipo ohlahr, oh kitail saledeklahr!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sawasepatail kin pwarodo sang rehn KAUN-O,","poem":1},{"text":"me ketin kapikada nanleng oh sampah.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}