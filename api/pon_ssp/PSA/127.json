{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":127,"content":[{"type":"heading","content":["Kapingpen Kalahngan en Koht 127.0 TITLE NI MAHSEN EN IPRU: En Solomon."]},{"type":"verse","number":1,"content":[{"text":"Ma KAUN-O sohte ketin kauwada ihmwo,","poem":1},{"text":"doadoahk en sounkou ihmw kan sohte pahn katepe;","poem":2},{"text":"ma KAUN-O sohte kin ketin sinsile kahnimwo,","poem":1},{"text":"silepe kan en kahnimw pahn sinsile mwahl.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sohte katepen omw pahn tihtihwohki raparapahki omw mour,","poem":1},{"text":"sangkenei pwopwourda nin sohrahn, oh pwand en meirla nipwong.","poem":2},{"text":"Pwe KAUN-O kin ketikihda kisin tungoal ong me e kin poakohng kan,","poem":1},{"text":"nindokon arail kin wie memeir.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Seri kan, iei kisakis ehu sang rehn KAUN-O;","poem":1},{"text":"uhdahn kapai ehu sang reh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pwutak kan me ohl emen nainekidahr ni eh pwulopwul,","poem":1},{"text":"rasehng arep kei nan pehn sounpei men.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Meid pai aramaso me naineki tehtehn mahwen tohto pwukat!","poem":1},{"lineBreak":true},{"text":"E sohte pahn lohdi","poem":1},{"text":"ni eh pahn tuhwong eh imwintihti kan nan wasahn kopwung.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}