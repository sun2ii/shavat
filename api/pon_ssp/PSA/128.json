{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":128,"content":[{"type":"heading","content":["Ketingpen Aramas me kin Peikiong KAUN-O"]},{"type":"verse","number":1,"content":[{"text":"Meid pai irail kan me kin peikiong KAUN-O,","poem":1},{"text":"oh kin momourki sapwellime kosonned akan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ke pahn kin ale dahme ke anahne sang nan omw doadoahk;","poem":1},{"text":"ke pahn kin peren oh paiamwahu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Omw pwoud pahn kin rasehng tuhkehn wain wohkian ni imwomwo,","poem":1},{"text":"oh noumw pwutak kan pahn kin rasehng tuhke olip kapilpene omw tehpel.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aramas emen me kin peikiong KAUN-O","poem":1},{"text":"uhdahn pahn kin ale soangen kupwuramwahu wet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"KAUN-O en ketin kupwuramwahwihiuk sang Saion!","poem":1},{"text":"Ke en kadehde kapai kan en Serusalem","poem":2},{"lineBreak":true},{"text":"rahn koaros en omw mour!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ke en momour oh kak kilang nein noumw seri kan!","poem":1},{"lineBreak":true},{"text":"Popohl en kin ieiangete Israel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}