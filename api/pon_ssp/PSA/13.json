{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":13,"content":[{"type":"heading","content":["Kapakap en Peki Sawas 13.0 TITLE NI MAHSEN EN IPRU: En Depit melkahka."]},{"type":"verse","number":1,"content":[{"text":"Maing KAUN, ia erein omwi pahn ketin likidmelieiehla, e pahn kohkohlahte?","poem":1},{"text":"Ia erein omwi pahn ketin karirala sang ie silangmwi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ia erein ei pahn patopato nan apwal?","poem":1},{"text":"Ia erein mohngiongi eh pahn wie toutouki nsensuwed nin rahn oh nipwong?","poem":2},{"lineBreak":true},{"text":"Ia erein ei imwintihti kan ar pahn kin poweiehdi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Maing KAUN, ei Koht, komw ketin mahsendohng ie oh sapeng ie.","poem":1},{"text":"Komw ketin kakehleiehda sapahl; komw dehr ketin mweidohng I en mehla.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Komw dehr mweidohng ei imwintihti kan en nda, “Kitail kalowedier!”","poem":1},{"text":"Komw dehr mweidohng re en kepitiki ei pwupwudi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I kin koapworopworki sapwellimomwi limpoak poatopoat;","poem":1},{"text":"I kin peren, pwehki komwi pahn ketin doareiehla.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maing KAUN, I pahn kouliong komwi,","poem":1},{"text":"pwehki sapwellimomwi kalahngan ong ie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}