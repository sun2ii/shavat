{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":130,"content":[{"type":"heading","content":["Kapakap en Peki Sawas"]},{"type":"verse","number":1,"content":[{"text":"Maing KAUN, sang nan ei weikeklahr mwuledek, I patohwan likweriong komwi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maing ei Kaun, komw ketin karonge ie,","poem":1},{"text":"komw ketin karonge ngilen ei pek sawas!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ma komw pahn ketin kilelehdi dipat akan,","poem":1},{"text":"ihs me kak pitsang sapwellimomwi kadeik?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A komw kin ketin mahkohng kiht,","poem":1},{"text":"pwe se en kin lemmwikin komwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I kin ngoangki kasikasik sawas sang rehn KAUN-O,","poem":1},{"text":"oh I kin likih mehlel sapwellime mahsen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I kin kasikasik KAUN-O","poem":1},{"text":"laudsang silepen nipwong kan ar kin awiawih marain en nin sohrahn—","poem":2},{"lineBreak":true},{"text":"ei, laudsang silepen nipwong kan ar kin awiawih marain en nin sohrahn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kumwail tohn Israel, kumwail en likih KAUN-O,","poem":1},{"text":"pwehki sapwellime limpoak me poatopoat","poem":2},{"lineBreak":true},{"text":"oh e kin ketin kupwurohki doareikitailla ahnsou koaros.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E pahn ketin doarehla sapwellime aramas en Israel kan","poem":1},{"text":"sang nan diparail kan koaros.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}