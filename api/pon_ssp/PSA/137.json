{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":137,"content":[{"type":"heading","content":["En mehn Israel ar Loaleid ni ar Kalipilipala"]},{"type":"verse","number":1,"content":[{"text":"Se mwohndier ni keilen pillap en Papilon kan;","poem":1},{"text":"oh wie sengiseng ni at kin tamanda Saion.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Se pil kin langahda nait keseng arp akan","poem":1},{"text":"nan tuhke kan en wasao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Irail me salihkitedi, re ndaiong kiht se en kouliong irail,","poem":1},{"text":"oh se en kamwait irail:","poem":2},{"lineBreak":true},{"text":"“Kumwail koulkihong kiht apwoat koulen duwen Saion.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Eri, ia duwen at kak koulki koulen KAUN-O","poem":1},{"text":"nan sapwen mehn liki kan?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Serusalem, ma I manokeiukala","poem":1},{"text":"pehi kat en sohla kak kesengki arp!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ma I sohte tamanuhkada","poem":1},{"text":"oh ma I sohla pahn wiahkin uhk kaperenpei me keieu laud,","poem":2},{"lineBreak":true},{"text":"loweiet en sohla kak koul.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Maing KAUN, komw ketin tamanda dahme mehn Edom ko wiadahr","poem":1},{"text":"ni rahn me Serusalem lohdiong at imwintihti ko.","poem":2},{"text":"Komw ketin tamanda duwen ar kin ndinda,","poem":1},{"text":"“Kumwail kauwehla, oh karangkehdi!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Papilon, ke pahn kamwommwomwla.","poem":1},{"lineBreak":true},{"text":"Meid pai aramas me pahn dupukohng uhk","poem":1},{"text":"me ke wiahiongkitehro—","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"me pahn ale noumw seri pwelel kan","poem":2},{"lineBreak":true},{"text":"oh kasungkinihrpeseng takai kan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}