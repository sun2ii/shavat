{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":149,"content":[{"type":"heading","content":["Koulen Kaping"]},{"type":"verse","number":1,"content":[{"text":"Kapinga KAUN-O!","poem":1},{"lineBreak":true},{"text":"Kumwail koulki koul kapw pwoat ong KAUN-O;","poem":1},{"text":"kumwail kapinga ih mwohn pokon en sapwellime aramas loalopwoat akan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Israel, ke en nsenamwahula, pwehki Sounwiepomw;","poem":1},{"text":"tohn Saion, kumwail perenda, pwehki amwail nanmwarki.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kumwail kahlek kapingahki mware;","poem":1},{"text":"kumwail kesengki aip oh arp kapikapinga ih.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"KAUN-O kin kupwurperenki sapwellime aramas akan;","poem":1},{"text":"e kin ketin kawauwihkihla me aktikitik kan manaman en powehdi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sapwellimen Koht aramas akan en perenkihda ar powehdi","poem":1},{"text":"oh re en kokoul en peren pwohng ehu unsek.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Re en ngisingis nindokon ar kapikapinga Koht,","poem":1},{"text":"kolokol nair kedlahs keng kan","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"pwe re en kalowehdi wehi kan","poem":2},{"lineBreak":true},{"text":"oh kaloke aramas akan;","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"pwe re en salihkihdi sahl mete ar nanmwarki kan,","poem":2},{"lineBreak":true},{"text":"ar kaun akan nan seliparail selmete kehlail;","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"pwe re en kaloke wehi kan nin duwen Koht eh ketin koasoanehdi.","poem":2},{"text":"Ih met powehdi en sapwellimen Koht aramas akan.","poem":1},{"lineBreak":true},{"text":"Kapinga KAUN-O!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}