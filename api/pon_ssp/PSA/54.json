{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":54,"content":[{"type":"heading","content":["Kapakap en Silasil sang Imwintihti kan 54.0 TITLE NI MAHSEN EN IPRU: En Depit koul, mwurin ohl ako sang Sip ar kohla rehn Sohl oh patohwanohng me Depit wie rukuruk nan sapwarailo. 54.0 1 Sam. 23.19; 26.1."]},{"type":"verse","number":1,"content":[{"text":"Maing Koht, komw ketin doarehkiniehla sapwelimomwi manaman;","poem":1},{"text":"komw ketin kasaledekehkiniehla sapwellimomwi manaman!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maing Koht, komw ketin karonge ei kapakap;","poem":1},{"text":"komw ketin karonge ei tungoal pato kat!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aramas aklapalap ekei kohkohdohng peiong ie;","poem":1},{"text":"aramas lemei kan songosong en kemeiehla—","poem":2},{"lineBreak":true},{"text":"soangen aramas me sohte kin wauneki Koht.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ahpw Koht iei sawasepei.","poem":1},{"text":"Kaun-o iei soundoarepei.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Koht en ketin kupwure pwe ei imwintihti kan en lokolongki pein ar wiewia suwed kan.","poem":1},{"text":"E pahn ketin kamwomwirailla pwehki ih me loalopwoat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Maing KAUN, I pahn patohwan perenki wiahiong komwi ehu meirongen;","poem":1},{"text":"I pahn patohwan kapingkalahngankihong komwi","poem":2},{"lineBreak":true},{"text":"pwehki omwi kupwur mwahu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Komwi me ketin kapitiehla sang nan ei apwal akan koaros,","poem":1},{"text":"oh I patohwanehr duwen ei imwintihti kan ar lohdier.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}