{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":67,"content":[{"type":"heading","content":["Koulen Kaping Kalahngan 67.0 TITLE NI MAHSEN EN IPRU: Melkahka pwoat; koul pwoat."]},{"type":"verse","number":1,"content":[{"text":"Maing Koht, komw ketin kupwurei kiht, oh kupwuramwahwihkitala;","poem":1},{"text":"komw ketin kupwur kalahngan oh mahsendohng kiht,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"pwe sampah pwon en marainkihla kupwuromwien;","poem":1},{"text":"oh wehi koaros en dehdehkihla sapwellimomwi manaman en komour.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Maing Koht, aramas akan en kapinga komwi,","poem":1},{"text":"aramas koaros en kapinga komwi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tohnwehi kan en nsenamwahu oh koulki ar peren,","poem":1},{"text":"pwehki omwi kin ketin kapwungkihla pwung mehlel aramas akan","poem":2},{"lineBreak":true},{"text":"oh kin ketin kaweid wehi koaros nin sampah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Maing Koht, aramas akan en kapinga komwi;","poem":1},{"text":"aramas koaros en kapinga komwi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sapwatail kapwaredahr audepe;","poem":1},{"text":"Koht, atail Koht, ketin kupwuramwahwihkitailehr.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Koht ketin kupwuramwahwihkitailehr;","poem":1},{"text":"aramas koaros wasa koaros en wauneki ih.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}