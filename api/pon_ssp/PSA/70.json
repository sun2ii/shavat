{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":70,"content":[{"type":"heading","content":["Kapakap en Peki Sawas 70.0 TITLE NI MAHSEN EN IPRU: En Depit melkahka; koulen kedepwidepw pwoat."]},{"type":"verse","number":1,"content":[{"text":"Maing Koht, komw ketin komouriehla!","poem":1},{"text":"Maing KAUN, komw ketin sewese ie ahnsou wet!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Irail kan me songosong en kemeiehla","poem":1},{"text":"re en lohdi oh pingida.","poem":2},{"text":"Irail kan me kin perenki ei apwal","poem":1},{"text":"re en pwurala oh namenekla.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Irail kan me kin kouruhrkin ie","poem":1},{"text":"re en sarokihdi ar lohdi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Irail koaros me kin patohdo rehmwi","poem":1},{"text":"re en nsenamwahu oh pereperen.","poem":2},{"text":"Irail koaros me kin kasapahl kalahnganki ong komwi sapwellimomwi komour","poem":1},{"text":"re en kin patopatohwan ahnsou koaros, “Meid lapalap atail Koht!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Maing Koht, ngehi me luwet oh semwehmwe;","poem":1},{"text":"komw ketidohng rehi mwadang.","poem":2},{"text":"Komwi me ei sounkomour oh ei Kaun—","poem":1},{"text":"komw ketin mwadangodo oh sewese ie!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}