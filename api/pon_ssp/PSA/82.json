{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":82,"content":[{"type":"heading","content":["Koht Kaun Lapalahpie 82.0 TITLE NI MAHSEN EN IPRU: En Asap melkahka."]},{"type":"verse","number":1,"content":[{"text":"Koht kin ketin kaunda wie kupwur akan nanleng;","poem":1},{"text":"ni wie kupwur en koht akan e kin ketin koasoanehdi kupwure:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Kumwail uhdahn pahn katokehdi amwail kopwung sapwung kan;","poem":1},{"text":"kumwail solahr pahn uhpalihki aramas suwed kan!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kumwail doare pwuhng en me semwehmwe oh sepwoupwou kan;","poem":1},{"text":"kumwail lamalam pahrek ong me paisuwedlahr oh me luwet akan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kumwail kapitirailsang pahn manaman en aramas mwersuwed kan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ia uwen amwail sohte wehwehki! Ia uwen amwail loalopwon!","poem":1},{"text":"Kumwail sapwungalahr mehlel,","poem":2},{"lineBreak":true},{"text":"iei me pwuhng sohrkisangehr sampah wet.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I ahpw nda; ‘Kumwail koht ekei,","poem":1},{"text":"kumwail koaros sapwellimen Wasa Lapalahpie.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ahpw kumwail pahn mehla duwehte aramas akan;","poem":1},{"text":"amwail mour pahn pil sohrasang rasehng sapwellimen nanmwarki pwutak.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Maing Koht, komw ketido kaunda sampah;","poem":1},{"text":"wehi koaros nin sampah iei sapwellimomwi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_ssp/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}