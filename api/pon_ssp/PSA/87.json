{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":87,"content":[{"type":"heading","content":["Kapingpen Serusalem 87.0 TITLE NI MAHSEN EN IPPRU: En peneinei en Kora ar melkahka; koul pwoat."]},{"type":"verse","number":1,"content":[{"text":"KAUN-O ketin kauwada sapwellime kahnimw pohn dohl sarawio;","poem":1},{"noteId":15}]},{"type":"verse","number":2,"content":[{"text":"e kin ketin loalloale kahnimw Serusalem","poem":2},{"lineBreak":true},{"text":"laudsang wasa teikan nan Israel.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rong mahs, kowe, kahnimw en Koht,","poem":1},{"text":"irair kapwuriamwei kan me e pahn mahsanih duwen kowe:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ni ei pahn pahngada wehi kan me kin peikiong ie","poem":1},{"text":"I pahn iangahkihong Isip oh Papilonia.","poem":2},{"text":"I pahn pil mahsanih tohn Pilisdia, Dair oh Idiopia,","poem":1},{"text":"pwe irail pil kisehn Serusalem.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"A duwen Saion aramas koaros pahn ketihtihki","poem":1},{"text":"me wehi koaros tepisang reh","poem":2},{"lineBreak":true},{"text":"oh pein Wasa Lapalap pahn ketin kakehlahda Saion.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"KAUN-O pahn ketin ntingihedi nan doaropwe eden aramas koaros","poem":1},{"text":"oh ketin wiahkihla irail koaros pwilidak en Serusalem.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Re kahlek oh kokoulki,","poem":1},{"text":"“Atail paiamwahu kan koaros kin tepisang Saion.”","poem":2}]}],"footnotes":[{"noteId":15,"caller":"t","text":"87.1 DOHL SARAWI: Tehk 2.6.","reference":{"chapter":87,"verse":1}}]},"thisChapterLink":"/api/pon_ssp/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}