{"translation":{"id":"pon_ssp","name":"Pohnpeian Bible with Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006a","licenseNotes":null,"shortName":"SSP","englishName":"Pohnpeian Bible with Apocrypha 2006","language":"pon","textDirection":"ltr","sha256":"4a1b0a18abba2261b05afb6175173ed1c11fa8c1705933b6eb23eaa2f591f13c","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_ssp/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian","numberOfApocryphalBooks":6,"totalNumberOfApocryphalChapters":44,"totalNumberOfApocryphalVerses":1901},"book":{"id":"PSA","translationId":"pon_ssp","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"9c3168c3c44ef8f4ce4b28a2416bdd15631b298d89778980f8e303542b1c28e1","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_ssp/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_ssp/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":99,"content":[{"type":"heading","content":["Koht Nanmwarki Lapalahpie"]},{"type":"verse","number":1,"content":[{"text":"KAUN-O iei nanmwarki,","poem":1},{"text":"eri aramas akan kin rerrerki ar masak.","poem":2},{"text":"E ket nan mwoale pohnangin kerup kan,","poem":1},{"text":"sampah ahpw wie rerrerki.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"KAUN-O nan Saion me manaman;","poem":1},{"text":"e ketin lapalap sang wehi koaruhsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aramas koaros pahn kin kapinga lapalap oh lingan en mware.","poem":1},{"text":"Ih me sarawihe!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Maing nanmwarki lapalap, komw kin ketin poakohng dahme pwung;","poem":1},{"text":"komw ketin koasoanehdi mour en pwuhng nan wehin Israel;","poem":2},{"lineBreak":true},{"text":"komw ketikidohr pwuhng oh pahrek.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kapinga KAUN-O atail Koht","poem":1},{"text":"oh kaudok mwohn mwoale!","poem":2},{"lineBreak":true},{"text":"Ih me Sarawihe!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moses oh Aaron iei sapwellime samworo,","poem":1},{"text":"oh Samuel iei ih emen me kin kapakapohng;","poem":2},{"lineBreak":true},{"text":"irail kin likweriong KAUN-O, e ahpw kin ketin sapeng irail.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"E ketin mahseniong irail sang nan uhren depweko;","poem":1},{"text":"re kapwaiadahr kosonned oh koasoandi kan me e ketikihong irail.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Maing KAUN, at Koht, komw ketin sapengehr sapwellimomwi aramas akan;","poem":1},{"text":"komw ketin kasalehiong irail me komwi Koht emen me kin kupwurmahk,","poem":2},{"lineBreak":true},{"text":"mehnda ma komw kin ketin kalokehkin irail diparail kan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kapinga KAUN-O atail Koht","poem":1},{"text":"oh kaudok pohn sapwellime dohl sarawio!","poem":2},{"noteId":17},{"text":"KAUN-O atail Koht me sarawihe.","poem":1}]}],"footnotes":[{"noteId":17,"caller":"a","text":"99.9 DOHL SARAWI: Tehk 2.6.","reference":{"chapter":99,"verse":9}}]},"thisChapterLink":"/api/pon_ssp/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_ssp/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_ssp/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}