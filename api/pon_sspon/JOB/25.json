{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"JOB","translationId":"pon_sspon","name":"SOHP","commonName":"SOHP","title":"SOHP","order":18,"numberOfChapters":42,"sha256":"08a19e5604559f122cf7eb722c185f12c6d28eecc5e8e2f295992149c0d95583","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/pon_sspon/JOB/42.json","totalNumberOfVerses":1037},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"Koht me manaman; aramas koaros pahn lemmwiki ih;","poem":1},{"text":"e kin ketin kolokol wehin nanleng ni popohl.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mie me kak wadekada tohnleng kan me kin papah?","poem":1},{"lineBreak":true},{"text":"Mie wasa me sapwellimen Koht marain sohte kin daker?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mie emen me kak pwung oh mwakelekel mwohn silangin Koht?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maram pil sohte kin marain mwohn silangi,","poem":1},{"text":"de usu kan sohte mwakelekel.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ahpw ia duwen aramas, me duwehte mwahs, kisin mensiek?","poem":1},{"text":"Ia kesempwal en aramas mwohn silangin Koht?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":5}