{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":1,"content":[{"type":"heading","content":["Pai mehlel"]},{"type":"verse","number":1,"content":[{"text":"Meid pai aramas akan","poem":1},{"text":"me kin soikala kaweid en aramas suwed kan,","poem":2},{"lineBreak":true},{"text":"me sohte kin men kalemengih me dipan akan,","poem":2},{"lineBreak":true},{"text":"de patehng irail akan me sohte kin wauneki Koht;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ahpw re kin perenki peikiong Kosonned en KAUN-O,","poem":1},{"text":"oh medemedewe nan kapehdihr nin rahn oh nipwong.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Re rasehng tuhke kan limwahn pihl akan,","poem":1},{"text":"me kin materek nan rahk koaros,","poem":2},{"lineBreak":true},{"text":"oh tehrail kan sohte kin mengila.","poem":2},{"text":"Re kin pweida mwahu ni soahng koaros me re kin wia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ahpw aramas suwed akan sohte mwahn kin duwehte;","poem":1},{"text":"re rasehng teh meng kan me kisinieng kin ipihpirseli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Koht pahn ketin kaloke me dipan akan","poem":1},{"text":"oh re pahn katohrohrsang sapwellime aramas akan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"KAUN-O pahn ketin kawekaweid oh sinsile me pwung kan,","poem":1},{"text":"a aramas suwed akan pahn lekdekla kohkohlahte.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}