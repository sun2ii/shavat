{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":100,"content":[{"type":"heading","content":["Melkahkahn Kaping 100:0 TITLE NI MAHSEN EN IPRU: Melkahkahn kapingkalahngan."]},{"type":"verse","number":1,"content":[{"text":"Tohn sampah koaros, kumwail kokouliong KAUN-O!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kumwail pereperen kaudokiong KAUN-O","poem":1},{"text":"oh patohdo mwohn silangi ngisingiski amwail koul!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dehr manokehla me KAUN-O, iei ih Koht.","poem":1},{"text":"Ih me ketin wieikitailda, oh ih me kin sapwellimankin kitail;","poem":2},{"lineBreak":true},{"text":"kitail me sapwellime aramas, kitail me sapwellime pelin sihpw.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kumwail pedokihlong nan kelen Tehnpaso amwail koulen kaping;","poem":1},{"text":"kumwail patohlong nan sapwellime mwoahl sarawi ni kapingkalahngan.","poem":2},{"lineBreak":true},{"text":"Kumwail patohwanohng amwail kapingkalahngan oh kapikapinga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"KAUN-O me kalahngan;","poem":1},{"text":"sapwellime limpoak kin poatopoatete","poem":2},{"lineBreak":true},{"text":"oh e kin ketin dadaurete sapwellime loalopwoat kohkohlahte.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}