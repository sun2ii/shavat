{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":113,"content":[{"type":"heading","content":["Kapingpen sapwellimen KAUN-O Kalahngan"]},{"type":"verse","number":1,"content":[{"text":"Kapinga KAUN-O!","poem":1},{"lineBreak":true},{"text":"Kumwail sapwellimen KAUN-O ladu kan,","poem":1},{"text":"kumwail kapinga mware!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kapingpen mware en wiawi,","poem":1},{"text":"met oh pil kohkohlahte.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sang palimese lel palikapi","poem":1},{"text":"kumwail kapinga mwaren KAUN-O!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"KAUN-O kin ketin kakaun wehi kan koaruhsie;","poem":1},{"text":"sapwellime lingan sikdahla sang nanleng.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sohte emen duwehte KAUN-O, atail Koht.","poem":1},{"lineBreak":true},{"text":"E kin ketiket powe wasa ileilehie,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"ahpw kin ketin mahsendihdo","poem":2},{"lineBreak":true},{"text":"oh ireirong nanleng oh sampah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"E kin ketin pwekada me semwehmwe kan sang nanpwel;","poem":1},{"text":"e kin ketin kasapwilada me paisuwedlahr akan sang ar apwal","poem":2}]},{"type":"verse","number":8,"content":[{"text":"oh kin ketin wiahkinirailla werek en me lapalap akan,","poem":1},{"text":"me lapalap en sapwellime aramas akan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E kin ketin kawauwihala lih depwen kan nan imwarail kan;","poem":1},{"text":"oh kapaiahkin irail seri.","poem":2},{"lineBreak":true},{"text":"Kapinga KAUN-O!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}