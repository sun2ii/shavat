{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":120,"content":[{"type":"heading","content":["Kapakap en Peki Sawas"]},{"type":"verse","number":1,"content":[{"text":"Ni ei mihla nan apwal, I ahpw patohwan likweriong KAUN-O,","poem":1},{"text":"e ahpw ketin sapeng ie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maing KAUN, komw ketin doareiesang","poem":1},{"text":"aramas likamw oh widing kan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kumwail me likamw akan, dahme Koht pahn ketin wiahiong kumwail?","poem":1},{"text":"Ia duwen eh pahn ketin kalokei kumwail?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lokolok en arep keng sang sounpei men,","poem":1},{"text":"iangahki takai mwehl sang nan uhmw!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ei koukousoan rehmwail me kansensuwed rasehng ei keiru nan Mesek,","poem":1},{"text":"de rehn mehn Kedar","poem":2},{"noteId":20},{"text":"kan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Meid werei ei kousoanlahr","poem":1},{"text":"rehn aramas akan me kin kailongki mwehi kapohl!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ni ei kin patohwan ong irail duwen mwehi kapohl,","poem":1},{"text":"re kin mwahuki mahwen.","poem":2}]}],"footnotes":[{"noteId":20,"caller":"k","text":"MESEK...KEDAR: Sahpw doh riau, me dene towe kan kin kemehla aramas pwehki ar rotorot.","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/pon_sspon/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}