{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":121,"content":[{"type":"heading","content":["KAUN-O, iei Silepatail"]},{"type":"verse","number":1,"content":[{"text":"I saradahng nahna kan;","poem":1},{"text":"ia wasa me sawasepei pahn kohdo sang ie?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sawasepei pahn pwarodo sang rehn KAUN-O,","poem":1},{"text":"me ketin kapikada nanleng oh sampah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"E sohte pahn mweidohng ke en pwupwudi;","poem":1},{"text":"silepomw sohte kin ketin seimwokla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Silepen Israel","poem":1},{"text":"sohte kin ketin lusoi de seimwok!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"KAUN-O, iei ih me pahn ketin sinsileiuk;","poem":1},{"text":"e kin ketiket limwahmw pwe en ketin apwalihiuk.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ketipin sohte pahn kauweiukala nin rahn,","poem":1},{"text":"de maram nipwong.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"KAUN-O pahn ketin silehsang uhk soahng keper koaros;","poem":1},{"text":"e pahn ketin sinsileiuk mehlel.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E pahn ketin sinsileiuk ni omw kohwei oh kohdo,","poem":1},{"text":"met oh pil kohkohlahte.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}