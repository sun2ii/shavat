{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":122,"content":[{"type":"heading","content":["Kapingpen Serusalem 122:0 TITLE NI MAHSEN EN IPRU: En Depit."]},{"type":"verse","number":1,"content":[{"text":"I nsenamwahukihla ni ar patohwanohng ie,","poem":1},{"text":"“Kitail patohla nan tehnpas en KAUN-O.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eri iet, se miher met,","poem":1},{"text":"uh nan wenihmw kan en kelen Serusalem!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Serusalem, iei kahnimw me onohndasapahlehr","poem":1},{"text":"kahnimw lingan oh soanamwahu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iei wasaht me kadaudok kan kin patopene ie,","poem":1},{"text":"kadaudok en Israel kan,","poem":2},{"text":"pwe re en kin kapingkalahngan ong KAUN-O","poem":1},{"text":"nin duwen sapwellime kosonned.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iei wasaht me nanmwarkien Isreal kan","poem":1},{"text":"kin wia kopwung ong sapwellimarail aramas akan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kumwail peki mwehi kapohl ong Serusalem:","poem":1},{"text":"“Paiamwahu en kowohng irail kan me kin poakohng komwi.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mwehi kapohl en kin pweida nan omwi kehl kan,","poem":2},{"lineBreak":true},{"text":"oh meleilei nan tehnpasomwi kan.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pwehki riei kan oh kompoakepahi kan","poem":1},{"text":"I kin patohwanohng Serusalem, “Popohl en ieiang komwi!”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pwehn wia kamwahupen tehnpas en KAUN-O, atail Koht","poem":1},{"text":"I kin kapakapkin komwi pwe komwi en paiamwahu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}