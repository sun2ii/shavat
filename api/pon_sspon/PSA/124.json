{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":124,"content":[{"type":"heading","content":["Koht me Silepen Sapwellime Aramas akan 124:0 TITLE NI MAHSEN EN IPRU: En Depit."]},{"type":"verse","number":1,"content":[{"text":"Ia duwe, ma KAUN-O sohte ketin uhpalihkin kitail?","poem":1},{"text":"Israel, sapeng ie!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Ma KAUN-O sohte ketin uhpalihkinkitailehr","poem":1},{"text":"ni ahnsou me atail imwintihti kan mahweniong kitail,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"re uhdahn kadalleikitaillahr ni atail momour","poem":1},{"text":"nan arail lingeringer kowahlap;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"eri, kitail ahpw pahn peikihla ahden pillap akan,","poem":1},{"text":"oh mwopwla nan pihlo,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ahden lapake pahn kamwopwkitailla.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kitail kasapahlkalahngan ong KAUN-O,","poem":1},{"text":"me sohte ketin mweidohng atail imwintihti kan en kamwomwkitailla.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kitail pitlahr rasehng menpihr men me pitsang nan lidip en sounwie lidip kan;","poem":1},{"text":"lidipo ohlahr, oh kitail saledeklahr!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sawasepatail kin pwarodo sang rehn KAUN-O,","poem":1},{"text":"me ketin kapikada nanleng oh sampah.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}