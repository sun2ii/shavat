{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":125,"content":[{"type":"heading","content":["Silasil Mwahu en Sapwellimen Koht Aramas akan"]},{"type":"verse","number":1,"content":[{"text":"Irail kan me kin likih KAUN-O, re rasehng Nahna Saion,","poem":1},{"text":"me sohte kak itikekda, sohte kak mwekidida.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Duwen nahna kan ar kapilpene Serusalem,","poem":1},{"text":"ih duwen Koht eh kin ketin kapikapil sapwellime aramas akan,","poem":2},{"lineBreak":true},{"text":"met oh pil kohkohlahte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Aramas suwed kan sohte pahn kin kaunda sapwen me pwung kan ahnsou koaros;","poem":1},{"text":"pwe ma re pahn wia met, mwein me pwung kan pahn pil kakete iang wia me suwed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maing KAUN, komw ketin wiahda me mwahu ong irail kan me kin wia me mwahu,","poem":1},{"text":"irail kan me kin kapwaiada sapwellimomwi kosonned kan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ahpw ni omwi kin ketin kaloke aramas suwed akan,","poem":1},{"text":"komw pil ketin kaloke irail kan me kin sohpeisang sapwellimomwi ahl akan.","poem":2},{"lineBreak":true},{"text":"Popohl en kin ieiangete Israel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}