{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":126,"content":[{"type":"heading","content":["Kapakap en Peki Komour"]},{"type":"verse","number":1,"content":[{"text":"Ni ahnsou me KAUN-O ketin kasapahldohng kitail nan Serusalem,","poem":1},{"text":"likamwete kitail ouraman!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ia uwen atail kouruhr! Ia uwen atail koul oh ngisingiski atail peren!","poem":1},{"text":"Mehn liki kan ahpw ndinda,","poem":2},{"lineBreak":true},{"text":"“Wiepen nin limen KAUN-O rehrail me lapalap.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mehlel e ketin wiadahr soahng kapwuriamwei kei rehtail;","poem":1},{"text":"ia uwen atail peren!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Maing KAUN, komw ketin kasapahlkitalahng nan uhdakato,","poem":1},{"text":"duwehte keteu eh kin kasapahldohng pihl nan warawar en pihl me madada kan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Irail kan me sengiseng nindokon arail kamwakamwarak,","poem":1},{"text":"re en dolung wahnsapwarail pereperen!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Irail kan me sengiseng nindokon arail weuwa kohwei ar werentuhke kan","poem":1},{"text":"re en koul oh ngisingiski peren ni arail pahn pwurodo,","poem":2},{"lineBreak":true},{"text":"wa kohdo wahnsapwarail.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}