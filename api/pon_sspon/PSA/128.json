erusalem","poem":2},{"lineBreak":true},{"text":"rahn koaros en omw mour!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ke en momour oh kak kilang nein noumw seri kan!","poem":1},{"lineBreak":true},{"text":"Popohl en kin ieiangete Israel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}