{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":129,"content":[{"type":"heading","content":["Kapakap en Uhwong Imwintihti en Mehn Israel"]},{"type":"verse","number":1,"content":[{"text":"Israel, ndadohng kiht mahs duwen omw imwintihti kan ar kalokeiuk","poem":1},{"text":"sangete ni omw pwulopwul.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Sang ni ei pwulopwul","poem":1},{"text":"ei imwintihti kan kalokehkin ie kalokolok mwuledek,","poem":2},{"lineBreak":true},{"text":"ahpw re so mwahn kaloweiehdi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Re kalipwelipwehda tihnseweiet","poem":1},{"text":"duwehla wasa me kin deideidahr ong wasahn poad wahnsahpw.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ahpw KAUN-O, ih me pwung,","poem":1},{"text":"e ketin kasaledekihiehla sang nan mour en lidu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Eri koaros me kin kailongki Saion","poem":1},{"text":"re en lohdi oh tangdoaui.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Irail koaros en duwehla dihpw me kin wosada pohn pwelengen ihmw,","poem":1},{"text":"me kin mengila mwohn eh pahn laudla;","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"me sohte me kin rikpene","poem":2},{"lineBreak":true},{"text":"de wahsang.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sohte me kin keid limwah pahn nda,","poem":1},{"text":"“KAUN-O en ketin kupwuramwahwih kumwail!","poem":2},{"lineBreak":true},{"text":"Se kupwuramwahwih kumwail ni mwaren KAUN-O.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}