{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":13,"content":[{"type":"heading","content":["Kapakap en Peki Sawas 13:0 TITLE NI MAHSEN EN IPRU: En Depit melkahka."]},{"type":"verse","number":1,"content":[{"text":"Maing KAUN, ia erein omwi pahn ketin likidmelieiehla, e pahn kohkohlahte?","poem":1},{"text":"Ia erein omwi pahn ketin karirala sang ie silangmwi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ia erein ei pahn patopato nan apwal?","poem":1},{"text":"Ia erein mohngiongi eh pahn wie toutouki nsensuwed nin rahn oh nipwong?","poem":2},{"lineBreak":true},{"text":"Ia erein ei imwintihti kan ar pahn kin poweiehdi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Maing KAUN, ei Koht, komw ketin mahsendohng ie oh sapeng ie.","poem":1},{"text":"Komw ketin kakehleiehda sapahl; komw dehr ketin mweidohng I en mehla.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Komw dehr mweidohng ei imwintihti kan en nda, “Kitail kalowedier!”","poem":1},{"text":"Komw dehr mweidohng re en kepitiki ei pwupwudi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I kin koapworopworki sapwellimomwi limpoak poatopoat;","poem":1},{"text":"I kin peren, pwehki komwi pahn ketin doareiehla.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maing KAUN, I pahn kouliong komwi,","poem":1},{"text":"pwehki sapwellimomwi kalahngan ong ie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}