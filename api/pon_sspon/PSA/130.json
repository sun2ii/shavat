{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":130,"content":[{"type":"heading","content":["Kapakap en Peki Sawas"]},{"type":"verse","number":1,"content":[{"text":"Maing KAUN, sang nan ei weikeklahr mwuledek, I patohwan likweriong komwi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maing ei Kaun, komw ketin karonge ie,","poem":1},{"text":"komw ketin karonge ngilen ei pek sawas!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ma komw pahn ketin kilelehdi dipat akan,","poem":1},{"text":"ihs me kak pitsang sapwellimomwi kadeik?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A komw kin ketin mahkohng kiht,","poem":1},{"text":"pwe se en kin lemmwikin komwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I kin ngoangki kasikasik sawas sang rehn KAUN-O,","poem":1},{"text":"oh I kin likih mehlel sapwellime mahsen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I kin kasikasik KAUN-O","poem":1},{"text":"laudsang silepen nipwong kan ar kin awiawih marain en nin sohrahn—","poem":2},{"lineBreak":true},{"text":"ei, laudsang silepen nipwong kan ar kin awiawih marain en nin sohrahn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kumwail tohn Israel, kumwail en likih KAUN-O,","poem":1},{"text":"pwehki sapwellime limpoak me poatopoat","poem":2},{"lineBreak":true},{"text":"oh e kin ketin kupwurohki doareikitailla ahnsou koaros.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E pahn ketin doarehla sapwellime aramas en Israel kan","poem":1},{"text":"sang nan diparail kan koaros.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}