{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":136,"content":[{"type":"heading","content":["Koulen Kapingkalahngan"]},{"type":"verse","number":1,"content":[{"text":"Kumwail kapingkalahngan ong KAUN-O, pwehki ih me ketin kupwur mwahu;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kumwail kapingkalahngan ong Koht me keieu lapalapasang koht akan koaros;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kumwail kapingkalahngan ong kaun me keieu roson sang kaun akan koaros;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ihete me kin ketin wiahda manaman kapwuriamwei kan;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sapwellime erpit me e ketin wiahkihda nanleng;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E ketin kauwada sampah pohn pihl loal akan;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"E ketin kapikada ketipin oh maram;","poem":1},{"text":"sapwellime limpoak me poatopoat;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ketipin mehn kakaun rahn akan;","poem":1},{"text":"sapwellime limpoak me poatopoat;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"maram oh usu kan mehn kakaun nipwong;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"E ketin kemehla mesenih koaros nan Isip;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E ketin kahluwa mehn Israel ko sang Isip;","poem":1},{"text":"sapwellime limpoak me poatopoat;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ni roson oh manaman en nin lime;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"E ketin pwalangpeseng Sehd Weitahtao;","poem":1},{"text":"sapwellime limpoak me poatopoat;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"e ketin kahluwa sapwellime aramas ako nansedo;","poem":1},{"text":"sapwellime limpoak me poatopoat;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"e ahpw ketin kakihrala nanmwarkien Isip oh iangahki nah karis ko;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"E ketin kahluwa sapwellime aramas ako nan sapwtehn;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"E ketin kemehla nanmwarki kehlail kan;","poem":1},{"text":"sapwellime limpoak me poatopoat;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"e ketin kemehla nanmwarki ndand kan;","poem":1},{"text":"sapwellime limpoak me poatopoat;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sihon, nanmwarkien mehn Amor;","poem":1},{"text":"sapwellime limpoak me poatopoat;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"oh Ok, nanmwarkien Pasan;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"E ketikihong sapwarail ko ong sapwellime aramas ako;","poem":1},{"text":"sapwellime limpoak me poatopoat;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"E ketikihong Israel, sapwellime ladu;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"E sohte ketin melieikitailla ni atail lohdi;","poem":1},{"text":"sapwellime limpoak me poatopoat;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"E ketin kasaledengkitailla sang atail imwintihti kan;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"E kin ketikihong mehkoaros me momour kisin tungoal;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kumwail kapingkalahngan ong Koht en nanleng;","poem":1},{"text":"sapwellime limpoak me poatopoat.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}