{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":15,"content":[{"type":"heading","content":["Dahme Koht kin Kupwurki 15:0 TITLE NI MAHSEN EN IPRU: En Depit melkahka."]},{"type":"verse","number":1,"content":[{"text":"Maing KAUN, ihs me kak patohlong nan Tehnpasomwi?","poem":1},{"text":"Ihs me kak patohwan kaudok pohn Saion, sapwellimomwi dohl sarawio?","poem":2},{"noteId":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aramas me kin peikiong Koht ni mehkoaros","poem":1},{"text":"oh kin wia me pwung ahnsou koaros,","poem":2},{"text":"me kin lokaia pwung oh mehlel,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"oh sohte kin karaunmwahlih meteikan.","poem":2},{"text":"E sohte kin wia mehkot sapwung ong kompoakepah kan,","poem":1},{"text":"oh sohte kin ndindaseli mehn mpe kan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E kin kailongki irail kan me Koht kin ketin soikala,","poem":1},{"text":"ahpw e kin wauneki irail kan me kin peikiong KAUN-O.","poem":2},{"text":"E kin kapwaiada dahme e inouki ahnsou koaros,","poem":1},{"text":"mehnda ma e apwal.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"E sohte kin ale wihnen nah mwohni me aramas pekihsang pwe re en doadoahngki;","poem":1},{"text":"oh e pil sohte pahn wia sounkadehde likamw ong emen me sohte dipe pwe en ale pweine.","poem":2},{"lineBreak":true},{"text":"Eri, me kin kapwaiada mepwukat pahn pehm saledek sang apwal kohkohlahte.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"p","text":"DOHL SARAWI: Tehk 2.6.","reference":{"chapter":15,"verse":1}}]},"thisChapterLink":"/api/pon_sspon/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}