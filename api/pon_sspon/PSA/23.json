{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":23,"content":[{"type":"heading","content":["KAUN-O, Silepatail 23:0 TITLE NI MAHSEN EN IPRU: En Depit melkahka."]},{"type":"verse","number":1,"content":[{"text":"KAUN-O, iei silepei;","poem":1},{"text":"solahr me I pahn anahne.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"E ketin kommoaleiehdi nan mohsen dihpw kaselel kei,","poem":1},{"text":"oh kin ketin kahluwaielahng ni pihl mwakelekel.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E kin ketin kakehleiehda.","poem":1},{"lineBreak":true},{"text":"E kin ketin kahluwa ie nan ahl me pwung,","poem":1},{"text":"nin duwen eh ketin inoukidahr.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maing KAUN, mehnda ma I weweidwei nan rotorot mosul,","poem":1},{"text":"a I sohte pahn masak mehkot,","poem":2},{"lineBreak":true},{"text":"pwe komw ketin ieiang ie!","poem":2},{"text":"Sapwellimomwi irar oh lepin seipali","poem":1},{"noteId":6},{"text":"pahn kin sinsile ie.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Komw ketin kaunopadahng ie kamadipw ehu,","poem":1},{"text":"wasa me ei imwintihti kan koaros kak kilang ie;","poem":2},{"text":"komw ketin kasamwo ie oh kielediong leh pohn moangei","poem":1},{"text":"oh kadikadirehdohte ei tungoal kep.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I ese me sapwellimomwi kalahngan oh limpoak pahn ieiang iehte erein ei mour;","poem":1},{"text":"oh I pahn patopatohte nan tehnpasomwi kohkohlahte.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"a","text":"IRAR OH LEPIN SEIPALI: Tehk nan kawehwehpen lepin mahsen kan.","reference":{"chapter":23,"verse":4}}]},"thisChapterLink":"/api/pon_sspon/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}