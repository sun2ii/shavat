{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":3,"content":[{"type":"heading","content":["Kapakap en Peki Sawas en Nimenseng 3:0 TITlE NI MAHSEN EN IPRU: Depit wiahda melkahka wet mwurin eh tangasang sapwellime pwutak Apsalom. 3:0 2 Sam. 15.13—17.22."]},{"type":"verse","number":1,"content":[{"text":"Maing KAUN, ei imwintihti kan me ngeder,","poem":1},{"text":"re inenen tohto me kin pelian ie!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Re kin koasoakoasoia ie oh ndinda,","poem":1},{"text":"“Koht sohte pahn ketin sewese.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ahpw Maing KAUN, komwi me soundoarepei sang me keper kan ahnsou koaros;","poem":1},{"text":"komwi me kin ketin kupwurehda I en kin powehdi,","poem":2},{"lineBreak":true},{"text":"komwi me kin ketin pwurehng kakehleiehda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I patohwan likweriong KAUN-O, pwe en ketin sewese ie,","poem":1},{"text":"e ahpw ketin sapeng ie sang pohn sapwellime dohl sarawi.","poem":2},{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I kin wendi oh memeir nipwong kan,","poem":1},{"text":"KAUN-O kin ketin sinsile ie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I sohte kin masak kiden imwintihti kan","poem":1},{"text":"me kin kapiliepene sang wasa koaros.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Maing KAUN, komw ketido! Maing Koht, komw ketin kapitiehla!","poem":1},{"lineBreak":true},{"text":"Komw kin ketin kaloke ei imwintihti kan koaros","poem":1},{"text":"oh ketikihsang irail manaman en kauweiehla.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Manaman en powehdi kin pwilisang rehn KAUN-O—","poem":1},{"text":"en ketin kupwuramwahwih sapwellime aramas akan.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"c","text":"DOHL SARAWI: Tehk 2.6.","reference":{"chapter":3,"verse":4}}]},"thisChapterLink":"/api/pon_sspon/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}