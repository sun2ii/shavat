{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":43,"content":[{"type":"heading","content":["Kapakap en me Kalipilipada Men"]},{"type":"hebrew_subtitle","content":["(Pouspen Melkahka 42)"]},{"type":"verse","number":1,"content":[{"text":"Maing Koht, komw ketin kadehdehda eh sohte dipei,","poem":1},{"text":"oh ketin seweseiehda nan ei kopwung rehn me dipan akan;","poem":2},{"lineBreak":true},{"text":"komw ketin kapitiesang rehn aramas likamw oh mwersuwed kan!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Komwi me silepei;","poem":1},{"text":"dahme komw ketin likidmeliekiniehla?","poem":2},{"text":"Dahme I kin wie lokolongki","poem":1},{"text":"pahn manaman en ei imwintihti kan?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Komw ketin kadarodo sapwellimomwi marain oh mehlel","poem":1},{"text":"pwe en kahluwa ie","poem":2},{"lineBreak":true},{"text":"oh pwurehng kahrehiewohng ni sapwellimomwi dohl sarawi,","poem":2},{"noteId":7},{"text":"Saion,","poem":2},{"lineBreak":true},{"text":"oh nan Tehnpasomwi, wasa komw kin ketiket ie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maing Koht, I ahpw pahn patohlahng ni sapwellimomwi pei sarawi;","poem":1},{"text":"komwi me poahsoan en ei peren.","poem":2},{"text":"I pahn koulen kaping ong komwi sang nin nei keseng arpet,","poem":1},{"text":"Maing Koht, ei Koht.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dahme I nohn nsensuwedkilahret?","poem":1},{"text":"Dahme I nohn pwunodkidahr?","poem":2},{"text":"Eri soh, I pahn koapworopworki Koht,","poem":1},{"text":"oh I pahn pwurehng kapinga,","poem":2},{"lineBreak":true},{"text":"ei sounkomour oh ei Koht.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"u","text":"DOHL SARAWI: Tehk 2.6.","reference":{"chapter":43,"verse":3}}]},"thisChapterLink":"/api/pon_sspon/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}