{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":54,"content":[{"type":"heading","content":["Kapakap en Silasil sang Imwintihti kan 54:0 TITLE NI MAHSEN EN IPRU: En Depit koul, mwurin ohl ako sang Sip ar kohla rehn Sohl oh patohwanohng me Depit wie rukuruk nan sapwarailo. 54:0 1 Sam. 23.19; 26.1."]},{"type":"verse","number":1,"content":[{"text":"Maing Koht, komw ketin doarehkiniehla sapwelimomwi manaman;","poem":1},{"text":"komw ketin kasaledekehkiniehla sapwellimomwi manaman!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maing Koht, komw ketin karonge ei kapakap;","poem":1},{"text":"komw ketin karonge ei tungoal pato kat!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aramas aklapalap ekei kohkohdohng peiong ie;","poem":1},{"text":"aramas lemei kan songosong en kemeiehla—","poem":2},{"lineBreak":true},{"text":"soangen aramas me sohte kin wauneki Koht.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ahpw Koht iei sawasepei.","poem":1},{"text":"Kaun-o iei soundoarepei.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Koht en ketin kupwure pwe ei imwintihti kan en lokolongki pein ar wiewia suwed kan.","poem":1},{"text":"E pahn ketin kamwomwirailla pwehki ih me loalopwoat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Maing KAUN, I pahn patohwan perenki wiahiong komwi ehu meirongen;","poem":1},{"text":"I pahn patohwan kapingkalahngankihong komwi","poem":2},{"lineBreak":true},{"text":"pwehki omwi kupwur mwahu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Komwi me ketin kapitiehla sang nan ei apwal akan koaros,","poem":1},{"text":"oh I patohwanehr duwen ei imwintihti kan ar lohdier.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}