{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":61,"content":[{"type":"heading","content":["Kapkap en Silasil 61:0 TITLE NI MAHSEN EN IPRU: En Depit."]},{"type":"verse","number":1,"content":[{"text":"Maing Koht, komw ketin karonge ei likwer;","poem":1},{"text":"komw ketin karonge ei kapakap!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nan ei mwoatohtalahr solahr angi oh dohsangehr sapweio,","poem":1},{"text":"I ahpw patohwan likweriong komwi.","poem":2},{"lineBreak":true},{"text":"Komw ketikiwohng ie wasahn ruk mwahu,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"pwe komwi me silepei,","poem":2},{"lineBreak":true},{"text":"soundoarepei kehlail en pelian ei imwintihti kan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Komw ketin mweidohng ie pwe I en kin patopatohte nan mwoalomwi sarawi erein ei mour;","poem":1},{"text":"pwe I en kin diar ei wasahn ruk oh meleilei pahn mwetehn nin limomwi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maing Koht, komw ketin karongeier ei tungoal inou kan","poem":1},{"text":"oh ketikihongieier dahme en irail kan me kin waunekin komwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Komw ketin kareireila mour en nanmwarkio;","poem":1},{"text":"komw kupwure pwe en kin momour kohkohlahte!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maing Koht, nanmwarkio en kin kakaun mwohn silangmwi kohkohlahte;","poem":1},{"text":"komw ketin kasilehki sapwellimomwi limpoak poatopoat oh loalopwoat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Eri, I pahn patohwan koulkihong komwi koulen kaping ahnsou koaros,","poem":1},{"text":"ni ei pahn kin patohwan meirongkihong komwi rahn koaros dahme I inoukidahr.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}