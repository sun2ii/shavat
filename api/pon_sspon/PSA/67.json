{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":67,"content":[{"type":"heading","content":["Koulen Kaping Kalahngan 67:0 TITLE NI MAHSEN EN IPRU: Melkahka pwoat; koul pwoat."]},{"type":"verse","number":1,"content":[{"text":"Maing Koht, komw ketin kupwurei kiht, oh kupwuramwahwihkitala;","poem":1},{"text":"komw ketin kupwur kalahngan oh mahsendohng kiht,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"pwe sampah pwon en marainkihla kupwuromwien;","poem":1},{"text":"oh wehi koaros en dehdehkihla sapwellimomwi manaman en komour.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Maing Koht, aramas akan en kapinga komwi,","poem":1},{"text":"aramas koaros en kapinga komwi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tohnwehi kan en nsenamwahu oh koulki ar peren,","poem":1},{"text":"pwehki omwi kin ketin kapwungkihla pwung mehlel aramas akan","poem":2},{"lineBreak":true},{"text":"oh kin ketin kaweid wehi koaros nin sampah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Maing Koht, aramas akan en kapinga komwi;","poem":1},{"text":"aramas koaros en kapinga komwi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sapwatail kapwaredahr audepe;","poem":1},{"text":"Koht, atail Koht, ketin kupwuramwahwihkitailehr.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Koht ketin kupwuramwahwihkitailehr;","poem":1},{"text":"aramas koaros wasa koaros en wauneki ih.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}