{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":70,"content":[{"type":"heading","content":["Kapakap en Peki Sawas 70:0 TITLE NI MAHSEN EN IPRU: En Depit melkahka; koulen kedepwidepw pwoat."]},{"type":"verse","number":1,"content":[{"text":"Maing Koht, komw ketin komouriehla!","poem":1},{"text":"Maing KAUN, komw ketin sewese ie ahnsou wet!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Irail kan me songosong en kemeiehla","poem":1},{"text":"re en lohdi oh pingida.","poem":2},{"text":"Irail kan me kin perenki ei apwal","poem":1},{"text":"re en pwurala oh namenekla.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Irail kan me kin kouruhrkin ie","poem":1},{"text":"re en sarokihdi ar lohdi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Irail koaros me kin patohdo rehmwi","poem":1},{"text":"re en nsenamwahu oh pereperen.","poem":2},{"text":"Irail koaros me kin kasapahl kalahnganki ong komwi sapwellimomwi komour","poem":1},{"text":"re en kin patopatohwan ahnsou koaros, “Meid lapalap atail Koht!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Maing Koht, ngehi me luwet oh semwehmwe;","poem":1},{"text":"komw ketidohng rehi mwadang.","poem":2},{"text":"Komwi me ei sounkomour oh ei Kaun—","poem":1},{"text":"komw ketin mwadangodo oh sewese ie!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}