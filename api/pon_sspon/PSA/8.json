{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":8,"content":[{"type":"heading","content":["Lingan en Koht oh Kesempwal en Aramas 8:0 TITLE NI MAHSEN EN IPRU: En Depit melkahka."]},{"type":"verse","number":1,"content":[{"text":"Maing KAUN, at Kaun,","poem":1},{"text":"sapwellimomwi roson lapalap kin sansal wasa koaros nin sampah!","poem":2},{"text":"Kapingpomwi kin leldawohng nanleng;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"seri kan oh seri pwelel kan pil kin kapinga komwi.","poem":1},{"lineBreak":true},{"text":"Komwi me ketin kauwadahr kelen mahwen ong sapwellimomwi imwintihti kan,","poem":1},{"text":"pwe en irehdi irail koaros me kin pelian komwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ni ei kin kilengdawohng pahnlahng, iei wiepen nin limomwi,","poem":1},{"text":"maram oh usu kan me komw ketin koasoanedier nan dewerail—","poem":2}]},{"type":"verse","number":4,"content":[{"text":"dahkot aramas, me komwi kin ketin kupwukupwure;","poem":1},{"text":"aramas mwahl, me komwi kin ketin apwahpwalih?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Komwi me ketin koasoanehdi aramas pwe komwihte me re pahn patopato pah;","poem":1},{"text":"komwi me ketin kamwarehkinirailda lingan oh wahu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Komwi me ketin koasoanehdi pwe en kaunda wiepen nin limomwi koaros,","poem":1},{"text":"komwi me pil kasapwiladahng pohnangin mehkoaruhsie.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"sihpw oh kou koaros, oh pil mahn lawalo kan;","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"menpihr kan oh mwahmw akan,","poem":2},{"lineBreak":true},{"text":"oh mehkoaros me kin aude nan madau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Maing KAUN, at Kaun,","poem":1},{"text":"sapwellimomwi roson lapalap kin sansal wasa koaros nin sampah!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}