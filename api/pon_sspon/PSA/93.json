{"translation":{"id":"pon_sspon","name":"Pohnpeian Bible","website":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=pon2006","licenseNotes":null,"shortName":"SSPON","englishName":"Pohnpeian Bible 2006","language":"pon","textDirection":"ltr","sha256":"103177c4bd4d288b444d4fbb68315f38927128c97b55fdd5ff19effbe80c5c23","availableFormats":["json"],"listOfBooksApiLink":"/api/pon_sspon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30207,"languageName":"Pohnpeian","languageEnglishName":"Pohnpeian"},"book":{"id":"PSA","translationId":"pon_sspon","name":"MELKAHKA KAN","commonName":"MELKAHKA KAN","title":"MELKAHKA KAN","order":19,"numberOfChapters":150,"sha256":"a5f25d8cb030a4fe11ac296e95d3a20af4bc5850519de7173e7814bdbe424b28","firstChapterNumber":1,"firstChapterApiLink":"/api/pon_sspon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/pon_sspon/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":93,"content":[{"type":"heading","content":["Koht Nanmwarki"]},{"type":"verse","number":1,"content":[{"text":"KAUN-O, iei nanmwarki.","poem":1},{"text":"E kin ketin kapwatkihda roson oh lingan.","poem":2},{"text":"Sampah tengedi nan dewe","poem":1},{"text":"oh sohte kak mwekid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maing KAUN, mwoalomwi me tengeteng sang mahs kohdo lel met,","poem":1},{"text":"oh komw ketiketier mwohn tepin kawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Maing KAUN, kepin madau kan kin ngiringirisek;","poem":1},{"text":"re kin ngiringirsengki ngihl laud.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"KAUN-O me ketin kaunda nanleng,","poem":1},{"text":"sapwellime manaman laud sang ngiringirisek en nan madau,","poem":2},{"lineBreak":true},{"text":"pil kehlailasang iloak en madau kan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Maing KAUN, sapwellimomwi kosonned akan me poatopoat,","poem":1},{"text":"oh Tehnpasomwio me inenen sarawi,","poem":2},{"lineBreak":true},{"text":"met oh pil kohkohlahte.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/pon_sspon/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pon_sspon/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pon_sspon/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}