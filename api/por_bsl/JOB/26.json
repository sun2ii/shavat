{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"JOB","translationId":"por_bsl","name":"Job","commonName":"Job","title":"O Livro de Job","order":18,"numberOfChapters":42,"sha256":"a0069a943c8f02219df1cc83937988163dde58b7063288ac6aa34ad5cb35e1c4","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/por_bsl/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["Então Job respondeu,"]},{"type":"verse","number":2,"content":[{"text":"“Como você tem ajudado quem está sem poder!","poem":1},{"text":"Como você salvou o braço que não tem força!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Como você o aconselhou a quem não tem sabedoria?","poem":1},{"text":"e com abundância de conhecimentos sólidos declarados!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A quem você dirigiu as palavras?","poem":1},{"text":"De quem saiu o espírito de vocês?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Os espíritos falecidos tremem,","poem":1},{"text":"os que vivem sob as águas e todos os que nelas vivem.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O Sheol","poem":1},{"noteId":11},{"text":"está nu diante de Deus,","poem":1},{"text":"e a Abaddon","poem":2},{"noteId":12},{"text":"não tem cobertura.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ele estende o norte sobre o espaço vazio,","poem":1},{"text":"e pendura a terra sobre o nada.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ele amarra as águas em suas nuvens grossas,","poem":1},{"text":"e a nuvem não irrompe sob eles.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ele encerra a face de seu trono,","poem":1},{"text":"e espalha sua nuvem sobre ela.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ele descreveu um limite na superfície das águas,","poem":1},{"text":"e aos limites da luz e da escuridão.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Os pilares do céu tremem","poem":1},{"text":"e estão surpresos com sua repreensão.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ele agita o mar com seu poder,","poem":1},{"text":"e por seu entendimento, ele ataca através de Rahab.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Por seu Espírito, os céus são guarnecidos.","poem":1},{"text":"Sua mão furou a serpente rápida.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Eis que estas são apenas as periferias de seus caminhos.","poem":1},{"text":"Quão pequeno é o sussurro que ouvimos dele!","poem":2},{"lineBreak":true},{"text":"Mas o trovão de seu poder, quem pode entender?”","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"O Sheol é o lugar dos mortos.","reference":{"chapter":26,"verse":6}},{"noteId":12,"caller":"+","text":"Abaddon significa Destruidor.","reference":{"chapter":26,"verse":6}}]},"thisChapterLink":"/api/por_bsl/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}