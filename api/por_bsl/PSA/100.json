ua fidelidade a todas as gerações.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}