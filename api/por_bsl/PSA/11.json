{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Para o músico chefe. Por David."]},{"type":"verse","number":1,"content":[{"text":"Em Yahweh, eu me refugio.","poem":1},{"text":"Como você pode dizer à minha alma: “Fuja como um pássaro para sua montanha”?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pois, eis que os malvados dobram seus arcos.","poem":1},{"text":"Eles colocam suas setas sobre as cordas,","poem":2},{"lineBreak":true},{"text":"que eles podem atirar na escuridão com o coração erguido.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Se as fundações forem destruídas,","poem":1},{"text":"o que os justos podem fazer?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahweh está em seu templo sagrado.","poem":1},{"text":"Yahweh está em seu trono no céu.","poem":2},{"text":"Seus olhos observam.","poem":1},{"text":"Seus olhos examinam os filhos dos homens.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahweh examina os justos,","poem":1},{"text":"mas sua alma odeia os ímpios e aquele que ama a violência.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sobre o malvado choverá brasas em chamas;","poem":1},{"text":"fogo, enxofre e vento abrasador será a porção de seu copo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pois Yahweh é justo.","poem":1},{"text":"Ele ama a retidão.","poem":2},{"lineBreak":true},{"text":"O erguido deve ver seu rosto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}