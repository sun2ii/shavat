{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Um salmo de David."]},{"type":"verse","number":1,"content":[{"text":"Yahweh diz a meu Senhor: “Sente-se à minha direita”,","poem":1},{"text":"até que eu faça de seus inimigos seu escabelo para seus pés”.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahweh enviará a haste de sua força para fora de Zion.","poem":1},{"text":"Governe entre seus inimigos.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Seu povo se oferece de boa vontade no dia de seu poder, em santa disposição.","poem":1},{"text":"Fora do ventre da manhã, você tem o orvalho de sua juventude.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahweh jurou, e não vai mudar de idéia:","poem":1},{"text":"“Você é um padre para sempre na ordem de Melchizedek”.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O Senhor está à sua direita.","poem":1},{"text":"Ele esmagará os reis no dia de sua ira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ele julgará entre as nações.","poem":1},{"text":"Ele vai amontoar cadáveres.","poem":2},{"lineBreak":true},{"text":"Ele esmagará o governante de toda a terra.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ele vai beber do riacho no caminho;","poem":1},{"text":"portanto, ele levantará sua cabeça.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}