evanta os pobres da poeira,","poem":1},{"text":"e levanta os necessitados do amontoado de cinzas,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"that ele pode colocá-lo com príncipes,","poem":1},{"text":"mesmo com os príncipes de seu povo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ele instala a mulher estéril em sua casa","poem":1},{"text":"como uma alegre mãe de filhos.","poem":2},{"text":"Louvado seja Yah!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}