{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Quando Israel saiu do Egito,","poem":1},{"text":"a casa de Jacob de um povo de língua estrangeira,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Judah se tornou seu santuário,","poem":1},{"text":"Israel, seu domínio.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O mar o viu, e fugiu.","poem":1},{"text":"O Jordão foi levado de volta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"As montanhas saltaram como carneiros,","poem":1},{"text":"as pequenas colinas como cordeiros.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O que foi, seu mar, que você fugiu?","poem":1},{"text":"Você Jordan, que você voltou para trás?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vocês montanhas, que saltaram como carneiros?","poem":1},{"text":"Vocês, pequenos morros, gostam de cordeiros?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tremble, terra, na presença do Senhor,","poem":1},{"text":"com a presença do Deus de Jacob,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"que transformou a rocha em uma piscina de água,","poem":1},{"text":"a pedra em um manancial de águas.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}