{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Para o Músico Chefe; sobre uma lira de oito cordas. Um Salmo de David."]},{"type":"verse","number":1,"content":[{"text":"Help, Yahweh; pois o homem piedoso cessa.","poem":1},{"text":"Pois os fiéis falham entre os filhos dos homens.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Todos mentem ao seu próximo.","poem":1},{"text":"Eles falam com lábios lisonjeiros, e com um coração duplo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Que Yahweh corte todos os lábios lisonjeiros,","poem":1},{"text":"e a língua que se vangloria,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"que disseram: “Com nossa língua prevaleceremos”.","poem":1},{"text":"Nossos lábios são os nossos próprios.","poem":2},{"lineBreak":true},{"text":"Quem é o senhor sobre nós”?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Por causa da opressão dos fracos e por causa do gemido dos necessitados,","poem":1},{"text":"Agora eu me levantarei”, diz Yahweh;","poem":2},{"text":"“Vou colocá-lo em segurança contra aqueles que o malignizam”.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"As palavras de Yahweh são palavras impecáveis,","poem":1},{"text":"como prata refinada em um forno de barro, purificada sete vezes.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Você vai mantê-los, Yahweh.","poem":1},{"text":"Você os preservará desta geração para sempre.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Os malvados caminham de todos os lados,","poem":1},{"text":"quando o que é vil é exaltado entre os filhos dos homens.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}