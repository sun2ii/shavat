{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Um Canto de Ascensões."]},{"type":"verse","number":1,"content":[{"text":"Na minha angústia, chorei a Javé.","poem":1},{"text":"Ele me respondeu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Entregar minha alma, Yahweh, de lábios mentirosos,","poem":1},{"text":"de uma língua enganosa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O que será dado a você e o que será feito mais a você,","poem":1},{"text":"sua língua enganosa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Setas afiadas dos poderosos,","poem":1},{"text":"com brasas de zimbro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ai de mim, que vivo em Meshech,","poem":1},{"text":"que eu moro entre as barracas de Kedar!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Minha alma já tem sua morada há muito tempo","poem":1},{"text":"com aquele que odeia a paz.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eu sou pela paz,","poem":1},{"text":"mas quando eu falo, eles são a favor da guerra.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}