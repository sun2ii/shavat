ue o amam prosperarão.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A paz esteja dentro de seus muros,","poem":1},{"text":"e prosperidade dentro de seus palácios.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Para o bem de meus irmãos e companheiros,","poem":1},{"text":"Direi agora: “A paz esteja dentro de você”.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Em nome da casa de Yahweh nosso Deus,","poem":1},{"text":"Buscarei o seu bem.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}