em":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mas eu confio em sua bondade amorosa.","poem":1},{"text":"Meu coração se regozija com sua salvação.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eu vou cantar para Yahweh,","poem":1},{"text":"porque ele tem sido bom para mim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}