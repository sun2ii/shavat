{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Uma Canção de Ascensões."]},{"type":"verse","number":1,"content":[{"text":"Out das profundezas que eu chorei para você, Javé.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Senhor, ouve minha voz.","poem":1},{"text":"Que seus ouvidos estejam atentos à voz das minhas petições.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Se você, Yah, mantivesse um registro de pecados,","poem":1},{"text":"Senhor, quem poderia ficar de pé?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mas há perdão com você,","poem":1},{"text":"portanto, você é temido.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Espero por Yahweh.","poem":1},{"text":"Minha alma espera.","poem":2},{"lineBreak":true},{"text":"Espero em sua palavra.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Minha alma anseia pelo Senhor mais do que os guardas anseiam pela manhã,","poem":1},{"text":"mais do que vigias para a manhã.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israel, esperança em Yahweh,","poem":1},{"text":"pois há bondade amorosa com Yahweh.","poem":2},{"lineBreak":true},{"text":"A redenção abundante está com ele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ele redimirá Israel de todos os seus pecados.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}