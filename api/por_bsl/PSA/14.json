{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["Para o músico chefe. Por David."]},{"type":"verse","number":1,"content":[{"text":"O tolo disse em seu coração: “Não há Deus”.","poem":1},{"text":"Eles são corruptos.","poem":2},{"lineBreak":true},{"text":"Eles fizeram atos abomináveis.","poem":2},{"lineBreak":true},{"text":"Não há ninguém que faça o bem.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahweh olhou do céu para os filhos dos homens,","poem":1},{"text":"para ver se havia alguém que entendesse,","poem":2},{"lineBreak":true},{"text":"que buscava a Deus.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Todos eles foram deixados de lado.","poem":1},{"text":"Juntos, eles se tornaram corruptos.","poem":2},{"lineBreak":true},{"text":"Não há ninguém que faça o bem, não, não há ninguém.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ter todos os trabalhadores da iniqüidade sem conhecimento,","poem":1},{"text":"que comem meu povo enquanto comem pão,","poem":2},{"lineBreak":true},{"text":"e não chame o Yahweh?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ali estavam eles com muito medo,","poem":1},{"text":"pois Deus está na geração dos justos.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Você frustra o plano dos pobres,","poem":1},{"text":"porque Yahweh é seu refúgio.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oh, que a salvação de Israel saísse de Sião!","poem":1},{"text":"Quando Yahweh restaura a fortuna de seu povo,","poem":2},{"lineBreak":true},{"text":"então Jacó se regozijará e Israel ficará contente.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}