{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Uma contemplação de David, quando ele estava na caverna. Uma Oração."]},{"type":"verse","number":1,"content":[{"text":"Eu choro com minha voz para Yahweh.","poem":1},{"text":"Com minha voz, peço misericórdia a Javé.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eu apresento minha reclamação diante dele.","poem":1},{"text":"Eu lhe conto meus problemas.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"When meu espírito estava dominado dentro de mim,","poem":1},{"text":"você conhecia minha rota.","poem":2},{"text":"No caminho em que eu ando,","poem":1},{"text":"eles esconderam uma armadilha para mim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Look à minha direita, e veja;","poem":1},{"text":"pois não há ninguém que se preocupe comigo.","poem":2},{"lineBreak":true},{"text":"O refugiado fugiu de mim.","poem":2},{"lineBreak":true},{"text":"Ninguém se importa com a minha alma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eu chorei para você, Yahweh.","poem":1},{"text":"Eu disse: “Você é meu refúgio”,","poem":2},{"lineBreak":true},{"text":"minha porção na terra dos vivos”.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Listen ao meu grito,","poem":1},{"text":"pois estou em necessidade desesperada.","poem":2},{"text":"Livrem-me de meus perseguidores,","poem":1},{"text":"pois eles são fortes demais para mim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bring minha alma fora da prisão,","poem":1},{"text":"que eu possa dar graças ao seu nome.","poem":2},{"text":"Os justos me cercarão,","poem":1},{"text":"para você será bom para mim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}