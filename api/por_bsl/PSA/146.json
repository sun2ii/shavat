{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Louvado seja Yah!","poem":1},{"text":"Louvado seja Yahweh, minha alma.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Enquanto eu viver, vou elogiar Iavé.","poem":1},{"text":"Cantarei louvores ao meu Deus enquanto eu existir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Não deposite sua confiança em príncipes,","poem":1},{"text":"em um filho do homem em quem não há ajuda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Seu espírito parte, e ele retorna à terra.","poem":1},{"text":"Naquele mesmo dia, seus pensamentos perecem.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Feliz é aquele que tem o Deus de Jacó por sua ajuda,","poem":1},{"text":"cuja esperança está em Yahweh, seu Deus,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"que fez o céu e a terra,","poem":1},{"text":"o mar, e tudo o que há neles;","poem":2},{"lineBreak":true},{"text":"que mantém a verdade para sempre;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"que executa a justiça para os oprimidos;","poem":1},{"text":"que dá comida a quem tem fome.","poem":2},{"text":"Yahweh liberta os prisioneiros.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Yahweh abre os olhos dos cegos.","poem":2},{"lineBreak":true},{"text":"Yahweh levanta aqueles que estão curvados.","poem":2},{"lineBreak":true},{"text":"Yahweh ama os justos.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahweh preserva os estrangeiros.","poem":1},{"text":"Ele sustenta o órfão de pai e a viúva,","poem":2},{"lineBreak":true},{"text":"mas ele vira o caminho dos malvados de cabeça para baixo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahweh reinará para sempre;","poem":1},{"text":"seu Deus, ó Sião, para todas as gerações.","poem":2},{"text":"Louvado seja Yah!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}