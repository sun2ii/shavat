{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Louvado seja Yahweh!","poem":1},{"text":"Cante para Yahweh uma nova canção,","poem":2},{"lineBreak":true},{"text":"seu louvor na assembléia dos santos.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Que Israel se regozije com quem os fez.","poem":1},{"text":"Que as crianças de Sião sejam alegres em seu Rei.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Let eles elogiam seu nome na dança!","poem":1},{"text":"Que lhe cantem louvores com pandeiro e harpa!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pois Yahweh tem prazer em seu povo.","poem":1},{"text":"Ele coroa os humildes com a salvação.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Let os santos se regozijam em honra.","poem":1},{"text":"Deixe-os cantar de alegria em suas camas.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"May os altos elogios de Deus estejam em suas bocas,","poem":1},{"text":"e uma espada de dois gumes na mão,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"para executar a vingança sobre as nações,","poem":1},{"text":"e punições sobre os povos;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"para amarrar seus reis com correntes,","poem":1},{"text":"e seus nobres com grilhões de ferro;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"para executar neles o julgamento por escrito.","poem":1},{"text":"Todos os seus santos têm esta honra.","poem":2},{"text":"Louvado seja Yah!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}