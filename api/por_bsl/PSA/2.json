{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Por que as nações se enfurecem,","poem":1},{"text":"e os povos conspiram uma coisa vã?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Os reis da terra tomam uma posição,","poem":1},{"text":"e os governantes se aconselham juntos,","poem":2},{"lineBreak":true},{"text":"contra Yahweh, e contra seu Ungido,","poem":2},{"noteId":1},{"text":"dizendo,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Vamos romper os laços deles,","poem":1},{"text":"e lançam suas cordas de nós”.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aquele que se senta nos céus vai rir.","poem":1},{"text":"O Senhor","poem":2},{"noteId":2},{"text":"os terá em desdém.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Então ele falará com eles em sua raiva,","poem":1},{"text":"e aterrorizá-los em sua ira:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“No entanto, coloquei meu Rei na minha colina sagrada de Sião”.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Vou falar sobre o decreto:","poem":2},{"text":"Yahweh me disse: “Você é meu filho”.","poem":1},{"text":"Hoje eu me tornei seu pai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Peça-me, e eu darei as nações por sua herança,","poem":1},{"text":"as partes mais remotas da terra para sua posse.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Você deve quebrá-los com uma barra de ferro.","poem":1},{"text":"Você os despedaçará como um vaso de oleiro”.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Agora, portanto, sejam prudentes, seus reis.","poem":1},{"text":"Sejam instruídos, vocês juízes da Terra.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Servir Yahweh com medo,","poem":1},{"text":"e se regozijam com tremor.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Preste uma sincera homenagem ao Filho, para que ele","poem":1},{"noteId":3},{"text":"não se zangue, e pereça no caminho,","poem":1},{"text":"por sua ira em breve será acesa.","poem":2},{"lineBreak":true},{"text":"Abençoados sejam todos aqueles que se refugiam nele.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"A palavra “Ungido” é a mesma que a palavra para “Messias” ou “Cristo”.","reference":{"chapter":2,"verse":2}},{"noteId":2,"caller":"+","text":"A palavra traduzida “Senhor” é “Adonai”.","reference":{"chapter":2,"verse":4}},{"noteId":3,"caller":"+","text":"ou, Beije o filho","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/por_bsl/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}