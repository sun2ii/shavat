{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Para o músico chefe. Um Salmo de David."]},{"type":"verse","number":1,"content":[{"text":"Que Yahweh lhe responda no dia do problema.","poem":1},{"text":"Que o nome do Deus de Jacob o coloque no alto,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"send você ajuda a partir do santuário,","poem":2},{"lineBreak":true},{"text":"conceder-lhe apoio de Zion,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"remember todas as suas ofertas,","poem":2},{"lineBreak":true},{"text":"e aceitar seu sacrifício queimado. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Que ele lhe conceda o desejo do seu coração,","poem":1},{"text":"e cumprir todos os seus conselhos.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nós triunfaremos em sua salvação.","poem":1},{"text":"Em nome de nosso Deus, colocaremos nossas bandeiras.","poem":2},{"lineBreak":true},{"text":"Que Yahweh atenda a todos os seus pedidos.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Now Eu sei que Yahweh salva seu ungido.","poem":1},{"text":"Ele lhe responderá de seu santo céu,","poem":2},{"lineBreak":true},{"text":"com a força salvadora de sua mão direita.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Some confiança em carruagens, e alguns em cavalos,","poem":1},{"text":"mas confiamos no nome de Yahweh nosso Deus.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eles são curvados e caídos,","poem":1},{"text":"mas nos levantamos, e nos levantamos de pé.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Save, Yahweh!","poem":1},{"text":"Que o Rei nos responda quando chamarmos!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}