{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["Um salmo de David."]},{"type":"verse","number":1,"content":[{"text":"A terra é de Yahweh, com sua plenitude;","poem":1},{"text":"o mundo, e aqueles que nele habitam.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pois ele a fundou nos mares,","poem":1},{"text":"e a estabeleceu nas enchentes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Quem pode subir a colina de Yahweh?","poem":1},{"text":"Quem pode estar em seu lugar sagrado?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aquele que tem as mãos limpas e um coração puro;","poem":1},{"text":"que não elevou sua alma à falsidade,","poem":2},{"lineBreak":true},{"text":"e não jurou enganosamente.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ele receberá uma bênção de Yahweh,","poem":1},{"text":"justiça do Deus de sua salvação.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Esta é a geração daqueles que O buscam,","poem":1},{"text":"que procuram seu rosto - mesmo o Jacob. Selah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Levantem suas cabeças, seus portões!","poem":1},{"text":"Levantem-se, suas portas eternas,","poem":2},{"lineBreak":true},{"text":"e o Rei da Glória entrará.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Quem é o Rei da Glória?","poem":1},{"text":"Yahweh forte e poderoso,","poem":2},{"lineBreak":true},{"text":"Yahweh poderoso em batalha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Levantem a cabeça, seus portões;","poem":1},{"text":"Sim, levantem-nas, suas portas eternas,","poem":2},{"lineBreak":true},{"text":"e o Rei da Glória entrará.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Quem é este rei da glória?","poem":1},{"text":"Javé dos Exércitos é o Rei da Glória! Selah.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}