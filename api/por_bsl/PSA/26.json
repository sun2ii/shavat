{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["Por David."]},{"type":"verse","number":1,"content":[{"text":"Julga-me, Yahweh, pois eu caminhei na minha integridade.","poem":1},{"text":"Confiei também em Yahweh sem vacilar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Examina-me, Yahweh, e prova-me.","poem":1},{"text":"Experimente meu coração e minha mente.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pois sua bondade amorosa está diante dos meus olhos.","poem":1},{"text":"Eu caminhei em sua verdade.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eu não me sentei com homens enganosos,","poem":1},{"text":"nem eu entrarei com hipócritas.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eu odeio a assembléia de malfeitores,","poem":1},{"text":"e não se sentará com os ímpios.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lavarei minhas mãos em inocência,","poem":1},{"text":"por isso, irei sobre seu altar, Yahweh,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"para que eu possa fazer ouvir a voz da ação de graças","poem":2},{"lineBreak":true},{"text":"e contar todos os seus feitos maravilhosos.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahweh, eu amo a habitação de sua casa,","poem":1},{"text":"o lugar onde habita sua glória.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Não reúna minha alma com pecadores,","poem":1},{"text":"nem minha vida com homens sedentos de sangue","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"em cujas mãos está a perversidade;","poem":2},{"lineBreak":true},{"text":"sua mão direita está cheia de subornos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mas, quanto a mim, caminharei na minha integridade.","poem":1},{"text":"Redima-me, e tenha misericórdia de mim.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Meu pé está em um lugar uniforme.","poem":1},{"text":"Nas congregações, abençoarei Javé.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}