{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["Um salmo de David."]},{"type":"verse","number":1,"content":[{"text":"Atribuam a Yahweh, filhos dos poderosos,","poem":1},{"text":"atribuem a Yahweh glória e força.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Atribuir a Yahweh a glória devido a seu nome.","poem":1},{"text":"Adorar Yahweh em santa disposição.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"A voz de Yahweh está sobre as águas.","poem":1},{"text":"O Deus da glória troveja, até mesmo Yahweh em muitas águas.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A voz de Yahweh é poderosa.","poem":1},{"text":"A voz de Yahweh está cheia de majestade.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A voz de Yahweh quebra os cedros.","poem":1},{"text":"Sim, Yahweh quebra em pedaços os cedros do Líbano.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ele também os faz pular como um bezerro;","poem":1},{"text":"Líbano e Sirion como um boi jovem e selvagem.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A voz de Yahweh bate com flashes de relâmpagos.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"A voz de Yahweh abala o sertão.","poem":2},{"lineBreak":true},{"text":"Yahweh abala o deserto de Kadesh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"A voz de Yahweh faz o veado parir,","poem":1},{"text":"e despoja as florestas.","poem":2},{"lineBreak":true},{"text":"Em seu templo tudo diz: “Glória!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yahweh sentou-se entronizado no Dilúvio.","poem":1},{"text":"Sim, Yahweh senta-se como Rei para sempre.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahweh dará força ao seu povo.","poem":1},{"text":"Yahweh abençoará seu povo com paz.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}