{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Um salmo de David, quando ele fugiu de Absalom, seu filho."]},{"type":"verse","number":1,"content":[{"text":"Yahweh, como aumentaram os meus adversários!","poem":1},{"text":"Muitos são aqueles que se levantam contra mim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muitos são os que dizem de minha alma,","poem":1},{"text":"“Não há ajuda para ele em Deus”.","poem":2},{"noteId":4},{"text":"Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mas você, Yahweh, é um escudo ao meu redor,","poem":1},{"text":"minha glória, e aquele que me levanta a cabeça.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eu choro a Yahweh com minha voz,","poem":1},{"text":"e ele me responde fora de sua colina sagrada. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eu me deitei e dormi.","poem":1},{"text":"Eu despertei, pois Yahweh me sustenta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eu não terei medo de dezenas de milhares de pessoas","poem":1},{"text":"que se colocaram contra mim de todos os lados.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Arise, Yahweh!","poem":1},{"text":"Salve-me, meu Deus!","poem":2},{"text":"Pois você atingiu todos os meus inimigos no osso da bochecha.","poem":1},{"text":"Você quebrou os dentes dos malvados.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"A salvação pertence a Yahweh.","poem":1},{"text":"Que sua bênção seja para o seu povo. Selah.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"A palavra hebraica proferida “Deus” é “אֱלֹהִ֑ים”. (Elohim).","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/por_bsl/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}