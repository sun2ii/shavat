{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["Para o músico chefe; em instrumentos de corda. Um salmo de David."]},{"type":"verse","number":1,"content":[{"text":"Answer me quando eu chamo, Deus de minha justiça.","poem":1},{"text":"Dê-me alívio da minha angústia.","poem":2},{"lineBreak":true},{"text":"Tenha piedade de mim, e ouça minhas orações.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vós, filhos dos homens, por quanto tempo minha glória será transformada em desonra?","poem":1},{"text":"Você vai amar a vaidade e buscar a falsidade? Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mas saiba que Yahweh separou para si mesmo aquele que é piedoso;","poem":1},{"text":"Yahweh ouvirá quando eu ligar para ele.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Stand com admiração, e não pecar.","poem":1},{"text":"Procure seu próprio coração em sua cama, e fique quieto. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Offer os sacrifícios de retidão.","poem":1},{"text":"Deposite sua confiança em Yahweh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Many dizem: “Quem nos mostrará algum bem?”","poem":1},{"text":"Yahweh, deixe a luz de seu rosto brilhar sobre nós.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Você colocou alegria em meu coração,","poem":1},{"text":"mais do que quando seus grãos e seu novo vinho são aumentados.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Em paz me deitarei e dormirei,","poem":1},{"text":"só para você, Yahweh, me faça viver em segurança.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}