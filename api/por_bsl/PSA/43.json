{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Vindicar-me, Deus, e advogar minha causa contra uma nação ímpia.","poem":1},{"text":"Oh, livrai-me de homens enganadores e perversos.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pois você é o Deus da minha força. Por que você me rejeitou?","poem":1},{"text":"Por que eu vou de luto por causa da opressão do inimigo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oh, envie sua luz e sua verdade.","poem":1},{"text":"Deixe-os me guiarem.","poem":2},{"lineBreak":true},{"text":"Deixe-os levar-me ao seu santo monte,","poem":2},{"lineBreak":true},{"text":"para suas tendas.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Então eu irei ao altar de Deus,","poem":1},{"text":"a Deus, minha alegria imensa.","poem":2},{"text":"Eu o louvarei na harpa, Deus, meu Deus.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Por que você está em desespero, minha alma?","poem":1},{"text":"Por que você está perturbado dentro de mim?","poem":2},{"text":"Esperança em Deus!","poem":1},{"text":"Pois eu ainda o louvarei:","poem":2},{"lineBreak":true},{"text":"meu Salvador, meu ajudante, e meu Deus.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}