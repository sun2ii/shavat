{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Para o músico chefe. Um salmo pelos filhos de Corá."]},{"type":"verse","number":1,"content":[{"text":"Oh batam palmas, todos vocês nações.","poem":1},{"text":"Grite a Deus com a voz do triunfo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Para Yahweh Most High é fantástico.","poem":1},{"text":"Ele é um grande rei sobre toda a terra.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ele submete as nações sob nosso comando,","poem":1},{"text":"e as pessoas sob nossos pés.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ele escolhe nossa herança para nós,","poem":1},{"text":"a glória de Jacob, a quem ele amava. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God foi para cima com um grito,","poem":1},{"text":"Yahweh com o som de uma trombeta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sing elogia a Deus! Cante louvores!","poem":1},{"text":"Cantemos louvores ao nosso Rei! Cantem louvores!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pois Deus é o Rei de toda a terra.","poem":1},{"text":"Cante louvores com compreensão.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Deus reina sobre as nações.","poem":1},{"text":"Deus se senta em seu trono sagrado.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Os príncipes dos povos estão reunidos,","poem":1},{"lineBreak":true},{"text":"o povo do Deus de Abraão.","poem":1},{"text":"Pois os escudos da terra pertencem a Deus.","poem":2},{"lineBreak":true},{"text":"Ele é muito exaltado!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}