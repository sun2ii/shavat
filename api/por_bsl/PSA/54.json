{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Para o músico chefe. Em instrumentos de corda. Uma contemplação de David, quando os zifitas vieram e disseram a Saul: “David não está se escondendo entre nós?"]},{"type":"verse","number":1,"content":[{"text":"Save me, Deus, pelo seu nome.","poem":1},{"text":"Vindicar-me em seu poder.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hear minha oração, Deus.","poem":1},{"text":"Ouça as palavras da minha boca.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pois os estranhos se levantaram contra mim.","poem":1},{"text":"Os homens violentos têm procurado minha alma.","poem":2},{"lineBreak":true},{"text":"Eles não puseram Deus diante deles. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Behold, Deus é meu ajudante.","poem":1},{"text":"O Senhor é o que sustenta minha alma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ele retribuirá o mal aos meus inimigos.","poem":1},{"text":"Destrua-os em sua verdade.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Com uma oferta de livre vontade, sacrificar-me-ei a vocês.","poem":1},{"text":"Agradeço o seu nome, Yahweh, pois é bom.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pois ele me livrou de todos os problemas.","poem":1},{"text":"Meu olho tem visto o triunfo sobre meus inimigos.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}