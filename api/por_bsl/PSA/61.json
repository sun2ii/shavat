{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Para o músico chefe. Para um instrumento de cordas. Por David."]},{"type":"verse","number":1,"content":[{"text":"Hear meu grito, Deus.","poem":1},{"text":"Ouça minha oração.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Desde o fim do mundo, chamarei a vocês quando meu coração estiver sobrecarregado.","poem":1},{"text":"Leve-me até a rocha que é mais alta que eu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Para mim, você tem sido um refúgio,","poem":1},{"text":"uma torre forte do inimigo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eu habitarei em sua tenda para sempre.","poem":1},{"text":"Refugiar-me-ei no abrigo de suas asas. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Para você, Deus, ouviu meus votos.","poem":1},{"text":"Você me deu a herança daqueles que temem seu nome.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Você vai prolongar a vida do rei.","poem":1},{"text":"Seus anos serão por gerações.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ele será entronizado na presença de Deus para sempre.","poem":1},{"text":"Aponte sua bondade e verdade amorosas, para que elas possam preservá-lo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Portanto, cantarei louvores ao seu nome para sempre,","poem":1},{"text":"que eu possa cumprir meus votos diariamente.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}