{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["Para o músico chefe. Com instrumentos de corda. Um salmo. Com uma canção."]},{"type":"verse","number":1,"content":[{"text":"May Deus seja misericordioso conosco, abençoa-nos,","poem":1},{"text":"e fazer com que seu rosto brilhe sobre nós. Selah.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Para que seu caminho seja conhecido na terra,","poem":1},{"text":"e sua salvação entre todas as nações,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"let os povos te louvam, Deus.","poem":1},{"text":"Que todos os povos o elogiem.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oh que as nações se alegrem e cantem de alegria,","poem":1},{"text":"pois você julgará os povos com equidade,","poem":2},{"lineBreak":true},{"text":"e governar as nações na Terra. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Deixe que os povos o louvem, Deus.","poem":1},{"text":"Que todos os povos o elogiem.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"A Terra rendeu seu aumento.","poem":1},{"text":"Deus, mesmo nosso próprio Deus, nos abençoará.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Deus nos abençoará.","poem":1},{"text":"Todos os confins do mundo o temerão.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}