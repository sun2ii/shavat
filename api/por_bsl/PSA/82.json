{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Um Salmo por Asaph."]},{"type":"verse","number":1,"content":[{"text":"Deus preside a grande assembléia.","poem":1},{"text":"Ele julga entre os deuses.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Quanto tempo você julgará injustamente,","poem":1},{"text":"e mostrar parcialidade para com os ímpios”? Selah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Defenda os fracos, os pobres e os órfãos de pai.","poem":1},{"text":"Manter os direitos dos pobres e oprimidos.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Resgatar os fracos e necessitados.","poem":1},{"text":"Entregue-os da mão dos ímpios”.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eles não sabem, nem entendem.","poem":1},{"text":"Eles andam para frente e para trás na escuridão.","poem":2},{"lineBreak":true},{"text":"Todas as fundações da terra são abaladas.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eu disse: “Vocês são deuses”,","poem":1},{"text":"todos vocês são filhos do Altíssimo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"No entanto, vocês morrerão como homens,","poem":1},{"text":"e cair como um dos governantes”.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Levanta-te, Deus, julga a terra,","poem":1},{"text":"para você herdar todas as nações.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}