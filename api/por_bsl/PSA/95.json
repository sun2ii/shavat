{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Oh venha, vamos cantar para Yahweh.","poem":1},{"text":"Vamos gritar em voz alta para a rocha de nossa salvação!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Venha antes de sua presença com a ação de graças.","poem":1},{"text":"Vamos exaltá-lo com canções!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pois Yahweh é um grande Deus,","poem":1},{"text":"um grande rei acima de todos os deuses.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Em sua mão estão os lugares profundos da terra.","poem":1},{"text":"As alturas das montanhas também são dele.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O mar é dele, e ele o fez.","poem":1},{"text":"Suas mãos formaram a terra seca.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oh venha, vamos adorar e curvar-nos.","poem":1},{"text":"Vamos ajoelhar-nos diante de Yahweh, nosso Criador,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"pois ele é nosso Deus.","poem":2},{"text":"Nós somos o povo de seu pasto,","poem":1},{"text":"e as ovelhas ao seu cuidado.","poem":2},{"text":"Hoje, oh que você ouviria a voz dele!","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Não endureça seu coração, como no Meribah,","poem":2},{"lineBreak":true},{"text":"como no dia do Massah no deserto,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"quando seus pais me tentaram,","poem":1},{"text":"me testou, e viu meu trabalho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Durante quarenta longos anos fiquei de luto com essa geração,","poem":1},{"text":"e disse: “Eles são um povo que erra em seu coração”.","poem":2},{"lineBreak":true},{"text":"Eles não conheceram meus caminhos”.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Portanto, jurei em minha ira,","poem":1},{"text":"“Eles não vão entrar no meu descanso”.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}