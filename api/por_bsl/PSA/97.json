{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"Yahweh reina!","poem":1},{"text":"Que a terra se regozije!","poem":2},{"lineBreak":true},{"text":"Que a multidão de ilhas fique contente!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nuvens e escuridão estão ao seu redor.","poem":1},{"text":"A justiça e a retidão são o fundamento de seu trono.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Um incêndio vai antes dele,","poem":1},{"text":"e queima seus adversários de todos os lados.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Seus relâmpagos iluminam o mundo.","poem":1},{"text":"A terra vê, e treme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"As montanhas derretem como cera na presença de Yahweh,","poem":1},{"text":"na presença do Senhor de toda a terra.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Os céus declaram sua retidão.","poem":1},{"text":"Todos os povos viram sua glória.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Let todos eles têm vergonha de servir imagens gravadas,","poem":1},{"text":"que se vangloriam em seus ídolos.","poem":2},{"lineBreak":true},{"text":"Adorem-no, todos vocês deuses!","poem":2},{"noteId":33}]},{"type":"verse","number":8,"content":[{"text":"Zion ouviu e ficou feliz.","poem":1},{"text":"As filhas de Judá se alegraram","poem":2},{"lineBreak":true},{"text":"por causa de seus julgamentos, Yahweh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Para você, Yahweh, o mais alto acima de tudo é a terra.","poem":1},{"text":"Você é exaltado muito acima de todos os deuses.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Você que ama Yahweh, odeia o mal!","poem":1},{"text":"Ele preserva as almas de seus santos.","poem":2},{"lineBreak":true},{"text":"Ele os livra da mão dos ímpios.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"A luz é semeada para os justos,","poem":1},{"text":"e alegria para os íntegros de coração.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Alegrem-se em Yahweh, pessoas justas!","poem":1},{"text":"Dê graças ao seu santo nome.","poem":2}]}],"footnotes":[{"noteId":33,"caller":"+","text":"LXX lê “anjos” ao invés de “deuses”.","reference":{"chapter":97,"verse":7}}]},"thisChapterLink":"/api/por_bsl/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}