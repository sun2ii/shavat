{"translation":{"id":"por_bsl","name":"Bíblia Portuguesa Mundial","website":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=porbrbsl","licenseNotes":null,"shortName":"BSL","englishName":"World Portuguese Bible","language":"por","textDirection":"ltr","sha256":"900ac6b030165e77a05692c3fd0de91f14d81a87f8d29c34abcdd445156cd749","availableFormats":["json"],"listOfBooksApiLink":"/api/por_bsl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_bsl","name":"Salmos","commonName":"Salmos","title":"Os Salmos","order":19,"numberOfChapters":150,"sha256":"67fa87862b7f1afa02140424a9adc982e128e05645de2caf50d2196cf72ef626","firstChapterNumber":1,"firstChapterApiLink":"/api/por_bsl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_bsl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Yahweh reina! Que os povos tremam.","poem":1},{"text":"Ele se senta entronizado entre os querubins.","poem":2},{"lineBreak":true},{"text":"Que a terra seja movida.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahweh é ótimo em Zion.","poem":1},{"text":"Ele é alto acima de todos os povos.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Let eles elogiam seu grande e impressionante nome.","poem":1},{"text":"Ele é santo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"A força do Rei também ama a justiça.","poem":1},{"text":"Você estabelece a equidade.","poem":2},{"lineBreak":true},{"text":"Você executa justiça e retidão em Jacob.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Exalt Yahweh, nosso Deus.","poem":1},{"text":"Adoração aos pés do escabelo.","poem":2},{"lineBreak":true},{"text":"Ele é santo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moisés e Aarão estavam entre seus sacerdotes,","poem":1},{"text":"Samuel estava entre aqueles que invocam seu nome.","poem":2},{"lineBreak":true},{"text":"Eles chamaram Yahweh e ele lhes respondeu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ele falou com eles no pilar da nuvem.","poem":1},{"text":"Eles guardaram seus depoimentos,","poem":2},{"lineBreak":true},{"text":"o estatuto que ele lhes deu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Você lhes respondeu, Yahweh nosso Deus.","poem":1},{"text":"Você é um Deus que os perdoou,","poem":2},{"lineBreak":true},{"text":"embora você tenha se vingado por seus atos.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Exalt Yahweh, nosso Deus.","poem":1},{"text":"Adoração em sua colina sagrada,","poem":2},{"lineBreak":true},{"text":"para Yahweh, nosso Deus, é santo!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_bsl/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_bsl/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_bsl/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}