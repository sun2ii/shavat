{"translation":{"id":"por_onbv","name":"Biblica® Open Nova Bíblia Viva 2007","website":"https://ebible.org/Scriptures/details.php?id=poronbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=poronbv","licenseNotes":null,"shortName":"ONBV","englishName":"Portuguese ONBV","language":"por","textDirection":"ltr","sha256":"bc218991ed9eadf2f760b89e9b35370788ffaf761e9120d8aac64651518c1f6c","availableFormats":["json"],"listOfBooksApiLink":"/api/por_onbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31105,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"ISA","translationId":"por_onbv","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"e92716a2659165c02206b136ddbead7c9a5a1181c8c0968ec62268a096706087","firstChapterNumber":1,"firstChapterApiLink":"/api/por_onbv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/por_onbv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["Naquele dia, vocês farão esta oração:",{"text":"“Louvado seja o Senhor! Ele estava irado comigo, mas sua ira passou e agora ele me consola!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Deus veio me salvar. Eu não preciso ter medo, posso confiar nele. O Senhor é a minha força, o motivo da minha canção. Ele é a minha salvação.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cheios de grande alegria, todos beberão a água da fonte da salvação!”","poem":2}]},{"type":"verse","number":4,"content":["Naquele dia maravilhoso, vocês dirão:",{"text":"“Agradeçam ao Senhor! Glória ao Senhor! Falem entre as nações os feitos do seu amor tão maravilhoso. Anunciem que o seu nome é poderoso!”","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cantem louvores ao Senhor, porque ele fez coisas maravilhosas. O mundo inteiro precisa saber disso.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moradores de Sião, gritem bem alto e cantem de alegria, pois grande é o Santo de Israel que vive no meio de vocês!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/por_onbv/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_onbv/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_onbv/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}