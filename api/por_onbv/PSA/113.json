o pode ter filhos, tornando-a uma mãe muito feliz. Aleluia!"]}],"footnotes":[{"noteId":186,"caller":"+","text":"113.7 Ou “lixo”.","reference":{"chapter":113,"verse":7}}]},"thisChapterLink":"/api/por_onbv/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_onbv/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_onbv/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}