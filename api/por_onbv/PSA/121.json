{"translation":{"id":"por_onbv","name":"Biblica® Open Nova Bíblia Viva 2007","website":"https://ebible.org/Scriptures/details.php?id=poronbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=poronbv","licenseNotes":null,"shortName":"ONBV","englishName":"Portuguese ONBV","language":"por","textDirection":"ltr","sha256":"bc218991ed9eadf2f760b89e9b35370788ffaf761e9120d8aac64651518c1f6c","availableFormats":["json"],"listOfBooksApiLink":"/api/por_onbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31105,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_onbv","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"14fed4bfecf42761436d4cbc40de58de97770b3a72bcb3a2f5d053faf3d9ef52","firstChapterNumber":1,"firstChapterApiLink":"/api/por_onbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_onbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["Cântico de peregrinação."]},{"type":"verse","number":1,"content":["Olho para os montes e pergunto: “De onde virá o meu socorro?”"]},{"type":"verse","number":2,"content":["O meu socorro vem do Senhor que criou os céus e a terra."]},{"type":"verse","number":3,"content":["Ele não deixará que você tropece. Ele vigia de perto cada um dos seus passos, sem cochilar."]},{"type":"verse","number":4,"content":["É verdade! O protetor de Israel não cochila nem dorme. Ele está sempre alerta!"]},{"type":"verse","number":5,"content":["O Senhor é o seu protetor. Ele estará sempre ao seu lado como sombra para o proteger."]},{"type":"verse","number":6,"content":["O sol não lhe fará mal de dia, nem a lua, de noite."]},{"type":"verse","number":7,"content":["O Senhor o protegerá de todo mal; ele protegerá a sua vida!"]},{"type":"verse","number":8,"content":["O Senhor tomará conta da sua entrada e da sua saída,",{"noteId":201},"agora e sempre."]}],"footnotes":[{"noteId":201,"caller":"+","text":"121.8 Ou “quando você for e quando você voltar”.","reference":{"chapter":121,"verse":8}}]},"thisChapterLink":"/api/por_onbv/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_onbv/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_onbv/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}