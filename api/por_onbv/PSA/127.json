igos no tribunal."]}],"footnotes":[{"noteId":210,"caller":"+","text":"127.1 Ou “sentinelas”.","reference":{"chapter":127,"verse":1}},{"noteId":211,"caller":"+","text":"127.3 Ou “a herança”.","reference":{"chapter":127,"verse":3}},{"noteId":212,"caller":"+","text":"127.5 Uma espécie de estojo onde eram guardadas as flechas e que se trazia pendente do ombro.","reference":{"chapter":127,"verse":5}}]},"thisChapterLink":"/api/por_onbv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_onbv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_onbv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}