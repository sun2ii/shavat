{"translation":{"id":"por_onbv","name":"Biblica® Open Nova Bíblia Viva 2007","website":"https://ebible.org/Scriptures/details.php?id=poronbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=poronbv","licenseNotes":null,"shortName":"ONBV","englishName":"Portuguese ONBV","language":"por","textDirection":"ltr","sha256":"bc218991ed9eadf2f760b89e9b35370788ffaf761e9120d8aac64651518c1f6c","availableFormats":["json"],"listOfBooksApiLink":"/api/por_onbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31105,"languageName":"português","languageEnglishName":"Portuguese"},"book":{"id":"PSA","translationId":"por_onbv","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"14fed4bfecf42761436d4cbc40de58de97770b3a72bcb3a2f5d053faf3d9ef52","firstChapterNumber":1,"firstChapterApiLink":"/api/por_onbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/por_onbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Salmo de Davi, quando fugia de seu filho Absalão."]},{"type":"verse","number":1,"content":["Ó Senhor, como cresceu o número dos meus inimigos! Há muita gente contra mim, querendo me destruir."]},{"type":"verse","number":2,"content":["Tantos estão dizendo que Deus não está interessado em me salvar."]},{"type":"verse","number":3,"content":["Mas o Senhor é o escudo que me protege, a minha glória. O Senhor me faz andar de cabeça erguida."]},{"type":"verse","number":4,"content":["Clamei em voz alta ao Senhor, e ele me respondeu do seu santo lugar.",{"noteId":3}]},{"type":"verse","number":5,"content":["Por isso, posso me deitar tranquilo e dormir em paz. Quando acordo, me sinto seguro, porque o Senhor cuida de mim."]},{"type":"verse","number":6,"content":["Agora mesmo, cercado de todos os lados por milhares de inimigos, não tenho medo!"]},{"type":"verse","number":7,"content":["Levante-se, ó Senhor! Salve-me, meu Deus! Fira os queixos dos meus inimigos e quebre os seus dentes."]},{"type":"verse","number":8,"content":["A salvação e a vitória pertencem ao Senhor. Ele abençoa o seu povo!"]}],"footnotes":[{"noteId":3,"caller":"+","text":"3.4 Ou “do seu santo monte”.","reference":{"chapter":3,"verse":4}}]},"thisChapterLink":"/api/por_onbv/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_onbv/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_onbv/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}