{"translation":{"id":"pri_wbt","name":"Tii Pwicîri: Âmu Aamwari naa na cî","website":"https://ebible.org/Scriptures/details.php?id=priNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=priNT","licenseNotes":null,"shortName":"WBT","englishName":"Paicî NT","language":"pri","textDirection":"ltr","sha256":"c8757ff9eebd1bfe4b6e7a1c1c0a272feba84a0a2b104e549ee340a1f79c5bb6","availableFormats":["json"],"listOfBooksApiLink":"/api/pri_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7654,"languageName":"Paicî","languageEnglishName":"Paicî"},"book":{"id":"REV","translationId":"pri_wbt","name":"Auinapàpari","commonName":"Auinapàpari","title":"Auinapàpari Muru na paari tà Ioane","order":66,"numberOfChapters":22,"sha256":"2e87006cd5fe08a4fc0360aa73c4875991f444efa33806b855ef59147769d293","firstChapterNumber":1,"firstChapterApiLink":"/api/pri_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/pri_wbt/REV/22.json","totalNumberOfVerses":394},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["Gée na càùru ê pâ pwi bèepwiri, â go côo mwara pwi jè *angela, na é boome gée napwéretòotù. Â naa têe pàtàmee na maina. Â dau maina pai muugère kêe, na é pwéelaa pàpari ê gòropuu."]},{"type":"heading","content":["É pitèié Pwiduée"]},{"type":"heading","content":["1 <ζ> O téuraé"]},{"type":"verse","number":2,"content":["Â é tomara tôo pâ",{"noteId":108},":",{"text":"«Ée jèe tûu *Babulona,","poem":1},{"lineBreak":true},{"text":"téura napô-bà!","poem":1},{"lineBreak":true},{"text":"[Ticè âboro wê!]","poem":1},{"lineBreak":true},{"text":"Jèe wâ kà tèpa u,","poem":1},{"lineBreak":true},{"text":"pwârawâ kâra duée,","poem":1},{"lineBreak":true},{"text":"bawâ kâra aràu,","poem":1},{"lineBreak":true},{"text":"[aucârü kâra akàna]","poem":1},{"lineBreak":true},{"text":"autâa kàra diri,","poem":1},{"lineBreak":true},{"text":"pâ macii na miiri.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"[Tojii tô ilàri-bà.]","poem":1},{"lineBreak":true},{"text":"É naa dipâa kêe.","poem":1},{"lineBreak":true},{"text":"Rà ipwirié pâ Ba.","poem":1},{"lineBreak":true},{"text":"Rà pâ nau pwacèwiié.","poem":1},{"lineBreak":true},{"text":"Rà pwa tûâ na miiri.","poem":1},{"lineBreak":true},{"text":"Rà ipuu imudi ma wàé,","poem":1},{"lineBreak":true},{"text":"pâ ukai gòropuu.","poem":1},{"lineBreak":true},{"text":"Wâro gée gooé","poem":1},{"lineBreak":true},{"text":"tèpa pi-icu.","poem":1},{"lineBreak":true},{"text":"Wâru mwani kàra,","poem":1},{"lineBreak":true},{"text":"gée goo pâ tûâ èpà kêe. Nabwé!»","poem":1}]},{"type":"heading","content":["2 <ζ> Dau maina wârimuru kêe"]},{"type":"verse","number":4,"content":["Go têre ê jè pwâratùra me gée napwéretòotù, na é ina pâ:",{"lineBreak":true},{"text":"«Tèpa naîô wée!","poem":1},{"lineBreak":true},{"text":"Uru jii Babulona.","poem":1},{"lineBreak":true},{"text":"Còobé jii tôobà.","poem":1},{"lineBreak":true},{"text":"Uru jii pâ èpà kêe.","poem":1},{"lineBreak":true},{"text":"Naaco pâ tûâ kêe.","poem":1},{"lineBreak":true},{"text":"Ba guwà péa tòpi","poem":1},{"lineBreak":true},{"text":"ê wârimuru kêe!","poem":1},{"lineBreak":true},{"text":"Dau maina aré","poem":1},{"lineBreak":true},{"text":"na go o mwa naa têe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dau wâru èpà kêe.","poem":1},{"lineBreak":true},{"text":"Dau pòri too,","poem":1},{"lineBreak":true},{"text":"tèepaa naanidò","poem":1},{"lineBreak":true},{"text":"napwéretòotù!","poem":1},{"lineBreak":true},{"text":"Go côo wakè kêe,","poem":1},{"lineBreak":true},{"text":"â câgo caa pwanauri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Go o mwa papòé.","poem":1},{"lineBreak":true},{"text":"Naa wârimuru têe","poem":1},{"lineBreak":true},{"text":"wiâra pâ èpà kêe.","poem":1},{"lineBreak":true},{"text":"Naa têe na dau maina","poem":1},{"lineBreak":true},{"text":"jii ê pwina é pwa.","poem":1},{"lineBreak":true},{"text":"Pwaai wârado kêe.","poem":1},{"lineBreak":true},{"text":"Ba é naa dipâa kêe","poem":1},{"lineBreak":true},{"text":"[târa tubaèpà târa pâ Ba].","poem":1},{"lineBreak":true},{"text":"Pwaai mwara","poem":1},{"lineBreak":true},{"text":"goro dipâa na gòo,","poem":1},{"lineBreak":true},{"text":"ba na é wâdo côwâ.","poem":1},{"lineBreak":true},{"text":"[Â ée dau maagé goo.]","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dau maina nümee.","poem":1},{"lineBreak":true},{"text":"Wâru mwani kêe.","poem":1},{"lineBreak":true},{"text":"Maina ipwàdée kêe.","poem":1},{"lineBreak":true},{"text":"Êkaa na wàrapwiri:","poem":1},{"lineBreak":true},{"text":"O maina aré kêe.","poem":1},{"lineBreak":true},{"text":"Piêdò maagé kêe.","poem":1},{"lineBreak":true},{"text":"É pi-ina kêe pâ:","poem":1},{"lineBreak":true},{"text":"“Go nye tô ukai.","poem":1},{"lineBreak":true},{"text":"Câgo caa tô dàpwà.","poem":1},{"lineBreak":true},{"text":"O câgo caa côo pikîri.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Êkaa na wàrapwiri,","poem":1},{"lineBreak":true},{"text":"na ji caapwi tòotù,","poem":1},{"lineBreak":true},{"text":"ée pâ nau tô dàpwà.","poem":1},{"lineBreak":true},{"text":"Ée mwa côo pikîri.","poem":1},{"lineBreak":true},{"text":"Ée mwa copwa.","poem":1},{"lineBreak":true},{"text":"O cîriê naa na ânye.","poem":1},{"lineBreak":true},{"text":"Ba maina pàtàmoo,","poem":1},{"lineBreak":true},{"text":"wâgo Pwiduée","poem":1},{"lineBreak":true},{"text":"ma go pitèié. Nabwé!»","poem":1}]},{"type":"heading","content":["Rà imuruê tèpa âboro"]},{"type":"heading","content":["3 <ζ> Tèpa ukai"]},{"type":"verse","number":9,"content":["Wà tèpa ukai kâra gòropuu, âna rà o côo ê muru ânye, wiàna tòo Babulona, â rà o dau pi-i ma pijinünü gooé. Ba rà tèpa bée, na rà pwa pâ muru na dau èpà ma wàé. Â jèe dau pwa neemururà gée gooé."]},{"type":"verse","number":10,"content":["Â rà o coo na wâiti wê, goro ê pai wâgotàra goo ê pai maagé kêe. [Â rà o pwùkùru.] Â rà o mwa ina pâ:",{"lineBreak":true},{"text":"«Wârico Babulona!","poem":1},{"lineBreak":true},{"text":"Wârico napô maina!","poem":1},{"lineBreak":true},{"text":"Téura ma tubatiàué","poem":1},{"noteId":109},{"text":",","poem":1},{"lineBreak":true},{"text":"na ji caapwi tòotù!»","poem":1}]},{"type":"heading","content":["4 <ζ> Tèpa pi-icu"]},{"type":"verse","number":11,"content":["Rà imuruê ma pijinünü wà tèpa pi-icu wâni gòropuu, ba jèe ticè âboro cèna ée wâri cè neemururà."]},{"type":"verse","number":12,"content":["[Ba wàé, na ia é mu wâri diri pâ na jèpapara muru] na dau maina wâri wèe, na rà mu icuri:",{"lineBreak":true},"Pâ mwani mii, ma mwani pwaa; Pâ atü na dau maina wâri wèe; Pâ na jèpapara imwaano na dau wâdé; Pâ upwâra na ûrea; Pâ muru na pwa goro béokée kâra lélépâ",{"noteId":110},"; Pâ muru na pwa goro upwâra; Pâ paò ma paò mii; Pâ atü pwaa na dau wâdé",{"noteId":111},";"]},{"type":"verse","number":13,"content":["Pâ na jèpapara jawé ûrea, ma wâi na ûrea; Pâ dàuru upwâra na ûrea na jè cîri; Pâ dipâa, ma géree, ma dàuru poloa, ma blé; Pâ paaci ma mutô, ma pâ òoci ma wàtio; Pâ ênawéna na piirà, na dau pwaée kàra."]},{"type":"heading","content":["5 <ζ> Tèpa pwa mwani kàra"]},{"type":"verse","number":14,"content":["Wà tèpa pi-icu, na dau pwa mwani kàra, gée goo i ville Babulona, âna rà o dau pi-i, ma pijinünü gooé. Â rà o ina têe pâ:",{"lineBreak":true},{"text":"«Ticè neemurugà:","poem":1},{"lineBreak":true},{"text":"Muru na jajau,","poem":1},{"lineBreak":true},{"text":"muru na pwényuâa,","poem":1},{"lineBreak":true},{"text":"muru na wâdé tâgà.","poem":1},{"lineBreak":true},{"text":"Cau tubatiàurà.","poem":1},{"lineBreak":true},{"text":"Â o câgà caa pâmarirà.»","poem":1},{"lineBreak":true},"Â rà o coo na wâiti wê, goro ê pai wâgotàra goro pai maagé côo kêe. Â rà o pwùkùru."]},{"type":"verse","number":16,"content":["Â rà ina mwara pâ:",{"lineBreak":true},{"text":"«Wârico Babulona!","poem":1},{"lineBreak":true},{"text":"Wàé na é coona","poem":1},{"lineBreak":true},{"text":"imwaano mii","poem":1},{"lineBreak":true},{"text":"ma bwùucùru","poem":1},{"lineBreak":true},{"text":"na kîri ê aaé.","poem":1},{"lineBreak":true},{"text":"Â maina wâri wèe.","poem":1},{"lineBreak":true},{"text":"Wàé na é picûâaê","poem":1},{"lineBreak":true},{"text":"goro mwani mii,","poem":1},{"lineBreak":true},{"text":"ma pâ atü na pwâra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Jèe ticè têe diri","poem":1},{"lineBreak":true},{"text":"na ji caapwi tòotù!»","poem":1},"6 <ζ> Tèpa pâra gòro wànga Rà picoo iti jiié mwara wà diri tàpé na rà pâra gòro wànga—wà tèpa apooro wànga, ma wà tèpa pitûâ naa gòro wànga, ma wà tèpa taa ârawéà, ma diri tèpa matélo."]},{"type":"verse","number":18,"content":["Â rà o côo i muê na tòé, â rà o i, ma pi-ina tàra pâ: «Wâpà cè napô cèna wàra ê ville bèeni? Au! Nye ticè!»"]},{"type":"verse","number":19,"content":["Â rà o i, ma pijinünü, ma tü dàuru puu naa na pûrurà, [goro pai tòina kàra]. Â rà o wiikau burà ina pâ:",{"lineBreak":true},{"text":"«Wârico Babulona!","poem":1},{"lineBreak":true},{"text":"Wârico napô maina!","poem":1},{"lineBreak":true},{"text":"Dau pwa mwani kâjè,","poem":1},{"lineBreak":true},{"text":"gée goo ville bèeni.","poem":1},{"lineBreak":true},{"text":"Téura ma tubatiàué","poem":1},{"lineBreak":true},{"text":"na ji caapwi tòotù!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["[Êco na wàéni ê popai ba kà tèpa âboro kà Pwiduée]:",{"lineBreak":true},{"text":"Câbu, co napwéretòotù!","poem":1},{"lineBreak":true},{"text":"Guwà ipwàdée,","poem":1},{"lineBreak":true},{"text":"âboro kà Pwiduée—","poem":1},{"lineBreak":true},{"text":"wâguwà tèpa *apostolo,","poem":1},{"lineBreak":true},{"text":"wâguwà tèpa *péroféta!","poem":1},{"lineBreak":true},{"text":"Ba é jèe téuraé,","poem":1},{"lineBreak":true},{"text":"é tojiié wà Pwiduée.","poem":1},{"lineBreak":true},{"text":"É pwa wârimuru têe,","poem":1},{"lineBreak":true},{"text":"ba é tubaèpà tàwà.","poem":1}]},{"type":"heading","content":["Bénabwé popai gooé"]},{"type":"heading","content":["7 <ζ> O câjè mwa caa côoê côwâ"]},{"type":"verse","number":21,"content":["Nabwé, â go côo wà pwi jè angela na dau pwa nii kêe. Â é popa ê diopwaa kâra atü",{"noteId":112},", â é tü naa nawià, â é ina pâ: «O ciura wàrapwiri wà Babulona, ville maina, â o tüê wàrapwiri, â o câjè mwa caa côoê côwâ."]},{"type":"verse","number":22,"content":["Â o câjè mwa caa têre côwâ cè airi gitar, ma cè pwâra uu kâra kuruò, ma cè pwâra uu tutu. O tiàu cè pwi jè a wakè goro upwâra ma paò. Â o câjè mwa caa têre côwâ cè airi atü bécaagai blé."]},{"type":"verse","number":23,"content":["Â o câ mwa caa pwéelaa côwâ cè ânye wê. Â o câjè mwa caa têre côwâ cè pwâratùra kà du a tapoo piéa. «[O popa jiigà, co Babulona, êdiri pâ pwi bèepwiri, majoroé ê tûâ'gà na èpà.] Ba gà pwacèwii tô a pwa dooki",{"noteId":113},". Ba wà tèpa pi-icu'gà, na rà dau imaina naa na gòropuu diri, âna rà pa-imwüru ê pâ Ba diri."]},{"type":"verse","number":24,"content":["«Üu, [o maina wârimuru'gà] ba gà nye pwi majoroé, ba gà pòtàmwara tèpa péroféta, ma pàra tèpa âboro kà Pwiduée. Üu, dau wâru tàpé na pòtàmwararà gée googà, pitiri gòropuu; [â o pitèigà goo]",{"noteId":114},".»"]}],"footnotes":[{"noteId":108,"caller":"+","text":"Pwiri bétapoo popai goo Babulona, âna tâa na naporomee 17.","reference":{"chapter":18,"verse":2}},{"noteId":109,"caller":"+","text":"Téura ma tubatiàué—Grec: Pitèigà.","reference":{"chapter":18,"verse":10}},{"noteId":110,"caller":"+","text":"Béokée kâra lélépâ—Défenses d'éléphant, Ivoire.","reference":{"chapter":18,"verse":12}},{"noteId":111,"caller":"+","text":"Pé atü pwaa na dau wâdé—Marbre.","reference":{"chapter":18,"verse":12}},{"noteId":112,"caller":"+","text":"Ê diopwaa kâra atü—Napéaati naa na grec pâ: Pwacèwii ê jè meule na maina. (Côo ânuuru aucòogai élaio naa nabibiu kâra tii.)","reference":{"chapter":18,"verse":21}},{"noteId":113,"caller":"+","text":"Gà pwacèwii tô apwa dooki—Munaa ucina goro pai maina wàra nüma tèpa âboro, ma pai naa càùrà naa goo wà Pwiduée.","reference":{"chapter":18,"verse":23}},{"noteId":114,"caller":"+","text":"Pwiri popai kà Ioane, na é wii i tii bèeni, é, pwiri gòobàra popai kà pwi angela.","reference":{"chapter":18,"verse":24}}]},"thisChapterLink":"/api/pri_wbt/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/pri_wbt/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/pri_wbt/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":23}