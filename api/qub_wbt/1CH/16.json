{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"1CH","translationId":"qub_wbt","name":"1 CRÓNICAS","commonName":"1 CRÓNICAS","title":"1 Crónicas","order":13,"numberOfChapters":29,"sha256":"473da2b0a80b70c1e62e84f5b7f88f1f5e808e61523eec5657a24a46f34c0077","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/qub_wbt/1CH/29.json","totalNumberOfVerses":873},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["Tayta Diospa babulninta apar chayachiran churaränanpaj rurachishan tolduman. Nircorga Tayta Diospa ñaupancho rupachina sacrifisyucunata y alli goyaypita sacrifisyucunata rupachiran."]},{"type":"verse","number":2,"content":["Nircur Davidga llapan runacunata Tayta Diospa jutincho bindisyunta goran."]},{"type":"verse","number":3,"content":["Israel famillyacunataga llapantami aypuran ollguta warmitapis juc tantata, pedäsu aychata, päsas tantatapis."]},{"type":"verse","number":4,"content":["Leví famillyacunata David churaran Tayta Diospa babulnin churaraycashan cajcho mañacunanpaj, agradësicunanpaj, y Tayta Diosta alabananpaj."]},{"type":"verse","number":5,"content":["Paycunapa mandajnin caran Asaf. Guepanman caran Zacarías, chaypita Jeiel, Semiramot, Jehiel, Matatías, Eliab, Benaía, Obed-edom, Jeiel. Paycunaga tucaj arpano salteriocunatawan arpacunata. Asaf tucaj latilluta."]},{"type":"verse","number":6,"content":["Cüracunana Benaiawan Jahaziel tucaj trompëtacunata. Llapanpis tucaj Tayta Diospa babulnin ñaupanchömi."]},{"type":"heading","content":["Tayta Diosta agradësicur David alabashan"]},{"type":"verse","number":7,"content":["Chay junajllami Asaftawan alabäshejcunata Davidga niran Tayta Diosta agradësicur alabananpaj. Caynömi alabaran:"]},{"type":"verse","number":8,"content":[{"text":"«¡Tayta Diosta agradësicuy-llapa!","poem":1},{"lineBreak":true},{"text":"¡Paypita willacuy!","poem":1},{"lineBreak":true},{"text":"Imata rurashantapis intëru marcacunaman willacuy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alabansacunawan payta alabay.","poem":1},{"lineBreak":true},{"text":"Almiraypajcunata rurashanta willacuy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Tayta Dios rispitädu cashanpita cushicuy.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta ashejcunaga cushicuy-llapa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Diosninchïman guellicuy.","poem":1},{"lineBreak":true},{"text":"Imaypis paywan tincuyta ashiy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fiyupa almiraypaj milagrucunata rurashanta yarpay.","poem":1},{"lineBreak":true},{"text":"Mandamintuncunata nishancunatapis yarpay ari","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"sirbejnin Israelpita mirar aywajcuna,","poem":1},{"lineBreak":true},{"text":"acrashan Jacobpa wamrancuna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Tayta Diosmi noganchïpa Diosninchi.","poem":1},{"lineBreak":true},{"text":"Paypa maquinchömi caycan cay pachaga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Payga aunishanta imaypis yarpashami.","poem":1},{"lineBreak":true},{"text":"Waranga miray aywajcamapis manami gongashachu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Abrahamta aunishanta,","poem":1},{"lineBreak":true},{"text":"Isaacta aunishantapis yarpashami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Jacobpäga camacächiran layno cananpaj;","poem":1},{"lineBreak":true},{"text":"Israelcunapäna parlacushanga imaycamapis mana gongacänanpaj.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chaymi niran: ‹Canaán partitami goycushayquipaj gamcunapa","poem":1},{"lineBreak":true},{"text":"partisyunniqui cananpaj.›","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Paycunaga caran wallcajllami.","poem":1},{"lineBreak":true},{"text":"Chaychöga juc ishcay jäpa runacunalla caran.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Paycunaga nasyunnin nasyunninmi puricoj.","poem":1},{"lineBreak":true},{"text":"Juc raypa juc raypa maquinmanmi chayaj.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chaypis Tayta Diosga manami munaranchu pï ñacachinantapis.","poem":1},{"lineBreak":true},{"text":"Raycunatapis willaparan:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"‹Ama yatapaychu acrashä runacunataga.","poem":1},{"lineBreak":true},{"text":"Profëtäcunatapis ama ñacachiychu› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«Cay pachacho tiyaj cäga llapayqui Tayta Diosta alabay.","poem":1},{"lineBreak":true},{"text":"Salbacoj cashanta waran-waran willacuy.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Munayniyoj cashanta nasyuncunaman willacuy.","poem":1},{"lineBreak":true},{"text":"Fiyupa almiraypäta rurashancunatapis marcacunaman willacuy.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tayta Diosga munayniyojmi.","poem":1},{"lineBreak":true},{"text":"Fiyupa rispitashpanchi alabashun.","poem":1},{"lineBreak":true},{"text":"Payga dioscunapita mas fiyupa manchacunami.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Waquin marcacunapa diosnincunaga manacajllami.","poem":1},{"lineBreak":true},{"text":"Tayta Diosninchïmi ichanga syëlutapis camasha.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Pay caycashanchöga fiyupami achicyan.","poem":1},{"lineBreak":true},{"text":"Pay tiyashan cajchöga munayninpis fiyupa cushicuypis caycanmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Llapan marcacho tiyajcuna Tayta Dios munayniyoj cashanta tantiyacuy-llapa.","poem":1},{"lineBreak":true},{"text":"Payta aduray-llapa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tayta Diosta rispitanapaj cashanno rispitay-llapa.","poem":1},{"lineBreak":true},{"text":"Garayniquiwan paypa ñaupanman yaycuy.","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj wasincho aduray.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"¡Paypa ñaupanchöga cay pachacho cajcuna sicsicyachun!","poem":1},{"lineBreak":true},{"text":"Paymi mundutaga sumaj tacyachisha mana cuyucunanpaj.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"¡Syëlupis cay pachapis cushicuchun!","poem":1},{"lineBreak":true},{"text":"¡Intëru nasyuncunapäpis ‹Tayta Diosmi Raynenga› nichun!","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"¡Lamar yacupis, chaycho caycajcunapis gaparpächun!","poem":1},{"lineBreak":true},{"text":"¡Chacracunapis chaycho caycajcunapis cushicuchun!","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"¡Munticho caj yöracunapis cushicuypita gaparpächun","poem":1},{"lineBreak":true},{"text":"cay pachacho mandananpaj shamoj Tayta Diospa ñaupancho!","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«Tayta Diosninchïta agradësicuy amatar alli cashanpita.","poem":1},{"lineBreak":true},{"text":"Payga imaycamapis chaynöllami cuyamanchi.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Llapayqui niy:","poem":1},{"lineBreak":true},{"text":"¡Nogacunapa salbacoj Diosnë salbaycamay ari!","poem":1},{"lineBreak":true},{"text":"¡Nasyuncunacho caycajtapis shuntamashpayqui jorgaycamay","poem":1},{"lineBreak":true},{"text":"gamllata nogacuna agradësicunäpaj,","poem":1},{"lineBreak":true},{"text":"cushishana alabanäcunapaj!","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"¡Israelcuna rispitashan Tayta Diosga","poem":1},{"lineBreak":true},{"text":"imay-yajpis alabasha cachun!»","poem":1},"Llapan runacunapis «Chayno cachun» niran. Nircorga Tayta Diosta llapan alabaran."]},{"type":"verse","number":37,"content":["Chaynömi Davidga numrashan runacunata churaran Tayta Diospa babulnin ñaupancho caycänanpaj Asafta, paywan caycajcunata, paycunana waran-waran ima ruraycunatapis rurananpaj."]},{"type":"verse","number":38,"content":["Obed-edomtapis sojta chunca (60) runacunatawan churaran chaycho caycänanpaj. Jedutunpa wamran Obed-edomtawan Hosatana churaran puncuta täpananpaj."]},{"type":"verse","number":39,"content":["Sadocta paywan caj cüracunatapis niran Tayta Diospa wasin Gabaoncho caycänanpaj."]},{"type":"verse","number":40,"content":["Paycunata niran Tayta Diospaj rupachina caj altarcho tardipa tutapapis rupachina sacrifisyucunata ruparcaycächinanpaj. Tayta Dios isquirbichishan laycho niycashanno rurananpämi niran."]},{"type":"verse","number":41,"content":["Paycunawan caycänanpaj churaran Hemanta, Jedutunta. Paycunatawan iwal alabananpaj jutinpa acrashan caj runacunatapis cacharan. Paycunata niran: «Tayta Diosta agradësicunqui. Payga imaycamapis chaynöllami cuyamanchi.»"]},{"type":"verse","number":42,"content":["Paycunaga tucaj trompëtacunata, latillucunata, waquin tucanacunata Tayta Diospaj cantajcunawan iwal. Jedutunpa wamrancunatana churaran puncu yaycurinata täpananpaj."]},{"type":"verse","number":43,"content":["Chaypitanaga llapan runacuna wasinman-cama aywacuran. Davidpis wasinman cuticuran famillyancunata bindisyunta gonanpaj."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":43}