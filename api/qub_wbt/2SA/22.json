shcä.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"‹Yanapämay› niptinpis manami pipis yanapashachu.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta mañacuptinpis manami yanapashachu.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ñuchu allpatanömi rurarirä.","poem":1},{"lineBreak":true},{"text":"Cällicunacho mitu caycajtanömi lluchcar-ushashcäpis.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Runacuna conträ jatariptinpis salbamashcanqui.","poem":1},{"lineBreak":true},{"text":"Nasyuncunapa mandajnin canäpämi churamashcanqui.","poem":1},{"lineBreak":true},{"text":"Cananga jäpa runacunami sirbimanpis.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Chay runacunaga nishäta llapantami wiyacun.","poem":1},{"lineBreak":true},{"text":"Jäpa runacunami rispitaman.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Juc-lä nasyun runacunaga manchacamanmi.","poem":1},{"lineBreak":true},{"text":"Pacacunanpitapis sicsicyaycarmi llojshimun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"«¡Alabasha cachun Tayta Dios!","poem":1},{"lineBreak":true},{"text":"¡Alabasha cachun chapämajnëga!","poem":1},{"lineBreak":true},{"text":"¡Fiyupa rispitasha cachun salbamaj Tayta Diosnëga!","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Mana allita ruramashanpita Tayta Diosmi ayñita cutichisha.","poem":1},{"lineBreak":true},{"text":"Llapan runacunatapis munaynilläman churasha.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Chiquimajcuna fiyupa rabyasha caycaptinpis,","poem":1},{"lineBreak":true},{"text":"mana wiyacojcuna nogapa conträ jatariptinpis Paymi salbaman.","poem":1},{"lineBreak":true},{"text":"¡Tayta Dios gammi salbamanqui fiyu runacunapita!","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Chaymi llapan nasyuncunapa läduncho alabashayqui.","poem":1},{"lineBreak":true},{"text":"Cantaypapis alabashayquimi Tayta Dios.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Sumaj allicho cananpämi yanapanqui acrashayqui raytaga.","poem":1},{"lineBreak":true},{"text":"Imaypis allimi ricanqui Davidta, paypita mirar aywajcunata.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}