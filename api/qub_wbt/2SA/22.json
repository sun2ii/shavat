{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"2SA","translationId":"qub_wbt","name":"2 SAMUEL","commonName":"2 SAMUEL","title":"2 Samuel","order":10,"numberOfChapters":24,"sha256":"db4c6f943f2b46700553bcac1552799fc7bb7e4a149ee6b44c24ecda345c0d71","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/qub_wbt/2SA/24.json","totalNumberOfVerses":693},"chapter":{"number":22,"content":[{"type":"heading","content":["Binsiycur David cantashan"]},{"type":"verse","number":1,"content":["Davidtaga Tayta Dios salbaran Saúl wañuchinanpaj caycaptin, waquin chiquinacushancunapis wañuchinanpaj caycaptin."]},{"type":"verse","number":2,"content":["Chaymi Davidga cantar niran:",{"text":"«Tayta Dios, gammi gagano chapämajnë canqui.","poem":1},{"lineBreak":true},{"text":"Gammi pacamaj, salbamaj canqui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diosnëmi washäcoj gaga,","poem":1},{"lineBreak":true},{"text":"chapacuna escüdö, munayniyoj salbamaj,","poem":1},{"lineBreak":true},{"text":"altunnin pacacunä,","poem":1},{"lineBreak":true},{"text":"altunnin gueshpinä, salbamajnë.","poem":1},{"lineBreak":true},{"text":"¡Pillyacho salbamashcanqui!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tayta Dios, alabasha canayquimi camacan.","poem":1},{"lineBreak":true},{"text":"Mañacamuptë, chiquimajcunapita salbamanquimi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Wañuyga yacu-jinami ñiticarcamaran.","poem":1},{"lineBreak":true},{"text":"Juchu-jina janächöna captin fiyupa mancharirä.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wañuyga wascanömi pitucarcamaran.","poem":1},{"lineBreak":true},{"text":"Wañunäpämi togllacunata churapämaran.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fiyupa llaquicur Tayta Diosta mañacurä.","poem":1},{"lineBreak":true},{"text":"Mañacurä yanapämänanpaj.","poem":1},{"lineBreak":true},{"text":"Payga Templunpita wiyamaran.","poem":1},{"lineBreak":true},{"text":"¡Gaparayparaj mañacushäta wiyamaran!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Chauraga intërucho fiyupa timlur caran.","poem":1},{"lineBreak":true},{"text":"Syëluta tucnarajcunapis sicsicyaran.","poem":1},{"lineBreak":true},{"text":"Tayta Dios rabyacurcuptinmi llapanpis cuyuriran.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Senganpita goshtay llojshiycaran,","poem":1},{"lineBreak":true},{"text":"shiminpitana ushacoj nina.","poem":1},{"lineBreak":true},{"text":"Shiminpaga ajtuycämuran ratataycaj shanshata.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Syëluta garirir urämuran.","poem":1},{"lineBreak":true},{"text":"¡Chaquin rurinpana caycaran fiyupa yana pucutay!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Querubín anjilta muntacurcur buylaran.","poem":1},{"lineBreak":true},{"text":"Wayrachömi aywacuran.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Paypa toldonga yanauyaycaj pucutaymi.","poem":1},{"lineBreak":true},{"text":"Paypa chucllanga yana chicnu chacaymi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fiyupa achicyaycaj illguymi ñaupanpita llojshiran.","poem":1},{"lineBreak":true},{"text":"Ratataycaj shanshami tamyamuran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Janajcho caycaj Tayta Diosga","poem":1},{"lineBreak":true},{"text":"syëlupita-pachami parlamuran räyuno busninwan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lëchancunatami jitamuran. Illguynincunatami achicyächiran.","poem":1},{"lineBreak":true},{"text":"Chiquimajcunatapis machiypa-machir gueshpichiran.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tayta Dios ollgöpaptin,","poem":1},{"lineBreak":true},{"text":"sinchipa pücariptin,","poem":1},{"lineBreak":true},{"text":"lamar rurin alayri ricacäcuran.","poem":1},{"lineBreak":true},{"text":"Munduta tucnarajcunapis alayri ricacaran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Tayta Diosga janajpita-pachami ayparcamusha.","poem":1},{"lineBreak":true},{"text":"Maquinwan jorgamasha may-may lamarpita.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fiyupa munayniyoj chiquimajcunawan pillyacho captëpis salbamasha.","poem":1},{"lineBreak":true},{"text":"Paycunaga caran nogapita mas callpayojmi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ñacaycho caycaptëmi paycunaga magamaran.","poem":1},{"lineBreak":true},{"text":"Chaypis Tayta Diosga yanapämaran.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Paymi alliman jorgamaran.","poem":1},{"lineBreak":true},{"text":"Cuyamashpanmi salbamaran.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Allillata rurashäpitami","poem":1},{"lineBreak":true},{"text":"Tayta Diosga salbamasha.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nogaga Tayta Dios munashannöllami goyaycä.","poem":1},{"lineBreak":true},{"text":"Juchata mana ruraypami imaypis gatirashcä.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mandamintuncunataga llapantami musyaycä.","poem":1},{"lineBreak":true},{"text":"Laynincunataga imaypis cumlishcämi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Payga musyanmi munashanno cawashäta.","poem":1},{"lineBreak":true},{"text":"Manami imatapis llutancunata rurashcächu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Allillata rurashäpitami","poem":1},{"lineBreak":true},{"text":"Tayta Diosga premyuta gomasha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«Tayta Dios, cuyapäcoj cajtaga yanapanquimi.","poem":1},{"lineBreak":true},{"text":"Alli cajcunatapis yanapanquimi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Juchaynajcunatapis yanapanquimi.","poem":1},{"lineBreak":true},{"text":"Fiyu cajcunatami ichanga castiganqui.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Umildicunataga salbanquimi.","poem":1},{"lineBreak":true},{"text":"Alli-tucojcunatami ichanga manacajman churanqui.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tayta Dios, gammi achicyaj pachata ricaycächimanqui.","poem":1},{"lineBreak":true},{"text":"Chacaj pachacho ricacunätapis gammi cawaycächimanqui.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gam yanapämaptiquimi chiquimajcunata magaj yaycushaj.","poem":1},{"lineBreak":true},{"text":"Siudänincunata curalaraycaj jananpapis yaycurishaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«Tayta Dios nishanga llapanpis allimi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga aunishanta llapantapis cumlinmi.","poem":1},{"lineBreak":true},{"text":"Diosga yäracojcunata washanmi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tayta Diospita mas jucga