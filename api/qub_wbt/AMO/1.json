{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"AMO","translationId":"qub_wbt","name":"AMÓS","commonName":"AMÓS","title":"Amós","order":30,"numberOfChapters":9,"sha256":"48fd9074fdbc11f4c2695969ec14a2634071fee2d048d9990bcf31975fd5f8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/qub_wbt/AMO/9.json","totalNumberOfVerses":145},"chapter":{"number":1,"content":[{"type":"heading","content":["Gallaycunan"]},{"type":"verse","number":1,"content":["Tecoa marcachömi tiyaran Amós jutiyoj runa. Payga uyshayojmi caran. Tayta Diosga Amosta caycunatami willaparan Israelcunata willapänanpaj. Chaytaga Amós willacuran Uzías Judäpa raynin caycashan wichanmi. Israelpa rayninna caycaran Joaspa wamran Jeroboam. Chay willacushanga caran fiyupa timlur cananpaj ishcay wata pishiycaptillanmi."]},{"type":"verse","number":2,"content":["Cayno nirmi Amosga willacuran:",{"text":"«Tayta Diosga Sión lömapita liyunnömi gaparämun.","poem":1},{"lineBreak":true},{"text":"Jerusalenpitami busninpis junrurumun.","poem":1},{"lineBreak":true},{"text":"Chauraga jircacho caycaj guewacunapis wañuytacäcunmi.","poem":1},{"lineBreak":true},{"text":"Carmelo puntapis chaquicäcunmi.","poem":1}]},{"type":"heading","content":["Israelpa bisïnun nasyuncuna jusgasha cananpaj cashan"]},{"type":"heading","content":["Siriapa contran"]},{"type":"verse","number":3,"content":["«Tayta Diosga caynömi nin:",{"text":"«Damasco siudä runacunaga fiyupa aypallatanami mana allita rurasha.","poem":1},{"lineBreak":true},{"text":"Galaad runacunata alläpanami ñacachisha.","poem":1},{"lineBreak":true},{"text":"Imanömi rïguta ëran fyërru ëracunawan, chaynömi rurasha.","poem":1},{"lineBreak":true},{"text":"Chaypitami castigänillataga mana cachaycushächu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ray Hazaelpa famillyancuna tiyaycashan wasimanmi ninata sindipaycushaj.","poem":1},{"lineBreak":true},{"text":"Chay ninami ushacurcongapaj ray Ben-adad tiyaycashan palasyutapis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Damasco siudäman yaycuna puncu rancaraycajtapis callpaycurmi amirishaj.","poem":1},{"lineBreak":true},{"text":"Avén guechwa pampacho mandaycajtapis illgächishämi.","poem":1},{"lineBreak":true},{"text":"Chaynömi rurashaj Bet-edén siudächo mandaycajtapis.","poem":1},{"lineBreak":true},{"text":"Siria runacunatanami nasyunninpita prësu apanga Kir partiman.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"heading","content":["Filisteapa contran"]},{"type":"verse","number":6,"content":["«Tayta Diosga caynömi nin:",{"text":"«Gaza siudä runacunaga fiyupa aypallatanami mana allita rurasha.","poem":1},{"lineBreak":true},{"text":"Paycunaga juc nasyun intëru runacunatami prësu apacuran.","poem":1},{"lineBreak":true},{"text":"Nircorga Edom nasyunman ranticaycäriran uyway cananpaj.","poem":1},{"lineBreak":true},{"text":"Chayno rurashanpitami castigashaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gaza siudäpa curral pergancunamanmi ninata sindipaycushaj.","poem":1},{"lineBreak":true},{"text":"Chay ninami rupar ushacurcongapaj palasyuncunatapis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asdod siudächo mandaycajtapis illgächishämi.","poem":1},{"lineBreak":true},{"text":"Chaynömi rurashaj Ascalón siudächo mandaycajtapis.","poem":1},{"lineBreak":true},{"text":"Llapan munaynëwanmi castigashaj Ecrón siudächo tiyajcunataga.","poem":1},{"lineBreak":true},{"text":"Chayno castigaptëmi jucnaylla gueshpejllapis Filistea nasyun runaga wañonga.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"heading","content":["Feniciapa contran"]},{"type":"verse","number":9,"content":["Tayta Diosga caynömi nin:",{"text":"«Tiro siudächo tiyaj runacunaga aypallatanami mana allita rurasha.","poem":1},{"lineBreak":true},{"text":"Paycunapa juchancunaga caycan juc marca intëru runacunata Edom runacunaman uyway cananpaj ranticushanmi.","poem":1},{"lineBreak":true},{"text":"Manami cumliranchu alli goyänanpaj parlashanta.","poem":1},{"lineBreak":true},{"text":"Chaypitami castigänillataga mana cachaycushächu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tiro siudäpa curral pergancunamanmi ninata sindipaycushaj.","poem":1},{"lineBreak":true},{"text":"Chay ninami rupar ushacurconga palasyuncunata.»","poem":1}]},{"type":"heading","content":["Edompa contran"]},{"type":"verse","number":11,"content":["Tayta Diosga caynömi nin:",{"text":"«Edom nasyuncho tiyajcunaga aypallatanami mana allita rurasha.","poem":1},{"lineBreak":true},{"text":"Paycunaga famillyan Israelcunatami mana cuyapaypa gaticacharan sablinta aptacarcärir.","poem":1},{"lineBreak":true},{"text":"Fiyupa chiquishpanmi chayno ruraran.","poem":1},{"lineBreak":true},{"text":"Chaypitami castigänillataga mana cachaycushächu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Temán siudämanmi ninata sindipaycushaj.","poem":1},{"lineBreak":true},{"text":"Chay ninami rupar ushacurconga Bosra siudächo caycaj palasyucunata.»","poem":1}]},{"type":"heading","content":["Amonpa contran"]},{"type":"verse","number":13,"content":["Tayta Diosga caynömi nin:",{"text":"«Amón nasyuncho tiyajcunaga aypallatanami mana allita rurasha.","poem":1},{"lineBreak":true},{"text":"Paycunaga nasyunninta jatunyächiyta munaywanmi","poem":1},{"lineBreak":true},{"text":"Galaad warmicunatapis gueshyaj caycajta pachancunata gashargäriran.","poem":1},{"lineBreak":true},{"text":"Chaypitami castigänillataga mana cachaycushächu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rabá siudäpa pergancunamanmi ninata sindipaycushaj.","poem":1},{"lineBreak":true},{"text":"Chay ninami palasyuncunata rupar ushacurconga.","poem":1},{"lineBreak":true},{"text":"Pillyar gaparpaycaptinmi ninaga ushanga.","poem":1},{"lineBreak":true},{"text":"Manchariypaj löcu wayra caycaptinmi ushanga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Rayninnami mandäshejcunawan iwal prësu aywanga juc-lä nasyunman.»","poem":1},"Tayta Diosmi chayno nisha."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}