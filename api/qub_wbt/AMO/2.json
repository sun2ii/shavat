{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"AMO","translationId":"qub_wbt","name":"AMÓS","commonName":"AMÓS","title":"Amós","order":30,"numberOfChapters":9,"sha256":"48fd9074fdbc11f4c2695969ec14a2634071fee2d048d9990bcf31975fd5f8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/qub_wbt/AMO/9.json","totalNumberOfVerses":145},"chapter":{"number":2,"content":[{"type":"heading","content":["Moabpa contran"]},{"type":"verse","number":1,"content":["Tayta Diosga caynömi nin:",{"text":"«Moab nasyuncho tiyajcunaga aypallatanami mana allita rurasha.","poem":1},{"lineBreak":true},{"text":"Paycunaga uchpayänanyajmi rupachiran Edompa rayninpa tulluncunata.","poem":1},{"lineBreak":true},{"text":"Chaypitami castigänillataga mana cachaycushächu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Moab nasyunmanmi ninata sindipaycushaj.","poem":1},{"lineBreak":true},{"text":"Chay ninami rupar ushacurconga Queriot siudächo caycaj palasyucunata.","poem":1},{"lineBreak":true},{"text":"Pillyacho gaparpaycaptin, trompëtacunata tucarcaycaptinmi","poem":1},{"lineBreak":true},{"text":"Moab runacunataga wañuchir ushacächenga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chay nasyunpa raynintapis mandäshejnincunatapis wañuchishämi.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"heading","content":["Judäpa contran"]},{"type":"verse","number":4,"content":["Tayta Diosga caynömi nin:",{"text":"«Judá nasyun runacunaga aypallatanami mana allita rurasha.","poem":1},{"lineBreak":true},{"text":"Paycunaga manami wiyacushachu yachachicuynëcunata.","poem":1},{"lineBreak":true},{"text":"Laynëcunacho niycashancunatapis manami cäsushachu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga papänincuna adurashan ïdulucunallatami adurasha.","poem":1},{"lineBreak":true},{"text":"Chaypitami castigänillataga mana cachaycushächu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Judá nasyunmanmi ninata sindipaycushaj.","poem":1},{"lineBreak":true},{"text":"Chaynami rupar illgarachenga Jerusalencho caycaj palasyucunata.»","poem":1}]},{"type":"heading","content":["Israelpa contran"]},{"type":"verse","number":6,"content":["Tayta Diosga caynömi nin:",{"text":"«Israel nasyun runacunaga aypallatanami mana allita rurasha.","poem":1},{"lineBreak":true},{"text":"Chaypitami castigänillataga mana cachaycushächu.","poem":1},{"lineBreak":true},{"text":"Paycunaga juchaynaj alli runacunatami uyway cananpaj ranticun.","poem":1},{"lineBreak":true},{"text":"Pobricunatanami ishcay llanguillawan rucan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pengaypaj ñacachin.","poem":1},{"lineBreak":true},{"text":"Umildicunataga arriglarpis jananpanmi.","poem":1},{"lineBreak":true},{"text":"Taytanpis, wamranpis chay jipashllawan cacun.","poem":1},{"lineBreak":true},{"text":"Chayno rurashpanmi juchaynaj caycaptë pengayman churaman.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Israelcunaga rindata chararashan röpacunata mashtaycärirmi","poem":1},{"lineBreak":true},{"text":"wegurpan ïdulucunapa ñaupancho rispitar micunanpaj.","poem":1},{"lineBreak":true},{"text":"Multata pägachishan guellaywanmi bïnuta rantin.","poem":1},{"lineBreak":true},{"text":"Nircurmi chayta upyan ‹diosnë› nishancunapa templuncunacho.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ichanga chayno carcaycaptinpis nogami paycunata päsachimunäpaj Amorreo runacunata ushajpaj illgächirä.","poem":1},{"lineBreak":true},{"text":"Ushajpämi wañuchirä sedru guerucunano jatun caycajta, roble guerucunano sinchi caycajtapis.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Israelcuna, gamcunatami ichanga Egiptupita jorgamurä.","poem":1},{"lineBreak":true},{"text":"Amorreo runacuna tiyashan nasyunta gamcunata goycunäpaj","poem":1},{"lineBreak":true},{"text":"chuscu chunca (40) watatarämi chunyajpa pushamur chayachimurä.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gamcunachöga waquinta churashcä profëtä cananpaj.","poem":1},{"lineBreak":true},{"text":"Waquintanami acrarä nazareo cananpaj.","poem":1},{"lineBreak":true},{"text":"Israelcuna, ¿manachu chayno camacächirä?»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"verse","number":12,"content":["Mastapis Tayta Diosga nin:",{"text":"«Chayno caycaptinpis gamcunaga nazareo runacunata firsapita bïnuta upuchishcanqui.","poem":1},{"lineBreak":true},{"text":"Profëtacunatapis michashcanqui nogapa jutëcho mana willacunanpaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chayno cashayquipitami aypallata cargasha aywaycaj carrëta pampata ñitirishannöpis","poem":1},{"lineBreak":true},{"text":"gamcunataga ñitirishayqui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"May-jina cörrishpayquicunapis manami gueshpinquipächu.","poem":1},{"lineBreak":true},{"text":"Fiyupa callpayoj captiquipis manami callpayqui canganachu.","poem":1},{"lineBreak":true},{"text":"Ni jinyunnin cajpis manami salbacongapänachu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lëchawan illapayta yachajpis manami illapayta camäpacongapänachu.","poem":1},{"lineBreak":true},{"text":"Fiyupa cörriyta yachajpis manami gueshpengapänachu.","poem":1},{"lineBreak":true},{"text":"Ni cawallunwan muntädu gueshpejpis manami salbacongapänachu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chay junäga fiyupa pillyay yachaj jinyunninpis","poem":1},{"lineBreak":true},{"text":"galallami gueshpir aywaconga.»","poem":1},"Tayta Diosmi chayno nisha."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}