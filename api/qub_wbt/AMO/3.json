{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"AMO","translationId":"qub_wbt","name":"AMÓS","commonName":"AMÓS","title":"Amós","order":30,"numberOfChapters":9,"sha256":"48fd9074fdbc11f4c2695969ec14a2634071fee2d048d9990bcf31975fd5f8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/qub_wbt/AMO/9.json","totalNumberOfVerses":145},"chapter":{"number":3,"content":[{"type":"heading","content":["Castïgu chayananpaj wallcallana pishiycashanta willacushan"]},{"type":"verse","number":1,"content":["¡Wiyay Israelcuna! Egiptupita jorgamushoj Tayta Diosmi cayno nishunqui:"]},{"type":"verse","number":2,"content":[{"text":"«Munducho aypalla runacuna caycajpitami gamcunallata acrashcä.","poem":1},{"lineBreak":true},{"text":"Acrasha caycaptë mana allita rurashayquipita gamcunataga castigashayquimi.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¿Manaraj alli parlacusha carga ishcaj runacuna purinmanchuraj?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Manaraj cäsata charisha carga munticho liyun gaparämunmanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Manaraj machaynincho cäsata charar manta liyunpis gaparämunmanchuraj?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Mana ima micuytapis churapashaga pichiusa trampaman yaycunmanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Mana imapis yaycuptenga chiclla churashan juchunmanchuraj?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Manaraj pipis wañuptin wañushapänöna marcacho campanata tucanmanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Tayta Dios mana camacächiptenga ima disigrasyallapis siudäman chayamunmanchuraj?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Diosga manami imaypis imatapis ruranchu sirbej profëtancunata manaraj musyacherga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Liyun wagamuptenga","poem":1},{"lineBreak":true},{"text":"¿piraj manchariyllawan mana sicsicyanmanchu?","poem":1},{"lineBreak":true},{"text":"Willacunanpaj pitapis Tayta Dios niptenga","poem":1},{"lineBreak":true},{"text":"¿piraj mana willacunmanchu?","poem":1}]},{"type":"heading","content":["Samaria illgänanpaj willacushan"]},{"type":"verse","number":9,"content":[{"text":"Willacojcuna, gamcuna willacuy Asdod runacunapa palasyuncunacho,","poem":1},{"lineBreak":true},{"text":"Egiptucho caycaj palasyucunachöpis.","poem":1},{"lineBreak":true},{"text":"Cayno niy: «Samaria jircacunaman shamuy-llapa,","poem":1},{"lineBreak":true},{"text":"fiyupa mana allicunata Samariacho ruraycajta ricanayquipaj,","poem":1},{"lineBreak":true},{"text":"alli runacunata ñacaycächejtapis ricanayquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Paycunaga alli cajta rurayta manami yachanchu.","poem":1},{"lineBreak":true},{"text":"Guechushancunallatami palasyuncunachöpis chararaycan.»","poem":1}]},{"type":"verse","number":11,"content":["Chayno cashanpitami Tayta Diosga cayno nin:",{"text":"«Chiquishojcunami nasyunniquita curalapaycärengapaj.","poem":1},{"lineBreak":true},{"text":"Pacacunayqui caycajcunatapis juchurgärachengapämi.","poem":1},{"lineBreak":true},{"text":"Palasyuyquipitanami ima-aycatapis apaconga.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tayta Diosga caynömi nin:","poem":1},{"lineBreak":true},{"text":"«Uywayoj runa imanömi liyunpa shiminpita guechun","poem":1},{"lineBreak":true},{"text":"uywanpa ishcay macshullanta u rinrincunallatapis,","poem":1},{"lineBreak":true},{"text":"chaynöllami Samariacho tiyaj Israelcunapis,","poem":1},{"lineBreak":true},{"text":"Damascupita rantimushan alli jamacunacho wegurpajcunapis wallca cösallanwan gueshpenga.»","poem":1}]},{"type":"verse","number":13,"content":["Munayniyoj Tayta Diosga willacojcunata caynömi nin:",{"text":"«Gamcuna wiyay-llapa.","poem":1},{"lineBreak":true},{"text":"Jacobpita mirar aywaj Israel runacunapa contran willacuy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Juchanpita Israelcunata jusganä junäga","poem":1},{"lineBreak":true},{"text":"Betelcho caycaj altarcunata ushajpämi illgächej-aywä.","poem":1},{"lineBreak":true},{"text":"Altarpa isquïnancho caj wagrancunapis paquicarmi pampaman shicwanga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Jatusaj palasyucunatapis illgächishämi.","poem":1},{"lineBreak":true},{"text":"Achicyaypa achicyaycaj wasincunatapis illgarachishämi.","poem":1},{"lineBreak":true},{"text":"Llapan jatun wasincunatapis juchurgärachishämi.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}