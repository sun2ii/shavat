{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"AMO","translationId":"qub_wbt","name":"AMÓS","commonName":"AMÓS","title":"Amós","order":30,"numberOfChapters":9,"sha256":"48fd9074fdbc11f4c2695969ec14a2634071fee2d048d9990bcf31975fd5f8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/qub_wbt/AMO/9.json","totalNumberOfVerses":145},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Sumaj wiyay Samaria warmicuna.","poem":1},{"lineBreak":true},{"text":"Basán particho wäcacunano caycaj warmicuna wiyay cayno nishäta:","poem":1},{"lineBreak":true},{"text":"Gamcunaga pobricunatami ñacaycächinqui.","poem":1},{"lineBreak":true},{"text":"Pishëpacojcunatapis magar-ushaycanqui.","poem":1},{"lineBreak":true},{"text":"Runayquicunatana «Bïnuta apamuy upyanäpaj» nircaycanqui.","poem":1}]},{"type":"verse","number":2,"content":["Rispitädu jutincho jurashpanmi Tayta Dios cayno nin:",{"text":"«Juc junajmi liyacurcur gamcunata apacushunquipaj.","poem":1},{"lineBreak":true},{"text":"Wamrayquicunatami aushicunawan janchacurcongapaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chauraga gatinayllanpami perga uchcucunapa llojshinquipaj.","poem":1},{"lineBreak":true},{"text":"Hermonmanmi gargurishunquipaj.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"heading","content":["Tayta Dios rabyasha rimashan"]},{"type":"verse","number":4,"content":[{"text":"«¡Betelcho caycaj capillaman mä ayway ä jucha ruraj!","poem":1},{"lineBreak":true},{"text":"¡Gilgalcho caycaj capillaman mä ayway ä masta jucha ruraj!","poem":1},{"lineBreak":true},{"text":"Uywata pishtarcur tutacunapa apay ä.","poem":1},{"lineBreak":true},{"text":"Cada quimsa junaj diesmuyquita apay ä.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Agradësicushpayqui lebadürayoj tantacunata rupachiy ä.","poem":1},{"lineBreak":true},{"text":"Nircur, chay goycushayquitaga pï-maytapis willapay ä.","poem":1},{"lineBreak":true},{"text":"Chayno ruraymi gamcunataga gustashunqui.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Nogami camacächirä gamcuna yargaycho canayquipaj.","poem":1},{"lineBreak":true},{"text":"Nogami camacächirä tiyashayquicunacho micuy pishëshunayquipaj.","poem":1},{"lineBreak":true},{"text":"¡Chaypis gamcunaga manami nogaman yapay yäracamushcanquichu!»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Chaynöpis nogami camacächirä, micuycuna pogunanpaj","poem":1},{"lineBreak":true},{"text":"quimsa quilla pishiycaptillan usyacurcunanpaj.","poem":1},{"lineBreak":true},{"text":"Nogami camacächirä waquin siudächo tamyananpaj,","poem":1},{"lineBreak":true},{"text":"waquin siudächöna mana tamyananpaj.","poem":1},{"lineBreak":true},{"text":"Waquin chacramanga tamyaran.","poem":1},{"lineBreak":true},{"text":"Mana tamyashan caj partichönami micuycuna chaquiran.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siudänin-siudänin runacunaga yacuta ashishpan puriran.","poem":1},{"lineBreak":true},{"text":"Chayno ashirpis manami tariranchu yacunaycashanta chawächinanpäga.","poem":1},{"lineBreak":true},{"text":"¡Chaypis gamcuna manami nogaman yapayga yäracamushcanquichu!»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Nogami gamcunata castigarä acaj wayrawan, micuyta ushaj curucunawanpis.","poem":1},{"lineBreak":true},{"text":"Camacächirä wertayquicunacho lantayquicuna, übas yörayquicuna garwashtacäcunanpäpis.","poem":1},{"lineBreak":true},{"text":"Chüpacacuna micur ushacurcuran ïgus yörayquicunata, olivocunatapis.","poem":1},{"lineBreak":true},{"text":"¡Chaypis gamcunaga manami nogaman yapay yäracamushcanquichu!»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Egiptuman yurichishäno castïgutami gamcunamanpis chayachimurä.","poem":1},{"lineBreak":true},{"text":"Nogami camacächishcä gamcunacho caycaj mösucuna guërracho wañunanpaj.","poem":1},{"lineBreak":true},{"text":"Camacächirä cawalluyquicunata chiquishojcuna guechurishushpayqui apacunanpaj.","poem":1},{"lineBreak":true},{"text":"Nogami camacächirä pillyacho wañoj runacuna ismushan asyaytapis tiyarcaycashayquicho mayanayquipaj.","poem":1},{"lineBreak":true},{"text":"¡Chaypis gamcunaga manami nogaman yapay yäracamushcanquichu!»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Nogami gamcunata castigarä","poem":1},{"lineBreak":true},{"text":"Sodomatawan Gomorrata castigashäno.","poem":1},{"lineBreak":true},{"text":"Chaymi gamcunaga caycarayqui ninapita jorgurisha tisunno.","poem":1},{"lineBreak":true},{"text":"¡Chaypis gamcunaga manami nogaman yapay yäracamushcanquichu!»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Chaypitami cananga Israelcuna sumaj camaricuy tapuptë imata willamänayquipäpis.","poem":1},{"lineBreak":true},{"text":"Gamcunataga mas piyur-rämi castigashayquipaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Rasunpa chaynömi ruranga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga caycan puntacunatapis camajmi, wayratapis yurichimojmi.","poem":1},{"lineBreak":true},{"text":"Paymi runacunata musyachin imata pay yarpaycashantapis.","poem":1},{"lineBreak":true},{"text":"Paymi achicyajtapis ticrachin chacayman.","poem":1},{"lineBreak":true},{"text":"Paymi purin cay pachachöga intërupa.","poem":1},{"lineBreak":true},{"text":"Paypaga jutinpis munayniyoj Tayta Diosmi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}