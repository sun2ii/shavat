{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"AMO","translationId":"qub_wbt","name":"AMÓS","commonName":"AMÓS","title":"Amós","order":30,"numberOfChapters":9,"sha256":"48fd9074fdbc11f4c2695969ec14a2634071fee2d048d9990bcf31975fd5f8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/qub_wbt/AMO/9.json","totalNumberOfVerses":145},"chapter":{"number":5,"content":[{"type":"heading","content":["Arpinticunanpaj willapashan"]},{"type":"verse","number":1,"content":[{"text":"Canan rimaycämushäta sumaj wiyacuy Israelcuna.","poem":1},{"lineBreak":true},{"text":"Gamcunapaj fiyupa llaquicur parlaycämushäta wiyaycäriy ari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Israelga runa yatänillaraj caycarmi mana alliman chayasha.","poem":1},{"lineBreak":true},{"text":"Chaypita alli cashanmanga mananami cutenganachu.","poem":1},{"lineBreak":true},{"text":"Quiquinpa marcallanchömi mashtarpaycar quëdasha.","poem":1},{"lineBreak":true},{"text":"Pipis manami canchu mashtarpaycajta jatarachinanpäga.","poem":1}]},{"type":"verse","number":3,"content":["Tayta Diosga Israelcunata caynömi nin:",{"text":"«Juc siudäpita waranga (1,000) runacunata pillyaman cachaptin,","poem":1},{"lineBreak":true},{"text":"pachacllanami (100) cutimonga.","poem":1},{"lineBreak":true},{"text":"Juc siudäpita pachac (100) runacunata cachaptin","poem":1},{"lineBreak":true},{"text":"chuncallanami cutimonga.»","poem":1}]},{"type":"verse","number":4,"content":["Tayta Diosga Israelcunata caynömi nin:",{"text":"«Nogaman shacamuy-llapa. Chauraga cawanquipämi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ama aywaychu Betelcho caycaj capillamanga.","poem":1},{"lineBreak":true},{"text":"Ama aywaychu Gilgalcho caycaj capillamanga.","poem":1},{"lineBreak":true},{"text":"Chayno, amana päsaynachu Beersebacho caycaj capillamanpis.","poem":1},{"lineBreak":true},{"text":"Gilgalcho tiyajcunataga simrimi prësu apanga.","poem":1},{"lineBreak":true},{"text":"Betelnami ushajpaj ragällan quëdangapaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tayta Dios munashanno rurarga cawanquimi-llapa.","poem":1},{"lineBreak":true},{"text":"Mana wiyacuptiquimi ichanga ushacächicojcunata","poem":1},{"lineBreak":true},{"text":"Pay cachamonga Israelcuna tiyarcaycashanman.","poem":1},{"lineBreak":true},{"text":"Chaura Betelchöga manami pipis cangachu mana allicunapita salbananpaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ay wawallau, gamcunaga laycunata mana allimanmi ticrachinqui.","poem":1},{"lineBreak":true},{"text":"Nircurpis manacajmanmi churanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Diosmi ichanga chacayta junajman ticrachin.","poem":1},{"lineBreak":true},{"text":"Junajtapis yanauyaycaj chacayman ticrachin.","poem":1},{"lineBreak":true},{"text":"Paymi ruraran «Pléyades» nishan, «Orión» nishan goyllarcunatapis.","poem":1},{"lineBreak":true},{"text":"Paymi gayan lamarcho caycaj yacucunata, nircorga allpa jananmanna machirin.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi camacächin pacacuna siudä illgänanpäpis.","poem":1},{"lineBreak":true},{"text":"Chaynöpami mana allita chayachimun curalasha caycaj siudäcunaman.","poem":1},{"lineBreak":true},{"text":"Paypa jutenga Tayta Diosmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Israelcuna gamcunaga dimanduta alli arriglaj cajta chiquinquimi.","poem":1},{"lineBreak":true},{"text":"Rasun cajta rimaj testïgutaga manami rimanantapis munanquichu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gamcunaga pobricunata manacajmanmi churarcaycanqui.","poem":1},{"lineBreak":true},{"text":"Rïgupitapis impuestuta pägashunayquipämi nircaycanqui.","poem":1},{"lineBreak":true},{"text":"Chayno cashayquipitami mana tiyanquipächu llagllasha rumicunapita wasicunata rurashayquichöpis.","poem":1},{"lineBreak":true},{"text":"Chayno, manami upunquipächu bïnutapis lantashayqui übas wayushantaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Noga musyaycämi maychicata mana allicunata rurashayquitapis.","poem":1},{"lineBreak":true},{"text":"Musyaycämi juchata rurashayquicunata.","poem":1},{"lineBreak":true},{"text":"Juchaynaj alli runacunata ñacarcaycächinqui.","poem":1},{"lineBreak":true},{"text":"Pägashushayqui saynitapis pacayllapa chasquiycanqui.","poem":1},{"lineBreak":true},{"text":"Autoridäcunapa despächunchöpis pobricunapa dimanduntaga mana bälichinquichu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chaymi yachaj runaga upälla cucun,","poem":1},{"lineBreak":true},{"text":"chay wichan fiyupa mana alli captin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Alli cajta ruray, ama mana alli cajtaga.","poem":1},{"lineBreak":true},{"text":"Chauraga cawanquipämi.","poem":1},{"lineBreak":true},{"text":"Chayrämi rasunpa canga gamcuna cayno nishayquega:","poem":1},{"lineBreak":true},{"text":"«Munayniyoj Tayta Diosmi nogacunacho caycan» nir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mana alli cajtaga chiquiy.","poem":1},{"lineBreak":true},{"text":"Alli cajtaga cuyay.","poem":1},{"lineBreak":true},{"text":"Gamcunaga yarpay despächucunachöpis alli arriglayta.","poem":1},{"lineBreak":true},{"text":"Chaura munayniyoj Tayta Diosga capaschari","poem":1},{"lineBreak":true},{"text":"cuyapaycushunquimanpis quëdasharaj caycaj Israelcunata.","poem":1}]},{"type":"verse","number":16,"content":["Munayniyoj Tayta Diosga caynömi nin:",{"text":"«Läsacunachömi wagay canga.","poem":1},{"lineBreak":true},{"text":"Cällicunachömi llaquicuypita gaparpanga.","poem":1},{"lineBreak":true},{"text":"Chacracho arojcunatapis gayanga wagäshinanpaj.","poem":1},{"lineBreak":true},{"text":"Pägapaj wagapacojcunatapis gayanga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Übas chacracunachöpis intëruchömi waganga.","poem":1},{"lineBreak":true},{"text":"Chaynömi canga noga castigaj shamushä örapis.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"¡Ay imanöraj canga, Tayta Dios shamunan junajta shuyarpaycajcuna!","poem":1},{"lineBreak":true},{"text":"¿Gamcunaga musyaycanquichu gamcunapaj imano chay junaj cananpaj cashantapis?","poem":1},{"lineBreak":true},{"text":"Achicyaj cananpa ruquin chay junäga cangapaj yanauyaycaj chacaymi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chay junäga canga, juc runa liyunpita gueshpiycashancho ösuwan tincupurajnömi.","poem":1},{"lineBreak":true},{"text":"Man'chäga gueshpir wasinman yaycurir pergaman guellicuycojta culebra cañiycushannömi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Au, rasunpami Tayta Dios shamunan junäga canga fiyupa chacay, mana achicyaj.","poem":1},{"lineBreak":true},{"text":"Chayga canga fiyupa yanauyaycaj chacaymi, mana imapis ricacajmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Noga Tayta Diosga fiyupami melanäcö gamcuna rispitädu fistata rurashayquicunata.","poem":1},{"lineBreak":true},{"text":"Aduramänayquipaj shuntacashayquipis manami gustamanchu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Manami munächu rupachina sacrifisyucunata nogapaj pishtashayquitapis,","poem":1},{"lineBreak":true},{"text":"ni chaqui micuy ofrendacunata goycamashayquitapis.","poem":1},{"lineBreak":true},{"text":"Nogaga manami chasquishäpächu werannin töru-mallwacunata alli goyaypita sacrifisyupaj pishtaptiquipis.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Noga wiyanäpitaga juc-lächo cantacuy chay alabansayquicunata.","poem":1},{"lineBreak":true},{"text":"Arpayquicuna wagashantapis manami wiyayta munächu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ichanga noga munä allita ruranayquitami.","poem":1},{"lineBreak":true},{"text":"Alli arriglanayquitami munä.","poem":1},{"lineBreak":true},{"text":"Imaypis mana chaquej limyu yacunöraj alli cajta ruray ari.","poem":1}]},{"type":"verse","number":25,"content":["«Israelcuna, chuscu chunca (40) watantin chunyaj chaqui jircapa pushamuptë ¿imaytaj nogapaj uywacunata pishtarayqui, u chaqui micuycunata garamarayqui?"]},{"type":"verse","number":26,"content":["Chaypa ruquenga ‹raynë› nishayqui Sicut-ta aparisha purichej canqui. ‹Quiyún› goyllartapis aparisha purichej-canqui. Chaycunataga ‹diosnë› nir quiquiquicunami ruracarcärirayqui."]},{"type":"verse","number":27,"content":["Chaypitami gamcunata jitarishayquipaj Damascupita mas carucho caycaj chunyaj chaqui jircaman.» Chayno rurashunayquipäga niycan Tayta Diosmi. Paypaga jutinpis munayniyoj Tayta Diosmi."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":26}