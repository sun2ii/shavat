{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"AMO","translationId":"qub_wbt","name":"AMÓS","commonName":"AMÓS","title":"Amós","order":30,"numberOfChapters":9,"sha256":"48fd9074fdbc11f4c2695969ec14a2634071fee2d048d9990bcf31975fd5f8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/qub_wbt/AMO/9.json","totalNumberOfVerses":145},"chapter":{"number":6,"content":[{"type":"heading","content":["Israel illgänanpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"¡Ay imanöraj canqui Sioncho goyaj autoridäcuna!","poem":1},{"lineBreak":true},{"text":"¡Ay imanöraj canqui Samariacho tiyaj mandajcuna!","poem":1},{"lineBreak":true},{"text":"Gamcunaga charashayquiman yäracurmi munayniyoj-tucurcushcanqui.","poem":1},{"lineBreak":true},{"text":"Gamcunamanmi Israelcunaga «yanapämay» nir aywarcaycämun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Calne siudäta aywar mä ricamunqui.","poem":1},{"lineBreak":true},{"text":"Chaypitaga päsar chayanqui Hamat jatun siudäman.","poem":1},{"lineBreak":true},{"text":"Chaypitana uranqui Filisteacho caycaj Gat siudäman.","poem":1},{"lineBreak":true},{"text":"¿Chay nasyuncunacho tiyaj runacunapita mas bälejchuraj gamcunaga canqui?","poem":1},{"lineBreak":true},{"text":"¿Gamcunapa nasyunniquega chay nasyuncunapita mas allichuraj?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gamcunaga fiyupa ñacay junaj chayamunanpaj caycajta manami yarpayllapis yarpanquichu.","poem":1},{"lineBreak":true},{"text":"Chaypis mana allita rurar masmi gayaycanqui chay ñacay junajta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cuyayllapaj llagllaypa adurnasha jamanacho wegurpaycanqui.","poem":1},{"lineBreak":true},{"text":"Fistata rurar cushicushpayqui goyaycanqui.","poem":1},{"lineBreak":true},{"text":"Carni-mallwacunata, werannin töru-mallwacunata micur jamarpaycanqui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Arpacunatapis wagay-wagayllataraj tucarmi birsucunatapis mushojcunallata jorguycanqui.","poem":1},{"lineBreak":true},{"text":"Instrumentucunatapis Davidnörämi tucuy-nirajta ruraycanqui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jatusaj cöpacunawan bïnuta upyarcaycanqui.","poem":1},{"lineBreak":true},{"text":"Cuerpuyquicunamanpis allinnin perfümicunataraj pichucuycanqui.","poem":1},{"lineBreak":true},{"text":"Nasyunniqui mana alliman chayaycashanpäga manami imapis gocushunquichu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chayno cashayquipitami gamcunataraj ñaupa-puntataga juc-läman prësu apashunquipaj.","poem":1},{"lineBreak":true},{"text":"Fistata rurar gaparpashayquicunapis manami musyacangapänachu.","poem":1}]},{"type":"verse","number":8,"content":["Tayta Diosga quiquinpa jutinchömi jurasha. Munayniyoj Tayta Diosga caynömi nin:",{"text":"«Jacobpita mirar-aywajcuna alli-tucushanga fiyupami rabyachiman.","poem":1},{"lineBreak":true},{"text":"Palasyuncunatapis melanäcömi.","poem":1},{"lineBreak":true},{"text":"Chaypitami paycunataga siudänintinta","poem":1},{"lineBreak":true},{"text":"cachapaycushaj chiquejcunapa munayninman.»","poem":1}]},{"type":"verse","number":9,"content":["Chay öraga juc wasicho chunca runacunalla cawaycar quëdasha cashpanpis llapanmi wañonga."]},{"type":"verse","number":10,"content":["Chaura juc famillyan ayata pampananpaj wasiman chayanga. Wasi ruricho caycajtana taponga: «¿Pillaga gamwan chaycho caycanrächu?» nir. Chaura ruripita nimonga «Manami pipis cashachu» nir. Mastapis ruripitaga nimonga: «Upälla. Tayta Diospa jutinta rimarpis rimaycunquimanchari. Chauraga castigarpis castigaycamashwanchari» nir."]},{"type":"verse","number":11,"content":[{"text":"Tayta Diosmi camacächenga jatunpis tacshapis wasicuna juchunanpaj.","poem":1},{"lineBreak":true},{"text":"Chauraga llapanmi illgangapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Cawallucuna purinmanchuraj gagapa?","poem":1},{"lineBreak":true},{"text":"¿Gagacho yapyashwanchuraj?","poem":1},{"lineBreak":true},{"text":"Chaura ¿imanirtaj gamcunaga layta benënumanno ticrachishcanqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj autoridäcuna alli arriglananpaj cajtapis ticrachishcanqui fiyupa ashgajmanno?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gamcunaga manacajcunallapitami alabacuycanqui.","poem":1},{"lineBreak":true},{"text":"Munayniyoj cashayquipitami alli-tucur puriycanqui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Cananga sumaj tantiyacuy Israelcuna.","poem":1},{"lineBreak":true},{"text":"Munayniyoj Tayta Diosga caynömi nin:","poem":1},{"lineBreak":true},{"text":"«Nogami camacächishaj juc nasyun runacuna","poem":1},{"lineBreak":true},{"text":"shaycamur fiyupa ñacachishunayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaycunaga llapaniquitami ñacachishunquipaj","poem":1},{"lineBreak":true},{"text":"Hamatman yaycunapita-pacha gallaycur asta Arabá mayucama» nir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}