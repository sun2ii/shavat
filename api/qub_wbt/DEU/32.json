{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"DEU","translationId":"qub_wbt","name":"DEUTERONOMIO","commonName":"DEUTERONOMIO","title":"Deuteronomio","order":5,"numberOfChapters":34,"sha256":"9c49a4a6b4fd3570d35995326438062bcb6dbae5b491ac5fe1046ed287d06f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/qub_wbt/DEU/34.json","totalNumberOfVerses":958},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"«Syëlu wiyay rimashäta.","poem":1},{"lineBreak":true},{"text":"Cay pacha wiyay imata niycashätapis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yachachicuynëga tamyanömi runacunaman chayanga.","poem":1},{"lineBreak":true},{"text":"Willapashäga shullaynömi,","poem":1},{"lineBreak":true},{"text":"jachaman chirapa chayajnömi,","poem":1},{"lineBreak":true},{"text":"tajtacho shullay caycajnömi canga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios munayniyoj cashantami willacushaj.","poem":1},{"lineBreak":true},{"text":"¡Llapayqui payta alabay ari!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paymi imapitapis chapämajninchi.","poem":1},{"lineBreak":true},{"text":"Pay rurashancunaga fiyupa allimi.","poem":1},{"lineBreak":true},{"text":"Imatapis allillatami ruran.","poem":1},{"lineBreak":true},{"text":"Payga manami imaypis llullacunchu.","poem":1},{"lineBreak":true},{"text":"Payga llapantapis allimi rican.","poem":1},{"lineBreak":true},{"text":"¡Alli cajtami ruran; rasun cajllatami riman!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Fiyu, juchasapa runacuna, Tayta Diosta rabyachej,","poem":1},{"lineBreak":true},{"text":"Paypa ‹wamran› ninäpäpis manami allichu canqui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mana tantiyaj lïsu runacuna","poem":1},{"lineBreak":true},{"text":"¿chaynöchu Tayta Diosninchïta cutichinqui?","poem":1},{"lineBreak":true},{"text":"Payga ¿manachu taytayqui caycan?","poem":1},{"lineBreak":true},{"text":"¿Manachu camashojniqui, cawayta goshojniqui caycan?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Mä yarpachacuriy. Unay imano cashantapis tantiyacuriy.","poem":1},{"lineBreak":true},{"text":"Taytayquicunata, auquincunata tapucuy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Diosmi juc junajcho runacunata raquiran.","poem":1},{"lineBreak":true},{"text":"Nasyuncunata raquir lindancunatapis churaparan.","poem":1},{"lineBreak":true},{"text":"Chayno rurashpan Israelcunatapis raquiparan aycapis cashanman-tupumi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaymi paycunata cuyar acraran yanapänanpaj.","poem":1},{"lineBreak":true},{"text":"Jacobpita mirajcunatami shuntaran paypa maquincho cawananpaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wayralla tumaycaj chunyaj jircachömi paycunata tariran.","poem":1},{"lineBreak":true},{"text":"Cuyapashpan shuntacurmi sumaj yachachiran.","poem":1},{"lineBreak":true},{"text":"Ñawi-ñïñunta-japuymi cuydaran.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chaymi gueshtancho anca älanta quicharcur-quicharcojno,","poem":1},{"lineBreak":true},{"text":"wawancunata pärinanpaj yachachejno,","poem":1},{"lineBreak":true},{"text":"Tayta Diospis acrashancunata apacamuran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Tayta Diosllami pushararan.","poem":1},{"lineBreak":true},{"text":"Juc dioscunaga manami yanapashachu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nasyuncunacho altunnin jircacunapami llapanta binsichir pushamusha.","poem":1},{"lineBreak":true},{"text":"Jircacunacho cajpa wayuynintami micunanpaj camariparan.","poem":1},{"lineBreak":true},{"text":"Gagapita llojshimoj mishquitami upuchiran.","poem":1},{"lineBreak":true},{"text":"Ranrapita llojshimoj asëtitami upuchiran.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Quësutami, cabrapa lëchintami camariparan.","poem":1},{"lineBreak":true},{"text":"Yanapaptinmi Basán particho caj cashnicunata, uyshacunata, chïbucunata micuran.","poem":1},{"lineBreak":true},{"text":"Rïgutapis allillatami micuran.","poem":1},{"lineBreak":true},{"text":"Bïnutapis upuran sumaj pogusha übaspa yacuntami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Israel ichanga werayasha, jaytacojyasha.","poem":1},{"lineBreak":true},{"text":"Jesurún","poem":1},{"noteId":0},{"text":"wera cayllawan llushwaypa llushwasha.","poem":1},{"lineBreak":true},{"text":"Chayno carmi Camajnin Tayta Diostapis gongaycusha.","poem":1},{"lineBreak":true},{"text":"Salbajninta, chapajninta manacajman churasha.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Juc dioscunata adurashpanmi Tayta Diosta rabyachisha.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Uywacunatapis pishtaran dyablucunapaj,","poem":1},{"lineBreak":true},{"text":"chayraj rejsishan dioscunapaj.","poem":1},{"lineBreak":true},{"text":"Chaycunataga unay awiluncunapis manami aduraranchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Israelcuna, cachaycushcanquimi imapitapis chapäshoj Taytanchïta.","poem":1},{"lineBreak":true},{"text":"Gongaycushcanqui cawayta gomajninchi Tayta Diosta.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chaypitami Tayta Diosga rabyacurcusha.","poem":1},{"lineBreak":true},{"text":"Wamrancuna captiquipis mana yanapäshurayquinachu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chaymi nisha: ‹Paycunata manami yanapäshänachu.","poem":1},{"lineBreak":true},{"text":"Mä imamanshi chayanga.","poem":1},{"lineBreak":true},{"text":"Paycunaga fiyu runacuna, mana yäracuypaj wamracunami.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mana dios caycaptin juc dioscunata adurashpanmi rabyachiman.","poem":1},{"lineBreak":true},{"text":"Manacaj ïdulucunata adurashpanmi rabyachiman.","poem":1},{"lineBreak":true},{"text":"Nogapis paycunata rabyachishaj juc marca runacunawan.","poem":1},{"lineBreak":true},{"text":"Mana tantiyacoj runacunawanmi rabyachishaj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Cananga nina ratarejnörämi fiyupa rabyacurcushcä.","poem":1},{"lineBreak":true},{"text":"Rabyashäga chayanga pacha rurincamami.","poem":1},{"lineBreak":true},{"text":"Allpatapis micuytapis manami wayuchishächu.","poem":1},{"lineBreak":true},{"text":"Jircacunatapis rupachirmi ushashaj.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Paycunataga tucuynöpami castigashaj.","poem":1},{"lineBreak":true},{"text":"Wacpita-caypitami lëchäcunata chayachishaj.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yargaywan rupay gueshyawan wañunanpämi camacächishaj.","poem":1},{"lineBreak":true},{"text":"Fiyu gueshyami ushangapaj.","poem":1},{"lineBreak":true},{"text":"Micucoj animalcunatami, wañuchicoj culebracunatami yurichishaj.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Wamrancunatapis cällicunachömi tucsirgärenga.","poem":1},{"lineBreak":true},{"text":"Wasincunachöpis fiyupa manchariymi canga.","poem":1},{"lineBreak":true},{"text":"Wañongapämi mösupis jipashpis,","poem":1},{"lineBreak":true},{"text":"auquinpis, itipis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"« ‹Nogaga yarparä pipis mana yarpänanpaj intërupa garguriytami.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ichanga contrancuna cushipämänanta manami munashcächu.","poem":1},{"lineBreak":true},{"text":"Manami munächu paycuna alli-tucur «Tayta Diosnin chapaycaptinpis illgächishcanchi» ninanta.›","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Israelcunapaga yarpayninpis manami cannachu.","poem":1},{"lineBreak":true},{"text":"Imata rurarcaycashantapis manami tantiyannachu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Canan nishäcunata ojalä tantiyacunman ichanga.","poem":1},{"lineBreak":true},{"text":"Ushacänanpaj cashanta cuentata gocuptin allimi canman.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"¿Imanöpataj warangantin runacunata jucnaylla gaticachanman?","poem":1},{"lineBreak":true},{"text":"¿Imanöpataj chunca warangantin runacunata ishcajlla gaticachanman?","poem":1},{"lineBreak":true},{"text":"Chayno captinpis Israelcunata chayno gaticachasha imapitapis chapaj Tayta Dios","poem":1},{"lineBreak":true},{"text":"contrancunapa munayninman cachaycuptinnami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«Contranchïcunata chapäga manami noganchïta chapämajninchïnöchu.","poem":1},{"lineBreak":true},{"text":"Chaytaga quiquincunapis musyanmi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Contranchïcunaga fiyumi, wañuchicojmi,","poem":1},{"lineBreak":true},{"text":"Sodoma, Gomorra runacunanömi.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga caycan ismusha übasnömi.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Paycunapa bïnunpis wañuchicoj culebrapa benënunnömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«Tayta Diosninchi nisha: ‹Jucha rurashancunataga manami gongächu.","poem":1},{"lineBreak":true},{"text":"¿Gongaycunäpaj cashantachi yarpaycan?","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Llutanta rurashanman-tupu quiquëmi runacunataga jusgashaj.","poem":1},{"lineBreak":true},{"text":"Juchan aypämuptenga manami jananpashächu.","poem":1},{"lineBreak":true},{"text":"Ushacächinäpaj juchan aypaycämunnami.","poem":1},{"lineBreak":true},{"text":"Öran chayaycämunnami paycunata jusganäpaj.›","poem":1}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"«Acrashan runacunapa callpan manana captenga Tayta Dios yanapangami.","poem":1},{"lineBreak":true},{"text":"Payta sirbejcuna ushacänanpaj captenga cuyapangami.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Chaymi contranchïcunata Tayta Dios nenga:","poem":1},{"lineBreak":true},{"text":"‹¿Maytaj imapitapis chapäshunayquipaj yäracushayqui diosniquicuna?","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"¿Maytaj chay uywacunapa wiranta «micun» nishayqui,","poem":1},{"lineBreak":true},{"text":"bïnuta churashayquita «upun» nishayqui dioscuna?","poem":1},{"lineBreak":true},{"text":"¡Canan jatarimuchun yanapäshunayquipaj!","poem":1},{"lineBreak":true},{"text":"¡Shamuchun washäshunayquipaj!","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"¡Nogallami llapanpaj munayniyoj Dios caycä!","poem":1},{"lineBreak":true},{"text":"Nogapita mas jucga manami canchu.","poem":1},{"lineBreak":true},{"text":"Nogami munayniyoj caycä pitapis cawayta gonäpaj, wañuchinäpäpis.","poem":1},{"lineBreak":true},{"text":"Nogami pitapis gueshyachë, allchacächëpis.","poem":1},{"lineBreak":true},{"text":"Ñawëpitaga manami pipis gueshpinchu.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Imaycamapis cawaj Dios cashpämi","poem":1},{"lineBreak":true},{"text":"maquëta syëluman jogarcur jurä.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Conträcunata jusganäpaj achicyaypa achicyaycaj espädäta afilashaj.","poem":1},{"lineBreak":true},{"text":"Chiquimajcunataga llapantami castigashaj.","poem":1},{"lineBreak":true},{"text":"¡Chiquimajcunataga merësishanman-tupumi ayñita cutichishaj!","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Mandajnincunatawan suldäruncunata ushaptë","poem":1},{"lineBreak":true},{"text":"lëchäcunapis yawarllami canga.","poem":1},{"lineBreak":true},{"text":"Espädäpis aychanta cuchurmi ushanga.","poem":1},{"lineBreak":true},{"text":"Chayno wañonga guërracho pillyajcunapis prësu charisha cajcunapis.›","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"«May-chay nasyunchöpis tiyaj runacuna","poem":1},{"lineBreak":true},{"text":"Tayta Dios acrashan Israelcunawan iwal cushicuy-llapa.","poem":1},{"lineBreak":true},{"text":"Paymi ayñita cutichishpan wañuchenga sirbejnincunata wañuchishanpita.","poem":1},{"lineBreak":true},{"text":"Acrashan runacuna cushisha cawananpämi","poem":1},{"lineBreak":true},{"text":"tiyashan nasyunninta limyuyächenga.»","poem":1}]},{"type":"heading","content":["Ushananta Moisés willapashan"]},{"type":"verse","number":44,"content":["Chay birsutami Nunpa wamran Josuëwan aywaycur Moisés llapan Israelcunata liguiparan."]},{"type":"verse","number":45,"content":["Liguipayta usharcur Israelcunata"]},{"type":"verse","number":46,"content":["niran: «Canan willapashäcunata sumaj yarpachacuy. Yachachishä laycunata cumlinanpaj wamrayquicunata willapay."]},{"type":"verse","number":47,"content":["Cay laycunataga manami yangallapächu yachachishcä, man'chäga chaycunata cumlir alli cawayta tarinayquipämi. Chay laycunata cumlerga Jordán mayuta chimparcur partisyun chacrata chasquir allimi cawanquipaj.»"]},{"type":"heading","content":["Tayta Dios aunishan nasyunta Moisés ricashan"]},{"type":"verse","number":48,"content":["Chay junajllami Moisesta Tayta Dios niran:"]},{"type":"verse","number":49,"content":["«Moab nasyuncho caycaj Abarim jircacunapa aywar Nebo puntaman wichay. Chayga caycan Jericó siudä chimpanchömi. Chay puntapitami ricanqui Israel runacunata goycunäpaj caycaj Canaán nasyunta."]},{"type":"verse","number":50,"content":["Wauguiqui Aarón Hor puntacho wañushpan unay wañoj famillyayquicunawan tincoj aywacushannömi gampis Nebo puntaman wicharcur wañushpayqui famillyayquicunawan tincoj aywacunquipaj."]},{"type":"verse","number":51,"content":["Gamga wauguiqui Aaronwan ishcaniquimi Israelcunapa ñaupancho mana wiyacamarayquichu. Chayno rurarayqui Zin jutiyoj chunyaj Meriba-cades yacu llojshimojchömi. Israelcunapa ñaupancho gamcunaga manami rispitamarayquichu."]},{"type":"verse","number":52,"content":["Chaypitami gamga Israelcunata goycunäpaj caycaj nasyunta carullapitana ricärinquipaj. Chay nasyunman ichanga gam mana yaycunquipänachu.»"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Jesurún ninanga alli runa ninanmi. Chay jutiwanpis Israel runacunapämi niran.","reference":{"chapter":32,"verse":15}}]},"thisChapterLink":"/api/qub_wbt/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}