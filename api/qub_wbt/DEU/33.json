{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"DEU","translationId":"qub_wbt","name":"DEUTERONOMIO","commonName":"DEUTERONOMIO","title":"Deuteronomio","order":5,"numberOfChapters":34,"sha256":"9c49a4a6b4fd3570d35995326438062bcb6dbae5b491ac5fe1046ed287d06f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/qub_wbt/DEU/34.json","totalNumberOfVerses":958},"chapter":{"number":33,"content":[{"type":"heading","content":["Israel trïbu runacunata Moisés bindisyunta goshan"]},{"type":"verse","number":1,"content":["Moisestaga Tayta Diosmi acraran. Paymi wañunanpaj wallcallana pishiycaptin Israelcunata bindisyunta gor"]},{"type":"verse","number":2,"content":["cayno niran:",{"text":"«Tayta Diosga Sinaïpitami shamusha.","poem":1},{"lineBreak":true},{"text":"Seirpita-pachami achquipämashcanchïpis.","poem":1},{"lineBreak":true},{"text":"Parán jircapitami achicyaypa achicyämuran.","poem":1},{"lineBreak":true},{"text":"Waranganpa waranganpa anjilnincunawanmi shamusha.","poem":1},{"lineBreak":true},{"text":"Derëchu caj maquinpitaga ninanörämi layninpis yargamusha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diosga cuyanmi acrashan caj runacunata.","poem":1},{"lineBreak":true},{"text":"Pay munashanno cawajcunataga imapitapis chapanmi.","poem":1},{"lineBreak":true},{"text":"Chayno cawaj runacunaga Diospa ñaupanman gongurpacun.","poem":1},{"lineBreak":true},{"text":"Chaychömi tantiyachishancunata chasquicun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Moisesmi laycunataga willapämashcanchi.","poem":1},{"lineBreak":true},{"text":"Chay laycunaga Jacobpita mirar aywaj cajcunapa erensyannömi caycan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jesurún Tayta Diosta chasquiran raynin cananpaj.»","poem":1}]},{"type":"verse","number":6,"content":["Rubén trïbu runacunapaj niran:",{"text":"«¡Wallcajlla carpis Rubén trïbu runacunaga ama ushacächunchu!»","poem":1}]},{"type":"verse","number":7,"content":["Judá trïbu runacunapämi niran:",{"text":"«Judá runacuna mañacamushanta wiyaycullay ari Tayta Dios.","poem":1},{"lineBreak":true},{"text":"Paycunataga mashtacaptinpis juc pachallaman shuntaycuy.","poem":1},{"lineBreak":true},{"text":"Munayniyoj cayniquiwan paycunata washaycuy ari.","poem":1},{"lineBreak":true},{"text":"Contrancunata binsinanpaj yanapaycullay.»","poem":1}]},{"type":"verse","number":8,"content":["Leví trïbu runacunapämi niran:",{"text":"«Tayta Dios, Israelcunataga Masah partichömi musyaparayqui.","poem":1},{"lineBreak":true},{"text":"Meribachömi paycunawan rimanacurayqui.","poem":1},{"lineBreak":true},{"text":"Nishayquita wiyacoj Leví trïbu runacunatami ichanga","poem":1},{"lineBreak":true},{"text":"Tumimtawan Urimta aptapashcanqui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Paycunaga nishayquita llapantami cumliran.","poem":1},{"lineBreak":true},{"text":"Conträtu rurashayquinöllami cawarcaycan.","poem":1},{"lineBreak":true},{"text":"Maman-taytanta, wauguincunata, wamrancunata cuyashanpitaga","poem":1},{"lineBreak":true},{"text":"masmi gamta cuyashunqui Tayta Dios.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paycunaga Jacobpita miraj Israelcunatami layniquicunata yachachin.","poem":1},{"lineBreak":true},{"text":"Ñaupayquichömi insinsuta rupachin.","poem":1},{"lineBreak":true},{"text":"Altarchömi rupachina sacrifisyucunata rupachin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Dios, paycuna sumaj sirbishunayquipaj yanapaycullay.","poem":1},{"lineBreak":true},{"text":"Paycuna rurashanga shonguyquipäno caycullächun.","poem":1},{"lineBreak":true},{"text":"Chiquejcuna yarpashanta ichanga manacajman churaycullay.","poem":1},{"lineBreak":true},{"text":"Amana contran jatarichunnachu.»","poem":1}]},{"type":"verse","number":12,"content":["Benjamín trïbu runacunapämi niran:",{"text":"«Tayta Dios cuyashancunaga mana yarpachacuypami goyanga.","poem":1},{"lineBreak":true},{"text":"Paymi imaycamapis chapanga.","poem":1},{"lineBreak":true},{"text":"Maquillanchömi imaypis chararanga.»","poem":1}]},{"type":"verse","number":13,"content":["José trïbu runacunapämi niran:",{"text":"«Paycunapa chacranmanga Tayta Dios bindisyunta churaycuchun.","poem":1},{"lineBreak":true},{"text":"Tamyata tamyachimuchun.","poem":1},{"lineBreak":true},{"text":"Yacutapis pashtachimuchun pargunanpaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Micuynincunapis timpuncho wiñamuptin","poem":1},{"lineBreak":true},{"text":"alli poguypa poguchichun.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lömacunachöpis allinnin caj micuy wayuchun.","poem":1},{"lineBreak":true},{"text":"Jircancunachöpis aypallata cusichachun.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chacrancunapis alli chacra cachun.","poem":1},{"lineBreak":true},{"text":"Micuyninpis alli wayuchun.","poem":1},{"lineBreak":true},{"text":"Josëta bindisyunta gochun rataycaj shiracho yuripäcoj Tayta Dios.","poem":1},{"lineBreak":true},{"text":"Llapanpis Josëpäga alli cachun.","poem":1},{"lineBreak":true},{"text":"Paytaga llapan wauguincunapitami acraran.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"José trïbu runacunaga wäcapa rimir caj","poem":1},{"lineBreak":true},{"text":"wawan maucha cashan törunömi caycan.","poem":1},{"lineBreak":true},{"text":"Callpayoj cayninpis chucaru törunömi.","poem":1},{"lineBreak":true},{"text":"Callpayoj cayninpami may-chay nasyun runacunatapis binsir manchachenga.","poem":1},{"lineBreak":true},{"text":"Chaynömi canga yupaytapis mana atipaypaj Efraín runacunaga.","poem":1},{"lineBreak":true},{"text":"Chaynömi canga waranganpa waranganpa Manasés runacunapis.»","poem":1}]},{"type":"verse","number":18,"content":["Zabulón trïbu runacunapaj Isacar trïbu runacunapaj niran:",{"text":"«Zabulón runacuna maypapis purir cushicuy.","poem":1},{"lineBreak":true},{"text":"Gamcunapis Isacar runacuna witichinalla tolduyquicunacho goyar cushicuy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Paycunaga juc-lä runacunatami puntaman gayangapaj.","poem":1},{"lineBreak":true},{"text":"Chay runacunawanna Tayta Diospaj uywacunata pishtanga.","poem":1},{"lineBreak":true},{"text":"Lamarcho ima-aycapis bälejcuna cajwan rïcuyarmi cushisha goyanga.»","poem":1}]},{"type":"verse","number":20,"content":["Gad trïbu runacunapämi niran:",{"text":"«Tayta Diosga alabasha caycullächun.","poem":1},{"lineBreak":true},{"text":"Paymi Gad runacunapa chacrancuna mas achca cananpaj yanaparan.","poem":1},{"lineBreak":true},{"text":"Gad runacunaga wawayoj liyun lätacuycur cäsajnömi caycan.","poem":1},{"lineBreak":true},{"text":"Chaymi charishan runapa ricranta, umantapis rachirin.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Paycunaga allinnin caj chacracunatami charicurcusha.","poem":1},{"lineBreak":true},{"text":"Paycunapa chacrancunaga suldärucunapa mandajnincuna allinnin caj chacrata chasquishannömi caycan.","poem":1},{"lineBreak":true},{"text":"Gad runacunami waquin Israel famillyata yanapar ñaupa-puntata aywaran.","poem":1},{"lineBreak":true},{"text":"Paycunaga llapantapis Tayta Dios willapashannöllami cumlisha.","poem":1},{"lineBreak":true},{"text":"Israel trïbucunachöga Dios munashallantami rurasha.»","poem":1}]},{"type":"verse","number":22,"content":["Dan trïbu runacunapämi niran:",{"text":"«Dan runacunaga caycan manta liyun","poem":1},{"lineBreak":true},{"text":"Basán partipita pintimojnömi.»","poem":1}]},{"type":"verse","number":23,"content":["Neftalí trïbu runacunapaj niran:",{"text":"«Neftalí runacunataga Tayta Dios cuyanmi.","poem":1},{"lineBreak":true},{"text":"Paycunataga achca bindisyuntami gosha.","poem":1},{"lineBreak":true},{"text":"¡Lamarpita chunyajcamami chacranpis caycan!»","poem":1}]},{"type":"verse","number":24,"content":["Aser trïbu runacunapaj niran:",{"text":"«Jacobpita miraj waquin trïbucunano paycunapis bindisyunta chasquichun.","poem":1},{"lineBreak":true},{"text":"Waquin trïbucunapis Aserta cuyachun.","poem":1},{"lineBreak":true},{"text":"Chaquincunatapis ushmananpaj olivo asëti puchuy-puchuy caycullächun.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Siudä puncunpa rancancunapis fyërrupita, runsipita caycullächun.","poem":1},{"lineBreak":true},{"text":"Callpancunapis wañushanyaj ama ushacächunchu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«Jesurunpa Diosninnöga manami ima dioscunapis canchu.","poem":1},{"lineBreak":true},{"text":"Payga yanapäshunayquipaj shamun pucutay janallanpami.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Imaypis cawaj Tayta Diosmi munayninwan gamcunataga chapäshunqui.","poem":1},{"lineBreak":true},{"text":"Paymi chiquishojcunatapis ñaupayquipita gargusha.","poem":1},{"lineBreak":true},{"text":"Chayno gargushpan ushacächinayquipämi nishunqui.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Israelcunaga Tayta Diospa munaynincho carmi alli goyäconga.","poem":1},{"lineBreak":true},{"text":"Mirar aywaj wamrancunapis allimi goyäconga.","poem":1},{"lineBreak":true},{"text":"Chacrancunachöpis rïguwan übasga fiyupami wayonga.","poem":1},{"lineBreak":true},{"text":"Paycuna tiyashanmanga tamyapis timpunchömi tamyanga.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Israelcuna cushicäriy.","poem":1},{"lineBreak":true},{"text":"¿Picunaräshi gamcunamanga tincunman?","poem":1},{"lineBreak":true},{"text":"Tayta Dios quiquinmi gamcunataga salbashunqui.","poem":1},{"lineBreak":true},{"text":"Paymi imapitapis chapäshushpayqui yanapäshunqui.","poem":1},{"lineBreak":true},{"text":"Paymi contrayquicunatapis binsëshishunquipaj.","poem":1},{"lineBreak":true},{"text":"Chiquishojcunataga ushajpämi wañuchinquipaj.","poem":1},{"lineBreak":true},{"text":"Alli-tucuycajtami manacajman churanquipaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}