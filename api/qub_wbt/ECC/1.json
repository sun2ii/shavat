{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ECC","translationId":"qub_wbt","name":"ECLESIASTÉS","commonName":"ECLESIASTÉS","title":"Eclesiastés","order":21,"numberOfChapters":12,"sha256":"58b5979752c87588b6338d35be0b655e0e67ec1f45ac6135bb8549360a1c6a22","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/qub_wbt/ECC/12.json","totalNumberOfVerses":219},"chapter":{"number":1,"content":[{"type":"heading","content":["Llapanpis yangalla cashan"]},{"type":"verse","number":1,"content":["Cayga caycan yachachicoj isquirbishanmi. Payga caran Davidpa wamranmi. Paymi Jerusalencho ray caran."]},{"type":"verse","number":2,"content":[{"text":"Noga yachachichöga në:","poem":1},{"lineBreak":true},{"text":"¡Llapanpis yangallami! ¡Yangallami!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Imataraj jorgun runaga cay pachacho may-jina ñacar arurpis?","poem":1},{"lineBreak":true},{"text":"Manami imatapis jorgunchu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Runaga yuriycan, y wañuycan.","poem":1},{"lineBreak":true},{"text":"Cay pachami ichanga imaypis mana rucanchu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Intipis yagarcamun, yagacurcun.","poem":1},{"lineBreak":true},{"text":"Yapay yagarcamun yapay yagacurcun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wayraga yaparir yaparirmi wayraycan.","poem":1},{"lineBreak":true},{"text":"Wayra sur caj lädupa wayran.","poem":1},{"lineBreak":true},{"text":"Nircorga norte caj lädupana tumamun.","poem":1},{"lineBreak":true},{"text":"Imaypis chaynöllami wayraga wayraycan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mayucunaga llapan aywar chayaycan lamarllaman.","poem":1},{"lineBreak":true},{"text":"Chaypis lamarga manami imaypis juntamunchu.","poem":1},{"lineBreak":true},{"text":"Mayucunaga cutin llojshimushanman","poem":1},{"lineBreak":true},{"text":"imaypis aywashanno yapay aywananpaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Llapanpis fiyupami uticächicun.","poem":1},{"lineBreak":true},{"text":"Runaga imanöpa tantiyachiytapis manami puydinmanchu.","poem":1},{"lineBreak":true},{"text":"Chaypis runaga mana yamacaypami ricaycan;","poem":1},{"lineBreak":true},{"text":"mana yamacaypami wiyaycan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Unay cashanga yapaymi canga.","poem":1},{"lineBreak":true},{"text":"Unay ruracashanga yapaymi ruracanga.","poem":1},{"lineBreak":true},{"text":"Cay pachachöga manami imapis canchu mushojraj yurimöga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Waquenga nenga:","poem":1},{"lineBreak":true},{"text":"«¡Caymi ichanga imaypis mana cashan!» nir.","poem":1},{"lineBreak":true},{"text":"Chaypis maynami caran","poem":1},{"lineBreak":true},{"text":"manaraj noganchi cashanchi wichan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Unay cashancunataga gongaycärishami.","poem":1},{"lineBreak":true},{"text":"Chaynöllami canan caycajtapis shamoj watacunachöga gongayconga.","poem":1},{"lineBreak":true},{"text":"Guepata yurej cajtapis mas guepa runacuna gongaycongami.","poem":1}]},{"type":"heading","content":["Yachachicojta imapis päsashancuna"]},{"type":"verse","number":12,"content":["Noga yachachicöga Jerusalenchömi Israelcunapa raynin carä."]},{"type":"verse","number":13,"content":["Nogaga cay pachacho imano goyashallanchïtapis sumaj musyanäpaj estudyarä. Alli tantiyanäpaj llapan shongöpa estudyarä. Tayta Diosmi camacächisha chayno estudyananchïpaj. Runacunapäga chay estudyu fiyupa sasami caycan."]},{"type":"verse","number":14,"content":["Chaymi tantiyacushcä llapanpis cay pachacho rurashanchëga manacajllapaj cashanta. Wayrata chariyta munajnöllami caycanchi."]},{"type":"verse","number":15,"content":[{"text":"Wicsushatapis manami allchayta camäpacunchïnachu.","poem":1},{"lineBreak":true},{"text":"Mana captinnaga manami yupashwannapischu.","poem":1}]},{"type":"verse","number":16,"content":["Shongullächo yarparä: «Canan nogaga sumaj yachajmi cä. Ñaupäta Jerusalencho caj raycunapita masmi musyaj yachaj cä» nir."]},{"type":"verse","number":17,"content":["Llapan shongöpami yachaj canäpaj estudyashcä. Llutan ruraycuna imano cashantapis estudyashcä. Ichanga chaycunapis caycan wayrata chariyta munashanchïnöllami."]},{"type":"verse","number":18,"content":["Rasunpaga",{"text":"mas yachaj carga masmi uma nanayta tarenga.","poem":1},{"lineBreak":true},{"text":"Mas yacharga masmi ñacanpis.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}