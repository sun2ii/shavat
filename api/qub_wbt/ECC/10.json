{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ECC","translationId":"qub_wbt","name":"ECLESIASTÉS","commonName":"ECLESIASTÉS","title":"Eclesiastés","order":21,"numberOfChapters":12,"sha256":"58b5979752c87588b6338d35be0b655e0e67ec1f45ac6135bb8549360a1c6a22","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/qub_wbt/ECC/12.json","totalNumberOfVerses":219},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Wañusha chinrasllapis asyarerga alli perfümita pirdichinmi.","poem":1},{"lineBreak":true},{"text":"Chaynömi mana tantiyajpis yachaj rurashanta pirdichin.","poem":1},{"lineBreak":true},{"text":"Rispitasha caycajtapis manacajman churan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yachaj runaga allillatami yarpan.","poem":1},{"lineBreak":true},{"text":"Mana tantiyacoj upa runami ichanga mana allicunallapaj yarpan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mana tantiyacoj upaga llapan rurashanchöpis","poem":1},{"lineBreak":true},{"text":"tantiyachicun manacajpaj yarpashantami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gampaj mandaj rabyacurcuptinpis ruranayquipaj caycajtaga ama cachaycuychu.","poem":1},{"lineBreak":true},{"text":"Pasinsacorga rabyasha caycajtapis gasacächinmi.","poem":1}]},{"type":"verse","number":5,"content":["Cay pachachöga juctapis mana allita ricashcämi. Chaytaga quiquin mandajcunami ruran."]},{"type":"verse","number":6,"content":["Mana tantiyajcunatami churan mas mandaj cananpaj. Mas mandajpaj alli cajcunatanami churan tacsha mandajlla cananpaj."]},{"type":"verse","number":7,"content":["Ricashcämi uyway runacuna muntädulla purejta. Rispitädu runacunatapis ricashcämi uyway runacunano chaquillapa puriycajta."]},{"type":"verse","number":8,"content":[{"text":"Pipis uchcuta uchcoj cäga","poem":1},{"lineBreak":true},{"text":"chaymanmi yaganga.","poem":1},{"lineBreak":true},{"text":"Pipis curral pergata ojtej cajtaga","poem":1},{"lineBreak":true},{"text":"culebrami cañenga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pipis rumita llagllajtaga","poem":1},{"lineBreak":true},{"text":"rumi paquirmi llawarenga.","poem":1},{"lineBreak":true},{"text":"Pipis yantata chejtaj cäga","poem":1},{"lineBreak":true},{"text":"quiquinpis riscumi mutucuycunan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jächa laguyajta","poem":1},{"lineBreak":true},{"text":"yapay mana afilashpanga","poem":1},{"lineBreak":true},{"text":"callpaycur-rämi mutonga.","poem":1},"Chaynömi sumaj yarpachacurcur ruraptenga llapanpis allilla canga."]},{"type":"verse","number":11,"content":[{"text":"Upayächiyta yachajpis manami allinachu","poem":1},{"lineBreak":true},{"text":"manaraj upayächiptin culebra cañiycuptenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yachajcuna rimashanga maysi wiyacuyllami.","poem":1},{"lineBreak":true},{"text":"Mana tantiyacojcunami ichanga quiquinpa contrallanpaj rimanpis.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Paycunaga gallaycunanpita-pacha ushanancamapis","poem":1},{"lineBreak":true},{"text":"parlan mana camacajcunallata.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chay runacunaga mana ushaypami parlan.","poem":1},{"lineBreak":true},{"text":"Shamoj watacunacho imapis päsananpaj cajta pipis mana musyaycaptenga","poem":1},{"lineBreak":true},{"text":"¿piraj ninman imapis päsananpaj cajta?","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mana tantiyaj upa runaga fiyupa ñacarpis yangami arun.","poem":1},{"lineBreak":true},{"text":"Chaymi mana musyanchu siudäman maypa yaycuna cashallantapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Juc nasyunpa wamralla raynin captenga,","poem":1},{"lineBreak":true},{"text":"mandäshejnincunapis upullar micullar cacuptenga fiyupa llaquipaypämi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fiyupa allichömi canga juc nasyunpa","poem":1},{"lineBreak":true},{"text":"mandajnin alli captenga.","poem":1},{"lineBreak":true},{"text":"Chaychöga mandäshejnincunapis callpan cananpämi micunan öra micun.","poem":1},{"lineBreak":true},{"text":"Manami upyallar cacunchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Guella runapaga wasinpa jananpis ushacanmi.","poem":1},{"lineBreak":true},{"text":"Imatapis mana arojpa mana ruracojpaga wasinpis tuninmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Paycunaga alli micuyta rurachin cushicur micunanpaj.","poem":1},{"lineBreak":true},{"text":"Bïnupis caycan cushisha upunanpaj.","poem":1},{"lineBreak":true},{"text":"Guellay captenga llapanpis canmi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ni shongullayquichöpis raytaga ama jamurpaychu.","poem":1},{"lineBreak":true},{"text":"Ni japallayqui caycashpayquipis rïcupa washanga ama rimaychu.","poem":1},{"lineBreak":true},{"text":"Musyashayquinöpis äbicuna buylanmi.","poem":1},{"lineBreak":true},{"text":"Chaycunaga aywar willaycunmanmi.","poem":1}]},{"type":"line_break"}],"footnotes":[]}