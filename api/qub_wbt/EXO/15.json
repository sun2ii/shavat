{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"EXO","translationId":"qub_wbt","name":"ÉXODO","commonName":"ÉXODO","title":"Éxodo","order":2,"numberOfChapters":40,"sha256":"4611672b9adb7c7b2e0aec3b2144d396b94d8cd472621b2956a88afe9b2188c6","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/qub_wbt/EXO/40.json","totalNumberOfVerses":1204},"chapter":{"number":15,"content":[{"type":"heading","content":["Moisés cantashan"]},{"type":"verse","number":1,"content":["Chaypita Moisesga llapan Israelcunawan Tayta Diosta alabar cantaran. Chay cantashan caynömi niycaran:",{"text":"«Tayta Diosta alabashpämi cantashaj","poem":1},{"lineBreak":true},{"text":"munayniyoj cayninwan binsishanpita.","poem":1},{"lineBreak":true},{"text":"Payga cawallucunatami, muntädu aywajcunatami","poem":1},{"lineBreak":true},{"text":"lamarman garpurisha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Diosmi imapitapis chapämaj, salbamaj.","poem":1},{"lineBreak":true},{"text":"Chaymi payllapaj cantä.","poem":1},{"lineBreak":true},{"text":"Payta alabä Diosnë captinmi.","poem":1},{"lineBreak":true},{"text":"Payta adurä unay caj famillyäcunapapis Diosnin captinmi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diosga guërracho pillyay yachajmi.","poem":1},{"lineBreak":true},{"text":"Paypaga jutinpis Tayta Diosmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Tayta Diosga faraonpa suldäruncunatami, carrëtancunatami","poem":1},{"lineBreak":true},{"text":"lamarman garpurisha.","poem":1},{"lineBreak":true},{"text":"Mas mijur suldäruncunapis","poem":1},{"lineBreak":true},{"text":"Puca lamarchömi shengaypa wañusha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ruminömi ruricama yagacarpusha.","poem":1},{"lineBreak":true},{"text":"Jundu lamarmi ultacurcusha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Tayta Dios, maquiqui fiyupa munayniyojmi.","poem":1},{"lineBreak":true},{"text":"Chaywanmi llapan chiquimajcunata illgarachishcanqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gamga fiyupa munayniquiwanmi contrayqui jatarejcunata usharishcanqui.","poem":1},{"lineBreak":true},{"text":"Rabyacurcurmi ogshata nina ushacurcojnöpis illgarachishcanqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pücariptiqui yacu shuntacäcusha.","poem":1},{"lineBreak":true},{"text":"Yaculla caycashpanpis tapya ichiraycajno ricacusha.","poem":1},{"lineBreak":true},{"text":"Mas jundunnincho caj yacucunapis tinticäcusha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chiquimajcunaga caynömi yarparan:","poem":1},{"lineBreak":true},{"text":"‹Gatishaj taripanäcama.","poem":1},{"lineBreak":true},{"text":"Llapan apaycashancunatapis guechurcurmi raquipänacushaj.","poem":1},{"lineBreak":true},{"text":"Sablëwanmi ushajpaj wañuchishaj› nir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ichanga lamarta gam pücariptiqui","poem":1},{"lineBreak":true},{"text":"ushajpämi lamar ultacurcusha.","poem":1},{"lineBreak":true},{"text":"Yacu bötiypa bötiycajman plömunömi yagacarpusha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Tayta Dios, maygan dioscunapis gammanga manami tincunchu.","poem":1},{"lineBreak":true},{"text":"Gamno santuga manami juc canchu.","poem":1},{"lineBreak":true},{"text":"Gamno munayniyöga manami juc canchu.","poem":1},{"lineBreak":true},{"text":"Gamga fiyupa almiraypajcunatami rurashcanqui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Maquiquiwan ayparcamuptiqui","poem":1},{"lineBreak":true},{"text":"chiquimajcunataga pachami ultacurcusha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Jorgushayqui runacunataga cuyapashpayquimi pushaycanqui.","poem":1},{"lineBreak":true},{"text":"Munayniquiwanmi tiyashayqui rispitädu pachaman pushaycanqui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chayta mayarga waquin nasyuncho tiyajcunapis fiyupami mancharenga.","poem":1},{"lineBreak":true},{"text":"Filistea runacunapis mancharir almaynajmi ricaconga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Edom runacunapa mandajnincunapis mancharir callpaynajmi ricacongapaj.","poem":1},{"lineBreak":true},{"text":"Moab runacunapa mandajninpis mancharir sicsicyangami.","poem":1},{"lineBreak":true},{"text":"Cananeo runacunapis mancharishpanmi ima ruraytapis mana camäpacongachu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Paycunaga fiyupa munayniquiwanmi mancharishpan upatasha ricaconga.","poem":1},{"lineBreak":true},{"text":"Ruminöpis chiyacäconga acrashayqui runacuna päsacurinancama.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Dios, Israelcunataga gammi pushanquipaj tiyanayquipaj acrashayqui puntaman.","poem":1},{"lineBreak":true},{"text":"Tiyanayquitaga quiquiquimi camarishcanqui.","poem":1},{"lineBreak":true},{"text":"Chaychömi imaycamapis tiyachinquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Tayta Dios gamllami imaycamapis mandaycanquipaj.»","poem":1}]},{"type":"heading","content":["María cantashan"]},{"type":"verse","number":19,"content":["Carrëtancunawan cawalluncunawan faraonpa suldäruncuna lamar chaupinta aywaycaptin Tayta Dios lamar yacuta cashganman cutichir ñiticarpachiran. Israelcunami ichanga päsaran chaqui allpapa."]},{"type":"verse","number":20,"content":["Chaypitami Aaronpa pañin profetïsa Mariaga panderëtallanpawan cantaran. Chaura llapan warmicunapis cushicushpan gallaycuran panderëtata awishpan dansayta."]},{"type":"verse","number":21,"content":["Caynömi María cantaran:",{"text":"«Tayta Diosta alabar cantay munayniyoj cayninwan binsishanpita.","poem":1},{"lineBreak":true},{"text":"Payga cawallucunatami, muntädu aywajcunatami lamarman garpurisha.»","poem":1}]},{"type":"heading","content":["Ashgaj yacuta alli yacumanna Tayta Dios ticrachishan"]},{"type":"verse","number":22,"content":["Chaypitanaga Israelcunata Puca Lamarpita Moisés pushacuran. Chaura aywacuran Shur jutiyoj chunyaj chaqui jircapa. Quimsa junajna aywarpis yacuta mana tariranchu."]},{"type":"verse","number":23,"content":["Chaypita chayaran Mara jutiyoj partiman. Chaycho yacu caycajtaga asgaptin mana upuranchu. Chayno yacu asgashanpitami chay partipa jutinta churaparan Mara",{"noteId":6},"nir."]},{"type":"verse","number":24,"content":["Chaura runacunaga Moisespa washan rimaran «Cananga ¿imataraj upushun?» ninacur."]},{"type":"verse","number":25,"content":["Chaura Moisesga Tayta Diosta mañacuran yanapänanpaj. Mañacuptin Tayta Diosga juc yörata ricachiran. Chayta Moisés yacuman jitarpuran. Chaura yacuga upunanpaj allina ticracuriran. Chaychömi Tayta Diosga Israelcuna imano cawananpäpis laycunata willaparan. Wiyacunanpaj cashanta mana wiyacunanpaj cashantapis paycunata mayaparan."]},{"type":"verse","number":26,"content":["Paycunata niran: «Wiyacamaptiquega, munashänölla cawaptiquega, laynëcunata cumliptiquega Egiptucunata castigar gueshyawan charichishäno manami castigashayquipächu. Nogami cä Tayta Diosniqui, imapitapis allchacächej.»"]},{"type":"verse","number":27,"content":["Chaypita päsar chayaran Elim partiman. Chaycho caran chunca ishcay (12) pashtaj yacu, ganchis chunca (70) palmëra yöracuna. Chay yacu ñaupanmanmi tolduncunata ichichiran."]}],"footnotes":[{"noteId":6,"caller":"+","text":"Mara ninanga ashgaj ninanmi.","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/qub_wbt/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}