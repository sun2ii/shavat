{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"EZK","translationId":"qub_wbt","name":"EZEQUIEL","commonName":"EZEQUIEL","title":"Ezequiel","order":26,"numberOfChapters":48,"sha256":"c3b2a9a3fdc16fb385563372344cbf0b03e5cdbd5072e29cebeb4feff239700e","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/qub_wbt/EZK/48.json","totalNumberOfVerses":1249},"chapter":{"number":15,"content":[{"type":"heading","content":["Israelta manacajlla übasman tincuchishan"]},{"type":"verse","number":1,"content":["Tayta Dios nimaran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Runa, ¿übas yörapa tullun imallapäga allichuraj?","poem":1},{"lineBreak":true},{"text":"¿Waquin guerucunapita mas allichuraj caycan?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tullonga manami imapäpis allichu.","poem":1},{"lineBreak":true},{"text":"¡Manami allichu waguicuna istägata ruranallapäpis!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yantallapämi alli.","poem":1},{"lineBreak":true},{"text":"Garancunata nina rupar ushacurcuptin","poem":1},{"lineBreak":true},{"text":"shongonga carbunyashanami caycan.","poem":1},{"lineBreak":true},{"text":"Chaura imapäpis manami allinachu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Manaraj rupachisha caycällar","poem":1},{"lineBreak":true},{"text":"imapäpis mana alli caycarga","poem":1},{"lineBreak":true},{"text":"piyurnachari rupasha carnaga","poem":1},{"lineBreak":true},{"text":"imapäpis mana bälejna canga.","poem":1}]},{"type":"verse","number":6,"content":["«Chaypitami, noga Tayta Dios cayno në: Imanömi übas yörapa tulluntapis ninaman rupachin, chaynömi Jerusalén runacunatapis ninaman gaycushaj."]},{"type":"verse","number":7,"content":["Nogami paycunapa contran ricacushaj. Juc ninapita gueshpiptinpis juc ninanami rupacurconga. Paycunapa contran ricacuptërämi gamcunaga musyanquipaj noga Tayta Dios cashäta."]},{"type":"verse","number":8,"content":["Nogata mana sirbimashanpitami nasyunnintaga ticrarachishaj pasaypa chunyajman. Noga Tayta Diosmi chayno në.»"]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/EZK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/EZK/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/EZK/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}