{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"EZK","translationId":"qub_wbt","name":"EZEQUIEL","commonName":"EZEQUIEL","title":"Ezequiel","order":26,"numberOfChapters":48,"sha256":"c3b2a9a3fdc16fb385563372344cbf0b03e5cdbd5072e29cebeb4feff239700e","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/qub_wbt/EZK/48.json","totalNumberOfVerses":1249},"chapter":{"number":19,"content":[{"type":"heading","content":["Israelpa raynincunapaj llaquicushan"]},{"type":"verse","number":1,"content":["«Israelpa raynincunapaj gamga wañupacuycho cantanata cantay. Cayno cantay:"]},{"type":"verse","number":2,"content":[{"text":"«Mamayquega liyuncunapa chaupinchömi tiyasha.","poem":1},{"lineBreak":true},{"text":"Chaychömi wawancunatapis uywasha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Juc wawallantami mas alli gueshpichisha jatun canancama.","poem":1},{"lineBreak":true},{"text":"Cäsata chariyta yachacuycuran.","poem":1},{"lineBreak":true},{"text":"Chaypitanaga runata micuytana gallaycuran.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayno ruraycashantami juc-lä nasyuncuna mayaran.","poem":1},{"lineBreak":true},{"text":"Chaymi uchcuman garpuycur chariran.","poem":1},{"lineBreak":true},{"text":"Nircorga aushiwan Egipto nasyuncama apasha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaura maman liyonga shuyarayta yamacarna,","poem":1},{"lineBreak":true},{"text":"yarpashanno mana captin","poem":1},{"lineBreak":true},{"text":"jucaj wawantana ruquin churasha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chay liyunpis jatunna carga waquin liyuncunawan","poem":1},{"lineBreak":true},{"text":"iwalna aywaj y cutimoj.","poem":1},{"lineBreak":true},{"text":"Chayno puriycashancho quiquillan cäsacuyta yachacuycuran.","poem":1},{"lineBreak":true},{"text":"Runata micuytapis yachacuycuran.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Palasyucunachöpis llapanta illgächiran.","poem":1},{"lineBreak":true},{"text":"Siudäcunachöpis tucuy mana allita ruraran.","poem":1},{"lineBreak":true},{"text":"Gaparashpanga pï-maytapis mancharachej.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaura bisïnun marcacunacho tiyajcunaga paypa contranna jatariran.","poem":1},{"lineBreak":true},{"text":"Chaymi trampata churaparan.","poem":1},{"lineBreak":true},{"text":"Chaynöpami uchcuman garpuycur chariran.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aushiwan aparcur jaulaman wichgaycusha.","poem":1},{"lineBreak":true},{"text":"Nircorga Babiloniapa rayninmanna apapasha.","poem":1},{"lineBreak":true},{"text":"Babiloniachönami carsilman wichgasha","poem":1},{"lineBreak":true},{"text":"Israel jircacunacho gaparar purejta pipis manana wiyananpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Mamayquega casha yacu aywaycajpa läduncho","poem":1},{"lineBreak":true},{"text":"übas lanta alli wayunanpaj, rämasapa caycajnömi.","poem":1},{"lineBreak":true},{"text":"Payga caycaran übaspa sapinta achca yacu ushmashannömi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rämancuna alli wiñar sinchi caran.","poem":1},{"lineBreak":true},{"text":"Chaymi waquin rämancunaga raypa bäranpäraj caranpis.","poem":1},{"lineBreak":true},{"text":"Fiyupa wiñaycällar pucutaycama chayaran.","poem":1},{"lineBreak":true},{"text":"Pï-maypis rejsiran jatun cayninpa,","poem":1},{"lineBreak":true},{"text":"cupösu rämayoj cayninpa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ichanga rabyawan achuriycärir pampaman jitariran.","poem":1},{"lineBreak":true},{"text":"Inti yagamunan caj lädupita wayra shamojna chaquirachiran.","poem":1},{"lineBreak":true},{"text":"Chauraga wayuyninpis shicwacuranna.","poem":1},{"lineBreak":true},{"text":"Sinchi rämancunapis chaquicäcuran.","poem":1},{"lineBreak":true},{"text":"Chaura ninamanna waycuycäriran.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Cananga chunyaj chaqui parti","poem":1},{"lineBreak":true},{"text":"yacu mana cashanchömi yacunaypita lantaraycan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rämancunapitana nina ratataycaj llojshiycan.","poem":1},{"lineBreak":true},{"text":"Chay ninanami rupaycan chillguipancunatawan, wayuynintaga.","poem":1},{"lineBreak":true},{"text":"Raypa bäranpäno sinchi rämancunaga manami cannachu.","poem":1},"«Cayga caycan wañupacuycho cantanami. Chaymi llapan cumliptenga cay cantanata cantangapaj.»"]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}