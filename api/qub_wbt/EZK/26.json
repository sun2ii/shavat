{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"EZK","translationId":"qub_wbt","name":"EZEQUIEL","commonName":"EZEQUIEL","title":"Ezequiel","order":26,"numberOfChapters":48,"sha256":"c3b2a9a3fdc16fb385563372344cbf0b03e5cdbd5072e29cebeb4feff239700e","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/qub_wbt/EZK/48.json","totalNumberOfVerses":1249},"chapter":{"number":26,"content":[{"type":"heading","content":["Tiro siudä imano cananpäpis rimashan"]},{"type":"verse","number":1,"content":["Babiloniaman apamashancunaga chunca juc (11) wataman gallarej quilla, rimir junajninna caran. Chay junajmi Tayta Dios cayno nimaran:"]},{"type":"verse","number":2,"content":["«Runa, Tiro siudächo tiyaj runacunaga Jerusalenpa contran cayno rimasha:",{"text":"« ‹¡Cananga mayancha!","poem":1},{"lineBreak":true},{"text":"¡May nasyunpitapis chayanan siudä","poem":1},{"lineBreak":true},{"text":"cananga juchushami caycan!","poem":1},{"lineBreak":true},{"text":"Paycunaga pasaypa mana allimannami chayasha.","poem":1},{"lineBreak":true},{"text":"¡Cananga nogamannami surti ticramusha!","poem":1},{"lineBreak":true},{"text":"Noganami ima-aycawanpis rïcuyaycä› nir.","poem":1}]},{"type":"verse","number":3,"content":["«Chaypitami noga Tayta Dios në:",{"text":"«Tiro, nogaga gampa contrayquimi ricacö.","poem":1},{"lineBreak":true},{"text":"Nogami camacächishaj juc-lä nasyun runacuna contrayqui ricacunanpaj.","poem":1},{"lineBreak":true},{"text":"Paycuna shamonga lamar yacu wayrawan pullchajyar shamushannömi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Curalaraj pergayquicunatapis juchurgärachenga.","poem":1},{"lineBreak":true},{"text":"Ricchacunayquipaj törri rurashayquicunatapis tunichenga.","poem":1},{"lineBreak":true},{"text":"Ñuchu allpatapis pichaypami pichashaj.","poem":1},{"lineBreak":true},{"text":"Allpaynaj gagatanömi cachaycushaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Redata chaquichicuna","poem":1},{"lineBreak":true},{"text":"lamar chaupincho caycajnömi ricaconga.","poem":1},"Noga Tayta Diosmi chayno në.",{"text":"Tiro siudäpataga ima-aycantapis juc nasyun runacunami guechurir apaconga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Allinnin particho caycaj siudänincunacho tiyaycajcunatapis","poem":1},{"lineBreak":true},{"text":"sabliwan wañuchenga.","poem":1},{"lineBreak":true},{"text":"Chayrämi paycuna musyanga noga Tayta Dios cashäta.","poem":1}]},{"type":"verse","number":7,"content":["«Noga Tayta Diosmi në:",{"text":"«Nogami camacächishaj norte caj-läpita","poem":1},{"lineBreak":true},{"text":"Babiloniapa raynin Nabucodonosor Tiroman shamunanpaj.","poem":1},{"lineBreak":true},{"text":"Paymi mas munayniyoj ray caycan.","poem":1},{"lineBreak":true},{"text":"Payga cawalluncunawan y carrëtancunawanmi shamonga.","poem":1},{"lineBreak":true},{"text":"Muntäducunapis aypallami shamonga.","poem":1},{"lineBreak":true},{"text":"Aypalla suldärucunapis shamonga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mas allinnin siudäcunacho tiyaycajcunatami","poem":1},{"lineBreak":true},{"text":"sabliwan wañurgärachenga.","poem":1},{"lineBreak":true},{"text":"Siudäpa intëru cantunpami yaycunanpaj pergata jatarachenga.","poem":1},{"lineBreak":true},{"text":"Pillyaj yaycunanpaj escalëracunata ichichenga.","poem":1},{"lineBreak":true},{"text":"Gamcunaman pillyaj yaycamoj suldärucunaga canga chapacuna escüdunwan-camami.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Siudäniquita curalaraycaj pergatapis perga-tunichicunawanmi tangargärachenga.","poem":1},{"lineBreak":true},{"text":"Suldäruyquicuna ricchacunan törriquitapis amiypami tunirachenga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Siudäcunata charir ima-aycantapis guechunanpaj yaycojnömi","poem":1},{"lineBreak":true},{"text":"Babiloniapa raynenga puncuyquicunapa yaycamonga.","poem":1},{"lineBreak":true},{"text":"Chauraga aypalla cawallucunami canga.","poem":1},{"lineBreak":true},{"text":"Chaymi allpa goshtayno polbu jatarir chapacurcushunquipaj.","poem":1},{"lineBreak":true},{"text":"Cawallu garchashan carrëtacuna wiyacaptin,","poem":1},{"lineBreak":true},{"text":"muntäducuna purishan wiyacaptin,","poem":1},{"lineBreak":true},{"text":"pergayquicunapis sicsicyangami.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Intëru cällicunachöpis canga uchcoj-uchcoj lluchcargärishan","poem":1},{"lineBreak":true},{"text":"cawallucunapa yupillanrämi.","poem":1},{"lineBreak":true},{"text":"Chaycho tiyaj runacunataga sabliwanmi wañuchenga.","poem":1},{"lineBreak":true},{"text":"Sinchi caycaj arcuyquicunatapis sajtargärengami.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ima-ayca charashayquitapis guechushunquipämi.","poem":1},{"lineBreak":true},{"text":"Ranticunayquipaj caycächishayquitapis suwapäshunquipämi.","poem":1},{"lineBreak":true},{"text":"Pergayquicunatanami juchurgärachenga.","poem":1},{"lineBreak":true},{"text":"Fiyupa cuyayllapaj palasyuyquicunatapis juchurgärachengami.","poem":1},{"lineBreak":true},{"text":"Lamarmanmi jitarenga rumicunata, guerucunata,","poem":1},{"lineBreak":true},{"text":"muntuy-muntuy goturaycar quëdajtapis.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chaynöparämi cushicur birsur gaparpaycashayquitapis chawächishaj.","poem":1},{"lineBreak":true},{"text":"Chayrämi arpayquicuna wagashanpis mana wiyacanganachu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Allpaynaj gagamanmi ticrarachishayquipaj.","poem":1},{"lineBreak":true},{"text":"Redata mashtar chaquichicunallapänami ticrarachishayquipaj.","poem":1},{"lineBreak":true},{"text":"Yapayga imaypis mananami jatarachishunquipänachu.","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosmi chayno cananpaj nishcä.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":15,"content":["«Tirotaga noga Tayta Dios në: Ushacashayquita mayaycur, malubrashacuna gaparashanta wiyaycur, gamcho tiyaj runacunata wañuchishanta mayaycur lamar cantun nasyuncunacho tiyaycajcunaga manchariywan sicsicyangarämi."]},{"type":"verse","number":16,"content":["Lamar cantuncho caycaj raycunaga jamaränancunapita jatarcur llaquicuyllawan jacurashancunata, cuyayllapaj burdasha röpancunatapis jorgonga. Nircur fiyupa mancharishpan sicsicyaycarmi pampaman jamaconga. Ricashushpayqui fiyupami mancharenga."]},{"type":"verse","number":17,"content":["Chaymi wañushapaj cantanata cantapäshunquipaj. Caynömi nenga:",{"text":"« ‹¡Achachau! Imanöparaj chaynöga ruracashcanqui.","poem":1},{"lineBreak":true},{"text":"Pï-maypitapis rejsisha caycaj siudä, lamar cantunpita illgashcanquimi.","poem":1},{"lineBreak":true},{"text":"Gamga fiyupa munayniyojmi carayqui.","poem":1},{"lineBreak":true},{"text":"Bisïnuyqui nasyuncunacho tiyajcunataga llapantami mancharachej-canqui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Cananga ushacar mana alliman chayashayquita mayaycärir,","poem":1},{"lineBreak":true},{"text":"lamar cantun nasyuncunacho tiyaycajcunaga","poem":1},{"lineBreak":true},{"text":"manchariypita sicsicyarcaycanmi.","poem":1},{"lineBreak":true},{"text":"Canan illgashana captiquimi","poem":1},{"lineBreak":true},{"text":"lamar chaupin tishgucunacho tiyajcunapis manchariywan ima ruraytapis mana camäpacunnachu› nir.","poem":1}]},{"type":"verse","number":19,"content":["«Noga Tayta Diosmi në: Pipis manana tiyashan siudäcunatano ragällantami cachaycushayquipaj. Lamarpita aypalla yacu llojshimur ñitishunayquipämi camacächishaj."]},{"type":"verse","number":20,"content":["Chaymi unay wañojcuna caycashanman tallpucar chayanquipaj. Cay pachapitaga mas rurimanmi jitarishayqui. Chayga caycan imaypis ragälla caycashan nasyunmi. Chaychöga goyanquipaj wañojcunawan iwalmi. Gamchöga manami imaypis runacuna tiyangapänachu. Cay pachacho cawajcunaga tiyananpaj yapay manami jatarachishunquipänachu."]},{"type":"verse","number":21,"content":["Illgächishpä fiyupa manchariypämanmi ticrachishayquipaj. Ashishushpayquipis mananami tarishunquipänachu. Noga Tayta Diosmi chayno në.»"]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/EZK/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/EZK/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/EZK/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}