{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"EZK","translationId":"qub_wbt","name":"EZEQUIEL","commonName":"EZEQUIEL","title":"Ezequiel","order":26,"numberOfChapters":48,"sha256":"c3b2a9a3fdc16fb385563372344cbf0b03e5cdbd5072e29cebeb4feff239700e","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/qub_wbt/EZK/48.json","totalNumberOfVerses":1249},"chapter":{"number":28,"content":[{"type":"heading","content":["Tiropa raynin imano cananpäpis rimashan"]},{"type":"verse","number":1,"content":["Tayta Dios cayno nimaran:"]},{"type":"verse","number":2,"content":["«Runa, gamga Tiropa rayninta cayno niy: ‹Tayta Diosmi cayno nin:",{"text":"« ‹Gamga pasaypami alli-tucurayqui.","poem":1},{"lineBreak":true},{"text":"Mana Dios caycar, runalla caycashpayqui nishcanqui: «Nogaga diosmi cä.","poem":1},{"lineBreak":true},{"text":"Jamaraycäpis dioscuna jamaränanchömi; lamarpa chaupinchömi caycäpis» nir.","poem":1},{"lineBreak":true},{"text":"«Juc dios yarpashannömi yarpäpis» nir yarpashcanqui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Gamga Danielpita mas musyaj yachajchuraj canqui?","poem":1},{"lineBreak":true},{"text":"¿Sasa tantiyana cajtapis llapantachuraj musyanqui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Musyaj, yachaj cayniquiwanmi","poem":1},{"lineBreak":true},{"text":"rïcuyänayquiyaj ima-aycatapis aypallata tarishcanqui.","poem":1},{"lineBreak":true},{"text":"Babulniquicunamanpis guellayta, gorita juntachishcanqui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nigusyanti canayquipaj sumaj yachaj cashpayquimi","poem":1},{"lineBreak":true},{"text":"rïcuyänayquicama ima-aycayquitapis mirachishcanqui.","poem":1},{"lineBreak":true},{"text":"Ima-aycayquipis aypalla captinmi pasaypa alli-tucuycanqui.","poem":1}]},{"type":"verse","number":6,"content":["« ‹Chayno captiquimi Tayta Diosga nin:",{"text":"« ‹Gamga ninqui «juc diospa yarpayninno yarpayniyojmi cä» nir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaypitami camacächishaj gampa contrayqui","poem":1},{"lineBreak":true},{"text":"mas fiyu jäpa runacuna shamunanpaj.","poem":1},{"lineBreak":true},{"text":"Chaycunami sablinta jorgonga cuyayllapaj sumaj yachaj caycajta wañuchishunayquipaj.","poem":1},{"lineBreak":true},{"text":"Chauraga allicho caycajtapis pasaypa manacajmanmi churashunquipaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ruri uchcumanmi gaycurishunquipaj.","poem":1},{"lineBreak":true},{"text":"Lamarpa mas jundunninchömi rätu wañurinquipaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wañuchishunayquipaj caycajpa ñaupanchöpis gamga ¿jinallachuraj","poem":1},{"lineBreak":true},{"text":"niycanquipaj «nogaga diosmi cä» nir?","poem":1},{"lineBreak":true},{"text":"¡Wañuchishojcunapa maquincho","poem":1},{"lineBreak":true},{"text":"gamga manacaj runallami caycanquipaj!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mana aduramajcuna wañushannömi juc-lä jäpa runacunapa maquinwan wañunquipaj.","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosmi chayno rimashcä.","poem":1},{"lineBreak":true},{"text":"Nogami nishcä chayno cananpaj.› »","poem":1}]},{"type":"heading","content":["Tiropa rayninpaj llaquicur cantashan"]},{"type":"verse","number":11,"content":["Tayta Dios cayno nimaran:"]},{"type":"verse","number":12,"content":["«Runa, gamga Tiropa rayninpaj llaquicushpayqui, runa wañuycho cantanata cantashpayqui cayno ninqui: ‹Tayta Diosmi cayno nin:",{"text":"« ‹Gamga alli cuyayllapämi carayqui waquincuna ricacunanpaj.","poem":1},{"lineBreak":true},{"text":"Gamga fiyupa yachajmi, cuyayllapämi carayqui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Edén wertachömi caycarayqui.","poem":1},{"lineBreak":true},{"text":"Röpayquipis caycaran tucuy-niraj achicyaj rumicunawan burdashami.","poem":1},{"lineBreak":true},{"text":"Chay achicyaj rumicunapa jutenga caynömi caran:","poem":1},{"lineBreak":true},{"text":"Rubí, crisólito, jade,","poem":1},{"lineBreak":true},{"text":"topacio, cornalina, jaspe,","poem":1},{"lineBreak":true},{"text":"zafiro, granate, esmeralda.","poem":1},{"lineBreak":true},{"text":"Aläjayquicuna, arëtiquicuna gorillapita caran.","poem":1},{"lineBreak":true},{"text":"Chaycunaga gam yurishayquipita-pacha camarishanami caycaran.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Juc querubín anjiltami churarä gamta täpashunayquipaj.","poem":1},{"lineBreak":true},{"text":"Acrashä rispitädu jircachömi caycarayqui.","poem":1},{"lineBreak":true},{"text":"Achicyaycachaycaj rumicunapa chaupinchömi purej canqui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Camasha cashayqui junajpita-pacha","poem":1},{"lineBreak":true},{"text":"ima rurashayquicunapis allillami caran.","poem":1},{"lineBreak":true},{"text":"Ichanga mana allita ruraytana gallaycurayqui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Achca nigusyuta arurmi","poem":1},{"lineBreak":true},{"text":"mana alli ruraycunallaman, jucha rurayllamanna ticrashcanqui.","poem":1},{"lineBreak":true},{"text":"Chaypitami ñaupäpita gargushcä; «Diospa jircan» nishayquicunapitapis jitarishcä.","poem":1},{"lineBreak":true},{"text":"Querubín anjil täpaycäshojmi","poem":1},{"lineBreak":true},{"text":"achicyaycachaycaj rumicunapa ñaupancho puriycajta jorgushurayqui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Cuyayllapaj carmi alli-tucurayqui.","poem":1},{"lineBreak":true},{"text":"Allicho carmi yachaj cayniquitapis mana alliman ticrachishcanqui.","poem":1},{"lineBreak":true},{"text":"Nogami gamta pampaman jitarishcä.","poem":1},{"lineBreak":true},{"text":"Llapan raycunapa ñaupanman churashcä","poem":1},{"lineBreak":true},{"text":"paycuna manacajman churar asipäshunayquipaj.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fiyupa aypallami juchayqui.","poem":1},{"lineBreak":true},{"text":"Nigusyuta arur achcatami suwapashcanqui.","poem":1},{"lineBreak":true},{"text":"Chayno rurarmi templuyquicunatapis ganrachishcanqui.","poem":1},{"lineBreak":true},{"text":"Chaypitami, ninata ratarachishcä rupar ushacurcushunayquipaj.","poem":1},{"lineBreak":true},{"text":"Llapanmi ricashunquipaj","poem":1},{"lineBreak":true},{"text":"allpacho uchpayasha caycajta.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Llapan rejsishojcunaga","poem":1},{"lineBreak":true},{"text":"chaynöta ricashushpayqui fiyupami mancharisha caycan.","poem":1},{"lineBreak":true},{"text":"Fiyupa manchariypaj ruracashami caycanqui.","poem":1},{"lineBreak":true},{"text":"¡Manami imaypis cutimunquipänachu!› »","poem":1}]},{"type":"heading","content":["Sidón imano cananpäpis rimashan"]},{"type":"verse","number":20,"content":["Tayta Dios cayno nimaran:"]},{"type":"verse","number":21,"content":["«Runa, gamga Sidón caj-läman ricärir"]},{"type":"verse","number":22,"content":["cayno ninqui: ‹Caynömi Tayta Dios nin:",{"text":"« ‹Sidón, nogami gampa contrayqui ricacö.","poem":1},{"lineBreak":true},{"text":"Imano canayquipäpis nishä öra,","poem":1},{"lineBreak":true},{"text":"santo cashäta musyacächishä öra,","poem":1},{"lineBreak":true},{"text":"rejsicanga noga Tayta Dios cashä.","poem":1},{"lineBreak":true},{"text":"Chauraga gampa ñaupayquichömi alabasha cashaj.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gammanga tucuy-niraj gueshyatami chayachimushaj.","poem":1},{"lineBreak":true},{"text":"Intëru cälliquicunachömi yawar mashtaranga.","poem":1},{"lineBreak":true},{"text":"Wacpita caypita yaycur sabliwan cuchuypa wañuchiptinmi","poem":1},{"lineBreak":true},{"text":"gamcho tiyaycajcunaga wañonga.","poem":1},{"lineBreak":true},{"text":"Chaura noga Tayta Dios cashä musyacangami.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Israelga yapay mananami ñacanganachu.","poem":1},{"lineBreak":true},{"text":"Bisïnun nasyun runacunaga casha tucshejno, shira rachejnöpis","poem":1},{"lineBreak":true},{"text":"mananami manacajman churanganachu.","poem":1},{"lineBreak":true},{"text":"Chaura noga Tayta Dios cashä musyacangami.","poem":1}]},{"type":"verse","number":25,"content":["« ‹Noga Tayta Diosmi cayno në: Nasyuncunacho machicasha caycaj Israelcunata shuntamushämi. Nircorga santo cashäta musyachishaj llapan nasyun runacuna ricaycaptin. Chaura sirbimaj Jacobta goycushä nasyunchömi paypita mirajcunaga tiyacaycärenga."]},{"type":"verse","number":26,"content":["Chaychöga allillanami goyangapaj. Wasicunata jatarachenga. Übascunata lantapaconga. Nogami castigashäpaj Israelcunata manacajman churaj bisïnun nasyun runacunataga. Chauraga Israelcunapa noga Tayta Diosnin cashä musyacangami.› »"]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}