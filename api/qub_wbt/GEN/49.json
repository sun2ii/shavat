{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"GEN","translationId":"qub_wbt","name":"GÉNESIS","commonName":"GÉNESIS","title":"Génesis","order":1,"numberOfChapters":50,"sha256":"f2f8b809c4eb1b1037f517d0656b6c07094d590dc5a987e85e3c9bdfa7b7e2eb","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/qub_wbt/GEN/50.json","totalNumberOfVerses":1527},"chapter":{"number":49,"content":[{"type":"heading","content":["Wamrancunata Jacob bindisyunta goshan"]},{"type":"verse","number":1,"content":["Llapan wamrancunata gayaycur Jacob niran: «Ñaupäman witimuy-llapa shamoj watacunacho ima päsashunayquipaj cashantapis willapänäpaj."]},{"type":"verse","number":2,"content":[{"text":"«Wamräcuna, witimuy-llapa.","poem":1},{"lineBreak":true},{"text":"Nishäta wiyacuy-llapa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Rubén, gamga canqui guechpa wamrämi.","poem":1},{"lineBreak":true},{"text":"Gamga mösullaraj caycaptëmi yurirayqui.","poem":1},{"lineBreak":true},{"text":"Gamga mas rispitäduchari canquiman.","poem":1},{"lineBreak":true},{"text":"Mas munayniyojchari canquiman.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ichanga gamga märistayquiwan puñucuycushpayquimi pengayman churamarayqui.","poem":1},{"lineBreak":true},{"text":"Chaypitami manana mayurnönachu canquipaj.","poem":1},{"lineBreak":true},{"text":"Gamga chayasha mayunömi cashcanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Simeonwan Levïga chay shongullami.","poem":1},{"lineBreak":true},{"text":"Paycunaga mana cuyapaypami pitapis wañuchin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogaga manami paycuna parlacushancho cayta munächu.","poem":1},{"lineBreak":true},{"text":"Paycunaga rabyacurcurmi runacunata wañuchiran.","poem":1},{"lineBreak":true},{"text":"Asicunan-cashallami törucunapa ancuncunatapis cuchurgäriran.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nogaga melanäcömi gamcuna rabyar rurashayquita.","poem":1},{"lineBreak":true},{"text":"Chaypitami gamcunataga mashtaypa-mashtarishayqui.","poem":1},{"lineBreak":true},{"text":"Chaura intëru Israel nasyunchömi tallucasha caycangapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Judá, gamga chiquishojcunata munayniquichömi chararanquipaj.","poem":1},{"lineBreak":true},{"text":"Quiquiquipa wauguiquicunapis umpuycur-umpuycur rispitashushpayquimi alabashunquipaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Judá, gamga canqui juc manta liyun cäsata charircur cutimojno;","poem":1},{"lineBreak":true},{"text":"micunanpaj pampaman lätacuycojno.","poem":1},{"lineBreak":true},{"text":"Chayno caycaptiquega ¿piraj gamta rabyachishunquiman?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Judätaga manami pipis guechongapächu munayniyoj cayninta.","poem":1},{"lineBreak":true},{"text":"Manami pipis guechongapächu mandaj car charashan bastunnintapis","poem":1},{"lineBreak":true},{"text":"rasunpa mandaj chayamunancama.","poem":1},{"lineBreak":true},{"text":"Chay mandajtami llapan runacunapis rispitangapaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chay wichan übas aypalla captinmi","poem":1},{"lineBreak":true},{"text":"bürruncunatapis übas yöracunamanna watanga.","poem":1},{"lineBreak":true},{"text":"Bïnu yacunöraj captinmi bïnuwan röpantapis tagshacunanpänöna canga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aypalla übas captinmi ñawincunapis bïnupita mas yanaraj cangapaj.","poem":1},{"lineBreak":true},{"text":"Aypalla lëchi captinmi quiruncunapis lëchipita mas yurajraj cangapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Zabulón tiyanquipaj lamar cantuncunachömi.","poem":1},{"lineBreak":true},{"text":"Gamga tiyanquipaj büquicuna chayanancho, llojshinanchömi.","poem":1},{"lineBreak":true},{"text":"Lindayquega chayarangapaj Sidoncamami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Isacar, gamga sinchi bürru curralcho wichgaraycajnömi canquipaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tiyanayquipäno alli partita ricar,","poem":1},{"lineBreak":true},{"text":"wajtayquitapis camapanquipaj chaycho guepicunata apanayquipaj.","poem":1},{"lineBreak":true},{"text":"Mana rimacuyllapami rantisha runano ricacunquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Dan, gamga quiquiqui castallatami alli arriglanquipaj.","poem":1},{"lineBreak":true},{"text":"Gamga canquipis Israel trïbumi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dan gamga canquipaj culebra näni cantuncho mayaj-mayaj caycajnömi;","poem":1},{"lineBreak":true},{"text":"cawallupa chaquinta cañirir muntasha aywaycajta garpurejno.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Tayta Dios gam salbamänallayquitanami shuyaraycä!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Gad, gamtaga juc-läpita juc-läpitami asaltashunayquipaj yaycamongapaj.","poem":1},{"lineBreak":true},{"text":"Ichanga paycunatapis asaltanquipämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Aser, gampaga aypallami micuyniqui cangapaj.","poem":1},{"lineBreak":true},{"text":"Ray amatar yachashan micuycunapis cangapämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Neftalí, gamga lluychu-nirajpis munashayquipa puricojmi canquipaj.","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj wawayoj lluychunömi canquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«José, gamga yacu cantuncho lanta wiñar amatar wayojnömi canquipaj.","poem":1},{"lineBreak":true},{"text":"Nircur lantapa rämancunapis tapya jananpa lätajnöraj canquipaj.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fiyu runacuna chiquishushpayquimi lëchancunata gamcunaman jitamongapaj.","poem":1},{"lineBreak":true},{"text":"Chayno rurar rabyachishunquipaj.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ichanga gampa ricrayquicuna fiyupa callpami canga.","poem":1},{"lineBreak":true},{"text":"Lëchayquicunatapis sinchimi charinquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga canquipaj Jacobpa Tayta Diosnin yanapäshuptiquimi,","poem":1},{"lineBreak":true},{"text":"Israelpa michejnin chapajnin yanapäshuptiquimi,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"yäracushä Dios yanapäshuptiquimi,","poem":1},{"lineBreak":true},{"text":"munayniyoj Dios bindisyunta goshuptiquimi.","poem":1},{"lineBreak":true},{"text":"Syëlupitami payga bindisyunninta churamonga.","poem":1},{"lineBreak":true},{"text":"Bindisyunta goshushpayquimi pacha rurinpitapis yacuta pashtachimonga.","poem":1},{"lineBreak":true},{"text":"Warmicuna achca wawata tarinanpäpis bindisyunta goshunquipaj.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Noga bindisyunta goshäga unaypita-pacha cacoj jircacuna mana ushacaj cashannömi cangapaj.","poem":1},{"lineBreak":true},{"text":"Bindisyunta goshäcunaga gam Josëchömi caycangapaj.","poem":1},{"lineBreak":true},{"text":"Gamga llapan wauguiquicunapita mas rispitädumi caycanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Benjamín, gamga canqui atojnömi.","poem":1},{"lineBreak":true},{"text":"Imatapis charircur tuta tutallami micunqui.","poem":1},{"lineBreak":true},{"text":"Tardipana llapan puchöpacushayquitapis aypurinqui.»","poem":1}]},{"type":"verse","number":28,"content":["Chaycunami caran chunca ishcay trïbu Israelcuna. Chaynömi papänenga llapan wamrancunata bindisyunta goran pay wañucuptin cada-ünun imanöpis cananpaj."]},{"type":"heading","content":["Jacob wañushan"]},{"type":"verse","number":29,"content":["Chaypitana juc junaj Jacobga llapan wamrancunata cayno niran: «Ñaupa wañoj castäcunawan tincoj aywacunäpänami caycä. Pampaycäramanqui Het runa Efronpa chacrancho taytäcuna pamparaycashan machay uchcuman."]},{"type":"verse","number":30,"content":["Chayga caycan Canaán particho Mamrepa chimpan Macpelacho machay caycajmi. Chaytaga chacrantinta Abrahammi Efronpita rantiran llapan castancunawan chayman pampacunanpaj."]},{"type":"verse","number":31,"content":["Chaymanmi pamparan Abrahamtapis warmin Saratawan, Isaactapis warmin Rebecatawan. Nogapis chaymanmi pamparä Leata."]},{"type":"verse","number":32,"content":["Chaycho caycaj chacratawan machaytaga rantiran Het runacunapitami.»"]},{"type":"verse","number":33,"content":["Chayno llapan wamrancunata willapayta usharcur Israelga cämanman yapay wegucuycuran. Nircur wañucäcuran."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}