{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HAB","translationId":"qub_wbt","name":"HABACUC","commonName":"HABACUC","title":"Habacuc","order":35,"numberOfChapters":3,"sha256":"a172221027bea641516bbde9b6a392a368ea0d80a01afb0eac1be622231b9e6c","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/qub_wbt/HAB/3.json","totalNumberOfVerses":55},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Tayta Diosmi imano cananpaj cajtapis profëtan Habacucta ribilaran. Chayga caynömi caran:"]},{"type":"heading","content":["Habacuc llaquicur mañacushan"]},{"type":"verse","number":2,"content":[{"text":"Tayta Dios, ¿imaycamaraj gayacaycämushaj yanapämänayquipaj?","poem":1},{"lineBreak":true},{"text":"Gayacamuptëpis gamga manami wiyamanquichu.","poem":1},{"lineBreak":true},{"text":"Fiyupa mana alli ruraycuna caycho captin","poem":1},{"lineBreak":true},{"text":"¿imaycamaraj mañacaycämushaj?","poem":1},{"lineBreak":true},{"text":"Chaypis gamga manami shamunquichu nogacunata salbamänayquipaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Imanirtaj ricachimanqui","poem":1},{"lineBreak":true},{"text":"fiyupa llaquicuycunatawan mana alli ruraycunata?","poem":1},{"lineBreak":true},{"text":"Noga goyaycashächöga caycan mana alli rurayllami, wañuchinacuyllami.","poem":1},{"lineBreak":true},{"text":"May-chaychöpis caycan rimanacuyllami, pillyallami.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Laytaga pipis manami cumlinnachu.","poem":1},{"lineBreak":true},{"text":"Pitapis manami alliga arriglannachu.","poem":1},{"lineBreak":true},{"text":"Fiyu cajmi alli runata gaticachan.","poem":1},{"lineBreak":true},{"text":"Chaynöpami mana allina arriglanpis.","poem":1}]},{"type":"heading","content":["Mañacuptin Tayta Dios nishan"]},{"type":"verse","number":5,"content":["Tayta Diosnami cutichir niran:",{"lineBreak":true},{"text":"«Masqui ricay nasyuncunata.","poem":1},{"lineBreak":true},{"text":"Masqui ricay imano päsaycashantapis.","poem":1},{"lineBreak":true},{"text":"Fiyupa manchariypajcunata ruranäpämi caycä.","poem":1},{"lineBreak":true},{"text":"Imano ruranäpaj caycajtapis willashuptiqui","poem":1},{"lineBreak":true},{"text":"gamcunaga manami riguinquimanchu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Caldea runacunatami camaricachej-aywä guërraman aywananpaj.","poem":1},{"lineBreak":true},{"text":"Paycunaga fiyu runacunami.","poem":1},{"lineBreak":true},{"text":"Juc nasyuncunata charicarcärinanpaj may-chaypapis purin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paycunaga fiyupa manchacuypämi.","poem":1},{"lineBreak":true},{"text":"Quiquincuna yarpashallantami imatapis ruran.","poem":1},{"lineBreak":true},{"text":"Paycunaga quiquincunapa laynillantami bälichinpis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tinricunapitapis masrämi cawalluncunapis cörriycärin.","poem":1},{"lineBreak":true},{"text":"Fiyu cayninpis löbu animalcunapita masrämi.","poem":1},{"lineBreak":true},{"text":"Suldäruncunapis cawalluta muntacarcärerga wayranörämi aywaycärin.","poem":1},{"lineBreak":true},{"text":"Pillyamanga carupitami yagacaycärin anca carupita chipsaman aywajnöraj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aywar tincushan cajtaga pï-maytapis wañurachinmi.","poem":1},{"lineBreak":true},{"text":"Llapantami manchachin.","poem":1},{"lineBreak":true},{"text":"Prësu apashancunapis caycan","poem":1},{"lineBreak":true},{"text":"lamar cantuncho agushpita mas aypallarämi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Juc nasyunpa raynincunataga asipanmi.","poem":1},{"lineBreak":true},{"text":"Chaynömi ruran mas rispitädu runacunatapis.","poem":1},{"lineBreak":true},{"text":"Curalaraj siudäcunata ricarpis asicunmi.","poem":1},{"lineBreak":true},{"text":"Chaycunamanpis paycunaga patata ruraycurmi yaycun.","poem":1},{"lineBreak":true},{"text":"Nircorga chay siudäta charicarcärin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chay runacunaga löcu wayranömi purin.","poem":1},{"lineBreak":true},{"text":"Paycunaga callpallanmanmi yäracun.","poem":1},{"lineBreak":true},{"text":"Paycunapäga Dios manami cajnöchu.»","poem":1}]},{"type":"heading","content":["Habacuc llaquicur yapay mañacushan"]},{"type":"verse","number":12,"content":[{"text":"Tayta Dios gamga Santo Diosmi canqui.","poem":1},{"lineBreak":true},{"text":"Imaycamapis cawaj cashpayquimi nogacunata wañunäpita salbaycämanqui.","poem":1},{"lineBreak":true},{"text":"Imapitapis chapämaj gagano caycaj Tayta Diosnë,","poem":1},{"lineBreak":true},{"text":"gammi Caldea runacunataga yanapashcanqui","poem":1},{"lineBreak":true},{"text":"munashayquino yarpaycashayquita rurananpaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gamga limyu juchaynaj cashpayquimi mana alli ruraycunataga mana munanquichu.","poem":1},{"lineBreak":true},{"text":"Runa-masinta ñacaycächejtaga manami ricapaycanquimanchu.","poem":1},{"lineBreak":true},{"text":"Chayno caycarga ¿imanirtaj mana rimapayllapaga ricapaycanqui chay wañuchicojcunata?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj upällalla cacunqui chay fiyu runacuna alli runacunata illgaycächiptinpis?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gamga lamarcho caycaj tucuy casta pescäducunatanöllami ricaycämanqui.","poem":1},{"lineBreak":true},{"text":"Chaycunataga mandajniynajllatami rurashcanqui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Caldeacunataga pescäduta charejtanömi churashcanqui.","poem":1},{"lineBreak":true},{"text":"Paycunaga ansuylawannöpis, redawannöpis nogacunata chariycäman.","poem":1},{"lineBreak":true},{"text":"Nircorga juc pachallaman shuntaycur fiyupa cushicun.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chayno ruraptinmi paycunapaga can alli micuynin.","poem":1},{"lineBreak":true},{"text":"Chayno rurarmi redancunata ansuylancunata aduran.","poem":1},{"lineBreak":true},{"text":"Nircorga redanpa jutincho sacrifisyuta rupachin; insinsuwanpis saumachin.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Runa pescäduta charishano ¿jinallachuraj Caldea runacunaga charircaycämäshun?","poem":1},{"lineBreak":true},{"text":"¿Chaynöllachuraj mana cuyapaypa runacunata wañuycächenga?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}