{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HAB","translationId":"qub_wbt","name":"HABACUC","commonName":"HABACUC","title":"Habacuc","order":35,"numberOfChapters":3,"sha256":"a172221027bea641516bbde9b6a392a368ea0d80a01afb0eac1be622231b9e6c","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/qub_wbt/HAB/3.json","totalNumberOfVerses":55},"chapter":{"number":2,"content":[{"type":"heading","content":["Habacuc mañacushanta Tayta Dios yapay cutichishan"]},{"type":"verse","number":1,"content":[{"text":"Ricachacunan cajcho imanömi ricachacoj caycan,","poem":1},{"lineBreak":true},{"text":"chaynömi mayaj mayajlla caycäshaj.","poem":1},{"lineBreak":true},{"text":"Tayta Dios imata nimänantapis shuyaraycäshaj.","poem":1},{"lineBreak":true},{"text":"Shuyaraycäshaj llaquicur mañacushäpita imata willamänanpäpis.","poem":1}]},{"type":"verse","number":2,"content":["Chaymi Tayta Dios cayno nimaran:",{"lineBreak":true},{"text":"«Ricachiptë ricashayquitaga cläru isquirbinqui mitupita rurasha caycaj läjacunaman.","poem":1},{"lineBreak":true},{"text":"Chaura chayta liguej cäga mana pantaypa liguenga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cananga manami chayamunrächu öra","poem":1},{"lineBreak":true},{"text":"chay ricaycashayquicuna cumlinanpäga.","poem":1},{"lineBreak":true},{"text":"Ichanga imano carpis cumlengapämi.","poem":1},{"lineBreak":true},{"text":"Gamga ayca wata päsaptinpis shuyaray.","poem":1},{"lineBreak":true},{"text":"Chaycunaga päsanga imaypis päsananpaj caj junajchömi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alli-tucoj cajtaga manami yanapäshächu.","poem":1},{"lineBreak":true},{"text":"Alli runami ichanga yäracamashanpita cawanga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Caldea runacunaga alli chölu-tucoj runacunami.","poem":1},{"lineBreak":true},{"text":"Paycunaga imatapis mana yarpachacuypami ruran.","poem":1},{"lineBreak":true},{"text":"Mana jamaypami llutancunata ruran.","poem":1},{"lineBreak":true},{"text":"Munayniyoj cashpanmi paycunaga juc nasyunman juc nasyunman aywan charicarcärinanpaj.","poem":1},{"lineBreak":true},{"text":"Paycunaga wañuynöpis manami ushacanchu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Juc junajchömi ichanga Caldea nasyun runacuna ushacangapaj.","poem":1},{"lineBreak":true},{"text":"Chaymi chay charishan nasyun runacunaga","poem":1},{"lineBreak":true},{"text":"cantapashpan asipashpan cayno nenga:","poem":1},{"lineBreak":true},{"text":"«¡Ay imanöraj canqui jucpa cajllawan rïcuyajcuna!","poem":1},{"lineBreak":true},{"text":"Gamcunaga shuntashcanqui mañacuytanöllami.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaypitami mana yarpashayqui junaj ñacachishayqui runacunaga ayñita cutichishunquipaj.","poem":1},{"lineBreak":true},{"text":"Chay öraga fiyupami mancharachishunquipaj.","poem":1},{"lineBreak":true},{"text":"Llapan charashayquitami apacongapaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gamcunaga achca nasyun runacunatami ima-aycantapis guechushcanqui.","poem":1},{"lineBreak":true},{"text":"Cananga ima-aycayquitapis paycunanami cutichicongapaj.","poem":1},{"lineBreak":true},{"text":"Llapan mana allita rurashayquipitami wañuchishayquipitami ayñita cutichishunquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«¡Ay imanöraj canqui suwacuna!","poem":1},{"lineBreak":true},{"text":"Gamcunaga wasiquimanpis juntachishcanqui","poem":1},{"lineBreak":true},{"text":"ima-aycatapis suwacuyllapami.","poem":1},{"lineBreak":true},{"text":"Chayno shuntashcanqui disigrasya chayamuptin salbacunayquipämi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chayno rurashpayquimi wasiquicho caycajcunata jamurpaypäman ticrachishcanqui.","poem":1},{"lineBreak":true},{"text":"Achca nasyuncunata illgächishpayquipis","poem":1},{"lineBreak":true},{"text":"quiquiquicuna illgänallayquipämi rurashcanqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wasipa pergancunacho caycaj rumicunapis,","poem":1},{"lineBreak":true},{"text":"tiranticunapis gamcunapa contrayquega parlangami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«¡Ay imanöraj canqui wañuchicojcuna!","poem":1},{"lineBreak":true},{"text":"Gamcunaga runacunata wañuchishpayquimi,","poem":1},{"lineBreak":true},{"text":"mana allita rurashpayquimi siudäniquicunata arushcanqui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chay-jina ñacar arushayquitapis munayniyoj Tayta Diosga","poem":1},{"lineBreak":true},{"text":"manacajllamanmi ticrachengapaj.","poem":1},{"lineBreak":true},{"text":"Llapan arushayquicunatapis nina ruparmi ushanga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chauraga lamarcho yacu juntarashannömi mundu intëruchöpis Tayta Diosta rispitaj runacunallana aypalla canga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«¡Ay imanöraj canqui juccunata machächejcuna!","poem":1},{"lineBreak":true},{"text":"Gamcunaga bisïnuyquicunata machächishcanqui","poem":1},{"lineBreak":true},{"text":"upatächicojcunawan bïnuta tacurcachir upuchishpayquimi.","poem":1},{"lineBreak":true},{"text":"Chayno rurashcanqui","poem":1},{"lineBreak":true},{"text":"galallata ricar cushipänayquipämi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chayno rurashayquipitami","poem":1},{"lineBreak":true},{"text":"rispitädu canayquipa ruquenga pengaycho canquipaj.","poem":1},{"lineBreak":true},{"text":"Upuchishayquipitami gamtapis chay machächicojtaga Tayta Dios cöpawan upuchishunquipaj.","poem":1},{"lineBreak":true},{"text":"Chaura galapachacushpayqui pengayniquitapis ricachicunquipämi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Líbano jircacho yöracunata ushashayquipitami","poem":1},{"lineBreak":true},{"text":"ayñi quiquillayquiman cutimongapaj.","poem":1},{"lineBreak":true},{"text":"Chaycho tiyaj animalcunata wañuchishayquipitami fiyupa mancharinquipaj.","poem":1},{"lineBreak":true},{"text":"Llapan chaycunaga chayashunquipaj runacunata wañuchishayquipitawan","poem":1},{"lineBreak":true},{"text":"siudäcunacho tiyajcunata fiyupa mana allita rurashayquipitami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«¡Ay imanöraj canqui ïduluta adurajcuna!","poem":1},{"lineBreak":true},{"text":"Gamcunaga guerupita rurasha ïdulucunatami ‹ricchay› nircaycanqui.","poem":1},{"lineBreak":true},{"text":"Imatapis mana rimacoj rumitami ‹jatariy› nircaycanqui.","poem":1},{"lineBreak":true},{"text":"¿Chaycuna imallataga willapäshunquichuraj?","poem":1},{"lineBreak":true},{"text":"¡Manami imatapis willapäshunquichu!","poem":1},{"lineBreak":true},{"text":"Chaycunaga goriwan, guellaywan chapyasha carpis manami cawanchu.","poem":1},{"lineBreak":true},{"text":"¿Imapäraj bälinman runalla rurashan diosga?","poem":1},{"lineBreak":true},{"text":"¿Imapätaj alli canman imatapis mana yachachej jundisha ïduluga?","poem":1},{"lineBreak":true},{"text":"Chay ïdulucunaga manami rimanchu.","poem":1},{"lineBreak":true},{"text":"Chayno caycaptin chay ïduluta ruraj runaga","poem":1},{"lineBreak":true},{"text":"¿imanöparaj yäracunman chay ïdulucunamanga?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tayta Diosmi ichanga caycan santo Templuncho.","poem":1},{"lineBreak":true},{"text":"¡Paypa ñaupanmanga rispëtuwan upällalla yaycuy!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":19}