{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HAB","translationId":"qub_wbt","name":"HABACUC","commonName":"HABACUC","title":"Habacuc","order":35,"numberOfChapters":3,"sha256":"a172221027bea641516bbde9b6a392a368ea0d80a01afb0eac1be622231b9e6c","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/qub_wbt/HAB/3.json","totalNumberOfVerses":55},"chapter":{"number":3,"content":[{"type":"heading","content":["Tayta Diosta Habacuc mañacushan"]},{"type":"verse","number":1,"content":["Cayga caycan profëta Habacuc mañacushanmi."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tayta Dios, intërupa rejsisha cashayquitami musyashcä.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, imata imano rurashayquitapis wiyarmi fiyupa almirä.","poem":1},{"lineBreak":true},{"text":"Unaycuna rurashayquino ruray ari","poem":1},{"lineBreak":true},{"text":"canan nogacuna caycashä wichanpis.","poem":1},{"lineBreak":true},{"text":"Chaynöpanami nogacunapis rurashayquita musyashaj.","poem":1},{"lineBreak":true},{"text":"Rabyashpayquipis cuyapäcoj cashayquita yarpaycuy ari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Diosga Temán partipitami shamun.","poem":1},{"lineBreak":true},{"text":"Santo Diosga Parán jircapitami shamun. Selah","poem":1},{"lineBreak":true},{"text":"Munayniyoj captin achicyaynenga intëru syëluchömi achicyaraycan.","poem":1},{"lineBreak":true},{"text":"Intëru munduchönami payllatana alabarcaycan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Achicyaypa achicyaycajpa rurinchömi aywaycämun.","poem":1},{"lineBreak":true},{"text":"Maquincunapitanami achicyaypa achicyar llojshiycan.","poem":1},{"lineBreak":true},{"text":"Chay achicyashanchömi pacaraycan fiyupa munayniyoj cashanga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paypa ñaupantami shamonga fiyupa manchariypaj gueshya.","poem":1},{"lineBreak":true},{"text":"Paypa guepantanami chayamonga fiyupa rupay gueshya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pay ichiycuptenga intëru cay pachami sicsicyan.","poem":1},{"lineBreak":true},{"text":"Pay ricapäriptenga nasyuncunapis fiyupami mancharin.","poem":1},{"lineBreak":true},{"text":"Imaycamapis caycaj jircacunapis juchucäcunmi.","poem":1},{"lineBreak":true},{"text":"Imaycamapis caycaj puntacunapis gotucäcunmi.","poem":1},{"lineBreak":true},{"text":"Tayta Diospa yachachicuynincunami ichanga imaypis mana ushacanchu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nogaga ricashcämi Cusán runacuna fiyupa llaquicuycho carcaycajta,","poem":1},{"lineBreak":true},{"text":"Madián runacunapis manchariyllawan sicsicyarcaycajta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Dios, ¿fiyupachu rabyacurcushcanqui mayucunapaj?","poem":1},{"lineBreak":true},{"text":"¿Nina ratarejnöchu rabyacurcushcanqui lamarcunapäpis?","poem":1},{"lineBreak":true},{"text":"¿Chaychu puriycanqui cawalluyqui muntashalla?","poem":1},{"lineBreak":true},{"text":"¿Chaychu carrëtayqui janancho cörriycanqui?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lëcha jitacunayquitapis camarishallanami charaycanqui.","poem":1},{"lineBreak":true},{"text":"Lëchayquitapis illapanayquipaj jitaj jitajllanami caycanqui. Selah","poem":1},{"lineBreak":true},{"text":"Mayucunawanmi cay pachatapis ragrargärishcanqui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ricärishushpayquega puntacunapis sicsicyanmi.","poem":1},{"lineBreak":true},{"text":"Janajpitapis löcu tamyami tamyamun.","poem":1},{"lineBreak":true},{"text":"Chaymi may-may lamarpis gaparan.","poem":1},{"lineBreak":true},{"text":"Wayra apashan pullchajyajnincunapis altuta ichirin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fiyupa manchariypaj achicyaypa achicyaycaj lëchayquita ricashpan,","poem":1},{"lineBreak":true},{"text":"achicyaypa achicyaycaj sabliquita ricashpan","poem":1},{"lineBreak":true},{"text":"intiwan quillapis yagashanpita manami yagamunnachu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fiyupa rabyashami cay munduchöga intërupa purinqui.","poem":1},{"lineBreak":true},{"text":"Rabyasha caycashpayquimi nasyuncunatapis lluchcargärinqui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gamga shamushcanqui sirbishoj runacunata yanapänayquipämi.","poem":1},{"lineBreak":true},{"text":"Shamushcanqui quiquiqui acrashayqui rayta yanapänayquipämi.","poem":1},{"lineBreak":true},{"text":"Mana allita ruraj runacunapa mandajnintaga ushashcanquimi.","poem":1},{"lineBreak":true},{"text":"Chay fiyu runa mandashan nasyuntapis pasaypami ushashcanqui. Selah","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mandajnincunaga löcu tamyanömi cawalluncunawan muntädu shamuran.","poem":1},{"lineBreak":true},{"text":"Paycunaga fiyupa rabyashami shamuran nogacunata wacpa caypa machiramänanpaj.","poem":1},{"lineBreak":true},{"text":"Nogacunaga manami ima ruraytapis camäpacurächu.","poem":1},{"lineBreak":true},{"text":"Gammi ichanga quiquinpa lëchancunawan wañurachishcanqui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aypalla yacuta pullchajyachishpayquimi","poem":1},{"lineBreak":true},{"text":"lamar jananpa cawalluyquicunawan aywarayqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Llapan chaycunata wiyarmi mancharirä.","poem":1},{"lineBreak":true},{"text":"Shimi wirpäcunapis sicsicyacäcuran.","poem":1},{"lineBreak":true},{"text":"Chaquëcunapis mana awantashpan sicsicyacäcuran.","poem":1},{"lineBreak":true},{"text":"Intëru cuerpömi gotucäcuran.","poem":1},{"lineBreak":true},{"text":"Chayno caycaptinpis, mana yarpachacuypami shuyaräshaj","poem":1},{"lineBreak":true},{"text":"conträ yaycamojcunata Tayta Dios castiganancama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ïgus yöra mana waytaptinpis,","poem":1},{"lineBreak":true},{"text":"übascuna mana wayuptinpis,","poem":1},{"lineBreak":true},{"text":"olivopa wayuynin mana captinpis,","poem":1},{"lineBreak":true},{"text":"chacracunacho ima micuy mana wayuptinpis,","poem":1},{"lineBreak":true},{"text":"juc canchacho caycaj uyshacuna ushacäcuptinpis,","poem":1},{"lineBreak":true},{"text":"curralnincho wäcacuna manana captinpis,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"jinallami nogaga Tayta Diosta alabaycäshaj.","poem":1},{"lineBreak":true},{"text":"Imapitapis salbamashanpitami cushicushpä Diosnëtaga alabashaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nogataga Tayta Diosmi imapitapis chapäman.","poem":1},{"lineBreak":true},{"text":"Paymi camacächin chaquë lluychupa chaquinno cörrinanpaj.","poem":1},{"lineBreak":true},{"text":"Nircurpis altu jircacunaman pushaman.","poem":1},{"lineBreak":true},{"text":"Cay mañacushan caycan cuerdayoj instrumentucunata tucar cantananpämi.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}