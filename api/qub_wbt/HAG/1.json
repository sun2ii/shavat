{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HAG","translationId":"qub_wbt","name":"HAGEO","commonName":"HAGEO","title":"Hageo","order":37,"numberOfChapters":2,"sha256":"2e18352784f154dd95c61cfb8bfa0114442958203d042f4afaf21cd306af9e5b","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HAG/1.json","lastChapterNumber":2,"lastChapterApiLink":"/api/qub_wbt/HAG/2.json","totalNumberOfVerses":36},"chapter":{"number":1,"content":[{"type":"heading","content":["Templuta yapay jatarachinanpaj piñacushan"]},{"type":"verse","number":1,"content":["Ray Darío mandar ishcay wataman aywaycaptin sojta caj quilla rimir junajcho Tayta Diosga profëta Hageota willaparan. Willaparan Judäpa gobernadornin Zorobabelpaj. Payga Salatielpa wamranmi caran. Chaynöpis willaparan cüracunapa mandajnin Josuëpaj. Payga Josadacpa wamranmi caran."]},{"type":"verse","number":2,"content":["Munayniyoj Tayta Diosga profëtanwan willacachishpan caynömi niran: «Cay runacunaga nircaycan: ‹Tayta Diospa Templunta yapay jatarachinapäga pishinrächu› nir."]},{"type":"verse","number":4,"content":["Nogapa Templö juchuchir-ushacasha caycaptin ¿gamcuna alli wasicunacho, cuyayllapaj wasicunacho tiyanayqui camacanchu?"]},{"type":"verse","number":5,"content":["Noga munayniyoj Tayta Diosmi në:",{"text":"«Imano cawaycashayquitapis sumaj yarpachacuy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gamcunaga aypallatami murupacunqui;","poem":1},{"lineBreak":true},{"text":"ichanga wallcallatami shuntanqui.","poem":1},{"lineBreak":true},{"text":"Micushpayquipis jinallami yargaycanqui.","poem":1},{"lineBreak":true},{"text":"Upushpayquipis jinallami yacunarcaycanqui.","poem":1},{"lineBreak":true},{"text":"Sumaj pitucurpis manami goñurinquichu.","poem":1},{"lineBreak":true},{"text":"Arupacuptiqui pägashushayquipis manacajnöllami ushacäcun.","poem":1}]},{"type":"verse","number":7,"content":["«Noga munayniyoj Tayta Diosmi në:",{"text":"«Imano cawaycashayquitapis sumaj yarpachacuy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Puntacunaman ayway-llapa.","poem":1},{"lineBreak":true},{"text":"Chaypita guerucunata apaycamushpayqui Templuta yapay jatarachiy.","poem":1},{"lineBreak":true},{"text":"Templuta jatarachiptiqui nogaga cushicushämi.","poem":1},{"lineBreak":true},{"text":"Chaymi nogaga alabasha cashaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gamcunaga achcata ashirpis","poem":1},{"lineBreak":true},{"text":"wallcallatami tarinqui.","poem":1},{"lineBreak":true},{"text":"Wasiquicunaman churacushayquitapis","poem":1},{"lineBreak":true},{"text":"Nogaga juc pücayllawanmi apacushaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga ¿imanirtaj rurashaj?","poem":1},{"lineBreak":true},{"text":"Chaynöga rurashaj tiyanä Wasi pasaypa juchuchisha captinmi.","poem":1},{"lineBreak":true},{"text":"Chaynöta ricaycarpis gamcunaga yarpachacurcaycanqui quiquiquipa cajcunallapämi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chaypitami gamcunamanga mana tamyamunchu.","poem":1},{"lineBreak":true},{"text":"Micuyniquicunapis mana wayunchu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nogami camacächishcä fiyupa usya cananpaj,","poem":1},{"lineBreak":true},{"text":"jircacunacho cajpis shanaywan chaquinanpaj,","poem":1},{"lineBreak":true},{"text":"rïgu, übas, olivo chacrayquicuna chaquicäcunanpaj,","poem":1},{"lineBreak":true},{"text":"maycho caycaj micuypis chaquicäcunanpaj.","poem":1},{"lineBreak":true},{"text":"Runa, ni animalcuna imata arushanpis yangallanami caycan.»","poem":1}]},{"type":"heading","content":["Mandajcunawan llapan runacuna aruyta gallaycärishan"]},{"type":"verse","number":12,"content":["Tayta Dios chayno Hageowan willacachishanta wiyaycärir Zorobabel, Josué, waquin runacunapis fiyupa manchariran."]},{"type":"verse","number":13,"content":["Chaura Tayta Diospa profëtan Hageoga cayno willaparan: «Tayta Diosga nin: ‹Noga Tayta Diosmi në: Nogaga gamcunawanmi caycä.› »"]},{"type":"verse","number":14,"content":["Chayno nishpanmi Tayta Diosga shacyächiran Judäpa gobernadornin Zorobabelta, cüracunapa mandajnin Josuëta, waquin runacunatapis. Chaypitaga ray Darío ishcay wata sojta quillanna mandaycaptin ishcay chunca chuscu (24) junajnincho gallaycäriran munayniyoj Tayta Diospa Templunta yapay jatarachiyta."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HAG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HAG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ZEP/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}