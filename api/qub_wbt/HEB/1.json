{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HEB","translationId":"qub_wbt","name":"HEBREOS","commonName":"HEBREOS","title":"Hebreos","order":58,"numberOfChapters":13,"sha256":"1dbae7fcb22a37328631339468849f4bfec037d57b82b7b45b139c3b293128d4","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/qub_wbt/HEB/13.json","totalNumberOfVerses":298},"chapter":{"number":1,"content":[{"type":"heading","content":["Gallarinan"]},{"type":"verse","number":1,"content":["Unay caj awilunchicunata Tayta Diosga tucuynöpami achca cuti willapaj imano cawananpäpis. Chaynömi profëtacunawanpis tantiyachiran pay munashanno cawananpaj."]},{"type":"verse","number":2,"content":["Canan wichanmi ichanga Wamran Jesucristutana Tayta Dios cachamusha munashanno cawanapaj tantiyachimänanchïpaj. Wamranwanmi mundutapis ruraran. Nircur Wamrantami churasha llapantapis maquincho chararänanpaj."]},{"type":"verse","number":3,"content":["Wamranmi musyachimanchi Tayta Dios imano munayniyoj cashantapis. Wamranta rejserga quiquin Tayta Diostapis rejsinchïmi. Llapan camashancunatapis munaynincho Wamran chararaptinmi canancamapis caycanraj. Wamranga llapan juchanchïcunata perdunamänanchïpämi cruscho wañurcur syëluman cutiran. Chaychönami cananga Tayta Diospa derëchu caj-läduncho jamaraycan."]},{"type":"heading","content":["Diospa Wamranga anjilcunapitapis mas munayniyoj cashan"]},{"type":"verse","number":4,"content":["Chaymi Diospa wamranga anjilcunapitapis mas munayniyoj caycan. Anjilcunataga maygantapis manami wamrachacuranchu."]},{"type":"verse","number":5,"content":["Manami imaypis Diosga anjilcunata cayno niranchu:",{"text":"«Gamga wamrämi canqui.","poem":1},{"lineBreak":true},{"text":"Canan junajpitaga taytayquinami cä.»","poem":1},"Chayno manami maygan anjilpäpis niranchu:",{"text":"«Nogami cashaj papänin.","poem":1},{"lineBreak":true},{"text":"Paynami wamrä canga» nir.","poem":1}]},{"type":"verse","number":6,"content":["Wamran Jesucristuta cay pachaman cachamushpan ichanga Tayta Dios niran:",{"text":"«Llapan anjilnëcunapis rispitar payta adurachun».","poem":1}]},{"type":"verse","number":7,"content":["Anjilcunapänami Tayta Dios cayno niran:",{"text":"«Anjilnëcunatami camashcä wayrano munashäpa aywananpaj,","poem":1},{"lineBreak":true},{"text":"munashäta rurar ninano cananpaj.»","poem":1}]},{"type":"verse","number":8,"content":["Wamranpämi ichanga niran:",{"text":"«Gam mandashayquega mana ushacajmi canga.","poem":1},{"lineBreak":true},{"text":"Gamga llapantapis allimi mandanqui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alli cajta cuyanqui, mana alli cajta chiquinqui.","poem":1},{"lineBreak":true},{"text":"Chaymi gamtaga Tayta Diosniqui acrashurayqui.","poem":1},{"lineBreak":true},{"text":"Waquin yanasayquicunapitami acracushurayqui.","poem":1},{"lineBreak":true},{"text":"Sumaj cushicachishurayqui.»","poem":1}]},{"type":"verse","number":10,"content":["Chaynöpis niran:",{"text":"«Tayta, gallarinanpita-pachami cay pachatapis gamga tacyachishcanqui.","poem":1},{"lineBreak":true},{"text":"Quiquiquimi syëlutapis rurashcanqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Llapanmi chaycunapis illgangapaj.","poem":1},{"lineBreak":true},{"text":"Gammi ichanga jinalla caycanquipaj.","poem":1},{"lineBreak":true},{"text":"Llapan chaycunaga röpanömi ushacanga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Röpata dublajnömi rurarinquipaj.","poem":1},{"lineBreak":true},{"text":"Rucarachinquipäpis röpanta rucacushannöllami.","poem":1},{"lineBreak":true},{"text":"Gammi ichanga imaypis cashayquinölla caycanquipaj.","poem":1},{"lineBreak":true},{"text":"Gamga imaypis chaynöllami cawaycanquipaj.»","poem":1}]},{"type":"verse","number":13,"content":["Tayta Diosga manami maygan anjiltapis nishachu:",{"text":"«Cay derëchu caj lädöman jamacuy","poem":1},{"lineBreak":true},{"text":"llapan chiquishojcunata munayniquiman churanäcama» nir.","poem":1}]},{"type":"verse","number":14,"content":["¿Manachu llapan anjilcunapis caycan Tayta Dios munashanta ruranallanpaj? Paycunataga Tayta Dios cachamusha Jesusta chasquicojcunata yanapänanpämi."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}