{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HOS","translationId":"qub_wbt","name":"OSEAS","commonName":"OSEAS","title":"Oseas","order":28,"numberOfChapters":14,"sha256":"858270a959476d7310448e835485f35f816c9567980c903528cf92fcd2d26944","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/qub_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"heading","content":["Mana bälej capillacunata illgächinanpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"Israelga caycan übas achcata wayuraycajnömi.","poem":1},{"lineBreak":true},{"text":"Mas achca wayuynin captin mas achcatami capillancunatapis ruraran.","poem":1},{"lineBreak":true},{"text":"Mas cuyayllapaj micuynincuna wayuptin mas cuyayllapätami ïduluncunatapis ruraran.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Israelga ishcay shongumi.","poem":1},{"lineBreak":true},{"text":"Cananmi ichanga llapan juchanpita castigasha canga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi capillancunata juchurgärachenga.","poem":1},{"lineBreak":true},{"text":"Rispitädu ïduluncunatapis sajtargärenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Cananga cay runacuna cayno nenga:","poem":1},{"lineBreak":true},{"text":"«Tayta Diosta mana rispitashanchïpitami rayninchïpis mana cannachu.","poem":1},{"lineBreak":true},{"text":"Ichanga rayninchi carpis ¿imachöraj yanapämashwan?» nir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chay raycunaga parlashpanpis llullacuyllatami parlan.","poem":1},{"lineBreak":true},{"text":"Jurashpanpis manacajllapämi juran.","poem":1},{"lineBreak":true},{"text":"Chaypitami amatar pillyallana, mana alli goyayllana caycan","poem":1},{"lineBreak":true},{"text":"chacracunacho wañuchicoj jacha wiñamojnöpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Samaria runacunaga chulluchiypa rurashan törutami","poem":1},{"lineBreak":true},{"text":"Bet-avén siudächo aduran.","poem":1},{"lineBreak":true},{"text":"Ichanga chay törupaj fiyupami llaquicongapaj runacunapis, cüracunapis.","poem":1},{"lineBreak":true},{"text":"Chaynöga llaquiconga chay törunta apacuptinmi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chay törutaga Asiriamanmi apanga munayniyoj rayta goycunanpaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami Efraín runacunaga pengaycho ricaconga.","poem":1},{"lineBreak":true},{"text":"Israelcunaga pengaconga ïduluncunata adurashanpitami.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Samariataga illgächengami.","poem":1},{"lineBreak":true},{"text":"Raynintapis apaconga cashpita yacu apacojnömi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mana bälej ïduluncunata adurashan capillancunapis ushacangami.","poem":1},{"lineBreak":true},{"text":"Chaychöga Israelcuna juchatami ruraran.","poem":1},{"lineBreak":true},{"text":"Capillancunachöga cashacunawan shiracunallami wiñamonga.","poem":1},{"lineBreak":true},{"text":"Chayrämi runacunapis puntacunata nenga: «¡Juchumur chapacarcamay!» nir.","poem":1},{"lineBreak":true},{"text":"Jircacunatapis nenga: «¡Nogacunapa janäman tunimur ñiticarcamay!» nir.","poem":1}]},{"type":"heading","content":["Israel imano cananpäpis Tayta Dios nishan"]},{"type":"verse","number":9,"content":[{"text":"Tayta Diosmi nin: «Israelcuna, gamcunaga Gabaa particho juchata rurayta gallaycushayquipita-pacha","poem":1},{"lineBreak":true},{"text":"manami jucha rurayta cachaycunquichu.","poem":1},{"lineBreak":true},{"text":"Chaypitami gamcunaga Gabaacho guërrawan wañunquipaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gamcunataga imaypis munashä örami castigashayqui.","poem":1},{"lineBreak":true},{"text":"Fiyupa mana allita rurashayquipita gamcunata castigaptëmi","poem":1},{"lineBreak":true},{"text":"gamcunawan pillyananpaj achca nasyun runacuna shamonga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Efraín runacunaga manshu wäca rïgu ëraycho yachacasha cacojnömi caran.","poem":1},{"lineBreak":true},{"text":"Chaymi yüguta churapaytaga mana yarparächu.","poem":1},{"lineBreak":true},{"text":"Cananmi ichanga cuyayllapaj matancanman yüguta churapäshaj.","poem":1},{"lineBreak":true},{"text":"Judá runacunami yapyajnin canga.","poem":1},{"lineBreak":true},{"text":"Jacobpita mirajcunami cuspiyajnin canga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Noga unay nirä: ‹Murupacojnöpis alli cajllata ruray.","poem":1},{"lineBreak":true},{"text":"Chauraga cuyanacurmi goyanquipaj micuyta alli shuntajnöpis.","poem":1},{"lineBreak":true},{"text":"Chucru chacrata yapyajnöpis chucru shonguyquita pascacächiy.","poem":1},{"lineBreak":true},{"text":"Cananmi noga Tayta Diosman yäracamunayqui.","poem":1},{"lineBreak":true},{"text":"Chayrämi shamushpä gamcunaman bindisyunnëta churamushaj.›","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ichanga alli cajta ruranayquipa ruquin mana alli rurayllachömi cashcanqui.","poem":1},{"lineBreak":true},{"text":"Cuyanacur alli goyänayquipa ruquin wañuchinacuyllachömi cashcanqui.","poem":1},{"lineBreak":true},{"text":"Nogaman yäracamunayquipa ruquin llullacullar goyashcanqui.","poem":1},{"lineBreak":true},{"text":"Chaynöga goyashcanqui pillyapaj caj carrëtayquicunaman yäracushpayquimi,","poem":1},{"lineBreak":true},{"text":"pillyäshishoj piyunniqui aypalla caycajman yäracushpayquimi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chaypitami cananga nasyunniquicho guërrallana canga.","poem":1},{"lineBreak":true},{"text":"Siudäniquicunapis llapanmi ushacanga.","poem":1},{"lineBreak":true},{"text":"Bet-arbel particho pillya cashan öra ray Salmán illgächishanno,","poem":1},{"lineBreak":true},{"text":"warmicunata wamracunata wañuchishanno llapanta wañuchenga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Betel runacuna, mana allita rurashayquipita gamcunatapis chaynömi rurashunquipaj.","poem":1},{"lineBreak":true},{"text":"Israelcunapa raynenga guërra gallaycushan öra rimir junajllanami wañongapaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}