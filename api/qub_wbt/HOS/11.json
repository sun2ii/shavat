{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HOS","translationId":"qub_wbt","name":"OSEAS","commonName":"OSEAS","title":"Oseas","order":28,"numberOfChapters":14,"sha256":"858270a959476d7310448e835485f35f816c9567980c903528cf92fcd2d26944","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/qub_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Acrashan runacuna mana wiyacoj captinpis Tayta Dios cuyashan"]},{"type":"verse","number":1,"content":["Israelcunata Tayta Dios niran:",{"lineBreak":true},{"text":"«Israel runacuna wamrallaraj captin noga cuyaj cä.","poem":1},{"lineBreak":true},{"text":"Pay wamrä captinmi Egiptupita shacamunanpaj gayarä.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chayno gayaycaptëpis nogapitaga masmi witicoj.","poem":1},{"lineBreak":true},{"text":"Paycunaga mana dios caycaptin ‹diosnë› nishanpämi garayninta churapaj.","poem":1},{"lineBreak":true},{"text":"Ïdulucunatami insinsuwanpis saumachej.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Imano captinpis, nogami Efraín runacunataga puriyta yachachirä.","poem":1},{"lineBreak":true},{"text":"Chayno purichirmi imano goyänanpäpis yachachirä.","poem":1},{"lineBreak":true},{"text":"Chaypis paycunaga manami tantiyacushachu noga paycunata imapitapis chapaycashäta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paycunataga fiyupa cuyashpämi pushamurä.","poem":1},{"lineBreak":true},{"text":"Paycunataga iti wamranta margarcur cäranman töpachejnömi cachirä.","poem":1},{"lineBreak":true},{"text":"Chayno rurarmi paycunataga micuytapis tarichirä.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaypis paycunaga manami nogaman yäracamuyta munashachu.","poem":1},{"lineBreak":true},{"text":"Chaypis Egiptumanga mananami cutenganachu.","poem":1},{"lineBreak":true},{"text":"Asiria nasyunpa munayninchömi goyanga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siudächo tiyajcunataga sabliwanmi wañuchenga.","poem":1},{"lineBreak":true},{"text":"Llapan runacunatami illgächir ushanga.","poem":1},{"lineBreak":true},{"text":"Yarpashancunatapis manami camacächenganachu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Noga nishätaga acrashä runacuna manami wiyacunnachu.","poem":1},{"lineBreak":true},{"text":"Juc dioscunamannami gayacuycan.","poem":1},{"lineBreak":true},{"text":"Chay dioscuna nogapita mas munayniyoj cashanta yarpaptinpis manami yanapangapächu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«¿Imanöpataj gamtaga gongaycöman Efraín?","poem":1},{"lineBreak":true},{"text":"¿Imanöpataj gamtaga jaguiriycöman Israel?","poem":1},{"lineBreak":true},{"text":"¿Imanöparäshi ruraycöman Adma siudäta illgächishänöga?","poem":1},{"lineBreak":true},{"text":"¿Imanöparäshi ruraycöman Seboim siudäta rurashänöga?","poem":1},{"lineBreak":true},{"text":"Gamta cuyapar fiyupa llaquicuptëmi shongöpis nananraj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Manami fiyupa rabyasha caycashämannöchu rurashaj.","poem":1},{"lineBreak":true},{"text":"Efraintaga yapay manami illgächishänachu.","poem":1},{"lineBreak":true},{"text":"Nogaga Diosmi cä, manami runachu.","poem":1},{"lineBreak":true},{"text":"Noga gamcunacho caycäga Santumi cä.","poem":1},{"lineBreak":true},{"text":"Manami gamcunata illgächejchu shamushaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Gamcunaga nogatami wiyacamanquipaj.","poem":1},{"lineBreak":true},{"text":"Noganami liyun gaparajno parlamushaj.","poem":1},{"lineBreak":true},{"text":"Liyun gaparajno parlaptëmi nogapa cajcunaga","poem":1},{"lineBreak":true},{"text":"inti yaganan caj-läpita sicsicyaycar shamongapaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Äbicunanömi Egiptupitapis cutimonga.","poem":1},{"lineBreak":true},{"text":"Palumacunanömi Asiriapitapis cutimonga.","poem":1},{"lineBreak":true},{"text":"Chaura camacächishäpaj wasincunacho yapay tiyananpaj.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"heading","content":["Israelcunapa juchan"]},{"type":"verse","number":12,"content":[{"text":"Tayta Dios nin: «Efraín runacunaga tucuynöpami llullapämasha.","poem":1},{"lineBreak":true},{"text":"Israel runacunaga tucuynöpami manacajcunata nimasha.","poem":1},{"lineBreak":true},{"text":"Judá runacunaga noga Tayta Diosninta gongaycamashami.","poem":1},{"lineBreak":true},{"text":"Cananga ïdulucunatana mana cachaypa adurarcaycan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}