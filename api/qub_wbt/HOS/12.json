talunninta charisha yuriran.","poem":1},{"lineBreak":true},{"text":"Rucu runa cashpannaga Dioswan pillyaran.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Anjilwan pillyar binsiran.","poem":1},{"lineBreak":true},{"text":"Nircur Jacobga wagashpan cuyapänanpaj ruwacuran.","poem":1},{"lineBreak":true},{"text":"Tayta Dios Betelcho tarishpan chaycho parlaran.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paymi llapanpäpis munayniyoj Tayta Diosga:","poem":1},{"lineBreak":true},{"text":"Paypaga jutinpis Tayta Diosmi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chayno caycaptenga Israelcuna, Diosniquita wiyacuy.","poem":1},{"lineBreak":true},{"text":"Cuyanacuy; alli cajtana ruray.","poem":1},{"lineBreak":true},{"text":"Nircorga mana cachaypa Tayta Diosman yäracuy.","poem":1}]},{"type":"verse","number":7,"content":["Tayta Diosmi nin:",{"text":"«Efraín runacunaga Cananeo runacunano suwa pësacunallatami chararcaycanqui.","poem":1},{"lineBreak":true},{"text":"Gamcunataga juccunata engañaymi gustashunqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gamcunaga ninqui: ‹Fiyupami rïcuyashcä.","poem":1},{"lineBreak":true},{"text":"Nogapaga alli surtimi casha.","poem":1},{"lineBreak":true},{"text":"Achcata chasquishäpitaga manami pipis dimandamangachu.","poem":1},{"lineBreak":true},{"text":"Juchätaga manami pipis tarengachu› nir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ichanga nogami Egiptucho cashayquipita-pacha Tayta Diosniqui cä.","poem":1},{"lineBreak":true},{"text":"Nogami yapay camacächishaj tolducunacho tiyanayquipaj.","poem":1},{"lineBreak":true},{"text":"Chauraga yapay canga chunyajcho unay tiyashayqui junajcunanömi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chayno cananpäga nogami willapaj cä profëtäcunata.","poem":1},{"lineBreak":true},{"text":"Suyñushancunachöpis tucuytami ricachishcä.","poem":1},{"lineBreak":true},{"text":"Profëtäcunawanga tincuchiypami willapächishcä.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Galaadcho tiyajcunaga fiyu runacunami.","poem":1},{"lineBreak":true},{"text":"Paycunaga manacajllami.","poem":1},{"lineBreak":true},{"text":"Gilgalchömi törucunata pishtarcur rupachin.","poem":1},{"lineBreak":true},{"text":"Chaypitami altarnincunapis chacracho rumi gotushacuna goturaycajno quëdanga.»","poem":1}]},{"type":"verse","number":12,"content":["Jacobga Aram partiman gueshpir aywacuran. Chaychönami warminpita pägananpaj aruran uysha michiycho."]},{"type":"verse","number":13,"content":["Tayta Diosga profëtanwanmi Israel runacunata Egiptupita jorguran. Profëtanwanmi paycunata cuydachiran."]},{"type":"verse","number":14,"content":[{"text":"Chayno caycaptinpis Efraín runacunaga Tayta Diosta fiyupa rabyachisha.","poem":1},{"lineBreak":true},{"text":"Chaypitami Tayta Diosga camacächenga pasaypa mana allicunata rurashanpita quiquincunapis ñacananpaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta manacajman churashanpitami castiganga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}