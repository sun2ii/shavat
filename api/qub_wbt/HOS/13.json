{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HOS","translationId":"qub_wbt","name":"OSEAS","commonName":"OSEAS","title":"Oseas","order":28,"numberOfChapters":14,"sha256":"858270a959476d7310448e835485f35f816c9567980c903528cf92fcd2d26944","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/qub_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Israel pasaypa mana alliman chayananpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"Efraín runacuna parlaptenga llapanmi manchacoj.","poem":1},{"lineBreak":true},{"text":"Chaymi waquin caj Israel runacunaga rispitashpan upällacoj.","poem":1},{"lineBreak":true},{"text":"Chayno caycashanpita Efraín runacunaga Baalta adurashpanmi fiyupa juchayoj ricacuran.","poem":1},{"lineBreak":true},{"text":"Chaynöpami paycunaga ushacasha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Cananpis jinallami juchata rurarcaycan.","poem":1},{"lineBreak":true},{"text":"Guellaynincunata chullurcachir ïdulucunata rurachicurcun.","poem":1},{"lineBreak":true},{"text":"Chay ïdulucunataga guellay tacajmi yachashanman-tupu rurapan.","poem":1},{"lineBreak":true},{"text":"Nircorga nin: «Paypaj garayniquita churay-llapa» nir.","poem":1},{"lineBreak":true},{"text":"Chaura runacunaga jundiypa rurashan töruta rispitashpan muchan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chaymi paycunaga canga pacha warayman pucutay juntarcojnölla,","poem":1},{"lineBreak":true},{"text":"tutapa shullay warämushpan inti ratarcamuptin illgacäcojnölla,","poem":1},{"lineBreak":true},{"text":"ogshata wayra apacushannölla,","poem":1},{"lineBreak":true},{"text":"jurnupa uchcunpa goshtay llojshir aywacojnölla.","poem":1}]},{"type":"verse","number":4,"content":["Tayta Diosmi acrashan runacunata nin:",{"text":"«Nogami Egiptucho cashayquipita-pachapis Diosniqui cä.","poem":1},{"lineBreak":true},{"text":"Nogapita mas juctaga ama pitapis ‹Diosnë› niychu.","poem":1},{"lineBreak":true},{"text":"Nogallami cä gamcunata salbäga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gamcunataga nogallami yanapaycarä chunyaj jircacho captiqui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogami micuyta tarichirä.","poem":1},{"lineBreak":true},{"text":"Micuyniqui puchu-puchu captinnaga","poem":1},{"lineBreak":true},{"text":"waquinpita mas alli-tucushpayqui nogata gongaycäramarayqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaypitami gamcunapäga liyunno cashaj,","poem":1},{"lineBreak":true},{"text":"juc tinri nänicho pacacuycur rachir-usharinanpaj shuyaraycajno.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ösu wawanta ograycur fiyupa rabyasha ashejnömi gamcunamanga shamushaj.","poem":1},{"lineBreak":true},{"text":"Chaychömi pëchupita charir rachirgärishayqui.","poem":1},{"lineBreak":true},{"text":"Liyun micucurcojnömi jinancho usharishayqui.","poem":1},{"lineBreak":true},{"text":"Micucoj jirca animalnömi rachir-usharishayquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Israelcuna, gamcunataga illgächejmi-aywä.","poem":1},{"lineBreak":true},{"text":"Chayno ruraptë pipis manami nogata michämangachu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Cananga ¿maytaj chay llapan siudäniquicho salbashoj rayniqui?","poem":1},{"lineBreak":true},{"text":"¿Maychötaj caycan mandajniquicuna:","poem":1},{"lineBreak":true},{"text":"‹rayta, mandajcunata churapämay› nishayquicuna?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gamcuna fiyupa rabyachimaptiquimi rayta churaparä.","poem":1},{"lineBreak":true},{"text":"Nircur fiyupa rabyashpämi rayniquicunatapis illgarachishcä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Efraín runacuna mana allita rurashanga apuntaraycannami.","poem":1},{"lineBreak":true},{"text":"Juchata rurashancunaga musyacashanami caycan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Israelcuna, upami canqui.","poem":1},{"lineBreak":true},{"text":"Yuriy-aypa caycaj wamra ticshu caycajnömi caycanqui.","poem":1},{"lineBreak":true},{"text":"Yurinanpaj mana camacajnömi caycanqui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chayno caycarpis ¿wañunayquipita salbanätachuraj munarcaycanqui?","poem":1},{"lineBreak":true},{"text":"¿Wañunayquipita salbashayquichuraj?","poem":1},{"lineBreak":true},{"text":"Wañuy ¿maytaj wañuchicoj gueshyayqui?","poem":1},{"lineBreak":true},{"text":"Sepultüra ¿maytaj ushacächicoj munayniqui?","poem":1},{"lineBreak":true},{"text":"Shamuyna ari.","poem":1},{"lineBreak":true},{"text":"Canan mananami cuyapäshänachu cay runacunataga.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Jacha waytaraycajno Israelcuna captinpis","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi chunyaj chaqui jircapita fiyu wayrata wayrächimonga.","poem":1},{"lineBreak":true},{"text":"Chay wayrami chaquirachenga.","poem":1},{"lineBreak":true},{"text":"Wallcaycällarmi yacu aywajcuna, pucyuncunapis chaquicäconga.","poem":1},{"lineBreak":true},{"text":"Chiquejcunanami ima-aycancunatapis guechur apaconga.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tayta Diosninpa contran ricacushanpitami","poem":1},{"lineBreak":true},{"text":"Samaria runacunaga castigasha canga.","poem":1},{"lineBreak":true},{"text":"Sabliwan tucsiypami wañonga.","poem":1},{"lineBreak":true},{"text":"Wamrancunatapis pampaman pajshirgärenga.","poem":1},{"lineBreak":true},{"text":"Gueshyaj caycaj warmicunapa pachantapis gashargärengami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}