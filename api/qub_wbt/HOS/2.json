{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HOS","translationId":"qub_wbt","name":"OSEAS","commonName":"OSEAS","title":"Oseas","order":28,"numberOfChapters":14,"sha256":"858270a959476d7310448e835485f35f816c9567980c903528cf92fcd2d26944","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/qub_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Chaura gamcunaga ollgu cajcunata ninquipaj: «Diospa wamrancunami caycanqui» nir, warmi cajcunatana «Dios cuyapashancunami caycanqui» nir. Dios nishanta Israelcuna mana cumlishan Tayta Dios nin:"]},{"type":"verse","number":2,"content":[{"text":"«Israel nasyonga majänömi casha.","poem":1},{"lineBreak":true},{"text":"Chaymi wamräcuna mamayquita niy ‹Gammi juchayoj canqui.›","poem":1},{"lineBreak":true},{"text":"Cananpitaga pay manami nogapa warmënachu.","poem":1},{"lineBreak":true},{"text":"Ni nogapis manami runannachu cä.","poem":1},{"lineBreak":true},{"text":"Amana mañösa car pintacushancunawanpis pintacuchunnachu.","poem":1},{"lineBreak":true},{"text":"Mañösa car wallgarashancunatapis cachaycuchunna.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mana chayno ruraptenga quiquëmi pengaypaj garapachashaj.","poem":1},{"lineBreak":true},{"text":"Yurishantano galallatami cachaycushaj.","poem":1},{"lineBreak":true},{"text":"Chunyajmanmi ticrarachishaj.","poem":1},{"lineBreak":true},{"text":"Chayno rurar yacunaypitami wañuchishaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wamrancunatapis manami cuyapäshäpächu.","poem":1},{"lineBreak":true},{"text":"Chay wamrancunaga caycan jucwan-jucwan cacushanpitami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mamanga jucwan-jucwanmi cacusha.","poem":1},{"lineBreak":true},{"text":"Alli warmi cashantapis pirdichisha cayno nishpanmi:","poem":1},{"lineBreak":true},{"text":"‹Aywashaj cuyashäcunata ashej.","poem":1},{"lineBreak":true},{"text":"Paycunaga goman micuyta, yacuta, millwata, lïnuta, perfümitapis, upyanäpaj cajcunatapis› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Chayno cashanpitami purinan caminucunatapis chaparcushaj cashacunawan.","poem":1},{"lineBreak":true},{"text":"Intërupami guencharcushaj caminuta ashirpis manana tarinanpaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaura cuyashancunapa guepanta aywarpis","poem":1},{"lineBreak":true},{"text":"mananami taripanganachu.","poem":1},{"lineBreak":true},{"text":"Ashirpis manami tarenganachu.","poem":1},{"lineBreak":true},{"text":"Chayrämi nenga: ‹Cutishaj rimir caj runäman.","poem":1},{"lineBreak":true},{"text":"Paywan goyashpäga canan caycashäpita mas allimi carä› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ichanga pay manami cuentata gocuyta munashachu rïguta, bïnuta, asëtitapis noga tarichishäta.","poem":1},{"lineBreak":true},{"text":"Nogami guellayta goritapis aypallata tarichirä.","poem":1},{"lineBreak":true},{"text":"Chaycunapitami Baal dios-niraj ïdulucunata ruracarcärisha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaypitami cananga cutichicamushaj rïgöta, bïnöta.","poem":1},{"lineBreak":true},{"text":"Cusichaycashan örami apacamushaj.","poem":1},{"lineBreak":true},{"text":"Röpancunata rurananpaj tarichishä millwäta, lïnutapis shuntacurcushämi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Cuyashancuna ricapaycaptinmi garapächullata cachaycushaj.","poem":1},{"lineBreak":true},{"text":"Maquëpitaga manami pipis salbangachu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Cushicur goyashancunapis ushacangami.","poem":1},{"lineBreak":true},{"text":"Manami canganachu fistancuna, llullu quillacho rurashan fistacuna, säbadu jamay junajcuna, waquin fistacunapis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Cuchurachishämi übas yörancunata, ïgus yörancunatapis.","poem":1},{"lineBreak":true},{"text":"Chaycunapämi payga nej:","poem":1},{"lineBreak":true},{"text":"‹Cuyashäcuna pägamashpanmi caycunataga goycamasha› nir.","poem":1},{"lineBreak":true},{"text":"Chay chacrancunataga ushajpaj shatamanmi ticrarachishaj.","poem":1},{"lineBreak":true},{"text":"Chay chacran wayuptenga jirca animalcunanami micucurcongapaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Castigashaj ayca watapis Baal dios-niraj ïdulucunapaj saumachishanpitami.","poem":1},{"lineBreak":true},{"text":"Nogata cachaycamashpanmi wallgacunata, surtïjacunata jaticurcur","poem":1},{"lineBreak":true},{"text":"cuyashancunapa guepanta aywacuran.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Chaypitarämi, nogaga yapay cuyacurcushaj.","poem":1},{"lineBreak":true},{"text":"Chunyajman pushaycurmi","poem":1},{"lineBreak":true},{"text":"alli shimëpa parlapäshaj yapay cuyacarcamänanpaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaycho gayaptë pay wiyamanga jipash cashpan wiyamashanno,","poem":1},{"lineBreak":true},{"text":"Egiptupita llojshimushan öra imanömi caran, chayno.","poem":1},{"lineBreak":true},{"text":"Chaypitaga yapaymi cutichishaj übas chacrancunata.","poem":1},{"lineBreak":true},{"text":"Disigrasya päsashan Acor guechwatanami","poem":1},{"noteId":2},{"text":"ticrachishaj","poem":1},{"lineBreak":true},{"text":"bindisyunyoj cananpaj.»","poem":1}]},{"type":"verse","number":16,"content":["Tayta Diosmi cayno nin:",{"text":"«Chay wichanga ‹Tayta Baal› ninanpa ruquin ‹Gammi majä canqui› nimangami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Baal dios-niraj ïdulucunapa jutinta Israel rimanantaga yarpayninpitapis ushajpämi gongaycachishaj.","poem":1},{"lineBreak":true},{"text":"Chay juticunataga manami imaypis parlangapänachu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chay wichanga Israelcuna jauca goyänanpämi parlashaj","poem":1},{"lineBreak":true},{"text":"jirca animalcunawan, pärej äbicunawan, culebracunawan.","poem":1},{"lineBreak":true},{"text":"Cay nasyunpitaga lëchatapis, sablitapis illgächishämi.","poem":1},{"lineBreak":true},{"text":"Guërrapis manami canganachu.","poem":1},{"lineBreak":true},{"text":"Chayrämi acrashä runacunaga jauca goyäcongapaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chaypitaga nogapanami imaycamapis canquipaj.","poem":1},{"lineBreak":true},{"text":"Maquëcho captiquimi imaypis gamcunata cuyashayqui.","poem":1},{"lineBreak":true},{"text":"Manami yapapacuyllä warmichu canquipaj, sinöga lijïtimu caj warmëmi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nogaga mana cachaypanami chararäshayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaymi nogapis gampana cashäpaj.","poem":1},{"lineBreak":true},{"text":"Nogatanami ‹Tayta Diosnë› nimanquipaj.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chay wichanga nogami syëlupita allpaman tamyachimushaj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chaura allpanami alli wayuchenga rïguta, bïnuta, asëtita.","poem":1},{"lineBreak":true},{"text":"Chaycunawanmi Jezreelga alli cawanga.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Acrashä runacunaga quiquilläpänami canga.","poem":1},{"lineBreak":true},{"text":"Lo-ruhamatami cuyapäshäpaj.","poem":1},{"lineBreak":true},{"text":"Lo-amïtanami nishaj: ‹Gamga acrashämi canqui› nir.","poem":1},{"lineBreak":true},{"text":"Paynami nimanga ‹Gammi Diosnë canqui› nir.»","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Hebreo rimaycho Acor jutiga disigrasya ninanmi. Jos. 7.24–26.","reference":{"chapter":2,"verse":15}}]},"thisChapterLink":"/api/qub_wbt/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}