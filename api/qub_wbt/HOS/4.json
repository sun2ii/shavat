{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HOS","translationId":"qub_wbt","name":"OSEAS","commonName":"OSEAS","title":"Oseas","order":28,"numberOfChapters":14,"sha256":"858270a959476d7310448e835485f35f816c9567980c903528cf92fcd2d26944","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/qub_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Israelpa contran Tayta Dios rimashan"]},{"type":"verse","number":1,"content":[{"text":"Israel runacuna, wiyay-llapa Tayta Dios rimashanta.","poem":1},{"lineBreak":true},{"text":"Paymi cay nasyuncho tiyajcunapa contran rimaj-aywan.","poem":1},{"lineBreak":true},{"text":"Paymi cayno nin: «Rasun cajta rimaj runacuna caychöga manami canchu.","poem":1},{"lineBreak":true},{"text":"Mananami cuyapänacunnapischu.","poem":1},{"lineBreak":true},{"text":"Nogataga manami pipis ‹Tayta Diosnë› nimannachu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chaypa ruquenga runacuna manacajpita jurarcaycan.","poem":1},{"lineBreak":true},{"text":"Llullacuypa rimaycan.","poem":1},{"lineBreak":true},{"text":"Wañuchinacurcaycan.","poem":1},{"lineBreak":true},{"text":"Suwacurcaycan.","poem":1},{"lineBreak":true},{"text":"Majayoj caycar jucpa majanwan cacurcaycan.","poem":1},{"lineBreak":true},{"text":"Jananman-jananman wañuchinacuyllami caycan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chayno captinmi cay nasyonga chaquiycanna.","poem":1},{"lineBreak":true},{"text":"Cay nasyuncho tiyajcunana callpaynajno ricacurcaycan.","poem":1},{"lineBreak":true},{"text":"Jirca animalcunapis, äbicunapis,","poem":1},{"lineBreak":true},{"text":"lamarcho caj pescäducunapis wañurcaycanna.»","poem":1}]},{"type":"heading","content":["Cüracunapa contran Tayta Dios rimashan"]},{"type":"verse","number":4,"content":[{"text":"Tayta Dios nin: «Cüracuna, nogaga gamcunapa contrayquimi rimashaj.","poem":1},{"lineBreak":true},{"text":"Manami juccunatachu jitapaycä.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gamcunaga quiquiquicunapa juchayquipitami pagaspa junajpapis mana alliman chayanquipaj.","poem":1},{"lineBreak":true},{"text":"Profëtacunapis mana alliman tunengapaj.","poem":1},{"lineBreak":true},{"text":"Mamayquitanami illgarachishaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Acrashä runacunaga manami mayganpis ‹gammi Diosnë canqui› nimashachu.","poem":1},{"lineBreak":true},{"text":"Chaypitami paycunaga ushacaycan.","poem":1},{"lineBreak":true},{"text":"Ni gamcunapis cüracuna manami ‹Diosnë› nimashcanquinachu.","poem":1},{"lineBreak":true},{"text":"Chaypitami mana munänachu cürä canayquitapis.","poem":1},{"lineBreak":true},{"text":"Gamcunaga yachachicuynëta gongaycärishcanquimi.","poem":1},{"lineBreak":true},{"text":"Chaynöllami nogapis gongaycushaj gamcunapita mirar aywajcunata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mas achca cüracuna cashpanga masmi juchatapis ruraran.","poem":1},{"lineBreak":true},{"text":"Chayno juchanpitami cananga alliman churanäpa ruquin pengaymanna churashaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cüracunaga acrashä runacuna juchata rurashanwanmi mas alli goyan.","poem":1},{"lineBreak":true},{"text":"Chaynöpami paycunaga munarcaycan mas juchata rurananta.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Acrashä runacunatawan iwalmi cüracunatapis","poem":1},{"lineBreak":true},{"text":"castigashaj chayno rurashanpita.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nogata sirbiyta gongaycäramashanpitami","poem":1},{"lineBreak":true},{"text":"micurpis mana sacsangachu.","poem":1},{"lineBreak":true},{"text":"Pï-maywan cacuptinpis","poem":1},{"lineBreak":true},{"text":"wamrancuna mana cangapänachu.","poem":1}]},{"type":"heading","content":["Ïdulucunata adurajcunapaj rimashan"]},{"type":"verse","number":11,"content":[{"text":"«Pipis jucwan-jucwan cacushpan y","poem":1},{"lineBreak":true},{"text":"amatar upyarpis pasaypami pirdican.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Acrashä runacuna imatapis musyayta munar","poem":1},{"lineBreak":true},{"text":"guerupita rurasha ïdulucunatami tapucurcaycan.","poem":1},{"lineBreak":true},{"text":"Ïdulucunata adurayta munayllawanmi pantacäcusha.","poem":1},{"lineBreak":true},{"text":"Chaymi mañösa warminöpis gongaycamar juccunatana adurarcaycan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Altunnin puytush lömacunachömi insinsuta rupaycächin.","poem":1},{"lineBreak":true},{"text":"Uywacunatapis pishtarcaycan.","poem":1},{"lineBreak":true},{"text":"Chaynömi ruraycan ‹roble› yöracunapa,","poem":1},{"lineBreak":true},{"text":"‹álamo› yöracunapa, ‹encina› yöracunapa chaquinchöpis.","poem":1},{"lineBreak":true},{"text":"Chaymi warmi wamrancunaga pï-maywanpis cacun.","poem":1},{"lineBreak":true},{"text":"Llumchuynincunapis runancunata jucwan jananpaycan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Quiquiquicunapis mañösa warmicunawanmi cacuycanqui.","poem":1},{"lineBreak":true},{"text":"Chay warmicunawan ïdulucunata aduraj aywaycanqui.","poem":1},{"lineBreak":true},{"text":"Chayno caycaptiquega noga mananami castigashänachu piwanpis cacushanpita wamrayquicunata,","poem":1},{"lineBreak":true},{"text":"ni llumchuyniquicunatapis runancunata jucwan jananpashanpita.","poem":1},{"lineBreak":true},{"text":"Chaynöpami runacunaga Diosnin cashäta mana musyashpan mana alliman chayan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Israelcuna, ïdulucunata aduraptiquipis","poem":1},{"lineBreak":true},{"text":"Judäcunaga ama juchata rurachunnachu ari.","poem":1},{"lineBreak":true},{"text":"Gamcuna ama aywaychu Gilgalman ni Bet-avenmanpis.","poem":1},{"noteId":3},{"lineBreak":true},{"text":"Ama ‹Tayta Diospa jutincho jurä› niypischu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Israelcuna chucaru wäcano mana wiyacojmi carcaycanqui.","poem":1},{"lineBreak":true},{"text":"¿Chayno caycaptiquichu gamcunataga ricashayqui uysha-mallwacunata-jina?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Efraín runacunaga ïdulucunata aduraymanmi chayasha.","poem":1},{"lineBreak":true},{"text":"¡Mä chayno goyäcuchun ari!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Paycunaga upyananpaj mana captinnami warmicunaman aywacun.","poem":1},{"lineBreak":true},{"text":"Mandajnincunapis pengaypaj goyayllatami munan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chayno ïdulucunata adurashanpitami wayra shamushpan älancunacho apacongapaj.","poem":1},{"lineBreak":true},{"text":"Chayrämi pengaycho quëdangapäga.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Bet-avén ninanga jucha wasi ninanmi. Bet-avenpaj parlarga Betel marcapämi parlaran. Betelpaj chayno parlaran Tayta Diosta chaycho adurananpa ruquin Baal diostapis chaycho aduraptinmi.","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/qub_wbt/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}