{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HOS","translationId":"qub_wbt","name":"OSEAS","commonName":"OSEAS","title":"Oseas","order":28,"numberOfChapters":14,"sha256":"858270a959476d7310448e835485f35f816c9567980c903528cf92fcd2d26944","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/qub_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Mana wiyacushanpita Israelcuna castigasha cananpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"«Cüracuna, noga nishäta sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Israelpa mandajnincuna, wiyashpayqui sumaj tantiyacuy.","poem":1},{"lineBreak":true},{"text":"Raypa famillyan cajcunapis sumaj wiyacuy:","poem":1},{"lineBreak":true},{"text":"Gamcunatami jusgashayquipäga.","poem":1},{"lineBreak":true},{"text":"Gamcunaga Mizpacho cashcanqui tuninanpaj wascata churashanömi.","poem":1},{"lineBreak":true},{"text":"Tabor puntachöpis cashcanqui redanömi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sitim guechwachöpis cashcanqui chaquisha pösuno.","poem":1},{"lineBreak":true},{"text":"Chayno cashayquipitami gamcunataga castigashayquipaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Noga rejsëmi Efraín runacunata.","poem":1},{"lineBreak":true},{"text":"Israelcunatapis rejsëmi.","poem":1},{"lineBreak":true},{"text":"Efraín runacunaga jucmannami aywacusha.","poem":1},{"lineBreak":true},{"text":"Chaynöpami Israelcunaga ganrayasha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mana allita rurashpanmi","poem":1},{"lineBreak":true},{"text":"nishäta rurayta mana munannachu.","poem":1},{"lineBreak":true},{"text":"Jucman-jucman aduraj aywayta yachacasha cashpanmi","poem":1},{"lineBreak":true},{"text":"mana ‹Tayta Diosnë› nimannachu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alli-tucushanga quiquin mana alliman chayanallanpämi.","poem":1},{"lineBreak":true},{"text":"Efraín jutiyoj Israelcunaga quiquincuna mana allita rurashallanwanmi mana alliman chayanga.","poem":1},{"lineBreak":true},{"text":"Paycunawan iwalmi Judäpis mana alliman chayanga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sacrifisyuta nogapaj rupachinanpaj uyshancunata, wäcancunata apacurcurmi","poem":1},{"lineBreak":true},{"text":"Nogata ashimashpan purengapaj.","poem":1},{"lineBreak":true},{"text":"Chayno ashimashpanpis manami tarimangapächu.","poem":1},{"lineBreak":true},{"text":"Chaynöga canga noga cachaycushana captëmi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Noga willapashäta manami wiyacushachu.","poem":1},{"lineBreak":true},{"text":"Wamrancunapis caycan juc runapa churillannami.","poem":1},{"lineBreak":true},{"text":"Chaypitami paycunaga juc quillallacho chacrancunawan iwal llapan ushacanga.","poem":1}]},{"type":"heading","content":["Israeltawan Judäta castigananpaj cashan"]},{"type":"verse","number":8,"content":[{"text":"«Guërra gallaycunanpaj willacuna wagrata Gabaa siudächo tucay-llapa.","poem":1},{"lineBreak":true},{"text":"Trompëtata tucay Ramá siudächo.","poem":1},{"lineBreak":true},{"text":"Camaricunanpaj willacachiy Bet-avén siudächo.","poem":1},{"lineBreak":true},{"text":"Benjamín runacunatapis manchachiy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Castiganä junaj Efraín runacunaga ushajpämi ushacanga.","poem":1},{"lineBreak":true},{"text":"Rimashätaga rasunpami Israelcho cumlishaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Judá runacunapa mandajnincunaga carcaycan","poem":1},{"lineBreak":true},{"text":"chacrancunapa lindanta masta yapacurcoj runacunanömi.","poem":1},{"lineBreak":true},{"text":"Rabyaycashätami paycunaman chayachishaj aypalla yacutano.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efraín runacunaga fiyupami ñacarcaycan.","poem":1},{"lineBreak":true},{"text":"Chaynöga carcaycan mana bälej dioscunata adurayllapaj yarparashanpitami.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chayno cashanpitami, Efraín runacunapäga cashaj puyuno.","poem":1},{"lineBreak":true},{"text":"Judá runacunapäna cashaj mana allchacaj guerino.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Efraín runacunaga musyanmi gueshyarcaycashanta.","poem":1},{"lineBreak":true},{"text":"Judá runacunapis musyanmi gueriwan gueshyaycashanta.","poem":1},{"lineBreak":true},{"text":"Chaymi Efraín runacunaga aywaran Asiria nasyunman,","poem":1},{"lineBreak":true},{"text":"chay nasyunpa raynin yanapänanpaj ruwacushpan.","poem":1},{"lineBreak":true},{"text":"Chay rayga manami allchacächiranchu.","poem":1},{"lineBreak":true},{"text":"Ni guerincunatapis manami jampiparanchu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nogami ichanga Efraín runacunapäwan Judá runacunapäga cashaj","poem":1},{"lineBreak":true},{"text":"yargaypita liyun micunanpaj charishanno.","poem":1},{"lineBreak":true},{"text":"Paycunataga quiquëmi rachir-usharishaj.","poem":1},{"lineBreak":true},{"text":"Nircur aywacushämi.","poem":1},{"lineBreak":true},{"text":"Llapan charishä cajcunatami apacushaj.","poem":1},{"lineBreak":true},{"text":"Chay apashätaga manami pipis guechumangapächu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Nircur cuticushaj tiyanämanmi.","poem":1},{"lineBreak":true},{"text":"Chaycho cacushaj paycuna juchayoj cashanta reconösinancama, ashimaj shamunancama.","poem":1},{"lineBreak":true},{"text":"Fiyupa llaquicuycho caycashan örami ashimanga.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}