{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HOS","translationId":"qub_wbt","name":"OSEAS","commonName":"OSEAS","title":"Oseas","order":28,"numberOfChapters":14,"sha256":"858270a959476d7310448e835485f35f816c9567980c903528cf92fcd2d26944","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/qub_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Israelcuna Tayta Diosman cutiyta yarpashan"]},{"type":"verse","number":1,"content":[{"text":"Llapanchi shuntacäshun.","poem":1},{"lineBreak":true},{"text":"Nircur Tayta Diosninchïmanna cutishun.","poem":1},{"lineBreak":true},{"text":"Paymi rachir-usharamaranchi.","poem":1},{"lineBreak":true},{"text":"Chaymannömi allchacächimäshunpis.","poem":1},{"lineBreak":true},{"text":"Yawar-yawar ruramashcanchi.","poem":1},{"lineBreak":true},{"text":"Chaymannömi jampimäshunpis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ishcay junaj cajchöga cawananchïpaj jämaytami cutichimäshun.","poem":1},{"lineBreak":true},{"text":"Quimsa junaj cajchönami jatarachimäshun ñaupanchöna goyänanchïpaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diosman cutishun ari.","poem":1},{"lineBreak":true},{"text":"Cutiptinchëga Tayta Diosmi noganchïman shamongapaj.","poem":1},{"lineBreak":true},{"text":"Inti waran-waran yagamushannöpis Payga rasunpami shamonga.","poem":1},{"lineBreak":true},{"text":"Jachacuna chillguinan wichan,","poem":1},{"lineBreak":true},{"text":"waytanan wichan imaypis tamya tamyashanno rasunpami shamonga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tayta Dios nin: «¿Imataraj gamta ruraycömanpis Efraín?","poem":1},{"lineBreak":true},{"text":"¿Imataraj gamta ruraycömanpis Judá?","poem":1},{"lineBreak":true},{"text":"Gamcuna cuyamashayquega caycan tutapa pucutaraycar warämojno,","poem":1},{"lineBreak":true},{"text":"tutapa shullay warämur intiwan rätu illgacäcojnömi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chayno captiquimi willacuynë achquino caycajwan nogaga gamcunata tantiyachishcä juchayoj caycashayquita.","poem":1},{"lineBreak":true},{"text":"Chaymi profëtäcunawan willacarcachir gamcunata wañuchishcä.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogaga munä gamcuna rasunpa cuyamänayquitami.","poem":1},{"lineBreak":true},{"text":"Manami munächu imatapis nogata garamänayquitaga.","poem":1},{"lineBreak":true},{"text":"Nogaga munä ‹Diosnë› nimänayquitami.","poem":1},{"lineBreak":true},{"text":"Manami munächu sacrifisyupaj uywacunata nogapaj apamunayquita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Acrashä runacunaga Adannömi","poem":1},{"lineBreak":true},{"text":"parlashäcunata mana cumlishachu.","poem":1},{"lineBreak":true},{"text":"Nogataga ticrapamashami.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Galaad siudäga caycan mana allita rurajcunapa tiyananmi.","poem":1},{"lineBreak":true},{"text":"Chaychöga llapanpis carcaycan wañuchicuptin yawar pillchipashallami.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Cüracunaga carcaycan juc röpa suwacunanömi.","poem":1},{"lineBreak":true},{"text":"Paycunaga asaltanticuna pacarpaycajnömi carcaycan.","poem":1},{"lineBreak":true},{"text":"Shequemman näni aywajcunachömi mana allicunata rurarcaycan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Israelcunachöga ricashcä fiyupa melanaypaj mana allicunatami:","poem":1},{"lineBreak":true},{"text":"Efrainga jucwan-jucwanmi aywacusha.","poem":1},{"lineBreak":true},{"text":"Israelcunapis fiyupa ganrayasha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Judá, gampäpis maynami nishcä","poem":1},{"lineBreak":true},{"text":"imay junaj castigasha canayquipaj cashantapis.","poem":1},{"lineBreak":true},{"text":"Acrashä runacunapa surtinta ticrachiptë,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}