{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HOS","translationId":"qub_wbt","name":"OSEAS","commonName":"OSEAS","title":"Oseas","order":28,"numberOfChapters":14,"sha256":"858270a959476d7310448e835485f35f816c9567980c903528cf92fcd2d26944","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/qub_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"acrashä runacunata jampiptë, Efrainpawan Samariapa","poem":1},{"lineBreak":true},{"text":"juchancunaga alayrimi ricacan.","poem":1},{"lineBreak":true},{"text":"Paycunaga llullacuyllapämi yachacasha carcaycan.","poem":1},{"lineBreak":true},{"text":"Llapanpis suwallami. Wasicunamanpis suwacoj yagacaycärin.","poem":1},{"lineBreak":true},{"text":"Runacunata imantapis cällicunacho guechun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Paycunaga manami tantiyacunchu","poem":1},{"lineBreak":true},{"text":"llapan mana allita rurashancunata noga yarpaycashäta.","poem":1},{"lineBreak":true},{"text":"Quiquincunapa juchallanmi intërunpa tumaparaycan.","poem":1},{"lineBreak":true},{"text":"Imano juchan cashallantapis nogaga musyaycämi.","poem":1}]},{"type":"heading","content":["Mandajcuna mana allita rurashan"]},{"type":"verse","number":3,"content":[{"text":"«Acrashä runacuna mana allita ruraptinmi rayga cushisha mandan.","poem":1},{"lineBreak":true},{"text":"Acrashä runacuna llullacuptinmi mandajcunapis cushisha mandan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paycunaga llapanpis pasaypa shanaripacushami carcaycan.","poem":1},{"lineBreak":true},{"text":"Wayllasha jurnu mana gasashannömi carcaycan.","poem":1},{"lineBreak":true},{"text":"Tanta ruraj runa wayllasha jurnuta junta waycupaycur","poem":1},{"lineBreak":true},{"text":"manana waycapashannömi carcaycan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ray fistata ruraptin mandajcunaga fiyupa machänancama upyan.","poem":1},{"lineBreak":true},{"text":"Chaura raypis asipajcunatana gayan upyäshinanpaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mandajcunaga mana alliman chayachinan-cashallami rayman aywan.","poem":1},{"lineBreak":true},{"text":"Warayllatami yarpachacuycar wararcun warannin tuta raypa contran imano rurananpäpis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paycunaga jurnu rataycajno cashpanmi","poem":1},{"lineBreak":true},{"text":"autoridänincunatapis wañuchisha.","poem":1},{"lineBreak":true},{"text":"Raynincunatapis rucachisha.","poem":1},{"lineBreak":true},{"text":"Ichanga ni jucnayllapis manami canchu nogata mañacamäga.","poem":1}]},{"type":"heading","content":["Tayta Diosta gongaycärej runacuna"]},{"type":"verse","number":8,"content":[{"text":"«Efraín runacunaga jäpa runacunawanmi tallucasha.","poem":1},{"lineBreak":true},{"text":"Efraín runacunaga caycan gashpayllapa chayasha tantanömi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Israeltaga jäpa runacuna masta-mastana ushaycan.","poem":1},{"lineBreak":true},{"text":"Ichanga paycuna manami cuentata gocunchu.","poem":1},{"lineBreak":true},{"text":"Ajchancunapis soguyacäcushana.","poem":1},{"lineBreak":true},{"text":"Ichanga paycuna manami cuentata gocunchu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Imano carpis paycunaga manami yäracamashachu,","poem":1},{"lineBreak":true},{"text":"ni yarpämashapischu.","poem":1},{"lineBreak":true},{"text":"Israelcuna alli-tucushanga quiquincuna mana alli canallanpämi caycan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efraín runacunaga caycan upayasha caycaj palumanömi.","poem":1},{"lineBreak":true},{"text":"Egipto runacunata ruwacun yanapänanpaj.","poem":1},{"lineBreak":true},{"text":"Nircorga Asiriamanna aywan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aywaptinmi ichanga redäta jitashaj paycunapa jananman.","poem":1},{"lineBreak":true},{"text":"Janajpita äbicuna shicwajnömi shicwanga.","poem":1},{"lineBreak":true},{"text":"Mana allita rurashancunapitami castigashaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Ay, nogata gongaycamajcunaga imanöräshi canga.","poem":1},{"lineBreak":true},{"text":"Paycunaga illganga nogapa conträ ricacushanpitami.","poem":1},{"lineBreak":true},{"text":"Paycunaga nogapa conträmi llullacurcaycan.","poem":1},{"lineBreak":true},{"text":"Man'chäga noga salbämanmi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Cämancho gaparpashpanpis,","poem":1},{"lineBreak":true},{"text":"manami llapan shongunpa mañacamanchu.","poem":1},{"lineBreak":true},{"text":"Rïgun, bïnun achca cananpaj mañacur janancunatami yawar-yawar ruracun.","poem":1},{"lineBreak":true},{"text":"Chayno rurarmi nogapa conträ ricacusha.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nogami yachachirä.","poem":1},{"lineBreak":true},{"text":"Nogami callpayojyächirä.","poem":1},{"lineBreak":true},{"text":"Chayno yanapaycaptëmi paycunaga nogapa conträ parlacusha.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ïdulucunata adurayman churacasha.","poem":1},{"lineBreak":true},{"text":"Paycunaga carcaycan wicsu lëchano,","poem":1},{"lineBreak":true},{"text":"lëcha jitaj apuntashanman mana chayajnömi.","poem":1},{"lineBreak":true},{"text":"Ollgur parlashanpitami","poem":1},{"lineBreak":true},{"text":"mandajnincunaga cuchuypa wañuchicanga.","poem":1},{"lineBreak":true},{"text":"Egiptuchöpis paycunataga manacajman churashpanmi asipanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}