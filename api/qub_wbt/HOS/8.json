{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HOS","translationId":"qub_wbt","name":"OSEAS","commonName":"OSEAS","title":"Oseas","order":28,"numberOfChapters":14,"sha256":"858270a959476d7310448e835485f35f816c9567980c903528cf92fcd2d26944","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/qub_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Ïdulucunata adurashanpita Israel castigasha cananpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"«¡Ricachacoj, trompëtata tucay!","poem":1},{"lineBreak":true},{"text":"Acrashä runacuna cajmanmi juc anca aywaycämun.","poem":1},{"lineBreak":true},{"text":"Aywaycämun acrashä runacuna conträtuta rurar parlashäta mana cumlishanpitami,","poem":1},{"lineBreak":true},{"text":"yachachishäcunata mana wiyacushanpitami.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chayno caycarpis gaparpashpan nogata mañacaycäman yanapänäpaj,","poem":1},{"lineBreak":true},{"text":"‹¡Gamga canqui Tayta Diosnëmi!› nir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ichanga Israelcuna manami munashachu alli cajta.","poem":1},{"lineBreak":true},{"text":"Chaypitami chiquinacushancunaga gaticachanga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paycunaga nogata mana tapucamayllapami raynincunata churacarcärisha.","poem":1},{"lineBreak":true},{"text":"Noga mana auniycaptëmi mandajnincunatapis churacarcärisha.","poem":1},{"lineBreak":true},{"text":"Guellaynincunatawan gorincunata shuntarcur ïduluncunata ruracarcärisha.","poem":1},{"lineBreak":true},{"text":"Chaynöpami paycunaga mana alliman chayanga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Samaria, gam adurashayqui törutaga fiyupami melanäcö!","poem":1},{"lineBreak":true},{"text":"Chaytaga fiyupami rabyapaycä.","poem":1},{"lineBreak":true},{"text":"Israelcuna ¿imaycamaraj jucha rurayta mana cachanquichu?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Samariacho caycaj töruga manami dioschu!","poem":1},{"lineBreak":true},{"text":"Chaytaga ruray yachajllami rurasha.","poem":1},{"lineBreak":true},{"text":"Chay törutaga acapa-acapami paquirengapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Paycunaga wayratami murusha, löcu wayratana shuntangapis.","poem":1},{"lineBreak":true},{"text":"Rïguncuna manami wayonganachu.","poem":1},{"lineBreak":true},{"text":"Mana wayuptin jarinapis manami canganachu.","poem":1},{"lineBreak":true},{"text":"Ichiclla cajllantapis juc-lä jäpa runacunami micucarcärenga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Israelga ushacaypanami aywaycan.","poem":1},{"lineBreak":true},{"text":"Juc-lä nasyun runacunaga manacajtanöllanami rican,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"mana tantiyaj chucaru bürruno Asiriaman aywashanpita.","poem":1},{"lineBreak":true},{"text":"Efraín runacunaga aunisha Asiriacuna yanapaptin pägananpämi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chayno pägar alli parlacusha caycaptinpis","poem":1},{"lineBreak":true},{"text":"castiganäpaj may-chaypitapis cutichimushämi.","poem":1},{"lineBreak":true},{"text":"Chaymi munayniyoj raypa maquincho ñacar goyanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Efraín runacunaga achca altarcunatami rurasha juchanta raquinanpaj.","poem":1},{"lineBreak":true},{"text":"Ichanga chay altarnincuna casha masta juchata ruranallanpämi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Paycunapaj laycunata isquirbisha captëpis","poem":1},{"lineBreak":true},{"text":"paycunaga manami cäsushachu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Paycunaga amatarmi munan uywacunata pishtapämayta.","poem":1},{"lineBreak":true},{"text":"Nircur pishtashan uywacunapa aychantaga micucarcärin.","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosga manami cushicöchu chayno rurashanpita.","poem":1},{"lineBreak":true},{"text":"Mana allita rurashancunatami yarpäshaj.","poem":1},{"lineBreak":true},{"text":"Juchanpita castigashpämi","poem":1},{"lineBreak":true},{"text":"Egiptuman cutichishaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Israelcunaga gongaycärishami paycunata pï camashantapis.","poem":1},{"lineBreak":true},{"text":"Chaymi paycunaga capillacunallatana arurcaycan.","poem":1},{"lineBreak":true},{"text":"Judá runacunana achca siudäcunata arur jatariycächin.","poem":1},{"lineBreak":true},{"text":"Chay siudänincunamanmi nogaga ninata sindipaycoj-aywä.","poem":1},{"lineBreak":true},{"text":"Chauraga llapan arushantapis ruparmi ushacurcongapaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}