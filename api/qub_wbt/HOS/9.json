{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"HOS","translationId":"qub_wbt","name":"OSEAS","commonName":"OSEAS","title":"Oseas","order":28,"numberOfChapters":14,"sha256":"858270a959476d7310448e835485f35f816c9567980c903528cf92fcd2d26944","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/qub_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Israelcuna castigasha cananpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"Israel runacuna, mañösa warmi runanta cachaycojnömi","poem":1},{"lineBreak":true},{"text":"gamcunapis Tayta Diosta cachaycushcanqui.","poem":1},{"lineBreak":true},{"text":"Päguta chasquinanpaj warmi runawan puñushan pengaypaj cashannömi","poem":1},{"lineBreak":true},{"text":"gamcunapis cosëchayqui alli cananta munar juc diosman yäracushayqui pengaypaj caycan.","poem":1},{"lineBreak":true},{"text":"Chayno caycarga cosëchata shuntashayquipita ama cushicuychu.","poem":1},{"lineBreak":true},{"text":"Waquin nasyun runacunanöga cushicuypita ama pinticachaychu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chaypitami Israel runacuna, gamcunapäga mana cangapänachu rïgupis ni bïnupis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gamcunaga Tayta Dios acrashan nasyunchöpis manami tiyanquipänachu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquin Efraín runacunaga yapay cutenga Egiptumannami.","poem":1},{"lineBreak":true},{"text":"Asiriachönami miconga mana micunanpaj nishä micuycunata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tayta Diostaga bïnutapis manami garanquipänachu.","poem":1},{"lineBreak":true},{"text":"Uywacunatapis manami pishtapanquipänachu.","poem":1},{"lineBreak":true},{"text":"Micushayqui tantaga canga wañupacur micunan tantanöllanami.","poem":1},{"lineBreak":true},{"text":"Pipis chay tantata micoj cäga ganranami cangapaj.","poem":1},{"lineBreak":true},{"text":"Chay tantataga quiquiquicunallami micunquipaj.","poem":1},{"lineBreak":true},{"text":"Manami allichu canga Tayta Diosta garanayquipäga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Imataraj ruranqui gamcunaga Tayta Diosta aduranayqui diyacho?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Illgächinanpita gueshpir aywacusha captiquipis","poem":1},{"lineBreak":true},{"text":"Egipto runacunami shuntashunquipaj.","poem":1},{"lineBreak":true},{"text":"Menfis partichönami pampashunquipaj.","poem":1},{"lineBreak":true},{"text":"Guellaypita caj bälej cösayquicunapa jananpapis ishancacunami wiñamonga.","poem":1},{"lineBreak":true},{"text":"Tiyashayqui particunapis shatayangami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Chayamushanami juchayquiman-tupu castiganäpaj caj junajcuna.","poem":1},{"lineBreak":true},{"text":"Israelcuna, musyanquipänami castïgu mayna chayamushanta.","poem":1},{"lineBreak":true},{"text":"Gamcunaga nircaycanqui: «Profëtaga upami, löcuyaycanmi» nir.","poem":1},{"lineBreak":true},{"text":"Chaynöga nircaycanqui fiyupa juchasapa cashpayquimi, fiyupa chiquicushpayquimi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Diosga profëtanta churasha Efraín runacunata ricananpämi.","poem":1},{"lineBreak":true},{"text":"Chaypis gamcunaga chay willacoj mana alliman chayananpaj trampata churaparcaycanqui.","poem":1},{"lineBreak":true},{"text":"Intëru Israelchöpis chiquircaycanqui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gabaacho cashan wichannömi gamcunaga pasaypana pirdicasha carcaycanqui.","poem":1},{"lineBreak":true},{"text":"Tayta Dios ichanga mana alli rurashayquicunata llapanta yarparaycan.","poem":1},{"lineBreak":true},{"text":"Chaymi llapan juchayquicunapita castigashunquipaj.","poem":1}]},{"type":"heading","content":["Juchanpita Israelcuna ñacananpaj cashan"]},{"type":"verse","number":10,"content":[{"text":"Tayta Dios nin: «Israelta tariycushpäga fiyupami cushicurä,","poem":1},{"lineBreak":true},{"text":"chunyaj chaqui jircacho übasta tariycur cushicojnöraj.","poem":1},{"lineBreak":true},{"text":"Awiluncunaga noga ricaptë casha rimir-puntata pogoj ïguscunanömi.","poem":1},{"lineBreak":true},{"text":"Baal-peorman chayaycärirmi ichanga mana dios cajcunata ‹diosnë› nir aduraran.","poem":1},{"lineBreak":true},{"text":"Chaynöpami paycunaga pengayman churacaran.","poem":1},{"lineBreak":true},{"text":"Cuyashan ïduluncunano melanaypaj ricacuran.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efraín runacuna alliman chayashanga ushacangapaj äbi pärir aywacojnömi.","poem":1},{"lineBreak":true},{"text":"Wamrancunapis manami masga canganachu.","poem":1},{"lineBreak":true},{"text":"Mananami warmincunapis gueshyaj ricaconganachu.","poem":1},{"lineBreak":true},{"text":"Manami masga wawata tarenganachu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yurejllan wamrancunata uywaptinpis nogaga ushajpämi guechurishaj.","poem":1},{"lineBreak":true},{"text":"¡Wawallau caycho caycaj runacuna!","poem":1},{"lineBreak":true},{"text":"Noga witicuriptë mä imanöshi canga.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Efraín runacunaga wamrancunata ruraycan","poem":1},{"lineBreak":true},{"text":"jirca animalta charejcuna rurashannömi.","poem":1},{"lineBreak":true},{"text":"Wasinpita jorgapaycan wañuchicojcunawan wañuchichinanpämi.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Castigay Tayta Dios, ichanga ¿imawanraj castiganqui?","poem":1},{"lineBreak":true},{"text":"Paycunapa warmincunaga amana wawatapis tarichunnachu.","poem":1},{"lineBreak":true},{"text":"Warmincunapa chuchuncunapis chaquichunna.","poem":1}]},{"type":"heading","content":["Efraín runacunapaj Tayta Dios rabyacurcushan"]},{"type":"verse","number":15,"content":[{"text":"Tayta Diosmi cayno nin: «Gilgalchömi gamcunaga rurarayqui fiyupa mana allita.","poem":1},{"lineBreak":true},{"text":"Chaychömi gamcunata chiquiyta gallaycurä.","poem":1},{"lineBreak":true},{"text":"Mana allita rurashayquipitami tiyaycashayquipita jitarishayqui.","poem":1},{"lineBreak":true},{"text":"Chaypitami manana masga cuyaycäshayquipänachu.","poem":1},{"lineBreak":true},{"text":"Llapan mandajniquicunapis mana wiyacojllanami.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Efraín runacunaga caycan gueshyaj-tucushami.","poem":1},{"lineBreak":true},{"text":"Paycunaga caycan sapin chaquisha manana wayoj frütanömi.","poem":1},{"lineBreak":true},{"text":"Wamrancuna captinpis nogaga ushajpämi wañuchishaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Cay marca runacunaga Tayta Diosnëta manami wiyacushachu.","poem":1},{"lineBreak":true},{"text":"Chaypitami llapanta jitarenga.","poem":1},{"lineBreak":true},{"text":"Intëru nasyuncunachömi puricachallar tiyanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}