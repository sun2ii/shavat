{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":1,"content":[{"type":"heading","content":["Judá runacuna juchasapa cashan"]},{"type":"verse","number":1,"content":["Amospa wamran Isaiastami Tayta Dios ribilaran Judá nasyunwan capitalnin Jerusalén imano cananpaj cashantapis. Chaycunataga ribilaran Judá nasyuncho Uzías, Jotam, Acaz, Ezequías ray cashan wichanmi."]},{"type":"verse","number":2,"content":[{"text":"Janaj pacha, cay pacha","poem":1},{"lineBreak":true},{"text":"Tayta Dios cayno nishanta wiyay:","poem":1},{"lineBreak":true},{"text":"«Wamräcunatami rucuyänancama uywashcä.","poem":1},{"lineBreak":true},{"text":"Rucuyarcurnaga chiquicarcamashana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuntaga duyñunta rejsinmi.","poem":1},{"lineBreak":true},{"text":"Bürrupis rejsinmi duyñun mayman garanantapis.","poem":1},{"lineBreak":true},{"text":"Israelcunami ichanga acrashä caycarpis","poem":1},{"lineBreak":true},{"text":"mana rejsimanchu ni tantiyacunpischu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ay imanöraj canqui juchasapa runacuna,","poem":1},{"lineBreak":true},{"text":"mana allita rurar jucha aparicoj runacuna,","poem":1},{"lineBreak":true},{"text":"juchasapacunapita mirajcuna,","poem":1},{"lineBreak":true},{"text":"pirdicasha wamracuna.","poem":1},{"lineBreak":true},{"text":"Gamcunaga Tayta Diospitami witicurishcanqui.","poem":1},{"lineBreak":true},{"text":"Israelcunapa Santo Diosnintami manacajman churashcanqui.","poem":1},{"lineBreak":true},{"text":"Paytaga gongaycärishcanquinami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Imapänataj mastaga castigasha caytapis munanqui?","poem":1},{"lineBreak":true},{"text":"¿Jinallarächu mana wiyacoj caycanqui?","poem":1},{"lineBreak":true},{"text":"Cuerpuyquipis manami jäcunnachu maynincho astinäpäpis.","poem":1},{"lineBreak":true},{"text":"Umayquipis intëru rachishallanami.","poem":1},{"lineBreak":true},{"text":"Imata ruranayquipäpis gänasniqui manami cannachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaqui-puntayquipita umayquicama manami sänuga canquinachu.","poem":1},{"lineBreak":true},{"text":"Intëruyquipis gueri-guerillanami, goyuy-goyuyllami, däñashallami caycanqui.","poem":1},{"lineBreak":true},{"text":"Manami pipis jampipäshurayquichu ni watapäshurayquipischu.","poem":1},{"lineBreak":true},{"text":"Nanayniqui chawananpaj asëtiwan manami pipis churapäshurayquichu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nasyunniquipis chunyajmi quëdasha.","poem":1},{"lineBreak":true},{"text":"Siudäniquicunachöpis wararaylla ninallanami rataycan.","poem":1},{"lineBreak":true},{"text":"Ricaparcaycaptiquimi murupacushayquitapis chiquishojcuna micucarcärin.","poem":1},{"lineBreak":true},{"text":"Chiquejcuna illgächishannömi llapan chunyaj quëdasha.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sionga japallannami quëdasha.","poem":1},{"lineBreak":true},{"text":"Übas chacra chaupincho chuclla tiyaraycajno,","poem":1},{"lineBreak":true},{"text":"calbäsa wayuraycaj chacra chaupincho jucnaylla ramäda caycajno,","poem":1},{"lineBreak":true},{"text":"japallan siudäta chiquejcuna intëru cantunpa tumaparaycashannömi quëdasha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Dios noganchïta juc ishcayllatapis cawaycajta mana cachaycamashaga","poem":1},{"lineBreak":true},{"text":"canan öra caycashwan caran Sodomawan Gomorra quëdashannönami.","poem":1}]},{"type":"heading","content":["Tayta Diosta imano sirbina cashanpis"]},{"type":"verse","number":10,"content":[{"text":"Sodomata mandajcuna cashanno caycajcuna, wiyay Tayta Dios nishanta.","poem":1},{"lineBreak":true},{"text":"Gomorra runacuna cashanno caycajcuna sumaj wiyay Tayta Dios yachachishunayquipaj caycashanta.","poem":1}]},{"type":"verse","number":11,"content":["Tayta Diosga caynömi nin:",{"text":"«¿Imapänataj chaychica uywacunata garamanqui?","poem":1},{"lineBreak":true},{"text":"Yamacashanami caycä sacrifisyu uyshacunata nogapaj rupachishayquipita,","poem":1},{"lineBreak":true},{"text":"törucunapa wiranta rupachishayquipitapis.","poem":1},{"lineBreak":true},{"text":"Fiyupami melanäcö törucunapa, uyshacunapa, chïbucunapa yawarninta.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Imapänataj nogapa ñaupäman shamunquipis?","poem":1},{"lineBreak":true},{"text":"¿Pitaj nisha-cashunqui wasi puncöman uywacunata apamunayquipaj?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Manacajcunataga amana garamaynachu.","poem":1},{"lineBreak":true},{"text":"Goshtaynin fiyupami melanächiman.","poem":1},{"lineBreak":true},{"text":"Gamcuna llullu quilla fistata, säbadu jamay junaj fistata rurashayquicunata manami awantächu.","poem":1},{"lineBreak":true},{"text":"Nogaga manami awantächu juchasapacuna fistata rurar shuntacashanta.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Llullu quilla fistata rurashayquicunata, shuntacarcur fistacunata rurashayquitapis melanäcömi.","poem":1},{"lineBreak":true},{"text":"Chayno rurashayquitaga manami awantänachu.","poem":1},{"lineBreak":true},{"text":"Pasaypanami yamacashcä.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gamcuna maquiquita jogaricurcur mañacamaptiquipis","poem":1},{"lineBreak":true},{"text":"gamcunapitaga juc-läpami ticracurë.","poem":1},{"lineBreak":true},{"text":"Yaparir-yaparir mañacamuptiquipis","poem":1},{"lineBreak":true},{"text":"Nogaga mananami wiyashänachu.","poem":1},{"lineBreak":true},{"text":"Gamcunapaga maquiquipis wañuchicushayqui yawarllami caycan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mayllacuyna-llapa.","poem":1},{"lineBreak":true},{"text":"Mana allicunataga amana ruraynachu.","poem":1},{"lineBreak":true},{"text":"Gongaycäriyna-llapa mana alli ruraycunataga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Allillatana rurayta yachacuy ari.","poem":1},{"lineBreak":true},{"text":"Rasun cajllatana ruranayquipaj sumaj yarpachacuy ari.","poem":1},{"lineBreak":true},{"text":"Ñacaycajcunata yanapay.","poem":1},{"lineBreak":true},{"text":"Alli cajta rurashpayqui wacchacunata alli arriglay.","poem":1},{"lineBreak":true},{"text":"Biyüdacunatapis yanapay.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Tayta Diosmi nin:",{"text":"«Shamuy-llapa. Cananmi sumaj parlar alli tantiyashun.","poem":1},{"lineBreak":true},{"text":"Puca fiyupa tiñicashano gamcuna juchayoj captiquipis,","poem":1},{"lineBreak":true},{"text":"Nogami limyuyächishayqui rashtanöna yuraj canayquipaj.","poem":1},{"lineBreak":true},{"text":"Muräduman tiñisha tëlano captiquicunapis,","poem":1},{"lineBreak":true},{"text":"Nogami limyuyächishayqui merïnu millwano yuraj canayquipaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Llapan nishäta wiyacorga","poem":1},{"lineBreak":true},{"text":"chacrayquicho micuy wayojtapis allinnin cajtami micunquicunapaj.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Imaypis chaynölla mana wiyacoj cashpayquimi ichanga","poem":1},{"lineBreak":true},{"text":"imanöpa gueshpiyta munarpis guërracho wañunquipaj.»","poem":1},"Quiquin Tayta Diosmi chayno nisha."]},{"type":"heading","content":["Jerusalenta Tayta Dios limyuyächenga"]},{"type":"verse","number":21,"content":[{"text":"Ñaupata alli goyaj Jerusalén runacuna, imanöshi pirdicashcanqui.","poem":1},{"lineBreak":true},{"text":"Ñaupataga llapaniquimi rasun cajllata rurarayqui.","poem":1},{"lineBreak":true},{"text":"Allillata rurarmi goyarayquipis.","poem":1},{"lineBreak":true},{"text":"Cananga llapaniquipis wañuchicojllamanmi ticrashcanquipis.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gamcunaga carayqui guellay bälejnömi.","poem":1},{"lineBreak":true},{"text":"Cananmi ichanga carcaycanqui mana sirbej ganrano.","poem":1},{"lineBreak":true},{"text":"Gamcunaga carayqui alli bïnunömi.","poem":1},{"lineBreak":true},{"text":"Cananmi ichanga carcaycanqui yacu yapasha bïnuno.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mandajniquicunapis Tayta Diosta manami wiyacunchu.","poem":1},{"lineBreak":true},{"text":"Paycunaga suwacunapa amiställanmi.","poem":1},{"lineBreak":true},{"text":"Paycunaga munarcaycan pacayllapa päguta chasquiytami.","poem":1},{"lineBreak":true},{"text":"Munarcaycan imapitapis imallatapis päganantami.","poem":1},{"lineBreak":true},{"text":"Wacchacunataga manami alli arriglanchu.","poem":1},{"lineBreak":true},{"text":"Biyüdacuna dimandacuptinpis manami cäsunchu.","poem":1}]},{"type":"verse","number":24,"content":["Chaypitami, Israelcunapa munayniyoj Tayta Diosnin cayno nin:",{"text":"«Cananmi ichanga chiquimajcunataga jusgashayqui imallata rurashayquipitapis.","poem":1},{"lineBreak":true},{"text":"Gamcunataga ayñitami cutichishayqui.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yapaymi castigashayqui.","poem":1},{"lineBreak":true},{"text":"Gamcunacho ganra caycajtapis lijyawan mayllajnömi limyuyächishayqui.","poem":1},{"lineBreak":true},{"text":"Ganrayquitami jorgushaj.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Unay alli juezniqui cashannömi yapay alli juezniquicuna canga.","poem":1},{"lineBreak":true},{"text":"Tantiyachishojniquicunapis unay cashannömi yapay canga.","poem":1},{"lineBreak":true},{"text":"Chayno noga camacächiptëga yapaymi nishunquipaj:","poem":1},{"lineBreak":true},{"text":"‹Jerusalenchöga alli runacunami tiyan› nir, ‹Diosninta wiyacoj runacunami› nir.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Sión runacunata salbanan junäga llapan rurashanpitami jusganga.","poem":1},{"lineBreak":true},{"text":"Salbacoj cajcunaga allillata rurashpan Tayta Diosllamannami yapay yäraconga.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mana wiyacojcunawan juchasapacunami ichanga wañuchicanga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta gongaycoj cajcunaga llapanmi wañonga.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Fiyupa cuyashayqui yöracunata ricar pengacunquipämi.","poem":1},{"lineBreak":true},{"text":"Cuyashayqui wertacunata ricaptiqui pengacuyllawanmi cärayquicunapis pucayacäcongaraj.","poem":1},{"lineBreak":true},{"text":"Chay particunachömi gamcunaga ïdulucunata adurarcaycanqui.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gamcunaga canquipaj yörapa öjancuna garwashtar shicwajnömi,","poem":1},{"lineBreak":true},{"text":"yacunpita werta chaquiycajnömi.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Callpayoj runaga ricacongapaj ogshanöllami.","poem":1},{"lineBreak":true},{"text":"Imata arushancunapis canga lliptano yangallami.","poem":1},{"lineBreak":true},{"text":"Chaynömi runaga arushanwan iwal rupanga.","poem":1},{"lineBreak":true},{"text":"Chay ninata upichinanpäga manami pipis cangapächu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}