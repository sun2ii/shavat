{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":10,"content":[{"type":"heading","content":["Israelpa mandajnincunapaj willapashan"]},{"type":"verse","number":1,"content":[{"text":"¡Ay imanöraj canga mana allita rurananpaj layta rurajcuna,","poem":1},{"lineBreak":true},{"text":"pipis cumliyta mana puydinanpaj caj layta rurajcuna!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Paycunaga pobricunata mana allimi rican.","poem":1},{"lineBreak":true},{"text":"Ñacarcaycajtapis manami alliga arriglanchu.","poem":1},{"lineBreak":true},{"text":"Biyüdacunapa ima-aycantapis guechun.","poem":1},{"lineBreak":true},{"text":"Wacchacunata suwapan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chayno car gamcunaga ¿imataraj ruranquipaj jusgashushayqui öra?","poem":1},{"lineBreak":true},{"text":"Carupita castïgu chayashuptiqui ¿pitaraj mañacunqui?","poem":1},{"lineBreak":true},{"text":"Riquësayquicunatapis ¿maymanraj churanqui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ima ruraytapis mana camäpacur prësunami aywanquipaj;","poem":1},{"lineBreak":true},{"text":"man'chäga wañojcunawan iwalmi wañunquipaj.","poem":1},{"lineBreak":true},{"text":"Chaypis, Tayta Dios rabyashanpitaga manami allchacanrächu.","poem":1},{"lineBreak":true},{"text":"Payga jinallarämi castigananpaj rimaycan.","poem":1}]},{"type":"heading","content":["Tayta Diospa magacunan Asiria cashan"]},{"type":"verse","number":5,"content":[{"text":"«¡Ay imanöraj canga Asiriapa raynin! ¡Manami musyanrächu!","poem":1},{"lineBreak":true},{"text":"Payga caycan rabyasha car pitapis castigacuna guerömi.","poem":1},{"lineBreak":true},{"text":"Payga caycan ollgur pitapis wirucuna guerömi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paytami cachä acrashä juchasapa runacunata magananpaj.","poem":1},{"lineBreak":true},{"text":"Rabyachimaj nasyun runacunamanmi cachä.","poem":1},{"lineBreak":true},{"text":"Chayman cachä ima-aycantapis suwapänanpaj, guechunanpaj,","poem":1},{"lineBreak":true},{"text":"cällicho caycaj mituta-jina lluchcargärinanpämi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ichanga Asiriapa raynin manami chaynöchu yarpan.","poem":1},{"lineBreak":true},{"text":"Ni imanillarpis manami tantiyacunchu.","poem":1},{"lineBreak":true},{"text":"Payga achca nasyuncunata illgächiyllatami yarpaycan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaymi payga nin: ‹Llapan raycunapis munaynillächömi caycan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nogaga charishcä Calno siudätapis Carquemis siudätanöllami;","poem":1},{"lineBreak":true},{"text":"Hamat siudätapis Arfad siudätanöllami,","poem":1},{"lineBreak":true},{"text":"Samaria siudäpis Damasco siudätanöllami.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Achca nasyuncunatami charishcä aypalla diosniyojta.","poem":1},{"lineBreak":true},{"text":"Jerusalencho Samariacho cashanpita mas aypalla ïduluncuna captinpis binsishcämi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Samariata, diosnintinta imanöpis rurasha caycarga","poem":1},{"lineBreak":true},{"text":"¿manachuraj chayno ruräman Jerusalentawan ïduluncunatapis?› nir.»","poem":1}]},{"type":"verse","number":12,"content":["Sión lömatawan Jerusalenta Asiriapa rayninwan ushaycacherga paytapis Tayta Dios castigangami. Castiganga alli-tucushanpita, ollgoj car munayniyoj-tucushanpita."]},{"type":"verse","number":13,"content":["Asiriapa raynenga nisha:",{"text":"«Nogaga callpäwanmi llapantapis rurashcä.","poem":1},{"lineBreak":true},{"text":"Yarpaysapa carmi imano ruranäpäpis camacächishcä.","poem":1},{"lineBreak":true},{"text":"Nasyuncunapa lindancunatapis illgächishcä.","poem":1},{"lineBreak":true},{"text":"Llapan riquësancunatapis charicurcushcä.","poem":1},{"lineBreak":true},{"text":"Jinyu caynëwanmi raycunatapis binsishcä.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Juc-lä nasyun runacunapa riquësancunatapis charicurcushcä.","poem":1},{"lineBreak":true},{"text":"Llapan nasyuntami munaynëcho cananpaj charishcä,","poem":1},{"lineBreak":true},{"text":"äbi runtunta gueshwacho cacharishanta shuntajno.","poem":1},{"lineBreak":true},{"text":"Chayno ruraptë manami pipis michämashachu.","poem":1},{"lineBreak":true},{"text":"Manami pipis rimacushachu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ichanga ¿mutuycaj runapita jächa mas munayniyoj-tucunmanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Cuchuycajpita rusadörapis mas munayniyoj-tucunmanchuraj?","poem":1},{"lineBreak":true},{"text":"¡Tucrucuycaj runata tucruga manami munashanpa apanmanchu!","poem":1},{"lineBreak":true},{"text":"¡Shauya guerupis mas lasajtaga manami awantanmanchu!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chaypitami munayniyoj Tayta Diosga","poem":1},{"lineBreak":true},{"text":"fiyupa callpayojcunata gueshyawan gueshyachenga.","poem":1},{"lineBreak":true},{"text":"Rispitananpa ruquin ninawan rupachenga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Israelcunapaj achquino caycaj Santo Tayta Diosmi","poem":1},{"lineBreak":true},{"text":"nina rataycajmanno ticracurengapaj.","poem":1},{"lineBreak":true},{"text":"Nircorga juc junajllachömi Asiria runacunata illgarachengapaj","poem":1},{"lineBreak":true},{"text":"cashata shatata nina rupacurcushanno.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ushajpämi illgächenga cuyayllapaj muntincunata, wertancunatapis.","poem":1},{"lineBreak":true},{"text":"Gueshyawan gueshyaycaj runa callpaynaj caycajtanönami cachayconga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chauraga muntichöpis wallcallanami guerucuna quëdanga.","poem":1},{"lineBreak":true},{"text":"Quëdaj guerucunataga wamrallapis yupanganami.","poem":1}]},{"type":"heading","content":["Quëdajcuna cutimunanpaj cashan"]},{"type":"verse","number":20,"content":[{"text":"Chay wichanga wallcallapis quëdaj Israel runacuna","poem":1},{"lineBreak":true},{"text":"mananami Asiria runacunaman yäracongapänachu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga yäraconga Israelpa Santo Diosnillanmannami.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chay quëdaj Jacob famillyacunaga","poem":1},{"lineBreak":true},{"text":"munayniyoj Tayta Diosllamannami yäraconga.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Israel runacuna lamar cantuncho agushnöraj aypalla cashpanpis","poem":1},{"lineBreak":true},{"text":"wallcajllanami cutimonga.","poem":1},{"lineBreak":true},{"text":"Paycunataga Tayta Diosmi jusganga.","poem":1},{"lineBreak":true},{"text":"Illgächinanpaj camacächishanami caycan.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Diosmi mayna nisha illgächinanpaj.","poem":1},{"lineBreak":true},{"text":"Nishantaga llapantami nasyun intërucho cumlenga.","poem":1}]},{"type":"verse","number":24,"content":["Munayniyoj Tayta Diosmi nin:",{"text":"«Sioncho tiyaycaj acrashä runacuna,","poem":1},{"lineBreak":true},{"text":"ama manchacuychu Asiria runacunataga","poem":1},{"lineBreak":true},{"text":"guerucunawan magashuptiqui; bastunnincunawan wirushuptiqui","poem":1},{"lineBreak":true},{"text":"Egipto runacuna rurashushayquino rurashuptiquipis.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ichanga cananpita manapis aycällatanami gamcunapaj rabyasha caycashäpita allchacäshaj.","poem":1},{"lineBreak":true},{"text":"Nircorga Asiriacunatanami fiyupa rabyashpä illgächishaj.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Noga munayniyoj Tayta Dios Madián runacunata Oreb gagacho binsishänömi castigashaj.","poem":1},{"lineBreak":true},{"text":"Munayniyoj cashätapis Asiria runacunata musyachishaj Egipto runacunata musyachishänömi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Chay junäga jorgushäpaj lasaj guepita aparipäshushayquitami.","poem":1},{"lineBreak":true},{"text":"Yüguta matancayquiman churapäshushayquitapis paquirishäpaj.»","poem":1}]},{"type":"heading","content":["Asiria runacuna pillyananpaj chayaycashan"]},{"type":"verse","number":28,"content":[{"text":"Asiria suldärucunaga Ajat partimannami chayaycämun.","poem":1},{"lineBreak":true},{"text":"Migrón partipami aywaycämun.","poem":1},{"lineBreak":true},{"text":"Micmas partimanmi guepincunata churaycan.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mayuta päsaycämun.","poem":1},{"lineBreak":true},{"text":"Geba partichöna pachacun.","poem":1},{"lineBreak":true},{"text":"Ramá runacuna fiyupa manchariycan.","poem":1},{"lineBreak":true},{"text":"Saúl tiyashan Gabaacho tiyajcunaga gueshpir aywacuycan.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"¡Gaparay ari Bat-galim runacuna!","poem":1},{"lineBreak":true},{"text":"¡Chayta wiyay ari Laisa runacuna!","poem":1},{"lineBreak":true},{"text":"¡Ay imanöraj canga Anatot marca runacuna!","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Madmena runacuna machiypa-machir gueshpir aywacun.","poem":1},{"lineBreak":true},{"text":"Gebim runacunana pacacaycärin.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Canan örami Asiriacunaga Nobcho jamaycärin.","poem":1},{"lineBreak":true},{"text":"Nircorga chaycho camariconga Jerusalenpa jircan Sionman magaj imano yaycunanpäpis.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ricay-llapa Asiria runacunata. Paycunaga jatun guerucunanömi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga munayninwanmi chay guerucunata sajtargärin.","poem":1},{"lineBreak":true},{"text":"Jatusajnin caj guerucunatapis muturishanami.","poem":1},{"lineBreak":true},{"text":"Mas jatunnin cajcunapis pampachönami jitarpaycan.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Jächawan mutuypami sajtargärin jirasha caycaj muntitapis.","poem":1},{"lineBreak":true},{"text":"Libanucho mas cuyayllapaj caj guerucunapis ñitinacur-ñitinacur paquicar aywacun.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}