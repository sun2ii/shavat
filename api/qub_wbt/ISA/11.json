{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":11,"content":[{"type":"heading","content":["Davidpita miraj mandananpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"Tumpupitaga chillguinmi.","poem":1},{"lineBreak":true},{"text":"Chaynöllami Davidpa papänin Isaïpitapis juc ray yurenga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Paychöga Tayta Diospa Espiritunmi caycangapaj.","poem":1},{"lineBreak":true},{"text":"Chaymi yachaj canga; yarpaysapa canga;","poem":1},{"lineBreak":true},{"text":"yarpachacuycur imatapis ruranga; callpasapa canga;","poem":1},{"lineBreak":true},{"text":"musyaj canga; Tayta Diosta rispitanga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Payga Tayta Diosta rispitashpanmi fiyupa cushiconga.","poem":1},{"lineBreak":true},{"text":"Payga manami ricärillarchu jusganga.","poem":1},{"lineBreak":true},{"text":"Castigacänanpäpis manami jucpa shimillanwanchu nenga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pipis mana yanapashancunata alli arriglanga.","poem":1},{"lineBreak":true},{"text":"Nasyuncho caj pobricunatapis rispitacachenga.","poem":1},{"lineBreak":true},{"text":"Paymi nenga ñacachicojcuna castigacänanpaj.","poem":1},{"lineBreak":true},{"text":"Paypa jämaynenga espädanömi fiyucunata wañurachenga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pay imaypis alli cajllata, rasun cajllata ruraj cashanmi canga","poem":1},{"lineBreak":true},{"text":"chegllanta watacunanno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Chauraga atojpis uyshawan tallushanami purengapaj.","poem":1},{"lineBreak":true},{"text":"Tinriwan cabra-mallwapis iwalmi puñongapaj.","poem":1},{"lineBreak":true},{"text":"Besërawan liyunpis iwalmi caycangapaj.","poem":1},{"lineBreak":true},{"text":"Chaycunataga juc wamrallanami michengapis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wäcapis ösupa läduncho micur goyäconga.","poem":1},{"lineBreak":true},{"text":"Wawancunapis iwalmi goturpangapaj.","poem":1},{"lineBreak":true},{"text":"Liyunpis buyinömi guewatana micongapaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lätaycaj wamranami pucllanga fiyupa benënuyoj culebrapa uchcuncho.","poem":1},{"lineBreak":true},{"text":"Chayraj wasguisha wamrapis maquinta jatenga culebrapa gueshtanman.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Jerusalenchöga mananami pipis mana allita ruranganachu.","poem":1},{"lineBreak":true},{"text":"Imanömi lamarcho yacu juntan,","poem":1},{"lineBreak":true},{"text":"chaynömi cay pachachöpis Tayta Diosta rispitaj runacunallana juntasha canga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chay wichanga","poem":1},{"lineBreak":true},{"text":"tumpuno caycaj Isaïpita mirar aywaj yurejmi","poem":1},{"lineBreak":true},{"text":"llapan runacunata shuntanga.","poem":1},{"lineBreak":true},{"text":"Llapan nasyun runacunami payta ashej aywanga.","poem":1},{"lineBreak":true},{"text":"Pay caycashannami fiyupa rispitädu cangapaj.","poem":1}]},{"type":"heading","content":["Prësu aywajcuna cutimunanpaj cashan"]},{"type":"verse","number":11,"content":[{"text":"Chay wichanga Tayta Dios yapaymi acrashan runacunata shuntanga.","poem":1},{"lineBreak":true},{"text":"Cutichimonga Asiriapita, Egiptupita,","poem":1},{"lineBreak":true},{"text":"Patrospita, Etiopiapita, Elampita,","poem":1},{"lineBreak":true},{"text":"Sinarpita, Hamatpita, lamar cantunpa caj nasyuncunapitapis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Señalwanmi nasyuncunata musyachenga.","poem":1},{"lineBreak":true},{"text":"Nircorga prësu aywaj Israelcunata shuntamonga.","poem":1},{"lineBreak":true},{"text":"Judá runacunataga wacpa-caypa machicasha caycajta","poem":1},{"lineBreak":true},{"text":"intërupita shuntamonga.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Efraín runacunaga mananami Judá runacunata chiquipanganachu.","poem":1},{"lineBreak":true},{"text":"Judá runacunapis mananami Efraín runacunata rabyapanganachu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ishcan nasyunnami aywanga inti yaganan caj-lächo caycaj Filistea nasyunman.","poem":1},{"lineBreak":true},{"text":"Paycunata magananpaj yagaparconga.","poem":1},{"lineBreak":true},{"text":"Inti yagamunan caj-lächo tiyajcunapatapis","poem":1},{"lineBreak":true},{"text":"ishcanmi ima-aycantapis guechumonga.","poem":1},{"lineBreak":true},{"text":"Chaynöpami paycunapa maquinchöna canga","poem":1},{"lineBreak":true},{"text":"Edom runacunapis, Moab runacunapis, Amón runacunapis.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Diosmi nänita camaripanga Puca Lamar chaupinpa.","poem":1},{"lineBreak":true},{"text":"Éufrates mayu jananpanami maquinta jogarconga.","poem":1},{"lineBreak":true},{"text":"Nircorga fiyupa manchariypaj wayrächimonga.","poem":1},{"lineBreak":true},{"text":"Chay wayranami yacutaga ganchis pachapa raquirengapaj.","poem":1},{"lineBreak":true},{"text":"Chaura runacunaga llanguintapis mana jorguyllapanami yacuta päsangapaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Israelcuna unay Egiptupita llojshicamur jatun näninpa shamushannömi","poem":1},{"lineBreak":true},{"text":"Asiriacho quëdajcunaga jatun nänipa cutimongapaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}