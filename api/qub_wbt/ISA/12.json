{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":12,"content":[{"type":"heading","content":["Diosta agradësicur alabashan"]},{"type":"verse","number":1,"content":["Chay wichanga ninquipaj:",{"text":"«Gamta agradësicömi Tayta Dios.","poem":1},{"lineBreak":true},{"text":"Nogapaj fiyupa rabyashami caycarayqui.","poem":1},{"lineBreak":true},{"text":"Cananga rabyashayquipita allchacashcanquinami.","poem":1},{"lineBreak":true},{"text":"Allinami goyaycächimanqui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Diosmi salbaman.","poem":1},{"lineBreak":true},{"text":"Payman yäracurmi imapitapis mana manchacöchu.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi callpata goman, imapitapis pacaman.","poem":1},{"lineBreak":true},{"text":"Paymi salbamajnë.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gamcunapis cushicushpayqui aywanquipaj","poem":1},{"lineBreak":true},{"text":"salbasyunta tarichicoj pashtaj yacuta upoj.","poem":1}]},{"type":"verse","number":4,"content":["Chayrämi ninquipaj:",{"text":"«Tayta Diosta agradësicuy.","poem":1},{"lineBreak":true},{"text":"Paypaj willacuy.","poem":1},{"lineBreak":true},{"text":"Imata rurashantapis intëru marcacunaman willacuy.","poem":1},{"lineBreak":true},{"text":"Tantiyachiy Tayta Dioslla llapanpita mas munayniyoj cashanta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Diosta alabar cantay-llapa.","poem":1},{"lineBreak":true},{"text":"Payga fiyupa almiraypajcunatami rurasha.","poem":1},{"lineBreak":true},{"text":"Chaytaga cay pachacho caj runacuna intërucho musyanman.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sioncho tiyajcuna, cushicuypita gaparpay, cantay.","poem":1},{"lineBreak":true},{"text":"Chayno ruranqui Israelpa Santo Tayta Diosnin gamcunacho fiyupa munayninwan captinmi.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}