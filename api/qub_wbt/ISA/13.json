{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":13,"content":[{"type":"heading","content":["Babilonia imano cananpäpis rimashan"]},{"type":"verse","number":1,"content":["Amozpa wamran Isaiastami Tayta Dios ribilaran shamoj watacunacho Babilonia nasyun imano cananpaj cashantapis."]},{"type":"verse","number":2,"content":[{"text":"¡Jachaynaj gala puntacho señalta jawiy pillyayta gallaycärinanpaj!","poem":1},{"lineBreak":true},{"text":"¡Suldärucunata niy pillyaj yaycunanpaj!","poem":1},{"lineBreak":true},{"text":"¡Yaycunan puncupa Babiloniapa mandajnincuna yaycunanpaj","poem":1},{"lineBreak":true},{"text":"maquiquiwan sëñata ruray-llapa!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nogata sirbimajcunata maynami gayashcä.","poem":1},{"lineBreak":true},{"text":"Acrashä pillyay yachaj jinyu runacunata cachashcänami paycunawan castigachinäpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Masqui wiyay. Aypalla runacuna shuntacasha cashanmi puntacunapita wiyacaycämun.","poem":1},{"lineBreak":true},{"text":"Masqui wiyay. Achca nasyun runacuna shuntacaycur gaparashanmi wiyacaycämun.","poem":1},{"lineBreak":true},{"text":"Munayniyoj Tayta Diosmi shuntaycan","poem":1},{"lineBreak":true},{"text":"pillyaman aywananpaj camaricusha caycaj suldäruncunata.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Caru nasyunpitami aywarcaycämun.","poem":1},{"lineBreak":true},{"text":"Allpapa cuchun syëlupa chaquinpitami aywaycämun.","poem":1},{"lineBreak":true},{"text":"Chay aywaycämöga Tayta Dios rabyar castigacunanmi.","poem":1},{"lineBreak":true},{"text":"Runacunata ushajpaj illgarachinanpämi aywaycämun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Llaquicur shanaypa shanar gaparpay-llapa.","poem":1},{"lineBreak":true},{"text":"Munayniyoj Tayta Dios castigananpäga wallcanami pishiycan.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga llapantami usharenga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chay öraga llapan runapami ricrancunapis warcucäcongana.","poem":1},{"lineBreak":true},{"text":"Llapanpami balurninpis mana canganachu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fiyupa mancharishami ricacongapaj.","poem":1},{"lineBreak":true},{"text":"Fiyupa llaquicuymi charengapaj.","poem":1},{"lineBreak":true},{"text":"Cuerpuncunapis fiyupami nanacuycongapaj.","poem":1},{"lineBreak":true},{"text":"Chauraga warmi nanaycho caycajnörämi milluycachangapis.","poem":1},{"lineBreak":true},{"text":"Jucninpis-jucninpis mancharishami ricapänacongapaj.","poem":1},{"lineBreak":true},{"text":"Pengacuyllawan cärancunapis pucayacäcongapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tayta Dios castiganan junäga chayaycämunnami.","poem":1},{"lineBreak":true},{"text":"Chay junäga manchariypämi cangapaj.","poem":1},{"lineBreak":true},{"text":"Tayta Dios fiyupa rabyasha cashpanmi cay pachataga ticrarachengapaj chunyaj chaqui jircaman.","poem":1},{"lineBreak":true},{"text":"Cay pachacho caj juchasapacunataga ushajpämi illgächengapaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Intipis yagarcamullarnami chacacäconga.","poem":1},{"lineBreak":true},{"text":"Quillapis mananami achicyanganachu.","poem":1},{"lineBreak":true},{"text":"Goyllarcunapis manami achicyanganachu.","poem":1},{"lineBreak":true},{"text":"Janaj pachaga pasaypa yanauyaycajmi ricacongapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Tayta Diosmi nin:",{"text":"«Allpacho tiyajcunataga ushajpämi illgächishaj.","poem":1},{"lineBreak":true},{"text":"Mana allita rurashanpitami runata castigashaj.","poem":1},{"lineBreak":true},{"text":"Mana rispitacojcunatawan alli-tucojcunatapis pengaymanmi churashaj.","poem":1},{"lineBreak":true},{"text":"Alli-tucoj fiyu runacuna manami canganachu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nogami camacächishaj runacunaga","poem":1},{"lineBreak":true},{"text":"Ofircho alli caj gorinöpis juc ishcayllana quëdananpaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chay öraga syëlupis chucchongami.","poem":1},{"lineBreak":true},{"text":"Cay pachapis cuyurishpan caycashanpita witengami.","poem":1},{"lineBreak":true},{"text":"Chaynöga cangapaj chay junaj fiyupa rabyaptëmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Chay öra runaga Babiloniapita cada-ünunmi nasyunninman-cama gueshpir cuticonga.","poem":1},{"lineBreak":true},{"text":"Cada-ünunmi marcanman-cama cuticongapaj.","poem":1},{"lineBreak":true},{"text":"Chay runacuna ricaconga gaticachaptin lluychu gueshpiycajnörämi.","poem":1},{"lineBreak":true},{"text":"Uyshëruynaj juc röpa uysha mancharisha cörriyllapa gueshpiycajno canga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chay junäga pitapis pacaraycajta tarerga tucsirengami.","poem":1},{"lineBreak":true},{"text":"Pitapis charir wañurachengami.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Taytan maman ricapaycaptinmi","poem":1},{"lineBreak":true},{"text":"tacsha wamrancunataga pampaman pagshirgärengapaj.","poem":1},{"lineBreak":true},{"text":"Wasincho caj ima-aycantapis apacongapaj.","poem":1},{"lineBreak":true},{"text":"Warmintapis yaycoj fiyu runacunami charipacongapaj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Paycunaman pillyaj shamunanpämi Media jutiyoj nasyun runacunata shacyächej-aywä.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga manami guellaypäga yarpanchu.","poem":1},{"lineBreak":true},{"text":"Ni gori captinpis manami cäsupanchu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mösucunatapis lëchawanmi wañurgärachenga.","poem":1},{"lineBreak":true},{"text":"Manami cuyapangachu chayraj yurisha caycaj iticunatapis.","poem":1},{"lineBreak":true},{"text":"Manami llaquipangachu jatullan wamracunatapis.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Babiloniaga waquin nasyuncunapaj caycan perlasnörämi.","poem":1},{"lineBreak":true},{"text":"Caldea runacunapäga fiyupa bälej perlasnömi caycan.","poem":1},{"lineBreak":true},{"text":"Chayno carpis Babiloniaga illgächiptë quëdangapaj Sodoma Gomorra quëdashannömi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chaychöga imaypis manami runa tiyanganachu.","poem":1},{"lineBreak":true},{"text":"Yapayga mananami pipis tiyanganachu.","poem":1},{"lineBreak":true},{"text":"Arabia runacunapis chaychöga manami pachaconganachu.","poem":1},{"lineBreak":true},{"text":"Uyshërucunapis chaychöga mananami uywancunata jamachenganachu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chaychöga oshgu mishicunallanami tiyanga.","poem":1},{"lineBreak":true},{"text":"Wasicunachöpis tucucunallanami tiyanga.","poem":1},{"lineBreak":true},{"text":"Avestruzcunallanami tiyanga.","poem":1},{"lineBreak":true},{"text":"Jacha cabracunallanami pañangapis.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Palasyucunachöpis atojcunallami aullar tiyanga.","poem":1},{"lineBreak":true},{"text":"Alli palasyucunachöpis jirca animalcunallami tiyanga.","poem":1},{"lineBreak":true},{"text":"Babilonia nasyunpaga öran chayaycämunnami.","poem":1},{"lineBreak":true},{"text":"Manami aycäpis pishinnachu.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}