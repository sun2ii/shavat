{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":14,"content":[{"type":"heading","content":["Prësu aywajcuna cutimunanpaj cashan"]},{"type":"verse","number":1,"content":["Israelcunata Tayta Diosga cuyapangami. Paycunaga yapaymi canga acrashan runacunana. Chaynöpami yapay camacächenga Israelcuna nasyunninman tiyaj cutinanpaj. Juc-lä nasyun runacunapis paycuna cajmanmi aywanga. Nircur Israelcunawanga iwalnami tiyanga."]},{"type":"verse","number":2,"content":["Israelcunataga achca nasyun runacunami jamachenga. Nircorga nasyunnincama yan'ganga. Tayta Dios acrashan partichönami Israelcunaga uywayninman ticrachenga chay runacunata. Israelcunanami prësu apanga ñaupata paycunata prësu apajcunataga. Ñaupata ñacachejcunatapis paycunanami mandanga."]},{"type":"heading","content":["Babiloniapa rayninta manacajman churashan"]},{"type":"verse","number":3,"content":["Israelcuna, ñacaycashayquipita uywayno fiyupa sirbircaycashayquipita Tayta Dios jamachishunquipämi."]},{"type":"verse","number":4,"content":["Chauraga Babiloniapa rayninta manacajman churashpayqui cayno rimanquipaj:",{"text":"«¡Masqui ricay, ñaupata ñacachicöga imanöshi caycan!","poem":1},{"lineBreak":true},{"text":"¡Ricay, imanöshi caycan chay fiyu runaga!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Diosga paquishami fiyu runacuna mandar charashan bäranta.","poem":1},{"lineBreak":true},{"text":"Fiyu mandajcunapa munaynintapis ushacächishami.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paycunaga juc-lä nasyun runacunata fiyupami ñacachej.","poem":1},{"lineBreak":true},{"text":"Mana cachaypami wirur-ushaj.","poem":1},{"lineBreak":true},{"text":"Mana cuyapaypami gaticachaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Cananmi ichanga intërucho cushisha mana yarpachacuypana goyarcaycan.","poem":1},{"lineBreak":true},{"text":"Chaymi cushicuypita cantarcaycan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mana alliman chayashayquipitaga Libanucho caycaj sedruwan pïno guerucunapis cushicunmi.","poem":1},{"lineBreak":true},{"text":"Chaymi nin: ‹Babiloniapa raynin mana alliman chayashanpitaga","poem":1},{"lineBreak":true},{"text":"mananami pipis mutumanchïnachu› nir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wañojcunanami pacha rurincho ricaj-ricajlla shuyarpaycäshunqui.","poem":1},{"lineBreak":true},{"text":"Wañojcuna jatarisha gamta taripäshunayquipaj.","poem":1},{"lineBreak":true},{"text":"Wañoj mandajcunapis aywaycämun taripashunayquipaj.","poem":1},{"lineBreak":true},{"text":"Sillunninpita jatarircaycämun gamta chasquicushunayquipaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paycunaga jucnin-jucnin tapushunquipaj:","poem":1},{"lineBreak":true},{"text":"‹¿Gampapis callpayquega ushacashana au?","poem":1},{"lineBreak":true},{"text":"Cananga nogacunanöllanami caycanqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Cananga pï-maypita rispitasha cashayquipis ushacashanami.","poem":1},{"lineBreak":true},{"text":"Cushicunanpaj tacsha arpacunatapis manami tucannachu.","poem":1},{"lineBreak":true},{"text":"Caychöga cämayquipis canga ismushayquimi.","poem":1},{"lineBreak":true},{"text":"Jacuyquipis canga curucunallanami.›","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Pacha waray yagamoj Waraj","poem":1},{"lineBreak":true},{"text":"imanöshi syëlupita shicwamushcanqui.","poem":1},{"lineBreak":true},{"text":"Gamga achca nasyuncunatami binsirayqui.","poem":1},{"lineBreak":true},{"text":"Cananga quiquiquitanami pampaman sajtashurayqui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gamga shongullayquicho nej canqui:","poem":1},{"lineBreak":true},{"text":"‹Syëlucamami chayashaj.","poem":1},{"lineBreak":true},{"text":"Diospa estrëllancunapa jananchömi jamanäta rurashaj.","poem":1},{"lineBreak":true},{"text":"Fiyupa caru norte caj-lächo jamaycurmi mandashaj.","poem":1},{"lineBreak":true},{"text":"Dioscuna shuntacänan jircachömi jamaräshaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mas altucho caycaj pucutaypa jananmanmi wichäshaj.","poem":1},{"lineBreak":true},{"text":"Nogaga janaj pachacho caycaj Diosnönami cashaj› nir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Chayno yarparpis chayashcanqui wañushacuna caycashanmanmi!","poem":1},{"lineBreak":true},{"text":"¡Pacha rurinchöpis mas rurimanrämi chayashcanqui!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ricashojcunaga chiyacashami ricapäshunqui.","poem":1},{"lineBreak":true},{"text":"Ricapäshushpayqui nin:","poem":1},{"lineBreak":true},{"text":"‹¿Caychi allpatapis chucchuchej runa?","poem":1},{"lineBreak":true},{"text":"¿Caychi llapan nasyuncunatapis illgächej runa?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¿Cay runachi intëru pachata chunyajta cachaycoj,","poem":1},{"lineBreak":true},{"text":"siudäcunatapis illgächej,","poem":1},{"lineBreak":true},{"text":"prësucunatapis mana cacharej?› nir.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nasyuncunapa raynincunaga llapanpis pamparashan uchcucunachömi cushisha pamparäcun.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gamtami ichanga mana pampashurayquichu.","poem":1},{"lineBreak":true},{"text":"Pampacho jitaraycarmi ayayqui quëdasha.","poem":1},{"lineBreak":true},{"text":"Ganratanömi lluchcacur ushashurayqui.","poem":1},{"lineBreak":true},{"text":"Nircorga guërracho wañusha quëdajcunatanömi ragraman garpurishurayqui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gamtaga manami waquin raycunatanöchu pampashunquipaj","poem":1},{"lineBreak":true},{"text":"nasyunniquita mana alliman churashayquipita,","poem":1},{"lineBreak":true},{"text":"marca-masiquicunata wañuchishayquipita.","poem":1},{"lineBreak":true},{"text":"Mana allita rurajcunapita mirajcunataga","poem":1},{"lineBreak":true},{"text":"manami pipis yarpanganachu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chay ray fiyu cashanpita wamrancunata wañuchiy.","poem":1},{"lineBreak":true},{"text":"Chaura chay wamrancunaga manami yarpanganachu nasyuncunapa mandajnin cayta,","poem":1},{"lineBreak":true},{"text":"ni intërucho siudäcunata ruraytapis.»","poem":1}]},{"type":"verse","number":22,"content":["Munayniyoj Tayta Diosmi nin:",{"text":"«Babiloniata ushajpämi illgächishaj.","poem":1},{"lineBreak":true},{"text":"Chaycho quëdajcunataga wamrancunatapis willcancunatapis ushajpämi wañuchishaj.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Chay partitaga ticrarachishaj mitu-mitu gochamannami,","poem":1},{"lineBreak":true},{"text":"chushyajcuna tiyanallanmannami.","poem":1},{"lineBreak":true},{"text":"Illgächicuna pichanawanmi illgächiypa pichashaj.»","poem":1},{"lineBreak":true},{"text":"Munayniyoj Tayta Diosmi chayno nisha.","poem":1}]},{"type":"heading","content":["Asiria imano cananpäpis rimashan"]},{"type":"verse","number":24,"content":["Munayniyoj Tayta Diosmi jurashpan nisha:",{"text":"«Yarpashänöllami rasunpa canga.","poem":1},{"lineBreak":true},{"text":"Nishänöllami llapanpis canga.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Acrashä nasyunchömi Asiria runacunataga ushajpaj illgächishaj.","poem":1},{"lineBreak":true},{"text":"Altu puntäcunachömi ñitirishaj.","poem":1},{"lineBreak":true},{"text":"Acrashä runacunata yügu ñacachishanno manami ñacachenganachu.","poem":1},{"lineBreak":true},{"text":"Lasaj guepita apachishanno manami ñacachenganachu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Cay pachacho caj nasyuncunapäga chayno cananpämi nishcä.","poem":1},{"lineBreak":true},{"text":"Llapan nasyun runacunata castiganäpämi caycä.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Manami pipis michämangachu.","poem":1},{"lineBreak":true},{"text":"Pipis mananami jucno cananpaj yarpächimanganachu.","poem":1},{"lineBreak":true},{"text":"Noga Munayniyoj Tayta Diosmi chayno nishcä.»","poem":1}]},{"type":"heading","content":["Filistea imano cananpäpis rimashan"]},{"type":"verse","number":28,"content":["Ray Acaz wañushan watachömi Tayta Dios ribilashanta Isaías willacuran:"]},{"type":"verse","number":29,"content":[{"text":"Filistea nasyun runacuna ama cushicuychu","poem":1},{"lineBreak":true},{"text":"magaycäshushayqui Asiriapa raynin juc bastun paquejno wañushanpita.","poem":1},{"lineBreak":true},{"text":"Juc culebra llojshishan uchcupita mas benënuyoj culebranami llojshimonga.","poem":1},{"lineBreak":true},{"text":"Chaypa guepanmanga mas fiyupa benënuyoj buylaj culebrapis llojshimongami.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Pobricunapäga cangapämi uyshancunata michinanpaj guewapis.","poem":1},{"lineBreak":true},{"text":"Imanpis mana caj runapis cushishami goyangapaj.","poem":1},{"lineBreak":true},{"text":"Ichanga Tayta Dios camacächenga gam tiyashayqui nasyun runacuna yargaypita wañunanpaj.","poem":1},{"lineBreak":true},{"text":"Cawaycar quëdaj cajcunatapis ushajpämi Tayta Dios wañuchenga.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"¡Filistea runacuna llapayqui llaquicuy!","poem":1},{"lineBreak":true},{"text":"¡Nanaywan gaparpay! ¡Manchariywan sicsicyay!","poem":1},{"lineBreak":true},{"text":"Norte caj-läpitami suldärucuna aywaycämun pucutayno jirca ñitejraj.","poem":1},{"lineBreak":true},{"text":"Fïlanpa aywaycämushanpitaga manami ni juc runapis llojshinchu.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Chay nasyun runacunapa cachancunataga ¿imatataj nishwan?","poem":1},{"lineBreak":true},{"text":"Paycunataga nishun: «Sión lömataga Tayta Diosmi sumaj camacächisha.","poem":1},{"lineBreak":true},{"text":"Acrashan runacunacho ñacajcunapis chaymanmi pacaconga» nir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}