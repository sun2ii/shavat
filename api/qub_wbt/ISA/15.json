{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":15,"content":[{"type":"heading","content":["Moab imano cananpäpis rimashan"]},{"type":"verse","number":1,"content":["Moab nasyun imano cananpäpis Tayta Dios ribilashanta Isaías willacuran:",{"text":"Moab nasyuncho caycaj Ar siudätaga illgächengami.","poem":1},{"lineBreak":true},{"text":"¡Juc chacayllachömi illgächenga!","poem":1},{"lineBreak":true},{"text":"Moab nasyuncho caycaj Kir siudätaga illgächengami.","poem":1},{"lineBreak":true},{"text":"¡Juc chacayllachömi illgächenga!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nebo, Medeba siudäcuna ushajpaj illgashanpitami","poem":1},{"lineBreak":true},{"text":"Moab runacunaga fiyupa llaquiconga.","poem":1},{"lineBreak":true},{"text":"Diboncho tiyaj runacuna wagaj aywanga","poem":1},{"lineBreak":true},{"text":"puytush lömacho caycaj capillacunaman.","poem":1},{"lineBreak":true},{"text":"Llaquicur llapanpis ajchan rutucusha,","poem":1},{"lineBreak":true},{"text":"shapran jichcacusha carcaycanga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Läsacunachöpis llapan llaquicurcaycanga, wagarcaycanga.","poem":1},{"lineBreak":true},{"text":"Wasin janancunachöpis nanaywan gaparpaycanga.","poem":1},{"lineBreak":true},{"text":"Cällinpapis runacunaga purenga gachga röpasha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hesbonchöwan Elealecho tiyajcunami yanapänanpaj mañaconga.","poem":1},{"lineBreak":true},{"text":"Paycuna gaparpashanga Jahazacamami wiyacanga.","poem":1},{"lineBreak":true},{"text":"Chaymi Moab nasyunpa pillyay yachaj suldäruncunaga imata ruraytapis mana camäpaconganachu.","poem":1},{"lineBreak":true},{"text":"Fiyupami mancharircaycangapaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Shongömi fiyupa gayacun Moabta yanapänanpaj.","poem":1},{"lineBreak":true},{"text":"Chaycho tiyaj runacunami gueshpir aywaconga Zoarcama, Eglat-selisiyacama.","poem":1},{"lineBreak":true},{"text":"Luhitman wichänapami wagashpan aywangapaj.","poem":1},{"lineBreak":true},{"text":"Llapan ushacashanpitami Horonaimman näni aywajpa aywashpan nanächicuypa gaparpaycanga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nimrimcho caj yacu pösucunapis chaquengami.","poem":1},{"lineBreak":true},{"text":"Guewacunapis wañuytacäcongami.","poem":1},{"lineBreak":true},{"text":"Manami ima jachapis canganachu.","poem":1},{"lineBreak":true},{"text":"Jachacuna berdiraycäga manami jucnayllapis cangachu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaymi runacunaga ima-aycantapis guepiconga.","poem":1},{"lineBreak":true},{"text":"Nircurmi apanga Wayau ragrapa mas wash'ganman.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Shanariypa shanarir wagashanga wiyacanga intëru Moab nasyunpami Eglaimcama, Beer-elimcama.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dimoncho caj yacucunaga llapanpis yawarwan tacushallami caycangapaj.","poem":1},{"lineBreak":true},{"text":"Mas piyur fiyupa mana allicunawanrämi paycunataga Tayta Dios castiganga.","poem":1},{"lineBreak":true},{"text":"Chay nasyuncho cawaycar quëdaj Moab runacunataga liyunmi micur ushacurcongapaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}