{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":16,"content":[{"type":"heading","content":["Moab runacuna Judäman pacacunanpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"Cay pachapa mandajninpäga","poem":1},{"lineBreak":true},{"text":"Sión lömaman apachiy manta uyshacunata","poem":1},{"lineBreak":true},{"text":"chunyaj jircacho caycaj Selapita-pacha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Arnón mayuta päsanachöga Moab warmicuna ricaconga","poem":1},{"lineBreak":true},{"text":"gueshtancho caycaj äbita imapis mancharaycachiptin gueshpir aywacojnömi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chay warmicunami Sionta nin:","poem":1},{"lineBreak":true},{"text":"«Yarpachacuy imanöpapis nogacunata pacaycamänayquipaj.","poem":1},{"lineBreak":true},{"text":"Nogacunata washämay ari.","poem":1},{"lineBreak":true},{"text":"Junaj caycaptin llantuyniquiwan chapacurcuy","poem":1},{"lineBreak":true},{"text":"chacayno ricacunanpaj.","poem":1},{"lineBreak":true},{"text":"Jitarisha caycajcunataga pacaycamay ari.","poem":1},{"lineBreak":true},{"text":"Ama ‹caychömi pacaraycan› niycuychu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gueshpiycaj Moab runacunaga gamcunaman guellicamuchun ari.","poem":1},{"lineBreak":true},{"text":"Gaticachajcuna wañuchinanpita pacaycuy ari.»","poem":1},{"lineBreak":true},{"text":"Ñacachejcuna manana captin,","poem":1},{"lineBreak":true},{"text":"wañuchicojcunapis manana captin,","poem":1},{"lineBreak":true},{"text":"nasyunpita fiyu runacunapis aywacuptinnaga","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Davidpita mirajnami Jerusalencho ray cangapaj.","poem":1},{"lineBreak":true},{"text":"Payga canga cuyapäcojmi.","poem":1},{"lineBreak":true},{"text":"Payga canga mana suwacoj juezmi, alli arriglajmi.","poem":1},{"lineBreak":true},{"text":"Payga alli cajllatami ruranga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musyanchïnami Moab runacuna alli-tucushanta,","poem":1},{"lineBreak":true},{"text":"waquinpita mas munayniyoj-tucushanta, pitapis mana rispitaj cashanta,","poem":1},{"lineBreak":true},{"text":"baduläqui cashanta.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chayno cashanpitami Moab runacunaga nasyunnin imano caycajtapis ricaycärir wagangapaj.","poem":1},{"lineBreak":true},{"text":"Fiyupa llaquicurmi wagangapaj,","poem":1},{"lineBreak":true},{"text":"chaquisha übaspita llapshalla mishquej tantata Kir-haresetcho micushanpaj yarpar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hesboncho, Sibmacho caj übascunaga wañuytacäcushanami.","poem":1},{"lineBreak":true},{"text":"Chay übascunapa rämanga Jazercamami chayaraj.","poem":1},{"lineBreak":true},{"text":"Chunyajcamami chayaraj.","poem":1},{"lineBreak":true},{"text":"Lamarpita mas washacamami chayaraj.","poem":1},{"lineBreak":true},{"text":"Chaytami juc-lä nasyunpa mandajnincuna pedäsu rurasha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaypitami wagashaj Sibmacho caj übascunapaj,","poem":1},{"lineBreak":true},{"text":"Jazercho caj übascunapäpis.","poem":1},{"lineBreak":true},{"text":"Hesbonpäwan Elealepäpis amatarmi wagashaj.","poem":1},{"lineBreak":true},{"text":"Cosëcha timpu micuy goturaycashan jananchömi runacunaga pillyar gaparpanga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chacracunachöpis mananami cushicur gaparpanganachu.","poem":1},{"lineBreak":true},{"text":"Manami übas chacracunachöpis cantanganachu.","poem":1},{"lineBreak":true},{"text":"Übastapis manami gapchenganachu bïnuta rurananpaj übas lluchcacunancho.","poem":1},{"lineBreak":true},{"text":"Mananami cushicur gaparpanganachu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chaymi shongöpis fiyupa llaquicur ushaycan Moabpäwan Kir-haresetpäga.","poem":1},{"lineBreak":true},{"text":"Arpapa cuerdasninnöraj sicsicyaycan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Moab runacuna puytush lömacunaman aywashpan","poem":1},{"lineBreak":true},{"text":"uticänancama chaycho mañacushanpis,","poem":1},{"lineBreak":true},{"text":"capillancunaman mañacoj aywashanpis manacajllapämi canga.","poem":1}]},{"type":"verse","number":13,"content":["Chaynömi Tayta Diosga niran Moab nasyunpaj. Chaytaga niran unaynami."]},{"type":"verse","number":14,"content":["Cananga Tayta Dios nin: «Piyun quimsa wata conträtuta ushashannöllami cananpita quimsa watataga Moab nasyunpa munayniyoj caynin ushacanga. Aypalla runacuna cashpanpis cawaycar quëdajcunaga cangapaj wallcallanami, munayniynajllana.»"]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}