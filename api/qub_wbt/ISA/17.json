{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":17,"content":[{"type":"heading","content":["Damasco imano cananpäpis rimashan"]},{"type":"verse","number":1,"content":["Damasco imano cananpäpis Tayta Dios ribilashanta Isaías cayno willacuran:",{"text":"«Damascuga mananami siudänachu canga.","poem":1},{"lineBreak":true},{"text":"Aypalla ragällami ricaconga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aroer particho caycaj siudäcunataga para-simrinami cachaycärenga.","poem":1},{"lineBreak":true},{"text":"Chaura guewa juntashallanami canga.","poem":1},{"lineBreak":true},{"text":"Chaychöga uywacuna cushishami micongapaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Israelpa curalasha siudänincunapis manami cangapänachu.","poem":1},{"lineBreak":true},{"text":"Siriacho Damasco capital cashanpis ushacangami.","poem":1},{"lineBreak":true},{"text":"Chauraga Siriapis Israelno munayniynajllanami canga.»","poem":1},"Munayniyoj Tayta Diosmi chayno nisha."]},{"type":"heading","content":["Israel castigasha cananpaj willacushan"]},{"type":"verse","number":4,"content":[{"text":"«Siria ushacaptenga Israelpa capitalnin Samariapis munayniynajmi quëdanga.","poem":1},{"lineBreak":true},{"text":"Ima-aycata charashancunapis manami canganachu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Refaim pampacho rïguta cusichariptin chacra quëdashannömi quëdanga.","poem":1},{"lineBreak":true},{"text":"Rïguta ruturiptin päjallanna quëdashannömi ricaconga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Olivo yörata tapsircur-tapsircur wayuyninta pallariptin juc ishcay quëdashannöllanami quëdanga.","poem":1},{"lineBreak":true},{"text":"Öjan rurincunacho quimsa chusculla quëdashannöllanami quëdanga.»","poem":1},"Israelpa Tayta Diosninmi chayno nisha."]},{"type":"verse","number":7,"content":[{"text":"Chay junaj Israelcunaga yarpärengapaj ima-aycatapis ruraj Tayta Diosta.","poem":1},{"lineBreak":true},{"text":"Israelpa Santo Tayta Diosninmannami yäraconga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Manami yarpanganachu runa rurashan altarcunapaj,","poem":1},{"lineBreak":true},{"text":"ni imatapis maquinwan rurashan cajpäpis.","poem":1},{"lineBreak":true},{"text":"Asera diosa-niraj ïdulumanpis mananami yäraconganachu.","poem":1},{"lineBreak":true},{"text":"Manami yarpanganachu «diosnë» nishancunapaj","poem":1},{"lineBreak":true},{"text":"ni insinsuwan saumachishan altarcunapäpis.","poem":1}]},{"type":"verse","number":9,"content":["Chay junaj Israelcho curalasha caycaj siudäcunatapis cachaycärengami. Unay Hev runacuna, Amorreo runacuna Israelcunata manchacushpan siudänincunata cachaycushannömi canga. Tiyashayquicunaga chunyajnami quëdangapaj."]},{"type":"verse","number":10,"content":[{"text":"Chaynöga canga ima-aycapitapis salbashoj Tayta Diosta gongaycushayquipitami.","poem":1},{"lineBreak":true},{"text":"Manami yarpashcanquichu Tayta Dioslla imapitapis chapäshoj cashanta.","poem":1},{"lineBreak":true},{"text":"Gamga micuyniquicunatapis muruycanqui","poem":1},{"lineBreak":true},{"text":"juc-lä nasyun runacunapa diosninta rispitashpayquimi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Muruycushan junajlla wiñachimuptinpis,","poem":1},{"lineBreak":true},{"text":"waranllan waytaptinpis,","poem":1},{"lineBreak":true},{"text":"llaquicuy cashan junäga, ima jampipis mana tincushan gueshya chayamushan junäga","poem":1},{"lineBreak":true},{"text":"murushayqui manami imanpis cangapächu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¡Wiyay-llapa chiquishoj aypalla marca runacuna ollgurcaycashanta!","poem":1},{"lineBreak":true},{"text":"¡Paycuna ollgur gaparpashanga wiyacaycan chayasha mayu bunyaylla aywaycajnörämi!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tayta Dios ollgöpariptenga","poem":1},{"lineBreak":true},{"text":"chay runacuna carumanmi gueshpir aywaconga,","poem":1},{"lineBreak":true},{"text":"ogshata wayra jircacunapa apacushanno,","poem":1},{"lineBreak":true},{"text":"löcu wayrapis ñuchu allpata apashanno.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chay runacuna tardipaga fiyupa mancharishami carcaycanga.","poem":1},{"lineBreak":true},{"text":"Pacha wararcuptenga chiquimajninchïcuna llapanmi mana canganachu.","poem":1},{"lineBreak":true},{"text":"Chaynömi illganga imanchïtapis suwapämajninchïcuna, marcanchïtapis mana allita rurajcunaga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}