{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":18,"content":[{"type":"heading","content":["Etiopía imano cananpäpis rimashan"]},{"type":"verse","number":1,"content":[{"text":"¡Ay imanöraj canga Etiopía nasyuncho caycaj mayucunapita mas washacho caycajcuna!","poem":1},{"lineBreak":true},{"text":"Chay nasyunchöga aypalla chinrascunami inririycan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gamcunaga ututupita rurasha büquicunawanmi","poem":1},{"lineBreak":true},{"text":"Nilo mayunpa cachata cacharcaycanqui.","poem":1},{"lineBreak":true},{"text":"Cacha aywaycajcuna fiyupa cörrishpayqui ayway","poem":1},{"lineBreak":true},{"text":"jatuncaray llushwaypa-llushwaycaj runacunaman,","poem":1},{"lineBreak":true},{"text":"may-chay nasyun runacunapis manchacushan runacunaman.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga fiyupa callpasapami, jinyumi.","poem":1},{"lineBreak":true},{"text":"Nasyunninpis aypalla mayucunapa chaupillanchömi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Llapayquimi, intëru munducho tiyajcunaga","poem":1},{"lineBreak":true},{"text":"ricanquipaj puntacho señalta churamushanta.","poem":1},{"lineBreak":true},{"text":"Llapayquimi wiyanquipaj trompëta wagamushantapis.","poem":1}]},{"type":"verse","number":4,"content":["Tayta Dios caynömi nimaran:",{"text":"«Shuyashpä syëlupitami ricapäshaj","poem":1},{"lineBreak":true},{"text":"usya captin alli shanashan wichan,","poem":1},{"lineBreak":true},{"text":"cosëcha captin shullay pucutay llanturashan wichanpis.»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Manaräpis übas cosëcha captin","poem":1},{"lineBreak":true},{"text":"waytan shicwarcuptin micuynin mullcuycaptinna","poem":1},{"lineBreak":true},{"text":"Tayta Dios rämancunata cuchilluwan rämanga.","poem":1},{"lineBreak":true},{"text":"Cuchurcur juc-läman witichenga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chay witichishancunaga jircachömi mashtaraycar quëdanga.","poem":1},{"lineBreak":true},{"text":"Usya wichanga aycha micoj äbicunami micuconga.","poem":1},{"lineBreak":true},{"text":"Tamya wichannami chucaru jirca animalcuna micuconga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Chay wichanga jatuncaray llushwaypa-llushwaycaj, may-chay nasyun manchacushan runacunapis, fiyupa callpasapa munayniyoj runacunami y nasyunninpis aypalla mayucunapa chaupillancho caycaj runacunami munayniyoj Tayta Diospaj ofrendancunata apamonga. Sión lömamanmi garayninta apamonga. Chay jircachömi munayniyoj Tayta Diosta aduranga."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}