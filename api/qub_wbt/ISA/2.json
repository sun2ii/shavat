{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":2,"content":[{"type":"heading","content":["Alli goyayna cananpaj cashan"]},{"type":"verse","number":1,"content":["Amospa wamran Isaiastami Tayta Dios ribilaran shamoj watacunacho Judá nasyunwan capitalnin Jerusalén imano cananpaj cashantapis. Chayga caynömi caycan:"]},{"type":"verse","number":2,"content":[{"text":"Ushanan junajcunachöga Tayta Diospa Templun caycashan punta","poem":1},{"lineBreak":true},{"text":"waquin puntacunapitaga mas rispitashami cangapaj.","poem":1},{"lineBreak":true},{"text":"Intëru nasyun runacunami chayman shamongapaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aypalla runacunami shamunanpaj cayno parlaconga:","poem":1},{"lineBreak":true},{"text":"«Aywashun-llapa, Jacobpa Tayta Diosninpa Templun caycashan jircaman wichänapaj.","poem":1},{"lineBreak":true},{"text":"Chaychönami willamäshun imano goyänanchïpaj cashantapis.","poem":1},{"lineBreak":true},{"text":"Chaynöpana pay munashanno llapantapis rurashun» nishpan.","poem":1},{"lineBreak":true},{"text":"Jerusalenpitami Tayta Diosga yachachimäshun.","poem":1},{"lineBreak":true},{"text":"Chay Sionpitanami parlapämonga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tayta Diosmi arriglanga llapan nasyun runacunata.","poem":1},{"lineBreak":true},{"text":"Nircorga paynami chiquinacuycaj nasyun runacunata nenga imano goyänanpäpis.","poem":1},{"lineBreak":true},{"text":"Chaura chay runacunaga sablincunatapis ticrachenga rëjancunamanmi.","poem":1},{"lineBreak":true},{"text":"Tucsicuna lansancunatapis ticrachenga ösincunaman.","poem":1},{"lineBreak":true},{"text":"Juc nasyunpa contran mananami maygan nasyun runacunapis yapayga aywanganachu pillyacunancunawan.","poem":1},{"lineBreak":true},{"text":"Chayno captin mananami guërrapäpis yachachinaconganachu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jacobpita mirar aywajcuna,","poem":1},{"lineBreak":true},{"text":"Tayta Dios pushamashallanchïpa purishun ari.","poem":1}]},{"type":"heading","content":["Alli-tucojcuna castigacänanpaj cashan"]},{"type":"verse","number":6,"content":[{"text":"Tayta Dios, acrashayqui runacunachöga juc-läpita shamoj musyacojcunami juntasha caycan.","poem":1},{"lineBreak":true},{"text":"Filistea runacunachönöpis brüjucunami juntasha caycan.","poem":1},{"lineBreak":true},{"text":"Israelcunaga juc-lä runacunawanmi parlacurcaycan.","poem":1},{"lineBreak":true},{"text":"Chayno captinmi gamga acrashayqui runacunata cachaycushcanqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israelchöga aypallami caycan goripis, guellaypis.","poem":1},{"lineBreak":true},{"text":"Ima-ayca riquësacunapis aypallami caycan.","poem":1},{"lineBreak":true},{"text":"Cawallupis aypallami.","poem":1},{"lineBreak":true},{"text":"Yupaytapis mana atipaypämi caycan pillyapaj carrëtacunapis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ïdulucunapis intërucho juntashami caycan.","poem":1},{"lineBreak":true},{"text":"Runacunaga adurarcaycan quiquin rurarcur «diosnë» nishantami.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chayno manacajcunata rurarmi juchayoj caycan.","poem":1},{"lineBreak":true},{"text":"Chayno cashanpitaga amana perdunaynachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Runacunaga pacacongapaj gagapa shillincunamanmi.","poem":1},{"lineBreak":true},{"text":"Pampata uchcuriycärir allpa rurinman yayconga.","poem":1},{"lineBreak":true},{"text":"Chaynöga pacaconga manchacuypaj munayniyoj Tayta Diospitami.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alli-tucojcunaga uysurpangami.","poem":1},{"lineBreak":true},{"text":"Ollgojcunapis manacajman churashami ricacongapaj.","poem":1},{"lineBreak":true},{"text":"Chay junäga Tayta Diosllami fiyupa munayniyoj cashpan rispitasha canga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chay junäga munayniyoj Tayta Dios manacajmanmi churanga","poem":1},{"lineBreak":true},{"text":"alli-tucojcunata, llapan ollgojcunata, munayniyoj-tucojcunatapis.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Libanucho jatuncaray sedru guerucunata,","poem":1},{"lineBreak":true},{"text":"Basancho caj encina yöracunatapis","poem":1},{"lineBreak":true},{"text":"Tayta Diosga illgächengami.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Altunnin puntacunata,","poem":1},{"lineBreak":true},{"text":"jatuncaray puytush lömacunatapis","poem":1},{"lineBreak":true},{"text":"Tayta Diosga illgächengami.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ricchacunanpaj altunnin pergashancunatapis","poem":1},{"lineBreak":true},{"text":"mana tunej sinchi pergacunatapis","poem":1},{"lineBreak":true},{"text":"Tayta Diosga illgächengami.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tarsispita shamoj büquicunata,","poem":1},{"lineBreak":true},{"text":"cuyayllapaj büquicunatapis","poem":1},{"lineBreak":true},{"text":"Tayta Diosga illgächengami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alli-tucojcunawan ollgojcunaga","poem":1},{"lineBreak":true},{"text":"pasaypa manacajman churashami cangapaj.","poem":1},{"lineBreak":true},{"text":"Chay junäga Tayta Diosllami fiyupa munayniyoj cashpan rispitasha canga.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chay öraga ïdulucunatapis ushajpämi illgächenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tayta Dios chayno shamuptin","poem":1},{"lineBreak":true},{"text":"runacunaga mancharishpanmi yagacaycärengapaj gagacho caycaj uchcucunaman,","poem":1},{"lineBreak":true},{"text":"pacha rurinpa caycaj uchcucunamanpis.","poem":1},{"lineBreak":true},{"text":"Chaynöga pacaconga manchacuypaj munayniyoj Tayta Diospitami.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chay junäga runacuna ïduluncunata goripita, guellaypita adurananpaj rurashantapis","poem":1},{"lineBreak":true},{"text":"cachaycärengapaj ucushcuna tiyanan, chicchicuna tiyanan uchcucunachömi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chay junaj runacunaga mancharishpanmi yagacaycärengapaj gagacho caycaj uchcucunaman,","poem":1},{"lineBreak":true},{"text":"pachapa shimin uchcucunamanpis.","poem":1},{"lineBreak":true},{"text":"Chaynöga pacaconga Tayta Diosta manchacushpanmi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Runacunamanga amana yäracuynachu.","poem":1},{"lineBreak":true},{"text":"Runaga manami aycäpis bälinchu.","poem":1},{"lineBreak":true},{"text":"Runaga cawanpis jämayta cacharcuynöllami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/2.json","thisChapte