{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":21,"content":[{"type":"heading","content":["Babilonia ushacänanpaj rimashan"]},{"type":"verse","number":1,"content":["Lamar lädunpa caycaj Babilonia imano cananpäpis Tayta Dios ribilashanta Isaías cayno willacuran:",{"text":"Neguevpa päsar löcu wayra aywashannömi","poem":1},{"lineBreak":true},{"text":"fiyupa manchacuypaj chaqui jirca nasyunpita illgächicoj suldärucuna aywaycämun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fiyupa manchacuypätami Tayta Diosga ribilamasha:","poem":1},{"lineBreak":true},{"text":"Engañacöga engañacun. Wañuchicöga wañuchicun.","poem":1},{"lineBreak":true},{"text":"¡Shamuy ari Elam! ¡Media jutiyoj nasyun runacunapis yaycupaycäriy!","poem":1},{"lineBreak":true},{"text":"Chauraga Babiloniacho ñacaycaj runacuna manami ñacanganachu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Babiloniata Tayta Dios imanöpis castigananpaj cashanta musyarmi","poem":1},{"lineBreak":true},{"text":"cuerpöcunapis manchariywan shiririn.","poem":1},{"lineBreak":true},{"text":"Gueshyacunanpaj warmi nanaycho caycajnörämi nanächicuycäpis.","poem":1},{"lineBreak":true},{"text":"Wiyashäga fiyupami llaquicaycächiman.","poem":1},{"lineBreak":true},{"text":"Ricashäcunapis fiyupami manchariycächiman.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Manami imano yarpachacuytapis camäpacönachu.","poem":1},{"lineBreak":true},{"text":"Manchariyllawanmi fiyupa llaquicuycä.","poem":1},{"lineBreak":true},{"text":"Pacha tardiyar chacänanta ñaupatacuna amatar munashäga","poem":1},{"lineBreak":true},{"text":"canan ticracurisha fiyupa manchariypajmanmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Babiloniachöga mësa maynami churaraycan.","poem":1},{"lineBreak":true},{"text":"Jananman mantiltapis maynami mashtasha.","poem":1},{"lineBreak":true},{"text":"Micurcaycan, upurcaycannami.","poem":1},{"lineBreak":true},{"text":"¡Jatariy mandajcuna!","poem":1},{"lineBreak":true},{"text":"¡Pillyar chapacuna escüduyquicunata llushwachay!","poem":1}]},{"type":"verse","number":6,"content":["Tayta Diosmi cayno nimasha:",{"text":"«Aywaycur juc ricachacoj runata churamuy,","poem":1},{"lineBreak":true},{"text":"imatapis ricashantaga llapanta willacamunanpaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Parninpa-cama cawallucuna carrëtan garachasha,","poem":1},{"lineBreak":true},{"text":"u bürruncuna muntasha, u camëlluncuna muntasha aywaycämojta ricar","poem":1},{"lineBreak":true},{"text":"rejsinanpaj sumaj ricapächun.»","poem":1}]},{"type":"verse","number":8,"content":["Chaypitaga ricachacoj runana gayacuran:",{"text":"«Tayta, ricachacunäpaj caycashallächömi goyay-goyay caycä.","poem":1},{"lineBreak":true},{"text":"Chacaycunapapis waray-waraymi ricachacuycä.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Parninpa-cama cawallucuna carrëtan garachasha aywaycämojtami ricaycä.","poem":1},{"lineBreak":true},{"text":"Aywaycämojcuna nisha:","poem":1},{"lineBreak":true},{"text":"‹¡Canan Babiloniataga illgarachengami!","poem":1},{"lineBreak":true},{"text":"Ïduluncunapis llapanmi agullasha pampacho mashtarpaycanga› nir.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rïguta ërar lluchcar-ushashanno caycaj marca-masëcuna,","poem":1},{"lineBreak":true},{"text":"nogaga willaycä munayniyoj Tayta Diosninchi nimashantami.","poem":1}]},{"type":"heading","content":["Edom imano cananpäpis rimashan"]},{"type":"verse","number":11,"content":["Edom runacuna imano cananpäpis Tayta Dios ribilashanta Isaías cayno willacuran:",{"text":"Seirpita-pachami juc gayacusha:","poem":1},{"lineBreak":true},{"text":"«Ricachacoj, ¿imaynataj pacha waranga?","poem":1},{"lineBreak":true},{"text":"Ricachacoj, ¿aycarätaj pishin cay ñacay päsananpaj?» nir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaura ricachacojna nin:","poem":1},{"lineBreak":true},{"text":"«Pachaga waranganami.","poem":1},{"lineBreak":true},{"text":"Ichanga chacaypis yapay chayamonganami.","poem":1},{"lineBreak":true},{"text":"Masta musyayta munarga yapay cutimunqui.»","poem":1}]},{"type":"heading","content":["Arabia imano cananpäpis rimashan"]},{"type":"verse","number":13,"content":["Arabia imano cananpäpis Tayta Dios ribilashanta Isaías cayno willacuran:",{"text":"Dedán runacuna Arabiacho caycaj shatacunaman pacacuy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Temá runacuna, gueshpir aywacurcaycajta yacuta taripachiy.","poem":1},{"lineBreak":true},{"text":"Micuytapis garay.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Paycunaga gueshpicurcaycan sabliwan wañuchinanpitami,","poem":1},{"lineBreak":true},{"text":"lëchawan illapananpaj apuntaraycajpitami,","poem":1},{"lineBreak":true},{"text":"manchariypaj guërrapitami.","poem":1}]},{"type":"verse","number":16,"content":["Tayta Dios cayno nimaran: «Piyun juc wata conträtuta ushashannöllami cananpita juc watataga Cedar munayniyoj cashanpis ushacanga."]},{"type":"verse","number":17,"content":["Lëchawan illapaj jinyu Cedar runacunaga wallcallanami cawaycar quëdangapaj.» Israelpa Tayta Diosninmi chayno nisha."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}