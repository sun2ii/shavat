{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":23,"content":[{"type":"heading","content":["Tiropäwan Sidonpaj rimashan"]},{"type":"verse","number":1,"content":["Tiro imano cananpäpis Tayta Dios ribilashanta Isaías cayno willacuran:",{"text":"Büquita manijaj Tarsis runacunaga llaquishami carcaycan.","poem":1},{"lineBreak":true},{"text":"Chipripitami willapa chayasha","poem":1},{"lineBreak":true},{"text":"«Tiro siudätami juchuchisha» nir.","poem":1},{"lineBreak":true},{"text":"«Lamar cantunman büqui chayanantami illgächisha» nir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tiro runacunawan Sidón nigusyanticunapis upällallami carcaycan.","poem":1},{"lineBreak":true},{"text":"Paycunaga büquicunawanmi nigusyuta aroj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Achca nasyun runacunawanmi ranticanacoj.","poem":1},{"lineBreak":true},{"text":"Paycunaga fiyupami gänaj Egiptupita shuntashan micuyta ranticur.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lamar cantuncho caycaj Sidón fiyupa pengacuy ari.","poem":1},{"lineBreak":true},{"text":"Tiro manana captinmi lamarga llaquicur nenga:","poem":1},{"lineBreak":true},{"text":"«Ollgu wamracunata mana uywashanömi caycä.","poem":1},{"lineBreak":true},{"text":"Warmi wamracunatapis mana uywashanömi caycä.","poem":1},{"lineBreak":true},{"text":"Nanayta mana musyaj, mana gueshyacushanönami caycä.»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tiro imano ruracashantapis musyaycur","poem":1},{"lineBreak":true},{"text":"Egipto runacunaga fiyupami llaquiconga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lamar cantuncho tiyaj runacuna, Tarsisman aywacuy-llapa;","poem":1},{"lineBreak":true},{"text":"fiyupa wagay-llapa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mas unay marcami casha Tiro siudäga.","poem":1},{"lineBreak":true},{"text":"Chaychöga runacuna gustashallanta rurar cushishami goyäcoj.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga caruman tiyaj aywacoj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nircur chaychöga raytana churaj.","poem":1},{"lineBreak":true},{"text":"Chay siudäpa nigusyantincunaga rispitädu runacunallami caran.","poem":1},{"lineBreak":true},{"text":"Chaymi llapanpis rispitashpan tiyachej.","poem":1},{"lineBreak":true},{"text":"¿Pitaj nisha Tiro chayno castigacänanpäga?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Diosmi chayno camacächisha","poem":1},{"lineBreak":true},{"text":"llapan alli-tucojcunata pengacachinanpaj,","poem":1},{"lineBreak":true},{"text":"cay pachacho caj munayniyojcunata manacajman churananpaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tarsis runacuna cananga Nilo mayu chayar mashtacashanno juc-läman juc-läman mashtacäcuy.","poem":1},{"lineBreak":true},{"text":"Lamar cantuncho büquicuna jamanan manami cannachu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Diosmi lamar jananpa maquinta jogarisha.","poem":1},{"lineBreak":true},{"text":"Intëru nasyuncunatami sicsicyachisha.","poem":1},{"lineBreak":true},{"text":"Canaán nasyunpa pacacuna siudänincunata illgächinanpämi nisha.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sidontanami niran:","poem":1},{"lineBreak":true},{"text":"«Fistayquicunapis manami cannachu.","poem":1},{"lineBreak":true},{"text":"Charipacusha jipashnönami caycanqui.","poem":1},{"lineBreak":true},{"text":"Chipriman gueshpirpis manami chaychöpis jamayta tarinquipächu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"¡Masqui ricay Caldeacuna tiyashanta!","poem":1},{"lineBreak":true},{"text":"Chay nasyonga unay manami caranchu.","poem":1},{"lineBreak":true},{"text":"Asiria runacunami yanaparan chunyaj chaqui jircacho goyajcuna tiyananpaj.","poem":1},{"lineBreak":true},{"text":"Cananga Caldeacunami escaluncunata rurasha","poem":1},{"lineBreak":true},{"text":"Tirocho caj palasyucunata juchuchinanpaj.","poem":1},{"lineBreak":true},{"text":"Paycunaga pasaypa usharcur ragällantami cachaycusha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lamar cantunman büqui chayanan illgasha captinmi","poem":1},{"lineBreak":true},{"text":"büquita manijaj Tarsis runacunaga llaquisha carcaycan.","poem":1}]},{"type":"verse","number":15,"content":["Chay wichan Tiro nasyuntaga ganchis chunca (70) watacamami gongaycärenga. Ray cawashanno ganchis chunca (70) wata päsariptin ichanga Tiro siudäpaj cantanga guellaypaj cacoj warmipaj birsushanno:"]},{"type":"verse","number":16,"content":[{"text":"«Gongacasha caycaj guellaypaj cacoj warmi,","poem":1},{"lineBreak":true},{"text":"arpayquita matancacurcur siudäpa purimuy.","poem":1},{"lineBreak":true},{"text":"Alli tonädacunata tucay. Yaparir-yaparir birsuy.","poem":1},{"lineBreak":true},{"text":"Mä pillaga yarpärishunquichush.»","poem":1}]},{"type":"verse","number":17,"content":["Ganchis chunca (70) watata usharcuptin ichanga Tiro siudäta Tayta Dios yarpärenga. Chaura chay siudächo tiyaj runacunaga yapaymi nigusyuta aruyta gallayconga. Yapaymi llapan nasyun runacunawan ranticanacushpan rejsinaconga."]},{"type":"verse","number":18,"content":["Ichanga manami quiquincunapänachu shuntanga, ni churanga. Chaypa ruquenga gänashancuna canga Tayta Diospänami. Tayta Diosta sirbejcunatami goycärengapaj alli micusha, alli röpasha goyänanpaj."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}