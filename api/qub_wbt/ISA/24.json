{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":24,"content":[{"type":"heading","content":["Cay pachacho cajta Tayta Dios jusgananpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"Masqui ricay-llapa.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga llapantami cay pachata usharenga.","poem":1},{"lineBreak":true},{"text":"Cay pachata fiyupami cuyurachenga.","poem":1},{"lineBreak":true},{"text":"Runacunatanami wacpa-caypa mashtacächenga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chay junäga iwalmi päsanga cüratapis, pampa runacunatapis,","poem":1},{"lineBreak":true},{"text":"patruntapis, ollgu uywaytapis,","poem":1},{"lineBreak":true},{"text":"patrönatapis, warmi uywaytapis,","poem":1},{"lineBreak":true},{"text":"rantejtapis, ranticojtapis,","poem":1},{"lineBreak":true},{"text":"ristajtapis, ristacojtapis,","poem":1},{"lineBreak":true},{"text":"rïcutapis, pobritapis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ima-aycata charashantapis ushajpämi guechurenga.","poem":1},{"lineBreak":true},{"text":"Cay pachataga pasaypa chunyajtami cachayconga.","poem":1},"Chayno cananpämi Tayta Diosga nisha."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Cay pachaga llaquicuycho cashpanmi chaquir shushuycan.","poem":1},{"lineBreak":true},{"text":"Mundu cansädu cashpanmi pasaypa chaquir shushucäcun.","poem":1},{"lineBreak":true},{"text":"Munayniyoj runacunapis fiyupami llaquicun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cay pachataga runacunami ganrachisha.","poem":1},{"lineBreak":true},{"text":"Laycunata manami cumlishachu.","poem":1},{"lineBreak":true},{"text":"Tayta Diospa mandamintuncunata mana wiyacushachu.","poem":1},{"lineBreak":true},{"text":"Imaycamapis alli cananpaj parlashantapis manami cumlishachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaypitami castïgu chayamur cay pachataga usharisha.","poem":1},{"lineBreak":true},{"text":"Chay castïguwanmi cay pachacho tiyajcunapis ñacaycan.","poem":1},{"lineBreak":true},{"text":"Chaypitami cay pachacho tiyajcuna ushacasha.","poem":1},{"lineBreak":true},{"text":"Wallcallanami runacunaga cawaycar quëdasha.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Übas yöracunatapis gueshyami charisha.","poem":1},{"lineBreak":true},{"text":"Chaymi bïnupis mana cannachu.","poem":1},{"lineBreak":true},{"text":"Ñaupata cushisha goyajcunapis llaquishanami carcaycan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mananami tucannachu tamburcunata.","poem":1},{"lineBreak":true},{"text":"Ni arpacunatapis manami tucannachu.","poem":1},{"lineBreak":true},{"text":"Fistata rurar, cushicur gaparpajcunapis manami mayacannachu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Birsushpan manami bïnuta upyanganachu.","poem":1},{"lineBreak":true},{"text":"Upyajcunapäga machächicojcunapis ashgajmanmi ticracurenga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Siudäga juchushami caycan.","poem":1},{"lineBreak":true},{"text":"Wasimanpis mananami pipis yaycunnachu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bïnu muchuy captin runacunaga cällicunachöpis wagarcaycan.","poem":1},{"lineBreak":true},{"text":"Mananami pipis cushicunnachu.","poem":1},{"lineBreak":true},{"text":"Cushicuyga chay pachapita aywacusha.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Siudäga pasaypa ragällami quëdasha.","poem":1},{"lineBreak":true},{"text":"Puncunpis ichic-ichiclla ruracashami caycan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Runaga wallcallanami cay pachacho quëdanga.","poem":1},{"lineBreak":true},{"text":"Olivota pallar ushajpaj shicwananpaj wiruptin juc ishcay quëdashannöllana,","poem":1},{"lineBreak":true},{"text":"cosëcha ushay quëdaj übasta ashishannöllanami quëdanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Cawaycar quëdaj runacunaga Tayta Dios imanöpis rurashanta ricasha carmi cushicuypita gaparpanga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta ricarmi maycho tiyaycashanchöpis cushisha cantanga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"May-chaychöpis Israelcunapa Tayta Diosnintaga rispitashpan alabangami.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Cay pachapa cuchunpita-pacha cantamojtami wiyashcäcuna","poem":1},{"lineBreak":true},{"text":"«¡Juchaynäga alabasha cachun!» nir.","poem":1},{"lineBreak":true},{"text":"Noganami nishcä: «Ay, ima ruraytapis manami camäpacöchu.","poem":1},{"lineBreak":true},{"text":"Pasaypa llaquishami caycä.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunaga engañacunmi.","poem":1},{"lineBreak":true},{"text":"Paycunamanga manami yäracuypächu.»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Cay pachacho tiyaj runacunaga cangapaj casadurpita jirca animal gueshpiycajnömi.","poem":1},{"lineBreak":true},{"text":"Man'chäga cangapaj uchcuman yagananpaj caycajno, u togllaman chayananpaj caycajno.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Casadurpita gueshpej cäga yagangapaj uchcumanmi.","poem":1},{"lineBreak":true},{"text":"Uchcupita llojshirir gueshpej cajnami togllacho watacasha quëdanga.","poem":1},{"lineBreak":true},{"text":"Fiyupa löcu tamyami tamyamongapaj.","poem":1},{"lineBreak":true},{"text":"Cay pachata tucnarämojcunapis chucchongarämi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Cay pachaga fiyupa manchariypämi cuyurenga.","poem":1},{"lineBreak":true},{"text":"Cuyurishpan ichic-ichiclla ruracäcongapaj.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Machasha runa tuniycachaycajnömi ricaconga.","poem":1},{"lineBreak":true},{"text":"Tuniyta munaycaj chucllanömi alayri cuyuycanga.","poem":1},{"lineBreak":true},{"text":"Cay pachacho tiyajcuna juchata rurashanga fiyupami lasaycan.","poem":1},{"lineBreak":true},{"text":"Chaymi cay pachaga tunishpan imaypis mana jatarenganachu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chay junäga Tayta Dios castigangapaj janaj pachacho caycaj munayniyojcunata,","poem":1},{"lineBreak":true},{"text":"cay pachacho caj raycunatapis.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Llapanta juc pachaman shuntanga.","poem":1},{"lineBreak":true},{"text":"Nircur calapösuman wichganga.","poem":1},{"lineBreak":true},{"text":"Chaychönami prësu wichgarächenga.","poem":1},{"lineBreak":true},{"text":"Unaycama wichgararcachir-rämi castiganga.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Diosga Sioncho jamacunanman jamayconga","poem":1},{"lineBreak":true},{"text":"acrashancunapa mandajnincuna ricapaycaptin.","poem":1},{"lineBreak":true},{"text":"Nircur Jerusalenchömi achicyacurconga.","poem":1},{"lineBreak":true},{"text":"Chauraga intipis quillapis manami achicyanganachu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}