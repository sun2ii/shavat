{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":25,"content":[{"type":"heading","content":["Tayta Diosta alabar cantashan"]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, gammi canqui Diosnë.","poem":1},{"lineBreak":true},{"text":"Nogaga gamtami rispitashpä alabashayqui.","poem":1},{"lineBreak":true},{"text":"Almiraypajcunata rurashayquipitami adurashayqui.","poem":1},{"lineBreak":true},{"text":"Unaypita-pachami yarpashayquicunaga caycan rasun cajlla, alli cajlla.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Siudätapis gotuy-gotuy juchusha cananpämi ticrarachishcanqui.","poem":1},{"lineBreak":true},{"text":"Pacacuna curalasha siudätapis ushajpämi juchurgärachishcanqui.","poem":1},{"lineBreak":true},{"text":"Jäpa runacunapa palasyuncunatapis juchuchirmi illgarachishcanqui.","poem":1},{"lineBreak":true},{"text":"Chay siudätaga manami imaypis allchachenganachu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chaypitami chay siudächo caj munayniyoj runacunapis rispitashunquipaj.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunapis manchacushunquipaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pobricunataga gammi imaypis washashcanqui.","poem":1},{"lineBreak":true},{"text":"Llaquicuycajcunatapis yanapar chapashcanquimi.","poem":1},{"lineBreak":true},{"text":"Löcu tamya mana chayananpaj pacacunanmi cashcanqui.","poem":1},{"lineBreak":true},{"text":"Fiyupa shanay mana chayananpäpis llantunmi cashcanqui.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunapa jämayninmi ichanga","poem":1},{"lineBreak":true},{"text":"caycan löcu tamyano,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"chaqui jircaman shanay chayajno.","poem":1},{"lineBreak":true},{"text":"Fiyupa shanaycaptin pucutaywan llantuchishayquinömi","poem":1},{"lineBreak":true},{"text":"ollgoj runacuna gaparpaycashantapis gamga chawächinqui.","poem":1},{"lineBreak":true},{"text":"Gammi ninqui fiyu runacuna upällalla wiyarpänanpäpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sión lömachömi munayniyoj Tayta Dios","poem":1},{"lineBreak":true},{"text":"aypalla micuyta camarenga llapan nasyun runacunapaj.","poem":1},{"lineBreak":true},{"text":"Chaychöga caycanga mishquej micuycuna, mas alli caj bïnupis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chay jircachöga mananami llaquicuy canganachu.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi jorgurenga llapan runacunata chaparaycashan bëluta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Imaypis manana wañuy cananpämi Tayta Diosga wañuyta ushacächenga.","poem":1},{"lineBreak":true},{"text":"Wagajcunatapis shogashpan weguinta pichapangami.","poem":1},{"lineBreak":true},{"text":"Acrashan runacuna cay pachacho pengaycho cashantapis pampachar gongacächenganami.","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"verse","number":9,"content":["Chay junaj runacuna nengapaj:",{"text":"«Chaynömi noganchïpa Diosninchëga.","poem":1},{"lineBreak":true},{"text":"Paymanmi yäracuranchi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi salbamashcanchi.","poem":1},{"lineBreak":true},{"text":"Pay salbamashanchïpita cushicur gaparpäshun ari.»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sión lömataga Tayta Diosmi imapitapis chapanga.","poem":1},{"lineBreak":true},{"text":"Moabtami ichanga lluchcar-ushanga.","poem":1},{"lineBreak":true},{"text":"Ganrata lluchcashannömi lluchcarenga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Moab runacunaga mayucho bäñacushannörämi maquintapis tapsenga.","poem":1},{"lineBreak":true},{"text":"Ichanga Tayta Diosmi alli-tucuycajta ñitirenga.","poem":1},{"lineBreak":true},{"text":"Manami imanöpapis gueshpengachu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tayta Diosga juchurachengami sinchi pergasha siudäcunapa curralnincunatapis.","poem":1},{"lineBreak":true},{"text":"Nircorga pampacho mashtaraycajtami cachayconga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}