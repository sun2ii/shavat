{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":26,"content":[{"type":"heading","content":["Tayta Dios yanapashanpita cantashan"]},{"type":"verse","number":1,"content":["Chay junäga cay alabansatami Judá nasyun runacuna cantangapaj:",{"text":"«Noganchïpa siudäninchëga sumaj curalashami.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga salbamänanchïpaj","poem":1},{"lineBreak":true},{"text":"rurasha ishcay ayway pergatami.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Siudäpa puncunta quichay-llapa.","poem":1},{"lineBreak":true},{"text":"Chaypami yaycamonga Tayta Diosta wiyacoj runacuna, payman yäracoj runacuna.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios, gamllaman yarparajcunataga","poem":1},{"lineBreak":true},{"text":"gamllaman yäracamojcunataga allimi goyächinquipaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Imaypis Tayta Diosllaman yäracuy-llapa.","poem":1},{"lineBreak":true},{"text":"Payga mana ushacaj gaganömi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paymi mana alliman chayachin alli-tucojcunataga.","poem":1},{"lineBreak":true},{"text":"Munayniyoj caycaj siudätapis","poem":1},{"lineBreak":true},{"text":"allpawan llapan tacucänanpaj juchurachin.","poem":1},{"lineBreak":true},{"text":"Chay siudäpa pergancunapis juchucäcun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chauraga chay jananpami purenga","poem":1},{"lineBreak":true},{"text":"pobricunapis, umildicunapis.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tayta Dios gammi camacächinqui wiyacushoj runa allilla purinanpaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios, mandamintuyquicunata cumlishpä nogacunapis cushishami goyarcaycä.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, nogacunaga llapanë gamllamanmi yarparaycämö.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chacaycunapapis gamllamanmi yarparaycä.","poem":1},{"lineBreak":true},{"text":"Llapan shongöpami gamta ashiycä.","poem":1},{"lineBreak":true},{"text":"Cay pachacho caj runacunata llapanta jusgaptiquirämi yachaconga allita rurayta.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fiyu runacunata may-jina cuyapaptiquipis","poem":1},{"lineBreak":true},{"text":"paycunaga manami yachacongapächu alli cajta rurayta.","poem":1},{"lineBreak":true},{"text":"Paycunaga alli runacunapa ñaupancho tiyaycarpis mana allillatami ruran.","poem":1},{"lineBreak":true},{"text":"Paycunaga manami manchacushunquichu fiyupa munayniyoj Tayta Dios captiquipis.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Dios castiganayquipäga maynami camarisha caycanqui.","poem":1},{"lineBreak":true},{"text":"Ichanga chay runacuna manami tantiyacunchu.","poem":1},{"lineBreak":true},{"text":"Acrashayqui runacunata fiyupa cuyashayquita ricashpanrämi pengaycho ricacongapaj.","poem":1},{"lineBreak":true},{"text":"¡Chay runacunataga rabyasha caycashayqui ninano usharichun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tayta Dios, gammi nogacunataga alli goyänäpaj yanapaycämanqui.","poem":1},{"lineBreak":true},{"text":"Gammi camacaycächinqui llapan rurashäcunatapis.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tayta Dios, juc mandajcunami nogacunataga munaynincho charämasha.","poem":1},{"lineBreak":true},{"text":"Ichanga gamllami Tayta Diosnë canqui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chay mandajcunaga wañushanami.","poem":1},{"lineBreak":true},{"text":"Manami cawarimongapänachu.","poem":1},{"lineBreak":true},{"text":"Paycunaga llantuynöllami casha.","poem":1},{"lineBreak":true},{"text":"Mananami jatarimonganapischu.","poem":1},{"lineBreak":true},{"text":"Castigashpayqui maynami llapanta illgarachishcanqui.","poem":1},{"lineBreak":true},{"text":"Paycunata pipis mana yarpänanpämi illgarachishcanqui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Dios gammi runacunata achcayächir nasyunnëta jatunyächishcanqui.","poem":1},{"lineBreak":true},{"text":"Gam rispitasha canayquipämi chayno camacächishcanqui.","poem":1},{"lineBreak":true},{"text":"Nasyunpa lindancunata mas carumanna witichishcanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tayta Dios paycunaga llaquicushpan gamtami ashishurayqui.","poem":1},{"lineBreak":true},{"text":"Castigaptiqui paycunaga mañacushurayqui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Dios, gampa ñaupayquicho caycaräcuna,","poem":1},{"lineBreak":true},{"text":"imanömi gueshyaj warmi gueshyacunan öra","poem":1},{"lineBreak":true},{"text":"milluycachar nanaywan gaparan, chayno.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rasunpa gueshyacojnömi cashcäcuna.","poem":1},{"lineBreak":true},{"text":"Au, rasunpami nogacunaga nanächicushcä gueshyacuycaj warminöpis.","poem":1},{"lineBreak":true},{"text":"Ichanga wayrata gueshyacuycajnömi nogacunaga cashcä.","poem":1},{"lineBreak":true},{"text":"Manami cay pachacho pitapis salbananpächu yuripacushcä.","poem":1},{"lineBreak":true},{"text":"Cay pachacho tiyananpäga manami pitapis gueshyacushcächu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gamman yäracamoj runacunaga cawarimongami.","poem":1},{"lineBreak":true},{"text":"Allpacho pamparaycajcunami cawarimonga.","poem":1},{"lineBreak":true},{"text":"Nircorga cushicuyllawanmi gaparpangaraj.","poem":1},{"lineBreak":true},{"text":"Llapan guewacunata shullay wiñachir yagarichimushannömi llapan wañushacunatapis cawarachimunquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Marca-masëcuna wasiquiman yaycur puncuyquita wichgacarcäramuy.","poem":1},{"lineBreak":true},{"text":"Tayta Dios rabyasha caycashanpita allchacänancama rätullapis pacacuycuy-llapa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tiyananpitami Tayta Diosga shamoj-aywan","poem":1},{"lineBreak":true},{"text":"cay pachacho tiyajcunata juchanpita castigananpaj.","poem":1},{"lineBreak":true},{"text":"Runa wañuchishan wañojcunata allpaga manami pacanganachu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquin llapantami allpa ricacächenga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}