{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":27,"content":[{"type":"heading","content":["Israelcuna marcanman cutimunanpaj cashan"]},{"type":"verse","number":1,"content":["Chay junajmi Tayta Diosga manchariypaj, jatuncaray sablinwan castiganga Leviatán waräcuyta. Culebrano pillguypa-pillgur aywaycaj Leviatantami castiganga. Lamarcho caycaj waräcuytapis wañuchengami."]},{"type":"verse","number":2,"content":["Chay junaj Tayta Diosga nengapaj:",{"text":"«Fiyupa mishquejta wayoj übas chacrata cantapay-llapa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Noga Tayta Diosmi chay übas chacrataga ricaycä.","poem":1},{"lineBreak":true},{"text":"Mana cachaypami pargupaycäpis.","poem":1},{"lineBreak":true},{"text":"Pagasta junajtapis ricaycämi","poem":1},{"lineBreak":true},{"text":"imapis mana chayananpaj, mana yaycunanpaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paytaga manami rabyapänachu.","poem":1},{"lineBreak":true},{"text":"Fiyucuna yaycuptenga cashata, mana alli guewacunata rupachejnömi illgarachishaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Noga chapänäta munashpan ichanga","poem":1},{"lineBreak":true},{"text":"Nogawan parlachun alli ricanäpaj.","poem":1},{"lineBreak":true},{"text":"¡Nogawan rasunpa alli parlacuchun!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Shamoj watacunachöga Jacobpita miraj Israelcuna tacyangami.","poem":1},{"lineBreak":true},{"text":"Paycunaga guerunömi chillguenga y waytanga.","poem":1},{"lineBreak":true},{"text":"Wayuynenga intëru nasyunpämi aypanga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Diosga Israelcunata manami castigashachu","poem":1},{"lineBreak":true},{"text":"paycunata ñacachejcunata castigashannöga.","poem":1},{"lineBreak":true},{"text":"Israelcunataga manami wañuchishachu","poem":1},{"lineBreak":true},{"text":"paycunata wañuchejta wañuchishannöga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Castigaytaga castigashami. Ichanga yachayllapami castigasha.","poem":1},{"lineBreak":true},{"text":"Acrashan runacunataga nasyunninpita juc-läman prësu apachisha.","poem":1},{"lineBreak":true},{"text":"Imanömi chunyajpita wayra fiyupa wayrämun,","poem":1},{"lineBreak":true},{"text":"chaynömi pichaypa apacuran.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaynöpami Jacobpita mirar aywajcuna jucha rurashantaga perdunanga.","poem":1},{"lineBreak":true},{"text":"Chaymi iscu rumita cuwarcur jururachishanno","poem":1},{"lineBreak":true},{"text":"juccunapaj rupachinan altarcunata ichic-ichiclla rurarenga.","poem":1},{"lineBreak":true},{"text":"Asera diosa-niraj ïdulucuna jucnayllapis manami canganachu.","poem":1},{"lineBreak":true},{"text":"Juc dioscunapaj insinsu saumachicunan altarcunapis manami canganachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Intërunpa curalasha caycaj siudäga chunyajmi ricaconga,","poem":1},{"lineBreak":true},{"text":"runa wasinta cachaycuptin quëdashanno, chunyaj chaqui jircacho runa mana tiyashanno.","poem":1},{"lineBreak":true},{"text":"Chay siudä cashanga canga uywacunata michicunallannami,","poem":1},{"lineBreak":true},{"text":"sacsacarcärir uywancuna puñurpänallannami.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chaychöga yörapa rämancunapis chaquir shicwanga.","poem":1},{"lineBreak":true},{"text":"Chay shicwajta shuntarcurnami warmicuna yanuconga.","poem":1},{"lineBreak":true},{"text":"Chaynöga canga chay runacuna yarpayniynaj captinmi.","poem":1},{"lineBreak":true},{"text":"Chaypitami paycunata Camaj Diosga mana cuyapangachu ni llaquipangapischu.","poem":1}]},{"type":"verse","number":12,"content":["Chay junajmi Tayta Diosga runa rïguta ërashanno ruranga Éufrates mayupita asta Egipto mayucama. Gam Israelcunataga juctapis mana cachaypami juc juclla shuntashunquipaj."]},{"type":"verse","number":13,"content":["Chay junäga trompëtatami tucamongapaj. Chaura Asiriacho ogracasha caycajcunawan Egiptuman prësu aywasha caycajcunapis Jerusalenman shamongapaj fiyupa rispitädu lömacho Tayta Diosta adurananpaj."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}