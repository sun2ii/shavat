{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":28,"content":[{"type":"heading","content":["Samariapaj rimashan"]},{"type":"verse","number":1,"content":[{"text":"¡Ay imanöraj canga Samaria!","poem":1},{"lineBreak":true},{"text":"Payga corönanömi micuyta alli wayuchej altu patacho caycan.","poem":1},{"lineBreak":true},{"text":"Burrächu Efraín runacuna alli-tucushanmi caycan.","poem":1},{"lineBreak":true},{"text":"Chaynöpis caycan adurnu wayta wañuytasha caycajnömi.","poem":1},{"lineBreak":true},{"text":"Chaychöga bïnuta upyallarmi goyarcaycan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chay siudäpaj Tayta Diosga maynami acrasha caycächin callpayoj, munayniyoj runata.","poem":1},{"lineBreak":true},{"text":"Chay runaga runtu tamyanöpis munayniyoj caycan;","poem":1},{"lineBreak":true},{"text":"imatapis illgächej löcu wayranömi;","poem":1},{"lineBreak":true},{"text":"löcu tamyaptin ima aycatapis lloglla apar illgächejnömi;","poem":1},{"lineBreak":true},{"text":"aypalla yacu chayar ima-aycatapis ñiticurcojnömi.","poem":1},{"lineBreak":true},{"text":"Chay runaga charircurmi pampaman sajtarenga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nircur latojpaj lluchcarenga","poem":1},{"lineBreak":true},{"text":"upyallata aroj Efraín runacuna","poem":1},{"lineBreak":true},{"text":"alli-tucushanta, corönanta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adurnu wayta wañuytasha caycäga,","poem":1},{"lineBreak":true},{"text":"micuyta alli wayuchej pampa chacra juc patacho caycäga","poem":1},{"lineBreak":true},{"text":"cangapaj ïgus pogunan wichan rimir-puntata wayojnömi.","poem":1},{"lineBreak":true},{"text":"Pipis chay ïgusta ricärishpan","poem":1},{"lineBreak":true},{"text":"pallarcorga jinan örami micucurcun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Chay junaj quëdaj acrashan runacunapäga","poem":1},{"lineBreak":true},{"text":"munayniyoj Tayta Diosmi cangapaj fiyupa alli corönan,","poem":1},{"lineBreak":true},{"text":"fiyupa cuyayllapaj adurnun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dimanduta arriglaj juezcunatami alli arriglananpaj sumaj tantiyachenga.","poem":1},{"lineBreak":true},{"text":"Siudäta täpaycaj suldärucunatapis masmi balurta gonga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Cananga cüracunawan profëtacunapis machächicojcunata","poem":1},{"lineBreak":true},{"text":"achcata upucurcushpanmi tuni-tuni purircaycan.","poem":1},{"lineBreak":true},{"text":"Tayta Dios willapaycashan örapis tuniycacharcaycan.","poem":1},{"lineBreak":true},{"text":"Dimandacojcunatapis machashami arriglaycan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mësancunachöpis gumitashan ganracunami caycan.","poem":1},{"lineBreak":true},{"text":"Manami ni juc pachallapis canchu limyuga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nogata asipämarmi cayno rimarcaycan:","poem":1},{"lineBreak":true},{"text":"«¿Pita yachaycächishantataj yarpaycan?","poem":1},{"lineBreak":true},{"text":"¿Pitataj willapaycan Dios musyachishanta?","poem":1},{"lineBreak":true},{"text":"¿Chayraj wasguisha caycaj wamracuna cashanchïtachuraj yarpan?","poem":1},{"lineBreak":true},{"text":"¿Chayraj chuchuta cachaycusha wamracuna cashanchïtachuraj yarpan?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"‹Cayta, wacta ruray› niycämanchi.","poem":1},{"lineBreak":true},{"text":"‹Wacta, cayta wiyacuy› niycämanchi.","poem":1},{"lineBreak":true},{"text":"‹Cay-läman, wac-läman witiy› niycämanchi.","poem":1},{"lineBreak":true},{"text":"‹Wac-läman, cay-läman witiy› niycämanchi» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Chayno mana wiyacushayquipitami gamcunataga Tayta Dios willapäshunquipaj mana yachashayqui rimaycho,","poem":1},{"lineBreak":true},{"text":"juc-lä nasyun runacuna rimashan rimaycho.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tayta Diosga unaynami gamcunata nishurayqui:","poem":1},{"lineBreak":true},{"text":"«Cay partichömi caycan alli goyayga.","poem":1},{"lineBreak":true},{"text":"Caychömi caycan jamanayquicunapäga.","poem":1},{"lineBreak":true},{"text":"Uticasha cäga jamachun ari» nir.","poem":1},{"lineBreak":true},{"text":"Ichanga gamcuna manami wiyacurayquichu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chaypitami Tayta Diosga","poem":1},{"lineBreak":true},{"text":"«Cayta, wacta ruray» nishunquipaj.","poem":1},{"lineBreak":true},{"text":"«Wacta, cayta wiyacuy» nishunquipaj.","poem":1},{"lineBreak":true},{"text":"«Cay-läman, wac-läman witiy» nishunquipaj.","poem":1},{"lineBreak":true},{"text":"«Wac-läman, cay-läman witiy» nishunquipaj.","poem":1},{"lineBreak":true},{"text":"Chaura purishpayqui ancallaypami tuninquipaj.","poem":1},{"lineBreak":true},{"text":"Däñacunquipämi. Togllamanmi watacanquipaj.","poem":1},{"lineBreak":true},{"text":"Chaychönami prësu ricacunquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tayta Dios nishanta wiyacuy-llapa,","poem":1},{"lineBreak":true},{"text":"cay Jerusalencho pitapis mana rispitaj mandajcuna.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gamcunaga nircaycanqui:","poem":1},{"lineBreak":true},{"text":"«Wañuywanmi parlashcäcuna fiyupa manchariypaj mana alli chayamuptin","poem":1},{"lineBreak":true},{"text":"nogacuna mana wañunäpaj.","poem":1},{"lineBreak":true},{"text":"Nogacunaga llullacuypami pacacushäcuna.","poem":1},{"lineBreak":true},{"text":"Engañaypami chapacushäcunapis.»","poem":1}]},{"type":"verse","number":16,"content":["Chaypitami Tayta Diosga nin:",{"text":"«Sionmanmi juc rumita churaj-aywä.","poem":1},{"lineBreak":true},{"text":"Chaymanga churashaj acrasha rumitami.","poem":1},{"lineBreak":true},{"text":"Chay rumiga cangapaj llapanpita mas allimi.","poem":1},{"lineBreak":true},{"text":"Jinachöpis chay rumimi simintupa isquïnancho puntu rumi cangapaj.","poem":1},{"lineBreak":true},{"text":"Chayman yäracoj cäga allimi goyanga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaychöga alli goyaymi plomädano canga.","poem":1},{"lineBreak":true},{"text":"Rasun cajta ruraynami nibilno canga.","poem":1},{"lineBreak":true},{"text":"Gamcuna llullacuypa pacacushayquitaga runtu tamyami illgarachengapaj.","poem":1},{"lineBreak":true},{"text":"Chapäshunayquipaj yäracushayquitanami yacu apacongapaj.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wañuywan parlashayquega anulacangami; manami bälenganachu.","poem":1},{"lineBreak":true},{"text":"Fiyupa manchariypaj mana alli disigrasyami chayamongapaj.","poem":1},{"lineBreak":true},{"text":"Chaura chay mana alliga ushajpämi ñitirishunquipaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Cada chayamuyninmi garachasha apashunquipaj.","poem":1},{"lineBreak":true},{"text":"Waran-waranmi, chacaypapis junajpapis chayamongapaj.»","poem":1},{"lineBreak":true},{"text":"Chayamunanpaj caycashanta musyaycullarnami manchariywan sicsicyanquipäpis.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chaura gamcunaga caycanquipaj mana tincushayqui quichqui cawituman puñucuycojnömi,","poem":1},{"lineBreak":true},{"text":"tacshalla gatacunawan gatacojnöllami.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tayta Diosga Perazim jircacho rurashannömi illajpita usharenga.","poem":1},{"lineBreak":true},{"text":"Gabaón guechwacho rurashannömi rabyawan usharenga.","poem":1},{"lineBreak":true},{"text":"Runa tantiyayta mana atipashantami ruranga.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chaymi amana caynachu mana rispitacöga.","poem":1},{"lineBreak":true},{"text":"Mana rispitacoj captiqui wataraycäshushayqui cadina mastami apritacäconga.","poem":1},{"lineBreak":true},{"text":"Nogaga wiyashcänami munayniyoj Tayta Dios","poem":1},{"lineBreak":true},{"text":"cay nasyunta ushajpaj illgächinanpaj mayna nishanta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Sumaj wiyay noga nishäta tantiyacunayquipaj.","poem":1},{"lineBreak":true},{"text":"Noga nishäcunataga juctapis mana cachaypa sumaj tantiyacuy.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Juc runa imata murunanpäpis arorga","poem":1},{"lineBreak":true},{"text":"manami yaparir-yaparir yapyayllaga yapyacunchu.","poem":1},{"lineBreak":true},{"text":"Chayno manami cuspiyar guewancunata tapsillarpis cacunchu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sumaj cuspiyariycorga ¿manachu murutana murun?","poem":1},{"lineBreak":true},{"text":"Machiypa rïguta murun.","poem":1},{"lineBreak":true},{"text":"Sebädatapis murun mayninpapis murunanpaj cajllapami.","poem":1},{"lineBreak":true},{"text":"Abënatapis murun cantullanpami.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Diosmi tantiyachin imano murunanpäpis.","poem":1},{"lineBreak":true},{"text":"Imano alli cashantapis musyachin.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Musyashanchïnöpis eneldotaga manami ëranchïchu.","poem":1},{"lineBreak":true},{"text":"Cominustapis cawalluwanga manami ëracho lluchcachinchïchu.","poem":1},{"lineBreak":true},{"text":"Eneldotaga gueruwan wiruyllapami shicwachinchi,","poem":1},{"lineBreak":true},{"text":"cominustapis llanu guerucunawan wiruyllapami.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Rïgutami ichanga ëranchi.","poem":1},{"lineBreak":true},{"text":"Chaypis manami ñuchunanyäga lluchcachinchïchu.","poem":1},{"lineBreak":true},{"text":"Cawalluwan may-öra lluchcarcacherga","poem":1},{"lineBreak":true},{"text":"rïgu llojshej cajta raquinchi rïguncuna manaraj ñuchuptin.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Chaytapis ruran munayniyoj Tayta Dios yarpayta goptinmi.","poem":1},{"lineBreak":true},{"text":"Paypa yachachicuynenga almiraypämi.","poem":1},{"lineBreak":true},{"text":"Pay yachaj cashanga manami imamanpis tincunchu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}