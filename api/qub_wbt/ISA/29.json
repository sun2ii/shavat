{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":29,"content":[{"type":"heading","content":["Jerusalenpaj rimashan"]},{"type":"verse","number":1,"content":[{"text":"«¡Ay imanöraj canqui Davidpa siudänin Ariel!","poem":1},{"lineBreak":true},{"text":"¡Ay imanöraj canqui David pachacushan Jerusalén siudä!","poem":1},{"lineBreak":true},{"text":"Chay siudächo tiyajcunaga cada wata fistata rurar cushicushpanmi goyarcaycan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ichanga nogami Ariel siudämanga ñacaycunata chayachishaj.","poem":1},{"lineBreak":true},{"text":"Chayrämi canga llaquicuy, wagay.","poem":1},{"lineBreak":true},{"text":"Chay siudä nogapäga cangapaj rupachicuna altarnömi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Intëruyquipa tumarej curalapaycushunayquipämi suldäröcunata cachamushaj.","poem":1},{"lineBreak":true},{"text":"Intëruyquipa tumarejmi guenchawan chapajno chapashaj.","poem":1},{"lineBreak":true},{"text":"Nircur pillyaj yaycamunäpaj escaluncunata jatarachishaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pengaypämi jitarpaycar quëdanquipaj.","poem":1},{"lineBreak":true},{"text":"Rimashayquipis almapanöllami wiyacanga.","poem":1},{"lineBreak":true},{"text":"Parlashayquicunaga pajallami wiyacanga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ichanga mana yarpashapitami","poem":1},{"lineBreak":true},{"text":"Noga munayniyoj Tayta Diosga chiquishojcunata castigashaj.","poem":1},{"lineBreak":true},{"text":"Paycunataga castigashaj räyuwan, timlurwan,","poem":1},{"lineBreak":true},{"text":"löcu wayrawan, löcu tamyawan.","poem":1},{"lineBreak":true},{"text":"Chay aypalla chiquishojcunaga quëdangapaj ñuchu allpamanno ticrashami.","poem":1},{"lineBreak":true},{"text":"Aypalla gaticachäshojcunaga cangapaj chaqui pangata wayra apashanömi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aypalla nasyun runacuna Arielcho tiyajcunawan pillyarcaycäga","poem":1},{"lineBreak":true},{"text":"illgangapaj suyñunöllami.","poem":1},{"lineBreak":true},{"text":"Llapan magaycaj runacunaga,","poem":1},{"lineBreak":true},{"text":"perga curralta juchuycächejcunaga illgangapaj chacaypa ricapacushannöllami.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chayga cangapaj yargaypita puñur runa suyñuynincho micushannömi.","poem":1},{"lineBreak":true},{"text":"Riccharamorga jinalla yargaycan.","poem":1},{"lineBreak":true},{"text":"Yacunaycaj runa suyñuynincho yacuta upushanno canga.","poem":1},{"lineBreak":true},{"text":"Riccharamorga jinalla callpaynaj, yacunaypita cuncanpis chaquisha caycashanno canga.","poem":1},{"lineBreak":true},{"text":"Sión lömaman achca nasyun runacuna pillyaj shamojcunaga","poem":1},{"lineBreak":true},{"text":"manami imatapis rurangapächu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¡Ariel runacuna, gamcunaga jinalla goyarcaycay mana tantiyacuypa!","poem":1},{"lineBreak":true},{"text":"¡Gaprano, imatapis mana ricajno goyarcaycay!","poem":1},{"lineBreak":true},{"text":"¡Machächicojta mana upusha caycashpayquicunapis machasha runano tapraycachaycanqui!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Diosmi camacächisha gamcuna fiyupa wañuy puñuypa puñucäcunayquipaj.","poem":1},{"lineBreak":true},{"text":"Profëtacunami caycan llapan runacunapa ñawinnöpis.","poem":1},{"lineBreak":true},{"text":"Ichanga Tayta Diosmi bendarcusha mana ricananpaj.","poem":1}]},{"type":"verse","number":11,"content":["Chaymi Tayta Dios ribilashanga gamcunapaj caycan mana pipis liguinanpaj lagasha caycaj rölluno. Liguiy-yachaj runata pitapis chay rölluta liguipänanpaj «Tayta cayta liguipämay» niptin, chay runaga nengapaj: «Manami liguëmanchu. Lagashami caycan» nir."]},{"type":"verse","number":12,"content":["Liguiyta mana-yachaj runata chay rölluta liguipänanpaj «Tayta cayta liguipämay» niptin chay runaga nenga: «Manami liguiyta yachächu» nir."]},{"type":"verse","number":13,"content":["Tayta Dios nin:",{"text":"«Cay runacunaga shimillanwanmi sirbiman.","poem":1},{"lineBreak":true},{"text":"Janan shongullami alabaman.","poem":1},{"lineBreak":true},{"text":"Shongunchöga juctami yarparcaycan.","poem":1},{"lineBreak":true},{"text":"Nogata aduraycämashanga caycan runacuna yarpaynillanpita nishancunallami.","poem":1},{"lineBreak":true},{"text":"Paycunaga runa yachachishannöllami aduraycäman.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chaypitami cay runacunapäga tantiyayta mana camäpacunanpaj camacächishaj.","poem":1},{"lineBreak":true},{"text":"Camacächishaj cay runacuna fiyupa almirananpaj.","poem":1},{"lineBreak":true},{"text":"Yachajcunapa yachaj cayninpis,","poem":1},{"lineBreak":true},{"text":"tantiyajcunapa tantiyaj cayninpis manami canganachu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"¡Ay imanöraj canqui mana allita rurananpaj yarpaycashanta pacashpan Tayta Diospita pacacojcuna!","poem":1},{"lineBreak":true},{"text":"Paycunaga chacaypami mana allicunata ruran.","poem":1},{"lineBreak":true},{"text":"Nircur «Manami pipis ricamanchïchu. Manami pipis musyanchu» nin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Chayno yarpar llutantami yarpaycan!","poem":1},{"lineBreak":true},{"text":"¿Manca rurajwan mancaga iwalchuraj?","poem":1},{"lineBreak":true},{"text":"¿Rurasha caycäga rurajta ninmanchuraj:","poem":1},{"lineBreak":true},{"text":"«Gamga manami ruramashcanquichu» nir?","poem":1},{"lineBreak":true},{"text":"¿Imanirajtapis rurashanpita mituga rurajta nengachuraj:","poem":1},{"lineBreak":true},{"text":"«Manami rurayta yachanquichu» nir?","poem":1}]},{"type":"heading","content":["Israelta salbananpaj aunishan"]},{"type":"verse","number":17,"content":[{"text":"Cananpita manapis aycällatami Libanoga ticracurengapaj muruna chacraman.","poem":1},{"lineBreak":true},{"text":"Muruna chacranami micuy alli wayuptin muntinöraj ricacongapaj.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chay junäga mana wiyaj upacunapis","poem":1},{"lineBreak":true},{"text":"liguipashanta wiyanganami.","poem":1},{"lineBreak":true},{"text":"Gapracunapis ricanganami.","poem":1},{"lineBreak":true},{"text":"Manami chacaychönönachu canga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tayta Dios yanapaptinmi","poem":1},{"lineBreak":true},{"text":"umildicunaga cushiconga.","poem":1},{"lineBreak":true},{"text":"Pobricunapis cushishami goyangapaj","poem":1},{"lineBreak":true},{"text":"Israelcuna sirbishan Santo Tayta Dios yanapaptin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mana rispitacojcunaga manami canganachu.","poem":1},{"lineBreak":true},{"text":"Fiyucunapis manami canganachu.","poem":1},{"lineBreak":true},{"text":"Llutan ruraycunallata yarpajcunapis illganganami.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ushacanganami manacajpita jitapajcunapis,","poem":1},{"lineBreak":true},{"text":"dimanduta arriglaj juezcunata mana alliman chayachejcunapis.","poem":1},{"lineBreak":true},{"text":"Manami canganachu alli runata lebantashpan jitapajcunapis.","poem":1}]},{"type":"verse","number":22,"content":["Chaypitami Abrahamta jorgamoj Tayta Diosga Israelcunata nin:",{"text":"«Cananpitaga Jacobpita miraj Israelcuna manami pengaycho canganachu.","poem":1},{"lineBreak":true},{"text":"Cäranpis manchacuywan manami jucajyacäconganachu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Paycunapita mirar-aywajcunaga nasyunnincho imano rurashätapis ricashpan","poem":1},{"lineBreak":true},{"text":"Noga juchaynaj cashäta musyangapaj.","poem":1},{"lineBreak":true},{"text":"Israelcunapa Santo Tayta Diosnin captë","poem":1},{"lineBreak":true},{"text":"Nogallatana rispitamangapaj.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mana tantiyajcunapis yachaj caytami yachaconga.","poem":1},{"lineBreak":true},{"text":"Jamurpäcojcunapis yachachishanta wiyaconganami.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":23}