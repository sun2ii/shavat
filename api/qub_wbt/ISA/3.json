{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":3,"content":[{"type":"heading","content":["Judäwan Jerusalén runacuna castigacänanpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"¡Ricay-llapa!","poem":1},{"lineBreak":true},{"text":"Munayniyoj Tayta Diosmi","poem":1},{"lineBreak":true},{"text":"Judá nasyuntawan capitalnin Jerusalenta cachayconga.","poem":1},{"lineBreak":true},{"text":"Micuytawan yacutapis apacongami.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chaynöpis manami canganachu","poem":1},{"lineBreak":true},{"text":"jinyu runacuna, pillyay yachajcuna,","poem":1},{"lineBreak":true},{"text":"juezcuna, profëtacuna,","poem":1},{"lineBreak":true},{"text":"musyacojcuna, mayur runacuna,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"mandaj capitancuna, mas rispitädu runacuna,","poem":1},{"lineBreak":true},{"text":"tantiyachejcuna, sumaj yachajcuna,","poem":1},{"lineBreak":true},{"text":"brüjucunapis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nircorga mana yachaj wamracunallatanami mandajnin cananpaj churapanga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaura runacunaga rimanacullarnami goyangapaj.","poem":1},{"lineBreak":true},{"text":"Chaymi jucnin-jucnin amïgu carpis jucwan-jucwan chiquinaconga, pillyanga.","poem":1},{"lineBreak":true},{"text":"Mösucunapis auquincunata mana rispitar chiquicarcärenga.","poem":1},{"lineBreak":true},{"text":"Pobricunapis rïcucunata chiquicarcärenga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chayno captinnami juc runaga papäninpa wasincho wauguinta nenga:","poem":1},{"lineBreak":true},{"text":"«Gampaga caycanrämi röpallayquipis jaticunayquipaj.","poem":1},{"lineBreak":true},{"text":"Nogacunapa mandajnë cay ari.","poem":1},{"lineBreak":true},{"text":"Mana alli goyarcaycajta jorgamay.»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaura wauguenga nengapaj:","poem":1},{"lineBreak":true},{"text":"«Fiyupa mana allicho caycajtaga ¿imanöpataj gamta jorgöman?","poem":1},{"lineBreak":true},{"text":"Nogapaga manami canchu micuynëpis ni röpäpis.","poem":1},{"lineBreak":true},{"text":"Ama churamaychu cay marcapa mandajnin canäpäga.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rasunpami Jerusalenga juchonga.","poem":1},{"lineBreak":true},{"text":"Judá nasyunnami pasaypa mana allicho ricaconga.","poem":1},{"lineBreak":true},{"text":"Chaynöga canga munayniyoj Tayta Dios nishanta mana cäsushpan","poem":1},{"lineBreak":true},{"text":"llutancunata rurashanpitami,","poem":1},{"lineBreak":true},{"text":"Tayta Diospa contran mana allicunata rimashanpitami.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Juchata rurashancunaga alayrimi musyacaycan.","poem":1},{"lineBreak":true},{"text":"Juchata rurashancunataga manami pacanchu.","poem":1},{"lineBreak":true},{"text":"Sodoma runacunapaj mayacashannömi may-chaymanpis mayacaycächin.","poem":1},{"lineBreak":true},{"text":"¡Ay imanöraj canga paycunaga!","poem":1},{"lineBreak":true},{"text":"Quiquincunallami castigasha caytapis ashircaycan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alli runacunatami ichanga ima rurashallanpis alli llojshipanga.","poem":1},{"lineBreak":true},{"text":"Allita rurashanpitami alli cawanga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Ay imanöraj canga juchasapacuna!","poem":1},{"lineBreak":true},{"text":"Paycunataga imatapis rurashanman-tupumi Tayta Dios cutichenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Marca-masëcuna, wamracunallami llutanta ruraycächishunqui.","poem":1},{"lineBreak":true},{"text":"Mandajniquicunapis warmicunallami caycan.","poem":1},{"lineBreak":true},{"text":"Mandajniquicunallami engañaycäshunqui.","poem":1},{"lineBreak":true},{"text":"Llutantami ruraycächishunqui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tayta Diosga acrashan runacunata dimandananpänami caycan.","poem":1},{"lineBreak":true},{"text":"Paycunata juchanpita jusgananpänami caycan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tayta Diosmi arriglananpaj gayachishpan","poem":1},{"lineBreak":true},{"text":"dimanducho arriglajcunatawan mandajcunata nenga:","poem":1},{"lineBreak":true},{"text":"«Gamcunami übas wertäno caycajcunatapis illgächishcanqui.","poem":1},{"lineBreak":true},{"text":"Pobricunatapis suwapashcanqui.","poem":1},{"lineBreak":true},{"text":"Suwacushayquicunatanami wasiquicunaman juntaycächinqui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¿Imanirtaj chaynöga acrashä runacunata ñacaycächinqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj pobricunata ñacachishcanqui?»","poem":1},"Munayniyoj Tayta Diosmi chayno nishunqui."]},{"type":"heading","content":["Jerusalén warmicuna castigacänanpaj cashan"]},{"type":"verse","number":16,"content":["Mastapis Tayta Diosga nin:",{"text":"«Sión warmicunaga fiyupami alli-tucun.","poem":1},{"lineBreak":true},{"text":"Ñuquiycachaycar guepishtaycachar-raj purinpis.","poem":1},{"lineBreak":true},{"text":"Chaquinman watacushancunata suynachinanpämi jinallanman jinallanmanraj japaycunpis.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaypita castigashpämi umantapis garachuwan galayächishaj.","poem":1},{"lineBreak":true},{"text":"Llapan runa ricaymi gala-umalla purenga.»","poem":1}]},{"type":"verse","number":18,"content":["Chay junäga Tayta Diosmi ushajpaj illgächenga warmicuna camaränanpaj jaticunancunata: chaquincho camarächinanpaj caj shall-shallyajcunata, vinchancunata, coröna-niraj adurnuncunatapis,"]},{"type":"verse","number":19,"content":["wallgacunata, brasalëtancunata, uman shucutancunata,"]},{"type":"verse","number":20,"content":["uma adurnuncunata, chaquinman churacunan brasalëtacunata, chegllanman watacunan sintillucunata, pömuwan perfümicunata, surtipaj charashancunata,"]},{"type":"verse","number":21,"content":["surtïjacunata, camaränanpaj senganman jaticunancunata,"]},{"type":"verse","number":22,"content":["cuyayllapaj alli röpacunata, jacucunata, pañuylucunata,"]},{"type":"verse","number":23,"content":["espëjucunata, fïnu tëlacunata, uman shucutacuna tëlacunata, mantïllacunata."]},{"type":"verse","number":24,"content":[{"text":"Chay junäga perfümipa ruquin canga melanaypaj asyayllami.","poem":1},{"lineBreak":true},{"text":"Chegllantapis watacongapaj wascawannami.","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj ñajchasha cananpa ruquin ajchaynaj gala-umami cangapaj.","poem":1},{"lineBreak":true},{"text":"Alli röpacunata jaticunanpa ruquin jaticongapaj gachga röpatami.","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj gagllan cananpa ruquin cangapaj wayllasha fyërruwan rupachishami.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Jerusalencho tiyaj ollgu cajcunaga llapanmi guërracho wañonga.","poem":1},{"lineBreak":true},{"text":"Guërrachömi pillyay yachajcunapis ushacanga.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Siudächo caycajcunaga wagar llaquicur lütu röpata jaticongapaj.","poem":1},{"lineBreak":true},{"text":"Mana pipis washaptinmi llaquicur allpaman jamacongapaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}