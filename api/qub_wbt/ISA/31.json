{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":31,"content":[{"type":"heading","content":["Egiptuman yäracojcunapaj rimashan"]},{"type":"verse","number":1,"content":[{"text":"¡Ay imanöraj canqui yanapänanpaj Egiptucunaman ruwacoj aywajcuna;","poem":1},{"lineBreak":true},{"text":"Egipto runacunapa cawalluncunaman yäracojcuna;","poem":1},{"lineBreak":true},{"text":"aypalla carrëtancuna cashanman yäracojcuna;","poem":1},{"lineBreak":true},{"text":"cawalluta muntacurcur pillyajcunaman yäracojcuna!","poem":1},{"lineBreak":true},{"text":"Paycunaga yarpayllapis manami yarpärinchu Israelcunapa Santo Tayta Diosninman.","poem":1},{"lineBreak":true},{"text":"Paymanga manami yäracunpischu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Diosga fiyupa yarpaysapami.","poem":1},{"lineBreak":true},{"text":"Chaymi musyan imanöpa disigrasyata chayachiytapis.","poem":1},{"lineBreak":true},{"text":"Imano rurananpäpis nishantaga simrimi cumplin.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunataga castigangami.","poem":1},{"lineBreak":true},{"text":"Mana allita rurajcunata yanapajcunatapis castigangami.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Egipto runacunaga runallami, manami dioscunachu.","poem":1},{"lineBreak":true},{"text":"Cawalluncunapis aychallami, manami espirituchu.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga paycunata castigangami.","poem":1},{"lineBreak":true},{"text":"Chauraga yanapaj Egiptuwan, «yanapämay» nej cajpis mana allimanmi chayangapaj.","poem":1},{"lineBreak":true},{"text":"Llapan iwalmi wañongapaj.","poem":1}]},{"type":"verse","number":4,"content":["Tayta Dios nimaran:",{"text":"«Juc liyun uyshata wañuycachiptin,","poem":1},{"lineBreak":true},{"text":"llapan uyshërucuna shuntacaycur","poem":1},{"lineBreak":true},{"text":"manchachinanpaj gaparpaptinpis","poem":1},{"lineBreak":true},{"text":"liyonga manami manchacunnachu.","poem":1},{"lineBreak":true},{"text":"Chaynömi shamonga munayniyoj Tayta Diosga","poem":1},{"lineBreak":true},{"text":"Sión lömacho caycaj acrashan runacunata washänanpaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Imanömi äbi gueshwancho chipshan caycajta täpar jananpa tumapan,","poem":1},{"lineBreak":true},{"text":"chaynömi Jerusalentaga munayniyoj Tayta Dios chapangapaj.","poem":1},{"lineBreak":true},{"text":"Imapitapis ricanga, salbanga, washanga,","poem":1},{"lineBreak":true},{"text":"libri cananpaj ima-aycapitapis jorgonga.»","poem":1}]},{"type":"verse","number":6,"content":["Israelcuna, gamcunaga Tayta Diosta manami wiyacushcanquichu. Cananga paytana yapay wiyacuy ari."]},{"type":"verse","number":7,"content":["Chay junäga jucha ruraj maquiquiwan quiquiquicunami goripitawan guellaypita rurashayqui ïdulucunata llapaniqui jitarinquipaj."]},{"type":"verse","number":8,"content":[{"text":"«Asiria runacunaga llapanmi sabliwan wañongapaj.","poem":1},{"lineBreak":true},{"text":"Ichanga manami runacunapa espädanwanchu wañonga.","poem":1},{"lineBreak":true},{"text":"Sinöga quiquëpa espädäwanmi ushacanga.","poem":1},{"lineBreak":true},{"text":"Guërra captin chay runacunaga gueshpirmi aywacongapaj.","poem":1},{"lineBreak":true},{"text":"Pillyay-yachaj mösucunatanami uywayman ticrachengapaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Paycunapa pacacunanpis manchariyllawanmi juchucäconga.","poem":1},{"lineBreak":true},{"text":"Capitannincunapis bandërancunata cachaycur gueshpir aywaconga.»","poem":1},{"lineBreak":true},{"text":"Chayno cananpäga Tayta Diosmi nisha.","poem":1},{"lineBreak":true},{"text":"Payga chiquejcunata castigananpaj camarishanami caycächin","poem":1},{"lineBreak":true},{"text":"Sioncho nina rataycajta, Jerusalenchöna rataycaj jurnïllata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}