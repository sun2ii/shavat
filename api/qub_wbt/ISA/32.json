llapantami alli tantiyanga.","poem":1},{"lineBreak":true},{"text":"Gägucunapis mana ñacapacayllapa clärunami rimangapaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fiyu runataga manami «alli runa» nenganachu.","poem":1},{"lineBreak":true},{"text":"Engañacojcunatapis manami «rispitädu runa» nenganachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fiyu runaga mana allillatami parlan.","poem":1},{"lineBreak":true},{"text":"Yarpayninchöpis yarpaycan mana allita ruranallanpämi.","poem":1},{"lineBreak":true},{"text":"Tayta Dios melanäcushancunatami ruran.","poem":1},{"lineBreak":true},{"text":"Tayta Diospäga llutancunatami riman.","poem":1},{"lineBreak":true},{"text":"Pishipacojcunatapis manami yawaycachinchu.","poem":1},{"lineBreak":true},{"text":"Yacunaycajtapis manami yacuta chagapaycunchu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Engañacojcunaga yäracun engañayta yachashallanmanmi.","poem":1},{"lineBreak":true},{"text":"Melanaypajcunata rurayllatami yarparaycan.","poem":1},{"lineBreak":true},{"text":"Pobricunatapis llullapaypami llaquicachin.","poem":1},{"lineBreak":true},{"text":"Alli arriglananta ashiycajcunatapis mana allimanmi churan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alli runami ichanga allillata ruran.","poem":1},{"lineBreak":true},{"text":"Chaymi paytaga pipis rispitan.","poem":1}]},{"type":"heading","content":["Mana yarpachacoj warmicunapaj nishan"]},{"type":"verse","number":9,"content":[{"text":"Imapäpis mana yarpachacoj warmicuna","poem":1},{"lineBreak":true},{"text":"canan nishäta sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Imanöpis caycashallayquiman yarparajcuna","poem":1},{"lineBreak":true},{"text":"canan nishäta sumaj tantiyacuy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gamcuna cananga mana yarpachacuypa goyarcaycanqui.","poem":1},{"lineBreak":true},{"text":"Cananpita wata masllataga fiyupami llaquicunquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga canquipaj cosëchata mana shuntar.","poem":1},{"lineBreak":true},{"text":"Yapayga manami übasta shuntanquipänachu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Imapäpis mana yarpachacuypa goyaycajcuna, manchariywan sicsicyay.","poem":1},{"lineBreak":true},{"text":"Imanöpis caycashallayquiman yarparajcuna llaquicuy.","poem":1},{"lineBreak":true},{"text":"Jatiraycashayqui alli röpayquicunata lojticuy.","poem":1},{"lineBreak":true},{"text":"Nircorga llaquicur jaticunayqui röpayquicunatana jaticuy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Micuy alli wayunan chacracunapaj, übas alli wayunan chacracunapaj","poem":1},{"lineBreak":true},{"text":"llaquicushpayqui pëchuyquita cutacuy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Acrashä runacunapa chacrancunachöga wiñamonga cashawan jachacunallami shatayänanpaj.","poem":1},{"lineBreak":true},{"text":"Cushicur goyashan wasincunachöpis wiñamonga cashawan jachacunallanami.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Palasyucho pipis manami tiyangachu.","poem":1},{"lineBreak":true},{"text":"Aypalla runacuna tiyashan siudäpis chunyajmi ricacongapaj.","poem":1},{"lineBreak":true},{"text":"Sumaj curalasha siudäcunatapis para-simrimi cachaycärengapaj.","poem":1},{"lineBreak":true},{"text":"Chaura chaychöga chucaru bürrucunami cushisha tiyangapaj.","poem":1},{"lineBreak":true},{"text":"Manshu uywacunatapis chaychömi michengapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Chaynöga cangapaj janaj pachapita Espíritu noganchïman chayamunancamami.","poem":1},{"lineBreak":true},{"text":"Chaura chunyaj chaqui jircapis ticrangapaj muruna chacramannami.","poem":1},{"lineBreak":true},{"text":"Muruna chacracunachönami micuy fiyupa wayongapaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nasyun intëruchöpis","poem":1},{"lineBreak":true},{"text":"rasun cajtawan alli cajllatanami pï-maypis ruranga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaura llapanpis alli goyayllana canga.","poem":1},{"lineBreak":true},{"text":"Allillanami imaycamapis goyanga.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Acrashä runacunaga allillami tiyangapaj.","poem":1},{"lineBreak":true},{"text":"Mana manchacuypa sigüru wasicunachömi tiyangapaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Munticunata runtu tamya ushariptinpis,","poem":1},{"lineBreak":true},{"text":"siudäcuna juchuchir-ushasha captinpis","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"gamcunaga cushishami goyanquipaj.","poem":1},{"lineBreak":true},{"text":"Murushayquicunata pargunayquipaj achca yacu canga.","poem":1},{"lineBreak":true},{"text":"Guewapis mana pishiypami canga bürrucunapaj y wäcacunapaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}