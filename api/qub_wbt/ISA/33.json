{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":33,"content":[{"type":"heading","content":["Tayta Dios salbamajninchi cashan"]},{"type":"verse","number":1,"content":[{"text":"Ay imanöraj canqui jucta illgächej.","poem":1},{"lineBreak":true},{"text":"Gamtaga manarämi illgächishunquirächu.","poem":1},{"lineBreak":true},{"text":"Ay imanöraj canqui juccunata engañaj.","poem":1},{"lineBreak":true},{"text":"Manami engañasharächu caycanqui.","poem":1},{"lineBreak":true},{"text":"Illgächiyta ushaycorga quiquiquipis illganquipämi.","poem":1},{"lineBreak":true},{"text":"Juccunata engañayta ushaycuptiquega quiquiquitapis engañashunquipämi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Dios, nogacunataga cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Nogacunaga gammanmi yäracaycämö.","poem":1},{"lineBreak":true},{"text":"Cada tuta yanapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Ñacaycunacho caycashä örapis salbaycamay ari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Busniqui junrurumushanta wiyaycur runacunaga gueshpirmi aywacun.","poem":1},{"lineBreak":true},{"text":"Rabyar jataricurcuptiquega llapan nasyun runacunami machiypa-machir aywacun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gueshpir aywacushanpa cösancunatanami contrancuna charicarcärin.","poem":1},{"lineBreak":true},{"text":"Chüpacacunanömi llapanta ushacarcärin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Munayniyoj Tayta Diosga syëluchömi tiyan.","poem":1},{"lineBreak":true},{"text":"Paymi camacächisha Sioncho alli cajta, rasun cajta rurananpaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paymi imapitapis imaypis chapanga.","poem":1},{"lineBreak":true},{"text":"Paymi salbanga, sumaj yachayta gonga, sumaj tantiyachenga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta rispitar yäracushanga canga ima-aycatapis charashannömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Masqui wiyay, jinyu runacunaga imanöshi llaquicurcaycan.","poem":1},{"lineBreak":true},{"text":"Alli goyänanpaj parlaj cacha aywajcunapis imanöshi wagarcaycan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nänicunapis chunyajmi ricacusha.","poem":1},{"lineBreak":true},{"text":"Pipis manami purinnachu.","poem":1},{"lineBreak":true},{"text":"Alli goyänanpaj parlacushantapis manami cumlinnachu.","poem":1},{"lineBreak":true},{"text":"Manami mayganpis rispitanacunnachu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Allpaga fiyupami chaquicäcusha. Imatapis mana wayuchinnachu.","poem":1},{"lineBreak":true},{"text":"Líbano muntipis wañuytacäcushami.","poem":1},{"lineBreak":true},{"text":"Sarón guechwapis chunyaj chaqui jircanami ricacusha.","poem":1},{"lineBreak":true},{"text":"Basán puntawan Carmelo puntapis garayashami caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tayta Diosmi cayno nin:","poem":1},{"lineBreak":true},{"text":"«Cananmi castigayta gallaycushaj.","poem":1},{"lineBreak":true},{"text":"Cananmi musyachishaj munayniyoj cashäta.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gamcuna rurayta yarpaycashayquiwan rurashayquipis caycan ogshanölla, rïgu päjanölla.","poem":1},{"lineBreak":true},{"text":"Chayno captinmi pücarcuptillä jämaynëga nina rupacurcojnöpis usharengapaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Juc-lä nasyun runacunaga rupar uchpayajnömi ushacangapaj.","poem":1},{"lineBreak":true},{"text":"Cashata muturcur sindipaycusha nina ratarir ushacurcushannömi illgangapaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Carucho tiyajcuna wiyay-llapa imano rurashätapis parlajta.","poem":1},{"lineBreak":true},{"text":"Sercacho caycajcunaga tantiyacuy ari munayniyoj cashäta.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Juchayojcunaga Sioncho sicsicyanmi.","poem":1},{"lineBreak":true},{"text":"Diosman mana yäracojcunami fiyupa mancharishpan cayno nircaycan:","poem":1},{"lineBreak":true},{"text":"«¿Mayganchïraj awantashwan rupar ushacoj ninataga?","poem":1},{"lineBreak":true},{"text":"¿Mayganchïraj cawaycushwan imaycamapis mana upej ninachöga?» nir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Alliga cawanga","poem":1},{"lineBreak":true},{"text":"alli cajllata ruraj cajmi,","poem":1},{"lineBreak":true},{"text":"rasun cajllata parlaj cajmi,","poem":1},{"lineBreak":true},{"text":"rïcuyänanpaj firsapita pipa imantapis mana guechoj cajmi,","poem":1},{"lineBreak":true},{"text":"faburnin cananpaj pacayllapa pägaptinpis mana chasquej cajmi,","poem":1},{"lineBreak":true},{"text":"wañuchinanpaj shimita goptinpis mana chasquej cajmi,","poem":1},{"lineBreak":true},{"text":"mana allita ruraycajta mana ricananpaj witicoj cajmi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chayno cawaj cajmi alli pachacho cawanga.","poem":1},{"lineBreak":true},{"text":"Chay runaga goyanga gagacho rurasha caycaj pacacunachönömi.","poem":1},{"lineBreak":true},{"text":"Chay runapaga micuyninpis yacupis manami pishengachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Rayta ricanquipaj munayniyoj cuyayllapaj caycajta.","poem":1},{"lineBreak":true},{"text":"Nasyunpa lindancunapis mas carucamami canga.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fiyupa manchacur goyashayquita yarpärir ninquipaj:","poem":1},{"lineBreak":true},{"text":"«¿Cananga maytaj impuestuta pägashanta yupajcuna?","poem":1},{"lineBreak":true},{"text":"¿Maytaj ayca imano lasashantapis ricajcuna?","poem":1},{"lineBreak":true},{"text":"¿Maytaj ricachacuna törricunata yupaycajcuna?» nir.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Manami ricanquipänachu mana rispitacoj runacunata,","poem":1},{"lineBreak":true},{"text":"mana tantiyashayquita parlajcunata,","poem":1},{"lineBreak":true},{"text":"mayganpis mana tantiyashanta talluypa tallur rimajcunata.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Imaypis rispitädu fistata ruracunanchi Sión siudäta masqui ricäriy.","poem":1},{"lineBreak":true},{"text":"Alli goyay cashan Jerusalén siudäman masqui ricäriy.","poem":1},{"lineBreak":true},{"text":"Chay siudäga cangapaj witichinalla tolduta ichichiptin","poem":1},{"lineBreak":true},{"text":"istägancuna mana achucajno,","poem":1},{"lineBreak":true},{"text":"chutaraycaj wascancunapis mana rachicajno.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chaychömi noganchïtaga Tayta Dios musyachimäshun munayniyoj cashanta.","poem":1},{"lineBreak":true},{"text":"Chaypaga päsangapaj achca mayucunami, jatuncaray sicyacunami.","poem":1},{"lineBreak":true},{"text":"Chaymanga chiquinacushanchïcuna manami yaycongapächu","poem":1},{"lineBreak":true},{"text":"tacsha büquicunawan ni jatuncaray büquicunawanpis.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chay büquicunapa wascancunapis","poem":1},{"lineBreak":true},{"text":"manami watarangapächu guerun ichirajcunaman.","poem":1},{"lineBreak":true},{"text":"Wayra tangananpaj bëlunpis manami mashtacangachu.","poem":1},{"lineBreak":true},{"text":"Chaynöga cangapaj Tayta Dios juezninchi captinmi.","poem":1},{"lineBreak":true},{"text":"Paymi caycan layninchïta ruraj; Paymi rayninchïpis.","poem":1},{"lineBreak":true},{"text":"Paymi salbamäshunpaj.","poem":1},{"lineBreak":true},{"text":"Chauraga chiquinacushanchïpa ima-aycantapis aypallatami guechushunpaj.","poem":1},{"lineBreak":true},{"text":"Guechurcur raquipänacushaga gapracunapis chasquengami.","poem":1},{"lineBreak":true},{"text":"Wegrucunapis yaycongapämi ima-aycantapis guechur apacunanpaj.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Sioncho tiyajcunataga llapan juchanpitami Tayta Dios perdunanga.","poem":1},{"lineBreak":true},{"text":"Chaycho tiyäga manami pipis «Gueshyaycä» nengapächu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":23}