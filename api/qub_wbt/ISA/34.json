{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":34,"content":[{"type":"heading","content":["Nasyuncunapa contran Tayta Dios rimashan"]},{"type":"verse","number":1,"content":[{"text":"Llapaniqui shamuy wiyanayquipaj.","poem":1},{"lineBreak":true},{"text":"Tantiyanayquipaj sumaj wiyay marcacuna, nasyuncuna.","poem":1},{"lineBreak":true},{"text":"Wiyachun cay pachapis, cay pachacho cajcunapis.","poem":1},{"lineBreak":true},{"text":"Wiyachun mundu intërupis, munducho llapan cajcunapis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Diosga nasyuncunapaj rabyashami caycan.","poem":1},{"lineBreak":true},{"text":"Rabyashami caycan nasyuncunapa suldäruncunapäpis.","poem":1},{"lineBreak":true},{"text":"Paymi llapanta illgächenga; ushajpaj wañuchenga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wañojcunatapis manami pipis shuntangachu.","poem":1},{"lineBreak":true},{"text":"Chaycunaga fiyupa melanaypämi asyarenga.","poem":1},{"lineBreak":true},{"text":"Intëru jircapapis yacunörämi yawarpis aywanga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Syëlupis llapan chaycho caycajcunapis papil cauchucajnömi pitucäconga.","poem":1},{"lineBreak":true},{"text":"Estrëllacunapis manana achicyar chaquisha öjanömi shicwacamonga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rasunpami Tayta Diospa sablenga syëlucho yurenga.","poem":1},{"lineBreak":true},{"text":"Chay sabliga Edom runacunamanmi yaganga.","poem":1},{"lineBreak":true},{"text":"Edom runacunataga Tayta Diosmi wañunanpaj distinasha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Edomchömi fiyupa wañuchinacuy canga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga Bosra siudächömi rupachinanpaj pishtanga.","poem":1},{"lineBreak":true},{"text":"Chaymi Tayta Diospa sablenga yawarpita y wirapita ñitisha caycangapaj.","poem":1},{"lineBreak":true},{"text":"Uyshacunapawan chïbucunapa yawarnin wiran ñitisha caycajnömi caycanga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chay runacunawan iwalmi wañongapaj chucaru wäcapis,","poem":1},{"lineBreak":true},{"text":"töru-mallwacunapis, buyicunapis.","poem":1},{"lineBreak":true},{"text":"Chay nasyunchöga intëruchömi yawar mashtaranga.","poem":1},{"lineBreak":true},{"text":"Ñuchu allpapis wirawan tacushallami caycangapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Chayno canga chay junaj Tayta Dios ayñita cutichiptinmi.","poem":1},{"lineBreak":true},{"text":"Chay watami Sionga ñacachejcunata ayñita cutichenga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Edom nasyuncho caj ragracunapaga breyana aywanga.","poem":1},{"lineBreak":true},{"text":"Ñuchu allpacunana asufriman ticracurenga.","poem":1},{"lineBreak":true},{"text":"Chaura chay Edom nasyun partiga breyanörämi ratanga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chacaypa ni junajpapis manami upengapänachu.","poem":1},{"lineBreak":true},{"text":"Imaypis goshtayga jatariycangami.","poem":1},{"lineBreak":true},{"text":"Imaycamapis chayno ushacasha ragällanna caconga.","poem":1},{"lineBreak":true},{"text":"Chaypaga manami pipis purengapänachu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chaychöga tiyangapaj pillyaj jutiyoj äbicunawan chushyajcunallami.","poem":1},{"lineBreak":true},{"text":"Gueshwancunatapis rurangapaj quillicsawan tucumi.","poem":1},{"lineBreak":true},{"text":"Chay nasyuntaga yarpashannömi Tayta Dios ticrachengapaj chunyajman.","poem":1},{"lineBreak":true},{"text":"Imapis manami canganachu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yapayga mananami raynin cangapänachu.","poem":1},{"lineBreak":true},{"text":"Mandajnincuna ushajpämi illganga.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Palasyucunachöpis cashallanami wiñamonga.","poem":1},{"lineBreak":true},{"text":"Pacacunanchönami ishancacunawan shirallana wiñanga.","poem":1},{"lineBreak":true},{"text":"Chay partiga ticrangapaj jirca allgucunapa tiyananman,","poem":1},{"lineBreak":true},{"text":"Avestruz äbicuna puñunallanmanna.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Oshgu mishicunawan jirca allgucunallanami tiyanga.","poem":1},{"lineBreak":true},{"text":"Jacha cabracunallami wacpita-caypita wagapänaconga.","poem":1},{"lineBreak":true},{"text":"Chaychöga chushyajcunallanami tiyanga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaycho tucu gueshwanta ruranga.","poem":1},{"lineBreak":true},{"text":"Chaycho wachar ogllar pashtarcachirnami pushapata jorgonga.","poem":1},{"lineBreak":true},{"text":"Chipshantaga shuntapayllapami gueshpichenga.","poem":1},{"lineBreak":true},{"text":"Chay partimanga tucuy casta ancacunapis chinan orgunmi shuntacanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Masqui Tayta Diospa librunta ricay. Masqui liguiy.","poem":1},{"lineBreak":true},{"text":"Chay animalcunapaj niycashäga llapanmi caycanga.","poem":1},{"lineBreak":true},{"text":"Manami mayganpapis chinancunaga pishengapächu.","poem":1},{"lineBreak":true},{"text":"Quiquin Tayta Diosmi chayno cananpaj camacächisha.","poem":1},{"lineBreak":true},{"text":"Paypa espiritunnami shuntarengapaj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Cada-ünuntami maycho goyänanpäpis camaripasha.","poem":1},{"lineBreak":true},{"text":"Quiquinmi ricachisha maycho tiyananpäpis.","poem":1},{"lineBreak":true},{"text":"Ricachishanchömi imaycamapis tiyaconga.","poem":1},{"lineBreak":true},{"text":"Imaycamapis chayllachömi tiyacongapaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}