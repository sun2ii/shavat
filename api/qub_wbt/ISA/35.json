":true},{"text":"Chay nänipaga salbacusha cajcunallami cutimonga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Dios salbar jorgamushan cajcunaga cutimongami.","poem":1},{"lineBreak":true},{"text":"Cantashpanmi Sionman yayconga.","poem":1},{"lineBreak":true},{"text":"Chaychöga imaypis cushishallami goyangapaj.","poem":1},{"lineBreak":true},{"text":"Paycunapäga cushicuywan alli goyayllanami cangapaj.","poem":1},{"lineBreak":true},{"text":"Llaquicuypis nanaypis manami canganachu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}