{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":40,"content":[{"type":"heading","content":["Jerusalén runacunata Tayta Dios shogashan"]},{"type":"verse","number":1,"content":[{"text":"Tayta Diosninchïmi nin:","poem":1},{"lineBreak":true},{"text":"«Acrashä Jerusalén runacunataga shogaycuy shogaycullay ari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Paycunataga alli shimillayquipa willapaycuy.","poem":1},{"lineBreak":true},{"text":"Cananpitaga manana llaquisha goyänanpaj cashanta willaycuy.","poem":1},{"lineBreak":true},{"text":"Paycunaga manami uywaynachu canga.","poem":1},{"lineBreak":true},{"text":"Paycunataga juchancunapita castigashcänami.","poem":1},{"lineBreak":true},{"text":"Paycunataga llapan juchanpita perdunashcänami.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Juc runami gayacuypa willacuycan cayno nir:","poem":1},{"lineBreak":true},{"text":"«Tayta Diosninchi shamunanpaj nänita allchay.","poem":1},{"lineBreak":true},{"text":"Diosninchi shamunanpaj chunyajpa nänita dirichay.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Llapan ragracunatapis pampayächiy.","poem":1},{"lineBreak":true},{"text":"Puytush lömacunatapis parijay.","poem":1},{"lineBreak":true},{"text":"Wicsu nänicunatapis dirichay.","poem":1},{"lineBreak":true},{"text":"Uchcu-uchcu nänicunatapis pampachay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chayrämi Tayta Diosga munayniyoj cayninta ricacächenga.","poem":1},{"lineBreak":true},{"text":"Chaytaga llapan runacunami ricangapaj.","poem":1},"Quiquin Tayta Diosmi chayno cananpaj nisha.»"]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Sinchipa gayacuy» nimashantami wiyashcä.","poem":1},{"lineBreak":true},{"text":"Chaura nogaga tapushcä: «¿Ima nirtaj gayacushaj?» nir.","poem":1},{"lineBreak":true},{"text":"Chaymi nimaran: «Gayacuy llapan runacuna llullu guewanölla caycashanta;","poem":1},{"lineBreak":true},{"text":"alli cawashanpis waytanölla caycashanta.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jananpa Tayta Diospa jämaynin päsariptenga","poem":1},{"lineBreak":true},{"text":"guewapis chaquicäcunmi, waytapis wañuytacäcunmi.","poem":1},{"lineBreak":true},{"text":"Runacunaga rasunpami guewanölla caycan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Guewapis chaquicäcunmi, waytapis wañuytacäcunmi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosninchi rimashancunami ichanga imaypis mana ushacanchu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sionman alli willapata apaj, altunnin puntaman wichay.","poem":1},{"lineBreak":true},{"text":"Chaypita intërupa willacushpayqui llapan callpayquipa gayaray.","poem":1},{"lineBreak":true},{"text":"Jerusalenman alli willapata apaj, mana manchacuypa sinchi gayaray.","poem":1},{"lineBreak":true},{"text":"Judá siudäcunacho tiyajcunata willapay","poem":1},{"lineBreak":true},{"text":"«¡Diosninchëga jananchichönami!» nir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Diosga fiyupa munayninwanmi chayamoj-aywan.","poem":1},{"lineBreak":true},{"text":"Munayniyoj carmi llapanta maquincho chararanga.","poem":1},{"lineBreak":true},{"text":"Juccunapa munaynincho caycajta shuntarcurmi","poem":1},{"lineBreak":true},{"text":"acrashan runacunataga pushaycämun.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Payga pushaycämun juc uyshëru uyshancunata michejnömi.","poem":1},{"lineBreak":true},{"text":"Uyshëruga uysha-mallwacunata margacurcurmi apan.","poem":1},{"lineBreak":true},{"text":"Cuyashpanmi margasha apan.","poem":1},{"lineBreak":true},{"text":"Chayraj wachashacunatapis allimi rican.","poem":1}]},{"type":"heading","content":["Tayta Dios fiyupa munayniyoj cashan"]},{"type":"verse","number":12,"content":[{"text":"¿Pitaj maqui paltanta ucrurcachillar lamar yacuta tupusha?","poem":1},{"lineBreak":true},{"text":"¿Pitaj imano jatun caynintapis syëluta cuartasha?","poem":1},{"lineBreak":true},{"text":"Cay pachacho caycaj llapan ñuchu allpata ¿pillaga juc tupuman tupushachuraj?","poem":1},{"lineBreak":true},{"text":"Puytush lömacuna, puntacuna ayca lasashantapis musyananpaj ¿pillaga pësashachuraj?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tayta Diostaga ¿piraj «manami chaynöchu» nisha?","poem":1},{"lineBreak":true},{"text":"U ¿piraj «caynömi ruranchi» nir yachachisha?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¿Piraj willapasha, sumaj tantiyachisha?","poem":1},{"lineBreak":true},{"text":"¿Piraj yachachisha alli jusgananpaj?","poem":1},{"lineBreak":true},{"text":"¿Piraj yachachisha llapanta musyaj tantiyaj cananpaj?","poem":1},{"lineBreak":true},{"text":"¿Piraj yachachisha sumaj yachaj cananpaj?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Diospäga nasyuncuna caycan jutuy yacunöllami.","poem":1},{"lineBreak":true},{"text":"Paypäga nasyuncuna caycan ichicnaylla allpa balansacho caycajnöllami.","poem":1},{"lineBreak":true},{"text":"Lamar chaupincho caycaj nasyuncunapis juc agushnöllami caycan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tayta Diospaj pishtarcur rupachinapäga intëru Libanucho caycaj uywacunapis manami aypanmanchu.","poem":1},{"lineBreak":true},{"text":"Ni Líbano munticho aypalla caycaj guerucunapis waycunapäga manami aypanmanchu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Paypa ñaupanchöga llapan nasyuncunapis manami imapischu.","poem":1},{"lineBreak":true},{"text":"Paypäga llapanpis manacajllami caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Gamcunaga ¿imamanraj Tayta Diosta tincuchinqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirajtataj ruranqui «diosnë» nishpayqui?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¿Ïdulutachuraj ruranqui?","poem":1},{"lineBreak":true},{"text":"Ïdulutaga tacay yachaj runallami ruran.","poem":1},{"lineBreak":true},{"text":"Guellay tacayta yachajmi goriwan chapyan.","poem":1},{"lineBreak":true},{"text":"Chayno guellaypita cadina wallgatapis jundiypa rurapan.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Pobriga ïduluta rurachinanpaj ashin puyu mana yachanan guerutami.","poem":1},{"lineBreak":true},{"text":"Nircorga ïduluta ruray yachaj runawan rurachin.","poem":1},{"lineBreak":true},{"text":"Chay runana ïduluta rurapan sumaj tacyajta.","poem":1},{"lineBreak":true},{"text":"Tayta Diosman ichanga ima ïdulupis mana tincunchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"¿Manachu gamcunaga musyarayqui?","poem":1},{"lineBreak":true},{"text":"¿Manachu parlajta wiyarayqui?","poem":1},{"lineBreak":true},{"text":"¿Manachu ñaupapita-pachana willapäshurayqui?","poem":1},{"lineBreak":true},{"text":"¿Manachu tantiyashcanqui cay pachata camashanpita-pachana?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tayta Diospaga jamanan caycan syëlupa jananchömi.","poem":1},{"lineBreak":true},{"text":"Runacunataga chuspitanöllami ricaycämanchi.","poem":1},{"lineBreak":true},{"text":"Paymi syëlutaga llantucunatanöpis mashtacächiran.","poem":1},{"lineBreak":true},{"text":"Toldu wasi lluylluraycajta runa ichichir mashtajnömi mashtaran.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Munayniyoj runacunatapis Paymi manacajmanno ticrachin.","poem":1},{"lineBreak":true},{"text":"Cay pachacho caj mandajcunatapis pasaypa ushacächin.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Paycunaga carcaycan lanta-mallwata chayraj lantaycushanömi,","poem":1},{"lineBreak":true},{"text":"chayraj allpaman sapichaycajnömi.","poem":1},{"lineBreak":true},{"text":"Paycunaman Dios pücarcamuptenga wañuytar chaquicäcunmi.","poem":1},{"lineBreak":true},{"text":"Ogshata löcu wayra apacushannöllami ushacäcunpis.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Santo Tayta Diosmi tapushunqui:","poem":1},{"lineBreak":true},{"text":"«Gamcunaga ¿imamanraj tincuchimanqui?","poem":1},{"lineBreak":true},{"text":"¿Piraj nogamanga tincunman?» nir.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Syëluman ñuquircushpayqui masqui ricchacuriy:","poem":1},{"lineBreak":true},{"text":"¿Pitaj llapan chaycunata rurasha?","poem":1},{"lineBreak":true},{"text":"Chaycunataga rurasha llapan estrëllacunata juc juclla camacächejmi,","poem":1},{"lineBreak":true},{"text":"llapantapis jutinpa-jutinpa rejsejmi.","poem":1},{"lineBreak":true},{"text":"Payga fiyupa munayniyojmi, fiyupa callpayojmi.","poem":1},{"lineBreak":true},{"text":"Rurashancunaga manami jucnayllapis pishinchu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Jacobpita miraj Israelcuna,","poem":1},{"lineBreak":true},{"text":"¿imanirtaj cayno ninqui:","poem":1},{"lineBreak":true},{"text":"«Tayta Diosga manami musyanchu imano goyaycashätapis.","poem":1},{"lineBreak":true},{"text":"Diostaga manami imapis gocunchu imano caycashäpis» nir?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ichanga gamcuna ¿manachu musyanqui?","poem":1},{"lineBreak":true},{"text":"¿Manachu wiyashcanqui?","poem":1},{"lineBreak":true},{"text":"Imaycamapis cawaj Tayta Dios mundu intëruta camäga","poem":1},{"lineBreak":true},{"text":"manami yamacanchu, manami uticanpischu.","poem":1},{"lineBreak":true},{"text":"Pay yarpashanga mana atipaypämi.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Paymi shacyächin yamacashana caycajcunata.","poem":1},{"lineBreak":true},{"text":"Callpaynaj caycajtapis callpayojyächin.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Mösucunapis uticar bëtanrämi.","poem":1},{"lineBreak":true},{"text":"Mas sinchi callpayojcunapis tacacar tuninrämi.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tayta Diosman yäracojcunami ichanga","poem":1},{"lineBreak":true},{"text":"alli callpallancho caycangapaj.","poem":1},{"lineBreak":true},{"text":"Chaymi anca buylaycajno aywangapaj.","poem":1},{"lineBreak":true},{"text":"Cörrirpis manami uticangapächu.","poem":1},{"lineBreak":true},{"text":"Caruta aywarpis manami bëtangapächu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}