{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":41,"content":[{"type":"heading","content":["Israelcunata Tayta Dios washashan"]},{"type":"verse","number":1,"content":["Tayta Diosmi cayno nin:",{"text":"«Lamar cantuncho caycaj nasyun runacuna upällalla wiyamay.","poem":1},{"lineBreak":true},{"text":"Intëru nasyuncho caycaj runacunapis sumaj balurchay.","poem":1},{"lineBreak":true},{"text":"Parlananchïpaj shamuy-llapa.","poem":1},{"lineBreak":true},{"text":"Tapunacunanchïpaj shuntacämuy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Llapanta binsircur alli llojshej raytaga","poem":1},{"lineBreak":true},{"text":"¿pitaj inti yagamunan caj-läpita yurichimusha?","poem":1},{"lineBreak":true},{"text":"Chay rayga waquin nasyunpa raynincunatapis maquinchömi chararaycan.","poem":1},{"lineBreak":true},{"text":"Paytaga maygan raycunapis manami ichipanchu.","poem":1},{"lineBreak":true},{"text":"Payga raycunata sablinwan ñuchu allpamannömi rurarin.","poem":1},{"lineBreak":true},{"text":"Lëchancunawanmi ogshatano wacpa-caypa machirin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Pitaj camacächisha chay ray mana manchacuypa gaticachänanpaj;","poem":1},{"lineBreak":true},{"text":"imaypis mana purishan nänipa aywananpaj?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Pitaj chaycunataga rurasha?","poem":1},{"lineBreak":true},{"text":"Gallarinanpita-pacha llapanpis chayno cananpäga ¿pitaj nisha?","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosllami chayno camacächishcä.","poem":1},{"lineBreak":true},{"text":"Nogallami gallarinanpita-pacha imaycamapis caycä.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lamarcho caycaj nasyuncunacho tiyaj runacuna chay raytaga ricashami.","poem":1},{"lineBreak":true},{"text":"Ricaycorga fiyupami mancharisha.","poem":1},{"lineBreak":true},{"text":"Allpapis juc cantupita juc cantucamarämi cuyurisha.","poem":1},{"lineBreak":true},{"text":"Chayamunanpäga manami aycäpis pishinnachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaymi fyërruta tacay yachajcunaga aroj-masinwan shacyächinacun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ïduluta ruräga guellay tacajta shacyächin.","poem":1},{"lineBreak":true},{"text":"Martilluwan tacajpis jirrëru yunquicho tacajta shacyächin.","poem":1},{"lineBreak":true},{"text":"Nircorga «¡Allimi camacächishcanqui!» nin.","poem":1},{"lineBreak":true},{"text":"Chayno rurariycur ïdulutaga mana cuyunanpaj läbuswan sumaj läbusyan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Tayta Diosga mastapis niran:",{"text":"«Jacobpita miraj Israelcuna, gamcunaga sirbimajnëmi carcaycanqui.","poem":1},{"lineBreak":true},{"text":"Gamcunataga nogami acracushcä.","poem":1},{"lineBreak":true},{"text":"Gamcunaga amïgö Abrahampita mirar-aywajmi carcaycanqui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"May carupitashi nogaga jorgamushcä.","poem":1},{"lineBreak":true},{"text":"May-chaychöpis caycajtami gamcunataga gayashcä.","poem":1},{"lineBreak":true},{"text":"Nircur ‹Gamcunaga sirbimajnëmi canqui› nirä.","poem":1},{"lineBreak":true},{"text":"Gamcunataga nogami acracushcä. Acrarcur manami jitarishcächu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ama manchacuychu. Nogaga gamcunawanmi caycä.","poem":1},{"lineBreak":true},{"text":"Ama manchacuychu. Nogaga Diosniquimi cä.","poem":1},{"lineBreak":true},{"text":"Nogami yanapar gamcunataga callpata gö.","poem":1},{"lineBreak":true},{"text":"Maquëcho charararmi gamcunataga alli goyächishayqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Chiquishojcunaga llapanmi pengaypaj manacajman churasha cangapaj.","poem":1},{"lineBreak":true},{"text":"Gamcunawan pillyaj cajcunaga ushajpämi illganga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Contrayqui cajcunataga ashirpis manami tarinquipänachu.","poem":1},{"lineBreak":true},{"text":"Gamcunawan guërrata ruraj cäga mana cashan-japuymi cangapaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Noga Tayta Diosniquimi gamcunataga maquipita chariraycä.","poem":1},{"lineBreak":true},{"text":"Chaymi gamcunataga nishcä: ‹Ama manchacuychu, nogami yanapaycä› nir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jacobpita mirar aywaj Israelcuna, curunölla cashpayquipis ama manchacuychu.","poem":1},{"lineBreak":true},{"text":"Nogami yanapäshayqui.","poem":1},{"lineBreak":true},{"text":"Nogami gamcunapa Santo Tayta Diosniqui caycä.","poem":1},{"lineBreak":true},{"text":"Nogami imapitapis jorgoj caycä.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gamcunataga mushoj alli quiruyoj rïguta ëracunamannömi ticrachishayqui.","poem":1},{"lineBreak":true},{"text":"Chayno alli quiruyoj carmi puntacunatapis yapyarinquipaj.","poem":1},{"lineBreak":true},{"text":"Contrayquicunatapis rïgupa päjantano muntuy-muntuy goturaycajtami cachaycunquipaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Paycunaga wayra apacuptin illgashannömi ushacangapaj.","poem":1},{"lineBreak":true},{"text":"Löcu wayra shamur wacpa-caypa machirishannömi illgangapaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami Tayta Dios yanapäshushayquipita fiyupa cushicunquipaj.","poem":1},{"lineBreak":true},{"text":"Santo Diosniquipäga fiyupa cushishami caycanquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Imanpis mana caj pobricunaga yacuta ashirpis manami tarinchu.","poem":1},{"lineBreak":true},{"text":"Yacunayllawan gallunpis chaquisha caycan.","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosmi ichanga yanapäshaj.","poem":1},{"lineBreak":true},{"text":"Israelcunapa Tayta Diosnenga manami cachaycushächu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yacu mana cashan jircacunachömi mayucunatapis yurichishaj.","poem":1},{"lineBreak":true},{"text":"Guechwa ragran quinranchöpis pucyucunatami pashtachimushaj.","poem":1},{"lineBreak":true},{"text":"Chunyaj chaqui jircacunatapis ishtanquimanmi ticrarachishaj.","poem":1},{"lineBreak":true},{"text":"Yacu mana cashan jircacunapami mayu-mallwacunata aywachishaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chunyaj chaqui jircachönami guerucunata wiñachimushaj:","poem":1},{"lineBreak":true},{"text":"sedruta, acaciata, rayanta, olivo yörata.","poem":1},{"lineBreak":true},{"text":"Chaqui jircacunachömi wiñachishaj pïnucunata, siprescunata","poem":1},{"lineBreak":true},{"text":"chaycunatawan iwal abeto yöracunatapis.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chaura intërucho tiyaj runacunami ricashpan tantiyaconga","poem":1},{"lineBreak":true},{"text":"Noga Tayta Dios munaynëwan chaycunata rurashäta,","poem":1},{"lineBreak":true},{"text":"gam Israelcunapa Santo Tayta Diosniqui chaycunata camashäta.»","poem":1}]},{"type":"heading","content":["Tayta Dioslla rasunpa Dios cashan"]},{"type":"verse","number":21,"content":[{"text":"Jacobpita mirajcunapa raynin Tayta Diosmi cayno nin:","poem":1},{"lineBreak":true},{"text":"«Mä ïdulucunata apamuy chapacur rimananpaj.","poem":1},{"lineBreak":true},{"text":"Mä ima rurayta camäpacushantapis nimächun.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ñaupa caj watacunacho imano ima cashantapis tantiyachimächun.","poem":1},{"lineBreak":true},{"text":"Shamoj watacunacho ima cananpaj cajtapis willamächun.","poem":1},{"lineBreak":true},{"text":"Chaura nogacunaga musyashänami imano cananpaj cashantapis.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mä willamächun chaypitaga imana cananpaj cashantapis.","poem":1},{"lineBreak":true},{"text":"Chauraga rasunpa dioscuna cashanta musyashämi.","poem":1},{"lineBreak":true},{"text":"Imallatapis mä rurachun allita mana allitapis","poem":1},{"lineBreak":true},{"text":"chay rurashancunata ricar almiranäpaj.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ichanga chay ‹diosnë› nishayquicuna manami ima ruraytapis camäpacunchu.","poem":1},{"lineBreak":true},{"text":"Chaycunaga manacajllami caycan.","poem":1},{"lineBreak":true},{"text":"Chay dioscunaman yäracojcunaga fiyupa melanaypämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«Inti yagamunan caj-lächömi juc runata yurichishcä.","poem":1},{"lineBreak":true},{"text":"Paytaga jutinpami gayashcä.","poem":1},{"lineBreak":true},{"text":"Payga norte caj-läpami chayamonga.","poem":1},{"lineBreak":true},{"text":"Mandajcunatapis mituta-jinami lluchcarenga.","poem":1},{"lineBreak":true},{"text":"Manca-ruraj mituta lluchcajnömi rurarenga.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"¿Pitaj chayno cananpäga unayna musyachisha?","poem":1},{"lineBreak":true},{"text":"¿Pitaj unaypita-pacha nisha","poem":1},{"lineBreak":true},{"text":"‹Au, rasunpami› ninanchïpaj?","poem":1},{"lineBreak":true},{"text":"Manami pipis wiyashachu ni juc shimillapis parlajta.","poem":1},{"lineBreak":true},{"text":"Manami ni mayganpis musyachishachu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nogami gallarinanpita-pachapis Sión runacunamanga willacachirä.","poem":1},{"lineBreak":true},{"text":"Nogami Jerusalenmanpis alli willapata willacoj cacharä.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ricachacushpä, manami ricächu maygan dioscunapis yurimojta.","poem":1},{"lineBreak":true},{"text":"Tantiyachej shamojpis manami pipis chayamunchu.","poem":1},{"lineBreak":true},{"text":"Tapushäcunata cutichimänanpaj manami pipis canchu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"¡Chay dioscunaga mayganpis manami imapischu!","poem":1},{"lineBreak":true},{"text":"Imata ruraytapis manami camäpacunchu.","poem":1},{"lineBreak":true},{"text":"Chaycunaga caycan runa rurashallan y mana-bälejcunallami.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}