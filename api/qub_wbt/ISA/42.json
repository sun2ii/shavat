{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":42,"content":[{"type":"heading","content":["Tayta Diosta sirbejpaj rimashan"]},{"type":"verse","number":1,"content":["Tayta Diosmi cayno nin:",{"text":"«Caychömi caycan sirbimajnë. Paytaga nogami yanapaycä.","poem":1},{"lineBreak":true},{"text":"Paytaga nogami acrashcä. Paypämi nogaga fiyupa cushicö.","poem":1},{"lineBreak":true},{"text":"Paymanmi espiritöta churashcä.","poem":1},{"lineBreak":true},{"text":"Chaymi llapan nasyuncunacho alli goyay cananpaj arriglanga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Payga manami gayacongachu, ni sinchipapis rimangachu.","poem":1},{"lineBreak":true},{"text":"Cällicunachöpis manami pipis wiyangachu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Llachquisha caycaj shogushtapis manami paquirengapächu.","poem":1},{"lineBreak":true},{"text":"Upinaycaj achquitapis manami upirachengachu.","poem":1},{"lineBreak":true},{"text":"Payga llapantapis allimi arriglanga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Payga manami jamayta tarengachu cay pachacho alli goyay cananpaj manaraj arriglashancama.","poem":1},{"lineBreak":true},{"text":"Lamar läduncho caj nasyun runacunapis pay yachachishanta wiyananpämi shuyaraycan.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Syëluta camarcur intërupa mashtacächejmi,","poem":1},{"lineBreak":true},{"text":"cay pachata camajmi,","poem":1},{"lineBreak":true},{"text":"cay pachacho ima ayca cajcunatapis camajmi,","poem":1},{"lineBreak":true},{"text":"runacunata cawachej, jämayta goj Tayta Diosmi sirbejninta cayno nin:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Noga Tayta Diosmi gamta gayashcä munashäta ruranayquipaj.","poem":1},{"lineBreak":true},{"text":"Maquipita charircurmi yanapashpä purichishayqui.","poem":1},{"lineBreak":true},{"text":"Nogami churashayqui señalno canayquipaj,","poem":1},{"lineBreak":true},{"text":"nasyuncunapäpis achquino canayquipaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Churashayqui gapracunata allchacächinayquipaj,","poem":1},{"lineBreak":true},{"text":"prësucunatapis carsilpita jorgunayquipaj,","poem":1},{"lineBreak":true},{"text":"chacajchöno caycajcunatapis achquimanno jorgunayquipaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nogaga cä Tayta Diosmi. Chaymi jutëpis caycan.","poem":1},{"lineBreak":true},{"text":"Chaymi camacächishaj nogallata aduramänanpaj.","poem":1},{"lineBreak":true},{"text":"Manami camacächishächu nogata alabamänanpa ruquin ïdulucunata alabanantapis.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Masqui yarpachacuy. Ñaupata willacachishäcunaga llapanmi cumlishana.","poem":1},{"lineBreak":true},{"text":"Cananga yapaymi juc willacuycunatana willacachishaj.","poem":1},{"lineBreak":true},{"text":"Gamcunataga musyaycächë manaraj imapis captinmi.»","poem":1}]},{"type":"heading","content":["Salbacoj cashanpita Tayta Diosta alabana"]},{"type":"verse","number":10,"content":[{"text":"Tayta Diostaga mushoj alabansawan alabay.","poem":1},{"lineBreak":true},{"text":"Cay munducho cajcunaga may carucho cashpayquipis alabay-llapa,","poem":1},{"lineBreak":true},{"text":"lamar jananpa büquiwan purejcunapis, lamarcho tiyaj animalcunapis,","poem":1},{"lineBreak":true},{"text":"lamar chaupin tishgucunacho caycaj nasyun runacunapis.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Cushicuchun chunyaj chaqui jircacunapis siudänincunapis,","poem":1},{"lineBreak":true},{"text":"Cedarpita miraj runacuna witichinalla wasincunacho tiyajcunapis.","poem":1},{"lineBreak":true},{"text":"Selacho tiyaj runacuna cushicuypita cantachun.","poem":1},{"lineBreak":true},{"text":"Altunnin puntacunacho cushicuywan gaparpächun.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tayta Diostaga alabay-llapa.","poem":1},{"lineBreak":true},{"text":"Lamar cantun nasyuncho tiyaj runacunapis paytaga alabay-llapa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tayta Diosga fiyupa callpasapa runanömi,","poem":1},{"lineBreak":true},{"text":"fiyupa jinyu runanömi pillyanga.","poem":1},{"lineBreak":true},{"text":"Guërracho pillyapaj gaparpashanno callpaycurmi gaparanga.","poem":1},{"lineBreak":true},{"text":"Contrancunataga llapantami binsenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tayta Diosmi cayno nin:","poem":1},{"lineBreak":true},{"text":"«Achca watami mana rimacushcächu.","poem":1},{"lineBreak":true},{"text":"Shongullächo yarparashcä, upällalla cacushcä.","poem":1},{"lineBreak":true},{"text":"Cananmi ichanga gueshyacoj warmi nanaywan gaparashanno gayarayparaj willacushaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Puntacunatapis puytush lömacunatapis ushacächishämi.","poem":1},{"lineBreak":true},{"text":"Chaycho wiñaj jachacunatapis ushajpämi chaquirachishaj.","poem":1},{"lineBreak":true},{"text":"Mayucunatapis chunyaj chaqui jircamanmi ticrarachishaj.","poem":1},{"lineBreak":true},{"text":"Gochacunatapis chaqui allpamanmi ticrarachishaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gapracuna aywashanpaga chacaytapis achicyajmanmi ticrarachishaj.","poem":1},{"lineBreak":true},{"text":"Jatun ragracunatapis pampamanna ticrarachishaj.","poem":1},{"lineBreak":true},{"text":"Paycunataga pushashäpaj mana rejsishan nänicunapami, quichqui nänicunapami.","poem":1},{"lineBreak":true},{"text":"Chaycunataga rasunpami rurashaj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaura ïdulucunaman yäracojcunaga,","poem":1},{"lineBreak":true},{"text":"runa rurashancunata adurajcunaga","poem":1},{"lineBreak":true},{"text":"fiyupa pengay-tucushami aywacongapaj.","poem":1}]},{"type":"heading","content":["Israelcuna mana tantiyacoj cashan"]},{"type":"verse","number":18,"content":[{"text":"«Mana wiyacoj upa runacuna, wiyay.","poem":1},{"lineBreak":true},{"text":"Gapracuna, sumaj ricay.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¿Pillaga sirbimajnëno mana ricaj canchuraj?","poem":1},{"lineBreak":true},{"text":"¿Pillaga willacojnëno mana wiyaj canchuraj?","poem":1},{"lineBreak":true},{"text":"¿Pillaga cachäno ñawin wichgasha canchuraj?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Paycunaga tucuytami ricasha.","poem":1},{"lineBreak":true},{"text":"Ichanga manami cuentata gocushachu.","poem":1},{"lineBreak":true},{"text":"Wiyaytaga wiyanmi.","poem":1},{"lineBreak":true},{"text":"Ichanga imata niycashätapis manami tantiyanchu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tayta Diosga fiyupa alli salbacoj Diosmi.","poem":1},{"lineBreak":true},{"text":"Chaymi munasha paypa yachachicuyninta llapan yachacunanta.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ichanga Tayta Dios acrashan runacunata suwaparcaycan, guechurcaycanmi.","poem":1},{"lineBreak":true},{"text":"Llapantami prësu charisha.","poem":1},{"lineBreak":true},{"text":"Calapösumanmi wichgaycusha.","poem":1},{"lineBreak":true},{"text":"Llapan ima-aycantapis guechurcaycan.","poem":1},{"lineBreak":true},{"text":"Paycunata washänanpäga manami pipis canchu.","poem":1},{"lineBreak":true},{"text":"Ima-aycanta guechuptinpis manami pipis canchu «cutichiy» ninanpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Chayno caycaptinpis gamcunaga manami tantiyacunquichu.","poem":1},{"lineBreak":true},{"text":"Imano cananpaj cashanta willashuptiquipis manami wiyacunquichu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"¿Pitaj camacächisha Jacobpita miraj Israelcuna tiyashanta","poem":1},{"lineBreak":true},{"text":"juccuna charicarcärinanpaj,","poem":1},{"lineBreak":true},{"text":"quiquincunatapis prësu apananpaj?","poem":1},{"lineBreak":true},{"text":"¿Manachu chaytaga Tayta Dios camacächisha?","poem":1},{"lineBreak":true},{"text":"Paycunaga juchatami ruraran.","poem":1},{"lineBreak":true},{"text":"Tayta Dios nishancunataga manami rurayta munaranchu.","poem":1},{"lineBreak":true},{"text":"Yachachishantapis manami wiyacuranchu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Chaypitami Tayta Diosga paycunapaj rabyacurcuran.","poem":1},{"lineBreak":true},{"text":"Nircorga guërracho fiyupa ñacachishpan castigasha.","poem":1},{"lineBreak":true},{"text":"Chay runacunataga rabyashpanmi Tayta Dios ninanöpis ushariran.","poem":1},{"lineBreak":true},{"text":"Chayno ruraycaptinpis paycunaga manami wiyacuranchu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}