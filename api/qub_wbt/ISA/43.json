{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":43,"content":[{"type":"heading","content":["Tayta Dioslla salbacoj cashan"]},{"type":"verse","number":1,"content":[{"text":"Cananmi ichanga Jacobpita mirar aywaj Israelcuna,","poem":1},{"lineBreak":true},{"text":"camashoj Tayta Diosniqui cayno nishunqui:","poem":1},{"lineBreak":true},{"text":"«Ama manchacuychu. Nogami gamtaga salbashcä.","poem":1},{"lineBreak":true},{"text":"Jutiquipami gayashcä. Nogapanami canqui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mayucunata chimpaptiquipis nogaga gamcunawanmi caycäshäpaj.","poem":1},{"lineBreak":true},{"text":"Mayu yacupis manami apashunquipächu manami shenganquipächu.","poem":1},{"lineBreak":true},{"text":"Nina chaupinpa päsaptiquipis manami rupashunquipächu.","poem":1},{"lineBreak":true},{"text":"Gamcunachöga ninapis manami ratangapächu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nogami cä gamcunapa Tayta Diosniqui, salbashojniqui.","poem":1},{"lineBreak":true},{"text":"Gam Israelcunapa Santo Diosniquimi caycä.","poem":1},{"lineBreak":true},{"text":"Gamcunata jorgamunäpäga ruquiqui churashcä","poem":1},{"lineBreak":true},{"text":"Egiptutami, Etiopiatami, Sabätami.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nogaga gamcunata charänäpaj y mana wañunayquipämi","poem":1},{"lineBreak":true},{"text":"juc nasyuncunata ruquiqui churashcä.","poem":1},{"lineBreak":true},{"text":"Chayno rurashcä gamcunata cuyashpämi.","poem":1},{"lineBreak":true},{"text":"Gamcunaga ima-aycapitapis masmi bälinqui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ama manchacuychu. Nogaga gamcunawanmi caycä.","poem":1},{"lineBreak":true},{"text":"Cay pachacho inti yagamunan caj-läpitami gamcunapita mirajcunataga cutichimushaj.","poem":1},{"lineBreak":true},{"text":"Cay pachacho inti yaganan caj-läpitapis gamcunapita mirajcunataga shuntamushämi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Norte caj-lä nasyun runacunatapis ‹Cutichimuy› nishämi.","poem":1},{"lineBreak":true},{"text":"Sur caj-lä nasyun runacunatapis nishaj: ‹Wamräcunataga ama charicurcuychu.›","poem":1},{"lineBreak":true},{"text":"Paycunataga ollguta warmitapis may carupita carpis cutichimushaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nogata rispitamaj cajtaga","poem":1},{"lineBreak":true},{"text":"Noga rurashä cajtaga","poem":1},{"lineBreak":true},{"text":"Nogata aduramaj cajtaga llapanta cutichimushaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Acrashä runacunataga apamuy ari.","poem":1},{"lineBreak":true},{"text":"Paycunaga ñawiyoj caycarpis gapranömi carcaycan.","poem":1},{"lineBreak":true},{"text":"Rinriyoj caycarpis mana wiyajnömi carcaycan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Llapan nasyun runacuna shuntacay.","poem":1},{"lineBreak":true},{"text":"Llapan marca runacuna shuntacay.","poem":1},{"lineBreak":true},{"text":"Chaycho caycajcuna ¿mayganraj rimir-puntata rimaran acrashä runacunata yanapänäpaj cashanta?","poem":1},{"lineBreak":true},{"text":"Chayno cananpaj rimasha cashpanga mä testïgucunata pushamuchun.","poem":1},{"lineBreak":true},{"text":"Mä chay testïgucuna nichun paycuna willacushanta.","poem":1},{"lineBreak":true},{"text":"Wiyaj cäga llapanpis ‹¡Au, rasunpa nishannömi casha!› nengami.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tayta Diosga caynömi nin:","poem":1},{"lineBreak":true},{"text":"«Nogata sirbimaj runacuna gamcunami testïgö canqui.","poem":1},{"lineBreak":true},{"text":"Gamcunataga acrashcä rejsimänayquipämi, nogaman yäracamunayquipämi,","poem":1},{"lineBreak":true},{"text":"pï cashätapis tantiyacur musyanayquipämi.","poem":1},{"lineBreak":true},{"text":"Imaypitapis nogallami Diosga cä.","poem":1},{"lineBreak":true},{"text":"Nogapita mas juc diosga manami cangapischu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nogallami Tayta Diosga cä.","poem":1},{"lineBreak":true},{"text":"Nogallami salbacöga cä.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nogaga salbanäpaj cashantami willacachirä.","poem":1},{"lineBreak":true},{"text":"Nircorga willacachishänöllami salbashcä.","poem":1},{"lineBreak":true},{"text":"Manami juc runacuna ‹diosnë› nishanchu salbashurayqui.","poem":1},{"lineBreak":true},{"text":"Noga salbashätaga gamcuna musyarcaycanquimi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Imaypitapis nogallami Diosga cä.","poem":1},{"lineBreak":true},{"text":"Nogapa maquëpitaga manami pipis gueshpinchu.","poem":1},{"lineBreak":true},{"text":"Noga ruraptëga manami pipis chapata ruranmanchu.»","poem":1}]},{"type":"heading","content":["Israelcunata Tayta Dios alliman churananpaj cashan"]},{"type":"verse","number":14,"content":[{"text":"Israelcunata salbaj Santo Tayta Diosmi nin:","poem":1},{"lineBreak":true},{"text":"«Gamcunata salbanäpäga runacunatami Babiloniaman cachashaj.","poem":1},{"lineBreak":true},{"text":"Paycunami llapan runacunata binsir gaticachanga.","poem":1},{"lineBreak":true},{"text":"Caldea runacunatapis alli-tucur büquincunacho caycajta gaticachanga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nogami Santo Tayta Diosniqui cä.","poem":1},{"lineBreak":true},{"text":"Nogami Israel nasyunta camacächishcä.","poem":1},{"lineBreak":true},{"text":"Nogami rayniqui cä.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Lamar chaupinpami nogaga juc nänita rurarirä.","poem":1},{"lineBreak":true},{"text":"Wac-läman cay-läman yacu cuyuycaj chaupinpami cällitano rurarirä.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Conträcunaga aypalla munayniyoj suldärucunawanmi gatimaran.","poem":1},{"lineBreak":true},{"text":"Llapanta usharinanpaj carrëtancunawan, cawalluncunawanmi shamuran.","poem":1},{"lineBreak":true},{"text":"Chay gaticachämajcunataga llapantami tunichishcä. Chaypitaga mananami jatarishanachu.","poem":1},{"lineBreak":true},{"text":"Achqui rataycashanpita upicäcojtanöpis illajpitami illgächishcä.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Cananga acrashä runacunata noga në:","poem":1},{"lineBreak":true},{"text":"Ñaupa cajcunallapäga ama yarparaychu.","poem":1},{"lineBreak":true},{"text":"Ni unay cashancunallapäpis ama yarparaychu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Cananga mushojtanami ruraj-aywä.","poem":1},{"lineBreak":true},{"text":"Chayga yurimojnami-aywan. ¿Manachu cuentata gocunqui?","poem":1},{"lineBreak":true},{"text":"Chunyaj chaqui jircapami juc nänita rurashaj.","poem":1},{"lineBreak":true},{"text":"Imapis mana wayushan chaqui jircachömi mayuta yurichishaj.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chauraga jirca-allgucunapis, avestruz äbicunapis agradësicamangami.","poem":1},{"lineBreak":true},{"text":"Nogaga chaqui jircachömi yacuta pashtachimö.","poem":1},{"lineBreak":true},{"text":"Chaqui jircachömi mayuta yurichimö.","poem":1},{"lineBreak":true},{"text":"Chayno yurichimö acrashä runacuna upunanpämi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chay runacunataga quiquëpämi rurarä.","poem":1},{"lineBreak":true},{"text":"Paycunataga alabamänanpämi rurarä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Chaypis gamcunaga Jacobpita mirar aywaj Israelcuna manami alabamashcanquichu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga yamacämashcanquimi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nogapaj uyshacunata rupachinayquipaj manami apamushcanquichu.","poem":1},{"lineBreak":true},{"text":"Rispitamashpayqui manami uywacunata garamashcanquichu.","poem":1},{"lineBreak":true},{"text":"Nogaga manami ‹chaqui micuy ofrendacunata garamay› nir yamacächishcächu.","poem":1},{"lineBreak":true},{"text":"Manami ‹insinsuta saumachiy› nir rabyachishcächu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nogapaj ofrendata apapämänayquipaj manami alli asyajcunata rantishcanquichu.","poem":1},{"lineBreak":true},{"text":"Pishtashayqui uywacunapa wirantapis cushicachimänayquipaj manami garamashcanquichu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga juchata rurashpayquimi yamacächimashcanqui.","poem":1},{"lineBreak":true},{"text":"Tucuy melanaypajcunata rurashpayquimi fiyupa rabyachimashcanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«Chaypis nogaga Diosniqui cashpämi conträ rurashayquicunata gongaycöna.","poem":1},{"lineBreak":true},{"text":"Jucha rurashayquicunatapis manami yarpäshänachu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"¿Imallaga canchuraj gamcuna allita rurashayqui?","poem":1},{"lineBreak":true},{"text":"Mä tapunacushun.","poem":1},{"lineBreak":true},{"text":"Mä juchaynajchush caycanqui.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Unay rimir-punta caj awiluyquipis juchatami ruraran.","poem":1},{"lineBreak":true},{"text":"Yachachishojniquicunapis conträmi ricacuran.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mandashojniquicunapis Templöta ganrachisha.","poem":1},{"lineBreak":true},{"text":"Chaynöpami camacächishcä Jacobpita mirar-aywaj Israelcunata ushacächinanpaj, manacajman churananpaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}