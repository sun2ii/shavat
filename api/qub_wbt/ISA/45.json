{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":45,"content":[{"type":"heading","content":["Ray Ciropaj Tayta Dios willacachishan"]},{"type":"verse","number":1,"content":[{"text":"Cirotaga Tayta Diosmi acrasha ray cananpaj.","poem":1},{"lineBreak":true},{"text":"Maquipita charicurcurmi yanapasha llapan nasyuncunata mandananpaj,","poem":1},{"lineBreak":true},{"text":"munayniyoj raycunatana ushananpaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi camacächisha may siudä runacunatapis Ciro binsinanpaj.","poem":1},{"lineBreak":true},{"text":"Cananga Tayta Diosmi payta nin:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Gampa ñaupayquita nogami aywashaj.","poem":1},{"lineBreak":true},{"text":"Altu jircacunatanami pampachargärishaj.","poem":1},{"lineBreak":true},{"text":"Runsi puncucunatapis paquirgärishämi.","poem":1},{"lineBreak":true},{"text":"Fyërrupita caj rancancunatapis ichic-ichicllami rurargärishaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nogami goycushayquipaj pacaraycaj fiyupa cuestajcunata.","poem":1},{"lineBreak":true},{"text":"Pipis mana tarinan pachacho pacaraycaj riquësacunatami goycushayqui.","poem":1},{"lineBreak":true},{"text":"Chaymi musyanquipaj noga Tayta Dios cashäta,","poem":1},{"lineBreak":true},{"text":"Israelcuna rispitar adurashan Dios gamta jutiquipa gayashäta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sirbimaj Jacobpita miraj Israelcunata yarpärishpämi","poem":1},{"lineBreak":true},{"text":"gamtaga jutiquipa gayashcä.","poem":1},{"lineBreak":true},{"text":"Nircorga manapis rejsiycämaptiquimi","poem":1},{"lineBreak":true},{"text":"canan rispitädu caycashayquino canayquipaj churashcä.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nogami Tayta Dios cä.","poem":1},{"lineBreak":true},{"text":"Nogapita mas juc diosga manami canchu.","poem":1},{"lineBreak":true},{"text":"Manapis rejsiycämaptiquimi","poem":1},{"lineBreak":true},{"text":"gamtaga yanapäshayqui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaynöpami inti yagamunan caj-pita inti yaganan cajcama tiyajcuna musyanga","poem":1},{"lineBreak":true},{"text":"Nogapita mas jucga dios mana cashanta.","poem":1},{"lineBreak":true},{"text":"Nogallami cä Tayta Dios. Manami mas jucga canchu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nogami camacächë junaj cananpaj, chacay cananpäpis.","poem":1},{"lineBreak":true},{"text":"Nogami camacächë alli goyay cananpaj, disigrasya chayananpäpis.","poem":1},{"lineBreak":true},{"text":"Llapan chaycunataga noga Tayta Diosmi camacächë.","poem":1}]},{"type":"heading","content":["Tayta Dios fiyupa munayniyoj cashan"]},{"type":"verse","number":8,"content":[{"text":"«Chauraga syëlu quichacäcuptin bindisyunta mashtamushaj.","poem":1},{"lineBreak":true},{"text":"Chaycunaga cangapaj shullay shicwamojno, pucutaypita tamyamojnömi.","poem":1},{"lineBreak":true},{"text":"Chaycunata allpachöga cushishami chasquenga.","poem":1},{"lineBreak":true},{"text":"Chaynöpami salbacoj cashäga imapis wayojno achcaman miranga.","poem":1},{"lineBreak":true},{"text":"Chaynönami alli cajllata ruraypis waytajno canga.","poem":1},{"lineBreak":true},{"text":"Chaycunataga noga Tayta Diosmi camacächë.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Ay imanöraj canga rurajninwan churacäga.","poem":1},{"lineBreak":true},{"text":"Allpa-mancaga waquin allpa mancanöllami caycan.","poem":1},{"lineBreak":true},{"text":"Chayno caycarga ruraj runawan manami rimanacunchu.","poem":1},{"lineBreak":true},{"text":"Manca rurajta mituga manami ninchu:","poem":1},{"lineBreak":true},{"text":"‹¿Imanirtaj cay-nirajta ruraycämanqui?› nir.","poem":1},{"lineBreak":true},{"text":"U ¿ninmanchuraj ‹Mana allitami ruramashcanqui› nir?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wamrapis maman-taytanta manami ninmanchu","poem":1},{"lineBreak":true},{"text":"‹¿imapätaj ruramarayqui?› nir.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Israelcunata ruraj Santo Tayta Diosmi cayno nin:","poem":1},{"lineBreak":true},{"text":"«Wamräcunata imano rurashäpitapis gamcuna ¿tapumanquichuraj?","poem":1},{"lineBreak":true},{"text":"Ruraynëcunata imano ruranäpäpis ¿yachachimanquichuraj?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nogami camashcä allpata, chaycho tiyajcunatapis.","poem":1},{"lineBreak":true},{"text":"Syëlutapis maquëwanmi mashtashcä.","poem":1},{"lineBreak":true},{"text":"Syëlucho estrëllacuna yurinanpäpis nogami nishcä.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nogami ray Cirotapis llapanta binsinanpaj yurichishcä.","poem":1},{"lineBreak":true},{"text":"Nircorga llapan rurashancunapis alli llojshinanpaj camacächishaj.","poem":1},{"lineBreak":true},{"text":"Paymi siudänëta allchachenga.","poem":1},{"lineBreak":true},{"text":"Sirbimajcuna prësu apashancunatapis cuticamunanpaj cachayconga.","poem":1},{"lineBreak":true},{"text":"Chayno cachaycunanpäga päguta ni imatapis manami chasquengachu.»","poem":1},"Munayniyoj Tayta Diosmi chayno nisha."]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Israelcunata Tayta Diosga caynömi nin:","poem":1},{"lineBreak":true},{"text":"«Egipto runacunapis, Etiopía runacunapis, jatusaj Sabá runacunapis maquiquichömi canga.","poem":1},{"lineBreak":true},{"text":"Chay runacunapis, murushan micuynincunapis, nigusyuncunapis gamcunapanami canga.","poem":1},{"lineBreak":true},{"text":"Paycunaga cadinawan watashami guepayquita shamongapaj.","poem":1},{"lineBreak":true},{"text":"Gamcunapa ñaupayquiman gongurpacuycurmi ruwacushunquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga ruranga ‹Rasunpa gamcunachömi Diosga caycan.","poem":1},{"lineBreak":true},{"text":"Paypita mas jucga manami dios canchu› nirmi.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Israelcunata salbaj Tayta Dios gamga runa mana tantiyayta atipashancunatami,","poem":1},{"lineBreak":true},{"text":"almiraypajcunatami ruranqui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ïduluta rurajcunaga llapanmi","poem":1},{"lineBreak":true},{"text":"ricacongapaj fiyupa pengaycho, manacajman churasha.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Israeltami ichanga Tayta Dios salbanga.","poem":1},{"lineBreak":true},{"text":"Para-simrinami salbanga.","poem":1},{"lineBreak":true},{"text":"Paycunaga manami imaypis pengaycho, ni manacajman churashapis cangapächu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tayta Diosmi syëluta camäga.","poem":1},{"lineBreak":true},{"text":"Paymi cay pachatapis camasha.","poem":1},{"lineBreak":true},{"text":"Paymi sumaj tacyachisha.","poem":1},{"lineBreak":true},{"text":"Payga camasha manami chunyaj cananpächu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga camasha chaycho cawajcuna tiyananpämi.","poem":1},{"lineBreak":true},{"text":"Llapan chaycunata camacächej Tayta Diosmi cayno nin:","poem":1},{"lineBreak":true},{"text":"«Nogallami Tayta Diosga cä.","poem":1},{"lineBreak":true},{"text":"Manami mas juc dios canchu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Noga manami pacayllapaga parlächu.","poem":1},{"lineBreak":true},{"text":"Ni chacaj pachacunachöpis manami parlächu.","poem":1},{"lineBreak":true},{"text":"Jacobpita mirajcunata nogaga manami nishcächu:","poem":1},{"lineBreak":true},{"text":"‹Imapis mana cashancunacho ashimay› nir.","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosga rasun cajllatami parlä.","poem":1},{"lineBreak":true},{"text":"Alli cajllatami musyachë.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Juc nasyun runacunaga mana tantiyashpanmi guerupita rurasha ïduluncunata matancasha purichin.","poem":1},{"lineBreak":true},{"text":"Mana salbananpaj caycaptinpis ‹diosnë› nir mañacun.","poem":1},{"lineBreak":true},{"text":"Paycunatami në: Cawaycar quëdaj cajcunaga shuntacarcushpayqui shamuy-llapa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mä rimacuy. Imata yarpashayquitapis nimay.","poem":1},{"lineBreak":true},{"text":"Jucniqui-jucniquipis tapunacur parlacuy:","poem":1},{"lineBreak":true},{"text":"¿Pitaj gallarinallanchöna niran cayno cananpäga?","poem":1},{"lineBreak":true},{"text":"¿Pitaj unayna willacachiran?","poem":1},{"lineBreak":true},{"text":"¿Manachu noga Tayta Dios chaycunataga willarä?","poem":1},{"lineBreak":true},{"text":"Nogapita mas juc diosga manami canchu.","poem":1},{"lineBreak":true},{"text":"Nogapita mas jucga manami canchu allita ruraj, imapitapis salbäga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«May caru allpapa cuchuncho cajpis","poem":1},{"lineBreak":true},{"text":"Nogaman shamuptiquega salbashayquimi.","poem":1},{"lineBreak":true},{"text":"Nogallami Diosga cä. Nogapita mas juc diosga manami canchu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nogaga jutëchömi jurashcä.","poem":1},{"lineBreak":true},{"text":"Alli cajta ruranäpämi jurarä.","poem":1},{"lineBreak":true},{"text":"Chayno nishäga cumlicangami.","poem":1},{"lineBreak":true},{"text":"Nogata rispitamashpan llapanmi gongurpacamongapaj.","poem":1},{"lineBreak":true},{"text":"Pï-may runacunapis nogapa jutëchömi juranga.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Chaura chay runacunana nenga: ‹Tayta Diosman yäracuptillanchïmi","poem":1},{"lineBreak":true},{"text":"alli llojshipämanchi, munayniyojpis canchi› nir.","poem":1},{"lineBreak":true},{"text":"Llapanmi chiquimajcunaga fiyupa pengaycho ricaconga.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Noga yanapaynëpami Israelcunaga alliman chayanga.","poem":1},{"lineBreak":true},{"text":"Chaymi yanapashäpita cushiconga.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}