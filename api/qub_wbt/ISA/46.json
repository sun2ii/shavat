{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":46,"content":[{"type":"heading","content":["Babiloniapa manacaj diosnincunapaj rimashan"]},{"type":"verse","number":1,"content":[{"text":"Bel diosga uysucäcunmi.","poem":1},{"lineBreak":true},{"text":"Nebo diospis tunicunmi.","poem":1},{"lineBreak":true},{"text":"Chay dios-niraj ïdulucunataga uywacunaman cargacurcur-rämi apan.","poem":1},{"lineBreak":true},{"text":"Chaycunaga fiyupa lasarmi uywacunata uticächin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chay diosnincunaga uysucäcunmi, tunicäcunmi.","poem":1},{"lineBreak":true},{"text":"Chay dioscunataga juc-lä nasyunmanmi apacun.","poem":1},{"lineBreak":true},{"text":"Manami quiquincunapis salbacunchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tayta Dios cayno nin: «Jacobpita mirar aywaj Israelcuna cawarcaycäga wiyamay.","poem":1},{"lineBreak":true},{"text":"Gamcunataga manaräpis yurishayquipita-pachami purichishcä.","poem":1},{"lineBreak":true},{"text":"Nogami margasha purichishcä.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Auquinyaptiquicunapis nogaga chaynöllami caycäshäpaj.","poem":1},{"lineBreak":true},{"text":"Pasaypa soguna caycaptiquipis chaynöllami yanapaycäshayquipaj.","poem":1},{"lineBreak":true},{"text":"Gamcunataga nogami rurashcä.","poem":1},{"lineBreak":true},{"text":"Chaymi gamcunataga maquëcho charar ricaycäshayquipaj.","poem":1},{"lineBreak":true},{"text":"Nogami yanapashpä imapitapis salbashayquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Gamcunaga ¿imamanraj tincuchimanqui?","poem":1},{"lineBreak":true},{"text":"¿Piraj nogamanga tincunman?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waquin runacunaga churacunanpita achca gorita jorgun.","poem":1},{"lineBreak":true},{"text":"Guellaytapis balansacho pësan.","poem":1},{"lineBreak":true},{"text":"Nircorga imanirajtapis ïduluta rurayta yachajwan parlan ‹diosnëta rurapämay› nir.","poem":1},{"lineBreak":true},{"text":"Ruraparcuptenga chaypa ñaupanman gongurpacun, aduran.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rurapashantaga matancacarcärirmi apan.","poem":1},{"lineBreak":true},{"text":"Nircorga jamaränanman churaycun.","poem":1},{"lineBreak":true},{"text":"Chaychöga mana cuyucuypami cacun.","poem":1},{"lineBreak":true},{"text":"Yanapänanpaj may-jina gayacuptinpis manami imachöpis yanapanchu.","poem":1},{"lineBreak":true},{"text":"Ñacananpaj caycar fiyupa llaquicuycaptinpis manami pitapis salbanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Chaycunapaj yarpachacuy-llapa.","poem":1},{"lineBreak":true},{"text":"Conträ caycajcuna sumaj yarpachacuy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Unaypita-pacha imano päsashantapis yarpay.","poem":1},{"lineBreak":true},{"text":"Nogallami Diosga cä. Manami mas juc Dios canchu.","poem":1},{"lineBreak":true},{"text":"Nogaman tincöga manami juc dios canchu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nogami gallarinanpita-pacha willacachë imano cananpaj cashantapis.","poem":1},{"lineBreak":true},{"text":"Shamoj watacunacho ima cananpaj cajtapis achca wata pishiycaptillannami willacachë.","poem":1},{"lineBreak":true},{"text":"Ruranäpaj yarpaycashäcunaga rasunpa llapanmi cumlenga.","poem":1},{"lineBreak":true},{"text":"Rurayta munashä cajtaga llapantami rurashaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Inti yagamunan caj-läpitami juc runata gayashcä.","poem":1},{"lineBreak":true},{"text":"Aycha micoj äbinöpis carupitami shamonga.","poem":1},{"lineBreak":true},{"text":"Ruranäpaj yarpaycashäcunata paymi rurangapaj.","poem":1},{"lineBreak":true},{"text":"Imano ruranäpäpis yarpashcänami. Chaytaga cumlishämi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wiyamay rumi shongu runacuna.","poem":1},{"lineBreak":true},{"text":"Gamcunaga manami salbasharächu caycanqui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nogami camacächishaj salbanäpaj caycäga juclla chayamunanpaj.","poem":1},{"lineBreak":true},{"text":"Salbanäpäga manami aycäpis pishinnachu.","poem":1},{"lineBreak":true},{"text":"Sión runacunataga nogami salbashaj.","poem":1},{"lineBreak":true},{"text":"Quiquëmi Israelchöpis caycäshaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}