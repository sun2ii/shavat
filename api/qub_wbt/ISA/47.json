{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":47,"content":[{"type":"heading","content":["Babilonia ushacänanpaj cashan"]},{"type":"verse","number":1,"content":["Tayta Diosmi cayno nin:",{"lineBreak":true},{"text":"«Caldeacho caycaj Babilonia jipash allicho jamaraycashayquipita llojshiy.","poem":1},{"lineBreak":true},{"text":"Allpamanna jamacuy.","poem":1},{"lineBreak":true},{"text":"Japalla jipash sillunniquipita jatariy.","poem":1},{"lineBreak":true},{"text":"Pampamanna jamacuy.","poem":1},{"lineBreak":true},{"text":"Mananami pipis ‹pishi töpay cuyayllapaj jipash› nishunquipänachu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maraycho tunaywanna machcata agay.","poem":1},{"lineBreak":true},{"text":"Shucutaraycashayqui bëluyquitapis jorguriyna.","poem":1},{"lineBreak":true},{"text":"Mayucunata päsanayquipaj falinniquita chegllayquicama jogariy.","poem":1},{"lineBreak":true},{"text":"Chaynöpa chancayquicunapis alayri ricacanga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Galalla caycajtami pï-maypis ricashunquipaj.","poem":1},{"lineBreak":true},{"text":"Pengayniquitapis ricachun ari.","poem":1},{"lineBreak":true},{"text":"Chaynömi sumaj castigashayqui.","poem":1},{"lineBreak":true},{"text":"Chay castïgupitaga manami pipis gueshpengachu.»","poem":1}]},{"type":"verse","number":4,"content":["Israelcunapa munayniyoj Santo Tayta Diosnin ima-aycapitapis salbacojmi cayno nin:"]},{"type":"verse","number":5,"content":[{"text":"«Caldeacho caycaj Babilonia jipash upällalla jamacuy.","poem":1},{"lineBreak":true},{"text":"Mananami pipis ‹nasyuncunapa mandajnin rayna› nishunquipänachu.","poem":1},{"lineBreak":true},{"text":"Chacajmanna aywacuy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Acrashä runacunapämi rabyacurcurä.","poem":1},{"lineBreak":true},{"text":"Chaymi cuyashä nasyun runacunataga pengayman churarä.","poem":1},{"lineBreak":true},{"text":"Chaynöpami gam Babiloniapa maquiquiman cachaycurä.","poem":1},{"lineBreak":true},{"text":"Chaura paycunataga manami cuyapashcanquichu.","poem":1},{"lineBreak":true},{"text":"Auquincunatapis fiyupa lasaj yüguta matancapajnömi ñacachishcanqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"‹Imaycamapis raynallami cashaj› nirayqui.","poem":1},{"lineBreak":true},{"text":"Ichanga noga ruranäpaj cashanta manami yarpashcanquichu.","poem":1},{"lineBreak":true},{"text":"Imano ushacänayquipaj cashantapis manami musyashcanquichu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Chaypita cananga wiyay Babilonia.","poem":1},{"lineBreak":true},{"text":"Fiyupa cuyayllapajcunallata cuyaj warmimi cashcanqui.","poem":1},{"lineBreak":true},{"text":"Mana yarpachacuypami mandanayqui sillunniquicho jamaraycanqui.","poem":1},{"lineBreak":true},{"text":"Shongullayquicho niycanqui:","poem":1},{"lineBreak":true},{"text":"‹Manami pipis noganöga canchu.","poem":1},{"lineBreak":true},{"text":"Nogaga manami biyüdapis quëdashächu.","poem":1},{"lineBreak":true},{"text":"Manami wawaynajpis quëdashächu› nir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ichanga illajpita juc junajllami disigrasyacuna chayashunquipaj:","poem":1},{"lineBreak":true},{"text":"Wawaynajmi, biyüdami quëdanquipaj.","poem":1},{"lineBreak":true},{"text":"Chay-jina brüju ruraj cashayquipis,","poem":1},{"lineBreak":true},{"text":"majiquëru cashayquipis manami salbashunquipächu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mana allicunata rurashpayquipis manami imatapis gocushcanquichu.","poem":1},{"lineBreak":true},{"text":"‹Pipis manami ricamanchu› nirmi yarparayqui.","poem":1},{"lineBreak":true},{"text":"Quiquiqui musyaj-yachaj cayniquimi engañashurayqui.","poem":1},{"lineBreak":true},{"text":"Shongullayquicho yarpashpayqui nirayqui:","poem":1},{"lineBreak":true},{"text":"‹Manami pipis noganöga canchu› nir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gammanga fiyupa disigrasyami chayamoj-aywan.","poem":1},{"lineBreak":true},{"text":"Chay disigrasya imay cananpaj cashantapis manami musyanquipächu.","poem":1},{"lineBreak":true},{"text":"Fiyupa mana alli chayashunayquipaj cajpitaga manami imanöpapis gueshpinquipächu.","poem":1},{"lineBreak":true},{"text":"Mana yarpashayqui fiyupa mana allicunami illajpita chayashunquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Brüju rurayta yachashayquita mä sïguir ruracuycay ari.","poem":1},{"lineBreak":true},{"text":"Chaytaga yachacurayqui wamra-jipash cashayquipita-pachami.","poem":1},{"lineBreak":true},{"text":"Chaycuna mä imallapäga allichush canga.","poem":1},{"lineBreak":true},{"text":"Chaycunata ruraptiqui mä runacuna manchacushunquichush.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Willapäshojcunaga aypallami casha.","poem":1},{"lineBreak":true},{"text":"Asta yamacänayquicamami casha.","poem":1},{"lineBreak":true},{"text":"¡Cananga mä shamuchun ari goyllarta estudyajniquicuna,","poem":1},{"lineBreak":true},{"text":"cada quilla imano cananpaj cajtapis willashojcuna!","poem":1},{"lineBreak":true},{"text":"¡Nircur paycuna mä salbayta camashunqui ari!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Masqui ricay, chay musyaj yachajcunaga chaqui ogshanömi carcaycan.","poem":1},{"lineBreak":true},{"text":"Ninaga ushajpämi rupacurconga.","poem":1},{"lineBreak":true},{"text":"Chay ninapitaga manami imanöpapis salbacongachu.","poem":1},{"lineBreak":true},{"text":"Chay ninaga manami ñaupanman jamaycur mashacunapaj shanshanöchu canga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaynömi ushacanga brüjuyquicunaga.","poem":1},{"lineBreak":true},{"text":"Wamra cashayquipita-pachami paycunawanga parlacurayqui.","poem":1},{"lineBreak":true},{"text":"Cada-ünunmi quiquin munashanno llutancunata rurasha.","poem":1},{"lineBreak":true},{"text":"Salbashunayquipäga manami pipis cangapächu.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}