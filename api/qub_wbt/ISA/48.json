{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":48,"content":[{"type":"heading","content":["Israelcuna mana wiyacoj cashan"]},{"type":"verse","number":1,"content":[{"text":"Jacobpita miraj cashpayqui Israel jutita aparajcuna wiyay.","poem":1},{"lineBreak":true},{"text":"Judá trïbu runacuna wiyay.","poem":1},{"lineBreak":true},{"text":"Gamcunaga juranquipis Tayta Diospa jutinchömi.","poem":1},{"lineBreak":true},{"text":"Israelpa Diosnintami mañacunquipis.","poem":1},{"lineBreak":true},{"text":"Ichanga janan shongullami Tayta Diosta rispitaj-tucunqui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gamcunaga «rispitädu siudäpitami cä» nircaycanqui.","poem":1},{"lineBreak":true},{"text":"Chayno nishpayquimi Israelpa Diosninman yäracunqui.","poem":1},{"lineBreak":true},{"text":"Paypa jutenga munayniyoj Tayta Diosmi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paymi cayno nin: «Unay imano cashantapis manaraj päsaptinmi willacachirä.","poem":1},{"lineBreak":true},{"text":"Quiquëmi musyachirä.","poem":1},{"lineBreak":true},{"text":"Illajpitami rurarä. Chauraga willacachishänöllami rasunpa llapanpis caran.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nogaga musyarämi rumi shongu cashayquita,","poem":1},{"lineBreak":true},{"text":"cuncayquipis fyërruno chucru cashanta,","poem":1},{"lineBreak":true},{"text":"urcuyquipis runsino cashanta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaymi manaraj imapis päsaptin unaypita-pachana willachirä.","poem":1},{"lineBreak":true},{"text":"Chayno willachirä ‹Ïdulömi chayta rurasha› nimänayquipitami,","poem":1},{"lineBreak":true},{"text":"‹Tacaypa rurachishämi chaytaga camacächisha› nimänayquipitami.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaycunataga llapantami wiyashcanqui, ricashcanqui.","poem":1},{"lineBreak":true},{"text":"Chauraga ¿manachu willacunquiman ‹au rasunpami chayno casha› nir?","poem":1},{"lineBreak":true},{"text":"«Cananga willapäshayqui mushoj willapacunatanami,","poem":1},{"lineBreak":true},{"text":"manaraj musyashayquicunatami.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Canan ruranäpaj caycajcunatami musyachishayqui,","poem":1},{"lineBreak":true},{"text":"manami unay cashancunatachu.","poem":1},{"lineBreak":true},{"text":"Chaycunapäga canancama manami wiyashcanquirächu.","poem":1},{"lineBreak":true},{"text":"Chaynöpami mana ninquipächu: ‹Maynami chaytaga musyaräna› nir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaycunapaj parlajta gamcunaga manami wiyarayquichu.","poem":1},{"lineBreak":true},{"text":"Cananyajpis manami musyashcanquipischu.","poem":1},{"lineBreak":true},{"text":"Rinriqui mana quichacajno mana wiyajmi cashcanqui.","poem":1},{"lineBreak":true},{"text":"Nogaga musyarämi mana wiyacoj cashpayqui juccunata adurashayquita.","poem":1},{"lineBreak":true},{"text":"Musyarämi yurishayquipita-pacha ‹mana wiyacoj› nishushayquitapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Rispitasha canä-raycumi rabyashpäpis awantacurä.","poem":1},{"lineBreak":true},{"text":"Nogapaj allita parlanan-cashami pasinsacur gamcunataga mana illgächirächu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gamcunataga nogami jurnuchöno limyuyächirä.","poem":1},{"lineBreak":true},{"text":"Ichanga manami guellayta chulluchiypa limyuyächejnöchu rurarä.","poem":1},{"lineBreak":true},{"text":"Ñacayman churashpämi imano cashayquitapis musyaparä.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nogaga rispitamänayquipämi chayno rurashcä.","poem":1},{"lineBreak":true},{"text":"¿Imanöpataj munäman manacajman churamänayquitaga?","poem":1},{"lineBreak":true},{"text":"Nogata rispitamänayquipa ruquin jucta rispitanayquitaga manami camacächishächu.","poem":1}]},{"type":"heading","content":["Acrashancunata Tayta Dios salbananpaj cashan"]},{"type":"verse","number":12,"content":[{"text":"«Jacobpita mirar-aywaj gayashä Israelcuna wiyamay:","poem":1},{"lineBreak":true},{"text":"Noga japallämi cä Diosga.","poem":1},{"lineBreak":true},{"text":"Nogallami gallarinanpita-pacha ushanancamapis caycä.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Maquëwanmi allpata sumaj camacächishcä.","poem":1},{"lineBreak":true},{"text":"Maquëwanmi syëluta mashtacächirä.","poem":1},{"lineBreak":true},{"text":"Jutinta rimarcuptëmi chaycunaga llapanpis ruracäcuran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Llapayqui shuntacaycushpayqui sumaj wiyamay:","poem":1},{"lineBreak":true},{"text":"¿Pitaj gamcunachöga willacuran cayno cananpaj cashanta?","poem":1},{"lineBreak":true},{"text":"Acrashä ray Ciromi Babiloniataga yarpashäno ruranga.","poem":1},{"lineBreak":true},{"text":"Paymi chay Caldeacho caycaj Babilonia runacunataga munaynincho chararanga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nogami payta nishcä chayno rurananpaj. Nogami paytaga gayashcä.","poem":1},{"lineBreak":true},{"text":"Nogami paytaga gayashcä aywamunanpaj.","poem":1},{"lineBreak":true},{"text":"Payga maypa aywashpanpis allichömi llojshenga.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Witimuy-llapa nishäta wiyanayquipaj.","poem":1},{"lineBreak":true},{"text":"Gallarinanpita-pachapis nogaga manami imaypis pacayllapaga parlashcächu.","poem":1},{"lineBreak":true},{"text":"Ima captinpis nogaga chaychömi caycarä.»","poem":1},"Cananga Tayta Diosmi espiritunta nogaman churarcur cachamasha."]},{"type":"verse","number":17,"content":["Gam Israelcunapa Santo Tayta Diosniquimi, salbashojniquimi cayno nin:",{"text":"«Nogami cä Tayta Diosniqui.","poem":1},{"lineBreak":true},{"text":"Nogami yachachë gamcunapaj alli cajta.","poem":1},{"lineBreak":true},{"text":"Nogami pushaycä munashä nänipa aywanayquipaj.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Mandamintöcunata wiyacuptiqui allimi canman caran!","poem":1},{"lineBreak":true},{"text":"Chaura jauca goyashayquega mayu mana chaquiypa aywajnömi canman caran.","poem":1},{"lineBreak":true},{"text":"Alli rurashayquipis canman caran lamarpa pullchajyaynin gatinayllanpa aywajnömi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gampita mirajcunapis aypallami canman caran.","poem":1},{"lineBreak":true},{"text":"Lamar cantuncho agushno yupaytapis mana atipaypärämi canman caran.","poem":1},{"lineBreak":true},{"text":"Nogaga manami imaypis gamcunata ushacächëmanchu caran.","poem":1},{"lineBreak":true},{"text":"Ñaupäpitapis manami gargömanchu caran.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Caldeacho caycaj Babiloniapita llojshicuy-llapa.","poem":1},{"lineBreak":true},{"text":"Gueshpir aywacuy-llapa.","poem":1},{"lineBreak":true},{"text":"Llojshicunanpaj caj willapataga fiyupa cushicur gayacuyparaj willacuy.","poem":1},{"lineBreak":true},{"text":"Intëruman musyachiy.","poem":1},{"lineBreak":true},{"text":"Cayno willacuy «¡Tayta Diosga salbashami","poem":1},{"lineBreak":true},{"text":"sirbejnin Jacobpita mirajcunata!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chunyaj chaqui jircacunapa pushaptinpis","poem":1},{"lineBreak":true},{"text":"manami yacunaranchu.","poem":1},{"lineBreak":true},{"text":"Gagatapis paymi shillirachiran.","poem":1},{"lineBreak":true},{"text":"Nircorga chaypitana aypalla yacuta llojshichimuran» nir.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ichanga Tayta Dios nin:","poem":1},{"lineBreak":true},{"text":"«Fiyucunapäga alli goyaypis manami canchu» nir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}