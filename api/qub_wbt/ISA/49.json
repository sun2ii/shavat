{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":49,"content":[{"type":"heading","content":["Tayta Diosta sirbej rimashan"]},{"type":"verse","number":1,"content":[{"text":"Lamar cantuncho caycaj nasyun runacuna wiyamay.","poem":1},{"lineBreak":true},{"text":"Caru nasyun runacuna nishäta sumaj tantiyacuy:","poem":1},{"lineBreak":true},{"text":"Manaräpis yuriptillänami Tayta Diosga gayamaran.","poem":1},{"lineBreak":true},{"text":"Mamäpa pachallanchöraj caycaptillänami nogapa jutëta rimaran.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rimashäcuna fiyupa afilasha sablino cananpämi camacächisha.","poem":1},{"lineBreak":true},{"text":"Maquinwanmi ima-aycapitapis chapamasha.","poem":1},{"lineBreak":true},{"text":"Fiyupa llauchi lëchamannömi ticrachimasha.","poem":1},{"lineBreak":true},{"text":"Nircorga lëchata purichicunanmanmi wiñamasha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paymi nimaran: «Israel, gamga sirbimajnëmi canqui.","poem":1},{"lineBreak":true},{"text":"Gampitami nogaga alabasha cashaj.»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ichanga noga yarparä: «Yangallapämi arushcäpis.","poem":1},{"lineBreak":true},{"text":"Manacajllachömi callpätapis ushashcä.","poem":1},{"lineBreak":true},{"text":"Chayno carpis Tayta Diospa maquinchömi caycä.","poem":1},{"lineBreak":true},{"text":"Arushäpita imano cutichimänanpäpis Tayta Diospa munayninchömi caycan» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tayta Diosga mamäpa pachancho caycaptillänami","poem":1},{"lineBreak":true},{"text":"pay munashanta willacoj canäpaj churamaran.","poem":1},{"lineBreak":true},{"text":"Jacobpita miraj Israel nasyun runacunata shuntamunäpämi, cutichimunäpämi churamaran.","poem":1},{"lineBreak":true},{"text":"Chaypitami Tayta Diosnëga alli ricamasha.","poem":1},{"lineBreak":true},{"text":"Paymi nogataga yanapaycäman.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paymi nimasha: «Manami sirbimajnë cashallayquiwanchu usharanga.","poem":1},{"lineBreak":true},{"text":"Manami Jacobpita miraj cawaycar quëdaj Israelcunata cutichishallayquiwanchu usharanga.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga nogami camacächishaj nasyuncunapaj juc achquino canayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami camacächishaj mundu intërucho caycaj runacunaga gam-raycu salbasha cananpaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Israelcunapa Salbacoj Santo Tayta Diosninmi sirbejninta nin:","poem":1},{"lineBreak":true},{"text":"«Gamga juc nasyun runacunapita chiquishami, manacajman churashami cashcanqui.","poem":1},{"lineBreak":true},{"text":"Fiyu mandajcunapa uywayninmi cashcanqui.","poem":1},{"lineBreak":true},{"text":"Cananpitami ichanga raycunapis waquin mandajcunapis ñaupayquiman gongurpaconga.","poem":1},{"lineBreak":true},{"text":"Chaynöga canga Israelcunapa Santo Tayta Diosniqui gamta acrasha captëmi,","poem":1},{"lineBreak":true},{"text":"aunishäta cumlej captëmi.»","poem":1}]},{"type":"heading","content":["Jerusalén imano cananpäpis willacushan"]},{"type":"verse","number":8,"content":[{"text":"Tayta Diosga caynömi nin:","poem":1},{"lineBreak":true},{"text":"«Ruwacamashayqui örami wiyashcä.","poem":1},{"lineBreak":true},{"text":"Yanapänäta nistashayqui örami yanaparä.","poem":1},{"lineBreak":true},{"text":"Nogami chapäshayqui.","poem":1},{"lineBreak":true},{"text":"Israelcunawan conträtu rurashä señal canayquipämi churashayqui.","poem":1},{"lineBreak":true},{"text":"Chaynöpami nasyun yapay allina canga.","poem":1},{"lineBreak":true},{"text":"Pasaypa pirdichisha caycaj chacracunachöpis yapayna tiyanga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Prësucunatapis ‹Llojshicuy› ninquipaj.","poem":1},{"lineBreak":true},{"text":"Chacaycho caycajcunatapis ‹Achicyajmanna llojshiy› ninquipaj.","poem":1},{"lineBreak":true},{"text":"Chaura chay runacunaga tiyangapaj may nänipa ñaupanchöpis, may chaqui jircachöpis uywa alli guewata micojnömi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chauraga yargaypis ni yacunaypis manami canganachu.","poem":1},{"lineBreak":true},{"text":"Intipis, ni acaypis manami ñacachengapächu.","poem":1},{"lineBreak":true},{"text":"Chaynöga canga paycunata noga cuyaptëmi, pusharaptëmi.","poem":1},{"lineBreak":true},{"text":"Chuya yacu pashtajcunamanmi pushashaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jircacunapapis juc nänitami rurarishaj.","poem":1},{"lineBreak":true},{"text":"Nänicunapis parijashami canga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Masqui ricäriy! May carupitashi aywarcaycämun:","poem":1},{"lineBreak":true},{"text":"Waquenga norte caj-läpita, waquenga inti yaganan cajpita.","poem":1},{"lineBreak":true},{"text":"Waquinnami aywarcaycämun Asuán partipita.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"¡Syëlu, cushicuypita gaparay!","poem":1},{"lineBreak":true},{"text":"Tayta Diosga acrashan runacunata shogashami.","poem":1},{"lineBreak":true},{"text":"¡Allpa, fiyupa cushicuy!","poem":1},{"lineBreak":true},{"text":"Acrashan runacuna llaquicuycaptin Tayta Diosga cuyapashami.","poem":1},{"lineBreak":true},{"text":"¡Jircacuna, cushisha caycashayqui musyacänanpaj gaparpay!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sión runacunaga nej:","poem":1},{"lineBreak":true},{"text":"«Tayta Diosga cachaycamashcanchïmi.","poem":1},{"lineBreak":true},{"text":"Diosnëga manami yarpämannachu» nir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Diosmi ichanga nin: «¿Juc warmi gongaycunmanchuraj wamranta,","poem":1},{"lineBreak":true},{"text":"quiquinpa wamran caycaptin mananachuraj cuyanman?","poem":1},{"lineBreak":true},{"text":"Wamranta juc warmi gongaycuptinpis","poem":1},{"lineBreak":true},{"text":"Nogaga manami gongashayquichu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nogaga maquëchömi jutiquitapis isquirbiraycächë.","poem":1},{"lineBreak":true},{"text":"Siudäniquipa pergancunatapis ricaycämi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Siudäniquita allchajcunaga apurämi aywarcaycämun.","poem":1},{"lineBreak":true},{"text":"Ushashojcunawan ushajpaj wañuchishojcunami ichanga aywacurcaycanna.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Masqui sumaj intërupa ricachacuy.","poem":1},{"lineBreak":true},{"text":"Ricay, imanöshi Israelcunaga shuntacarcaycan.","poem":1},{"lineBreak":true},{"text":"Nircorga gammanna cuticaycämun.","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosmi jurar cayno në:","poem":1},{"lineBreak":true},{"text":"Paycunaga llapanpis cangapaj cuestaj aläjacunata churacushayquinömi,","poem":1},{"lineBreak":true},{"text":"casarananpaj jipash cuyayllapaj adurnucunata jaticushannömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Aypalla runacuna cutimuptin nasyunniqui pasaypa quichquimi ricaconga.","poem":1},{"lineBreak":true},{"text":"Ragällan cajcunamanpis, pasaypa chunyaj cajcunamanpis runacuna juntangami.","poem":1},{"lineBreak":true},{"text":"Ushashojcunaga carupanami aywaconga.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"‹Illgashanami› nishayqui wamrayquicunami rinrillayquicho nishunquipaj:","poem":1},{"lineBreak":true},{"text":"‹Cay nasyonga nogacuna tiyanäpaj fiyupa quichquinami.","poem":1},{"lineBreak":true},{"text":"Juc partita ashipämay ari tiyanäcunapaj› nir.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chaura gamga yarpaynillayquicho ninquipaj:","poem":1},{"lineBreak":true},{"text":"‹Nogapaga wamräcuna manami cashachu.","poem":1},{"lineBreak":true},{"text":"Ni wawa tariytapis manami yachashcächu.","poem":1},{"lineBreak":true},{"text":"Chauraga ¿maypitataj cay wamräcuna yurimusha?","poem":1},{"lineBreak":true},{"text":"Nogaga jitarisha, shuyni quiquillämi tiyashcä.","poem":1},{"lineBreak":true},{"text":"¿Pitaj uywasha paycunataga?","poem":1},{"lineBreak":true},{"text":"Japallätami cachaycamaran.","poem":1},{"lineBreak":true},{"text":"Paycunaga ¿maypitataj shamusha?› nir.»","poem":1}]},{"type":"verse","number":22,"content":["Tayta Diosmi cayno nin:",{"text":"«Nasyuncunacho tiyajcunatami nishaj ollgu wamrayquicunata margacurcur apamunanpaj.","poem":1},{"lineBreak":true},{"text":"Marcacunatami señalwan musyachishaj warmi wamrayquicunatapis aparisha apamunanpaj.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Raycunami wamrachacushunquipaj.","poem":1},{"lineBreak":true},{"text":"Raypa jipash wamrancunanami uywashunquipaj.","poem":1},{"lineBreak":true},{"text":"Paycunaga rispitashushpayquimi gongurpaconga.","poem":1},{"lineBreak":true},{"text":"Chaquiquiman ñuchu allpa lagacajtapis lajwangami.","poem":1},{"lineBreak":true},{"text":"Chaymi musyanquipaj noga Tayta Dios cashäta.","poem":1},{"lineBreak":true},{"text":"Musyanquipaj nogaman yäracamoj cäga mana pengaycho ricacushanta.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Callpasapa runa guërracho imatapis quiquinpaj guechucushanta juc runa ¿guechunmanchuraj?","poem":1},{"lineBreak":true},{"text":"Guërracho binsiycur fiyu runa prësu apaycashantapis juc runa ¿guechunmanchuraj?","poem":1}]},{"type":"verse","number":25,"content":["Tayta Diosmi ichanga cayno nin:",{"text":"«Callpayoj runata guechongami quiquinpaj imatapis apacuycashanta.","poem":1},{"lineBreak":true},{"text":"Binsej fiyu runatapis guechongami quiquinpaj charishanta.","poem":1},{"lineBreak":true},{"text":"Achäquita ashipäshojcunawanga nogami musyanacushaj.","poem":1},{"lineBreak":true},{"text":"Wamrayquicunataga quiquëmi salbashaj.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ñacachishojcunataga quiquin-pura micunacunanpämi camacächishaj.","poem":1},{"lineBreak":true},{"text":"Machananpaj bïnuta upushannömi quiquincunapa yawarnintapis uponga.","poem":1},{"lineBreak":true},{"text":"Chaynöpami llapan runacuna musyangapaj","poem":1},{"lineBreak":true},{"text":"Noga Tayta Dios salbashojniqui cashäta,","poem":1},{"lineBreak":true},{"text":"Jacobpa munayniyoj Diosnin gamcunata chapaj cashäta.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}