{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":5,"content":[{"type":"heading","content":["Übas chacraman Judäta tincuchishan"]},{"type":"verse","number":1,"content":["Amïgöpa jutinchömi cantashaj. Chay cantanaga übaspämi riman.",{"text":"Amïgöpami caran übas chacran","poem":1},{"lineBreak":true},{"text":"micuy alli wayunan alli chacracho.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chacrata ojtir allpata sumaj tacuchiran.","poem":1},{"lineBreak":true},{"text":"Rumincunatapis acrarcur-acrarcur jitariran.","poem":1},{"lineBreak":true},{"text":"Chaymanna lantaran alli ñawiyoj übas sapicunata.","poem":1},{"lineBreak":true},{"text":"Übas chacra chaupinchönami täpar ricchacuna törrita aruran.","poem":1},{"lineBreak":true},{"text":"Übasta bïnupaj gapchinanpäpis juc pösuta camariran.","poem":1},{"lineBreak":true},{"text":"Amïgöga yarparan übasnin mishquejta wayunantami.","poem":1},{"lineBreak":true},{"text":"Nishan chay übasga pochgojtami wayusha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Chacrapa duyñunnami nin:","poem":1},{"lineBreak":true},{"text":"«Jerusalén runacuna Judá runacuna canan mä nimay.","poem":1},{"lineBreak":true},{"text":"¿Mayganëtaj mana allita rurashcä?","poem":1},{"lineBreak":true},{"text":"¿Übasnëchu? ¿Nogachu?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Imanötaj mas ruräman caran übas lantäta?","poem":1},{"lineBreak":true},{"text":"Mas ¿imallaraj pishishapis chayman wiñanäpaj?","poem":1},{"lineBreak":true},{"text":"Nogaga yarparä mishquejta übas wayunantami.","poem":1},{"lineBreak":true},{"text":"Chaura ¿imanir-raj pochgojtaga wayusha?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cananmi ichanga übas wertäta imano ruranäpaj caycashantapis willashayqui:","poem":1},{"lineBreak":true},{"text":"Guenchashäcunatami ushajpaj jorgurishaj illgächinanpaj.","poem":1},{"lineBreak":true},{"text":"Perga curalaraycajtami juchurgärachishaj pï-maypis lluchcacunanpaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chunyajtami cachaycushaj.","poem":1},{"lineBreak":true},{"text":"Manami pipis captupangachu, ni uryangapischu.","poem":1},{"lineBreak":true},{"text":"Shatallanami, cashallanami juntacurcongapaj.","poem":1},{"lineBreak":true},{"text":"Pucutaycunatapis nishaj","poem":1},{"lineBreak":true},{"text":"chay pachamanga manana aywananpaj, mana tamyananpaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Chacrapa duyñonga munayniyoj Tayta Diosmi.","poem":1},{"lineBreak":true},{"text":"Lantashan übasga caycan Israel nasyun runacunami, Judá runacunami.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga munaran layninta chay runacuna cumlinantami.","poem":1},{"lineBreak":true},{"text":"Nishanga wañuchinacuyllatami aruycan.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga niran allillata rurananpämi.","poem":1},{"lineBreak":true},{"text":"Nishanga ñacajcuna gaparpashallanmi wiyacaycan.","poem":1}]},{"type":"heading","content":["Fiyu runacunapaj nishan"]},{"type":"verse","number":8,"content":[{"text":"Ay imanöraj canqui juc-lächo juc-lächo wasicunata rantiycajcuna,","poem":1},{"lineBreak":true},{"text":"chacracunatapis masta-masta shuntaycajcuna.","poem":1},{"lineBreak":true},{"text":"Chayno rurarmi juccunapäga imatapis mana cachaycunquinachu.","poem":1},{"lineBreak":true},{"text":"Nircorga tiyacaycärinqui chay nasyuncho gamcunalla caycajnöpis.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Dios nimasha:","poem":1},{"lineBreak":true},{"text":"«Aypalla wasicunami illgächisha canga.","poem":1},{"lineBreak":true},{"text":"May-jina jatuncaray ni cuyayllapaj captinpis","poem":1},{"lineBreak":true},{"text":"manami pipis tiyangapänachu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Quimsa ictarya übaspita","poem":1},{"lineBreak":true},{"text":"bïnu llojshengapaj juc tacsha urpullawanmi.","poem":1},{"lineBreak":true},{"text":"Chunca custal rïgu muruta mururpis","poem":1},{"lineBreak":true},{"text":"poguptin shuntangapaj juc custal-llatanami.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ay imanöraj canqui upyallapaj yarparaycar warämojcuna,","poem":1},{"lineBreak":true},{"text":"machashalla chacarpärejcuna.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gamcuna fistata rurashayquichöga arpa, guitärra, tamburcuna, pincullucuna wagashallanmi wiyacaycanpis.","poem":1},{"lineBreak":true},{"text":"Chay fista rurashayquichöga bïnupis aypallanpami ushacan.","poem":1},{"lineBreak":true},{"text":"Ichanga manami yarpachacunquicunachu Tayta Dios ruraycashanpäga.","poem":1},{"lineBreak":true},{"text":"Manami tantiyacunquipischu Tayta Dios camaricuycashantaga.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chayno cashanpitami Dios acrashan runacunaga prësu aywanga.","poem":1},{"lineBreak":true},{"text":"Llapanmi mandajnintin yargaypita, yacunaypita wañonga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fistacunallacho goyajcunata y llutancunata parlar cawacojcunataga","poem":1},{"lineBreak":true},{"text":"micucoj animalnömi chay runacunata y mandajnincunatapis","poem":1},{"lineBreak":true},{"text":"llapanta ultacurcunanpaj sepultüra shuyaraycan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chayrämi runacunaga fiyupa pengay-tucusha ricaconga.","poem":1},{"lineBreak":true},{"text":"Alli-tucojcunapis uysurpangami.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Diosmi nishanta cumlishpan musyachenga munayniyoj cashanta.","poem":1},{"lineBreak":true},{"text":"Santo Tayta Dios alli arriglashpanmi musyachenga rispitädu cashanta.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Llapan siudäcunami juchusha quëdanga.","poem":1},{"lineBreak":true},{"text":"Chay siudäcuna cashanchönami uyshacunata cabracunata michiconga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ay imanöraj canqui llullacuypa mana allita apaycämojcuna,","poem":1},{"lineBreak":true},{"text":"jucha rurayta garchaycämojcuna.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gamcunaga nircaycanqui:","poem":1},{"lineBreak":true},{"text":"«Ricananchïpaj Diosga juclla rurachun rurananpaj cajcunata.","poem":1},{"lineBreak":true},{"text":"Musyananchïpaj Israelcunapa Santo Diosnenga","poem":1},{"lineBreak":true},{"text":"juclla rurachun rurananpaj yarpaycashancunata» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ay imanöraj canqui mana alli cajta «alli» nejcuna,","poem":1},{"lineBreak":true},{"text":"alli cajtana «mana alli» nejcuna,","poem":1},{"lineBreak":true},{"text":"achicyajta «chacay» nejcuna,","poem":1},{"lineBreak":true},{"text":"chacaytana «achicyaj» nejcuna;","poem":1},{"lineBreak":true},{"text":"ashgaj cajta «mishquej» nejcuna,","poem":1},{"lineBreak":true},{"text":"mishquej cajtana «ashgaj» nejcuna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ay imanöraj canqui quiquillayquipäga tantiyaj yachaj carcaycajcuna,","poem":1},{"lineBreak":true},{"text":"quiquillayquipäga fiyupa yarpaysapa carcaycajcuna.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ay imanöraj canqui waran-waran upyallar cacojcuna,","poem":1},{"lineBreak":true},{"text":"machächicojcunata rurayllapaj callpayojcuna.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gamcunaga guellay-raycumi juchayojtapis «juchaynaj» ninqui.","poem":1},{"lineBreak":true},{"text":"Juchaynajtana alli arriglanayquipa ruquin «juchayojmi» ninqui.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Chaypitami nina ogshata rupacurcushanno,","poem":1},{"lineBreak":true},{"text":"chaqui öjacunatapis ushacurcushanno","poem":1},{"lineBreak":true},{"text":"gamcunapis ushacanquipaj.","poem":1},{"lineBreak":true},{"text":"Sapinpita ismoj lantacunanömi,","poem":1},{"lineBreak":true},{"text":"ismuptin waytancuna allpaman ticrashannömi ticranquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga canquipaj munayniyoj Tayta Dios yachachishushayquita mana wiyacushayquipitami,","poem":1},{"lineBreak":true},{"text":"Santo Tayta Diospa layninta mana cäsushayquipitami.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Chaypitami Tayta Diosga acrashan runacunapaj fiyupa rabyacurcusha.","poem":1},{"lineBreak":true},{"text":"Nircur castigasha.","poem":1},{"lineBreak":true},{"text":"Puntacunapis chucchusharämi.","poem":1},{"lineBreak":true},{"text":"Wañojcunanami cällicunacho jitaräcuran ganra jitarajno.","poem":1},{"lineBreak":true},{"text":"Chayno castigarcurpis Tayta Diosga rabyashanpita manami allchacanrächu.","poem":1},{"lineBreak":true},{"text":"Payga jinallarämi castigananpaj yarparaycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Tayta Diosga caru nasyuncunacho tiyajcunatami bandërawan sëñaypa gayanga.","poem":1},{"lineBreak":true},{"text":"Allpapa juc cuchuncho tiyaycajtami wichyacushpan gayanga.","poem":1},{"lineBreak":true},{"text":"Chay nasyun runacunaga jinan öra shamushpan rätumi chayaramonga.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Chay runacunachöga manami canchu callpaynajpis ni uticashapis.","poem":1},{"lineBreak":true},{"text":"Llapanpis caycan mana puñunajllami.","poem":1},{"lineBreak":true},{"text":"Paycunapaga manami mayganpapis wachcun japshi wataranchu.","poem":1},{"lineBreak":true},{"text":"Manami llangui watunpis rachishaga canchu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Lëchancunapis auja-puntami caycan.","poem":1},{"lineBreak":true},{"text":"Lëchata jitacunanpis sumaj chutashami caycan.","poem":1},{"lineBreak":true},{"text":"Cawalluncunapa shilluncunapis rumino chucrumi.","poem":1},{"lineBreak":true},{"text":"Carrëtancunapa ruyrancunapis shucucuy wayra gachwarejnörämi tumarin.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Shamoj runacuna gaparashanpis wiyacaycan liyuncuna gaparashanno,","poem":1},{"lineBreak":true},{"text":"gaparar micunanpaj cäsata charejno,","poem":1},{"lineBreak":true},{"text":"pipis guechuyta mana puydiptin micunanpaj apacojnömi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Chayamushpan chay runacunaga","poem":1},{"lineBreak":true},{"text":"Israelcunaman yaycunanpaj gaparpangapaj lamar yacunörämi.","poem":1},{"lineBreak":true},{"text":"Chay runacuna aywaycämushan caj-läpa ricärerga","poem":1},{"lineBreak":true},{"text":"ricangapaj fiyupa chacashatarämi.","poem":1},{"lineBreak":true},{"text":"Chacasha captinmi junaj cashanpis mana musyacangachu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}