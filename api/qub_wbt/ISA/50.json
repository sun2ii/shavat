{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":50,"content":[{"type":"heading","content":["Mana wiyacojcunata Tayta Dios castigananpaj cashan"]},{"type":"verse","number":1,"content":["Tayta Diosmi cayno nin:",{"lineBreak":true},{"text":"«¡Gamcunaga capas yarpanqui juc runa warminwan raquicajno Israelta cachaycushäta!","poem":1},{"lineBreak":true},{"text":"Chauraga ¿maytaj raquicashä papil?","poem":1},{"lineBreak":true},{"text":"¡Capas yarpanqui pipapis jagan cashpä","poem":1},{"lineBreak":true},{"text":"gamcuna uyway canayquipaj ranticuycushäta!","poem":1},{"lineBreak":true},{"text":"Chauraga ¿maytaj jaga cashä papil?","poem":1},{"lineBreak":true},{"text":"Chaypa ruquin gamcunaga juchayquipitami ranticusha cashcanqui.","poem":1},{"lineBreak":true},{"text":"Gamcuna mana wiyacoj cashayquipitami mamayqui Israelga jitaricasha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Imanirtaj noga shamushpäga pitapis mana tariränachu?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj, gayacuptëga pipis mana wiyamashachu?","poem":1},{"lineBreak":true},{"text":"¿Manachu riguiran jorgunäpaj cashanta?","poem":1},{"lineBreak":true},{"text":"¿Manachu riguiran salbanäpaj cashanta?","poem":1},{"lineBreak":true},{"text":"Noga juc shimi rimarcuptillämi lamar yacupis chaquicäcunman,","poem":1},{"lineBreak":true},{"text":"mayucunapis chaqui jircaman ticracurinman.","poem":1},{"lineBreak":true},{"text":"Chauraga pescäducunapis yacunaypita wañunmanmi,","poem":1},{"lineBreak":true},{"text":"yacu mana captin ismunmanmi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nogami syëlutapis yanauyaycajman ticrarachë.","poem":1},{"lineBreak":true},{"text":"Lütu caycajmanno yanayächë.»","poem":1}]},{"type":"heading","content":["Tayta Diosta sirbej yäracushan"]},{"type":"verse","number":4,"content":[{"text":"Tayta Diosga yachachimasha","poem":1},{"lineBreak":true},{"text":"uticasha caycajcunata shacyächir cushicachinäpämi.","poem":1},{"lineBreak":true},{"text":"Tayta Dios nimashanta masta-masta tantiyacunäpämi","poem":1},{"lineBreak":true},{"text":"cada tuta wiyaj wiyajlla caycächiman.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Diosmi wiyacunäpaj yanapäman.","poem":1},{"lineBreak":true},{"text":"Nimashancunatapis mana cachariypami cumlishcä.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Astimänanpäpis wajtäta camapashcämi.","poem":1},{"lineBreak":true},{"text":"Shapräta achur-ushaptinpis manami rimacushcächu.","poem":1},{"lineBreak":true},{"text":"Ashllircaycämaptin, togapaycämaptinpis","poem":1},{"lineBreak":true},{"text":"cäräta manami chapacushcächu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ichanga Tayta Diosmi yanapäman.","poem":1},{"lineBreak":true},{"text":"Chaymi ashllimashancunaga mana nanämanchu.","poem":1},{"lineBreak":true},{"text":"Musyaycämi pengaycho mana canätaga.","poem":1},{"lineBreak":true},{"text":"Chaymi mana cuyucoj gagano caycä.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¿Piraj nogawan churacanman?","poem":1},{"lineBreak":true},{"text":"¡Pipis nogawan churacayta munaptenga juezman iwal aywashaj!","poem":1},{"lineBreak":true},{"text":"¿Pillaga caycanchuraj dimandamaj?","poem":1},{"lineBreak":true},{"text":"¡Cashpanga shamur mä nimächun ari!","poem":1},{"lineBreak":true},{"text":"Ñaupächömi caycan juchaynaj cashäta nimänanpaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nogataga Tayta Diosmi yanapäman.","poem":1},{"lineBreak":true},{"text":"Chauraga ¿piraj «juchayojmi canqui» nimanga?","poem":1},{"lineBreak":true},{"text":"Puyu ushaptin röpa ushacashannömi","poem":1},{"lineBreak":true},{"text":"conträcunaga llapan ushacanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¿Pitaj Tayta Diosta rispitan?","poem":1},{"lineBreak":true},{"text":"¿Pitaj Tayta Diosta sirbejta wiyacun?","poem":1},{"lineBreak":true},{"text":"Chacaycho purirpis Tayta Diosman yäracojcunallami,","poem":1},{"lineBreak":true},{"text":"upinaycajlla achquin caycaptinpis","poem":1},{"lineBreak":true},{"text":"Diosman guellicojcunallami wiyacun y rispitan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Cuydädu, achquicunayquipaj quiquiquicunalla ninata sindejcuna;","poem":1},{"lineBreak":true},{"text":"chay ninawan achquicusha purejcuna.","poem":1},{"lineBreak":true},{"text":"Chayno cawaptiquega Tayta Dios castigashunquipämi.","poem":1},{"lineBreak":true},{"text":"Fiyupa llaquicur ñacaychömi goyanquipaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}