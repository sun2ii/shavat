{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":51,"content":[{"type":"heading","content":["Jerusalén runacunata shacyächishan"]},{"type":"verse","number":1,"content":["Tayta Diosmi cayno nin:",{"lineBreak":true},{"text":"«Allita rurar cawayta munajcuna,","poem":1},{"lineBreak":true},{"text":"Noga nishäno rurayta munajcuna wiyamay.","poem":1},{"lineBreak":true},{"text":"Masqui tantiyacuy maynin gagapita jorgusha cashayquitapis,","poem":1},{"lineBreak":true},{"text":"maynincho caycaj rumicunapita llojshimushayquitapis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Masqui yarpäriy unay awiluyqui Abrahampaj.","poem":1},{"lineBreak":true},{"text":"Yarpäriy gamcunata gueshpichishoj Sarapaj.","poem":1},{"lineBreak":true},{"text":"Noga gayashä öra paycunaga wamraynajllami caran.","poem":1},{"lineBreak":true},{"text":"Nogami bindisyunta gorä. Paypita mirajcuna aypalla cananpaj yanaparä.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ragällan caycaj Sión siudätaga nogami cuyapäshaj.","poem":1},{"lineBreak":true},{"text":"Chunyaj chaqui jircatami wertamanna ticrarachishaj.","poem":1},{"lineBreak":true},{"text":"Chaura cangapaj Edencho cashan wertanömi.","poem":1},{"lineBreak":true},{"text":"Chaychöga cangapaj cushicuyllana, jauca goyayllana,","poem":1},{"lineBreak":true},{"text":"alabansacunata cantayllana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Acrashä runacuna sumaj wiyamay.","poem":1},{"lineBreak":true},{"text":"Acrashä nasyun runacuna sumaj tantiyay.","poem":1},{"lineBreak":true},{"text":"Yachachicuynëcunatami willacachishäpaj.","poem":1},{"lineBreak":true},{"text":"Chaycunaga llapan nasyun runacunapaj achquinömi canga noga munashänöna cawananpaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wallcanami pishin salbanäpaj.","poem":1},{"lineBreak":true},{"text":"Manapis aycällatanami munaynëwan llapan nasyun runacunata mandashaj.","poem":1},{"lineBreak":true},{"text":"Lamar cantun nasyuncho tiyaj runacuna nogallamanmi yäracamonga.","poem":1},{"lineBreak":true},{"text":"Munayniyoj cashallämanmi yäracamonga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Syëlutapis ricäriy.","poem":1},{"lineBreak":true},{"text":"Pachatapis ricäriy.","poem":1},{"lineBreak":true},{"text":"Syëluga goshtaynöllami illgacäcongapaj.","poem":1},{"lineBreak":true},{"text":"Allpapis röpa ushacajnöllami ushacangapaj.","poem":1},{"lineBreak":true},{"text":"Runacunapis chuspicunanöllami wañongapaj.","poem":1},{"lineBreak":true},{"text":"Salbacoj cashämi ichanga imaycamapis chaynölla caycanga.","poem":1},{"lineBreak":true},{"text":"Nogaga imaypis canan caycashänöllami caycäshäpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Alli caj imano cashantapis musyajcuna,","poem":1},{"lineBreak":true},{"text":"yachachishäcunata ruraj runacuna wiyamay.","poem":1},{"lineBreak":true},{"text":"Runacuna tucuyta nishuptiquipis ama llaquicuychu.","poem":1},{"lineBreak":true},{"text":"Ashllishuptiquipis ama jagayaychu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chay runacunaga ushacangapaj puyu röpata ushacurcushannömi,","poem":1},{"lineBreak":true},{"text":"millwa garachata curu ushacurcushannömi.","poem":1},{"lineBreak":true},{"text":"Salbacoj cashämi ichanga imaycamapis chaynölla caycanga.","poem":1},{"lineBreak":true},{"text":"Nogaga imaypis canan caycashänöllami caycäshaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¡Ricchayna ari Tayta Dios!","poem":1},{"lineBreak":true},{"text":"Fiyupa munayniyoj cashayquita musyacächiyna ari.","poem":1},{"lineBreak":true},{"text":"Mas unay caj watacuna rurashayquino,","poem":1},{"lineBreak":true},{"text":"unay caj runacuna cawashan wichan rurashayquino rurayna ari.","poem":1},{"lineBreak":true},{"text":"Gammi illgächishcanqui lamarcho caycaj waräcuy Rahabtapis.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"May-may ruri caycaj lamar yacutapis gammi chaquirachirayqui.","poem":1},{"lineBreak":true},{"text":"Nircorga chay lamarta nänimanna ticrarachirayqui","poem":1},{"lineBreak":true},{"text":"llapan salbashayquicuna chaypa päsananpaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Dios salbar jorgamushan cajcunaga cutimongami.","poem":1},{"lineBreak":true},{"text":"Cantashpanmi Sionman chayanga.","poem":1},{"lineBreak":true},{"text":"Chaychöga imaycamapis cushishallami goyangapaj.","poem":1},{"lineBreak":true},{"text":"Paycunapäga cushicuywan alli goyayllanami cangapaj.","poem":1},{"lineBreak":true},{"text":"Nanaypis llaquicuypis manami canganachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tayta Diosmi cayno nisha:","poem":1},{"lineBreak":true},{"text":"«Noga quiquëmi gamcunataga shacyächë.","poem":1},{"lineBreak":true},{"text":"¿Pitataj manchacunqui? ¿Runa-masiquitachu?","poem":1},{"lineBreak":true},{"text":"¿Guewanölla wañoj runacunatachu manchacunqui?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nogami syëlutapis mashtacächej y allpatapis sumaj tacyachëga caycä.","poem":1},{"lineBreak":true},{"text":"Nogami camashoj Tayta Diosniqui caycä.","poem":1},{"lineBreak":true},{"text":"Chaura fiyupa ollgusha contrayquicuna illgächiyta munaycäshojcunata ama manchacuychu.","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj contrayquicunata manchacunquiman?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ñacaycajcunaga manapis aycällatanami salbasha cangapaj.","poem":1},{"lineBreak":true},{"text":"Manami carsil-llachöga wañongachu.","poem":1},{"lineBreak":true},{"text":"Ni micuyninpis manami pishengapächu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nogami cä Tayta Diosniquega.","poem":1},{"lineBreak":true},{"text":"Nogapa jutëga munayniyoj Tayta Diosmi.","poem":1},{"lineBreak":true},{"text":"Nogami lamar yacutapis cuyurachë.","poem":1},{"lineBreak":true},{"text":"Chauraga pullchajyashpan fiyupami gaparan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Syëluta mashtacächirä.","poem":1},{"lineBreak":true},{"text":"Allpatapis sumaj camacächishcä.","poem":1},{"lineBreak":true},{"text":"Rimanäpaj cajtapis nogami shimiquiman churashcä.","poem":1},{"lineBreak":true},{"text":"Nogami ima chayashunayquitapis munaynëwan chapashcä.","poem":1},{"lineBreak":true},{"text":"Nogami Siontaga nirä: ‹Gamga acrashämi canqui› nir.»","poem":1}]},{"type":"heading","content":["Tayta Dios rabyar castigananpaj cashan"]},{"type":"verse","number":17,"content":[{"text":"Jerusalén, apurä ricchay ari. Juclla jatariy.","poem":1},{"lineBreak":true},{"text":"Gamga Tayta Dios castigacunan cöpacho caycajtami upushcanqui.","poem":1},{"lineBreak":true},{"text":"Juc runa cöpata charir ushajpaj upucurcur","poem":1},{"lineBreak":true},{"text":"fiyupa machasha cashannömi ñacashcanqui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Achca wamrayquicuna casha captinpis","poem":1},{"lineBreak":true},{"text":"ni jucnayllapis manami canchu pushashunayquipaj.","poem":1},{"lineBreak":true},{"text":"Llapan wamrayquicunata uywasha-captiquipis","poem":1},{"lineBreak":true},{"text":"ni jucnayllapis manami canchu maquipita janchacurcur apashunayquipaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ishcay castami disigrasya chayashurayqui:","poem":1},{"lineBreak":true},{"text":"Nasyunniquita usharir chaycho ima-aycayqui cajtapis apacusha.","poem":1},{"lineBreak":true},{"text":"Nasyunniquicho tiyaj runacunanami pillyachöpis y yargaypitapis wañusha.","poem":1},{"lineBreak":true},{"text":"Gamtaga ¿pillaraj cuyapaycushunqui?","poem":1},{"lineBreak":true},{"text":"¿Pillaraj shogaycushunqui?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Toglla chariptin animal ricacushannömi wamrayquicunaga ricacusha.","poem":1},{"lineBreak":true},{"text":"May cälli isquïnachöpis jitarpaycan.","poem":1},{"lineBreak":true},{"text":"Chaynöga carcaycan Tayta Dios rabyawan castigashushayquicunapitami.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chaymi llaquicur goyaycäga sumaj wiyay.","poem":1},{"lineBreak":true},{"text":"Gamga manami bïnuta upucurcurchu machasha caycanqui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Acrashan runacunata imapitapis chapaj Tayta Diosniquimi cayno nin:","poem":1},{"lineBreak":true},{"text":"«Castigacuna cöpa aptaraycashayquita guechurejnami-aywä.","poem":1},{"lineBreak":true},{"text":"Cananpitaga mananami imaypis upunquipänachu noga rabyar upuchina cöpäpita.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Chay cöpäpitaga noga upuchishäpaj fiyupa ñacachishojcunatana,","poem":1},{"lineBreak":true},{"text":"‹pampaman jitacay janayquipa päsanäpaj› nishojcunatana.","poem":1},{"lineBreak":true},{"text":"Chaura gamcunaga pampaman jitacarayqui","poem":1},{"lineBreak":true},{"text":"allpatano lluchcar-ushashunayquipaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}