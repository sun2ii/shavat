{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":52,"content":[{"type":"heading","content":["Jerusalenta salbananpaj willacachishan"]},{"type":"verse","number":1,"content":[{"text":"Sión, ricchayna ari.","poem":1},{"lineBreak":true},{"text":"Sumaj callpachacuy.","poem":1},{"lineBreak":true},{"text":"Rispitädu Jerusalén siudä,","poem":1},{"lineBreak":true},{"text":"achicyaypa achicyaj caj röpayquitana jaticuy.","poem":1},{"lineBreak":true},{"text":"Jäpa runacunawan ganra runacunaga","poem":1},{"lineBreak":true},{"text":"pillyaj manami gamman yaycamongapänachu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jatariy Jerusalén.","poem":1},{"lineBreak":true},{"text":"Janayquicho caycaj ganrata tapsicuyna.","poem":1},{"lineBreak":true},{"text":"Prësu caycaj Sión, cuncayquicho wataraycaj cadinacunata cachachicuyna.","poem":1},{"lineBreak":true},{"text":"Mandajpa jamanan sillunmanna jamacuy.","poem":1}]},{"type":"verse","number":3,"content":["Tayta Diosga caynömi nin: «Uywayno canayquipaj juc-lä nasyunman gamcunata prësu apashuptiqui manami ima pägatapis chasquishcächu. Chaymi canan gamcunata jorgamushpäpis mana ni imatapis pägashächu."]},{"type":"verse","number":4,"content":["Unayga acrashä runacuna Egiptumanmi aywacuran. Chaychöna uyway cashpan ñacar tiyaran. Guepataga imatapis mana rimapaycaptinmi Asiria runacunana ñacachisha."]},{"type":"verse","number":5,"content":["Cananga ¿imatanataj ricä? Imatapis mana rimapaycaptillanmi acrashä runacunataga Babiloniaman apacusha. Munaynincho chararajcunaga alli-tucushpanmi asipan. Nogatapis fiyupanami rabyaycächiman."]},{"type":"verse","number":6,"content":["Chaymi juc junäga acrashä runacuna ricanga munaynëwan imano rurashätapis. Musyanga ‹caychömi caycä› nir paycunata willapashäta.»"]},{"type":"verse","number":7,"content":[{"text":"Alli willacuyta apamushpan jircacunapa shamojta ricarga","poem":1},{"lineBreak":true},{"text":"fiyupami cushicunchi.","poem":1},{"lineBreak":true},{"text":"Fiyupa cushicuypämi alli goyayllana cananpaj willacuptenga,","poem":1},{"lineBreak":true},{"text":"salbashana cananpaj willacuycajta wiyashaga.","poem":1},{"lineBreak":true},{"text":"Payga Sionta nin «Tayta Diosniquimi ray» nir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Wiyay-llapa! Ricachacojniquicunaga sinchipami gaparpan.","poem":1},{"lineBreak":true},{"text":"Llapanmi juc shimilla cushicuypita gaparpan.","poem":1},{"lineBreak":true},{"text":"Chaynöga gaparpaycan Tayta Dios Sionman cutimojta","poem":1},{"lineBreak":true},{"text":"quiquincuna ñawinpa ricashpanmi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Jerusalenpa juchusha caycaj pergacuna cushicushpayqui llapayqui gaparpay!","poem":1},{"lineBreak":true},{"text":"Acrashan runacunata Tayta Diosga cuyapashanami.","poem":1},{"lineBreak":true},{"text":"Jerusalentaga salbashanami.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Llapan nasyun runacunapa ricay ñawinchömi","poem":1},{"lineBreak":true},{"text":"Tayta Diosga munayniyoj cashanta musyachisha.","poem":1},{"lineBreak":true},{"text":"Chaynöpami Tayta Diosninchi salbamashanchëga intëru cay pachacho mayacanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Chay Babiloniapita llojshicuyna-llapa.","poem":1},{"lineBreak":true},{"text":"Ama yataychu imatapis ganrayächicoj cajtaga.","poem":1},{"lineBreak":true},{"text":"Chaycho caycashayquipitaga llojshicuyna ari.","poem":1},{"lineBreak":true},{"text":"¡Tayta Diospa rispitädu cösancunata cutichejcunaga","poem":1},{"lineBreak":true},{"text":"ganrayächicojcunata ama yataychu!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ichanga manami apuräduchu llojshicunquipaj.","poem":1},{"lineBreak":true},{"text":"Manami gueshpiypachu aywacunquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga canga gam Israelcunapa Tayta Diosniqui imapitapis chapäshuptiquimi.","poem":1}]},{"type":"heading","content":["Tayta Diosta sirbejpaj rimashan"]},{"type":"verse","number":13,"content":["Sirbejninpaj Tayta Diosga caynömi nisha:",{"text":"«Sirbimajnëga allichömi llojshenga.","poem":1},{"lineBreak":true},{"text":"Fiyupa rispitashami y may-chaychöpis rejsishami canga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Paypa cäran imano caycajtapis ricar achcajmi fiyupa manchacuran.","poem":1},{"lineBreak":true},{"text":"Cäran caycaran mana camaraj. Manami runa-nirajnachu caran.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Achca nasyun runacunami fiyupa almirasha ricacongapaj.","poem":1},{"lineBreak":true},{"text":"Raycunapis ima niytapis manami camäpacongapächu.","poem":1},{"lineBreak":true},{"text":"Chaynöga canga pipis mana willapashanta tantiyashpanmi,","poem":1},{"lineBreak":true},{"text":"imaypis mana wiyashanta wiyashpanmi.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}