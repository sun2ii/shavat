{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"¿Piraj riguiran noganchi willacushanchïtaga?","poem":1},{"lineBreak":true},{"text":"Tayta Diosga ¿pitataj munayniyoj cashanta musyachisha?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Diosga munasha mallwa lanta wiñar","poem":1},{"lineBreak":true},{"text":"chaqui allpaman sapichashanno sirbejnin wiñanantami.","poem":1},{"lineBreak":true},{"text":"Payga manami cuyayllapaj buyna-mösupischu caran.","poem":1},{"lineBreak":true},{"text":"Manami ricapänapänöpischu caran.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Runacunaga manacajman churaj; fiyupa jamurpaj.","poem":1},{"lineBreak":true},{"text":"Payga fiyupa nanaywanmi ñacasha.","poem":1},{"lineBreak":true},{"text":"Pipis manami ricäriyta munajchu.","poem":1},{"lineBreak":true},{"text":"Manacajmanmi churaranchi.","poem":1},{"lineBreak":true},{"text":"Paytaga manami cäsojchu canchi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chaypis payga ñacaycaran noganchi ñacananchïpaj cajtami.","poem":1},{"lineBreak":true},{"text":"Noganchi nanächicunanchïpaj cajtami payga nanächicuycaran.","poem":1},{"lineBreak":true},{"text":"Noganchëga yarparanchi Dios payta chayno ñacaycächishanta,","poem":1},{"lineBreak":true},{"text":"chayno castigaycashanta, pasaypa manacajman churaycashantami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ichanga noganchi Diosta mana wiyacushanchïpitami juchayoj runatanöpis tucsiran.","poem":1},{"lineBreak":true},{"text":"Noganchi mana allita rurashanchïpitami fiyupa ñacachiran.","poem":1},{"lineBreak":true},{"text":"Pay ñacashanpitami noganchi alli goyayta tarishcanchi.","poem":1},{"lineBreak":true},{"text":"Payta däñar-ushashanpitami noganchëga allchacashana caycanchi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Llapanchïmi uyshacunano ogracasha carcaycashcanchi.","poem":1},{"lineBreak":true},{"text":"Cada-ünunchïmi quiquinchi munashanchïno goyäcushcanchi.","poem":1},{"lineBreak":true},{"text":"Ichanga juchanchïcunapita paylla ñacananpämi Tayta Diosga camacächisha.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Payga ñacachiptinpis upällallami cacusha.","poem":1},{"lineBreak":true},{"text":"Paytaga aparan uyshata pishtananpaj apaycajnömi.","poem":1},{"lineBreak":true},{"text":"Manami ni juc shimillapis rimacuranchu.","poem":1},{"lineBreak":true},{"text":"Payga millwanta rutuptin uysha upällalla wiyaräcushannömi upällalla cacuran.","poem":1},{"lineBreak":true},{"text":"Manami ni juc shimillapis rimacuranchu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Imatapis mana allita mana ruraycaptinmi jusgananpaj prësu apasha.","poem":1},{"lineBreak":true},{"text":"Paytaga manami pipis washaranchu.","poem":1},{"lineBreak":true},{"text":"Paypäga manami pipis yarpachacuranchu.","poem":1},{"lineBreak":true},{"text":"Paytaga juchanchïcunapitami wañuchiran.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fiyu runacuna pamparänanmanmi pampanan caran.","poem":1},{"lineBreak":true},{"text":"Chayno caycaptinpis rïcu runa pampacunanmanmi pampaycäriran.","poem":1},{"lineBreak":true},{"text":"Chaynöga ruraran pitapis mana allita mana rurasha captinmi","poem":1},{"lineBreak":true},{"text":"pitapis mana engañaypa willapasha captinmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tayta Diosmi chayno manacajman churaypa ñacachiyta munaran.","poem":1},{"lineBreak":true},{"text":"Sirbejninnami llapan juchayojcunapa ruquin wañunan caran.","poem":1},{"lineBreak":true},{"text":"Chaypitami payga unaycama cawanga.","poem":1},{"lineBreak":true},{"text":"Paypita mirajcunatapis ricangarämi.","poem":1},{"lineBreak":true},{"text":"Tayta Dios munashancunataga llapanta paymi ruranga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ñacashanpitaraj chaycunata ricar fiyupami cushicongapaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta sirbëga achcajtami salbangapaj.","poem":1},{"lineBreak":true},{"text":"Payga achcajpa juchantami apanga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaypitami paytaga Tayta Dios mas alliman churanga.","poem":1},{"lineBreak":true},{"text":"Chaychöga munayniyojcunawan iwalmi alli cajta chasquengapaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga chasquengapaj wañushanpitami,","poem":1},{"lineBreak":true},{"text":"juchayojcunano ñacashanpitami.","poem":1},{"lineBreak":true},{"text":"Rasunpa payga aypalla runacunapa juchantami aparan.","poem":1},{"lineBreak":true},{"text":"Juchayojcunapäpis ruwacur mañacusha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}