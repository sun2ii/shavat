{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":54,"content":[{"type":"heading","content":["Diospa cuyacuynenga imaypis chaynölla cashan"]},{"type":"verse","number":1,"content":[{"text":"«Imaypis wawata mana tarej warmi fiyupa cushicuy.","poem":1},{"lineBreak":true},{"text":"Gam imaypis mana gueshyacoj warmi cushicuypita cantay.","poem":1},{"lineBreak":true},{"text":"Runan cachaycusha wawata mana tarej warmimi","poem":1},{"lineBreak":true},{"text":"runayoj warmipita mas achca wawata tarenga.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"verse","number":2,"content":[{"text":"«Witichinalla tolduyquita jatunyächiy.","poem":1},{"lineBreak":true},{"text":"Tiyaycashayqui tolduyquitaga mashtar sumaj chutay.","poem":1},{"lineBreak":true},{"text":"Tolduyquita chariraj wascacunata jatunyächiy; istägacunatapis sumaj jawiy.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gamcunaga achcayar wac-läman cay-lämanpis aypallamanmi mashtacanquipaj.","poem":1},{"lineBreak":true},{"text":"Gampita mirajcunaga achca nasyuncunatami guechur charicarcärengapaj.","poem":1},{"lineBreak":true},{"text":"Canan chunyaj caycaj siudäcunachöpis paycunaga juntami tiyangapaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ama manchacuychu. Manami pengaychöga canquipächu.","poem":1},{"lineBreak":true},{"text":"Manami ashllishunquipäpischu. Ni manami imapitapis pengacunquipächu.","poem":1},{"lineBreak":true},{"text":"Wawaynaj jipash car pengacushayquitapis gongaycunquipämi.","poem":1},{"lineBreak":true},{"text":"Manami yarpanquipänachu biyüda captiqui manacajman churashushayquitapis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Camashoj Tayta Diosmi majanpaj shuntashunquipaj.","poem":1},{"lineBreak":true},{"text":"Paypa jutenga munayniyoj Tayta Diosmi.","poem":1},{"lineBreak":true},{"text":"Imapitapis chapäshöga caycan Israelcunapa Santo Tayta Diosninmi.","poem":1},{"lineBreak":true},{"text":"Payga mundu intërupa Diosninmi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gamga cachaycusha jipashnömi fiyupa llaquisha caycarayqui.","poem":1},{"lineBreak":true},{"text":"Chayno caycajtami Tayta Diosniqui yapay gayashurayqui.»","poem":1},"Tayta Diosniquimi chayno nin."]},{"type":"verse","number":7,"content":[{"text":"«Gamtaga rätullami cachaycurä.","poem":1},{"lineBreak":true},{"text":"Ichanga fiyupa cuyapäcoj cashpämi yapay shuntashayqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Illajpita rabyacurcushpämi juc rätulla mana ricamänayquipaj witicurirä.","poem":1},{"lineBreak":true},{"text":"Ichanga imaycamapis cuyapäcoj cashpämi gamta cuyapashcä.»","poem":1},"Jorgushoj Tayta Diosniquimi chayno nin."]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Noé cashan wichanmi jurarä","poem":1},{"lineBreak":true},{"text":"yapayga allpata imaypis yacuwan manana jundichinäpaj.","poem":1},{"lineBreak":true},{"text":"Chaynömi gamtapis jurashpä në gampäga imaypis manana rabyanäpaj.","poem":1},{"lineBreak":true},{"text":"Mananami castïgutapis munachishayquinachu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Puntacuna juc-läman witicuriptinpis,","poem":1},{"lineBreak":true},{"text":"jircacuna gotucäcuptinpis,","poem":1},{"lineBreak":true},{"text":"gamta cuyaytaga manami cachaycushayquipächu.","poem":1},{"lineBreak":true},{"text":"Ni alli conträtuta rurashanchïpitapis manami cutiricushächu.»","poem":1},"Cuyapäshoj Tayta Diosmi chayno nin."]},{"type":"heading","content":["Mushoj Jerusalenpaj rimashan"]},{"type":"verse","number":11,"content":["Tayta Diosga Jerusalén siudäta nin:",{"text":"«¡Pasaypa llaquisha, ñacachisha caycaj, pipis shogashunayquipaj mana caj ricay!","poem":1},{"lineBreak":true},{"text":"Nogami pergayquicunatapis camacächishaj cuyayllapaj ‹carbunclo› rumicunapa jananman.","poem":1},{"lineBreak":true},{"text":"Chaura simintuyquipis ‹zafiro› rumipitami cuyayllapaj canga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"‹Rubí› rumipitami ricachacuna törriquicunatapis rurashaj.","poem":1},{"lineBreak":true},{"text":"Puncuyquicunatapis rurashaj ‹berilo› achicyaj rumipitami.","poem":1},{"lineBreak":true},{"text":"Intëru cantun pergatapis cuyayllapaj rumicunawanmi pergashaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nogami yachachishaj llapan wamrayquicunata.","poem":1},{"lineBreak":true},{"text":"Paycunaga llapanpis allimi goyangapaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Noga munashäno goyarmi alli canquipaj.","poem":1},{"lineBreak":true},{"text":"Manami pipis ñacachishunquipänachu.","poem":1},{"lineBreak":true},{"text":"Manami imatapis manchacunquipächu.","poem":1},{"lineBreak":true},{"text":"Yapayga mananami fiyupa manchariypajcuna chayashunquipänachu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pipis magashunayquipaj shamöga manami noga camacächiptëchu shamongapaj.","poem":1},{"lineBreak":true},{"text":"Chayno magashunayquipaj shamojcunataga llapantami binsinquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Nogami camacächishcä jirrëru cananpaj.","poem":1},{"lineBreak":true},{"text":"Chay runami ninata shanshachin fyërruta wayllachinanpaj.","poem":1},{"lineBreak":true},{"text":"Nircorga fyërrupita ruran tucuy-niraj pillyanacunata.","poem":1},{"lineBreak":true},{"text":"Chay jirrërutanömi ima-aycatapis illgächej runacunatapis camashcä","poem":1},{"lineBreak":true},{"text":"ima-aycatapis pasaypa ushaycunanpaj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ichanga gamta illgächishunayquipaj manami pipis pillyanacunata rurashachu.","poem":1},{"lineBreak":true},{"text":"Achäquita ashipäshojcunataga llapantami upällachinquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynömi canga nogata sirbimajcunapäga.","poem":1},{"lineBreak":true},{"text":"Chaynöpami nogaga salbashaj.»","poem":1},"Tayta Diosmi chayno nin."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}