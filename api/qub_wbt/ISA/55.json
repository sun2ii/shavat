{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":55,"content":[{"type":"heading","content":["Tayta Dios pï-maytapis cuyashan"]},{"type":"verse","number":1,"content":["Tayta Dios cayno nin:",{"text":"«Llapayqui yacunaycajcunaga yacuta upunayquipaj shamuy.","poem":1},{"lineBreak":true},{"text":"Rïguta rantinayquipaj guellayta mana tarejcunaga dibaldi micunayquipaj shamuy.","poem":1},{"lineBreak":true},{"text":"Bïnutapis lëchitapis mana pägayllapa tarinayquipaj shamuy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Imanirtaj guellayniquita ushanqui mana micunachöga?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj arur gänashayquitapis ushanqui manacajcunachöga?","poem":1},{"lineBreak":true},{"text":"Nogata wiyamay. Wiyacamashpayquega alli micuytami tarinquipaj.","poem":1},{"lineBreak":true},{"text":"Fiyupa alli mishquej micuytami micunquipaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Noga cajman shamuy. Nircorga willapashäta wiyacuy.","poem":1},{"lineBreak":true},{"text":"Nishäcunata wiyamay. Chauraga cawanquipämi.","poem":1},{"lineBreak":true},{"text":"Gamcunawanmi conträtuta rurashun imaycamapis alli goyänanchïpaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami ray Davidta cuyar aunishäta cumlishaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paytaga noga churarä nasyuncuna ricacunanpämi,","poem":1},{"lineBreak":true},{"text":"marcacunapapis mandajnin, yachachejnin cananpämi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gamga mana rejsishayqui runacunatami gayanquipaj.","poem":1},{"lineBreak":true},{"text":"Mana rejsishayqui marca runacunanami gam cajman cörriypa shamongapaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga cangapaj Israelcunapa Santo Tayta Diosnin","poem":1},{"lineBreak":true},{"text":"gamta fiyupa rispitädu cayman churasha-cashuptiquimi.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Canan timpu cashancama Tayta Diosta ashiy.","poem":1},{"lineBreak":true},{"text":"Manaraj carucho cashancama gayacuy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fiyu runacunaga mana allicunata ama rurachunnachu,","poem":1},{"lineBreak":true},{"text":"mana allita rurananpäga ama yarpächunnachu.","poem":1},{"lineBreak":true},{"text":"Tayta Diosman yapay cutichun. Chaura paypis cuyapangami.","poem":1},{"lineBreak":true},{"text":"Payga amatar alli cashpanmi perdunacun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Tayta Dios cayno nin:",{"text":"«Noga yarpashäga manami gamcuna yarpashayquinöchu.","poem":1},{"lineBreak":true},{"text":"Noga rurashäga manami gamcuna rurashayquinöpischu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Imanömi syëlupis caycan allpapita mas janajcho,","poem":1},{"lineBreak":true},{"text":"chaynömi yarpashäcunapis, ima rurashäcunapis","poem":1},{"lineBreak":true},{"text":"gamcunapäga tantiyayta mana atipaypaj caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Tamyapis, rashtapis syëlupitami shicwamun.","poem":1},{"lineBreak":true},{"text":"Nircur manami janajman cutinnachu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga allpatami ömiyächin.","poem":1},{"lineBreak":true},{"text":"Chaynami muruta pashtachir wiñachimun.","poem":1},{"lineBreak":true},{"text":"Nircorga yapay murunanpaj muruchachin.","poem":1},{"lineBreak":true},{"text":"Micunapäpis micuyta wayuchin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chaynömi noga parlashäcunapis.","poem":1},{"lineBreak":true},{"text":"Manami jinallanchöga illgangachu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga noga munashätami ruranga.","poem":1},{"lineBreak":true},{"text":"Imano rurananpäpis nishätami cumlenga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gamcunaga cushishami aywacunquipaj.","poem":1},{"lineBreak":true},{"text":"Allillami cuticunquipaj.","poem":1},{"lineBreak":true},{"text":"Gamcunata ricashushpayqui puntacunapis puytush lömacunapis cushicuypitami cantangapaj.","poem":1},{"lineBreak":true},{"text":"Jircacunacho caj yöracunapis llapanmi macshongapaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Cashacuna cashanchömi pïno yöracuna wiñamongapaj.","poem":1},{"lineBreak":true},{"text":"Ishancacuna cashanchömi rayan yöracuna wiñamongapaj.","poem":1},{"lineBreak":true},{"text":"Chayno captinmi nogaga intërucho rejsisha cashaj.","poem":1},{"lineBreak":true},{"text":"Chaytaga imaycamapis manami pipis gongangachu.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}