{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":56,"content":[{"type":"heading","content":["Pï-maytapis Tayta Dios salbananpaj cashan"]},{"type":"verse","number":1,"content":["Tayta Dios cayno nin:",{"text":"«Rasun cajllata ruray-llapa.","poem":1},{"lineBreak":true},{"text":"Alli cajllata ruray-llapa.","poem":1},{"lineBreak":true},{"text":"Manapis aycällatanami salbashaj.","poem":1},{"lineBreak":true},{"text":"Chayno salbashpämi munayniyoj cashäta musyachishaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Cushishami cawanga nishäta cumlej runaga.","poem":1},{"lineBreak":true},{"text":"Cushishami cawanga säbadu jamay junajta rispitaj runaga.","poem":1},{"lineBreak":true},{"text":"Cushishami cawanga mana alli ruraycunata mana ruräshej runaga.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jäpa runaga Tayta Dios munashanno rurar ama ninmanchu:","poem":1},{"lineBreak":true},{"text":"«Acrashan runacunapita shuynimi Tayta Dios charämanga» nir.","poem":1},{"lineBreak":true},{"text":"Capun runapis ama ninmanchu","poem":1},{"lineBreak":true},{"text":"«Nogaga juc chaquisha guerunömi cä» nir.","poem":1}]},{"type":"verse","number":4,"content":["Tayta Diosga caynömi nin:",{"text":"«Capun runacuna caycajpis säbadu jamay junajcunata rispitaptin;","poem":1},{"lineBreak":true},{"text":"Noga munashäcunata cumliptin;","poem":1},{"lineBreak":true},{"text":"conträtuta rurar parlashänölla ruraptenga","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"warmi ollgu wamrancunata charänanpita mas allitami goshaj.","poem":1},{"lineBreak":true},{"text":"Chaynömi camacächishaj wasëcho tiyananpaj, wasë ruriman yaycunanpaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami jutin imaycamapis mana gongacangachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jäpa runacuna sirbimänanpaj, cuyamänanpaj","poem":1},{"lineBreak":true},{"text":"Nogapa munaynëman guellicamur","poem":1},{"lineBreak":true},{"text":"säbadu jamay junajta rispitar,","poem":1},{"lineBreak":true},{"text":"conträtuta rurar parlacushäno llapanta cumliptenga","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nogami pushamushaj rispitädu jircäman.","poem":1},{"lineBreak":true},{"text":"Nircurmi aduramänan wasëcho cushishata goyächishaj.","poem":1},{"lineBreak":true},{"text":"Paycuna altarnëcho garamashanta, uywacunata rupachishanta chasquishämi.","poem":1},{"lineBreak":true},{"text":"Wasëpäga llapan runapis ‹Tayta Diosta mañacuna wasi› nengami.»","poem":1}]},{"type":"verse","number":8,"content":["Mashtacasha caycaj Israelcunata yapay shuntaj Tayta Diosmi cayno nin:",{"text":"«Shuntasha caycächishäpa jananmanpis mastarämi shuntamushaj.»","poem":1}]},{"type":"heading","content":["Mana alli mandajcunapa contran rimashan"]},{"type":"verse","number":9,"content":[{"text":"Jirca animalcuna, munti animalcuna shamuy","poem":1},{"lineBreak":true},{"text":"uyshacunano caycaj Israelcunata micucurcunayquipaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paycunata mandaycäga gaprayashami carcaycan.","poem":1},{"lineBreak":true},{"text":"Manami imatapis musyanchu.","poem":1},{"lineBreak":true},{"text":"Llapanpis paycunaga carcaycan mana wagyacoj allgunömi.","poem":1},{"lineBreak":true},{"text":"Paycunaga goyay-goyaymi jitaräcun.","poem":1},{"lineBreak":true},{"text":"Puñullarmi cacun.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paycunaga mana sacsaytapis atipaj yargaj guella allgucunanömi.","poem":1},{"lineBreak":true},{"text":"Paycunaga imatapis mana tantiyaj uyshërucunami.","poem":1},{"lineBreak":true},{"text":"Cada-ünunmi imanöpis yarpashanno goyäcun.","poem":1},{"lineBreak":true},{"text":"Imatapis quiquincuna munashallantami ashircaycan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Paycunaga nin: «Upyananchïpaj bïnuta, machächicojcunata ashej aywashun.","poem":1},{"lineBreak":true},{"text":"Canan rurashanchïno warapis rurashun.","poem":1},{"lineBreak":true},{"text":"Capas masllaräpis rurashun.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}