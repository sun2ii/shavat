{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":57,"content":[{"type":"heading","content":["Ïdulucunata adurajcunapa contran rimashan"]},{"type":"verse","number":1,"content":[{"text":"Alli runacuna wañuptin paypäga pipis manami imapis gocunchu.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta sirbej runacunapis wañucur mananami mana alli ruraycunata ricannachu.","poem":1},{"lineBreak":true},{"text":"Tayta Dios chayno shuntacuycashanta manami pipis tantiyanchu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chay runacunaga alli goyaychöna cananpämi aywacun.","poem":1},{"lineBreak":true},{"text":"Rasunpa alli cajllatami paycunaga ruraran.","poem":1},{"lineBreak":true},{"text":"Chaypitami paycunaga jamacun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Tayta Diosmi cayno nin:",{"text":"«Witimuy brüjacunapa wawan.","poem":1},{"lineBreak":true},{"text":"Shamuy mañösa warmipa wawan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gamcunaga ¿pitataj asiparcaycanqui?","poem":1},{"lineBreak":true},{"text":"¿Pitataj pasaypa manacajman churar ricaparcaycanqui?","poem":1},{"lineBreak":true},{"text":"¿Pitataj galluyquita ajtuparcaycanqui?","poem":1},{"lineBreak":true},{"text":"Gamcunaga canqui llulla runacunapa, juchata rurar cacushanpa wamrancunami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gamcunaga roble gueru chaquincunacho, rämasapa yöracunapa chaquinchöpis dioscunata adurashpayqui","poem":1},{"lineBreak":true},{"text":"melanaypaj ganracunatami rurarcaycanqui.","poem":1},{"lineBreak":true},{"text":"Dioscunata adurashpayquipis wamracunata pishtarcur rupaycächinqui ragra läduncunacho, gagapa shillincunacho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Israel, gamga yacu aywaj ragra cantuncunacho caycaj ullush rumicunatami adurayta munanqui.","poem":1},{"lineBreak":true},{"text":"Bïnu ofrendacunatapis chaycunamanmi wiñapashcanqui.","poem":1},{"lineBreak":true},{"text":"Chaqui micuy ofrendacunatapis ‹paypaj› nir apashcanqui.","poem":1},{"lineBreak":true},{"text":"¿Chayno rurasha caycaptiquichi nogaga upällalla cacushaj?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Altunnin puntacunachömi cämayquitapis camacächishcanqui.","poem":1},{"lineBreak":true},{"text":"Chaycamami wichashcanqui sacrifisyucunata garanayquipaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wasiquipa puncu wajtancunamanmi","poem":1},{"lineBreak":true},{"text":"melanaypaj ïdulucunata churashcanqui.","poem":1},{"lineBreak":true},{"text":"Nogataga gongaycamashpayquimi röpayquita lojticushcanqui.","poem":1},{"lineBreak":true},{"text":"Nircorga jatun cämayquicho jucwan cacushcanqui.","poem":1},{"lineBreak":true},{"text":"Puñucuyta munashayqui caj runacunawanga alli parlacurayqui.","poem":1},{"lineBreak":true},{"text":"Paycunawan cacushpayqui chay ïdulucunatami aduraj canqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Asëtita apashpayqui cörriyllapa aywashcanqui diosniqui Moloc cajman.","poem":1},{"lineBreak":true},{"text":"Aypalla perfümitapis apashcanqui.","poem":1},{"lineBreak":true},{"text":"Juc diosta sirbiyta munarmi fiyupa caruman ruquiquita cachashcanqui.","poem":1},{"lineBreak":true},{"text":"Chaynömi wañojcuna caycashancamapis cachayquita chayachishcanqui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chay-jina purishpayquimi uticarayqui.","poem":1},{"lineBreak":true},{"text":"Ichanga manami nirayquichu ‹yangallapämi ashinchi› nir.","poem":1},{"lineBreak":true},{"text":"Sïguir ashinayquipäga imanöpapis balurcharayqui.","poem":1},{"lineBreak":true},{"text":"Chaynöpami mana yamacaypa ashirayqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«¿Pita manchacushpayquitaj nogata engañamashcanqui?","poem":1},{"lineBreak":true},{"text":"¿Pita rispitashpayquitaj nogata gongaycamashcanqui?","poem":1},{"lineBreak":true},{"text":"¿Unaypita-pacha mana rimacuptëchu gamcunaga mana rispitamanquichu?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Imano cashayquitapis nogaga intërupami musyachishaj.","poem":1},{"lineBreak":true},{"text":"Chauraga llapan rurashayquicunapis yangallapämi canga.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yanapäshunayquipaj gaparaypa gayacuptiquipis","poem":1},{"lineBreak":true},{"text":"ïduluyquicunaga manami yanapäshunquipächu, ni salbashunquipäpischu.","poem":1},{"lineBreak":true},{"text":"Chaycunataga llapantami wayra apacongapaj.","poem":1},{"lineBreak":true},{"text":"Wayraga juc wayramuyllachömi illgarachengapaj.","poem":1},{"lineBreak":true},{"text":"Nogaman yäracamoj cajmi ichanga aunishä pachacho partisyunta chasquenga.","poem":1},{"lineBreak":true},{"text":"Nircur rispitädu jircächo tiyanga.»","poem":1}]},{"type":"heading","content":["Israelcunata castigarcur allchacächishan"]},{"type":"verse","number":14,"content":["Chayrämi cayno nishan wiyacangapaj:",{"text":"«Nänita aruy-llapa.","poem":1},{"lineBreak":true},{"text":"Imapis chaparaycajcunataga jitariy acrashä runacuna päsananpaj.»","poem":1}]},{"type":"verse","number":15,"content":["Janajcho tiyaj, imaycamapis cawaj, Santo Tayta Diosmi cayno nin:",{"text":"«Nogaga tiyä rispitädu janaj pachachömi.","poem":1},{"lineBreak":true},{"text":"Ichanga umildicunawanpis llaquicuycajcunawanpis iwalmi caycä.","poem":1},{"lineBreak":true},{"text":"Paycunatanami yanapar shacyächë.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nogaga manami para-simriga ‹juchayoj canqui› niycäshäpänachu.","poem":1},{"lineBreak":true},{"text":"Mananami para-simriga rabyashapis caycäshänachu.","poem":1},{"lineBreak":true},{"text":"Chayno rabyashalla captëga","poem":1},{"lineBreak":true},{"text":"camashä runacuna mananami yäracamanmanchu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Israelcuna juchata rurashanpitami","poem":1},{"lineBreak":true},{"text":"juc timpu rabyasha caycarä.","poem":1},{"lineBreak":true},{"text":"Chaynöpami paycunataga castigarcur cachaycurä.","poem":1},{"lineBreak":true},{"text":"Chaura paycunaga quiquincuna munashannöna goyaran.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mana wiyacamashantaga ricashcämi.","poem":1},{"lineBreak":true},{"text":"Chaypis mana wiyacamaj caycajta allchacächishämi.","poem":1},{"lineBreak":true},{"text":"Nircorga allimi jamachishaj.","poem":1},{"lineBreak":true},{"text":"Chaura mana yarpachacuypanami goyangapis.","poem":1},{"lineBreak":true},{"text":"Llaquisha caycajcunatapis nogami cushicachishaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nircorga caynömi willacachishaj:","poem":1},{"lineBreak":true},{"text":"‹¡Carucho caycajcunapaj alli goyay cachun!","poem":1},{"lineBreak":true},{"text":"¡Sercacho goyaycajcunapäpis alli goyay cachun!› nir.","poem":1},{"lineBreak":true},{"text":"¡Acrashä runacunataga nogami allchacächishaj!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fiyu runacunami ichanga carcaycan lamar pullchajyar mana chawajno.","poem":1},{"lineBreak":true},{"text":"Wayra pullchajyächiptin mitutawan ganracunata lamar jitarimushannömi caycan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chaynömi fiyu runacunapäga alli goyay mana canchu.»","poem":1},"Tayta Diosmi chayno nisha."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}