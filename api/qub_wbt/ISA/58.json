{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":58,"content":[{"type":"heading","content":["Rasunpa ayunay imano cashanpis"]},{"type":"verse","number":1,"content":["Tayta Dios nimaran:",{"text":"«Mana manchacuypa llapan callpayquiwan gayacamay.","poem":1},{"lineBreak":true},{"text":"Trompëta wagajnöraj sinchipa gayacamay.","poem":1},{"lineBreak":true},{"text":"Jacobpita miraj acrashä runacunata juchanpita piñacuy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Paycunaga waran-waranmi nogaman mañacaycämun.","poem":1},{"lineBreak":true},{"text":"Munashäno rurananpaj cajta musyarmi paycunaga cushisha caycan,","poem":1},{"lineBreak":true},{"text":"allita ruraj runacunanöraj, laynëcunatapis mana cachaypa cumlejnöraj.","poem":1},{"lineBreak":true},{"text":"‹Alli cajta ruranäpaj laycunata musyachimay› nir mañacaman.","poem":1},{"lineBreak":true},{"text":"Chayno mañacamarmi paycunaga alli-tucurcaycan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chaypis nircaycäman:","poem":1},{"lineBreak":true},{"text":"‹Mana ricaycämaptiquega ¿imapätaj ayunashäcunapis?","poem":1},{"lineBreak":true},{"text":"¿Imapätaj cuerpöcunatapis ñacachishaj gam mana cuentata apacuycaptiquega?›","poem":1},{"lineBreak":true},{"text":"Nishpayquipis gamcunaga ayunay junaj nigusyullatami arurcaycanqui.","poem":1},{"lineBreak":true},{"text":"Piyunniquicunatapis amatar aruchishpayqui ñacaycächinqui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ayunay junaj gamcunaga goyanqui rimanacullar, pillyallar,","poem":1},{"lineBreak":true},{"text":"wañuchicojcunano cutanacushpallayquimi.","poem":1},{"lineBreak":true},{"text":"Ayunay junajcho chayno rurashayquipitaga","poem":1},{"lineBreak":true},{"text":"ruwacur mañacamashayquicunata noga manami wiyashächu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Gamcunaga yarpanqui llaquicur-raj ayunashayqui nogapaj alli cashantachu,","poem":1},{"lineBreak":true},{"text":"shogush umpucajnöpis uysucusha purishayqui nogapaj alli cashantachu,","poem":1},{"lineBreak":true},{"text":"uchpamanpis gachga röpayqui jatisha wegucunayquitaraj munashätachu?","poem":1},{"lineBreak":true},{"text":"¿Chayno rurashayquitachi gamcunaga ‹Tayta Dios munashanno ayunay junajmi› ninqui?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Noga munashä ayünuga manami chaynöchu.","poem":1},{"lineBreak":true},{"text":"Nogaga munä ayunay junajcho manacajpita prësu caycajcunata cacharinayquitami;","poem":1},{"lineBreak":true},{"text":"ñacaycächishancunata libri cananpaj cacharinayquitami;","poem":1},{"lineBreak":true},{"text":"firsapitaga pitapis manana aruchinayquitami;","poem":1},{"lineBreak":true},{"text":"yüguta pascajno jamachinayquitami.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Noga munä yargaypita caycaj runata micuyniquita garanayquitami;","poem":1},{"lineBreak":true},{"text":"wasiynaj pobri runata wasiquiman pachächinayquitami;","poem":1},{"lineBreak":true},{"text":"röpaynaj captin röpayquita goycunayquitami;","poem":1},{"lineBreak":true},{"text":"pitapis runa-masiquitaga cuyapänayquitami.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chauraga gamcuna canquipaj pacha waraptin achicyajnömi.","poem":1},{"lineBreak":true},{"text":"Chayno captiquega allchacächishayquipänami.","poem":1},{"lineBreak":true},{"text":"Allita rurashayquimi ñaupayquita aywajno canga.","poem":1},{"lineBreak":true},{"text":"Nogapa munaynënami guepayquita shamojno canga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaymi mañacamaptiqui yanapäshayquipaj.","poem":1},{"lineBreak":true},{"text":"Yanapänäpaj gayacamuptiqui ‹caychömi caycä› nishayquipaj.","poem":1},{"lineBreak":true},{"text":"Pitapis manana ñacachiptiqui,","poem":1},{"lineBreak":true},{"text":"juccunata mana ashlliptiqui,","poem":1},{"lineBreak":true},{"text":"pitapis mana jitapaptiqui,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"quiquiquipaj cajta yargaycaj runata goycuptiqui,","poem":1},{"lineBreak":true},{"text":"llaquicuycajta nistashanwan yanapaptiqui,","poem":1},{"lineBreak":true},{"text":"chacajchöno carpis achicyajnömi canquipaj.","poem":1},{"lineBreak":true},{"text":"Chacäpacushano cashayquipis pullan junajmannömi ticracurenga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nogaga imay örapis pusharaycäshayquipämi.","poem":1},{"lineBreak":true},{"text":"Chunyaj chaqui jircachöpis aypalla micuytami tarichishayqui.","poem":1},{"lineBreak":true},{"text":"Callpayqui cananpäpis yanapäshayquimi.","poem":1},{"lineBreak":true},{"text":"Chauraga caycanquipaj cadalla pargusha werta caycajnömi,","poem":1},{"lineBreak":true},{"text":"yacu llojshinan pösucho imaypis yacu mana chaquejnömi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gamcunaga unay caj ragäcunata pergar yapaymi allchanquipaj.","poem":1},{"lineBreak":true},{"text":"Unayna simintuta pergashantapis sumaj sinchi cananpämi yapay allchanquipaj.","poem":1},{"lineBreak":true},{"text":"Chaura gamcunataga ‹tunisha pergacunata allchaj›","poem":1},{"lineBreak":true},{"text":"‹juchusha wasicunata allchaj› nishunquipämi.","poem":1}]},{"type":"heading","content":["Säbadu jamay junajpaj yachachishan"]},{"type":"verse","number":13,"content":[{"text":"«Säbadu jamay junajtaga rispitay.","poem":1},{"lineBreak":true},{"text":"Chay junajchöga ama imatapis ranticunacuychu.","poem":1},{"lineBreak":true},{"text":"Chay junäga gamcunapaj cachun cushicuy junaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosniqui acrashan junaj captin rispitädu cachun.","poem":1},{"lineBreak":true},{"text":"Ima rurayniquitapis cachaycur chay junajtaga rispitanqui.","poem":1},{"lineBreak":true},{"text":"Quiquiqui allicho canallayquipäga ama imatapis ruraychu.","poem":1},{"lineBreak":true},{"text":"Manacajcunata ama rimaychu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chaycunata cumlerga cushisha allimi goyanquipaj.","poem":1},{"lineBreak":true},{"text":"Noganami alliman churashayquipaj altunnin jircacunapa llapanta binsichir pushashpä.","poem":1},{"lineBreak":true},{"text":"Unay awiluyqui Jacobta goycunäpaj aunishächönami alli goyächishayquipaj.»","poem":1},"Quiquin Tayta Diosmi chayno nisha."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}