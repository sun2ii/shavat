{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":59,"content":[{"type":"heading","content":["Israelcunata juchanpita castigashan"]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios mana salbananpäga paypa munaynin manami wallcayashachu.","poem":1},{"lineBreak":true},{"text":"Ni mana wiyananpäpis manami upayacäcushachu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ichanga gamcunapa juchayquimi","poem":1},{"lineBreak":true},{"text":"Tayta Diospitaga pergano raquishurayqui.","poem":1},{"lineBreak":true},{"text":"Gamcuna juchata rurashayquipitami Tayta Diosga mana ricärishunquinachu.","poem":1},{"lineBreak":true},{"text":"Mañacuptiquipis mana wiyashunquinachu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gamcunapaga maquiquipis yawarwan tiñicashami caycan.","poem":1},{"lineBreak":true},{"text":"Dëduyquicunapis runa wañuchejllami.","poem":1},{"lineBreak":true},{"text":"Llullacuyllatami parlanquipis.","poem":1},{"lineBreak":true},{"text":"Shimiquicunapis mana allicunallatami parlan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pipis manami rasun cajtaga dimandacunnachu.","poem":1},{"lineBreak":true},{"text":"Pipis manami cannachu rasun cajllawan dimanduman chayäga.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga llullacunanpaj cajllamanmi yarparaycan.","poem":1},{"lineBreak":true},{"text":"Llullacuyllata rimananpämi carcaycan.","poem":1},{"lineBreak":true},{"text":"Mana allitami gueshyaj carcaycan.","poem":1},{"lineBreak":true},{"text":"Chayno carmi wañuchinacuyllacho carcaycan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Culebra runtuncunata ogllajnömi paycunaga mana alli rurayllata yarparaycan.","poem":1},{"lineBreak":true},{"text":"Pipis chay runtuta micoj cäga wañongami.","poem":1},{"lineBreak":true},{"text":"Paquiriptenga benënuyoj culebracunallami llojshicaramonga.","poem":1},{"lineBreak":true},{"text":"Paycunaga pachca llicanta awajnömi mana alli ruraycunallata yarparaycan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chay llicapitaga manami röpata ruranchu.","poem":1},{"lineBreak":true},{"text":"Chay awashanwanga manami pipis jananta chapacunchu.","poem":1},{"lineBreak":true},{"text":"Paycunaga wañuchicuyllatami arun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mana allita rurananpäga apuraypa apurarmi cörrin.","poem":1},{"lineBreak":true},{"text":"Alli runata wañuchinanpaj rasyaylla aywan.","poem":1},{"lineBreak":true},{"text":"Wañuchicuyllapämi yarparcaycan.","poem":1},{"lineBreak":true},{"text":"Paycuna purishanpaga mana allita rurashallanmi caycan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Manami musyanchu alli goyay imano cashantapis.","poem":1},{"lineBreak":true},{"text":"Paycuna rurashanga llapanpis mana allillami.","poem":1},{"lineBreak":true},{"text":"Paycuna rurashanga llapanpis llutanllami.","poem":1},{"lineBreak":true},{"text":"Paycuna goyashanno goyajcunaga alli goyayta manami tarinchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Juchanchïcunapitami salbacunanchïpäga fiyupa sasa caycan.","poem":1},{"lineBreak":true},{"text":"Chaynöpami Tayta Diospa achicyaynin mana chayamunchu.","poem":1},{"lineBreak":true},{"text":"Achicyajta shuyarashanchïpis chacajllami caycan.","poem":1},{"lineBreak":true},{"text":"Achicyayta munaycarpis yanauyaycajllachörämi purircaycanchi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gapracunanöpis pergata yatayllapami puriycanchi.","poem":1},{"lineBreak":true},{"text":"Ñawiynajnöpis tapra-taprami puriycanchi.","poem":1},{"lineBreak":true},{"text":"Las-dösi inti caycaptinmi chacaypanöpis tacacanchi.","poem":1},{"lineBreak":true},{"text":"Callpallanchïchöraj caycarmi wañushanöna carcaycanchi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Llapanchïpis ucumaryanömi gaparpaycanchi.","poem":1},{"lineBreak":true},{"text":"Palumanömi ataycanchi.","poem":1},{"lineBreak":true},{"text":"Salbasyunta shuyararpis manami salbacunchïchu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Noganchëga Tayta Diosta fiyupami rabyachishcanchi.","poem":1},{"lineBreak":true},{"text":"Juchanchïcunami chayno cashanchïta musyachimanchi.","poem":1},{"lineBreak":true},{"text":"Jucha rurashanchïcunataga yarparaycanchïmi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tayta Dios nishantaga manami cumlishcanchïchu ni wiyacushcanchïpischu.","poem":1},{"lineBreak":true},{"text":"Paytaga chiquicarcärishcanchïmi.","poem":1},{"lineBreak":true},{"text":"Noganchëga wañuchicuyllapämi, juc runata mana alli rurayllapämi parlashcanchi.","poem":1},{"lineBreak":true},{"text":"Jucta-jucta engañanallanchïpämi parlacushcanchïpis.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chaynöpami alli cajta ruraytaga gongaycärishana.","poem":1},{"lineBreak":true},{"text":"Alli cajta ruraytaga pipis manami yarpannachu.","poem":1},{"lineBreak":true},{"text":"Parlashantaga runacuna manami cumlinnachu.","poem":1},{"lineBreak":true},{"text":"Suwapänacur suwapänacullarnami goyarcaycan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Rasun cajtaga mananami pipis parlannachu.","poem":1},{"lineBreak":true},{"text":"Mana allita rurayta cachaycoj cajtaga ima charashallantapis suwapaycärinmi.","poem":1},{"lineBreak":true},{"text":"Pipis allita mana ruraptin Tayta Diosga fiyupami rabyacurcusha.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chayno caycajta pipis mana michajta ricarmi","poem":1},{"lineBreak":true},{"text":"Tayta Diosga fiyupa almiraran.","poem":1},{"lineBreak":true},{"text":"Chaura munayniyoj cashanta llapanta musyachinanpaj quiquinmi camaricuran.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Pay allita rurashanmi pillyar chapacunan chalëcuno ricacusha.","poem":1},{"lineBreak":true},{"text":"Salbacoj cayninnami cascunno ricacusha.","poem":1},{"lineBreak":true},{"text":"Ayñita cutichicoj cayninna röpanno ricacusha.","poem":1},{"lineBreak":true},{"text":"Fiyupa rabyasha cashanna jacucushanno ricacusha.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chayno camaricurcurmi Tayta Diosga cada-ünunta imanöpis rurashanmanno cutichenga.","poem":1},{"lineBreak":true},{"text":"Contrancunataga castigangami.","poem":1},{"lineBreak":true},{"text":"Chiquej cajtaga imanöpis rurashanmannömi cutichenga.","poem":1},{"lineBreak":true},{"text":"Chaynömi ruranga lamar cantun nasyuncunacho tiyaycajtapis.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tayta Diosga fiyupa chayasha mayu aywar","poem":1},{"lineBreak":true},{"text":"jaytarejnörämi chayamongapaj.","poem":1},{"lineBreak":true},{"text":"Llapan runami inti yagamunan caj-läpita-pacha inti yaganan caj-läcama","poem":1},{"lineBreak":true},{"text":"Tayta Diosta rispitangapaj fiyupa munayniyoj caycajta ricashpan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Tayta Dios cayno nin:",{"text":"«Salbacojmi Sionman shamongapaj.","poem":1},{"lineBreak":true},{"text":"Jacobpita mirar-aywajcuna juchancunapita arpinticuptenga llapantami salbanga» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":["Tayta Diosga caynömi nin:",{"text":"«Nogaga paycunawan parlacurmi conträtuta ruraycä.","poem":1},{"lineBreak":true},{"text":"Chaymi në: ‹Espiritöga gamcunapita manami witengachu.","poem":1},{"lineBreak":true},{"text":"Yachachishäcunapis gamcunapita manami gongacangachu.","poem":1},{"lineBreak":true},{"text":"Imaypis manami gongacangachu gamcunapita ni gamcunapita mirajcunapitapis› nir.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}