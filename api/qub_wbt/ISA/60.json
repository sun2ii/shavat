{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":60,"content":[{"type":"heading","content":["Mushoj Jerusalenpaj rimashan"]},{"type":"verse","number":1,"content":["Tayta Dios cayno nin:",{"text":"«Jatariy Jerusalén.","poem":1},{"lineBreak":true},{"text":"Achquiga chayamushanami.","poem":1},{"lineBreak":true},{"text":"Munaynëmi gamcho achicyaycan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Cay pachataga chacajmi chapacurcusha.","poem":1},{"lineBreak":true},{"text":"Nasyuncunataga yanauyaycajmi ñiticurcusha.","poem":1},{"lineBreak":true},{"text":"Gammanmi ichanga achquino noga chayamushäpaj.","poem":1},{"lineBreak":true},{"text":"Munayniyoj cashäpis gamcunawanmi caycangapaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Llapan nasyun runacunami shamongapaj gamcho achqui caycajman.","poem":1},{"lineBreak":true},{"text":"Raycunapis shamongapaj gamcho pacha warajno achicyaptinmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Jerusalén, ichircur intërupa sumaj ricachacuy.","poem":1},{"lineBreak":true},{"text":"Llapanmi shuntacaycur gam cajman aywaycämun.","poem":1},{"lineBreak":true},{"text":"Wamrayquicunapis carupitami aywamongapaj.","poem":1},{"lineBreak":true},{"text":"Warmi wamrayquicunatapis margacarcärirmi apamongapaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gam paycunata ricaptiqui cärayquipis cushicuypita achicyaypa achicyangaraj.","poem":1},{"lineBreak":true},{"text":"Cushicuypita shonguyquipis ashac-ashacllaraj ricacongapaj.","poem":1},{"lineBreak":true},{"text":"Lamarcho cajcunatapis fiyupa cuestajcunatami apapämushunquipaj.","poem":1},{"lineBreak":true},{"text":"Nasyunnincunacho ima-aycanpis mas alli cajtami goycushunquipaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gam cajmanga röpa-röpami camëlluncunawan juntaycamongapaj.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga gorita, insinsuta apamur shamongapaj Madianpita, Efapita, Sabäpitapis.","poem":1},{"lineBreak":true},{"text":"Nircur paycunaga almiraypajcunata rurashäcunatami willacongapaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Cedarcho caj uyshacunatapis gampämi llapanta gatimongapaj.","poem":1},{"lineBreak":true},{"text":"Nebaiotcho caj carnicunanami gampa munayniquicho canga altarcho nogata garamänayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynami canga nogapa gustöpaj.","poem":1},{"lineBreak":true},{"text":"Chaura nogaga wasëtapis mas cuyayllapaj cananpämi camacächishaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«¿Picunataj tagay pucutayno aywarcaycämöga?","poem":1},{"lineBreak":true},{"text":"¿Picunataj tagay paluma puñunanman aywajno aywarcaycämöga?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaycunaga shuntacasha aywarcaycämoj büquicunami.","poem":1},{"lineBreak":true},{"text":"Ñaupa puntantanami Tarsis büquicuna aywaycämun.","poem":1},{"lineBreak":true},{"text":"Chay büquicunaga wamrayquicunatami gorintawan guellaynintawan-cama fiyupa carupita apaycämun.","poem":1},{"lineBreak":true},{"text":"Paycunaga aywaycämun Jerusalencho fiyupa almiraypajcunata rurashäpita aduramänanpämi.","poem":1},{"lineBreak":true},{"text":"Nogaga Israelcunapa Santo Tayta Diosninmi caycä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Nogaga rabyacurcurmi gamta castigarä.","poem":1},{"lineBreak":true},{"text":"Cananmi ichanga gamta cuyashäta musyachishayqui.","poem":1},{"lineBreak":true},{"text":"Chaymi pergayquicuna juchusha caycajtapis juc-lä nasyun runacuna allchanga.","poem":1},{"lineBreak":true},{"text":"Raynincunapis sirbishunquipaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chacaypa junajpapis puncuyquicunaga quicharaycangami.","poem":1},{"lineBreak":true},{"text":"Quicharaycanga intëru nasyuncho ima-ayca alli cajtapis apapämushunayquipämi.","poem":1},{"lineBreak":true},{"text":"Raycunapis garaynincunawanmi gam cajman yaycamongapaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gamcunata mana sirbishoj caj nasyun runacunaga illgächishami canga.","poem":1},{"lineBreak":true},{"text":"Chayno caj nasyun runacunaga ushajpämi wañuchisha canga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Libanucho riquësacuna caycajtaga gammanmi apamonga.","poem":1},{"lineBreak":true},{"text":"Apamonga pïnuta, abetota, sipresta.","poem":1},{"lineBreak":true},{"text":"Chaycunaga canga Templöta mas camarächinanpämi.","poem":1},{"lineBreak":true},{"text":"Chaynöpami chaquë lluchcarashan Temploga fiyupa rispitasha canga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ñacachishojcunapa wamrancunaga","poem":1},{"lineBreak":true},{"text":"rispitashushpayquimi ñaupayquiman chayamonga.","poem":1},{"lineBreak":true},{"text":"Manacajman churashojcunapis llapanmi","poem":1},{"lineBreak":true},{"text":"ñaupayquiman gongurpacongapaj.","poem":1},{"lineBreak":true},{"text":"Paycunaga ‹Israelpa Santo Tayta Diosninpa siudänin› nishunquipämi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Unayga cacharishami quëdarayqui.","poem":1},{"lineBreak":true},{"text":"Chiquishami carayqui.","poem":1},{"lineBreak":true},{"text":"Japallayquimi quëdarayqui.","poem":1},{"lineBreak":true},{"text":"Cananmi ichanga noga churashayquipaj imaycamapis allicho canayquipaj.","poem":1},{"lineBreak":true},{"text":"Para-simri cushisha goyänayquipämi camacächishaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Llapan nasyuncunami allinnin micuynincunata apapämushunquipaj.","poem":1},{"lineBreak":true},{"text":"Raycunanami riquësancunata apapämushunquipaj.","poem":1},{"lineBreak":true},{"text":"Chauraga tantiyacunquipämi noga Tayta Diosniqui salbashoj cashäta,","poem":1},{"lineBreak":true},{"text":"Jacob rispitashan Munayniyoj Dios gamta imapitapis jorgoj cashäta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Runsipa ruquinmi apapämushayqui gorita;","poem":1},{"lineBreak":true},{"text":"fyërrupa ruquinna guellayta;","poem":1},{"lineBreak":true},{"text":"guerupa ruquinna runsita;","poem":1},{"lineBreak":true},{"text":"rumipa ruquinna fyërruta.","poem":1},{"lineBreak":true},{"text":"Jauca goyayllanami cangapaj.","poem":1},{"lineBreak":true},{"text":"Alli cajta rurayllanami canga.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Marcayquichöga wañuchinacur gaparächinacushan manami wiyacanganachu.","poem":1},{"lineBreak":true},{"text":"Nasyunniquichöga ushacächinacuypis manami cangapänachu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga curral pergayquicunatami ‹Salbacoj› nir jutichapanquipaj.","poem":1},{"lineBreak":true},{"text":"Sawan puncuyquicunatana ‹Alabansa› nir jutichapanquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Manami nistanquipänachu junajpa inti achicyapäshunayquita,","poem":1},{"lineBreak":true},{"text":"ni quilla chacaypa achicyapäshunayquitapis.","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosnami cashaj imaycamapis achquiquino.","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosniquimi achicyapäshayqui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Noga intino captëmi mana chacanganachu.","poem":1},{"lineBreak":true},{"text":"Noga quillano captëmi mana chacanganachu.","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosniquimi cashaj imaycamapis achquiqui.","poem":1},{"lineBreak":true},{"text":"Llaquicuyga yapay manami canganachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Marcayquichöga alli runacunallanami tiyanga.","poem":1},{"lineBreak":true},{"text":"Chaychöga paycunallami imaycamapis tiyacongapaj.","poem":1},{"lineBreak":true},{"text":"Paycunami caycan lantashä lantapita chillguimojcunaga.","poem":1},{"lineBreak":true},{"text":"Paycunataga quiquëmi churashcä munayniyoj cashäta juccunata musyachinäpaj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chay ichiclla caycajmi waranganpa mirangapaj.","poem":1},{"lineBreak":true},{"text":"Wallcalla caycajmi munayniyoj nasyun canga.","poem":1},{"lineBreak":true},{"text":"Nogami Tayta Dios cä.","poem":1},{"lineBreak":true},{"text":"Nogami camacächishaj manapis aycällatana chayno cananpaj.","poem":1},{"lineBreak":true},{"text":"Nishä diyapäga chaynönami canga.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}