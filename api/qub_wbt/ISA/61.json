{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":61,"content":[{"type":"heading","content":["Israelcuna salbasha cananpaj willacushan"]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios acramasha captinmi","poem":1},{"lineBreak":true},{"text":"Tayta Diospa Espiritonga nogacho caycan.","poem":1},{"lineBreak":true},{"text":"Nogataga cachamasha pobricunata alli willacuyta willapänäpämi;","poem":1},{"lineBreak":true},{"text":"llaquisha caycajcunata cushicachinäpämi;","poem":1},{"lineBreak":true},{"text":"prësu caycajcunata librina cananpäna willapänäpämi;","poem":1},{"lineBreak":true},{"text":"carsilcho wichgaraycajcunatapis jorgunäpämi;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Dios cachamasha allita rurananpaj chayamushana cashanta willacunäpämi;","poem":1},{"lineBreak":true},{"text":"contranchïcunata ayñita cutichinanpaj chayamushantana willacunäpämi.","poem":1},{"lineBreak":true},{"text":"Chaynöpis Tayta Dios cachamasha llaquicuycajcunata shacyächinäpaj;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sioncho llaquicuycajcunata shoganäpaj:","poem":1},{"lineBreak":true},{"text":"pengacuycashanpa ruquin corönatana jatipänäpaj,","poem":1},{"lineBreak":true},{"text":"llaquicuycashanpa ruquin cushicuyta tarichinäpaj;","poem":1},{"lineBreak":true},{"text":"wagaycashanpa ruquin cushicur cantananpaj.","poem":1},{"lineBreak":true},{"text":"Chaymi paycunataga nengapaj «Sinchi guerucuna» nir.","poem":1},{"lineBreak":true},{"text":"Paycunaga caycangapaj Tayta Dios munayniyoj cashanta juccunata musyachinanpämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Unay juchuchishan ragäcunatapis yapaymi allchanga.","poem":1},{"lineBreak":true},{"text":"Unayna juchuchishan jatusaj wasicunatapis yapaymi perganga.","poem":1},{"lineBreak":true},{"text":"Juchusha caycaj ragällan siudäcunatapis jatarachengami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gamcunapataga juc-lä nasyun jäpa runacunami uywayquicunatapis michipäshunquipaj.","poem":1},{"lineBreak":true},{"text":"Chacrayquicunatawan übas chacrayquicunatapis arupäshunquipaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gamcunatanami «Tayta Diospa cürancuna»,","poem":1},{"lineBreak":true},{"text":"«Tayta Diosninchïta sirbejcuna» nishunquipaj.","poem":1},{"lineBreak":true},{"text":"Juc-lä nasyun runacunapa ima-aycanwanpis gamcunami quëdanquipaj.","poem":1},{"lineBreak":true},{"text":"Fiyupa chanin cuestaj adurnuncunatami camaränayquipaj churacunquipaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gamcunataga fiyupami ñacachishurayqui,","poem":1},{"lineBreak":true},{"text":"ashllir-ushashurayqui, fiyupa manacajman churashurayqui.","poem":1},{"lineBreak":true},{"text":"Chaypitami nasyunniquichönaga ishcay cutipa mastaraj fiyupa allita chasquinquipaj.","poem":1},{"lineBreak":true},{"text":"Nircurna imaycamapis cushishallana goyäcunquipaj.","poem":1}]},{"type":"verse","number":8,"content":["Chayga canga Tayta Dios cayno nishanpitami:",{"text":"«Nogaga alli rurajcunatami cuyä.","poem":1},{"lineBreak":true},{"text":"Suwacunata, wañuchicojcunataga chiquëmi.","poem":1},{"lineBreak":true},{"text":"Aunishänömi gamcunaga päguyquita chasquinqui.","poem":1},{"lineBreak":true},{"text":"Gamcunawan imaycamapis allilla cananchïpaj conträtutami rurashun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gamcunapita mirar aywajcunaga may nasyunchöpis fiyupa rejsishami canga.","poem":1},{"lineBreak":true},{"text":"Pï-may ricajpis paycunapäga nenga","poem":1},{"lineBreak":true},{"text":"‹Tayta Dios yanapashan runacunami› nir.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tayta Diosnëga salbamashami.","poem":1},{"lineBreak":true},{"text":"Llapanchöpis allichömi jorgamasha.","poem":1},{"lineBreak":true},{"text":"Chayno yanapämashanpitami cushicö.","poem":1},{"lineBreak":true},{"text":"Almäpis fiyupa cushicun.","poem":1},{"lineBreak":true},{"text":"Cananga caycä casarananpaj mösu alli rucacusha caycajnömi,","poem":1},{"lineBreak":true},{"text":"u casarananpaj caycaj jipash camaränanpaj bisticusha caycajnömi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Imanömi chacracho muru pashtamun,","poem":1},{"lineBreak":true},{"text":"wertachöpis imanömi lanta chillguir wiñan,","poem":1},{"lineBreak":true},{"text":"chaynömi Tayta Diosga camacächenga rasun caj alli ruraytana yapay gallaycunanpaj,","poem":1},{"lineBreak":true},{"text":"alabansacunatapis cantananpaj.","poem":1},{"lineBreak":true},{"text":"Chaytaga llapan nasyun runacunami ricanga, wiyanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}