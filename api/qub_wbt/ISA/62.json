{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":62,"content":[{"type":"heading","content":["Jerusalenpaj Tayta Diosta mañacushan"]},{"type":"verse","number":1,"content":[{"text":"Sión, gamta cuyashpämi upällallaga mana cacushächu.","poem":1},{"lineBreak":true},{"text":"Jerusalén, gamta cuyashpämi jamaytapis mana tarishächu","poem":1},{"lineBreak":true},{"text":"intërupa manaraj alli goyay cashancamaga;","poem":1},{"lineBreak":true},{"text":"Tayta Dios manaraj salbashushayquicamaga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Intëru nasyun runacunami ricanga allilla goyaycashayquita.","poem":1},{"lineBreak":true},{"text":"Llapan raycunami ricashunquipaj munayniyoj caycajta.","poem":1},{"lineBreak":true},{"text":"Chauraga quiquin Tayta Diosmi juc jutitana churapäshunquipaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diospa maquinchöga canquipaj ray jaticunanpaj caycaj corönanömi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Runacuna mananami yapayga «Cacharisha» nishunquipänachu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga «Tayta Dios fiyupa cuyashan» nishunquipänami.","poem":1},{"lineBreak":true},{"text":"Tiyashayqui partitapis mananami «Illgächisha» nenganachu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga «Tayta Diospa majan» nenganami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Imanömi juc mösu majachacan jipashwan,","poem":1},{"lineBreak":true},{"text":"chaynömi Diosga paypana canayquipaj shuntashunquipaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga cushishami caycangapaj warminwan runan cushisha goyashanno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jerusalén, curalaraj pergayquicunamanmi ricachacojcunata churashcä.","poem":1},{"lineBreak":true},{"text":"Paycunaga chacaypa junajpapis mana chawaypami nircaycanga:","poem":1},{"lineBreak":true},{"text":"«Tayta Diosta sirbejcunaga ama upällacaycäriychu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jerusalenta allchachiyta ushanancama;","poem":1},{"lineBreak":true},{"text":"intëru nasyun runacuna rispitanancama","poem":1},{"lineBreak":true},{"text":"Tayta Dios jamaycunanta ama dëjaychu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Diosga munayniyoj cashpanmi juraran. Jurar niran:","poem":1},{"lineBreak":true},{"text":"«Mananami imaypis camacächishänachu","poem":1},{"lineBreak":true},{"text":"rïguyquita chiquishojcuna apacunantaga,","poem":1},{"lineBreak":true},{"text":"ni ñacar rurashayqui bïnuyquita juc-lä runacuna upucurcunantapis.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaypa ruquenga quiquiquicunanami micuyniquita shuntar micunquipaj.","poem":1},{"lineBreak":true},{"text":"Übasniquicunatapis pallar shuntanquipaj.","poem":1},{"lineBreak":true},{"text":"Bïnuta rurashayquitapis quiquiquicunami upunquipaj.","poem":1},{"lineBreak":true},{"text":"Chayno rurashpayqui nogata alabamanquipaj rispitädu Templöpa sawan ruricho.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¡Siudäpa sawan puncucunapa llojshiy-llapa!","poem":1},{"lineBreak":true},{"text":"¡Runacuna purinanpaj nänita aruy!","poem":1},{"lineBreak":true},{"text":"Jatun nänita aruy-llapa.","poem":1},{"lineBreak":true},{"text":"Nänicho rumicuna caycajtapis jitariy-llapa.","poem":1},{"lineBreak":true},{"text":"Llapan nasyun runacuna musyananpaj señalta jawiy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Cay pachacho juc cuchupita juc cuchucamami","poem":1},{"lineBreak":true},{"text":"Tayta Diosga Sión siudäta willachisha:","poem":1},{"lineBreak":true},{"text":"«Salbashojniquega chayamushanami.","poem":1},{"lineBreak":true},{"text":"Juccunapa munaynincho caycajta guechurcurmi","poem":1},{"lineBreak":true},{"text":"Tayta Diosga acrashancunata shuntaycämun» nir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Israelcunapa jutintaga «Santo runacuna»,","poem":1},{"lineBreak":true},{"text":"«Tayta Dios salbashan runacuna» nengami.","poem":1},{"lineBreak":true},{"text":"Jerusalentanami «Fiyupa cuyay siudä»,","poem":1},{"lineBreak":true},{"text":"«Mana cachaycushan siudä» nenga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}