{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":63,"content":[{"type":"heading","content":["Contra cajcunata Tayta Dios castigashan"]},{"type":"verse","number":1,"content":[{"text":"«Juc runami Edomcho caycaj Bosra siudäpita aywaycämun.","poem":1},{"lineBreak":true},{"text":"Röpanpis pucaman tiñisha aywaycämun.","poem":1},{"lineBreak":true},{"text":"Achicyaypa achicyaycaj röpan jatisha aywaycämun.","poem":1},{"lineBreak":true},{"text":"Payga fiyupa munayniyojmi aywaycämun.","poem":1},{"lineBreak":true},{"text":"¿Piraj chay aywaycämöga?»","poem":1},{"lineBreak":true},{"text":"«Noga llapantapis alli arriglajmi aywaycämö.","poem":1},{"lineBreak":true},{"text":"Salbanäpäpis munayniyoj caycajmi aywaycämö.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«¿Imanirtaj röpayquega übasta bïnupaj lluchcajta pillchipashano puca caycan?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Japallämi übasta lluchcajno conträcunata ushashcä.","poem":1},{"lineBreak":true},{"text":"Manami pipis yanapämashachu.","poem":1},{"lineBreak":true},{"text":"Fiyupa rabyashami conträcunataga lluchcar-ushashcä.","poem":1},{"lineBreak":true},{"text":"Fiyupa ollgushami llapirishcä.","poem":1},{"lineBreak":true},{"text":"Chaymi yawarnenga röpäman pillchipämasha.","poem":1},{"lineBreak":true},{"text":"Röpätapis yawar tiñisha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nogaga maynami yarpaycarä juc junaj llapanpita jusganäpaj.","poem":1},{"lineBreak":true},{"text":"Acrashä runacunata salbanäpaj caj chayamushanami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ricachacurishpä manami pitapis ricarächu yanapämänanpaj shamojta.","poem":1},{"lineBreak":true},{"text":"Yanapämänanpaj pipis mana captin almirasha ricacurä.","poem":1},{"lineBreak":true},{"text":"Ichanga quiquëmi munayniyoj cashpä llapanchöpis alli llojshishcä.","poem":1},{"lineBreak":true},{"text":"Rabyallawanmi llapanta usharishcä.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fiyupa rabyasha cashpämi nasyuncunataga llapirishcä.","poem":1},{"lineBreak":true},{"text":"Fiyupa ollgusha carmi illgarachishcä.","poem":1},{"lineBreak":true},{"text":"Yawarninpis yacunörämi pampapa aywasha.»","poem":1}]},{"type":"heading","content":["Israelpaj Tayta Dios alli cashan"]},{"type":"verse","number":7,"content":[{"text":"Nogaga Tayta Dios cuyapäcoj cashantami parlayta munä.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga noganchïpaj ima-aycatapis rurashami.","poem":1},{"lineBreak":true},{"text":"Israel runacunata fiyupami cuyapasha.","poem":1},{"lineBreak":true},{"text":"Cuyacoj cashpan yanapämashanpitami payta alabayta munä.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Diosga niran: «Paycunaga acrashä runacunami.","poem":1},{"lineBreak":true},{"text":"Paycunaga manami gongaycamangachu.»","poem":1},{"lineBreak":true},{"text":"Chaymi Tayta Diosga salbaran.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Llapan ñacaycunapitami runacunataga salbaran.","poem":1},{"lineBreak":true},{"text":"Paycunata salbananpäga manami anjilnintachu cachamuran.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga quiquin Tayta Diosmi cuyapäcoj cashpan paycunata salbaran.","poem":1},{"lineBreak":true},{"text":"Paymi jatarcachishpan margacurcur shuntasha.","poem":1},{"lineBreak":true},{"text":"Imaypis chaynömi yanapasha.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chaypis paycunaga Tayta Diospa contranmi ricacuran.","poem":1},{"lineBreak":true},{"text":"Chaymi Santo Tayta Diosta rabyachiran.","poem":1},{"lineBreak":true},{"text":"Chaynöpami Tayta Diosga paycunapaj rabyacurcuran.","poem":1},{"lineBreak":true},{"text":"Nircur contran ricacur castigaran.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chayrämi paycunaga yarpäriran unay watacunacho imano cashantapis,","poem":1},{"lineBreak":true},{"text":"Moisés cashan wichan imano Tayta Dios salbashantapis.","poem":1},{"lineBreak":true},{"text":"Chaymi ninacuran:","poem":1},{"lineBreak":true},{"text":"«¿Maytaj uyshërunno caj Moiseswan acrashancunata lamarpita salbaj Dios?","poem":1},{"lineBreak":true},{"text":"¿Maychötaj caycan Moisesman Espíritu Santunta churäga?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Maychötaj caycan fiyupa munayninwan Moisesta yan'gaj?","poem":1},{"lineBreak":true},{"text":"¿Maychötaj caycan imaycamapis rejsisha cananpaj","poem":1},{"lineBreak":true},{"text":"lamar yacuta ishcayman raquirej Dios?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¿Maytaj acrashancunata lamarpa päsachej?","poem":1},{"lineBreak":true},{"text":"¿Maytaj chunyaj jircapa cawalluta mana lluchcacayllapa päsachejno acrashancunata pushamoj?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Uywacuna guechwa pampaman chayaycur alli guewacho cushicushannömi","poem":1},{"lineBreak":true},{"text":"Tayta Diospa Espiritunpis jamayta tarichiran.","poem":1},{"lineBreak":true},{"text":"Chayno alli jamananpämi acrashayqui runacunataga pushamurayqui.","poem":1},{"lineBreak":true},{"text":"Chayno rurashayquipitami munayniyoj cashayquita may-chaychöpis parlasha.»","poem":1}]},{"type":"heading","content":["Yanapänanpaj Tayta Diosta mañacushan"]},{"type":"verse","number":15,"content":[{"text":"Tayta Dios, fiyupa rispitädu particho tiyaycashayqui syëlupita-pacha ricäramuy ari.","poem":1},{"lineBreak":true},{"text":"¿Maytaj fiyupa cuyacoj cayniquiwan munayniyoj cayniquega?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj nogacunataga mana yarpämanquinachu?","poem":1},{"lineBreak":true},{"text":"¿Nogacunataga mananachu cuyapämanqui?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Gammi canqui nogacunapa papänë!","poem":1},{"lineBreak":true},{"text":"Abraham «manami wamrächu canqui» nimaptinpis,","poem":1},{"lineBreak":true},{"text":"Jacob nogacunata mana yarpämaptinpis","poem":1},{"lineBreak":true},{"text":"Tayta Dios, gamllami canqui nogacunapa papänëga.","poem":1},{"lineBreak":true},{"text":"Imaypis nogacunata yanapämäga gamllami canqui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Dios, ¿imanirtaj camacächishcanqui munashayquita ruraycashäpita gongaycärinäpäga?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj manana rispitanäpaj shongöcunatapis jucnöman ticrachishcanqui?","poem":1},{"lineBreak":true},{"text":"Acrashayqui runacuna caycaptëga, sirbishojniqui runacuna caycaptëga cuyapämashpayqui yanapaycamay ari.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Acrashayqui runacunaga goycushayqui nasyuncho wallca watallami tiyasha!","poem":1},{"lineBreak":true},{"text":"Cananga conträcunami Templuyquita pasaypa ganraycächin.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chaymi nogacunaga caycä imaypis mana mandashayqui nasyun runacunanöna,","poem":1},{"lineBreak":true},{"text":"imaypis mana alabashoj runacunanöna.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}