{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Ojalä syëluta quicharir urämunquiman.","poem":1},{"lineBreak":true},{"text":"Ricärishushpayqui puntacunapis chucchunmanmi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Contrayquicunataga ojalä urämushpayqui nina rupar cashacunata usharishanno rurarinquiman,","poem":1},{"lineBreak":true},{"text":"yacutapis nina timpurachishanno rurarinquiman.","poem":1},{"lineBreak":true},{"text":"Chauraga chay contrayquicuna musyanmanmi pï cashayquitapis.","poem":1},{"lineBreak":true},{"text":"Juc-lä nasyun runacunapis ñaupayquichöga mancharir sicsicyanmanmi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Urämushpayqui fiyupa manchariypäcunatami rurarayqui.","poem":1},{"lineBreak":true},{"text":"Gam urämuptiqui puntacunapis sicsicyaranmi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Unaypita-pachapis manami mayashcäcunachu gampita mas jucga dios cashanta.","poem":1},{"lineBreak":true},{"text":"Chaytaga manami wiyashcäcunachu.","poem":1},{"lineBreak":true},{"text":"Manami pipis ricashachu yäracojcunata dioscuna yanapashanta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gamga munanqui pipis cushisha alli cajllata ruranantami.","poem":1},{"lineBreak":true},{"text":"Chaynöpis munanqui gam munashayquita rurananpaj yarpachacojcunallatami.","poem":1},{"lineBreak":true},{"text":"Gamga rabyacurcushcanqui juchäcunapitami.","poem":1},{"lineBreak":true},{"text":"Unaypita-pachanami gamta rabyachir jucha rurayllacho nogacuna cashcä.","poem":1},{"lineBreak":true},{"text":"¿Imanöparaj nogacunaga salbacöman?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogacunaga llapäpis caycä ganra runanömi.","poem":1},{"lineBreak":true},{"text":"Allita rurashäcunapis ganra räpunömi caycan.","poem":1},{"lineBreak":true},{"text":"Llapanëpis caycä garwashtar öja yagashanömi.","poem":1},{"lineBreak":true},{"text":"Juchäcunami wayra apajnöpis mana alliman chayaycächiman.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pipis manami canchu gamta adurashöga.","poem":1},{"lineBreak":true},{"text":"Pipis manami yarpachacunchu gamman yäracamunanpäga.","poem":1},{"lineBreak":true},{"text":"Chaypitami nogacunapitaga pacacuycushcanqui.","poem":1},{"lineBreak":true},{"text":"Jucha rurashäcunapitami cachaycamashcanquipis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Imano casha captëpis Tayta Dios gammi canqui nogacunapa papänëga.","poem":1},{"lineBreak":true},{"text":"Nogacunaga cä mitullapitami. Gamnami canqui manca ruraj.","poem":1},{"lineBreak":true},{"text":"¡Llapanëpis cä gam ruramashallayquimi!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Dios, ama fiyupaga rabyacurcuychu ari.","poem":1},{"lineBreak":true},{"text":"Juchäcunatapis ama para-simriga yarparaychu ari.","poem":1},{"lineBreak":true},{"text":"¡Nogacunaga acrashayqui runacunami cä!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rispitädu siudäniquicunaga chunyajman ticrashami caycan.","poem":1},{"lineBreak":true},{"text":"Jerusalenga pasaypa juchusha ragällanmi caycan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Unay awilöcuna adurashushayqui","poem":1},{"lineBreak":true},{"text":"cuyayllapaj wasiquitapis","poem":1},{"lineBreak":true},{"text":"nina ruparmi ushacurcusha.","poem":1},{"lineBreak":true},{"text":"¡Mas cuyayllapaj cajcunataga llapantami illgarachisha!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chayno rurasha caycaptinpis ¿manachu imatapis ruranqui Tayta Dios?","poem":1},{"lineBreak":true},{"text":"¿Chayno rurasha caycaptinpis upällachuraj cacunqui?","poem":1},{"lineBreak":true},{"text":"¿Chaynöllachu imaypis fiyupa llaquicachimanqui?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}