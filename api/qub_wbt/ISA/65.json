{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":65,"content":[{"type":"heading","content":["Contran cajcunata Dios castigananpaj cashan"]},{"type":"verse","number":1,"content":["Tayta Dios caynömi nin:",{"text":"«Nogapaj mana yarpachacojcunatami yuripashcä.","poem":1},{"lineBreak":true},{"text":"Mana ashimajcuna tarimänanpämi camacächishcä.","poem":1},{"lineBreak":true},{"text":"Nogaman mana yäracamoj nasyun runacunatami","poem":1},{"lineBreak":true},{"text":"‹¡Shamuy! ¡Caychömi caycä!› nishcä.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Conträ ricacoj runacunatami witimunanpaj","poem":1},{"lineBreak":true},{"text":"goyay-goyay maquëta macyarashcä.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga quiquincuna munashannöllami","poem":1},{"lineBreak":true},{"text":"llutan caminupa aywarcaycan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chay runacunaga imay örapis rabyaycächimanmi.","poem":1},{"lineBreak":true},{"text":"Wertacunachömi dioscunapaj sacrifisyu uywacunata churan.","poem":1},{"lineBreak":true},{"text":"Ladrillupita pergashan altarchömi insinsutapis rupachin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Runacuna pamparaycashancunachömi paycunaga jamaran.","poem":1},{"lineBreak":true},{"text":"Pacäpacunachömi chacaycunapis waran.","poem":1},{"lineBreak":true},{"text":"Paycunaga cuchi aychatami micun.","poem":1},{"lineBreak":true},{"text":"Ganrayächicoj animalcunapa aychantami caldu mancancunawanpis yanucun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paycunaga waquinta nin: ‹Ama witimuychu. Nogataga ama yatamaychu.","poem":1},{"lineBreak":true},{"text":"Nogacunaga Dios acrashan juchaynajmi caycä› nir.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga mana upiypa nina rataptin","poem":1},{"lineBreak":true},{"text":"sengaman goshtay chayar goshgöchishannömi rabyachiman.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chay runacuna imanöpis rurashanga llapanmi nogapa ñaupächo isquirbiraycan.","poem":1},{"lineBreak":true},{"text":"Chaymi castigänillataga mana cachashächu.","poem":1},{"lineBreak":true},{"text":"Paycunataga castigashaj","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"quiquincunapa juchanpita, taytancunapa juchanpitapis.","poem":1},{"lineBreak":true},{"text":"Paycunaga puntacunacho insinsutapis rupachin.","poem":1},{"lineBreak":true},{"text":"Puytush lömacunachöpis ïdulucunata adurar rabyachimaj.","poem":1},{"lineBreak":true},{"text":"Chaypitami imanöpis rurashanman-tupu castigashaj.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"heading","content":["Bindisyunta gonanpaj Tayta Dios aunishan"]},{"type":"verse","number":8,"content":["Tayta Dios cayno nin:",{"text":"«Juc sartallatapis alli übasta tariycur runaga nin:","poem":1},{"lineBreak":true},{"text":"‹Manarämi mutushächu. Wayuycanrämi› nir.","poem":1},{"lineBreak":true},{"text":"Chaynöllami nogapis rurashaj wallcajlla caycaj sirbimajnëcuna-raycu.","poem":1},{"lineBreak":true},{"text":"Manami ushajpäga illgächishärächu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Israelpita mirajcunatami, Judäpita mirajcunatami acrashaj achca puntayoj nasyuncho tiyananpaj.","poem":1},{"lineBreak":true},{"text":"Chay sirbimajcunanami chay nasyuncho tiyanga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nogata yäracamaj runacunapami","poem":1},{"lineBreak":true},{"text":"Sarón guechwa pampachömi uyshancuna michicunan canga.","poem":1},{"lineBreak":true},{"text":"Acor guechwa pampachönami wäcancuna tiyanga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ichanga nogata gamcuna cachaycamashcanquimi.","poem":1},{"lineBreak":true},{"text":"Rispitädu jircätapis gongaycushcanquimi.","poem":1},{"lineBreak":true},{"text":"Gamcunaga ‹alli surtita tarichicoj diospaj› nirmi garaycanqui.","poem":1},{"lineBreak":true},{"text":"‹Alli distïnuta tarichicoj diospämi› nir bïnutapis jichapaycanqui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaypitami gamcunapa distïnuyquega canga sabliwan cuchuypa wañuchicänayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga päsashunquipaj noga gamcunata gayaptëpis mana wiyacushayquipitami,","poem":1},{"lineBreak":true},{"text":"willapaptëpis mana tantiyacushayquipitami.","poem":1},{"lineBreak":true},{"text":"Gamcunaga mana munashä cajtami rurashcanqui.","poem":1},{"lineBreak":true},{"text":"Noga mana munashä cajtami acrashcanquipis.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Chaymi Tayta Dios cayno nin:","poem":1},{"lineBreak":true},{"text":"«Sirbimajcunapäga micunanpaj cangami.","poem":1},{"lineBreak":true},{"text":"Gamcunami ichanga yargaycho canquipaj.","poem":1},{"lineBreak":true},{"text":"Sirbimajcunapaga upunanpäpis cangami.","poem":1},{"lineBreak":true},{"text":"Gamcunami ichanga yacunaypita ñacanquipaj.","poem":1},{"lineBreak":true},{"text":"Sirbimajcunaga cushicongapämi.","poem":1},{"lineBreak":true},{"text":"Gamcunami ichanga pengaycho canquipaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sirbimajcunaga llapan shongunpa cushicurmi cantangapaj.","poem":1},{"lineBreak":true},{"text":"Gamcunami ichanga fiyupa llaquicur ñacar waganquipaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sirbimajcunataga mushoj jutitami churapäshaj.","poem":1},{"lineBreak":true},{"text":"Gamcunapa jutiquitami ichanga rimangapaj pitapis maldisyunashpan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pipis cay nasyuncho bindisyunta goj cäga nogapa jutëchömi bindisyunta gonga.","poem":1},{"lineBreak":true},{"text":"Pipis cay nasyuncho rasunpa cajta jurashpan nogapa jutëchömi juranga.","poem":1},{"lineBreak":true},{"text":"Chayno canga unay ñacashancuna gongacasha captinmi.","poem":1},{"lineBreak":true},{"text":"Chaycunataga gongashcänami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Sumaj wiyamay.","poem":1},{"lineBreak":true},{"text":"Nogami camaj aywä syëluta y cay pachatapis mushojta.","poem":1},{"lineBreak":true},{"text":"Unay cajcunaga gongacashami canga.","poem":1},{"lineBreak":true},{"text":"Chaytaga manami pipis yarpangapänachu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ruranäpaj caycajpäga imaycamapis fiyupa cushicuy-llapa.","poem":1},{"lineBreak":true},{"text":"Mushoj Jerusalentami camashaj chaycho fiyupa cushicuy cananpaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Jerusalenpäga quiquëpis cushicushämi.","poem":1},{"lineBreak":true},{"text":"Acrashä runacunapäpis fiyupami shongöchöga cushicushaj.","poem":1},{"lineBreak":true},{"text":"Paycunaga manami waganganachu.","poem":1},{"lineBreak":true},{"text":"Ni llaquicuypis manami canganachu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chaychöga wamracunapis yurircullarga manami wañonganachu.","poem":1},{"lineBreak":true},{"text":"Auquincunapis cawanga alli wañuypa wañunanyajmi.","poem":1},{"lineBreak":true},{"text":"Pachac watayoj caycashancho wañorga wañonga mösullaraj caycashpanmi.","poem":1},{"lineBreak":true},{"text":"Manaraj pachac watamanpis chayallar wañojtaga ‹maldisyunädumi casha› nengami.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Runacunaga wasinta arurcachir chaychömi tiyanga.","poem":1},{"lineBreak":true},{"text":"Übasta lantar wayuynintapis micongami.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wasitapis aronga quiquinpämi, manami juc runa tiyananpänachu.","poem":1},{"lineBreak":true},{"text":"Übastapis manami lantangachu wayuyninta juc runa micunallanpäga.","poem":1},{"lineBreak":true},{"text":"Guerucuna unaycama mana chaquishannömi acrashä runacunapis unaycama cawanga.","poem":1},{"lineBreak":true},{"text":"Acrashä runacunaga arur tarishanwanmi cushisha goyangapaj.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Paycuna manami yangallapäga arongachu.","poem":1},{"lineBreak":true},{"text":"Wamrancunapis manaraj auquinyarga manami wañongachu.","poem":1},{"lineBreak":true},{"text":"Chaynöga paycuna canga noga bindisyunta goshä runacunapita miraj cashpanmi.","poem":1},{"lineBreak":true},{"text":"Paycunapita mirar aywajcunapis chaynömi cawangapaj.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Paycuna manaräpis mañacamaptinmi","poem":1},{"lineBreak":true},{"text":"Nogaga mayna yanapaycäshaj.","poem":1},{"lineBreak":true},{"text":"Manaräpis rimayta ushaptin","poem":1},{"lineBreak":true},{"text":"Nogaga maynami wiyashana caycäshaj.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Uyshawan atojpis juc pachallachömi goyanga.","poem":1},{"lineBreak":true},{"text":"Liyunpis wäcanömi guewata miconga.","poem":1},{"lineBreak":true},{"text":"Culebranami allpata miconga.","poem":1},{"lineBreak":true},{"text":"Rispitädu jircächöga alli goyayllanami canga.»","poem":1},"Tayta Diosmi chayno nisha."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}