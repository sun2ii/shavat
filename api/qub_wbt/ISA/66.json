{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":66,"content":[{"type":"heading","content":["Tayta Diosta mana rispitajcuna imano cashanpis"]},{"type":"verse","number":1,"content":["Tayta Dios cayno nin:",{"text":"«Syëluga jamanämi.","poem":1},{"lineBreak":true},{"text":"Mundu allpanami chaquë lluchcaränan.","poem":1},{"lineBreak":true},{"text":"Chayno caycaptëga ¿maychöraj wasita aruchipämanman?","poem":1},{"lineBreak":true},{"text":"¿Maychöraj jamaycunäpaj rurachipämanman?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Llapantapis nogami rurashcä.","poem":1},{"lineBreak":true},{"text":"Chaynöpami llapanpis caycan.»","poem":1},"Tayta Diosmi chayno nisha.",{"lineBreak":true},{"text":"«Chaypis nogaga cuyapar yanapä,","poem":1},{"lineBreak":true},{"text":"pobri cajtami, llaquisha caycajtami,","poem":1},{"lineBreak":true},{"text":"Noga nishäcunata manchapacur cumlejcunatami.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Waquin runacunami ichanga aduramashpan töruta rupachinanpaj pishtan.","poem":1},{"lineBreak":true},{"text":"Runa-masintapis wañuchin.","poem":1},{"lineBreak":true},{"text":"Uyshata nogapaj pishtan.","poem":1},{"lineBreak":true},{"text":"Allgutapis cuncanta milluypa wañuchin.","poem":1},{"lineBreak":true},{"text":"Chaqui micuy ofrendancunatapis nogapaj churan.","poem":1},{"lineBreak":true},{"text":"Nircorga cuchipa yawarnintapis churan.","poem":1},{"lineBreak":true},{"text":"Aduramashpan insinsutapis rupachin.","poem":1},{"lineBreak":true},{"text":"Nircorga ïdulucunatapis aduran.","poem":1},{"lineBreak":true},{"text":"Chayno melanaypajcunata rurananpaj acrajcunaga","poem":1},{"lineBreak":true},{"text":"chaycunata rurashpan fiyupa cushicun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayno rurajcunapäga nogapis ñacananpämi acrashaj.","poem":1},{"lineBreak":true},{"text":"Chaymi paycunamanga fiyupa manchacushan cajtaraj chayachishaj.","poem":1},{"lineBreak":true},{"text":"Chayno cananpäga camacächishaj","poem":1},{"lineBreak":true},{"text":"gayaptëpis mana wiyamashanpitami,","poem":1},{"lineBreak":true},{"text":"willapaptëpis mana tantiyacushanpitami.","poem":1},{"lineBreak":true},{"text":"Paycunaga mana gustashä cajtami rurasha.","poem":1},{"lineBreak":true},{"text":"Noga mana munashä cajtami acrashapis.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tayta Dios nishanta manchacojcunaga","poem":1},{"lineBreak":true},{"text":"pay nishanta wiyay-llapa:","poem":1},{"lineBreak":true},{"text":"«Nogata rispitamashayquipita chiquishoj, gaticachäshoj marca-masiquicunaga","poem":1},{"lineBreak":true},{"text":"asipäshushpayqui nircaycan:","poem":1},{"lineBreak":true},{"text":"‹Mä Tayta Dios munayninta musyachimäshun.","poem":1},{"lineBreak":true},{"text":"Mä ñacashpayquipis cushisha goyay› nir.","poem":1},{"lineBreak":true},{"text":"Ichanga chayno nishojcuna fiyupa pengaychömi cangapaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Masqui wiyay-llapa siudächo gaparaypa rimaycämushanta.","poem":1},{"lineBreak":true},{"text":"Wiyay-llapa quiquin Templuchöpis gaparaypa rimaycämushanta.","poem":1},{"lineBreak":true},{"text":"Wiyay-llapa rurashanman-tupu conträcunata noga imano castigaycashätapis.","poem":1}]},{"type":"heading","content":["Mushoj Jerusalén yurinanpaj cashan"]},{"type":"verse","number":7,"content":[{"text":"«Gueshyacunanpaj manaräpis nanay chariptinmi ollgu wamrata illajpita gueshyacurisha.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¿Pillaga wiyashachuraj imayllapis chayno cashanta?","poem":1},{"lineBreak":true},{"text":"¿Pillaga ricashachuraj imayllapis chayno päsashanta?","poem":1},{"lineBreak":true},{"text":"¿Juc junajllacho miranmanchuraj juc nasyunpaj aypajpaj?","poem":1},{"lineBreak":true},{"text":"¿Juc yuriyllacho yuririnmanchuraj juc nasyunpaj aypaj?","poem":1},{"lineBreak":true},{"text":"Chaynömi Sionga nanay charircushan öra","poem":1},{"lineBreak":true},{"text":"wamrancunata gueshyacurisha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yurinanpaj noga camacächej caycarga ¿imanöpataj michäman caran yurinanta?»","poem":1},"Tayta Diosniquimi chayno nisha."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Jerusalenta cuyaj cajcunaga llapayqui paywan iwal cushicuy.","poem":1},{"lineBreak":true},{"text":"Paypaj wagasha cashpayquega llapayqui paywan iwal cushicuy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paynami mamayquinöpis","poem":1},{"lineBreak":true},{"text":"micuyta garajno jauca goyächir cushicachishunquipaj","poem":1},{"lineBreak":true},{"text":"gamcuna sacsashano canayquiyaj.»","poem":1}]},{"type":"verse","number":12,"content":["Chayno cananpäga Tayta Diosmi nin:",{"text":"«Nogami camacächishäpaj mayu aypalla chayajno","poem":1},{"lineBreak":true},{"text":"Jerusalencho alli goyay cananpaj.","poem":1},{"lineBreak":true},{"text":"Chaynömi Jerusalenmanga juc-lä nasyuncunapa ima-aycanpis","poem":1},{"lineBreak":true},{"text":"mayu chayashpan yaycojnöraj aypallanpa chayangapaj.","poem":1},{"lineBreak":true},{"text":"Chauraga Jerusalenmi gamcunata garashunquipaj.","poem":1},{"lineBreak":true},{"text":"Paymi margaräshunquipaj.","poem":1},{"lineBreak":true},{"text":"Gongurninman jamarcachirmi cuyashunquipaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Imanömi wamranta maman shogan,","poem":1},{"lineBreak":true},{"text":"chaynömi gamcunata nogaga shogashayquipaj.","poem":1},{"lineBreak":true},{"text":"Jerusalenchömi alli goyaytapis tarinquipaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Chayno caycajta ricashpayquega fiyupami cushicunquipaj.","poem":1},{"lineBreak":true},{"text":"Tamya wichan jacha chillguejnörämi cuerpuyquicunapis ricaconga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi munayninta musyachenga payta sirbejcunataga.","poem":1},{"lineBreak":true},{"text":"Paypa contran cajcunatanami rabyaycashanta musyachenga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Diosga nina ratataycajchömi chayamongapaj.","poem":1},{"lineBreak":true},{"text":"Carrëtancunapis caycan shucucuy wayra gachwaycajnömi.","poem":1},{"lineBreak":true},{"text":"Payga fiyupa rabyasha cashpanmi nina ratataycajwanraj runacunata castigangapaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tayta Diosga llapan runacunatami ninawan castiganga.","poem":1},{"lineBreak":true},{"text":"Espädanta aptacurcurmi llapanta jusgangapaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami Tayta Dios castigaptin aypalla runa wañongapaj.","poem":1}]},{"type":"verse","number":17,"content":["Tayta Dios cayno nin: «Gatinayllanpa wertacunaman aywananpaj limyuyaycajcuna, cuchi aychata, ucush aychata micojcuna, u ima animaltapis ganra cajta micojcunaga llapanmi illgächisha canga."]},{"type":"verse","number":18,"content":["Noga musyämi imano rurashantapis imano yarpaycashantapis. Chayamongapänami llapan nasyun runacunata, ima rimayta parlajcunatapis juc pachaman shuntanäpaj junaj. Paycunami shamushpan imano munayniyoj cashätapis ricamangapaj."]},{"type":"verse","number":19,"content":["Nogami señalta ricachishaj. Waquintaga juc-lä nasyuncunamanmi chayachishaj. Chayanga Tarsisman, Libiaman, Lidiaman, (chay nasyuncho tiyajcunaga fiyupami yachan lëchawan illapayta), Tubalman, Greciaman. Waquintanami chayachishaj fiyupa caru lamar cantuncho caycaj nasyuncunamanpis. Chay nasyun runacunaga manami imaypis wiyashachu casha nogapaj parlajta. Manami ricashachu casha munaynëwan rurashäcunatapis. Chayman chayajcunami munayniyoj cashäta chay nasyuncunacho willacongapaj."]},{"type":"verse","number":20,"content":["Gamcuna casta cajtaga llapantami intëru nasyuncunapita pushamongapaj. Shamongapaj cawalluwan, carrëtacunawan, wintuypa apana andascunawan, mülacunawan, camëllucunawanpis. Rispitädu jircä Jerusalencho paycuna canga nogapaj ofrendanömi. Limyu wiñacunawan ofrendata Templöman Israelcuna apamushannömi canga. Noga Tayta Diosmi chayno nishcä."]},{"type":"verse","number":21,"content":["«Paycunatami waquintaga acrashäpaj cüracuna cananpaj, cüracunata yanapaj Leví runacunano Templöcho arunanpaj. Noga Tayta Diosmichayno në.»"]},{"type":"line_break"},{"type":"verse","number":22,"content":["Mastapis Tayta Diosga nin:",{"text":"«Mushoj syëlutawan mushoj pachata camanäpaj caycajcuna imaycamapis mana ushacaj","poem":1},{"lineBreak":true},{"text":"cashannömi gamcunapita mirajcunapis canga.","poem":1},{"lineBreak":true},{"text":"Jutiquipis imaycamapis yarpasha canga.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Cada quillami, llullu quilla cashan junajcho,","poem":1},{"lineBreak":true},{"text":"cada semäna, säbadu jamay junajchöpis","poem":1},{"lineBreak":true},{"text":"llapan runacuna shamongapaj nogata rispitamashpan ñaupächo gongurpacunanpaj.»","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Chayno shamushpanmi ricangapaj","poem":1},{"lineBreak":true},{"text":"Nogapa conträ jatarejcunataga wañusha carcaycajta.","poem":1},{"lineBreak":true},{"text":"Chay runacunata micoj curucunaga mana wañojmi.","poem":1},{"lineBreak":true},{"text":"Rupaj ninapis mana imaypis upejmi.","poem":1},{"lineBreak":true},{"text":"¡Chayga llapan runacunapäpis fiyupa melanaypämi canga!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}