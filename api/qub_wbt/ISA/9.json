{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ISA","translationId":"qub_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"8be38a50b28a5f7fa0a8df7df3d48fa7e42756161ee45b5d146e0f80160fff32","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/qub_wbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":9,"content":[{"type":"heading","content":["Tayta Dios acrashan yurinanpaj cashan"]},{"type":"verse","number":1,"content":["Canan ñacaycajcunapämi ichanga manana ñacay canganachu. Ñaupataga Tayta Dios manacajmanmi churaran Zabulón runacunawan Neftalí runacuna tiyashanta. Shamoj watacunachömi ichanga Jordán mayupa chimpancho, lamar cuchuncho caycaj Galilea marca fiyupa rejsisha cananpaj camacächenga. Chay partiga caycan mana Israelcuna tiyashan partimi."]},{"type":"verse","number":2,"content":[{"text":"Chacaycho puriycajcunami achicyajta ricärisha.","poem":1},{"lineBreak":true},{"text":"Yanauyaycajcho tiyaycajcunapämi achicyacurcusha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios gammi achca runa cananpaj mirachishcanqui.","poem":1},{"lineBreak":true},{"text":"Fiyupa cushicuy cananpäpis camacächishcanqui.","poem":1},{"lineBreak":true},{"text":"Cosëcha wichan cushicushannöraj gampa ñaupayquicho llapan cushicun.","poem":1},{"lineBreak":true},{"text":"Riquësacunata raquipänacur cushicushannörämi cushicun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cushicuy caycan ñacaycajcunata Madián runacunapa munayninpita jorgushayquipitami.","poem":1},{"lineBreak":true},{"text":"Chaynömi acrashayqui runacunataga salbashcanqui mandaj ñacachiptin","poem":1},{"lineBreak":true},{"text":"fiyupa ñacaycho caycajta, fiyupa llaquicuycho caycajta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cushicuy caycan suldärucuna jaticushan bötasnincunatapis manana nistaptin,","poem":1},{"lineBreak":true},{"text":"guërracho pillyananpaj caj yawar töpasha röpancunatapis rupachinanpaj captin.","poem":1},{"lineBreak":true},{"text":"Ninami ushajpaj rupanga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Cushicuy caycan juc wamra noganchïcho yurishanpitami.","poem":1},{"lineBreak":true},{"text":"Juc wamratami Tayta Dios gomashcanchi.","poem":1},{"lineBreak":true},{"text":"Paytami munayninta gosha mandananpaj.","poem":1},{"lineBreak":true},{"text":"Paytami pï-maypis rejsenga:","poem":1},{"lineBreak":true},{"text":"«Almiraypaj tantiyachicoj» nir,","poem":1},{"lineBreak":true},{"text":"«Binsej Dios» nir,","poem":1},{"lineBreak":true},{"text":"«Para-simri cawaj Tayta» nir,","poem":1},{"lineBreak":true},{"text":"«Alli goyayta tarichicoj mandaj» nir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ray David jamashanmanmi jamaycongapaj.","poem":1},{"lineBreak":true},{"text":"Payga llapantami mandanga.","poem":1},{"lineBreak":true},{"text":"Alli goyayga manami ushacanganachu.","poem":1},{"lineBreak":true},{"text":"Imaycamapis payllanami mandanga.","poem":1},{"lineBreak":true},{"text":"Pay mandarga rasun cajta, alli cajllatami","poem":1},{"lineBreak":true},{"text":"imaycamapis ruranga.","poem":1},"Chaynöga ruranga munayniyoj Tayta Dios fiyupa cuyamashpanchïmi."]},{"type":"heading","content":["Israel nasyunpaj Tayta Dios rabyar rimashan"]},{"type":"verse","number":8,"content":[{"text":"Tayta Diosga juc willapatami willachisha","poem":1},{"lineBreak":true},{"text":"Jacobpita mirar aywaj Israel runacunata.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaytaga Samariacho tiyaj Efraín runacuna llapanmi tantiyan.","poem":1},{"lineBreak":true},{"text":"Ichanga paycuna alli-tucushpan cayno nin:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"«Adöbipita cajcuna juchucäcushami.","poem":1},{"lineBreak":true},{"text":"Cananga ladrilluwannami jatarachishun.","poem":1},{"lineBreak":true},{"text":"Shauya guerullawan tirantincuna casha captin, tunisha captin,","poem":1},{"lineBreak":true},{"text":"noganchëga rucachir churashun sedru guerucunatana» nir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chayno cashanpitami cay nasyunmanga Tayta Dios cachamusha fiyupa chiquejcunata.","poem":1},{"lineBreak":true},{"text":"Quiquin Tayta Diosmi camacächisha magaj yaycamunanpäpis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Inti yagamunan caj-läpitaga chayasha Asiria runacuna.","poem":1},{"lineBreak":true},{"text":"Inti yaganan caj-läpitana chayasha Filistea runacuna.","poem":1},{"lineBreak":true},{"text":"Paycunami Israel runacunataga micuyta juc amuyta micucurcojnölla usharisha.","poem":1},{"lineBreak":true},{"text":"Chaypis Tayta Dios rabyashanga manami päsacanrächu.","poem":1},{"lineBreak":true},{"text":"Payga jinallarämi castigananpaj rimaycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Chayno castigaycaptinpis runacunaga manami wanacuranchu.","poem":1},{"lineBreak":true},{"text":"Ni munayniyoj Tayta Diosmanpis manami yäracuranchu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chaypitami Tayta Diosga juc junajllacho Israelpa umantawan chupanta rogurenga.","poem":1},{"lineBreak":true},{"text":"Chucru palmatawan shauya utututapis muturenga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Animalpa umanman tincuchishanga caycan rispitädu runacunawan mandajcunami.","poem":1},{"lineBreak":true},{"text":"Chupanman tincuchishanga caycan llulla profëtacunami.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chay mandajcunaga engañacojcunami.","poem":1},{"lineBreak":true},{"text":"Tantiyachinanta munajcunapis pantacashami carcaycan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaypitami Tayta Diosga mösucunata mana cuyapashachu.","poem":1},{"lineBreak":true},{"text":"Wacchacunata ni biyüdacunatapis mana cuyapashachu.","poem":1},{"lineBreak":true},{"text":"Chayno mana cuyapashachu llapanpis mana yäracojlla, mana allita rurajcunalla cashanpita,","poem":1},{"lineBreak":true},{"text":"llapanpis manacajcunallata parlashanpitami.","poem":1},{"lineBreak":true},{"text":"Chaypis, Tayta Dios rabyashanpitaga manami allchacanrächu.","poem":1},{"lineBreak":true},{"text":"Payga jinallarämi castigananpaj rimaycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mana allita munayga ninanömi.","poem":1},{"lineBreak":true},{"text":"Ninaga shatata cashatapis ushacurcunmi.","poem":1},{"lineBreak":true},{"text":"Munti guerucunatapis rupacurcunmi.","poem":1},{"lineBreak":true},{"text":"Chayno rupaptin goshtayninpis janajpa tumarcur-tumarcur jatarin.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Dios fiyupa rabyasha captinmi","poem":1},{"lineBreak":true},{"text":"nasyuntaga nina rupaycan.","poem":1},{"lineBreak":true},{"text":"Ninaga rupar ushacurcun runacunata.","poem":1},{"lineBreak":true},{"text":"Runacunapis runa-masinta mana cuyapannachu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Quiquinpa wamrancunata cada-ünun micucarcärin.","poem":1},{"lineBreak":true},{"text":"Jucaj läduncho caycajta ultayllapa micucurcurpis yargaycanraj.","poem":1},{"lineBreak":true},{"text":"Yapay jucaj läduncho caycajta micucurcurpis manami sacsanchu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Manasés runacunaga Efraín runacunata magarcaycan.","poem":1},{"lineBreak":true},{"text":"Efraín runacunapis Manasés runacunata magarcaycan.","poem":1},{"lineBreak":true},{"text":"Nircur ishcan aywan Judá runacunata magananpaj.","poem":1},{"lineBreak":true},{"text":"Chaypis, Tayta Dios rabyashanpitaga manami allchacanrächu.","poem":1},{"lineBreak":true},{"text":"Payga jinallarämi castigananpaj rimaycan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}