ami chucchuran.","poem":1},{"lineBreak":true},{"text":"Syëlupis cuyuriranmi.","poem":1},{"lineBreak":true},{"text":"Pucutaypis tamyamuranmi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Israelcuna rispitashan Tayta Diospa ñaupanchöga","poem":1},{"lineBreak":true},{"text":"llapan jircacunapis chucchuranmi.","poem":1},{"lineBreak":true},{"text":"Sinaí puntapis chucchuranmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Anatpa wamran Samgar cashan wichanpis,","poem":1},{"lineBreak":true},{"text":"Jael cashan wichanpis carupa puriyta manchacojmi.","poem":1},{"lineBreak":true},{"text":"Caminanticunapis mananami näninpaga purirannachu.","poem":1},{"lineBreak":true},{"text":"Juc-läpanami puriran.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel castapa chacranpitaga","poem":1},{"lineBreak":true},{"text":"llapanmi aywacuran.","poem":1},{"lineBreak":true},{"text":"Chayno caycajta ricarmi noga Deboraga","poem":1},{"lineBreak":true},{"text":"Israelcunapa mamannöpis jatarishcä.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Israelcuna juc dioscunatana aduraptenga","poem":1},{"lineBreak":true},{"text":"guërra jananchöna ricacoj.","poem":1},{"lineBreak":true},{"text":"Ichanga Israelcuna chuscu chunca waranga (40,000) captinpis","poem":1},{"lineBreak":true},{"text":"chapacuna escüdun ni lansanpis ni jucnayllapis manami caranchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Nogaga llapan shongöpami cushicö","poem":1},{"lineBreak":true},{"text":"Israelcunapa mandajnincunapaj,","poem":1},{"lineBreak":true},{"text":"pillyaj aywaj marca-masëcunapaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta llapayqui alabay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Rïcucunapis pobricunapis cantay.","poem":1},{"lineBreak":true},{"text":"Caminanticunapis cantay.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Uywata michicur goturpashpayquipis willacuy Tayta Dios binsishantaga.","poem":1},{"lineBreak":true},{"text":"Israelcuna binsishanta cushicur willacuy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Ricchay, jatariy Débora.","poem":1},{"lineBreak":true},{"text":"Juc birsuta cantay.","poem":1},{"lineBreak":true},{"text":"Abinoampa wamran Barac","poem":1},{"lineBreak":true},{"text":"prësuyquicunata apacuy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Chaymi mandajnincunaga Israelcunawan pillyaman aywaran.","poem":1},{"lineBreak":true},{"text":"Aywaran fiyupa munayniyoj chiquejcunawan pillyananpämi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Efraín trïbu waquenga aywaran pampaman.","poem":1},{"lineBreak":true},{"text":"Paycunapa guepantami aywaran Benjamín trïbu suldärucunapis.","poem":1},{"lineBreak":true},{"text":"Maquir castapa mandajnincunapis,","poem":1},{"lineBreak":true},{"text":"Zabulón trïbu autoridäcunapis aywaran.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Isacar trïbu mandajcunapis Deborawan aywaran.","poem":1},{"lineBreak":true},{"text":"Baractaga yanaparan Isacar trïbumi.","poem":1},{"lineBreak":true},{"text":"Paycunami guepanta pampaman aywaran.","poem":1},{"lineBreak":true},{"text":"«Rubén trïbucunachömi ichanga","poem":1},{"lineBreak":true},{"text":"jucta-jucta yarpar apänacuran.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pillyaman aywananpa ruquin","poem":1},{"lineBreak":true},{"text":"uyshancunata ricar goyäcuran.","poem":1},{"lineBreak":true},{"text":"Rubén trïbucunachöga jucta-jucta yarpar apänacuran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Galaad castacunaga Jordán mayupa chimpanchömi","poem":1},{"lineBreak":true},{"text":"pachacaraycar quëdasha.","poem":1},