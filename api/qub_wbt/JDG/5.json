rue},{"text":"Sísara yacuta mañacuptin Jaelga lëchita goycuran.","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj tasunwan mas alli caj lëchitami goycuran.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nircorga jucaj maquinwan istägata aptarcur","poem":1},{"lineBreak":true},{"text":"jucaj maquinwan mäsuta aptarcur","poem":1},{"lineBreak":true},{"text":"Sisarata umapa labityapaycuran.","poem":1},{"lineBreak":true},{"text":"Chauraga uma tullunta paquirir togshunpa päsariran.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Sisaraga gochpar atipacuycaran Jaelpa ñaupancho.","poem":1},{"lineBreak":true},{"text":"Atipacuycällarmi pampaman yagaran.","poem":1},{"lineBreak":true},{"text":"Yagashallanchöna wañucäcuran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Sisarapa mamannami llaquicushpan bentänapa ricchacushpan nin:","poem":1},{"lineBreak":true},{"text":"‹¿Imanirtaj mana chayamunchu carrëtan?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj guepacämun pillyapaj carrëtan?›","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Niptin waquin musyaj yachaj warmicunapis,","poem":1},{"lineBreak":true},{"text":"quiquinpis nin:","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"‹Pillyar binsishpan imatapis guechushancunatami raquipänacuycanga.","poem":1},{"lineBreak":true},{"text":"Suldärucunaga jucta-camachari ishcayta-camachari uywayninpaj warmita raquipänacuycan.","poem":1},{"lineBreak":true},{"text":"Sisarapäga canga achca culur tëlacuna.","poem":1},{"lineBreak":true},{"text":"Burdasha juc ishcay cuyayllapaj pañuylucunami binsej wallgacunanpaj canga.›","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«Tayta Dios, chiquishoj cäga","poem":1},{"lineBreak":true},{"text":"llapanpis chaynölla ushacächun.","poem":1},{"lineBreak":true},{"text":"Gamta cuyashoj cajcuna ichanga","poem":1},{"l