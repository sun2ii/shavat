{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":10,"content":[{"type":"heading","content":["Ïdulucuna mana bälej cashan, Dios munayniyoj cashan"]},{"type":"verse","number":1,"content":["Tayta Dios willapäshushayquita wiyacuy Israel runacuna."]},{"type":"verse","number":2,"content":["Tayta Dios caynömi nin:",{"text":"«Juc-lä nasyun runacuna rurashanno gamcunaga ama ruraychu.","poem":1},{"lineBreak":true},{"text":"Chay nasyun runacunaga janaj syëlucho imapis yuriptin fiyupa mancharin.","poem":1},{"lineBreak":true},{"text":"Gamcuna ichanga ama manchariychu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chay runacuna riguishanga manacajllami.","poem":1},{"lineBreak":true},{"text":"Paycunaga munti guerutami mutun.","poem":1},{"lineBreak":true},{"text":"Nircur llagllayta yachaj runawan ima-nirajtapis llagllachin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Llagllashan jananpana goriwan guellaywan chapyan.","poem":1},{"lineBreak":true},{"text":"Rurashan mana yagananpäga martilluwan tacaypa labityan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chay ïdulucunaga caycan nunayllucunata ichichishannöllami.","poem":1},{"lineBreak":true},{"text":"Chaycunaga manami rimanchu.","poem":1},{"lineBreak":true},{"text":"Chaycunataga apariyparaj apan.","poem":1},{"lineBreak":true},{"text":"Quiquillanga manami aywanchu.","poem":1},{"lineBreak":true},{"text":"Chaytaga ama manchacuychu.","poem":1},{"lineBreak":true},{"text":"Pitapis manami imatapis ruranchu allita ni mana allitapis.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tayta Dios, gamnöga manami pipis canchu.","poem":1},{"lineBreak":true},{"text":"Gamga munayniyojmi canqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gamga nasyuncunapa rayninmi canqui.","poem":1},{"lineBreak":true},{"text":"Gamtaga llapanmi manchacushunqui.","poem":1},{"lineBreak":true},{"text":"Gamtaga pï-maypis manchacushunayquimi camacan.","poem":1},{"lineBreak":true},{"text":"Cay munducho caj raycunapis, ni yachajcunapis manami gamnöga canchu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Paycunaga llapanpis yarpayniynajllami.","poem":1},{"lineBreak":true},{"text":"Manami tantiyayta atipanchu.","poem":1},{"lineBreak":true},{"text":"Llagllasha gueruga paycunata manami imatapis yachachinchu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Paycunapa ïduluncunaga caycan Tarsispita apamushan guellaywan chapyashallami,","poem":1},{"lineBreak":true},{"text":"Ufazpita apamushan goriwan chapyashallami.","poem":1},{"lineBreak":true},{"text":"Chay ïdulucunataga llagllay yachajcunallami, ruray yachajcunallami rurasha.","poem":1},{"lineBreak":true},{"text":"Murädupitawan puca tëlapita jirasha röpacunata jatiraycan.","poem":1},{"lineBreak":true},{"text":"Chay ïdulucunaga llapanpis caycan yachaj runa rurashallanmi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Diosninchïmi ichanga rasunpa Dios caycan.","poem":1},{"lineBreak":true},{"text":"Paymi caycan cawaj Dios, imaycamapis mana rucaj Ray.","poem":1},{"lineBreak":true},{"text":"Pay rabyacurcuptenga cay pacha sicsicyanmi.","poem":1},{"lineBreak":true},{"text":"Pay rabyaptenga manami ima nasyunpis awantanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Ïdulucunata adurajcunata cayno niy: «Cay pachatapis syëlutapis mana ruraj dioscunaga llapanmi cay pachapita illganga. Ni jucnayllapis cay pachachöga manami cangapänachu.»"]},{"type":"heading","content":["Tayta Diosta alabar cantashan"]},{"type":"verse","number":12,"content":[{"text":"Tayta Diosmi munayninwan cay pachata camasha.","poem":1},{"lineBreak":true},{"text":"Fiyupa yachaj cayninwan cay munduta tacyachisha.","poem":1},{"lineBreak":true},{"text":"Yarpaysapa cayninwan syëlutapis camacächisha.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Räyuno busninwanmi syëlucho caycaj yacuta gaparächin.","poem":1},{"lineBreak":true},{"text":"Pucutaytapis pampapita jatarachin.","poem":1},{"lineBreak":true},{"text":"Tamyaycashan örami illguytapis achicyächin.","poem":1},{"lineBreak":true},{"text":"Wayratapis wichgarächishanpitami gargaramun.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Runacunaga llapanpis upami, imatapis mana tantiyajmi.","poem":1},{"lineBreak":true},{"text":"Ïduluncunaga ruraj runatapis pengacachinmi.","poem":1},{"lineBreak":true},{"text":"Rurashan ïdulucunaga mana bälejmi, mana cawajmi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chay mana bälej ïdulucunaga manacajllami.","poem":1},{"lineBreak":true},{"text":"Chaycunataga Tayta Diosmi castïgu junaj illgächenga.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tayta Diosninchïmi ichanga juc-niraj.","poem":1},{"lineBreak":true},{"text":"Paymi ima-ayca caycajtapis ruraran.","poem":1},{"lineBreak":true},{"text":"Israelcunataga paymi acrasha quiquinpa cananpaj.","poem":1},{"lineBreak":true},{"text":"Paypaga jutinpis Munayniyoj Tayta Diosmi.","poem":1}]},{"type":"heading","content":["Judá nasyunta illgächinanpaj cashan"]},{"type":"verse","number":17,"content":[{"text":"Contrayquicuna tumaparaycäshuptiquega","poem":1},{"lineBreak":true},{"text":"ima-aycayquitapis camaricur guepicuyna ari.","poem":1}]},{"type":"verse","number":18,"content":["Tayta Diosmi cayno nin:",{"text":"«Cay nasyuncho tiyarcaycaj runacunata cananga fiyupa carumanmi gargushaj.","poem":1},{"lineBreak":true},{"text":"Chaychömi castigashaj fiyupa ñacananpaj» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"¡Ananau, cay nanaytaga manami awantänachu!","poem":1},{"lineBreak":true},{"text":"Marca-masëcuna ñacashantami ñacaycä.","poem":1},{"lineBreak":true},{"text":"Nogapäga ñacay manami ushacanchu.","poem":1},{"lineBreak":true},{"text":"Noga yarparä «cay nanaytaga awantashämi» nir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tiyana toldöcunapis ushajpämi tunisha.","poem":1},{"lineBreak":true},{"text":"Wascancunapis rachir-ushacashami.","poem":1},{"lineBreak":true},{"text":"Wamräcunapis ushajpämi aywacusha.","poem":1},{"lineBreak":true},{"text":"¡Manami cannachu!","poem":1},{"lineBreak":true},{"text":"Manami pïnëpis cannachu yapay toldöcunata ichichinanpaj, ni tolduwan gatananpäpis.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chaynöga caycan cay runacunapa mandajnincuna yarpayniynaj captinmi.","poem":1},{"lineBreak":true},{"text":"Chay mandajcunaga Tayta Diosta manami wiyacushachu.","poem":1},{"lineBreak":true},{"text":"Chaypitami castïgu chayasha.","poem":1},{"lineBreak":true},{"text":"Cananga mandashan runacunapis mashtacashami carcaycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"¡Sumaj wiyay-llapa!","poem":1},{"lineBreak":true},{"text":"¡Mana alli willapami chayaycämun!","poem":1},{"lineBreak":true},{"text":"Norte caj-lä nasyunpitami aypalla suldärucuna aywarcaycämun.","poem":1},{"lineBreak":true},{"text":"Chay suldärucuna chayamushpan Judächo caycaj siudäcunataga illgarachengami.","poem":1},{"lineBreak":true},{"text":"Chaura jirca allgucunallanami chaychöga tiyanga.","poem":1}]},{"type":"heading","content":["Tayta Diosta Jeremías mañacushan"]},{"type":"verse","number":23,"content":[{"text":"Tayta Dios, runaga distïnun imano cashantapis manami musyanchu.","poem":1},{"lineBreak":true},{"text":"Runaga manami musyanchu imaycama ni imano cawananpaj cashantapis.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tayta Dios, castigarga castigamay cuyapayllapa.","poem":1},{"lineBreak":true},{"text":"Rabyashaga ama castigamaychu ari.","poem":1},{"lineBreak":true},{"text":"Rabyasha castigamarga illgarachimanquimanchari.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gamta mana yarpäshoj,","poem":1},{"lineBreak":true},{"text":"mana rejsishoj nasyun runacunata castigay rabyashayqui pascacänanpäga.","poem":1},{"lineBreak":true},{"text":"Chay runacunami Jacobpita mirar aywaj runacunata usharisha.","poem":1},{"lineBreak":true},{"text":"Nasyun intërutami pasaypa ushacashata cachaycusha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}