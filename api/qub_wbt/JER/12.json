{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":12,"content":[{"type":"heading","content":["Tayta Diosta Jeremías mañacushan"]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, gamga llapantami musyanqui.","poem":1},{"lineBreak":true},{"text":"Rasun cajtami rimanqui.","poem":1},{"lineBreak":true},{"text":"Chayno captinpis tapucushayqui.","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj fiyu runacunapäga yarpashanpis alli llojshipan?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj llullacuypa mana allita ruraj runacunaga alli goyan?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gammi paycunata cawachishcanqui. Paycuna rïcuyasha, alli tiyasha, mirasha.","poem":1},{"lineBreak":true},{"text":"Paycunaga shimillanwanmi gamta alabashunqui.","poem":1},{"lineBreak":true},{"text":"Shongunchömi ichanga ni imanillarpis mana yarpäshunquichu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios, gamga nogata rejsimanquimi.","poem":1},{"lineBreak":true},{"text":"Ricamashpayqui musyanquimi gamllaman yäracamushäta.","poem":1},{"lineBreak":true},{"text":"Chay runacunataga uyshata pishtananpaj apashanno shuntay ari.","poem":1},{"lineBreak":true},{"text":"Nircur churay imay junaj wañunanpäpis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Imaycamataj allpa chaqui caycanga?","poem":1},{"lineBreak":true},{"text":"¿Imaycamataj jachacunapis chaquenga?","poem":1},{"lineBreak":true},{"text":"Uywacunapis äbicunapis wañurcaycan","poem":1},{"lineBreak":true},{"text":"cay nasyuncho runacuna juchata ruraptin.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga yarpan imata rurashantapis mana ricashayquitami.","poem":1}]},{"type":"heading","content":["Jeremías mañacushanta Tayta Dios cutichishan"]},{"type":"verse","number":5,"content":["Chayno niptin Jeremiasta Tayta Dios niran:",{"text":"«Chaquipa cörrej runawan llallinacushpallayquipis fiyupana uticashpayquega","poem":1},{"lineBreak":true},{"text":"¿imanöpataj llallinacunquiman cawallun muntasha cörrejwanga?","poem":1},{"lineBreak":true},{"text":"Lliuyaj pampacunachöga allimi caycanqui.","poem":1},{"lineBreak":true},{"text":"Ichanga ¿imanöraj canquiman Jordán muntichöga?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quiquiquipa wauguiquicunawan famillyayquicunami chiquicurcushurayqui.","poem":1},{"lineBreak":true},{"text":"Ollguyparämi washayquitapis rimarcaycan.","poem":1},{"lineBreak":true},{"text":"Alli shiminpa parlapäshuptiquipis paycunamanga ama yäracuychu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Acrashä runacunatami cachaycushcä.","poem":1},{"lineBreak":true},{"text":"Nogapa caycaptinmi gargushcä.","poem":1},{"lineBreak":true},{"text":"Amatar cuyashä nasyun runacunatami","poem":1},{"lineBreak":true},{"text":"contrancunapa munayninman cachapaycushcä.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Acrashä runacuna nogapäga canan caycan munticho liyunnömi.","poem":1},{"lineBreak":true},{"text":"Nogata chiquimashpan liyunnöraj gaparpanpis.","poem":1},{"lineBreak":true},{"text":"Chaypitami ricaytapis mana munänachu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Acrashä runacunaga cuyayllapaj lümayoj äbinömi carcaycan.","poem":1},{"lineBreak":true},{"text":"Chay äbillaman magananpaj wacpita caypitapis aycha micoj äbicuna juntapaycushannömi caycan.","poem":1},{"lineBreak":true},{"text":"Contrancunaga shamuchun jirca animalcunano shuntacarcur.","poem":1},{"lineBreak":true},{"text":"Shamuchun acrashäcunata usharinanpaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Übas chacrata michicojcuna uywanwan lluchcachishannömi,","poem":1},{"lineBreak":true},{"text":"contran mandajcunaga acrashä runacunata usharisha.","poem":1},{"lineBreak":true},{"text":"Chay chacrä jananpami purisha.","poem":1},{"lineBreak":true},{"text":"Chayno purishpanmi mas cuyashä chacrata chunyajman ticrarachisha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chaymi pasaypa garayashata cachaycärisha.","poem":1},{"lineBreak":true},{"text":"Cuyapaypaj llaquicurcaycajtami nogaga ricaycä.","poem":1},{"lineBreak":true},{"text":"Nasyun intërumi chunyaj caycan.","poem":1},{"lineBreak":true},{"text":"Chaypis manami mayganpis yarpachacunchu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chunyaj lömacunapa intërupami","poem":1},{"lineBreak":true},{"text":"contran fiyu runacunaga yuricarcamusha.","poem":1},{"lineBreak":true},{"text":"Paycunami acrashä nasyun runacunata usharinäpaj sablëno caycan.","poem":1},{"lineBreak":true},{"text":"Chaymi mayganpäpis manana alli goyay cannachu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Acrashä runacunaga rïguta muruycärir cashallatami shuntasha.","poem":1},{"lineBreak":true},{"text":"Chay-jina ñacar arushanpis yangallami casha.","poem":1},{"lineBreak":true},{"text":"Noga fiyupa rabyacurcushäpitami cosëchanga pirdisha.»","poem":1}]},{"type":"heading","content":["Israelpa bisïnun nasyuncunapaj Tayta Dios nishan"]},{"type":"verse","number":14,"content":["Tayta Dios caynömi nin: «Israelcunapa bisïnun nasyun runacunaga acrashä runacunatami pirdichisha. Chaypitami paycunataga noga gargushaj. Judá runacunatapis paycunapita gargushämi."]},{"type":"verse","number":15,"content":["Israelpa bisïnun nasyun runacunataga tiyaycashanpita gargurcur cuyapäshämi. Cuyapashpämi cutichimushaj quiquincunapa nasyunninman, tiyashan pachaman."]},{"type":"verse","number":16,"content":["Chay runacuna acrashä runacunata Baal diosta adurayta manana yachacherga acrashä runacunanönami cangapaj. Ichanga yachachicuynëcunata yachacunan, aduramaytapis yachacunan."]},{"type":"verse","number":17,"content":["Mana wiyacamaj runacunatami ichanga juctapis mana cachaycuypa gargur illgächishaj. Noga Tayta Diosmi chayno në.»"]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}