{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":14,"content":[{"type":"heading","content":["Fiyupa usya captin rimashan"]},{"type":"verse","number":1,"content":["Fiyupa usya captinmi Jeremiasta Tayta Dios niran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Judá runacunaga llaquicuywanmi wagarcaycan.","poem":1},{"lineBreak":true},{"text":"Siudäcunacho tiyajcunapis fiyupami llaquicurcaycan.","poem":1},{"lineBreak":true},{"text":"Runacunaga llaquicuywan pampachömi goturpaycan.","poem":1},{"lineBreak":true},{"text":"Jerusalencunaga nanaywanmi gaparpaycan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rïcucunapis uywaynincunata cachan yacu ashej.","poem":1},{"lineBreak":true},{"text":"Chaura gochacunaman yacu ashej chayarga yacuta manami tarimunchu.","poem":1},{"lineBreak":true},{"text":"Mana tarishpanga puyñuncunatapis yacuynajllata cutichicun.","poem":1},{"lineBreak":true},{"text":"Fiyupa llaquicur pengacushpan umancunatapis shucutacarcärin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mana tamyaptin fiyupa usyawan","poem":1},{"lineBreak":true},{"text":"allpapis rachicäcusha.","poem":1},{"lineBreak":true},{"text":"Chaymi runacunapis fiyupa llaquicur pengacushpan umancunata chapacarcärin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Usyawan guewa mana captinmi","poem":1},{"lineBreak":true},{"text":"lluychucunapis chayraj wacharishan wawanta","poem":1},{"lineBreak":true},{"text":"jircacho cachaycur aywacun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chucaru bürrucunapis chunyaj lömacunacho ichirpaycan","poem":1},{"lineBreak":true},{"text":"jirca allgucunano gasaj wayrata shuyarashpan.","poem":1},{"lineBreak":true},{"text":"Micunanpaj guewa mana captinmi","poem":1},{"lineBreak":true},{"text":"ñawincunapis mancacashana caycan.»","poem":1}]},{"type":"heading","content":["Israelcunapa ruquin Jeremías mañacushan"]},{"type":"verse","number":7,"content":[{"text":"Tayta Dios, juchäcuna atipasha cashätaga musyänami.","poem":1},{"lineBreak":true},{"text":"Ayca cutishi nishayquicunata mana cumlishcächu.","poem":1},{"lineBreak":true},{"text":"Fiyupa juchasapami caycäcuna.","poem":1},{"lineBreak":true},{"text":"Ichanga rispitasha canayqui-raycullapis yanapaycamay ari.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gamllamanmi Israelcunaga yäracamö.","poem":1},{"lineBreak":true},{"text":"Fiyupa llaquicurcaycaptëpis gamllami imapitapis salbamanqui.","poem":1},{"lineBreak":true},{"text":"Cananga ¿imanirtaj cay nasyunchöga jäpano caycanqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj gorpa pachacojnölla caycanqui?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¿Imanirtaj mancharisha runanölla caycanqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj guërracho pillyay yachaj runa pitapis mana yanapajno caycanqui?","poem":1},{"lineBreak":true},{"text":"Tayta Dios gamga nogacunapa lädöchömi caycanqui.","poem":1},{"lineBreak":true},{"text":"Llapanmi musyan nogacunaga gampa cashäta.","poem":1},{"lineBreak":true},{"text":"¡Nogacunataga ama cachaycamaychu ari!","poem":1}]},{"type":"verse","number":10,"content":["Israel runacunapaj Tayta Diosga caynömi nin:",{"text":"«Cay nasyun runacunaga yachacashami juc-läman juc-läman chayar puricachaj.","poem":1},{"lineBreak":true},{"text":"Chayno captinmi mana cuyapächu.","poem":1},{"lineBreak":true},{"text":"Cananga jucha rurashancunata llapanpitami jusgashaj.»","poem":1}]},{"type":"verse","number":11,"content":["Tayta Dios nimaran: «Cay runacunata yanapänäpäga ama ruwacamaychu."]},{"type":"verse","number":12,"content":["May-jina ayunashpan mañacamaptinpis manami yanapäshäpächu. Maychica uywacunata, chaqui micuy ofrendacunata nogapaj apamuptiquipis manami cuyapäshächu. Paycunataga ushacächishaj guërrawan, muchuywan, gueshyawanmi.»"]},{"type":"verse","number":13,"content":["Chaura noga nirä: «Tayta Dios, profëtacunaga runacunata willaparcaycan guërra mana cananpaj, muchuy mana cananpaj. Nircaycan llapanpita chapashpayqui cay pachachöga allilla goyächinayquipaj cashantami.»"]},{"type":"verse","number":14,"content":["Chaura Tayta Dios nimaran: «Nogapa jutëcho chayno nishpan chay profëtacunaga llullacurcaycanmi. Chay runacunataga manami cachashcächu. Manami imatapis nishcächu; manami willapashcäpischu. Yarpayninpita jorgurcullarmi ‹ricachimasha› nir willacuycan. Chayno llullacuyllapami chay profëtacunaga runacunata willaparcaycan."]},{"type":"verse","number":15,"content":["Noga Tayta Diosmi në: Noga mana cachaycaptë jutëcho rimashpan ‹cay nasyunchöga manami guërrapis, muchuypis cangachu› nej profëtacunaga guërrachömi, muchuywanmi wañonga."]},{"type":"verse","number":16,"content":["Chay profëtacuna llullapashan runacunapis guërrachömi, muchuywanmi wañonga. Wañonga warminwan ollgu warmi wamrancunawan iwal. Chauraga Jerusalenpa cällincunacho wañushami jitarpäconga. Pipis manami pampananpaj cangapächu. Juchanpitami chayno castigashaj."]},{"type":"verse","number":17,"content":["«Jeremías, llaquicushpayqui runacunata cayno niy:",{"text":"« ‹Cuyashä runacunaman manchariypaj disigrasya chayashanpita weguëpis mana chawaypa aywachun.","poem":1},{"lineBreak":true},{"text":"Malubrashan nanaywan fiyupa gaparpaptinmi weguëpis mana chawaypa aywachun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Jircacunapa aywar ricä guërrawan wañusha yänin jitarpaycajta.","poem":1},{"lineBreak":true},{"text":"Siudäman yaycushpäna tarë yargaypita wañurcaycajta.","poem":1},{"lineBreak":true},{"text":"Profëtacunapis cüracunapis imanir chayno päsashantapis tantiyayta mana atiparmi puricacharcaycan.› »","poem":1}]},{"type":"heading","content":["Runacunapa ruquin Jeremías mañacushan"]},{"type":"verse","number":19,"content":[{"text":"Tayta Dios, ¿fiyupachu rabyacurcushcanqui Judá runacunapäga?","poem":1},{"lineBreak":true},{"text":"Sión siudätaga ¿mananachu ricaytapis munanquina?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj mana cuyapaypa mana alliman chayachimashcanqui?","poem":1},{"lineBreak":true},{"text":"Nogacunaga allilla goyaytami yarpaycarä.","poem":1},{"lineBreak":true},{"text":"Nishäga manami imapis alliga cashachu.","poem":1},{"lineBreak":true},{"text":"Mana gueshyaypa cawaytami yarparäcuna.","poem":1},{"lineBreak":true},{"text":"Nishäga fiyupa manchacuyllami casha.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tayta Dios, quiquëcunapis musyämi contrayqui ricacushätaga.","poem":1},{"lineBreak":true},{"text":"Unay caj awilöcuna fiyupa mana allita rurashantapis yarpaycämi.","poem":1},{"lineBreak":true},{"text":"Gampa contrayqui juchata rurashätapis yarpaycämi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gamta manacajman mana churashunayquipaj nogacunataga ama cachaycamaychu.","poem":1},{"lineBreak":true},{"text":"Tiyanayquipaj acrashayqui siudätapis mana bälejmanga ama churaycuychu.","poem":1},{"lineBreak":true},{"text":"Cumliycuy ari nogacunawan conträtuta rurar aunishayquita.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Juc dioscunaga manami mayganpis tamyata tamyachimunchu.","poem":1},{"lineBreak":true},{"text":"Syëlupitapis quiquillanga manami tamyamunchu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga gammi Tayta Dios tamyachimunqui.","poem":1},{"lineBreak":true},{"text":"Ima-aycatapis gamllami camashcanqui.","poem":1},{"lineBreak":true},{"text":"¡Chaymi Tayta Dios gamllaman yäracaycämöcuna!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}