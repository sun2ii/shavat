{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":15,"content":[{"type":"heading","content":["Castigananpaj cashanta Dios willashan"]},{"type":"verse","number":1,"content":["Tayta Dios nimaran: «Jeremías, Israelcuna aywacunanpaj willay. Amana nogapa ricanächöga tiyachunnachu. Paycunataga manami perdunänachu. Ni Moiseswan Samuel shamushpan ruwamaptinpis manami perdunashänachu."]},{"type":"verse","number":2,"content":["‹¿Maymantaj aywashaj?› nir tapushuptiquega noga nishäta cayno willanqui:",{"text":"« ‹Gueshyawan wañojpaj cajcunaga gueshyawanmi wañunqui.","poem":1},{"lineBreak":true},{"text":"Guërracho wañojpaj cajcunaga guërrachömi wañunqui.","poem":1},{"lineBreak":true},{"text":"Yargaywan wañojpaj cajcunaga yargaypitami wañunqui.","poem":1},{"lineBreak":true},{"text":"Prësu aywajpaj cajcunaga prësumi aywanqui.›","poem":1}]},{"type":"verse","number":3,"content":["«Noga Tayta Diosmi në: Chuscu casta castïguwanmi castigashaj. Guërrachömi wañuchenga. Allgucunami garachash purichenga. Aycha micoj äbicunami miconga. Aycha micoj jirca animalcunami rachir-ushanga."]},{"type":"verse","number":4,"content":["Chayno paycunata rurashäta mayar llapan nasyun runacunami fiyupa mancharenga. Chaytaga rurashaj Ezequiaspa wamran Judäpa raynin Manasés imanöpis Jerusalencho rurashanpitami."]},{"type":"verse","number":5,"content":[{"text":"«Jerusalén runacuna, ¿piraj cuyapäshunqui?","poem":1},{"lineBreak":true},{"text":"¿Piraj llaquipäshunqui?","poem":1},{"lineBreak":true},{"text":"¿Piraj imano goyaycashayquipäpis yarpachaconga?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gamcunami cachaycamashcanqui.","poem":1},{"lineBreak":true},{"text":"Gamcunami chiquicarcamashcanqui.","poem":1},{"lineBreak":true},{"text":"Chayno cashayquipita mana awantarnami castigar illgächishayqui.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":7,"content":[{"text":"Rïgu päjata jorquëtiwan jitajnömi","poem":1},{"lineBreak":true},{"text":"gamcunataga siudäniquicunapita jorgurcur jitarishayqui.","poem":1},{"lineBreak":true},{"text":"Gamcuna tiyashayquega chunyajmi quëdanga.","poem":1},{"lineBreak":true},{"text":"Mana alli ruraycunata mana cachashayquipitami illgächishayqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Biyüdacunapis aypallami canga lamar cantuncho caycaj agushpitapis masraj.","poem":1},{"lineBreak":true},{"text":"Las-dösi intimi mamantinman llapan mösucunamanga wañuyta cachamushaj.","poem":1},{"lineBreak":true},{"text":"Paycunamanga illajpitami manchariytawan llaquicuytapis chayachishaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ganchis ollgu wamrayoj warmicunapis chiyacäconga.","poem":1},{"lineBreak":true},{"text":"Jämayninta cachaytapis manami camäpaconganachu.","poem":1},{"lineBreak":true},{"text":"Manaraj timpuncho wamrancuna wañushanpitami pengacur uysucarcärenga.","poem":1},{"lineBreak":true},{"text":"Maygallanpis cawaycar quëdaptenga","poem":1},{"lineBreak":true},{"text":"contrancunawan simrimi wañuchichishaj.","poem":1},"Noga Tayta Diosmi chayno në.»"]},{"type":"heading","content":["Profëta llaquicushan"]},{"type":"verse","number":10,"content":[{"text":"Mamäpis nogataraj cawaycächimaran.","poem":1},{"lineBreak":true},{"text":"Nogaga cawashcäpis llapanwanpis rimanacur pillyallar goyänalläpämi.","poem":1},{"lineBreak":true},{"text":"Pitapis manami guellayta ristashcächu.","poem":1},{"lineBreak":true},{"text":"Chayno manami pipis ristamashachu.","poem":1},{"lineBreak":true},{"text":"Chaypis llapanmi maldisyunaycäman.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Dios, nogaga gamta allimi sirbishcä.","poem":1},{"lineBreak":true},{"text":"Chiquimajcuna llaquicuycho, ñacaycho caycaptin","poem":1},{"lineBreak":true},{"text":"yanapänayquipaj nogaga gamta mañacamushcämi.","poem":1},{"lineBreak":true},{"text":"Mana mañacusha captëga","poem":1},{"lineBreak":true},{"text":"maldisyunamashancuna jina chayamächun ari.","poem":1}]},{"type":"heading","content":["Israelcunata castigananpaj Tayta Dios willashan"]},{"type":"verse","number":12,"content":["Acrashan runacunata Tayta Dios niran:",{"text":"«Norte caj-lächo caycaj fyërrutawan runsita","poem":1},{"lineBreak":true},{"text":"¿pillaga paquirinmanchuraj?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Israelcuna, jucha rurashayquipitami","poem":1},{"lineBreak":true},{"text":"contrayquicunapa maquinman riquësantinta cachaycushayquipaj.","poem":1},{"lineBreak":true},{"text":"Nasyunniquicho caycajtawan quiquiquicuna charashayquitaga","poem":1},{"lineBreak":true},{"text":"imatapis mana pägashuyllapami llapanta contrayquicuna apacongapaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Quiquiquicunapis mana rejsishayqui nasyunchömi contrayquicunapa uywaynin canquipaj.","poem":1},{"lineBreak":true},{"text":"Nogaga fiyupami gamcunapaj rabyasha caycä.","poem":1},{"lineBreak":true},{"text":"Chaymi nina fiyupa ratarir mana upejno ushajpaj usharishayquipaj.»","poem":1}]},{"type":"heading","content":["Tayta Diosta Jeremías mañacushan"]},{"type":"verse","number":15,"content":[{"text":"Tayta Dios, gamga llapantami musyanqui.","poem":1},{"lineBreak":true},{"text":"Nogata yarpäramay ari. Yanapämänayquipaj shaycamuy ari.","poem":1},{"lineBreak":true},{"text":"¡Gaticachämajcunata ayñita cutichiy!","poem":1},{"lineBreak":true},{"text":"Paycunataga ama cuyapaychu ari.","poem":1},{"lineBreak":true},{"text":"Nogata wañuchimänantaga ama munaycuychu.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, gam-raycumi tucuyta gayapämaptinpis awantacö.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Palabrayquita nogaga micucurcurämi.","poem":1},{"lineBreak":true},{"text":"Chay palabrayqui nogapäga allimi caran; cushicachimajmi.","poem":1},{"lineBreak":true},{"text":"Munayniyoj Tayta Dios, nogaga gamllapanami caycä.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Manami fistan-fistan purishcächu.","poem":1},{"lineBreak":true},{"text":"Cushicuyllata yarpajcunapitapis witicushcämi.","poem":1},{"lineBreak":true},{"text":"Gayamashayqui junajpita-pachami quiquillä goyäcushcä.","poem":1},{"lineBreak":true},{"text":"Gamnömi jucha rurajcunapäpis fiyupa rabyä.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chaura noga llaquicushäga ¿imanirtaj imaypis mana päsanchu?","poem":1},{"lineBreak":true},{"text":"Shongu nanaynëga ¿imanirtaj mana chawanchu?","poem":1},{"lineBreak":true},{"text":"Nogapäga gam ricacushcanqui pashtaj yacu illajpita chaquicäcojnömi.","poem":1}]},{"type":"verse","number":19,"content":["Chaymi Tayta Dios nimaran:",{"text":"«Arpinticushpayqui nogaman yapay cutimuptiquega cuyapar chasquishayquimi.","poem":1},{"lineBreak":true},{"text":"Chauraga nogatanami sirbimanquipaj.","poem":1},{"lineBreak":true},{"text":"Manacajcunallata manana rimar, alli cajllatana rimarga noga nishätami willacunquipaj.","poem":1},{"lineBreak":true},{"text":"Gam willapashayquitami runacunaga wiyaconga.","poem":1},{"lineBreak":true},{"text":"Manami gamchu runacunataga cäsupänayqui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nogami camacächishaj chay runacunapäga runsipita tapyano canayquipaj.","poem":1},{"lineBreak":true},{"text":"Manami imanöpapis binsishunquipächu.","poem":1},{"lineBreak":true},{"text":"Gamwan pillyarpis manami binsishunquipächu.","poem":1},{"lineBreak":true},{"text":"Gamwanga nogami caycä imapitapis salbar chapänäpaj.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":21,"content":[{"text":"Fiyu runacunapa maquinpita jorgushayquimi.","poem":1},{"lineBreak":true},{"text":"Wañuchicojcunapa maquinpitapis salbashayquimi.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}