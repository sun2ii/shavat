{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":2,"content":[{"type":"heading","content":["Israelcuna Tayta Diosta cachaycärishan"]},{"type":"verse","number":1,"content":["Tayta Dios nimaran"]},{"type":"verse","number":2,"content":["Jerusalenman aywanäpaj, chaycho tiyajcunata noga willapänäpaj. Caynömi Tayta Dios nin:",{"text":"«Nogaga yarpaycämi ñaupa wichan","poem":1},{"lineBreak":true},{"text":"Nogallata wiyacamar cawashayquita.","poem":1},{"lineBreak":true},{"text":"Chayraj majachacasha jipashnömi cuyamarayqui.","poem":1},{"lineBreak":true},{"text":"Micuy mana wayunan chunyaj chaqui jircapapis gatirämarayquimi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gamcunaga noga acracushämi carayqui.","poem":1},{"lineBreak":true},{"text":"Rimir punta shuntar raquishan micuynömi nogapaj raquisha carayqui.","poem":1},{"lineBreak":true},{"text":"Chaymi ñacachishojcunataga noga castigaj cä.","poem":1},{"lineBreak":true},{"text":"Castigarmi fiyupa ñacachej cä.","poem":1},"Noga Tayta Diosmi chayno në.»"]},{"type":"verse","number":4,"content":["Jacobpita miraj Israel famillyacuna wiyaycäriy Tayta Dios imano nishantapis."]},{"type":"verse","number":5,"content":["Tayta Diosga gamcunapaj caynömi nin:",{"text":"«¿Ima mana allitataj rurashcä","poem":1},{"lineBreak":true},{"text":"gamcunapa unay awiluyquicuna cachaycamänanpäga?","poem":1},{"lineBreak":true},{"text":"Mana bälej dioscunata adurajmi aywacuran.","poem":1},{"lineBreak":true},{"text":"Chaymi quiquincunapis mana bälejna ricacuran.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Egiptupita jorgamusha caycaptë,","poem":1},{"lineBreak":true},{"text":"chunyaj jircapa pushamusha caycaptë,","poem":1},{"lineBreak":true},{"text":"fiyu chaqui jircapa, yacuynaj jircapa pushamusha caycaptë,","poem":1},{"lineBreak":true},{"text":"pï-maypis mana tiyashan jircapa, pipis mana purinan jircapa pushamusha caycaptëpis","poem":1},{"lineBreak":true},{"text":"paycunaga manami yarpachacuranchu noga munashäno cawananpaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nogami gamcunata pushamurä ima-aycapis wayunan partiman,","poem":1},{"lineBreak":true},{"text":"cay particho wayushan frütacunata micunayquipaj,","poem":1},{"lineBreak":true},{"text":"chaycho ima-ayca alli wayojcunatapis micunayquipaj.","poem":1},{"lineBreak":true},{"text":"Ichanga gamcuna chayaycamur alli chacräta ganrachishcanqui.","poem":1},{"lineBreak":true},{"text":"Gamcunaga ticrachishcanqui cay nasyun quiquëpa caycaptin fiyupa melanäcunäpaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cüracunapis noga munashänöga manami rurashachu.","poem":1},{"lineBreak":true},{"text":"Layta yachachejcunapis manami rejsimashachu.","poem":1},{"lineBreak":true},{"text":"Mandajcunapis nogapa conträ ricacuran.","poem":1},{"lineBreak":true},{"text":"Profëtacunapis Baalpaj willacusha.","poem":1},{"lineBreak":true},{"text":"Chayno rurarmi imapäpis mana bälej ïdulucunallaman yäracusha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaypitami cananga gamcunawanpis willcayquicunawanpis demandanacushaj.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«¿Caycho cashanno mayllachöga cashachuraj?","poem":1},{"lineBreak":true},{"text":"Mä ayway inti yagamunan caj-lächo caycaj lamar chaupin tishgucunacho tiyaycajcunata sumaj ricamunayquipaj.","poem":1},{"lineBreak":true},{"text":"Cedarman pitapis cachacuy imano cashantapis musyananpaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¿Maygan nasyunllaga diosnincunata rucachishachuraj juc dioscunata adurananpaj?","poem":1},{"lineBreak":true},{"text":"‹Diosnë› nishancunaga manami rasunpa diospischu.","poem":1},{"lineBreak":true},{"text":"Acrashä runacunami ichanga mana sirbej ïdulucunata aduranan casha","poem":1},{"lineBreak":true},{"text":"Noga munayniyoj Diosnin caycaptëpis cachaycamasha.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chayno cashanpitaga syëlupis mancharinmi.","poem":1},{"lineBreak":true},{"text":"Mana allicunata ricashanpitaga sicsicyanmi.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":13,"content":[{"text":"Acrashä runacunaga ishcay casta juchatami rurasha.","poem":1},{"lineBreak":true},{"text":"Mana chaquej yacu pashtajno caycaptëpis","poem":1},{"lineBreak":true},{"text":"Nogaman yäracaycämashanpita cachaycamasha.","poem":1},{"lineBreak":true},{"text":"Y quiquincunami ïdulucunata adurasha sagra pösuncunata rurajno.","poem":1},{"lineBreak":true},{"text":"Chay pösuncunaga yacuta manami juntachinchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«¿Israel runacunaga uyway runacunachu?","poem":1},{"lineBreak":true},{"text":"Paycunaga ¿uyway ñacaj cananpächu yurisha?","poem":1},{"lineBreak":true},{"text":"Chauraga ¿imanirtaj ima-aycantapis suwapaycan?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¿Imanirtaj paycunamanga contrancuna sinchipa gaparpar liyunnöraj yaycun?","poem":1},{"lineBreak":true},{"text":"Paycunapa nasyunnintaga cachaycärisha ragällatami.","poem":1},{"lineBreak":true},{"text":"Llapan siudänincunatapis rupaycachishami.","poem":1},{"lineBreak":true},{"text":"Chaychöga manami pipis tiyannachu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Menfis runacunawan Tafnes runacunapis pengaymanmi churashurayqui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaynöga rurasha-cashunqui","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosniqui caycaptë,","poem":1},{"lineBreak":true},{"text":"caminunpapis pushaj caycaptë cachaycäramashayquipitami.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Cananga ¿ima allitataj jorgunqui Egiptuman yäracur,","poem":1},{"lineBreak":true},{"text":"Nilo mayu yacuta upushpayqui?","poem":1},{"lineBreak":true},{"text":"¿Ima allitataj jorgunqui Asiriaman yäracur,","poem":1},{"lineBreak":true},{"text":"Éufrates mayu yacuta upushpayqui?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Quiquiquicunapa juchayquipitami castïgu chayashunqui.","poem":1},{"lineBreak":true},{"text":"Mana wiyacamashayquipitami mana allimanpis chayanqui.","poem":1},{"lineBreak":true},{"text":"Imata rurashayquitapis sumaj yarpachacushpayqui mä tincuchiy.","poem":1},{"lineBreak":true},{"text":"Chaymi tantiyacunquipaj Tayta Diosniquita cachaycuyga fiyu mana alli cashanta.","poem":1},{"lineBreak":true},{"text":"Nogataga manami rispitamashcanquinachu.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Unaypita-pachami gamcunaga nogapa conträ ricacurayqui.","poem":1},{"lineBreak":true},{"text":"Manami wiyacamashcanquichu.","poem":1},{"lineBreak":true},{"text":"Gamcunaga ‹Manami sirbishayquinachu› nimarayqui.","poem":1},{"lineBreak":true},{"text":"Chayno nishpayquimi llapan puytush lömacunacho,","poem":1},{"lineBreak":true},{"text":"rämasapa yöracunapa chaquincunachöpis","poem":1},{"lineBreak":true},{"text":"guellaypaj cacoj warmino juchata rurashcanqui.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gamcunata nogaga shuyni tiyachirä","poem":1},{"lineBreak":true},{"text":"mas alli casta caj übasta lantajno,","poem":1},{"lineBreak":true},{"text":"mas alli casta caj übas murutanömi.","poem":1},{"lineBreak":true},{"text":"Ichanga ¿imanöpataj fiyupa mana alliman ticrashcanqui?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lijyawan may-jina mayllacuptiqui, maychica jabunwan mayllacur bäñacuptiquipis","poem":1},{"lineBreak":true},{"text":"juchayquega jinallami caycan.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«¿Imanöpataj ninquiman: ‹Manami ganracushcächu.","poem":1},{"lineBreak":true},{"text":"Manami aywashcächu Baalcunata adurajpis› nir?","poem":1},{"lineBreak":true},{"text":"Chauraga guechwa pampacho imata rurashayquitapis mä yarpäriy.","poem":1},{"lineBreak":true},{"text":"Rurashayquicunataga reconösiy ari.","poem":1},{"lineBreak":true},{"text":"Manta camëllo wichaypa uraypapis cörricachajnömi cashcanqui.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"China bürru ashicur orgu bürrupa asyayninta mayacachar","poem":1},{"lineBreak":true},{"text":"chunyajpa cörricachajnömi cashcanqui.","poem":1},{"lineBreak":true},{"text":"Chay china bürru ashicushantaga manami pipis chawächinchu.","poem":1},{"lineBreak":true},{"text":"Orgupis ashishpanga manami alläpa uticangachu.","poem":1},{"lineBreak":true},{"text":"China bürruta ashiycashanta rätumi tarenga.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Israelcuna, gamcunaga ama juc dioscunata adurayta ashiynachu.","poem":1},{"lineBreak":true},{"text":"Gala-chaquilla cörrerga chaquiquita tacacunquimanmi.","poem":1},{"lineBreak":true},{"text":"Alläpa cörricacharga yacunanquipämi.","poem":1},{"lineBreak":true},{"text":"Chayno niptëpis gamcunaga nirayqui: ‹Imanäshätaj ari.","poem":1},{"lineBreak":true},{"text":"Nogaga jäpa dioscunatami amatar cuyä.","poem":1},{"lineBreak":true},{"text":"Paycunawanmi aywacö› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«Suwa taripacar pengacushannömi Israelcunapis raynincunapis","poem":1},{"lineBreak":true},{"text":"mandajnincunapis cüracunapis profëtacunapis pengacongapaj.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Israelcunaga juc yöratami ‹taytä canqui› nircaycan.","poem":1},{"lineBreak":true},{"text":"Jatun rumitana ‹mamä canqui› nircaycan.","poem":1},{"lineBreak":true},{"text":"Nogatami ichanga manana ni ricäramaytapis munannachu.","poem":1},{"lineBreak":true},{"text":"Juc-lällapana ticraräcunpis.","poem":1},{"lineBreak":true},{"text":"Chayno carpis ima ñacaymanpis chayashpanga","poem":1},{"lineBreak":true},{"text":"‹¡Tayta salbaycamay ari!› niman.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Judá, ¿maychötaj caycan rurashayqui diosniquicunaga?","poem":1},{"lineBreak":true},{"text":"Chaycuna mä shamuchun","poem":1},{"lineBreak":true},{"text":"ñacaycho caycashayqui öra salbashunayquipaj.","poem":1},{"lineBreak":true},{"text":"¿Gamcunapaga diosniquicunapis manachu siudäniquicunano aypalla?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"¿Imanirtaj nogapa conträ parlarcaycanqui?","poem":1},{"lineBreak":true},{"text":"Gamcunaga llapayquipis conträmi jatarishcanqui.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":30,"content":[{"text":"Wamrayquicunatapis yangami castigashcä.","poem":1},{"lineBreak":true},{"text":"Castigaptëpis manami wanacushachu.","poem":1},{"lineBreak":true},{"text":"Profëta shamojcunatapis quiquiquicunami fiyu liyuncunanöpis wañuchishcanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«Canan wichan caycaj runacunapis","poem":1},{"lineBreak":true},{"text":"sumaj tantiyacuy Tayta Dios willacaycächishanta.","poem":1},{"lineBreak":true},{"text":"Israelcuna, gamcunapäga ¿chunyaj jircachu cashcä?","poem":1},{"lineBreak":true},{"text":"¿Chacajno llantuy ñitishachu cashcä?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj nogapaj nircaycanqui","poem":1},{"lineBreak":true},{"text":"‹Nogacunaga manami pipa munayninchöpis cächu.","poem":1},{"lineBreak":true},{"text":"Manami yapay gammanga yäracamushänachu› nir?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"¿Jipash cashan wichan camaränanpaj","poem":1},{"lineBreak":true},{"text":"ima-aycantapis churacushanta, jaticushanta warmi gongaycunmanchuraj?","poem":1},{"lineBreak":true},{"text":"Acrashä runacunami ichanga ñaupatana gongaycamasha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"«Juccunata cuyanayquipaj ashiytaga sumajmi yachanqui.","poem":1},{"lineBreak":true},{"text":"Chaymi guellaypaj cacoj warmicunapis gampita yachacusha.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Pobricunapawan alli runacunapa","poem":1},{"lineBreak":true},{"text":"yawarnin pillchishushallayquimi röpayquichöpis caycan.","poem":1},{"lineBreak":true},{"text":"Imatapis mana allita mana ruraycaptinmi chay runacunataga wañuchishcanqui.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Chayno ruraycarpis nircaycanqui: ‹Juchaynajmi cä.","poem":1},{"lineBreak":true},{"text":"Nogacunapäga Dios manami rabyashanachu caycan› nir.","poem":1},{"lineBreak":true},{"text":"‹Juchaynajmi cä› nishayquipitami","poem":1},{"lineBreak":true},{"text":"Nogaga llapan rurashayquita ashimuyta gallaycushaj.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"¿Imanirtaj apurä purinqui yanapäshoj nasyuncunata rucachinayquipaj?","poem":1},{"lineBreak":true},{"text":"Asiria runacuna illajpita llullapäshushayquinömi Egipto runacunapis rurashunquipaj.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Egiptupitapis cutimunquipaj fiyupa pengacushpayqui cärayqui chapashami.","poem":1},{"lineBreak":true},{"text":"Yanapäshoj nasyun runacunaga manami shongöpänöchu.","poem":1},{"lineBreak":true},{"text":"Paycunawan alli ricanacur manami imatapis jorgunquipächu.»","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}