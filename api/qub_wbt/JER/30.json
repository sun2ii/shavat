{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":30,"content":[{"type":"heading","content":["Shamoj watacunacho Tayta Dios cutichinanpaj nishan"]},{"type":"verse","number":1,"content":["Jeremiastami Tayta Dios willaparan. Willaparmi niran:"]},{"type":"verse","number":2,"content":["«Israelcunapa noga Tayta Diosninmi në llapan nishäcunata isquirbinayquipaj."]},{"type":"verse","number":3,"content":["Juc junäga acrashä Israelcunapa, Judá runacunapa surtinta rucachishämi. Noga Tayta Diosmi chayno cananpaj në. Unay caj awiluncunata goycushä nasyunmanmi cutichimushäpaj.»"]},{"type":"verse","number":4,"content":["Israelcunapajwan Judäcunapaj Tayta Dios rimaran."]},{"type":"verse","number":5,"content":["Chay rimashanga caynömi caycan:",{"text":"«¡Fiyupa llaquicuywan gaparpashanmi wiyacaycan!","poem":1},{"lineBreak":true},{"text":"¡Fiyupa manchariywan wagarcaycashanmi wiyacaycan!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mä tapucachay, ¿juc ollgu runa gueshyacunmanchuraj?","poem":1},{"lineBreak":true},{"text":"Chauraga ¿imanirtaj ollgu runacunata ricä chegllan charisha tumaycachaycajta,","poem":1},{"lineBreak":true},{"text":"gueshyacunanpaj nanay chariptin warmi milluycachaycajtano?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj paycunaga llapanpis pasaypa yur'gacäcusha?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaynöga canga fiyupa manchariypaj junaj chayamunanpaj captinmi.","poem":1},{"lineBreak":true},{"text":"Chay junajnöga manami imaypis canyasharächu.","poem":1},{"lineBreak":true},{"text":"Chay wichan Jacobpita mirajcunapäga fiyupa llaquicuymi cangapaj.","poem":1},{"lineBreak":true},{"text":"Ichanga paycunata noga salbashämi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Noga munayniyoj Tayta Diosmi në:","poem":1},{"lineBreak":true},{"text":"Acrashä runacuna ñacar yüguta matancaraycashantami paquirishaj.","poem":1},{"lineBreak":true},{"text":"Watasha caycashan wascantapis rachirishaj.","poem":1},{"lineBreak":true},{"text":"Chaypitanaga manami imaypis juc-lä nasyun runacunapa uywaynin canganachu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaura paycunaga rispitar sirbimanga noga Tayta Diosllantanami.","poem":1},{"lineBreak":true},{"text":"Churapashä raynintapis sirbenga.","poem":1},{"lineBreak":true},{"text":"Chay rayga Davidnömi mandangapaj.","poem":1}]},{"type":"heading","content":["Acrashan runacunata Tayta Dios salbananpaj cashan"]},{"type":"verse","number":10,"content":["«Noga Tayta Diosmi në:",{"text":"«Jacobpita mirar aywaj Israelcuna, ama manchacuychu.","poem":1},{"lineBreak":true},{"text":"Sirbimajcuna ama manchariychu.","poem":1},{"lineBreak":true},{"text":"Caru nasyunman apashushayquipitami","poem":1},{"lineBreak":true},{"text":"gamcunata y llapan wamrayquicunata jorgamushayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaypitaga allinami goyäcunquipaj.","poem":1},{"lineBreak":true},{"text":"Alli goyäcuptiqui pipis manami manchachishunquipänachu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nogaga gamwanmi caycä imapitapis salbanäpaj.","poem":1},{"lineBreak":true},{"text":"Maychöpis jitarishächo caycashayqui nasyun runacunataga llapantami wañuchishaj.","poem":1},{"lineBreak":true},{"text":"Gamcunatami ichanga mana wañuchishayquipächu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga rurashayquimanno castigayllami castigashayqui.","poem":1},{"lineBreak":true},{"text":"Jina castigänillataga manami cachaycushayquipächu.","poem":1}]},{"type":"verse","number":12,"content":["«Noga Tayta Diosmi cayno në:",{"text":"«Gueriquega manami imanöpapis allchacannachu.","poem":1},{"lineBreak":true},{"text":"Nanächicuycashayquipäga manami jampi canchu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Manami pipis canchu gamta ricashunayquipäga.","poem":1},{"lineBreak":true},{"text":"Manami pipis canchu gueriquita jampipäshunayquipäga.","poem":1},{"lineBreak":true},{"text":"Manami jampipis canchu allchacänayquipäga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Llapan yanapäshoj nasyun runacunami gongaycushurayqui.","poem":1},{"lineBreak":true},{"text":"Paycunataga manami imapis gocunnachu.","poem":1},{"lineBreak":true},{"text":"Yupaytapis mana atipaypaj juchata rurashayquipitami,","poem":1},{"lineBreak":true},{"text":"fiyupa mana allicunata rurashayquipitami mana cuyapaypa castigashcä.","poem":1},{"lineBreak":true},{"text":"Gamtaga contrayquinöpis nogami gueshyaj-tucachishcä.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nanaycäshushayquipaj manana jampi caycaptenga","poem":1},{"lineBreak":true},{"text":"¿imapänataj nanächicur gaparaycanqui?","poem":1},{"lineBreak":true},{"text":"Gamtaga castigashcä yupaytapis mana atipaypaj juchata rurashayquipitami,","poem":1},{"lineBreak":true},{"text":"fiyupa mana allicunata rurashayquipitami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Ichanga gamcunata ñacachishoj cajpis llapanmi ushacanga.","poem":1},{"lineBreak":true},{"text":"Contrayquicunapis llapanmi prësu aywanga.","poem":1},{"lineBreak":true},{"text":"Gamcunata guechushojcunataga quiquincunatapis guechunanpämi camacächishaj.","poem":1},{"lineBreak":true},{"text":"Suwapäshoj cajcunataga paycunatapis suwapangami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gamtami ichanga gueriquicunata jampipäshayqui.","poem":1},{"lineBreak":true},{"text":"‹Dios cachaycushan siudä› nir manacajman churashuptiquipis gamtaga allchacächishayquipämi.","poem":1},"Noga Tayta Diosmi chayno në.»"]},{"type":"verse","number":18,"content":["Tayta Dios nin:",{"text":"«Jacobpita mirajcunata nogami cutichimushaj.","poem":1},{"lineBreak":true},{"text":"Paycuna tiyashan nasyunninta cuyapäshämi.","poem":1},{"lineBreak":true},{"text":"Juchusha caycaj janancunachömi siudänincunatapis yapay ruranga.","poem":1},{"lineBreak":true},{"text":"Palasyuncunatapis maychöpis cashanchömi yapay jatarachenga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Paycunami agradësicamar alabamanga.","poem":1},{"lineBreak":true},{"text":"Cushishami goyanga.","poem":1},{"lineBreak":true},{"text":"Paycunaga manami wallcayangachu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga nogami camacächishaj achcayänanpaj.","poem":1},{"lineBreak":true},{"text":"Llapan rispitananpaj noga camacächiptëmi","poem":1},{"lineBreak":true},{"text":"manana pipis manacajmanga churanganachu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Israelcunaga unay cashannönami goyanga.","poem":1},{"lineBreak":true},{"text":"Juc marcanöllanami nogapa ñaupächo tiyanga.","poem":1},{"lineBreak":true},{"text":"Paycunata ñacachej cajtaga castigashämi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Quiquincunapitami juc mandaj jatarenga.","poem":1},{"lineBreak":true},{"text":"Llapanta mandananpaj quiquincunapitami yurenga.","poem":1},{"lineBreak":true},{"text":"Pay ñaupächo cananpämi camacächishaj.","poem":1},{"lineBreak":true},{"text":"Chayno mana camacächiptëga ¿piraj ñaupäman chayamunman?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Paycunaga noga acrashä runacunami canga.","poem":1},{"lineBreak":true},{"text":"Noganami Diosnin cashaj.","poem":1},"Noga Tayta Diosmi chayno në.»"]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tayta Dios rabyashan fiyu runacunapäga caycan löcu tamyano,","poem":1},{"lineBreak":true},{"text":"löcu wayra ima-aycatapis apacojnömi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tayta Dios rabyashanga manami päsangachu yarpashanta manaraj rurayta ushashancamaga.","poem":1},{"lineBreak":true},{"text":"Llapan chaycunata gamcunaga juc junajrämi tantiyanquipaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}