{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":31,"content":[{"type":"heading","content":["Israelcuna nasyunninman cutinanpaj cashan"]},{"type":"verse","number":1,"content":["Tayta Diosmi nin: «Chay wichanga nogami llapan Israelcunapa Diosnin cashaj. Paycunanami acrashä runacuna canga.»"]},{"type":"verse","number":2,"content":["Tayta Diosmi nin:",{"text":"«Wañuypita gueshpej Israelcunata","poem":1},{"lineBreak":true},{"text":"chunyajchöga amatar cuyashätami musyachirä.","poem":1},{"lineBreak":true},{"text":"Paycunaga ñacaypita jamaycäriytami munaycaran.»","poem":1}]},{"type":"verse","number":3,"content":["Paycunataga unay yuriparcurmi nirä:",{"text":"«Nogaga gamcunata fiyupami cuyä.","poem":1},{"lineBreak":true},{"text":"Chaymi cananpis cuyapayllapa ricaycä.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cuyashä Israelcuna, yapaynami jatarachishayquipaj.","poem":1},{"lineBreak":true},{"text":"Chauraga yapaymi panderëtacunawan shamunquipaj","poem":1},{"lineBreak":true},{"text":"cushisha dansaraycar aduramänayquipaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Samaria partipa jircancunachömi","poem":1},{"lineBreak":true},{"text":"übascunata yapay lantanquipaj.","poem":1},{"lineBreak":true},{"text":"Übasta lantajcunaga","poem":1},{"lineBreak":true},{"text":"wayushanta cushishami pallanquipaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Juc junäga ricchacojcuna","poem":1},{"lineBreak":true},{"text":"Efraín trïbu runacuna tiyashan jircacunapita gayacongapaj:","poem":1},{"lineBreak":true},{"text":"‹Llapayqui shamuy,","poem":1},{"lineBreak":true},{"text":"Tayta Diosninchi Sioncho caycashanman aywanapaj› nir.»","poem":1}]},{"type":"verse","number":7,"content":["Tayta Dios nin:",{"text":"«Jacobpita miraj Israelcunapaj cushisha cantay.","poem":1},{"lineBreak":true},{"text":"Paycunapa nasyunninmi waquin nasyuncunapitaga mas rispitasha caycan.","poem":1},{"lineBreak":true},{"text":"Cushisha alabar niy:","poem":1},{"lineBreak":true},{"text":"‹Cawaycar quëdaj Israel runacunataga","poem":1},{"lineBreak":true},{"text":"acrashan runacuna captinmi Tayta Dios salban› nir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Paycunataga norte caj-lächo caycaj nasyunpitami cutichimushaj.","poem":1},{"lineBreak":true},{"text":"May-chaycho caycajtapis shuntamushämi.","poem":1},{"lineBreak":true},{"text":"Paycunawanmi shamonga gapracuna, wegrucuna,","poem":1},{"lineBreak":true},{"text":"itiyoj warmicuna, gueshyaj warmicunapis.","poem":1},{"lineBreak":true},{"text":"¡Fiyupa aypallami cutimonga!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Arpinticusha carmi wagaraycar cutimonga.","poem":1},{"lineBreak":true},{"text":"Noganami shogashpä chuya yacu aywaycajman pushashaj.","poem":1},{"lineBreak":true},{"text":"Pampa nänillanpami pushamushaj imamanpis mana tacacänanpaj.","poem":1},{"lineBreak":true},{"text":"Nogami cä Israelpa taytan.","poem":1},{"lineBreak":true},{"text":"Israelga guechpa wamrämi.»","poem":1}]},{"type":"verse","number":10,"content":["Nasyuncunata Tayta Dios nin:",{"text":"«Noga imata nishätapis wiyay.","poem":1},{"lineBreak":true},{"text":"Nircur lamar cantunpa carucho tiyajcunata willapay.","poem":1},{"lineBreak":true},{"text":"Willapar ninqui: ‹Israel runacunataga Diosmi intëruman mashtacächiran.","poem":1},{"lineBreak":true},{"text":"Cananga shuntaycushpannami ricanga uyshëru uyshancunata ricashanno.›","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chaynöga ricashaj Jacobpita mirajcunata shuntamusha cashpämi.","poem":1},{"lineBreak":true},{"text":"Paycunataga fiyupa munayniyoj nasyunpitami jorgamushcä.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Cutiycamorga Sionman aywaycärir cushisha cantanga.","poem":1},{"lineBreak":true},{"text":"Bindisyunnëwanmi cushisha goyanga.","poem":1},{"lineBreak":true},{"text":"Achcami canga rïgupis, bïnupis, asëtipis, uyshapis, wäcapis.","poem":1},{"lineBreak":true},{"text":"Chaura paycunaga caycangapaj alli pargusha wertanömi.","poem":1},{"lineBreak":true},{"text":"Manami yapayga imaypis ñacanganachu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Cushishami dansanga jipashcunapis","poem":1},{"lineBreak":true},{"text":"auquincunapis, mösucunapis.","poem":1},{"lineBreak":true},{"text":"Nogami cushicachishäpaj.","poem":1},{"lineBreak":true},{"text":"Llaquicur wagashanpitapis cushicur goyänanpämi camacächishaj.","poem":1},{"lineBreak":true},{"text":"Llaquicur ñacashanpitapis masrämi cushicachishaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nogami camacächishaj cüracuna alli micuyllata micunanpaj.","poem":1},{"lineBreak":true},{"text":"Noga bindisyunta goshäwanmi acrashä runacunaga cushisha goyanga.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"verse","number":15,"content":["Tayta Diosmi nin:",{"text":"«Ramá marcachömi llaquicushan wiyacan.","poem":1},{"lineBreak":true},{"text":"Llaquicuypita fiyupa gaparaypami wagaycan.","poem":1},{"lineBreak":true},{"text":"Raquelmi wamrancunata apacushanpita fiyupa wagaycan.","poem":1},{"lineBreak":true},{"text":"Wamrancuna manana captinmi","poem":1},{"lineBreak":true},{"text":"pï shoganantapis mana munanchu.»","poem":1}]},{"type":"verse","number":16,"content":["Tayta Diosmi nin:",{"text":"«Raquel, ama wagaynachu.","poem":1},{"lineBreak":true},{"text":"Amana weguiquita ushaynachu.","poem":1},{"lineBreak":true},{"text":"Llaquicushayquimannömi päguyquita chasquinquipaj.","poem":1},{"lineBreak":true},{"text":"Wamrayquicunami cutimongapaj apashan nasyunpita.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":17,"content":[{"text":"Shamoj watacunacho gampäga cushicuymi canga.","poem":1},{"lineBreak":true},{"text":"Wamrayquicunaga nasyunninmanmi cutimonga.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":18,"content":[{"text":"Wiyashcämi acrashä runacuna llaquicur parlajta.","poem":1},{"lineBreak":true},{"text":"Paycunaga nisha:","poem":1},{"lineBreak":true},{"text":"‹Nogacunaga goyäcurä manaraj aroj törunömi.","poem":1},{"lineBreak":true},{"text":"Chayno caycajtami gam castigamashpayqui manshuyächimashcanqui.","poem":1},{"lineBreak":true},{"text":"Yapay shuntacamay ari.","poem":1},{"lineBreak":true},{"text":"Gammi canqui nogacunapa Tayta Diosnëga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mana cäsushpämi gamta gongaycurä.","poem":1},{"lineBreak":true},{"text":"Cananga yarpachacur arpinticushcämi.","poem":1},{"lineBreak":true},{"text":"Juchayoj cashätapis tantiyacushcämi.","poem":1},{"lineBreak":true},{"text":"Chaymi cananga llaquicur pëchöta tacacuycä.","poem":1},{"lineBreak":true},{"text":"Cananga pengay-tucushami uysuraycä, juchata rurashäpita› nir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Israelcuna, gamcunaga acrashä runacunami canqui.","poem":1},{"lineBreak":true},{"text":"Gamcunataga fiyupami cuyä.","poem":1},{"lineBreak":true},{"text":"Fiyupa piñacurpis simrimi gamcunataga llaquiraycä.","poem":1},{"lineBreak":true},{"text":"Shongöpis nanayparämi nanaycan.","poem":1},{"lineBreak":true},{"text":"Gamcunataga fiyupami cuyapä.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«¡Cuyashä Israelcuna cutimuyna ari!","poem":1},{"lineBreak":true},{"text":"¡Siudäniquicunamanna cutiy!","poem":1},{"lineBreak":true},{"text":"Aywashayqui nänicho señal caycajcunata ashiy","poem":1},{"lineBreak":true},{"text":"aywashallayquipa cutimunayquipaj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"¿Imaycamataj puricunqui mana wiyacoj jipashno?","poem":1},{"lineBreak":true},{"text":"Cay munduchöga noga Tayta Diosmi almiraypajcunata camacächishaj:","poem":1},{"lineBreak":true},{"text":"Runanman warmi cutejnömi gamcunaga nogaman cutimunquipaj.»","poem":1}]},{"type":"heading","content":["Israelcuna allina goyänanpaj cashan"]},{"type":"verse","number":23,"content":["Israelcunapa munayniyoj Tayta Diosnin nin: «Judá runacunataga cutichishaj ñaupata tiyashan partimanmi, siudänincunamanmi. Chaycho tiyajcunaga yapaynami parlangapaj: ‹¡Alli goyay caycashan rispitädu jircaman Tayta Dios bindisyunninta churaycuchun!› nir."]},{"type":"verse","number":24,"content":["Chay ñaupata tiyashan partichömi Judá runacunapis, siudäcunacho tiyajcunapis, chacracho arojcunapis, uyshayojcunapis yapay tiyanga."]},{"type":"verse","number":25,"content":["Fiyupa uticasha caycajtaga nogami jamachishaj. Ñacaycajcunataga nogami jorgushaj.»"]},{"type":"verse","number":26,"content":["Chayno niycämaptin riccharaycamurä. Chaynöta suyñuycur fiyupa cushicurä."]},{"type":"verse","number":27,"content":["Tayta Diosmi nin: «Shamoj watacunachöga Israel runacunapis, Judá runacunapis, uywacunapis aypallaman mirananpämi camacächishaj."]},{"type":"verse","number":28,"content":["Nogaga guewatanömi achurirä, sajtargärirä, jitarirä, illgächirä, mana alliman chayachirä. Chayno rurashämannömi ricaycäshaj jatarachinäpaj, lantajnöpis yachacächinäpaj. Noga Tayta Diosmi chayno në."]},{"type":"verse","number":29,"content":["«Chay wichanga manami parlanganachu:",{"text":"« ‹Taytancuna micusha pochgoj übasta.","poem":1},{"lineBreak":true},{"text":"Chaymi wamrancunapa quirun shimpasha caycan› nir.","poem":1}]},{"type":"verse","number":30,"content":["Pipis pochgoj übasta micuptenga chay micoj cajpami quirun shimpanga. Chaynöpis juchata ruraj cajmi juchanpitaga wañonga.»"]},{"type":"heading","content":["Mushoj conträtuta rurananpaj cashan"]},{"type":"verse","number":31,"content":["Tayta Diosmi nin: «Juc junajmi yapay mushoj conträtuta rurashaj Israel runacunawan Judá runacunawan."]},{"type":"verse","number":32,"content":["Chay conträtoga manami canganachu unay caj awiluncunata Egiptupita jorgamur paycunawan conträtuta rurashänöga. Awiluncunaga nogapa caycashpanpis chay conträtu rurashäta manami cumliranchu. Noga Tayta Diosmi chayno në."]},{"type":"verse","number":33,"content":["Israelcunawanga caynömi conträtuta rurashaj: Laynëcunatami paycunapa shongunman isquirbishaj. Yarpayninmanpis churashaj. Paycunami acrashä runacuna canga, noganami Diosnin cashaj. Noga Tayta Diosmi chayno në."]},{"type":"verse","number":34,"content":["Noga pï cashätapis musyananpaj mananami jucnin-jucninpis yachachinacongapänachu. Noga pï cashätapis mas jatunpita tacshacama llapannami musyanga. Llapan juchancunatami perdunashaj. Chayno perdunaycorga mananami yarpäshänachu ima jucha rurashancunatapis. Noga Tayta Diosmi chayno në.»"]},{"type":"heading","content":["Israelcunata mana cachaycunanpaj cashan"]},{"type":"verse","number":35,"content":[{"text":"Tayta Diosmi churaran intita, junajpa achicyananpaj.","poem":1},{"lineBreak":true},{"text":"Quillatawan goyllarcunatana churaran chacaypa achicyananpaj.","poem":1},{"lineBreak":true},{"text":"Paymi camacächin lamarpis pullchajyar gaparänanpaj.","poem":1},{"lineBreak":true},{"text":"Paypa jutenga munayniyoj Tayta Diosmi. Paymi nin:","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"«Imayllapis chaycuna manana captenga","poem":1},{"lineBreak":true},{"text":"Israelcunapis manami noga acrashä runacunanachu canman.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":37,"content":[{"text":"Imay junajllapis janaj syëlu tupusha captenga","poem":1},{"lineBreak":true},{"text":"cay pacha imacho jamaraycashantapis imayllapis ricaptenga","poem":1},{"lineBreak":true},{"text":"Israelcunataga mana allicunata rurashanpita gargömanmi.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"verse","number":38,"content":["Tayta Diosmi nin: «Juc junäga siudänë allchachicangapämi. Allchachicanga ricchacunapaj Hananeelcho caycaj törripita-pacha Isquïna Puncucama."]},{"type":"verse","number":39,"content":["Chaypa pergan aywaranga derëchu Gareb puytush lömacama. Chaypita tumarämonga Goa partimanna."]},{"type":"verse","number":40,"content":["Wañushacunata pampanan, uchpata jitaricunan guechwa pampa, Cedrón mayupa jan'gan chacracuna, Cawalluta Wichgacunanpa Puncun chimpancama nogapaj acrasha rispitädunami caycangapaj. Chaypa tumaraj pergacunataga manami imaypis yapay tunichenganachu ni illgächenganapischu.»"]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}