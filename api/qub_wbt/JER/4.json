{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":4,"content":[{"type":"heading","content":["Arpinticunanpaj willapashan"]},{"type":"verse","number":1,"content":["Chayno niptinna Tayta Dios niran:",{"text":"«Israelcuna nogamanna cutimuyta munarga juchayquicunapita arpinticunquiman.","poem":1},{"lineBreak":true},{"text":"Mana sirbej ïduluyquicunata jitariycuptiqui,","poem":1},{"lineBreak":true},{"text":"Noga munashänöllana ruraptiqui,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"rasunpa juraptiqui","poem":1},{"lineBreak":true},{"text":"llapan nasyuncunapis bindisyunta chasquengami.","poem":1},{"lineBreak":true},{"text":"Chauraga runacuna cushicushpan nogatami alabamanga.»","poem":1}]},{"type":"verse","number":3,"content":["Jerusalén runacunatawan Judá runacunata Tayta Dios cayno nin:",{"text":"«Jamaj chacrata quichajno shonguyquicunata camariy.","poem":1},{"lineBreak":true},{"text":"Amana sïguir muruynachu mana alli custumriquicuna shatano caycajmanga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jerusalén runacuna, Judá runacuna cuerpullayquichöga ama señalacuychu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga rumi shonguyquitapis camariy conträtuta rurar parlashanchïta cumlinayquipaj.","poem":1},{"lineBreak":true},{"text":"Chayno mana ruraptiquega illajpitami fiyupa rabyacurcushaj.","poem":1},{"lineBreak":true},{"text":"Rabyacurcuptëga manami pipis allchacächimangapächu.","poem":1},{"lineBreak":true},{"text":"Nina ratariptin pipis upichiyta mana camäpacushannömi ricacushaj.","poem":1}]},{"type":"heading","content":["Judäman juc nasyun runacuna yaycunanpaj cashan"]},{"type":"verse","number":5,"content":[{"text":"«Jerusalencho, Judächo tiyajcunata willay-llapa.","poem":1},{"lineBreak":true},{"text":"Trompëtacunata tucashpayqui nasyun intërupa willacuy-llapa.","poem":1},{"lineBreak":true},{"text":"Callpaypa gayacuy: ‹¡Llapanchi shuntacäshun!","poem":1},{"lineBreak":true},{"text":"¡Curalasha siudäcunaman yaycucushun!› nir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bandërayquicunawan sëñata ruray Sión caj-läman.","poem":1},{"lineBreak":true},{"text":"Ama wiyaraychu-llapa.","poem":1},{"lineBreak":true},{"text":"Mayman pacacunayquipäpis ashiy-llapa.","poem":1},{"lineBreak":true},{"text":"Nortipitami apamushaj wañuchicojcunata.","poem":1},{"lineBreak":true},{"text":"Chauraga fiyupa ñacaymi canga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Puñunancho caycashanpita cäsata ashej liyun aywajnömi","poem":1},{"lineBreak":true},{"text":"nasyuncunata ushajpaj illgächej aypalla suldärucuna aywaycämun.","poem":1},{"lineBreak":true},{"text":"Nasyunniquicunata illgächinanpämi aywarcaycämun.","poem":1},{"lineBreak":true},{"text":"Paycunami siudäniquicunatapis ragällan chunyajta cachayconga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaymi gachga röpacunata jaticuy.","poem":1},{"lineBreak":true},{"text":"Fiyupa wagashpayqui nanächicuycajnöraj gaparpay.","poem":1},{"lineBreak":true},{"text":"Nogaga jinallami nina ratarejnöpis","poem":1},{"lineBreak":true},{"text":"gamcunapaj fiyupa rabyaycä.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["Tayta Diosmi cayno nin:",{"text":"«Chay junaj chayamuptenga","poem":1},{"lineBreak":true},{"text":"raypis, mandajcunapis manchariywan sicsicyangami.","poem":1},{"lineBreak":true},{"text":"Cüracunapis fiyupami mancharengapaj.","poem":1},{"lineBreak":true},{"text":"Profëtacunapis jupayllashanömi ricacongapaj.»","poem":1}]},{"type":"verse","number":10,"content":["Chayno niptin noga Jeremías nirä: «¡Ay Tayta Dios, imanöshi Jerusalén runacunata engañashcanqui! Gamga aunirayqui ‹imaypis alli goyayllami canga› nirchaj. Chaypis runacunaga wañunanpaj cuncanman cuchillun churapacushanömi carcaycan.»"]},{"type":"verse","number":11,"content":["Tayta Diosnami nimaran:",{"text":"«Chay junäga Jerusalén runacunata nengapaj:","poem":1},{"lineBreak":true},{"text":"‹Chunyajpitami acaj wayra wayraycämun acrashä runacuna cajman› nir.","poem":1},{"lineBreak":true},{"text":"Chay wayraga manami rïguta wayrananpaj shamoj wayranöchu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Noga wayrächimushä wayraga cangapaj fiyu wayrami.","poem":1},{"lineBreak":true},{"text":"Cananmi yarpäshaj paycuna imano jusgasha cananpäpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Chaura Israelcuna nengapaj: ‹Masqui ricäriy. Contranchïcunaga pucutaynömi aywarcaycämun.","poem":1},{"lineBreak":true},{"text":"Pillyapaj carrëtancunapis löcu wayranörämi.","poem":1},{"lineBreak":true},{"text":"Cawalluncunapis ancapita masrämi cörriycämun.","poem":1},{"lineBreak":true},{"text":"¡Cananchi cananllaga! ¡Manami imanöpa gueshpiytapis camäpacunchïnachu!› nir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chaura noganami nishäpaj: ‹Jerusalén runacuna jucha rurashayquicunapita arpinticuy.","poem":1},{"lineBreak":true},{"text":"Chaynöparämi salbacunquipaj.","poem":1},{"lineBreak":true},{"text":"¿Imaycamaraj jucha rurayllapaj yarparcaycanqui?› nir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dan trïbu, Efraín trïbu runacuna tiyashan puytush lömacunapita-pachami","poem":1},{"lineBreak":true},{"text":"mana alli willapacuna chayaycämun.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Jerusalencho tiyajcunata, waquin nasyun runacunatapis willay","poem":1},{"lineBreak":true},{"text":"fiyupa caru nasyunpita contrancuna aywaycämushanta.","poem":1},{"lineBreak":true},{"text":"Paycunaga Judá nasyunman magaj yaycunanpämi büllata ruraraycar aywarcaycämun.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Diosnin caycaptë conträ ricacushanpitami","poem":1},{"lineBreak":true},{"text":"Judá runacunataga runa chacranta tumajno intëru cantunpa contrancuna curalapaycärenga.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":18,"content":[{"text":"Quiquiqui mana allita rurashayquipitami chaynöga päsashurayqui.","poem":1},{"lineBreak":true},{"text":"Fiyupa llaquicuycunaga gamcunaman chayamusha mana allicunata rurashayquipitami.","poem":1},{"lineBreak":true},{"text":"Chayno yarpachacur llaquicuptiqui shonguyquipis nananrämi.»","poem":1}]},{"type":"heading","content":["Marcanpaj Jeremías llaquicushan"]},{"type":"verse","number":19,"content":[{"text":"¡Ay shongullau shongullau!","poem":1},{"lineBreak":true},{"text":"¡Llaquicuywanmi shongö tic-ticyaycan!","poem":1},{"lineBreak":true},{"text":"Pillyapaj trompëta wagamojta, pillyapaj büllata ruraycämojtami wiyashcä.","poem":1},{"lineBreak":true},{"text":"Chaymi jamaytapis manana tarëchu. Manami upällapis cacömanchu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yapay-yapaymi mana allicuna chayaycämun.","poem":1},{"lineBreak":true},{"text":"Nasyuncunapis llapanmi ushacashana.","poem":1},{"lineBreak":true},{"text":"Pachacunäpaj ichichishä toldöcunatapis illajpitami illgarachisha.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"¿Imaycamaraj wiyashaj pillyapaj trompëta wagamojta?","poem":1},{"lineBreak":true},{"text":"¿Imaycamaraj ricashaj conträcuna pillyapaj bandëran aptasha caycajtapis?","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":["Chaura Tayta Dios niran:",{"text":"«Acrashä runacunaga upa, mana tantiyacojmi.","poem":1},{"lineBreak":true},{"text":"Manami rejsimanchu.","poem":1},{"lineBreak":true},{"text":"Mana tantiyacoj yarpayniynaj wamräcunami.","poem":1},{"lineBreak":true},{"text":"Allita ruraytaga manami yachanchu.","poem":1},{"lineBreak":true},{"text":"Mana allita ruraytami ichanga fiyupa yachan.»","poem":1}]},{"type":"heading","content":["Ushacänanpaj cashanta Jeremías ricashan"]},{"type":"verse","number":23,"content":[{"text":"Cay pachata ricäriptë chunyaj manami imapis cashachu.","poem":1},{"lineBreak":true},{"text":"Syëluta ricäriptë manami cashachu ima achicyajpis.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Puntacunata ricäriptë cuyuriycashami.","poem":1},{"lineBreak":true},{"text":"Puytush lömacunapis cuyuriycällarmi juchur ushacaycasha.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ricchacuriptë manami ima runapis cashanachu.","poem":1},{"lineBreak":true},{"text":"Äbicunapis ushajpänami aywacusha casha.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ricäriptë micuy alli wayunan chacracunapis chunyajman ticrashami caycasha.","poem":1},{"lineBreak":true},{"text":"Llapan siudäcunapis illgashanami casha.","poem":1},{"lineBreak":true},{"text":"Chaynöga Tayta Diosmi fiyupa rabyacurcur ruraycusha casha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":["Tayta Diosmi cayno nin:",{"text":"«Cay pachacho cajtaga llapantami illgächishaj.","poem":1},{"lineBreak":true},{"text":"Ichanga manami ushajpäga illgächishärächu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Cay pachachöga fiyupa llaquicuymi canga.","poem":1},{"lineBreak":true},{"text":"Syëlupis chacacäcongarämi.","poem":1},{"lineBreak":true},{"text":"Imano cananpäpis nishätaga manami cutiricushächu.","poem":1},{"lineBreak":true},{"text":"Chayno cananpaj camacächishätaga rasunpami cumlishaj.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Lëchata jitajcuna, muntäducuna gayarashpan shamojta wiyar","poem":1},{"lineBreak":true},{"text":"llapanmi siudäpita gueshpir aywacun.","poem":1},{"lineBreak":true},{"text":"Shatacunaman munticunaman pacacaycärin.","poem":1},{"lineBreak":true},{"text":"Gaga chaupincunaman wichacarcärin.","poem":1},{"lineBreak":true},{"text":"Siudäcunaga llapanpis chunyajmi quëdacun.","poem":1},{"lineBreak":true},{"text":"Chaychöga manami pipis tiyannachu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Chayno captin ¿imataraj ruranqui Sión runacuna?","poem":1},{"lineBreak":true},{"text":"¿Imapätaj murädu röpatapis jaticunqui?","poem":1},{"lineBreak":true},{"text":"¿Imapätaj gori aläjacunatapis churacunqui?","poem":1},{"lineBreak":true},{"text":"¿Imapätaj ñawiquitapis yanawan pintacunqui?","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj cashayquipis yangami.","poem":1},{"lineBreak":true},{"text":"Cuyashayquicunapis llapanmi melanäcushunqui.","poem":1},{"lineBreak":true},{"text":"Paycuna cananga wañunayquitami munarcaycan.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Guechpa wawanta warmi gueshyacunanpaj","poem":1},{"lineBreak":true},{"text":"nanaycho car gaparajno gaparpaycajtami wiyä.","poem":1},{"lineBreak":true},{"text":"Sioncho tiyajcunami maquillan chojpasha gaparpaycan","poem":1},{"lineBreak":true},{"text":"‹¡Cananllapänachari caräpis! ¡Wañuchicojcunami wañuycachimanga!› nir.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}