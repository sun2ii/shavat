{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":46,"content":[{"type":"heading","content":["Nasyuncuna imano cananpaj cashantapis"]},{"type":"verse","number":1,"content":["Nasyuncuna imano cananpaj cashantapis Tayta Diosga profëta Jeremiasta willaparan."]},{"type":"heading","content":["Egipto imano cananpäpis rimashan"]},{"type":"verse","number":2,"content":["Josiaspa wamran Joacim chuscu watana Judäpa raynin caycaran. Y Éufrates mayu lädun Carquemischo Egiptupa mandajnin faraón Necaopa suldäruncuna caycaptinmi paycunataga Babiloniapa raynin Nabucodonosor wañuchir illgächiran. Chay wichanmi Egipto imano cananpaj cashantapis Tayta Diosga profëta Jeremiasta cayno willaparan:"]},{"type":"verse","number":3,"content":[{"text":"«¡Egipto runacuna, chapacuna escüduyquicunata listucuy!","poem":1},{"lineBreak":true},{"text":"¡Nircorga pillyaj ayway!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Cawalluyquicunata sillacuy!","poem":1},{"lineBreak":true},{"text":"¡Muntacuyta yachajcuna muntacuy!","poem":1},{"lineBreak":true},{"text":"¡Cascuyquicunata chucucuy! ¡Nircur sumaj fïlacay!","poem":1},{"lineBreak":true},{"text":"¡Tucsicunayquicunata sumaj afilacuy!","poem":1},{"lineBreak":true},{"text":"¡Chapäshunayquipaj caj chalëcucunata jaticuy!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Ichanga ¿imatataj ricä?","poem":1},{"lineBreak":true},{"text":"Egipto suldärucunaga fiyupa mancharishami gueshpir cuticurcaycan.","poem":1},{"lineBreak":true},{"text":"Binsiycuptinnami pillyajcunaga mashtaypa-mashtar aywacuycan.","poem":1},{"lineBreak":true},{"text":"Mana ticraycuypami gueshpir aywacurcaycan.","poem":1},{"lineBreak":true},{"text":"¡Intërupami manchariypaj caycan!","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":6,"content":[{"text":"Fiyupa cörrejcunapis manami gueshpiyta puydinnachu.","poem":1},{"lineBreak":true},{"text":"Jinyunnincunapis gueshpiyta manami camäpacunchu.","poem":1},{"lineBreak":true},{"text":"Norte caj-lächo Éufrates mayu cantunchöga","poem":1},{"lineBreak":true},{"text":"tacacar llapanmi tunircaycan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¿Maygan nasyuntaj Nilo mayu chayajno achcayaycäga?","poem":1},{"lineBreak":true},{"text":"¿Maygan nasyuntaj mayu chayashpan bötiypa-bötir intërupa mashtacaycajnöga caycan?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nilo mayu chayashpan achcayaycajnöga Egiptumi.","poem":1},{"lineBreak":true},{"text":"Bötiypa-bötir intërupa yacu mashtacaycajnömi caycan.","poem":1},{"lineBreak":true},{"text":"Egipto runacunaga nin: ‹Aypallaman mirashpä intërumanmi juntashaj.","poem":1},{"lineBreak":true},{"text":"Siudäcunatapis llapan runacunatapis ushashami.›","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«¡Cawalluwan muntäducuna pillyaj yaycuy!","poem":1},{"lineBreak":true},{"text":"¡Carrëtawan cajcunapis ayway!","poem":1},{"lineBreak":true},{"text":"Pillyajcuna yaycuy.","poem":1},{"lineBreak":true},{"text":"Ayway Etiopía nasyun suldärucuna, Fut parti suldärucuna chapacuna escüduyquicunata camaricarcärir.","poem":1},{"lineBreak":true},{"text":"Camaricuy lëchawan illapay yachaj Lud parti suldärucuna.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chay junäga cangapaj noga munayniyoj Tayta Dios castiganä junajmi.","poem":1},{"lineBreak":true},{"text":"Chay junajmi llapan conträcunata ayñita cutichishaj.","poem":1},{"lineBreak":true},{"text":"Sablëmi tucsenga yamacashancama.","poem":1},{"lineBreak":true},{"text":"Chayno tucsenga pasaypa yawar ñitinancamami.","poem":1},{"lineBreak":true},{"text":"Chay junäga noga munayniyoj Tayta Diosmi","poem":1},{"lineBreak":true},{"text":"norte caj-lächo caycaj nasyuncho, Éufrates mayu läduncho aypalla runata wañuchishaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«¡Donsëlla jipashno caycaj Egipto runacuna,","poem":1},{"lineBreak":true},{"text":"Galaadman ayway jampi ashej!","poem":1},{"lineBreak":true},{"text":"Aypalla jampita shuntar jampicushayquipis yangami canga.","poem":1},{"lineBreak":true},{"text":"Gamcunapäga mananami jampi cannachu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Intëru nasyun runacunanami musyarcaycan manacajman churasha cashayquita.","poem":1},{"lineBreak":true},{"text":"Intëru nasyunmanmi wiyacaycan gaparpashayqui.","poem":1},{"lineBreak":true},{"text":"Pillyajniquicunaga quiquin-purami tacanacusha.","poem":1},{"lineBreak":true},{"text":"Nircur ishcanmi cuchpasha.»","poem":1}]},{"type":"heading","content":["Egiptuman Nabucodonosor yaycunanpaj cashan"]},{"type":"verse","number":13,"content":["Babiloniapa raynin Nabucodonosor Egiptuman pillyaj yaycunanpaj aywaycaptin Tayta Diosga profëtan Jeremiasta cayno niran:"]},{"type":"verse","number":14,"content":[{"text":"«Egiptucho, Migdolcho, Menfischo, Tafneschöpis cayno willacuy-llapa:","poem":1},{"lineBreak":true},{"text":"‹¡Ricaj-ricajlla camaricushallana carcaycay!","poem":1},{"lineBreak":true},{"text":"¡Intëru ñaupayquipanami sabliwan wañuycächin!›","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Apis jutiyoj töru diosniquega ¿imanirtaj tunisha?","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosmi sajtarishcä.","poem":1},{"lineBreak":true},{"text":"Chay töru diosniquega ¿imanirtaj jinalla mana ichiraycanchu?","poem":1},{"lineBreak":true},{"text":"Chaytaga noga Tayta Diosmi tunirachishcä.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Suldäruyquicunapis tacanacushpan tunin.","poem":1},{"lineBreak":true},{"text":"Jucnin-jucninpis ninacun:","poem":1},{"lineBreak":true},{"text":"‹Caypitaga llapanchi cuticushun marcanchïman-cama.","poem":1},{"lineBreak":true},{"text":"Yurishanchi marcanchïman cuticushun.","poem":1},{"lineBreak":true},{"text":"Wañuchinacuypita gueshpir aywacushun› nir.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chayno ninacur gaparpan: ‹Egiptupa mandajnin faraonga ricayllanmi.","poem":1},{"lineBreak":true},{"text":"Manami imata ruraytapis camäpacunchu› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Nogaga munayniyoj Raymi cä.","poem":1},{"lineBreak":true},{"text":"Jutëcho jurarmi në:","poem":1},{"lineBreak":true},{"text":"Puntacunapa chaupincho Tabor punta ichiraycajno,","poem":1},{"lineBreak":true},{"text":"lamarpita ichiraycaj Carmelo puntanömi","poem":1},{"lineBreak":true},{"text":"Egipto runacunapa contran shamunanpaj caycäga caycan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Egipto runacuna camaricuyna prësu aywanayquipaj.","poem":1},{"lineBreak":true},{"text":"Menfisga chunyajmi ricacongapaj.","poem":1},{"lineBreak":true},{"text":"Juchusha ragällan captin pipis manami tiyangapänachu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Egiptucunaga caycan cuyayllapaj ternëra-nirajmi.","poem":1},{"lineBreak":true},{"text":"Chayno caycajta cañiycunanpämi norte caj-läpita upucruy aywaycämun.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Guellaypaj pillyaj mincaynincunapis wera töru-mallwacunanömi.","poem":1},{"lineBreak":true},{"text":"Ichanga paycunapis upucruypita gueshpirmi aywaconga.","poem":1},{"lineBreak":true},{"text":"Pillyananpäpis manami ichipangapänachu.","poem":1},{"lineBreak":true},{"text":"Paycuna disigrasyaman chayanan junäga chayaycämunnami.","poem":1},{"lineBreak":true},{"text":"Castigasha canan junäga chayaycämunnami.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yöracunata mutur sajtajnöpis aypalla suldärucuna yaycapaycuptinmi","poem":1},{"lineBreak":true},{"text":"Egiptucho tiyajcunaga gueshpir","poem":1},{"lineBreak":true},{"text":"aywaconga culebra wichyashpan gueshpejnöraj.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"¡Chay contrancunaga jirasha caycaj muntincunatapis chagurengami!","poem":1},{"lineBreak":true},{"text":"Yaycoj runacunaga chüpacacunapitapis mas aypallami canga.","poem":1},{"lineBreak":true},{"text":"Yupaytapis manami pipis atipangachu.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":24,"content":[{"text":"Egiptucho tiyajcunaga fiyupa pengay-tucushami ricaconga.","poem":1},{"lineBreak":true},{"text":"Paycunaga norte caj-lä nasyun runacunapa maquinchönami ricaconga.»","poem":1}]},{"type":"verse","number":25,"content":["Israelcunapa munayniyoj Tayta Diosninmi nin: «Tebaspa diosnin Amonta, Egiptupa diosnincunata, raynincunata, faraonta, faraonman yäracojcunatapis llapantami castigashaj."]},{"type":"verse","number":26,"content":["Nogami camacächishaj fiyupa chiquej Babiloniapa raynin Nabucodonosorpa maquincho cananpaj, pay mandashan runacunapa maquincho cananpaj. Chaypita mas unaytanami ichanga unay tiyashannöna yapay Egiptucho runacuna tiyacongapaj. Noga Tayta Diosmi chayno në.»"]},{"type":"heading","content":["Acrashancunata Tayta Dios salbananpaj cashan"]},{"type":"verse","number":27,"content":[{"text":"«Jacobpita mirar aywaj Israelcuna ama manchacuychu.","poem":1},{"lineBreak":true},{"text":"Sirbimajcuna ama juc-nirajyaypischu.","poem":1},{"lineBreak":true},{"text":"Maymanpis caru nasyunman apashushayquipitami","poem":1},{"lineBreak":true},{"text":"gamcunata, llapan wamrayquicunatapis jorgamushayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaypitaga allillanami goyäcunquipaj.","poem":1},{"lineBreak":true},{"text":"Pipis manami manchachishunquipänachu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Jacobpita mirar aywaj sirbimajcuna ama manchacuychu.","poem":1},{"lineBreak":true},{"text":"Nogami gamcunawan caycä.","poem":1},{"lineBreak":true},{"text":"Gamcunata jitarishächo tiyaycashayqui nasyun runacunataga","poem":1},{"lineBreak":true},{"text":"llapantami illgächishaj.","poem":1},{"lineBreak":true},{"text":"Gamcunatami ichanga mana illgächishayquipächu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga juchayqui-tupullami castigashayqui.","poem":1},{"lineBreak":true},{"text":"Castigänillataga manami cachaycushayquipächu.","poem":1},"Noga Tayta Diosmi chayno në.»"]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}