{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":47,"content":[{"type":"heading","content":["Filistea imano cananpäpis rimashan"]},{"type":"verse","number":1,"content":["Gaza siudäman faraón manaraj magaj yaycuptin Tayta Diosga profëtan Jeremiasta Filistea runacunapaj cayno willaparan:"]},{"type":"verse","number":2,"content":[{"text":"«Noga Tayta Diosmi në:","poem":1},{"lineBreak":true},{"text":"Mayu chayar intëru pampapa mashtacar yagacuycojnömi norte caj-läpita runacuna chayamoj-aywan.","poem":1},{"lineBreak":true},{"text":"Chay suldärucuna cay nasyunmanga intërumanmi yagacaycärenga,","poem":1},{"lineBreak":true},{"text":"siudäcunamanpis, chay siudäcunacho tiyaycajcunamanpis.","poem":1},{"lineBreak":true},{"text":"Chay nasyuncho tiyajcunaga llapanmi gaparpanga.","poem":1},{"lineBreak":true},{"text":"Intëruchömi runacunaga nanächicur gaparpanga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cawallucuna cörriptin chaquincuna pagraraptin,","poem":1},{"lineBreak":true},{"text":"carrëtacunapis tagraraptin,","poem":1},{"lineBreak":true},{"text":"ruyrancuna aywashanpis wiyacaptin,","poem":1},{"lineBreak":true},{"text":"papänincunaga wamrancunata cachariycärin","poem":1},{"lineBreak":true},{"text":"llapanta gueshpichinanpaj callpan ni maquinpis mana aypaptin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Filistea runacunata ushajpaj wañuchinanpaj caj junaj chayamushanami.","poem":1},{"lineBreak":true},{"text":"Tiro runacunatawan Sidón runacunata yanapänanpäga manami canganachu.","poem":1},{"lineBreak":true},{"text":"Paycunatapis usharishämi.","poem":1},{"lineBreak":true},{"text":"Rasunpami ushacächishaj","poem":1},{"lineBreak":true},{"text":"Lamar chaupin Creta tishgupita shamoj Filistea runacunataga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gazacho tiyaj runacunaga fiyupa llaquicushpanmi ajchancunatapis rutucun.","poem":1},{"lineBreak":true},{"text":"Ascalón siudächo tiyaj runacunapis upayashanömi ricacun.","poem":1},{"lineBreak":true},{"text":"Waquin guechwa pampacunacho quëdajcuna","poem":1},{"lineBreak":true},{"text":"¿imaycamaraj llaquicuywan garayquicunata cuchucurcaycanqui?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paycunaga llaquicur nircaycan:","poem":1},{"lineBreak":true},{"text":"‹¡Tayta Diospa sablin!","poem":1},{"lineBreak":true},{"text":"¿imayraj jamaycunqui?","poem":1},{"lineBreak":true},{"text":"Churaränayquiman cashgan cuticuy.","poem":1},{"lineBreak":true},{"text":"Jamacuyna. Amana cuyucuynachu› nir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ichanga ¿imanöpataj mana cuyucuypa cacunman","poem":1},{"lineBreak":true},{"text":"illgächinäpaj cachasha caycaptëga?","poem":1},{"lineBreak":true},{"text":"Nogami cachashcä Ascaloncho cajcunata, lamar cantuncho cajcunata llapanta wañuchinanpaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}