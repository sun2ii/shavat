{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":48,"content":[{"type":"heading","content":["Moab imano cananpäpis rimashan"]},{"type":"verse","number":1,"content":["Israelcunapa munayniyoj Tayta Diosninmi Moab nasyun imano cananpäpis cayno nin:",{"text":"«¡Ay imanöraj canqui Nebo siudä!","poem":1},{"lineBreak":true},{"text":"Pasaypa ushacashami canquipaj.","poem":1},{"lineBreak":true},{"text":"Quiriataim siudächo tiyajcunataga llapantami prësu charenga.","poem":1},{"lineBreak":true},{"text":"Chaymi fiyupa pengaypaj canga.","poem":1},{"lineBreak":true},{"text":"Curalasha caycaj pacacunantapis ushajpämi juchurachenga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alli cashanta Moabpäga mananami imaypis parlanganachu.","poem":1},{"lineBreak":true},{"text":"Contrancuna Hesbón siudächo llapanmi parlacurcaycan:","poem":1},{"lineBreak":true},{"text":"‹Moab nasyunta ushajpaj illgächishun› nir.","poem":1},{"lineBreak":true},{"text":"Madmén marca, gampis illgächishami canquipaj.","poem":1},{"lineBreak":true},{"text":"Imaypis guërrallachömi canquipaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Horonaim siudäpita-pachami wiyacaycan","poem":1},{"lineBreak":true},{"text":"‹¡Ragällan, illgächishami siudäninchi caycan!› nir gaparpashan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Moabga pasaypa ushacashami canga.","poem":1},{"lineBreak":true},{"text":"Nanächicur gaparashancunaga Zoarcamanami wiyacaycan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Luhit cuestatapis","poem":1},{"lineBreak":true},{"text":"wagaraycarmi wicharcaycan.","poem":1},{"lineBreak":true},{"text":"Horonaimman urajcunanami urarcaycan","poem":1},{"lineBreak":true},{"text":"ushacächishanpita fiyupa llaquicushpan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Gueshpicuy-llapa! ¡Wañuyta mana munaj cäga imanöpapis gueshpicuy!","poem":1},{"lineBreak":true},{"text":"¡Chunyaj chaqui jircacho shira caycajno tiyacuy-llapa!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Moab, gamga munayniyoj cashayquimanmi,","poem":1},{"lineBreak":true},{"text":"imay-aycayquipis cashanmanmi yäracoj-canqui.","poem":1},{"lineBreak":true},{"text":"Ichanga gamcunatapis prësumi charishunquipaj.","poem":1},{"lineBreak":true},{"text":"Quemós diosniquita, cürayquicunata, mandaj runacunatapis prësumi apanga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Contrayquicunaga llapan siudäcunatami illgächenga.","poem":1},{"lineBreak":true},{"text":"Manami ni jucnayllapis sänuga quëdangapächu.","poem":1},{"lineBreak":true},{"text":"Ragra pampacho cajcunapis, altu jircacho cajcunapis illgächishami canga.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":9,"content":[{"text":"Moab nasyuntaga ushajpämi illgächej-aywan.","poem":1},{"lineBreak":true},{"text":"Siudänincunapis juchusha ragällanmi quëdanga.","poem":1},{"lineBreak":true},{"text":"Manami ni jucnayllapis runa tiyangapänachu.","poem":1},{"lineBreak":true},{"text":"Chaymi Moabta yarpänanpaj juc señalta churapay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«¡Nishäcunata guellanayllapa rurajcunaga maldisyunädu cachun!","poem":1},{"lineBreak":true},{"text":"¡Wañuchinanpaj niycaptë mana wañuchej cajpis maldisyunädu cachun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Moab runacunaga imaypis jaucallami goyasha.","poem":1},{"lineBreak":true},{"text":"Paycunataga manami imaypis nasyunninpita juc-läman prësu apashachu.","poem":1},{"lineBreak":true},{"text":"Paycunaga caycan mana jäcachiypa wiñarasha bïnunömi.","poem":1},{"lineBreak":true},{"text":"Chaynöpami alli jömuyniyoj, sumaj mishquej bïnuno caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["«Ichanga noga Tayta Dios në:",{"text":"«Juc junäga runacunatami cachamushaj chay juc pachallacho wiñaräcoj bïnuta jucman-jucman tacshir-ushananpaj.","poem":1},{"lineBreak":true},{"text":"Jinaylla caj wiñacunatana paquir usharenga.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chayrämi Moab runacunaga Quemós diosninpita pengaconga.","poem":1},{"lineBreak":true},{"text":"Israel runacuna Betelcho caycaj altarman amatar yäracushanpita pengacushannömi pengacongapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Moab runacuna ama nichunchu: ‹Jinyu runacunami cä.","poem":1},{"lineBreak":true},{"text":"Guërracho pillyay yachaj munayniyoj runacunami cä› nir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chayamonganami Moabcho, siudänincunacho tiyajcuna illgänanpaj,","poem":1},{"lineBreak":true},{"text":"allinnin caj mösucunapis ushajpaj wañunanpaj.","poem":1},{"lineBreak":true},{"text":"Chayno cananpäga Israelcunapa raynin noga Tayta Diosmi nishcä.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Moab runacuna mana alliman chayananpäga wallcanami pishin.","poem":1},{"lineBreak":true},{"text":"Paycuna ushacänanpäga manami aycäpis cannachu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Moabpa läduncho caycajcuna,","poem":1},{"lineBreak":true},{"text":"imano munayniyoj cashantapis musyajcuna paypaj wagay.","poem":1},{"lineBreak":true},{"text":"Paypaj cayno niy: ‹¡Wawallau, imanöshi quëdasha munayniyoj,","poem":1},{"lineBreak":true},{"text":"pipis mana binsishan, fiyupa allicho goyaj Moab nasyun!› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Dibón siudä runacuna alli-tucur rispitäducho","poem":1},{"lineBreak":true},{"text":"jamaraycashayquipita llojshircur chucru chaqui pampamanna jamacuy.","poem":1},{"lineBreak":true},{"text":"Illgächicöga gamcuna cajchönami caycan.","poem":1},{"lineBreak":true},{"text":"Sumaj curalasha pergayquicunatapis maynami illgächisha.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aroer siudächo tiyajcunana","poem":1},{"lineBreak":true},{"text":"näniman aywaycur ricchacuy.","poem":1},{"lineBreak":true},{"text":"Nircur wañuypita gueshpiycajcunata tapucuy ‹¿imataj casha?› nir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Moabtaga illgächishanami.","poem":1},{"lineBreak":true},{"text":"¡Llaquicur wagay chay nasyunpaj!","poem":1},{"lineBreak":true},{"text":"Moabta illgächishantaga willacuy","poem":1},{"lineBreak":true},{"text":"Arnón mayu wichancho.","poem":1}]},{"type":"verse","number":21,"content":["«Pata janancunacho caycaj siudäcunata castiganäpaj nishä castïgu chayashanami. Chay castigashä siudäcunaga caycan: Holón, Jahaza, Mefaat,"]},{"type":"verse","number":22,"content":["Dibón, Nebo, Bet-diblataim,"]},{"type":"verse","number":23,"content":["Quiriataim, Bet-gamul, Bet-meón,"]},{"type":"verse","number":24,"content":["Queriot, Bosra, Moabcho caycaj llapan siudäcuna carucho sercacho caycajcunapis."]},{"type":"verse","number":25,"content":[{"text":"«Moabga manami munayniyojnachu.","poem":1},{"lineBreak":true},{"text":"Callpayoj cashanpis ushacashanami.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":26,"content":[{"text":"Moab runacunaga nogapa conträmi ricacuran.","poem":1},{"lineBreak":true},{"text":"Chaypita paycunataga rabyasha caycashä cöpawan machächiy.","poem":1},{"lineBreak":true},{"text":"Machacarcärerga gumitashan jananchömi gochpanga.","poem":1},{"lineBreak":true},{"text":"Chaura llapanmi asipanga.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Moab runacuna, gamcunaga Israelcunata asipajmi canqui.","poem":1},{"lineBreak":true},{"text":"Asipashpayquimi suwatanöpis manacajman churaj canqui.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Moab runacuna, siudäta cachaycärir gueshpicuy.","poem":1},{"lineBreak":true},{"text":"Gaga chaupincunaman aywacuy","poem":1},{"lineBreak":true},{"text":"paluma gagapa wirpancunacho gueshtata ruraycur tiyajno tiyacunayquipaj.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Pï-maypis musyanmi Moab runacuna alli-tucushanta,","poem":1},{"lineBreak":true},{"text":"waquinpita mas ollgoj munayniyoj-tucushanta, pitapis mana rispitaj cashanta,","poem":1},{"lineBreak":true},{"text":"baduläqui cashanta.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nogaga musyämi lïsu cashanta,","poem":1},{"lineBreak":true},{"text":"baduläqui cashanta, shimillanwan pitapis manchachej cashanta.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Chaymi fiyupa llaquicushpä wagashaj","poem":1},{"lineBreak":true},{"text":"Moab nasyuncho tiyajcunapaj,","poem":1},{"lineBreak":true},{"text":"Kir-hares siudächo tiyaj runacunapäpis.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Jazer siudäpaj wagashäpitaga masrämi wagashaj Sibma marcacho caj übas chacrapäga.","poem":1},{"lineBreak":true},{"text":"Rämayquicunapis lamarpa washa chimpancamarämi chayarasha.","poem":1},{"lineBreak":true},{"text":"Chayno päsararmi chayasha Jazercama.","poem":1},{"lineBreak":true},{"text":"Cananga übas chacrayquita pasaypami ushaycusha.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Cananga mananami wiyacannachu","poem":1},{"lineBreak":true},{"text":"Moab runacunapa chullpa chacrancunacho cushicuywan gaparpashanpis.","poem":1},{"lineBreak":true},{"text":"Bïnupis manami cannachu churaräcunancunacho.","poem":1},{"lineBreak":true},{"text":"Bïnupaj übasta lluchcajcunapis manami cannachu.","poem":1},{"lineBreak":true},{"text":"Manami cushicuypitanachu gaparpaycanpis.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Hesbón runacunaga nanaywanmi gaparpaycan.","poem":1},{"lineBreak":true},{"text":"Gaparpashanga wiyacaycan Eleale siudäcama Jahaza siudäcama,","poem":1},{"lineBreak":true},{"text":"Zoarpitana Horonaimcama, Eglat-selisiya marcacamapis.","poem":1},{"lineBreak":true},{"text":"Chaynöga gaparpaycan Nimrimpa aywaj yacucunapis chaquisha captinmi.","poem":1}]},{"type":"verse","number":35,"content":["«Nogaga illgächishämi Moab runacuna puytush lömacunaman aywaycur diosnincunapaj uywacunata rupachejta, insinsuta rupachejcunata. Noga Tayta Diosmi në chayno ruranäpaj cashanta."]},{"type":"verse","number":36,"content":["Chaymi Moabcho tiyajcunapaj shongöpis icchun runata pampaptin quënata tucashannöraj. Kir-harescho tiyajcunapäpis shongö icchun ima-aycatapis shuntacushancuna ushacashana captinmi."]},{"type":"verse","number":37,"content":["Llapan runami llaquicuywan ajchancunatapis, shaprancunatapis rutucusha. Maquincunatapis llapanmi cuchucur-ushasha. Gachga röpacunatapis jaticusha."]},{"type":"verse","number":38,"content":["«Moab runacunapa wasin janancunacho intëru cällicunacho wiyacaycan llaquicur wagarcaycashallanmi. Chayno wagananpäga nogami illgarachishcä imapäpis mana sirbej puyñutano. Noga Tayta Diosmi chayno në."]},{"type":"verse","number":39,"content":["¡Moab nasyunpaj llaquicuy-llapa! ¡Fiyupa manchariypämi caycan! ¡Pengacurmi ticracurcusha! Moab runacunaga ñaupancho tiyajcunapaj caycan fiyupa melanaypämi, pasaypa manacajmi.»"]},{"type":"verse","number":40,"content":["Tayta Dios nin:",{"text":"«Anca lluyllucarcur imatapis charinanpaj aywaycajnörämi","poem":1},{"lineBreak":true},{"text":"Moab runacunamanga contrancuna aywaycan.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Moab runacunapataga siudänincunata pacacunancunatapis contrancunami charenga.","poem":1},{"lineBreak":true},{"text":"Chay junaj Moabpa suldäruncunaga warmi nanaycho caycajnörämi sicsicyangapis.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Moabga manami nasyunnachu canga.","poem":1},{"lineBreak":true},{"text":"Chayno canga noga Tayta Dios caycaptë apärimashanpitami.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Chaypitami noga Tayta Dios në:","poem":1},{"lineBreak":true},{"text":"Moab runacunaga canga casadurpita jirca animal gueshpejno,","poem":1},{"lineBreak":true},{"text":"man'chäga uchcuman yagananpaj caycajno, u togllaman watacänanpaj caycajnöna.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Casadurcunapita gueshpej cäga uchcumanmi yaganga.","poem":1},{"lineBreak":true},{"text":"Uchcupita llojshej cajnami togllaman watacanga.","poem":1},{"lineBreak":true},{"text":"Nogami camacächishaj Moab nasyuncho tiyajcuna castigashana cananpaj.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"«Gueshpir aywajcunaga callpaynajnönami chayan Hesbón siudäman pacacunanpaj.","poem":1},{"lineBreak":true},{"text":"Ray Sehonpa siudänin Hesbonchöga ninami ratariycan.","poem":1},{"lineBreak":true},{"text":"Chay nina ratarir mashtacashpan intëru Moab jircacunatami,","poem":1},{"lineBreak":true},{"text":"llapan fiyu runacuna tiyashantami ushacurcun.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"¡Ay imanöraj canqui Moab runacuna!","poem":1},{"lineBreak":true},{"text":"¡Quemós diosta aduraj runacuna manami salbacunquipänachu!","poem":1},{"lineBreak":true},{"text":"¡Wamrayquicunata ollguta warmitapis prësumi apacuycan!","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Ichanga Moabpita prësu apashancunata mas unaytaga cutichimushämi.","poem":1},"Noga Tayta Diosmi chayno në.» Tayta Dios Moab runacunapaj nishanga chaynömi caycan."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}