{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":5,"content":[{"type":"heading","content":["Jerusalén runacuna juchata rurashan"]},{"type":"verse","number":1,"content":["Tayta Dios cayno nin:",{"text":"«Jerusalén cällicunapa puriy-llapa.","poem":1},{"lineBreak":true},{"text":"Sumaj ricchacuy.","poem":1},{"lineBreak":true},{"text":"Intërupa purishayqui läsacunachöpis sumaj ashiy.","poem":1},{"lineBreak":true},{"text":"Chaycho mä tarinquichush jucnayllatapis alli runata, rasun cajta rurayta munajta.","poem":1},{"lineBreak":true},{"text":"Jucnayllatapis tariptiquega Jerusalencho tiyaycajcunata perdunashämi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chay runacunaga ‹Tayta Diospa jutinchömi jurä› nirpis","poem":1},{"lineBreak":true},{"text":"janan shongullami juran.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tayta Dios gamga munanqui alli runacunatami.","poem":1},{"lineBreak":true},{"text":"Cay runacunaga castigaptiquipis manami wiyacushachu.","poem":1},{"lineBreak":true},{"text":"Fiyupa mana alliman chayachiptiquipis manami yarpachacushachu.","poem":1},{"lineBreak":true},{"text":"Paycunapaga shongunpis caycan ruminömi.","poem":1},{"lineBreak":true},{"text":"Chaymi arpinticuytapis mana munashachu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nogaga yarparä:","poem":1},{"lineBreak":true},{"text":"«Imatapis mana yachajcunallami yarpayniynajnöga ruran.","poem":1},{"lineBreak":true},{"text":"Paycunallami mana musyanchu Tayta Dios munashanta,","poem":1},{"lineBreak":true},{"text":"ni imano rurananpaj Tayta Dios mandashantapis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaymi aywashaj rispitädu runacunaman.","poem":1},{"lineBreak":true},{"text":"Paycunata willapäshaj.","poem":1},{"lineBreak":true},{"text":"Paycunami ichanga musyanga Tayta Dios munashanta,","poem":1},{"lineBreak":true},{"text":"imano rurananpaj Tayta Dios mandashantapis» nir.","poem":1},{"lineBreak":true},{"text":"Ichanga llapanmi Tayta Diospa contran ricacuran.","poem":1},{"lineBreak":true},{"text":"Dios nishanta wiyacuyta manami munashanachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chay runacunaga alläpanami juchata rurasha.","poem":1},{"lineBreak":true},{"text":"Tayta Diostapis achca cutinami mana wiyacushachu.","poem":1},{"lineBreak":true},{"text":"Chaypitami contrancunaga liyuncuna muntipita llojshimojno wañuchenga.","poem":1},{"lineBreak":true},{"text":"Chunyajcunapita micucoj jirca allgucuna shamur rachir-usharejnömi rurarenga.","poem":1},{"lineBreak":true},{"text":"Siudänin ñaupancunacho tigricuna wañurgärachejnömi rurarenga.","poem":1},{"lineBreak":true},{"text":"Siudäpita llojshej cajtapis rachir-usharenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Tayta Dios cayno nin:",{"text":"«Israelcuna ¿imanöpataj perdunashayqui?","poem":1},{"lineBreak":true},{"text":"Wamrayquicunami cachaycamasha.","poem":1},{"lineBreak":true},{"text":"Mana dios caycajpa jutinchömi jurashapis.","poem":1},{"lineBreak":true},{"text":"Aypalla micuyniqui cananpäpis nogami bindisyunta gorä.","poem":1},{"lineBreak":true},{"text":"Chaypis manami wiyacamashachu.","poem":1},{"lineBreak":true},{"text":"Chaymi shuntacarcur-shuntacarcur juc dioscunata adurasha.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Potru china cawalluta ashiycajnömi","poem":1},{"lineBreak":true},{"text":"runa-masinpa warminta munaparcaycan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chayno carcaycaptenga ¿imanirtaj mana castigämanchu?","poem":1},{"lineBreak":true},{"text":"Chayno runacunataga yarpachacunanpaj ¿manachu castigäman?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Chaymi contrancuna yaycuchun","poem":1},{"lineBreak":true},{"text":"übas wertacunata muturinanpaj!","poem":1},{"lineBreak":true},{"text":"Chillguiycajcunatapis rachirgärichun.","poem":1},{"lineBreak":true},{"text":"Chaycunaga manami nogapanachu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Israelcunawan Judäcunaga conträmi ricacusha.","poem":1},"Noga Tayta Diosmi chayno në.»"]},{"type":"heading","content":["Castigananpaj nishan"]},{"type":"verse","number":12,"content":["Israelcunawan Judäcunaga Tayta Diosta mana wiyacur niran:",{"text":"«Diosga manami canchu.","poem":1},{"lineBreak":true},{"text":"Ima mana allipis manami chayamäshunchu.","poem":1},{"lineBreak":true},{"text":"Manami cangachu guërra ni muchuypis.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Profëtacunaga wayrano manacajllami.","poem":1},{"lineBreak":true},{"text":"Paycunaga manami Tayta Dios nishantachu willacun» nir.","poem":1}]},{"type":"verse","number":14,"content":["Chaymi ima-aycapäpis munayniyoj Tayta Dios nimasha:",{"text":"«Paycuna chayno rimashanpitami cayno canga:","poem":1},{"lineBreak":true},{"text":"Nogami camacächishaj llapan nishäcunapis gampa shimiquichöga ninano cananpaj.","poem":1},{"lineBreak":true},{"text":"Chay runacunanami yantano canga.","poem":1},{"lineBreak":true},{"text":"Chaura shimiquipita yargoj ninanami ushacurconga.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":["Tayta Diosmi cayno nin:",{"text":"«Israelcuna, gamcunata magashunayquipämi","poem":1},{"lineBreak":true},{"text":"caru runacunata pushamushaj.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga fiyupa callpayoj, unay cajcunami canpis.","poem":1},{"lineBreak":true},{"text":"Gamcunaga rimaynintapis manami yachanquichu.","poem":1},{"lineBreak":true},{"text":"Chaymi imata nishantapis mana tantiyanquipächu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Paycunaga llapanpis pillyay-yachaj jinyullami.","poem":1},{"lineBreak":true},{"text":"Pillyacunancunapis runa wañuchej yachacashami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chay runacunaga llapan micuyniquicunatami ushacurcongapaj.","poem":1},{"lineBreak":true},{"text":"Wamrayquicunata warmita ollgutapis wañurgärachengami.","poem":1},{"lineBreak":true},{"text":"Uyshayquicunata, wäcayquicunata,","poem":1},{"lineBreak":true},{"text":"übasniquicunata, ïgusniquicunatapis micucarcärengami.","poem":1},{"lineBreak":true},{"text":"Pacacunayquipaj yäracushayqui siudäcunatapis","poem":1},{"lineBreak":true},{"text":"pillyacunanwanmi illgächengapaj.»","poem":1}]},{"type":"verse","number":18,"content":["Tayta Dios nimaran: «Chaypis chay wichan manami ushajpäga wañuchishäpächu."]},{"type":"verse","number":19,"content":["‹¿Imanirtaj nogacunata Tayta Dios cayno ruramasha?› nir chay quëdaj runacuna tapushuptiqui gam ninqui: ‹Gamcunaga Tayta Diosta gongaycärirmi juc-lä nasyuncunapa diosnincunata nasyunniquicho adurarayqui. Chaypitami gamcunapis juc-lä nasyun runacunata juc-lä nasyuncho sirbinquipaj› nir."]},{"type":"heading","content":["Israelcunata Tayta Dios jurapashan"]},{"type":"verse","number":20,"content":[{"text":"«Israel runacuna, Judá runacuna wiyamay.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ñawiqui caycaptinpis mana ricaj,","poem":1},{"lineBreak":true},{"text":"rinriqui caycaptinpis mana wiyaj,","poem":1},{"lineBreak":true},{"text":"mana tantiyacoj upa runacuna wiyamay.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Noga Tayta Diosmi cayno në:","poem":1},{"lineBreak":true},{"text":"¿Gamcunaga manachu imanillarpis manchacamanqui?","poem":1},{"lineBreak":true},{"text":"¿Manachu ñaupächöga sicsicyanqui?","poem":1},{"lineBreak":true},{"text":"Lamar cantucho agush caycajtapis nogami churashcä lindata.","poem":1},{"lineBreak":true},{"text":"Chaymi chaypita mastaga lamar yacupis mana päsamunnachu.","poem":1},{"lineBreak":true},{"text":"Wayrawan ruyrucarcur-ruyrucarcur gaparar shamurpis","poem":1},{"lineBreak":true},{"text":"chay jananpaga manami päsamunnachu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gamcunaga carcaycanqui mana wiyacoj upaman ticrashami.","poem":1},{"lineBreak":true},{"text":"Chaymi nogata cachaycamar aywacushcanqui.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Manami yarpachacushcanquichu.","poem":1},{"lineBreak":true},{"text":"Ni manami parlacushcanquipischu:","poem":1},{"lineBreak":true},{"text":"‹Tayta Diosninchïta rispitar manchacushun.","poem":1},{"lineBreak":true},{"text":"Paymi micuyninchïcuna alli gueshpinanpaj tamyachimun rimir tamyata guepa tamyatapis.","poem":1},{"lineBreak":true},{"text":"Micuyninchïcunata shuntananchïpäpis","poem":1},{"lineBreak":true},{"text":"usyachipämanchi alli shuntapacunapaj› nir.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ichanga quiquiquicunapa juchayquipitami chay bindisyuncunatapis mana chasquinquinachu.","poem":1},{"lineBreak":true},{"text":"Ima-ayca allicuna tarinayquipaj cajtapis mananami tarinquinachu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Chaynöga caycan acrashä runacunacho fiyu runacuna captinmi.","poem":1},{"lineBreak":true},{"text":"Chay fiyu runacunaga mishi pichiusata charinanpaj llupuyllapa aywajnömi runa-masinta watgapaycan.","poem":1},{"lineBreak":true},{"text":"Trampata churarcaycan runa-masincunata charinanpaj.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Imanömi jaulaman pichiusacunata juntachin,","poem":1},{"lineBreak":true},{"text":"chaynömi ima-aycatapis suwacushallanta wasincunamanpis juntachisha.","poem":1},{"lineBreak":true},{"text":"Chayno ruraycällarmi rïcuyashpan munayniyojyasha.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Cananga alli allita micucarcärirmi werayasha carcaycan.","poem":1},{"lineBreak":true},{"text":"Mana allita ruraytaga manami jamanchu.","poem":1},{"lineBreak":true},{"text":"Pïninpis mana caj wacchacunatapis manami alliga arriglanchu.","poem":1},{"lineBreak":true},{"text":"Pobricunatapis manami yanapanchu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Chayno rurarcaycaptenga ¿imanirtaj mana castigämanchu?","poem":1},{"lineBreak":true},{"text":"Chayno runacunataga yarpachacunanpaj ¿manachu castigäman?","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"«Fiyupa manchariypaj mana allicunami cay nasyunchöga caycan.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Profëtacuna willacushanpis llullallami.","poem":1},{"lineBreak":true},{"text":"Cüracunapis antöjunmanmi mandarcaycan.","poem":1},{"lineBreak":true},{"text":"¡Chayno captinpis acrashä runacunaga manami imapis gocunchu!","poem":1},{"lineBreak":true},{"text":"Ichanga jusgasha canayqui junaj chayamuptin gamcuna ¿imataraj ruranqui?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}