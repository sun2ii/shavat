{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":51,"content":[{"type":"heading","content":["Babilonia illgächisha cananpaj rimashan"]},{"type":"verse","number":1,"content":["Tayta Dios nin:",{"lineBreak":true},{"text":"«Ima-aycatapis illgächej löcu wayratami","poem":1},{"lineBreak":true},{"text":"wayrächimushaj Babilonia runacunaman.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Disigrasya chayaptin,","poem":1},{"lineBreak":true},{"text":"chay nasyunmanga wacpita-caypitami pillyaj yayconga.","poem":1},{"lineBreak":true},{"text":"Camacächishaj Babiloniataga contran fiyu runacuna","poem":1},{"lineBreak":true},{"text":"rïguta wayrajnöpis rurarinanpaj.","poem":1},{"lineBreak":true},{"text":"Chaura chay nasyunchöga ni juc runapis manami tiyangapänachu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Babilonia mösucunataga ama cuyapaychu.","poem":1},{"lineBreak":true},{"text":"Suldäruncunata ushajpaj illgächiy.","poem":1},{"lineBreak":true},{"text":"Chaynöpami lëchawan illapayta yachaj Babiloniacunapaga camaricunanpäpis timpu mana canganachu.","poem":1},{"lineBreak":true},{"text":"Chapänanpaj chalëcucunata jaticunanpäpis timpun manana canganachu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Babilonia nasyunchöga","poem":1},{"lineBreak":true},{"text":"llapan siudäcunapa cällincunachömi wañusha runa mashtarpäconga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaynöga canga Israelcunatawan Judá runacunata","poem":1},{"lineBreak":true},{"text":"Noga, munayniyoj Tayta Dios, mana gongaycusha captëmi.","poem":1},{"lineBreak":true},{"text":"Nasyunnincho pasaypa juchata rurasha captinpis","poem":1},{"lineBreak":true},{"text":"Noga, Santo Tayta Diosnenga manami gongaycushcächu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«¡Babiloniapitaga aywacuy!","poem":1},{"lineBreak":true},{"text":"¡Cawayta munaj cäga gueshpicuy!","poem":1},{"lineBreak":true},{"text":"¡Babilonia runacunapa juchanpitaga llapayqui ama wañuychu!","poem":1},{"lineBreak":true},{"text":"Paycunata ayñita cutichinä junaj chayamushanami.","poem":1},{"lineBreak":true},{"text":"Chaymi juchanman-tupu castigashaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Babiloniaga maquëcho caran gori cöpata aptaraycashänömi.","poem":1},{"lineBreak":true},{"text":"Chay cöpawanmi llapan nasyuncho tiyajcunata upuchirä.","poem":1},{"lineBreak":true},{"text":"Nasyuncunacho tiyaj runacunaga chay cöpapita bïnuta upucurcurmi löcutaran.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ichanga illajpitami Babilonia tunisha ushacajpaj.","poem":1},{"lineBreak":true},{"text":"¡Paypaj llapaniqui wagay!","poem":1},{"lineBreak":true},{"text":"Jampicunawan jampiy.","poem":1},{"lineBreak":true},{"text":"Capaschari allchacanmanpis.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaura waquin nasyun runacunaga Babiloniata jampiyta camasha.","poem":1},{"lineBreak":true},{"text":"Ichanga manami allchacashanachu.","poem":1},{"lineBreak":true},{"text":"Chaymi nin: ‹¡Cachaycäriyna! Llapanchi aywacushun nasyunninchïman-camana.","poem":1},{"lineBreak":true},{"text":"Paycunapa juchanga syëlucamami chayasha.","poem":1},{"lineBreak":true},{"text":"Chaymi paycunaga fiyupa castigasha canga› nir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Israelcunana nin: ‹Tayta Diosga alli goyänanchïpänami camacächisha.","poem":1},{"lineBreak":true},{"text":"Sionmanna llapanchi aywashun Tayta Diosninchi","poem":1},{"lineBreak":true},{"text":"imano rurashantapis willacunanchïpaj› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Media jutiyoj nasyunpa raynincuna, lëchayquicunata afilay.","poem":1},{"lineBreak":true},{"text":"Chapacunayquipaj caj escüduyquicunatapis camaricuy.","poem":1},{"lineBreak":true},{"text":"Nogaga Babiloniata illgächiytami munä.","poem":1},{"lineBreak":true},{"text":"Paycunaga Templötami pasaypa illgächiran.","poem":1},{"lineBreak":true},{"text":"Chaypitami ayñita cutichishaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Babiloniapa curralninta juchuchej yaycunanpaj sëñata ruray!","poem":1},{"lineBreak":true},{"text":"¡Suldärucunatapis sumaj camacächiy!","poem":1},{"lineBreak":true},{"text":"¡Ricchacojcunata churay!","poem":1},{"lineBreak":true},{"text":"¡Wañuchinayquipaj pacacuy-llapa!","poem":1},{"lineBreak":true},{"text":"Noga imano ruranäpäpis yarpashätaga","poem":1},{"lineBreak":true},{"text":"Babiloniacho tiyajcunapaj camacächishcänami.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Babilonia nasyun runacuna, gamcunaga carcaycashcanqui jatun mayucunapa lädunchömi.","poem":1},{"lineBreak":true},{"text":"Llapanniquipis gampaga fiyupa aypallami casha.","poem":1},{"lineBreak":true},{"text":"¡Cananga chayamushanami ushacänayquipaj öra!","poem":1},{"lineBreak":true},{"text":"¡Manami canquipänachu!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¡Nogami chiquishojcunataga gaycamushaj aypalla chüpacacunata-jina.","poem":1},{"lineBreak":true},{"text":"Chauraga paycunanami gamcunata binsiycushushpayqui cushicuypita gaparpanga!","poem":1},"Noga munayniyoj Tayta Diosmi chayno në.»"]},{"type":"heading","content":["Tayta Diosta alabar cantashan"]},{"type":"verse","number":15,"content":[{"text":"Tayta Diosmi munayninwan cay pachata camasha.","poem":1},{"lineBreak":true},{"text":"Fiyupa yachaj cayninwan cay munduta tacyachisha.","poem":1},{"lineBreak":true},{"text":"Yarpaysapa cayninwan syëlutapis camacächisha.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Räyuno busninwanmi syëlucho caycaj yacuta gaparächin.","poem":1},{"lineBreak":true},{"text":"Pucutaytapis pampapita jatarachin.","poem":1},{"lineBreak":true},{"text":"Tamyaycashan örami illguytapis achicyächin.","poem":1},{"lineBreak":true},{"text":"Wayratapis wichgarächishanpitami gargaramun.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Runacunaga llapanpis upami, imatapis mana tantiyajmi.","poem":1},{"lineBreak":true},{"text":"Ïduluncunaga ruraj runacunatapis pengacachinmi.","poem":1},{"lineBreak":true},{"text":"Rurashan ïdulucunaga mana rasun cajmi, mana cawajmi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chay mana bälej ïdulucunaga manacajllami.","poem":1},{"lineBreak":true},{"text":"Chaycunataga Tayta Diosmi castïgu junaj illgächenga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tayta Diosninchïmi ichanga rasunpa Dios.","poem":1},{"lineBreak":true},{"text":"Paymi ima-ayca caycajtapis ruraran.","poem":1},{"lineBreak":true},{"text":"Israelcunataga paymi acrasha quiquinpa cananpaj.","poem":1},{"lineBreak":true},{"text":"Paypaga jutinpis «Munayniyoj Tayta Diosmi».","poem":1}]},{"type":"heading","content":["Babilonia Tayta Diospa magacunan cashan"]},{"type":"verse","number":20,"content":["Mastapis Tayta Dios niran:",{"lineBreak":true},{"text":"«¡Babilonia, gamga canqui pï-maytapis tacacuna cumbämi,","poem":1},{"lineBreak":true},{"text":"guërracho pillyacuna armämi!","poem":1},{"lineBreak":true},{"text":"Gamwanmi nasyuncunata ushashcä.","poem":1},{"lineBreak":true},{"text":"Raycuna mandashantapis illgächishcä.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gamwanmi ushacächë cawallucunatapis, muntasha purej runacunatapis.","poem":1},{"lineBreak":true},{"text":"Gamwanmi ushacächë carrëtacunacho aywarcaycaj runacunatapis carrëtantinta.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gamwanmi wañuchichë llapan runacunata.","poem":1},{"lineBreak":true},{"text":"Wañuchichë ollguta, warmita, auquinta, mösuta, wamrata, jipashcunatapis.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gamwanmi wañuchichë uyshayojcunata uyshantinta, arojcunata yuntantinta.","poem":1},{"lineBreak":true},{"text":"Gamwanmi wañuchichë gobernadorcunatapis llapan yanapajnintinta.","poem":1}]},{"type":"heading","content":["Babiloniata castigananpaj rimashan"]},{"type":"verse","number":24,"content":["«Chaypis Judá runacuna, gamcuna ricaycaptiquimi Babilonia runacunataga ayñita cutichishaj imanöpis Sionta rurashanno. Noga Tayta Diosmi chayno në."]},{"type":"verse","number":25,"content":[{"text":"«Babilonia, illgächicoj jircanömi caycanqui.","poem":1},{"lineBreak":true},{"text":"Chaynöga caycanqui llapan runacunata chacracunata illgächishpayquimi.","poem":1},{"lineBreak":true},{"text":"Cananga gampa contrayquimi caycä.","poem":1},{"lineBreak":true},{"text":"Quiquiquitanami castigashayqui.","poem":1},{"lineBreak":true},{"text":"Castigashpämi cuchpärimushayqui.","poem":1},{"lineBreak":true},{"text":"Nircur ticrachishayqui pasaypa rupasha jircaman.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":26,"content":[{"text":"Gamcho gotuy-gotuy caycaj rumicunataga","poem":1},{"lineBreak":true},{"text":"manami pipis apangapächu wasincunata pergananpaj.","poem":1},{"lineBreak":true},{"text":"Imaycamapis chunyajllami cacunquipaj.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«¡Nasyuncunacho bandëracunata awiy Babiloniaman pillyaj yaycunanpaj!","poem":1},{"lineBreak":true},{"text":"¡Trompëtata tucashpayqui nasyuncunacho tiyajcunata ushajpaj camaricachiy!","poem":1},{"lineBreak":true},{"text":"¡Babiloniaman pillyaj aywananpaj shacyächiy","poem":1},{"lineBreak":true},{"text":"Araratcho, Minicho, Askenazcho caycaj raycunata!","poem":1},{"lineBreak":true},{"text":"¡Pillyacho mandananpaj juc capitanta churay!","poem":1},{"lineBreak":true},{"text":"Muntädu aywaycajcunata gaycuy aypalla chüpacacuna aywaycajtanöraj.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nasyuncunata camaricachiy magaj yaycunanpaj.","poem":1},{"lineBreak":true},{"text":"Chayno Media jutiyoj nasyuncho caj raycunatapis camaricachiy","poem":1},{"lineBreak":true},{"text":"llapan mandäshejnincunatawan waquin pöcu mandajnintinta.","poem":1},{"lineBreak":true},{"text":"Chayno maquincho caycaj runacunatapis llapanta camaricachiy.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Tayta Dios imanöpis rurananpaj nishanno llapanta camacächiptin","poem":1},{"lineBreak":true},{"text":"cay pachapis sicsicyashpan chucchuytami gallaycun.","poem":1},{"lineBreak":true},{"text":"Babiloniatanami fiyupa manchariypaj chunyajman ticrarachenga.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Babilonia suldärucunaga mananami pillyayta munannachu.","poem":1},{"lineBreak":true},{"text":"Pacacunallanchönami pacarpaycan.","poem":1},{"lineBreak":true},{"text":"Callpanpis mananami cannachu.","poem":1},{"lineBreak":true},{"text":"Warminönami carcaycan.","poem":1},{"lineBreak":true},{"text":"Siudänincunamanpis contrancunami juntajpaj yagacaycärisha.","poem":1},{"lineBreak":true},{"text":"Nircur wasincunatapis rupaycärachisha.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Jucpis-jucpis gatinayllanpa willacojcuna Babiloniapa rayninman aywan","poem":1},{"lineBreak":true},{"text":"llapan siudänincunata juccunana charicarcärishanta willananpaj.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Runa päsacunan mayu bäducunachöpis contrancunaga juntashami carcaycan.","poem":1},{"lineBreak":true},{"text":"Pacacunanpaj caj shogush juntasha cajcunatapis cañapaycärishami.","poem":1},{"lineBreak":true},{"text":"Chaura suldärucunapis fiyupami mancharircaycan.","poem":1}]},{"type":"verse","number":33,"content":["Israelcunapa munayniyoj Tayta Diosninmi nin:",{"text":"«Babiloniaga caycan rïguta ërar cawallu lluchcanan ëranömi.","poem":1},{"lineBreak":true},{"text":"Paycunapäga cosëchan chayaycämunnami.»","poem":1}]},{"type":"verse","number":34,"content":["Jerusalenga nin:",{"text":"«Babiloniapa raynin Nabucodonosorga rachir-usharcur micucarcamasha.","poem":1},{"lineBreak":true},{"text":"Micuyniynaj lätutanömi cachaycamasha.","poem":1},{"lineBreak":true},{"text":"Ultacarcamasha lamarcho tiyaj manchariypaj jatuncaray waräcuynömi.","poem":1},{"lineBreak":true},{"text":"Nogacho cajta payga sacsasha munashan cajllatami, waquintana jitarisha.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"¡Cananga quiquin Babiloniapis quëdachun mana allita nogata ruramashanno!","poem":1},{"lineBreak":true},{"text":"¡Nogacho tiyajcunata wañuchishanno quiquincunatapis wañuchichun!»","poem":1}]},{"type":"verse","number":36,"content":["Chaymi Tayta Dios nin:",{"text":"«Nogami alli arriglashayqui.","poem":1},{"lineBreak":true},{"text":"Chaymi contrayquicunataga ayñita cutichishaj.","poem":1},{"lineBreak":true},{"text":"Babiloniacho caj mayucunatawan pashtaj yacuncunatapis ushajpämi chaquirachishaj.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Quëdangapaj pasaypa juchusha.","poem":1},{"lineBreak":true},{"text":"Chaychöga tiyanga jirca allgucunallana.","poem":1},{"lineBreak":true},{"text":"Pï runapis manami tiyanganachu.","poem":1},{"lineBreak":true},{"text":"Chaura juc-lä nasyun runacunaga almirashpanmi mancharenga.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Babiloniacunaga liyuncuna gaparpajnömi gaparpanga.","poem":1},{"lineBreak":true},{"text":"Liyun-mallwacunanörämi aullarcaycanga.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Fiyupa acaycho caycashan örami","poem":1},{"lineBreak":true},{"text":"Noga upuchishaj fiyupa machächicojta.","poem":1},{"lineBreak":true},{"text":"Chaura machacäcongapaj.","poem":1},{"lineBreak":true},{"text":"Machacäcurnaga manami musyangapänachu imano carcaycashantapis.","poem":1},{"lineBreak":true},{"text":"Chaymi paycunaga puñucäcongapaj imaycamapis manana ricchamoj.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":40,"content":[{"text":"Nircurnami uyshata, carnicunata, chïbucunatapis camalman apashanno","poem":1},{"lineBreak":true},{"text":"wañuchej apashaj.","poem":1}]},{"type":"heading","content":["Babiloniata binsinanpaj rimashan"]},{"type":"verse","number":41,"content":[{"text":"«Llapan nasyunpita mas rejsisha munayniyoj Babiloniata imanöshi contrancuna charisha.","poem":1},{"lineBreak":true},{"text":"Chayno caycajta ricaycur juc-lä nasyun runacunaga fiyupa almirashpan mancharin.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Contrancunaga Babiloniaman shamusha lamar yacu llojshicaramojnömi.","poem":1},{"lineBreak":true},{"text":"Wayrawan ruyrucarcur-ruyrucarcur shamoj yacu ushajpaj chapacurcojnömi juntacaycärisha.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Siudänincunapis ricacusha manchariypaj chunyajmi, chaqui jircami,","poem":1},{"lineBreak":true},{"text":"pipis mana tiyanan, pipis mana purinan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"«Babiloniapa diosnin Belta castigashämi.","poem":1},{"lineBreak":true},{"text":"Llapan micushancunatapis gumitachimushämi.","poem":1},{"lineBreak":true},{"text":"Chaura maygan nasyunpis mananami masga payman aywangapänachu.","poem":1},{"lineBreak":true},{"text":"¡Ni Babiloniapa pergancunapis ichiraycäga manami quëdangachu!","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Acrashä runacuna chaypita llojshicuy.","poem":1},{"lineBreak":true},{"text":"Cawayta munaj cäga cada-ünuyqui gueshpicuy,","poem":1},{"lineBreak":true},{"text":"fiyupa rabyar nina ratarejno usharinäpaj caycajpita.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Ama manchariychu ni llaquicuypischu intëru nasyunpa willapa captin.","poem":1},{"lineBreak":true},{"text":"Cada watami willapaga jucno-jucno canga.","poem":1},{"lineBreak":true},{"text":"Chay willapaga canga wañuchinacuypaj,","poem":1},{"lineBreak":true},{"text":"juc siudäpa mandajninwan juc siudäpa mandajnincuna pillyananpaj.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Chaynömi chayamongapaj Babiloniacho caycaj ïdulucunata","poem":1},{"lineBreak":true},{"text":"ushajpaj illgächinäpaj caycaj junaj.","poem":1},{"lineBreak":true},{"text":"Chayrämi nasyun intëru pengaycho ricaconga.","poem":1},{"lineBreak":true},{"text":"Wañushacunapis llapan siudänincunachömi mashtarpanga.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Babilonia nasyunta illgächinanpaj norte caj-läpita shamuptin","poem":1},{"lineBreak":true},{"text":"syëluwan allpapis, llapan ima-aycapis cushicongami.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":49,"content":[{"text":"Israelcunata wañuchishanpita,","poem":1},{"lineBreak":true},{"text":"chayno waquin nasyun runacunatapis wañuchishanpitami","poem":1},{"lineBreak":true},{"text":"Babiloniacho tiyarcaycajcunaga ushacanga.","poem":1}]},{"type":"heading","content":["Babiloniacho tiyaycaj Judá runacunaman willacachishan"]},{"type":"verse","number":50,"content":[{"text":"«Wañuchinacuypita gueshpir aywacoj cajcunaga","poem":1},{"lineBreak":true},{"text":"mana ichiypa gueshpir aywacuy.","poem":1},{"lineBreak":true},{"text":"May carucho caycashpayquipis noga Tayta Diosniquita yarpämay.","poem":1},{"lineBreak":true},{"text":"Jerusalentapis ama gongaycuychu.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Gamcunaga niycanqui:","poem":1},{"lineBreak":true},{"text":"‹Gayapämaptinchïmi fiyupa pengacunchi.","poem":1},{"lineBreak":true},{"text":"Tayta Diospa rispitädu Templunman","poem":1},{"lineBreak":true},{"text":"juc-lä runacuna yaycushanpitami","poem":1},{"lineBreak":true},{"text":"pengacuywan cäranchïcunatapis chapacusha caycanchi.›","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Juc junajmi ichanga Babiloniacho caycaj ïdulucunata illgächishaj.","poem":1},{"lineBreak":true},{"text":"Chaura malubracusha caycajcunaga nasyun intërucho nanaywan gaparpangapaj.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Babilonia runacuna syëlucama wichaptinpis","poem":1},{"lineBreak":true},{"text":"chapacuna pergacunata altuta pergacurcuptinpis","poem":1},{"lineBreak":true},{"text":"Nogaga contrancunata cachashämi yaycuycur ushajpaj illgächinanpaj.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"heading","content":["Babilonia illgächisha cananpaj rimashan"]},{"type":"verse","number":54,"content":[{"text":"«Babiloniaga ushacajmi-aywan.","poem":1},{"lineBreak":true},{"text":"Chaymi Babiloniapita-pacha wiyacaycämun nanaywan gaparpashan.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"Babiloniacho tiyaj runacunataga","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosmi ushajpaj illgaycächë.","poem":1},{"lineBreak":true},{"text":"Llapan gaparpaycajtapis ushajpämi illgaycächë.","poem":1},{"lineBreak":true},{"text":"Gochapita wayrawan yacu shamoj gaparajnörämi","poem":1},{"lineBreak":true},{"text":"contrancunaga fiyupa gaparpashpan paycunaman yagacaycärin.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Babiloniata illgächej aywaycämunnami.","poem":1},{"lineBreak":true},{"text":"Pillyaj suldäruncunatami prësu charenga.","poem":1},{"lineBreak":true},{"text":"Pillyananpaj caycaj lëchancunatapis ushajpämi paquirgärenga.","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosga cada-ünuntami imanöpis rurashanman-tupu cutichishaj.","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Babiloniacunapa mandajnincunata,","poem":1},{"lineBreak":true},{"text":"musyacojnincunata, siudäpa mandajnincunata,","poem":1},{"lineBreak":true},{"text":"waquin mandajcunata, suldäruncunatapis rabyasha aptaraycashä cöpawanmi machächishaj.","poem":1},{"lineBreak":true},{"text":"Chayno machashallami puñucäconga.","poem":1},{"lineBreak":true},{"text":"Puñuycorga imaypis manami ricchanganachu.»","poem":1}]},{"type":"verse","number":58,"content":["Munayniyoj Tayta Diosmi nin:",{"text":"«Babilonia siudäpa intëru cantunpa anchu pergan caycajtapis","poem":1},{"lineBreak":true},{"text":"ushajpämi juchurachenga.","poem":1},{"lineBreak":true},{"text":"Jatun puncuncunatapis llapantami ruparachenga.","poem":1},{"lineBreak":true},{"text":"Llapan nasyun runacuna arur ñacashanpis yangallami canga.","poem":1},{"lineBreak":true},{"text":"Chay-jina uticar arushantapis ninami rupar ushacurconga.»","poem":1}]},{"type":"heading","content":["Jeremías isquirbishanta Babiloniaman apashan"]},{"type":"verse","number":59,"content":["Sedequías Judäpa raynin chuscu watana caycaptin profëta Jeremiasga apachicuran Neriaspa wamran Seraiasta. Seraías caran Maasiaspa willcan. Ray Sedequías Babiloniaman aywaptin Seraiasga aywäshiran ray pachacuptin llapanta camaripänanpaj."]},{"type":"verse","number":60,"content":["Babilonia nasyunta castïgu imano chayananpaj cashantapis Jeremiasga juc rölluman isquirbiran. Chay isquirbishanga caycaran Babiloniapaj imanömi caycho isquirbiraycan, chayno."]},{"type":"verse","number":61,"content":["Jeremiasga Seraiasta niran: «Babiloniaman chayaycushpayqui cay apaycächishä rölluta liguiytaga ama gonganquichu."]},{"type":"verse","number":62,"content":["Liguircur ninqui: ‹Tayta Dios gammi nishcanqui cay partita illgächinayquipaj. Chaura manana tiyanganachu runa ni animalpis. Cay pachaga imaycamapis chunyajnami canga› nir."]},{"type":"verse","number":63,"content":["Nircur cay liguishayqui röllutaga rumiman watarcur Éufrates mayuman jitarpunqui."]},{"type":"verse","number":64,"content":["Jitarpur ninqui: ‹Cay jitarpushä röllu tallpucajnömi Babiloniapis illganga. Nircur Tayta Dios castigananpaj caycashanpitaga manami yapay imaypis cashanmanno cutenganachu› nir.» Caycamallami caycan Jeremías rimashancunaga."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}