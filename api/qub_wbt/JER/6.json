{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":6,"content":[{"type":"heading","content":["Contrancuna Jerusalenta curalapaycunanpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"Nortipita fiyupa manchariypaj y disigrasyami chayamunanpaj caycan.","poem":1},{"lineBreak":true},{"text":"¡Benjamín trïbu runacuna","poem":1},{"lineBreak":true},{"text":"Jerusalenpita gueshpir aywacuy!","poem":1},{"lineBreak":true},{"text":"¡Pacacunayquipaj ashiy!","poem":1},{"lineBreak":true},{"text":"Tecoa marcacho wagrata tucay-llapa.","poem":1},{"lineBreak":true},{"text":"Bet-haquerem marcacho goshtachiy musyananpaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Cuyayllapaj Jerusalén siudäta illgächinäpänami caycä.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chay siudä ñaupancunamanga contran suldärucunami pachaconga uyshërucuna pachacojno.","poem":1},{"lineBreak":true},{"text":"Nircorga guewata uyshacuna ushajnömi siudäta ushajpaj illgächenga.","poem":1}]},{"type":"verse","number":4,"content":["Chay contrancunaga nin:",{"text":"«¡Sumaj camaricuy Jerusalén runacunawan pillyanapaj!","poem":1},{"lineBreak":true},{"text":"¡Llapaniqui shamuy pullan junaj yaycapaycärinapaj!","poem":1},{"lineBreak":true},{"text":"Ichanga inti yagaycannami.","poem":1},{"lineBreak":true},{"text":"Llantuycunapis ñitiycämunnami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Chauraga chacaypana yaycapaycärishun!","poem":1},{"lineBreak":true},{"text":"Ricchacuna törrincunatapis juchurgärachishun.»","poem":1}]},{"type":"verse","number":6,"content":["Munayniyoj Tayta Diosnami cayno nin:",{"text":"«¡Guerucunata muturir","poem":1},{"lineBreak":true},{"text":"Jerusalenpa curralnin wajtancunaman ichichiy chaypa yaycunayquipaj!","poem":1},{"lineBreak":true},{"text":"Chay siudächo caycaj runacunaga castigasha cananpämi caycan.","poem":1},{"lineBreak":true},{"text":"Chaychöga llapanpis fiyu runacunallami carcaycan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pucyupita yacu llojshimojnömi","poem":1},{"lineBreak":true},{"text":"Jerusalenpitaga mana allicuna intëruman mashtacaycan.","poem":1},{"lineBreak":true},{"text":"Chay siudäpitaga imaypis wiyacaycämun mana alli ruraycunallami, pillyallami.","poem":1},{"lineBreak":true},{"text":"Chaymi imaypis ricaycä nanaywan gaparpaycajllata, rachir-ushashallata.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sumaj yarpachacuy Jerusalén runacuna.","poem":1},{"lineBreak":true},{"text":"Mana yarpachacuptiquega rabyashami aywacushaj.","poem":1},{"lineBreak":true},{"text":"Nircorga gamcuna tiyashayquita chunyajmanmi ticrarachishaj.","poem":1},{"lineBreak":true},{"text":"Chaychöga manami ni jucnayllapis runa tiyangapänachu.»","poem":1}]},{"type":"heading","content":["Imano castigasha cananpäpis willachishan"]},{"type":"verse","number":9,"content":["Munayniyoj Tayta Diosmi cayno nin:",{"text":"«Übaspa wayuyninta yaparir-yaparir ushajpaj ashejnömi","poem":1},{"lineBreak":true},{"text":"Israel quëdajcunatapis contrancuna manyapita ashenga.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Chaura noga nirä:",{"text":"«¿Pitaraj nishaj?","poem":1},{"lineBreak":true},{"text":"¿Pitaraj willapäshaj?","poem":1},{"lineBreak":true},{"text":"¿Piraj wiyamanga?","poem":1},{"lineBreak":true},{"text":"Paycunaga imatapis mana wiyananpaj rinrincuna chapashami caycan.","poem":1},{"lineBreak":true},{"text":"Tayta Diospa palabranpaj paycunaga asicunmi.","poem":1},{"lineBreak":true},{"text":"Paycunaga manami wiyaytapis munanchu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nogapis Tayta Dios rabyashanta willacunäpämi caycä.","poem":1},{"lineBreak":true},{"text":"Chaytaga manami amuräcömanchu.»","poem":1},{"lineBreak":true},"Chaymi Tayta Dios nimaran:",{"text":"«Rabyasha caycashätaga willay","poem":1},{"lineBreak":true},{"text":"cällicho caycaj wamracunata,","poem":1},{"lineBreak":true},{"text":"röpanpa puriycaj mösucunata.","poem":1},{"lineBreak":true},{"text":"Runacunataga prësumi apacongapaj warmintawan-cama,","poem":1},{"lineBreak":true},{"text":"auquincunatapis mana cuyapaypa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chacrancunapis, wasincunapis, warmincunapis jucpanami cangapaj.","poem":1},{"lineBreak":true},{"text":"Cay nasyuncho tiyaj runacunataga nogami castigashaj.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Rucupis wamrapis yarparcaycan","poem":1},{"lineBreak":true},{"text":"mana allita ruraypa imatapis tariyllatami.","poem":1},{"lineBreak":true},{"text":"Profëtacunapis cüracunapis engañacojllami.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Paycunaga acrashä runacunapa dañäduntapis janan janallanmi jampin.","poem":1},{"lineBreak":true},{"text":"Chayno rurarcorga ‹Alli goyay caycan, alli goyay caycan› nin.","poem":1},{"lineBreak":true},{"text":"Rasunpaga mana alli goyayllami caycan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¿Fiyupa melanäcushä cajta rurashanpita quiquincunaga pengacushachuraj?","poem":1},{"lineBreak":true},{"text":"Manami ni imanillarpis pengacushachu.","poem":1},{"lineBreak":true},{"text":"Manami musyannachu imano pengacuna cashantapis.","poem":1},{"lineBreak":true},{"text":"Chayno cashanpitami castigaptëraj mayanga.","poem":1},{"lineBreak":true},{"text":"Chayrämi mana alliman chayangaga.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"heading","content":["Israelcuna Tayta Diospa contran cashan"]},{"type":"verse","number":16,"content":["Tayta Diosga acrashan runacunata nin:",{"text":"«Tincoj nänicunacho ichiray.","poem":1},{"lineBreak":true},{"text":"Nircur tapucuy unay alli caj nänipa aywanayquipaj.","poem":1},{"lineBreak":true},{"text":"Chay alli caj nänipa ayway chaycho jamayta tarinayquipaj.","poem":1},{"lineBreak":true},{"text":"Ichanga paycuna nin: ‹Manami chaypa aywayllaga canchu› nir.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ricchacojcunata churarcur nogaga runacunata willashcä:","poem":1},{"lineBreak":true},{"text":"‹Ricchacojcuna trompëtata tucamushanta wiyaj-wiyajlla carcaycay› nir.","poem":1},{"lineBreak":true},{"text":"Ichanga runacuna nisha:","poem":1},{"lineBreak":true},{"text":"‹Manami wiyayta munäcunachu› nir.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chaypita cananga llapan nasyuncuna wiyay.","poem":1},{"lineBreak":true},{"text":"Musyay acrashä runacuna imano cananpaj cajtapis.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mundu intëru sumaj wiyay.","poem":1},{"lineBreak":true},{"text":"Cay runacunamanga fiyupa mana allitami apamushaj.","poem":1},{"lineBreak":true},{"text":"Chayga canga mana allita yarpashanpitami.","poem":1},{"lineBreak":true},{"text":"Paycunaga willapashäcunata manami wiyacushachu.","poem":1},{"lineBreak":true},{"text":"Laynëcunatapis manami cäsushachu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Juc-lä nasyuncho caj alli asyaj jachacunatapis,","poem":1},{"lineBreak":true},{"text":"Sabäpita insinsutapis ¿imapätaj apapämanqui?","poem":1},{"lineBreak":true},{"text":"Nogaga melanäcömi uywacunata pishtar rupachishayquitapis.","poem":1},{"lineBreak":true},{"text":"Ofrendacunata apamushayquitapis manami munächu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chayno cashanpitami cay runacunapäga camacächishaj mana alliman chayananpaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami wañur ushacanga taytanpis wamranpis bisïnunpis rejsinacushanpis.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"heading","content":["Nortipita fiyu runacuna chayananpaj cashan"]},{"type":"verse","number":22,"content":["Tayta Diosmi cayno nin:",{"text":"«Fiyupa caru norte cajpitami","poem":1},{"lineBreak":true},{"text":"munayniyoj nasyun runacuna shamunanpaj camaricurcaycan.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Chay runacunaga lëchanwan sablinwan camaricushallanami carcaycan.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga fiyumi.","poem":1},{"lineBreak":true},{"text":"Manami pitapis cuyapanchu.","poem":1},{"lineBreak":true},{"text":"Pillyapaj gayarparpis lamar yacu gaparajnörämi gaparpan.","poem":1},{"lineBreak":true},{"text":"Llapanpis cawallun muntashallami aywarcaycämun.","poem":1},{"lineBreak":true},{"text":"Jerusalén runacunawan pillyananpaj camaricushanami carcaycan.»","poem":1},"Judá runacunaga nircaycan:"]},{"type":"verse","number":24,"content":[{"text":"«Willapatami mayashcanchi.","poem":1},{"lineBreak":true},{"text":"Chayta wiyaycurmi manchariyllawan callpaynajnöna ricacushcanchi.","poem":1},{"lineBreak":true},{"text":"Cananmi ichanga nanaycho caycaj warminöraj llaquicunchi, nanächicunchi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Jircapaga ama llojshiynachu.","poem":1},{"lineBreak":true},{"text":"Nänicunapapis ama puriychu.","poem":1},{"lineBreak":true},{"text":"Contranchïcunaga wañuchicunanwanmi caycan.","poem":1},{"lineBreak":true},{"text":"Intërupami pasaypa manchariypaj caycan.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Marca-masëcuna, fiyupa llaquicushpayqui gachga röpacunata jaticuy.","poem":1},{"lineBreak":true},{"text":"Uchpacho gochpay.","poem":1},{"lineBreak":true},{"text":"Nircur jucnaylla wamrayqui wañusha caycajpäno fiyupa wagay.","poem":1},{"lineBreak":true},{"text":"Ushamänanchïpaj caycäga manapis aycällatanami chayamonga.»","poem":1}]},{"type":"heading","content":["Israel mana sirbej guellayno cashan"]},{"type":"verse","number":27,"content":["Tayta Dios nimaran:",{"text":"«Gamtami churä acrashä runacunata ricanayquipaj.","poem":1},{"lineBreak":true},{"text":"Imano goyarcaycashallantapis sumaj ricay.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Paycunaga llapanpis mana wiyacoj runacunami;","poem":1},{"lineBreak":true},{"text":"willapista, washa rima runacunami.","poem":1},{"lineBreak":true},{"text":"Runsino fyërrunömi carcaycan.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Jirrërucunapa juyllin sinchipa pücaptin","poem":1},{"lineBreak":true},{"text":"ninaga plömuta chullurachir ganranta raquirinmi.","poem":1},{"lineBreak":true},{"text":"Chay fiyu runacunatami ichanga yanga imanöpapis limyuyächiyta camanchi.","poem":1},{"lineBreak":true},{"text":"Mana alli runacunaga manami imaypis illgangachu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Paycunataga jutichapäshun ‹Mana sirbej guellay› nirnachari.","poem":1},{"lineBreak":true},{"text":"Chay runacunataga noga jitarishcänami.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}