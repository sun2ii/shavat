{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Tayta Diosga caynömi nin: «Chay wichanga pamparashan uchcucunapita jorgonga wañoj raycunapa tulluncunata, Judäpa mandajnincunapata, cüracunapata, profëtacunapata, Jerusalén runacunapa tulluntapis."]},{"type":"verse","number":2,"content":["Nircur pampaman mashtarenga. Chaura manami pipis shuntangapächu pampananpaj. Chay tullucunaga uywacunapa iscannömi mashtaräconga. Chaura intipis, quillapis, goyllar achicyashanpis chayanga. Chay wañojcunaga chaycunatami aduraran, tapucuranpis."]},{"type":"verse","number":3,"content":["Cawaycar quëdaj chay fiyu runacunataga may-chaymanpis gargushäpaj. Paycunaga cawaycänanpa ruquin wañucuytanami munanga. Noga, munayniyoj Tayta Diosmi chayno në."]},{"type":"heading","content":["Juchanpita Israelcunata castigananpaj cashan"]},{"type":"verse","number":4,"content":["«Jeremías, cay runacunata niy:",{"text":"« ‹Tunerga musyashayquinöpis jatarinmi.","poem":1},{"lineBreak":true},{"text":"Nänita pantaycurpis alli cajmanmi cutin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chayno caycaptenga Jerusalén runacuna","poem":1},{"lineBreak":true},{"text":"¿imanirtaj llutanpa purircaycanqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj nogapa conträ ricacushcanqui?","poem":1},{"lineBreak":true},{"text":"Gamcunaga mana wiyacojmi ricacushcanqui.","poem":1},{"lineBreak":true},{"text":"Nogaman cutimuytapis mana munanquinachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogaga wiyaj wiyajllami caycashcä.","poem":1},{"lineBreak":true},{"text":"Ichanga manami wiyashcächu ni mayganiquipis juchayquicunapita aripinticojta.","poem":1},{"lineBreak":true},{"text":"Manami mayganiquipis «¿imatataj ruraycö?» ninquichu.","poem":1},{"lineBreak":true},{"text":"Cada-ünuyquimi munashayquita rurarcaycanqui.","poem":1},{"lineBreak":true},{"text":"Frënuynaj cawallu guërraman yaycojnömi carcaycanqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Äbicunapis musyanmi imay wichan yapay cutimunanpaj cashanta,","poem":1},{"lineBreak":true},{"text":"imay wichan juc-läman witinan cashantapis.","poem":1},{"lineBreak":true},{"text":"Gamcunami ichanga laynëcuna imano niycashantapis mana musyanquichu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"« ‹Chayno caycashpayquega ¿imanöpataj «musyaj-yachajmi cä;","poem":1},{"lineBreak":true},{"text":"Tayta Diospa laynintami nogacunaga charä» ninquiman?","poem":1},{"lineBreak":true},{"text":"¡Secretaryucunami llullacuypa","poem":1},{"lineBreak":true},{"text":"chay laycunataga jucnöman ticrachisha!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaypitami chay musyaj-yachajcunaga pengaycho cangapaj.","poem":1},{"lineBreak":true},{"text":"Trampaman yaycusha animalnöpis mancharenga.","poem":1},{"lineBreak":true},{"text":"Noga nishätaga manacajmanmi churasha.","poem":1},{"lineBreak":true},{"text":"Chauraga ¿imanöpataj yachaj canga?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chaypitami warmincunapis juc runawanna tiyanga.","poem":1},{"lineBreak":true},{"text":"Chacrancunatapis juc runanami aronga.","poem":1},{"lineBreak":true},{"text":"Paycunaga jatunpis tacshapis yarpaycan","poem":1},{"lineBreak":true},{"text":"mana allicunata rurayllapa gänayta.","poem":1},{"lineBreak":true},{"text":"Profëtacunawan cüracunapis llullacushpanmi engañacuycan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paycunaga acrashä runacuna nanächicushantapis yanga yangallami jampin.","poem":1},{"lineBreak":true},{"text":"Chayno rurarmi «Alli goyay caycan, alli goyay caycan» nin.","poem":1},{"lineBreak":true},{"text":"Rasunpaga mana alli goyayllami caycan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Fiyupa melanäcushä cajta rurarcur paycunaga pengacushachuraj?","poem":1},{"lineBreak":true},{"text":"Manami ni imanillarpis pengacushachu.","poem":1},{"lineBreak":true},{"text":"Manami musyannachu imano pengacuna cashantapis.","poem":1},{"lineBreak":true},{"text":"Chayno cashanpitami castigaptëraj mayanga.","poem":1},{"lineBreak":true},{"text":"Chayrämi mana alliman chayanga.","poem":1},"Noga Tayta Diosmi chayno në."]},{"type":"verse","number":13,"content":[{"text":"Übas chacrapitaga übasta pallämanmi.","poem":1},{"lineBreak":true},{"text":"Ïgus chacrapitapis ïgusta pallämanmi.","poem":1},{"lineBreak":true},{"text":"Gamcunapitami ichanga imatapis mana chasquishcächu.","poem":1},{"lineBreak":true},{"text":"Chaquisha öjacunanöllami carcaycanqui.","poem":1},{"lineBreak":true},{"text":"Chaypitami llapan tarichishäcunatapis guechuchishayqui.","poem":1},"Noga Tayta Diosmi chayno në.›"]},{"type":"line_break"},{"type":"verse","number":14,"content":["«Runacunanami nenga:",{"text":"« ‹¿Imanirtaj cayllachöga carcaycanchi?","poem":1},{"lineBreak":true},{"text":"¡Llapanchi juclla aywacushun curalasha caycaj siudäcunaman","poem":1},{"lineBreak":true},{"text":"chaycho wañunanchïpaj!","poem":1},{"lineBreak":true},{"text":"Tayta Diosninchïmi wañunanchïpaj camacächisha.","poem":1},{"lineBreak":true},{"text":"Juchata rurashanchïpitami wañunanchïpaj bininasha yacuta upuchimashcanchi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Alli goyaytami munarcaycaranchi.","poem":1},{"lineBreak":true},{"text":"Ichanga manami yarpashanchïnöchu casha.","poem":1},{"lineBreak":true},{"text":"Mana gueshyayllapa goyaytami yarparanchi.","poem":1},{"lineBreak":true},{"text":"Ichanga fiyupa manchachicuyllami casha.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Contranchïcuna aywarcaycämunnami!","poem":1},{"lineBreak":true},{"text":"¡Cawalluncunapa jämayninpis Danpita-pachami wiyacaycämun!","poem":1},{"lineBreak":true},{"text":"Cawalluncuna wagaptin llapan jircami sicsicyan.","poem":1},{"lineBreak":true},{"text":"Paycunaga aywarcaycämun nasyuncho cajta illgächinanpämi.","poem":1},{"lineBreak":true},{"text":"Siudätapis juchuchengami. Chaycho tiyajcunatapis wañuchengami.›","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gamcunaman cachamushaj wañuchicoj culebracunatami.","poem":1},{"lineBreak":true},{"text":"Chaycunataga manami pipis manshuyächengapächu.","poem":1},{"lineBreak":true},{"text":"Chay culebracunami cañishunquipaj.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"heading","content":["Marcanpaj Jeremías llaquicushan"]},{"type":"verse","number":18,"content":[{"text":"Llaquicuynëpäga manami ima jampipis canchu.","poem":1},{"lineBreak":true},{"text":"Llaquicuyllawanmi shongöpis ushaycan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Marca-masëcuna intëruchömi llaquicur wagashpan nircaycan:","poem":1},{"lineBreak":true},{"text":"«Sionchöga ¿mananachu Tayta Dios can?","poem":1},{"lineBreak":true},{"text":"Rayninchëga ¿mananachu chaycho can?» nir.","poem":1},{"lineBreak":true},{"text":"Chayno niptinmi Tayta Dios nin: «¿Imapätaj gamcuna rabyachimanqui","poem":1},{"lineBreak":true},{"text":"mana sirbej ïdulucunata adurashpayqui,","poem":1},{"lineBreak":true},{"text":"juc-lä runacuna ‹diosnë› nishan mana bälejta adurashpayqui?» nir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Runacunana nin: «Usya quillacunaga päsashanami.","poem":1},{"lineBreak":true},{"text":"Micuy shuntapacuypis ushacashanami.","poem":1},{"lineBreak":true},{"text":"Ichanga noganchïta manami salbamashcanchïrächu» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Marca-masëcuna ñacashannömi nogapis ñacaycä.","poem":1},{"lineBreak":true},{"text":"Llaquicuywan manchariymi nogataga mana cacharimanchu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Galaadchöga ¿manachuraj ima jampillapis can?","poem":1},{"lineBreak":true},{"text":"Chaychöga ¿manachuraj pillapis jampicoj can?","poem":1},{"lineBreak":true},{"text":"¿Imanir-raj marca-masëcuna mana allchacanchu?","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}