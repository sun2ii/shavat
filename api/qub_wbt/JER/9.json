{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JER","translationId":"qub_wbt","name":"JEREMÍAS","commonName":"JEREMÍAS","title":"Jeremías","order":24,"numberOfChapters":52,"sha256":"22c505206ffad78bae2889e94e5c4c2651ebda0af7bd2f8ccc4d16782a641c13","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/qub_wbt/JER/52.json","totalNumberOfVerses":1346},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"¡Ojalä ñawëga pashtaj yacuno canman!","poem":1},{"lineBreak":true},{"text":"Chauraga wañoj marca-masëcunapaj","poem":1},{"lineBreak":true},{"text":"pagasta junajtapis wagaptë pashtaj yacunömi weguë llojshinman.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Ojalä chunyajcho wasë canman chaycho tiyacunäpaj!","poem":1},{"lineBreak":true},{"text":"Chauraga marca-masëcunata cachaycur caruchömi tiyacöman.","poem":1},{"lineBreak":true},{"text":"Paycunaga llapanpis pasaypa juchasapallanami carcaycan.","poem":1},{"lineBreak":true},{"text":"Paycunaga llapanpis Diostami chiquicurcusha.","poem":1}]},{"type":"verse","number":3,"content":["Tayta Diosga nin:",{"text":"«Chay runacunaga lëchawan illapananpaj camaricusha caycajnörämi","poem":1},{"lineBreak":true},{"text":"llullacunanpäga listu carcaycan.","poem":1},{"lineBreak":true},{"text":"Cay nasyunchöga llapanpis llullallami;","poem":1},{"lineBreak":true},{"text":"manami rasun cajtaga parlanchu.","poem":1},{"lineBreak":true},{"text":"Paycunaga ‹rejsëmi› nirpis manami rejsimanchu.","poem":1},{"lineBreak":true},{"text":"Waranllanta waranllantami mas piyur ricacuycan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amïgumanpis ama yäracuynachu.","poem":1},{"lineBreak":true},{"text":"Ni wauguiquimanpis ama yäracuynachu.","poem":1},{"lineBreak":true},{"text":"Amïgunwanpis llullapänacur lebantanacunmi.","poem":1},{"lineBreak":true},{"text":"Chay wauguilla caycarpis engañanacunmi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jucnin-jucninpis engañanacunmi.","poem":1},{"lineBreak":true},{"text":"Mayganpis manami rasun cajtaga rimanchu.","poem":1},{"lineBreak":true},{"text":"Llullacuyllapämi yachacasha carcaycan.","poem":1},{"lineBreak":true},{"text":"Jucha rurayllacho yachacasha carmi paycunaga mana wiyacunchu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Yapay-yapay mana allicunata rurayllachömi carcaycan!","poem":1},{"lineBreak":true},{"text":"Acrashä runacunaga manami rejsimayta munanchu.»","poem":1}]},{"type":"verse","number":7,"content":["Chaymi munayniyoj Tayta Dios nin:",{"text":"«Nogaga ¿imatanataj ruräman acrashä runacunata?","poem":1},{"lineBreak":true},{"text":"Gorita chulluchejnörächari paycunataga limyuyächishaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Paycunapaga rimashancunapis wañuchicoj lëchanörämi.","poem":1},{"lineBreak":true},{"text":"Engañacullarmi purircaycan.","poem":1},{"lineBreak":true},{"text":"Janan shongullami amïguncunatapis alli parlapan.","poem":1},{"lineBreak":true},{"text":"Shongullanchöga mana alliman jitarpunanpämi yarpapaycan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chayno rurarcaycaptenga ¿imanirtaj mana castigämanchu?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj mana castigämanchu yapaycho chayno mana rurananpaj?»","poem":1},"Chaynömi Tayta Dios nisha."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jircacunachöpis atayparämi wagashaj.","poem":1},{"lineBreak":true},{"text":"Pashpacunachöpis llaquicuywan wagashpä cantashaj.","poem":1},{"lineBreak":true},{"text":"Chaycunaga ushajpaj rupashami caycan.","poem":1},{"lineBreak":true},{"text":"Chaypaga manami pipis purinnachu.","poem":1},{"lineBreak":true},{"text":"Wäcacuna büyashallanpis manami wiyacannachu.","poem":1},{"lineBreak":true},{"text":"Äbicunapis jirca animalcunapis chaypitaga gueshpirmi aywacusha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Tayta Dios nin:",{"text":"«Jerusalentaga ticrachishaj ranramanmi.","poem":1},{"lineBreak":true},{"text":"Chaura jirca allgucunapa tiyanallannami canga.","poem":1},{"lineBreak":true},{"text":"Judächo caycaj siudäcunata ticrachishaj chunyajmanmi.","poem":1},{"lineBreak":true},{"text":"Chaura manami pï runapis tiyanganachu.»","poem":1}]},{"type":"verse","number":12,"content":["¿Imapitataj chay nasyun mana alli, chaquisha, chunyaj pipis mana purinan caycan? ¿Pitataj Tayta Dios willapasha chayta willacunanpaj? Imanir chayno päsashantapis musyananpaj ¿pitaj musyaj-yachaj caycan?"]},{"type":"verse","number":13,"content":["Tayta Diosmi cayno nin: «Llapanpis chaynöga päsasha laynëta Israelcuna mana cumlishanpitami, nishäcunata mana wiyacushanpitami."]},{"type":"verse","number":14,"content":["Paycunaga llapanpis goyasha shongun yarpashannöllami. Nircur taytancuna yachachishannömi mana dios caycaptin manacajcunata ‹diosnë› nir adurasha."]},{"type":"verse","number":15,"content":["Chaypitami micuynincunata ticrachishaj fiyupa ashgajman. Yacutapis bininashatami upuchishaj."]},{"type":"verse","number":16,"content":["Taytancuna ni quiquincunapis mana rejsishan nasyuncunamanmi gargushaj. Paycunata gaticachächishaj sabliyojcunawan. Chauraga ni jucnayllapis manami cawaycäga quëdanganachu.»"]},{"type":"verse","number":17,"content":["Munayniyoj Tayta Diosmi nin:",{"text":"«¡Wiyay-llapa! Wañupacuycho wagapacoj warmicunata gayachimuy.","poem":1},{"lineBreak":true},{"text":"Chayno wagay yachajcunataga ashimuy.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Rasunpa juclla shamuchun.","poem":1},{"lineBreak":true},{"text":"Noganchïpaj llaquicuywan wagachun.","poem":1},{"lineBreak":true},{"text":"Paycuna wagaptin noganchïpapis weguinchi ñawi junta yurichun.","poem":1},{"lineBreak":true},{"text":"Guepshanchïcunapis ushmasha cachun.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sionpita-pacha wiyacämun nanaywan cayno gaparpashanpis:","poem":1},{"lineBreak":true},{"text":"«¡Fiyupa cuyapaypämi llapanchïpis mana alli quëdashcanchi!","poem":1},{"lineBreak":true},{"text":"¡Fiyupa pengaypämi carcaycanchi!","poem":1},{"lineBreak":true},{"text":"Cananga nasyunninchïta cachaycärirchari aywacushun.","poem":1},{"lineBreak":true},{"text":"Wasinchïcunapis juchushami caycan.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tayta Dios nishanta sumaj wiyay warmicuna.","poem":1},{"lineBreak":true},{"text":"Pay imata willapäshushayquitapis sumaj yarpay.","poem":1},{"lineBreak":true},{"text":"Wamrayquicunata yachachiy wagayta.","poem":1},{"lineBreak":true},{"text":"Warmi-masiquicunatapis yachachiy cayno llaquicunanpaj:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"«Wasinchïcunaman wañuymi chayamusha.","poem":1},{"lineBreak":true},{"text":"Palasyunchïcunamanpis chayasha.","poem":1},{"lineBreak":true},{"text":"Wamranchïcunata cällicunacho wañuchin; mösucunatana läsacunacho.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wañusha runacuna yänin mashtarpäcun uywacunapa iscanno.","poem":1},{"lineBreak":true},{"text":"Rïguta rutuptin shicwajcunata mana shuntashannömi jitarpäcun» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":["Tayta Diosmi nin:",{"text":"«Musyaj-yachajpis musyaj yachaj cashanpita ama alli-tucuchunchu.","poem":1},{"lineBreak":true},{"text":"Munayniyojpis munayniyoj cashanpita ama alli-tucuchunchu.","poem":1},{"lineBreak":true},{"text":"Rïcupis rïcu cashanpita ama alli-tucuchunchu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ichanga pipis cushicuchun nogata rejsimashanpita, nishäta rurashanpita,","poem":1},{"lineBreak":true},{"text":"Noga Dios cashäta musyashanpita.","poem":1},{"lineBreak":true},{"text":"Cushicuchun cay pachacho pï-maytapis cuyashäta, allita rurashäta, rasun cajta rurashäta musyashanpita.","poem":1},{"lineBreak":true},{"text":"Chayno caj runami ichanga nogata cushicachiman.»","poem":1},"Tayta Diosmi chayno nisha."]},{"type":"verse","number":25,"content":["Tayta Diosmi nin: «Juc junaj castigashämi cuerpullancho señalacojcunataga. Castigashaj:"]},{"type":"verse","number":26,"content":["Egipto, Judá, Edom, Amón, Moab nasyun runacunata. Castigashaj chunyajcho tiyajcunatapis, sentïdunpa rutucojcunatapis. Llapan nasyun runacunami janan-shongulla cuerpun señalasha caycan. Israelcunapis conträtu rurashäta mana cumlishpanmi janan-shongulla señalacusha carcaycan.»"]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}