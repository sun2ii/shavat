{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"heading","content":["Gueshyaycashanpita Job llaquicushan"]},{"type":"verse","number":1,"content":[{"text":"«¡Cawaytaga yamacashcänami!","poem":1},{"lineBreak":true},{"text":"Chaymi wichaypa uraypana rimashaj.","poem":1},{"lineBreak":true},{"text":"Llaquisha cayllawanmi imatapis rimashaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Diosta nishaj: ‹¡Ama nimaychu «juchayojmi canqui» nir!","poem":1},{"lineBreak":true},{"text":"¡Chaypa ruquenga willamay imapita ñacachimashayquitapis!›","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nogataga quiquiquimi camamashcanqui.","poem":1},{"lineBreak":true},{"text":"Chayno camaycämarga ¿imanirtaj ashiycanqui jucha rurashäcunata?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj camacächinqui fiyu runacuna mana alli ruramänantapis?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gamga manami runacuna yarpashannöchu imatapis yarpanqui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gamga manami runacuna cawashannöchu cawanquipis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chayno camaycämarga ¿imanirtaj ashiycanqui","poem":1},{"lineBreak":true},{"text":"jucha rurashäcunata, mana allita rurashäcunatapis?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Noga juchaynaj cashätaga musyaycanquimi.","poem":1},{"lineBreak":true},{"text":"Gampa munayniquipita salbamänanpäga manami pipis canchu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quiquiquimi maquiquiwan ruramarayqui.","poem":1},{"lineBreak":true},{"text":"¡Cananga illgächimayta munaycanqui!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mitullapitami ruramarayquipis.","poem":1},{"lineBreak":true},{"text":"Cananga ¿yapaychu polbuman ticrarachimanqui?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Cuwäju lëchita tintichejnömi cuerpöta camacächishcanqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gammi tullöcunatawan ancöcunata charinacachir camacächishcanqui.","poem":1},{"lineBreak":true},{"text":"Aychäcunata, garäcunatapis yurichishcanqui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Cawachimarayqui, cuyamarayqui.","poem":1},{"lineBreak":true},{"text":"Alli ricamashpayquimi cawaycächimanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Cananmi ichanga musyä shongullayquicho yarpapaycämashayquita.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Juchata ruranäpaj cashanta mana cashantapis ricapaycämarayqui,","poem":1},{"lineBreak":true},{"text":"juchata ruraptëga castigamänayquipaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Juchata rurasha carga manami salbacönachu.","poem":1},{"lineBreak":true},{"text":"Juchaynaj carpis uysurayllami uysuräcö.","poem":1},{"lineBreak":true},{"text":"Manacajmanmi churamashcanqui, llaquicaycächimanqui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Uysuraycashäpita ricäramuptë gamga liyunnömi gaticachämanqui.","poem":1},{"lineBreak":true},{"text":"Ushacächimänayqui-cashami tucuyta ruraycanqui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nogapa conträ testïgucunaga manami pishinchu.","poem":1},{"lineBreak":true},{"text":"Gam nogapäga mas masnami rabyaycanqui.","poem":1},{"lineBreak":true},{"text":"¡Suldärucunanömi jananman-jananman ñacaycächimanqui!","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«¿Imapäraj yurichimarayqui?","poem":1},{"lineBreak":true},{"text":"Pipis manaraj ricamaptin mamäpa pachallanchöna wañucöman caran.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mamäpa pachallanpitana pampaycamanman caran.","poem":1},{"lineBreak":true},{"text":"Chauraga imaypis mana cashanönami cäman caran.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Noga wallca timpulla cawanäpaj caycaptëga","poem":1},{"lineBreak":true},{"text":"ama ñacachimaynachu ari.","poem":1},{"lineBreak":true},{"text":"Rätullapis cachaycamay ari cushisha goyapärinäpaj.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chaypitaga imaypis mana cutimojnami aywacushaj.","poem":1},{"lineBreak":true},{"text":"Aywacushaj yanauyaycaj chacaymannami.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chay pachaga caycan yana mancapa siquinno yanauyaycajmi, pasaypa mana allimi.","poem":1},{"lineBreak":true},{"text":"Chaychöga manami achquipis canchu.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}