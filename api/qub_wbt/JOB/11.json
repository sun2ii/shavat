{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["Zofar jitapashan"]},{"type":"verse","number":1,"content":["Chayno niptin Naamat partipita Zofar jutiyoj runa niran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Manacajcunata rimaycajtaga ¿pillapis manachuraj upällachinman?","poem":1},{"lineBreak":true},{"text":"¿Shimisapa cayniquiwanchuraj rimaycashayquita bälichinqui?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Chay-jina rimashayquiwanchu nogacunata upällachimayta yarpanqui?","poem":1},{"lineBreak":true},{"text":"¿Manacajman churashayquipita pipis mana cutichishunayquitachu yarpanqui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"‹Allitami yarpaycä› niycanqui.","poem":1},{"lineBreak":true},{"text":"‹Juchaynajmi cä› niycanquimi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Ima alliraj canman Tayta Dios llapanta musyachishuptiqui!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Payga tantiyachishunquimanmi imano yachay cashantapis.","poem":1},{"lineBreak":true},{"text":"Chay yachaycuna noganchïpäga mana tantiyaypämi.","poem":1},{"lineBreak":true},{"text":"Chayrämi musyanquiman jucha rurashayquiman-tupu Tayta Dios mana castigashushayquita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«¿Tayta Dioslla musyashancunata gampis musyanquimanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Yarpashancunatapis ushajpächuraj musyanquiman?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaycunaga syëlupitapis mas janajchömi.","poem":1},{"lineBreak":true},{"text":"Chayno caycaptenga ¿imatataj ruranquiman?","poem":1},{"lineBreak":true},{"text":"Pachapa rurinpitapis mas rurichömi.","poem":1},{"lineBreak":true},{"text":"Chayno caycaptenga ¿imatataj musyanquiman?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Diospa yarpaynenga cay pachapitapis mas jatunmi,","poem":1},{"lineBreak":true},{"text":"lamarpitapis mas anchumi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Dios shamur, prësu aparcur jusgaptin","poem":1},{"lineBreak":true},{"text":"¿pillaga payta michanmanchuraj?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Payga musyanmi pï llulla cashantapis.","poem":1},{"lineBreak":true},{"text":"Chaynöpis ricanmi mana allita ruraycajtapis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Imay junajmi runata bürru wachanga,","poem":1},{"lineBreak":true},{"text":"chay junajrämi mana tantiyacoj runapis tantiyaconga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Llapantapis allillatana ruray.","poem":1},{"lineBreak":true},{"text":"Nircur ruwacushpayqui Tayta Diosta mañacuy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aypalla juchata aparicusha cashpayquega juchayquita cachaycuyna.","poem":1},{"lineBreak":true},{"text":"Famillyayquicuna juchata rurananta ama dëjaynachu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaymi manana pengacunquipänachu.","poem":1},{"lineBreak":true},{"text":"Chauraga mana yarpachacuypa, mana manchacuypana goyanquipaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Imano ñacashayquitapis gongaycunquipänami.","poem":1},{"lineBreak":true},{"text":"Yacu päsacushannömi llapan yarpachacushayquipis cangapaj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gampäga las-dösinörämi pachapis achicyacäconga.","poem":1},{"lineBreak":true},{"text":"Gampaj pacha usharashanpis pacha warashanömi ricacongapaj.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tayta Dios ricashuptiquimi payman yäracur jauca puñunquipaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Puñuptiquipis manami imapis manchachishunquipänachu.","poem":1},{"lineBreak":true},{"text":"Achcajmi yanapänayquipaj ruwacushunquipaj.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fiyucunami ichanga ashirpis mana tarengachu.","poem":1},{"lineBreak":true},{"text":"Pacacunanpaj ashirpis manami tarengachu.","poem":1},{"lineBreak":true},{"text":"Paycunataga wañuyllami shuyaraycan.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}