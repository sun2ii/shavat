 nircur mashtaypa mashtar gargurin.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mandajcunapa yarpaynincunatapis gongaycachin.","poem":1},{"lineBreak":true},{"text":"Nircur chaqui jirca chunyajcho näni mana cashancunacho pantacächin.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Chaychönami chacaychöno yatayllapa,","poem":1},{"lineBreak":true},{"text":"machasha runacunano tapraypa-taprar purin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}