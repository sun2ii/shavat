{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"heading","content":["Wallca watalla runa cawashanta Job rimashan"]},{"type":"verse","number":1,"content":[{"text":"«Runaga wallca watallami cawan.","poem":1},{"lineBreak":true},{"text":"Fiyupa ñacallarmi goyan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Payga wayta pashtarcur wañuytacäcojnöllami.","poem":1},{"lineBreak":true},{"text":"Cawanpis llantuy päsacojnöllami.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios, ¿chaynölla caycaj runamanrächi ricärinqui?","poem":1},{"lineBreak":true},{"text":"¿Chayno caycaptëchu jusgamayta munaycanqui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Piraj ganra caycajta limyuyächinman?","poem":1},{"lineBreak":true},{"text":"¡Pipis manami puydinchu!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Runa ayca wata cawananpäpis gammi camacächinqui.","poem":1},{"lineBreak":true},{"text":"Imay junajcama cawananpäpis gammi señalapanqui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Runataga amana ricapaynachu.","poem":1},{"lineBreak":true},{"text":"Jauca goyäcuchun piyun aruyta ushashanno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Juc yörata sajtarirpis","poem":1},{"lineBreak":true},{"text":"yarparaycanchïmi chillguimunanpaj cashanta,","poem":1},{"lineBreak":true},{"text":"chillguimur yapay wiñananpaj cashanta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sapin auquisyasha caycaptinpis,","poem":1},{"lineBreak":true},{"text":"tumpun ismuycaptinpis sapin alli caycaptenga","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"yacu chayaptenga yapaymi chillguimonga.","poem":1},{"lineBreak":true},{"text":"Mallwa yörapanörämi rämancunapis cupösu wiñanga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Runami ichanga imaypis mana cutimunanpäna wañucun.","poem":1},{"lineBreak":true},{"text":"Wañorga ¿maymantaj chayan?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lamar yacu chaquishannömi,","poem":1},{"lineBreak":true},{"text":"mayucuna päsashannömi","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"runapis wañorga manana imaypis cawarimunnachu.","poem":1},{"lineBreak":true},{"text":"Syëlu caycashancamaga runa pamparashanpita manami jatarimongarächu.","poem":1},{"lineBreak":true},{"text":"Puñuycajno caycashanpita manami ricchamongarächu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«¡Ima alliraj canman rabyashayqui gasacänancama wañushacuna caycashanman pacaycamaptiqui!","poem":1},{"lineBreak":true},{"text":"¡Ima alliraj canman rabyashayquipita alliyärishpayqui yarparcamaptiqui!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ichanga runa wañushpan ¿cawarimongachuraj?","poem":1},{"lineBreak":true},{"text":"Cawarimunan captenga may-jina ñacashpäpis noga shuyarämanmi cawarimunäpaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaura gam gayamaptiqui nogaga wiyämanmi.","poem":1},{"lineBreak":true},{"text":"Camamashayqui captëmi alli ñawillayquiwan ricäramanquiman.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Llapanpitami chapämanquiman.","poem":1},{"lineBreak":true},{"text":"Juchäcunataga mananami cäsupämanquimannachu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Custalman wiñarcojnömi llutanta rurashäcunata gongaycunquiman.","poem":1},{"lineBreak":true},{"text":"Llapan mana allita rurashäcunatami perdunamanquiman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Juchuycällar jircacuna illgashannömi,","poem":1},{"lineBreak":true},{"text":"gagacunapis juc-läman witishannömi,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"yacu wagruypa wagrur rumicunata ushacurcushannömi,","poem":1},{"lineBreak":true},{"text":"tamya yacupis ñuchu allpata apacushannömi","poem":1},{"lineBreak":true},{"text":"gampis runa yarpaycashancunata mana camacänanpämi ninqui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Imaypis mana cananpämi runacunataga illgächinqui.","poem":1},{"lineBreak":true},{"text":"Cay pachachöpis gongaycächinquina.","poem":1},{"lineBreak":true},{"text":"Runaga chachayaycällarmi wañucun.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wamrancuna alliman chayaptinpis","poem":1},{"lineBreak":true},{"text":"wañucoj runaga manami musyannachu.","poem":1},{"lineBreak":true},{"text":"Wamrancuna mana alliman chayaptinpis","poem":1},{"lineBreak":true},{"text":"wañucoj runaga manami tantiyannachu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chay runapäga nanayllanami, almanpis llaquicuyllachönami.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}