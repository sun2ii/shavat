{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["Jobta Elifaz yapay piñacushan"]},{"type":"verse","number":1,"content":["«Chayno niptin Temán parti runa Elifaz yapay niran:"]},{"type":"verse","number":2,"content":[{"text":"«¿Yachaj runaga manacajcunata parlashpanchuraj cutichinman?","poem":1},{"lineBreak":true},{"text":"¿Wayrata cacnejnölla llutancunallata rimanmanchuraj?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Yachaj runaga shimin tarishallanpitapis rimanmanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Manacajcunatapis parlanmanchuraj?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tayta Diosta manchacuna cashantapis gamga manami tantiyanquinachu.","poem":1},{"lineBreak":true},{"text":"¡Llapan shongunpa Tayta Diosta adurana cashantapis chapatami ruraycanqui!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Llutan yarpayniquimi mana allita rimachishunqui.","poem":1},{"lineBreak":true},{"text":"Chaymi yachaj-tucoj runano gampis rimaycanqui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quiquiquipa shimillayquimi jitarpushunqui, manami nogachu.","poem":1},{"lineBreak":true},{"text":"Quiquiquipa shimillayquimi ticrapaycäshunqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«¿Gamga yarpanquichu gampita mas unayga cay pachapis mana cashanta?","poem":1},{"lineBreak":true},{"text":"¿Yarpanquichu gampita mas unayga puntacunapis ni jircacunapis mana cashanta?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¿Diosta pacayllapa tantiyachejchu canqui?","poem":1},{"lineBreak":true},{"text":"¿Gamllachu cay munduchöga llapantapis mas yachanqui?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¿Imatataj musyanqui nogacuna musyashäpita mastaga?","poem":1},{"lineBreak":true},{"text":"¿Imatataj gamga mas yachanqui nogacuna mana tantiyashä cajta?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Nogacunachöga caycanmi chacha auquin runacunapis!","poem":1},{"lineBreak":true},{"text":"¡Caycanmi papäniquipita mas unayta cawajcuna, llapanta musyajcunapis!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¿Gampäga manachu alli caycan quiquin Tayta Dios shogashushallayqui,","poem":1},{"lineBreak":true},{"text":"alli shimillanpa willapäshushayqui?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Imanirtaj shonguyqui munashanta ruraycanqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj ñawiquipis saltanaypa saltanaycan?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¿Imanirtaj Tayta Diospaj rabyaycanqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj shimiqui tarishanta rimanqui?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«¿Runaga ‹limyumi cä› ninmanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Runaga juchaynaj canmanchuraj?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Diosga anjilnincunatapis manami llapan shongunpaga yäracunchu.","poem":1},{"lineBreak":true},{"text":"Pay ricaptenga syëlupis manami limyunöchu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chayno caycaptenga runaga piyur-rächari,","poem":1},{"lineBreak":true},{"text":"mana alli melanaypaj caycarga,","poem":1},{"lineBreak":true},{"text":"yacunaycajnöraj jucha rurayta ashiycarga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Masqui sumaj wiyamay.","poem":1},{"lineBreak":true},{"text":"Noga nishayqui cawashä watacunacho imano yachacushätapis,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"yachajcuna imallatapis yachachimashanchïta.","poem":1},{"lineBreak":true},{"text":"Paycunaga yachacuran unay caj awiluncunapitami.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Paycunatami chacrataga goycuran.","poem":1},{"lineBreak":true},{"text":"Paycunachöga manami jäpa runacunaga talluraranchu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mana allita ruraj fiyu runacuna manami alläpaga cawanchu.","poem":1},{"lineBreak":true},{"text":"Paycunaga rabyar ñacallarmi goyan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Paycunaga imapis gaparämojta wiyar fiyupa mancharin.","poem":1},{"lineBreak":true},{"text":"Pipis mana yaycunancho caycaptinpis suwacunaga suwapanmi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Paycuna manami yarpanchu chacajman chayananpita gueshpiyta.","poem":1},{"lineBreak":true},{"text":"¡Espädawan wañunallanpänami acrasha caycan!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Paycunaga micuyta ashirmi purin.","poem":1},{"lineBreak":true},{"text":"Musyannami paycunapäga pacha chacacäcunanpaj cashanta.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Llaquicuycunallami pasaypa manchariycächin.","poem":1},{"lineBreak":true},{"text":"Juc ray pillyapita chapacunanpaj shuyaraycajnömi caycan.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Chaynöga canga Tayta Diospa contran ricacojcunapämi;","poem":1},{"lineBreak":true},{"text":"Ima-aycapäpis munayniyojta manacajman churar parlajcunapämi;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"chapacuna escüdunwan chapacushpan","poem":1},{"lineBreak":true},{"text":"callpanman yäracushpan Tayta Diospa contran aywajpämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Chay runacunapaga cäranpis werami caycan.","poem":1},{"lineBreak":true},{"text":"Wera cayllawanmi pachanpis liwaraycan.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Chayno captinpis paycuna tiyashan siudäcunaga ragällanmi quëdanga.","poem":1},{"lineBreak":true},{"text":"Wasincunapis chunyaj jaguirishami canga.","poem":1},{"lineBreak":true},{"text":"Chaycunaga ganra goturaycajllami ricaconga.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Rïcuga manami unaycamaga rïculla cangapächu.","poem":1},{"lineBreak":true},{"text":"Charashancunapis manami aypallamanga miranganachu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Yanauyaycaj chacaypitaga manami imanöpis gueshpengapächu.","poem":1},{"lineBreak":true},{"text":"Chay runaga ricacongapaj jachapa rämancunata nina wapcharishannömi.","poem":1},{"lineBreak":true},{"text":"Tayta Dios pücariptin ushajpämi ushacanga.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Yanga manacajcunallaman ama yäracuchunchu.","poem":1},{"lineBreak":true},{"text":"Chayman yäracorga yanga manacajcunallatami tarenga.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Manaräpis timpun chayamuptinmi rämancuna wañutacäconga.","poem":1},{"lineBreak":true},{"text":"Chaycunaga mananami yapayga berdiranganapischu.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Chaycunaga canga übas yörapa wayuynin mana pogojnömi,","poem":1},{"lineBreak":true},{"text":"olivo yörapa waytancuna marpur shicwacojnömi.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Diosman mana yäracojcunapaga wamrancunapis manami canganachu.","poem":1},{"lineBreak":true},{"text":"Saynita chasquishan ima-aycanpis ninachömi rupanga.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Chay runacunaga juchallatami gueshyaj caycan.","poem":1},{"lineBreak":true},{"text":"Pachanchöga engañacuyllami caycan.","poem":1},{"lineBreak":true},{"text":"Wachangapis llullacuyllatami.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}