{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["Job llaquicushan"]},{"type":"verse","number":1,"content":["Chayno niptin Job cutichishpan niran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Chay nishayquitanöga achca cutinami wiyashcä.","poem":1},{"lineBreak":true},{"text":"Gamcunaga shacyachimänayquipa ruquin masmi llaquicaycächimanqui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Imaycamaraj manacajcunallata rimarcaycanqui?","poem":1},{"lineBreak":true},{"text":"¿Imataj togripaycäshunqui chayno nimänayquipäga?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gamcuna nogano ñacaycaptiquega","poem":1},{"lineBreak":true},{"text":"nogapis gamcunanömi nëman.","poem":1},{"lineBreak":true},{"text":"Asipashpä umätapis jajtachëmanrämi.","poem":1},{"lineBreak":true},{"text":"Nircur tucuy-niraj parlarmi nëman.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nogaga gamcunata alli shimëpami parlapäman. Shacyachëman.","poem":1},{"lineBreak":true},{"text":"Masta balurta göman.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Imano parlaptëpis nanaynëga manami chawanchu.","poem":1},{"lineBreak":true},{"text":"Upälla cacuptëpis manami päsarpunchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Diosga pasaypanami callpäta ushacächisha.","poem":1},{"lineBreak":true},{"text":"Llapan famillyäcunatanami ograshcä.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Intëröpa curalaraycämajtanömi mayaycä.","poem":1},{"lineBreak":true},{"text":"Chayno caycashätaga cayno yamajna caycashämi musyacaycächin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Diosga micucoj animalnömi manchachiman.","poem":1},{"lineBreak":true},{"text":"Gaticachämar rachir usharaman.","poem":1},{"lineBreak":true},{"text":"Chiquimaj-jinarämi mana cachaypa ricapacarcamashapis.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nogata chiquimarmi runacuna gotucan.","poem":1},{"lineBreak":true},{"text":"Ricapämashpan umancunatapis jajtachinraj.","poem":1},{"lineBreak":true},{"text":"Manacajman churamashpan lagyar-ushaman.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Diosmi cachaycamasha fiyu runacunapawan wañuchicojcunapa maquinman.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nogaga allimi goyäcuycarä.","poem":1},{"lineBreak":true},{"text":"Paymi illajpita cuncapita charimasha.","poem":1},{"lineBreak":true},{"text":"Nircurmi llapir usharamasha.","poem":1},{"lineBreak":true},{"text":"Lëchawan chayachinanpämi apuntaraycäman.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wacpita caypita lëchawan chayaycächiman.","poem":1},{"lineBreak":true},{"text":"Mana cuyapaypami intëröman yaycoj-yaycoj chayachimasha.","poem":1},{"lineBreak":true},{"text":"Aguillëcunapis pampachömi mashtaraycan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jananman-jananman pasaypa ñacaycächiman.","poem":1},{"lineBreak":true},{"text":"Runa pillyaman yaycojnörämi nogamanga yaycaycämun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Fiyupa llaquicushpämi gachga röpacunata jaticushcä.","poem":1},{"lineBreak":true},{"text":"Umätapis ñuchu allpacunamanmi jatishcä.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wagaycaptillämi gaglläpis jacacurcusha.","poem":1},{"lineBreak":true},{"text":"Ñawëpis pucayacäcusha.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaynömi päsamasha imatapis mana ruraycaptë,","poem":1},{"lineBreak":true},{"text":"llapan shongöpa mañacuycaptëpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«¡Cay pacha, yawarnëtaga ama pacaycuchunchu!","poem":1},{"lineBreak":true},{"text":"¡Ama pacaycuchunchu mañacushätaga!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Janaj pachachöga faburnë parlananpaj caycanmi.","poem":1},{"lineBreak":true},{"text":"Janajchöga abogädö caycanmi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Amïgöcunaga manacajmanmi churaman.","poem":1},{"lineBreak":true},{"text":"Nogami ichanga Tayta Diosta mañacur wagä.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Juc runa runa-masinpaj parlashanno","poem":1},{"lineBreak":true},{"text":"pillapis Tayta Diospa ñaupancho nogapaj faburnë parlarcuchun.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wallca watallapis cawanäpaj caj watacuna ushacaycannami.","poem":1},{"lineBreak":true},{"text":"Manapis aycällatanami imaypis mana cutimoj aywacushaj.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}