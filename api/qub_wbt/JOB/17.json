{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"«Jämaynëpis ushacaycannami.","poem":1},{"lineBreak":true},{"text":"Wañuypis janächönami.","poem":1},{"lineBreak":true},{"text":"Pampacunäpaj sepultürapis caycannami.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Manacajman churamaj runacunallami ñaupächo carcaycan.","poem":1},{"lineBreak":true},{"text":"Pagasta junajtapis chayno runacunallami täparaycäman.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ichanga Tayta Dios gammi nogapa faburnë rimarcunqui.","poem":1},{"lineBreak":true},{"text":"Gam mana rimarcuptiquega ¿pitaj rimarconga ari?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gammi manacajman churamajcuna mana tantiyananpäpis camacächishcanqui.","poem":1},{"lineBreak":true},{"text":"Ama camacaycachiychu paycuna binsimänantaga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Imatapis chasquinan-rayculla amïguncunata ima mana allimanpis jitarpoj cäga","poem":1},{"lineBreak":true},{"text":"wamrancunatapis ñacajtami ricanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Tayta Dios, gammi camacächishcanqui llapan runacunapis waccho caycho rimamänanpaj, manacajman churamänanpaj.","poem":1},{"lineBreak":true},{"text":"Waquenga asta cärächöpis togapämanmi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nanächicuycaptillämi ñawëpis chacaycanna.","poem":1},{"lineBreak":true},{"text":"Cuerpöpis llantuynöllanami ushacaycan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chayta ricarmi alli runacunaga almirasha ricacun.","poem":1},{"lineBreak":true},{"text":"Rabyacarcärir ‹¡Masqui ricay juchayoj runata!› nir rimarcaycäman.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Quiquincunaga ‹juchaynajmi cä› nircaycanmi;","poem":1},{"lineBreak":true},{"text":"‹ima mana allitapis manami rurashcächu› nircaycanmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Llapaniqui cayman shamuy tapunacunanchïpaj.","poem":1},{"lineBreak":true},{"text":"Gamcunachöga manami ni jucnayllatapis yachajta tarishächu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Manapis aycällatanami wañucushaj.","poem":1},{"lineBreak":true},{"text":"Imata rurayta yarpashäpis, munashäpis manami camacannachu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gamcunami ichanga chacaytapis junajman ticrarachinqui.","poem":1},{"lineBreak":true},{"text":"¡Sinchi chacay caycaptinpis ‹pacha achicyanganami› nircaycanqui!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nogataga wañuyllami shuyaraycäman.","poem":1},{"lineBreak":true},{"text":"Yanauyaycaj chacayllanami wasëpis canga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pampacunä uchcutanami ‹gammi canqui taytä› nishaj.","poem":1},{"lineBreak":true},{"text":"Curucunatanami ‹gammi canqui mamä pañë› nishaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaura shuyarar yarpaycashäga ¿imanötaj canga?","poem":1},{"lineBreak":true},{"text":"¿Pillaga noga rurayta yarpashäcunata rurangachuraj?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Manami. Yarpashäcunawanga iwalmi pampacushaj.","poem":1},{"lineBreak":true},{"text":"Allpaman ticrar iwalmi ushacäshaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}