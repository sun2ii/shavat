{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Juchayojcuna imano usharashantapis Bildad nishan"]},{"type":"verse","number":1,"content":["Chaypita Shúa jutiyoj parti runa Bildad yapay niran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«¿Imaycamataj chaynölla rimaycanqui?","poem":1},{"lineBreak":true},{"text":"Yarpayniquiman cutisha captiquega parlashwanmi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Imanirtaj animalcunatano ricamanqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj upa runatano ricamanqui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fiyupa rabyarga quiquillayquimi ushacuycanqui.","poem":1},{"lineBreak":true},{"text":"Chayno rurar ¿yarpanquichu cay pacha chunyaj ricacunanta,","poem":1},{"lineBreak":true},{"text":"gagacunapis juc-läman witicurinanta?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Rasunpami fiyu runacunapa achquenga upicäconga.","poem":1},{"lineBreak":true},{"text":"Ninanpis mananami ratapanganachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Achqui tübun upicäconga.","poem":1},{"lineBreak":true},{"text":"Wasinchöpis chacajllanami canga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alli japaycaptinmi chaquinpis sicsicyacäconga.","poem":1},{"lineBreak":true},{"text":"Quiquin rurayta yarpashancunallami mana alliman chayachenga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Purinanmanmi togllata churapayconga.","poem":1},{"lineBreak":true},{"text":"Chaura chaychömi watacäconga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Cachi-putunpitami togllaga shegucurconga.","poem":1},{"lineBreak":true},{"text":"Chaquinpitami fiyupa chanaj chutacurconga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Togllaga purinan nänichömi mana ricacaj caycanga","poem":1},{"lineBreak":true},{"text":"päsaycajta shegucurcunanpaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wacpita caypitami mancharachin.","poem":1},{"lineBreak":true},{"text":"Imay örapis mancharishami gueshpin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yargayllawanmi callpanpis mana cannachu.","poem":1},{"lineBreak":true},{"text":"Mana alli chayananpänami caycan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gueripäcuywan wallca wallcalla aychan shicwaycan.","poem":1},{"lineBreak":true},{"text":"Wañuyman apacoj gueshyami cuerpuncunatapis ushaycan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fiyu runataga wasincho alli goyäcuycajtami apacun.","poem":1},{"lineBreak":true},{"text":"Nircorga manchacuypaj murtiwanmi tincuchin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wasincho cajtaga ima-aycantapis ninami ushacurcun.","poem":1},{"lineBreak":true},{"text":"Tiyashanchöga ishancawan shirallanami juntasha.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chay runaga chaquisha sapiyoj yöranömi,","poem":1},{"lineBreak":true},{"text":"rämanpis garwashtashanömi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chay runata cay pachachöga gongayconganami.","poem":1},{"lineBreak":true},{"text":"Chay runapa jutintapis manami parlanganachu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Cay pachapitaga jitarenga.","poem":1},{"lineBreak":true},{"text":"Achicyajcho caycajtapis chacajmanmi gaycurenga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wasinchöga manami jucnayllapis quëdangachu.","poem":1},{"lineBreak":true},{"text":"Paypita mirajcuna marcancho manami ni jucnayllapis cangachu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Imano chay runata päsashantapis musyaycur may-chaychöpis fiyupami mancharenga.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chaynömi ushacanga fiyu runacunaga,","poem":1},{"lineBreak":true},{"text":"Tayta Diosta manacajman churaj runacunaga.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}