lineBreak":true},{"text":"Gamcunaga musyanquiman:","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi togllanwan nogataga charimasha.","poem":1},{"lineBreak":true},{"text":"Paymi camacächisha cayno canäpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"« ‹¡Wañuycächiman!› nir gayaraptëpis","poem":1},{"lineBreak":true},{"text":"manami pipis washämanchu.","poem":1},{"lineBreak":true},{"text":"Yanapämänanpaj ruwacuptëpis","poem":1},{"lineBreak":true},{"text":"manami pipis yanapämanchu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Diosmi nänita chapacurcusha noga maypapis mana llojshinäpaj.","poem":1},{"lineBreak":true},{"text":"Purinä nänita ticrarachisha yanauyaycaj chacayman.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pasaypa manacajmanmi churamasha.","poem":1},{"lineBreak":true},{"text":"Pipis manana rispitamänanpämi camacächisha.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nircur pasaypa mana allichömi cachaycamasha.","poem":1},{"lineBreak":true},{"text":"¡Jachata achurej-japuymi usharamasha!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rabyasha caycashantapis nogachörämi gasarpachisha.","poem":1},{"lineBreak":true},{"text":"Nogataga chiquinacushan runatanömi ñacaycächiman.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Llapan suldäruncunami nogallaman shamusha magamaj.","poem":1},{"lineBreak":true},{"text":"Wasë ñaupanpami curalapaycäramasha magamaj yaycamunanpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Tayta Diosmi camacächisha wauguëcuna,","poem":1},{"lineBreak":true},{"text":"amïgöcunapis mana rejsisha runatanöna ricamänanpaj.","poem":1},{"lineBreak":true},{"text":"Chaymi mana witipämannachu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nogapaga manami pïnëpis canchu.","poem":1},{"lineBreak":true},{"text":"Amïgöcunapis cachaycamashami.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wasëcho tiyajcunapis gongaycamasha.","poem":1},{"lineBreak":true},{"text":"Uywaynëcunapis jäpatanönami ricaman.","poem":1},{"lineBreak":true},{"text":"Paycunapäga puricachaj runanönami caycä.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gayaptëpis may-jina ruwaptëpis manami cäsumannachu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Jämaynë asyaptinmi warmëpis melanäcamanna.","poem":1},{"lineBreak":true},{"text":"Wauguëcunapis fiyupa melanäcaman.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wamra-mallwacunapis manacajmanmi churaman.","poem":1},{"lineBreak":true},{"text":"Paycuna ricamashpan asipämar washätami riman.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sumaj cuyanacushäcunapis melanäcamanmi.","poem":1},{"lineBreak":true},{"text":"Fiyupa cuyashä cajcunapis chiquicarcamashami.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Pasaypa tullullannami ricacushcäpis.","poem":1},{"lineBreak":true},{"text":"Cayno ñacaycarpis cawaycärämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Amïgöcuna cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Nogataga Tayta Diosmi castigaycäman.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"¿Imanirtaj gamcuna gaticachämanqui Tayta Dios gaticachaycämashannöga?","poem":1},{"lineBreak":true},{"text":"Janäta ricashallayquiwanna ¿manachu cuntintacunqui?","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«¡Ojalä, nishäcunata pillapis isquirbiycunman!","poem":1},{"lineBreak":true},{"text":"¡Ojalä actaman isquirbircur churaycunman!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"¡Ojalä pillapis sinsilwan tacaypa isquirbiycunman","poem":1},{"lineBreak":true},{"text":"plömuman, rumimanpis imay-yajpis mana illgänanpaj!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Noga musyämi washämajnë cawashanta.","poem":1},{"lineBreak":true},{"text":"Paymi cay pachachöga faburnë jatarenga.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ichic-ichiclla aychä ismur shicwaycaptinpis","poem":1},{"lineBreak":true},{"text":"nogaga caway-ñawëpami Tayta Diosta ricashaj.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Quiquë ñawëwanmi ricashaj.","poem":1},{"lineBreak":true},{"text":"Manami juc jäpachu, quiquëmi ricashäga.","poem":1},{"lineBreak":true},{"text":"Callpäpis pasaypa manami cajnönachu","poem":1},{"lineBreak":true},{"text":"gamcuna parlajta wiyaptë.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Gamcunaga nircaycanqui: ‹Noganchëga ¿imanöparaj ñacachishwan?","poem":1},{"lineBreak":true},{"text":"Quiquinpa juchanpitami payga ñacaycanpis› nir.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Quiquiquicunapis sablita manchacuy-llapa.","poem":1},{"lineBreak":true},{"text":"Juchasapacunata Tayta Dios castigacunan sablitaga manchacuy.","poem":1},{"lineBreak":true},{"text":"Gamcunaga tantiyacunquiman imata rurashanchïpitapis jusgamänanchïpaj caycashanta.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}