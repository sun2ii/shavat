{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Fiyucunata mana alli päsashanta Zofar nishan"]},{"type":"verse","number":1,"content":["Chaura Naamat parti runa Zofar yapay niran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Gam rimashayquipitaga fiyupami cutichiyta munä.","poem":1},{"lineBreak":true},{"text":"Chaymi upällallaga mana cacushächu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gamga gayapaycämanquimi.","poem":1},{"lineBreak":true},{"text":"Nogaga musyaycänami imano cutichiytapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Runa cay pachacho cashanpita-pacha","poem":1},{"lineBreak":true},{"text":"cayno runacuna cashantaga gam musyaycanquinami:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mana alli runacunapaga cushicushanpis rätullapämi.","poem":1},{"lineBreak":true},{"text":"Fiyucunapis rätullami cushicun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chay runa syëlucama aypajno captinpis,","poem":1},{"lineBreak":true},{"text":"pucutaycama chayashano captinpis","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"uywacunapa iscannöllami ushacanga.","poem":1},{"lineBreak":true},{"text":"Amïguncunapis ‹¿Maychöraj pay caycan?› nengami.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chacaypa ricapacushannömi,","poem":1},{"lineBreak":true},{"text":"suyñuynincho ricashannöllami illgangapaj.","poem":1},{"lineBreak":true},{"text":"Chauraga pipis manami tarengapänachu chay runataga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Iwal goyajcunapis, ricajcunapis","poem":1},{"lineBreak":true},{"text":"manami imaypis ricangapänachu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wamrancunami wacchata pobricunata cutichipaconga.","poem":1},{"lineBreak":true},{"text":"Paycunami papänincuna pobrita ima-aycanta suwapashantapis cutichenga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Timpullanchöraj caycar wañonga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Mana allita rurashancuna shimicho mishqui caycaj-japuy captinpis,","poem":1},{"lineBreak":true},{"text":"gallun ruricho caycaj-japuy captinpis,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"mishquiptin shimillancho cachej-japuy captinpis,","poem":1},{"lineBreak":true},{"text":"cuncanta mana päsachej-japuy captinpis","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"pachanchöga ismunnami.","poem":1},{"lineBreak":true},{"text":"Ismurnami ticran culebrapa benënunmanno.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chayrämi pipa ima-aycanta ushashantapis rimarenga.","poem":1},{"lineBreak":true},{"text":"Paycunapa pachanpita Tayta Diosmi gumitachimonga.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Paycunaga culebrapa benënunta micojnömi micurcaycasha.","poem":1},{"lineBreak":true},{"text":"Culebra ullishpanmi wañuchenga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mananami cushisha miconganachu","poem":1},{"lineBreak":true},{"text":"Aypalla mishquitapis aypalla lëchitapis manami upongachu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ima-aycata gänashantapis llapantami cutichipaconga.","poem":1},{"lineBreak":true},{"text":"Chaycunata manami imatapis rurangachu ni rubichangapischu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Paycunaga ima-aycantapis ushaparcurmi pobricunata garguriran.","poem":1},{"lineBreak":true},{"text":"Mana ñacar jatarachishan wasicunatami duyñu-tucarcäriran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Yargaj caytaga manami imaypis yamajchu.","poem":1},{"lineBreak":true},{"text":"Munapashantaga llapantami tariyta tïraj.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Paycunaga tarishantami micoj.","poem":1},{"lineBreak":true},{"text":"Chaypitami llapan gänashancunata unaycamaga mana dürachengachu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fiyupa rïcu cashpanga mas llaquishami goyanga.","poem":1},{"lineBreak":true},{"text":"Fiyucunami chay runata ima-aycantapis ushapanga.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Sacsaj micucurcunanpaj caycaptinmi","poem":1},{"lineBreak":true},{"text":"Tayta Diosga rabyar castiganga.","poem":1},{"lineBreak":true},{"text":"Rabyashpanmi chay runataga löcu tamyawannöraj castiganga.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Fyërru magacunapita gueshpiptenga","poem":1},{"lineBreak":true},{"text":"runsi lëchawanmi chayaycachenga.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Lëchaga cuerpunmanmi yayconga.","poem":1},{"lineBreak":true},{"text":"Ñatinninpa päsarmi jucaj-lädunpa llojshiramonga.","poem":1},{"lineBreak":true},{"text":"Chay runaga fiyupami mancharenga.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fiyupa yanauyaycaj chacaymi ñiticurconga.","poem":1},{"lineBreak":true},{"text":"Pipis mana waycupashan nina ratarirmi rupar ushacurconga.","poem":1},{"lineBreak":true},{"text":"Wasincho quëdajcunatapis llapantami ushacurconga.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Janaj syëlumi chay runa juchata rurashancunata cäranga.","poem":1},{"lineBreak":true},{"text":"Cay pachanami ima juchata rurashancunatapis nenga.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tayta Dios rabyawan castigashan örami","poem":1},{"lineBreak":true},{"text":"yacu ñitir chay runapa wasinta usharenga.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Chayno cananpämi mana alli runacunataga Tayta Dios distïnuta gosha.","poem":1},{"lineBreak":true},{"text":"Chaynöman chayananpämi surtin caycan.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}