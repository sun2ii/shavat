,"content":[{"lineBreak":true},{"text":"Quiquëpis ninäpaj caycashäta yarpashpäga mancharëmi.","poem":1},{"lineBreak":true},{"text":"Cuerpöpis shiririnrämi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¿Imanirtaj fiyu runacunaga mas unaycamaraj cawan?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj auquinyayparaj wañun?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj fiyupa rïcu caycashanchöraj wañun?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ricanrämi wamrancuna, willcancuna wiñajtapis.","poem":1},{"lineBreak":true},{"text":"Mana yarpachacuypa cushisha goyan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Paycunataga manami ima mana allipis chayanchu.","poem":1},{"lineBreak":true},{"text":"Diospis manami castiganchu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Uywancunapis fiyupami miran.","poem":1},{"lineBreak":true},{"text":"Uywanpa wawancunapis manami wañunchu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wamrancunapis pucllar cörricachan uysha-mallwacunanöraj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Cushisha gachwan,","poem":1},{"lineBreak":true},{"text":"pinticachan, arpacuna, tamburcuna, pincullucuna wagashan-tupu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Cushishami goyan wañunancama.","poem":1},{"lineBreak":true},{"text":"Allillami wañuymanpis chayan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Diostanami nin: ‹Nogacunataga ama rimapämaychu.","poem":1},{"lineBreak":true},{"text":"Manami layniquicunata musyaytapis munächu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¿Pitaj Tayta Diosga sirbiycänäpäga?","poem":1},{"lineBreak":true},{"text":"¿Imatataj gänanchi payta mañacorga?›","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chayno nirpis fiyucunaga manami quiquillanpitachu rïcuyan.","poem":1},{"lineBreak":true},{"text":"¡Chayno cashantaga manami tantiyayta atipächu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«¿Imayllaga mana alli runacunapa achquin upishachuraj?","poem":1},{"lineBreak":true},{"text":"¿Imayllaga disigrasya päsashachuraj?","poem":1},{"lineBreak":true},{"text":"¿Imayllaga Tayta Dios paycunapaj rabyacurcur paycunata ñacachishachuraj?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¿Imayllaga paycunata shucucuy wayra ogshata apajno machiypa machishachuraj?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Rimayga nin: ‹taytancuna juchata rurashanpitaga wamrancunatanami castigan› nir.","poem":1},{"lineBreak":true},{"text":"Chaynöga ama canmanchu.","poem":1},{"lineBreak":true},{"text":"Quiquin jucha ruraj ñacachonga sumaj yachacunanpaj.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ima-aycapäpis munayniyoj Tayta Diosga rabyar","poem":1},{"lineBreak":true},{"text":"quiquin jucha rurajta castigachun.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wañushatanaga manami imapis gocunnachu","poem":1},{"lineBreak":true},{"text":"famillyancunata ima-ayca päsaptinpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Ichanga ¿piraj Tayta Diostaga yachachinman,","poem":1},{"lineBreak":true},{"text":"janaj pachacho caycajcunatapis paylla jusgaj caycaptenga?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Waquin runacunaga wañucun timpuncho caycällar,","poem":1},{"lineBreak":true},{"text":"imapäpis mana yarpachacuyllapa goyaycashallancho,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"alli caycashallancho,","poem":1},{"lineBreak":true},{"text":"mana gueshyayllapa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Waquinnami ichanga cawan fiyupa llaquicullar.","poem":1},{"lineBreak":true},{"text":"Chayno runacuna wañun imaypis manaraj alliman chayar.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Imano captinpis pantiyunchöga llapanpäpis iwal-llami.","poem":1},{"lineBreak":true},{"text":"Jucninta-jucnintapis curucunallami ushacurcun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Nogaga musyaycämi nogapaj gamcuna imano yarpaycashayquitapis,","poem":1},{"lineBreak":true},{"text":"mana allita nogapaj yarpaycashayquitapis.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Gamcunaga ninacurcaycanqui: ‹¿Maytaj munayniyoj runapa wasin?","poem":1},{"lineBreak":true},{"text":"¿Maytaj fiyu runacuna tiyashan?›","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"¿Manachu gamcuna parlashcanqui caminanticunawan?","poem":1},{"lineBreak":true},{"text":"¿Manachu gamcuna wiyashcanqui paycuna willapänacushanta?","poem":1},{"lineBreak":true},{"text":"Paycuna ninacun:","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"‹Dios rabyashpan castigaptinpis fiyucunataga manami chayanchu› nir.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Fiyucunataga ¿pitaj tapun mana alli rurashancunata?","poem":1},{"lineBreak":true},{"text":"¿Pitaj castigan mana allita rurashanpita?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Wañuptenga pampaychöpis","poem":1},{"lineBreak":true},{"text":"guepa ñaupami llapan gatin.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Pantiyunpis paytaga cushishami chasquicun.","poem":1},{"lineBreak":true},{"text":"Pampacushan uchcutapis täpanrämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«¡Llaquicuycajta shogamashayquipis yangami!","poem":1},{"lineBreak":true