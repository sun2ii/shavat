{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["Elifaz jitapashan"]},{"type":"verse","number":1,"content":["Chaura Temán marca runa Elifaz yapay parlaran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Runaga ¿imapäräshi Tayta Diospäga alli canman?","poem":1},{"lineBreak":true},{"text":"Fiyupa yachaj cashpanpis ¿imachöräshi Tayta Diostaga yanapanman?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gam allillata ruraptiqui munayniyoj Tayta Diosga ¿cushicunchuraj?","poem":1},{"lineBreak":true},{"text":"Llapanchöpis alli cashayquipita ¿imallataga chasquinchuraj?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Payta rispitar munashanta rurashayquipitachuraj","poem":1},{"lineBreak":true},{"text":"piñacur castigaycäshunqui?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaypa ruquenga castigaycäshunqui mana allita rurashayquipitami,","poem":1},{"lineBreak":true},{"text":"mana atipaypaj juchata rurashayquipitami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Gamga imatapis mana nistaycashpayquimi","poem":1},{"lineBreak":true},{"text":"marca-masiquita ‹rindataraj churay› nej canqui.","poem":1},{"lineBreak":true},{"text":"Röpancunatapis ‹rinda quëdachun› nir galallata gargurej canqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yacunaycajcunatapis yacuta mana macyajchu canqui.","poem":1},{"lineBreak":true},{"text":"Yargaycajtapis mana garajchu canqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Munayniyoj rispitädu cashpayquimi","poem":1},{"lineBreak":true},{"text":"cay pachaga munaynillayquicho cashanta yarparayqui!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Biyüdacunata jinayllata gargurej canqui.","poem":1},{"lineBreak":true},{"text":"Wacchacunatana ñacachej canqui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chaypitami cananga ñacaycunallana tumapaycäshunqui.","poem":1},{"lineBreak":true},{"text":"Chaypitami fiyupa mancharishalla caycanqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gampäga llapanpis chacajlla captinmi imatapis mana ricanquichu.","poem":1},{"lineBreak":true},{"text":"Aypalla yacu shamur ñitejnömi gueshyaga ñitiycäshunqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Syëluchöga llapanpita mas altuchömi Tayta Dios caycan.","poem":1},{"lineBreak":true},{"text":"Mas janajcho caj goyllarcunapis chaquin ur'gallanchömi caycan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chayno caycaptin gamga ninqui: ‹¿Imanöpataj Tayta Dios musyanga?","poem":1},{"lineBreak":true},{"text":"Yanauyaycaj chacajpitaga ¿imanöpataj ricamonga?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Janaj syëlu asulyaraycajcho wac-läman cay-läman puriptin paytaga chacaj yana pucutaymi chaparaycan.","poem":1},{"lineBreak":true},{"text":"Chaynöpami mana ricamunchu› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«¿Gampis unay caj fiyu runacuna rurashanno","poem":1},{"lineBreak":true},{"text":"mana allita ruraytachu yarpaycanqui?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Paycunaga illajpitami wañuriran","poem":1},{"lineBreak":true},{"text":"mayu chayar imatapis apacushanno.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Paycunaga Tayta Diosta niran: ‹¡Ama rimapämaychu!","poem":1},{"lineBreak":true},{"text":"¿Imataraj nogacunapäga gam ruranquiman?› nir.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chauraga ¿Tayta Dioschuraj camacächiran chay runacuna rïcuyänanpaj?","poem":1},{"lineBreak":true},{"text":"¡Chayno cashantaga manami imanöpapis tantiyayta atipächu!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Alli runacunaga fiyu runacuna mana alliman chayajta ricar cushicun.","poem":1},{"lineBreak":true},{"text":"Juchaynajcunaga asipar nin:","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"‹Chiquimajninchïcunaga ushacashanami.","poem":1},{"lineBreak":true},{"text":"Ima-aycantapis ninami ushacurcusha.›","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Tayta Diosmanna yapay yäracuy.","poem":1},{"lineBreak":true},{"text":"Chauraga yapaymi ima-aycatapis tarichishunquipaj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Pay yachachishushayquita sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Llapan nishushayquita yarpayniquiman sumaj churacuy.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tayta Diosman yapay yäracuptiqui,","poem":1},{"lineBreak":true},{"text":"mana alli ruraycunata manana ruraptiqui,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"mas cuyayllapaj gori captinpis ñuchu allpatanölla,","poem":1},{"lineBreak":true},{"text":"mayucho caj rumicunatanölla ricaptiquega","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ima-aycapäpis munayniyoj Tayta Diosnami gampäga canga gorino,","poem":1},{"lineBreak":true},{"text":"aypalla guellayniquino.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Paymi cushicachishunquipaj.","poem":1},{"lineBreak":true},{"text":"Chauraga payllamannami yäracunquipäpis.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Imata mañacuptiquipis wiyashunquipaj.","poem":1},{"lineBreak":true},{"text":"Imatapis aunishayquita gampis cumlinquipaj.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ima ruraychöpis allichömi llojshinquipaj.","poem":1},{"lineBreak":true},{"text":"Llapan mana allicuna cashanpis pacha achicyacäcojnömi ricacongapaj.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Alli-tucojcunataga Tayta Dios manacajmanmi churan.","poem":1},{"lineBreak":true},{"text":"Umildicunatami ichanga alliman churan.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Mana allita mana rurasha captiquega","poem":1},{"lineBreak":true},{"text":"juchaynaj captiquega Tayta Dios salbashunquipämi.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}