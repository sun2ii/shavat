{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["Tayta Diospa ñaupancho Job chapacushan"]},{"type":"verse","number":1,"content":["Chayno niptin Job niran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Cananpis jagayashallami yapay rimashaj.","poem":1},{"lineBreak":true},{"text":"Tayta Dios castigamaptinmi llaquicuycä.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Musyaycöman Tayta Diosta maycho tariytapis,","poem":1},{"lineBreak":true},{"text":"chauraga tiyashan cajman imanöpapis chayaycöman!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayarga paytanami willapäman imapita cayno caycashätapis.","poem":1},{"lineBreak":true},{"text":"Yarpaynëchöpis aypallami caycan imata ninäpäpis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Pay imata nimashanta cutichinäpäpis tantiyämanmi!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Payga ¿munayniyoj caynintachuraj jorgapämanga?","poem":1},{"lineBreak":true},{"text":"Manami; chaypa ruquenga ima nishätapis wiyamanmanmi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pipis paywan parlanmanmi juchaynaj runaga.","poem":1},{"lineBreak":true},{"text":"Chaymi nogatapis ‹juchaynaj canqui› nimanman.","poem":1},{"lineBreak":true},{"text":"¡Imaycamapis librina canäpaj cachaycamanman!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ichanga washapa Diosta ashiptëpis manami canchu.","poem":1},{"lineBreak":true},{"text":"Cay-läpa ashirpis manami tarëchu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Norte caj-läpa imata ruraptin ashirpis manami ricächu.","poem":1},{"lineBreak":true},{"text":"Sur caj-läpa ticraycurpis manami ricächu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paymi ichanga musyaycan imano goyashätapis.","poem":1},{"lineBreak":true},{"text":"Juchäta ashiptinpis gori limyuyashanömi quëdashaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nogaga paypa yupillanpami purishcä.","poem":1},{"lineBreak":true},{"text":"Pay ricachimashan nänillapami aywashcäpis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Paypa laynincunallatami, rimashancunallatami cumlishcä.","poem":1},{"lineBreak":true},{"text":"Manami quiquë munashallätachu rurashcä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Tayta Diosga imatapis rurayta yarparga jinan örami rurarin.","poem":1},{"lineBreak":true},{"text":"Rurananpaj yarpaycashantaga manami pipis rucachinchu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Payga imatapis rurayta munashantami ruramanga.","poem":1},{"lineBreak":true},{"text":"Imata rurayta yarpashantapis llapantami camacächenga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaymi fiyupa manchacö.","poem":1},{"lineBreak":true},{"text":"Yarparcushpalläpis fiyupami mancharë.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ima-aycapäpis munayniyoj Tayta Diosmi","poem":1},{"lineBreak":true},{"text":"fiyupa manchariycächiman.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaypis chacayga manami upällachimangachu;","poem":1},{"lineBreak":true},{"text":"yanauyaycaj chacaypis manami pitucarcamangachu.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}