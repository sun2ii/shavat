{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"«Munayniyoj Tayta Diosga","poem":1},{"lineBreak":true},{"text":"¿imanirtaj mana willacunchu fiyu runacunata imay jusgananpaj cashantapis?","poem":1},{"lineBreak":true},{"text":"Diospa amïgun cajcunaga","poem":1},{"lineBreak":true},{"text":"¿imanirtaj mana musyanchu imay jusgananpaj cashantapis?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fiyu runacunaga chacrapa lindancunatapis witichin.","poem":1},{"lineBreak":true},{"text":"Uywancuna mas achca cananpaj uyshacunatapis suwacun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wacchapa bürruntapis guechun.","poem":1},{"lineBreak":true},{"text":"Biyüdapa buyintapis rinda charicurcun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pobricunataga nänicunapitapis gargun.","poem":1},{"lineBreak":true},{"text":"Chaymi umildicunaga pacacun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pobricunaga chunyaj chaqui jircacho cacoj chucaru uywanöpis","poem":1},{"lineBreak":true},{"text":"fiyupa ñacar-rämi micuytapis tarin.","poem":1},{"lineBreak":true},{"text":"Wamrancunapäpis fiyupa ñacar-rämi micuyta tarin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paycunaga aywan runapa chacrancunacho quëdaj rïguta shuntacoj.","poem":1},{"lineBreak":true},{"text":"Man'chäga aywan fiyu runacunapa chacranmanpis übas ashicoj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chacaycunaga puñurpis waran imawanpis mana pitucuyllapami,","poem":1},{"lineBreak":true},{"text":"imawanpis mana gatacuyllapa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tamyarga jircacunacho pasaypa jutuycajtami ruran.","poem":1},{"lineBreak":true},{"text":"Chaura llantucunanpaj machayta ashir gagacunaman lagaycachan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Fiyucunaga pobricunapa chuchuycaj wamrancunatapis guechun.","poem":1},{"lineBreak":true},{"text":"Chay guechushantana rinda chararan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pobricunaga galallanömi purinpis.","poem":1},{"lineBreak":true},{"text":"Rïguta ashtarcaycan yargaypita wañuycarmi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Asëtita gapchinanpaj jatusaj agacuna rumicunata tangan.","poem":1},{"lineBreak":true},{"text":"Übasta bïnupaj lluchcaycarpis yacunaypitaga wañurcaycanmi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Siudächöga wañuyta ñacaycajcuna gaparpaycan.","poem":1},{"lineBreak":true},{"text":"Nanaywan wagarcaycan.","poem":1},{"lineBreak":true},{"text":"Mañacuptinpis Tayta Diosga manami yanapanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Waquin runaga manami munanchu achicyaj pachata.","poem":1},{"lineBreak":true},{"text":"Chacajllacho cawacuytami munan.","poem":1},{"lineBreak":true},{"text":"Cawashancamapis manami ruranchu alli cajcunataga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Runata wañuchejcunaga chaca-chacallami purin pobricunata wañuchinanpaj.","poem":1},{"lineBreak":true},{"text":"Pacha chacarcuptinna suwaman ticran.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Majayoj caycar jucpa majanwan cacojcunaga pacha chacarcunallantami shuyaraycan.","poem":1},{"lineBreak":true},{"text":"Pacha chacarcuptenga cäranta sumaj chapacun","poem":1},{"lineBreak":true},{"text":"‹Caynötaga pipis manami rejsimangachu› nir yarpashpan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chacaypa suwaga wasicunaman yagacuycun.","poem":1},{"lineBreak":true},{"text":"Junajpaga jircacho pacarpäcun.","poem":1},{"lineBreak":true},{"text":"Manami munanchu achicyajta.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Paycunapäga junaj caycan fiyupa yanauyaycaj chacaymi.","poem":1},{"lineBreak":true},{"text":"Paycunaga munarcaycan chacaycho manchacuypaj cajcunallatami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Chay fiyu runacunaga yacu cörrejnömi illgacäcun.","poem":1},{"lineBreak":true},{"text":"Chacrancunapis maldisyunädumi ricacun.","poem":1},{"lineBreak":true},{"text":"Übas chacrancunachöpis pipis mananami arunnachu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fiyupa usyawanga rashtapis chullucäcunmi.","poem":1},{"lineBreak":true},{"text":"Chaynömi jucha rurajcunapis ushacan.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Paycunataga mamanpis gongayconganami.","poem":1},{"lineBreak":true},{"text":"Curucunanami micur ushacurconga.","poem":1},{"lineBreak":true},{"text":"Pipis mananami yarpanganachu chay runataga.","poem":1},{"lineBreak":true},{"text":"Gueruta wayra sajtarishannömi ushacanga.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chay runacunaga amatar fiyumi casha wawata mana tarej warmicunapaj, biyüdacunapäpis.","poem":1},{"lineBreak":true},{"text":"Manami imaypis yanapashachu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tayta Diosmi ichanga munayniyojcunatapis mana alliman chayarachin.","poem":1},{"lineBreak":true},{"text":"Chaynöpami paycunaga imaycama cawanantapis mana musyanchu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Shongun yarpashanno runa goyäcunanpämi Tayta Diosga camacächin.","poem":1},{"lineBreak":true},{"text":"Chaypis ricapaycanmi imata rurashallantapis.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Fiyucuna rätullaga alli cawaymanmi chayan.","poem":1},{"lineBreak":true},{"text":"Chaypita ichanga illaraycannami.","poem":1},{"lineBreak":true},{"text":"Chaycunaga ruracäcun jachata achurisha wañutacäcojnömi.","poem":1},{"lineBreak":true},{"text":"Rïgupa ispïjan paquicäcojnömi ruracäcun.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"¿Chaynöchu, manachu?","poem":1},{"lineBreak":true},{"text":"¿Piraj ‹llullacuycanquimi› nir","poem":1},{"lineBreak":true},{"text":"nishäcunata mana bälichengachu?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}