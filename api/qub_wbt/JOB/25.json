1},{"lineBreak":true},{"text":"Pay limyu cashanmanga goyllar limyu cashanpis manami tincunchu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Piyur-rächari ¡runa aycha curunölla caycarga!","poem":1},{"lineBreak":true},{"text":"¡Runa cuycanölla caycarga!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}