"lineBreak":true},{"text":"Cawaycar quëdajcunapis wañonga fiyu gueshyawanmi.","poem":1},{"lineBreak":true},{"text":"Biyüdancunapis manami wagangachu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fiyu runacuna guellayta allpatano aypallata shuntashantapis,","poem":1},{"lineBreak":true},{"text":"aypalla röpacunata charashantapis,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"alli runami chay röpancunata jaticonga.","poem":1},{"lineBreak":true},{"text":"Chay guellay shuntashantapis limyu runami rubichanga.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fiyu runapa wasenga äbipa gueshtanno alayrillami,","poem":1},{"lineBreak":true},{"text":"chacracho täpana chucllanöllami.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fiyu runa rïcu caycashpan puñucuyconga.","poem":1},{"lineBreak":true},{"text":"Riccharcamuptenga manami imanpis canganachu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Junajpaga fiyupa mancharengapaj.","poem":1},{"lineBreak":true},{"text":"Chacaypaga fiyu löcu wayrami apacongapaj.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Inti yagamunan cajpita fiyu löcu wayra chayamushpanmi","poem":1},{"lineBreak":true},{"text":"wasinpita jorgurir apaconga.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Imanöpa pacacuyta munaycaptinpis","poem":1},{"lineBreak":true},{"text":"mana cuyapaypami chay runaman wayra chayanga.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Chay wayraga fiyupa gaparashpan shucar-rämi gaticachanga.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}