{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"heading","content":["Yachayta alabashan"]},{"type":"verse","number":1,"content":[{"text":"«Rejsisha jircachömi caycan guellay mïnaga.","poem":1},{"lineBreak":true},{"text":"Chayno rejsisha partichömi caycan gorita acranapäpis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Allpa rurinpitami fyërrutaga jorgunchi.","poem":1},{"lineBreak":true},{"text":"Rumicunata chulluchishami cubri acracan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Runaga pacha rurin chacajmanpis yaycunmi.","poem":1},{"lineBreak":true},{"text":"Chayno yaycurmi pacha rurin may-may rurimanpis chayan.","poem":1},{"lineBreak":true},{"text":"Chaychönami yanauyaycaj chacaycho rumicunata ashin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pipis mana purinan jircacho,","poem":1},{"lineBreak":true},{"text":"siudäcunapitaga caruchömi mïnataga uchcun.","poem":1},{"lineBreak":true},{"text":"Chaychönami wac-läman cay-läman caylintaycar wascawan warcuyllapa yaycun uchcunanpaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cay pachachöga chacracuna micuyta wayuchin.","poem":1},{"lineBreak":true},{"text":"Rurinpanami ichanga caycan nina ushashano uchcu-uchcu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chay rurichömi tarinchi cuestaj zafiro jutiyoj rumita,","poem":1},{"lineBreak":true},{"text":"goritapis allpawan tacucashata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chay uchcucunataga imaypis manami ricashachu","poem":1},{"lineBreak":true},{"text":"wamäshupis ni ima ancacunapis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaymanga manami chayannachu aycha micoj jirca animalcunapis.","poem":1},{"lineBreak":true},{"text":"Ni liyuncunapis chaychöga manami purinnachu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Runaga gagacunachömi ojtin.","poem":1},{"lineBreak":true},{"text":"Niycällarmi puntacunatapis sapipita juchuchin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gagacunacho ruran mïna uchcucunata.","poem":1},{"lineBreak":true},{"text":"Chaychöna tarin tucuy-niraj achca casta cuestajcunata.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chayno ojtiycällarmi tarin mayu yuriycashantapis.","poem":1},{"lineBreak":true},{"text":"Mana pipis ricashantami jorgamun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Ichanga ¿maychötaj tarinchi yachayta?","poem":1},{"lineBreak":true},{"text":"¿Maychötaj caycan tantiyay?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Runaga manami musyanchu chaycuna alli cashantapis.","poem":1},{"lineBreak":true},{"text":"Cay pachachöga manami tarinpischu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"May-may jatun lamarpis ‹caychöga manami canchu› ninmi.","poem":1},{"lineBreak":true},{"text":"Ruri yanauyaycaj lamarpis ‹nogachöga manami canchu› ninmi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaytaga goriwanpis manami rucanchïchu.","poem":1},{"lineBreak":true},{"text":"Ni guellaywanpis manami rantinchïchu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fiyupa mas alli caj goriwanpis manami pägashwanchu.","poem":1},{"lineBreak":true},{"text":"Manami pägashwanchu ni ‹cornalina› ni ‹zafiro› cuyayllapaj rumicunawanpis.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yachayga goripitapis, achicyaj gueshpipitapis masmi cuestan.","poem":1},{"lineBreak":true},{"text":"Chaytaga manami rucashwanchu gori aläjacunawanpis.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yachayga lamarpita jorgushan ‹coral› jutiyojpitapis mas cuyayllapämi.","poem":1},{"lineBreak":true},{"text":"Achicyaj gueshpicunapitapis perlascunapitapis mas cuyayllapämi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yachaywan tincuchishaga Etiopiacho caj ‹crisólito› cuyayllapaj chanin cuestaj rumipis manami tincunchu.","poem":1},{"lineBreak":true},{"text":"Manami rantishwanchu mas allinnin caj goriwanpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Chaura ¿maychötaj tarinchi yachayta?","poem":1},{"lineBreak":true},{"text":"¿Maychötaj caycan tantiyay?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Llapan cawajcuna mana ricananchömi pacaraycan.","poem":1},{"lineBreak":true},{"text":"Päriypa purejcuna mana ricananchömi chaparaycan.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Infiernupis wañuypis ninmi:","poem":1},{"lineBreak":true},{"text":"‹Chaycunapäga wiyayllami wiyashcä parlajta› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«Diosmi ichanga musyan yachay maycho caycashantapis.","poem":1},{"lineBreak":true},{"text":"Payllami musyan maycho tariytapis.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Payga ricaycanmi allpapa cuchuncamapis.","poem":1},{"lineBreak":true},{"text":"Chayno payga ushajpämi ricaycan syëlupita uraman cajtaga.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tayta Diosmi wayrapa callpantapis gosha.","poem":1},{"lineBreak":true},{"text":"Yacutapis nisha maycamalla chayananpäpis.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Paymi nisha imay tamyapa timpun cananpäpis;","poem":1},{"lineBreak":true},{"text":"räyucuna, illguycuna imay wichan cananpäpis.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Chay örami yachaytapis chaycho ricaran.","poem":1},{"lineBreak":true},{"text":"Imano cashantapis musyaycur ricaycur ‹alli› niran.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nircur runacunata Tayta Dios niran:","poem":1},{"lineBreak":true},{"text":"‹Yachaj runaga Nogallatami rispitaman.","poem":1},{"lineBreak":true},{"text":"Mana allita rurananpitaga manchapacuypami cawan.› »","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}