{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"heading","content":["Unay imano goyashantapis Job rimashan"]},{"type":"verse","number":1,"content":["Job yapay niran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«¡Imanöparaj cutiycöman unay cashä wichanman!","poem":1},{"lineBreak":true},{"text":"Chay wichanmi ima-aycapitapis Tayta Dios chapämaran.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pay achquinwan achquipämaptinmi","poem":1},{"lineBreak":true},{"text":"chacaypapis alli purej cä.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Noga alli timpullächöraj caycashä wichan alli yanapämaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Diosmi yan'gaycämaran.","poem":1},{"lineBreak":true},{"text":"Wamräcunapis täparaycämaran.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chay wichanga lëchipis pampantin yacunöraj caran.","poem":1},{"lineBreak":true},{"text":"Asëtipis gagacunapita quiquillanmi llojshicamoj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Nogaga simri jamaraj cä siudächo mayur runacuna shuntacar jamarajcunawanmi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mösucunapis ñaupancho captëga päsanäpaj witicoj.","poem":1},{"lineBreak":true},{"text":"Auquincunapis rispitamashpan ichicoj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mas rispitädu runacunapis parlaycashanpita upällacaycärej.","poem":1},{"lineBreak":true},{"text":"Maquinwan shiminta chapacarcärej.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mandajcunapis rimaycashanpita jinan öra upällacaycärej.","poem":1},{"lineBreak":true},{"text":"Galluncuna palacarninman lagacäcojno ricacoj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Runacunaga ricamarpis wiyamarpis","poem":1},{"lineBreak":true},{"text":"nogapaj allitami parlaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaynöga parlaj wacchacunata, pobricunata,","poem":1},{"lineBreak":true},{"text":"pipis mana yanapashan runacunata yanapanyaptëmi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fiyupa muchupacaj runacuna agradësicamaj.","poem":1},{"lineBreak":true},{"text":"Yanapaptë biyüdacunapis fiyupa cushicoj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nogaga pitapis mana suwapaypami, allita ruraj cä.","poem":1},{"lineBreak":true},{"text":"Chayno alli ruraynëga röpata jatirajnöpis waran-waran ruranämi caran.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Nogaga gapracunapäpis ñawinnömi caj cä.","poem":1},{"lineBreak":true},{"text":"Paquicushacunapäpis chaquinnömi caj cä.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pishëpacojcunapäga papäninnömi caj cä.","poem":1},{"lineBreak":true},{"text":"Juc-lä runacunata washaj cä!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fiyu runacunapa munayninta ushacächej cä.","poem":1},{"lineBreak":true},{"text":"Imata suwaycashancunatapis guechoj cä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Nogaga yarparaj cä: ‹Nogaga pasaypa auquinyayllaparämi wasillächo wañushaj.","poem":1},{"lineBreak":true},{"text":"Yupaytapis mana atipaypaj achca watami cawashaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nogaga caycä yacu ñaupancho yöra caycajnömi.","poem":1},{"lineBreak":true},{"text":"Chay yörapa rämanga shullaypashami warämun.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nogata rispitamaptin allimi cawashaj.","poem":1},{"lineBreak":true},{"text":"Chayno, callpäpis manami ushacangachu› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Llapanmi wiyamaj.","poem":1},{"lineBreak":true},{"text":"Shuyarpaycaj willapar tantiyachinäpaj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Noga parlayta usharcuptëga manami pipis ‹llutanmi› nimajchu.","poem":1},{"lineBreak":true},{"text":"Paycunamanga parlashä chayaj yacunaycaptin tamya shiminman chayajnömi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Paycunanami yarpayninman sumaj churacushpan wiyacoj.","poem":1},{"lineBreak":true},{"text":"Chaura paycunapäga caj murupacuy wichan tamyanömi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Paycunapa ñaupancho asinaptëga paycuna cushicoj.","poem":1},{"lineBreak":true},{"text":"Mana cachaypami cushisha caycashäta ricaparcaycämaj.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nogami paycunapaga mandajnin caycarä.","poem":1},{"lineBreak":true},{"text":"Chaymi paycunata tantiyachej cä imano goyänanpäpis.","poem":1},{"lineBreak":true},{"text":"Nogaga caycarä juc ray","poem":1},{"lineBreak":true},{"text":"aypalla röpa suldäruncunapa ñaupancho caycajno.","poem":1},{"lineBreak":true},{"text":"Paycuna llaquisha caycajta shacyächej cä.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}