{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["Yurishan junajpaj Job pësacushan"]},{"type":"verse","number":1,"content":["Upällalla caycashanpita Jobga rimayta gallaycuran. Chayno rimarmi yurishan junajpaj pësacuran."]},{"type":"verse","number":2,"content":["Pay niran:"]},{"type":"verse","number":3,"content":[{"text":"«¡Imapäraj yuriräpis!","poem":1},{"lineBreak":true},{"text":"‹Ollgu wamrami yurisha› nishan chacaypis ¡imapäraj caran!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Imanöparaj chay junaj yanauyaycaj chacayman ricacunman caran!","poem":1},{"lineBreak":true},{"text":"¡Chay chacaytaga Tayta Dios ama yupanmanpischu caran!","poem":1},{"lineBreak":true},{"text":"¡Chay öraga pachapis ama waranmanchu caran!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Chay öraga imanöparaj fiyupa yanauyayparaj chacacurcunman caran!","poem":1},{"lineBreak":true},{"text":"¡Man'chäga yana pucutay chapacurcunman caran;","poem":1},{"lineBreak":true},{"text":"man'chäga inti wañuptin llapan mancharinman caran!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Chay chacayga chacaylla cacunman caran!","poem":1},{"lineBreak":true},{"text":"¡Chaura chay junäga illganmanmi caran","poem":1},{"lineBreak":true},{"text":"quillamanpis watamanpis manana yupananpaj!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Chay chacayga ama imapis yurinmanchu caran!","poem":1},{"lineBreak":true},{"text":"¡Iti yuriptin ama cushicunmanpischu caran!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Waräcuy Leviatanta","poem":1},{"noteId":0},{"text":"munaynincho chararaycaj brüjucuna","poem":1},{"lineBreak":true},{"text":"maldisyunta goycunman caran chay junajta!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Chay tutaga warajpis ama yagamunmanchu caran!","poem":1},{"lineBreak":true},{"text":"¡Pachapis ama waranmanchu caran!","poem":1},{"lineBreak":true},{"text":"¡Pachapis ama yur'gämunmanchu caran!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Chayno ruracäcunman caran fiyupa cayno noga ñacanäpaj chay chacay yurishäpita!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«¡Imanir-raj mana wañucurächu mamäpa pachallancho,","poem":1},{"lineBreak":true},{"text":"man'chäga yurircushä öralla!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nogataraj margaycämaranpis.","poem":1},{"lineBreak":true},{"text":"Nogataraj chuchuycämaranpis.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chay öra wañucushpäga canan cushishami caycäman caran.","poem":1},{"lineBreak":true},{"text":"Jaucami jitaräcöman caran","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"jatusaj wasicunata rurachicoj raycunawan mandäshejnincunawan,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"guellayta goritapis palasyunman juntachicoj mandajcunawan iwal.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Imanir-raj mana pampaycamaranchu shullutano,","poem":1},{"lineBreak":true},{"text":"mamanpa pachallanchöraj wañoj wamracunatano!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wañorga fiyu runacunapis","poem":1},{"lineBreak":true},{"text":"jamaycärinmi mana alli rurayninpita;","poem":1},{"lineBreak":true},{"text":"fiyupa uticashacunapis jamacunnami.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Prësucunapis chayman chayarga jamacunnami.","poem":1},{"lineBreak":true},{"text":"Capuralnincuna ollgöpashantapis manami wiyannachu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chaychöga jatunpis tacshapis iwalmi carcaycan.","poem":1},{"lineBreak":true},{"text":"Chaychöga uywaycunapis manami patrunpa munayninchönachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Ñacaycajtaga ¿imanirtaj Tayta Dios achicyaj pachata ricachin?","poem":1},{"lineBreak":true},{"text":"¿Imapänaraj cawachin pasaypa llaquisha caycajtaga?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Paycunamanga wañuypis manami chayanchu","poem":1},{"lineBreak":true},{"text":"pamparaycaj guellayta ashejno wañuyta ashiptinpis.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chay runapäga cushicuy cangapaj","poem":1},{"lineBreak":true},{"text":"imay junajpis sepultüraman chayaptinrämi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"¿Imapänataj Tayta Diospis cawachin mayman aywaytapis mana musyaj runataga?","poem":1},{"lineBreak":true},{"text":"Imata rurayta munaptinpis manami camacächinchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Llaquicuyllämi micuynënöpis;","poem":1},{"lineBreak":true},{"text":"gaparashäpis aypalla yacu aywajnörämi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Llapanta manchacushäpitapis","poem":1},{"lineBreak":true},{"text":"mas manchacushä cajmi chayamasha.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nogapäga mananami cannachu jamay ni jauca goyaypis.","poem":1},{"lineBreak":true},{"text":"Alli goyaycho canäpa ruquenga llaquicuyllachönami caycä.»","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Leviatanpäga yarpaj lamarcho tiyaj jatuncaray animal cashantami. Waquin yarpaj lagarto animalno cashantami. Ricay Job 41.1; Sal. 74.14; 104.26; Isa. 27.1.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/qub_wbt/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}