{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"heading","content":["Ñacaycashanpita Job llaquicushan"]},{"type":"verse","number":1,"content":[{"text":"«Canan noga cayno caycajta ricamar ichanga shullcä cajcunapis asipäman.","poem":1},{"lineBreak":true},{"text":"Paycunapa papänincunata nogaga manami munämanchu caran uywäcunata täpaj allgucunawan purinallanpäpis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Paycunataga ¿imapäräshi munäman caran?","poem":1},{"lineBreak":true},{"text":"Paycunapaga callpanpis mananami carannachu","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"manchariypaj yargay captin, muchuywan pishipacaptin.","poem":1},{"lineBreak":true},{"text":"Chunyaj chaqui jircacunachömi chacaypa jajchej chaquisha sapicunallata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ashgaj jachacunata shatacunacho ashej.","poem":1},{"lineBreak":true},{"text":"Asta retämapa sapincunatapis micoj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paycunataga marca-masincunapis jitarishami caran.","poem":1},{"lineBreak":true},{"text":"Paycunataga suwacunata gaticachajnöraj gayanacushpan gaticachaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaymi paycunaga tiyaj machaycunallacho,","poem":1},{"lineBreak":true},{"text":"ragra uchcucunallacho,","poem":1},{"lineBreak":true},{"text":"gaga uchcuncunallacho.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Shira rurincunacho wagaj.","poem":1},{"lineBreak":true},{"text":"Shata rurincunallacho goturpaycaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Paycunaga caran imatapis mana yachaj, mamaynaj taytaynaj.","poem":1},{"lineBreak":true},{"text":"Nasyunnincho tiyananpis mana camacaranchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Cananmi ichanga paycuna asipäman.","poem":1},{"lineBreak":true},{"text":"Asipämänan cashami jutëtapis parlan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fiyupa melanäcamashpanmi nogapita witicun.","poem":1},{"lineBreak":true},{"text":"Cärämanpis togapämanraj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Cananga, Tayta Diosmi ima-aycäpis manana cananpaj camacächisha.","poem":1},{"lineBreak":true},{"text":"Pengay-tucushami caycä.","poem":1},{"lineBreak":true},{"text":"Chaymi imanillarpis mana rispitamannachu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ñaupämanmi juc röpa runacuna shuntacämun.","poem":1},{"lineBreak":true},{"text":"Nircur wañuchimayta yarpashpan sajtaman, magaman.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Caminötapis chapacarcärin.","poem":1},{"lineBreak":true},{"text":"Manami pipis canchu nogata yanapämänanpäga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pergaraycaj curralpa uchcun caycajpa","poem":1},{"lineBreak":true},{"text":"yaycojnörämi nogamanga gaparpashpan shamun.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fiyupa mancharishami ricacushcä.","poem":1},{"lineBreak":true},{"text":"Rispitamashanpis cananga wayranömi illaraycan.","poem":1},{"lineBreak":true},{"text":"Alli ricasha cashäpis pucutaynömi illgacäcusha.","poem":1},{"lineBreak":true},{"text":"Ima-ayca charashäpis pucutayno illgacäcusha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Cananga wañuypis janächönami.","poem":1},{"lineBreak":true},{"text":"Nogaga fiyupa llaquicullarnami caycä.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tullöcamarämi nanaynëpis chayaycäman.","poem":1},{"lineBreak":true},{"text":"Mana chawaypami chacaycunapapis nanaycäman.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Cuncäpita apritamajnömi aptacarcaman.","poem":1},{"lineBreak":true},{"text":"Jämayta cachanätapis manami dëjamannachu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nogataga mitumanmi jitarimasha","poem":1},{"lineBreak":true},{"text":"uchpata-jina, ñuchu allpata-jina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Tayta Dios, gamtami mañacaycämö yanapämänayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaypis manami yanapämanquichu.","poem":1},{"lineBreak":true},{"text":"Gamta ruwacaycämö.","poem":1},{"lineBreak":true},{"text":"Chaypis manami cäsumanquichu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nogataga fiyupami chiquicarcamashcanqui.","poem":1},{"lineBreak":true},{"text":"Fiyupa rabyashami gaticachaycämanqui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gammi camacächishcanqui wayra apamänanpaj,","poem":1},{"lineBreak":true},{"text":"löcu wayra tapsir-ushamänanpäpis.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Musyaycänami wañuchiyta munaycämashayquitaga.","poem":1},{"lineBreak":true},{"text":"Musyaycämi wañojcuna caycashanman chayachimänayquitaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Nogami ichantaga pishëpacojtapis yanapashcä.","poem":1},{"lineBreak":true},{"text":"Fiyupa llaquicuycho caycajtapis salbashcä.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nogaga ñacajcunata ricaycur cuyapar wagaj cä.","poem":1},{"lineBreak":true},{"text":"Nogaga muchupacajcunatapis cuyapaj cä.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nogaga cushisha goyaytami yarparä.","poem":1},{"lineBreak":true},{"text":"Nishäga chayamasha llaquicuymi.","poem":1},{"lineBreak":true},{"text":"Achquita shuyaraycarä.","poem":1},{"lineBreak":true},{"text":"Nishäga chacayllami caycan.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Shongöga fiyupami ushaycan.","poem":1},{"lineBreak":true},{"text":"Nogaga fiyupa llaquicuyllachömi caycäpis.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Goyaycäpis fiyupa llaquishallami, intiman mana llojshejnölla.","poem":1},{"lineBreak":true},{"text":"Täparaycämajcunapa ñaupanchömi mañacö pillapis yanapaycamänanpaj.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Atojcunapa wauguinnömi,","poem":1},{"lineBreak":true},{"text":"tucupa amïgunnömi caycä.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Llapan garämi yanayacäcusha. Pasaypa wagruypa-wagrur aywaycan.","poem":1},{"lineBreak":true},{"text":"Rupaywanmi intëru cuerpöpis rupariycan.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Arpä wagashanpis llaquicuyllapämi.","poem":1},{"lineBreak":true},{"text":"Pincullöpis llaquicuyllapämi wagan.","poem":1}]}]