{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":31,"content":[{"type":"heading","content":["Alli runa cashanta Job rimashan"]},{"type":"verse","number":1,"content":[{"text":"«Nogaga shongöcho yarparä","poem":1},{"lineBreak":true},{"text":"japalla jipashtapis mana munapänäpaj mana ricapänäpaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nogaga musyämi munayniyoj Tayta Dios janaj syëlupita-pacha","poem":1},{"lineBreak":true},{"text":"cada runata imata rurashallanpitapis gonanpaj cashanta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fiyu runacunatami disigrasya chayan.","poem":1},{"lineBreak":true},{"text":"Juchasapacunatami mana alli goyay chayan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tayta Diosga ricaycanmi noga rurashäta;","poem":1},{"lineBreak":true},{"text":"ricaycämanmi imanölla goyashätapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«¿Llutantachuraj rurashcä?","poem":1},{"lineBreak":true},{"text":"¿Pitapis llullapayta yarpashcächuraj?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mä alli caj balansawan Tayta Dios pësamächun.","poem":1},{"lineBreak":true},{"text":"Chayrämi musyanga juchaynaj cashäta.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alli cajta ruraycashäpita mana allita rurasha captëga,","poem":1},{"lineBreak":true},{"text":"pipa imantapis munapasha captëga,","poem":1},{"lineBreak":true},{"text":"jucpa imanpis nogapa maquëcho taricasha captenga","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"murushäcunatapis juccunana micuchun.","poem":1},{"lineBreak":true},{"text":"Lantashätapis sapipita achurichun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Pï warmiwanpis cacuyta camasha captëga,","poem":1},{"lineBreak":true},{"text":"runapa warminta watgasha captëga,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"warmëpis jucpa warmin cachun,","poem":1},{"lineBreak":true},{"text":"jäpa runacunapis paywan cacuchun.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chayno rurasha captëmi ichanga jamurpaypaj canman.","poem":1},{"lineBreak":true},{"text":"Chauraga castigashami cäman.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chayno rurasha captëga canman nina rupar ushacurcushanömi.","poem":1},{"lineBreak":true},{"text":"Llapan charashätami illgarachinman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Warmi ollgu uywaynëcuna ruwacamashanta mana aunisha carga","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¿imataraj ruräman Tayta Diospa ñaupacho?","poem":1},{"lineBreak":true},{"text":"Imata rurashäpitapis jusgamaptenga ¿imataraj nëman?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Diosllami ruramashcanchi mamanchïpa pachancho.","poem":1},{"lineBreak":true},{"text":"Payllami cawachisha uywaycunatapis, nogatapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Pobri pishipacajcunata yanapaytaga imaypis manami dëjashcächu.","poem":1},{"lineBreak":true},{"text":"Manami dëjashcächu biyüdacuna yargaypita canantapis.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Manami imatapis quiquilläga micojchu cä.","poem":1},{"lineBreak":true},{"text":"Wacchacunatapis yawachejmi cä.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wacchacunapaga papäninnömi cashcä.","poem":1},{"lineBreak":true},{"text":"Biyüdacunataga imallawanpis yanapashcämi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pipapis röpan mana captin gasaywan wañuycajta ricar,","poem":1},{"lineBreak":true},{"text":"juc pobri imawan pitucunanpäpis mana cajta ricar,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"uyshäcunapa millwanwanmi goñönanpaj pitucachej cä.","poem":1},{"lineBreak":true},{"text":"Chayno ruraptë chay runaga fiyupa cushicushpan ‹grasyas› nimaj.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Pobripa contranga manami imaypis maquëta jogarishcächu","poem":1},{"lineBreak":true},{"text":"‹autoridäcunami charimanga› nir yarpashpä.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chayno mana rasunpa rurasha captëga","poem":1},{"lineBreak":true},{"text":"ricräpis paquicäcuchun,","poem":1},{"lineBreak":true},{"text":"matancäpita rachir shicwacuchun.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nogaga Dios castigamänanta manchacojmi cä.","poem":1},{"lineBreak":true},{"text":"¡Munayniyoj Tayta Diospa ñaupancho manami puydëmanchu imanöpa chapacuytapis!","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Gorillamanga manami yäracushcächu.","poem":1},{"lineBreak":true},{"text":"Ni yarparashcäpischu chayllamanga.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Manami cushicushcächu ima-aycäpis aypalla captin","poem":1},{"lineBreak":true},{"text":"ni aypalla guellay captinpis.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Inti shanshaypa shanshar achicyaptin ricärir rispitasha captëga,","poem":1},{"lineBreak":true},{"text":"quillatapis achicyaycajta almirasha ricapasha captëga,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"pacayllapapis adurasha captëga,","poem":1},{"lineBreak":true},{"text":"quillata ricar maquillätapis muchasha captëga","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"castigasha canäpis camacanmanmi.","poem":1},{"lineBreak":true},{"text":"¡Chayno rurarga syëlucho caycaj Tayta Diosta manacajmanmi churäman caran!","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«Chiquimajnëcuna mana alliman chayaptin manami cushipashcächu.","poem":1},{"lineBreak":true},{"text":"Chayno manami cushipashcächu disigrasya chayaptinpis.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"‹Chay runa wañunman› nillarpis","poem":1},{"lineBreak":true},{"text":"manami imaypis juchata rimashcächu.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Wasëcho cajcunapis","poem":1},{"lineBreak":true},{"text":"llapanmi micusha upusha goyaj.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Jäpa runataga noga manami cällicho puñucunanta dëjajchu cä.","poem":1},{"lineBreak":true},{"text":"Caminanti purejcunataga imaypis pachächejmi cä.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Adannöga juchäta manami imaypis pacashcächu.","poem":1},{"lineBreak":true},{"text":"Mana allita rurashäcunatapis manami amucurcushcächu","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"runacunata manchacuypitaga.","poem":1},{"lineBreak":true},{"text":"Manami imaypis wasi wichgacusha upällalla cacushcächu","poem":1},{"lineBreak":true},{"text":"famillyäcuna jamurpamänanta manchacushpäga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"«¡Pillapis wiyaycamächun!","poem":1},{"lineBreak":true},{"text":"Cay firmämi llapan nishäta willacuycan.","poem":1},{"lineBreak":true},{"text":"Cananga munayniyoj Tayta Dios nimächun.","poem":1},{"lineBreak":true},{"text":"Imapitapis jagachamarga papilman isquirbishata ricachimächun.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Chaytaga cushisha rispitarmi chasquishaj.","poem":1},{"lineBreak":true},{"text":"Corönatanömi charäshaj.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Nogaga ima rurashäcunatapis Tayta Diostaga llapantami willashaj.","poem":1},{"lineBreak":true},{"text":"Paypa ñaupanmanga alli mandajnömi chayashaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"«Nogapita jagayar chacräcunapis manami syëluman gayacunchu.","poem":1},{"lineBreak":true},{"text":"Chacrächo camilluncunapis manami llaquicuywan waganchu.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Pipatapis micuynincunata suwapasha captë,","poem":1},{"lineBreak":true},{"text":"arupacoj runacunata dibaldilla aruchisha captëga,","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"chacräcunachöpis rïgu wayunanpa ruquin cashacunallana wiñamuchun;","poem":1},{"lineBreak":true},{"text":"sebäda wayunanpa ruquinpis mana alli jachacunallana wiñamuchun.»","poem":1},{"lineBreak":true},"Chaynömi Jobga chapacushpan parlayta usharan."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}