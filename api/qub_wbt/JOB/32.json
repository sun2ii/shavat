{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"heading","content":["Elihú parlashan"]},{"type":"verse","number":1,"content":["Chay quimsaj runacuna Jobwan rimanacuycashanpita upällacaycäriran Job yaparir-yaparir «juchaynaj cä» niptin."]},{"type":"verse","number":2,"content":["Chauraga Ram famillyapita mirar aywaj Buz parti runa Baraquelpa wamran Elihú, Jobpaj rabyacurcuran «juchaynaj caycaptë Dios castigaycäman» nejta wiyashpan."]},{"type":"verse","number":3,"content":["Jobpa quimsa amïguncunapäpis rabyacurcuran imanöpapis mana cutichiyta camäpacur Tayta Diosta manacajman churashanpita."]},{"type":"verse","number":4,"content":["Elihüga caran paycunapita mas mösullaraj. Chaymi shuyaraycaran quimsanraj Jobwan parlayta ushananta."]},{"type":"verse","number":5,"content":["Wiyashpanmi payga musyaran waquin cajcunaga Jobta imanöpa cutichiytapis manana camäpacushanta. Chaymi fiyupa rabyacurcur"]},{"type":"verse","number":6,"content":["rimayta gallaycuran.",{"text":"«Ricamashayquinöpis, nogaga cä mösullarämi,","poem":1},{"lineBreak":true},{"text":"gamcunami ichanga canqui mas auquinna.","poem":1},{"lineBreak":true},{"text":"Chaymi yarpaycashäta rimaytapis mana camäpacushcächu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yarparä: ‹Mayur cajcuna parlachun musyashanta.","poem":1},{"lineBreak":true},{"text":"Achca watana yachaj cashancunata mä nichun› nir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ichanga Tayta Diospa Espiritunmi runataga yarpayniyoj cananpaj yanapan.","poem":1},{"lineBreak":true},{"text":"Munayniyoj Tayta Diosmi pücashpan yanapan tantiyaj cananpaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Achca watayoj cashanga pitapis manami yachajyächinchu.","poem":1},{"lineBreak":true},{"text":"Ni auquin cashanchïpis manami tantiyachimanchïchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Chaymi cananga nogatapis wiyarcallämay.","poem":1},{"lineBreak":true},{"text":"Nogapis mä imallatapis parlarcamushaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nogaga upällallami wiyaräcushcä.","poem":1},{"lineBreak":true},{"text":"Chaymi gamcuna imano parlashayquitapis wiyashcä.","poem":1},{"lineBreak":true},{"text":"Imano parlanayquipaj yarpachacojtapis tantiyashcä.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaynöpis wiyashcämi mayganiquipis","poem":1},{"lineBreak":true},{"text":"Job parlashanta allitaga mana cutichishayquita.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gamcuna nirgunquiman ‹Yachashallanchïtaga nishcanchïnami.","poem":1},{"lineBreak":true},{"text":"Cananga Diosllanami cutichenga.","poem":1},{"lineBreak":true},{"text":"Manami runachu cutichenga.›","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jobpis nogataga manami imatapis nimashachu.","poem":1},{"lineBreak":true},{"text":"Nogapis manami gamcuna nishayquinöllaga Jobta nishächu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Paycunaga äyaraycarmi quëdasha.","poem":1},{"lineBreak":true},{"text":"Manami tarishachu imano cutichishunayquipäpis.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gam ama yarpaychu paycuna upälla cacushanno","poem":1},{"lineBreak":true},{"text":"nogapis upälla cacunätaga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ninäpaj caycashantaga nogapis nishayquimi.","poem":1},{"lineBreak":true},{"text":"Imata ninäpäpis yarpaycashäta nogapis nishayquimi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rimanäpäga aypallami caycan.","poem":1},{"lineBreak":true},{"text":"Mananami upällallaga cacömannachu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Rimar pashtapacunäpänami caycä.","poem":1},{"lineBreak":true},{"text":"Mushoj ordiman bïnuta wiñarpusha pogur rachiriyta munaycashannönami caycä.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Parlarcuptërämi shongöpis achicyärenga.","poem":1},{"lineBreak":true},{"text":"Gamtaga imanöpapis cutichishayquirämi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Manami mayganiquipapis faburniqui cashächu.","poem":1},{"lineBreak":true},{"text":"Llapaniquipäpis iwalmi parlashaj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nogaga pipäpis manami faburnin parlächu.","poem":1},{"lineBreak":true},{"text":"¡Chayno parlaptëga Camamajninchi Tayta Diosmi jinan öra castigamanman!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}