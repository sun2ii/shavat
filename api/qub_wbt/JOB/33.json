xt":"Chacaypapis ricapacachimanchi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Diosga runacunapa rinrillanchömi willapan.","poem":1},{"lineBreak":true},{"text":"Piñacun. Mancharachin.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaynöga ruran mana allita ruraycashanta cachaycunanpaj,","poem":1},{"lineBreak":true},{"text":"manana alli-tucoj cananpaj.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chaynöpami timpullancho caycällar wañunanpita salban.","poem":1},{"lineBreak":true},{"text":"Mala-muertipa wañunanpitapis salban.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aybësi Diosga runacunata piñacun gueshyacunawan gueshyachir,","poem":1},{"lineBreak":true},{"text":"intëru cuerpuncunata nanächir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chauraga mas allinnin mishquej micuycunapis","poem":1},{"lineBreak":true},{"text":"mana micuypänönami ricacun.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gueshyaptin aychancunapis ismur shicwan.","poem":1},{"lineBreak":true},{"text":"Chaura tulluncunapis alayrina ricacan.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Quiquinpis sepultüramanna watgaraycan;","poem":1},{"lineBreak":true},{"text":"wañuypis jananchöna caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«Ichanga chay runapa ñaupancho juc anjil caycashpan,","poem":1},{"lineBreak":true},{"text":"warangapita jucnayllapis paypa faburnin car","poem":1},{"lineBreak":true},{"text":"alli ruraj cashanta rimarcuptin,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"chay anjil cuyapashpan","poem":1},{"lineBreak":true},{"text":"‹Wañunanpita salbaycuy.","poem":1},{"lineBreak":true},{"text":"Ruquintami noga tarishcä› niptin ichanga","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"chay runaga gueshyaycashanpita allchacangami.","poem":1},{"lineBreak":true},{"text":"Mösu cashannömi cangapaj.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Chauraga mañacuptin Tayta Diospis yanapangami.","poem":1},{"lineBreak":true},{"text":"Cushicushpanmi Dioswan ricanaconga.","poem":1},{"lineBreak":true},{"text":"Diosga runata alli cashanmanmi cutichenga.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Chayrämi runa nenga:","poem":1},{"lineBreak":true},{"text":"‹Juchatami rurashcä, mana allicunatami rurashcä.","poem":1},{"lineBreak":true},{"text":"Chaypis Tayta Diosga manami castigamashachu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Chaypa ruquenga wañunäpitami salbamasha.","poem":1},{"lineBreak":true},{"text":"Chaymi achicyaj pachataraj ricaycä› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«Diosga chaynömi runata yaparir-yaparir ruran.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Wañunanpita salban.","poem":1},{"lineBreak":true},{"text":"Nircur camacächin achicyaj pachata ricaycänanpaj.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Wiyamashpayqui sumaj tantiyacuy ari Job.","poem":1},{"lineBreak":true},{"text":"Noga rimamushäcamaga upällalla cacuy.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Cutichimayta munashpayquega rimamuy ari.","poem":1},{"lineBreak":true},{"text":"Rasun cajta nimaptiquega noga allimi wiyashayqui.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Imapis cutichimänayquipaj mana captenga upällalla wiyamay.","poem":1},{"lineBreak":true},{"text":"Nogami yachachishayqui imano yachaj caytapis.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB