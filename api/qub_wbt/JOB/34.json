{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"heading","content":["Tayta Diosta Elihú chapashan"]},{"type":"verse","number":1,"content":["Elihú sïguir niycaran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Noga nishäta wiyamay musyaj yachajcuna.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rinrinchi wiyaptenga pï imata parlaycashantapis rejsinchïmi.","poem":1},{"lineBreak":true},{"text":"Gallunchïpis ima micuy cashantapis mayanmi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayno, noganchïpis tantiyacushun.","poem":1},{"lineBreak":true},{"text":"Nircur nishun maygan alli cashantapis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jobga nin: ‹Nogaga juchaynaj runami cä.","poem":1},{"lineBreak":true},{"text":"Chaypis Diosga manami alliga arriglamanchu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Llullacuycämanmi «juchayojmi cä» nishpäga.","poem":1},{"lineBreak":true},{"text":"Guerëcunaga manami allchacanchu, juchaynaj caycaptëpis› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«¡Jobnöga manami pipis canchu!","poem":1},{"lineBreak":true},{"text":"Payga yacuta upojnöllami Tayta Diosta manacajman churarin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Payga munan mana allita rurajcunawan goturayllata,","poem":1},{"lineBreak":true},{"text":"mana alli runacunawan iwal puriyllata.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Payga nin ‹Dios munashanno allita rurashpanchïpis","poem":1},{"lineBreak":true},{"text":"runaga manami imatapis chasquinchïchu› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Ichanga musyaj yachaj runacuna sumaj wiyamay.","poem":1},{"lineBreak":true},{"text":"¡Yarpayllapis ama yarpäshunchu","poem":1},{"lineBreak":true},{"text":"munayniyoj Tayta Diospäga ‹mana allitami ruran› u ‹llutantami ruran› nerga!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Payga cada runatami cutichin imanöpis rurashanpita.","poem":1},{"lineBreak":true},{"text":"Cada runami imata rurashanpitapis chasquin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Rasunpami munayniyoj Tayta Diosga","poem":1},{"lineBreak":true},{"text":"imatapis mana allita mana ruranchu, ni llutantapis mana ruranchu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Diosga intëru munduta mandananpaj mandaj cayta","poem":1},{"lineBreak":true},{"text":"manami pipitapis chasquishachu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tayta Dios munar jämayninta, espiritunta runapita shuntacurcuptenga","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"llapan runami wañunman.","poem":1},{"lineBreak":true},{"text":"Nircur cashgan allpamannami ticranman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Job, imatapis tantiyaj cashpayquega sumaj wiyamay.","poem":1},{"lineBreak":true},{"text":"Nishäcunata sumaj wiyay.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alli cajta chiquishpanga Dios manami mandanmanchu.","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj gamga juchaynaj Diospaj parlanqui juchayojpänöpis?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Raycuna, rispitädu runacuna fiyu captenga","poem":1},{"lineBreak":true},{"text":"quiquincunamanmi Diosga ayñita cutichin.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Payga manami mandajcunapa faburninchu.","poem":1},{"lineBreak":true},{"text":"Pobricunata cachaycorga manami rïcucunata yanapanchu.","poem":1},{"lineBreak":true},{"text":"Paymi llapan runacunatapis rurasha.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Runacunaga illajpitami wañucäcun.","poem":1},{"lineBreak":true},{"text":"Chacaychönami mancharishpan sicsicyan; nircorga illaraycanna.","poem":1},{"lineBreak":true},{"text":"Munayniyojcunaga manami runacunapa callpanwanchu illgan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Diosga ricaycanmi runacuna imallata rurashantapis.","poem":1},{"lineBreak":true},{"text":"Musyaycanmi imano cawashallantapis.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mana allita rurajcunataga","poem":1},{"lineBreak":true},{"text":"yanauyaycaj chacajpis manami pacanchu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Diosga runata manami willanchu","poem":1},{"lineBreak":true},{"text":"arriglananpaj pay cajman aywananpaj.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Manami musyacachänanräpischu munayniyojcunata jitarinanpaj,","poem":1},{"lineBreak":true},{"text":"chayman juctana ruquin churananpäpis.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tayta Diosga pï rurashantapis musyaycanmi.","poem":1},{"lineBreak":true},{"text":"Pacha chacarcuptin chayar illgarachinmi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fiyu runacunatanömi llapan ricaycaptin castigan.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Castigan mana wiyacuyta munajcunata,","poem":1},{"lineBreak":true},{"text":"imano rurananpaj nishantapis mana cumlejcunata.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Chay fiyu runacuna ñacachiptinmi pobricunaga Tayta Diosta mañacuran.","poem":1},{"lineBreak":true},{"text":"Chaura Tayta Diosnami wiyaran.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dios mana rimacuptenga","poem":1},{"lineBreak":true},{"text":"¿piraj payta jitapanman?","poem":1},{"lineBreak":true},{"text":"Dios ticracurcuptin runaga ¿imataraj ruranman?","poem":1},{"lineBreak":true},{"text":"Paymi ricaycan marcacunatawan runacunatapis,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"fiyu runacuna llullapaypa marcata mana mandananpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«¿Gamga Diosta willashcanquichu:","poem":1},{"lineBreak":true},{"text":"‹Juchatami rurashcä.","poem":1},{"lineBreak":true},{"text":"Cananpitaga manami juchata rurashänachu› nir?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"¿Nishcanquichu: ‹Mana musyaynëpa jucha rurashäcunata musyachimay.","poem":1},{"lineBreak":true},{"text":"Mana allita rurasha carga yapayga manami rurashänachu› nir?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Diosta manacajman churasha caycaptiquipis","poem":1},{"lineBreak":true},{"text":"¿gam munashayquinöchuraj Tayta Diosga cutichishunqui?","poem":1},{"lineBreak":true},{"text":"Chaytaga gammi acranayqui, manami nogachu.","poem":1},{"lineBreak":true},{"text":"Mä gam nimay ari musyashayquita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«Musyaj yachaj runacunapis,","poem":1},{"lineBreak":true},{"text":"yachaj runacunapis wiyamaj cäga nenga:","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"‹Jobga parlaycan manapis tantiyaycarmi.","poem":1},{"lineBreak":true},{"text":"Pay rimashanga caycan manacajcunallami,› nir.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Payga rimaycan mana alli runacunanöllami.","poem":1},{"lineBreak":true},{"text":"¡Chaymi Jobpäga sumaj mayacachäshun!","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Jobga manami juchallatachu ruraycan. Jananmanpis mana wiyacojmi.","poem":1},{"lineBreak":true},{"text":"Noganchi wiyaycashapis Diostaga manacajman churaycan.","poem":1},{"lineBreak":true},{"text":"Jananmanpis Diospa contran parlan.»","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}