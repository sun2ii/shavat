{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["Elihú sïguir niycaran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Job, gamga Diosta ‹juchaynajmi cä› nishcanqui.","poem":1},{"lineBreak":true},{"text":"Chayno nerga ¿allitachuraj nishcanqui?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mastapis tapushcanqui: ‹¿Imatataj gocushunqui juchata ruraptëpis?","poem":1},{"lineBreak":true},{"text":"¿Imatataj chasquë juchata mana rurasha carpis?›","poem":1},{"lineBreak":true},{"text":"Chayno nerga ¿allitachuraj nishcanqui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cananmi gamtapis","poem":1},{"lineBreak":true},{"text":"amïguyquicunatapis noga nishayqui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Masqui syëluta ricäriy.","poem":1},{"lineBreak":true},{"text":"Pucutayta ricärirpis masqui tantiyacuy ari.","poem":1},{"lineBreak":true},{"text":"Chay pucutayga gampita may altuchöshi caycan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Juchata ruraptiquipis Diospäga manami imananpischu.","poem":1},{"lineBreak":true},{"text":"Maychica juchayqui captinpis Diostaga manami imananpischu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Allita ruraptiquipis paytaga manami imatapis gonquichu.","poem":1},{"lineBreak":true},{"text":"Paypäga manami ima allitapis ruranquichu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mana allita rurashanpis quiquin runallatami chayan.","poem":1},{"lineBreak":true},{"text":"Allita rurashanpis quiquin runallapämi alli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Imapis päsaptinrämi runacunaga yarpachacur gaparpan.","poem":1},{"lineBreak":true},{"text":"Munayniyojcunapa maquinpita pillapis salbananpaj ruwacun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chayno caycarpis camamajninchi Tayta Diostaga manami yarpanchu.","poem":1},{"lineBreak":true},{"text":"Paymi chacaycunapapis cushicachimashpanchi cantachimanchi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Uywacunapitapis mas yachaj cananchïpaj paymi yachachimanchi.","poem":1},{"lineBreak":true},{"text":"Paymi äbicunapitapis mas yarpaysapa cananchïpaj tantiyachimanchi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ñacar gaparpaptinpis Diosga manami yanapanchu","poem":1},{"lineBreak":true},{"text":"alli runapita ushasha purej fiyu runacuna captin.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Diosga manami cäsupanchu","poem":1},{"lineBreak":true},{"text":"mana cumbënejcunata mañacushanta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Tayta Diosta ‹Gamta manami ricächu› nishpayquipis shuyaycuy ari.","poem":1},{"lineBreak":true},{"text":"Paypa maquinchömi caycanqui arriglashunayquipäga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gamga ninqui ‹Diosga manami rabyacunchu ni castigacunpischu,","poem":1},{"lineBreak":true},{"text":"ima juchata rurashanchïtapis manami cäsupanchu› nir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Job, gamga niycanqui manacajcunatami.","poem":1},{"lineBreak":true},{"text":"Mana tantiyacurmi wichaypa uraypa rimaycanqui.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}