{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"heading","content":["Tayta Dios munayniyoj cashanta Elihú rimashan"]},{"type":"verse","number":1,"content":["Elihú jinalla willapaycaran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Ichicllata shuyaycuy. Noganami willapar yachachishayqui.","poem":1},{"lineBreak":true},{"text":"Tayta Diospa faburnin rimanäpäga achcarämi caycan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yachashätaga llapantami willapäshayqui.","poem":1},{"lineBreak":true},{"text":"Camamajninchi rasun cajta rurashantami musyachishayqui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Manami imatapis llullacuypaga nishayquichu.","poem":1},{"lineBreak":true},{"text":"Nogaga rasunpa yachaj runami cä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Diosga fiyupa munayniyojmi; fiyupa yachajmi.","poem":1},{"lineBreak":true},{"text":"Juchaynajcunataga manami castiganchu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fiyu runacunataga wallca diyallami cawachin.","poem":1},{"lineBreak":true},{"text":"Ñacaycajcunatami ichanga alli yanapan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Allillata ruraj runacunataga imapitapis simrimi chapan.","poem":1},{"lineBreak":true},{"text":"Raycunawan goturänanpärämi camacächin.","poem":1},{"lineBreak":true},{"text":"Paycunataga yanapan allilla mandananpämi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Capaschari alli runacunaga cadinacunawan wataranman.","poem":1},{"lineBreak":true},{"text":"Capaschari nanaywan ñacanman.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaura Diosga musyachin ima mana allita rurashancunatapis","poem":1},{"lineBreak":true},{"text":"alli runapita ushasha cashantapis.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chay runata corrijishpan willapan.","poem":1},{"lineBreak":true},{"text":"Juchata ruraycashanta cachaycunanpaj willapan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Diosta wiyacur cumlishpanga","poem":1},{"lineBreak":true},{"text":"imaypis cawashanyäga cushisha allilla goyan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mana wiyacushpanmi ichanga wañun.","poem":1},{"lineBreak":true},{"text":"Manaräpis imatapis yachallar wañun.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fiyu runacunami ichanga ñacarpis fiyupa rabyan.","poem":1},{"lineBreak":true},{"text":"Tayta Dios cadinarächiptinpis manami mañacunchu yanapänanpäpis.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Manaraj edäman chayallarmi wañun.","poem":1},{"lineBreak":true},{"text":"Fiyupa cuyapaypämi wañun.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ñacachir-rämi Tayta Diosga runata tantiyachin.","poem":1},{"lineBreak":true},{"text":"Chayno ñacachiyparämi Diosga salban.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Gamtapis salbaycäshunqui fiyupa ñacaycajta,","poem":1},{"lineBreak":true},{"text":"alli pachaman chayachishunayquipaj, jauca goyächishunayquipaj,","poem":1},{"lineBreak":true},{"text":"alli micuycunata tarichishunayquipaj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fiyu runacunata castïgu chayashallanpämi gamga yarpachacuycanqui.","poem":1},{"lineBreak":true},{"text":"Ichanga jusgar castigashuptiqui manami imanöpapis chapacunquipächu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rabyashpayqui Tayta Diosta manacajman churargunquiman.","poem":1},{"lineBreak":true},{"text":"Manacajman churar-imarga manami ima-aycata gorpis salbacunquipächu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ñacar llaquicuycashayqui öraga may-jina gaparaptiquipis may-jina alliyayta munaptiquipis yanganami canga.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Pacha chacänanta ama munaychu.","poem":1},{"lineBreak":true},{"text":"Chacaychöga runacunata tucuy mana allicunami päsan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Imano ñacay cashantapis musyaycashpayquinaga","poem":1},{"lineBreak":true},{"text":"yapayga mana allicunata ama ruraynachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Sumaj tantiyacuy Dios fiyupa munayniyoj cashanta.","poem":1},{"lineBreak":true},{"text":"Paymanga manami pï yachachicojpis tincunchu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Paytaga imata rurananpäpis manami pipis ninchu.","poem":1},{"lineBreak":true},{"text":"Ni pipis manami ‹Mana allitami rurashcanqui› ninchu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Pay camashantaga llapan runami alaban.","poem":1},{"lineBreak":true},{"text":"Gampis alabaytaga ama gongaycuychu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Llapan runami Tayta Dios rurashantaga rican.","poem":1},{"lineBreak":true},{"text":"Carullapitapis ricanmi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Diosga fiyupa munayniyojmi.","poem":1},{"lineBreak":true},{"text":"Noganchëga manami imanöpa tantiyaytapis atipanchïchu.","poem":1},{"lineBreak":true},{"text":"Ni manami musyanchïchu ayca watayoj cashantapis.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Paymi yacuta jutuy-jutuylla juc pachaman shuntacächin.","poem":1},{"lineBreak":true},{"text":"Nircur tamyamanna ticrachin.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tamyaga pucutaycunapitami shicwaycämun.","poem":1},{"lineBreak":true},{"text":"Nircur cay pachamanga achca yacu machiypana chayamun.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"¿Pitaj tantiyan pucutaycuna imano aywashantapis,","poem":1},{"lineBreak":true},{"text":"räyucuna syëlucho imanir junrurushantapis?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Diosmi intëru lamar jananpa illguyta achicyächin.","poem":1},{"lineBreak":true},{"text":"Chayno achicyachishpan lamarpa rurintapis ricacächin.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Chaycunawanmi runacunatapis castigan.","poem":1},{"lineBreak":true},{"text":"Tamyawanpis aypalla micuycunatapis shuntachin.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Räyutapis chararan.","poem":1},{"lineBreak":true},{"text":"Chaura räyuga imapis mana cashallanmanna chayan.","poem":1},{"lineBreak":true},{"text":"Tayta Dios munashallanman maymanpis chayan.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tayta Diosga räyuchimur musyachimanchi rabyaycashantami.","poem":1},{"lineBreak":true},{"text":"Chaynöpami musyachimanchi juchasapacunapaj rabyaycashanta.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}