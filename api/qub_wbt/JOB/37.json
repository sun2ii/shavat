{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"«¡Chaypitami nogapa shongöpis fiyupa tic-ticyaycan!","poem":1},{"lineBreak":true},{"text":"¡Pëchöpitapis llojshicuriytarämi munan!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Masqui wiyay Tayta Diospa busnin sinchipa wiyacämushanta,","poem":1},{"lineBreak":true},{"text":"Paypa shimin junruruycämojta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paymi illguywan achicyächin allpapa juc cuchunpita juc cuchuncama.","poem":1},{"lineBreak":true},{"text":"Syëlupitapis räyuchimun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayno wiyacan sinchipa junrurumushan","poem":1},{"lineBreak":true},{"text":"fiyupa manchariypaj busninta wiyacächimuptin.","poem":1},{"lineBreak":true},{"text":"Janraraycämojta wiyashanchïcamaga illguypis manami chawanchu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dios busninta junruruchimuptenga fiyupa almiraypämi ruracan.","poem":1},{"lineBreak":true},{"text":"Payga tantiyayta mana atipashanchïcunatami ruran.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paymi nin rashta cay pachaman shicwamunanpaj.","poem":1},{"lineBreak":true},{"text":"Chayno camacächin tamya fiyupa tamyananpäpis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaynöpami camacächin runacuna wasinpita mana llojshinanpaj.","poem":1},{"lineBreak":true},{"text":"Llapan runata tantiyachin paylla llapanta camacaycächishanta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Animalcunapis machaycunaman yaycur","poem":1},{"lineBreak":true},{"text":"chaychömi pacarpäcun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ura caj-läpitami löcu wayra shamun.","poem":1},{"lineBreak":true},{"text":"Jana caj-läpitanami gasay chayamun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dios pücaptinmi gasapapis ruracan.","poem":1},{"lineBreak":true},{"text":"May-may aypalla yacucuna jananpapis tintin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paymi camacächin yacuta pucutay jogarinanpäpis.","poem":1},{"lineBreak":true},{"text":"Camacächin chay pucutaypita räyu llojshinanpaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaura illguynin pillgut-pillgutyar syëlupa aywan.","poem":1},{"lineBreak":true},{"text":"Chaynömi Tayta Diosga munashanta ruran intëru allpa janancho.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aybësiga chaycunawanmi Tayta Diosga cay pachata castigan.","poem":1},{"lineBreak":true},{"text":"Aybësiga cuyapäcoj cashanta musyachimanchi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Job, sumaj tantiyacunayquipaj wiyamay.","poem":1},{"lineBreak":true},{"text":"Masqui sumaj yarpay fiyupa almiraypajcunata Tayta Dios rurashanta.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¿Gam musyanquichu Tayta Dios chaycunata imano camacächishantapis?","poem":1},{"lineBreak":true},{"text":"¿Musyanquichu illguy achicyänanpaj pucutaycho imano yurishantapis?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¿Gam musyanquichu wayrawan pucutay imano puriycashantapis?","poem":1},{"lineBreak":true},{"text":"Chaycunaga musyachimanchi fiyupa yachaj Dios cashantami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wapuriypa acaptin","poem":1},{"lineBreak":true},{"text":"¿musyanquichu röpayquiwan cashpayqui imanir südashayquitapis?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gamga Tayta Diosta ¿yanapanquimanchu mana cuyucoj cananpaj syëluta mashtäshiyta?","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Nogacunata yachachimay imano Tayta Diosta ruwacunäpäpis.","poem":1},{"lineBreak":true},{"text":"Nogacunaga carcaycä chacaycho caycajno yarpayniynajmi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nogaga manami Diospäga nëmanchu ‹Paywan parlaytami munä› niyllapis.","poem":1},{"lineBreak":true},{"text":"Chayno nerga illgächimänanta munallarmi nëman.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Pucutay yanamaraycashan öraga manami ricanchïchu intitapis.","poem":1},{"lineBreak":true},{"text":"Pucutayta wayra apacuptinmi ichanga syëlupis lliuyacäcun.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Punta janancunapa norte caj-läpami garwanchucarcamun.","poem":1},{"lineBreak":true},{"text":"Chayga musyachimanchi Dios almiraypaj munayniyoj cashantami.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Dios rurashanta manami tantiyanchïchu.","poem":1},{"lineBreak":true},{"text":"Payga caycan fiyupa callpayoj, alli arregluta rurajmi.","poem":1},{"lineBreak":true},{"text":"Payga llapanta cumlej, pitapis mana ñacachejmi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Chaynöpami llapan runacuna manchacun.","poem":1},{"lineBreak":true},{"text":"Yachaj-tucojcunatami ichanga alliga mana ricanchu.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}