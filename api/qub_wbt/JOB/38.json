{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"heading","content":["Job manacajlla cashanta Tayta Dios tantiyachishan"]},{"type":"verse","number":1,"content":["Chaura Tayta Diosga shucucuy wayrapita Jobta nimuran:"]},{"type":"verse","number":2,"content":[{"text":"«¿Pitaj gamga canqui yarpashäcunata manacajman churanayquipaj,","poem":1},{"lineBreak":true},{"text":"mana tantiyashayquicunata rimanayquipäga?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Canan mä rasunpa runano camaricuy.","poem":1},{"lineBreak":true},{"text":"Cananmi willamanqui llapan tapushäcunata:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Maychötaj caycarayqui cay pachata camashä öra?","poem":1},{"lineBreak":true},{"text":"¡Mä nimay, rasunpa yachaj cashpayquega!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gam ¿musyanquichu ima tamäñu cay pacha cananpaj pï nishantapis?","poem":1},{"lineBreak":true},{"text":"¿Musyanquichu pï curdilta chutashantapis?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Munduga ¿ima janancunachötaj tacyaraycan?","poem":1},{"lineBreak":true},{"text":"¿Pitaj churaran juc rumita chayta tuncaränanpaj","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"pacha yur'gaycaptin shanariypa shanarir goyllarcuna cantaycaptin,","poem":1},{"lineBreak":true},{"text":"syëlucho sirbimajcuna fiyupa cushicurcaycaptin?","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Allpa chaupinpita lamar yacu pashtamuptin","poem":1},{"lineBreak":true},{"text":"¿pitaj churasha puncucunata chay uchcuta chapananpaj?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nogami camacächishcä pucutay cay pachapa röpanno cananpaj,","poem":1},{"lineBreak":true},{"text":"yanamaraycaj pucutaytapis churapashcä inchananpaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nogami señalapashcä lamar maycamalla chayananpäpis.","poem":1},{"lineBreak":true},{"text":"Yacu llojshimunan puncuntapis lläbiwan lläbircushcä.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nircur nishcä: ‹Caycamallami chayamunqui.","poem":1},{"lineBreak":true},{"text":"Caypita mastaga mananami wichanquipänachu.","poem":1},{"lineBreak":true},{"text":"Wayra apamushuptiqui bötiypa-bötishayquipis cayllachömi quëdanqui.›","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«¿Imayllaga gam mandashcanquichu","poem":1},{"lineBreak":true},{"text":"pacha yur'gämur waränanpaj?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¿Mandashcanquichu intëru allpa jananpa pacha achicyänanpaj,","poem":1},{"lineBreak":true},{"text":"chaynöpana fiyu runacunapis gueshpir pacacunanpaj?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chauraga jircacuna imano cashanpis musyacämun.","poem":1},{"lineBreak":true},{"text":"Nircur culurnincunapis röpa-jinaraj ricacämun.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaura fiyucunaga mayman pacacuytapis mananami camäpacunnachu.","poem":1},{"lineBreak":true},{"text":"Mana allicunata ruraytapis manana puydinnachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«¿Gam yaycushcanquichu pacha rurin uchcuman?","poem":1},{"lineBreak":true},{"text":"Chayno ¿ricashcanquichu lamar yacu maypita pashtaycämushantapis?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¿Tarishcanquichu wañojcuna chayashan pachata?","poem":1},{"lineBreak":true},{"text":"¿Ricashcanquichu wañuyman chayana manchacuypaj puncu maycho caycashantapis?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¿Musyanquichu mundu ima tamäñu caycashantapis?","poem":1},{"lineBreak":true},{"text":"Rasunpa musyaj cashpayquega mä nimay ari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«¿Mayninpitataj näni llojshiycan achicyajman chayanapaj?","poem":1},{"lineBreak":true},{"text":"¿Maychötaj chay achicyäga caycan?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"¿Gam musyanquichu chaycunata juc cuchuncama imanöpa chayachiytapis,","poem":1},{"lineBreak":true},{"text":"nircur cashganman yapay cutichimuytapis?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gamga achca watayojna canquipis.","poem":1},{"lineBreak":true},{"text":"Chaycunataga llapantapis musyaycanquichari.","poem":1},{"lineBreak":true},{"text":"Chay örapäga maynachari yurisha caycarayqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«¿Gam chayashcanquichu rashtawan runtu churaräcunan cajman?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Chaytaga churaraycächë llaquicuy captin, pillyacuna captin,","