{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"«¿Gam musyanquichu jacha cabracuna imay wachashantapis?","poem":1},{"lineBreak":true},{"text":"¿Ricashcanquichu lluychucuna wachajta?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Gam musyanquichu charicushanpita ayca quillataraj wachashantapis?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wachananpäga guempucäcunmi.","poem":1},{"lineBreak":true},{"text":"Chayrämi wawancuna yurin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nircur itincunana maucha wiñan. Chunyaj jircacho wiñacun.","poem":1},{"lineBreak":true},{"text":"Chayno wiñarcorga maman cajpita aywacun mas mana cutimojna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«¿Pitaj camacächisha jirca chucaru bürru cachaylla tiyacunanpaj,","poem":1},{"lineBreak":true},{"text":"mana nunca watana cananpaj?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaycunataga nogami ricachishcä","poem":1},{"lineBreak":true},{"text":"chunyaj chaqui jircata, cachiyoj guechwacunatapis chaycho tiyacunanpaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaycunaga manami yachacanchu marcachöga.","poem":1},{"lineBreak":true},{"text":"Manami wiyanpischu carga gatej jarrïrucuna gayarashantapis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Intëru jircacunapa cörricachäcun guewata ashir,","poem":1},{"lineBreak":true},{"text":"berdi guewata micunanpaj ashishpan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«¿Gamga riguinquichu yügurcushayqui öra chucaru töru-mallwa arunanta,","poem":1},{"lineBreak":true},{"text":"waquin wäcayqui wichgaränancho iwal puñunanpaj cashantapis?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¿Yügurcur aruchinquimanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Cuspiyacunata garchaparcur pushaptiqui guepayquita shamunmanchuraj?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¿Callpayoj captinchuraj chay uywaman yäracunqui?","poem":1},{"lineBreak":true},{"text":"¿Arupäshunayquipäpis yäracunquimanchuraj?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Chaqui micuyniquicunata ashtapäshunquichuraj?","poem":1},{"lineBreak":true},{"text":"Nircur ¿ërachöpis shuntapäshunquichuraj?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Masqui tantiyacuy avestruz äbipaj:","poem":1},{"lineBreak":true},{"text":"Cushisha älanta sapsicun","poem":1},{"lineBreak":true},{"text":"ancano päriyta munashpan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Avestruzga wacharir runtuncunata agushcho cachaycun","poem":1},{"lineBreak":true},{"text":"shanay agushta goñöchishallanwan runtun pashtamunanpaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Manami yarpachacunchu ima ñitirinantapis,","poem":1},{"lineBreak":true},{"text":"ni ima animal lluchcaparinantapis.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chay äbiga wawancunapaj fiyumi.","poem":1},{"lineBreak":true},{"text":"Wawancunataga manami quiquinpa wawancunatanöchu rican.","poem":1},{"lineBreak":true},{"text":"Manami imapis gocunchu","poem":1},{"lineBreak":true},{"text":"yangallapaj runtuta wachasha carpis.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chay äbitaga noga manami yarpayta goshcächu.","poem":1},{"lineBreak":true},{"text":"Manami munashcächu alli yarpayniyoj cananta.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Jatarcur cörriyta gallaycur ichanga","poem":1},{"lineBreak":true},{"text":"muntädu aywajtapis pasaypa llallin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«¿Gamchu callpayojyächishcanqui cawalluta?","poem":1},{"lineBreak":true},{"text":"¿Gamchu ajchantapis matancanpa wiñachishcanqui?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"¿Gamchu chuclusnöraj pinticachänanpaj camacächishcanqui?","poem":1},{"lineBreak":true},{"text":"Cawalluga sinchi gaparar manchachicunrämi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Allpata aspicachan.","poem":1},{"lineBreak":true},{"text":"Imatapis mana manchacuypa pillyamanga yagacuycun.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Manchariytapis mana yachanchu.","poem":1},{"lineBreak":true},{"text":"Manchariypitapis asicun.","poem":1},{"lineBreak":true},{"text":"Sablita ricashpanpis manami sicsicyanchu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Muntädu aywajpa lëcha apacunan shagllajyan.","poem":1},{"lineBreak":true},{"text":"Sablipis, sajmaypa tucsicunapis achicyaypa achicyaycan.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Juclla chayayta munashpan fiyupa cörrerga may carutapis rätumi chayarin.","poem":1},{"lineBreak":true},{"text":"Trompëta wagamuptinnaga manami ichiycunnachu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Trompëtacuna wagamuptenga cawalluga wagan.","poem":1},{"lineBreak":true},{"text":"Carupita-pachami mayan pillya cashantapis.","poem":1},{"lineBreak":true},{"text":"Wiyan capitancuna gayarpaycajtapis","poem":1},{"lineBreak":true},{"text":"pillyajcuna gaparpaycajtapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«¿Gam yachachinquimanchu wamäshu anca pärinanpaj?","poem":1},{"lineBreak":true},{"text":"¿Gamchu yarpayta goshcanqui sur caj-läman aywananpaj?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"¿Gamchu nishcanqui allgaycuna gagacunacho gueshwanta rurananpaj?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Allgayga junajpa chacaypapis gagacunallacho tiyan.","poem":1},{"lineBreak":true},{"text":"Pacacunanpaj gagacunapa puntanman ratan.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Chaypitami ricachacur","poem":1},{"lineBreak":true},{"text":"caruman rican imatapis charinanpaj.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Wawancunaga yawartami upun.","poem":1},{"lineBreak":true},{"text":"Maychöpis wañusha caycashanmanmi allgaycunaga shuntacan.»","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}