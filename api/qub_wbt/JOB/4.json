{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Jobta Elifaz piñacushan"]},{"type":"verse","number":1,"content":["Chayno niptin Temán runa Elifazga Jobta niran:"]},{"type":"verse","number":2,"content":[{"text":"«Job, imallatapis parlaparcuptë capaschari rabyacunquipis.","poem":1},{"lineBreak":true},{"text":"Nogapis manami upällallaga cacömannachu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gamga achcajtami willapar tantiyachej canqui.","poem":1},{"lineBreak":true},{"text":"Callpaynajno caycajta yanapaj canqui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mana alliman chayajcunata shacyächir yanapaj canqui.","poem":1},{"lineBreak":true},{"text":"Mana alliman chayananpaj caycajta tantiyachir willapaj canqui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quiquiqui mana alliman chayashpayqui ichanga mana awantanquichu;","poem":1},{"lineBreak":true},{"text":"llaquisha caycanqui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gamga llapan shonguyquipami Tayta Diosta sirbinqui.","poem":1},{"lineBreak":true},{"text":"Llapantapis allillatami ruranqui.","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj llapan shonguyquipa mana yäracunquichu?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Masqui yarpäriy, ¿piraj juchaynaj caycar mana alliman chayasha?","poem":1},{"lineBreak":true},{"text":"¿Mayllachöga ricashcanchïchu juchaynaj runa ñacajta?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nogaga musyämi,","poem":1},{"lineBreak":true},{"text":"wañuchicojcunatawan jucta mana allita rurajcunataga ima päsashantapis.","poem":1},{"lineBreak":true},{"text":"Quiquincunamanmi ayñiga cutin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Diosga mana alli runacunatami rabyar castigan.","poem":1},{"lineBreak":true},{"text":"Castigar ushajpämi illgächin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Liyuncunano wagaptin, gaparpaptinpis,","poem":1},{"lineBreak":true},{"text":"Tayta Diosga quiruncunatapis paquir-rämi upällachenga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paycunaga wañongapaj cäsata mana tarej liyuncunanömi.","poem":1},{"lineBreak":true},{"text":"Wamrancunana machiypa-machir aywaconga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Pacayllapami willapämasha.","poem":1},{"lineBreak":true},{"text":"Shap-shapyayllapa rimajta yangallami wiyashcä.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Llapan runacuna wañusha puñuycänan örami","poem":1},{"lineBreak":true},{"text":"manchariypajcunata suyñupäcurä.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chaymi fiyupa mancharirä.","poem":1},{"lineBreak":true},{"text":"Tullöcunapis sicsicyaycaran.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Jämay wall-wallyamojta mayashcä.","poem":1},{"lineBreak":true},{"text":"Chauraga intërömi shiriricäcuran.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ñaupächo juc caycajtanömi mayashcä.","poem":1},{"lineBreak":true},{"text":"Llantusyajllatami ricashcä.","poem":1},{"lineBreak":true},{"text":"Ichanga manami pï cashantapis rejsishcächu.","poem":1},{"lineBreak":true},{"text":"Mana imapis cashanpitami wiyarcurä cayno rimarcamojta:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"‹Juc runaga Tayta Diospa ñaupancho ¿juchaynaj canmanchuraj?","poem":1},{"lineBreak":true},{"text":"Camajninpa ñaupanchöga ¿limyu canmanchuraj?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Janaj pachacho sirbiycajcunatapis manami pasaypaga yäracunchu.","poem":1},{"lineBreak":true},{"text":"Anjilnincunatapis «mana allita ruran» niycarga","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¡masrächari runataga «juchayoj» nenga!","poem":1},{"lineBreak":true},{"text":"Runaga caycan manacajllami,","poem":1},{"lineBreak":true},{"text":"ñuchu allpa janancho mitupita wasita jatarachishanöllami.","poem":1},{"lineBreak":true},{"text":"Puyuno llapiriyllapämi caycanpis.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Runaga illajpitami illaraycan.","poem":1},{"lineBreak":true},{"text":"Imaypis mana cawarimojnami wañucun.","poem":1},{"lineBreak":true},{"text":"Quëdaj runacunapis gongaycärinnami.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chutaycaptin jïlu rachicäcojnömi runaga usharaycan.","poem":1},{"lineBreak":true},{"text":"Yachaj cayman manaräpis chayallarmi wañun› nir.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JO