{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Tayta Diosga jinalla parlaycaran. Chaymi Jobta niran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Munayniyoj Dios caycaptë gam jusgamayta munarcur","poem":1},{"lineBreak":true},{"text":"¿canan nishäcunatapis cutichimaytarächuraj yarpanqui?»","poem":1}]},{"type":"heading","content":["Job cutichishan"]},{"type":"verse","number":3,"content":["Chaura Jobga Tayta Diosta cutichishpan niran:"]},{"type":"verse","number":4,"content":[{"text":"«¿Imataräshi nogaga nëman pasaypa manacajlla caycashpäga?","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga upällallana cacushaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaparir-yaparir achcatanami rimashcä.","poem":1},{"lineBreak":true},{"text":"Masta rimanäpäga mananami cannachu.»","poem":1}]},{"type":"heading","content":["Tayta Dios Jobta yapay nishan"]},{"type":"verse","number":6,"content":["Chaura Tayta Diosga shucucuy wayrapita Jobta nimuran:"]},{"type":"verse","number":7,"content":[{"text":"«Canan mä rasunpa runano camaricuy.","poem":1},{"lineBreak":true},{"text":"Cananmi llapan tapushäcunata willamanqui:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gamga ¿pantaycashätachu yarpaycanqui?","poem":1},{"lineBreak":true},{"text":"¿‹Juchaynajmi cä› nishpayquichu, nogataga ‹juchayoj canqui› niycämanqui?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¿Gam noganöchu sinchi canqui?","poem":1},{"lineBreak":true},{"text":"¿Räyuno busnënöchu gampapis busniqui?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chayno captenga mä munayniyoj rispitädu ricacuy.","poem":1},{"lineBreak":true},{"text":"Achicyaypa achicyaycaj röpayquita jaticuy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mä ricay llapan alli-tucojcunata:","poem":1},{"lineBreak":true},{"text":"Rabyasha caycashayquiwan castigay. Nircur pengacachiy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ricärishallayquiwan ushariy.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunataga caycashallancho mä llapiriy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Cay pachacho cajtaga llapanta pampariy.","poem":1},{"lineBreak":true},{"text":"Nircur wichgarcuy wañushacuna prësu caycashan cajman.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chauraga quiquëpis nishämi","poem":1},{"lineBreak":true},{"text":"‹Munayniquiwanmi salbacushcanqui› nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Masqui ricay ‹Behemot›","poem":1},{"noteId":2},{"text":"jutiyoj manchacuypaj animalta.","poem":1},{"lineBreak":true},{"text":"Chaytapis gamta rurashäno nogallami rurashcä.","poem":1},{"lineBreak":true},{"text":"Wäcacunanömi guewata micun.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ricay, imano sinchishi matancancuna,","poem":1},{"lineBreak":true},{"text":"imano callpayojshi ricrancunapis.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chupanpis fiyupa chucru sedru guerunömi.","poem":1},{"lineBreak":true},{"text":"Atacancunacho caj ancuncunapis pillucasha-pillucasharämi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tulluncunapis caycan runsi tübunöraj,","poem":1},{"lineBreak":true},{"text":"fyërrupita garutinöraj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chayga caycan noga yachaj caynëwan rurashämi.","poem":1},{"lineBreak":true},{"text":"Rurashä captin nogallami chaytaga binsëman.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Jirca animalcuna tiyar gochpashan","poem":1},{"lineBreak":true},{"text":"jircachömi wiñan guewacunapis chay animalpäga.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Öjasapa jachacunapa öjan shicwaj rurincho puñun.","poem":1},{"lineBreak":true},{"text":"Gocha-gocha, shatacuna caycashallanchömi pacaräcunpis.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Öjasapa jachacuna llantupan.","poem":1},{"lineBreak":true},{"text":"Yacu aywajpa cantuncunacho caj wayau guerucunana intërunpa tumaraycan.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mayu chayaptinpis manami manchacunchu.","poem":1},{"lineBreak":true},{"text":"Sengancamana yacu ñitiptinpis imatapis mana gocuypami cacun.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ricchaycaptenga ¿piraj charinman?","poem":1},{"lineBreak":true},{"text":"¿Piraj sengantapis uchcuparinman arguyllata churacurcunanpaj?","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"Behemotpäga yarpaj jatuncaray animal cashantami. Waquin yarpaj hipopótamo animalno cashantami.","reference":{"chapter":40,"verse":15}}]},"thisChapterLink":"/api/qub_wbt/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}