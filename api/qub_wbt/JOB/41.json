{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"«Waräcuy Leviatantaga","poem":1},{"lineBreak":true},{"text":"¿pescädutano charinquimanchuraj ansuylallawan?","poem":1},{"lineBreak":true},{"text":"¿Shiminta watanquimanchuraj llanu wascallawan?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Senganpita charichinquichuraj juc llanu wascallawan?","poem":1},{"lineBreak":true},{"text":"¿Quijädanpita juc fyërruwan charichinquimanchuraj?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cuyapänayquipaj ¿ruwashunquimanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Alli shimillanpachuraj ruwashunquiman?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Gamga jurachinquimanchuraj imaycamapis sirbishunayquipaj?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Paywanga pucllanquimanchuraj iti äbiwan juc runa pucllajno?","poem":1},{"lineBreak":true},{"text":"¿Wamrayquicunapa pucllananpächuraj watanqui?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Nigusyanticunaga chayta rantiyta munanmanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Ranticojcuna ichic-ichiclla cuchunmanchuraj ranticunanpaj?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¿Lëchayquiwan tucsirinquimanchuraj garan rurinyaj päsajpaj?","poem":1},{"lineBreak":true},{"text":"¿Pescäduta charicunawan umanpa tucsipaycunquimanchuraj?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Payta yatayllapis yataycuptiquega","poem":1},{"lineBreak":true},{"text":"musyanquimanmi imano cashantapis.","poem":1},{"lineBreak":true},{"text":"Chauraga imaypis manami gonganquipächu.","poem":1},{"lineBreak":true},{"text":"Chayno ruraycushuptiquega mananami imaypis rimapanquipänachu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Leviatanta chariyta yarpashanpis yangami.","poem":1},{"lineBreak":true},{"text":"Ricaycullarnami manchariywan pï-maypis chiyacäcunman.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pipis gallariparcuptenga fiyupami rabyacurcun.","poem":1},{"lineBreak":true},{"text":"Chayno caycaptenga nogapa ñaupächo ¿piraj ichiraycanman?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¿Pitaj nogata imatapis gomasha cutichinäpäga?","poem":1},{"lineBreak":true},{"text":"¡Llapanpis nogallapami!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Leviatanpa chaquincuna,","poem":1},{"lineBreak":true},{"text":"cuerpuncuna imano callpayoj cashanpäpis simrimi rimaycäshaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¿Piraj jorgunman intëru jananta chaparaycajta?","poem":1},{"lineBreak":true},{"text":"¿Piraj janan chapacunan chucru caycajta uchcurinman?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¿Piraj shiminta quicharinman?","poem":1},{"lineBreak":true},{"text":"Quiruncunaga caycan fiyupa manchacuypämi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wajtan lömunpis caycan fïlayllanpa chapacunawan sumaj chapashami.","poem":1},{"lineBreak":true},{"text":"Chaycunaga sumaj chapasha car sinchi ruminömi caycan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Jucnin-jucninman fiyupa chanajmi lagacasha caycan.","poem":1},{"lineBreak":true},{"text":"Chaypaga ni wayrapis manami yaycunchu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaycunaga jucnaylla sumaj jiracashami caycan.","poem":1},{"lineBreak":true},{"text":"Chaytaga manami pipis rachicächinchu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wishgaptenga illguynörämi senganpa llojshimun.","poem":1},{"lineBreak":true},{"text":"Ñawincunapis pacha waraptin inti yagamojnörämi achicyan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Shiminpitapis llojshin nina ratataycajraj.","poem":1},{"lineBreak":true},{"text":"Nina shansharämi shicwarcunpis.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Senganpitapis llojshin goshtayraj","poem":1},{"lineBreak":true},{"text":"manca timpuptin waputay llojshejnöraj.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Jämaynenga nina upisha caycaj carbuntapis shanshachinmi.","poem":1},{"lineBreak":true},{"text":"Senganpita llojshin nina.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Cuncanpis fiyupa chucru callpayojmi.","poem":1},{"lineBreak":true},{"text":"Chaymi payta ricarga llapanpis fiyupa mancharir gueshpin.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Cuerpuncho mas caycaj aychanpis caycan","poem":1},{"lineBreak":true},{"text":"fiyupa chucru imapis mana yaycunanpänömi.","poem":1},{"lineBreak":true},{"text":"Chayga caycan jundisha fyërrunöraj.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Puywayninpis paypaga gagano chucru, tunaynöpis chucru.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Pay rabyaptenga guërracho binsejcunapis mancharishami ricacun.","poem":1},{"lineBreak":true},{"text":"Chaymi fiyupa mancharisha gueshpir aywacun.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Sabliwan cuchuptinpis manami mayachinchu.","poem":1},{"lineBreak":true},{"text":"Tucsicunapis ni lëchapis manami yaycunchu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Paypäga fyërrupis ogshanöllami caycan.","poem":1},{"lineBreak":true},{"text":"Runsipis ismusha guerunöllami caycan.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Lëchawan illaparpis manami gueshpichinquichu.","poem":1},{"lineBreak":true},{"text":"Waracaptiquipis rumicunaga ogshanöllami jananman chayan.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Jatun mäsuwan wiruptinpis cashpiwan wirushannöllami.","poem":1},{"lineBreak":true},{"text":"Lansawan sajmashan wichyar aywajta wiyarpis manami imapis gocunchu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Mitunpa garachaypa aywarga wayanchatarämi rurarin.","poem":1},{"lineBreak":true},{"text":"Rurinpaga quëdan callapa gueruta garachasha runa apashanno gashacasharämi.","poem":1},{"lineBreak":true},{"text":"Punshata shuntacuna afilasha aywashannörämi quëdan.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Yacunpa aywarga may-may ruri lamartapis timpurachimun","poem":1},{"lineBreak":true},{"text":"mancacho yacu timpuycajtanörämi.","poem":1},{"lineBreak":true},{"text":"Mancacho caycaj yacuta poshgachejnörämi timpurachimun.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Aywashan guepanpaga yacu quëdan yur'garaycar achicyaypa achicyar-raj.","poem":1},{"lineBreak":true},{"text":"Chaura lamar yacuga ricacun soguyacäcushanörämi.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Chay-niraj animalga manami canchu cay pachachöga.","poem":1},{"lineBreak":true},{"text":"Leviatanga rurasha caycan imaypis mana manchacunanpämi.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Mas munayniyojcunatapis manacajmanmi churan.","poem":1},{"lineBreak":true},{"text":"Chayno, llapan jirca animalcunatapis payga manchachinmi.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}