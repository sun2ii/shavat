{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"«¡Gaparay Job!","poem":1},{"lineBreak":true},{"text":"Mä pillaga wiyashunquichush.","poem":1},{"lineBreak":true},{"text":"¿Maygan anjiltataj yäracunqui?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Musyanchïmi mana tantiyaj upacunaga rabyallawan wañushanta.","poem":1},{"lineBreak":true},{"text":"Yargajcunaga munapaycällarmi wañuymanpis chayan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ricashcämi mana tantiyaj upa runacuna alliman chayajta.","poem":1},{"lineBreak":true},{"text":"Ichanga jinan öra ima-aycanpis ushacäcusha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chay runapa wamrancunata pipis manami yanapanchu.","poem":1},{"lineBreak":true},{"text":"Autoridäcunapis alliga mana arriglanchu.","poem":1},{"lineBreak":true},{"text":"Pipis manami faburnin ichircunchu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Murupacushan pogojcunata pishipacajcunami micucarcärin.","poem":1},{"lineBreak":true},{"text":"Cashayoj jachacunapa rurincho caycaptinpis shuntacarcärin.","poem":1},{"lineBreak":true},{"text":"Ima-ayca charashancunatapis lajwaypa lajwar yargajcunana ushacurcun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mana alli rurayga manami allpapitachu llojshimun.","poem":1},{"lineBreak":true},{"text":"Ñacaycunapis manami pachapitachu yurin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ninapita chispa pintishanno,","poem":1},{"lineBreak":true},{"text":"quiquin runami ñacananpäpis juchayoj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Gamno cashpäga Tayta Diostami ruwacöman.","poem":1},{"lineBreak":true},{"text":"Paypa maquinmanmi dimandöta churäman.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Paymi ruran mana ricashanchi fiyupa almiraypajcunata!","poem":1},{"lineBreak":true},{"text":"¡Chaycunataga pipis manami tantiyanchu!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paymi tamyachimun cay pachaman.","poem":1},{"lineBreak":true},{"text":"Chay tamyami pargun intëru jircata.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paymi umildicunataga alliman churan.","poem":1},{"lineBreak":true},{"text":"Llaquicuycajcunatapis cushicachin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sabïdu runacuna yarpashancunatapis","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi mana camacächinchu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Paymi ticrachin sabïducuna yarpaycashanga quiquinman chayananpaj.","poem":1},{"lineBreak":true},{"text":"Mana allita yarpaycashantapis mana camacächinchu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Paycunaga yanauyaycaj chacaycho chacäpacusha caycajnöpis","poem":1},{"lineBreak":true},{"text":"junaj pachapami yatayllapa purircaycan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Diosga fiyucunapita salbanmi pobricuna ñacaycajcunatapis.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Paymi callpaynajcunatapis cushicachin.","poem":1},{"lineBreak":true},{"text":"Fiyucunatapis upällachin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Cushisha cachun Tayta Dios corrijishan runaga.","poem":1},{"lineBreak":true},{"text":"Ima-aycapäpis munayniyoj Tayta Dios corrijishushayquitaga wiyacuy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Pay garayquita rachishpanga jampipäshunquimi.","poem":1},{"lineBreak":true},{"text":"Castigashushpayquipis allchacächishunquimi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tayta Diosga ima mana alli chayashunayquipita yapay yapaymi salbashunquipaj.","poem":1},{"lineBreak":true},{"text":"Manami camacächengapächu mana alli chayashunayquitaga.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Muchuy captinpis mana wañunayquipämi salbashunquipaj.","poem":1},{"lineBreak":true},{"text":"Guërra captinpis sabliwan wañuchishunayquipita salbashunquipämi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Washayqui rimanantapis manami camacächengachu.","poem":1},{"lineBreak":true},{"text":"Castïgu captinpis manami manchacunquipächu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Muchuy, ni llaquicuy captinpis","poem":1},{"lineBreak":true},{"text":"manami imapis gocushunquipächu.","poem":1},{"lineBreak":true},{"text":"Micucoj jirca animalcunatapis manami manchacunquipächu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Rumicunapis chacrayquicunacho manami quichquirangachu.","poem":1},{"lineBreak":true},{"text":"Jirca animalcunapis cuyashunquipämi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wasiquichöpis alli goyayllami canga.","poem":1},{"lineBreak":true},{"text":"Uywayquicunapis manami jucpis pishengachu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gampitaga aypallami miranga","poem":1},{"lineBreak":true},{"text":"jirca jachacunanöraj.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Auquinyarpis callpayojllarämi caycanquipaj","poem":1},{"lineBreak":true},{"text":"timpuncho rutusha rïgunöraj.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Chayno cashantaga ricashpanchïmi musyanchi.","poem":1},{"lineBreak":true},{"text":"Rasunpami chayno.","poem":1},{"lineBreak":true},{"text":"Chaycunata sumaj wiyay.","poem":1},{"lineBreak":true},{"text":"Masqui quiquiquipis yarpachacuriy.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}