{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["Amïguncunata Job ollgöpashan"]},{"type":"verse","number":1,"content":["Chaura Job niran:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Llaquicuynëta, disigrasya chayamashancunata","poem":1},{"lineBreak":true},{"text":"shuntarcur balansawan pësaptenga","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"lamar cantuncho agushpitapis masmi lasanman.","poem":1},{"lineBreak":true},{"text":"Chaymi ushaypa ushar rimashcäpis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tayta Diospa lëchanmi nogacho jaticasha caycan.","poem":1},{"lineBreak":true},{"text":"Benënunmi intëru cuerpöman mashtacasha.","poem":1},{"lineBreak":true},{"text":"Tayta Dios ñacachimashpanmi fiyupa manchaycächiman.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Guewan captenga bürrupis manami gaparanchu.","poem":1},{"lineBreak":true},{"text":"Törupis micunanpaj caycaptenga manami büyanchu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gam nimashayquega cachiynaj micuynömi,","poem":1},{"lineBreak":true},{"text":"runtupa yurajnin gamyajnömi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaypis cananga mana yachashämi micuynë.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«¡Ima alliraj canman mañacushäta Tayta Dios auniycamaptin!","poem":1},{"lineBreak":true},{"text":"¡Ima alliraj canman munashäta Tayta Dios cumlimaptin!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Ima alliraj canman Tayta Dios llapiramaptin!","poem":1},{"lineBreak":true},{"text":"Chauraga wañur usharäcömannami.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fiyupa nanaywan wañurpis cushicömanmi","poem":1},{"lineBreak":true},{"text":"imaypis Tayta Diospa laynincunata cumlej cashpä.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Callpäpis manami cannachu masta awantanäpänaga.","poem":1},{"lineBreak":true},{"text":"¿Imatanataj shuyäshäpis?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Manami gagano sinchichu cä,","poem":1},{"lineBreak":true},{"text":"ni runsino chucrupischu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Quiquilläpitaga manami imatapis rurächu.","poem":1},{"lineBreak":true},{"text":"Yanapämänanpäpis manami pipis canchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Ñacaycaj amïgunchïtaga cuyapanchïmi,","poem":1},{"lineBreak":true},{"text":"Tayta Dios nishancunata mana cumliptinpis.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gamcunami ichanga amïgö caycarpis mana yanapämanquichu.","poem":1},{"lineBreak":true},{"text":"Gamcunaga ragrapa yacu päsarejnömi caycanqui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yacuga putca aywan gasapawan, rashtawan tacushami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mana rashtaptinnaga ragrapa yacu uraj chaquicäcunmi.","poem":1},{"lineBreak":true},{"text":"Fiyupa shanaptinna ushajpaj chaquicäcun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yacuta ashir caminanticunapis juc-läpana purin.","poem":1},{"lineBreak":true},{"text":"Chaynöpami chunyajpa aywashpan wañun.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Temapita Sabäpita aypalla nigusyanticuna shamöga","poem":1},{"lineBreak":true},{"text":"chay yacu-mallwa aywajta tariyta yarpashpan ashin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ashir aywashanman chayarga fiyupa llaquicun.","poem":1},{"lineBreak":true},{"text":"‹Yacuta tarishun› nishanpis yangallami.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chaynömi gamcunapis nogapäga carcaycanqui:","poem":1},{"lineBreak":true},{"text":"Fiyupa melanaypaj caycashäta ricaycäramar mancharircaycanqui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Noga manami gamcunata imatapis mañacöchu.","poem":1},{"lineBreak":true},{"text":"Manami ‹salbamänayquipaj guellayta pägay› nëchu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Manami ‹chiquimajcunapita salbamay› nëchu.","poem":1},{"lineBreak":true},{"text":"Manami ‹suwacunapa maquinpita jorgamay› nëchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Yachachimay-llapa, chauraga mana rimacuypami chasquicushaj.","poem":1},{"lineBreak":true},{"text":"Tantiyachimay ima mana allita rurashätapis.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Rasun cajpitaga pipis manami ‹mana› ninchu.","poem":1},{"lineBreak":true},{"text":"Gamcunami ichanga manacajta jitapaycämanqui.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gamcunaga jamurpämanqui rimashäpitami.","poem":1},{"lineBreak":true},{"text":"Chay rimashäcunataga manacajmanmi churarcaycanqui.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Chayno car gamcunaga wacchata wañuchinanpaj nirpis ninquimanmi.","poem":1},{"lineBreak":true},{"text":"Cuyanacushayqui amïguyquitapis ranticuycunquimanmi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Masqui ricäramay.","poem":1},{"lineBreak":true},{"text":"Rasun cajtami niycä.","poem":1},{"lineBreak":true},{"text":"Manami llullacöchu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Sumaj yarpachacuy. Ama fiyuga caychu.","poem":1},{"lineBreak":true},{"text":"Rasun cajta niycashätaga sumaj tantiyacuy.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gamcunaga capas yarpanqui llullacuycashäta.","poem":1},{"lineBreak":true},{"text":"Capas ‹imata parlaycashantapis tagäga mana musyanchu› nircaycämanqui.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}