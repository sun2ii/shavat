{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOB","translationId":"qub_wbt","name":"JOB","commonName":"JOB","title":"Job","order":18,"numberOfChapters":42,"sha256":"e94a9bc819a6609e3c9c573d6718a1335dacdb058c062eafee3e14f7f3a5e240","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/qub_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"«Cay pachacho runaga rätullami cawan.","poem":1},{"lineBreak":true},{"text":"Arupacoj runa juc junaj arupacushannöllami goyan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rätulla goyan alläpa shanaptin uyway runa llantuta munajnöllami,","poem":1},{"lineBreak":true},{"text":"arupacoj pägunta shuyarajnöllami.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nogaga quillan-quillan yangallami cawashcä.","poem":1},{"lineBreak":true},{"text":"Waray-waray ñacashcä.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Puñuptëpis pachaga manami waraytapis atipanchu.","poem":1},{"lineBreak":true},{"text":"Ticrapacur-ticrapacur uticasha caycaptilläna pachapis yur'gämun.","poem":1},{"lineBreak":true},{"text":"Yarpachacö: ‹¿imayraj jatarishaj?› nir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cuerpöcunacho curu juntashami caycan, gueri chucrushantin.","poem":1},{"lineBreak":true},{"text":"Guerëpitapis pogrullami aywaycan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Caway-bïdäga päsarin tilar awajcuna lansadërata jitashannöllami.","poem":1},{"lineBreak":true},{"text":"Waquenga yarpashancunata manaraj tarirmi aywacunpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Yarpaycuy ari Tayta Dios, bïdäga jämay cachaynöllami.","poem":1},{"lineBreak":true},{"text":"Mananami imaypis cushishaga goyashänachu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mananami pipis ricamanganachu.","poem":1},{"lineBreak":true},{"text":"Noga cajman ricäramuptiquega jinan örami wañucäcushaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Imanömi pucutay jogaricar illgacäcun,","poem":1},{"lineBreak":true},{"text":"chaynömi caycan wañur pampacöga.","poem":1},{"lineBreak":true},{"text":"Sepultürapitaga manami imaypis jatarimonganachu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wasinmanpis mananami imaypis cutinnachu.","poem":1},{"lineBreak":true},{"text":"Famillyancunawanpis manami tincunnachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Chaymi upällallaga mana cacömanchu.","poem":1},{"lineBreak":true},{"text":"Nanaywan, rabyawan caycashpäga llapan llaquicuycashätami rimashaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Lamarcho caycaj manchacuypaj waräcuychu cä","poem":1},{"lineBreak":true},{"text":"imay örapis chayno ricaycämänayquipäga?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"‹Puñorga jamayta tarishämi.","poem":1},{"lineBreak":true},{"text":"Puñuycorga llaquicuypitapis jamacushämi› nir yarpä.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ichanga suyñuynëcho fiyupa mancharachimanqui.","poem":1},{"lineBreak":true},{"text":"¡Fiyucunatami suyñupäcachimanqui!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Llapiramaptiqui allimi canman.","poem":1},{"lineBreak":true},{"text":"Cawanäpa ruquenga juclla wañucurëman.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Manami awantänachu.","poem":1},{"lineBreak":true},{"text":"¿Imapänataj cawaycäshäpis?","poem":1},{"lineBreak":true},{"text":"Ama rimapämaypischu.","poem":1},{"lineBreak":true},{"text":"Caway-bïdaga jämay cachaynöllami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«¿Imataj runa chay-jinanpa ricapänayquipäga?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj runacunapäga yarpachacunqui?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¿Imanirtaj runataga waran-waran ricapanqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj cada rätu mayapaycämanquega?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¿Imanirtaj mana cachaypa ricapaycämanqui?","poem":1},{"lineBreak":true},{"text":"Togayllätapis mana ultarcachimanquichu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Juchata rurashpäga","poem":1},{"lineBreak":true},{"text":"¿ima mana allitataj ruraycä gam Tayta Dios runacunata cuydajpäga?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj lëchayquiwan apuntaraycämanqui?","poem":1},{"lineBreak":true},{"text":"Manami ‹cayta wacta rurapämay› nëchu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"¿Manachu juchäta perdunamanquiman?","poem":1},{"lineBreak":true},{"text":"¿Manachu mana allita rurashäta perdunamanquiman?","poem":1},{"lineBreak":true},{"text":"Manapis aycällatanami wañucushaj.","poem":1},{"lineBreak":true},{"text":"Ashimaptiquipis manami cashänachu.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}