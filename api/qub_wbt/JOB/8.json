r":6,"content":[{"lineBreak":true},{"text":"Juchata mana ruraypa alli cajllata ruraptiqui Tayta Diosga cuydashunquipämi.","poem":1},{"lineBreak":true},{"text":"Chauraga alli goyaytanami tarichishunquipaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ima-aycata charashayquipis manami tincongapächu","poem":1},{"lineBreak":true},{"text":"charänayquipaj caycajman tincurachiptiquega.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Unay caj runacuna imanöpis cawashanta mayacachay.","poem":1},{"lineBreak":true},{"text":"Unay runacuna imanöpis goyashanta yachacuy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Noganchëga ganyanllarämi yurishcanchïpis.","poem":1},{"lineBreak":true},{"text":"Manami imatapis musyanchïchu.","poem":1},{"lineBreak":true},{"text":"Llantuy päsarejnöllami päsarinchïpis.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Unay cajcunami ichanga willapäshunquiman.","poem":1},{"lineBreak":true},{"text":"Ima-aycatapis yachachishunquiman.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Totoraga gocha-gochacunallachömi wiñan ¿au?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaypis pipis mana rutuycaptillanmi","poem":1},{"lineBreak":true},{"text":"berdiraycashallancho chaquicäcun waquin guewapita mas ñaupata.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chaynöllami päsan fiyucunatapis, Tayta Diosta gongaycärejcunatapis.","poem":1},{"lineBreak":true},{"text":"Rurayta yarpashancunapis manami camacannachu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yäracur chapacuycashanga","poem":1},{"lineBreak":true},{"text":"pachcapa llicannöllami.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Llicanman charicuptinpis manami awantangachu.","poem":1},{"lineBreak":true},{"text":"Pachcapa wasinman tucnacuptin ushacäcojno ricaconga.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fiyucunaga caycan shanaycashan öra","poem":1},{"lineBreak":true},{"text":"intëru wertapa jacha mashtaraycajnömi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chay jachacunaga pergacunacho sapichan;","poem":1},{"lineBreak":true},{"text":"nircur wiñar lätarga llapan rumitami chapacurcun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chaycho caycajta pipis achuriptenga","poem":1},{"lineBreak":true},{"text":"manami pipis musyangachu chay pergacho cashanta.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chaynömi ushacan alliman chayashanpis.","poem":1},{"lineBreak":true},{"text":"Ruquenga wiñamun juc jachacunana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Alli runataga Tayta Dios manami gonganchu.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunatapis manami yanapanchu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tayta Diosmi camacächenga yapay asinayquipaj,","poem":1},{"lineBreak":true},{"text":"yapay cushicunayquipaj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chiquishojcunami ichanga pengaycho cangapaj.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunapa wasincunapis illgangami.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}