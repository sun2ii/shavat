a chüpacacunami juntaycusha llapanta micur ushacurcunanpaj.","poem":1},{"lineBreak":true},{"text":"Jatusaj chüpacacuna catushantaga acapa chucluscunami ushacurcusha.","poem":1},{"lineBreak":true},{"text":"Acapa chucluscunapita gueshpejllantapis malunyacunami micucurcusha.","poem":1},{"lineBreak":true},{"text":"Chaypita puchojllantapis shiuricunami ushacurcusha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Machasha puñuycajcuna ricchay.","poem":1},{"lineBreak":true},{"text":"Bïnu upojcuna wagayna.","poem":1},{"lineBreak":true},{"text":"Bïnuga manami cangapänachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chüpacacunaga munayniyoj aypalla suldärucunanömi nasyunnëman juntacaycamusha.","poem":1},{"lineBreak":true},{"text":"Chaycunapaga quiruncunapis agärancunapis liyuncunapanömi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Übascunatapis ushajpämi ushacurcusha.","poem":1},{"lineBreak":true},{"text":"Ïgus yöräcunatapis pasaypami ushasha.","poem":1},{"lineBreak":true},{"text":"Pasaypa tullullantami ruraycusha.","poem":1},{"lineBreak":true},{"text":"Rämancunatapis yur'gashatami cachaycusha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Runacunaga wagarcaycan majachacänanpaj caycaj mösu wañucäcuptin jipash wagaycashannömi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Cüracunapis wagarcaycan Templuman ofrendacuna manana chayaptinmi.","poem":1},{"lineBreak":true},{"text":"Chaqui micuy ni bïnupis manana captinmi Tayta Diospaj ofrendacunapis mana cannachu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chacracunapis gallpallanami caycan.","poem":1},{"lineBreak":true},{"text":"Llapan chacrami llaquisha caycan.","poem":1},{"lineBreak":true},{"text":"Rïgupis shuntananpaj manami cashanachu.","poem":1},{"lineBreak":true},{"text":"Übas yöra chaquiptin bïnupis manami cannachu.","poem":1},{"lineBreak":true},{"text":"Olivo yöracuna chaquiptin asëtipis manami cannachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gamcuna, chacracho arojcuna, übasta cusichajcuna,","poem":1},{"lineBreak":true},{"text":"llaquicushpayqui wagay-llapa.","poem":1},{"lineBreak":true},{"text":"Cananga llapan murushayquicunapis yangallapämi casha.","poem":1},{"lineBreak":true},{"text":"Manami wayushachu rïgupis ni sebädapis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Übascunapis chaquicäcushami.","poem":1},{"lineBreak":true},{"text":"Ïguscunapis manami wayushachu.","poem":1},{"lineBreak":true},{"text":"Granadacunapis, palmacunapis, mansänacunapis,","poem":1},{"lineBreak":true},{"text":"jircacho caj yöracunapis ushajpämi chaquisha.","poem":1},{"lineBreak":true},{"text":"Chaynöpami runacunapis mana cushicunnachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tayta Diospaj ofrendata churanayquipaj","poem":1},{"lineBreak":true},{"text":"chaqui micuypis ni bïnupis manami cannachu.","poem":1},{"lineBreak":true},{"text":"Chaymi Tayta Diosta sirbir altarcho aroj cüracuna,","poem":1},{"lineBreak":true},{"text":"llaquicushpayqui wagay, lütu car jaticunan röpacunata jaticuy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Llapan runacunata gayachir willay ayunananpaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diospa Templunman shuntay mayurcunata,","poem":1},{"lineBreak":true},{"text":"chay nasyuncho cajtaga llapan runacunatapis","poem":1},{"lineBreak":true},{"text":"llapayqui Tayta Diosta mañacunayquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"¡Ay imanöraj canga chay junaj!","poem":1},{"lineBreak":true},{"text":"Tayta Dios jusganan junäga chayaycämunnami.","poem":1},{"lineBreak":true},{"text":"Chay junäga canga fiyupa manchariypämi munayniyoj Tayta Dios castigaptin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ricapaycaptinchïmi micuyninchïtapis ushacurcusha.","poem":1},{"lineBreak":true},{"text":"Diosninchïpa Templuncho cushicuypis manami cannachu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Llapan murushanchïpis illgashami.","poem":1},{"lineBreak":true},{"text":"Rïgupis ushajpämi illgasha.","poem":1},{"lineBreak":true},{"text":"Cananga micuy churacunanchïpis wanwaraycanmi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Imanöshi wäcacunapis gaparpaycan.","poem":1},{"lineBreak":true},{"text":"Wäcacuna guewata ashirpis manami tarinchu.","poem":1},{"lineBreak":true},{"text":"Uyshacunapis yargaywanmi wañurcaycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tayta Dios, gammanmi gayacamö.","poem":1},{"lineBreak":true},{"text":"Ninami rupar ushacurcusha chunyajcho caj jachacunata,","poem":1},{"lineBreak":true},{"text":"jircacho caj guerucunatapis.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ragracunapa yacu aywajcuna chaquicäcuptin, guewata nina rupacurcuptin","poem":1},{"lineBreak":true},{"text":"asta chucaru animalcunapis gammanmi gayacaycämun.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}