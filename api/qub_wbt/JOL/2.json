{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JOL","translationId":"qub_wbt","name":"JOEL","commonName":"JOEL","title":"Joel","order":29,"numberOfChapters":3,"sha256":"7aba3b71ba6387ee02ba3263c12bd5eb5f8598e6df9b99c6c4f5215cbef4f19e","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/qub_wbt/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Chüpacacuna yurimunanpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"Sioncho trompëtata tucay-llapa.","poem":1},{"lineBreak":true},{"text":"Tayta Dios acrashan rispitädu jircacho willacachiy musyananpaj.","poem":1},{"lineBreak":true},{"text":"Judächo tiyaycajcunaga llapayqui manchariywan sicsicyay.","poem":1},{"lineBreak":true},{"text":"Tayta Dios jusganan junäga chayaycämunnami.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chay junäga canga yanauyaycaj chacaymi,","poem":1},{"lineBreak":true},{"text":"pucutay juntashami, gontaynöraj chacashami.","poem":1},{"lineBreak":true},{"text":"Pacha wararcuptin inti ratamur mashtarcojnömi","poem":1},{"lineBreak":true},{"text":"puntacunapapis chüpacacunaga aypalla munayniyoj suldärucunano juntacuyconga.","poem":1},{"lineBreak":true},{"text":"Chaynöga manami unay caranchu.","poem":1},{"lineBreak":true},{"text":"Chaynöga manami ni imaypis canganachu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chaycunaga caycan nina llapanta ushacurcojnömi.","poem":1},{"lineBreak":true},{"text":"Chaycunaga caycan nina rataycashanpita upiptin shanshallanna cawaycajnömi.","poem":1},{"lineBreak":true},{"text":"Chaycuna manaraj chayamuptenga cay pacha caran cuyayllapämi.","poem":1},{"lineBreak":true},{"text":"Aywacuptinnaga quëdasha chunyaj chaqui jircanömi.","poem":1},{"lineBreak":true},{"text":"Chaycunapitaga manami imapis gueshpinchu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chaycunaga caycan cawallucunanömi.","poem":1},{"lineBreak":true},{"text":"Cörriycunpis muntädu aywajcunanörämi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Puntapita juc puntaman pintishanpis wiyacan","poem":1},{"lineBreak":true},{"text":"pillyapaj carrëtacuna aywaptin wiyacashannörämi.","poem":1},{"lineBreak":true},{"text":"Wiyacaycanpis nina rupaptin chaqui öjacuna pashtashannörämi.","poem":1},{"lineBreak":true},{"text":"Chaycunaga carcaycan munayniyoj aypalla suldärucuna pillyaman aywaycajnömi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chayta ricar runacunaga fiyupa mancharin.","poem":1},{"lineBreak":true},{"text":"Cärancunapis pasaypami yur'gacäcun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Guërracho pillyayta mana manchaj runacunanömi carcaycan.","poem":1},{"lineBreak":true},{"text":"Fiyupami cörriycärinpis.","poem":1},{"lineBreak":true},{"text":"Pergacunapa wichacarcärin.","poem":1},{"lineBreak":true},{"text":"Aywanpis dirichaypami wacman ni caymanpis mana yagaypa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jucnin-jucninpis manami lluchcanacunchu.","poem":1},{"lineBreak":true},{"text":"Aywanpis aywarcaycashallanpami.","poem":1},{"lineBreak":true},{"text":"Espädawan cuchuptinpis","poem":1},{"lineBreak":true},{"text":"aywarcaycashan fïlanpitaga manami llojshinchu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Siudäman yaycucaycärin.","poem":1},{"lineBreak":true},{"text":"Perga janancunapapis cörricachan.","poem":1},{"lineBreak":true},{"text":"Wasicunamanpis wichacarcärin.","poem":1},{"lineBreak":true},{"text":"Bentänacunapapis suwacunanöraj yagacaycärin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Chaycuna chayamuptin cay pachapis","poem":1},{"lineBreak":true},{"text":"janaj pachapis manchariywan sicsicyanmi.","poem":1},{"lineBreak":true},{"text":"Intiwan quillapis chacacäcunmi.","poem":1},{"lineBreak":true},{"text":"Goyllarcunapis achicyaycashanpita manami achicyannachu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Suldäruncunapa ñaupancho Tayta Diosga","poem":1},{"lineBreak":true},{"text":"räyuno busnintami wiyacächin.","poem":1},{"lineBreak":true},{"text":"Paypa suldäruncunaga fiyupa aypallami.","poem":1},{"lineBreak":true},{"text":"Pay nishanta rurajcunaga yupaytapis mana atipaypämi.","poem":1},{"lineBreak":true},{"text":"¡Fiyupa manchariypämi canga Tayta Dios jusganan junäga!","poem":1},{"lineBreak":true},{"text":"¿Piräshi chaytaga awantaycunman?","poem":1}]},{"type":"heading","content":["Tayta Dios cuyapäcoj cashan"]},{"type":"verse","number":12,"content":["Cananga Tayta Dios caynömi nin:",{"text":"«Llapan shonguyquipa nogamanna yäracamuy-llapa.","poem":1},{"lineBreak":true},{"text":"¡Ayunashpayqui, wagashpayqui, llaquicushpayqui nogamanna cutimuy-llapa!»","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tayta Diostana wiyacuy.","poem":1},{"lineBreak":true},{"text":"Röpayquicunata rachinayquipa ruquenga llapan shonguyquipa arpinticuy.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga amatar allimi; fiyupa cuyapäcojmi;","poem":1},{"lineBreak":true},{"text":"pasinsacojmi; fiyupa cuyacojmi.","poem":1},{"lineBreak":true},{"text":"Arpinticuptenga castigananpaj caycashanchöpis manami castigannachu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gamcunataga capaschari Tayta Dios perdunashunquimanpis.","poem":1},{"lineBreak":true},{"text":"Capaschari bindisyuntapis goycushunquiman.","poem":1},{"lineBreak":true},{"text":"Bindisyunta goshunquiman chaqui micuy ofrendata, bïnutapis Tayta Diospaj apanayquipaj.","poem":1}]},{"type":"heading","content":["Tayta Diosta mañacunanpaj cashan"]},{"type":"verse","number":15,"content":[{"text":"Sión lömacho trompëtata tucay-llapa.","poem":1},{"lineBreak":true},{"text":"Llapan runacunata willay ayunananpaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Runacunata shuntay-llapa.","poem":1},{"lineBreak":true},{"text":"Paycunata limyuyächiy-llapa.","poem":1},{"lineBreak":true},{"text":"Auquincunata shuntay-llapa.","poem":1},{"lineBreak":true},{"text":"Wamracunata, asta iti chuchuycajcunatapis shuntay-llapa.","poem":1},{"lineBreak":true},{"text":"Chayraj ashinacushapis wasipita aywar shuntacächun.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Diosta sirbejcunapis llojshimuchun.","poem":1},{"lineBreak":true},{"text":"Paycunaga runsi altar ñaupanman ichichun.","poem":1},{"lineBreak":true},{"text":"Nircur wagashpan Tayta Diosta mañacuchun cayno nir:","poem":1},{"lineBreak":true},{"text":"«Tayta Dios, acrashayqui runacunataga perdunaycuy.","poem":1},{"lineBreak":true},{"text":"Gampa cajta pipis manacajman churanantaga ama munaycuychu.","poem":1},{"lineBreak":true},{"text":"Juc-lä nasyun runacuna munaynincho chararänantaga ama munaycuychu.","poem":1},{"lineBreak":true},{"text":"Ama camacaycachiychu paycuna acrashayqui runacunata","poem":1},{"lineBreak":true},{"text":"‹¿Maytaj chay Diosniqui?› ninantaga.»","poem":1}]},{"type":"heading","content":["Tayta Dios yapay allchacächinanpaj cashan"]},{"type":"verse","number":18,"content":["Chayrämi acrashan runacunata Tayta Diosga cuyaycashanta musyachenga. Paycunata cuyapashpan"]},{"type":"verse","number":19,"content":["nenga:",{"text":"«Gamcunapaj rïgupis, bïnupis, asëtipis yapay fiyupa aypalla cananpänami camacächishaj.","poem":1},{"lineBreak":true},{"text":"Chayrämi cushisha goyanquipaj.","poem":1},{"lineBreak":true},{"text":"Cananpita yapayga mananami camacächishäpänachu","poem":1},{"lineBreak":true},{"text":"mana yäracamajcuna gamcunata manacajman churashunayquita.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Micuyta ushaj chüpacacuna jana caj-läpita","poem":1},{"lineBreak":true},{"text":"aywamojtapis gamcunapitaga gargushämi.","poem":1},{"lineBreak":true},{"text":"Chayno gargurmi jitarishäpaj chunyajman.","poem":1},{"lineBreak":true},{"text":"Ñaupanta aywajcunatami shengaypa wañurachishaj Cachi lamarcho.","poem":1},{"lineBreak":true},{"text":"Guepanta aywajcunatana shengachishaj Mediterráneo lamarcho.","poem":1},{"lineBreak":true},{"text":"Wañur ismurmi fiyupa asyaricurenga.","poem":1},{"lineBreak":true},{"text":"Chaynömi almiraypajcunata ruraj-aywä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Cay pacha, fiyupa cushicuy. Ama manchacuychu.","poem":1},{"lineBreak":true},{"text":"Nogaga fiyupa almiraypajcunatami ruraj-aywä.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Jirca animalcuna ama manchacuychu.","poem":1},{"lineBreak":true},{"text":"Cananpitaga guewacuna berdiypa berdengami.","poem":1},{"lineBreak":true},{"text":"Yöracunapis wayonganami.","poem":1},{"lineBreak":true},{"text":"Ïguspis übaspis aypallatami wayonga.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Sioncho tiyajcuna, gamcunaga cushicuy-llapa.","poem":1},{"lineBreak":true},{"text":"Noga rurashäpita cushicuy.","poem":1},{"lineBreak":true},{"text":"Nogami tamyatapis tamyachipämushcä timpuncho.","poem":1},{"lineBreak":true},{"text":"Tamyachimushcä murupacuy wichanpis, micuy waytanan wichanpis.","poem":1},{"lineBreak":true},{"text":"Unay watacuna tamyachimushänömi tamyachimushcä.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Chaymi rïgupis alli wayonga.","poem":1},{"lineBreak":true},{"text":"Asëtipis bïnupis aypallami canga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«Päsaj watacunachöga cachamushä chüpacacuna micuyta ushashanpitami fiyupa ñacarayqui.","poem":1},{"lineBreak":true},{"text":"Gamcunapataga ima-aycayquitapis chüpacacunami ushacurcuran.","poem":1},{"lineBreak":true},{"text":"Chaycunaga llapanta illgächej suldärucunanömi usharan.","poem":1},{"lineBreak":true},{"text":"Chayno ushashanpitami canan gamcunataga cutichishayqui.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gamcunaga micusha upushami goyanquipaj.","poem":1},{"lineBreak":true},{"text":"Chaymi noga Tayta Diosniquita alabamanquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga ruranquipaj fiyupa almiraypajcunata gamcunapaj rurashäpitami.","poem":1},{"lineBreak":true},{"text":"Acrashä runacunaga mananami yapayga pengaycho cangapänachu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Israelcuna, gamcunami musyanquipaj","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosga gamcunawan caycashäta,","poem":1},{"lineBreak":true},{"text":"Noga japallä gamcunapa Tayta Diosniqui cashätapis.","poem":1},{"lineBreak":true},{"text":"Acrashä runacunaga mananami yapayga pengaycho cangapänachu.","poem":1}]},{"type":"heading","content":["Tayta Dios jusganan junaj chayamunanpaj cashan"]},{"type":"verse","number":28,"content":[{"text":"«Chaypitanaga llapan runacunamanmi Espiritöta cachamushäpaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami wamrayquicuna ollgupis warmipis ribilashäta willaconga.","poem":1},{"lineBreak":true},{"text":"Auquincunapis suyñonga imapis cananpaj cajcunata.","poem":1},{"lineBreak":true},{"text":"Mösucunapis ricapaconga shamoj watacunacho imanöpis cananpaj cajcunata.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Chay junajcunaga ollgu cajmanpis warmi cajmanpis uywayniquicunaman","poem":1},{"lineBreak":true},{"text":"Espiritötami cachamushaj.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Syëluchömi ricacächishaj imaypis mana ricashancunata.","poem":1},{"lineBreak":true},{"text":"Cay pachachönami ricacächishaj yawarta, ninata, goshtay jatariycajtano pucutayta.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Intimi chacaj ricacongapaj.","poem":1},{"lineBreak":true},{"text":"Quillanami yawarmanno ticracurengapaj.","poem":1},{"lineBreak":true},{"text":"Llapan chaycunaga canga Tayta Dios jusganan junaj manaraj chayamuptinmi.","poem":1},{"lineBreak":true},{"text":"Chay jusganan junäga cangapaj fiyupa manchariypaj junajmi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Chayno captinpis nogaman yäracamushpan mañacamaj cäga salbashami canga.","poem":1},{"lineBreak":true},{"text":"Sión lömacho, Jerusalenchömi acrashä cajcunaga salbacongapaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}