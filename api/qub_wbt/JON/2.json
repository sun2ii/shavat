{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"JON","translationId":"qub_wbt","name":"JONÁS","commonName":"JONÁS","title":"Jonás","order":32,"numberOfChapters":4,"sha256":"7967b11db7fa1282e638ea72cfc73052b32914a2e774e5e967d011c83ca44d08","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/qub_wbt/JON/4.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Diosta Jonás mañacushan"]},{"type":"verse","number":1,"content":["Chaymi Jonasga pescädupa pachancho caycashpan Tayta Diosta mañacuran."]},{"type":"verse","number":2,"content":["Mañacur cayno niran:",{"text":"«Fiyupa llaquisha caycashpämi gamman mañacamurä, Tayta Dios.","poem":1},{"lineBreak":true},{"text":"Gamnami yanapämarayqui.","poem":1},{"lineBreak":true},{"text":"Wañushanöna caycashpämi gamman mañacamurä.","poem":1},{"lineBreak":true},{"text":"Gamnami wiyamarayqui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lamarmanga mas jundunninmanmi garpumashcanqui.","poem":1},{"lineBreak":true},{"text":"Intëröpa yacullatami ricaycashcä.","poem":1},{"lineBreak":true},{"text":"Yacuga ruyrucarcur-ruyrucarcur janäpa päsasha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayrämi yarpärishcä läduyquipita jitarishana caycashäta;","poem":1},{"lineBreak":true},{"text":"rispitädu Templuyquitapis manana ricanäpaj cashanta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yacuwan tallucashami puriycashcä.","poem":1},{"lineBreak":true},{"text":"Aypalla yacumi intëru janäpa ñiticarcamaran.","poem":1},{"lineBreak":true},{"text":"Yacu rurincho caycaj jachacunapis pitucarcamaran.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pacha rurincamami chayashcä.","poem":1},{"lineBreak":true},{"text":"Chaychöga caycashcä imaypis mana llojshimojpäno chapacashana.","poem":1},{"lineBreak":true},{"text":"Gammi ichanga Tayta Diosnë, jatun uchcupita jorgamashpayqui","poem":1},{"lineBreak":true},{"text":"salbamashcanqui cawaycajllata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wañunäpaj caycashächönami","poem":1},{"lineBreak":true},{"text":"gampaj yarpärirä Tayta Dios.","poem":1},{"lineBreak":true},{"text":"Chayno mañacamushätami gamga wiyarayqui.","poem":1},{"lineBreak":true},{"text":"Chaynömi rispitädu Templuyquichöpis wiyamurayqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mana bälej ïdulucunata adurajcunaga","poem":1},{"lineBreak":true},{"text":"gamta gongaycushurayquimi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nogami ichanga charashäcunata gampaj churashpä alli shimëpa alabashayqui.","poem":1},{"lineBreak":true},{"text":"Aunishätaga llapantami cumlishaj.","poem":1},{"lineBreak":true},{"text":"¡Tayta Diosllami salbacöga!»","poem":1}]},{"type":"verse","number":10,"content":["Chayno nir ruwacuptin Tayta Diosga camacächiran Jonasta allpaman pescädu gumitaramunanpaj."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}