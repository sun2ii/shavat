{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"LAM","translationId":"qub_wbt","name":"LAMENTACIONES","commonName":"LAMENTACIONES","title":"Lamentaciones","order":25,"numberOfChapters":5,"sha256":"17b4c8c2cce6ad46a2f6d94fdc2cedd784fb5012411dc8c5ccdd2cc097898c77","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/qub_wbt/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["Rimir caj llaquicuy"]},{"type":"verse","number":1,"content":[{"text":"Ay Jerusalén, ñaupataga aypalla runami chaycho tiyaran.","poem":1},{"lineBreak":true},{"text":"Cananga imano chunyajshi ricacusha.","poem":1},{"lineBreak":true},{"text":"Ñaupataga sumaj rejsisha siudämi caran.","poem":1},{"lineBreak":true},{"text":"Cananga biyüda warminömi caycan.","poem":1},{"lineBreak":true},{"text":"Achca siudäcunapa raynannömi caran.","poem":1},{"lineBreak":true},{"text":"Cananga quiquinnami chay nasyuncunapa uywaynin caycan.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Chacaycuna fiyupa llaquicushpan icchushanyajmi wagaycan.","poem":1},{"lineBreak":true},{"text":"Cärancunapapis yacunörämi weguin jutuycan.","poem":1},{"lineBreak":true},{"text":"«Cuyämi» nir gatirajcunaga manami maygallanpis canchu shogananpaj.","poem":1},{"lineBreak":true},{"text":"Llapan yanasancuna ticraparmi chiquicarcärisha.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Judá runacunataga juc-lämanmi prësu apasha.","poem":1},{"lineBreak":true},{"text":"Chaychönami sasa aruycunacho aruchir, fiyupa ñacarcaycächin.","poem":1},{"lineBreak":true},{"text":"Ñaupata paycunaga llapanpa mandajninmi caran.","poem":1},{"lineBreak":true},{"text":"Cananga mananami jamaytapis tarichinnachu.","poem":1},{"lineBreak":true},{"text":"Gaticachajcunaga chariycurmi","poem":1},{"lineBreak":true},{"text":"llaquicachir fiyupa ñacarcaycächin.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Sión lömaman aywaj caminucunaga fiyupa llaquicuypaj chunyajmi ricacusha.","poem":1},{"lineBreak":true},{"text":"Fistacunamanpis mananami pipis shamunnachu.","poem":1},{"lineBreak":true},{"text":"Siudäman yaycuna puncupis pasaypa chunyajmi caycan.","poem":1},{"lineBreak":true},{"text":"Siudächöga cüracunallami wagaycan.","poem":1},{"lineBreak":true},{"text":"Jipashcunapis fiyupa llaquicurcaycan.","poem":1},{"lineBreak":true},{"text":"Quiquin siudäpis fiyupami llaquicuycan.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Chiquejcunanami munaynincho chararaycan.","poem":1},{"lineBreak":true},{"text":"Contrancunaga mas allimannami chayasha.","poem":1},{"lineBreak":true},{"text":"Jerusalencunataga achca juchata rurashanpitami Tayta Dios ñacaycächin.","poem":1},{"lineBreak":true},{"text":"Wamrancunatapis chiquejcunami prësu apasha.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Jerusalenpaga illgashami cuyayllapaj cayninpis.","poem":1},{"lineBreak":true},{"text":"Mandajnincunapis, lluychu guewata ashejnömi purircaycan.","poem":1},{"lineBreak":true},{"text":"Balurninpis mana captinmi","poem":1},{"lineBreak":true},{"text":"chaquintapis garchayllapa aywarcaycan gaticachajcunapa ñaupanta.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Jerusalenga yarpärin japallan, llaquisha quëdashanta.","poem":1},{"lineBreak":true},{"text":"Yarpärin ima-aycatapis fiyupa aypallata charashanta.","poem":1},{"lineBreak":true},{"text":"Yarpärin chiquejcunapa munayninman chayashanta,","poem":1},{"lineBreak":true},{"text":"chay öra pipis mana yanapashanta.","poem":1},{"lineBreak":true},{"text":"Chiquejcuna chayta ricashpan asiparan","poem":1},{"lineBreak":true},{"text":"mana alliman chayashanpita.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Jerusalenga fiyupami juchata rurasha.","poem":1},{"lineBreak":true},{"text":"Chaynöpami pï-maypis manacajman churasha.","poem":1},{"lineBreak":true},{"text":"Ñaupata rispitajcuna, cananga manacajmanmi churarcaycan disigrasyaman chayashanta ricashpan.","poem":1},{"lineBreak":true},{"text":"Chaypitami payga wagaycan.","poem":1},{"lineBreak":true},{"text":"Pengacuyllawanmi ticracurcusha.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Juchata rurashpanmi röpantapis ganrachisha caycan.","poem":1},{"lineBreak":true},{"text":"Manami yarpachacuranchu imaman chayananpaj cashantapis.","poem":1},{"lineBreak":true},{"text":"Mana riguiypämi mana alliman chayasha.","poem":1},{"lineBreak":true},{"text":"Pipis manami canchu cuyapar shogananpaj.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, ricäramay ari fiyupa llaquicuycashäta.","poem":1},{"lineBreak":true},{"text":"Chiquimajcunanami alliman chayasha.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Jerusalenpa ima-aycantapis chiquejcunami apacusha.","poem":1},{"lineBreak":true},{"text":"Siudächo tiyajcunaga ricashami","poem":1},{"lineBreak":true},{"text":"Diosta mana rispitajcuna callpaycur Templuman yaycojta.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, gamga chay runacunapaj nirayqui Templuyquiman mana yaycunanpämi.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Jerusalencho tiyaj runacunaga llapanmi wagarcaycan.","poem":1},{"lineBreak":true},{"text":"Micuyta ashirmi purircaycan.","poem":1},{"lineBreak":true},{"text":"Micur cawananpämi micuywan rucaycärisha ima-aycantapis.","poem":1},{"lineBreak":true},{"text":"Paycunaga wagashpan Tayta Diosta ruwacuycan:","poem":1},{"lineBreak":true},{"text":"«Mana alliman chayasha caycajtaga ricäramay.","poem":1},{"lineBreak":true},{"text":"Disigrasyaman chayasha caycajta cuyapaycamay ari.»","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Jerusalén siudänami nin:","poem":1},{"lineBreak":true},{"text":"«Gamcuna, caminunpa purejcuna,","poem":1},{"lineBreak":true},{"text":"ichiycäriy sumaj yarpachacunayquipaj.","poem":1},{"lineBreak":true},{"text":"¿Pillaga ñacaycanchuraj noga fiyupa ñacaycashäno?","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi rabyacurcushpan camacächisha cayno ñacanäpaj.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"«Paymi janajpita-pacha ninata cachamusha tullöcama ruparamänanpaj.","poem":1},{"lineBreak":true},{"text":"Purinäman chapata churapämasha.","poem":1},{"lineBreak":true},{"text":"Chaymi guepaman cutichimasha.","poem":1},{"lineBreak":true},{"text":"Japallätami cachaycamasha.","poem":1},{"lineBreak":true},{"text":"Cananga ñacayllachömi caycä.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"«Juchäcunaga yügunömi lasaycäman.","poem":1},{"lineBreak":true},{"text":"Quiquin Tayta Diosmi watarcamasha.","poem":1},{"lineBreak":true},{"text":"Callpäpis ushacaycannami.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga cachaycamasha","poem":1},{"lineBreak":true},{"text":"ichipayta mana puydishä runacunapa munayninmanmi.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"«Tayta Diosga yagarachisha washämaj jinyu runacunata.","poem":1},{"lineBreak":true},{"text":"Paymi cachamusha magamänanpaj jäpa suldärucunatana,","poem":1},{"lineBreak":true},{"text":"paycuna nogapa jinyu suldäröcunata wañuchinanpaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga llapiramasha juc runa bïnupaj übasta gapchirishannömi.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"«Chaypitami fiyupa wagaycä.","poem":1},{"lineBreak":true},{"text":"Ñawëchöpis weguillami juntasha caycan.","poem":1},{"lineBreak":true},{"text":"Nogata shogamäga manami pipis canchu.","poem":1},{"lineBreak":true},{"text":"Manami canchu yanapämänanpäpis.","poem":1},{"lineBreak":true},{"text":"Wamräcunataga ushajpämi illgächisha.","poem":1},{"lineBreak":true},{"text":"Chiquimajcunami binsiycamashpan wañuchisha.»","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Sionga maquintapis chojpacur-rämi mañacuycan.","poem":1},{"lineBreak":true},{"text":"Ichanga manami pipis canchu shogananpaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi camacächisha chiquejcuna Jacobta curalapaycärinanpaj.","poem":1},{"lineBreak":true},{"text":"Chiquejcunapäga Jerusalén caycan mana sirbejmi.","poem":1}]},{"type":"verse","number":18,"content":[{"text":"Jerusalén nin: «Tayta Diosga rasun cajtami rurasha","poem":1},{"lineBreak":true},{"text":"pay nimashanta mana wiyacushäpita.","poem":1},{"lineBreak":true},{"text":"Marcacuna wiyamay-llapa.","poem":1},{"lineBreak":true},{"text":"Ricamay-llapa imano nanächicuycajtapis.","poem":1},{"lineBreak":true},{"text":"Nogapitaga mösucunata jipashcunatapis prësumi apacusha.","poem":1}]},{"type":"verse","number":19,"content":[{"text":"«Yanasä caj nasyuncunatami yanapämänanpaj ruwacurä.","poem":1},{"lineBreak":true},{"text":"Nishä paycunaga ticrapamashami.","poem":1},{"lineBreak":true},{"text":"Cüracuna, auquincuna jinan siudällacho wañusha","poem":1},{"lineBreak":true},{"text":"cawananpaj micuyta ashir purircaycashancho.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"«Tayta Dios, fiyupa llaquicuycashäta ricäramay ari.","poem":1},{"lineBreak":true},{"text":"Shongöpis fiyupami tic-ticyaycan.","poem":1},{"lineBreak":true},{"text":"Pasaypa mana wiyacoj cashäta yarpäriptëga","poem":1},{"lineBreak":true},{"text":"shongöpis fiyupami nanacuycun.","poem":1},{"lineBreak":true},{"text":"Jawachöga wamräcunatami sabliwan wañuycächin.","poem":1},{"lineBreak":true},{"text":"Cay rurichöpis wañuyga caycanmi.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"«Runacunaga wiyaycanmi llaquicur wagaycashäta.","poem":1},{"lineBreak":true},{"text":"Ichanga shogamänanpaj manami pipis canchu.","poem":1},{"lineBreak":true},{"text":"Llapan chiquimajcunami musyaycan mana allicho caycashäta.","poem":1},{"lineBreak":true},{"text":"Paycunami cushicurcaycan gam chayno castigamashayquipita.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, nogata castigaycämashayquino paycunatapis castigayna ari.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"«Paycuna mana allita rurashancunatapis","poem":1},{"lineBreak":true},{"text":"llapanta ricaycuy ari.","poem":1},{"lineBreak":true},{"text":"Juchata rurashancunapitaga castigaycuy","poem":1},{"lineBreak":true},{"text":"nogata castigamashayquino.","poem":1},{"lineBreak":true},{"text":"Alläpanami wagaycä.","poem":1},{"lineBreak":true},{"text":"Shongöpis nanaycanmi.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}