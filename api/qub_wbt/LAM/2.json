{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"LAM","translationId":"qub_wbt","name":"LAMENTACIONES","commonName":"LAMENTACIONES","title":"Lamentaciones","order":25,"numberOfChapters":5,"sha256":"17b4c8c2cce6ad46a2f6d94fdc2cedd784fb5012411dc8c5ccdd2cc097898c77","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/qub_wbt/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["Ishcay caj llaquicuy"]},{"type":"verse","number":1,"content":[{"text":"Tayta Diosga fiyupami rabyacurcusha casha.","poem":1},{"lineBreak":true},{"text":"Chaymi cuyayllapaj Siontapis yanamaypa chapacurcuran.","poem":1},{"lineBreak":true},{"text":"Syëlupitami illgarachimusha Israelcho mas cuyayllapaj caj siudätaga.","poem":1},{"lineBreak":true},{"text":"Rabyasha caycashan öraga manami yarpärishachu chaquin lluchcaränan Templutapis.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Tayta Diosga manami ni jucnayllatapis cachaycushachu ichiraycajta Jacob famillyapa wasincunataga.","poem":1},{"lineBreak":true},{"text":"Rabyasha caycashan öra illgarachiran Judäpa sumaj curalasha caycaj siudänincunatapis.","poem":1},{"lineBreak":true},{"text":"Mandajcunatapis manacajman churasha.","poem":1},{"lineBreak":true},{"text":"Waquin mandäshejcunatapis manacajman churasha.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Fiyupa rabyacurcorga Israel munayniyoj caycajta","poem":1},{"lineBreak":true},{"text":"juc maquillachömi illgarachisha.","poem":1},{"lineBreak":true},{"text":"Chiquimajninchïwan pillyaycashapis payga mananami yanapämashcanchïchu.","poem":1},{"lineBreak":true},{"text":"Israelchöga ninatami ratarcachisha.","poem":1},{"lineBreak":true},{"text":"Chay ninami tarishan cajta llapanta rupar ushaycan.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Tayta Diosga chiquimajninchïnöpis","poem":1},{"lineBreak":true},{"text":"callpaycurmi lëchata chutasha jitananpaj.","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj alli cajcunataga contranchïnömi ushajpaj illgarachisha.","poem":1},{"lineBreak":true},{"text":"Rabyashanga casha ninanömi.","poem":1},{"lineBreak":true},{"text":"Chayno rabyarmi usharamashcanchi.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Tayta Diosga chiquimajninchïnömi ruramashcanchi:","poem":1},{"lineBreak":true},{"text":"Israeltaga ushajpämi illgarachisha.","poem":1},{"lineBreak":true},{"text":"Palasyucunatapis ushajpämi juchurachisha.","poem":1},{"lineBreak":true},{"text":"Sumaj curalasha siudänincunatapis juchuchisha.","poem":1},{"lineBreak":true},{"text":"Judäpa cuyayllapaj siudäninmanga","poem":1},{"lineBreak":true},{"text":"jananman-jananman llaquicuyllatami chayaycächin.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Chucllata usharejnömi Tayta Diosga Templunta usharisha.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi camacächisha","poem":1},{"lineBreak":true},{"text":"fistacunata, säbadu jamay junajcunatapis Sioncho gongaycärinanpäna.","poem":1},{"lineBreak":true},{"text":"Fiyupa rabyacurcushpanmi camacächisha raypis ni cürapis manana cananpaj.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Tayta Diosga Templunta manami ricaytapis munannachu.","poem":1},{"lineBreak":true},{"text":"Altarnintapis manacajmannami churasha.","poem":1},{"lineBreak":true},{"text":"Chiquejcunapa munayninmanmi cachaycusha siudäta curalaraj pergacunatapis.","poem":1},{"lineBreak":true},{"text":"Nircur Tayta Diospa Templunchöga fistacho caycaj-jinaraj talluypa-tallur gaparpaycan.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Quiquin Tayta Diosmi camacächisha cuyayllapaj Sión siudäta curalaraycaj pergan juchuchisha cananpäpis.","poem":1},{"lineBreak":true},{"text":"Paymi camacächisha imano illgächinanpäpis.","poem":1},{"lineBreak":true},{"text":"Mana cuyapaypami ushajpaj illgächisha.","poem":1},{"lineBreak":true},{"text":"Pergancunata paymi juchuchisha.","poem":1},{"lineBreak":true},{"text":"Cananga muntuy-muntuyllanami goturpaycan.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Siudäpaga mananami cannachu puncuncuna, ni rancancunapis.","poem":1},{"lineBreak":true},{"text":"Paquir-ushashami intëru pampacho mashtaraycan.","poem":1},{"lineBreak":true},{"text":"Raytapis gobernadorcunatapis juc-lä nasyuncunamanmi apacusha.","poem":1},{"lineBreak":true},{"text":"Tayta Diospa layninpis manami cannachu.","poem":1},{"lineBreak":true},{"text":"Profëtacunatapis Tayta Diosga mananami musyachinnachu.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Cuyayllapaj Sión siudächo caj rispitädu auquincunapis upällallami pampacho jamarpaycan.","poem":1},{"lineBreak":true},{"text":"Llaquicurmi umancunaman allpata wiñacurcaycan, gachga röpacunata jaticurcaycan.","poem":1},{"lineBreak":true},{"text":"Jerusalén jipashcunaga pengay-tucushpanmi uysurpaycan.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Wagaycaptillämi ñawëpis chacaycanna.","poem":1},{"lineBreak":true},{"text":"Mayaptë pëchöpis rachicäcojnöraj caycan.","poem":1},{"lineBreak":true},{"text":"Marca-masëcuna tiyashan siudä illgashata ricashcä.","poem":1},{"lineBreak":true},{"text":"Chuchuycaj wamracunapis cällicunacho yargaypita wañuycajtami ricashcä.","poem":1},{"lineBreak":true},{"text":"Chaymi balurnëpis manana cannachu.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Pishi wamracunami mamanta nircaycaran:","poem":1},{"lineBreak":true},{"text":"«Fiyupami yargaycä mama.»","poem":1},{"lineBreak":true},{"text":"Chayno nircur siudäpa cällincunacho wañoj.","poem":1},{"lineBreak":true},{"text":"Mamanpa mellgaynincunacho wañucäcoj.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Cuyayllapaj Jerusalén, ¿imamanraj o imawanraj gamta tincuchëman?","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj Sión siudä, ¿gamta imaman tincuchiyparaj willapäman shoganäpaj?","poem":1},{"lineBreak":true},{"text":"Gamtaga fiyupami mana allicuna chayashurayqui.","poem":1},{"lineBreak":true},{"text":"Cananga ¿piraj allchacächishunquiman?","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Profëtayquicuna willashushayquega manami rasunpachu caran.","poem":1},{"lineBreak":true},{"text":"Juchayoj cashayquita paycunaga manami willashurayquichu.","poem":1},{"lineBreak":true},{"text":"Willashuptiquega canan manami prësu aywanquimanchu caran.","poem":1},{"lineBreak":true},{"text":"Llutanta willapäshushpayquimi gamcunataga riguichishurayqui.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Näninpa päsajcunaga","poem":1},{"lineBreak":true},{"text":"cushipäshushpayqui maquintapis macshunraj.","poem":1},{"lineBreak":true},{"text":"Manacajman churashushpayqui umantapis awinraj.","poem":1},{"lineBreak":true},{"text":"Jerusalén, gampäga caynömi nin:","poem":1},{"lineBreak":true},{"text":"«¿Tagaychi caycan ‹intëru munducho caj siudäcunapita","poem":1},{"lineBreak":true},{"text":"mas cuyayllapaj› nishan siudä?» nir.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Llapan chiquishojcunami washayquita parlan.","poem":1},{"lineBreak":true},{"text":"Wichyacachashpan, jamurpäshushpayqui cayno nin:","poem":1},{"lineBreak":true},{"text":"«Ushajpämi illgächishcanchi.","poem":1},{"lineBreak":true},{"text":"Chayno canantami munaranchïpis.","poem":1},{"lineBreak":true},{"text":"Cananga ¿manachu ricanchi?» nir.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Tayta Diosga yarpashancunata llapantami camacächisha.","poem":1},{"lineBreak":true},{"text":"Imano canayquipäpis nishantaga cumlishami.","poem":1},{"lineBreak":true},{"text":"Mana cuyapaypami illgächishurayqui ñaupatana yarpashanno.","poem":1},{"lineBreak":true},{"text":"Chiquishojcuna asipäshunayquipämi camacächisha.","poem":1},{"lineBreak":true},{"text":"Contrayquicuna fiyupa munayniyoj cananpämi camacächisha.","poem":1}]},{"type":"verse","number":18,"content":[{"text":"Cuyayllapaj Sión, Tayta Dios yanapäshunayquipaj mañacuy.","poem":1},{"lineBreak":true},{"text":"Chacaypa junajpapis weguiquega yacunöraj aywaypa aywachun.","poem":1},{"lineBreak":true},{"text":"Mana chawaypa wagay.","poem":1}]},{"type":"verse","number":19,"content":[{"text":"Chacaycunapapis jatarcur waray-waray gaparay.","poem":1},{"lineBreak":true},{"text":"Llapan llaquicuycashayquipita Tayta Diosta willapay, wagapay.","poem":1},{"lineBreak":true},{"text":"Mañacushpayqui maquiquitapis chojpacuy.","poem":1},{"lineBreak":true},{"text":"Ruwacuy yargaypita wamrayquicuna mana wañunanpaj.","poem":1},{"lineBreak":true},{"text":"Micunanpaj imapis mana captinmi wamrayquicunaga cällicunachöpis wañurcaycan.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Jerusalennami nin: «Tayta Dios, masqui ricay","poem":1},{"lineBreak":true},{"text":"nogacunata imano päsaycämashantapis.","poem":1},{"lineBreak":true},{"text":"Chuchuycashan wamrancunatami warmicuna micucarcärin.","poem":1},{"lineBreak":true},{"text":"Cüracunatawan profëtacunatapis Templuchömi wañuchin.","poem":1},{"lineBreak":true},{"text":"¿Pillataga chayno rurashcanquichuraj?","poem":1}]},{"type":"verse","number":21,"content":[{"text":"«Wamracunapis, auquincunapis cällicunachömi wañusha mashtarpaycan.","poem":1},{"lineBreak":true},{"text":"Mösucunapis, jipashcunapis cuchuypami wañusha.","poem":1},{"lineBreak":true},{"text":"Rabyasha caycashayqui örami wañuchishcanqui.","poem":1},{"lineBreak":true},{"text":"Mana cuyapaypami wañuchishcanqui.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"«Gammi camacächishcanqui wacpita caypita mana allicuna chayamunanpaj.","poem":1},{"lineBreak":true},{"text":"Fistaman runa aywajnörämi tucuy-niraj mana allicuna chayamasha.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, rabyasha caycashayqui öraga manami pipis gueshpishachu.","poem":1},{"lineBreak":true},{"text":"Noga uywashäta yachachishätaga chiquimajcunami wañuycachisha.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}