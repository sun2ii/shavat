{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"LAM","translationId":"qub_wbt","name":"LAMENTACIONES","commonName":"LAMENTACIONES","title":"Lamentaciones","order":25,"numberOfChapters":5,"sha256":"17b4c8c2cce6ad46a2f6d94fdc2cedd784fb5012411dc8c5ccdd2cc097898c77","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/qub_wbt/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["Chuscu caj llaquicuy"]},{"type":"verse","number":1,"content":[{"text":"Imanöshi Templucho caj aläjacuna intëru isquïnacho mashtarpaycan.","poem":1},{"lineBreak":true},{"text":"Goripis chegrayacäcushami.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Sión runacuna unayga caran alli rispitashami.","poem":1},{"lineBreak":true},{"text":"Fiyupa cuestaj goripitapis mas alli ricashami caran.","poem":1},{"lineBreak":true},{"text":"Cananga pï-maypis rican mana yachaj runa allpa mancata rurashantanöllana.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Asta atojcunapis wawantaga chuchunmi.","poem":1},{"lineBreak":true},{"text":"Täpayllapami uywanpis.","poem":1},{"lineBreak":true},{"text":"Marcächo tiyaj warmicunami ichanga wamrancunapaj rabyacurcusha.","poem":1},{"lineBreak":true},{"text":"Chunyajcho tiyaj avestruz äbi wawanpaj fiyu cashannömi ricacusha.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Chuchuycaj wamracunaga fiyupami yacunaycan.","poem":1},{"lineBreak":true},{"text":"Yacunaywan shimin chaquiycaptillannami gallunpis palacarninman lagacäcun.","poem":1},{"lineBreak":true},{"text":"Wamracunaga micuyta mañacun.","poem":1},{"lineBreak":true},{"text":"Ichanga manami pipis canchu paycunata imallatapis yawaycachinanpaj.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Ñaupata achca micuyniyoj cajcuna","poem":1},{"lineBreak":true},{"text":"cananga yargaypita cällicunacho wañurcaycan.","poem":1},{"lineBreak":true},{"text":"Alli wasicho wiñajcuna","poem":1},{"lineBreak":true},{"text":"cananga ganracuna goturaycashanchömi tiyarcaycan.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Marca-masëcuna tiyarcaycashan Jerusalencho juchata","poem":1},{"lineBreak":true},{"text":"rurashanga caycan Sodomacuna juchata rurashanpita mas piyurmi.","poem":1},{"lineBreak":true},{"text":"Sodomaga illajpitami illgaran pipis mana juchuycächiptillan.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Mandaj runacunaga caran rashtapita, lëchipitapis mas yurajrämi.","poem":1},{"lineBreak":true},{"text":"Cuerpuncunapis pucaypa-pucaycaran.","poem":1},{"lineBreak":true},{"text":"Cäranpis gueshpi ruminörämi caran.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Cananga mancapa siquinno pasaypa yanayashami caycan.","poem":1},{"lineBreak":true},{"text":"Cällichöpis manami pipis rejsinmannachu.","poem":1},{"lineBreak":true},{"text":"Yantano pasaypa chaquisha garan tullullannami caycan.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Pillyacho wañojcunaga allipämi wañucuran canan yargaywan wañunanpitaga.","poem":1},{"lineBreak":true},{"text":"Yargaywanga micuy mana wayuptin cuyapaypaj ñacar-rämi wañusha.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Marca-masëcuna tiyashan siudäta illgächiptenga quiquinpa wamrancunami micuyninpis casha.","poem":1},{"lineBreak":true},{"text":"Cuyapäcoj alli warmicunami wamrancunata yanucarcärisha.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Tayta Diosga fiyupa rabyasha caycashantami pascacächisha.","poem":1},{"lineBreak":true},{"text":"Fiyupa rabyasha cashpanmi castigasha.","poem":1},{"lineBreak":true},{"text":"Siontaga ninata sindipaycuran.","poem":1},{"lineBreak":true},{"text":"Chauraga simintuntinta rupar ushacurcuran.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Cay pachacho caycaj raycuna,","poem":1},{"lineBreak":true},{"text":"ni pï runapis cay munduchöga manami imaypis riguinmanchu caran","poem":1},{"lineBreak":true},{"text":"chiquimajcuna Jerusalenta charicurcunantaga.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Chaynöga llapanpis casha profëtacuna juchata rurashanpitami, cüracuna fiyupa mana allita rurashanpitami.","poem":1},{"lineBreak":true},{"text":"Paycunaga jinan siudächömi alli runacunata wañuchishpan yawarninta mashtaran.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Chaypitami cällicunapapis puriycan gaprano, mayman chayaytapis mana musyashpan.","poem":1},{"lineBreak":true},{"text":"Yawarpita mana cawaj captinmi pipis mana yatayllapis yataycuyta munanchu.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"«¡Witicuy-llapa! ¡Chaycunaga ganra runacunami caycan!» nir gayarpan.","poem":1},{"lineBreak":true},{"text":"«Guella puricachaj runacunami.","poem":1},{"lineBreak":true},{"text":"Amana caychöga tiyachunnachu» ninmi Diosta mana rispitajcunaga.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Tayta Dios rabyacurcushpanmi wacpa caypa mashtacächisha.","poem":1},{"lineBreak":true},{"text":"Nircur mananami imaypis ricärishanachu.","poem":1},{"lineBreak":true},{"text":"Chaymi runacunaga cüracunata mana rispitashanachu.","poem":1},{"lineBreak":true},{"text":"Auquincunatapis manami cuyapashanachu.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Yanapämänanchïpaj yarpashpanchïmi shuyaraycanchi mana salbamänanchïpaj caj nasyunta.","poem":1},{"lineBreak":true},{"text":"Shuyarar ricchacuycashallanami ñawinchïpis uticasha.","poem":1}]},{"type":"verse","number":18,"content":[{"text":"Chiquimajcunaga ricaparcaycämanmi.","poem":1},{"lineBreak":true},{"text":"Manami cällicunaman llojshiyllatapis puydëcunachu.","poem":1},{"lineBreak":true},{"text":"Ushacänanchïpäpis wallcanami pishin.","poem":1},{"lineBreak":true},{"text":"Ushacänanchïpaj caj öra chayaycämunnami.","poem":1}]},{"type":"verse","number":19,"content":[{"text":"Nogacunata gaticachämajcunaga","poem":1},{"lineBreak":true},{"text":"ancacunapitapis mas fiyupa aywajmi.","poem":1},{"lineBreak":true},{"text":"Jircacunapami gaticacharcaycäman.","poem":1},{"lineBreak":true},{"text":"Chunyaj chaqui jircachöpis shuyarpaycämanmi.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Tayta Dios acrashan raytapis prësumi charisha.","poem":1},{"lineBreak":true},{"text":"Paymi noganchïtaga cawaycächimaranchi.","poem":1},{"lineBreak":true},{"text":"Chay raypämi nogacuna nej cä:","poem":1},{"lineBreak":true},{"text":"«Paypa munayninchömi tiyashun nasyuncunapa chaupincho» nir.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Uz particho caj Edom nasyun runacuna mä cushicuy ari.","poem":1},{"lineBreak":true},{"text":"Gamcuna cajmanpis castïgu chayamongapämi.","poem":1},{"lineBreak":true},{"text":"Chauraga macharcur garapächulla cashannömi pengaypaj ricacunquipaj.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"Sión, castïguyqui cumplishanami.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga mananami imaypis jitarishunquipänachu.","poem":1},{"lineBreak":true},{"text":"Edom runacuna, gamcunatami ichanga mana allita rurashayquipita castigashunquipaj.","poem":1},{"lineBreak":true},{"text":"Nircur juchayquicunata pï-maytapis musyachengami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}