{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"MIC","translationId":"qub_wbt","name":"MIQUEAS","commonName":"MIQUEAS","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e8789e5a74529ce7de8cad8f97c9616bc3cd321a2db6d84c1e45bb6ed8740a30","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/qub_wbt/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"heading","content":["Samaria runacunata Tayta Dios jusgananpaj cashan"]},{"type":"verse","number":1,"content":["Miqueas tiyaran Moreset marcacho. Paytami Tayta Dios willaparan Samaria, Jerusalén siudäcuna imano cananpaj cashantapis. Chayga caran Jotam, Acaz, Ezequías Judächo ray cashan wichanmi."]},{"type":"verse","number":2,"content":["Tayta Dios rimachiptin Miqueas cayno niran:",{"text":"«Llapaniqui runacuna wiyay.","poem":1},{"lineBreak":true},{"text":"Intëru nasyuncho tiyajcuna wiyashpayqui sumaj tantiyacuy-llapa.","poem":1},{"lineBreak":true},{"text":"Munayniyoj Tayta Diosmi rispitädu Templunpita-pacha","poem":1},{"lineBreak":true},{"text":"nishunquipaj juchata rurashayquicunata.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diosga tiyaycashan cajpitami llojshimonga.","poem":1},{"lineBreak":true},{"text":"Nircorga puntallanpami shamonga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pay lluchcashan cäga","poem":1},{"lineBreak":true},{"text":"puntacunapis chullucäconga","poem":1},{"lineBreak":true},{"text":"ninaman sërata churaycuptin chullucäcojnömi.","poem":1},{"lineBreak":true},{"text":"Guechwa pampacunapis","poem":1},{"lineBreak":true},{"text":"aypalla yacu aywar ragrarishannömi ragracäconga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chayno canga Jacobpita miraj Israelcuna mana wiyacoj cashanpitami,","poem":1},{"lineBreak":true},{"text":"juchata rurashanpitami.","poem":1},{"lineBreak":true},{"text":"¿Maychötaj caycan Jacobpita miraj Israelcuna jucha rurashanga?","poem":1},{"lineBreak":true},{"text":"¡Jucha rurashanga Samariachömi caycan!","poem":1},{"lineBreak":true},{"text":"¿Maychötaj caycan Judäpita mirajcuna jucha rurashanga?","poem":1},{"lineBreak":true},{"text":"¡Jucha rurashanga Jerusalenchömi caycan!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Chaypitami Tayta Diosga cayno nin:","poem":1},{"lineBreak":true},{"text":"«Samaria siudä ushajpaj juchunanpämi camacächishaj.","poem":1},{"lineBreak":true},{"text":"Übasta lantananpaj yapyasha caycaj chacranömi ricaconga.","poem":1},{"lineBreak":true},{"text":"Chay siudäpa perga rumincunatapis guechwa ragrapami mashtarishaj.","poem":1},{"lineBreak":true},{"text":"Chayno rurariptë simintuncuna cashanpis alayrimi quëdanga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rispitar adurashan ïduluncunatapis ruparachishaj, agullarishaj.","poem":1},{"lineBreak":true},{"text":"Chaycunataga ruraran","poem":1},{"lineBreak":true},{"text":"pï-maywanpis cacoj warmicunapita chasquishan guellaywanmi.","poem":1},{"lineBreak":true},{"text":"Chaypitami yapay ticrachishaj","poem":1},{"lineBreak":true},{"text":"pï-maywanpis cacoj warmicunata pägananpaj.»","poem":1}]},{"type":"heading","content":["Miqueas llaquicushan"]},{"type":"verse","number":8,"content":[{"text":"Chaypitami fiyupa llaquicushpä wagashaj.","poem":1},{"lineBreak":true},{"text":"Gara-chaquilla, röpaynajlla purishaj.","poem":1},{"lineBreak":true},{"text":"Atoj-mallwa aullajno wagashaj.","poem":1},{"lineBreak":true},{"text":"Avestruz äbipa wawanno gaparäshaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Samariapa guerenga caycan ima jampiwanpis mana allchacajmi.","poem":1},{"lineBreak":true},{"text":"Chay gueriga jogushami Judätapis.","poem":1},{"lineBreak":true},{"text":"Jerusalén siudämanpis chayashami.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chaytaga ama willapaychu Gatcho tiyajcunata.","poem":1},{"lineBreak":true},{"text":"Ni ama wagaypischu-llapa.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga fiyupa nanayllawan Bet-le-afracho gochpay-llapa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Safircho tiyajcuna nasyunniquipita juc-lämanmi prësu aywanquipaj galalla, fiyupa pengacur.","poem":1},{"lineBreak":true},{"text":"Zaanáncho tiyajcuna, yanapäshunayquipaj manami pipis yargamongapächu.","poem":1},{"lineBreak":true},{"text":"Beteselcho tiyajcuna, wagaptiquipis manami pipis cuyapäshunquipächu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Marotcho tiyajcunaga yanapänantami shuyarpaycaran.","poem":1},{"lineBreak":true},{"text":"Nishan Tayta Diosga camacächisha asta quiquin Jerusalén puncuncama mana alli chayananpämi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Laquis siudächo tiyajcuna, gamcunapis Israelcunano mana wiyacojmi cashcanqui.","poem":1},{"lineBreak":true},{"text":"Gamcunami caminuta gorayqui Sión runacuna juchata rurananpäga.","poem":1},{"lineBreak":true},{"text":"Chaypita cananga carrëtayquicunaman cawalluyquicunata watacuyna.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Imaypis mana cutinayquipaj Moreset-gat-taga «Aywallä» nicuy.","poem":1},{"lineBreak":true},{"text":"Israelpa raynincunapäga Aczib siudä canga charinanpaj toglla shuyaraycajnömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tayta Diosga cayno nin: «Maresa marcacho tiyajcuna, gamcunamanga","poem":1},{"lineBreak":true},{"text":"yapaymi cachamushaj nasyunniquita charicurcunanpaj.","poem":1},{"lineBreak":true},{"text":"Israelcho mas mana manchacoj cajpis Adulamcho caycaj machaymanmi pacacongapaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Jerusalén siudächo tiyajcuna,","poem":1},{"lineBreak":true},{"text":"fiyupa cuyashayqui wamrayquicunatami caru nasyunman apacongapaj.","poem":1},{"lineBreak":true},{"text":"Chaymi ajchayquita rutucuy llaquicushayqui musyacänanpaj.","poem":1},{"lineBreak":true},{"text":"Ajchayquita jichcaypa rutucuy wisculno gala-uma canayquicama.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}