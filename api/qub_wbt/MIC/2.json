{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"MIC","translationId":"qub_wbt","name":"MIQUEAS","commonName":"MIQUEAS","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e8789e5a74529ce7de8cad8f97c9616bc3cd321a2db6d84c1e45bb6ed8740a30","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/qub_wbt/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Ñacachicoj rïcucuna castigasha cananpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"¡Ay cuyapaypämi ñacanga","poem":1},{"lineBreak":true},{"text":"asta suyñuyninchöpis mana allita rurayllata yarpaycajcuna!","poem":1},{"lineBreak":true},{"text":"Chay runacunaga imata rurananpäpis puydej munayniyoj cashpanmi","poem":1},{"lineBreak":true},{"text":"pacha wararcuptinnaga chay yarpashanno ruran.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chacrata munaparga chay chacracunata guechucurin.","poem":1},{"lineBreak":true},{"text":"Wasicunata munaparga chay wasicunatapis guechucurin.","poem":1},{"lineBreak":true},{"text":"Runata warmintinta, wamrantinta ñacachin.","poem":1},{"lineBreak":true},{"text":"Taytan maman cachapaycushan chacracunatapis engañaypa guechucurin.","poem":1}]},{"type":"verse","number":3,"content":["Chaypitami chay runacunataga Tayta Dios cayno nin:",{"text":"«Nogapis paycunata imano ruraytapis yarpaycänami.","poem":1},{"lineBreak":true},{"text":"Disigrasyami paycunamanga chayangapaj.","poem":1},{"lineBreak":true},{"text":"Chay ñacaypitaga manami gueshpengapächu.","poem":1},{"lineBreak":true},{"text":"Chauraga manami alli-tucushpan purengapänachu.","poem":1},{"lineBreak":true},{"text":"Chay wichanga cangapaj fiyupa llaquicuyllami.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayno ñacaycho goyashan junajcunami paycunataga asipanga.","poem":1},{"lineBreak":true},{"text":"Asiparmi cayno nengapaj: ‹Pasaypa ushacashami quëdasha.","poem":1},{"lineBreak":true},{"text":"Ñaupataga Tayta Diospaj acrasha runacunami caran.","poem":1},{"lineBreak":true},{"text":"Cananga jucpa maquinchönami caycan.","poem":1},{"lineBreak":true},{"text":"Suldärunchïcunami binsiycur charicarcärisha.","poem":1},{"lineBreak":true},{"text":"Chaymi chacrancunatapis raquipänacushcanchi› nir.»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaynöpami Tayta Dios acrashan runacuna chasquishanchöga","poem":1},{"lineBreak":true},{"text":"chay fiyu runacuna imatapis mana chasquengapächu.","poem":1}]},{"type":"heading","content":["Fiyu profëtacunapaj rimashan"]},{"type":"verse","number":6,"content":["Gam Israelcunaga nircaycanqui:",{"text":"«Ama willapämaynachu imapis cananpaj cajcunata.","poem":1},{"lineBreak":true},{"text":"Mana alliga manami nogacunata chayamangachu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jacobpita mirajcuna caycaptë Tayta Diosninchi manami nogacunawan rabyashachu caycan.","poem":1},{"lineBreak":true},{"text":"Castigamänanpaj cashanta willacuptiquipis payga manami castigamangachu.","poem":1},{"lineBreak":true},{"text":"Alli runacuna captëmi Tayta Diosga imaypis yanapämanga.»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ichanga Tayta Dios nin: «Gamcunaga ñaupata carayqui acrashä runacunami.","poem":1},{"lineBreak":true},{"text":"Cananmi ichanga conträna ricacushcanqui.","poem":1},{"lineBreak":true},{"text":"Alli goyäcojcunata, alli puricojcunata punchuncunatapis guechuycanqui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Cushisha tiyashan alli wasincunapitami warmicunatapis gargurcaycanqui.","poem":1},{"lineBreak":true},{"text":"Wamrancuna cushisha goyänanpaj cajtapis guechushcanqui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jatariyna-llapa; aywacuyna-llapa.","poem":1},{"lineBreak":true},{"text":"Cay pachaga manami jamaräcunayquipächu.","poem":1},{"lineBreak":true},{"text":"Pasaypa mana allillata rurashayquipitami ushajpaj illganquipaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"‹Tayta Diosga yanapäshunquipaj bïnu cananpaj, machächicojcuna cananpaj› nir","poem":1},{"lineBreak":true},{"text":"willacojcunami gamcunapa profëtayqui cananpäga alli caycan.","poem":1}]},{"type":"heading","content":["Acrashan runacunata Dios salbananpaj cashan"]},{"type":"verse","number":12,"content":[{"text":"«Israelcuna, gamcunataga llapaniquitami juc pachallaman shuntaj-aywä.","poem":1},{"lineBreak":true},{"text":"Gamcunataga wallcalla quëdasha caycajllatapis shuntajmi-aywä.","poem":1},{"lineBreak":true},{"text":"Chayno rurarmi jucllachashayqui uyshata canchanman gaycojno.","poem":1},{"lineBreak":true},{"text":"Gamcunaga caycanquipaj uyshacuna alli guewacho caycajnömi.","poem":1},{"lineBreak":true},{"text":"Chaychöga aypallanömi gaparpanquipaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tayta Diosmi nänita ricachishushpayqui ñaupayquita aywangapaj.","poem":1},{"lineBreak":true},{"text":"Gamcunanami guepanta aywanquipaj.","poem":1},{"lineBreak":true},{"text":"Chayno aywarmi siudä puncunpa llojshinquipaj.","poem":1},{"lineBreak":true},{"text":"Rayniqui Tayta Diosnami gamcunapa ñaupayquita aywangapaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}