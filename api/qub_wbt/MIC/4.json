{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"MIC","translationId":"qub_wbt","name":"MIQUEAS","commonName":"MIQUEAS","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e8789e5a74529ce7de8cad8f97c9616bc3cd321a2db6d84c1e45bb6ed8740a30","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/qub_wbt/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Tayta Dios alli mandananpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"Shamoj watacunacho Tayta Diospa Templun caycashan puntaga","poem":1},{"lineBreak":true},{"text":"waquin puntacunapita mas rispitashami cangapaj.","poem":1},{"lineBreak":true},{"text":"Chaymanmi shamongapaj achca nasyun runacuna.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aypalla runami shamunanpaj shacyächinacushpan cayno ninaconga:","poem":1},{"lineBreak":true},{"text":"«Aywashun-llapa, Jacobpa Tayta Diosninpa Templun caycashan jircaman wichänapaj.","poem":1},{"lineBreak":true},{"text":"Chaychönami yachachimäshun imano goyänanchïpäpis.","poem":1},{"lineBreak":true},{"text":"Chaynöpana pay munashanno llapantapis rurashunpaj» nir.","poem":1},{"lineBreak":true},{"text":"Sionpitami Tayta Diosga yachachenga.","poem":1},{"lineBreak":true},{"text":"Jerusalenpitanami parlapämonga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diosmi jusganga llapan nasyun runacunata.","poem":1},{"lineBreak":true},{"text":"May carucho caycaj nasyuncunatapis imano cananpäpis nenga.","poem":1},{"lineBreak":true},{"text":"Chaura chay runacunaga sablincunatapis rëjamanmi ticrachenga.","poem":1},{"lineBreak":true},{"text":"Tucsicuna lansancunatapis ösimannami ticrachenga.","poem":1},{"lineBreak":true},{"text":"Juc nasyunwan juc nasyun manami guërrata ruranganachu.","poem":1},{"lineBreak":true},{"text":"Guërrapäpis manami yachachinaconganachu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chauraga mana manchacuypanami runacuna goyangapaj.","poem":1},{"lineBreak":true},{"text":"Cada-ünunnami jamarpäcongapaj übas yöranpa, ïgus yöranpa llantuncunacho.","poem":1},{"lineBreak":true},{"text":"Munayniyoj Tayta Diosmi nisha chayno cananpaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waquin nasyun runacunaga","poem":1},{"lineBreak":true},{"text":"diosnincunatami aduran.","poem":1},{"lineBreak":true},{"text":"Noganchïmi ichanga imaypis Tayta Diosninchi nimashallanchïta wiyacushun.","poem":1}]},{"type":"heading","content":["Acrashan runacunata Tayta Dios salbananpaj cashan"]},{"type":"verse","number":6,"content":["Tayta Diosga caynömi nin:",{"text":"«Chay junäga wegru uyshäcunata shuntashämi.","poem":1},{"lineBreak":true},{"text":"Ogracasha caycajta, ñacaycajta canchanman shuntashaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chay wegrucunatami acrashaj.","poem":1},{"lineBreak":true},{"text":"Chay ñacaycajcunatami munayniyoj nasyun cananpaj camacächishaj.","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosmi acrashä runacunataga Sión lömapita-pacha imaycamapis mandashäpaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sión gammi caycanqui uyshacunata ricachacuna törri.","poem":1},{"lineBreak":true},{"text":"Gammi canqui chaycho tiyajcunapa pacacunan.","poem":1},{"lineBreak":true},{"text":"Yapaymi ñaupatano rispitädu canquipaj.","poem":1},{"lineBreak":true},{"text":"Jerusalén yapaymi capital canquipaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Cananga ¿imanirtaj nanay chariptin warmi gaparajno gaparanqui?","poem":1},{"lineBreak":true},{"text":"¿Manachu rayniqui can?","poem":1},{"lineBreak":true},{"text":"U ¿tantiyachishojniquichu wañusha?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sión siudächo tiyajcuna, nanaywan guempuycachay.","poem":1},{"lineBreak":true},{"text":"Nanaycho caycaj warminöpis gaparay ari.","poem":1},{"lineBreak":true},{"text":"Gamcunaga cay siudäpita aywacunquipämi.","poem":1},{"lineBreak":true},{"text":"Chunyaj jircacunachömi tiyanquipaj.","poem":1},{"lineBreak":true},{"text":"Babilonia nasyunmanmi prësu apashunquipaj.","poem":1},{"lineBreak":true},{"text":"Chaypitanami Tayta Diosga salbashunquipaj contrayquipa munayninpita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Cananga achca nasyun runacunami gampa contrayqui shuntacasha carcaycan.","poem":1},{"lineBreak":true},{"text":"Paycunami cayno parlan:","poem":1},{"lineBreak":true},{"text":"«¡Jerusalén ushacaycunman!","poem":1},{"lineBreak":true},{"text":"¡Chauraga fiyupa cushicurmi ricapashwan!» nir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ichanga chay nasyun runacuna manami musyanchu","poem":1},{"lineBreak":true},{"text":"Tayta Diospa yarpaynin imano cashanta, ni imata rurananpaj yarpaycashantapis.","poem":1},{"lineBreak":true},{"text":"Manami musyanchu rïguta ëraman shuntajno Tayta Dios shuntaycashanta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Tayta Diosga caynömi nin:",{"lineBreak":true},{"text":"«Sión runacuna, jatarcärir ërayna-llapa.","poem":1},{"lineBreak":true},{"text":"Nogami yanapäshayqui fyërrupita wagrayoj, runsipita shilluyoj töruno fiyupa callpayoj canayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami achca nasyun runacunata lluchcar-ushanquipaj.","poem":1},{"lineBreak":true},{"text":"Mana allita ruraypa tarishan cösancunatapis gamcunami guechunquipaj.","poem":1},{"lineBreak":true},{"text":"Nircorga llapanpaj munayniyoj noga Tayta Diosniquitami goycamanquipaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}