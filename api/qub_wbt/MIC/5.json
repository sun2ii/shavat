{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"MIC","translationId":"qub_wbt","name":"MIQUEAS","commonName":"MIQUEAS","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e8789e5a74529ce7de8cad8f97c9616bc3cd321a2db6d84c1e45bb6ed8740a30","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/qub_wbt/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Israelcunaman juc mandajta cachamunanpaj cashan"]},{"type":"verse","number":1,"content":[{"text":"Chaymi cananga Jerusalén runacuna chapacunayquipaj camaricuy.","poem":1},{"lineBreak":true},{"text":"Gamcunamanga jäpa runacunami yaycamongapaj.","poem":1},{"lineBreak":true},{"text":"Paycunami Israelcunapa mandajnintaga fiyupa magangapaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ichanga Judächo caj marcacunapita mas tacsha Belén Efrata marca,","poem":1},{"lineBreak":true},{"text":"gamchömi Israelcunapa raynin yurengapaj.","poem":1},{"lineBreak":true},{"text":"Payga yurenga mas unay famillya aywarajpitami.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cananpitaga Tayta Dios cachaycushunquipämi.","poem":1},{"lineBreak":true},{"text":"Ichanga manami unaycamachu cachaycushunquipaj.","poem":1},{"lineBreak":true},{"text":"Chayga canga gueshyacunanpaj caycaj warmi gueshyacunancamallami.","poem":1},{"lineBreak":true},{"text":"Chaypitaga chay yurejmi Israel-masincunawan shuntacanga.","poem":1},{"lineBreak":true},{"text":"Shuntacanga prësu aywashanpita cutimojcunawan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paynami marca-masincunataga Tayta Diospa munayninwan mandanga.","poem":1},{"lineBreak":true},{"text":"Uyshëru uyshata michejnöpis ricanga.","poem":1},{"lineBreak":true},{"text":"Chaura paycunaga allillanami goyangapaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga cangapaj intëru munducho paytana pï-maypis rispitaptinmi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pay mandaptenga alli goyaymi cangapaj.","poem":1},{"lineBreak":true},{"text":"Asiria runacuna nasyunninchïman yaycamuptin,","poem":1},{"lineBreak":true},{"text":"palasyunchïcunaman yaycuptin,","poem":1},{"lineBreak":true},{"text":"paycunaman cachashun ganchis mandajninchïcunata,","poem":1},{"lineBreak":true},{"text":"pusaj mas rispitädu runacunatapis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaura paycunami pushamäshun Asiria runacuna cajman,","poem":1},{"lineBreak":true},{"text":"Nimrodcho tiyajcunata binsiycur mandananchïpaj.","poem":1},{"lineBreak":true},{"text":"Paycunami salbamäshunpaj Asiria runacuna nasyunninchïman yaycamuptinpis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaura Jacobpita miraj quëdajcunaga intëru nasyuncunachömi caycangapaj.","poem":1},{"lineBreak":true},{"text":"Shullayta Tayta Dios guewaman cada tuta chayachimushannömi caycanga.","poem":1},{"lineBreak":true},{"text":"Chaycunataga manami runachu chayachimun.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga Diosllami chayachimun.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaynöpis Jacobpita miraj quëdajcunaga intëru nasyuncunachömi aypacasha caycangapaj.","poem":1},{"lineBreak":true},{"text":"Animalcunacho manchacuypaj liyun caycajnömi caycangapaj.","poem":1},{"lineBreak":true},{"text":"Liyonga uyshacunata charishpan rachir-usharinmi.","poem":1},{"lineBreak":true},{"text":"Cawaycajtaga manami ni jucnayllatapis cachaycunchu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Dios, gamga chaynömi illgächinquipaj contrayqui jatarejcunata.","poem":1}]},{"type":"heading","content":["Pillyapis ïdulucunata aduraypis illgänanpäna cashan"]},{"type":"verse","number":10,"content":["Tayta Diosga Payllaman yäracunanpämi Israelcunataga cayno nin:",{"text":"«Chay junäga cawalluyquicunatapis wañuchishämi.","poem":1},{"lineBreak":true},{"text":"Guërrapaj caj carrëtayquicunatapis illgächishämi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siudäniquicunatapis illgächishaj.","poem":1},{"lineBreak":true},{"text":"Pacacunayquicunatapis ushajpämi juchurgärachishaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Brüjucunatapis ushajpämi illgächishaj.","poem":1},{"lineBreak":true},{"text":"Chaura gamcunachöga manami cangapänachu musyacojcunapis.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ïduluyquicunatapis, rispitashayqui wancacunatapis ushajpämi illgächishaj.","poem":1},{"lineBreak":true},{"text":"Chayno ruraptëga imaypis manami aduranquipänachu","poem":1},{"lineBreak":true},{"text":"quiquiquicuna ‹diosnë› nir rurashayquita.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rispitashayqui Asera diosa-niraj ïdulutapis ushajpämi jitarishaj.","poem":1},{"lineBreak":true},{"text":"Siudäniquicunatapis ushajpämi juchurgärachishaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Noga nishäta mana wiyacoj nasyun runacunatami ichanga fiyupa rabyawan castigashaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}