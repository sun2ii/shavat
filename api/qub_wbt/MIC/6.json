{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"MIC","translationId":"qub_wbt","name":"MIQUEAS","commonName":"MIQUEAS","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e8789e5a74529ce7de8cad8f97c9616bc3cd321a2db6d84c1e45bb6ed8740a30","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/qub_wbt/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["Israelcunata Tayta Dios jorgapashan"]},{"type":"verse","number":1,"content":["Israelcuna, Tayta Dios nishanta wiyay-llapa. Paymi nin:",{"text":"«Lömacuna wiyaycäshuptiqui ichircur difindicuy ari.","poem":1},{"lineBreak":true},{"text":"Imata rimashayquitapis puntacuna wiyachun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mundu mana cuyucunanpaj tucnaraycaj simintuncunapis","poem":1},{"lineBreak":true},{"text":"puntacunapis sumaj wiyay-llapa.","poem":1},{"lineBreak":true},{"text":"Acrashä runacunatami jusgaj-aywä.","poem":1},{"lineBreak":true},{"text":"Israel runacunatami imata rurashallantapis jorgapaj-aywä.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Israelcuna, mä canan nimay.","poem":1},{"lineBreak":true},{"text":"Gamcunataga ¿imatataj rurashcä?","poem":1},{"lineBreak":true},{"text":"¿Imachötaj rabyachishcä?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gamcunataga uyway caycajta salbashpä","poem":1},{"lineBreak":true},{"text":"Nogami Egiptupita jorgamurä.","poem":1},{"lineBreak":true},{"text":"Nogami cachamurä Moisesta, Aaronta, Mariata","poem":1},{"lineBreak":true},{"text":"llojshicamuptiqui paycuna pushamushunayquipaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Acrashä runacuna, cananga yarpäriy","poem":1},{"lineBreak":true},{"text":"Moabpa raynin Balac gamcunapa contrayqui imano yarpashantapis.","poem":1},{"lineBreak":true},{"text":"Chaynöpis yarpäriy Beorpa wamran Balaam imano nishantapis.","poem":1},{"lineBreak":true},{"text":"Yarpäriy Sitimpita Gilgalcama imano aywashayquitapis.","poem":1},{"lineBreak":true},{"text":"Chaynöpami musyanqui noga Tayta Diosniqui gamcunapaj allicunata rurashäta.»","poem":1}]},{"type":"heading","content":["Tayta Dios imata munashanpis"]},{"type":"verse","number":6,"content":["Capas pillapis ninman:",{"text":"«¿Imalläwanraj aywashaj Tayta Diospa ñaupanman?","poem":1},{"lineBreak":true},{"text":"¿Imallawanraj janaj pachacho caycajta adurashaj?","poem":1},{"lineBreak":true},{"text":"¿Paypa ñaupanmanga aywashaj rupachipänäpaj cajta apacurcurchuraj,","poem":1},{"lineBreak":true},{"text":"u watayoj besërata apacurcurchuraj?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¿Tayta Dios cushicunmanchuraj waranga uyshacunata paypaj pishtaptë?","poem":1},{"lineBreak":true},{"text":"¿Aypalla mayu aywaycajtanöraj asëtita goycuptë chasquinmanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Paypa contran jatarishäpita, juchäcunapa ruquin,","poem":1},{"lineBreak":true},{"text":"guechpa wamräta sacrifisyupaj pishtapaptë chasquimanmanchuraj?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Runa, Tayta Diosga maynami nisha-cashunqui,","poem":1},{"lineBreak":true},{"text":"alli cajllata, pay munashan cajllata ruranayquipaj.","poem":1},{"lineBreak":true},{"text":"Payga munan: Alli cajllata ruranayquitami,","poem":1},{"lineBreak":true},{"text":"pï-maytapis cuyanayquitami,","poem":1},{"lineBreak":true},{"text":"imata Tayta Dios nishushayquitapis wiyacur cumlinayquitami.","poem":1}]},{"type":"heading","content":["Jerusalén runacunata castigananpaj nishan"]},{"type":"verse","number":9,"content":["Tayta Diosga Jerusalén siudächömi gayaraycan. Payga cayno nin:",{"text":"«Siudächo caycajcuna llapayqui wiyay.","poem":1},{"lineBreak":true},{"text":"Tantiyachejcunapis wiyay.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fiyu runacunapa wasinchöga","poem":1},{"lineBreak":true},{"text":"ima-aycanpis caycan mana allita rurar shuntashallanmi.","poem":1},{"lineBreak":true},{"text":"Chaynöpis chaychöga caycan chiquishä caj suwa tupullami.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¿Imanöpataj perdunashaj suwa balansayojta,","poem":1},{"lineBreak":true},{"text":"pishejlla pësacunayojtaga?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Cay siudächo caj rïcucunaga","poem":1},{"lineBreak":true},{"text":"llapanpis ñacachicojcunallami.","poem":1},{"lineBreak":true},{"text":"Llapanpis llullacunallami caycan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chaypitami cananga gamcunata castigayta gallaycushayqui, juchayquicunapitapis illgächiyta.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Micurpis manami sacsanquipächu.","poem":1},{"lineBreak":true},{"text":"Jinallami yargaycanquipaj.","poem":1},{"lineBreak":true},{"text":"Ima-aycatapis shuntar churanquipaj.","poem":1},{"lineBreak":true},{"text":"Chayno churarpis manami imatapis jorgunquipächu.","poem":1},{"lineBreak":true},{"text":"Imallatapis quëdachisha captiquega","poem":1},{"lineBreak":true},{"text":"Nogami camacächishaj guërrachöna ushacänanpaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Murupacurpis manami shuntapacunquipächu.","poem":1},{"lineBreak":true},{"text":"Olivota agarpis asëtinwan manami imatapis ruranquipänachu.","poem":1},{"lineBreak":true},{"text":"Übasta lluchcarpis manami bïnuta upunquipänachu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chaynöga cangapaj ray Omriwan, ray Acabpa famillyancuna nishancunata,","poem":1},{"lineBreak":true},{"text":"rurashancunata, wiyacur rurashayquipitami.","poem":1},{"lineBreak":true},{"text":"Chaypitami cananga noga camacächishaj Jerusalenta illgächinanpaj.","poem":1},{"lineBreak":true},{"text":"Chaycho tiyaj runacunataga pasaypa manacajmanmi churanga.","poem":1},{"lineBreak":true},{"text":"Llapan nasyun runacunami jamurpangapaj acrashä runacunataga.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}