{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"MIC","translationId":"qub_wbt","name":"MIQUEAS","commonName":"MIQUEAS","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e8789e5a74529ce7de8cad8f97c9616bc3cd321a2db6d84c1e45bb6ed8740a30","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/qub_wbt/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Israelcuna pirdicashan"]},{"type":"verse","number":1,"content":[{"text":"¡Cuyapaypämi caycä!","poem":1},{"lineBreak":true},{"text":"Cosëchata ushaycur chacracho quëdajcunata ashejnöllanami caycä.","poem":1},{"lineBreak":true},{"text":"Manami tarënachu micuyta munashä übasta ni ïgustapis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chaynömi cay munduchöga manana cannachu allita rurajcuna, ni Tayta Dios nishanta rurajcunapis.","poem":1},{"lineBreak":true},{"text":"Imay örapis wañuchinacuyllatami ashircaycan.","poem":1},{"lineBreak":true},{"text":"Jucnin-jucninpis llullapänacun mana alliman chayachinacunanpaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mana alli ruraypäga fiyupa yachajmi carcaycan.","poem":1},{"lineBreak":true},{"text":"Mandaj autoridäcunaga imapitapis pägananta munarcaycan.","poem":1},{"lineBreak":true},{"text":"Juezcunapis pacayllapa pägaptenga chasquinmi.","poem":1},{"lineBreak":true},{"text":"Munayniyojcunaga imatapis munashantami ruran.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paycunacho mas rispitasha caj runacunapis cashanömi caycan.","poem":1},{"lineBreak":true},{"text":"Mas yäracuypaj runapis shiranömi caycan.","poem":1},{"lineBreak":true},{"text":"Imano captinpis chayamongapänami llapanpita jusgasha cananpaj junaj.","poem":1},{"lineBreak":true},{"text":"Chaytaga maynami willacojcuna willacuran.","poem":1},{"lineBreak":true},{"text":"Chay öraga runacuna manami ima ruraytapis camäpacongapächu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ama riguiychu runa-masiqui imata nishushayquitapis.","poem":1},{"lineBreak":true},{"text":"Ama yäracuycho ni maygan amïguyquitapis.","poem":1},{"lineBreak":true},{"text":"Warmiquitapis llapantaga ama willapaychu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ollgu wamrancunaga papäninta pasaypa manacajmanmi churaycan.","poem":1},{"lineBreak":true},{"text":"Warmi wamrancunapis mamanta chiquicarcärishami.","poem":1},{"lineBreak":true},{"text":"Llumchuycunapis suyrancunata chiquircaycanmi.","poem":1},{"lineBreak":true},{"text":"Chaymi, cada runapa contranga caycan quiquin famillyalla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nogami ichanga Tayta Diosllata shuyäcuycäshaj.","poem":1},{"lineBreak":true},{"text":"Salbamaj Tayta Diosnilläman yäracushaj.","poem":1},{"lineBreak":true},{"text":"Payga wiyamangami.","poem":1}]},{"type":"heading","content":["Tayta Diosga Israelcunata salbangami"]},{"type":"verse","number":8,"content":["Israelcuna cayno nin:",{"text":"«Nogacunata chiquimaj nasyun runacuna,","poem":1},{"lineBreak":true},{"text":"mana allicho caycajta ricamar ama cushipämaychu.","poem":1},{"lineBreak":true},{"text":"Mana alliman chayasha, tunisha caycarpis jatarishämi.","poem":1},{"lineBreak":true},{"text":"Intëröpami yanauyaycaj chacay caycan.","poem":1},{"lineBreak":true},{"text":"Ichanga Tayta Diosmi achicyajman apamanga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Dios mana munashanta rurarmi juchata rurashcä.","poem":1},{"lineBreak":true},{"text":"Chaymi awantashaj castigamaptinpis.","poem":1},{"lineBreak":true},{"text":"Payga imano cashätapis jusgamangami.","poem":1},{"lineBreak":true},{"text":"Nircorga allimi arriglamanga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga achicyajmanmi jorgamanga.","poem":1},{"lineBreak":true},{"text":"Paymi salbamanga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chaytaga ricangami chiquimajcunapis.","poem":1},{"lineBreak":true},{"text":"Chaura paycunaga fiyupa pengay-tucushami ricaconga.","poem":1},{"lineBreak":true},{"text":"Paycunaga caynömi tapumaran: ‹¿Maychötaj caycan Tayta Diosniqui?› nir.","poem":1},{"lineBreak":true},{"text":"Paycunataga ricashaj nogapita mas piyur ruracasha caycajtami.","poem":1},{"lineBreak":true},{"text":"Paycunaga cangapäpis cällicho caycaj mituta lluchcar-ushashanömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Jerusalén siudä, chayaycämunnami","poem":1},{"lineBreak":true},{"text":"intëruyquipa curalaraj pergayquicuna allchachisha cananpaj caj junaj.","poem":1},{"lineBreak":true},{"text":"Lindayquicunapis mas carupana cangapaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Jerusalén, intërupitami runacuna gamman shamongapaj.","poem":1},{"lineBreak":true},{"text":"Chay junäga chayaycämunnami.","poem":1},{"lineBreak":true},{"text":"Gammanga shamongapaj:","poem":1},{"lineBreak":true},{"text":"Asiriapita Egiptucamami,","poem":1},{"lineBreak":true},{"text":"Nilo mayupita Éufrates mayucama,","poem":1},{"lineBreak":true},{"text":"juc lamarpita juc lamarcama,","poem":1},{"lineBreak":true},{"text":"juc puntapita juc puntacama.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chay nasyun runacunapa nasyunnenga chunyajman ticrashami quëdanga.","poem":1},{"lineBreak":true},{"text":"Chaynöga canga chaycho tiyaj runacuna","poem":1},{"lineBreak":true},{"text":"juchancunapitami y mana allita rurashanpitami.","poem":1}]},{"type":"heading","content":["Israelcuna allichöna cananpaj mañacushan"]},{"type":"verse","number":14,"content":[{"text":"«Tayta Dios, sirbishojcunataga ricaycuy ari.","poem":1},{"lineBreak":true},{"text":"Nogacunaga caycä gampa uyshayquinömi.","poem":1},{"lineBreak":true},{"text":"Quiquilläcuna shatachömi carcaycä.","poem":1},{"lineBreak":true},{"text":"Micuy fiyupa wayunan allpami intëröpa tumaparaycäman.","poem":1},{"lineBreak":true},{"text":"Unay pushamushayquino, yapay pushamay ari.","poem":1},{"lineBreak":true},{"text":"Pushamay Basancho Galaadcho caycaj alli guewacunaman.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nogacunatapis milagrucunata ricachimay.","poem":1},{"lineBreak":true},{"text":"Egiptupita jorgamushpayqui ricachishayquino ricachimay.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chaytaga waquin nasyuncunapis ricangami.","poem":1},{"lineBreak":true},{"text":"Ricashpan fiyupa munayniyoj caycashpanpis pasaypa pengay-tucushami quëdanga.","poem":1},{"lineBreak":true},{"text":"Äyacashami ricaconga.","poem":1},{"lineBreak":true},{"text":"Imata ruraytapis manami camäpacongachu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Culebracunano, waquin garachaypa purejcunanöpis allpatami miconga.","poem":1},{"lineBreak":true},{"text":"Pacarpaycashanpitapis sicsicyaycarmi llojshimonga Tayta Diospa ñaupanman.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, gamtaga fiyupami manchacushunquipaj.","poem":1}]},{"type":"heading","content":["Runacunata Tayta Dios perdunashan"]},{"type":"verse","number":18,"content":[{"text":"«Gamnöga manami juc Dios canchu.","poem":1},{"lineBreak":true},{"text":"Gamga perdunanquimi mana allita rurajtapis.","poem":1},{"lineBreak":true},{"text":"Chaynöpis gonganquimi nogacuna wallcalla quëdaj","poem":1},{"lineBreak":true},{"text":"acrashayqui runacuna juchata rurashäta.","poem":1},{"lineBreak":true},{"text":"Imaycamapis manami rabyashallaga cacunquichu.","poem":1},{"lineBreak":true},{"text":"Gamga nogacunata cuyamashayquita musyachimanquimi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nogacunata yapay cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Juchäcunatapis ama yarpaynachu.","poem":1},{"lineBreak":true},{"text":"Nogacunapa juchätaga jitarpuy","poem":1},{"lineBreak":true},{"text":"mas jundunnin lamarman.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tayta Dios, cumliycuy ari Jacobta aunishayquita,","poem":1},{"lineBreak":true},{"text":"Abrahamta cuyapänayquipaj aunishayquitapis.","poem":1},{"lineBreak":true},{"text":"Chaynömi unay awilöcunata aunirayqui.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}