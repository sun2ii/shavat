{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"NAM","translationId":"qub_wbt","name":"NAHÚM","commonName":"NAHÚM","title":"Nahúm","order":34,"numberOfChapters":3,"sha256":"1bcd688dbb3b3e063a55493724767b692bb58847eea82cd0eb594e08eebd0c80","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/qub_wbt/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Cay libroga caycan Nínive imano cananpaj cashantapis Nahumta Tayta Dios ribilashanmi. Nahúm tiyaran Elcos marcachömi."]},{"type":"heading","content":["Niniveta Tayta Dios castigananpaj nishan"]},{"type":"verse","number":2,"content":[{"text":"Tayta Diosga payllata sirbinanchïtami munan.","poem":1},{"lineBreak":true},{"text":"Mana allita rurashaga pay rabyar castigacunmi.","poem":1},{"lineBreak":true},{"text":"Pay nishanta mana rurajcunataga rurashanmannömi castïguta gon.","poem":1},{"lineBreak":true},{"text":"Paypa contran cajcunapäga fiyupami rabyan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diosga fiyupa munayniyojmi.","poem":1},{"lineBreak":true},{"text":"Chaymi jucha ruraj cajtaga castigänita mana cachaycongachu.","poem":1},{"lineBreak":true},{"text":"Ichanga juclla manami rabyacunchu.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga aywan löcu tamya jananpami, gachwariycar aywaj wayra jananpami.","poem":1},{"lineBreak":true},{"text":"Pucutayga caycan chaquin polbuta jatarachishanmi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lamartapis ollgöparga chaquirachinmi.","poem":1},{"lineBreak":true},{"text":"Paymi camacächin llapan mayucuna chaquinanpäpis.","poem":1},{"lineBreak":true},{"text":"Chaymi Basán particho, Carmelo jircacunacho","poem":1},{"lineBreak":true},{"text":"jachacuna caycajpis wañuytacäcun.","poem":1},{"lineBreak":true},{"text":"Libanucho caycaj waytacunapis wañuytacäcun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Payta ricashpanga puntacunapis sicsicyan.","poem":1},{"lineBreak":true},{"text":"Paypa ñaupanchöga puntacunapis jurucäcunmi.","poem":1},{"lineBreak":true},{"text":"Payta ricashpanga intëru cay mundumi mancharin.","poem":1},{"lineBreak":true},{"text":"Cay pachapis, cay pachacho tiyajcunapis llaquicun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pay fiyupa rabyasha caycashan öraga ¿piraj ichiraycanman?","poem":1},{"lineBreak":true},{"text":"¿Piraj awantanman rabyasha caycaptenga?","poem":1},{"lineBreak":true},{"text":"Paypa rabyaynenga nina wapchacojnömi.","poem":1},{"lineBreak":true},{"text":"Chaynöpis, paypa ñaupanchöga gagacunapis shillicäcunmi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Diosga fiyupa allimi.","poem":1},{"lineBreak":true},{"text":"Payga ñacaycashanchi öra pacamajninchïmi.","poem":1},{"lineBreak":true},{"text":"Payman yäracoj cajcunataga imapitapis chapanmi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Paypa contran cajcunatami ichanga","poem":1},{"lineBreak":true},{"text":"mayu chayar ima-aycatapis apacushanno illgarachin.","poem":1},{"lineBreak":true},{"text":"Paypa contran cajcunataga yanauyaycaj chacaychöpis gaticachangami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nínive runacuna ¿gamcunaga imanirtaj Tayta Diospa contran yarparcaycanqui?","poem":1},{"lineBreak":true},{"text":"¡Payga ushajpämi illgarachishunquipaj!","poem":1},{"lineBreak":true},{"text":"Paypa contran cajcunataga illajpitami ushajpaj illgarachenga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Shiraca chaquir jiracasha caycajtanömi,","poem":1},{"lineBreak":true},{"text":"chaquisha ogshata nina ushacurcojnömi usharenga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nínive siudä, gampitami yurimusha","poem":1},{"lineBreak":true},{"text":"Tayta Diospa contran jatarëga.","poem":1},{"lineBreak":true},{"text":"Chay runami juc runacunata shimita jatipaycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Chaypitami Tayta Diosga Judá runacunata nin:","poem":1},{"lineBreak":true},{"text":"«Asiria runacunaga callpayoj aypalla cashpanpis illgangami.","poem":1},{"lineBreak":true},{"text":"Nishänömi ushacangapaj.","poem":1},{"lineBreak":true},{"text":"Gamcunataga ñacachishcänami.","poem":1},{"lineBreak":true},{"text":"Cananpitaga manami ñacachishayquipänachu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ñacachishushpayqui yüguta churapäshushayquitapis","poem":1},{"lineBreak":true},{"text":"ichic-ichicllami paquirishaj.","poem":1},{"lineBreak":true},{"text":"Wataraycashayqui cadinatapis agullargärishämi.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nínive runacuna, gamcunapäga Tayta Dios caynömi nisha:","poem":1},{"lineBreak":true},{"text":"«Gamcunapita mirar aywäga manami cangapänachu.","poem":1},{"lineBreak":true},{"text":"Diosniquicunapa templuntapis juchuchishämi.","poem":1},{"lineBreak":true},{"text":"Uywa-niraj ïduluyquicunatapis illgächishämi.","poem":1},{"lineBreak":true},{"text":"Gamcunatapis melanaypaj captiquimi ushajpaj usharishayquipaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"¡Judá runacuna, masqui ricay!","poem":1},{"lineBreak":true},{"text":"Willacoj maynami jircacunapa aywaycämun alli goyay cananpäna willapata apamushpan.","poem":1},{"lineBreak":true},{"text":"Diosta adurana fistayquicunata rurayna.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta aunishayquicunatapis cumliyna.","poem":1},{"lineBreak":true},{"text":"Yapayga imaypis manami fiyu runacunapa munaynincho canquipänachu.","poem":1},{"lineBreak":true},{"text":"Chay fiyu runacunaga ushajpänami ushacasha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}