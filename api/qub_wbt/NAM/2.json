{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"NAM","translationId":"qub_wbt","name":"NAHÚM","commonName":"NAHÚM","title":"Nahúm","order":34,"numberOfChapters":3,"sha256":"1bcd688dbb3b3e063a55493724767b692bb58847eea82cd0eb594e08eebd0c80","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/qub_wbt/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Nínive illgächisha cananpaj rimashan"]},{"type":"verse","number":1,"content":[{"text":"Nínive, gammanga illgächicojmi aywaycämun.","poem":1},{"lineBreak":true},{"text":"¡Sumaj curalasha siudäniquicunapa pergan jananman camacay ricachacojcuna!","poem":1},{"lineBreak":true},{"text":"¡Nänipa shamojta ricachacuy!","poem":1},{"lineBreak":true},{"text":"¡Espädayquita chegllayquiman sumaj watacuy!","poem":1},{"lineBreak":true},{"text":"¡Pillyanayquipaj sumaj camaricuy-llapa!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gamcunaga acrashä runacunatami magarayqui.","poem":1},{"lineBreak":true},{"text":"Ima-aycantapis guechushpayqui cachaycurayqui übas yöra garapachacashatanömi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi ichanga Jacobpita miraj Israelcunata yapay allimannami churaj-aywan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Masqui ricay, illgächejcunaga chayaycämunnami.","poem":1},{"lineBreak":true},{"text":"Paycunapa pillyar chapacunanga pucami.","poem":1},{"lineBreak":true},{"text":"Pillyanan röpanpis pucami.","poem":1},{"lineBreak":true},{"text":"Paycunaga pillyananpaj camaricushallanami carcaycan.","poem":1},{"lineBreak":true},{"text":"Carrëtancunaga caycan nina ratataycajnörämi.","poem":1},{"lineBreak":true},{"text":"Cawalluncunapis manami jamaytapis tarinnachu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chay carrëtacunaga goshtatayllami aywaycärin.","poem":1},{"lineBreak":true},{"text":"Cörriycunpis illguy achicyajnörämi.","poem":1},{"lineBreak":true},{"text":"Chay carrëtacunawanmi jawa caj cällicunapa cörrircaycan pergaman.","poem":1},{"lineBreak":true},{"text":"Jawa caj läsapana chayaycämun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mandajcunami mandaj suldäruncunata aywananpaj cachaycan.","poem":1},{"lineBreak":true},{"text":"Chaura paycunaga cörrin cumlinanpaj.","poem":1},{"lineBreak":true},{"text":"Paycunaga pergaman cörrin siudä ruriman yaycunanpaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siudäpa puncuncunatami amiriycärin.","poem":1},{"lineBreak":true},{"text":"Mayunöraj aypalla suldärucuna yaycuptinmi palasyupis juchucäcun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nínive runacunatana prësu apacun.","poem":1},{"lineBreak":true},{"text":"Chaymi uywaynin warmicunaga paluma wagajnöraj atarcaycan.","poem":1},{"lineBreak":true},{"text":"Wagashpan pëchuncunata tacacurcaycan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ishtanqui juchucäcuptin yacu bunyaylla aywacushannömi Nínive siudächo tiyajcunaga gueshpiycan.","poem":1},{"lineBreak":true},{"text":"«¡Ichiy-llapa! ¡Cutimuy!» nir gayacuptinpis manami pipis cutinnachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¡Guellayta apacuy-llapa! ¡Gorita apacuy-llapa!","poem":1},{"lineBreak":true},{"text":"¡Ninivecunapa riquësancunaga yupaytapis mana atipaypämi caycan!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nínive siudäga illgächishana, chunyaj jircaman ticrashana, pasaypa chaquishami caycan.","poem":1},{"lineBreak":true},{"text":"Runacunapaga manchariyllawanmi shonguncunapis tic-ticyaycan.","poem":1},{"lineBreak":true},{"text":"Gongurnincunapis sicsicyaycan.","poem":1},{"lineBreak":true},{"text":"Llapanpapis mananami callpan cannachu.","poem":1},{"lineBreak":true},{"text":"Cärancunapis yur'gasha utcunömi caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Cananga ¿maytaj liyuncunapa tiyanan machay?","poem":1},{"lineBreak":true},{"text":"¿Maytaj liyun-mallwacunapa tiyanan uchcu?","poem":1},{"lineBreak":true},{"text":"¿Maytaj liyuncunapis, liyun-mallwacunapis jauca goyänan parti?","poem":1},{"lineBreak":true},{"text":"¿Maytaj pipis mana manchachiptin goyashan caj parti?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Imataj päsasha wawancunapaj, china liyuncunapaj cäsata pedäsu-pedäsu rachipaj liyuntaga?","poem":1},{"lineBreak":true},{"text":"¿Imataj päsasha tiyanancunaman aychata shuntaj liyuntaga?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Munayniyoj Tayta Diosga caynömi nin:","poem":1},{"lineBreak":true},{"text":"«Nogaga gampa contrayquimi caycä.","poem":1},{"lineBreak":true},{"text":"Guërrapaj caj carrëtayquicunata ruparachishämi.","poem":1},{"lineBreak":true},{"text":"Ushajpämi uchpaman ticrarachishaj.","poem":1},{"lineBreak":true},{"text":"Mallwa liyun-mallwacunatami wañurachishaj.","poem":1},{"lineBreak":true},{"text":"Nasyunniquicho caj suwacunataga llapantami illgächishaj.","poem":1},{"lineBreak":true},{"text":"Chayno ruraycuptë ni willacojcunapis manami canganachu willacunanpaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}