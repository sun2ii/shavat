{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"NAM","translationId":"qub_wbt","name":"NAHÚM","commonName":"NAHÚM","title":"Nahúm","order":34,"numberOfChapters":3,"sha256":"1bcd688dbb3b3e063a55493724767b692bb58847eea82cd0eb594e08eebd0c80","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/qub_wbt/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Nínive ushajpaj illgächisha cananpaj rimashan"]},{"type":"verse","number":1,"content":[{"text":"¡Ay imanöraj canqui wañuchicur yawar mashtaraycajta cachaycoj Nínive runacuna!","poem":1},{"lineBreak":true},{"text":"Gamcunaga llullacuyllatami, wañuchinacuyllatami arurcaycanqui.","poem":1},{"lineBreak":true},{"text":"Mana jamaypami imaypis suwacurcaycanqui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sumbadurnincunata pashtachishanpis wiyacanganami.","poem":1},{"lineBreak":true},{"text":"Cawallucuna pagrarayllana cörrishan,","poem":1},{"lineBreak":true},{"text":"carrëtacuna aywashanpis wiyacanganami.","poem":1},{"lineBreak":true},{"text":"Ruyrancuna tumarishanpis wiyacanganami.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ricacanganami muntäducuna shamushanpis.","poem":1},{"lineBreak":true},{"text":"Espäda achicyaypa achicyashanta,","poem":1},{"lineBreak":true},{"text":"lansancuna chip-chipyashantapis ricay.","poem":1},{"lineBreak":true},{"text":"Waranganpa waranganpami malubrashacunapis canga.","poem":1},{"lineBreak":true},{"text":"Gotuyninpa-gotuyninpami wañushacunapis canga.","poem":1},{"lineBreak":true},{"text":"Intëruchömi wañushacunaga mashtaräconga.","poem":1},{"lineBreak":true},{"text":"Chayno captinmi mayman lluchcananpäpis mana jäcongachu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nínive, chaynöga päsashurayqui guellaypaj cacoj warmino achca nasyuncunata engañashayquipitami.","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj captiquimi juc-lä nasyuncunapis cuyacurcushurayqui.","poem":1},{"lineBreak":true},{"text":"Chaymi engañayta, brüju rurayta yachacusha.","poem":1}]},{"type":"verse","number":5,"content":["Munayniyoj Tayta Dios caynömi nin:",{"text":"«Nogaga gampa contrayquimi caycä.","poem":1},{"lineBreak":true},{"text":"Juc-lä nasyuncuna galallata ricashunayquipämi","poem":1},{"lineBreak":true},{"text":"umayquiyaj justanniquitapis shucuparcushayqui.","poem":1},{"lineBreak":true},{"text":"Chaymi fiyupa pengaycho ricacunquipaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fiyupa pengaycho canayquipämi camacächishaj.","poem":1},{"lineBreak":true},{"text":"Pengacunayquipaj ganra berbäjitami jillpushayqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Llapanpis ricashojcunaga gueshpirmi aywaconga cayno nishpan:","poem":1},{"lineBreak":true},{"text":"‹¡Nínive siudäga illgächishami caycan!","poem":1},{"lineBreak":true},{"text":"¿Piraj cuyapayconga?","poem":1},{"lineBreak":true},{"text":"¿Maychöraj pillatapis tarishwan shogananpaj?›","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Nínive, ¿gamga Tebas siudäpita mas munayniyojchuraj canqui?","poem":1},{"lineBreak":true},{"text":"Chay siudäga caycan Nilo mayupa lädunchömi.","poem":1},{"lineBreak":true},{"text":"Jatun mayumi chaparaycan.","poem":1},{"lineBreak":true},{"text":"Intëru cantunpa yacumi curalaraycan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chay siudätaga Etiopiawan Egiptumi fiyupa munayniyoj cashpan","poem":1},{"lineBreak":true},{"text":"imaypis washaj.","poem":1},{"lineBreak":true},{"text":"Fut runacunawan Libia runacunanami imaypis yanapaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chayno caycajtami Tebas runacunataga prësu aparan.","poem":1},{"lineBreak":true},{"text":"Wamrancunatapis cällipa isquïnancunaman apaycur pagshirgäriran.","poem":1},{"lineBreak":true},{"text":"Mayur runacunata apacunanpaj surtita jitaran.","poem":1},{"lineBreak":true},{"text":"Mandajnincunatanami cadinacunawan watacarcärir prësu apacuran.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gampis chaynömi machasha runano tapraycachaycanquipaj.","poem":1},{"lineBreak":true},{"text":"Imata ruraytapis mana camäpacushpayquimi contrayquicunapita pacacunquipaj.","poem":1},{"lineBreak":true},{"text":"Pacacunayquipaj ashir purinquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Llapan curalasha siudäniquicunaga canga ïgus yöra pogur päsaycajnömi.","poem":1},{"lineBreak":true},{"text":"Chay yörata pipis tapsiptenga ïgus shicwacun","poem":1},{"lineBreak":true},{"text":"cuyuchej micucurcunanpaj maquillamanna.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Suldäruyquicunaga caycan warminöllami.","poem":1},{"lineBreak":true},{"text":"Rancayquicunata nina rupar ushashanpitami","poem":1},{"lineBreak":true},{"text":"siudäniquicunapa puncuncunapis quicharaycan.","poem":1},{"lineBreak":true},{"text":"Chaymi contrayquicuna yaycamunanpaj libri caycan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gamcunaman contrayqui yaycamuptin","poem":1},{"lineBreak":true},{"text":"yacunayta awantanayquipaj yacuta churacuy.","poem":1},{"lineBreak":true},{"text":"Curral pergayquicuna mas sinchi cananpaj yapay.","poem":1},{"lineBreak":true},{"text":"Mituta lluchcay.","poem":1},{"lineBreak":true},{"text":"Nircorga gabërawan adöbita chutay.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ichanga chaychömi nina ushashunquipaj.","poem":1},{"lineBreak":true},{"text":"Sabliwanmi wañunquipaj; ushajpämi illgächishunquipaj.","poem":1},{"lineBreak":true},{"text":"¡Chüpacano aypallaman miray ari!","poem":1},{"lineBreak":true},{"text":"¡Chüpacacunano aypallaman miray ari!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gamcuna cajcho nigusyanticuna goyllarnörämi mirasha.","poem":1},{"lineBreak":true},{"text":"Chayno captinpis chüpacacuna älan wiñarcuptin pärir aywacushannömi","poem":1},{"lineBreak":true},{"text":"aywacongapaj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Guërrapaj runacunata charejcunaga caycan chüpacacunanömi.","poem":1},{"lineBreak":true},{"text":"Mandajcunaga caycan chuspi gashyariycajnömi.","poem":1},{"lineBreak":true},{"text":"Curucuna gasaywan pergacunaman lagacashannömi wiyacuycun.","poem":1},{"lineBreak":true},{"text":"Inti ratarcamuptenga aywacun.","poem":1},{"lineBreak":true},{"text":"Manami pipis musyannachu maypa aywashantapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«¡Asiriapa raynin, mandäshishojcunaga imanöshi puñucasha carcaycan!","poem":1},{"lineBreak":true},{"text":"Mandaj suldäruyquicuna jamaparcaycan.","poem":1},{"lineBreak":true},{"text":"Runacunanami wacpa caypa machicasha carcaycan.","poem":1},{"lineBreak":true},{"text":"Manami pipis canchu juc pachaman chaycunata shuntananpäga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Manami jampi cannachu gueriquipaj.","poem":1},{"lineBreak":true},{"text":"Gueriquega caycan mana allchacajmi.","poem":1},{"lineBreak":true},{"text":"Mana alliman chayashayquita mayajcunaga llapanmi cushicuywan macshongaraj.","poem":1},{"lineBreak":true},{"text":"¿Pï-mayraj mana ñacashachu fiyupa ñacachiptiqui?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}