{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"OBA","translationId":"qub_wbt","name":"ABDÍAS","commonName":"ABDÍAS","title":"Abdías","order":31,"numberOfChapters":1,"sha256":"1b78d0799958a01febf91caebe8ad6c4f08415d8b422cff24b5583f685678f76","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/qub_wbt/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Caychöga isquirbiraycan Abdiasta Tayta Dios ribilashanmi. Edom runacunapa contran rimashan Edom runacunapaj Tayta Diosga caynömi nin:",{"text":"«Nogaga Israelcunapa Tayta Diosninmi cä.","poem":1},{"lineBreak":true},{"text":"Juc cachatami nasyuncunaman cachashcä.","poem":1},{"lineBreak":true},{"text":"Chay cachami cayno niycan:","poem":1},{"lineBreak":true},{"text":"‹¡Aywashun-llapa! ¡Aywashun Edom runacunawan pillyaj!›","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Edom runacuna sumaj wiyamay.","poem":1},{"lineBreak":true},{"text":"Nogami camacächishaj llapan nasyuncunapita mas manacaj canayquipaj.","poem":1},{"lineBreak":true},{"text":"Pasaypa pengaymanmi churashayquipaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gamcunaga gaga shilli uchcucunacho tiyarmi alli-tucurcaycanqui.","poem":1},{"lineBreak":true},{"text":"Altunnin puntacunacho goyarmi yarparcaycanqui","poem":1},{"lineBreak":true},{"text":"pipis mana binsishunayquipaj cashanta.","poem":1},{"lineBreak":true},{"text":"Ichanga chayno alli-tucushpayqui quiquillayquimi engañacuycanqui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ancano may janajcama wichaptiquipis,","poem":1},{"lineBreak":true},{"text":"goyllarcuna caycashancho tiyanayquita ruraptiquipis chaypita garpamushayquipämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Suwacuna suwapäshunayquipaj chacaypa shamushpan","poem":1},{"lineBreak":true},{"text":"imayquitapis ushajpäga manami apacunmanchu.","poem":1},{"lineBreak":true},{"text":"Übasta pallajcuna gam cajman shamushpan","poem":1},{"lineBreak":true},{"text":"juc ishcay sartataga cachaycunmanrämi.","poem":1},{"lineBreak":true},{"text":"Gamcunatami ichanga contrayquicuna ushajpaj illgächishunquipaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gamcunataga ima-aycayquicunatapis ushajpämi guechushunquipaj.","poem":1},{"lineBreak":true},{"text":"Llapan aläjayquicunatami apacongapaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Llapan yanapäshojcunami engañashunquipaj.","poem":1},{"lineBreak":true},{"text":"Nasyunniquipitami jitarishunquipaj.","poem":1},{"lineBreak":true},{"text":"Asta yanasayquicunapis chiquicurcushunquipämi.","poem":1},{"lineBreak":true},{"text":"Mas yäracushayqui caj amistäniquicunami","poem":1},{"lineBreak":true},{"text":"llullapäshunquipaj mana alliman chayanayquipaj.","poem":1},{"lineBreak":true},{"text":"Edom runacuna, ¿maytaj musyaj yachaj cashayqui?","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Edom runacunata castigashä junäga llapan musyaj yachajcunatami illgächishaj.","poem":1},{"lineBreak":true},{"text":"Altucho tiyaj runacuna yachaj cashantapis gongachishämi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Manchariywanmi sicsicyanga Temancho caj pillyay yachajcunapis.","poem":1},{"lineBreak":true},{"text":"Gamcunacho tiyajcunaga ushajpämi wañonga.","poem":1}]},{"type":"heading","content":["Edompa ima juchan cashanpis"]},{"type":"verse","number":10,"content":[{"text":"«Fiyupa pengaypämi ricacunquipaj.","poem":1},{"lineBreak":true},{"text":"Nircurpis para-simrimi illganquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga canquipaj castayqui Israelcunata wañuchishayquipitami.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Carupita shamoj contrancuna Israelpa ima-aycantapis siudäpita apacuptin,","poem":1},{"lineBreak":true},{"text":"juc-lä nasyun suldärucuna Jerusalenpa puncuncunata paquir-ushaptin,","poem":1},{"lineBreak":true},{"text":"gamcunaga juc-läman witicurirayqui.","poem":1},{"lineBreak":true},{"text":"Guechushancunata raquipänacunanpaj surtita jitaptin, ima-aycantapis apacuptin,","poem":1},{"lineBreak":true},{"text":"chay guechoj runacunanömi gamcunapis rurarayqui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ama cushicunquimanchu caran castayquicuna","poem":1},{"lineBreak":true},{"text":"mana alliman chayasha caycajta ricaycashpayquega.","poem":1},{"lineBreak":true},{"text":"Ama cushipanquimanchu caran Judá ragällan quëdashan öra.","poem":1},{"lineBreak":true},{"text":"Ama asipanquimanpischu caran paycuna llaquicuycashan öra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Acrashä runacuna fiyupa llaquicuycashan öra","poem":1},{"lineBreak":true},{"text":"ama siudäninman yaycunquimanchu caran.","poem":1},{"lineBreak":true},{"text":"Paycuna mana allicho caycashan öraga","poem":1},{"lineBreak":true},{"text":"ama cushipanquimanchu caran.","poem":1},{"lineBreak":true},{"text":"Paycuna mana allicho caycashan öra","poem":1},{"lineBreak":true},{"text":"ama imancunatapis suwapanquimanchu caran.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tincoj nänicunachöpis ama shuyanquimanchu caran","poem":1},{"lineBreak":true},{"text":"gueshpicuycajcunata wañuchinayquipaj.","poem":1},{"lineBreak":true},{"text":"Fiyupa llaquicushpan gueshpicuycajcunata","poem":1},{"lineBreak":true},{"text":"contrancunaman ama entreganquimanchu caran.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Imanömi juccunata rurashcanqui,","poem":1},{"lineBreak":true},{"text":"chaynöllami gamcunatapis rurashunquipaj.","poem":1},"Llapan nasyun runacunata jusgananpaj cashan",{"text":"«Shamur llapan nasyuncunata jusganä junajpäga wallcanami pishiycan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Imanömi gamcuna rispitädu puntächo cushicur machänayquicama upurayqui,","poem":1},{"lineBreak":true},{"text":"chaynömi llapan nasyuncunapis castigaptë ashgaj cöpata upongapaj.","poem":1},{"lineBreak":true},{"text":"Paycunaga wicyayllami upongapaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami paycunaga ushajpaj illgangapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Sión lömacho ichanga waquin acrashä runacuna cawaycar quëdangapaj.","poem":1},{"lineBreak":true},{"text":"Chaypitaga Jacobpita mirar aywajcuna chacrancunata yapay shuntangami.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chay Israel runacunawan Judá runacunaga canga ninano,","poem":1},{"lineBreak":true},{"text":"nina wapchar imatapis ushacurcojno.","poem":1},{"lineBreak":true},{"text":"Esaüpita miraj Edom runacunami ichanga canga ogshano.","poem":1},{"lineBreak":true},{"text":"Chauraga chay ninano cajcunami ushajpaj usharengapaj.","poem":1},{"lineBreak":true},{"text":"¡Edom runacunaga manami jucnayllapis salbacongapächu!","poem":1},{"lineBreak":true},{"text":"Noga Tayta Diosmi nishcä chayno cananpaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chay cawaycar quëdaj Israelcunaga Néguev partitami, Edom jircacunatami shuntanga.","poem":1},{"lineBreak":true},{"text":"Paycuna waquenga shuntanga löma-löma guechwatapis Filistea partitapis.","poem":1},{"lineBreak":true},{"text":"Paycuna waquenga shuntanga Efraín partita, Samariata, Benjamín partita, Galaadtapis.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Röpanpa juc-läman prësu aywaj Israelcunaga shuntanga Canaán partita Sarepta siudäcama.","poem":1},{"lineBreak":true},{"text":"Jerusalenpita Sefaradman prësu aywajcunapis shuntanga Neguevcho caycaj siudäcunata.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Llapanta binsiycurnami Sión lömaman aywanga.","poem":1},{"lineBreak":true},{"text":"Chaypitanami Edom runacunataga maquincho chararanga.","poem":1},{"lineBreak":true},{"text":"Ichanga llapanpis nogapa maquëchömi caycanga.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}