{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":1,"content":[{"type":"heading","content":["Cay libruta imapaj isquirbishanpis"]},{"type":"verse","number":1,"content":["Israelpa raynin Davidpa wamran ray Salomón rimashanmi cay rimaycunaga."]},{"type":"verse","number":2,"content":["Cay rimaycunataga isquirbisha:",{"text":"Chayta yachacur runacuna yachaj cananpämi,","poem":1},{"lineBreak":true},{"text":"yarpaysapa cananpämi,","poem":1},{"lineBreak":true},{"text":"yachaj runacuna parlashanta tantiyacunanpämi,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"willapashancunata chasquicunanpämi,","poem":1},{"lineBreak":true},{"text":"quiquin tantiyacunanpaj,","poem":1},{"lineBreak":true},{"text":"allillata rurananpaj,","poem":1},{"lineBreak":true},{"text":"furmal cananpaj;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"mana yarpachacoj mösucunata tantiyachinanpaj,","poem":1},{"lineBreak":true},{"text":"yarpaysapa cananpaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yachajcunapis,","poem":1},{"lineBreak":true},{"text":"yarpaysapacunapis cay rimaycunata wiyarga masmi yachacun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chauraga tantiyanmi yarpaysapacuna parlashanta,","poem":1},{"lineBreak":true},{"text":"adibinansancunata, willapancunata.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rasunpa yachaj canapäga rimëru Tayta Diostami rispitar yäracuypaj.","poem":1},{"lineBreak":true},{"text":"Tantiyacuyta mana munajcunami ichanga alli yachachicuycunatapis, willapashancunatapis manacajman churan.","poem":1}]},{"type":"heading","content":["Mösucunata willapashan"]},{"type":"verse","number":8,"content":[{"text":"Ïju, taytayqui willapäshushayquita sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Mamayqui tantiyachishushayquitaga ama gongaychu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chay willapäshushayqui, chay tantiyachishushayqui gampäga canga cuyayllapaj adurnunömi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ïju, juchasapacuna juchata rurachiyta munashuptiqui","poem":1},{"lineBreak":true},{"text":"ama ruranquichu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paycunaga capas nishunquiman:","poem":1},{"lineBreak":true},{"text":"«Aywashun. Runacuna näninpa aywajta pacacuycullar shuyaräshun.","poem":1},{"lineBreak":true},{"text":"Alli runa päsacuycajta wañurachishun.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Alli runacunataga illajpita illgarachishun,","poem":1},{"lineBreak":true},{"text":"gueshya charir imanömi illajpita wañurachin, chayno.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chayno rurarmi rïcuyäshun.","poem":1},{"lineBreak":true},{"text":"Chaynöpami wasinchichöpis imapis mana pishëmäshunpächu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Juc pachallacho goturpäshun. Llapanta yarpashanchïno rurashun.","poem":1},{"lineBreak":true},{"text":"Guechushanchëga llapanchïpämi canga» nir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ïju, paycunawanga ama goturaychu.","poem":1},{"lineBreak":true},{"text":"Paycuna yarpashan juchataga ama ruräshiychu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Paycunaga imay örapis yarparaycan mana allita rurayllapämi.","poem":1},{"lineBreak":true},{"text":"Wañuchicuyllatami yarparcaycan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Pichiusacuna ricaycaptenga","poem":1},{"lineBreak":true},{"text":"yangallami trampatapis churanchi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chay runacunami ichanga quiquin mana alliman chayanallanpaj llapantapis camariycan.","poem":1},{"lineBreak":true},{"text":"Quiquillanmi wañuytapis ashircaycan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chaynömi yargaj runacunapis:","poem":1},{"lineBreak":true},{"text":"Yargaj-cashallanwanmi wañuytapis tarin.","poem":1}]},{"type":"heading","content":["Yachaj cananpaj willapashan"]},{"type":"verse","number":20,"content":[{"text":"Yachayga willacoj warminöpis cällicunachömi,","poem":1},{"lineBreak":true},{"text":"läsacunachömi sinchipa gayacuycan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"May-chaychöpis achca runa cashanchömi willacuycan.","poem":1},{"lineBreak":true},{"text":"Siudäman yaycuna puncucunachöpis willacuycanmi:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"«Mana tantiyacojcuna,","poem":1},{"lineBreak":true},{"text":"¿imaycamaraj llutancunallapaj yarparaycanqui?","poem":1},{"lineBreak":true},{"text":"Pitapis mana cäsoj mösucuna,","poem":1},{"lineBreak":true},{"text":"¿imaycamaraj pï-maytapis asipar cushipanqui?","poem":1},{"lineBreak":true},{"text":"Yarpayniynaj mösucuna,","poem":1},{"lineBreak":true},{"text":"¿imaycamaraj yachaj caytapis manacajman churarcaycanqui?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Willapashäcunata sumaj wiyacuy-llapa.","poem":1},{"lineBreak":true},{"text":"Chauraga nogami llapan yachashäta musyachishayqui.","poem":1},{"lineBreak":true},{"text":"Yarpaynëcho caycajtaga llapantami yachachishayqui.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yaparir yaparirmi gamcunataga shamunayquipaj willashcä.","poem":1},{"lineBreak":true},{"text":"Chaypis manami cäsumashcanquichu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Chaypa ruquenga willapashäcunatapis manami wiyacushcanquichu.","poem":1},{"lineBreak":true},{"text":"Piñacur tantiyachishäcunatapis manami chasquicushcanquichu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Chaypitami mana allicunaman chayaptiqui nogapis cushipäshayqui.","poem":1},{"lineBreak":true},{"text":"Fiyupa manchariycashayqui örami asipäshayquipaj.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Manchacushayqui löcu tamyano, disigrasya illajpita löcu wayrano chayashuptiqui,","poem":1},{"lineBreak":true},{"text":"ima ruraytapis mana camäpacur fiyupa llaquicuycaptiquimi cushipäshayquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Chay öraga gayacamaptiquipis manami wiyashayquinachu.","poem":1},{"lineBreak":true},{"text":"Ashimarpis manami tarimanquipänachu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Gamcunaga yachayta manacajmanmi churaycanqui.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta rispitaytapis manami munanquichu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tantiyachiptëpis manami tantiyacushcanquichu.","poem":1},{"lineBreak":true},{"text":"Piñacur willapashäcunatapis manacajmanmi churashcanqui.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mana wiyacushayquipitami fiyupa ñacanquipaj.","poem":1},{"lineBreak":true},{"text":"Juchayqui-tupumi fiyupa ñacayman chayanquipaj.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Mana tantiyacojcunaga mana tantiyacushanpitami wañuymanpis chayan.","poem":1},{"lineBreak":true},{"text":"Tantiyacuyta mana munajcunapis imapäpis mana yarpachacushpanmi ushacan.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Willapashäta chasquicojcunami ichanga cushishalla goyanga.","poem":1},{"lineBreak":true},{"text":"Imapitapis mana manchacuypa goyanga.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}