{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Runaga imata ruraytapis yarpanmi.","poem":1},{"lineBreak":true},{"text":"Chaypis Tayta Diosrämi camacächin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Runataga llapan rurashancunapis alli-niräpunmi.","poem":1},{"lineBreak":true},{"text":"Chaypis Tayta Diosrämi nin alli u mana alli yarpashancuna cashantapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Imata ruranayquipaj yarpashayquitapis Tayta Diospa maquinman churay.","poem":1},{"lineBreak":true},{"text":"Paymi camacächenga yarpashayquicuna alli llojshinanpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tayta Diosga yarpashanno cananpämi llapantapis camasha.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunapämi castïgutaga camasha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alli-tucojcunataga Tayta Dios melanäcunmi.","poem":1},{"lineBreak":true},{"text":"Chaycunataga simrimi castiganga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Rasunpa cuyarga juchanpita perdunanmi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta wiyacorga jucha ruraypita witicunmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tayta Dios munashanno runa cawar alli goyaptenga","poem":1},{"lineBreak":true},{"text":"chiquipajcunawanpis allina goyänanpämi camacächin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ichicllatapis quiquin ñacar tarishanmi mas alliga","poem":1},{"lineBreak":true},{"text":"engañayllapa ima-aycatapis shuntashanpitaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Runaga imata rurananpäpis yarpachacun.","poem":1},{"lineBreak":true},{"text":"Chaypis Tayta Diosrämi camacächin imano cananpäpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rayga Tayta Dios musyachishancunatami riman.","poem":1},{"lineBreak":true},{"text":"Manami llutancunatachu arriglanpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Alli pësa cananpaj, alli tupu cananpäpis Tayta Diosmi camacächisha.","poem":1},{"lineBreak":true},{"text":"Chaymi Tayta Dios munan alli balansata, alli pësacunata.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Raycunaga mana alli ruraycunata melanäcunmi.","poem":1},{"lineBreak":true},{"text":"Rayga alli mandan llapanpis allillata ruraptinrämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Runa mana chapaypa rasun cajta rimaptenga","poem":1},{"lineBreak":true},{"text":"raycuna cuyashpan alli ñawinpami chay runata rican.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ray ollgucurcuptenga wañuchichinanpaj cashan musyacannami.","poem":1},{"lineBreak":true},{"text":"Yachajcunami ichanga rayta ollguycajtapis alliyächin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ray cushishalla captenga runacunapis allilla goyaytami yarpan.","poem":1},{"lineBreak":true},{"text":"Ray allilla carga timpuncho tamya tamyamushannömi cushicachin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Gorita chararashanpita mas alliga yachaj caymi.","poem":1},{"lineBreak":true},{"text":"Guellaypitapis mas alliga tantiyaj caymi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Alli runacunaga jucha ruraypita witicunmi.","poem":1},{"lineBreak":true},{"text":"Jucha ruraypita witicojcunaga alli cawaymanmi chayanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Alli-tucojcunaga ushapacangami.","poem":1},{"lineBreak":true},{"text":"Jucta manacajman churajcunaga mana allimanmi chayanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Alli-tucoj rïcucunawan goturänanpitaga","poem":1},{"lineBreak":true},{"text":"mas alli caycan manacajman mana churaypa pobricunawan goturaymi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tayta Dios nishanta wiyacorga allichömi canga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosman yäracojcunaga cushishami canga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Allita yarpachacojcunataga «yarpaysapa» ninmi.","poem":1},{"lineBreak":true},{"text":"Cuyachicuypa parlarga masrämi pitapis aunichin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Alli yarpayniyoj cashanga cawachicoj yacunömi.","poem":1},{"lineBreak":true},{"text":"Mana tantiyacojcunata yachachiyga manacajllapämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yarpaysapacunaga sumaj yarpachacurcurmi imatapis riman.","poem":1},{"lineBreak":true},{"text":"Parlashancunaga allimi tantiyachicun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Alli shimillanpa parlashanga urunguypa mishquinnörämi.","poem":1},{"lineBreak":true},{"text":"Alli goyaypämi shacyächicun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Runataga purishancuna alli-niräpunmi.","poem":1},{"lineBreak":true},{"text":"Ichanga chay caminupa wañuymanmi aywaycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Aroj runaga micunanpämi arun.","poem":1},{"lineBreak":true},{"text":"Micunan-raycumi arun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Fiyu runaga rataycaj jurnunömi.","poem":1},{"lineBreak":true},{"text":"Llapan rimashancunapis caycan ninapa wapchayninnörämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Fiyu runacunaga imay örapis rimanacachiyllatami ashiycan.","poem":1},{"lineBreak":true},{"text":"Washa-rimacunapis amïguncunatawan chiquinacachinmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Fiyu runaga amïguntapis engañanmi.","poem":1},{"lineBreak":true},{"text":"Payga amïgunta llutanmanmi gaycun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Mana allita rurayta yarpajcunaga ñipchipayllapami sëñata rurashunqui.","poem":1},{"lineBreak":true},{"text":"Mana allita rurariycorga shimi wirpanta amucurcun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Allillata rurajcunaga chachayänancamami cawan.","poem":1},{"lineBreak":true},{"text":"Sogu caynenga corönanömi cushicachin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Alli chölu-tucuypitaga mas alli pasinsacuymi.","poem":1},{"lineBreak":true},{"text":"Llapan marcapa mandajnin cananpitaga mas alli caycan quiquinraj alli duminacuyta yachashanmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Imata rurananpäpis runaga surtitami jitan.","poem":1},{"lineBreak":true},{"text":"Chaypis Tayta Diosrämi camacächin.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}