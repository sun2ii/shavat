{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Quiquin munashanno cawajcunaga quiquillanpämi imatapis ashin.","poem":1},{"lineBreak":true},{"text":"Alli cajta willapashancunataga manami wiyacunchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mana tantiyacoj upacunaga imata yachacuytapis manami munanchu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga yachashallanwanmi alabacun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mana allita rurajcunaga pengaychömi ricaconga.","poem":1},{"lineBreak":true},{"text":"Alli-tucojcunapis manacajman churashami canga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yachaj runa parlashanga achca yacuta pashtaj pucyunömi bindisyun caycan.","poem":1},{"lineBreak":true},{"text":"Yachayninpis caycan mana pishiypa aywaj achca yacunömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Autoridäcuna juchayojcunapa faburnin captenga manami allichu.","poem":1},{"lineBreak":true},{"text":"Ima juchanpis mana caycaptin «juchayojmi» nir arriglaptenga manami allichu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mana tantiyacojcunaga shimillanpitami rimanacuyman chayan.","poem":1},{"lineBreak":true},{"text":"Quiquinpa shiminpitami asticanpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mana tantiyacoj upacunataga shimillanmi mana alliman chayachin.","poem":1},{"lineBreak":true},{"text":"Quiquinpa shimillanpitami maticanpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Washa-rimacunaga rimanpis mishquillarämi.","poem":1},{"lineBreak":true},{"text":"Chasquipajpänami caycan shonguncama alli chayajnöraj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Guella runacunawan fiyu runacunaga","poem":1},{"lineBreak":true},{"text":"chay wauguimannöllami tincun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tayta Diosga caycan mana tunej alli arusha törrinömi.","poem":1},{"lineBreak":true},{"text":"Alli runacuna payman yäracojtaga imapitapis chapanmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rïcu runaga yarpan imapis mana chayanantami.","poem":1},{"lineBreak":true},{"text":"Yarpan ima-aycanpis siudäta intërunpa curalaraycajno chapänanpaj cashantami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Alli-tucojcunaga ushapacaymanmi chayanga.","poem":1},{"lineBreak":true},{"text":"Umildicunami ichanga pï-maypitapis rispitasha canga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tapucunanpaj caycajta manaraj sumaj musyar willayga","poem":1},{"lineBreak":true},{"text":"mana tantiyaj caymi, fiyupa pengaypämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Cushisha carga gueshyaycashanpitapis allchacanmi.","poem":1},{"lineBreak":true},{"text":"Llaquisha, gänasnin mana cajtaga ¿piraj allchacächenga?","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Alli yachaj runawan alli tantiyaj runaga","poem":1},{"lineBreak":true},{"text":"yachacuyta munashanta llapantami yachacun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Imallatapis buluntäninpa goycuptenga pï-maypis allimi jamachin.","poem":1},{"lineBreak":true},{"text":"Mayur runacunapis allimi rican.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Rasun cajtanöraj dimandacur «caynömi, wacnömi casha» niptin","poem":1},{"lineBreak":true},{"text":"chay dimandashan caj chayamur «manami chaynöchu» niptinrämi pengay-tucusha wiyaycun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Sasa arriglaytaga ushacächin surtita jitaypanami.","poem":1},{"lineBreak":true},{"text":"Chaynöparämi dimanduga alli ushacan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sumaj curalasha siudäpa pergancunata juchuchiypis fäsirämi canman wauguin jagayächishan runata shogananpitaga.","poem":1},{"lineBreak":true},{"text":"Rimanacuyga caycan mana pipis yaycunanpaj rancasha caycaj puncunömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Runaga parlashanwanmi imatapis chasquenga.","poem":1},{"lineBreak":true},{"text":"Shiminpitami imatapis tarenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Wañuytapis cawaytapis shiminpitami tarin.","poem":1},{"lineBreak":true},{"text":"Alläpa rimajcunaga shiminpitami imanöpis ñacanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Furmal warmiwan majachacayga fiyupa allimi.","poem":1},{"lineBreak":true},{"text":"Furmal warmitaga tarin Tayta Dios bindisyunta goptinmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Pobriga alli shimillanpami imapitapis ruwacun.","poem":1},{"lineBreak":true},{"text":"Rïcumi ichanga imallapitapis fiyu shiminpa cutichin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Waquenga amïgupis ichicllapämi caycan.","poem":1},{"lineBreak":true},{"text":"Waquinmi ichanga amïgupis juc wauguipitapis mas wauguiraj.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}