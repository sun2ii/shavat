{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Pobrillapis mana suwa caymi mas alliga","poem":1},{"lineBreak":true},{"text":"mana tantiyaj upa, tumpacoj cananpitaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mana yarpachacuyllapa imatapis juclla rurashaga manami allichu.","poem":1},{"lineBreak":true},{"text":"Mana yarpachacuyllapa imatapis rurarga pantanmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mana tantiyaj runaga upa cayninwanmi llutanta ruran.","poem":1},{"lineBreak":true},{"text":"Nircorga Tayta Diostana jitapan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ima-aycanpis bastanti captinmi rïcupaga pï-maypis amïgullan.","poem":1},{"lineBreak":true},{"text":"Pobritami ichanga amïguncunapis gongaycärin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alman ranticojcunaga castïguchömi canga.","poem":1},{"lineBreak":true},{"text":"Llullacunapis castïguchömi canga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Achcajmi rïcupa maquintaga rispitar muchan.","poem":1},{"lineBreak":true},{"text":"Tarichicojtapis llapanmi ashin amïgun cananpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pobritaga famillyancunapis manacajmanmi churan.","poem":1},{"lineBreak":true},{"text":"Chayno caycaptenga rasuntachari amïguncunapis mana witipannachu.","poem":1},{"lineBreak":true},{"text":"Amïgupayta ashiptinpis pacacaycärinmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Runaga alli cawayta munar allimi yachacun.","poem":1},{"lineBreak":true},{"text":"Yachacushanno rurarga alli cajllatami ruran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Alman ranticojcunaga castïguchömi canga.","poem":1},{"lineBreak":true},{"text":"Llullacunatapis wañuymi shuyaraycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yarpayniynaj mana tantiyäga yangami mishti-tucunpis.","poem":1},{"lineBreak":true},{"text":"Uyway runacunapis manami mayur runacunapa mandajnin canmanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yarpaysapa runaga imapitapis pasinsacunmi.","poem":1},{"lineBreak":true},{"text":"Achäquita ashipajcunatapis perdunanmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ray ollgorga liyunno manchacuypämi.","poem":1},{"lineBreak":true},{"text":"Ray cushisha captenga guewaman shullay chayajnömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mana tantiyacoj wamraga taytanta llaquicachinmi.","poem":1},{"lineBreak":true},{"text":"Shimisapa warmipis mana chawaypa jutoj wasinömi achäquita ashipayta mana jamanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mamapita taytapitami wasita chacrata chasquin.","poem":1},{"lineBreak":true},{"text":"Alli yarpayniyoj warmitanami Tayta Diospita chasquin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Guellaga guellanaywanmi puñuyllacho cacun.","poem":1},{"lineBreak":true},{"text":"Chaymi guella runaga imaypis yargayllacho canga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mandamintuta cumlejcunaga alli cawaytami tarenga.","poem":1},{"lineBreak":true},{"text":"Yachachishanta manacajman churajmi ichanga wañuyta tarenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Pobrita yanapäga Tayta Diostami ristaycan.","poem":1},{"lineBreak":true},{"text":"Chayno yanapashanpitaga quiquin Tayta Diosmi cutichenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Wamrayquitaga tacsha cashancama piñacur astiy.","poem":1},{"lineBreak":true},{"text":"Ichanga cuydä castigaycällar wañuycachinquiman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Juclla rabyacäcöga castigashami canga.","poem":1},{"lineBreak":true},{"text":"Ñacaycajta salbarga chaynöllami yaparir-yaparir salbaycanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Willapäshushayquita wiyacuy. Piñacushushayquitapis chasquicuy.","poem":1},{"lineBreak":true},{"text":"Chayno car-rämi yachaj canquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Runaga ima-aycata ruraytapis yarpanmi.","poem":1},{"lineBreak":true},{"text":"Chaypis Tayta Dios camacächishan cajllami camacan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Runataga nishanta cumlej alli canantami pipis munan.","poem":1},{"lineBreak":true},{"text":"Trampösu cananpa ruquenga pobrilla cacuptinpis mas allimi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tayta Diosta rispitar manchacoj cäga","poem":1},{"lineBreak":true},{"text":"alli cawaytami tarin.","poem":1},{"lineBreak":true},{"text":"Chaynöpami alli goyan.","poem":1},{"lineBreak":true},{"text":"Manami imamanpis chayanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Guella runaga lätun churapacusha caycarpis","poem":1},{"lineBreak":true},{"text":"manami ni micunallanpäpis chagarcunchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Shimisapa runata castigaptinmi mana tantiyacöga yachacun.","poem":1},{"lineBreak":true},{"text":"Alli tantiyacoj yachaj runami ichanga juc willapayllacho yachacun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Taytanta magaj runaga fiyupa jamurpaypaj gueshyami.","poem":1},{"lineBreak":true},{"text":"Mamanta wasinpita gargoj runaga fiyupa melanaypämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ïju, llapan corrijishushayquita wiyacuy.","poem":1},{"lineBreak":true},{"text":"Mana wiyacorga llutan caminupami purinquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Alman ranticojcunaga juezpitapis asicunmi.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunaga shimin tarishantami riman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Shimisapacuna castigacänanpaj asticunaga caycanmi.","poem":1},{"lineBreak":true},{"text":"Mana tantiyacoj upa runapis wajtan rawaychaj-rawaychajmi asticanga.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}