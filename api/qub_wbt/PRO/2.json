{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":2,"content":[{"type":"heading","content":["Tantiyacoj car alli cawananchïpaj nishan"]},{"type":"verse","number":1,"content":[{"text":"Ïju, willapashäcunata sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Willapashä mandamintucunatapis umayquiman sumaj churay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yachaj canayquipaj sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Tantiyachishäcunataga ushajpaj umayquiman churay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Llapan shonguyquipa llapan callpayquiwan mañacuy","poem":1},{"lineBreak":true},{"text":"yachaj canayquipaj, yarpaysapa canayquipaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chaytaga ashiy pamparaj guellayta, gorita ashejno.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chayrämi tantiyanquipaj Tayta Diosta imano rispitana cashantapis.","poem":1},{"lineBreak":true},{"text":"Chaynöpami Tayta Diostapis rejsinquipaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Diosllami yachaytapis yachachimanchi.","poem":1},{"lineBreak":true},{"text":"Payllami tantiyachimanchïpis, yarpaysapayächimanchïpis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Juchata mana rurajcunata","poem":1},{"lineBreak":true},{"text":"Payga yanapanmi, imapitapis chapanmi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Allillata rurar cawajcunataga Tayta Diosmi cuydan.","poem":1},{"lineBreak":true},{"text":"Payman yäracojcunataga imapitapis chapanmi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chauraga musyanquipämi alli cajtapis, rasun cajtapis.","poem":1},{"lineBreak":true},{"text":"Tayta Dios munashanno goyaytapis musyanquipämi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fiyupami yachanquipaj.","poem":1},{"lineBreak":true},{"text":"Yachaj carga cushishami goyanquipaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tantiyaj cashayquiwan yarpaysapa cashayquega","poem":1},{"lineBreak":true},{"text":"manami ima mana allimanpis chayachishunquipächu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Chaypitami llutan mana alli ruraycunapitapis chapäshunquipaj.","poem":1},{"lineBreak":true},{"text":"Juchasapa runacunapitapis salbashunquipaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Salbashunquipaj alli rurayta cachaycur jucha rurayman cutej runacunapa maquinpita.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Washäshunquipaj mana allita rurariycur cushicojcunapita;","poem":1},{"lineBreak":true},{"text":"llutancunata rurariycur cushicuypita fistata rurajcunapita.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chay runacunaga allita ruraycashantami cachaycusha.","poem":1},{"lineBreak":true},{"text":"Llutancunata rurarmi pantacasha carcaycan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Runanta raysunaj warmicunapitapis chapäshunquipämi.","poem":1},{"lineBreak":true},{"text":"Alli shimillanpa parlapäshuptiquipis gamga manami gaticurcunquipächu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chay warmiga jipash cashanpita-pacha caj majantapis cachaycunmi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta aunishantapis gongaycunmi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Majanta raysunaj warmiwan cacuyga jucha aparicuymi.","poem":1},{"lineBreak":true},{"text":"Chay warmiwan cacorga juchasapacuna wañur aywashanmanmi aywaycan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chay warmita gaticurcöga manami allimanga cutinnachu.","poem":1},{"lineBreak":true},{"text":"Manami alli caminupa purinnachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ïju, gam ichanga alli caminupa puriy.","poem":1},{"lineBreak":true},{"text":"Allillata ruraj runacunano goyay.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dios munashanno goyajcunami, pipis mana rimasha goyajcunami","poem":1},{"lineBreak":true},{"text":"cay pachacho alli cawanga.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fiyu runacuna, mana yäracuypaj runacuna ichanga jachata achurisha illgajnömi cay pachapita illganga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}