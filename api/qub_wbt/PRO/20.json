{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Machacurcorga runacuna alli chölu-tucunmi.","poem":1},{"lineBreak":true},{"text":"Upyacarcärerga quiquin-purami rimanacun.","poem":1},{"lineBreak":true},{"text":"Machashaga manami pipis yarpayninchöchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ray ollgorga liyunno manchacuypämi.","poem":1},{"lineBreak":true},{"text":"Chayno caycajtaga wañuyta ashillarmi pipis achäquita ashipan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Piwanpis mana rimanacoj runaga alli rispitashami.","poem":1},{"lineBreak":true},{"text":"Mana tantiyacoj runami ichanga piwanpis juclla rimanacun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Murupacuy wichanpis guella runaga manami yapyapacunchu, ni murupacunchu.","poem":1},{"lineBreak":true},{"text":"Chaymi cosëcha wichanpis ashipacushpan imatapis mana tarengachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Shongullancho runa yarpashanga jundu yacunömi.","poem":1},{"lineBreak":true},{"text":"Alli yachaj tantiyacoj runami ichanga musyan imano tariytapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Quiquillanpitaga pipis alli runa cashantami yarpan.","poem":1},{"lineBreak":true},{"text":"Chaypis ¿piraj tarinman rasunpa yäracuypaj caj runataga?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Allita ruraj runaga allita rurallarmi goyan.","poem":1},{"lineBreak":true},{"text":"Chayno alli runapaga wamrancunapis cushishami goyanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Arriglananpaj despächunman jamaycur rayga","poem":1},{"lineBreak":true},{"text":"rasunpa juchayojcunataga ricapärillarmi rejsirin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Pipis ama ninmanchu: «Nogaga allita rurallarmi cawä.","poem":1},{"lineBreak":true},{"text":"Manami juchataga imaypis rurashcächu» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Suwa pësatawan pishi tuputa","poem":1},{"lineBreak":true},{"text":"ishcantami Tayta Dios melanäcun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Alli mösu cashanta rejsinchi yanapäcoj y rispitösu captinmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tayta Diosga ñawitami camaran imano ricananchïpäpis.","poem":1},{"lineBreak":true},{"text":"Rinritanami camaran imata wiyananchïpäpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Puñuyllataga ama aruychu.","poem":1},{"lineBreak":true},{"text":"Puñuyllacho cacorga pobriyanquipämi.","poem":1},{"lineBreak":true},{"text":"Arucuptiqui ruracuptiquega micuyniquipis manami pishengachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Rantinanpäga «cayga manami allichu» ninmi.","poem":1},{"lineBreak":true},{"text":"Rantircurmi ichanga «allita rantishcä» nir cushicun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Goripitawan aypalla guellaypitapis","poem":1},{"lineBreak":true},{"text":"mas alliga yachayninwan yachaj rimashanmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Jäpa runata garantiyajtaga asta röpantapis guechuy.","poem":1},{"lineBreak":true},{"text":"Nircorga rinda chararay jagata päganancama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Runapäga capas fiyupa mishquin engañaypa tarishan micuy.","poem":1},{"lineBreak":true},{"text":"Chaypita unayllataga ricacun amuy aguta micushannöllami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Imata rurananpäpis alliga camacan sumaj tapucuriptinrämi.","poem":1},{"lineBreak":true},{"text":"Imano pillyananpäpis sumaj yarpachacurir-rämi guërrata ruran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Washa-rimaga imata willashantapis manami upällallaga cacunchu.","poem":1},{"lineBreak":true},{"text":"Chaymi washa-rimacunawanga ama gotucanquichu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mamanta taytanta amatar ñacachëga maldisyunädumi canga.","poem":1},{"lineBreak":true},{"text":"Chayga fiyupa ñacar cuyapaypämi wañonga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mana ñacayllapa rïcuyashanga fäsimi ushacanga.","poem":1},{"lineBreak":true},{"text":"Chauraga llaquishallanami goyanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Pipis mana allita rurashuptiqui ama yarpaychu ayñita cutichiytaga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosllaman yäracuy. Chaura Paymi yanapäshunquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tayta Diosga chiquinmi suwa pësata.","poem":1},{"lineBreak":true},{"text":"Payga manami munanchu suwa balansatapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Tayta Diosmi runa imano cawananpäpis camacächin.","poem":1},{"lineBreak":true},{"text":"Quiquin runaga manami musyanchu imanöpaj distïnun cashantapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Fiyupa mana allimi caycan","poem":1},{"lineBreak":true},{"text":"mana yarpachacuyllapa Tayta Diosta goycunanpaj aunircur cutiricuptenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Yachaj rayga rïguta wayrajnömi fiyucunata acran.","poem":1},{"lineBreak":true},{"text":"Nircur paycunataga rïgupa päjanta gollpojnömi illgarachenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Tayta Diosmi espiritunta runaman churasha.","poem":1},{"lineBreak":true},{"text":"Chaynöpami runaga yarpashancuna alli mana alli cashantapis musyan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Rasun cajta ruraj captin, cuyapäcoj captin","poem":1},{"lineBreak":true},{"text":"raytaga pipis manami jitarinchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Timpu callpallancho cashpan mösucunaga cushicunmi.","poem":1},{"lineBreak":true},{"text":"Ajchan soguna captinmi auquincunatapis rispitan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Mana allita rurajcunapäga yawar-yawar astiyrämi jampi.","poem":1},{"lineBreak":true},{"text":"Castïguwanrämi juchasapacunapis tantiyacun.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}