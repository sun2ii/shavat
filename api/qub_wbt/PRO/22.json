{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Aypalla gorita, guellayta charänanpa ruquin","poem":1},{"lineBreak":true},{"text":"mas alliga caycan pï-maywanpis rejsinacushanmi, alli parlasha cashanmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rïcutapis pobritapis Tayta Diosllami rurasha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Alli tantiyacoj runaga mana alliman chayananpaj cashanta musyar witicunmi.","poem":1},{"lineBreak":true},{"text":"Mana tantiyacoj runami ichanga mana cäsupaypa aywar fiyupa ñacayman chayan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Umildi cashpan, Tayta Diosta rispitaptenga","poem":1},{"lineBreak":true},{"text":"Paymi camacächin chay runa ima-aycayojpis cananpaj, rispitasha cananpaj, alli cawananpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Fiyu runacunapa purinanchöga churaraycan trampacunawan cashacunallami.","poem":1},{"lineBreak":true},{"text":"Alli cawayta munajcunaga chay caminupita witicunmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tacsha cashancama wamrataga sumaj willapay.","poem":1},{"lineBreak":true},{"text":"Alli yachachiptiquega jatunyarpis manami gongangachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pobricunataga rïcumi munaynincho chararan.","poem":1},{"lineBreak":true},{"text":"Jaga-tucojcunapapis guellayta ristajmi mandajnin ricacun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fiyu runaga juchata rurashanpitami ñacanga.","poem":1},{"lineBreak":true},{"text":"Chay-niraj runataga Tayta Diosmi castigar ushacächenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Cuyapäcoj runaga bindisyuntami chasquenga","poem":1},{"lineBreak":true},{"text":"pobricunata tarichishanpita, millgashanpita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Fiyu runata garguriptiquega chiquinacuypis, rimanacuypis,","poem":1},{"lineBreak":true},{"text":"achäquita ashipänacuypis jamangami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rayga alli runata cuyanmi.","poem":1},{"lineBreak":true},{"text":"Rasun cajta parlajcunawanga amïgutami ruran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tayta Diosga yachajcunata yanapänanpämi ricapaycan.","poem":1},{"lineBreak":true},{"text":"Llullacunatami ichanga manacajman churan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Guella runaga mana arunan-cashami nin:","poem":1},{"lineBreak":true},{"text":"«Jircachöga liyunmi caycan. Micumaytami munaycan» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Majanta ganrachir jananpaj warmiga yanauyaycaj jatuncaray uchcunömi.","poem":1},{"lineBreak":true},{"text":"Runapis Tayta Diosta mana wiyacoj cäga chaymanmi yaganga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wamra-mösucunaga wichaypa uraypami yarpan.","poem":1},{"lineBreak":true},{"text":"Chaypis astiptenga wiyacur tantiyacunmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rïcuyänan casha pobrita ñacachëga,","poem":1},{"lineBreak":true},{"text":"ima-aycantapis rïcucunata goycöga pasaypami pobriyanga.","poem":1}]},{"type":"heading","content":["Yachajcuna rimashan"]},{"type":"verse","number":17,"content":[{"text":"Yachaj musyajcuna willapäshushayquitaga sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Willapar yachachishäcunataga llapanta yarparay.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chaycunataga allipämi umayquiman churacunqui.","poem":1},{"lineBreak":true},{"text":"Chay yachacushayquicunataga mana gongaypami yarparaycanquipaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Llapan yarpayniquiwan Tayta Diosllaman","poem":1},{"lineBreak":true},{"text":"yäracunayquipämi canan willapar yachaycächë.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nogaga quimsa chunca (30) yachachicuytami yachachishcä.","poem":1},{"lineBreak":true},{"text":"Chaynöga willapashcä yachaj canayquipaj, tantiyaj canayquipämi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chay yachachishäcunami tantiyachishunquipaj rasun cajllata ruranayquipaj.","poem":1},{"lineBreak":true},{"text":"Pipis tapucushuptiquega allitami willanquipaj.","poem":1}]},{"type":"heading","content":["–1–"]},{"type":"verse","number":22,"content":[{"text":"Pobri cashan-raycu, pobri runataga ama suwapanquichu.","poem":1},{"lineBreak":true},{"text":"Pïninpis mana caj runatapis autoridäcunacho ama ichiycachächinquichu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Paycunapa faburnin Tayta Diosmi canga.","poem":1},{"lineBreak":true},{"text":"Paycunata suwapajtaga Tayta Diosmi ima-aycantapis guechonga.","poem":1}]},{"type":"heading","content":["–2–"]},{"type":"verse","number":24,"content":[{"text":"Fiyu runacunawanga rabyaj runacunawanga","poem":1},{"lineBreak":true},{"text":"ama goturanquichu; ni ama amïgupis canquichu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Chayno runacunawan goturarga mala-mäña caytami yachacunquipaj.","poem":1},{"lineBreak":true},{"text":"Chayno carga quiquillayquimi cuncayquiman wascata churacuycanqui maticunayquipaj.","poem":1}]},{"type":"heading","content":["–3–"]},{"type":"verse","number":26,"content":[{"text":"Juc runa jaga-tucuptenga","poem":1},{"lineBreak":true},{"text":"ama garantiyanquichu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Päganayquipaj imayquipis mana captenga","poem":1},{"lineBreak":true},{"text":"cämayquitapis guechushunquipämi.","poem":1}]},{"type":"heading","content":["–4–"]},{"type":"verse","number":28,"content":[{"text":"Unay castayquicuna jawishan","poem":1},{"lineBreak":true},{"text":"lindacunataga ama witichinquichu.","poem":1}]},{"type":"heading","content":["–5–"]},{"type":"verse","number":29,"content":[{"text":"Ima aruytapis yachaj bïbu runaga raypa palasyunchörämi aronga.","poem":1},{"lineBreak":true},{"text":"Manami manacaj runacunapa munayninchöchu canga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}