{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":23,"content":[{"type":"heading","content":["–6–"]},{"type":"verse","number":1,"content":[{"text":"Juc mandaj wasincho micunayquipaj gayachishuptiqui","poem":1},{"lineBreak":true},{"text":"tantiyacuriy pipa ñaupancho jamaraycashayquitapis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"May-jina micuyta munaparpis","poem":1},{"lineBreak":true},{"text":"ama jucllaga aptarcunquichu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alli mishquej micuynincunata ama munapaychu.","poem":1},{"lineBreak":true},{"text":"Musyapäshunallayquipäpis gayashunquimanchari.","poem":1}]},{"type":"heading","content":["–7–"]},{"type":"verse","number":4,"content":[{"text":"Rïcuyayllataga ama ashiychu.","poem":1},{"lineBreak":true},{"text":"Rïcu canayquipäga ama alläpa yarpachacuychu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Imayllaga riquësata ricashcanquichu?","poem":1},{"lineBreak":true},{"text":"Riquësacunaga illajpita pärir anca aywacojnöllami,","poem":1},{"lineBreak":true},{"text":"lümancuna juntarcuptin äbi aywacoj-yupayllami.","poem":1}]},{"type":"heading","content":["–8–"]},{"type":"verse","number":6,"content":[{"text":"Micha yargaj runacunapa wasinman ama yaycunquichu.","poem":1},{"lineBreak":true},{"text":"Mishqui micuynincunatapis ama munapaychu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chay runaga micuy aycalla cuestashantapis cuentata jorguycanmi.","poem":1},{"lineBreak":true},{"text":"Janan shongullami «micushun, upushun» nishunqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nircorga micushayquitapis gumitanquipämi.","poem":1},{"lineBreak":true},{"text":"Cuyachicur alli shimillayquipa parlashayquipis yangami canga.","poem":1}]},{"type":"heading","content":["–9–"]},{"type":"verse","number":9,"content":[{"text":"Mana tantiyacojcunataga ama willapaychu.","poem":1},{"lineBreak":true},{"text":"Yachaj cayniquiwan allita willapaptiquipis asipäshunquipämi.","poem":1}]},{"type":"heading","content":["–10–"]},{"type":"verse","number":10,"content":[{"text":"Unaypita-pacha jawiraj lindacunataga ama witichinquichu.","poem":1},{"lineBreak":true},{"text":"Wacchacunapa chacranmanpis guechunayquipaj ama yaycunquichu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paycunata Washäga caycan fiyupa munayniyojmi.","poem":1},{"lineBreak":true},{"text":"Pï ñacachiptinpis Paymi faburnin jatarir castiganga ñacachejtaga.","poem":1}]},{"type":"heading","content":["–11–"]},{"type":"verse","number":12,"content":[{"text":"Yachachishushayquicunata llapan shonguyquipa yachacuy.","poem":1},{"lineBreak":true},{"text":"Yachaj canayquipaj willapäshushayquitaga yarparay.","poem":1}]},{"type":"heading","content":["–12–"]},{"type":"verse","number":13,"content":[{"text":"Wamrataga piñacuypaj captenga simri piñacuy.","poem":1},{"lineBreak":true},{"text":"Ishcay quimsa maqui astishallayquega manami wañuchengachu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Astishayquiwanga mana alliman chayar","poem":1},{"lineBreak":true},{"text":"pirdicänanpitami salbaycanqui.","poem":1}]},{"type":"heading","content":["–13–"]},{"type":"verse","number":15,"content":[{"text":"Ïju, gam sumaj yachaj cayman chayaptiqui","poem":1},{"lineBreak":true},{"text":"nogaga fiyupami cushicushaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rasunpa alli cajcunallata parlajta wiyaptë","poem":1},{"lineBreak":true},{"text":"shongöpis fiyupami cushiconga.","poem":1}]},{"type":"heading","content":["–14–"]},{"type":"verse","number":17,"content":[{"text":"Juchasapacuna imatapis charajta ricar ama rabyapaychu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga imaypis Tayta Diosllata manchapacuy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chayno goyarga alli cawaymanmi chayanquipaj.","poem":1},{"lineBreak":true},{"text":"Yarpashayquicunapis manami yangallapächu canga.","poem":1}]},{"type":"heading","content":["–15–"]},{"type":"verse","number":19,"content":[{"text":"Ïju, llapan yachachishäta sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Llapantapis alli cajcunata rurallar goyay.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Upyaj runacunawan ama goturanquichu.","poem":1},{"lineBreak":true},{"text":"Alläpa micojcunawanpis ama goturanquichu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Upyajcunawan alläpa micojcunaga ushapacangami.","poem":1},{"lineBreak":true},{"text":"Guellacunapis sajpi röpallatami jaticonga.","poem":1}]},{"type":"heading","content":["–16–"]},{"type":"verse","number":22,"content":[{"text":"Taytayquita wiyacunqui.","poem":1},{"lineBreak":true},{"text":"Mamayqui chacwanyaptin rispitanqui.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Alli tantiyaj yachaj caytaga imanöpapis yachacuy.","poem":1},{"lineBreak":true},{"text":"Yachaj cayta, tantiyaj cayta imanöpapis ashiy.","poem":1},{"lineBreak":true},{"text":"Chay tarishayquitaga ama imawanpis rucachiychu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Alli yarpayniyoj, yachaj wamrapa taytanga","poem":1},{"lineBreak":true},{"text":"«wamrä alli yachan» nir fiyupami cushiconga.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gamga mamayquita taytayquita cushicachiy.","poem":1},{"lineBreak":true},{"text":"«Wamrä alli yachajmi» nir cushisha goyächun.","poem":1}]},{"type":"heading","content":["–17–"]},{"type":"verse","number":26,"content":[{"text":"Ïju, willapashäcunata sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Noga imanömi goyashcä; chayno gampis goyay.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Cuerpunwan gänapacoj warmiga yanauyaycaj ruri uchcunömi.","poem":1},{"lineBreak":true},{"text":"Jäpa warmiga yanauyaycaj cañipu uchcunömi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Runacunataga suwano sumaj ricapan.","poem":1},{"lineBreak":true},{"text":"Nircur ollgu runacunataga jucta-juctapis pirdisyunman chayachin.","poem":1}]},{"type":"heading","content":["–18–"]},{"type":"verse","number":29,"content":[{"text":"¿Pitaj ñacan? ¿Pitaj nanächicun?","poem":1},{"lineBreak":true},{"text":"¿Picunataj rimanacullar, wagallar goyan?","poem":1},{"lineBreak":true},{"text":"¿Piraj pitapis mana gallaripaycällar malubracun?","poem":1},{"lineBreak":true},{"text":"¿Picunaparaj ñawinpis yawartasha?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Chaynöga carcaycan upyallacho goyajcunami,","poem":1},{"lineBreak":true},{"text":"machächicojcunata rurarcur-rurarcur upyallar goyäcojcunami.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Machächicojcunataga ama munapanquichu.","poem":1},{"lineBreak":true},{"text":"Maysi upucuylla munapaypaj achicyaypa achicyar-rämi bäsuchöpis ricacan.","poem":1},{"lineBreak":true},{"text":"Upurcorga mishquillami ultarcärin.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Nircurnaga culebrapa benënunnömi nanächishunqui, gueshyachishunqui.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Machacurcorga mana yarpashayquitami ricapacunquipaj.","poem":1},{"lineBreak":true},{"text":"Mana cumbënejcunatami rimachishunquipis; yarpächishunquipis.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Lamar chaupincho umayqui tumariycajtanömi mayapacunquipaj.","poem":1},{"lineBreak":true},{"text":"Can'wacho aywaptiqui umayqui tumariycajnömi ricacunquipaj.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ninquipaj: «Magamaptinpis manami nanämashachu.","poem":1},{"lineBreak":true},{"text":"Astimashantapis manami mayashcächu.","poem":1},{"lineBreak":true},{"text":"Paucarcorga yapaymi upyaj aywashaj» nir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}