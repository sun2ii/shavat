{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":24,"content":[{"type":"heading","content":["–19–"]},{"type":"verse","number":1,"content":[{"text":"Fiyu runacuna rïcuyaptin ama rabyapaychu.","poem":1},{"lineBreak":true},{"text":"Ni paycunawan goturaytapis ama yarpaychu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Paycunaga wañuchicuyllapämi yarparcaycan.","poem":1},{"lineBreak":true},{"text":"Mana allicunata rurayllapämi parlanpis.","poem":1}]},{"type":"heading","content":["–20–"]},{"type":"verse","number":3,"content":[{"text":"Alli yachajpämi wasi ruraypis.","poem":1},{"lineBreak":true},{"text":"Alli tantiyajpämi wasipa simintun pergaypis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yachaj cayninwanmi imatapis wasiman shuntan","poem":1},{"lineBreak":true},{"text":"alli cajllata, mas chanin cuestaj cuyayllapaj cajcunallata.","poem":1}]},{"type":"heading","content":["–21–"]},{"type":"verse","number":5,"content":[{"text":"Yachaj runaga masmi bälin callpasapa runapitaga.","poem":1},{"lineBreak":true},{"text":"Yarpaysapa runapis sumaj munayniyojmi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Guërra gallaycuptenga sumaj yarpachacuycurmi pillyayta gallaycun.","poem":1},{"lineBreak":true},{"text":"Achcaj tantiyachejnincuna captinrämi guërrachöga binsin.","poem":1}]},{"type":"heading","content":["–22–"]},{"type":"verse","number":7,"content":[{"text":"Mana tantiyacoj upaga yachayta manami tarinchu.","poem":1},{"lineBreak":true},{"text":"Chaymi autoridäpa ñaupancho ima rimaytapis mana camäpacunchu.","poem":1}]},{"type":"heading","content":["–23–"]},{"type":"verse","number":8,"content":[{"text":"Pitapis mana alli rurayllata yarpajcunataga","poem":1},{"lineBreak":true},{"text":"pï-maypis rejsin «fiyu runa» nirmi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mana tantiyacoj upaga jucha rurayllatami yarpan.","poem":1},{"lineBreak":true},{"text":"Shimisapatapis llapanmi chiquipan.","poem":1}]},{"type":"heading","content":["–24–"]},{"type":"verse","number":10,"content":[{"text":"Ñacaycunata mana awantäga manami runachu canqui.","poem":1}]},{"type":"heading","content":["–25–"]},{"type":"verse","number":11,"content":[{"text":"Mana juchan caycaptin wañuchinanpaj caycajtaga salbay.","poem":1},{"lineBreak":true},{"text":"Wañunanpaj caycajcunatapis salbay.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"«Manami musyashcächu» niptiquipis","poem":1},{"lineBreak":true},{"text":"pï imallata rurashanpitapis jusgaj Tayta Diosllami musyanga.","poem":1},{"lineBreak":true},{"text":"Imano caycashayquitapis ricashöga llapan rurashayquitami ricaycäshunqui.","poem":1},{"lineBreak":true},{"text":"Runacunataga rurashanmannömi llapanta cutichenga.","poem":1}]},{"type":"heading","content":["–26–"]},{"type":"verse","number":13,"content":[{"text":"Ïju, abëjapa mishquinta jorgurcur micuy.","poem":1},{"lineBreak":true},{"text":"Masqui yawarcuy. Chayga fiyupa mishquejmi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yachaj caypis, musyaj caypis abëjapa mishquinnömi cangapaj gampäga.","poem":1},{"lineBreak":true},{"text":"Alli yarpayniyoj sumaj yachaj carga allimi goyanquipaj.","poem":1},{"lineBreak":true},{"text":"Yarpashayquicunapis manami yangallapächu canga.","poem":1}]},{"type":"heading","content":["–27–"]},{"type":"verse","number":15,"content":[{"text":"Alli runacunataga ima mana allitapis ama yarpapaychu.","poem":1},{"lineBreak":true},{"text":"Tiyaycashan wasintapis ama amiychu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mana alliman ganchis cuti chayarpis alli runaga allichömi llojshenga.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunami ichanga mana alliman chayar chayllachöna ushacanga.","poem":1}]},{"type":"heading","content":["–28–"]},{"type":"verse","number":17,"content":[{"text":"Chiquishojcuna mana alliman chayashpan ñacaycho caycaptenga","poem":1},{"lineBreak":true},{"text":"ama cushicuychu ni asipaypischu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chayno runa rurashanga Tayta Diosta manami gustanchu.","poem":1},{"lineBreak":true},{"text":"Cushipaptiquega fiyu runata castigaycashanpita manami castiganganachu.","poem":1}]},{"type":"heading","content":["–29–"]},{"type":"verse","number":19,"content":[{"text":"Fiyu runacuna-jananga ama rabyacuychu.","poem":1},{"lineBreak":true},{"text":"Fiyu runacuna charashantapis ama munapaychu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fiyucunaga mana alliman chayar-rämi mayanga.","poem":1},{"lineBreak":true},{"text":"Fiyucunaga achqui upejno illajpitami illaraycanga.","poem":1}]},{"type":"heading","content":["–30–"]},{"type":"verse","number":21,"content":[{"text":"Ïju, Tayta Diosta manchacuy.","poem":1},{"lineBreak":true},{"text":"Raytapis rispitay.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunawanga ama goturpanquichu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fiyucunaga illajpitami usharaycangapaj.","poem":1},{"lineBreak":true},{"text":"Manami pipis musyanchu Tayta Diospis, ni raypis imano castiganantapis.","poem":1}]},{"type":"heading","content":["Yachajcuna masta parlashan"]},{"type":"verse","number":23,"content":["Caycunapis yachajcuna rimashanmi:",{"lineBreak":true},{"text":"Pipis dimanducho captin","poem":1},{"lineBreak":true},{"text":"jucajllata ricapayga manami allichu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Juchayoj caycaptin «Manami juchayojchu canqui» niptenga","poem":1},{"lineBreak":true},{"text":"llapan runami rabyanga.","poem":1},{"lineBreak":true},{"text":"Chayno nejtaga juc-lä nasyun runacunapis manacajmanmi churan.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Juchayojcunata castigaptinmi ichanga alliman churan.","poem":1},{"lineBreak":true},{"text":"Chayno alli arriglajcunapäga llapan runa allimi parlan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Imata tapuptinpis allita cutichëga","poem":1},{"lineBreak":true},{"text":"alli amïgumi caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Rimëruga chacrayquitaraj camariy.","poem":1},{"lineBreak":true},{"text":"Chacra aruyniquicunataraj aruy.","poem":1},{"lineBreak":true},{"text":"Nircur-raj mushoj wasitaga jatarachiy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Manacajtaga runa-masiquipaj ama declaraychu.","poem":1},{"lineBreak":true},{"text":"Manacajpitaga ama rasuntano rimanquichu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Pï ima mana allita rurashuptiquipis","poem":1},{"lineBreak":true},{"text":"gamga ama yarpaychu ayñita cutichiyta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Guella runapa chacranpa aywashcä.","poem":1},{"lineBreak":true},{"text":"Mana yarpachacoj runapa übas chacranpapis purimushcä.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Chaychömi ricashcä chacran jacha juntashalla caycajta,","poem":1},{"lineBreak":true},{"text":"pergancunapis juchusha caycajta.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Chaycunata ricaycur umäman churacushcä.","poem":1},{"lineBreak":true},{"text":"Chaymi yarpachacur tantiyacushcä cayno cashanta:","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Puñucushayquicama, jajtashayquicama,","poem":1},{"lineBreak":true},{"text":"maquiqui ogllasha cacushayquicama","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ushapacayga suwa","poem":1},{"lineBreak":true},{"text":"pillyacunanwan shamojnömi chayapaycushunquipaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}