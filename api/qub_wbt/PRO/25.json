{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":25,"content":[{"type":"heading","content":["Salomonpa rimaynincuna"]},{"type":"verse","number":1,"content":["Caycunapis ray Salomón tantiyachir rimashancunami. Chay rimashancunatami Judäpa raynin Ezequiasta yanapaj runacuna cupyasha."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pipis mana musyashan cajtaga Tayta Diosllami musyan.","poem":1},{"lineBreak":true},{"text":"Chaypitami paytaga rispitan.","poem":1},{"lineBreak":true},{"text":"Rayga llapantami musyayta munan.","poem":1},{"lineBreak":true},{"text":"Chaypitami paypis rispitasha caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ima altucho syëlu cashantapis,","poem":1},{"lineBreak":true},{"text":"may ruri cay pacha cashantapis manami pipis ricanmanchu.","poem":1},{"lineBreak":true},{"text":"Raycuna yarpashantapis","poem":1},{"lineBreak":true},{"text":"manami pipis musyanmanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Guellaypa ganrancunata jorgunayquipaj chulluchiyraj.","poem":1},{"lineBreak":true},{"text":"Chauraga cuyayllapaj cöpatami guellay tacäga ruranga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chayno, mana alli runatapis rayta yanapaycashanpita jitariy.","poem":1},{"lineBreak":true},{"text":"Chaura ray mandashanchöga llapanpis rasun cajta, alli cajllatami ruranga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Raypa ñaupancho cashpayqui ama alli-tucuychu.","poem":1},{"lineBreak":true},{"text":"Mayur rispitädu runacuna jamaränanmanpis ama jamaychu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaypa ruquenga mas alli canman quiquinraj «cayman jamacuy» nishuptiquimi.","poem":1},{"lineBreak":true},{"text":"Mana gayaycäshuptiqui quiquillayquipita aywaptiquega pengaypämi gargushunquipaj.","poem":1},{"lineBreak":true},{"text":"Imatapis ruraycajta ricashpayqui","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"jucllaga ama dimandaj aywanquichu.","poem":1},{"lineBreak":true},{"text":"Runa-masiqui «manami chaynöchu» nishuptiquega","poem":1},{"lineBreak":true},{"text":"gam pengaychömi quëdanquipaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaymi rimëruga runa-masiquiwanraj parlay.","poem":1},{"lineBreak":true},{"text":"Jucpa washantaga ama willacuychu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Washan rimaycajta pipis wiyarga pengaymanmi churashunquipaj.","poem":1},{"lineBreak":true},{"text":"Pengayman churashuptiquega cutiricuyta mananami camäpacunquipänachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Camacashan öra rimashanga allimi.","poem":1},{"lineBreak":true},{"text":"Gori mansänano sumaj allimi caycan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wiyacoj runapäga yachaj runa piñacushan caycan","poem":1},{"lineBreak":true},{"text":"gori surtïjano gori wallganömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Alli cachaga cachajpaj caycan","poem":1},{"lineBreak":true},{"text":"usya quillacho allpa shanshaycaptin tamyarcojnömi.","poem":1},{"lineBreak":true},{"text":"Mandajninta alli cushicachin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Imatapis gonanpaj aunircur mana cumlëga caycan","poem":1},{"lineBreak":true},{"text":"chaqui pucutay lätaycachaycajta wayra gargurejnöllami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Pasinsacojcunaga fiyupa ollguycajtapis gasarpachinmi.","poem":1},{"lineBreak":true},{"text":"Alli shimillanpa parlarga mandaj rabyaycajtapis allchacächinmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Abëjapa mishquinta tarerga ama yamacashayquicamaga micunquichu.","poem":1},{"lineBreak":true},{"text":"Alläpa micorga melanar gumitananquimanmi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Amïguyquiman chayarga ama cutilla cutinquichu.","poem":1},{"lineBreak":true},{"text":"Alläpa chayaptiquega yamacäshunquipämi. Chiquipaytanami gallaycushunquiman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Llullacur runa-masinpa contran rimäga mana alli runami.","poem":1},{"lineBreak":true},{"text":"Chay-niraj runaga mäsunömi, espädanömi, llauchi-punta lëchanömi malubracun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Llaquicuy cashan öra mana cumlej runaman yäracöga","poem":1},{"lineBreak":true},{"text":"chaquin paquicusha puriycajnömi,","poem":1},{"lineBreak":true},{"text":"uchcu quirun nanaycaptin chucru micuyta micuycajnömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Llaquicuycaj runata birsuparga ruraycan","poem":1},{"lineBreak":true},{"text":"gueriman limunta gapchipaycajnömi,","poem":1},{"lineBreak":true},{"text":"fiyupa gasaycho caycaptin röpanta lojticaycächejnömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Chiquishojniqui yargaycaptenga garaycuy.","poem":1},{"lineBreak":true},{"text":"Yacunaptinpis yacuta macyay.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chayno ruraptiquega pengacuyllawanmi cäranpis pucayacäconga.","poem":1},{"lineBreak":true},{"text":"Chayno rurashayquipita Tayta Diosnami pägashunquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Norte caj-läpita wayra wayrämuptinmi tamya chayamun.","poem":1},{"lineBreak":true},{"text":"Runapa fiyu shiminpitami jagayächinacur chiquinacuypis chayamun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Alli jatun wasicho rimanacuyllata pillyallata ashiycaj warmiwan goyänanpa ruquenga","poem":1},{"lineBreak":true},{"text":"mas allimi canman japallan chucllallacho tiyacuptinmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Carupita alli willapata chayachimushanga caycan","poem":1},{"lineBreak":true},{"text":"yacunaywan wañuycaptin ïlaj yacu shongunman chayarcojnörämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Alli runa juchayoj runacunawan tallucashanga caycan","poem":1},{"lineBreak":true},{"text":"chuya yacuwan putca yacu tallucashannömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Alläpa achca mishquita micuyga manami allichu.","poem":1},{"lineBreak":true},{"text":"Chayno manami allichu alläpa rispitasha cayta ashiypis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Rabyar mana pasinsacoj runaga caycan","poem":1},{"lineBreak":true},{"text":"curaläni siudä pï yaycunanpäpis alayri caycajnömi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}