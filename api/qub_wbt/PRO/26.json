{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":26,"content":[{"type":"heading","content":["Mana tantiyacoj upapaj rimashan"]},{"type":"verse","number":1,"content":[{"text":"Usya wichan rashtarga manami allichu.","poem":1},{"lineBreak":true},{"text":"Cosëcha wichan tamyapis manami allichu.","poem":1},{"lineBreak":true},{"text":"Chaynömi mana tantiyaj upa runata alliman churananpis mana camacanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ima maldäpis manami chayanchu juchan mana captenga.","poem":1},{"lineBreak":true},{"text":"Maldä rurashanga gueshwaynaj pichiusano, wayanay äbinömi maymanpis mana chayaypa cacun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Busalwanmi cawalluta amansanchi.","poem":1},{"lineBreak":true},{"text":"Läsuwanmi bürruta manshuyächinchi.","poem":1},{"lineBreak":true},{"text":"Garutinami caycan mana tantiyacoj upa runata corrijinapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mana tantiyacoj upa runa rimashantaga ama cäsupanquichu.","poem":1},{"lineBreak":true},{"text":"Chayta cäsuparga mana tantiyacoj upa-nirajmi canquiman.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mana tantiyacoj upataga sumaj cutichiy.","poem":1},{"lineBreak":true},{"text":"Chaynöpami upa runaga mana yachaj-tucongachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mana tantiyaj upa runawan willacachëga ricacun","poem":1},{"lineBreak":true},{"text":"chaquin paquisha caycajnömi, ima inrïdumanpis jaticaycajnömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Runapa wegru chaquinnömi","poem":1},{"lineBreak":true},{"text":"upacuna yachachir rimashanpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rumita waracaman watarcojnömi","poem":1},{"lineBreak":true},{"text":"mana tantiyacoj upa runata rispitayga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Machasha runa cashata charicusha caycajnömi","poem":1},{"lineBreak":true},{"text":"upacuna yachachicur rimashanpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aröshinanpaj mana tantiyaj upa runata mincacöga caycan","poem":1},{"lineBreak":true},{"text":"lëchayoj runa pitapis ricashanta illapaycajnömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Allgu gumitashanta yapay micushannömi","poem":1},{"lineBreak":true},{"text":"mana tantiyacoj upapis yapay llutancunata ruran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Yachaj-tucoj runata ricashcanquichu?","poem":1},{"lineBreak":true},{"text":"Chayno runapitaga mana tantiyacoj upa runapis allirämi canman.","poem":1}]},{"type":"heading","content":["Guellapaj rimashan"]},{"type":"verse","number":13,"content":[{"text":"Guella runaga aruyta mana munaywanmi nin:","poem":1},{"lineBreak":true},{"text":"«Jawachöga liyunmi caycan. Micumaytami munaycan» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Jinallancho puncu tumarishannömi","poem":1},{"lineBreak":true},{"text":"guella runapis cämallancho ticraycachaycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Guella runaga lätun churapacusha caycarpis","poem":1},{"lineBreak":true},{"text":"manami cuchärallawanpis chagarcunchu micunanpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Guella runaga fiyupa yachaj runa caycashantami yarpan.","poem":1},{"lineBreak":true},{"text":"Chaymi yarpan alli tantiyachicoj ganchis runacunapita mas yachaj cashanta.","poem":1}]},{"type":"heading","content":["Mana alli rurajcunapaj rimashan"]},{"type":"verse","number":17,"content":[{"text":"Juc rimanacushanman jaticäga","poem":1},{"lineBreak":true},{"text":"allguta rinripita charejnömi caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Löcu runa wañojpaj illapaycojnömi caycan","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"amïgunta llullapäga.","poem":1},{"lineBreak":true},{"text":"Llullapariycorga «rasyallami nishcä» nin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yanta mana captenga nina upicäcunmi.","poem":1},{"lineBreak":true},{"text":"Washa-rima mana captenga rimanacuypis manami canchu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Carbunwanrämi ninaga shanshan.","poem":1},{"lineBreak":true},{"text":"Yantawanrämi ninapis ratan.","poem":1},{"lineBreak":true},{"text":"Chaynömi washa-rimacunapis pitapis rimanacachiyta, pillyachiyta gallarachin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mishquillarämi washa-rimacunaga riman.","poem":1},{"lineBreak":true},{"text":"Chasquipajpänami caycan shonguncama alli chayajnöraj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Allpa mancata guellaywan chapyashanömi","poem":1},{"lineBreak":true},{"text":"mana allita yarpar janan shongulla rimajcunaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Chiqui runaga parlashan öra manami musyacächinchu.","poem":1},{"lineBreak":true},{"text":"Shongullanchöga yarpapaycan mana allicunata ruraytami.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Alli shimillanpa imata nishuptiquipis ama riguinquichu.","poem":1},{"lineBreak":true},{"text":"Shongunchöga yarpaycan llapan mana allicunallatami.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Chiqui cashanta mana mayacächiyta munaptinpis","poem":1},{"lineBreak":true},{"text":"mana allita rurashanga llapanpa ñaupanchömi musyacangapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Uchcuta uchcorga quiquinmi uchcushanman yagan.","poem":1},{"lineBreak":true},{"text":"Gagata amijtapis quiquintami rumiga ñitirin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Llulla runaga chiquirmi llullapan.","poem":1},{"lineBreak":true},{"text":"Janan shongulla parlajcunaga pitapis mana allimanmi chayachin.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}