{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Ama alli-tucuychu «Caytami wactami wara junaj rurashaj» nir.","poem":1},{"lineBreak":true},{"text":"Manami musyanquirächu wara junaj imano cananpaj cashantapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Quiquiqui alabacuptiquega manami allichu.","poem":1},{"lineBreak":true},{"text":"Juc runacuna gampaj alli parlar alabashuptiquimi ichanga alli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Aguwan rumiga fiyupami lasan.","poem":1},{"lineBreak":true},{"text":"Chaycuna lasashanpis manami tincunchu mana tantiyaj upa rabyashanmanga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rabyayga fiyumi; ollguypis manami allichu.","poem":1},{"lineBreak":true},{"text":"Inbidyösu runatami ichanga pipis mas piyur mana awantanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Shongullancho cuyananpa ruquenga","poem":1},{"lineBreak":true},{"text":"mas alli caycan waran-waran piñacushanmi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Piñacuptinpis cuyanacushan amïgunman yäracuymi mas alli","poem":1},{"lineBreak":true},{"text":"janan shongulla alli shiminpa parlapajman yäracunanpitaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sacsasha carga abëjapa mishquintapis melanäcunmi.","poem":1},{"lineBreak":true},{"text":"Yargaycajpämi ichanga ashgaj micuypis mishquin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yurishan marcanta cachaycur puricachaj runaga caycan","poem":1},{"lineBreak":true},{"text":"pichiusa gueshwanta cachaycur maypapis puricojnömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Cuyayllapaj perfümiwan pichucuriptenga shongupis cushicurinmi.","poem":1},{"lineBreak":true},{"text":"Amïgun allita willapaptenga shongunpis achicyärinmi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amïguyquitaga imaypis ama gongaychu.","poem":1},{"lineBreak":true},{"text":"Papäniquipa amïguntapis ama gongaychu.","poem":1},{"lineBreak":true},{"text":"Inrïducho cashayqui öraga wauguiquipa wasinman ama aywanquichu.","poem":1},{"lineBreak":true},{"text":"Carucho tiyacoj wauguipitaga bisïnu amïguyquimi mas alli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ïju, musyaj yachaj cay.","poem":1},{"lineBreak":true},{"text":"Chauraga fiyupami cushicushaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami manacajman churamajcunatapis cutichishaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Alli tantiyacoj runaga mana alliman chayananpaj cajta musyar witicunmi.","poem":1},{"lineBreak":true},{"text":"Mana tantiyacoj runami ichanga imatapis mana cäsupaypa aywar chayan fiyupa ñacayman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Jäpa runata garantiyajtaga asta röpantapis guechuy.","poem":1},{"lineBreak":true},{"text":"Jäpa warmita garantiyajpatapis rindata chariy asta päganancama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Chaca-chacalla amïguta sinchi gayaraypa saludaypis manami allichu.","poem":1},{"lineBreak":true},{"text":"Paypäga chayno saludashan caycan gayapashan-japuymi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Shimisapa warmipis tamyaptin mana chawaypa jutoj wasinömi","poem":1},{"lineBreak":true},{"text":"achäquita ashipayta mana jamanchu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Upällachiyta munarpis manami camäpacunchu.","poem":1},{"lineBreak":true},{"text":"Wayrata chapaycaj-japuymi,","poem":1},{"lineBreak":true},{"text":"maqui-paltancho asëtita chariycaj-japuymi upällachiyta mana camäpacunchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Fyërrutaga fyërru-masinwanmi afilan.","poem":1},{"lineBreak":true},{"text":"Chaynömi runapis jucwan parlar masta yachacun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ïgusta alli cuydäga poguptin wayuynintapis micongami.","poem":1},{"lineBreak":true},{"text":"Patrunninta alli atindejpis alli rispitashami canga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Imanömi cäranta pösu yacucho runa ricacun","poem":1},{"lineBreak":true},{"text":"chaynömi runa yarpashanta parlashpan imano cashantapis musyacächin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wañuypis, pantiyun uchcupis manami yamanchu chaychica runa pampacuptinpis.","poem":1},{"lineBreak":true},{"text":"Chaynömi runapis ima ricashancunatapis munapayta mana yamanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Goritapis guellaytapis rasunpa alli cashanta chulluchiyparämi rejsin.","poem":1},{"lineBreak":true},{"text":"Runatapis alli cashanta musyan alli cashanta runacuna alabaptinrämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Agashaga rïgupapis garan llojshinrämi.","poem":1},{"lineBreak":true},{"text":"Mana tantiyacoj upami ichanga ñuchushanyaj agaptinpis upa cayninta mana cachaycunchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Uywayquicunata sumaj ricay.","poem":1},{"lineBreak":true},{"text":"Uyshayquicunapaj yarpachacuy.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ima-aycayoj caypis, mandaj caypis mañayllami.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Guewa chillguir intërupa berdiypa berdicarcamuptin","poem":1},{"lineBreak":true},{"text":"jircacunachöpis alli guewa captenga","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"uyshayquicunachöpis millwapis cangami röpayquipaj.","poem":1},{"lineBreak":true},{"text":"Cabratana ranticunqui chacrata rantinayquipaj.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Cabrayquipa lëchinpis achca llojshenga","poem":1},{"lineBreak":true},{"text":"llapan wamrayquicunawan upunayquipaj.","poem":1},{"lineBreak":true},{"text":"Llapan uywayniquicunapis upunanpaj aypangami.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}