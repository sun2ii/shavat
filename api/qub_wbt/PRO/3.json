{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":3,"content":[{"type":"heading","content":["Yachaj cayman imano chayananpäpis"]},{"type":"verse","number":1,"content":[{"text":"Ïju, ama gonganquichu llapan yachachishäta.","poem":1},{"lineBreak":true},{"text":"Willapashäcunataga umayquiman sumaj churacuy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chaynöpami unaycama alli cawanquipaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ama imaypis gonganquichu cuyapäcoj cayta.","poem":1},{"lineBreak":true},{"text":"Chaycunataga shonguyquiman sumaj churacuy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayno alli cawaptiquega Tayta Diospis allimi ricashunquipaj;","poem":1},{"lineBreak":true},{"text":"runacunapis rispitashunquipämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Llapan shonguyquipa Tayta Diosman yäracuy.","poem":1},{"lineBreak":true},{"text":"Quiquiqui yachashayquimanga ama yäracuychu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Imata ruraycashayquichöpis Tayta Diosllaman yäracuy.","poem":1},{"lineBreak":true},{"text":"Chauraga paymi alli caminupa pusharäshunquipaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ama yachaj-tucunquichu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga Tayta Diosta manchacushpayqui jucha ruraypita witicuy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chayno allita ruraptiquega cuerpuyquipis sänumi cangapaj; sinchimi canquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ima-aycayqui cashallanpitapis Tayta Diosta rispitar garayniquita apay.","poem":1},{"lineBreak":true},{"text":"Micuyniquita rimir-punta shuntar raquishayquitaga paypaj apay.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chauraga Tayta Diosmi micuyniquicunatapis, micuy churacuna wasiquichöpis juntay-juntay cachenga.","poem":1},{"lineBreak":true},{"text":"Bïnuyquipis wiñacunayquicunacho imaypis manami pishengachu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ïju, Tayta Diosninchi piñacushuptiquega ama jagayanquichu.","poem":1},{"lineBreak":true},{"text":"Pay willapäshuptiqui ama manacajman churanquichu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tayta Diosga cuyashan wamrancunatami piñacun","poem":1},{"lineBreak":true},{"text":"imanömi taytanpis cuyay wamranta piñacun, chayno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Cushishami goyanga yachaj runaga,","poem":1},{"lineBreak":true},{"text":"alli yarpayniyoj runaga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yachaj cayga guellaypitapis masmi bälin.","poem":1},{"lineBreak":true},{"text":"Gorita tarishanchïpitapis masmi gänachimanchi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yachaj caymanga cuyayllapaj perlas rumipis manami tincunchu.","poem":1},{"lineBreak":true},{"text":"Mas fiyupa cuyay cajpis manami tincunchu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yachayga derëchu caj maquinwan mana ushacaj cawaytami tarichicun.","poem":1},{"lineBreak":true},{"text":"Ichoj cajwannami ima-aycatapis tarichin; pï-maypis rispitananpaj yanapan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chay yachay nishannölla rurarga alli cushishami goyanga.","poem":1},{"lineBreak":true},{"text":"Nishannölla goyarga cushisha goyaytami tarin.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yachacojcunata yachayga allimi goyächin.","poem":1},{"lineBreak":true},{"text":"Pipis yachaj cäga cushishami cawanga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tayta Diosga yachaj cayninwanmi cay pachatapis sumaj tacyachisha.","poem":1},{"lineBreak":true},{"text":"Yarpaysapa cayninwanmi janaj pachatapis sumaj camacächisha.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fiyupa yachaj munayniyoj cayninwanmi lamartapis raquisha;","poem":1},{"lineBreak":true},{"text":"tamyamunanpäpis camacächisha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ïju, mana yamacaypa allillata ruranqui.","poem":1},{"lineBreak":true},{"text":"Sumaj yarpachacurir imatapis allillata ruranqui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chaura gampäga cangapaj alli goyaymi.","poem":1},{"lineBreak":true},{"text":"Runacunapis gampäga alli cashayquitami parlanga.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Chauraga mana manchacuypami maypapis purinquipaj.","poem":1},{"lineBreak":true},{"text":"Manami chayanquipächu ima mana allimanpis.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Puñurpis manami manchacunquipänachu.","poem":1},{"lineBreak":true},{"text":"Mana yarpachacuypanami puñucunquipäpis.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Illajpita ima chayashunayquitapis manami manchacunquipächu.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunata mana alli chayaptinpis gamga manami manchacunquipächu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tayta Diosmi cuydaycäshunquipaj.","poem":1},{"lineBreak":true},{"text":"Mana alliman chayanayquitapis manami dëjashunquipächu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Yanapänanpita ñacaycaptenga pitapis yanapanqui.","poem":1},{"lineBreak":true},{"text":"Timpuyqui caycaptenga ama fiyu canquichu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ima-aycayquipis caycaptin mañacushuptiquega","poem":1},{"lineBreak":true},{"text":"ama «wararaj yawachishayqui» ninquichu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Pipis yäracushuptiquega","poem":1},{"lineBreak":true},{"text":"ama llutanta ruranquichu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Pipis achäquita mana ashipaycäshuptiquega","poem":1},{"lineBreak":true},{"text":"ama piwanpis rimanacunquichu.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Fiyu runa rurashantano ruraytaga ama munapanquichu.","poem":1},{"lineBreak":true},{"text":"Mana allita rurashancunatanöga ama ruranquichu.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Fiyu runacunataga Tayta Dios melanäcunmi.","poem":1},{"lineBreak":true},{"text":"Alli runacunatami ichanga alli rican.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Juchasapacunata Tayta Diosga famillyantintami manacajman churan.","poem":1},{"lineBreak":true},{"text":"Alli runacunatami ichanga famillyantinta bindisyunta gon.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Manacajman pitapis churajcunataga quiquintami Tayta Diospis manacajman churan.","poem":1},{"lineBreak":true},{"text":"Umildicunatami ichanga alli ñawinpa rican.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Yachajcunataga pï-maypis rispitangami.","poem":1},{"lineBreak":true},{"text":"Tantiyacuyta mana munajcunami ichanga pengaycho canga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}