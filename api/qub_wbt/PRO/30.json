{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":30,"content":[{"type":"heading","content":["Agur yachar rimashancuna"]},{"type":"verse","number":1,"content":["Caycunaga caycan Masa partipita Jaquëpa wamran Agur rimashancunami. Agur willaparan Itieltawan Ucalta."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nogaga cä llapan runapitapis mas mana tantiyacoj upami.","poem":1},{"lineBreak":true},{"text":"Manami runapa yarpayninnöchu nogapa yarpaynëga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Imatapis manami yachacushcächu.","poem":1},{"lineBreak":true},{"text":"Tayta Dios imano cashantapis manami musyächu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Pitaj syëluman wichasha? ¿Syëlupita caymanpis pitaj urämusha?","poem":1},{"lineBreak":true},{"text":"¿Piraj llapan wayrata aptaranman?","poem":1},{"lineBreak":true},{"text":"¿Piraj lamar yacuta jacunwan guepinman?","poem":1},{"lineBreak":true},{"text":"¿Piraj camacächiran cay pachapa lindancunata?","poem":1},{"lineBreak":true},{"text":"Llapan chaycunataga pipis rurashami canga.","poem":1},{"lineBreak":true},{"text":"Quiquinta rejsir jutinta yachashpayquega mä willamay.","poem":1},{"lineBreak":true},{"text":"Wamranpa jutintapis mä willamay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tayta Diosga imapitapis chapanmi payman yäracojcunataga.","poem":1},{"lineBreak":true},{"text":"Payga aunishanta llapantapis cumlinmi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pay nishanmanga ama masta yapanquichu.","poem":1},{"lineBreak":true},{"text":"Yapaptiquega piñacushunquimi.","poem":1},{"lineBreak":true},{"text":"Chauraga llullatanömi ricashunquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tayta Dios, gamtaga ishcayllatami mañacushcä.","poem":1},{"lineBreak":true},{"text":"Chay mañacushätaga manaräpis wañucuptillä camacaycachiy ari.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Engañanäta, llullacunätaga ama munaycuychu ari.","poem":1},{"lineBreak":true},{"text":"Chayno ama rïcuyächimaypischu ni pobriyächimaypischu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga cawanä-tupuylla tariycachimay ari.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rïcu carga gamta gongaycur Tayta Dios","poem":1},{"lineBreak":true},{"text":"capaschari nëmanpis «Pitaj chay Tayta Dios» nir.","poem":1},{"lineBreak":true},{"text":"Muchupacarga capaschari suwacuycömanpis.","poem":1},{"lineBreak":true},{"text":"Chayno rurarga jutiquitapis manacajmanmi churaycöman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Patrunninta ama willanquichu uywayninpa contran.","poem":1},{"lineBreak":true},{"text":"Contran willaptiquega uyway maldisyuntami goshunquipaj.","poem":1},{"lineBreak":true},{"text":"Chauraga ñacanquipämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Waquenga canmi taytanta ñacachej,","poem":1},{"lineBreak":true},{"text":"mamantapis mana rispitaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Waquenga juchata mana rurashanöpis alli-tucun.","poem":1},{"lineBreak":true},{"text":"Rasunpaga jucha ruraycunata manami cacharinrächu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Waquenga fiyupami munayniyoj-tucun.","poem":1},{"lineBreak":true},{"text":"Chaymi waquin runataga manacajman churan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Waquenga yargaj cashpanmi pobricunapa imantapis guechun.","poem":1},{"lineBreak":true},{"text":"Chay runacunapa quironga espädanömi.","poem":1},{"lineBreak":true},{"text":"Waguncunapis cuchillunömi.","poem":1},{"lineBreak":true},{"text":"Chayno carmi pobricunapa imantapis ushapan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Upucruypa wawancunaga ishcaymi:","poem":1},{"lineBreak":true},{"text":"Jucajpa jutenga «gomay».","poem":1},{"lineBreak":true},{"text":"Jucajpa jutinnami «masta gomay».","poem":1},{"lineBreak":true},{"text":"Chaynöpis quimsami, asta chuscumi can yargaj imaypis mana sacsaj.","poem":1},{"lineBreak":true},{"text":"Chaycunaga manami «chayllatana» ninchu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pantiyun uchcu ayata simrimi gayaycan.","poem":1},{"lineBreak":true},{"text":"Wawaynaj warmipis wawata simri munaycan.","poem":1},{"lineBreak":true},{"text":"Chaqui jircapis yacunayta manami yamanchu.","poem":1},{"lineBreak":true},{"text":"Cañapapis rupayta manami yamanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Maman-taytanta mana alli ricajtaga","poem":1},{"lineBreak":true},{"text":"ñawincunatapis ancacuna jorgucurinman,","poem":1},{"lineBreak":true},{"text":"cundurcunapis micucurcunman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Fiyupa yarpachacurpis manami tantiyayta atipächu.","poem":1},{"lineBreak":true},{"text":"Chaycunaga quimsami can; mas jucpis canrämi:","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Janajcho ancapa näninta,","poem":1},{"lineBreak":true},{"text":"gagacho culebrapa näninta,","poem":1},{"lineBreak":true},{"text":"lamarcho büquipa näninta;","poem":1},{"lineBreak":true},{"text":"warmiwan ollgu imano majachacashantapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mañösa warmiga juc runawan cacurcurpis","poem":1},{"lineBreak":true},{"text":"«manami juchataga rurashcächu» nin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Quimsami cay pachata sicsicyachin.","poem":1},{"lineBreak":true},{"text":"Chuscu cajnami munduta yamacächin.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Uyway runa mandaj cayman chayan.","poem":1},{"lineBreak":true},{"text":"Mana tantiyaj upa runapa micuynin mana pishinchu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Llapan runa mana munashan warmi majata tarin.","poem":1},{"lineBreak":true},{"text":"Uyway warmi patrönanpa runanwan tiyacurcun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Cay munduchöga chuscu casta tacsha animalcunami","poem":1},{"lineBreak":true},{"text":"yachajcunapitapis mas yarpaysapa caycan:","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Callpaynaj ticsacunaga aypalla tacsha suldärunömi","poem":1},{"lineBreak":true},{"text":"usya wichan micuyninta shuntarcur churacun.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wishcashcuna callpaynajlla cashpanpis","poem":1},{"lineBreak":true},{"text":"ranracunachömi tiyan.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Chüpacacunapis mandajnin mana caycaptinmi","poem":1},{"lineBreak":true},{"text":"mashtaypa aywarpis chay iwal-lla aywan.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Shullashcunaga fäsi chariy caycarpis","poem":1},{"lineBreak":true},{"text":"raycunapa wasincamami yaycun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Cay pachachöga quimsami cuyayllapaj purin.","poem":1},{"lineBreak":true},{"text":"Chuscu cajnami almiraypaj purin.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Liyonga mas manchacuypaj animalmi.","poem":1},{"lineBreak":true},{"text":"Imapitapis ni pipitapis manami gueshpinchu.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ollgoj gällu mana manchacuypa purin.","poem":1},{"lineBreak":true},{"text":"Yayan chïbupis mana manchacuypa purin.","poem":1},{"lineBreak":true},{"text":"Raypis suldäruncunapa ñaupanta imatapis mana manchacuypa aywan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Mana tantiyacoj upa-jina mana allita ruranayquipaj yarpasha caycarga sumajraj yarpachacuy.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Musyashayquinöpis lëchita gaywerga mantiquillatami jorgunqui.","poem":1},{"lineBreak":true},{"text":"Callpaycur-callpaycur sinyaptenga senganpita yawarmi llojshimun.","poem":1},{"lineBreak":true},{"text":"Chaynömi runa-masinta achäquita ashipajpis pillyayman chayanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}