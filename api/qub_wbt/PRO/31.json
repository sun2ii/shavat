{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":31,"content":[{"type":"heading","content":["Lemuel yachaj car rimashancuna"]},{"type":"verse","number":1,"content":["Caycunaga caycan Masa partipita ray Lemuel yachaj cayninwan rimashancunami. Chay rimashancunataga llapanta mamanmi alli goyänanpaj willaparan."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ïju, mañacuptë Tayta Dios yanapämaptinmi gamga yurirayqui.","poem":1},{"lineBreak":true},{"text":"Canan mä sumaj willapäshayqui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Warmicunallaman yarpacusha ama puriychu.","poem":1},{"lineBreak":true},{"text":"Achcajmi raycunapis warmi-rayculla pirdicasha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lemuel, manami allichu mandajcunapis ni raycunapis","poem":1},{"lineBreak":true},{"text":"alläpa upyallaman chayaptenga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Machacurcorga laycuna niycashantapis gongaycunmanmi.","poem":1},{"lineBreak":true},{"text":"Chayno gongaycorga ñacaycajcunata mananami alliga ricanganachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Machächicoj bïnuga caycan llaquicuycajcunapämi,","poem":1},{"lineBreak":true},{"text":"jagayasha wagaycajcunapämi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Llaquicuycashanta, pobrilla cashantapis gongaycunanpämi","poem":1},{"lineBreak":true},{"text":"chay runacunaga upyan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Parlayta mana yachajcunapa faburnin cay.","poem":1},{"lineBreak":true},{"text":"Washänanpaj pïninpis mana captin washay.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Upällallaga ama cacuychu.","poem":1},{"lineBreak":true},{"text":"Llapantapis alli arriglay.","poem":1},{"lineBreak":true},{"text":"Pobricunatawan umildicunataga washay ari.","poem":1}]},{"type":"heading","content":["Alli warmita alabashan"]},{"type":"verse","number":10,"content":[{"text":"Alli warmiga sasa tariymi.","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj achic-achicyaycaj perlascunapa risyunpis manami aypanchu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alli warmin captenga llapan shongunwanmi runan yäracun.","poem":1},{"lineBreak":true},{"text":"Chayno alli warmiwanga manami imaypis ushapacanchu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chay warmiga cawashancama majanta allimi yanapan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Millwatawan lïnuta ashiriycur,","poem":1},{"lineBreak":true},{"text":"cushisha ima awallatapis awan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Imanömi jatuncaray büqui nigusyuta apan,","poem":1},{"lineBreak":true},{"text":"chaynömi carupa aywaycur wasincho micunanpaj imallatapis ashircur apamun.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaca chacalla jatarin.","poem":1},{"lineBreak":true},{"text":"Nircorga wamrancunatawan uywaynincunata garariycun.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chacratapis sumaj ricaycur-raj rantin.","poem":1},{"lineBreak":true},{"text":"Arur gänashanwannami übasta lantachin.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chegllata sumaj chanaj watacurcur aruyta gallaycun.","poem":1},{"lineBreak":true},{"text":"Sumaj yarpaypa mana guellanaypa arun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nigusyuncho alli gänananpämi sumaj arun.","poem":1},{"lineBreak":true},{"text":"Pacha chacarcuptinpis chacaycamarämi ima ruraynincunatapis ruran.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Quiquin puchcata puchcan.","poem":1},{"lineBreak":true},{"text":"Quiquinmi awata awan.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wacchacunatawan pishipacajcunataga","poem":1},{"lineBreak":true},{"text":"mana gongaypa imallatapis macyaycun.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chay warmiga manami llaquicunchu rashtaptin ni gasapaptinpis.","poem":1},{"lineBreak":true},{"text":"Paypa famillyanga alli racta röpashami carcaycan.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Quiquinmi gatancunatapis awacun.","poem":1},{"lineBreak":true},{"text":"Alli röpacunallatami jaticunpis.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Runantaga llapanmi marca-masincunapis rejsin.","poem":1},{"lineBreak":true},{"text":"Runanpis waquin runacunawan iwal rispitädumi caycan.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Röpacunatapis ruran. Wachcucunata awan.","poem":1},{"lineBreak":true},{"text":"Nircur nigusyanticunata ranticun.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Waracuna imamanpis chayananpitaga manami manchacunchu.","poem":1},{"lineBreak":true},{"text":"Ni imapitapis mana pengacunchu, ni llaquicunpischu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Sumaj yarpachacurcurmi alli tantiyaj cayninwan parlan.","poem":1},{"lineBreak":true},{"text":"Sumaj tantiyachir alli shimillanwanmi yachachin.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Wasincho imallanpis pishiycashantaga ricaycan musyaycanmi.","poem":1},{"lineBreak":true},{"text":"Quiquin arucur ruracur tarishantami micun.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Alli warmi captinmi mamanta wamrancuna cuyan.","poem":1},{"lineBreak":true},{"text":"Majannami alabashpan nin:","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"«Alli warmicunaga achcajmi caycan.","poem":1},{"lineBreak":true},{"text":"Chaypis gammanga manami mayganpis tincunchu.»","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Buena-mösa cashanpis yanga manacajllapämi.","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj cayninpis rätu ushacajllami.","poem":1},{"lineBreak":true},{"text":"Tayta Diosninchïta rispitaj warmimi ichanga","poem":1},{"lineBreak":true},{"text":"alli rispitasha canga.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Llapan runacunapa ñaupanchöpis paytaga alabay-llapa.","poem":1},{"lineBreak":true},{"text":"Allita rurashancunapita fiyupa rispitasha caycullächun.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}