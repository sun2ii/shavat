{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":4,"content":[{"type":"heading","content":["Alli cawaypaj willacushan"]},{"type":"verse","number":1,"content":[{"text":"Wamracuna, taytayqui willapäshushayquitaga sumaj wiyacunqui.","poem":1},{"lineBreak":true},{"text":"Umayquiman sumaj churacunqui alli tantiyaj canayquipaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nogaga allimi yachachishcä.","poem":1},{"lineBreak":true},{"text":"Chay yachachishäcunataga ama gongaychu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nogapis mama taytawanmi goyashcä.","poem":1},{"lineBreak":true},{"text":"Amatar cuyarmi paycunaga uywamaran.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Papänëmi yachachimar willapämar cayno nimaj:","poem":1},{"lineBreak":true},{"text":"«Llapan willapashäcunata umayquiman sumaj churacuy.","poem":1},{"lineBreak":true},{"text":"Willapashäcunano rurarga allimi goyanquipaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yachaj canayquipaj willapashäcunataga sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Willapar yachachishäcunataga ama gongaychu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yachaytaga fiyupa cuyanqui. Ama cachaycunquichu.","poem":1},{"lineBreak":true},{"text":"Mana cachaycuptiqui yachayga fiyupa allimanmi churashunquipaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Imatapis cachaycur rimëruga yachaytaraj umayquiman sumaj churay tantiyaj canayquipaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yachayta cuyaptiqui yachayga allimanmi churashunquipaj.","poem":1},{"lineBreak":true},{"text":"Llapan shonguyquiwan fiyupa yachayta munaptiquega pipis allimi rispitashunquipaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nishäcunata wiyacorga sumaj adurnashanömi caycanquipaj.","poem":1},{"lineBreak":true},{"text":"Achic-achicyaycaj corönashanömi canquipaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ïju, llapan willapashäcunata sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Willapashäta wiyamarga unaycamami cawanquipaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Quiquëmi llapan yachachishäcunata sumaj tantiyachishayqui.","poem":1},{"lineBreak":true},{"text":"Alli caminupami purichishayqui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Alli caminupa purerga manami mana alliman chayanquipächu.","poem":1},{"lineBreak":true},{"text":"Llutancunamanpis manami chayanquipächu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Willapar yachachishushayquicunataga umayquiman sumaj churacuy.","poem":1},{"lineBreak":true},{"text":"Ama gongaychu.","poem":1},{"lineBreak":true},{"text":"Willapäshushayquicunata wiyacorga allimi goyanquipaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mana allita ruraj runacunamanga ama tallupaychu.","poem":1},{"lineBreak":true},{"text":"Mana allita rurashancunataga ama yachacunquichu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Paycuna goturashanmanga ama yaycapanquichu.","poem":1},{"lineBreak":true},{"text":"Yaycunayquipa ruquenga tumarcur juc-läpa päsacunqui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mana allita rurananpaj yarpashanta manaraj rurashancamaga","poem":1},{"lineBreak":true},{"text":"manami jamaytapis tarinchu.","poem":1},{"lineBreak":true},{"text":"Pitapis manaraj mana alliman chayachishancamaga","poem":1},{"lineBreak":true},{"text":"paycunapäga manami puñuypis puñuychu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Paycunaga mishquilla micuycaj-nirajmi mana allita ruran.","poem":1},{"lineBreak":true},{"text":"Mishquilla upuycaj-nirajmi wañuchicun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Alli runacuna alli goyashanga caycan pacha warämur achicyajnömi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Juchasapacuna mana alli goyashanmi ichanga caycan fiyupa manchacuypaj yanauyaycaj chacayno.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga manami musyanchu imaman tacacushantapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ïju, willapashäcunataga sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Willapashäcunataga mana gongaypa yarparay.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tantiyachishäcunata ruraytaga ama gongaychu.","poem":1},{"lineBreak":true},{"text":"Llapanta sumaj umayquiman churacuy.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Willapashäcunami wiyacojcunataga alli goyayta tarichin.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ima-aycayquitapis cuydashayquipita masta cuyday shonguyquicho yarpashayquicunata.","poem":1},{"lineBreak":true},{"text":"Yarpashayqui imanöpis cashanpitami goyanqui allipis u mana allipis.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Umayquipita jorgurcur manacajcunataga ama rimanquichu.","poem":1},{"lineBreak":true},{"text":"Ama llullacunquichu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Chayanayquipaj cajllaman yarparay.","poem":1},{"lineBreak":true},{"text":"Juc-lämanga ama yarpaychu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mayman japaycashayquitapis sumaj ricay.","poem":1},{"lineBreak":true},{"text":"Alliman japarga manami tuninquipächu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Alli caminupa puriycashayquipitaga janaman ni uramanpis ama yaycunquichu.","poem":1},{"lineBreak":true},{"text":"Mana allicunataga ama ruraychu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}