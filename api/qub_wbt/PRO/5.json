{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":5,"content":[{"type":"heading","content":["Mañösa warmicunawan mana cacunanpaj"]},{"type":"verse","number":1,"content":[{"text":"Ïju, yachachishäcunata sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Yachaj caynëwan willapashätaga sumaj yarparay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Llapan willapashäcunata wiyacorga alli yachajmi canquipaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami maychöpis yachaj cayniquiwanga alli parlanquipaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mañösa warmiga mishquillarämi parlanpis.","poem":1},{"lineBreak":true},{"text":"Asëtipitapis mas llampu cuyayllapämi rimashancunapis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayno warmita chasquipaj cäga asgächicojnörämi llaquicongapaj.","poem":1},{"lineBreak":true},{"text":"Ishcan-lädupa afilasha cuchillunörämi rimayninpis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chay-niraj warmiwan purerga wañongapämi.","poem":1},{"lineBreak":true},{"text":"Sepultüramanmi chayanga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chayno warmiga alli goyaypaj manami yarpachacunchu.","poem":1},{"lineBreak":true},{"text":"Llutanta ruraycashancunatapis manami tantiyacunchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ïju, chaymi llapan willapashäcunata sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Willapashäcunataga ama gonganquichu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mañösa warmipitaga witicuy.","poem":1},{"lineBreak":true},{"text":"Ni wasi puncullanmanpis ama chayanquichu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mana witicuptiquega pengaymanmi chayanayquipaj.","poem":1},{"lineBreak":true},{"text":"Fiyu runami ima-aycayquitapis guechushunquipaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ñacar arushayquitapis jäpa runacunami shuntanga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chauraga ñacayman chayar, gueshya charishuptiqui llaquicur waganquipaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chayrämi ninquipaj: «Imanir-raj willapämashancunata manacajman churarä.","poem":1},{"lineBreak":true},{"text":"Piñacamaptin, imanir-raj mana wiyacurächu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yachajcuna yachachimaptinpis manami wiyacojchu cä.","poem":1},{"lineBreak":true},{"text":"Willapämajcuna allita willapämaptinpis manami wiyacojchu cä.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Cananga llapan runacunami musyan","poem":1},{"lineBreak":true},{"text":"pasaypa mana allimanna chayaycashäta» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mösu caycällar majachacashayqui warmillawan cuyanacushpayqui alli goyay.","poem":1},{"lineBreak":true},{"text":"Majayquega caycan pashtaj pucyunömi.","poem":1},{"lineBreak":true},{"text":"Chaymi yacunarga quiquiquipa pashtaj pucyullayquipita upucunqui.","poem":1},{"lineBreak":true},{"text":"¿Pucyuyquipita pashtamoj yacuyquega cällicunapa läsacunapa aywar pirdicunmanchuraj?","poem":1},{"lineBreak":true},{"text":"Pucyuyquiwan chaycho pashtamoj yacuga gamllapami.","poem":1},{"lineBreak":true},{"text":"Quiquillayquipa caycaptenga ama dëjaychu juccuna upunanta.","poem":1},{"lineBreak":true},{"text":"¡Alli rispitasha cachun quiquiquipa pashtaj yacuyquega!","poem":1},{"lineBreak":true},{"text":"Chaymi majachacashayqui warmillawan cuyanacushpayqui alli goyäcuy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mösullayquicho tarishayqui warmiga cuyayllapaj lluychunömi.","poem":1},{"lineBreak":true},{"text":"Payga mana cachaypami cuyashunqui.","poem":1},{"lineBreak":true},{"text":"Cuyacuynenga shonguyquitapis fiyupami cushicachichun.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ïju, quiquiquipa majayquiwan alli cushisha goyaycashpayquega","poem":1},{"lineBreak":true},{"text":"¿imanir-raj majayoj warmicunawanga cacunquiman?","poem":1},{"lineBreak":true},{"text":"¿imanirtaj chay-niraj warmicunata macallarcur cuyaycunquiman?","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Imanölla runa cawashantapis Tayta Diosga ricaycanmi.","poem":1},{"lineBreak":true},{"text":"Imanölla runa purishallantapis ricaycanmi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Juchasapacunataga quiquin mana allita rurashancunallami tunichenga.","poem":1},{"lineBreak":true},{"text":"Chaychica juchata aparicushanmi chariranga.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tantiyacuyta mana munashanpitami tucuy mana allimanpis chayanga.","poem":1},{"lineBreak":true},{"text":"Mana wiyacoj cayninwanmi wañuymanpis chayanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":20}