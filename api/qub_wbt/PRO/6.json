{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":6,"content":[{"type":"heading","content":["Jucta mana garantiyananpaj"]},{"type":"verse","number":1,"content":[{"text":"Ïju, bisïnuyquita garantiyasha carga,","poem":1},{"lineBreak":true},{"text":"jäpa runata garantiyasha carga","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"quiquillayquimi mana alliman chayaycanqui.","poem":1},{"lineBreak":true},{"text":"Shimillayquipitami achcaman tuninquipaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ïju, garantiyashayquipita jucpa munayninman chayasha carga noga nishäta ruray.","poem":1},{"lineBreak":true},{"text":"Pengayta juc-läman jitaycur yanasayquiwan alli arriglay.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ama wiyaräcuychu.","poem":1},{"lineBreak":true},{"text":"Ni jamaytapis ama tariychu arriglanayquicama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Runa wañuchinanpita lluychu gueshpishanno ayguicuy.","poem":1},{"lineBreak":true},{"text":"Runa charinanpita pichiusa gueshpishanno gueshpicuy.","poem":1}]},{"type":"heading","content":["Guellacunata piñacushan"]},{"type":"verse","number":6,"content":[{"text":"Ticsacuna imano rurashallantapis ricacuy guella runacuna.","poem":1},{"lineBreak":true},{"text":"Ticsacuna imano rurashallantapis ricaycur yachacuy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paycunapaga mandajninpis manami canchu.","poem":1},{"lineBreak":true},{"text":"Imata rurananpäpis pipis manami mandanchu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Niycarmi usya quillallacho micuynincunata shuntacun.","poem":1},{"lineBreak":true},{"text":"Micuy cashan wichallan shuntar churacun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Guellacuna, ¡ama puñuräcuynachu!","poem":1},{"lineBreak":true},{"text":"¡Ama jitaräcuynachu!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Puñucushayquicama, jajtaycashayquicama,","poem":1},{"lineBreak":true},{"text":"maquiqui ogllasha cacushayquicama,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"muchuyga puricachaj runa-jina","poem":1},{"lineBreak":true},{"text":"pillyacunan aptasha magashunayquipaj shamojnörämi chayapaycushunquipaj.","poem":1}]},{"type":"heading","content":["Mana allita ruraj runacuna imano cashanpis"]},{"type":"verse","number":12,"content":[{"text":"Mana alli ruraj runacunaga","poem":1},{"lineBreak":true},{"text":"llullacushpan runapa washanta rimallarmi purin.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ñawillanwan guepishtapan.","poem":1},{"lineBreak":true},{"text":"Chaquincunawan dëduncunawan sëñapäcuytami yachan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mana allicunallatami yarpanpis.","poem":1},{"lineBreak":true},{"text":"Mana allicunata yarpachacuraycällarmi purinpis.","poem":1},{"lineBreak":true},{"text":"Pï-maytapis inrïduta rurallarmi purinpis.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaypitami illajpita ñacayman chayapayconga.","poem":1},{"lineBreak":true},{"text":"Mana yarpashapitami tucuy-niraj mana allicunaman chayanga.","poem":1},{"lineBreak":true},{"text":"Juc ñipiyllachömi ushacanga.","poem":1}]},{"type":"heading","content":["Tayta Dios melanäcushan cajcuna"]},{"type":"verse","number":16,"content":[{"text":"Sojta castata, asta ganchis castatami Tayta Diosga fiyupa melanäcun:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alli-tucojcunata,","poem":1},{"lineBreak":true},{"text":"llullacunata,","poem":1},{"lineBreak":true},{"text":"alli goyäcoj runata wañuchejta,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"jucha aparicuyllapaj yarparajta,","poem":1},{"lineBreak":true},{"text":"juchata rurallar cörricachajcunata,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"llullacur jucpa contran declarajcunata,","poem":1},{"lineBreak":true},{"text":"castanwan pillyananpaj inrïduta rurajcunata.","poem":1}]},{"type":"heading","content":["Mañösa warmiwan mana cacunanpaj piñacushan"]},{"type":"verse","number":20,"content":[{"text":"Ïju, taytayqui willapäshushayquicunata sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Mamayqui taytayqui yachachishushayquicunata ama gongaychu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mana gonganayquipaj shonguyquicho sumaj yarparay.","poem":1},{"lineBreak":true},{"text":"Perlas piñi wallgata wallgarajnöpis mana yamacaypa yarparay.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Maypa aywaptiquipis chay yachachishäcunaga allimanmi chayachishunquipaj.","poem":1},{"lineBreak":true},{"text":"Ima mana allipitapis chapäshunquipämi.","poem":1},{"lineBreak":true},{"text":"Riccharcuptiquinami alli yarpayta goshunquipaj.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mandamintucunaga achqui tübu rataycajnömi caycan.","poem":1},{"lineBreak":true},{"text":"Yachachicuypis achquinömi.","poem":1},{"lineBreak":true},{"text":"Corrijimashanchïta piñacamashanchïta sumaj wiyacorga alli cawaytami tarishun.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mañösa warmipita,","poem":1},{"lineBreak":true},{"text":"alli shimillanpa jäpa warmi luwarta goshuptiquipis chapäshunquimi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Chay warmi cuyayllapaj car luwarta goshuptiquipis ama rimapanquichu.","poem":1},{"lineBreak":true},{"text":"Ñipchipar ricapäshuptiquipis ama gaticurcunquichu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Guellayllapaj runata chasquej warmiwan cacorga micunanpaj cajtapis runa ushanmi.","poem":1},{"lineBreak":true},{"text":"Majanta ganrachej warmiwan cacurmi ichanga pirdicanna.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Pipis shanshata millgayninman wiñacorga","poem":1},{"lineBreak":true},{"text":"röpantami rupaconga.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Pipis shansha jananpa purerga","poem":1},{"lineBreak":true},{"text":"chaquintami rupaconga.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Chaynömi runapa warminwan cacojpis","poem":1},{"lineBreak":true},{"text":"juchata aparicushanpita castïgucho canga.","poem":1}]},{"type":"heading","content":["Mañösa warmiwan cacuptin ima päsashanpis"]},{"type":"verse","number":30,"content":[{"text":"Micunanpaj mana captin pachanpaj suwacojcunataga","poem":1},{"lineBreak":true},{"text":"manami pipis jamurpanchu.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mana jamurparpis suwacushanta tariparga suwacushanpita ganchis cutipa mastarämi pägachenga.","poem":1},{"lineBreak":true},{"text":"Chayno, jananmanpis imata charashallantapis ushajpämi guechonga.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Runapa warminwan cacöga mana tantiyacoj upa runami.","poem":1},{"lineBreak":true},{"text":"Chayno carga quiquillanmi pirdican.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Juchata rurashanpitami magar-ushashapis, ashllir ushashapis canga.","poem":1},{"lineBreak":true},{"text":"Chayno pengaycho cashanpitaga runacuna manami imaypis gongangachu.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Runan musyaycorga chay runapaj fiyupami rabyacurconga.","poem":1},{"lineBreak":true},{"text":"Chayno car manami perdunanganachu.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"«Mana allita rurashäpita pägashayqui» niptinpis manami munangachu.","poem":1},{"lineBreak":true},{"text":"Ni ima-aycata pägayta munaptinpis manami perdunanganachu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}