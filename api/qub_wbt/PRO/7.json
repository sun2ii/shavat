{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":7,"content":[{"type":"heading","content":["Mañösa warmi imano cashanpis"]},{"type":"verse","number":1,"content":[{"lineBreak":true},{"text":"Ïju, llapan willapashäcunata sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Willapashä mandamintucunataga umayquiman sumaj churacuy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mandamintuta willapashäcunata, yachachishäcunata sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Ñawi nïñuyquita chapashayquinöraj yachachishäcunata yachacorga alli cawaytami tarinquipaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yachachishäcunataga imaypis mana gonganayquipaj umayquiman sumaj churacuy.","poem":1},{"lineBreak":true},{"text":"Maquiquiman isquirbiy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yachaytaga «pañëmi canqui» niy.","poem":1},{"lineBreak":true},{"text":"Yarpaysapa caytapis «castämi canqui» niy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaycunami salbashunquipaj runapa warminpita,","poem":1},{"lineBreak":true},{"text":"alli shimillanpa luwarta gocoj warmipitapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Juc junaj, ricchacuycarä","poem":1},{"lineBreak":true},{"text":"wasëpa bentäna rëjas uchcullanpa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ricapaycarä mana tantiyacoj mösucunata.","poem":1},{"lineBreak":true},{"text":"Chaycho ricapaycarä mas mana yarpachacoj mana tantiyacoj caj mösuta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chay mösuga cälli isquïnaman chayar jucaj-lä cälliman chimpariran","poem":1},{"lineBreak":true},{"text":"mañösa warmipa wasin caj-läman.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Intiga yagashana captin,","poem":1},{"lineBreak":true},{"text":"pachaga chacaycaranna.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mañösa warmiga illajpita llojshiriran tincunanpaj jipash tucur,","poem":1},{"lineBreak":true},{"text":"milluycachaycar, guepishtaycachar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chay warmiga wasinta cachaycur-cachaycur puricoj warmimi.","poem":1},{"lineBreak":true},{"text":"Näni quinraycho wapiycachayllatami yachan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chay warmiga cällicunapa, läsacunapa puricun. Isquïnacunacho ichiycachäcun.","poem":1},{"lineBreak":true},{"text":"Pï runatapis rimir-puntata yurircoj cajta luwarta gonanpaj shuyaraycan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chay warmi yarpayniynaj mösuwan tincurcorga juclla","poem":1},{"lineBreak":true},{"text":"macallacurcusha, muchayta gallaycusha.","poem":1},{"lineBreak":true},{"text":"Mana pengacuypa nisha:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"«Alli goyaypita sacrifisyuta garanäpämi aunirä.","poem":1},{"lineBreak":true},{"text":"Chayno aunishätaga canan junajmi cumlishcä.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaymi gamwan tincoj llojshimushcä.","poem":1},{"lineBreak":true},{"text":"Gamwan tincuytaga fiyupami munarä.","poem":1},{"lineBreak":true},{"text":"Yarpashänöllami tincuycunchi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Cämämanpis mashtashcä","poem":1},{"lineBreak":true},{"text":"Egiptucho awashan lïnupita cuyayllapaj cullchatami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Cämätaga pichushcä","poem":1},{"lineBreak":true},{"text":"mïrra, áloe, canëla perfümiwan.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wasëman juclla yaycushun.","poem":1},{"lineBreak":true},{"text":"Warayllata cacushun.","poem":1},{"lineBreak":true},{"text":"Munashanchïno waräcushun.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Runäga manami caychöchu.","poem":1},{"lineBreak":true},{"text":"Carupami aywacusha.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chaychica guellayta apacurcurmi aywacusha.","poem":1},{"lineBreak":true},{"text":"Llëna quillachörämi cutimonga» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Chayno cuyacoj shiminwan parlapaycällar,","poem":1},{"lineBreak":true},{"text":"yaparir-yaparir niycällar mösutaga aunichisha.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aunircorga mösupis warmipa guepanta wasiman yaycusha.","poem":1},{"lineBreak":true},{"text":"Pishtananpaj quiquillan töru aywacuycajno,","poem":1},{"lineBreak":true},{"text":"togllaman lluychu yaycupaycoj-japuy yaycusha.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aywasha wañunanpaj cashanta mana musyashpan","poem":1},{"lineBreak":true},{"text":"trampaman pichiusa yaycupaycojno.","poem":1},{"lineBreak":true},{"text":"Shongunpa tucsipaycuptinrämi mayanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ïju, chaymi sumaj wiyacamay.","poem":1},{"lineBreak":true},{"text":"Willapashäcunataga llapanta sumaj tantiyacuy.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Chay-niraj warmitaga ama parlapanquipischu ni munapanquipischu.","poem":1},{"lineBreak":true},{"text":"Chay-niraj warmillapitaga ama llutancunaman chayanquichu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Chayno warmicunaga achca runatami wañuyman chayachisha.","poem":1},{"lineBreak":true},{"text":"Wañuchishancunaga aypallami.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Chay-niraj warmicunaman aywaparga caycanqui","poem":1},{"lineBreak":true},{"text":"wañuyman aywapaycajnönami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}