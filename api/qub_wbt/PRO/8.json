{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":8,"content":[{"type":"heading","content":["Yachay rimashan"]},{"type":"verse","number":1,"content":[{"text":"Yachayga willacoj warminömi gayacuyparaj willacuycan.","poem":1},{"lineBreak":true},{"text":"Tantiyaypis llapan wiyanantami munan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Puytush lömaman ichiycur,","poem":1},{"lineBreak":true},{"text":"näni raquejcunaman ichiycur willacuycan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Marcaman yaycuna puncucunacho gayacuycan:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«Runacuna, canan parlamushäga","poem":1},{"lineBreak":true},{"text":"caycan gamcuna wiyacunayquipämi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tantiyacuyta mana munaj mösucuna,","poem":1},{"lineBreak":true},{"text":"yarpayniyoj canayquipaj yachacuy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wiyamay-llapa.","poem":1},{"lineBreak":true},{"text":"Fiyupa allicunatami willapäshayqui.","poem":1},{"lineBreak":true},{"text":"Dios munashan cajcunatami yachachishayqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rasun cajllatami yachachishayqui","poem":1},{"lineBreak":true},{"text":"Nogaga manami llullacöchu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rasun cajllatami rimä.","poem":1},{"lineBreak":true},{"text":"Ichicllatapis manami llullacöchu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yachachishäga fäsi yachacuymi yarpaysapacunapäwan tantiyacojcunapäga.","poem":1},{"lineBreak":true},{"text":"Chaycunaga manami llutanchu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Guellayta gorita ashinayquipa ruquenga","poem":1},{"lineBreak":true},{"text":"yachachishätaraj wiyacuy, yachacuy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yachaymanga manami tincunchu cuyayllapaj perlas rumipis.","poem":1},{"lineBreak":true},{"text":"Mas fiyupa munay cajpis manami tincunchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Noga yachayga juc runanömi cä.","poem":1},{"lineBreak":true},{"text":"Nogami runataga yarpayniyojyächë.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tayta Diosta rispitaj runaga mana alli cajcunata llapantami chiquin.","poem":1},{"lineBreak":true},{"text":"Nogaga chiquëmi alli-tucojta,","poem":1},{"lineBreak":true},{"text":"jucha aparicojta, llapan llullacojta.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nogami yarpächë imapäpis; imata rurananpäpis camacächë.","poem":1},{"lineBreak":true},{"text":"Nogami camacächë yarpaysapa cananpäpis, callpayoj cananpäpis.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nogapitami raycunapis munaynincho runacunata chararan.","poem":1},{"lineBreak":true},{"text":"Rasun cajllata rurar arriglajcunapis runacunata alli arriglan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nogapitami llapan mayur mandajcunapis chaychica runata mandan.","poem":1},{"lineBreak":true},{"text":"Noga captëmi autoridäcunapis alli arriglan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Cuyamajcunata nogaga cuyämi.","poem":1},{"lineBreak":true},{"text":"Ashimajcunapis yachacunmi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nogami camacächë rispitasha cananpaj, ima-aycayojpis cananpaj.","poem":1},{"lineBreak":true},{"text":"Ima-aycata chasquinanpäpis, allicho llojshinanpäpis camacächë.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Noga tarichishäga allinnin goripitapis mas allimi.","poem":1},{"lineBreak":true},{"text":"Munachishäga aypalla guellaypitapis mas allimi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nogaga llapantapis alli cajllatami camacächë.","poem":1},{"lineBreak":true},{"text":"Alli cajta rurayllachömi goyä.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Cuyar yachacamajcunataga ima-aycatapis tarichëmi.","poem":1},{"lineBreak":true},{"text":"Tarichë wasincho ima-aycanpis mana pishej cananpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Tayta Diosga gallaycunallanchönami nogata ruramaran.","poem":1},{"lineBreak":true},{"text":"Imatapis manaraj camallarnami ruramaran.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Imapis manaraj captin gallarinanchömi ruramaran.","poem":1},{"lineBreak":true},{"text":"Cay pachatapis manaraj camallarnami ruramaran.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"May-may lamarcunapis manaraj captillannami ruramaran.","poem":1},{"lineBreak":true},{"text":"Pucyucunapis manaraj pashtamuptin, mayucunapis manaraj aywaptillannami ruramaran.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Puntacunawan jircacunapis manaraj captinmi","poem":1},{"lineBreak":true},{"text":"Tayta Dios mayna ruramashana caran.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Chay öraga chaqui jircacunapis, ni allpapis manami caranrächu.","poem":1},{"lineBreak":true},{"text":"Cay munducho ñuchu allpa caycajpis manami caranrächu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Janaj pachaman yacuta raquiptin,","poem":1},{"lineBreak":true},{"text":"allpaman yacuta raquiptin,","poem":1},{"lineBreak":true},{"text":"paychömi caycarä.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Syëluman pucutayta camacächiptin,","poem":1},{"lineBreak":true},{"text":"lamarcho yacu mana pishïnanpäpis camacächiptin","poem":1},{"lineBreak":true},{"text":"paywanmi caycarä.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Allpa jananman mana llojshimunanpaj lamar yacuta camacächiptin,","poem":1},{"lineBreak":true},{"text":"allpa mana cuyucunanpaj sumaj tacyachiptin","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"paychömi nogaga caycarä nishanta rurar.","poem":1},{"lineBreak":true},{"text":"Nogami payta cushicachej cä.","poem":1},{"lineBreak":true},{"text":"Mana cachariypami cushisha paycho caycarä.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tayta Dios camashan pachacho fiyupa cushishami caycashcä.","poem":1},{"lineBreak":true},{"text":"Runata ricar fiyupami cushicurä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"«Wamräcuna, canan willapashätaga sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Yachachishäno cawarga cushishami goyanquipaj.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Yachachishäcunata sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"Yachaynëta tantiyachishäta ama manacajman churaychu.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yachachishäta wiyacoj runaga fiyupa cushishami canga.","poem":1},{"lineBreak":true},{"text":"Wiyamänanpaj wasë puncucho shuyämajcunaga cushishami goyanga.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Nogata tarimaj cäga imaycamapis cushishami cawanga.","poem":1},{"lineBreak":true},{"text":"Tayta Diospis allimi rican.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Nogata mana yarpämajcunami ichanga quiquillan mana allita ruracuycan.","poem":1},{"lineBreak":true},{"text":"Chiquimajcunaga quiquincunami wañuyta ashiycan.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}