{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PRO","translationId":"qub_wbt","name":"PROVERBIOS","commonName":"PROVERBIOS","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"622bf1628def13fb2e3c1f4ade721dd45efa65efc83507cecea5470a1fc875e2","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/qub_wbt/PRO/31.json","totalNumberOfVerses":912},"chapter":{"number":9,"content":[{"type":"heading","content":["Yachaj caywan mana yachaj cay"]},{"type":"verse","number":1,"content":[{"text":"Yachayga wasinta allimi rurasha.","poem":1},{"lineBreak":true},{"text":"Ganchis pilancuwan camarajllata arusha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nircurnami uywacunata pishtasha.","poem":1},{"lineBreak":true},{"text":"Mas allinnin mishquej bïnuta rurachisha.","poem":1},{"lineBreak":true},{"text":"Mësatapis camarisha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nircur warmi uywaynincunata cachasha gayacunanpaj.","poem":1},{"lineBreak":true},{"text":"Chaura altunninman wichaycur gayacusha shuntacämunanpaj","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«Mana tantiyacoj mösucuna cayman shamuy» nir.","poem":1},{"lineBreak":true},{"text":"Wallca yarpayniyojcunata gayacusha","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"«Camaricushä micuyta micunapaj shamuy.","poem":1},{"lineBreak":true},{"text":"Rurashä bïnuta upunapaj shamuy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ama ruraynachu mana allitaga.","poem":1},{"lineBreak":true},{"text":"Chayrämi alli cawanquipaj.","poem":1},{"lineBreak":true},{"text":"Yarpaysapa runano alli goyay» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Fiyu runata piñacuptiquega ashllishunquipämi.","poem":1},{"lineBreak":true},{"text":"Mana rispitacojta piñacuptiquega manacajmanmi churanga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mana rispitacojcunaga piñacuptiqui chiquipäshunquipämi.","poem":1},{"lineBreak":true},{"text":"Yachaj runacunami ichanga piñacuptiqui fiyupa cushicurmi chasquicongapaj cuyashunquipaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yachaj runaga yachachiptiqui masmi yachaj ricaconga.","poem":1},{"lineBreak":true},{"text":"Alli runacunata yachachiptiqui masmi yachacongapaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rasunpa yachaj canapäga Tayta Diostami rimëruga rispitaypaj.","poem":1},{"lineBreak":true},{"text":"Santo Tayta Diosta rejsejcunaga fiyupa yarpayniyojmi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fiyupa allimi musyaj yachaj cayman chayashayquega.","poem":1},{"lineBreak":true},{"text":"Chaypitami unaycama cawanquipaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yachaj carga yachayniquiwanmi allicho goyanquipaj.","poem":1},{"lineBreak":true},{"text":"Mana rispitacoj fiyu runa carmi ichanga jinyuyquipita ñacanquipäpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mana tantiyacoj cayga washa-rima warminömi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Washa-rimacunaga wasinpa puncuncunachöga bancuta churacuycur jamaran.","poem":1},{"lineBreak":true},{"text":"Marcachöpis altu pataman wichaycurmi jamaran.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nircur näninpa","poem":1},{"lineBreak":true},{"text":"aywacuycajcunata gayan:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"«Mana tantiyacoj upa mösucuna caypa shamuy» nir.","poem":1},{"lineBreak":true},{"text":"Mana tantiyaj yarpayniynajcunatana gayacachin:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"«Suwacuy yacuga masmi mishquin.","poem":1},{"lineBreak":true},{"text":"Pacayllapa tantata micushaga mishquin» nir.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gayaptin aywajcuna ichanga manami musyanchu chaycho wañuy caycashanta.","poem":1},{"lineBreak":true},{"text":"Manami musyanchu gayashan runacunaga llapanpis wañunanta.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}