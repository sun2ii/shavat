 allimi llojshipan!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Fiyu runacunapäga manami chaynöchu.","poem":1},{"lineBreak":true},{"text":"Paycunaga carcaycan wayra apashan chaqui panganömi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaymi juchasapacunataga Tayta Dios castiganga.","poem":1},{"lineBreak":true},{"text":"Juchaynajcunawan iwalga mana goturangachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Juchaynajcunataga alli nänipa pushar Tayta Diosmi alli cawayman chayachin.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunatami ichanga quiquin purishan nänicho usharenga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}