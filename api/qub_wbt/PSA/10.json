{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":10,"content":[{"type":"heading","content":["Yanapänanpaj Diosta mañacushan"]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios ¿imanirtaj carullacho cacunqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj pacacunqui llaquicuycuna cashan öra?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fiyu runacunaga alli-tucushpanmi umildicunata achäquita ashipan.","poem":1},{"lineBreak":true},{"text":"Chaypis fiyucunaga quiquincunami rurashan togllallacho watacäconga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fiyu runacunaga quiquincuna alli cashanta yarparmi alabacun.","poem":1},{"lineBreak":true},{"text":"Yargajcunaga Tayta Diosta manacajman churarmi disprisyan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chay runacunaga alli-tucur nin:","poem":1},{"lineBreak":true},{"text":"«Diosga manami canchu.","poem":1},{"lineBreak":true},{"text":"Piräshi nogata jusgamanman imata rurashätapis» nir.","poem":1},{"lineBreak":true},{"text":"Chayllatami imay örapis yarparaycan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Imata rurashanchöpis allimi llojshipacun.","poem":1},{"lineBreak":true},{"text":"Paycunaga jusgacänanpaj cashanta manami yarpanchu.","poem":1},{"lineBreak":true},{"text":"Chiquinacushantaga manacajmanmi churan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paycunaga yarpaycan pipis mana alliman mana chayachinantami,","poem":1},{"lineBreak":true},{"text":"imaypis inrïduman mana chayaytami.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Paycunaga manacajcunatami llullacun, engañacunmi, ashllicunmi.","poem":1},{"lineBreak":true},{"text":"Shimi puncullanchömi caycan pitapis imatapis ninanpaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Marca llojshinacho, yaycunacho pacacuycur shuyarpan.","poem":1},{"lineBreak":true},{"text":"Nircur juchaynajcunataga wañuchin.","poem":1},{"lineBreak":true},{"text":"Pipis washänanpaj mana cajcunataga watgarcaycan.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Liyun machaypita ricchacojnörämi,","poem":1},{"lineBreak":true},{"text":"pacarashanpita pobritaga watgarcaycan.","poem":1},{"lineBreak":true},{"text":"Chariycärerga garchacarcärir apacun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Umpurcur, ñuquircur,","poem":1},{"lineBreak":true},{"text":"shuyarpaycaptillannami pipis washänanpaj mana cajcunaga maquinman chayan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fiyucunaga yarpan «Diosga pobricunata gongaycushami.","poem":1},{"lineBreak":true},{"text":"Cäranta chapacurcur imaypis mana ricanchu» nir.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"¡Tayta Dios apuray ari!","poem":1},{"lineBreak":true},{"text":"¡Ama wiyaräcuychu!","poem":1},{"lineBreak":true},{"text":"¡Pobricunataga ama gongaychu!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¿Imanirtaj fiyucunaga manacajman churashunqui Tayta Dios?","poem":1},{"lineBreak":true},{"text":"Paycunaga yarpan «imaypis Diosga manami jusgamangachu» nir.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Gamga quiquiquimi ricashcanqui fiyupa mana allita rurashanta.","poem":1},{"lineBreak":true},{"text":"¡Ricasha carmi, castiganquipaj imano rurashanpitapis!","poem":1},{"lineBreak":true},{"text":"Gammanmi yäracamun pïninpis mana cajcunaga.","poem":1},{"lineBreak":true},{"text":"Gamllami wacchacunata yanapanqui.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"¡Fiyucunataga maquintapis paquirgäriy!","poem":1},{"lineBreak":true},{"text":"¡Llapan mana allita rurashancunapita jusgay!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Cay pachachöga Tayta Diosllami imaycamapis ray.","poem":1},{"lineBreak":true},{"text":"¡Payta mana rispitajcunataga gargongami!","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Tayta Dios, umildicuna mañacamushushayquitaga wiyashcanquimi.","poem":1},{"lineBreak":true},{"text":"Chaymi shacyächir yanapanqui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wacchacunata, ñacaycajcunataga washar yanapaycuy ari.","poem":1},{"lineBreak":true},{"text":"Chaura fiyu runacunaga manacaj caycar mananami paycunata mancharachenganachu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}