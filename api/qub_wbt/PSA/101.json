{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":101,"content":[{"type":"heading","content":["Tayta Diosta ray aunishan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios cuyacoj cashayquipitami alabashayqui.","poem":1},{"lineBreak":true},{"text":"Allillata rurashayquipitami alabashayqui.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, gamllatami alabashayqui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gam munashayquinöllami nogaga goyayta munä.","poem":1},{"lineBreak":true},{"text":"¿Imayraj noga cajman shamunqui?","poem":1},{"lineBreak":true},{"text":"Palasyöchöpis allillatami rurashaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Manami imaypis yarpäshächu mana allicunata ruraypäga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta mana rispitajcuna rurashantaga melanäcömi.","poem":1},{"lineBreak":true},{"text":"Chayno mana alli ruraycunamanga manami jaticäshächu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mana allicunataga manami yarpäshäpischu.","poem":1},{"lineBreak":true},{"text":"Imatapis mana allicunataga manami rurayta munächu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bisïnunpa washanta pacayllapa parlaycajta nogaga piñacushämi.","poem":1},{"lineBreak":true},{"text":"Manami awantächu ollgojcunatawan alli-tucojcunataga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Allita ruraj runacunatami acrashaj nogawan iwal tiyananpäga.","poem":1},{"lineBreak":true},{"text":"Allita rurar goyajcunallami canga nogata sirbimänanpäga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jagata mana pägacojcunaga manami palasyöcho tiyangachu.","poem":1},{"lineBreak":true},{"text":"Pï llullapis ñaupächöga manami cangapächu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Waran-waranllantami illgächishaj cay nasyuncho caycaj fiyucunataga.","poem":1},{"lineBreak":true},{"text":"Mana allita rurajcunataga Tayta Diospa siudäninpita llapantami jitarishaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}