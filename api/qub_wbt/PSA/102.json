{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":102,"content":[{"type":"heading","content":["Llaquicuycaj runa mañacushan"]},{"type":"hebrew_subtitle","content":["Llaquicoj runa llapan shongunpa Tayta Diosta mañacushan."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, mañacamushäta wiyaycamuy.","poem":1},{"lineBreak":true},{"text":"Quijacamushätapis wiyaycamuy ari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Llaquicuycaptëga nogapita ama pacacuychu ari.","poem":1},{"lineBreak":true},{"text":"Wiyaycamay ari. Mañacaycämuptëga juclla yanapaycamay ari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Goshtay illgajnömi aywacuycä.","poem":1},{"lineBreak":true},{"text":"Tullöcunapis wayllaycan shanshanömi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Guewa wañuytajnömi shongöpis ushaycan.","poem":1},{"lineBreak":true},{"text":"Manami micunäpischu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chay-jina ataycällarnami agrayashcäpis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogaga caycä chunyajcho tucu caycajnömi,","poem":1},{"lineBreak":true},{"text":"gagacunacho pillyaj äbi caycajnömi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Puñuytapis manami tarëchu.","poem":1},{"lineBreak":true},{"text":"Nogaga caycä wasi janancho wacchayasha pichiusanömi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chiquimajcunaga cada rätumi wiyächiparcaycäman.","poem":1},{"lineBreak":true},{"text":"Jutëtapis jogarisha manacajman churamashpanmi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tantapa ruquin uchpallatami acuycäpis.","poem":1},{"lineBreak":true},{"text":"Upuycashä yacumanpis weguëmi jutuycan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fiyupami rabyacurcushcanqui.","poem":1},{"lineBreak":true},{"text":"Chaymi nogataga jogarcur jitaramashcanqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Llantuy päsacojnöllami watäcunapis päsacuycan.","poem":1},{"lineBreak":true},{"text":"Guewa wañuytajnömi wañuycä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gam ichanga Tayta Dios, imaypis raymi caycanqui.","poem":1},{"lineBreak":true},{"text":"Imaypis manami gongacanquipächu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Jatarcushpayqui Sionta cuyapaycuyna.","poem":1},{"lineBreak":true},{"text":"Payta cuyapänayquipaj jitashayqui diya chayamushanami.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sirbishojcunaga Sionta ragällata ricarmi fiyupa llaquicurcaycan.","poem":1},{"lineBreak":true},{"text":"Juchusha caycajta ricarpis pasaypami cuyan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Llapan nasyun runacunawan raycunami munayniyoj Tayta Diosta rispitangapaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pay Sionta allchananpaj shamushpanmi munayniyoj cashanta musyachiconga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wacchacuna mañacushanta Tayta Diosga wiyanmi. Paycuna mañacushantaga manami gonganchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Guepata yurejcuna ricananpaj isquirbicächun.","poem":1},{"lineBreak":true},{"text":"Chaymi guepata yurejcunapis Tayta Diosta alabanga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Cayno isquirbichun: «Tayta Diosga ricarämun janaj pacha tiyashanpita.","poem":1},{"lineBreak":true},{"text":"Chaypitami cay pachataga ricamun.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wañuchicänanpaj caycaj prësucuna llaquicuycajta wiyar salbaran.»","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chaynöpami Sioncho Tayta Diospita willaconga.","poem":1},{"lineBreak":true},{"text":"Jerusalencho Tayta Diosta alabanga.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Intëru nasyunpita runacuna, raycuna shuntacarcurmi Tayta Diosta aduranga.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mösullaraj caycaptënami callpätapis ushacächisha.","poem":1},{"lineBreak":true},{"text":"Cawanäpaj caj watacunatapis wallcayächisha.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nogaga në: «Tayta Dios, amaraj apacamayrächu. Mösullaraj caycaptëga amaraj pushacamayrächu.»","poem":1},{"lineBreak":true},{"text":"Gamga canqui mana nunca wañojmi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tayta, gallarinanpita-pachami cay pachatapis gamga tacyachishcanqui.","poem":1},{"lineBreak":true},{"text":"Quiquiquimi syëlutapis rurashcanqui.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Llapanmi chaycunapis illgangapaj.","poem":1},{"lineBreak":true},{"text":"Gammi ichanga jinalla caycanquipaj.","poem":1},{"lineBreak":true},{"text":"Llapan chaycunaga röpanömi ushacanga.","poem":1},{"lineBreak":true},{"text":"Juc runa röpata rucacurejno gam rucachiptiquega rucachishami canga.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Gammi ichanga cashayquinölla caycanquipaj.","poem":1},{"lineBreak":true},{"text":"Gamga imaypis chaynöllami cawaycanquipaj.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Sirbishojcunapita mirajcunataga allichömi goyächinquipaj.","poem":1},{"lineBreak":true},{"text":"Quiquiquipa ñaupayquichömi tiyachinquipaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}