":"verse","number":15,"content":[{"lineBreak":true},{"text":"«Ama yatapaychu acrashä runacunataga.","poem":1},{"lineBreak":true},{"text":"Profëtäcunatapis ama ñacachiychu» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Cay pachachöga fiyupa muchuymi caran.","poem":1},{"lineBreak":true},{"text":"Ima micuytapis manami wayuchiranchu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Paycunapa ñaupanta Tayta Diosga Josëta cacharan.","poem":1},{"lineBreak":true},{"text":"Josëtaga uyway cananpaj ranticuycuran.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Paytaga charararan chaquincunata cadinacunawan watashalla.","poem":1},{"lineBreak":true},{"text":"Carsilcho wichgarächiran.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"José rimashan cumlinancama carsilcho wichgarächiran.","poem":1},{"lineBreak":true},{"text":"José willashan rasunpa cashanta chay junaj Tayta Dios musyachiran.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aypalla runacunata mandaycaj raymi niran carsilcho caycaj Josëta cachaycunanpaj.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chayrämi Josëta churaran wasincho mandaj cananpaj;","poem":1},{"lineBreak":true},{"text":"ima-aycantapis ricananpaj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Churaran musyaj-yachajcunata, mandajcunata, auquincunatapis yachaj cayta yachachinanpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Chaypitarämi Egiptuman Jacobga chayaran.","poem":1},{"lineBreak":true},{"text":"Cam nasyunchöga Jacobpita mirajcuna tiyaran jäpa runacunanöllami.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Chaychöga acrashan runacunata aypallaman Tayta Dios mirachiran.","poem":1},{"lineBreak":true},{"text":"Paycunaga Egipto runacunapita mas cal