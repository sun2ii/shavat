{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":106,"content":[{"type":"heading","content":["Israelcuna achca cuti mana wiyacushan"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Tayta Diosga alabasha cachun!","poem":1},{"lineBreak":true},{"text":"Tayta Diosta agradësicuy-llapa amatar alli cashanpita.","poem":1},{"lineBreak":true},{"text":"Pay cuyacoj cashanga imaycamapis chaynöllami.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Piraj Tayta Dios milagruta rurashancunata willacuyta camäpacunman?","poem":1},{"lineBreak":true},{"text":"¿Piraj alabanman Tayta Diosta alabanapaj cashanmannöga?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rasun cajllata, alli cajllata ruraj cajcunaga cushishami cawanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nogata yarpäramanqui Tayta Dios, acrashayqui runacunata yanapashayqui öra.","poem":1},{"lineBreak":true},{"text":"Yarpaycamanqui ari salbanayquipaj shamushpayquipis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaynöpami noga ricashaj acrashayqui runacuna alli goyajta.","poem":1},{"lineBreak":true},{"text":"Chayta ricarmi noga cushicushaj acrashayqui runacunawan iwal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nogacunaga juchatami rurashcä.","poem":1},{"lineBreak":true},{"text":"Mana allitami rurashcä.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunami cashcä unay caj taytäcunanöpis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Unay caj awilöcuna Egiptucho cashpan","poem":1},{"lineBreak":true},{"text":"manami tantiyacuranchu fiyupa almiraypajcunata rurashayquita.","poem":1},{"lineBreak":true},{"text":"Fiyupa cuyacoj cashayquitami gongaycäriran.","poem":1},{"lineBreak":true},{"text":"Nircur Puca Lamar cantunchömi gampa contrayqui ricacuran.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaypis Tayta Diosga salbaran munayniyoj cashanta musyananpaj,","poem":1},{"lineBreak":true},{"text":"payta alabananpaj, jutinta rispitananpaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Diosga Puca Lamarta piñacuran. Chaura chaquiman ticraran.","poem":1},{"lineBreak":true},{"text":"Lamar chaquishanpami päsachiran chunyaj chaqui jircapano.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chaynömi salbaran contrancunapita, chiquejcunapa munayninpita.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chiquejcunataga yacu ñiticurcuran.","poem":1},{"lineBreak":true},{"text":"Chaura ni jucnayllapis manami quëdaranchu cawaycäga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chayrämi riguiran imano rurananpäpis Tayta Dios aunishanta.","poem":1},{"lineBreak":true},{"text":"Chaura alabansacunawan alabaran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ichanga Tayta Dios imata rurashancunatapis runacunaga rätu gongaycäriran.","poem":1},{"lineBreak":true},{"text":"Pay willapashancunata manami cäsuranchu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chay chunyaj chaqui jircachömi","poem":1},{"lineBreak":true},{"text":"Tayta Diostaga munashanta rurachiyta munaran.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chaymi Tayta Diosga ruraparan paycuna munashanta.","poem":1},{"lineBreak":true},{"text":"Ichanga paycunacho yurichiran wañuchicoj gueshyata.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chaynöpami chunyajcho tolduncunacho tiyarcaycashancho Moisespaj rabyaran,","poem":1},{"lineBreak":true},{"text":"Tayta Dios acrashan Aaronpäpis.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaura allpa quichacäcur Datanta ultacurcuran.","poem":1},{"lineBreak":true},{"text":"Chayno Abiramta gatirajcunatapis micucurcuran.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Paycunachöga nina ratariran.","poem":1},{"lineBreak":true},{"text":"Fiyucunataga llapanta nina ratarir ushacurcuran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Horeb jircacho ruracarcäriran juc besërata.","poem":1},{"lineBreak":true},{"text":"Chayga caycaran goripita jundiypa rurashan ïdulu.","poem":1},{"lineBreak":true},{"text":"Chayta adurar gongurpacuran.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fiyupa munayniyoj Tayta Diosta adurananpa ruquin","poem":1},{"lineBreak":true},{"text":"adurarcaycaran guewa micoj buyita-niraj rurashanta.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Paycunaga gongaycäriran salbajnin Tayta Dios","poem":1},{"lineBreak":true},{"text":"Egiptucho munayninwan milagrucunata rurashanta.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Paymi milagrucunata ruraran chay Cam nasyuncho.","poem":1},{"lineBreak":true},{"text":"Chayno Puca Lamarchöpis fiyupa almiraypajcunata ruraran.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tayta Diosga runacunata illgarachinanpämi caycaran.","poem":1},{"lineBreak":true},{"text":"Ichanga acrashan Moisesmi ruwacur allchacächiran","poem":1},{"lineBreak":true},{"text":"Tayta Dios rabyasha caycajta.","poem":1},{"lineBreak":true},{"text":"Chaynöpami mana illgächirannachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Chaypita guepataga cuyayllapaj nasyunta manacajman churaran.","poem":1},{"lineBreak":true},{"text":"Tayta Dios aunishanta manami riguiranchu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tiyaycashancunacho Tayta Diospa washanta parlaran.","poem":1},{"lineBreak":true},{"text":"Pay nishantaga mana wiyacuranchu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Chaymi Tayta Diosga juraran chunyajcho llapan wañunanpaj.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Juraran paycunapita mirajcunapis wañunanpaj,","poem":1},{"lineBreak":true},{"text":"juc-lä nasyuncunaman gargurinanpäpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Paycunaga Baal-peorta sirbiran.","poem":1},{"lineBreak":true},{"text":"Mana cawaj dioscunapaj churashanta micuran.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mana allita rurashpan Tayta Diosta rabyachiran.","poem":1},{"lineBreak":true},{"text":"Chaypitami paycunacho gueshya yuricuriran.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Chayno gueshya caycaptin Fineesga juchayojta wañuchiran.","poem":1},{"lineBreak":true},{"text":"Chayrämi gueshya jamaran.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Chayno rurashanpitami Tayta Diosga camacächiran","poem":1},{"lineBreak":true},{"text":"payta imaycamapis yarpänanpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Chaypitapis Meriba yacu ñaupancho Tayta Diosta yapay rabyachiran.","poem":1},{"lineBreak":true},{"text":"Paycuna chayno rabyachishanmi Moisespäga mana alli caran.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Moisestaga fiyupami rabyachiran.","poem":1},{"lineBreak":true},{"text":"Chaymi payga rabyashpan imatapis rimaran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Wañuchinanpaj Tayta Dios nishan runacunatapis paycunaga manami wañuchiranchu.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Chaypa ruquenga Tayta Diosta mana rispitajcunawan majachacaran.","poem":1},{"lineBreak":true},{"text":"Nircur chay runacunapa custumrinta yachacuran.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Tayta Diosta mana rispitajcuna rurashan ïdulucunata aduraran.","poem":1},{"lineBreak":true},{"text":"Chayno rurashancunami achäqui caran paycuna mana alliman chayananpaj.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Paycunaga wamrancunata ollguta warmitapis rupachiran dyablucunapaj.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Paycunaga iticunapa yawarninta mashtaran.","poem":1},{"lineBreak":true},{"text":"Chayga caran ollgu warmi wamrancunapa yawarninmi.","poem":1},{"lineBreak":true},{"text":"Cananeo runacunapa diosnincunapämi wamrancunata rupachiran.","poem":1},{"lineBreak":true},{"text":"Chaynöpami cay pachacho yawar mashtararan.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Paycuna mana allita rurarmi juchayojyaran.","poem":1},{"lineBreak":true},{"text":"Chaynöpami ganra melanaypaj ricacuran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Tayta Diosga acrashan runacunapaj fiyupa rabyacurcuran.","poem":1},{"lineBreak":true},{"text":"Chay runacunataga fiyupa melanäcuran.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Payta mana rispitajcunapa munayninman cachaycuran.","poem":1},{"lineBreak":true},{"text":"Chiquinacushancunanami paycunataga maquincho charararan.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Chiquinacushancunaga fiyupa ñacachiran.","poem":1},{"lineBreak":true},{"text":"Munaynincho chararashpanna pasaypa pengacachiran.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Tayta Diosga achca cutimi salbaran.","poem":1},{"lineBreak":true},{"text":"Tayta Dios imachöpis yanapänanpaj caycashantapis quiquincunami pirdichiran.","poem":1},{"lineBreak":true},{"text":"Chaynöpami sïguir juchata rurashpan mana alliman chayaran.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Chayno captinpis llaquicuycajta ricar, gaparpaycajta wiyar","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Tayta Diosga yarpäriran paycunawan conträtuta rurar parlacushanta.","poem":1},{"lineBreak":true},{"text":"Chaymi yapay yanaparan.","poem":1},{"lineBreak":true},{"text":"Chaynöga yanaparan fiyupa cuyacoj cashpanmi.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Chaymi camacächiran paycunata maquincho chararaycajcunapis allina ricananpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"¡Tayta Dios salbaycamay ari!","poem":1},{"lineBreak":true},{"text":"¡Llapan nasyuncunacho carcaycajtapis shuntaycamay","poem":1},{"lineBreak":true},{"text":"llapanë gamta agradësicunäpaj,","poem":1},{"lineBreak":true},{"text":"cushisha alabanäcunapaj!","poem":1}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"¡Israelcuna rispitashan Tayta Diosga imaycamapis alabasha cachun!","poem":1},{"lineBreak":true},{"text":"¡Llapanpis «Amén» nichun!","poem":1},{"lineBreak":true},{"text":"¡Aleluya! ¡Tayta Diosga alabasha cachun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}