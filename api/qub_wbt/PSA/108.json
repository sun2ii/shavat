janaj syëluchöpis llapanpämi munayniyoj caycanqui.","poem":1},{"lineBreak":true},{"text":"Cay pachapis intërumi munaynillayquicho caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"¡Cananga Tayta Dios munayniquiwan salbamay ari!","poem":1},{"lineBreak":true},{"text":"¡Cuyashayqui runacunata salbaycuy ari!","poem":1},{"lineBreak":true},{"text":"¡Wiyaycamay ari!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Dios Templuyquicho caycarmi aunimarayqui cayno nir:","poem":1},{"lineBreak":true},{"text":"«¡Ima cushisharaj raquipäshaj Shequemta!","poem":1},{"lineBreak":true},{"text":"¡Ima cushisharaj partipäshaj Sucot pampatapis!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Galaadwan Manasesga nogapami.","poem":1},{"lineBreak":true},{"text":"Efrainga acrashä runacunata chapänanpaj caycan umäta chapämaj cascönömi.","poem":1},{"lineBreak":true},{"text":"Judäga caycan acrashä runacunata mandananpaj ray tiyananmi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moabga sirbimänanpaj carmi mayllacunä labaturyuno.","poem":1},{"lineBreak":true},{"text":"Edomnami llanguëta purichej uywaynëno canga.","poem":1},{"lineBreak":true},{"text":"¡Filistea runacunata binsiycurnami cushicuypita gaparäshaj!» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ichanga ¿piraj pushamanman intërunpa curalasha caycaj siudäman?","poem":1},{"lineBreak":true},{"text":"¿Piraj pushar chayachimanman Edomcama?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Dios gamga nogacunapita witicurishcanquinami.","poem":1},{"lineBreak":true},{"text":"¡Cananga mananami suldäröcunapa ñaupanta aywanquinachu!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yanapämay ari chiquimajcunata binsinäpaj.","poem":1},{"lineBreak":true},{"text":"Runaga yangallami yanapämanpis.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tayta Dios yanapämashaga binsishunmi.","poem":1},{"lineBreak":true},{"text":"¡Chiquimajninchïcunatapis paymi lluchcargärenga!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}