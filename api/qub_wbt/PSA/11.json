ine_break"},{"type":"verse","number":4,"content":[{"text":"Tayta Diosga caycan rispitädu Templunchömi.","poem":1},{"lineBreak":true},{"text":"Jamacunanpis syëluchömi caycan.","poem":1},{"lineBreak":true},{"text":"Runacuna imata rurashallantapis llapantami ricapaycan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Diosga ricaycanmi juchaynajtapis juchasapatapis.","poem":1},{"lineBreak":true},{"text":"Fiyupami chiquin fiyu runacunatawan wañuchicojcunataga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Diosga fiyu runacunaman tamyachimonga shanshata, nina rataycajta, asufrita.","poem":1},{"lineBreak":true},{"text":"Chaynömi acaj fiyu wayratapis wayrächimonga ruparinanpaj.","poem":1},{"lineBreak":true},{"text":"¡Tayta Diosmi castiganga!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Diosga juchaynajmi.","poem":1},{"lineBreak":true},{"text":"Chaymi allita ruraj runacunataga cuyan.","poem":1},{"lineBreak":true},{"text":"¡Allillata rurajcunaga Tayta Diostami ricanga!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}