{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":110,"content":[{"type":"heading","content":["Tayta Diosmi rayta munayniyojyächin"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Diosmi tayta raynëta nisha: «Cay derëchu caj lädöman jamacuy","poem":1},{"lineBreak":true},{"text":"llapan chiquishojcunata munayniquiman churanäcama» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sionpitami Tayta Diosga bastunta goshunqui munayniyoj mandaj canayquipaj.","poem":1},{"lineBreak":true},{"text":"Chiquishojcunataga munayniquicho chararay ari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pillyashayqui junaj mandashayqui runacunaga gam cajmanmi shuntacämonga.","poem":1},{"lineBreak":true},{"text":"Chay runacuna gampäga canga pacha waraptin shullay caycajnömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tayta Diosmi aunisha. Aunishantaga manami cutiricongachu.","poem":1},{"lineBreak":true},{"text":"«Melquisedecnömi gamga imaycamapis cüra canqui» niran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tayta Diosga derëchu caj-läduyquichömi caycan yanapäshunayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaymi rabyashan junäga raycunatapis illgarachenga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Runacunata paymi jusganga imano rurashanpitapis.","poem":1},{"lineBreak":true},{"text":"Gotuyninpami wañuycachenga.","poem":1},{"lineBreak":true},{"text":"Cay pachacho cajtaga achcajpatami umantapis paquirgärenga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rayga nänipa aywaycashanchömi mayu-mallwapita yacuta upongapaj.","poem":1},{"lineBreak":true},{"text":"Chaycunami callpanta yurichenga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}