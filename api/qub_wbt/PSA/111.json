{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":111,"content":[{"type":"heading","content":["Ima-aycatapis rurashanpita Diosta alabashan"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Tayta Diosga alabasha cachun!","poem":1},{"lineBreak":true},"Álef",{"text":"Llapan shongöpami Tayta Diosta alabashaj","poem":1},"Bet",{"text":"alli runacuna shuntacasha caycashancho,","poem":1},{"lineBreak":true},{"text":"llapan runacunapa ñaupancho.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Tayta Dios rurashancunaga fiyupa almiraypämi.","poem":1},"Dálet",{"text":"Rurashancunata ricaycur almirajcunaga fiyupami cushicun.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Pay rurashancunaga llapanpis cuyayllapämi.","poem":1},"Vav",{"text":"Payga imaypis allillatami ruranga.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Fiyupa almiraypajcunata rurashantaga manami pipis gongangachu.","poem":1},{"lineBreak":true},"Jet",{"text":"Tayta Diosga alli shongumi y cuyapäcojmi.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Payta rispitajcunataga micuyta tarichinmi.","poem":1},"Yod",{"text":"Conträtuta rurar alli parlacushanta payga imaypis yarparaycanmi.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Acrashan runacunataga ricachiran quiquin Tayta Dios munayninwan rurashantami.","poem":1},"Lámed",{"text":"Payta mana rispitaj runacunapa chacranta guechurcur acrashan runacunata goycuran.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Dios rurashanga llapanpis allimi, rasun cajmi.","poem":1},"Nun",{"text":"Paypa mandamintuncunaga rasunpa yäracuypämi.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Chaycunaga imaycamapis mana ushacajmi caycan.","poem":1},"Ayin",{"text":"Chay mandamintuncunaga alli cajta ruranapämi rasun cajta cumlinapämi.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Acrashan runacunatami ñacaycajta jorgusha libri cananpaj.","poem":1},"Tsade",{"text":"Alli parlacushanga para-simrimi canga.","poem":1},"Qof",{"text":"Tayta Diosga juchaynajmi, fiyupa rispitaypämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rasunpa yachaj canapäga rimëru Tayta Diostami rispitaypaj.","poem":1},"Shin",{"text":"Tayta Diosta rispitajcunaga alli yarpayniyojmi.","poem":1},"Tav",{"text":"¡Tayta Diosga imaypis alabashami canga!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}