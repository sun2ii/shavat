macyaycunmi.","poem":1},{"lineBreak":true},{"text":"«Ristamay» niptinpis ristaycunmi.","poem":1},"Yod",{"text":"Nigusyutapis mana engañaypami arun.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Chaynöpami mana alliman mana chayanchu.","poem":1},"Lámed",{"text":"Alli runataga imaypis yarparaycangami.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Mana alli willapacunata wiyarpis manami manchacunchu.","poem":1},"Nun",{"text":"Alli runaga mana cachaypami Tayta Diosllaman yäracuycan.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Manami imapitapis yarpachacunchu, ni manchacunpischu.","poem":1},"Ayin",{"text":"Payta chiquejcuna mana alliman chayajtapis ricangarämi.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Pobricunata yanaparga achca achcami imatapis goycun.","poem":1},"Tsade",{"text":"Pï-maypäpis allimi canga.","poem":1},"Qof",{"text":"Pï-maypitapis rispitashami goyanga.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Chayta ricar fiyu runaga fiyupa rabyarmi chiquicurcun.","poem":1},"Shin",{"text":"Rabyawan quiruncunatapis uchongarämi.","poem":1},"Tav",{"text":"Fiyu runacuna yarpashanga manami camacangachu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}