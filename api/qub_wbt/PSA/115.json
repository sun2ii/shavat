{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":115,"content":[{"type":"heading","content":["Tayta Diosnillanchïta alabananchi camacashan"]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, gamlla alabasha cay ari.","poem":1},{"lineBreak":true},{"text":"Ama nogacunataga alabamächunchu.","poem":1},{"lineBreak":true},{"text":"Gamtaga alabashunqui cuyapäcoj cashayquipita,","poem":1},{"lineBreak":true},{"text":"rasun cajta ruraj cashayquipitami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Juc-lä nasyun runacunaga asipämar «¿maytaj Diosniqui?» nir tapuman.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diosnëga syëluchömi caycan.","poem":1},{"lineBreak":true},{"text":"Payga munashan cajta llapantami rurasha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tayta Diosta mana rispitaj runacunapa ïduluncunaga caycanmi goripitapis, guellaypitapis.","poem":1},{"lineBreak":true},{"text":"Ïduluncunaga runa rurashallanmi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Shimin captinpis manami rimanchu.","poem":1},{"lineBreak":true},{"text":"Ñawin captinpis manami ricanchu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rinrin captinpis manami wiyanchu.","poem":1},{"lineBreak":true},{"text":"Sengan captinpis manami mayanchu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Maquin captinpis manami aptanchu.","poem":1},{"lineBreak":true},{"text":"Chaquin captinpis manami purinchu.","poem":1},{"lineBreak":true},{"text":"Chaycunapa shiminpitaga manami imatapis wiyanchïchu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chay ïdulucunanömi caycan chay ïdulucunata rurajcunapis.","poem":1},{"lineBreak":true},{"text":"Chay ïdulucunanömi caycan chay ïdulucunaman yäracojcunapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Israelcuna gamcunaga Tayta Diosllaman yäracuy-llapa.","poem":1},{"lineBreak":true},{"text":"Paymi yanapämanchi, imapitapis chapämanchi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aarón casta cüracuna Tayta Diosman yäracuy.","poem":1},{"lineBreak":true},{"text":"Paymi yanapämanchi, imapitapis chapämanchi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Diosta rispitajcuna payman yäracuy.","poem":1},{"lineBreak":true},{"text":"Paymi yanapämanchi, imapitapis chapämanchi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tayta Dios noganchïta yarparcamashcanchïmi.","poem":1},{"lineBreak":true},{"text":"Bindisyuntami gomäshun.","poem":1},{"lineBreak":true},{"text":"Bindisyuntami gonga llapan Israelcunata.","poem":1},{"lineBreak":true},{"text":"Bindisyuntami gonga llapan Aarón casta cüracunata.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bindisyuntami gonga payta rispitajcunataga.","poem":1},{"lineBreak":true},{"text":"Bindisyuntami gonga jatunta tacshatapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tayta Dios yanapaycushunqui gamcunapis wamrayquicunapis aypallaman miranayquipaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Syëluta, cay pachatapis camaj Tayta Diosga","poem":1},{"lineBreak":true},{"text":"gamcunata bindisyunta goycushunqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Quiquin Tayta Diospami syëluga.","poem":1},{"lineBreak":true},{"text":"Cay pachatanami runacunata goycusha.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wañojcunaga usharäcunnami.","poem":1},{"lineBreak":true},{"text":"Paycunaga cay pachacho mananami Tayta Diosta alabannachu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Noganchïmi ichanga alabaycäshun cananpis imaycamapis.","poem":1},{"lineBreak":true},{"text":"¡Aleluya! ¡Tayta Diosga alabasha cachun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}