oem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Callpä cananpaj Tayta Diosmi yanapäman.","poem":1},{"lineBreak":true},{"text":"Chaymi payta alabä.","poem":1},{"lineBreak":true},{"text":"¡Paymi salbamajnëpis!","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tayta Diospa laynincunata cumlejcunapa wasincunachöga","poem":1},{"lineBreak":true},{"text":"binsishanpita cushicurmi cantarcaycan cayno nir:","poem":1},{"lineBreak":true},{"text":"«Tayta Diosmi munayninwan llapanta binsisha.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tayta Dios munayniyoj cashanga fiyupa almiraypämi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmi munayninwan llapanta binsisha.»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Manami wañushärächu. Cawashärämi","poem":1},{"lineBreak":true},{"text":"Tayta Dios rurashancunata willacunäpaj.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tayta Diosga fiyupami castigamasha;","poem":1},{"lineBreak":true},{"text":"ichanga manami wañunäcamachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Templupa puncunta quichapämay-llapa.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta alabar agradësicunäpämi yaycuyta munä.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chay puncumi caycan Tayta Dios cajman yaycuna.","poem":1},{"lineBreak":true},{"text":"Chaypami yayconga payta wiyacojcunaga.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tayta Dios, gamtami agradësicö","poem":1},{"lineBreak":true},{"text":"mañacushäta wiyamashayquipita, salbamashayquipita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Wasi pergajcuna «mana allichu» nishan rumiga puntu rumipaj isquïnaman churasharämi canga llapanta tucnananpaj.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Chayno cananpäga Tayta Diosmi camacächisha.","poem":1},{"lineBreak":true},{"text":"Chaypitami fiyupa almirasha carcaycanchi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Chay junajmi Tayta Diosga allita ruraran.","poem":1},{"lineBreak":true},{"text":"¡Cananga cushicur allimi goyäshun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Tayta Dios, salbaycäramay ari.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, nogacuna alliman chayanäpaj camacaycachiy ari.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"¡Tayta Diospa munaynincho shamoj rayga alabasha cachun!","poem":1},{"lineBreak":true},{"text":"Paytaga alabashun Tayta Diospa Wasinpita-pachami.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tayta Diosllami rasunpa Diosga.","poem":1},{"lineBreak":true},{"text":"Paymi achquipämanchi.","poem":1},{"lineBreak":true},{"text":"Rämacunata apamuy fistata gallaycunayquipaj.","poem":1},{"lineBreak":true},{"text":"Nircur altar caycashan cajcama rämacunata apay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Tayta Dios, gammi Diosnë canqui.","poem":1},{"lineBreak":true},{"text":"Chaymi gamta alabashayqui.","poem":1},{"lineBreak":true},{"text":"Tayta Diosnë gamtami agradësicushayqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Tayta Diosta agradësicuy-llapa amatar alli cashanpita.","poem":1},{"lineBreak":true},{"text":"Pay cuyacoj cashanga imaycamapis chaynöllami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}