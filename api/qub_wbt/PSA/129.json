_break"},{"type":"verse","number":5,"content":[{"text":"Jerusalenta chiquejcunaga binsisha cashpan pengay-tucusha quiquincuna gueshpichun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wasi janan tëjacunacho usyawan guewa wañuytajno ushacächun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chay runacunaga cachun runa rïguta rutuptin","poem":1},{"lineBreak":true},{"text":"maquipis mana charishanno, manana cäsupashanno.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chay runacunataga ama pipis nichunchu: «Tayta Dios yanapaycushunqui.","poem":1},{"lineBreak":true},{"text":"Tayta Dios bindisyunta goycushunqui» nir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}