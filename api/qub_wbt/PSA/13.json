{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":13,"content":[{"type":"heading","content":["Ñacaycashan öra yanapänanpaj mañacushan"]},{"type":"hebrew_subtitle","content":["David llaquicur isquirbishan."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, ¿imaycamaraj mana yarpämanquichu?","poem":1},{"lineBreak":true},{"text":"¿Para-simrinachuraj gongaycamanqui?","poem":1},{"lineBreak":true},{"text":"¿Imaycamaraj nogapita pacaräcunqui?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Imaycamaraj almäwan shongöpis llaquicuyllacho canga?","poem":1},{"lineBreak":true},{"text":"¿Imaycamaraj chiquimajcunapa munaynincho caycäshaj?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tayta Dios, ¡yanapaycamay ari! ¡Achicyayniquita ricaycänäpaj yanapaycamay!","poem":1},{"lineBreak":true},{"text":"¡Wañunätaga ama munaycuychu ñawëcunapis ñipitacäcunantaga!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayrämi chiquimajcunaga mana nengachu «binsishcämi» nir.","poem":1},{"lineBreak":true},{"text":"Noga mana alliman chayaptëpis manami cushicongachu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cuyacoj captiquimi gamman yäracamö.","poem":1},{"lineBreak":true},{"text":"Shongöpis fiyupami cushicun salbamashayquipitaga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Alli ricamashanpitami Tayta Diosta alabashaj!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}