ne_break"},{"type":"verse","number":6,"content":[{"text":"Efrata particho conträtu babul caycashanpaj parlajtami wiyaranchi.","poem":1},{"lineBreak":true},{"text":"Y Jaar partichönami tariranchi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Diospa Wasinman aywashun-llapa.","poem":1},{"lineBreak":true},{"text":"Paypa ñaupanman gongurpacushun-llapa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios shamuyna.","poem":1},{"lineBreak":true},{"text":"Tiyanayqui pachaman shamuy ari.","poem":1},{"lineBreak":true},{"text":"Conträtu babulniquiwan shamuy ari.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Cüracunaga allillatana rurachun.","poem":1},{"lineBreak":true},{"text":"Wiyacushojcunana cushicuypita gaparpächun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mandananpaj churashayqui raytaga","poem":1},{"lineBreak":true},{"text":"sirbishojniqui David-raycu ama gongaycuychu ari.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Diosmi Davidta auniran.","poem":1},{"lineBreak":true},{"text":"Aunishantaga manami cutiricongachu.","poem":1},{"lineBreak":true},{"text":"Aunir niran: «Gampita mirar aywajllami ruquiqui ray canga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Parlacushanchïta wamrayquicuna cumliptenga","poem":1},{"lineBreak":true},{"text":"yachachinäpaj caycaj laycunata cumliptenga","poem":1},{"lineBreak":true},{"text":"paycunapa wamrancunapis rucar rucarmi imaycamapis ray caycanga.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tayta Diosmi acrasha Sión lömataga.","poem":1},{"lineBreak":true},{"text":"Chaycho tiyananpämi acrasha.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tayta Diosmi niran: «Cay jircachömi imaypis caycäshaj.","poem":1},{"lineBreak":true},{"text":"Caychömi tiyashaj