e":"line_break"},{"type":"verse","number":5,"content":[{"text":"Noga musyämi Tayta Diosninchëga","poem":1},{"lineBreak":true},{"text":"waquin dioscunapita mas munayniyoj cashanta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Diosga munashantami ruran","poem":1},{"lineBreak":true},{"text":"syëluchöpis cay pachachöpis, lamarchöpis lamar rurinchöpis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Cay pachapa cuchunpita pucutayta jatarachimun.","poem":1},{"lineBreak":true},{"text":"Tamya tamyamunanpaj räyu räyumunanpäpis paymi camacächin.","poem":1},{"lineBreak":true},{"text":"Wayratapis jorgamun churaräcunanpita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Diosmi wañuchiran, Egipto runacunapa guechpa wamrancunata,","poem":1},{"lineBreak":true},{"text":"uywancunapa rimir caj wawancunatapis.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Jinan Egiptuchömi almiraypaj milagrucunata ruraran","poem":1},{"lineBreak":true},{"text":"Faraonpa y mandäshejcunapa ñaupancho.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Achca nasyunchömi runacunata wañuchiran.","poem":1},{"lineBreak":true},{"text":"Munayniyoj raycunata wañuchiran:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amorreo runacunapa raynin Sihonta,","poem":1},{"lineBreak":true},{"text":"Basancunapa raynin Ogta,","poem":1},{"lineBreak":true},{"text":"Cananeo raycunatapis llapanta wañuchiran.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Paycunapa chacrantami partisyunta goycuran acrashan Israel runacunata.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tayta Dios, gamga imaycamapis cawaycanquimi.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, gamtaga imaycamapis yarparäshunquipämi.","poem":1}]},{"type":"verse","number":14,"content":[{"li