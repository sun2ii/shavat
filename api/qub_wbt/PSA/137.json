{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":137,"content":[{"type":"heading","content":["Babilonia mayu läduncho llaquicushan"]},{"type":"verse","number":1,"content":[{"text":"Babilonia mayucuna cantuncho jamarpar,","poem":1},{"lineBreak":true},{"text":"wagaj canchi Sionta yarpärir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Siudächo caycaj wayau yöracunaman warcuycäriranchi arpanchïcunata.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Prësu apamajninchïcunawan,","poem":1},{"lineBreak":true},{"text":"ima-aycanchïtapis guechumajninchïcunana","poem":1},{"lineBreak":true},{"text":"nimaj canchi «mä cushicur cantay» nir,","poem":1},{"lineBreak":true},{"text":"«¡mä Sionpaj cantashayquicunata cantay!» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Juc-lä nasyunchöga","poem":1},{"lineBreak":true},{"text":"¿imanöparäshi cantaycushwan Tayta Diosta alabana alabansacunataga?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jerusalén, gamta gongaycuptëga","poem":1},{"lineBreak":true},{"text":"derëchu caj maquëpis chaquicäcuchun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jerusalén, gamta manana mas yarpaptëga,","poem":1},{"lineBreak":true},{"text":"gampaj manana mas cushicuptëga","poem":1},{"lineBreak":true},{"text":"gallöpis palagarnëman lagacäcuchun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tayta Dios Edom runacuna nishantaga ama gongaychu.","poem":1},{"lineBreak":true},{"text":"Jerusalén mana alliman chayaptin","poem":1},{"lineBreak":true},{"text":"paycunaga cushicuypita gayarparan:","poem":1},{"lineBreak":true},{"text":"«¡Illgächiy! ¡Illgächiy! ¡Llapan simintuntinta illgächiy!» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¡Babilonia, gamtapis illgächishunquipämi!","poem":1},{"lineBreak":true},{"text":"Tayta Dios bindisyunta gochun nogacunata ruramashayquipita ayñita cutichishojtaga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Tayta Dios bindisyunta gochun wamrayquicunata charircur rumicunaman apaycur pajshirejtaga!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}