,{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Cay munducho caj raycunaga aunishayquicunata wiyarmi gamta alabashunquipaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chay raycunami Tayta Diostaga alabanga imano cananpäpis camacächishanpita.","poem":1},{"lineBreak":true},{"text":"Chaynöga Tayta Diosta alabanga fiyupa munayniyoj captinmi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"May janaj pachacho cashpanpis Tayta Diosga yanapanmi umildi runacunata.","poem":1},{"lineBreak":true},{"text":"Alli-tucojcunataga carullapitanami rejsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ima mana allimanpis chayaptë","poem":1},{"lineBreak":true},{"text":"Tayta Dios gammi yanapämanqui.","poem":1},{"lineBreak":true},{"text":"Munayniyoj cashayquita musyachishpayquimi","poem":1},{"lineBreak":true},{"text":"chiquimajcunapitaga salbamanqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios gamga cumlinquipämi nogapaj yarpashayquita.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, cuyacoj cayniquega imay-yajpis chaynöllami.","poem":1},{"lineBreak":true},{"text":"Chaymi camashayqui caycaptëga ama cachaycamaychu ari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}