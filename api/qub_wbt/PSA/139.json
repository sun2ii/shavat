{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":139,"content":[{"type":"heading","content":["Tayta Dios llapanta musyaj cashan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, gamga imano cashallätapis ricamashcanquimi.","poem":1},{"lineBreak":true},{"text":"Imano cashallätapis musyanquimi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gamga musyanquimi imano cawashallätapis.","poem":1},{"lineBreak":true},{"text":"Carucho caycashpayquipis musyaycanquimi","poem":1},{"lineBreak":true},{"text":"imallata yarpaycashätapis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maycho goyashäta maycho purishallätapis ricaycämanquimi.","poem":1},{"lineBreak":true},{"text":"Ima rurashallätapis musyaycanquimi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Imata rimanäpaj mana tariptëpis","poem":1},{"lineBreak":true},{"text":"Tayta Dios gamga maynami musyaycanqui imata rimarcunätapis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gamga llapanpitami ricaycämanqui.","poem":1},{"lineBreak":true},{"text":"Maquiquiwanmi chapaycämanqui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chayno nogapaj musyashayquega fiyupa almiraypämi.","poem":1},{"lineBreak":true},{"text":"Chaycunataga manami tantiyaytapis atipächu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¿Mayllamanga aywacömanchuraj espirituyquipita?","poem":1},{"lineBreak":true},{"text":"¿Mayllamanga gueshpëmanchuraj gampita?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Syëluman aywacuptëpis chaychömi gam caycanqui.","poem":1},{"lineBreak":true},{"text":"Cay pacha rurinman yaycuptëpis chaychöpis gamga caycanquimi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Inti yagamunan caj-läpa pärir aywacuptëpis","poem":1},{"lineBreak":true},{"text":"jana lamar cantuncho tiyacuycuptëpis","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"maquiquega aypämunmanmi chaymanpis.","poem":1},{"lineBreak":true},{"text":"Derëchu caj maquiquega manami cachaycamanmanchu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gampita pacacuyta yarpaptë,","poem":1},{"lineBreak":true},{"text":"u achicyaycaj pacha chacayman ticracuriptinpis","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"chacayga gampita manami pacamanmanchu.","poem":1},{"lineBreak":true},{"text":"Chacaypis gampäga caycan junajno achicyajllami.","poem":1},{"lineBreak":true},{"text":"Gampäga chacaypis junajpis iwal-llami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tayta Dios gammi llapan cuerpötapis rurashcanqui.","poem":1},{"lineBreak":true},{"text":"Mamäpa pachanchöpis gammi formamashcanqui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fiyupa almiraypäta ruramashayquipitami gamta alabä.","poem":1},{"lineBreak":true},{"text":"Gam rurashayquicunaga almiraypämi.","poem":1},{"lineBreak":true},{"text":"Chayno almiraypaj cashantaga rasunpami riguë.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Noga ruracaycashätaga pipis manami ricaranchu.","poem":1},{"lineBreak":true},{"text":"Pipis manami musyaranchu imano ruracaycashätapis.","poem":1},{"lineBreak":true},{"text":"Pacha rurinchönöpis mana ricacayllami camacächimashcanqui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gamga ricaycämarayquimi mamäpa pachancho aychallaraj wiñaycashäta.","poem":1},{"lineBreak":true},{"text":"Chaycunaga llapanmi libruyquicho isquirbiraycan.","poem":1},{"lineBreak":true},{"text":"Manaräpis yuriptë","poem":1},{"lineBreak":true},{"text":"gamga mayna musyarayqui imay-yaj cawanäpaj cashätapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tayta Dios, gam yarpashayquega almiraypämi.","poem":1},{"lineBreak":true},{"text":"Chay yarpashayquicuna aypalla cashanga mana atipaypämi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yarpashayquicunata yupayta munaptëga agushpitapis mas aypallami caycan.","poem":1},{"lineBreak":true},{"text":"Manami imaypis yupayta atipämanchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tayta Dios, fiyucunataga wañurachiy.","poem":1},{"lineBreak":true},{"text":"Ñaupäpita garguy wañuchicojcunata.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Paycunaga gampa contrayquimi riman.","poem":1},{"lineBreak":true},{"text":"Manacajllapitami gampa contrayqui jatarin.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tayta Dios, gamga musyaycanquimi gamta chiquishojcunata noga chiquishäta.","poem":1},{"lineBreak":true},{"text":"¿Manachu manacajman churä manacajman churashojcunatapis?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nogaga fiyupami paycunata chiquë.","poem":1},{"lineBreak":true},{"text":"Conträcunatanömi ricäpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tayta Dios, imano cashätapis ricamay.","poem":1},{"lineBreak":true},{"text":"Imano shongö cashallantapis musyaycamay ari.","poem":1},{"lineBreak":true},{"text":"Imano yarpashallätapis musyamay ari.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Rurashäcuna mana alli captenga tantiyachimay ari.","poem":1},{"lineBreak":true},{"text":"Nircur yachachimay gam munashayquino cawanäpaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}