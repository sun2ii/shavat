},{"lineBreak":true},{"text":"Paycunaga mana alliman chayanallätami shuyaraycan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paycunaga alli-tucoj runacunami.","poem":1},{"lineBreak":true},{"text":"Tuninäpaj wascatano churapämasha.","poem":1},{"lineBreak":true},{"text":"Liyar pitucarcamänanpaj redata churapämasha.","poem":1},{"lineBreak":true},{"text":"Nänicunaman togllancunata churasha manyapacar tuninäpaj. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tayta Diostami ruwacushcä: «Gammi canqui Diosnë.","poem":1},{"lineBreak":true},{"text":"Mañacamushäta wiyamay ari» nir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Dios, gammi canqui munayniyoj Salbamaj.","poem":1},{"lineBreak":true},{"text":"Pillyachöpis gammi chapämanqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios, fiyu runacuna munashantaga ama camacächiychu.","poem":1},{"lineBreak":true},{"text":"Yarpashancunataga ama camacächiychu.","poem":1},{"lineBreak":true},{"text":"Chayrämi manana alli-tucongachu. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tumaparaycämajcuna","poem":1},{"lineBreak":true},{"text":"«Maldisyunädu cachun» nishanga quiquincunaman ticrachun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paycunaman shicwamuchun shansha.","poem":1},{"lineBreak":true},{"text":"Paycunataga uchcucunaman wiñarpärichun imaypis manana llojshimunanpaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Washa-rimacunaga ama cachunchu cay pachachöga.","poem":1},{"lineBreak":true},{"text":"Mana allita rurashanga fiyu runata quiquinta gatirächun wañuchinancama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Noga musyämi pobritaga Tayta Dios alli arriglashanta.","poem":1},{"lineBreak":true},{"text":"Llaquicuycajcunatapis yanapanmi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alli runacunaga alabashunquipämi.","poem":1},{"lineBreak":true},{"text":"Munashayquino rurajcunaga ñaupayquichömi cawanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}