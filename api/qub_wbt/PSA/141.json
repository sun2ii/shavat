{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":141,"content":[{"type":"heading","content":["Jucha rurayman mana chayananpaj mañacushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Gamtami gayacaycämö Tayta Dios.","poem":1},{"lineBreak":true},{"text":"Juclla shaycamuy yanapämänayquipaj ari.","poem":1},{"lineBreak":true},{"text":"Mañacamuptë wiyaycamay ari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mañacamushäga gam cajman chayamuchun insinsuno.","poem":1},{"lineBreak":true},{"text":"Maquëta jogariraycämushäna cachun tardipa apamushä ofrendano.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tayta Dios, llutancunataga ni juc shimipis ama rimashächu.","poem":1},{"lineBreak":true},{"text":"Shimëman churaycuy täpacojta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Llutancunata ruranäpaj yarpashätaga ama camacächiychu.","poem":1},{"lineBreak":true},{"text":"Mana allita rurar cawanäta chapämay.","poem":1},{"lineBreak":true},{"text":"Fiyu runacuna micur upur goturpashancho goturänätaga ama munaycuycho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alli runa piñacamaptin, astimaptin chasquicushämi.","poem":1},{"lineBreak":true},{"text":"Chaycunaga canga jampinömi.","poem":1},{"lineBreak":true},{"text":"Chauraga chasquicushämi.","poem":1},{"lineBreak":true},{"text":"Fiyu runacuna magaycämaptinpis gamllatami mañacuycäshayqui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fiyu runacunapa mandajnincuna gagapita rumi paquicajno mana alliman chayar-rämi","poem":1},{"lineBreak":true},{"text":"musyanga noga willapashäcunaga rasunpa cashanta.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yapyaptin curpacuna mashtarashannömi tulluncunapis mashtaranga runacuna pamparashancho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Dios, gamllamanmi yäracaycämö.","poem":1},{"lineBreak":true},{"text":"Gam chapämänayquipämi yäracamö.","poem":1},{"lineBreak":true},{"text":"Ama cachaycamaychu ari.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fiyu runacuna mana alliman chayachimänanpaj yarpapaycämashanpita chapaycamay ari.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fiyu runacunaga nogapaj yarpashanman quiquincuna chayachun.","poem":1},{"lineBreak":true},{"text":"Nogata ichanga salbaycamay.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}