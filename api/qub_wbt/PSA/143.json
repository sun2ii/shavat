{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":143,"content":[{"type":"heading","content":["Tayta Diosman yäracur mañacushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, mañacaycämushäta wiyaycamay.","poem":1},{"lineBreak":true},{"text":"Ruwacaycämushäta wiyaycuy ari.","poem":1},{"lineBreak":true},{"text":"Yanapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Gamga allimi canqui.","poem":1},{"lineBreak":true},{"text":"Aunishayquitaga cumlinquimi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gampa ñaupayquichöga manami pipis juchaynäga canchu.","poem":1},{"lineBreak":true},{"text":"Chayno captin nogataga ama jusgaycamaychu ari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Chiquimajcunaga gaticachaycäman.","poem":1},{"lineBreak":true},{"text":"Pampaman lagacajpämi ñitiramasha.","poem":1},{"lineBreak":true},{"text":"Wañojcuna pamparaycashanno chacaychönöna cawanätami munan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fiyupa llaquishami caycä.","poem":1},{"lineBreak":true},{"text":"Yarpachacuycaptillämi shongöpis aburrïru ricacusha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Unaycunapaj yarpärëmi.","poem":1},{"lineBreak":true},{"text":"Milagrucunata rurashayquipäpis yarpärë.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gam cajmanmi macyaraycämö.","poem":1},{"lineBreak":true},{"text":"Gamtaga shuyaraycä chaqui allpa yacunaycajnömi.Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tayta Dios, juclla yanapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Jämaynëpis ushacaycannachaj.","poem":1},{"lineBreak":true},{"text":"Ama cachaycamaychu.","poem":1},{"lineBreak":true},{"text":"Cachaycamaptiquega wañojcunanönachari cashaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nogaga gammanmi yäracamö.","poem":1},{"lineBreak":true},{"text":"Chaymi musyachimay tutapaga cuyamashayquita.","poem":1},{"lineBreak":true},{"text":"Nogaga imata yarpashätapis gamtami willapä.","poem":1},{"lineBreak":true},{"text":"Chaymi tantiyaycachimay imano goyänäpäpis.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nogaga chapämänayquipaj gammanmi yäracamö.","poem":1},{"lineBreak":true},{"text":"Chiquimajcunapita salbaycamay ari Tayta Dios.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tantiyachimay gam munashayquino cawanäpaj.","poem":1},{"lineBreak":true},{"text":"Gammi Tayta Diosnë canqui.","poem":1},{"lineBreak":true},{"text":"Espirituyqui yanapämächun ari allillata ruranäpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tayta Dios rispitasha canayqui-raycu cawachimay ari.","poem":1},{"lineBreak":true},{"text":"Allita ruraj cashpayqui fiyupa llaquicuycajta jorgaycamay ari.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aunishayquita cumlej cashpayqui, llapan chiquimajcunata illgarachiy.","poem":1},{"lineBreak":true},{"text":"Noga sirbishojniqui caycaptëga llapan conträcunata ushacächiy ari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}