lineBreak":true},{"text":"Runaga juc jämayta cachaycuynöllami.","poem":1},{"lineBreak":true},{"text":"Llantuy päsajnöllami aywacuycanpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tayta Dios syëluta chaparaycajta auchirir urämuy.","poem":1},{"lineBreak":true},{"text":"Puntacunata yataycuy goshtay jatarinanpaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Achicyaypa achicyar räyuchimuy.","poem":1},{"lineBreak":true},{"text":"Chaywan chiquishojcunaga machiypa-machirmi gueshpenga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Janajpita-pacha ayparcamuy ari.","poem":1},{"lineBreak":true},{"text":"Jatun lamarpita maquiquiwan jorgaycamay ari.","poem":1},{"lineBreak":true},{"text":"Mana rejsishä jäpa runacunapita salbaycamay.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chay runacunaga llullacuyllatami rimanpis.","poem":1},{"lineBreak":true},{"text":"Manacajpita jurashpan derëchu caj maquintapis jogarin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tayta Dios, mushoj alabansawanmi alabashayqui.","poem":1},{"lineBreak":true},{"text":"Gamta alabashpä cantashaj chunca cuerdayoj arpata tucapallapa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gammi camacächinqui raycuna jucta binsinanpaj.","poem":1},{"lineBreak":true},{"text":"Sirbishojniqui Davidtapis Gammi salbarayqui sabliwan wañunanpita.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mana rejsishä jäpa runacunapita salbaycamay ari.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga llullallatami parlanpis.","poem":1},{"lineBreak":true},{"text":"Llullacur manacajpita jurashpan derëchu caj maquintapis jogarin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wamräcuna wiñaycuchun wertacho caj lantacuna wiñajnöraj.","poem":1},{"lineBreak":true},{"text":"Warmi wamräcunapis caycuchun cuyayllapaj pilancu palasyuta camarächejno.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Micuy churacunäcunachöpis llapan casta micuy juntasha caycuchun.","poem":1},{"lineBreak":true},{"text":"Uywäcunapis jircacho waranganpa waranganpa miraycuchun.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Uywäcunapis achca cargata apachun.","poem":1},{"lineBreak":true},{"text":"Nogacunapäga ama cachunchu llaquicuy.","poem":1},{"lineBreak":true},{"text":"Prësucurcurpis ama apamächunchu.","poem":1},{"lineBreak":true},{"text":"Cällicunachöpis llaquicur ama gaparpächunchu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chay nishäno goyaj runacunaga rasunpa cushishami cawanga.","poem":1},{"lineBreak":true},{"text":"Cushishami cawanga Tayta Diosta «Diosnë» nejcunaga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}