{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":146,"content":[{"type":"heading","content":["Tayta Dios rurashancunata alabashan"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Tayta Diosga alabasha cachun!","poem":1},{"lineBreak":true},{"text":"Llapan shongöpami Tayta Diosta alabashaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Cawashäyäga imaypis Tayta Diosta alabaycäshämi.","poem":1},{"lineBreak":true},{"text":"Cay pachacho cawashäcamaga alabansacunawan Tayta Diosta alabaycäshämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ama yäracuychu munayniyoj runacunamanga.","poem":1},{"lineBreak":true},{"text":"Paycunaga runallami. Manami salbashunquipächu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paycunaga wañushpan cashgan allpamanmi ticran.","poem":1},{"lineBreak":true},{"text":"Ima-aycata rurananpaj yarpashancunapis chay junajllami ushacanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jacobpa Diosnin yanapashan runaga cushishami cawanga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosllaman yäracoj runaga cushishami cawanga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Diosmi camasha syëluta, cay pachata, lamartapis,","poem":1},{"lineBreak":true},{"text":"chaycunacho caycajtapis.","poem":1},{"lineBreak":true},{"text":"Payga aunishancunata cumlinmi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ñacaycajcunataga yanapanmi.","poem":1},{"lineBreak":true},{"text":"Yargaypita caycajcunatanami micuyta tarichin.","poem":1},{"lineBreak":true},{"text":"Prësu caycajcunatapis Tayta Diosga jorgunmi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Diosga gapracunatapis allchacächinmi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga jatarachinmi tunisha caycajcunata.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga cuyanmi alli runacunata.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Diosga ima-ayca mana allipitapis chapanmi juc-lä nasyun runacunata.","poem":1},{"lineBreak":true},{"text":"Yanapanmi wacchacunata biyüdacunata.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunapänami ichanga camacächin mana alliman chayananpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sión, imaycamapis Tayta Diosllami mandanga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosnillayquimi imaycamapis ray canga.","poem":1},{"lineBreak":true},{"text":"¡Aleluya! ¡Tayta Diosga alabasha cachun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}