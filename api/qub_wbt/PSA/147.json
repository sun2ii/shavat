{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":147,"content":[{"type":"heading","content":["Tayta Diostaga alabaypämi"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Tayta Diosga alabasha cachun!","poem":1},{"lineBreak":true},{"text":"Fiyupa allimi Tayta Diosninchïta alabansacunawan alabayga.","poem":1},{"lineBreak":true},{"text":"Paytaga cushisha mishquilla alabaypaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Diosga Jerusalentapis allchaycächinmi.","poem":1},{"lineBreak":true},{"text":"Israelcuna mashtacasha caycajcunatapis shuntaycämunmi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paymi allchacächin llaquicuycajcunatapis.","poem":1},{"lineBreak":true},{"text":"Guerincunatapis räpuwan watapan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Payga musyanmi ayca goyllarcuna cashantapis.","poem":1},{"lineBreak":true},{"text":"Cada goyllarcunapa jutintapis yachanmi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Diosninchëga fiyupa munayniyojmi.","poem":1},{"lineBreak":true},{"text":"Paypa yarpaynenga mana atipaypämi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Diosga yanapanmi umildicunata.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunatanami ichanga pengayman churan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Agradësicushpayqui Tayta Diosta alabansacunawan alabay.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta alabay arpallanpawan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Paymi syëlupapis pucutarächin.","poem":1},{"lineBreak":true},{"text":"Cay pachaman tamyamunanpäpis tamyata camarin.","poem":1},{"lineBreak":true},{"text":"Guewata wiñachin jircacunacho.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Animalcuna micuyta tarinanpäpis camacächin.","poem":1},{"lineBreak":true},{"text":"Äbicunapa wawan yargar wagaptinpis micuyta tarichin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Diosga manami cushicunchu cawallu fiyupa firsayoj captinpis,","poem":1},{"lineBreak":true},{"text":"ni runa callpasapa captinpis.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chaypa ruquin Tayta Diosga cushicun payta rispitaptinmi,","poem":1},{"lineBreak":true},{"text":"pay cuyacoj cashanman yäracuptinmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jerusalén, Tayta Diosta alabay.","poem":1},{"lineBreak":true},{"text":"Sión, Diosniquita alabay.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Paymi puncuyquicunapa rancancunatapis sinchiyächisha.","poem":1},{"lineBreak":true},{"text":"Siudächo tiyaj runacunatapis bindisyunta gosha.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Paymi alli goyächin nasyunniquicho tiyajcunata.","poem":1},{"lineBreak":true},{"text":"Rïgu alli wayunanpäpis bindisyunta churan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Diosmi nin cay pachacho ima imano cananpäpis.","poem":1},{"lineBreak":true},{"text":"Chay nishanga jinan örami cumlin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tayta Diosmi cay pachaman rashtachimun utcuta-jina.","poem":1},{"lineBreak":true},{"text":"Gasapatapis mashtachimun yuraj cachita-jina.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Diosmi runtu tamyatapis gasapatano shicwachimun.","poem":1},{"lineBreak":true},{"text":"Pay gasächiptinmi yacupis tinticäcun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ichanga chullucäcunanpaj Tayta Dios niptin chullucäcun.","poem":1},{"lineBreak":true},{"text":"Wayrächimuptin yacupis cörrin.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Israel jutiyoj Jacobtapis Paymi musyachiran","poem":1},{"lineBreak":true},{"text":"yarpashancunata, laynincunata, mandamintuncunata.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Waquin nasyuncunataga manami chayno rurashachu.","poem":1},{"lineBreak":true},{"text":"Waquin nasyun runacunaga Tayta Diospa laynincunata manami imaypis musyashachu.","poem":1},{"lineBreak":true},{"text":"¡Aleluya! ¡Tayta Diosga alabasha cachun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}