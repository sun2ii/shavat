{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":148,"content":[{"type":"heading","content":["Rurashancuna Tayta Diosta alabashan"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Tayta Diosga alabasha cachun!","poem":1},{"lineBreak":true},{"text":"Tayta Diosta alabay-llapa syëlucho cajcuna.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta alabay-llapa janajcho cajcuna.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alabay-llapa llapan anjilnincuna.","poem":1},{"lineBreak":true},{"text":"Alabay-llapa syëlucho caycaj suldäruncuna.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alabay inti, quilla.","poem":1},{"lineBreak":true},{"text":"Alabay-llapa achicyaj goyllarcuna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alabay syëlu,","poem":1},{"lineBreak":true},{"text":"syëlu jananpa asulyaraycaj yacupis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ruracänanpaj juc shimi niptinmi llapan ruracaran.","poem":1},{"lineBreak":true},{"text":"Chaypita Tayta Diosta alabay-llapa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Diosmi llapanta camacächisha imay-yajpis cananpaj.","poem":1},{"lineBreak":true},{"text":"Camacächishancuna mana imaypis rucacänanpämi niran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tayta Diosta alabay-llapa cay pachacho cajcuna.","poem":1},{"lineBreak":true},{"text":"Lamarcho tiyaj waräcuycuna Tayta Diosta alabay-llapa.","poem":1},{"lineBreak":true},{"text":"Lamarpa rurincho caycajcunapis Tayta Diosta alabay.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Diosta alabay räyu, runtu tamya.","poem":1},{"lineBreak":true},{"text":"Alabay rashta, pucutay.","poem":1},{"lineBreak":true},{"text":"Tayta Dios nishanta wiyacoj löcu wayra alabay.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Diosta alabay-llapa puntacuna, puytush lömacuna.","poem":1},{"lineBreak":true},{"text":"Alabay-llapa sedru guerucuna, frütata wayoj yöracuna.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Diosta alabay-llapa manshu animalcuna, chucaru animalcuna,","poem":1},{"lineBreak":true},{"text":"äbicuna, culebracuna.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Diosta alabay-llapa cay pachacho caj raycuna.","poem":1},{"lineBreak":true},{"text":"Llapan nasyuncunapa mandajnincuna Tayta Diosta alabay-llapa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tayta Diosta alabay-llapa mösupis jipashpis, chachacunapis wamracunapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tayta Diosta llapayqui alabay-llapa.","poem":1},{"lineBreak":true},{"text":"Payllami llapanpita mas rispitashaga caycan.","poem":1},{"lineBreak":true},{"text":"Payllami cay pachacho cajcunapitapis syëlucho cajcunapitapis mas munayniyoj caycan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Paymi munayniyojyächisha acrashan runacunataga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta rispitajcuna, llapan Israelcuna payllata alabay-llapa.","poem":1},{"lineBreak":true},{"text":"¡Aleluya! ¡Tayta Diosga alabasha cachun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}