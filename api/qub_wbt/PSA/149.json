cuna alabaptin.","poem":1},{"lineBreak":true},{"text":"Umildicunatami yanapan allicho llojshinanpaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Diosta sirbejcunaga allicho llojshir cushicuy.","poem":1},{"lineBreak":true},{"text":"Jamarpaycashayquichöpis cushicuypita cantay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Llapan callpayquiwan Tayta Diosta alabay.","poem":1},{"lineBreak":true},{"text":"Nircur ishcan-läpa afilasha sablita aptay.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chay sabliwanmi ayñita cutichinqui Tayta Diosta mana rispitajcunataga.","poem":1},{"lineBreak":true},{"text":"Juc nasyuncunatapis magar castiganqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaynöpami prësu chariycur","poem":1},{"lineBreak":true},{"text":"fiyupa lasaj fyërru cadinacunawan watanqui","poem":1},{"lineBreak":true},{"text":"raycunata, munayniyoj runacunata.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chayno ruraptiquimi paycunacho cumlenga imano cananpäpis isquirbiraycashan.","poem":1},{"lineBreak":true},{"text":"Chayno rurashayquega fiyupa allimi canga Tayta Diosta sirbejcunapäga.","poem":1},{"lineBreak":true},{"text":"¡Aleluya! ¡Tayta Diosga alabasha cachun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}