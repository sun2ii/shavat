{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":16,"content":[{"type":"heading","content":["Tayta Diosmi cawachimanchi"]},{"type":"hebrew_subtitle","content":["David isquirbishan."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, gammanmi yäracamö.","poem":1},{"lineBreak":true},{"text":"¡Chapaycamay ari!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nogaga gamta nishcä: «Gammi canqui nogapa Tayta Diosnë.","poem":1},{"lineBreak":true},{"text":"Gampita mas jucga manami nogapaj ima allipis canchu.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cay nasyuncho caycaj dioscunaga munayniyojshi.","poem":1},{"lineBreak":true},{"text":"Chaynömi nin chayman yäracojcuna,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ïduluta rurajcuna, fiyupa rispitar yäracojcunapis.","poem":1},{"lineBreak":true},{"text":"¡Nogami ichanga ïdulucunata imaypis mana adurashächu!","poem":1},{"lineBreak":true},{"text":"¡Jutincunatapis manami ni rimayllapis rimarcushächu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tayta Dios, gammi erensyä canqui;","poem":1},{"lineBreak":true},{"text":"sumaj bindisyunta gomanqui.","poem":1},{"lineBreak":true},{"text":"Nogaga gampa munayniquichömi caycä.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogataga mas alli cajmi töcamasha.","poem":1},{"lineBreak":true},{"text":"¡Nogapa partisyunnëga casha fiyupa alli cajmi!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Diostaga alabashämi imano goyänäpäpis pay tantiyachimashanpita.","poem":1},{"lineBreak":true},{"text":"Shongullächo yarpashäcunatapis chacaycunapami tantiyachiman.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Imaypis Tayta Diostaga yarparaycämi.","poem":1},{"lineBreak":true},{"text":"Pay lädöcho captenga imapis manami chayamangachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Chaymi, fiyupa cushisha caycä.","poem":1},{"lineBreak":true},{"text":"Tayta gam yanapämaptiqui jaucami goyäshaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wañojcuna pamparashanchöga ama cachaycamanquichu.","poem":1},{"lineBreak":true},{"text":"¡Sepultürachöpis ama cachaycunquichu acrashayquitaga!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mana ushacaj cawayta tarinäpämi ricachimanqui.","poem":1},{"lineBreak":true},{"text":"Gampa ñaupayquichöga amatar cushicuyllami,","poem":1},{"lineBreak":true},{"text":"imaycamapis alli goyayllami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}