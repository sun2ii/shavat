m":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaypitami llojshimun chayraj majachacasha mösuno.","poem":1},{"lineBreak":true},{"text":"Aywayta gallaycurna cörrej runa cushisha cörriyta gallaycojno aywan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Intiga syëlupa jucaj cuchunpa yagamur","poem":1},{"lineBreak":true},{"text":"jucaj cuchunpana yagan.","poem":1},{"lineBreak":true},{"text":"Shanaynenga llapanmanmi chayan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tayta Diospa mandamintonga llapanpis allillami.","poem":1},{"lineBreak":true},{"text":"Alli cawaytami tarichimanchi.","poem":1},{"lineBreak":true},{"text":"Tayta Dios nishanga llapanpis cumlicanmi.","poem":1},{"lineBreak":true},{"text":"Umildicunataga llapantami tantiyachimanchi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Diospa laynincunaga manami llutanchu.","poem":1},{"lineBreak":true},{"text":"Shongunchïtapis cushicachinmi.","poem":1},{"lineBreak":true},{"text":"Tayta Dios yachachimashanchëga sumaj allimi.","poem":1},{"lineBreak":true},{"text":"Yachachimanchi alli cawayta tarinapämi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Diospa palabrantaga rispitaypämi.","poem":1},{"lineBreak":true},{"text":"Palabranga manami imaypis rucacanchu.","poem":1},{"lineBreak":true},{"text":"Tayta Dios jusgashancunaga rasun cajmi.","poem":1},{"lineBreak":true},{"text":"Llapanpis allillami.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Diospa palabranga lijïtimu goripitapis mas allimi!","poem":1},{"lineBreak":true},{"text":"¡Abëjapa mishquinpitapis mas mishquejmi!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mandamintuyquicunaga yachachimanmi.","poem":1},{"lineBreak":true},{"text":"Cumlejcunaga alli cawaytami tarenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Piräshi tantiyacunman juchata rurashantaga?","poem":1},{"lineBreak":true},{"text":"¡Perdunaycamay ari Tayta Dios mana musyaynëpa juchata rurashäcunata!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Musyaycar juchata ruranäpitaga chapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Ama cachaycamaychu shongö munashanta ruranäpäga.","poem":1},{"lineBreak":true},{"text":"Chayrämi cashaj allita ruraj runa.","poem":1},{"lineBreak":true},{"text":"Chauraga manami fiyupa juchayoj cashächu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tayta Dios gammi chapämanqui, imapitapis salbamanqui.","poem":1},{"lineBreak":true},{"text":"Cay parlashätaga yarpashäcunataga chasquiycamay ari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}