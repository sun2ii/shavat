{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":2,"content":[{"type":"heading","content":["Tayta Dios acracushan"]},{"type":"verse","number":1,"content":[{"text":"¿Imanirtaj Tayta Diosta mana rispitajcunaga contran jatarircaycan?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj manacajcunataga yarparcaycan?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Cay pachacho caj raycuna, mandajcuna fiyupa rabyacarcärin.","poem":1},{"lineBreak":true},{"text":"Nircur llapanna parlacun Tayta Diospa contran y acrashanpa contran.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chaymi gaparpan cayno nir: «Paycunapa maquinpita llojshicushunna.","poem":1},{"lineBreak":true},{"text":"Munayninpita gueshpicushunna.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Janaj pachacho caycaj Tayta Diosmi paycunapäga asicun.","poem":1},{"lineBreak":true},{"text":"Quiquin Tayta Diosmi mana cäsupanchu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rabyarna mancharachin.","poem":1},{"lineBreak":true},{"text":"Fiyupa rabyacurcurna piñacur nin:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Rispitädu Sión lömächo raynë cananpäga maynami acrashcä» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Cananmi willacushaj Tayta Dios imano yarpaycashantapis.","poem":1},{"lineBreak":true},{"text":"Paymi nimasha: «Gamga wamrämi canqui.","poem":1},{"lineBreak":true},{"text":"Canan junajpitaga taytayquinami cä.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nasyuncunata goycunäpäpis mañacamay.","poem":1},{"lineBreak":true},{"text":"Cay pachatapis gampa cananpämi juc cuchupita jucaj cuchuncama goycushayqui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fyërru bastunniquiwan magarmi llapan raycunata binsinquipaj.","poem":1},{"lineBreak":true},{"text":"¡Allpa mancata shallurejnömi usharinquipaj!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Chaymi raycuna, mandajcuna sumaj tantiyacuy.","poem":1},{"lineBreak":true},{"text":"¡Cay willapashäta sumaj yachacuy!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fiyupa rispitashpayqui aduray Tayta Diosta.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Paypa ñaupanmanga sicsicyar gongurpacuy.","poem":1},{"lineBreak":true},{"text":"Mana rispitaptiquega jinan örami rabyacurcunman.","poem":1},{"lineBreak":true},{"text":"Chaura wañunquimanmi.","poem":1},{"lineBreak":true},{"text":"Cushishami cawanga Tayta Diosman yäracojcunaga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}