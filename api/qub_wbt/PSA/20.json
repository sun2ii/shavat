ineBreak":true},{"text":"Chauraga binsishayquipita cushicushunmi.","poem":1},{"lineBreak":true},{"text":"Bandëracunatapis ichichishaj Tayta Diospa jutincho.","poem":1},{"lineBreak":true},{"text":"Mañacushayquitaga Tayta Dios llapanta camacaycachichun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nogaga musyämi acrashan rayta Tayta Dios yanapänanpaj cashanta,","poem":1},{"lineBreak":true},{"text":"tiyashan rispitädu syëlupita-pacha wiyamunanpaj cashanta,","poem":1},{"lineBreak":true},{"text":"munayninwan salbananpaj cashantapis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waquenga yäracun pillyapaj caj carrëtancunaman.","poem":1},{"lineBreak":true},{"text":"Waquenga yäracun pillyapaj caj cawalluncunaman.","poem":1},{"lineBreak":true},{"text":"Noganchïmi ichanga yäracunchi Tayta Diosnillanchïman.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Paycunaga tunengami.","poem":1},{"lineBreak":true},{"text":"Noganchïmi ichanga jatarcur ichirpaycäshun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tayta Dios, rayta yanapaycuy binsinanpaj.","poem":1},{"lineBreak":true},{"text":"¡Mañacamuptëcunapis yanapaycamay ari!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}