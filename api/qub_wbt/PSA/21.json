"poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yanapashayquipitami pï-maypis rejsin.","poem":1},{"lineBreak":true},{"text":"Yanapashayquipitami rispitädupis caycan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Imaycamapis alli cawananpämi bindisyunta goshcanqui.","poem":1},{"lineBreak":true},{"text":"Gam yan'gaptiquimi fiyupa cushisha goyaycan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rayga Tayta Diosmanmi yäracun.","poem":1},{"lineBreak":true},{"text":"Tayta Dios cuyacoj captin payman yäracun.","poem":1},{"lineBreak":true},{"text":"Chaymi imaypis mana allimanga mana chayangachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Dios yanapäshushayquipitami llapan contrayquicunata binsinquipaj tayta ray.","poem":1},{"lineBreak":true},{"text":"Derëchu caj maquiquimi llapan chiquishojcunata binsenga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chayamushpayqui fiyucunataga llapantami rataycaj jurnuman gaycunquipaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosnami rabyasha cashpan ninawan ushajpaj illgarachenga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fiyu runacunapa wamrancunataga illgarachengami.","poem":1},{"lineBreak":true},{"text":"Chay runapita mirajcunataga ushajpämi usharenga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chay runacuna imata rurashuyta munashpanpis","poem":1},{"lineBreak":true},{"text":"imata rurashuyta yarpashpanpis","poem":1},{"lineBreak":true},{"text":"manami imatapis rurashunquipächu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaynöga canga paycunata magaj yaycur binsiptiquimi.","poem":1},{"lineBreak":true},{"text":"Lëchayquiwan apuntaptiqui paycunaga gueshpirmi aywaconga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"