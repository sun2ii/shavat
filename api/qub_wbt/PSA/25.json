{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":25,"content":[{"type":"heading","content":["Yanapänanpaj Tayta Diosta mañacushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, gammanmi mañacamö.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Tayta Dios gammanmi yäracamö.","poem":1},{"lineBreak":true},{"text":"Pengaycho canätaga ama camacächiychu.","poem":1},{"lineBreak":true},{"text":"Chiquimajcunapis ama cushipämächunchu.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Gamman yäracamoj cäga ama pipis pengaychöga cachunchu.","poem":1},{"lineBreak":true},{"text":"Pengaychöga cachun mana ashipaycaptiqui contrayqui jatarejcuna.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Tayta Dios, näniquita ricachimay.","poem":1},{"lineBreak":true},{"text":"Ruranäta munashayquino yachachimay.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Yachachimay ricachimay rasun cajta.","poem":1},{"lineBreak":true},{"text":"Gamllami canqui Salbamaj Tayta Diosnëga.","poem":1},"Vav",{"text":"Imay örapis gamllamanmi yäracaycämö.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Tayta Dios, para-simri cuyapäcoj cashayquita, alli cashayquita yarpaycuy ari.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Jucha rurashäcunata ichanga ama yarpaycuychu.","poem":1},{"lineBreak":true},{"text":"Mösu car mana allita rurashäta gongaycuyna.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, fiyupa cuyapäcoj alli car","poem":1},{"lineBreak":true},{"text":"yarpaycamay ari.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Tayta Diosga allimi y juchaynajmi.","poem":1},{"lineBreak":true},{"text":"Chaymi juchayojcunataga alli nänita ricachenga.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Umildicunataga tantiyachinmi.","poem":1},{"lineBreak":true},{"text":"Allillata rurananpämi yachachin.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Tayta Diosga mandamintuncunata cumlejcunata","poem":1},{"lineBreak":true},{"text":"cuyapanmi, aunishantapis cumlinmi.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Tayta Dios nogapa juchäga aypallami.","poem":1},{"lineBreak":true},{"text":"Gam alli cashayquita parlananpaj perdunaycamay ari.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Tayta Diosga payta rispitaj runata quiquinmi yachachin imano cawananpäpis.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Chaura cay bïdachöpis juc bïdachöpis allillami goyanga.","poem":1},{"lineBreak":true},{"text":"Wamrancunanami chacranwanpis quëdanga.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Tayta Diosga rispitajcunapa amïgunmi.","poem":1},{"lineBreak":true},{"text":"Parlacur aunishantapis musyachinmi.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Imay örapis Tayta Diosllamanmi yäracuycä","poem":1},{"lineBreak":true},{"text":"ima mana allicunapitapis chapämaj captin.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Tayta Dios, cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Japallämi y llaquishami caycä.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Shongöga masta mastami ushaycan.","poem":1},{"lineBreak":true},{"text":"Mana llaquicunäpaj yanapämay ari.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Masqui ricäramaypis.","poem":1},{"lineBreak":true},{"text":"Fiyupa llaquishami caycä.","poem":1},{"lineBreak":true},{"text":"Juchäcunapita perdunaycamay ari.","poem":1}]},{"type":"verse","number":19,"content":[{"text":"Masqui ricäriypis, imano aypallashi carcaycan chiquimajcunaga.","poem":1},{"lineBreak":true},{"text":"Fiyupa chiquimarmi wañuchimayta yarparcaycan.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Paycunapitaga salbaycamay ari.","poem":1},{"lineBreak":true},{"text":"Ama camacaycachiychu pengaycho canätaga.","poem":1},{"lineBreak":true},{"text":"Gamman yäracaycämuptëga ama camacaycachiychu wañuchimänanta.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Nogaga gamllamanmi yäracamö.","poem":1},{"lineBreak":true},{"text":"Allillata ruranäpaj tantiyaycachimay ari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Tayta Dios, Israelcunataga llapan llaquicuycashanpita salbaycuy ari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}