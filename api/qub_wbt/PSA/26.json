{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":26,"content":[{"type":"heading","content":["Alli runa imano cawashanpis"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, imano cashätapis gamga musyaycanquimi.","poem":1},{"lineBreak":true},{"text":"Nogaga imaypis alli cajllatami ruraycä.","poem":1},{"lineBreak":true},{"text":"Mana cachaypa gamllamanmi yäracaycämö.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Imano cashätapis ricaycamay.","poem":1},{"lineBreak":true},{"text":"Imano yarpaycashäta, shongullächo imata yarpaycashätapis ricaycamay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gam cuyapäcoj cashayquitaga rasunpami musyä.","poem":1},{"lineBreak":true},{"text":"Chaymi munashayquinölla cawä.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Llullacunawanga imaypis manami goturashcächu.","poem":1},{"lineBreak":true},{"text":"Janan shongu parlajcunawanpis manami goturashcächu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fiyu runacuna goturpaycajtaga chiquëmi.","poem":1},{"lineBreak":true},{"text":"Fiyucunawanga manami goturashcäpischu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maquëpis limyuna caycaptinnaga, juchäpitapis limyuna caycarga","poem":1},{"lineBreak":true},{"text":"altarniquipa ñaupanmanmi chayayta munä.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaychömi alabansacunata cantashaj.","poem":1},{"lineBreak":true},{"text":"Fiyupa almiraypajcunata rurashayquitapis willacushaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios, tiyashayqui Wasitami cuyä.","poem":1},{"lineBreak":true},{"text":"Chay Wasichömi munayniqui caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Juchasapacunatanöga ama ruramaychu.","poem":1},{"lineBreak":true},{"text":"Wañuchicojcunatanöga ama castigamaychu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paycunaga mana allillatami ruran,","poem":1},{"lineBreak":true},{"text":"saynitami chasquin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nogami ichanga imaypis alli cajllata ruraycä.","poem":1},{"lineBreak":true},{"text":"Cuyapämashpayqui salbaycamay ari.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaquëga manami imaypis llutanmanga lluchcangachu.","poem":1},{"lineBreak":true},{"text":"Nogaga mana cachaycuypa alli nänillapami puriycä.","poem":1},{"lineBreak":true},{"text":"Tayta Diostaga acrashan runacunapa ñaupanchömi alabashaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}