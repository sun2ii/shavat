{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":28,"content":[{"type":"heading","content":["Mañacushanchïta Tayta Dios wiyan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, gamllami canqui gaganöpis chapämaj.","poem":1},{"lineBreak":true},{"text":"Gamllatami ruwacur mañacaycämö.","poem":1},{"lineBreak":true},{"text":"Ama caychu mana wiyaj-tucuypaga.","poem":1},{"lineBreak":true},{"text":"Mana yanapämaptiquega wañusha japuynami ricacushaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mañacamuptë yanapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Rispitädu tiyanayquiman maquëta jogarir mañacamuptë wiyaycamay ari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fiyucunatawan iwalga ama castigamaychu.","poem":1},{"lineBreak":true},{"text":"Paycunaga janan shongullami alli parlaj-tucun.","poem":1},{"lineBreak":true},{"text":"Ichanga jucha rurayllapämi yarparcaycan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paycunataga castigay ari","poem":1},{"lineBreak":true},{"text":"mana allita rurashanman-tupu.","poem":1},{"lineBreak":true},{"text":"Juchata rurashanman-tupu ayñita cutichiy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chay fiyucunataga Tayta Dios ushajpämi illgächenga","poem":1},{"lineBreak":true},{"text":"Tayta Dios imata rurashantapis mana riguishanpita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tayta Dios alabasha caycuchun.","poem":1},{"lineBreak":true},{"text":"Llapan mañacushäta wiyamashanpita alabasha caycuchun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Diosmi fiyupa munayniyoj chapämäga.","poem":1},{"lineBreak":true},{"text":"Paymanmi llapan shongöpa yäracö.","poem":1},{"lineBreak":true},{"text":"Paymi yanapäman.","poem":1},{"lineBreak":true},{"text":"Chaypitami fiyupa cushisha goyä.","poem":1},{"lineBreak":true},{"text":"Chaymi Tayta Diosta agradësicur alabashaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Diosmi acrashan runacunata imapitapis chapäga.","poem":1},{"lineBreak":true},{"text":"Paymi acrashan raytapis yanapan, imapitapis chapan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Acrashayqui runacunata salbay Tayta Dios.","poem":1},{"lineBreak":true},{"text":"Gam acrashayqui cajcunataga bindisyunta goycullay.","poem":1},{"lineBreak":true},{"text":"Uyshërunöpis sumaj ricaycullay.","poem":1},{"lineBreak":true},{"text":"Margashalla apaycuy imaycamapis munayniquicho goyänanpaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}