{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":3,"content":[{"type":"heading","content":["Yanapänanpaj Tayta Diosta mañacushan"]},{"type":"hebrew_subtitle","content":["Wamran Absalonpita gueshpir aywacur David rimashan."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, chiquimajcunaga achcajmi.","poem":1},{"lineBreak":true},{"text":"Aypallajmi conträga ricacusha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Nogapäga achcajmi nircaycan «Diosga manami salbangachu» nir! Selah","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chayno niptinpis Tayta Dios,","poem":1},{"lineBreak":true},{"text":"gammi imapitapis chapämanqui.","poem":1},{"lineBreak":true},{"text":"Gammi shacyächimanqui.","poem":1},{"lineBreak":true},{"text":"Gammi cushicachimanqui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gaparayparämi Tayta Diostaga mañacö yanapämänanpaj.","poem":1},{"lineBreak":true},{"text":"Chaura rispitädu Sionpita wiyamushpanmi yanapäman. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tayta Dios yanapämaptinmi jauca puñucö, jauca ricchamö.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Manami manchachimanchu chay aypalla suldärucuna","poem":1},{"lineBreak":true},{"text":"intërupa curalaparaycämashanpis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Aywashun, Tayta Dios!","poem":1},{"lineBreak":true},{"text":"¡Salbaycamay ari!","poem":1},{"lineBreak":true},{"text":"Chiquimajcunataga gammi cärachu lagyanquipaj.","poem":1},{"lineBreak":true},{"text":"¡Juchasapacunataga quiruncunatapis jorgupanquipaj!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios, gammi pitapis salbanqui.","poem":1},{"lineBreak":true},{"text":"¡Acrashayqui runacunataga bindisyunta goycullay ari! Selah","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}