{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":30,"content":[{"type":"heading","content":["Tayta Diosta agradësicur alabashan"]},{"type":"hebrew_subtitle","content":["Diospa Wasinta inaurananpaj David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Ñacaycajta jorgamashayquipitami Tayta Dios gamta alabä.","poem":1},{"lineBreak":true},{"text":"Chiquimajcuna cushicunantaga manami munashcanquichu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Dios, ruwacur mañacuptë allchacächimarayqui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios, gammi wañuypita salbamashcanqui.","poem":1},{"lineBreak":true},{"text":"Wañojcuna chayashanman mana chayanäpaj cawachimashcanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tayta Dios munashanno goyaycajcunaga paypaj cantar alabay.","poem":1},{"lineBreak":true},{"text":"Juchaynaj Tayta Diosta alabay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Payga rätullami rabyan.","poem":1},{"lineBreak":true},{"text":"Alli cayninmi ichanga imaypis mana ushacanchu.","poem":1},{"lineBreak":true},{"text":"Chacaypa wagashpanchïpis","poem":1},{"lineBreak":true},{"text":"tutapaga cushicushunnami.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogaga jauca goyashpä yarparä «manami imapis päsamangachu» nir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gammi Tayta Dios alli cashpayqui nogataga alli pachaman tiyachimarayqui.","poem":1},{"lineBreak":true},{"text":"Cachaycamaptiquimi ichanga","poem":1},{"lineBreak":true},{"text":"manchariyllawan ima ruraytapis mana camäpacushcänachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Dios gamtami mañacamö.","poem":1},{"lineBreak":true},{"text":"Gamtami ruwacamö.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Noga wañuptë ¿imataraj gänanqui?","poem":1},{"lineBreak":true},{"text":"Wañushanaga manami alabashunquinachu.","poem":1},{"lineBreak":true},{"text":"Ni alli cashayquitapis mananami willaconganachu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Dios, wiyamashpayqui cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, yanapaycamay ari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Fiyupa llaquicuycho caycaptëmi cushicuyta churamushcanqui.","poem":1},{"lineBreak":true},{"text":"Lütu röpata lojtiparcamar fistapaj caj röpatana jatiparcamashcanqui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaymi Tayta Dios, upällallaga imaypis mana cacushächu.","poem":1},{"lineBreak":true},{"text":"¡Gamllatami alabashayqui!","poem":1},{"lineBreak":true},{"text":"¡Imaypis agradësicuycäshayquimi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}