"lineBreak":true},{"text":"Gammi canqui imapitapis chapämaj.","poem":1},{"lineBreak":true},{"text":"Togllacho caycajta salbaycamay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maquiquimanmi almäta entregaycö.","poem":1},{"lineBreak":true},{"text":"Gamga aunishayquita cumlej cashpayquimi salbamashcanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nogaga Tayta Diosllamanmi llapan shongöpa yäracö.","poem":1},{"lineBreak":true},{"text":"Manacaj ïdulucunaman yäracojcunataga chiquëmi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Cuyamaptiquimi fiyupa cushicö.","poem":1},{"lineBreak":true},{"text":"Gamga ricashcanquimi imano llaquicuycashätapis.","poem":1},{"lineBreak":true},{"text":"Musyanquimi imano ñacaycashätapis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chiquimajcunapa munayninmanga manami cachaycamashcanquichu.","poem":1},{"lineBreak":true},{"text":"Nogataga alli pachamanmi churamashcanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tayta Dios cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Fiyupami llaquicuycä.","poem":1},{"lineBreak":true},{"text":"Llaquicur wagaycällarnami mana ricänapischu.","poem":1},{"lineBreak":true},{"text":"Intëru cuerpömi pasaypa nanapäcuycan.","poem":1},{"lineBreak":true},{"text":"Shongöpis fiyupami ushaycan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wagaycällarnami waran-waranllanta auquinyaycä.","poem":1},{"lineBreak":true},{"text":"Llaquicuycaptillänami callpäcunapis ushacäcusha.","poem":1},{"lineBreak":true},{"text":"Intëru cuerpöpis pasaypami gotucäcusha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nogataga chiquimajcuna fiyupami jamurpäman.","poem":1},{"lineBreak":true},{"text":"Bisïnöcunapis asipämanmi.","poem":1},{"lineBreak":true},{"text":"Rejsinacushäcunapis melanäcamanmi.","poem":1},{"lineBreak":true},{"text":"Cällicho ricamajcunapis nogapita ayguicun.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wañojcunatanönami nogataga gongaycamasha.","poem":1},{"lineBreak":true},{"text":"Shallusha puyñunömi caycä.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Shap-shapyayllapami nogapäga llapanpis parlarcaycan.","poem":1},{"lineBreak":true},{"text":"Nogapäga juc yarpayllami llapanpis parlacun.","poem":1},{"lineBreak":true},{"text":"Wañuchimänanpämi parlacurcaycan.","poem":1},{"lineBreak":true},{"text":"Intërupami manchariypaj caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tayta Dios, imano captinpis gamllamanmi yäracamö.","poem":1},{"lineBreak":true},{"text":"Chaymi noga niycä «¡Gammi Diosnë canqui!» nir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nogaga gampa maquiquichömi cawaycä.","poem":1},{"lineBreak":true},{"text":"Salbaycamay ari chiquimashpan gaticachaycämajcunapita.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Cuyapaycamay gamta sirbishoj uywayniquitaga.","poem":1},{"lineBreak":true},{"text":"Cuyacoj cashpayqui salbaycamay ari.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Dios, gammanmi gayacamö.","poem":1},{"lineBreak":true},{"text":"¡Pengaychöga ama cachaycamaychu ari!","poem":1},{"lineBreak":true},{"text":"Fiyucunata pengaymanga churaycuy.","poem":1},{"lineBreak":true},{"text":"Pantiyun uchcullachöna ushacächun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Llullacunawan, asipar manacajman churacojcuna,","poem":1},{"lineBreak":true},{"text":"alli cacojcunata abusapar gallaripajcunaga illgächun.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Rispitashojcunapäga allitami ruranqui.","poem":1},{"lineBreak":true},{"text":"Chay allicunatami paycunapäga goritano shuyaraycächinqui.","poem":1},{"lineBreak":true},{"text":"Chaycunataga waquin runacuna ricananpärämi gamman yäracamojcunata tarichinqui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Paycunataga gammi ñaupancho car salbanqui fiyu runacunapita.","poem":1},{"lineBreak":true},{"text":"Gammi Wasiquiman pacashpayqui washanqui washa-rimacunapita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Alabasha cachun Tayta Diosga.","poem":1},{"lineBreak":true},{"text":"Paymi cuyapäcoj cashpan yanapämasha","poem":1},{"lineBreak":true},{"text":"fiyupa ñacaycho caycashä öra.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fiyupa manchariycashä örami yarparä","poem":1},{"lineBreak":true},{"text":"«Tayta Diosga manami yarpämannachu» nir.","poem":1},{"lineBreak":true},{"text":"Chaypis yanapämänayquipaj mañacamuptëga yanapämashcanquimi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tayta Diosman mana cachaypa yäracojcunaga payta cuyay.","poem":1},{"lineBreak":true},{"text":"Chayno runacunataga Tayta Dios allimi rican.","poem":1},{"lineBreak":true},{"text":"Alli-tucojcunatami ichanga imanöpis cashanpita castigan.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tayta Diosman yäracoj cajcunaga mana guellanayllapa cumliy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}