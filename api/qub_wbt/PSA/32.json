{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":32,"content":[{"type":"heading","content":["Dios perdunashan cajcuna cushicushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Cushishami cawanga llapan juchanpita perdunasha caj runaga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Cushishami cawanga Tayta Dios mana jusgashan runaga,","poem":1},{"lineBreak":true},{"text":"alli shongu runaga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jucha rurashäta amuräcushäcamaga","poem":1},{"lineBreak":true},{"text":"goyarpoj wagaycaptilläna","poem":1},{"lineBreak":true},{"text":"cuerpöpis pasaypana gotucaycasha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pagasta junajtapis castigamaptiquimi fiyupa ñacashcä.","poem":1},{"lineBreak":true},{"text":"Usya wichan acaywan wayta wañuytaycajno caycashätanami mayashcä. Selah","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaymi sumaj yarpachacurir «Juchätaga llapanta Tayta Diosta willapäshaj» nishcä.","poem":1},{"lineBreak":true},{"text":"Nircurna mana alli rurashäcunataga mana pacaypa gamta willashcä Tayta Dios.","poem":1},{"lineBreak":true},{"text":"Chauraga gamnami llapanta perdunamashcanqui.Selah","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaymi ñacaycho caycashan öra wiyacushojcunaga mañacamushunquipaj.","poem":1},{"lineBreak":true},{"text":"Yacu manchariypaj chayashpanpis paycunamanga manami aypangachu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gammi canqui pacacunä, mana allicunapitapis chapämajnëga.","poem":1},{"lineBreak":true},{"text":"Salbamashayquipitami cushicur alabansacunatapis cantashaj. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Diosga caynömi nin: «Gamtaga manami gongashayquichu.","poem":1},{"lineBreak":true},{"text":"Nogami tantiyachishayquipaj.","poem":1},{"lineBreak":true},{"text":"Nogami willapäshayquipaj.","poem":1},{"lineBreak":true},{"text":"Imano goyänayquipäpis yachachishayquipaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ama canquichu cawalluno bürruno mana tantiyacöga.","poem":1},{"lineBreak":true},{"text":"Cawallutaga busalninwanrämi ichichinchi.","poem":1},{"lineBreak":true},{"text":"Bürrutapis shengallawacurcur-rämi munashanchïpa apanchi.","poem":1},{"lineBreak":true},{"text":"Chayno mana rurashaga manami wiyamanchïchu» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Fiyucunaga nanaywan fiyupami ñacanga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosman yäracojcunataga paymi fiyupa cuyashpan yanapanga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Diosman yäracojcunaga cushicuy pay alli cashanpita.","poem":1},{"lineBreak":true},{"text":"Cushicushpayqui alabansacunata cantay.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}