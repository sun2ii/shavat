{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":35,"content":[{"type":"heading","content":["Yanapänanpaj Tayta Diosta mañacushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios chiquimajcunapitaga washaycamay.","poem":1},{"lineBreak":true},{"text":"Magamajcunawanga pillyay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chapacuna escüduyquiwan shamuy yanapämänayquipaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gaticachämajcunawanga gam pillyay.","poem":1},{"lineBreak":true},{"text":"«Paycunapitaga salbashayquimi» nimay.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wañuchiyta munamajcunaga pengaycho quëdachun.","poem":1},{"lineBreak":true},{"text":"Mana allita ruramayta munajcunaga pengay-tucusha gueshpichun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Diospa anjilnin apaptin ricacuchun rïgupa punshanta wayra apashanno.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Diospa anjilnin gaticachaptin paycunapäga nänipis ticracurichun chacaj y llushcaman.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mana imatapis rimapaycaptillämi togllata churasha.","poem":1},{"lineBreak":true},{"text":"Uchcuta uchcusha chayman yaganäpaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quiquincunata illajpita mana alli chayachun.","poem":1},{"lineBreak":true},{"text":"Toglla churashallanman quiquincuna watacächun.","poem":1},{"lineBreak":true},{"text":"Mana allicunaman tunichun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Chauraga Tayta Dios yanapämashanpitami cushicushaj.","poem":1},{"lineBreak":true},{"text":"Salbamashanpitami fiyupa cushicushaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Llapan shongöpami nishaj: «Gammanga Tayta Dios, manami pipis tincunchu.","poem":1},{"lineBreak":true},{"text":"Umildicunatawan pobricunataga jorgunquimi","poem":1},{"lineBreak":true},{"text":"mas munayniyojcunapa y engañar suwapajcunapa maquinpita.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rantiy testïgucunami yurin.","poem":1},{"lineBreak":true},{"text":"Paycunami tapuman mana musyashäcunata.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Alli yanapashäpitami mana alliwan cutichiman.","poem":1},{"lineBreak":true},{"text":"Chaymi fiyupa llaquicö.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nogami ichanga paycuna gueshyaptinpis fiyupa llaquicoj cä.","poem":1},{"lineBreak":true},{"text":"Gachga röpacunata jaticur ayunaj cä.","poem":1},{"lineBreak":true},{"text":"Shongullächo mana cachaypa Tayta Diosta mañacuycaj cä.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fiyupa llaquishalla purejpis cä.","poem":1},{"lineBreak":true},{"text":"Mamäpaj, amïgöpaj, wauguëpaj lütu caycajnöraj llaquicoj cä.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mana alliman chayaptëmi ichanga paycuna llapan asipämasha.","poem":1},{"lineBreak":true},{"text":"Juc-lä runacunanömi mana cachaypa magamar ñacachimasha.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wacpita-caypita gayapämashpan asipämasha.","poem":1},{"lineBreak":true},{"text":"Fiyupa chiquimar fiyu ñawinwan ricapämashapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tayta Dios, ¿imaycamaraj fiyucunata ricapanqui?","poem":1},{"lineBreak":true},{"text":"Liyuncunanöpis gaparaycar puriycajpita salbaycamay ari.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Acrashayqui runacunapa ñaupanchömi agradësicushayqui.","poem":1},{"lineBreak":true},{"text":"Aypalla runacunapa ñaupanchömi alabashayquipis.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chiquimajcunaga ama cushicuchunnachu.","poem":1},{"lineBreak":true},{"text":"Manacajpita chiquimajcuna ñipchipämänanta ama munaycuychu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Paycunaga manami munanchu alli cawaytaga.","poem":1},{"lineBreak":true},{"text":"Cay nasyuncho alli goyäcoj runacunata mana alli goyächinallanpämi yarpachacurcaycan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Jatunta äyarcur-äyarcur nogapa conträmi jitaparcaycäman","poem":1},{"lineBreak":true},{"text":"«Quiquëcunami ñawëpa ricashcä» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Tayta Dios, gamga musyanquimi imano cashantapis.","poem":1},{"lineBreak":true},{"text":"Upällallaga ama cacuychu.","poem":1},{"lineBreak":true},{"text":"Nogata ichanga ama gongaycamaychu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tayta Dios, faburnë jatariy ari. Ricchayna.","poem":1},{"lineBreak":true},{"text":"Rasun cajta jusgamay ari.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gamga canqui juchaynaj Tayta Diosmi.","poem":1},{"lineBreak":true},{"text":"Alli arriglamashpayqui salbamay ari.","poem":1},{"lineBreak":true},{"text":"Nogapäga ama pipis cushicuchunchu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ama yarpächunchu ni rimachunpischu","poem":1},{"lineBreak":true},{"text":"«Chayno canantami munaranchi» nir;","poem":1},{"lineBreak":true},{"text":"«Fiyupa mana allimanmi chayachishcanchi» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mana alliman chayashäpita cushicurcaycajcunaga pengaycho ricacuchun.","poem":1},{"lineBreak":true},{"text":"Nogapita mas alli-tucojcunaga fiyupa pengaycho cachun.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Llapanpita allicho llojshinäta munajcuna ichanga","poem":1},{"lineBreak":true},{"text":"cushicushpan gayarayparaj cantachun.","poem":1},{"lineBreak":true},{"text":"Paycunaga cayno nichun.","poem":1},{"lineBreak":true},{"text":"«Tayta Diosga alabasha cachun.","poem":1},{"lineBreak":true},{"text":"Payga sirbejnin jauca goyänantami munan» nir.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Alli arriglaj cashayquitami pï-maytapis willapäshaj.","poem":1},{"lineBreak":true},{"text":"¡Goyay goyaymi alabashayqui!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}