xt":"lëchanta, lëcha jitacunanta camaricun","poem":1},{"lineBreak":true},{"text":"pobricunata, alli runacunata wañuchinanpaj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ichanga quiquinpa sablillanmi shongupa tucsipaycongapaj.","poem":1},{"lineBreak":true},{"text":"Lëchancunapis agullashami ricacongapaj.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Aypallata chararpis fiyu runa cananchïpa ruquenga","poem":1},{"lineBreak":true},{"text":"pobrilla carpis alli runa caymi mas alliga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fiyucunapataga callpantapis ushajpämi Tayta Dios ushacächenga.","poem":1},{"lineBreak":true},{"text":"Allicunatanami ichanga yanapanga.","poem":1}]},{"type":"verse","number":18,"content":[{"text":"Alli runacunataga Tayta Dios waran-waranmi ricaycan.","poem":1},{"lineBreak":true},{"text":"Paycunaga chasquengapaj imaypis mana ushacajtami.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Llaquicuy junajcunachöpis paycunaga manami pengaycho cangachu.","poem":1},{"lineBreak":true},{"text":"Muchuy wichanpis paycunapaga micuynin puchu-puchumi caycangapaj.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Fiyucunaga ushajpämi illgangapaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta chiquejcunaga gaushusha jachanömi rupanga.","poem":1},{"lineBreak":true},{"text":"Goshtaynömi illgacäconga.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Fiyucunaga ristacurcurpis manami päganchu.","poem":1},{"lineBreak":true},{"text":"Alli runami ichanga cuyapäcoj cashpan pï-maytapis macyaycun.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tayta Dios bindisyunta goshan cajcunallami alli pachachöga tiyanga.","poem":1},{"lineBreak":true},{"text":"Pay maldisyunta goshan cajcunami ichanga illganga.","poem":1}]},{"type":"verse","number":23,"content":[{"text":"Tayta Diosmi runataga alli caminullapa p