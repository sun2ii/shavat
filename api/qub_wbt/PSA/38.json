{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":38,"content":[{"type":"heading","content":["Gueshyaj runa Tayta Diosta mañacushan"]},{"type":"hebrew_subtitle","content":["Yarpächinanpaj David rurashan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, rabyasha caycashpayquega ama piñacamaychu.","poem":1},{"lineBreak":true},{"text":"Ollgusha caycarpis ama castigamaychu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lëchayquipis cuerpöchömi jaticasha caycan.","poem":1},{"lineBreak":true},{"text":"Maquiquiwanmi ñacachimashcanqui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rabyasha piñacamaptiquimi intëru cuerpöpis manana sänunachu.","poem":1},{"lineBreak":true},{"text":"Juchäpitami tullöcunapis manana sänunachu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Juchä atipashami caycä.","poem":1},{"lineBreak":true},{"text":"Chaymi lasaj guepino ñacaycächiman.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mana yarpachacuypa rurashäpitami guerëcunapis ismur asyaricurisha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Llaquishalla, jagayashalla, uysucushallami purëpis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rupaywan wajtäpis rauraycan. Intëru cuerpömi nanaycan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Callpäpis mananami cannachu.","poem":1},{"lineBreak":true},{"text":"Wirur-ushashanömi nanapäcuycä.","poem":1},{"lineBreak":true},{"text":"Chaymi llapan shongöpa llaquicur ataycä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tayta Dios, imata munaycashallätapis gamga musyanquimi.","poem":1},{"lineBreak":true},{"text":"Llaquicuycashäcunapis manami pacaranchu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Shongöpis tic-ticyaycanmi.","poem":1},{"lineBreak":true},{"text":"Callpäpis manami cannachu.","poem":1},{"lineBreak":true},{"text":"Ñawëpis chacaycannami.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Guerëcuna captinmi llapan amïgöcunapis, castäcunapis carullachöna carcaycan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wañuchimayta munajcunaga togllatami churaparcaycäman.","poem":1},{"lineBreak":true},{"text":"Mana allita ruramayta munamajcunaga illgächimaytami yarparcaycan.","poem":1},{"lineBreak":true},{"text":"Imay örapis mana allita ruramayllatami yarpaycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Chaypis nogaga mana wiyaj upanömi cacö.","poem":1},{"lineBreak":true},{"text":"Mana rimaj upano imatapis mana rimacöchu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Imata nimaptinpis manami wiyaj-tucöchu.","poem":1},{"lineBreak":true},{"text":"Upanömi imata nimaptinpis mana cutichëchu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Dios, gamtami shuyaraycä.","poem":1},{"lineBreak":true},{"text":"Nogapa faburnë gam rimarcuy ari.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ichanga ruwacushayqui Tayta:","poem":1},{"lineBreak":true},{"text":"Tuniptë-imaga ama camacächiychu nogata asipämänanta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Illajpitanami tunej-aywä.","poem":1},{"lineBreak":true},{"text":"Intëru cuerpö nanaycaj manami rätullapis chawaycunnachu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Juchata rurashäpitami fiyupa llaquicö.","poem":1},{"lineBreak":true},{"text":"Chaymi jucha rurashäta willacushaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chiquimajcunaga aypallanami miracurcusha.","poem":1},{"lineBreak":true},{"text":"Mana imatapis rimapaycaptillämi achcaj chiquicarcamasha.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Noga allita rurashäpita mana alliwanmi cutiycächiman.","poem":1},{"lineBreak":true},{"text":"Noga alli cajllata ruraptëmi paycunaga chiquicarcäraman.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tayta Dios, ama japallätaga cachaycamaychu.","poem":1},{"lineBreak":true},{"text":"Ama gongaycamaychu ari.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Imaypis salbamaj Tayta Dios,","poem":1},{"lineBreak":true},{"text":"juclla yanapaycamay ari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}