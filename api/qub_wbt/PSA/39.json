{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":39,"content":[{"type":"heading","content":["Rätullami cawanchi"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa. Jedutún cantashan."]},{"type":"verse","number":1,"content":[{"text":"Nogaga yarparä fiyu runacunapa ñaupancho cashä öra","poem":1},{"lineBreak":true},{"text":"allilla goyaytami,","poem":1},{"lineBreak":true},{"text":"upällalla cacuytami,","poem":1},{"lineBreak":true},{"text":"mana quijacuytami.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mana imatapis rimacuypami upa-tucur cacurä.","poem":1},{"lineBreak":true},{"text":"Allita ni mana allitapis manami parlacurächu.","poem":1},{"lineBreak":true},{"text":"Chaypis pasaypami pashtapacuyta munaycarä.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Shongöpis rupariycämuran.","poem":1},{"lineBreak":true},{"text":"Yawarnëpis timpuricuriran.","poem":1},{"lineBreak":true},{"text":"Chaymi rimarir nirä:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«Tayta Dios, musyachimay imano ushacänäpaj cashantapis,","poem":1},{"lineBreak":true},{"text":"imaycama cawanäpaj cashantapis.","poem":1},{"lineBreak":true},{"text":"Musyachimay pöcu diyalla cawaj cashätapis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nogataga cawaycächimanqui wallca diyallami.","poem":1},{"lineBreak":true},{"text":"Nogapa cawaynëga gampaj manami aycäpischu.","poem":1},{"lineBreak":true},{"text":"Pï-maypis cawan jämayta cachaynöllami. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Llapan runacunapis cawan llantuyno päsacojllami.","poem":1},{"lineBreak":true},{"text":"Yangallami imatapis shuntacusha gotucusha.","poem":1},{"lineBreak":true},{"text":"Manami musyanchu riquësancunawan pï quëdananpaj cashantapis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Dios chayno caycaptenga ¿imatanataj shuyaräshaj?","poem":1},{"lineBreak":true},{"text":"Gamllamanna yäracamushaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Llapan juchäpita jorgaycamay ari.","poem":1},{"lineBreak":true},{"text":"Ama camacaycachiychu rumi shongucuna asipämänantaga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gam llapantapis camacächiptiquimi","poem":1},{"lineBreak":true},{"text":"imatapis mana rimacurächu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amana castigamaynachu ari.","poem":1},{"lineBreak":true},{"text":"Castigamashpayquimi wañuycächimanquina.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jucha rurashancunapita castigar-rämi runataga tantiyachinqui.","poem":1},{"lineBreak":true},{"text":"Cuyaynin cajtaga puyunömi ushaparinqui.","poem":1},{"lineBreak":true},{"text":"Runacunaga llapanpis cawan jämayta cachaynöllami. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Tayta Dios, wiyaycamay ari mañacaycämushäta.","poem":1},{"lineBreak":true},{"text":"Wagaycaptëga ama ricapäcamaychu.","poem":1},{"lineBreak":true},{"text":"Gampäga noga cä jäpa runanöllami.","poem":1},{"lineBreak":true},{"text":"Unay caj awilöcunanöpis manapis aycällatami wañucushaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amana ricapämaynachu.","poem":1},{"lineBreak":true},{"text":"Ichic cacharcamay ari cay pachacho cawashäcamallapis cushisha goyapärinäpaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}