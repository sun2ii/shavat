{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":40,"content":[{"type":"heading","content":["Yanapänanpaj Tayta Diosta mañacushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios juclla yanapämänantami shuyarashcä.","poem":1},{"lineBreak":true},{"text":"Paynami wiyamar yanapämasha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mitu sinigaman jaticänäpitami jorgamaran.","poem":1},{"lineBreak":true},{"text":"Wanwanyaycaj uchcupitami salbamasha.","poem":1},{"lineBreak":true},{"text":"Rumi jananman ichichimaran.","poem":1},{"lineBreak":true},{"text":"Allinnin pachaman churamaran.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diosmi yarpayta gomaran mushoj alabansata cantanäpaj.","poem":1},{"lineBreak":true},{"text":"Imano päsamashantapis musyaycur runacunaga fiyupa almiraran.","poem":1},{"lineBreak":true},{"text":"Chaynöpami Tayta Diosmanna yäracuran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Cushishami cawanga Tayta Diosllaman yäracöga,","poem":1},{"lineBreak":true},{"text":"alli-tucojcunata mana tapucöga,","poem":1},{"lineBreak":true},{"text":"ni ïdulucunamanpis mana riguëga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gamga Tayta Dios, aypallatami milagrucunata rurashcanqui.","poem":1},{"lineBreak":true},{"text":"Nogacunataga imay örapis yarparaycämanquimi.","poem":1},{"lineBreak":true},{"text":"Chaycunata willacushpämi pï-maytapis willapayta munä.","poem":1},{"lineBreak":true},{"text":"Ichanga willapaytapis manami ushämanchu.","poem":1},{"lineBreak":true},{"text":"Manami imapis tincunchu gammanga tayta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gamga manami cushicunquichu uywacunata pishtapäshushallayquipita,","poem":1},{"lineBreak":true},{"text":"ni chaqui micuycunata garashushallayquipitapis.","poem":1},{"lineBreak":true},{"text":"Aychata rupachipäshushallayquipitaga manami perdunanquichu.","poem":1},{"lineBreak":true},{"text":"Chaycunapa ruquenga gamta wiyacunallätami munanqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chaymi nishcä: «Caychömi caycä.","poem":1},{"lineBreak":true},{"text":"Laychöpis nogapämi isquirbiraycan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios, gam munashayquita rurarmi cushicö.","poem":1},{"lineBreak":true},{"text":"Layniquicunatapis llapantami yarparaycä.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Acrashayqui runacunapa ñaupanchömi","poem":1},{"lineBreak":true},{"text":"alli cashayquita willacushcä.","poem":1},{"lineBreak":true},{"text":"Manami amucurcushcächu.","poem":1},{"lineBreak":true},{"text":"Chaytaga gam musyaycanquimi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gam alli cashayquitaga manami upällacushcächu.","poem":1},{"lineBreak":true},{"text":"Llapanta cumlej cashayquita salbacoj cashayquitaga willacushcämi.","poem":1},{"lineBreak":true},{"text":"Acrashayqui runacunatami willapashcä cuyacoj cashayquita, rasun cajta rurashayquita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tayta Dios, cuyapaycamay ari; ama ñïgamaychoga.","poem":1},{"lineBreak":true},{"text":"Aunishayquita cumlej cashpayqui imaypis chapaycamay.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yupaytapis mana atipaypämi mana allicunaga chayamasha.","poem":1},{"lineBreak":true},{"text":"Quiquë mana allita rurashäcunallami chayamasha.","poem":1},{"lineBreak":true},{"text":"Chaycunapita imanöpa llojshiytapis manami camäpacöchu.","poem":1},{"lineBreak":true},{"text":"Balurnëpis manami cannachu.","poem":1},{"lineBreak":true},{"text":"Juchäcunaga ajchäpitapis mas aypallami.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Taytallau tayta, salbaycamay ari.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, canan öra shaycamuy yanapämänayquipaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wañuchimayta munajcunaga pengay-tucushpan umpuycachächun.","poem":1},{"lineBreak":true},{"text":"Mana allita rurayta munamajcunaga pengay-tucusha gueshpichun.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Asipämajcunaga pengay-tucusha aywacuchun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Gamman yäracamojcuna ichanga cushicuchun.","poem":1},{"lineBreak":true},{"text":"Gam salbanayquita munaycajcunaga imaypis","poem":1},{"lineBreak":true},{"text":"«¡Tayta Diosga munayniyojmi!» nichun.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Dios, noga pobriyasha llaquicuycajta ichanga","poem":1},{"lineBreak":true},{"text":"ama gongaycamaychu.","poem":1},{"lineBreak":true},{"text":"Gammi canqui yanapämaj imapitapis jorgamaj.","poem":1},{"lineBreak":true},{"text":"Juclla yanapaycamay ari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}