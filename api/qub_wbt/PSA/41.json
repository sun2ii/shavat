k"},{"type":"verse","number":4,"content":[{"text":"Tayta Diostami ruwacushcä: «Tayta Dios cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Juchata rurashäpitami gueshyaycä.","poem":1},{"lineBreak":true},{"text":"Allchacaycachimay ari» nir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chiquimajcunaga fiyupami munan mana alliman chayanäta.","poem":1},{"lineBreak":true},{"text":"Chaymi «¿imayraj wañonga gongacänanpaj?» nircaycan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ricamaj shamushpanpis janan shongullami parlan wiyanäpaj.","poem":1},{"lineBreak":true},{"text":"Mana alli cajcunata shongullancho yarpan.","poem":1},{"lineBreak":true},{"text":"Nircur washäta parlaraycar aywacun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Shuntacaycärirmi washäta riman.","poem":1},{"lineBreak":true},{"text":"Paycunaga yarpan juchäpita ñacaycashätami.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaymi nin: «Chay gueshyawanga dyablumi gueshyachisha.","poem":1},{"lineBreak":true},{"text":"Cämanpitaga imaypis mananami jatarengapänachu» nir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fiyupa cuyanacushä, yäracushä runa,","poem":1},{"lineBreak":true},{"text":"iwal micushäpis cananga conträmi ricacusha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gam ichanga Tayta Dios cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Jitaraycashäpita jatarcachimay ayñita cutichinäpaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chaynöpami nogaga musyashaj gampaj alli caycashäta.","poem":1},{"lineBreak":true},{"text":"Chiquimajcunapis manami cushiconganachu «Binsishcä» nir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Munashayquino allillata rurasha caycaptëga manami cachaycamashcanquichu.","poem":1},{"lineBreak":true},{"text":"Ñaupallayquichömi imaypis cachimashcanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Cananpis imaypis alabasha cachun Israelcunapa Tayta Diosnenga.","poem":1},{"lineBreak":true},{"text":"Chayno caycullächun ari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}