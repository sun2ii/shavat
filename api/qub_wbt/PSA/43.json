öpami altarniquiman chayashaj.","poem":1},{"lineBreak":true},{"text":"Chaychönami alabashayqui arpanpawan.","poem":1},{"lineBreak":true},{"text":"Tayta Diosnë, gammi sumaj cushicachimanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Imanirtaj yarpachacushaj?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj llaquicushaj?","poem":1},{"lineBreak":true},{"text":"Tayta Diosmanmi yäracuycä.","poem":1},{"lineBreak":true},{"text":"Payllatami alabashäpis.","poem":1},{"lineBreak":true},{"text":"Paymi Salbamaj Diosnëga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}