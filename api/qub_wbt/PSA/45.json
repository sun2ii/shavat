{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":45,"content":[{"type":"heading","content":["Ray majachacänanpaj rimashan"]},{"type":"hebrew_subtitle","content":["Corëpita mirajcuna isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Shongullächömi yarpaycä allita rimanäpaj.","poem":1},{"lineBreak":true},{"text":"Imanöparaj cuyayllapaj alabansacunata jorgöman rayta alabanäpaj.","poem":1},{"lineBreak":true},{"text":"Paypämi cantashaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gamga llapan runacunapitapis mas cuyayllapämi canqui.","poem":1},{"lineBreak":true},{"text":"Maysi wiyacuylla allillami parlanqui.","poem":1},{"lineBreak":true},{"text":"Chaymi Tayta Diosga imaycamapis bindisyunta goycäshunqui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jinyu ray, sabliquita chegllayquiman jaticuy.","poem":1},{"lineBreak":true},{"text":"Tayta ray, chaywanga achicyaypa achicyar sumajmi camaranqui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cawalluta muntacurcur binsej binsejllana guërraman ayway.","poem":1},{"lineBreak":true},{"text":"Aywanqui alli cajllatana llapanpis rurananpaj,","poem":1},{"lineBreak":true},{"text":"umildicunapa faburnin pillyaj.","poem":1},{"lineBreak":true},{"text":"Derëchu caj maquiquimi ruranga fiyupa almiraypajcunata.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gampa lëchayquicunaga llauchi punta cashpanmi","poem":1},{"lineBreak":true},{"text":"chiquishojcunapa shonguncamapis chayarin.","poem":1},{"lineBreak":true},{"text":"Tayta ray, llapan runacunami gammanga gongurpacamonga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tayta Dios camacächiptin mandaycashayquega para-simrimi.","poem":1},{"lineBreak":true},{"text":"Gamga llapantapis allimi mandanqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alli cajtaga cuyanquimi, mana alli cajtaga chiquinquimi.","poem":1},{"lineBreak":true},{"text":"Chaynöpami Tayta Dios acracushurayqui.","poem":1},{"lineBreak":true},{"text":"Waquin yanasayquicunapitami acracushurayqui.","poem":1},{"lineBreak":true},{"text":"Gamtaga sumaj cushicachishurayqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alli caj perfümi alli asyashannömi röpayquipis alli asyaycan.","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj marfilwan adurnasha palasyuyquichömi cushicachishunqui arpacunata tucapäshushpayqui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Palasyuyquichöga raycunapa warmi wamrancunami caycan.","poem":1},{"lineBreak":true},{"text":"Jamarashayquipa derëchu caj-läduyquichönami casaranayquipaj caj rayna caycan.","poem":1},{"lineBreak":true},{"text":"Paypa röpanga caycan mas fïnu caj goriwan adurnashami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sumaj wiyamay ïja. Willapashätaga sumaj tantiyacuy.","poem":1},{"lineBreak":true},{"text":"Marca-masiquitawan famillyayquitaga amana yarparaynachu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Cuyayllapaj captiquimi gamtaga ray munacushurayqui.","poem":1},{"lineBreak":true},{"text":"Paymi canga taytayqui. Payta wiyacuy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tiro runacunami gamman shamonga imatapis goycushunayquipaj.","poem":1},{"lineBreak":true},{"text":"Rïcunnin caj runacunapis yanapänayquipämi ruwacushunquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Raypa jipash wamranmi cuyayllapaj shuyaraycan.","poem":1},{"lineBreak":true},{"text":"Röpanpis caycan goriwan burdashami.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Cuyayllapaj burdasha röpayojtami ray cajmanga pushan.","poem":1},{"lineBreak":true},{"text":"Donsëlla warmicunapis yan'gaycan.","poem":1},{"lineBreak":true},{"text":"Yanasancunami fïlayllanpa aywaycan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Cushishami aywarcaycan","poem":1},{"lineBreak":true},{"text":"raypa palasyunman cushisha yaycunanpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tayta ray, wamrayquicunami unay caj awiluyquicunano mandaj cangapaj.","poem":1},{"lineBreak":true},{"text":"Gammi yanapanquipaj cay nasyunchöga llapanta mandananpaj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nogami alabansacunawan jutiquita yarpächishäpaj","poem":1},{"lineBreak":true},{"text":"taytancuna wañuptin wamrancuna mirajchöga.","poem":1},{"lineBreak":true},{"text":"Chaynöpami intërucho llapan runacuna imaycamapis gampaj allita parlangapaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}