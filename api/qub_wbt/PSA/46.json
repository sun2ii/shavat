{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":46,"content":[{"type":"heading","content":["Tayta Dios chapämanchïmi"]},{"type":"hebrew_subtitle","content":["Corëpita mirajcuna isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Diosmi imapitapis pacamajninchëga.","poem":1},{"lineBreak":true},{"text":"Ñacaycashanchi örapis juclla yanapämanchi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chaymi ama manchacushunchu","poem":1},{"lineBreak":true},{"text":"cay pacha intërupa rachicaycaptinpis,","poem":1},{"lineBreak":true},{"text":"jircacuna lamarman tallpucaycaptinpis,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"lamar yacu gaparar wac-läman cay-läman pullchajyaptinpis,","poem":1},{"lineBreak":true},{"text":"lamar pullchajyaptin jircacuna sicsicyaptinpis.Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Juc mayumi caycan Tayta Dios acrashan siudächo tiyaj runacuna cushicunanpaj.","poem":1},{"lineBreak":true},{"text":"Chay siudäga Tayta Dios tiyashanmi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Dios waran-waran chaycho captinmi mana cuyucongachu.","poem":1},{"lineBreak":true},{"text":"Paymi chararanga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Dios rimarcamuptenga intëru nasyun runacunami gaparpan, mandajnincunapis sicsicyan.","poem":1},{"lineBreak":true},{"text":"Cay pachapis wac-läpa cay-läpami rachicäcun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Diosmi noganchïwan caycan.","poem":1},{"lineBreak":true},{"text":"Jacob rispitashan Tayta Diosmi noganchïpa pacacunanchëga. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Cay pachacho almiraypajcunata Tayta Dios rurashanta ricanayquipaj shamuy-llapa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Payga guërratapis intëruchömi chawächisha.","poem":1},{"lineBreak":true},{"text":"Paymi lëcha jitacunatapis paquirgärisha.","poem":1},{"lineBreak":true},{"text":"Tucsicunantapis ichic-ichiclla paquirgärisha.","poem":1},{"lineBreak":true},{"text":"Guërrapaj caycaj carrëtacunatapis rupargärachisha.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Caynömi niran: «Diosniqui cashäta tantiyacuy.","poem":1},{"lineBreak":true},{"text":"Maquëchöna caway.","poem":1},{"lineBreak":true},{"text":"Nogami intëru nasyuntapis maquëcho caycächë.","poem":1},{"lineBreak":true},{"text":"Nogami cay mundutapis chararaycä.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Munayniyoj Tayta Diosmi noganchïwanga caycan.","poem":1},{"lineBreak":true},{"text":"Jacob rispitashan Tayta Diosmi noganchïpa pacacunanchëga. Selah","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}