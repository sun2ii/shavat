{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":48,"content":[{"type":"heading","content":["Acrashan Sión siudächo Tayta Dios tiyashan"]},{"type":"hebrew_subtitle","content":["Corëpita mirajcuna isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Diosninchëga munayniyojmi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosninchïtaga alabashun rispitädu lömancho caycaj siudänincho.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sión lömaga cuyayllapämi.","poem":1},{"lineBreak":true},{"text":"Chaychöga caycan munayniyoj Raypa siudäninmi.","poem":1},{"lineBreak":true},{"text":"Chaymi llapan runacunapis fiyupa cushicun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Curalaraycaj Sionchömi Diosga caycan.","poem":1},{"lineBreak":true},{"text":"Diosga imapitapis chapämanchïmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Achca raycuna shuntacaycur chay siudämanmi pillyaj aywaran.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Siudäta ricärir ichanga fiyupa manchariran.","poem":1},{"lineBreak":true},{"text":"Imata ruraytapis mana camäpacur jinan öra gueshpir aywacuran.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paycunataga pasaypa manchariy charicuycuran.","poem":1},{"lineBreak":true},{"text":"Warmita gueshyacuy nanay charishannömi nanay charicuycuran.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tarsispita shamoj büquicunata löcu wayra paquir-ushashannömi","poem":1},{"lineBreak":true},{"text":"chay runacunataga usharishcanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wiyashanchïnömi rasunpa ricashcanchi,","poem":1},{"lineBreak":true},{"text":"llapanpaj munayniyoj Tayta Diosninchïpa siudäninchöga.","poem":1},{"lineBreak":true},{"text":"Chay siudänin imaypis mana illgänanpämi Pay camacächenga. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tayta Dios, Templuyquicho caycashächömi","poem":1},{"lineBreak":true},{"text":"yarpärishcäcuna fiyupa cuyacoj cashayquita.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Dios, cay pachachöga intëruchömi alabashunqui.","poem":1},{"lineBreak":true},{"text":"Gamga alabasha canayquimi camacanpis.","poem":1},{"lineBreak":true},{"text":"Munayniyoj carmi llapantapis allilla mandanqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sión lömachöga, Judá siudäcunachöga cushicun allita rurashayquipitami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Siontaga intëru cantunpa tumay.","poem":1},{"lineBreak":true},{"text":"Ricchacuna törrincuna ayca cashantapis yupay.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sumaj ricay imano palasyun cashantapis,","poem":1},{"lineBreak":true},{"text":"intëru cantupa tumariraj pergancuna imano cashantapis.","poem":1},{"lineBreak":true},{"text":"Ricashayquitami willapanquipaj guepa wiñaj wamracunata.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Paycunata willapanqui imaypis Tayta Dioslla Diosninchi cashanta.","poem":1},{"lineBreak":true},{"text":"Payllami imaypis pushamäshunpaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}