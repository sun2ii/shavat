{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":49,"content":[{"type":"heading","content":["Riquësacunaman mana yäracunapaj cashan"]},{"type":"hebrew_subtitle","content":["Corëpita mirajcuna isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Llapayqui wiyaycäriy.","poem":1},{"lineBreak":true},{"text":"Cay munducho tiyajcunaga sumaj wiyay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sumaj wiyay rïcucunapis, pobricunapis.","poem":1},{"lineBreak":true},{"text":"Munayniyojcunapis, umildicunapis wiyay-llapa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yarpachacuycurmi rimamushaj.","poem":1},{"lineBreak":true},{"text":"Yarpachacunapaj cajcunatami parlamushaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sasa tantiyaypaj cajcunatami rimashaj.","poem":1},{"lineBreak":true},{"text":"Arpa wagashan-tupunami nishaj chay rimashä ima ninan cashantapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nogaga manami mancharishächu llaquicuycuna chayamuptinpis.","poem":1},{"lineBreak":true},{"text":"Manami mancharishächu chiquimajcuna mana allita ruramashan chayamaptinpis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Conträcunaga yäracun ima-aycatapis charashallanmanmi.","poem":1},{"lineBreak":true},{"text":"Aypallata charashpan yarpan imaypis mana ushacänantami.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chayno cashpanpis Tayta Diostaga manami päganmanchu para-simri cawananpaj.","poem":1},{"lineBreak":true},{"text":"Quiquillanpitaga manami salbacunmanchu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Runacuna bïdanta rantinanpäga manami ayca guellaypis aypanchu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Runaga para-simri manami cawanchu.","poem":1},{"lineBreak":true},{"text":"Runaga wañojllami.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ricashanchïnöpis llapanmi wañun.","poem":1},{"lineBreak":true},{"text":"Musyaj-yachajcunapis, upacunapis wañunmi.","poem":1},{"lineBreak":true},{"text":"Llapan ima-aycanpis jucpänami quëdan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chacrancunata quiquinpa jutinta churapasha captinpis,","poem":1},{"lineBreak":true},{"text":"sepultürarämi mana ushacaj wasenga.","poem":1},{"lineBreak":true},{"text":"Chaychörämi para-simriga goyanga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Runaga may-jina rïcu carpis manami para-simriga cawanchu.","poem":1},{"lineBreak":true},{"text":"Uywacunanöllami wañun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Chaynömi wañun quiquillanman yäracojcunaga.","poem":1},{"lineBreak":true},{"text":"Chaynömi ushacanga quiquin alabacojcunaga. Selah","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chay runacunaga carcaycan michejta gatiraj uyshanömi.","poem":1},{"lineBreak":true},{"text":"Wañuymi paycunataga pushacuycan wañojcuna caycashan cajman.","poem":1},{"lineBreak":true},{"text":"Chaycho riccharcamuptin allita rurajcunami munaynincho chararanga.","poem":1},{"lineBreak":true},{"text":"Chaychöga ima-aycanpis mananami canganachu.","poem":1},{"lineBreak":true},{"text":"Sepultürallanami canga para-simri wasin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nogatami ichanga wañuypita Tayta Dios salbamanga.","poem":1},{"lineBreak":true},{"text":"Paymi pushacamanga. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Pipis rïcuyaptin,","poem":1},{"lineBreak":true},{"text":"alli wasita ruraptenga ama rabyapaychu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wañorga manami ima-aycantapis apangapächu.","poem":1},{"lineBreak":true},{"text":"Ima-aycanpis manami sepultüraman gatengapächu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Cawar cushisha goyaptin, rïcu captin runacuna alabaptinpis","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"imayllaga wañongami.","poem":1},{"lineBreak":true},{"text":"Mananami achicyaj pachata ricangapänachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Runaga may-jina rïcu carpis para-simriga manami cawanchu.","poem":1},{"lineBreak":true},{"text":"Uywacunanöllami wañun.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}