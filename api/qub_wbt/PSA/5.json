{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":5,"content":[{"type":"heading","content":["Chapänanpaj mañacushan"]},{"type":"hebrew_subtitle","content":["Cay salmutaga David camacächiran quënawan cantananpaj."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, mañacamushäta wiyaycamay ari.","poem":1},{"lineBreak":true},{"text":"Llaquicur mañacamushäta wiyaycamay ari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Raynë, Tayta Diosnë, ruwacaycämushäta wiyaycullay.","poem":1},{"lineBreak":true},{"text":"Gamtachaj mañacaycämö ari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tutallapita-pachami busnëta wiyaycanqui.","poem":1},{"lineBreak":true},{"text":"Chaca-chacallanami ruwacaycämö.","poem":1},{"lineBreak":true},{"text":"Cananga shuyaraycä yanapämänayquipämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tayta Dios, runacuna mana allita ruraptin gamga manami cushicunquichu.","poem":1},{"lineBreak":true},{"text":"Juchasapacunaga manami ñaupayquimanpis chayangapächu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alli-tucojcunaga manami ñaupayquimanpis chayamongachu.","poem":1},{"lineBreak":true},{"text":"Gamga chiquinquimi mana allita rurajcunataga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Illgächinquimi llullacunataga.","poem":1},{"lineBreak":true},{"text":"Melanäcunquimi wañuchicojcunatawan mana allita rurajcunataga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nogami ichanga gam cuyacoj cayniquipa Wasiquimanpis yaycö.","poem":1},{"lineBreak":true},{"text":"Rispitädu Templuyquichöpis gongurpacuycur gamta adurä.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios, allillapa pushamay ari alli shongu cashayquimanno.","poem":1},{"lineBreak":true},{"text":"Man'chäga chiquimajcunami mana allita ruramanga.","poem":1},{"lineBreak":true},{"text":"Munashayquino cawanäpaj yanapaycamay ari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Fiyu runacunaga manami imaypis rasun cajtaga rimanchu.","poem":1},{"lineBreak":true},{"text":"Shongunchöpis mana alli yarpaycunallami.","poem":1},{"lineBreak":true},{"text":"Shiminpis sepultüra quicharishanömi caycan.","poem":1},{"lineBreak":true},{"text":"Alli-tucullarmi parlan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Paycunataga castigaycuy ari Tayta Dios!","poem":1},{"lineBreak":true},{"text":"¡Jucpaj mana allita yarpashancunaga quiquinman chayachun!","poem":1},{"lineBreak":true},{"text":"Paycunaga gampa contrayquimi ricacusha.","poem":1},{"lineBreak":true},{"text":"Jitariyna fiyupa juchata rurashanpita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gamman yäracamojcuna ichanga cushicuchun.","poem":1},{"lineBreak":true},{"text":"Cushicuypita imay örapis cantachun.","poem":1},{"lineBreak":true},{"text":"Gammi paycunataga imapitapis chapaycanqui.","poem":1},{"lineBreak":true},{"text":"Gamta cuyashoj cajcunaga gampämi cushicun.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tayta Dios munashayquita rurajcunataga bindisyuntami gonqui.","poem":1},{"lineBreak":true},{"text":"Cuyapäcoj cashpayquimi chapacuna escüduno imapitapis chapanqui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}