{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":50,"content":[{"type":"heading","content":["Llapanta Tayta Dios jusgashan"]},{"type":"hebrew_subtitle","content":["Asaf isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Munayniyoj Tayta Diosninchïmi gayachisha cay pachacho tiyajcunataga","poem":1},{"lineBreak":true},{"text":"juc cantupita juc cantucama.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Cuyayllapaj Sión siudäpita-pachami","poem":1},{"lineBreak":true},{"text":"Tayta Diosga achicyaypa achicyaycan intëruman.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diosninchëga manami mana musyacayllachu shamonga.","poem":1},{"lineBreak":true},{"text":"Paypa ñaupantaga shamonga ima-aycatapis rupar ushacurcoj ninami.","poem":1},{"lineBreak":true},{"text":"Paypa intërun tumarejpana shamun fiyu wayra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayaycamurmi syëluta y cay pachata gayanga.","poem":1},{"lineBreak":true},{"text":"Chayno gayanga acrashan runacunata jusgaptin testïgu cananpämi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaymi syëluta y cay pachata nin:","poem":1},{"lineBreak":true},{"text":"«Mana cachaypa wiyacamajcunataga shuntamuy.","poem":1},{"lineBreak":true},{"text":"Uywancunata sacrifisyupaj pishtashpan nogawan conträtuta rurajcunatapis shuntamuy.»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Syëlucho cajcunami nin Diosga pï-maypäpis alli cashanta,","poem":1},{"lineBreak":true},{"text":"alli arriglaj juez cashanta. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Acrashä Israelcuna wiyamay.","poem":1},{"lineBreak":true},{"text":"Nogallami cä Diosga.","poem":1},{"lineBreak":true},{"text":"Nogami cä gamcunapa Diosniqui.","poem":1},{"lineBreak":true},{"text":"Cananga gamcunapa contrayquimi parlashaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Imatapis garamashayquipitachu,","poem":1},{"lineBreak":true},{"text":"imaypis uywacunata nogapaj rupachishayquipitachu manami piñacö.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Manami besëra-mallwacunatarächu munä.","poem":1},{"lineBreak":true},{"text":"Ni guenchayquicho caycaj chïbucunataräpischu ashë.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Llapan chucaru animalcunapis,","poem":1},{"lineBreak":true},{"text":"altu jircacunacho tiyaycaj wäcacunapis nogallapami.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nogallapami puntacunacho caycaj äbicunapis,","poem":1},{"lineBreak":true},{"text":"intëru jircacho caycaj animalcunapis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Munduga nogapami, llapan chaycho caycajcunapis.","poem":1},{"lineBreak":true},{"text":"Yargarpis manami gamtaga ‹garamay› nëmanchu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¿Nogaga törucunapa aychantachuraj sacsä?","poem":1},{"lineBreak":true},{"text":"¿Chïbucunapa yawarnintachuraj upö?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nogaga janaj pachacho caycaj Diosmi cä.","poem":1},{"lineBreak":true},{"text":"Nogaga mas munä llapan shonguyquipa agradësicamänayquitami;","poem":1},{"lineBreak":true},{"text":"aunimashayquita llapanta cumlimänayquitami.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ñacaycho caycashayqui öraga mañacamay.","poem":1},{"lineBreak":true},{"text":"Nogami jorgushayquipaj.","poem":1},{"lineBreak":true},{"text":"Gamnami agradësicamashpayqui alabamanquipaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Fiyu cajcunatami ichanga Tayta Dios nin:","poem":1},{"lineBreak":true},{"text":"«Gamcunaga ¿imanirtaj laynëcunapaj parlanqui?","poem":1},{"lineBreak":true},{"text":"Conträtuta rurashäpitapis manami parlayllapis parlarcunquimanchu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gamcunataga manami gustashunquichu noga piñacushä.","poem":1},{"lineBreak":true},{"text":"Imano ruranayquipaj nishätapis manami cumlinquichu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Suwacunatami alli jamachinqui.","poem":1},{"lineBreak":true},{"text":"Majayoj caycar jucwan cacojcunawan iwalmi goturpanqui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mana allita rimanayquipaj, llullacunayquipaj ichanga","poem":1},{"lineBreak":true},{"text":"shimiquipis cushishallaraj rimarcärin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chay wasillacho tiyaycarmi calumyanqui.","poem":1},{"lineBreak":true},{"text":"Chay wauguilla caycarpis paypa washanmi rimanqui.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Chayno llapanta ruraptiquipis upällami cacushcä.","poem":1},{"lineBreak":true},{"text":"¿Gamnölla cashätachu yarpashcanqui?","poem":1},{"lineBreak":true},{"text":"Chayno rurashayquipitaga piñacushayquimi.","poem":1},{"lineBreak":true},{"text":"Llapanpitami jusgashayqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Nogata mana yarpämajcuna, sumaj tantiyacuy.","poem":1},{"lineBreak":true},{"text":"Illajpitami gamcunataga ichic-ichicllaman rurarishayqui.","poem":1},{"lineBreak":true},{"text":"Chauraga manami pipis salbashunquipächu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nogata rispitamajcunaga imaypis agradësicamanmi.","poem":1},{"lineBreak":true},{"text":"Jucha rurayninta jaguirishpan Noga munashäta rurajcunataga salbashämi.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}