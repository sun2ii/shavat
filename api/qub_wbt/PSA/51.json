{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":51,"content":[{"type":"heading","content":["Juchanpita perdunananpaj mañacushan"]},{"type":"hebrew_subtitle","content":["David Betsabëwan juchata rurashanpita, profëta Natán piñacuptin cay alabansata David isquirbiran."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, gamga cuyapäcojmi canqui.","poem":1},{"lineBreak":true},{"text":"Cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Alli shongumi canqui.","poem":1},{"lineBreak":true},{"text":"Juchäcunata perdunaycamay ari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Mana allicunata rurashäpita mayllaycamay!","poem":1},{"lineBreak":true},{"text":"¡Llapan juchäpita limyuyaycachimay!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Musyämi contrayqui jatarishäta.","poem":1},{"lineBreak":true},{"text":"Juchäcunatapis yarpaycämi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gamta mana wiyacushpämi contrallayqui jatarishcä.","poem":1},{"lineBreak":true},{"text":"Ricaycämaptiquimi llutanta rurashcä.","poem":1},{"lineBreak":true},{"text":"«Juchasapa» nimar rasun cajtami niycämanqui.","poem":1},{"lineBreak":true},{"text":"Manami «Juchaynaj cä» nëmanchu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mamäpa pachancho cashäpita-pachami juchasapa caycä.","poem":1},{"lineBreak":true},{"text":"Yurishäpita-pachapis juchasapallami caycä.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaypis gamga cuyanqui rasun cajta rimaj cajtami.","poem":1},{"lineBreak":true},{"text":"Shongullächömi yachachimashcanqui yachaj canäpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Llapan juchäta pichaycuy ari.","poem":1},{"lineBreak":true},{"text":"Chauraga limyunami cashaj.","poem":1},{"lineBreak":true},{"text":"Mayllaycamay.","poem":1},{"lineBreak":true},{"text":"Chauraga rashtapitapis mas yurajnami ricacushaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cushicurcaycajta ricachimay ari.","poem":1},{"lineBreak":true},{"text":"Chauraga llaquicachimasha captiquipis yapaynami cushicushaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Juchata rurashäcunataga gongaycuyna.","poem":1},{"lineBreak":true},{"text":"Mana allita rurashäcunata ama yarpaynachu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Dios, shongöta rucaycachiy ari.","poem":1},{"lineBreak":true},{"text":"Unay cashäpita mas allina canäpaj yanapämay.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ama gargamaychu ñaupayquipitaga.","poem":1},{"lineBreak":true},{"text":"Ama apacuychu nogacho caycaj santo espirituyquitaga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Salbamashayquipita cushicaycachimay ari.","poem":1},{"lineBreak":true},{"text":"Cuyapäcoj cashpayqui yanapaycamay ari.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chaynöpami mana wiyacojcunata willapäshaj gamllata wiyacushunayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaura juchasapacunaga gam munashayquinöllana cawanga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tayta Dios, gammi salbamajnë canqui.","poem":1},{"lineBreak":true},{"text":"Wañuchicushäpita perdunaycamay ari.","poem":1},{"lineBreak":true},{"text":"Chauraga cantashpämi willacushaj gam alli cashayquita.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Dios yarpayta gomay ari gamta alabanäpaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gamga manami cushicunquichu imatapis garashushayquipita.","poem":1},{"lineBreak":true},{"text":"Chayta munaptiquega uywacunata rupachishpä gamta gararëmanmi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gampäga caycan umildi cajcunami y wiyacushoj cajcunami allinninta garashushayquino.","poem":1},{"lineBreak":true},{"text":"¡Tayta Dios, gamga manami manacajman churanquichu llapan shongunpa arpinticoj cajtaga!","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Cuyashpayquega Sión lömata alli ricay ari.","poem":1},{"lineBreak":true},{"text":"Jerusalenpa curralnincunata yapay jatarachiy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chaymi ichanga chasquinquipaj garashushayquita.","poem":1},{"lineBreak":true},{"text":"Altarniquichöpis rupachengapaj töru-mallwacunata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}