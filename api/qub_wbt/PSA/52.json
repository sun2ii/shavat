{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":52,"content":[{"type":"heading","content":["Fiyucuna alli-tucushan"]},{"type":"hebrew_subtitle","content":["Edom runa Doeg jutiyojmi ray Saulman aywaycur willaran: «David Ahimelecpa wasinman aywasha» nir. Chaypitami Davidga isquirbiran cay alabansata."]},{"type":"verse","number":1,"content":[{"text":"Munayniyoj fiyu runa, ¿imanirtaj cushicunqui mana allita rurashpayqui?","poem":1},{"lineBreak":true},{"text":"Chayno captiquipis Tayta Dios cuyacoj cashanga imaypis manami ushacangachu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mana allicunata rurayllatami yarparaycanqui.","poem":1},{"lineBreak":true},{"text":"Washa-rima cashpayquimi pï-maytapis llullapar goyanqui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alli goyänayquipa ruquin juchallatami ruranqui.","poem":1},{"lineBreak":true},{"text":"Rasun cajta rimanayquipa ruquin llullacuyllatami arunqui. Selah","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Llulla runa, gamga runa-masiquita manacajman churaycanqui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaypitami Diospis quiquiquita illgächishunquipaj.","poem":1},{"lineBreak":true},{"text":"Charircurmi wasiquipita jitarishunquipaj.","poem":1},{"lineBreak":true},{"text":"Mananami cawanquipänachu. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Diosta wiyacojcunaga chayta ricar fiyupami almiranga.","poem":1},{"lineBreak":true},{"text":"Dios castigashan runapäga asir nenga:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«Masqui ricay, Tayta Diosman mana yäracoj runata,","poem":1},{"lineBreak":true},{"text":"rïcu cayllanman yäracushpan mana allita rurajta.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nogami ichanga Tayta Diospa Wasincho caycä cawaj Olivo jachano.","poem":1},{"lineBreak":true},{"text":"Pay cuyacoj captin imaypis payllamanmi yäracushaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Dios, llapanta rurashayquipitami imaypis agradësicamushaj.","poem":1},{"lineBreak":true},{"text":"Gam alli cayniquipami wiyacushojcunawan iwal gamman yäracamushaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}