yanapaycämanquimi; cawaycächimanquirämi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gammi camacächinquipaj chiquimajcuna mana allita ruramashan quiquincunaman chayananpaj.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, chiquimajcunataga illgarachiy ari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Noganami llapan buluntänëpa ofrendata garashayqui.","poem":1},{"lineBreak":true},{"text":"Gam alli cashayquipita alabashayqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gamga llapan llaquicuypitami jorgamashcanqui.","poem":1},{"lineBreak":true},{"text":"Llapan chiquimajcuna mana alliman chayajtapis ricachimashcanquimi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}