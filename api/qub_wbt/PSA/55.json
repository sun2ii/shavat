]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fiyupa manchariychömi caycä.","poem":1},{"lineBreak":true},{"text":"Manchariyllawanmi sicsicyaycä.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaymi yarpachacur në: «Palumapano äläcuna canman.","poem":1},{"lineBreak":true},{"text":"Chauraga pärir aywacur jamaycömanrämi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pärir aywacöman fiyupa carumanmi.","poem":1},{"lineBreak":true},{"text":"Chunyaj chaqui jircachöna tiyacöman. Selah","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaychömi fiyu wayrapita, löcu tamyapita pacaräcöman.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tayta Dios, fiyucuna yarpashantaga pirdirachiy.","poem":1},{"lineBreak":true},{"text":"Rimaynincunatapis amana tantiyanacuchunchu.","poem":1},{"lineBreak":true},{"text":"Siudächöga caycan pillyallami, rimanacuyllami.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chacaypa junajpapis intëru siudäpami purircaycan.","poem":1},{"lineBreak":true},{"text":"Achäquillatami ashipänacurcaycan.","poem":1},{"lineBreak":true},{"text":"Llapanpis pirdicashanami carcaycan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Läsacunachöpis fiyupa mana allicunallatami rurarcaycan; llullapänacurcaycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Conträ achäquita ashipämaptenga awantacömanmi.","poem":1},{"lineBreak":true},{"text":"Chiquimaj conträ jatariptinpis gueshpicömanmi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ichanga gammi amïgö caycar, iwal purej caycaptinchi chayno ruramashcanqui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gamwanga amïgu cashpanchïmi Tayta Diospa Wasinmanpis iwal yaycoj canchi.","poem":1},{"lineBreak":true},{"text":"Gamwanga aypalla runacunachöpis iwalmi purej canchi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Chiquimajcunaga illajpita wañuchun!","poem":1},{"lineBreak":true},{"text":"¡Mana allillata rurashanpita cawaycajllatana pachapis micucurcuchun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nogami ichanga Tayta Diosta mañacushaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga salbamanga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Pagasta junajtapis wagashpä Tayta Diosta mañacushaj.","poem":1},{"lineBreak":true},{"text":"Payga llapan mañacushäta wiyamangami.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Pillyacunachöpis paymi chapämanga.","poem":1},{"lineBreak":true},{"text":"Aypalla chiquimajcunapitapis mana wañuchimänanpämi salbamanga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Paycunaga mana allita rurarcaycashanta manami cachanchu.","poem":1},{"lineBreak":true},{"text":"Tayta Diostapis manami manchacunchu.","poem":1},{"lineBreak":true},{"text":"Imaycamapis mandaj Tayta Diosga mañacushäta wiyamar paycunata pengacachengami. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Paycunaga amïguncunatapis magan.","poem":1},{"lineBreak":true},{"text":"Alli cananpaj parlashanta manami cumlinchu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Paycunaga mishquillami parlan.","poem":1},{"lineBreak":true},{"text":"Shongunchöga wañuchicuyllatami yarparcaycan.","poem":1},{"lineBreak":true},{"text":"Mishquichipayllapa parlarpis","poem":1},{"lineBreak":true},{"text":"ashllicuyllatami yachan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yarpachacaycächishushayquitaga Tayta Diospa maquinman cachaycuy.","poem":1},{"lineBreak":true},{"text":"Paymi yanapäshunquipaj.","poem":1},{"lineBreak":true},{"text":"Wiyacojcunataga Tayta Dios manami cachaycongapächu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tayta Dios, wañuchicojcunawan llullacunaga pöcu timpulla cawachun.","poem":1},{"lineBreak":true},{"text":"Amana chayachunnachu pullallanmanpis cawananpaj cajmanga.","poem":1},{"lineBreak":true},{"text":"Gam camacaycachiy paycuna illajpita wañunanpaj.","poem":1},{"lineBreak":true},{"text":"Nogami ichanga gamllaman yäracamö.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}