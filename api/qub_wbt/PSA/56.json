{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":56,"content":[{"type":"heading","content":["Tayta Diosman yäracur mañacushan"]},{"type":"hebrew_subtitle","content":["Gat particho Filistea runacuna Davidta prësu charishanpita, David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Runacunami gaticachaycäman.","poem":1},{"lineBreak":true},{"text":"Imay örapis magaycäman, ñacaycächiman.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chiquimajcunaga imay örapis gaticachaycämanmi.","poem":1},{"lineBreak":true},{"text":"Alli-tucojcunaga achcajmi magarcaycäman.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios, manchacushpäga gammanmi yäracamö.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tayta Diosllamanmi yäracö.","poem":1},{"lineBreak":true},{"text":"Aunimashanman yäracurmi payta alabä.","poem":1},{"lineBreak":true},{"text":"Chaymi mana manchacöpischu.","poem":1},{"lineBreak":true},{"text":"¿Imataräshi ruramanman runallaga?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Imay örapis nanächipaycämanmi.","poem":1},{"lineBreak":true},{"text":"Mana allita ruramayllatami yarparcaycanpis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wañuchimänanpämi michipaycäman.","poem":1},{"lineBreak":true},{"text":"Maypa purishallätapis ricapaycäman.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Dios, chiquimajcunataga rabyacurcur pengayman churay.","poem":1},{"lineBreak":true},{"text":"Castigänitaga ama cachaycuychu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ayca cuti gueshpishallätapis gamga musyaycanquimi.","poem":1},{"lineBreak":true},{"text":"Ayca cuti wagashallätapis gamga ricamashcanquimi.","poem":1},{"lineBreak":true},{"text":"Chaycunataga gammi libruyquicho apuntaraycächinqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yanapämänayquipaj mañacamuptë chiquimajcuna pillyaj shaycämushanchöpis cuticongami.","poem":1},{"lineBreak":true},{"text":"Rasunpami musyä faburnë caycashayquita.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Diosmanmi yäracö.","poem":1},{"lineBreak":true},{"text":"Aunimashanman yäracurmi payta alabä.","poem":1},{"lineBreak":true},{"text":"Taytallämanmi yäracö.","poem":1},{"lineBreak":true},{"text":"Aunimashanman yäracurmi paytaga alabä.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chaymi mana manchacöpischu.","poem":1},{"lineBreak":true},{"text":"¿Imataräshi ruramanman runallaga?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tayta Dios, aunishäcunataga cumlishayquimi.","poem":1},{"lineBreak":true},{"text":"Altarniquipa ñaupanchömi agradësicushayqui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gamga salbamashcanqui wañunäpitami.","poem":1},{"lineBreak":true},{"text":"Mana alliman chayanäpitapis jorgamashcanquimi","poem":1},{"lineBreak":true},{"text":"gam nimashayquita cumlir cawanäpaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami achicyajchöno ñaupayquicho goyäshaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}