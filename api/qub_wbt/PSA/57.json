{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":57,"content":[{"type":"heading","content":["Chiquejcunapita salbananpaj mañacushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa. Saulpita gueshpir aywar chunyaj machayman pacacushanta yarpärirmi isquirbiran."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Gamman pacacaycämuptëga cuyapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Mana allicuna päsanancamami älayqui rurinman pacacuyta munä.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Syëlucho caycaj Tayta Dios imaypis yanapämaptiquimi gamta mañacamö.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cuyapäcoj cashpayqui syëlupita-pacha yanapämay ari.","poem":1},{"lineBreak":true},{"text":"Chiquimajcunapita salbaycamay ari. Selah","poem":1},{"lineBreak":true},{"text":"Yanapaycamay ari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nogaga runa micoj liyuncunapa chaupincho caycajnömi caycä.","poem":1},{"lineBreak":true},{"text":"Liyuncunapa quiruncunanömi caycan lëchancuna, tucsicunancuna.","poem":1},{"lineBreak":true},{"text":"Gallunnömi caycan afilasha sablincunaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tayta Dios, gamga janaj syëluchöpis llapanpämi munayniyoj caycanqui.","poem":1},{"lineBreak":true},{"text":"Cay pachapis intërumi munaynillayquicho caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Chiquimajcunaga purinäman togllata churasha.","poem":1},{"lineBreak":true},{"text":"Chaura nogaga fiyupa mancharishcä.","poem":1},{"lineBreak":true},{"text":"Purinächo uchcuta uchcuran yaganäpaj.","poem":1},{"lineBreak":true},{"text":"Chay uchcuman quiquincunallami yagasha. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tayta Dios, shongöga ashac-ashacllami caycan.","poem":1},{"lineBreak":true},{"text":"Gamta imnucunawan alabashayqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ricchariy ari shongullä.","poem":1},{"lineBreak":true},{"text":"Gampis arpa ricchay ari.","poem":1},{"lineBreak":true},{"text":"Arpa-mallwapis ricchay ari.","poem":1},{"lineBreak":true},{"text":"Intitapis ricchachishänami.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Dios, llapan runacunapa ñaupanchömi alabashayqui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Dios, cuyacoj cashayquega syëlucamami chayan.","poem":1},{"lineBreak":true},{"text":"Alli cumlej cashayquipis asulyaraycaj pachacamami chayan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tayta Dios, gamga janaj syëluchöpis llapanpämi munayniyoj caycanqui.","poem":1},{"lineBreak":true},{"text":"Cay pachapis intërumi munaynillayquicho caycan.","poem":1}]}],"footnotes"