{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":58,"content":[{"type":"heading","content":["Alli arriglananpaj Tayta Diosta mañacushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Munayniyojcuna, ¿rasunpachu alli cajta rurarcaycanqui?","poem":1},{"lineBreak":true},{"text":"¿Allichu arreglaycanqui runacunata?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Manami. Mana allita rurayllatami yarparcaycanqui.","poem":1},{"lineBreak":true},{"text":"Chayno rurarmi gamcunaga caminuta goycanqui cay pachacho runacuna chiquinacunanpaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fiyu runacunaga manaräpis yurillarnami fiyu.","poem":1},{"lineBreak":true},{"text":"Mamanpa pachancho caycällarnami llulla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chay runacunaga benënuyoj culebranömi carcaycan,","poem":1},{"lineBreak":true},{"text":"rinriynaj culebra mana wiyajnömi,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"majiquërucuna upayächinanpaj tucapaptinpis mana wiyajnömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tayta Dios, ¡quiruncunatapis amirgäriy!","poem":1},{"lineBreak":true},{"text":"Tayta Dios, ¡chay liyuncunapa agärancunata paquirgäriy!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Guemarisha yacu chaquejnöpis illgacäcuchun.","poem":1},{"lineBreak":true},{"text":"Näni cantuncunacho guewa chaquejnöpis illgacäcuchun.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rashta chullojnöpis illgacäcuchun.","poem":1},{"lineBreak":true},{"text":"Achicyaj pachata shullu mana ricashanno quëdachun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Cashatanöpis ruparachichun manaräpis cuentata gocuptin.","poem":1},{"lineBreak":true},{"text":"Jachata achurishanno illgarachichun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tayta Diosta wiyacojcunaga cushicongami chiquejcunata wañushata ricashpan.","poem":1},{"lineBreak":true},{"text":"¡Chaquincunatapis fiyucunapa yawarninwanrämi mayllanga!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chayrämi llapanpis nenga: «¡Tayta Diosta wiyacuymi alliga!","poem":1},{"lineBreak":true},{"text":"¡Cay pachacho canmi Dios llapanta jusgananpaj!» nir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}