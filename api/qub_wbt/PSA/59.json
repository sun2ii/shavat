{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":59,"content":[{"type":"heading","content":["Tayta Diosga imapitapis chapämajninchïmi"]},{"type":"hebrew_subtitle","content":["Davidpa wasinman Saúl cacharan Davidpa wasinta täpananpaj; tutanninna wañuchinanpaj. Chayno cashanpitami David isquirbiran cay alabansata."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, chiquimajcunapita salbaycamay ari.","poem":1},{"lineBreak":true},{"text":"Ñacachimajcunapita jorgaycamay ari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fiyu runacunapita salbaycamay ari.","poem":1},{"lineBreak":true},{"text":"Wañuchicojcunapita gueshpiycachimay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios, munayniyoj runacunami wañuchimänanpaj shuyarpaycäman.","poem":1},{"lineBreak":true},{"text":"Nogaga manami ima juchatapis rurashcächu. Llapantapis wiyacushcämi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nogaga allillatami rurashcä.","poem":1},{"lineBreak":true},{"text":"Imatapis mana ruraycaptëmi wañuchimänanpaj juracuycan.","poem":1},{"lineBreak":true},{"text":"¡Apuray! ¡Yanapämay!","poem":1},{"lineBreak":true},{"text":"¡Masqui ricäramay imano caycashätapis!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Dios, gammi munayniyoj Dios canqui.","poem":1},{"lineBreak":true},{"text":"Gammi Israelcunapa Diosnin canqui.","poem":1},{"lineBreak":true},{"text":"Riccharcur castigay ari mana rispitashojcunataga.","poem":1},{"lineBreak":true},{"text":"Ama cuyapaychu fiyu runacunataga. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Chacaypami cutimun wagyaj allgunöpis gaparpaycar.","poem":1},{"lineBreak":true},{"text":"Siudätapis tumarcaycan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Shimin tarishantami rimarcaycan.","poem":1},{"lineBreak":true},{"text":"Pipis mana wiyashanta yarparmi","poem":1},{"lineBreak":true},{"text":"pï-maytapis ashllin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios, paycunapitaga gam asicunquimi.","poem":1},{"lineBreak":true},{"text":"Mana rispitashojcunataga asipanquimi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nogami ichanga gamman yäracamö.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, gammi canqui chapämajnë.","poem":1},{"lineBreak":true},{"text":"Gammi canqui pacacunä.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Dios gamga cuyamanquimi.","poem":1},{"lineBreak":true},{"text":"Chaymi shamunqui yanapämänayquipaj.","poem":1},{"lineBreak":true},{"text":"Yanapämaptiquimi llapan chiquimajcunataga binsishatana ricashaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ichanga mana wañuchiyllapa ñacachiy marca-masëcuna imaycamapis yarparänanpaj.","poem":1},{"lineBreak":true},{"text":"Paycunataga munayniquiwan wacpa-caypa mashtacächishpayqui manacajman churay ari.","poem":1},{"lineBreak":true},{"text":"Tayta Dios gammi imapitapis nogacunataga chapämanqui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Llapan rimashanchöpis juchallatami rimarcaycan.","poem":1},{"lineBreak":true},{"text":"Quiquincuna runa-tucushanpita,","poem":1},{"lineBreak":true},{"text":"manacajcunata jurashanpita mana alliman chayaycuchun ari.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rabyacurcushpayqui chipyaj illgarachiy.","poem":1},{"lineBreak":true},{"text":"Intëruchöpis musyacächun gam Tayta Dioslla Israel runacunachöga ray cashayqui ari. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Chacaypaga cutimun wagyaj allgunöpis gaparpaycar.","poem":1},{"lineBreak":true},{"text":"Siudäta tumarcaycan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Paycunaga micuyta ashishpanmi purenga.","poem":1},{"lineBreak":true},{"text":"Sacsananyaj micuyta mana taricuycorga gaparpanga allgu aullajnörämi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nogami ichanga cada tuta gamta alabashpä cantashaj.","poem":1},{"lineBreak":true},{"text":"Munayniyoj cuyacoj cashayquitami willacushaj sinchi gaparayparaj.","poem":1},{"lineBreak":true},{"text":"Gammi cashcanqui imapitapis chapämaj;","poem":1},{"lineBreak":true},{"text":"llaquicur ñacaycashä öra pacacunä.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Dios gamtami alabashayqui.","poem":1},{"lineBreak":true},{"text":"Gammi canqui chapämaj pacacunä.","poem":1},{"lineBreak":true},{"text":"¡Gammi canqui cuyamaj Diosnë!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}