¡Aywaycamuy ari Tayta Dios, salbamänayquipaj!","poem":1},{"lineBreak":true},{"text":"¡Cuyapäcoj cashpayqui salbaycamay ari!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wañojcunaga manami pipis yarpäshunquinachu.","poem":1},{"lineBreak":true},{"text":"¿Piraj alabashunquiman pamparashan allpapitaga?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Atarpis pasaypanami uticashcä.","poem":1},{"lineBreak":true},{"text":"Waray waraymi amatar wagä.","poem":1},{"lineBreak":true},{"text":"Jawanätapis wagaycaptillämi weguë ushmasha.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wagaycaptillänami ñawëpis chacaycan.","poem":1},{"lineBreak":true},{"text":"Chiquicuna chiquimaptin wagaycällarnami ushacaycäpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¡Lädöpitapis witicuyna mana allita rurajcuna!","poem":1},{"lineBreak":true},{"text":"Tayta Diosga wiyashanami fiyupa wagashäta.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Diosga wiyashanami ruwacushäta.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga chasquimashanami mañacushäta.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chiquimajcunaga manchariyllawan manami ima ruraytapis camäpacongachu.","poem":1},{"lineBreak":true},{"text":"Illajpitami pengay-tucusha gueshpir aywaconga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}