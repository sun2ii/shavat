{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":60,"content":[{"type":"heading","content":["Yanapänanpaj Tayta Diosta mañacushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa. Davidmi pillyaran Naharaimcho tiyajcunawan, Sobacho tiyajcunawan. Chay runacunaga caran Aram runacuna. Chaypita cutiycämushancho Joab binsiran chunca ishcaynin waranga Edom runacunata «Cachi» guechwacho."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, rabyashpayquimi gongaycamashpayqui jitarimarayqui.","poem":1},{"lineBreak":true},{"text":"¡Cananga yapayna yanapaycamay ari!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gammi camacächishcanqui pacha sicsicyar quichacäcunanpaj.","poem":1},{"lineBreak":true},{"text":"Cananga chay quichacasha caycajcunata wichgacächiyna.","poem":1},{"lineBreak":true},{"text":"¡Pachaga pasaypami gotucaycan!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nogacunataga ñacaymanmi chayachimashcanqui.","poem":1},{"lineBreak":true},{"text":"Castïgu bïnuta upuchimashayquipitami ñacaycäcuna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gamta rispitashoj cajcunataga musyaycachiy ari","poem":1},{"lineBreak":true},{"text":"lëchawan wañunanpita gueshpicunanpaj. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¡Cananga munayniquiwan salbaycamay ari!","poem":1},{"lineBreak":true},{"text":"¡Cuyashayqui runacunata salbaycuy ari!","poem":1},{"lineBreak":true},{"text":"¡Wiyaycamay ari!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Dios Templuyquicho caycar aunimarmi nirayqui:","poem":1},{"lineBreak":true},{"text":"«¡Ima cushisharaj acrashäcunata raquipäshaj Shequemta!","poem":1},{"lineBreak":true},{"text":"¡Ima cushisharaj partipäshaj Sucot guechwatapis!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Galaadwan Manasesga nogapami.","poem":1},{"lineBreak":true},{"text":"Efrainga acrashä runacunata chapänanpaj caycan pillyacho chapämaj fyërru cascönömi.","poem":1},{"lineBreak":true},{"text":"Judäga caycan acrashä runacunata mandananpaj ray tiyananmi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moabga sirbimänanpaj carmi mayllacunä labaturyuno.","poem":1},{"lineBreak":true},{"text":"Edomnami llanguëta purichej uywaynëno canga.","poem":1},{"lineBreak":true},{"text":"¡Filistea runacunata binsiycurnami cushicuypita gaparäshaj!» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ichanga ¿piraj pushamanman intërunpa curalasha caycaj siudäman?","poem":1},{"lineBreak":true},{"text":"¿Piraj pushamanman Edomcama?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Dios gamga nogacunapita witicurishcanquinami.","poem":1},{"lineBreak":true},{"text":"¡Cananga mananami suldäröcunawanpis aywanquinachu!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yanapämay ari chiquimajcunata binsinäpaj.","poem":1},{"lineBreak":true},{"text":"Runa yanapämashanga yangallami.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tayta Dios yanapämashaga binsishunmi.","poem":1},{"lineBreak":true},{"text":"¡Chiquimajninchïcunatapis paymi lluchcargärenga!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}