,"poem":1},{"lineBreak":true},{"text":"Janan shongullami alli parlapämanqui;","poem":1},{"lineBreak":true},{"text":"shonguyquicho ichanga chiquiycämanqui. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tayta Diosllami alli goyächiman.","poem":1},{"lineBreak":true},{"text":"Payllamanmi nogaga yäracö.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Payllami salbaman y chapäman.","poem":1},{"lineBreak":true},{"text":"Pay pacacunä captinmi ima mana allimanpis mana chayashächu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Diosllami salbamajnëga.","poem":1},{"lineBreak":true},{"text":"Paymi munayniyoj cayman churaman.","poem":1},{"lineBreak":true},{"text":"Paymi chapacunä.","poem":1},{"lineBreak":true},{"text":"Tayta Diosllami pacacunä.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Marca-masëcuna payllaman yäracuyga ari.","poem":1},{"lineBreak":true},{"text":"Mana manchacuypa willapay mañacushayqui öra.","poem":1},{"lineBreak":true},{"text":"¡Tayta Diosmi pacacunanchëga! Selah","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Runacunaga ricayllanmi caycan.","poem":1},{"lineBreak":true},{"text":"Llullacuynöpis yangallami caycan.","poem":1},{"lineBreak":true},{"text":"Llapanta jucllacharcur balansacho pësaptin manami ni aycapis lasanmanchu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mana allita rurashayquicunamanga ama yäracuychu.","poem":1},{"lineBreak":true},{"text":"¡Runapa ima-aycantapis guechushpayqui ama alabacuychu!","poem":1},{"lineBreak":true},{"text":"Rïcuyashpayqui guellayniquimanga ama yäracuychu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yaparir yaparirmi wiyashcä Tayta Diospaj parlajta.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Payllami munayniyoj y cuyacöga.","poem":1},{"lineBr