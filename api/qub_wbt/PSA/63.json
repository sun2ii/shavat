unä.","poem":1},{"lineBreak":true},{"text":"Cantashpämi alabashayqui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cawashäyäga alabaycäshayquimi.","poem":1},{"lineBreak":true},{"text":"Mañacushpäpis gamllamanmi maquëta jogarimushaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fiyupami cushicushaj mishquej micuyta micushanöraj.","poem":1},{"lineBreak":true},{"text":"Cushicushpä gamtami alabashayquipis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Chacaypa cämächo weguraycashä örapis gamllapämi yarpä.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gammi yanapämanqui.","poem":1},{"lineBreak":true},{"text":"¡Gam älayqui rurincho chapämaptiquimi cushisha cawä!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cawashäcamaga gam munashallayquitami ruraycä.","poem":1},{"lineBreak":true},{"text":"Derëchu caj maquiquega manami cacharimanchu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wañuchiyta munamajcunaga quiquincunami sepultüraman chayanga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paycunaga wañonga sabliwan tucsiypami.","poem":1},{"lineBreak":true},{"text":"Chaytanami atojcunapis miconga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Raymi ichanga cushicongapaj Tayta Dios yanapashanpita.","poem":1},{"lineBreak":true},{"text":"Tayta Diospa jutincho juraj cajcunaga alabashpanmi cantanga.","poem":1},{"lineBreak":true},{"text":"Llullacojcunatami ichanga shimintapis chaparconga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}