{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":64,"content":[{"type":"heading","content":["Chapänanpaj Diosta mañacushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, llaquicur mañacamushäta wiyaycamay ari.","poem":1},{"lineBreak":true},{"text":"Chiquimajcunapita chapaycamay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fiyucuna yarpapaycämashanpita pacaycamay.","poem":1},{"lineBreak":true},{"text":"Shuntacarcur fiyu runacuna parlacushanpita chapaycamay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paycuna parlashanga fïnu sabli nanächicushannörämi nanächicunpis.","poem":1},{"lineBreak":true},{"text":"Paycuna parlashanga benënuyoj lëchanömi nanächicunpis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pacaraycashallanpitami juchaynaj runataga lëchanwan illapan.","poem":1},{"lineBreak":true},{"text":"Mana pitapis manchacuypami illajpita chayachin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quiquin-purami parlacur shacyächinacun mana allita rurananpaj.","poem":1},{"lineBreak":true},{"text":"Pitapis togllata churapänanpaj parlacun.","poem":1},{"lineBreak":true},{"text":"Paycunaga yarpan pipis mana ricashantami,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"mana alli rurashancunata pipis mana taripänantami.","poem":1},{"lineBreak":true},{"text":"¡Runacuna yarpashanga tantiyaytapis mana atipaypämi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ichanga paycunata Tayta Diosmi lëchanwan illaparenga.","poem":1},{"lineBreak":true},{"text":"Illajpitami mana alliman chayachenga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quiquincuna rimashanpitami mana allimanpis chayanga.","poem":1},{"lineBreak":true},{"text":"Chayno caycajta ricajcunaga paycunata asipangami.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chayrämi Tayta Diosta llapan rispitanga.","poem":1},{"lineBreak":true},{"text":"Tayta Dios imata rurashancunatapis willaconga.","poem":1},{"lineBreak":true},{"text":"Tantiyaconga Tayta Dioslla llapantapis camacächishanta.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alli runaga cushicongami Tayta Dios chayno rurashanpita.","poem":1},{"lineBreak":true},{"text":"Juchaynajcunaga Pay chapänanpaj yäracongami y alabangami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}