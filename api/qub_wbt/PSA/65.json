eBreak":true},{"text":"¡Chaychöga gam tarichimashayquiwan sacsashami goyashäcuna!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nogacunata salbamaj Tayta Diosnë, mañacamushäta wiyamashpayqui","poem":1},{"lineBreak":true},{"text":"fiyupa allicunata rurarmi yanapaycämanqui.","poem":1},{"lineBreak":true},{"text":"Gammanmi yäracamun llapan nasyuncho tiyajcuna,","poem":1},{"lineBreak":true},{"text":"may caru lamarpita mas carucho tiyajcunapis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gammi munayniquiwan callpayquiwan sumaj tacyaraycächinqui llapan jircacunata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gammi chawächinqui lamar yacu wayrawan gaparar pullchajyaycajta,","poem":1},{"lineBreak":true},{"text":"runacuna shanaypa shanar gaparpaycajtapis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cay pachacho tiyajcuna may carucho carpis almiraypajta rurashayquita ricar fiyupami almirasha.","poem":1},{"lineBreak":true},{"text":"Pachapa jucaj cuchunpita jucaj cuchuncamami runacunaga cushicurcaycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gammi ricaycanqui cay pachataga.","poem":1},{"lineBreak":true},{"text":"Tamyachimunqui.","poem":1},{"lineBreak":true},{"text":"Micuycunatapis wayuchinqui.","poem":1},{"lineBreak":true},{"text":"Gammi rïgutapis pargunqui achca mayu yacu aywajcunawan.","poem":1},{"lineBreak":true},{"text":"Chaynömi chacrataga camarinqui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Cay pachacho caj ragracunaman gammi yacuta juntachinqui.","poem":1},{"lineBreak":true},{"text":"Chacrapa llapan curpancunatapis ñuchuchinqui.","poem":1},{"lineBreak":true},{"text":"Allpacunatapis tamyawan ömichinqui.","poem":1},{"lineBreak":true},{"text":"Bindisyunniquiwanmi llapanpis alli wayun.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gampa bindisyunniquiwanmi watapis watacharcun.","poem":1},{"lineBreak":true},{"text":"Maypapis tamyachishallayquipami micuypis alli wayun.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chunyaj chaqui jircacho caj guewacunapis berdiypa berdiycanmi.","poem":1},{"lineBreak":true},{"text":"Puntacunapis cuyayllapämi caycan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Intëru pampacunachömi uywacunapis juntasha caycan.","poem":1},{"lineBreak":true},{"text":"Guechwa pampapanami rïgucuna juntaraycan.","poem":1},{"lineBreak":true},{"text":"¡Llapanmi cushicuypita cantashpan gaparpaycan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}