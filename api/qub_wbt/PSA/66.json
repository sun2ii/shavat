{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":66,"content":[{"type":"heading","content":["Tayta Dios rurashanpita alabansa"]},{"type":"hebrew_subtitle","content":["Cantay yachaj isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Cay pachacho tiyajcunaga llapan cushicur Tayta Diosta alabachun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Diostaga alabay-llapa.","poem":1},{"lineBreak":true},{"text":"Paytaga munayniyoj cashanpita alabay-llapa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diospaj cantar cayno niy:","poem":1},{"lineBreak":true},{"text":"«Rurashayquega llapanpis fiyupa allimi.","poem":1},{"lineBreak":true},{"text":"Fiyupa munayniyoj captiquimi","poem":1},{"lineBreak":true},{"text":"chiquishojcunapis mancharisha ñaupayquiman gongurpacamun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cay pachacho tiyajcunaga llapanmi adurashunqui.","poem":1},{"lineBreak":true},{"text":"Alabansacunawanpis alabashunquimi.» Selah","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Dios rurashanta ricaj shamuy-llapa,","poem":1},{"lineBreak":true},{"text":"Runapaj fiyupa allita rurashanta ricay-llapa:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lamartami ticrarachiran chaqui allpaman.","poem":1},{"lineBreak":true},{"text":"Unay awilunchïcunaga mayutapis päsaran chaqui pampapa aywaycajnöllami.","poem":1},{"lineBreak":true},{"text":"¡Tayta Diosninchïta alabar cushicushun ari!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Munayniyoj cayninwanmi imaycamapis mandanga.","poem":1},{"lineBreak":true},{"text":"Imano cashantapis intëru nasyuntami ricapaycan.","poem":1},{"lineBreak":true},{"text":"Chaura mana wiyacojcunaga paypa contran ama jatarichunchu. Selah","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Llapan runacuna Tayta Diosninchïta alabay!","poem":1},{"lineBreak":true},{"text":"¡Payta alabar alabansacunata cantay!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Paymi canancamapis cawaycächimanchi.","poem":1},{"lineBreak":true},{"text":"Manami ima mana allimanpis chayachimanchïrächu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Guellayta runa chulluchiptin ganran llojshishannömi","poem":1},{"lineBreak":true},{"text":"yäracushäta mana yäracushätapis musyapämashcanqui Tayta Dios.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gammi togllawan tunichimashcanqui.","poem":1},{"lineBreak":true},{"text":"Fiyupa lasajtami apachimashcanqui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gammi camacächishcanqui manacajcunallapis manacajman churamänanpaj.","poem":1},{"lineBreak":true},{"text":"Chayasha mayuman yagajnömi, ninacho rupajnömi","poem":1},{"lineBreak":true},{"text":"fiyupa mana allicunaman chayachimashcanqui.","poem":1},{"lineBreak":true},{"text":"Chaypitarämi ima-aycapis cananpaj yanapämashcanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wasiquiman yaycuycurmi gampaj uywacunata rupachishaj.","poem":1},{"lineBreak":true},{"text":"Chaychömi cumlishayqui","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"fiyupa ñacaycho caycashpä aunishäta.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gampämi rupachishaj sëbasha uywacunapa aychanta.","poem":1},{"lineBreak":true},{"text":"Uyshacunatami pishtashaj.","poem":1},{"lineBreak":true},{"text":"Törucunata, chïbucunatami garashayqui. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"¡Tayta Diosta manchacoj cäga llapaniqui shamuy!","poem":1},{"lineBreak":true},{"text":"¡Nogapaj imata rurashantapis willapäshayqui!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nogaga Tayta Diostami mañacurä.","poem":1},{"lineBreak":true},{"text":"Nircorga alabansacunata cantarä.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mana allita yarpashpä mañacuptëga Tayta Dios manami wiyamanmanchu caran.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¡Payga wiyamashpanmi llapan mañacushäta yanapämasha!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Alabasha cachun Tayta Diosga.","poem":1},{"lineBreak":true},{"text":"Payga mañacushäta wiyashami.","poem":1},{"lineBreak":true},{"text":"Cuyamashantapis musyachimashami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}