lineBreak":true},{"text":"Tayta Diosta alabay-llapa.","poem":1},{"lineBreak":true},{"text":"Imnucunawan payta alabay-llapa.","poem":1},{"lineBreak":true},{"text":"Alabay-llapa pucutay janancho aywajta.","poem":1},{"lineBreak":true},{"text":"Paypa jutenga Tayta Diosmi.","poem":1},{"lineBreak":true},{"text":"Paypa ñaupanchöga cushicuy-llapa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rispitädu Wasincho tiyaj Tayta Diosga wacchacunapa papäninmi,","poem":1},{"lineBreak":true},{"text":"imapitapis biyüdacunata chapajmi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Famillyaynajcunataga Tayta Dios yanapanmi juc pachacho tiyananpaj.","poem":1},{"lineBreak":true},{"text":"Prësu caycajcunata jorgunmi. Nircur alliman churan.","poem":1},{"lineBreak":true},{"text":"Mana wiyacoj fiyucunami ichanga chunyaj chaqui particho tiyanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tayta Dios, acrashayqui runacunapa ñaupanta chunyajpa shamuptiqui Selah","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"cay pachapis sicsicyaran.","poem":1},{"lineBreak":true},{"text":"Tamyapis tamyamuran.","poem":1},{"lineBreak":true},{"text":"Israelcunapa Tayta Diosnin, ñaupayquichöga Sinaí jircapis sicsicyaranmi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Dios, gammi tamyata alli tamyachimurayqui.","poem":1},{"lineBreak":true},{"text":"Acrashayqui chacrataga gammi allchacächirayqui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chay partichönami acrashayqui runacuna tiyacaycärisha.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, chaychöga alli cayniquipami, pishipacushan cajta pobrita llapanta camariparayqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tayta Dios, willapata willacachiran.","poem":1},{"lineBreak":true},{"text":"Chaytanami achcaj warmicuna willacuran cayno:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"«¡Raycunaga suldäruncunawan gueshpirmi aywacurcaycan!» nir.","poem":1},{"lineBreak":true},{"text":"Wasichönami warmicuna raquipänacurcaycaran guërracho contrancunata guechumushancunata:","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"goripita cajcunata, guellaypita cajcunata.","poem":1},{"lineBreak":true},{"text":"Waquin Israelcuna ichanga uywacunapa chaupinman pacacuran.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tayta Dios, munayniyoj raycunata gaticachashan öra","poem":1},{"lineBreak":true},{"text":"gueshpejcunaga ricacuran Salmón puntaman rashta rashtaycajnömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Fiyupa altumi Basán jircacunaga.","poem":1},{"lineBreak":true},{"text":"Puntancunaga fiyupa altumi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Altu jircacuna, puntacuna","poem":1},{"lineBreak":true},{"text":"¿imanirtaj chiquir ricapanqui Tayta Dios tiyashan Sión lömata?","poem":1},{"lineBreak":true},{"text":"¡Chaychömi Tayta Diosga imay-yajpis tiyanga!","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tayta Diospa pillyapaj carrëtancunaga millunninpami.","poem":1},{"lineBreak":true},{"text":"Chay carrëtancunawanmi Tayta Diosga Sinaí jircapita shamusha Sioncho caycaj Wasinman.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tayta Dios, prësucunata apacurcurmi janajman aywacushcanqui.","poem":1},{"lineBreak":true},{"text":"Runacunanami garayniquita apapämusha-cashunqui.","poem":1},{"lineBreak":true},{"text":"Mana wiyacojcunapis garayniquita apapämushurayquimi.","poem":1},{"lineBreak":true},{"text":"Chaynöpami Tayta Diosga paycunawan iwal tiyanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Alabasha cachun Salbacoj Tayta Diosninchëga.","poem":1},{"lineBreak":true},{"text":"Paymi waran-waran yanapämanchi. Selah","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Diosninchëga imapitapis salbacoj Diosmi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga wañunanchïpaj caycajtapis salbamashwanmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Diosga chiquejcunapa umanta llapirengami.","poem":1},{"lineBreak":true},{"text":"Juchallancho cawajcunapa ajchasapa umantapis ishcaymanmi rurarenga.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tayta Diosmi nisha: «Basán puntapitapis cutichimushayquimi.","poem":1},{"lineBreak":true},{"text":"Lamar yacu rurinpitapis jorgamushayquimi","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"chaquiquicunatapis chiquinacushayquipa yawarninwan pucaypa pucachinayquipaj,","poem":1},{"lineBreak":true},{"text":"allguyquicunapis chay yawarta lajwananpaj» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Masqui ricay, Tayta Diosnëmi wasinman yaycuycan.","poem":1},{"lineBreak":true},{"text":"Rusyunchönömi raynëpa guepanta gatinaylla aywarcaycan.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Cantajcunami ñaupa-puntata aywarcaycan, guepantanami tucajcuna.","poem":1},{"lineBreak":true},{"text":"Chaupintana aywarcaycan jipashcuna panderëtacunata tucaraycar.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"¡Gamcunaga llapaniqui Tayta Diosta alabay!","poem":1},{"lineBreak":true},{"text":"¡Israel cajcunaga llapayqui shuntacaycur Tayta Diosta alabay!","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Llapanpa shullcan Benjaminpita mirajcunami ñaupa-puntata aywarcaycan,","poem":1},{"lineBreak":true},{"text":"Judäpita, Zabulonpita Neftalïpita mirar aywajpa mandajnincunawan iwal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Tayta Dios, munayniyoj cashayquita musyachicuy.","poem":1},{"lineBreak":true},{"text":"¡Ñaupata yanapämashayquino llapan ricananpaj yanapämay!","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Jerusalencho Templuyquimanmi","poem":1},{"lineBreak":true},{"text":"raycuna garaynincunata apamonga.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ututucunacho tiyaj animalta piñacuy.","poem":1},{"lineBreak":true},{"text":"Piñacuy röpanpa röpanpa purej fiyu törucunata, besëracunata.","poem":1},{"lineBreak":true},{"text":"Manacajman churay rïcuyayllapaj wañojcunataga.","poem":1},{"lineBreak":true},{"text":"Wacpa caypa mashtaypa mashtariy pillyata ashejcunataga.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Egiptupitami shamonga faraonpa cachancuna.","poem":1},{"lineBreak":true},{"text":"Etiopiacunami Tayta Diosta alabanga.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Cay pachacho mandajcunaga Tayta Diosta alabay.","poem":1},{"lineBreak":true},{"text":"Alabansacunawan Tayta Diosta alabay. Selah","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tayta Diosga syëlupami purin.","poem":1},{"lineBreak":true},{"text":"Masqui wiyay-llapa munayniyoj busnin imano wiyacämushantapis.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"«Fiyupa munayniyojmi Tayta Diosga» niy.","poem":1},{"lineBreak":true},{"text":"Paytaga llapan Israelcunami rispitan.","poem":1},{"lineBreak":true},{"text":"Munayninmi chayan asulyaraycaj syëlucama.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Wasincho fiyupa manchanami Tayta Diosga.","poem":1},{"lineBreak":true},{"text":"Acrashan Israelcunataga munayninwan yanapan.","poem":1},{"lineBreak":true},{"text":"Callpayoj cananpäpis yanapan.","poem":1},{"lineBreak":true},{"text":"¡Alabasha cachun Tayta Diosga!",