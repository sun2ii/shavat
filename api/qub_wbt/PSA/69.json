{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":69,"content":[{"type":"heading","content":["Llaquicur mañacushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Salbaycallämay Tayta Dios.","poem":1},{"lineBreak":true},{"text":"Shengaycänami.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mitu sinigachöga mas rurimanmi jaticaycä.","poem":1},{"lineBreak":true},{"text":"Mayman lluchcacunäpäpis manami canchu.","poem":1},{"lineBreak":true},{"text":"Yacuchöga chayashcä mas rurimanmi.","poem":1},{"lineBreak":true},{"text":"Bötiypa-bötiycaj yacumi apaycäman.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chay-jina gaparaycällar gasmashcänami.","poem":1},{"lineBreak":true},{"text":"Cuncäpis nanaycannami.","poem":1},{"lineBreak":true},{"text":"Tayta Diosta shuyaraycaptillänami","poem":1},{"lineBreak":true},{"text":"ñawëpis chacaycanna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Imatapis mana ruraycaptillä chiquimajcunaga ajchäpitapis mas aypalla ricacusha.","poem":1},{"lineBreak":true},{"text":"Chiquimajcunaga aypallami mirasha.","poem":1},{"lineBreak":true},{"text":"Imatapis mana ruraycaptëmi illgächimayta yarpaycan.","poem":1},{"lineBreak":true},{"text":"Mana suwapasha caycaptëmi «cutichimay» nircaycäman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tayta Dios, gam musyanquimi löcu-jina imatapis rurashäta.","poem":1},{"lineBreak":true},{"text":"Gamga musyaycanquimi juchata rurashäcunata.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Llapanpaj munayniyoj Tayta Dios,","poem":1},{"lineBreak":true},{"text":"¡Gamman yäracamojcunaga ama pengaycho cachunchu","poem":1},{"lineBreak":true},{"text":"noga llutanta rurashäpitaga!","poem":1},{"lineBreak":true},{"text":"Israelcuna rispitashan Dios,","poem":1},{"lineBreak":true},{"text":"¡buluntäniquita rurajcunaga ama llaquicuchunchu","poem":1},{"lineBreak":true},{"text":"noga imatapis rurashäpitaga!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ashllir-ushamaptinpis gam-raycumi awantacushcä.","poem":1},{"lineBreak":true},{"text":"Pengacuyllawanmi cäräpis pucayacäcusharaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Famillyäcunapäpis jäpami mana rejsishami cä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rispitädu wasiqui-raycuga imamanpis chayämanmi.","poem":1},{"lineBreak":true},{"text":"Contrayquicuna ashllir imata nishushayquipis nogamanmi chayamasha.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wagar ayunar goyaptë pengapäman.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Llaquicur gachga röpata jaticuptëpis llapanmi asipäman.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nogapäga shimillarämi rimapäcunpis.","poem":1},{"lineBreak":true},{"text":"Burrächucunanami pengacachimashpan birsupäman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Chaypis, Tayta Dios gamllatami mañacaycämö.","poem":1},{"lineBreak":true},{"text":"Yanapäcoj cashpayqui juclla salbaycamay ari.","poem":1},{"lineBreak":true},{"text":"Cuyacoj cayniquipa yanapaycamay ari.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¡Mituman jaticaycajtaga chutarcamay ari!","poem":1},{"lineBreak":true},{"text":"¡Chiquimajcunapitawan, yacu rurinpita salbaycamay ari!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Jorgaycamay ari bötiypa-bötir aywaycaj yacupita!","poem":1},{"lineBreak":true},{"text":"¡Tumariycaj yacu ruriman yaycaycächimajpita jorgaycamay ari!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tayta Dios wiyaycamay ari.","poem":1},{"lineBreak":true},{"text":"¡Gamga canqui allimi, pasaypa cuyacojmi!","poem":1},{"lineBreak":true},{"text":"Cuyapäcoj cashpayqui nogata ricäramay ari.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Ama ñïgaycamaychu ari!","poem":1},{"lineBreak":true},{"text":"¡Juclla yanapämay ari canan ñacaycashä öra!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Shamur salbaycamay ari.","poem":1},{"lineBreak":true},{"text":"¡Chiquimajcunapita jorgaycamay ari!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gamga musyanquimi ufindimashanta, pengacachimashanta,","poem":1},{"lineBreak":true},{"text":"manacajman churamar ñacachimashanta.","poem":1},{"lineBreak":true},{"text":"Gam musyaycanquimi chiquimajcuna pï cashantapis.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gayapämashpanmi shongötapis fiyupa jagayächisha.","poem":1},{"lineBreak":true},{"text":"¡Gänasnëpis ni callpäpis manami cannachu!","poem":1},{"lineBreak":true},{"text":"Yangami ashishcä cushicachimänanpaj, cuyapämänanpäpis.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ichanga micuynëmanmi benënuta wiñasha.","poem":1},{"lineBreak":true},{"text":"Yacunaptëpis binagritami upuchimasha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Cananga quiquincuna alli micuyta micunanpaj shuntacashan","poem":1},{"lineBreak":true},{"text":"cachun achäqui mana alliman chayananpaj.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ñawincunapis chacacäcuchun mana ricananpaj.","poem":1},{"lineBreak":true},{"text":"Imaycamapis chancancuna chucchuchun.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Rabyayquita paycunacho pascacächiy.","poem":1},{"lineBreak":true},{"text":"¡Fiyupa rabyaycashayqui paycunaman chayachun!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tiyaycashanpis chunyaj ricacuchun.","poem":1},{"lineBreak":true},{"text":"Tiyashan tolducunachöpis ama pipis tiyachunnachu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Paycunaga llaquicaycächishayqui runatami gaticacharcaycan.","poem":1},{"lineBreak":true},{"text":"Paycunaga ñacaycächishayqui runatami manacajman churaycäman.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mana allita rurajcunataga mana alliman chayachiy.","poem":1},{"lineBreak":true},{"text":"¡Paycunataga ama perdunaypischu!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"¡Imaycamapis cawananpaj apuntaraycächishayqui librupita illgarachiy!","poem":1},{"lineBreak":true},{"text":"¡Alli rurajcunapa jutin apuntaraycashan librumanga ama apuntaynachu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Tayta Dios, nogataga gueshyaycajta, llaquicuycajta","poem":1},{"lineBreak":true},{"text":"allchacaycachimay, salbaycamay ari.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tayta Diosnëtaga alabansacunawanmi alabashaj.","poem":1},{"lineBreak":true},{"text":"Agradësicurmi alabashaj.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Chayno alabaptë, töruta car nubilluta car","poem":1},{"lineBreak":true},{"text":"wagrantinta shilluntinta garashäpitapis masrämi cushiconga.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Chayta ricar ñacarcaycaj pobricunaga fiyupami cushiconga.","poem":1},{"lineBreak":true},{"text":"Dios munashanno goyajcunapis cushishami goyangapaj.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tayta Diosga wiyanmi pobricuna mañacushanta.","poem":1},{"lineBreak":true},{"text":"Manami cachaycunchu prësu caycajcunataga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"¡Llapan cawajcunapis, syëlupis, cay pachapis, lamarpis Tayta Diostaga alabay!","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Tayta Diosga Judá particho caycaj siudäcunata yapaymi allchachenga.","poem":1},{"lineBreak":true},{"text":"Yapaymi acrashan runacunataga Sioncho tiyachenga.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Tayta Diosta sirbejcunapa wamrancunami quëdanga chay siudäwanga.","poem":1},{"lineBreak":true},{"text":"Chaycho tiyashpanmi paycunaga raquipänaconga.","poem":1},{"lineBreak":true},{"text":"Diosta cuyajcunami chaychöga tiyanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}