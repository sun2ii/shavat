ext":"Manacajllapitachuraj conträta ¿mana allita rurashcä?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chayno rurasha captëga chiquimajcuna gaticachämächun.","poem":1},{"lineBreak":true},{"text":"Taripaycamar garachasha apamächun.","poem":1},{"lineBreak":true},{"text":"Pasaypa pengayman churamächun. Selah","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Tayta Dios!","poem":1},{"lineBreak":true},{"text":"¡Chiquimajcunawan rabyasha pillyay ari!","poem":1},{"lineBreak":true},{"text":"¡Alli arriglanayquipaj nisha caycarga faburnë jatariy ari Tayta Dios!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Intëru nasyuncunapitapis ñaupayquiman shamuchun.","poem":1},{"lineBreak":true},{"text":"Paycunata jusganayquipaj sillunniquiman jamacuy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios, gammi jusganqui llapan runacunata.","poem":1},{"lineBreak":true},{"text":"Imano cashätapis jusgamay.","poem":1},{"lineBreak":true},{"text":"Nogaga manami ima mana allitapis rurashcächu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Juchaynaj Tayta Dios, gamga musyaycanquimi runa imano yarpaycashantapis.","poem":1},{"lineBreak":true},{"text":"¡Fiyu runacunataga illgächiyna ari!","poem":1},{"lineBreak":true},{"text":"¡Juchaynaj runata ichanga yanapaycuy ari!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nogata imapitapis chapämäga janajcho caycaj Tayta Diosmi.","poem":1},{"lineBreak":true},{"text":"Paymi alli runacunataga salban.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Diosga alli arriglaj juezmi.","poem":1},{"lineBreak":true},{"text":"Payga mana jananpaypami jucha rurajcunata imaypis jusgan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fiyu runacuna mana arpinticuptenga","poem":1},{"lineBreak":true},{"text":"Tayta Dios sablintami afilanga,","poem":1},{"lineBreak":true},{"text":"lëchantami camarenga.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nina ratataycaj lëchawanpis apuntaraycanmi.","poem":1},{"lineBreak":true},{"text":"Wañuchicoj armanpis camarishallanami caycan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Masqui ricay fiyu runata:","poem":1},{"lineBreak":true},{"text":"Juchallatami gueshyaj caycan.","poem":1},{"lineBreak":true},{"text":"Mana allicunallatami gueshyaj caycan.","poem":1},{"lineBreak":true},{"text":"Wachangapis llullacuyllatami.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fiyupa jatun ruri uchcutami rurasha.","poem":1},{"lineBreak":true},{"text":"Quiquin rurashan uchcullamanmi yaganga.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mana allita rurashancunapis","poem":1},{"lineBreak":true},{"text":"quiquillanmanmi chayanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nogaga Tayta Diostami agradësicushaj alli arriglaj cashanpita.","poem":1},{"lineBreak":true},{"text":"Janajcho caycaj Tayta Diostami alabansacunawan alabashaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}