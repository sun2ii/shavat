{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":71,"content":[{"type":"heading","content":["Auquin runa mañacushan"]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, gamllamanmi guellicamö.","poem":1},{"lineBreak":true},{"text":"¡Ama pengaychöga cachaycamaychu!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Dios, allita rurajmi canqui. Salbaycamay ari.","poem":1},{"lineBreak":true},{"text":"Wiyaycallämay, yanapaycallämay ari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gammi canqui gaganöpis chapämajnë.","poem":1},{"lineBreak":true},{"text":"Gammi canqui pacacuna siudä, salbamajnë.","poem":1},{"lineBreak":true},{"text":"Chaymi gamllaman guellicamö.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tayta Dios, pacaycamay ari mana alli runacunapita,","poem":1},{"lineBreak":true},{"text":"wañuchicoj runacunapita, fiyu runacunapita.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Dios gammanmi mösu cashäpita-pachapis yäracaycämö.","poem":1},{"lineBreak":true},{"text":"Gammi imapitapis chapämashcanqui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mamäpa pachancho caycashpallänami","poem":1},{"lineBreak":true},{"text":"gammanga yäracaycämurä.","poem":1},{"lineBreak":true},{"text":"¡Gammi yurichimarayqui!","poem":1},{"lineBreak":true},{"text":"¡Imaypis gamllatami alabaycäshayqui!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Achcajmi nogata ricamar almirasha.","poem":1},{"lineBreak":true},{"text":"Ichanga gammi nogataga chapämarayqui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Goyay goyaypis gamta alabaycällarmi goyä.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Auquinna captëga ama gongaycamaychu.","poem":1},{"lineBreak":true},{"text":"Callpaynaj captëga ama cachaycamaychu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wañuchimayta munajcunaga","poem":1},{"lineBreak":true},{"text":"achcaj shuntacaycärirmi conträ parlacusha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paycuna ninacun: «Gaticachashpayqui chariy.","poem":1},{"lineBreak":true},{"text":"Diosga cachaycushanami. Manami pipis salbangachu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tayta Dios, ama witicuychu nogapitaga.","poem":1},{"lineBreak":true},{"text":"¡Juclla aywaycamuy yanapämänayquipaj!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¡Nogata chiquipämajcunaga quiquincuna pengayman chayachun, illgächun!","poem":1},{"lineBreak":true},{"text":"¡Noga mana alliman chayanäta munajcunataga quiquincunata mana alli chayachun!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nogaga gamllatami shuyaraycäshayqui.","poem":1},{"lineBreak":true},{"text":"Waran-waran gamllatami alabashayqui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Goyay-goyay pï-maytapis willacushaj alli ruraj cashayquita, nogacunata salbamashayquita.","poem":1},{"lineBreak":true},{"text":"Ichanga willapaytapis manami ushämanchu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tayta Dios nogaga willacushämi fiyupa allicunata rurashayquita.","poem":1},{"lineBreak":true},{"text":"«Dios japallanmi juchaynäga» nirmi willacushaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tayta Dios, mösu cashäpita-pachami gamga willapämashcanqui.","poem":1},{"lineBreak":true},{"text":"Canancamapis fiyupa allita rurashayquitami willacuycä.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ama cachaycamaychu ari","poem":1},{"lineBreak":true},{"text":"auquinna captëpis soguna captëpis.","poem":1},{"lineBreak":true},{"text":"Nogaga mastarämi willacunä caycan munayniyoj cashayquita","poem":1},{"lineBreak":true},{"text":"canan caycaj runacunata, paycunapa wamrantapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tayta Dios, alli ruraj cashayquega chayan janaj syëlucamami.","poem":1},{"lineBreak":true},{"text":"Gamga rurashcanqui almiraypajcunatami.","poem":1},{"lineBreak":true},{"text":"¡Manami pipis tincunchu gammanga!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gamga fiyupa ñacayman llaquicuymanmi chayachimashcanqui.","poem":1},{"lineBreak":true},{"text":"Chaypis yapaymi cawachimanquipaj.","poem":1},{"lineBreak":true},{"text":"Allpa rurinpitapis yapaymi jatarachimanquipaj.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nircorga masnami munayniyojyächimanquipaj.","poem":1},{"lineBreak":true},{"text":"Yapaymi cushicachimanquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Tayta Diosnë, nogaga alli cashayquipitami alabashayquipaj.","poem":1},{"lineBreak":true},{"text":"Israelcunapa Santo Diosnin captiquimi alabansacunata cantashaj arpacunata arpa-mallwacunata tucashpä.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gam salbamashayquipitami cushicur cantashaj.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mana alliman chayanäta munajcunaga fiyupa pengaypämi cananga carcaycan.","poem":1},{"lineBreak":true},{"text":"Chaymi gam alli jusgaj cashayquitaga imay örapis parlaycäshaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}