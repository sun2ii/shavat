{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":72,"content":[{"type":"heading","content":["Raypaj Tayta Diosta mañacushan"]},{"type":"hebrew_subtitle","content":["Salomón isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, raytaga sumaj yachachiy alli arriglananpaj.","poem":1},{"lineBreak":true},{"text":"Raypa wamrantapis yanapaycuy allita rurananpaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chayrämi rayga umildicunata, pobricunata alli mandanga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chauraga jircacunapis acrashayqui runacunata cuydanga.","poem":1},{"lineBreak":true},{"text":"Puntacunapis acrashayqui runacunata alli ricanga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Rayga alli arriglachun pobricunataga!","poem":1},{"lineBreak":true},{"text":"¡Muchupacajcunapa wamrancunata salbachun!","poem":1},{"lineBreak":true},{"text":"¡Ñacachejcunata ichanga ñacachichun!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Intipitawan quillapitapis mas unaycamaraj acrashayqui rayga cawachun!","poem":1},{"lineBreak":true},{"text":"¡Achca miraycama cawachun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"¡Payga cachun cay pachaman tamyar guewacunata pargojno!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Pay mandaptenga llapan rurashancunapis alli llojshichun, alli goyaylla cachun!","poem":1},{"lineBreak":true},{"text":"¡Quilla cawashanpitapis mas unaycamaraj alli goyaylla cachun!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Payga mandachun jatun lamarpa cuchunpita Cachi lamarcama!","poem":1},{"lineBreak":true},{"text":"Éufrates mayupitana mundupa jucaj cuchuncama mandachun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Payta chiquej chunyajcho tiyajcunaga","poem":1},{"lineBreak":true},{"text":"paypa munayninchöna ricacuchun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Paymanga Tarsischo tiyaj raycuna, lamar chaupin tishgucho tiyajcuna impuestuta pägachun!","poem":1},{"lineBreak":true},{"text":"¡Garaynincunata goycuchun Sabächo caycaj raycuna, Sebacho caycaj raycuna!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Llapan raycuna gongurpacuchun paymanga!","poem":1},{"lineBreak":true},{"text":"¡Llapan nasyuncho tiyajcuna sirbichun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Payga salbangami ruwacoj caj pobricunata,","poem":1},{"lineBreak":true},{"text":"mana pipis yanapänanpaj cajcunatapis.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Umildicunataga cuyapangami.","poem":1},{"lineBreak":true},{"text":"Wañunanpaj caycaj pobricunatanami salbanga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Paycunataga munayniyojcunapita, fiyu runacunapita salbangami.","poem":1},{"lineBreak":true},{"text":"Paycunaga raypa ñaupancho bälinmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"¡Chayno alli cashanpita rayga cawachun!","poem":1},{"lineBreak":true},{"text":"¡Sabächo caj gorita goycuchun!","poem":1},{"lineBreak":true},{"text":"¡Paypäga imaypis Diosta mañacuycäshun!","poem":1},{"lineBreak":true},{"text":"¡Paytaga bindisyunta gochun imaypis!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Cay nasyunchöga rïgu amatar wayuchun!","poem":1},{"lineBreak":true},{"text":"¡Intëru jircacunachöpis juntasha cachun!","poem":1},{"lineBreak":true},{"text":"Libanuchöno rïgucuna wiñachun.","poem":1},{"lineBreak":true},{"text":"Runacunapis aypalla mirachun jirca jachacunanöraj cananpaj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Ray alli cashanpita jutintaga imaycamapis rimaycächun!","poem":1},{"lineBreak":true},{"text":"Chaynölla parlachun inti cashanpitapis mas unaycamaraj.","poem":1},{"lineBreak":true},{"text":"¡Munducho caycaj nasyuncunapis pay-raycu bindisyunta chasquichun!","poem":1},{"lineBreak":true},{"text":"¡May nasyuncho tiyajcunapis rayta «alli goyaycullay» nichun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Israelcuna rispitashan Tayta Dios alabasha caycullay.","poem":1},{"lineBreak":true},{"text":"Gamllami ima-aycatapis almiraypajcunata ruranqui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tayta Diosga imaycamapis alabasha caycuchun.","poem":1},{"lineBreak":true},{"text":"¡Cay pachachöga intërucho paylla rejsisha cachun!","poem":1},{"lineBreak":true},{"text":"¡Chayno caycuchun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Isaïpa wamran David Tayta Diosta mañacur alabashanga cayllachönami ushan."]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}