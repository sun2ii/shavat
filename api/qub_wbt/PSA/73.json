,{"text":"Chaycunapaj yarpachacurmi nogaga imay örapis llaquicuycä.","poem":1},{"lineBreak":true},{"text":"Cada tutami ñacä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Noga paycunano yarpashpäga maynami engañäman caran acrashayqui runacunatapis.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yarpachacaycächimashayquitaga llapantami tantiyayta munashcä.","poem":1},{"lineBreak":true},{"text":"Ichanga nogapaj fiyupa sasami casha.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Diosta rispitana wasiman yaycunäcama manami tantiyashcächu.","poem":1},{"lineBreak":true},{"text":"Yaycur-rämi paycuna imano ushacänanpaj cashantapis tantiyacushcä.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Paycunataga pasaypa llushcamanmi chayachishcanqui.","poem":1},{"lineBreak":true},{"text":"Chaypitami tangariycunqui quiquincunalla mana alliman chayananpaj.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¡Illajpitami ushacanga paycunaga!","poem":1},{"lineBreak":true},{"text":"¡Fiyupa mancharirmi ushacanga!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tayta Dios, fiyu runacunataga juc runa suyñushanta gongaycojnömi","poem":1},{"lineBreak":true},{"text":"pï-maypis gongayconga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tayta Dios, nogaga fiyupami rabyasha caycarä.","poem":1},{"lineBreak":true},{"text":"Shongöpis nanayparämi nanaycaran.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Pasaypa mana tantiyaj runami cashcä.","poem":1},{"lineBreak":true},{"text":"¡Ñaupayquichöga caycarä juc animalnömi!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Imano captëpis simrimi yanapaycämarayqui.","poem":1},{"lineBreak":true},{"text":"Derëchu caj maquëpita charirajnömi yan'gaycämarayqui.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Willapämashpayquimi sumaj yachachimashcanqui.","poem":1},{"lineBreak":true},{"text":"Nircurnaga allimi chasquimanquipaj.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"¿Pïnëtaj nogapaga syëlucho caycan? ¡Gamllami Tayta!","poem":1},{"lineBreak":true},{"text":"Yanapaycämaptiquega manami imatapis munächu cay pachachöga.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Callpäpis manami cajnönachu.","poem":1},{"lineBreak":true},{"text":"Chaypis gamllami imaypis yanapaycämanqui.","poem":1},{"lineBreak":true},{"text":"¡Gamllami nogataga balurta goycämanqui!","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Gamta gongaycushoj cajcunaga llapanmi illganga.","poem":1},{"lineBreak":true},{"text":"Mana wiyacushojcunataga illgarachinquipämi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nogami ichanga Diospa ñaupallancho cawayta munä.","poem":1},{"lineBreak":true},{"text":"Chay cajmi nogapäga mas alli caycan.","poem":1},{"lineBreak":true},{"text":"Tayta Dios gammi caycanqui pacacunä.","poem":1},{"lineBreak":true},{"text":"Chaymi gam rurashayqui cajtaga llapanta willacushaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}