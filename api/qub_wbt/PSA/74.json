{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":74,"content":[{"type":"heading","content":["Acrashan runacunata salbananpaj mañacushan"]},{"type":"hebrew_subtitle","content":["Asaf isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, ¿imanirtaj para-simriga nogacunata jitarimashcanqui?","poem":1},{"lineBreak":true},{"text":"Nogacuna acrashayqui uyshayquino caycaptëga ¿imanirtaj fiyupa rabyacurcushcanqui?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Acrashayqui runacunapäga yarpaycuy ari.","poem":1},{"lineBreak":true},{"text":"Paycunataga gallarinanpita-pachami quiquiqui acrarayqui.","poem":1},{"lineBreak":true},{"text":"Acrashayqui trïbu cananpämi jorgamurayqui.","poem":1},{"lineBreak":true},{"text":"Sión lömataga yarpäriy ari.","poem":1},{"lineBreak":true},{"text":"Gamga chaychömi tiyarayqui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Juchusha ragällan caycajta ricaj shamuy ari.","poem":1},{"lineBreak":true},{"text":"¡Chiquimajcunami Templuyquita illgächisha!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chiquishojcunaga wasiquichömi cushicur gaparpasha.","poem":1},{"lineBreak":true},{"text":"Binsiycurmi bandërancunatapis jawicarcärisha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yantata mutojnöpis","poem":1},{"lineBreak":true},{"text":"jächawanmi ushajpaj pirasyasha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Martilluwan jächawanmi illgächisha guerucho cuyayllapaj burdasha caycajcunata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wasiquitaga manami rispitashachu.","poem":1},{"lineBreak":true},{"text":"Chaypa ruquenga rupaycärachishami.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nogacunapäga «ushajpaj illgarachishun» niranmi.","poem":1},{"lineBreak":true},{"text":"¡Cay nasyunchöga llapantami rupachisha","poem":1},{"lineBreak":true},{"text":"gamta aduranäpaj shuntacänä wasicunatapis!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bandëräcunapis mananami ichirpannachu.","poem":1},{"lineBreak":true},{"text":"Profëtacunapis mananami cannachu","poem":1},{"lineBreak":true},{"text":"imaycama chaynölla canäcunapaj cashanta willamänanpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tayta Dios, ¿imaycamaraj wiyächipämanga chiquimajcunaga?","poem":1},{"lineBreak":true},{"text":"¿Imaycamaraj washayquitapis parlarcaycanga?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¿Imanirtaj manana yanapämanquinachu?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj manana imatapis ruranquichu?","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Unaypitapis gamllami nogacunapaga Raynë canqui.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, gamga cay pachacho achca cutimi allicho llojshishcanqui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lamar yacutapis munayniquiwanmi ishcayman raquirirayqui.","poem":1},{"lineBreak":true},{"text":"Lamarcho tiyaj waräcuypa umantapis paquirgärishcanqui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Waräcuy Leviatanpa umantapis llapirishcanquimi.","poem":1},{"lineBreak":true},{"text":"Wañuycacherga chunyajcho tiyaj animalcunatami garashcanqui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gammi pashtachimushcanqui pucyutapis, yacutapis mayu cananpaj.","poem":1},{"lineBreak":true},{"text":"Mana chaquej mayucunatana chaquichishcanqui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gampa munayniquichömi caycan junajpis chacaypis.","poem":1},{"lineBreak":true},{"text":"Gammi camacächishcanqui quillata, intitapis.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gammi señalashcanqui maycama mundu cananpäpis.","poem":1},{"lineBreak":true},{"text":"Gammi nishcanqui tamya quilla, usya quilla cananpäpis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tayta Dios, ama gongaychu chiquishojcuna gayapäshushayquita,","poem":1},{"lineBreak":true},{"text":"mana tantiyajcuna contrayqui parlacushanta.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¡Nogacunataga pasaypa ama gongaycamaychu!","poem":1},{"lineBreak":true},{"text":"Nogacunaga carcaycä chacwa-mallwanöpis pishi töpayllami.","poem":1},{"lineBreak":true},{"text":"¡Micucoj animalcunamanga ama cachaycamaychu!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yarpäriy parlacur aunishayquita.","poem":1},{"lineBreak":true},{"text":"Cay nasyunchöga intëruchöpis mana allillatanami rurarcaycan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ñacaycajcunata pengayman churanantaga ama dëjaychu.","poem":1},{"lineBreak":true},{"text":"Pobricunawan ñacajcunaga gamta alabaycushunqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"¡Apuray Tayta Dios! ¡Munayniyoj cashayquita musyachiy!","poem":1},{"lineBreak":true},{"text":"¡Musyashayquinöpis mana tantiyajcunaga mana chawaypami contrayqui rimarcaycan!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ama gongaychu chiquishojcuna washayqui rimashanta.","poem":1},{"lineBreak":true},{"text":"Paycunaga ashllishunquimi, gayapäshunquimi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}