{"lineBreak":true},{"text":"Paycunataga në: «Ama munayniyoj-tucuychu.","poem":1},{"lineBreak":true},{"text":"Ama runa-runa parlaychu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Alliman churamänapäga manami shamunchu inti yagamunanpita, ni inti yagananpitapis,","poem":1},{"lineBreak":true},{"text":"chunyajpita ni puntacunapitapis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tayta Diosmi llapantapis jusgan.","poem":1},{"lineBreak":true},{"text":"Waquintami manacajman churan.","poem":1},{"lineBreak":true},{"text":"Waquintanami alliman churan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Diosga jusgar castigananpaj cöpan aptashami caycan.","poem":1},{"lineBreak":true},{"text":"Fiyupa pogusha bïnutanömi chararaycan.","poem":1},{"lineBreak":true},{"text":"Chay cöpata jicharamuptin","poem":1},{"lineBreak":true},{"text":"cay pachacho caj juchasapacunaga","poem":1},{"lineBreak":true},{"text":"gonchuntintami upucarcärenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nogaga imaypis willacuycäshaj Jacobpa Tayta Diosnillanpämi.","poem":1},{"lineBreak":true},{"text":"Alabansacunatapis payllapämi cantaycäshaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Diosmi illgächenga fiyucuna alli-tucuycajta.","poem":1},{"lineBreak":true},{"text":"Alli runatami ichanga mas munayniyojyächenga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}