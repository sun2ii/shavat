i canqui!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaynöpami fiyupa callpayojcunapis ima ruraytapis mana puydishachu.","poem":1},{"lineBreak":true},{"text":"Manami gänasninpis cashanachu.","poem":1},{"lineBreak":true},{"text":"Mananami jatarimonganachu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta, Jacobpa Diosninmi canqui.","poem":1},{"lineBreak":true},{"text":"Gam rabyacurcuptiquega","poem":1},{"lineBreak":true},{"text":"carrëtancuna ni cawalluncunapis mananami cuyucunnachu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Gamga canqui fiyupa puydej y manchanami!","poem":1},{"lineBreak":true},{"text":"¿Piräshi ichipäshunquiman rabyacurcuptiquega?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios syëlupita-pachami jusganquipaj.","poem":1},{"lineBreak":true},{"text":"Chaymi cay pachapis mancharir mana cuyucunchu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaynöga caycan","poem":1},{"lineBreak":true},{"text":"jusganayquipaj jatariptiquimi,","poem":1},{"lineBreak":true},{"text":"cay pachacho ñacaycajcunata salbanayquipaj captinmi. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gam rabyacurcuptiquega","poem":1},{"lineBreak":true},{"text":"mas ollgojnin runapis","poem":1},{"lineBreak":true},{"text":"upällacur rispitarmi alabashunqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aunishanchïcunataga Tayta Diosninchïta cumlishun.","poem":1},{"lineBreak":true},{"text":"Ñaupancho caycajcuna, gamcunapis almiraypaj caycaj Tayta Diospaj garayniquicunata apamuy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Payga mandajcunatapis wañurachinmi.","poem":1},{"lineBreak":true},{"text":"Munducho caycaj raycunatapis mancharachinmi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_w