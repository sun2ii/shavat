yarpachacurpis manami imata niytapis puydëchu!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ñaupa watacunapaj, unaycunapaj yarpärë.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chacaycuna alabashäta yarpärë.","poem":1},{"lineBreak":true},{"text":"Chaymi shongullächo yarpachacurir në:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«Tayta Diosga ¿chaynöllachuraj rabyasha caycanga?","poem":1},{"lineBreak":true},{"text":"¿Mananachuraj yapayga alli ricamäshun?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¿Cuyacoj caynin ushacäcushanachuraj?","poem":1},{"lineBreak":true},{"text":"Aunishantaga ¿mananachuraj imaypis cumlenga?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¿Cuyapäcoj cashanta Tayta Diosga gongaycushachuraj?","poem":1},{"lineBreak":true},{"text":"¿Fiyupa rabyasha cashpan mananachuraj cuyapämäshun?» nir. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yapay në: «Fiyupa llaquicö Tayta Dios","poem":1},{"lineBreak":true},{"text":"noganchïta unaynöga manana ricamashami» nir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Unay watacunacho Tayta Diosninchi almiraypajcunata rurashallantami yarparäshaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Unaycuna milagrucunata rurashallanpaj yarpachacushaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tayta Dios, gamnöga manami juc canchu.","poem":1},{"lineBreak":true},{"text":"Gam rurashayquega llapanpis allillami.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¡Tayta Dios, gammi fiyupa almiraypajcunata ruranqui!","poem":1},{"lineBreak":true},{"text":"¡Llapan nasyuntami musyachishcanqui munayniyoj cashayquita!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Munayniquiwanmi jorgamushcanqui acrashayqui runacunata.","poem":1},{"lineBreak":true},{"text":"Paycunaga Jacobpitawan wamran Josëpita mirar aywajcunami. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tayta Dios, lamar yacupis ricashushpayquega fiyupami cuyuriran.","poem":1},{"lineBreak":true},{"text":"Mas jundunnin yacupis cuyuriran.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Pucutaypitapis tamyami shicwamuran.","poem":1},{"lineBreak":true},{"text":"Räyupis janajchömi pashtasha.","poem":1},{"lineBreak":true},{"text":"Intërupami illgushapis.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Shucucuy wayracho räyuyqui pashtashanpis wiyacashami.","poem":1},{"lineBreak":true},{"text":"Illguyniqui achicyashpanmi intëru mundutapis achicyachin.","poem":1},{"lineBreak":true},{"text":"Cay pachapis timlurcunawan cuyuriran.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lamar gochapami nänita rurarirayqui.","poem":1},{"lineBreak":true},{"text":"Aypalla yacu jananpami aywarayqui.","poem":1},{"lineBreak":true},{"text":"Ichanga yupiquita manami pipis tariranchu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Acrashayqui runacunataga uyshata gatejnömi pusharayqui.","poem":1},{"lineBreak":true},{"text":"Moiseswan y Aaronwanmi pushachirayqui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}