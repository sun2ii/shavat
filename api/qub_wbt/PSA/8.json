a ¿imanir-raj cuyapanqui?» nir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Runataga anjilcunapita mas mënus munayniyojllatami rurarayqui.","poem":1},{"lineBreak":true},{"text":"Chaypis camacächishcanqui munayniyoj rispitasha cananpämi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Camashayquicunapa duyñun cananpaj aunishcanqui.","poem":1},{"lineBreak":true},{"text":"Camashayquicunapita mas munayniyoj cananpämi churashcanqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Uyshacunapita, wäcacunapita, jirca animalcunapita,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"päriypa purejcunapita, lamarcho tiyaj pescäducunapita,","poem":1},{"lineBreak":true},{"text":"lamarcho caycajcunapita mas munayniyoj cananpämi churashcanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Llapanpaj munayniyoj Tayta Dios,","poem":1},{"lineBreak":true},{"text":"¡cay pachachöga gamllami fiyupa rispitasha canqui!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}