{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":80,"content":[{"type":"heading","content":["Yapay yanapänanpaj mañacushan"]},{"type":"hebrew_subtitle","content":["Asaf isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Israelcunata ricaj Tayta Dios wiyaycamay ari.","poem":1},{"lineBreak":true},{"text":"Gamga Josëpita mirajcunata uyshëru uyshanta pusharajnömi pushanqui.","poem":1},{"lineBreak":true},{"text":"Gampaga jamanayquipis caycan querubín anjilcuna caycashanchömi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Achicyaypa achicyar yurircushpayqui washaycuy Efrainpita, Manasespita, Benjaminpita mirajcunataga.","poem":1},{"lineBreak":true},{"text":"¡Munayniquiwan nogacunata salbaycamay ari!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios, ñaupatano alli goyänäcunapaj yanapaycamay.","poem":1},{"lineBreak":true},{"text":"Alli ñawillayquiwan ricäramay ari salbasha canäcunapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Israelcuna mañacuycäshuptiquipis","poem":1},{"lineBreak":true},{"text":"¿imaycamaraj rabyashalla caycanqui munayniyoj Tayta Dios?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chay-jina wagayllawan weguillätanami upuycäpis.","poem":1},{"lineBreak":true},{"text":"Pasaypa wagashä weguillänami yacöpis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogacunataga cachaycamashcanquimi bisïnöcuna manacajman churamar cushipämänanpaj,","poem":1},{"lineBreak":true},{"text":"chiquimajcunapis asipämänanpaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Dios, ñaupatano alli goyänäcunapaj yanapaycamay ari.","poem":1},{"lineBreak":true},{"text":"Alli ñawillayquipa ricäramay ari salbasha canäcunapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Egiptupitami übas lantata apamurayqui.","poem":1},{"lineBreak":true},{"text":"Mana rispitashojcunataga chacrapita jitarishcanqui chay übasta lantanayquipaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chacrata sumaj picharcurmi lantashcanqui.","poem":1},{"lineBreak":true},{"text":"Lantanami sapichar intëru nasyunman juntasha.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Puntacunatapis chapasha llantupänanpaj.","poem":1},{"lineBreak":true},{"text":"Rämancunapis sedrucunata chapasha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Räman lätar aywajcunaga chayasha Mediterráneo lamarcamami,","poem":1},{"lineBreak":true},{"text":"inti yagamunan caj-läpanami Éufrates mayucama.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Cananga ¿imanirtaj guenchancunata tunichishcanqui?","poem":1},{"lineBreak":true},{"text":"Päsaj fiyu runacunapis wayuyninta pallacurcaycanmi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Munti cuchicunapis pedäsumi ruraycan.","poem":1},{"lineBreak":true},{"text":"Jirca animalcunapis ushacurcun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Munayniyoj Tayta Dios cutiycamuy ari.","poem":1},{"lineBreak":true},{"text":"Übas lantayquitaga syëlupita-pacha sumaj ricaycuy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chay übastaga quiquiquimi lantarayqui.","poem":1},{"lineBreak":true},{"text":"Chillguiptenga quiquiquipaj cananpämi ricarayqui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Übasniquega mutur-ushashami, rupachir-ushashami caycan.","poem":1},{"lineBreak":true},{"text":"Chaymi chayno rurajtaga fiyupa castigaycuy ari.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Munashayquino cawaj runata ichanga yanapaycuy.","poem":1},{"lineBreak":true},{"text":"Acrashayqui runataga sumaj yanapaycuy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chauraga mananami nogacuna imaypis gongashayquipänachu.","poem":1},{"lineBreak":true},{"text":"Cawachimay ari gampa jutillayquitana rimanäpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Munayniyoj Tayta Dios, ñaupatano alli goyänäcunapaj yanapaycamay.","poem":1},{"lineBreak":true},{"text":"Alli ñawillayquiwan ricäramay ari salbasha canäcunapaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}