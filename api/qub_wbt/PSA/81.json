{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":81,"content":[{"type":"heading","content":["Israelcunapaj Tayta Dios alli cashan"]},{"type":"hebrew_subtitle","content":["Asaf isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"¡Tayta Diostaga cushisha alabay!","poem":1},{"lineBreak":true},{"text":"Paymi ima-aycapitapis chapämanchi.","poem":1},{"lineBreak":true},{"text":"¡Cushisha alabay Jacobpa Tayta Diosnintaga!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Panderëtacuna, arpacuna, arpa-mallwacuna wagashan-tupu cantay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Trompëtacunata tucay llullu quilla fistacho, llëna quilla fistacho.","poem":1},{"lineBreak":true},{"text":"Chay junajcunami noganchïpäga jatun fistanchi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Noganchi Israelcunataga chayno ruranapämi Tayta Diosninchi nimaranchi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Egiptupita shacamuptinmi","poem":1},{"lineBreak":true},{"text":"Josëpita mirajcunawan Tayta Diosga chayno conträtutami ruraran.","poem":1},{"lineBreak":true},{"text":"Mana rejsishä rimaycho cayno nimojtami wiyashcä:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Lasajta apariraycashayquitami jorgushcä.","poem":1},{"lineBreak":true},{"text":"Fiyupa sasa aruycunacho caycajtami jamachishcä.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fiyupa llaquicur mañacamaptiquimi nogaga salbarä.","poem":1},{"lineBreak":true},{"text":"Pucutay rurincho räyuycajpitami gamcunataga willapämurä.","poem":1},{"lineBreak":true},{"text":"Imano yäracaycämashayquitapis Meriba yacu ñaupanchömi gamcunataga musyaparä.Selah","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Acrashä runacuna, willapashäta sumaj wiyacuy.","poem":1},{"lineBreak":true},{"text":"¡Israel runacuna, alliraj canman wiyacamaptiquega!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Juc-läcunapa diosnintaga ama charaychu.","poem":1},{"lineBreak":true},{"text":"Juc dioscunataga ama aduraychu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nogami Egipto nasyunpita jorgamoj Tayta Diosniqui cä.","poem":1},{"lineBreak":true},{"text":"Nogami imapis pishëpacushayquitaga puchu-puchu tarichishayqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Ichanga acrashä runacuna caycar manami wiyacamashcanquichu.","poem":1},{"lineBreak":true},{"text":"Israelcuna manami wiyacamashcanquichu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaypitami cachaycushcä munashayquino cawacunayquipaj.","poem":1},{"lineBreak":true},{"text":"Chaymi munashayquinöna goyäcushcanqui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Acrashä runacuna wiyacamar","poem":1},{"lineBreak":true},{"text":"willapashäcunata cumliptenga","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"juc guepishtaynöllami chiquejnincunataga manacajman churarëman caran.","poem":1},{"lineBreak":true},{"text":"Maynami castigäman caran contrancunataga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Diosta chiquejcunaga mancharishami rispitanman caran.","poem":1},{"lineBreak":true},{"text":"Ichanga para-simrimi castigasha canman caran.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Acrashä runacunaga allinnin rïgutami micunman caran.","poem":1},{"lineBreak":true},{"text":"Jircacho cacoj mishquiwanrämi yacunaynintapis chawächëman caran.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}