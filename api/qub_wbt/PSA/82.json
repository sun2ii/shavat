{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":82,"content":[{"type":"heading","content":["Juezcunata Tayta Dios piñacushan"]},{"type":"hebrew_subtitle","content":["Asaf isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Syëlucho caycajcunapita mas munayniyojmi Tayta Diosga.","poem":1},{"lineBreak":true},{"text":"Paymi chaupicho ichircur llapan dioscunata jusgar nin:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«¿Imaycamaraj gamcunaga mana alli arriglanqui?","poem":1},{"lineBreak":true},{"text":"¿Imaycamaraj mana allita rurajcunapa faburnin caycanqui? Selah","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pïninpis mana caj wacchacunataga alli arriglay.","poem":1},{"lineBreak":true},{"text":"Pobricunataga pishëpacojcunataga alli arriglay.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pïninpis mana cajcunata pobricunataga salbay.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunapita washay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Ichanga, gamcuna mana musyanquichu ni tantiyanquipischu.","poem":1},{"lineBreak":true},{"text":"Chacaycho purejnömi purircaycanqui.","poem":1},{"lineBreak":true},{"text":"Mana alli arriglaptiquimi cay pachata tuncarajcunapis sicsicyan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogami nishcä ‹gamcunaga dioscunami caycanqui.","poem":1},{"lineBreak":true},{"text":"Llapaniquipis caycanqui janajcho caycaj Diospa wamranmi›.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Imano carpis, gamcunapis wañunquipaj waquin runacunanömi.","poem":1},{"lineBreak":true},{"text":"Pï mandajcunapis wañushannömi wañunquipaj.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Dios, gamllapami llapan nasyuncunapis.","poem":1},{"lineBreak":true},{"text":"Cay pachacho tiyajcunata alli arriglanayquipaj shaycamuy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}