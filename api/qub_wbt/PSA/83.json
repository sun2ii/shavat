{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":83,"content":[{"type":"heading","content":["Contrancunata usharinanpaj mañacushan"]},{"type":"hebrew_subtitle","content":["Asaf isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, ¡ama upällallaga cacuychu!","poem":1},{"lineBreak":true},{"text":"¡Mana cuyucuypa, mana rimacuypaga ama cacuychu!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chiquishojcunata masqui ricay:","poem":1},{"lineBreak":true},{"text":"imanöshi gayapaycäshunqui.","poem":1},{"lineBreak":true},{"text":"Contrayquicunata masqui ricay:","poem":1},{"lineBreak":true},{"text":"gaparpashpan imanöshi washayquita rimarcaycan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Acrashayqui runacunata mana allita rurananpämi parlacurcaycan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paycunaga nircaycan: «¡Paycunata illgarachishun manana nasyun cananpaj!","poem":1},{"lineBreak":true},{"text":"¡Israelpa jutintaga pipis manana yarpänanpaj illgarachishun!» nir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Llapanmi parlacusha gampa contrayqui.","poem":1},{"lineBreak":true},{"text":"Juc shongullami parlacusha:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Edom runacuna, Ismaelcuna, Moab runacuna, Agar runacuna,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gebalpita, Amonpita, Amalecpita mirajcuna, Filistea runacuna, Tirocho tiyajcunapis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asiriocunapis paycunamanmi guellicusha.","poem":1},{"lineBreak":true},{"text":"Asiriocunaga Lotpita mirajcunata pillyäshejcunami. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Paycunata wañurachiy Madián runacunata wañuchishayquino.","poem":1},{"lineBreak":true},{"text":"Paycunataga ushariy Sisarata, Jabinta Cisón mayu läduncho wañuchishayquino.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paycunataga illgächirayqui Endorchömi.","poem":1},{"lineBreak":true},{"text":"Chauraga chullpamanna ticraran.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mandajnincunatana wañuchiy Orebta, Zeebta wañuchishayquino.","poem":1},{"lineBreak":true},{"text":"Llapan raycunatana wañuchiy Zebata, Zalmunata wañuchishayquino.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Paycunaga «Dios goycushan chacrata charicarcärishun» niran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tayta Diosnillä, camacaycachiy ari","poem":1},{"lineBreak":true},{"text":"chaquisha öjata wayra apacushanno ricacunanpaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Imanömi muntita nina rupar ushacurcun,","poem":1},{"lineBreak":true},{"text":"imanömi jircapa nina ichircur-ichircur aywan","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"chayno ricacunanpaj löcu tamyawan gaticachay, löcu wayrawan manchachiy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Tayta Dios paycunataga fiyupa pengacachiy gamman yäracamunanpaj!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Imaycamapis pengaycho cachun.","poem":1},{"lineBreak":true},{"text":"¡Chayno caycällarmi paycunaga wañongapis!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Llapan musyachun gam japallayqui Tayta Dios cashayquita.","poem":1},{"lineBreak":true},{"text":"Tantiyacuchun gamlla janaj pachacho cay pachachöpis Tayta Dios cashayquita.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}