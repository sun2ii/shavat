{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":84,"content":[{"type":"heading","content":["Diospa Templuncho goyayta munashan"]},{"type":"hebrew_subtitle","content":["Corëpita mirajcuna isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"¡Munayniyoj Tayta Dios,","poem":1},{"lineBreak":true},{"text":"fiyupa cuyayllapämi tiyanayquega!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Llapan shongöpami wasiqui puncucho cayta munä.","poem":1},{"lineBreak":true},{"text":"Llapan shongöpami cushisha alabä cawachicoj Tayta Diostaga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Diosnillä, pichiusacunapis wasiquichöga tarinmi tiyananpaj.","poem":1},{"lineBreak":true},{"text":"Tayta raynillä, wayanay äbicunapis altarniquicunapa sercancho tarinmi wawancunata gueshpichinanpaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Templuyquicho tiyajcunaga cushisha goyächun.","poem":1},{"lineBreak":true},{"text":"Paycunaga mana jamaypami alabashunquipaj. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¡Cushishami cawanga gam yanapashayqui runaga, wasiquiman chayamuyta munajcunapis!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wagay jutiyoj pampa guechwapa päsaptin chay pampapis pucyumanmi ticracurenga.","poem":1},{"lineBreak":true},{"text":"Tamyapis paycunamanga bindisyuntami churanga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sercaynin-tupumi callpanpis yapacanga.","poem":1},{"lineBreak":true},{"text":"Tayta Dios Sionchönami quiquiquita ricashunquipaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jacobpa munayniyoj Tayta Diosnin,","poem":1},{"lineBreak":true},{"text":"mañacaycämushäta wiyaycamay ari. Selah","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Dios, alli ricaycuy acrashayqui raytaga.","poem":1},{"lineBreak":true},{"text":"Nogacunapäga paymi caycan pillyar chapacuna escüdöno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Waranga watantin juc-lächo goyänäpa ruquenga mas alli canman","poem":1},{"lineBreak":true},{"text":"juc junajllapis Wasiquicho goyaptëmi.","poem":1},{"lineBreak":true},{"text":"Juchasapacunawan goyänäpa ruquenga mas alli canman","poem":1},{"lineBreak":true},{"text":"Wasiquicho pichapacullarpis goyaptëmi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Dios gammi intita achicyächimunqui, ima mana allipitapis chapämanqui.","poem":1},{"lineBreak":true},{"text":"Munashayquino goyajcunataga cuyanquimi, allimi ricanqui.","poem":1},{"lineBreak":true},{"text":"Paycunataga llapantapis allitami tarichinqui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Dios,","poem":1},{"lineBreak":true},{"text":"¡cushisha cawachun gamman yäracamojcunaga!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}