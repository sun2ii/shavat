":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}