{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":86,"content":[{"type":"heading","content":["Cuyapänanpaj Tayta Diosta mañacushan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, wiyaycamay ari.","poem":1},{"lineBreak":true},{"text":"Nogaga caycä fiyupa llaquishami, pasaypa pobrimi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gam munashayquinömi nogaga rurä.","poem":1},{"lineBreak":true},{"text":"Chapaycamay ari. Gammi canqui Diosnë.","poem":1},{"lineBreak":true},{"text":"¡Gamman yäracamoj sirbishojniqui caycaptëga salbaycamay ari!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios, imay örapis gamtami mañacaycämö.","poem":1},{"lineBreak":true},{"text":"Cuyapaycamay ari.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tayta Dios, gamtami mañacaycämö.","poem":1},{"lineBreak":true},{"text":"Gamta sirbiycaptëga cushicaycachimay ari.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Dios, gamga canqui allimi, imapitapis perdunajmi.","poem":1},{"lineBreak":true},{"text":"Amatarmi cuyanqui gamman mañacamojcunataga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Dios, mañacamushätaga wiyaycuy.","poem":1},{"lineBreak":true},{"text":"Ruwacamushätapis wiyaycamay.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Llaquicushä öra gamta mañacamö imaypis yanapämaptiquimi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Dios, manami gamnöga canchu.","poem":1},{"lineBreak":true},{"text":"Gam rurashayquitano ruräga manami pipis canchu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Dios, gammi camacächishcanqui nasyuncuna cananpaj.","poem":1},{"lineBreak":true},{"text":"Chay nasyuncho tiyaj runacunami adurashunquipaj, alabashunquipaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Gam japallayquimi Diosga canqui!","poem":1},{"lineBreak":true},{"text":"Gamllami canqui munayniyoj, milagrucunata rurajpis.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Dios, sumaj tantiyachimay gamta wiyacunäpaj.","poem":1},{"lineBreak":true},{"text":"Chauraga mana cachaypami sirbishayqui.","poem":1},{"lineBreak":true},{"text":"Shacyächimay llapan shongöpa gamllata aduranäpaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tayta Dios, llapan shongöpami alabashayqui, adurashayqui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nogataga fiyupami cuyamanqui.","poem":1},{"lineBreak":true},{"text":"Wañunäpitami salbamashcanquipis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tayta Dios, gamta mana yarpäshojcuna,","poem":1},{"lineBreak":true},{"text":"mana rispitacojcuna wañuchicojcunami conträ ricacusha.","poem":1},{"lineBreak":true},{"text":"Wañuchiytami munarcaycäman.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Dios, chaypis gamga canqui alli shongumi, cuyapäcojmi,","poem":1},{"lineBreak":true},{"text":"pasinsacojmi, cuyacojmi, rasun cajta rurajmi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ricäramushpayqui ¡cuyapaycamay ari!","poem":1},{"lineBreak":true},{"text":"¡Sirbishojniquitaga salbamay! ¡Callpä cananpaj yanapaycamay!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Cuyapäcoj cashayquita musyachimay.","poem":1},{"lineBreak":true},{"text":"Chayta ricar chiquimajcunaga pengacongami.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, gammi yanapämashpayqui cushicachimanqui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}