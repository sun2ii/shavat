{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":87,"content":[{"type":"heading","content":["Jerusalén siudäta Tayta Dios cuyashan"]},{"type":"hebrew_subtitle","content":["Corëpita mirajcuna isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Quiquin Tayta Diosmi Jerusalén siudäninta camacächisha rispitädu lömacho.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Dios cuyan Jerusalén siudätami.","poem":1},{"lineBreak":true},{"text":"Jerusalentaga Israel nasyuncho caycaj siudäcunapita masmi cuyan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Diospa siudänin, gampäga fiyupa allicunatami parlan. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tayta Diosmi parlasha: «Rejsimaj nasyun runacunaga carcaycan Egipto, Babilonia, Tiro, Etiopía, Filistea runacunami.","poem":1},{"lineBreak":true},{"text":"Chay nasyun runacunaga Jerusalén runacunanömi.»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jerusalenpäga waquin nenga: «Paymi maman. Payllapitami tagay nasyunpis cay nasyunpis yurisha.","poem":1},{"lineBreak":true},{"text":"Quiquin Tayta Diosmi camacächishapis» nir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chay nasyuncunapa jutinta Tayta Dios isquirbir nenga: «Llapanpis chay nasyuncunaga","poem":1},{"lineBreak":true},{"text":"Jerusalenllachömi yurisha» nir. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Llapanmi cantashpan dansashpan nenga:","poem":1},{"lineBreak":true},{"text":"«Jerusalenchömi yurishcä» nir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}