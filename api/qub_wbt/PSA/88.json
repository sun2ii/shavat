{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":88,"content":[{"type":"heading","content":["Wañuypita salbananpaj mañacushan"]},{"type":"hebrew_subtitle","content":["Corëpita mirajcuna isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Salbamaj Tayta Dios, chacaypa junajpapis","poem":1},{"lineBreak":true},{"text":"gamtami mañacaycämö yanapämänayquipaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Mañacamushäta wiyaycamay ari!","poem":1},{"lineBreak":true},{"text":"¡Ruwacamushätapis wiyaycamuy ari!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fiyupa mana allimanmi chayashcä.","poem":1},{"lineBreak":true},{"text":"Wañunäpänami caycäpis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nogapäga wañushapänönami yarparcaycanpis.","poem":1},{"lineBreak":true},{"text":"Pasaypa callpaynajnami ricacushcä.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wañushanönami caycäpis.","poem":1},{"lineBreak":true},{"text":"Wañojcunata pampashannönami caycä.","poem":1},{"lineBreak":true},{"text":"Gam manana yanapashayquinömi caycä.","poem":1},{"lineBreak":true},{"text":"Gongaycushayqui runacunanönami caycä.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogataga jitarpamashcanqui mas rurinnin uchcumanmi,","poem":1},{"lineBreak":true},{"text":"ruri fiyupa chacajninmanmi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rabyashayquitami nogacho päsacächishcanqui.","poem":1},{"lineBreak":true},{"text":"Chayasha mayu cuchpayllapa aywar ñiticurcojnömi ruraramashcanqui. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gammi camacächishcanqui amïgöcunapis jaguiycamänanpaj.","poem":1},{"lineBreak":true},{"text":"Gammi camacächishcanqui paycuna manana awantamänanpaj.","poem":1},{"lineBreak":true},{"text":"Cananga caycä prësu mana gueshpiyta puydejnömi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wagaycällarnami gaprayaycäpis.","poem":1},{"lineBreak":true},{"text":"Tayta Dios, waran-waranmi maquëtapis chojpacur gamllaman mañacaycämö.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¿Wañojcunaga ricangachuraj milagruta rurashayquita?","poem":1},{"lineBreak":true},{"text":"¿Wañojcunaga agradësicushunquimanchuraj? Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"¿Sepultürachöga cuyacoj cashayquita willanacunmanchuraj?","poem":1},{"lineBreak":true},{"text":"¿Wanwanyaycaj uchcuchöga alli cashayquita willanacunmanchuraj?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Fiyupa yanauyaycaj chacaycho musyanmanchuraj milagrucunata rurashayquita?","poem":1},{"lineBreak":true},{"text":"¿Allicunata rurashayquita yarpanmanchuraj imatapis manana yarpäna pachachöga?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nogami ichanga Tayta Dios gamllata gayacaycämö.","poem":1},{"lineBreak":true},{"text":"Tutallanami gamta mañacaycämö.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tayta Dios nogataga ¿imanirtaj manacajman churamanqui?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj nogapitaga pacacunqui?","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wamra cashäpita-pachami nogaga fiyupa llaquicullar goyashcä.","poem":1},{"lineBreak":true},{"text":"Wañuyllami tumapämasha.","poem":1},{"lineBreak":true},{"text":"Fiyupa manchariypajcunawanmi ñacachimashcanqui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rabyawan ñacachimashayquimi nogataga chayamasha.","poem":1},{"lineBreak":true},{"text":"Ñacachimaptiquimi ima ruraytapis mana camäpacönachu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ñacaymi imay örapis tumapaycäman aypalla yacu jundir ñitiycämajno.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nogapitaga gargushcanqui amïgöcunata yan'guëcunatapis.","poem":1},{"lineBreak":true},{"text":"Cananga yanauyaycaj chacayllachönami caycä.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}