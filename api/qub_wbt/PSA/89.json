{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":89,"content":[{"type":"heading","content":["Tayta Dioswan David alli parlacushan"]},{"type":"hebrew_subtitle","content":["Ezraíta runa Etán yachachir isquirbishan."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, cuyapäcoj cashayquipitami imaypis alabashayqui.","poem":1},{"lineBreak":true},{"text":"Imaypis willacushämi llapanta cumlej cashayquitaga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nogaga willacushaj wasipa alli simintunnöpis imaycamapis cuyacoj cashayquitami.","poem":1},{"lineBreak":true},{"text":"Gampa palabrayquega syëlu imaypis mana rucaj cashannömi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Davidwanpis allimi parlacurayqui.","poem":1},{"lineBreak":true},{"text":"Acrashayqui sirbishojniquitami aunirayqui:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«Nogami camacächishaj gampita mirajcuna","poem":1},{"lineBreak":true},{"text":"imaycamapis ruquiqui mandaj cananpaj» nir. Selah","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Dios, janaj pachacho caycajcunami alabashunqui","poem":1},{"lineBreak":true},{"text":"llapanta cumlej cashayquipita, milagrucunata rurashayquipitapis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Manami ima diospis, ni syëlucho caycajcunapis gammanga tincunchu!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Janaj pachacho llapan shuntacasha caycashanchöpis gamtaga manchacushunquimi.","poem":1},{"lineBreak":true},{"text":"Anjilcuna tumaparaycäshushayquichöpis gamga canqui fiyupa manchacuypaj munayniyojmi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ima-aycapäpis munayniyoj Tayta Dios ¿piraj gammanga tincunman?","poem":1},{"lineBreak":true},{"text":"Gamllami rasunpa cajtapis ruranqui; munayniyoj canqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bötiypa bötiycaj lamarta gammi chawächinqui.","poem":1},{"lineBreak":true},{"text":"Wayrawan pullchajyaycajtapis chawächinqui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lamarcho manchacuypaj caycaj waräcuytapis wañusha runatanöllami ñitirishcanqui.","poem":1},{"lineBreak":true},{"text":"Chiquishojcunatapis munayniquiwanmi mashtaypa mashtarishcanqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Syëlupis cay pachapis gamllapami.","poem":1},{"lineBreak":true},{"text":"Gammi camashcanqui mundutapis, munducho caycajcunatapis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mundutaga juc cuchunpita jucaj cuchuncama gammi camashcanqui.","poem":1},{"lineBreak":true},{"text":"Tabor puntawan Hermón puntapis cushishami gamta alabashunqui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gamga munayniyojmi canqui.","poem":1},{"lineBreak":true},{"text":"Gampa maquiquega llapanta binsinanpaj fiyupa callpayojmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Gam mandashpayquega allitami ruraycanqui, rasun cajtami ruraycanqui.","poem":1},{"lineBreak":true},{"text":"Cuyacoj cashayquitami nogacunata musyaycächimanqui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Cushishami cawanga alabashojcunaga,","poem":1},{"lineBreak":true},{"text":"gampa ñaupayquicho purejcunaga.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Paycunaga jutiquita parlashpan cushisha goyan.","poem":1},{"lineBreak":true},{"text":"Allita ruraj cashayquipitapis cushicuchun.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chayno goyanga munayniyoj cananpaj rispitasha cananpaj yanapaptiquimi.","poem":1},{"lineBreak":true},{"text":"Gam cuyacoj cashpayqui yanapämaptiquimi nogacuna munayniyoj cashaj.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Tayta Dios, gammi canqui chapacuna escüdö!","poem":1},{"lineBreak":true},{"text":"¡Israelpa Santo Diosnin, gammi canqui nogacunapa raynë!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Unayga acrashayqui runacunata ribilaypami tantiyachirayqui.","poem":1},{"lineBreak":true},{"text":"Paycunatami nirayqui:","poem":1},{"lineBreak":true},{"text":"«Israel runacunapitami jinyunninta acrashcä.","poem":1},{"lineBreak":true},{"text":"Paytaga nogami yanapashcä mas allicho cananpaj.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Sirbimaj Davidtami acrashcä.","poem":1},{"lineBreak":true},{"text":"Ray cananpämi rispitädu asëtita umanman wiñapashcä.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Paytaga imaypis yanapäshämi.","poem":1},{"lineBreak":true},{"text":"Munaynëwanmi sumaj callpayojyächishaj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chiquejcunapis manami magangachu.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunapis manami binsengachu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Payta chiquejcunataga llapirishämi.","poem":1},{"lineBreak":true},{"text":"Chay runacunataga ichic-ichicllami rurarishaj.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Paytaga yanapaycäshämi.","poem":1},{"lineBreak":true},{"text":"Aunishätapis cumlishämi.","poem":1},{"lineBreak":true},{"text":"Yanapaptëmi mas munayniyoj ricaconga.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mediterráneo lamarpita Éufrates mayucama mandananpämi camacächishaj.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Paymi nimanga: ‹Gammi papänë canqui.","poem":1},{"lineBreak":true},{"text":"Diosnë canqui, Salbamaj, imapitapis chapämaj canqui› nir.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nogapapis payga guechpa wamrämi canga.","poem":1},{"lineBreak":true},{"text":"Payga cay pachacho caj raycunapita mas munayniyojmi canga.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Paytaga imaypis chaynöllami cuyaycäshaj.","poem":1},{"lineBreak":true},{"text":"Paywan parlacushätaga manami imaypis rucachishächu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Syëlu manaraj ushacashancamaga paypita mirar aywajcuna imaypis mandaycangami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"«Yachachishäta paycuna gongaycuptin,","poem":1},{"lineBreak":true},{"text":"imanöpis rurananpaj nishäno mana ruraptin,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"laynëta mana cumliptin,","poem":1},{"lineBreak":true},{"text":"mandamintöcunata mana wiyacuptin","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"castigashaj gueruwan wiruypapis mana wiyacamashanpita, mana allicunata rurashanpita.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Chaypis Davidtaga mana cachariypami cuyaycäshaj.","poem":1},{"lineBreak":true},{"text":"Paypaj imata aunishätapis manami cutiricushächu.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Paywan parlacushätaga manami rucachishächu.","poem":1},{"lineBreak":true},{"text":"Palabrätaga cumlishämi.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Davidtaga aunishcä jutëcho jurarmi.","poem":1},{"lineBreak":true},{"text":"Paytaga manami llullapäshächu.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Paypita mirar aywajcunaga imaypis mandaycangami.","poem":1},{"lineBreak":true},{"text":"Inti caycashancamaga mandaycangami.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Mandaj cashanga canga quillano.","poem":1},{"lineBreak":true},{"text":"Mana illgaypami mandaycanga syëlu manaraj ushacashanyäga.» Selah","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Chayno aunisha caycashpayquipis","poem":1},{"lineBreak":true},{"text":"manacajmanmi churashcanqui acrashayqui raytaga.","poem":1},{"lineBreak":true},{"text":"Paypäga fiyupami rabyacurcushcanqui.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Umancho caycaj corönantapis pampamanmi jitarishcanqui.","poem":1},{"lineBreak":true},{"text":"Sirbishojniquiwan alli parlacushayquitapis manami cumlishcanquichu.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Siudänincunapa curralnincunatapis gashargärishcanquimi.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Pï-maypis chaypa päsajcunaga munashantami suwapan.","poem":1},{"lineBreak":true},{"text":"Läduncho tiyajcunapis asipan.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Davidta chiquejcuna callpayoj cananpämi yanapashcanqui.","poem":1},{"lineBreak":true},{"text":"Chaymi binsisha.","poem":1},{"lineBreak":true},{"text":"Cananga chiquejcuna cushisha carcaycan.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Raypa fïnu sablin caycajcunatapis ronguyächishcanqui.","poem":1},{"lineBreak":true},{"text":"Pillyachöpis mananami yanapashcanquichu.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Munayniyoj caynintami guechushcanqui.","poem":1},{"lineBreak":true},{"text":"Sillunnintapis jitarishcanqui.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Mösu cashan timpupis manami alliga cawachishcanquichu.","poem":1},{"lineBreak":true},{"text":"Pasaypami pengacachishcanquipis. Selah","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Tayta Dios, ¿imaycamaraj pacaräcunqui?","poem":1},{"lineBreak":true},{"text":"¿Fiyupa rabyasha caycashayqui manachuraj päsanga?","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Tayta Dios, yarpäriy ari noga päsacojlla cashäta.","poem":1},{"lineBreak":true},{"text":"Runacunaga yupasha watallami cawä.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Manami pipis canchu mana wañöga.","poem":1},{"lineBreak":true},{"text":"Sepultürapitaga manami pipis gueshpinchu. Selah","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Tayta Dios, ¿maytaj ñaupata cuyacoj cashpayqui","poem":1},{"lineBreak":true},{"text":"sirbishojniqui Davidta aunishayquega?","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Tayta Dios, wiyaycuy ari.","poem":1},{"lineBreak":true},{"text":"Sirbishojcunataga achcaj runami asiparcaycan.","poem":1},{"lineBreak":true},{"text":"Imano gayapashancunatapis shongullächömi yarparaycä.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Tayta Dios, chiquishojcunaga asipaycämanmi.","poem":1},{"lineBreak":true},{"text":"Imay örapis gayaparcaycämanmi gam acrashayquicunataga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Tayta Diosga imaycamapis alabasha cachun.","poem":1},{"lineBreak":true},{"text":"¡Chayno cachun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}