{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":9,"content":[{"type":"heading","content":["Ñacajcunatapis Tayta Dios ricashan"]},{"type":"hebrew_subtitle","content":["David isquirbishan alabansa."]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, llapan shongöpami alabayta munä.","poem":1},{"lineBreak":true},{"text":"Allita rurashayquitaga llapantami willacushaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Munayniyoj Tayta Diosnë gampaj cushicurmi gamta alabä.","poem":1},{"lineBreak":true},{"text":"¡Alabansacunatami cantashaj!","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Chiquimajcuna gampitaga gueshpinmi.","poem":1},{"lineBreak":true},{"text":"Tunerga jinanchömi wañun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gamga alli juez carmi dimandöta alli arriglanqui.","poem":1},{"lineBreak":true},{"text":"Jamaränayquiman jamaycushcanqui llapanta jusganayquipaj.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Mana rispitashojcunataga piñacushcanquimi.","poem":1},{"lineBreak":true},{"text":"Mana wiyacojcunataga illgächishcanquimi.","poem":1},{"lineBreak":true},{"text":"Paycunataga para-simrina gongaycärinanpämi camacächishcanqui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chiquimajcunaga wañushanami.","poem":1},{"lineBreak":true},{"text":"Quiquinwan iwalmi illgasha siudänincunapis.","poem":1},{"lineBreak":true},{"text":"Gammi illgächishcanqui.","poem":1},{"lineBreak":true},{"text":"Paycunapaga manami imallanpis quëdashachu yarpänanpaj.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Tayta Diosmi ichanga imaycamapis ray canga.","poem":1},{"lineBreak":true},{"text":"Jusgananpaj jamacunantapis camacächisha.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cada ünuntami jusganga imano cashantapis.","poem":1},{"lineBreak":true},{"text":"Llapantapis iwalmi jusgangapaj.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Tayta Diosga imapita ñacaycajcunatapis chapanmi.","poem":1},{"lineBreak":true},{"text":"Payga llaquicuycajcunata washanmi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tayta Dios, gamta rejsishoj cäga gammanmi yäracun.","poem":1},{"lineBreak":true},{"text":"Gamman yäracamojtaga manami cachaycunquichu.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Sioncho mandaj caycaj Tayta Diospaj alabansata cantay.","poem":1},{"lineBreak":true},{"text":"Imata rurashantapis intëru marcacunacho willacuy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wañuchicojcunata castigäga manami gongangachu llaquicuycajcunata.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Tayta Dios, chiquimajcunaga fiyupami llaquicaycächiman.","poem":1},{"lineBreak":true},{"text":"¡Cuyapaycamay ari!","poem":1},{"lineBreak":true},{"text":"¡Wañuchimänantaga ama camacächiychu!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chaynöpami Jerusalenman yaycunacho willacushaj alabashunayquipaj.","poem":1},{"lineBreak":true},{"text":"Salbamashayquipitapis cushicushämi.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Mana rispitashojcunaga yaganga quiquincuna uchcuta rurashallanmanmi.","poem":1},{"lineBreak":true},{"text":"Togllata churashanpis quiquincunatami charenga.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tayta Dios gamga musyachimashcanqui allita ruraj cashayquitami.","poem":1},{"lineBreak":true},{"text":"Fiyucunaga watacäcusha quiquincuna churashan togllachömi. Selah","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Fiyucunawan Tayta Diosta mana rispitajcunaga","poem":1},{"lineBreak":true},{"text":"wañojcuna cashanmanmi chayanga.","poem":1}]},{"type":"verse","number":18,"content":[{"text":"Pobricunatami ichanga imaypis mana gonganquichu.","poem":1},{"lineBreak":true},{"text":"Gamman yäracamojcunataga yarparaycanquimi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tayta Dios apuray ari.","poem":1},{"lineBreak":true},{"text":"Ama camacächiychu fiyu runacuna alli-tucunantaga.","poem":1},{"lineBreak":true},{"text":"¡Mana rispitashojcunataga jusgay ari!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tayta Dios chay runacunataga fiyupa mancharachiy.","poem":1},{"lineBreak":true},{"text":"¡Mana rispitashojcunaga tantiyacuchun quiquin manacajlla cashanta! Selah","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}