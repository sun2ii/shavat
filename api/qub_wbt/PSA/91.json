{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":91,"content":[{"type":"heading","content":["Tayta Diosga pacacunanchïmi"]},{"type":"verse","number":1,"content":[{"text":"Janajcho caycaj Tayta Diospa maquincho goyaycaj runataga","poem":1},{"lineBreak":true},{"text":"Munayniyoj Tayta Dios chapanga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Diosta mañacurmi nishaj: «Tayta Dios, gammi pacacunä canqui.","poem":1},{"lineBreak":true},{"text":"Gammi callpayojyächimanqui.","poem":1},{"lineBreak":true},{"text":"Gammanmi yäracö» nir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tayta Diosllami salbashunquiman mana allicunaman chayanayquipita.","poem":1},{"lineBreak":true},{"text":"Wañuchicoj gueshyacunapitapis chapäshunquimanmi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paymi älancunawan chapashunquipaj.","poem":1},{"lineBreak":true},{"text":"Älan rurincho carnaga mananami manchacunquipänachu.","poem":1},{"lineBreak":true},{"text":"Payga imaypis escüdunömi chapaycäshunquipaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chacaypa imata mayarpis ama manchacuychu.","poem":1},{"lineBreak":true},{"text":"Junajpa lëcha janayquipa päsaptinpis ama manchacuychu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chacaypa gueshya chariptinpis ama manchacuychu.","poem":1},{"lineBreak":true},{"text":"Junajpa murti puriptinpis ama manchacuychu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ichoj caj-läduyquicho capas wañonga waranga.","poem":1},{"lineBreak":true},{"text":"Derëchu caj-läduyquicho capas wañonga chunca waranga.","poem":1},{"lineBreak":true},{"text":"Gamtami ichanga mana imapis päsashunquipächu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quiquiquimi ñawiquiwan ricanquipaj fiyu runacunata castïgu chayajta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Pacashunayquipämi Tayta Diosman gamga yäracushcanqui.","poem":1},{"lineBreak":true},{"text":"Paymanmi yäracushcanqui imapitapis chapäshunayquipaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chaymi mana chayashunquipächu ima mana allipis.","poem":1},{"lineBreak":true},{"text":"Famillyayquicunatapis gueshya manami charengapächu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Quiquin Tayta Diosmi anjilnincunata cachamonga ima-aycapitapis cuydashunayquipaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Anjilcunami janajllapa apashunquipaj","poem":1},{"lineBreak":true},{"text":"imamanpis mana tacacänayquipaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Liyuncuna caycashanpa,","poem":1},{"lineBreak":true},{"text":"waräcuy caycashanpa,","poem":1},{"lineBreak":true},{"text":"culebracuna caycashanpapis purinquipämi.","poem":1},{"lineBreak":true},{"text":"Chaycunataga lluchcargärinquipämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tayta Diosmi nin: «Cuyamaj runataga nogapis salbashämi.","poem":1},{"lineBreak":true},{"text":"Rejsimaj runataga nogapis pushashaj pipis mana chayananmanmi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gayacamaptenga yanapäshämi.","poem":1},{"lineBreak":true},{"text":"Sasa goyaycunachöpis quiquëmi paywan caycäshaj.","poem":1},{"lineBreak":true},{"text":"Llaquicuycunapitapis jorgushämi.","poem":1},{"lineBreak":true},{"text":"Nircurnami rispitädu cananpaj churashaj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Unaycamami cawachishaj.","poem":1},{"lineBreak":true},{"text":"Noga salbacoj cashäta musyachishaj.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}