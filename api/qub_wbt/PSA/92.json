{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":92,"content":[{"type":"heading","content":["Tayta Dios cuyacoj cashanpita alabashan"]},{"type":"hebrew_subtitle","content":["Säbadu jamay junajcho cantananpaj alabansa."]},{"type":"verse","number":1,"content":[{"text":"Janajcho caycaj Tayta Dios, sumaj allimi gamta agradësicuyga;","poem":1},{"lineBreak":true},{"text":"sumaj allimi cantar gamta alabayga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sumaj allimi cuyacoj cashayquita, aunishayquita cumlej cashayquita pagasta junajtapis willacuyga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sumaj allimi arpa-mallwawan, arpawan gamta alabayga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tayta Dios, gamga llapan rurashayquicunawanmi cushicachimashcanqui.","poem":1},{"lineBreak":true},{"text":"Chaypitami fiyupa cushisha alabashayqui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Dios, rurashayquicunaga fiyupa almiraypämi.","poem":1},{"lineBreak":true},{"text":"Yarpayniquega mana atipaypämi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chaymi mana tantiyacunchu llutan ruraj runacunaga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fiyucuna guewano mirashpanpis,","poem":1},{"lineBreak":true},{"text":"llapan mana allita rurashancuna alli llojshipaptinpis","poem":1},{"lineBreak":true},{"text":"paycunaga carcaycan para-simri illgänallanpämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tayta Dios, gammi ichanga janaj pachacho imaycamapis mandaycanquipaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Dios, chiquishojcunaga ushajpämi illganga.","poem":1},{"lineBreak":true},{"text":"Mana allita rurajcunaga machiypa-machirmi mashtacanga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Callpätapis gammi yurichishcanqui törupa callpanno cananpaj.","poem":1},{"lineBreak":true},{"text":"Gammi alli jamachimashpayqui umämanpis alli asyaj asëtita wiñapämashcanqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chiquimajcuna mana alliman chayajtapis ricashcämi.","poem":1},{"lineBreak":true},{"text":"Fiyucuna llaquicuycashantapis wiyashcämi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Alli runacunaga carcaycan cuyayllapaj palma yöra tucturaycajnörämi.","poem":1},{"lineBreak":true},{"text":"Miranpis Libanucho sedru wiñamojnörämi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chay lantacunanömi Tayta Diospa Wasincho carcaycan allita ruraj runacunaga.","poem":1},{"lineBreak":true},{"text":"Wasin Puncunchöpis carcaycan lantacuna waytajnörämi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Auquinna carpis yöra muruchajnömi caycanga.","poem":1},{"lineBreak":true},{"text":"Paycunaga berdiraycaj yöranömi sinchi carcaycanga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Paycunami willaconga chapämajnë Tayta Dios alli cashanta,","poem":1},{"lineBreak":true},{"text":"llapantapis rasun cajllata rurashanta.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}