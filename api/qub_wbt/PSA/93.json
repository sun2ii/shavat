{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":93,"content":[{"type":"heading","content":["Tayta Diosmi ray"]},{"type":"verse","number":1,"content":[{"text":"¡Tayta Diosmi ray!","poem":1},{"lineBreak":true},{"text":"¡Tayta Diosga achicyaypa achicyaycaj röpashami caycan!","poem":1},{"lineBreak":true},{"text":"Payga munayniyoj cayninwanmi fiyupa achicyacurcusha.","poem":1},{"lineBreak":true},{"text":"Paymi cay mundutapis sumaj tacyachisha mana cuyucunanpaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tayta Dios, gallarinanpita-pachami jamanayquita sumaj camacächirayqui.","poem":1},{"lineBreak":true},{"text":"¡Gamga imaypis caycashcanquimi!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios, mayucuna chayashpanmi fiyupa gaparan.","poem":1},{"lineBreak":true},{"text":"Cuchpayllapana aywaycanpis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chaypis Tayta Dios gamga cuchpayllapa aywaycaj mayupitapis,","poem":1},{"lineBreak":true},{"text":"gaparaycaj lamarpitapis mas munayniyojmi canqui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Dios, gammi estatutuyquicunata willaparayqui.","poem":1},{"lineBreak":true},{"text":"Chaycunaga yäracuypämi caycan.","poem":1},{"lineBreak":true},{"text":"¡Santo Dios cashayquimi Wasiquita sumaj camarächin!","poem":1},{"lineBreak":true},{"text":"¡Tayta Dios gamga imaypis caycanquimi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}