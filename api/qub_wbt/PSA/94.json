{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":94,"content":[{"type":"heading","content":["Tayta Dios llapanpa jueznin"]},{"type":"verse","number":1,"content":[{"text":"Tayta Dios, gammi caycanqui juez cay pachachöga.","poem":1},{"lineBreak":true},{"text":"Arriglayna ari.","poem":1},{"lineBreak":true},{"text":"Juchayoj cajtaga castigay.","poem":1},{"lineBreak":true},{"text":"¡Alli-tucojcunataga rurashanman-tupu ayñita cutichiy!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Dios, ¿imaycamaraj cushicurcaycanga fiyucunaga?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Imaycamaraj paycunaga alli-tucurcaycanga?","poem":1},{"lineBreak":true},{"text":"¿Imaycamaraj alabacurcaycanga?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Dios, paycunami acrashayqui runacunata illgächin.","poem":1},{"lineBreak":true},{"text":"Sirbishojniquicunatapis pengayman churan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Biyüdacunata, wañuchin.","poem":1},{"lineBreak":true},{"text":"Wacchacunata yarpaypa wañuchin.","poem":1},{"lineBreak":true},{"text":"Juc-lä runacunatana ñacachin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paycunaga nin: «Jacob rispitashan Diosga manami cuentata gocunchu. Manami ricamanchïpischu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mana tantiyacoj upa runacuna, ¿imanirtaj mana tantiyacunquichu?","poem":1},{"lineBreak":true},{"text":"¿Imaytaj tantiyacunquicuna?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Diosmi rurasha ñawinchïta rinrinchïtapis.","poem":1},{"lineBreak":true},{"text":"Chauraga ¿imanirtaj mana wiyanmanchu, mana ricanmanchu?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nasyuncunacho tiyajcunatapis alli rurananpaj piñacuycarga mana wiyacojcunataga ¿manachuraj castiganga?","poem":1},{"lineBreak":true},{"text":"¿Imanirtaj mana musyanmanchu runatapis yachacunanpaj tantiyachëga?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tayta Diosga musyanmi runa manacajcunallata yarpashancunata.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tayta Dios, cushishami cawanga imano cawananpäpis piñacushayqui runaga.","poem":1},{"lineBreak":true},{"text":"Cushishami cawanga Layniquita yachachishayqui runaga.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chay runaga manami imatapis gocongachu fiyupa mana allicuna chayaptinpis.","poem":1},{"lineBreak":true},{"text":"Fiyucunami ichanga sepultüraman chayanga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tayta Diosga manami cachaycongachu acrashan runacunata.","poem":1},{"lineBreak":true},{"text":"Sirbejnincunata japallantaga manami cachaycongachu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ushanantaga Tayta Dios munashannönami llapantapis arriglanga.","poem":1},{"lineBreak":true},{"text":"Alli runacunapis «chayno allimi» nenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"¿Pillaraj shamonga mana alli runacunapitawan fiyucunapita washämänanpaj?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Dios mana yanapämaptenga","poem":1},{"lineBreak":true},{"text":"maynami wañur chunyaraycäman caran.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Juc cutichömi gamta ruwacurä: «Chaquïcuna llushcacaycannami» nir.","poem":1},{"lineBreak":true},{"text":"Chauraga cuyacoj cashpayquimi yanapämarayqui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fiyupa ima-aycapitapis yarpachacur llaquicuycho caycaptëmi","poem":1},{"lineBreak":true},{"text":"gamga shacyächimashpayqui cushicachimanqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mana alli arriglaj juezcunapa amïgonga ama canquimanchu.","poem":1},{"lineBreak":true},{"text":"Paycunaga mana allimi arriglan.","poem":1},{"lineBreak":true},{"text":"Laynincunacho niycashanwanmi runacunata ñacachin.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Paycunaga alli runacunapa contranmi parlacun.","poem":1},{"lineBreak":true},{"text":"Juchan mana caycaptinmi wañuchinanpaj aunin.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chayno caycaptinpis Tayta Diosmi nogacunapa pacacunä.","poem":1},{"lineBreak":true},{"text":"Diosllami caycan imapitapis chapämaj gagaga.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fiyucunataga Tayta Diosmi castiganga mana allita rurashanpita.","poem":1},{"lineBreak":true},{"text":"Tayta Diosninchïmi illgarachenga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":22}