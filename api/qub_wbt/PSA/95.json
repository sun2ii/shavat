{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":95,"content":[{"type":"heading","content":["Tayta Diosta cushisha alabashun"]},{"type":"verse","number":1,"content":[{"text":"Shamuy-llapa, llapanchi Tayta Diosta cushisha alabashun.","poem":1},{"lineBreak":true},{"text":"Chapämajninchïta alabashun.","poem":1},{"lineBreak":true},{"text":"Salbamajninchïta alabashun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tayta Diosta agradësicoj aywashun.","poem":1},{"lineBreak":true},{"text":"Payta alabansacunawan alabashun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayta Diosga fiyupa munayniyojmi.","poem":1},{"lineBreak":true},{"text":"Paymi llapan dioscunapa raynin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paypa munaynillanchömi allpa rurincho cajpis.","poem":1},{"lineBreak":true},{"text":"Paypa munaynillanchömi altunnin puntacunapis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lamarpis payllapami. Lamartaga paymi camaranpis.","poem":1},{"lineBreak":true},{"text":"Quiquin maquinwanmi ruraran cay pachatapis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Shamuy-llapa, gongurpaycärir Tayta Diosta adurashun.","poem":1},{"lineBreak":true},{"text":"Paypa ñaupanman gongurpacushun ari.","poem":1},{"lineBreak":true},{"text":"Paymi ruramaranchïpis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paymi Diosninchi. Noganchïnami canchi acrashan runacuna.","poem":1},{"lineBreak":true},{"text":"Noganchëga caycanchi tajta pampacho caycaj uyshancunanömi.","poem":1},{"lineBreak":true},{"text":"Tayta Dios nishanta canan wiyacuy-llapa. Paymi nin:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«Ama caychu Meriba particho rurashayquicunano mana wiyacöga.","poem":1},{"lineBreak":true},{"text":"Ama caychu chunyaj Masah particho","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"unay caj awiluyquicuna musyapämänanpaj rurashannöga.","poem":1},{"lineBreak":true},{"text":"Paycunaga rurashäta ricaycarpis musyapämaytaraj munaran.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chay wichan cawaycajcunapäga chuscu chunca watami rabyashalla cacurä.","poem":1},{"lineBreak":true},{"text":"Chaymi nirä: ‹Cay runacunaga pantacashami puricurcaycan.","poem":1},{"lineBreak":true},{"text":"¡Manami mandamintöcunata wiyacunchu!›","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chaypitami rabyar nirä:","poem":1},{"lineBreak":true},{"text":"‹Jamayta tarinanpaj aunishämanga manami yaycuchishächu› nir.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}