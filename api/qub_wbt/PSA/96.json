":5,"content":[{"lineBreak":true},{"text":"Waquin marcacunapa diosnincunaga mana bälejllami.","poem":1},{"lineBreak":true},{"text":"Tayta Diosninchïmi ichanga syëlutapis camasha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Pay caycashanchöga fiyupa achicyajmi!","poem":1},{"lineBreak":true},{"text":"¡Pay tiyashan cajchöga munayninpis caycanmi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Intëru marcacho tiyajcuna Tayta Dios munayniyoj cashanta musyay-llapa.","poem":1},{"lineBreak":true},{"text":"Payta aduray-llapa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Diosninchïta rispitanapaj cashanno rispitay-llapa.","poem":1},{"lineBreak":true},{"text":"Ofrendayquita apacurcur ayway Tayta Diospa wasinman.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tayta Diosta aduray-llapa cuyayllapaj Wasincho.","poem":1},{"lineBreak":true},{"text":"¡Paypa ñaupanchöga cay pachacho tiyajcuna sicsicyachun!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nasyuncunacho tiyajcunata «Tayta Diosmi Rayga» niy.","poem":1},{"lineBreak":true},{"text":"Paymi cay mundutapis sumaj tacyachisha mana cuyunanpaj.","poem":1},{"lineBreak":true},{"text":"Paymi llapan runacunatapis iwalninchïta mandamanchi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Syëlupis cay pachapis cushicuchun!","poem":1},{"lineBreak":true},{"text":"¡Lamar yacupis, chaycho caycajcunapis gaparpächun!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chacracunapis chaycho caycajcunapis cushicuchun.","poem":1},{"lineBreak":true},{"text":"Munticho caj yöracunapis llapan cushicuypita gaparpächun.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Shaycämoj Tayta Diospa ñaupancho cantay-llapa.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga llapan runacunata jusgananpämi shaycämun.","poem":1},{"lineBreak":true},{"text":"Payga llapantapis allimi arriglanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}