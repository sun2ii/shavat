{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":97,"content":[{"type":"heading","content":["¡Tayta Diosmi ray!"]},{"type":"verse","number":1,"content":[{"text":"¡Tayta Diosninchïmi rayga!","poem":1},{"lineBreak":true},{"text":"¡Cay pachacho caycajcuna cushicuy!","poem":1},{"lineBreak":true},{"text":"¡May caru lamar chaupin tishgucunacho caycajcunapis cushicuy-llapa!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pay mandashpanga allitami ruraycan, rasun cajtami ruraycan.","poem":1},{"lineBreak":true},{"text":"Payga caycan yana pucutaypa chaupinchömi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paypa ñaupantaga nina rataycajmi aywan.","poem":1},{"lineBreak":true},{"text":"Chay ninami payta chiquejcunataga rupar ushacurcun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Illguyninpis intërutami cay munduta achicyan.","poem":1},{"lineBreak":true},{"text":"Chayta ricar cay pachaga fiyupami sicsicyan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cay pachapa duyñonga Tayta Diosmi.","poem":1},{"lineBreak":true},{"text":"Paypa ñaupanchöga jircacunapis wacpa caypami gotucäcun sëra chulluycajnöraj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Dios allita ruraj cashanta syëlucunami willacun.","poem":1},{"lineBreak":true},{"text":"May-chaychöpis tiyajcunanami rican alli cashanta.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pengay-tucushami canga ïdulucunata adurajcunaga.","poem":1},{"lineBreak":true},{"text":"Ïduluncunallawanmi paycunaga alli-tucusha.","poem":1},{"lineBreak":true},{"text":"Llapan dioscunapis Tayta Diostaga rispitanmi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios, alli jusgashayquipitami Judá particho caycaj siudäcunawan Sionga fiyupa cushicun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Janaj pachacho caycaj Tayta Dios,","poem":1},{"lineBreak":true},{"text":"gamga caycanqui intëru allpa jananpa,","poem":1},{"lineBreak":true},{"text":"waquin dioscunapitaga mas janajchöraj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tayta Diosta cuyajcunaga mana alli runacunapita witicuy.","poem":1},{"lineBreak":true},{"text":"Payga wiyacojcunata wañuypitapis chapanmi.","poem":1},{"lineBreak":true},{"text":"Fiyu runacunapitapis salbanmi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Allita ruraj runataga Tayta Diosmi achquipanga.","poem":1},{"lineBreak":true},{"text":"Tayta Dios munashanno ruraj runacunapäpis cushicuymi canga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Chaymi alli ruraj runacunaga Tayta Dios rurashanpita cushicuy!","poem":1},{"lineBreak":true},{"text":"¡Juchaynaj Tayta Diosninchïta agradësicuy!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}