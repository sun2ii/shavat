cushpayqui llapayqui Tayta Diosta alabay.","poem":1},{"lineBreak":true},{"text":"Cushicushpayqui llapan shonguyquiwan alabay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tayta Diosta alabay arpa wagashanwan,","poem":1},{"lineBreak":true},{"text":"waquin caj cuerdayoj instrumentucuna wagashanwan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Dios Ray captin ñaupancho cushisha cantar alabay","poem":1},{"lineBreak":true},{"text":"trompëtacuna y tucana wagracuna wagashanwan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lamar yacupis, lamarcho caycajcunapis,","poem":1},{"lineBreak":true},{"text":"mundupis, munducho caycajcunapis gaparpächun.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cushicuypita mayucunapis gaparpächun.","poem":1},{"lineBreak":true},{"text":"Jircacunapis cushicuypita gaparpächun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Shaycämoj Tayta Diospa ñaupancho cantay-llapa.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga llapan runacunata jusgananpämi shaycämun.","poem":1},{"lineBreak":true},{"text":"Payga llapantapis iwalmi arriglanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}