{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"PSA","translationId":"qub_wbt","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"2798ad8d57c7c02ed334f9bb9aa5b08ffa788455c50b39df24df912913a8c0e1","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/qub_wbt/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":99,"content":[{"type":"heading","content":["Tayta Diosllami mas munayniyoj ray"]},{"type":"verse","number":1,"content":[{"text":"Tayta Diosmi rasunpa rayga.","poem":1},{"lineBreak":true},{"text":"Llapan nasyun runacunapis sicsicyachun.","poem":1},{"lineBreak":true},{"text":"Paypaga jamananpis caycan querubín anjilcuna caycashanchömi.","poem":1},{"lineBreak":true},{"text":"Intëru cay pachapis sicsicyachun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sionchöga Tayta Dios fiyupa munayniyojmi.","poem":1},{"lineBreak":true},{"text":"Tayta Diosga cay pachacho caj marcacunata llapantami munaynincho chararaycan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Manchacuypaj, jatun munayniyoj Tayta Diosta alabay-llapa.","poem":1},{"lineBreak":true},{"text":"¡Tayta Diosga pasaypa santumi!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gammi munayniyoj ray canqui Tayta Dios.","poem":1},{"lineBreak":true},{"text":"Allita ruraj cajta cuyanqui.","poem":1},{"lineBreak":true},{"text":"Gammi camacächishcanqui llapanpis iwal cananpaj.","poem":1},{"lineBreak":true},{"text":"Israel runacuna caycashanchöga gammi alli cajta rasun cajta rurashcanqui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Tayta Diosninchïta alabay-llapa!","poem":1},{"lineBreak":true},{"text":"¡Paypa ñaupanman llapaniqui gongurpacuy!","poem":1},{"lineBreak":true},{"text":"¡Tayta Diosga santumi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aaronwan Moisés cürancuna caran.","poem":1},{"lineBreak":true},{"text":"Samuelnami caran Tayta Diosta mañacoj.","poem":1},{"lineBreak":true},{"text":"Paycuna mañacuptin Tayta Diosnami yanapaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paycunatami Tayta Diosga willaparan pucutay ichiraycajpita.","poem":1},{"lineBreak":true},{"text":"Paycunanami cumliran imata rurananpäpis willapashancunata. Laynincunatapis sumaj yachacuran.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tayta Dios paycunataga mañacushuptiqui gam wiyarayquimi.","poem":1},{"lineBreak":true},{"text":"Paycunata perdunaj Diosmi carayqui.","poem":1},{"lineBreak":true},{"text":"Mana allita rurajcunatami ichanga castigarayqui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¡Tayta Diosninchïta alabay-llapa!","poem":1},{"lineBreak":true},{"text":"¡Paypa rispitädu jirca puntancho gongurpacuy-llapa!","poem":1},{"lineBreak":true},{"text":"¡Tayta Diosga pasaypa santumi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}