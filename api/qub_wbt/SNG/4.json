{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"SNG","translationId":"qub_wbt","name":"CANTARES","commonName":"CANTARES","title":"Cantares","order":22,"numberOfChapters":8,"sha256":"31ca09e6930ca9c6636365c213cbf5a7df1dabc18feee2ab051fd1a49a5d9115","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/qub_wbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Cuyaynë, fiyupa cuyayllapämi canqui.","poem":1},{"lineBreak":true},{"text":"Rasunpami cuyayllapaj canqui.","poem":1},{"lineBreak":true},{"text":"Shucutacushayqui rurincho ñawiquicunaga caycan ishcay palumanömi.","poem":1},{"lineBreak":true},{"text":"Ajchayquicunapis aypalla cabra-mallwacuna","poem":1},{"lineBreak":true},{"text":"Galaad jircacunapa pañar purejnörämi caycan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quiruyquicunapis llapan cuyayllapaj yurajllami carcaycan.","poem":1},{"lineBreak":true},{"text":"Chayga caycan bäñashanpita","poem":1},{"lineBreak":true},{"text":"uyshacuna fïlayllanpa chayraj llojshirishano; rutunanpaj alli caycajnöna.","poem":1},{"lineBreak":true},{"text":"Llapanpis mana pishiypa iwal-llami caycan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Shimi wirpayquicunapis","poem":1},{"lineBreak":true},{"text":"puca jïlunörämi caycan.","poem":1},{"lineBreak":true},{"text":"Parlacuyniquega maysi wiyacuyllami.","poem":1},{"lineBreak":true},{"text":"Shucutarashayqui rurincho cärayquicunaga caycan granadata pullanpa partirishanömi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cuncayquega cuyayllapaj caycan David rurachishan cuyayllapaj törrinörämi.","poem":1},{"lineBreak":true},{"text":"Chay törrichöga waranganpami jinyu suldärucunapa chapacuna escüdun waguiraycan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ishcan chuchuyquicunaga caycan","poem":1},{"lineBreak":true},{"text":"millish lluychucuna","poem":1},{"lineBreak":true},{"text":"liryu waytacunapa chaupincho micuycajnöraj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Manaraj pacha warashanyaj,","poem":1},{"lineBreak":true},{"text":"manaraj intipis yagamushanyaj","poem":1},{"lineBreak":true},{"text":"aywashaj mïrra perfümi cashan jircaman,","poem":1},{"lineBreak":true},{"text":"insinsu cashan pataman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Cuyaynë, gamga cuyayllapämi canqui!","poem":1},{"lineBreak":true},{"text":"¡Chaquipita umacama camaraj cuyayllapämi canqui!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Majallä, aywacushun.","poem":1},{"lineBreak":true},{"text":"Líbano puntapita uräcushun.","poem":1},{"lineBreak":true},{"text":"Puntacunapita uräshun.","poem":1},{"lineBreak":true},{"text":"Liyuncuna tiyanan machaycunapita aywacushun.","poem":1},{"lineBreak":true},{"text":"Tigricuna tiyanan puntacunapitapis uräcushun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Cuyaynë, majallä,","poem":1},{"lineBreak":true},{"text":"shongötami pasaypa turwatächishcanqui.","poem":1},{"lineBreak":true},{"text":"Gam ricäramaptillayquimi,","poem":1},{"lineBreak":true},{"text":"wallgayquicho caycaj culur jïlullawanmi","poem":1},{"lineBreak":true},{"text":"shongö pasaypa cuyacurcushurayqui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Cuyaynë, majallä,","poem":1},{"lineBreak":true},{"text":"cuyamashayquega shongöcamarämi chayaycun.","poem":1},{"lineBreak":true},{"text":"Cuyamashayquega mishquej bïnupitapis mas allimi caycan.","poem":1},{"lineBreak":true},{"text":"Perfümiwan pichucushayquipis llapan perfümicunapita","poem":1},{"lineBreak":true},{"text":"mas cuyayllapämi asyan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Cuyaynë, shimi wirpayquega mishquinörämi.","poem":1},{"lineBreak":true},{"text":"Muchacuyniquipis lëchiwan mishqui caycajnörämi.","poem":1},{"lineBreak":true},{"text":"Röpayquipis Libanucho caycaj muntipa asyayninnörämi","poem":1},{"lineBreak":true},{"text":"cuyayllapaj asyan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Cuyayllä, majallä, gam caycanqui","poem":1},{"lineBreak":true},{"text":"intërunpa guenchasha wertano,","poem":1},{"lineBreak":true},{"text":"ushajpaj chapasha yacu pösuno,","poem":1},{"lineBreak":true},{"text":"pashtaj yacuta lläbishano.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Frütayoj wertanömi gamga canqui. Chay wertachömi caycan:","poem":1},{"lineBreak":true},{"text":"mishquej granada,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nardo, azafrán,","poem":1},{"lineBreak":true},{"text":"cuyayllapaj asyaj läbo-olor, canëla;","poem":1},{"lineBreak":true},{"text":"tucuy casta insinsu yöracuna.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Werta chaupincho pashtaycaj pucyumi canqui.","poem":1},{"lineBreak":true},{"text":"Yacu pashtaycämushan pösumi canqui.","poem":1},{"lineBreak":true},{"text":"Libanupita uraycaj yacumi canqui.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Wichaypa aywaj wayra, sumaj wayrämuy.","poem":1},{"lineBreak":true},{"text":"Uraypa aywaj wayra, shamuy cayman.","poem":1},{"lineBreak":true},{"text":"Wertäman wayrämushpayqui cuyayllapaj asyayninta cuyaynë cajman mashtacächiy.","poem":1},{"lineBreak":true},{"text":"Chayrämi cuyaynëga wertanman shamonga.","poem":1},{"lineBreak":true},{"text":"Chaycho frütacunapa mishquej wayuyninta miconga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}