{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"SNG","translationId":"qub_wbt","name":"CANTARES","commonName":"CANTARES","title":"Cantares","order":22,"numberOfChapters":8,"sha256":"31ca09e6930ca9c6636365c213cbf5a7df1dabc18feee2ab051fd1a49a5d9115","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/qub_wbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Cuyaynë, majallä, wertächönami caycä.","poem":1},{"lineBreak":true},{"text":"Maynami shuntashcäna mïrra perfümita, cuyayllapaj asyajcunatapis.","poem":1},{"lineBreak":true},{"text":"Sërallanchöraj caycaj mishquitapis maynami yawashcäna.","poem":1},{"lineBreak":true},{"text":"Lëchitawan bïnutapis maynami upushcä.","poem":1},"Yanasancuna",{"text":"Amïgöcuna, micuy, upuy.","poem":1},{"lineBreak":true},{"text":"Gamcunaga, aycatapis gustashayquita upuy.","poem":1}]},{"type":"heading","content":["Chuscu caj cantana"]},{"type":"verse","number":2,"content":[{"text":"Puñurpis mayaj mayajllami puñuycarä.","poem":1},{"lineBreak":true},{"text":"Chayno puñuycashächömi wiyarcurä puncupita cuyaynë gayacaycämushanta:","poem":1},"Runan",{"text":"¡Puncuta quichapaycallämay ari,","poem":1},{"lineBreak":true},{"text":"cuyaynillä, majallä,","poem":1},{"lineBreak":true},{"text":"cuyayllapaj paluma-mallwa!","poem":1},{"lineBreak":true},{"text":"¡Umäpis shullaypashami caycan!","poem":1},{"lineBreak":true},{"text":"¡Chacay shullay yacumi umäpitapis jutuycan!","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Maynami röpätapis lojticushcä.","poem":1},{"lineBreak":true},{"text":"¿Yapayrächari jaticushaj?","poem":1},{"lineBreak":true},{"text":"Maynami chaquëcunatapis mayllacushcä.","poem":1},{"lineBreak":true},{"text":"¿Yapayrächi chaquëcunapis ganranga?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Cuyaynëga maquinta jatircamuran puncupa uchcun caycajpa.","poem":1},{"lineBreak":true},{"text":"Chaura shongöpis tic-ticyaranrämi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaymi jinan öra jatarirä cuyaynëta quichapänäpaj.","poem":1},{"lineBreak":true},{"text":"Maquëpitapis mïrra perfümi juturcuranraj.","poem":1},{"lineBreak":true},{"text":"Dëdöcunapitapis mïrraga juturcuranraj.","poem":1},{"lineBreak":true},{"text":"Puncuta rancarajmanpis juturcuranraj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Cuyaynëta puncuta quichapariptë","poem":1},{"lineBreak":true},{"text":"payga manami cashanachu.","poem":1},{"lineBreak":true},{"text":"Aywacushana caran.","poem":1},{"lineBreak":true},{"text":"Gayacamushanta yarpärir fiyupa llaquicurä.","poem":1},{"lineBreak":true},{"text":"Ashirpis manami tariränachu.","poem":1},{"lineBreak":true},{"text":"Gayacuptëpis manami mayacarannachu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chayno ashir puriycajtami tarimaran","poem":1},{"lineBreak":true},{"text":"siudäta täpar tumaycaj runacunapis.","poem":1},{"lineBreak":true},{"text":"Magamashpan rachiy-rachiylla ruramasha.","poem":1},{"lineBreak":true},{"text":"Jacötapis firsapitami guechuramaran.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jerusalén jipashcuna, gamcunatami ruwacö:","poem":1},{"lineBreak":true},{"text":"cuyaynëta ricashpayquega","poem":1},{"lineBreak":true},{"text":"willaycapamay ari","poem":1},{"lineBreak":true},{"text":"«gampaj llaquicuyllawan gueshyaycan» nir.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Cuyayllapaj warmicunapitapis mas cuyayllapaj warmi,","poem":1},{"lineBreak":true},{"text":"¿ima cuyayllapätaj caycan cuyashayqui runaga","poem":1},{"lineBreak":true},{"text":"chayno nimashayquita nogacuna willanäpäga?","poem":1},{"lineBreak":true},{"text":"¿Imanirajtaj chay cuyashayqui runaga?","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Cuyaynëga camarajlla puca cärami.","poem":1},{"lineBreak":true},{"text":"Paytaga rejsinquimanmi chunca waranga runacuna goturaycashanchöpis.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Uma ajchanga achicyaycachaycanmi.","poem":1},{"lineBreak":true},{"text":"Yana cayninpis päbupanörämi achic-achicyaycan, jinachöpis goshpumi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ñawinpis ishcay paluma lëchiwan bäñacushanörämi.","poem":1},{"lineBreak":true},{"text":"Ishtanqui läduncho ratarpaycajnömi achicyaycachaycan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Cärancunaga shanshaypa-shanshaycan wertacunacho","poem":1},{"lineBreak":true},{"text":"alli asyaj waytacuna caycajnömi.","poem":1},{"lineBreak":true},{"text":"Shimi wirpancunapis caycan rösa wayta pashtaraycajnömi,","poem":1},{"lineBreak":true},{"text":"chay jananpa mïrra perfümi jutuycajnöraj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Maquincunapis caycan gori surtïjapa ñawinman perlascunata churapashanömi.","poem":1},{"lineBreak":true},{"text":"Cuerpunpis caycan camaraj llushway.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chancancunapis achicyaypa achicyaycachaycaj rumipita rurasha pilancucunanömi.","poem":1},{"lineBreak":true},{"text":"Goripita rurasha jamacunacho ichiraycajno caycan.","poem":1},{"lineBreak":true},{"text":"Paytaga ricärillarnami rejsinchi","poem":1},{"lineBreak":true},{"text":"Libanupita caj sedru guerucunatanöpis.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rimacuyninpis maysi wiyacuyllami.","poem":1},{"lineBreak":true},{"text":"Payga maysi cuyacuyllami.","poem":1},{"lineBreak":true},{"text":"Jerusalén jipashcuna,","poem":1},{"lineBreak":true},{"text":"chaynömi cuyashä runaga,","poem":1},{"lineBreak":true},{"text":"chaynömi yanasäga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}