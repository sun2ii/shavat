{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"SNG","translationId":"qub_wbt","name":"CANTARES","commonName":"CANTARES","title":"Cantares","order":22,"numberOfChapters":8,"sha256":"31ca09e6930ca9c6636365c213cbf5a7df1dabc18feee2ab051fd1a49a5d9115","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/qub_wbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Llapan warmicunapitapis mas cuyayllapaj warmi,","poem":1},{"lineBreak":true},{"text":"¿maypataj aywacusha cuyayniquega?","poem":1},{"lineBreak":true},{"text":"¿Maymantaj aywanman?","poem":1},{"lineBreak":true},{"text":"Ashej aywashun ari.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Cuyaynëga aywasha wertanmanmi.","poem":1},{"lineBreak":true},{"text":"Payga aywasha cuyayllapaj alli asyaycaj wayta wertanmanmi.","poem":1},{"lineBreak":true},{"text":"Chaymanmi aywasha uyshancunata michicoj,","poem":1},{"lineBreak":true},{"text":"rösa waytacunata pallaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nogaga cuyaynëpami cä, paypis nogallapami.","poem":1},{"lineBreak":true},{"text":"Payga uywancunata michin liryu waytacuna cashanchömi.","poem":1}]},{"type":"heading","content":["Pichga caj cantana"]},{"type":"verse","number":4,"content":[{"text":"Cuyaynë, gamga canqui Tirsa siudänöpis fiyupa cuyayllapämi,","poem":1},{"lineBreak":true},{"text":"Jerusalén siudänöpis maysi cuyacuyllami;","poem":1},{"lineBreak":true},{"text":"pipis mana ichipashan pillyaman aywaycaj suldärucunanömi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amana ricapämaynachu ari.","poem":1},{"lineBreak":true},{"text":"Ricapämashpayquega pengacachimanquimi.","poem":1},{"lineBreak":true},{"text":"Ajchayquicunapis cabra-mallwacuna","poem":1},{"lineBreak":true},{"text":"Galaad jircacunapa pañar purejnörämi caycan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quiruyquicunapis llapan cuyayllapaj yurajllami carcaycan.","poem":1},{"lineBreak":true},{"text":"Chayga carcaycan bäñashanpita","poem":1},{"lineBreak":true},{"text":"uyshacuna fïlayllanpa chayraj llojshirisha caycajno","poem":1},{"lineBreak":true},{"text":"millwanta rutunanpaj alli caycajnömi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Granadata pullanpa partirishanömi","poem":1},{"lineBreak":true},{"text":"shucutayqui rurincho cärayquega caycan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sojta chuncami (60) caycan raypa warmincunaga.","poem":1},{"lineBreak":true},{"text":"Pusaj chuncami (80) caycan chïnancunaga.","poem":1},{"lineBreak":true},{"text":"Raypa donsëlla jipashnincunaga aycashi caranpis.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chayno captinpis cuyashä palumäga jucnayllami.","poem":1},{"lineBreak":true},{"text":"Payllatami acrashcä.","poem":1},{"lineBreak":true},{"text":"Pay japallanmi caycan","poem":1},{"lineBreak":true},{"text":"maman gueshyacushpan mas cuyashan cäga.","poem":1},{"lineBreak":true},{"text":"Jipashcunapis ricashpan «alli goyay» nin.","poem":1},{"lineBreak":true},{"text":"Raypa warmincunapis, chïnancunapis paypäga allitami parlan.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"¿Pitaj chay watgarcamun","poem":1},{"lineBreak":true},{"text":"tutapa inti yagarcamojnöpis?","poem":1},{"lineBreak":true},{"text":"Quillanöpis cuyayllapämi,","poem":1},{"lineBreak":true},{"text":"intino achicyaycachaycaj,","poem":1},{"lineBreak":true},{"text":"pipis mana ichipashan pillyaman aywaycaj suldärucunanömi.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Nuwal yöracunalla caycashan muntipa aywashcä.","poem":1},{"lineBreak":true},{"text":"Aywashcä yacu aywaj ragra cantun pampa berdiraycajta ricapaj.","poem":1},{"lineBreak":true},{"text":"Übas chichiycajta, granada waytaraycajta","poem":1},{"lineBreak":true},{"text":"ricayta munashpämi urashcä.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chaypitaga manami musyashcänachu imano cashätapis.","poem":1},{"lineBreak":true},{"text":"Raynëpa ñaupanchöna cawallu garchashan carrëtacho ricacushcä.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"¡Cuticamuy, Sulamita, cuticamuy ari!","poem":1},{"lineBreak":true},{"text":"¡Gamta ricaytami munä! ¡Cuticamuy ari!","poem":1},"Warmin",{"text":"¿Imano caycajtataj Sulamitataga ricayta munarcaycanqui?","poem":1},"Yanasancuna",{"text":"¡Tolducunacho gachwajno gachwaycajtami ricayta munä!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}