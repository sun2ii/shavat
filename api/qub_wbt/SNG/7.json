{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"SNG","translationId":"qub_wbt","name":"CANTARES","commonName":"CANTARES","title":"Cantares","order":22,"numberOfChapters":8,"sha256":"31ca09e6930ca9c6636365c213cbf5a7df1dabc18feee2ab051fd1a49a5d9115","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/qub_wbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Raypa wamran, llanguiquichöga chaquiqui imano cuyayllapäshi camaran.","poem":1},{"lineBreak":true},{"text":"Chegllayquipis imano cuyayllapaj camarajshi caycan.","poem":1},{"lineBreak":true},{"text":"Adurnucunata fiyupa rurayta yachajcuna rurashanörämi camaraj caycan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pupuyquega caycan cöpano ruyru,","poem":1},{"lineBreak":true},{"text":"imaypis chaycho alli bïnu mana pishishanno.","poem":1},{"lineBreak":true},{"text":"Pachayquinami caycan juc gotuy rïgu goturaycajta","poem":1},{"lineBreak":true},{"text":"intëru cantunpa liryu wayta tumaparaycajno.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ishcan chuchuyquicunaga caycan","poem":1},{"lineBreak":true},{"text":"millish lluychucunanömi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cuncayquega llushwaypa llushwaycan cuyayllapaj arusha törrinömi.","poem":1},{"lineBreak":true},{"text":"Ñawiquinami caycan ishcay yacu ishtanqui","poem":1},{"lineBreak":true},{"text":"Hesbón siudächo caycajno,","poem":1},{"lineBreak":true},{"text":"Bat-Rabim puncupa ñaupancho caycajno.","poem":1},{"lineBreak":true},{"text":"Sengayquinami caycan Damascuman ricaraycaj","poem":1},{"lineBreak":true},{"text":"törri Libanucho caycajno camaraj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Umayquipis cuerpuyquichöga","poem":1},{"lineBreak":true},{"text":"caycan Carmelo puntano cuyayllapämi.","poem":1},{"lineBreak":true},{"text":"Ajchayquicunapis cuyayllapaj achic-achicyaycan.","poem":1},{"lineBreak":true},{"text":"¿Ajchayquiwanga rayta imanaycushcanquitaj pasaypa cuyacurcushunayquipäga?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Cuyaynë, gamga canqui fiyupa cuyayllapämi.","poem":1},{"lineBreak":true},{"text":"Mana cachaypa cuyacuypaj, fiyupa cuyayllapämi canqui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Palma yöra ichiraycajno cuyayllapämi canqui.","poem":1},{"lineBreak":true},{"text":"Chuchuyquicunanami chay yörapa wayuynin warcurpaycajno.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nogaga palma yöramanmi wichayta yarpaycä,","poem":1},{"lineBreak":true},{"text":"wayuynin warcuraycajcunata duyñu-tucurcunäpaj.","poem":1},{"lineBreak":true},{"text":"Chaura chuchuyquicunaga cangapaj sartanpa-sartanpa übas wayuraycajnömi.","poem":1},{"lineBreak":true},{"text":"Jämayniquinami mansänano asyanga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Parlacuyniquega mishquej alli bïnunömi.","poem":1},{"lineBreak":true},{"text":"Chayga caycan mishquej bïnu","poem":1},{"lineBreak":true},{"text":"shimi-wirpanchïpa, quirunchïpa mishquilla chayar päsarejnömi.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Nogaga cuyaynëpami cä.","poem":1},{"lineBreak":true},{"text":"Paypis nogawan iwal caytami munan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Cuyaynë, juclla aywashun jircaman.","poem":1},{"lineBreak":true},{"text":"Cuyayllapaj asyaj waytacunapa chaupincho warämushun.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tutapanami tumapacoj aywashun übas chacracunapa.","poem":1},{"lineBreak":true},{"text":"Chaychömi ricashun; mä maynachush mullcuycan wayunanpaj;","poem":1},{"lineBreak":true},{"text":"mä waytaraycannachush;","poem":1},{"lineBreak":true},{"text":"granadacunapis mä waytaycannachush.","poem":1},{"lineBreak":true},{"text":"Chaychömi musyachishayqui rasunpaypa cuyashäta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Alayrimi mandragorapa alli asyayninpis mayacaycämun.","poem":1},{"lineBreak":true},{"text":"Ñaupanchïchöga intërupami caycan tucuy casta frütacuna:","poem":1},{"lineBreak":true},{"text":"chaquisha frütacuna, chayraj pallarisha cajpis.","poem":1},{"lineBreak":true},{"text":"Chaytaga gampämi acrashcä.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}