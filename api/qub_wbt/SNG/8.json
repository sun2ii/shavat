uinwanna macallarcamanman ichanga.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Aunimay ari Jerusalén jipashcuna","poem":1},{"lineBreak":true},{"text":"cuyaynë puñucuycajta mana ricchachinayquipaj.","poem":1},{"lineBreak":true},{"text":"Puñucuchun puñuyta sacsashanyaj.","poem":1}]},{"type":"heading","content":["Sojta caj cantana"]},{"type":"verse","number":5,"content":[{"text":"¿Pitaj chunyajpita aywaycämöga?","poem":1},{"lineBreak":true},{"text":"¿Pitaj cuyayninta macallasha aywaycämun?","poem":1},"Runan",{"text":"Gamtaga mansäna yörapa chaquincho puñucuycajtami ricchachirä.","poem":1},{"lineBreak":true},{"text":"Chaychömi mamayquitapis nanay chariran.","poem":1},{"lineBreak":true},{"text":"Chaychömi mamayquega gueshyacushurayqui.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Nogataga mana gongaypa yarparämay.","poem":1},{"lineBreak":true},{"text":"Ricrayquichöpis jutë chäpashano cachun mana gongamänayquipaj.","poem":1},{"lineBreak":true},{"text":"Cuyanacuytaga wañuytano manami pipis chapanchu.","poem":1},{"lineBreak":true},{"text":"Fiyupa munanacuypitapis sepultürapitano manami gueshpinchïchu.","poem":1},{"lineBreak":true},{"text":"Cuyanacushanchëga Tayta Diospa ninannömi mana upinchu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aypalla lamar yacupis","poem":1},{"lineBreak":true},{"text":"manami gongachimashwanchu fiyupa cuyanacushanchïtaga;","poem":1},{"lineBreak":true},{"text":"ni mayucunapis manami chapämashwanchu.","poem":1},{"lineBreak":true},{"text":"Chayno cuyanacuycajta","poem":1},{"lineBreak":true},{"text":"juc runa ima-aycantapis «goycushayqui» niptenga","poem":1},{"lineBreak":true},{"text":"chay runata manacajmanmi churanman.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Pañinchïpaga manarämi chuchunpis pushpunrächu.","poem":1},{"lineBreak":true},{"text":"Payta ashej shamuptenga","poem":1},{"lineBreak":true},{"text":"¿imatataj rurashun?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pay curral pergano sigüru captenga","poem":1},{"lineBreak":true},{"text":"alli cashanpita paypa janancho guellaypitami juc palasyuta rurachishwan.","poem":1},{"lineBreak":true},{"text":"Pay puncu quicharaycajno captin ichanga jananpa sedru tablacunawan chaparcushwan.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Nogaga curral perganömi caycä.","poem":1},{"lineBreak":true},{"text":"Chuchöcunapis ricchacuna törricunanömi caycan.","poem":1},{"lineBreak":true},{"text":"Cuyaynëpa ñaupancho cashpäga","poem":1},{"lineBreak":true},{"text":"alli goyaychönami caycä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Salomonpaga Baal-hamonchömi übas chacran caran.","poem":1},{"lineBreak":true},{"text":"Chayta täpananpämi runacunata churaran.","poem":1},{"lineBreak":true},{"text":"Chay runacunami cosëcha ushayga","poem":1},{"lineBreak":true},{"text":"cada-ünun waranga (1,000) guellayta pägaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Waranga guellayga gampaj cacuchun Salomón.","poem":1},{"lineBreak":true},{"text":"Chacrata ricajcunapäpis ishcay pachac (200) guellay cacuchun.","poem":1},{"lineBreak":true},{"text":"Nogami ichanga übas chacräta quiquillä ricacö.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Wertacunacho cuyayllapaj caycaj warmi,","poem":1},{"lineBreak":true},{"text":"rimashayquita wiyashaj ari.","poem":1},{"lineBreak":true},{"text":"Yanasanchïcunami wiyayta munarcaycan.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Cuyaynë, cörrimuy ari.","poem":1},{"lineBreak":true},{"text":"Lluychuno cörrimuy.","poem":1},{"lineBreak":true},{"text":"Lluychupa wawannöraj","poem":1},{"lineBreak":true},{"text":"alli asyaycaj jircacuna jananpapis cörrimuy ari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ISA/1.json","nextChapterAudioLinks":{},