{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ZEC","translationId":"qub_wbt","name":"ZACARÍAS","commonName":"ZACARÍAS","title":"Zacarías","order":38,"numberOfChapters":14,"sha256":"98aacdd5b69333b1a227559b12d83a511401b3d9c307f6cfb00453bf55dd2996","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/qub_wbt/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["Acrashan runacunata Tayta Dios salbananpaj aunishan"]},{"type":"verse","number":1,"content":[{"text":"Tayta Diosta mañacuy-llapa micuy wiñaycashan wichan tamyachimunanpaj.","poem":1},{"lineBreak":true},{"text":"Chaura illguyta illgöchej Tayta Diosmi","poem":1},{"lineBreak":true},{"text":"intëruman tamyachimonga.","poem":1},{"lineBreak":true},{"text":"Llapan runatami micuyta tarichenga.","poem":1},{"lineBreak":true},{"text":"Chacracunachöpis lantacuna canga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wasi ïdulucuna ribilacushanmi ichanga mana rasunpachu.","poem":1},{"lineBreak":true},{"text":"Musyacojcuna «cayno wacno» nishanpis manami rasunpa cajchu.","poem":1},{"lineBreak":true},{"text":"Chay runacuna suyñucunata willacushanga manami rasunpachu.","poem":1},{"lineBreak":true},{"text":"Shacyächir willapashancunapis manami rasun cajchu.","poem":1},{"lineBreak":true},{"text":"Chaymi gamcunaga uysha mashtacajnöpis pantacasha carcaycanqui.","poem":1},{"lineBreak":true},{"text":"Uyshëruynaj uyshacuna-jinami fiyupa ñacarcaycanqui.","poem":1}]},{"type":"verse","number":3,"content":["Chaymi Tayta Diosga nin:",{"text":"«Nogaga fiyupami rabyacurcushcä mandajnincunapaj.","poem":1},{"lineBreak":true},{"text":"Acrashä runacunata pusharajcunataga castigashämi.","poem":1},{"lineBreak":true},{"text":"Chay uyshäcunataga noga munayniyoj Tayta Diosmi ricashaj.","poem":1},{"lineBreak":true},{"text":"Paycunaga caycan Judäpita mirar-aywaj runacunami.","poem":1},{"lineBreak":true},{"text":"Paycunaga canga guërracho pillyananpaj caycaj sinchi cawallucunanömi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paycunapitami yurengapaj llapan mandajcuna:","poem":1},{"lineBreak":true},{"text":"wasi isquïnan simintucho tucnaj rumino,","poem":1},{"lineBreak":true},{"text":"tolduta ichichinanpaj caycaj istäcano,","poem":1},{"lineBreak":true},{"text":"guërracho pillyananpaj lëchata jitacunanno.","poem":1},{"lineBreak":true},{"text":"Chaynömi paycunapitaga yurengapaj munayniyoj mandajcuna.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paycunaga pillyacho contrancunata binsir","poem":1},{"lineBreak":true},{"text":"cällicunacho caycaj mituchömi lluchcar-ushanga.","poem":1},{"lineBreak":true},{"text":"Paycunaga pillyanga noga yanapajnin captëmi.","poem":1},{"lineBreak":true},{"text":"Cawallun muntasha cajcunatami pengayman churangapaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Nogami callpayojyächishaj Judäpita mirar aywaj runacunataga.","poem":1},{"lineBreak":true},{"text":"Josëpita mirar aywajcunatapis salbashaj.","poem":1},{"lineBreak":true},{"text":"Yapaymi cutichimur nasyunninman pushamushaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga rurashaj paycunata cuyapashpämi.","poem":1},{"lineBreak":true},{"text":"Chaura paycunaga cangapaj noga imaypis mana cachaycushänömi.","poem":1},{"lineBreak":true},{"text":"Nogami caycä mañacamashanta wiyaj Tayta Diosnin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel runacunaga suldärunömi canga.","poem":1},{"lineBreak":true},{"text":"Fiyupa cushishami carcaycangapaj runa bïnuta upur caycashannöraj.","poem":1},{"lineBreak":true},{"text":"Ricashpan wamrancunapis fiyupami cushiconga.","poem":1},{"lineBreak":true},{"text":"¡Yanapashäpitami cushicur alabamanga!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Israelcunataga wichyacur gayashpämi juc pachallaman shuntashaj.","poem":1},{"lineBreak":true},{"text":"Chaynöga shuntashaj noga salbasha cashpämi.","poem":1},{"lineBreak":true},{"text":"Chauraga unay wichan aypalla cashanno","poem":1},{"lineBreak":true},{"text":"yupaytapis mana atipaypämi cangapaj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nogami machicächishcä juc-lä nasyuncunaman.","poem":1},{"lineBreak":true},{"text":"Ichanga may carucho cashpanpis paycuna nogata yarpämangami.","poem":1},{"lineBreak":true},{"text":"Nircorga wamrancunawannami cutimonga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Cutichimushämi Egipto nasyunpita.","poem":1},{"lineBreak":true},{"text":"Shuntamushämi Asiria nasyunpitapis.","poem":1},{"lineBreak":true},{"text":"Nircorga pushashaj Galaadcamami, Libanucamami.","poem":1},{"lineBreak":true},{"text":"Paycunaga fiyupa aypallami cangapaj.","poem":1},{"lineBreak":true},{"text":"Chaymi chaychöpis tiyananpaj pishengaraj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lamarta päsajnömi ñacaycunacho goyanga.","poem":1},{"lineBreak":true},{"text":"Chaypis lamarpa pullchajyaynincunaga manami imatapis rurangachu.","poem":1},{"lineBreak":true},{"text":"Nilo mayutapis ushajpämi chaquirachishaj.","poem":1},{"lineBreak":true},{"text":"Asiria runacuna alli chölu-tucoj cashantapis manacajmanmi churashaj.","poem":1},{"lineBreak":true},{"text":"Egipto runacuna munayniyoj caycashantapis illgächishämi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Acrashäcunataga nogami callpayojyächishaj.","poem":1},{"lineBreak":true},{"text":"Nircorga nogaman yäracamushpannami aywanga.","poem":1},"Noga Tayta Diosmi chayno në.»"]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}