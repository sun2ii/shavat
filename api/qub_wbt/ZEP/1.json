{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ZEP","translationId":"qub_wbt","name":"SOFONÍAS","commonName":"SOFONÍAS","title":"Sofonías","order":36,"numberOfChapters":3,"sha256":"61c2430155d92949715e012e4bac1230f0230ce25278061834c0941d3b6d59e6","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/qub_wbt/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"heading","content":["Tayta Dios rabyashan junaj imano cananpäpis"]},{"type":"verse","number":1,"content":["Amonpa wamran Josías Judäpa raynin caycashan wichanmi Tayta Diosga Sofoniasta ribilaran. Sofonías caran Cusipa wamran, payna Gedaliaspa wamran, payna Amariaspa wamran, payna Ezequiaspa wamran."]},{"type":"verse","number":2,"content":["Tayta Diosga caynömi nin:",{"text":"«Munducho cajtaga ushajpämi illgächej-aywä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Illgächej-aywä runacunata, animalcunata.","poem":1},{"lineBreak":true},{"text":"Chaynöllami illgächishaj äbicunata, pescäducunatapis.","poem":1},{"lineBreak":true},{"text":"Fiyu runacuna mana alliman chayananpämi camacächishaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami allpa jananpitaga ushajpaj runacunata illgächishaj.»","poem":1},"Tayta Diosga caynömi nin:"]},{"type":"verse","number":4,"content":[{"text":"«Judá runacunatami castigaj-aywä.","poem":1},{"lineBreak":true},{"text":"Jerusalencho tiyajcunatapis castigajmi-aywä.","poem":1},{"lineBreak":true},{"text":"Chay partipaga ushajpämi Baal dios-niraj ïdulucunata","poem":1},{"lineBreak":true},{"text":"llapan cürancunatapis illgächishaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wasin jananman wichaycur syëlucho caycaj goyllarcunata adurajtapis illgarachishämi.","poem":1},{"lineBreak":true},{"text":"Gongurpacushpan nogapa jutëcho jurarcur","poem":1},{"lineBreak":true},{"text":"‹dios Milcompa jutincho› nir jurajcunatapis illgächishämi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Illgächishämi nogata gongaycamajcunata,","poem":1},{"lineBreak":true},{"text":"Noga nishäta rurananpaj mana yarpachacojcunata,","poem":1},{"lineBreak":true},{"text":"mana tapucamajcunatapis.»","poem":1}]},{"type":"verse","number":7,"content":["Tayta Dios caynömi nin:",{"text":"«Upällalla cay-llapa.","poem":1},{"lineBreak":true},{"text":"Jusganäpaj caj junäga chayaycämunnami.","poem":1},{"lineBreak":true},{"text":"Chay junajpäga llapanpis camarishallanami caycan.","poem":1},{"lineBreak":true},{"text":"Gayachishäcunapis chayamushanami.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chay jusganä junäga castigashaj","poem":1},{"lineBreak":true},{"text":"mandajcunata, raypa wamrancunata","poem":1},{"lineBreak":true},{"text":"y juc-lä nasyun runacunano röpata jaticojcunatapis.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Castigashäpaj juchasapa runacunapa custumrintano rurajcunata,","poem":1},{"lineBreak":true},{"text":"wañurcachir, llullacur suwapaypa","poem":1},{"lineBreak":true},{"text":"ima aycatapis mandajninpa wasinman shuntajcunata.»","poem":1}]},{"type":"verse","number":10,"content":["Tayta Diosga caynömi nin:",{"text":"«Chay junäga yanapänanpaj gayacushan wiyacanga","poem":1},{"lineBreak":true},{"text":"Pescädu jutiyoj puncupita-pachami.","poem":1},{"lineBreak":true},{"text":"Siudäpa cantun baryucho gaparashanpis wiyacangapämi.","poem":1},{"lineBreak":true},{"text":"Ñaupan lömacunacho gaparashanpis fiyupa manchariypämi wiyacangapaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mactes baryucho tiyaycajcunaga llapaniqui gaparpay.","poem":1},{"lineBreak":true},{"text":"Chay junäga llapan nigusyanticunami wañongapaj.","poem":1},{"lineBreak":true},{"text":"Llapan guellayta rucajcunami illgangapaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chay wichanga lamparinwan achquicurcurmi","poem":1},{"lineBreak":true},{"text":"Jerusalencho tiyajcunataga acramushaj.","poem":1},{"lineBreak":true},{"text":"Nircur castigashaj pogusha bïnupa gonchun tiyacurcushanno","poem":1},{"lineBreak":true},{"text":"mana yarpachacuypa caycaj runacunata.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga caynömi nircaycanpis:","poem":1},{"lineBreak":true},{"text":"‹¡Tayta Diosga manami imatapis rurangachu allita ni mana allitapis!› nir.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chaypitami ima-ayca charashancunatapis juc runacunana guechurcur apaconga.","poem":1},{"lineBreak":true},{"text":"Wasincunatapis illgächenga.","poem":1},{"lineBreak":true},{"text":"Tiyananpaj wasicunata arushanchöga manami tiyangapänachu.","poem":1},{"lineBreak":true},{"text":"Übascunata lantashanpa bïnuntapis manami upongapänachu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tayta Dios jusganan junaj chayamunanpäga wallcanami pishin.","poem":1},{"lineBreak":true},{"text":"Chay junäga rätumi chayaraycamoj-aywan.","poem":1},{"lineBreak":true},{"text":"Chay junäga canga fiyupa manchariypämi.","poem":1},{"lineBreak":true},{"text":"Chaura mana manchacojnin cajpis gaparangami.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chay junäga Tayta Dios fiyupa rabyashami caycanga.","poem":1},{"lineBreak":true},{"text":"Chay junäga canga fiyupa llaquicuy junajmi, ima-aycapis ushacänan, illgänan junajmi,","poem":1},{"lineBreak":true},{"text":"fiyupa yanauyaycaj chacaymi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chay junäga intërunpa curalasha caycaj siudäcunaman magaj yaycunanpämi,","poem":1},{"lineBreak":true},{"text":"jatuncaray törricuna caycajmanpis yaycunanpämi trompëtata tucashpan mandanga.","poem":1}]},{"type":"verse","number":17,"content":["Tayta Diosga caynömi nin:",{"text":"«Llapan runacunami nogapa conträ juchata rurasha.","poem":1},{"lineBreak":true},{"text":"Chaypitami runacunataga ñacayman chayachishaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami gapra runacunano purenga.","poem":1},{"lineBreak":true},{"text":"Yawarninpis ñuchu allpanömi mashtaranga.","poem":1},{"lineBreak":true},{"text":"Aychannami uywapa iscanno mashtaranga.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tayta Dios jusganan junäga manami runata salbangapächu","poem":1},{"lineBreak":true},{"text":"guellaynin ni gori charashanpis.","poem":1},{"lineBreak":true},{"text":"Tayta Dios rabyasha caycashanga ninanörämi nasyun intëruta usharengapaj.","poem":1},{"lineBreak":true},{"text":"Cay pachacho tiyajcunataga llapantami juc guepishtayllacho usharengapaj.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}