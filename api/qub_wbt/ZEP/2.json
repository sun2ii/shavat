{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ZEP","translationId":"qub_wbt","name":"SOFONÍAS","commonName":"SOFONÍAS","title":"Sofonías","order":36,"numberOfChapters":3,"sha256":"61c2430155d92949715e012e4bac1230f0230ce25278061834c0941d3b6d59e6","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/qub_wbt/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Pengacuyta mana yachaj Judá runacuna,","poem":1},{"lineBreak":true},{"text":"gamcunaga shuntacay juc pachallaman.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Shuntacay juc junaj illgänanpaj caycaj päjatano manaräpis jitarishuptiqui,","poem":1},{"lineBreak":true},{"text":"Tayta Dios rabyashan gamcunaman ninano manaraj chayamuptin,","poem":1},{"lineBreak":true},{"text":"Tayta Diospa fiyupa castïgun manaraj chayamuptin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cay pachacho umildi cajcuna,","poem":1},{"lineBreak":true},{"text":"pay nishanta wiyacojcuna,","poem":1},{"lineBreak":true},{"text":"llapaniqui Tayta Dios munashanno ruray.","poem":1},{"lineBreak":true},{"text":"Rasun cajllata rurashpayqui umildilla goyay.","poem":1},{"lineBreak":true},{"text":"Chayno goyashpayquega capaschari salbacunquimanpis","poem":1},{"lineBreak":true},{"text":"Tayta Dios rabyar jusganan junäga.","poem":1}]},{"type":"heading","content":["Filistea runacunapa contran rimashan"]},{"type":"verse","number":4,"content":[{"text":"¡Ay imanöraj canqui Filisteacho caycaj siudäcuna!","poem":1},{"lineBreak":true},{"text":"Gaza siudäga quëdangapaj chunyajmi.","poem":1},{"lineBreak":true},{"text":"Ascalón siudänami ushacasha quëdanga.","poem":1},{"lineBreak":true},{"text":"Asdod siudächo tiyajcunataga junajpami gargonga.","poem":1},{"lineBreak":true},{"text":"Ecroncho tiyajcunataga jachata sapipita achurejnömi jitarenga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Ay imanöraj canqui Creta lamar cantuncho tiyajcuna!","poem":1},{"lineBreak":true},{"text":"Tayta Diosga gamcuna cayno canayquipämi nisha:","poem":1},{"lineBreak":true},{"text":"«Canaancho tiyaycaj Filistea runacunata illgächirmi chunyajta cachaycushaj.»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lamar cantuncho caycaj nasyonga ticranga uywa tiyanan jircamanmi.","poem":1},{"lineBreak":true},{"text":"Chaymanmi achcaj uyshërucunapis shuntacanga.","poem":1},{"lineBreak":true},{"text":"Uywancunapaj curralcunatapis chaychömi ruracarcärengapaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Cawaycar quëdaj caj Judá runacunaga","poem":1},{"lineBreak":true},{"text":"Filisteamanmi tiyacaycärengapaj.","poem":1},{"lineBreak":true},{"text":"Chaymanmi uyshancunata gatengapaj michinanpaj.","poem":1},{"lineBreak":true},{"text":"Chacaypanami Ascalón siudächo caycaj wasicunacho puñonga.","poem":1},{"lineBreak":true},{"text":"Chaynöga cangapaj Tayta Diosnin paycunata yapay alli goyänanpäna yanapaptinmi.","poem":1}]},{"type":"heading","content":["Moabpawan Amonpa contran rimashan"]},{"type":"verse","number":8,"content":["Israelcunapa munayniyoj Tayta Diosnin caynömi nin:",{"text":"«Wiyashcämi Moab runacuna imano ashllishushayquitapis,","poem":1},{"lineBreak":true},{"text":"Amón runacuna achäquita ashipäshushayquitapis.","poem":1},{"lineBreak":true},{"text":"Paycunaga ashllisha acrashä runacunatami.","poem":1},{"lineBreak":true},{"text":"Nircorga munayniyoj-tucushpanmi acrashä runacunapa nasyunninman mashtacasha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chaypitami nogaga quiquëpa jutëcho jurashpä në:","poem":1},{"lineBreak":true},{"text":"Moabtaga päsangapaj Sodomata päsashannömi.","poem":1},{"lineBreak":true},{"text":"Amontapis päsangapaj Gomorrata päsashannömi.","poem":1},{"lineBreak":true},{"text":"Chay siudäcunaga shata cashacunallami,","poem":1},{"lineBreak":true},{"text":"cachi rumicunaman ticrashami cangapaj.","poem":1},{"lineBreak":true},{"text":"Chay siudäcunaga ticrangapaj chunyajmanmi.","poem":1},{"lineBreak":true},{"text":"Chaura cawaycar quëdaj acrashä runacunami ima-aycantapis shuntaconga.","poem":1},{"lineBreak":true},{"text":"Chay runacunapa chacrancunamanpis paycunanami tiyacaycärengapaj.»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Moab runacunawan Amón runacunaga chaynömi päguta chasquengapaj","poem":1},{"lineBreak":true},{"text":"Tayta Dios acrashan runacunata ashllishanpita, munayniyoj-tucushanpita.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Llapan dioscunata illgächishpan","poem":1},{"lineBreak":true},{"text":"chay nasyun runacunataga Tayta Dios fiyupami mancharachengapaj.","poem":1},{"lineBreak":true},{"text":"Intëru munducho tiyajcunapis Tayta Diosllatanami adurangapaj.","poem":1},{"lineBreak":true},{"text":"Chaura may-chaychöpis payllanami adurasha cangapaj.","poem":1}]},{"type":"heading","content":["Etiopiapa contran rimashan"]},{"type":"verse","number":12,"content":[{"text":"¡Etiopía runacuna, gamcunapäpis Tayta Dios camacächenga espädanwan wañunayquipämi!","poem":1}]},{"type":"heading","content":["Asiriapa contran rimashan"]},{"type":"verse","number":13,"content":[{"text":"Nircur Tayta Diosga Asiria runacunatanami castigar illgächengapaj.","poem":1},{"lineBreak":true},{"text":"Capitalnin Nínive siudächo tiyajcunatapis uywantinta ushajpämi wañuchenga.","poem":1},{"lineBreak":true},{"text":"Chaymi chunyaj chaqui jircaman ticrashano ricaconga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chaura chay partiga uywacuna tiyanallannami cangapaj.","poem":1},{"lineBreak":true},{"text":"Tucuy casta chucaru animalcunapa tiyanallannami cangapaj.","poem":1},{"lineBreak":true},{"text":"Garsami, tucumi siudä juchushan tushacunachöpis puñongapaj.","poem":1},{"lineBreak":true},{"text":"Tucucunapis waganga ragäpa bentänancunacho.","poem":1},{"lineBreak":true},{"text":"Cuervocunapis numralcunacho gaparpanga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chay siudä runacunami caycan fiyupa alli-tucoj.","poem":1},{"lineBreak":true},{"text":"Chaycho tiyajcunaga imapäpis mana yarpachacuypami goyarcaycan.","poem":1},{"lineBreak":true},{"text":"Chay runacunaga caynömi parlan:","poem":1},{"lineBreak":true},{"text":"«Cay siudäninchïnöga manami juc siudä canchu» nir.","poem":1},{"lineBreak":true},{"text":"Ichanga chay siudäpis muntuy-muntuy juchushami quëdanga.","poem":1},{"lineBreak":true},{"text":"Atojcunapa tiyananmanmi ticranga.","poem":1},{"lineBreak":true},{"text":"Pï-maypis chay siudä ñaupanpa päsashpanga","poem":1},{"lineBreak":true},{"text":"wichyapar maquinwan togrishpanraj manacajman churar asipanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}