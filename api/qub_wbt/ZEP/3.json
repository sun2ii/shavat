{"translation":{"id":"qub_wbt","name":"Tayta Diosninchi Isquirbichishan","website":"https://ebible.org/Scriptures/details.php?id=qub","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qub","licenseNotes":null,"shortName":"WBT","englishName":"Huallaga Huánuco Quechua NT","language":"qub","textDirection":"ltr","sha256":"1d5bd395c18b96a99dd4140a7c35678fca1dabf2964ce47708697ddb6ed71213","availableFormats":["json"],"listOfBooksApiLink":"/api/qub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30871,"languageName":"Huallaga Huánuco Quechua","languageEnglishName":"Huallaga Huánuco Quechua"},"book":{"id":"ZEP","translationId":"qub_wbt","name":"SOFONÍAS","commonName":"SOFONÍAS","title":"Sofonías","order":36,"numberOfChapters":3,"sha256":"61c2430155d92949715e012e4bac1230f0230ce25278061834c0941d3b6d59e6","firstChapterNumber":1,"firstChapterApiLink":"/api/qub_wbt/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/qub_wbt/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Jerusalén runacunapaj rimashan"]},{"type":"verse","number":1,"content":[{"text":"¡Ay imanöraj canqui mana wiyacoj Jerusalén siudä!","poem":1},{"lineBreak":true},{"text":"Gamcunaga fiyupa juchasapami carcaycanqui.","poem":1},{"lineBreak":true},{"text":"Pï-maytapis ñacachiyllachömi aruycanqui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gamcunaga manami pï willapäshushayquitapis wiyacushcanquichu.","poem":1},{"lineBreak":true},{"text":"Tayta Diosmanga manami yäracushcanquipischu.","poem":1},{"lineBreak":true},{"text":"Tayta Dios yanapäshunayquitapis manami munashcanquichu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mandajniquicunaga caycan liyuncuna gaparpajnömi.","poem":1},{"lineBreak":true},{"text":"Juezniquicunapis caycan chacaypa cäsata ashiycaj atojcunanömi.","poem":1},{"lineBreak":true},{"text":"Paycunaga cäsata charishpan waranninpaj imantapis mana cachaycojnömi carcaycan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Profëtayquicunaga carcaycan mana rispitacoj, engañacoj.","poem":1},{"lineBreak":true},{"text":"Cüracunapis Tayta Diosta aduranan Templuta ganraycächin.","poem":1},{"lineBreak":true},{"text":"Tayta Diospa laynincunatapis manami cumlinchu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Imano captinpis Tayta Diosga chay siudächömi caycan.","poem":1},{"lineBreak":true},{"text":"Payga alli cajllatami ruran.","poem":1},{"lineBreak":true},{"text":"Cada tutami nin chay junaj imano cananpäpis.","poem":1},{"lineBreak":true},{"text":"Mana allita rurajcunami ichanga pengacuytapis mana yachanchu.","poem":1}]},{"type":"verse","number":6,"content":["Tayta Dios caynömi nin:",{"text":"«Nasyuncunatami illgächishcä.","poem":1},{"lineBreak":true},{"text":"Ricchacuna törricunatapis juchurgärachishcämi.","poem":1},{"lineBreak":true},{"text":"Siudäcunapa cällincunatapis pasaypa chunyajtami cachaycushcä.","poem":1},{"lineBreak":true},{"text":"Chaypaga manami runapis päsannachu.","poem":1},{"lineBreak":true},{"text":"Cacharisha siudänincunachöga manami ni jucnayllapis tiyannachu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chayno rurar noga yarparä:","poem":1},{"lineBreak":true},{"text":"‹Chayno ruraycaptëga Jerusalén runacuna manchacamangami, wiyacamangami.","poem":1},{"lineBreak":true},{"text":"Wiyacamaptinnaga noga manami castigashänachu.","poem":1},{"lineBreak":true},{"text":"Chaynöpa tiyashan wasincunapis sänulla quëdanga› nir.","poem":1},{"lineBreak":true},{"text":"Ichanga paycuna masmi tucuy-niraj mana allicunata rurasha.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chaymi gamcunaga ichicllata shuyaycäriy jusganä junajcama.","poem":1},"Noga Tayta Diosmi në:",{"text":"Achca nasyun runacunata, raycunata shuntanäpämi yarpachacushcä.","poem":1},{"lineBreak":true},{"text":"Shuntarcurnami rabyasha caycashäta paycunacho gasarpachishaj.","poem":1},{"lineBreak":true},{"text":"Rabyashäga caycan rataycaj ninanörämi.","poem":1},{"lineBreak":true},{"text":"Nina ratariycajno rabyasha caycashäwan castigaptë","poem":1},{"lineBreak":true},{"text":"munducho cäga ushajpaj illgächishami canga.","poem":1}]},{"type":"heading","content":["Tayta Dios salbananpaj aunishan"]},{"type":"verse","number":9,"content":[{"text":"«Chay wichanga camacächishaj","poem":1},{"lineBreak":true},{"text":"llapan nasyun runacuna alli cajllatana parlananpaj.","poem":1},{"lineBreak":true},{"text":"Chaynöpami llapan runacuna juc shongunölla nogallatana aduramashpan sirbimanga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chauraga aduramaj runacuna","poem":1},{"lineBreak":true},{"text":"juc-lä nasyuncunacho canan mashtacasha goyaycäga","poem":1},{"lineBreak":true},{"text":"Etiopía mayupita mas washachu caycajpita-pachami","poem":1},{"lineBreak":true},{"text":"ofrendancunata nogapaj apamonga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chay junäga gamcunapita illgächishämi ollgojcunatawan alli-tucojcunatapis.","poem":1},{"lineBreak":true},{"text":"Chauraga chay mana alli runacuna manami acrashä runacunata pengayman churanganachu.","poem":1},{"lineBreak":true},{"text":"Chaynöpami rispitädu jircächöga manana imaypis alli-tucojcuna canganachu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gamcuna tiyashayquichöga cachaycushäpaj rispitacojcunatawan, alli runacunallatanami.","poem":1},{"lineBreak":true},{"text":"Paycunaga nogallamannami yäracamongapäpis.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Cawaycar quëdaj Israel runacunaga","poem":1},{"lineBreak":true},{"text":"allillatanami ruranga.","poem":1},{"lineBreak":true},{"text":"Mananami llullacongapänachu.","poem":1},{"lineBreak":true},{"text":"Manami pipa washantapis rimangapänachu.","poem":1},{"lineBreak":true},{"text":"Cushishanami goyangapis.","poem":1},{"lineBreak":true},{"text":"Mananami pipis manchachenganachu.»","poem":1}]},{"type":"heading","content":["Cushisha cantananpaj willapashan"]},{"type":"verse","number":14,"content":[{"text":"¡Cantay Sión siudächo tiyajcuna!","poem":1},{"lineBreak":true},{"text":"¡Cushicuypita cantay Israelcuna!","poem":1},{"lineBreak":true},{"text":"¡Llapan shonguyquipa cushicuy Jerusalén runacuna!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tayta Diosga manami yapay castigashunquipänachu.","poem":1},{"lineBreak":true},{"text":"Contrayquicunatapis gamcunapitaga carumannami gargusha.","poem":1},{"lineBreak":true},{"text":"Rayniqui Tayta Diosga gamcunachönami caycan.","poem":1},{"lineBreak":true},{"text":"Chaymi manana imapitapis manchacunquinachu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chay wichanga Jerusalenta nengapaj:","poem":1},{"lineBreak":true},{"text":"«¡Sión, ama manchacuychu!","poem":1},{"lineBreak":true},{"text":"¡Balurchayna!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tayta Diosniquega gamcunachömi caycan.","poem":1},{"lineBreak":true},{"text":"¡Payga munayniyoj cashpanmi salbashunquipaj!","poem":1},{"lineBreak":true},{"text":"Gamcunapäga Tayta Dios cushishami caycangapaj.","poem":1},{"lineBreak":true},{"text":"Cuyacoj cashpanmi alli cawaytana goshunquipaj.","poem":1},{"lineBreak":true},{"text":"Cushisha cashpanmi","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"fistacho cantashannöraj cantanga.»","poem":1},"Prësu aywajcuna cutimunanpaj cashan Tayta Dios caynömi nin:",{"text":"«Chauraga mana alli chayashunayquipaj caycajta,","poem":1},{"lineBreak":true},{"text":"fiyupa pengaycho canayquipaj caycajtapis manami camacächishänachu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Chay wichanga gamcunata ñacachishojcunatanami castigashaj.","poem":1},{"lineBreak":true},{"text":"Wegruycajcunatapis yanapäshaj.","poem":1},{"lineBreak":true},{"text":"Pantacasha caycajtapis shuntamushämi.","poem":1},{"lineBreak":true},{"text":"Pasaypa manacajman churasha cashayquipitami nogaga ticrachishäpaj","poem":1},{"lineBreak":true},{"text":"mundu intërucho rispitasha, rejsisha canayquipaj.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chay wichanga gamcunata pushamushayquipaj.","poem":1},{"lineBreak":true},{"text":"Juc pachallamanmi shuntashayquipaj.","poem":1},{"lineBreak":true},{"text":"Nircorga camacächishaj yapay allina goyänayquipaj.","poem":1},{"lineBreak":true},{"text":"Nogami camacächishaj llapan nasyuncunacho","poem":1},{"lineBreak":true},{"text":"rispitasha rejsisha canayquicunapaj.","poem":1},"Noga Tayta Diosmi chayno në.»"]}],"footnotes":[]},"thisChapterLink":"/api/qub_wbt/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qub_wbt/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qub_wbt/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}