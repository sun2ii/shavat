{"translation":{"id":"qul_sbb","name":"Mosoj Testamento","website":"https://ebible.org/Scriptures/details.php?id=qulNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qulNT","licenseNotes":null,"shortName":"SBB","englishName":"North Bolivian Quechua NT","language":"qul","textDirection":"ltr","sha256":"1fb765a222fee9a5a76e552e94902643c781fd233f0e5f5f06f71e40b4f9d1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/qul_sbb/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"North Bolivian Quechua","languageEnglishName":"North Bolivian Quechua"},"book":{"id":"HEB","translationId":"qul_sbb","name":"HEBREOS","commonName":"HEBREOS","title":"HEBREOS","order":58,"numberOfChapters":13,"sha256":"1d341989739076584c7947cb03d6118b4df3fc7669559a4d31a28d0e85f6969b","firstChapterNumber":1,"firstChapterApiLink":"/api/qul_sbb/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/qul_sbb/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Dios parlan"]},{"type":"verse","number":1,"content":["Ñaupajka Dios achqha cutita imaymanamanta profetacuna uqhunta abuelonchiscunaman parlamorkan."]},{"type":"verse","number":2,"content":["Cunanka cay p'unchaycunapi Churin uqhunta parlamuwanchis. Payninta cay pachata ruwarkan, paymantaj Dios tucuy imacunata kon herenciata jina."]},{"type":"verse","number":3,"content":["Payka Diospaj sumaj glorioso c'anchaynin, Dios quiquinpaj caynin. Payka atiyniyoj palabranwan tucuy imata sumajta purichin. Juchanchiscunamanta limpiochay pasayta, janaj pachapi tiyaycun Diospaj paña ladonpi."]},{"type":"heading","content":["Diospaj Churin curaj, angelcunamanta nejtenka"]},{"type":"verse","number":4,"content":["Diospaj Churenka astawan curaj, angelcunamanta nejtenka. Herenciata jina astawan sinchi importante sutita jap'ekan angelcunamanta nejtenka."]},{"type":"verse","number":5,"content":["Dioska jayc'ajpas ni mayken angelta ninchu:",{"text":"“Kanka Churiy canqui;","poem":1},{"lineBreak":true},{"text":"cunan noka Tatayqui cani” nispaka.","poem":1},"Mayken angelmantapas nillantajchu:",{"text":"“Noka paypaj Tatan casaj,","poem":1},{"lineBreak":true},{"text":"paytaj nokapaj Churiy canka” nispa.","poem":1}]},{"type":"verse","number":6,"content":["Uj chhicapeka ch'ulla Churinta tucuy cajcunaman ricuchispa, nerkan:",{"text":"“Diospaj tucuy angelnincuna payta","poem":1},{"text":"adorachuncu.”","poem":2}]},{"type":"verse","number":7,"content":["Angelcunamantaka Dios nin:",{"text":"“Dioska angelnincunata wayrata jina ruwan,","poem":1},{"lineBreak":true},{"text":"sirvejnincunatataj nina laurayta jina.”","poem":1}]},{"type":"verse","number":8,"content":["Churimantataj nin:",{"text":"“Oh Dios, gobiernoyqueka wiñaypaj,","poem":1},{"lineBreak":true},{"text":"gobernanquitaj cabal justiciawan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sumajcajta munacunqui;","poem":1},{"lineBreak":true},{"text":"mana allincajta chejninqui.","poem":1},{"lineBreak":true},{"text":"Chayraycu Dios, Diosniyqui, ajllasunqui.","poem":1},{"lineBreak":true},{"text":"Cusicuywan junt'achisunqui astawanraj","poem":1},{"text":"ujcunamanta nejtenka.”","poem":2}]},{"type":"verse","number":10,"content":["Nillantaj:",{"text":"“Oh Señor, kan kallariymantapacha","poem":1},{"text":"cay pachata ruwarkanqui;","poem":2},{"lineBreak":true},{"text":"kan quiquiyqui janaj pachata ruwarkanqui.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tucuy cay pachaka tucuconka,","poem":1},{"text":"kancajtaj wiñaypaj canqui.","poem":2},{"text":"Tucuy cay pachaka p'acha jina mauc'aconka.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡P'achata jina suc'anqui,","poem":1},{"text":"p'acha mudacoj jina cambianqui!","poem":2},{"text":"Kancajtaj caskallanpuni canqui;","poem":1},{"lineBreak":true},{"text":"causayniyqueka mana tucuchaconkachu","poem":1},{"text":"ni jayc'ajpas.”","poem":2}]},{"type":"verse","number":13,"content":["Dios jayc'ajpas ninchu mayken angelnincunatapas:",{"text":"“Paña ladoypi tiyacuy,","poem":1},{"text":"enemigoyquicunata atipaspa","poem":2},{"lineBreak":true},{"text":"chaquiyquiman churanaycama” nispaka.","poem":2}]},{"type":"verse","number":14,"content":["Tucuy angelcunaka espíritu cancu, Diosta sirvejcuna; salvación herenciata jap'ekajcunata yanapanancupaj cachaska cancu."]}],"footnotes":[]},"thisChapterLink":"/api/qul_sbb/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qul_sbb/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qul_sbb/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}