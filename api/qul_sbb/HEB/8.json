{"translation":{"id":"qul_sbb","name":"Mosoj Testamento","website":"https://ebible.org/Scriptures/details.php?id=qulNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qulNT","licenseNotes":null,"shortName":"SBB","englishName":"North Bolivian Quechua NT","language":"qul","textDirection":"ltr","sha256":"1fb765a222fee9a5a76e552e94902643c781fd233f0e5f5f06f71e40b4f9d1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/qul_sbb/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"North Bolivian Quechua","languageEnglishName":"North Bolivian Quechua"},"book":{"id":"HEB","translationId":"qul_sbb","name":"HEBREOS","commonName":"HEBREOS","title":"HEBREOS","order":58,"numberOfChapters":13,"sha256":"1d341989739076584c7947cb03d6118b4df3fc7669559a4d31a28d0e85f6969b","firstChapterNumber":1,"firstChapterApiLink":"/api/qul_sbb/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/qul_sbb/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["Jesús uqhunta mosoj compromiso"]},{"type":"verse","number":1,"content":["Nichcaskaycumanta nejtenka astawan importanteka cay: Curaj sacerdotenchiska Diospaj caynin caskanraycu, janaj pachapi tiyaycun Diospaj paña ladonpi."]},{"type":"verse","number":2,"content":["Sacerdote jina ruwachcan verdadero santocaj wasipi, Señor Diospaj ruwaskanpi mana runacunapaj ruwaskanpichu."]},{"type":"verse","number":3,"content":["Tucuy curaj sacerdoteka churaska ofrendata jina wañuska animalcunata Diosman konanpaj. Chayraycu Jesucristopas imata konallantaj carkan."]},{"type":"verse","number":4,"content":["Paychus cay pachamanta canman chayka, ni sacerdotepas canmanchu. Imaraycuchus cay pachapeka sacerdotecuna carkanña ofrendata konancupaj Moisespaj ley mandaskanman jina."]},{"type":"verse","number":5,"content":["Cay sacerdotecunapaj ruwaskancoka janaj pachapi cajcunaman rijch'acojcunalla. Yachanchis rijch'acojcunalla caskancuta, imaraycuchus Moisés santocaj wasita ruwananmanta Dios payta nerkan: “Lomapi kanman ricuchiskayman jina tucuy imata allinta ruway.”"]},{"type":"verse","number":6,"content":["Curaj sacerdotenchiscajka astawan allin sacerdote ruwanata jep'ekan; Diosta runacunatawan allinyachispa ujchan allincaj compromisonninta, astawan allincaj promesacunawan."]},{"type":"verse","number":7,"content":["Ñaupaj compromiso mana faltayoj cajtenka, khepacajka yankhapaj canman carkan."]},{"type":"verse","number":8,"content":["Israel runacuna ñaupaj compromisota mana junt'askancuraycuchu, Dios nerkan:",{"text":"“Señorka nin: Khepa p'unchay uj mosoj","poem":1},{"text":"compromisota ruwasaj Israel runacunawan","poem":2},{"lineBreak":true},{"text":"Judá runacunawanpiwan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Cay compromisoka mana abueloncunawan","poem":1},{"text":"ruwaskay jinachu canka,","poem":2},{"text":"Egiptomanta orkhomuspa pusamojtiy.","poem":1},{"lineBreak":true},{"text":"Paycuna compromisoyta mana junt'ajtincu,","poem":1},{"text":"noka sakerparini, nin Señorka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Khepaman Israel runacunawan compromiso","poem":1},{"text":"ruwanayka cay canka, nin Señorka:","poem":2},{"text":"Leyniycunata yuyaynincupi churasaj,","poem":1},{"lineBreak":true},{"text":"sonkoncupitaj escribisaj.","poem":1},{"lineBreak":true},{"text":"Noka Diosnincu casaj,","poem":1},{"text":"paycunataj nokapi creej cankacu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Manaña pipas runamasinta nitaj waukentapas","poem":1},{"text":"yachachenkachu Señorta rejsinanpajka.","poem":2},{"text":"Tucuynincu rejsiwankacu,","poem":1},{"text":"juch'uymantapacha athuncama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Noka perdonasaj mana allincuna ruwaskancuta;","poem":1},{"lineBreak":true},{"text":"juchancuta manaña jayc'ajpas yuyarisajchu.”","poem":1}]},{"type":"verse","number":13,"content":["Dios mosoj compromisomanta parlaspaka, ñaupaj compromisota mauc'ayachinña. Mauc'ayachiska mana sirvej compromisopajka, juch'uyllaña ch'usajman tucunanpaj cachcan."]}],"footnotes":[]},"thisChapterLink":"/api/qul_sbb/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qul_sbb/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qul_sbb/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}