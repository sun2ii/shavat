{"translation":{"id":"qul_sbb","name":"Mosoj Testamento","website":"https://ebible.org/Scriptures/details.php?id=qulNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qulNT","licenseNotes":null,"shortName":"SBB","englishName":"North Bolivian Quechua NT","language":"qul","textDirection":"ltr","sha256":"1fb765a222fee9a5a76e552e94902643c781fd233f0e5f5f06f71e40b4f9d1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/qul_sbb/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"North Bolivian Quechua","languageEnglishName":"North Bolivian Quechua"},"book":{"id":"REV","translationId":"qul_sbb","name":"APOCALIPSIS","commonName":"APOCALIPSIS","title":"EL APOCALIPSIS Apóstol Juanpaj Escribiskan","order":66,"numberOfChapters":22,"sha256":"5d2a3232d2f9957f475ea81ed5bbdac9cb3b67c6dfe1c9b32162c756cc9fe855","firstChapterNumber":1,"firstChapterApiLink":"/api/qul_sbb/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/qul_sbb/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["Babilonia urman"]},{"type":"verse","number":1,"content":["Chay pasaymanta ricorkani waj angelta, janaj pachamanta urakamuchcajta sinchi autoridadniyojta. C'anchayninwan cay pachata c'ancharkan."]},{"type":"verse","number":2,"content":["Alto vozwan wajach'acorkan, nispa:",{"text":"“¡Urmanña, athun Babilonia llajta urmanña!","poem":1},{"lineBreak":true},{"text":"Sajra espiritucunapaj tiyananman tucupun,","poem":1},{"lineBreak":true},{"text":"tucuy clase khelli espiritucunapaj lugarnin,","poem":1},{"lineBreak":true},{"text":"chejnicoj khelli sajra animalcunapaj tapan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tucuy nacioncuna adulterio jucha","poem":1},{"text":"ruwaskanwan vinowan jina machaycorkancu.","poem":2},{"text":"Gobernajcuna chay adulterio juchata ruwaj","poem":1},{"text":"warmiwan adulterio juchacunata ruwarkancu.","poem":2},{"text":"Negocio ruwajcuna khapajyarkancu sinchi","poem":1},{"text":"viciocunapi gastaskancuwan.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Janaj pachamanta uj vozta uyarerkani nejta:","poem":1},{"lineBreak":true},{"text":"“Cay llajtamanta llojsiychis, nokapaj","poem":1},{"text":"runaycuna, mana chay juchapi","poem":2},{"lineBreak":true},{"text":"ruwaysinayquichispaj, nitaj paywan cusca","poem":2},{"lineBreak":true},{"text":"castigaska canayquichispaj.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Juchancuna janaj pachacama taukacun,","poem":1},{"lineBreak":true},{"text":"Diostaj paycunapaj mana allin","poem":1},{"text":"ruwaskancuta yuyarin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Payman cutichipuychis imaynatachus","poem":1},{"text":"kancunaman korkasunquichis jinata,","poem":2},{"text":"iscay cutita cutichipuychis","poem":1},{"text":"ruwaskanmanta nejtenka.","poem":2},{"text":"Chhajruskanmanta nejtenka","poem":1},{"text":"iscay cuti fuerteta chhajruychis","poem":2},{"lineBreak":true},{"text":"castigota tragota jina ujyananpaj.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pay pay tucuspa ima munaskanta ruwarkan,","poem":1},{"lineBreak":true},{"text":"chaymanta astawan achqhata koychis","poem":1},{"text":"ñac'ariyta, wakaspa sufriytawan.","poem":2},{"text":"Payka sonkonpi nerkan:","poem":1},{"lineBreak":true},{"text":"‘Caypi gobernaj reina jina tiyachcani.","poem":1},{"lineBreak":true},{"text":"Mana viudachu cani, ni sufrisajchu.’","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chayraycu uj ch'ulla p'unchaypi payman","poem":1},{"text":"jamonka castigocunaka, wañuy, ñac'ariy,","poem":2},{"lineBreak":true},{"text":"yarekaypiwan.","poem":2},{"text":"Ninapi ruphaska canka, imaraycuchus tucuy","poem":1},{"text":"atiyniyoj Señor Dios payta castigan.”","poem":2}]},{"type":"verse","number":9,"content":["Paywan adulterio jucha ruwaj, tucuy vicio jucha ruwaj gobernajcuna wakankacu, kaparenkacutaj paypaj ruphaycuskan k'osnita ricuspa."]},{"type":"verse","number":10,"content":["Castigota manchacuspa carumanta khawankacu, nenkacutaj:",{"text":"“¡Ay, ay, kanmanta athun Babilonia llajta,","poem":1},{"text":"atiyniyoj llajta!","poem":2},{"text":"Konkay chayamun castigoyqueka.”","poem":1}]},{"type":"verse","number":11,"content":["Negocio ruwajcuna wakallankacutaj, chay llajtamanta kaparenkacu. Rantejcuna manaña cankachu rantinancupaj:"]},{"type":"verse","number":12,"content":["korita, kolketa, alaja rumicunata, perlacunata, linomanta sedamanta fino telacunata, morado puca telacunata; tucuy ima sumaj k'apaj tablacunata; marfilmanta, lujo tablacunamanta, broncemanta, fierromanta, marmolmantawan ruwaskacunata;"]},{"type":"verse","number":13,"content":["canelata, k'apaj miqhuy jampicunata; inciensota, mirrata, k'apaj perfumecunata; vinota, aceiteta, t'anta jac'uta, trigota; cargana animalcunata, ovejacunata, caballocunata, carrocunata, patronniyoj causachcaj runacunatapas."]},{"type":"verse","number":14,"content":["Chay llajtamanta nenkacu:",{"text":"“¡Kanpaj munaskayqui sach'acunapaj misq'i","poem":1},{"text":"urincuna manaña capusunquichu!","poem":2},{"text":"Wiñaypaj chincapun tucuy lujo cayniyqui","poem":1},{"text":"khapaj cayniyquipas.”","poem":2}]},{"type":"verse","number":15,"content":["Chay negocio ruwajcuna chay llajtapi llanc'askancuwan khapajyajcuna chay castigota manchacuspa, carumanta khawankacu wakaspa, kaparispataj."]},{"type":"verse","number":16,"content":["Nenkacu:",{"text":"“¡Ay, ay, athun llajtamanta!","poem":1},{"lineBreak":true},{"text":"Linomanta fino p'achayoj warmiman","poem":1},{"text":"rijch'acorkan, morado puca p'achayoj,","poem":2},{"text":"koriwan jallch'aska, perlacunawan,","poem":1},{"text":"alaja rumicunawan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"¡Chay tucuy khapaj caynin konkay tucuchacun!”","poem":1},"Barco apajpaj tucuy jefencuna, kochapi barco apajcuna, barcocunapi llanc'ajcuna, tucuy kochapi llanc'aspa ganacojcunapiwan carumanta khawankacu."]},{"type":"verse","number":18,"content":["Llajta ruphaycuska k'osnita ricuspa, wajach'aconkacu: “¿Mayken llajtataj canman cay athun llajta jinari?”"]},{"type":"verse","number":19,"content":["Wakaspa, kaparispa, umancuman ñut'u jallp'ata jich'aycucuspa, wajach'aconkacu:",{"text":"“¡Ay, ay, athun llajtamanta!","poem":1},{"lineBreak":true},{"text":"Tucuy kochapi caj barcoyojcuna khapaj","poem":1},{"text":"cayninwan khapajyarkancu.","poem":2},{"text":"¡Cunantaj konkay ñut'uska capun!”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kan, oh janaj pacha, cusicuy chay","poem":1},{"text":"llajtamanta, cusicuychis kancuna, Diospi","poem":2},{"lineBreak":true},{"text":"creejcuna, apostolcuna, profetacunapas.","poem":2},{"text":"Dios payta castigaspa,","poem":1},{"text":"kancunata uyarerkasunquichis.","poem":2}]},{"type":"verse","number":21,"content":["Uj atiyniyoj ángel okharerkan uj rumita, cutanapaj athun rumita jina. Kochaman chhokaycuspa, nerkan:",{"text":"“Ajina chhokaycuska canqui, kan athun llajta","poem":1},{"text":"Babilonia, jayc'ajpas ricusunquichisñachu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Calleyquicunapi jayc'ajpas uyariconkañachu","poem":1},{"text":"arpacunata, kenacunata, cornetacuna","poem":2},{"lineBreak":true},{"text":"tocaskata.","poem":2},{"text":"Ni imapi llanc'ajniyquicunapas cankachu.","poem":1},{"lineBreak":true},{"text":"Athun cutana rumipaj suenayninpas","poem":1},{"text":"uyariconkañachu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Lamparapaj c'anchaynin jayc'ajpas","poem":1},{"text":"c'anchankañachu.","poem":2},{"text":"Casarajcunapaj fiestancunapi cusicuycunapas","poem":1},{"text":"manaña uyariconkachu, negocio","poem":2},{"lineBreak":true},{"text":"ruwajniyquicuna atiyniyoj carkancu","poem":2},{"lineBreak":true},{"text":"chaywanpas, laykacuyniyquiwan tucuy","poem":2},{"lineBreak":true},{"text":"nacioncunata engañarkanqui chaywanpas.”","poem":2}]},{"type":"verse","number":24,"content":["Chay llajtapi riqhurerkan profetacunapaj, Diospi creejcunapaj, cay pachapi tucuy wañuchiska runacunapaj yawarnin."]}],"footnotes":[]},"thisChapterLink":"/api/qul_sbb/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qul_sbb/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qul_sbb/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}