{"translation":{"id":"qvs_tbl","name":"Tata Diospa Mushuk Rimanan","website":"https://ebible.org/Scriptures/details.php?id=qvsNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qvsNT","licenseNotes":null,"shortName":"TBL","englishName":"San Martín Quechua NT","language":"qvs","textDirection":"ltr","sha256":"e3a6452bc59fc10f0f9b8d626973e87db10b262c63b1940796fb55b108d39383","availableFormats":["json"],"listOfBooksApiLink":"/api/qvs_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":287,"totalNumberOfVerses":8231,"languageName":"San Martín Quechua","languageEnglishName":"San Martín Quechua"},"book":{"id":"PSA","translationId":"qvs_tbl","name":"SALMO","commonName":"SALMO","title":"SALMOS","order":19,"numberOfChapters":27,"sha256":"6a344d00a22dde2f76abdebf31b1cadf82ad2bf17a5817d5a9a38215c29554ef","firstChapterNumber":1,"firstChapterApiLink":"/api/qvs_tbl/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/qvs_tbl/PSA/139.json","totalNumberOfVerses":348},"chapter":{"number":104,"content":[{"type":"heading","content":["Tukuy layata rurak Tata Diosta alabaypachi."]},{"type":"verse","number":1,"content":[{"text":"Tata Diosta tukuy shunku kushichishpa alabasha.","poem":1},{"lineBreak":true},{"text":"A, Tatayni Dios,","poem":1},{"lineBreak":true},{"text":"ashwan sinchi kamachikukmi kanki.","poem":1},{"lineBreak":true},{"text":"Tukuy laya atipak kashpayki","poem":1},{"lineBreak":true},{"text":"sukaman allimami kanki.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Luswan sawa llachapawanshina wankunakushkanki.","poem":1},{"lineBreak":true},{"text":"Sieluta warkudu llachapatashina churashkanki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kan tukuy layata kamachishpa","poem":1},{"lineBreak":true},{"text":"sielupi wasikipa orkonninkunatashina","poem":1},{"lineBreak":true},{"text":"manllayba kochapi sinchichishkanki.","poem":1},{"lineBreak":true},{"text":"Puyukunata rurashkanki purinayki karrukunashina kanankunapa.","poem":1},{"lineBreak":true},{"text":"Wayrashina maytapish rinayashpa rinki.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sinchi wayra yachachiwanchisapa sukaman atipak kanaykita.","poem":1},{"lineBreak":true},{"text":"Rawraykak ninakunapish kanllapami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"allpata allimata sinchichirkanki.","poem":1},{"lineBreak":true},{"text":"ama churashkaykimanta kuyunanpa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yakukuna suk llachapashina allpata kirparkan.","poem":1},{"lineBreak":true},{"text":"Yakukuna tukuy urkukunata kirparkan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kan, Tata Dios, yakukunata willaptiki kallparkansapa.","poem":1},{"lineBreak":true},{"text":"Troynoshina rimakuptiki","poem":1},{"lineBreak":true},{"text":"yakukuna uyarishpa nitikurkansapa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Urkukunata llukashpa bajadakunata urayashpa","poem":1},{"lineBreak":true},{"text":"rirkansapa maypicha willashkaykipi kanankunapa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Willarkankisapa amana chaymanta llukshinankunapa","poem":1},{"lineBreak":true},{"text":"ama kashkan allpata kirpanankunapa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Chaymanta yaku pachyamunankunamanta","poem":1},{"lineBreak":true},{"text":"urkukunata pasashpa yakuta kallpachishkanki","poem":1},{"lineBreak":true},{"text":"atun yakukunaman rinankunapa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chay yakukunamanta tukuy sachakunapi kawsak animalkuna yakukunsapa.","poem":1},{"lineBreak":true},{"text":"Chayta upyashpa sachapi kawsak burrukuna yakunayayninta samachinsapa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pawak animalkuna yaku mañankunapi wasichakunsapa.","poem":1},{"lineBreak":true},{"text":"Kaspikuna ramanpi kantansapa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"kanmi anak sielupi wasikimantapacha","poem":1},{"lineBreak":true},{"text":"yakuta tamyachishpa sachakunata ñuyuchinki.","poem":1},{"lineBreak":true},{"text":"Altumanta urmamuk yakuwan allpata saksachinki.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chay yakuwan pastukunata wiñachinki","poem":1},{"lineBreak":true},{"text":"animalkuna mikunankunapa.","poem":1},{"lineBreak":true},{"text":"Runakuna tarpunan murukunata wiñachinki","poem":1},{"lineBreak":true},{"text":"wayuchakuptin mikunankunapa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chay wayukunata mikunsapa fersasyuk kanankunapa.","poem":1},{"lineBreak":true},{"text":"Vinuta upyansapa kushikunankunapa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kan, Tata Dios, chay yakullawan kaspikunata saksachinki.","poem":1},{"lineBreak":true},{"text":"Libano partipi tarpushkayki sedrukunatapish saksachinkisapa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chay kaspikunapi taksha pishkillukuna wasichakunsapa.","poem":1},{"lineBreak":true},{"text":"Pino kaspikunapi garsakuna kawsansapa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Altu urkukunata kabrakunapa rurashkanki.","poem":1},{"lineBreak":true},{"text":"Rumikuna sikinpi achunikuna pakakunsapa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Killata rurashkanki yachanaynikunapa","poem":1},{"lineBreak":true},{"text":"ima laya tiempumi nishpa.","poem":1},{"lineBreak":true},{"text":"Intipish yachan","poem":1},{"lineBreak":true},{"text":"imay orasmi urkukunapi chinkanka nishpa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Chaymanta yana llachapatashina mantanki tutayananpa.","poem":1},{"lineBreak":true},{"text":"Tutayaptin sachapi animalkuna llukshinsapa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Pumakuna mana mikunankunata tarishpa kaparinsapa.","poem":1},{"lineBreak":true},{"text":"Tata Diosta mañansapa mikunankunata kunankunapa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Inti kashkan llukshimuptin","poem":1},{"lineBreak":true},{"text":"machayninkunapi sirik kutinsapa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Chashna diyayaptin ullkukuna trabajunkunaman rinsapa.","poem":1},{"lineBreak":true},{"text":"Tutayanankaman trabajansapa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"rikchak layata rurashkanki.","poem":1},{"lineBreak":true},{"text":"Kay allpaka tukuy rurashkaykiwan untami.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Allpapi tiyan manllayba kocha.","poem":1},{"lineBreak":true},{"text":"Chay kochapi mana yupaypa atun animalkuna taksha animalkuna tiyan.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Chay manllayba kochapi barkukuna purinsapa.","poem":1},{"lineBreak":true},{"text":"Yaku ukupi manllayba manchanapa animal kawsan","poem":1},{"lineBreak":true},{"text":"chaypi pukllananpa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"tukuy chay animalkuna","poem":1},{"lineBreak":true},{"text":"kanta shuyashunkisapa mikunankunata","poem":1},{"lineBreak":true},{"text":"munashkankuna oras kunaykipasapa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kan, Tata Dios, mikunankunata kunkisapa.","poem":1},{"lineBreak":true},{"text":"Chashna kuptiki chay animalkuna apinsapa.","poem":1},{"lineBreak":true},{"text":"Paykunata kuptiki","poem":1},{"lineBreak":true},{"text":"munashkankunawan saksansapa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Chay animalkunata manana yanapaptiki manchakunsapa.","poem":1},{"lineBreak":true},{"text":"Manana kawsanankunapa samayta kuptiki wañunsapa.","poem":1},{"lineBreak":true},{"text":"Usushpa polvo tukunsapa.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Munashpayki kashkan kawsachinkisapa.","poem":1},{"lineBreak":true},{"text":"Chashna kawsachikushpa allichanki","poem":1},{"lineBreak":true},{"text":"allpa kashkan allima rikurinanpa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mash uyariwaychi.","poem":1},{"lineBreak":true},{"text":"Tata Dios mana tukuyniyukta kamachikun.","poem":1},{"lineBreak":true},{"text":"Tukuy rurashkanta kawashpa sukaman kushikun.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tata Dios munaptin allpa chukchukun.","poem":1},{"lineBreak":true},{"text":"Tata Dios urkukunata llankaptin kusninsapa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ñuka chaykunata kawashpa wañunayni diyakaman","poem":1},{"lineBreak":true},{"text":"kantukunata kantashpa Tata Diosta kushichisha.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Allita yuyashpayni munani Tata Diosta kushichiyta.","poem":1},{"lineBreak":true},{"text":"Paymi ñukata kushichiwan.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Kushikushpa rimani:","poem":1},{"lineBreak":true},{"text":"Allpamanta tukuy ucha rurak runakuna chinkachunsapa.","poem":1},{"lineBreak":true},{"text":"Mana alli rurak runakuna amana kawsachunsapanachu.","poem":1},{"lineBreak":true},{"text":"Ñukaka Tata Diosta tukuy shunku kuyashpa alabani.","poem":1},{"lineBreak":true},{"text":"Munani tukuy runakuna Tata Diosta alabanankunapa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qvs_tbl/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qvs_tbl/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qvs_tbl/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":35}