{"translation":{"id":"qvs_tbl","name":"Tata Diospa Mushuk Rimanan","website":"https://ebible.org/Scriptures/details.php?id=qvsNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qvsNT","licenseNotes":null,"shortName":"TBL","englishName":"San Martín Quechua NT","language":"qvs","textDirection":"ltr","sha256":"e3a6452bc59fc10f0f9b8d626973e87db10b262c63b1940796fb55b108d39383","availableFormats":["json"],"listOfBooksApiLink":"/api/qvs_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":287,"totalNumberOfVerses":8231,"languageName":"San Martín Quechua","languageEnglishName":"San Martín Quechua"},"book":{"id":"PSA","translationId":"qvs_tbl","name":"SALMO","commonName":"SALMO","title":"SALMOS","order":19,"numberOfChapters":27,"sha256":"6a344d00a22dde2f76abdebf31b1cadf82ad2bf17a5817d5a9a38215c29554ef","firstChapterNumber":1,"firstChapterApiLink":"/api/qvs_tbl/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/qvs_tbl/PSA/139.json","totalNumberOfVerses":348},"chapter":{"number":2,"content":[{"type":"heading","content":["Tata Dios akllashkan wambran kamachikun."]},{"type":"verse","number":1,"content":[{"text":"Sukaman yuyani: ¿Imapatí Tata Diosta mana kasuk runakuna turbakunsapa?","poem":1},{"lineBreak":true},{"text":"¿Imapatí mana valekkunata yuyaykunsapa rurayta?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tukuy allpapi sinchi kamachikukkuna awtoridarkuna","poem":1},{"lineBreak":true},{"text":"Tata Diosta mana kasunayansapachu.","poem":1},{"lineBreak":true},{"text":"Chashna mana kasunayashpankuna","poem":1},{"lineBreak":true},{"text":"Tata Dios akllashkan sinchi kamachikukwan makanakuk tantanakunsapa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tantanakushpa kaparishpa rimansapa:","poem":1},{"lineBreak":true},{"text":"“Akuychi Tata Dios akllashkan kamachikuk runawan makanakuk.","poem":1},{"lineBreak":true},{"text":"Akuychi paymanta kishpichinakuk amana kamachiwananchikunapana.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chashna rimaptinkuna","poem":1},{"lineBreak":true},{"text":"sielupi kawsak Tata Dios","poem":1},{"lineBreak":true},{"text":"paykunata asichinsapa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chaymanta Tata Dios rabyakushpa manchachinsapa.","poem":1},{"lineBreak":true},{"text":"Sinchita piñakushpa willansapa:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Ñukami akllashkayni Sion urkupi sinchi kamachikukta churashkani tukuy layata kamachinanpa.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kunanka ñuka willaykichi Tata Dios munananta.","poem":1},{"lineBreak":true},{"text":"Payka willawashka:","poem":1},{"lineBreak":true},{"text":"“Kanka wambraynimi kanki.","poem":1},{"lineBreak":true},{"text":"Kantami churashkayki sinchi kamachikuk kanaykipa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chayrayku tukuy llaktakunata mañaway.","poem":1},{"lineBreak":true},{"text":"Ñukami allpa kuchun mañanta kushkayki chaypi kamachikunaykipa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sinchi kamachikuk kashpayki suk runakuna mana kasushunayaptinkuna kastigankisapa.","poem":1},{"lineBreak":true},{"text":"Yerumanta ruradu varawan","poem":1},{"lineBreak":true},{"text":"metomanta ruradu ollata pakikshina paykunata kastigankisapa.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Chashna Tata Dios wambranta willaptin","poem":1},{"lineBreak":true},{"text":"Kankuna sinchi kamachikukkuna, awtoridarkuna,","poem":1},{"lineBreak":true},{"text":"willanaynita allita entiendiychi.","poem":1},{"lineBreak":true},{"text":"Yachachinaynita yachakuychi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tata Diosta manchashpa sirviychi.","poem":1},{"lineBreak":true},{"text":"Kushikushpa payta kuyaychi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tata Dios kunanllami sinchita rabyakun.","poem":1},{"lineBreak":true},{"text":"Chayrayku chukchukushpa ñawpakninpi kumurayaychi","poem":1},{"lineBreak":true},{"text":"ama Tata Dios rabyashpa mana allita rurashkaykichirayku wañuchishunaykichipa.","poem":1},{"lineBreak":true},{"text":"Tata Dios amachawananchikunata yachashpanchikuna","poem":1},{"lineBreak":true},{"text":"kushikushpa kawsanchisapa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qvs_tbl/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qvs_tbl/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qvs_tbl/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}