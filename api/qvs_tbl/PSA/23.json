{"lineBreak":true},{"text":"Kan, Tata Dios, ñukawan kaptiki","poem":1},{"lineBreak":true},{"text":"varaykiwan bastonnikiwan kuydawaptiki","poem":1},{"lineBreak":true},{"text":"kushikushpalla kawsasha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chikniwak runakuna tiyaptinpish","poem":1},{"lineBreak":true},{"text":"aypa allima mikunata rurapashkanki.","poem":1},{"lineBreak":true},{"text":"Kuyawashpa mishkilla asnak wirata","poem":1},{"lineBreak":true},{"text":"umaynipi tallishkanki sukaman kushichiwanaykipa.","poem":1},{"lineBreak":true},{"text":"Chaymanta upyakunayni kopata untachikshina sukaman yanapawanki.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"wañunayni diyakaman sukaman kuyawashpa llakichiwanki.","poem":1},{"lineBreak":true},{"text":"Chayrayku wasikipi mana tukuyniyukta kawsasha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qvs_tbl/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qvs_tbl/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qvs_tbl/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":6}