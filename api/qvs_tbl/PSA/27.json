{"translation":{"id":"qvs_tbl","name":"Tata Diospa Mushuk Rimanan","website":"https://ebible.org/Scriptures/details.php?id=qvsNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qvsNT","licenseNotes":null,"shortName":"TBL","englishName":"San Martín Quechua NT","language":"qvs","textDirection":"ltr","sha256":"e3a6452bc59fc10f0f9b8d626973e87db10b262c63b1940796fb55b108d39383","availableFormats":["json"],"listOfBooksApiLink":"/api/qvs_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":287,"totalNumberOfVerses":8231,"languageName":"San Martín Quechua","languageEnglishName":"San Martín Quechua"},"book":{"id":"PSA","translationId":"qvs_tbl","name":"SALMO","commonName":"SALMO","title":"SALMOS","order":19,"numberOfChapters":27,"sha256":"6a344d00a22dde2f76abdebf31b1cadf82ad2bf17a5817d5a9a38215c29554ef","firstChapterNumber":1,"firstChapterApiLink":"/api/qvs_tbl/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/qvs_tbl/PSA/139.json","totalNumberOfVerses":348},"chapter":{"number":27,"content":[{"type":"heading","content":["Tata Dios yanapawaptinchikuna mana nimata manchanchisapachu."]},{"type":"verse","number":1,"content":[{"text":"Tata Dios lusninishina kashpa","poem":1},{"lineBreak":true},{"text":"chikniwak runakunamanta salvawan.","poem":1},{"lineBreak":true},{"text":"Chashna salvawaptin mana ni pita manchanichu.","poem":1},{"lineBreak":true},{"text":"Tata Dios amachawaptin","poem":1},{"lineBreak":true},{"text":"mana ni pita manchashachu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chay chikniwak mana alli rurak runakuna tantanakunsapa","poem":1},{"lineBreak":true},{"text":"makawashpa wañuchiwanankunapa.","poem":1},{"lineBreak":true},{"text":"Chashna wañuchiwayta yuyashpankunapish","poem":1},{"lineBreak":true},{"text":"mana atipansapachu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chay aypa chikniwak runakuna wañuchiwanayashpa chawpichawaptinkunapish","poem":1},{"lineBreak":true},{"text":"mana paykunata manchanichu.","poem":1},{"lineBreak":true},{"text":"Sukaman makawanayaptinkunapish mana turbakunichu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ñuka Tata Diosta suk imallata mañashkani.","poem":1},{"lineBreak":true},{"text":"Sukaman munani tukuy diya paypa wasinpi yaykuyta payta kuyanaynipa.","poem":1},{"lineBreak":true},{"text":"Chaypi sukaman munani kuyawananta yuyayta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sukaman sufrishpa kawsaptini","poem":1},{"lineBreak":true},{"text":"Tata Dios amachawashpa yanapawanka.","poem":1},{"lineBreak":true},{"text":"Chikniwak runakunamanta wasinpi pakawanka.","poem":1},{"lineBreak":true},{"text":"Manllayba rumi sawanpishina churawanka","poem":1},{"lineBreak":true},{"text":"ama ni pi wakllichiwananpa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chashna Tata Dios salvawaptin","poem":1},{"lineBreak":true},{"text":"atipani chikniwak runakunata kallpachiyta.","poem":1},{"lineBreak":true},{"text":"Chaypina payta agradesishpayni paypa wasinpi","poem":1},{"lineBreak":true},{"text":"ofrendakunata kusha kuyanaynipa.","poem":1},{"lineBreak":true},{"text":"Kushikushpa himnokunata Tata Diosta kantasha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"kanta roygaptini uyariway.","poem":1},{"lineBreak":true},{"text":"Llakichiwashpa yanapaway.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kikini yuyanakushpa rimani:","poem":1},{"lineBreak":true},{"text":"“Tata Diosta roygasha yanapawananpa.”","poem":1},{"lineBreak":true},{"text":"Chayrayku, Tata Dios, roygayki yanapawanaykipa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A, Tata Dios, yanapaway.","poem":1},{"lineBreak":true},{"text":"Ama piñakushpa karkuwaychu.","poem":1},{"lineBreak":true},{"text":"Kanlla atipanki salvawayta.","poem":1},{"lineBreak":true},{"text":"Ama sapallaynita sakiwaychu.","poem":1},{"lineBreak":true},{"text":"Kanmi kanki salvawak Tatayni Dios.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tatayni mamayni sakiwaptinkunapish","poem":1},{"lineBreak":true},{"text":"kan, Tata Dios, mana sakiwashpa yanapawanki.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"chikniwak runakuna makawanayaptinkuna","poem":1},{"lineBreak":true},{"text":"yanapaway allita rurashpa alli ñanpi purikshina kawsanaynipa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chay sakra runakuna llullakushpa chatawansapa","poem":1},{"lineBreak":true},{"text":"mana alli rurak kanaynita.","poem":1},{"lineBreak":true},{"text":"Chayrayku ama munaychu munashkankunata rurawanankunapa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chashna chatawaptinkunapish","poem":1},{"lineBreak":true},{"text":"ñuka allita yachani tukuy diya","poem":1},{"lineBreak":true},{"text":"kan, Tata Dios, kuyawashpayki yanapawanaykita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Chayrayku akuychi Tata Dios yanapawananchikunata shuyaypachi.","poem":1},{"lineBreak":true},{"text":"Valorchinakushpa ama sampayaypachichu.","poem":1},{"lineBreak":true},{"text":"Ariya, Tata Dios yanapawananchikunata shuyaypachi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qvs_tbl/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qvs_tbl/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qvs_tbl/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":14}