5,"content":[{"lineBreak":true},{"text":"Sirishpayni kunanlla puñuni.","poem":1},{"lineBreak":true},{"text":"Puñushkaynimanta kashkan rikchamuni","poem":1},{"lineBreak":true},{"text":"Tata Dios yanapawaptin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aypa chikniwak runakuna tukuy maypi wañuchiwanayaptinkunapish","poem":1},{"lineBreak":true},{"text":"Tata Dios yanapawaptin mana manchakunichu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"yanapawashpayki favorninipi atarimuy.","poem":1},{"lineBreak":true},{"text":"Chikniwak runakunamanta salvaway.","poem":1},{"lineBreak":true},{"text":"Kanmi chikniwak runakunata makashkankisapa.","poem":1},{"lineBreak":true},{"text":"Tukuy mana alli rurak runakunapa armankunata wakllichishkanki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kanmi, Tata Dios, ñukaykunata salvawankisapa.","poem":1},{"lineBreak":true},{"text":"Chayrayku kanta kuyaptinikuna yanapawaysapa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qvs_tbl/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qvs_tbl/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qvs_tbl/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}