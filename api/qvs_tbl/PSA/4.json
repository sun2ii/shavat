{"translation":{"id":"qvs_tbl","name":"Tata Diospa Mushuk Rimanan","website":"https://ebible.org/Scriptures/details.php?id=qvsNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qvsNT","licenseNotes":null,"shortName":"TBL","englishName":"San Martín Quechua NT","language":"qvs","textDirection":"ltr","sha256":"e3a6452bc59fc10f0f9b8d626973e87db10b262c63b1940796fb55b108d39383","availableFormats":["json"],"listOfBooksApiLink":"/api/qvs_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":287,"totalNumberOfVerses":8231,"languageName":"San Martín Quechua","languageEnglishName":"San Martín Quechua"},"book":{"id":"PSA","translationId":"qvs_tbl","name":"SALMO","commonName":"SALMO","title":"SALMOS","order":19,"numberOfChapters":27,"sha256":"6a344d00a22dde2f76abdebf31b1cadf82ad2bf17a5817d5a9a38215c29554ef","firstChapterNumber":1,"firstChapterApiLink":"/api/qvs_tbl/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/qvs_tbl/PSA/139.json","totalNumberOfVerses":348},"chapter":{"number":4,"content":[{"type":"heading","content":["Tata Diosta kreyiptinchikuna allita yanapawanchisapa."]},{"type":"verse","number":1,"content":[{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"kanmi allita amachawanki.","poem":1},{"lineBreak":true},{"text":"Chayrayku kanta roygaptini yanapaway.","poem":1},{"lineBreak":true},{"text":"Sukaman llakiptini kanmi kushichiwanki.","poem":1},{"lineBreak":true},{"text":"Chayrayku roygaptini llakichiwashpa uyariway.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kankuna, chikniwak runakuna,","poem":1},{"lineBreak":true},{"text":"¿aykapikamantí llullakushpa chatawankichi?","poem":1},{"lineBreak":true},{"text":"¿Aykapikamantí mana kuskata yuyashpa llullakuyllata munankichi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Allita yachaychi","poem":1},{"lineBreak":true},{"text":"Tata Dios payllata kasushpa kawsak runakunallata yanapananta.","poem":1},{"lineBreak":true},{"text":"Allita yuyaychi ñuka Tata Diosta roygaptini yanapawananta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chayta yachashpa manchakushpa chukchukuychi","poem":1},{"lineBreak":true},{"text":"amana ashwanta uchallikunaykichipa.","poem":1},{"lineBreak":true},{"text":"Sirishpaykichi kasillayashpa mana alli rurashkaykichita yuyaychi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chayta yuyashpa","poem":1},{"lineBreak":true},{"text":"tukuy shunku Tata Diosta kuyashpa","poem":1},{"lineBreak":true},{"text":"animalkunata altarpi wañuchiychi.","poem":1},{"lineBreak":true},{"text":"Allita yachaychi amachashunaykichita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aypa runakuna rimansapa:","poem":1},{"lineBreak":true},{"text":"Manami ni pi ñukanchikunata kushichiwanayanchisapachu.","poem":1},{"lineBreak":true},{"text":"Chashna rimaptinkunapish","poem":1},{"lineBreak":true},{"text":"kan, Tata Dios, ñukaykunata llakichiwaysapa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aypa mikunayuk aypa upyanayuk runakuna sukaman kushikunsapa.","poem":1},{"lineBreak":true},{"text":"Kan, Tata Dios, paykunamanta ashwanta kushichiwashkanki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kan kuydawaptiki mana manchakushpa sirishpayni kunanlla gustu puñuni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qvs_tbl/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qvs_tbl/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qvs_tbl/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}