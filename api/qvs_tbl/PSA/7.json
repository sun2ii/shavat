{"translation":{"id":"qvs_tbl","name":"Tata Diospa Mushuk Rimanan","website":"https://ebible.org/Scriptures/details.php?id=qvsNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qvsNT","licenseNotes":null,"shortName":"TBL","englishName":"San Martín Quechua NT","language":"qvs","textDirection":"ltr","sha256":"e3a6452bc59fc10f0f9b8d626973e87db10b262c63b1940796fb55b108d39383","availableFormats":["json"],"listOfBooksApiLink":"/api/qvs_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":287,"totalNumberOfVerses":8231,"languageName":"San Martín Quechua","languageEnglishName":"San Martín Quechua"},"book":{"id":"PSA","translationId":"qvs_tbl","name":"SALMO","commonName":"SALMO","title":"SALMOS","order":19,"numberOfChapters":27,"sha256":"6a344d00a22dde2f76abdebf31b1cadf82ad2bf17a5817d5a9a38215c29554ef","firstChapterNumber":1,"firstChapterApiLink":"/api/qvs_tbl/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/qvs_tbl/PSA/139.json","totalNumberOfVerses":348},"chapter":{"number":7,"content":[{"type":"heading","content":["Tata Dios kuskanpi kastigakun."]},{"type":"verse","number":1,"content":[{"text":"A, Señor Tatayni Dios,","poem":1},{"lineBreak":true},{"text":"kantami maskayki amachawanaykipa.","poem":1},{"lineBreak":true},{"text":"Sufrichiwak runakunamanta salvaway.","poem":1},{"lineBreak":true},{"text":"Paykunamanta kishpichichiway.","poem":1},{"lineBreak":true},{"text":"Mana amachawaptikika llullakushpa chatawashpa","poem":1},{"lineBreak":true},{"text":"pumashina wakllichiwanmansapa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"¿ima mana allita rurashpatí uchallikushkani?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Purikmasini allita rurawaptin manami chiknishkanichu.","poem":1},{"lineBreak":true},{"text":"Chikniwak runata mana nimanachiwaykaptin","poem":1},{"lineBreak":true},{"text":"manami payta sufrichishkanichu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Payta sufrichishka kaptinika ñukatapish sufrichiwachun.","poem":1},{"lineBreak":true},{"text":"Payta chiknishka kaptinika ñukatapish mana nimatashina kawawachun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"piñakushpa atariy.","poem":1},{"lineBreak":true},{"text":"Favorninipi chikniwak runakunata tinkuysapa.","poem":1},{"lineBreak":true},{"text":"Kanmi rimashkanki mana alli rurak runakunata kastiganaykipa.","poem":1},{"lineBreak":true},{"text":"Chayrayku favorninipi llukshiy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tukuy llaktakunata tantanachishpayki","poem":1},{"lineBreak":true},{"text":"paykunata kamachiysapa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"kanmi tukuy llaktakunapi kawsak runakunata","poem":1},{"lineBreak":true},{"text":"willanki allitachu mana allitachu rurashkasapa nishpa.","poem":1},{"lineBreak":true},{"text":"Chayrayku allita rurashpa kawsashkaynirayku","poem":1},{"lineBreak":true},{"text":"willaway allita rurashkaynita.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A, Tata Dios,","poem":1},{"lineBreak":true},{"text":"kanmi allillata rurak kanki.","poem":1},{"lineBreak":true},{"text":"Tukuy runakunapa yuyayninta riksinki.","poem":1},{"lineBreak":true},{"text":"Chayrayku tukuy mana alli rurak runakunata kulluchiy.","poem":1},{"lineBreak":true},{"text":"Ñukaykuna alli rurak runakuna kaptinikuna","poem":1},{"lineBreak":true},{"text":"sinchichiwashpa yanapawaysapa","poem":1},{"lineBreak":true},{"text":"ama uchallikunaynikunapa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Altu sielupi kawsak Tata Dios","poem":1},{"lineBreak":true},{"text":"tukuy alli shunkuyuk runakunata amachan.","poem":1},{"lineBreak":true},{"text":"Chayrayku ñukata amachawan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tata Dios kuskanpi kastigakun.","poem":1},{"lineBreak":true},{"text":"Tukuy tiempu tukuy mana alli rurak runakunata kastigansapa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tata Dios alli rurak kaptin","poem":1},{"lineBreak":true},{"text":"payta alabasha.","poem":1},{"lineBreak":true},{"text":"Altu sielupi kamachikuk Tata Diosta yuyashpa","poem":1},{"lineBreak":true},{"text":"payta kuyashpa himnokunata kantasha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/qvs_tbl/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qvs_tbl/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qvs_tbl/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":11}