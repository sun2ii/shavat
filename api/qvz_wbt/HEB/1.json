{"translation":{"id":"qvz_wbt","name":"Diospa shimi","website":"https://ebible.org/Scriptures/details.php?id=qvzNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qvzNT","licenseNotes":null,"shortName":"WBT","englishName":"Northern Pastaza Quichua NT","language":"qvz","textDirection":"ltr","sha256":"ce079553edada63fc4622413143cd741ea1f0a8ff6886770c773ae08d05aa71e","availableFormats":["json"],"listOfBooksApiLink":"/api/qvz_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7813,"languageName":"Northern Pastaza Quichua","languageEnglishName":"Northern Pastaza Quichua"},"book":{"id":"HEB","translationId":"qvz_wbt","name":"Hebreos","commonName":"Hebreos","title":"Hebreos","order":58,"numberOfChapters":13,"sha256":"361af051a5d3d4ca1de0f371246de5153fb5a533d922457118f78a1d1a017bd6","firstChapterNumber":1,"firstChapterApiLink":"/api/qvz_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/qvz_wbt/HEB/13.json","totalNumberOfVerses":298},"chapter":{"number":1,"content":[{"type":"heading","content":["Jesucristohuan Yaya Dios tucuita rara"]},{"type":"verse","number":1,"content":["Callari uras Yaya Diosca pai rimashcata pasachic runagunahuan ñucanchi huañuc apayayagunata rimashca, chasnallata ashca cutin ashca tunu rashcagunahuanbas rimashcami."]},{"type":"verse","number":2,"content":["Cunan puchucai punzhagunaibi paihua churita cachashcami pai ñuca rimashcagunata rimachun nisha. Paihuan churihuanmi Yaya Dios cai pachatas jahuapachatahuas huinda rashcami, cai tucuita pai rashcagunata mandachun nisha."]},{"type":"verse","number":3,"content":["Paihua ushaihuanllami tucui alita cuirasha mandaun. Paimi ricuchin Yaya Dios imasna actaga. Paihuas Yayacuintallatami yapa sumac an. Paimi ñucanchi juchata anchuchishcahuasha jahuapachaibi Diospa ali maqui partibi tiyarisha tucuita mandaun."]},{"type":"heading","content":["Diospa churiga angelgunamanda yali balic man"]},{"type":"verse","number":4,"content":["Chasna acpimi Yaya Diosca paihua churitaga angelgunamandas yali ushaita cura. Chasnallata paihua churima tucui angelgunamanda mas yali balic shutita cura."]},{"type":"verse","number":5,"content":["Ricuichi. Yaya Diosca ima uraspas shuc angeltas Jesustashina mana casna rimashcachu,",{"text":"Canga ñuca churi mangui, cunanga","poem":1},{"lineBreak":true},{"text":"camba yaya tucushcani nisha.","poem":1},"Chasnallata mana ni shuc angeltahuas rimashcachu:",{"text":"Camba yaya tucusha can randiga","poem":1},{"lineBreak":true},{"text":"ñuca churi tucungui nisha.","poem":1}]},{"type":"verse","number":6,"content":["Cai pachama paihua punda churita cachamuusha casna nira:",{"text":"Tucui ñuca angelguna","poem":1},{"lineBreak":true},{"text":"ñuca churita balichinauchun.","poem":1}]},{"type":"verse","number":7,"content":["Randi angelgunamanda Dios casna rimara:",{"text":"Paigunaga huairacuinta,","poem":1},{"lineBreak":true},{"text":"ninata júu sindichishcashina","poem":1},{"lineBreak":true},{"text":"dsaslla ñucata sirbinauchun","poem":1},"nisha rimara."]},{"type":"verse","number":8,"content":["Astahuanbas paihua churitami casna nira:",{"text":"Canga jatun amu asha","poem":1},{"lineBreak":true},{"text":"huiñaigama mandac angui Dios.","poem":1},{"lineBreak":true},{"text":"Canga runagunata sumactami mandaungui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Can ali ranagunallata munac ashami","poem":1},{"lineBreak":true},{"text":"jiridsa rashcagunataga","poem":1},{"lineBreak":true},{"text":"mana imatas gustanguichu.","poem":1},{"lineBreak":true},{"text":"Chiraicumi ñuca camba Dios asha","poem":1},{"lineBreak":true},{"text":"canda japisha tucuigunamanda","poem":1},{"lineBreak":true},{"text":"mas yali jatun cushita curani","poem":1},{"lineBreak":true},{"text":"yali ali tucuchun nisha.","poem":1}]},{"type":"verse","number":10,"content":["Chasnallata nishcami:",{"text":"Jatun mandac Dios, callari urasmanda","poem":1},{"lineBreak":true},{"text":"cai mundutahuas chasnallata cielotahuas","poem":1},{"lineBreak":true},{"text":"camba maquihuan rashcangui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Allpahuas cielohuas shuc llachapa","poem":1},{"lineBreak":true},{"text":"ismushcacuinta tucuricpihuas","poem":1},{"lineBreak":true},{"text":"astahuanbas canga","poem":1},{"lineBreak":true},{"text":"huiñaigama causanguimi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Shuc llachapata pillusha jichusha","poem":1},{"lineBreak":true},{"text":"mushuc llachapahuan cambiashcacuinta","poem":1},{"lineBreak":true},{"text":"cai mundutas cielotas cambianguimi.","poem":1},{"lineBreak":true},{"text":"Randi canga mana cambiasha","poem":1},{"lineBreak":true},{"text":"huiñaigama chasnallata anguimi.","poem":1}]},{"type":"verse","number":13,"content":["Yaya Dios mana ni shuc angeltahuas mana casna rimarachu,",{"text":"Can jatun mandac tucusha ñuca ali","poem":1},{"lineBreak":true},{"text":"maqui partima tiyarisha chapai","poem":1},{"lineBreak":true},{"text":"tucui canda piñac runagunata","poem":1},{"lineBreak":true},{"text":"ñuca binsinagama.","poem":1}]},{"type":"verse","number":14,"content":["Astahuan tucui Diospa angelgunami mana ricuibac ashallata Yaya Dios rimashcata pactachiuc anaun. Chasna acpi Dios paigunata cachanmi quiringarauc runagunata yanapangahua."]}],"footnotes":[]},"thisChapterLink":"/api/qvz_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qvz_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qvz_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}