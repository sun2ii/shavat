{"translation":{"id":"qwh_llb","name":"Teyta Diospa Mushoq Testamentun","website":"https://ebible.org/Scriptures/details.php?id=qwhNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qwhNT","licenseNotes":null,"shortName":"LLB","englishName":"Huaylas Ancash Quechua NT","language":"qwh","textDirection":"ltr","sha256":"b1b305a56378d1feb685cfb8a132d8381285ef76dd59c805874aa1c8ab1391be","availableFormats":["json"],"listOfBooksApiLink":"/api/qwh_llb/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7885,"languageName":"Huaylas Ancash Quechua","languageEnglishName":"Huaylas Ancash Quechua"},"book":{"id":"HEB","translationId":"qwh_llb","name":"HEBREUS","commonName":"HEBREUS","title":"HEBREUS Jesucristuman creyicoq israel nunacunapaq carta","order":58,"numberOfChapters":13,"sha256":"c15ce5cc8433b4ea25a07e76c38ffd4c16f9bd832c162746016f5b7d48b64f26","firstChapterNumber":1,"firstChapterApiLink":"/api/qwh_llb/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/qwh_llb/HEB/13.json","totalNumberOfVerses":294},"chapter":{"number":1,"content":[{"type":"heading","content":["Tsurintawan Dios parlapätsimantsic"]},{"type":"verse","number":1,"content":["Une tiempuchomi Diosnintsic profetancunatawan awiluntsiccunata atsca cuti y tuquinopa parlaparqan;"]},{"type":"verse","number":2,"content":["peru canannam tsurintawanna parlapätsimarqontsic. Petam Dios churarqan imecachopis mandacoq cananpaq, pewan que munduta camashqa carnin."]},{"type":"verse","number":3,"content":["Diospa tsurin Jesucristoqa quiquin patenti Diosnintsicmi, y pëchomi ricantsic Diospa allapa puedeq queninta. Pemi llapan camanqancunata poderninwan tsararëcan mana ushacänanpaq. Y jutsantsiccunata limpiaramarnintsicmi, sieluman cuticushqa. Cananqa Diospa derechu caq ladunchomi tëcan pewan juntu mandacur."]},{"type":"heading","content":["Jesucristoqa anjelcunapitapis mas puedeqmi"]},{"type":"verse","number":4,"content":["Tsemi Jesucristoqa anjelcunapitapis mas puedeq, porqui manam ni meqan anjeltapis Jesucristutanoqa podernin qoshqatsu, ni manam meqan anjeltapis nerqantsu:",{"text":"“Qamqa tsurïmi canqui,","poem":1},{"lineBreak":true},{"text":"y noqam papäniqui cä” nir.","poem":1},"Y manam ni meqan anjelpaq Jesucristupaqnoqa nerqantsu:",{"text":"“Pepa papäninmi cashaq","poem":1},{"lineBreak":true},{"text":"y pemi tsurï canqa”","poem":1}]},{"type":"verse","number":6,"content":["Tsenollam wamaqshu tsurinta que patsaman cachamurninpis, queno nerqan:",{"text":"“Llapan anjelnïcuna peta adorayätsun” nir.","poem":1}]},{"type":"verse","number":7,"content":["Anjelcunapaqqa palabrancho quenollam nican:",{"text":"“Sirwimaq anjelnïcunaqa bientunollam","poem":1},{"lineBreak":true},{"text":"y rupecaq ninanollam cayan” nir.","poem":1}]},{"type":"verse","number":8,"content":["Tsurin Jesucristupaqmi siqa queno escribirëcan:",{"text":"“Qamqa Dios carmi, wiñepa wiñenin mandacur","poem":1},{"lineBreak":true},{"text":"imecatapis muneniquicho catsinqui;","poem":1},{"lineBreak":true},{"text":"y mandacurpis, llapan nunapaq iwalmi canqui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Qamqa alli rurecunatam cuyarqonqui,","poem":1},{"lineBreak":true},{"text":"y mana alli rurecunataqa manam.","poem":1},{"lineBreak":true},{"text":"Tserecurmi Dios acrashorqonqui waquin yanaqiquicunapitapis mas cushitsishunequipaq” nir.","poem":1}]},{"type":"verse","number":10,"content":["Jina quenopis nicanmi:",{"text":"“Qammi Teytallä, shumaq patsacätsir,","poem":1},{"lineBreak":true},{"text":"camarqequi que patsata y sielutapis.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tsecunapis llapanmi ushacärenqa.","poem":1},{"lineBreak":true},{"text":"Que patsapis sielupis ropanomi macwayärenqa;","poem":1},{"lineBreak":true},{"text":"peru qamqa wiñepa wiñeninmi quecanqui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Imeca ropata piturcoqnomi janaq patsatapis","poem":1},{"lineBreak":true},{"text":"y que patsatapis piturinqui","poem":1},{"lineBreak":true},{"text":"y imeca ropata trocareqnomi juclayaman tumaratsinqui!","poem":1},{"lineBreak":true},{"text":"Tseno captinpis, qamqa canqanllam quecanqui” nir.","poem":1}]},{"type":"verse","number":13,"content":["Diosqa manam ni meqan anjelnintapis nerqantsu:",{"text":"“Que ladüman täcamï mandacunantsicpaq,","poem":1},{"lineBreak":true},{"text":"asta llapan chiquishoqniquicunata nopequiman churamonqäyaq” nir.","poem":1}]},{"type":"verse","number":14,"content":["Porqui llapan anjelcunapis jäninollam cayan. Pecunataqa Diosmi cachamushqa, salbasionta erensiatano chasquiyänanpaq caq nunacunata yanapananpaq."]}],"footnotes":[]},"thisChapterLink":"/api/qwh_llb/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qwh_llb/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qwh_llb/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}