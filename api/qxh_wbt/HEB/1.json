{"translation":{"id":"qxh_wbt","name":"Mushug Testamento","website":"https://ebible.org/Scriptures/details.php?id=qxhNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qxhNT","licenseNotes":null,"shortName":"WBT","englishName":"Panao Huánuco Quechua NT","language":"qxh","textDirection":"ltr","sha256":"4823a2c32dd72de1ce727c9a7f4d64ca7aa2d0a5771ea87d9293a7ab4ea080dc","availableFormats":["json"],"listOfBooksApiLink":"/api/qxh_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7797,"languageName":"Panao Huánuco Quechua","languageEnglishName":"Panao Huánuco Quechua"},"book":{"id":"HEB","translationId":"qxh_wbt","name":"HEBREOS","commonName":"HEBREOS","title":"Hebreoscunaman cartacushan","order":58,"numberOfChapters":13,"sha256":"b4ee596bc11d6605dd990b555c8a77aea9b903a03d3deb294d68d4d6b97a077a","firstChapterNumber":1,"firstChapterApiLink":"/api/qxh_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/qxh_wbt/HEB/13.json","totalNumberOfVerses":287},"chapter":{"number":1,"content":[{"type":"heading","content":["Jallarinan"]},{"type":"verse","number":1,"content":["Unay wichan Tayta Diosninchi shungun munashanta sumaj musyachicuran. Unay auquillunchicunata achca cutipa, tucuy-jinanpa willacujnincunawan musyachicuran."]},{"type":"verse","number":2,"content":["Canan wichanmi ichanga Wawanwan shungun munashanta musyachimashcanchi. Paywanmi Tayta Diosninchi llap-llapanta camaran. Llapan camashancunata Wawanpa maquinman ćhurasha. Quiquishllan cashpan Tayta Diosninchipa shungun yarpashantapis musyachimanchi. Payga sumaj munayniyuj. Janaj pachapis, cay pachapis maquinćhu caycan. Paypa shiminta llap-llapan wiyacun. Llapan runapa juchanta Tayta Diosninchi mana imaysi yarparänanpaj nuwanchi-raycur rusćhu wañuran. Jinarcur janaj pachaman cuticur, Tayta Diosninchita mandäshinanpaj dirïcha-caj lädunman jamacuran."]},{"type":"heading","content":["Jesúsman anjilcuna mana tincushan"]},{"type":"verse","number":4,"content":["Tayta Diosninchi Wawanta sumaj alli ñawinpa rican. Wawanman anjilcuna mana tincunchu. Anjilcunata maygantapis mana wamrachacuranchu. Wawanta ricsichicurmi ichanga, Tayta Diosninchi niran:",{"text":"«Wawämi canqui.","poem":1},{"lineBreak":true},{"text":"Nuwapita cawanqui.»","poem":1},"Maygan anjiltapis mana musyachiranchu:",{"text":"«Taytayqui cashaj. Wawä canqui» nir.","poem":1},{"noteId":0}]},{"type":"verse","number":6,"content":["Manchäga japallan Wawanta ricsichicur, Tayta Diosninchi niran:",{"text":"«Llapan anjilnïcuna Wawäta manchapacur alliman ćhuranman.»","poem":1},{"noteId":1}]},{"type":"verse","number":7,"content":["Anjilcunapaj musyachicur niran:",{"text":"«Anjilcuna caćhä cashpan wayra-jina shimïta purichinga.","poem":1},{"lineBreak":true},{"text":"Nina-jina shungü munashanta ruranga.»","poem":1},{"noteId":2}]},{"type":"verse","number":8,"content":["Wawanpämi ichanga niran:",{"text":"«Taytallau Tayta, munayniyuj cayniquiga mana imaypis ushyacangapächu.","poem":1},{"lineBreak":true},{"text":"Maquiquićhu cawajcunatapis allilla cawachinqui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Jucha aparicuyta wasguipashcanqui.","poem":1},{"lineBreak":true},{"text":"Imatapis rurar, Tayta Diosninchipa shungun munashannuylla cawashcanqui.","poem":1},{"lineBreak":true},{"text":"Chaymi runa-masiquicunapita jamllata acracushcaj.","poem":1},{"lineBreak":true},{"text":"Cushi-cushilla cawanayquipaj camacächishcä.","poem":1},{"lineBreak":true},{"text":"Nuwalla Tayta Diosniqui cä.»","poem":1},{"noteId":3}]},{"type":"verse","number":10,"content":["Tayta Diosninchipa shiminćhu juctapis nin:",{"text":"«Taytallau Tayta, manaraj imapis captillan, cay pachata camarayqui.","poem":1},{"lineBreak":true},{"text":"Janaj pachatapis maquiquiwan rurarayqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Llapan camashayquicuna ushyacangapaj.","poem":1},{"lineBreak":true},{"text":"Quiquiquim ichanga imaysi mana ushyacanquipächu.","poem":1},{"lineBreak":true},{"text":"Janaj pachawan cay pacha müdana-jina maucayangapaj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mauca müdanata-jina lluyllurinquipaj.","poem":1},{"lineBreak":true},{"text":"Müdanata rucaycaj-jina rucarinquipaj.","poem":1},{"lineBreak":true},{"text":"Quiquiquim ichanga mana rucacanquipächu.","poem":1},{"lineBreak":true},{"text":"Imaysi mana ushyacanquipächu.»","poem":1},{"noteId":4}]},{"type":"verse","number":13,"content":["Maygan anjiltapis Tayta Diosninchi mana niranchu:",{"text":"«Dirïcha-caj lädüman jamacuy cunćharyuyquicunata pampaman ćhurashäcaman.»","poem":1},{"noteId":5}]},{"type":"verse","number":14,"content":["Payga anjilcunata caćhacaycämun mandunta rurananpaj, shiminta ćhasquicujcunata ricananpaj. Ćhasquicujcunata Tayta Diosninchi jishpichinga."]}],"footnotes":[{"noteId":0,"caller":"*","text":"-5 Salmo 2.7; 2 Samuel 7.14.","reference":{"chapter":1,"verse":4}},{"noteId":1,"caller":"*","text":"Deuteronomio 32.43.","reference":{"chapter":1,"verse":6}},{"noteId":2,"caller":"*","text":"Salmo 104.4.","reference":{"chapter":1,"verse":7}},{"noteId":3,"caller":"*","text":"Salmo 45.6–7.","reference":{"chapter":1,"verse":9}},{"noteId":4,"caller":"*","text":"Salmo 102.25–27.","reference":{"chapter":1,"verse":12}},{"noteId":5,"caller":"*","text":"Salmo 110.1.","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/qxh_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qxh_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qxh_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}