{"translation":{"id":"qxh_wbt","name":"Mushug Testamento","website":"https://ebible.org/Scriptures/details.php?id=qxhNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qxhNT","licenseNotes":null,"shortName":"WBT","englishName":"Panao Huánuco Quechua NT","language":"qxh","textDirection":"ltr","sha256":"4823a2c32dd72de1ce727c9a7f4d64ca7aa2d0a5771ea87d9293a7ab4ea080dc","availableFormats":["json"],"listOfBooksApiLink":"/api/qxh_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7797,"languageName":"Panao Huánuco Quechua","languageEnglishName":"Panao Huánuco Quechua"},"book":{"id":"LUK","translationId":"qxh_wbt","name":"SAN LUCAS","commonName":"SAN LUCAS","title":"Jesúspa willapanta San Lucas willacushan","order":42,"numberOfChapters":24,"sha256":"6e20a17f6bc1e6bf312af15dda3eee8f5ef99434f21ceccbcbdfbdd0c49154ae","firstChapterNumber":1,"firstChapterApiLink":"/api/qxh_wbt/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/qxh_wbt/LUK/24.json","totalNumberOfVerses":1132},"chapter":{"number":3,"content":[{"type":"heading","content":["Jesúspita Ushyachicuj Juan willacushan"]},{"type":"verse","number":1,"content":["Ushyachicuj Juan chunyaj pachaćhu tiyashan wichan ćhunca pichgawan (15) watana llapan Roma marcacunata Tiberio César mandaycaran. Paymi Judea marcacunata Poncio Pilatupa maquinman ćhuraran. Galilea marcatana Herodespa maquinman ćhuraran. Itureawan Traconítide marcatana Herodespa wauguin Felipupa maquinman ćhuraran. Abilene marcatana Lisaniaspa maquinman ćhuraran. Israel runacunana Anáspawan Caifáspa maquinćhu cawaran. Paycuna Jerusalén marcaćhu mayur cüra caran. Chay wichan Zacaríaspa wamran Juanta Tayta Diosninchi niran: «Shimïta willacamuy.»"]},{"type":"verse","number":3,"content":["Chaymi Jordán mayu quinranćhu Juan anyapäcuran: «Tayta Diosninchipa shiminta wiyacäriy. Juchapita wanacäriy. Ushyacäriy. Chayrämi Tayta Diosninchi llapan juchayquita junganga» nir."]},{"type":"verse","number":4,"content":["Anyapäcuran unay willacuj Isaíaspa shimin ćharcucänanpaj. Payga unayna niran:",{"text":"«Chunyajćhu juc runa jayacuypa willacuycan:","poem":1},{"text":"‹Taytanchi shamunanpaj camaricuy.","poem":2},{"lineBreak":true},{"text":"Caminuta pichay.","poem":2},{"lineBreak":true},{"text":"Wicsu caminucunatapis allchay.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mana camaricurga, rajra-rajra-jina caycanqui.","poem":2},{"lineBreak":true},{"text":"Punta-punta-jina caycanqui.","poem":2},{"lineBreak":true},{"text":"Wicsu-wicsu caminu-jina caycanqui.","poem":2},{"lineBreak":true},{"text":"Chaymi llapan juchapita wanacäriy.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tayta Diosninchi caćhamushan Washäcujta llapan runa ricanga.","poem":2},{"lineBreak":true},{"text":"Washäcujga jishpichimäshun› nir.»","poem":2},{"noteId":4}]},{"type":"verse","number":7,"content":["Ushyacuj ćhayajcunata Juan niran: «Supaypa wawancuna, ushyacurpis juchallaćhu aruptiqui, Tayta Diosninchi ñacachishunquipaj. Mana jishpinquipächu."]},{"type":"verse","number":8,"content":["Wanacushayqui musyacänanpaj Tayta Diosninchita manchapacur allillata rurar caway. Ama chapacunquichu: ‹Israelcunata Abrahampa willcan cashanchipita Tayta Diosninchi alli ricamanchi› nir. Abrahampa willcan cananpäga rumitapis Tayta Diosninchi ticrarachinman wiyacuj cananpaj."]},{"type":"verse","number":9,"content":["Ushyacurpis juchapita mana wanacuptiqui, Tayta Diosninchi jargurishunquipaj. Yüratapis mana sumaj wayuptin, jächawan muturij-muturijllana shuyaranchi. Muturir, ninaman jaycurinchi.»"]},{"type":"verse","number":10,"content":["Chaura runacuna Juanta tapuran: «¿Imatataj ruräman?» nir."]},{"type":"verse","number":11,"content":["Tapuptin, Juan niran: «Ishcay janapay müdanayqui captin, juc-cajta pishipacujta juycunquiman. Micuy captin, ashijta tarichinquiman.»"]},{"type":"verse","number":12,"content":["Roma marcapa mandajninpaj jillayta shuntajcunapis tapucuran: «Tayta, ¿imatataj ruräman?» nir."]},{"type":"verse","number":13,"content":["Juanna niran: «Aycatapis shuntanayquipaj nishallanta shuntanquiman.»"]},{"type":"verse","number":14,"content":["Waquin murucucunapis tapucuran: «¿Imatataj ruräman?» nir. Juanna niran: «Jillayta jurgunayqui cashallan runacunata ama manchachinquichu. Pitapis ama tumpanquichu. Mandajniqui pägashushallayquita aypächicunqui.»"]},{"type":"verse","number":15,"content":["Runacuna shungullanćhu yarpaćhacuycaran: «Juanga Tayta Diosninchi caćhamushan Washäcujćhi canga, ¿au?» nir."]},{"type":"verse","number":16,"content":["Chaymi Juan niran: «Mana Washäcujchu cä. Nuwa yacullawan ushyachicuycä wanacushayqui musyacänanpaj. Washäcujmi ichanga Espíritu Santuwanpis, ninawanpis ushyachishunquipaj. Payga munayniyuj. Llanguinta llushtipuyllatapis manchapacü."]},{"type":"verse","number":17,"content":["Wanacujcunata alli ñawinwan Tayta Diosninchi rican. Juchaćhu arujcunatam ichanga mana upij ninaman jaycuringa. Sumaj tantiyacärinquiman. Rïguta wapyarpis, punshanta ruparachin. Muruntam ichanga wasinman shuntacun.»"]},{"type":"verse","number":18,"content":["Ushyachicuj Juan Tayta Diosninchipa shiminta sumaj willapäcuran. Runacunata tucuy-jinanpa shacyächiran."]},{"type":"verse","number":19,"content":["Mandaj Herodestam ichanga sumaj piñacuran wauguin Felipupa warmin Herodíasta jićhushanpita, juchallaćhu arushanpita."]},{"type":"verse","number":20,"content":["Piñacuptin, mandaj Herodes Juanta wićhgachiran. Wićhgachir, jucha aparicushanpa jananmanpis mastaraj juchata aparicuran."]},{"type":"heading","content":["Jesústa Juan ushyachishan"]},{"type":"verse","number":21,"content":["Mandaj Herodes manaraj wićhgachiptillan, runacunata ushyaycächishanćhu Jesústapis Juan ushyachiran. Ushyacuriycur, Tayta Diosninchita Jesús mañacuycaran. Niycaptillan, janaj pacha quićhacäcamuran."]},{"type":"verse","number":22,"content":["Espíritu Santu paluma-niraj Jesúsman ćhayamuran. Janaj pachapita nimuran: «Cuyay Wawämi canqui. Shungüman sumaj tincunqui.»",{"noteId":5}]},{"type":"heading","content":["Jesúspa unay auquilluncunapita musyachicushan"]},{"type":"verse","number":23,"content":["Quimsa ćhunca (30) watata aywaycashanćhüraj Tayta Diosninchipa shiminta willapäcuyta Jesús jallaycuran. Runacuna yarparan: «Jesúsga Josépa wamranmi canga» nir.",{"text":"Josépa papänin caran Helí.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Helípa papäninna caran Matat.","poem":1},{"lineBreak":true},{"text":"Matatpa papäninna caran Leví.","poem":1},{"lineBreak":true},{"text":"Levípa papäninna caran Melquí.","poem":1},{"lineBreak":true},{"text":"Melquípa papäninna caran Janaí.","poem":1},{"lineBreak":true},{"text":"Janaípa papäninna caran José.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Josépa papäninna caran Matatías.","poem":1},{"lineBreak":true},{"text":"Matatíaspa papäninna caran Amós.","poem":1},{"lineBreak":true},{"text":"Amóspa papäninna caran Nahúm.","poem":1},{"lineBreak":true},{"text":"Nahúmpa papäninna caran Eslí.","poem":1},{"lineBreak":true},{"text":"Eslípa papäninna caran Nagai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nagaipa papäninna caran Maat.","poem":1},{"lineBreak":true},{"text":"Maatpa papäninna caran Matatías.","poem":1},{"lineBreak":true},{"text":"Matatíaspa papäninna caran Semeí.","poem":1},{"lineBreak":true},{"text":"Semeípa papäninna caran José.","poem":1},{"lineBreak":true},{"text":"Josépa papäninna caran Judá.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Judápa papäninna caran Joanán.","poem":1},{"lineBreak":true},{"text":"Joanánpa papäninna caran Resí.","poem":1},{"lineBreak":true},{"text":"Resípa papäninna caran Zorobabel.","poem":1},{"lineBreak":true},{"text":"Zorobabelpa papäninna caran Salatiel.","poem":1},{"lineBreak":true},{"text":"Salatielpa papäninna caran Nerib.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text"