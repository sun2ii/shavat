{"translation":{"id":"qxh_wbt","name":"Mushug Testamento","website":"https://ebible.org/Scriptures/details.php?id=qxhNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qxhNT","licenseNotes":null,"shortName":"WBT","englishName":"Panao Huánuco Quechua NT","language":"qxh","textDirection":"ltr","sha256":"4823a2c32dd72de1ce727c9a7f4d64ca7aa2d0a5771ea87d9293a7ab4ea080dc","availableFormats":["json"],"listOfBooksApiLink":"/api/qxh_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7797,"languageName":"Panao Huánuco Quechua","languageEnglishName":"Panao Huánuco Quechua"},"book":{"id":"MAT","translationId":"qxh_wbt","name":"SAN MATEO","commonName":"SAN MATEO","title":"Jesúspa willapanta San Mateo willacushan","order":40,"numberOfChapters":28,"sha256":"f1a1ed8b540344313345645192bab4b84a252857223c595a6a2fd83f6e0315c4","firstChapterNumber":1,"firstChapterApiLink":"/api/qxh_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/qxh_wbt/MAT/28.json","totalNumberOfVerses":1061},"chapter":{"number":1,"content":[{"type":"heading","content":["Jesúspa unay auquilluncunapita musyachicushan"]},{"type":"verse","number":1,"content":["Jesucristu caran mandaj Davidpa willcan, Abrahampa willcan. Canan Jesúspa auquilluncunata ricsicushun. Cay librućhu jutincuna isquirbiraycan:"]},{"type":"verse","number":2,"content":[{"text":"Abraham churiyäcuran Isaacta.","poem":1},{"lineBreak":true},{"text":"Isaacna churiyäcuran Jacobta.","poem":1},{"lineBreak":true},{"text":"Jacobna churiyäcuran Judáta,","poem":1},{"text":"waquin wauguincunatapis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Judána churiyäcuran Faréstawan Zérata. Paycunapa maman caran Tamar.","poem":1},{"lineBreak":true},{"text":"Farésna churiyäcuran Esrónta.","poem":1},{"lineBreak":true},{"text":"Esrónna churiyäcuran Aramta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aramna churiyäcuran Aminadabta.","poem":1},{"lineBreak":true},{"text":"Aminadabna churiyäcuran Naasónta.","poem":1},{"lineBreak":true},{"text":"Naasónna churiyäcuran Salmónta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salmónna warmin Rahabćhu churiyäcuran Boozta.","poem":1},{"lineBreak":true},{"text":"Boozna warmin Rutćhu churiyäcuran Obedta.","poem":1},{"lineBreak":true},{"text":"Obedna churiyäcuran Jeséta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jeséna churiyäcuran mandaj Davidta.","poem":1},{"lineBreak":true},{"text":"Mandaj Davidna churiyäcuran Salomónta.","poem":1},{"text":"Salomónpa maman caran Uríaspa warmin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Salomónna churiyäcuran Roboamta.","poem":1},{"lineBreak":true},{"text":"Roboamna churiyäcuran Abíasta.","poem":1},{"lineBreak":true},{"text":"Abíasna churiyäcuran Asáta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asána churiyäcuran Josafatta.","poem":1},{"lineBreak":true},{"text":"Josafatna churiyäcuran Joramta.","poem":1},{"lineBreak":true},{"text":"Joramna churiyäcuran Ocíasta.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ocíasna churiyäcuran Yotamta.","poem":1},{"lineBreak":true},{"text":"Yotamna churiyäcuran Ajazta.","poem":1},{"lineBreak":true},{"text":"Ajazna churiyäcuran Ezequíasta.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ezequíasna churiyäcuran Manasésta.","poem":1},{"lineBreak":true},{"text":"Manasésna churiyäcuran Amónta.","poem":1},{"lineBreak":true},{"text":"Amónna churiyäcuran Josíasta.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Josíasna churiyäcuran Jeconíasta.","poem":1},{"text":"Jeconíaspa wauguincunapis caran.","poem":2},"Jeconías cawashan wichan Babilonia runacuna Israel runacunata marcanman apacäriran."]},{"type":"verse","number":12,"content":["Chay marcaćhu Jeconíaspa wamran Salatiel yuriran.",{"text":"Salatielna churiyäcuran Zorobabelta.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zorobabelna churiyäcuran Abiudta.","poem":1},{"lineBreak":true},{"text":"Abiudna churiyäcuran Eliacimta.","poem":1},{"lineBreak":true},{"text":"Eliacimna churiyäcuran Azorta.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azorna churiyäcuran Sadocta.","poem":1},{"lineBreak":true},{"text":"Sadocna churiyäcuran Aquimta.","poem":1},{"lineBreak":true},{"text":"Aquimna churiyäcuran Eliudta.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliudna churiyäcuran Eleazarta.","poem":1},{"lineBreak":true},{"text":"Eleazarna churiyäcuran Matánta.","poem":1},{"lineBreak":true},{"text":"Matánna churiyäcuran Jacobta.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Jacobna churiyäcuran Joséta.","poem":1},{"text":"Joséga Maríapa majan caran.","poem":2},{"text":"Maríapita Jesús yuriran.","poem":1},{"lineBreak":true},{"text":"Jesústa ricsinchi: «Tayta Diosninchi caćhamushan Washäcuj» nir.","poem":1},{"noteId":0}]},{"type":"verse","number":17,"content":["Abrahampita mandaj Davidcaman ćhunca ćhuscuwan (14) willcacaman runacuna miraran. Mandaj Davidpita Israelcunata Babilonia marcaman apashancaman yapay ćhunca ćhuscuwan (14) willcacaman miraran. Chaypita Tayta Diosninchi caćhamushan Washäcuj yurishancaman yapay ćhunca ćhuscuwan (14) willcacaman miraran."]},{"type":"heading","content":["Jesús yurishan"]},{"type":"verse","number":18,"content":["Canan Jesucristupita tantiyacushun. Maríawan José majachacänanpaj parlanacush caycaran. Ichanga manasi yataptillan Espíritu Santu camacächiptinmi, María jishyaj ricacuran."]},{"type":"verse","number":19,"content":["Mana yataycaptin María jishyaj ricacuptin, José jaguiricuyta munaran. Payga Tayta Diosninchita sumaj manchapacuran. Chaymi runa washanta rimananta mana munar, pacayllapa jaguiricuyta munaran."]},{"type":"verse","number":20,"content":["Jaguiriyta munaptin, suyñuyllanćhu Tayta Diosninchi caćhamushan anjil niran: «José, mandaj Davidpa willcan canqui. Maríawan majachacayta ama pingacuychu. Payga Espíritu Santu camacächiptin, jishyaj ricacusha."]},{"type":"verse","number":21,"content":["Wamranpis ullgu yuringa. Marca-masincunata jucha aparicuypita washanga. Chaymi: ‹Jesús› nir jutinta ćhurapanqui.»",{"noteId":1}]},{"type":"verse","number":22,"content":["Llapanpis camacaran Tayta Diosninchipa shimin ćharcucänanpaj. Paypa willacujnin unayna musyachicuran:"]},{"type":"verse","number":23,"content":[{"text":"«Runa yatäni jipash jishyaj ricacunga.","poem":1},{"lineBreak":true},{"text":"Ullguta jishyacunga.","poem":1},{"lineBreak":true},{"text":"Jutintana ćhurapanga: ‹Emmanuel› nir.","poem":1},{"lineBreak":true},{"text":"‹Emmanuel› ninanga: ‹Tayta Diosninchi nuwanchiwan iwal juyan› ninan.»","poem":1},{"noteId":2}]},{"type":"verse","number":24,"content":["José puñushanpita ricchapacurir anjilpa shiminta wiyacur, Maríawan majachacaran."]},{"type":"verse","number":25,"content":["Wamran manaraj yurishancaman Maríata mana yataparanchu. Wamran yuriptin: «Jesús» nir jutichaparan."]}],"footnotes":[{"noteId":0,"caller":"*","text":"Washäcuj ninanta griego rimayćhu: «Cristu» nin. Hebreo rimayćhüna: «Mesías» nin. «Mesías» nirsi, «Cristu» nirsi, Tayta Diosninchi caćhamushan washäcujpaj tantiyachinanchi. Israel runacuna shuyararan jäpa runacunapa maquinpita washänanta.","reference":{"chapter":1,"verse":16}},{"noteId":1,"caller":"*","text":"Griego rimayćhu: «Jesús» ninanta: «Yeshúa» nin. «Yeshúa» niptin, tantiyan: «Tayta Diosninchi washan» nir.","reference":{"chapter":1,"verse":21}},{"noteId":2,"caller":"*","text":"Isaías 7.14.","reference":{"chapter":1,"verse":23}}]},"thisChapterLink":"/api/qxh_wbt/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qxh_wbt/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}