{"translation":{"id":"qxh_wbt","name":"Mushug Testamento","website":"https://ebible.org/Scriptures/details.php?id=qxhNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qxhNT","licenseNotes":null,"shortName":"WBT","englishName":"Panao Huánuco Quechua NT","language":"qxh","textDirection":"ltr","sha256":"4823a2c32dd72de1ce727c9a7f4d64ca7aa2d0a5771ea87d9293a7ab4ea080dc","availableFormats":["json"],"listOfBooksApiLink":"/api/qxh_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7797,"languageName":"Panao Huánuco Quechua","languageEnglishName":"Panao Huánuco Quechua"},"book":{"id":"REV","translationId":"qxh_wbt","name":"APOCALIPSIS","commonName":"APOCALIPSIS","title":"San Juan ricapacushan","order":66,"numberOfChapters":22,"sha256":"e1bec7aa14ba518b2a08b980b559f2385949fcf02587ec77c0ad372d517cd891","firstChapterNumber":1,"firstChapterApiLink":"/api/qxh_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/qxh_wbt/REV/22.json","totalNumberOfVerses":399},"chapter":{"number":18,"content":[{"type":"heading","content":["Babilonia marca ushyacashan"]},{"type":"verse","number":1,"content":["Ricapacuynilläćhu ricapacuycaptillä, janaj pachapita achic-achicyaycar munayniyuj anjil yarpaycämuran. Sumaj achicyaptin, cay pachapis intïru achicyacurcuran."]},{"type":"verse","number":2,"content":["Cushicur, japariypa anjil niran:",{"text":"«Babilonia marca ushyacärunna.","poem":1},{"lineBreak":true},{"text":"Jatun marca carpis, chunyajna.","poem":1},{"lineBreak":true},{"text":"Supaycunalla tiyaycan.","poem":1},{"lineBreak":true},{"text":"Shapshicucunapa maćhayninman ćhayasha.","poem":1},{"lineBreak":true},{"text":"Janra siucacunapis, tucucunapis chayćhu purin.","poem":1},{"lineBreak":true},{"text":"Asyaj uywacunapis wasichacusha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Babilonia marcapa mandajnin warmi llapan runata maquinćhu charar, juchallaćhu purichiran.","poem":1},{"lineBreak":true},{"text":"Maćhashta-jina cawachiran.","poem":1},{"lineBreak":true},{"text":"Majanta jananpachij-jina marcapa mandajnin warmillata mamachacuran.","poem":1},{"noteId":20},{"lineBreak":true},{"text":"Chay-tucuy marca mandajcunapis paywan cacuran.","poem":1},{"lineBreak":true},{"text":"Marcapa mandajnin puchuy-puchuy jananćhu cawaptin, rantipacujcunapis rïcuyaran.»","poem":1}]},{"type":"verse","number":4,"content":["Chaypita jucna janaj pachapita wiyacächiypa nimuran:",{"text":"«Wawacuna, chay marcapita witicäriy.","poem":1},{"lineBreak":true},{"text":"Juchaćhu arujcunawan ama talluranquimanchu.","poem":1},{"lineBreak":true},{"text":"Timpurij jishya jamcunaman ama ćhayamunmanchu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mana wiyacujcuna juchallan atipay caycan.","poem":1},{"lineBreak":true},{"text":"Tayta Diosninchipis ricashana.","poem":1},{"lineBreak":true},{"text":"Chay-chica juchata aparicushanta Tayta Diosninchi musyaraycan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jucha aparicushanman-tupu ñacayman ćhayachun.","poem":1},{"lineBreak":true},{"text":"Runacunata ñacachishan-jina juyupana ñacachun.","poem":1},{"lineBreak":true},{"text":"Jucta ñacachishanpita chigaypa ñacachun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alli-tucushanpita chigaypa ñacachun.","poem":1},{"lineBreak":true},{"text":"Llapanpa jananćhu cawashanpita pasaypa ushyapacächun.","poem":1},{"lineBreak":true},{"text":"Mandaj warmi yarpaj: ‹Llapan runata maquïćhu puriycächï.","poem":1},{"lineBreak":true},{"text":"Jucpa maquinćhu mana imaypis purishächu.","poem":1},{"lineBreak":true},{"text":"Biyüda cayman mana imaypis ćhayashächu.","poem":1},{"lineBreak":true},{"text":"Llaquicuymanpis mana ćhayashächu› nir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chay-niraj cashanpita timpurij jishyacuna ćhayapunga.","poem":1},{"lineBreak":true},{"text":"Illajpita yargaypis, ñacaypis, wañuypis ćhayapunga.","poem":1},{"lineBreak":true},{"text":"Nina llapanta ushyanga.","poem":1},{"lineBreak":true},{"text":"Tayta Diosnillanchi munayniyuj. Paymi juchanta jurgapar, ñacachinga.»","poem":1}]},{"type":"verse","number":9,"content":["Babilonia marcaćhu nina ićhicurcuptinmi ichanga, llapan marcapa mandajnincuna llaquicuywan atar ninga: «¿Piwanraj cacushaj? Silluta manaćhi micushänachu.» Paycuna Tayta Diosninchita mana manchapacuranchu. Manchäga shungun munashallanta imatapis ruraran."]},{"type":"verse","number":10,"content":["Chaura Babilonia marcata ñacachiptin, mancharinga. Carullapita ricar, wiguinpawanraj atanga:",{"text":"«Babiloniallau Babilonia,","poem":1},{"lineBreak":true},{"text":"Jatun marca carsi, ushyacayman ćhayashcanqui.","poem":1},{"lineBreak":true},{"text":"Mana yarpashpita ñacayman ćhayashcanqui» nir.","poem":1}]},{"type":"verse","number":11,"content":["Babilonia marca mana captin, llapan rantipacujcunapis: «¿Piraj rantimäshun?» nir wiguinpawan atangapaj."]},{"type":"verse","number":12,"content":["Purichishan juricunata, jillaycunata, achic-achicyaj rumicunata pipis mana rantinganachu. Chaynuypis bayïtacunatapis, müdanacunatapis finu captinsi, achic-achicyaycaptinsi mana rantinganachu. Pirjümi jirucunata, tullupita piñicunata, alli jirucunata, brunsicunata, jïrucunata,"]},{"type":"verse","number":13,"content":["canïlacunata, pirjümicunata, bïnucunata, wiracunata, ñuchgu maćhcacunata, rïgucunata, uywacunata, uyshacunata, cawallucunata, cärucunata, shutirächishan runacunata pipis mana rantinganachu. Uywata-jina runata mana rantinganachu."]},{"type":"verse","number":14,"content":["Chaymi marca runacunata rantipacujcuna ninga:",{"text":"«Cananga silluta mana micunquipänachu.","poem":1},{"lineBreak":true},{"text":"Shunguyqui munashanta mana tarinquipänachu.","poem":1},{"lineBreak":true},{"text":"Alli cawayniquipis ushyacashana.","poem":1},{"lineBreak":true},{"text":"Llapan jillayniquipis ushyacashana.»","poem":1}]},{"type":"verse","number":15,"content":["Rantipacujcuna imancunatapis Babilonia marcaćhu ranticur, rïcuyaran. Marca ushyapacaptinmi ichanga, mancharinga. Atar, aullar, carullapita jayacunga:"]},{"type":"verse","number":16,"content":[{"text":"«Babiloniallau Babilonia, jatun marca caran.","poem":1},{"lineBreak":true},{"text":"Jatun marca carsi, pishipacuyman ćhayasha.","poem":1},{"lineBreak":true},{"text":"Ñaupata mandaj car, achic-achicyaycaj puca müdanashalla purisha.","poem":1},{"lineBreak":true},{"text":"Jillay piñicunawan achic-achicyaycaj rumicuna piñishalla cuyayllapaj purisha.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chaypis mana yarpashpita ushyapacayman ćhayasha.»","poem":1},"Babilonia marca ratariptin, büti mayur purichijcunapis, büti purichijcunapis, bütiwan purijcunapis, rantipacujcunapis carullapita ricapanga."]},{"type":"verse","number":18,"content":["Jushtay ićhicurcuptin, juyupa mancharinga. Jayacuringa:",{"text":"«Babilonia marca runacuna puchuy-puchuy jananćhu cawasha.","poem":1},{"lineBreak":true},{"text":"Chay marcaman maygan marcapis mana tincushachu» nir.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Llaquicushpan umancunamanpis ućhpata wiñacunga. Atar wagangapaj:","poem":1},{"lineBreak":true},{"text":"«Marcallau marca, jatun marca caran.","poem":1},{"lineBreak":true},{"text":"Jatun marca carsi, ushyacayman ćhayasha.","poem":1},{"lineBreak":true},{"text":"Bütiyujcunapis, rantipacujcunapis jillayllayquiwan rïcuyasha.","poem":1},{"lineBreak":true},{"text":"Chaypis mana yarpashpita ushyapacayman ćhayasha.»","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"«Janaj pachachu llapaniqui jatunpa cushicärinquiman.","poem":1},{"lineBreak":true},{"text":"Tayta Diosninchipa wawancunapis, caćhancunapis, shiminta willacujcunapis cushicärinquiman.","poem":1},{"lineBreak":true},{"text":"Ñacachishushayquiman-tupu Tayta Diosninchipis ñacachishana» nir.","poem":1}]},{"type":"verse","number":21,"content":["Chaura munayniyuj anjil jatun rumita lamar yacuman wicaparamur niran:",{"text":"«Rumita wicaparishä-jina Babilonia marcatapis wicaparish cangapaj.","poem":1},{"lineBreak":true},{"text":"Tayta Diosninchi wicapaptin, illaringapaj.","poem":1},{"lineBreak":true},{"text":"Pisi mana imaypis ricangapänachu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Chay marcaćhu mana pipis tünapacunganachu.","poem":1},{"lineBreak":true},{"text":"Arpapis, pincullupis, curnïtapis mana suynamunganachu.","poem":1},{"lineBreak":true},{"text":"Arujcunapis mana canganachu.","poem":1},{"lineBreak":true},{"text":"Maćhcatapis mana pipis aganganachu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Achquitasi pipis mana ratachinganachu.","poem":1},{"lineBreak":true},{"text":"Warmi ashiypis mana canganachu.","poem":1},{"lineBreak":true},{"text":"Babilonia marca rantipacujcuna sumaj rïcuyaran.","poem":1},{"lineBreak":true},{"text":"May-chayćhüpis chapata rurar, runacunata riguichiran.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Babilonia marcaćhu Tayta Diosninchipa shiminta willacujcunatapis, wawancunatapis wañuchir, yawarnintapis mashtaran. May-chayćhüpis runacunata wañuchiran. Chaynuy cashanpita ushyacayman ćhayangapaj.»","poem":1}]}],"footnotes":[{"noteId":20,"caller":"*","text":"Tayta Diosninchipita witicujcunata majanta jananpachicujwan tincuchin.","reference":{"chapter":18,"verse":3}}]},"thisChapterLink":"/api/qxh_wbt/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qxh_wbt/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qxh_wbt/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}