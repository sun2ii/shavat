{"translation":{"id":"qxn_wbt","name":"Señor Jesucristopa alli willacuynin","website":"https://ebible.org/Scriptures/details.php?id=qxnNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=qxnNT","licenseNotes":null,"shortName":"WBT","englishName":"Northern Conchucos Ancash Quechua NT","language":"qxn","textDirection":"ltr","sha256":"b499d13074b9a3de4e235680697d541d24a983423b160ff19ed8921049860979","availableFormats":["json"],"listOfBooksApiLink":"/api/qxn_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7947,"languageName":"Northern Conchucos Ancash Quechua","languageEnglishName":"Northern Conchucos Ancash Quechua"},"book":{"id":"HEB","translationId":"qxn_wbt","name":"Hebreos","commonName":"Hebreos","title":"Hebreos Hebreos Marcachö Criyicugcunaman Carta","order":58,"numberOfChapters":13,"sha256":"aa9e59879cc41737a224ad83d08466ae91d778b9b5ca2ed3f6c1ded3d572071e","firstChapterNumber":1,"firstChapterApiLink":"/api/qxn_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/qxn_wbt/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Llapan angelcunapitapis mas mandacuyog poderösom Señor Jesucristoga"]},{"type":"verse","number":1,"content":["Unay tiempuchömi Dios Yaya atsca cuti willacug profëtancunatawan awiluntsiccunata tucuyläyapa parlapar willatsirgan."]},{"type":"verse","number":2,"content":["Pero canan cay tiempuchöga Tsurin Jesucristowanmi willatsimashcantsic. Paytam Dios Yaya imayca eredërunö captin churargan, llapan imaycapis Payllapana cananpag. Tsaynöllam Señor Jesucristowan llapan entëru mundutapis camargan."]},{"type":"verse","number":3,"content":["Tsurin Jesucristom alläpa chipacyarrag poderöso Dios Yaya canganta ricätsimashcantsic. Tsaynöllam Señor Jesucristotapis ricantsic, Dios Yayawan iwalïtu Payricuglla canganta. Tsaymi Señor Jesucristoga alläpa poderöso mandacuyninwan llapan imaycatapis mandädunchö catsin. Nogantsicraycu cruzchö wañurmi, yawarninwan llapan jutsantsicpita limpiamashcantsic. Tsaymi Payga cieluchö Dios Yayapa derëchucag lädunpita mandacamur jamaycan. Tsay cielupitam Dios Yayawan pagta, entëru munduchö llapan imaycatapis mandacamun."]},{"type":"verse","number":4,"content":["Taytan Dios Yayapa lädunchö canganpitam, Señor Jesucristoga llapan angelcunapitapis mas poderyog. Tsaymi Dios Yayapa Tsurin canganpita Paypa shutinga llapan angelcunapitapis mas poderöso."]},{"type":"verse","number":5,"content":["Tsaynö poderöso captinmi Dios Yayaga ni imay ni maygan angeltapis nirgantsu:",{"text":"“Gamga nogapa Tsurïmi canqui.","poem":1},{"lineBreak":true},{"text":"Tsaymi canan llapanpa puntanchö willacur,","poem":1},{"lineBreak":true},{"text":"Taytayqui cangäta musyatsicü.”","poem":1},"Tsaynöllam juclächöpis nirgan:",{"text":"“Nogam Taytayqui cashag,","poem":1},{"lineBreak":true},{"text":"Paynam nogapa tsurï canga.”","poem":1}]},{"type":"verse","number":6,"content":["Japallan Tsurinta cay patsaman cachamurmi Dios Yaya nirgan:",{"text":"“Llapan angelnïcuna","poem":1},{"lineBreak":true},{"text":"japallan Tsurïta adorayätsun.”","poem":1}]},{"type":"verse","number":7,"content":["Angelcunapagnam nirgan:",{"text":"“Angelcunaga imayca wayranö aywar cutimur puriyätsun.","poem":1},{"lineBreak":true},{"text":"Angelcunaga mandanganta cumplirmi,","poem":1},{"lineBreak":true},{"text":"imayca lunyag ninanö wacpa caypa aywarnin,","poem":1},{"lineBreak":true},{"text":"Dios Yayata serviyan.”","poem":1}]},{"type":"verse","number":8,"content":["Pero Tsurinpagnam nirgan:",{"text":"“Gam Dios captiquim Mandacuy Reynoyqui","poem":1},{"lineBreak":true},{"text":"ni imaypis mana ushacag canga.","poem":1},{"lineBreak":true},{"text":"Tsaynö alläpa allish mandacuyniquiwanmi,","poem":1},{"lineBreak":true},{"text":"imayca juc tucruwan mandacugnö,","poem":1},{"lineBreak":true},{"text":"rasumpacagllata imaycatapis ruraycanqui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rasumpa allicag ruraycunata cuyarmi,","poem":1},{"lineBreak":true},{"text":"mana allicag ruraycunataga chiquirgayqui.","poem":1},{"lineBreak":true},{"text":"Tsaynö cangayquipitam gampa Diosniqui,","poem":1},{"lineBreak":true},{"text":"mandacug canayquipag acrashurniqui,","poem":1},{"lineBreak":true},{"text":"waquincag runamajiquicunapitapis","poem":1},{"lineBreak":true},{"text":"mas cushicatsishushcanqui.”","poem":1}]},{"type":"verse","number":10,"content":["Caynöpismi Dios Yaya Tsurinpag nirgan:",{"text":"“Gam Señorllam, gallananpita imayca cemientuta churagnö cay patsata rurargayqui.","poem":1},{"lineBreak":true},{"text":"Tsaynöllam quiquiquipa maquiquiwan","poem":1},{"lineBreak":true},{"text":"cielutapis camargayqui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tsay camangayquicunaga llapanpis jancatmi ushacanga.","poem":1},{"lineBreak":true},{"text":"Pero gamga mana ushacag cayniquiwanmi,","poem":1},{"lineBreak":true},{"text":"imayyagpis cawaycanqui.","poem":1},{"lineBreak":true},{"text":"Cay patsawan cielupis","poem":1},{"lineBreak":true},{"text":"imayca llatapa macwayagnömi ushacäyanga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Cay mundutaga imayca llatapata piturcur churasquignömi dëjasquinqui!","poem":1},{"lineBreak":true},{"text":"¡Tsaynöllam llatapata cambiacugnö cambianquipis!","poem":1},{"lineBreak":true},{"text":"Pero gamga mana ni imay ushacag cayniquiwanmi, imayyagpis iwallla caycanqui.”","poem":1}]},{"type":"verse","number":13,"content":["Pero Dios Yayaga manam ni imay ni maygan angeltapis nirgantsu:",{"text":"“Cay derëchucag läduman jamacamuy,","poem":1},{"lineBreak":true},{"text":"asta llapan chiquishugniquicunata","poem":1},{"lineBreak":true},{"text":"chaquiquipa gopinman churamungäyag” nirga.","poem":1}]},{"type":"verse","number":14,"content":["Tsaymi llapan angelcunapis Dios Yayata servig espïritulla cayan. Paycunataga quiquin Dios Yayam cachamunga, cay patsachö llapan criyicugcunata yanapayaptin, salvacar cieluchö cushishga imayyagpis cawacuyänanpag."]}],"footnotes":[]},"thisChapterLink":"/api/qxn_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/qxn_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/qxn_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}