{"translation":{"id":"rhg_sco","name":"Rohingya Bible Translation Project","website":"https://ebible.org/Scriptures/details.php?id=rhg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rhg","licenseNotes":null,"shortName":"SCO","englishName":"Rohingya: Rohingya Bible Translation Project (Bible)","language":"rhg","textDirection":"ltr","sha256":"6876e1867aebdf25dd8728b4537d3c1451c695a01f2020e3d65a0493bdb25a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/rhg_sco/books.json","numberOfBooks":9,"totalNumberOfChapters":159,"totalNumberOfVerses":5683,"languageName":"Rohingya","languageEnglishName":"Rohingya"},"book":{"id":"JON","translationId":"rhg_sco","name":"Yunus","commonName":"Yunus","title":"Sĩyara Yunus","order":32,"numberOfChapters":4,"sha256":"feea8870ad79fa28cd4b64bc5c4e804805c376e1c7aa70cb9030fbd87c66c896","firstChapterNumber":1,"firstChapterApiLink":"/api/rhg_sco/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/rhg_sco/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Yunus foikamboror munazat"]},{"type":"verse","number":1,"content":["Tehon Yunus oi masor feṛottu tai Allah Mabudor hãse munazat goijjil, tãi hoil:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mabud, ãi tũware bifodot ḍakilam","poem":1},{"text":"ar tũi ãr ḍak funila;","poem":2},{"text":"ãi hoboror murottu tai tũware ḍakilam,","poem":1},{"text":"ar tũi ãr foriyad funila.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tũi ãre mur fanit doriyar bukot felaidila,","poem":1},{"text":"zeṛe sairo mikka fani,","poem":2},{"text":"tũwar har goiror fanir zalazontrona","poem":1},{"text":"ãr uwottu guzorigilgoi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ãi hoilam,","poem":1},{"text":"ãre tũwar nozoror tolottu dure loi za oiye,","poem":2},{"text":"ãi ki tũwar fobitro dórmogóror uzu","poem":1},{"text":"hono din suk tuli sai no faijjum neki?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Doriyar faniye ãre giridoijje,","poem":1},{"text":"foran foijjonto zar zar oiye,","poem":2},{"text":"doriyaye ãre sairomikkattu giridoijje,","poem":1},{"text":"ãr matat heṛiyar fezalota okkol beraiye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ãi ḍufizaiore faharor gura foijjonto gilamgoi,","poem":1},{"text":"ãr fise duniyair doroza sirohalolla ṭalamara oiye,","poem":2},{"text":"tarfore o, oh ãr Allah Mabud,","poem":1},{"text":"tũi ãr foranore morattu uwafes tuli anila.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ãr foran zẽtte zarzar oiye,","poem":1},{"text":"hẽtte ãi Mabudore monot goillam,","poem":2},{"text":"ãr munazat tũwar hãse,","poem":1},{"text":"tũwar fobitro kaba górot fõssil.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zara misa devdevire fũze,","poem":1},{"text":"tara tarar asol muhabbotottu durezagoi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kintu ãi tũwar namor tarif šoho","poem":1},{"text":"kurbani goriyum;","poem":2},{"text":"ãi ze manoš goijji hiyan furon goriyum;","poem":1},{"text":"ar uddar gora šudu Mabudor ham.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Bade Mabud he masore hokum dil, ar he mase Yunus nobire fuwana zagar uwore hogori bairgoridil."]}],"footnotes":[]},"thisChapterLink":"/api/rhg_sco/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rhg_sco/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rhg_sco/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}