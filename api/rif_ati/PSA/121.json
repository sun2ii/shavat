verse","number":8,"content":["سِيذِي أَذْ إِحْضَا ؤُفُّوغْ نّشْ ذ وَاذَافْ نّشْ، زِي ڒخُّو أَڒْ إِ ڒبْذَا."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":79,"caller":"◼","text":"121:‏7 ’ڒعْمَارْ نّكْ‘ - إِخْسْ أَذْ يِينِي ’ثُوذَارْثْ نّكْ‘.","reference":{"chapter":121,"verse":7}}]},"thisChapterLink":"/api/rif_ati/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rif_ati/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rif_ati/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}