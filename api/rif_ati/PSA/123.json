{"translation":{"id":"rif_ati","name":"أَذْلِيسْ إِقدّْسنْ","website":"https://ebible.org/Scriptures/details.php?id=rifa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rifa","licenseNotes":null,"shortName":"ATI","englishName":"Tarifit Bible (Arabic Script)","language":"rif","textDirection":"rtl","sha256":"33ceda82181f8442b1227c6951e1e5ee5e37733d0157bda6fa1252988f489cc4","availableFormats":["json"],"listOfBooksApiLink":"/api/rif_ati/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31171,"languageName":"Riffian","languageEnglishName":"Riffian"},"book":{"id":"PSA","translationId":"rif_ati","name":"إِزهِّيذنْ","commonName":"إِزهِّيذنْ","title":"إِزهِّيذنْ","order":19,"numberOfChapters":150,"sha256":"bc05220805c67a3ef37ec0854885f65caa356455e7220905f9e7787da888cf86","firstChapterNumber":1,"firstChapterApiLink":"/api/rif_ati/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rif_ati/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":123,"content":[{"type":"verse","number":1,"content":["إِزْڒِي ن ؤُڭعّذْ.",{"lineBreak":true},"نشّْ سّْڭعّْذغْ ثِيطَّاوِينْ إِنُو غَاركْ، شكْ إِ إِقِّيمنْ خْ ڒْكُورْسِي نّسْ ذڭْ ؤُجنَّا."]},{"type":"verse","number":2,"content":["خْزَارْ، أَمْ ثِيطَّاوِينْ ن إِسمْغَانْ غَارْ ؤُفُوسْ ن بَابْ نْسنْ، أَمْ ثِيطَّاوِينْ ن ثَايَّا غَارْ ؤُفُوسْ ن لَالَّاسْ، أَمُّو إِ خزَّارنْثْ ثِيطَّاوِينْ نّغْ غَارْ سِيذِي، أَربِّي نّغْ، أَڒْ خَانغْ إِ غَا إِحِينّْ."]},{"type":"line_break"},{"type":"verse","number":3,"content":["حِينّْ خَانغْ، أَ سِيذِي، حِينّْ خَانغْ، مَاغَارْ يُوزَا غَارْنغْ ؤُسحْقَارْ."]},{"type":"verse","number":4,"content":["ڒعْمَارْ نّغْ يُوزَا غَارسْ أَطَّاسْ زڭْ ؤُسْثهْزِي ن أَيْثْ ن بُو-نّْفَاخثْ، ؤُڒَا زڭْ ؤُسحْقَارْ ن إِغبَّاننْ."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/rif_ati/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rif_ati/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ri