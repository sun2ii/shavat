tent":["ثْوِيزَا نّغْ ثْبدّْ ذڭْ يِيسمْ ن سِيذِي، ونِّي إِڭِّينْ إِجنْوَانْ ذ ثمُّورْثْ."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/rif_ati/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rif_ati/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rif_ati/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}