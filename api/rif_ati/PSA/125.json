{"translation":{"id":"rif_ati","name":"أَذْلِيسْ إِقدّْسنْ","website":"https://ebible.org/Scriptures/details.php?id=rifa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rifa","licenseNotes":null,"shortName":"ATI","englishName":"Tarifit Bible (Arabic Script)","language":"rif","textDirection":"rtl","sha256":"33ceda82181f8442b1227c6951e1e5ee5e37733d0157bda6fa1252988f489cc4","availableFormats":["json"],"listOfBooksApiLink":"/api/rif_ati/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31171,"languageName":"Riffian","languageEnglishName":"Riffian"},"book":{"id":"PSA","translationId":"rif_ati","name":"إِزهِّيذنْ","commonName":"إِزهِّيذنْ","title":"إِزهِّيذنْ","order":19,"numberOfChapters":150,"sha256":"bc05220805c67a3ef37ec0854885f65caa356455e7220905f9e7787da888cf86","firstChapterNumber":1,"firstChapterApiLink":"/api/rif_ati/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rif_ati/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":["إِزْڒِي ن ؤُڭعّذْ.",{"lineBreak":true},"إِنِّي إِتّشْڒنْ خْ سِيذِي، أَقَا أَثنْ أَمْ وذْرَارْ ن صِيهْيُونْ، ونِّي وَارْ إِتّنْهزِّينْ، مَاشَا إِتّْغِيمَا إِ ڒبْذَا."]},{"type":"verse","number":2,"content":["أَمْ مَامّشْ إِذُورَارْ قُووَّارنْ إِ ؤُرْشَالِيمْ، أَمُّو إِقُووَّارْ سِيذِي إِ ڒْڭنْسْ نّسْ، زِي ڒخُّو أَڒْ ڒبْذَا."]},{"type":"line_break"},{"type":"verse","number":3,"content":["مَاغَارْ أَزدْجَاضْ ن ڒْغَارْ وَارْ إِتّْغِيمِي إِتَّاريّحْ خْ ثمُّورْثْ ن إِمْسڭَّاذنْ، حِيمَا إِمْسڭَّاذنْ وَارْ سّْوِيژِّيضنْ إِفَاسّنْ نْسنْ غَارْ ڒْغَارْ."]},{"type":"line_break"},{"type":"verse","number":4,"content":["إِڒِي أَذْ يڭّْ سِيذِي ثَاشُونِي ذڭْ إِصبْحَاننْ، ذڭْ إِنِّي إِسڭّْذنْ س وُوڒْ،",{"noteId":80}]},{"type":"verse","number":5,"content":["مَاشَا إِنِّي إِ غَا إِحيّْذنْ زڭْ وبْرِيذْ غَارْ إِبْرِيذنْ إِفَارْغنْ، أَذْ ثنْ إِسِّيڭّْوجْ سِيذِي جْمِيعْ أَكْ-ذ يِينِّي إِتّڭّنْ ڒْغشّْ. أَذْ ذِينْ يِيڒِي ڒهْنَا خْ إِسْرَائِيل."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":80,"caller":"◼","text":"125:‏4 ’س وُوڒْ‘ - س ثْعِيبْرَانِيثْ ’س وُوڒَاونْ‘.","reference":{"chapter":125,"verse":4}}]},"thisChapterLink":"/api/rif_ati/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rif_ati/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rif_ati/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}