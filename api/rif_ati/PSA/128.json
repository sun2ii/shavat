{"translation":{"id":"rif_ati","name":"أَذْلِيسْ إِقدّْسنْ","website":"https://ebible.org/Scriptures/details.php?id=rifa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rifa","licenseNotes":null,"shortName":"ATI","englishName":"Tarifit Bible (Arabic Script)","language":"rif","textDirection":"rtl","sha256":"33ceda82181f8442b1227c6951e1e5ee5e37733d0157bda6fa1252988f489cc4","availableFormats":["json"],"listOfBooksApiLink":"/api/rif_ati/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31171,"languageName":"Riffian","languageEnglishName":"Riffian"},"book":{"id":"PSA","translationId":"rif_ati","name":"إِزهِّيذنْ","commonName":"إِزهِّيذنْ","title":"إِزهِّيذنْ","order":19,"numberOfChapters":150,"sha256":"bc05220805c67a3ef37ec0854885f65caa356455e7220905f9e7787da888cf86","firstChapterNumber":1,"firstChapterApiLink":"/api/rif_ati/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rif_ati/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":["إِزْڒِي ن ؤُڭعّذْ.",{"lineBreak":true},"سّعْذْ ن كُوڒْ إِجّْ ونِّي إِتّڭّْوذنْ سِيذِي، ونِّي إِڭُّورنْ ذڭْ إِبْرِيذنْ نّسْ."]},{"type":"verse","number":2,"content":["أَقَا أَذْ ثشّذْ زڭْ وَارْبرْ ن إِفَاسّنْ نّشْ، أَذْ ثِيڒِيذْ ذ أَمِيمُونْ ذ لمْلِيحْ."]},{"type":"line_break"},{"type":"verse","number":3,"content":["ثَامْغَارْثْ نّشْ أَذْ ثِيڒِي أَمْ إِشْثْ ن ثْزَايَارْثْ إِ د-إِتَّاوْينْ ڒْغِيدْجثْ ذِي ثَادَّارْثْ نّشْ، أَرَّاونْ نّشْ أَذْ إِڒِينْ أَمْ إِغمُّوينْ ن زِّيثُونْ قُووَّارنْ إِ طَّابْڒَا نّشْ."]},{"type":"line_break"},{"type":"verse","number":4,"content":["أَمُّو إِ غَا إِتّْوَابَاركْ ورْيَازْ إِجهْذنْ نِّي إِتّڭّْوذنْ سِيذِي."]},{"type":"verse","number":5,"content":["سِيذِي أَذْ شكْ إِبَاركْ زِي صِيهْيُونْ، ؤُ أَذْ ثْژَارذْ أَقَا ؤُرْشَالِيمْ أَذْ ثِيڒِي مْلِيحْ، مَارَّا ؤُسَّانْ ن ثُوذَارْثْ نّشْ،"]},{"type":"verse","number":6,"content":["وَاهْ، أَذْ ثْژَارذْ إِحنْجِيرنْ ن إِحنْجِيرنْ نّشْ. ڒهْنَا أَذْ يِيڒِي خْ إِسْرَائِيل."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/rif_ati/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rif_ati/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rif_ati/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}