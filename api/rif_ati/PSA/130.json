{"translation":{"id":"rif_ati","name":"أَذْلِيسْ إِقدّْسنْ","website":"https://ebible.org/Scriptures/details.php?id=rifa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rifa","licenseNotes":null,"shortName":"ATI","englishName":"Tarifit Bible (Arabic Script)","language":"rif","textDirection":"rtl","sha256":"33ceda82181f8442b1227c6951e1e5ee5e37733d0157bda6fa1252988f489cc4","availableFormats":["json"],"listOfBooksApiLink":"/api/rif_ati/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31171,"languageName":"Riffian","languageEnglishName":"Riffian"},"book":{"id":"PSA","translationId":"rif_ati","name":"إِزهِّيذنْ","commonName":"إِزهِّيذنْ","title":"إِزهِّيذنْ","order":19,"numberOfChapters":150,"sha256":"bc05220805c67a3ef37ec0854885f65caa356455e7220905f9e7787da888cf86","firstChapterNumber":1,"firstChapterApiLink":"/api/rif_ati/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rif_ati/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":["إِزْڒِي ن ؤُڭعّذْ.",{"lineBreak":true},"زِي ڒَادْجَاغْ ڒَاغِيغْ-د خَاكْ، أَ سِيذِي!"]},{"type":"verse","number":2,"content":["أَ سِيذِي إِنُو، سڒْ إِ ثْمِيجَّا إِنُو، أجّْ إِمزُّوغنْ نّشْ أَذْ فثْننْ خْ ثْمِيجَّا ن ثُوثْرَا إِنُو!"]},{"type":"line_break"},{"type":"verse","number":3,"content":["أَ سِيذِي، مَاڒَا ثحْضِيضْ ڒْْمُوعْصِييَّاثْ مْلِيحْ، أَ سِيذِي إِنُو، مَانْ ونْ إِزمَّارنْ أَذْ إِقِّيمْ إِبدّْ."]},{"type":"verse","number":4,"content":["مَاشَا غَاركْ أَسَامحْ، مَاحنْذْ أَذْ زَّايكْ ڭّْوذنْ."]},{"type":"line_break"},{"type":"verse","number":5,"content":["نشّْ سِيثِيمغْ ذِي سِيذِي، ڒعْمَارْ إِنُو إِشُّورْ س ؤُسِيثمْ، تّْرَاجِيغْ أَوَاڒْ نّسْ،"]},{"type":"verse","number":6,"content":["ڒعْمَارْ إِنُو إِتّْرَاجَا سِيذِي إِنُو، أَطَّاسْ زڭْ إِعسَّاسنْ تّْرَاجَانْ غَارْ ؤُثفُّو."]},{"type":"line_break"},{"type":"verse","number":7,"content":["أجّْ إِسْرَائِيل أَذْ إِرَاجَا سِيذِي، مَاغَارْ ثَامخْسِيوْثْ إِشوَّارنْ أَقَا-ت غَارْ سِيذِي، غَارسْ أَفكِّي إِشطّْ."]},{"type":"verse","number":8,"content":["نتَّا أَذْ إِسّنْجمْ إِسْرَائِيل زِي مَارَّا ڒْمُوعْصِييَّاثْ نّسْ."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/rif_ati/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rif_ati/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rif_ati/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}