{"translation":{"id":"rif_ati","name":"أَذْلِيسْ إِقدّْسنْ","website":"https://ebible.org/Scriptures/details.php?id=rifa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rifa","licenseNotes":null,"shortName":"ATI","englishName":"Tarifit Bible (Arabic Script)","language":"rif","textDirection":"rtl","sha256":"33ceda82181f8442b1227c6951e1e5ee5e37733d0157bda6fa1252988f489cc4","availableFormats":["json"],"listOfBooksApiLink":"/api/rif_ati/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31171,"languageName":"Riffian","languageEnglishName":"Riffian"},"book":{"id":"PSA","translationId":"rif_ati","name":"إِزهِّيذنْ","commonName":"إِزهِّيذنْ","title":"إِزهِّيذنْ","order":19,"numberOfChapters":150,"sha256":"bc05220805c67a3ef37ec0854885f65caa356455e7220905f9e7787da888cf86","firstChapterNumber":1,"firstChapterApiLink":"/api/rif_ati/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rif_ati/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":150,"content":[{"type":"verse","number":1,"content":["هَالِّيلُو-يَاهْ، صبّْحمْ أَربِّي ذِي زَّاوشْثْ نّسْ إِقدّْسنْ، صبّْحمْ ث ذِي ڒْكُوبّثْ ن جّهْذْ نّسْ!"]},{"type":"verse","number":2,"content":["صبّْحمْ ث خْ ثْمڭَّا نّسْ ثِيمقّْرَانِينْ، صبّْحمْ ث خْ ڒمْغَارثْ نّسْ ثَامقّْرَانْثْ!"]},{"type":"verse","number":3,"content":["صبّْحمْ س ثْمِيجَّا ن ؤُسُوضِي ذڭْ ؤُيِيشّْ ن إِشَارِّي، صبّْحمْ س لهَارْپَا ذ ڒْڭَامْبْرِي!"]},{"type":"verse","number":4,"content":["صبّْحمْ ث س ؤُبنْذِيرْ ذ شّْضِيحْ س نُّوبْثَاثْ، صبّْحمْ ث س ثِيرَارْثْ ن إِفِيڒَانْ ذ ثمْجَا!"]},{"type":"verse","number":5,"content":["صبّْحمْ أَسْ س ڒْحسّْ إِفْسُوسنْ ن ثدْجُونِينْ ن وُوزَّاڒْ، صبّْحمْ أَسْ س ڒْحسّْ يُوعْڒَانْ ن ثدْجُونِينْ ن وُوزَّاڒْ!"]},{"type":"line_break"},{"type":"verse","number":6,"content":["مَارَّا مِينْ إِتَّارَّانْ نّفْسْ، صبّحْ إِ سِيذِي. هَالِّيلُو-يَاهْ!"]}],"footnotes":[]},"thisChapterLink":"/api/rif_ati/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rif_ati/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rif_ati/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}