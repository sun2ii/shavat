{"translation":{"id":"rif_ati","name":"أَذْلِيسْ إِقدّْسنْ","website":"https://ebible.org/Scriptures/details.php?id=rifa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rifa","licenseNotes":null,"shortName":"ATI","englishName":"Tarifit Bible (Arabic Script)","language":"rif","textDirection":"rtl","sha256":"33ceda82181f8442b1227c6951e1e5ee5e37733d0157bda6fa1252988f489cc4","availableFormats":["json"],"listOfBooksApiLink":"/api/rif_ati/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31171,"languageName":"Riffian","languageEnglishName":"Riffian"},"book":{"id":"PSA","translationId":"rif_ati","name":"إِزهِّيذنْ","commonName":"إِزهِّيذنْ","title":"إِزهِّيذنْ","order":19,"numberOfChapters":150,"sha256":"bc05220805c67a3ef37ec0854885f65caa356455e7220905f9e7787da888cf86","firstChapterNumber":1,"firstChapterApiLink":"/api/rif_ati/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rif_ati/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":["إِ ؤُمقّْرَانْ ن إِمغْنَاجنْ. أَكْ-ذ ؤُزنْزُونْ خْ إِفِيڒَانْ. أَزهّذْ. إِزْڒِي."]},{"type":"line_break"},{"type":"verse","number":2,"content":["أَذْ خَانغْ إِحِينّْ أَربِّي. نتَّا إِتّجَّا ؤُذمْ نّسْ أَذْ خَانغْ يَارْغْ - سِيلَاهْ -"]},{"type":"line_break"},{"type":"verse","number":3,"content":["مَاحنْذْ أَذْ سّْننْ أَبْرِيذْ نّشْ خْ ثمُّورْثْ، أَذْ سّْننْ أَسنْجمْ نّشْ جَارْ مَارَّا ڒڭْنُوسْ!"]},{"type":"line_break"},{"type":"verse","number":4,"content":["ڒڭْنُوسْ أَذْ شكْ قَاذَانْ، أَ أَربِّي، مَارَّا ڒڭْنُوسْ أَذْ شكْ قَاذَانْ."]},{"type":"line_break"},{"type":"verse","number":5,"content":["ڒڭْنُوسْ أَذْ فَارْحنْ، أَذْ سْڒِيوڒْونْ، مَاغَارْ شكْ أَذْ ثْحكْمذْ خْ ڒڭْنُوسْ نِيشَانْ، شكْ أَذْ ثسُّويُورذْ شُّوعُوبْ خْ ثمُّورْثْ - سِيلَاهْ -"]},{"type":"line_break"},{"type":"verse","number":6,"content":["ڒڭْنُوسْ أَذْ شكْ قَاذَانْ، أَ أَربِّي، مَارَّا ڒڭْنُوسْ أَذْ شكْ قَاذَانْ."]},{"type":"line_break"},{"type":"verse","number":7,"content":["ثَامُّورْثْ ثتِّيشْ ڒْغِيدْجثْ نّسْ. أَربِّي، أَربِّي نّغْ، أَذْ أَنغْ إِبَاركْ."]},{"type":"line_break"},{"type":"verse","number":8,"content":["أَربِّي أَذْ أَنغْ إِبَاركْ ؤُ مَارَّا ثِينڭُّورَا ن ثمُّورْثْ أَذْ زَّايسْ ڭّْوذنْثْ."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/rif_ati/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rif_ati/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rif_ati/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}