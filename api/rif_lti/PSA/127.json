{"translation":{"id":"rif_lti","name":"Adlis Iqeddsen","website":"https://ebible.org/Scriptures/details.php?id=rifl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rifl","licenseNotes":null,"shortName":"LTI","englishName":"Tarifit Bible Latin Script","language":"rif","textDirection":"ltr","sha256":"3b3246b3ffd237a4a7819882ab80124dc645e0274e1123ba7a67c2c5c85e54a1","availableFormats":["json"],"listOfBooksApiLink":"/api/rif_lti/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31171,"languageName":"Riffian","languageEnglishName":"Riffian"},"book":{"id":"PSA","translationId":"rif_lti","name":"Izehhiden","commonName":"Izehhiden","title":"Izehhiden","order":19,"numberOfChapters":150,"sha256":"2109bed190206ae36e015326f876b6174a7ca233b083decd0be6beeac4f439ef","firstChapterNumber":1,"firstChapterApiLink":"/api/rif_lti/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rif_lti/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":["Izři n ugeɛɛed. N Suliman.",{"lineBreak":true},"Mři war ibenni SIDI taddart, ad ssiḥřen ibennayen ixef nsen baṭeř. Mři war iḥeṭṭi SIDI x tendint, aɛessas ad iɛess baṭeř."]},{"type":"line_break"},{"type":"verse","number":2,"content":["Baṭeř aqa kenniw ad tekkarem zic, ad tᵉṭṭṣem tɛeḍřem, ad teccem aɣrum n řemḥayen, maɣar Netta ittic i-t i imɛizzen nnes deg yiḍeṣ."]},{"type":"line_break"},{"type":"verse","number":3,"content":["Xzar, arrawen d tasɣart i immewcen zi SIDI, řɣiǧet n uɛeddis aqa-tt d řmunet."]},{"type":"verse","number":4,"content":["Am mammec jehdent fřitcat n řqews deg ufus n weryaz, ammu i ǧan arrawen zeg iseggʷusa n temẓi."]},{"type":"line_break"},{"type":"verse","number":5,"content":["Sseɛd n weryaz ijehden nni zzaysen iccur aqrab nnes n fřitcat n řqews. Nitni war ttseḍḥin ca umi ssawařen ak-d řɛedyan ɣar tewwart n tendint."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/rif_lti/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rif_lti/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rif_lti/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}