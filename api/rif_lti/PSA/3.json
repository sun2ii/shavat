{"translation":{"id":"rif_lti","name":"Adlis Iqeddsen","website":"https://ebible.org/Scriptures/details.php?id=rifl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rifl","licenseNotes":null,"shortName":"LTI","englishName":"Tarifit Bible Latin Script","language":"rif","textDirection":"ltr","sha256":"3b3246b3ffd237a4a7819882ab80124dc645e0274e1123ba7a67c2c5c85e54a1","availableFormats":["json"],"listOfBooksApiLink":"/api/rif_lti/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31171,"languageName":"Riffian","languageEnglishName":"Riffian"},"book":{"id":"PSA","translationId":"rif_lti","name":"Izehhiden","commonName":"Izehhiden","title":"Izehhiden","order":19,"numberOfChapters":150,"sha256":"2109bed190206ae36e015326f876b6174a7ca233b083decd0be6beeac4f439ef","firstChapterNumber":1,"firstChapterApiLink":"/api/rif_lti/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rif_lti/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Azehhed n Dawud, umi yarweř zeg wudem n mmis Abcalum."]},{"type":"line_break"},{"type":"verse","number":2,"content":["A SIDI, inni d ayi iḥeṣṣaren aqa kettaren, aṭṭas aqa aten ḍidd inu."]},{"type":"verse","number":3,"content":["Aṭṭas aqa qqaren x řeɛmar inu: “I netta war din iǧi usenjem ɣar AREBBI!” Silah."]},{"type":"line_break"},{"type":"verse","number":4,"content":["Aḥeqqa Cek, a SIDI, d taseddart n useřqi i necc, aɛuǧi inu, Cek d wenni issgeɛɛden azeǧif inu."]},{"type":"verse","number":5,"content":["S tmijja inu řaɣiɣ i SIDI, uca Netta yarra-dd xafi zeg wedrar nnes iqeddsen. Silah."]},{"type":"line_break"},{"type":"verse","number":6,"content":["Senndeɣ uca ikka xafi yiḍeṣ, faqeɣ-dd, minzi SIDI ittɛawen ayi."]},{"type":"verse","number":7,"content":["War tteggʷideɣ zi ɛecra n řuřuf n řgens, inni d ayi dd-innḍen, ssbeddan ixef nsen x iɣezdisen inu."]},{"type":"line_break"},{"type":"verse","number":8,"content":["Kkar, a SIDI, senjem ayi, a AREBBI inu, minzi Cek tewtid marra řɛedyan inu ɣar uɣesmir, aqa teddzed tiɣmas n iɛeffanen."]},{"type":"verse","number":9,"content":["Asenjem aqa-t n SIDI, lbaraka nnec aqa-tt x řgens nnec. Silah."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/rif_lti/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rif_lti/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rif_lti/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}