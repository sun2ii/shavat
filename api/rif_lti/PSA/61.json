{"translation":{"id":"rif_lti","name":"Adlis Iqeddsen","website":"https://ebible.org/Scriptures/details.php?id=rifl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rifl","licenseNotes":null,"shortName":"LTI","englishName":"Tarifit Bible Latin Script","language":"rif","textDirection":"ltr","sha256":"3b3246b3ffd237a4a7819882ab80124dc645e0274e1123ba7a67c2c5c85e54a1","availableFormats":["json"],"listOfBooksApiLink":"/api/rif_lti/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31171,"languageName":"Riffian","languageEnglishName":"Riffian"},"book":{"id":"PSA","translationId":"rif_lti","name":"Izehhiden","commonName":"Izehhiden","title":"Izehhiden","order":19,"numberOfChapters":150,"sha256":"2109bed190206ae36e015326f876b6174a7ca233b083decd0be6beeac4f439ef","firstChapterNumber":1,"firstChapterApiLink":"/api/rif_lti/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rif_lti/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":["I umeqqran n imeɣnajen. Ak-d uzenzun x ifiřan. N Dawud."]},{"type":"line_break"},{"type":"verse","number":2,"content":["A AREBBI, seř i uřaɣi inu, seř mliḥ i tẓaǧit inu."]},{"type":"verse","number":3,"content":["Zi ṭṭarf aneggar n temmurt ttřaɣiɣ xak, xmi ittefciř wuř inu. Ndeh ayi x ijj n jjarf yuɛřan xafi."]},{"type":"verse","number":4,"content":["Maɣar Cek d amcan n tarewřa i necc, d lburj ijehden ḍidd i řeɛdu."]},{"type":"verse","number":5,"content":["Necc ad qqimeɣ deg Uqiḍun nnec i řebda, ad arewřeɣ sadu udurri n wafriwen nnec. Silah."]},{"type":"line_break"},{"type":"verse","number":6,"content":["Maɣar Cek, a AREBBI, tesřid ɣar lwuɛud inu. Cek tewcid ayi tasɣart n yinni itteggʷeden Isem nnec."]},{"type":"verse","number":7,"content":["Arni ɛad ussan x wussan n ujeǧid, ejj ad aredfen iseggʷusa nnes ijj i wenneɣni am jjiř iḍfar umas."]},{"type":"verse","number":8,"content":["Netta ad iqqim zzat i wudem n AREBBI i řebda. Ad xas teḥḍa tamexsiwt icewwaren d řaman."]},{"type":"verse","number":9,"content":["Xenni ad zehhdeɣ i Yisem nnec i řebda, ḥima ad kemmřeɣ lwuɛud inu, ass awarni umas."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/rif_lti/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rif_lti/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rif_lti/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}