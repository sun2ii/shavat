{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"AMO","translationId":"rmc_the","name":"Amos","commonName":"Amos","title":"O Amos","order":30,"numberOfChapters":9,"sha256":"c89079fd4f99937fe085902198e7ae49e5bb63d17a494870dfa340d100f70bdd","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/rmc_the/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["O Izrael the e Samarija ena zňičimen"]},{"type":"verse","number":1,"content":[{"text":"Šunen kada lav, savo vakerel o RAJ pre tumende,","poem":1},{"text":"manušale andral o Izrael,","poem":2},{"lineBreak":true},{"text":"pre savore fameliji, saven iľa avri andral o Egipt:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"„Ča tumen mange kidňom avri","poem":1},{"text":"savore famelijendar pal caľi phuv,","poem":2},{"text":"vašoda tumen marava","poem":1},{"text":"vaš savore tumare bini.“","poem":2}]},{"type":"heading","content":["Sar o RAJ vakerel, o prorokos prorokinel"]},{"type":"verse","number":3,"content":[{"text":"Či šaj džan duj džene jekhetane,","poem":1},{"text":"te pes mek na dovakerde?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Či gravčinela o ľevos andro veš,","poem":1},{"text":"te les na ela korisť?","poem":2},{"text":"Či kerela vika o terno ľevos andral peskro than,","poem":1},{"text":"te ňič na chudňa?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Či pes chudela o čiriklo andre pasca pre phuv,","poem":1},{"text":"te ode na ela ňisavi navnada?","poem":2},{"text":"Či pes phandela e pasca pre phuv,","poem":1},{"text":"te ňič na chudela?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Či na predarana o manuša,","poem":1},{"text":"te andro foros šunďola e truba?","poem":2},{"text":"Či pes ačhela andro foros vareso nalačho,","poem":1},{"text":"so na domukľahas o Del?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Čačes, o RAJ, o Adonaj, na kerela ňič bijal oda,","poem":1},{"text":"hoj te na phenel avri peskro planos","poem":2},{"lineBreak":true},{"text":"peskre služobňikenge, le prorokenge.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Te o ľevos gravčinel,","poem":1},{"text":"ko pes na daranďiľahas?","poem":2},{"text":"Te o RAJ, o Adonaj, vakerel,","poem":1},{"text":"ko na prorokinďahas?","poem":2}]},{"type":"heading","content":["E Samarija ela marďi"]},{"type":"verse","number":9,"content":[{"text":"Vakeren ko hradi andro Ašdod","poem":1},{"text":"the ko hradi andro Egipt","poem":2},{"text":"a phenen: „Zdžan tumen pro verchi andre Samarija","poem":1},{"text":"a dikhen, savo pharipen the trapišagos hin ode lakre manušen.“","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kavke phenel o RAJ:","poem":1},{"lineBreak":true},{"text":"„Se na džanen te kerel oda,","poem":1},{"text":"so hin lačho;","poem":2},{"text":"peskre khera pherdžaren oleha,","poem":1},{"text":"so občorarde a zaile avrendar.“","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vašoda kavke phenel o Adonaj, o RAJ:","poem":1},{"lineBreak":true},{"text":"„O ňeprijaťeľis pes rozthovela pašal tumari phuv,","poem":1},{"text":"lela tumendar e zor","poem":2},{"text":"a občorarela tumare hradi.“","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kavke phenel o RAJ:","poem":1},{"lineBreak":true},{"text":"„Avke sar o pasťjeris zachraňinel andral o piskos le ľevoskro","poem":1},{"text":"ča duj labici abo ča sikrica le kanestar,","poem":2},{"text":"avke o Izraeliti, save bešen andre Samarija,","poem":1},{"text":"ena zachraňimen a zachraňinena peske ča kotorora","poem":2},{"lineBreak":true},{"text":"peskre šukar stolkendar the divanendar.“","poem":2}]},{"type":"heading","content":["O oltara andro Betel"]},{"type":"verse","number":13,"content":[{"text":"„Akana šunen a svedčinen pro potomki le Jakoboskre,“","poem":1},{"text":"phenel o RAJ, o Adonaj, o Nekzoraleder Del,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"„Bo andre oda džives, sar avava","poem":1},{"text":"te marel le Izrael vaš lengre bini,","poem":2},{"lineBreak":true},{"text":"marava the o foros Betel vaš leskre oltara;","poem":2},{"text":"phagerde ena o rohi dojekhe oltariskre","poem":1},{"text":"a perena pre phuv.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Čhivava tele lengre jevendeskre the ňilajeskre khera;","poem":1},{"text":"lengre khera obthode la slonovinatar rozperena;","poem":2},{"text":"lengre bare khera ena zňičimen,“","poem":1},{"text":"phenel o RAJ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}