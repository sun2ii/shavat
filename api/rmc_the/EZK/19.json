{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"EZK","translationId":"rmc_the","name":"Ezechiel","commonName":"Ezechiel","title":"O Ezechiel","order":26,"numberOfChapters":48,"sha256":"b3b2da3f5fc096dcef031335a2945f3503235aa9cd1f1413506c3732f82724ab","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/rmc_the/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["O halgatovos pal o kraľa le Izraeloskre"]},{"type":"verse","number":1,"content":["„Ale tu giľav o halgatovos pal o kraľa le Izraeloskre"]},{"type":"verse","number":2,"content":["a phen:",{"lineBreak":true},{"text":"‚Savi zoraľi ľevica sas tiri daj maškar o ľevi!","poem":1},{"text":"Pašľolas peske paš lende","poem":2},{"lineBreak":true},{"text":"a bararelas avri peskre cikne ľeven.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jekhes peskre ciknorendar bararďa avri","poem":1},{"text":"a kerďa lestar zoralo ľevos","poem":2},{"text":"a ov sikľiľa te rozčhingerel e korisť","poem":1},{"text":"a te chal le manušen.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O narodi pes pal leste došunde","poem":1},{"text":"a chudle les andre peskri jama;","poem":2},{"lineBreak":true},{"text":"ľigende les pro haki andro Egipt.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sar e ľevica dikhľa,","poem":1},{"text":"hoj pes na ačhiľa oda, so užarelas,","poem":2},{"text":"iľa peskre ciknorendar avres","poem":1},{"text":"a lestar kerďa zoralo ľevos.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ov phirelas maškar o ľevi","poem":1},{"text":"a ačhiľa lestar zoralo ľevos;","poem":2},{"text":"sikľiľa te rozčhingerel e korisť","poem":1},{"text":"a te chal le manušen.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Čhiďa tele lengre palaca","poem":1},{"text":"a zňičinďa lengre fori.","poem":2},{"text":"Sar gravčinelas,","poem":1},{"text":"daralas lestar caľi phuv","poem":2},{"lineBreak":true},{"text":"the savore, so andre sas.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Skidle pes pre leste upre o narodi","poem":1},{"text":"andral o phuva pašal leste.","poem":2},{"text":"Nacirdle pre leste e sita","poem":1},{"text":"a chudle les andre peskri jama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Thode les pro haki andre kľitka","poem":1},{"text":"a ande les ko babiloňiko kraľis.","poem":2},{"text":"Phandle les andre bertena vašoda,","poem":1},{"text":"hoj les imar te na šunďol te gravčinel","poem":2},{"lineBreak":true},{"text":"pro verchi le Izraeloskre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tiri daj sas sar o viňičis andre viňica,","poem":1},{"text":"sadzimen paš o paňi;","poem":2},{"text":"bariľa pre late but ovocje the konarica,","poem":1},{"text":"bo sas la pherdo paňi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ole viňičis sas zorale konarica,","poem":1},{"text":"lačhe pro vladariko žezlos;","poem":2},{"text":"bariľa dži paš o chmari.","poem":1},{"text":"Sako les dikhelas,","poem":2},{"text":"bo sas les pherdo konarica","poem":1},{"text":"a sas igen baro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ale sas avricirdlo choľaha","poem":1},{"text":"a čhido pre phuv.","poem":2},{"text":"E tači balvaj pal o vichodos","poem":1},{"text":"šučarďa leskro ovocje,","poem":2},{"text":"leskre zorale konara šučile avri","poem":1},{"text":"a zlabarďa len e jag.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akana sas presadzimen pre pušťa","poem":1},{"text":"andre šuki phuv bi o paňi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Paľis chučiľa avri e jag jekhe konaristar","poem":1},{"text":"a zlabarďa leskre konarica the leskro ovocje,","poem":2},{"text":"na ačhiľa pre leste aňi jekh zoralo konaris","poem":1},{"text":"lačho pro vladariko žezlos.‘","poem":2},{"lineBreak":true},"Kada hin o halgatovos a giľavela pes sar halgatovos.“"]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}