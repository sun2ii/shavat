{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"HOS","translationId":"rmc_the","name":"Hozeaš","commonName":"Hozeaš","title":"O Hozeaš","order":28,"numberOfChapters":14,"sha256":"dbe5d6ca9958826334d19b5f7472f81a16eb9ec319a82effba7a5824f6df8217","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/rmc_the/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"E Samarija ľidžala e vina,","poem":1},{"text":"bo pes vzburinďa pre peskro Del.","poem":2},{"text":"Lakre manušen murdarena la šabľaha,","poem":1},{"text":"lakre čhaven rozpučinena pre phuv","poem":2},{"lineBreak":true},{"text":"a le khabne džuvľen rozparinena.","poem":2}]},{"type":"heading","content":["O prorokos vičinel le Izrael te kerel pokaňje"]},{"type":"verse","number":2,"content":[{"text":"Visar tut pale ko RAJ, Izraelona, ke tiro Del,","poem":1},{"text":"bo angle tire bini tuke poddžanas o pindre.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Len tumenca o lava,","poem":1},{"text":"visaren tumen ko RAJ","poem":2},{"lineBreak":true},{"text":"a phenen leske:","poem":2},{"text":"„Odmuk amenge savore amare bini","poem":1},{"text":"a prile amen lačhe jileha,","poem":2},{"text":"hoj e chvala andral amaro muj tuke te el","poem":1},{"text":"sar o biki pre obeta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E Asirija amen na zachraňinela,","poem":1},{"text":"na džaha te bešel pro graja","poem":2},{"text":"a na phenaha ole vecenge,","poem":1},{"text":"so kerďam amare vastenca: ‚Amare devla!‘,","poem":2},{"lineBreak":true},{"text":"bo tu sal lačhejileskro ko široti.“","poem":2}]},{"type":"heading","content":["O Del pale požehňinela le Izrael"]},{"type":"verse","number":5,"content":[{"text":"O RAJ phenel:","poem":1},{"text":"„Anava mire manušen pale ke ma.","poem":2},{"text":"Kamava len andral calo miro jilo,","poem":1},{"text":"bo imar na som pre lende choľamen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Avava sar e rosa le Izraeloske,","poem":1},{"text":"rozkvitňisaľola sar e ľaľija","poem":2},{"lineBreak":true},{"text":"a mukela o koreňa sar o cedri andro Libanon.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Barona leske o neve konara,","poem":1},{"text":"ela šukar sar e oliva","poem":2},{"lineBreak":true},{"text":"a voňinela sar o cedri andro Libanon.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O manuša pale bešena tel leskro ciňos","poem":1},{"text":"a barona sar e pšeňica","poem":2},{"noteId":19},{"text":";","poem":2},{"text":"kvitňisaľona sar o viňičis,","poem":1},{"text":"lengri slava ela sar e libanoňiko mol.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akor phenela o Efrajim: ‚So man chal le modlenca?","poem":1},{"lineBreak":true},{"text":"Kamav te odphenel pre tiro kamiben,","poem":1},{"text":"te dikhel mire jakhenca pre tute.","poem":2},{"text":"Avke avava sar o smrekos furt zeleno,","poem":1},{"text":"anava tiro ovocje.‘ “","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Oda, ko hin goďaver, mi achaľol kale vecenge!","poem":1},{"lineBreak":true},{"text":"Oda, ko mištes rozsudzinel, mi prindžarel len!","poem":1},{"lineBreak":true},{"text":"O droma le RAJESKRE hine čače,","poem":1},{"text":"o spravodľiva pal lende phiren,","poem":2},{"lineBreak":true},{"text":"ale o binošna pre lende peren.","poem":2}]}],"footnotes":[{"noteId":19,"caller":"+","text":"14,8 hebrejiko čhib: sadzinena e pšeňica","reference":{"chapter":14,"verse":8}}]},"thisChapterLink":"/api/rmc_the/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":10}