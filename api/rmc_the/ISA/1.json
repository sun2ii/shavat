{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"ISA","translationId":"rmc_the","name":"Izajaš","commonName":"Izajaš","title":"O Izajaš","order":23,"numberOfChapters":66,"sha256":"b8b9e340075247e3e493dc15c7c64fa860156731efed0895ebef622c03f40f0f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/rmc_the/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["O viďeňje, savo dikhľa o Izajaš, le Amososkro čhavo, pal e Judsko the pal o Jeruzalem, sar andre Judsko kraľinenas o Uziaš, o Jotam, o Achaz the o Chizkija",{"noteId":0},"."]},{"type":"heading","content":["O Izrael pes ačhavel le RAJESKE"]},{"type":"verse","number":2,"content":[{"text":"Šun, ňebona! Šun, phuvije!","poem":1},{"text":"Bo o RAJ phenel:","poem":2},{"text":"„Le čhaven ľikerďom avri a bararďom,","poem":1},{"text":"ale on pes mange ačhade.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O volos prindžarel peskre gazdas","poem":1},{"text":"a o somaris džanel o valovos,","poem":2},{"lineBreak":true},{"text":"khatar les leskro raj karminel,","poem":2},{"text":"ale o Izrael oda na džanel;","poem":1},{"text":"mire manuša na achaľon.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vigos le binošne narodoske;","poem":1},{"text":"le manušenge, pre save hin pherdo vini,","poem":2},{"text":"le potomkenge le nalačhe manušengre,","poem":1},{"text":"le čhavenge, so keren falošňe!","poem":2},{"text":"Omukle le RAJES,","poem":1},{"text":"tele dikhle le Izraeloskre Svete Devles,","poem":2},{"lineBreak":true},{"text":"calkom pes lestar visarde het.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kaj tumen mek te marel,","poem":1},{"text":"te mek furt tumen vzburinen?","poem":2},{"text":"Calo tumaro šero hino dukhado;","poem":1},{"text":"calo tumaro jilo hino slabo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nane pre tumende ňič sasto,","poem":1},{"text":"le šerestar dži o peti žuže modrini,","poem":2},{"text":"jazvi the otkerde rani,","poem":1},{"text":"save nane obžužarde aňi sphandle","poem":2},{"lineBreak":true},{"text":"aňi makhle le olejoha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tumari phuv hiňi pušťa,","poem":1},{"text":"tumare fori hine labarde avri;","poem":2},{"text":"tumaro uľipen chan avri o cudzinci","poem":1},{"text":"angle tumare jakha;","poem":2},{"lineBreak":true},{"text":"o cudzinci zňičinde e phuv.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O Jeruzalem hino omuklo","poem":1},{"text":"sar e budkica andre viňica,","poem":2},{"text":"sar e chatkica pre ogurkengri maľa,","poem":1},{"text":"sar o obkľučimen foros.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Te amenge o Nekzoraleder RAJ","poem":1},{"text":"na mukľahas varesave manušen te dživel,","poem":2},{"lineBreak":true},{"text":"uľamas sar e Sodoma the e Gomora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tumen rajale, so san sar o raja andre Sodoma,","poem":1},{"text":"šunen o lav le RAJESKRO!","poem":2},{"text":"Manušale, so dživen avke sar andre Gomora,","poem":1},{"text":"šunen, so tumen sikavel amaro Del!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"„Pre soste mange anen ajci but obeti?“","poem":1},{"text":"phenel o RAJ.","poem":2},{"text":"„Imar som prechalo le labarde bakrane obetendar,","poem":1},{"text":"le thule dobitkoskre žirostar;","poem":2},{"text":"nane mange pre dzeka o rat le bikengro,","poem":1},{"text":"le bakrengro the le capengro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ko tumen vičinďa,","poem":1},{"text":"hoj tumen te aven te sikavel angle miro muj?","poem":2},{"text":"Ko tumendar kamel,","poem":1},{"text":"hoj furt te phiren pal mire chramoskre dvori?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ma anen mange imar o zbitočna obeti!","poem":1},{"text":"Džungľiľa mange tumaro kaďidlos,","poem":2},{"text":"o inepos le Neve čhoneskro, o šabat","poem":1},{"text":"the tumare zhromažďeňja.","poem":2},{"text":"Našťi avri ačhav o nalačhipen","poem":1},{"text":"andre tumaro zhromažďeňje!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tumare oslavi pro nevo čhon the inepi","poem":1},{"text":"andral calo jilo našťi avri ačhav;","poem":2},{"text":"anen mange o pharipen,","poem":1},{"text":"zuňinďom len imar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sar ke ma hazdena o vasta andre modľitba,","poem":1},{"text":"me phandava andre mire jakha;","poem":2},{"text":"kajte tumen but modľinena,","poem":1},{"text":"me na šunava,","poem":2},{"lineBreak":true},{"text":"bo pre tumare vasta hin pherdo rat.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Obžužaren tumen a aven žuže!","poem":1},{"text":"Len het tumare nalačhe skutki pašal mire jakha!","poem":2},{"lineBreak":true},{"text":"Preačhen te kerel o nalačhipen!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sikľon te kerel o lačho.","poem":1},{"text":"Dodikhen, hoj pes te kerel o spravodľišagos!","poem":2},{"text":"Pomožinen olenge, ko hine strapimen,","poem":1},{"text":"vaš e širota pro sudos rušen","poem":2},{"lineBreak":true},{"text":"a zaačhen vaš e vdova!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"„Aven akana, vakeras peske pal ada!“","poem":1},{"text":"phenel o RAJ.","poem":2},{"text":"„Kajte ulehas tumare bini lole sar o šarlat,","poem":1},{"text":"parňona avri sar o jiv;","poem":2},{"text":"kajte ulehas lole sar o lolo pochtan,","poem":1},{"text":"parňona avri sar e vlna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Te kamena a te man šunena,","poem":1},{"text":"chana o lačhe dari la phuvakre.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ale te na kamena","poem":1},{"text":"a ačhavena tumen mange,","poem":2},{"text":"avena murdarde la šabľaha.","poem":1},{"text":"Me, o RAJ, oda phenďom.“","poem":2}]},{"type":"heading","content":["O Jeruzalem hino binošno foros"]},{"type":"verse","number":21,"content":[{"text":"Sar šaj le pačivale forostar ačhiľa lubňi?","poem":1},{"text":"Varekana sas andre pherdo čačipen;","poem":2},{"text":"bešelas ode o spravodľišagos,","poem":1},{"text":"ale akana ode bešen o vrahi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Salas sar o rup,","poem":1},{"text":"ale akana na mos ňič.","poem":2},{"text":"Salas sar e lačhi mol,","poem":1},{"text":"ale akana hiňi mišimen le paňeha.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tire raja hine vzburenci","poem":1},{"text":"a ľikeren pes le zbujňikenca;","poem":2},{"text":"lenge savorenge džal pal o prepočiňiben","poem":1},{"text":"a rado prilen o dari;","poem":2},{"text":"vaš o široti na zaačhen pro sudos","poem":1},{"text":"a le vdovengro pripados aňi na šunen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Vašoda phenel o Raj, o Nekzoraleder RAJ,","poem":1},{"text":"o Zoralo Del le Izraeloskro:","poem":2},{"text":"„Vigos! Mukava avri miri choľi pre ola, ko pre ma džan,","poem":1},{"text":"a pomsťinava man mire ňeprijaťeľenge.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nacirdava pre tute miro vast;","poem":1},{"text":"obžužarava tut tira meľatar la jagaha;","poem":2},{"lineBreak":true},{"text":"lava tutar avri savoro nažužipen.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Dava tut pale kajse sudcen, sar tut sas varekana,","poem":1},{"text":"kajse radcen, sar tut sas čirla.","poem":2},{"text":"Paľis tut vičinena Spravodľivo foros,","poem":1},{"text":"o Pačivalo foros.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"O RAJ cinela avri o Sion le čačipnaha","poem":1},{"text":"a olen, ko keren pokaňje, le spravodľišagoha.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ale o vzburenci the o binošna ena zňičimen!","poem":1},{"text":"Ola, ko omuken le RAJES, merena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"„Ladžana tumen vaš o posvetna dubi,","poem":1},{"text":"pal save tumenge igen džalas;","poem":2},{"text":"ľoľona avri ladžatar vaš o zahradi,","poem":1},{"text":"save tumenge kidňan avri pro lašariben.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Avena sar o dubos,","poem":1},{"text":"pal savo peren tele o prajti,","poem":2},{"lineBreak":true},{"text":"sar e zahrada bi o paňi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"O zoralo manuš ela sar o phus","poem":1},{"text":"a leskri buči sar e iskra;","poem":2},{"text":"soduj labona jekhetane","poem":1},{"text":"a ňiko lengri jag na murdarela andre.“","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1,1 Andre varesave prekladi hin leskro nav Ezechiaš.","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/rmc_the/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}