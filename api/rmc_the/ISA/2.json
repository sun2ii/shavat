{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"ISA","translationId":"rmc_the","name":"Izajaš","commonName":"Izajaš","title":"O Izajaš","order":23,"numberOfChapters":66,"sha256":"b8b9e340075247e3e493dc15c7c64fa860156731efed0895ebef622c03f40f0f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/rmc_the/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":2,"content":[{"type":"heading","content":["O verchos le RAJESKRO"]},{"type":"verse","number":1,"content":["Kada hin lav, savo priiľa o Izajaš, le Amososkro čhavo, andro viďeňje pal e Judsko the pal o Jeruzalem."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Andro posledna dživesa","poem":1},{"text":"ela o verchos le RAJESKRE Chramoskro zathodo zorales;","poem":2},{"lineBreak":true},{"text":"ela nekučeder le verchendar","poem":2},{"text":"a barardo upral savore brehi","poem":1},{"text":"a savore narodi ke leste džana prudoha.","poem":2}]},{"type":"verse","number":3,"content":["But manuša avena a phenena:",{"text":"„Aven džas upre pro verchos le RAJESKRO,","poem":1},{"text":"andro Chramos le Jakoboskre Devleskro,","poem":2},{"text":"hoj amen te sikavel peskre droma","poem":1},{"text":"a hoj te phiras pal leskre chodňiki.“","poem":2},{"text":"Bo andral o Sion avela avri o zakonos","poem":1},{"text":"a o lav le RAJESKRO andral o Jeruzalem.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ov rozsudzinela maškar o narodi the maškar o but nipi.","poem":1},{"lineBreak":true},{"text":"Akor peske prekerena o šabľi pro motiki","poem":1},{"text":"a o kopiji pro vinarika čhura.","poem":2},{"text":"O narodos pro narodos na hazdela e šabľa","poem":1},{"text":"a imar pes na sikavena te marel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aven, čhavale le Jakoboskre,","poem":1},{"text":"phiras andro švetlos le RAJESKRO!","poem":2}]},{"type":"heading","content":["O Džives le RAJESKRO"]},{"type":"verse","number":6,"content":[{"text":"Tu, RAJEJA, odčhiďal tutar tire manušen,","poem":1},{"text":"le Jakoboskre potomken.","poem":2},{"text":"Bo hin len pherdo vražňika pal o vichodos","poem":1},{"text":"a veštci sar le Filišťincen;","poem":2},{"lineBreak":true},{"text":"spojinen pes le cudzincengre čhavenca.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Andre lengri phuv hin pherdo rup the somnakaj","poem":1},{"text":"a nane koňec lengre barvaľipnaske;","poem":2},{"text":"andre lengri phuv hin pherdo graja","poem":1},{"text":"a nane koňec lengre verdanenge.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Andre lengri phuv hin pherdo modli","poem":1},{"text":"a klaňinen pes oleske, so kerde peskre vastenca,","poem":2},{"lineBreak":true},{"text":"oleske, so kerde peskre anguštenca.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ale akana ena o manuša pokorimen,","poem":1},{"text":"sako ela poňižimen.","poem":2},{"lineBreak":true},{"text":"Tu lenge ma odmuk!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dža andre skala, garuv tut andro prachos","poem":1},{"text":"daratar anglo RAJ,","poem":2},{"lineBreak":true},{"text":"angle leskri kraľiko slava.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"O barikane jakha ena pokorimen,","poem":1},{"text":"o baripen le manušengro ela teledikhlo;","poem":2},{"text":"ča o RAJ ela barardo andre oda džives.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Oda džives le Nekzoraledere RAJESKRO","poem":1},{"text":"ela pre savore pišna the barikane","poem":2},{"text":"a the pre ola, ko pes ľidžan upre,","poem":1},{"text":"bo akor ena poňižimen.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Oda džives ela pre savore cedri andro Libanon,","poem":1},{"text":"uče a barikane,","poem":2},{"lineBreak":true},{"text":"pre savore dubi andro Bašan,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"pre savore uče verchi,","poem":1},{"text":"pre savore barikane brehi,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"pre savore bare veži,","poem":1},{"text":"pre savore barune muri,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"pre savore bare loďi,","poem":1},{"text":"a the pre savore nekšukareder loďki.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Pokorimen ela o baripen le manušeskro","poem":1},{"text":"a poňižimen ela o lašariben le manušengro;","poem":2},{"text":"ča o RAJ ela barardo andre oda džives","poem":1}]},{"type":"verse","number":18,"content":[{"text":"a o modli calkom našľona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Denašena andro jaskiňi la skalakre","poem":1},{"text":"the andro cheva tel e phuv","poem":2},{"text":"daratar anglo RAJ,","poem":1},{"text":"angle leskri kraľiko slava,","poem":2},{"lineBreak":true},{"text":"sar ušťela, hoj te daravel avri e phuv.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Andre oda džives o manuša čhivena het","poem":1},{"text":"le krtkenge the le ňetopierenge","poem":2},{"text":"peskre rupune the somnakune modli,","poem":1},{"text":"saven peske kerde, hoj pes lenge te klaňinen.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Garuvena pes andro cheva andro skali,","poem":1},{"text":"andro pukimen bare bara","poem":2},{"text":"daratar anglo RAJ,","poem":1},{"text":"angle leskri kraľiko slava,","poem":2},{"lineBreak":true},{"text":"sar ušťela, hoj te daravel avri e phuv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ma muken tumen pro manuš,","poem":1},{"text":"kaskro dživipnaskro dichos hin ča andro nakh!","poem":2},{"lineBreak":true},{"text":"Se ov tumenge našťi pomožinel!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}