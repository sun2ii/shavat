{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"ISA","translationId":"rmc_the","name":"Izajaš","commonName":"Izajaš","title":"O Izajaš","order":23,"numberOfChapters":66,"sha256":"b8b9e340075247e3e493dc15c7c64fa860156731efed0895ebef622c03f40f0f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/rmc_the/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":21,"content":[{"type":"heading","content":["O lav pro Babilon"]},{"type":"verse","number":1,"content":["O proroctvos pro Babilon – pre pušťa paš o moros:",{"text":"Avke sar e zoraľi balvaj phurdel pre pušťa Negev,","poem":1},{"text":"avke avela e pohroma pal e pušťa,","poem":2},{"lineBreak":true},{"text":"andral e strašno phuv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dikhľom džungalo viďeňje:","poem":1},{"text":"O zradcas zradzinel, o ňičiťeľis ňičinel.","poem":2},{"text":"Armado le Elamoskri, ušťi upre! Armado le Medengri, rozthov tut pašal o foros!","poem":1},{"text":"Bo kerava o koňec savore rovibnaske.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Vašoda pre ma avel o dukha andro klubi,","poem":1},{"text":"chuden man o kurči sar la džuvľa, so ločhol.","poem":2},{"text":"Thovel man oda tele, sar pal oda šunav,","poem":1},{"text":"darav man, sar oda dikhav.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O jilo andre ma previsaľol,","poem":1},{"text":"izdrav daratar,","poem":2},{"text":"kamavas, hoj te zaračol,","poem":1},{"text":"ale akana man olestar igen darav.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"On pripravinen o skamind,","poem":1},{"text":"čhiven o kobercos pre phuv,","poem":2},{"lineBreak":true},{"text":"chan a pijen.","poem":2},{"text":"Ušťen, vodcale,","poem":1},{"text":"pripravinen tumenge o šťiti!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bo o Raj mange phenďa:","poem":1},{"text":"„Dža, ačhav le stražňikos","poem":2},{"lineBreak":true},{"text":"a mi avel te phenel, so dikhel!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sar dikhela le slugaďen pro verdana, saven cirden duj graja,","poem":1},{"text":"le jazdcen pro osli the le jazdcen pro ťavi,","poem":2},{"lineBreak":true},{"text":"mi del pozoris, mi dikhel mištes.“","poem":2}]},{"type":"verse","number":8,"content":["Akor oda stražňikos vičinelas:",{"text":"„Raja, sako džives stražinav","poem":1},{"text":"a sako rat som pre miro than.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dikh, avel o jazdcos pro verdan le duje grajenca","poem":1},{"text":"a phenel: ‚Peľa, peľa tele o Babilon","poem":2},{"text":"a savore sochi leskre devlengre","poem":1},{"text":"hine rozphagerde pre phuv.‘ “","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mire manušale, so san marde a rozčhide sar o zrnos,","poem":1},{"text":"dav tumenge te džanel oda,","poem":2},{"text":"so šunďom le Nekzoraleder RAJESTAR,","poem":1},{"text":"le Izraeloskre Devlestar.","poem":2}]},{"type":"heading","content":["O lav pro Edom"]},{"type":"verse","number":11,"content":["O proroctvos pro Edom:",{"text":"Vareko pre ma vičinel andral o Seir:","poem":1},{"text":"„Stražňikona, keci mek ľikerela e rat?","poem":2},{"lineBreak":true},{"text":"Stražňikona, keci mek ľikerela e rat?“","poem":2}]},{"type":"verse","number":12,"content":["O stražňikos phenel:",{"text":"„Imar avel o tosara,","poem":1},{"text":"ale mek hin rat.","poem":2},{"text":"Te kamen te phučel,","poem":1},{"text":"ta aven pale a phučen.“","poem":2}]},{"type":"heading","content":["O lav pre Arabija"]},{"type":"verse","number":13,"content":["O proroctvos pre Arabija:",{"text":"Manušale andral o Dedan, so phiren le karavanenca","poem":1},{"text":"a presoven paš o kraki andre Arabija,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ľidžan o paňi le smedne manušenge,","poem":1},{"text":"so ke tumende aven.","poem":2},{"text":"Manušale andral e phuv Tema,","poem":1},{"text":"anen o maro olenge, ko denašen peskre ňeprijaťeľendar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Se denašle la šabľatar,","poem":1},{"text":"so len kamelas te murdarel,","poem":2},{"text":"le šipendar, so sas pripravimen te ľivinel,","poem":1},{"text":"the le maribnaskra daratar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":["Bo kada mange phenďa o Raj: „Tel jekh berš, avke sar pes rachinel o dživesa andre le robotňikoskri zmluva, avke skončinela savori slava le manušengri andral o Kedar."]},{"type":"verse","number":17,"content":["O lukostrelci hine o nekzoraleder murša andral o Kedar, ale ča frima lendar ačhena te dživel, bo me, o RAJ, o Del le Izraeloskro, oda phenďom.“"]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}