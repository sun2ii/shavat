{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"JER","translationId":"rmc_the","name":"Jeremijaš","commonName":"Jeremijaš","title":"O Jeremijaš","order":24,"numberOfChapters":52,"sha256":"84aa8d02177332c225644bc29faa9550858d768667cde9f11abcf67e4c728b1c","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/rmc_the/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["O Jeremijaš phučel le RAJESTAR"]},{"type":"verse","number":1,"content":[{"text":"„RAJEJA, tu sal furt spravodľivo,","poem":1},{"text":"sar man tuha kerav.","poem":2},{"text":"No the avke tuha kamav te vakerel pal o čačipen.","poem":1},{"text":"Soske le nalačhenge avel avri lengro drom?","poem":2},{"lineBreak":true},{"text":"Soske peske savore ňeverna dživen andro smirom?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tu len sadzinďal a on mukle o koreňa;","poem":1},{"text":"baron peske a anen ovocje.","poem":2},{"text":"Tu sal furt pre lengre vušta,","poem":1},{"text":"ale dur lengre jilendar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"No tu man prindžares, RAJEJA,","poem":1},{"text":"dikhes man a skumines, savo man hin jilo ke tute.","poem":2},{"text":"Ľidža len sar bakroren te murdarel","poem":1},{"text":"a odďelin len pro murdaripen.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mek dži kana ela e phuv šuki","poem":1},{"text":"a e čar pre dojekh maľa šučola avri?","poem":2},{"text":"Bo o manuša, so dživen pre phuv, hine nalačhe,","poem":1},{"text":"o džviri the o čirikle murdaľon,","poem":2},{"text":"bo o manuša phenen:","poem":1},{"text":"‚O RAJ na dikhel, so keras.‘ “","poem":2}]},{"type":"heading","content":["O RAJ odphenel"]},{"type":"verse","number":5,"content":[{"text":"„Te na birines te denašel le manušenca","poem":1},{"text":"a imar sal strapimen,","poem":2},{"lineBreak":true},{"text":"sar mek birineha te denašel le grajenca?","poem":2},{"text":"Te slabisaľos pre rovno phuv,","poem":1},{"text":"ta akor so kereha,","poem":2},{"lineBreak":true},{"text":"sar denašeha prekal o bare kraki le Jordanoskre?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Se mek the tire phrala,","poem":1},{"text":"e famelija andral tiro kher,","poem":2},{"text":"pes tutar visarde","poem":1},{"text":"a namištes pre tu vakeren.","poem":2},{"text":"Ma pača lenge,","poem":1},{"text":"kajte tuha vakerena gulones.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"„Omukľom miro kher,","poem":1},{"text":"odčhiďom mire manušen.","poem":2},{"text":"Le manušen, saven kamav, diňom","poem":1},{"text":"andro vasta le ňeprijaťeľenge.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mire manuša chudle pre ma te džal","poem":1},{"text":"sar o ľevos andro veš;","poem":2},{"text":"hazdle pre mande peskro hangos,","poem":1},{"text":"vašoda len našťi avri ačhav.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mire manuša hine sar o flekato čiriklo,","poem":1},{"text":"obkľučimen le drave čiriklenca.","poem":2},{"text":"Noča džan a skiden savore dzive džviren","poem":1},{"text":"a anen len te chal.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"But cudza pasťjera mange zňičinde e viňica;","poem":1},{"text":"phirde mange pal miri phuv.","poem":2},{"text":"Miri šukar maľa zňičinde","poem":1},{"text":"a kerde latar zamukľi pušťa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Visarde la pre pušťa,","poem":1},{"text":"hiňi zamukľi a rovel ke ma;","poem":2},{"text":"caľi phuv hiňi zňičimen,","poem":1},{"text":"ale ňiko peske oda na lel andro jilo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pre savore uče brehi pre pušťa","poem":1},{"text":"aven o ňičiťeľa,","poem":2},{"text":"bo le RAJESKRI šabľa chal savoren","poem":1},{"text":"pal jekh agor la phuvakro dži pre aver.","poem":2},{"lineBreak":true},{"text":"Ňiko na denašela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mire manuša sadzinenas e pšeňica, ale skidenas o trňi;","poem":1},{"text":"trapinenas pes, ale ňič lenge na bariľa.","poem":2},{"text":"Ladžana pes vaš peskri žatva,","poem":1},{"text":"bo o RAJ peskra bara choľaha savoro zňičinďa.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":["Kada phenel o RAJ pre savore nalačhe susedi, so pes chudle mira phuvatar, savi diňom mire manušenge, le Izraelitenge: „Cirdava ole nalačhe manušen avri andral lengre phuva a le judske manušen lendar zachraňinava."]},{"type":"verse","number":15,"content":["Ale paľis sar len cirdava avri, pale mange ela vaš lenge pharo a dojekh narodos thovava pale andre peskri phuv."]},{"type":"verse","number":16,"content":["A te sikľona mištes o droma mire manušengre a sikľona te lel vera pre miro nav: ‚Sar dživel o RAJ!‘ avke sar on varekana sikade mire manušen te lel vera pro Baal, akor ena bararde avri maškar mire manuša a dživena peske mištes."]},{"type":"verse","number":17,"content":["Ale te na šunena, cirdava avri ole manušen le koreňenca a zňičinava,“ phenel o RAJ."]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}