{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"JER","translationId":"rmc_the","name":"Jeremijaš","commonName":"Jeremijaš","title":"O Jeremijaš","order":24,"numberOfChapters":52,"sha256":"84aa8d02177332c225644bc29faa9550858d768667cde9f11abcf67e4c728b1c","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/rmc_the/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["O Izrael avela pale andre peskri phuv"]},{"type":"verse","number":1,"content":["Kada lav phenďa o RAJ le Jeremijašiske:"]},{"type":"verse","number":2,"content":["„Kada phenel o RAJ, o Del le Izraeloskro: ‚Pisin tuke andro zvitkos savore lava, so tuke phenďom."]},{"type":"verse","number":3,"content":["Dikh, avel o časos,‘ phenel o RAJ, ‚sar anava pale mire manušen le Izrael the le Juda andral o zajaťje a dava lenge pale e phuv, so diňom lengre dadenge, a bešena andre,‘ phenel o RAJ.“"]},{"type":"verse","number":4,"content":["Kada hin o lava, save vakerelas o RAJ pal o Izrael the pal e Judsko:"]},{"type":"verse","number":5,"content":["„Kada phenel o RAJ:",{"text":"‚Šunďol te viskinel le manušen daratar;","poem":1},{"text":"hin bari dar, nane smirom.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akana zaačhen a gondoľinen:","poem":1},{"text":"Šaj uľol le muršestar čhavoro?","poem":2},{"text":"Akor soske dikhav, hoj dojekhe zorale muršeste","poem":1},{"text":"hin o vasta pro per sar la džuvľate andro dukha?","poem":2},{"lineBreak":true},{"text":"Soske lenge o muja parňile avri?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vigos, bo oda džives ela igen strašno!","poem":1},{"text":"Ajso džives, savo mek šoha na sas.","poem":2},{"text":"Andre oda časos predžala o Jakob bare pharipnaha,","poem":1},{"text":"ale ela olestar zachraňimen.‘ “","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":["„Andre oda džives,“ phenel o Nekzoraleder RAJ, „phagerava o jarmos pal lengri meň a čhingerava lengre lanci. Imar na ena otroka le cudzincenge,"]},{"type":"verse","number":9,"content":["ale služinena le RAJESKE, peskre Devleske, the peskre kraľiske le Davidoske, saves lenge ačhavava.“"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"„No tu ma dara, miro služobňikona Jakobona,“ phenel o RAJ,","poem":1},{"text":"„ma predara, Izraelona,","poem":2},{"text":"bo dikh, zachraňinava tut the tiro potomstvos","poem":1},{"text":"andral odi phuv, so hiňi dur, andre save san zaile.","poem":2},{"text":"O Jakob avela pale a dživela andro smirom,","poem":1},{"text":"bi o starišagos a ňiko les na daravela avri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Me som tuha, phenel o RAJ,","poem":1},{"text":"hoj tut te zachraňinav.","poem":2},{"text":"Zňičinava savore naroden,","poem":1},{"text":"maškar save tut roztradňom,","poem":2},{"lineBreak":true},{"text":"ale tut na zňičinava.","poem":2},{"text":"Marava tut, ča ajci keci tuke zaslužines,","poem":1},{"text":"ale na mukava tut te džal calkom bi o trestos.“","poem":2}]},{"type":"verse","number":12,"content":["Kada phenel o RAJ:",{"text":"„Tiri rana našťi sasťol avri","poem":1},{"text":"a hiňi igen dukhaďi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nane vaš tu ko te zaačhel;","poem":1},{"text":"nane ľikos pre tiro vredos,","poem":2},{"lineBreak":true},{"text":"ňiko tut našťi sasťarel avri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Savore, so tut kamenas, pre tu bisterde;","poem":1},{"text":"na džal lenge pal tu.","poem":2},{"text":"Bo demaďom tut avke sar ňeprijaťeľis;","poem":1},{"text":"marďom tut igen zorales","poem":2},{"lineBreak":true},{"text":"angle tiri bari vina the angle tire but bini.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Soske roves vaš tiri rana?","poem":1},{"text":"Tiri dukh našťi sasťol avri.","poem":2},{"text":"Vaš tiri bari vina the vaš tire but bini","poem":1},{"text":"tuke oda kerďom.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ale savore, so tut chan tele,","poem":1},{"text":"ena zachale,","poem":2},{"text":"savore, tire ňeprijaťeľa,","poem":1},{"text":"ena zaile sar bertenoša.","poem":2},{"text":"Ola, ko tut trapinen,","poem":1},{"text":"ena trapimen avrendar.","poem":2},{"text":"Ola, ko tut občoraren,","poem":1},{"text":"ena občorarde avrendar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ale me tut sasťarava avri,","poem":1},{"text":"sasťarava tuke tire rani,","poem":2},{"lineBreak":true},{"text":"phenel o RAJ,","poem":2},{"text":"bo vičinen tut avritradľi,","poem":1},{"text":"e čhaj le Sionoskri, sava ňiko na rodel.“","poem":2}]},{"type":"heading","content":["O RAJ anela pale le Izrael"]},{"type":"verse","number":18,"content":["Kada phenel o RAJ:",{"text":"„Anava pale le Jakoboskre stani andral e phuv, kaj sas zaile,","poem":1},{"text":"a ela mange pharo vaš leskre khera.","poem":2},{"text":"O foros ela pale upreačhado pre oda than, khatar sas čhido tele,","poem":1},{"text":"a o palacis ačhela pale pre oda than, kaj sas.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Avena lendar o paľikeribnaskre giľa","poem":1},{"text":"a šunďola o radišagos.","poem":2},{"text":"Kerava lendar but","poem":1},{"text":"a na ena frimeder;","poem":2},{"text":"dava len ajsi pačiv,","poem":1},{"text":"hoj imar na ena teledikhle.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Leskre čhave ena ajse sar varekana,","poem":1},{"text":"lengro zhromažďeňje ela zorales zathodo angle mande","poem":2},{"lineBreak":true},{"text":"a marava savoren, ko len trapinen.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Lengro vodcas ela lendar;","poem":1},{"text":"lengro vladcas avela lendar.","poem":2},{"text":"Domukava les paš ma","poem":1},{"text":"a ov avela dži ke ma.","poem":2},{"text":"Se ko šaj avel korkoro pestar paš mande?","poem":1},{"text":"phenel o RAJ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tumen avena mire manuša","poem":1},{"text":"a me avava tumaro Del.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dikh, e choľi le RAJESKRI","poem":1},{"text":"avel sar e zoraľi balvaj;","poem":2},{"text":"sar e bari burka,","poem":1},{"text":"so avel tele pro šero le nalačhe manušenge.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Na preačhela leskri bari choľi,","poem":1},{"text":"medik na dokerela savoro, so peske zaiľa andro jilo.","poem":2},{"lineBreak":true},{"text":"Andro posledna dživesa oleske achaľona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}