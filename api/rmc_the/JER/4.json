{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"JER","translationId":"rmc_the","name":"Jeremijaš","commonName":"Jeremijaš","title":"O Jeremijaš","order":24,"numberOfChapters":52,"sha256":"84aa8d02177332c225644bc29faa9550858d768667cde9f11abcf67e4c728b1c","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/rmc_the/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["O RAJ phenel:",{"text":"„Te kames, Izraelona, te avel pale,","poem":1},{"text":"akor av pale ke ma.","poem":2},{"text":"Te čhiveha tutar het kola džungipena anglal mire jakha","poem":1},{"text":"a imar na oddžaha avrether,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ale te pačivales, čačes a spravodľivones leha vera:","poem":1},{"text":"‚Avke sar dživel o RAJ,‘","poem":2},{"text":"akor peske leha žehňinena o narodi","poem":1},{"text":"a lašarena pes leha.“","poem":2}]},{"type":"verse","number":3,"content":["Kada phenel o RAJ le manušenge andre Judsko the andro Jeruzalem:",{"text":"„Preorinen tumenge e zoraľi phuv","poem":1},{"text":"a ma sadzinen andro trňi!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Obrezinen tumen pre služba le RAJESKE,","poem":1},{"text":"obrezinen tumare jile,","poem":2},{"lineBreak":true},{"text":"muršale andral e Judsko the manušale andral o Jeruzalem,","poem":2},{"text":"hoj te na chučel avri miri choľi sar jag","poem":1},{"text":"vaš o nalačhipen, so kerďan,","poem":2},{"lineBreak":true},{"text":"a te na labol avke, hoj la ňiko našťi murdarela andre.“","poem":2}]},{"type":"heading","content":["E skaza pal o severos"]},{"type":"verse","number":5,"content":[{"text":"„Den te džanel andre Judsko","poem":1},{"text":"a vakeren andro Jeruzalem:","poem":2},{"lineBreak":true},{"text":"‚Roztrubinen e truba pal caľi phuv!‘","poem":2},{"text":"Vičinen andral caľi zor a phenen:","poem":1},{"text":"‚Skiden tumen upre!","poem":2},{"lineBreak":true},{"text":"Aven džas andro ohradzimen fori!‘","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hazden upre e zastava pro Sion!","poem":1},{"text":"Denašen, hoj tumen te zachraňinen! Ma zaačhen!","poem":2},{"lineBreak":true},{"text":"Bo anava e skaza the e bari zahuba pal o severos.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"„O ľevos avľa avri andral peskre kraki,","poem":1},{"text":"o ňičiťeľis le narodengro avel.","poem":2},{"text":"Avľa avri andral peskro than,","poem":1},{"text":"hoj te kerel tira phuvatar e pušťa.","poem":2},{"text":"Tire fori ena zňičimen,","poem":1},{"text":"ačhena bi o manuša.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vašoda uren tumen andro gada le gonestar,","poem":1},{"text":"roven a hikinen,","poem":2},{"text":"bo e bari choľi le RAJESKRI","poem":1},{"text":"pes amendar na visarďa.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"„Andre oda džives,“ phenel o RAJ,","poem":1},{"text":"„o kraľis the o raja predarana,","poem":2},{"text":"o rašaja cerpisaľona","poem":1},{"text":"a o proroka ačhena sar kašta.“","poem":2}]},{"type":"verse","number":10,"content":["Paľis me, o Jeremijaš, phenďom: „Jaj, Raja Devla, dičhol pes mange, hoj calkom klaminďal le manušen andre Judsko the andro Jeruzalem, sar phenďal: ‚Ela tumen smirom,‘ akor sar amenge sas e šabľa thoďi tel e meň!“"]},{"type":"verse","number":11,"content":["Andre oda časos pes phenela kale manušenge the le Jeruzalemoske: „E tači balvaj pal o brehi pre pušťa avel pre mire manuša, ale na pre oda, hoj len te precidzinel a te prežužarel,"]},{"type":"verse","number":12,"content":["bo kadi balvaj, so avel mandar, ela pre oda igen zoraľi. Akana anav avri upral lende miro rozsudkos.“"]},{"type":"verse","number":13,"content":[{"text":"Dikh, o ňeprijaťeľis avel sar o chmari.","poem":1},{"text":"Leskre maribnaskre verdana hine sar e vichrica,","poem":2},{"text":"leskre graja hine richleder sar o orli.","poem":1},{"text":"Vigos amenge, sam našade!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jeruzalemona, obžužar tuke o jilo le nalačhipnastar,","poem":1},{"text":"hoj te aves zachraňimen.","poem":2},{"text":"Dži kana andre tu ľikereha","poem":1},{"text":"o nalačho gondoľišagos?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Se andral o Dan avel o hiros","poem":1},{"text":"a e nalačhi sprava andral o Efrajimoskre brehi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"„Priphenen le narodenge,","poem":1},{"text":"den te džanel le Jeruzalemoske:","poem":2},{"text":"‚O ňeprijaťeľa aven andral e phuv dural","poem":1},{"text":"a keren e maribnaskri vika pro fori andre Judsko.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Obkľučinen o Jeruzalem sar ola, ko stražinen e maľa,","poem":1},{"text":"bo pre mande džalas,‘ “","poem":2},{"lineBreak":true},{"text":"phenel o RAJ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"„Tiro dživipen the tire skutki pre tute kada ande.","poem":1},{"text":"Kada hin tiro trestos!","poem":2},{"text":"Hino igen kirko!","poem":1},{"text":"Predemel tuke o jilo.“","poem":2}]},{"type":"heading","content":["O roviben le prorokoskro"]},{"type":"verse","number":19,"content":[{"text":"Dukhal man, dukhal man!","poem":1},{"text":"Dukhatar man banďarel!","poem":2},{"text":"O Jilo! O jilo mange igen marel!","poem":1},{"text":"Našťi ačhav čhit!","poem":2},{"text":"Se me šunav o hangos la trubakro,","poem":1},{"text":"sar bašaven pro mariben.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"E skaza anel e skaza,","poem":1},{"text":"caľi phuv hiňi čhiďi tele.","poem":2},{"text":"Jekhvareste hine mire stani zňičimen,","poem":1},{"text":"lengre zavesi hine čhingerde pro kotora.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mek dži kana mušinav te dikhel pre le ňeprijaťeľiskri zastava","poem":1},{"text":"a te šunel o hangos la trubakro?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"O RAJ phenel: „Mire manuša hine diline,","poem":1},{"text":"na prindžaren man.","poem":2},{"text":"Hine sar o čhave,","poem":1},{"text":"so nane goďaver, so na achaľon.","poem":2},{"text":"Akor hine goďaver, sar kamen te kerel o nalačho,","poem":1},{"text":"ale o lačho te kerel na džanen.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dikhavas pre phuv","poem":1},{"text":"a sas zamukľi a omukľi,","poem":2},{"text":"pro ňebos,","poem":1},{"text":"a leskro švetlos našľiľa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dikhavas pro verchi,","poem":1},{"text":"a dikhľom, hoj izdranas.","poem":2},{"lineBreak":true},{"text":"Savore brehi pes čhalavenas upre tele.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Dikhavas, ale ňisave manušes na dikhľom,","poem":1},{"text":"a the savore čirikle pal o ňebos našľile.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Dikhavas pro ovocno sados,","poem":1},{"text":"ačhiľa lestar pušťa;","poem":2},{"text":"a rozpele savore leskre fori","poem":1},{"text":"le RAJESKRA bara choľatar.","poem":2}]},{"type":"verse","number":27,"content":["Kada phenel o RAJ:",{"text":"„Caľi phuv ačhela zamukľi,","poem":1},{"text":"ale calkom la na zňičinava.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Vašoda ela e phuv andre žaľa","poem":1},{"text":"a o ňebos kaľola,","poem":2},{"text":"bo phenďom, so kamav te kerel,","poem":1},{"text":"a na lava oda pale aňi man olestar na visarava.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Sar šunďol te avel le jazdcen the le lukostrelcen,","poem":1},{"text":"dojekh foros denašel.","poem":2},{"text":"Varesave pes garuven andro kraki","poem":1},{"text":"a varesave džan upre pro skali.","poem":2},{"text":"Savore fori hine omukle","poem":1},{"text":"a ňiko andre na bešel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"So kames te kerel, tu zňičimen?","poem":1},{"text":"Soske tut ures andro purpur","poem":2},{"lineBreak":true},{"text":"a thoves pre tu o somnakune šperki?","poem":2},{"text":"Soske tuke keres o jakha?","poem":1},{"text":"Zbitočňe tut richtines!","poem":2},{"text":"Tire pirane tut odčhide","poem":1},{"text":"a kamen tut te murdarel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Bo šunav, sar te viskinďahas e džuvľi, so hiňi andro dukha,","poem":1},{"text":"sar te viskinďahas e džuvľi, so ločhol peskre ešebne čhavoreha;","poem":2},{"text":"šunav o hangos le Sionoskra čhakro,","poem":1},{"text":"so phurdel pharipnastar a nacirdel o vasta pre pomoca a phenel:","poem":2},{"text":"„Jaj, vigos mange,","poem":1},{"text":"diňi som andro vasta le vrahenge!“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}