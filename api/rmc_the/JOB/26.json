{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"JOB","translationId":"rmc_the","name":"Job","commonName":"Job","title":"O Job","order":18,"numberOfChapters":42,"sha256":"db6524dcd2197012ae23d9ff59da1de3d15a303a1342d2a6212ebd9020def4d2","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/rmc_the/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":26,"content":[{"type":"heading","content":["Eňato vakeriben le Joboskro"]},{"type":"verse","number":1,"content":["Akor o Job odphenďa kada:"]},{"type":"verse","number":2,"content":[{"text":"„Joj, sar pomožinďal oleske, kas nane zor!","poem":1},{"text":"Sar zachraňinďal oles, ko na birinel!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Joj, savi lačhi rada diňal le nagoďaveres!","poem":1},{"text":"Savi bari goďi sikaďal!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Khatar iľal kala goďaver lava?","poem":1},{"text":"Savo duchos prekal tute vakerel?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O duchi le mulengre izdran telal tel o paňi","poem":1},{"text":"a the savore, so ode bešen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O Del džanel savoro pal ola, ko hine andro than le mulengro","poem":1},{"noteId":22},{"text":",","poem":1},{"text":"a o than le meribnaskro","poem":2},{"noteId":23},{"text":"nane ňisoha zaučhardo le Devleske.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ov nacirdel o severno ňebos ode, kaj nane ňič,","poem":1},{"text":"e phuv figinďa upral ňisoste.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ov phandel o paňi andre peskre chmari","poem":1},{"text":"a o chmari na prečhinďon.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Garuvel peskro tronos","poem":1},{"noteId":24},{"text":"avke, hoj les te na dičhol,","poem":1},{"text":"a nacirdel upral leste peskri chmara.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Odďelinďa o švetlos le kaľipnastar avke,","poem":1},{"text":"hoj merinďa avri e hraňica maškar o moros the ňebos.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"O slupi le ňeboskre izdran","poem":1},{"text":"a predaran, sar len karhinel.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Peskra zoraha kerďa, hoj o moros te čhitel,","poem":1},{"text":"a peskra goďaha zňičinďa la obluda Rahab.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Leskro dichos žužarďa o ňebos,","poem":1},{"text":"leskro vast predemaďa le bare sapes, so denašelas.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dikh, kada hin ča sikrica olestar, so ov kerel,","poem":1},{"text":"ča kajci frima pes amenge dochudňa andro kana.","poem":2},{"lineBreak":true},{"text":"Akor ko šaj achaľol, savi bari zor hin le Devles?“","poem":2}]}],"footnotes":[{"noteId":22,"caller":"+","text":"26,6 E hebrejiko čhib: Šeol","reference":{"chapter":26,"verse":6}},{"noteId":23,"caller":"+","text":"26,6 E hebrejiko čhib: Abaddon","reference":{"chapter":26,"verse":6}},{"noteId":24,"caller":"+","text":"26,9 Abo: calo čhonoro","reference":{"chapter":26,"verse":9}}]},"thisChapterLink":"/api/rmc_the/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}