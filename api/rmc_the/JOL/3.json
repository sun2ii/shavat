{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"JOL","translationId":"rmc_the","name":"Joel","commonName":"Joel","title":"O Joel","order":29,"numberOfChapters":4,"sha256":"ea6176200437615804dda743745aa83dc56b38b9f4c155ff206b862b0490e77d","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/rmc_the/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["O Del čhivela avri le Svete Duchos pro manuša"]},{"type":"verse","number":1,"content":[{"text":"„Ale paloda čhivava avri mire Duchos pre dojekh manuš","poem":1},{"text":"a tumare čhave the tumare čhaja prorokinena,","poem":2},{"text":"tumare phure manušen ela sune","poem":1},{"text":"a tumare terne dikhena viďeňja.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"He, mek the pre mire služobňika the pro služobňički","poem":1},{"text":"čhivava avri mire Duchos.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sikavava o znameňja pro ňebos the pre phuv:","poem":1},{"text":"o rat, e jag the o baro thuv.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O kham pes čerinela pro kaľipen a o čhonoro pro rat","poem":1},{"text":"angloda, sar avela oda baro the strašno Džives le RAJESKRO.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A ela avke, hoj sako,","poem":1},{"text":"ko lašarela le RAJESKRO nav, ela zachraňimen,","poem":2},{"text":"bo pro verchos Sion","poem":1},{"text":"the andro Jeruzalem ela e zachrana,","poem":2},{"lineBreak":true},{"text":"avke sar o RAJ diňa lav.","poem":2},{"text":"Ola, ko predživena, ena ola,","poem":1},{"text":"kas peske vičinela o RAJ.“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/JOL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}