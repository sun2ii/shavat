{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"LAM","translationId":"rmc_the","name":"Roviben le Jeremijašiskro","commonName":"Roviben le Jeremijašiskro","title":"O Roviben le Jeremijašiskro","order":25,"numberOfChapters":5,"sha256":"b4fa6da5583e176920ce896425e1a26faf5a23b0b2db39bad19da80196618e41","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/rmc_the/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["O roviben le Jeruzalemoskro"]},{"type":"verse","number":1,"content":[{"text":"Jaj, savo omuklo hino o foros,","poem":1},{"text":"kaj varekana dživenas pherdo manuša!","poem":2},{"text":"Ačhiľa sar e vdova,","poem":1},{"text":"kajte sas baro maškar o narodi.","poem":2},{"text":"E raňi maškar o phuva","poem":1},{"text":"ačhiľa otrokiňa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Račaha furt rovel,","poem":1},{"text":"o apsa lake čuľan pal o čhama.","poem":2},{"text":"Ňiko lakre piranendar","poem":1},{"text":"la na poťešinel.","poem":2},{"text":"Savore lakre prijaťeľa laha thode avri","poem":1},{"text":"a ačhile lakre ňeprijaťeľa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Geľa o Juda andro zajaťje,","poem":1},{"text":"igen trapimen andro otroctvos.","poem":2},{"text":"Bešel maškar o narodi","poem":1},{"text":"a nane les than kaj te odpočovinel.","poem":2},{"text":"Savore, so pre leste džan,","poem":1},{"text":"les zachudle, sar sas andro pharipen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O droma le Sionoskre hine andre žaľa,","poem":1},{"text":"bo ňiko na avel pro inepi.","poem":2},{"text":"Savore leskre brani hine zňičimen;","poem":1},{"text":"o rašaja roven,","poem":2},{"text":"leskre pačivale čhaja hine smutna,","poem":1},{"text":"ačhiľa leske ča kirko dukh.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ola, ko les trapinen, ačhile leskre raja;","poem":1},{"text":"leskre ňeprijaťeľenge džal mištes,","poem":2},{"text":"bo o RAJ les dukhaďa","poem":1},{"text":"vaš leskre but bini.","poem":2},{"text":"Leskre čhave džanas zaile","poem":1},{"text":"anglal o ňeprijaťeľa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"E čhaj le Sionoskri našaďa","poem":1},{"text":"savoro peskro šukariben.","poem":2},{"text":"Lakre vodci hine sar o jeleňa,","poem":1},{"text":"so na arakhen ňisavo chaben,","poem":2},{"text":"a denašen bi e zor","poem":1},{"text":"anglal ola, ko pal lende prastan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Andre ola dživesa, sar la ela o pharipen a phirela upre tele,","poem":1},{"text":"peske e čhaj le Jeruzalemoskri leperela","poem":2},{"text":"pre savore peskre vzacna veci,","poem":1},{"text":"so la sas varekana.","poem":2},{"text":"Sar lakre nipi pele andro vasta le ňeprijaťeľiskre,","poem":1},{"text":"ňiko lake na pomožinďa.","poem":2},{"text":"Lakre ňeprijaťeľa oda dikhle","poem":1},{"text":"a asanas olestar, sar hiňi zňičimen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"E čhaj le Jeruzalemoskri kerelas igen but bini,","poem":1},{"text":"vašoda ačhiľa melaľi.","poem":2},{"text":"Savore, so la denas pačiv, la poceňinen,","poem":1},{"text":"bo dikhle lakro langipen.","poem":2},{"text":"Oj korkori rovel","poem":1},{"text":"a visarel o muj ladžatar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"E mel hiňi pre lakri rokľa,","poem":1},{"text":"na gondoľinelas pre peskri buducnosť.","poem":2},{"text":"Strašňe peľa tele","poem":1},{"text":"a nane ko la te poťešinel.","poem":2},{"text":"„Dikh, RAJEJA, pre miro pharipen,","poem":1},{"text":"bo o ňeprijaťeľis pes ľidžal upre.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"O ňeprijaťeľis nacirdňa peskro vast","poem":1},{"text":"pre savoreste, so lake sas vzacno.","poem":2},{"text":"Se oj dikhľa le naroden","poem":1},{"text":"te džal andro Chramos,","poem":2},{"text":"kajte tu prikazinďal,","poem":1},{"text":"hoj našťi džan andre tiro zhromažďeňje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Savore lakre manuša roven,","poem":1},{"text":"roden o maro,","poem":2},{"text":"savore vzacna veci den vaš o chaben,","poem":1},{"text":"hoj peske te zachraňinen o dživipen.","poem":2},{"text":"„Dikh, RAJEJA, všimňin tuke,","poem":1},{"text":"hoj som teledikhľi.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tumen savore, so predžan pašal ma,","poem":1},{"text":"na keren tumenge olestar ňič?","poem":2},{"lineBreak":true},{"text":"Phundraven o jakha a dikhen!","poem":2},{"text":"Či hin varekas ajso pharipen sar man,","poem":1},{"text":"savo pre mande avľa,","poem":2},{"text":"saveha man o RAJ dukhaďa","poem":1},{"text":"andro džives peskra bara choľakro?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Andral o ňebos bičhaďa e jag,","poem":1},{"text":"hoj te džal dži andre mire kokala.","poem":2},{"text":"Mire pindrenge nacirdňa e sita","poem":1},{"text":"a visarďa man pale.","poem":2},{"text":"Kerďa mandar pušťa","poem":1},{"text":"a mukľa man te šučol avri calo džives.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mire bini hine pašal miri meň sar o jarmos,","poem":1},{"text":"savo ov zaphandľa peskre vasteha.","poem":2},{"text":"Thoďa peskro jarmos pre miri meň","poem":1},{"text":"a slabisarďa miri zor.","poem":2},{"text":"O Raj man diňa andro vasta olenge,","poem":1},{"text":"savenca man na birinav te marel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"O Raj odčhiďa savore mire zorale muršen","poem":1},{"text":"pašal mande.","poem":2},{"text":"Skidňa upre e armada pre mande,","poem":1},{"text":"hoj te rozpučinel mire terne muršen.","poem":2},{"text":"Pal e pačivaľi judsko čhaj uštarelas o Raj","poem":1},{"text":"sar pal o hroznos andro lisos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"„Vaš oda rovav","poem":1},{"text":"a mire jakhendar čuľan o apsa,","poem":2},{"text":"bo nane paš ma ňiko,","poem":1},{"text":"hoj man te poťešinel,","poem":2},{"lineBreak":true},{"text":"ko man hazdňahas pro duchos.","poem":2},{"text":"Mire čhave hine omukle,","poem":1},{"text":"bo o ňeprijaťeľis amen domarďa.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nacirdel o Sion peskre vasta,","poem":1},{"text":"ale ňiko les na poťešinel.","poem":2},{"text":"O RAJ diňa avri o prikazis pro Jakob,","poem":1},{"text":"hoj savore leskre susedi te ačhen leskre ňeprijaťeľa.","poem":2},{"text":"O Jeruzalem ačhiľa maškar lende","poem":1},{"text":"sar vareso nažužo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"O RAJ hino spravodľivo,","poem":1},{"text":"bo me man ačhaďom leskre laveske.","poem":2},{"text":"Šunen, savore narodale,","poem":1},{"text":"a dikhen pre miri dukh.","poem":2},{"text":"Mire terne čhaja the mire terne čhave","poem":1},{"text":"gele andro zajaťje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Vičinavas pre mire pirane,","poem":1},{"text":"ale on manca thode avri.","poem":2},{"text":"Mire rašaja the o vodci","poem":1},{"text":"mule andro foros,","poem":2},{"text":"sar rodenas o chaben,","poem":1},{"text":"hoj peske te zachraňinen o dživipen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dikh, RAJEJA, hoj som andro pharipen,","poem":1},{"text":"nane andre ma o smirom,","poem":2},{"text":"o jilo andre ma previsaľol,","poem":1},{"text":"bo igen man tuke ačhavavas.","poem":2},{"text":"E šabľa mange murdarďa le čhaven avri","poem":1},{"text":"a andro kher o meriben.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"O manuša man šunde te stukinel,","poem":1},{"text":"ale ňiko man na poťešinďa.","poem":2},{"text":"Savore mire ňeprijaťeľa šunde pal miro pharipen","poem":1},{"text":"a radisaľon, hoj oda kerďal.","poem":2},{"text":"Mi avel oda džives, pal savo phenďal,","poem":1},{"text":"hoj te cerpinen avke sar me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"„Mi avel avri angle tu","poem":1},{"text":"savoro lengro nalačhipen.","poem":2},{"text":"Ker lenca avke, sar kerďal manca","poem":1},{"text":"angle savore mire bini,","poem":2},{"text":"bo but stukinav le pharipnastar","poem":1},{"text":"a miro jilo hino slabo.“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}