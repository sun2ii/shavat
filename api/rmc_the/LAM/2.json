{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"LAM","translationId":"rmc_the","name":"Roviben le Jeremijašiskro","commonName":"Roviben le Jeremijašiskro","title":"O Roviben le Jeremijašiskro","order":25,"numberOfChapters":5,"sha256":"b4fa6da5583e176920ce896425e1a26faf5a23b0b2db39bad19da80196618e41","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/rmc_the/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["Le Devleskri choľi pro Izrael"]},{"type":"verse","number":1,"content":[{"text":"Jaj, sar o RAJ zaučharďa le Sionoskra čha","poem":1},{"text":"peskra choľakra chmaraha.","poem":2},{"text":"O šukariben le Izraeloskro čhiďa tele","poem":1},{"text":"andral o ňebos pre phuv.","poem":2},{"text":"Bisterďa the pre peskro chramos","poem":1},{"text":"andro džives peskra choľakro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Le Rajeske na sas pharo te zňičinel","poem":1},{"text":"savore khera le Jakoboskre.","poem":2},{"text":"Andre peskri choľi čhiďa tele","poem":1},{"text":"o pevnosťi le Judaskre.","poem":2},{"text":"Čhiďa tele pre phuv leskro kraľišagos the leskre rajen","poem":1},{"text":"a dikhľa len tele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Andre peskri bari choľi","poem":1},{"text":"odčhinďa savori zor le Izraeloskri.","poem":2},{"text":"Scirdňa peskro čačo vast,","poem":1},{"text":"sar avľa o ňeprijaťeľis.","poem":2},{"text":"Rozlabiľa andre phuv le Jakoboskri","poem":1},{"text":"sar jag le plameňenca, so savoro chal.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nacirdňa o lukos sar ňeprijaťeľis;","poem":1},{"text":"leskro čačo vast sas pripravimen","poem":2},{"text":"a sar proťivňikos murdarelas savoren,","poem":1},{"text":"kas amen kamahas.","poem":2},{"text":"Peskri choľi čhiďa avri sar jag","poem":1},{"text":"andro stanos le Sionoskra čhakro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O Raj sas sar ňeprijaťeľis;","poem":1},{"text":"chaľa o Izrael;","poem":2},{"lineBreak":true},{"text":"chaľa savore leskre palaca.","poem":2},{"text":"Zňičinďa leskre pevnosťi","poem":1},{"text":"a kerďa la judska čhake pherdo pharipen the žaľa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Zňičinďa peskro chramos sar e zahrada;","poem":1},{"text":"oda than, kaj les lašarahas.","poem":2},{"text":"O RAJ diňa, hoj o Sion te bisterel","poem":1},{"text":"pro inepos the pro šabat,","poem":2},{"text":"a odčhiďa andre peskri bari choľi","poem":1},{"text":"le kraľis the le rašas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Odčhiďa o RAJ peskro oltaris","poem":1},{"text":"a omukľa peskro chramos.","poem":2},{"text":"O muri le palacengre diňa","poem":1},{"text":"andro vasta le ňeprijaťeľengre.","poem":2},{"text":"Lengri vika andro kher le RAJESKRO šunďolas","poem":1},{"text":"avke sar pro baro inepos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O RAJ peske zaiľa,","poem":1},{"text":"hoj čhivela tele o muri le Sionoskre.","poem":2},{"text":"Nacirdňa e šparga te merinel,","poem":1},{"text":"na odcirdňa peskro vast","poem":2},{"lineBreak":true},{"text":"a na preačhiľa te ňičinel.","poem":2},{"text":"Kerďa, hoj o veži the o muri te roven,","poem":1},{"text":"bo sas jekhetane čhide tele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Leskre brani zagele andre phuv.","poem":1},{"text":"Zňičinďa a phagerďa leskre zavori.","poem":2},{"text":"Leskro kraľis the o raja hine zaile maškar o narodi;","poem":1},{"text":"o rašaja imar na sikaven o zakonos","poem":2},{"text":"a o proroka imar na chuden","poem":1},{"text":"o viďeňje le RAJESTAR.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"O phureder murša le Sionoskre","poem":1},{"text":"bešen pre phuv a na vakeren ňič.","poem":2},{"text":"Čhivkeren peske o prachos pro šere","poem":1},{"text":"a hine urde andro gada le gonestar.","poem":2},{"text":"Le Jeruzalemoskre pačivale čhaja","poem":1},{"text":"zmukle o šere tele dži pre phuv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Le apsendar mange slabisaľon o jakha,","poem":1},{"text":"bari žaľa hin andre ma,","poem":2},{"text":"o jilo mange čuľal avri pre phuv,","poem":1},{"text":"bo mire manuša hine zňičimen,","poem":2},{"text":"bo o čhavore the o cikne čhavore","poem":1},{"text":"meren pro uľici andro foros.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"O čhavore phenen le dajenge:","poem":1},{"text":"„Kaj hin o chaben the o pijiben?“","poem":2},{"text":"akor sar peren tele pro uľici andro foros,","poem":1},{"text":"sar te ulehas zraňimen,","poem":2},{"text":"a sar polokes muken avri e duša","poem":1},{"text":"peskre dajenge pro vasta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"So tuke šaj phenav?","poem":1},{"text":"Ke soste tut šaj pripodobňinav,","poem":2},{"lineBreak":true},{"text":"čhaje le Jeruzalemoskri?","poem":2},{"text":"Soha tut šaj porovňinav, hoj tuke te kerav radišagos,","poem":1},{"text":"tu pačivaľi čhaje le Sionoskri?","poem":2},{"text":"Se tiri rana hiňi ajsi bari sar moros.","poem":1},{"text":"Ko tut šaj sasťarela?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tire proroka tuke andro viďeňja","poem":1},{"text":"vakerenas o klamišagi the o diliňipena;","poem":2},{"text":"na sikavenas pre tiro binos,","poem":1},{"text":"hoj tut te len avri andral o zajaťje.","poem":2},{"text":"O proroctva, so tuke phenenas,","poem":1},{"text":"sas falošna a klaminenas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sako, ko pašal tute predžal,","poem":1},{"text":"demel le vastenca,","poem":2},{"text":"asal tutar a kerel le šereha","poem":1},{"text":"upral e čhaj le Jeruzalemoskri:","poem":2},{"text":"„Kada hin oda foros, pal savo phenenas,","poem":1},{"text":"hoj ode hin o nekbareder šukariben","poem":2},{"lineBreak":true},{"text":"pro radišagos caľa phuvake?“","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Savore tire ňeprijaťeľa","poem":1},{"text":"pre tu phundraven o muja,","poem":2},{"text":"asan tutar, den pre tu avri o danda","poem":1},{"text":"a phenen: „Chaľam len tele!","poem":2},{"text":"Kada hin oda džives, pre savo but užarahas.","poem":1},{"text":"Dodžiďiľam pes oda!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"O RAJ kerďa oda, so plaňinelas.","poem":1},{"text":"Ačhiľa pes oda, so phenďa;","poem":2},{"lineBreak":true},{"text":"oda, so prikazinďa imar čirla anglal.","poem":2},{"text":"Ňičinelas tut bi oda,","poem":1},{"text":"hoj leske te uľahas pharo.","poem":2},{"text":"Domukľa le ňeprijaťeľiske te radisaľol upral tu","poem":1},{"text":"a olen, ko tut trapinenas, diňa zor te zviťazinel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Vičin andral o jilo ko RAJ,","poem":1},{"text":"murona le Sionoskra čhakro.","poem":2},{"text":"Mi čuľan tutar o apsa sar paňi rat-džives.","poem":1},{"text":"Ma preačh! Ma de tire apsenge te zaačhel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ušťi upre prekal e rat","poem":1},{"text":"a rov pale a pale anglo RAJ!","poem":2},{"text":"Čhiv avri tiro jilo sar paňi","poem":1},{"text":"anglo muj le RAJESKRO.","poem":2},{"text":"Hazde ke leste tire vasta","poem":1},{"text":"vaš o dživipen tire čhavengro,","poem":2},{"text":"so meren bokhatar","poem":1},{"text":"pro agor dojekha uľicakro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"„Dikh, RAJEJA!","poem":1},{"text":"Soske amen avke marďal?","poem":2},{"text":"O džuvľija mušinen te chal bokhatar","poem":1},{"text":"peskre čhavoren, saven kamen!","poem":2},{"text":"O rašaja the o proroka hine murdarde","poem":1},{"text":"andro Chramos le RAJESKRO!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"O terne the o phure pašľon jekhetane","poem":1},{"text":"andro prachos pro uľici.","poem":2},{"text":"Mire terne čhaja the terne čhave","poem":1},{"text":"sas murdarde le šabľenca.","poem":2},{"text":"Andre oda džives, sar salas choľamen,","poem":1},{"text":"murdarďal len a na sas tuke pharo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Vičinďal pre amende ajci dženen sar pro inepos;","poem":1},{"text":"anďal pre mande bari dar pal savore seri.","poem":2},{"text":"Andro džives le RAJESKRA choľakro","poem":1},{"text":"ňiko na denašľa aňi na predžiďiľa.","poem":2},{"text":"Olen, pal kaste man starinavas a bararavas avri,","poem":1},{"text":"murdarďa miro ňeprijaťeľis.“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}