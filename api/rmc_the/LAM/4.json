{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"LAM","translationId":"rmc_the","name":"Roviben le Jeremijašiskro","commonName":"Roviben le Jeremijašiskro","title":"O Roviben le Jeremijašiskro","order":25,"numberOfChapters":5,"sha256":"b4fa6da5583e176920ce896425e1a26faf5a23b0b2db39bad19da80196618e41","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/rmc_the/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["O trestos le Sionoskro"]},{"type":"verse","number":1,"content":[{"text":"Jaj, sar kaľiľa o somnakaj,","poem":1},{"text":"sar pes čerinďa o žužo somnakaj!","poem":2},{"text":"O chramoskre bara hine rozčhide","poem":1},{"text":"pal savore agora pro uľici.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"O vzacna čhave le Sionoskre,","poem":1},{"text":"so monas ajci sar o žužo somnakaj,","poem":2},{"text":"mon akana ajci sar o kuča čikatar,","poem":1},{"text":"sar e buči le hrnčjariskre vastengri!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mek the o šakali den o koľina,","poem":1},{"text":"den te pijel peskre ciknoren,","poem":2},{"text":"ale mire manuša hine bijileskre","poem":1},{"text":"sar o pštrosi pre pušťa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Le čhavoreske, so pijel o thudoro,","poem":1},{"text":"priľepisaľiľa e čhib andro muj le smedostar.","poem":2},{"text":"O čhave mangenas maro,","poem":1},{"text":"ale ňiko len na delas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ola, so chanas o fajna chabena,","poem":1},{"text":"meren bokhatar pro uľici.","poem":2},{"text":"Ola, so barile avri andro baripen,","poem":1},{"text":"akana pašľon pro kopa šmeci.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O binos mire manušengro","poem":1},{"text":"hin bareder sar e vina la Sodomakri,","poem":2},{"text":"so sas jekhvareste čhiďi tele,","poem":1},{"text":"kajte pre late ňiko na thoďa o vast.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Amare raja sas žužeder sar jiv,","poem":1},{"text":"parneder sar thud.","poem":2},{"text":"O ťela len sas loleder sar o korali;","poem":1},{"text":"dičhonas avri sar o zafiris.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ale akana hine kaleder sar sadza;","poem":1},{"text":"pro uľici len našťi aňi te sprindžarel.","poem":2},{"text":"E cipa pro ťelos lenge phuriľa;","poem":1},{"text":"šučiľa avri sar kašt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Feder sas olenge, saven murdarďa e šabľa,","poem":1},{"text":"sar olenge, so mule bokhatar;","poem":2},{"text":"trapimen bokhatar našľonas,","poem":1},{"text":"bo pre maľa na barolas ňisavo chaben.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mek the o lačhejileskre džuvľija","poem":1},{"text":"tade peskre čhaven peskre vastenca","poem":2},{"text":"a kerde peske lendar chaben","poem":1},{"text":"andre ola dživesa, sar sas ňičimen mire nipi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"O RAJ čhiďa avri peskri choľi,","poem":1},{"text":"peskri bari choľi;","poem":2},{"text":"rozlabarďa pro Sion e jag,","poem":1},{"text":"savi rozchaľa leskre zakladi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Aňi o kraľa la phuvakre","poem":1},{"text":"aňi ňisave manuša pro svetos na pačanas,","poem":2},{"text":"hoj o proťivňikos the o ňeprijaťeľis","poem":1},{"text":"šaj predžal prekal o brani andro Jeruzalem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ale ačhiľa pes oda vaš o bini leskre prorokengre,","poem":1},{"text":"vaš o vini leskre rašajengre,","poem":2},{"text":"save čhorenas avri o rat le spravodľivengro","poem":1},{"text":"maškar o foros.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bludzinenas pal o uľici sar kore;","poem":1},{"text":"ajse meľarde le rateha,","poem":2},{"text":"hoj pes ňiko na kamelas","poem":1},{"text":"te chudel lengre gadendar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"„Džan het! Tumen san nažuže!“","poem":1},{"text":"vičinenas pre lende.","poem":2},{"text":"„Džan het, džan het a ma chuden amen!“","poem":1},{"text":"Sar denašenas a džanas imar het,","poem":2},{"text":"o manuša maškar o narodi peske vakerenas:","poem":1},{"text":"„Imar amenca našťi kade bešen.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Korkoro o RAJ len roztradňa;","poem":1},{"text":"imar len na chraňinela.","poem":2},{"text":"Le rašajen ňiko na del pačiv","poem":1},{"text":"a le vodcen ňiko na šunel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"O jakha amenge slabisaľonas,","poem":1},{"text":"so ajci užarahas pre pomoca,","poem":2},{"lineBreak":true},{"text":"ale zbitočňe.","poem":2},{"text":"Pal amari veža užarahas pro narodos,","poem":1},{"text":"savo amen našťi zachraňinďa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"O ňeprijaťeľa pre amende užarenas, pre dojekh amaro krokos,","poem":1},{"text":"aňi našťi phirahas pal amare uľici.","poem":2},{"text":"Pašes hin amaro koňec, amare dživesa pes pherarde;","poem":1},{"text":"bo avľa amaro koňec.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ola, ko pal amende avenas,","poem":1},{"text":"sas richleder sar o orli pro ňebos.","poem":2},{"text":"Denašenas pal amende pro verchi,","poem":1},{"text":"a užarenas amen pre pušťa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Le RAJESKRO pomazimen,","poem":1},{"text":"o dichos amare dživipnaskro,","poem":2},{"lineBreak":true},{"text":"sas chudlo andre lengre pasci.","poem":2},{"text":"Pal leste peske vakerahas:","poem":1},{"text":"„Andre leskro ciňos dživaha maškar o narodi.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ča radisaľuv a thov baripen, čhaje le Edomoskri,","poem":1},{"text":"so bešes andre phuv Uc!","poem":2},{"text":"Ale the pre tute avela e kuči;","poem":1},{"text":"mačoha a čhiveha tut tele langi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Čhaje le Sionoskri, o trestos vaš tiri vina imar preačhiľa.","poem":1},{"text":"O Del tut imar na ľidžala andro zajaťje.","poem":2},{"text":"Ale marela tut, čhaje le Edomoskri, vaš tiri vina","poem":1},{"text":"a sikavela tire bini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}