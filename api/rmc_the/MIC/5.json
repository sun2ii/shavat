{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"MIC","translationId":"rmc_the","name":"Micheaš","commonName":"Micheaš","title":"O Micheaš","order":33,"numberOfChapters":7,"sha256":"477d0bc6561237a2168697ce51265cfdd0a48280f04a7259dd81565de819aef9","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/rmc_the/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["O Kraľis andral o Betlehem"]},{"type":"verse","number":1,"content":[{"text":"„Ale tu, Betlehem, Efrata,","poem":1},{"text":"kajte sal nekcikneder maškar o fori andre Judsko,","poem":2},{"text":"andral tu mange avela oda,","poem":1},{"text":"ko vladňinela upral o Izrael.","poem":2},{"text":"Ov sas imar čirlastar,","poem":1},{"text":"imar le večne dživesendar.“","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O Izrael ela dino andro vasta le ňeprijaťeľenge,","poem":1},{"text":"medik odi, ko hiňi khabňi, na ločhola le čhavores","poem":2},{"text":"a medik okla leskre phrala na avena pale ko manuša andro Izrael.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ušťela upre a pašinela peskro stados","poem":1},{"text":"andre zor le RAJESKRI,","poem":2},{"lineBreak":true},{"text":"andre slava le RAJESKRE naveskri, peskre Devleskri.","poem":2},{"text":"Dživena andro smirom,","poem":1},{"text":"bo les ela bari pačiv dži pro agor le svetoskro.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ov ela amaro smirom,","poem":1},{"text":"te avľahas pre amende e Asirija.","poem":2},{"lineBreak":true},{"text":"Te pes dochudňahas andre amare pevnosťi,","poem":2},{"text":"ačhavaha pre lende efta pasťjeren","poem":1},{"text":"the ochto vodcen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"On vladňinena upral e Asirija la šabľaha,","poem":1},{"text":"upral le Nimrodoskri phuv la avricirdňa šabľaha.","poem":2},{"text":"Amaro kraľis amen zachraňinela la Asirijatar,","poem":1},{"text":"te avľahas pre amende","poem":2},{"lineBreak":true},{"text":"a dochudňahas pes pre amari phuv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ola, ko ačhena te dživel andral o Jakob,","poem":1},{"text":"ena akor maškar aver narodi","poem":2},{"text":"sar e rosa le RAJESTAR,","poem":1},{"text":"sar o brišind pre čar,","poem":2},{"text":"save pes na muken pro manuš","poem":1},{"text":"a na užaren pro čhave le manušeskre.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ola, ko ačhena te dživel andral o Jakob,","poem":1},{"text":"ena maškar o narodi,","poem":2},{"lineBreak":true},{"text":"maškar o but manuša,","poem":2},{"text":"sar o ľevos maškar o dziva džviri,","poem":1},{"text":"sar o terno ľevos maškar o stados le bakrengro,","poem":2},{"text":"savo avel a rozpučinel,","poem":1},{"text":"savo čhingerel avke,","poem":2},{"lineBreak":true},{"text":"hoj ňiko našťi zachraňinel.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tiro vast ela uprehazdlo","poem":1},{"text":"upral ola, ko pre tu džan,","poem":2},{"lineBreak":true},{"text":"a savore tire ňeprijaťeľa ena zňičimen.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"„Andre oda džives,“","poem":1},{"text":"phenel o RAJ,","poem":2},{"text":"„murdarava avri tire grajen","poem":1},{"text":"a zňičinava tire maribnaskre verdana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zňičinava o fori andre tiri phuv","poem":1},{"text":"a čhivava tele savore tire pevnosťi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zňičinava o čaroďejňictvo, so keres,","poem":1},{"text":"a na ela tut vražňika.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Zňičinava tire modli","poem":1},{"text":"the tire sveta slupi;","poem":2},{"text":"imar tut na klaňineha","poem":1},{"text":"angle buči tire vastengri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Čhivava tutar het la Ašerakre slupi","poem":1},{"text":"a zňičinava tire fori.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mira bara choľaha man pomsťinava savore narodenge,","poem":1},{"text":"so man na kamenas te šunel.“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}