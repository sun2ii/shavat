{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"NAM","translationId":"rmc_the","name":"Nahum","commonName":"Nahum","title":"O Nahum","order":34,"numberOfChapters":3,"sha256":"24bf299dc9283840e1e09c6cfc59d95bc9a26518be512e2bf4cfd2913050befd","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/rmc_the/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Vigos le foroske Ninive"]},{"type":"verse","number":1,"content":[{"text":"Vigos kale foroske!","poem":1},{"text":"Murdarel le manušen, furt ča klaminel;","poem":2},{"text":"hino pherdo le čorde vecenca;","poem":1},{"text":"šoha na preačhel te čorel.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O bičos pukinel a o kereki šunďol;","poem":1},{"text":"o graja aven sig a o verdana džan dzivones.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O jazdci pes mukle pro mariben;","poem":1},{"text":"o šabľi the o kopiji bľišťisaľon.","poem":2},{"lineBreak":true},{"text":"But džene hine murdarde, pherdo mule džene pro kopi.","poem":2},{"text":"Ajci mule manuša, hoj pes na den aňi te zgenel;","poem":1},{"text":"le manušenge pre lende poddžan o pindre.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kada savoro pes ačhela","poem":1},{"text":"vaš o baro lubipen le foroskro Ninive, ola lubňakro,","poem":2},{"lineBreak":true},{"text":"savi džanelas dojekhes te očarinel peskre šukaribnaha,","poem":2},{"text":"savi pricirdelas le naroden peskre lubipnaha","poem":1},{"text":"a le nipen peskre čarenca.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"„Me džav pre tu, Ninive“","poem":1},{"text":"phenel o Nekzoraleder RAJ.","poem":2},{"text":"„Hazdava tuke upre e rokľa dži o muj;","poem":1},{"text":"sikavava le narodenge tiro langipen","poem":2},{"lineBreak":true},{"text":"a le kraľišagenge tiri ladž.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Čhivava pre tute o džungipen,","poem":1},{"text":"kerava tuke ladž anglo manuša,","poem":2},{"lineBreak":true},{"text":"anava tut avri pro čudos.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sako, ko tut dikhela,","poem":1},{"text":"denašela tutar a phenela:","poem":2},{"text":"‚O Ninive hino zňičimen! Ko pal leste rovela?‘","poem":1},{"text":"Kaj tuke te rodel olen, ko tut poťešinena?“","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Či sal tu feder sar o foros Tebi","poem":1},{"noteId":0},{"text":"paš o Nil,","poem":1},{"text":"pašal savo sas pherdo paňa?","poem":2},{"text":"O moros sas leskri ochrana","poem":1},{"text":"a o paňa leskro muros;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"o zoralo Kuš the o Egipt sas leskri ňekoňečno zor,","poem":1},{"text":"o Put the e Libija sas leske pre pomoca.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"The avke sas kada foros zailo","poem":1},{"text":"a geľa andro otroctvos.","poem":2},{"text":"The leskre čhave sas rozčhingerde","poem":1},{"text":"pro agora savore uľicengre.","poem":2},{"text":"Vaš leskre vodci pes losinelas","poem":1},{"text":"a savore leskre anglune murša sas zaphandle le lancenca.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"The tu, Ninive, mačoha;","poem":1},{"text":"džaha tut te garuvel","poem":2},{"lineBreak":true},{"text":"a kameha te denašel tire ňeprijaťeľiske.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Savore tire pevnosťi hine sar o figovňika,","poem":1},{"text":"pre save hin o ešebna figi.","poem":2},{"text":"Te pes lenca razinel,","poem":1},{"text":"peren andro muj oleske,","poem":2},{"lineBreak":true},{"text":"ko kamel te chal.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tire slugaďa hine sar čhajora;","poem":1},{"text":"o brani tira phuvakre hine phundrade le ňeprijaťeľenge,","poem":2},{"lineBreak":true},{"text":"bo e jag zlabarďa lengre zavori.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hordin tuke akana o paňi,","poem":1},{"text":"bo aveha obkľučimen,","poem":2},{"lineBreak":true},{"text":"a zoraľar tuke tire pevnosťi!","poem":2},{"text":"Rozker e čik, ker tuke malta","poem":1},{"text":"ker tuke cehli,","poem":2},{"lineBreak":true},{"text":"hoj te zoraľares tire hradbi!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"No the avke tut zlabarela e jag a čhinela e šabľa;","poem":1},{"text":"zlabarela tut sar le kobilken.","poem":2},{"text":"Kajte san but sar kobilki,","poem":1},{"text":"but sar o maľakre grajora!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tire kupci hine buter sar o čercheňa pro ňebos,","poem":1},{"text":"ale akana džan het;","poem":2},{"lineBreak":true},{"text":"hine sar o kobilki, so chan avri e maľa a odľecinen.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tire vodci hine sar kobilki","poem":1},{"text":"a tire veľiťeľa sar kopa maľakre grajora,","poem":2},{"lineBreak":true},{"text":"so ačhen garude andro ohradi, sar hin šil;","poem":2},{"text":"ale sar avel o kham avri, ľecinen het,","poem":1},{"text":"a ňiko na džanel kaj.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kraľina andral e Asirija, tire pasťjera zasute","poem":1},{"text":"a tire vodci peske pašľile tele.","poem":2},{"text":"Tire manuša hine roztradle pro verchi","poem":1},{"text":"a nane ko len te skidel upre.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Našťi te sasťarel avri tiri dukh;","poem":1},{"text":"tiri rana hiňi igen bari.","poem":2},{"text":"Dojekh, ko šunela o hiros pal tute,","poem":1},{"text":"tuke radisaľola, hoj peľal,","poem":2},{"text":"bo na sas ňiko, ko na dopeľa pre tiro nalačhipen,","poem":1},{"text":"savo na preačhehas te kerel.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"3,8 E hebrejiko čhib: No-amon","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/rmc_the/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}