{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":1,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Bachtalo hin oda, ko na prilel o radi le nalačhe manušengre,","poem":1},{"text":"na phirel pal o drom le binošnenca","poem":2},{"lineBreak":true},{"text":"a na bešel maškar ola, ko asan le Devlestar,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ale leskro radišagos hin andro zakonos le RAJESKRO","poem":1},{"text":"a pal leskro zakonos gondoľinel rat-džives.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hino sar o stromos sadzimen paš o paňi,","poem":1},{"text":"so anel o uľipen andre peskro časos;","poem":2},{"text":"leskre prajti na šučon avri","poem":1},{"text":"a savoro, so kerel, avel leske avri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Avres hin le nalačhe manušenca!","poem":1},{"text":"On hine sar o phus rozphurdlo la balvajaha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vašoda na obačhena o nalačhe pro sudos,","poem":1},{"text":"aňi o binošna maškar o čačipnaskre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Se o RAJ džanel a chraňinel o drom le čačipnaskre manušengro,","poem":1},{"text":"ale o drom le nalačhengro ľidžal andro meriben.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}