{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"O paľikeribnaskro žalmos.","descriptive":true},{"text":"Giľaven radišagoha le RAJESKE, caľi phuv!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Služinen le RAJESKE radišagoha!","poem":1},{"text":"Aven anglal leste le radišagoskre giľenca!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Achaľon, hoj o RAJ hino Del!","poem":1},{"text":"Ov amen stvorinďa, leskre sam;","poem":2},{"text":"amen sam leskre manuša,","poem":1},{"text":"o bakrore pre leskri maľa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aven andre leskre brani le paľikeribnaha,","poem":1},{"text":"andre leskre dvori la chvalaha!","poem":2},{"lineBreak":true},{"text":"Paľikeren leske a lašaren leskro nav!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bo o RAJ hino lačho;","poem":1},{"text":"leskro verno kamiben ľikerel pro furt","poem":2},{"lineBreak":true},{"text":"a leskri vernosť predžal pal jekh pokoleňje pre aver.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}