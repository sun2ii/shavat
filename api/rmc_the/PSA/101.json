{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":101,"content":[{"type":"verse","number":1,"content":[{"text":"Le Davidoskro žalmos.","descriptive":true},{"text":"Pal tiro kamiben the spravodľišagos","poem":1},{"text":"kamav te giľavel,","poem":2},{"lineBreak":true},{"text":"tut kamav te lašarel, RAJEJA!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dav mange pozoris,","poem":1},{"text":"hoj te phirav pal o dokonalo drom.","poem":2},{"lineBreak":true},{"text":"Kana aveha ke ma?","poem":2},{"text":"Andre miro kher dživava žuže jileha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na dikhava le jakhenca pre ňisavo nalačhipen.","poem":1},{"lineBreak":true},{"text":"Našťi avri ačhav oda,","poem":1},{"text":"so keren ola, ko pes visaren le Devlestar.","poem":2},{"text":"Na ela man lenca ňič!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mi aven dur o previsarde veci mire jilestar;","poem":1},{"text":"pal o nalačho na kamav aňi te džanel.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ko počoral vakerel namištes pal aver dženo,","poem":1},{"text":"oleske phandava o muj.","poem":2},{"text":"Kas hin barikane jakha a ko pes ľidžal upre,","poem":1},{"text":"oles paš ma na zľidžava.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mire jakha dikhena pro verna pre phuv","poem":1},{"text":"a domukava lenge te bešel manca.","poem":2},{"text":"Ko phirel žužes,","poem":1},{"text":"oda mange služinela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Andre miro kher na bešela ňiko,","poem":1},{"text":"ko avrenca thovel avri;","poem":2},{"text":"paš ma na obačhela ňisavo klamaris.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sako tosara ňičinava","poem":1},{"text":"savore nalačhe manušen andre phuv.","poem":2},{"text":"Tradava avri savoren, ko keren o nalačhipen,","poem":1},{"text":"andral o foros le RAJESKRO.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}