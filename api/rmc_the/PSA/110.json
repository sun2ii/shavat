{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Le Davidoskro žalmos."]},{"type":"verse","number":1,"content":[{"text":"O RAJ phenďa mire Rajeske:","poem":1},{"text":"„Beš tuke pal miri čači sera,","poem":2},{"text":"medik tuke na thovava tire ňeprijaťeľen","poem":1},{"text":"tel o pindre.“","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Andral o Sion nacirdela o RAJ tire kraľiskri zor a phenela:","poem":1},{"lineBreak":true},{"text":"„Vladňin maškar tire ňeprijaťeľa!“","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oda džives, sar džaha andro mariben,","poem":1},{"text":"tire manuša avena pal tute korkore pestar.","poem":2},{"text":"Avke sar e rosa avel avri sig tosara,","poem":1},{"text":"avke tire terne murša avena ke tu","poem":2},{"lineBreak":true},{"text":"pre tire sveta verchi","poem":2},{"noteId":57},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O RAJ iľa vera a na bajinela:","poem":1},{"text":"„Tu sal rašaj pro furt avke sar o Melchisedek.“","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O RAJ hino pal tiri čači sera;","poem":1},{"text":"zňičinela le kraľen andre oda džives, sar avela leskri choľi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sudzinela le naroden, ela ode pherdo mule manuša.","poem":1},{"text":"Rozpučinela le kraľen pal caľi phuv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Andral o jarkos pašal o drom pijela paňi;","poem":1},{"text":"a vašoda hazdela upre o šero.","poem":2}]}],"footnotes":[{"noteId":57,"caller":"+","text":"110,3 Na džanel pes, so e hebrejiko čhib phenel.","reference":{"chapter":110,"verse":3}}]},"thisChapterLink":"/api/rmc_the/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}