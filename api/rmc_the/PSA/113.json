{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Haleluja!","poem":1},{"lineBreak":true},{"text":"Lašaren le RAJES, tumen leskre služobňikale,","poem":1},{"text":"lašaren o nav le RAJESKRO!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mi el barardo o nav le RAJESKRO","poem":1},{"text":"akanastar pro furt!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Odarik, khatar avel avri o kham, dži ode, kaj zadžal andre,","poem":1},{"text":"mi el lašardo o nav le RAJESKRO.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O RAJ hino barardo upral savore narodi,","poem":1},{"text":"leskri slava hin upral o ňebos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ko hin ajso sar o RAJ, amaro Del,","poem":1},{"text":"savo bešel učes","poem":2}]},{"type":"verse","number":6,"content":[{"text":"a dikhel dži tele","poem":1},{"text":"pro ňebos the pre phuv?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Le čore manušes hazdel upre andral o prachos,","poem":1},{"text":"le slabes podhazdel pal o šmeciskos,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"hoj les te thovel te bešel le rajenca;","poem":1},{"text":"peskre manušengre rajenca.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ola džuvľake, sava našťi el čhave,","poem":1},{"text":"del te bešel andro kher","poem":2},{"lineBreak":true},{"text":"sar ola dake, savi radisaľol le čhavendar.","poem":2},{"text":"Haleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}