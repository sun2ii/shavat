{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Sar o Izrael avelas avri andral o Egipt,","poem":1},{"text":"o kher le Jakoboskro le cudze narodendar,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"o Juda ačhiľa le Devleskro sveto than,","poem":1},{"text":"o Izrael leskro kraľišagos.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O moros oda dikhľa a denašľa,","poem":1},{"text":"o paňi Jordan chudňa te džal palal,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"o verchi chučkerenas sar bakre","poem":1},{"text":"a o brehi sar cikne bakrore.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"So tute, morona, hoj denašľal?","poem":1},{"text":"So tute, Jordanona, hoj visaľiľal palal?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Verchale, soske chučkeren sar bakre?","poem":1},{"text":"Brehale, soske chučkeren sar cikne bakrore?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Izdra, phuvije, anglo Raj,","poem":1},{"text":"anglo Del le Jakoboskro,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"savo čerinel e skala pro jazeros","poem":1},{"text":"a o kremeňis pro prameňa le paňengre.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}