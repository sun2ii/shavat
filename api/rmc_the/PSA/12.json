{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Oleske, ko ľidžal o bašaviben. Pal o šeminit","descriptive":true},{"noteId":5},{"text":". Le Davidoskro žalmos.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Pomožin, RAJEJA! Bo ňiko nane imar pobožno;","poem":1},{"text":"o pačivale manuša našľile.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Klaminen jekh avreske;","poem":1},{"text":"vakeren o gule lava,","poem":2},{"lineBreak":true},{"text":"ale andro jile hine falošna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"RAJEJA, phand andre savore gule vušta","poem":1},{"text":"a odčhin dojekh barikaňi čhib –","poem":2}]},{"type":"verse","number":5,"content":[{"text":"savoren, ko vakeren: „Andre čhib amen hin e zor!","poem":1},{"text":"Vakeraha, so kamas","poem":2},{"lineBreak":true},{"text":"a savo raj amenge šaj rozkazinel?“","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ale o RAJ phenel:","poem":1},{"text":"„Akana vaš oda, hoj o slaba cerpinen","poem":2},{"lineBreak":true},{"text":"a o čore roven dukhatar,","poem":2},{"lineBreak":true},{"text":"uščava a zachraňinava olen, ko peske oda igen mangen.“","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bo le RAJESKRE lava hine žuže;","poem":1},{"text":"hine sar o rup eftavar prežužardo","poem":2},{"lineBreak":true},{"text":"a prelabardo andro čikakro bov.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"RAJEJA, tu ochraňineha le čoren","poem":1},{"text":"a stražineha pro furt","poem":2},{"lineBreak":true},{"text":"kale nalačhe manušendar,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"save phiren barikanes všadzik,","poem":1},{"text":"bo o džungipen pes hazdel upre maškar o manuša.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"12,1 Oda hin lavutariko lav.","reference":{"chapter":12,"verse":1}}]},"thisChapterLink":"/api/rmc_the/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":9}