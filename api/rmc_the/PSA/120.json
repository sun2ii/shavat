{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"E giľi pro drom upre andro Jeruzalem.","descriptive":true},{"lineBreak":true},{"text":"Pro RAJ vičinavas andral o pharipen","poem":1},{"text":"a ov mange odphenďa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"RAJEJA, zachraňin man le klamišagoskre vuštendar","poem":1},{"text":"the le falošne čhibendar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"So tuha ov kerela","poem":1},{"text":"a sar tut marela,","poem":2},{"lineBreak":true},{"text":"tu falošno čhib?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Marela tut le ostre maribnaskre šipenca","poem":1},{"text":"the le jagale angarenca","poem":2},{"noteId":62},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vigos mange!","poem":1},{"lineBreak":true},{"text":"Te bešel kade hin avke namištes","poem":1},{"text":"sar le cudzincoske andro Mešech,","poem":2},{"lineBreak":true},{"text":"abo sar maškar o manuša andro Kedar!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Imar igen but dživav olenca,","poem":1},{"text":"ko našťi avri ačhen o smirom.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sar me vakerav, hoj kamav o smirom,","poem":1},{"text":"on kamen o mariben.","poem":2}]}],"footnotes":[{"noteId":62,"caller":"+","text":"120,4 E hebrejiko čhib: rotem – oda hin stromos, savestar hin igen lačhe angara","reference":{"chapter":120,"verse":4}}]},"thisChapterLink":"/api/rmc_the/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}