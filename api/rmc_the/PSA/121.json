{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"E giľi pro drom upre andro Jeruzalem.","descriptive":true},{"text":"Mire jakhenca dikhav upre pro verchi.","poem":1},{"text":"Khatar avela miri pomoca?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Miri pomoca avel le RAJESTAR,","poem":1},{"text":"savo stvorinďa o ňebos the e phuv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ov na domukela, hoj tuke te poddžal o pindro;","poem":1},{"text":"tiro stražcas na sovel!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dikh, oda, ko stražinel le Izrael,","poem":1},{"text":"na sovel aňi na driminel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O RAJ hino tiro stražcas;","poem":1},{"text":"o RAJ hino tiro ciňos pal tiri čači sera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dživese tut o kham na dukhavela","poem":1},{"text":"aňi o čhonoro rači.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O RAJ tut chraňinela savore nalačhipnastar;","poem":1},{"text":"ov chraňinela tiro dživipen.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O RAJ tut chraňinela,","poem":1},{"text":"sar džaha a the sar aveha,","poem":2},{"lineBreak":true},{"text":"akanastar a pro furt.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}