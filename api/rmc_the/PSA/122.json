{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"Le Davidoskri giľi pro drom upre andro Jeruzalem.","descriptive":true},{"text":"Radisaľiľom, sar mange phende:","poem":1},{"text":"„Aven džas andro kher le Devleskro!“","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akana amare pindre ačhen","poem":1},{"text":"andre tire brani, Jeruzalemona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O Jeruzalem hino ačhado upre sar foros,","poem":1},{"text":"kaj hin spojimen sa andre jekh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ode džan o kmeňi upre,","poem":1},{"text":"o kmeňi le RAJESKRE,","poem":2},{"text":"te lašarel o nav le RAJESKRO,","poem":1},{"text":"avke sar hin prikazimen le Izraeloske.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ode hin o troni pro sudos,","poem":1},{"text":"o troni le Davidoskre potomkengre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Modľinen tumen vaš o smirom prekal o Jeruzalem a phenen:","poem":1},{"text":"„Bachtale ola, ko tut kamen!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mi avel o smirom andre tire muri","poem":1},{"text":"a mi dživel pes šukares andre tire palaca!“","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vaš mire phrala the prijaťeľa phenav:","poem":1},{"text":"„Smirom andre tu, Jeruzalemona!“","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vaš o kher le RAJESKRO, amare Devleskro,","poem":1},{"text":"man modľinava, hoj tuke te džal mištes.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}