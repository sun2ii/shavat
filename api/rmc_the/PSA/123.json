san o barvale","poem":2},{"text":"a tele dikhen o barikane.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}