{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":[{"text":"Le Davidoskri giľi pro drom upre andro Jeruzalem.","descriptive":true},{"text":"Te amenca na uľahas o RAJ","poem":1},{"text":"– mi phenel o Izrael –","poem":2}]},{"type":"verse","number":2,"content":[{"text":"te amenca na uľahas o RAJ,","poem":1},{"text":"sar pre amende avle o manuša,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"chalehas amen tele džidonen,","poem":1},{"text":"sar lengri choľi pre amende rozlabiľa;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"o paňa amen začhidehas,","poem":1},{"text":"o prudos amen scirdňahas tele,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"o dziva paňa","poem":1},{"text":"amen zailehas andre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Paľikeras le RAJESKE, hoj na domukľa amare ňeprijaťeľenge,","poem":1},{"text":"hoj amen te rozčhingeren le dandenca!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amen denašľam","poem":1},{"text":"sar o čiriklo andral e pasca le lovcoske;","poem":2},{"text":"e pasca čhinďiľa","poem":1},{"text":"a amen andral denašľam.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amari pomoca hin andro nav le RAJESKRO,","poem":1},{"text":"savo stvorinďa o ňebos the e phuv.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}