{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"E giľi pro drom upre andro Jeruzalem.","descriptive":true},{"text":"Ola, ko pes muken pro RAJ,","poem":1},{"text":"hine sar o verchos Sion:","poem":2},{"lineBreak":true},{"text":"Na čhalaven pes,","poem":2},{"lineBreak":true},{"text":"ľikeren pro furt.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sar hin o verchi pašal o Jeruzalem,","poem":1},{"text":"avke hin o RAJ pašal peskre manuša","poem":2},{"lineBreak":true},{"text":"akanastar a pro furt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O žezlos le nalačhengro na vladňinela","poem":1},{"text":"upral e phuv le spravodľive manušengri,","poem":2},{"text":"hoj te na keren o spravodľiva","poem":1},{"text":"peskre vastenca o nalačhipen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"RAJEJA, ker o lačho olenge, ko hine lačhe,","poem":1},{"text":"olenge, ko hine čačipnaskre andro jile!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ale olen, ko oddžan pro bange droma,","poem":1},{"text":"o RAJ tradela het jekhetane olenca, ko keren o nalačhipen.","poem":2},{"lineBreak":true},{"text":"O smirom pro Izrael!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}