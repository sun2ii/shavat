{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"E giľi pro drom upre andro Jeruzalem.","descriptive":true},{"text":"Sar o RAJ anelas pale le Sionoskre zailen,","poem":1},{"text":"sas amenge oda sar suno.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akor amenge o muj asalas","poem":1},{"text":"a amare čhiba giľavenas radišagostar.","poem":2},{"text":"Akor pes maškar aver narodi vakerelas:","poem":1},{"text":"„O RAJ prekal lende kerďa bare veci!“","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O RAJ kerďa prekal amende bare veci","poem":1},{"text":"a amen radisaľuvahas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"An pale, RAJEJA, amare zailen","poem":1},{"text":"avke sig sar o paňi andro Negev pal o baro brišind.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ola, ko sadzinen le apsenca,","poem":1},{"text":"kidena upre bare radišagoha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rovibnaha džal avri oda,","poem":1},{"text":"ko hordinel o semenos;","poem":2},{"text":"radišagoha avela pale,","poem":1},{"text":"sar anela peskri pšeňica.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}