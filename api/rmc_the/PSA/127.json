{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"Le Šalamunoskri giľi pro drom upre andro Jeruzalem.","descriptive":true},{"text":"Te o RAJ na ačhavel o kher,","poem":1},{"text":"zbitočňe pes trapinen ola, ko les ačhaven;","poem":2},{"text":"te o RAJ na stražinel o foros,","poem":1},{"text":"zbitočňe del pozoris oda, ko les stražinel.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zbitočňe ušťen upre sig,","poem":1},{"text":"džan te sovel nasig","poem":2},{"text":"a keren phares buči vaš o maro;","poem":1},{"text":"bo ov pes starinel pal ola, kas kamel, mek sar soven.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O čhave hine daros le RAJESTAR,","poem":1},{"text":"o čhavoro la dake andro per hin le RAJESKRI odmena.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O čhave, so uľile le muršeske, sar sas terno,","poem":1},{"text":"hine sar o šipi andro vasta le maribnaskre muršeske.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bachtalo hin oda murš,","poem":1},{"text":"savo peske lenca pherdžarďa o tulcos.","poem":2},{"text":"On pes na ladžana, sar pes sudzinena","poem":1},{"text":"peskre ňeprijaťeľenca paš e brana pro sudos.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}