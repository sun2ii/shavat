{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"E giľi pro drom upre andro Jeruzalem.","descriptive":true},{"text":"Bachtalo ela sako, ko pes daral le RAJESTAR,","poem":1},{"text":"ko phirel pal leskre droma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dživeha la bučatar, so keres tire vastenca;","poem":1},{"text":"aveha požehňimen a savoro tuke džala mištes.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tiri romňi ela andre tiro kher","poem":1},{"text":"sar e viňica, so anel but ovocje,","poem":2},{"text":"tire čhave ena pašal tiro skamind","poem":1},{"text":"sar o terne olivova stromi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He, kavke ela požehňimen oda murš,","poem":1},{"text":"savo pes daral le RAJESTAR.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi požehňinel tut o RAJ andral o Sion,","poem":1},{"text":"hoj te dikhes o požehnaňje le Jeruzalemoskro calo tiro dživipen,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"hoj te dikhes tire čhavengre čhaven.","poem":1},{"lineBreak":true},{"text":"Smirom le Izraeloske!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}