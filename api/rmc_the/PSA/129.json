{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"E giľi pro drom upre andro Jeruzalem.","descriptive":true},{"text":"Mire terňipnastar man but trapinenas","poem":1},{"text":"– mi phenel o Izrael –","poem":2}]},{"type":"verse","number":2,"content":[{"text":"mire terňipnastar man but trapinenas,","poem":1},{"text":"ale na zňičinde man.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Orinenas mange pal o dumo,","poem":1},{"text":"orinde avri bare rihi sar pro maľi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ale o RAJ hino spravodľivo;","poem":1},{"text":"prečhinďa o lani le nalačhe manušengre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi visaľon pale ladžaha savore,","poem":1},{"text":"ko našťi avri ačhen o Sion!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mi aven sar e čar pro padi,","poem":1},{"text":"savi šučola avri sigeder, sar la cirdena avri;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"savaha peske na pherdžarela e burňik oda, ko košinel,","poem":1},{"text":"aňi o vasta oda, ko sphandel o snopi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ola, ko predžana pašal lende, na phenena:","poem":1},{"text":"„O požehnaňje le RAJESKRO pre tumende!","poem":2},{"lineBreak":true},{"text":"Žehňinas tumenge andro nav le RAJESKRO.“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}