{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Oleske, ko ľidžal o bašaviben. Le Davidoskro žalmos.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"RAJEJA, mek dži kana pre ma bistereha? Pro furt?","poem":1},{"text":"Dži kana angle ma mek garuveha tiro muj?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dži kana hordinava o pharipen andre duša","poem":1},{"text":"a džives so džives e žaľa andro jilo?","poem":2},{"lineBreak":true},{"text":"Dži kana pes miro ňeprijaťeľis pre mande ľidžala upre?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dikh pre mande, RAJEJA, a odphen mange!","poem":1},{"text":"De švetlos mire jakhenge,","poem":2},{"lineBreak":true},{"text":"hoj te na zasovav andro meriben,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"hoj te na phenel miro ňeprijaťeľis:","poem":1},{"text":"Domarďom les!","poem":2},{"lineBreak":true},{"text":"A te na radisaľol, te me perava.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ale me man mukav pre tiro verno kamiben;","poem":1},{"text":"miro jilo radisaľol andre tiro spaseňje.","poem":2},{"text":"Giľavava le RAJESKE,","poem":1},{"text":"bo ov sas ke mande igen lačho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}