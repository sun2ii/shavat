{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"E giľi pro drom upre andro Jeruzalem.","descriptive":true},{"text":"Andral o bare paňa vičinav pre tute, RAJEJA!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ó Adonaj, šun miro hangos;","poem":1},{"text":"prithov tiro kan paš miro roviben.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"RAJEJA, te tu amenge rachineha o bini,","poem":1},{"text":"ó Adonaj, ko šaj obačhela?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ale tu amenge odmukes,","poem":1},{"text":"hoj amen te el sveto dar angle tu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Užarav pro RAJ – savoreha užarav;","poem":1},{"text":"mukav man pre leskro lav.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Miri duša užarel pro Raj","poem":1},{"text":"buter sar o stražňika pro tosara,","poem":2},{"lineBreak":true},{"text":"buter sar o stražňika pro tosara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Izraelona, muk tut pro RAJ,","poem":1},{"text":"bo ov tut pačivales kamel","poem":2},{"lineBreak":true},{"text":"a les hin bari zor vaš tuke te počinel.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ov počinela vaš o Izrael","poem":1},{"text":"vaš savore leskre bini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}