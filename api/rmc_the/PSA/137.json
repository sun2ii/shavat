{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Paš o babiloňika paňa,","poem":1},{"text":"bešahas a rovahas ode,","poem":2},{"lineBreak":true},{"text":"sar peske leperahas pro Sion.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ode pro stromi, pro virbi,","poem":1},{"text":"figinahas amare citari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ola, ko amen zaile, amen mangenas,","poem":1},{"text":"hoj lenge te giľavas;","poem":2},{"text":"ola, ko amen trapinenas, amendar kamenas,","poem":1},{"text":"hoj te giľavas radišagoha:","poem":2},{"lineBreak":true},{"text":"„Giľaven amenge jekh sionsko giľi!“","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sar šaj giľavas le RAJESKRI giľi","poem":1},{"text":"andre cudzo phuv?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Te bisterďomas pre tute, ó Jeruzalemona,","poem":1},{"text":"ta mi bisterel miro čačo vast te bašavel!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E čhib mange andro muj mi priľepisaľol,","poem":1},{"text":"te mange pre tute na leperava;","poem":2},{"lineBreak":true},{"text":"te o Jeruzalem na ela miro nekbareder radišagos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"RAJEJA, ma pobister le Edomitenge oda,","poem":1},{"text":"so vičinenas akor, sar peľa tele o Jeruzalem:","poem":2},{"lineBreak":true},{"text":"„Čhiven les tele, čhiven les tele dži o zakladi!“","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tu, babiloňiko čhaje, so aveha zňičimen!","poem":1},{"text":"Bachtalo hin oda, ko tuke visarela pale oda,","poem":2},{"lineBreak":true},{"text":"so amenge kerďal!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bachtalo oda, ko chudela tire čhaven","poem":1},{"text":"a demela lenca andre skala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}