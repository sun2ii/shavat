{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":138,"content":[{"type":"verse","number":1,"content":[{"text":"Le Davidoskro.","descriptive":true},{"text":"Paľikerava tuke, RAJEJA, andral calo jilo,","poem":1},{"text":"anglo ňeboskre bitosťi","poem":2},{"noteId":65},{"text":"tuke giľavava o chvali.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Visarav man ke tiro sveto Chramos, banďuvav tele","poem":1},{"text":"a lašarav tiro nav","poem":2},{"text":"vaš tiro baro kamiben the vernosť,","poem":1},{"text":"bo bararďal tiro lav upral savoreste","poem":2},{"noteId":66},{"text":".","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sar ke tu vičinavas, odphenďal mange;","poem":1},{"text":"iľal mandar e dar a diňal man zor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"RAJEJA, savore kraľa pre phuv tut lašarena,","poem":1},{"text":"sar šunena o lava andral tiro muj.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Giľavena pal tire droma,","poem":1},{"text":"bo le RAJESKRI slava hiňi bari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O RAJ hino upre učes,","poem":1},{"text":"a the avke dikhel, ko hino teledikhlo,","poem":2},{"lineBreak":true},{"text":"ale le barikanes prindžarel dural.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kajte uľomas andro pharipen,","poem":1},{"text":"tu na domukeha, hoj te merav;","poem":2},{"text":"nacirdeha tiro vast pre mire choľamen ňeprijaťeľa,","poem":1},{"text":"zachraňineha man tire čače vasteha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O RAJ dokerela sa vaš ma.","poem":1},{"text":"RAJEJA, tiro verno kamiben ľikerel pro furt.","poem":2},{"lineBreak":true},{"text":"Ma omuk e buči tire vastengri!","poem":2}]}],"footnotes":[{"noteId":65,"caller":"+","text":"138,1 E hebrejiko čhib: anglo devla","reference":{"chapter":138,"verse":1}},{"noteId":66,"caller":"+","text":"138,2 Abo: bararďal tiro lav upral tiro nav","reference":{"chapter":138,"verse":2}}]},"thisChapterLink":"/api/rmc_the/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}