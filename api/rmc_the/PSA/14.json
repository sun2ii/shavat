{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Oleske, ko ľidžal o bašaviben. Le Davidoskro žalmos.","descriptive":true},{"text":"O diline peske phenen andro jilo: „Nane Del!“","poem":1},{"text":"Previsarde hine a keren o džungale veci;","poem":2},{"lineBreak":true},{"text":"nane ňiko, ko kerďahas o lačhipen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"O RAJ dikhel andral o ňebos pre savore manuša,","poem":1},{"text":"dikhel, či hin vareko goďaver,","poem":2},{"lineBreak":true},{"text":"ko rodel le Devles.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sako pes visarďa het, sako ačhiľa nalačho;","poem":1},{"text":"nane ňiko, ko kerďahas o lačho,","poem":2},{"lineBreak":true},{"text":"nane aňi jekh.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Či na achaľon ňič savore, ko keren o nalačhipen?","poem":1},{"lineBreak":true},{"text":"Chan tele mire manušen,","poem":2},{"lineBreak":true},{"text":"sar te chalehas o maro,","poem":2},{"lineBreak":true},{"text":"a ko RAJ pes šoha na mangen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"No, jekhvar izdrana daratar,","poem":1},{"text":"bo o Del pomožinel olenge, ko les šunen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tumen musaren o plani le čore manušeskre,","poem":1},{"text":"ale o RAJ hino leskri ochrana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ó, te avľahas andral o Sion o spaseňje le Izraeloskro!","poem":1},{"text":"Sar o RAJ žehňinela pale peskre manušenge,","poem":2},{"lineBreak":true},{"text":"o Jakob radisaľola a o Izrael thovela baripen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}