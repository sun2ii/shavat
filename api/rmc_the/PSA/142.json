{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":142,"content":[{"type":"verse","number":1,"content":[{"text":"Le Davidoskro maskil","descriptive":true},{"noteId":69},{"text":". E modľitba, sar sas andre jaskiňa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Zorales vičinav ko RAJ,","poem":1},{"text":"vičinav ko RAJ, hoj ke ma te avel jileskro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Leske phenav avri miri žaľa","poem":1},{"text":"a vakerav pal miro pharipen.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sar miro duchos andre ma slabisaľol,","poem":1},{"text":"akor tu des pozoris pre miro chodňikos.","poem":2},{"text":"Pre oda drom, khatar džav,","poem":1},{"text":"mange garude e pasca.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dikh pre čači sera a dikheha,","poem":1},{"text":"hoj ňiko mange na kamel te pomožinel.","poem":2},{"text":"Nane man kaj te denašel,","poem":1},{"text":"ňikaske na džal pal miro dživipen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"RAJEJA, pre tu vičinav","poem":1},{"text":"a phenav: „Tu sal miro than, kaj man šaj garuvav,","poem":2},{"lineBreak":true},{"text":"tu sal sa, so mange kampel andre kada dživipen!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Šun miro roviben,","poem":1},{"text":"bo som andro baro pharipen.","poem":2},{"text":"Le man avri olendar, ko pre mande džan,","poem":1},{"text":"bo hine zoraleder sar me.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Le man avri andral e bertena,","poem":1},{"text":"hoj te lašarav tiro nav!","poem":2},{"text":"O čačipnaskre pes zdžana pašal mande,","poem":1},{"text":"bo mange presikaves o lačhipen.","poem":2}]}],"footnotes":[{"noteId":69,"caller":"+","text":"142,1 Oda šaj el: goďaver sikaviben","reference":{"chapter":142,"verse":1}}]},"thisChapterLink":"/api/rmc_the/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}