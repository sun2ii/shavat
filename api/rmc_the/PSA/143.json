{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":143,"content":[{"type":"verse","number":1,"content":[{"text":"Le Davidoskro žalmos.","descriptive":true},{"text":"RAJEJA, šun miri modľitba,","poem":1},{"text":"šun miro pokorno mangipen!","poem":2},{"lineBreak":true},{"text":"Odphen mange, bo sal verno the spravodľivo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ma sudzin tire služobňikos,","poem":1},{"text":"bo ňisavo džido manuš nane spravodľivo anglal tu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O ňeprijaťeľis pre mande džal,","poem":1},{"text":"demel manca andre phuv;","poem":2},{"text":"thovel man te bešel andro kaľipen","poem":1},{"text":"sar olen, ko imar čirla mule.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Miro duchos slabisaľol,","poem":1},{"text":"miro jilo imar na birinel te ľidžal o pharipen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Leperav mange pre ola dživesa, so sas varekana,","poem":1},{"text":"gondoľinav pal savoreste, so kerďal,","poem":2},{"lineBreak":true},{"text":"avel mange pre goďi e buči, so kerďal tire vastenca.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ke tute hazdav mire vasta,","poem":1},{"text":"som igen smedno pal tu sar e avrišuki phuv pal o paňi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"So neksigeder mange odphen, RAJEJA,","poem":1},{"text":"miro duchos imar na birinel!","poem":2},{"text":"Ma garuv mange tiro muj,","poem":1},{"text":"hoj te na dičhuvav avri sar ola, ko džan tele andro hrobos.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"De, hoj tosara te šunav tiro verno kamiben,","poem":1},{"text":"bo pre tute man mukav.","poem":2},{"text":"Sikav mange o drom, khatar te džal,","poem":1},{"text":"bo pačav andre tu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zachraňin man mire ňeprijaťeľendar, RAJEJA!","poem":1},{"text":"Ke tute man garuvav.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sikav man te kerel tiri voľa,","poem":1},{"text":"se tu sal miro Del.","poem":2},{"text":"Tiro lačho Duchos man mi ľidžal","poem":1},{"text":"pal e rovno phuv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"RAJEJA, obdžiďar man angle tiro nav;","poem":1},{"text":"le man avri andral o pharipen, bo sal spravodľivo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Zňičin mire ňeprijaťeľen, bo tiro kamiben hino pačivalo ke ma;","poem":1},{"text":"murdar savoren, ko man trapinen,","poem":2},{"lineBreak":true},{"text":"bo me som tiro služobňikos.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}