{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Haleluja!","poem":1},{"lineBreak":true},{"text":"Lašar le RAJES, dušo miri!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lašarava le RAJES, medik ča dživav,","poem":1},{"text":"giľavava o chvali mire Devleske calo miro dživipen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ma muken pes pro vodci,","poem":1},{"text":"ma muken pes pro manuša,","poem":2},{"lineBreak":true},{"text":"bo on našťi zachraňinen.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sar lendar džala avri o duchos, džana pale andre phuv","poem":1},{"text":"a oda džives našľola savoro, so kamenas te kerel.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bachtalo oda, kaske pomožinel o Del le Jakoboskro;","poem":1},{"text":"ko pes mukel pro RAJ, pre peskro Del,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"savo stvorinďa o ňebos the e phuv,","poem":1},{"text":"o moros the savoro, so andre hin,","poem":2},{"lineBreak":true},{"text":"a savo ačhel verno pro furt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ov zaačhel vaš o strapimen","poem":1},{"text":"a le bokhalen del te chal.","poem":2},{"lineBreak":true},{"text":"O RAJ lel avri le zaphandlen andral e bertena.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O RAJ del, hoj o kore te dikhen.","poem":1},{"text":"O RAJ hazdel upre olen, ko hine strapimen,","poem":2},{"lineBreak":true},{"text":"o RAJ kamel olen, ko hine čačipnaskre.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O RAJ chraňinel le cudzincen","poem":1},{"text":"a pomožinel le vdovenge the le širotenge,","poem":2},{"lineBreak":true},{"text":"ale musarel o plani le nalačhenge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"O RAJ kraľinela pro furt.","poem":1},{"text":"Ó, Sionona, tiro Del vladňinela","poem":2},{"lineBreak":true},{"text":"andral jekh pokoleňje pre aver.","poem":2},{"lineBreak":true},{"text":"Haleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}