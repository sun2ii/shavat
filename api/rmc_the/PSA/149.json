{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Haleluja!","poem":1},{"lineBreak":true},{"text":"Giľaven le RAJESKE nevi giľi,","poem":1},{"text":"lašaren les maškar leskre verna manuša, sar hine zgele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mi radisaľol o Izrael peskre Stvoriťeľistar,","poem":1},{"text":"o čhave le Sionoskre mi thoven baripen andre peskro kraľis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Le kheľibnaha mi lašaren leskro nav,","poem":1},{"text":"mi giľaven leske paš e bubna the citara.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Le RAJES hin radišagos peskre manušendar","poem":1},{"text":"a le pokornen koruňinela la zachranaha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O pačivale manuša mi khelen, bo zviťazinde,","poem":1},{"text":"a mi giľaven radišagostar pre peskre hadži.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mi el e chvala le Devleskri andre lengro muj","poem":1},{"text":"a e šabľa, so čhinel pal soduj seri, andro vasta,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"hoj te domaren le naroden","poem":1},{"text":"a hoj te potrestinen avre manušen,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"hoj lengre kraľen te phanden le lancenca","poem":1},{"text":"a lengre rajen le trastune kľiginenca,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"hoj len te sudzinen, avke sar hin pisimen.","poem":1},{"text":"Oda ela pre slava savore leskre pačivale manušenge.","poem":2},{"lineBreak":true},{"text":"Haleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}