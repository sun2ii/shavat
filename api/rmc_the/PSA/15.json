{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Le Davidoskro žalmos.","descriptive":true},{"text":"RAJEJA, ko šaj avel andre tiro stanos?","poem":1},{"text":"Ko šaj bešel pre tiro sveto verchos?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Oda, ko dživel žužo dživipen,","poem":1},{"text":"ko kerel čačipnaha,","poem":2},{"lineBreak":true},{"text":"ko jilestar vakerel o čačipen;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ko na vakerel o pľetki,","poem":1},{"text":"ko na dukhavel avres,","poem":2},{"lineBreak":true},{"text":"ko na vakerel namištes pal aver džene;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ko na prilel oles, kas o Del odčhiďa,","poem":1},{"text":"ko del pačiv olen, ko pes daran le RAJESTAR,","poem":2},{"lineBreak":true},{"text":"ko na čerinel peskri vera, kajte leske oda uľahas pro nalačho;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ko na del kečeň interesiha","poem":1},{"text":"a ko na prilel o love, hoj te vakerel pro ňevinno.","poem":2},{"lineBreak":true},{"text":"Ko kada kerel, šoha pes na čhalavela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}