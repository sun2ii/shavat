{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Le Davidoskro žalmos.","descriptive":true},{"text":"O RAJ hino miro pasťjeris,","poem":1},{"text":"ňič mange na chibaľinela.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ľidžal man pro maľi, kaj hin e zeleno čar,","poem":1},{"text":"anel man paš o paňa, kaj hin o smirom.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Občerstvinel miri duša","poem":1},{"text":"a vaš peskro nav man ľidžal le čačipnaskre dromenca.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kajte geľomas la dolinaha prekal o baro kaľipen,","poem":1},{"text":"na darava man le nalačhipnastar,","poem":2},{"text":"bo tu sal manca;","poem":1},{"text":"tiro prutos the tiri paca man ochraňinen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pripravines mange o skamind","poem":1},{"text":"anglo jakha mire ňeprijaťeľenge.","poem":2},{"text":"O šero mange makhes le olejoha;","poem":1},{"text":"miri kuči prečuľal.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He, ča o lačhipen the o verno kamiben man ľidžana","poem":1},{"text":"andre savore dživesa, medik dživava","poem":2},{"text":"a bešava andro kher le RAJESKRO pro furt.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}