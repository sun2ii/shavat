{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Le Davidoskro žalmos.","descriptive":true},{"text":"Le RAJESKRI hiňi e phuv the savoro, so andre hin,","poem":1},{"text":"o svetos the ola, ko andre dživen;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"se ov les zathoďa pro mori","poem":1},{"text":"a ačhaďa pro paňa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ko šaj džal upre pro verchos le RAJESKRO?","poem":1},{"text":"Ko šaj ačhel pre leskro sveto than?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oda, kaste hin o vasta ňevinna a o jilo žužo;","poem":1},{"text":"oda, ko na lašarel o modli","poem":2},{"lineBreak":true},{"text":"a ko na lel vera falošňe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Oda chudela o požehnaňje le RAJESTAR","poem":1},{"text":"the o spravodľišagos le Devlestar, leskre Spasiťeľistar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kajse hine o manuša, save les roden,","poem":1},{"text":"save roden tiro muj, Devla le Jakoboskro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Branale, phundraven tumen!","poem":1},{"text":"Phurikane vudarale, otkeren tumen,","poem":2},{"lineBreak":true},{"text":"te šaj avel andre o Kraľis la slavakro!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ko hin oda Kraľis la slavakro?","poem":1},{"text":"O RAJ, o zoralo a mocno;","poem":2},{"lineBreak":true},{"text":"o RAJ, o zoralo andro mariben.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Branale, phundraven tumen!","poem":1},{"text":"Phurikane vudarale, otkeren tumen,","poem":2},{"lineBreak":true},{"text":"te šaj avel andre o Kraľis la slavakro!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ko hin oda Kraľis la slavakro?","poem":1},{"text":"O RAJ o Nekzoraleder.","poem":2},{"lineBreak":true},{"text":"Ov hin oda Kraľis la slavakro!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}