{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Le Davidoskro žalmos.","descriptive":true},{"text":"RAJEJA, vičinav ke tute!","poem":1},{"text":"Skalo miri, prithov tiro kan ke ma!","poem":2},{"text":"Te aveha čhit, avava ajso sar ola,","poem":1},{"text":"ko džan tele andro hrobos.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Šun miro pokorno mangipen,","poem":1},{"text":"sar ke tu vičinav, hoj mange te pomožines,","poem":2},{"lineBreak":true},{"text":"a hazdav mire vasta ke tiro Neksveteder than.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ma odčhiv man het jekhetane le binošne manušenca","poem":1},{"text":"abo olenca, ko keren o nalačhipen,","poem":2},{"text":"ko vakeren avrenca šukares,","poem":1},{"text":"ale andro jile hine choľamen.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mar len vaš lengre skutki,","poem":1},{"text":"vaš lengro nalačhipen.","poem":2},{"text":"Mar len vaš oda, so kerde;","poem":1},{"text":"visar lenge pale oda, so peske zaslužinen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Se on na achaľon o skutki le RAJESKRE","poem":1},{"text":"aňi oda, so kerďa peskre vastenca.","poem":2},{"lineBreak":true},{"text":"Ov len čhivela tele","poem":2},{"lineBreak":true},{"text":"a šoha len na ačhavela pale upre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bararav tut, RAJEJA,","poem":1},{"text":"bo šunďal miro pokorno mangipen.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O RAJ hino miri zor the miro šťitos;","poem":1},{"text":"miro jilo leske pačal.","poem":2},{"text":"Ov mange pomožinďa,","poem":1},{"text":"vašoda miro jilo igen radisaľol","poem":2},{"lineBreak":true},{"text":"a mira giľaha leske paľikerava.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O RAJ hin e zor peskre manušengri;","poem":1},{"text":"o than pre ochrana peskre pomazimen kraľiske.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zachraňin tire manušen, RAJEJA!","poem":1},{"text":"Požehňin tiro ďeďictvos!","poem":2},{"lineBreak":true},{"text":"Av lengro pasťjeris pro furt!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}