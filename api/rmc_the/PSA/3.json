{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Le Davidoskro žalmos. Sar denašelas peskre čhastar le Absolonostar.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"RAJEJA, keci but džene pre mande džan!","poem":1},{"text":"Keci but pre mande aven!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"But džene pal ma phenen:","poem":1},{"text":"„O Del leske na pomožinela!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ale tu, RAJEJA, sal pašal ma sar o šťitos.","poem":1},{"text":"Sal miri slava; hazdes upre miro šero.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zorales vičinav pro RAJ","poem":1},{"text":"a ov mange odphenela pal peskro sveto verchos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pašľiľom mange, zasučom a ušťiľom,","poem":1},{"text":"bo o RAJ man ľikerel.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na darav man le but ezera manušendar,","poem":1},{"text":"so pes rozthode pašal ma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ušťi upre, RAJEJA,","poem":1},{"text":"zachraňin man, Devla miro!","poem":2},{"text":"Tu rozmares o muja savorenge, ko pre ma džan,","poem":1},{"text":"a mares avri o danda le nalačhenge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Le RAJESTAR avel o spaseňje.","poem":1},{"text":"Tiro požehnaňje mi avel pre tire manuša!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}