{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"Oleske, ko ľidžal o bašaviben. Le Davidoskro žalmos.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Bachtalo hin oda, ko gondoľinel pro čoro manuš;","poem":1},{"text":"o RAJ les lela avri andral o pharo džives.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O RAJ les ochraňinela a mukela les te dživel;","poem":1},{"text":"pre phuv les vičinena požehňimen.","poem":2},{"text":"Ma domuk le ňeprijaťeľenge,","poem":1},{"text":"hoj les te zňičinen!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O RAJ les zoraľarela, sar pašľola nasvalo pro hadžos,","poem":1},{"text":"a sasťarela les avri andral savoreste.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Phenďom: „RAJEJA, av ke ma jileskro!","poem":1},{"text":"Sasťar man avri,","poem":2},{"lineBreak":true},{"text":"bo kerďom binos anglal tu.“","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mire ňeprijaťeľa pal ma namištes vakeren:","poem":1},{"text":"„Kana imar merela?","poem":2},{"lineBreak":true},{"text":"Kana našľola leskro nav?“","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Te man avel vareko te dikhel,","poem":1},{"text":"vakerel manca falošňe,","poem":2},{"text":"andro jilo skidel o nalačhipen pre ma.","poem":1},{"text":"Paľis džal avri","poem":2},{"lineBreak":true},{"text":"a sakoneske oda vakerel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Savore, ko man našťi avri ačhen,","poem":1},{"text":"peske pal ma šepkinen andro kana","poem":2},{"lineBreak":true},{"text":"a gondoľinen peske pre ma avri o nalačhipen.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Phenen peske:","poem":1},{"text":"„Avľa pre leste o nalačho nasvaľiben;","poem":2},{"lineBreak":true},{"text":"ko kavke zapašľiľa, imar na ušťela upre.“","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mek the miro prijaťeľis, saveske pačavas,","poem":1},{"text":"savo chalas miro maro,","poem":2},{"lineBreak":true},{"text":"chudňa pre ma te džal.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ale tu, RAJEJA, av ke ma jileskro,","poem":1},{"text":"hazde man upre,","poem":2},{"lineBreak":true},{"text":"hoj lenge te visarav pale.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pal oda prindžarava,","poem":1},{"text":"hoj som tuke pre dzeka,","poem":2},{"text":"te miro ňeprijaťeľis","poem":1},{"text":"mange na radisaľola.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tu man podhazdeha,","poem":1},{"text":"bo kerav oda, so hin lačho;","poem":2},{"lineBreak":true},{"text":"thoveha man te ačhel paš tute pro furt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mi el barardo o RAJ, o Del le Izraeloskro,","poem":1},{"text":"pro furt.","poem":2},{"lineBreak":true},{"text":"Amen! Amen!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":14}