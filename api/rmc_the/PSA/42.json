{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":42,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Oleske, ko ľidžal o bašaviben. O maskil","descriptive":true},{"noteId":16},{"text":"le Korachengro.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Sar pes o jeleňis cirdel pal o paňi,","poem":1},{"text":"avke pes miri duša cirdel pal tute, Devla.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Miri duša hiňi smedno pal o Del, pal o džido Del.","poem":1},{"text":"Kana imar avava a dikhava le Devleskro muj?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O apsa mange hin sar o maro rat-džives,","poem":1},{"text":"sar mandar sako džives phučen:","poem":2},{"lineBreak":true},{"text":"„Kaj hino tiro Del?“","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Čhivav avri miro pharipen andral miri duša a leperav mange,","poem":1},{"text":"sar phiravas but manušenca,","poem":2},{"text":"sar len anavas andro kher le Devleskro","poem":1},{"text":"a giľavahas radišagoha o chvali,","poem":2},{"lineBreak":true},{"text":"sar oslavinahas o sveto inepos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Soske sal smutno, dušo miri?","poem":1},{"text":"Soske tut trapines?","poem":2},{"text":"Užar pro Del, bo mek les lašarava,","poem":1},{"text":"mire Spasiťeľis, mire Devles.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Miri duša hiňi smutno andre ma,","poem":1},{"text":"vašoda mange leperav pre tu","poem":2},{"text":"paš oda than, khatar avel avri o paňi Jordan,","poem":1},{"text":"paš o verchos Chermon, le cikneder brehostar","poem":2},{"noteId":17},{"text":".","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jekh baro paňi vičinel pre aver paš oda,","poem":1},{"text":"sar šunďol tire vodopadi;","poem":2},{"text":"savore tire vlni predžan prekal ma","poem":1},{"text":"a demen andre ma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dživese mange o RAJ bičhavel peskro verno kamiben,","poem":1},{"text":"rači hiňi manca leskri giľi,","poem":2},{"text":"e modľitba ko Del,","poem":1},{"text":"savo man del dživipen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Phenava le Devleske, mira Skalake:","poem":1},{"text":"„Soske pre ma bisterďal?","poem":2},{"text":"Soske mušinav te phirel smutno","poem":1},{"text":"anglo ňeprijaťeľis, so man trapinel?“","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sar mange mire ňeprijaťeľa dophenen,","poem":1},{"text":"dukhal man oda dži andro kokala,","poem":2},{"text":"sar mandar calo džives phučen:","poem":1},{"text":"„Kaj hino tiro Del?“","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Soske sal smutno, dušo miri?","poem":1},{"text":"Soske tut trapines?","poem":2},{"text":"Užar pro Del, bo mek les lašarava,","poem":1},{"text":"mire Spasiťeľis, mire Devles.","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"42,1 Oda šaj el: goďaver sikaviben","reference":{"chapter":42,"verse":1}},{"noteId":17,"caller":"+","text":"42,7 Abo: o verchos Micar","reference":{"chapter":42,"verse":7}}]},"thisChapterLink":"/api/rmc_the/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":12}