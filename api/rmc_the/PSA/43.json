{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Devla, sikav, hoj som čačipnaskro,","poem":1},{"text":"a zaačh vaš ma anglo bijedevleskro narodos!","poem":2},{"lineBreak":true},{"text":"Zachraňin man olendar, ko hine falošna the nalačhe!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tu sal, Devla, miro than, kaj man garuvav.","poem":1},{"text":"Soske man odčhiďal?","poem":2},{"text":"Soske mušinav te phirel smutno","poem":1},{"text":"vaš o ňeprijaťeľis, so man trapinel?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bičhav tiro švetlos the tiro čačipen,","poem":1},{"text":"hoj man te ľidžan!","poem":2},{"text":"Mi anen man pre tiro sveto verchos,","poem":1},{"text":"pre oda than, kaj tu bešes.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Avke avava paš o oltaris le Devleskro,","poem":1},{"text":"ko Del, savo mange del te radisaľol.","poem":2},{"text":"Radisaľuvava a pre harfa tut lašarava,","poem":1},{"text":"Devla, miro Devla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Soske sal smutno, dušo miri?","poem":1},{"text":"Soske tut trapines?","poem":2},{"text":"Užar pro Del, bo mek les lašarava,","poem":1},{"text":"mire Spasiťeľis, mire Devles.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}