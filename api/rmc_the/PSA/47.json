{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"Oleske, ko ľidžal o bašaviben. Le Korachengro žalmos.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Tapčinen radišagoha le vastenca, savore narodale!","poem":1},{"text":"Giľaven zorales le Devleske!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bo o RAJ, o Nekbareder, kastar kampel te daral,","poem":1},{"text":"hino baro kraľis pre caľi phuv.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Le naroden del tel amari zor","poem":1},{"text":"a avre manušen amenge thovel tel o pindre.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kidňa amenge avri e phuv,","poem":1},{"text":"andre savi thovel baripen o Jakob,","poem":2},{"lineBreak":true},{"text":"saves o Del kamel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O Del geľa upre, sar o manuša radišagoha viskinenas;","poem":1},{"text":"sar šunďolas o hangos la trubakro, geľa upre o RAJ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Giľaven o chvali le Devleske, giľaven!","poem":1},{"text":"Giľaven o chvali amare kraľiske, giľaven!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Se o Del hino kraľis pre caľi phuv;","poem":1},{"text":"lašaren les le žalmenca.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O Del kraľinel upral o narodi,","poem":1},{"text":"o Del bešel pre peskro sveto tronos.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"O raja le manušengre pes zgele","poem":1},{"text":"le Abrahamoskre Devleskre manušenca,","poem":2},{"text":"bo le Devleskre hine savore šťiti la phuvakre.","poem":1},{"text":"Ov hino igen barardo!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}