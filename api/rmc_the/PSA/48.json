{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":48,"content":[{"type":"verse","number":1,"content":[{"text":"E giľi. Le Korachengro žalmos.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Baro hino o RAJ a hodno bara chvalake","poem":1},{"text":"andro foros amare Devleskro pre leskro sveto verchos.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Učo hino a šukar o verchos Sion,","poem":1},{"text":"anel o radišagos caľa phuvake,","poem":2},{"lineBreak":true},{"text":"hino sar o uče verchi le Cafonoskre","poem":2},{"noteId":21},{"text":", o foros le bare Kraľiskro.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O Del hino andre leskre palaca,","poem":1},{"text":"ov pes sikaďa sar le Sionoskri ochrana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O kraľa pes zgele,","poem":1},{"text":"avle jekhetane pro Sion,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"no sar les dikhle, predaranďile","poem":1},{"text":"a denašle daratar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Chudle te izdral,","poem":1},{"text":"dukhalas len avke sar la džuvľa akor,","poem":2},{"lineBreak":true},{"text":"sar lake uľol o čhavoro.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Izdranas avke sar o loďi andral o Taršiš,","poem":1},{"text":"sar lenca e balvaj pal o vichodos razinďa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Šunďam oda, so o Del kerelas, ale akana oda the dikhľam","poem":1},{"text":"andro foros le Nekbareder RAJESKRO,","poem":2},{"lineBreak":true},{"text":"andro foros amare Devleskro:","poem":2},{"lineBreak":true},{"text":"O Del les chraňinela pro furt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Andre tiro Chramos gondoľinas","poem":1},{"text":"pal tiro verno kamiben, Devla.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Avke sar tiro nav, Devla,","poem":1},{"text":"avke the tiri chvala džal dži pro agor le svetoske;","poem":2},{"lineBreak":true},{"text":"tiro čačo vast hino pherdo spravodľišagos.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"O verchos Sion thovel baripen,","poem":1},{"text":"o gavora","poem":2},{"noteId":22},{"text":"andral e Judsko radisaľon","poem":2},{"lineBreak":true},{"text":"olestar, sar mištes sudzines.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Predžan pašal o Sion!","poem":1},{"text":"Predžan a zrachinen leskre veži!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dikhen mištes, save zorale muri les hin!","poem":1},{"text":"Prephiren tumen pal leskre hradi,","poem":2},{"lineBreak":true},{"text":"hoj te šaj vakeren olenge, ko avena pal tumende.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bo kada Del hino amaro Del pro furt;","poem":1},{"text":"ov amen ľidžala, medik dživaha.","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"48,3 O Cafon sas o sveto verchos andro Kanaan.","reference":{"chapter":48,"verse":3}},{"noteId":22,"caller":"+","text":"48,12 E hebrejiko čhib: o čhaja","reference":{"chapter":48,"verse":12}}]},"thisChapterLink":"/api/rmc_the/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":15}