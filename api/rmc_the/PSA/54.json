{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Oleske, ko ľidžal o bašaviben pro strunengro nastrojis. O maskil","descriptive":true},{"noteId":26},{"text":"le Davidoskro,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"so pisinďa, sar avle o Zifančana a phende le Sauloske: „O David pes garuvel ke amende.“","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Zachraňin man, Devla, tire naveha","poem":1},{"text":"a sikav tira zoraha, hoj som čačipnaskro.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Šun miro mangipen, Devla!","poem":1},{"text":"Prithov o kan paš o lava mire mujeskre!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Avle pre ma o cudzinci;","poem":1},{"text":"kamen man te murdarel o bijileskre murša,","poem":2},{"lineBreak":true},{"text":"so na den pačiv le Devles.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ale dikh, o Del mange pomožinel!","poem":1},{"text":"O Raj hino olenca, ko zaačhen vaš ma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mi visarel o Del o nalačhipen pale pre ola, ko pre ma džan!","poem":1},{"text":"Ov len zňičinela, bo hino verno!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Radišagoha tuke anava e obeta","poem":1},{"text":"a paľikerava tire naveske, RAJEJA, bo hino lačho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bo tu man zachraňinďal dojekhe pharipnastar","poem":1},{"text":"a pre mire jakha dikhľom mire ňeprijaťeľen, sar peren tele.","poem":2}]}],"footnotes":[{"noteId":26,"caller":"+","text":"54,1 Oda šaj el: goďaver sikaviben","reference":{"chapter":54,"verse":1}}]},"thisChapterLink":"/api/rmc_the/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}