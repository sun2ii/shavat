{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"Oleske, ko ľidžal o bašaviben pro strunengro nastrojis. Le Davidoskro žalmos.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Devla, šun miro roviben,","poem":1},{"text":"odphen pre miro mangipen!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pal o koňec la phuvakro pre tute vičinav","poem":1},{"text":"igen strapimen jileha.","poem":2},{"text":"Ľidža man upre pre skala,","poem":1},{"text":"so hiňi učeder sar me.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Se tu sal miro than, kaj man garuvav,","poem":1},{"text":"miri zoraľi veža anglo ňeprijaťeľa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Joj, te bešľomas andre tiro stanos pro furt","poem":1},{"text":"a te šaj man garuďomas andro ciňos tire kridlengro!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Devla, tu šunďal o lava, save tut diňom;","poem":1},{"text":"diňal man o ďeďictvos,","poem":2},{"lineBreak":true},{"text":"so patrinel olenge,","poem":2},{"lineBreak":true},{"text":"ko pes daran tire navestar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dothov buter dživesa ko dživesa le kraľiskre","poem":1},{"text":"a mi ľikeren leskre berša pal jekh pokoleňje pre aver!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mi bešel pro tronos anglo Del pro furt!","poem":1},{"text":"De, hoj les te chraňinel o verno kamiben the e vernosť.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Avke giľavava o chvali tire naveske pro furt","poem":1},{"text":"a obetinava tuke sako džives, avke sar tut diňom lav!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}