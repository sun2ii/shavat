{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":62,"content":[{"type":"verse","number":1,"content":[{"text":"Le Jedutunoske, savo ľidžal o bašaviben. Le Davidoskro žalmos.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ča andro Del arakhel miri duša o smirom;","poem":1},{"text":"lestar avel miro spaseňje.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ča ov hin miri skala,","poem":1},{"text":"miro spaseňje the miro hrados,","poem":2},{"lineBreak":true},{"text":"ňič manca na čhalavela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mek dži kana pre mande džana?","poem":1},{"text":"Savore man daraven avri,","poem":2},{"lineBreak":true},{"text":"hoj man čhivena tele sar e fala, so maj perel tele,","poem":2},{"lineBreak":true},{"text":"sar o muros, so šaj visaľol avri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ča pal oda vakeren,","poem":1},{"text":"sar man te cirdel tele pal o učo than.","poem":2},{"lineBreak":true},{"text":"Rado dikhen o klamišagos;","poem":2},{"text":"le vuštenca žehňinen,","poem":1},{"text":"ale le jilenca prekošen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ča andro Del arakhel miri duša o smirom,","poem":1},{"text":"ča pre leste man mukav.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ča ov hin miri skala,","poem":1},{"text":"miro spaseňje the miro hrados,","poem":2},{"lineBreak":true},{"text":"ňič manca na čhalavela.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O Del man spasinel a del man pačiv.","poem":1},{"text":"O Del hin miri zoraľi skala a miro than, kaj man garuvav.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Manušale, muken tumen pre leste andre dojekh časos,","poem":1},{"text":"čhiven avri anglal leste o trapišagi andral tumare jile!","poem":2},{"lineBreak":true},{"text":"Bo o Del hin amaro than, kaj pes garuvas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Savore manuša hine ča balvajori,","poem":1},{"text":"na mon ňič.","poem":2},{"text":"Te len thoďahas pro vahi,","poem":1},{"text":"ulehas lokeder sar thuv.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ma muken tumen pro love, so lena avre manušenge,","poem":1},{"text":"aňi pre oda, so čorena avrenge;","poem":2},{"text":"te tuke barol o barvaľipen,","poem":1},{"text":"ma prithov paš oda o jilo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jekhvar prevakerďa o Del,","poem":1},{"text":"duj veci achaľiľom:","poem":2},{"text":"Tiri hiňi e zor, Devla,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"a tiro hin o verno kamiben, RAJEJA!","poem":2},{"text":"Tu čačes počineha sakoneske","poem":1},{"text":"pal oda, sar kerel.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":13}