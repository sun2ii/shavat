{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"Oleske ko ľidžal o bašaviben pro strunengro nastrojis. O žalmos. E giľi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Devla, av ke amende jileskro","poem":1},{"text":"a požehňin amen,","poem":2},{"lineBreak":true},{"text":"mi švicinel pre amende tiro muj!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mi prindžarel pes tiro drom pal caľi phuv","poem":1},{"text":"a tiro spaseňje maškar savore narodi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mi bararen tut, Devla, o manuša,","poem":1},{"text":"mi bararen tut savore manuša!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mi thoven baripen o narodi","poem":1},{"text":"a mi giľaven tuke radišagostar,","poem":2},{"text":"bo tu len sudzines čačipnaha","poem":1},{"text":"a ľidžas le naroden pre phuv.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mi bararen tut, Devla, o manuša,","poem":1},{"text":"mi bararen tut savore manuša!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E phuv diňa avri peskro uľipen,","poem":1},{"text":"o Del, amaro Del, amenge žehňinel.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mi žehňinel amenge o Del,","poem":1},{"text":"hoj pes lestar te daran pal caľi phuv!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}