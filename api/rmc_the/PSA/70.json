{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"Oleske, ko ľidžal o bašaviben. Le Davidoskro žalmos. Pro leperiben.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Devla, zachraňin man!","poem":1},{"text":"RAJEJA, siďar mange te pomožinel!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mi ladžan pes a mi ľoľon avri savore,","poem":1},{"text":"ko mange kamen te lel o dživipen.","poem":2},{"text":"Mi visaren pes pale ladžaha ola,","poem":1},{"text":"ko mange žičinen o trapišagos.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mi visaren pes pale ladžaha ola,","poem":1},{"text":"ko mange phenen: „Avke tuke kampel!“","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mi radisaľon a mi thoven baripen andre tu savore,","poem":1},{"text":"ko tut roden.","poem":2},{"lineBreak":true},{"text":"Ola, ko kamen tiro spaseňje, furt mi phenen:","poem":2},{"lineBreak":true},{"text":"„O Del hino baro!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ale me som čoro a slabo,","poem":1},{"text":"Devla miro, siďar paš ma!","poem":2},{"text":"Tu sal miri pomoca, miro zachrancas.","poem":1},{"text":"RAJEJA, av sig!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}