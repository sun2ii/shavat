{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":75,"content":[{"type":"verse","number":1,"content":[{"text":"Oleske, ko ľidžal o bašaviben pro giľavipen: „Ma zňičin!“ Le Asafoskro žalmos.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Lašaras tut, Devla,","poem":1},{"text":"lašaras tut, bo tiro nav hino pašes;","poem":2},{"text":"o manuša vakeren pal tire zazraki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tu phenes: „Andro časos, so diňom,","poem":1},{"text":"sudzinava spravodľišagoha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sar e phuv le manušenca razisaľol,","poem":1},{"text":"me som oda, ko ľikerel zorales lakre zakladi.“","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Phenav le lašardenge: „Ma lašaren tumen!“","poem":1},{"text":"Le nalačhenge: „Ma hazden tumen","poem":2},{"noteId":39},{"text":"upre!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ma hazden tumen upre pro ňebos,","poem":1},{"text":"ma vakeren avke barikanes!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aňi pal o vichodos, aňi pal o zapados,","poem":1},{"text":"aňi pal e pušťa, ňiko pes našťi ľidžal upre,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"bo ča o Del hino sudcas:","poem":1},{"text":"Jekhes dikhel tele a avres hazdel upre.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bo andre le RAJESKRO vast hin e kuči","poem":1},{"text":"pherdžarďi la koreňimen moľaha, so peňinel;","poem":2},{"text":"ov la čhivel avri","poem":1},{"text":"a pijena latar savore nalačhe manuša pre phuv,","poem":2},{"lineBreak":true},{"text":"pijena avri dži e posledno kapka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ale me furt vakerava pal tute,","poem":1},{"text":"giľavava o chvali tuke, Devla le Jakoboskro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"O Del phenel: „Odčhinava savori zor","poem":1},{"noteId":40},{"text":"le nalačhe manušengri","poem":1},{"text":"a hazdela pes upre e zor le spravodľive manušengri.“","poem":2}]}],"footnotes":[{"noteId":39,"caller":"+","text":"75,5 E hebrejiko čhib: tumare rohi","reference":{"chapter":75,"verse":5}},{"noteId":40,"caller":"+","text":"75,11 E hebrejiko čhib: savore rohi","reference":{"chapter":75,"verse":11}}]},"thisChapterLink":"/api/rmc_the/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}