{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"Le Asafoskro žalmos.","descriptive":true},{"text":"O Del pes ačhaďa maškar o ňeboskro sudos,","poem":1},{"text":"sudzinel maškar o „devla“:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"„Dži kana kamen te sudzinel načačipnaha","poem":1},{"text":"a te ľikerel paš o nalačhe?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zaačhen vaš o slaba the široti!","poem":1},{"text":"Sikaven o čačipen le čore the trapimen manušengro!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Chraňinen le slabes the le čores,","poem":1},{"text":"cirden les avri andral o vasta le nalačhe manušenge!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tumen na džanen, aňi na achaľon;","poem":1},{"text":"phiren andro kaľipen","poem":2},{"text":"a savore zakladi la phuvakre razisaľon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Me phenďom: ‚San devla,","poem":1},{"text":"savore san o čhave le Nekbaredereskre.‘","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ale merena avke sar the aver manuša,","poem":1},{"text":"perena tele avke sar savore aver vladci.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ušťi, Devla, sudzin e phuv!","poem":1},{"text":"Se savore narodi hine tiro ďeďictvos!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}