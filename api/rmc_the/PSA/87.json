{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"Le Korachengro žalmos. E giľi.","descriptive":true},{"text":"O RAJ ačhaďa peskro foros pro sveto verchos.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"O RAJ kamel buter o brani le Sionoskre","poem":2},{"lineBreak":true},{"text":"sar savore khera le Jakoboskre.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bare šukar lava pal tu vakeren,","poem":1},{"text":"forona le Devleskro!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Maškar ola, ko man prindžaren, rachinava le Egipt","poem":1},{"noteId":44},{"text":", le Babilon,","poem":1},{"text":"le Tir, le Kuš the le Filišťincen.","poem":2},{"lineBreak":true},{"text":"Pal lende pes vakerela: „Kade uľile.“","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pal o Sion pes phenela:","poem":1},{"text":"„Kada the koda uľiľa kode","poem":2},{"lineBreak":true},{"text":"a korkoro o Nekbareder oda foros zoraľarďa.“","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sar o RAJ zapisinela le naroden, phenela: „Kada uľiľa andro Sion.“","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A khelena a giľavena:","poem":2},{"lineBreak":true},{"text":"„Andre tu hin savore prameňa, khatar aven mire požehnaňja.“","poem":2}]}],"footnotes":[{"noteId":44,"caller":"+","text":"87,4 E hebrejiko čhib: le Rahab","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/rmc_the/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}