{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"O RAJ kraľinel, urďa pre peste o šukariben;","poem":1},{"text":"o RAJ pes urďa a phandľa pašal peste e zor.","poem":2},{"lineBreak":true},{"text":"He, o svetos zathoďa zorales, na čhalavela pes.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tiro tronos hino zathodo imar čirlastar,","poem":1},{"text":"tu salas furt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O paňa pes hazdle upre, RAJEJA,","poem":1},{"text":"o paňa hazdle upre peskro hangos,","poem":2},{"lineBreak":true},{"text":"hazdle peskre vlni a hučinen.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zoraleder sar e vika le bare paňengri,","poem":1},{"text":"zoraleder sar o bare vlni le moroskre,","poem":2},{"lineBreak":true},{"text":"hin o RAJ pro ňebos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tire zakoni pes šoha na čerinen,","poem":1},{"text":"tiro chramos, RAJEJA, hino sveto pro furt.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}