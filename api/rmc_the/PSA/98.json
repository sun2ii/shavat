{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"PSA","translationId":"rmc_the","name":"Žalmi","commonName":"Žalmi","title":"O Žalmi","order":19,"numberOfChapters":150,"sha256":"ced48bac6b71e309fdb51208b2226b73e5b094e1a5a8b65d3cbbe736e3e9da1f","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rmc_the/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":98,"content":[{"type":"verse","number":1,"content":[{"text":"Žalmos.","descriptive":true},{"text":"Giľaven le RAJESKE nevi giľi,","poem":1},{"text":"bo kerďa o zazraki.","poem":2},{"text":"Leskro čačo vast the leskro sveto valos","poem":1},{"text":"leske ande o viťazstvo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O RAJ diňa te džanel le narodenge peskro spaseňje","poem":1},{"text":"a sikaďa lenge peskro spravodľišagos.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Leperďa peske pre peskro verno kamiben","poem":1},{"text":"a pre peskri vernosť ko Izrael;","poem":2},{"text":"savore agora la phuvakre","poem":1},{"text":"dikhle o spaseňje amare Devleskro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Giľaven radišagoha le RAJESKE, caľi phuv!","poem":1},{"text":"Chuden te radisaľol a te giľavel!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Giľaven le RAJESKE la harfaha,","poem":1},{"text":"mi šunďol o giľavipen la harfaha!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Phurden pro trubi the pro bakrane rohi!","poem":1},{"text":"Vičinen radišagoha anglo RAJ, anglo Kraľis!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mi hučinel o moros the savoro, so andre hin,","poem":1},{"text":"o svetos a the ola, ko andre bešen!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O paňa mi tapčinen le vastenca;","poem":1},{"text":"o verchi mi giľaven jekhetane radišagoha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mi giľaven anglo RAJ, bo avel te sudzinel e phuv.","poem":1},{"lineBreak":true},{"text":"Ov sudzinela čačipnaha o svetos","poem":1},{"text":"a le manušen spravodľišagoha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rmc_the/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}