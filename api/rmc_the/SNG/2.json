{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"SNG","translationId":"rmc_the","name":"Nekšukareder giľi","commonName":"Nekšukareder giľi","title":"E Nekšukareder giľi","order":22,"numberOfChapters":8,"sha256":"a58ebbb89b4aa18dbd237c202ff1f72ba888fb070b2d7628de2f8d28a460d489","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/rmc_the/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Me som ča e kvitka andro Šaron,","poem":1},{"lineBreak":true},{"text":"ča e ľaľija, so barol andre dolina.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Sar e ľaľija maškar o koľaka,","poem":1},{"lineBreak":true},{"text":"ajsi hiňi miri laska maškar o terne čhaja.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Sar o lačho phabengro stromos","poem":1},{"lineBreak":true},{"text":"maškar o stromi andro veš,","poem":1},{"lineBreak":true},{"text":"ajso hin oda, ko man kamel,","poem":1},{"lineBreak":true},{"text":"feder sar savore terne čhave.","poem":1},{"lineBreak":true},{"text":"Igen kamavas te bešel andre leskro ciňos","poem":1},{"lineBreak":true},{"text":"a leskro ovocje hino gulo andre miro muj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Domukľa mange te pijel peskri kamibnaskri mol","poem":1},{"noteId":0},{"text":",","poem":1},{"lineBreak":true},{"text":"leskro kamiben sas upral mande sar e zastava.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Občerstvinen man le hrozienkenca!","poem":1},{"lineBreak":true},{"text":"Zoraľaren man le phabenca,","poem":1},{"lineBreak":true},{"text":"bo som nasvaľi le kamibnastar!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Leskro baľogno vast hin tel miro šero","poem":1},{"lineBreak":true},{"text":"a peskre čače vasteha man obchudel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Den man lav,","poem":1},{"lineBreak":true},{"text":"čhajale andral o Jeruzalem,","poem":1},{"lineBreak":true},{"text":"anglo srnki the anglo gazeli!","poem":1},{"lineBreak":true},{"text":"Ma čhalaven amaro kamiben,","poem":1},{"lineBreak":true},{"text":"medik o kamiben korkoro na kamela.","poem":1}]},{"type":"heading","content":["Dujto giľi"]},{"type":"verse","number":8,"content":[{"text":"Šunav o hangos oleskro, ko man kamel!","poem":1},{"lineBreak":true},{"text":"Dikh, avel kade!","poem":1},{"lineBreak":true},{"text":"Chučkerel pal o verchi a denašel pal o brehi;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"hino sar e gazela, sar o terno jeleňis.","poem":1},{"lineBreak":true},{"text":"Dikh, kade ačhel pal amaro muros;","poem":1},{"lineBreak":true},{"text":"dikhel andre prekal o oblaki, zadikhel prekal o mreži.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Prevakerďa ke ma oda, ko man kamel:","poem":1},{"lineBreak":true},{"text":"„Ušťi upre, lasko miri,","poem":1},{"lineBreak":true},{"text":"av, miri šukarori!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dikh, o jevend imar pregeľa;","poem":1},{"lineBreak":true},{"text":"o brišind preačhiľa, geľa het.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O kvitki aven avri pre phuv!","poem":1},{"lineBreak":true},{"text":"Avľa o časos pro giľavipen!","poem":1},{"lineBreak":true},{"text":"O hangos la hrdličkakro","poem":1},{"lineBreak":true},{"text":"šunďol andre amari phuv.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Pro figovňikos barol o terne figi,","poem":1},{"lineBreak":true},{"text":"o viňici kvitňisaľon a šukares voňinen.","poem":1},{"lineBreak":true},{"text":"Ušťi upre, lasko miri,","poem":1},{"lineBreak":true},{"text":"av, miri šukarori!“","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Holubico miri,","poem":1},{"lineBreak":true},{"text":"garuďi sal andre chev andre skala,","poem":1},{"lineBreak":true},{"text":"andre skalakri škara.","poem":1},{"lineBreak":true},{"text":"Sikav mange tiro muj","poem":1},{"lineBreak":true},{"text":"a domuk mange te šunel tiro hangos;","poem":1},{"lineBreak":true},{"text":"bo mištes šunďol tiro hangos","poem":1},{"lineBreak":true},{"text":"a šukar hin tiro muj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chuden amenge le lišken","poem":1},{"noteId":1},{"text":",","poem":1},{"lineBreak":true},{"text":"le cikne lišken, so musaren o viňici,","poem":1},{"lineBreak":true},{"text":"amare viňici, so imar kvitňisaľon.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Oda, ko man kamel,","poem":1},{"lineBreak":true},{"text":"hino miro a me som leskri;","poem":1},{"lineBreak":true},{"text":"čaľarel pes maškar o ľaľije.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Medik na predžal o džives","poem":1},{"lineBreak":true},{"text":"a o ciňos na našľol,","poem":1},{"lineBreak":true},{"text":"visaľuv pale, tu, so man kames,","poem":1},{"lineBreak":true},{"text":"av ajso sar e gazela,","poem":1},{"lineBreak":true},{"text":"sar o terno jeleňis pro Beterska verchi","poem":1},{"noteId":2},{"text":".","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"2,4 E hebrejiko čhib: Anďa man andro kher la moľakro.","reference":{"chapter":2,"verse":4}},{"noteId":1,"caller":"+","text":"2,15 Kade šaj džal pal aver murša, so tiš kamen ola terňa džuvľa.","reference":{"chapter":2,"verse":15}},{"noteId":2,"caller":"+","text":"2,17 Kada hin o verchi rozďelimen pro duj.","reference":{"chapter":2,"verse":17}}]},"thisChapterLink":"/api/rmc_the/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}