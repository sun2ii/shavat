{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"SNG","translationId":"rmc_the","name":"Nekšukareder giľi","commonName":"Nekšukareder giľi","title":"E Nekšukareder giľi","order":22,"numberOfChapters":8,"sha256":"a58ebbb89b4aa18dbd237c202ff1f72ba888fb070b2d7628de2f8d28a460d489","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/rmc_the/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Pre miro hadžos račenca rodavas oles,","poem":1},{"lineBreak":true},{"text":"kas kamel miri duša.","poem":1},{"lineBreak":true},{"text":"Rodavas les, ale na arakhľom.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"No ča uščav a predžav man pal o foros;","poem":1},{"lineBreak":true},{"text":"pro uľici the pro pľacos rodava oles,","poem":1},{"lineBreak":true},{"text":"kas kamel miro jilo;","poem":1},{"lineBreak":true},{"text":"rodavas les, ale na arakhľom.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Arakhle man o stražňika, save phiren pal o foros.","poem":1},{"lineBreak":true},{"text":"Phučľom lendar: „Na dikhľan oles, kas kamel miro jilo?“","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Soča lendar odgeľom,","poem":1},{"lineBreak":true},{"text":"arakhľom oles, kas kamel miro jilo.","poem":1},{"lineBreak":true},{"text":"Chudňom les a na mukľom,","poem":1},{"lineBreak":true},{"text":"medik les na anďom andre mira dakro kher,","poem":1},{"lineBreak":true},{"text":"andre oda kher, kaj man miri daj anďa pro svetos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Den man lav,","poem":1},{"lineBreak":true},{"text":"čhajale andral o Jeruzalem,","poem":1},{"lineBreak":true},{"text":"anglo srnki the anglo gazeli!","poem":1},{"lineBreak":true},{"text":"Ma čhalaven a ma uštaven o kamiben,","poem":1},{"lineBreak":true},{"text":"medik o kamiben korkoro na kamela.","poem":1}]},{"type":"heading","content":["Trito giľi"]},{"type":"verse","number":6,"content":[{"text":"So hin oda, so avel pal e pušťa sar o slupi le thuvestar,","poem":1},{"lineBreak":true},{"text":"sar o parfumos andral e mirha the kaďidlos,","poem":1},{"lineBreak":true},{"text":"savore koreňjendar le kupcendar?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dikh, le Šalamunoskro tronos!","poem":1},{"lineBreak":true},{"text":"Pašal leste šovardeš zorale murša,","poem":1},{"lineBreak":true},{"text":"nekfeder murša andral o Izrael.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Savore pes džanen te marel le šabľenca;","poem":1},{"lineBreak":true},{"text":"dojekh hino avrisikado pro mariben;","poem":1},{"lineBreak":true},{"text":"paš sakoneste hin e šabľa,","poem":1},{"lineBreak":true},{"text":"hoj te ochraňinel le utokendar rači.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O kraľis Šalamun peske kerďa tronos","poem":1},{"noteId":3},{"lineBreak":true},{"text":"le kaštestar andral o Libanon.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O slupici kerďa rupune,","poem":1},{"lineBreak":true},{"text":"o operadlos kerďa somnakuno,","poem":1},{"lineBreak":true},{"text":"o šedziskos fijalovo,","poem":1},{"lineBreak":true},{"text":"obthodo andral le kamibnaha","poem":1},{"noteId":4},{"lineBreak":true},{"text":"le Jeruzalemoskre čhajendar","poem":1},{"noteId":5},{"text":".","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aven avri, čhajale le Sionoskre,","poem":1},{"lineBreak":true},{"text":"dikhen pro kraľis Šalamun,","poem":1},{"lineBreak":true},{"text":"pre koruna, so leske thoďa e daj pro šero,","poem":1},{"lineBreak":true},{"text":"andre oda džives, sar leske sas o bijav,","poem":1},{"lineBreak":true},{"text":"oda džives, sar leske radisaľolas o jilo.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"3,9 Oda sas tronos, so pes del te preľidžal.","reference":{"chapter":3,"verse":9}},{"noteId":4,"caller":"+","text":"3,10 Abo: le ebenoskre kaštestar","reference":{"chapter":3,"verse":10}},{"noteId":5,"caller":"+","text":"3,10 Abo: Čhajale andral o Jeruzalem","reference":{"chapter":3,"verse":10}}]},"thisChapterLink":"/api/rmc_the/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}