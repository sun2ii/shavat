{"translation":{"id":"rmc_the","name":"Le Devleskero Lav Andre Romaňi Čhib, Slovensko 2022","website":"https://ebible.org/Scriptures/details.php?id=rmc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmc","licenseNotes":null,"shortName":"THE","englishName":"Eastern Slovak Romani Bible","language":"rmc","textDirection":"ltr","sha256":"4df2ed870da79042c7d473210bbd86b3b3349e0f8a88e8825c1d06057f90e3ca","availableFormats":["json"],"listOfBooksApiLink":"/api/rmc_the/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31089,"languageName":"Carpathian Romani","languageEnglishName":"Carpathian Romani"},"book":{"id":"SNG","translationId":"rmc_the","name":"Nekšukareder giľi","commonName":"Nekšukareder giľi","title":"E Nekšukareder giľi","order":22,"numberOfChapters":8,"sha256":"a58ebbb89b4aa18dbd237c202ff1f72ba888fb070b2d7628de2f8d28a460d489","firstChapterNumber":1,"firstChapterApiLink":"/api/rmc_the/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/rmc_the/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Avľom andre miri zahrada,","poem":1},{"lineBreak":true},{"text":"pheňe miri, terňije miri,","poem":1},{"lineBreak":true},{"text":"obkidav miri mirha the miro koreňje;","poem":1},{"lineBreak":true},{"text":"koštoľinav mire medostar,","poem":1},{"lineBreak":true},{"text":"pijav miri mol the miro thud.","poem":1},"O džuvľa",{"text":"Chan, mire prijaťeľale, pijen,","poem":1},{"lineBreak":true},{"text":"mačon le kamibnastar.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Me sovavas, ale miro jilo sas upre.","poem":1},{"lineBreak":true},{"text":"Šun! Oda, kas kamav, durkinďa.","poem":1},"O murš",{"text":"Phundrav mange,","poem":1},{"lineBreak":true},{"text":"pheňe miri, lasko miri,","poem":1},{"lineBreak":true},{"text":"holubico miri, nane pre tu chiba!","poem":1},{"lineBreak":true},{"text":"Pro šero man hin pherdo rosa,","poem":1},{"lineBreak":true},{"text":"o bala mange cinďile la račakra molhatar.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"E rokľa čhiďom tele!","poem":1},{"lineBreak":true},{"text":"Pale la urava?","poem":1},{"lineBreak":true},{"text":"O pindre žužarďom le paňeha.","poem":1},{"lineBreak":true},{"text":"Pale len meľarava?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Oda, kas kamav,","poem":1},{"lineBreak":true},{"text":"nacirdňa peskro vast, hoj te phundravel o vudar,","poem":1},{"lineBreak":true},{"text":"a miro jilo pes andre mande čhalaďa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ušťiľom upre te phundravel oleske, kas kamav,","poem":1},{"lineBreak":true},{"text":"a mire vastendar čuľalas e mirha,","poem":1},{"lineBreak":true},{"text":"prekal o angušta mange prečuľalas","poem":1},{"lineBreak":true},{"text":"pre kľamka pro vudar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Phundraďom oleske, kas kamav,","poem":1},{"lineBreak":true},{"text":"ale ov ode imar na sas, geľa het.","poem":1},{"lineBreak":true},{"text":"Ačhiľom smutno","poem":1},{"noteId":6},{"text":",","poem":1},{"lineBreak":true},{"text":"rodavas les, ale našťi les arakhľom;","poem":1},{"lineBreak":true},{"text":"vičinavas pre leste,","poem":1},{"lineBreak":true},{"text":"ale na odphenelas mange.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Arakhle man o stražňika,","poem":1},{"lineBreak":true},{"text":"sar phirenas pal o foros.","poem":1},{"lineBreak":true},{"text":"Marde man, dukhade man,","poem":1},{"lineBreak":true},{"text":"ile pal ma tele the o plašťos","poem":1},{"lineBreak":true},{"text":"ola, ko stražinen o muros.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Den man lav,","poem":1},{"lineBreak":true},{"text":"čhajale andral o Jeruzalem:","poem":1},{"lineBreak":true},{"text":"Te arakhena oles, kas kamav,","poem":1},{"lineBreak":true},{"text":"so leske phenena?","poem":1},{"lineBreak":true},{"text":"Phenen leske, hoj som nasvaľi le kamibnastar!","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Soha hino feder oda, kas kames, avrendar,","poem":1},{"lineBreak":true},{"text":"tu, nekšukareder maškar o džuvľija?","poem":1},{"lineBreak":true},{"text":"Soha hino feder oda, kas kames, avrendar,","poem":1},{"lineBreak":true},{"text":"hoj tut mušinas te del ajso lav?","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Oda, kas me kamav, hino šukar, lolečhamengro,","poem":1},{"lineBreak":true},{"text":"feder sar deš ezera aver.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Leskro šero hino ajso šukar sar o žužo somnakaj;","poem":1},{"lineBreak":true},{"text":"leskre bala hine kučerava, kale sar o havranos;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"leskre jakha hine sar o holubici paš o paňa,","poem":1},{"lineBreak":true},{"text":"avrithode (avrimorde) andro thud,","poem":1},{"lineBreak":true},{"text":"zathode sar o drahokami.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Leskre čhama hine sar e zahrada,","poem":1},{"lineBreak":true},{"text":"kaj barol pherdo koreňja;","poem":1},{"lineBreak":true},{"text":"leskre vušta hine sar o ľaľije;","poem":1},{"lineBreak":true},{"text":"kvapkinel lendar e mirha.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Leskre vasta hin o somnakune paci,","poem":1},{"lineBreak":true},{"text":"obthode le vzacne barenca;","poem":1},{"lineBreak":true},{"text":"leskro ťelos hin e hladko slonovina","poem":1},{"lineBreak":true},{"text":"šukaľardi le zafirenca.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Leskre pindre hin o slupi le parne mramoristar","poem":1},{"lineBreak":true},{"text":"ačhade pro somnakune podstavci.","poem":1},{"lineBreak":true},{"text":"Dičhol avri sar o verchi andro Libanon,","poem":1},{"lineBreak":true},{"text":"učo sar o cedri.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Leskre vušta hine igen gule;","poem":1},{"lineBreak":true},{"text":"savoreha man pricirdel.","poem":1},{"lineBreak":true},{"text":"Ajso hino oda, kas kamav, ajso hino miro prijaťeľis,","poem":1},{"lineBreak":true},{"text":"čhajale andral o Jeruzalem!","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"5,6 Na džanel pes, so phenel e hebrejiko čhib; oda šaj el the: „sar ov vakerelas.“","reference":{"chapter":5,"verse":6}}]},"thisChapterLink":"/api/rmc_the/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmc_the/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmc_the/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}