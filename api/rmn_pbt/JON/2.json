{"translation":{"id":"rmn_pbt","name":"Библия опэр крымски романи чиб","website":"https://ebible.org/Scriptures/details.php?id=rmn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmn","licenseNotes":null,"shortName":"PBT","englishName":"Balkan Romani Bible portions","language":"rmn","textDirection":"ltr","sha256":"a251d3560ca479370f857d886f1268a581197fba126cd77b125cb33406c73e0d","availableFormats":["json"],"listOfBooksApiLink":"/api/rmn_pbt/books.json","numberOfBooks":5,"totalNumberOfChapters":110,"totalNumberOfVerses":3813,"languageName":"Balkan Romani","languageEnglishName":"Balkan Romani"},"book":{"id":"JON","translationId":"rmn_pbt","name":"Э книжка э прарокески Ионаски","commonName":"Э книжка э прарокески Ионаски","title":"Э книжка э прарокески Ионаски","order":32,"numberOfChapters":4,"sha256":"4868741199c4f73f4141841a760831ddbb4fa4facd83aac46bc4b30f45a5ecf1","firstChapterNumber":1,"firstChapterApiLink":"/api/rmn_pbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/rmn_pbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["О Иона мангел э Дэвлэс"]},{"type":"verse","number":1,"content":["О Сагбус о Яхвэ бичялдяс барэ мачес, тай ов накхавдяс э Ионас. О Иона сас андэ маческо пэр трин дес тай трин ратя."]},{"type":"verse","number":2,"content":["Кана сас андэ маческо пэр, о Иона мангелас пэ Дэвлэс э Яхвэс."]},{"type":"verse","number":3,"content":["Ов пхэнляс:",{"text":"— Андэ хурлуки мэ манглём э Сагбус э Яхвэс ,","poem":1},{"text":"тай Ов пхэнляс манги.","poem":3},{"text":"Андар хорипэ ко дюняс ки мулэнго","poem":1},{"noteId":0},{"text":"мэ динём бэбэря —","poem":3},{"lineBreak":true},{"text":"тай Ту шунлян ми бэбэря.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ту читян ман андэ хорипэ,","poem":1},{"text":"андэ ило ки панеско;","poem":3},{"lineBreak":true},{"text":"агорадылар ман о паня.","poem":3},{"text":"Алаи Тэ кубукенги паня","poem":1},{"text":"накхлэ опрал мандэ.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Мэ пхэнлём:","poem":1},{"text":"«Кувдимэ мэ Тэ якхендар;","poem":3},{"lineBreak":true},{"text":"ай мэ генэ кан дикхав о шужо храми Тинро».","poem":3}]},{"type":"verse","number":6,"content":[{"text":"О паня учярдэ ман,","poem":1},{"text":"о хорипэ агорады ман,","poem":3},{"lineBreak":true},{"text":"тай э панески чяря колисаилэ мэ шэрэстэ.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ко днас, ко кориня ки горадэнги мэ фулистинём,","poem":1},{"text":"о клидя э пхуяки пханлилэ пал мандэ алаи э вахытески,","poem":3},{"text":"ай Ту, Яхвэ, Дэл минро,","poem":1},{"text":"никалдян ман андар хорипэ дживиндэс!","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Кана о бэшыпэ бытиелас андэ мандэ,","poem":1},{"text":"мэ катар Сагбус Яхвэ тюшундым,","poem":3},{"lineBreak":true},{"text":"тай гело мо мангипэ джи Тутэ,","poem":3},{"lineBreak":true},{"text":"андэ шужо храми Тинро.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Одола, кон гинэл э чюче дэвлэн,","poem":1},{"text":"ачявдэ по пакяпэ Туки.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Ай мэ лошанэ гиленца кан анав Туки курбанен.","poem":1},{"text":"Кай халём совля — кан керав.","poem":3},{"text":"О кутардипэ — катар Сагбус Яхвэ!","poem":1}]},{"type":"verse","number":11,"content":["О Сагбус о Яхвэ пхэнляс э мачески, тай ов читяс э Ионас опэр пху."]}],"footnotes":[{"noteId":0,"caller":"+","text":"2.3 Евр. «шэол».","reference":{"chapter":2,"verse":3}}]},"thisChapterLink":"/api/rmn_pbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmn_pbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmn_pbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}