{"translation":{"id":"rmy_ser","name":"Библия пы сэрвицко ромско чиб","website":"https://ebible.org/Scriptures/details.php?id=rmyservi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmyservi","licenseNotes":null,"shortName":"SER","englishName":"Servi Romani Bible portions","language":"rmy","textDirection":"ltr","sha256":"de95fabea8a57b4acf6cefa336320ec532b56d5266528fdc1e7be877a5bdd22e","availableFormats":["json"],"listOfBooksApiLink":"/api/rmy_ser/books.json","numberOfBooks":5,"totalNumberOfChapters":110,"totalNumberOfVerses":3816,"languageName":"Romany","languageEnglishName":"Romany"},"book":{"id":"GEN","translationId":"rmy_ser","name":"Англунимо люмлятиро","commonName":"Англунимо люмлятиро","title":"Англунимо люмлятиро","order":1,"numberOfChapters":50,"sha256":"a90b466e41d299ba63402ff1429ff46dea14434dfc04e9f5dc10e587d2a78af9","firstChapterNumber":1,"firstChapterApiLink":"/api/rmy_ser/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/rmy_ser/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Иаково бахталисарэл чявэн"]},{"type":"verse","number":1,"content":["Иаково акхарда пэхкирэн чявэн тай пхэнда: — Стидэнпэ паша ман, тай мэ роспхэнава тумэнди, со авэла тумэнца дурэдэр."]},{"type":"verse","number":2,"content":[{"text":"Стидэнпэ тай шунэн , Иаковохкирэ чявэ,","poem":1},{"text":"шунэн пэхкирэ дадэ Израилё.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Рувимо, ту — муро пхурэдэр, мури зор,","poem":1},{"text":"англуно плодо муря муршакуня зоратиро,","poem":2},{"lineBreak":true},{"text":"англуно пай патив, англуно пай зор.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Парувэхпэ ту, сар пани,","poem":1},{"text":"будэр ту на авэґа пхурэдэрэґа чявэґа,","poem":2},{"text":"пала када со сутан пэ тиро дадэхкиро тхан,","poem":1},{"text":"мусардан муро пато.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Симеоно тай Левиё — пхрала,","poem":1},{"text":"лэндирэ чюря анэн мижымо.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Тэ на авэл муро їло лэнца дэ када, пала со вонэ думисарэн,","poem":1},{"text":"тэ на авав, тев вонэ стидэнпэ","poem":2},{"text":"Вонэ дэ холя умардэ муршэн,","poem":1},{"text":"сар закамле, чиндэ гурувэн.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Прыдав мрая лэндири холи,","poem":1},{"text":"пала када со фартэ сле холяти,","poem":2},{"lineBreak":true},{"text":"фартэ зорали лэндири холи!","poem":2},{"text":"Мэ розчювава лэн машкар Иаковохкирэ чяворэ,","poem":1},{"text":"розчювава лэн машкар Израилёхкирэ чяворэ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Иуда, тирэ пхрала ашарэна тут,","poem":1},{"text":"тиро васт авэла пэ кор тирэн врыжымашонэн,","poem":2},{"lineBreak":true},{"text":"тирэ дадэхкирэ чявэ авэна тэ тэлён тути.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ту — тэрно лево, Иуда,","poem":1},{"text":"ту рисарэґапэ астаримаґа, муро чяво.","poem":2},{"text":"Сар лево, вов прыпэрэл пхуятэ,","poem":1},{"text":"сар львица, вов пэрэл,","poem":2},{"lineBreak":true},{"text":"ко камэл ла тэ здаравэ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Дэсто тхагаримахкиро на уджяла Иудастар,","poem":1},{"text":"лэхкирэ потомкуря всавори вряма авэна тэ рицарэ тхагаримо.","poem":2},{"text":"Ай тунчи авэла Шыло,","poem":1},{"text":"тай лэсти тэлёна всаворэ народуря.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Вов прыпхандэла пэхкирэ магаре дэ дракохкири лоза,","poem":1},{"text":"тэрнэ магаре — дэ фэдэдэр дракохкири лоза.","poem":2},{"text":"Вов халавэла пэхкири їда дэ мол,","poem":1},{"text":"пэхкиро урявимо — дэ дракохкиро рат.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Лэхкирэ якха авэна калэдэр молэстар,","poem":1},{"text":"данда лэхкирэ — парнэдэр тхудэстар.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Завулоно авэла тэ джювэ пашэ баро пани,","poem":1},{"text":"барэ корабли заджяна дэ лэ.","poem":2},{"text":"Лэхкири пхув процырдэлапэ ды Сидоно.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Иссахаро — састо магари,","poem":1},{"text":"вов пашлёл машкар дуй пхарэ гонэ, савэ пхиравэн джювимо.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Кала дыкхля, сар лачё лэхкиро отцынимахкиро тхан","poem":1},{"text":"тай сави лачи лэхкири пхув,","poem":2},{"text":"вов прыцырдэла пэхкирэ пхикэ тала пхаримо","poem":1},{"text":"тай отдэлапэ пхаря бутяти.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Дано сундисарэла пэхкиро народо,","poem":1},{"text":"сар екх Израилёхкирятар породатар.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Дано авэла сапэґа паша дром,","poem":1},{"text":"сар сап, саво лиджял мэримо пэ сано дром,","poem":2},{"text":"саво дандярэл грастэ пала пуро,","poem":1},{"text":"кади со кодэва, саво бэшэл англистэ, пэрэл пэ пхув.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"О РАЁ, Тутар ажутярав фирисаримо!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Гадо авэна тэ обчёрэ,","poem":1},{"text":"нэ вов даравэла лэн павпалэ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Асиростэ авэла скаминд замардо барваляґа хамаґа,","poem":1},{"text":"вов авэла тэ дэ лачё хамо, саво хан тхагара.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Неффалимо — сар лань, сави прастэл пав мален,","poem":1},{"text":"сави анэл райканэн чяворэн.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Иосифо — дракохкири рандь,","poem":1},{"text":"сави анэл бут плодо.","poem":2},{"text":"Вой барёл пашэ лэнь","poem":1},{"text":"тай ваздэлпэ упрэ пэ ванта.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Холяґа хукэнас пэ лэстэ лучникуря,","poem":1},{"text":"зораґа марэнас дэ лэстэ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Нэ лэхкиро луко ачиляпэ састо.","poem":1},{"text":"Зор лэхкирэ вастэндиро —","poem":2},{"text":"зорало Дэвэл Иаковохкиро,","poem":1},{"text":"Лав Чябанохкиро,","poem":2},{"lineBreak":true},{"text":"Бар Израилёхкиро.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Дэвэл тирэ дадэхкиро,","poem":1},{"text":"Всазорако, Саво дэл зор тути.","poem":2},{"text":"Вов бичялэл","poem":1},{"text":"бахталисаримо упрал, болыбнатар,","poem":2},{"lineBreak":true},{"text":"тай бахталисаримо, саво тала пхув,","poem":2},{"lineBreak":true},{"text":"бахталисарэл чючя тай водя.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Тирэ дадэхкирэ бахталисаримо барыдэр,","poem":1},{"text":"сар бахталисаримо пуранэн плаен,","poem":2},{"lineBreak":true},{"text":"сар бахталисаримо пуранэн упралимахкирэн плаен.","poem":2},{"text":"Тэ авэн всаворэ вонэ пэ Иосифохкиро шэро,","poem":1},{"text":"пэ чекат тхагарехкиро машкар пэхкирэн пхралэн.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Вениамино — бокхало рув;","poem":1},{"text":"дэнзор вов схал астаримо,","poem":2},{"lineBreak":true},{"text":"бельвеляґа розлэл кодэва мищимо.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":["Акэ савэ дэшудуй Израилёхкирэ родуря, тай акэ со пхэнда лэнди дад, лэндиро бахталисаримо; кажнонэсти вов дэня пэхкиро бахталисаримо."]},{"type":"heading","content":["Иаковохкиро мэримо"]},{"type":"verse","number":29,"content":["Тунчи Иаково прыпхэнда лэнди: — Мэ отджяв мурэндэ дадэндэ. Гаравэн ман пашэ мурэн дадэн дэ пищера пэ маля Эфронохкиря хеттеёхкиря,"]},{"type":"verse","number":30,"content":["дэ пищера пэ маля Махпела пашэ Мамреґа дэ Ханаано, сави Авраамо тинда, сар тхан, тев тэ гаравэ Эфроностэ хеттеёстэ екхтханэ маляґа."]},{"type":"verse","number":31,"content":["Котэ сле гаравдэ Авраамо тай лэхкири ромни Сарра, котэ гаравдэ Исаако тай лэхкири ромни Ревека, тай котэ мэ гаравдом Лия."]},{"type":"verse","number":32,"content":["Маля тай пищера сле тиндэ хеттеянэндэ."]},{"type":"verse","number":33,"content":["Иаково пэрэачиля тэ дэдумэ чявэнди, подлиля пурэ пэ пато, вымукля фано тай отджиля пэхкирэндэ дадэндэ."]}],"footnotes":[]},"thisChapterLink":"/api/rmy_ser/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmy_ser/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmy_ser/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}