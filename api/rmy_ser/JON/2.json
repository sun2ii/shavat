{"translation":{"id":"rmy_ser","name":"Библия пы сэрвицко ромско чиб","website":"https://ebible.org/Scriptures/details.php?id=rmyservi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmyservi","licenseNotes":null,"shortName":"SER","englishName":"Servi Romani Bible portions","language":"rmy","textDirection":"ltr","sha256":"de95fabea8a57b4acf6cefa336320ec532b56d5266528fdc1e7be877a5bdd22e","availableFormats":["json"],"listOfBooksApiLink":"/api/rmy_ser/books.json","numberOfBooks":5,"totalNumberOfChapters":110,"totalNumberOfVerses":3816,"languageName":"Romany","languageEnglishName":"Romany"},"book":{"id":"JON","translationId":"rmy_ser","name":"Ионахкиро лил","commonName":"Ионахкиро лил","title":"Ионахкиро лил","order":32,"numberOfChapters":4,"sha256":"0d1081f011aba9ba32668c313d02f77e69eaa78dd3e527764b2af4812a3764c4","firstChapterNumber":1,"firstChapterApiLink":"/api/rmy_ser/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/rmy_ser/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Иона мангэлпэ Дэвлэсти андрал мачестар"]},{"type":"verse","number":1,"content":["РАЙ бичялда баро мачё, тай вой прозумавда Иона. Вов просля андрэ ды пэр мачестэ трин дивэ тай трин рятя."]},{"type":"verse","number":2,"content":["Кала Иона сля ды пэр мачестэ, вов помангляпэ РАЕСТИ, пэхкирэ Дэвлэсти."]},{"type":"verse","number":3,"content":["Вов пхэнда:",{"text":"— Ды бида мэ типисилём РАЕСТИ,","poem":1},{"text":"и Вов задэдуманя мандэ.","poem":2},{"text":"Мэ затиписилём кола люмлятар мулэндар —","poem":1},{"text":"тай Ту ушундан муро гласо.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ту обмуклян ман фартэ тэлэ ды пане,","poem":1},{"text":"вой тирёлас тай подлэласпэ понад муро шэро.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Мэ пхэндом:","poem":1},{"text":"«Отчюто мэ Тирэ якхэндар,","poem":2},{"lineBreak":true},{"text":"нэ всаекх мэ джянав, со мэ удыкхава свэнто Тиро цэр».","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Пани ушаравда ман,","poem":1},{"text":"чяря панестар обкхувдэ муро шэро.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Мэ тэлэ пхув сджилём, тев барён плая,","poem":1},{"text":"тай удара затердэпэ пала ман,","poem":2},{"lineBreak":true},{"text":"соб тэ на вымукэ ман вако.","poem":2},{"text":"Нэ Ту, РАЙ, муро Дэвэл,","poem":1},{"text":"вылилян ман хывьятар джюдэґа.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Кала джювимо муро мурдёлас,","poem":1},{"text":"тай ачилёмпэ мэ би зорако,","poem":2},{"text":"мэ РАЕ срапирдом,","poem":1},{"text":"тай муро мангимо доджиля Тутэ,","poem":2},{"lineBreak":true},{"text":"ды свэнто Тиро цэр.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Кола, ко тэлёл хохавнэ, шушэ дэвлэнди,","poem":1},{"text":"прыдыне Тут.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"А мэ ашаримахкирэ гласоґа анава Тути жэртва,","poem":1},{"text":"со пхэндом англа Тут, стерава!","poem":2},{"lineBreak":true},{"text":"Фирисаримо РАЕСТАР!","poem":2}]},{"type":"verse","number":11,"content":["РАЙ пхэнда мачести, тай вов вычюта Иона мостар пы пхув."]}],"footnotes":[]},"thisChapterLink":"/api/rmy_ser/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmy_ser/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmy_ser/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}