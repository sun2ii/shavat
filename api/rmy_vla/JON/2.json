{"translation":{"id":"rmy_vla","name":"Библия пэ влахицко романи шыб","website":"https://ebible.org/Scriptures/details.php?id=rmyvlakh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rmyvlakh","licenseNotes":null,"shortName":"VLA","englishName":"Eastern Vlakh Romani","language":"rmy","textDirection":"ltr","sha256":"5254ca6c25dc08559fb58f9c91f9a90be1683c0c78441945b8f855f74e378f37","availableFormats":["json"],"listOfBooksApiLink":"/api/rmy_vla/books.json","numberOfBooks":5,"totalNumberOfChapters":110,"totalNumberOfVerses":3812,"languageName":"Romany","languageEnglishName":"Romany"},"book":{"id":"JON","translationId":"rmy_vla","name":"Лил лэ Ионастар","commonName":"Лил лэ Ионастар","title":"Лил лэ Ионастар","order":32,"numberOfChapters":4,"sha256":"f36c71dc0c618ec4db945594fd9c4aea6414527e3d8acd0ba797380a0fde5f42","firstChapterNumber":1,"firstChapterApiLink":"/api/rmy_vla/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/rmy_vla/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["О Иона мангэлпэ Дэвлэс"]},{"type":"verse","number":1,"content":["О РАЙ бишалдя барэ мащес, тэ накавэл лэ Ионас. О Иона сас трин дес и трин ратя андо йило лэ мащеско."]},{"type":"verse","number":2,"content":["Анда йило лэ мащестар о Иона ля тэ мангэлпэ лэ РАЕСТИ, пэстерэ Дэвлэсти."]},{"type":"verse","number":3,"content":["О Иона пхэндя:",{"text":"— Пала мэрни бида акхаравас мэ лэ РАЕС,","poem":1},{"text":"и Вов ашундя ман.","poem":2},{"text":"Анда машкар лэ мулэнго тхагаримос цыпияс,","poem":1},{"text":"и Ту ашундян мэрно гласо.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Шувидян ман Ту само тэлэ,","poem":1},{"text":"андо ди лэ барэ паеско.","poem":2},{"text":"О паи заболдя ман,","poem":1},{"text":"понадэ мандэ прожылэ саворэ Терэ волнэ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Гындояспэ манди:","poem":1},{"text":"«Витрадян ман Терэ якхэндар.","poem":2},{"lineBreak":true},{"text":"Но най, мэ саекх дикхава Теро свынто Храмо».","poem":2}]},{"type":"verse","number":6,"content":[{"text":"О паи ушарадя ман,","poem":1},{"text":"дур сым андэ барэ пая,","poem":2},{"lineBreak":true},{"text":"тай э чяр лэ паести заболдя манди о шэро.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Само тэлэ, катар барён э плая, ужылэмтар мэ,","poem":1},{"text":"о засовуря ла пхувяти запхандадилэ пала мандэ пэ ся время.","poem":2},{"text":"Ай Ту РАЙ, мэрно Дэл,","poem":1},{"text":"вилян ман жундэс андай могыла!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Кала мэрно жувимос мудардёлас андэр мандэ,","poem":1},{"text":"мэ гындояс пала РАЙ,","poem":2},{"text":"тай мэрно мангимос дожыля каринг Тутэ,","poem":1},{"text":"андэ Теро свынто Храмо.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Кола, ко патял лэ хохавнэ дэвлэнди,","poem":1},{"text":"хасардэ о тынгимос, саво саслэ тэ лэн.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ай мэрни жэртва Тути — мэрнэ диля,","poem":1},{"text":"савэнца ашарав тут.","poem":2},{"text":"Мэ ся стерава, андэ со солахаем.","poem":1},{"text":"О РАЙ анэл фиримос!","poem":2}]},{"type":"verse","number":11,"content":["И припхэндя о РАЙ лэ мащести, тэ вишункардэл андар пэстэ лэ Ионас пэ пхув."]}],"footnotes":[]},"thisChapterLink":"/api/rmy_vla/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rmy_vla/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rmy_vla/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}