вынтул.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Де ачея чей рэй ну пот цине капул сус ын зиуа жудекэций,","poem":2},{"lineBreak":true},{"text":"нич пэкэтоший, ын адунаря челор неприхэниць.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Кэч Домнул куноаште каля челор неприхэниць,","poem":2},{"lineBreak":true},{"text":"дар каля пэкэтошилор дуче ла пеире.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}