true},{"text":"ши крединчошия Луй, дин ням ын ням.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}