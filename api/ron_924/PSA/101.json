{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"verse","number":1,"content":[{"text":"Вой кынта бунэтатя ши дрептатя:","poem":1},{"text":"Цие, Доамне, Ыць вой кынта.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Мэ вой пурта ку ынцелепчуне пе о кале неприхэнитэ. –","poem":2},{"lineBreak":true},{"text":"Кынд вей вени ла мине? –","poem":2},{"lineBreak":true},{"text":"Вой умбла ку инима фэрэ приханэ ын мижлокул касей меле.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ну вой пуне нимик рэу ынаинтя окилор мей;","poem":2},{"lineBreak":true},{"text":"урэск пуртаря пэкэтошилор,","poem":2},{"lineBreak":true},{"text":"еа ну се ва липи де мине.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Инима стрикатэ се ва депэрта де мине;","poem":2},{"lineBreak":true},{"text":"ну вряу сэ куноск пе чел рэу.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Пе чел че клеветеште ын аскунс пе апроапеле сэу ыл вой нимичи;","poem":2},{"lineBreak":true},{"text":"пе чел ку привирь труфаше ши ку инима ынгымфатэ ну-л вой суфери.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Вой авя окий ындрептаць асупра крединчошилор дин царэ, ка сэ локуяскэ лынгэ мине;","poem":2},{"lineBreak":true},{"text":"чел че умблэ пе о кале фэрэ приханэ, ачела ымь ва служи.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Чел че се дедэ ла ыншелэчуне ну ва локуи ын каса мя;","poem":2},{"lineBreak":true},{"text":"чел че спуне минчунь ну ва ста ынаинтя мя.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ын фиекаре диминяцэ вой нимичи пе тоць чей рэй дин царэ,","poem":2},{"lineBreak":true},{"text":"ка сэ стырпеск дин четатя Домнулуй пе тоць чей че сэвыршеск нелеӂюиря.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}