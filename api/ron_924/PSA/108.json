{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"verse","number":1,"content":[{"text":"Гата ымь есте инима сэ кынте, Думнезеуле!","poem":1},{"text":"Вой кынта, вой суна дин инструментеле меле; ачаста есте слава мя!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Дештептаци-вэ, алэутэ ши харпэ!","poem":2},{"lineBreak":true},{"text":"Мэ вой трези ын зорь де зи.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Те вой лэуда принтре попоаре, Доамне,","poem":2},{"lineBreak":true},{"text":"Те вой кынта принтре нямурь.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Кэч маре есте бунэтатя Та ши се ыналцэ май пресус де черурь,","poem":2},{"lineBreak":true},{"text":"яр крединчошия Та пынэ ла норь.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ыналцэ-Те песте черурь, Думнезеуле,","poem":2},{"lineBreak":true},{"text":"ши фие слава Та песте тот пэмынтул!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Пентру ка пряюбиций Тэй сэ фие избэвиць,","poem":2},{"lineBreak":true},{"text":"скапэ-не прин дряпта Та ши аскултэ-не!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Думнезеу а ворбит ын сфинцения Луй: „Вой бируи,","poem":2},{"lineBreak":true},{"text":"вой ымпэрци Сихемул, вой мэсура валя Сукот;","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ал Меу есте Галаадул, ал Меу Манасе;","poem":2},{"lineBreak":true},{"text":"Ефраим есте ынтэритура капулуй Меу","poem":2},{"lineBreak":true},{"text":"ши Иуда, тоягул Меу де кырмуире;","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Моаб есте лигянул ын каре Мэ спэл;","poem":2},{"lineBreak":true},{"text":"Ымь арунк ынкэлцэминтя асупра Едомулуй;","poem":2},{"lineBreak":true},{"text":"стриг де букурие асупра цэрий филистенилор!”","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Чине мэ ва дуче ын четатя ынтэритэ?","poem":2},{"lineBreak":true},{"text":"Чине мэ ва дуче ла Едом?","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Оаре ну Ту, Думнезеуле, каре не-ай лепэдат","poem":2},{"lineBreak":true},{"text":"ши каре ну врей сэ май ешь, Думнезеуле, ку оштириле ноастре?","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Дэ-не ажутор ын неказ,","poem":2},{"lineBreak":true},{"text":"кэч задарник есте ажуторул омулуй.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ку Думнезеу вом фаче марь испрэвь;","poem":2},{"lineBreak":true},{"text":"Ел ва здроби пе врэжмаший ноштри.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}