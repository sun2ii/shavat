{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Ла Домнул гэсеск скэпаре! Кум путець сэ-мь спунець:","poem":1},{"text":"„Фуӂь ын мунций воштри ка о пасэре”?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Кэч ятэ кэ чей рэй ышь ынкордязэ аркул,","poem":2},{"lineBreak":true},{"text":"ышь потривеск сэӂята пе коардэ,","poem":2},{"lineBreak":true},{"text":"ка сэ трагэ пе аскунс асупра челор ку инима куратэ.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ши кынд се сурпэ темелииле,","poem":2},{"lineBreak":true},{"text":"че ар путя сэ май факэ чел неприхэнит?","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Домнул есте ын Темплул Луй чел сфынт, Домнул Ышь аре скаунул де домние ын черурь.","poem":2},{"lineBreak":true},{"text":"Окий Луй привеск ши плеоапеле Луй черчетязэ пе фиий оаменилор.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Домнул ынчаркэ пе чел неприхэнит,","poem":2},{"lineBreak":true},{"text":"дар урэште пе чел рэу ши пе чел че юбеште силничия.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Песте чей рэй плоуэ кэрбунь, фок ши пучоасэ:","poem":2},{"lineBreak":true},{"text":"ун вынт догоритор, ятэ пахарул де каре ау ей парте.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Кэч Домнул есте дрепт, юбеште дрептатя,","poem":2},{"lineBreak":true},{"text":"ши чей неприхэниць привеск Фаца Луй.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}