{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"Домнул а зис Домнулуй меу: „Шезь ла дряпта Мя","poem":1},{"text":"пынэ вой пуне пе врэжмаший Тэй суб пичоареле Тале.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Домнул ва ынтинде дин Сион тоягул де кырмуире ал путерий Тале, зикынд:","poem":2},{"lineBreak":true},{"text":"„Стэпынеште ын мижлокул врэжмашилор Тэй!”","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Попорул Тэу есте плин де ынфлэкэраре кынд Ыць адунь оштиря;","poem":2},{"lineBreak":true},{"text":"ку подоабе сфинте, ка дин сынул зорилор,","poem":2},{"lineBreak":true},{"text":"вине тинеретул Тэу ла Тине, ка роуа.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Домнул а журат ши ну-Й ва пэря рэу:","poem":2},{"lineBreak":true},{"text":"„Ту ешть преот ын вяк,","poem":2},{"lineBreak":true},{"text":"ын фелул луй Мелхиседек.”","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Домнул, де ла дряпта Та,","poem":2},{"lineBreak":true},{"text":"здробеште пе ымпэраць ын зиуа мынией Луй.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ел фаче дрептате принтре нямурь:","poem":2},{"lineBreak":true},{"text":"тотул есте плин де трупурь моарте;","poem":2},{"lineBreak":true},{"text":"Ел здробеште капете пе тоатэ ынтиндеря цэрий.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ел бя дин пырыу ын тимпул мерсулуй,","poem":2},{"lineBreak":true},{"text":"де ачея Ышь ыналцэ капул.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}