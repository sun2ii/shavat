{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Лэудаць пе Домнул!","poem":1},{"text":"Вой лэуда пе Домнул дин тоатэ инима мя,","poem":2},{"lineBreak":true},{"text":"ын товэрэшия оаменилор фэрэ приханэ ши ын адунаре.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Марь сунт лукрэриле Домнулуй,","poem":2},{"lineBreak":true},{"text":"черчетате де тоць чей че ле юбеск!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Стрэлучире ши мэрецие есте лукраря Луй,","poem":2},{"lineBreak":true},{"text":"ши дрептатя Луй цине ын вечь!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ел а лэсат о адучере аминте а минунилор Луй;","poem":2},{"lineBreak":true},{"text":"Домнул есте ындурэтор ши милостив.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ел а дат хранэ челор че се тем де Ел;","poem":2},{"lineBreak":true},{"text":"Ел Ышь адуче пуруря аминте де легэмынтул Луй.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ел а арэтат попорулуй Сэу путеря лукрэрилор Луй,","poem":2},{"lineBreak":true},{"text":"кэч ле-а дат моштениря нямурилор.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Лукрэриле мынилор Луй сунт крединчошие ши дрептате;","poem":2},{"lineBreak":true},{"text":"тоате порунчиле Луй сунт адевэрате,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ынтэрите пентру вешничие,","poem":2},{"lineBreak":true},{"text":"фэкуте ку крединчошие ши неприхэнире.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"А тримис попорулуй Сэу избэвиря,","poem":2},{"lineBreak":true},{"text":"а ашезат легэмынтул Сэу ын вечь;","poem":2},{"lineBreak":true},{"text":"Нумеле Луй есте сфынт ши ынфрикошат.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Фрика де Домнул есте ынчепутул ынцелепчуний;","poem":2},{"lineBreak":true},{"text":"тоць чей че о пэзеск ау о минте сэнэтоасэ","poem":2},{"lineBreak":true},{"text":"ши слава Луй цине ын вечь.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}