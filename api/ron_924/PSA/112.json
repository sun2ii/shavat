{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Лэудаць пе Домнул!","poem":1},{"text":"Фериче де омул каре се теме де Домнул","poem":2},{"lineBreak":true},{"text":"ши каре аре о маре плэчере пентру порунчиле Луй!","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Сэмынца луй ва фи путерникэ пе пэмынт;","poem":2},{"lineBreak":true},{"text":"нямул оаменилор фэрэ приханэ ва фи бинекувынтат.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ел аре ын касэ богэцие ши белшуг","poem":2},{"lineBreak":true},{"text":"ши неприхэниря луй дэйнуеште ын вечь.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Челуй фэрэ приханэ ый рэсаре о луминэ ын ынтунерик,","poem":2},{"lineBreak":true},{"text":"ел есте милостив, ындурэтор ши дрепт.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Че бине-й мерӂе омулуй каре фаче милэ ши ымпрумутэ пе алтул","poem":2},{"lineBreak":true},{"text":"ши каре ышь рындуеште фаптеле дупэ дрептате!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Кэч ел ну се клатинэ ничодатэ;","poem":2},{"lineBreak":true},{"text":"помениря челуй неприхэнит цине ын вечь.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ел ну се теме де вешть реле,","poem":2},{"lineBreak":true},{"text":"чи инима луй есте таре, ынкрезэтоаре ын Домнул.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Инима ый есте мынгыятэ, н-аре ничо тямэ,","poem":2},{"lineBreak":true},{"text":"пынэ че ышь веде ымплинитэ доринца фацэ де потривничий луй.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ел есте дарник, дэ челор липсиць;","poem":2},{"lineBreak":true},{"text":"милостения луй цине ын вечь;","poem":2},{"lineBreak":true},{"text":"капул и се ыналцэ ку славэ.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Чел рэу веде лукрул ачеста ши се мыние,","poem":2},{"lineBreak":true},{"text":"скрышнеште дин динць ши се топеште.","poem":2},{"lineBreak":true},{"text":"Пофтеле челор рэй рэмын неымплините.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}