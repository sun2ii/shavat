{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Лэудаць пе Домнул!","poem":1},{"text":"Робий Домнулуй, лэудаць,","poem":2},{"lineBreak":true},{"text":"лэудаць Нумеле Домнулуй!","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Фие Нумеле Домнулуй бинекувынтат","poem":2},{"lineBreak":true},{"text":"де акум ши пынэ ын вяк!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Де ла рэсэритул соарелуй пынэ ла апусул луй,","poem":2},{"lineBreak":true},{"text":"фие Нумеле Домнулуй лэудат!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Домнул есте ынэлцат май пресус де тоате нямуриле,","poem":2},{"lineBreak":true},{"text":"слава Луй есте май пресус де черурь.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Чине есте ка Домнул Думнезеул ностру,","poem":2},{"lineBreak":true},{"text":"каре локуеште атыт де сус?","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ел Ышь плякэ привириле сэ вадэ","poem":2},{"lineBreak":true},{"text":"че се фаче ын черурь ши пе пэмынт.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ел ридикэ пе сэрак дин цэрынэ,","poem":2},{"lineBreak":true},{"text":"ыналцэ пе чел липсит дин гуной,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ка сэ-й факэ сэ шадэ ымпреунэ ку чей марь:","poem":2},{"lineBreak":true},{"text":"ку май-марий попорулуй Сэу.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ел дэ о касэ челей че ера стярпэ,","poem":2},{"lineBreak":true},{"text":"фаче дин еа о мамэ веселэ ын мижлокул копиилор ей.","poem":2},{"lineBreak":true},{"text":"Лэудаць пе Домнул!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}