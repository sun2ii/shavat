{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Ну ноуэ, Доамне, ну ноуэ, чи Нумелуй Тэу дэ славэ","poem":1},{"text":"пентру бунэтатя Та, пентру крединчошия Та!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Пентру че сэ зикэ нямуриле:","poem":2},{"lineBreak":true},{"text":"„Унде есте Думнезеул лор?”","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Думнезеул ностру есте ын чер,","poem":2},{"lineBreak":true},{"text":"Ел фаче тот че вря.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Идолий лор сунт арӂинт ши аур,","poem":2},{"lineBreak":true},{"text":"фэкуць де мынь оменешть.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ау гурэ, дар ну ворбеск;","poem":2},{"lineBreak":true},{"text":"ау окь, дар ну вэд;","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ау урекь, дар н-ауд;","poem":2},{"lineBreak":true},{"text":"ау нас, дар ну мирос;","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ау мынь, дар ну пипэе;","poem":2},{"lineBreak":true},{"text":"пичоаре, дар ну мерг;","poem":2},{"lineBreak":true},{"text":"ну скот ничун сунет дин гытлежул лор.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ка ей сунт чей че-й фак,","poem":2},{"lineBreak":true},{"text":"тоць чей че се ынкред ын ей.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Исраеле, ынкреде-те ын Домнул!","poem":2},{"lineBreak":true},{"text":"Ел есте ажуторул ши скутул лор.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Каса луй Аарон, ынкреде-те ын Домнул!","poem":2},{"lineBreak":true},{"text":"Ел есте ажуторул ши скутул лор.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Чей че вэ темець де Домнул, ынкредеци-вэ ын Домнул!","poem":2},{"lineBreak":true},{"text":"Ел есте ажуторул ши скутул лор.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Домнул Шь-адуче аминте де ной. Ел ва бинекувынта:","poem":2},{"lineBreak":true},{"text":"ва бинекувынта каса луй Исраел,","poem":2},{"lineBreak":true},{"text":"ва бинекувынта каса луй Аарон,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ва бинекувынта пе чей че се тем де Домнул,","poem":2},{"lineBreak":true},{"text":"пе чей мичь ши пе чей марь.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Домнул сэ вэ ынмулцяскэ тот май мулт,","poem":2},{"lineBreak":true},{"text":"пе вой ши пе копиий воштри!","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Фиць бинекувынтаць де Домнул,","poem":2},{"lineBreak":true},{"text":"каре а фэкут черуриле ши пэмынтул!","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Черуриле сунт але Домнулуй,","poem":2},{"lineBreak":true},{"text":"дар пэмынтул л-а дат фиилор оаменилор.","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ну морций лаудэ пе Домнул","poem":2},{"lineBreak":true},{"text":"ши нич вреунул дин чей че се кобоарэ ын локул тэчерий,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"чи ной, ной вом бинекувынта пе Домнул,","poem":2},{"lineBreak":true},{"text":"де акум ши пынэ ын вяк.","poem":2},{"lineBreak":true},{"text":"Лэудаць пе Домнул!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}