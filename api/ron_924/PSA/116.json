{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Юбеск пе Домнул, кэч Ел ауде","poem":1},{"text":"гласул меу, черериле меле.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Да, Ел Шь-а плекат урекя спре мине,","poem":2},{"lineBreak":true},{"text":"де ачея-Л вой кема тоатэ вяца мя.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Мэ ынфэшурасерэ легэтуриле морций","poem":2},{"lineBreak":true},{"text":"ши м-апукасерэ судориле мормынтулуй;","poem":2},{"lineBreak":true},{"text":"ерам прадэ неказулуй ши дурерий.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Дар ам кемат Нумеле Домнулуй ши ам зис:","poem":2},{"lineBreak":true},{"text":"„Доамне, мынтуеште-мь суфлетул!”","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Домнул есте милостив ши дрепт","poem":2},{"lineBreak":true},{"text":"ши Думнезеул ностру есте плин де ындураре.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Домнул пэзеште пе чей фэрэ рэутате:","poem":2},{"lineBreak":true},{"text":"ерам ненорочит де тот, дар Ел м-а мынтуит.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ынтоарче-те, суфлете, ла одихна та,","poem":2},{"lineBreak":true},{"text":"кэч Домнул ць-а фэкут бине!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Да, Ту мь-ай избэвит суфлетул де ла моарте,","poem":2},{"lineBreak":true},{"text":"окий дин лакримь ши пичоареле де кэдере.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Вой умбла ынаинтя Домнулуй,","poem":2},{"lineBreak":true},{"text":"пе пэмынтул челор вий.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Авям дрептате кынд зичям:","poem":2},{"lineBreak":true},{"text":"„Сунт фоарте ненорочит!”","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ын нелиништя мя, зичям:","poem":2},{"lineBreak":true},{"text":"„Орьче ом есте ыншелэтор.”","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Кум вой рэсплэти Домнулуй","poem":2},{"lineBreak":true},{"text":"тоате бинефачериле Луй фацэ де мине?","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Вой ынэлца пахарул избэвирилор","poem":2},{"lineBreak":true},{"text":"ши вой кема Нумеле Домнулуй;","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ымь вой ымплини журуинцеле фэкуте Домнулуй,","poem":2},{"lineBreak":true},{"text":"ын фаца ынтрегулуй Сэу попор.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Скумпэ есте ынаинтя Домнулуй","poem":2},{"lineBreak":true},{"text":"моартя челор юбиць де Ел.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Аскултэ-мэ, Доамне, кэч сунт робул Тэу:","poem":2},{"lineBreak":true},{"text":"робул Тэу, фиул роабей Тале,","poem":2},{"lineBreak":true},{"text":"ши Ту мь-ай десфэкут легэтуриле!","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ыць вой адуче о жертфэ де мулцумире","poem":2},{"lineBreak":true},{"text":"ши вой кема Нумеле Домнулуй;","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ымь вой ымплини журуинцеле фэкуте Домнулуй","poem":2},{"lineBreak":true},{"text":"ын фаца ынтрегулуй Сэу попор,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ын курциле Касей Домнулуй,","poem":2},{"lineBreak":true},{"text":"ын мижлокул тэу, Иерусалиме!","poem":2},{"lineBreak":true},{"text":"Лэудаць пе Домнул!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}