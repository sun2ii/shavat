{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"Кэтре Домнул стриг ын стрымтораря мя,","poem":1},{"text":"ши Ел м-аскултэ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Доамне, скапэ-мь суфлетул де буза минчиноасэ,","poem":2},{"lineBreak":true},{"text":"де лимба ыншелэтоаре!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Че-ць дэ Ел цие, че-ць адуче Ел цие,","poem":2},{"lineBreak":true},{"text":"лимбэ ыншелэтоаре?","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Сэӂець аскуците де рэзбойник,","poem":2},{"lineBreak":true},{"text":"ку кэрбунь априншь де енупэр.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Вай де мине кэ локуеск ла Мешек,","poem":2},{"lineBreak":true},{"text":"кэ локуеск ын кортуриле Кедарулуй!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Дестул мь-а локуит суфлетул","poem":2},{"lineBreak":true},{"text":"лынгэ чей че урэск пачя.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Еу сунт пентру паче,","poem":2},{"lineBreak":true},{"text":"дар де ындатэ че ворбеск еу, ей сунт пентру рэзбой.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}