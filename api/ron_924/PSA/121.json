{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"Ымь ридик окий спре мунць…","poem":1},{"text":"Де унде-мь ва вени ажуторул?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ажуторул ымь вине де ла Домнул,","poem":2},{"lineBreak":true},{"text":"каре а фэкут черуриле ши пэмынтул.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Да, Ел ну ва ынгэдуи сэ ци се клатине пичорул;","poem":2},{"lineBreak":true},{"text":"Чел че те пэзеште ну ва дормита.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ятэ кэ ну дормитязэ, нич ну доарме","poem":2},{"lineBreak":true},{"text":"Чел че пэзеште пе Исраел.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Домнул есте Пэзиторул тэу,","poem":2},{"lineBreak":true},{"text":"Домнул есте умбра та пе мына та чя дряптэ.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Де ачея ну те ва бате соареле зиуа,","poem":2},{"lineBreak":true},{"text":"нич луна ноаптя.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Домнул те ва пэзи де орьче рэу,","poem":2},{"lineBreak":true},{"text":"ыць ва пэзи суфлетул.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Домнул те ва пэзи ла плекаре ши ла венире,","poem":2},{"lineBreak":true},{"text":"де акум ши пынэ ын вяк.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}