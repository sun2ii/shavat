{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"Мэ букур кынд ми се зиче:","poem":1},{"text":"„Хайдем ла Каса Домнулуй!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Пичоареле ми се опреск","poem":2},{"lineBreak":true},{"text":"ын порциле тале, Иерусалиме!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Иерусалиме, ту ешть зидит","poem":2},{"lineBreak":true},{"text":"ка о четате фэкутэ динтр-о букатэ!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Аколо се суе семинцииле, семинцииле Домнулуй,","poem":2},{"lineBreak":true},{"text":"дупэ леӂя луй Исраел,","poem":2},{"lineBreak":true},{"text":"ка сэ лауде Нумеле Домнулуй.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Кэч аколо сунт скаунеле де домние пентру жудекатэ,","poem":2},{"lineBreak":true},{"text":"скаунеле де домние але касей луй Давид.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ругаци-вэ пентру пачя Иерусалимулуй!","poem":2},{"lineBreak":true},{"text":"Чей че те юбеск сэ се букуре де одихнэ.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Пачя сэ фие ынтре зидуриле тале","poem":2},{"lineBreak":true},{"text":"ши лиништя, ын каселе тале домнешть!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Дин причина фрацилор ши а приетенилор мей,","poem":2},{"lineBreak":true},{"text":"дореск пачя ын сынул тэу.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Дин причина Касей Домнулуй Думнезеулуй ностру,","poem":2},{"lineBreak":true},{"text":"фак урэрь пентру феричиря та.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}