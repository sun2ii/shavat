{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"Чей че се ынкред ын Домнул сунт ка мунтеле Сионулуй, каре ну се клатинэ, чи стэ ынтэрит пе вечие.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Кум есте ынконжурат Иерусалимул де мунць,","poem":1},{"text":"аша ынконжоарэ Домнул пе попорул Сэу,","poem":2},{"lineBreak":true},{"text":"де акум ши пынэ ын вяк.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Кэч тоягул де кырмуире ал рэутэций ну ва рэмыне пе моштениря челор неприхэниць,","poem":2},{"lineBreak":true},{"text":"пентру ка чей неприхэниць сэ ну ынтиндэ мыниле спре нелеӂюире.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Доамне, варсэ-Ць бинефачериле песте чей бунь","poem":2},{"lineBreak":true},{"text":"ши песте чей ку инима фэрэ приханэ!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Дар пе чей че апукэ пе кэй лэтуралниче,","poem":2},{"lineBreak":true},{"text":"сэ-й нимичяскэ Домнул ымпреунэ ку чей че фак рэу!","poem":2},{"lineBreak":true},{"text":"Пачя сэ фие песте Исраел!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}