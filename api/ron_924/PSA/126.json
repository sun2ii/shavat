{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"Кынд а адус Домнул ынапой пе принший де рэзбой ай Сионулуй, паркэ висам.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Атунч, гура не ера плинэ де стригэте де букурие","poem":1},{"text":"ши лимба, де кынтэрь де веселие.","poem":2},{"lineBreak":true},{"text":"Атунч се спуня принтре нямурь:","poem":2},{"lineBreak":true},{"text":"„Домнул а фэкут марь лукрурь пентру ей!”","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Да, Домнул а фэкут марь лукрурь пентру ной","poem":2},{"lineBreak":true},{"text":"ши де ачея сунтем плинь де букурие.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Доамне, аду ынапой пе принший ноштри де рэзбой","poem":2},{"lineBreak":true},{"text":"ка пе ниште рыурь ын партя де мязэзи!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Чей че сямэнэ ку лакримь вор сечера ку кынтэрь де веселие.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Чел че умблэ плынгынд кынд арункэ сэмынца","poem":2},{"lineBreak":true},{"text":"се ынтоарче ку веселие кынд ышь стрынӂе снопий.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}