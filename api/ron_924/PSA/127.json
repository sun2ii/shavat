{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"Дакэ ну зидеште Домнул о касэ,","poem":1},{"text":"деӂяба лукрязэ чей че о зидеск;","poem":2},{"lineBreak":true},{"text":"дакэ ну пэзеште Домнул о четате,","poem":2},{"lineBreak":true},{"text":"деӂяба вегязэ чел че о пэзеште.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Деӂяба вэ скулаць де диминяцэ ши вэ кулкаць тырзиу","poem":2},{"lineBreak":true},{"text":"ка сэ мынкаць о пыне кыштигатэ ку дурере,","poem":2},{"lineBreak":true},{"text":"кэч пряюбицилор Луй Ел ле дэ пыне ка ын сомн.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ятэ, фиий сунт о моштенире де ла Домнул,","poem":2},{"lineBreak":true},{"text":"родул пынтечелуй есте о рэсплатэ датэ де Ел.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ка сэӂециле ын мына унуй рэзбойник,","poem":2},{"lineBreak":true},{"text":"аша сунт фиий фэкуць ла тинереце.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Фериче де омул каре ышь умпле толба де сэӂець ку ей!","poem":2},{"lineBreak":true},{"text":"Кэч ей ну вор рэмыне де рушине","poem":2},{"lineBreak":true},{"text":"кынд вор ворби ку врэжмаший лор ла поартэ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}