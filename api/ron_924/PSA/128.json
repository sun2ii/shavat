{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"Фериче де орьчине се теме де Домнул","poem":1},{"text":"ши умблэ пе кэиле Луй!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Кэч атунч те букурь де лукрул мынилор тале,","poem":2},{"lineBreak":true},{"text":"ешть феричит ши-ць мерӂе бине.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Невастэ-та есте ка о вицэ родитоаре ынэунтрул касей тале;","poem":2},{"lineBreak":true},{"text":"копиий тэй стау ка ниште лэстарь де мэслин ымпрежурул месей тале.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Аша есте бинекувынтат","poem":2},{"lineBreak":true},{"text":"омул каре се теме де Домнул.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Сэ те бинекувынтезе Домнул дин Сион,","poem":2},{"lineBreak":true},{"text":"сэ везь феричиря Иерусалимулуй ын тоате зилеле веций тале","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ши сэ везь пе копиий копиилор тэй!","poem":2},{"lineBreak":true},{"text":"Пачя сэ фие песте Исраел!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}