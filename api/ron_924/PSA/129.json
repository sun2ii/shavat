{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"Дестул м-ау асуприт дин тинереце –","poem":1},{"text":"с-о спунэ Исраел! –","poem":2}]},{"type":"verse","number":2,"content":[{"text":"дестул м-ау асуприт дин тинереце,","poem":2},{"lineBreak":true},{"text":"дар ну м-ау бируит.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Плугарий ау арат пе спинаря мя,","poem":2},{"lineBreak":true},{"text":"ау трас бразде лунӂь пе еа.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Домнул есте дрепт:","poem":2},{"lineBreak":true},{"text":"Ел а тэят фунииле челор рэй.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Сэ се умпле де рушине ши сэ дя ынапой","poem":2},{"lineBreak":true},{"text":"тоць чей че урэск Сионул!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Сэ фие ка ярба де пе акоперишурь,","poem":2},{"lineBreak":true},{"text":"каре се усукэ ынаинте де а фи смулсэ!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Сечерэторул ну-шь умпле мына ку еа,","poem":2},{"lineBreak":true},{"text":"чел че лягэ снопий ну-шь ынкаркэ брацул ку еа","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ши трекэторий ну зик:","poem":2},{"lineBreak":true},{"text":"„Бинекувынтаря Домнулуй сэ фие песте вой!","poem":2},{"lineBreak":true},{"text":"Вэ бинекувынтэм ын Нумеле Домнулуй!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}