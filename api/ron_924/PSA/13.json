{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Пынэ кынд, Доамне, мэ вей уйта неынчетат?","poem":1},{"text":"Пынэ кынд Ыць вей аскунде Фаца де мине?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Пынэ кынд вой авя суфлетул плин де грижь","poem":2},{"lineBreak":true},{"text":"ши инима плинэ де неказурь ын фиекаре зи?","poem":2},{"lineBreak":true},{"text":"Пынэ кынд се ва ридика врэжмашул меу ымпотрива мя?","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Привеште, рэспунде-мь, Доамне, Думнезеул меу!","poem":2},{"lineBreak":true},{"text":"Дэ луминэ окилор мей, ка сэ н-адорм сомнул морций,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ка сэ ну зикэ врэжмашул меу: „Л-ам бируит”","poem":2},{"lineBreak":true},{"text":"ши сэ ну се букуре потривничий мей кынд мэ клатин!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Еу ам ынкредере ын бунэтатя Та,","poem":2},{"lineBreak":true},{"text":"сунт ку инима веселэ дин причина мынтуирий Тале:","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"кынт Домнулуй,","poem":2},{"lineBreak":true},{"text":"кэч мь-а фэкут бине!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}