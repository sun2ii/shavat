{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"Дин фундул адынкулуй, Те кем, Доамне!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Доамне, аскултэ-мь гласул!","poem":1},{"text":"Сэ я аминте урекиле Тале","poem":2},{"lineBreak":true},{"text":"ла гласул черерилор меле!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Дакэ ай пэстра, Доамне, адучеря аминте а нелеӂюирилор,","poem":2},{"lineBreak":true},{"text":"чине ар путя ста ын пичоаре, Доамне?","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Дар ла Тине есте ертаре,","poem":2},{"lineBreak":true},{"text":"ка сэ фий де темут.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Еу нэдэждуеск ын Домнул, суфлетул меу нэдэждуеште","poem":2},{"lineBreak":true},{"text":"ши аштепт фэгэдуинца Луй.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Суфлетул меу аштяптэ пе Домнул","poem":2},{"lineBreak":true},{"text":"май мулт декыт аштяптэ стрэжерий диминяца,","poem":2},{"lineBreak":true},{"text":"да, май мулт декыт аштяптэ стрэжерий диминяца.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Исраеле, пуне-ць нэдеждя ын Домнул,","poem":2},{"lineBreak":true},{"text":"кэч ла Домнул есте ындураря","poem":2},{"lineBreak":true},{"text":"ши ла Ел есте белшуг де рэскумпэраре!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ел ва рэскумпэра пе Исраел","poem":2},{"lineBreak":true},{"text":"дин тоате нелеӂюириле луй.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}