{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"verse","number":1,"content":[{"text":"Доамне, аду-Ць аминте де Давид","poem":1},{"text":"ши де тоате неказуриле луй!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Аду-Ць аминте кум а журат ел Домнулуй","poem":2},{"lineBreak":true},{"text":"ши а фэкут урмэтоаря журуинцэ Путерникулуй луй Иаков:","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"„Ну вой интра ын кортул ын каре локуеск,","poem":2},{"lineBreak":true},{"text":"ну мэ вой суи ын патул ын каре мэ одихнеск,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ну вой да сомн окилор мей,","poem":2},{"lineBreak":true},{"text":"нич аципире плеоапелор меле","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"пынэ ну вой гэси ун лок пентру Домнул,","poem":2},{"lineBreak":true},{"text":"о локуинцэ пентру Путерникул луй Иаков.”","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ятэ, ам аузит ворбинду-се деспре ел ла Ефрата,","poem":2},{"lineBreak":true},{"text":"л-ам гэсит ын огорул Иаар…","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"„Хайдем ла локуинца Луй,","poem":2},{"lineBreak":true},{"text":"сэ не ынкинэм ынаинтя аштернутулуй пичоарелор Луй!…","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Скоалэ-Те, Доамне, вино ла локул Тэу де одихнэ,","poem":2},{"lineBreak":true},{"text":"Ту ши кивотул мэрецией Тале!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Преоций Тэй сэ се ымбраче ын неприхэнире","poem":2},{"lineBreak":true},{"text":"ши крединчоший Тэй сэ скоатэ стригэте де букурие!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Пентру робул Тэу Давид,","poem":2},{"lineBreak":true},{"text":"ну лепэда пе унсул Тэу!”","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Домнул а журат луй Давид адевэрул","poem":2},{"lineBreak":true},{"text":"ши ну Се ва ынтоарче де ла че а журат:","poem":2},{"lineBreak":true},{"text":"„Вой пуне пе скаунул тэу де домние ун фиу дин трупул тэу.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Дакэ фиий тэй вор пэзи легэмынтул Меу","poem":2},{"lineBreak":true},{"text":"ши ынвэцэтуриле Меле пе каре ли ле вой да,","poem":2},{"lineBreak":true},{"text":"вор шедя ши фиий лор ын вечь пе скаунул тэу де домние.”","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Да, Домнул а алес Сионул,","poem":2},{"lineBreak":true},{"text":"л-а дорит ка локуинцэ а Луй ши а зис:","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"„Ачеста есте локул Меу де одихнэ пе вечие;","poem":2},{"lineBreak":true},{"text":"вой локуи ын ел, кэч л-ам дорит.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ый вой бинекувынта дин белшуг храна,","poem":2},{"lineBreak":true},{"text":"вой сэтура ку пыне пе сэрачий луй.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Вой ымбрэка ын мынтуире пе преоций луй","poem":2},{"lineBreak":true},{"text":"ши крединчоший луй вор скоате стригэте де букурие.","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Аколо вой ынэлца путеря луй Давид,","poem":2},{"lineBreak":true},{"text":"вой прегэти о канделэ унсулуй Меу,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"вой ымбрэка ку рушине пе врэжмаший луй","poem":2},{"lineBreak":true},{"text":"ши песте ел ва стрэлучи кунуна луй.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}