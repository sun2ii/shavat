{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Лэудаць пе Домнул!","poem":1},{"text":"Лэудаць Нумеле Домнулуй,","poem":2},{"lineBreak":true},{"text":"лэудаци-Л, робь ай Домнулуй,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"каре стаць ын Каса Домнулуй,","poem":2},{"lineBreak":true},{"text":"ын курциле Касей Думнезеулуй ностру!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Лэудаць пе Домнул, кэч Домнул есте бун;","poem":2},{"lineBreak":true},{"text":"кынтаць Нумеле Луй, кэч есте биневоитор!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Кэч Домнул Шь-а алес пе Иаков,","poem":2},{"lineBreak":true},{"text":"пе Исраел, ка сэ фие ал Луй.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Штиу кэ Домнул есте маре","poem":2},{"lineBreak":true},{"text":"ши кэ Домнул ностру есте май пресус де тоць думнезеий.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Домнул фаче тот че вря","poem":2},{"lineBreak":true},{"text":"ын черурь ши пе пэмынт,","poem":2},{"lineBreak":true},{"text":"ын мэрь ши ын тоате адынкуриле.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ел ридикэ норий де ла марӂиниле пэмынтулуй,","poem":2},{"lineBreak":true},{"text":"дэ наштере ла фулӂере ши плоае","poem":2},{"lineBreak":true},{"text":"ши скоате вынтул дин кэмэриле луй.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ел а ловит пе ынтыий нэскуць ай Еӂиптулуй,","poem":2},{"lineBreak":true},{"text":"де ла оамень пынэ ла добитоаче.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"А тримис семне ши минунь ын мижлокул тэу, Еӂиптуле:","poem":2},{"lineBreak":true},{"text":"ымпотрива луй Фараон ши ымпотрива тутурор служиторилор луй.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"А ловит мулте нямурь","poem":2},{"lineBreak":true},{"text":"ши а учис ымпэраць путерничь:","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"пе Сихон, ымпэратул аморицилор,","poem":2},{"lineBreak":true},{"text":"пе Ог, ымпэратул Басанулуй,","poem":2},{"lineBreak":true},{"text":"ши пе тоць ымпэраций Канаанулуй;","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ши ле-а дат цара де моштенире,","poem":2},{"lineBreak":true},{"text":"де моштенире попорулуй Сэу Исраел.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Доамне, Нумеле Тэу рэмыне пе вечие;","poem":2},{"lineBreak":true},{"text":"Доамне, помениря Та цине дин ням ын ням,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"кэч Домнул ва жудека пе попорул Сэу","poem":2},{"lineBreak":true},{"text":"ши ва авя милэ де робий Сэй.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Идолий нямурилор сунт арӂинт ши аур,","poem":2},{"lineBreak":true},{"text":"лукраре фэкутэ де мыниле оаменилор.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ау гурэ, ши ну ворбеск,","poem":2},{"lineBreak":true},{"text":"ау окь, ши ну вэд,","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ау урекь, ши тотушь н-ауд,","poem":2},{"lineBreak":true},{"text":"да, н-ау суфларе ын гурэ.","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ка ей сунт чей че-й фак,","poem":2},{"lineBreak":true},{"text":"тоць чей че се ынкред ын ей.","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Каса луй Исраел, бинекувынтаць пе Домнул!","poem":2},{"lineBreak":true},{"text":"Каса луй Аарон, бинекувынтаць пе Домнул!","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Каса луй Леви, бинекувынтаць пе Домнул!","poem":2},{"lineBreak":true},{"text":"Чей че вэ темець де Домнул, бинекувынтаць пе Домнул!","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Домнул сэ фие бинекувынтат дин Сион,","poem":2},{"lineBreak":true},{"text":"Ел, каре локуеште ын Иерусалим!","poem":2},{"lineBreak":true},{"text":"Лэудаць пе Домнул!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}