{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Лэудаць пе Домнул, кэч есте бун,","poem":1},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Лэудаць пе Думнезеул думнезеилор,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Лэудаць пе Домнул домнилор,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Пе Чел че сингур фаче минунь марь,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Пе Чел че а фэкут черуриле ку причепере,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Пе Чел че а ынтинс пэмынтул пе апе,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Пе Чел че а фэкут луминэторь марь,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Соареле, ка сэ стэпыняскэ зиуа,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Луна ши стелеле, ка сэ стэпыняскэ ноаптя,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Пе Чел че а ловит пе еӂиптень ын ынтыий лор нэскуць,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ши а скос пе Исраел дин мижлокул лор,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ку мынэ таре ши ку брац ынтинс,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Пе Чел че а тэят ын доуэ Маря Рошие,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Каре а трекут пе Исраел прин мижлокул ей,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ши а арункат пе Фараон ши оштиря луй ын Маря Рошие,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Пе Чел че а кэлэузит пе попорул Сэу ын пустиу,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Пе Чел че а ловит ымпэраць марь,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Пе Чел че а учис ымпэраць путерничь,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Пе Сихон, ымпэратул аморицилор,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ши пе Ог, ымпэратул Басанулуй,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ши ле-а дат цара де моштенире,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Де моштенире робулуй Сэу Исраел,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Пе Чел че Шь-а адус аминте де ной кынд ерам смериць,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ши не-а избэвит де асуприторий ноштри,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Пе Чел че дэ хранэ орькэрей фэптурь,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Лэудаць пе Думнезеул черурилор,","poem":2},{"lineBreak":true},{"text":"кэч ын вяк цине ындураря Луй!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}