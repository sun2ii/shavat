{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Пе малуриле рыурилор Бабилонулуй,","poem":1},{"text":"шедям жос ши плынӂям","poem":2},{"lineBreak":true},{"text":"кынд не адучям аминте де Сион.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ын сэлчииле дин цинутул ачела","poem":2},{"lineBreak":true},{"text":"не атырнасерэм харпеле.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Кэч, аколо, бируиторий ноштри не черяу кынтэрь","poem":2},{"lineBreak":true},{"text":"ши асуприторий ноштри не черяу букурие зикынд:","poem":2},{"lineBreak":true},{"text":"„Кынтаци-не кытева дин кынтэриле Сионулуй!”","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Кум сэ кынтэм ной кынтэриле Домнулуй","poem":2},{"lineBreak":true},{"text":"пе ун пэмынт стрэин?","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Дакэ те вой уйта, Иерусалиме,","poem":2},{"lineBreak":true},{"text":"сэ-шь уйте дряпта мя дестойничия ей!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Сэ ми се липяскэ лимба де черул гурий","poem":2},{"lineBreak":true},{"text":"дакэ ну-мь вой адуче аминте де тине,","poem":2},{"lineBreak":true},{"text":"дакэ ну вой фаче дин Иерусалим","poem":2},{"lineBreak":true},{"text":"кулмя букурией меле!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Аду-Ць аминте, Доамне, де копиий Едомулуй,","poem":2},{"lineBreak":true},{"text":"каре, ын зиуа ненорочирий Иерусалимулуй,","poem":2},{"lineBreak":true},{"text":"зичяу: „Радеци-л, радеци-л","poem":2},{"lineBreak":true},{"text":"дин темелий!”","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ах! фийка Бабилонулуй, сортитэ пустиирий,","poem":2},{"lineBreak":true},{"text":"фериче де чине-ць ва ынтоарче ла фел","poem":2},{"lineBreak":true},{"text":"рэул пе каре ни л-ай фэкут!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Фериче де чине ва апука пе прунчий тэй","poem":2},{"lineBreak":true},{"text":"ши-й ва здроби де стынкэ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}