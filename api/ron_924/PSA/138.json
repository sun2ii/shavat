{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"verse","number":1,"content":[{"text":"Те лауд дин тоатэ инима,","poem":1},{"text":"кынт лауделе Тале ынаинтя думнезеилор.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Мэ ынкин ын Темплул Тэу чел сфынт","poem":2},{"lineBreak":true},{"text":"ши лауд Нумеле Тэу пентру бунэтатя ши крединчошия Та,","poem":2},{"lineBreak":true},{"text":"кэч Ци с-а мэрит файма прин ымплиниря фэгэдуинцелор Тале.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ын зиуа кынд Те-ам кемат, м-ай аскултат,","poem":2},{"lineBreak":true},{"text":"м-ай ымбэрбэтат ши мь-ай ынтэрит суфлетул.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Тоць ымпэраций пэмынтулуй Те вор лэуда, Доамне,","poem":2},{"lineBreak":true},{"text":"кынд вор аузи кувинтеле гурий Тале;","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ей вор лэуда кэиле Домнулуй,","poem":2},{"lineBreak":true},{"text":"кэч маре есте слава Домнулуй!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Домнул есте ынэлцат, тотушь веде пе чей смериць","poem":2},{"lineBreak":true},{"text":"ши куноаште де департе пе чей ынгымфаць.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Кынд умблу ын мижлокул стрымторэрий, Ту мэ ынвиорезь,","poem":2},{"lineBreak":true},{"text":"Ыць ынтинзь мына спре мыния врэжмашилор мей","poem":2},{"lineBreak":true},{"text":"ши дряпта Та мэ мынтуеште.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Домнул ва сфырши че а ынчепут пентру мине.","poem":2},{"lineBreak":true},{"text":"Доамне, бунэтатя Та цине ын вечь:","poem":2},{"lineBreak":true},{"text":"ну пэрэси лукрэриле мынилор Тале.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}