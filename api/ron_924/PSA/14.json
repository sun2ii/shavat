{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Небунул зиче ын инима луй: „Ну есте Думнезеу!”","poem":1},{"text":"С-ау стрикат оамений, фак фапте урыте;","poem":2},{"lineBreak":true},{"text":"ну есте ничунул каре сэ факэ бинеле.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Домнул Се уйтэ де ла ынэлцимя черурилор песте фиий оаменилор,","poem":2},{"lineBreak":true},{"text":"сэ вадэ де есте вреунул каре сэ айбэ причепере","poem":2},{"lineBreak":true},{"text":"ши каре сэ кауте пе Думнезеу.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Дар тоць с-ау рэтэчит, тоць с-ау доведит ниште нетребничь;","poem":2},{"lineBreak":true},{"text":"ну есте ничунул каре сэ факэ бинеле, ничунул мэкар.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Шь-ау пердут минтя тоць чей че сэвыршеск фэрэделеӂя","poem":2},{"lineBreak":true},{"text":"де мэнынкэ пе попорул Меу кум мэнынкэ пыня","poem":2},{"lineBreak":true},{"text":"ши ну кямэ пе Домнул?","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ей вор тремура де спаймэ","poem":2},{"lineBreak":true},{"text":"кынд Се ва арэта Думнезеу ын мижлокул нямулуй неприхэнит.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Рыдець вой де нэдеждя челуй ненорочит…,","poem":2},{"lineBreak":true},{"text":"дар скэпаря луй есте Домнул.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"О, де ар порни дин Сион избэвиря луй Исраел!…","poem":2},{"lineBreak":true},{"text":"Кынд ва ынтоарче Домнул ынапой пе принший де рэзбой ай попорулуй Сэу,","poem":2},{"lineBreak":true},{"text":"Иаков се ва весели ши Исраел се ва букура.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}