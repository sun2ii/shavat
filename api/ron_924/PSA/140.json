{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"verse","number":1,"content":[{"text":"Скапэ-мэ, Доамне, де оамений чей рэй!","poem":1},{"text":"Пэзеште-мэ де оамений асуприторь,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"каре куӂетэ лукрурь реле ын инима лор","poem":2},{"lineBreak":true},{"text":"ши сунт тотдяуна гата сэ ацыце рэзбоюл!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ей ышь аскут лимба ка ун шарпе,","poem":2},{"lineBreak":true},{"text":"ау пе бузе о отравэ де нэпыркэ.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Пэзеште-мэ, Доамне, де мыниле челуй рэу!","poem":2},{"lineBreak":true},{"text":"Фереште-мэ де оамений асуприторь,","poem":2},{"lineBreak":true},{"text":"каре се гындеск сэ мэ добоаре!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ниште ынгымфаць ымь ынтинд курсе ши лацурь,","poem":2},{"lineBreak":true},{"text":"пун рецеле де-а лунгул друмулуй","poem":2},{"lineBreak":true},{"text":"ши ымь ынтинд капкане.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Еу зик Домнулуй: „Ту ешть Думнезеул меу!","poem":2},{"lineBreak":true},{"text":"Я аминте, Доамне, ла гласул ругэчунилор меле!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Доамне Думнезеуле, тэрия мынтуирий меле,","poem":2},{"lineBreak":true},{"text":"Ту-мь акоперь капул ын зиуа луптей.”","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ну ымплини, Доамне, доринцеле челуй рэу,","poem":2},{"lineBreak":true},{"text":"ну лэса сэ-й избутяскэ плануриле, ка сэ ну се фэляскэ!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Асупра капулуй челор че мэ ынконжоарэ","poem":2},{"lineBreak":true},{"text":"сэ кадэ нелеӂюиря бузелор лор!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Кэрбунь априншь сэ кадэ песте ей!","poem":2},{"lineBreak":true},{"text":"Ын фок сэ фие арункаць,","poem":2},{"lineBreak":true},{"text":"ын адынкурь, де унде сэ ну се май скоале!","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Омул ку лимба минчиноасэ ну се ынтэреште пе пэмынт","poem":2},{"lineBreak":true},{"text":"ши пе омул асупритор ненорочиря ыл паште ши-л дуче ла перзание.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Штиу кэ Домнул фаче дрептате челуй обиждуит,","poem":2},{"lineBreak":true},{"text":"дрептате челор липсиць.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Да, чей неприхэниць вор лэуда Нумеле Тэу,","poem":2},{"lineBreak":true},{"text":"оамений фэрэ приханэ вор локуи ынаинтя Та.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}