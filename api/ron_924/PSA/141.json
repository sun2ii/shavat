{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"verse","number":1,"content":[{"text":"Доамне, еу Те кем; вино деграбэ ла мине!","poem":1},{"text":"Я аминте ла гласул меу кынд Те кем!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ка тэмыя сэ фие ругэчуня мя ынаинтя Та","poem":2},{"lineBreak":true},{"text":"ши ка жертфа де сярэ сэ фие ридикаря мынилор меле!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Пуне, Доамне, о стражэ ынаинтя гурий меле","poem":2},{"lineBreak":true},{"text":"ши пэзеште уша бузелор меле!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ну-мь абате инима ла лукрурь реле,","poem":2},{"lineBreak":true},{"text":"ла фапте виновате ымпреунэ ку оамений каре фак рэул,","poem":2},{"lineBreak":true},{"text":"ши сэ ну мэнынк дин оспецеле лор!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ловяскэ-мэ чел неприхэнит, кэч ловиря луй ымь есте бине-венитэ;","poem":2},{"lineBreak":true},{"text":"педепсяскэ-мэ, кэч педяпса луй есте ка унтделемнул турнат пе капул меу!","poem":2},{"lineBreak":true},{"text":"Сэ ну-мь ынторк капул де ла еа:","poem":2},{"lineBreak":true},{"text":"дар ругэчуня мя се ва ынэлца ынтруна ымпотрива рэутэций лор.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Кынд ли се вор прэвэли жудекэторий де-а лунгул стынчилор,","poem":2},{"lineBreak":true},{"text":"атунч вор аскулта кувинтеле меле ши вор ведя кэ сунт плэкуте.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Кум се брэздязэ ши се спинтекэ пэмынтул,","poem":2},{"lineBreak":true},{"text":"аша ни се рисипеск оаселе ла гура мормынтулуй.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Де ачея, кэтре Тине, Доамне Думнезеуле, ымь ындрепт окий,","poem":2},{"lineBreak":true},{"text":"ла Тине каут адэпост; ну-мь пэрэси суфлетул!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Пэзеште-мэ де курса пе каре мь-о ынтинд ей","poem":2},{"lineBreak":true},{"text":"ши де педичиле челор че фак рэул!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Сэ кадэ чей рэй ын лацуриле лор,","poem":2},{"lineBreak":true},{"text":"ын тимп че еу сэ скап!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}