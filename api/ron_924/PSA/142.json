{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"verse","number":1,"content":[{"text":"Ку гласул меу стриг кэтре Домнул,","poem":1},{"text":"ку гласул меу мэ рог кэтре Домнул.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ымь вэрс неказул ынаинтя Луй","poem":2},{"lineBreak":true},{"text":"ши-мь повестеск стрымтораря ынаинтя Луй.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Кынд ымь есте мыхнит духул ын мине, Ту ымь куношть кэраря.","poem":2},{"lineBreak":true},{"text":"Пе друмул пе каре умблу, мь-ау ынтинс о курсэ.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Арункэ-Ць окий ла дряпта ши привеште! Нимень ну мэ май куноаште,","poem":2},{"lineBreak":true},{"text":"орьче скэпаре есте пердутэ пентру мине, нимэнуй ну-й пасэ де суфлетул меу.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Доамне, кэтре Тине стриг ши зик: „Ту ешть скэпаря мя,","poem":2},{"lineBreak":true},{"text":"партя мя де моштенире пе пэмынтул челор вий.”","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Я аминте ла стригэтеле меле, кэч сунт ненорочит де тот!","poem":2},{"lineBreak":true},{"text":"Избэвеште-мэ де чей че мэ пригонеск, кэч сунт май тарь декыт мине!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Скоате-мь суфлетул дин темницэ, ка сэ лауд Нумеле Тэу!","poem":2},{"lineBreak":true},{"text":"Чей неприхэниць вор вени сэ мэ ынконжоаре кынд ымь вей фаче бине.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}