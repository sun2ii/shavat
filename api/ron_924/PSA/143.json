{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"verse","number":1,"content":[{"text":"Доамне, аскултэ-мь ругэчуня, плякэ-Ць урекя ла черериле меле!","poem":1},{"text":"Аскултэ-мэ ын крединчошия ши дрептатя Та!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ну интра ла жудекатэ ку робул Тэу!","poem":2},{"lineBreak":true},{"text":"Кэч ничун ом виу ну есте фэрэ приханэ ынаинтя Та.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Врэжмашул ымь урмэреште суфлетул,","poem":2},{"lineBreak":true},{"text":"ымь калкэ вяца ын пичоаре ла пэмынт:","poem":2},{"lineBreak":true},{"text":"мэ фаче сэ локуеск ын ынтунерик, ка чей че ау мурит де мултэ време.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ымь есте мыхнит духул ын мине,","poem":2},{"lineBreak":true},{"text":"ымь есте тулбуратэ инима ынэунтрул меу.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Мь-адук аминте де зилеле де одиниоарэ,","poem":2},{"lineBreak":true},{"text":"мэ гындеск ла тоате лукрэриле Тале,","poem":2},{"lineBreak":true},{"text":"куӂет ла лукраря мынилор Тале.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ымь ынтинд мыниле спре Тине;","poem":2},{"lineBreak":true},{"text":"ымь суспинэ суфлетул дупэ Тине ка ун пэмынт ускат.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Грэбеште де м-аскултэ, Доамне!","poem":2},{"lineBreak":true},{"text":"Ми се топеште духул:","poem":2},{"lineBreak":true},{"text":"ну-мь аскунде Фаца Та!","poem":2},{"lineBreak":true},{"text":"Кэч аш ажунӂе атунч ка чей че се кобоарэ ын гроапэ.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Фэ-мэ сэ ауд дис-де-диминяцэ бунэтатя Та,","poem":2},{"lineBreak":true},{"text":"кэч мэ ынкред ын Тине.","poem":2},{"lineBreak":true},{"text":"Аратэ-мь каля пе каре требуе сэ умблу,","poem":2},{"lineBreak":true},{"text":"кэч ла Тине ымь ыналц суфлетул.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Скапэ-мэ де врэжмаший мей, Доамне,","poem":2},{"lineBreak":true},{"text":"кэч ла Тине каут адэпост!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ынвацэ-мэ сэ фак воя Та, кэч Ту ешть Думнезеул меу!","poem":2},{"lineBreak":true},{"text":"Духул Тэу чел бун сэ мэ кэлэузяскэ пе каля чя дряптэ!","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Пентру Нумеле Тэу, Доамне, ынвиорязэ-мэ;","poem":2},{"lineBreak":true},{"text":"ын дрептатя Та, скоате-мь суфлетул дин неказ!","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ын бунэтатя Та, нимичеште пе врэжмаший мей","poem":2},{"lineBreak":true},{"text":"ши перде пе тоць потривничий суфлетулуй меу,","poem":2},{"lineBreak":true},{"text":"кэч еу сунт робул Тэу.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}