{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Лэудаць пе Домнул!","poem":1},{"text":"Лаудэ, суфлете, пе Домнул!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Вой лэуда пе Домнул кыт вой трэи,","poem":2},{"lineBreak":true},{"text":"вой лэуда пе Думнезеул меу кыт вой фи.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ну вэ ынкредець ын чей марь,","poem":2},{"lineBreak":true},{"text":"ын фиий оаменилор, ын каре ну есте ажутор.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Суфларя лор трече, се ынторк ын пэмынт","poem":2},{"lineBreak":true},{"text":"ши ын ачеяшь зи ле пер ши плануриле лор.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Фериче де чине аре ка ажутор пе Думнезеул луй Иаков,","poem":2},{"lineBreak":true},{"text":"фериче де чине-шь пуне нэдеждя ын Домнул Думнезеул сэу!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ел а фэкут черуриле ши пэмынтул,","poem":2},{"lineBreak":true},{"text":"маря ши тот че есте ын еа.","poem":2},{"lineBreak":true},{"text":"Ел цине крединчошия ын вечь.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ел фаче дрептате челор асуприць;","poem":2},{"lineBreak":true},{"text":"дэ пыне челор флэмынзь;","poem":2},{"lineBreak":true},{"text":"Домнул избэвеште пе принший де рэзбой;","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Домнул дескиде окий орбилор;","poem":2},{"lineBreak":true},{"text":"Домнул ындряптэ пе чей ынковояць;","poem":2},{"lineBreak":true},{"text":"Домнул юбеште пе чей неприхэниць.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Домнул окротеште пе чей стрэинь,","poem":2},{"lineBreak":true},{"text":"сприжинэ пе орфан ши пе вэдувэ,","poem":2},{"lineBreak":true},{"text":"дар рэстоарнэ каля челор рэй.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Домнул ымпэрэцеште ын вечь;","poem":2},{"lineBreak":true},{"text":"Думнезеул тэу, Сиоане, рэмыне дин вяк ын вяк!","poem":2},{"lineBreak":true},{"text":"Лэудаць пе Домнул!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}