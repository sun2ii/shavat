{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Лэудаць пе Домнул!","poem":1},{"text":"Кэч есте фрумос сэ лэудэм пе Думнезеул ностру,","poem":2},{"lineBreak":true},{"text":"кэч есте плэкут ши се кувине сэ-Л лэудэм.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Домнул зидеште ярэшь Иерусалимул,","poem":2},{"lineBreak":true},{"text":"стрынӂе пе сургюниций луй Исраел,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"тэмэдуеште пе чей ку инима здробитэ","poem":2},{"lineBreak":true},{"text":"ши ле лягэ рэниле.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ел сокотеште нумэрул стелелор","poem":2},{"lineBreak":true},{"text":"ши ле дэ нуме ла тоате.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Маре есте Домнул ностру ши путерник прин тэрия Луй,","poem":2},{"lineBreak":true},{"text":"причеперя Луй есте фэрэ марӂинь.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Домнул сприжинэ пе чей ненорочиць","poem":2},{"lineBreak":true},{"text":"ши добоарэ пе чей рэй ла пэмынт.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Кынтаць Домнулуй ку мулцумирь,","poem":2},{"lineBreak":true},{"text":"лэудаць пе Думнезеул ностру ку харпа!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ел акоперэ черул ку норь,","poem":2},{"lineBreak":true},{"text":"прегэтеште плоая пентру пэмынт","poem":2},{"lineBreak":true},{"text":"ши фаче сэ рэсарэ ярба пе мунць.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ел дэ хранэ вителор","poem":2},{"lineBreak":true},{"text":"ши пуилор корбулуй кынд стригэ.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ну де путеря калулуй Се букурэ Ел,","poem":2},{"lineBreak":true},{"text":"ну-Шь гэсеште плэчеря ын пичоареле омулуй.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Домнул юбеште пе чей че се тем де Ел,","poem":2},{"lineBreak":true},{"text":"пе чей че нэдэждуеск ын бунэтатя Луй.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Лаудэ пе Домнул, Иерусалиме,","poem":2},{"lineBreak":true},{"text":"лаудэ пе Думнезеул тэу, Сиоане!","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Кэч Ел ынтэреште зэвоареле порцилор,","poem":2},{"lineBreak":true},{"text":"Ел бинекувынтязэ пе фиий тэй ын мижлокул тэу;","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ел дэ паче цинутулуй тэу","poem":2},{"lineBreak":true},{"text":"ши те сатурэ ку чел май бун грыу.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ел Ышь тримите порунчиле пе пэмынт,","poem":2},{"lineBreak":true},{"text":"Кувынтул Луй аляргэ ку юцялэ маре.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ел дэ зэпада ка лына,","poem":2},{"lineBreak":true},{"text":"Ел пресарэ брума албэ ка ченуша.","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ел Ышь азвырле гяца ын букэць:","poem":2},{"lineBreak":true},{"text":"чине поате ста ынаинтя фригулуй Сэу?","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ел Ышь тримите Кувынтул Сэу ши ле топеште;","poem":2},{"lineBreak":true},{"text":"пуне сэ суфле вынтул Луй, ши апеле кург.","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ел дескоперэ луй Иаков Кувынтул Сэу,","poem":2},{"lineBreak":true},{"text":"луй Исраел, леӂиле ши порунчиле Сале.","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ел н-а лукрат аша ку тоате нямуриле","poem":2},{"lineBreak":true},{"text":"ши еле ну куноск порунчиле Луй.","poem":2},{"lineBreak":true},{"text":"Лэудаць пе Домнул!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}