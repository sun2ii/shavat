{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Лэудаць пе Домнул!","poem":1},{"text":"Лэудаць пе Домнул дин ынэлцимя черурилор,","poem":2},{"lineBreak":true},{"text":"лэудаци-Л ын локуриле челе ыналте!","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Лэудаци-Л, тоць ынӂерий Луй!","poem":2},{"lineBreak":true},{"text":"Лэудаци-Л, тоате оштириле Луй!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Лэудаци-Л, соаре ши лунэ!","poem":2},{"lineBreak":true},{"text":"Лэудаци-Л, тоате стелеле луминоасе!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Лэудаци-Л, черуриле черурилор","poem":2},{"lineBreak":true},{"text":"ши вой, апе, каре сунтець май пресус де черурь!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Сэ лауде Нумеле Домнулуй,","poem":2},{"lineBreak":true},{"text":"кэч Ел а порунчит ши ау фост фэкуте,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ле-а ынтэрит пе вечь де вечь,","poem":2},{"lineBreak":true},{"text":"ле-а дат леӂь ши ну ле ва кэлка.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Лэудаць пе Домнул де жос, де пе пэмынт,","poem":2},{"lineBreak":true},{"text":"балаурь де маре ши адынкурь тоате,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"фок ши гриндинэ, зэпадэ ши чацэ,","poem":2},{"lineBreak":true},{"text":"вынтурь нэпрасниче, каре ымплиниць порунчиле Луй,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"мунць ши дялурь тоате,","poem":2},{"lineBreak":true},{"text":"помь родиторь ши чедри, тоць,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"фяре ши вите, тоате,","poem":2},{"lineBreak":true},{"text":"тырытоаре ши пэсэрь ынарипате,","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ымпэраць ай пэмынтулуй ши попоаре тоате,","poem":2},{"lineBreak":true},{"text":"воевозь ши тоць жудекэторий пэмынтулуй,","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"тинерь ши тинере,","poem":2},{"lineBreak":true},{"text":"бэтрынь ши копий!","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Сэ лауде Нумеле Домнулуй!","poem":2},{"lineBreak":true},{"text":"Кэч нумай Нумеле Луй есте ынэлцат:","poem":2},{"lineBreak":true},{"text":"мэреция Луй есте май пресус де пэмынт ши черурь.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ел а ынэлцат тэрия попорулуй Сэу:","poem":2},{"lineBreak":true},{"text":"ятэ о причинэ де лаудэ пентру тоць крединчоший Луй,","poem":2},{"lineBreak":true},{"text":"пентру копиий луй Исраел, попор де лынгэ Ел.","poem":2},{"lineBreak":true},{"text":"Лэудаць пе Домнул!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}