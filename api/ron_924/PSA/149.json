{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Лэудаць пе Домнул!","poem":1},{"text":"Кынтаць Домнулуй о кынтаре ноуэ,","poem":2},{"lineBreak":true},{"text":"кынтаць лауделе Луй ын адунаря крединчошилор Луй!","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Сэ се букуре Исраел де Чел че л-а фэкут,","poem":2},{"lineBreak":true},{"text":"сэ се веселяскэ фиий Сионулуй де Ымпэратул лор!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Сэ лауде Нумеле Луй ку жокурь,","poem":2},{"lineBreak":true},{"text":"сэ-Л лауде ку тоба ши ку харпа!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Кэч Домнул аре плэчере де попорул Сэу","poem":2},{"lineBreak":true},{"text":"ши слэвеште пе чей ненорочиць мынтуинду-й.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Сэ салте де букурие крединчоший Луй ымбрэкаць ын славэ,","poem":2},{"lineBreak":true},{"text":"сэ скоатэ стригэте де букурие ын аштернутул лор!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Лауделе луй Думнезеу сэ фие ын гура лор","poem":2},{"lineBreak":true},{"text":"ши сабия ку доуэ тэишурь, ын мына лор,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ка сэ факэ рэзбунаре асупра нямурилор","poem":2},{"lineBreak":true},{"text":"ши сэ педепсяскэ попоареле;","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"сэ леӂе пе ымпэраций лор ку ланцурь","poem":2},{"lineBreak":true},{"text":"ши пе май-марий лор ку обезь де фер,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ка сэ адукэ ла ындеплинире ымпотрива лор жудеката скрисэ!","poem":2},{"lineBreak":true},{"text":"Ачаста есте о чинсте пентру тоць крединчоший Луй.","poem":2},{"lineBreak":true},{"text":"Лэудаць пе Домнул!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}