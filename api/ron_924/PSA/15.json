{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Доамне, чине ва локуи ын кортул Тэу?","poem":1},{"text":"Чине ва локуи пе мунтеле Тэу чел сфынт?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Чел че умблэ ын неприхэнире, чел че фаче воя луй Думнезеу","poem":2},{"lineBreak":true},{"text":"ши спуне адевэрул дин инимэ.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ачела ну клеветеште ку лимба луй, ну фаче рэу семенулуй сэу","poem":2},{"lineBreak":true},{"text":"ши ну арункэ окарэ асупра апроапелуй сэу.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ел привеште ку диспрец пе чел вредник де диспрецуит,","poem":2},{"lineBreak":true},{"text":"дар чинстеште пе чей че се тем де Домнул.","poem":2},{"lineBreak":true},{"text":"Ел ну-шь я ворба ынапой дакэ фаче ун журэмынт ын пагуба луй.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ел ну-шь дэ баний ку добындэ","poem":2},{"lineBreak":true},{"text":"ши ну я митэ ымпотрива челуй невиноват.","poem":2},{"lineBreak":true},{"text":"Чел че се поартэ аша, ну се клатинэ ничодатэ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}