{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Пэзеште-мэ, Думнезеуле, кэч ын Тине мэ ынкред!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Еу зик Домнулуй: „Ту ешть Домнул меу,","poem":1},{"text":"Ту ешть сингура мя феричире!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Сфинций каре сунт ын царэ,","poem":2},{"lineBreak":true},{"text":"оамений евлавиошь, сунт тоатэ плэчеря мя.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Идолий се ынмулцеск, оамений аляргэ дупэ думнезей стрэинь,","poem":2},{"lineBreak":true},{"text":"дар еу н-адук жертфеле лор де сынӂе","poem":2},{"lineBreak":true},{"text":"ши ну пун нумеле лор пе бузеле меле.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Домнул есте партя мя де моштенире ши пахарул меу,","poem":2},{"lineBreak":true},{"text":"Ту ымь ындрепць сорцул меу.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"О моштенире плэкутэ мь-а кэзут ла сорць,","poem":2},{"lineBreak":true},{"text":"о фрумоасэ мошие мь-а фост датэ.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Еу бинекувынтез пе Домнул, каре мэ сфэтуеште,","poem":2},{"lineBreak":true},{"text":"кэч пынэ ши ноаптя ымь дэ ындемнурь инима.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ам некурмат пе Домнул ынаинтя окилор мей.","poem":2},{"lineBreak":true},{"text":"Кынд есте Ел ла дряпта мя, ну мэ клатин.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Де ачея инима ми се букурэ, суфлетул ми се веселеште","poem":2},{"lineBreak":true},{"text":"ши трупул ми се одихнеште ын линиште.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Кэч ну вей лэса суфлетул меу ын Локуинца морцилор,","poem":2},{"lineBreak":true},{"text":"ну вей ынгэдуи ка пряюбитул Тэу сэ вадэ путрезиря.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ымь вей арэта кэраря веций;","poem":2},{"lineBreak":true},{"text":"ынаинтя Фецей Тале сунт букурий неспусе","poem":2},{"lineBreak":true},{"text":"ши десфэтэрь вешниче, ын дряпта Та.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}