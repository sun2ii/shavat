{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Пентру че се ынтэрытэ нямуриле ши пентру че куӂетэ попоареле лукрурь дешарте?","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ымпэраций пэмынтулуй се рэскоалэ","poem":1},{"text":"ши домниторий се сфэтуеск ымпреунэ","poem":2},{"lineBreak":true},{"text":"ымпотрива Домнулуй ши ымпотрива Унсулуй Сэу, зикынд:","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"„Сэ ле рупем легэтуриле","poem":2},{"lineBreak":true},{"text":"ши сэ скэпэм де ланцуриле лор!”","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Чел че шаде ын черурь рыде,","poem":2},{"lineBreak":true},{"text":"Домнул Ышь бате жок де ей.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Апой, ын мыния Луй, ле ворбеште","poem":2},{"lineBreak":true},{"text":"ши-й ынгрозеште ку урӂия Са, зикынд:","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"„Тотушь Еу ам унс пе Ымпэратул Меу","poem":2},{"lineBreak":true},{"text":"пе Сион, мунтеле Меу чел сфынт.”","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"„Еу вой вести хотэрыря Луй”, зиче Унсул.","poem":2},{"lineBreak":true},{"text":"„Домнул Мь-а зис: ‘Ту ешть Фиул Меу!","poem":2},{"lineBreak":true},{"text":"Астэзь Те-ам нэскут.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Чере-Мь ши-Ць вой да нямуриле де моштенире","poem":2},{"lineBreak":true},{"text":"ши марӂиниле пэмынтулуй ын стэпынире!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ту ле вей здроби ку ун тояг де фер","poem":2},{"lineBreak":true},{"text":"ши ле вей сфэрыма ка пе васул унуй олар.’”","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Акум дар, ымпэраць, пуртаци-вэ ку ынцелепчуне!","poem":2},{"lineBreak":true},{"text":"Луаць ынвэцэтурэ, жудекэторий пэмынтулуй!","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Служиць Домнулуй ку фрикэ","poem":2},{"lineBreak":true},{"text":"ши букураци-вэ тремурынд.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Даць чинсте Фиулуй, ка сэ ну Се мыние","poem":2},{"lineBreak":true},{"text":"ши сэ ну периць пе каля воастрэ,","poem":2},{"lineBreak":true},{"text":"кэч мыния Луй есте гата сэ се априндэ!","poem":2},{"lineBreak":true},{"text":"Фериче де тоць кыць се ынкред ын Ел!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}