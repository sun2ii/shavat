{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Сэ те аскулте Домнул ын зиуа неказулуй,","poem":1},{"text":"сэ те окротяскэ Нумеле Думнезеулуй луй Иаков,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"сэ-ць тримитэ ажутор дин локашул Сэу чел Сфынт","poem":2},{"lineBreak":true},{"text":"ши сэ те сприжине дин Сион!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Сэ-Шь адукэ аминте де тоате даруриле тале де мынкаре","poem":2},{"lineBreak":true},{"text":"ши сэ-ць примяскэ ардериле-де-тот!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Сэ-ць дя че-ць дореште инима","poem":2},{"lineBreak":true},{"text":"ши сэ-ць ымплиняскэ тоате плануриле тале!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Атунч ной не вом букура де бируинца та","poem":2},{"lineBreak":true},{"text":"ши вом флутура стягул ын Нумеле Думнезеулуй ностру.","poem":2},{"lineBreak":true},{"text":"Домнул сэ-ць аскулте тоате доринцеле тале!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Штиу де акум кэ Домнул скапэ пе унсул Сэу","poem":2},{"lineBreak":true},{"text":"ши-й ва рэспунде дин черурь, дин Локашул Луй чел Сфынт,","poem":2},{"lineBreak":true},{"text":"прин ажуторул атотпутерник ал дрептей Луй.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Уний се бизуе пе кареле лор, алций, пе каий лор,","poem":2},{"lineBreak":true},{"text":"дар ной не бизуим пе Нумеле Домнулуй Думнезеулуй ностру.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ей се ындоае ши кад,","poem":2},{"lineBreak":true},{"text":"дар ной не ридикэм ши рэмынем ын пичоаре.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Скапэ, Доамне, пе ымпэратул","poem":2},{"lineBreak":true},{"text":"ши аскултэ-не кынд Те кемэм!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}