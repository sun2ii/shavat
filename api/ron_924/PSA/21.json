{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Доамне, ымпэратул се букурэ де окротиря путерникэ пе каре й-о дай Ту.","poem":1},{"text":"Ши кум ыл умпле де веселие ажуторул Тэу!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Й-ай дат че-й доря инима","poem":2},{"lineBreak":true},{"text":"ши н-ай лэсат неымплинит че-й черяу бузеле.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Кэч й-ай ешит ынаинте ку бинекувынтэрь де феричире","poem":2},{"lineBreak":true},{"text":"ши й-ай пус пе кап о кунунэ де аур курат.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ыць черя вяца ши й-ай дат-о:","poem":2},{"lineBreak":true},{"text":"о вяцэ лунгэ пентру тотдяуна ши пе вечие.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Маре есте слава луй ын урма ажуторулуй Тэу.","poem":2},{"lineBreak":true},{"text":"Ту пуй песте ел стрэлучиря ши мэреция.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ыл фачь пе вечие о причинэ де бинекувынтэрь","poem":2},{"lineBreak":true},{"text":"ши-л умпли де букурие ынаинтя Фецей Тале.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Кэч ымпэратул се ынкреде ын Домнул","poem":2},{"lineBreak":true},{"text":"ши бунэтатя Челуй Пряыналт ыл фаче сэ ну се клатине.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Мына та, ымпэрате, ва ажунӂе пе тоць врэжмаший тэй,","poem":2},{"lineBreak":true},{"text":"дряпта та ва ажунӂе пе чей че те урэск","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ши-й вей фаче ка ун куптор апринс,","poem":2},{"lineBreak":true},{"text":"ын зиуа кынд те вей арэта;","poem":2},{"lineBreak":true},{"text":"Домнул ый ва нимичи ын мыния Луй ши-й ва мынка фокул.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ле вей штерӂе сэмынца де пе пэмынт ши нямул лор дин мижлокул фиилор оаменилор.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ей ау урзит лукрурь реле ымпотрива та,","poem":2},{"lineBreak":true},{"text":"ау фэкут сфатурь реле, дар ну вор избути.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Кэч ый вей фаче сэ дя досул","poem":2},{"lineBreak":true},{"text":"ши вей траӂе ку аркул тэу асупра лор.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Скоалэ-те, Доамне, ку путеря Та,","poem":2},{"lineBreak":true},{"text":"ши вом кынта ши вом лэуда путеря Та!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}