{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Домнул есте Пэсторул меу: ну вой дуче липсэ де нимик.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ел мэ паште ын пэшунь верзь","poem":1},{"text":"ши мэ дуче ла апе де одихнэ;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ымь ынвиорязэ суфлетул","poem":2},{"lineBreak":true},{"text":"ши мэ повэцуеште пе кэрэрь дрепте","poem":2},{"lineBreak":true},{"text":"дин причина Нумелуй Сэу.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Кяр дакэ ар фи сэ умблу прин валя умбрей морций,","poem":2},{"lineBreak":true},{"text":"ну мэ тем де ничун рэу, кэч Ту ешть ку мине.","poem":2},{"lineBreak":true},{"text":"Тоягул ши нуяуа Та мэ мынгые.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ту ымь ынтинзь маса ын фаца потривничилор мей,","poem":2},{"lineBreak":true},{"text":"ымь унӂь капул ку унтделемн","poem":2},{"lineBreak":true},{"text":"ши пахарул меу есте плин де дэ песте ел.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Да, феричиря ши ындураря мэ вор ынсоци","poem":2},{"lineBreak":true},{"text":"ын тоате зилеле веций меле","poem":2},{"lineBreak":true},{"text":"ши вой локуи ын Каса Домнулуй пынэ ла сфыршитул зилелор меле.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}