{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Ал Домнулуй есте пэмынтул ку тот че есте пе ел,","poem":1},{"text":"лумя ши чей че о локуеск!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Кэч Ел л-а ынтемеят пе мэрь","poem":2},{"lineBreak":true},{"text":"ши л-а ынтэрит пе рыурь.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Чине ва путя сэ се суе ла мунтеле Домнулуй?","poem":2},{"lineBreak":true},{"text":"Чине се ва ридика пынэ ла Локул Луй чел Сфынт?","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Чел че аре мыниле невиновате ши инима куратэ,","poem":2},{"lineBreak":true},{"text":"чел че ну-шь дедэ суфлетул ла минчунэ","poem":2},{"lineBreak":true},{"text":"ши ну журэ ка сэ ыншеле.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ачела ва кэпэта бинекувынтаря Домнулуй,","poem":2},{"lineBreak":true},{"text":"старя дупэ воя Луй, датэ де Думнезеул мынтуирий луй.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ятэ партя де моштенире а челор че-Л кямэ,","poem":2},{"lineBreak":true},{"text":"а челор че каутэ Фаца Та, Думнезеул луй Иаков.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Порць, ридикаци-вэ капетеле;","poem":2},{"lineBreak":true},{"text":"ридикаци-вэ, порць вешниче,","poem":2},{"lineBreak":true},{"text":"ка сэ интре Ымпэратул славей!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"„Чине есте ачест Ымпэрат ал славей?”","poem":2},{"lineBreak":true},{"text":"Домнул чел таре ши путерник,","poem":2},{"lineBreak":true},{"text":"Домнул чел витяз ын лупте.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Порць, ридикаци-вэ капетеле;","poem":2},{"lineBreak":true},{"text":"ридикаци-ле, порць вешниче,","poem":2},{"lineBreak":true},{"text":"ка сэ интре Ымпэратул славей!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"„Чине есте ачест Ымпэрат ал славей?”","poem":2},{"lineBreak":true},{"text":"Домнул оштирилор:","poem":2},{"lineBreak":true},{"text":"Ел есте Ымпэратул славей!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}