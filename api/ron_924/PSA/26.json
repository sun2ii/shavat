{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"Фэ-мь дрептате, Доамне, кэч умблу ын невиновэцие","poem":1},{"text":"ши мэ ынкред ын Домнул фэрэ шовэире!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Черчетязэ-мэ, Доамне, ынчаркэ-мэ,","poem":2},{"lineBreak":true},{"text":"трече-мь прин купторул де фок рэрункий ши инима!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Кэч бунэтатя Та есте ынаинтя окилор мей","poem":2},{"lineBreak":true},{"text":"ши умблу ын адевэрул Тэу.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ну шед ымпреунэ ку оамений минчиношь","poem":2},{"lineBreak":true},{"text":"ши ну мерг ымпреунэ ку оамений виклень.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Урэск адунаря челор че фак рэул","poem":2},{"lineBreak":true},{"text":"ши ну стау ымпреунэ ку чей рэй.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ымь спэл мыниле ын невиновэцие","poem":2},{"lineBreak":true},{"text":"ши аша ынконжор алтарул Тэу, Доамне,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ка сэ избукнеск ын мулцумирь","poem":2},{"lineBreak":true},{"text":"ши сэ историсеск тоате минуниле Тале.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Доамне, еу юбеск локашул Касей Тале","poem":2},{"lineBreak":true},{"text":"ши локул ын каре локуеште слава Та.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ну-мь луа суфлетул ымпреунэ ку пэкэтоший,","poem":2},{"lineBreak":true},{"text":"нич вяца ку оамений каре варсэ сынӂе,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"але кэрор мынь сунт нелеӂюите","poem":2},{"lineBreak":true},{"text":"ши а кэрор дряптэ есте плинэ де митэ!","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Еу умблу ын неприхэнире;","poem":2},{"lineBreak":true},{"text":"избэвеште-мэ ши ай милэ де мине!","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Пичорул меу стэ пе каля чя дряптэ:","poem":2},{"lineBreak":true},{"text":"вой бинекувынта пе Домнул ын адунэрь.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}