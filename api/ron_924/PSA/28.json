{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Доамне, кэтре Тине стриг. Стынка мя!","poem":1},{"text":"Ну рэмыне сурд ла гласул меу,","poem":2},{"lineBreak":true},{"text":"ка ну кумва, дакэ Те вей депэрта фэрэ сэ-мь рэспунзь,","poem":2},{"lineBreak":true},{"text":"сэ ажунг ка чей че се кобоарэ ын гроапэ!","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Аскултэ гласул ругэчунилор меле, кынд стриг кэтре Тине","poem":2},{"lineBreak":true},{"text":"ши кынд ымь ридик мыниле спре Локашул Тэу чел Сфынт!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ну мэ луа де пе пэмынт ымпреунэ ку чей рэй","poem":2},{"lineBreak":true},{"text":"ши ку оамений нелеӂюиць,","poem":2},{"lineBreak":true},{"text":"каре ворбеск де паче апроапелуй лор","poem":2},{"lineBreak":true},{"text":"ши, кынд коло, ау рэутате ын инимэ!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Рэсплэтеште-ле дупэ лукрэриле лор","poem":2},{"lineBreak":true},{"text":"ши дупэ рэутатя фаптелор лор,","poem":2},{"lineBreak":true},{"text":"рэсплэтеште-ле дупэ лукраря мынилор лор!","poem":2},{"lineBreak":true},{"text":"Дэ-ле плата каре ли се кувине!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Кэч ей ну яу аминте ла лукрэриле Домнулуй,","poem":2},{"lineBreak":true},{"text":"ла лукраря мынилор Луй.","poem":2},{"lineBreak":true},{"text":"Сэ-й добоаре ши сэ ну-й май скоале!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Бинекувынтат сэ фие Домнул,","poem":2},{"lineBreak":true},{"text":"кэч аскултэ гласул ругэчунилор меле!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Домнул есте тэрия мя ши скутул меу;","poem":2},{"lineBreak":true},{"text":"ын Ел ми се ынкреде инима ши сунт ажутат.","poem":2},{"lineBreak":true},{"text":"Де ачея ымь есте плинэ де веселие инима","poem":2},{"lineBreak":true},{"text":"ши-Л лауд прин кынтэриле меле.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Домнул есте тэрия попорулуй Сэу,","poem":2},{"lineBreak":true},{"text":"Ел есте Стынка избэвитоаре а унсулуй Сэу.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Мынтуеште, Доамне, попорул Тэу","poem":2},{"lineBreak":true},{"text":"ши бинекувынтязэ моштениря Та!","poem":2},{"lineBreak":true},{"text":"Фий пэсторул ши сприжиниторул лор ын вечь!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}