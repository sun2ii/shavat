{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Фиий луй Думнезеу, даць Домнулуй,","poem":1},{"text":"даць Домнулуй славэ ши чинсте!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Даць Домнулуй слава кувенитэ Нумелуй Луй!","poem":2},{"lineBreak":true},{"text":"Ынкинаци-вэ ынаинтя Домнулуй ымбрэкаць ку подоабе сфинте!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Гласул Домнулуй рэсунэ пе апе,","poem":2},{"lineBreak":true},{"text":"Думнезеул славей фаче сэ бубуе тунетул:","poem":2},{"lineBreak":true},{"text":"Домнул есте пе апе марь.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Гласул Домнулуй есте путерник,","poem":2},{"lineBreak":true},{"text":"гласул Домнулуй есте мэрец.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Гласул Домнулуй сфэрымэ чедрий;","poem":2},{"lineBreak":true},{"text":"Домнул сфэрымэ чедрий Либанулуй,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ый фаче сэ сарэ ка ниште вицей,","poem":2},{"lineBreak":true},{"text":"ши Либанул ши Сирионул сар ка ниште пуй де биволь.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Гласул Домнулуй фаче сэ цышняскэ флэкэрь де фок,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"гласул Домнулуй фаче сэ се кутремуре пустиул;","poem":2},{"lineBreak":true},{"text":"Домнул фаче сэ тремуре пустиул Кадес.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Гласул Домнулуй фаче пе чербоайче сэ наскэ;","poem":2},{"lineBreak":true},{"text":"Ел деспоае пэдуриле;","poem":2},{"lineBreak":true},{"text":"ын локашул Луй тотул стригэ: „Славэ!”","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Домнул стэтя пе скаунул Луй де домние кынд ера потопул","poem":2},{"lineBreak":true},{"text":"ши Домнул ымпэрэцеште ын вечь пе скаунул Луй де домние.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Домнул дэ тэрие попорулуй Сэу,","poem":2},{"lineBreak":true},{"text":"Домнул бинекувынтязэ пе попорул Сэу ку паче.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}