{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Доамне, че мулць сунт врэжмаший мей!","poem":1},{"text":"Че мулциме се скоалэ ымпотрива мя!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Кыт де мулць зик деспре мине:","poem":2},{"lineBreak":true},{"text":"„Ну май есте скэпаре пентру ел ла Думнезеу!”","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Дар Ту, Доамне, Ту ешть скутул меу,","poem":2},{"lineBreak":true},{"text":"Ту ешть слава мя ши Ту ымь ыналць капул!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Еу стриг ку гласул меу кэтре Домнул","poem":2},{"lineBreak":true},{"text":"ши Ел ымь рэспунде дин мунтеле Луй чел сфынт.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Мэ кулк, адорм","poem":2},{"lineBreak":true},{"text":"ши мэ дештепт ярэшь, кэч Домнул есте сприжинул меу.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ну мэ тем де зечиле де мий де попоаре","poem":2},{"lineBreak":true},{"text":"каре мэ ымпресоарэ дин тоате пэрциле.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Скоалэ-Те, Доамне! Скапэ-мэ, Думнезеуле!","poem":2},{"lineBreak":true},{"text":"Кэч Ту баць песте образ пе тоць врэжмаший мей","poem":2},{"lineBreak":true},{"text":"ши здробешть динций челор рэй.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ла Домнул есте скэпаря:","poem":2},{"lineBreak":true},{"text":"бинекувынтаря Та сэ фие песте попорул Тэу.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}