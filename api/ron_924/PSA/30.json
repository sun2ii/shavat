{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"Те ыналц, Доамне, кэч м-ай ридикат","poem":1},{"text":"ши н-ай лэсат пе врэжмаший мей сэ се букуре де мине.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Доамне Думнезеуле,","poem":2},{"lineBreak":true},{"text":"еу ам стригат кэтре Тине,","poem":2},{"lineBreak":true},{"text":"ши Ту м-ай виндекат.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Доамне, Ту мь-ай ридикат суфлетул дин Локуинца морцилор,","poem":2},{"lineBreak":true},{"text":"Ту м-ай адус ла вяцэ дин мижлокул челор че се кобоарэ ын гроапэ.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Кынтаць Домнулуй, вой, чей юбиць де Ел,","poem":2},{"lineBreak":true},{"text":"мэриць прин лауделе воастре Нумеле Луй чел сфынт!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Кэч мыния Луй цине нумай о клипэ,","poem":2},{"lineBreak":true},{"text":"дар ындураря Луй цине тоатэ вяца:","poem":2},{"lineBreak":true},{"text":"сяра вине плынсул,","poem":2},{"lineBreak":true},{"text":"яр диминяца, веселия.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Кынд ымь мерӂя бине, зичям:","poem":2},{"lineBreak":true},{"text":"„Ну мэ вой клэтина ничодатэ!”","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Доамне, прин бунэвоинца Та мэ ашезасешь пе ун мунте таре,","poem":2},{"lineBreak":true},{"text":"дар Ць-ай аскунс Фаца ши м-ам тулбурат.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Доамне, еу ам стригат кэтре Тине","poem":2},{"lineBreak":true},{"text":"ши м-ам ругат Домнулуй зикынд:","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"„Че вей кыштига дакэ-мь вершь сынӂеле ши мэ коборь ын гроапэ?","poem":2},{"lineBreak":true},{"text":"Поате сэ Те лауде цэрына?","poem":2},{"lineBreak":true},{"text":"Поате еа сэ вестяскэ крединчошия Та?","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Аскултэ, Доамне, ай милэ де мине!","poem":2},{"lineBreak":true},{"text":"Доамне, ажутэ-мэ!”","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ши мь-ай префэкут тынгуириле ын веселие,","poem":2},{"lineBreak":true},{"text":"мь-ай дезлегат сакул де жале ши м-ай ынчинс ку букурие,","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"пентру ка инима мя сэ-Ць кынте ши сэ ну стя мутэ.","poem":2},{"lineBreak":true},{"text":"Доамне Думнезеуле, еу пуруря Те вой лэуда!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}