{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":[{"text":"Нелеӂюиря челуй рэу зиче инимий меле:","poem":1},{"text":"„Ну есте фрикэ де Думнезеу ынаинтя окилор луй.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Кэч се мэгулеште сингур ын окий луй,","poem":2},{"lineBreak":true},{"text":"ка сэ-шь десэвыршяскэ фэрэделеӂя, ка сэ-шь потоляскэ ура.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Кувинтеле гурий луй сунт минчиноасе ши ыншелэтоаре;","poem":2},{"lineBreak":true},{"text":"ну май вря сэ лукрезе ку ынцелепчуне ши сэ факэ бинеле.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ын аштернутул луй се гындеште ла рэутате,","poem":2},{"lineBreak":true},{"text":"стэ пе о кале каре ну есте бунэ","poem":2},{"lineBreak":true},{"text":"ши ну урэште рэул.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Бунэтатя Та, Доамне, ажунӂе пынэ ла черурь","poem":2},{"lineBreak":true},{"text":"ши крединчошия Та, пынэ ла норь.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Дрептатя Та есте ка мунций луй Думнезеу","poem":2},{"lineBreak":true},{"text":"ши жудекэциле Тале сунт ка адынкул чел маре.","poem":2},{"lineBreak":true},{"text":"Доамне, Ту сприжинь пе оамень ши пе добитоаче!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Кыт де скумпэ есте бунэтатя Та, Думнезеуле!","poem":2},{"lineBreak":true},{"text":"Ла умбра арипилор Тале гэсеск фиий оаменилор адэпост.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Се сатурэ де белшугул Касей Тале","poem":2},{"lineBreak":true},{"text":"ши-й адэпь дин шувоюл десфэтэрилор Тале.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Кэч ла Тине есте изворул веций;","poem":2},{"lineBreak":true},{"text":"прин лумина Та ведем лумина.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ынтинде-Ць ши май департе бунэтатя песте чей че Те куноск","poem":2},{"lineBreak":true},{"text":"ши дрептатя песте чей ку инима неприхэнитэ!","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Сэ ну м-ажунгэ пичорул челуй мындру","poem":2},{"lineBreak":true},{"text":"ши сэ ну мэ пунэ пе фугэ мына челор рэй!","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Чей че фак фэрэделеӂя ау ши ынчепут сэ кадэ;","poem":2},{"lineBreak":true},{"text":"сунт рэстурнаць ши ну пот сэ се май скоале.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}