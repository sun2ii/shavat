{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"Зичям: „Вой вегя асупра кэилор меле,","poem":1},{"text":"ка сэ ну пэкэтуеск ку лимба;","poem":2},{"lineBreak":true},{"text":"ымь вой пуне фрыу гурий","poem":2},{"lineBreak":true},{"text":"кыт ва ста чел рэу ынаинтя мя.”","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ам стат мут, ын тэчере;","poem":2},{"lineBreak":true},{"text":"ам тэкут, мэкар кэ ерам ненорочит,","poem":2},{"lineBreak":true},{"text":"ши тотушь дуреря мя ну ера май пуцин маре.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ымь ардя инима ын мине,","poem":2},{"lineBreak":true},{"text":"ун фок лэунтрик мэ мистуя,","poem":2},{"lineBreak":true},{"text":"ши атунч мь-а венит кувынтул пе лимбэ ши ам зис:","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"„Доамне, спуне-мь каре есте сфыршитул веций меле,","poem":2},{"lineBreak":true},{"text":"каре есте мэсура зилелор меле,","poem":2},{"lineBreak":true},{"text":"ка сэ штиу кыт де трекэтор сунт!”","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ятэ кэ зилеле меле сунт кыт ун лат де мынэ","poem":2},{"lineBreak":true},{"text":"ши вяца мя есте ка о нимика ынаинтя Та.","poem":2},{"lineBreak":true},{"text":"Да, орьче ом есте доар о суфларе, орькыт де бине с-ар цине.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Да, омул умблэ ка о умбрэ,","poem":2},{"lineBreak":true},{"text":"се фрэмынтэ деӂяба,","poem":2},{"lineBreak":true},{"text":"стрынӂе ла коморь ши ну штие чине ле ва луа.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Акум, Доамне, че май пот нэдэждуи еу?","poem":2},{"lineBreak":true},{"text":"Ын Тине ымь есте нэдеждя.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Избэвеште-мэ де тоате фэрэделеӂиле меле!","poem":2},{"lineBreak":true},{"text":"Ну мэ фаче де окара челуй небун!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Стау мут, ну дескид гура,","poem":2},{"lineBreak":true},{"text":"кэч Ту лукрезь.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Абате-Ць ловитуриле де ла мине!","poem":2},{"lineBreak":true},{"text":"Ымь есе суфлетул суб ловитуриле мыний Тале.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ту педепсешть пе ом ши-л ловешть пентру фэрэделеӂя луй;","poem":2},{"lineBreak":true},{"text":"ый прэпэдешть, ка молия, че аре ел май скумп.","poem":2},{"lineBreak":true},{"text":"Да, орьче ом есте доар о суфларе.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Аскултэ-мь ругэчуня, Доамне,","poem":2},{"lineBreak":true},{"text":"ши плякэ-Ць урекя ла стригэтеле меле!","poem":2},{"lineBreak":true},{"text":"Ну тэчя ын фаца лакримилор меле!","poem":2},{"lineBreak":true},{"text":"Кэч сунт ун стрэин ынаинтя Та,","poem":2},{"lineBreak":true},{"text":"ун прибяг, ка тоць пэринций мей.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Абате-Ць привиря де ла мине ши ласэ-мэ сэ рэсуфлу,","poem":2},{"lineBreak":true},{"text":"пынэ ну мэ дук ши сэ ну май фиу!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}