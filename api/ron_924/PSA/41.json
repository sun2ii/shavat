{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"Фериче де чел че ынгрижеште де чел сэрак,","poem":1},{"text":"кэч ын зиуа ненорочирий Домнул ыл избэвеште;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Домнул ыл пэзеште ши-л цине ын вяцэ.","poem":2},{"lineBreak":true},{"text":"Ел есте феричит пе пэмынт","poem":2},{"lineBreak":true},{"text":"ши ну-л лашь ла бунул плак ал врэжмашилор луй.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Домнул ыл сприжинэ кынд есте пе патул де суферинцэ:","poem":2},{"lineBreak":true},{"text":"ый ушурезь дурериле ын тоате болиле луй.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Еу зик: „Доамне, ай милэ де мине!","poem":2},{"lineBreak":true},{"text":"Виндекэ-мь суфлетул, кэч ам пэкэтуит ымпотрива Та!”","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Врэжмаший мей зик ку рэутате деспре мине:","poem":2},{"lineBreak":true},{"text":"„Кынд ва мури? Кынд ый ва пери нумеле?”","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Дакэ вине чинева сэ мэ вадэ, ворбеште неадевэрурь,","poem":2},{"lineBreak":true},{"text":"стрынӂе темеюрь ка сэ мэ ворбяскэ де рэу;","poem":2},{"lineBreak":true},{"text":"ши кынд плякэ, мэ ворбеште де рэу пе афарэ.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Тоць врэжмаший мей шоптеск ынтре ей ымпотрива мя","poem":2},{"lineBreak":true},{"text":"ши кред кэ ненорочиря мя ымь ва адуче пеиря.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"„Есте атинс рэу де тот”, зик ей,","poem":2},{"lineBreak":true},{"text":"„ятэ-л кулкат, н-аре сэ се май скоале!”","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Кяр ши ачела ку каре трэям ын паче,","poem":2},{"lineBreak":true},{"text":"ын каре ымь пуням ынкредеря ши каре мынка дин пыня мя,","poem":2},{"lineBreak":true},{"text":"ридикэ ши ел кэлкыюл ымпотрива мя.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Дар Ту, Доамне, ай милэ де мине ши ридикэ-мэ,","poem":2},{"lineBreak":true},{"text":"ка сэ ле рэсплэтеск кум ли се кувине!","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Прин ачаста вой куноаште кэ мэ юбешть,","poem":2},{"lineBreak":true},{"text":"дакэ ну мэ ва бируи врэжмашул меу.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ту м-ай сприжинит дин причина неприхэнирий меле","poem":2},{"lineBreak":true},{"text":"ши м-ай ашезат пе вечие ынаинтя Та.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Бинекувынтат сэ фие Домнул Думнезеул луй Исраел,","poem":2},{"lineBreak":true},{"text":"дин вешничие ын вешничие!","poem":2},{"lineBreak":true},{"text":"Амин! Амин!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}