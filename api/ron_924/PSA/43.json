{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Фэ-мь дрептате, Думнезеуле, апэрэ-мь причина ымпотрива унуй ням немилос!","poem":1},{"text":"Избэвеште-мэ де оамений плинь де виклешуг ши де фэрэделеӂе!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ту ешть Думнезеул каре мэ окротеште: пентру че мэ лепезь?","poem":2},{"lineBreak":true},{"text":"Пентру че требуе сэ умблу плин де ынтристаре суб апэсаря врэжмашулуй?","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Тримите лумина ши крединчошия Та ка сэ мэ кэлэузяскэ","poem":2},{"lineBreak":true},{"text":"ши сэ мэ дукэ ла мунтеле Тэу чел сфынт","poem":2},{"lineBreak":true},{"text":"ши ла локашуриле Тале!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Атунч вой мерӂе ла алтарул луй Думнезеу,","poem":2},{"lineBreak":true},{"text":"ла алтарул луй Думнезеу, каре есте букурия ши веселия мя,","poem":2},{"lineBreak":true},{"text":"ши Те вой лэуда ку харпа, Думнезеуле, Думнезеул меу!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Пентру че те мыхнешть, суфлете, ши ӂемь ынэунтрул меу?","poem":2},{"lineBreak":true},{"text":"Нэдэждуеште ын Думнезеу, кэч ярэшь Ыл вой лэуда:","poem":2},{"lineBreak":true},{"text":"Ел есте мынтуиря мя ши Думнезеул меу.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}