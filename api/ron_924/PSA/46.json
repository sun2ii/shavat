{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":[{"text":"Думнезеу есте адэпостул ши сприжинул ностру,","poem":1},{"text":"ун ажутор каре ну липсеште ничодатэ ын невой.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Де ачея ну не темем кяр дакэ с-ар згудуи пэмынтул","poem":2},{"lineBreak":true},{"text":"ши с-ар клэтина мунций ын инима мэрилор,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"кяр дакэ ар урла ши ар спумега валуриле мэрий","poem":2},{"lineBreak":true},{"text":"ши с-ар ридика пынэ аколо де сэ се кутремуре мунций.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Есте ун рыу але кэруй извоаре ынвеселеск четатя луй Думнезеу,","poem":2},{"lineBreak":true},{"text":"сфынтул локаш ал локуинцелор Челуй Пряыналт.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Думнезеу есте ын мижлокул ей: еа ну се клатинэ;","poem":2},{"lineBreak":true},{"text":"Думнезеу о ажутэ ын ревэрсатул зорилор.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Нямуриле се фрэмынтэ, ымпэрэцииле се клатинэ,","poem":2},{"lineBreak":true},{"text":"дар гласул Луй рэсунэ, ши пэмынтул се топеште де гроазэ.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Домнул оштирилор есте ку ной,","poem":2},{"lineBreak":true},{"text":"Думнезеул луй Иаков есте ун турн де скэпаре пентру ной.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Вениць ши привиць лукрэриле Домнулуй,","poem":2},{"lineBreak":true},{"text":"пустиириле пе каре ле-а фэкут Ел пе пэмынт.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ел а пус капэт рэзбоаелор пынэ ла марӂиня пэмынтулуй;","poem":2},{"lineBreak":true},{"text":"Ел а сфэрымат аркул ши а рупт сулица, а арс ку фок кареле де рэзбой.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"„Оприци-вэ ши сэ штиць кэ Еу сунт Думнезеу:","poem":2},{"lineBreak":true},{"text":"Еу стэпынеск песте нямурь,","poem":2},{"lineBreak":true},{"text":"Еу стэпынеск пе пэмынт.”","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Домнул оштирилор есте ку ной.","poem":2},{"lineBreak":true},{"text":"Думнезеул луй Иаков есте ун турн де скэпаре пентру ной.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}