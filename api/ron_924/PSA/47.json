{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"Батець дин палме, тоате попоареле!","poem":1},{"text":"Ынэлцаць луй Думнезеу стригэте де букурие!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Кэч Домнул, Чел Пряыналт, есте ынфрикошат:","poem":2},{"lineBreak":true},{"text":"Ел есте Ымпэрат маре песте тот пэмынтул.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ел не супуне попоареле,","poem":2},{"lineBreak":true},{"text":"Ел пуне нямуриле суб пичоареле ноастре.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ел не алеӂе моштениря,","poem":2},{"lineBreak":true},{"text":"слава луй Иаков, пе каре-л юбеште.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Думнезеу Се суе ын мижлокул стригэтелор де бируинцэ,","poem":2},{"lineBreak":true},{"text":"Домнул ынаинтязэ ын сунетул трымбицей.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Кынтаць луй Думнезеу, кынтаць!","poem":2},{"lineBreak":true},{"text":"Кынтаць Ымпэратулуй ностру, кынтаць!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Кэч Думнезеу есте ымпэрат песте тот пэмынтул:","poem":2},{"lineBreak":true},{"text":"кынтаць о кынтаре ынцеляптэ!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Думнезеу ымпэрэцеште песте нямурь,","poem":2},{"lineBreak":true},{"text":"Думнезеу шаде пе скаунул Луй де домние чел сфынт.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Домниторий попоарелор се адунэ ымпреунэ","poem":2},{"lineBreak":true},{"text":"ку попорул Думнезеулуй луй Авраам;","poem":2},{"lineBreak":true},{"text":"кэч але луй Думнезеу сунт скутуриле пэмынтулуй:","poem":2},{"lineBreak":true},{"text":"Ел есте май ыналт ши май пресус де орьче.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}