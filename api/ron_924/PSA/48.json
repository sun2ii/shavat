{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"verse","number":1,"content":[{"text":"Маре есте Домнул ши лэудат де тоць","poem":1},{"text":"ын четатя Думнезеулуй ностру, пе мунтеле Луй чел сфынт.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Фрумоасэ ынэлциме, букурия ынтрегулуй пэмынт, есте мунтеле Сионулуй;","poem":2},{"lineBreak":true},{"text":"ын партя де мязэноапте есте четатя Марелуй Ымпэрат.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Думнезеу, ын каселе Луй ымпэрэтешть, есте куноскут ка ун турн де скэпаре.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Кэч ятэ кэ ымпэраций се адунасерэ:","poem":2},{"lineBreak":true},{"text":"доар ау трекут ымпреунэ,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ау привит-о, ау ынлемнит,","poem":2},{"lineBreak":true},{"text":"с-ау темут ши ау луат-о ла фугэ.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Й-а апукат ун тремур аколо,","poem":2},{"lineBreak":true},{"text":"ка дуреря уней фемей ла фачере.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ау фост изгониць де паркэ ар фи фост луаць де вынтул де рэсэрит,","poem":2},{"lineBreak":true},{"text":"каре сфэрымэ корэбииле дин Тарсис.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ынтокмай кум аузисерэм спунынду-се, аша ам вэзут","poem":2},{"lineBreak":true},{"text":"ын четатя Домнулуй оштирилор, ын четатя Думнезеулуй ностру:","poem":2},{"lineBreak":true},{"text":"Думнезеу о ва фаче сэ дэйнуяскэ пе вечие.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Думнезеуле, ла бунэтатя Та не гындим","poem":2},{"lineBreak":true},{"text":"ын мижлокул Темплулуй Тэу!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ка ши Нумеле Тэу, Думнезеуле,","poem":2},{"lineBreak":true},{"text":"ши лауда Та рэсунэ пынэ ла марӂиниле пэмынтулуй;","poem":2},{"lineBreak":true},{"text":"дряпта Та есте плинэ де ындураре.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Се букурэ мунтеле Сионулуй","poem":2},{"lineBreak":true},{"text":"ши се веселеск фийчеле луй Иуда","poem":2},{"lineBreak":true},{"text":"де жудекэциле Тале.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Стрэбатець Сионул ши околици-л,","poem":2},{"lineBreak":true},{"text":"нумэраци-й турнуриле,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"привици-й ынтэритура","poem":2},{"lineBreak":true},{"text":"ши черчетаци-й палателе,","poem":2},{"lineBreak":true},{"text":"ка сэ повестиць челор че вор вени дупэ ей!","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ятэ, Думнезеул ачеста есте Думнезеул ностру ын вечь де вечь;","poem":2},{"lineBreak":true},{"text":"Ел ва фи кэлэуза ноастрэ пынэ ла моарте.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}