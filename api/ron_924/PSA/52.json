{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Пентру че те фэлешть ку рэутатя та, асуприторуле?","poem":1},{"text":"Бунэтатя луй Думнезеу цине ын вечь.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Лимба та ну нэскочеште декыт рэутате,","poem":2},{"lineBreak":true},{"text":"ка ун брич аскуцит, виклян че ешть!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ту юбешть май деграбэ рэул декыт бинеле,","poem":2},{"lineBreak":true},{"text":"май деграбэ минчуна декыт адевэрул.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ту юбешть нумай кувинте нимичитоаре,","poem":2},{"lineBreak":true},{"text":"лимбэ ыншелэтоаре!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Де ачея ши Думнезеу те ва доборы пе вечие,","poem":2},{"lineBreak":true},{"text":"те ва апука ши те ва ридика дин кортул тэу","poem":2},{"lineBreak":true},{"text":"ши те ва дезрэдэчина дин пэмынтул челор вий.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Чей фэрэ приханэ вор ведя лукрул ачеста, се вор теме","poem":2},{"lineBreak":true},{"text":"ши вор рыде де ел, зикынд:","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"„Ятэ омул каре ну луа ка окротитор пе Думнезеу,","poem":2},{"lineBreak":true},{"text":"чи се ынкредя ын богэцииле луй челе марь","poem":2},{"lineBreak":true},{"text":"ши се бизуя пе рэутатя луй.”","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Дар еу сунт ын Каса луй Думнезеу ка ун мэслин верде,","poem":2},{"lineBreak":true},{"text":"мэ ынкред ын бунэтатя луй Думнезеу ын вечь де вечь.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Те вой лэуда тотдяуна пентру кэ ай лукрат","poem":2},{"lineBreak":true},{"text":"ши, ын фаца копиилор Тэй, вой нэдэждуи ын Нумеле Тэу, кэч есте биневоитор.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}