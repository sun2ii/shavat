{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Небунул зиче ын инима луй: „Ну есте Думнезеу!”","poem":1},{"text":"С-ау стрикат оамений, ау сэвыршит фэрэделеӂь урыте,","poem":2},{"lineBreak":true},{"text":"ну есте ничунул каре сэ факэ бинеле.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Думнезеу Се уйтэ де ла ынэлцимя черурилор песте фиий оаменилор,","poem":2},{"lineBreak":true},{"text":"ка сэ вадэ дакэ есте чинева каре сэ фие причепут","poem":2},{"lineBreak":true},{"text":"ши сэ кауте пе Думнезеу.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Дар тоць с-ау рэтэчит, тоць с-ау стрикат;","poem":2},{"lineBreak":true},{"text":"ну есте ничунул каре сэ факэ бинеле, ничунул мэкар.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Шь-ау пердут оаре минтя чей че сэвыршеск нелеӂюиря","poem":2},{"lineBreak":true},{"text":"де мэнынкэ пе попорул Меу кум мэнынкэ пыня","poem":2},{"lineBreak":true},{"text":"ши ну кямэ пе Думнезеу?","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Атунч вор тремура де спаймэ фэрэ сэ фие врео причинэ де спаймэ;","poem":2},{"lineBreak":true},{"text":"Думнезеу ва рисипи оаселе челор че тэбэрэск ымпотрива та,","poem":2},{"lineBreak":true},{"text":"ый вей фаче де рушине, кэч Думнезеу й-а лепэдат.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"О, чине ва фаче сэ порняскэ дин Сион избэвиря луй Исраел?","poem":2},{"lineBreak":true},{"text":"Кынд ва адуче Думнезеу ынапой пе принший де рэзбой ай попорулуй Сэу,","poem":2},{"lineBreak":true},{"text":"Иаков се ва весели ши Исраел се ва букура.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}