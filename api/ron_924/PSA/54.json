{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Скапэ-мэ, Думнезеуле, прин Нумеле Тэу","poem":1},{"text":"ши фэ-мь дрептате прин путеря Та!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Аскултэ-мь ругэчуня, Думнезеуле,","poem":2},{"lineBreak":true},{"text":"я аминте ла кувинтеле гурий меле!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Кэч ниште стрэинь с-ау скулат ымпотрива мя,","poem":2},{"lineBreak":true},{"text":"ниште оамень асуприторь вор сэ-мь я вяца;","poem":2},{"lineBreak":true},{"text":"ей ну се гындеск ла Думнезеу.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Да, Думнезеу есте ажуторул меу,","poem":2},{"lineBreak":true},{"text":"Домнул есте сприжинул суфлетулуй меу!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Рэул се ва ынтоарче асупра потривничилор мей;","poem":2},{"lineBreak":true},{"text":"нимичеште-й ын крединчошия Та!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Атунч Ыць вой адуче жертфе де бунэвое,","poem":2},{"lineBreak":true},{"text":"вой лэуда Нумеле Тэу, Доамне, кэч есте биневоитор;","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"кэч Ел мэ избэвеште дин тоате неказуриле,","poem":2},{"lineBreak":true},{"text":"ши ку окий мей ымь вэд ымплинитэ доринца привитоаре ла врэжмаший мей.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}