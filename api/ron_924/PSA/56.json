{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"verse","number":1,"content":[{"text":"Ай милэ де мине, Думнезеуле, кэч ниште оамень мэ хэрцуеск!","poem":1},{"text":"Тоатэ зиуа ымь фак рэзбой ши мэ кинуеск.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Тоатэ зиуа мэ хэрцуеск потривничий мей;","poem":2},{"lineBreak":true},{"text":"сунт мулць ши се рэзбоеск ку мине ка ниште труфашь.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Орь де кыте орь мэ тем,","poem":2},{"lineBreak":true},{"text":"еу мэ ынкред ын Тине.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Еу мэ вой лэуда ку Думнезеу, ку Кувынтул Луй.","poem":2},{"lineBreak":true},{"text":"Мэ ынкред ын Думнезеу","poem":2},{"lineBreak":true},{"text":"ши ну мэ тем де нимик.","poem":2},{"lineBreak":true},{"text":"Че пот сэ-мь факэ ниште оамень?","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ынтруна ей ымь атинг дрептуриле","poem":2},{"lineBreak":true},{"text":"ши н-ау декыт гындурь реле фацэ де мине.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Унелтеск, пындеск ши ымь урмэреск паший,","poem":2},{"lineBreak":true},{"text":"пентру кэ вор сэ-мь я вяца.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ей траг нэдежде сэ скапе прин нелеӂюиря лор:","poem":2},{"lineBreak":true},{"text":"добоарэ попоареле, Думнезеуле, ын мыния Та!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ту нумерь паший веций меле де прибяг;","poem":2},{"lineBreak":true},{"text":"пуне-мь лакримиле ын бурдуфул Тэу!","poem":2},{"lineBreak":true},{"text":"Ну сунт еле скрисе ын картя Та?","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Врэжмаший мей дау ынапой ын зиуа кынд Те стриг:","poem":2},{"lineBreak":true},{"text":"штиу кэ Думнезеу есте де партя мя.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Еу мэ вой лэуда ку Думнезеу, ку Кувынтул Луй, да, мэ вой лэуда ку Домнул, ку Кувынтул Луй.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Мэ ынкред ын Думнезеу ши ну мэ тем де нимик.","poem":2},{"lineBreak":true},{"text":"Че пот сэ-мь факэ ниште оамень?","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Думнезеуле, требуе сэ ымплинеск журуинцеле пе каре Ци ле-ам фэкут;","poem":2},{"lineBreak":true},{"text":"Ыць вой адуче жертфе де мулцумире.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Кэч мь-ай избэвит суфлетул де ла моарте,","poem":2},{"lineBreak":true},{"text":"мь-ай ферит пичоареле де кэдере,","poem":2},{"lineBreak":true},{"text":"ка сэ умблу ынаинтя луй Думнезеу,","poem":2},{"lineBreak":true},{"text":"ын лумина челор вий.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}