{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"Ай милэ де мине, Думнезеуле, ай милэ де мине,","poem":1},{"text":"кэч ын Тине ми се ынкреде суфлетул;","poem":2},{"lineBreak":true},{"text":"ла умбра арипилор Тале каут ун лок де скэпаре","poem":2},{"lineBreak":true},{"text":"пынэ вор трече ненорочириле.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Еу стриг кэтре Думнезеу, кэтре Чел Пряыналт,","poem":2},{"lineBreak":true},{"text":"кэтре Думнезеу, каре лукрязэ пентру мине.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ел ымь ва тримите избэвире дин чер,","poem":2},{"lineBreak":true},{"text":"ын тимп че пригониторул меу ымь арункэ окэрь.","poem":2},{"lineBreak":true},{"text":"Да, Думнезеу Ышь ва тримите бунэтатя ши крединчошия.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Суфлетул меу есте ынтре ниште лей:","poem":2},{"lineBreak":true},{"text":"стау кулкат ын мижлокул унор оамень каре варсэ флэкэрь,","poem":2},{"lineBreak":true},{"text":"ын мижлокул унор оамень ай кэрор динць сунт сулице ши сэӂець","poem":2},{"lineBreak":true},{"text":"ши а кэрор лимбэ есте о сабие аскуцитэ.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ыналцэ-Те песте черурь, Думнезеуле,","poem":2},{"lineBreak":true},{"text":"песте тот пэмынтул сэ се ынтиндэ слава Та!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ей ынтинсесерэ ун лац суб паший мей;","poem":2},{"lineBreak":true},{"text":"суфлетул ми се ынковоя","poem":2},{"lineBreak":true},{"text":"ши-мь сэпасерэ о гроапэ ынаинте:","poem":2},{"lineBreak":true},{"text":"дар ау кэзут ей ын еа.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Инима мя есте таре, Думнезеуле, инима мя есте таре;","poem":2},{"lineBreak":true},{"text":"вой кынта, да, ши вой суна дин инструментеле меле.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Трезеште-те, суфлете! Трезици-вэ, алэутэ ши харпэ!","poem":2},{"lineBreak":true},{"text":"Мэ вой трези ын зорь де зи.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Те вой лэуда принтре попоаре, Доамне!","poem":2},{"lineBreak":true},{"text":"Те вой кынта принтре нямурь.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Кэч бунэтатя Та ажунӂе пынэ ла черурь","poem":2},{"lineBreak":true},{"text":"ши крединчошия Та, пынэ ла норь.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ыналцэ-Те песте черурь, Думнезеуле,","poem":2},{"lineBreak":true},{"text":"песте тот пэмынтул сэ се ынтиндэ слава Та!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}