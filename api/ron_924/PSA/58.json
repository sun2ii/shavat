{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"verse","number":1,"content":[{"text":"Оаре тэкынд фачець вой дрептате?","poem":1},{"text":"Оаре аша жудекаць вой фэрэ пэртинире, фиий оаменилор?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Димпотривэ, ын инимэ сэвыршиць нелеӂюирь;","poem":2},{"lineBreak":true},{"text":"ын царэ пунець ын кумпэнэ силничия мынилор воастре.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Чей рэй сунт стрикаць ынкэ дин пынтечеле мамей лор,","poem":2},{"lineBreak":true},{"text":"минчиноший се рэтэческ одатэ ку еширя дин пынтечеле мамей лор.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ау о отравэ ка отрава унуй шарпе,","poem":2},{"lineBreak":true},{"text":"ка отрава уней аспиде сурде, каре ышь аступэ урекя,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"каре н-ауде гласул врэжиторилор, гласул фермекэторулуй челуй май искусит.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Думнезеуле, здробеште-ле динций дин гурэ!","poem":2},{"lineBreak":true},{"text":"Смулӂе, Доамне, мэселеле ачестор пуй де лей!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Сэ се рисипяскэ ынтокмай ка ниште апе каре се скург!","poem":2},{"lineBreak":true},{"text":"Сэӂециле пе каре ле-арункэ ей сэ фие ниште сэӂець точите!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Сэ пярэ ка ун мелк каре се топеште умблынд;","poem":2},{"lineBreak":true},{"text":"сэ ну вадэ соареле, ка стырпитура уней фемей!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ынаинте ка оалеле воастре сэ симтэ фокул де спин","poem":2},{"lineBreak":true},{"text":"верде сау ускат, ыл ва луа выртежул.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Чел фэрэ приханэ се ва букура ла ведеря рэзбунэрий;","poem":2},{"lineBreak":true},{"text":"ышь ва скэлда пичоареле ын сынӂеле челор рэй.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ши атунч оамений вор зиче: „Да, есте о рэсплатэ пентру чел фэрэ приханэ!","poem":2},{"lineBreak":true},{"text":"Да, есте ун Думнезеу каре жудекэ пе пэмынт!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}