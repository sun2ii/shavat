{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Доамне, ну мэ педепси ку мыния Та","poem":1},{"text":"ши ну мэ мустра ку урӂия Та!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ай милэ де мине, Доамне, кэч мэ офилеск!","poem":2},{"lineBreak":true},{"text":"Виндекэ-мэ, Доамне, кэч ымь тремурэ оаселе!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Суфлетул мь-е ынгрозит де тот.","poem":2},{"lineBreak":true},{"text":"Ши Ту, Доамне, пынэ кынд вей зэбови сэ Те ындурь де мине?","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ынтоарче-Те, Доамне, избэвеште-мь суфлетул!","poem":2},{"lineBreak":true},{"text":"Мынтуеште-мэ, пентру ындураря Та!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Кэч чел че моаре ну-шь май адуче аминте де Тине","poem":2},{"lineBreak":true},{"text":"ши чине Те ва лэуда ын Локуинца морцилор?","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ну май пот ӂемынд!","poem":2},{"lineBreak":true},{"text":"Ын фиекаре ноапте ымь стропеск аштернутул","poem":2},{"lineBreak":true},{"text":"ши-мь скалд патул ын лакримь.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ми с-а супт фаца де ынтристаре","poem":2},{"lineBreak":true},{"text":"ши а ымбэтрынит дин причина тутурор челор че мэ пригонеск.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Депэртаци-вэ де ла мине тоць чей че фачець рэул,","poem":2},{"lineBreak":true},{"text":"кэч Домнул а аузит гласул плынӂерий меле!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Домнул ымь аскултэ черериле","poem":2},{"lineBreak":true},{"text":"ши Домнул ымь примеште ругэчуня!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Тоць врэжмаший мей вор фи акопериць де рушине ши куприншь де спаймэ;","poem":2},{"lineBreak":true},{"text":"ынтр-о клипэ вор да ынапой, акопериць де рушине.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}