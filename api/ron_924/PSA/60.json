{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":60,"content":[{"type":"verse","number":1,"content":[{"text":"Думнезеуле, не-ай лепэдат, не-ай ымпрэштият","poem":1},{"text":"ши Те-ай мыният: ридикэ-не ярэшь!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ай кутремурат пэмынтул, л-ай деспикат;","poem":2},{"lineBreak":true},{"text":"дреӂе-й спэртуриле, кэч се клатинэ!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ай фэкут пе попорул Тэу сэ трякэ прин лукрурь греле,","poem":2},{"lineBreak":true},{"text":"не-ай адэпат ку ун вин де аморцире.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ай дат челор че се тем де Тине ун стяг,","poem":2},{"lineBreak":true},{"text":"ка сэ-л ыналце спре бируинца адевэрулуй.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Пентру ка пряюбиций Тэй сэ фие избэвиць,","poem":2},{"lineBreak":true},{"text":"скапэ-не прин дряпта Та ши аскултэ-не!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Думнезеу а зис ын сфинцения Луй: „Вой еши бируитор,","poem":2},{"lineBreak":true},{"text":"вой ымпэрци Сихемул ши вой мэсура валя Сукот.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ал Меу есте Галаадул, ал Меу есте Манасе,","poem":2},{"lineBreak":true},{"text":"Ефраим есте тэрия капулуй Меу,","poem":2},{"lineBreak":true},{"text":"яр Иуда, тоягул Меу де кырмуире.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Моаб есте лигянул ын каре Мэ спэл;","poem":2},{"lineBreak":true},{"text":"песте Едом Ымь арунк ынкэлцэминтя;","poem":2},{"lineBreak":true},{"text":"цара филистенилор стригэ де букурие дин причина Мя!”","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Чине мэ ва дуче ын четатя ынтэритэ?","poem":2},{"lineBreak":true},{"text":"Чине мэ ва дуче ла Едом?","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Оаре ну Ту, Думнезеуле, каре не-ай лепэдат","poem":2},{"lineBreak":true},{"text":"ши ну май ешь, Думнезеуле, ку оштириле ноастре?","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Дэ-не ажутор, ка сэ скэпэм дин неказ!","poem":2},{"lineBreak":true},{"text":"Кэч ажуторул омулуй есте задарник.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ку Думнезеу вом фаче испрэвь марь,","poem":2},{"lineBreak":true},{"text":"ши Ел ва здроби пе врэжмаший ноштри.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}