{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"Аскултэ, Думнезеуле, стригэтеле меле,","poem":1},{"text":"я аминте ла ругэчуня мя!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Де ла капэтул пэмынтулуй стриг кэтре Тине ку инима мыхнитэ ши зик:","poem":2},{"lineBreak":true},{"text":"„Ду-мэ пе стынка пе каре н-о пот ажунӂе, кэч есте пря ыналтэ пентру мине!”","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Кэч Ту ешть ун адэпост пентру мине,","poem":2},{"lineBreak":true},{"text":"ун турн таре ымпотрива врэжмашулуй.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Аш вря сэ локуеск пе вечие ын кортул Тэу,","poem":2},{"lineBreak":true},{"text":"сэ алерг ла адэпостул арипилор Тале.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Кэч Ту, Думнезеуле, ымь аскулць журуинцеле,","poem":2},{"lineBreak":true},{"text":"Ту ымь дай моштениря челор че се тем де Нумеле Тэу.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ту адауӂь зиле ла зилеле ымпэратулуй:","poem":2},{"lineBreak":true},{"text":"лунӂяскэ-и-се аний пе вечие!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ын вечь сэ рэмынэ ел пе скаунул де домние, ынаинтя луй Думнезеу!","poem":2},{"lineBreak":true},{"text":"Фэ ка бунэтатя ши крединчошия Та сэ вегезе асупра луй!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Атунч вой кынта неынчетат Нумеле Тэу","poem":2},{"lineBreak":true},{"text":"ши зи де зи ымь вой ымплини журуинцеле.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}