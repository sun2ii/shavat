{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"verse","number":1,"content":[{"text":"Да, нумай ын Думнезеу ми се ынкреде суфлетул;","poem":1},{"text":"де ла Ел ымь вине ажуторул.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Да, Ел есте Стынка ши Ажуторул меу,","poem":2},{"lineBreak":true},{"text":"Турнул меу де скэпаре; ничдекум ну мэ вой клэтина.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Пынэ кынд вэ вець нэпусти асупра унуй ом,","poem":2},{"lineBreak":true},{"text":"пынэ кынд вець кэута ку тоций сэ-л доборыць","poem":2},{"lineBreak":true},{"text":"ка пе ун зид гата сэ кадэ, ка пе ун гард гата сэ се сурпе?","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Да, ей пун ла кале сэ-л добоаре дин ынэлцимя луй:","poem":2},{"lineBreak":true},{"text":"ле плаче минчуна;","poem":2},{"lineBreak":true},{"text":"ку гура бинекувынтязэ, дар ку инима блестемэ.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Да, суфлете, ынкреде-те ын Думнезеу,","poem":2},{"lineBreak":true},{"text":"кэч де ла Ел ымь вине нэдеждя!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Да, Ел есте Стынка ши Ажуторул меу,","poem":2},{"lineBreak":true},{"text":"Турнул меу де скэпаре: ничдекум ну мэ вой клэтина.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Пе Думнезеу се ынтемеязэ ажуторул ши слава мя;","poem":2},{"lineBreak":true},{"text":"ын Думнезеу есте стынка путерий меле, локул меу де адэпост.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Попоаре, ын орьче време, ынкредеци-вэ ын Ел,","poem":2},{"lineBreak":true},{"text":"вэрсаци-вэ инимиле ынаинтя Луй!","poem":2},{"lineBreak":true},{"text":"Думнезеу есте адэпостул ностру.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Да, о нимика сунт фиий омулуй! Минчунэ сунт фиий оаменилор!","poem":2},{"lineBreak":true},{"text":"Пушь ын кумпэнэ тоць лаолалтэ, ар фи май ушорь декыт о суфларе.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ну вэ ынкредець ын асуприре","poem":2},{"lineBreak":true},{"text":"ши ну вэ пунець нэдеждя задарникэ ын рэпире;","poem":2},{"lineBreak":true},{"text":"кынд креск богэцииле, ну вэ липиць инима де еле!","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"О датэ а ворбит Думнезеу,","poem":2},{"lineBreak":true},{"text":"де доуэ орь ам аузит","poem":2},{"lineBreak":true},{"text":"кэ „путеря есте а луй Думнезеу.”","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"А Та, Доамне, есте ши бунэтатя,","poem":2},{"lineBreak":true},{"text":"кэч Ту рэсплэтешть фиекэруя дупэ фаптеле луй.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}