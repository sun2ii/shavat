{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"verse","number":1,"content":[{"text":"Думнезеуле, Ту ешть Думнезеул меу, пе Тине Те каут!","poem":1},{"text":"Ымь ынсетязэ суфлетул дупэ Тине, ымь тынжеште трупул дупэ Тине,","poem":2},{"lineBreak":true},{"text":"ынтр-ун пэмынт сек, ускат ши фэрэ апэ.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Аша Те привеск еу ын Локашул чел Сфынт,","poem":2},{"lineBreak":true},{"text":"ка сэ-Ць вэд путеря ши слава.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Фииндкэ бунэтатя Та прецуеште май мулт декыт вяца,","poem":2},{"lineBreak":true},{"text":"де ачея бузеле меле кынтэ лауделе Тале.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Те вой бинекувынта дар тоатэ вяца мя","poem":2},{"lineBreak":true},{"text":"ши ын Нумеле Тэу ымь вой ридика мыниле.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ми се сатурэ суфлетул ка де ниште букате грасе ши мезоасе,","poem":2},{"lineBreak":true},{"text":"ши гура мя Те лаудэ ку стригэте де букурие пе бузе","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"кынд мь-адук аминте де Тине ын аштернутул меу","poem":2},{"lineBreak":true},{"text":"ши кынд мэ гындеск ла Тине ын тимпул привегерилор нопций.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Кэч Ту ешть ажуторул меу","poem":2},{"lineBreak":true},{"text":"ши сунт плин де веселие ла умбра арипилор Тале.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Суфлетул меу есте липит де Тине;","poem":2},{"lineBreak":true},{"text":"дряпта Та мэ сприжинэ.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Дар чей че каутэ сэ-мь я вяца","poem":2},{"lineBreak":true},{"text":"се вор дуче ын адынчимиле пэмынтулуй;","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"вор фи даць прадэ сабией,","poem":2},{"lineBreak":true},{"text":"вор фи прада шакалилор.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Дар ымпэратул се ва букура ын Думнезеу;","poem":2},{"lineBreak":true},{"text":"орьчине журэ пе Ел се ва фэли,","poem":2},{"lineBreak":true},{"text":"кэч ва аступа гура минчиношилор.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}