{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Аскултэ-мь гласул, Думнезеуле, кынд ӂем!","poem":1},{"text":"Окротеште-мь вяца ымпотрива врэжмашулуй де каре мэ тем!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Пэзеште-мэ де унелтириле челор рэй,","poem":2},{"lineBreak":true},{"text":"де чата гэлэӂиоасэ а оаменилор нелеӂюиць!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ей ышь аскут лимба ка о сабие,","poem":2},{"lineBreak":true},{"text":"ышь арункэ ворбеле лор амаре ка ниште сэӂець,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ка сэ трагэ ын аскунс асупра челуй невиноват;","poem":2},{"lineBreak":true},{"text":"траг асупра луй пе неаштептате, фэрэ ничо фрикэ.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ей се ымбэрбэтязэ ын рэутатя лор:","poem":2},{"lineBreak":true},{"text":"се сфэтуеск ымпреунэ ка сэ ынтиндэ курсе","poem":2},{"lineBreak":true},{"text":"ши зик: „Чине не ва ведя?”","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Пун ла кале нелеӂюирь","poem":2},{"lineBreak":true},{"text":"ши зик: „Ятэ-не гата, планул есте фэкут!”","poem":2},{"lineBreak":true},{"text":"О прэпастие есте лэунтрул ши инима фиекэруя!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Дар Думнезеу арункэ сэӂець ымпотрива лор:","poem":2},{"lineBreak":true},{"text":"деодатэ ятэ-й ловиць.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Лимба лор ле-а причинуит кэдеря,","poem":2},{"lineBreak":true},{"text":"ши тоць чей че-й вэд клатинэ дин кап.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Тоць оамений сунт куприншь де фрикэ,","poem":2},{"lineBreak":true},{"text":"ши мэртурисеск: „Ятэ че а фэкут Думнезеу”","poem":2},{"lineBreak":true},{"text":"ши рекуноск кэ ачаста есте лукраря Луй!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Чел неприхэнит се букурэ ын Домнул ши ын Ел ышь каутэ скэпаря;","poem":2},{"lineBreak":true},{"text":"тоць чей ку инима фэрэ приханэ се лаудэ кэ сунт феричиць.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}