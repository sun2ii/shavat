{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"verse","number":1,"content":[{"text":"Ку ынкредере, Думнезеуле, вей фи лэудат ын Сион","poem":1},{"text":"ши ымплините вор фи журуинцеле каре Ць-ау фост фэкуте.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ту аскулць ругэчуня,","poem":2},{"lineBreak":true},{"text":"де ачея тоць оамений вор вени ла Тине.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Мэ коплешеск нелеӂюириле,","poem":2},{"lineBreak":true},{"text":"дар Ту вей ерта фэрэделеӂиле ноастре.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Фериче де чел пе каре-л алеӂь Ту ши пе каре-л примешть ынаинтя Та,","poem":2},{"lineBreak":true},{"text":"ка сэ локуяскэ ын курциле Тале!","poem":2},{"lineBreak":true},{"text":"Не вом сэтура де бинекувынтаря Касей Тале,","poem":2},{"lineBreak":true},{"text":"де сфинцения Темплулуй Тэу.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ын бунэтатя Та, Ту не аскулць прин минунь,","poem":2},{"lineBreak":true},{"text":"Думнезеул мынтуирий ноастре,","poem":2},{"lineBreak":true},{"text":"нэдеждя тутурор марӂинилор ындепэртате але пэмынтулуй ши мэрий!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ел ынтэреште мунций прин тэрия Луй","poem":2},{"lineBreak":true},{"text":"ши есте ынчинс ку путере.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ел потолеште урлетул мэрилор, урлетул валурилор лор","poem":2},{"lineBreak":true},{"text":"ши зарва попоарелор.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Чей че локуеск ла марӂиниле лумий се ынспэймынтэ де минуниле Тале.","poem":2},{"lineBreak":true},{"text":"Ту умпли де веселие рэсэритул ши апусул ындепэртат.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ту черчетезь пэмынтул ши-й дай белшуг,","poem":2},{"lineBreak":true},{"text":"ыл умпли де богэций","poem":2},{"lineBreak":true},{"text":"ши де рыурь думнезеешть плине ку апэ.","poem":2},{"lineBreak":true},{"text":"Ту ле дай грыу, пе каре ятэ кум ыл фачь сэ родяскэ:","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ый узь бразделе,","poem":2},{"lineBreak":true},{"text":"ый сфэрымь булгэрий,","poem":2},{"lineBreak":true},{"text":"ыл ынмой ку плоая","poem":2},{"lineBreak":true},{"text":"ши-й бинекувынтезь рэсадул.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ынкунунезь анул ку бунэтэциле Тале","poem":2},{"lineBreak":true},{"text":"ши паший Тэй варсэ белшугул.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Кымпииле пустиулуй сунт адэпате","poem":2},{"lineBreak":true},{"text":"ши дялуриле сунт ынчинсе ку веселие.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Пэшуниле се акоперэ де ой","poem":2},{"lineBreak":true},{"text":"ши вэиле се ымбракэ ку грыу:","poem":2},{"lineBreak":true},{"text":"тоате стригэ де букурие ши кынтэ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}