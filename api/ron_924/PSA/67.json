{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"Думнезеу сэ айбэ милэ де ной ши сэ не бинекувынтезе,","poem":1},{"text":"сэ факэ сэ луминезе песте ной Фаца Луй,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ка сэ се куноаскэ пе пэмынт каля Та","poem":2},{"lineBreak":true},{"text":"ши принтре тоате нямуриле мынтуиря Та!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Те лаудэ попоареле, Думнезеуле,","poem":2},{"lineBreak":true},{"text":"тоате попоареле Те лаудэ.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Се букурэ нямуриле ши се веселеск,","poem":2},{"lineBreak":true},{"text":"кэч Ту жудечь попоареле ку непэртинире","poem":2},{"lineBreak":true},{"text":"ши повэцуешть нямуриле пе пэмынт.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Те лаудэ попоареле, Думнезеуле,","poem":2},{"lineBreak":true},{"text":"тоате попоареле Те лаудэ.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Пэмынтул ышь дэ роаделе.","poem":2},{"lineBreak":true},{"text":"Думнезеу, Думнезеул ностру, не бинекувынтязэ,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Думнезеу не бинекувынтязэ","poem":2},{"lineBreak":true},{"text":"ши тоате марӂиниле пэмынтулуй се тем де Ел.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}