{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"Грэбеште, Думнезеуле, де мэ избэвеште!","poem":1},{"text":"Грэбеште де-мь ажутэ, Доамне!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Сэ рэмынэ де рушине ши ынфрунтаць","poem":2},{"lineBreak":true},{"text":"чей че вор сэ-мь я вяца!","poem":2},{"lineBreak":true},{"text":"Сэ дя ынапой ши сэ рошяскэ","poem":2},{"lineBreak":true},{"text":"чей че-мь дореск пеиря!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Сэ се ынтоаркэ ынапой де рушине чей че зик: „Аха! Аха!”","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Тоць чей че Те каутэ сэ се веселяскэ ши сэ се букуре ын Тине!","poem":2},{"lineBreak":true},{"text":"Чей че юбеск мынтуиря Та","poem":2},{"lineBreak":true},{"text":"сэ зикэ неынчетат: „Прямэрит сэ фие Думнезеу!”","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Еу сунт сэрак ши липсит: грэбеште сэ-мь ажуць, Думнезеуле!","poem":2},{"lineBreak":true},{"text":"Ту ешть Ажуторул ши Избэвиторул меу:","poem":2},{"lineBreak":true},{"text":"Доамне, ну зэбови!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}