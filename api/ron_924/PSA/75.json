{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"verse","number":1,"content":[{"text":"Те лэудэм, Думнезеуле, Те лэудэм;","poem":1},{"text":"ной, каре кемэм Нумеле Тэу,","poem":2},{"lineBreak":true},{"text":"вестим минуниле Тале!","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"„Атунч кынд ва вени время хотэрытэ”, зиче Домнул,","poem":2},{"lineBreak":true},{"text":"„вой жудека фэрэ пэртинире.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Поате сэ се кутремуре пэмынтул ку локуиторий луй,","poem":2},{"lineBreak":true},{"text":"кэч Еу ый ынтэреск стылпий.”","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Еу зик челор че се фэлеск: „Ну вэ фэлиць!”","poem":2},{"lineBreak":true},{"text":"ши челор рэй: „Ну ридикаць капул сус!”","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ну вэ ридикаць капул аша де сус,","poem":2},{"lineBreak":true},{"text":"ну ворбиць ку атыта труфие!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Кэч нич де ла рэсэрит, нич де ла апус,","poem":2},{"lineBreak":true},{"text":"нич дин пустиу ну вине ынэлцаря.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Чи Думнезеу есте Чел че жудекэ:","poem":2},{"lineBreak":true},{"text":"Ел кобоарэ пе унул ши ыналцэ пе алтул.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ын мына Домнулуй есте ун потир ын каре фербе ун вин плин де аместекэтурэ.","poem":2},{"lineBreak":true},{"text":"Кынд ыл варсэ,","poem":2},{"lineBreak":true},{"text":"тоць чей рэй де пе пэмынт суг, ыл сорб ши-л бяу пынэ ын фунд!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Еу ынсэ вой вести пуруря ачесте лукрурь,","poem":2},{"lineBreak":true},{"text":"вой кынта лауде ын чинстя Думнезеулуй луй Иаков","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ши вой доборы тоате путериле челор рэй:","poem":2},{"lineBreak":true},{"text":"путериле челуй неприхэнит ынсэ се вор ынэлца.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}