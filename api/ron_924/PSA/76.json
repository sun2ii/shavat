{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"verse","number":1,"content":[{"text":"Думнезеу есте куноскут ын Иуда,","poem":1},{"text":"маре есте Нумеле Луй ын Исраел.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Кортул Луй есте ын Салем","poem":2},{"lineBreak":true},{"text":"ши локуинца Луй, ын Сион;","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"аколо а сфэрымат Ел сэӂециле,","poem":2},{"lineBreak":true},{"text":"скутул, сабия ши армеле де рэзбой.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ту ешть май мэрец, май путерник декыт мунций рэпиторилор.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Деспуяць ау фост витежий ачея плинь де инимэ, ау адормит сомнул де апой;","poem":2},{"lineBreak":true},{"text":"н-ау путут сэ се апере тоць ачей оамень витежь.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ла мустраря Та, Думнезеул луй Иаков,","poem":2},{"lineBreak":true},{"text":"ау адормит ши кэлэрець, ши кай.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Кыт де ынфрикошат ешть Ту!","poem":2},{"lineBreak":true},{"text":"Чине поате сэ-Ць стя ымпотривэ кынд Ыць избукнеште мыния?","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ай ростит хотэрыря де ла ынэлцимя черурилор;","poem":2},{"lineBreak":true},{"text":"пэмынтул с-а ынгрозит ши а тэкут","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"кынд С-а ридикат Думнезеу сэ факэ дрептате","poem":2},{"lineBreak":true},{"text":"ши сэ скапе пе тоць ненорочиций де пе пэмынт.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Омул Те лаудэ кяр ши ын мыния луй,","poem":2},{"lineBreak":true},{"text":"кынд Те ымбрачь ку тоатэ урӂия Та.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Фачець журуинце Домнулуй Думнезеулуй востру ши ымплиници-ле!","poem":2},{"lineBreak":true},{"text":"Тоць чей че-Л ынконжоарэ сэ адукэ дарурь Думнезеулуй челуй ынфрикошат.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ел фрынӂе мындрия домниторилор,","poem":2},{"lineBreak":true},{"text":"Ел есте ынфрикошат пентру ымпэраций пэмынтулуй.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}