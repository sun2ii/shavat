{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Доамне, Думнезеул ностру, кыт де минунат есте Нумеле Тэу пе тот пэмынтул!","poem":1},{"text":"Слава Та се ыналцэ май пресус де черурь.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Дин гура копиилор ши а челор че суг ла цыцэ, Ць-ай скос о ынтэритурэ де апэраре","poem":2},{"lineBreak":true},{"text":"ымпотрива потривничилор Тэй,","poem":2},{"lineBreak":true},{"text":"ка сэ аступь гура врэжмашулуй ши омулуй ку дор де рэзбунаре.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Кынд привеск черуриле – лукраря мынилор Тале –,","poem":2},{"lineBreak":true},{"text":"луна ши стелеле пе каре ле-ай фэкут,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ымь зик: Че есте омул, ка сэ Те гындешть ла ел?","poem":2},{"lineBreak":true},{"text":"Ши фиул омулуй, ка сэ-л баӂь ын сямэ?","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Л-ай фэкут ку пуцин май прежос декыт Думнезеу","poem":2},{"lineBreak":true},{"text":"ши л-ай ынкунунат ку славэ ши ку чинсте.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Й-ай дат стэпынире песте лукруриле мынилор Тале,","poem":2},{"lineBreak":true},{"text":"тоате ле-ай пус суб пичоареле луй:","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"оиле ши боий лаолалтэ,","poem":2},{"lineBreak":true},{"text":"фяреле кымпулуй,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"пэсэриле черулуй ши пештий мэрий,","poem":2},{"lineBreak":true},{"text":"тот че стрэбате кэрэриле мэрилор.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Доамне, Думнезеул ностру,","poem":2},{"lineBreak":true},{"text":"кыт де минунат есте Нумеле Тэу пе тот пэмынтул!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}