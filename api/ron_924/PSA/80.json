{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"verse","number":1,"content":[{"text":"Я аминте, Пэсторул луй Исраел, Ту, каре повэцуешть пе Иосиф ка пе о турмэ!","poem":1},{"text":"Аратэ-Те ын стрэлучиря Та, Ту, каре шезь пе херувимь!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Трезеште-Ць путеря, ынаинтя луй Ефраим, Бениамин ши Манасе,","poem":2},{"lineBreak":true},{"text":"ши вино ын ажуторул ностру!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ридикэ-не, Думнезеуле,","poem":2},{"lineBreak":true},{"text":"фэ сэ стрэлучяскэ Фаца Та ши вом фи скэпаць!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Доамне, Думнезеул оштирилор,","poem":2},{"lineBreak":true},{"text":"пынэ кынд Те вей мыния, ку тоатэ ругэчуня попорулуй Тэу?","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ый хрэнешть ку о пыне де лакримь","poem":2},{"lineBreak":true},{"text":"ши-й адэпь ку лакримь дин плин.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Не фачь сэ фим мэрул де чартэ ал вечинилор ноштри","poem":2},{"lineBreak":true},{"text":"ши врэжмаший ноштри рыд де ной ынтре ей.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ридикэ-не, Думнезеул оштирилор!","poem":2},{"lineBreak":true},{"text":"Фэ сэ стрэлучяскэ Фаца Та ши вом фи скэпаць!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ту ай адус о вие дин Еӂипт,","poem":2},{"lineBreak":true},{"text":"ай изгонит нямурь ши ай сэдит-о.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ай фэкут лок ынаинтя ей:","poem":2},{"lineBreak":true},{"text":"ши еа а дат рэдэчинь ши а умплут цара.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Мунций ерау акопериць де умбра ей","poem":2},{"lineBreak":true},{"text":"ши рамуриле ей ерау ка ниште чедри ай луй Думнезеу.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ышь ынтиндя млэдицеле пынэ ла маре","poem":2},{"lineBreak":true},{"text":"ши лэстарий пынэ ла рыу.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Пентру че й-ай рупт гардул акум","poem":2},{"lineBreak":true},{"text":"де-о жефуеск тоць трекэторий?","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"О рымэ мистрецул дин пэдуре","poem":2},{"lineBreak":true},{"text":"ши о мэнынкэ фяреле кымпулуй.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Думнезеул оштирилор, ынтоарче-Те ярэшь!","poem":2},{"lineBreak":true},{"text":"Привеште дин чер ши везь! Черчетязэ вия ачаста!","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Окротеште че а сэдит дряпта Та","poem":2},{"lineBreak":true},{"text":"ши пе фиул пе каре Ци л-ай алес!…","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Еа есте арсэ де фок, есте тэятэ!","poem":2},{"lineBreak":true},{"text":"Де мустраря Фецей Тале, ей пер!","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Мына Та сэ фие песте омул дрептей Тале,","poem":2},{"lineBreak":true},{"text":"песте фиул омулуй пе каре Ци л-ай алес!","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ши атунч ну не вом май депэрта де Тине.","poem":2},{"lineBreak":true},{"text":"Ынвиорязэ-не ярэшь ши вом кема Нумеле Тэу!","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Доамне, Думнезеул оштирилор, ридикэ-не ярэшь!","poem":2},{"lineBreak":true},{"text":"Фэ сэ стрэлучяскэ Фаца Та ши вом фи скэпаць!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}