{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"verse","number":1,"content":[{"text":"Кынтаць ку веселие луй Думнезеу, каре есте тэрия ноастрэ!","poem":1},{"text":"Ынэлцаць стригэте де букурие Думнезеулуй луй Иаков!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Кынтаць о кынтаре, сунаць дин тобэ,","poem":2},{"lineBreak":true},{"text":"дин харпа чя плэкутэ ши дин алэутэ!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Сунаць дин трымбицэ ла луна ноуэ,","poem":2},{"lineBreak":true},{"text":"ла луна плинэ, ын зиуа сэрбэторий ноастре!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Кэч ачаста есте о леӂе пентру Исраел,","poem":2},{"lineBreak":true},{"text":"о порункэ а Думнезеулуй луй Иаков.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ел а рындуит сэрбэтоаря ачаста пентру Иосиф,","poem":2},{"lineBreak":true},{"text":"кынд а мерс ымпотрива цэрий Еӂиптулуй…","poem":2},{"lineBreak":true},{"text":"Атунч ам аузит ун глас пе каре ну л-ам куноскут:","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"„Й-ам дескэркат повара де пе умэр","poem":2},{"lineBreak":true},{"text":"ши мыниле луй ну май цин кошул.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ай стригат ын неказ ши те-ам избэвит;","poem":2},{"lineBreak":true},{"text":"ць-ам рэспунс ын локул тайник ал тунетулуй","poem":2},{"lineBreak":true},{"text":"ши те-ам ынчеркат ла апеле Мериба.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Аскултэ, попорул Меу, ши те вой сфэтуи!","poem":2},{"lineBreak":true},{"text":"Исраеле, де М-ай аскулта!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ничун думнезеу стрэин сэ ну фие ын мижлокул тэу","poem":2},{"lineBreak":true},{"text":"ши сэ ну те ынкинь ынаинтя думнезеилор стрэинь!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Еу сунт Домнул Думнезеул тэу,","poem":2},{"lineBreak":true},{"text":"каре те-ам скос дин цара Еӂиптулуй;","poem":2},{"lineBreak":true},{"text":"дескиде-ць гура ларг ши ць-о вой умпле!","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Дар попорул Меу н-а аскултат гласул Меу,","poem":2},{"lineBreak":true},{"text":"Исраел ну М-а аскултат.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Атунч й-ам лэсат ын воя порнирилор инимий лор","poem":2},{"lineBreak":true},{"text":"ши ау урмат сфатуриле лор.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"О! де М-ар аскулта попорул Меу,","poem":2},{"lineBreak":true},{"text":"де ар умбла Исраел ын кэиле Меле!","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ынтр-о клипэ аш ынфрунта пе врэжмаший лор,","poem":2},{"lineBreak":true},{"text":"Мь-аш ынтоарче мына ымпотрива потривничилор лор;","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"чей че урэск пе Домнул Л-ар лингуши,","poem":2},{"lineBreak":true},{"text":"ши феричиря луй Исраел ар дэйнуи ын вечь.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Л-аш хрэни ку чел май бун грыу","poem":2},{"lineBreak":true},{"text":"ши л-аш сэтура ку мьере дин стынкэ.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}