{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"Думнезеу стэ ын адунаря луй Думнезеу;","poem":1},{"text":"Ел жудекэ ын мижлокул думнезеилор.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"„Пынэ кынд вець жудека стрымб","poem":2},{"lineBreak":true},{"text":"ши вець кэута ла фаца челор рэй?","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Фачець дрептате челуй слаб ши орфанулуй,","poem":2},{"lineBreak":true},{"text":"даць дрептате ненорочитулуй ши сэракулуй,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"скэпаць пе чел невояш ши липсит,","poem":2},{"lineBreak":true},{"text":"избэвици-й дин мына челор рэй!”","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Дар ей ну вор сэ штие де нимик, ну причеп нимик,","poem":2},{"lineBreak":true},{"text":"чи умблэ ын ынтунерик,","poem":2},{"lineBreak":true},{"text":"де ачея се клатинэ тоате темелииле пэмынтулуй.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Еу ам зис: „Сунтець думнезей,","poem":2},{"lineBreak":true},{"text":"тоць сунтець фий ай Челуй Пряыналт.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ынсэ вець мури ка ниште оамень,","poem":2},{"lineBreak":true},{"text":"вець кэдя ка ун домнитор оарекаре.”","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Скоалэ-Те, Думнезеуле, ши жудекэ пэмынтул!","poem":2},{"lineBreak":true},{"text":"Кэч тоате нямуриле сунт але Тале.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}