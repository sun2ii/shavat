{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"verse","number":1,"content":[{"text":"Думнезеуле, ну тэчя! Ну тэчя ши ну Те одихни, Думнезеуле!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Кэч ятэ кэ врэжмаший Тэй се фрэмынтэ","poem":1},{"text":"ши чей че Те урэск ыналцэ капул.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Фак планурь плине де виклешуг ымпотрива попорулуй Тэу","poem":2},{"lineBreak":true},{"text":"ши се сфэтуеск ымпотрива челор окротиць де Тине.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"„Вениць”, зик ей, „сэ-й нимичим дин мижлокул нямурилор,","poem":2},{"lineBreak":true},{"text":"ка сэ ну се май поменяскэ нумеле луй Исраел!”","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Се стрынг тоць ку о инимэ,","poem":2},{"lineBreak":true},{"text":"фак ун легэмынт ымпотрива Та:","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"кортуриле луй Едом ши исмаелиций,","poem":2},{"lineBreak":true},{"text":"Моабул ши хагарениций,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Гебал, Амон, Амалек,","poem":2},{"lineBreak":true},{"text":"филистений ку локуиторий Тирулуй.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Асирия се унеште ши еа ку ей","poem":2},{"lineBreak":true},{"text":"ши ышь ымпрумутэ брацул ей копиилор луй Лот.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Фэ-ле ка луй Мадиан,","poem":2},{"lineBreak":true},{"text":"ка луй Сисера, ка луй Иабин ла пырыул Кисон,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"каре ау фост нимичиць ла Ен-Дор","poem":2},{"lineBreak":true},{"text":"ши ау ажунс ун гуной пентру ынгрэшаря пэмынтулуй.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Кэпетениилор лор фэ-ле ка луй Ореб ши Зееб,","poem":2},{"lineBreak":true},{"text":"ши тутурор домнилор лор, ка луй Зебах ши Цалмуна!","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Кэч ей зик: „Сэ пунем мына","poem":2},{"lineBreak":true},{"text":"пе локуинцеле луй Думнезеу!”","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Думнезеуле, фэ-й ка выртежул де праф,","poem":2},{"lineBreak":true},{"text":"ка паюл луат де вынт,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ка фокул каре арде пэдуря","poem":2},{"lineBreak":true},{"text":"ши ка флакэра каре апринде мунций!","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Урмэреште-й астфел ку фуртуна Та","poem":2},{"lineBreak":true},{"text":"ши багэ гроаза ын ей ку вижелия Та!","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Акоперэ-ле фаца де рушине,","poem":2},{"lineBreak":true},{"text":"ка сэ кауте Нумеле Тэу, Доамне!","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Сэ фие рушинаць ши ынгрозиць пе вечие,","poem":2},{"lineBreak":true},{"text":"сэ ле рошяскэ образул де рушине ши сэ пярэ!","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ка сэ штие кэ нумай Ту, ал кэруй Нуме есте Домнул,","poem":2},{"lineBreak":true},{"text":"Ту ешть Чел Пряыналт пе тот пэмынтул.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}