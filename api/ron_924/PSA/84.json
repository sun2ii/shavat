{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"verse","number":1,"content":[{"text":"Кыт де плэкуте сунт локашуриле Тале,","poem":1},{"text":"Доамне ал оштирилор!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Суфлетул меу суспинэ ши тынжеште де дор дупэ курциле Домнулуй,","poem":2},{"lineBreak":true},{"text":"инима ши карня мя стригэ кэтре Думнезеул чел виу!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Пынэ ши пасэря ышь гэсеште о касэ аколо","poem":2},{"lineBreak":true},{"text":"ши рындуника, ун куйб унде ышь пуне пуий…","poem":2},{"lineBreak":true},{"text":"Ах, алтареле Тале, Доамне ал оштирилор,","poem":2},{"lineBreak":true},{"text":"Ымпэратул меу ши Думнезеул меу!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Фериче де чей че локуеск ын Каса Та,","poem":2},{"lineBreak":true},{"text":"кэч ей тот май пот сэ Те лауде!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Фериче де чей че-шь пун тэрия ын Тине,","poem":2},{"lineBreak":true},{"text":"ын а кэрор инимэ локуеште ынкредеря!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Кынд стрэбат ачештя Валя Плынӂерий, о префак ынтр-ун лок плин де извоаре","poem":2},{"lineBreak":true},{"text":"ши плоая тимпурие о акоперэ ку бинекувынтэрь.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ей мерг дин путере ын путере","poem":2},{"lineBreak":true},{"text":"ши се ынфэцишязэ ынаинтя луй Думнезеу ын Сион.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Доамне, Думнезеул оштирилор, аскултэ ругэчуня мя!","poem":2},{"lineBreak":true},{"text":"Я аминте, Думнезеул луй Иаков!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ту, каре ешть скутул ностру, везь, Думнезеуле,","poem":2},{"lineBreak":true},{"text":"ши привеште фаца унсулуй Тэу!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Кэч май мулт фаче о зи ын курциле Тале декыт о мие ын алтэ парте;","poem":2},{"lineBreak":true},{"text":"еу вряу май бине сэ стау ын прагул Касей Думнезеулуй меу","poem":2},{"lineBreak":true},{"text":"декыт сэ локуеск ын кортуриле рэутэций!","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Кэч Домнул Думнезеу есте ун соаре ши ун скут,","poem":2},{"lineBreak":true},{"text":"Домнул дэ ындураре ши славэ","poem":2},{"lineBreak":true},{"text":"ши ну липсеште де ничун бине пе чей че дук о вяцэ фэрэ приханэ.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Доамне ал оштирилор,","poem":2},{"lineBreak":true},{"text":"фериче де омул каре се ынкреде ын Тине!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}