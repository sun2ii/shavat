{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"verse","number":1,"content":[{"text":"Ту ай фост биневоитор ку цара Та, Доамне!","poem":1},{"text":"Ай адус ынапой пе принший де рэзбой ай луй Иаков,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ай ертат нелеӂюиря попорулуй Тэу,","poem":2},{"lineBreak":true},{"text":"й-ай акоперит тоате пэкателе;","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ць-ай абэтут тоатэ априндеря","poem":2},{"lineBreak":true},{"text":"ши Те-ай ынторс дин юцимя мынией Тале.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ынтоарче-не ярэшь, Думнезеул мынтуирий ноастре!","poem":2},{"lineBreak":true},{"text":"Ынчетязэ-Ць мыния ымпотрива ноастрэ!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ын вечь Те вей мыния пе ной?","poem":2},{"lineBreak":true},{"text":"Ын вечь Ыць вей лунӂи мыния?","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ну не вей ынвиора ярэшь,","poem":2},{"lineBreak":true},{"text":"пентру ка сэ се букуре попорул Тэу ын Тине?","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Аратэ-не, Доамне, бунэтатя Та","poem":2},{"lineBreak":true},{"text":"ши дэ-не мынтуиря Та!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Еу вой аскулта че зиче Думнезеу Домнул,","poem":2},{"lineBreak":true},{"text":"кэч Ел ворбеште де паче попорулуй Сэу ши юбицилор Луй,","poem":2},{"lineBreak":true},{"text":"нумай ей сэ ну кадэ ярэшь ын небуние.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Да, мынтуиря Луй есте апроапе де чей че се тем де Ел,","poem":2},{"lineBreak":true},{"text":"пентру ка ын цара ноастрэ сэ локуяскэ слава.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Бунэтатя ши крединчошия се ынтылнеск,","poem":2},{"lineBreak":true},{"text":"дрептатя ши пачя се сэрутэ.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Крединчошия рэсаре дин пэмынт,","poem":2},{"lineBreak":true},{"text":"ши дрептатя привеште де ла ынэлцимя черурилор.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Домнул не ва да ши феричиря,","poem":2},{"lineBreak":true},{"text":"ши пэмынтул ностру ышь ва да роаделе.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Дрептатя ва мерӂе ши ынаинтя Луй","poem":2},{"lineBreak":true},{"text":"ши-Л ва ши урма, кэлкынд пе урмеле пашилор Луй!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}