{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"Сионул аре темелииле ашезате пе мунций чей сфинць:","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Домнул юбеште порциле Сионулуй","poem":1},{"text":"май мулт декыт тоате локашуриле луй Иаков.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Лукрурь плине де славэ ау фост спусе деспре тине,","poem":2},{"lineBreak":true},{"text":"четате а луй Думнезеу!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Еу поменеск Еӂиптул ши Бабилонул принтре чей че Мэ куноск;","poem":2},{"lineBreak":true},{"text":"ятэ, цара филистенилор, Тирул, ку Етиопия","poem":2},{"lineBreak":true},{"text":"„ын Сион с-ау нэскут”,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"яр деспре Сион есте зис: „Тоць с-ау нэскут ын ел”,","poem":2},{"lineBreak":true},{"text":"ши Чел Пряыналт ыл ынтэреште.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Домнул нумэрэ попоареле, скриинду-ле:","poem":2},{"lineBreak":true},{"text":"„Аколо с-ау нэскут.”","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ши чей че кынтэ ши чей че жоакэ стригэ:","poem":2},{"lineBreak":true},{"text":"„Тоате извоареле меле сунт ын Тине.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}