{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"verse","number":1,"content":[{"text":"Доамне, Думнезеул мынтуирий меле!","poem":1},{"text":"Зи ши ноапте стриг ынаинтя Та!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"С-ажунгэ ругэчуня мя ынаинтя Та!","poem":2},{"lineBreak":true},{"text":"Я аминте ла черериле меле,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"кэч ми с-а сэтурат суфлетул де реле","poem":2},{"lineBreak":true},{"text":"ши ми се апропие вяца де Локуинца морцилор.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Сунт пус ын рындул челор че се кобоарэ ын гроапэ,","poem":2},{"lineBreak":true},{"text":"сунт ка ун ом каре ну май аре путере.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Стау ынтинс принтре чей морць","poem":2},{"lineBreak":true},{"text":"ка чей учишь ши кулкаць ын мормынт,","poem":2},{"lineBreak":true},{"text":"де каре ну-Ць май адучь аминте","poem":2},{"lineBreak":true},{"text":"ши каре сунт деспэрциць де мына Та.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"М-ай арункат ын гроапа чя май де жос,","poem":2},{"lineBreak":true},{"text":"ын ынтунерик, ын адынкурь.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Мыния Та мэ апасэ","poem":2},{"lineBreak":true},{"text":"ши мэ нэпэдешть ку тоате валуриле Тале.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ай ындепэртат де ла мине пе тоць приетений мей,","poem":2},{"lineBreak":true},{"text":"м-ай фэкут о причинэ де скырбэ пентру ей;","poem":2},{"lineBreak":true},{"text":"сунт ынкис ши ну пот сэ ес.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ми се топеск окий де суферинцэ;","poem":2},{"lineBreak":true},{"text":"ын тоате зилеле Те кем, Доамне,","poem":2},{"lineBreak":true},{"text":"ши-мь ынтинд мыниле спре Тине!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Оаре пентру морць фачь Ту минунь?","poem":2},{"lineBreak":true},{"text":"Сау се скоалэ морций сэ Те лауде?","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Се ворбеште де бунэтатя Та ын мормынт","poem":2},{"lineBreak":true},{"text":"ши де крединчошия Та ын адынк?","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Сунт куноскуте минуниле Тале ын ынтунерик","poem":2},{"lineBreak":true},{"text":"ши дрептатя Та ын цара уйтэрий?","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Доамне, еу Ыць чер ажуторул","poem":2},{"lineBreak":true},{"text":"ши диминяца ругэчуня мя се ыналцэ ла Тине.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Пентру че, Доамне, лепезь суфлетул меу?","poem":2},{"lineBreak":true},{"text":"Пентру че ымь аскунзь Фаца Та?","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Дин тинереце, сунт ненорочит ши траг сэ мор,","poem":2},{"lineBreak":true},{"text":"сунт купринс де спаймеле Тале ши ну штиу че сэ май фак.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Мыния Та трече песте мине,","poem":2},{"lineBreak":true},{"text":"спаймеле Тале мэ нимическ де тот.","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Еле мэ ынконжоарэ тоатэ зиуа ка ниште апе,","poem":2},{"lineBreak":true},{"text":"мэ ынфэшоарэ тоате деодатэ.","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ай депэртат де ла мине пе приетень ши товарэшь,","poem":2},{"lineBreak":true},{"text":"ши чей де апроапе ай мей с-ау фэкут невэзуць.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}