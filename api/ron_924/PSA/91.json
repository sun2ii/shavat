{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"Чел че стэ суб окротиря Челуй Пряыналт","poem":1},{"text":"ши се одихнеште ла умбра Челуй Атотпутерник","poem":2}]},{"type":"verse","number":2,"content":[{"text":"зиче деспре Домнул: „Ел есте локул меу де скэпаре ши четэцуя мя,","poem":2},{"lineBreak":true},{"text":"Думнезеул меу ын каре мэ ынкред!”","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Да, Ел те скапэ де лацул вынэторулуй,","poem":2},{"lineBreak":true},{"text":"де чумэ ши де пустиириле ей.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ел те ва акопери ку пенеле Луй","poem":2},{"lineBreak":true},{"text":"ши те вей аскунде суб арипиле Луй.","poem":2},{"lineBreak":true},{"text":"Кэч скут ши павэзэ есте крединчошия Луй!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ну требуе сэ те темь нич де гроаза дин тимпул нопций,","poem":2},{"lineBreak":true},{"text":"нич де сэӂята каре збоарэ зиуа,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"нич де чума каре умблэ ын ынтунерик,","poem":2},{"lineBreak":true},{"text":"нич де молима каре бынтуе зиуа-н амяза маре.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"О мие сэ кадэ алэтурь де тине","poem":2},{"lineBreak":true},{"text":"ши зече мий ла дряпта та,","poem":2},{"lineBreak":true},{"text":"дар де тине ну се вор апропия.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Доар вей приви ку окий","poem":2},{"lineBreak":true},{"text":"ши вей ведя рэсплэтиря челор рэй.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Пентру кэ зичь: „Домнул есте локул меу де адэпост ”","poem":2},{"lineBreak":true},{"text":"ши фачь дин Чел Пряыналт турнул тэу де скэпаре,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"де ачея ничо ненорочире ну те ва ажунӂе,","poem":2},{"lineBreak":true},{"text":"ничо урӂие ну се ва апропия де кортул тэу.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Кэч Ел ва порунчи ынӂерилор Сэй","poem":2},{"lineBreak":true},{"text":"сэ те пэзяскэ ын тоате кэиле тале;","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ши ей те вор дуче пе мынь,","poem":2},{"lineBreak":true},{"text":"ка ну кумва сэ-ць ловешть пичорул де врео пятрэ.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Вей пэши песте лей ши песте нэпырчь","poem":2},{"lineBreak":true},{"text":"ши вей кэлка песте пуй де лей ши песте шерпь.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"„Фииндкэ Мэ юбеште”, зиче Домнул, „де ачея ыл вой избэви;","poem":2},{"lineBreak":true},{"text":"ыл вой окроти, кэч куноаште Нумеле Меу.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Кынд Мэ ва кема, ый вой рэспунде;","poem":2},{"lineBreak":true},{"text":"вой фи ку ел ын стрымтораре,","poem":2},{"lineBreak":true},{"text":"ыл вой избэви ши-л вой прослэви.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ыл вой сэтура ку вяцэ лунгэ","poem":2},{"lineBreak":true},{"text":"ши-й вой арэта мынтуиря Мя.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}