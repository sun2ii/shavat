{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"verse","number":1,"content":[{"text":"Фрумос есте сэ лэудэм пе Домнул","poem":1},{"text":"ши сэ мэрим Нумеле Тэу, Пряыналте,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"сэ вестим диминяца бунэтатя Та","poem":2},{"lineBreak":true},{"text":"ши ноаптя крединчошия Та,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ку инструментул ку зече коарде ши ку алэута,","poem":2},{"lineBreak":true},{"text":"ын сунетеле харпей.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Кэч Ту мэ ынвеселешть ку лукрэриле Тале, Доамне,","poem":2},{"lineBreak":true},{"text":"ши еу кынт де веселие кынд вэд лукраря мынилор Тале.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Кыт де марь сунт лукрэриле Тале, Доамне,","poem":2},{"lineBreak":true},{"text":"ши кыт де адынчь сунт гындуриле Тале!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Омул прост ну куноаште лукрул ачеста","poem":2},{"lineBreak":true},{"text":"ши чел небун ну я сяма ла ел.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Дакэ чей рэй ынверзеск ка ярба","poem":2},{"lineBreak":true},{"text":"ши дакэ тоць чей че фак рэул ынфлореск,","poem":2},{"lineBreak":true},{"text":"есте нумай ка сэ фие нимичиць пе вечие.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Дар Ту, Доамне, ешть ынэлцат ын вечь де вечь!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Кэч ятэ, Доамне, врэжмаший Тэй,","poem":2},{"lineBreak":true},{"text":"ятэ, врэжмаший Тэй пер:","poem":2},{"lineBreak":true},{"text":"тоць чей че фак рэул сунт рисипиць.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Дар мие Ту-мь дай путеря биволулуй","poem":2},{"lineBreak":true},{"text":"ши м-ай стропит ку унтделемн проаспэт.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Окюл меу ышь веде ымплинитэ доринца фацэ де врэжмаший мей","poem":2},{"lineBreak":true},{"text":"ши урекя мя ауде ымплиниря доринцей меле фацэ де потривничий мей чей рэй.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Чел фэрэ приханэ ынверзеште ка финикул","poem":2},{"lineBreak":true},{"text":"ши креште ка чедрул дин Либан.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Чей сэдиць ын Каса Домнулуй","poem":2},{"lineBreak":true},{"text":"ынверзеск ын курциле Думнезеулуй ностру.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ей адук роаде ши ла бэтрынеце;","poem":2},{"lineBreak":true},{"text":"сунт плинь де сук ши верзь,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ка сэ арате кэ Домнул есте дрепт,","poem":2},{"lineBreak":true},{"text":"Ел, Стынка мя, ын каре ну есте нелеӂюире.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}