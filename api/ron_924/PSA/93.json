{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Домнул ымпэрэцеште ымбрэкат ку мэрецие;","poem":1},{"text":"Домнул есте ымбрэкат ши ынчинс ку путере,","poem":2},{"lineBreak":true},{"text":"де ачея лумя есте таре ши ну се клатинэ.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Скаунул Тэу де домние есте ашезат дин времурь стрэвекь;","poem":2},{"lineBreak":true},{"text":"Ту ешть дин вешничие!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Рыуриле вуеск, Доамне,","poem":2},{"lineBreak":true},{"text":"рыуриле вуеск таре,","poem":2},{"lineBreak":true},{"text":"рыуриле се умфлэ ку путере.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Дар май путерник декыт вуетул апелор марь","poem":2},{"lineBreak":true},{"text":"ши май путерник декыт вуетул валурилор нэпрасниче але мэрий","poem":2},{"lineBreak":true},{"text":"есте Домнул ын локуриле черешть.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Мэртурииле Тале сунт ку тотул адевэрате;","poem":2},{"lineBreak":true},{"text":"сфинцения есте подоаба Касей Тале,","poem":2},{"lineBreak":true},{"text":"Доамне, пентру тот тимпул кыт вор цине времуриле.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}