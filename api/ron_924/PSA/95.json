{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Вениць сэ кынтэм ку веселие Домнулуй","poem":1},{"text":"ши сэ стригэм де букурие кэтре Стынка мынтуирий ноастре.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Сэ мерӂем ынаинтя Луй ку лауде,","poem":2},{"lineBreak":true},{"text":"сэ фачем сэ рэсуне кынтече ын чинстя Луй!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Кэч Домнул есте ун Думнезеу маре,","poem":2},{"lineBreak":true},{"text":"есте ун Ымпэрат маре, май пресус де тоць думнезеий.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ел цине ын мынэ адынчимиле пэмынтулуй","poem":2},{"lineBreak":true},{"text":"ши вырфуриле мунцилор сунт але Луй.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"А Луй есте маря, Ел а фэкут-о,","poem":2},{"lineBreak":true},{"text":"ши мыниле Луй ау ынтокмит ускатул:","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"вениць сэ не ынкинэм ши сэ не смерим,","poem":2},{"lineBreak":true},{"text":"сэ не плекэм ӂенункюл ынаинтя Домнулуй, Фэкэторулуй ностру!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Кэч Ел есте Думнезеул ностру","poem":2},{"lineBreak":true},{"text":"ши ной сунтем попорул пэшуний Луй, турма пе каре о повэцуеште мына Луй… О! де аць аскулта азь гласул Луй!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"„Ну вэ ымпетриць инима ка ла Мериба,","poem":2},{"lineBreak":true},{"text":"ка ын зиуа де ла Маса, ын пустиу,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"унде пэринций воштри М-ау испитит","poem":2},{"lineBreak":true},{"text":"ши М-ау ынчеркат, мэкар кэ вэзусерэ лукрэриле Меле!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Патрузечь де ань М-ам скырбит де нямул ачеста","poem":2},{"lineBreak":true},{"text":"ши ам зис: ‘Есте ун попор ку инима рэтэчитэ;","poem":2},{"lineBreak":true},{"text":"ей ну куноск кэиле Меле.’","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Де ачея ам журат ын мыния Мя:","poem":2},{"lineBreak":true},{"text":"‘Ну вор интра ын одихна Мя!’”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}