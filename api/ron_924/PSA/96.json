{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"Кынтаць Домнулуй о кынтаре ноуэ!","poem":1},{"text":"Кынтаць Домнулуй, тоць локуиторий пэмынтулуй!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Кынтаць Домнулуй, бинекувынтаць Нумеле Луй,","poem":2},{"lineBreak":true},{"text":"вестиць дин зи ын зи мынтуиря Луй!","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Повестиць принтре нямурь слава Луй,","poem":2},{"lineBreak":true},{"text":"принтре тоате попоареле минуниле Луй!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Кэч Домнул есте маре ши фоарте вредник де лаудэ.","poem":2},{"lineBreak":true},{"text":"Ел есте май де темут декыт тоць думнезеий.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Кэч тоць думнезеий попоарелор сунт ниште идоль,","poem":2},{"lineBreak":true},{"text":"дар Домнул а фэкут черуриле.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Стрэлучиря ши мэреция сунт ынаинтя Фецей Луй,","poem":2},{"lineBreak":true},{"text":"слава ши подоаба сунт ын Локашул Луй чел Сфынт.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Фамилииле попоарелор, даць Домнулуй,","poem":2},{"lineBreak":true},{"text":"даць Домнулуй славэ ши чинсте!","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Даць Домнулуй слава кувенитэ Нумелуй Луй!","poem":2},{"lineBreak":true},{"text":"Адучець дарурь де мынкаре ши интраць ын курциле Луй!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ынкинаци-вэ ынаинтя Домнулуй ымбрэкаць ку подоабе сфинте,","poem":2},{"lineBreak":true},{"text":"тремураць ынаинтя Луй, тоць локуиторий пэмынтулуй!","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Спунець принтре нямурь: „Домнул ымпэрэцеште!","poem":2},{"lineBreak":true},{"text":"Де ачея лумя есте таре ши ну се клатинэ.”","poem":2},{"lineBreak":true},{"text":"Домнул жудекэ попоареле ку дрептате.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Сэ се букуре черуриле ши сэ се веселяскэ пэмынтул;","poem":2},{"lineBreak":true},{"text":"сэ муӂяскэ маря ку тот че купринде еа!","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Сэ тресалте кымпия ку тот че е пе еа,","poem":2},{"lineBreak":true},{"text":"тоць копачий пэдурий сэ стриӂе де букурие","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ынаинтя Домнулуй! Кэч Ел вине,","poem":2},{"lineBreak":true},{"text":"вине сэ жудече пэмынтул.","poem":2},{"lineBreak":true},{"text":"Ел ва жудека лумя ку дрептате","poem":2},{"lineBreak":true},{"text":"ши попоареле дупэ крединчошия Луй.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}