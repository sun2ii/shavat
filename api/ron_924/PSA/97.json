{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"Домнул ымпэрэцеште: сэ се веселяскэ пэмынтул","poem":1},{"text":"ши сэ се букуре остроавеле челе мулте!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Норий ши негура Ыл ынконжоарэ,","poem":2},{"lineBreak":true},{"text":"дрептатя ши жудеката сунт темелия скаунулуй Сэу де домние.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ынаинтя Луй мерӂе фокул","poem":2},{"lineBreak":true},{"text":"ши арде де жур ымпрежур пе потривничий Луй.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Фулӂереле Луй луминязэ лумя:","poem":2},{"lineBreak":true},{"text":"пэмынтул Ыл веде ши се кутремурэ.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Мунций се топеск ка чара ынаинтя Домнулуй,","poem":2},{"lineBreak":true},{"text":"ынаинтя Домнулуй ынтрегулуй пэмынт.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Черуриле вестеск дрептатя Луй","poem":2},{"lineBreak":true},{"text":"ши тоате попоареле вэд слава Луй.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Сунт рушинаць тоць чей че служеск икоанелор","poem":2},{"lineBreak":true},{"text":"ши каре се фэлеск ку идолий:","poem":2},{"lineBreak":true},{"text":"тоць думнезеий се ынкинэ ынаинтя Луй.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Сионул ауде лукрул ачеста ши се букурэ, се веселеск фийчеле луй Иуда","poem":2},{"lineBreak":true},{"text":"де жудекэциле Тале, Доамне!","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Кэч Ту, Доамне, Ту ешть Чел Пряыналт песте тот пэмынтул,","poem":2},{"lineBreak":true},{"text":"Ту ешть пряынэлцат, май пресус де тоць думнезеий.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Урыць рэул, чей че юбиць пе Домнул!","poem":2},{"lineBreak":true},{"text":"Ел пэзеште суфлетеле крединчошилор Луй","poem":2},{"lineBreak":true},{"text":"ши-й избэвеште дин мына челор рэй.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Лумина есте семэнатэ пентру чел неприхэнит","poem":2},{"lineBreak":true},{"text":"ши букурия, пентру чей ку инима куратэ.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Неприхэницилор, букураци-вэ ын Домнул","poem":2},{"lineBreak":true},{"text":"ши мэриць прин лауделе воастре сфинцения Луй!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}