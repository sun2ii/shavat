{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"verse","number":1,"content":[{"text":"Кынтаць Домнулуй о кынтаре ноуэ,","poem":1},{"text":"кэч Ел а фэкут минунь! Дряпта ши брацул Луй чел сфынт Й-ау венит ын ажутор.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Домнул Шь-а арэтат мынтуиря,","poem":2},{"lineBreak":true},{"text":"Шь-а дескоперит дрептатя ынаинтя нямурилор.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Шь-а адус аминте де бунэтатя ши крединчошия Луй фацэ де каса луй Исраел:","poem":2},{"lineBreak":true},{"text":"тоате марӂиниле пэмынтулуй ау вэзут мынтуиря Думнезеулуй ностру.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Стригаць кэтре Домнул ку стригэте де букурие, тоць локуиторий пэмынтулуй!","poem":2},{"lineBreak":true},{"text":"Киуиць, стригаць ши кынтаць лауде!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Кынтаць Домнулуй ку харпа,","poem":2},{"lineBreak":true},{"text":"ку харпа ши ку кынтече дин гурэ!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ку трымбице ши сунете дин корн,","poem":2},{"lineBreak":true},{"text":"стригаць де букурие ынаинтя Ымпэратулуй, Домнулуй!","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Сэ урле маря ку тот че купринде еа,","poem":2},{"lineBreak":true},{"text":"сэ киуе лумя ши чей че локуеск пе еа,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"сэ батэ дин палме рыуриле,","poem":2},{"lineBreak":true},{"text":"сэ стриӂе де букурие тоць мунций","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ынаинтя Домнулуй, кэч Ел вине сэ жудече пэмынтул!","poem":2},{"lineBreak":true},{"text":"Ел ва жудека лумя ку дрептате","poem":2},{"lineBreak":true},{"text":"ши попоареле ку непэртинире.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}