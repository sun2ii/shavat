{"translation":{"id":"ron_924","name":"Библия Думитру Корнилеску 1924 (БДК)","website":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ron1924","licenseNotes":null,"shortName":"924","englishName":"Romanian Bible (Cyrillic)","language":"ron","textDirection":"ltr","sha256":"5afa5695a1681e42da5d1ed218789fc1fc85f0cecfb2cf4c21a5d9f1fd55da8b","availableFormats":["json"],"listOfBooksApiLink":"/api/ron_924/books.json","numberOfBooks":66,"totalNumberOfChapters":1188,"totalNumberOfVerses":31045,"languageName":"română","languageEnglishName":"Romanian"},"book":{"id":"PSA","translationId":"ron_924","name":"Псалмул","commonName":"Псалмул","title":"Псалмул","order":19,"numberOfChapters":150,"sha256":"ccf9a9d746cb9ee11fd37205c12f267afc8f42a9c7c4a968415485e2181ea4b6","firstChapterNumber":1,"firstChapterApiLink":"/api/ron_924/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ron_924/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Домнул ымпэрэцеште: попоареле тремурэ;","poem":1},{"text":"Ел шаде пе херувимь: пэмынтул се клатинэ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Домнул есте маре ын Сион","poem":2},{"lineBreak":true},{"text":"ши ынэлцат песте тоате попоареле.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Сэ лауде оамений Нумеле Тэу чел маре ши ынфрикошат,","poem":2},{"lineBreak":true},{"text":"кэч есте сфынт!","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Сэ лауде оамений тэрия Ымпэратулуй, кэч юбеште дрептатя!","poem":2},{"lineBreak":true},{"text":"Ту ынтэрешть дрептатя,","poem":2},{"lineBreak":true},{"text":"Ту фачь дрептате ши жудекатэ ын Иаков.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ынэлцаць пе Домнул Думнезеул ностру","poem":2},{"lineBreak":true},{"text":"ши ынкинаци-вэ ынаинтя аштернутулуй пичоарелор Луй,","poem":2},{"lineBreak":true},{"text":"кэч есте сфынт!","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Мойсе ши Аарон, динтре преоций Луй,","poem":2},{"lineBreak":true},{"text":"ши Самуел, динтре чей че кемау Нумеле Луй,","poem":2},{"lineBreak":true},{"text":"ау кемат пе Домнул, ши Ел й-а аскултат.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ел ле-а ворбит дин стылпул де нор;","poem":2},{"lineBreak":true},{"text":"ей ау пэзит порунчиле Луй ши Леӂя пе каре ле-а дат-о Ел.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Доамне, Думнезеул ностру, Ту й-ай аскултат;","poem":2},{"lineBreak":true},{"text":"ай фост пентру ей ун Думнезеу ертэтор,","poem":2},{"lineBreak":true},{"text":"дар й-ай педепсит пентру грешелиле лор.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ынэлцаць пе Домнул Думнезеул ностру","poem":2},{"lineBreak":true},{"text":"ши ынкинаци-вэ пе мунтеле Луй чел сфынт!","poem":2},{"lineBreak":true},{"text":"Кэч Домнул Думнезеул ностру есте сфынт!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ron_924/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_924/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_924/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}