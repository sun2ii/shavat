curoasă a copiilor. Lăudați pe DOMNUL."]}],"footnotes":[]},"thisChapterLink":"/api/ron_btf/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_btf/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_btf/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}