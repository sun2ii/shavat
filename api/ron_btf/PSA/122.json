ul tău."]},{"type":"verse","number":9,"content":["Datorită casei DOMNULUI Dumnezeul nostru voi căuta binele tău."]}],"footnotes":[]},"thisChapterLink":"/api/ron_btf/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ron_btf/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ron_btf/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}