{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":100,"content":[{"type":"heading","content":["Song blanga gibit theingks"]},{"type":"verse","number":1,"content":[{"text":"Sing adbala langa YAWEI det trubala God, ol yumob pipul langa ebri kantri!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Weship YAWEI gudbinjiwei.","poem":1},{"lineBreak":true},{"text":"Kaman langa im en sing ola hepiwan song!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yumob garra sabi dijan brabliwei.","poem":1},{"lineBreak":true},{"text":"YAWEI im God.","poem":1},{"lineBreak":true},{"text":"Imbin meigim wi, en wi na im pipul.","poem":1},{"lineBreak":true},{"text":"Wi blanga im en wi jidan jis laik im ronwan shipmob.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kamap thru det geit en tok theingkyu langa im.","poem":1},{"lineBreak":true},{"text":"Kaman langa im haus en preisim im.","poem":1},{"lineBreak":true},{"text":"Gibit im theingks en preisim im neim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"YAWEI im gudwan.","poem":1},{"lineBreak":true},{"text":"Im laigim im pipul olabat olagijawan.","poem":1},{"lineBreak":true},{"text":"Im garra oldei dum wanim imbin pramis.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}