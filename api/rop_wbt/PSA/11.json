{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":11,"content":[{"type":"heading","content":["Wen yu trastim YAWEI"]},{"type":"heading","content":["Song blanga Deibid."]},{"type":"verse","number":1,"content":[{"text":"Mi oldei trastim YAWEI blanga kipum mi seif.","poem":1},{"lineBreak":true},{"text":"Wotfo yu tok langa mi blanga ranawei jis laik bard weya flaiwei langa bigwan hil blanga jidan seifwan?","poem":1},{"lineBreak":true},{"text":"Im trubala orait, detlot nogud pipul redi blanga shudum garram bo en erro.","poem":1},{"lineBreak":true},{"text":"Brom det dakwan pleis dei weidabat blanga kilimbat ola gudwan pipul.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wen nogudbala pipul meigim ebrijing rong,","poem":1},{"lineBreak":true},{"text":"wanim ola gudwan pipul gin dum? Najing!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"YAWEI, im jidan langa im seikridwan pleis.","poem":1},{"lineBreak":true},{"text":"Im jidan bos langa hebin.","poem":1},{"lineBreak":true},{"text":"Im wotjimbat pipul ebriweya en im sabi wanim olabat dumbat.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Im luk ola gudwan pipul en ola nogudwan pipul seimwei.","poem":1},{"lineBreak":true},{"text":"Im nomo laigim ola jigiwan pipul brabliwei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Im garra jandimdan hotwan eshis en smok garram nogudwan smel langa ola nogudwan pipul.","poem":1},{"lineBreak":true},{"text":"Im garra panishim olabat garram brabli hotwan win.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"YAWEI nomo garram eni rong langa im,","poem":1},{"lineBreak":true},{"text":"en im laigim ola gud ting weya pipul dum.","poem":1},{"lineBreak":true},{"text":"Detlot hu dum lagijat na garra luk im.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":6}