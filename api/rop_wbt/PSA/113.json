{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":113,"content":[{"type":"heading","content":["Preisim YAWEI dumaji im brabli gudwan"]},{"type":"verse","number":1,"content":[{"text":"Preisim YAWEI det trubalawan God!","poem":1},{"lineBreak":true},{"text":"Kaman en preisim im neim ol yumob hu wek blanga im.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Preisim im neim tudei en olagijawan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wi garra preisim det neim blanga YAWEI brom sangidaptaim raidap sangodantaim.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"YAWEI im jidan mowa haibalawan langa ola pipul langa ebri kantri tudei.","poem":1},{"lineBreak":true},{"text":"Im jidan mowa haibalawan oba ebrijing ontop langa hebin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nobodi gin jidan wulijim YAWEI det trubalawan God blanga wi.","poem":1},{"lineBreak":true},{"text":"Im jidan brabli haibalawan na.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Im jukdan blanga luk ebrijing langa skai en langa dijan wel.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"God im album ol detlot powan pipul hu nomo garram enijing,","poem":1},{"lineBreak":true},{"text":"jis laik dei jidan langa det rabishwan pleis,","poem":1},{"lineBreak":true},{"text":"en brom deya im lidimap olabat,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"en im meigim olabat jidan mijamet garram ola bos blanga im pipul olabat.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wen det waifwan kaan abum biginini,","poem":1},{"lineBreak":true},{"text":"wal YAWEI larram im blanga abum biginini,","poem":1},{"lineBreak":true},{"text":"en det gel jidan brabli gudbinji.","poem":1},{"lineBreak":true},{"text":"Preisim YAWEI det trubalawan God.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}