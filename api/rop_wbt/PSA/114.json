{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":114,"content":[{"type":"heading","content":["Dijan song blanga Pasoba Serramoni"]},{"type":"verse","number":1,"content":[{"text":"Wen detlot Isreil pipul hubin det femilimob blanga Jeikob bin libum det kantri Ijip weya pipul deya tok najawan langgus,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ola Juda pipul bin jidan seikridwan blanga YAWEI,","poem":1},{"lineBreak":true},{"text":"en ola Isreil pipul bin jidan ronwan pipul blanga YAWEI.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"God bin kaman langa det Redsi en imbin draiyimap det woda,","poem":1},{"lineBreak":true},{"text":"en det Jodan Riba bin stap randan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Detlot bigwan hil bin jampjamp wulijim nenigout,","poem":1},{"lineBreak":true},{"text":"en najalot hil bin jamparanbat wulijim yangwan ship.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wanim bin hepin langa yu solwoda blanga meigim yu draiyap?","poem":1},{"lineBreak":true},{"text":"En yu Jodan Riba, wotfo yubin stap randanbat?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ol yumob bigwan hil, wotfo yumob bin jampjamp wulijim nenigout?","poem":1},{"lineBreak":true},{"text":"En ol yumob hil, wotfo yumob bin jamparanbat wulijim yangwan ship?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sheiksheik graun! YAWEI im kaminap.","poem":1},{"lineBreak":true},{"text":"Sheik lida langa YAWEI det God blanga Jeikob.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Im na bin meigim woda kamat brom bigwan rok,","poem":1},{"lineBreak":true},{"text":"en bin meigim springwoda ranat brom ola adwan rok.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}