{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":120,"content":[{"type":"heading","content":["Dijan preya blanga albumbat"]},{"type":"verse","number":1,"content":[{"text":"Wen aibin abum trabul, aibin jingat langa YAWEI,","poem":1},{"lineBreak":true},{"text":"en imbin ensim mi en album mi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"YAWEI, yu seibum mi brom ola laiyawan pipul,","poem":1},{"lineBreak":true},{"text":"en brom detlot pipul hu nomo jidan trubalawei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yumob ola laiyawan pipul, wanim God garra dum langa yumob?","poem":1},{"lineBreak":true},{"text":"Hau im garra panishim yumob?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Im garra panishim yumob brabliwei garram ola shapwan spiya blanga solja,","poem":1},{"lineBreak":true},{"text":"en barnimap yumob garram brabli hotwan eshis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi jidanabat garram yumob, en im nogudwan.","poem":1},{"lineBreak":true},{"text":"Im seim laik mi jidan garram detlot krulbala pipul brom det dubala kantri gulum Mishek en Keda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aibin jidan brabli longtaim garram pipul hu nomo laigim blanga jidan gudbinjiwei.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wen mi tok blanga jidan kwaitbalawei,","poem":1},{"lineBreak":true},{"text":"olabat wandi fait.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}