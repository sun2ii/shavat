{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":121,"content":[{"type":"heading","content":["God na kipum wi seif"]},{"type":"verse","number":1,"content":[{"text":"Ai lukap langa ola hil.","poem":1},{"lineBreak":true},{"text":"Hu garra kaman blanga album mi wen mi abum trabul?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"YAWEI det trubala God na garra kaman blanga album mi.","poem":1},{"lineBreak":true},{"text":"Im na bin meigim ebrijing langa skai en langa graun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"YAWEI, im oldei wotjimbat wi wulijim wi kaan buldan.","poem":1},{"lineBreak":true},{"text":"Im oldei lukaftumbat wi.","poem":1},{"lineBreak":true},{"text":"Im nomo go silip.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tharran hu lukaftumbat im pipul langa Isreil,","poem":1},{"lineBreak":true},{"text":"im jidan weik en wotjimbat.","poem":1},{"lineBreak":true},{"text":"Im nomo go silip.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"YAWEI kipum wi seif brom olkain trabul,","poem":1},{"lineBreak":true},{"text":"jis laiga bigwan tri im gudwan sheid brom det hotwan san.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"YAWEI im blokim ebrijing.","poem":1},{"lineBreak":true},{"text":"Det san kaan ardim wi deitaim,","poem":1},{"lineBreak":true},{"text":"en det mun kaan ardim wi naitaim.","poem":1},{"lineBreak":true},{"text":"Nomo enijing kaan ardim wi deitaim en naitaim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"YAWEI garra kipum wi seif.","poem":1},{"lineBreak":true},{"text":"Nomo enijing kaan ardim wi.","poem":1},{"lineBreak":true},{"text":"Im garra wotjimbat wi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wen yu gowei YAWEI garra wotjimbat yu,","poem":1},{"lineBreak":true},{"text":"en wen yu kambek im garra lukaftum yu,","poem":1},{"lineBreak":true},{"text":"tudei na, en tumorro en olagijawan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}