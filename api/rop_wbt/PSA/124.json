{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":124,"content":[{"type":"heading","content":["God oldei lukaftumbat im pipul"]},{"type":"heading","content":["Song blanga Deibid."]},{"type":"verse","number":1,"content":[{"text":"If YAWEI nomo bina jidan garram wi, wanim bina hepin langa wi?","poem":1},{"lineBreak":true},{"text":"Yumob Isreil pipul ensim mi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“If YAWEI nomo bina jidan garram wi wen wi enamimob bin kaman blanga fait langa wi,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"dei bina binijimap wi,","poem":1},{"lineBreak":true},{"text":"dumaji deibin wail langa wi detmatj,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"en jis laiga fladwoda, olabat bina deigimwei wi en gaburrumap wi,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"en det fladwoda bina binijimap wi na.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wi gibit theingks langa YAWEI.","poem":1},{"lineBreak":true},{"text":"Im nomo bin larram wi enamimob kilim wi ded, jis laiga brabli jigiwan dog.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wibin ranawei friwan wulijim bard wen im flaiwei brom det breikinwan trep.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Oni YAWEI na oldei albumbat wi.","poem":1},{"lineBreak":true},{"text":"Im na bin meigim det skai en dijan graun.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}