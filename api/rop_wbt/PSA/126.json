{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":126,"content":[{"type":"heading","content":["Det preya langa God blanga album Isreil"]},{"type":"verse","number":1,"content":[{"text":"Wen YAWEI bin bringimbek melabat langa Jerusalem imbin jis laik melabat bin drim tharran.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wibin laflafbat en wibin singsingbat dumaji wibin gudbinji.","poem":1},{"lineBreak":true},{"text":"En ola pipul brom ola najalot kantri bin tok blanga melabat lagijat,","poem":1},{"lineBreak":true},{"text":"“YAWEI bin dum ola brabli gudbala ting langa olabat.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Trubala imbin dum ola brabli gudbala ting blanga wi,","poem":1},{"lineBreak":true},{"text":"en wibin brabli gudbinji!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"YAWEI, yu gibit melabat ebrijing igin,","poem":1},{"lineBreak":true},{"text":"jis laik rein wen im bilimap woda langa ola draiwan riba.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Larram ol detlot pipul hubin kraikrai wen deibin plentimbat olabat gadin,","poem":1},{"lineBreak":true},{"text":"gajimbat detlot sid daga gudbinjiwei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ol detlot pipul hubin kraikrai wen deibin go blanga plentimbat ola sid daga,","poem":1},{"lineBreak":true},{"text":"garra kambek singsingbat gudbinjiwei wen olabat bringimbek ola daga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}