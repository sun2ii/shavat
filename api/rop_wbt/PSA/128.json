{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":128,"content":[{"type":"heading","content":["Blanga detlot pipul hu teiknodis langa YAWEI"]},{"type":"verse","number":1,"content":[{"text":"Ol detlot pipul hu teiknodis langa YAWEI en hu bulurrum im wei,","poem":1},{"lineBreak":true},{"text":"olabat na garra jidan gudbinjiwei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yu garra dum wek blanga gajim ola enijing blanga yu laif,","poem":1},{"lineBreak":true},{"text":"en yu garra jidan gudbalawei.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yu waif garra abum detmatj biginini jis laik greiptri weya abum detmatj daga,","poem":1},{"lineBreak":true},{"text":"en olabat garra jidan raidaran langa yu faiya pleis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lagijat na YAWEI im gibit ola gudbala ting langa pipul hu teiknodis en duwit langa im.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ai askim YAWEI blanga gibit yu ola gudbala ting brom im serramoni pleis langa Saiyan,","poem":1},{"lineBreak":true},{"text":"en blanga larram yu luk Jerusalem abum ebrijing brom tudei raidap yu dai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ai prei yu garra jidan laibalawan raidap yu luk yu bigininimob biginini olabat.","poem":1},{"lineBreak":true},{"text":"YAWEI, yu meigim ola Isreil pipul jidan gudbinjiwei!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}