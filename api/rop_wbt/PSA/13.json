{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":13,"content":[{"type":"heading","content":["Mi jingat langa YAWEI blanga album mi"]},{"type":"heading","content":["Song blanga Deibid."]},{"type":"verse","number":1,"content":[{"text":"YAWEI, haulong yu garra fogedabat mi?","poem":1},{"lineBreak":true},{"text":"Maitbi olagijawan.","poem":1},{"lineBreak":true},{"text":"Mi weidabat langa yu blanga album mi,","poem":1},{"lineBreak":true},{"text":"bat im jis laik yubin gibit bekboun langa mi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Olataim aibin nogudbinji detmatj,","poem":1},{"lineBreak":true},{"text":"en aibin sori miselp detmatj langa main hat.","poem":1},{"lineBreak":true},{"text":"En olataim main enami olabat oldei win,","poem":1},{"lineBreak":true},{"text":"dumaji mi brabli wikwan blanga bidim olabat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Luk langa mi, YAWEI.","poem":1},{"lineBreak":true},{"text":"Ensim mi, main God!","poem":1},{"lineBreak":true},{"text":"Yu kain langa mi en meigim mi jidan strongbala igin!","poem":1},{"lineBreak":true},{"text":"If yu nomo album mi wal ai garra dai,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"En main enami olabat garra tok, “Wibin bidim im!”","poem":1},{"lineBreak":true},{"text":"En detlot pipul hu fait langa mi garra gudbinji,","poem":1},{"lineBreak":true},{"text":"dumaji deibin bidim mi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bat mi trastimbat yu dumaji yu laigim mi olagijawan.","poem":1},{"lineBreak":true},{"text":"Ai garra jidan gudbinji igin, dumaji yu garra seibum mi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"YAWEI ai garra sing langa yu,","poem":1},{"lineBreak":true},{"text":"dumaji yubin kain langa mi detmatj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}