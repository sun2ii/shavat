{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":130,"content":[{"type":"heading","content":["Preya blanga albumbat"]},{"type":"verse","number":1,"content":[{"text":"YAWEI, mi brabli nogudbinji en im jis laik mi jidanabat langa dakwan pleis.","poem":1},{"lineBreak":true},{"text":"Mi jinginatbat langa yu blanga album mi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"YAWEI, yu lisin langa mi wen mi jinginatbat langa yu blanga album mi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"YAWEI, if yu bina raidimdan ol melabat nogudbalawei,","poem":1},{"lineBreak":true},{"text":"ebribodi bina git panish en dai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bat yu nomo bin peiyimbek melabat blanga melabat nogudbalawei,","poem":1},{"lineBreak":true},{"text":"wulijim melabat gin shoum rispek langa yu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi weit garram opin hat blanga YAWEI blanga album mi,","poem":1},{"lineBreak":true},{"text":"en mi trastim langa im wed.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi weidabat blanga yu YAWEI garram opin hat brabliwei,","poem":1},{"lineBreak":true},{"text":"jis laik detlot men hu oldei wek wotjimbat olnait,","poem":1},{"lineBreak":true},{"text":"en weidabat blanga wotaim im garra ailibala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Trastim YAWEI ol yumob Isreil pipul.","poem":1},{"lineBreak":true},{"text":"Im kaan neba stap laigimbat yumob,","poem":1},{"lineBreak":true},{"text":"en im oldei redi blanga seibumbat yumob.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Oni im na garra seibum ol yumob Isreil pipul brom ol yumob nogudbalawei.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}