{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":138,"content":[{"type":"heading","content":["Song blanga gibit theingks"]},{"type":"heading","content":["Song blanga Deibid."]},{"type":"verse","number":1,"content":[{"text":"YAWEI, ai gibit theingks langa yu garram ol main hat.","poem":1},{"lineBreak":true},{"text":"Ai sing preis song langa yu lida langa ol detlot najalot drimin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ai weship en preisim yu.","poem":1},{"lineBreak":true},{"text":"Yu filing blanga laigim jidan olagijawan en yu jidan trubalawan.","poem":1},{"lineBreak":true},{"text":"Yu neim en yu wed jidan brabli haibala.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yubin ensim mi wen aibin jingat langa yu.","poem":1},{"lineBreak":true},{"text":"Garram yu pawa yubin meigim mi strongbala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"YAWEI, ola king langa dijan wel garra preisim yu,","poem":1},{"lineBreak":true},{"text":"dumaji deibin irrim ol yu pramis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Olabat garra sing song blanga wanim yubin dum,","poem":1},{"lineBreak":true},{"text":"en blanga yu haibalawanwei.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nomeda yu jidan deya langa top,","poem":1},{"lineBreak":true},{"text":"yu kain langa pipul hu jidan lobalawei,","poem":1},{"lineBreak":true},{"text":"en praudbala pipul kaan haidim miselp brom yu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wen detmatj trabul kaman langa mi,","poem":1},{"lineBreak":true},{"text":"yu kipum mi seifwan.","poem":1},{"lineBreak":true},{"text":"Yu seibum mi garram yu pawa brom ol main enami olabat wen dei wail langa mi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yu garra dum ebrijing yubin pramis.","poem":1},{"lineBreak":true},{"text":"YAWEI, yu filing blanga laigim mi jidan olagijawan.","poem":1},{"lineBreak":true},{"text":"Yu binijim det wek yubin olredi stat dumbat.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}