{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":14,"content":[{"type":"heading","content":["Det nogudwanwei blanga pipul14:0 Luk langa Saam 53."]},{"type":"heading","content":["Song blanga Deibid."]},{"type":"verse","number":1,"content":[{"text":"Siliwan pipul reken, “God nomo jidan!”","poem":1},{"lineBreak":true},{"text":"Olabat holot brabli nogudwan,","poem":1},{"lineBreak":true},{"text":"en olabat bin dumbat ola brabli nogud ting.","poem":1},{"lineBreak":true},{"text":"Nobodi iya dum enijing rait.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"YAWEI im lukdan brom hebin blanga luk if enibodi jidan raitwei,","poem":1},{"lineBreak":true},{"text":"en if enibodi weship im du.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bat deibin ol tenawei brom YAWEI, en holot na jidan nogudwan.","poem":1},{"lineBreak":true},{"text":"Nobodi dum rait ting enimo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"YAWEI im tok, “Maitbi dei nomo sabi.","poem":1},{"lineBreak":true},{"text":"Wotfo dei kaan len, dislot nogud pipul?","poem":1},{"lineBreak":true},{"text":"Olabat oldei deigimwei ebrijing brom main pipulmob.","poem":1},{"lineBreak":true},{"text":"Olabat nomo jingat langa mi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bat bambai God garra meigim olabat bradin brabliwei,","poem":1},{"lineBreak":true},{"text":"dumaji im jidan garram ol detlot pipul hu teiknodis langa im.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Detlot nogudbala pipul gibit adtaim langa ola powan pipul hu nomo garram enijing,","poem":1},{"lineBreak":true},{"text":"bat YAWEI im maindimbat olabat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mi prei adbalawei langa YAWEI weya im jidan langa Saiyan, blanga seibum ola pipul langa Isreil.","poem":1},{"lineBreak":true},{"text":"Olabat garra jidan gudbinji brabliwei wen YAWEI garra meigim olabat abum ebrijing igin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}