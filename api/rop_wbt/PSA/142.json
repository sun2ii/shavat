mi.","poem":1},{"lineBreak":true},{"text":"Nobodi nomo fil sori langa mi, najing!","poem":1},{"lineBreak":true},{"text":"En nomo eni seif pleis blanga go haidim miselp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi jingat langa yu, YAWEI.","poem":1},{"lineBreak":true},{"text":"Yu na det seifwan pleis blanga mi.","poem":1},{"lineBreak":true},{"text":"Ai wandim oni yu wanbala langa main laif.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"YAWEI, ensim main preya.","poem":1},{"lineBreak":true},{"text":"Ai kaan dum enijing mowa na!","poem":1},{"lineBreak":true},{"text":"YAWEI, seibum mi brom main enamimob!","poem":1},{"lineBreak":true},{"text":"Olabat tjeisimapbat mi en olabat brabli strongbala.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Deigimat mi brom dijan jeil wulijim ai gin preisim blanga yu neim.","poem":1},{"lineBreak":true},{"text":"Wen ola pipul blanga yu garra luk yubin brabli kain langa mi,","poem":1},{"lineBreak":true},{"text":"wal olabat garra majurrumap miselp raidaran langa mi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}