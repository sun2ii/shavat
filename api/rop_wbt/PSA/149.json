{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":149,"content":[{"type":"heading","content":["Dijan preis song"]},{"type":"verse","number":1,"content":[{"text":"Preisim YAWEI det trubala God!","poem":1},{"lineBreak":true},{"text":"Sing nyuwan song langa YAWEI garram ol im pipul hu jidan trubalawei.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ola Isreil pipul jidan gudbinji blanga yumob God hubin meigim ebrijing.","poem":1},{"lineBreak":true},{"text":"Sing song gudbinjiwei ola pipul brom Saiyan blanga yumob king.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dens blanga preisim im neim.","poem":1},{"lineBreak":true},{"text":"Plei ola dram en ola gita blanga preisim im.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"YAWEI im jidan gudbinji langa im pipul olabat.","poem":1},{"lineBreak":true},{"text":"Garram rispek im meigim ola lobalawan pipul win na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Larram ola pipul blanga God sing gudbinjiwei dumaji deibin win,","poem":1},{"lineBreak":true},{"text":"en larram olabat sing song gudbinjiwei olnait.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Preisim God! Jingat adbala langa im en holdim ola bigwan shapwan naif langa bingga redibala blanga bidim en panishim detlot pipul langa najalot kantri,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"en blanga taiyimap ola king en detlot lidamob garram tjein.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Olabat garra panishim detlot pipul langa najalot kantri jis laik weya God bin tok.","poem":1},{"lineBreak":true},{"text":"Lagijat na ola pipul blanga God garra win.","poem":1},{"lineBreak":true},{"text":"Preisim YAWEI det trubala God!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":8}