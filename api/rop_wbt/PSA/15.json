{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":15,"content":[{"type":"heading","content":["Wanim God wandim"]},{"type":"heading","content":["Song blanga Deibid."]},{"type":"verse","number":1,"content":[{"text":"YAWEI, hu gin kaman langa yu Serramoni Pleis?","poem":1},{"lineBreak":true},{"text":"Hu gin jidan langa yu seikridwan hil?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Oni detlot pipul hu oldei duwit langa God en dum wanim rait.","poem":1},{"lineBreak":true},{"text":"Olabat oldei toktokbat trubalawei.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dei nomo dalimbat laiya blanga najalot pipul.","poem":1},{"lineBreak":true},{"text":"Dei nomo dum nogudwan ting langa pipul.","poem":1},{"lineBreak":true},{"text":"Dei nomo tok nogudwan stori blanga olabat.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dei oldei shoum rispek langa detlot pipul hu teiknodis langa YAWEI.","poem":1},{"lineBreak":true},{"text":"Dei nomo shoum rispek langa detlot pipul hu gibit bekboun langa im.","poem":1},{"lineBreak":true},{"text":"Wen dei meigim pramis langa sambodi dei dum det ting,","poem":1},{"lineBreak":true},{"text":"nomeda det ting weya dei garra dum im adwan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dei nomo gibit mani langa po pipul en dalim olabat,","poem":1},{"lineBreak":true},{"text":"“Yu garra peiyimbek mi det mani en gibit mi mowa igin.”","poem":1},{"lineBreak":true},{"text":"En dei nomo gajim mani snikinwei blanga dalim laiya blanga album najalot pipul.","poem":1},{"lineBreak":true},{"text":"Detlot pipul hu oldei jidan gudwei lagijat,","poem":1},{"lineBreak":true},{"text":"detlot na garra jidan seifwan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}