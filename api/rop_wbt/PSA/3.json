{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":3,"content":[{"type":"heading","content":["Preya blanga ailibala"]},{"type":"heading","content":["Song blanga Deibid wen imbin ranawei brom im san Ebsalom."]},{"type":"verse","number":1,"content":[{"text":"YAWEI, ai garram loda enami.","poem":1},{"lineBreak":true},{"text":"Loda pipul bin gibit mi bekboun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Olabat tokabat mi nogudbalawei.","poem":1},{"lineBreak":true},{"text":"Olabat tok, “God kaan album im.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bat yu YAWEI, yu stapam ola nogudwan ting brom mi jis laiga shild.","poem":1},{"lineBreak":true},{"text":"Yu meigim mi jidan haibala.","poem":1},{"lineBreak":true},{"text":"Yu meigim mi strongbala igin,","poem":1},{"lineBreak":true},{"text":"wulijim ai kaan bradin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mi jingat langa YAWEI blanga album mi,","poem":1},{"lineBreak":true},{"text":"en im ensim mi brom det serramoni pleis blanga im,","poem":1},{"lineBreak":true},{"text":"ontop langa det seikridwan hil blanga im gulum Saiyan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi leidan en silip ol nait.","poem":1},{"lineBreak":true},{"text":"Mi gidap gudwei,","poem":1},{"lineBreak":true},{"text":"dumaji YAWEI lukaftumbat mi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nomeda loda enami majurrumap miselp raidaran langa mi,","poem":1},{"lineBreak":true},{"text":"bat stil ai kaan bradin,","poem":1},{"lineBreak":true},{"text":"dumaji YAWEI oldei maindimbat mi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“YAWEI, kaman kwikbala!","poem":1},{"lineBreak":true},{"text":"Kaman en seibum mi, main God!","poem":1},{"lineBreak":true},{"text":"Yu bidim main enami olabat,","poem":1},{"lineBreak":true},{"text":"en meigim olabat sheim.","poem":1},{"lineBreak":true},{"text":"Yu meigim olabat wikwan,","poem":1},{"lineBreak":true},{"text":"nomo garram pawa blanga ardim mi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"YAWEI, yu na tharran hu oldei seibum melabat.","poem":1},{"lineBreak":true},{"text":"Yu dumbat ola gudbala ting langa yu pipul olabat.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}