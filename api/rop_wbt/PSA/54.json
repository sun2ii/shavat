{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":54,"content":[{"type":"heading","content":["Preya blanga jidan seifwan"]},{"type":"heading","content":["Preya blanga Deibid wen sambala men brom Sif bin go langa Sol en bin dalim im Deibid bin blandimbat miselp langa olabat kantri.54:0 1 Sem 23:15-24; 26:1-5"]},{"type":"verse","number":1,"content":[{"text":"God, seibum mi garram yu pawa,","poem":1},{"lineBreak":true},{"text":"en garram yu pawa shoum pipul mi nomo rong.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"God, yu lisin langa main preya.","poem":1},{"lineBreak":true},{"text":"Yu lisin langa ol main wed.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ola praudbala pipul kaman blanga fait langa mi.","poem":1},{"lineBreak":true},{"text":"Ola krulbala pipul wandi kilim mi ded,","poem":1},{"lineBreak":true},{"text":"ol detlot na hu nomo jinggabat blanga God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bat God na oldei albumbat mi.","poem":1},{"lineBreak":true},{"text":"Main bos im oldei seibum mi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Larram God yusum olabat ron nogudbalawei blanga panishim main enami olabat.","poem":1},{"lineBreak":true},{"text":"Im garra binijimap olabat dumaji im trubalawan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"YAWEI, gudbinjiwei ai garra gibit yu sekrifais ofring.","poem":1},{"lineBreak":true},{"text":"Ai garra preisim yu neim dumaji yu gudwan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yubin seibum mi brom ol main trabul,","poem":1},{"lineBreak":true},{"text":"en aibin luk ol main enami olabat nomo bin win.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}