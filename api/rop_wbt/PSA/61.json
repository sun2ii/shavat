{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":61,"content":[{"type":"heading","content":["Preya langa God blanga jidan seifwan"]},{"type":"heading","content":["Preya blanga Deibid."]},{"type":"verse","number":1,"content":[{"text":"God, irrim mi wen mi kraikraibat.","poem":1},{"lineBreak":true},{"text":"Irrim main preya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi nogudbinji en mi jidan longwei brom main kemp. Mi jingat langa yu.","poem":1},{"lineBreak":true},{"text":"Meigim mi jidan seifwan,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"dumaji yu na oldei maindimbat mi.","poem":1},{"lineBreak":true},{"text":"Yu na brabli strongbala blanga seibum mi brom main enamimob jis laiga strongwan haus.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Larram mi jidan langa yu seikridwan haus olagijawan.","poem":1},{"lineBreak":true},{"text":"Larram mi jidan seifwan langa yu bingga wulijim beibiwan jukjuk weya im jidan seifwan andanith langa im mami wing.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"God, yubin irrim main pramis,","poem":1},{"lineBreak":true},{"text":"en yubin gibit mi wanim yubin gibit langa ol detlot pipul hu oldei rispek langa yu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yu larram det king jidan laibala longtaim,","poem":1},{"lineBreak":true},{"text":"en larram im bigininimob jidan king afta langa im.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"God, im garra oldei jidan bos,","poem":1},{"lineBreak":true},{"text":"en yu garra oldei lukaftumbat im garram yu trubalawan filing blanga laigimbat olagijawan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Blanga tharran na, ebridei ai garra oldei sing preis song langa yu wen ai gibit yu wanim aibin pramisim yu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}