t":"dumaji yu jadjim ola pipul raitwei en gibit olabat feyago,","poem":1},{"lineBreak":true},{"text":"en yu lidim ebri kantri langa dijan wel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ola pipul preisim God!","poem":1},{"lineBreak":true},{"text":"Larram ola pipul ebriweya preisim yu brabliwei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"God garra meigim dijan kantri jidan garram detmatj daga.","poem":1},{"lineBreak":true},{"text":"Det God blanga wi na garra gibit wi ebrijing.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"God garra brabli gudbala langa wi,","poem":1},{"lineBreak":true},{"text":"en ola pipul ebriweya garra gibit im rispek.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}