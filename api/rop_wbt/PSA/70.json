{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":70,"content":[{"type":"heading","content":["Dijan preya blanga albumbat"]},{"type":"heading","content":["Preya blanga Deibid."]},{"type":"verse","number":1,"content":[{"text":"Main God, seibum mi!","poem":1},{"lineBreak":true},{"text":"Kwikbala YAWEI, album mi tudei na!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Detlot hu trai blanga kilim mi,","poem":1},{"lineBreak":true},{"text":"nomo larram olabat win,","poem":1},{"lineBreak":true},{"text":"en yu meigim olabat grangran hed.","poem":1},{"lineBreak":true},{"text":"Stapam detlot hu jidan gudbinji langa ol main trabul,","poem":1},{"lineBreak":true},{"text":"en meigim olabat gobek garram sheim.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Detlot hu mokimbat mi,","poem":1},{"lineBreak":true},{"text":"meigim olabat nogudbinji en jidan sheimwei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ol detlot hu kaman langa yu,","poem":1},{"lineBreak":true},{"text":"larram olabat jidan gudbinjiwei.","poem":1},{"lineBreak":true},{"text":"Ol detlot pipul hu jidan gudbinji wen yubin seibum olabat,","poem":1},{"lineBreak":true},{"text":"larram olabat tok lagijat,","poem":1},{"lineBreak":true},{"text":"“God na im brabli haibalawan orait!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bat mi jidan wikwan nomo garram enijing.","poem":1},{"lineBreak":true},{"text":"Main God, kaman kwikbala langa mi!","poem":1},{"lineBreak":true},{"text":"Yu na YAWEI, main trubalawan God en yu na gin seibum mi.","poem":1},{"lineBreak":true},{"text":"Kaman kwikbala en album mi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}