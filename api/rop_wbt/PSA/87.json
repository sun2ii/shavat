{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":87,"content":[{"type":"heading","content":["Preisim Jerusalem det taun blanga God"]},{"type":"heading","content":["Song blanga det femili blanga Kora."]},{"type":"verse","number":1,"content":[{"text":"YAWEI bin meigim det taun deya ontop langa det seikridwan hil.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Im laigim Jerusalem brabliwei, mowa den eni pleis langa Isreil.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pipul blanga det taun blanga God, irrimbat ola gudwan ting weya God im tok blanga yu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God bin tok, “Ai garra raidimdan ola neim blanga dislot kantri weya pipul teiknodis langa mi. Olabat brom Ijip en Bebalon, Filistiya, Taya en Ithiyopiya en olabat tok deibin bon langa Jerusalem.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God, det Brabli Boswan, garra meigim Jerusalem jidan strongbala,","poem":1},{"lineBreak":true},{"text":"en ola pipul ebriweya garra tok, “Melabat bin bon deya du.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"YAWEI garra raidimdan neim blanga ola pipul,","poem":1},{"lineBreak":true},{"text":"en im garra tok blanga olabat, “Dijan bin bon iya langa Jerusalem.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dei garra dens en sing,","poem":1},{"lineBreak":true},{"text":"“Ola gudbala ting kaman brom Jerusalem.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}