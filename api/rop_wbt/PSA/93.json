{"translation":{"id":"rop_wbt","name":"Holi Baibul","website":"https://ebible.org/Scriptures/details.php?id=rop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rop","licenseNotes":null,"shortName":"WBT","englishName":"Kriol Bible","language":"rop","textDirection":"ltr","sha256":"5bcb3157050b0a7f309f1b2486481e8d05fd058b12b172a0c4d3500b61c9ad3e","availableFormats":["json"],"listOfBooksApiLink":"/api/rop_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29308,"languageName":"Kriol","languageEnglishName":"Kriol"},"book":{"id":"PSA","translationId":"rop_wbt","name":"Ola Saam","commonName":"Ola Saam","title":"Ola Saam Ola Song En Preya Langa God","order":19,"numberOfChapters":150,"sha256":"f54cec1c0c386b58c782f05b34d2d166ee5202b8c52eee28209c3555e4b0ba86","firstChapterNumber":1,"firstChapterApiLink":"/api/rop_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rop_wbt/PSA/150.json","totalNumberOfVerses":2440},"chapter":{"number":93,"content":[{"type":"heading","content":["God det Boswan"]},{"type":"verse","number":1,"content":[{"text":"YAWEI det trubala God im Boswan.","poem":1},{"lineBreak":true},{"text":"Im jidan brabli haibalawan en brabli strongwan.","poem":1},{"lineBreak":true},{"text":"Dijan wel im jidan langa im rait pleis en nomo enijing kaan mubum im.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"YAWEI, yubin oldei jidan boswan bifo enijing bin jidan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"YAWEI, det solwoda jinginat adbalawei jis laik thanda.","poem":1},{"lineBreak":true},{"text":"Im jinginat nomo lilbit.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"YAWEI, im jidan langa hebin en im na det Brabli Haibalawan Bos blanga ebrijing.","poem":1},{"lineBreak":true},{"text":"Im mowa strongbala langa det solwoda weya im jingat,","poem":1},{"lineBreak":true},{"text":"en im mowa strongbala langa ola bigwan weib langa solwoda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"YAWEI, ola lowa blanga yu jidan olagijawan,","poem":1},{"lineBreak":true},{"text":"en yu Serramoni Pleis im jidan brabli seikridwan olagijawan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rop_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rop_wbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rop_wbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}