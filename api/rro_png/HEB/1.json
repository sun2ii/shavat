{"translation":{"id":"rro_png","name":"'Abi'uai Apa'uana Mahamahana","website":"https://ebible.org/Scriptures/details.php?id=rro","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rro","licenseNotes":null,"shortName":"PNG","englishName":"Waima NT","language":"rro","textDirection":"ltr","sha256":"c3518a4d1e9f1e5bbc14f5f24a45304f85c1f0c390785f3f7ed93c391fe6a252","availableFormats":["json"],"listOfBooksApiLink":"/api/rro_png/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7955,"languageName":"Waima","languageEnglishName":"Waima"},"book":{"id":"HEB","translationId":"rro_png","name":"Heberu","commonName":"Heberu","title":"Marere HEBERU Haukia Herekiai","order":58,"numberOfChapters":13,"sha256":"a0d2605ebf0a3e18b3252e0da5a5bce4d7c3a8ce7c3be9633e7e832f02f6b47b","firstChapterNumber":1,"firstChapterApiLink":"/api/rro_png/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/rro_png/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Tirama Ena 'Abi Nahuna Pinanai Ehina benaka."]},{"type":"verse","number":1,"content":["Wa'i baha raninai Tirama ehore mahabanai haukia pinakiai rani bo'ona taeara haeaihaeai ai 'aba'abaka herekiai ehina benakia."]},{"type":"verse","number":2,"content":["Ia bariu rani neiakia puakiai hanona Nahuna pinanai aika ehina benaka. Tirama ehore Nahuna imanai kupa mai hanopaka ebabainakia, ia ehore Nahuna etina'ana taba ikoikiai ebena ia 'euna."]},{"type":"verse","number":3,"content":["Nahuna neiana hanona ne'imare Tirama nuabina nibawaira tinana, ia hanona Tirama ihobona tohana, ia ena 'abi hiabunai taba ikoikiai ne'imanakia. Ia maearima ekia ki'a eutu obonakia murinai kupa 'ubinai hiabu ikoinai Tiramana itipana taina imariki aina 'ekanai emiati nemiaho."]},{"type":"heading","content":["Tirama Nahuna Hanona Aneru Etara Haonakia."]},{"type":"verse","number":4,"content":["Ia hanona aneru etara haonakia pokina Tirama ia atana ebena hauna hanona aneru atakia etara haonakia."]},{"type":"verse","number":5,"content":["Tirama ehore ia ehina bena,",{"text":"“Oi hanona au Naha'u.","poem":1},{"lineBreak":true},{"text":"Bariu beraura neianai","poem":1},{"lineBreak":true},{"text":"Au oi abaramani'o,”","poem":1},"Sal 2.7 ia aneru ha herenai ua a'i e'abi aiho. Ia haeamona e'abi,",{"text":"“Au hanona ia Hamanai kaeao,","poem":1},{"lineBreak":true},{"text":"ia abomo au Naha'u ai keao.”","poem":1},"2 Sam 7.14"]},{"type":"verse","number":6,"content":["Haeamona Nahuna apa'uana euhuna hanopakai emai raninai e'abi etibaha,",{"text":"“Tirama ena aneru ikoikiai","poem":1},{"lineBreak":true},{"text":"hanona ia temekuti aina.”","poem":1},"Deu 32.43"]},{"type":"verse","number":7,"content":["Aneru robakia eahuna etibaha,",{"text":"“Tirama ehore ena aneru","poem":1},{"lineBreak":true},{"text":"hanona baurai ebaonakia,","poem":1},{"lineBreak":true},{"text":"ena aneru baika ta'ara'ina tia'i","poem":1},{"lineBreak":true},{"text":"haukia hanona iruba upakiai","poem":1},{"lineBreak":true},{"text":"ebaonakia.”","poem":1},"Sal 104.4"]},{"type":"verse","number":8,"content":["Ia Nahuna robana eahuna etibaha,",{"text":"“Oi hanona Tirama, emu obia","poem":1},{"lineBreak":true},{"text":"imia'auna kemiaho banaibanai,","poem":1},{"lineBreak":true},{"text":"oi hanona bero ai emu aiara","poem":1},{"lineBreak":true},{"text":"nupoki aina.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aka bero onuatae aina,","poem":1},{"lineBreak":true},{"text":"babai ki'a hanona o'oatana.","poem":1},{"lineBreak":true},{"text":"Ua buonai Tirama emu Tirama","poem":1},{"lineBreak":true},{"text":"ehore aonamo tehoronai","poem":1},{"lineBreak":true},{"text":"eheini'o emu obia hoana,","poem":1},{"lineBreak":true},{"text":"atamu ebapa'uana","poem":1},{"lineBreak":true},{"text":"'abamu wairakiai.”","poem":1},"Sal 45.6, 7"]},{"type":"verse","number":10,"content":["Haeamona etibaha,",{"text":"“Obiapaka e,","poem":1},{"lineBreak":true},{"text":"popouna 'akinai hanopaka","poem":1},{"lineBreak":true},{"text":"hanona oi obabaina,","poem":1},{"lineBreak":true},{"text":"kupa abomo oi imamuai obabaina.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kupa mai hanopaka","poem":1},{"lineBreak":true},{"text":"hanona kate'akauma,","poem":1},{"lineBreak":true},{"text":"iamo oi hanona komiaho","poem":1},{"lineBreak":true},{"text":"banaibanai,","poem":1},{"lineBreak":true},{"text":"ia taba ikoikiai kateburuburu","poem":1},{"lineBreak":true},{"text":"habuni 'ai'aina 'abana.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kupa mai hanopaka kounakia","poem":1},{"lineBreak":true},{"text":"habuni iro'abu 'abana,","poem":1},{"lineBreak":true},{"text":"weiakia ihakia katehaeai","poem":1},{"lineBreak":true},{"text":"habuni ni'ai'ai 'abana.","poem":1},{"lineBreak":true},{"text":"Ia oi hanona 'ekamuai mo,","poem":1},{"lineBreak":true},{"text":"emu mauri ihaukia hanona","poem":1},{"lineBreak":true},{"text":"a'i kepua.”","poem":1},"Sal 102.25-27"]},{"type":"verse","number":13,"content":["Rani ha Tirama aneru ha ṉa a'i ehinabe aihona a'i etibaha,",{"text":"“Itipa'u tainai momiati","poem":1},{"lineBreak":true},{"text":"keaomo oi i'oatamu haukia","poem":1},{"lineBreak":true},{"text":"'apumu ba'anai kahorotinakia.”","poem":1},"Sal 110.1"]},{"type":"verse","number":14,"content":["Aneru hanona taba? Ia ikoikiai hanona auba, Tirama ta'arana tia'i haukia, euhunakia bamauri katea'ina haukia katebarainakia."]}],"footnotes":[]},"thisChapterLink":"/api/rro_png/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rro_png/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rro_png/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}