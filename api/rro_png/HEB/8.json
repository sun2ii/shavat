{"translation":{"id":"rro_png","name":"'Abi'uai Apa'uana Mahamahana","website":"https://ebible.org/Scriptures/details.php?id=rro","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rro","licenseNotes":null,"shortName":"PNG","englishName":"Waima NT","language":"rro","textDirection":"ltr","sha256":"c3518a4d1e9f1e5bbc14f5f24a45304f85c1f0c390785f3f7ed93c391fe6a252","availableFormats":["json"],"listOfBooksApiLink":"/api/rro_png/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7955,"languageName":"Waima","languageEnglishName":"Waima"},"book":{"id":"HEB","translationId":"rro_png","name":"Heberu","commonName":"Heberu","title":"Marere HEBERU Haukia Herekiai","order":58,"numberOfChapters":13,"sha256":"a0d2605ebf0a3e18b3252e0da5a5bce4d7c3a8ce7c3be9633e7e832f02f6b47b","firstChapterNumber":1,"firstChapterApiLink":"/api/rro_png/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/rro_png/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["Iesu Hanona Eka Robe Hauna Apa'uana Kupai."]},{"type":"verse","number":1,"content":["Au robana ahuna 'abikia pokikia hanona neiana, aika hanona robe hauna apa'uana ṉahomana hauna nemiaho herekai. Ia kupa 'ubinai hiabu Tiramana ena imia'au itipana taina imarikiaina 'ekanai aba emiati."]},{"type":"verse","number":2,"content":["Ia 'eka robena tohanai robe hauna apa'uana ena aka nibabaina, paraboa",{"noteId":1},"tohana weiana hanona Obiapaka Tirama ehore ebakorina ia maearima a'i tebakorina."]},{"type":"verse","number":3,"content":["Robe haukia apa'uakia ikoikiai tea'i taeanakia beruberu tabakia katebaibeni mai ki'a ia'iobokia tabakia katebaibeni Tirama herenai, ua buonai eka robe hauna apa'uana neiana abomo taba ha kebaibeni."]},{"type":"verse","number":4,"content":["Iesu hanopakai pemiaho raninai robe haunai a'i peao, pokina robe haukia temiaho ia tehore beruberu tabakia tebaibeni Mose ena rauhubu ihobonai."]},{"type":"verse","number":5,"content":["Robe haukia ekia aka hanona kupa ai tibabaina akana ihobo ihobona mai aubaubana 'abana, aka weiana hanona ihobona Tirama Mose ehinabe pahihina paraboa robena ebakorina 'abana etibaha, “Ko'ima haraina taba ikoikiai kobabai oeo ai abaihani'o tabakia ihaihakia ihobo ihobokia.”"]},{"type":"verse","number":6,"content":["Ia bariu Iesu robe akana ea'ina hanona robe haukia ekia aka etara haonakia, pokina ia 'abi'uai apa'uana weianai bairarao haunai eao, 'abi'uai apa'uana neiana hanona ma enamo ba 'abi'uai apa'uana 'ai'aina, pokina weiana hanona 'abi'uai namokia 'akikia ahakiai ebakorina."]},{"type":"heading","content":["'Abi'uai Apa'uana Mahamahana Hanona 'Ai'aina Etara Haona."]},{"type":"verse","number":7,"content":["'Abi'uai apa'uana kori'uaina maikoinai enamo raninai, ibaruana a'i pahanuatae aina."]},{"type":"verse","number":8,"content":["Ia Tirama ena maearima herekiai beho eihana buonai ehinanakia etibaha,",{"text":"“Au, Obiapaka Tirama, na'abi,","poem":1},{"lineBreak":true},{"text":"Beraura aba nimai 'abi'uai","poem":1},{"lineBreak":true},{"text":"apa'uana mahamahana kababaina","poem":1},{"lineBreak":true},{"text":"Isaraela haukia herekiai","poem":1},{"lineBreak":true},{"text":"abomo Iuda itubuna aonai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Au, Obiapaka Tirama, na'abi,","poem":1},{"lineBreak":true},{"text":"'Abi'uai apa'uana neiana","poem":1},{"lineBreak":true},{"text":"hanona 'aba'abakia imakiai","poem":1},{"lineBreak":true},{"text":"a'ina Aikupito hanonai","poem":1},{"lineBreak":true},{"text":"abakarahinakia raninai","poem":1},{"lineBreak":true},{"text":"a'abi'uai hauna 'abana aha'i.","poem":1},{"lineBreak":true},{"text":"Ia e'u 'abi'uai apa'uana","poem":1},{"lineBreak":true},{"text":"a'i teka'aina buonai","poem":1},{"lineBreak":true},{"text":"au abomo aiakia a'i aona.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Au, Obiapaka Tirama,","poem":1},{"lineBreak":true},{"text":"haeamona na'abi,","poem":1},{"lineBreak":true},{"text":"Weiana murinai 'abi'uai apa'uana","poem":1},{"lineBreak":true},{"text":"ha kababaina Isaraela haukia","poem":1},{"lineBreak":true},{"text":"herekiai hanona neiana.","poem":1},{"lineBreak":true},{"text":"Au e'u rauhubu ia aokiai","poem":1},{"lineBreak":true},{"text":"kahorotina mai ahekiai karerena.","poem":1},{"lineBreak":true},{"text":"Au hanona ekia Tirama ai kaeao,","poem":1},{"lineBreak":true},{"text":"ia hanona au e'u maearima ai","poem":1},{"lineBreak":true},{"text":"kateao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hau ha uaho'abana 'ao","poem":1},{"lineBreak":true},{"text":"herenai hauna a'i kehina bena","poem":1},{"lineBreak":true},{"text":"‘Obiapaka ko'iobina’.","poem":1},{"lineBreak":true},{"text":"Pokina ikoikiai hanona","poem":1},{"lineBreak":true},{"text":"aba kate'iobina'u","poem":1},{"lineBreak":true},{"text":"papana 'akiai eaomo","poem":1},{"lineBreak":true},{"text":"apa'uanai epua.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ekia beho akakia aokiai","poem":1},{"lineBreak":true},{"text":"kaoko'o ainakia","poem":1},{"lineBreak":true},{"text":"abomo ekia ki'a","poem":1},{"lineBreak":true},{"text":"a'i karaona 'ininakia.”","poem":1},"Ier 31.31-34"]},{"type":"verse","number":13,"content":["Tirama 'abi'uai apa'uana mahamahana e'uahina raninai weiana kori'uaina hanona aba 'ai'ainai ebaona, ba taba ni'ai'ai mai nimara hauna hanona aba ke'akauma."]}],"footnotes":[{"noteId":1,"caller":"+","text":"(2) i'aua robena","reference":{"chapter":8,"verse":2}}]},"thisChapterLink":"/api/rro_png/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rro_png/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rro_png/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}