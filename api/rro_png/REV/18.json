{"translation":{"id":"rro_png","name":"'Abi'uai Apa'uana Mahamahana","website":"https://ebible.org/Scriptures/details.php?id=rro","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rro","licenseNotes":null,"shortName":"PNG","englishName":"Waima NT","language":"rro","textDirection":"ltr","sha256":"c3518a4d1e9f1e5bbc14f5f24a45304f85c1f0c390785f3f7ed93c391fe6a252","availableFormats":["json"],"listOfBooksApiLink":"/api/rro_png/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7955,"languageName":"Waima","languageEnglishName":"Waima"},"book":{"id":"REV","translationId":"rro_png","name":"Ibawaira Tinana","commonName":"Ibawaira Tinana","title":"Keriso Ena 'Abi IBAWAIRA TINANA Ioane Herenai","order":66,"numberOfChapters":22,"sha256":"331a082c9a66f655cbd65f5292e2fbd5159e3853f0ac8a6bed6af9600a96c79e","firstChapterNumber":1,"firstChapterApiLink":"/api/rro_png/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/rro_png/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":18,"content":[{"type":"heading","content":["Babulonia Aiara Apa'uana Aba E'eho."]},{"type":"verse","number":1,"content":["Neiakia murikiai aneru haeai ha aihana kupai eriri emai. Ia ena hiabu hanona eapa'ua ki'a baha weiana ena nuabi ehore hanopaka maikoinai ebaea obona."]},{"type":"verse","number":2,"content":["Aiana taburanai eio aota etibaha,",{"text":"“Babulonia aiarana apa'uana","poem":1},{"lineBreak":true},{"text":"aba e'eho, aba e'eho!","poem":1},{"lineBreak":true},{"text":"Ia hanona tiaporo mai","poem":1},{"lineBreak":true},{"text":"auba ki'a obokia","poem":1},{"noteId":2},{"text":"ikoikiai ekia","poem":1},{"lineBreak":true},{"text":"kaimue 'ekanai eao,","poem":1},{"lineBreak":true},{"text":"roborobo 'opukia mai","poem":1},{"lineBreak":true},{"text":"'arikia a'i ti'ari haukia","poem":1},{"lineBreak":true},{"text":"ekia paparo'ai eao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pokina hanopaka maearimakia","poem":1},{"lineBreak":true},{"text":"ikoikiai ia kipokia nabau","poem":1},{"lineBreak":true},{"text":"hoahoakia ki'a obokia tebabai","poem":1},{"lineBreak":true},{"text":"matoha ena bia pahihinai","poem":1},{"lineBreak":true},{"text":"teinu 'ari 'abana.","poem":1},{"lineBreak":true},{"text":"Hanopaka ena obia 'arana haukia","poem":1},{"lineBreak":true},{"text":"abomo ia kipokia aba tenabau,","poem":1},{"lineBreak":true},{"text":"haeamona hanopaka ena","poem":1},{"lineBreak":true},{"text":"kawakawa haukia hanona","poem":1},{"lineBreak":true},{"text":"enuatae ki'a tabakia","poem":1},{"lineBreak":true},{"text":"weiakia arakia rarikiai","poem":1},{"lineBreak":true},{"text":"ekia obia aba tebapa'uanakia.”","poem":1}]},{"type":"verse","number":4,"content":["Ba aia haeai ha aona etibaha,",{"text":"“E'u maearima e,","poem":1},{"lineBreak":true},{"text":"aiara naiana aonai","poem":1},{"lineBreak":true},{"text":"tomokarahi tomai.","poem":1},{"lineBreak":true},{"text":"Ia kipokia ki'a akakia","poem":1},{"lineBreak":true},{"text":"a'i tomobabai haeamo marikina.","poem":1},{"lineBreak":true},{"text":"Ia kipokia ia'iki'ana pumana","poem":1},{"lineBreak":true},{"text":"a'i tomohoai haeamona marikina.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pokina ena ki'a hanona","poem":1},{"lineBreak":true},{"text":"aba ero'ana eaomo kupa,","poem":1},{"lineBreak":true},{"text":"mai Tirama hanona ia ena babai","poem":1},{"lineBreak":true},{"text":"ki'a ikoikiai niraona 'ininakia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ena baibeni ihobonai","poem":1},{"lineBreak":true},{"text":"katobeni muena.","poem":1},{"lineBreak":true},{"text":"Taba ebabaina hauna 'arana","poem":1},{"lineBreak":true},{"text":"rani rua katohorena.","poem":1},{"lineBreak":true},{"text":"Emi 'ere aokiai muramura","poem":1},{"lineBreak":true},{"text":"pahihina eba'oruna","poem":1},{"lineBreak":true},{"text":"katoinu ihobonai,","poem":1},{"lineBreak":true},{"text":"ia ena 'ere aonai","poem":1},{"lineBreak":true},{"text":"muramura pahihina katoba'oruna","poem":1},{"lineBreak":true},{"text":"hanona ena tabura katoba","poem":1},{"lineBreak":true},{"text":"kabanaina rani rua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ia kipona taba weiakia","poem":1},{"lineBreak":true},{"text":"'arakia rarikia enuatae ki'a","poem":1},{"lineBreak":true},{"text":"mai ena nuabi ebena ihobokiai mo","poem":1},{"lineBreak":true},{"text":"katobahaiarana mai katobahaina.","poem":1},{"lineBreak":true},{"text":"Pokina kipona aonai","poem":1},{"lineBreak":true},{"text":"niapa netibaha,","poem":1},{"lineBreak":true},{"text":"‘Au hanona obia 'arakia","poem":1},{"lineBreak":true},{"text":"babi'e'u mo ha ṉamiati,","poem":1},{"lineBreak":true},{"text":"au hanona wapu aha'i,","poem":1},{"lineBreak":true},{"text":"mai au hanona a'i kahai 'apua.’","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ua buonai wapu hamona aonai","poem":1},{"lineBreak":true},{"text":"ia ia'iki'ana akakia ikoikiai","poem":1},{"lineBreak":true},{"text":"ketabu ahinakia,","poem":1},{"lineBreak":true},{"text":"'ari, hai mai arobo.","poem":1},{"lineBreak":true},{"text":"Haeamona ia hanona iruba aonai","poem":1},{"lineBreak":true},{"text":"ke'ara obo.","poem":1},{"lineBreak":true},{"text":"Pokina Obiapaka Tirama","poem":1},{"lineBreak":true},{"text":"ia nibabakaina hauna hanona","poem":1},{"lineBreak":true},{"text":"etabura ki'a baha.","poem":1}]},{"type":"verse","number":9,"content":["“Hanopaka ena obia 'arana haukia ia kipokia tenabau mai ena kepu teaonamoai haeamo haukia hanona iruba weiana hiabuna nikara'au kateihana raninai katehai 'ari ki'a baha."]},{"type":"verse","number":10,"content":["Ena hau haiara paunai, kateta'u ki'a atau'ai katekoroti katehai kate'abi,",{"text":"‘Eki'a ki'a baha,","poem":1},{"lineBreak":true},{"text":"eki'a ki'a baha.","poem":1},{"lineBreak":true},{"text":"Babulonia aiara apa'uana","poem":1},{"lineBreak":true},{"text":"mai taburana e,","poem":1},{"lineBreak":true},{"text":"beraura hoana hamona 'akimo","poem":1},{"lineBreak":true},{"text":"aonai puma ohoaina.’","poem":1}]},{"type":"verse","number":11,"content":["“Hanopaka ena kawakawa haukia abomo katehai 'ari ki'a baha, pokina ekia kawakawa tabakia hanona hau ha a'i kekawanakia."]},{"type":"verse","number":12,"content":["Kawakawa tabakia weiakia hanona gold mai silba, pihara namoabukia mai kutu 'imare'imarekia, habuni namoabukia, habuni apupukia, habuni nibinibikia ta'eta'ekia, habuni birokia, matiu timikia namokia haeaihaeai, mahi atana elepant 'eanai tebabai tabakia ikoikiai, matiu 'arakia rarikia haukia, kopa, auri mai pihara pahihina namonai tebabainakia tabakia,"]},{"type":"verse","number":13,"content":["weiakia aniani timikia ibanamokia muramurakia atakia sinemon mai spaisi, muramura timikia 'orimokia atakia insense mai mira, mai muramura taburana hauani katetarona hauna, waini mai olibe hohona, parawa namokia, witi, poromakau mai mamoe, hoti, mai kariota, ta'ara'i haukia, mai maearima ekia mauri."]},{"type":"verse","number":14,"content":["Taba tikawakawai haukia weiakia katehina bena katetibaha,",{"text":"‘Babulonia e,","poem":1},{"lineBreak":true},{"text":"taba namokia onuatae ainakia","poem":1},{"lineBreak":true},{"text":"haukia te'akauma,","poem":1},{"lineBreak":true},{"text":"mai emu obia tabakia mai","poem":1},{"lineBreak":true},{"text":"emu nuabi tabakia ikoikiai","poem":1},{"lineBreak":true},{"text":"hanona aba te'akauma,","poem":1},{"lineBreak":true},{"text":"ba a'i kotabu ahi muenakia.’","poem":1}]},{"type":"verse","number":15,"content":["“Kawakawa haukia taba weiakia ia herenai tekawa kawainakia ba monikiai teobia haukia atau'a 'akinai katekoroti, kateta'u haiara weiana ki'a obona paunai katehai 'ari ki'a baha."]},{"type":"verse","number":16,"content":["Kate'abi katetibaha,",{"text":"‘Eki'a ki'a baha,","poem":1},{"lineBreak":true},{"text":"aiara apa'uana herena","poem":1},{"lineBreak":true},{"text":"eki'a ki'a baha.","poem":1},{"lineBreak":true},{"text":"Habuni namoabukia,","poem":1},{"lineBreak":true},{"text":"apupukia, mai birokia","poem":1},{"lineBreak":true},{"text":"obatotonakia, gold,","poem":1},{"lineBreak":true},{"text":"pihara namoabukia 'imarekia,","poem":1},{"lineBreak":true},{"text":"mai kutu 'imarekiai otaitai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Beraura hoana hamona aonai","poem":1},{"lineBreak":true},{"text":"emu obia tabakia neiakia","poem":1},{"lineBreak":true},{"text":"ikoikiai hanona aba tepururu.’","poem":1},"“Aunohi kapena haukia ikoikiai mai tehe'au tiharima haukia ikoikiai, aunohi ai tiaka haukia ikoikiai mai ekia mauri 'akuai tikaoao aina haukia ikoikiai atau'ai katekoroti."]},{"type":"verse","number":18,"content":["Ia ni'ara hiabuna nikara'au kateihana raninai kateio katetibaha,",{"text":"‘Aiara tabana hanona","poem":1},{"lineBreak":true},{"text":"aiara apa'uana neiana 'abana?’","poem":1}]},{"type":"verse","number":19,"content":["Arakiai apuroro katehore 'aunakia katehai 'ari ki'a baha katetibaha,",{"text":"‘Eki'a ki'a baha,","poem":1},{"lineBreak":true},{"text":"aiara apa'uana herenai","poem":1},{"lineBreak":true},{"text":"eki'a ki'a baha,","poem":1},{"lineBreak":true},{"text":"mai ekia aunohi 'aku kapenai","poem":1},{"lineBreak":true},{"text":"haukia ikoikiai oi emu","poem":1},{"lineBreak":true},{"text":"obia tabakiai kepu haukiai teao,","poem":1},{"lineBreak":true},{"text":"'a beraura hoana hamona 'akimo","poem":1},{"lineBreak":true},{"text":"aonai oi aba opururu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tomoaonamo.","poem":1},{"lineBreak":true},{"text":"Kupa, mai Tirama ena robe haumi,","poem":1},{"lineBreak":true},{"text":"mai iuhubeau haumi,","poem":1},{"lineBreak":true},{"text":"mai mahabanai haumi e,","poem":1},{"lineBreak":true},{"text":"tomoaonamo ki'a baha,","poem":1},{"lineBreak":true},{"text":"Tirama ehore ia puma ebahoaina","poem":1},{"lineBreak":true},{"text":"pokina ia wai heremiai","poem":1},{"lineBreak":true},{"text":"ebabai ki'a paunai.’”","poem":1}]},{"type":"verse","number":21,"content":["Ba aneru taburana ha ehore iata rarina 'akina ha ea'i taeana 'aku aonai ekapo uhuna ba e'abi etibaha,",{"text":"“Taeara neiana ihobonai","poem":1},{"lineBreak":true},{"text":"Babulonia aiara apa'uana","poem":1},{"lineBreak":true},{"text":"'aku aonai katekapo uhuna,","poem":1},{"lineBreak":true},{"text":"ba a'i kateiha muena.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kita atana hap tipapura aina","poem":1},{"lineBreak":true},{"text":"haukia ekia 'uru namokia,","poem":1},{"lineBreak":true},{"text":"mai hui a'itaea haukia,","poem":1},{"lineBreak":true},{"text":"marori mai pihi ubai haukia","poem":1},{"lineBreak":true},{"text":"'urukia namokia oi aomuai","poem":1},{"lineBreak":true},{"text":"a'i kateo muena.","poem":1},{"lineBreak":true},{"text":"Oi aomuai aka haeai haeai","poem":1},{"lineBreak":true},{"text":"tibabai haukia ha","poem":1},{"lineBreak":true},{"text":"a'i katetabu ahi muena.","poem":1},{"lineBreak":true},{"text":"Oi aomuai tona tiorina 'uruna","poem":1},{"lineBreak":true},{"text":"a'i kateo muena.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ramepa eana ha oi aomuai","poem":1},{"lineBreak":true},{"text":"a'i ke'ara mue.","poem":1},{"lineBreak":true},{"text":"Hawainibe mahamaha hauna","poem":1},{"lineBreak":true},{"text":"mai babi'ena aiakia oi aomuai","poem":1},{"lineBreak":true},{"text":"a'i kateo'o muenakia.","poem":1},{"lineBreak":true},{"text":"Neiakia katerama pokina","poem":1},{"lineBreak":true},{"text":"emu kawakawa haukia hanona","poem":1},{"lineBreak":true},{"text":"hanopaka ena maearima","poem":1},{"lineBreak":true},{"text":"apa'uakiai teao,","poem":1},{"lineBreak":true},{"text":"oi emu nepuai hanona","poem":1},{"lineBreak":true},{"text":"hanopaka maearimakia","poem":1},{"lineBreak":true},{"text":"o'oi ahinakia.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Babulonia aiara apa'uana","poem":1},{"lineBreak":true},{"text":"hanona puma ehoaina","poem":1},{"lineBreak":true},{"text":"pokina ia aonai mahabanai haukia","poem":1},{"lineBreak":true},{"text":"mai Tirama ena robe haukia","poem":1},{"lineBreak":true},{"text":"aruarukia tetabu ahinakia,","poem":1},{"lineBreak":true},{"text":"mai hanopaka ahanai","poem":1},{"lineBreak":true},{"text":"teahu 'arinakia haukia","poem":1},{"lineBreak":true},{"text":"ikoikia aruarukia.”","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"(2) 'ao 'opukia","reference":{"chapter":18,"verse":2}}]},"thisChapterLink":"/api/rro_png/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rro_png/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rro_png/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}