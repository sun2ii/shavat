{"translation":{"id":"ruf_pbt","name":"Laghano Lya Sambi Kwe Iwanu Wose","website":"https://ebible.org/Scriptures/details.php?id=ruf","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ruf","licenseNotes":null,"shortName":"PBT","englishName":"Luguru NT","language":"ruf","textDirection":"ltr","sha256":"5d1ee993023c0215231fa1146bdeea377353736a092f989a1823dbf959b09437","availableFormats":["json"],"listOfBooksApiLink":"/api/ruf_pbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7957,"languageName":"Luguru","languageEnglishName":"Luguru"},"book":{"id":"HEB","translationId":"ruf_pbt","name":"Waebulaniya","commonName":"Waebulaniya","title":"Ibaluwa kwa Waebulaniya","order":58,"numberOfChapters":13,"sha256":"0ebbe2f499d09513ab175a9d58009e50572ffa9a9136b2f425e5689bf7614246","firstChapterNumber":1,"firstChapterApiLink":"/api/ruf_pbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/ruf_pbt/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Imbuli ye Imulungu kubitila Imwanaghe"]},{"type":"verse","number":1,"content":["Aho ghumwande Imulungu tsakalonga na aba tsetu mala nyingi na kwa nzila nyingi kubitila manabii wake,"]},{"type":"verse","number":2,"content":["lekeni mne ghamatsuwa ghano gha ukutsigha kalonga na twetwe kubitila Imwanaghe, iyamsaghule na yamwing'ile pfinu pfose pfiwe pfake, kuya kubitila yeye Imulungu tsakalumba isi yose."]},{"type":"verse","number":3,"content":["Yeye katumwemwesela utunitso we Imulungu, na keghala ghendo ne Imulungu imwenyegho pfayali. Kaikindilisa isi yose ighendelele kuwa baho kwa mbuli yake ine ingupfu. Hamalitse sang'ano ya kuwatenda iwanu wele kulawa mne nzambi tsawo, kakala kulanga ubali wa ghumoko ghwe kujilo ghwe Imulungu."]},{"type":"heading","content":["Imwana we Imulungu mkulu kubita wamalaika"]},{"type":"verse","number":4,"content":["Imwana katendighwa mkulu kubita wamalaika, ka taghwa lyeng'ighwe ne Imulungu pfalili kulu kubita taghwa lyawo."]},{"type":"verse","number":5,"content":["Mana Imulungu ng'amlongele ghendo malaika wowose,",{"text":"“Ghweghwe kwa Imwanangu","poem":1},{"lineBreak":true},{"text":"leloli nolonga nene niwa Aba wako.”","poem":1},"Wala ng'alongile ghendo kwa malaika.",{"text":"“Nitsakuwa Aba wake,","poem":1},{"lineBreak":true},{"text":"naye katsakuwa Mwanangu.”","poem":1}]},{"type":"verse","number":6,"content":["Lekeni Imulungu hayomghala chaudele wake muisi, kolonga,",{"text":"“Wamalaika wose we Imulungu wamtamanile”","poem":1}]},{"type":"verse","number":7,"content":["Lekeni kuna wamalaika Imulungu kalonga,",{"text":"“Imulungu kawatenda libeho","poem":1},{"lineBreak":true},{"text":"wamalaika wake","poem":1},{"lineBreak":true},{"text":"na iwatumwa wake kawatenda kuwa imilambi ye ghumoto.”","poem":1}]},{"type":"verse","number":8,"content":["Lekeni kwa imwana, Imulungu kalonga,",{"text":"“Undewa wako, ghwe Imulungu, ng'aumala bae.","poem":1},{"lineBreak":true},{"text":"Ghweghwe kwotawala kwa kumnoghelesa Imulungu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ghweghwe konoghela ghamatendo ighomnoghela Imulungu na koghahila ghehile.","poem":1},{"lineBreak":true},{"text":"Apfo Imulungu, Imulungu wako kakusaghula,","poem":1},{"lineBreak":true},{"text":"kakutenda udeng'elele ng'ani","poem":1},{"lineBreak":true},{"text":"kubita pfawatendile weyagho.”","poem":1}]},{"type":"verse","number":10,"content":["Kuya kalonga,",{"text":"“Ghweghwe Imtwatsa aho mwanduso tsakulumba isi yose,","poem":1},{"lineBreak":true},{"text":"kwa ghamoko ghako tsakulumba kulanga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Napfo pfitsohupa, ila ghweghwe kutsosighala,","poem":1},{"lineBreak":true},{"text":"pfose pfitsolala ka lighwanda.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kutsotsibotabota ka gholole,","poem":1},{"lineBreak":true},{"text":"natso tsitsoghaluka,","poem":1},{"lineBreak":true},{"text":"lekeni ghweghwe kutsosighala pfipfo pfauli","poem":1},{"lineBreak":true},{"text":"na ughima wako ng'autsomala bae.”","poem":1}]},{"type":"verse","number":13,"content":["Imulungu ng'amlongele mbe malaika wowose,",{"text":"“Ukale hano ubali wangu wa kujilo","poem":1},{"lineBreak":true},{"text":"mbaka hanitsoweka wehile wako","poem":1},{"lineBreak":true},{"text":"hasi ha ghamaghulu ghako.”","poem":1}]},{"type":"verse","number":14,"content":["Lelo kuya wamalaika tsina nani? Wawo muhe iwomsang'anila Imulungu, na waghalighwa nae kuwapfila awala iwatsobokela ukombotsi."]}],"footnotes":[]},"thisChapterLink":"/api/ruf_pbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ruf_pbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ruf_pbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}