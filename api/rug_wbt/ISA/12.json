{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"ISA","translationId":"rug_wbt","name":"Aisea","commonName":"Aisea","title":"SA BUKA TE AISEA","order":23,"numberOfChapters":66,"sha256":"b9cb1cb07af2565b9978f62e970d48e56cfd3165cfdd5df96477d818e1cf5ade","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/rug_wbt/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Na Kinera Vinahesi"]},{"type":"verse","number":1,"content":["Koasa rane asa si kote zama si agoi:",{"text":"“Zihova, maqu vahesi Igo.","poem":1},{"text":"Na bugoro nau Goi si arau,","poem":2},{"text":"ba ele rizu taloa sa Mua tinaṉaziri","poem":1},{"text":"meke kamahire si va manotau Goi si arau.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hinokara na qua hinarupu sa Tamasa;","poem":1},{"text":"Kote raṉea arau meke lopu kote koa matagutu.","poem":2},{"text":"E Zihova, e Zihova, sa qua ṉiniraṉira meke sa qua kinera;","poem":1},{"text":"Asa si na qua hinarupu.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pa qinetuqetu si kote kave vagi kolo napo si goi","poem":1},{"text":"koasa berukehe tinaharupu!","poem":2}]},{"type":"verse","number":4,"content":["Koasa rane asa si kote zama si agoi:",{"text":"“Zama leana la koe Zihova, tepa tinokae koasa Pozana;","poem":1},{"text":"tozi va avoso lani koari na butubutu sari Nana tinavete,","poem":2},{"lineBreak":true},{"text":"mamu va lavatia sa Pozana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mi kera la koe Zihova, sina sari na tinavete variva magasadi si taveti Sa;","poem":1},{"text":"vata gilana nia koasa doduruna sa kasia popoa sa inavoso hie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mi kukili vala beto na kera qetuqetu, gamu tie pa Zaione,","poem":1},{"text":"ura tava lavata si Asa pu Hopena pa Izireli pu koa pa vari korapa mia.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}