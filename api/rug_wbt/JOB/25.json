ext":"Na tie mo bisa, sapu gua mo na uloso!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}