{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":1,"content":[{"type":"heading","content":["Sa Qinetu Hinokara"]},{"type":"verse","number":1,"content":[{"text":"Tamanae tugo sa tie","poem":1},{"text":"pu lopu lulia sa tinolie tadi na tie kaleadi,","poem":2},{"lineBreak":true},{"text":"meke lopu tavete lulia sa hahanana tadi na tie seadi,","poem":2},{"lineBreak":true},{"text":"meke lopu koa somanae koari na tie va gugue.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ba qetu nia sa sa tinarae te Zihova,","poem":1},{"text":"meke balabala va lohi la ia sa si asa rane na boṉi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kekeṉoṉo gua tugo na huda","poem":1},{"text":"pu ta lete pa taqele ovuku si arini,","poem":2},{"lineBreak":true},{"text":"sapu vua valeana pa dia totoso,","poem":2},{"lineBreak":true},{"text":"na buma valeana sari na elelona.","poem":2},{"text":"Na tie ravutudi si arini koari doduru dia tinavete.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lopu gua asa sari na tie kaleadi,","poem":1},{"text":"ba gua tugo na hikahika huiti","poem":2},{"lineBreak":true},{"text":"sapu ta givusu palae si arini.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sari na tie kaleadi si kaqu ta zutu","poem":1},{"text":"na tava kilasa koe Tamasa,","poem":2},{"lineBreak":true},{"text":"meke kaqu tava ilolo taloa koari na vinarigarae tadi na tie soti tanisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ura lavelaveni na kopuni e Zihova sari na tie toṉoto,","poem":1},{"text":"ba sari na tie kaleadi si kaqu tava mate palae.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}