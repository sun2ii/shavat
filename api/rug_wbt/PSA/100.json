{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":100,"content":[{"type":"heading","content":["Keke Kinera Zama Leana"]},{"type":"verse","number":1,"content":[{"text":"Mi kera qetuqetu la koe Zihova gamu doduru tinoni pa kasia popoa!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Vahesia se Zihova pa qinetuqetu,","poem":1},{"text":"mae kera qetuqetu pa kenuna Sa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mi gilania sapu se Zihova si na Tamasa.","poem":1},{"text":"Asa tavete gita si gita, ke tanisa tu si gita.","poem":2},{"lineBreak":true},{"text":"Gita si na Nana tie, meke na sipi pu ta kopue koa Sa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nuquru mae pa sasadana sa Nana Zelepade pa vinahesina,","poem":1},{"text":"mi zama leana koa Sa, mi vahesia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ura na leana se Zihova,","poem":1},{"text":"sa Nana tataru nabuna si loke kokoina,","poem":2},{"lineBreak":true},{"text":"meke kopuni Sa sari Nana zinama ninae rane ka rane.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}