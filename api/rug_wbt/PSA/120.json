{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":120,"content":[{"type":"heading","content":["Keke Tinepa Tinokae"]},{"type":"hebrew_subtitle","content":["(Sari na Sam 120-134 si hoke kerani rini totoso sage la pa Zerusalema si arini pude somana pa vinahesi.)"]},{"type":"verse","number":1,"content":[{"text":"Pa qua tinasuna si tepa la tinokae si rau koe Zihova,","poem":1},{"text":"ke toka nau Sa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mu harupau Zihova,","poem":1},{"text":"koari na tie marikokohadi, na sekesekeidi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gamu kasa na tie marikokoha mia,","poem":1},{"text":"na sa si kaqu taveteni gamu Sa si gamu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kaqu ta gonae tupi ṉarudi tadi na tie varipera,","poem":1},{"text":"meke ta kina motete leradi si gamu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pude koa somanae koa gami, si kaleana hola nia pude koa turaṉae koari na tie pa Meseki","poem":1},{"noteId":16},{"text":",","poem":1},{"text":"babe koari na tie pa Kedara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ele seunae hola koa somanae si rau","poem":1},{"text":"koari na tie pu kukiti nia sa binule.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sipu tozi ni rau sari na tie pude koa bule,","poem":1},{"text":"sa vinaripera tu si hiva nia rini.","poem":2}]}],"footnotes":[{"noteId":16,"caller":"*","text":"Sari na tie huporo kaleadi si koa pa seu pa Meseki meke Kedara.","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/rug_wbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}