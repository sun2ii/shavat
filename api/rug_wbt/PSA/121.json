{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":121,"content":[{"type":"heading","content":["E Zihova mo sa Nada Tie Kopu"]},{"type":"verse","number":1,"content":[{"text":"Eṉa sage la koari na toqere si rau meke balabala,","poem":1},{"text":"“Pavei si kaqu mae gua sa qua tinokae?”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sa qua tinokae si kaqu mae gua koe Zihova","poem":1},{"text":"sapu tavetena sa maṉauru meke na pepeso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kaqu kopu nigo Sa si goi pude lopu gulazoro hoqa nigo.","poem":1},{"text":"Asa sapu kopu nigo si kote koa vaṉunu la mo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dotu, Asa sapu kopu nia se Izireli","poem":1},{"text":"si lopu kaqu rorodoko, na puta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"E Zihova si na mua Tie Kopu;","poem":1},{"text":"koa tata koa goi si Asa pude kopu nigo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sa rimata si lopu kaqu va sigitigo pana rane,","poem":1},{"text":"meke gua tugo sa sidara pana boṉi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E Zihova si kaqu kopu nigo pa doduru tinasuna;","poem":1},{"text":"kaqu va sare igo Sa si goi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kaqu kopu nigo e Zihova si goi koari doduru mua inene,","poem":1},{"text":"kamahire meke ninae rane ka rane.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}