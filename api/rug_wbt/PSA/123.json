{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":123,"content":[{"type":"heading","content":["Keke Vinaravarana sa Tataru Variva Taleosae"]},{"type":"verse","number":1,"content":[{"text":"Kei Zihova, koa Goi mo si doṉo atu si rau,","poem":1},{"text":"Agoi sapu koa ṉati hiniva pa Maṉauru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gua sapu sa nabulu si kalavarae mo koasa tie pu ṉati hiniva nia,","poem":1},{"text":"meke sa nabulu vineki si kalavarae mo koasa barikaleqe pu ṉati hiniva nia,","poem":2},{"text":"si gua tugo asa si gami koa Goi Zihova sa mami Tamasa,","poem":1},{"text":"osolae tataru ni gami na tokani gami Goi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kei Zihova, Mu tataruni gami na harupu gami,","poem":1},{"text":"ura lopu makudo doṉo va gore gami rini.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ele seunae hola sapu ta ṉoṉovala si gami koari na tie tagotago,","poem":1},{"text":"meke tava sisirei koari pu ṉoṉovala gami si gami,","poem":2},{"lineBreak":true},{"text":"arini pu vahesi puleni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}