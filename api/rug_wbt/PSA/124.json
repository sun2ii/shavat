{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":124,"content":[{"type":"heading","content":["Tamasa si na Tie Kopu tadi Nana Tie"]},{"type":"hebrew_subtitle","content":["(Keke kinera te Devita)"]},{"type":"verse","number":1,"content":[{"text":"Vegua, be lopu tokani gita e Zihova?","poem":1},{"text":"Mada olaṉa guahe,","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Be lopu tokani gita e Zihova si gita,","poem":1},{"text":"totoso rapatani gita rina nada kana,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"si gina kote ele va mate beto gita tu rini","poem":1},{"text":"pa dia tinaṉazirida,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"meke sa tinahuara pu guana totolo sapu taveteni gita rina nada kana, si be ele paleke taloani gita tu,","poem":1},{"text":"meke nobi tamunu gita, guana kolo,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"be ele lodu mate tu si gita pa tinasuna guana naqe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mada vahesia se Zihova sapu kopuni gita,","poem":1},{"text":"pude lopu ta ṉoṉovala koari na nada kana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tava sare si gita, guana kurukuru tava vura taloana koasa sipata tadi na tie hata kurukuru,","poem":1},{"text":"ta rupaha si gita koasa sipata ta huarana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sa nada tinokae si mae guana koe Zihova","poem":1},{"text":"sapu tavetena sa maṉauru na pepeso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}