{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":126,"content":[{"type":"heading","content":["Keke Tinepatepa Vinasare"]},{"type":"verse","number":1,"content":[{"text":"Sipu turaṉa pule lani gita e Zihova si gita pa Zerusalema,","poem":1},{"text":"si guana putagita si gita.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hegere na kera qetuqetu si gita,","poem":1},{"text":"meke vari zamae sari na votiki butubutu,","poem":2},{"lineBreak":true},{"text":"“E Zihova si evaṉi sari na tiṉitoṉa variva magasadi koarini,” gua.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Meke hinokara tugo, evaṉi tugo e Zihova sari na tiṉitoṉa nomanomadi koa gita,","poem":1},{"text":"ke ele qetuqetu hola si gita!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kei Zihova, Mu va koa valeana pule gami,","poem":1},{"text":"guana ruku pu vala puleni kolo sari na ovuku popadi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sarini pu lelete pa kolomata,","poem":1},{"text":"si madi pakepakete pa qinetuqetu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sarini pu paleki sari na kiko pa kinabokabo pude la lelete,","poem":1},{"text":"si kaqu kera qetuqetu pa dia pinule mae;","poem":2},{"lineBreak":true},{"text":"totoso paleki rini sari na vuadi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}