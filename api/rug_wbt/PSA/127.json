{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":127,"content":[{"type":"heading","content":["Vinahesina sa Lineana te Tamasa"]},{"type":"hebrew_subtitle","content":["(Keke kinera te Solomone)"]},{"type":"verse","number":1,"content":[{"text":"Be lopu kuria e Zihova sa vetu,","poem":1},{"text":"si kote loke laena sa tinavete tadi na tie kuri vetu.","poem":2},{"text":"Be lopu kopu nia e Zihova sa vasileana,","poem":1},{"text":"si loke laena pude kopu nia ari na tie varane si asa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Loke laena pude vaṉunu munumunu hokara,","poem":1},{"text":"meke pule boṉi pa tinavete ṉiṉirana pude hata ia sa kinoa valeana.","poem":2},{"text":"Ura e Zihova tu poni sarini pu tataru ni Sa,","poem":1},{"text":"meke poni totoso puta Sa si arini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sari na koburu si na vinariponi te Zihova,","poem":1},{"text":"na minana hinokara si arini.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sari na tuna koreo sa tie totoso vaqurana sa,","poem":1},{"text":"si kekeṉoṉo guana tupi pa limana sa tie varane.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Qetu tugo sa tie pu soku tuna guana tie pu siṉi sa nana voivoina tupi,","poem":1},{"text":"sina lopu kaqu boka tava kilasa si asa,","poem":2},{"lineBreak":true},{"text":"pana tutuvi sa sari nana kana pude varitokei pa sasadana sa vasileana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}