{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":128,"content":[{"type":"heading","content":["Piniana sa Vina Tabe Koe Zihova"]},{"type":"verse","number":1,"content":[{"text":"Tamanae tugo sarini pu pamaṉa nia se Zihova,","poem":1},{"text":"meke luli sari Nana hiniva!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kaqu henai gamu vuadi sari na tinavete pa limamia;","poem":1},{"text":"kaqu qetuqetu si gamu, meke learane sa mia kinoa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kaqu podopodo va soku sa mua barikaleqe,","poem":1},{"text":"guana huda vaeni pu vua katakata pa mua kali vetu,","poem":2},{"lineBreak":true},{"text":"meke sari na tumu si kaqu guana huda olive vaqura pu toa vari likohae nia sa mua vasina henahenana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kaqu tamanae gua asa sa tie pu pamaṉa nia se Zihova.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kaqu mana nigo e Zihova pa Zaione!","poem":1},{"text":"meke kaqu dogoria goi sa learane pa Zerusalema","poem":2},{"lineBreak":true},{"text":"doduru rane pa mua kinoa!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kaqu dogori goi sari na tudia rina tumu!","poem":1},{"lineBreak":true},{"text":"Mani koa pa Izireli sa binule!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}