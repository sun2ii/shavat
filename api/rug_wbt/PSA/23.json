text":"Va nama poni nau Goi sa gequ ginani","poem":1},{"text":"pa kenudi rina qua kana.","poem":2},{"text":"Lumulumua Goi sa batuqu,","poem":1},{"text":"siṉi ta luluapae sa qua kapa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gilania rau sapu sa Mua lineana na tinokae mo","poem":1},{"text":"si kaqu luli au ninae rane pa qua tinoa,","poem":2},{"lineBreak":true},{"text":"meke kaqu koa si rau pa vetu te Zihova ninae rane ka rane.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}