{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":3,"content":[{"type":"heading","content":["Vinaravara Tinepa Tinokae pana Munumunu"]},{"type":"hebrew_subtitle","content":["(Kinera te Devita sipu govete nia sa se Abusalamu d, sa tuna koreo)"]},{"type":"verse","number":1,"content":[{"text":"Ke Zihova, soku lala dia tu saripu kukiti nau,","poem":1},{"text":"sokudi tugo saripu varipera mae koa rau.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sokudi rina tie pu zamazama nau si zama,","poem":1},{"text":"“Lopu kaqu toka nia Tamasa si asa,” gua!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ba Agoi Zihova, si na qua lave doduru totoso pa tinasuna;","poem":1},{"text":"meke poni nau sa minataqara na vina lavata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tepa va ululae la ia rau sa tinokae koe Zihova,","poem":1},{"text":"meke va avosau Sa pa Nana toqere hope pa Zaione.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Eko si rau meke puta, meke vaṉunu si rau,","poem":1},{"text":"ba korapa kopu nau e Zihova!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lopu kaqu matagutu ni rau sari na tina na tina qua kana","poem":1},{"text":"pu koa pa vari likohaequ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ke Zihova qua Tamasa, tuturei mae, mamu harupau!","poem":1},{"lineBreak":true},{"text":"Mu sekei isumatadi sari na qua kana,","poem":1},{"text":"Mu pako pani livodi sari na tie kaleadi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sa vinasare si Tamugoi Zihova tugo,","poem":1},{"lineBreak":true},{"text":"sa tinamanae Tamugoi si mani koa koari na Mua tie!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}