{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":67,"content":[{"type":"heading","content":["Kinera Zama Leana Koe Tamasa"]},{"type":"hebrew_subtitle","content":["(Sa kinera pude mikemike nia)"]},{"type":"verse","number":1,"content":[{"text":"Tamasa, Mamu tataruni gami na manani gami si gami.","poem":1},{"text":"Mu doṉo mae gami pa Mua tataru,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"pude madi gilania rina tiena sa kasia popoa sa Mua hiniva;","poem":1},{"text":"meke pude di gilania ri doduru butubutu","poem":2},{"lineBreak":true},{"text":"sapu harupu gami Goi pa Mua ṉiniraṉira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kei Tamasa, madi vahesigo rina tinoni si Agoi,","poem":1},{"text":"madi vahesigo ri doduru tinoni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Madi kera qetuqetu sari doduru butubutu,","poem":1},{"text":"ura varipitui ni Goi pa tinoṉoto,","poem":2},{"lineBreak":true},{"text":"meke turaṉi sari na butubutu pa pepeso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kei Tamasa, madi vahesigo rina tinoni si Agoi.","poem":1},{"text":"Madi vahesigo ri doduru tinoni,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"meke kaqu masuru sa pepeso, meke vua katakata sari na vuvua,","poem":1},{"text":"meke kaqu manani gita sa nada Tamasa si gita.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uve kaqu manani gita sa Tamasa si gita,","poem":1},{"text":"kaqu va lavatia rina tinoni pa doduru kasia popoa si Asa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}