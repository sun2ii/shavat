gua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Habahuala na malaṉa si rau;","poem":1},{"text":"tuturei mae koa rau qua Tamasa,","poem":2},{"text":"Agoi si na qua Hinarupu;","poem":1},{"text":"kei Zihova, Mu tuturei mae toka nau.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}