{"translation":{"id":"rug_wbt","name":"Buka Hope","website":"https://ebible.org/Scriptures/details.php?id=rug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=rug","licenseNotes":null,"shortName":"WBT","englishName":"Roviana Bible","language":"rug","textDirection":"ltr","sha256":"471a6ba02f11554c9545554c55d125cc1706f6ab433f8e26c9e8c35e7f57dff2","availableFormats":["json"],"listOfBooksApiLink":"/api/rug_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30341,"languageName":"Roviana","languageEnglishName":"Roviana"},"book":{"id":"PSA","translationId":"rug_wbt","name":"Sam","commonName":"Sam","title":"SA BUKA SAM Sari na Kinera tadi na Tie Ziu Pukerane","order":19,"numberOfChapters":150,"sha256":"5813001ecc1b54cbce35b89607658a21685966086623cd2586b85a049564ca26","firstChapterNumber":1,"firstChapterApiLink":"/api/rug_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rug_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":87,"content":[{"type":"heading","content":["Vinahesina sa Popoa Zerusalema"]},{"type":"hebrew_subtitle","content":["(Keke kinera tanisa butubutu Kora)"]},{"type":"verse","number":1,"content":[{"text":"Kuria e Zihova sa Nana vasileana nomana koasa toqere hopena.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Tataru sisigiti nia Sa sa popoa Zerusalema,","poem":2},{"lineBreak":true},{"text":"hola ni sari kaiqa vasidi pule pa Izireli.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gamu na tiena sa vasileana te Tamasa;","poem":1},{"text":"mi va avosi sari na tiṉitoṉa variva magasadi pu zama ni Sa koa sa ginugua mia gamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Kaqu nae turaṉae ni rau sari pa Izipi meke Babiloni,","poem":1},{"text":"koari na butubutu pu va tabei sari na Qua zinama;","poem":2},{"text":"meke sari na tiedi rina popoa Pilisitia, Taea, meke Itiopia","poem":1},{"text":"si kaqu nae somana ni Rau koari na tiena sa popoa Zerusalema,” gua si Asa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Koasa guguana sa popoa Zaione, si kote ta zamae si asa,","poem":1},{"text":"“Tanisa sari doduru butubutu,","poem":2},{"lineBreak":true},{"text":"meke Asa sapu Ululuna Hola si kaqu va ṉiṉira ia si asa.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kaqu kubere gore ni e Zihova sari na tinoni meke zama,","poem":1},{"text":"“Sa tie hie si ta podo pa Zaione tugo,” gua.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Peka, na kera si arini.","poem":1},{"text":"“Koa pa Zaione sa ṉati di ri doduru minana,” gua si arini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/rug_wbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rug_wbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rug_wbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}