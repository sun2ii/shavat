{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":109,"content":[{"type":"hebrew_subtitle","content":["Псалом Давида."]},{"type":"verse","number":1,"content":[{"text":"Сказал Господь Господу моему: седи одесную Меня, доколе положу врагов Твоих в подножие ног Твоих.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Жезл силы Твоей пошлет Господь с Сиона: господствуй среди врагов Твоих.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"В день силы Твоей народ Твой готов во благолепии святыни; из чрева прежде денницы подобно росе рождение Твое.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Клялся Господь и не раскается: Ты священник вовек по чину Мелхиседека.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Господь одесную Тебя. Он в день гнева Своего поразит царей;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"совершит суд над народами, наполнит землю трупами, сокрушит голову в земле обширной.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Из потока на пути будет пить, и потому вознесет главу.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":7}