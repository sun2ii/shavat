{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Аллилуия."]},{"type":"verse","number":1,"content":[{"text":"Славлю Тебя, Господи, всем сердцем моим в совете праведных и в собрании.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Велики дела Господни, вожделенны для всех, любящих оные.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Дело Его - слава и красота, и правда Его пребывает вовек.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Памятными соделал Он чудеса Свои; милостив и щедр Господь.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Пищу дает боящимся Его; вечно помнит завет Свой.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Силу дел Своих явил Он народу Своему, чтобы дать ему наследие язычников.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Дела рук Его - истина и суд; все заповеди Его верны,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"тверды на веки и веки, основаны на истине и правоте.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Избавление послал Он народу Своему; заповедал на веки завет Свой. Свято и страшно имя Его!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Начало мудрости - страх Господень; разум верный у всех, исполняющих заповеди Его. Хвала Ему пребудет вовек","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":10}