{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":112,"content":[{"type":"hebrew_subtitle","content":["Аллилуия."]},{"type":"verse","number":1,"content":[{"text":"Хвалите, рабы Господни, хвалите имя Господне.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Да будет имя Господне благословенно отныне и вовек.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"От восхода солнца до запада да будет прославляемо имя Господне.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Высок над всеми народами Господь; над небесами слава Его.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Кто, как Господь, Бог наш, Который, обитая на высоте,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"приклоняется, чтобы призирать на небо и на землю;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"из праха поднимает бедного, из брения возвышает нищего,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"чтобы посадить его с князьями, с князьями народа его;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"неплодную вселяет в дом матерью, радующеюся о детях? Аллилуия!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":9}