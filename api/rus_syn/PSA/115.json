lineBreak":true},{"text":"Тебе принесу жертву хвалы, и имя Господне призову.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Обеты мои воздам Господу пред всем народом Его,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"во дворах дома Господня, посреди тебя, Иерусалим! Аллилуия.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":10}