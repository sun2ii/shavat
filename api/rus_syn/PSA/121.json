{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["Песнь восхождения. Давида."]},{"type":"verse","number":1,"content":[{"text":"Возрадовался я, когда сказали мне: “пойдем в дом Господень”.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Вот, стоят ноги наши во вратах твоих, Иерусалим,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Иерусалим, устроенный как город, слитый в одно,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"куда восходят колена, колена Господни, по закону Израилеву, славить имя Господне.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Там стоят престолы суда, престолы дома Давидова.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Просите мира Иерусалиму: да благоденствуют любящие тебя!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Да будет мир в стенах твоих, благоденствие - в чертогах твоих!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ради братьев моих и ближних моих говорю я: “мир тебе!”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ради дома Господа, Бога нашего, желаю блага тебе.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":9}