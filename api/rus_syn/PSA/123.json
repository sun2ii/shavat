{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":123,"content":[{"type":"hebrew_subtitle","content":["Песнь восхождения. Давида."]},{"type":"verse","number":1,"content":[{"text":"Если бы не Господь был с нами, - да скажет Израиль,-","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"если бы не Господь был с нами, когда восстали на нас люди,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"то живых они поглотили бы нас, когда возгорелась ярость их на нас;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"воды потопили бы нас, поток прошел быв над душею нашею;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"прошли бы над душею нашею воды бурные.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Благословен Господь, Который не дал нас в добычу зубам их!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Душа наша избавилась, как птица, из сети ловящих: сеть расторгнута, и мы избавились.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Помощь наша - в имени Господа, сотворившего небо и землю.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":8}