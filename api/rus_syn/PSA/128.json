{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["Песнь восхождения."]},{"type":"verse","number":1,"content":[{"text":"Много теснили меня от юности моей, да скажет Израиль:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"много теснили меня от юности моей, но не одолели меня.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"На хребте моем орали оратаи, проводили длинные борозды свои.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Но Господь праведен: Он рассек узы нечестивых.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Да постыдятся и обратятся назад все ненавидящие Сион!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Да будут, как трава на кровлях, которая прежде, нежели будет исторгнута, засыхает,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"которою жнец не наполнит руки своей, и вяжущий снопы - горсти своей;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"и проходящие мимо не скажут: “благословение Господне на вас; благословляем вас именем Господним!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":8}