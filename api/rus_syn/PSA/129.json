ибо у Господа милость и многое у Него избавление,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"и Он избавит Израиля от всех беззаконий его.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}