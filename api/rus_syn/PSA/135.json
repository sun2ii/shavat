{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":135,"content":[{"type":"hebrew_subtitle","content":["Аллилуия."]},{"type":"verse","number":1,"content":[{"text":"Славьте Господа, ибо Он благ, ибо вовек милость Его.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Славьте Бога богов, ибо вовек милость Его.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Славьте Господа господствующих, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Того, Который один творит чудеса великие, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Который сотворил небеса премудро, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"утвердил землю на водах, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"сотворил светила великие, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"солнце - для управления днем, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"луну и звезды - для управления ночью, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"поразил Египет в первенцах его, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"и вывел Израиля из среды его, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"рукою крепкою и мышцею простертою, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"разделил Чермное море, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"и провел Израиля посреди его, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"и низверг фараона и войско его в море Чермное, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"провел народ Свой чрез пустыню, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"поразил царей великих, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"и убил царей сильных, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Сигона, царя Аморрейского, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"и Ога, царя Васанского, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"и отдал землю их в наследие, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"в наследие Израилю, рабу Своему, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"вспомнил нас в унижении нашем, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"и избавил нас от врагов наших, ибо вовек милость Его;","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"дает пищу всякой плоти, ибо вовек милость Его.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Славьте Бога небес, ибо вовек милость Его.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":26}