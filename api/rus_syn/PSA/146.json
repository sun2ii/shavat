{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":146,"content":[{"type":"hebrew_subtitle","content":["Аллилуия."]},{"type":"verse","number":1,"content":[{"text":"Хвалите Господа, ибо благо петь Богу нашему, ибо это сладостно,- хвала подобающая.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Господь созидает Иерусалим, собирает изгнанников Израиля.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Он исцеляет сокрушенных сердцем и врачует скорби их;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"исчисляет количество звезд; всех их называет именами их.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Велик Господь наш и велика крепость Его, и разум Его неизмерим.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Смиренных возвышает Господь, а нечестивых унижает до земли.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Пойте поочередно славословие Господу; пойте Богу нашему на гуслях.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Он покрывает небо облаками, приготовляет для земли дождь, произращает на горах траву и злак на пользу человеку;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"дает скоту пищу его и птенцам ворона, взывающим к Нему.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Не на силу коня смотрит Он, не к быстроте ног человеческих благоволит,-","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"благоволит Господь к боящимся Его, к уповающим на милость Его.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":11}