{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":147,"content":[{"type":"hebrew_subtitle","content":["Аллилуия."]},{"type":"verse","number":1,"content":[{"text":"Хвали, Иерусалим, Господа; хвали, Сион, Бога твоего,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ибо Он укрепляет вереи ворот твоих, благословляет сынов твоих среди тебя;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"утверждает в пределах твоих мир; туком пшеницы насыщает тебя;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"посылает слово Свое на землю; быстро течет слово Его;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"дает снег, как волну; сыплет иней, как пепел;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"бросает град Свой кусками; перед морозом Его кто устоит?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Пошлет слово Свое, и все растает; подует ветром Своим, и потекут воды.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Он возвестил слово Свое Иакову, уставы Свои и суды Свои Израилю.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Не сделал Он того никакому другому народу, и судов Его они не знают. Аллилуия.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":9}