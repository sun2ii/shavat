{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":149,"content":[{"type":"hebrew_subtitle","content":["Аллилуия."]},{"type":"verse","number":1,"content":[{"text":"Пойте Господу песнь новую; хвала Ему в собрании святых.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Да веселится Израиль о Создателе своем; сыны Сиона да радуются о Царе своем.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"да хвалят имя Его с ликами, на тимпане и гуслях да поют Ему,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ибо благоволит Господь к народу Своему, прославляет смиренных спасением.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Да торжествуют святые во славе, да радуются на ложах своих.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Да будут славословия Богу в устах их, и меч обоюдоострый в руке их,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"для того, чтобы совершать мщение над народами, наказание над племенами,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"заключать царей их в узы и вельмож их в оковы железные,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"производить над ними суд писанный. Честь сия - всем святым Его. Аллилуия.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}