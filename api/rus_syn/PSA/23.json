{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Псалом Давида."]},{"type":"verse","number":1,"content":[{"text":"Господня земля и что наполняет ее, вселенная и все живущее в ней,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ибо Он основал ее на морях и на реках утвердил ее.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Кто взойдет на гору Господню, или кто станет на святом месте Его?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Тот, у которого руки неповинны и сердце чисто, кто не клялся душою своею напрасно и не божился ложно, -","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"тот получит благословение от Господа и милость от Бога, Спасителя своего.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Таков род ищущих Его, ищущих лица Твоего, Боже Иакова!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Поднимите, врата, верхи ваши, и поднимитесь, двери вечные, и войдет Царь славы!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Кто сей Царь славы? - Господь крепкий и сильный, Господь, сильный в брани.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Поднимите, врата, верхи ваши, и поднимитесь, двери вечные, и войдет Царь славы!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Кто сей Царь славы? - Господь сил, Он - царь славы.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":10}