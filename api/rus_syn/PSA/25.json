{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["Псалом Давида."]},{"type":"verse","number":1,"content":[{"text":"Рассуди меня, Господи, ибо я ходил в непорочности моей, и, уповая на Господа, не поколеблюсь.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Искуси меня, Господи, и испытай меня; расплавь внутренности мои и сердце мое,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ибо милость Твоя пред моими очами, и я ходил в истине Твоей,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"не сидел я с людьми лживыми, и с коварными не пойду;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"возненавидел я сборище злонамеренных, и с нечестивыми не сяду;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"буду омывать в невинности руки мои и обходить жертвенник Твой, Господи,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"чтобы возвещать гласом хвалы и поведать все чудеса Твои.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Господи! возлюбил я обитель дома Твоего и место жилища славы Твоей.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Не погуби души моей с грешниками и жизни моей с кровожадными,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"у которых в руках злодейство, и которых правая рука полна мздоимства.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"А я хожу в моей непорочности; избавь меня, и помилуй меня.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Моя нога стоит на прямом пути; в собраниях благословлю Господа.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}