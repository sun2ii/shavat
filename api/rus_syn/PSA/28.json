{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["Псалом Давида."]},{"type":"verse","number":1,"content":[{"text":"Воздайте Господу, сыны Божии, воздайте Господу славу и честь,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"воздайте Господу славу имени Его; поклонитесь Господу в благолепном святилище Его.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Глас Господень над водами; Бог славы возгремел, Господь над водами многими.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Глас Господа силен, глас Господа величествен.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Глас Господа сокрушает кедры; Господь сокрушает кедры Ливанские","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"и заставляет их скакать подобно тельцу, Ливан и Сирион, подобно молодому единорогу.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Глас Господа высекает пламень огня.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Глас Господа потрясает пустыню; потрясает Господь пустыню Кадес.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Глас Господа разрешает от бремени ланей и обнажает леса; и во храме Его все возвещает о Его славе.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Господь восседал над потопом, и будет восседать Господь царем вовек.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Господь даст силу народу Своему, Господь благословит народ Свой миром.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":11}