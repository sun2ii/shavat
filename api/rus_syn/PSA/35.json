{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":[{"text":"Начальнику хора. Раба Господня Давида.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Нечестие беззаконного говорит в сердце моем: нет страха Божия пред глазами его,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ибо он льстит себе в глазах своих, будто отыскивает беззаконие свое, чтобы возненавидеть его;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"слова уст его - неправда и лукавство; не хочет он вразумиться, чтобы делать добро;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"на ложе своем замышляет беззаконие, становится на путь недобрый, не гнушается злом.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Господи! милость Твоя до небес, истина Твоя до облаков!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Правда Твоя, как горы Божии, и судьбы Твои - бездна великая! Человеков и скотов хранишь Ты, Господи!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Как драгоценна милость Твоя, Боже! Сыны человеческие в тени крыл Твоих покойны:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"насыщаются от тука дома Твоего, и из потока сладостей Твоих Ты напояешь их,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ибо у Тебя источник жизни; во свете Твоем мы видим свет.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Продли милость Твою к знающим Тебя и правду Твою к правым сердцем,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"да не наступит на меня нога гордыни, и рука грешника да не изгонит меня:","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"там пали делающие беззаконие, низринуты и не могут встать.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":13}