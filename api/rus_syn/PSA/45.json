{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"Начальнику хора. Сынов Кореевых. На музыкальном орудии Аламоф. Песнь.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Бог нам прибежище и сила, скорый помощник в бедах,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"посему не убоимся, хотя бы поколебалась земля, и горы двинулись в сердце морей.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Пусть шумят, вздымаются воды их, трясутся горы от волнения их.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Речные потоки веселят град Божий, святое жилище Всевышнего.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Бог посреди его; он не поколеблется: Бог поможет ему с раннего утра.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Восшумели народы; двинулись царства: Всевышний дал глас Свой, и растаяла земля.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Господь сил с нами, Бог Иакова заступник наш.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Придите и видите дела Господа, какие произвел Он опустошения на земле:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"прекращая брани до края земли, сокрушил лук и переломил копье, колесницы сжег огнем.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Остановитесь и познайте, что Я - Бог: буду превознесен в народах, превознесен на земле.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Господь сил с нами, заступник наш Бог Иакова.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":12}