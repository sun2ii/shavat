{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":[{"text":"Начальнику хора. Сынов Кореевых.","poem":1},"Псалом."]},{"type":"verse","number":2,"content":[{"text":"Восплещите руками все народы, воскликните Богу гласом радости;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ибо Господь Всевышний страшен, - великий Царь над всею землею;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"покорил нам народы и племена под ноги наши;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"избрал нам наследие наше, красу Иакова, которого возлюбил.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Восшел Бог при восклицаниях, Господь при звуке трубном.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Пойте Богу нашему, пойте; пойте Царю нашему, пойте,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ибо Бог - Царь всей земли; пойте все разумно.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Бог воцарился над народами, Бог воссел на святом престоле Своем;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"князья народов собрались к народу Бога Авраамова, ибо щиты земли - Божии; Он превознесен над ними.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":10}