{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"Песнь.","poem":1},"Псалом. Сынов Кореевых."]},{"type":"verse","number":2,"content":[{"text":"Велик Господь и всехвален во граде Бога нашего, на святой горе Его.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Прекрасная возвышенность, радость всей земли гора Сион; на северной стороне ее город великого Царя.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Бог в жилищах его ведом, как заступник:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ибо вот, сошлись цари и прошли все мимо;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"увидели и изумились, смутились и обратились в бегство;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"страх объял их там и мука, как у женщин в родах;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"восточным ветром Ты сокрушил Фарсийские корабли.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Как слышали мы, так и увидели во граде Господа сил, во граде Бога нашего: Бог утвердит его на веки.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Мы размышляли, Боже, о благости Твоей посреди храма Твоего.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Как имя Твое, Боже, так и хвала Твоя до концов земли; десница Твоя полна правды.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Да веселится гора Сион, да радуются дщери Иудейские ради судов Твоих, Господи.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Пойдите вокруг Сиона и обойдите его, пересчитайте башни его;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"обратите сердце ваше к укреплениям его, рассмотрите домы его, чтобы пересказать грядущему роду,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ибо сей Бог есть Бог наш на веки и веки: Он будет вождем нашим до самой смерти.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}