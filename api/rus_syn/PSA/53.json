{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Начальнику хора. На струнных орудиях. Учение Давида,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"когда пришли Зифеи и сказали Саулу: “не у нас ли скрывается Давид?”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Боже! именем Твоим спаси меня, и силою Твоею суди меня.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Боже! услышь молитву мою, внемли словам уст моих,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ибо чужие восстали на меня, и сильные ищут души моей; они не имеют Бога пред собою.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Вот, Бог помощник мой; Господь подкрепляет душу мою.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Он воздаст за зло врагам моим; истиною Твоею истреби их.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Я усердно принесу Тебе жертву, прославлю имя Твое, Господи, ибо оно благо,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ибо Ты избавил меня от всех бед, и на врагов моих смотрело око мое.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":9}