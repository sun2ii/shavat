{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":60,"content":[{"type":"verse","number":1,"content":[{"text":"Начальнику хора. На струнном орудии. Псалом Давида.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Услышь, Боже, вопль мой, внемли молитве моей!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"От конца земли взываю к Тебе в унынии сердца моего; возведи меня на скалу, для меня недосягаемую,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ибо Ты прибежище мое, Ты крепкая защита от врага.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Да живу я вечно в жилище Твоем и покоюсь под кровом крыл Твоих,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ибо Ты, Боже, услышал обеты мои и дал мне наследие боящихся имени Твоего.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Приложи дни ко дням царя, лета его продли в род и род,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"да пребудет он вечно пред Богом; заповедуй милости и истине охранять его.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"И я буду петь имени Твоему вовек, исполняя обеты мои всякий день.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":9}