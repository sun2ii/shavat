{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":75,"content":[{"type":"verse","number":1,"content":[{"text":"Начальнику хора. На струнных орудиях. Псалом Асафа. Песнь.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ведом в Иудее Бог; у Израиля велико имя Его.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"И было в Салиме жилище Его и пребывание Его на Сионе.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Там сокрушил Он стрелы лука, щит и меч и брань.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ты славен, могущественнее гор хищнических.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Крепкие сердцем стали добычею, уснули сном своим, и не нашли все мужи силы рук своих.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"От прещения Твоего, Боже Иакова, вздремали и колесница и конь.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ты страшен, и кто устоит пред лицем Твоим во время гнева Твоего?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"С небес Ты возвестил суд; земля убоялась и утихла,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"когда восстал Бог на суд, чтобы спасти всех угнетенных земли.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"И гнев человеческий обратится во славу Тебе: остаток гнева Ты укротишь.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Делайте и воздавайте обеты Господу, Богу вашему; все, которые вокруг Него, да принесут дары Страшному:","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Он укрощает дух князей, Он страшен для царей земных.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":13}