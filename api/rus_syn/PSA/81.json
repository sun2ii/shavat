{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["Псалом Асафа."]},{"type":"verse","number":1,"content":[{"text":"Бог стал в сонме богов; среди богов произнес суд:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"доколе будете вы судить неправедно и оказывать лицеприятие нечестивым?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Давайте суд бедному и сироте; угнетенному и нищему оказывайте справедливость;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"избавляйте бедного и нищего; исторгайте его из руки нечестивых.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Не знают, не разумеют, во тьме ходят; все основания земли колеблются.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Я сказал: вы - боги, и сыны Всевышнего - все вы;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"но вы умрете, как человеки, и падете, как всякий из князей.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Восстань, Боже, суди землю, ибо Ты наследуешь все народы.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":8}