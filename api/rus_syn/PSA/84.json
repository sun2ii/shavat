{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","licenseNotes":null,"shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"8d2a2f2c04fa75b4e8b25415649c8329b8bab1cca13ff8853c37142fc5ab0769","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"13709aedac15472c91f4298c12ec90e60ca09f9c1b1bd4089defcd3c16b59979","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["Псалом."]},{"type":"verse","number":1,"content":[{"text":"Начальнику хора. Кореевых сынов.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Господи! Ты умилосердился к земле Твоей, возвратил плен Иакова;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"простил беззаконие народа Твоего, покрыл все грехи его,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"отъял всю ярость Твою, отвратил лютость гнева Твоего.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Восстанови нас, Боже спасения нашего, и прекрати негодование Твое на нас.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Неужели вечно будешь гневаться на нас, прострешь гнев Твой от рода в род?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Неужели снова не оживишь нас, чтобы народ Твой возрадовался о Тебе?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Яви нам, Господи, милость Твою, и спасение Твое даруй нам.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Послушаю, что скажет Господь Бог. Он скажет мир народу Своему и избранным Своим, но да не впадут они снова в безрассудство.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Так, близко к боящимся Его спасение Его, чтобы обитала слава в земле нашей!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Милость и истина сретятся, правда и мир облобызаются;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"истина возникнет из земли, и правда приникнет с небес;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"и Господь даст благо, и земля наша даст плод свой;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"правда пойдет пред Ним и поставит на путь стопы свои.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":14}