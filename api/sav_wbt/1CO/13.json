{"translation":{"id":"sav_wbt","name":"Saafi-Saafi","website":"https://ebible.org/Scriptures/details.php?id=sav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sav","licenseNotes":null,"shortName":"WBT","englishName":"Saafi-Saafi Bible","language":"sav","textDirection":"ltr","sha256":"f8e92f4acb4b69ea2a4dd0b9a29f92b0d707651b6f8a0cf5c1d9b2d233961151","availableFormats":["json"],"listOfBooksApiLink":"/api/sav_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":354,"totalNumberOfVerses":10672,"languageName":"Saafi-Saafi","languageEnglishName":"Saafi-Saafi"},"book":{"id":"1CO","translationId":"sav_wbt","name":"1 Korenta","commonName":"1 Korenta","title":"Fiisi Pool koc kaɓɗoh ɓi Korenta","order":46,"numberOfChapters":16,"sha256":"deb212843f9615300e55d369ce94e4dc911cce999abf31ce72f36cfb8e0154a1","firstChapterNumber":1,"firstChapterApiLink":"/api/sav_wbt/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/sav_wbt/1CO/16.json","totalNumberOfVerses":432},"chapter":{"number":13,"content":[{"type":"heading","content":["E waaɗ-waaɗ uup in ci jen"]},{"type":"verse","number":1,"content":[{"text":"Ali ŋ jombee peɗeem ciŋ ɓo' ci,","poem":1},{"lineBreak":true},{"text":"na ciŋ malaakaaci,","poem":1},{"lineBreak":true},{"text":"te ŋ waaɗɗi morom mbo ɗah,","poem":1},{"lineBreak":true},{"text":"ŋ mand na joolooliini na laɓse dong","poem":1},{"lineBreak":true},{"text":"wala bargi na tipse.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ali Kooh woyee taamboh nga so,","poem":1},{"lineBreak":true},{"text":"ali ŋ inah in ci ɗasɗukiɗ ci","poem":1},{"lineBreak":true},{"text":"na inhaah ci jen,","poem":1},{"lineBreak":true},{"text":"ali kosiŋ ngo kaɗ po ŋ yongsee tango sah","poem":1},{"lineBreak":true},{"text":"te ŋ waaɗɗi morom mbo,","poem":1},{"lineBreak":true},{"text":"ŋ tus haa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ali ŋ paysoh raak-raakiŋ ngo jen,","poem":1},{"lineBreak":true},{"text":"ŋ eɗoha kañam wuu ñakiɗ ci,","poem":1},{"lineBreak":true},{"text":"ŋ nam eɗoh faaniŋ ngo ne wa dohu","poem":1},{"noteId":3},{"text":",","poem":1},{"lineBreak":true},{"text":"te ŋ waaɗɗi morom mbo ɗah,","poem":1},{"lineBreak":true},{"text":"wa raakiɗɗi so ali njiriñ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ɓoyi na tume sagu waaɗ-waaɗ,","poem":1},{"lineBreak":true},{"text":"a na muñe muñ,","poem":1},{"lineBreak":true},{"text":"a na raake keeñ moɗiɗ,","poem":1},{"lineBreak":true},{"text":"a na siisoheeɗi,","poem":1},{"lineBreak":true},{"text":"a na tipkeeɗi,","poem":1},{"lineBreak":true},{"text":"a na yaksiɗkeeɗi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A na tumeeɗi in supkiɗohiɗ,","poem":1},{"lineBreak":true},{"text":"a na waakeeɗi ini njirñan haf ce,","poem":1},{"lineBreak":true},{"text":"a na yooɓeeɗi ayruk,","poem":1},{"lineBreak":true},{"text":"a na ɗaakeeɗi aay-keeñ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A na sumeeɗi ŋ ini lahɗi waas,","poem":1},{"lineBreak":true},{"text":"waaye a na sume ŋ ini nik keeh.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɓoyi na tume sagu waaɗ-waaɗ,","poem":1},{"lineBreak":true},{"text":"a na degge in nu nik,","poem":1},{"lineBreak":true},{"text":"a raak ooluk ŋ in nu nik,","poem":1},{"lineBreak":true},{"text":"a gen yaakaar in nu nik,","poem":1},{"lineBreak":true},{"text":"a teyɗuk gaduk in nu nik.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waaɗ-waaɗ na sooƴeeɗi muk.","poem":1},{"lineBreak":true},{"text":"Mbeh hey haye","poem":1},{"lineBreak":true},{"text":"Kooh woyissanɗi taamboh ŋ ɓo',","poem":1},{"lineBreak":true},{"text":"jomb peɗmi fu inahɗi reehɗu,","poem":1},{"lineBreak":true},{"text":"ki'inah reehɗu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Laam ki'inhiŋ ɓoo tasiɗ","poem":1},{"lineBreak":true},{"text":"te findi ɓoo na woyohe woo ci puloh ŋ Kooh, tasiɗ ;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"waaye ini mitiɗi hay ɗah,","poem":1},{"lineBreak":true},{"text":"ini tas mit reehɗu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wa ŋ nikoh komaaki,","poem":1},{"lineBreak":true},{"text":"ŋ woyee findi komaaki,","poem":1},{"lineBreak":true},{"text":"ŋ hotee findi komaaki,","poem":1},{"lineBreak":true},{"text":"ŋ liiɓee findi komaaki ;","poem":1},{"lineBreak":true},{"text":"wi ŋ nik yakak,","poem":1},{"lineBreak":true},{"text":"ŋ faɗta in komaaki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Woti-woti","poem":1},{"lineBreak":true},{"text":"ɓoo hotɗi jahran,","poem":1},{"lineBreak":true},{"text":"ɓoo na hote","poem":1},{"lineBreak":true},{"text":"findi ɓoyi na marke ŋ seetu,","poem":1},{"lineBreak":true},{"text":"waaye kim,","poem":1},{"lineBreak":true},{"text":"ɓoo hotan jahran.","poem":1},{"lineBreak":true},{"text":"Woti-woti","poem":1},{"lineBreak":true},{"text":"ki'inhiŋ ngo tasiɗ,","poem":1},{"lineBreak":true},{"text":"waaye kim,","poem":1},{"lineBreak":true},{"text":"ŋ hey inhe inah mitiɗ,","poem":1},{"lineBreak":true},{"text":"findi Kooh inhoh ho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kon,","poem":1},{"lineBreak":true},{"text":"in ci kaahay cii genan gen :","poem":1},{"lineBreak":true},{"text":"Kos, yaakaar, na waaɗ-waaɗ,","poem":1},{"lineBreak":true},{"text":"waaye wi uup yak nga ca, e waaɗ-waaɗ.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Raakiɗ fiis ŋ fiis ci ɗeɓgaan, ci woo ne : \"ŋ nam eɗoh faaniŋ ngo ne ŋ tipuk\".","reference":{"chapter":13,"verse":3}}]},"thisChapterLink":"/api/sav_wbt/1CO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sav_wbt/1CO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sav_wbt/1CO/12.json","previousChapterAudioLinks":{},"numberOfVerses":13}