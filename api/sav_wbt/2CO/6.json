{"translation":{"id":"sav_wbt","name":"Saafi-Saafi","website":"https://ebible.org/Scriptures/details.php?id=sav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sav","licenseNotes":null,"shortName":"WBT","englishName":"Saafi-Saafi Bible","language":"sav","textDirection":"ltr","sha256":"f8e92f4acb4b69ea2a4dd0b9a29f92b0d707651b6f8a0cf5c1d9b2d233961151","availableFormats":["json"],"listOfBooksApiLink":"/api/sav_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":354,"totalNumberOfVerses":10672,"languageName":"Saafi-Saafi","languageEnglishName":"Saafi-Saafi"},"book":{"id":"2CO","translationId":"sav_wbt","name":"2 Korenta","commonName":"2 Korenta","title":"Fiisi Pool kanakɗoh kaɓɗoh ɓi Korenta","order":47,"numberOfChapters":13,"sha256":"1ce78bd604200c3b8593d753d0a09fed14f5f39016b84944f19cdbb262610639","firstChapterNumber":1,"firstChapterApiLink":"/api/sav_wbt/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/sav_wbt/2CO/13.json","totalNumberOfVerses":254},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Ini ɓoo na pangke na Kooh tahiɗ po ɓoo na ñaahee ɗu ne rahsi ɗu rahas baahohiŋ Kooh nikuu ɓarang ɓarang."]},{"type":"verse","number":2,"content":["Laam a woyiɗ ŋ Fiis ci ne :",{"text":"« Ŋ jamanooniŋ wa,","poem":1},{"lineBreak":true},{"text":"ŋ teyiɗ kiimiŋ ɗa,","poem":1},{"lineBreak":true},{"text":"ŋ mbehiŋ muci","poem":1},{"lineBreak":true},{"text":"ŋ hirpiɗ ɗa. »","poem":1},"Jamanooni weɗɗi ! Mbehiŋ muci weɗɗi de' !"]},{"type":"heading","content":["Pangkoh ciŋ Kooh"]},{"type":"verse","number":3,"content":["Ɓoo waaɗɗi ne ɓo' raak woyaah moɗaaɗi ŋ ini kaɗ ŋ pangkiŋ ɓoo, ineem weɗ tah ɓoo waaɗɗi kafind ali ɓo' ŋ in nu wa min nik ɗah."]},{"type":"verse","number":4,"content":["Waaye ŋ in nu nik, ɓoo na teeɓohe ne ɓoo mokɗiɗ pangkiŋ surgaaciŋ Kooh :",{"lineBreak":true},{"text":"Ɓoo ɓii muñ ngaŋ miskiɗ ci","poem":1},{"lineBreak":true},{"text":"na tolfiɗ ci keeh-keeh,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"na laɓ ci ɓoo na laɓse,","poem":1},{"lineBreak":true},{"text":"na taƴ ciŋ kasooci,","poem":1},{"lineBreak":true},{"text":"na ɗuuɗ ciŋ ɓooɓi,","poem":1},{"lineBreak":true},{"text":"na panguk ci miskiɗ ci,","poem":1},{"lineBreak":true},{"text":"na aɗki, na neehaaɗiiki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɓoo na teeɓohee ɓooɓi ɓoo nikoh","poem":1},{"lineBreak":true},{"text":"na hool kiŋ ɓoo,","poem":1},{"lineBreak":true},{"text":"na inhiŋ ɓoo,","poem":1},{"lineBreak":true},{"text":"na mini ɓoo min muñ seke,","poem":1},{"lineBreak":true},{"text":"na baah kiŋ ɓoo,","poem":1},{"lineBreak":true},{"text":"na niki Fuuɗsiŋ Kooh nik nga ɓoo,","poem":1},{"lineBreak":true},{"text":"na waaɗohi kiyooh ki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɓoo ɓii teeɓoha","poem":1},{"lineBreak":true},{"text":"na woo kiŋ keeh ki,","poem":1},{"lineBreak":true},{"text":"na hatiliŋ Kooh,","poem":1},{"lineBreak":true},{"text":"na kiyurah,","poem":1},{"lineBreak":true},{"text":"wi ɓoo tum ganaay,","poem":1},{"lineBreak":true},{"text":"ganaay songoha na naafkoha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ɓoo yakɗu, ɓoo ƴissuutɗu,","poem":1},{"lineBreak":true},{"text":"ɓoo ɓii teeɓoha.","poem":1},{"lineBreak":true},{"text":"Ɓoo woyu in moɗaaɗi, ɓoo woyu moɗiɗ,","poem":1},{"lineBreak":true},{"text":"ɓoo ɓii teeɓoha.","poem":1},{"lineBreak":true},{"text":"Ɓoo ɓii teeɓoha ŋ in nu nik :","poem":1},{"lineBreak":true},{"text":"Ɓoo ambu findi leyoh,","poem":1},{"lineBreak":true},{"text":"te ɓoo na woye keeh.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɓoo ambu findi inhassaaɗi,","poem":1},{"lineBreak":true},{"text":"te ɓoo inhuuɗ baahiɗ.","poem":1},{"lineBreak":true},{"text":"Ɓoo ambu findi ɓi na kaane,","poem":1},{"lineBreak":true},{"text":"te ɓoo ɓii pes.","poem":1},{"lineBreak":true},{"text":"Ɓoo ɓii torhiɗu,","poem":1},{"lineBreak":true},{"text":"te ɓoo apuuɗi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɓoo ambu findi ɓi neɓuuɗi,","poem":1},{"lineBreak":true},{"text":"te ɓoo gen sumiɗ.","poem":1},{"lineBreak":true},{"text":"Ɓoo ambu findi ñakiɗ,","poem":1},{"lineBreak":true},{"text":"te ɓoo ɓii tah ɓo' laayiɗ raak.","poem":1},{"lineBreak":true},{"text":"Ɓoo ambu findi raakaaɗi ali in,","poem":1},{"lineBreak":true},{"text":"te in ci jen cuu ɓoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Ɗu ɓi ɓaah ciŋ ɓoo gen Korenta, ɓoo woyiɗ na ɗu halang, ɓoo ɓekiɗ ɗu ŋ keeñ ciŋ ɓoo."]},{"type":"verse","number":12,"content":["Ɗu ɓengɗi nga, e keeñ ciŋ ɗu ɓeng."]},{"type":"verse","number":13,"content":["Mi na woye na ɗu findi ɓoyi na woye na kuɓuuciŋ ɗe, tumaat findi ɓoo, rangsukaat baahiɗ !"]},{"type":"heading","content":["Saɓsukohaat na hoolaaɗi"]},{"type":"verse","number":14,"content":["Findi ɗoopaat ɓaahaaɗi minohɗi ɓaah tokiɗ sareet, kinaat nam ɓaah raanaah na kosaaɗiici. Ini yurah na ini yurahɗi ɓaah ye ? Wala siñaar na ñuus min ye ɓaah ?"]},{"type":"verse","number":15,"content":["Kiristaani na Seytaani",{"noteId":1},"min kerhiɗoh ŋ ye ? Wala kosiɗ na kosaaɗi min hunoh na ?"]},{"type":"verse","number":16,"content":["Kahan Kooh min ye kerhiɗoh na kooh ci nikaaɗiici ? Laam e ɓoo kahniŋ Koohi na pese findi a woyoha an :",{"text":"« Ŋ hey gene na ɓa,","poem":1},{"lineBreak":true},{"text":"ŋ tiindee ŋ harmban ɓa,","poem":1},{"lineBreak":true},{"text":"ŋ nik Koohiŋ ɓa,","poem":1},{"lineBreak":true},{"text":"ɓa nik cuuɓiŋ ngo. »","poem":1}]},{"type":"verse","number":17,"content":["Weɗ tah a woosa ne :",{"text":"« Pulaat ŋ ɗooƴ ɓa !","poem":1},{"lineBreak":true},{"text":"Saɓsukohaat na ɓa !","poem":1},{"lineBreak":true},{"text":"Kinaat laal in hoolaaɗi","poem":1},{"lineBreak":true},{"text":"te mi ŋ hey ɗu taambɗuke.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ŋ hey nike Baab nga ɗu,","poem":1},{"lineBreak":true},{"text":"ɗu nik kuɓuuciŋ ngo ! »","poem":1},"Heɗi, yi Heɗ-hatil woo ineem."]}],"footnotes":[{"noteId":1,"caller":"+","text":"Seytaani : ŋ Fiis ci ndii, gerek woo \"Beliyar\", wa ɓaah ŋ tiik ciŋ Seytaani.","reference":{"chapter":6,"verse":15}}]},"thisChapterLink":"/api/sav_wbt/2CO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sav_wbt/2CO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sav_wbt/2CO/5.json","previousChapterAudioLinks":{},"numberOfVerses":18}