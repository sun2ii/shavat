{"translation":{"id":"sav_wbt","name":"Saafi-Saafi","website":"https://ebible.org/Scriptures/details.php?id=sav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sav","licenseNotes":null,"shortName":"WBT","englishName":"Saafi-Saafi Bible","language":"sav","textDirection":"ltr","sha256":"f8e92f4acb4b69ea2a4dd0b9a29f92b0d707651b6f8a0cf5c1d9b2d233961151","availableFormats":["json"],"listOfBooksApiLink":"/api/sav_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":354,"totalNumberOfVerses":10672,"languageName":"Saafi-Saafi","languageEnglishName":"Saafi-Saafi"},"book":{"id":"EPH","translationId":"sav_wbt","name":"Ɓi Efes","commonName":"Ɓi Efes","title":"Fiisi Pool kaɓɗoh ɓi Efes","order":49,"numberOfChapters":6,"sha256":"5e091ed311324cfdc754a2933cf73cc668ef899a3cef46c0dd7892d9465ca022","firstChapterNumber":1,"firstChapterApiLink":"/api/sav_wbt/EPH/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/sav_wbt/EPH/6.json","totalNumberOfVerses":155},"chapter":{"number":1,"content":[{"type":"heading","content":["Kañɗohi"]},{"type":"verse","number":1,"content":["Mi yii kañiɗ ɗu, ɗu ɓi ɓo'-Kooh ci nik [ŋ Efes]. Mi yi Pool, ApootariŋKiristaani Yeesu ŋ ini Kooh waaɗ, mi yii fiis ɗu, ɗu ɓi hool wuu Kooh te ɗu carra oolku ŋ niki ɗu nik ŋ Yeesu Kiristaa."]},{"type":"verse","number":2,"content":["Kooh Baabiŋ ɓoo baahohaat ɗu, a on ɗu jam ; Yeesu Kiristaa Heɗi baahohaat ɗu, a on ɗu jam !"]},{"type":"heading","content":["Barke mitiɗ ŋ Kiristaani"]},{"type":"verse","number":3,"content":[{"text":"Eey Kooh,","poem":1},{"lineBreak":true},{"text":"yi nik Koohiŋ Heɗ ɓoo Yeesu Kiristaa,","poem":1},{"lineBreak":true},{"text":"a nammba nik Baabiŋ ɗe,","poem":1},{"lineBreak":true},{"text":"a yakɗaah ;","poem":1},{"lineBreak":true},{"text":"ŋ niki ɓoo nik ŋ Kiristaani,","poem":1},{"lineBreak":true},{"text":"a barke'ɗiɗ ɓoo ŋ Fuuɗsi Hoolohngaani,","poem":1},{"lineBreak":true},{"text":"barke nu nik ŋ ɗafki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ŋ Kiristaani, Kooh taniɗ ɓoo","poem":1},{"lineBreak":true},{"text":"bala Adina camban,","poem":1},{"lineBreak":true},{"text":"ne ɓoo hool wuu ce","poem":1},{"lineBreak":true},{"text":"te ɓoo raakuu sikka ŋ fikiice.","poem":1},{"lineBreak":true},{"text":"Ŋ waaɗohiŋ ɗe,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"a ambeen ne","poem":1},{"lineBreak":true},{"text":"a hey ɓoo tume kuɓuuciŋ ɗe","poem":1},{"lineBreak":true},{"text":"taamboh ŋ Yeesu Kiristaa.","poem":1},{"lineBreak":true},{"text":"Ineem weɗ a waaɗ ŋ baah kiŋ ɗe,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ne ɓoo ƴeek","poem":1},{"lineBreak":true},{"text":"yaki baahohi a baahoh ɓoo yak,","poem":1},{"lineBreak":true},{"text":"wi a on ɓoo","poem":1},{"lineBreak":true},{"text":"ŋ niki ɓoo nik ŋ Kiristaani,","poem":1},{"lineBreak":true},{"text":"yi a waaɗ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ŋ aami a aam ñif miŋ ɗe,","poem":1},{"lineBreak":true},{"text":"a pulɗohiɗ ɓoo ŋ baahaaɗi,","poem":1},{"lineBreak":true},{"text":"ɓoo ɗaasuuɗ bakaaɗ ci.","poem":1},{"lineBreak":true},{"text":"Weɗ yakkiŋ baahohiŋ Kooh,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"a eɗta ɓoo nga laayiɗ,","poem":1},{"lineBreak":true},{"text":"wa hunnda","poem":1},{"lineBreak":true},{"text":"na liiɓohaaɗ moɗiɗ nu nik","poem":1},{"lineBreak":true},{"text":"na kiñaañ nu nik.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"A inhiɗiɗ ɓoo","poem":1},{"lineBreak":true},{"text":"ini ɗasɗukiɗiŋ ini a waaɗee tum.","poem":1},{"lineBreak":true},{"text":"A tufkiɗeen","poem":1},{"lineBreak":true},{"text":"ŋ baah kiŋ ɗe ne,","poem":1},{"lineBreak":true},{"text":"a heya tume taamboh ŋ Kiristaani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ineem,","poem":1},{"lineBreak":true},{"text":"a hey wa tume ŋ jamanoonaŋ wa,","poem":1},{"lineBreak":true},{"text":"weɗ ne a ambsoh","poem":1},{"lineBreak":true},{"text":"in ci nik ŋ Eel ci na kehƴi jen,","poem":1},{"lineBreak":true},{"text":"a deg Kiristaani ŋ hafiŋ ca.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ɓaatta nga,","poem":1},{"lineBreak":true},{"text":"ŋ niki ɓoo nik nga ɗe,","poem":1},{"lineBreak":true},{"text":"ɓoo rahsiɗ ɓakiŋ ɓoo ŋ gapohi,","poem":1},{"lineBreak":true},{"text":"laam,","poem":1},{"lineBreak":true},{"text":"Kooh taniɗ ɓoo maañ,","poem":1},{"lineBreak":true},{"text":"wa nikee ini a tufkiɗee tum","poem":1},{"lineBreak":true},{"text":"sagu ne a waaɗee wa waaɗ.","poem":1},{"lineBreak":true},{"text":"Te in nu Kooh tufuk tum ɗah,","poem":1},{"lineBreak":true},{"text":"a tuma findi a waaɗoha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ɓoo ƴeekaat yaki a yak,","poem":1},{"lineBreak":true},{"text":"ɓoo,","poem":1},{"lineBreak":true},{"text":"ɓi koc ooluk Kiristaani.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɗu,","poem":1},{"lineBreak":true},{"text":"wa ɗu kerah woo kiŋ keeh ki,","poem":1},{"lineBreak":true},{"text":"Yegɗohiŋ Muciŋ ɗu,","poem":1},{"lineBreak":true},{"text":"ɗu nameen ɗe kos,","poem":1},{"lineBreak":true},{"text":"te ŋ niki ɗu nik nga ɗe,","poem":1},{"lineBreak":true},{"text":"Kooh eɗiɗ ɗu","poem":1},{"lineBreak":true},{"text":"Fuuɗsi Hoolohngaani gapohse","poem":1},{"lineBreak":true},{"text":"ne a nik ñaasi teeɓoh ne","poem":1},{"lineBreak":true},{"text":"ɗu wuu ce.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Fuuɗsi Hoolohngaani","poem":1},{"lineBreak":true},{"text":"a yi firnde","poem":1},{"lineBreak":true},{"text":"ne in ci Kooh gap cuuɓiŋ ɗe,","poem":1},{"lineBreak":true},{"text":"ɓoo hey ca rahse.","poem":1},{"lineBreak":true},{"text":"Ɓoo hey ca rahse","poem":1},{"lineBreak":true},{"text":"mbeha ɓoo pulɗassan ŋ miskiɗ.","poem":1},{"lineBreak":true},{"text":"Kon, ɓoo ƴeekaat yaki a yak.","poem":1}]},{"type":"heading","content":["Pool kiimɗiɗ ɓi Efes Kooh"]},{"type":"verse","number":15,"content":["Ineem weɗ tah po, wa ŋ kerah poyi kosi ɗu kos Yeesu Heɗi na waaɗi ɗu waaɗ ɓo'-Kooh ci jen,"]},{"type":"verse","number":16,"content":["ŋ gen corkiɗ Kooh ŋ ini kaɗ nga ɗu. Ŋ ɓaahndohee ɗu ŋ kiim ci mi na kiimee ɗe."]},{"type":"verse","number":17,"content":["Ini mi na kiimɗee ɗu, weɗ ne Koohiŋ Heɗ ɓoo Yeesu Kiristaa, Baabi raak kiyak ki, on ɗu Fuuɗsi Hoolohngaani yi onan ɗu liiɓohaaɗ moɗiɗ te a teeɓ ɗu ya ɓa Kooh po ɗu inah ɗe keeh-keeh."]},{"type":"verse","number":18,"content":["A ñiinɗaat has ciŋ ɗu na keeñ ciŋ ɗu, ne ɗu inah yaakaari a on ɗu wa a ɓeeɗuk ɗu, ɗu nam inah findi gapohiŋ ɗe yakoh ŋ ɓo'-Kooh ci"]},{"type":"verse","number":19,"content":["na findi hatiliŋ ɗe yakoh ŋ ɗooƴ ɓa, maanaam ŋ ɗooƴ ɓoo ɓi kos. Weɗ hatili yakohngaani"]},{"type":"verse","number":20,"content":["Kooh hultiɗoh Kiristaani, weɗ hatili a nam ɗe ɓoofɗoh ŋ yaah ñaahmiŋ ɗe, ŋ ɗafka."]},{"type":"verse","number":21,"content":["Kiristaani ɓoofɗuuɗ ŋ ɗafuk ki'adug nu nik, ŋ ɗafuk kikilifa nu nik, ŋ min-min nu nik, ŋ hatil nu nik na in nu raak tiik ɗah, ngaŋ adinaanii dong haa, waaye na adinaani na haye."]},{"type":"verse","number":22,"content":["Kooh on Kiristaani ne a adgoh in ci jen, a degga ɗe ŋ ɗafuk in ci jen, a onnda Janguuni ɗe, ne a nik hafiŋ Janguuni."]},{"type":"verse","number":23,"content":["Janguuni weɗ faaniŋ Kiristaani ; ŋ ɗooƴ Janguuni, a yii nga keeh-keeh, te a yi mitiɗ in ci jen."]}],"footnotes":[]},"thisChapterLink":"/api/sav_wbt/EPH/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sav_wbt/EPH/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sav_wbt/GAL/6.json","previousChapterAudioLinks":{},"numberOfVerses":23}