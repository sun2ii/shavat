{"translation":{"id":"sav_wbt","name":"Saafi-Saafi","website":"https://ebible.org/Scriptures/details.php?id=sav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sav","licenseNotes":null,"shortName":"WBT","englishName":"Saafi-Saafi Bible","language":"sav","textDirection":"ltr","sha256":"f8e92f4acb4b69ea2a4dd0b9a29f92b0d707651b6f8a0cf5c1d9b2d233961151","availableFormats":["json"],"listOfBooksApiLink":"/api/sav_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":354,"totalNumberOfVerses":10672,"languageName":"Saafi-Saafi","languageEnglishName":"Saafi-Saafi"},"book":{"id":"EXO","translationId":"sav_wbt","name":"Pula","commonName":"Pula","title":"Pula Teerndi kanakɗohiini ŋ Tawreet","order":2,"numberOfChapters":40,"sha256":"4ffbeb6ebec91e5b6eb88b3d2d7b027d6e5a701a5beee6739b57f80a4a259a46","firstChapterNumber":1,"firstChapterApiLink":"/api/sav_wbt/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/sav_wbt/EXO/40.json","totalNumberOfVerses":1191},"chapter":{"number":15,"content":[{"type":"heading","content":["Israayel ca ƴeekiɗ Kooh"]},{"type":"verse","number":1,"content":["Weɗi Musaa na Israayel ca ferɗoh Nikiɗi ƴeekii :",{"lineBreak":true},{"text":"« Nikiɗi ƴeekaah ƴeeku nee !","poem":1},{"text":"Ŋ hey ɗe ƴeeke.","poem":2},{"text":"Ndamiŋ ɗe teeɓohiɗ nee","poem":1},{"text":"A yi min ee !","poem":2},{"text":"A kooɗkiɗ panis na rapoh panis,","poem":1},{"text":"A julla ŋ cookma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nikiɗi a yi hatiliŋ ngo nee !","poem":1},{"text":"A yi Heɗ ƴeekiŋ ngo.","poem":2},{"text":"A yi hirip po nee !","poem":1},{"text":"Ŋ hey ɗe ƴeeke.","poem":2},{"text":"Nikiɗi a yi Koohiŋ ngo nee !","poem":1},{"text":"Ŋ hey ɗe ɗaape.","poem":2},{"text":"A yi Koohiŋ baabiŋ ngo nee !","poem":1},{"text":"Ŋ hey woye yakkiŋ ɗe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nikiɗi jalmba ngaŋ hiñoh !","poem":1},{"text":"Nikiɗi weɗ tiikiŋ ɗe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"A juliɗ wotiir caŋ Firawna","poem":1},{"text":"Na hiñohoh caŋ ɗe.","poem":2},{"text":"Ɓa adgoh ɓa sah muuhiɗ nga ee","poem":1},{"text":"Ŋ Cookmaŋ-Hapeel-ca.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ginaah ca ulla ɓa nee","poem":1},{"text":"Ngaŋ ɗooƴ cookma.","poem":2},{"text":"Ɓa diigiɗ nga haa ne atoh","poem":1},{"text":"Ŋ dungaŋ cookma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nikiɗi ! Ñaahmiŋ ɗa nee !","poem":1},{"text":"Eey hatiliŋ wa !","poem":2},{"text":"Nikiɗi ! Ñaahmiŋ ɗa nee !","poem":1},{"text":"Weɗ ɗumb ɓi sang ɗa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaki fu yak Nikiɗi nee","poem":1},{"text":"Fu saahiɗ ɓi sang ɗa.","poem":2},{"text":"Fu fuuɗsiɗ ayrukiŋ ɗa nee !","poem":1},{"text":"Eey dohɗiŋ wa !","poem":2},{"text":"Wa hoomɗiɗ ɓa findi mbaang ee !","poem":1},{"text":"Eey dohɗiŋ wa !","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nikiɗi ! Iikiŋ ɗa nee","poem":1},{"text":"Nangɗohiɗ masuɓ ca.","poem":2},{"text":"Ginaah ca tufkiɗ saɗ ee","poem":1},{"text":"Findi miir ee !","poem":2},{"text":"Masma sah namiɗ ndeng ee","poem":1},{"text":"Waŋ dungaŋ cookma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sangiɗa woyeeɗa nee","poem":1},{"text":"Ŋ hey ɓa taambɗe.","poem":2},{"text":"Sangiɗa woyeeɗa nee","poem":1},{"text":"Ŋ hey ɓa ambe.","poem":2},{"text":"Sangiɗa woyeeɗa nee","poem":1},{"text":"Ŋ paysoh in ciŋ ɓa.","poem":2},{"text":"Sangiɗa woyeeɗa nee","poem":1},{"text":"Ŋ raak ini ŋ waaɗ jen.","poem":2},{"text":"Sangiɗa woyeeɗa nee","poem":1},{"text":"Ŋ fuur ndangiŋ ngo.","poem":2},{"text":"Sangiɗa woyeeɗa nee","poem":1},{"text":"Ŋ hey ɓa sooƴɗe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nikiɗi fu fuuɗissa rek ee,","poem":1},{"text":"Cookma ulla ɓa.","poem":2},{"text":"Ɓa ɗiigga nga haa ne beteeh","poem":1},{"text":"Ŋ ɗooƴ-ɗooƴ cookma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"A yinde kooh mand na ɗa nee","poem":1},{"text":"Ŋ kooh caŋ ɓooɓa ?","poem":2},{"text":"A yinde na siñaarɗe sagu hool ?","poem":1},{"text":"A Nikiɗi nee !","poem":2},{"text":"A yinde Kooh neƴƴohu nee ?","poem":1},{"text":"A Nikiɗi nee !","poem":2},{"text":"Po a carra ƴeeku nee ?","poem":1},{"text":"A Nikiɗi nee !","poem":2},{"text":"A tumee in feyohiɗ ee","poem":1},{"text":"Findiifu nee ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nikiɗi fu raɗis ñaahmiŋ ɗa nee ;","poem":1},{"text":"Kehƴi onnda ɓa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nikiɗi waaɗohaaɗiŋ ɗa nee","poem":1},{"text":"Wa na ɓoƴsukeeɗi.","poem":2},{"text":"Fu yurhiɗiɗ cuuɓiŋ ɗa fu tos","poem":1},{"text":"Na hatiliŋ ɗa nee !","poem":2},{"text":"Fu yii ɓay ɓa Nikiɗi nee","poem":1},{"text":"Ɗiskaŋ ɗa hoolɗa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Cuuɓ ci kerhiɗa nee ;","poem":1},{"text":"Ɓii saakɗoheeɗa.","poem":2},{"text":"Filistiici neƴƴohiɗ lool ee,","poem":1},{"text":"Ɓii ngaŋ tiis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kilifaacaŋ Edom Nikiɗi nee","poem":1},{"text":"Iiƴiɗ dic ee.","poem":2},{"text":"Te ɓa adgoh Mowab","poem":1},{"text":"Ɓii kot-kotɗeeɗa.","poem":2},{"text":"Ɓi Kanaan jen Nikiɗi nee","poem":1},{"text":"Jaahɗiɗ lool ee.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Neƴƴoh na tiit Nikiɗi nee","poem":1},{"text":"Aasiɗ ɓa jen ee !","poem":2},{"text":"Ɓa hot hatiliŋ yaahiŋ ɗa nee ;","poem":1},{"text":"Ɓa minɗi yoond.","poem":2},{"text":"Ɓa mandiɗ nga haa ne atoh.","poem":1},{"text":"Eey Nikiɗi nee !","poem":2},{"text":"Po cuuɓiŋ ɗa wii taamb ee.","poem":1},{"text":"Eey Nikiɗi nee !","poem":2},{"text":"Po cuuɓi fu tos wii taamb ee.","poem":1},{"text":"Eey Nikiɗi nee !","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Fu hey ɓa genɗe Nikiɗi nee","poem":1},{"text":"Ŋ tangoora fu raakoot,","poem":2},{"text":"Ɗiska fu haɓiɗ kahan fu nee !","poem":1},{"text":"Eey Nikiɗi nee !","poem":2},{"text":"Ngaŋ ɗiskaŋ ɗa hoolɗa nee !","poem":1},{"text":"Eey Nikiɗi nee !","poem":2},{"text":"Wa fu haɓiɗ na yaah ciŋ ɗa nee,","poem":1},{"text":"Fu yi Heɗ ɓoo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nikiɗi a yi nikan buur ee","poem":1},{"text":"Po faw ee ! »","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":["Ɗaa, panis ca na wotiir caŋ Firawna, na ɓooɓa rapee ca aaseen ŋ cookma. Nikiɗi dokinnda masma ŋ ɗafuk ɓa. Israayel ci taammba ŋ merhey ma suyɗa, ŋ ɗooƴ cookma."]},{"type":"verse","number":20,"content":["Maryam, woosuuɗa ɓitɓa, taambɗoh Aaruna, ɓayya haan. Ɓitiɓ caŋ Israayel jen ñaakiɗta ɗe, ɓa tipeeɗa, ɓa mbeceeɗa."]},{"type":"verse","number":21,"content":["Maryam dokkissa ŋ ƴeeka an :",{"text":"« Nikiɗi ƴeekaah ƴeeku nee","poem":1},{"lineBreak":true},{"text":"Ŋ hey ɗe ƴeeke","poem":1},{"lineBreak":true},{"text":"Ndamiŋ ɗe teeɓohiɗ nee","poem":1},{"lineBreak":true},{"text":"A yi min ee","poem":1},{"lineBreak":true},{"text":"A kooɗkiɗ panis na rapoh panis","poem":1},{"lineBreak":true},{"text":"A julla ŋ cookma. »","poem":1}]},{"type":"heading","content":["Masmaŋ Mara"]},{"type":"verse","number":22,"content":["Musaa adgiɗta Israayel ca, ɓa pulohha Cookmaŋ-Hapeel-ca, ɓa yurahha kehƴa hulangaŋ Suur. Ɓa tiinnda neeh kaahay, ɓa hotɗi masmi ɓa anan."]},{"type":"verse","number":23,"content":["Wa ɓa kaɗ po ɓa reesa ɗiska na woyse Mara, masuɓ raakeen nga, waaye ɓa mineeɗaa an, wa nikee aayiɗ hak weɗ tah ɗiska teekuusa Mara (aay)."]},{"type":"verse","number":24,"content":["Ŋ ineem, mboolnda lahtukeeɗa ŋ Musaa, ɓa woosa ne : « Ɓoo na hee ye ane ? »"]},{"type":"verse","number":25,"content":["Musaa kiimmba Nikiɗi na leehuk. Nikiɗi teeɓpa ɗe ndooɗ, a ɓekkaa ŋ masma, wa hannda min anu. Ŋ ndaam, Nikiɗi eɗta Israayel ca nakoh ciŋ ɗe na haɓɗaah. A nammba ɓa markisuk."]},{"type":"verse","number":26,"content":["A woosa ɓa ne : « Ɗu kerah keeh-keeh woo kiŋ ngo, mi yi Nikiɗi Koohiŋ ɗu, te ɗu haɓɗee in ci ŋ amb ne ceɗ yurah ɗah, ɗu ɓekoh nof in ci ŋ nakoh, te ɗu haɓiɗ haɓɗaah ci jen ɗah, ŋ heyɗi yipkiɗe kosaay nga ɗu findi ŋ tumoh na ɓi Misra. Laam ñam Nikiɗi yi na wirɗee ɗu. »"]},{"type":"verse","number":27,"content":["Israayel ca kaɗeeɗa po ɓa reesa Elim, ɓa raakka cul masuɓ ndaŋkiyaah na kanak (12) nga, na tas tandarma ndaŋkiyaah-yasna-kanak (70), ɓa dalla nga, ŋ sero masma."]}],"footnotes":[]},"thisChapterLink":"/api/sav_wbt/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sav_wbt/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sav_wbt/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}