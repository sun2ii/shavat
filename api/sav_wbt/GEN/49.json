{"translation":{"id":"sav_wbt","name":"Saafi-Saafi","website":"https://ebible.org/Scriptures/details.php?id=sav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sav","licenseNotes":null,"shortName":"WBT","englishName":"Saafi-Saafi Bible","language":"sav","textDirection":"ltr","sha256":"f8e92f4acb4b69ea2a4dd0b9a29f92b0d707651b6f8a0cf5c1d9b2d233961151","availableFormats":["json"],"listOfBooksApiLink":"/api/sav_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":354,"totalNumberOfVerses":10672,"languageName":"Saafi-Saafi","languageEnglishName":"Saafi-Saafi"},"book":{"id":"GEN","translationId":"sav_wbt","name":"Camba","commonName":"Camba","title":"Camba Teerndi koc ŋ Tawreet","order":1,"numberOfChapters":50,"sha256":"700670e4f185fd2f58d8ed209764be963359a232f331f18a0ae6b51aae6d8448","firstChapterNumber":1,"firstChapterApiLink":"/api/sav_wbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/sav_wbt/GEN/50.json","totalNumberOfVerses":1524},"chapter":{"number":49,"content":[{"type":"heading","content":["Yaŋhooɓa barke'ɗiɗ kuɓuuciŋ ɗe."]},{"type":"verse","number":1,"content":["Wa Yaŋhooɓa ƴut barke'iɗ kuɓuuciŋ Yuusufa, a nammba ɓeeɗuk kuɓuuciŋ ɗe, a woosa ɓa ne :",{"lineBreak":true},{"text":"« Hayaat, ŋ woo ɗu kimiŋ ɗu.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Nangɗukohaat, ɗu sikɗuk,","poem":2},{"lineBreak":true},{"text":"ɗu ɓi kuɓuuciŋ Yaŋhooɓa ;","poem":2},{"lineBreak":true},{"text":"sikɗukaat to mi yi Israayel,","poem":2},{"lineBreak":true},{"text":"baab ɗu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ruben, saawiŋ ngo,","poem":1},{"text":"a fu teeɓoh ne ŋ ƴaar,","poem":2},{"lineBreak":true},{"text":"raak ko na hatil.","poem":2},{"lineBreak":true},{"text":"A fu uupiɗ taambɗoh ciŋ ɗa","poem":2},{"lineBreak":true},{"text":"cir na hatil.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fu mand na masuɓ baliɗ,","poem":2},{"lineBreak":true},{"text":"waaye fu mirndohanɗi adug,","poem":2},{"lineBreak":true},{"text":"fu mbetiɗ ciriŋ ɗa,","poem":2},{"lineBreak":true},{"text":"wa fu sot fiƴaangiŋ baab ɗu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Simeyong na Lewi yino.","poem":1},{"text":"Ɓeɗ na hune ne ɓa tum aƴaarkoha.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Muk ! Ŋ kanaat hun na ɓa","poem":2},{"lineBreak":true},{"text":"ŋ ini ɓaa waakohe","poem":2},{"lineBreak":true},{"text":"te ŋ waaɗɗi maasoh coh ciŋ ɓa.","poem":2},{"lineBreak":true},{"text":"Ŋ ayrukiŋ ɓa,","poem":2},{"lineBreak":true},{"text":"ɓa apiɗ ɓi ɓo' ;","poem":2},{"lineBreak":true},{"text":"te ŋ ini neɓ ɓa,","poem":2},{"lineBreak":true},{"text":"ɓa nguɗiɗ sir kot naar inoh.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wa alku'aat,","poem":2},{"lineBreak":true},{"text":"ayrukohaaɗiŋ ɓa","poem":2},{"lineBreak":true},{"text":"wi hun na hatil weem,","poem":2},{"lineBreak":true},{"text":"na aay-keeñiŋ ɓa","poem":2},{"lineBreak":true},{"text":"wi hunɗi na yeeɓuk.","poem":2},{"lineBreak":true},{"text":"Ŋ hey ɓa paysohe ŋ kahan Yaŋhooɓa","poem":2},{"lineBreak":true},{"text":"ŋ pasaroh ɓa ŋ Israayel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yudaa,","poem":1},{"text":"a fu taambɗoh ciŋ ɗa ƴeekan","poem":2},{"lineBreak":true},{"text":"te fu hey tahe ɓi sang ɗa hiir.","poem":2},{"lineBreak":true},{"text":"Taambɗoh ciŋ ɗa","poem":2},{"lineBreak":true},{"text":"hey ɗa ƴekɗe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yudaa kuɓkiŋ ngo,","poem":2},{"lineBreak":true},{"text":"fu gaynde cociɗ,","poem":2},{"lineBreak":true},{"text":"gayndeeni puloh ñama doɓ,","poem":2},{"lineBreak":true},{"text":"faanukka,","poem":2},{"lineBreak":true},{"text":"ya ɓa kaañ ɗe kurkiɗ ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Salmaari na yilfohse,","poem":2},{"lineBreak":true},{"text":"saɓsukohanɗi","poem":2},{"lineBreak":true},{"text":"na yaah ciŋ ɓi kahan Yudaa.","poem":2},{"lineBreak":true},{"text":"Te inhisoha buur","poem":2},{"lineBreak":true},{"text":"kurkanɗi","poem":2},{"lineBreak":true},{"text":"ŋ harmban kot ciŋ ɓa","poem":2},{"lineBreak":true},{"text":"po mbaɗna heɗ wa keeh-keeh hayan.","poem":2},{"lineBreak":true},{"text":"A yi fu inah ne,","poem":2},{"lineBreak":true},{"text":"cuuɓ ci jen hey ɗe kerhiɗe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"A hey laaye tas reseñ po,","poem":2},{"lineBreak":true},{"text":"a layee mbaamiŋ ɗe nga ca","poem":2},{"lineBreak":true},{"text":"te cumbri","poem":2},{"lineBreak":true},{"text":"toksan ŋ ci uup baah.","poem":2},{"lineBreak":true},{"text":"A naawohan kulɓaakiŋ ɗe biiñ","poem":2},{"lineBreak":true},{"text":"na lipiŋ ɗe ñif reseñ.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Biiñ laayiɗ","poem":2},{"lineBreak":true},{"text":"hey ruumndiɗe has ciŋ ɗe","poem":2},{"lineBreak":true},{"text":"te miis laayiɗ","poem":2},{"lineBreak":true},{"text":"hey yaanwiɗe sis ciŋ ɗe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sabuloon,","poem":1},{"text":"a genan sereendiŋ cookmi,","poem":2},{"lineBreak":true},{"text":"ɗiski gaal ci na serse.","poem":2},{"lineBreak":true},{"text":"Ini amboh ndeem po Sidoon,","poem":2},{"lineBreak":true},{"text":"wa ɓaahan ŋ kehƴiŋ ɗe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Issaakar mbaam ngooŋka,","poem":1},{"text":"a na ɗasɗuke ŋ ɗisik","poem":2},{"lineBreak":true},{"text":"ne a iɗsiɗuk.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A hotiɗ ne","poem":2},{"lineBreak":true},{"text":"ɗiski a nik baahiɗ iɗsiɗkoha","poem":2},{"lineBreak":true},{"text":"te kur ki neɓiɗ.","poem":2},{"lineBreak":true},{"text":"A ƴuugiɗ ne a sifuk,","poem":2},{"lineBreak":true},{"text":"a yi waɗuk pangki miskiɗiŋ ñaam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Daan hey raake cuuɓi a adgohan","poem":1},{"text":"findi cuuɓ ciŋ Israayel cinooci.","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Daan mandan na laɓriifi raɗuk ŋ waas,","poem":2},{"lineBreak":true},{"text":"hirñi duluuruk ŋ sero waas ;","poem":2},{"lineBreak":true},{"text":"laɓriif na ɗoɓe panis ŋ kot,","poem":2},{"lineBreak":true},{"text":"ƴaari rap ɗe keen kaƴaarsukiɗ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Eey, Nikiɗi,","poem":1},{"text":"ŋ oolkoh ɗa ne fu naaf fo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gaad,","poem":1},{"text":"ɓi ɓo' aƴaarkiɗ ɓeɗ keenan ɗe","poem":2},{"lineBreak":true},{"text":"waaye,","poem":2},{"lineBreak":true},{"text":"a hey ɓa wiindsuke","poem":2},{"lineBreak":true},{"text":"po a ngek ɓa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Aser,","poem":1},{"text":"kehƴiŋ ɗe hey laaɓe","poem":2},{"lineBreak":true},{"text":"te weɗ eɗohan kañam ci,","poem":2},{"lineBreak":true},{"text":"ci min kaɗ ŋ buur.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Naftaali,","poem":1},{"text":"a ngaayi raak haf ce,","poem":2},{"lineBreak":true},{"text":"yi na raake buul moɗiɗ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yuusufa,","poem":1},{"text":"a naak kidig rimiɗ ;","poem":2},{"lineBreak":true},{"text":"kidgi paar ŋ sero masuɓ","poem":2},{"lineBreak":true},{"text":"te naak ciŋ wa cootukka ɗingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ɓi weesoh ɓis keeniɗ ɗe,","poem":2},{"lineBreak":true},{"text":"ɓa weessa ɗe,","poem":2},{"lineBreak":true},{"text":"ɓa tummba ɗe sanguuɗ ;","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Waaye a ris ambiɗ haliini,","poem":2},{"lineBreak":true},{"text":"amb moɗoɗ","poem":2},{"lineBreak":true},{"text":"te yaah ciŋ ɗe neɓiɗ","poem":2},{"lineBreak":true},{"text":"sagu hatiliŋ Koohiŋ Yaŋhooɓa,","poem":2},{"lineBreak":true},{"text":"Kooh yi Niiɗohi,","poem":2},{"lineBreak":true},{"text":"a nammba nik Atoh fiŋ Israayel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Koohiŋ baab ɗu hirpaat ɗa,","poem":2},{"lineBreak":true},{"text":"Koohi Min barke'ɗaat ɗa,","poem":2},{"lineBreak":true},{"text":"a on ɗa toɓi na pulohe ɗafki,","poem":2},{"lineBreak":true},{"text":"na masmi na pulohe ŋ kehƴi,","poem":2},{"lineBreak":true},{"text":"a on ɗa,","poem":2},{"lineBreak":true},{"text":"ɓitiɓ ci na ɗoopaat ci nik ɓasloh.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Barkeeniŋ baab ɗu","poem":2},{"lineBreak":true},{"text":"weɗi uup in ci baahiɗ ciŋ tangooci ɗeɓgaan","poem":2},{"noteId":34},{"text":";","poem":2},{"lineBreak":true},{"text":"wa cootkiɗ raak-raak ciŋ tangooci maañohngaan ci.","poem":2},{"lineBreak":true},{"text":"Barkeeneem ruhsaat nga ɗa Yuusufa,","poem":2},{"lineBreak":true},{"text":"fu yi kilifaaniŋ taambɗoh ciŋ ɗa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Benyaamin a ɓaakoɓ saahiɗ,","poem":1},{"text":"a na ɓaaɓe ñam ini a ap,","poem":2},{"lineBreak":true},{"text":"niin reesa ɗah, a paysoh ini tas. »","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":["Woo ceem ceɗ baab ɓa barke'ɗoh ɓa, yaa nu nga ɗah, a eɗta ɗa wa hun na ɗa. Ɓeem, ɓeɗ fer cuuɓ ci ndaŋkiyaah na kanak (12) ciŋ Israayel."]},{"type":"heading","content":["Yaŋhooɓa kurkiɗ nga."]},{"type":"verse","number":29,"content":["Wa a ƴut barke'iɗ kuɓuuciŋ ɗe, Yaŋhooɓa woosa ɓa ne : « Haadiŋ ngo Jaanim usisɗi, ŋ kuruk nga ɗah, uumbaat to ŋ sero caacuuciŋ ngo, ŋ huraŋ atoh fa nik ŋ ɗooƴ yohon Efron yi ɓaahee ŋ cuuɓiŋ Hit ci,"]},{"type":"verse","number":30,"content":["ngaŋ Makpela ŋ sero Mamre, ŋ kur kaŋ Kanaan. Yohneem weɗi Ibrahiima romee ŋ Efron ne a tuma ruy-ruy caŋ ɗe."]},{"type":"verse","number":31,"content":["A uumbu nga na ɓitiice Saarata, Isaahha nam uumbu nga na ɓitiice Rebeka te ŋ namis uumb Leya nga."]},{"type":"verse","number":32,"content":["Yohna na huraŋ atoh fa nik nga romohu ŋ cuuɓiŋ Hit ci. »"]},{"type":"verse","number":33,"content":["Wa Yaŋhooɓa ƴut nak kuɓuuciŋ ɗe in ceem, a faankissa, weɗ a nguɗoh, a haadda Jaanim."]}],"footnotes":[{"noteId":34,"caller":"+","text":"Raakiɗ fiis, ŋ fiis ci ɗeɓgaan, ci woo ne : \"Barkeeni ŋ eɗ ɗu, weɗ uup wi caac ca eɗoh\".","reference":{"chapter":49,"verse":26}}]},"thisChapterLink":"/api/sav_wbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sav_wbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sav_wbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}