{"translation":{"id":"sav_wbt","name":"Saafi-Saafi","website":"https://ebible.org/Scriptures/details.php?id=sav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sav","licenseNotes":null,"shortName":"WBT","englishName":"Saafi-Saafi Bible","language":"sav","textDirection":"ltr","sha256":"f8e92f4acb4b69ea2a4dd0b9a29f92b0d707651b6f8a0cf5c1d9b2d233961151","availableFormats":["json"],"listOfBooksApiLink":"/api/sav_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":354,"totalNumberOfVerses":10672,"languageName":"Saafi-Saafi","languageEnglishName":"Saafi-Saafi"},"book":{"id":"JON","translationId":"sav_wbt","name":"Yunus","commonName":"Yunus","title":"Yunus","order":32,"numberOfChapters":4,"sha256":"27b5a1a7eb863b4288f67fbfa63a188230a02278a7782186b6ea0e1761703131","firstChapterNumber":1,"firstChapterApiLink":"/api/sav_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/sav_wbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Kiimaŋ Yunus ŋ rookaŋ cuurnda"]},{"type":"verse","number":1,"content":["Yunus, ŋ tasaŋ ɗe ŋ ɗooƴ cookma, Nikiɗi kerhiɗ ɗe. A tummba po cuurund duu'in pulla a onnda ɗe. Yunus nikka ngaŋ rookaŋ cuurnda neeh kaahay na wek kaahay."]},{"type":"verse","number":2,"content":["Ngaŋ ɗooƴ rookaŋ cuurnda a kiimmba Nikiɗi, Koohiŋ ɗe."]},{"type":"verse","number":3,"content":["A woosa ne :",{"text":"« Wa ŋ nikoh ngaŋ mbugala, ŋ looƴkiɗ po ngaŋ Nikiɗi, te a tahsiɗ to ;","poem":1},{"lineBreak":true},{"text":"ŋ ɗooƴ oon caŋ Jaanim, ŋ leehkiɗ,","poem":1},{"lineBreak":true},{"text":"fu kerhiɗ hoosooriŋ ngo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fu juleen ndo ngaŋ nooɗ-nooɗa, ŋ ɗooƴ cookma,","poem":1},{"lineBreak":true},{"text":"te masma wileen ndo.","poem":1},{"lineBreak":true},{"text":"Ginaah caŋ ɗa jen na wal-wal ca mburfuñeen ndo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mi nak ŋ woyee ne :","poem":1},{"lineBreak":true},{"text":"“ Fu aañiɗ to, fu waaɗisɗi so deg has. ”","poem":1},{"lineBreak":true},{"text":"Hondohɗi ŋ ambiɗ ne ŋ hey hotisse Kahnaŋ ɗa Hoolɗa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Masuɓ ca goɗeen mbooh kiŋ ngo,","poem":1},{"lineBreak":true},{"text":"nooɗaŋ masma wileen ndo.","poem":1},{"lineBreak":true},{"text":"Paangi-cookom duluurkeen hafiŋ ngo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ngaŋ tasaŋ tangooca ŋ ruhseen,","poem":1},{"lineBreak":true},{"text":"ŋ rangseen po faw ngaŋ kur caŋ fiɗaaf ca, ŋ ɓak ɓooɓa ɗeɓgaan.","poem":1},{"lineBreak":true},{"text":"Waaye fu tumiɗ po kipes kiŋ ngo pulla ruy-ruya,","poem":1},{"lineBreak":true},{"text":"Nikiɗi, Koohiŋ ngo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wa maa waaɗe ñak kiñin,","poem":1},{"lineBreak":true},{"text":"ŋ haltuk ɗa, Nikiɗi","poem":1},{"lineBreak":true},{"text":"te fu kerhiɗ kiimaŋ ngo","poem":1},{"lineBreak":true},{"text":"ŋ Kahnaŋ ɗa Hoolɗa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɓi na taambkohe ɓonaah ci,","poem":1},{"lineBreak":true},{"text":"ɓa na fañe muuɗiŋ ɓa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mi, faan ndo, ngaŋ ɓi hooso jangtuk, ŋ hey ɗa seeƴke ɓi hoosuuɗ.","poem":1},{"lineBreak":true},{"text":"Ini ŋ giñ, ŋ heya reytine.","poem":1},{"lineBreak":true},{"text":"A Nikiɗi naafohi. »","poem":1}]},{"type":"verse","number":11,"content":["Nikiɗi woossa cuurnda, cuurnda hukka Yunus ŋ sereendaŋ cookma."]}],"footnotes":[]},"thisChapterLink":"/api/sav_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sav_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sav_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}