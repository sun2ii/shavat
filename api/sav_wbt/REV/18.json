{"translation":{"id":"sav_wbt","name":"Saafi-Saafi","website":"https://ebible.org/Scriptures/details.php?id=sav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sav","licenseNotes":null,"shortName":"WBT","englishName":"Saafi-Saafi Bible","language":"sav","textDirection":"ltr","sha256":"f8e92f4acb4b69ea2a4dd0b9a29f92b0d707651b6f8a0cf5c1d9b2d233961151","availableFormats":["json"],"listOfBooksApiLink":"/api/sav_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":354,"totalNumberOfVerses":10672,"languageName":"Saafi-Saafi","languageEnglishName":"Saafi-Saafi"},"book":{"id":"REV","translationId":"sav_wbt","name":"Teeɓ ki","commonName":"Teeɓ ki","title":"Ini Yeesu teeɓ Saaŋ","order":66,"numberOfChapters":22,"sha256":"aad274f7ed0686346897c6d40dec61a29391780007bca0fce033858c2c128b7e","firstChapterNumber":1,"firstChapterApiLink":"/api/sav_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/sav_wbt/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["Keeniŋ Babilon"]},{"type":"verse","number":1,"content":["Ŋ finho ineem, ŋ hotta malaaka wiiriis ruhsoheeɗa ŋ Eel ci. A raakee hatil keeh-keeh, yaki a yak siñaarɗeeɗa ŋ kehƴi jen."]},{"type":"verse","number":2,"content":["A leehkeeɗa ŋ ɗafka an :",{"text":"« Wa keeniɗ ! Wa keeniɗ !","poem":1},{"lineBreak":true},{"text":"Babilon kur-taahi yakki keeniɗ !","poem":1},{"lineBreak":true},{"text":"Wa genohaaniŋ jiiniici kotii,","poem":1},{"lineBreak":true},{"text":"ɗiski ca ɗasɗuk na hoolaaɗiiki ca hoolaaɗi.","poem":1},{"lineBreak":true},{"text":"Wa genohaaniŋ sel ci hoolɗi ñamu","poem":1},{"lineBreak":true},{"text":"[na ɗoopaat ci hoolɗi ñamu","poem":1},{"noteId":6},{"text":"]","poem":1},{"lineBreak":true},{"text":"te ca siɓuusa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Laam weɗ meeɗ laariɗ kur ci jen","poem":1},{"lineBreak":true},{"text":"na biiñiŋ wa, weɗ faankohiŋ wa mbalayi.","poem":1},{"lineBreak":true},{"text":"Buur ciŋ Adina faankiɗa,","poem":1},{"lineBreak":true},{"text":"te toonoh ci kooɗohiɗ raak-raak nga","poem":1},{"lineBreak":true},{"text":"sagu waaɗa wa waaɗee","poem":1},{"lineBreak":true},{"text":"toon ciŋ ɓa moɗiɗ ci. »","poem":1}]},{"type":"verse","number":4,"content":["Ŋ kerhissa hooso wiiriis puloh Eel ci woyeeɗa ne :",{"text":"« Pulaat nga, ɓooɓiŋ ngo !","poem":1},{"lineBreak":true},{"text":"Ɗu ɓaahuu naa bakaaɗ ciŋ wa,","poem":1},{"lineBreak":true},{"text":"ɗu ɓaahuu ŋ naamooci rahsana.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Laam bakaaɗ ciŋ wa","poem":1},{"lineBreak":true},{"text":"degsukohiɗ po ŋ Eel ci","poem":1},{"lineBreak":true},{"text":"te Kooh alɗi tumohaaɗ ciŋ wa sepƴiɗ ci.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tumaata","poem":1},{"lineBreak":true},{"text":"findi wa tumee ɓinooɓi,","poem":1},{"lineBreak":true},{"text":"wirndaata waas kanak","poem":1},{"lineBreak":true},{"text":"ini wa tum.","poem":1},{"lineBreak":true},{"text":"Yiifɗaata ŋ kaasiŋ wa","poem":1},{"lineBreak":true},{"text":"anaahi uup aay waas kanak","poem":1},{"lineBreak":true},{"text":"anaahi wa anɗukohee ɓinooɓi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tumaata miskiɗ, kur keem nikaat ŋ ruy","poem":1},{"lineBreak":true},{"text":"po ruyiŋ wa hend na yaksiɗkiŋ wa","poem":1},{"lineBreak":true},{"text":"na waaɗi wa waaɗee in ci moɗiɗ ci.","poem":1},{"lineBreak":true},{"text":"Kur keem woo ŋ haf wa ne :","poem":1},{"lineBreak":true},{"text":"“ Ŋ ɓoofiɗ findi buur ɓitiɓ,","poem":1},{"lineBreak":true},{"text":"ŋ ɓitɓi ƴaar ce kaan haa","poem":1},{"lineBreak":true},{"text":"te ŋ moosanɗi rooy ƴaar. ”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sagu ineem,","poem":1},{"lineBreak":true},{"text":"naamooci wa ɗaakɗu","poem":1},{"lineBreak":true},{"text":"hey keene nga ŋ neeh yino dong :","poem":1},{"lineBreak":true},{"text":"Ca nikka kakaan na rooy na aɗ,","poem":1},{"lineBreak":true},{"text":"te yongkaah hey wa ɗumbe.","poem":1},{"lineBreak":true},{"text":"Laam Kooh Heɗ ɓoo","poem":1},{"lineBreak":true},{"text":"yi attee wa","poem":1},{"lineBreak":true},{"text":"raakiɗ hatil. »","poem":1}]},{"type":"verse","number":9,"content":["Buur ciŋ kehƴi ɓaahee na ɗe toonki a toonkee na in ciŋ ɗe moɗiɗ ci, hey fuɗe, ɓa miskiɗuk ini kaɗ nga ɗe, ne ɓa hot ɗuukriŋ kur-taahi kaɓee ɗah."]},{"type":"verse","number":10,"content":["Ɓa hey cangtiɗke sagu neƴƴoh mbugali a mbugalsan, ɓa woyee ne :",{"text":"« Mas ! Mas waay !","poem":1},{"lineBreak":true},{"text":"Babilon, kur-taahi yakki, heɗ hatili !","poem":1},{"lineBreak":true},{"text":"Fu atte'uuɗ","poem":1},{"lineBreak":true},{"text":"ŋ wahtu yino dong ! »","poem":1}]},{"type":"verse","number":11,"content":["Toonoh ciŋ adinaani heya name fuɗ, ɓa miskiɗuka ; laam ali ɓo' romissanɗi toon ciŋ ɓa."]},{"type":"verse","number":12,"content":["Findi urus, haalis, peme, per ; piis leeŋ eɗfiɗ moɗiɗ, piis ruumind eɗfiɗ, piis suwa, piis ruumind coy ; hangi yooɓaaɗiini raaku, in haɓɗohuuɗ sis cooh wala hang ɗoɓiɗ, moos, tiwiñ wala atoh moɗiɗ."]},{"type":"verse","number":13,"content":["Ali ɓo' romissanɗi safɗohaaci na eeñɗohaaci, cuuraay, miir",{"noteId":7},", laackoloñ ; biiñ, diw, fariñ, bele ; inoh, mbaal, panis, wotiir, po ñaam sah, kipes ɓo'."]},{"type":"verse","number":14,"content":["Toonoh ci hey woye ne :",{"text":"« Ey !","poem":1},{"lineBreak":true},{"text":"In ci baahiɗ ci fu maɗee jen,","poem":1},{"lineBreak":true},{"text":"fusiɗ ɗa ;","poem":1},{"lineBreak":true},{"text":"raak-raak ceem","poem":1},{"lineBreak":true},{"text":"na in ci moɗiɗ ceem jen,","poem":1},{"lineBreak":true},{"text":"fu ñakiɗ ca","poem":1},{"lineBreak":true},{"text":"te ca rahsissassanɗi muk. »","poem":1}]},{"type":"verse","number":15,"content":["Toonoh ci raakoh nga ɗe, hey cangtiɗke sagu neƴƴoh mbugaliŋ ɗe. Ɓa hey fuɗe, ɓa miskiɗke."]},{"type":"verse","number":16,"content":["Ɓa woyee ne :",{"text":"« Mas ! Mas waay !","poem":1},{"lineBreak":true},{"text":"Kur-taahi yakki !","poem":1},{"lineBreak":true},{"text":"Wa nikee ɓekkiɗ","poem":1},{"lineBreak":true},{"text":"kulɓa leeŋ eɗfiɗ moɗiɗ,","poem":1},{"lineBreak":true},{"text":"na piis ruumind eɗfiɗ na ruumind coy","poem":1},{"lineBreak":true},{"text":"na tokkaah urus na per na peme.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ŋ wahtu yino dong","poem":1},{"lineBreak":true},{"text":"raak-raakeem jen sooƴiɗ ! »","poem":1},"Ɓi adgoh batooci na ɓi na ɓaaɓe nga ca, na ɓi pangkee ŋ cookmi na ɓi na pesohee wa jen, nikee cangtiɗkiɗ."]},{"type":"verse","number":18,"content":["Wi ɓa hot ɗuukriŋ dohiŋ kur-taahi, ɓa leehkeeɗa an : « Ali kur-taah moosɗi hend na kur kii yak ! »"]},{"type":"verse","number":19,"content":["Ɓa yiifkeeɗa merhey ŋ haf, ɓa fuɗeeɗa, ɓa miskiɗkeeɗa, ɓa rooyeeɗa an :",{"text":"« Mas ! Mas waay,","poem":1},{"lineBreak":true},{"text":"kur-taahi yakki !","poem":1},{"lineBreak":true},{"text":"Heɗ batoociŋ cookmi jen","poem":1},{"lineBreak":true},{"text":"raakoh ŋ raak-raakiŋ ɗe.","poem":1},{"lineBreak":true},{"text":"Ŋ wahtu yino dong,","poem":1},{"lineBreak":true},{"text":"wa sañuuɗ ! »","poem":1}]},{"type":"verse","number":20,"content":["Eel ci, neɓsiɗkaat ŋ ɗumbuukiŋ wa ! Neɓsiɗkaat ɓo'-Kooh ci, na Apootar ci na woosuuɗ ci ! Kooh atte'iɗa a wikkaa miskiɗi wa tum ɗu !"]},{"type":"verse","number":21,"content":["Ŋ ineem malaaka raakiɗ hatil ɓayya atoh yakak mand na oɗoha bele, a njaffaa ŋ cookma, a woosa ne :",{"text":"« Babilon kur-taahi yakki","poem":1},{"lineBreak":true},{"text":"njafohsan na doole an,","poem":1},{"lineBreak":true},{"text":"te ali ɓo' hotissanɗaa muk !","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Koora'oh ci na ƴeekoh ci,","poem":1},{"lineBreak":true},{"text":"mbiiɓoh ci na kulɓoh ci","poem":1},{"lineBreak":true},{"text":"kerhissassanɗi nga ɗa.","poem":1},{"lineBreak":true},{"text":"Ali pangkoh na yaah","poem":1},{"lineBreak":true},{"text":"hotkissanɗi nga ɗa ;","poem":1},{"lineBreak":true},{"text":"ɗuuɗ oɗoha","poem":1},{"lineBreak":true},{"text":"kerhissassanɗi nga ɗa ;","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"siñaariŋ laampaaci","poem":1},{"lineBreak":true},{"text":"melcissanɗi muk nga ɗa ;","poem":1},{"lineBreak":true},{"text":"hooso kilook na ƴaar ce","poem":1},{"lineBreak":true},{"text":"kerhissassanɗi nga ɗa.","poem":1},{"lineBreak":true},{"text":"Laam e toonoh ciŋ ɗa","poem":1},{"lineBreak":true},{"text":"degee yaah ŋ kehƴi","poem":1},{"lineBreak":true},{"text":"te luhus ciŋ ɗa tahiɗ po","poem":1},{"lineBreak":true},{"text":"ɓooɓi jen kosiɗ lee ciŋ ɗa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ɓaat nga woosuuɗ ci,","poem":1},{"lineBreak":true},{"text":"na ɓo'-Kooh ci","poem":1},{"lineBreak":true},{"text":"na ɓi boomu ŋ kehƴi jen,","poem":1},{"lineBreak":true},{"text":"ñif miŋ ɓa hotuuɗ","poem":1},{"lineBreak":true},{"text":"aamkeeɗa nga ɗa. »","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"ɗoopaat hooliɗ : a yi ɗoopti min seeƴkohu te a minnda ñamu ngaŋ Heber ci.","reference":{"chapter":18,"verse":2}},{"noteId":7,"caller":"+","text":"miir: wa cuuraay, wa na fuuɗseeɗi. Wa na woyse \"myrrhe\" ŋ farañse.","reference":{"chapter":18,"verse":13}}]},"thisChapterLink":"/api/sav_wbt/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sav_wbt/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sav_wbt/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}