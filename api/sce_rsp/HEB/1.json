{"translation":{"id":"sce_rsp","name":"Hudani Kielien","website":"https://ebible.org/Scriptures/details.php?id=sce","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sce","licenseNotes":null,"shortName":"RSP","englishName":"Donxian NT","language":"sce","textDirection":"ltr","sha256":"ee98751cb5d8524fc31fed4eea83619e7f41bc8a35ba03f4c9cf9fa470e56889","availableFormats":["json"],"listOfBooksApiLink":"/api/sce_rsp/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7920,"languageName":"Dongxiang","languageEnglishName":"Dongxiang"},"book":{"id":"HEB","translationId":"sce_rsp","name":"Xibolai Kunlade Huaisan Xin","commonName":"Xibolai Kunlade Huaisan Xin","title":"Xibolai Kunlade Huaisan Xin","order":58,"numberOfChapters":13,"sha256":"9f749b3e752567466b6c979f45d1c65dfb263aa23a0891bbbab16921e717e96d","firstChapterNumber":1,"firstChapterApiLink":"/api/sce_rsp/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/sce_rsp/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":1,"content":[{"type":"heading","content":["Huda Kewonne Tungo Giezhi Kieliewo"]},{"type":"verse","number":1,"content":["Gushihoude Huda xienzhilai tungo giezhi mai xienrenlade haojihui, olon banfaghala kieliewo."]},{"type":"verse","number":2,"content":["Duya baraku ene xienzide kewonne tungo giezhi matande kieliewo. Huda hhei soyujilai jienliechen kun danlaghawo. Da hhei tungo giezhi alanni zhayaghawo."]},{"type":"verse","number":3,"content":["Hheshi Hudai famatui faighachen gon wo. Hudai xinbinni onqiende daibio giezho. Nenlitu kielienghalane yanyanjilai gonjizho. Mai zuini ganjinraghadene undu, fugietu Hudai borun miende souzho."]},{"type":"verse","number":4,"content":["Hhe jienliesan niere qienxienlani nierese fama wo. Ingiezhi qienxienlase undudawo."]},{"type":"heading","content":["Hudai Kewon Qienxienlase Hen Wo"]},{"type":"verse","number":5,"content":["Huda alinie qienxiende,",{"text":"\"Chishi mii kewon wo.","poem":1},{"text":"Enedu bi chade ada danlawo.\"","poem":2},"giezhi kieliezhi daozho? Pse,",{"text":"\"Bi hhende ada danlane.","poem":1},{"text":"Hhe made kewon danlane.\"","poem":2},"giezhi kieliezhi daozho?"]},{"type":"verse","number":6,"content":["Pse Huda fugie kewonne duyade ireghakude,",{"text":"\"Hudai qienxienla, man hhei beii.\"","poem":1},"giezhi kieliezho."]},{"type":"verse","number":7,"content":["Huda qienxienlani kieliese,",{"text":"\"Huda qienxienlane kei gholughazho,","poem":1},{"text":"hojilane khan gholughazho.\"","poem":2},"giezhi kieliezhoma,"]},{"type":"verse","number":8,"content":["kewonne kieliese,",{"text":"\"Huda, chii baozoshi chanqi izhiku wo.","poem":1},{"text":"Chi gundannighala goyane gojiani gonjizho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chi gundannide xiqi wo, doghunnii henjizho.","poem":1},{"text":"Ingiese Huda, yeshijiu chii Huda chade bayasukui ogizhi","poem":2},{"lineBreak":true},{"text":"hhantu kunlase daoghawo.\"","poem":2},"giezho."]},{"type":"verse","number":10,"content":["Pse kieliezho,",{"text":"\"Ezhan, dei qiikude chi zeminde jichu giewo.","poem":1},{"text":"Asimanyiye chi khaghalane giewo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zemin, asiman widanema, chi izhi wine.","poem":1},{"text":"Hhela man jien mutun khuichenrane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Chi hhelai jien mutun horo agine.","poem":1},{"text":"Hhela jien mutun bienjinema,","poem":2},{"text":"Zinie chi niekielien wo.","poem":1},{"text":"Chanqi amiturane.\"","poem":2}]},{"type":"verse","number":13,"content":["Huda alinie qienxiende,",{"text":"\"Bi duitoulaichii kon dourachii teitula","poem":1},{"text":"chi mii borun miende sou.\"","poem":2},"giezhi kieliezhi daozho?"]},{"type":"verse","number":14,"content":["Qienxienlashi man zinie ushilachen ruhher wo. Huda peidene jiuikuni jienliene giesan kunlai ushilaghachen wo."]}],"footnotes":[]},"thisChapterLink":"/api/sce_rsp/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sce_rsp/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sce_rsp/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}