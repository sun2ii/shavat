{"translation":{"id":"shp_tbl","name":"Diossen joi jatíxonbi onanti joi","website":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseNotes":null,"shortName":"TBL","englishName":"Shipibo-Conibo Bible","language":"shp","textDirection":"ltr","sha256":"b340ce05773753bf7023e2ecdaf0d2fe5b4e2f1bd44f65ef0de0e0154c90a53a","availableFormats":["json"],"listOfBooksApiLink":"/api/shp_tbl/books.json","numberOfBooks":33,"totalNumberOfChapters":328,"totalNumberOfVerses":9808,"languageName":"Shipibo-Conibo","languageEnglishName":"Shipibo-Conibo"},"book":{"id":"HAB","translationId":"shp_tbl","name":"HABACUC","commonName":"HABACUC","title":"HABACUC Jakonma joai kopí, Dioski koshiti Habacucnin yoia","order":35,"numberOfChapters":3,"sha256":"2138a49f34d3e3e7de4361334a69b1060be5c482e80e53bad98e1149c8aab4d1","firstChapterNumber":1,"firstChapterApiLink":"/api/shp_tbl/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/shp_tbl/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"heading","content":["Ati keskáakin ayamakanaitian Habacuc jaskáatima riki iká"]},{"type":"verse","number":1,"content":["Natora profeta Habacuc Ibon onanmaa joi iki."]},{"type":"verse","number":2,"content":[{"text":"Ibó, ¿Jawetiankamanki min","poem":1},{"lineBreak":true},{"text":"ninkatamabi mia yokati ea saí iti iki?","poem":1},{"lineBreak":true},{"text":"¿Jawetiankamanki, nato jakonma","poem":1},{"lineBreak":true},{"text":"jawéki ikai kopí, noa akinni mia","poem":1},{"lineBreak":true},{"text":"joaimabi mia yokákin en mia saí ati iki?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Jaweatiki ichabires masá teneti itan ichabires jakonma min ea oinmai?","poem":1},{"lineBreak":true},{"text":"Jakonma masá teneti itan mawakanra ea kateke;","poem":1},{"lineBreak":true},{"text":"jatíbiainra join iananankanai itan jakonmanankanai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ja esekan yoiai keskára ayamakanai,","poem":1},{"lineBreak":true},{"text":"ati keskáakinra jakonhakin jato benxoaxonyamakanai,","poem":1},{"lineBreak":true},{"text":"joi benxoakinra jakonmabaon jakonbo jatoaresai,","poem":1},{"lineBreak":true},{"text":"itan atikeskabiakin jakon atira wetsaakanai.","poem":1}]},{"type":"heading","content":["Ibon kopikin yoia itan jato masá tenemati yoia."]},{"type":"verse","number":5,"content":[{"text":"Oinkanwe wetsa mainmeabaonra mato kateke;","poem":1},{"lineBreak":true},{"text":"oinnax ratékanwe.","poem":1},{"lineBreak":true},{"text":"Ea riki moa atires, wetsabaon mato yoia maton ikonhatima keská jawékibora en ati iki.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ninkakanwe caldeobora","poem":1},{"lineBreak":true},{"text":"reteanankasbo en jato imai,","poem":1},{"lineBreak":true},{"text":"jabora ramiamis jonibo iki,","poem":1},{"lineBreak":true},{"text":"nato mai rebestanira jatíbitian oken boanbekonkanai,","poem":1},{"lineBreak":true},{"text":"jatona ikenmabi iboanoxon mai biira ikanai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ja jonibaonra jato ratexon rakéakanai,","poem":1},{"lineBreak":true},{"text":"wetsa esébo ayamakinra jatonabichores jakon shinankanai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jaton kabayobora leopardobo winoa ishtobo iki,","poem":1},{"lineBreak":true},{"text":"tsoa jonibi jain jaama mananmamea pimis yoinabo bebónbires sinábo riki.","poem":1},{"lineBreak":true},{"text":"Ja kabáyonin peyakax boai","poem":1},{"lineBreak":true},{"text":"jonibora kikinbires icha itan","poem":1},{"lineBreak":true},{"text":"kikinbires ishtobo iki, jato akíra","poem":1},{"lineBreak":true},{"text":"ochokeaxbi jatoki choronkanai,","poem":1},{"lineBreak":true},{"text":"teté namiki paketai","poem":1},{"lineBreak":true},{"text":"keskatira, jatoki choronkanai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Winókinra jatíbi keyokin ras abotankanai;","poem":1},{"lineBreak":true},{"text":"ja bokinra jato rakéabotankanai,","poem":1},{"lineBreak":true},{"text":"ja jato yatankana jonibora","poem":1},{"lineBreak":true},{"text":"aniparo mashi xewinna bebónbires icha ikanai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Apobo itan kikin jakon joni koshibokira shirokanai.","poem":1},{"lineBreak":true},{"text":"Jaton jema katemakin koshi chikékanara osankanai,","poem":1},{"lineBreak":true},{"text":"jan mapétira ja chikékibi","poem":1},{"lineBreak":true},{"text":"mashi keyá tsamankanai,","poem":1},{"lineBreak":true},{"text":"jaskáxonra rátereskin jato yatankana iki.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Niweaba koshi keskára winókana iki;","poem":1},{"lineBreak":true},{"text":"jaton koshinbi jato akíra wetsa diossa noa keska yamake ikanai.","poem":1}]},{"type":"heading","content":["Jakonma shinanni chexakaati Habacuc jakiribi yoyo iká"]},{"type":"verse","number":12,"content":[{"text":"Ibó ¿Miaki jatíbitianbires","poem":1},{"lineBreak":true},{"text":"jaama iki, miaki jakon","poem":1},{"lineBreak":true},{"text":"itan keyoisma Diosma iki?","poem":1},{"lineBreak":true},{"text":"Miara nokon Ibo itan ea koiranna iki,","poem":1},{"lineBreak":true},{"text":"caldeobo jato koshi menixonra,","poem":1},{"lineBreak":true},{"text":"jabo meranxon atikeskabiakin min noa masá tenemaa iki.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mia kikinshaman jakonma","poem":1},{"lineBreak":true},{"text":"néoma ixonra, jakonma akanai min","poem":1},{"lineBreak":true},{"text":"amaresti atipanyamake, anibires","poem":1},{"lineBreak":true},{"text":"jakonma akanairibira min","poem":1},{"lineBreak":true},{"text":"jakonhaxon jato ointi atipanyamake,","poem":1},{"lineBreak":true},{"text":"¿Jawe keskákinki retemisbo min","poem":1},{"lineBreak":true},{"text":"oinresai, jaweatiki jakonma jonin","poem":1},{"lineBreak":true},{"text":"ja keskáma jakonbo jato reteaitian","poem":1},{"lineBreak":true},{"text":"min netéxon oinresai?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¿Jaweatiki aniparomea yapabo","poem":1},{"lineBreak":true},{"text":"akai keskáakin min jonibo akai,","poem":1},{"lineBreak":true},{"text":"jan akinti koshioma yoinabo keskáakin?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Caldeobaonra wetsa maibo","poem":1},{"lineBreak":true},{"text":"iboakanai, yapa biaibaon yapa","poem":1},{"lineBreak":true},{"text":"bixon iboai keskáakin:","poem":1},{"lineBreak":true},{"text":"miskitinin itan redbaonra bikanai,","poem":1},{"lineBreak":true},{"text":"jaskara jatíbi tsamata oinnaxa kikinbiresi raroai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Jaskákinra yapa biai jonin","poem":1},{"lineBreak":true},{"text":"mishkiti betan jawen redbo rabiai,","poem":1},{"lineBreak":true},{"text":"jainxonra jabo rabikin yoinabo","poem":1},{"lineBreak":true},{"text":"retexonai itan incienso inintibo","poem":1},{"lineBreak":true},{"text":"menoxonai, jabo kopíresa jakon itan icha pitia iki.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Jaskáakinki, ¿Caldeobaon jaton redbaon noa biboreskanti iki?","poem":1},{"lineBreak":true},{"text":"¿Noibayamakin jonibo jato reteboreskanti iki?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shp_tbl/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shp_tbl/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shp_tbl/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":17}