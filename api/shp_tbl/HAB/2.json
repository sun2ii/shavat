{"translation":{"id":"shp_tbl","name":"Diossen joi jatíxonbi onanti joi","website":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseNotes":null,"shortName":"TBL","englishName":"Shipibo-Conibo Bible","language":"shp","textDirection":"ltr","sha256":"b340ce05773753bf7023e2ecdaf0d2fe5b4e2f1bd44f65ef0de0e0154c90a53a","availableFormats":["json"],"listOfBooksApiLink":"/api/shp_tbl/books.json","numberOfBooks":33,"totalNumberOfChapters":328,"totalNumberOfVerses":9808,"languageName":"Shipibo-Conibo","languageEnglishName":"Shipibo-Conibo"},"book":{"id":"HAB","translationId":"shp_tbl","name":"HABACUC","commonName":"HABACUC","title":"HABACUC Jakonma joai kopí, Dioski koshiti Habacucnin yoia","order":35,"numberOfChapters":3,"sha256":"2138a49f34d3e3e7de4361334a69b1060be5c482e80e53bad98e1149c8aab4d1","firstChapterNumber":1,"firstChapterApiLink":"/api/shp_tbl/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/shp_tbl/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"heading","content":["Jain senenres Ibo Diossen yoia"]},{"type":"verse","number":1,"content":[{"text":"Netékainxonra en ninkatai itan jato koirannai sontáro jawen itinko iká keskára ea iti iki,","poem":1},{"lineBreak":true},{"text":"jaweki Ibon ea yoiai ixonra en ninkáti iki, jakonma shinanni joikin,","poem":1},{"lineBreak":true},{"text":"en yoiaki jawe","poem":1},{"lineBreak":true},{"text":"ea yoiai ixonra en ninkáti iki.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ibonra ea yoia iki:","poem":1},{"lineBreak":true},{"text":"“Ja en mia oinmai mapó tablanin wishawe,","poem":1},{"lineBreak":true},{"text":"ishton yoyo ati itiakin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nato min oinna jawéki","poem":1},{"lineBreak":true},{"text":"jatian senenti nokotamapari ikaxbira;","poem":1},{"lineBreak":true},{"text":"iamama senenti jake,","poem":1},{"lineBreak":true},{"text":"Ja min oinna basiainbi, miabiribi manáreswe:","poem":1},{"lineBreak":true},{"text":"ja ititianbiribira nokóti jake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jakonma jonibora rabitaibo iki ixon wishawe,","poem":1},{"lineBreak":true},{"text":"ikaxbi atikeskabiakin senen akaibora, Dioski yoiti ikax jati iki”, akin.","poem":1}]},{"type":"heading","content":["Jakonmabo jakonmain nokoti"]},{"type":"verse","number":5,"content":[{"text":"Rabí jonibora, joni koshi itin keenbo iki;","poem":1},{"lineBreak":true},{"text":"ja ikaskin benai tantiyamaira jatíbitian bebon keenboreskanai,","poem":1},{"lineBreak":true},{"text":"ja koshi iká jakonmamis ikenbi.","poem":1},{"lineBreak":true},{"text":"Jaton kexa chopeara jain mawá minti kini keska iki,","poem":1},{"lineBreak":true},{"text":"mawá keskáribi tantiti onanmabora ikanai,","poem":1},{"lineBreak":true},{"text":"jaskara ixonra jaton maibo, jato bichinbotankanai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ikaxbi jato mai bichinkanabora","poem":1},{"lineBreak":true},{"text":"jatikaxbi jan jato bichinaboki","poem":1},{"lineBreak":true},{"text":"shirokanti iki, jatokira bewakanti iki:","poem":1},{"lineBreak":true},{"text":"“¡Jawe ireskiai panon mato, matonama","poem":1},{"lineBreak":true},{"text":"ikenbi wetsabaon jakon kopí","poem":1},{"lineBreak":true},{"text":"jawékibo biax mato icha jawékia banétabo!","poem":1},{"lineBreak":true},{"text":"¿Jawetian kamanki mato ribina kopí bixon,","poem":1},{"lineBreak":true},{"text":"icha jakon kopí jawéki tsamani mato jenetai?”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Maton shinannamainbira, ja maton ribinabo matoki nokoti iki,","poem":1},{"lineBreak":true},{"text":"jan mato masá tenemaibo matoki pikóxonra,","poem":1},{"lineBreak":true},{"text":"jawebioma","poem":1},{"lineBreak":true},{"text":"mato banékanti iki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Maibotiibi ikábora bianananax,","poem":1},{"lineBreak":true},{"text":"mato akí matoki bechiakekanti iki,","poem":1},{"lineBreak":true},{"text":"jatianra maton jato aká keskáribiakin,","poem":1},{"lineBreak":true},{"text":"maton jawéki keyokin mato bichinkanti iki.","poem":1},{"lineBreak":true},{"text":"Jatíbi eséki ramíkin maton aká kopíra,","poem":1},{"lineBreak":true},{"text":"mato kopíamati iki, ja mainxon","poem":1},{"lineBreak":true},{"text":"jemaboki itan jainoa joniboki","poem":1},{"lineBreak":true},{"text":"bechiakexon maton meskó","poem":1},{"lineBreak":true},{"text":"jakonma aká kopíribira mato kopíamakanti iki.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Jawe ireskiai panon mato,","poem":1},{"lineBreak":true},{"text":"yometsokin bia jawékininra","poem":1},{"lineBreak":true},{"text":"maton xobo, maton bochoake,","poem":1},{"lineBreak":true},{"text":"jatíbi jakonmabaon mato akaitian,","poem":1},{"lineBreak":true},{"text":"jan mato xabaatira maton ake!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jaskáxonra maton xobon iká","poem":1},{"lineBreak":true},{"text":"rarebobo maton rabintiake,","poem":1},{"lineBreak":true},{"text":"ja maibotiibi ikábo ras axonra,","poem":1},{"lineBreak":true},{"text":"matonbi jan mato keyoti ake.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ja jema chiké makanbobi itan ja xobo","poem":1},{"lineBreak":true},{"text":"jiwi kanobobira matoki bechiaketax, mato ramiai saí ikanti iki.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Jawe ireskiai panon mato,","poem":1},{"lineBreak":true},{"text":"jemabo akinra, esekan yoiaibo ayamaakin,","poem":1},{"lineBreak":true},{"text":"itan atikeskabiakin jaskara ati maton ayamaa iki!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Jatíbi atipana Ibon imaara","poem":1},{"lineBreak":true},{"text":"mato teeta,","poem":1},{"lineBreak":true},{"text":"jainoax ja mato teeti paxkinairibi yanka iti iki,","poem":1},{"lineBreak":true},{"text":"jatíbi maton tee akábora chiikan keyokin menoti iki.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jenen aniparo bochoa","poem":1},{"lineBreak":true},{"text":"keskáakinra, Ibo jaskáaxon onanti","poem":1},{"lineBreak":true},{"text":"shinan koshi nato main jatíbiain bochoti iki.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Jawe ireskiai panon mato,","poem":1},{"lineBreak":true},{"text":"mato patax ikábora paeya","poem":1},{"lineBreak":true},{"text":"meskoxon jan beyósti rao maton","poem":1},{"lineBreak":true},{"text":"jato xeamai, namanbires","poem":1},{"lineBreak":true},{"text":"shinanmeexon keyokin","poem":1},{"lineBreak":true},{"text":"jaton chopa jopeta oinnoxon!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rabítitianbira, mato rabinresti iki,","poem":1},{"lineBreak":true},{"text":"wetsabo maton aká keskáribiakinra","poem":1},{"lineBreak":true},{"text":"Ibon mato ati iki,","poem":1},{"lineBreak":true},{"text":"mato panaa chopa jopemaxon maton jakina","poem":1},{"lineBreak":true},{"text":"rebichi maton xateama jato oinmai","poem":1},{"lineBreak":true},{"text":"keskára mato ati iki,","poem":1},{"lineBreak":true},{"text":"jatianra rabítitianbi mato namanbires shinanmeeti iki.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Líbano manan jaskáati","poem":1},{"lineBreak":true},{"text":"ikenmabi maton jakonma akára","poem":1},{"lineBreak":true},{"text":"matoki bechiaketi iki, jainoa","poem":1},{"lineBreak":true},{"text":"yoinabo reteaxa mato ratéti iki.","poem":1},{"lineBreak":true},{"text":"Ja mainmea jemaboki itan jaínoa","poem":1},{"lineBreak":true},{"text":"joniboki bechiakexon esekan yoiai ayamaketian","poem":1},{"lineBreak":true},{"text":"itan jakonmabires maton","poem":1},{"lineBreak":true},{"text":"jato aká kopíra, matoki jaskara","poem":1},{"lineBreak":true},{"text":"jawékibo nokóti jaki.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¿Ja rabiti jawéki jatonbi aká","poem":1},{"lineBreak":true},{"text":"moa akin senenhakanatonki noa akinti iki?","poem":1},{"lineBreak":true},{"text":"¿Jawekeskaxonki jan jansotires ixon,","poem":1},{"lineBreak":true},{"text":"ja rabiti jatonbi akátonin noa akinti iki?","poem":1},{"lineBreak":true},{"text":"Ja rabiti jatonbi akára yoyo iti atipanyamake;","poem":1},{"lineBreak":true},{"text":"¿Jawekeskataxki jan jaskara akaibo ikonhax jatoki koshiti iki?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¡Jawe ireskiaipanon mato,","poem":1},{"lineBreak":true},{"text":"ja rabiti aká jawéki jiwira maton jishtenwe akin akai,","poem":1},{"lineBreak":true},{"text":"ja yoyo iosma makanra maton niwé akin akai!","poem":1},{"lineBreak":true},{"text":"¿Jabaonki joi bexon noa yoiti atipana? ¡Jawe","poem":1},{"lineBreak":true},{"text":"akamakan, jara oro itan platanin rapoa ikaxbi jiriomabobi iki!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ikaxbi Ibora jawen jakon ani xobonko iki: ¡Jatíbi nato mainmea","poem":1},{"lineBreak":true},{"text":"jonibo já bebonmeax netékanwe!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shp_tbl/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shp_tbl/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shp_tbl/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}