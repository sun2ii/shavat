{"translation":{"id":"shp_tbl","name":"Diossen joi jatíxonbi onanti joi","website":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseNotes":null,"shortName":"TBL","englishName":"Shipibo-Conibo Bible","language":"shp","textDirection":"ltr","sha256":"b340ce05773753bf7023e2ecdaf0d2fe5b4e2f1bd44f65ef0de0e0154c90a53a","availableFormats":["json"],"listOfBooksApiLink":"/api/shp_tbl/books.json","numberOfBooks":33,"totalNumberOfChapters":328,"totalNumberOfVerses":9808,"languageName":"Shipibo-Conibo","languageEnglishName":"Shipibo-Conibo"},"book":{"id":"HAB","translationId":"shp_tbl","name":"HABACUC","commonName":"HABACUC","title":"HABACUC Jakonma joai kopí, Dioski koshiti Habacucnin yoia","order":35,"numberOfChapters":3,"sha256":"2138a49f34d3e3e7de4361334a69b1060be5c482e80e53bad98e1149c8aab4d1","firstChapterNumber":1,"firstChapterApiLink":"/api/shp_tbl/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/shp_tbl/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Habacucnin Dios orana"]},{"type":"verse","number":1,"content":["Nato riki profeta Habacucnin orana."]},{"type":"verse","number":2,"content":[{"text":"Ibó, jatíbi min aká yoikanai","poem":1},{"lineBreak":true},{"text":"ninkataxa, raketi ea saki ikai.","poem":1},{"lineBreak":true},{"text":"Ani jawéki moatian min akábo,","poem":1},{"lineBreak":true},{"text":"rama noa jaketian noa axonwe,","poem":1},{"lineBreak":true},{"text":"nonribi onannon ixon.","poem":1},{"lineBreak":true},{"text":"Jaskati sináxonbi min noa noibai noa oinmawe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Diossa Temán mainmeax joai;","poem":1},{"lineBreak":true},{"text":"Parán mananmameaxa Jakon Dios joai.","poem":1},{"lineBreak":true},{"text":"Jawen koshi shinanra","poem":1},{"lineBreak":true},{"text":"naikan jatíbiain iki,","poem":1},{"lineBreak":true},{"text":"nato netenxonra jatíbiainxon rabikanai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pené joekan kateara joai,","poem":1},{"lineBreak":true},{"text":"jawen mekenmameaxa","poem":1},{"lineBreak":true},{"text":"kaná joébo jokonai,","poem":1},{"lineBreak":true},{"text":"jaskáaxonra jawen koshi janbi jonea onantiakin jishtiai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Já joketianra jakonmabires isinbo beai,","poem":1},{"lineBreak":true},{"text":"yoná koshiribira japekáo joai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Já jainbi chankaketianra mai ninwana iki;","poem":1},{"lineBreak":true},{"text":"jato oinnara maibotiibi ikábo raketi saki ikanai;","poem":1},{"lineBreak":true},{"text":"ramanmantian mananbora reokootai,","poem":1},{"lineBreak":true},{"text":"moatian mananbora ras ikai;","poem":1},{"lineBreak":true},{"text":"Dios jan niai baira jatíbitianbires iki.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Cusán jonibo jakonma meranbires","poem":1},{"lineBreak":true},{"text":"ikanaira en oinna iki,","poem":1},{"lineBreak":true},{"text":"Madiánhin jaa jonibora raketi senbíkana iki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¿Ibó, parobokiki mia sinata?","poem":1},{"lineBreak":true},{"text":"¿Kikínbiresiki aniparoboki mia sinata?","poem":1},{"lineBreak":true},{"text":"¿Jaskatiki min kabayobaon mia peyaka,","poem":1},{"lineBreak":true},{"text":"janxon min jatoaresai carronki mia naneta?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Min kanóti betan jatíbi min piabora","poem":1},{"lineBreak":true},{"text":"moa min benxoa iki.","poem":1},{"lineBreak":true},{"text":"Parobo axonra, jan jene boai taebo min ake.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mia oinnaxa manánbo shakotai;","poem":1},{"lineBreak":true},{"text":"naikanmeaxa oi kextó maannai,","poem":1},{"lineBreak":true},{"text":"aniparo nemín itan anibechonra xóo ikai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Min piabo kikin pené ikax,","poem":1},{"lineBreak":true},{"text":"itan min lanza kikinbires kaná ikai","poem":1},{"lineBreak":true},{"text":"keskati joétaitianra, bari betan oxe jonetax moa pikóyamai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sinataxa nato main jatíbiain mia niai;","poem":1},{"lineBreak":true},{"text":"kikínbiresi sinataxa maibaon mia jaton penitai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Minra min jonibaon paranan","poem":1},{"lineBreak":true},{"text":"ikín min jato akinna iki, jainxonra","poem":1},{"lineBreak":true},{"text":"ja minbi katota aporibi min akinna iki.","poem":1},{"lineBreak":true},{"text":"Jakonma jonibaon xobora min ras aka iki,","poem":1},{"lineBreak":true},{"text":"jainxonra jan koshia shanka inonbi min jishtiakin pikoa iki.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jaton koshira jawen pianbi min retea iki,","poem":1},{"lineBreak":true},{"text":"niweaba koshi beai keská","poem":1},{"lineBreak":true},{"text":"rabíbeirani kabáyonin bexonra,","poem":1},{"lineBreak":true},{"text":"jonéres jato keyonoxon jan","poem":1},{"lineBreak":true},{"text":"kopímistiomabo jato tsakakana iki.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aniparo kikin jene neminhainra,","poem":1},{"lineBreak":true},{"text":"min kabáyonin jatíbiain mia kaa iki.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Jatíbi neskara ninkataxa ea raketa iki.","poem":1},{"lineBreak":true},{"text":"Ea keski ikaitianra,","poem":1},{"lineBreak":true},{"text":"nokon witaxen moa tewanyamaa iki,","poem":1},{"lineBreak":true},{"text":"jatianra jatíbi nokon yora koshi keyota iki.","poem":1},{"lineBreak":true},{"text":"Jaskara ikenbira, noa jan jakonma","poem":1},{"lineBreak":true},{"text":"tenemai, sontárobo Diossen masá","poem":1},{"lineBreak":true},{"text":"tenemai nete nokotai kaman,","poem":1},{"lineBreak":true},{"text":"jakonhaxonres en manati iki.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Higo jiwibo bimiamaibi,","poem":1},{"lineBreak":true},{"text":"Uva jiwibo bimiamaibi,","poem":1},{"lineBreak":true},{"text":"olivo jiwibo bimiamaibi;","poem":1},{"lineBreak":true},{"text":"non wainko banaabo jawe tsekati yamakenbi;","poem":1},{"lineBreak":true},{"text":"wakabo, carnerobobi yamakenbira,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"mia, ea jan jamai iketianra,","poem":1},{"lineBreak":true},{"text":"raroanan jatíbitian en mia rabiti iki.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nokon Ibó minra jakiribi","poem":1},{"lineBreak":true},{"text":"benaakin ea koshi menia iki;","poem":1},{"lineBreak":true},{"text":"chaxon ishto menixon,","poem":1},{"lineBreak":true},{"text":"manan keyáinbo min ea raanara ea jain iká iki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shp_tbl/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shp_tbl/MAL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shp_tbl/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}