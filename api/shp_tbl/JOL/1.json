{"translation":{"id":"shp_tbl","name":"Diossen joi jatíxonbi onanti joi","website":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseNotes":null,"shortName":"TBL","englishName":"Shipibo-Conibo Bible","language":"shp","textDirection":"ltr","sha256":"b340ce05773753bf7023e2ecdaf0d2fe5b4e2f1bd44f65ef0de0e0154c90a53a","availableFormats":["json"],"listOfBooksApiLink":"/api/shp_tbl/books.json","numberOfBooks":33,"totalNumberOfChapters":328,"totalNumberOfVerses":9808,"languageName":"Shipibo-Conibo","languageEnglishName":"Shipibo-Conibo"},"book":{"id":"JOL","translationId":"shp_tbl","name":"JOEL","commonName":"JOEL","title":"JOEL Dioski yoiti ikánon ixon, itan akonkin jakonma jenekanon ixon Joelnin Israel jonibo yoia","order":29,"numberOfChapters":3,"sha256":"adfa95320fc36a877a05bbf4e79723694c5e324061f6327df95a9228c490fea8","firstChapterNumber":1,"firstChapterApiLink":"/api/shp_tbl/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/shp_tbl/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"heading","content":["Chanpon banábo ramia"]},{"type":"verse","number":1,"content":["Ea Petuelnin bake Joelra, nato joi Ibon yoia iki."]},{"type":"verse","number":2,"content":[{"text":"Nato jakonhakin ninkáshamankanwe joni koshibó,","poem":1},{"lineBreak":true},{"text":"jainxon matonribi ja main jaa jonibaon ninkakanwe.","poem":1},{"lineBreak":true},{"text":"¿Neskara jawéki ikaiki maton jawetianbi oinnama iki?","poem":1},{"lineBreak":true},{"text":"¿Jawetianbiki wetsatianbo, neskara jawéki ikai maton papabaon oinnama iki?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nato joi maton bakebo yoikanwe,","poem":1},{"lineBreak":true},{"text":"abákanon jabaon jaton bakebobiribi yoikin,","poem":1},{"lineBreak":true},{"text":"jatianra jato pekao pikotaibo jabaonbiribi jato yoiti iki.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Judáin bexonra chanpobaon jatíbi pia iki:","poem":1},{"lineBreak":true},{"text":"wetsabaon texeara jatíribibaon bexon keyokin piá iki.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Mato paennabo moa jishtenkanwe!","poem":1},{"lineBreak":true},{"text":"¡Ja vino xeaibo winikanwe,","poem":1},{"lineBreak":true},{"text":"wai ras axonra uva jenebobi mato bichinkanai!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jainoax champobora koshi, itan ichabires sontárobo keská,","poem":1},{"lineBreak":true},{"text":"león xeta keskáyabo, itan león awinnin xenita xeta keskáyabo","poem":1},{"lineBreak":true},{"text":"nokon main jatíbiain janbiske.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Non uva waibora ramiake,","poem":1},{"lineBreak":true},{"text":"non higo waibora keyokin beshéake,","poem":1},{"lineBreak":true},{"text":"ja jiwibichibora keyokin bishkoke,","poem":1},{"lineBreak":true},{"text":"ja jiwi poyanbobira joxobaintiake.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jawen biti joni mawáketian","poem":1},{"lineBreak":true},{"text":"ja biti iká ainbo winiai keskati, itan mekéti chopa saweax ikai keskatira,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ibo ja meniti jawékibo, bero bimibobi yamaketian,","poem":1},{"lineBreak":true},{"text":"itan uva xeatibobi Ibon xobonko yamaketian,","poem":1},{"lineBreak":true},{"text":"sacerdote jonibo winiai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jawe banábira ja main moa yamake;","poem":1},{"lineBreak":true},{"text":"ja maibora moa jawebioma ikax onis iki,","poem":1},{"lineBreak":true},{"text":"trigora moa keyoke,","poem":1},{"lineBreak":true},{"text":"uva waibora moa choshi iki,","poem":1},{"lineBreak":true},{"text":"itan olivos jiwibora moa siwáke.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mato wain teetaibo, itan uva banaibo","poem":1},{"lineBreak":true},{"text":"onisi winikanwe,","poem":1},{"lineBreak":true},{"text":"banábora moa keyóke,","poem":1},{"lineBreak":true},{"text":"jaskara ikaxa trigo, itan cebada moa tsekati yamake.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Uva waibora moa choshike","poem":1},{"lineBreak":true},{"text":"jainoax higo jiwibora moa keyóke.","poem":1},{"lineBreak":true},{"text":"Yobin jiwibo, wanin jiwi keskábo, manzana jiwiboribira moa choshike,","poem":1},{"lineBreak":true},{"text":"jainoax jatíbi wain banati jiwibo.","poem":1},{"lineBreak":true},{"text":"¡Jaskara kopíra jatíbi jonibo moa raroyamakanai!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mato sacerdotebo, Dios menikin jainxon","poem":1},{"lineBreak":true},{"text":"jawéki menotiain teetaibo, xaxa chopa sawekanwe,","poem":1},{"lineBreak":true},{"text":"jaskáax chexakaati winikanwe,","poem":1},{"lineBreak":true},{"text":"maton Diossen xobonkora,","poem":1},{"lineBreak":true},{"text":"moa bimi berobi, uva xeatibi ja Dios meniti moa yamake.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jonibo kenaxon ayunanti jato yoikanwe;","poem":1},{"lineBreak":true},{"text":"ja joni koshibo, itan jatíbi ja main jaa jonibo,","poem":1},{"lineBreak":true},{"text":"maton Ibo Diossen xobonko jato tsinkikanwe,","poem":1},{"lineBreak":true},{"text":"jaskáaxon Ibo yokakanwe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Jawe iresaipanon, Ibon","poem":1},{"lineBreak":true},{"text":"jaton jakonma aká jonibo yoixonti netera moa ochóma iki!","poem":1},{"lineBreak":true},{"text":"¡Jatíbi koshi Ibon onsá netera","poem":1},{"lineBreak":true},{"text":"noa keyoi joai!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Non oinkenbira, chanpon non yoábo keyokin pixon noa pitioma banémaa iki,","poem":1},{"lineBreak":true},{"text":"jatianra non Diossen xobonko moa raroti keyota iki.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Non banaa berobora oi beyamaitian mawáke,","poem":1},{"lineBreak":true},{"text":"trigora moa yamake,","poem":1},{"lineBreak":true},{"text":"itan jain bero tsamantibora koiranyamakana moa rinwimeebotanai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Wakabora jawékiakasi máan ikai!","poem":1},{"lineBreak":true},{"text":"Yankabiresa wakabaon pasto benai;","poem":1},{"lineBreak":true},{"text":"carnero tsamabora mawatai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¡Min akinnon ixonra en mia yokatai Ibó,","poem":1},{"lineBreak":true},{"text":"tsoa jonibi jain jaama mainmea xobi, itan ja mainmea niibora","poem":1},{"lineBreak":true},{"text":"bari xanan keyokin menoke!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"¡Weanbo tsosinketian,","poem":1},{"lineBreak":true},{"text":"itan bari xanan pastobo menoaitianra,","poem":1},{"lineBreak":true},{"text":"ináatima yoinabaonbi min akinnon ixon mia yokákanai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shp_tbl/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shp_tbl/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shp_tbl/RUT/4.json","previousChapterAudioLinks":{},"numberOfVerses":20}