{"translation":{"id":"shp_tbl","name":"Diossen joi jatíxonbi onanti joi","website":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseNotes":null,"shortName":"TBL","englishName":"Shipibo-Conibo Bible","language":"shp","textDirection":"ltr","sha256":"b340ce05773753bf7023e2ecdaf0d2fe5b4e2f1bd44f65ef0de0e0154c90a53a","availableFormats":["json"],"listOfBooksApiLink":"/api/shp_tbl/books.json","numberOfBooks":33,"totalNumberOfChapters":328,"totalNumberOfVerses":9808,"languageName":"Shipibo-Conibo","languageEnglishName":"Shipibo-Conibo"},"book":{"id":"JOL","translationId":"shp_tbl","name":"JOEL","commonName":"JOEL","title":"JOEL Dioski yoiti ikánon ixon, itan akonkin jakonma jenekanon ixon Joelnin Israel jonibo yoia","order":29,"numberOfChapters":3,"sha256":"adfa95320fc36a877a05bbf4e79723694c5e324061f6327df95a9228c490fea8","firstChapterNumber":1,"firstChapterApiLink":"/api/shp_tbl/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/shp_tbl/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Jaton rawíbaon israelitabo chanpobaon akai keskáakin jato ramia"]},{"type":"verse","number":1,"content":[{"text":"Jerusalén mananmanxon trompeta xoon akanwe;","poem":1},{"lineBreak":true},{"text":"Ibon jakon manmanxon ja onsá yoii ikai onankanwe.","poem":1},{"lineBreak":true},{"text":"Judáin jaa jonibo jatikaxbi saki ikanwe,","poem":1},{"lineBreak":true},{"text":"Ibon jaton akábo yoixonti netera ochóma iki:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ja netera kikin yamé, itan yamémataniribi iti iki,","poem":1},{"lineBreak":true},{"text":"ja netera nai koin jaax ota yamé iti iki.","poem":1},{"lineBreak":true},{"text":"Koshi itan ichabires sontarobora","poem":1},{"lineBreak":true},{"text":"nete xabáxon tenai keskati,","poem":1},{"lineBreak":true},{"text":"mananbotiibi jatíbiain janbiskana iti iki.","poem":1},{"lineBreak":true},{"text":"Neskara jawéki ikaira jawetianbi non oinnama iki,","poem":1},{"lineBreak":true},{"text":"jaskáribiakinra jawetianbi non ointima iki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chiikan jatíbi keyoai keskáakinbora akanai;","poem":1},{"lineBreak":true},{"text":"winotamatianbi axon,","poem":1},{"lineBreak":true},{"text":"itan moa winota pekáobi axon akinra menoai.","poem":1},{"lineBreak":true},{"text":"Ja nokotamatianra, mai kikínbires jakon jain iká iki,","poem":1},{"lineBreak":true},{"text":"ja moa bokanketianra, jain jawebi xoxoyamai manan keská iti iki. ¡Jawebira jainoax kenekaayamai!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jawen jisára kabayobo keská iki,","poem":1},{"lineBreak":true},{"text":"kabáyonin boaibo ikai keskatira ishtokanai,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"mananbotiibi choronaitianra jawen riri ika,","poem":1},{"lineBreak":true},{"text":"janmeax reteananti carrobo ikai keskati riri ikai,","poem":1},{"lineBreak":true},{"text":"pei chosi menoa ikai keskatira tashki tashki ikai.","poem":1},{"lineBreak":true},{"text":"Koshi sontárobo reteananox joyota keskára ikanai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jato oinnaxa jonibo saki ikai,","poem":1},{"lineBreak":true},{"text":"itan jatíbi jaton bemananra pasnákanai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Reteananai koshi shinanya jonibo keskara ishtokanai,","poem":1},{"lineBreak":true},{"text":"makan chikébaonra néekanai","poem":1},{"lineBreak":true},{"text":"jainoaxa pontébainkanai,","poem":1},{"lineBreak":true},{"text":"tsoabira wetsaori kayamai pontéres bain bokanai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wetsabo betan tsakaananyamaira;","poem":1},{"lineBreak":true},{"text":"westíorabo jaton bainbiribi bokanai,","poem":1},{"lineBreak":true},{"text":"pia meranbires ikaxbira,","poem":1},{"lineBreak":true},{"text":"ja joyotax janbísyamakanai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Jaton jema bichinaxa","poem":1},{"lineBreak":true},{"text":"makan chiké maxkaten ishtokanai,","poem":1},{"lineBreak":true},{"text":"xobo pekatenbora nékanai,","poem":1},{"lineBreak":true},{"text":"ja yometso ikai keskatira xobo ventananbaonbi weíkanai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jato bebonmeaxa mai ninwanai,","poem":1},{"lineBreak":true},{"text":"naira shakotai, bari betan oxera yametai","poem":1},{"lineBreak":true},{"text":"itan wishtinbora moa penéyamai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jawen sontárobo bebon kakinra,","poem":1},{"lineBreak":true},{"text":"Ibon jawen tirin ikai joi jato ninkámai.","poem":1},{"lineBreak":true},{"text":"Jawen sontárobora kikínbires icha iki;","poem":1},{"lineBreak":true},{"text":"ja yoia senenhaibora tson topontimati iki.","poem":1},{"lineBreak":true},{"text":"¡Jonibo Ibon jato yoixonai netera, kikin jakonma itan onsá iti iki!","poem":1},{"lineBreak":true},{"text":"Tsonbira teneti atipanyamake.","poem":1}]},{"type":"heading","content":["Israelitabaon jaton shinan wetsaati Joelnin yoia"]},{"type":"verse","number":12,"content":[{"text":"Ibonra neskara yoia iki: “Jaskara ikenra rama Ibo Diossen onantiakin yoiai,","poem":1},{"lineBreak":true},{"text":"jatíbi maton shinanyaxonbi eabicho rabikanwe.","poem":1},{"lineBreak":true},{"text":"¡Ayunankanwe, saí ikanwe itan winikanwe!”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¡Non Ibo Dioski yoiti ikanwe,","poem":1},{"lineBreak":true},{"text":"maton chopa waxatitianbi,","poem":1},{"lineBreak":true},{"text":"jatíbi maton shinanyanixbi jaki yoiti ikanwe!","poem":1},{"lineBreak":true},{"text":"Ibora, akonkin noimis itan onísamis iki,","poem":1},{"lineBreak":true},{"text":"jato jaweatima shinanyaresiki, ikira ikai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jawe keska ixonra moa mato masá tenemayamakin,","poem":1},{"lineBreak":true},{"text":"icha jawéki mato meniti iki:","poem":1},{"lineBreak":true},{"text":"Icha berobo itan icha uva xeati","poem":1},{"lineBreak":true},{"text":"ja non Ibo Dios menitibo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Sión mananmanxon westíoratonin trompeta xoon awe!","poem":1},{"lineBreak":true},{"text":"Judá jonibo kenakanwe tsinkíxon ayunankanon;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"mato sacerdotebaon Diossen jonibo tsinkikanwe,","poem":1},{"lineBreak":true},{"text":"Dios bebon kerásma inox kikinni chokíkanon jato yoikanwe;","poem":1},{"lineBreak":true},{"text":"yosibo, bakebo itan xoma","poem":1},{"lineBreak":true},{"text":"akai bakeboribi jato tsínkikanwe.","poem":1},{"lineBreak":true},{"text":"¡Ja wanoa benábobira","poem":1},{"lineBreak":true},{"text":"ja wanoax jain ikainoax bokanti iki!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sacerdotebo, ja Ibon tee akaibo winikanwe,","poem":1},{"lineBreak":true},{"text":"xepóti itan jainxon yoina menoti jemaorixon yokákanwe:","poem":1},{"lineBreak":true},{"text":"“Min jonibaon ocha shinanxonyamawe Ibó;","poem":1},{"lineBreak":true},{"text":"min joniboki tsoabi shiromayamawe;","poem":1},{"lineBreak":true},{"text":"wetsa mainmeabaon jatoaresnaketian jato amayamawe.","poem":1},{"lineBreak":true},{"text":"‘¿Maton Dioski jawerano iki?’ ” Ikira, ja ikon Dios onananma jonibo inake.","poem":1}]},{"type":"heading","content":["Ibon jawen jonibo jakiribi jakonhati yoia"]},{"type":"verse","number":18,"content":[{"text":"Jatianra Ibon ja mainmea jawen jonibo noia jato onanmaa iki; jawen jonibo noibaxa,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"neskata iki:","poem":1},{"lineBreak":true},{"text":"Enbira mato yoiai; “Enra mato meniai trigo, uva xeati itan olivo xeni,","poem":1},{"lineBreak":true},{"text":"jatianra ja jawékiati jaketian mato raroshaman iti iki;","poem":1},{"lineBreak":true},{"text":"jaskáxonra ikon Dios onanma","poem":1},{"lineBreak":true},{"text":"jonibo en matoki shiromatima iki.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Norteorikeax beai chanpobora","poem":1},{"lineBreak":true},{"text":"matoki nokómatima iki,","poem":1},{"lineBreak":true},{"text":"jain jawebi xoxoyamai mananmanra en potati iki.","poem":1},{"lineBreak":true},{"text":"Jatopari beaibora, jaweona aniparo ikainko","poem":1},{"lineBreak":true},{"text":"en jato jene retemati iki,","poem":1},{"lineBreak":true},{"text":"ja jato pekáo beaibora, Mediterraneoain en jene retemaa,","poem":1},{"lineBreak":true},{"text":"jaton yora payotax pisi poati iki.","poem":1},{"lineBreak":true},{"text":"¡Ani jawékibora en ati iki!” iki.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Matobo, kikinbiresi rarokanwe itan rakéyamakanwe,","poem":1},{"lineBreak":true},{"text":"Ibonra ani jawékibo ati iki.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nii meranoa yoinabó, rakéyamakanwe,","poem":1},{"lineBreak":true},{"text":"xobi xoxoabora pei paxashamanbo iti iki,","poem":1},{"lineBreak":true},{"text":"jiwibora bimiti iki,","poem":1},{"lineBreak":true},{"text":"jatianra higo betan uva ichabires jati iki.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"¡Mato Jerusalénhain jaabo rarokanwe,","poem":1},{"lineBreak":true},{"text":"non Ibo Dioski rarokanwe!","poem":1},{"lineBreak":true},{"text":"Janra maxkáketian mato oi bemaxona iki,","poem":1},{"lineBreak":true},{"text":"moa akátiai keskáribiakinra","poem":1},{"lineBreak":true},{"text":"jénetia, itan nii peibo pechokoaitian","poem":1},{"lineBreak":true},{"text":"mato oi bemaxona iki.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Icha trigora tsekakanti iki,","poem":1},{"lineBreak":true},{"text":"jatianra ichabires uva xeati itan olivo xeni jati iki.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ibonra yoia iki: “Ja kikin jakonmabires keyomis ichabires chanpo,","poem":1},{"lineBreak":true},{"text":"en matoki raanaton","poem":1},{"lineBreak":true},{"text":"baritiabo mato manómaara,","poem":1},{"lineBreak":true},{"text":"en mato banexonti iki.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Potónon kaman jawékiaxonra,","poem":1},{"lineBreak":true},{"text":"ea Ibo Dios maton rabiti iki,","poem":1},{"lineBreak":true},{"text":"ani rateti jawékira en mato kopí aká iki.","poem":1},{"lineBreak":true},{"text":"Jawetianbira nokon jonibo moa rabinkantima iki,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"jatian mato israelitabaonra akonkin onanti iki,","poem":1},{"lineBreak":true},{"text":"ea Ibora mato betan iki,","poem":1},{"lineBreak":true},{"text":"itan ea riki maton Dios ixon, jaskara ikaxa wetsabo yamake.","poem":1},{"lineBreak":true},{"text":"¡Jawetianbira mato nokon jonibo, moa rabintima iki!","poem":1}]},{"type":"heading","content":["Diossen Shinan joai yoia"]},{"type":"verse","number":28,"content":[{"text":"Jaskara jawékibo winota pekáora,","poem":1},{"lineBreak":true},{"text":"jatíbi jonibo nokon Shinan en jato meniti iki:","poem":1},{"lineBreak":true},{"text":"maton benbo bakebo itan maton ainbo bakebora,","poem":1},{"lineBreak":true},{"text":"nokon janenko yoyo ikanti iki,","poem":1},{"lineBreak":true},{"text":"yosibaonra namáti iki,","poem":1},{"lineBreak":true},{"text":"bakeranonbaonra namá meran","poem":1},{"lineBreak":true},{"text":"akai keskáakin nekebi jawékibo oinkanti iki.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yonokaatai jonibo, itan yonokaatai ainbobokiribira,","poem":1},{"lineBreak":true},{"text":"nokon Shinan en manhati iki;","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ani rateti jawékibo naikan ikaibora en jato oinmati iki,","poem":1},{"lineBreak":true},{"text":"itan jimi, chii tiritai, chii koin kextóra nato main iti iki.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Bari yaméketianra,","poem":1},{"lineBreak":true},{"text":"oxe jimi keská iti iki,","poem":1},{"lineBreak":true},{"text":"Ibon nete nokotamatianra jaskara iti iki,","poem":1},{"lineBreak":true},{"text":"ani nete itan onsára iti iki”.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ikaxbi jatíbi ja Ibo rabiaibora,","poem":1},{"lineBreak":true},{"text":"mawáinoax xabakaati iki,","poem":1},{"lineBreak":true},{"text":"jaskara ikaxa Sión mananman, Jerusalénhain jakanti iki,","poem":1},{"lineBreak":true},{"text":"jaskara ati Ibon yoia keskára iti iki.","poem":1},{"lineBreak":true},{"text":"Jan katotabora mawayamai jati iki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shp_tbl/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shp_tbl/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shp_tbl/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}