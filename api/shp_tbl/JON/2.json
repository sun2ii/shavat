{"translation":{"id":"shp_tbl","name":"Diossen joi jatíxonbi onanti joi","website":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shpNTpo","licenseNotes":null,"shortName":"TBL","englishName":"Shipibo-Conibo Bible","language":"shp","textDirection":"ltr","sha256":"b340ce05773753bf7023e2ecdaf0d2fe5b4e2f1bd44f65ef0de0e0154c90a53a","availableFormats":["json"],"listOfBooksApiLink":"/api/shp_tbl/books.json","numberOfBooks":33,"totalNumberOfChapters":328,"totalNumberOfVerses":9808,"languageName":"Shipibo-Conibo","languageEnglishName":"Shipibo-Conibo"},"book":{"id":"JON","translationId":"shp_tbl","name":"JONÁS","commonName":"JONÁS","title":"JONÁS Jonás jaskara iká, itan Nínive jonibo ikana, Jonassen yoia","order":32,"numberOfChapters":4,"sha256":"9d1decc6a85521a84b10a8c5725b1a34c52a5d580737550e83df2205d1226254","firstChapterNumber":1,"firstChapterApiLink":"/api/shp_tbl/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/shp_tbl/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Jonassen orana"]},{"type":"verse","number":1,"content":["Jatianra yapan poko meranxon Jonassen jawen Ibo Dios orana iki,"]},{"type":"verse","number":2,"content":["oranira neskata iki:",{"text":"“Ibó, masá tenekinra en mia saí akin yokata iki,","poem":1},{"lineBreak":true},{"text":"jatianra ea min akinna iki.","poem":1},{"lineBreak":true},{"text":"Kikinbires chichó mawá meran ixon en mia kenaara,","poem":1},{"lineBreak":true},{"text":"min ea ninkata iki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aniparo kikin nemin ikain min ea potaara,","poem":1},{"lineBreak":true},{"text":"baikan ea mapoa iki,","poem":1},{"lineBreak":true},{"text":"ja min raana ani bechónbaonra","poem":1},{"lineBreak":true},{"text":"ea mapoa iki.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Miibakea, moa min ea potaara, en shinanna iki;","poem":1},{"lineBreak":true},{"text":"min jakon xobo moa oinwetsatima.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Akonbireskin ea jenen mapoara;","poem":1},{"lineBreak":true},{"text":"aniparo neminhain ea iketian;","poem":1},{"lineBreak":true},{"text":"jene meranoa xobi algas nishibaon ea mapoa iki.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ani xanken xamanko kamanra ea nokota iki;","poem":1},{"lineBreak":true},{"text":"¡jatíbitian jainoax pikótimaakin min xepoara en shinanna iki!","poem":1},{"lineBreak":true},{"text":"Ikaxbi mia nokon Ibo Diossenra,","poem":1},{"lineBreak":true},{"text":"mawáinoa min ea pikómaa iki.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Eara moa jayamai ixon onanxonra,","poem":1},{"lineBreak":true},{"text":"en mia shinanna iki Ibó;","poem":1},{"lineBreak":true},{"text":"en mia yokata joira mia iboamaa xobonko, miiba nokota iki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jatonbi ikonma dios axon rabiaibaonra,","poem":1},{"lineBreak":true},{"text":"moa mia ikon akin jenekanai;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ikaxbi enra mia rabiti iki, jainoax","poem":1},{"lineBreak":true},{"text":"raroira ea miki bewati iki;","poem":1},{"lineBreak":true},{"text":"ja en mia axonti yoiabora, en mia senenhaxonti iki.","poem":1},{"lineBreak":true},{"text":"¡Ibó, minbichoresa jato jamati atipanke!” akinra aká iki.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jatianra Ibon amaa aniyapan, maioriakin Jonás kinana iki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shp_tbl/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shp_tbl/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shp_tbl/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}