{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"DEU","translationId":"shr_buk","name":"Olushika","commonName":"Olushika","title":"OLUSHIKA","order":5,"numberOfChapters":34,"sha256":"72137b7b05f9465823b32a881dc5c1c963a92496dce9396e9d5e07c35be03688","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/shr_buk/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"heading","content":["Olwimbo lwa Mûsa"]},{"type":"verse","number":1,"content":[{"text":"Mwe malunga murhege okurhwiri, nkola nashambâla,","poem":1},{"lineBreak":true},{"text":"w’igulu, yumva okûla naderha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ihano lyâni lihone nka nkuba, akanwa naderha karhoge nka lumè,","poem":1},{"lineBreak":true},{"text":"nka hishîshîrha oku hyâsi, nka cihonzi oku musihe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kulya kubà lyo nacîtakîra izîno lya Nyamubâho;","poem":1},{"lineBreak":true},{"text":"mwoyo mukuze Nyamuzinda wîrhu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yêne y’ibuye: obushanja bwâge buli bwimâna,","poem":1},{"lineBreak":true},{"text":"bulyâla enjira zâge zoshi ziri bushinganyanya.","poem":1},{"lineBreak":true},{"text":"Ye Nyamuzinda mutabesha na mudahemuka.","poem":1},{"lineBreak":true},{"text":"Ye Mushinganyanya ye na Mushongêza.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bakozire amaligo n’obwo ababurhaga barhalikwo ishembo,","poem":1},{"lineBreak":true},{"text":"iburha lya ndyâlya na ncuku.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ka gwo munkwa gwâwe emwa Nyamuzinda ogwo?","poem":1},{"lineBreak":true},{"text":"Lubaga lwa bingolo-ngolo n’orhutumbaguzi.","poem":1},{"lineBreak":true},{"text":"Kali ye sho ye wakuburhaga,","poem":1},{"lineBreak":true},{"text":"ye wakulemaga ye nakubika?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kengêra ensiku zàli burhanzi,","poem":1},{"lineBreak":true},{"text":"singiriza emyâka, amâburhwa n’amâburhwa,","poem":1},{"lineBreak":true},{"text":"odôse sho akubwîriza; abakulûkulu bâwe bakuganîrira.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amango ow’Enyanya agabiraga amashanja akashambala,","poem":1},{"lineBreak":true},{"text":"amango abêrulaga bene omuntu akubûlira amashanja olubibi","poem":1},{"lineBreak":true},{"text":"nk’oku omubalè gwa Bene Israheli gunali.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nyamubâho yêhe, ogwâge mwanya, lunali olubaga lwâge,","poem":1},{"lineBreak":true},{"text":"na Yakôbo co câge cigabi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amushanga omu mpinga, omu nyama-wandya w’irungu","poem":1},{"lineBreak":true},{"text":"amuyababira amulengeza, amulanga nka mbonyi y’amasù gâge.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nka kula ikozi linashîbirira olwôgo lwâlyo,","poem":1},{"lineBreak":true},{"text":"kula lirembêra enyanya z’ebyâna byâlyo,","poem":1},{"lineBreak":true},{"text":"naye ashanjûla ebyûbi byâge, amurhôla amuhêka omu mashala gâge.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nyamubâho yêne wamuherhe,","poem":1},{"lineBreak":true},{"text":"ntà nyamuzinda w’emwa bene bâli bo naye.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amugerana omu birhondo by’ecihugo,","poem":1},{"lineBreak":true},{"text":"amulîsa oku myâka y’omu ishwa,","poem":1},{"lineBreak":true},{"text":"amulumîsa oku bûci bw’omu ibuye,","poem":1},{"lineBreak":true},{"text":"oku rhuvurha rhw’omu ibâle lizibuzibu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Oku mashanza g’omu nkâfu n’oku marhà g’ebibuzi,","poem":1},{"lineBreak":true},{"text":"bashushagiza ebyânabuzi n’engandabuzi za bene Bashani","poem":1},{"lineBreak":true},{"text":"n’empene, bahirakwo n’amashushi g’omulà gw’engano","poem":1},{"lineBreak":true},{"text":"basûza n’omukò gw’ecihadu c’omuzâbîbu gwabirira.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yakôbo alya ayigurha. Yeshuruni","poem":1},{"noteId":10},{"text":"atwêra ahimba.","poem":1},{"lineBreak":true},{"text":"(Watwezire, warhuma wacilugira!)","poem":1},{"lineBreak":true},{"text":"Aleka Nyamubâho wamujiraga,","poem":1},{"lineBreak":true},{"text":"ibuye lyamucizagya alibonêsa nshonyi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bàrhuma abà mitula, erhi banyamuzinda b’embuga bàrhuma;","poem":1},{"lineBreak":true},{"text":"bamujira burhè n’ebyakobwa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bakazâgirherekêra bashetani n’obwo barhali Nyamuzinda,","poem":1},{"lineBreak":true},{"text":"bakazirherekêra banyamuzinda barhayishi,","poem":1},{"lineBreak":true},{"text":"bahyâhya mâshi, ba lishinjo-lishinjo, balya basho barhagashanizagya.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"(Wayibagîre ibuye lyakuburhaga, orhacikengîri Nyamuzinda wakuhiragaho.)","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nyamubâho abona okwo, n’omu burhè bwâge, ajandika bagala na bâli bâwe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aderha erhi: Nabafulika obusù bwâni, ndolage kurhi byababêra.","poem":1},{"lineBreak":true},{"text":"Bulya lyabîre iburha ligalugalu, bâna barhagwêrhi oku bakacîkubagirwa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Barhumire nâbà mitula y’irumbi lyâbo mpu banyamuzinda,","poem":1},{"lineBreak":true},{"text":"banjijire burhè n’amarumbi gâbo;","poem":1},{"lineBreak":true},{"text":"nâni nkolaga najira babè mitula y’irumbi mpu lubaga.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nêci, oburhè bwâni bwayâsire muliro,","poem":1},{"lineBreak":true},{"text":"gwâyôca ciru n’ebiri idako ly’okuzimu, gwâyôca idaho guyôce n’emyâka,","poem":1},{"lineBreak":true},{"text":"gurhasige olubando lw’entondo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nabalashirakwo amahanya, nabayukizakwo emyampi yâni.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bahungumuka n’ecizombo, bâlibwa n’ishûshira banayumîrire n’obwôge.","poem":1},{"lineBreak":true},{"text":"Nabarhumira erîno ly’ebiryanyi, baguma n’amanjoka-njoka.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"E muhanda, engôrho yamalîra abânarhabana, omu nyumpa ebihamba.","poem":1},{"lineBreak":true},{"text":"Ebyo byaheza omwânarhabana n’omwânanyere,","poem":1},{"lineBreak":true},{"text":"omwâna ociri oku ibêre n’omushosi w’emvi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nakadesire nti: «Nabashemba-shemba,","poem":1},{"lineBreak":true},{"text":"nti nazâza izîno lyâbo omu karhî k’abantu»,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"nka ntarhînyaga ifêka ly’omubisha,","poem":1},{"lineBreak":true},{"text":"kuderha nti abashombanyi bâbo bakanahaba baderhe erhi:","poem":1},{"lineBreak":true},{"text":"«Okuboko kwîrhu kwo kwahimîne,","poem":1},{"lineBreak":true},{"text":"ci arhali Nyamubâho wakozire ebyo byoshi.»","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nêci, bulya luli lubaga lurhabona,","poem":1},{"lineBreak":true},{"text":"lurhanagwêrhi makengu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nka bali bantu barhimanya bakanayumvîrhe,","poem":1},{"lineBreak":true},{"text":"bakanabwîne bwinjà kurhi bazinda bali.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Kurhi omuntu muguma akakânana ecihumbi,","poem":1},{"lineBreak":true},{"text":"n’ababirhi kurhi bakatundulika ebihumbi ikumi,","poem":1},{"lineBreak":true},{"text":"kuleka kulya kubà ibâle lyâbo lyabaguzize,","poem":1},{"lineBreak":true},{"text":"na kulya kubà Nyamubâho abarhibiremwo?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Cikwône ibuye lyâbo lirhali nk’ibâle lîrhu;","poem":1},{"lineBreak":true},{"text":"arhanali abashombanyi bîrhu bo bakarhulagira.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Bulyâla ihaji lyâbo lyàli ly’oku muzâbîbu gw’e Sodomo,","poem":1},{"lineBreak":true},{"text":"ly’omu lukoma lw’e Gomora:","poem":1},{"lineBreak":true},{"text":"amalehe g’eyo mizâbîbu galimwo obwôge,","poem":1},{"lineBreak":true},{"text":"ebihadu by’amalehe gâbo biri bilulu-bilulu,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"idivayi lyâbo gali manjokanjokà,","poem":1},{"lineBreak":true},{"text":"gali mîno makali ga mpiri.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ci kwône yêhe, k’arhali ho andi aha burhambi nka ntûlo,","poem":1},{"lineBreak":true},{"text":"erya mbôhe omu irhù ly’ebinja?","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Olwihôlo n’oluhembo biri byâni,","poem":1},{"lineBreak":true},{"text":"amango okugulu kwâbo kwarhereza.","poem":1},{"lineBreak":true},{"text":"Bulyâl’olusiku lwâbo lw’okuhanyagala luli hôfi;","poem":1},{"lineBreak":true},{"text":"nehi babîkîrwe hiyishire buhena.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"(Bulya Nyamubâho ayishihôla olubaga lwâge.","poem":1},{"lineBreak":true},{"text":"Ci kwône abambali bôhe lukogo ababêra),","poem":1},{"lineBreak":true},{"text":"hano abona bârhà enjingo hano abona","poem":1},{"lineBreak":true},{"text":"harhaciri ntagengwa harhanaciri mujà.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ago mango anaderha, erhi: banyamuzinda bâbo ngahi baligi,","poem":1},{"lineBreak":true},{"text":"liryal’ibuye bakazâgiyâkiraho?","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Balya bakazâgirya amashushi g’enterekêro zâbo banakazinywa idivayi","poem":1},{"lineBreak":true},{"text":"ly’okugashâniza kwâbo, bayimangage bamurhabâle,","poem":1},{"lineBreak":true},{"text":"bahindukage lwâkiro lwinyu.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Mulolage oku niono, niono ndi ye,","poem":1},{"lineBreak":true},{"text":"n’oku ntà wundi oli Nyamuzinda haguma nâni.","poem":1},{"lineBreak":true},{"text":"Niene nie nyîrha nie nanciza, amango namashûrha,","poem":1},{"lineBreak":true},{"text":"niene nanfumya, (na ntâye wakakûla owundi omu nfune zâni).","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Nêci, nnengerîze enfune zâni emalunga,","poem":1},{"lineBreak":true},{"text":"nandesire, nti: «Nie nkudesire, nie mbâho ensiku n’amango»,","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"amango nâbà namarhyaza engôrho yâni erhangirayalabuka,","poem":1},{"lineBreak":true},{"text":"n’okuboko kwâni kurhangira okutwa emmanja,","poem":1},{"lineBreak":true},{"text":"ago mango nânacihôlera emunda abashombanyi bâni bali,","poem":1},{"lineBreak":true},{"text":"balya banshomba nânabaha oluhembo lwâbo.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Emyampi yâni nayilalusa n’omukò,","poem":1},{"lineBreak":true},{"text":"n’engôrho yâni yavûgusa enyama:","poem":1},{"lineBreak":true},{"text":"mukò gwababanzirwe n’abagwêrhe mpira,","poem":1},{"lineBreak":true},{"text":"mpanga z’abarhambo b’omushombanyi!","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Mwe malunga, muciyigîrize haguma naye,","poem":1},{"lineBreak":true},{"text":"na bene Nyamuzinda bamuharamye!","poem":1},{"lineBreak":true},{"text":"Mwe mashanja, mucîyigîrize haguma n’olubaga lwâge,","poem":1},{"lineBreak":true},{"text":"n’entumwa za Nyamuzinda ziderhe obuzibu bwâge.","poem":1},{"lineBreak":true},{"text":"Bulyâla ayishihôla omukò gw’abambali,","poem":1},{"lineBreak":true},{"text":"anagalulire abashombanyi bâge amakwânane gâbo.","poem":1},{"lineBreak":true},{"text":"Abamushomba abagalulira ebyâbo,","poem":1},{"lineBreak":true},{"text":"anakangûle ecihugo c’olubaga lwâge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":44,"content":["Mûsa ayisha ali bona Yozwè mwene Nuni, ebinwa by’olu lwimbo byoshi abiderhera omu kurhwiri kw’olubaga. Okushimba irhegeko kwo kulama"]},{"type":"verse","number":45,"content":["Erhi Mûsa ayûsa abwîra Israheli yêshi ebi binwa,"]},{"type":"verse","number":46,"content":["ashubibabwîra, erhi: «Muyumvîrhize ebi binwa byoshi; byo njijire ene caliho w’okumuyagîriza. Murhegeke bagala binyu balange banakulikire ebinwa by’olu Lushika byoshi."]},{"type":"verse","number":47,"content":["Kuli mwe, olwo Lushika lurhali lwa kuhalîza, bulya luli kalamo kinyu, lwo lwanamuha okulama nsiku nyinji mw’eci cihugo mwajiyanka obu mwayikira Yordani». Bamanyîsa Mûsa oku akola afà"]},{"type":"verse","number":48,"content":["Olwo lusiku lwonênè, Nyamubâho ashambâza Mûsa, amubwîra erhi:"]},{"type":"verse","number":49,"content":["«Sôkera oku ntondo ya Nebo, ntondo eri omu birhondo bya Abarimu, omu cihugo ca Mowabu, ah’ishiriza lya Yeriko, onalole bwinjà ecihugo ca Kanâni nahà Bene Israheli nti cibè câbo."]},{"type":"verse","number":50,"content":["“Onafire oku ntondo wasôkera, wabugâna ab’emwinyu aka mulumuna wâwe Aroni, wafîraga oku ntondo ya Hori, ajibugâna abafîre”."]},{"type":"verse","number":51,"content":["“Kulya kubà arhambêraga mwîkubagirwa omu karhî ka Bene Israheli, oku lw’e Meriba-Kadeshi, omu irungu lya Sini, kulya kubà wabuzire buyêrekana obwimâna bwâni omu karhî ka Bene Israheli”."]},{"type":"verse","number":52,"content":["“Walangîrira emuhanda ci kwône ecihugo nâhà Bene Israheli orhacikozemwo okugulu”»."]}],"footnotes":[{"noteId":10,"caller":"+","text":"32, 15 Yushuruni ye Israheli (Rhulole omu Lush 33, 5.26; Iz 44, 2).","reference":{"chapter":32,"verse":15}}]},"thisChapterLink":"/api/shr_buk/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}