{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"ISA","translationId":"shr_buk","name":"Izaya","commonName":"Izaya","title":"YESHAYAHU, IZAYA","order":23,"numberOfChapters":66,"sha256":"c8c14ba1de1cbf582936513f393855789f0b518398ee6279a6511b900305ac8b","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/shr_buk/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["Olulanga lw’okuvug’omunkwa"]},{"type":"verse","number":1,"content":[{"text":"Mw’olwôla lusiku wanâderhe, erhi: Namâkukuza, Nyakasane!","poem":1},{"lineBreak":true},{"text":"Wali onkunirîre, ci obukunizi bwâwe bwarhulwîre, wanantûlirîze.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nyamuzinda ye bucire bwâni: Ye ncîkubagîre, ntâco naciyôboha;","poem":1},{"lineBreak":true},{"text":"bulya Nyakasane yo misî yâni lwo na lwimbo lwâni, ye bucire bwâni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mwanadôme amîshi n’omwîshingo aha maliba g’obucire.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mw’olwôla lusiku mwanâderhe, erhi Mukuze Nyakasane,","poem":1},{"lineBreak":true},{"text":"mushenge izîno lyâge; mumanyîse emikolo yâge omu mashanja;","poem":1},{"lineBreak":true},{"text":"muhamagaze oku izîno lyâge liri likulu bwenêne!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Muyimbire Nyakasane,","poem":1},{"lineBreak":true},{"text":"bulya ajizire ebirhangâzo bimanyîkîne omu igulu lyoshi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mucîshinge, mubande orhubûli, mwe mubà omu Siyoni,","poem":1},{"lineBreak":true},{"text":"bulya Omwimâna w’Israheli ajir’irenge ekarhî kinyu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}