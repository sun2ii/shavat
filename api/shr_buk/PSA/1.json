{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":1,"content":[{"type":"heading","content":["Enjira ibirhi"]},{"type":"verse","number":1,"content":[{"text":"Iragi lyâge omuntu orhacîfundikira haguma n’encuku","poem":1},{"lineBreak":true},{"text":"orhagenda n’emihera, orhanaboneka omu ndêko y’abashombanyi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Arhasîmisibwa n’agarhali marhegeko ga Nyamuzinda,","poem":1},{"lineBreak":true},{"text":"anagerêreza ago marhegeko bwacà-bwayira.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwo agandâza nka murhi gumezire aha cikunguzo c’olwîshi,","poem":1},{"lineBreak":true},{"text":"guyêrakwo emburho amango gâgwo, gunayôrha guyinjihire.","poem":1},{"lineBreak":true},{"text":"Na ngasi hyoshi ajira kubêra himubêra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Emihera erhakabona okwo!","poem":1},{"lineBreak":true},{"text":"kàli kw’eri nka hyâsi hya canda hiyehwîrwe n’empûsi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ntà kwâbo: aha kagombe eyo mihera erhakahambûla,","poem":1},{"lineBreak":true},{"text":"ciru erhakalabarha omu ihano ly’abashinganyanya","poem":1},{"noteId":0},{"text":".","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bulya Nyamuzinda ayishi enjira y’abimâna,","poem":1},{"lineBreak":true},{"text":"ci enjira y’endyâlya kuhabula ehabula.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1, 5 Sadiq ye mushinganyanya ci arhali rash’","reference":{"chapter":1,"verse":5}}]},"thisChapterLink":"/api/shr_buk/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}