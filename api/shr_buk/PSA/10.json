{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":10,"content":[{"type":"heading","content":["Nyamuzinda Mushinganyanya ho ali"]},{"type":"verse","number":1,"content":["Yâgirwa Nnâmahanga, cirhumire wabêra kulî,",{"text":"cirhumire ocîfulika amango g’amalibuko?","poem":1}]},{"type":"verse","number":2,"content":["Oku omuhera gwacîbona, omukenyi arhindibuka,",{"text":"agwârhwe omu bulyâlya bw’entimanya z’owâbo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Omuhera gunacishingire enyifinjo z’omurhima gwâgwo,",{"text":"omuhubu kulogorha alogorha, anagayaguze Nyamuzinda.","poem":1}]},{"type":"verse","number":4,"content":["Omu bucîbone bwâge omuhera kwo guderha, mpu:",{"text":"«Ntà buhane; Nyamuzinda arhahabà!» Zo nkengêro zoshi ezo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Ngasi mango amâjira gâge kubêra gamubêra;",{"text":"emmanja enyanya zimugera, arhankazirhimanya;","poem":1},{"lineBreak":true},{"text":"abashombanyi bâge boshi kumeshera abamesherakwo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Anaderhe omu murhima gwâge, erhi:",{"text":"«Nie ntadundwa; amâburha gàja oku gandi ntanabona malibuko.»","poem":1}]},{"type":"verse","number":7,"content":["Akanwa kâge kayunjwîre malogorha n’obunywesi n’obulyâlya;",{"text":"olulimi lwâge lurharhêngamwo oburhali buhanya n’obubî.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Y’oyo oshurhamire omu masheke,",{"text":"acîfulisire mpu ayîrhe omwêru-kwêru;","poem":1},{"lineBreak":true},{"text":"amasù gâge gadwîrhe gahigira omuhanya.","poem":1}]},{"type":"verse","number":9,"content":["Kwo acîfulika nka ntale omu bulumba bwâyo,",{"text":"alingûze mpu alonze omuhanya ayehûkana;","poem":1},{"lineBreak":true},{"text":"amuyehûkane, amukululire omu murhego gwâge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Anajè abundabunda, anashurhame,",{"text":"omuhanya amugwe omu nfune.","poem":1}]},{"type":"verse","number":11,"content":["Aderhe omu murhima gwâge, erhi:",{"text":"«Nyamuzinda ayibagire! Ahengwîre obusù bwâge,","poem":1},{"lineBreak":true},{"text":"arhanacidwirhi abona!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Yimuka, Nyamuzinda, Nnâmahanga,",{"text":"olengeze okuboko kwâwe;","poem":1},{"lineBreak":true},{"text":"omanye wankayibagira abali omu bulagîrire.","poem":1}]},{"type":"verse","number":13,"content":["Cankarhuma omuhera gwagayaguza Nnâmahanga,",{"text":"cankarhuma guderha omu murhima gwâgwo mpu arhabona?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":["Wêne obwîne, walolêrîze amalibuko n’emirenge,",{"text":"mpu ohiyankirire omu nfune zâwe,","poem":1},{"lineBreak":true},{"text":"omukenyi we acîkubagira, we lwâkiro lw’enfûzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":["Shangula okuboko kw’omubî n’omuhera;",{"text":"obubî bwâge obuhane, burhacifâga bwabonesire.","poem":1}]},{"type":"verse","number":16,"content":["Nyamuzinda ye Mwâmi w’ensiku n’amango,",{"text":"amashanja g’abapagani gàhirigirha omu igulu lyâge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Yâgirwa Nyamuzinda, oyumvîrhize omwîfinjo gw’abîrhôhye;",{"text":"ozibuhye emirhima yâbo onayirhege okurhwiri.","poem":1}]},{"type":"verse","number":18,"content":["Mpu lyo otwîra enfûzi n’odwîrhe arhindibuzibwa olubanja,",{"text":"lyo n’omuntu warhengaga omu bidaka alekikâlibuza abandi n’ebihamba.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}