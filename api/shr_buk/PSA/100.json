{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":100,"content":[{"type":"heading","content":["Olwimbo lw’engabo yasôkera omu ka-Nyamuzinda"]},{"type":"verse","number":1,"content":[{"text":"Lulanga. Lwa kuvuga omunkwa.","descriptive":true},{"text":"Amahanga goshi gasâmire Nyakasane.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mukolere Nyakasane n’enshagadu; mujè omu masù gâge n’omwîshingo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mumanye oku Nyakasane ye Nyamuzinda, Yêne warhulemaga nîrhu rhuli bâge, rhuli ishanja lyâge, rhunali bibuzi by’okw’irango lyâge.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mushesherere omu mihango yâge erhi mwanakoma akagasha. muyongoberere omu côgo câge n’enyimbo; mumuhè irenge, mukuze izîno lyâge.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bulya Nnâmahanga ali mwinjà, obwonjo bwâge buli bw’ensiku n’amango, arhanarheba ndi kurhenga abantu baburhwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}