{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":101,"content":[{"type":"heading","content":["Omuhigo gw’omwimangizi w’olubaga"]},{"type":"verse","number":1,"content":[{"text":"Lulanga. Lwa Daudi.","descriptive":true},{"text":"Nkola nayimba obushinganyanya n’oburhonyi; we nazihira, Nyamwagirwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mwo nayisha omu njira y’entagoma: mangaci wampikaho? Nyishire n’omurhima gw’obudahemuka, omu mwâni mwo na nene.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Akantu kabî ntâzigè kangera omu masù: enkola-maligo ntazibonakwo: nanga ntazibonakwo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Omurhima mubî gurhagera aha ndi, ehiri hibî ntahikwîrirwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Omuntu wâshobeke owâbo bwifulikwè, nnamuheze, omuntu ocîbona, n’ogayana ntabakwîrirwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Abemêzi b’eci cihugo bo amasù gâni galikwo, nti bayûbake haguma nâni. Omuntu okerekera omu ntagoma, ye wâbà mwambali wâni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Enkola-maligo erhâlabarhe omu mwâni, n’endyâla erhâyimange omu masù gâni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Enkola-maligo ziri omu cihugo, nakaziregerera nazihungumula eziri omu lugo lwa Nyakasane, nâziheza zihwemwo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}