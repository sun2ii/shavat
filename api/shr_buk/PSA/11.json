{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":11,"content":[{"type":"heading","content":["Omulangâliro gw’omushinganyanya"]},{"type":"verse","number":1,"content":[{"text":"Oku mukulu w’abimbiza. Lwa Daudi.","descriptive":true},{"text":"Nyamuzinda ye lwâkiro lwâni.","poem":1},{"lineBreak":true},{"text":"Kurhi wakacimbwîra, mpu:","poem":1},{"lineBreak":true},{"text":"«Yàkira oku ntondo nka kanyunyi?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":["Ba nyankola-maligo abo bagosire emiherho,",{"text":"badwîrhe bafôl’emyampi oku ngè","poem":1},{"lineBreak":true},{"text":"mpu balashire abantu b’emirhima nkana omu mwizimya.","poem":1}]},{"type":"verse","number":3,"content":["Erhi eciriba cankahongoka,",{"text":"cici omushinganyanya ankacibash’ijira?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Nnâmahanga omu ka-Nyamuzinda kâge katagatîfu,",{"text":"Nyakasane oku ntebe yâge y’obwâmi omu malunga;","poem":1},{"lineBreak":true},{"text":"amasù gâge gadwîrhe galolêreza igulu,","poem":1},{"lineBreak":true},{"text":"engohe zâge zidwîrhe zasinza abâna b’abantu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Nyamuzinda abona entimanya z’omwinjà n’omubî;",{"text":"omurhima gwâge gushologorhwa na nyankola-maligo.","poem":1}]},{"type":"verse","number":6,"content":["Mûshi emihera ayirhogeze amakala g’engulumira n’ecibiriti,",{"text":"n’empûsi y’omuliro ebè co cigabi c’omu kabehe kâbo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Bulya Nyamuzinda abâ mushinganyanya,",{"text":"akunda n’obushinganyanya;","poem":1},{"lineBreak":true},{"text":"abantu b’emirhima mimâna bo bâbone obusù bwâge.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}