{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":110,"content":[{"type":"heading","content":["Obwâmi, Obukulu n’Obudâhwa bwa Masiha"]},{"type":"verse","number":1,"content":[{"text":"Lulanga. Lwa Daudi.","descriptive":true},{"text":"Nyakasane àjire aho abwîra Nnawîrhu","poem":1},{"noteId":2},{"text":"akanwa, erhi: «Bwârhala ekulyo kwâni, ntangiyandaza abashombanyi bâwe aha magulu gâwe».","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nyakasane ayanka itumu ly’obwamî bwâwe alirhogeza oku Siyoni","poem":1},{"noteId":3},{"text":", mpu: «Nj’oyîme omu karhî k’abashombanyi bâwe.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mpu: «Kurhenga okuburhwa kwâwe oli n’obukulu omu bulangashane bw’obutagatìfu: niene nakuburhaga embere z’omucêracêra nka lumè.»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nyakasane acîgashire arhanatwe omu kanwa kâge: «Oli mudâhwa w’ensiku n’amango kulya kwa Melkisedeki.»","poem":1},{"noteId":4}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nyakasane aha kulyo kwâwe ali: olusiku atulumukirwa lyo amâmi-mâmi gaherêrherwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Go mango olw’amashanja lwâmanywa, emirhumba elundumane; amarhwe gahinagwe omw’igulu lyoshi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Omu njira mîshi ga muhona ânywa, kurhume alengeza irhwe.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"110, 1 Nyakasane abwîra Nnawîrhu: Nyamuzinda yênene odesire ntyôla: Lul 2, 7-9. - Bwârhala ekulyo kwâni: ahantu h’olukengwa. Masiha âbà n’ecikono c’obwâmi, âbà Mudâhwa w’ensiku n’amango: Mat 22, 44; Ebj 2, 34-35; Hbr 1, 13.","reference":{"chapter":110,"verse":1}},{"noteId":3,"caller":"+","text":"110, 2 Kurhenga e Siyoni: Masiha âbà côkola w’abantu boshi. Lul 2na Lul 71.","reference":{"chapter":110,"verse":2}},{"noteId":4,"caller":"+","text":"110, 4 Kurhenga e Siyoni: Masiha âbà côkola w’abantu boshi. Lul 2na Lul 71.","reference":{"chapter":110,"verse":4}}]},"thisChapterLink":"/api/shr_buk/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}