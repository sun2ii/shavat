{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":113,"content":[{"type":"heading","content":["Kuli Nyamuzinda w’irenge n’ow’olukogo"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Mwe bambali ba Nyakasane, mukuze, mukuze izîno lya Nyakasane.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lij’irenge izîno lya Nyakasane, bunôla n’ensiku n’amango.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kurhenga ebushoshôkero bw’izûba na kuhika emunda lizikira, likuzibwe izîno lya Nyakasane.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nyakasane Nnâmahanga w’abantu boshi, irenge lyâge liyunjwîre empingu yoshi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndi oli aka Nyakasane Nyamuzinda wîrhu, ôbà enyanya bwenêne,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ôyûnama kurheng’enyanya alola idako, abone ebiri empingu n’en’igulu?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ye rhenza omuzamba omu katulo Ye nayimanza omukenyi, amukûle oku cavu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amutamaze oku ntebe haguma n’abaluzi, haguma n’abaluzi b’omulala gwâge.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ye tamaza owali ngumba omu nyumpa; amuhè obusîme bw’okubà nnina w’abâna.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}