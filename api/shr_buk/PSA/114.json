{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":114,"content":[{"type":"heading","content":["Olwimbo lwa Basâka"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Olusiku Israheli arhenga e Mîsiri,","poem":1},{"lineBreak":true},{"text":"olusiku enyumpa ya Yakôbo erhenga omu lubaga lw’abahalanjisi,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yûda lwashuba luhêro lwâge, Israheli bwashuba bwâmi bwâge.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Enyanja yabona okwo yakûla omulindi, Yordani ashubira nyuma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Entondo zahama nka nganda-buzi. Orhurhondo rhwacanacana nka bâna-buzi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wanyanja kurhi wamâbà obu wayâka? Yordani kurhi oku washubira nyuma?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kurhi mwe birhondo obu mwahama nka ngandabuzi? Kurhi ninyu mwe rhurhondo obu mwacanacana nka bâna-buzi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Igulu, nêci dirhimana omu masù ga Nyakasane, omu masù ga Nyamuzinda wa Yakôbo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Owahindulaga ibuye cidêka ca mîshi, n’olwâla aluhindula nshôko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}