{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":116,"content":[{"type":"heading","content":["Okuvuga omunkwa"]},{"type":"verse","number":1,"content":[{"lineBreak":true},{"text":"Ndwîrhe nacîshinga: bulya Nyakasane ayumvîrhîze izù ly’omusengero gwâni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Antege okurhwiri, olusiku mmusengîre.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Emibanga y’olufù enziririnzire n’entanya z’olufù zantubire, oburhè n’amaganya bingwêrhe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nyâkûzize izîno lya Nyakasane mâshi Yâgirwa, ocize obuzîne bwâni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nyakasane abâ mwonjo na murhondekezi, Nyamuzinda wîrhu arhahimwa lukogo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Abanyi bo Nyakasane alwîra, nali mubî ananciza.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oshubiluhûka murhima gwâni, bulya Nyakasane akuyumvirhize","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Omûka gwâni alilikûzize oku lufù, amasù gâni àgahôrhola emirenge, n’amagulu gâni arhuma garhahirima.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nâbera haguma na Nyakasane, omu cihugo c’abazîne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":9}