{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":12,"content":[{"type":"heading","content":["Nyamuzinda ancize oku mihigo y’abantu babî"]},{"type":"verse","number":1,"content":[{"text":"Oku mukulu w’abimbiza. Nzihwa y’omu lulanga lwa misî munâni. Lulanga. Lwa Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":["Orhucize, Nyakasane, bulya abashinganyanya badwîrhe bahwa;",{"text":"abemêzi badwîrhe bahirigirha omu bâna b’abantu.","poem":1}]},{"type":"verse","number":3,"content":["Abantu badwîrhe barhebana bône na nnene:",{"text":"nderho nnunu, mirhima ibirhi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Mâshi Nyamuzinda aherêrekeze ngasi kanwa kaderha obunywesi,",{"text":"ngasi lulimi lulyâlyanya.","poem":1}]},{"type":"verse","number":5,"content":["Ngasi baderha, mpu: «Olulimi lwîrhu yo misî yîrhu»,",{"text":"«kanwa rhujira, ye ndigi wankarhukulikira?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Naye Nnâmahanga, erhi: «Amalibuko g’abazamba»",{"text":"«n’emirenge y’abakenyi erhumire»,","poem":1},{"lineBreak":true},{"text":"«nkolaga nayimanga; abalonza obucire nabahêrezabwo.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Ebinwa bya Nyakasane biri by’okuli,",{"text":"kwo biri nka cûma ca marhale citule omu luganda,","poem":1},{"lineBreak":true},{"text":"nka masholo mashuke kali nda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Yâgirwa Nyamuzinda, we rhuciza,",{"text":"we warhulanga kuli er’iburha ensiku n’amango.","poem":1}]},{"type":"verse","number":9,"content":["Abanya-byâha bazungulusire hoshi hoshi,",{"text":"n’obubî bwarhalusire olugero omu bâna b’abantu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":9}