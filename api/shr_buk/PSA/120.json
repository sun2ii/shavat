{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":120,"content":[{"type":"heading","content":["Abashombanyi b’omurhûla"]},{"type":"verse","number":1,"content":[{"text":"Lwimbo. Lwa kusoka.","descriptive":true},{"text":"Nkayumva omutula, Nyakasane, Nyakasane ye nyâkûza ananshuze.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yâgirwa, ofungire omûka gwâni oku rhunwa rhubî, n’oku ndimi zibêsha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lêro olulimi lw’endyâlya cici ludesire lwankakuha erhi lukuyûshûlire?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kàli bisonga byoji omu nfune z’entwâli, makala g’omurhi gwa Yenista.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Namâhera nie mbà muli Mesheki","poem":1},{"noteId":5},{"text":", nie mpanzire e Kedari.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwo nyûbasire omu karhî kâbo, balya barhakwirirwa murhûla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oku ndi nti omurhûla, bôhe mpu entambala là.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"120, 5 Mesheki: cihugo ciri hôfi n’Enyanja Nyîru. Kedari: omu irungu ly’e Sîriya.","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/shr_buk/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}