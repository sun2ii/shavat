{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":121,"content":[{"type":"heading","content":["Nyakasane ye mulanzi w’Israheli"]},{"type":"verse","number":1,"content":[{"text":"Lwimbo. Lwa kusoka.","descriptive":true},{"text":"Ngalamulîre amasù ebwa ntondo, Lêro owantabâla ngahi ayisha?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nyakasane ye wantabâla, ye wajiraga empingu n’igulu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Arhâzigè okugulu kwâni kwalabuka, arhahunira omulanzi okulanga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nêci, arhahunga arhânahunge, omulanzi olanga Israheli.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nyakasane ye kulanga Nyakasane ye mulanzi okuli aha burhambi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gubire mûshi, izûba lirhâkukomè, bubîre budufu, omwêzi gurhâkujire kurhi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nyakasane akucinga oku ngasi kubî, âfungira omûka gwâwe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Akulanga omu kubalama n’omu kushubûka buno n’ensiku zoshi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}