{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":123,"content":[{"type":"heading","content":["Rhulîkûze oku kagayo k’abacîbona"]},{"type":"verse","number":1,"content":[{"text":"Lwimbo lwa kusôka.","descriptive":true},{"text":"Ngalamulîre amasù emund’oli, We bà omu mpingu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kulyâla amasù g’abashizi, ganayêrekera enfune za ba nnawâbo,","poem":1},{"lineBreak":true},{"text":"kulyâla amasù g’omujà-kazi gahenekera enfune za nn’omumwâbo,","poem":1},{"lineBreak":true},{"text":"kwo amasù gîrhu gadwîrhe galolakwo Nyakasane Nyamuzinda wîrhu,","poem":1},{"lineBreak":true},{"text":"kuhika olukogo lwîrhu lumugwârhe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rhubêre nîrhu olukogo, Yâgirwa, rhubêre nîrhu olukogo,","poem":1},{"lineBreak":true},{"text":"barhulibuzize n’akagayo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Omurhima gwîrhu gwayihisirwe n’amasheka g’abacîbwîne bagale,","poem":1},{"lineBreak":true},{"text":"n’aka gâyo k’abacîbona.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}