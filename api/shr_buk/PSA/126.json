{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":126,"content":[{"type":"heading","content":["Okugaluka kw’abàli balulize"]},{"type":"verse","number":1,"content":[{"text":"Lwimbo lwa kusôka.","descriptive":true},{"lineBreak":true},{"text":"Erhi Nyakasane àgalula empira z’e Siyoni","poem":1},{"lineBreak":true},{"text":"kwo rhwàli nk’abalôrha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lêro akanwa kîrhu kanaciyunjula masheka,","poem":1},{"lineBreak":true},{"text":"n’endimi zîrhu zayunjula mwishingo.","poem":1},{"lineBreak":true},{"text":"Agandi mashanja gakaziderha, mpu:","poem":1},{"lineBreak":true},{"text":"Nyakasane abakolîre akirumè.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nêci Nyakasane arhujirîre birhali binyi,","poem":1},{"lineBreak":true},{"text":"rhw’oyu rhukola rhushagalusire.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Okûla rhuyôsire, Yâgirwa, okuhindule,","poem":1},{"lineBreak":true},{"text":"kula bahindula omugezi gw’ebumosho bw’izûba","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abarhwêra omu mulenge,","poem":1},{"lineBreak":true},{"text":"omu mwishingo basârûla.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Banagenda bajà balaka,","poem":1},{"lineBreak":true},{"text":"banagenda babarhwîre emburho barhwêra.","poem":1},{"lineBreak":true},{"text":"Erhi bagaluka erhi bayisha bacîshinga","poem":1},{"lineBreak":true},{"text":"n’emîha yâbo okw’irhwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}