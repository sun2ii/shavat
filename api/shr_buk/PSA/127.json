{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":127,"content":[{"type":"heading","content":["Okucîhira omu maboko ga Nyamuzinda"]},{"type":"verse","number":1,"content":[{"text":"Lwimbo lwa kusôka. Lwa Salomoni.","descriptive":true},{"text":"Nka Nyakasane arhayûbasiri enyumpa, abayiyûbaka erhi na busha bârhamira.","poem":1},{"lineBreak":true},{"text":"Nka Nyakasane arhalanziri olugo, omulâlîzi erhi na busha ârhamira.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Busha mwarhamira mpu mwazûka sêzisêzi burhacica,","poem":1},{"lineBreak":true},{"text":"mpu murhajigwîshira duba, mpu murhalya ehi murharhamiri,","poem":1},{"lineBreak":true},{"text":"kàli anashobôze abarhonyi bâge banali îrò!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kàli abâna ngalo ya Nyakasane, akarhenga omu nda luhembo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ababurhirwa ebusole, kwo bali nka bisonga omu nfune z’entwâli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ali w’iragi omulume obumbire omurhana gwâge myampi ya bene eyo,","poem":1},{"lineBreak":true},{"text":"enshonyi zirhâmubumbe amango ababisha bamujà aha lusò.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}