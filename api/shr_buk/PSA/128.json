"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nyakasane akugishe kurheng’e Siyoni,","poem":1},{"lineBreak":true},{"text":"ensiku zoshi z’obuzîne bwâwe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Obone oku Yeruzalemu agandâza,","poem":1},{"lineBreak":true},{"text":"obone abâna b’abâna bâwe.","poem":1},{"lineBreak":true},{"text":"Omurhûla gubè omu Israheli!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}