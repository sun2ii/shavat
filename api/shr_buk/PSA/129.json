{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":129,"content":[{"type":"heading","content":["Oku bashombanyi ba Siyoni"]},{"type":"verse","number":1,"content":[{"text":"Lwimbo lwa kusôka.","descriptive":true},{"text":"Mushâna wâni, kurhenga ndi murhò erhi banshimbulula, -Israheli nêci kuderhe-","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kurhenga ndi murhò erhi banshimbulula, ci barhampashaga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Abahinzi bàgwîra bampinga oku mugongo, bahumba bahumba;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nyakasane yêhe bula arhalyalyanya, àtwîra ababisha emigozi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Enshonyi zirhangibabumba, bashubire nyuma, balya boshi banashomba Israheli.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bashube nka câsi cimerera oku nyumpa, co ciyûma barhanacicishugula.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Co cirhabumba nfune z’owasârûla! nîsi erhi ecîbo c’owashûbûza ebirundo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N’abâgera barhâderhe, mpu: «Nyakasane amugishe»,","poem":1},{"lineBreak":true},{"text":"mpu: «Rhumugishire okw’izîno lya Nyakasane.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}