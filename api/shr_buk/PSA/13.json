{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":13,"content":[{"type":"heading","content":["Kuhika mangaci, Yâgirwa Nyakasane?"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Lulanga. Lwa Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":["Kuhika mangaci wayôrha onyibagira, Nyakasane?",{"text":"Kuhika mangaci wanfulika obusù bwâwe?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Kuhika mangaci nayôrha ntimanya amalibuko omu murhima gwâni?",{"text":"Kuhika mangaci omushombanyi wâni ayôrha ampima?","poem":1}]},{"type":"verse","number":4,"content":["Lolà, onshuze, Nyakasane Nyamuzinda, Nnâhamwîrhu!",{"text":"Ommolekere amasù, ndek’ijir’îrò omu lufù.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Omushombanyi alek’iderha, erhi: «Namuhimire!»",{"text":"Abanzi bâni balek’icîshinga babona njajâba.","poem":1}]},{"type":"verse","number":6,"content":["Niehe bwonjo bwâwe ncîkubagira:",{"text":"omurhima gwâni gucîshingire obucire bwâwe;","poem":1},{"lineBreak":true},{"text":"nyimbire Nyakasane oku minjà anjirire.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}