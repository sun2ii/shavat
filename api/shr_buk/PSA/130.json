{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":130,"content":[{"type":"heading","content":["Nyamuzinda ye shundwakwo obwonjo"]},{"type":"verse","number":1,"content":[{"text":"Lwimbo lwa kusôka.","descriptive":true},{"text":"Oku ndi emuhengere, Yâgirwa, nakuyâkûza.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waliha, yumva omulenge gwâni! amarhwîri gâwe garhegêre, gayumve izù ly’omusengero gwâni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Erhi wakalola ebyâha, Yâgirwa, Yâgirwa ndi wakayêra?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Câba aha burhambi bwâwe h’obwonjo bw’ebyâha bushundwa, mpu lyo bakukolera banakukenzire.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Niehe Nyamwagirwa ye ncîkubagîre, n’omurhima gwâni luderho lwâge gucîkubagire.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Omurhima gwâni gudwîrhe gwagungêza Nyakasane, kulusha kula omulâlîzi agungêza obucè.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kulusha omulâlîzi walinga oku lukula ârhanda, Israheli alinge Nyakasane.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yêne ye walîkûza Israheli, oku byâha byâge byoshi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}