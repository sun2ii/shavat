{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":133,"content":[{"type":"heading","content":["Akalamo k’ecinyabuguma"]},{"type":"verse","number":1,"content":[{"text":"Lwimbo lwa kusôka. Lwa Daudi.","descriptive":true},{"text":"Alà nka kwayinjiha, alà nka kwanuna, okubêra haguma cinyabuguma kw’abalondana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kwo kuli nka kula banadêkereza ensholo y’amavurha okw’irhwe, gahonere omu bwânwa, omu bwânwa bwa Aroni, gayandagalire omw’igosi ly’omushangi gwâge.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kwo kuli nka kula olumè lwa kuli Hermoni luyandagalira kuli Siyoni; kwo Nyakasane ahânira omugisho, n’akalamo kashinga emyâka n’emyâka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}