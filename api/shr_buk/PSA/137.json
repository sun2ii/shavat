{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":137,"content":[{"type":"heading","content":["Owayibagira ah’omunyunyu gwâge gubà erhi arhamubà"]},{"type":"verse","number":1,"content":[{"text":"Erhi rhwabâga rhudahîre","poem":1},{"lineBreak":true},{"text":"oku bikunguzo by’enyîshi z’e Babiloni,","poem":1},{"lineBreak":true},{"text":"yône mirenge rhwakàgidubula","poem":1},{"lineBreak":true},{"text":"erhi kufà Siyoni mungo kurhuma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kwarhuma ciru n’ennanga zîrhu rhukazimanika,","poem":1},{"lineBreak":true},{"text":"oku mirhi ya mw’eryo ihanga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Abarhuhekaga mw’eryo ihanga","poem":1},{"lineBreak":true},{"text":"erhi barhurhenza omu cihugo c’amasîma,","poem":1},{"lineBreak":true},{"text":"balinda bakala enshonyi z’okurhuhûna enyimbo, mpu:","poem":1},{"lineBreak":true},{"text":"«Rhuyimbiri enyimbo z’omwîshingo gw’e Siyoni.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kurhigi rhwakayimba enyimbo z’okukuza Nyakasane omw’ihanga lya bene?","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Yeruzalemu wêhe aha nakakuyibagira,","poem":1},{"lineBreak":true},{"text":"nankashingâna okulyo kwâni kwahozire.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nêci olulimi lwâni, waliha Yeruzalemu,","poem":1},{"lineBreak":true},{"text":"luyûmire ebiraka, aha nankakuyîbagira","poem":1},{"lineBreak":true},{"text":"nîsi erhi aha nankabula kuderha oku we murhanzi omu bansimîsa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kengêra Nyamwagirwa, kurhi bene Edomu bàjizîre Yeruzalemu","poem":1},{"lineBreak":true},{"text":"mpu ehyajirwe kuhika okw’ibuye lizinda.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kashâba we, mwâli wa Babeli,","poem":1},{"lineBreak":true},{"text":"ali w’iragi linene owabona amabî warhujirîre.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nêci ali w’iragi owagwârha ebirhaba byâwe","poem":1},{"lineBreak":true},{"text":"n’okubivunyungulira oku mabuye.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}