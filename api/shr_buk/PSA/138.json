{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":138,"content":[{"type":"heading","content":["Olwimbo lw’okuvuga omunkwa"]},{"type":"verse","number":1,"content":[{"text":"Lwa Daudi.","descriptive":true},{"text":"Nakugashâniza Nyamwagirwa, n’omurhima gwâni gwoshi,","poem":1},{"lineBreak":true},{"text":"bulya wayumvirhîze ebinwa byâni,","poem":1},{"lineBreak":true},{"text":"nkolaga nakuzihira embere za bamalahika bâwe,","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":["nkola nakuyimbira enyimbo z’obukuze,",{"text":"erhi nnankumbire bûbi omu ka-Nyamuzinda kâwe.","poem":1},{"lineBreak":true},{"text":"Nakuza izîno lyâwe,","poem":1},{"lineBreak":true},{"text":"erhi buzigire bwâwe n’okurhahemuka kwâwe kurhuma,","poem":1},{"lineBreak":true},{"text":"bulya eciragâne câwe càbîre ca mwâmi w’izîno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Olusiku nakufukamiraga wanyumvîrhiza,",{"text":"wanyûshûlira emisî y’omurhima.","poem":1}]},{"type":"verse","number":4,"content":["Nyamwagirwa, abâmi b’omw’igulu boshi bakuvuga omunkwa,",{"text":"bulya bàyumvîrhe ebirhangâzo by’ekanwa kâwe.","poem":1}]},{"type":"verse","number":5,"content":["Nêci bayimba enjira za Nnâmahanga,",{"text":"bulya irenge lya Nnâmahanga liri likulu lwoshi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Omu bukulu bwâge kurharhuma arhashîbirira abanyinyi,",{"text":"n’okukengula abacîbona binjà.","poem":1}]},{"type":"verse","number":7,"content":["Nkabâ omu maganya, onanzibuhye,",{"text":"onalambûle okuboko kwâwe wagombyamwo abanshomba, onancize.","poem":1}]},{"type":"verse","number":8,"content":["Nêci, obuzigire bwâwe buli bw’ensiku n’amango,",{"text":"omanye wankacilîkirira emikolo y’okuboko kwâwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}