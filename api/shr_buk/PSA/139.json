{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":139,"content":[{"type":"heading","content":["Irenge kuli olya oyishi byoshi"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Lulanga. Lwa Daudi.","descriptive":true},{"text":"Nyakasane, wandolêrize wammanya:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ntamîre, nyimanzire, orhahabiri,","poem":1},{"lineBreak":true},{"text":"enkengêro zâni oku ziciri kulî, erhi okola ozimanyire;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ngwîshîre, ndambagîre, erhi wambona,","poem":1},{"lineBreak":true},{"text":"enjira zâni zoshi ntà nguma ohabire.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Akanwa kanabè kacindi emurhima karhacihika oku lulimi,","poem":1},{"lineBreak":true},{"text":"erhi na mîra wakamanyaga koshi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ongwârhîre emalanga n’ebirhugo,","poem":1},{"lineBreak":true},{"text":"onandêkerîzekwo okuboko kwâwe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Obumanye buli ntyo bunsômîre bwenêne,","poem":1},{"lineBreak":true},{"text":"buntalusire bwenêne, ntakabuyumva.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngahi nakaja nderhe nti nkola ndi kulî n’omûka gwâwe?","poem":1},{"lineBreak":true},{"text":"Ngahi nakayâkira amasù gâwe?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nsôkîre emalunga, yo ôbà!,","poem":1},{"lineBreak":true},{"text":"ngwîshîre ekuzimu-bwînini, we Nnayo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Erhi nakalamukira mucêracêra,","poem":1},{"lineBreak":true},{"text":"nti njiyûbaka iduli ly’enyanja:","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ciru n’eyo munda nayo kuboko kwâwe kwayimpisa,","poem":1},{"lineBreak":true},{"text":"kulyo kwâwe kwayisha kundwîrhe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Erhi nakanderha, nti: «Ciru omwizimya gumbwîke,","poem":1},{"lineBreak":true},{"text":"n’obudufu bunzonge nka mûshi.»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Omwizimya wêhe gurhakubêra mwizimya,","poem":1},{"lineBreak":true},{"text":"n’obudufu kuli we kwo buli nka mûshi,","poem":1},{"lineBreak":true},{"text":"endundulya y’omwizimya kuli we kw’eri nka mûshi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"We waburungusagya ensiko zâni,","poem":1},{"lineBreak":true},{"text":"We wambumbaga omu nda ya nyâmà.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ncîkwitakîre bulya oku wanjirîre kusômerîne,","poem":1},{"lineBreak":true},{"text":"bulyâla emikolo yâwe eri ya kurhangâza.","poem":1},{"lineBreak":true},{"text":"Omurhima gwâni ogumanyire bwinjà,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"na ntà kavuha kandimwo ohabire.","poem":1},{"lineBreak":true},{"text":"Nabîre ndwîrhe nabumbwa bushâla-shâla,","poem":1},{"lineBreak":true},{"text":"nabîre ncidwîrhe nashwinjirwa omu kuzimu,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"erhi n’amasù gâwe mîra gabonaga ebijiro byâni,","poem":1},{"lineBreak":true},{"text":"erhi byoshi binakola biri biyandike omu citabu câwe;","poem":1},{"lineBreak":true},{"text":"ensiku zâni zayôrhaga ziri nganje,","poem":1},{"lineBreak":true},{"text":"erhi n’olurhanzi-rhanzi muli zo lurhacija oku nkuba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Enkengêro zâwe Nnâmahanga,","poem":1},{"lineBreak":true},{"text":"mbwîne ziri ndârhi; gunali mwandu, zirhankaganjwa!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Erhi nderha nti nziganje zoshi,","poem":1},{"lineBreak":true},{"text":"nashanga zo nyinji oku mushenyi;","poem":1},{"lineBreak":true},{"text":"erhi nankaderha nti namâyûsa lêro,","poem":1},{"lineBreak":true},{"text":"nnanashanga rhwembi rhuciri.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nyamuzinda, mâshi oyîrhe enkolamaligo,","poem":1},{"lineBreak":true},{"text":"n’abîsi b’abantu barhengeho omuntu!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bulyâla bàkugomîre okubozire,","poem":1},{"lineBreak":true},{"text":"abashombanyi bâwe bàrhwâmire kubî.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Abakushomba, Yâgirwa, kàli nâni kushomba mbashomba!","poem":1},{"lineBreak":true},{"text":"Ka mbonakwo abasharhirakwo Nyamuzinda!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kushomba mbashomba, ntabakwîrirwa,","poem":1},{"lineBreak":true},{"text":"omu masù gâni bali bagoma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Nnâmahanga, ondolêreze obone omurhima gwâni,","poem":1},{"lineBreak":true},{"text":"onjè emurhima obone enkengêro zâni.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wâbona oku arhali njira mbî ngeramwo,","poem":1},{"lineBreak":true},{"text":"ongeze omu njira y’abà mîra, Muhânyi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}