{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":14,"content":[{"type":"heading","content":["Isirhe ly’omuntu orhîshi Nnâmahanga"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Lwa Daudi","descriptive":true},{"text":"Omusirhe anakâderha omu murhima gwâge, erhi:","poem":1},{"lineBreak":true},{"text":"«Nyamuzinda arhahabà!»","poem":1},{"lineBreak":true},{"text":"Bàcisherêzize, bàjira ebirhankaderhwa;","poem":1},{"lineBreak":true},{"text":"ntà muntu okola aminjà ocibabâmwo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":["Kurhenga emalunga Nyakasane adwîrhe asinza bene-Adamu,",{"text":"mpu alole erhi bankacibonekanamwo ogwêrhe obukengêre,","poem":1},{"lineBreak":true},{"text":"ocidwîrhe alonza Nyamuzinda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Boshi boshi bahabusire, oku banali boshi bàsherîre,",{"text":"ntà muntu okola aminjà ocibabâmwo,","poem":1},{"lineBreak":true},{"text":"ntâye ciru n’ow’obufumu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Ka barhakayumva,",{"text":"abôla banyankola-maligo bakàmirangusa ishanja lyâni","poem":1},{"lineBreak":true},{"text":"nka kulya omuntu amirangusa omugati,","poem":1},{"lineBreak":true},{"text":"barhanashenga izîno lya Nyakasane?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Co cânarhume bajuguma n’obwôba buzira igwârhiro ly’ecôbà",{"text":"kulya kubà Nyamuzinda ayôrha abâ n’iburha ly’omushinganyanya.","poem":1}]},{"type":"verse","number":6,"content":["Kàli mwêhe mpu mwashekera ihano ly’omunyi,",{"text":"n’obwo Nyamuzinda ye lwâkiro lwâge!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Owabona obucire bw’Israheli buhubuka e Siyoni!",{"text":"Mango Nyakasane àgalula olubaga lwâge ekà,","poem":1},{"lineBreak":true},{"text":"Yakôbo acîshinga, Israheli asîme!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}