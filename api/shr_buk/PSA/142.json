{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":142,"content":[{"type":"heading","content":["Omusengero gw’odwîrhe alibuzibwa anacîfulisire"]},{"type":"verse","number":1,"content":[{"text":"Lwigânwa. Lwa Daudi. Amango àli omu lukunda. Lulanga.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Izù linene nâyakûzamwo Nyakasane, Izù linene nâyingingamwo Nyamwagirwa.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Omu masù gâge narhûla omutula gungwêrhe, embere zâge nabulagira oburhè bungwêrhe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Obu omûka gunfundîremwo; câba orhahabiri enjira yâni. Enjira nâyishamwo, bantegîremwo olubambo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndozir’ekulyo nnambwîne, ci ntâye mbwîne wankanshîbirira. Ntaho mbwîne nakayâkira, na ntâye mbwîne wakafungira omûka gwâni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"We nyâkûzize, Yâgirwa; We nabwîra, wêne lwâkiro lwâni, Weri gwâni mwanya mw’er’igulu ly’abazîne.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yumvîrhiza omulenge gwâni, bulyâla mbengîre kurhali kunyi. Ndîkûza kuli aba banshimbire, bulyâla bandushire misî.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nkûla mw’eyi mpamikwa, nvuge izîno lyâwe omunkwa. Abashinganyanya bakolaga bangorha, hano ôbà wamanjirira bwinjà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}