{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":146,"content":[{"type":"heading","content":["Iragi lyâge ocîkubagira Nnâmahanga"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Murhima gwâni kuza Nyamuzinda","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oku ncibamw’omûka, nâkazikuza Nyamwagirwa, amango goshi ncizîne nakâyimbira Nyamuzinda irenge.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mumanye mwakakâlangâlira abaluzi, nîsi erhi okucîkubagira iburha ly’omuntu elirhaciza,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"erhi omûka gumurhengamwo anashubire omu budaka n’obwo emihigo yâge yoshi ehirigirhe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ali w’iragi oyu Nyamuzinda wa Yakôbo abà murhabâzi wâge, olangâlira Nnâmahanga Nyamwagirwa wâge.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nnâmahanga ye walemaga empingu n’igulu, enyanja n’ebiyibâmwo byoshi. Azibuhize endagâno zâge ensiku zoshi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Abalenganyire anabagalulire obushinganyanya bwâbo, ye yigusa abashalye n’ebiryo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Empira Nnâmahanga ye zirikûza, abahusire anabazibûle engohe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ye yimanza abagogomîrwe, Nnâmahanga azigira abîrhonzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nyamuzinda analange abakenyi, Ye lamira enfûzi n’abakana. Ci enjira z’abanya-byâha anaziyêrekeze erushâyo.","poem":1},{"lineBreak":true},{"text":"Nyamubâho ali Mwâmi, arhegeka emyâka erhaganjwa, wâni Siyoni, Nnâmahanga ali wâwe ensiku zoshi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}