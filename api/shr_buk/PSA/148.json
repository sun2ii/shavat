{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":148,"content":[{"type":"heading","content":["Empingu n’igulu bikuze Nyakasane"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Kuzagi Nyamuzinda kurhenga enyanya emalunga mumukuze oku nkuba.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mweshi Bamalahika bâge mumukuze, ninyu mweshi mirhwe yâge mumukuze.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mwe mwêzi n’izûba mumukuze mwe nyenyêzi zilangashana mumukuze.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mumukuze mwe malunga g’oku nkuba, ninyu mwe mîshi mubà emalunga mumukuze.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Byoshi bikuze izîno lya Nyakasane bulya kanwa kaguma kône àdesire byanabà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Abizibuhize emyâka erhaganjwa, àgwîsire irhegeko lirhakahindulwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Murhondêrere en’igulu mwamukuza, mwe biryanyi by’omu mîshi, ninyu mwe nyanja.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Omuliro, olubula n’olwikungu na ba-kalemêra, barhahumba irhegeko lya Nyamuzinda.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mwe ntondo n’orhurhondo rhwoshi emirhi y’amalehe n’emirhi yoshi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ensimba z’emuzirhu n’ebishwêkwa bya ngasi lubero, ebinyâgâsi n’ebinyunyi bibalala.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Abâmi b’igulu n’amashanja goshi, abaluzi ninyu batwî b’emmanja b’igulu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Emisole n’ensûli, abashosi n’abâna.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bakuze izîno lya Nyamuzinda, bulya izîno lyâge lyône liri likulu, irenge lyâge liri enyanya ly’igulu n’amalunga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ajîsize olubaga lwâge irenge, ngwârhiro ya bukuze oku barhonyi bâge, bo bâna b’Israheli, ishanja limuyêgêra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}