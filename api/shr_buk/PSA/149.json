{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":149,"content":[{"type":"heading","content":["Olwimbo lw’obuhimanyi"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Yimbiri Nnâmahanga olwimbo luhyâhya, irenge lyâge liyumvîkane omu ndêko y’abarhonyi bâge.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Israheli ashagalukire Nnâmahanga Mulemi wâge, abâna b’e Siyoni bacîtakîrire omwâmi wâbo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bakuze banasâmire izîno lyâge, bamuzihire ennanga banamurhimbire engoma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bulya Nyamuzinda ashagaluka n’olubaga lwâge, Ye ciza abanyinyi anabakuze.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Abarhonyi bâge banagandâze omw’irenge, banashagaluke n’omw’îrò.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Obukuze bwa Nnâmahanga burhabarhenga omu kanwa, omu nfune zâbo murharhenga engôrho ya môji abirhi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Y’okucîhôla amashanja, n’okuhana emirhwe","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Okuhanika abâmi bâbo n’enkoba, n’abaluzi bâbo omu caburhinda.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lyo olushika lwatûbagwa kuli bo luyunjula, lyo irenge lyàbikîrwe abarhonyi bâge boshi","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}