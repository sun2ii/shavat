":"line_break"},{"type":"verse","number":5,"content":["Arhahogeza bunguke,",{"text":"arhanalya mpyûlo mpu aheze omwêru-kwêru.","poem":1},{"lineBreak":true},{"text":"Oyôrha ntyo, ntà mango ankahuligana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}