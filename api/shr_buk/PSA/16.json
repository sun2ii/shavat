{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":16,"content":[{"type":"heading","content":["Nyakasane ye Mwîmo gwâni"]},{"type":"verse","number":1,"content":[{"text":"Lwa Daudi.","descriptive":true},{"text":"Yâgirwa Nyamuzinda, onnange,","poem":1},{"lineBreak":true},{"text":"bulya we lwâkiro lwâni.","poem":1}]},{"type":"verse","number":2,"content":["Nabwîzire Nnâmahanga, nti: «We Nyakasane»,",{"text":"«Nnâhamwîrhu, buzira we ntà kwinjà».","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Abimâna bali omu cihugo,",{"text":"bo Nnâmahanga arhonya.","poem":1}]},{"type":"verse","number":4,"content":["Abandi bashiga abazimu,",{"text":"kuyûshûla bacîyûshûlira obuhanya.","poem":1},{"lineBreak":true},{"text":"Barhakabona nahuma omu mwamba gw’embâgwa zâbo,","poem":1},{"lineBreak":true},{"text":"barhakàyumva mpu amazîno gâbo gampisire ekanwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Waliha Nyamuzinda, we cigabi câni c’omwîmo,",{"text":"we na kabehe kâni,","poem":1},{"lineBreak":true},{"text":"we gwêrhe obuzîne bwâni omu maboko gâwe.","poem":1}]},{"type":"verse","number":6,"content":["Olugero bàntambagizagyamwo lwangerîre oku nsîmire,",{"text":"ecigabi câni c’omwîmo ciri cinjà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Ayâgirwe Nyakasane ôkampà ihano,",{"text":"ciru n’obudufu nanyumve ihano lyampubuka omu ndubi y’omurhima.","poem":1}]},{"type":"verse","number":8,"content":["Amasù gâni gayôrha gasinza Nyakasane ngasi mango,",{"text":"kulya kubà andi ebulyo, ntankahuligana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["Co cirhumire omûka gwâni gusîma n’omûka gwâni gucishinga;",{"text":"ciru n’omubiri gwâni guluhûsire omu murhûla.","poem":1}]},{"type":"verse","number":10,"content":["Bulya orhankalikirira omûka gwâni omu kuzimu,",{"text":"orhankanaziga omwîra wâwe abolera omu nshinda.","poem":1}]},{"type":"verse","number":11,"content":["Wanyêreka enjira y’akalamo,",{"lineBreak":true},{"text":"obwimâna bw’amasîma omu kubona obusù bwâwe,","poem":1},{"lineBreak":true},{"text":"ekulyo kwâwe, mwîshingo gw’ensiku n’amango.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}