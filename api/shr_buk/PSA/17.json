{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":17,"content":[{"type":"heading","content":["Omulenge gw’omwêru-kwêru odwîrhe walibuzibwa buzira kumanya ecirhumire"]},{"type":"verse","number":1,"content":[{"text":"Musengero. Gwa Daudi.","descriptive":true},{"text":"Yâgirwa Nyamuzinda, oyumvîrhize omwêru-kwêru,","poem":1},{"lineBreak":true},{"text":"oyumve endûlù yâni; orhege okurhwiri,","poem":1},{"lineBreak":true},{"text":"oyumvîrhize omusengero gwâni","poem":1},{"lineBreak":true},{"text":"gwahubuka omu kanwa karhalyalyanya.","poem":1}]},{"type":"verse","number":2,"content":["Olubanja lwâni lutwirwe embere zâwe;",{"text":"amasù gâwe gabwîne oku ndi mwêru-kwêru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Wanalola omu ntimanya z’omurhima gwâni onantangule budufu;",{"text":"wanantangula: orhankambonamwo bubî.","poem":1}]},{"type":"verse","number":4,"content":["Akanwa kâni karhakola maligo nka kula abantu bajira;",{"text":"oluderho lw’ekanwa kâni nalulanzire.","poem":1}]},{"type":"verse","number":5,"content":["Olugendo lwâni lurharhenga omu njira z’amarhegeko gâwe,",{"text":"ntà mango amagulu gâni gajajâba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Nkulakire, kulya kubà onyumva,",{"text":"Yâgirwa Nnâmahanga; ontege okurhwiri,","poem":1},{"lineBreak":true},{"text":"oyumve eci naderha.","poem":1}]},{"type":"verse","number":7,"content":["Oyerekane obwonjo bwâwe,",{"text":"we ciza abalongeza olwâkiro omukulyo kwâwe;","poem":1},{"lineBreak":true},{"text":"obalîkûze oku babisha bâbo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Onnange nka mbonyi y’isù,",{"text":"onfulike omu kwaha kwâwe.","poem":1}]},{"type":"verse","number":9,"content":["Onfulike emihera ekantindibuza;",{"text":"ondîkûze oku bashombanyi bâni bangosire bakâlonza okunyîrha.","poem":1}]},{"type":"verse","number":10,"content":["Amashushi gàbafunisire emirhima;",{"text":"akanwa kâbo nderho za bucîbone kaderha.","poem":1}]},{"type":"verse","number":11,"content":["Badwîrhe banyunja banakola bangosire;",{"text":"banniolire amasù mpu bannambike oku idaho","poem":1}]},{"type":"verse","number":12,"content":["Owababona anamanya mpu ntale elingûzize ensimba yalya",{"text":"mpu câna ca ntale cishurhamire omu bulambo bwâco.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Baduka Nyakasane, omujeyo, omushûrhe oku idaho;",{"text":"n’engôrho yâwe olîkûze obuzîne bwâni omu maboko g’Omuhera.","poem":1}]},{"type":"verse","number":14,"content":["Okuboko kwâwe kundîkûze kuli eyo mifù, Yâgirwa Nyakasane,",{"text":"bulya eyo mifù ecigabi câbo c’obuzîne coshi eco en’igulu.","poem":1},{"lineBreak":true},{"text":"Enda zâbo oziyunjuze n’ebi wababikiraga,","poem":1},{"lineBreak":true},{"text":"abâna bâbo bayigurhe, basigîre abinjikulu bâbo ebisigaliza.","poem":1}]},{"type":"verse","number":15,"content":["Niehe omu bushinganyanya, nayishibona obusù bwâwe;",{"text":"aha kuzûka, nyishiyigurha nkusinzakwo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}