{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":2,"content":[{"type":"heading","content":["Masiha ye Mwâmi w’e Siyoni n’ow’igulu lyoshi"]},{"type":"verse","number":1,"content":[{"text":"Kwo kurhi oku amashanja gakunire,","poem":1},{"lineBreak":true},{"text":"ganadwîrhe gahiga emihigo y’obusha?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Abâmi b’igulu bamâhuluza engoma,","poem":1},{"lineBreak":true},{"text":"nabo abaluzi bamâja ihano","poem":1},{"lineBreak":true},{"text":"mpu bagomere Nnâmahanga n’omwîshogwa wâge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Mpu: emigozi yâbo rhuyitwe,","poem":1},{"lineBreak":true},{"text":"rhunakabulire omuzigo gwâbo kuli nîrhu!»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Omu bwâmi bwâge Nnâmahanga adwîrhe asinz’emalunga,","poem":1},{"lineBreak":true},{"text":"Nyakasane adwîrhe abashekera.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Amâkunira amâbashuza,","poem":1},{"lineBreak":true},{"text":"omu bukunizi bwâge amâbayobohya.","poem":1}]},{"type":"verse","number":6,"content":["Erhi: «Niene nayimikaga Omwâmi wâni oku Siyoni»,",{"text":"«Oku ntondo yâni ntagatîfu».","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Lekagi nâni mmubwîre akanwa ka Nnâmahanga; àmbwîzire, erhi:",{"text":"«Oli mugala wâni, nie nkubusire ene».","poem":1}]},{"type":"verse","number":8,"content":["Ompûne eci wankalonza,",{"text":"nâni nâkuhà ebihugo byoshi bibè hyâwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["«Wabamalîra n’engôrho yâwe»,",{"text":"«onabavungunyule nka mubumbi wabera enyungu.»","poem":1}]},{"type":"verse","number":10,"content":["Lêro, mw’oyo bâmi, muyumve,",{"text":"ninyu batwî b’emmanja b’igulu mumanye!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Mukolere Nyamuzinda munamurhînye,"]},{"type":"verse","number":12,"content":["mucîkwêbe aha magulu gâge n’obwôba;",{"text":"buly’erhi ankakunira mwanahungumuka:","poem":1},{"lineBreak":true},{"text":"oburhè bwâge kwo buyâka caligumiza nka ngulumira.","poem":1},{"lineBreak":true},{"text":"Iragi lyâbo abamuyegemera!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}