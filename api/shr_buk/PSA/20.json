{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":20,"content":[{"type":"heading","content":["Nyamuzinda aciza mwâmi"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Lulanga. Lwa Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Mâshi Nyakasane akuyumvirhize omu lusiku lw’amalibuko, izîno lya Nyamuzinda wa Yakôbo likulange!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Akurhumire oburhabâle kurhenga ebwâmi bwâge butagatîfu anakulange kurhenga e Siyoni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ayibuke entûlo zâwe zoshi, anasîme enterekêro yâwe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Akushobòze eci omurhima gwâwe gucìfinja, anakurhabâle obone ehi olonza hyoshi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mâshi rhucîshingire okuhimana kwâwe, rhunashûrhire izîno lya Nnâhamwîrhu Nyamuzinda engoma. Nyakasane ayumvîrhîze ensengero zâwe zoshi!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lêro nkola mmanyire oku Nyakasane aciza omushîgwa-mavurha wâge; kurhenga ebwâmi bwâge butagatîfu bw’omu malunga amuyumvîrhiza, omu kurhwalihya okuboko kwâge mpu kuhimane.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Baguma ngâlè zâbo bacîkubagira, abandi endogomi zâbo; rhwêhe izîno lya Nyakasane Nnâhamwîrhu Nyamuzinda lyo rhucîkubagira!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bôhe bahimirwe banahirima, nîrhu rhuli bwimanga rhunazibuhire!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nyakasane, fungira mwâmi; orhuyumvîrhize olusiku rhwakubirikira.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}