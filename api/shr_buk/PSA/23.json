{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":23,"content":[{"type":"heading","content":["Lungere mwinjà"]},{"type":"verse","number":1,"content":[{"text":"Lulanga. Lwa Daudi. Nyakasane ye lungere onyâbula, ntâco ndagîrîrekwo.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Anampugire omu bulambo bw’akahasi kinjà; anampise aha nshôko y’amîshi naluhûkira.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho n’omurhima gwâni gwabombêrera; Ye ndwîrhe omu njira nnungêdu; erhi izîno lyâge lirhuma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ciru nankahonera omu kabanda k’omwizimya ntà mabî nyôbohire, bulya rhwembi rhunali. Akarhi kâwe n’obuhiri bwâwe bindi hôfi; byo bidwîrhe byantûliriza.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wanteganyiza ecîbo c’ebiryo, erhi n’abashombanyi bâni badwîrhe basinza. Irhwe lyâni wamâlibumba mavurha, n’akabehe kâni kayunjwîre cinyôbwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Iragi n’okubêrwa binkulikîre, ngasi lusiku lw’obuzîne bwâni. Omu mwa Nyakasane ncîbêrîre, ensiku n’amango.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}