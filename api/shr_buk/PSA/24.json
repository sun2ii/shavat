{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":24,"content":[{"type":"heading","content":["Obugashânize bw’okujà omu cirhînyiro"]},{"type":"verse","number":1,"content":[{"text":"Lulanga. Lwa Daudi.","descriptive":true},{"text":"Igulu n’ebibâmwo byoshi bibà bya Nyakasane, Ye Nnâmahanga goshi n’ebiremwa byâgo byoshi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ye walijeberezagya oku ndêko y’enyanja, àliyûbaka analizibuhya oku maliba g’enyîshi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndi wankarheremera oku ntondo ya Nyamuzinda, erhi ndi wankabêra omu bwâmi bwâge butagatîfu?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Omuntu w’amaboko mêru-kwêru n’ow’omurhima gucîre, olya orhahîra omurhima gwâge oku by’obunywesi, orhanalahira binyoma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oyo ye wâgishwe na Nnâmahanga, anacîranulirwe bwinjà na Nyakasane Muyôkozi wâge.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Eryo lyo iburha ly’abamulonza, iburha ly’abalonza okubona obusù bwa Nyamuzinda wa Yakôbo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mwe nyumvi, yimuki, yimuki, mwe nyumvi z’ensiku n’amango: hundusi Mwâmi w’irenge.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«Ye ndi oyo Mwâmi w’irenge?» «Ye Nnâmahanga ciri-misî, ntwâli, ye Nyakasane ohima entambala.»","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mwe nyumvi, yimuki, yimuki, mwe nyumvi z’ensiku n’amango, hundusi mwâmi w’irenge.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"«Ye ndi oyo mwâmi w’irenge?» «Nyamuzinda w’Emirhwe: yêne ye mwâmi w’irenge.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}