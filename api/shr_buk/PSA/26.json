{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":26,"content":[{"type":"heading","content":["Omusengero gw’omushinganyanya"]},{"type":"verse","number":1,"content":[{"text":"We wantwîra olubanja Yâgirwa, bulya ntalyâlyanya ntanadandabagana, bulya Nyakasane ye nyôrha mpizirekwo omurhima.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ontangule, Yâgirwa, onyenje obone, onjè emurhima, onanje omu nsiko, olole.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Obwinjà bwâwe burhantenga omu masù, nâni niene ntarhenga omu njira y’okunali kwâwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ntatamala ahâli ababî, ntanaja omu ndêko y’endyâlya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ntakwîrirwa endêko y’enkola-maligo, ntatamala ahâli encuku.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Obwêru-kwêru go mîshi ncîkalaba, ntanahwa ntakeya aha luhêro lwâwe, Nyamwagirwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuderha nti inmanyîse irenge lyâwe n’obwâlagale nnamanyîse abandi ebisômerîne byâwe byoshi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yâgirwa ntahimwa kurhonya eciriba c’enyumpa yâwe, n’ahantu irenge lyâwe lihanda.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Iroho lyâni orhaliganjiraga haguma n’ery’abanya-byâha, n’obuzîne bwâni orhabuhiraga haguma n’abahuma omukò.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amaboko g’abôla oku gayunjwîre kubî, n’okulyo kwâbo kudwîrhe entûlo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Niehe mwo ngera omu njira y’obwêru-kwêru, ondîkûze onambabalire.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Okugulu kwâni njira ya cidekêra kuyimanziremwo, nâkazikuliza Nyakasane aha abantu bali.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}