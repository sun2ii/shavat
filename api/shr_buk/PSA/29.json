{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":29,"content":[{"type":"heading","content":["Olwimbo kuli Nyamuzinda Nnankubâ"]},{"type":"verse","number":1,"content":[{"text":"Lulanga. Lwa Daudi.","descriptive":true},{"text":"Mukazirhûla Nyakasane, bene Lungwè we,","poem":1},{"lineBreak":true},{"text":"Mukazirhûla Nyakasane irenge n’obukulu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mukazirhûla Nyakasane irenge likwânîne izîno lyâwe, mukaziharâmya Nyakasane n’omwambalo gukwânîne.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Izù lya Nyamuzinda lirhalusire ery’amîshi, Nyamuzinda Nnâmahanga akûngwîre: amîshi manji-manji gacîhambage.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Izù lya Nyakasane obuhashe lijira wâni! Izù lya Nyakasane lirhaluga wâni!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Izù lya Nyakasane linahongole enduluma, Nyakasane anahongole enduluma z’e Libano.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Anarhume ecihugo ca Libano cahama nka mutwîrà arhume na Siriyoni ahama nka kanina ka mbogo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Izù lya Nyakasane linamanule engulumira y’omuliro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Izù lya Nyakasane linadirhimanye irungu, Nyakasane anageze irungu lya Kadesi mw’omusisi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Izù lya Nyakasane linakube emirhi lisige emizirhu bûmu-bûmu: n’omu ngombe yâge boshi kwo baderha, mpu: Aj’irenge!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nyakasane atamîre agandâza kurhaluka ecihonzi, Nyakasane ye wanayôrha ayîmire ensiku n’amango.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nyakasane ye wâyîsh’ihà olubaga lwâge emisî, Nyakasane ye wâyîsh’igisha ishanja lyâge omu kulihà. omurhûla.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}