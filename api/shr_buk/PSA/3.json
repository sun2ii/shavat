{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":3,"content":[{"type":"heading","content":["Omusengero gw’esêzi gw’omuntu oli omu marhabi"]},{"type":"verse","number":1,"content":[{"text":"Lulanga. Lwa Daudi. Amango al’iyasire omugala Absalomi.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":["Nyakasane, baluzire nka nzige",{"text":"abantezire bali banji-banji.","poem":1}]},{"type":"verse","number":3,"content":["Bali mwandu, abadwîrhe banshumika,",{"text":"mpu: «Ntâkwo Nnâmahanga ankacimuciza!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Ci we mpenzi yâni, Nyamwagirwa,",{"text":"we irenge lyâni we n’ihungiro lyâni.","poem":1}]},{"type":"verse","number":5,"content":["Nkayâkûza Nyakasane anayumve",{"text":"anayumve izù lyâni oku ntondo yâge ntagatîfu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Ngwîshîre, mpunzire, nsinsimusire,",{"text":"erhi Nnâmahanga ye nnancîkubagîre.","poem":1}]},{"type":"verse","number":7,"content":["Ntumvîrhi ngwêrhwe n’obwôba",{"text":"bw’ezîra ngabo zingosire.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Zûka, zûka, Nnâmahanga!",{"text":"ontenze omu marhabi, mâshi Nyakasane!","poem":1},{"lineBreak":true},{"text":"Enzigo zâni ozikolere buligo","poem":1},{"lineBreak":true},{"text":"eyo mihera erhacisigalanaga ciru n’elîno lyo linyi ekanwa.","poem":1}]},{"type":"verse","number":9,"content":["Nêci, Nyamuzinda ye ciza,",{"text":"Waliha, we bwangà bw’olubaga lwâwe!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}