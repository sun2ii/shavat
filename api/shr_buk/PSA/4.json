{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":4,"content":[{"type":"heading","content":["Musengero gw’ebijingo"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Oku luzihwa lusâlikwa n’emisî: Lulanga lwa Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":["Nkakulakira, oyumvîrhize izù lyâni, Yâgirwa,",{"text":"Nnâmahanga, mucîranuzi wâni:","poem":1},{"lineBreak":true},{"text":"Kàli nàlimbengîre, wanciza:","poem":1},{"lineBreak":true},{"text":"ndîkûza we kasinga, onayumvîrhize omusengero gwâni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Mwe bantu, mangaci mwaleka obudandalisi bwinyu,",{"text":"mangaci mwaleka okurhonya empûsi n’okulonza obunywesi?","poem":1}]},{"type":"verse","number":4,"content":["Ci mumanye bwinjà oku Nyamuzinda",{"text":"àjirîre omurhonyi wâge ecirhangâzo, nkamulakira, Nyakasane anayumve izù lyâni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Muyôbohe n’irhondo murhacijiraga ecâha,",{"text":"n’amango mukola muli aha ncingo,","poem":1},{"lineBreak":true},{"text":"mucîje emurhima, muhulike!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Murherekêre enterekêro z’okuli,",{"text":"mucîkwêbe omu maboko ga Nnâmahanga!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Banji bacîduduma, mpu:",{"text":"«Ndi wankacirhuha akalembe wâni?»","poem":1},{"lineBreak":true},{"text":"Yâgirwa Nyakasane, orhumolekere n’obumoleke bw’obusù bwâwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Waliha Nnâmahanga, omurhima gwâni oguyunjuze masîma,",{"text":"galushire ag’amango engano n’irivayi lyâbo biyêzire.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["Ncikolera aha ncingo n’omurhûla, na nkola ndi îrò:",{"text":"bulya we onyimangire wênene, Yâgirwa Nnâmahanga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}