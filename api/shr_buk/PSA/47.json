{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":47,"content":[{"type":"heading","content":["Nyamuzinda Mwâmi w’Israheli n’ow’igulu lyoshi"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Lwa bene Korè. Lulanga.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Mwe mashanja mweshi, mukome akagasha mucîtakîre Nyamuzinda n’enshagadu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bulya Nyakasane w’enyanya arhajîbwa omw’irhwe, ye Mwâmi Nn’amahanga goshi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ayansire amashanja agahira idako lîrhu, agayandaza burhaba aha magulu gîrhu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yêne acîshoga ishwa rhwayimamwo, ishwa omurhonyi wâge Yakôbo akazâg’icîtakîrira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nnâmahanga oyo warherema omu karhî k’orhuhababo, Nyakasane oyo wasôka emishekera yashekeza.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Muzihire Nnâmahanga, muzihe, muzihe; muzihire Nnawîrhu, muzihe, muzihe!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bulyâla Nyamuzinda, ye Mwâmi w’igulu lyoshi lyoshi, mumuzihire olulanga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nyamuzinda ye wârhegeka amashanja goshi, Nyamuzinda oyôla otamîre oku ntebe yâge ntagatîfu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Abaluzi ba ngasi ishanja batamîre aha ngombe, batamîre boshi n’ishanja lya Abrahamu.","poem":1},{"lineBreak":true},{"text":"Abaluzi ba ngasi ishanja boshi banali bagula ba Nyamuzinda, ali w’enyanya bwenêne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}