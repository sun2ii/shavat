{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":5,"content":[{"type":"heading","content":["Omusengero gw’esêzi"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Oku rhurhêra. Lulanga lwa Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":["Oyumvîrhize izù lyâni, Yâgirwa Nyakasane,",{"text":"omusengero gwâni oguyumve.","poem":1}]},{"type":"verse","number":3,"content":["We ndwîrhe nâganîza, Mwâmi wâni na Nyamuzinda wâni,",{"text":"we nsengîre Yâgirwa Nyakasane.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Erhi gubà mucêracêra,",{"text":"erhi mîra izù lyâni lyahikaga emund’oli;","poem":1},{"lineBreak":true},{"text":"sêzi-sêzi erhi nkola ndwîrhe nakusêngera nandwîrhe nalangûza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Bulya orhali Nyamuzinda wa kusîma mabî,",{"text":"Yâgirwa; enkola-maligo orhankaziga yakujaho","poem":1}]},{"type":"verse","number":6,"content":["Nanga, emihera erhankakuyimangaho",{"text":"abajira ebigalugalu, orhababâkwo","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Abaderha obunywesi, kuheza obaheza;",{"text":"omuntu osîma omukò n’olyaliha,","poem":1},{"lineBreak":true},{"text":"Nyamuzinda arhamubonakwo","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Ci niehe, bwonjo bw’obuzigire bwâwe bunene burhumire,",{"text":"najà omu mwâwe; nacîkweba oku idaho,","poem":1},{"lineBreak":true},{"text":"nkuharâmye omu bwâmi bwâwe butagatîfu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["Nyakasane, onange omu bushinganyanya bwâwe,",{"text":"bulyâla abanzi bampisire eka;","poem":1},{"lineBreak":true},{"text":"enjira yampisa emwâwe, oyiyumanyanye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Bulyâla omu kanwa kâbo murhabà oburhali bunywesi,",{"text":"omurhima gwâbo guyunjwîre bubî;","poem":1},{"lineBreak":true},{"text":"omurhima gwâbo eri nshinda nyigule,","poem":1},{"lineBreak":true},{"text":"n’olulimi lwâbo kali kêre ka môji abirhi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Obamalîre, Yâgirwa Nyamuzinda",{"text":"ojire batulikanyè n’emihigo yâbo mibî;","poem":1},{"lineBreak":true},{"text":"obakage, batumbaguze,","poem":1},{"lineBreak":true},{"text":"abo banyankola-maligo, bulya bàkugomîre!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Ci abacikwîkubagira, barhulûle banasîme;",{"text":"bacîkwitakire emyâka n’emyâka bulya bayimangîrwe nâwe;","poem":1},{"lineBreak":true},{"text":"bacîshinge muli we abasîma izîno lyâwe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Bulya we Nyamuzinda, we hà omushinganyanya obwangâ;",{"text":"we mucinga n’obuzigire bwâwe,","poem":1},{"lineBreak":true},{"text":"nka kula empenzi ecinga entwâli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":13}