{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":52,"content":[{"type":"heading","content":["Okutwa olubanja lw’omulenzi"]},{"type":"verse","number":1,"content":[{"text":"Gwarhi omukulu w’abimbiza. Nyigîrizo. Za Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Amango Dwege w’e Edomu àyishig’ibwîra Saulu, erhi: «Daudi ajìre omu mwa Abimeleki».","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kurhi okwo walimbira obubî, wâni cikala-nshonyi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ngasi mango erhi na bubî warhânya, obulijira olulimi lwôji nka lugembe, nyankola-maligo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amabi g’orhonya oku minjà, obunywesi bw’oyumva orhonyize oku iderha linja!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ebinwa bibi orhabikubwakwo, kanywesi!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Okwôla kwârhuma Nyamuzinda akushâba buyumpa, akushugule budundu, kwârhuma akubarhûla omu cihugo, akumânyule oku igulu ly’abazîne.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Abashinganyanya bamubona bageremw’omusisi, oku bundi bamukwame, mpu:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«Y’oyo omwîra winyu wàbulaga bwajira Nyamuzinda lwakiro lwâge: akaz’icîkubagira obunji bw’ebirugu byâge, akaz’ilimbira ebyâha byâge!»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Niehe kwo ndi nka muzêti gujininira omu ka-Nyamuzinda; olukogo lwa Nnâmahanga lwo ncîkubagira ensiku n’amango.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nakaz’ikukuza ensiku zoshi bulya wakozire, nakaz’ikuza izîno lyâwe omu masù g’abarhonyi bâwe, bulya liri linja.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}