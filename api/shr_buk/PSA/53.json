{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":53,"content":[{"type":"heading","content":["Obuhwinja bw’omuntu olahira Nyamuzinda"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Oku ndwâla. Lwimbo. Lwa Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Omuhwinja anaderhe, erhi: «Nyamuzinda arhahabà!» Bàhabusire, bàjizire eby’okugayîsa, ntâye ojira aminjà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kurheng’enyanya Nyamuzinda asinzize ababurhwa n’abantu alole erhi abonamwo omuntu w’obwenge amulongereza.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Boshi bàherîre haguma, boshi bàsherîre; ntâye ojira aminjà ciru n’omuguma!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ewe! k’abajira amabî barhayengeha, bala bashanshanyula omulala gwâni nka kula balya omugati? Ka barhashenga Nyamubâho?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Banîre omushunzi, n’obwo ntâbyo bibayôbohize, bulya Nyamuzinda ashandâza ebivuha bya balya balikugosire; enshonyi zâbabumbire, bulya Nyamuzinda anabakabulîre boshi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lêro ndi walêrhera Israheli obucire bwarhenga e Siyoni? Hano Nyamuzinda agalula empira z’omulala gwâge Yakôbo âshagaluka, Israheli asîme.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":7}