{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":54,"content":[{"type":"heading","content":["Izù lyayâkûza Nyamuzinda Mucîranuzi"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Oku nzihwa z’emisî. Nyigîrizo. Za Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Amango abantu b’e Zif bàlibwîra Saulu, mpu: «Ka Daudi arhali e mwîrhu acîfulisire obu?»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mâshi Nyamuzinda oncize n’izîno lyâwe mâshi, ontwîre nâni luno lubanja oku buhashe bwâwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yâgirwa Nyamuzinda mâshi, yumvîrhiza omusengero gwâni, rhega okurhwiri oyumve ebinwa byâni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kulya kubà balya bacîgenza banyandûsirekwo, balya b’ecikalarhu nabo banshimbire mpu bantenzemw’omûka.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Awa, Nnâmahanga oyûla oli ntabâla, Nyakasane ye Nyamwegemerwa w’omûka gwâni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Abashombanyi bâni orhangibayêrekeza obuhanya n’oku bwinjà bwâwe, Nyamuzinda obashâbe buyumpa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nnonzize nkurhûle enterekêro, nnangashânize izîno lyâwe, Nyakasane, bulya liri linjà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kulya kubà lyândikûzize oku ngasi mbaka, nanabwîne oku abashombanyi bâni bacôcoboka n’enshonyi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}