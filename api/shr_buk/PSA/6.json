{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":6,"content":[{"type":"heading","content":["Amingingo omu marhangulo"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Oku nzihwa zishwêkwa n’emisî. Oku izù lya kali munâni. Lulanga. Lwa Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":["Yâgirwa Nyamuzinda, orhampanaga omu burhè bwâwe,",{"text":"orhanankalihiraga omu bukunizi bwâwe.","poem":1}]},{"type":"verse","number":3,"content":["Mâshi Nyakasane, ombêre obwonjo ntà misî ncigwêrhe,",{"lineBreak":true},{"text":"nfumya, Yâgirwa Nnâmahanga,","poem":1},{"lineBreak":true},{"text":"bulya enjingo z’orhuvuha rhwâni zikola zihozire.","poem":1}]},{"type":"verse","number":4,"content":["Omurhima gwankangusire,",{"text":"nâwe, we Nnâmahanga kuhika mangaci?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Galuka, mâshi Yâgirwa Nyakasane onyôkole;",{"text":"oncize buzigire bwâwe burhumire.","poem":1}]},{"type":"verse","number":6,"content":["Bulya ntâye ofîre wankacikuyibuka",{"text":"ndi wankakukuza kurheng’e kuzimu?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Ndi bufà erhi maganya garhuma",{"text":"erhi binajinga, nanyongoberere omu lwôgo lwâni","poem":1},{"lineBreak":true},{"text":"oku narhoga emirenge, ncîkwêbe omu ncingo yâni.","poem":1}]},{"type":"verse","number":8,"content":["Amasù gakola ganduma erhi mirenge erhuma,",{"text":"abashombanyi bâni boshi bagahûsa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["Ntengiho mweshi banyankola-maligo",{"text":"bulya Nyamuzinda ayumvîrhîze emirenge yâni.","poem":1}]},{"type":"verse","number":10,"content":["Nnâmahanga ayumvîrhîze izù lyâni;",{"lineBreak":true},{"text":"Nyakasane ayumvîrhîze omusengero gwâni.","poem":1}]},{"type":"verse","number":11,"content":["Abashombanyi bâni boshi bafè n’obôba,",{"text":"enshonyi zibayîrhe bagaluke cinyumanyumà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}