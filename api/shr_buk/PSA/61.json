{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":61,"content":[{"type":"heading","content":["Omusengero gw’olulizîbwe"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Oku nzihwa z’emisî. Lwa Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Oyumve guno mulenge gwâni mâshi Nnâmahanga, orhege guno musengero gwâni amarhwîri.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndwîrhe nakubirikira na ndi ekulî, bulyâla amagala gandîre. Ondengereze okw’ibuye onampè obuluhûkiro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wêne we lwâkiro lwâni we n’ibuye ncîfulikaho nka nshimbirwe n’omubisha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kurhi nankabona nabêra omu mwâwe ensiku zoshi, mbone nyâkîre omu lukangà lw’ebyûbi byâwe wâni!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nnâmahanga, nêci wayumvirhize omusengero gwâni, wanshobôzize akashambala abakenga izîno lyâwe bashobôla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ensiku za mwâmi ozihirekwo ezindi, emyâka yâge eyumânane n’ey’owamayâlusa kanji kanjî.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ayôrhe arhegeka omu masù ga Nyamuzinda, omurhumîre oburhonyi n’obudahemuka bikaz’imulanga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nyimbirage izîno lyâwe obwo nnanyûkirize emihigo yâni bwaca bwayira.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}