{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":63,"content":[{"type":"heading","content":["Omwîfinjo gw’okubona Nyamuzinda"]},{"type":"verse","number":1,"content":[{"text":"Lulanga. Lwa Daudi. Amango àli omu irungu lya Yûda.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Nnâmahanga we Nyamuzinda wâni, w’ono ndwîrhe nalongereza. Nyôrha yâwe omurhima gwâni gwalwâla, ndwîrhe nakwifinja nieshi nieshi nka kul’idaho lyûmu licîfinja amîshi bwenêne.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nkulolekwo omu bwâmi bwâwe, mbone bulya buhashe bwâwe n’irenge lyâwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Okurhona emund’oli kulushire obuzîne, akanwa kâni kakukuze là.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oku nciyîs’omûka erhi kugashâniza nnankugashâniza, nalengereza amaboko emund’oli okukuza izîno lyâwe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Omurhima gwâni gudendêze obwo ak’owalyag’ey’amashushi, n’akanwa kâni kayunjule mwishîngo kanakukuze.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Erhi nacikukengera nangwishîre, obudufu bunakule erhi wêne nakengêra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bulya nêci washubire mufungizi wâni, n’omu byûbi byâwe nuno ndwîrhe nacîshingira.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Omurhima gwâni gukwishwekìrekwo; n’okulyo kwâwe kwo nyegemîre","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Balya badwîrhe balonza okumpeza, bajè omuw’idaho kuli kulî.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Engôrho ebamîme, ebibwa bibashêge,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mwâmi yêhe Nnâmahanga acîtakîra; ngasi muntu ocîtakìra Nyamuzinda kukuzibwa anakuzibwa, bulya akanwa kaderha ebibî kuhumbârhala kanahumbârhala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":12}