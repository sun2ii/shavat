{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":64,"content":[{"type":"heading","content":["Enkola-maligo zimanye aha zafumira Nyamuzinda"]},{"type":"verse","number":1,"content":[{"text":"Oku mukulu w’abimbiza. Lulanga. Lwa Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yumva omulenge gwâni, mâshi Nnâmahanga, kulaka kuno ndimwo. orhenze ebihamba bindi emirhima.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oncinge okw’ihano ly’ababî, n’oku kavulindi ka zira nkola-maligo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kwo zirhyaza olulimi nka ngôrho, kwo zimeshera ebinwa bibî nka kula zirîka mwampi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zo zira nkola-maligo zikaz’icîfulika mpu ziyâgaze omuhanya, mpu zimuyûbûke zimuyâgaze, zirhânababale bici.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Obubî lusima zibujîra, bwifulikwè zilâlira okurhega emirhego, mpu: «Ka hali owârhubone?»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Enkola-maligo bibî zigerereza, kufulika zikaz’ifulika enkengêro zikengire. Nêci wâni, omurhima gwa bene nyenga!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ohumbe kwône, Nyamuzinda azirikiramwo emyampi, zifuduke zamâyagalika.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lulimi lwâbo lwâbaheze, ngasi yêshi wâbalolekwo, okw’idaho ânameshere.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ikola lya Nyamuzinda boshi balirhînya banalikuze, ebijiro byâge byoshi byâhizâna.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Omushinganyanya kucîshinga acîshinga anashamambire Nyakasane; n’ab’omurhima nkana boshi, irenge bâja.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}