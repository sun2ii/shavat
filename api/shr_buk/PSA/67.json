{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":67,"content":[{"type":"heading","content":["Omusengero gw’olubaga nka lwamâyus’isârûla emyâka"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Oku nzihwa z’emisî. Lulanga. Lwimbo.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Nyakasane Nyamuzinda arhubabalire anarhugishe, arhumolekere n’obusù burhulwîre.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Abantu boshi bamanye enjira zâwe, n’amashanja goshi gamanye obucunguzi bwâwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Igulu lyoshi likukuze linakuvuge omunkwa, Yâgirwa Nnâmahanga; igulu lyoshi likukuze linakuvuge omunkwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amashanja goshi gasime ganacîshinge, bulya oyishi cîranulir’abantu n’oburhondekezi; bulya we Mwâmi w’amashanja g’en’igulu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"lgulu lyoshi likukuze linakuvuge omunkwa, Yâgirwa Nnâmahanga; igulu lyoshi likukuze linakuvuge omunkwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Obudaka bwayezire emburho; Nnâmahanga Nyamuzinda wîrhu ye rhuhà omugisho.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nyamuzinda arhugishe, n’amahanga goshi gamurhinye en’igulu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}