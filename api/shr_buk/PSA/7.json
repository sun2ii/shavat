{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":7,"content":[{"type":"heading","content":["Omusengero gw’omushinganyanya odwîrhe alibuzibwa"]},{"type":"verse","number":1,"content":[{"text":"Endûlù ya Daudi, àyiyimbiraga Nyakasane erhi Kushi w’omu bûko bwa Benyamini orhumire.","descriptive":true}]},{"type":"verse","number":2,"content":["Nyakasane, Nyamuzinda wâni, we lwâkiro lwâni,",{"text":"ndîkûza oku badwîrhe bandibuza boshi, nciza nâni.","poem":1}]},{"type":"verse","number":3,"content":["Lyo balek’inshembagula nka kula entale eshembagula omuhanya:",{"text":"emusharhule na ntâye wahalîza mpu amulîkûza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Yâgirwa Nyamuzinda, ka najizire okwo,",{"text":"k’obubî buli omu maboko gâni?","poem":1}]},{"type":"verse","number":5,"content":["Ka najirîre orhampalalîri kubî,",{"text":"ka nashokwîre omushombanyi wâni buzira igwârhiro?","poem":1}]},{"type":"verse","number":6,"content":["Akabà najizire ntyo, omwanzi anyandukekwo anangwanyanye,",{"text":"andabarhe n’obûla bwâni anabushandâze omu budaka!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Yâgirwa Nyamuzinda, zûka omu bukunizi bwâwe,",{"text":"oburhè bw’abashombanyi bâni oburhange,","poem":1},{"lineBreak":true},{"text":"ondwîre, Nyakasane, bulya wêne warhegekaga mpu","poem":1},{"lineBreak":true},{"text":"olubanja lukâja aha kagombe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Omurhwe gw’amashanja gukuzunguluke,",{"text":"nâwe obarhegeke emalunga!","poem":1}]},{"type":"verse","number":9,"content":["Nyakasane, we mutwî w’emmanja w’amashanja,",{"text":"oncîranulire, Yâgirwa Nyamuzinda,","poem":1},{"lineBreak":true},{"text":"nyêre nka kulya obushinganyanya n’obwimâna bwâni bunali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Obubî bw’emihera buhwe,",{"text":"na ngasi oli mushinganyanya, omuzibuhye,","poem":1},{"lineBreak":true},{"text":"we yishi ebiri omu murhima n’omu nsiko,","poem":1},{"lineBreak":true},{"text":"Nyamuzinda mwimâna!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Nnâmahanga ye mpenzi yâni,",{"text":"ye ciza abantu b’emirhima eshingânîne.","poem":1}]},{"type":"verse","number":12,"content":["Nyamuzinda ye mutwî w’emmanja mwimâna,",{"text":"oburhè bwâge ntà lusiku burhûlûla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Abarhalonza okumugalukira, anabarhyagize engôrho yâge,",{"text":"asêze olugè lw’omuherho gwâge agufôle.","poem":1}]},{"type":"verse","number":14,"content":["Omuhera gwône gucirheganyiza emyampi y’olufù,",{"text":"gwône gurhuma yagulumira.","poem":1}]},{"type":"verse","number":15,"content":["Gw’ogwo gudwîrhe gwahiga emihigo y’obubî",{"text":"gudwîrhe gwârhimanya obulyâlya,","poem":1},{"lineBreak":true},{"text":"ci ibala gwacîlerhera!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":["Gudwîrhe gwarheganya omwîna n’okuguhumba,",{"text":"ci gwône gwarhogera mw’ogwo mwîna gwajiraga.","poem":1}]},{"type":"verse","number":17,"content":["Obubî bwâge bwâmunanira emalanga,",{"text":"obulenzi bwâge bwâmusêra oku irhwe nka ngarha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Niehe nâvuga Nnâmahanga omunkwa oku bushinganyanya bwâge,",{"text":"nâyimba izîno lya Nyamuzinda w’Enyanya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":18}