{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":70,"content":[{"type":"heading","content":["Okuhûna oburhabâle bwa Nnâmahanga"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Lwa Daudi. Aha kushwinja.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yâgirwa, oyêmêre ondîkûze nâni; Yâgirwa, okanye ontabâle.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lêro enshonyi zibagwarhe babulabule, balya boshi banninga mpu bankûlamwo omûka.","poem":1},{"lineBreak":true},{"text":"Bayêgûke enshonyi zibabumbe, balya bacîshingira okuhanyagala kwâni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zibabumbe basômerwe, balya bakaz’iderha mpu yihè-yihè.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bôhe balya bakulonza, bacîshinge banasîme muli we; na balya bakulingakwo oburhabâle, bakaz’iyôrha baderha mpu Nyakasane aganze!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Niehe ndi mukenyi nnandi muhanya? Nyamuzinda mâshi mâshi, ndwirâkwo.","poem":1},{"lineBreak":true},{"text":"We Mufungizi we na Muciza wâni: Biduha, mâshi Nyakasane!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}