{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":76,"content":[{"type":"heading","content":["Nyamuzinda ye hima byoshi"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Oku nzihwa z’emisî. Lulanga. Lwa Azafi. Lwimbo.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Nyamuzinda amanyîkîne omu ca Yûda, n’omu Israheli, izîno lyâge lyàjîre irenge.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ecirâlo câge mwo ciri cigwîke omu Salemu; n’oku Siyoni kw’obwâmi bwâge bubà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Avunirekwo emilazô y’emiherho, n’empenzi, n’engôrho n’amatumu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wayisha n’emisî, wamoleka nka cimole, wamanuka oku ntondo z’ensiku n’amango.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Entwâli mpu zinyagâge zànyagwa, mpu zihungâge zij’îrò, zàyumva amaboko gàrhoga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wakankama obwo, Nyamuzinda wa Yakôbo, babomboro n’ebihêsi byàgama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bakurhînye, orhajîbwa omw’irwe, erhi budârhi bw’oburhè bwâwe burhuma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kurheng’emalunga akanwa kâwe kàyumvikana: igulu lyàgeramw’omusisi lyanamerha.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nyamuzinda ayimuka obwo mpu aj’itwa emmanja, anagalukire abanyinyi babà okw’igulu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Edomu àkukuza omu burhè bwâge, n’abanyi bàsigîre omu Emati, bakujirira olusiku lukulu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mujire ebiragâne mubirhûle Nyakasane Nnâmahanga, abâli eburhambi bwâge barhûle Nyamuzinda entûlo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ye kûla abaluzi mw’omûka. Ye nageza abâmi b’igulu mw’omusisi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}