{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":8,"content":[{"type":"heading","content":["Irenge lya Lulema n’obukulu bw’omuntu"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Oku izîno lya Gati. Lulanga. Lwa Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":["Yâgirwa Nyamuzinda, Nnâhamwîrhu,",{"text":"izîno lyâwe lyàjîre irenge omu igulu lyoshi,","poem":1},{"lineBreak":true},{"text":"obukulu bwâwe buyunjwîre amalunga!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Akanwa k’abâna b’ebirhaba n’abaciyonka,",{"text":"karhubwiriza irenge lyâwe kanahulisa abashombanyi bâwe;","poem":1},{"lineBreak":true},{"text":"lyo abanzi n’abagoma bahirigirha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Nkalola amalunga eminwe yâwe yàmanikaga,",{"text":"n’omwêzi n’enyenyêzi walemaga:","poem":1}]},{"type":"verse","number":5,"content":["Omuntu aligi cici mpu wamuyibuka,",{"text":"mwene-Adamu aligi ndi mpu wamushîbirira?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["N’obwo wamujizire munyi hisungunu hyône kuli ba malahika,",{"text":"wamuyambika ishungwè ly’irenge n’obukuze.","poem":1}]},{"type":"verse","number":7,"content":["Wamujira mwâmi w’ebiremwa by’amaboko gâwe",{"text":"byoshi wabihizire aha magulu gâge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Ebibuzi n’enkafu, byoshi byoshi,",{"text":"ciru n’ensimba z’omu irungu;","poem":1}]},{"type":"verse","number":9,"content":["Enyunyi z’emalunga n’enfî z’omu nyanja,",{"text":"n’eby’omu mîshi byoshi","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Yâgirwa Nyamuzinda Nnâhamwîrhu,",{"text":"izîno lyâwe lyàjîre irenge omu igulu lyoshi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}