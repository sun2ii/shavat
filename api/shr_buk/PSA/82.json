{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":82,"content":[{"type":"heading","content":["Oku bacîranuzi b’endyâlya"]},{"type":"verse","number":1,"content":[{"text":"Lulanga. Lwa Azafi.","descriptive":true},{"text":"Nnâmahanga oyo wamâyimanga omu karhî k’ihano lya banyamuzinda, y’oyo wamâhumanula olubanja omu karhî kâbo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mpu: «Mangaci mwâleka okutwîra olubanya obulyâlya n’okuhà abayâzire olubanja?»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kaz’imufungire omuhanya n’ecirhaba, kaz’imushubize omunyi n’omukenyi ehyâge.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kaz’imulîkûze omuhanya n’omushalye, kaz’imumukûle omu nfune z’endyâlya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oku barhishi bici kwo barhanayumva, omu mwizimya bagenda, emitungo y’igulu yoshi kwo kuciha okw’idaho okwo mushâna!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Niehe kwo nali ndesire nti muli banyamuzinda mweshi, nti muli bagala b’Ow’Enyanya bwenêne.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N’okusiga ninyu kufà mwanafè ak’abantu, n’ekugulu kwinyu mukoba gwayizinde ak’abandi bagale.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nnâmahanga, yimuka otwîre igulu olubanja, bulyâla amashanja goshi we Nnago.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}