{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":87,"content":[{"type":"heading","content":["Siyoni, nnina w’amashanja goshi"]},{"type":"verse","number":1,"content":[{"text":"Lulanga. Lwa bene Korè. Lwigânwa n’emyambalo.","descriptive":true},{"text":"Nyakasane ahizire Siyoni oku nyanya z’entondo ntagatîfu","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Enyumvi z’e Siyoni zo arhonya kulusha ez’emwa Yakôbo zoshi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wàjir’irenge, lugo lwa Nyamuzinda!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rahabu na Babeli bâganjirwa omu bihugo bingashâniza, lolà oku Filistiya, Tiri n’abantu b’e Etiyopiya bâbwirwa, mpu: «Abà yo baburhwa e Siyoni».","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na hano bakola baderha Siyoni, mpu: «Boshi na boshi yo baburhwa», mpu: «Ow’Enyanya yêne wayûbakaga Siyoni.»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N’omu citabu c’amashanja Nyakasane àyandika, mpu: «Lebè na lebè yo baburhwa e Siyoni.»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hano bakola bahinda bayirnbe, mpu: «Siyoni wêne we nabâmwo enshôko zâni zoshi.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}