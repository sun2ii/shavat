{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":9,"content":[{"type":"heading","content":["(cihabr. 9): Nyamuzinda Mucîranuzi Mushinganyanya"]},{"type":"verse","number":1,"content":[{"text":"Gwârhi omukulu w’abimbiza. Nzihwa y’omu karhêra erhi lulanga. Lulanga. Lwa Daudi.","descriptive":true}]},{"type":"verse","number":2,"content":["Yâgirwa Nyamuzinda,",{"text":"nakukuza n’omurhima gwâni gwoshi,","poem":1},{"lineBreak":true},{"text":"namanyîsa ebirhangâzo byâwe byoshi.","poem":1}]},{"type":"verse","number":3,"content":["We busîme na mwishingo gwâni,",{"text":"nakuza izîno lyâwe, Nyakasane,","poem":1},{"lineBreak":true},{"text":"Nyamuzinda, Nn’emalunga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Bulya abashombanyi bâni bayâsire, bashubira nyuma,",{"text":"bajâjâbire banahungumuka embere zâwe.","poem":1}]},{"type":"verse","number":5,"content":["Nêci, wampîre ecâzo n’olubanja,",{"text":"watamala oku ntebe y’obwâmi,","poem":1},{"lineBreak":true},{"text":"we mutwî w’emmanja mushinganyanya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Walembya entumva, walimbula n’ebigamba,",{"text":"izîno lyâbo walizâza lwoshi oku nsiku n’amango.","poem":1}]},{"type":"verse","number":7,"content":["Abashombanyi bahirigirha lwoshi lwoshi,",{"text":"engabo zâbo wazishâba, n’aha bâli harhasigalaga cimanyîso.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Nyamuzinda yêhe ho ayôrha abà ensiku n’amango,",{"text":"ajeberîze entebe yâge y’obwâmi mpu atwe emmanja.","poem":1}]},{"type":"verse","number":9,"content":["Ye twîra igulu olubanja n’obushinganyanya,",{"text":"anacîranulire amashanja n’oburhondekezi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Mâshi Nyamuzinda abà lwâkiro lw’abadwîrhe barhindibuzibwa,",{"text":"lwâkiro omu mango g’obulagîrire.","poem":1}]},{"type":"verse","number":11,"content":["We bacîkubagira abayîshi izîno lyâwe,",{"text":"bulya orhalikirira abakulonza, Yâgirwa Nyakasane.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Muzihire Nyamubâho ôbà omu Siyoni,",{"text":"mubalire amashanja ebirhangâzo àjizire.","poem":1}]},{"type":"verse","number":13,"content":["Bulya ye cîhôlera omukò, abalibusire,",{"text":"omulenge gw’abagalugalu arhaguyibagira.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":["Yâgirwa Nyamuzinda, ombabalire,",{"text":"olole oku abashombanyi badwîrhe bantindibuza,","poem":1},{"lineBreak":true},{"text":"onshugule omu mihango y’olufù;","poem":1}]},{"type":"verse","number":15,"content":["Nderhe irenge lyâwe lyoshi,",{"text":"omu mihango y’omunyere w’e Siyoni,","poem":1},{"lineBreak":true},{"text":"ncîshingire obucire bwâwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":["Amashanja g’abapagani garhogîre omu nyenga bàhumbaga,",{"text":"omurhego bàrhegaga okugulu kwâbo kwagwârhwamwo.","poem":1}]},{"type":"verse","number":17,"content":["Nyamuzinda acîmanyîsize, atwa olubanja;",{"text":"agwâsa omunya-byâha omu mirimo y’enfune zâge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Emihera eshubire ekuzimu,",{"text":"aga mashanja goshi g’entumva gayibagire Nnâmahanga.","poem":1}]},{"type":"verse","number":19,"content":["Bulya omukenyi arhayibagirwa lwoshi lwoshi,",{"text":"obulangâlire bw’abanyi ntà mango bwankahirigirha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Zûka Nyamuzinda, omuntu ankahima;",{"text":"amashanja g’abapagani gatwîrwe olubanja omu busù bwâwe.","poem":1}]},{"type":"verse","number":21,"content":["Mâshi Nyakasane, obashûrhe ebihamba,",{"text":"abapagani bamanye oku bali bantu nk’abandi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}