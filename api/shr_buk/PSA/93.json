{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"PSA","translationId":"shr_buk","name":"Lulanga lwa","commonName":"Lulanga lwa","title":"ENNANGA","order":19,"numberOfChapters":150,"sha256":"55483bb8496ed45725d6db8a2627586120d55889da252080a0aa75f3b09c956f","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/shr_buk/PSA/150.json","totalNumberOfVerses":2515},"chapter":{"number":93,"content":[{"type":"heading","content":["Oku ngoma ya Nnâmahanga"]},{"type":"verse","number":1,"content":[{"text":"Nyakasane ayîmire, acîhundikîre obwâmi, Nyakasane acîhundikîre obuhashe, akenyîre bwinjinjà n’igulu àligwîsire buzibu, lirhankadundagana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kurhenga ensiku n’amango erhi entebe yâwe ebà ngwîke. Kurhenge ensiku n’amango erhi ho ôbà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Enyîshi zidwîrhe zakabanda, Yâgirwa, enyîshi zidwîrhe zakabanda erhi na kahababo enyîshi zidwîrhe zàshekêreza, zalujira erhi na lubî.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ci kwône obuhashe Nyakasane agwêrhe emalunga, bulushire izù ly’amîshi manji manji, bulushire akafurhè k’amayanjayanja.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Akanwa kâwe kanali ka kuyêmêrwa, enyumpa yâwe Yâgirwa enali ya kukengwa ensiku zoshi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/shr_buk/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}