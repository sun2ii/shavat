{"translation":{"id":"shr_buk","name":"BIBLIYA NTAGATIFU OMU MASHI","website":"https://ebible.org/Scriptures/details.php?id=shr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=shr","licenseNotes":null,"shortName":"BUK","englishName":"Mashi Bible","language":"shr","textDirection":"ltr","sha256":"d0acf3ec89bc33a67f59fef818d8d76884367403c5ab68c444f56c0ab7124b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/shr_buk/books.json","numberOfBooks":66,"totalNumberOfChapters":1192,"totalNumberOfVerses":31343,"languageName":"Shi","languageEnglishName":"Shi","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4110},"book":{"id":"SNG","translationId":"shr_buk","name":"Olwimbo","commonName":"Olwimbo","title":"OLWIMBO LW’ENYIMBO","order":22,"numberOfChapters":8,"sha256":"613031ab569a8d67fa733409a0889b7853ac4660a2ce07592425d815e592546d","firstChapterNumber":1,"firstChapterApiLink":"/api/shr_buk/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/shr_buk/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"heading","content":["Izîno ly’ecitabu n’enshula-mwanzi"]},{"type":"verse","number":1,"content":[{"text":"Olwimbo lw’Enyimbo. Lwa Salomoni.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ayishe anûnugurhe n’ehinûnugurho hy’akanwa kâge.","poem":1},{"lineBreak":true},{"text":"Okusîmwa nâwe kwo kununu ah’idivayi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amavurha ocîshizire alà nka gahumula bwinjà!","poem":1},{"lineBreak":true},{"text":"izîno lyâwe ciru lyône, mavurha gadubuka,","poem":1},{"lineBreak":true},{"text":"co cirhuma abanyere bakusîma","poem":1},{"noteId":0},{"text":".","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Onkeme nkushimbe, rhukanye!","poem":1},{"lineBreak":true},{"text":"Mwâmi ampesire omu mwâge;","poem":1},{"lineBreak":true},{"text":"We wâbà busîme na bushagaluke bwîrhu.","poem":1},{"lineBreak":true},{"text":"Okusîmwa nâwe kwarhulalusa kulusha idivayi","poem":1},{"noteId":1},{"text":";","poem":1},{"lineBreak":true},{"text":"Bayazize abakusîma».","poem":1}]},{"type":"heading","content":["Ecîtakîro cirhanzi"]},{"type":"verse","number":5,"content":[{"text":"Ndi mwîru ci ndi mwinjà","poem":1},{"noteId":2},{"text":", wâni mwe banyere b’e Yeruzalemu,","poem":1},{"lineBreak":true},{"text":"kwo ndi aka amahêma g’e Kedari, aka ebihando by’e Shalma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Murhalolaga omubiri gwâni mwîru, izûba eryo lyambabaga?","poem":1},{"lineBreak":true},{"text":"Bagala ba nyâmà","poem":1},{"noteId":3},{"text":"abâla bandubiraga, banjira mulanzi wa mizâbîbu.","poem":1},{"lineBreak":true},{"text":"Elyani ishwa ly’emizâbîbu ntalilangaga!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mbwîraga mâshi Muzigirwa w’omurhima gwâni:","poem":1},{"lineBreak":true},{"text":"ngahi wayâbulira obusò?","poem":1},{"lineBreak":true},{"text":"Ngahi waziyahula hano zirhenga omu izîko?","poem":1},{"lineBreak":true},{"text":"Lyo ntagija nageragera nka cirala","poem":1},{"lineBreak":true},{"text":"emunda amasò","poem":1},{"noteId":4},{"text":"g’abinyu gayabukire.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Akabà orhamanyiri wâni namwinja w’abakazi boshi","poem":1},{"noteId":5},{"text":",","poem":1},{"lineBreak":true},{"text":"okulikire enshando z’obusò","poem":1},{"lineBreak":true},{"text":"onayabulire abâna-hene bâwe","poem":1},{"lineBreak":true},{"text":"entambi z’ebwa bigala by’abangere.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Wâni Musimwa wâni,","poem":1},{"lineBreak":true},{"text":"namâkushushanya na kahesi wâni","poem":1},{"lineBreak":true},{"text":"bashwekire oku ngâlè ya Faraoni mwâmi w’e Mîsiri!","poem":1},{"noteId":6}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amarhama gâwe nka gayinjiha","poem":1},{"lineBreak":true},{"text":"aha karhî k’ebisikiyo,","poem":1},{"lineBreak":true},{"text":"alà ehigosi ogwêrhe omu karhî k’amagerha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bisikiyo bya masholo","poem":1},{"noteId":7},{"text":"rhwakulongeza","poem":1},{"lineBreak":true},{"text":"n’olugole lw’amarhale.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Oku nnakuno ali omu côgo câge,","poem":1},{"lineBreak":true},{"text":"n’obukù bwâni bwayuduka.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Omuzigirwa wâni hiri hirhù hya bukù,","poem":1},{"lineBreak":true},{"text":"hidekerire aha karhî k’amabêre gombi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Omuzigirwa ali cihadu ca mukû","poem":1},{"lineBreak":true},{"text":"omu ishwa ly’emizâbîbu y’e En-Gadi","poem":1},{"noteId":8},{"text":".","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"-Alà nka wayinjiha, Muzigirwa wâni, alà nka wayinjiha!","poem":1},{"lineBreak":true},{"text":"Amasù gâwe ziri ngûkù","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"-Nka wayinjiha Muzigirwa wâni,","poem":1},{"lineBreak":true},{"text":"nka wanuna wâni! Encingo","poem":1},{"noteId":9},{"text":"yîrhu ishamba.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"-Emitungo y’enyumpa yîrhu eri ya nduluma","poem":1},{"lineBreak":true},{"text":"n’oburhungiri buli bwa nsindani.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1, 3 Omuhya: Israheli yeri muhya wa Nyamuzinda: naye Nyamuzinda yêne ye Muhya-Mulume.","reference":{"chapter":1,"verse":3}},{"noteId":1,"caller":"+","text":"1, 4 Abanyere go mashanja. Arhali Israheli yêne walolakwo Nyamuzinda obucire. Agandi mashanja goshi nago ye Muciza wago. -Nyamuzinda ye Mwâmi w’oluhaga lwâge. -Omu ka-Nyamuzinda k’e Yeruzalemu. -Banaderha mpu omuntu anayigurhe obusîme. Omu Mwandiko Mutagatîfu namwo banaderhe mpu obusîme bunalaluse nka mamvu.","reference":{"chapter":1,"verse":4}},{"noteId":2,"caller":"+","text":"1, 5 Ndi mwîru ci ndi mwinjà: -Israheli arhahezagya obwinjà bwâge ciru akabà ali omu bujà e Babiloni. -Kedari na Shalma, bishagala by’e Buharâbu. Amahêma g’abagendagenda omu irungu (babedwini), gabà gajizirwe n’empù z’empene ganabà mîru.","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"+","text":"1, 6 Bagala ba nyâmà: Ngabo ya Bakaldeyi ba Nabukondonozori: bo bàshâbaga Yeruzalemu. Abakaldeyi bali bene wâbo Israheli bulya Abrahamu àli w’e Huri emwa Abakaldeyi (Murh 11, 28.31). -Bujà bw’e Babiloni. -Israheli oyo obujà bwakulaga aha mwâge, bwamuheka emwa bene.","reference":{"chapter":1,"verse":6}},{"noteId":4,"caller":"+","text":"1, 7 -Muzigirwa w’omurhima gwâni, nk’omuhya ye waderha -Nyamubâho ye Lungere wa Israheli. -Agandi masô, go gandi mashanja.","reference":{"chapter":1,"verse":7}},{"noteId":5,"caller":"+","text":"1, 8 Israheli, ishanja lîshogwa. Namwinja w’abakazi boshi ye Israheli, ishanja lîshogwa.","reference":{"chapter":1,"verse":8}},{"noteId":6,"caller":"+","text":"1, 9 Obujà bw’e Babiloni bushushine na bulya bw’e Mîsiri.","reference":{"chapter":1,"verse":9}},{"noteId":7,"caller":"+","text":"1, 11 Okuyambikwa ebisikiyo bihyâhya kuli kuyêrekwa oburhonyi: akolaga aleka ebi ali agwêrhe amango ali mujà, ayambale ebihyâhya. Rhulole muli Luk 15, 22.","reference":{"chapter":1,"verse":11}},{"noteId":8,"caller":"+","text":"1, 14 Olwo lugo kwo luderhwa buno mpu ye «Ain Djidi», omu iderha ly’Abaharâbu, ebwa Nyanja y’Omunyu. -Obusò n’abâna-hene, gwo muzinzi gw’abajà erhi aharhenga bujà. -Ntondo ya Siyoni yo abâmi b’Israheli bayûbakagakwo.","reference":{"chapter":1,"verse":14}},{"noteId":9,"caller":"+","text":"1, 16 Encingo, co cihugo ca Palestina-Israheli, cihugo cigishe, cirya ciyêramwo ngasi hyasi na ngasi lushogo.","reference":{"chapter":1,"verse":16}}]},"thisChapterLink":"/api/shr_buk/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/shr_buk/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/shr_buk/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}