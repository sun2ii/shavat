{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"2SA","translationId":"sna_bib","name":"2 Samueri","commonName":"2 Samueri","title":"2 SAMUERI","order":10,"numberOfChapters":24,"sha256":"5dbe59e0fda5b5297b19e86449681c7d651bfe46825919a7efe8fe42b92ab310","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/sna_bib/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["Rwiyo rwaDhavhidhi rwoKurumbidza"]},{"type":"verse","number":1,"content":["Dhavhidhi akaimbira Jehovha mashoko orwiyo urwu paakarwirwa naJehovha kubva muruoko rwavavengi vake vose nomuruoko rwaSauro."]},{"type":"verse","number":2,"content":["Akati:",{"text":"“Jehovha ndiye dombo rangu, nhare yangu uye mununuri wangu;","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Mwari wangu ndiye dombo rangu, ndinovanda maari,","poem":2},{"lineBreak":true},{"text":"nhoo yangu, norunyanga rworuponeso rwangu.","poem":2},{"text":"Ndiye nhare yangu, utiziro hwangu nomuponesi wangu,","poem":1},{"text":"munondiponesa pavanhu vanoita nechisimba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndinodana kuna Jehovha, iye anofanira kurumbidzwa,","poem":1},{"text":"uye ndinoponeswa kubva kuvavengi vangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Mafungu orufu akandikomba;","poem":1},{"text":"mvura zhinji yokuparadza yakandifukidza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mabote eguva akandimonera;","poem":1},{"text":"misungo yorufu yakandivinga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mukutambudzika kwangu ndakadana kuna Jehovha;","poem":1},{"text":"ndakadanidzira kuna Mwari wangu.","poem":2},{"text":"Akanzwa inzwi rangu ari mutemberi yake;","poem":1},{"text":"kuchema kwangu kwakasvika munzeve dzake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Nyika yakadedera uye ikazungunuka,","poem":1},{"text":"nheyo dzokudenga dzakadengenyeka;","poem":2},{"lineBreak":true},{"text":"dzakadedera nokuti akanga atsamwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Utsi hwakakwira kubva mumhino dzake;","poem":1},{"text":"moto unoparadza wakabuda mumuromo make,","poem":2},{"lineBreak":true},{"text":"mazimbe anopisa akapfutamo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akakamura matenga akaburuka pasi;","poem":1},{"text":"makore erima akanga ari pasi petsoka dzake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akatasva makerubhi akabhururuka;","poem":1},{"text":"akabhururuka mudenga denga pamapapiro emhepo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akaita kuti rima rimupoteredze setende,","poem":1},{"text":"iwo makore matema emvura yokudenga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kubva pakupenya kwokuvapo kwake","poem":1},{"text":"mabhananʼana emheni akapenya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jehovha akatinhira ari kudenga;","poem":1},{"text":"inzwi reWokumusoro-soro rakanzwikazve.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akapfura miseve akaparadzira vavengi,","poem":1},{"text":"mabhananʼana emheni akavaparadza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mipata yegungwa yakaiswa pachena","poem":1},{"text":"uye nheyo dzenyika dzakabudiswa pachena","poem":2},{"text":"nokutuka kwaJehovha,","poem":1},{"text":"nokufema kwomweya wemhino dzake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Akatambanudza ruoko ari kudenga akandibata;","poem":1},{"text":"akandibudisa kubva pamvura yakadzika.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Akandinunura kubva pamuvengi wangu ane simba,","poem":1},{"text":"kubva kuvavengi, vakanga vachindikurira pasimba.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Vakandivinga muzuva renjodzi yangu,","poem":1},{"text":"asi Jehovha akanga ari mutsigiri wangu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akandibudisira kunzvimbo yakafarikana;","poem":1},{"text":"akandinunura nokuti akanga achindifarira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Jehovha akandiitira zviri maererano nokururama kwangu;","poem":1},{"text":"maererano nokuchena kwamaoko angu, akandipa mubayiro.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nokuti ndakachengeta nzira dzaJehovha;","poem":1},{"text":"handina kuita chakaipa ndichitsauka kubva kuna Mwari wangu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mirayiro yake yose iri pamberi pangu;","poem":1},{"text":"handina kutsauka kubva pamitemo yake.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndakanga ndisina chandinopomerwa pamberi pake,","poem":1},{"text":"uye ndakazvichengeta kuti ndirege kutadza.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Jehovha akandipa mubayiro maererano nokururama kwangu,","poem":1},{"text":"maererano nokuchema kwangu pamberi pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Kune vakatendeka munoratidza kutendeka kwenyu,","poem":1},{"text":"kune vasina chavanopomerwa munoratidza kusapomerwa kwenyu,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kune vakachena munozviratidza makachena,","poem":1},{"text":"asi kune vasakarurama munozviratidza nehasha.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Munoponesa vanozvininipisa,","poem":1},{"text":"asi meso enyu ari pamusoro pavanozvikudza kuti muvaderedze.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Imi muri mwenje wangu, Jehovha;","poem":1},{"text":"Jehovha anoshandura rima rangu kuti rive chiedza.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Norubatsiro rwenyu ndinogona kuenda kundorwa neboka ravarwi;","poem":1},{"text":"naMwari wangu ndinogona kukwira rusvingo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":["“Kana ari Mwari, nzira yake yakarurama kwazvo;",{"text":"shoko raJehovha harina charingapomerwa.","poem":2},{"text":"Ndiye nhoo","poem":1},{"text":"yavose vanovanda maari.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nokuti ndianiko Mwari kunze kwaJehovha?","poem":1},{"text":"Uye ndianiko Dombo kunze kwaMwari wedu?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"NdiMwari anondishongedza nesimba","poem":1},{"text":"uye anoruramisa nzira yangu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Anoita tsoka dzangu kuti dzive setsoka dzenondo;","poem":1},{"text":"anoita kuti ndigone kumira pakakwirira.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Anodzidzisa maoko angu kurwa;","poem":1},{"text":"maoko angu anowembura uta hwendarira.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Munondipa nhoo yenyu yokukunda,","poem":1},{"text":"munokotamira pasi kuti mundikurise.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Munotambanudza nzira pasi pangu,","poem":1},{"text":"kuitira kuti zvitsitsinho zvangu zvirege kutsauka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“Ndakatevera vavengi vangu ndikavaparadza;","poem":1},{"text":"handina kudzoka kusvikira vaparadzwa.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ndakavaparadza zvachose,","poem":1},{"text":"uye havana kugona kumuka; vakawira pasi petsoka dzangu.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Makandishongedza nesimba rokurwa;","poem":1},{"text":"makaita kuti vadzivisi vangu vakotame patsoka dzangu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Makaita kuti vavengi vangu vatize pakurwa,","poem":1},{"text":"uye ndakaparadza vavengi vangu.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Vakachemera kubatsirwa, asi hakuna munhu akavaponesa,","poem":1},{"text":"kunyange kuna Jehovha, asi haana kupindura.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ndakavapwanya vakatsetseka seguruva renyika;","poem":1},{"text":"ndakavatswa uye ndikavatsika sedope riri munzira dzomumusha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"“Makandinunura kubva pakurwisa kwavanhu vangu;","poem":1},{"text":"makandichengetedza somutungamiri wendudzi.","poem":2},{"text":"Vanhu vandakanga ndisingazivi vava pasi pangu.","poem":1}]},{"type":"verse","number":45,"content":[{"text":"Uye vatorwa vanouya kwandiri vachidedera,","poem":2},{"lineBreak":true},{"text":"pavanongondinzwa vanonditeerera.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Vose vanoora mwoyo;","poem":1},{"text":"vanouya vachidedera kubva panhare dzavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Jehovha mupenyu! Dombo rangu ngarirumbidzwe!","poem":1},{"text":"Ngaakudzwe Mwari, iye Dombo, Muponesi wangu!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ndiye Mwari anonditsivira,","poem":1},{"text":"anoisa ndudzi pasi pangu,","poem":2}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"anondisunungura kubva kuvavengi vangu.","poem":2},{"text":"Imi makandikudza pamusoro pavavengi vangu;","poem":1},{"text":"kubva kuvanhu vanoita nechisimba, makandinunura.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Naizvozvo ndichakurumbidzai, imi Jehovha, pakati pendudzi;","poem":1},{"text":"ndicharumbidza zita renyu nenziyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“Iye anopa mambo wake kukunda kukuru;","poem":1},{"text":"anoratidza unyoro hwake kumuzodziwa wake,","poem":2},{"lineBreak":true},{"text":"kuna Dhavhidhi nezvizvarwa zvake nokusingaperi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}