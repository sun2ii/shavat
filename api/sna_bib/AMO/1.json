hi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndichavhuna suo reDhamasiko;","poem":1},{"text":"ndichaparadza mambo agere mumupata weAvheni","poem":2},{"text":"uye nouyo akabata tsvimbo youshe muBheti Edheni.","poem":1},{"text":"Vanhu veAramu vachaenda muutapwa kuKiri,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":6,"content":["Zvanzi naJehovha:",{"text":"“Nemhaka yezvivi zvitatu zveGaza,","poem":1},{"text":"kunyange zvina, handingadzori hasha dzangu.","poem":2},{"text":"Nokuti vakatapa rudzi rwose","poem":1},{"text":"uye vakavatengesa kuEdhomu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ndichatuma moto pamusoro pamasvingo eGaza","poem":1},{"text":"uchaparadza nhare dzake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndichaparadza mambo weAshidhodhi","poem":1},{"text":"uye nouyo akabata tsvimbo youshe muAshikeroni.","poem":2},{"text":"Ndichatambanudzira ruoko rwangu kuti ndirwise Ekironi","poem":1},{"text":"kusvikira vaFiristia vose vapera kufa,”","poem":2},{"text":"ndizvo zvinotaura Ishe Jehovha.","poem":4}]},{"type":"verse","number":9,"content":["Zvanzi naJehovha:",{"text":"“Nemhaka yezvivi zvitatu zveTire,","poem":1},{"text":"kunyange zvina handingadzori hasha dzangu.","poem":2},{"text":"Nokuti akatengesera Edhomu rudzi rwose savatapwa,","poem":1},{"text":"akasacherechedza sungano youkama,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ndichatuma moto pamasvingo eTire,","poem":1},{"text":"uchaparadza nhare dzake.”","poem":2}]},{"type":"verse","number":11,"content":["Zvanzi naJehovha:",{"text":"“Nemhaka yezvivi zvitatu zvaEdhomu,","poem":1},{"text":"kunyange zvina, handingadzori hasha dzangu.","poem":2},{"text":"Nokuti akadzinganisa mununʼuna wake nomunondo,","poem":1},{"text":"akaramba kumunzwira tsitsi,","poem":2},{"text":"nokuti kutsamwa kwake kwakaramba kwakangodaro,","poem":1},{"text":"uye hasha dzake dzakapfuta, hadzina akadzimisa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ndichatuma moto pamusoro peTemani","poem":1},{"text":"uchaparadza nhare dzeBhozira.”","poem":2}]},{"type":"verse","number":13,"content":["Zvanzi naJehovha: “Nemhaka yezvivi zvitatu zvaAmoni,",{"text":"kunyange zvina, handingadzori hasha dzangu.","poem":2},{"text":"Nokuti akatumbura vakadzi vane mimba veGireadhi,","poem":1},{"text":"kuti awedzere miganhu yake,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ndichatungidza moto pamasvingo eRabha","poem":1},{"text":"uchaparadza nhare dzaro,","poem":2},{"text":"pakati pemheremhere yehondo pazuva rokurwa,","poem":1},{"text":"pakati pemhepo huru nezuva redutu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mambo wake achaenda kuutapwa,","poem":1},{"text":"iye namakurukota ake pamwe chete,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}