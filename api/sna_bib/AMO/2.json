:1},{"text":"uye havana kuchengeta mitemo yake,","poem":2},{"text":"nokuti vakatsauswa mukurasika navamwari venhema,","poem":1},{"text":"vamwari vakateverwa namadzitateguru avo,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ndichatuma moto pamusoro peJudha,","poem":1},{"text":"uchaparadza nhare dzeJerusarema.”","poem":2}]},{"type":"heading","content":["Israeri inotongwa"]},{"type":"verse","number":6,"content":["Zvanzi naJehovha:",{"text":"“Nemhaka yezvivi zvitatu zvaIsraeri,","poem":1},{"text":"kunyange zvina, handingadzori hasha dzangu.","poem":2},{"text":"Vanotengesa vakarurama kuti vawane sirivha,","poem":1},{"text":"navanoshayiwa kuti vawane shangu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vanotsika-tsika pamisoro yavarombo","poem":1},{"text":"savanotsika paguruva,","poem":2},{"lineBreak":true},{"text":"uye vanoshayisa vakadzvinyirirwa kururamisirwa.","poem":2},{"text":"Baba nomwanakomana vanorara nomusikana mumwe chete,","poem":1},{"text":"nokudaro vanosvibisa zita rangu dzvene.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanovata pasi parutivi pearitari","poem":1},{"text":"imwe neimwe panguo dzakatorwa norubatso.","poem":2},{"text":"Mumba yamwari wavo","poem":1},{"text":"vanonwa waini yakatorwa somuripo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ndakaparadza Amori pamberi pavo,","poem":1},{"text":"kunyange akanga akareba somusidhari","poem":2},{"lineBreak":true},{"text":"uye akasimba somuouki.","poem":2},{"text":"Ndakaparadza zvibereko zvake","poem":1},{"text":"kumusoro nemidzi yake pasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ndakakubudisa kubva muIjipiti,","poem":1},{"text":"ndikakutungamirira kwamakore makumi mana murenje,","poem":2},{"lineBreak":true},{"text":"kuti ndikupe nyika yavaAmori.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndakamutsawo vaprofita kubva pakati pavanakomana venyu,","poem":1},{"text":"navaNaziri kubva pakati pamajaya enyu.","poem":2},{"text":"Ichi hachisi chokwadi here, nhai vanhu veIsraeri?”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"“Asi makaita kuti vaNaziri vanwe waini","poem":1},{"text":"uye mukarayira vaprofita kuti varege kuprofita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Zvino ipapo ndichakupwanyai","poem":1},{"text":"sokupwanya kunoita ngoro izere nezviyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vanomhanya kwazvo havangapunyuki,","poem":1},{"text":"vakasimba havangazovi nesimba ravo,","poem":2},{"lineBreak":true},{"text":"uye murwi haangazoponesi upenyu hwake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anopfura nemiseve haangazoramba amire,","poem":1},{"text":"murwi anogona kumhanya haangapunyuki,","poem":2},{"lineBreak":true},{"text":"uye mutasvi webhiza haangazoponesi upenyu hwake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kunyange mhare dzakashinga","poem":1},{"text":"dzichatiza dzisina nguo pazuva iro,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}