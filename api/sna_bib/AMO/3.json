{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"AMO","translationId":"sna_bib","name":"Amosi","commonName":"Amosi","title":"AMOSI","order":30,"numberOfChapters":9,"sha256":"814da51b0b370fb58afade0a1756457839d2babdd5fe299d17777346604ff536","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/sna_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Zvapupu zvinodaidzwa kuti zvizopomera Israeri mhosva"]},{"type":"verse","number":1,"content":["Inzwai shoko iri rakataurwa naJehovha pamusoro penyu, imi vanhu veIsraeri, pamusoro pemhuri yose yandakabudisa kubva muIjipiti:"]},{"type":"verse","number":2,"content":[{"text":"“Ndimi moga vandakasarudza","poem":1},{"text":"pamhuri dzose dzapanyika;","poem":2},{"text":"naizvozvo ndichakurangai","poem":1},{"text":"nokuda kwezvivi zvenyu zvose.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ko, vaviri vangafamba pamwe chete","poem":1},{"text":"vasina kunge vatenderana here?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ko, shumba ingaomba mudondo","poem":1},{"text":"isina chayaruma here?","poem":2},{"text":"Ko, ingarira mubako rayo isina chayabata here?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ko, shiri ingawira pasi mumusungo","poem":1},{"text":"pasina kuteyiwa rugombe here?","poem":2},{"text":"Ko, musungo ungaurukira kumusoro","poem":1},{"text":"pasina chawabata here?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hwamanda ingarira muguta,","poem":1},{"text":"vanhu vakasatya here?","poem":2},{"text":"Njodzi painowira guta,","poem":1},{"text":"ko, haazi Jehovha anenge azviita here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zvirokwazvo, Ishe Jehovha haaiti chinhu","poem":1},{"text":"asina kuzivisa varanda vake,","poem":2},{"lineBreak":true},{"text":"vaprofita, zvakavanzika zvake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Shumba yaomba,","poem":1},{"text":"ndiani angarega kutya?","poem":2},{"text":"Ishe Jehovha ataura,","poem":1},{"text":"ndiani angarega kuprofita?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Paridzirai nhare dzeAshidhodhi","poem":1},{"text":"nenhare dzeIjipiti muchiti:","poem":2},{"text":"“Unganai pamakomo eSamaria;","poem":1},{"text":"onai kusagadzikana kukuru kuri mukati maro,","poem":2},{"lineBreak":true},{"text":"noudzvinyiriri huri pakati pavanhu varo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Havazivi kuita zvakarurama,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"“ivo vanounganidza zvakapambwa nezvakabiwa munhare dzaro.”","poem":2}]},{"type":"verse","number":11,"content":["Naizvozvo zvanzi naIshe Jehovha,",{"text":"“Muvengi achatora nyika; achawisira pasi nzvimbo dzako","poem":1},{"text":"uye achapamba nhare dzako.”","poem":2}]},{"type":"verse","number":12,"content":["Zvanzi naJehovha:",{"text":"“Mufudzi sezvaanobvuta pamuromo","poem":1},{"text":"weshumba mapfupa maviri amakumbo chete kana chipandi chenzeve,","poem":2},{"lineBreak":true},{"text":"vaIsraeri vachaponeswa saizvozvowo,","poem":2},{"text":"avo vanogara muSamaria","poem":1},{"text":"pamicheto yemibhedha yavo,","poem":2},{"lineBreak":true},{"text":"nomuDhamasiko pazvigaro zvavo.”","poem":2}]},{"type":"verse","number":13,"content":["“Inzwai izvi, mugopupura pamusoro peimba yaJakobho,” ndizvo zvinotaura Ishe Jehovha, Mwari Wamasimba Ose."]},{"type":"verse","number":14,"content":[{"text":"“Pazuva randicharanga Israeri nokuda kwezvivi zvayo,","poem":1},{"text":"ndichaparadza aritari dzeBheteri;","poem":2},{"text":"nyanga dzearitari dzichaparadzwa","poem":1},{"text":"uye dzichawira pasi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndichaparadza imba yenguva yechando,","poem":1},{"text":"pamwe chete neimba yenguva yechirimo;","poem":2},{"text":"dzimba dzakashongedzwa nenyanga dzenzou dzichaparadzwa","poem":1},{"text":"uye dzimba huru dzichaparadzwa,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}