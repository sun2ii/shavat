{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"AMO","translationId":"sna_bib","name":"Amosi","commonName":"Amosi","title":"AMOSI","order":30,"numberOfChapters":9,"sha256":"814da51b0b370fb58afade0a1756457839d2babdd5fe299d17777346604ff536","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/sna_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["Israeri haina kudzokera kuna Mwari"]},{"type":"verse","number":1,"content":[{"text":"Inzwai shoko iri, imi mhou dzeBhashani paGomo reSamaria,","poem":1},{"text":"imi vakadzi vanodzvinyirira varombo","poem":2},{"lineBreak":true},{"text":"uye vanopwanya vanoshayiwa muchiti kuvarume venyu, “Tiunzirei zvokunwa.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ishe Jehovha apika noutsvene hwake achiti,","poem":1},{"text":"“Zvirokwazvo nguva ichasvika","poem":2},{"text":"yamuchatorwa nezvikokovono,","poem":1},{"text":"vokupedzisira pakati penyu nezviredzo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muchabuda pakarepo mumwe nomumwe,","poem":1},{"text":"napakakoromoka masvingo,","poem":2},{"lineBreak":true},{"text":"uye mucharasirwa kunze makananga kuHamoni,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"“Endai kuBheteri mundotadza;","poem":1},{"text":"endai kuGirigari mundowedzera kutadza kwenyu.","poem":2},{"text":"Uyai nezvibayiro zvenyu mangwanani namangwanani,","poem":1},{"text":"zvegumi zvenyu mushure mamakore matatu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pisai chingwa chine mbiriso sechibayiro chokuvonga","poem":1},{"text":"muzvirumbidze pamusoro pezvipiriso zvenyu zvokupa nokuzvisarudzira,","poem":2},{"text":"zvirumbidzei nazvo, imi vaIsraeri,","poem":1},{"text":"nokuti izvi ndizvo zvamunofarira kuita,”","poem":2},{"text":"ndizvo zvinotaura Ishe Jehovha.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"“Ndakakupai matumbu asina chinhu mumaguta makuru ose","poem":1},{"text":"uye ndikakushayisai chingwa mumaguta maduku ose,","poem":2},{"lineBreak":true},{"text":"kunyange zvakadaro hamuna kudzokera kwandiri,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ndakamisawo mvura","poem":1},{"text":"kuti isanaya kwasara mwedzi mitatu kuti mukohwe.","poem":2},{"text":"Ndakatumira mvura kuguta rimwe chete","poem":1},{"text":"ndikasanayisa kune rimwe.","poem":2},{"text":"Mumwe munda wakawana mvura","poem":1},{"text":"mumwe wakashayiwa uye ukaoma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanhu vakadzedzereka vachibva kune rimwe guta vachienda kune rimwe kundotsvaka mvura,","poem":1},{"text":"asi havana kuwana yaivaringana kuti vanwe,","poem":2},{"lineBreak":true},{"text":"kunyange zvakadaro hamuna kudzokera kwandiri,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kakawanda kwazvo ndakarova mapindu neminda yenyu yemizambiringa,","poem":1},{"text":"ndakairova nechirwere nokuvhuvha.","poem":2},{"text":"Mhashu dzakaparadza mionde nemiti yenyu yemiorivhi,","poem":1},{"text":"kunyange zvakadaro hamuna kudzokera kwandiri,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ndakatumira hosha pakati penyu","poem":1},{"text":"sezvandakaita kuIjipiti.","poem":2},{"text":"Ndakauraya majaya enyu nomunondo,","poem":1},{"text":"pamwe chete namabhiza enyu akapambwa.","poem":2},{"text":"Ndakazadza mhino dzenyu nokunhuhwa kwemisasa yenyu,","poem":1},{"text":"asi hamuna kudzokera kwandiri,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ndakaparadza vamwe venyu","poem":1},{"text":"sokuparadza kwandakaita Sodhomu neGomora.","poem":2},{"text":"Makanga makaita sorukuni runotsva, rwabviswa mumoto,","poem":1},{"text":"asi hamuna kudzokera kwandiri,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Naizvozvo izvi ndizvo zvandichaita kwauri, Israeri,","poem":1},{"text":"uye nokuti ndichaita izvi kwauri,","poem":2},{"lineBreak":true},{"text":"gadzirira kusangana naMwari wako, iwe Israeri.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Iye anoita makomo,","poem":1},{"text":"ndiye anosika mhepo,","poem":2},{"lineBreak":true},{"text":"ndiyezve anozivisa pfungwa dzake kumunhu,","poem":2},{"text":"Iye anoshandura mangwanani akava rima,","poem":1},{"text":"anotsika panzvimbo dzakakwirira dzenyika,","poem":2},{"lineBreak":true},{"text":"Jehovha Mwari Wamasimba Ose ndiro zita rake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}