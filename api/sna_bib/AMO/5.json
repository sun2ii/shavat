{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"AMO","translationId":"sna_bib","name":"Amosi","commonName":"Amosi","title":"AMOSI","order":30,"numberOfChapters":9,"sha256":"814da51b0b370fb58afade0a1756457839d2babdd5fe299d17777346604ff536","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/sna_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Kuchema nokudanidzira kuti vanhu vatendeuke"]},{"type":"verse","number":1,"content":["Inzwai shoko iri, imi imba yaIsraeri, kuchema uku kwandinoita pamusoro penyu:"]},{"type":"verse","number":2,"content":[{"text":"“Yawira pasi Mhandara Israeri,","poem":1},{"text":"haingazosimukizve,","poem":2},{"text":"akasiyiwa ari oga munyika yake,","poem":1},{"text":"pasina angamusimudza.”","poem":2}]},{"type":"verse","number":3,"content":["Zvanzi naIshe Jehovha:",{"text":"“Guta richaendesa varwi chiuru vakasimba pakati peIsraeri","poem":1},{"text":"richasarirwa nezana chete;","poem":2},{"text":"guta richaendesa varwi zana","poem":1},{"text":"vakasimba richasarirwa negumi chete.”","poem":2}]},{"type":"verse","number":4,"content":["Zvanzi naJehovha kuimba yaIsraeri:",{"text":"“Nditsvakei murarame;","poem":1}]},{"type":"verse","number":5,"content":[{"text":"musatsvaka Bheteri,","poem":2},{"text":"musaenda kuGirigari,","poem":1},{"text":"musaita rwendo rwokuenda kuBheerishebha.","poem":2},{"text":"Nokuti zvirokwazvo Girigari ichaendeswa kuutapwa,","poem":1},{"text":"uye Bheteri richava sapasina chinhu.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsvakai Jehovha mugorarama,","poem":1},{"text":"mukasadaro achatsvaira imba yaJosefa sezvinoita moto;","poem":2},{"text":"uchaparadza,","poem":1},{"text":"uye Bheteri richashaya anoudzima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Imi vanoshandura kururamisira muchikuita gavakava","poem":1},{"text":"uye muchikandira kururama pasi","poem":2}]},{"type":"verse","number":8,"content":[{"text":"(Iye akaita nyeredzi dzeChimutanhatu neOrioni,","poem":1},{"text":"anoshandura rima richiva mambakwedza,","poem":2},{"lineBreak":true},{"text":"uye anoita kuti zuva risvibe huve usiku,","poem":2},{"text":"anodana mvura zhinji yegungwa achiidururira panyika,","poem":1},{"text":"Jehovha ndiro zita rake,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"anoparadza nhare pakarepo uye anoita","poem":1},{"text":"kuti guta rina masvingo rive dongo),","poem":2}]},{"type":"verse","number":10,"content":[{"text":"munovenga anorayira padare","poem":1},{"text":"uye munozvidza anotaura chokwadi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Munotsika pamusoro pomurombo","poem":1},{"text":"muchimumanikidza kuti akupei zviyo.","poem":2},{"text":"Naizvozvo, kunyange makavaka dzimba huru dzamabwe,","poem":1},{"text":"hamungagari madziri;","poem":2},{"text":"kunyange makasima minda yakasvibira yemizambiringa,","poem":1},{"text":"hamunganwi waini yayo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nokuti ndinoziva kuwanda kwemhosva","poem":1},{"text":"dzenyu nokukura kwakaita zvivi zvenyu.","poem":2},{"lineBreak":true},{"text":"Munodzvinyirira vakarurama uye munotora fufuro,","poem":1},{"text":"uye munoshayisa varombo kururamisirwa pamatare.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Naizvozvo munhu akangwara anonyarara panguva dzakadai,","poem":1},{"text":"nokuti inguva dzakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tsvakai zvakanaka, kwete zvakaipa,","poem":1},{"text":"kuti murarame.","poem":2},{"text":"Ipapo Jehovha Mwari Wamasimba Ose achava nemi,","poem":1},{"text":"sezvamunoti ndizvo zvaari.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vengai zvakaipa, mude zvakanaka;","poem":1},{"text":"chengetedzai kururamisira mumatare.","poem":2},{"text":"Zvichida Jehovha Mwari Wamasimba Ose","poem":1},{"text":"achanzwira tsitsi vakasara vaJosefa.","poem":2}]},{"type":"verse","number":16,"content":["Naizvozvo zvanzi naIshe, Jehovha Mwari Wamasimba Ose,",{"text":"“Muchava nokuchema mumigwagwa","poem":1},{"text":"yose nemhere yokurwadziwa pazvivara zvose.","poem":2},{"text":"Varimi vachadanwa kuti vazochema","poem":1},{"text":"uye vanochema vazoungudza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuchava nokuungudza muminda yose yemizambiringa,","poem":1},{"text":"nokuti ndichapfuura napakati penyu,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"heading","content":["Zuva raJehovha"]},{"type":"verse","number":18,"content":[{"text":"Mune nhamo imi","poem":1},{"text":"munoshuva zuva raJehovha!","poem":2},{"text":"Sei muchishuva zuva raJehovha?","poem":1},{"text":"Zuva iro richava rima kwete chiedza.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zvichaita somunhu akatiza shumba","poem":1},{"text":"achibva asangana nebere,","poem":2},{"text":"sokunge akapinda mumba","poem":1},{"text":"make ndokubata madziro noruoko rwake","poem":2},{"lineBreak":true},{"text":"achibva arumwa nenyoka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ko, zuva raJehovha haringavi rima here,","poem":1},{"text":"kwete chiedza, rima guru, risina kana bwerazuva?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Ndinovenga, ndinozvidza mitambo yenyu yechinamato;","poem":1},{"text":"handifadzwi neungano dzenyu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kunyange mukandivigira zvipiriso zvenyu zvinopiswa nezvipiriso zvezviyo,","poem":1},{"text":"handingazvigamuchiri.","poem":2},{"text":"Kunyange mukandivigira zvipiriso zvakaisvonaka zvokuwadzana,","poem":1},{"text":"handingavi nehanya nazvo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ibvai pamberi pangu noruzha rwenziyo dzenyu!","poem":1},{"text":"Handidi kunzwa kurira kwembira dzenyu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Asi kururamisira ngakuyerere sorwizi,","poem":1},{"text":"kururama sorukova rusingapwi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Makandivigira zvibayiro nezvipiriso","poem":1},{"text":"makore makumi mana muri murenje here, nhai imba yaIsraeri?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Makasimudzira temberi yamambo wenyu,","poem":1},{"text":"chitsiko chezvifananidzo zvenyu,","poem":2},{"lineBreak":true},{"text":"nyeredzi yamwari wenyu,","poem":2},{"lineBreak":true},{"text":"wamakazvigadzirira.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Naizvozvo ndichakutamisai muende mberi kweDhamasiko,”","poem":1},{"text":"ndizvo zvinotaura Jehovha ane zita rinonzi Mwari Wamasimba Ose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}