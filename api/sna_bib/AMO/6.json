{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"AMO","translationId":"sna_bib","name":"Amosi","commonName":"Amosi","title":"AMOSI","order":30,"numberOfChapters":9,"sha256":"814da51b0b370fb58afade0a1756457839d2babdd5fe299d17777346604ff536","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/sna_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["Vane nhamo vakavarairwa"]},{"type":"verse","number":1,"content":[{"text":"Mune nhamo imi makavarairwa muZioni,","poem":1},{"text":"nemi munofunga kuti mugere pakasimba paGomo reSamaria,","poem":2},{"text":"imi varume vanozivikanwa vorudzi rukuru,","poem":1},{"text":"kunoenda vanhu veIsraeri!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Endai kuKarine mundoritarisa;","poem":1},{"text":"muchibvapo moenda kuHamati guta guru,","poem":2},{"lineBreak":true},{"text":"uye mozodzika kuGati muFiristia.","poem":2},{"text":"Vari nani kupfuura umambo hwenyu huviri here?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Munoti zuva rakaipa ngarirege","poem":1},{"text":"kusvika muchiswededza pedyo utongi hwokuvhundutsira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Munovata pamibhedha yenyanga dzenzou,","poem":1},{"text":"muchizorora pazvigaro zvenyu.","poem":2},{"text":"Munodya makwayana akaisvonaka","poem":1},{"text":"nemhuru dzakakodzwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Munoridza zvenyu mbira dzenyu saDhavhidhi,","poem":1},{"text":"uye munozvigadzirira zviridzwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Munonwa waini yakawanda,","poem":1},{"text":"muchizora mafuta akaisvonaka,","poem":2},{"lineBreak":true},{"text":"asi hamuchemi nokuda kwamatongo aJosefa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Naizvozvo muchava pakati pevachatanga kuenda kuutapwa;","poem":1},{"text":"mabiko enyu nokuzorora kwenyu zvichapera.","poem":2}]},{"type":"heading","content":["Jehovha anosema kuzvikudza kwaIsraeri"]},{"type":"verse","number":8,"content":["Ishe Jehovha akapika naiye pachake, Jehovha Mwari Wamasimba Ose anoti,",{"text":"“Ndinosema kuzvikudza kwaJakobho,","poem":1},{"text":"uye ndinovenga nhare dzake;","poem":2},{"text":"ndichaisa guta kuvavengi","poem":1},{"text":"nezvose zviri mariri.”","poem":2}]},{"type":"verse","number":9,"content":["Kana varume gumi vakasiyiwa muimba imwe chete naivowo vachafa."]},{"type":"verse","number":10,"content":["Uye kana hama inofanira kupisa mitumbi ikauya kuzovabudisa mumba, uye ikabvunza munhu achakahwanda imomo ichiti, “Pane mumwe waunaye here?” uye akati, “Kwete,” ipapo iye achati, “Nyarara! Hatifaniri kuti titaure zita raJehovha.”"]},{"type":"verse","number":11,"content":[{"text":"Nokuti Jehovha akarayira,","poem":1},{"text":"uye achaparadza imba huru igoita murwi,","poem":2},{"lineBreak":true},{"text":"nemba duku igoti mwarara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ko, mabhiza angamhanya paruware here?","poem":1},{"text":"Ko, pane angaparima ipapo nemombe here?","poem":2},{"text":"Asi makashandura kururamisira mukakuita muchetura,","poem":1},{"text":"nechibereko chokururama mukachiita gavakava,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"imi munopembera pakukundwa kweRo Dhibhari uye munoti,","poem":1},{"text":"“Hatina kuzvitorera Karinaini nesimba redu here?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nokuti Jehovha Mwari Wamasimba Ose anoti,","poem":1},{"text":"“Ndichakumutsirai rumwe rudzi kuti rukumukirei, imi imba yaIsraeri,","poem":2},{"text":"ruchakutambudzai panzira yenyu yose,","poem":1},{"text":"kubva kuRebho Hamati kusvikira kumupata weArabha.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}