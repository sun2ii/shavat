{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"AMO","translationId":"sna_bib","name":"Amosi","commonName":"Amosi","title":"AMOSI","order":30,"numberOfChapters":9,"sha256":"814da51b0b370fb58afade0a1756457839d2babdd5fe299d17777346604ff536","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/sna_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["Tswanda yemichero yakaibva"]},{"type":"verse","number":1,"content":["Izvi ndizvo zvandakaratidzwa naIshe Jehovha: tswanda ine michero yakaibva."]},{"type":"verse","number":2,"content":["Akabvunza akati, “Unooneiko, Amosi?” Ndakapindura ndichiti, “Tswanda ine michero yakaibva.” Ipapo Jehovha akati kwandiri, “Nguva yakwana kuvanhu vangu Israeri; handingavararamisizve."]},{"type":"verse","number":3,"content":["“Pazuva iro,” ndizvo zvinotaura Ishe Jehovha, “nziyo dzomutemberi dzichashanduka dzigova kuchema. Mitumbi yevakafa ichava mizhinji. Munzvimbo dzose icharaswa vanhu vanyerere.”"]},{"type":"verse","number":4,"content":[{"text":"Inzwai izvi imi munotsika-tsika vanoshayiwa","poem":1},{"text":"uye muchiparadza varombo venyika,","poem":2}]},{"type":"verse","number":5,"content":["muchiti,",{"text":"“Kugara kwoMwedzi kuchapfuura riniko","poem":1},{"text":"kuti tigotengesa zviyo,","poem":2},{"text":"uye kupera kweSabata","poem":1},{"text":"kuti tigotengesa gorosi?”","poem":2},{"text":"muchitapudza chiero,","poem":1},{"text":"muchikwidza mitengo","poem":2},{"lineBreak":true},{"text":"uye muchibiridzira nezvikero zvinonyengera,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"muchitenga varombo nesirivha","poem":1},{"text":"uye vanoshayiwa neshangu,","poem":2},{"lineBreak":true},{"text":"muchitengesa kunyange makoto pamwe chete negorosi.","poem":2}]},{"type":"verse","number":7,"content":["Jehovha apika noKuzvikudza kwaJakobho achiti, “Handizokanganwi chinhu chipi nechipi zvacho chavakaita."]},{"type":"verse","number":8,"content":[{"text":"“Ko, nyika haingadederi nokuda kwaizvozvi here","poem":1},{"text":"uye vose vanogara mairi havangachemi?","poem":2},{"text":"Nyika yose ichadira seNairi,","poem":1},{"text":"ichabvongodzwa","poem":2},{"lineBreak":true},{"text":"uye igoderera sorwizi rweIjipiti.","poem":2}]},{"type":"verse","number":9,"content":["“Pazuva iro,” ndizvo zvinotaura Ishe Jehovha,",{"text":"“ndichaita kuti zuva rivire masikati makuru","poem":1},{"text":"uye ndichauyisa rima panyika masikati machena.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndichashandura mitambo yenyu yechinamato ive kuchema,","poem":1},{"text":"nokuimba kwose kuti kuve mhere.","poem":2},{"text":"Ndichaita kuti mose mupfeke masaga","poem":1},{"text":"uye mugoveura misoro yenyu.","poem":2},{"text":"Ndichaita kuti nguva iyi ive samariro omwanakomana akaberekwa ari mumwe oga,","poem":1},{"text":"uye magumo acho ave sezuva rakaipa kwazvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Mazuva ari kuuya,” ndizvo zvinotaura Ishe Jehovha,","poem":1},{"text":"“andichatumira nzara panyika yose,","poem":2},{"text":"kwete nzara yezvokudya kana nyota yemvura,","poem":1},{"text":"asi nzara yokunzwa mashoko aJehovha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vanhu vachadzedzereka vachibva kugungwa","poem":1},{"text":"vachienda kune rimwe gungwa,","poem":2},{"text":"uye vachadzungaira vachibva kumusoro vachienda kumabvazuva,","poem":1},{"text":"vachitsvaka shoko raJehovha, asi havangariwani.","poem":2}]},{"type":"verse","number":13,"content":["“Pazuva iro,",{"text":"“mhandara dzakaisvonaka namajaya","poem":1},{"text":"akasimba vachaziya nenyota.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Avo vanopika nokunyadzisa kweSamaria, kana vanoti,","poem":1},{"text":"‘Namwari wako mupenyu, iwe Dhani,’ kana kuti,","poem":2},{"lineBreak":true},{"text":"‘Namwari waBheerishebha mupenyu,’","poem":2},{"text":"vachawa,","poem":1},{"text":"vasingazomukazve.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}