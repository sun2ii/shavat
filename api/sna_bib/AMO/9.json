{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"AMO","translationId":"sna_bib","name":"Amosi","commonName":"Amosi","title":"AMOSI","order":30,"numberOfChapters":9,"sha256":"814da51b0b370fb58afade0a1756457839d2babdd5fe299d17777346604ff536","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/sna_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["Israeri ichaparadzwa"]},{"type":"verse","number":1,"content":["Ndakaona Jehovha amire parutivi rwearitari, uye akati,",{"text":"“Rova misoro yembiru","poem":1},{"text":"kuti zvikumbaridzo zvizunguzike.","poem":2},{"text":"Zviputsire pasi pamisoro yevanhu vose;","poem":1},{"text":"avo vachasara ndichavauraya nomunondo.","poem":2},{"text":"Hapana kana mumwe chete achatiza,","poem":1},{"text":"hapana achapunyuka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kunyange vakachera kusvikira panoperera guva,","poem":1},{"text":"kubva imomo ruoko rwangu ruchavatora.","poem":2},{"text":"Kunyange vakakwira kumatenga,","poem":1},{"text":"kubva ikoko ndichavadzikisa pasi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kunyange vakazvivanza pamusoro peKarimeri,","poem":1},{"text":"ipapo ndichavavhima ndigovabata.","poem":2},{"text":"Kunyange vakahwanda kubva kwandiri pasi pegungwa,","poem":1},{"text":"ipapo ndicharayira nyoka kuti ivarume.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kunyange vakaendeswa kuutapwa navavengi vavo,","poem":1},{"text":"ikoko ndicharayira munondo kuti uvaparadze.","poem":2},{"text":"Ndichananʼanidza meso angu pavari","poem":1},{"text":"kuti ndivaitire zvakaipa, kwete zvakanaka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ishe, Jehovha Wamasimba Ose,","poem":1},{"text":"iye anobata nyika igonyungudika,","poem":2},{"lineBreak":true},{"text":"navose vagere mairi vagochema,","poem":2},{"text":"nyika yose inozara seNairi,","poem":1},{"text":"uye igoderera serwizi rweIjipiti,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"iye anovaka muzinda wake kumatenga","poem":1},{"text":"agomisa hwaro hwawo panyika,","poem":2},{"text":"anodana mvura dzegungwa","poem":1},{"text":"agodzidururira pamusoro penyika,","poem":2},{"lineBreak":true},{"text":"Jehovha ndiro zita rake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Nhai imi vaIsraeri, ko,","poem":1},{"text":"hamusi kwandiri vamwe chete savaEtiopia here?”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"“Handina kubudisa Israeri kubva kuIjipiti here,","poem":1},{"text":"vaFiristia kubva kuKafitori","poem":2},{"lineBreak":true},{"text":"navaAramu kubva kuKiri?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Zvirokwazvo meso aIshe Jehovha","poem":1},{"text":"ari paumambo hunotadza.","poem":2},{"text":"Ndichahuparadza","poem":1},{"text":"kubva pamusoro penyika,","poem":2},{"text":"asi handingaparadzi zvachose","poem":1},{"text":"imba yaJakobho,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"“Nokuti ndicharayira,","poem":1},{"text":"uye ndichazunguza imba yaIsraeri pakati pendudzi dzose,","poem":2},{"lineBreak":true},{"text":"sokuzunguzwa kunoitwa zviyo murusero,","poem":2},{"text":"uye hapana kana tsanga","poem":1},{"text":"imwe chete ichawira pasi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vatadzi vose pakati pavanhu vangu","poem":1},{"text":"vachafa nomunondo,","poem":2},{"text":"vose vanoti,","poem":1},{"text":"‘Njodzi haingatiwiri kana kusangana nesu.’","poem":2}]},{"type":"heading","content":["Israeri inomutsidzirwa"]},{"type":"verse","number":11,"content":[{"text":"“Pazuva iro ndichamisazve","poem":1},{"text":"tende raDhavhidhi rakawa.","poem":2},{"text":"Ndichavakazve nzvimbo dzaro dzakaputsika,","poem":1},{"text":"ndigovakazve matongo aro,","poem":2},{"lineBreak":true},{"text":"uye ndicharivaka sezvarakanga rakaita,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kuti vazvitorere zvakasara zvaEdhomu","poem":1},{"text":"nendudzi dzose dzine zita rangu,”","poem":2},{"text":"ndizvo zvinotaura Jehovha, iye achaita zvinhu izvi.","poem":4}]},{"type":"verse","number":13,"content":["“Mazuva ari kuuya,” ndizvo zvinotaura Jehovha,",{"text":"“mucheki paachapfuurwa nomurimi,","poem":1},{"text":"uye mudyari paachapfuurwa neanosvina mazambiringa.","poem":2},{"text":"Waini itsva ichadonha kubva kumakomo,","poem":1},{"text":"uye ichayerera kubva pazvikomo zvose.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndichadzosazve vanhu vangu vakatapwa, ivo vaIsraeri;","poem":1},{"text":"vachavakazve maguta akaitwa matongo uye vachagara maari.","poem":2},{"text":"Vachasima minda yemizambiringa vagonwa waini yayo.","poem":1},{"text":"Vacharima mapindu uye vachadya zvibereko zvawo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndichasima Israeri munyika yavo voga,","poem":1},{"text":"havangazodzurwizve","poem":2},{"lineBreak":true},{"text":"kubva panyika yandakavapa,”","poem":2},{"lineBreak":true},{"text":"ndizvo zvinotaura Jehovha Mwari wako.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}