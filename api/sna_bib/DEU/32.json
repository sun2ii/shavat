{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"DEU","translationId":"sna_bib","name":"Dhuteronomi","commonName":"Dhuteronomi","title":"DHUTERONOMI","order":5,"numberOfChapters":34,"sha256":"3a010745a5f6209e57bb69916758e2d905849a9fab6eb579516b458a2cf72463","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/sna_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"Inzwai, imi matenga, zvino ndichataura;","poem":1},{"text":"inzwa, iwe nyika, mashoko omuromo wangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Regai dzidziso yangu inaye semvura","poem":1},{"text":"uye mashoko angu ayerere sedova,","poem":2},{"text":"sokupfunha pauswa hunyoro,","poem":1},{"text":"semvura zhinji papfumvudza nyoro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ndichaparidza zita raJehovha.","poem":1},{"text":"Haiwa, rumbidzai ukuru hwaMwari wedu!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndiye ibwe, mabasa ake akakwana,","poem":1},{"text":"uye nzira dzake dzakarurama.","poem":2},{"text":"Mwari akatendeka asina chaanotadza,","poem":1},{"text":"akarurama uye ndowezvokwadi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vakaita zvakaipa kwaari;","poem":1},{"text":"vakazvinyadzisa uye havasisiri vana vake,","poem":2},{"lineBreak":true},{"text":"asi vava rudzi rwakatsauka rwakakombama,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ko, iyi ndiyo nzira yamunoripira nayo Jehovha here,","poem":1},{"text":"imi mapenzi navanhu vasina kuchenjera?","poem":2},{"text":"Ko, haazi iye Baba wenyu, noMusiki wenyu here,","poem":1},{"text":"akakuitai nokukuumbai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rangarira mazuva akare;","poem":1},{"text":"ufunge marudzi akare kare.","poem":2},{"text":"Ubvunze baba vako, uye vachakuudza,","poem":1},{"text":"vakuru vako vachakutsanangurira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wokumusoro-soro paakapa ndudzi nhaka,","poem":1},{"text":"nguva yaakakamura marudzi ose,","poem":2},{"text":"akaisira vanhu miganhu,","poem":1},{"text":"zvichienderana nouwandu hwavanakomana veIsraeri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuti mugove waJehovha ndivo vanhu vake,","poem":1},{"text":"Jakobho ndiyo nhaka yake yaakayererwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Akamuwana munyika yomurenje,","poem":1},{"text":"musina chinhu, munotyisa.","poem":2},{"text":"Akamudzivirira uye akamuchengeta;","poem":1},{"text":"akamuchengetedza semboni yeziso rake,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"segondo rinogadziridza dendere","poem":1},{"text":"raro nokuengerera pamusoro pavana varo,","poem":2},{"text":"rinotambanudza mapapiro aro kuti rivagamhe,","poem":1},{"text":"rovabereka pamapapiro aro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jehovha oga ndiye akamutungamirira;","poem":1},{"text":"kwakanga kusina mwari wokumwe akanga anaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Akamuita kuti atasve panzvimbo dzakakwirira dzenyika","poem":1},{"text":"uye akamupa zvibereko zveminda kuti adye.","poem":2},{"text":"Akamusimbisa nouchi hwakabva padombo,","poem":1},{"text":"uye namafuta akabva padombo romusarasara,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"noruomba nomukaka kubva pamombe namakwai","poem":1},{"text":"uye namakwayana nembudzi zvakakodzwa,","poem":2},{"text":"namakondobwe akaisvonaka eBhashani,","poem":1},{"text":"netsanga dzakanakisisa dzegorosi.","poem":2},{"text":"Akanwa furo reropa ramazambiringa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Jeshuruni akazokora uye akapfura;","poem":1},{"text":"aguta nezvokudya, akava mukobvu uye akava namafuta.","poem":2},{"text":"Akasiya Mwari akamuita","poem":1},{"text":"uye akaramba Ibwe, Muponesi wake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Vakamuita kuti ave negodo nokuda kwavamwari vokumwe","poem":1},{"text":"uye vakamutsamwisa nezviumbwa zvinonyangadza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Vakabayira kumadhimoni, asiri Mwari,","poem":1},{"text":"vamwari vavakanga vasingazivi,","poem":2},{"lineBreak":true},{"text":"vamwari vatsva vakanga vachangomuka,","poem":2},{"lineBreak":true},{"text":"vamwari vakanga vasingazivikanwi namadzibaba enyu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wakasiya Ibwe rakakubereka;","poem":1},{"text":"wakakanganwa Mwari akakubereka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Jehovha akaona izvi akavaramba","poem":1},{"text":"nokuti akanga atsamwiswa navakomana vake navanasikana vake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Ndichavanza chiso changu kubva kwavari,” iye akadaro,","poem":1},{"text":"“tigoona kuti magumo avo achazodii;","poem":2},{"text":"nokuti rudzi rwakatsauka,","poem":1},{"text":"vana vasina kutendeka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vakamutsa godo rangu nokuda kwechinhu chisati chiri Mwari,","poem":1},{"text":"vakanditsamwisa nokuda kwezviumbwa zvavo zvisina maturo.","poem":2},{"text":"Ndichaita kuti vagodorwe navaya vasati vari vanhu;","poem":1},{"text":"ndichavaita kuti vatsamwiswe norudzi rusinganzwisisi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nokuti moto watungidzwa nehasha dzangu,","poem":1},{"text":"idzo dzinopisa kusvikira pasi pegomba rorufu.","poem":2},{"text":"Dzichaparadza nyika nezvibereko zvayo","poem":1},{"text":"uye dzichapisa nheyo dzamakomo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Ndichatutira njodzi pamusoro pavo","poem":1},{"text":"uye ndichapedza miseve yangu ndichivapfura.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndichatumira nzara inoondesa pamusoro pavo,","poem":1},{"text":"nokuparadza kunopisa zvikuru nedenda rakaipisisa;","poem":2},{"text":"ndichatumira meno ezvikara zvesango kwavari,","poem":1},{"text":"uturu hwenyoka dzomuguruva.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Munzira munondo uchaparadza vana vavo vose;","poem":1},{"text":"mudzimba dzavo vachagara vachivhundutswa.","poem":2},{"text":"Majaya nemhandara vachaparadzwa,","poem":1},{"text":"vacheche navatana vachaparadzwawo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndakati ndichavaparadzira","poem":1},{"text":"ndigodzima kurangarirwa kwavo kubva pakati pamarudzi,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"asi ndakazotya kutuka kwomuvengi,","poem":1},{"text":"kuti vavengi vavo vasazozvinzwisisa uye vakazoti,","poem":2},{"text":"‘Ruoko rwedu rwatikundisa;","poem":1},{"text":"haazi Jehovha akaita izvi zvose.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Nokuti ivo rudzi rusina mano,","poem":1},{"text":"havagoni kunzvera pakati pavo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Dai chete vakanga vakachenjera","poem":1},{"text":"uye dai vaizonzwisisa izvi nokunzvera kuti magumo avo achazova akaita sei!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ko, munhu mumwe chete angadzinga sei chiuru chavanhu,","poem":1},{"text":"kana kuti vanhu vaviri vangaita kuti vanhu zviuru gumi vatize sei,","poem":2},{"text":"kunze kwokunge Dombo ravo ravatengesa,","poem":1},{"text":"kunze kwokunge Jehovha ari iye avaisa mumaoko avo?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nokuti dombo ravo harina kufanana neDombo redu,","poem":1},{"text":"sezvinofungwa navavengi vedu.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nokuti mazambiringa avo anobva pamizambiringa yeSodhomu","poem":1},{"text":"nokuminda yeGomora.","poem":2},{"text":"Mazambiringa avo azere nomuchetura,","poem":1},{"text":"uye masumbu avo azere nokuvava.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Waini yavo uturu hwenyoka,","poem":1},{"text":"uturu hwakaipisisa hwemhakure.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Ko, handina kuchengeta izvi here,","poem":1},{"text":"uye ndikazvipfigira mumatura angu?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kutsiva ndokwangu; ndichatsiva.","poem":1},{"text":"Nenguva yakafanira tsoka dzavo dzichatedzemuka;","poem":2},{"text":"zuva renjodzi yavo rava pedyo","poem":1},{"text":"uye kuparadzwa kwavo kunokurumidza kuuya pamusoro pavo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"Jehovha achatonga vanhu vake","poem":1},{"text":"uye achanzwira tsitsi varanda vake,","poem":2},{"text":"paanoona simba ravo rapera","poem":1},{"text":"uye pasina asara, akatapwa kana asina.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Achati, “Ko, zvino vamwari vavo varipiko,","poem":1},{"text":"dombo ravakahwanda mariri,","poem":2}]},{"type":"verse","number":38,"content":[{"text":"vamwari vakadya mafuta ezvibayiro zvavo","poem":1},{"text":"nokunwa waini yezvipiriso zvavo zvinonwiwa?","poem":2},{"text":"Ngavasimuke kuti vakubatsirei!","poem":1},{"text":"Ngavakupei pokuvanda!","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Chionai zvino kuti ini pachangu ndini Iye!","poem":1},{"text":"Hakuna mumwe Mwari kunze kwangu,","poem":2},{"lineBreak":true},{"text":"ndinouraya uye ndinopa upenyu,","poem":2},{"lineBreak":true},{"text":"ndakakuvadza uye ndichaporesa, uye hapana anogona kudzikinura muruoko rwangu.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ndinosimudza ruoko rwangu kudenga ndichiti:","poem":1},{"text":"Zvirokwazvo, noupenyu hwangu husingaperi,","poem":2}]},{"type":"verse","number":41,"content":[{"text":"kana ndichirodza munondo wangu unopenya","poem":1},{"text":"uye ruoko rwangu rwaubata mukutonga,","poem":2},{"text":"ndichatsiva kuvavengi vangu","poem":1},{"text":"uye ndigotsiva vaya vanondivenga.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Ndichaita kuti miseve yangu idhakwe neropa ravo,","poem":1},{"text":"uye munondo wangu uchadya nyama:","poem":2},{"text":"ropa revakaurayiwa nevatapwa,","poem":1},{"text":"nemisoro yavatungamiri vavavengi vangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Farai, imi ndudzi, navanhu vake,","poem":1},{"text":"nokuti achatsiva ropa ravaranda vake;","poem":2},{"text":"achatsiva kuvavengi vake","poem":1},{"text":"agoyananisira nyika yake navanhu vake.","poem":2}]},{"type":"verse","number":44,"content":["Mozisi akauya naJoshua mwanakomana waNuni uye akataura kwaari mashoko ose aya orwiyo urwu vanhu vachinzwa."]},{"type":"verse","number":45,"content":["Mozisi akati apedza kutaura mashoko ose aya kuvaIsraeri vose,"]},{"type":"verse","number":46,"content":["akati kwavari, “Isai mumwoyo menyu mashoko ose andakupupurirai nhasi, kuitira kuti mugozorayira vana venyu kuti vachenjerere kuita mashoko ose omurayiro uyu."]},{"type":"verse","number":47,"content":["Haasi mashoko asina maturo kwamuri, asi kuti ndihwo upenyu hwenyu. Namashoko aya muchararama mazuva mazhinji munyika yamuri kuyambuka Jorodhani kuti muitore.”"]},{"type":"heading","content":["Kufa kwaMozisi paGomo reNebho"]},{"type":"verse","number":48,"content":["Pazuva rimwe chetero Jehovha akataura kuna Mozisi akati,"]},{"type":"verse","number":49,"content":["“Kwira kumakomo eAbharimu uende mugomo reNebho muMoabhu, riri mhiri kweJeriko, ugoona nyika yeKenani, nyika yandiri kupa vaIsraeri kuti ive yavo."]},{"type":"verse","number":50,"content":["Ipapo pagomo pauchakwira ndipo pauchafira uye ugova pamwe navanhu vako, sokufa kwakaita mukoma wako Aroni akafira paGomo reHori uye akava navanhu vake."]},{"type":"verse","number":51,"content":["Izvi zvakaitika nokuti imi muri vaviri hamuna kutendeka kwandiri pamberi pavaIsraeri pamvura yeMeribha Kadheshi murenje reZini uye nokuti hamuna kusimudzira utsvene hwangu pakati pavaIsraeri."]},{"type":"verse","number":52,"content":["Naizvozvo, uchaona nyika iyi uri chinhambwe; asi haungapindi munyika yandiri kupa kuvanhu veIsraeri.”"]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}