{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"DEU","translationId":"sna_bib","name":"Dhuteronomi","commonName":"Dhuteronomi","title":"DHUTERONOMI","order":5,"numberOfChapters":34,"sha256":"3a010745a5f6209e57bb69916758e2d905849a9fab6eb579516b458a2cf72463","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/sna_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Mozisi Anoropafadza Marudzi"]},{"type":"verse","number":1,"content":["Uku ndiko kuropafadza kwaMozisi munhu waMwari kwaakataura kuvaIsraeri asati afa."]},{"type":"verse","number":2,"content":["Akati:",{"text":"“Jehovha akabva kuSinai","poem":1},{"text":"akavabudira samambakwedza achibva kuSeiri;","poem":2},{"lineBreak":true},{"text":"akapenya kubva paGomo reParani.","poem":2},{"text":"Akauya nezviuru gumi zvavatsvene kubva rutivi rwezasi,","poem":1},{"text":"kubva kumawere amakomo ake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zvirokwazvo ndimi makada vanhu;","poem":1},{"text":"vatsvene vose vari muruoko rwenyu.","poem":2},{"text":"Patsoka dzenyu vose vanopfugama,","poem":1},{"text":"uye kubva kwamuri vanogamuchira kurayirwa,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"murayiro watakapiwa naMozisi,","poem":1},{"text":"nhaka yeungano yaJakobho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akanga ari mambo weJeshuruni","poem":1},{"text":"vatungamiriri vavanhu pavakanga vakaungana,","poem":2},{"lineBreak":true},{"text":"pamwe chete namarudzi aIsraeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Rubheni ngaararame arege kufa,","poem":1},{"text":"uye vanhu vake ngavarege kuva vashoma.”","poem":2}]},{"type":"verse","number":7,"content":["Uye izvi ndizvo zvaakataura pamusoro paJudha:",{"text":"“Inzwai, imi Jehovha, kuchema kwaJudha;","poem":1},{"text":"muuyisei kuvanhu vake.","poem":2},{"text":"Namaoko ake acharwira mhaka yake.","poem":1},{"text":"Haiwa, ivai mubatsiri wake pavavengi vake!”","poem":2}]},{"type":"verse","number":8,"content":["Pamusoro paRevhi akati,",{"text":"“Tumimi yenyu neUrimi yenyu","poem":1},{"text":"ndezvomunhu wamunoda.","poem":2},{"text":"Makamuedza paMasa;","poem":1},{"text":"makarwa naye pamvura dzeMeribha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akati pamusoro pababa namai vake,","poem":1},{"text":"‘Handivakudzi.’","poem":2},{"text":"Haana kurangarira hama dzake","poem":1},{"text":"kana kuziva vana vake,","poem":2},{"text":"asi akava mutariri weshoko renyu","poem":1},{"text":"akachengetedza sungano yenyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anodzidzisa mitemo yenyu kuna Jakobho","poem":1},{"text":"uye nemirayiro kuna Israeri.","poem":2},{"text":"Achapa zvinonhuhwira pamberi penyu","poem":1},{"text":"nezvipiriso zvose zvinopiswa paaritari yenyu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ropafadzai kubata kwake kwose, imi Jehovha,","poem":1},{"text":"mugofadzwa namabasa amaoko ake.","poem":2},{"text":"Paradzai zviuno zvaavo vanomumukira:","poem":1},{"text":"rovai vavengi vake kusvikira vasisamukizve.”","poem":2}]},{"type":"verse","number":12,"content":["Pamusoro paBhenjamini akati:",{"text":"“Regai mudikanwa waJehovha agare norugare maari,","poem":1},{"text":"nokuti anomudzivirira zuva rose,","poem":2},{"lineBreak":true},{"text":"uye regai uyo anodikanwa naJehovha agare pakati pamapfudzi ake.”","poem":2}]},{"type":"verse","number":13,"content":["Pamusoro paJosefa akati:",{"text":"“Jehovha ngaaropafadze nyika yake","poem":1},{"text":"nedova rinokosha rokudenga kumusoro","poem":2},{"lineBreak":true},{"text":"nemvura zhinji dzakadzika dziri pasi;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nezvakanakisisa zvinouyiswa nezuva","poem":1},{"text":"uye zvakaisvonaka zvinopiwa nomwedzi;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"nezvipo zvakanakisisa zvokumakomo ekare","poem":1},{"text":"uye nezvibereko zvemakomo okusingaperi;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"nezvipo zvakanakisisa zvenyika nokuzara kwayo","poem":1},{"text":"uye nenyasha dzake iye anogara mugwenzi rinopfuta.","poem":2},{"text":"Zvose ngazvigare pamusoro waJosefa,","poem":1},{"text":"pahuma yomuchinda pakati pehama dzake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Muumambo hwake anoita semhongora yenzombe;","poem":1},{"text":"nyanga dzake dzakaita senyanga dzenyati.","poem":2},{"text":"Nadzo achatunga ndudzi,","poem":1},{"text":"kunyange vaya vari kumagumo enyika.","poem":2},{"lineBreak":true},{"text":"Ava ndivo zviuru zvaManase.”","poem":2}]},{"type":"verse","number":18,"content":["Pamusoro paZebhuruni akati:",{"text":"“Fara, iwe Zebhuruni, pakubuda kwako,","poem":1},{"text":"newe Isakari mumatende ako.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Vachadanira vanhu kumakomo","poem":1},{"text":"uye ikoko vagopa zvibayiro zvokururama;","poem":2},{"text":"vachaguta nezvizhinji zvamakungwa,","poem":1},{"text":"nepfuma yakavigwa mujecha.”","poem":2}]},{"type":"verse","number":20,"content":["Pamusoro paGadhi akati:",{"text":"“Ngaaropafadzwe iye anokurisa nyika yaGadhi!","poem":1},{"text":"Gadhi anogaramo seshumba,","poem":2},{"lineBreak":true},{"text":"achibvambura ruoko kana musoro.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Akazvisarudzira nyika yakanakisisa;","poem":1},{"text":"mugove womutungamiri waakachengeterwa iye.","poem":2},{"text":"Vakuru vavanhu pavakaungana,","poem":1},{"text":"iye akaita kuda kwaJehovha kwakarurama,","poem":2},{"lineBreak":true},{"text":"uye nokutonga kwake pamusoro paIsraeri.”","poem":2}]},{"type":"verse","number":22,"content":["Pamusoro paDhani akati:",{"text":"“Dhani mwana weshumba,","poem":1},{"text":"anokwakuka achibva muBhashani.”","poem":2}]},{"type":"verse","number":23,"content":["Pamusoro paNafutari akati:",{"text":"“Nafutari azere nenyasha dzaJehovha","poem":1},{"text":"uye azere kuropafadza kwake:","poem":2},{"lineBreak":true},{"text":"achatora nhaka nechezasi kugungwa.”","poem":2}]},{"type":"verse","number":24,"content":["Pamusoro paAsheri akati:",{"text":"“Akaropafadzwa kupfuura vanakomana vose ndiAsheri:","poem":1},{"text":"ngaadikanwe nehama dzake,","poem":2},{"lineBreak":true},{"text":"uye ngaashambe tsoka dzake mumafuta.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Zvipfigiso zvemasuo ako zvichava zvesimbi nendarira,","poem":1},{"text":"uye simba rako richafanana namazuva ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Hapana akafanana naMwari waJeshuruni,","poem":1},{"text":"iye anotasva denga kuti akubatsire","poem":2},{"lineBreak":true},{"text":"uye namakore muumambo hwake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mwari anogara nokusingaperi ndiye utiziro hwako,","poem":1},{"text":"uye pasi pake pane maoko anogara nokusingaperi.","poem":2},{"text":"Achadzinga vavengi vako kubva pamberi pako,","poem":1},{"text":"achiti, ‘Muparadzei!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Naizvozvo Israeri achagara murugare oga;","poem":1},{"text":"tsime raJakobho rakachengetedzeka","poem":2},{"text":"munyika yezviyo newaini itsva,","poem":1},{"text":"ndiko kunodonhedzerwa dova nedenga.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wakaropafadzwa, iwe Israeri!","poem":1},{"text":"Ndiani akafanana newe,","poem":2},{"lineBreak":true},{"text":"rudzi rwakaponeswa naJehovha?","poem":2},{"text":"Ndiye nhoo nomubatsiri wako uye","poem":1},{"text":"nomunondo wako unobwinya.","poem":2},{"text":"Vavengi vako vachazviisa pasi pako,","poem":1},{"text":"uye iwe uchatsika-tsika nzvimbo dzavo dzakakwirira.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}