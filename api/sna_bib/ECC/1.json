{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ECC","translationId":"sna_bib","name":"Muparidzi","commonName":"Muparidzi","title":"MUPARIDZI","order":21,"numberOfChapters":12,"sha256":"ca86287f3bfdc970e41cfb7b4e7364991599b9ce2efc37c3854104f421a966e8","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/sna_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["Zvose hazvina maturo"]},{"type":"verse","number":1,"content":["Mashoko oMuparidzi, mwanakomana waDhavhidhi, mambo muJerusarema:"]},{"type":"verse","number":2,"content":[{"text":"Zvanzi noMuparidzi,","poem":1},{"text":"“Hazvina maturo! Hazvina maturo!","poem":2},{"text":"Hazvina maturo chose!","poem":1},{"text":"Zvose hazvina maturo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Munhu achawaneiko kubva pakushanda kwake kwose","poem":1},{"text":"kwaanoita nesimba pasi pezuva?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zvizvarwa zvinouya uye zvizvarwa zvinoenda,","poem":1},{"text":"asi nyika inogara nokusingaperi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zuva rinobuda uye zuva rinovira,","poem":1},{"text":"uye rinokurumidza kudzokerazve kwarinobudira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mhepo inovhuvhuta ichienda zasi,","poem":1},{"text":"yozodzokera kumusoro;","poem":2},{"text":"inotenderera nokutenderera","poem":1},{"text":"ichingodzokerazve pagwara rayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nzizi dzose dzinodira mugungwa,","poem":1},{"text":"kunyange zvakadaro gungwa harizari.","poem":2},{"text":"Kunzvimbo kwadzinobva nzizi,","poem":1},{"text":"ikoko ndiko kwadzinodzokerazve.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zvinhu zvose zvinonetesa,","poem":1},{"text":"zvisina ani angazvitaura.","poem":2},{"text":"Ziso hariguti kuona,","poem":1},{"text":"uye nzeve haizari nokunzwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chakanga chiripo, chichazovapozve,","poem":1},{"text":"chakamboitwa chichaitwazve;","poem":2},{"lineBreak":true},{"text":"hapana chitsva pasi pezuva.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Chiripo here chinhu chinganzi nomunhu,","poem":1},{"text":"“Tarira! Chinhu ichi chitsva?”","poem":2},{"text":"Chakanga chichingovapo, kare kare;","poem":1},{"text":"chakanga chiripo isu tisati tavapo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vanhu vakare havacharangarirwi;","poem":1},{"text":"uye kunyange vanovatevera,","poem":2},{"text":"havachazorangarirwi","poem":1},{"text":"nevanozotevera.","poem":2}]},{"type":"heading","content":["Uchenjeri hahuna maturo"]},{"type":"verse","number":12,"content":["Ini muparidzi ndakanga ndiri mambo weIsraeri muJerusarema."]},{"type":"verse","number":13,"content":["Ndakazvipira kunzvera nokutsvaka nouchenjeri zvose zvinoitwa pasi pedenga. Ibasa rinotambudza rakapiwa vanakomana vavanhu naMwari kuti vazvitambudze naro."]},{"type":"verse","number":14,"content":["Ndakaona zvinhu zvose zvinoitwa pasi pezuva; zvose hazvo hazvina maturo, kudzingana nemhepo bedzi."]},{"type":"verse","number":15,"content":[{"text":"Chakakombamiswa hachingatwasanudzwi;","poem":1},{"text":"chinoshayikwa hachingaverengwi.","poem":2}]},{"type":"verse","number":16,"content":["Ndakafunga mumwoyo mangu ndikati, “Tarira, ndazviwanira uchenjeri hwakawanda kupfuura vose vakanditangira kutonga muJerusarema; ndava nouchenjeri uye noruzivo rwakawanda.”"]},{"type":"verse","number":17,"content":["Ipapo ndakazvipira kutsvaka kunzwisisa uchenjeri uyezve noupengo noupenzi, asi ndakadzidzawo zvakare kuti, naizvozviwo kudzingana nemhepo."]},{"type":"verse","number":18,"content":[{"text":"Nokuti muuchenjeri huzhinji mune kusuwa kuzhinji;","poem":1},{"text":"kuwanda kwezivo, kuwandawo kwokuchema.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}