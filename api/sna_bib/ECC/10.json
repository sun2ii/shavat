{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ECC","translationId":"sna_bib","name":"Muparidzi","commonName":"Muparidzi","title":"MUPARIDZI","order":21,"numberOfChapters":12,"sha256":"ca86287f3bfdc970e41cfb7b4e7364991599b9ce2efc37c3854104f421a966e8","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/sna_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Nhunzi dzakafa dzinonhuwisa mafuta akanaka,","poem":1},{"text":"saizvozvowo upenzi hushoma hunorema kukunda uchenjeri nokukudzwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwoyo womunhu akachenjera unosimbira kurudyi,","poem":1},{"text":"asi mwoyo webenzi unosimbira kuruboshwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kunyange richifamba pamugwagwa,","poem":1},{"text":"benzi rinoshayiwa njere","poem":2},{"lineBreak":true},{"text":"uye rinoratidza vanhu vose upenzi hwaro.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kana kutsamwa kwomutongi kukakumukira,","poem":1},{"text":"usabva panzvimbo yako;","poem":2},{"lineBreak":true},{"text":"unyoro hunonyaradza mhosva huru.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kune chinhu chakaipa chandakaona pasi pezuva,","poem":1},{"text":"kutadza kunobva kuvatongi:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mapenzi anoiswa munzvimbo zhinji dzapamusoro,","poem":1},{"text":"ipapo vapfumi vachitora nzvimbo dzakaderera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndakaona varanda vakatasva mabhiza,","poem":1},{"text":"ipapo machinda achifamba pasi netsoka savaranda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ani naani anochera gomba angangowira mariri;","poem":1},{"text":"ani naani anopwanya naparusvingo angangorumwa nenyoka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani naani anopwanya matombo angangokuvadzwa nawo;","poem":1},{"text":"ani naani anotsemura matanda angangozviisa panjodzi nawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kana demo rakagomara","poem":1},{"text":"uye rikasarodzwa,","poem":2},{"text":"panodiwa simba rakawanda,","poem":1},{"text":"asi unyanzvi hunouyisa kubudirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kana nyoka ikaruma mupingudzi asati aibata,","poem":1},{"text":"mupingudzi haachabatsiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mashoko anobva mumuromo momunhu akachenjera ane unyoro,","poem":1},{"text":"asi benzi rinomedzwa nomuromo waro.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kutanga kwamashoko ake upenzi;","poem":1},{"text":"nokuguma kwokutaura kwake mupengo wakashata.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Uye benzi rinowanza mashoko.","poem":2},{"lineBreak":true},{"text":"Hapana munhu anoziva zvichauya,","poem":1},{"text":"ndiani angamuudza zvichaitika shure kwake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Basa rebenzi rinomunetesa;","poem":1},{"text":"haazivi nzira inoenda kuguta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Une nhamo iwe nyika ina mambo aiva muranda","poem":1},{"text":"uye ina machinda anoita mabiko mangwanani.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wakaropafadzwa iwe nyika ina mambo akaberekwa mukukudzwa","poem":1},{"text":"uye ina machinda anodya panguva yakafanira,","poem":2},{"lineBreak":true},{"text":"kuti vasimbiswe kwete kuti vadhakwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kana munhu ari simbe, denga remba rinosakara;","poem":1},{"text":"kana achigarira maoko, imba inobvinza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mabiko anoitirwa kuseka,","poem":1},{"text":"uye waini inofadza upenyu,","poem":2},{"lineBreak":true},{"text":"asi mari imhinduro kune zvose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Usatuka mambo kunyange mupfungwa dzako,","poem":1},{"text":"kana kutuka mupfumi paimba yako yokuvata,","poem":2},{"text":"nokuti shiri yedenga ingangotakura mashoko ako,","poem":1},{"text":"uye china mapapiro chingangozivisa zvawataura.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}