{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ECC","translationId":"sna_bib","name":"Muparidzi","commonName":"Muparidzi","title":"MUPARIDZI","order":21,"numberOfChapters":12,"sha256":"ca86287f3bfdc970e41cfb7b4e7364991599b9ce2efc37c3854104f421a966e8","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/sna_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["Chingwa pamusoro peMvura"]},{"type":"verse","number":1,"content":[{"text":"Kanda chingwa chako pamusoro pemvura zhinji,","poem":1},{"text":"nokuti mushure mamazuva mazhinji uchachiwanazve.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Govera vanomwe, kunyange navaserewo;","poem":1},{"text":"nokuti hauzivi kuti idambudziko rakadii richauya panyika.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kana makore azara nemvura","poem":1},{"text":"anonayisa mvura panyika.","poem":2},{"text":"Hazvinei kuti muti wawira zasi kana kumusoro,","poem":1},{"text":"panzvimbo paunowira, ndipo paucharara.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani naani anotarira mhepo haangadyari;","poem":1},{"text":"ani naani anotarira makore haangakohwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sezvo usingazivi nzira yemhepo,","poem":1},{"text":"kana magadzirirwo omuviri mudumbu ramai,","poem":2},{"text":"saizvozvowo haunganzwisisi basa raMwari,","poem":1},{"text":"Muiti wezvose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kusha mbeu dzako mangwanani,","poem":1},{"text":"uye madekwana urege kugarira maoko ako,","poem":2},{"text":"nokuti hauzivi kuti chichabudirira ndechipi,","poem":1},{"text":"chingava ichi kana icho,","poem":2},{"lineBreak":true},{"text":"kana kuti zvose zviri zviviri zvichafanana pakunaka.","poem":2}]},{"type":"heading","content":["Rangarira Musiki wako uchiri muduku"]},{"type":"verse","number":7,"content":[{"text":"Chiedza chakanaka,","poem":1},{"text":"uye zvinofadza meso kuona zuva.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kunyange zvazvo munhu akararama makore mazhinji,","poem":1},{"text":"ngaafadzwe nawo ose.","poem":2},{"text":"Asi ngaarangarire mazuva erima,","poem":1},{"text":"nokuti achava mazhinji.","poem":2},{"lineBreak":true},{"text":"Zvose zvichazouya hazvina maturo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Fara zvako jaya, pauduku hwako,","poem":1},{"text":"uye mwoyo wako ngaukupe mufaro pamazuva ouduku hwako.","poem":2},{"text":"Tevera nzira dzomwoyo wako,","poem":1},{"text":"nezvose zvingaonekwe nameso ako,","poem":2},{"text":"asi uzive kuti pazvinhu zvose izvi","poem":1},{"text":"Mwari achakusvitsa pakutongwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Saka zvino dzinga zvinonetsa pamwoyo","poem":1},{"text":"wako ugobvisa zvinotambudza pamuviri wako,","poem":2},{"lineBreak":true},{"text":"nokuti uduku nesimba hazvina maturo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}