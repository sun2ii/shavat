{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ECC","translationId":"sna_bib","name":"Muparidzi","commonName":"Muparidzi","title":"MUPARIDZI","order":21,"numberOfChapters":12,"sha256":"ca86287f3bfdc970e41cfb7b4e7364991599b9ce2efc37c3854104f421a966e8","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/sna_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Rangarira Musiki wako","poem":1},{"text":"pamazuva ouduku hwako,","poem":2},{"text":"mazuva okutambudzika asati auya,","poem":1},{"text":"namakore asati aswedera pauchati,","poem":2},{"lineBreak":true},{"text":"“Handioni zvinofadza maari,”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"zuva nechiedza uye nomwedzi","poem":1},{"text":"nenyeredzi zvisati zvadzima,","poem":2},{"lineBreak":true},{"text":"uye makore asati adzoka mushure mokunaya kwemvura;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kana vatariri vemba vodedera,","poem":1},{"text":"navarume vakasimba vokotama,","poem":2},{"text":"kana vakuyi vorega nokuti vashoma,","poem":1},{"text":"uye vaya vanotarira napamawindo voonera madzerere;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kana mikova yokunzira ichinge yapfigwa","poem":1},{"text":"uye maungira okukuya oderera;","poem":2},{"text":"kana vanhu vomutswa nokuimba kweshiri","poem":1},{"text":"asi nziyo dzavo dzose dzisisanzwiki zvakanaka;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"kana vanhu votya nzvimbo dzakakwirira","poem":1},{"text":"nenjodzi mumigwagwa;","poem":2},{"text":"kana muamanda wotumbuka","poem":1},{"text":"nemhashu yozvikwekweredza","poem":2},{"lineBreak":true},{"text":"uye kuda kwose kwapera.","poem":2},{"text":"Ipapo munhu anoenda kumusha wake usingaperi,","poem":1},{"text":"uye vanochema vachafamba-famba munzira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Murangarirei, rwodzi rwesirivha rusati rwadambuka;","poem":1},{"text":"uye mbiya yegoridhe isati yaputswa;","poem":2},{"text":"chirongo chisati chapwanyika pachitubu,","poem":1},{"text":"uye vhiri risati raputswa patsime,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"uye guruva risati radzokera kuvhu kwarakabva,","poem":1},{"text":"nomweya usati wadzokera kuna Mwari akaupa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Muparidzi anoti, “Hazvina maturo! Hazvina maturo!","poem":1},{"text":"Zvose hazvina maturo!”","poem":2}]},{"type":"heading","content":["Magumo eNyaya"]},{"type":"verse","number":9,"content":["Muparidzi akanga asina kuchenjera chete asi akadzidzisawo zivo kuvanhu. Akarangarira akaongorora uye akaronga zvirevo zvizhinji."]},{"type":"verse","number":10,"content":["Muparidzi akatsvaka kuti awane mashoko akanaka chete, uye zvaakanyora zvakarurama uye ndezvechokwadi."]},{"type":"verse","number":11,"content":["Mashoko avachenjeri akafanana nezvibayiso, mashoko avo akaunganidzwa akasimbiswa sembambo dzakarovererwa kwazvo, akapiwa noMufudzi mumwe chete."]},{"type":"verse","number":12,"content":["Yambirwa, mwanakomana wangu, kuti pasava nechinhu chipi zvacho chichawedzerwa pazviri. Zvokunyora mabhuku mazhinji hazvina magumo, uye kudzidza zvizhinji kunonetesa muviri."]},{"type":"verse","number":13,"content":[{"text":"Zvino zvose zvanzwikwa;","poem":1},{"text":"houno mugumo wenyaya yacho:","poem":2},{"text":"Itya Mwari uchengete mirayiro yake,","poem":1},{"text":"nokuti iri ndiro basa rose romunhu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nokuti Mwari achatonga basa rimwe nerimwe","poem":1},{"text":"kusanganisira nezvakavanzika zvose,","poem":2},{"lineBreak":true},{"text":"zvakanaka kana zvakaipa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}