{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ECC","translationId":"sna_bib","name":"Muparidzi","commonName":"Muparidzi","title":"MUPARIDZI","order":21,"numberOfChapters":12,"sha256":"ca86287f3bfdc970e41cfb7b4e7364991599b9ce2efc37c3854104f421a966e8","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/sna_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"heading","content":["Udzvinyiriri, Kushanda, noKusava Neshamwari"]},{"type":"verse","number":1,"content":["Ndakatarirazve ndikaona udzvinyiriri hwose hwaiitika pasi pezuva:",{"text":"Ndakaona misodzi yavanodzvinyirirwa,","poem":1},{"text":"uye havana munyaradzi;","poem":2},{"text":"simba raiva kudivi ravadzvinyiriri vavo,","poem":1},{"text":"uye havana munyaradzi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndakati vakafa,","poem":1},{"text":"vakanguri vafa kare,","poem":2},{"text":"vano mufaro kupfuura vapenyu,","poem":1},{"text":"vachiri kurarama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asi ari nani kupfuura","poem":1},{"text":"vose ndiye uyo asati atombovapo,","poem":2},{"text":"uyo asati amboona zvakaipa","poem":1},{"text":"zvinoitwa pasi pezuva.","poem":2}]},{"type":"verse","number":4,"content":["Uye ndakaona kuti kushanda kwose nokuwana kwose kwomunhu kunobva pakuchiva muvakidzani wake. Izviwo hazvina maturo, kudzinganisana nemhepo."]},{"type":"verse","number":5,"content":[{"text":"Benzi rinopeta maoko aro,","poem":1},{"text":"rozviparadza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsama imwe yorugare","poem":1},{"text":"inopfuura tsama mbiri dzokutambudzika","poem":2},{"lineBreak":true},{"text":"nokudzingana nemhepo.","poem":2}]},{"type":"verse","number":7,"content":["Zvino ndakaona chinhu chisina maturo pasi pezuva."]},{"type":"verse","number":8,"content":[{"text":"Kwaiva nomunhu aigara ari oga;","poem":1},{"text":"akanga asina mwanakomana, kana mununʼuna.","poem":2},{"text":"Kushanda kwake kwakanga kusina magumo,","poem":1},{"text":"kunyange zvakadaro meso ake haana kugutswa nepfuma yake.","poem":2},{"text":"Akabvunza akati, “Ndinotambudzikira aniko,","poem":1},{"text":"uye sei ndichizvinyima mafaro?”","poem":2},{"text":"Naizvozviwo hazvina maturo,","poem":1},{"text":"basa rokutambura!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Vaviri vari nani pano mumwe chete,","poem":1},{"text":"nokuti vano mugove wakanaka pakushanda kwavo:","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kana mumwe akawira pasi,","poem":1},{"text":"shamwari yake inogona kumubatsira kuti amire zvakare.","poem":2},{"text":"Asi ane nhamo munhu anowira pasi,","poem":1},{"text":"asina anomusimudza!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uyezve kana vaviri vachivata pamwe chete, vachadziyirwa.","poem":1},{"text":"Asi mumwe chete angadziyirwa sei?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Munhu mumwe chete angakurirwa simba,","poem":1},{"text":"asi vaviri vanozvidzivirira.","poem":2},{"text":"Rwodzi rwakakoswa mutatu harungakurumidzi kudamburwa.","poem":1}]},{"type":"heading","content":["Kuenda mberi hakuna maturo"]},{"type":"verse","number":13,"content":["Jaya murombo asi rakachenjera riri nani kupfuura mambo mutana ari benzi, asisazivi kuteerera kana achipiwa yambiro."]},{"type":"verse","number":14,"content":["Jaya ringava rakabva mutorongo rikazova mambo, kana angava akaberekwa ari muurombo, muushe hwokwake."]},{"type":"verse","number":15,"content":["Ndakaona kuti vose vapenyu vakafamba pasi pezuva vakatevera jaya, rakazotevera panzvimbo yamambo."]},{"type":"verse","number":16,"content":["Vakanga vasingaverengeki vanhu vose vaaitonga. Asi vakazouya pashure havana kufadzwa neakanga achitonga panzvimbo yamambo. Naizvozviwo hazvina maturo, kudzinganisana nemhepo."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}