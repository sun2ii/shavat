{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ECC","translationId":"sna_bib","name":"Muparidzi","commonName":"Muparidzi","title":"MUPARIDZI","order":21,"numberOfChapters":12,"sha256":"ca86287f3bfdc970e41cfb7b4e7364991599b9ce2efc37c3854104f421a966e8","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/sna_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["Uchenjeri"]},{"type":"verse","number":1,"content":[{"text":"Zita rakanaka rinopfuura mafuta anonhuhwira zvakanaka kwazvo,","poem":1},{"text":"uye zuva rokufa rinopfuura zuva rokuzvarwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zviri nani kuenda kuimba yokuchema","poem":1},{"text":"pano kuenda kuimba yamabiko,","poem":2},{"text":"nokuti rufu ndiwo mugumo womunhu wose;","poem":1},{"text":"vapenyu ngavazviise izvi pamwoyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kusuwa kunopfuura kuseka,","poem":1},{"text":"nokuti chiso chinopunyaira chakanakira mwoyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwoyo womuchenjeri uri mumba yokuchema,","poem":1},{"text":"asi mwoyo yamapenzi iri kuimba yamafaro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zviri nani kuteerera kutsiura kwomunhu akachenjera,","poem":1},{"text":"pano kuteerera rwiyo rwamapenzi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sokuputika kweminzwa pasi pehari,","poem":1},{"text":"ndizvo zvakaita kuseka kwamapenzi.","poem":2},{"lineBreak":true},{"text":"Naizvozviwo hazvina maturo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Udzvinyiriri hunoshandura muchenjeri achiva benzi,","poem":1},{"text":"uye fufuro inosvibisa mwoyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Magumo echinhu anopfuura mavambo acho,","poem":1},{"text":"uye mwoyo murefu unopfuura kuzvikudza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Usakurumidza kutsamwa pamweya wako","poem":1},{"text":"nokuti kutsamwa kunogara muchipfuva chamapenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Usati, “Sei mazuva akare ari nani kupfuura azvino?”","poem":1},{"text":"Nokuti hazvina kuchenjera kubvunza mibvunzo yakadaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Uchenjeri chinhu chakanaka senhaka,","poem":1},{"text":"uye hunobatsira avo vanoona zuva.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uchenjeri hunodzivirira sokudzivirira kunoita mari,","poem":1},{"text":"asi kunakisa kworuzivo ndokuku:","poem":2},{"text":"kuti uchenjeri hunochengetedza","poem":1},{"text":"upenyu hwomunhu anahwo.","poem":2}]},{"type":"verse","number":13,"content":["Cherechedza zvakaitwa naMwari:",{"text":"Ndiani angatwasanudza","poem":1},{"text":"zvaakagonyanisa?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kana zvinhu zvakanaka, fara;","poem":1},{"text":"asi kana nguva dzakaipa, rangarira kuti:","poem":2},{"text":"Mwari ndiye akaita izvozvo","poem":1},{"text":"zvose zviri zviviri.","poem":2},{"text":"Naizvozvo, munhu haagoni kuziva chinhu","poem":1},{"text":"pamusoro peramangwana rake.","poem":2}]},{"type":"verse","number":15,"content":["Muupenyu hwangu husina maturo ndakaona zvose izvi:",{"text":"akarurama achiparara mukururama kwake,","poem":1},{"text":"nowakaipa achirarama nguva refu mukuipa kwake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Usava munhu akanyanyisa kururama,","poem":1},{"text":"kana munhu akanyanyisa kuchenjera,","poem":2},{"lineBreak":true},{"text":"uchazviparadzireiko?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Usava munhu akanyanyisa kuipa,","poem":1},{"text":"uye usava benzi.","poem":2},{"lineBreak":true},{"text":"Ungada kufa nguva yako isati yakwana?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zvakanaka kubatisisa chimwe chinhu,","poem":1},{"text":"uye usingaregedzi chimwe chacho chichienda.","poem":2},{"lineBreak":true},{"text":"Munhu anotya Mwari acharega kuita zvinopfurikidza mwero.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Uchenjeri hunoita kuti mumwe munhu akachenjera","poem":1},{"text":"ave nesimba guru kupfuura vatariri gumi vari muguta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hapana munhu akarurama panyika,","poem":1},{"text":"anoita zvakanaka uye asingatadzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Usava nehanya namashoko ose anotaurwa navanhu,","poem":1},{"text":"zvichida ungangonzwa muranda wako achikutuka,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"nokuti unoziva mumwoyo mako","poem":1},{"text":"kuti nguva zhinji iwe pachako wakambotuka vamwe.","poem":2}]},{"type":"verse","number":23,"content":["Zvose izvi ndakazviedza nouchenjeri ndikati,",{"text":"“Ndakazvipira kuva munhu akachenjera,”","poem":1},{"text":"asi izvi zvaiva kure neni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Chii zvacho chingava uchenjeri,","poem":1},{"text":"chiri kure kwazvo uye chakadzama,","poem":2},{"lineBreak":true},{"text":"ndiani angachiwana?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Saka ndakashandura pfungwa dzangu ndikatanga kutsvaka kunzwisisa,","poem":1},{"text":"kuti ndiongorore uye nditsvakisise uchenjeri nourongwa hwezvinhu,","poem":2},{"text":"uye kuti ndinzwisise upenzi hwokuipa","poem":1},{"text":"nomupengo hwoupenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ndakawana chinhu chinovava kupfuura rufu,","poem":1},{"text":"mukadzi anova musungo,","poem":2},{"text":"mwoyo wake uri hunza","poem":1},{"text":"uye maoko ake ari ngetani.","poem":2},{"text":"Munhu anofadza Mwari achapunyuka kwaari,","poem":1},{"text":"asi mutadzi achabatwa naye.","poem":2}]},{"type":"verse","number":27,"content":["Muparidzi anoti, “Tarira, izvi ndizvo zvandakawana:",{"text":"“Ndichisanganisa chimwe nechimwe kuti ndiwane marongerwo ezvinhu,","poem":1}]},{"type":"verse","number":28,"content":[{"text":"pandakanga ndichiri kutsvaka","poem":2},{"lineBreak":true},{"text":"asi ndisina chandinowana,","poem":2},{"text":"ndakawana murume mumwe chete akarurama pakati pechiuru,","poem":1},{"text":"asi handina kuwana mukadzi mumwe chete akarurama pakati pavo vose.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Chinhu ichi chete ndicho chandakawana chokuti:","poem":1},{"text":"Mwari akaita vanhu vakarurama,","poem":2},{"lineBreak":true},{"text":"asi vanhu vakaenda kundotsvaka mano mazhinji.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}