{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"EXO","translationId":"sna_bib","name":"Ekisodho","commonName":"Ekisodho","title":"EKISODHO","order":2,"numberOfChapters":40,"sha256":"e1614e42c1baef968ae09edf3084b980d6d8b5d441b202dfc0926064861cba93","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/sna_bib/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Rwiyo rwaMozisi naMiriamu"]},{"type":"verse","number":1,"content":["Ipapo Mozisi navaIsraeri vakaimba rwiyo urwu kuna Jehovha:",{"text":"“Ndichaimbira Jehovha,","poem":1},{"text":"nokuti iye anokudzwa zvikurukuru.","poem":2},{"text":"Bhiza nomutasvi waro akazvikanda mugungwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Jehovha ndiye simba rangu norwiyo rwangu;","poem":1},{"text":"iye ava ruponeso rwangu.","poem":2},{"text":"Ndiye Mwari wangu, uye ndichamurumbidza,","poem":1},{"text":"Mwari wababa vangu, uye ndichamukudza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jehovha imhare;","poem":1},{"text":"Jehovha ndiro zita rake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoro dzaFaro nehondo yake","poem":1},{"text":"akazvikanda mugungwa.","poem":2},{"text":"Machinda aFaro akanakisisa","poem":1},{"text":"akanyudzwa muGungwa Dzvuku.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mvura yakadzika yakavafukidza;","poem":1},{"text":"vakanyura kwakadzika sedombo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ruoko rwenyu rworudyi, imi Jehovha,","poem":1},{"text":"rwakakudzwa nesimba.","poem":2},{"text":"Ruoko rwenyu rworudyi, imi Jehovha,","poem":1},{"text":"rwakaparadza muvengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Muukuru hwoumambo hwenyu","poem":1},{"text":"makakanda pasi vaya vaikupikisai.","poem":2},{"text":"Makasunungura kutsamwa kwenyu kunopisa,","poem":1},{"text":"kukavapisa sehundi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nokufema kwemhino dzenyu","poem":1},{"text":"mvura zhinji yakaita murwi.","poem":2},{"text":"Mvura yamasaisai yakamira yakasimba semadziro;","poem":1},{"text":"mvura yakadzika yakaungana mukati megungwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Muvengi akazvikudza achiti,","poem":1},{"text":"‘Ndichavatevera, ndichavabata.","poem":2},{"text":"Ndichagova zvakapambwa;","poem":1},{"text":"ndichazvimbirwa navo.","poem":2},{"text":"Ndichavhomora munondo wangu","poem":1},{"text":"uye ruoko rwangu ruchavaparadza.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asi makafuridza nokufema kwenyu,","poem":1},{"text":"gungwa rikavafukidza.","poem":2},{"text":"Vakanyura somutobvu","poem":1},{"text":"mukati memvura ine simba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ndianiko pakati pavamwari akaita semi, imi Jehovha?","poem":1},{"text":"Ndiani akaita semi,","poem":2},{"text":"paumambo noutsvene,","poem":3},{"lineBreak":true},{"text":"mukubwinya kunotyisa,","poem":3},{"lineBreak":true},{"text":"anoita zvishamiso?","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Makatambanudza ruoko rwenyu rworudyi,","poem":1},{"text":"nyika ikavamedza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Murudo rwenyu rusingaperi muchatungamirira","poem":1},{"text":"vanhu vamakadzikinura.","poem":2},{"text":"Musimba renyu imi muchavatungamirira","poem":1},{"text":"kuugaro hwenyu hutsvene.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndudzi dzichazvinzwa uye dzichadedera;","poem":1},{"text":"kurwadziwa kuchabata vanhu vokuFiristia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Madzishe eEdhomu achavhundutswa,","poem":1},{"text":"vatungamiri veMoabhu vachabatwa nokudedera,","poem":2},{"text":"vanhu veKenani vachanyunguduka;","poem":1}]},{"type":"verse","number":16,"content":[{"text":"kutya nokuvhunduka zvichavawira.","poem":2},{"text":"Nesimba roruoko rwenyu vachanyarara kunge dombo,","poem":1},{"lineBreak":true},{"text":"kusvikira vanhu venyu vapfuura, imi Jehovha,","poem":1},{"text":"kusvikira vanhu vamakatenga vapfuura.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Muchaenda navomo uye mugovasima","poem":1},{"text":"pagomo renhaka yenyu,","poem":2},{"text":"nzvimbo tsvene","poem":1},{"text":"yakasimbiswa namaoko enyu, imi Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Jehovha achatonga","poem":1},{"text":"nokusingaperi-peri.”","poem":2}]},{"type":"verse","number":19,"content":["Mabhiza aFaro, ngoro navatasvi vamabhiza vakapinda mugungwa, Jehovha akauyisa mvura yomugungwa pamusoro pavo, asi vaIsraeri vakafamba napakati pegungwa pavhu rakaoma."]},{"type":"verse","number":20,"content":["Ipapo Miriamu muprofitakadzi, hanzvadzi yaAroni, akatora tambureni muruoko rwake, uye vakadzi vose vakamutevera, vana matambureni uye vachitamba."]},{"type":"verse","number":21,"content":["Miriamu akavaimbira akati:",{"text":"“Imbirai Jehovha,","poem":1},{"text":"nokuti anokudzwa zvikuru kuru.","poem":2},{"text":"Bhiza nomutasvi waro","poem":1},{"text":"akazvikanda mugungwa.”","poem":2}]},{"type":"heading","content":["Mvura yeMara neyeErimu"]},{"type":"verse","number":22,"content":["Ipapo Mozisi akatungamirira vaIsraeri kubva paGungwa Dzvuku uye vakapinda murenje reShuri. Vakafamba kwamazuva matatu murenje vachishayiwa mvura."]},{"type":"verse","number":23,"content":["Vakati vasvika paMara, havana kugona kunwa mvura yacho nokuti yaivava. (Ndokusaka nzvimbo yacho ichinzi Mara.)"]},{"type":"verse","number":24,"content":["Saka vanhu vakapopotera Mozisi vachiti, “Tonweiko?”"]},{"type":"verse","number":25,"content":["Ipapo Mozisi akachema kuna Jehovha, Jehovha akamuratidza chimuti. Akachikanda mumvura, mvura ikanaka. Jehovha akavaitirapo mutemo nomurayiro, uye akavaedza ipapo."]},{"type":"verse","number":26,"content":["Akati, “Kana mukanyatsoteerera inzwi raJehovha Mwari wenyu uye mukaita zvakarurama pamberi pake, kana mukarerekera nzeve dzenyu kumirayiro yake uye mukachengeta mitemo yose, haangauyisi pamusoro penyu zvirwere zvose zvandakauyisa pamusoro pavaIjipita, nokuti ndini Jehovha anokuporesai.”"]},{"type":"verse","number":27,"content":["Ipapo vakasvika paErimu, paiva namatsime gumi namaviri uye nemiti yemichindwe makumi manomwe, uye vakadzika misasa ipapo pedyo nemvura."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}