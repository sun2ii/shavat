t":"yarasikirwa nezvayakanga yakatarisira,","poem":2},{"text":"yakatora mumwe wevana vayo","poem":1},{"text":"ndokumuita shumba yakasimba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yakafamba ichinyahwaira pakati peshumba,","poem":1},{"text":"nokuti yakanga yava shumba ine simba zvino.","poem":2},{"text":"Yakadzidza kubvambura chayabata","poem":1},{"text":"uye yaidya vanhu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yakakoromora nhare dzavo","poem":1},{"text":"uye ikaparadza maguta avo.","poem":2},{"text":"Nyika navose vaivamo","poem":1},{"text":"vakavhundutswa nokuomba kwayo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ipapo ndudzi dzakarwisana nayo,","poem":1},{"text":"vaya vaibva kumatunhu akapoteredza.","poem":2},{"text":"Vakaikandira mambure,","poem":1},{"text":"iyo ndokubatwa muhunza yavo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vakaipinza muchizarira nezvikokovono","poem":1},{"text":"vakandoiisa kuna mambo weBhabhironi.","poem":2},{"text":"Vakaiisa mutorongo,","poem":1},{"text":"saka kuomba kwayo hakuna kuzonzwikwazve","poem":2},{"lineBreak":true},{"text":"pamakomo aIsraeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Mai vako vakanga vakaita somuzambiringa mumunda wako wemizambiringa,","poem":1},{"text":"wakasimwa pane mvura;","poem":2},{"text":"wakanga une zvibereko uye uzere namatavi","poem":1},{"text":"nokuda kwemvura zhinji.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Matavi awo akanga akasimba,","poem":1},{"text":"akanakira kuva tsvimbo yomutongi.","poem":2},{"text":"Wakanga wakareba kwazvo","poem":1},{"text":"pamusoro pamatavi makobvu akapfumvutira,","poem":2},{"text":"waionekera kumusoro-soro nokuda kwourefu hwawo,","poem":1},{"text":"uye nokuda kwamatavi awo mazhinji.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi wakadzurwa nehasha","poem":1},{"text":"ndokukandwa pasi.","poem":2},{"text":"Mhepo yokumabvazuva yakauomesa,","poem":1},{"text":"ukazunzwa michero yawo;","poem":2},{"text":"matavi awo akasimba akaoma,","poem":1},{"text":"uye moto ukaapisa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zvino wakasimwa mugwenga,","poem":1},{"text":"munyika yakaoma ine nyota.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Moto wakapambira uchibva kune rimwe davi rawo guru","poem":1},{"text":"ndokupisa michero yawo.","poem":2},{"text":"Hapana davi rakasimba rakasara pauri","poem":1},{"text":"rakanakira kuva tsvimbo yomutongi.’","poem":2},"Uku kuchema uye kunofanira kushandiswa pakuchema.”"]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}