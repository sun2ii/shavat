{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"EZK","translationId":"sna_bib","name":"Ezekieri","commonName":"Ezekieri","title":"EZEKIERI","order":26,"numberOfChapters":48,"sha256":"5479e86b799fa929aed687a185ce4d5cbae45313a4b8a4ad387dec4723f1eedb","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/sna_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":27,"content":[{"type":"heading","content":["Kuchema pamusoro peTire"]},{"type":"verse","number":1,"content":["Shoko raJehovha rakasvika kwandiri richiti,"]},{"type":"verse","number":2,"content":["“Mwanakomana womunhu, chema pamusoro peTire."]},{"type":"verse","number":3,"content":["Uti kuTire, riri pasuo rokugungwa, mushambadziri wavanhu vamarudzi ose pazviwi zvizhinji, ‘Zvanzi naIshe Jehovha:",{"text":"“ ‘Unoti, iwe Tire,","poem":1},{"text":"“Ini ndakakwana parunako.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Simba rako rakanga riri pamakungwa makuru;","poem":1},{"text":"vavaki vako vakaita kuti runako rwako rusvike pakukwana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vakaita mapuranga ako ose","poem":1},{"text":"emiti yemipaini inobva kuSeniri;","poem":2},{"text":"vakatora musidhari waibva kuRebhanoni,","poem":1},{"text":"kuti vakuitire danda rokutsigira maseiri muchikepe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vakaita matanda okukwasva nawo","poem":1},{"text":"omuouki aibva kuBhashani;","poem":2},{"text":"namapuranga omusipuresi aibva kuzviwi zveSaipurasi","poem":1},{"text":"vakaita uriri hwako namapuranga, ane nyanga dzenzou mukati.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maseiri ako akanga ari omucheka wakarukwa zvakaisvonaka waibva kuIjipiti,","poem":1},{"text":"uye wakashandiswa somureza wako;","poem":2},{"text":"zvifukidzo zvako zvamatende zvakanga zviri bhuruu nepepuru,","poem":1},{"text":"zvaibva kumahombekombe aErisha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Varume veSidhoni neArivhadhi ndivo vakanga vari vakwasvi vako;","poem":1},{"text":"mhizha dzako, iwe Tire dzakanga dzirimo savafambisi vako vechikepe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mhare dzoumhizha dzeGebhari vakanga varimo,","poem":1},{"text":"savavaki vechikepe kuti vaname maburi emaseiri ako.","poem":2},{"text":"Zvikepe zvose zvegungwa navafambisi vazvo","poem":1},{"text":"vakauya kuzotengeserana newe zvawakagadzira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Varume vokuPezhia, neRidhia nePuti","poem":1},{"text":"vakashanda savarwi muhondo yako.","poem":2},{"text":"Vakarembedza nhoo dzavo nenguwani pamasvingo ako,","poem":1},{"text":"vachikuvigira mbiri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Varume vokuArivhadhi nevokuHereki","poem":1},{"text":"vakakomba masvingo ako kumativi ose;","poem":2},{"text":"varume vokuGamadhi","poem":1},{"text":"vakanga vari mushongwe dzako.","poem":2},{"text":"Vakaturika nhoo dzavo pamasvingo ako;","poem":1},{"text":"vakaita kuti runako rwako rukwane.","poem":2}]},{"type":"verse","number":12,"content":["“ ‘Tashishi yakatengeserana newe nokuda kwepfuma yako huru yenhumbi; vakatsinhanisa sirivha, nesimbi, netini nedare zvokushambadzira zvako."]},{"type":"verse","number":13,"content":["“ ‘Girisi, Tubhari neMesheki dzakatengeserana newe; vakatsinhanisa nhapwa nezvinhu zvendarira zvezvigadzirwa zvako."]},{"type":"verse","number":14,"content":["“ ‘Varume veBheti Togarima vakatsinhanisa mabhiza ebasa namabhiza ehondo namanyurusi kuti uzvishambadzire."]},{"type":"verse","number":15,"content":["“ ‘Varume vokuRodhe vakatengeserana newe, uye zviwi zvizhinji zvakanga zviri nzvimbo dzako dzokutengesera; vaikuripira nenyanga dzenzou nomuti womuvanga."]},{"type":"verse","number":16,"content":["“ ‘Aramu yakatengeserana newe nokuda kwezvibereko zvako zvizhinji; vakatsinhanisa matombo eturikoise nemicheka yepepuru, nezvakarukwa, nemicheka yakaisvonaka, nekorari namatombo amarubhi zvokutengesa zvako."]},{"type":"verse","number":17,"content":["“ ‘Judha neIsraeri vakatengeserana newe, vakatsinhanisa gorosi neMiniti nezvinotapira, uchi, mafuta nebharimi nezvigadzirwa zvako."]},{"type":"verse","number":18,"content":["“ ‘Dhamasiko, rakatengeserana newe nokuda kwezvigadzirwa zvako zvizhinji nepfuma yenhumbi newaini yaibva kuHeribhoni newuru yaibva kuZahari."]},{"type":"verse","number":19,"content":["“ ‘VaDhani navaGiriki vaibva kuUzari vakatenga zvawaishambadzira; vakatsinhanisa simbi yakabikwa, nekasia, nekaramo zvigadzirwa zvako."]},{"type":"verse","number":20,"content":["“ ‘Dhedhani akatengeserana newe machira okugarira pamabhiza."]},{"type":"verse","number":21,"content":["“ ‘Arabhia namachinda ose eKedhari vakanga vachikutengera; vakatengeserana newe namakwayana, makondobwe nembudzi."]},{"type":"verse","number":22,"content":["“ ‘Vashambadziri vokuShebha neRama vakatengeserana newe; pane zvawaishambadzira iwe ivo vakatsinhanisa namarudzi ezvinonhuhwira ose uye namabwe anokosha, negoridhe."]},{"type":"verse","number":23,"content":["“ ‘Harani, Kane neEdheni navashambadziri vokuShebha, Ashuri neKirimadhi vakatengeserana newe."]},{"type":"verse","number":24,"content":["Vakatengeserana newe munzvimbo dzokutengesera nguo dzakaisvonaka, dzemicheka yebhuruu, nezvakarukwa, namachira amavara namabote akakoswa uye ane mafundo akasimba."]},{"type":"verse","number":25,"content":[{"text":"“ ‘Zvikepe zveTashishi zvakashanda","poem":1},{"text":"pakutakura zvigadzirwa zvako.","poem":2},{"text":"Iwe wakazadzwa nezvitakurwa zvinorema,","poem":1},{"text":"imo mumwoyo megungwa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Vakwasvi vako vanokutora","poem":1},{"text":"voenda newe kumakungwa makuru.","poem":2},{"text":"Asi mhepo yokumabvazuva ichakuputsa-putsa mumwoyo megungwa chaimo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Pfuma yako, nenhumbi dzokutengesa nezvakagadzirwa,","poem":1},{"text":"varayiri navafambisi vako vezvikepe navagadziri vazvo,","poem":2},{"text":"vashambadziri vako nevarwi vako vose,","poem":1},{"text":"uye vose varimo","poem":2},{"text":"vachanyura mukati momwoyo wegungwa,","poem":1},{"text":"pazuva rokuparadzwa kwechikepe chako.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nyika dzokumahombekombe dzichadengenyeka","poem":1},{"text":"panodanidzira vafambisi vako vezvikepe.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Vose vanobata matanda okukwasva","poem":1},{"text":"vachasiya zvikepe zvavo;","poem":2},{"text":"vachairi nevafambisi vako vezvikepe","poem":1},{"text":"vachamira kumahombekombe.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Vachadanidzira namanzwi avo","poem":1},{"text":"vagochema zvikuru pamusoro pako;","poem":2},{"text":"vachakusha guruva pamisoro yavo","poem":1},{"text":"vagoumburuka mumadota.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Vachaveura misoro yavo nokuda kwako,","poem":1},{"text":"uye vachapfeka nguo dzamasaga.","poem":2},{"text":"Vachachema pamusoro pako nokurwadza kwomwoyo,","poem":1},{"text":"uye nokuchema kukuru.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Pavanoungudza nokuchema pamusoro pako,","poem":1},{"text":"vachachema pamusoro pako vachiti,","poem":2},{"text":"“Ndianiko akashaya rokureva seTire,","poem":1},{"text":"rakakomberedzwa negungwa?”","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Pakabuda vashambadziri vako vachienda kugungwa,","poem":1},{"text":"wakagutisa ndudzi zhinji,","poem":2},{"text":"nepfuma yako huru uye nenhumbi dzako,","poem":1},{"text":"wakapfumisa madzimambo enyika.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Zvino wakaputsanyiwa negungwa","poem":1},{"text":"mumvura zhinji yakadzika;","poem":2},{"text":"nhumbi dzako navanhu vako vose","poem":1},{"text":"zvakanyura pamwe chete newe.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Vose vanogara mumahombekombe vanoshamiswa newe;","poem":1},{"text":"madzimambo avo anodedera nokutya,","poem":2},{"lineBreak":true},{"text":"uye zviso zvavo zvakanganiswa nokutyiswa.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Vashambadziri vari pakati pendudzi vanokuridzira muridzo;","poem":1},{"text":"wasvika kumagumo anonyangadza","poem":2},{"lineBreak":true},{"text":"uye hauchazovapozve.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/EZK/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/EZK/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/EZK/26.json","previousChapterAudioLinks":{},"numberOfVerses":36}