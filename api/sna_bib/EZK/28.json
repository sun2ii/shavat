o zvepfuma yako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wakawanza pfuma yako","poem":1},{"text":"nouchenjeri hwako hwokutengesa,","poem":2},{"text":"uye nokuda kwepfuma yako","poem":1},{"text":"mwoyo wako wakazvikudza.","poem":2}]},{"type":"verse","number":6,"content":["“ ‘Naizvozvo zvanzi naIshe Jehovha:",{"text":"“ ‘Nokuti unofunga kuti wakangwara,","poem":1},{"text":"sokungwara kwamwari,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ndava kuzouyisa vatorwa kuti vazokurwisa,","poem":1},{"text":"rudzi rwakaipisisa pakati pendudzi dzose,","poem":2},{"text":"vachavhomora minondo yavo kuti varwise kunaka nokuchenjera kwako,","poem":1},{"text":"vagosvibisa kupenya kwokubwinya kwako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vachakuburutsira kugomba,","poem":1},{"text":"uye uchafa rufu runorwadza","poem":2},{"lineBreak":true},{"text":"pakati pomwoyo wamakungwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ipapo uchati here, “Ndiri mwari,”","poem":1},{"text":"pamberi pavanokuuraya?","poem":2},{"text":"Uchava munhu chete, kwete mwari,","poem":1},{"text":"mumaoko aivo vanokuuraya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uchafa rufu rwomunhu asina kudzingiswa","poem":1},{"text":"pamaoko avatorwa.","poem":2},"Ndazvitaura, ndizvo zvinotaura Ishe Jehovha.’ ”"]},{"type":"verse","number":11,"content":["Shoko raJehovha rakasvika kwandiri richiti:"]},{"type":"verse","number":12,"content":["“Mwanakomana womunhu, chemera mambo weTire ugoti kwaari, ‘Zvanzi naIshe Jehovha:",{"text":"“ ‘Wakanga uri muenzaniso wokukwana,","poem":1},{"text":"uzere nouchenjeri wakakwana parunako.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wakanga uri muEdheni,","poem":1},{"text":"bindu raMwari;","poem":2},{"text":"wakashongedzwa namatombo ose anokosha anoti:","poem":1},{"text":"rubhi, tapazi neemeradhi,","poem":2},{"lineBreak":true},{"text":"krisorite, onikisi, jasipa,","poem":2},{"lineBreak":true},{"text":"safuri, turikoise nebheriri.","poem":2},{"text":"Urongwa nezvitsigiro zvako zvakanga zvakagadzirwa negoridhe;","poem":1},{"text":"zvakagadzirwa pazuva rokusikwa kwako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wakazodzwa sekerubhi rinorinda,","poem":1},{"text":"nokuti ndiko kugadza kwandakakuita.","poem":2},{"text":"Wakanga uri pamusoro pegomo dzvene raMwari;","poem":1},{"text":"wakanga uchifamba pakati pamabwe omoto.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wakanga usina chaungapomerwa panzira dzako,","poem":1},{"text":"kubva pazuva rawakasikwa","poem":2},{"lineBreak":true},{"text":"kusvikira kuipa pakwazowanikwa mauri.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nokuwanda kwokushambadzira kwako","poem":1},{"text":"wakabva wazara nechisimba,","poem":2},{"lineBreak":true},{"text":"ndokubva watadza.","poem":2},{"text":"Saka ndakakudzinga mukunyadziswa kubva pagomo raMwari,","poem":1},{"text":"uye ndakakudzinga, iwe kerubhi rokurinda,","poem":2},{"lineBreak":true},{"text":"kuti ubve pakati pamabwe omoto.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mwoyo wako wakazvikudza","poem":1},{"text":"nokuda kworunako rwako,","poem":2},{"text":"uye wakaodza uchenjeri hwako","poem":1},{"text":"nokuda kwokubwinya kwako.","poem":2},{"text":"Saka ndakakukanda panyika;","poem":1},{"text":"ndakakuita chinhu chinosekwa pamberi pamadzimambo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nokuda kwokuwanda kwezvivi zvako, uye nokubiridzira kwako mukushambadzira,","poem":1},{"text":"wakazvidza nzvimbo dzako tsvene.","poem":2},{"text":"Saka ndakaita kuti moto ubude kubva mauri,","poem":1},{"text":"ukakuparadza,","poem":2},{"text":"uye ndakakupisa kusvikira wava madota panyika,","poem":1},{"text":"pamberi pavose vaikuona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndudzi dzose dzaikuziva","poem":1},{"text":"dzinoshamiswa newe;","poem":2},{"text":"wasvika pamagumo akaipisisa","poem":1},{"text":"uye hauchazovapozve.’ ”","poem":2}]},{"type":"heading","content":["Chiprofita pamusoro peSidhoni"]},{"type":"verse","number":20,"content":["Shoko raJehovha rakasvika kwandiri richiti:"]},{"type":"verse","number":21,"content":["“Mwanakomana womunhu, rinzira chiso chako pamusoro peSidhoni; uprofite pamusoro paro,"]},{"type":"verse","number":22,"content":["uti, ‘Zvanzi naIshe Jehovha:",{"text":"“ ‘Ndine mhaka newe, iwe Sidhoni,","poem":1},{"text":"uye ndichazviwanira kukudzwa mukati mako.","poem":2},{"text":"Vachaziva kuti ndini Jehovha,","poem":1},{"text":"pandichariranga","poem":2},{"lineBreak":true},{"text":"ndigozviratidza mariri kuti ndiri mutsvene.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndichatuma denda pamusoro paro","poem":1},{"text":"ndigoita kuti ropa riyerere munzira dzaro.","poem":2},{"text":"Vakaurayiwa vachawa mariri,","poem":1},{"text":"nomunondo uchirirwisa kumativi ose.","poem":2},{"text":"Ipapo vachaziva kuti ndini Jehovha.","poem":1}]},{"type":"verse","number":24,"content":["“ ‘Vanhu veIsraeri havachazovizve navavakidzani vanovagodora vachivarwadzisa sorukato runopinza. Ipapo vachaziva kuti ndini Ishe Jehovha."]},{"type":"verse","number":25,"content":["“ ‘Zvanzi naIshe Jehovha: Pandinounganidza vanhu veIsraeri kubva kundudzi kwavakanga vakaparadzirwa, ndichazviratidza kuti ndiri mutsvene pakati pavo pamberi pendudzi. Ipapo vachagara munyika yavo pachavo, yandakapa muranda wangu Jakobho."]},{"type":"verse","number":26,"content":["Vachagaramo norugare uye vachavaka dzimba nokusima minda yemizambiringa; vachagara norugare pandicharanga vavakidzani vavo vose vanovagodora. Ipapo vachaziva kuti ndini Jehovha Mwari wavo.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}