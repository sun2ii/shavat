{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"EZK","translationId":"sna_bib","name":"Ezekieri","commonName":"Ezekieri","title":"EZEKIERI","order":26,"numberOfChapters":48,"sha256":"5479e86b799fa929aed687a185ce4d5cbae45313a4b8a4ad387dec4723f1eedb","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/sna_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["Kuchema pamusoro peIjipiti"]},{"type":"verse","number":1,"content":["Shoko raJehovha rakasvika kwandiri richiti,"]},{"type":"verse","number":2,"content":["“Mwanakomana womunhu, profita uti, ‘Zvanzi naIshe Jehovha:",{"text":"“ ‘Ungudza uti,","poem":1},{"text":"“Haiwa, zuva iro!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti zuva rava pedyo,","poem":1},{"text":"zuva raJehovha rava pedyo,","poem":2},{"text":"zuva ramakore,","poem":1},{"text":"nguva yokuparadzwa kwendudzi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Munondo uchauya pamusoro peIjipiti,","poem":1},{"text":"uye kurwadziwa kuchauya pamusoro paEtiopia.","poem":2},{"text":"Vakaurayiwa pavachawa muIjipiti,","poem":1},{"text":"pfuma yake ichatakurwa ichienda kure","poem":2},{"lineBreak":true},{"text":"uye nheyo dzayo dzichakoromorwa.","poem":2}]},{"type":"verse","number":5,"content":["Etiopia nePuti, Ridhia neArabhia yose, Ribhiya navanhu venyika yesungano vachaurayiwa nomunondo pamwe chete neIjipiti."]},{"type":"verse","number":6,"content":["“ ‘Zvanzi naJehovha:",{"text":"“ ‘Vanotsigira Ijipiti vachawa","poem":1},{"text":"uye simba rainozvikudza naro richapera.","poem":2},{"text":"Kubva kuMigidhori kusvikira kuAswani,","poem":1},{"text":"vachaurayiwa nomunondo mukati pake,","poem":2},{"text":"ndizvo zvinotaura Ishe Jehovha.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Vachaparadzwa","poem":1},{"text":"pakati penyika dzakaparadzwa,","poem":2},{"text":"uye maguta avo achava","poem":1},{"text":"pakati pamaguta akaitwa matongo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ipapo vachaziva kuti ndini Jehovha,","poem":1},{"text":"pandichatungidza moto kuIjipiti","poem":2},{"lineBreak":true},{"text":"uye vabatsiri vayo vose vachaparadzwa.","poem":2}]},{"type":"verse","number":9,"content":["“ ‘Pazuva iro, nhume dzichabva kwandiri dziri muzvikepe kuti dzindotyisidzira Etiopia kuti abve pakuvarairwa kwake. Ucharwadziwa pazuva rokuparadzwa kweIjipiti, nokuti zvirokwazvo rinouya."]},{"type":"verse","number":10,"content":["“ ‘Zvanzi naIshe Jehovha:",{"text":"“ ‘Ndichagumisa vanhu vose veIjipiti","poem":1},{"text":"noruoko rwaNebhukadhinezari mambo weBhabhironi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iye nehondo yake, rudzi rwakaipisisa pakati pendudzi,","poem":1},{"text":"achauyiswa kuti azoparadza nyika.","poem":2},{"text":"Vachavhomora minondo yavo kuti varwise Ijipiti,","poem":1},{"text":"uye vachazadza nyika navakaurayiwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndichaomesa hova dzeNairi,","poem":1},{"text":"uye ndichatengesa nyika kuvanhu vakaipa;","poem":2},{"text":"namaoko avatorwa","poem":1},{"text":"ndichaparadza nyika nezvose zviri mairi.","poem":2},"Ini Jehovha ndazvitaura."]},{"type":"verse","number":13,"content":["“ ‘Zvanzi naIshe Jehovha:",{"text":"“ ‘Ndichaparadza zvifananidzo","poem":1},{"text":"uye ndichagumisa mifananidzo yeMemufisi.","poem":2},{"text":"MuIjipiti hamuchazovizve nomuchinda,","poem":1},{"text":"uye ndichaparadzira kutya munyika yose.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndichaita kuti Patirosi ive dongo,","poem":1},{"text":"ndichapisa Zoani,","poem":2},{"lineBreak":true},{"text":"uye ndicharanga Tebhesi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndichadururira hasha dzangu pamusoro pePerusiami,","poem":1},{"text":"iyo nhare yeIjipiti,","poem":2},{"lineBreak":true},{"text":"uye ndichaparadza vanhu vose veTebhesi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndichapisa Ijipiti;","poem":1},{"text":"Perusiami ichazvonyongoka nokurwadziwa.","poem":2},{"text":"Tebhesi richakukurwa nedutu;","poem":1},{"text":"Memufisi ichagara iri munhamo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Majaya okuHerioporisi neokuBhubhastisi","poem":1},{"text":"achaurayiwa nomunondo,","poem":2},{"lineBreak":true},{"text":"uye maguta achatapwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zuva iroro richava rerima paTapanhesi,","poem":1},{"text":"pandichavhuna joko reIjipiti;","poem":2},{"lineBreak":true},{"text":"kuzvikudza kwesimba raro kuchapera ipapo.","poem":2},{"text":"Richafukidzwa namakore,","poem":1},{"text":"uye misha yaro ichatapwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Saka ndicharanga Ijipiti,","poem":1},{"text":"uye vachaziva kuti ndini Jehovha.’ ”","poem":2}]},{"type":"verse","number":20,"content":["Mugore regumi nerimwe, mumwedzi wokutanga pazuva rechinomwe shoko raJehovha rakasvika kwandiri richiti,"]},{"type":"verse","number":21,"content":["“Mwanakomana womunhu, ndavhuna ruoko rwaFaro mambo weIjipiti. Haruna kusungwa kuti rupore kana kuiswa chiseketo kuti ruve nesimba rokubata munondo."]},{"type":"verse","number":22,"content":["Naizvozvo zvanzi naIshe Jehovha: Ndine mhaka naFaro mambo weIjipiti. Ndichavhuna maoko ake ose ari maviri, ruoko rwakanaka norwakavhunika, ndigoita kuti munondo uwe kubva muruoko rwake."]},{"type":"verse","number":23,"content":["Ndichaparadzira vaIjipita pakati pendudzi ndigovadzingira munyika dzose."]},{"type":"verse","number":24,"content":["Ndichasimbisa ruoko rwamambo weBhabhironi uye ndichaisa munondo wangu muruoko rwake, asi ndichavhuna maoko aFaro, uye achagomera pamberi pake somunhu akuvadzwa zvokuti achafa."]},{"type":"verse","number":25,"content":["Ndichasimbisa maoko amambo weBhabhironi, asi maoko aFaro acharembera pasi. Ipapo vachaziva kuti ndini Jehovha, pandichaisa munondo muruoko rwamambo weBhabhironi agouvheyesa kuti arwise Ijipiti."]},{"type":"verse","number":26,"content":["Ndichaparadzira vaIjipiti pakati pendudzi ndigovadzingira munyika dzose. Ipapo vachaziva kuti ndini Jehovha.”"]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}