{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"GEN","translationId":"sna_bib","name":"Genesisi","commonName":"Genesisi","title":"GENESISI","order":1,"numberOfChapters":50,"sha256":"681d6b643de0409669846dc5f5c8c7e099885c86ef7258b0810100b37020b9fd","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/sna_bib/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Jakobho anoropafadza vanakomana vake"]},{"type":"verse","number":1,"content":["Ipapo Jakobho akadana vanakomana vake akati, “Unganai kuti ndikuudzei zvichaitika kwamuri pamazuva anouya."]},{"type":"verse","number":2,"content":[{"text":"“Unganai muteerere, imi vanakomana vaJakobho;","poem":1},{"text":"teererai kuna baba venyu Israeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Rubheni, iwe uri dangwe rangu,","poem":1},{"text":"simba rangu, chiratidzo chokutanga chesimba rangu,","poem":2},{"lineBreak":true},{"text":"unokunda mukukudzwa, unokunda musimba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unozunguzika semvura zhinji, hauchazokundizve,","poem":1},{"text":"nokuti wakakwira panhoo yababa vako,","poem":2},{"lineBreak":true},{"text":"panhoo yangu uye ukaisvibisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Simeoni naRevhi mukoma nomununʼuna,","poem":1},{"text":"minondo yavo zvombo zvokurwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngandirege kupinda parangano yavo,","poem":1},{"text":"ngandirege kuva paungano yavo,","poem":2},{"text":"nokuti vakauraya vanhu mukutsamwa kwavo","poem":1},{"text":"uye vakagura marunda enzombe sezvavaida.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kutsamwa kwavo ngakutukwe, kunotyisa zvakadai,","poem":1},{"text":"uye hasha dzavo, dzaiva noutsinye kudai!","poem":2},{"text":"Ndichavaparadzira muna Jakobho","poem":1},{"text":"uye ndigovatsaura muna Israeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Judha, hama dzako dzichakurumbidza;","poem":1},{"text":"ruoko rwako ruchava pamitsipa yavavengi vako;","poem":2},{"lineBreak":true},{"text":"vanakomana vababa vako vachakotama kwauri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uri mwana weshumba, iwe Judha;","poem":1},{"text":"unodzoka kubva kune zvaunouraya, mwana wangu.","poem":2},{"text":"Seshumba anonyangira uye anovata pasi,","poem":1},{"text":"seshumbakadzi, ndiani anotsunga kumumutsa?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tsvimbo youshe haingabvi kuna Judha,","poem":1},{"text":"uye mudonzvo womutongi pakati pamakumbo ake,","poem":2},{"text":"kusvikira asvika kumuridzi wawo,","poem":1},{"text":"uye kuteerera kwendudzi ndokwake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Achasungirira mbongoro yake pamuzambiringa,","poem":1},{"text":"nomwana wayo padavi rakaisvonaka;","poem":2},{"text":"achasuka nguo dzake muwaini,","poem":1},{"text":"zvokufuka zvake muropa ramazambiringa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Meso ake achasviba kupfuura waini,","poem":1},{"text":"meno ake achachena kupfuura mukaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Zebhuruni achagara kumahombekombe egungwa","poem":1},{"text":"uye achava zororo rezvikepe;","poem":2},{"lineBreak":true},{"text":"muganhu wake uchasvika paSidhoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Isakari imbongoro ine simba,","poem":1},{"text":"ivete pasi pakati pamatanga amakwai.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Paanoona nzvimbo yake yokuzorora kuti yanaka sei","poem":1},{"text":"uye kuti nyika yake inofadza sei,","poem":2},{"text":"acharerekera pfudzi rake kumutoro","poem":1},{"text":"uye achava mubatiri wechibharo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Dhani acharuramisira vanhu vake","poem":1},{"text":"somumwe wamarudzi aIsraeri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dhani achava nyoka iri parutivi pomugwagwa,","poem":1},{"text":"semhakure iri munzira,","poem":2},{"text":"inoruma chitsitsinho chebhiza","poem":1},{"text":"kuitira kuti mutasvi waro awire pasi neshure.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Ndakamirira rusununguko rwenyu, imi Jehovha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Gadhi acharohwa neboka ravapambi,","poem":1},{"text":"asi achavarova pazvitsitsinho zvavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Zvokudya zvaAsheri zvichava zvakakora;","poem":1},{"text":"achauya nezvinonaka zvakafanira madzimambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Nafutari isheche yemhembwe yakasunungurwa,","poem":1},{"text":"inobereka tsvana dzakaisvonaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Josefa muzambiringa unobereka mazambiringa,","poem":1},{"text":"unobereka uri pedyo netsime,","poem":2},{"lineBreak":true},{"text":"matavi awo anokwira pamadziro.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Neshungu vapfuri vanomurwisa;","poem":1},{"text":"vanomupfura noruvengo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Asi uta hwake hwakaramba hwakasimba,","poem":1},{"text":"maoko ake akasimba, akagwinya,","poem":2},{"text":"nokuda kworuoko rwaIye Anesimba waJakobho,","poem":1},{"text":"nokuda kwoMufudzi, iye Dombo raIsraeri,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"nokuda kwaMwari wababa vako anokubatsira,","poem":1},{"text":"nokuda kwoWamasimba Ose anokuropafadza","poem":2},{"text":"namaropafadzo okumatenga kumusoro,","poem":1},{"text":"maropafadzo okwakadzika kuri pasi,","poem":2},{"lineBreak":true},{"text":"maropafadzo amazamu neechizvaro.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Maropafadzo ababa vako makuru","poem":1},{"text":"kupfuura maropafadzo amakomo ekare,","poem":2},{"lineBreak":true},{"text":"kupfuura zvakawanda zvezvikomo zvamakore ekare.","poem":2},{"text":"Zvose izvi ngazvigare pamusoro waJosefa,","poem":1},{"text":"pamusoro womuchinda ari pakati pehama dzake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Bhenjamini ibere rinoparadza;","poem":1},{"text":"mangwanani anodya nyama,","poem":2},{"lineBreak":true},{"text":"madekwana anogovera zvaapamba.”","poem":2}]},{"type":"verse","number":28,"content":["Ava vose ndiwo marudzi gumi namaviri aIsraeri, uye izvi ndizvo zvakataurwa nababa vavo kwavari pavakavaropafadza, vachipa mumwe nomumwe kuropafadzwa kwakamufanira."]},{"type":"heading","content":["Kufa kwaJakobho"]},{"type":"verse","number":29,"content":["Ipapo akavarayira akati, “Ini ndava kuzosanganiswa navanhu vokwangu. Mundivige namadzibaba angu mubako mumunda waEfuroni muHiti,"]},{"type":"verse","number":30,"content":["bako riri mumunda weMakapera, pedyo neMamure muKenani, rakatengwa kubva kuna Efuroni naAbhurahama senzvimbo yokuviga pamwe chete nomunda."]},{"type":"verse","number":31,"content":["Ndipo pakavigwa Abhurahama nomukadzi wake Sara, ndipozve pakavigwa Isaka nomukadzi wake Rabheka, uye Rea akavigwa ipapo."]},{"type":"verse","number":32,"content":["Munda nebako riri mauri zvakatengwa kubva kuvaHiti.”"]},{"type":"verse","number":33,"content":["Jakobho akati apedza kurayira vanakomana vake, akadzora tsoka dzake mumubhedha, akabudisa mweya wake akasanganiswa navanhu vokwake."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}