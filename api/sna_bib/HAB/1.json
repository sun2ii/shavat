{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HAB","translationId":"sna_bib","name":"Habhakuki","commonName":"Habhakuki","title":"HABHAKUKI","order":35,"numberOfChapters":3,"sha256":"ebfc078b6f788314769dbaca31da7d92a0f3664dbd340cfcd4de042d5c206ce8","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/sna_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Chirevo chakaratidzwa muprofita Habhakuki."]},{"type":"heading","content":["Kugununʼuna kwaHabhakuki"]},{"type":"verse","number":2,"content":[{"text":"Haiwa Jehovha, ndicharamba ndichidanidzira, ndichitsvaka rubatsiro kusvikira riniko,","poem":1},{"text":"asi musingandinzwi?","poem":2},{"text":"Kana kudana kwamuri ndichiti, “Ndorwiswa!”","poem":1},{"text":"asi hamundiponesi?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sei muchiita kuti ndione kusaruramisira?","poem":1},{"text":"Sei muchirega zvakaipa zvichingoitwa?","poem":2},{"text":"Kuparadza nokuita nechisimba zviri pamberi pangu;","poem":1},{"text":"pano kukakavara, uye kurwa kuri kuwanda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naizvozvo murayiro hauchisina simba,","poem":1},{"text":"uye kutonga kwakarurama hakuchaonekwi.","poem":2},{"text":"Vakaipa vanokomba vakarurama,","poem":1},{"text":"zvokuti kururamisira kunominamiswa.","poem":2}]},{"type":"heading","content":["Mhinduro yaJehovha"]},{"type":"verse","number":5,"content":[{"text":"“Tarisa ndudzi dzavanhu, ucherechedze,","poem":1},{"text":"ugoshamiswa zvirokwazvo.","poem":2},{"text":"Nokuti ndichaita chimwe chinhu pamazuva ako","poem":1},{"text":"chawanga usingazobvumi, kunyange dai waichiudzwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndiri kumutsa vaBhabhironi","poem":1},{"text":"ruya rudzi rune utsinye, rune hasha,","poem":2},{"text":"runopararira pasi pose","poem":1},{"text":"kuti rubvute nzvimbo dzokugara dzisiri dzavo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vanhu vanotyisa uye vanovhundukwa;","poem":1},{"text":"vasina murayiro unovatonga","poem":2},{"lineBreak":true},{"text":"uye vanongozvitsvakira kukudzwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mabhiza avo anomhanya kukunda ingwe,","poem":1},{"text":"anotyisa kukunda mhumhi mumadekwana.","poem":2},{"text":"Mauto avo amabhiza anomhanya asingadzoki;","poem":1},{"text":"vatasvi vamabhiza vanobva kure kure.","poem":2},{"text":"Vanobhururuka segora rinotsvaka kuparadza;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"vanouya vose kuzoita zvechisimba.","poem":2},{"text":"Mapoka avo ehondo anouya semhepo inovhuvhuta mugwenga","poem":1},{"text":"vachiunganidza nhapwa sejecha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vanozvidza madzimambo","poem":1},{"text":"uye vanomhura vatongi.","poem":2},{"text":"Vanoseka maguta ose akasimbiswa;","poem":1},{"text":"vanovaka zvikomo zvevhu voatapa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ipapo vanopfuura semhepo, vanopfuura vasingamiri,","poem":1},{"text":"varume vane mhosva, simba ravo ndiye mwari wavo.”","poem":2}]},{"type":"heading","content":["Habhakuki anogununʼunazve"]},{"type":"verse","number":12,"content":[{"text":"Haiwa Jehovha, ko hamugari nokusingaperi here?","poem":1},{"text":"Mwari wangu, mutsvene wangu, hatingatongofi.","poem":2},{"text":"Haiwa Jehovha, makavagadza kuti vatonge;","poem":1},{"text":"imi Dombo, makavagadza kuti varange.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Meso enyu akachena zvokuti haangatarisi zvakaipa;","poem":1},{"text":"hamungatenderi zvakaipa.","poem":2},{"text":"Sei zvino muchitendera vanyengeri?","poem":1},{"text":"Ko, munonyararirei kana vakaipa","poem":2},{"lineBreak":true},{"text":"vachimedza vanovapfuura mukururama?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sei makaita kuti vanhu vave sehove dzegungwa,","poem":1},{"text":"sezvisikwa zvegungwa zvisina mutongi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Muvengi anovaredza vose nezviredzo,","poem":1},{"text":"anovabata mumumbure wake,","poem":2},{"text":"achivakokorodza murutava rwake;","poem":1},{"text":"naizvozvo anopembera nomufaro.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Naizvozvo anopisira zvibayiro kumumbure wake,","poem":1},{"text":"uye anopisira zvinonhuhwira kumumbure wake,","poem":2},{"text":"nokuti anogarika nokuda kwomumbure wake,","poem":1},{"text":"anodya zvokudya zvakaisvonaka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ko, acharamba achingodurura zviri mumumbure wake,","poem":1},{"text":"achingoparadza ndudzi asina tsitsi here?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}