{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HAB","translationId":"sna_bib","name":"Habhakuki","commonName":"Habhakuki","title":"HABHAKUKI","order":35,"numberOfChapters":3,"sha256":"ebfc078b6f788314769dbaca31da7d92a0f3664dbd340cfcd4de042d5c206ce8","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/sna_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ndichandomira panzvimbo yangu yokurinda","poem":1},{"text":"ndichazviisa panzvimbo yakakwirira;","poem":2},{"text":"ndichatarisa ndione zvaachareva kwandiri","poem":1},{"text":"uye zvandingapindura pamusoro pokuchema uku.","poem":2}]},{"type":"heading","content":["Mhinduro yaJehovha"]},{"type":"verse","number":2,"content":["Ipapo Jehovha akapindura achiti:",{"text":"“Nyora chiratidzo ichi,","poem":1},{"text":"uite kuti chionekwe kwazvo pamahwendefa","poem":2},{"lineBreak":true},{"text":"kuti anoverenga agoverenga achimhanya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti chiratidzo ichi chakamirira nguva yakatarwa;","poem":1},{"text":"chinotaura nezvamagumo","poem":2},{"lineBreak":true},{"text":"uye hachingarevi nhema.","poem":2},{"text":"Kunyange dai chikanonoka, chimirire;","poem":1},{"text":"zvirokwazvo chichauya, hachizononoki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Tarira, ana manyawi;","poem":1},{"text":"zvido zvake hazvina kururama,","poem":2},{"lineBreak":true},{"text":"asi akarurama achararama nokutenda kwake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvirokwazvo, waini inomupandukira;","poem":1},{"text":"anozvikudza uye haazombozorori.","poem":2},{"text":"Nokuti anokara sezvinoita guva","poem":1},{"text":"uye sorufu haaguti,","poem":2},{"text":"anozviunganidzira ndudzi dzose","poem":1},{"text":"uye anotapa marudzi ose avanhu.","poem":2}]},{"type":"heading","content":["Matambudziko aVakaipa"]},{"type":"verse","number":6,"content":["“Ko, vakatapwa vose havangazomuseki here nezvirahwe zvokumushora vachiti,",{"text":"“ ‘Ane nhamo anozviunganidzira zvakabiwa","poem":1},{"text":"anozvipfumisa nepfuma yakapambwa!","poem":2},{"lineBreak":true},{"text":"Zvicharamba zvakadai kusvikira riniko?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ko, vamakakwereta havangazosimuki pakarepo here?","poem":1},{"text":"Havangazomuki vakakuvhundutsai here?","poem":2},{"lineBreak":true},{"text":"Ipapo ndimi muchava vakapambwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nokuti makapamba ndudzi zhinji,","poem":1},{"text":"vakasara vachakupambai,","poem":2},{"text":"nokuda kweropa ravanhu ramakateura;","poem":1},{"text":"makaparadza nyika namaguta pamwe chete navageremo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ane nhamo anovaka umambo hwake nepfuma yakabiwa,","poem":1},{"text":"achivaka dendere rake pakakwirira,","poem":2},{"lineBreak":true},{"text":"kuti anzvenge kuparadzwa!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Makarangana kuparadza ndudzi dzakawanda,","poem":1},{"text":"muchinyadzisa imba yenyu,","poem":2},{"lineBreak":true},{"text":"uye muchiparadza upenyu hwenyu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mabwe ari murusvingo achadanidzira,","poem":1},{"text":"ipapo matanda edenga remba achadairira namaungira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ane nhamo anovaka guta nokudeura ropa","poem":1},{"text":"uye anosimbisa guta nezvakaipa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tarirai, hazvina kubva kuna Jehovha Wamasimba Ose here","poem":1},{"text":"kuti vanhu vanoshandira zvinoparadzwa nomoto,","poem":2},{"lineBreak":true},{"text":"uye kuti marudzi avanhu anongozvinetesa nezvisina maturo?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nokuti nyika yose ichazadzwa nokuziva kubwinya kwaJehovha,","poem":1},{"text":"sezvakaita mvura kuzadza kwayakaita gungwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ane nhamo anopa vavakidzani vake zvinodhaka,","poem":1},{"text":"achizvidurura kubva mumatende ewaini kusvikira vadhakwa,","poem":2},{"lineBreak":true},{"text":"kuti aone kushama kwavo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Muchazadzwa nenyadzi pachinzvimbo chokukudzwa.","poem":1},{"text":"Nhasi ndimiwo! Chinwai kuti mudzedzereke!","poem":2},{"text":"Mukombe unobva kuruoko rwaJehovha rworudyi uri kuuya kwamuri,","poem":1},{"text":"kunyadziswa kuchafukidza kukudzwa kwenyu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nokuti kuita nechisimba kwamakaitira Rebhanoni kuchakukundai,","poem":1},{"text":"uye kuparadza kwamakaita mhuka kuchakutyisai.","poem":2},{"text":"Nokuti makateura ropa ravanhu;","poem":1},{"text":"makaparadza nyika namaguta navose vakanga vageremo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Chifananidzo chakavezwa chinobatsireiko, zvachakangogadzirwa nomuvezi?","poem":1},{"text":"Kana chifananidzo chakaumbwa, chinodzidzisa nhema?","poem":2},{"text":"Nokuti uyo anochiita anovimba nechaakazviumbira;","poem":1},{"text":"anoita zvifananidzo zvisingagoni kutaura.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ane nhamo anoti kudanda, ‘Rarama!’","poem":1},{"text":"Kana kubwe risingagoni kutaura, ‘Muka!’","poem":2},{"text":"Ko, zvingadzidzisa here?","poem":1},{"text":"Tarira, chakafukidzwa negoridhe nesirivha;","poem":2},{"lineBreak":true},{"text":"hachina mweya mukati macho napaduku.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Asi Jehovha ari mutemberi yake tsvene;","poem":1},{"text":"nyika yose ngairambe inyerere pamberi pake.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}