{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HAB","translationId":"sna_bib","name":"Habhakuki","commonName":"Habhakuki","title":"HABHAKUKI","order":35,"numberOfChapters":3,"sha256":"ebfc078b6f788314769dbaca31da7d92a0f3664dbd340cfcd4de042d5c206ce8","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/sna_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Munyengetero waHabhakuki"]},{"type":"verse","number":1,"content":["Munyengetero wamuprofita Habhakuki unoimbwa neshigionoti."]},{"type":"verse","number":2,"content":[{"text":"Jehovha, ndakanzwa zvomukurumbira wenyu;","poem":1},{"text":"haiwa Jehovha, ndinomira ndichitya mabasa enyu.","poem":2},{"text":"Avandudzei pamazuva edu,","poem":1},{"text":"panguva yedu ngaaziviswe;","poem":2},{"lineBreak":true},{"text":"pakutsamwa kwenyu rangarirai tsitsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mwari akabva kuTemani,","poem":1},{"text":"iye Mutsvene akabva kuGomo reParani. Sera","poem":2},{"text":"Umambo hwake hwakazadza matenga","poem":1},{"text":"uye mbiri yake yakazadza nyika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kubwinya kwake kwakaita sokubuda kwezuva;","poem":1},{"text":"bwerazuva hwakapenya huchibva muruoko rwake,","poem":2},{"lineBreak":true},{"text":"makanga makavigwa simba rake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hosha yakaenda ichibva pamberi pake;","poem":1},{"text":"denda rakatevera nhambwe dzake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akamira, akazungunusa nyika;","poem":1},{"text":"akatarisa, akabvundisa ndudzi dzavanhu.","poem":2},{"text":"Makomo akare kare akakoromoka","poem":1},{"text":"uye zvikomo zvakare zvakawira pasi.","poem":2},{"lineBreak":true},{"text":"Nzira dzake dzinogara nokusingaperi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndakaona matende eKushani ari panhamo,","poem":1},{"text":"nzvimbo dzokugara dzeMidhiani dziri pakutambudzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ko, makanga matsamwira nzizi here, nhai Jehovha?","poem":1},{"text":"Makanga matsamwira zvikova here, nhai Jehovha?","poem":2},{"text":"Makatsamwira gungwa here","poem":1},{"text":"pamakafambisa mabhiza enyu","poem":2},{"lineBreak":true},{"text":"nengoro dzenyu dzokukunda?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makabudisa pachena uta hwenyu,","poem":1},{"text":"mukadaidzira miseve mizhinji. Sera","poem":2},{"text":"Makatsemura nyika nenzizi;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"makomo akakuonai akadedera.","poem":2},{"text":"Mvura zhinji yakapfuura;","poem":1},{"text":"kwakadzika kwakatinhira","poem":2},{"lineBreak":true},{"text":"kukasimudza mafungu pamusoro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Zuva nomwedzi zvakambomira kumatenga","poem":1},{"text":"zvichiona kuvaima kwemiseve yenyu yaipfuura,","poem":2},{"lineBreak":true},{"text":"zvichiona kupenya kwepfumo renyu rinobwinya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mukutsamwa kwenyu makapfuura napanyika","poem":1},{"text":"uye mukushatirwa kwenyu makarasa ndudzi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Makauya kuzonunura vanhu venyu,","poem":1},{"text":"kuzoponesa muzodziwa wenyu.","poem":2},{"text":"Makaparadza mutungamiri wenyika yavakaipa,","poem":1},{"text":"mukamufukura kubva kumusoro kusvika kutsoka. Sera","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nepfumo rake chairo makabaya musoro wake,","poem":1},{"text":"pakauya varwi vake sechamupupuri kuzotiparadzira,","poem":2},{"text":"vachifara savanoda kuparadza","poem":1},{"text":"vanotambudzika vakanga vakavanda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Makatsika-tsika gungwa namabhiza enyu,","poem":1},{"text":"mukabvongodza mvura zhinji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ndakazvinzwa, hana yangu ikarova,","poem":1},{"text":"miromo yangu yakadedera pandakanzwa maungira;","poem":2},{"text":"kuora kwakapinda mumapfupa angu,","poem":1},{"text":"makumbo angu akadedera.","poem":2},{"text":"Asi ndichamirira hangu zuva renjodzi","poem":1},{"text":"kuti riuye pamusoro porudzi ruchatirwisa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kunyange dai muonde ukasatunga maruva,","poem":1},{"text":"uye mizambiringa ikashayiwa zvibereko,","poem":2},{"text":"kunyange kubereka kwomuorivhi kukakona,","poem":1},{"text":"uye minda ikasabereka zvokudya,","poem":2},{"text":"kunyange dai kukasava namakwai muchirugu","poem":1},{"text":"uye mombe dzikashayikwa mumatanga,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kunyange zvakadaro, ndichafara muna Jehovha,","poem":1},{"text":"ndichava nomufaro muna Mwari Muponesi wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ishe Jehovha ndiye simba rangu;","poem":1},{"text":"anoita kuti tsoka dzangu dziite setsoka dzenondo,","poem":2},{"lineBreak":true},{"text":"anondifambisa pamatunhu akakwirira.","poem":2},{"lineBreak":true},{"text":"Kumutungamiri wokuimba, nemitengeranwa yangu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}