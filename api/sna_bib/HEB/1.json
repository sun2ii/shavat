{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HEB","translationId":"sna_bib","name":"VaHebheru","commonName":"VaHebheru","title":"VAHEBHERU","order":58,"numberOfChapters":13,"sha256":"adb8627cabe705ec10e97f34e00047ae6cedaf77c7274db50cd9c6b91342ee9b","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/sna_bib/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Kristu mukuru kuVatumwa"]},{"type":"verse","number":1,"content":["Kare, Mwari akataura kumadzitateguru edu kubudikidza navaprofita panguva zhinji, uye nenzira dzakasiyana-siyana,"]},{"type":"verse","number":2,"content":["asi mumazuva ano okupedzisira akataura kwatiri nomuMwanakomana wake, waakaita mudyi wenhaka yezvinhu zvose, uye naiyewo waakaita naye nyika."]},{"type":"verse","number":3,"content":["Mwanakomana ndiye chadzera chokubwinya kwaMwari uye ndiye mufananidzo wake chaiwo, anochengeta zvinhu zvose neshoko rake rine simba. Mushure mokunge apedza kunatswa kwezvivi, akagara kurudyi rwamambo kudenga."]},{"type":"verse","number":4,"content":["Saka akava mukuru kupfuura vatumwa sezvo zita raakapiwa nhaka yaro rakanyanya kunaka kupfuura ravo."]},{"type":"verse","number":5,"content":["Nokuti ndoupi pakati pavatumwa, Mwari waakamboti kwaari:",{"text":"“Ndiwe Mwanakomana wangu;","poem":1},{"text":"nhasi ndava baba vako?”","poem":2},"kana kutizve,",{"text":"“Ndichava Baba vake,","poem":1},{"text":"naiye achava Mwanakomana wangu?”","poem":2}]},{"type":"verse","number":6,"content":["Uyezve, Mwari paanouyisa dangwe rake munyika, anoti:",{"text":"“Vatumwa vose vaMwari ngavamunamate.”","poem":1}]},{"type":"verse","number":7,"content":["Achitaura pamusoro pavatumwa anoti,",{"text":"“Anoita vatumwa vake mhepo,","poem":1},{"text":"varanda vake mirazvo yomoto.”","poem":2}]},{"type":"verse","number":8,"content":["Asi pamusoro poMwanakomana anoti,",{"text":"“Chigaro chenyu choushe, imi Mwari, chichagara nokusingaperi-peri,","poem":1},{"text":"uye kururama kuchava tsvimbo youshe hwenyu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makada kururama uye mukavenga kusarurama;","poem":1},{"text":"naizvozvo Mwari, Mwari wenyu, akakuisai pamusoro peshamwari dzenyu","poem":2},{"lineBreak":true},{"text":"nokukuzodzai namafuta okufara.”","poem":2}]},{"type":"verse","number":10,"content":["Anotizve,",{"text":"“Pakutanga, imi Ishe, makateya nheyo dzenyika,","poem":1},{"text":"uye matenga ndiwo basa ramaoko enyu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zvichaparara, asi imi mucharamba muripo;","poem":1},{"text":"zvichasakara zvose senguo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Muchazvipeta sejasi;","poem":1},{"text":"senguo zvichashandurwa.","poem":2},{"text":"Asi imi munoramba makadaro,","poem":1},{"text":"uye makore enyu haatozogumi.”","poem":2}]},{"type":"verse","number":13,"content":["Ndoupi pakati pavatumwa akambonzi naMwari:",{"text":"“Gara kurudyi rwangu","poem":2},{"text":"kusvikira ndaita vavengi vako","poem":1},{"text":"chitsiko chetsoka dzako?”","poem":2}]},{"type":"verse","number":14,"content":["Ko, vatumwa vose havasi mweya inoshumira yakatumwa kuzobatsira vaya vachadya nhaka yoruponeso here?"]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}