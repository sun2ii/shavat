{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HOS","translationId":"sna_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"b71f76378be8f8d3e8438c0920cad7a8dba9bf1ac58b66f7f09d5497025c0b85","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Israeri akanga ari muzambiringa unotanda;","poem":1},{"text":"akazviberekera zvibereko.","poem":2},{"text":"Zvibereko zvake pazvakawanda,","poem":1},{"text":"akavakawo aritari dzakawanda;","poem":2},{"text":"nyika yake payakabudirira,","poem":1},{"text":"akashongedzawo matombo ake anoera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwoyo wavo unonyengera,","poem":1},{"text":"uye zvino vanofanira kutakura mhosva yavo.","poem":2},{"text":"Jehovha achaputsa aritari dzavo","poem":1},{"text":"uye achaparadza matombo avo akaereswa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ipapo vachati, “Hatina mambo","poem":1},{"text":"nokuti hatina kukudza Jehovha.","poem":2},{"text":"Asi kunyange taiva namambo,","poem":1},{"text":"angadai akatiitireiko?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vanovimbisa zvakawanda,","poem":1},{"text":"vanoita mhiko dzenhema","poem":2},{"lineBreak":true},{"text":"uye vanoita zvibvumirano;","poem":2},{"text":"naizvozvo mhosva dzinoendeswa kudare","poem":1},{"text":"dzinomera sebise rinouraya mumunda wakarimwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vanhu vanogara muSamaria vanotyira","poem":1},{"text":"chifananidzo chemhuru chaBheti Avheni.","poem":2},{"text":"Vanhu vacho vachachichema,","poem":1},{"text":"ndizvo zvichaitawo vaprista vanonamata chifananidzo chacho;","poem":2},{"text":"ivavo vakafarira kukudzwa kwacho,","poem":1},{"text":"nokuti vachachitorerwa chigoendeswa kuutapwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Chichatakurwa chigoendeswa kuAsiria","poem":1},{"text":"somutero kuna mambo mukuru.","poem":2},{"text":"Efuremu achanyadziswa;","poem":1},{"text":"Israeri achanyarawo nokuda kwezvifananidzo zvakavezwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Samaria namambo wayo ichaeredzwa","poem":1},{"text":"sechimuti pamusoro pemvura.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nzvimbo dzakakwirira dzouipi dzichaparadzwa,","poem":1},{"text":"ichi ndicho chivi chaIsraeri.","poem":2},{"text":"Minzwa norukato zvichamera","poem":1},{"text":"zvigofukidza aritari dzavo.","poem":2},{"text":"Ipapo vachati kumakomo, “Tifukidzei!”","poem":1},{"text":"nokuzvikomo, “Wirai pamusoro pedu!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kubva pamazuva eGibhea, wakatadza, iwe Israeri,","poem":1},{"text":"uye ukarambirapo.","poem":2},{"text":"Hondo haina kukunda","poem":1},{"text":"vaiti vezvakaipa paGibhea here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nenguva yandinoda ndichavaranga;","poem":1},{"text":"ndudzi dzichaungana kuti dzivarwise","poem":2},{"lineBreak":true},{"text":"dzivaise muusungwa nokuda kwezvivi zvavo zviviri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efuremu itsiru rakapingudzwa","poem":1},{"text":"rinofarira kupura;","poem":2},{"text":"saka ndichaisa joko","poem":1},{"text":"pamutsipa waro wakanaka.","poem":2},{"text":"Ndichatinha Efuremu,","poem":1},{"text":"Judha anofanira kurima,","poem":2},{"lineBreak":true},{"text":"uye Jakobho anofanira kuputsa mavhinga acho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Zvidyarirei kururama,","poem":1},{"text":"kohwai chibereko chorudo rusingaperi,","poem":2},{"text":"mugorima gombo renyu;","poem":1},{"text":"nokuti inguva yokutsvaka Jehovha,","poem":2},{"text":"kusvikira auya","poem":1},{"text":"kuzonayisa utsvene pamusoro penyu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Asi makarima uipi,","poem":1},{"text":"mukacheka zvakaipa,","poem":2},{"lineBreak":true},{"text":"makadya zvibereko zvounyengeri,","poem":2},{"text":"nokuti makavimba nesimba renyu","poem":1},{"text":"uye navarwi venyu vakawanda,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kuomba kwehondo kuchamukira vanhu venyu,","poem":1},{"text":"zvokuti masvingo enyu ose achaparadzwa,","poem":2},{"text":"sokuparadzwa kwakaitwa Bheti Aribheri neSharimani pazuva rokurwa,","poem":1},{"text":"vanamai pavakapanhirwa pasi pamwe chete navana vavo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndizvo zvichaitika kwauri, iwe Bheteri,","poem":1},{"text":"nokuti uipi hwako hukuru.","poem":2},{"text":"Kana zuva iroro roswedera,","poem":1},{"text":"mambo weIsraeri achaparadzwa zvachose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}