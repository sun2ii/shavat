{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HOS","translationId":"sna_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"b71f76378be8f8d3e8438c0920cad7a8dba9bf1ac58b66f7f09d5497025c0b85","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Rudo rwaMwari kuna Israeri"]},{"type":"verse","number":1,"content":[{"text":"“Israeri paakanga achiri muduku, ndaimuda,","poem":1},{"text":"uye ndakadana mwanakomana wangu kubva kuIjipiti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Asi pandakanyanya kuvadana,","poem":1},{"text":"vakatonyanya kunditiza.","poem":2},{"text":"Vakabayira kuna vanaBhaari","poem":1},{"text":"uye vakapisira zvinonhuhwira kuzvifananidzo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndini ndakadzidzisa Efuremu kufamba,","poem":1},{"text":"ndichivasesedza namaoko avo;","poem":2},{"text":"asi havana kuzvicherechedza","poem":1},{"text":"kuti ndini ndakavarapa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndakavatungamirira nerwodzi rwounyoro hwomunhu,","poem":1},{"text":"nezvisungo zvorudo;","poem":2},{"text":"ndakasimudza joko kubva pamutsipa wavo","poem":1},{"text":"ndikakotama kuti ndivape zvokudya:","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Havangadzokerizve kuIjipiti","poem":1},{"text":"uye vaAsiria havangavatongi here","poem":2},{"lineBreak":true},{"text":"nokuti vakaramba kutendeuka?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Minondo ichapenya mumaguta avo,","poem":1},{"text":"ichaparadza mazariro pamasuo avo","poem":2},{"lineBreak":true},{"text":"uye ichagumisa zvirongwa zvavo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vanhu vangu vazvipira kutsauka vachibva kwandiri.","poem":1},{"text":"Kunyange dai vakadana kuna Iye Wokumusoro-soro,","poem":2},{"lineBreak":true},{"text":"haangatongovasimudziri kunyange nenzira ipi zvayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ndinokuregedza seiko, Efuremu?","poem":1},{"text":"Ndingakuendesa seiko, Israeri?","poem":2},{"text":"Ndingakuitireiko saAdhima?","poem":1},{"text":"Ndingakuenzanisa sei naZebhoimi?","poem":2},{"text":"Mwoyo wangu washanduka mukati mangu;","poem":1},{"text":"tsitsi dzangu dzose dzamutswa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Handingazadzisi kutsamwa kwangu kukuru","poem":1},{"text":"kana kutendeuka kuti ndiparadze Efuremu.","poem":2},{"text":"Nokuti ndiri Mwari, kwete munhu,","poem":1},{"text":"Mutsvene pakati penyu.","poem":2},{"lineBreak":true},{"text":"Handingauyi ndakatsamwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vachatevera Jehovha;","poem":1},{"text":"achaomba seshumba.","poem":2},{"text":"Paachaomba,","poem":1},{"text":"vana vake vachauya vachidedera vachibva kumadokero.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vachauya vachidedera","poem":1},{"text":"seshiri vachibva kuIjipiti,","poem":2},{"lineBreak":true},{"text":"senjiva vachibva kuAsiria.","poem":2},{"text":"Ndichavagarisa mudzimba dzavo,”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":2}]},{"type":"heading","content":["Chivi chaIsraeri"]},{"type":"verse","number":12,"content":[{"text":"Efuremu andikomberedza nenhema,","poem":1},{"text":"imba yaIsraeri nounyengeri.","poem":2},{"text":"Uye Judha akasindimara pamberi paMwari,","poem":1},{"text":"kunyange pamberi paIye Mutsvene Akatendeka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}