,"poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jehovha Mwari Wamasimba Ose,","poem":1},{"text":"Jehovha ndiro zita rake raane mukurumbira naro!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asi unofanira kudzokera kuna Mwari wako;","poem":1},{"text":"chengetedza rudo nokururamisira,","poem":2},{"lineBreak":true},{"text":"uye umirire Mwari wako nguva dzose.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mutengesi anoshandisa chiero chinonyengera;","poem":1},{"text":"anofarira kubiridzira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efuremu anozvikudza achiti,","poem":1},{"text":"“Ndakapfuma kwazvo; ndazova mupfumi chaiye.","poem":2},{"text":"Noupfumi hwangu hwose havangawani mandiri","poem":1},{"text":"chakaipa chipi zvacho kana chivi mukati mangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ndini Jehovha Mwari wako,","poem":1},{"text":"akakubudisa kubva muIjipiti;","poem":2},{"text":"ndichakugarisazve mumatende,","poem":1},{"text":"sapamazuva emitambo yakatarwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndakataura kuvaprofita,","poem":1},{"text":"ndikavapa zviratidzo zvizhinji","poem":2},{"lineBreak":true},{"text":"uye ndikataura mifananidzo kubudikidza navo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ko, Gireadhi yakaipa here?","poem":1},{"text":"Vanhu vayo havana maturo!","poem":2},{"text":"Vanobayira nzombe here paGirigari?","poem":1},{"text":"Aritari dzavo dzichava semirwi yamatombo","poem":2},{"lineBreak":true},{"text":"mumunda wakarimwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jakobho akatizira kunyika yeAramu;","poem":1},{"text":"Israeri akashandira kuti awane mukadzi,","poem":2},{"lineBreak":true},{"text":"uye kuti amuwane akafudza makwai.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jehovha akashandisa muprofita","poem":1},{"text":"kuti abudise Israeri kubva muIjipiti,","poem":2},{"lineBreak":true},{"text":"nomuprofita akavachengeta.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Asi Efuremu akamutsamwisa zvikuru kusvikira ashatirwa;","poem":1},{"text":"Ishe wake achaisa paari mhosva dzake dzokudeura ropa","poem":2},{"lineBreak":true},{"text":"uye achamupa mubayiro wokuzvidza kwake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}