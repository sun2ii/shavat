{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HOS","translationId":"sna_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"b71f76378be8f8d3e8438c0920cad7a8dba9bf1ac58b66f7f09d5497025c0b85","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Kutsamwa kwaJehovha pamusoro peIsraeri"]},{"type":"verse","number":1,"content":[{"text":"Efuremu akati ataura, vanhu vakadedera;","poem":1},{"text":"iye akakudzwa muIsraeri.","poem":2},{"lineBreak":true},{"text":"Asi akava nemhosva yokunamata Bhaari uye akafa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zvino vanoramba vachingotadza;","poem":1},{"text":"vanozviitira zvifananidzo zvakaumbwa nesirivha yavo,","poem":2},{"text":"zviri zvifananidzo zvakaumbwa nenjere dzavo,","poem":1},{"text":"zvose ari mabasa emhizha.","poem":2},{"text":"Pamusoro pavanhu ava zvinonzi,","poem":1},{"text":"“Vanobayira zvibayiro zvevanhu","poem":2},{"lineBreak":true},{"text":"uye vanotsvoda zviumbwa zvemhuru.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naizvozvo vachava semhute yamangwanani,","poem":1},{"text":"sedova rinokurumidza kupera,","poem":2},{"lineBreak":true},{"text":"sehundi inopeperetswa kubva paburiro,","poem":2},{"lineBreak":true},{"text":"soutsi hunobuda napawindo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Asi ndini Jehovha Mwari wako,","poem":1},{"text":"akakubudisa kubva muIjipiti.","poem":2},{"text":"Haungazovi nomumwe Mwari kunze kwangu;","poem":1},{"text":"kana mumwe Muponesi kunze kwangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndakakuchengeta murenje,","poem":1},{"text":"munyika inopisa kwazvo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pandakavapa zvokudya, vakaguta;","poem":1},{"text":"vakati vaguta, vakazvikudza","poem":2},{"lineBreak":true},{"text":"ipapo vakandikanganwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Saka ndichauya kwavari seshumba,","poem":1},{"text":"ndichavagarira panzira sembada,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sebere ratorerwa vana varo,","poem":1},{"text":"ndichavarwisa ndigovabvarura.","poem":2},{"text":"Seshumba ndichavaparadza;","poem":1},{"text":"chikara chesango chichavabvambura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Waparadzwa iwe Israeri,","poem":1},{"text":"nokuti unondirwisa, uchirwisa mubatsiri wako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mambo wako aripiko, kuti zvimwe angakuponesa?","poem":1},{"text":"Vatongi vako varipiko mumaguta ako ose,","poem":2},{"lineBreak":true},{"text":"avo vawakati, ‘Ndipei mambo namachinda’?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Saka mukutsamwa kwangu ndakakupa mambo,","poem":1},{"text":"uye muhasha dzangu ndakamubvisa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mhosva dzaEfuremu dzakaunganidzwa pamwe chete,","poem":1},{"text":"zvivi zvake zvakachengetedzwa muzvinyorwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kurwadziwa sekwomukadzi anosununguka kunosvika kwaari,","poem":1},{"text":"asi uyu mwana asina uchenjeri;","poem":2},{"lineBreak":true},{"text":"kana nguva dzasvika, haauyi kumusuo wechizvaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ndichavadzikinura kubva pasimba reguva;","poem":1},{"text":"ndichavadzikinura kubva parufu.","poem":2},{"text":"Dziripiko hosha dzako, nhai rufu?","poem":1},{"text":"Kuripiko kuparadza kwako, nhai guva?","poem":2},{"lineBreak":true},{"text":"“Handingazovi netsitsi,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"kunyange akabudirira pakati pamadzikoma ake.","poem":2},{"text":"Mhepo yokumabvazuva yaJehovha ichauya,","poem":1},{"text":"ichivhuvhuta ichibva kurenje;","poem":2},{"text":"chitubu chake chichapwa","poem":1},{"text":"uye tsime rake richaoma.","poem":2},{"text":"Dura rake richapambwa","poem":1},{"text":"zvose zvinokosha zviri mariri.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Vanhu veSamaria vanofanira kutakura mhaka yavo,","poem":1},{"text":"nokuti vakamukira Mwari wavo.","poem":2},{"text":"Vachaparadzwa nomunondo;","poem":1},{"text":"vacheche vavo vacharoverwa pasi.","poem":2},{"lineBreak":true},{"text":"Vakadzi vavo vane mimba vachatumburwa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}