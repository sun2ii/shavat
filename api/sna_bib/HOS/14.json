{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HOS","translationId":"sna_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"b71f76378be8f8d3e8438c0920cad7a8dba9bf1ac58b66f7f09d5497025c0b85","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Kutendeuka kunouyisa Maropafadzo"]},{"type":"verse","number":1,"content":[{"text":"Iwe Israeri, dzokera kuna Jehovha Mwari wako.","poem":1},{"text":"Zvivi zvako ndizvo zvakauyisa kuwa kwako!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Endai namashoko","poem":1},{"text":"uye mudzokere kuna Jehovha.","poem":2},{"lineBreak":true},{"text":"Muti kwaari: “Regererai zvivi zvedu zvose","poem":2},{"text":"mutigamuchire nenyasha,","poem":1},{"text":"kuti tigopa zvibereko zvemiromo yedu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asiria haingatiponesi;","poem":1},{"text":"hatingatasvi mabhiza ehondo.","poem":2},{"text":"Hatizombotizve, ‘Vamwari vedu’","poem":1},{"text":"kune zvakagadzirwa namaoko edu chaiwo,","poem":2},{"lineBreak":true},{"text":"nokuti nherera dzinowana tsitsi mamuri.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ndichaporesa kusateerera kwavo","poem":1},{"text":"uye ndichangovada hangu,","poem":2},{"lineBreak":true},{"text":"nokuti hasha dzangu dzabva kwavari.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndichava sedova kuna Israeri;","poem":1},{"text":"achatunga seruva remahapa.","poem":2},{"text":"Somusidhari weRebhanoni","poem":1},{"text":"achadzikisa midzi yake;","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"mabukira ake achakura.","poem":2},{"text":"Kunaka kwake kuchafanana nekwomuti womuorivhi,","poem":1},{"text":"kunhuhwira kwake sekwomusidhari weRebhanoni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vanhu vachagarazve mumumvuri wake.","poem":1},{"text":"Achabudirira sezviyo.","poem":2},{"text":"Achatunga maruva somuzambiringa,","poem":1},{"text":"uye mbiri yake ichafanana newaini yeRebhanoni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nhai Efuremu, ndichineiko chokuita nezvifananidzo?","poem":1},{"text":"Ndichamupindura uye ndichamuchengeta.","poem":2},{"text":"Ndakafanana nomuti womupaini wakasvibira;","poem":1},{"text":"kubereka kwako kunobva kwandiri.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndiani akachenjera? Achacherechedza zvinhu izvi.","poem":1},{"text":"Ndiani anonzvera? Achazvinzwisisa.","poem":2},{"text":"Nzira dzaJehovha dzakarurama;","poem":1},{"text":"vakarurama vanofamba madziri,","poem":2},{"lineBreak":true},{"text":"asi vatadzi vanogumburwa madziri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}