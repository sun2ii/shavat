{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HOS","translationId":"sna_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"b71f76378be8f8d3e8438c0920cad7a8dba9bf1ac58b66f7f09d5497025c0b85","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["“Uti kuvanunʼuna vako, ‘Vanhu vangu,’ nokuhanzvadzi dzako ‘vadikanwa vangu.’ ”"]},{"type":"heading","content":["Israeri inorangwa uye inodzorwazve"]},{"type":"verse","number":2,"content":[{"text":"“Tsiurai mai venyu, vatsiurei,","poem":1},{"text":"nokuti havasi mukadzi wangu,","poem":2},{"lineBreak":true},{"text":"uye handisi murume wavo.","poem":2},{"text":"Ngavabvise kuonekwa kwoufeve pachiso chavo","poem":1},{"text":"nokusatendeka pakati pamazamu avo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kana zvikasadaro, ndichavabvisa nguo dzose","poem":1},{"text":"vagosara vakashama sezvavakanga vakaita musi wavakaberekwa.","poem":2},{"text":"Ndichavaita segwenga","poem":1},{"text":"ndigovashandura vave nyika yakaoma","poem":2},{"lineBreak":true},{"text":"uye ndichavauraya nenyota.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Handizoratidzi vana vavo rudo,","poem":1},{"text":"nokuti vana voufeve.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mai vavo vakanga vasina kutendeka","poem":1},{"text":"uye vakavaberekera mune zvinonyadzisa.","poem":2},{"text":"Vakati, ‘Ndichateverazve vadiwa vangu,","poem":1},{"text":"vanondipa zvokudya zvangu nemvura yangu,","poem":2},{"lineBreak":true},{"text":"makushe angu nomucheka wangu, mafuta angu nezvokunwa zvangu.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naizvozvo ndichasosera nzira yavo namasanzu eminzwa;","poem":1},{"text":"ndichavapfigira mukati morusvingo zvokuti havangawani nzira yavo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vachadzinganisa vadiwa vavo asi havangavabati;","poem":1},{"text":"vachavatsvaka, asi havangavawani.","poem":2},{"text":"Ipapo vachati, ‘Ndichadzokera kumurume wangu sapakutanga","poem":1},{"text":"nokuti ipapo ndaiva nani kupfuura pari zvino.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Havana kuzvibvuma kuti ndini","poem":1},{"text":"ndaivapa zviyo, newaini itsva namafuta,","poem":2},{"text":"ndini ndakavapa sirivha negoridhe rakawanda","poem":1},{"text":"izvo zvavakashandira Bhaari nazvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Naizvozvo ndichavatorera zviyo zvangu kana zvaibva,","poem":1},{"text":"newaini yangu itsva nenguva yayo.","poem":2},{"text":"Ndichatora makushe angu nomucheka wangu","poem":1},{"text":"zvaifanira kufukidza kushama kwavo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Saka zvino ndichabudisa pachena unzenza hwavo","poem":1},{"text":"pamberi pavadiwa vavo;","poem":2},{"lineBreak":true},{"text":"hapana achazovatora kubva mumaoko angu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndichagumisa kupembera kwavo kwose:","poem":1},{"text":"mitambo yavo yose yegore negore, nguva dzoKugara kwoMwedzi,","poem":2},{"lineBreak":true},{"text":"maSabata avo nemitambo yavo yose yakatarwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndichaparadza mizambiringa yavo nemiti yavo yemionde","poem":1},{"text":"yakanga iri muripo waibva kuvadiwa vavo.","poem":2},{"text":"Ndichazviita dondo,","poem":1},{"text":"uye mhuka dzesango dzichazvidya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndichavaranga nokuda kwamazuva","poem":1},{"text":"avakapisira zvinonhuhwira kuna Bhaari;","poem":2},{"text":"vakazvishonga nemhete nezvishongo,","poem":1},{"text":"vakatevera vadiwa vavo,","poem":2},{"lineBreak":true},{"text":"asi ini vakandikanganwa,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Naizvozvo zvino ndichazovakwezva;","poem":1},{"text":"ndichavatungamirira kurenje","poem":2},{"text":"ndigotaura zvinyoronyoro kwavari.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ikoko ndichavadzosera minda yavo yemizambiringa","poem":1},{"text":"uye ndichaita kuti mupata weAkori uve musuo wetariro.","poem":2},{"text":"Ikoko vachaimba sapamazuva oumhandara hwavo,","poem":1},{"text":"sapamazuva avakabuda kubva muIjipiti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Pazuva iro,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"“Uchanditi ‘murume wangu;’","poem":2},{"lineBreak":true},{"text":"hauchazonditi ‘tenzi wangu.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndichabvisa mazita avanaBhaari pamiromo yavo;","poem":1},{"text":"havangazodani kumazita avozve.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pazuva iro ndichavaitira sungano","poem":1},{"text":"nemhuka dzesango neshiri dzedenga","poem":2},{"lineBreak":true},{"text":"uye nezvipuka zvinokambaira pasi.","poem":2},{"text":"Uta nomunondo nehondo,","poem":1},{"text":"ndichazvibvisa panyika","poem":2},{"lineBreak":true},{"text":"kuti zvose zvivate pasi zvakachengetedzeka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndichatsidza kukuwana uve wangu nokusingaperi;","poem":1},{"text":"ndichatsidza kukuwana mukururama uye nomukururamisira,","poem":2},{"lineBreak":true},{"text":"murudo netsitsi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndichatsidza kukuwana mukutendeka,","poem":1},{"text":"uye uchabvuma kuti ndini Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Pazuva iro ndichadavira,”","poem":1},{"text":"ndizvo zvinotaura Jehovha,","poem":2},{"text":"“ndichadavira kumatenga","poem":1},{"lineBreak":true},{"text":"uye ivo vachadavira kunyika;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"nenyika ichadavira kuzviyo,","poem":1},{"text":"waini itsva namafuta,","poem":2},{"lineBreak":true},{"text":"uye izvo zvichadavira kuna Jezireeri.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndichamusima panyika nokuda kwangu;","poem":1},{"text":"ndicharatidza rudo kuno uyo wandakati ‘Haasiye wandinoda.’","poem":2},{"text":"Ndichati kuna avo vanonzi ‘Havasi vanhu vangu,’ ‘Muri vanhu vangu,’","poem":1},{"text":"uye ivo vachati, ‘Muri Mwari wangu.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}