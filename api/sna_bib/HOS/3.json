vo. Vachauya vachidedera kuna Jehovha nokumaropafadzo ake mumazuva okupedzisira."]}],"footnotes":[{"noteId":0,"caller":"+","text":"magiramu angaita 170","reference":{"chapter":3,"verse":2}},{"noteId":1,"caller":"+","text":"marita angaita 330","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/sna_bib/HOS/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}