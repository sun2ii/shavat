{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HOS","translationId":"sna_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"b71f76378be8f8d3e8438c0920cad7a8dba9bf1ac58b66f7f09d5497025c0b85","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Israeri inopiwa mhosva"]},{"type":"verse","number":1,"content":[{"text":"Inzwai shoko raJehovha, imi vaIsraeri,","poem":1},{"text":"nokuti Jehovha ane mhosva yaari","poem":2},{"lineBreak":true},{"text":"kupa kwamuri imi vagere munyika:","poem":2},{"text":"“Hapana akatendeka, hapana ane rudo,","poem":1},{"text":"hapana anoziva Mwari munyika.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mune kutuka chete, kunyengera nokuuraya,","poem":1},{"text":"kuba noupombwe;","poem":2},{"text":"vanoparadza zvose zvinovadzivisa,","poem":1},{"text":"uye kudeuka kweropa kunotevera kudeuka kweropa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuda kwaizvozvi nyika inochema,","poem":1},{"text":"navose vanogara mairi vanoperezeka.","poem":2},{"text":"Mhuka dzesango neshiri dzedenga","poem":1},{"text":"nehove dzegungwa zviri kufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Asi ngapasava nomunhu anopa mhosva,","poem":1},{"text":"ngapasava nomunhu anopomera mumwe","poem":2},{"text":"nokuti vanhu venyu vakafanana neavo","poem":1},{"text":"vanopomera muprista mhaka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Imi munogumburwa masikati nousiku,","poem":1},{"text":"uye vaprofita vanogumburwawo pamwe chete nemi.","poem":2},{"text":"Saka ndichaparadza mai venyu.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Vanhu vangu vanoparadzwa nokuda kwokushayiwa zivo.","poem":2},{"lineBreak":true},{"text":"“Sezvo maramba zivo,","poem":1},{"text":"ini ndinokurambaiwo savaprista vangu;","poem":2},{"text":"nokuti makashayira hanya murayiro waMwari wenyu,","poem":1},{"text":"ini ndichashayirawo hanya vana venyu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vaprista vakati vachiwanda,","poem":1},{"text":"kunditadzira kwavo kukawandawo;","poem":2},{"lineBreak":true},{"text":"vakatsinhanisa kukudzwa nechimwe chinhu chinonyadzisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanodya zvivi zvavanhu vangu","poem":1},{"text":"uye vachifarira zvakaipa zvavo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uye zvichaitika kuti: Zvakaita vanhu, ndizvo zvichaitawo vaprista.","poem":1},{"text":"Ndicharanga vose, nokuda kwenzira dzavo","poem":2},{"lineBreak":true},{"text":"uye ndichavapa mubayiro wamabasa avo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Vachadya asi havangaguti;","poem":1},{"text":"vachaita ufeve asi havangawandi,","poem":2},{"text":"nokuti vakatiza Jehovha kuti vazvipire","poem":1}]},{"type":"verse","number":11,"content":[{"text":"kuufeve,","poem":1},{"text":"newaini yakare neitsva,","poem":2},{"lineBreak":true},{"text":"zvinobvisa kunzwisisa","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"kwavanhu vangu.","poem":2},{"text":"Vanobvunza chifananidzo chedanda","poem":1},{"text":"uye vanopindurwa netsvimbo yomuti.","poem":2},{"text":"Mweya woufeve unovatungamirira mukurasika,","poem":1},{"text":"havana kutendeka kuna Mwari wavo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vanobayira pamusoro pamakomo","poem":1},{"text":"uye vanopisira zvinonhuhwira pazvikomo,","poem":2},{"text":"pasi pemiouki, mipopura nemiterebhini,","poem":1},{"text":"pane mimvuri yakanaka.","poem":2},{"text":"Naizvozvo vanasikana venyu vanotendeukira kuufeve","poem":1},{"text":"navaroora venyu kuupombwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Handizorangi vanasikana venyu","poem":1},{"text":"pavanotendeukira kuufeve,","poem":2},{"text":"kana varoora venyu","poem":1},{"text":"pavanoita upombwe,","poem":2},{"text":"nokuti varume pachavo vanoenda kuzvifeve","poem":1},{"text":"uye vanobayira pamwe chete nezvifeve zvepashongwe,","poem":2},{"lineBreak":true},{"text":"vanhu vasinganzwisisi vachasvika pakuparadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Kunyange uchiita upombwe, iwe Israeri,","poem":1},{"text":"usaita kuti Judha ave nemhosva.","poem":2},{"lineBreak":true},{"text":"“Usaenda kuGirigari;","poem":1},{"text":"usakwidza uchienda kuBheti Avheni.","poem":2},{"lineBreak":true},{"text":"Uye usapika uchiti, ‘Zvirokwazvo naJehovha mupenyu!’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"VaIsraeri vakasindimara,","poem":1},{"text":"setsiru rakasindimara.","poem":2},{"text":"Zvino Jehovha achavafudza sei","poem":1},{"text":"samakwayana pamafuro?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Efuremu akabatana nezvifananidzo;","poem":1},{"text":"musiyei ari oga!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kunyange zvokunwa zvavo pazvinenge zvapera,","poem":1},{"text":"vanoramba vachiita ufeve hwavo;","poem":2},{"lineBreak":true},{"text":"vatongi vavo vanoda kwazvo nzira dzinonyadzisa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Chamupupuri chichavatsvairira kure,","poem":1},{"text":"uye zvibayiro zvavo zvichavaunzira kunyadziswa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}