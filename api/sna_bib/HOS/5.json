{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HOS","translationId":"sna_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"b71f76378be8f8d3e8438c0920cad7a8dba9bf1ac58b66f7f09d5497025c0b85","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Kutongwa kweIsraeri"]},{"type":"verse","number":1,"content":[{"text":"“Inzwai izvi, imi vaprista!","poem":1},{"text":"Teererai, imi vaIsraeri!","poem":2},{"text":"Teerera, iwe imba youmambo!","poem":1},{"text":"Ndiwe uri kutongwa:","poem":2},{"text":"Wakanga uri musungo paMizipa,","poem":1},{"text":"mumbure wakatambanudzwa paTabhori.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vapanduki vari mushishi rokuuraya.","poem":1},{"text":"Ndichavaranga vose.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndinoziva zvose zviri pamusoro paEfuremu;","poem":1},{"text":"Israeri haina kuvanzika kwandiri.","poem":2},{"text":"Efuremu, watendeukira zvino kuufeve;","poem":1},{"text":"Israeri aora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Zviito zvavo hazvivatenderi","poem":1},{"text":"kudzokera kuna Mwari wavo.","poem":2},{"text":"Mweya woufeve uri mumwoyo yavo;","poem":1},{"text":"havazivi Jehovha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kuzvikudza kwaIsraeri kunovapa mhosva;","poem":1},{"text":"vaIsraeri, kunyange Efuremu, vanogumburwa muchivi chavo;","poem":2},{"lineBreak":true},{"text":"Judha anogumburwawo pamwe chete navo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pavachaenda namakwai nemombe dzavo","poem":1},{"text":"kundotsvaka Jehovha,","poem":2},{"text":"havazomuwani;","poem":1},{"text":"azvibvisa kwavari.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Havana kutendeka kuna Jehovha;","poem":1},{"text":"vanobereka vana voupombwe.","poem":2},{"text":"Zvino mitambo yavo yoKugara kwoMwedzi","poem":1},{"text":"ichavadya pamwe chete neminda yavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ridzai hwamanda paGibhea,","poem":1},{"text":"norunyanga paRama.","poem":2},{"text":"Ridzai mhere yehondo paBheti Avheni;","poem":1},{"text":"tungamira pamberi, iwe Bhenjamini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efuremu achaparadzwa","poem":1},{"text":"pazuva rokutongwa.","poem":2},{"text":"Pakati pamarudzi aIsraeri","poem":1},{"text":"ndinozivisa zvinhu zvechokwadi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vatungamiri vaJudha vakafanana neavo","poem":1},{"text":"vanobvisa mabwe omuganhu.","poem":2},{"text":"Ndichadurura hasha dzangu pavari","poem":1},{"text":"samafashamu emvura.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efuremu adzvinyirirwa","poem":1},{"text":"atsikwa-tsikwa mukutongwa,","poem":2},{"lineBreak":true},{"text":"nokuti akada kutevera zvifananidzo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndakafanana nechipfukuto kuna Efuremu,","poem":1},{"text":"sokuora kuvanhu veJudha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Efuremu paakaona kurwara kwake,","poem":1},{"text":"naJudha maronda ake,","poem":2},{"text":"Efuremu ndipo paakatendeukira kuAsiria,","poem":1},{"text":"akatuma nhume kuna mambo mukuru kundotsvaka rubatsiro.","poem":2},{"text":"Asi haagoni kukurapa,","poem":1},{"text":"haagoni kuporesa mavanga ako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nokuti ndichava seshumba kuna Efuremu,","poem":1},{"text":"seshumba huru kuna Judha.","poem":2},{"text":"Ndichavabvambura kuita zvidimbu zvidimbu ndigoenda;","poem":1},{"text":"ndichaenda navo pagoshaya anovarwira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mushure maizvozvo ndichadzokera kunzvimbo yangu,","poem":1},{"text":"kusvikira vabvuma mhosva yavo.","poem":2},{"text":"Uye vachatsvaka chiso changu;","poem":1},{"text":"pakutambudzika kwavo vachanditsvaka nomwoyo wose.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}