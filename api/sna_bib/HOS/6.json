{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HOS","translationId":"sna_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"b71f76378be8f8d3e8438c0920cad7a8dba9bf1ac58b66f7f09d5497025c0b85","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Israeri inoramba kutendeuka"]},{"type":"verse","number":1,"content":[{"text":"“Uyai tidzokere kuna Jehovha.","poem":1},{"lineBreak":true},{"text":"Akatibvambura kutiita zvidimbu zvidimbu,","poem":1},{"text":"asi achatiporesa;","poem":2},{"text":"akatikuvadza,","poem":1},{"text":"asi achasungazve mavanga edu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mushure mamazuva maviri achatimutsiridza;","poem":1},{"text":"pazuva rechitatu achatidzorazve,","poem":2},{"lineBreak":true},{"text":"kuti tirarame pamberi pake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngatimuzivei iye Jehovha;","poem":1},{"text":"ngatishingairirei kumuziva.","poem":2},{"text":"Zvirokwazvo sokubuda kwezuva,","poem":1},{"text":"achaonekwa;","poem":2},{"text":"achauya kwatiri semvura yomuchando,","poem":1},{"text":"semvura yebumharutsva inodiridza nyika.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ndichaiteiko newe, Efuremu?","poem":1},{"text":"Ndichaiteiko newe, Judha?","poem":2},{"text":"Rudo rwenyu rwakafanana nemhute yamangwanani,","poem":1},{"text":"sedova ramangwanani rinopera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naizvozvo ndinokugurai ndichikuitai zvidimbu zvidimbu navaprofita vangu,","poem":1},{"text":"ndakakuurayai namashoko omuromo wangu,","poem":2},{"lineBreak":true},{"text":"kutonga kwangu kwakapenya semheni kwamuri.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nokuti ndinoda ngoni, kwete zvibayiro,","poem":1},{"text":"nokuziva Mwari kupfuura zvipiriso zvinopiswa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"SaAdhamu, vakaputsa sungano,","poem":1},{"text":"vakanga vasina kutendeka kwandiri ipapo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gireadhi iguta ravarume vakaipa,","poem":1},{"text":"rakasvibiswa norunyoro rwetsoka dzeropa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Samakororo anovandira munhu,","poem":1},{"text":"ndizvo zvinoita boka ravaprista.","poem":2},{"text":"Vanouraya vanhu panzira inoenda kuShekemu,","poem":1},{"text":"vachipara mhosva dzinonyadzisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndakaona chinhu chakaipa kwazvo","poem":1},{"text":"muimba yaIsraeri.","poem":2},{"text":"Imomo Efuremu anoita ufeve","poem":1},{"text":"uye Israeri anosvibiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nokwauriwo iwe, Judha,","poem":1},{"text":"kukohwa kwatarwa.","poem":2},{"lineBreak":true},{"text":"“Pose pandichadzorera maropafadzo avanhu vangu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}