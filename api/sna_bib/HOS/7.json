poem":1},{"text":"kubva pakukanywa kwebundu rechingwa kusvikira chafuta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pazuva romutambo wamambo wedu","poem":1},{"text":"machinda anorwara nokuda kwewaini,","poem":2},{"lineBreak":true},{"text":"uye iye akabatana navaseki.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwoyo yavo yakafanana nechoto;","poem":1},{"text":"vanouya kwaari nounyengeri,","poem":2},{"text":"ruchiva rwavo runonyeketa somoto usiku hwose;","poem":1},{"text":"mangwanani ruchizopfuta serimi romoto.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vose zvavo vanopisa sechoto;","poem":1},{"text":"vanoparadza vatongi vavo.","poem":2},{"text":"Madzimambo avo ose anowira pasi,","poem":1},{"text":"uye hapana kana mumwe wavo anodana kwandiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Efuremu anovhengana namarudzi;","poem":1},{"text":"Efuremu chingwa chitete chisina kushandurwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vatorwa vakamusveta simba rake,","poem":1},{"text":"asi iye haazvizivi.","poem":2},{"text":"Bvudzi rake rava kuchena,","poem":1},{"text":"asi iye haazvicherechedzi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kuzvikudza kwaIsraeri kunomupupurira zvakaipa,","poem":1},{"text":"asi kunyange zvakadaro","poem":2},{"text":"haadzoki kuna Jehovha Mwari wake","poem":1},{"text":"kana kumutsvaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Efuremu akaita senjiva,","poem":1},{"text":"inonyengereka zviri nyore uye isina njere,","poem":2},{"text":"zvino anodana kuIjipiti,","poem":1},{"text":"mushure anoenda kuAsiria.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pavachaenda, ndichakandira mumbure pamusoro pavo;","poem":1},{"text":"ndichavakwevera pasi seshiri dzedenga.","poem":2},{"text":"Pandichavanzwa vachibhururuka pamwe chete,","poem":1},{"text":"ndichavabata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vane nhamo,","poem":1},{"text":"nokuti vakarasika vachibva kwandiri!","poem":2},{"text":"Ngavaparadzwe,","poem":1},{"text":"nokuti vakandipandukira!","poem":2},{"lineBreak":true},{"text":"Ndinoshuva kuvadzikinura,","poem":2},{"lineBreak":true},{"text":"asi vanondirevera nhema.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Havachemi kwandiri zvinobva pamwoyo yavo,","poem":1},{"text":"asi vanoungudza vari panhoo dzavo.","poem":2},{"text":"Vanounganira zviyo newaini itsva","poem":1},{"text":"asi vanondifuratira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndakavadzidzisa ndikavasimbisa,","poem":1},{"text":"asi vanorangana kundiitira zvakaipa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Havadzokeri kuna iye Wokumusoro-soro;","poem":1},{"text":"vakafanana nouta hunonyengera.","poem":2},{"text":"Vatungamiri vavo vachaparadzwa nomunondo,","poem":1},{"text":"nokuda kwamashoko avo ounhubu.","poem":2},{"text":"Nokuda kwaizvozvi vachasekwa","poem":1},{"text":"munyika yeIjipiti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}