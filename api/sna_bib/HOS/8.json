{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HOS","translationId":"sna_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"b71f76378be8f8d3e8438c0920cad7a8dba9bf1ac58b66f7f09d5497025c0b85","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Israeri achakohwa chamupupuri"]},{"type":"verse","number":1,"content":[{"text":"“Isa hwamanda pamuromo wako!","poem":1},{"text":"Gondo riri pamusoro pemba yaJehovha","poem":2},{"text":"nokuti vanhu vakaputsa sungano yangu","poem":1},{"text":"uye vakapandukira murayiro wangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"VaIsraeri vanodana kwandiri vachiti,","poem":1},{"text":"‘Haiwa, Mwari wedu, tinokuzivai!’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asi Israeri akaramba zvakanaka;","poem":1},{"text":"muvengi achamutevera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vanogadza madzimambo vasina kutenderwa neni;","poem":1},{"text":"vanosarudza machinda pasina mvumo yangu.","poem":2},{"text":"Vanozvigadzirira zvifananidzo nesirivha negoridhe ravo","poem":1},{"text":"kuti vagoparadzwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rasira kunze chifananidzo chako chemhuru, iwe Samaria!","poem":1},{"text":"Kutsamwa kwangu kunopisa somoto pamusoro pavo.","poem":2},{"text":"Vachasvika kupiko vasingagoni kuzvichenesa?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Izvi zvinobva kuIsraeri!","poem":2},{"text":"Chimhuru ichi, chakagadzirwa nomupfuri,","poem":1},{"text":"hachisi Mwari.","poem":2},{"text":"Chichaputsika kuita zvimedu zvimedu,","poem":1},{"text":"icho chimhuru cheSamaria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Vanodyara mhepo","poem":1},{"text":"vachikohwa chamupupuri.","poem":2},{"text":"Dzinde harina kubereka;","poem":1},{"text":"haringabudisi upfu.","poem":2},{"text":"Dai raizobereka zviyo,","poem":1},{"text":"vatorwa vaizvimedza.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Israeri yamedzwa;","poem":1},{"text":"zvino yava pakati pendudzi","poem":2},{"lineBreak":true},{"text":"sechinhu chisina maturo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuti vakaenda kuAsiria","poem":1},{"text":"sembizi inongombeya yoga.","poem":2},{"lineBreak":true},{"text":"Efuremu akazvitengesa kuvadiwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kunyange zvavo vakazvitengesa pakati pendudzi,","poem":1},{"text":"ndichavaunganidza zvino pamwe chete.","poem":2},{"text":"Vachatanga kuperezeka","poem":1},{"text":"pasi poudzvinyiriri hwamambo ane simba guru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Kunyange Efuremu akavaka aritari zhinji dzezvipiriso zvechivi,","poem":1},{"text":"idzi dzava aritari dzokuitira zvivi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndakavanyorera zvinhu zvakawanda zvomurayiro wangu,","poem":1},{"text":"asi vakazvitora sezvinhu zvisinei navo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vanopa zvibayiro kwandiri","poem":1},{"text":"uye vodya nyama yacho,","poem":2},{"lineBreak":true},{"text":"asi Jehovha haafadzwi navo.","poem":2},{"text":"Zvino acharangarira uipi hwavo","poem":1},{"text":"uye acharanga zvivi zvavo:","poem":2},{"lineBreak":true},{"text":"Vachadzokera kuIjipiti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israeri akakanganwa Musiki wake","poem":1},{"text":"ndokuvaka mizinda;","poem":2},{"lineBreak":true},{"text":"Judha akomberedza maguta mazhinji namasvingo.","poem":2},{"text":"Asi ndichatumira moto pamaguta avo","poem":1},{"text":"uchaparadza masvingo avo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}