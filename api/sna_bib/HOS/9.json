{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"HOS","translationId":"sna_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"b71f76378be8f8d3e8438c0920cad7a8dba9bf1ac58b66f7f09d5497025c0b85","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Israeri inorangwa"]},{"type":"verse","number":1,"content":[{"text":"Rega kufara, iwe Israeri;","poem":1},{"text":"rega kupembera sezvinoita dzimwe ndudzi.","poem":2},{"text":"Nokuti hauna kunge wakatendeka kuna Mwari wako;","poem":1},{"text":"unofarira mubayiro wechifeve, pamapuriro ose.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mapuriro nezvisviniro zvewaini hazvingagutsi vanhu.","poem":1},{"text":"Waini itsva ichavanyengera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Havangarambi vari munyika yaJehovha;","poem":1},{"text":"Efuremu achadzokera kuIjipiti","poem":2},{"lineBreak":true},{"text":"agodya zvokudya zvakasvibiswa muAsiria.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Havangadiri zvipiriso zvewaini kuna Jehovha,","poem":1},{"text":"uye zvibayiro zvavo hazvingamufadzi.","poem":2},{"text":"Zvibayiro zvakadai zvichava kwavari sechingwa chavanochema;","poem":1},{"text":"vose vanozvidya vachava vakasvibiswa.","poem":2},{"text":"Zvokudya izvi zvichava zvavo;","poem":1},{"text":"hazvingaunzwi mutemberi yaJehovha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Muchaiteiko pazuva rakatarwa remitambo yenyu,","poem":1},{"text":"pamazuva emitambo yaJehovha?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kunyange dai vakapunyuka kubva pakuparadzwa,","poem":1},{"text":"Ijipiti ichavaunganidza,","poem":2},{"lineBreak":true},{"text":"uye Memufisi ichavaviga.","poem":2},{"text":"Matura avo esirivha achafukidzwa norukato,","poem":1},{"text":"uye minzwa ichamera mumatende avo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mazuva okurangwa ari kuuya,","poem":1},{"text":"mazuva okutsiva ava pedyo.","poem":2},{"lineBreak":true},{"text":"Israeri ngaazvizive izvi.","poem":2},{"text":"Nokuti zvivi zvako zvizhinji kwazvo","poem":1},{"text":"uye ukasha hwako hwakakura kwazvo.","poem":2},{"text":"Muprofita anoonekwa sebenzi,","poem":1},{"text":"nomurume ano mweya somunhu anopenga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Muprofita, pamwe chete naMwari wangu,","poem":1},{"text":"ndiye nharirire yaEfuremu,","poem":2},{"text":"asi zvakadaro misungo yakamumirira panzira dzake dzose,","poem":1},{"text":"uye ruvengo muimba yaMwari wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vanyura kwazvo kwazvo muhuori,","poem":1},{"text":"sapamazuva eGibhea.","poem":2},{"text":"Mwari acharangarira uipi hwavo","poem":1},{"text":"uye achavaranga nokuda kwezvivi zvavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Pandakawana Israeri,","poem":1},{"text":"zvakanga zvakafanana nokuwana mazambiringa murenje;","poem":2},{"text":"pandakaona madzibaba enyu,","poem":1},{"text":"zvakanga zvakaita sokuona zvibereko zvokutanga pamuti womuonde.","poem":2},{"text":"Asi pavakauya kuBhaari Peori,","poem":1},{"text":"vakazvitsaura kuti vazviise kuchiumbwa ichocho chinonyadzisa,","poem":2},{"lineBreak":true},{"text":"vakava vasina maturo uye vakafanana nechinhu chavakada.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kukudzwa kwaEfuremu kuchabhururuka seshiri,","poem":1},{"text":"pasina kubereka, pasina pamuviri, pasina kubata pamuviri.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kunyange zvavo vakarera vana,","poem":1},{"text":"ndichavauraya vose mumwe nomumwe.","poem":2},{"text":"Vachava nenhamo","poem":1},{"text":"pandichavafuratira!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndakaona Efuremu, seTire,","poem":1},{"text":"akasimwa panzvimbo yakanaka.","poem":2},{"text":"Asi Efuremu achabudisa","poem":1},{"text":"vana vake kumuurayi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Vapei, imi Jehovha,","poem":1},{"text":"zvino muchavapeiko?","poem":2},{"text":"Vapei zvibereko zvinopfupfudzika","poem":1},{"text":"namazamu akaoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Nokuda kwouipi hwavo hwose muGirigari,","poem":1},{"text":"ndakavavenga ikoko.","poem":2},{"text":"Nokuda kwamabasa avo akaipa,","poem":1},{"text":"ndichavadzinga kubva mumba mangu.","poem":2},{"text":"Handichazovadazve;","poem":1},{"text":"vatungamiri vavo vose vakapanduka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Efuremu arohwa,","poem":1},{"text":"mudzi wavo wasvava,","poem":2},{"text":"havabereki chibereko.","poem":1},{"lineBreak":true},{"text":"Kunyange vakabereka vana,","poem":1},{"text":"ndichauraya vana vavo ivava vavanodisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mwari wangu achavaramba","poem":1},{"text":"nokuti havana kumuteerera;","poem":2},{"lineBreak":true},{"text":"vachava vadzungairi pakati pendudzi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}