{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Chiratidzo chaIsaya mwanakomana waAmozi, chaakaona pamusoro peJudha neJerusarema pamazuva aUzia naJotamu, naAhazi naHezekia, madzimambo eJudha."]},{"type":"heading","content":["Rudzi Runomukira"]},{"type":"verse","number":2,"content":[{"text":"Inzwai imi matenga! Teerera iwe nyika!","poem":1},{"text":"Nokuti Jehovha akataura achiti,","poem":2},{"text":"“Ndakarera vana ndikavakudza,","poem":1},{"text":"asi ivo vakandimukira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nzombe inoziva vatenzi vayo,","poem":1},{"text":"nembongoro inoziva chidyiro chomwene wayo,","poem":2},{"text":"asi Israeri haizivi,","poem":1},{"text":"vanhu vangu havanzwisisi.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Haiwa, rudzi runotadza,","poem":1},{"text":"vanhu vakaremerwa nezvakaipa,","poem":2},{"text":"vana vavaiti vezvakaipa,","poem":1},{"text":"vana vanoita zvakaora!","poem":2},{"text":"Vakasiya Jehovha;","poem":1},{"text":"vakashora Mutsvene waIsraeri","poem":2},{"lineBreak":true},{"text":"vakamufuratira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mucharambireiko muchingorohwa?","poem":1},{"text":"Munorambireiko muchimukira Jehovha?","poem":2},{"text":"Musoro wenyu wose wakuvadzwa,","poem":1},{"text":"mwoyo wenyu wose warwadziwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kubvira pasi porutsoka rwako kusvikira panhongonya yomusoro","poem":1},{"text":"wako hapana pakukutu,","poem":2},{"text":"anongova maronda nokurwadziwa","poem":1},{"text":"namavanga akazaruka,","poem":2},{"text":"asina kusukwa kana kusungwa","poem":1},{"text":"kana kuzorwa mafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nyika yenyu yaparadzwa,","poem":1},{"text":"Maguta enyu apiswa nomoto;","poem":2},{"text":"minda yenyu iri kutorwa navatorwa","poem":1},{"text":"pamberi penyu chaipo,","poem":2},{"lineBreak":true},{"text":"nyika yaparadzwa sapanoparadza vatorwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwanasikana weZioni asiyiwa sedumba","poem":1},{"text":"mumunda wemizambiringa,","poem":2},{"text":"seimba mumunda wamanwiwa,","poem":1},{"text":"seguta rakakombwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dai Jehovha Wamasimba Ose","poem":1},{"text":"asina kutisiyira vakapunyuka,","poem":2},{"text":"tingadai takafanana neSodhomu,","poem":1},{"text":"tingadai takaita seGomora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Inzwai shoko raJehovha,","poem":1},{"text":"imi vabati veSodhomu;","poem":2},{"text":"teererai kumurayiro waMwari wedu,","poem":1},{"text":"imi vanhu veGomora!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Zvibayiro zvenyu zvizhinji,","poem":1},{"text":"zvinyiko kwandiri?” ndizvo zvinotaura Jehovha.","poem":2},{"text":"“Zvibayiro zvinopiswa zvawandisa,","poem":1},{"text":"zvamakondobwe namafuta ezvipfuwo zvakakodzwa;","poem":2},{"text":"Handifadzwi neropa renzombe,","poem":1},{"text":"ramakwayana nerembudzi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pamunouya kuzozviratidza pamberi pangu,","poem":1},{"text":"ndianiko akambokukumbirai izvi kwamuri,","poem":2},{"lineBreak":true},{"text":"naikoku kutsika-tsika pavazhe dzangu?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Regai kuuya nezvipiriso zvisina maturo!","poem":1},{"text":"Zvinonhuhwira zvenyu zvinondinyangadza.","poem":2},{"text":"Nguva dzoKugara kwoMwedzi, maSabata nenguva dzekokorodzano,","poem":1},{"text":"handigoni kufarira ungano dzenyu dzakaipa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mitambo yenyu yoKugara kwoMwedzi nemitambo yenyu yakatsaurwa inovengwa","poem":1},{"text":"nomweya wangu.","poem":2},{"text":"Zvava mutoro kwandiri;","poem":1},{"text":"ndaneta nokuzvitakura.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pamunotambanudza maoko enyu muchinyengetera,","poem":1},{"text":"ini ndichakuvanzirai chiso changu;","poem":2},{"text":"kunyange mukawanza munyengetero,","poem":1},{"text":"handisi kuzokunzwai.","poem":2},{"text":"Maoko enyu azere neropa;","poem":1}]},{"type":"verse","number":16,"content":[{"text":"shambai muzvinatse.","poem":2},{"text":"Bvisai mabasa enyu akaipa","poem":1},{"text":"pamberi pangu!","poem":2},{"text":"Regai kuita zvakaipa,","poem":1}]},{"type":"verse","number":17,"content":[{"text":"dzidzai kuita zvakarurama.","poem":2},{"text":"Tsvakai kururamisira,","poem":1},{"text":"kurudzirai vakamanikidzwa.","poem":2},{"text":"Dzivirirai nherera,","poem":1},{"text":"mukumbirire chirikadzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Chiuyai zvino titaurirane,”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":2},{"text":"“Kunyange zvivi zvenyu zviri","poem":1},{"text":"zvitsvuku zvichachena sechando;","poem":2},{"text":"kunyange zviri zvishava somuti mushava,","poem":1},{"text":"zvichaita samakushe amakwai.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kana muchida uye muchiteerera","poem":1},{"text":"muchadya zvakanakisa zvenyika;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"asi kana muchiramba uye muchindimukira,","poem":1},{"text":"muchaparadzwa nomunondo.”","poem":2},{"text":"Nokuti muromo waJehovha wazvitaura.","poem":4}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tarirai guta rakatendeka","poem":1},{"text":"rava chifeve sei!","poem":2},{"text":"Iro rakanga rizere nokururamisira;","poem":1},{"text":"kururama kwaigara mariri,","poem":2},{"lineBreak":true},{"text":"asi zvino mogara mhondi!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sirivha yako yava nengura,","poem":1},{"text":"waini yako yakavhenganiswa nemvura.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Machinda ako vapanduki,","poem":1},{"text":"ishamwari dzembavha;","poem":2},{"text":"vose vanoda fufuro,","poem":1},{"text":"uye vanomhanyira zvipo.","poem":2},{"text":"Havana hanya nokudzivirira nherera;","poem":1},{"text":"mhaka yechirikadzi haiuyiswi pamberi pavo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Naizvozvo Ishe, Jehovha","poem":1},{"text":"Wamasimba Ose, Anesimba waIsraeri, anotaura achiti,","poem":2},{"text":"“Haiwa, ndichadurura hasha dzangu pamusoro pavadzivisi vangu,","poem":1},{"text":"nokuzvitsivira vavengi vangu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndichatambanudzira ruoko rwangu kwauri;","poem":1},{"text":"ndichapedza chose ngura yako","poem":2},{"lineBreak":true},{"text":"ndigobvisa kusachena kwako kwose.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndichadzosera vatongi vako sapamazuva akare,","poem":1},{"text":"namakurukota ako sapamazuva okutanga.","poem":2},{"text":"Shure kwaizvozvo uchanzi","poem":1},{"text":"Guta Rokururama,","poem":2},{"lineBreak":true},{"text":"Guta Rakatendeka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Zioni richadzikinurwa nokururamiswa,","poem":1},{"text":"navanotendeuka varo, nokururama.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Asi vapanduki navatadzi vachaparadzwa vose,","poem":1},{"text":"uye vose vanosiya Jehovha vachaparara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Nokuti muchanyadziswa nokuda kwemiti yomuouki yamunoeresa,","poem":1},{"text":"yamunofadzwa nayo;","poem":2},{"text":"muchanyadziswa nokuda kwamapindu","poem":1},{"text":"amakasarudza.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Muchafanana nomuouki wasvava mashizha,","poem":1},{"text":"sebindu risina mvura.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Murume ane simba achava serwodzi","poem":1},{"text":"nebasa rake sesasaradzi;","poem":2},{"text":"zvose zvichatsva pamwe chete,","poem":1},{"text":"pasina achadzima moto.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}