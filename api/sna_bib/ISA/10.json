{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Vane nhamo vanodzika mitemo isina kururama,","poem":1},{"text":"neavo vanopa mitemo inodzvinyirira,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kuti vadzivise varombo kodzero dzavo","poem":1},{"text":"uye vadzivise kururamisirwa kwavakadzvinyirirwa vavanhu vangu,","poem":2},{"text":"vachipamba chirikadzi","poem":1},{"text":"uye vachibira nherera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muchaita sei pazuva rokutongwa,","poem":1},{"text":"njodzi painouya ichibva kure?","poem":2},{"text":"Muchatizira kuna aniko kuti mubatsirwe?","poem":1},{"text":"Upfumi hwenyu muchahusiyepiko?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hapana chichasara asi kungokotama pakati penhapwa,","poem":1},{"text":"kana kuwira pakati pavakaurayiwa.","poem":2},{"text":"Kunyange zvakadaro, kutsamwa kwake hakuna kudzorwa,","poem":1},{"text":"ruoko rwake ruchakangosimudzwa.","poem":2}]},{"type":"heading","content":["Kutonga kwaMwari pamusoro peAsiria"]},{"type":"verse","number":5,"content":[{"text":"“Une nhamo iwe Asiria, shamhu yokutsamwa kwangu,","poem":1},{"text":"iye akabata tsvimbo yehasha dzangu mumaoko ake!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndiri kumutuma kurudzi rusina Mwari,","poem":1},{"text":"ndinomutuma kuvanhu vanonditsamwisa,","poem":2},{"text":"kundokomba nokutora nokubvuta zvakapambwa,","poem":1},{"text":"nokuvatsikirira pasi sedope riri mumigwagwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asi izvi handizvo zvaanoda,","poem":1},{"text":"izvi handizvo zvaanga achifunga;","poem":2},{"text":"vavariro yake ndeyokuparadza,","poem":1},{"text":"kupedza chose marudzi mazhinji.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anoti, ‘Ko, machinda angu haazi madzimambo ose here?","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Karino harina kuita sezvakaita Karikemishi here?","poem":2},{"text":"Ko, Hamati harina kufanana neAripadhi,","poem":1},{"text":"uye Samaria harina kufanana neDhamasiko here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ruoko rwangu sezvarwakatora umambo hwezvifananidzo,","poem":1},{"text":"umambo hune zvifananidzo zvakakunda zveJerusarema neSamaria,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ko, handichaitiri Jerusarema nezvifananidzo zvaro","poem":1},{"text":"sezvandakaitira Samaria nezvifananidzo zvayo here?’ ”","poem":2}]},{"type":"verse","number":12,"content":["Kana Ishe achinge apedza basa rake rose pamusoro peGomo reZioni neJerusarema, achazoti, “Ndicharanga mambo weAsiria nokuda kwokuzvikudza kwomwoyo wake namanyawi emeso ake."]},{"type":"verse","number":13,"content":["Nokuti iye anoti,",{"text":"“ ‘Nesimba ramaoko angu ndakaita izvi,","poem":1},{"text":"uye nouchenjeri hwangu, nokuti ndinonzwisisa.","poem":2},{"text":"Ndakabvisa miganhu yendudzi,","poem":1},{"text":"ndikapamba pfuma yavo;","poem":2},{"lineBreak":true},{"text":"semhare ndakakunda madzimambo avo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sezvinoita munhu anosvasvavira mudendere,","poem":1},{"text":"saizvozvo ruoko rwangu rwakananavira pfuma yamarudzi;","poem":2},{"text":"savarume vanounganidza mazai akasiyiwa,","poem":1},{"text":"saizvozvo ndakaunganidza nyika dzose;","poem":2},{"text":"hakuna yakapfakanyisa bapiro,","poem":1},{"text":"kana kushamisa muromo wayo kuti irire.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ko, demo ringazvirumbidza kupfuura iye anoritemesa here?","poem":1},{"text":"Kana jeko ringazvirumbidza pamusoro pounorishandisa here?","poem":2},{"text":"Zvinozoita sokunge tsvimbo inosimudza uyo anoitakura,","poem":1},{"text":"kana mudonzvo kusimudza uyo asati ari huni!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Naizvozvo, Ishe Jehovha Wamasimba Ose,","poem":1},{"text":"achatumira denda rinoonza pamusoro pavarwi vakafuta;","poem":2},{"text":"pasi pokubwinya kwake moto uchatungidzwa","poem":1},{"text":"kufanana nemirazvo inopfuta.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Chiedza chaIsraeri chichava moto,","poem":1},{"text":"noMutsvene wavo murazvo womoto;","poem":2},{"text":"muzuva rimwe chete uchapfuta","poem":1},{"text":"ugopedza minzwa yake norukato rwake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kubwinya kwamasango ake neminda yake","poem":1},{"text":"yakaorera kuchaparadzwa chose,","poem":2},{"lineBreak":true},{"text":"kufanana nomurwere anoramba achipera.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Uye miti yakasara yamasango ake ichava mishoma kwazvo,","poem":1},{"text":"zvokuti mwana angagona kuinyora pasi.","poem":2}]},{"type":"heading","content":["Vakasara veIsraeri"]},{"type":"verse","number":20,"content":[{"text":"Pazuva iro vakasara veIsraeri,","poem":1},{"text":"vakapunyuka veimba yaJakobho,","poem":2},{"text":"havachazovimbi naye iye akavarova,","poem":1},{"text":"asi zvirokwazvo vachavimba naJehovha, Mutsvene waIsraeri.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vakasara vachadzokera, vakasara vaJakobho,","poem":1},{"text":"vachadzokera kuna Mwari Ane Simba.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kunyange vanhu vako, iwe Israeri, vakaita sejecha regungwa,","poem":1},{"text":"vachasara chete ndivo vachadzokera.","poem":2},{"text":"Kuparadzwa kwakatotemwa,","poem":1},{"text":"kuzere nokururama.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ishe, Jehovha Wamasimba Ose","poem":1},{"text":"achapedzisa kuparadzwa kwakatemerwa nyika yose.","poem":2}]},{"type":"verse","number":24,"content":["Naizvozvo zvanzi naIshe, Jehovha Wamasimba Ose:",{"text":"“Haiwa, vanhu vangu vanogara muZioni,","poem":1},{"text":"musatya vaAsiria,","poem":2},{"text":"vanokurovai nomudonzvo nokukusimudzirai tsvimbo,","poem":1},{"text":"sezvakaitwa neIjipiti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nokuti nenguva duku duku kutsamwa kwangu pamusoro penyu kuchapera,","poem":1},{"text":"uye hasha dzangu dzichanangana nokuparadzwa kwavo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Jehovha Wamasimba Ose achavarova netyava,","poem":1},{"text":"samarovero aakaita vaMidhia padombo reOrebhi,","poem":2},{"text":"uye achasimudza tsvimbo yake pamusoro pemvura zhinji,","poem":1},{"text":"sezvaakaita muIjipiti.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Pazuva iro mitoro yavo ichabviswa pamapfudzi enyu,","poem":1},{"text":"nejoko ravo pamitsipa yenyu;","poem":2},{"text":"joko richavhuniwa,","poem":1},{"text":"nokuti manyanya kufuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Vanopinda muAyati;","poem":1},{"text":"vopfuura nomuMigironi;","poem":2},{"lineBreak":true},{"text":"vochengeta nhumbi paMikimashi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Vanopfuura napamupata, vagoti,","poem":1},{"text":"“Tichadzika matende paGebha usiku.”","poem":2},{"text":"Rama rinobvunda;","poem":1},{"text":"Gibhea raSauro rinotiza.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ridza mhere, iwe mukunda weGarimi!","poem":1},{"text":"Teerera, iwe Raisha!","poem":2},{"lineBreak":true},{"text":"Newe Anatoti unonzwisa urombo!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Madhimena riri kutiza;","poem":1},{"text":"vanhu veGebhimi vanovanda.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Zuva ranhasi vachamira paNobhi;","poem":1},{"text":"vachakunga chibhakera chavo","poem":2},{"text":"pagomo remwanasikana weZioni,","poem":1},{"text":"pachikomo cheJerusarema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Tarirai, Ishe, Jehovha Wamasimba Ose,","poem":1},{"text":"achatema matavi nesimba guru.","poem":2},{"text":"Miti mirefu refu ichawiswa,","poem":1},{"text":"uye yakareba ichadzikiswa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Achatema matenhere esango nedemo;","poem":1},{"text":"Rebhanoni ichawa pamberi paIye Ane Simba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}