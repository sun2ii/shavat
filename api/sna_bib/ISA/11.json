{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["Davi raJese"]},{"type":"verse","number":1,"content":[{"text":"Bukira richabva kudzinde raJese;","poem":1},{"text":"Davi rinobva pamidzi yake richabereka muchero.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mweya waJehovha uchagara pamusoro pake,","poem":1},{"text":"mweya wouchenjeri newokunzwisisa, mweya wokurayira nowesimba,","poem":2},{"lineBreak":true},{"text":"mweya wokuziva newokutya Jehovha,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"uye achafarira kutya Jehovha.","poem":1},{"lineBreak":true},{"text":"Haazotongi nezvaanoona nameso ake,","poem":1},{"text":"kana kutonga nezvaanonzwa nenzeve dzake,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"asi nokururama achatongera varombo,","poem":1},{"text":"nokururamisira achatongera vanyoro vapanyika.","poem":2},{"text":"Acharova nyika neshamhu yomuromo wake;","poem":1},{"text":"nokufema kwemiromo yake achauraya vakaipa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kururuma ndiro richava bhanhire rake","poem":1},{"text":"uye kutendeka bhanhire romuchiuno chake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bere richagara negwayana,","poem":1},{"text":"ingwe ichavata pasi nembudzi,","poem":2},{"text":"mhuru neshumba nezvakakodzwa zvichafura pamwe chete;","poem":1},{"text":"uye mwana mudiki achazvitungamirira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mhou ichafura nebere,","poem":1},{"text":"vana vazvo vachavata pasi pamwe chete,","poem":2},{"lineBreak":true},{"text":"uye shumba ichadya uswa senzombe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwana mucheche achatambira pedyo nomwena wemhakure,","poem":1},{"text":"uye mwana mudiki achaisa ruoko rwake mumwena wenyoka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hazvingazokuvadzi kana kuparadza","poem":1},{"text":"pagomo rangu rose dzvene,","poem":2},{"text":"nokuti nyika ichazara nokuziva Jehovha","poem":1},{"text":"semvura zhinji inofukidza gungwa.","poem":2}]},{"type":"verse","number":10,"content":["Pazuva iro Mudzi waJese uchamira somureza wamarudzi; ndudzi dzichamhanyira kwaari, uye nzvimbo yake yokuzorora ichabwinya."]},{"type":"verse","number":11,"content":["Pazuva iro Jehovha achatambanudza ruoko rwake kechipiri kuti adzorezve vakasara ivo vanhu vake vakasiyiwa kubva kuAsiria, kubva zasi kweIjipiti, nokubva kumusoro kweIjipiti nokubva kuEtiopia, nokubva kuEramu, nokubva kuBhabhironi, nokuHamati uye nokubva kuzviwi zvegungwa."]},{"type":"verse","number":12,"content":[{"text":"Achasimudzira marudzi mureza","poem":1},{"text":"uye achaunganidza vakadzingwa vaIsraeri;","poem":2},{"text":"achaunganidza vakaparadzirwa vavanhu veJudha,","poem":1},{"text":"kubva kumativi mana enyika.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Godo raEfuremu richapera","poem":1},{"text":"uye vavengi vavaJudha vachagurwa;","poem":2},{"text":"Efuremu haachazovi negodo naJudha,","poem":1},{"text":"naJudha haangaitire Efuremu hasha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Asi vachawira pamusoro pamateru eFiristia kumavirazuva;","poem":1},{"text":"pamwe chete vachapamba vanhu vokumabvazuva.","poem":2},{"text":"Vachatora Edomu neMoabhu,","poem":1},{"text":"uye vaAmoni vachava varanda vavo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jehovha achaomesa chose","poem":1},{"text":"chikamu chegungwa reIjipiti;","poem":2},{"text":"nemhepo inopisa achatsvaira noruoko rwake","poem":1},{"text":"pamusoro peRwizi rweYufuratesi.","poem":2},{"text":"Acharukamura-kamura agoruita hova nomwe,","poem":1},{"text":"kuitira kuti vanhu vagone kuyambuka vachienda mhiri vakapfeka shangu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pachava nomugwagwa mukuru wavanhu vake vakasara,","poem":1},{"text":"vakasiyiwa kubva kuAsiria,","poem":2},{"text":"sezvazvakanga zviri kuvaIsraeri","poem":1},{"text":"pavakabva kuIjipiti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}