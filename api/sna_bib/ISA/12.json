{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Nziyo dzoKurumbidza"]},{"type":"verse","number":1,"content":["Pazuva iro muchati,",{"text":"“Ndichakurumbidzai, imi Jehovha,","poem":1},{"text":"kunyange makanga makanditsamwira,","poem":2},{"text":"kutsamwa kwenyu kwakadzorwa","poem":1},{"text":"uye makandinyaradza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zvirokwazvo Mwari ndiye ruponeso rwangu;","poem":1},{"text":"ndichavimba naye uye handingatyi.","poem":2},{"text":"Jehovha, Jehovha ndiye simba rangu nerwiyo rwangu;","poem":1},{"text":"ava ruponeso rwangu.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nomufaro muchachera mvura","poem":1},{"text":"kubva mumatsime oruponeso.","poem":2}]},{"type":"verse","number":4,"content":["Pazuva iro muchati,",{"text":"“Vongai Jehovha, danai kuzita rake;","poem":1},{"text":"zivisai zvaakaita pakati pendudzi,","poem":2},{"lineBreak":true},{"text":"uye muparidze kuti zita rake risimudzirwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Imbirai Jehovha, nokuti akaita zvinhu zvinoshamisa;","poem":1},{"text":"izvi ngazvizivikanwe pasi pose.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pururudzai uye muimbe nomufaro, imi vanhu veZioni,","poem":1},{"text":"nokuti Mutsvene waIsraeri mukuru pakati penyu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}