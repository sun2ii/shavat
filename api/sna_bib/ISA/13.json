ari kugadzirira","poem":1},{"text":"mauto kundorwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vanobva kunyika dziri kure,","poem":1},{"text":"kubva kumagumo amatenga,","poem":2},{"text":"Jehovha nezvombo zvokutsamwa kwake,","poem":1},{"text":"kuti aparadze nyika yose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ungudzai, nokuti zuva raJehovha rava pedyo;","poem":1},{"text":"richauya nokuparadza kunobva kuna Wamasimba Ose.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Naizvozvo maoko ose achashaya simba,","poem":1},{"text":"mwoyo mumwe nomumwe wavanhu uchanyungudika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kutya kuchavabata,","poem":1},{"text":"kurwadziwa nokugomera zvichavabata,","poem":2},{"lineBreak":true},{"text":"vachamonyoroka somukadzi ari kusununguka.","poem":2},{"text":"Vachatarisana vachishamisika mumwe nomumwe wavo,","poem":1},{"text":"zviso zvavo zvichipfuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tarirai, zuva raJehovha riri kuuya,","poem":1},{"text":"zuva rakaipisisa, rine hasha nokutsamwa kunotyisa,","poem":2},{"text":"kuti nyika ive dongo","poem":1},{"text":"uye nokuzoparadza vatadzi vari mukati mayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nyeredzi dzokudenga namapoka adzo","poem":1},{"text":"hadzizoratidzi chiedza chadzo.","poem":2},{"text":"Zuva rinobuda richasvibiswa","poem":1},{"text":"uye mwedzi hauzopi chiedza chawo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndicharanga nyika nokuda kwokuipa kwayo,","poem":1},{"text":"navakaipa nokuda kwezvivi zvavo.","poem":2},{"text":"Ndichagumisa vanozvikudza pakudada kwavo,","poem":1},{"text":"uye ndichaderedza kuzvikudza kwavasina tsitsi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndichaita kuti munhu ashayikwe kudarika goridhe,","poem":1},{"text":"ashayikwe kudarika kushayikwa kwegoridhe reOfiri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Naizvozvo ndichabvundisa matenga;","poem":1},{"text":"uye nyika ichazungunuka kubva panzvimbo yayo,","poem":2},{"text":"nehasha dzaJehovha Wamasimba Ose,","poem":1},{"text":"pazuva rokutsamwa kwake kunopisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Semhara inovhimwa,","poem":1},{"text":"samakwai asina mufudzi,","poem":2},{"text":"mumwe nomumwe achadzokera kuvanhu vokwake,","poem":1},{"text":"mumwe nomumwe achatizira kunyika yake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mumwe nomumwe achabatwa achabayiwa,","poem":1},{"text":"vose vanobatwa vachaurayiwa nomunondo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Vacheche vavo vacharoverwa pasi vagobvamburwa-bvamburwa vachizviona;","poem":1},{"text":"dzimba dzavo dzichapambwa uye vakadzi vavo vachachinyiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tarirai, ndichavamutsira vaMedhia","poem":1},{"text":"vasina hanya nesirivha,","poem":2},{"lineBreak":true},{"text":"uye vasingafariri goridhe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uta hwavo huchabaya majaya;","poem":1},{"text":"havazovi nengoni navacheche","poem":2},{"lineBreak":true},{"text":"kana kutarira vana netsitsi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zvino Bhabhironi rembiri paumambo,","poem":1},{"text":"kubwinya kwokuzvikudza kwavaBhabhironi,","poem":2},{"text":"richaparadzwa naMwari","poem":1},{"text":"kufanana neSodhomu neGomora.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Haringatongogarwizve navanhu","poem":1},{"text":"uye hakuna vachazogaramo kusvikira kuzvizvarwa zvose;","poem":2},{"text":"hapana muArabhu achadzika tende rake ikoko,","poem":1},{"text":"hakuna mufudzi achazorodza makwai ake ikoko.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Asi zvisikwa zvomugwenga ndizvo zvichagara ikoko,","poem":1},{"text":"makava achazadza dzimba dzavo;","poem":2},{"text":"mazizi achagara ikoko,","poem":1},{"text":"uye imomo ngururu dzichakwakuka-kwakuka.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mapere achachema ari munhare dzavo,","poem":1},{"text":"makava mudzimba dzavo dzinoyevedza dzamadzimambo.","poem":2},{"text":"Nguva yake yaswedera,","poem":1},{"text":"uye mazuva aro haazowedzerwi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}