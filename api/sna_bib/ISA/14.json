{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Jehovha achanzwira Jakobho tsitsi;","poem":1},{"text":"achasarudza Israeri zvakare","poem":2},{"lineBreak":true},{"text":"uye achavagarisa munyika yavo.","poem":2},{"text":"Vatorwa vachabatana navo","poem":1},{"text":"vachanamatirana neimba yaJakobho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndudzi dzichavatora","poem":1},{"text":"dzigovadzosera kunzvimbo yavo chaiyo.","poem":2},{"text":"Uye imba yaIsraeri ichatora ndudzi","poem":1},{"text":"kuti vave varandarume navarandakadzi munyika yaJehovha.","poem":2},{"text":"Vachaita nhapwa vaya vaimbova vatapi vavo,","poem":1},{"text":"uye vachabata ushe pamusoro pavaya vaimbova vamanikidzi vavo.","poem":2}]},{"type":"verse","number":3,"content":["Pazuva ramuchapiwa rusununguko naJehovha kubva pakutambudzika, nokusagadzikana, nokubatwa noutsinye,"]},{"type":"verse","number":4,"content":["uchasveeredza mambo weBhabhironi uchiti:",{"text":"Haiwa, mumanikidzi apera sei!","poem":1},{"text":"Haiwa, hasha dzake dzapera sei!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jehovha akavhuna tsvimbo yavakaipa","poem":1},{"text":"netsvimbo yamadzimambo,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"yaakarova nayo marudzi","poem":1},{"text":"mukutsamwa nokurova kusingaperi,","poem":2},{"text":"uye akakunda ndudzi","poem":1},{"text":"nehasha nokurwisa kusingaperi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nyika dzose dzazorora uye dzava norugare;","poem":1},{"text":"votanga kufara nokuimba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kunyange nemiti yemisipuresi nemisidhari yokuRebhanoni","poem":1},{"text":"inofara pamusoro pako ichiti,","poem":2},{"text":"“Zvino zvawaparadzwa,","poem":1},{"text":"hakuna varume vanotsvaka huni vachauya kuzotitema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Pasi, iro sheori razungunuka","poem":1},{"text":"kuti rinangane newe pakuuya kwako;","poem":2},{"text":"riri kumutsa mweya yavakaenda kuti izokukwazisai,","poem":1},{"text":"vose vakaenda vari vatungamiri munyika;","poem":2},{"text":"rinoita kuti vasimuke pazvigaro zvavo zvoushe,","poem":1},{"text":"vose vakanga vari madzimambo endudzi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vose vachapindura,","poem":1},{"text":"vachati kwauri,","poem":2},{"text":"“Newewo hauchisina simba, sesu;","poem":1},{"text":"wangofanana nesu.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kuzvikudza kwako kwose kwaderedzwa kusvika muguva,","poem":1},{"text":"pamwe chete nokurira kworudimbwa rwako;","poem":2},{"text":"honye dzawarirwa pasi pako","poem":1},{"text":"uye makonye anokufukidza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Haiwa, wawa seiko, uchibva kudenga,","poem":1},{"text":"iwe nyamasase yamangwanani, mwanakomana wamambakwedza!","poem":2},{"text":"Wakakandwa panyika,","poem":1},{"text":"iyewe wakambowisira ndudzi pasi!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wakati mumwoyo mako,","poem":1},{"text":"“Ndichakwira kudenga;","poem":2},{"text":"ndichasimudzira chigaro changu choushe","poem":1},{"text":"pamusoro penyeredzi dzaMwari;","poem":2},{"text":"ndichagara pachigaro changu choushe pagomo reungano,","poem":1},{"text":"pamusoro pegomo dzvene.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndichakwira pamusoro-soro pamakore;","poem":1},{"text":"ndichazviita seWokumusoro-soro.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asi waderedzwa kusvika kuguva,","poem":1},{"text":"kwakadzika dzika kwegomba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Vose vanokuona vanokunanʼanidza,","poem":1},{"text":"vachafungisisa zvamagumo ako vachiti,","poem":2},{"text":"“Ndiye here murume","poem":1},{"text":"uya akazungunutsa nyika, akadederesa ushe,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"murume akaita kuti nyika ive gwenga,","poem":1},{"text":"akaparadza maguta ayo,","poem":2},{"lineBreak":true},{"text":"akasatendera vasungwa vake kudzokera kumusha?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Madzimambo ose endudzi ave mukukudzwa,","poem":1},{"text":"mumwe nomumwe muguva rake.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Asi iwe warasirwa kunze kweguva rako,","poem":1},{"text":"kufanana nedavi rakaraswa;","poem":2},{"text":"wakafukidzwa navakaurayiwa,","poem":1},{"text":"naavo vakabayiwa nomunondo,","poem":2},{"lineBreak":true},{"text":"avo vakadzika kumatombo egomba.","poem":2},{"text":"Kufanana nechitunha chinotsikwa-tsikwa netsoka,","poem":1}]},{"type":"verse","number":20,"content":[{"text":"hauzobatani navo pakuvigwa kwako,","poem":2},{"text":"nokuti wakaparadza nyika yako","poem":1},{"text":"ukauraya vanhu vako.","poem":2},{"lineBreak":true},{"text":"Vana vowakaipa","poem":1},{"text":"havazotaurwi nezvavozve.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Gadzirirai nzvimbo yokuurayira vanakomana vake","poem":1},{"text":"nokuda kwezvivi zvamadzitateguru avo;","poem":2},{"text":"havazosimuki kuti vagare nhaka yenyika","poem":1},{"text":"vagozadza nyika namaguta avo","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Ndichavamukira ini,”","poem":1},{"text":"ndizvo zvinotaura Jehovha Wamasimba Ose.","poem":2},{"text":"“Ndichabvisa zita rake navakasara vake kubva kuBhabhironi,","poem":1},{"text":"vana vake navana vavana vake,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":23,"content":[{"text":"“Ndichaishandura kuti ive nzvimbo yamazizi","poem":1},{"text":"nenyika yamachawi;","poem":2},{"text":"ndicharitsvaira nomutsvairo wokuparadza,”","poem":1},{"text":"ndizvo zvinotaura Jehovha Wamasimba Ose.","poem":2}]},{"type":"heading","content":["Chiprofita pamusoro peAsiria"]},{"type":"verse","number":24,"content":["Jehovha Wamasimba Ose akapika achiti:",{"text":"“Zvirokwazo sezvandakafunga ndizvo zvichaitika,","poem":1},{"text":"uye sezvandakarangarira ndizvo zvichaitika.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndichapwanya muAsiria munyika yangu;","poem":1},{"text":"ndichamutsikirira pasi pamusoro pegomo rangu.","poem":2},{"text":"Joko rake richabviswa kubva pavanhu vangu,","poem":1},{"text":"nomutoro wake wokubva pamabvudzi avo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Iyi ndiyo pfungwa yakarongerwa nyika yose;","poem":1},{"text":"urwu ndirwo ruoko rwakatambanudzirwa pamusoro pamarudzi ose.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nokuti Jehovha Wamasimba Ose akazvironga zvino ndianiko angamukonesa?","poem":1},{"text":"Ruoko rwake rwakatambanudzwa ndianiko angarudzora?","poem":2}]},{"type":"heading","content":["Chiprofita pamusoro peFiristia"]},{"type":"verse","number":28,"content":["Shoko iri rakauya mugore rakafa Mambo Ahazi richiti:"]},{"type":"verse","number":29,"content":[{"text":"Musafara imi mose vaFiristia,","poem":1},{"text":"muchiti shamhu yakakurovai imi, yavhunika;","poem":2},{"text":"nokuti kubva pamudzi wenyoka iyo pachabuda mvumbi,","poem":1},{"text":"chibereko chayo chichava nyoka ino uturu hunobaya.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Murombo wavarombo achawana mafuro,","poem":1},{"text":"uye vanoshayiwa vacharara pasi murugare.","poem":2},{"text":"Asi ndichaparadza mudzi wako nenzara;","poem":1},{"text":"ichauraya vakasara vako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ungudza iwe suo! Chema, iwe guta!","poem":1},{"text":"Nyungudukai, imi vaFiristia mose!","poem":2},{"text":"Gore routsi riri kuuya richibva kumusoro,","poem":1},{"text":"uye hapana achatiza pasimba raro.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ko, imhinduroi ichapiwa","poem":1},{"text":"kunhume dzorudzi urwo?","poem":2},{"text":"“Jehovha akasimbisa Zioni,","poem":1},{"text":"uye mariri vanhu vake vanotambudzika vachawana pokuvanda.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}