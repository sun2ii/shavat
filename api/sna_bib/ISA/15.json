nodanidzira,","poem":1},{"text":"manzwi avo anonzwika kusvikira kuJahazi.","poem":2},{"text":"Naizvozvo varwi veMoabhu vanodanidzira,","poem":1},{"text":"uye mwoyo yavo yaziya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mwoyo wangu unodanidzira pamusoro peMoabhu;","poem":1},{"text":"vatizi varo vanotiza kusvikira kuZoari,","poem":2},{"lineBreak":true},{"text":"kusvikira kuEgirati-Sherishiya.","poem":2},{"text":"Vanokwidza nenzira yokuRuhiti,","poem":1},{"text":"vanofamba vachichema,","poem":2},{"text":"munzira yokuHoronaimi","poem":1},{"text":"vanochema kuparadzwa kwavo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mvura yokuNimirimi yakapwa","poem":1},{"text":"uye uswa hwaoma;","poem":2},{"text":"bumhudza rapera","poem":1},{"text":"uye hapachina chakasvibirira chakasara.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Saka pfuma yavakawana neyavakaunganidza","poem":1},{"text":"vanoiyambutsira mhiri kworukova rwemikonachando.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kudanidzira kwavo kwaita maungira kuchitevedza muganhu weMoabhu;","poem":1},{"text":"kuungudza kwavo kunosvikira kuEgiraimi,","poem":2},{"lineBreak":true},{"text":"kuchema kwavo kunosvikira kuBheeri Erimi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mvura yapaDhimoni yakazara neropa,","poem":1},{"text":"asi ndichauyisazve zvakawanda pamusoro peDhimoni,","poem":2},{"text":"shumba pamusoro pavatizi veMoabhu","poem":1},{"text":"uye napamusoro pavaya vakasara munyika.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}