{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Tumirai mutero","poem":1},{"text":"wamakwayana kumutongi wenyika,","poem":2},{"text":"kubva kuSera, zvichiyambukira kurenje,","poem":1},{"text":"kugomo roMwanasikana weZioni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kufanana neshiri dzadzungaira","poem":1},{"text":"dzichisundidzirwa kubva mudendere,","poem":2},{"text":"ndizvo zvakaita vakadzi veMoabhu","poem":1},{"text":"pamazambuko eAmoni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Tipeiwo zano,","poem":1},{"text":"ruramisirai.","poem":2},{"text":"Ita mumvuri wako kuti ufanane nousiku,","poem":1},{"text":"pamasikati makuru.","poem":2},{"text":"Viga vatizi,","poem":1},{"text":"usapandukira vapoteri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Rega vatizi veMoabhu vagare newe,","poem":1},{"text":"iva utiziro hwavo kubva kumuparadzi.”","poem":2},{"lineBreak":true},{"text":"Mutambudzi achasvika kumagumo,","poem":1},{"text":"uye kuparadza kuchapera;","poem":2},{"lineBreak":true},{"text":"mudenhi achatsakatika panyika.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Murudo, chigaro choushe chichasimbiswa;","poem":1},{"text":"mukutendeka, munhu achagarapo, mumwe anobva kuimba yaDhavhidhi,","poem":2},{"text":"uyo anoti achitonga anotsvaka kururamisira,","poem":1},{"text":"uye achikurumidza kuita zvakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Takanzwa nezvokuzvikudza kwaMoabhu,","poem":1},{"text":"namanyawi ake makuru uye kuzvida kwake,","poem":2},{"text":"kuzvikudza kwake nokuvirima kwake,","poem":1},{"text":"asi kuzvirumbidza kwake hakuna maturo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Naizvozvo vaMoabhu voungudza,","poem":1},{"text":"vanoungudzira Moabhu pamwe chete.","poem":2},{"text":"Chemai musuwe","poem":1},{"text":"nokuda kwavarume veKiri Hareseti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Minda yeHeshibhoni yaoma","poem":1},{"text":"uye mazambiringa eSibhima aomawo.","poem":2},{"text":"Vatongi vendudzi vatsika-tsika","poem":1},{"text":"mizambiringa yakaisvonaka,","poem":2},{"text":"iyo yaimbosvika kuJazeri","poem":1},{"text":"uye yaitandira yakananga kurenje.","poem":2},{"text":"Mabukira ayo","poem":1},{"text":"aitandira kusvika kugungwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Saka ndinochema, sokuchema kweJazeri,","poem":1},{"text":"nokuda kwemizambiringa yeSibhima.","poem":2},{"text":"Haiwa Heshibhoni, haiwa Ereare,","poem":1},{"text":"ndichakudiridza nemisodzi!","poem":2},{"text":"Ruzha rwomufaro pamusoro pemizambiringa","poem":1},{"text":"yakaibva napamusoro pezvamakakohwa rwanyaradzwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mufaro nokufarisisa zvabviswa paminda yemizambiringa;","poem":1},{"text":"hapana anoimba kana kuita ruzha muminda yemizambiringa;","poem":2},{"text":"hapana anosvina waini pazvisviniro,","poem":1},{"text":"nokuti ndagumisa ruzha rwacho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwoyo wangu unorira nokuda kwaMoabhu, kufanana nokurira kwembira,","poem":1},{"text":"mukati kati mangu munorira nokuda kweKiri Hareseti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Zvino kana Moabhu achizviratidza panzvimbo dzake dzakakwirira,","poem":1},{"text":"anenge achingozvinetsa pachake;","poem":2},{"text":"paanoenda kuimba yake kunonyengetera,","poem":1},{"text":"zvinenge zvisina chazvinobatsira,","poem":2}]},{"type":"verse","number":13,"content":["Iri ndiro shoko rakataurwa kare naJehovha pamusoro peMoabhu."]},{"type":"verse","number":14,"content":["Asi zvino Jehovha anoti, “Makore matatu asati apfuura, sokuverengwa kwaangaitwa nomuranda akazvisunga kubatira mubayiro, kukudzwa kweMoabhu navanhu vake vose vakawanda kuchazvidzwa, uye vakapunyuka vake vachava vashoma kwazvo uye vasina simba.”"]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}