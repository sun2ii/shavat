{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":17,"content":[{"type":"heading","content":["Chirevo pamusoro peDhamasiko"]},{"type":"verse","number":1,"content":["Chirevo pamusoro peDhamasiko:",{"text":"“Tarirai, Dhamasiko harichazovazve guta,","poem":1},{"text":"asi richava murwi wamatongo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maguta eAroeri achasiyiwa uye achava mafuro ezvipfuyo,","poem":1},{"text":"izvo zvichavata pasi,","poem":2},{"lineBreak":true},{"text":"pasina anozvivhundutsa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maguta akakomberedzwa namasvingo achanyangarika achibva pana Efuremu,","poem":1},{"text":"uye simba roushe kubva paDhamasiko;","poem":2},{"text":"vakasara veAramu","poem":1},{"text":"vachava sembiri yavaIsraeri,”","poem":2},{"text":"ndizvo zvinotaura Jehovha Wamasimba Ose.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"“Pazuva iro kukudzwa kwaJakobho kuchapera;","poem":1},{"text":"mafuta omuviri wake achapera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvichafanana nomukohwi anokohwa madzinde akamira,","poem":1},{"text":"uyo anokohwa zviyo noruoko rwake,","poem":2},{"text":"sezvinoita murume anononga hura","poem":1},{"text":"dzezviyo muMupata weRefaimi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kunyange zvakadaro dzimwe tsanga dzichasara,","poem":1},{"text":"sezvinoita muorivhi kana wazunzwa,","poem":2},{"text":"uchisiya maorivhi maviri kana matatu pamatavi okumusoro-soro,","poem":1},{"text":"mana kana mashanu pamatavi makuru anobereka,”","poem":2},{"text":"ndizvo zvinotaura Jehovha Mwari waIsraeri.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Pazuva iro vanhu vachatarira kuMusiki wavo,","poem":1},{"text":"vagodzorera meso avo kuMutsvene waIsraeri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Havachazotarisi kuaritari,","poem":1},{"text":"iro basa ramaoko avo,","poem":2},{"text":"uye havachazovi nehanya nematanda aAshera nearitari","poem":1},{"text":"dzezvinonhuhwira dzakaitwa neminwe yavo.","poem":2}]},{"type":"verse","number":9,"content":["Pazuva iro maguta avo akasimba avakasiya nokuda kwavaIsraeri, achafanana nenzvimbo dzakaregerwa kuti dzive matenhere nezvinomera pasi pavo. Uye ose achava matongo."]},{"type":"verse","number":10,"content":[{"text":"Nokuti wakanganwa Mwari Muponesi wako,","poem":1},{"text":"hauna kurangarira Dombo, iyo nhare yako.","poem":2},{"text":"Naizvozvo, kunyange ukazvisimira miti yakanakisisa,","poem":1},{"text":"uye ukadyara mizambiringa inobva kune dzimwe nyika,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kunyange pazuva raunoisima, ugoita kuti ikure,","poem":1},{"text":"ugoita kuti ive namaruva,","poem":2},{"text":"asi mukohwo uchava sapasina","poem":1},{"text":"pazuva rehosha nokurwadziwa kusingarapiki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Haiwa, kutinhira kwendudzi zhinji,","poem":1},{"text":"dzinotinhira sokutinhira kwegungwa!","poem":2},{"text":"Haiwa, kuomba kwamarudzi","poem":1},{"text":"anoomba kufanana nokutinhira kwemvura zhinji!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kunyange vanhu vakaomba sokutinhira kwamafungu emvura,","poem":1},{"text":"paanovatuka vachatizira kure,","poem":2},{"text":"vachidzingirirwa nemhepo sehundi pamusoro pezvikomo,","poem":1},{"text":"kufanana nouswa hunozungunuswa pamberi pedutu guru.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Munguva yamadekwana,","poem":1},{"text":"pachava nokutyisa! Kusati kwaedza, havachipo!","poem":2},{"text":"Uyu ndiwo mugove wavaya vanotibira,","poem":1},{"text":"nomubayiro wavanotipamba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}