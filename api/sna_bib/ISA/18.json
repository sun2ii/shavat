{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["Chiprofita pamusoro peEtiopia"]},{"type":"verse","number":1,"content":[{"text":"Ine nhamo nyika yokutinhira","poem":1},{"text":"kwamapapiro inotevedza nzizi dzeEtiopia,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"inotuma nhume nenzira yomugungwa,","poem":1},{"text":"muzvikepe zvenhokwe pamusoro pemvura.","poem":2},{"text":"Endai, imi nhume dzinokurumidza,","poem":1},{"lineBreak":true},{"text":"kuvanhu vakareba uye vane ganda rinotsvedzerera,","poem":1},{"text":"kuvanhu vanotyiwa kure napedyo,","poem":2},{"text":"rudzi rune hasha nomutauro usinganzwisisiki,","poem":1},{"text":"rune nyika yakakamurwa nenzizi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Imi mose muri pasi pose,","poem":1},{"text":"imi munogara panyika,","poem":2},{"text":"kana mureza wasimudzwa pamusoro pamakomo,","poem":1},{"text":"muchauona,","poem":2},{"text":"uye kana hwamanda yarira,","poem":1},{"text":"muchainzwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zvanzi naJehovha kwandiri:","poem":1},{"text":"“Ndicharamba ndinyerere uye ndichatarira ndiri paugaro hwangu,","poem":2},{"text":"samanyirinyiri omushana unopisa,","poem":1},{"text":"segore redova mukupisa kwokukohwa.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nokuti, kukohwa kusati kwasvika,","poem":1},{"text":"kana kutungira kwamaruva kwaguma, uye ruva rova muzambiringa woibva,","poem":2},{"lineBreak":true},{"text":"achagura mabukira namapanga okurangura,","poem":2},{"lineBreak":true},{"text":"achatemera pasi uye agorasira kure matavi akatandavara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zvose zvichasiyirwa magora omugomo nokuzvikara zvesango;","poem":1},{"text":"shiri dzichazvidya chirimo chose,","poem":2},{"text":"uye zvikara zvesango","poem":1},{"text":"zvichazvidya muchando chose.","poem":2}]},{"type":"verse","number":7,"content":["Panguva iyoyo, zvipo zvichavigirwa Jehovha Wamasimba Ose,",{"text":"zvichibva kuvanhu vakareba vane ganda rinotsvedzerera,","poem":1},{"text":"kubva kuvanhu vanotyiwa kwose kwose,","poem":2},{"text":"rudzi rune hasha nomutauro usinganzwisisiki,","poem":1},{"text":"rudzi rune nyika yakakamurwa nenzizi,","poem":2},"zvipo zvichauyiswa kuZioni, nzvimbo yeZita raJehovha Wamasimba Ose."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}