{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Gomo raJehovha"]},{"type":"verse","number":1,"content":["Izvi ndizvo zvakaonekwa naIsaya mwanakomana waAmozi, pamusoro peJudha neJerusarema:"]},{"type":"verse","number":2,"content":["Mumazuva okupedzisira,",{"text":"gomo retemberi yaJehovha richasimbiswa,","poem":1},{"text":"richava guru pakati pamakomo;","poem":2},{"text":"richakwiridzirwa pamusoro pezvikomo,","poem":1},{"text":"uye ndudzi dzose dzichamhanyira kwariri.","poem":2}]},{"type":"verse","number":3,"content":["Ndudzi zhinji dzichauya dzichiti,",{"text":"“Uyai ngatiendei kugomo raJehovha,","poem":1},{"text":"kuimba yaMwari waJakobho","poem":2},{"text":"Iye achatidzidzisa nzira dzake,","poem":1},{"text":"kuitira kuti tigofamba mumakwara ake.”","poem":2},{"text":"Nokuti murayiro uchabva paZioni,","poem":1},{"text":"shoko raJehovha richabva kuJerusarema.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Achatonga pakati pendudzi","poem":1},{"text":"uye achapedza gakava pakati pamarudzi mazhinji.","poem":2},{"text":"Vachapfura minondo yavo vagoiita miromo yamagejo,","poem":1},{"text":"namapfumo avo vagoaita mapanga okuchekerera miti nawo.","poem":2},{"text":"Rudzi rumwe harungazosimudziri munondo kuno rumwe rudzi,","poem":1},{"text":"kana kuzodzidzirazve kurwa.","poem":2}]},{"type":"verse","number":5,"content":["Uyai, imi imba yaJakobho,",{"text":"ngatifambei muchiedza chaJehovha.","poem":2}]},{"type":"heading","content":["Zuva raJehovha"]},{"type":"verse","number":6,"content":[{"text":"Nokuti makasiya vanhu venyu,","poem":1},{"text":"ivo imba yaJakobho.","poem":2},{"text":"Vakazara nezvinamato zvokuMabvazuva;","poem":1},{"text":"vanoita zvokuvuka kufanana navaFiristia,","poem":2},{"lineBreak":true},{"text":"vachibatana maoko nevedzimwe ndudzi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nyika yavo izere nesirivha negoridhe;","poem":1},{"text":"pfuma yavo haiperi.","poem":2},{"text":"Nyika yavo izere namabhiza;","poem":1},{"text":"ngoro dzavo hadziperi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nyika yavo izere nezvifananidzo;","poem":1},{"text":"vanopfugamira mabasa amaoko avo,","poem":2},{"lineBreak":true},{"text":"kuzvinhu zvakaitwa neminwe yavo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Naizvozvo munhu achaderedzwa","poem":1},{"text":"uye marudzi avanhu achaninipiswa,","poem":2},{"lineBreak":true},{"text":"musavakanganwira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pinda mumapako,","poem":1},{"text":"uvande muguruva,","poem":2},{"text":"ubve mukutyisa kwaJehovha","poem":1},{"text":"nokubwinya kwoumambo hwake!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Meso omunhu anozvikudza achaninipiswa,","poem":1},{"text":"uye kuzvikudza kwavanhu kuchaderedzwa;","poem":2},{"text":"asi Jehovha oga ndiye achakudzwa pazuva iro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nokuti Jehovha Wamasimba Ose","poem":1},{"text":"ane zuva raakachengetera avo vose","poem":2},{"lineBreak":true},{"text":"vanozvikudza navanodada,","poem":2},{"lineBreak":true},{"text":"navose vanokudzwa (uye vachaninipiswa),","poem":2}]},{"type":"verse","number":13,"content":[{"text":"nemisidhari yose yeRebhanoni, yakareba neyakakwirira,","poem":1},{"text":"nemiouki yose yeBhashani,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"namakomo ose akakwirira,","poem":1},{"text":"nezvikomo zvose zvakakwirira,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"neshongwe dzose dzakakwirira,","poem":1},{"text":"namasvingo ose akasimba,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"nezvikepe zvose zveTashishi,","poem":1},{"text":"nemidziyo yose yakanaka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuzvikudza kwomunhu kuchaderedzwa,","poem":1},{"text":"uye kuzvikudza kwavanhu kuchaninipiswa;","poem":2},{"text":"Jehovha oga ndiye achakudzwa pazuva iro,","poem":1}]},{"type":"verse","number":18,"content":[{"text":"uye zvifananidzo zvichapera zvachose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Vanhu vachatizira kumapako amatombo,","poem":1},{"text":"nokumwena yapasi","poem":2},{"text":"nokuda kwaJehovha anotyisa,","poem":1},{"text":"uye nokubwinya kwoumambo hwake,","poem":2},{"lineBreak":true},{"text":"paanosimuka achizungunutsa nyika.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Pazuva iro vanhu vacharasira","poem":1},{"text":"kumakonzo nokuzviremwaremwa,","poem":2},{"text":"zvifananidzo zvavo zvesirivha nezvifananidzo zvegoridhe,","poem":1},{"text":"zvavakaita kuti vazvinamate.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vachatizira kumapako amatombo","poem":1},{"text":"nokumikaha yakarembera,","poem":2},{"text":"nokuda kwokutya Jehovha,","poem":1},{"text":"uye nokubwinya kwoumambo hwake,","poem":2},{"lineBreak":true},{"text":"paanosimuka kuti azungunutse nyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Regai kuvimba nomunhu,","poem":1},{"text":"anongova nokufema mumhino dzake.","poem":2},{"text":"Anobatsireiko?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}