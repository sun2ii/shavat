{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Chiprofita pamusoro peBhabhironi"]},{"type":"verse","number":1,"content":["Chirevo pamusoro peRenje riri pedyo neGungwa:",{"text":"Kufanana nechamupupuri chinovhuvhuta nomunyika yezasi,","poem":1},{"text":"mupambi anouya achibva kurenje,","poem":2},{"lineBreak":true},{"text":"kubva kunyika inotyisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ndaratidzwa chiratidzo chinorwadza.","poem":1},{"text":"Mupanduki anopanduka, muparadzi anotora zvokupamba","poem":2},{"text":"Eramu, rwisa! Medhia, vandira!","poem":1},{"text":"Ndichagumisa kugomera kwose kwaakaita kuti kuvepo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Naizvozvo muviri wangu wakazara nokurwadziwa;","poem":1},{"text":"marwadzo akandibata, kufanana nomukadzi ari kusununguka;","poem":2},{"text":"ndiri kudzedzereka nezvandinonzwa,","poem":1},{"text":"ndakanganisika nezvandinoona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwoyo wangu woziya,","poem":1},{"text":"kutya kwondidederesa;","poem":2},{"text":"rubvunzavaeni rwandaishuva","poem":1},{"text":"rwava chinyangadzo kwandiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vanogadzira matafura,","poem":1},{"text":"vanowaridza micheka pasi,","poem":2},{"lineBreak":true},{"text":"vanodya, vanonwa!","poem":2},{"text":"Simukai, imi machinda,","poem":1},{"text":"zodzai nhoo!","poem":2}]},{"type":"verse","number":6,"content":["Zvanzi naIshe kwandiri:",{"text":"“Endai, mundogadza nharirire","poem":1},{"text":"uye muite kuti azivise zvaanoona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kana achiona ngoro namapoka amabhiza,","poem":1},{"text":"navatasvi vari pamusoro pembongoro","poem":2},{"text":"kana vatasvi vari pamusoro pengamera,","poem":1},{"text":"ngaave akachenjera, akachenjera zvizere.”","poem":2}]},{"type":"verse","number":8,"content":["Ipapo nharirire yakadanidzira ichiti,",{"text":"“Zuva nezuva, tenzi wangu, ndinomira pamusoro peshongwe yomurindi;","poem":1},{"text":"usiku hwoga hwoga ndinogara panzvimbo yangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tarirai, hoyo murume ari kuuya ari mungoro","poem":1},{"text":"neboka ramabhiza.","poem":2},{"text":"Uye anopa mhinduro achiti,","poem":1},{"text":"‘Bhabhironi rawa, rawa!","poem":2},{"text":"Zvifananidzo zvose zvavamwari","poem":1},{"text":"varo zvaputsirwa pasi!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Haiwa, vanhu vangu vapwanyirwa paburiro,","poem":1},{"text":"ndinokuudzai zvandanzwa kubva kuna","poem":2},{"text":"Jehovha Wamasimba Ose,","poem":1},{"text":"kubva kuna Mwari waIsraeri.","poem":2}]},{"type":"heading","content":["Chiprofita pamusoro peEdhomu"]},{"type":"verse","number":11,"content":["Chirevo pamusoro peDhuma:",{"text":"Mumwe anodana kwandiri ari kuSeiri, achiti,","poem":1},{"text":"“Nharirire iwe, inguvaiko ino yousiku?","poem":2},{"lineBreak":true},{"text":"Nharirire iwe, inguvaiko ino yousiku?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nharirire inopindura ichiti,","poem":1},{"text":"“Mambakwedza achauya, asi nousikuwo.","poem":2},{"text":"Zvino kana uchida kubvunza, bvunza;","poem":1},{"text":"uye ugodzokazve.”","poem":2}]},{"type":"heading","content":["Chiprofita pamusoro peArabhia"]},{"type":"verse","number":13,"content":["Chirevo pamusoro peArabhia:",{"text":"Imi ngoro dzavaDhedhani,","poem":1},{"text":"munodzika misasa mumatenhere eArabhia,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"vigirai vane nyota mvura;","poem":2},{"text":"imi munogara muTema,","poem":1},{"text":"uyai nezvokudya zvavanotiza.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vari kutiza munondo,","poem":1},{"text":"kubva kumunondo wavhomorwa,","poem":2},{"text":"nokuuta hwawemburwa,","poem":1},{"text":"uye nokupisa kwehondo.","poem":2}]},{"type":"verse","number":16,"content":["Zvanzi naJehovha kwandiri: “Pachinguva chegore rimwe chete, sokuverenga kungaita mushandi akabatwa nechibvumirano, kuzvikudza kwose kweKedhari kuchapera."]},{"type":"verse","number":17,"content":["Varume vouta vachapunyuka, ivo mhare dzeKedhari vachava vashoma.” Jehovha, Mwari weIsraeri ataura."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}