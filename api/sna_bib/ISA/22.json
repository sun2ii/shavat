{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":22,"content":[{"type":"heading","content":["Chiprofita pamusoro peJerusarema"]},{"type":"verse","number":1,"content":["Chirevo pamusoro poMupata weChiratidzo:",{"text":"Chii chinokutambudzai zvino,","poem":1},{"text":"zvokuti mose makwira pamusoro pamatenga edzimba?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haiwa guta rizere nemheremhere,","poem":1},{"text":"haiwa guta renyonganyonga nokupembera?","poem":2},{"text":"Vakaurayiwa venyu havana kubayiwa nomunondo,","poem":1},{"text":"kana kufira muhondo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vatungamiri vako vose vatiza pamwe chete;","poem":1},{"text":"vabatwa pasina kushandiswa uta.","poem":2},{"text":"Mose imi makabatwa mukaitwa vasungwa pamwe chete,","poem":1},{"text":"kunyange makanga matiza muvengi achiri kure.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naizvozvo ndakati, “Endai kure neni;","poem":1},{"text":"regai ndicheme kwazvo.","poem":2},{"text":"Musaedza kundinyaradza","poem":1},{"text":"pamusoro pokuparadzwa kwavanhu vangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ishe, Jehovha Wamasimba Ose,","poem":1},{"text":"ane zuva renyonganyonga nerokutsikira","poem":2},{"lineBreak":true},{"text":"pasi nokutyisa muMupata woKuratidza,","poem":2},{"text":"zuva rokukoromorera masvingo","poem":1},{"text":"pasi nerokudanidzira kumakomo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eramu anotora goba,","poem":1},{"text":"pamwe chete navatasvi vamabhiza nengoro;","poem":2},{"lineBreak":true},{"text":"Kiri anofudugura nhoo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mipata yako yakaisvonaka yakazara nengoro,","poem":1},{"text":"uye vatasvi vamabhiza vakaiswa pamasuo eguta;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kudzivirirwa kweJudha kwakabviswa.","poem":1},{"lineBreak":true},{"text":"Uye pazuva iro makatarira,","poem":1},{"text":"kuzvombo muMuzinda weSango;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"makaona kuti Guta raDhavhidhi","poem":1},{"text":"raiva napakakoromoka pakawanda","poem":2},{"text":"munzvimbo dzokudzivirira;","poem":1},{"text":"makazvichengetera mvura muDziva reZasi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Makaverenga dzimba muJerusarema,","poem":1},{"text":"mukaondomora dzimba kuti musimbise rusvingo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Makavaka gungwa pakati pamasvingo maviri,","poem":1},{"text":"kuti muchingidzire mvura yomudziva rakare,","poem":2},{"text":"asi hamuna kutarira kuna Iye akariita,","poem":1},{"text":"kana kuva nehanya naIye akazvironga kare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ishe, Jehovha Wamasimba Ose,","poem":1},{"text":"akakudaidzai pazuva iro","poem":2},{"text":"kuti mucheme uye muungudze,","poem":1},{"text":"kuti mudzure bvudzi renyu uye mufuge masaga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Asi tarirai, kune mufaro nokupembera,","poem":1},{"text":"kubayiwa kwemombe nokuurayiwa kwamakwai,","poem":2},{"lineBreak":true},{"text":"kudyiwa kwenyama nokunwiwa kwewaini!","poem":2},{"text":"Munoti, “Ngatidyei uye tinwe,","poem":1},{"text":"nokuti mangwana tichafa!”","poem":2}]},{"type":"verse","number":14,"content":["Jehovha Wamasimba Ose akazivisa izvi munzeve dzangu achiti, “Kusvikira pazuva rokufa kwako, chivi ichi hachizokanganwirwi,” ndizvo zvinotaura Ishe, Jehovha Wamasimba Ose."]},{"type":"verse","number":15,"content":["Zvanzi naIshe, Jehovha Wamasimba Ose:",{"text":"“Enda, undoti kumutariri uyu,","poem":1},{"text":"kuna Shebhina, mutariri womuzinda, uti kwaari:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uri kuitei pano uye ndiani akakupa mvumo","poem":1},{"text":"yokuti uzvicherere rinda pano,","poem":2},{"text":"uchizvivezera rinda rako pakakwirira","poem":1},{"text":"nokuzvivezera nzvimbo yako yokuzorora mudombo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Hokoyo, Jehovha ava kuda kukuti dzvi,","poem":1},{"text":"agokurasira kure, iwe murume wesimba.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Achakupomba-pomba sebhora","poem":1},{"text":"agokukanda munyika yakakura.","poem":2},{"text":"Ndimo mauchafira,","poem":1},{"text":"uye ngoro dzako dzine mbiri dzichasara imomo,","poem":2},{"lineBreak":true},{"text":"iwe wokunyadzisa imba yatenzi wako!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndichakudzinga pabasa rako,","poem":1},{"text":"uye uchatandaniswa panzvimbo yako.","poem":2}]},{"type":"verse","number":20,"content":["“Pazuva iro ndichadana muranda wangu, Eriakimi mwanakomana waHirikia."]},{"type":"verse","number":21,"content":["Ndichamupfekedza nguo yako ndigomusimbisa nebhanhire rako uye ndigoisa masimba ako pamusoro pake. Achava baba kuna vagere muJerusarema nokuimba yaJudha."]},{"type":"verse","number":22,"content":["Ndichaisa papfudzi rake kiyi yeimba yaDhavhidhi; chaanenge azarura hapana angapfiga, uye chaanenge apfiga hapana angazarura."]},{"type":"verse","number":23,"content":["Ndichamuroverera sembambo panzvimbo yakasimba; achava chigaro chinokudzwa paimba yababa vake."]},{"type":"verse","number":24,"content":["Mbiri yeimba yababa vake ichaturikwa paari; matavi namabukira, nemidziyo midiki yose, kubva pamikombe kusvikira pamakate ose."]},{"type":"verse","number":25,"content":["“Pazuva iro,” ndizvo zvinotaura Jehovha Wamasimba Ose, “mbambo yakarovererwa panzvimbo yakasimba ichabva; ichatemwa igowisirwa pasi, uye mutoro wakarembera pauri uchatemerwa pasi.” Jehovha ataura izvozvo."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/21.json","previousChapterAudioLinks":{},"numberOfVerses":25}