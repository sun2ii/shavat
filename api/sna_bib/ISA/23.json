{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Chiprofita pamusoro peTire"]},{"type":"verse","number":1,"content":["Chirevo pamusoro peTire:",{"text":"Ungudzai imi zvikepe zveTashishi!","poem":1},{"text":"Nokuti Tire raparadzwa","poem":2},{"lineBreak":true},{"text":"uye rasiyiwa risina imba kana pangamira zvikepe.","poem":2},{"text":"Shoko rakasvika kwavari richibva","poem":1},{"text":"kunyika yeSaipurasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nyararai, imi vanhu vagere pachiwi","poem":1},{"text":"nemi vatengesi veSidhoni,","poem":2},{"lineBreak":true},{"text":"imi makapfumiswa navashambadzi vomunyanza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pamusoro pemvura","poem":1},{"text":"zhinji zviyo zveShihori zvakayambutswa;","poem":2},{"text":"mukoho weNairi ndiwo waiva pfuma yeTire,","poem":1},{"text":"uye ikazova nzvimbo yokutengesera yamarudzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nyara, iwe Sidhoni, uye newe nhare yegungwa,","poem":1},{"text":"nokuti gungwa rataura richiti,","poem":2},{"text":"“Handina kumborwadziwa kana kubereka;","poem":1},{"text":"handina kumborera vanakomana kana kukurisa vanasikana.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Panosvika shoko kuIjipiti,","poem":1},{"text":"vacharwadziwa pamusoro peshoko rinobva kuTire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yambukirai kuTashishi;","poem":1},{"text":"ungudzai, imi vanhu vagere pachiwi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ko, iri ndiro guta renyu ramafaro here,","poem":1},{"text":"guta rakare kare,","poem":2},{"text":"rakaendeswa kure kure netsoka dzaro","poem":1},{"text":"kundogara kunyika iri kure?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndianiko akarongera Tire izvozvi,","poem":1},{"text":"iro raipa korona,","poem":2},{"text":"vatengesi varo vari machinda,","poem":1},{"text":"vashambadziri varo vane mukurumbira munyika?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jehovha Wamasimba Ose akaronga izvozvo,","poem":1},{"text":"kuti adzikise kuzvikudza kwekukudzwa kwose,","poem":2},{"lineBreak":true},{"text":"uye kuti aninipise vose vane mukurumbira panyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rima nyika yako sezvinoitwa mujinga meNairi,","poem":1},{"text":"iwe mwanasikana weTashishi,","poem":2},{"lineBreak":true},{"text":"nokuti hauchina panomira zvikepe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehovha akatambanudza ruoko rwake pamusoro pegungwa,","poem":1},{"text":"uye akaita kuti ushe hwaro hudedere.","poem":2},{"text":"Akarayira pamusoro peKenani,","poem":1},{"text":"kuti nhare dzayo dziparadzwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akati, “Mafaro ako haachazovapozve,","poem":1},{"text":"iwe mhandara yeSidhoni, yaparadzwa!","poem":2},{"lineBreak":true},{"text":"“Simuka uyambukire kuSaipurasi;","poem":1},{"text":"Kunyange naikoko haundowani zororo.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tarira nyika yavaBhabhironi,","poem":1},{"text":"rudzi urwo haruchaverengwi zvino!","poem":2},{"text":"VaAsiria vakaiita","poem":1},{"text":"nzvimbo yemhuka dzerenje;","poem":2},{"text":"vakamisa shongwe dzavo dzokurwa,","poem":1},{"text":"vakakoromora nhare dzaro dzikava pasina,","poem":2},{"lineBreak":true},{"text":"uye vakarishandura rikava dongo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ungudzai, imi zvikepe zveTashishi;","poem":1},{"text":"nhare yenyu yaparadzwa!","poem":2}]},{"type":"verse","number":15,"content":["Panguva iyoyo Tire ichakanganwikwa kwamakore makumi manomwe, zvakaenzana namakore oupenyu hwamambo. Asi shure kwamakore makumi manomwe aya, Tire richaitirwa sezvinoimbwa rwiyo rwechifeve runoti:"]},{"type":"verse","number":16,"content":[{"text":"“Tora rudimbwa, ufambe nomuguta,","poem":1},{"text":"iwe chifeve chakakanganikwa;","poem":2},{"text":"ridza rudimbwa zvakanaka, imba nziyo zhinji,","poem":1},{"text":"kuitira kuti ugorangarirwa.”","poem":2}]},{"type":"verse","number":17,"content":["Panopera makore makumi manomwe, Jehovha achashanyira Tire. Richadzokerazve kubasa raro sechifeve rigofeva noushe hwose huri pamusoro penyika."]},{"type":"verse","number":18,"content":["Asi zvarakashambadzira uye nomubayiro waro zvichatsaurirwa Jehovha; hazvingachengetwi kana kuvigwa. Zvarakashambadzira zvichaendeswa kuna avo vanogara pamberi paJehovha, kuti vave nezvokudya zvakawanda nenhumbi dzakanaka."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}