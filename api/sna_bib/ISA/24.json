{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["Kuparadzwa kweNyika naJehovha"]},{"type":"verse","number":1,"content":[{"text":"Tarirai, Jehovha ari kuzoparadza nyika","poem":1},{"text":"achiiparadza zvachose;","poem":2},{"text":"achanyangadza kutarisika kwayo","poem":1},{"text":"uye achaparadzira vanogaramo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"zvichangofanana,","poem":1},{"text":"zvinoitirwa muprista nezvinoitirwa vanhu,","poem":2},{"lineBreak":true},{"text":"zvinoitirwa vatenzi nezvinoitirwa muranda,","poem":2},{"lineBreak":true},{"text":"zvinoitirwa vahosi nezvinoitirwa mushandiri,","poem":2},{"lineBreak":true},{"text":"zvinoitirwa mutengesi nezvinoitirwa mutengi,","poem":2},{"lineBreak":true},{"text":"zvinoitirwa anokwereta nezvinoitirwa akweretwa,","poem":2},{"lineBreak":true},{"text":"zvinoitirwa anoripa mhindu nezvinoitirwa anoreva mhindu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nyika ichaparadzwa zvachose","poem":1},{"text":"uye ichatorerwa zvayo zvose.","poem":2},{"text":"Jehovha ataura shoko irori.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Nyika inooma uye inosvava,","poem":1},{"text":"pasi pose panorwadziwa uye panounyana,","poem":2},{"lineBreak":true},{"text":"vanokudzwa venyika vanopera simba uye vanorwadziwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nyika inosvibiswa navanhu vayo;","poem":1},{"text":"havana kuteerera mirayiro,","poem":2},{"text":"vakapandukira mitemo","poem":1},{"text":"uye vakaputsa sungano isingaperi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naizvozvo chituko chinoparadza nyika,","poem":1},{"text":"vanhu vayo vanofanira kuzvitakurira mhosva dzavo.","poem":2},{"text":"Naizvozvo vagari vomunyika vapiswa,","poem":1},{"text":"uye vashoma ndivo vasara.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waini itsva inopera uye muzambiringa unosvava;","poem":1},{"text":"vose vanoda mafaro vanogomera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kufadza kwamakandira kwanyaradzwa,","poem":1},{"text":"kupembera kwavapururudzi kwapera,","poem":2},{"lineBreak":true},{"text":"rudimbwa rwomufaro rwanyaradzwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Havangazonwi waini vachiimba rwiyo;","poem":1},{"text":"doro rava kuvava kuvanwi varo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Guta rakoromorwa rava dongo;","poem":1},{"text":"mukova wokupinda mudzimba dzose wapfigwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vochemera waini mumigwagwa;","poem":1},{"text":"mufaro wose washanduka wava kusuwa,","poem":2},{"lineBreak":true},{"text":"mupururu wabviswa panyika.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Guta rasara rava dongo,","poem":1},{"text":"masuo aro aputswa-putswa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndizvo zvazvichaita munyika","poem":1},{"text":"napakati pendudzi,","poem":2},{"text":"zvichafanana nokuzunzwa kwomuorivhi,","poem":1},{"text":"kana sezvinosara pakunongwa shure kwegohwo ramazambiringa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Vanosimudza manzwi avo, vanopururudza nomufaro;","poem":1},{"text":"kubva kumavirira vanoparidza zvoukuru hwaJehovha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Naizvozvo kumabvazuva, mbiri kuna Jehovha;","poem":1},{"text":"kudzai zita raJehovha Mwari waIsraeri","poem":2},{"lineBreak":true},{"text":"pazviwi zvegungwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kubva kumigumo yenyika tinonzwa kuimba kunoti:","poem":1},{"text":"“Ngaakudzwe iye Akarurama.”","poem":2},{"lineBreak":true},{"text":"Asi ini ndakati, “Ndiri kupera muviri, ndiri kupera muviri!","poem":1},{"text":"Ndine nhamo!","poem":2},{"text":"Vanyengeri vakaita zvinhu nokunyengera!","poem":1},{"text":"Vanyengeri vakaita zvinhu nokunyengera kukuru!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kutya negomba zvakakumirirai,","poem":1},{"text":"imi vanhu vapanyika.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ani naani anotiza kutinhira kunotyisa,","poem":1},{"text":"achawira mugomba;","poem":2},{"text":"ani naani anokwira achibuda mugomba","poem":1},{"text":"achabatwa mumusungo.","poem":2},{"lineBreak":true},{"text":"Nokuti mawindo okudenga azaruka,","poem":1},{"text":"uye nheyo dzapanyika dzozungunuka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nyika yaputswa-putswa,","poem":1},{"text":"nyika yakamurwa napakati,","poem":2},{"lineBreak":true},{"text":"nyika yozungunuswa chose.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nyika yodzedzereka sechidhakwa,","poem":1},{"text":"inozengaira semba iri mumhepo;","poem":2},{"text":"kudarika nokumukira kwayo kwairemera kwazvo,","poem":1},{"text":"zvokuti inowa, ikasazomukazve.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Pazuva iro Jehovha acharanga masimba","poem":1},{"text":"omuchadenga kumusoro,","poem":2},{"lineBreak":true},{"text":"uye namadzimambo ari pamusoro penyika pasi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Vachaunganidzwa pamwe chete","poem":1},{"text":"kufanana navasungwa vakasungwa mugomba;","poem":2},{"text":"vachapfigirwa mutorongo","poem":1},{"text":"vagozorangwa kwamazuva mazhinji.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mwedzi uchanyadziswa, zuva richanyara;","poem":1},{"text":"nokuti Jehovha Wamasimba Ose achatonga","poem":2},{"text":"pamusoro peGomo reZioni nomuJerusarema,","poem":1},{"text":"napamberi pavakuru varo, nokubwinya kukuru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}