{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["Rumbidzo kuna Jehovha"]},{"type":"verse","number":1,"content":[{"text":"Haiwa, Jehovha ndimi Mwari wangu;","poem":1},{"text":"ndichakukudzai uye ndicharumbidza zita renyu,","poem":2},{"text":"nokuti nokutendeka kukuru","poem":1},{"text":"makaita zvinhu zvinoshamisa,","poem":2},{"lineBreak":true},{"text":"zvinhu zvamakaronga kare kare.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Makaita kuti guta rive dutu ramarara,","poem":1},{"text":"guta rakakomberedzwa rikava dongo,","poem":2},{"text":"nhare yavatorwa haichazova gutazve;","poem":1},{"text":"haichazovakwazve.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naizvozvo vanhu vane simba vachakukudzai;","poem":1},{"text":"maguta endudzi dzine utsinye achakuremekedzai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Manga muri utiziro hwavarombo,","poem":1},{"text":"utiziro hwaanoshayiwa mukutambudzika kwake,","poem":2},{"text":"uye dumba panguva yemvura zhinji","poem":1},{"text":"nomumvuri pakupisa kwezuva.","poem":2},{"text":"Nokuti kufema kwavano utsinye","poem":1},{"text":"kwakafanana nemvura zhinji inorovera parusvingo,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"uye kwakafanana nokupisa kwerenje.","poem":2},{"text":"Munonyaradza bope ravatorwa;","poem":1},{"text":"sokupisa kunotonhodzwa nomumvuri wegore,","poem":2},{"lineBreak":true},{"text":"naizvozvo rwiyo rwavane utsinye rwanyaradzwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pamusoro pegomo iri, Jehovha Wamasimba Ose achagadzirira","poem":1},{"text":"vanhu vose mutambo wezvakakora,","poem":2},{"text":"namabiko ewaini yakare,","poem":1},{"text":"nyama yakanakisa uye newaini yakaisvonaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pamusoro pegomo iri,","poem":1},{"text":"achaparadza chifukidziro chinoputira marudzi ose,","poem":2},{"text":"mucheka unofukidza ndudzi dzose;","poem":1}]},{"type":"verse","number":8,"content":[{"text":"iye achamedza rufu nokusingaperi.","poem":2},{"text":"Wamasimba Ose achapisika misodzi","poem":1},{"text":"kubva pazviso zvose;","poem":2},{"text":"achabvisa kunyadziswa kwavanhu vake","poem":1},{"text":"panyika yose.","poem":2},{"text":"Jehovha ataura.","poem":4}]},{"type":"verse","number":9,"content":["Pazuva iro vachati,",{"text":"“Zvirokwazvo uyu ndiye Mwari wedu;","poem":1},{"text":"takavimba naye, iye akatiponesa.","poem":2},{"text":"Uyu ndiye Jehovha, takavimba naye;","poem":1},{"text":"ngatifarei tifarisise muruponeso rwake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ruoko rwaJehovha ruchagara pagomo iri,","poem":1},{"text":"asi Moabhu achatsikwa-tsikwa pasi pake,","poem":2},{"lineBreak":true},{"text":"samashanga anotsikwa-tsikwa mumupfudze.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vachatambanudza maoko avo mariri,","poem":1},{"text":"somushambiri anotambanudza maoko ake kuti ashambire.","poem":2},{"text":"Mwari achaderedza kuzvikudza kwavo,","poem":1},{"text":"kunyange vachigona kuita zvakanaka namaoko avo,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Achakoromora nhare yako yamasvingo","poem":1},{"text":"akakwirira agoaputsira pasi;","poem":2},{"text":"achaakoromorera pasi,","poem":1},{"text":"muguruva chaimo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}