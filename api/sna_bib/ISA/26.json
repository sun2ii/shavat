{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Rwiyo rwoKurumbidza"]},{"type":"verse","number":1,"content":["Pazuva iro rwiyo urwu ruchaimbwa munyika yaJudha:",{"text":"Tine guta rakasimba;","poem":1},{"text":"Mwari anoita kuti ruponeso","poem":2},{"lineBreak":true},{"text":"ruve masvingo nenhare dzaro.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zarurai masuo kuti rudzi","poem":1},{"text":"rwakarurama rupinde,","poem":2},{"lineBreak":true},{"text":"rudzi runochengeta kutenda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muchachengeta murugare","poem":1},{"text":"rwakakwana munhu ane mufungo wakasimba,","poem":2},{"lineBreak":true},{"text":"nokuti anovimba nemi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vimba naJehovha nokusingaperi,","poem":1},{"text":"nokuti Jehovha, iye Jehovha ndiye Dombo rokusingaperi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anoderedza avo vagere pakakwirira,","poem":1},{"text":"anodzikisa pasi guta rapamusoro;","poem":2},{"text":"anorideredza kusvikira pavhu","poem":1},{"text":"uye anorikanda muguruva.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsoka dzicharitsikirira pasi,","poem":1},{"text":"tsoka dzavakamanikidzwa,","poem":2},{"lineBreak":true},{"text":"idzo tsoka dzavarombo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nzira yavakarurama yakati chechetere;","poem":1},{"text":"imi Akarurama, munoita kuti nzira yavakarurama iti chechetere.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hongu, Jehovha tichifamba munzira yomurayiro wenyu,","poem":1},{"text":"tinokumirirai;","poem":2},{"text":"zita renyu nemukurumbira","poem":1},{"text":"wenyu ndizvo chishuwo chemwoyo yedu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwoyo wangu unokushuvai pausiku;","poem":1},{"text":"mangwanani, mweya wangu unokupangai.","poem":2},{"text":"Kutonga kwenyu pakunouya panyika,","poem":1},{"text":"vanhu vanogara panyika vanodzidza zvokururama.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kunyange nyasha dzichiratidzwa kuna vakaipa, ivo havadzidzi kururama;","poem":1},{"text":"kunyange munyika yokururama,","poem":2},{"text":"vanongoramba vachiita zvakaipa,","poem":1},{"text":"uye havana hanya noukuru hwaJehovha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haiwa Jehovha, ruoko rwenyu rwakasimudzirwa kumusoro,","poem":1},{"text":"asi havaruoni.","poem":2},{"text":"Ngavaone kushingaira kwenyu pamusoro pavanhu venyu vagonyadziswa;","poem":1},{"text":"moto wakachengeterwa vavengi venyu ngauvaparadze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jehovha, imi munotigadzirira rugare;","poem":1},{"text":"zvose zvatakakwanisa ndimi makatiitira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Haiwa Jehovha Mwari wedu, mamwe madzishe kunze kwenyu akatitonga,","poem":1},{"text":"asi zita renyu ndiro ratinokudza chete.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ivo vakafa zvino, havachararamizve;","poem":1},{"text":"mweya yavakafa haimuki.","poem":2},{"text":"Makavaranga mukavaparadza;","poem":1},{"text":"makabvisa chirangaridzo chavo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Makakurisa rudzi, imi Jehovha;","poem":1},{"text":"makakurisa rudzi.","poem":2},{"text":"Makazviwanira mukurumbira;","poem":1},{"text":"mukakurisa miganhu yose yenyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Jehovha, vakauya kwamuri mumatambudziko avo;","poem":1},{"text":"pamakavarova,","poem":2},{"lineBreak":true},{"text":"havana kugona kuzevezera munyengetero.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sezvinoita mukadzi ane mimba oda kusununguka,","poem":1},{"text":"anomonyoroka mukurwadziwa kwake, agochema kwazvo,","poem":2},{"lineBreak":true},{"text":"ndizvo zvatakanga takaita pamberi penyu, imi Jehovha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Takanga tine mimba, tichimonyoroka mukurwadziwa,","poem":1},{"text":"asi takabereka mhepo.","poem":2},{"text":"Hatina kuvigira nyika ruponeso;","poem":1},{"text":"hatina chatakaberekera vanhu venyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Asi vakafa venyu vachararama;","poem":1},{"text":"miviri yavo ichamuka.","poem":2},{"text":"Imi mugere muguruva,","poem":1},{"text":"mukai mupembere.","poem":2},{"text":"Dova renyu rakaita sedova ramangwanani;","poem":1},{"text":"nyika ichabudisa vakafa vayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Chiendai, vanhu vangu,","poem":1},{"text":"pindai mumakamuri enyu,","poem":2},{"text":"mugopfiga mikova shure kwenyu;","poem":1},{"text":"muvande kwechinguva kusvikira kutsamwa kwake kwapfuura.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tarirai, Jehovha ari kubuda muugaro hwake,","poem":1},{"text":"kuti arange vanhu venyika nokuda kwezvivi zvavo.","poem":2},{"text":"Nyika ichafukura ropa rakateurwa pamusoro payo;","poem":1},{"text":"haichazovanzizve vakaurayiwa vayo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}