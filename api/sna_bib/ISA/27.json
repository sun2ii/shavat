{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["Kusunungurwa kwaIsraeri"]},{"type":"verse","number":1,"content":["Pazuva iro,",{"text":"Jehovha acharanga nomunondo wake,","poem":1},{"text":"iwo munondo wake mukuru une simba uye unotyisa,","poem":2},{"text":"Revhiatani nyoka inokurumidza,","poem":1},{"text":"Revhiatani nyoka inogonyana;","poem":2},{"text":"achauraya chikara chomugungwa.","poem":1}]},{"type":"verse","number":2,"content":["Pazuva iro,",{"text":"“Imbai nezvomuzambiringa unobereka:","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Ini Jehovha ndini ndinouchengeta;","poem":2},{"lineBreak":true},{"text":"ndinoramba ndichiudiridzira.","poem":2},{"text":"Ndinourinda masikati nousiku","poem":1},{"text":"kuitira kuti parege kuva neanoukanganisa.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Handina kutsamwa.","poem":2},{"text":"Dai paingova nerukato neminzwa zvinorwa neni!","poem":1},{"text":"Ndaienda kundorwa nazvo;","poem":2},{"lineBreak":true},{"text":"ndaizvipisa zvose nomoto.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kana kuti ngazviuye zvizovanda kwandiri;","poem":1},{"text":"ngazviyanane neni, hongu, ngazviyanane neni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mumazuva anouya, Jakobho achadzika midzi,","poem":1},{"text":"Israeri achabukira uye achatunga maruva,","poem":2},{"lineBreak":true},{"text":"agozadza nyika yose nomuchero,","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ko, Jehovha akamurova here","poem":1},{"text":"sezvaanorova avo vakamurova?","poem":2},{"text":"Akaurayiwa here","poem":1},{"text":"sokuurayiwa kwakaitwa avo vakamuuraya?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Muhondo makarwa naye mukamudzinga,","poem":1},{"text":"nokurwisa kwake kunotyisa akamudzinga,","poem":2},{"lineBreak":true},{"text":"sezvinoitika pazuva rinovhuvhuta mhepo yokumabvazuva.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zvino nenzira iyi, mhosva yaJakobho ichadzikinurwa,","poem":1},{"text":"uye izvi zvichava chibereko chakazara chokubviswa kwechivi chake:","poem":2},{"text":"Paanoita kuti aritari dzose dzifanane namabwe omunyaka akaputswa-putswa,","poem":1},{"text":"hapana matanda aAshera kana aritari dzezvinonhuhwira zvichasiyiwa zvakamira.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Guta rakakomberedzwa norusvingo rasiyiwa rava dongo,","poem":1},{"text":"hwava ugaro hwakasiyiwa,","poem":2},{"text":"kufanana nerenje;","poem":1},{"text":"mhuru dzofura ikoko, uye ikoko ndiko kwadzinovata;","poem":2},{"lineBreak":true},{"text":"dzinosiya matavi asisina chinhu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Panooma matavi acho, anovhuniwa,","poem":1},{"text":"uye vakadzi vanouya vovesa moto nawo.","poem":2},{"text":"Nokuti vanhu ava havana njere;","poem":1},{"text":"nokudaro Muiti wavo haachina tsitsi pamusoro pavo,","poem":2},{"lineBreak":true},{"text":"uye Musiki wavo haangavaitiri nyasha.","poem":2}]},{"type":"verse","number":12,"content":["Pazuva iro Jehovha achapura kubva panoyerera Yufuratesi kusvikira paRukova rweIjipiti, uye imi vaIsraeri, muchaunganidzwa muchiita mumwe mumwe."]},{"type":"verse","number":13,"content":["Uye pazuva iro hwamanda huru icharira. Vakanga vofira muAsiria uye navaya vakanga vatizira kuIjipiti vachauya kuzonamata Jehovha pamusoro pegomo dzvene riri muJerusarema."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}