{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["Nhamo kuna Efuremu"]},{"type":"verse","number":1,"content":[{"text":"Ine nhamo korona yokuzvikudza, yezvidhakwa zveEfuremu,","poem":1},{"text":"neruva rosvava pakubwinya kworunako rwaro,","poem":2},{"text":"riri pamusoro pemipata yakaorera","poem":1},{"text":"yaavo vakurirwa newaini!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tarira, Ishe ano mumwe ane simba uye anokurira.","poem":1},{"text":"Sechimvuramabwe uye nedutu rinoparadza,","poem":2},{"text":"sedutu remvura zhinji uye samafashamu emvura inonaya,","poem":1},{"text":"achaiwisira pasi nesimba guru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iya korona, yokuzvikudza yezvidhakwa zveEfuremu,","poem":1},{"text":"ichatsikwa-tsikwa pasi petsoka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ruva riya rosvava pakubwinya kworunako rwaro,","poem":1},{"text":"riri pamusoro pomupata wakaorera, richafanana neonde raibva gohwo risati rasvika,","poem":2},{"lineBreak":true},{"text":"munhu achingoriona, anoritanha noruoko rwake,","poem":2},{"lineBreak":true},{"text":"obva aridya pakarepo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pazuva iro Jehovha Wamasimba Ose achava korona inobwinya,","poem":1},{"text":"chishongo chakanaka chavanhu vake vakasara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Achava mweya wokururamisira","poem":1},{"text":"kuna iye anogara pakutonga,","poem":2},{"text":"chitubu chesimba kuna avo","poem":1},{"text":"vanodzosera shure vanorwa pasuo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ivavawo vanodzedzereka newaini","poem":1},{"text":"uye vanozengaira nedoro:","poem":2},{"text":"Vaprista navaprofita vanodzedzereka nedoro,","poem":1},{"text":"uye vanonyonganiswa newaini;","poem":2},{"text":"vanozengaira nedoro,","poem":1},{"text":"vanodzedzereka pavanoona zviratidzo,","poem":2},{"lineBreak":true},{"text":"vanogumburwa pakutonga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tafura dzose dzazara marutsi","poem":1},{"text":"uye hapachina nzvimbo isina tsvina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ndianiko waachadzidzisa ruzivo?","poem":1},{"text":"Ndianiko waanotsanangurira shoko?","poem":2},{"text":"Kuvana vakarumurwa pamukaka,","poem":1},{"text":"kuna avo vachangobva pazamu here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nokuti zvinoti:","poem":1},{"text":"Chirevo pamusoro pechirevo, chirevo pamusoro pechirevo,","poem":2},{"lineBreak":true},{"text":"mutsara pamusoro pomutsara, mutsara pamusoro pomutsara,","poem":2},{"lineBreak":true},{"text":"apa zvishoma, apo zvishoma.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Zvirokwazvo, Mwari achataura kurudzi urwu nemitauro yavatorwa,","poem":1},{"text":"nendimi dzokumwe,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kwavari akati, “Iyi ndiyo nzvimbo yokuzorora,","poem":1},{"text":"vakaneta ngavazorore,”","poem":2},{"text":"uye, “Iyi ndiyo nzvimbo yorunyararo,”","poem":1},{"text":"asi havana kumboteerera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Saka zvino, shoko raJehovha kwavari richava:","poem":1},{"text":"Chirevo pamusoro pechirevo, chirevo pamusoro pechirevo,","poem":2},{"lineBreak":true},{"text":"mutsara pamusoro pomutsara, mutsara pamusoro pomutsara,","poem":2},{"lineBreak":true},{"text":"apa zvishoma, apo zvishoma,","poem":2},{"text":"kuitira kuti vaende vagondowa, vavhunike,","poem":1},{"text":"vabatwe nomusungo vagotapwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Naizvozvo inzwai shoko raJehovha, imi vaseki,","poem":1},{"text":"imi vanotonga rudzi urwu muJerusarema.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Munozvirumbidza muchiti, “Takaita sungano norufu,","poem":1},{"text":"takatenderana neguva.","poem":2},{"text":"Shamhu inokukura painouya,","poem":1},{"text":"haizotibati,","poem":2},{"text":"nokuti nhema takadziita utiziro hwedu,","poem":1},{"text":"uye kunyengera takakuita nzvimbo yedu yokuvanda.”","poem":2}]},{"type":"verse","number":16,"content":["Saka zvanzi naJehovha Wamasimba Ose:",{"text":"“Tarirai ndinoisa ibwe muZioni,","poem":1},{"text":"ibwe rakaedzwa,","poem":2},{"text":"ibwe rinokosha rapakona kuti rive nheyo yakasimba;","poem":1},{"text":"anovimba naro haangavhunduki.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndichaita kuti kururamisira kuve rwodzi rwokururamisira,","poem":1},{"text":"uye kururama ndichakuita chokururamisa nacho;","poem":2},{"text":"chimvuramabwe chichakukura utiziro hwenyu, idzo nhema,","poem":1},{"text":"uye mvura ichafukidza nzvimbo yenyu yokuvanda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sungano yenyu norufu ichadzimwa;","poem":1},{"text":"chitenderano chenyu neguva hachingamiri.","poem":2},{"text":"Shamhu inokukura painouya,","poem":1},{"text":"muchakundwa nayo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nguva nenguva painouya ichakutakurai ichikuendesai kure;","poem":1},{"text":"mangwanani achitevera mamwe mangwanani, panguva dzamasikati nenguva dzousiku,","poem":2},{"lineBreak":true},{"text":"ichakukura.”","poem":2},{"lineBreak":true},{"text":"Kunzwisisa shoko iri","poem":1},{"text":"kuchauyisa kutya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nokuti mubhedha uchava mupfupi pakutandavara,","poem":1},{"text":"uye jira richava diki zvokuti munhu haangagoni kufukidzwa naro.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nokuti Jehovha achasimuka sezvaakaita paGomo rePerazimi,","poem":1},{"text":"achatsamwa sezvaakaita muMupata weGibheoni,","poem":2},{"text":"kuti aite basa rake, iro basa risinganzwisisiki,","poem":1},{"text":"uye azadzise basa rake, basa risinganzwisisiki.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Zvino chiregai kudada kwenyu,","poem":1},{"text":"nokuti ngetani dzenyu dzichanyanya kukuremerai;","poem":2},{"text":"Ishe, iye Jehovha Wamasimba Ose,","poem":1},{"text":"andiudza pamusoro pokuparadzwa kwakatemwa pamusoro penyika yose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Teererai uye munzwe inzwi rangu;","poem":1},{"text":"rerekai nzeve dzenyu munzwe zvandinoreva.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Murimi paanorimira kuti agodyara, anoramba achingorima here?","poem":1},{"text":"Ko, anoramba achingorima kana kuhara here?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Paanoenzanisa munda wake kuti uti chechetere,","poem":1},{"text":"haangadyari karawe uye agokusha kumini here?","poem":2},{"text":"Haangadyari gorosi munzvimbo yaro,","poem":1},{"text":"nebhari mumunda wayo,","poem":2},{"lineBreak":true},{"text":"nesipereti mumunda wayo here?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nokuti Mwari wake anomurayiridza","poem":1},{"text":"uye achamudzidzisa nzira yakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Karawe haipurwi nechireyi,","poem":1},{"text":"uye vhiri rengoro harikunguruswi pamusoro pekumini;","poem":2},{"text":"karawe inopurwa nemhuro","poem":1},{"text":"uye kumini inopurwa norumuti.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Zviyo zvinofanira kukuyiwa kuti zviitiswe chingwa;","poem":1},{"text":"saka munhu haafaniri kuramba achingopura nokusingaperi.","poem":2},{"text":"Kunyange achifambisa mavhiri engoro yake","poem":1},{"text":"yokupura pamusoro pazvo, mabhiza ake haazvikuyi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Izvi zvose zvinobvawo kuna Jehovha Wamasimba Ose,","poem":1},{"text":"anoshamisa mukurayira uye mukuru kwazvo muuchenjeri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}