{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["Nhamo kuGuta raDhavhidhi"]},{"type":"verse","number":1,"content":[{"text":"Une nhamo iwe Arieri, Arieri,","poem":1},{"text":"guta raigara Dhavhidhi!","poem":2},{"text":"Wedzera gore pagore;","poem":1},{"text":"uye regai nguva dzemitambo yenyu dzirambe dziripo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kunyange zvakadaro, ndichakomba Arieri;","poem":1},{"text":"pachava nokuungudza uye nokuchema,","poem":2},{"lineBreak":true},{"text":"richafanana nechoto chearitari kwandiri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndichakukomba kumativi ose;","poem":1},{"text":"ndichakukomberedza neshongwe","poem":2},{"lineBreak":true},{"text":"uye ndichavaka nhare dzokurwa newe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uchadzikisirwa pasi, uchataura uri pasi;","poem":1},{"text":"kutaura kwako kuchabva muguruva.","poem":2},{"text":"Inzwi rako richava seresvikiro rinobva pasi muvhu;","poem":1},{"text":"kutaura kwako kuchaita zevezeve kuchibva muguruva.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asi vavengi vako vazhinji vachava seguruva rakatsetseka,","poem":1},{"text":"vane utsinye vachafanana nehundi inopepereswa.","poem":2},{"text":"Pakarepo, nokukurumidza","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Jehovha Wamasimba Ose achauya","poem":2},{"text":"nokutinhira nokudengenyeka kwenyika, uye nemheremhere huru,","poem":1},{"text":"nechamupupuri, nedutu guru uye nomurazvo womoto unoparadza zvose.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ipapo mhomho dzendudzi dzose dzakawanda dzinorwa neArieri,","poem":1},{"text":"dzinorirwisa iro nenhare dzaro uye dzinorikomba,","poem":2},{"text":"zvichaita sokurota,","poem":1},{"text":"nechiratidzo chinoonekwa usiku,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"sezvinoitwa nomunhu ane nzara anorota achidya,","poem":1},{"text":"asi apepuka, anowana nzara yake ichiripo;","poem":2},{"text":"sezvinoita munhu ane nyota anorota achinwa mvura,","poem":1},{"text":"asi omuka achiziya, nyota yake isina kupera.","poem":2},{"text":"Naizvozvo ndizvo zvichaitawo marudzi ose akawanda","poem":1},{"text":"anorwa neGomo reZioni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Katyamarai uye mushamiswe,","poem":1},{"text":"zvipofumadzei muve vasingaoni;","poem":2},{"text":"dhakwai asi kwete newaini;","poem":1},{"text":"dzedzerekai asi kwete nedoro.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jehovha akauyisa pamusoro penyu hope huru;","poem":1},{"text":"Akafukidza meso enyu, vaprofita;","poem":2},{"lineBreak":true},{"text":"akafukidza misoro yenyu, vaoni.","poem":2}]},{"type":"verse","number":11,"content":["Nokuti kwamuri, chiratidzo ichi hachizi chinhu asi mashoko akanamirwa murugwaro. Uye kana mukapa rugwaro kuno mumwe munhu anogona kuverenga, mukati kwaari, “Ndapota, verenga izvi,” achapindura achiti, “Handikwanisi, nokuti rwakanamirwa.”"]},{"type":"verse","number":12,"content":["Kana kuti mukapa rugwaro kuno mumwe asingagoni kuverenga, mukati kwaari, “Ndapota, verenga izvi,” achapindura achiti, “Handigoni kuverenga.”"]},{"type":"verse","number":13,"content":["Ishe anoti:",{"text":"“Vanhu ava vanoswedera kwandiri nemiromo yavo,","poem":1},{"text":"uye vanondikudza nemiromo yavo,","poem":2},{"lineBreak":true},{"text":"asi mwoyo yavo iri kure neni.","poem":2},{"text":"Kundinamata kwavo","poem":1},{"text":"kwangova kwemitemo inodzidziswa navanhu chete.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Naizvozvo ndichashamisa vanhu ava zvakare","poem":1},{"text":"nechishamiso pamusoro pechishamiso;","poem":2},{"text":"uchenjeri hwavakachenjera huchaparadzwa,","poem":1},{"text":"zivo yavane zivo ichapera.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vane nhamo avo vanosvika kwakadzika dzika","poem":1},{"text":"kuti vavanzire Jehovha mano avo,","poem":2},{"text":"vanoita mabasa avo murima vachifunga mumwoyo yavo kuti,","poem":1},{"text":"“Ndiani anotiona? Ndiani achaziva?”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Munoshandura mamiriro ezvinhu,","poem":1},{"text":"sezvinonzi muumbi wehari anonzi ndiye ivhu!","poem":2},{"text":"Ko, chakaumbwa chingati kuna iye akachiumba,","poem":1},{"text":"“Iye haana kundiita?”","poem":2},{"text":"Ko, hari ingati kumuumbi,","poem":1},{"text":"“Iye haana chaanoziva?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ko, Rebhanoni haingashandurwi ikava munda wakaorera muchinguva chidiki,","poem":1},{"text":"uye munda wakaorera ugoita kunge dondo?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pazuva iro vanamati vachanzwa shoko rorugwaro,","poem":1},{"text":"uye meso amapofu achaona","poem":2},{"lineBreak":true},{"text":"ari pakasviba naparima.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zvakare vanozvininipisa vachafara muna Jehovha;","poem":1},{"text":"vanoshayiwa vachafara muMutsvene waIsraeri.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Vane utsinye vachaparadzwa,","poem":1},{"text":"vaseki vachanyangarika,","poem":2},{"lineBreak":true},{"text":"uye vose vane ziso rinofarira zvakaipa vachaurayiwa,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"avo vanopomera munhu mhosva neshoko chete,","poem":1},{"text":"vanoisira musungo kuna anoruramisira mudare,","poem":2},{"lineBreak":true},{"text":"uye nouchapupu hwenhema, vanokonesa kururamisirwa kwavasina mhosva.","poem":2}]},{"type":"verse","number":22,"content":["Naizvozvo izvi ndizvo zvinotaura Jehovha, akadzikinura Abhurahama, achiti kuimba yaJakobho:",{"text":"“Jakobho haachazonyadziswizve;","poem":1},{"text":"zviso zvavo hazvichazocheneruki.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Pavachaona vana vavo pakati pavo,","poem":1},{"text":"iro basa ramaoko angu,","poem":2},{"text":"vachachengeta zita rangu muutsvene;","poem":1},{"text":"vachaziva utsvene hwoMutsvene waJakobho,","poem":2},{"lineBreak":true},{"text":"uye vachamira vachitya Mwari waIsraeri.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Vakarasika pamweya vachawana njere;","poem":1},{"text":"vanonyunyuta vachagamuchira kurayirwa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}