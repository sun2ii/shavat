{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Kutongwa kweJerusarema neJudha"]},{"type":"verse","number":1,"content":[{"text":"Tarirai zvino, Ishe Jehovha","poem":1},{"text":"Wamasimba Ose","poem":2},{"text":"ava kuda kutora zvose rutsigiro nomudonzvo,","poem":1},{"text":"kubva kuJerusarema neJudha;","poem":2},{"text":"rutsigiro rwose rwezvokudya norutsigiro rwose rwemvura,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"mhare nomurwi,","poem":2},{"text":"mutongi nomuprofita,","poem":1},{"text":"muvuki nomukuru,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"mukuru wamakumi mashanu nomunhu anokudzwa,","poem":1},{"text":"gurukota nomurume weumhizha, nomuvuki anoziva.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndichaita kuti majaya ave vabati vavo;","poem":1},{"text":"vana vadiki ndivo vachavatonga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vanhu vachadzvinyirirana,","poem":1},{"text":"munhu nomunhu, muvakidzani nomuvakidzani.","poem":2},{"text":"Vadiki vachamukira vakuru,","poem":1},{"text":"nounozvidza achamukira anokudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Murume achabata mumwe wavanunʼuna vake","poem":1},{"text":"paimba yababa vake achiti,","poem":2},{"text":"“Ndiwe une nguo, chiva mutungamiri wedu;","poem":1},{"text":"iva mutariri wedutu roungwandangwanda uhu!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asi pazuva iro achadanidzira achiti,","poem":1},{"text":"“Handigoni kugadzirisa zvinhu.","poem":2},{"text":"Handina chokudya kana chokufuka mumba mangu;","poem":1},{"text":"musandiita mutungamiri wavanhu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jerusarema rozungunuka,","poem":1},{"text":"Judha riri kuwa;","poem":2},{"text":"mashoko avo nezviito zvavo zvinopesana naJehovha,","poem":1},{"text":"vachizvidza kuvapo kwake kunobwinya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zvinoonekwa pazviso zvavo zvinovapupurira;","poem":1},{"text":"vanoburitsa chivi chavo pachena seSodhomu;","poem":2},{"lineBreak":true},{"text":"havambochivanzi.","poem":2},{"text":"Vane nhamo!","poem":1},{"text":"Vanouyisa njodzi pamusoro pavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Udzai vakarurama kuti zvichavanakira,","poem":1},{"text":"nokuti vachanakirwa nezvibereko zvamabasa avo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vane nhamo vakaipa! Njodzi yava kuda kuvawira!","poem":1},{"text":"Vacharipirwa zvakabatwa namaoko avo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Vadiki vanomanikidza vanhu vangu,","poem":1},{"text":"vakadzi vanovatonga.","poem":2},{"text":"Haiwa, vanhu vangu, vatungamiri venyu vanokutsausai;","poem":1},{"text":"vanokubvisai munzira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Jehovha anotora nzvimbo yake muimba yokutonga;","poem":1},{"text":"anosimuka kuti atonge vanhu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jehovha anopinda mukutonga vakuru","poem":1},{"text":"navatungamiri vavanhu vake achiti,","poem":2},{"text":"“Ndimi makaparadza munda wangu womuzambiringa;","poem":1},{"text":"zvakapambwa zvinobva kuvarombo zviri mudzimba dzenyu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Munoreveiko zvamunopwanya vanhu vangu,","poem":1},{"text":"uye muchikuya zviso zvavarombo?”","poem":2},{"text":"ndizvo zvinotaura Ishe Jehovha Wamasimba Ose.","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Jehovha anoti,","poem":1},{"text":"“Vakadzi veZioni vanozvikudza,","poem":2},{"text":"vanofamba vakamisa mitsipa yavo.","poem":1},{"text":"Vachichonya nameso avo,","poem":2},{"text":"uye vanofamba vachinzenzeta,","poem":1},{"text":"vaine zvishongo zvinorira muzviziso zvamakumbo avo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naizvozvo Jehovha achauyisa maronda pamisoro yavakadzi veZioni;","poem":1},{"text":"Jehovha achaitisa misoro yavo mhanza.”","poem":2}]},{"type":"verse","number":18,"content":["Pazuva iro Jehovha achabvisa pazviziso zvamakumbo avo: mabhenguro, nezvishongo zvomusoro, neungetani hwomutsipa hunonʼaima,"]},{"type":"verse","number":19,"content":["nemhete dzenzeve, nezvingetani zvomumaoko, namavhoiri"]},{"type":"verse","number":20,"content":["nezvishongo zvebvudzi, nezvingetani zvomuzviziso zvamakumbo, nemasikavha, namabhodhoro amafuta anonhuhwira, namazango,"]},{"type":"verse","number":21,"content":["nemhete, noukomba hwemhino,"]},{"type":"verse","number":22,"content":["nenguo dzakanaka dzomutambo, nezvijasi, namakepesi namajasi nezvikwama,"]},{"type":"verse","number":23,"content":["nezvionioni, nenguo dzomucheka wakaisvonaka, nezvishongo namashaweri."]},{"type":"verse","number":24,"content":[{"text":"Pachinzvimbo chezvinonhuhwira, pachava nokunhuhwa;","poem":1},{"text":"pachinzvimbo chesikavha, pachava netambo;","poem":2},{"text":"pachinzvimbo chebvudzi rakashongedzwa zvakanaka,","poem":1},{"text":"pachava nemhanza; pachinzvimbo chembatya dzakaisvonaka, pachava nechipfeko chesaga;","poem":2},{"lineBreak":true},{"text":"pachinzvimbo chorunako, pachava nokupiswa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Varume venyu vachafa nomunondo,","poem":1},{"text":"varwi venyu vachafa muhondo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Masuo eZioni achachema uye achaungudza;","poem":1},{"text":"nokutambura kwaro, richagara pasi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}