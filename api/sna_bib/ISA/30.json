{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":30,"content":[{"type":"heading","content":["Rune Nhamo Rudzi Rwakasindimara"]},{"type":"verse","number":1,"content":[{"text":"“Vane nhamo vana vakasindimara,”","poem":1},{"text":"ndizvo zvinotaura Jehovha,","poem":2},{"text":"“kuna avo vanoita urongwa husati huri hwangu,","poem":1},{"text":"vanoita sungano, asi vasingaiti noMweya wangu,","poem":2},{"lineBreak":true},{"text":"vachiunganidza chivi pamusoro pechivi;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"vanoenda kuIjipiti","poem":1},{"text":"vasina kundibvunza;","poem":2},{"text":"vanotsvaka rubatsiro rworudziviriro rwaFaro,","poem":1},{"text":"vanotsvaka utiziro kumumvuri weIjipiti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asi kudzivirira kwaFaro kuchava kunyadziswa kwenyu,","poem":1},{"text":"mumvuri weIjipiti uchakuvigirai kunyadziswa,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kunyange vaine machinda muZoani","poem":1},{"text":"uye nhume dzavo dzasvika muHanesi,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"mumwe nomumwe wavo achanyadziswa","poem":1},{"text":"nokuda kwavanhu vasina betsero kwavari,","poem":2},{"text":"vasingavavigiri rubatsiro kana ruyamuro,","poem":1},{"text":"asi kunyadziswa chete nokuzvidzwa.”","poem":2}]},{"type":"verse","number":6,"content":["Chirevo pamusoro pemhuka dzeNegevhi:",{"text":"nomunyika yenhamo namatambudziko,","poem":1},{"text":"yeshumba neshumbakadzi,","poem":2},{"lineBreak":true},{"text":"yemvumbi nenyoka dzine hasha uye dzinobhururuka,","poem":2},{"text":"nhume dzinotakura pfuma yadzo pamusoro pembongoro,","poem":1},{"text":"noupfumi hwadzo pamusoro penyundwa dzengamera,","poem":2},{"text":"dzichihuendesa kurudzi rusingabatsiri,","poem":1}]},{"type":"verse","number":7,"content":[{"text":"kuIjipiti kuno rubatsiro rusina maturo chose.","poem":2},{"text":"Naizvozvo ndinomutumidza zita rokuti","poem":1},{"text":"Rahabhi Asina Chaanoita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Chienda iye zvino, unovanyorera pahwendefa izvozvo,","poem":1},{"text":"uzvinyore murugwaro,","poem":2},{"text":"kuti pamazuva anouya","poem":1},{"text":"chigova chapupu nokusingaperi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ava ndivo vanhu vakapanduka, vana vokunyengera,","poem":1},{"text":"vana vasingadi kunzwa kurayira kwaJehovha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vanoti kuvaoni,","poem":1},{"text":"“Regai kuonazve zviratidzo!”","poem":2},{"text":"nokuvaprofita,","poem":1},{"text":"“Regai kutipazve zviratidzo zvezvakanaka!","poem":2},{"text":"Tiudzei zvinhu zvinofadza,","poem":1},{"text":"muprofite zvinonyengera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Siyai nzira iyi,","poem":1},{"text":"ibvai mugwara iri,","poem":2},{"text":"murege kuita kuti timisidzane","poem":1},{"text":"noMutsvene waIsraeri!”","poem":2}]},{"type":"verse","number":12,"content":["Naizvozvo zvanzi naMutsvene waIsraeri:",{"text":"“Nokuti makaramba shoko rangu iri,","poem":1},{"text":"mukasendamira pakumanikidza","poem":2},{"lineBreak":true},{"text":"uye mukavimba nokunyengera,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"chivi ichi chichava kwamuri","poem":1},{"text":"sorusvingo, rwakatsemuka nokufutunuka,","poem":2},{"lineBreak":true},{"text":"runoondomoka pakarepo uye nokukurumidza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ruchaputsika kuita zvimedu zvimedu sehari,","poem":1},{"text":"yakaputswa noutsinye","poem":2},{"lineBreak":true},{"text":"zvokuti pakati pezvimedu zvayo hapana kuwanikwa chaenga chakasara,","poem":2},{"lineBreak":true},{"text":"chokugoka mazimbe omoto pachoto","poem":2},{"lineBreak":true},{"text":"kana chokuchera nacho mvura kubva muchitubu.”","poem":2}]},{"type":"verse","number":15,"content":["Zvanzi naIshe Jehovha, Mutsvene waIsraeri:",{"text":"“Mukutendeuka nezororo ndimo mune ruponeso rwenyu,","poem":1},{"text":"murunyararo nomukuvimba ndimo mune simba renyu,","poem":2},{"lineBreak":true},{"text":"asi imi makaramba chimwe chazvo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Imi makati, ‘Kwete, tichatiza takatasva mabhiza.’","poem":1},{"text":"Naizvozvo muchatiza!","poem":2},{"text":"Imi makati, ‘Tichatasva mabhiza anomhanya kwazvo.’","poem":1},{"text":"Naizvozvo vadzinganisi venyu vachamhanya kwazvo!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Chiuru chimwe chete chichatiza","poem":1},{"text":"nokuvhundutsa kwomumwe chete;","poem":2},{"text":"imi mose muchatiza","poem":1},{"text":"kuvhundutsa kwavashanu,","poem":2},{"text":"kusvikira masara","poem":1},{"text":"maita sedanda romureza riri pamusoro pegomo,","poem":2},{"lineBreak":true},{"text":"kuita somureza pamusoro pechikomo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Asi Jehovha anoshuva kukuitirai nyasha;","poem":1},{"text":"anosimuka kuti akuratidzei tsitsi.","poem":2},{"text":"Nokuti Jehovha ndiMwari wokururamisira.","poem":1},{"text":"Vakaropafadzwa vose vanomurindira!","poem":2}]},{"type":"verse","number":19,"content":["Haiwa imi vanhu veZioni, vanogara muJerusarema, hamuchazochemizve. Achava nenyasha sei pamunochemera rubatsiro! Achingozvinzwa, achakupindurai."]},{"type":"verse","number":20,"content":["Kunyange Ishe achikupai chingwa chenhamo nemvura yokutambudzika, vadzidzi venyu havachazovanzwizve; muchavaona nameso enyu pachenyu."]},{"type":"verse","number":21,"content":["Kunyange mukatendeukira kurudyi kana kuruboshwe, nzeve dzenyu dzichanzwa inzwi mumashure menyu, richiti, “Iyi ndiyo nzira, fambai mairi.”"]},{"type":"verse","number":22,"content":["Ipapo muchasvibisa zvifananidzo zvenyu zvakafukidzwa nesirivha nezviumbwa zvenyu zvakafukidzwa negoridhe; muchazvirasira kure somucheka wakasvibiswa neropa romukadzi ari kumwedzi kwake muchiti kwazviri, “Ibvai pano!”"]},{"type":"verse","number":23,"content":["Achakutumiraiwo mvura yokumeresa mbeu dzamunodyara muvhu, uye zvokudya zvichabva munyika zvichange zvakanyatsosvika uye zvakawanda kwazvo. Pazuva iro, nzombe dzenyu dzichafura mumafuro akafaranuka."]},{"type":"verse","number":24,"content":["Nzombe nembongoro dzinorima munda zvichadya mashanga noupfu, zvakaparadzirwa neforogo nefoshoro."]},{"type":"verse","number":25,"content":["Pazuva rokuuraya kukuru, panowira shongwe pasi, hova dzemvura dzichayerera pamusoro pamakomo ose akakwirira napamusoro pezvikomo zvakareba."]},{"type":"verse","number":26,"content":["Mwedzi uchapenya sezuva, uye zuva richapenya kakapetwa kanomwe, kufanana nechiedza chamazuva manomwe azere, Jehovha paanosunga mavanga avanhu vake agorapa maronda aakavakuvadza nawo."]},{"type":"verse","number":27,"content":[{"text":"Tarirai, Zita raJehovha rasvika richibva kure,","poem":1},{"text":"rine hasha dzinopfuta moto namakore outsi hwakasviba kuti ndo-o;","poem":2},{"text":"miromo yake yakazara nokutsamwa,","poem":1},{"text":"uye rurimi rwake moto unoparadza.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kufema kwake kunofanana nokuyerera kwemvura ine simba zhinji,","poem":1},{"text":"inokwira ichisvika mumutsipa.","poem":2},{"text":"Anozungura ndudzi murusero rwokuparadza;","poem":1},{"text":"anoisa mushaya dzavanhu","poem":2},{"lineBreak":true},{"text":"matomu anovatsausa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Uye muchaimba","poem":1},{"text":"sapausiku hwamunopemberera mutambo mutsvene;","poem":2},{"text":"mwoyo yenyu ichafara","poem":1},{"text":"sezvinoita vanhu vanokwira kugomo raJehovha,","poem":2},{"lineBreak":true},{"text":"nokuDombo raIsraeri, vachiridza nyere.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Jehovha achaita kuti vanhu vanzwe inzwi rake roumambo,","poem":1},{"text":"uye achaita kuti vaone ruoko rwake ruchiburuka pasi,","poem":2},{"text":"nehasha zhinji nomoto wokuparadza,","poem":1},{"text":"nokuputika kwamakore, kunaya kwemvura zhinji nechimvuramabwe.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Inzwi raJehovha richaparadza vaAsiria;","poem":1},{"text":"achavarova netsvimbo yake.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Shamhu yoga yoga yavacharohwa nayo naJehovha","poem":1},{"text":"netsvimbo yake yokuranga,","poem":2},{"text":"ichaenderana nerwiyo rwamakandira norudimbwa,","poem":1},{"text":"paacharwa navo muhondo noruoko rwake.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Tofeti yakanguri yagadzirira;","poem":1},{"text":"yakagadzirirwa kare kugamuchira mambo.","poem":2},{"text":"Gomba rayo romoto rakadzikiswa rikapamhamiswa,","poem":1},{"text":"uye pane moto wakawanda nehuni zhinji;","poem":2},{"text":"kufema kwaJehovha,","poem":1},{"text":"sorukova runopfuta nesafuri,","poem":2},{"lineBreak":true},{"text":"kuchazvitungidza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}