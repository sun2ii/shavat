{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["Vane Nhamo Vanovimba neIjipiti"]},{"type":"verse","number":1,"content":[{"text":"Vane nhamo avo vanoburukira kuIjipiti kundotsvaka rubatsiro,","poem":1},{"text":"vanovimba namabhiza,","poem":2},{"text":"vanovimba nokuwanda kwengoro dzavo","poem":1},{"text":"uye nesimba guru ravatasvi vavo vamabhiza,","poem":2},{"text":"asi vasingatariri kuMutsvene waIsraeri,","poem":1},{"text":"kana kutsvaka rubatsiro runobva kuna Jehovha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kunyange zvakadaro naiyewo akachenjera uye anogona kuuyisa njodzi;","poem":1},{"lineBreak":true},{"text":"haangadzosi mashoko ake.","poem":1},{"lineBreak":true},{"text":"Iye achamukira imba yavakaipa,","poem":1},{"text":"naavo vanobatsira vanoita zvakaipa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asi vaIjipita vanhu uye havasi Mwari,","poem":1},{"text":"mabhiza avo inyama uye haasi mweya.","poem":2},{"text":"Zvino panotambanudza Jehovha ruoko rwake,","poem":1},{"text":"uyo anobatsira achagumburwa,","poem":2},{"lineBreak":true},{"text":"uyo achabatsirwa achawa;","poem":2},{"lineBreak":true},{"text":"vose vachaparara pamwe chete.","poem":2}]},{"type":"verse","number":4,"content":["Zvanzi naJehovha kwandiri:",{"text":"“Sezvinoita shumba inoomba,","poem":1},{"text":"seshumba huru pamusoro pechayabata,","poem":2},{"text":"kunyange mhomho yose yavafudzi","poem":1},{"text":"ikakokerwa pamwe chete kuzorwa neshumba iyi,","poem":2},{"text":"iyo haingavhundutswi noruzha rwavo,","poem":1},{"text":"kana kukanganiswa nemhere yavo,","poem":2},{"text":"saizvozvo Jehovha Wamasimba Ose achaburukira pamusoro peGomo reZioni","poem":1},{"text":"napazvikomo zvaro kuzorwa hondo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Seshiri dzinobhururuka napamusoro,","poem":1},{"text":"Jehovha Wamasimba Ose achadzivirira Jerusarema;","poem":2},{"text":"acharidzivirira, acharirwira,","poem":1},{"text":"achadarika pamusoro paro uye acharisunungura.”","poem":2}]},{"type":"verse","number":6,"content":["Dzokerai kuna iye wamakamukira zvikuru, imi vaIsraeri."]},{"type":"verse","number":7,"content":["Nokuti pazuva iro mumwe nomumwe wenyu acharamba zvifananidzo zvesirivha negoridhe zvakaitwa namaoko enyu akaipa."]},{"type":"verse","number":8,"content":[{"text":"“Asiria ichawisirwa pasi nomunondo usati uri womunhu;","poem":1},{"text":"munondo, kwete wavanhu, uchavapedza.","poem":2},{"text":"Vachatiza pamberi pomunondo","poem":1},{"text":"uye majaya avo achaiswa kuchibharo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nhare dzavo dzakasimba dzichawa nokuda kwokutya;","poem":1},{"text":"vatungamiri vavo vachavhundutswa pavachaona mureza wehondo,”","poem":2},{"text":"ndizvo zvinotaura Jehovha,","poem":1},{"text":"ane moto wake paZioni","poem":2},{"lineBreak":true},{"text":"choto chake chiri muJerusarema.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}