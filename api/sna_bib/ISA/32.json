{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["Umambo hwoKururama"]},{"type":"verse","number":1,"content":[{"text":"Tarirai mambo achatonga nokururama,","poem":1},{"text":"uye vatongi vachatonga nokururamisira.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Munhu mumwe nomumwe achafanana nenzvimbo yokuvanda kubva kumhepo,","poem":1},{"text":"noutiziro kubva pakunaya kwemvura zhinji,","poem":2},{"text":"sehova dzemvura mugwenga nomumvuri","poem":1},{"text":"webwe guru munyika yafa nenyota.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ipapo meso avose vanoona haachazotsinzini,","poem":1},{"text":"uye nzeve dzavanonzwa dzichateerera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndangariro dzavanokurumidzira zvinhu dzichaziva uye dzichanzwisisa,","poem":1},{"text":"uye vanokakama vachataura zvakanaka uye zvinonzwika.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Benzi harichazonzi munhu anokudzwa,","poem":1},{"text":"munhu asina maturo haazoremekedzwi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nokuti benzi rinotaura zvoupenzi,","poem":1},{"text":"ndangariro dzaro dzinofunga zvakaipa:","poem":2},{"text":"Zvaanoita hazvina umwari","poem":1},{"text":"uye anoparadzira zvinhu zvakarasika zvisiri zvaJehovha;","poem":2},{"text":"anosiya vane nzara vasina chinhu","poem":1},{"text":"uye anonyima mvura vane nyota.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nzira dzousina maturo dzakaipa,","poem":1},{"text":"anoita rangano dzakaipa","poem":2},{"text":"kuti aparadze varombo nenhema,","poem":1},{"text":"kunyange chichemo chaanoshayiwa chakanaka hacho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asi munhu anokudzwa anoita urongwa hwakanaka,","poem":1},{"text":"uye namabasa anokudzwa.","poem":2}]},{"type":"heading","content":["Vakadzi veJerusarema"]},{"type":"verse","number":9,"content":[{"text":"Imi vakadzi musina hanya,","poem":1},{"text":"simukai muteerere kwandiri;","poem":2},{"text":"imi vanasikana munoti makachengetedzeka,","poem":1},{"text":"inzwai zvandinoreva!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gore risati rapera","poem":1},{"text":"muchabvunda iyemi munoti makachengetedzeka;","poem":2},{"text":"nokuti kuchekwa kwamazambiringa kuchakundikana,","poem":1},{"text":"uye kutanhwa kwemichero hakuchasviki.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dederai, imi vakadzi musina hanya;","poem":1},{"text":"dederai imi vanasikana munoti makachengetedzeka!","poem":2},{"text":"Bvisai nguo dzenyu,","poem":1},{"text":"monerai masaga muzviuno zvenyu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Muzvirove zvipfuva nokuda kweminda yakanaka,","poem":1},{"text":"nokuda kwezvibereko zvemizambiringa,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"uye nokuda kwenyika yavanhu vangu,","poem":1},{"text":"nyika yamera minzwa norukato,","poem":2},{"text":"hongu, mucheme nokuda kwedzimba dzose dzamafaro,","poem":1},{"text":"uye nokuda kweguta rinopururudza iri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nhare dzichasiyiwa,","poem":1},{"text":"guta roruzha richasara risina munhu;","poem":2},{"text":"nhare neshongwe zvichava dongo nokusingaperi,","poem":1},{"text":"mufaro wembongoro, namafuro ezvipfuwo,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kusvikira Mweya wadururirwa pamusoro pedu uchibva kumusoro,","poem":1},{"text":"uye gwenga rava nyika yakaorera,","poem":2},{"lineBreak":true},{"text":"nemunda wakaorera wava sesango.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kururamisira kuchagara kugwenga","poem":1},{"text":"uye kururama kuchagara kumunda wakaorera.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Chibereko chokururama chichava rugare;","poem":1},{"text":"uye chibereko chokururama chichava runyararo nokuvimba nokusingaperi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vanhu vangu vachagara munzvimbo dzorugare,","poem":1},{"text":"mumisha yakachengetedzeka,","poem":2},{"lineBreak":true},{"text":"munzvimbo dzokuzorora dzakadzikama.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kunyange chimvuramabwe chikafukidza sango,","poem":1},{"text":"neguta rikaparadzwa zvachose,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ucharopafadzwa zvakadiniko,","poem":1},{"text":"uchidyara mbeu dzako pedyo nehova dzose,","poem":2},{"lineBreak":true},{"text":"uye uchirega mombe nembongoro dzako zvichifura zvakasununguka!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}