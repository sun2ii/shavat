{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["Kutambudzika noKubatsirwa"]},{"type":"verse","number":1,"content":[{"text":"Une nhamo iwe, muparadzi,","poem":1},{"text":"iyewe usati wamboparadzwa!","poem":2},{"text":"Une nhamo iwe, mupanduki,","poem":1},{"text":"iyewe usati wambopandukirwa!","poem":2},{"text":"Paunorega kuparadza,","poem":1},{"text":"iwe uchaparadzwa;","poem":2},{"text":"paunorega kupandukira,","poem":1},{"text":"iwe uchapandukirwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haiwa Jehovha, tinzwirei tsitsi;","poem":1},{"text":"tinokupangai imi.","poem":2},{"text":"Ivai simba redu mangwanani oga oga,","poem":1},{"text":"noruponeso rwedu panguva yokutambudzika.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pakutinhira kwenzwi renyu, ndudzi dzinotiza;","poem":1},{"text":"pamunosimuka, marudzi anopararira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Haiwa imi ndudzi, zvakapambwa zvenyu zvachekwa kunge zvachekwa nemhashu diki;","poem":1},{"text":"vanhu vanomhanyira kwazviri segwatakwata remhashu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jehovha asimudzirwa, iye anogara kumusoro;","poem":1},{"text":"achazadza Zioni nokururamisira nokururama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Achava nheyo yechokwadi yenguva yenyu,","poem":1},{"text":"nedura repfuma yoruponeso, uchenjeri nezivo;","poem":2},{"lineBreak":true},{"text":"kiyi yepfuma iyi ndiko kutya Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tarirai, mhare dzavo dzinodanidzira munzira dzomumisha;","poem":1},{"text":"nhume dzorugare dzinochema zvikuru.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Migwagwa mikuru yasiyiwa,","poem":1},{"text":"vafambi havachisimo mumigwagwa.","poem":2},{"text":"Sungano yaputswa,","poem":1},{"text":"zvapupu zvayo zvazvidzwa,","poem":2},{"lineBreak":true},{"text":"hapachina anoremekedzwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nyika inochema uye yoparara,","poem":1},{"text":"Rebhanoni yanyadziswa uye yasvava;","poem":2},{"text":"Sharoni yafanana neArabha,","poem":1},{"text":"uye Bhashani neKarimeri dzakurumuka mashizha adzo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Zvino ini ndichasimuka,” ndizvo zvinotaura Jehovha.","poem":1},{"text":"“Zvino ini ndichakudzwa;","poem":2},{"lineBreak":true},{"text":"zvino ini ndichasimudzirwa pamusoro.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Munoita mimba yehundi,","poem":1},{"text":"munobereka mashanga;","poem":2},{"lineBreak":true},{"text":"kufema kwenyu ndiwo moto unokuparadzai.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Marudzi achapiswa kunge suko;","poem":1},{"text":"vacharirima kunge huni dzeminzwa dzakatemwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Imi vari kure, inzwai zvandakaita;","poem":1},{"text":"imi vari pedyo, bvumai kuti ndine simba!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vatadzi vari muZioni vavhundutswa;","poem":1},{"text":"vasina Mwari vodedera:","poem":2},{"text":"“Ndianiko pakati pedu","poem":1},{"text":"angagare nomoto unopisa nokusingaperi?”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iye anofamba nokururama","poem":1},{"text":"uye anotaura zvakanaka,","poem":2},{"text":"anoramba pfuma inobva pakumanikidza","poem":1},{"text":"uye anodzivisa ruoko rwake kugamuchira fufuro,","poem":2},{"text":"anodzivisa nzeve dzake kunzwa rangano dzokuuraya,","poem":1},{"text":"uye anotsinzina meso ake kuti arege kuona zvakaipa,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"uyu ndiye munhu achagara pakakwirira,","poem":1},{"text":"nhare dzegomo dzichava utiziro hwake.","poem":2},{"text":"Zvokudya zvake achazvipiwa,","poem":1},{"text":"uye haangashayiwi mvura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Meso ako achaona mambo pakunaka kwake;","poem":1},{"text":"uye achatarira nyika yakakura kwazvo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mundangariro dzako ucharangarira zvaimbokutyisa ugoti:","poem":1},{"text":"“Aripiko muchinda mukuru uya?","poem":2},{"lineBreak":true},{"text":"Aripiko uya aimbotora mutero?","poem":2},{"lineBreak":true},{"text":"Aripiko muchinda aiva mutariri weshongwe?”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Vanhu vaya vokuzvikudza hauchazovaonazve,","poem":1},{"text":"ivo vanhu vomutauro wakavanzika,","poem":2},{"lineBreak":true},{"text":"vorurimi rwavo, rusinganzwiki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tarirai Zioni, iro guta remitambo yedu;","poem":1},{"text":"meso enyu achaona Jerusarema,","poem":2},{"lineBreak":true},{"text":"ugaro hworunyararo, tende risingazozungunuswi;","poem":2},{"text":"mbambo dzaro hadzingadzurwi,","poem":1},{"text":"kana mabote aro kudamburwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Asi Jehovha achava Wamasimba Ose kwatiri.","poem":1},{"text":"Richafanana nenzvimbo yenzizi dzakapamhamha uye nehova.","poem":2},{"text":"Magwa anokwasviwa haangasvikiko,","poem":1},{"text":"uye zvikepe zvikuru hazvingapfuuri.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nokuti Jehovha ndiye mutongi wedu,","poem":1},{"text":"Jehovha ndiye anotipa murayiro,","poem":2},{"text":"Jehovha ndiye mambo wedu;","poem":1},{"text":"ndiye achatiponesa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mabote ako ava dembutembu:","poem":1},{"text":"Haagoni kusimbisa mbambo yechikepe,","poem":2},{"lineBreak":true},{"text":"sairi harina kutambanudzwa.","poem":2},{"text":"Ipapo zvakapambwa zvakawanda zvichagoverwa,","poem":1},{"text":"uye kunyange chirema chichawanawo zvakapambwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hapana agere muZioni achati, “Ndinorwara,”","poem":1},{"text":"uye zvivi zvavanogaramo zvicharegererwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}