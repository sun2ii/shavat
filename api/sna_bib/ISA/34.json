{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Kutongwa kweNdudzi"]},{"type":"verse","number":1,"content":[{"text":"Swederai pedyo, imi ndudzi dzavanhu, munzwe.","poem":1},{"text":"Teererai, imi vanhu!","poem":2},{"text":"Nyika ngainzwe, nezvose zviri mairi,","poem":1},{"text":"pasi pose, nezvose zvinobudamo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jehovha akatsamwira ndudzi dzose;","poem":1},{"text":"hasha dzake dziri pamusoro pehondo dzavo dzose.","poem":2},{"text":"Achavaparadza chose,","poem":1},{"text":"achaita kuti vaurayiwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vakaurayiwa vavo vacharasirwa kunze,","poem":1},{"text":"mitumbi yavo ichanhuhwa;","poem":2},{"lineBreak":true},{"text":"makomo achanyorova neropa ravo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nyeredzi dzokudenga dzose dzichanyungudika,","poem":1},{"text":"uye denga richapetwa sorugwaro;","poem":2},{"text":"marudzi ose enyeredzi achawa","poem":1},{"text":"samashizha akaoma abva pamuzambiringa,","poem":2},{"lineBreak":true},{"text":"samaonde akasvava abva pamuonde.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Munondo wangu wakanwa ukaguta kumatenga;","poem":1},{"text":"tarirai, unoburukira kuzotonga Edhomu,","poem":2},{"lineBreak":true},{"text":"vanhu vandakaparadza chose.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Munondo waJehovha wakanyura muropa,","poem":1},{"text":"wakafukidzwa namafuta,","poem":2},{"text":"iro ropa ramakwayana nerembudzi,","poem":1},{"text":"namafuta anobva paitsvo dzamakondobwe.","poem":2},{"text":"Nokuti Jehovha ane chibayiro muBozira","poem":1},{"text":"uye nokuuraya kukuru muEdhomu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nyati dzichawa pamwe navo","poem":1},{"text":"nehono dzemhuru nehando huru.","poem":2},{"text":"Nyika yavo ichanyorova neropa,","poem":1},{"text":"uye guruva richazara mafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nokuti Jehovha ane zuva rokutsiva","poem":1},{"text":"negore rokuripira kuti atsigire zvinodiwa neZioni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hova dzeEdhomu dzichashanduka kuva namo,","poem":1},{"text":"guruva rayo richapisa sesafuri;","poem":2},{"lineBreak":true},{"text":"nyika yayo ichava namo inopfuta!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Haingadzimwi usiku namasikati;","poem":1},{"text":"utsi hwayo huchakwira nokusingaperi.","poem":2},{"text":"Richava dongo kubva kune chimwe chizvarwa kusvikira kune chimwe chizvarwa;","poem":1},{"text":"hapana munhu achazopfuura napozve.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asi zvichava zvezizi romugwenga nehukurwizi;","poem":1},{"text":"zizi guru negunguo zvichaita matenderemo.","poem":2},{"text":"Mwari achatambanudzira Edhomu","poem":1},{"text":"rwodzi rwokuyera,","poem":2},{"lineBreak":true},{"text":"rwenyonganiso nerwokuparadza.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Makurukota ake haazovi nechinhu ikoko chingazonzi umambo,","poem":1},{"text":"machinda ake ose achapera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Minzwa ichatandira nhare dzayo,","poem":1},{"text":"utumbambeva norukato munzvimbo dzayo dzakakomberedzwa.","poem":2},{"text":"Ichava ugaro hwamakava,","poem":1},{"text":"nomusha wamazizi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Zvikara zvomugwenga zvichasangana namapere,","poem":1},{"text":"uye ngururu dzichadaidzirana;","poem":2},{"text":"zvikara zvousiku zvichazororapo,","poem":1},{"text":"uye zvichazviwanira nzvimbo yokuzorora.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zizi richaita dendere rigokandira mazaipo,","poem":1},{"text":"richaachochonyerapo, rigochengeta mazana aro pasi pomumvuri wamapapiro aro;","poem":2},{"text":"makondo achaunganapo,","poem":1},{"text":"rimwe nerimwe neshamwari yaro.","poem":2}]},{"type":"verse","number":16,"content":["Tarirai murugwaro rwaJehovha mugorava:",{"text":"Hapana chimwe chezvinhu izvi chichashayikwa,","poem":1},{"text":"kana chichashaya shamwari.","poem":2},{"text":"Nokuti muromo wake ndiwo warayira izvozvo,","poem":1},{"text":"uye Mweya wake uchavaunganidza pamwe chete.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Anozvigovera migove yazvo;","poem":1},{"text":"ruoko rwake runozvigovera nechiyero.","poem":2},{"text":"Zvichava zvazvo nokusingaperi","poem":1},{"text":"uye zvichagaramo kubva kune chimwe chizvarwa kusvikira kune chimwe chizvarwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}