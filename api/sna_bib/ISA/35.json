"achauya kuzokuponesai.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ipapo meso amapofu achasvinudzwa","poem":1},{"text":"uye nzeve dzematsi dzichazarurwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ipapo akaremara achakwakuka senondo,","poem":1},{"text":"uye rurimi rwechimumu ruchaimba nomufaro.","poem":2},{"text":"Mvura ichatubuka murenje,","poem":1},{"text":"uye nehova dzemvura mugwenga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jecha rinopisa richashanduka rikava dziva,","poem":1},{"text":"ivhu rine nyota richava zvitubu zvemvura.","poem":2},{"text":"Maigara makava noumo maaimbovata,","poem":1},{"text":"muchamera uswa, netsanga nenhokwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ipapo pachava nomugwagwa;","poem":1},{"text":"uchanzi Nzira yoUtsvene.","poem":2},{"text":"Vane tsvina havangazofambi mairi;","poem":1},{"text":"ichava yaivavo vanofamba muNzira iyoyo;","poem":2},{"lineBreak":true},{"text":"vakaipa namapenzi havangazofambi mairi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hapangavi neshumba ipapo,","poem":1},{"text":"kana chikara chipi zvacho chichawanikwapo.","poem":2},{"text":"Asi vakadzikinurwa voga ndivo vachafambamo,","poem":1}]},{"type":"verse","number":10,"content":[{"text":"uye vakasunungurwa vaJehovha vachadzoka.","poem":2},{"text":"Vachapinda muZioni vachiimba;","poem":1},{"text":"mufaro usingaperi uchava pamusoro pavo.","poem":2},{"text":"Vachawana mufaro nokufarisisa,","poem":1},{"text":"kusuwa nokuneta zvichatiza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}