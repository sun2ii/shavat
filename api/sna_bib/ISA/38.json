{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["Kurwara kwaHezekia"]},{"type":"verse","number":1,"content":["Mumazuva iwayo Hezekia akarwara kusvikira oda kufa. Muprofita Isaya mwanakomana waAmozi akaenda kwaari akati, “Zvanzi naJehovha: Gadzirisa zveimba yako, nokuti uri kuzofa; hausi kuzopona.”"]},{"type":"verse","number":2,"content":["Hezekia akatendeukira kumadziro akanyengetera kuna Jehovha achiti,"]},{"type":"verse","number":3,"content":["“Rangarirai henyu, Jehovha, kuti ndakafamba sei nokutendeka pamberi penyu nomwoyo wose nechokwadi uye ndikaita zvakanaka pamberi penyu.” Hezekia akachema kwazvo."]},{"type":"verse","number":4,"content":["Ipapo shoko raJehovha rakauya kuna Isaya richiti,"]},{"type":"verse","number":5,"content":["“Enda undoti kuna Hezekia, ‘Zvanzi naJehovha, Mwari wababa vako Dhavhidhi: Ndanzwa munyengetero wako uye ndaona misodzi yako; ndichawedzera makore gumi namashanu paupenyu hwako."]},{"type":"verse","number":6,"content":["Uye ndichakurwira iwe neguta rino kubva muruoko rwamambo weAsiria. Ndicharwira guta rino."]},{"type":"verse","number":7,"content":["“ ‘Ichi ndicho chiratidzo chaJehovha kwauri kuti Jehovha achaita zvose zvaakavimbisa:"]},{"type":"verse","number":8,"content":["Ndichaita kuti mumvuri waitwa pazuva udzokere shure nhambwe gumi pamutaro wawanga wafamba pamanera aAhazi.’ ” Saizvozvo zuva rakadzokera shure nhambwe gumi dzarakanga radzika."]},{"type":"verse","number":9,"content":["Chinyorwa chaHezekia mambo weJudha mushure mokurwara nokupora kwake:"]},{"type":"verse","number":10,"content":[{"text":"Ndakati, “Mazuva oupenyu hwangu","poem":1},{"text":"achangotanga ndingafanira kupinda mumasuo orufu here?","poem":2},{"lineBreak":true},{"text":"Ndigotorerwa makore angu asara here?”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndakati, “Handichazoonizve Jehovha,","poem":1},{"text":"iye Jehovha, munyika yavapenyu;","poem":2},{"text":"handichazotarisizve kuvanhu","poem":1},{"text":"kana kuva naavo vagere munyika ino zvino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Setende romufudzi, imba yangu","poem":1},{"text":"yakoromorwa uye yatorwa.","poem":2},{"text":"Somuruki ndapeta upenyu hwangu,","poem":1},{"text":"uye iye andigura kubva pachirukiso;","poem":2},{"lineBreak":true},{"text":"masikati namadekwana makaita kuti ndigume.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndakamirira nomwoyo murefu kusvikira mambakwedza,","poem":1},{"text":"asi iye akavhuna mapfupa angu ose kufanana nezvinoitwa neshumba;","poem":2},{"lineBreak":true},{"text":"masikati namadekwana makaita kuti ndigume.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndakarira senyenganyenga kana kondo.","poem":1},{"text":"Ndakachema sokuchema kunoita njiva.","poem":2},{"text":"Meso angu akaneta nokutarisa kudenga.","poem":1},{"text":"Haiwa Jehovha, ndine nhamo, uyai mundinunure!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Asi ndingati kudiniko?","poem":1},{"text":"Iye ataura neni, uye iye ndiye aita izvi.","poem":2},{"text":"Ndichafamba nokuzvininipisa pamakore angu ose,","poem":1},{"text":"nokuda kwokurwadziwa kwomwoyo wangu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ishe, vanhu vanorarama nezvinhu zvakadai;","poem":1},{"text":"uye mweya wangu unowana upenyu mazviriwo.","poem":2},{"text":"Makandiporesa","poem":1},{"text":"mukandiraramisa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Zvirokwazvo kutambudzika kwangu kukuru","poem":1},{"text":"kwakandivigira rugare.","poem":2},{"text":"Murudo rwenyu makandirwira","poem":1},{"text":"pagomba rokuparadzwa;","poem":2},{"text":"makaisa zvivi zvangu zvose","poem":1},{"text":"shure kwenyu,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nokuti guva haringagoni kukurumbidzai,","poem":1},{"text":"rufu harugoni kukurumbidzai nenziyo;","poem":2},{"text":"vanodzika kugomba","poem":1},{"text":"havangagoni kutarisira kutendeka kwenyu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Vapenyu, ivo vapenyu,","poem":1},{"text":"ndivo vanokurumbidzai,","poem":2},{"text":"sezvandiri kuita iye nhasi;","poem":1},{"text":"madzibaba anoudza vana vavo nezvokutendeka kwenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Jehovha achandiponesa,","poem":1},{"text":"uye tichaimba nemitengeranwa,","poem":2},{"text":"mazuva ose oupenyu hwedu","poem":1},{"text":"mutemberi yaJehovha.","poem":2}]},{"type":"verse","number":21,"content":["Zvino Isaya akanga ati, “Gadzirai bundu ramaonde mugoriisa pamota, uye achapora.”"]},{"type":"verse","number":22,"content":["Hezekia akanga abvunza achiti, “Chiratidzo chichava chei chokuti ndiende kutemberi yaJehovha?”"]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}