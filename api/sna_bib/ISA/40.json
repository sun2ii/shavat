{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Kunyaradzwa kwaVanhu vaMwari"]},{"type":"verse","number":1,"content":[{"text":"Nyaradzai, nyaradzai vanhu vangu,","poem":1},{"text":"ndizvo zvinotaura Mwari wenyu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taurai nounyoro kuJerusarema,","poem":1},{"text":"mudanidzire kwariri","poem":2},{"text":"kuti kubata kwaro kukuru kwapera,","poem":1},{"text":"uye kuti chivi charo charipirwa,","poem":2},{"text":"kuti ragamuchira kubva muruoko rwaJehovha","poem":1},{"text":"zvakapetwa kaviri pamusoro pezvivi zvaro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inzwi rounodanidzira achiti,","poem":1},{"lineBreak":true},{"text":"“Gadzirai nzira yaJehovha","poem":1},{"text":"mugwenga,","poem":2},{"text":"ruramisai mugwagwa","poem":1},{"text":"waMwari wedu murenje.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mipata yose ichasimudzirwa,","poem":1},{"text":"makomo ose nezvikomo zvichaenzaniswa;","poem":2},{"lineBreak":true},{"text":"nzvimbo dzisakaenzana dzichava bani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uye kubwinya kwaJehovha kucharatidzwa,","poem":1},{"text":"uye marudzi ose avanhu achazviona.","poem":2},{"text":"Nokuti muromo waJehovha wazvitaura.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Inzwi rinoti, “Danidzirai.”","poem":1},{"text":"Ini ndokuti, “Ndodanidzireiko?”","poem":2},{"lineBreak":true},{"text":"“Vanhu vose vakaita souswa,","poem":1},{"text":"uye kubwinya kwavo kwose kwakaita samaruva omunda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uswa hunooma uye maruva anowa,","poem":1},{"text":"nokuti mweya waJehovha unofuridzira pamusoro pazvo.","poem":2},{"lineBreak":true},{"text":"Zvirokwazvo vanhu uswa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uswa hunooma uye maruva anowa,","poem":1},{"text":"asi shoko raMwari wedu rinogara nokusingaperi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Imi munoparidzira Zioni zvinhu zvakanaka,","poem":1},{"text":"kwirai pagomo refu.","poem":2},{"text":"Imi munoparidzira Jerusarema mashoko akanaka,","poem":1},{"text":"danidzirai nesimba, musatya;","poem":2},{"lineBreak":true},{"text":"muti kumaguta eJudha, “Hoyu Mwari wenyu!”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tarirai, Ishe Jehovha ari kuuya nesimba,","poem":1},{"text":"uye ruoko rwake runomubatira ushe.","poem":2},{"text":"Tarirai, mubayiro wake anawo,","poem":1},{"text":"uye zvaanoripira nazvo anazvo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anofudza makwai ake somufudzi:","poem":1},{"text":"Anounganidza makwayana mumaoko ake","poem":2},{"text":"agoatakurira pedyo nomwoyo wake;","poem":1},{"text":"zvinyoronyoro anotungamirira nhunzvi dzinonwisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndianiko akayera mvura zhinji muchanza chake,","poem":1},{"text":"kana kuyera denga noupamhi hwechanza chake?","poem":2},{"text":"Ndianiko akaisa guruva rose rapasi mudengu,","poem":1},{"text":"kana kuyera kurema kwamakomo nechiyero,","poem":2},{"lineBreak":true},{"text":"nezvikomo pachiyero?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndiani akanzwisisa murangariro waJehovha,","poem":1},{"text":"kana kumudzidzisa somudzidzisi wake?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndiani akabvunzwa naJehovha kuti amujekesere,","poem":1},{"text":"uye ndiani akamudzidzisa nzira yakanaka?","poem":2},{"text":"Ndianiko akamudzidzisa ruzivo","poem":1},{"text":"kana kumuratidza nzira yokunzwisisa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zvirokwazvo ndudzi dzavanhu dzakaita sedonhwe remvura riri muchirongo;","poem":1},{"text":"vanongova seguruva riri pamusoro pechiyero;","poem":2},{"lineBreak":true},{"text":"anoyera zviwi kunge guruva rakatsetseka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Rebhanoni harina huni dzinoringana kuvesa moto wearitari,","poem":1},{"text":"uye zvipfuwo zvaro hazvikwani kuita chipiriso chinopiswa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndudzi dzose dzakaita sepasina chinhu pamberi pake;","poem":1},{"text":"iye anodziona sedzisina maturo,","poem":2},{"lineBreak":true},{"text":"kunge dzisipo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Zvino, mungafananidza Mwari naaniko?","poem":1},{"text":"Ndoupi mufananidzo wamungamuenzanisa nawo?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kana chiri chifananidzo, muumbi anochiumba,","poem":1},{"text":"mupfuri wegoridhe ochinamira negoridhe,","poem":2},{"lineBreak":true},{"text":"uye anochiitira uketani hwesirivha.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Murombo anoshayiwa chipo","poem":1},{"text":"anosarudza danda risingaori.","poem":2},{"text":"Anotsvaka mhizha kuti","poem":1},{"text":"imuvezere chifananidzo chisingazozungunuki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hamuzivi here?","poem":1},{"text":"Hamuna kunzwa here?","poem":2},{"text":"Hamuna kumbozviudzwa kubva pakutanga here?","poem":1},{"text":"Hamuna kunzwisisa kubva pakuvamba kwenyika here?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Anogara samambo pamusoro pedenderedzwa renyika,","poem":1},{"text":"uye vanhu vayo vakaita semhashu.","poem":2},{"text":"Anotambanudza matenga setende,","poem":1},{"text":"agoawaridzira setende kuti agaremo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Anoita kuti machinda ave pasina,","poem":1},{"text":"uye anoderedza vatongi venyika ino kuti vave pasina.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Vachangosimwa, vachangodyarwa,","poem":1},{"text":"vachangodzika midzi muvhu,","poem":2},{"lineBreak":true},{"text":"iye anofuridza pamusoro pavo vachibva vaoma, uye chamupupuri chinovakukura sehundi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Mungandienzanisa naaniko?","poem":1},{"text":"Kana kuti ndiani akaenzana neni?” ndizvo zvinotaura Iye Mutsvene.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Simudzai meso enyu mutarire kumatenga.","poem":1},{"text":"Ndianiko akasika zvose izvi?","poem":2},{"text":"Iye anobudisa nyeredzi imwe imwe,","poem":1},{"text":"achidzidana imwe neimwe nezita rayo.","poem":2},{"text":"Nokuda kwesimba rake guru uye noukuru hwesimba rake,","poem":1},{"text":"hapana kana imwe zvayo inoshayikwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Unoreveiko, iwe Jakobho,","poem":1},{"text":"unogununʼuna chii, iwe Israeri uchiti,","poem":2},{"text":"“Nzira yangu haizivikanwi naJehovha;","poem":1},{"text":"Mwari wangu haana hanya nezvandinorwira?”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hauzivi here?","poem":1},{"text":"Hauna kunzwa here?","poem":2},{"text":"Jehovha ndiye Mwari nokusingaperi,","poem":1},{"text":"Musiki wamagumo enyika.","poem":2},{"text":"Haaneti kana kuziya,","poem":1},{"text":"uye hakuna angayera kunzwisisa kwake.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Anopa simba kuna vakarukutika,","poem":1},{"text":"uye anowedzera simba kuna vasina simba.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kunyange majaya anoneta uye anorukutika,","poem":1},{"text":"uye majaya anogumburwa agowa;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"asi avo vane tariro muna Jehovha","poem":1},{"text":"vachavandudza simba ravo.","poem":2},{"text":"Vachabhururuka namapapiro samakondo;","poem":1},{"text":"vachamhanya vasinganeti;","poem":2},{"lineBreak":true},{"text":"vachafamba vasingaziyi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}