{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["Mubatsiri waIsraeri"]},{"type":"verse","number":1,"content":["“Nyararai pamberi pangu, imi zviwi!",{"text":"Ndudzi ngadzivandudze simba radzo!","poem":2},{"text":"Ngadziswedere mberi dzitaure;","poem":1},{"text":"ngatisanganei pamwe chete panzvimbo inotongerwa mhaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Ndianiko akamutsa mumwe kubva kumabvazuva,","poem":1},{"text":"akamudana nokururama kuushumiri hwake?","poem":2},{"text":"Anopa ndudzi kwaari,","poem":1},{"text":"uye anoisa madzimambo pasi pake.","poem":2},{"text":"Anovashandura vagova guruva nomunondo wake,","poem":1},{"text":"vagova hundi inopepereswa nemhepo nouta hwake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anovadzinganisa agopfuurira mberi asina vanga,","poem":1},{"text":"nenzira yaasina kumbotsika netsoka dzake kare.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndiani akabata basa iri akaripedza,","poem":1},{"text":"akadana zvizvarwa kubva pakutanga?","poem":2},{"text":"Ini, Jehovha, iye wokutanga wavo","poem":1},{"text":"newokupedzisira, ndini iye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zviwi zvakazviona zvikatya;","poem":1},{"text":"magumo enyika anodedera.","poem":2},{"text":"Vanoswedera uye vagouya mberi;","poem":1}]},{"type":"verse","number":6,"content":[{"text":"mumwe nomumwe anobatsira wokwake,","poem":2},{"lineBreak":true},{"text":"achiti kuhama yake, “Simba!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mhizha inokurudzira mupfuri wegoridhe,","poem":1},{"text":"uye iye anotsetsenura nenyundo","poem":2},{"lineBreak":true},{"text":"anokurudzira uyo anorova panhera.","poem":2},{"text":"Anoti kune chakanamwa nomoto, “Ichi chakanaka.”","poem":1},{"text":"Anoroverera chifananidzo pasi nechipikiri kuti chisazungunuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Asi iwe, Israeri, muranda wangu,","poem":1},{"text":"Jakobho, wandakasarudza,","poem":2},{"lineBreak":true},{"text":"imi vana vaAbhurahama, shamwari yangu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ndakakutora kubva kumagumo enyika,","poem":1},{"text":"ndikakudana kubva kumakona ayo ari kure.","poem":2},{"text":"Ndakati kwauri, ‘Uri muranda wangu,’","poem":1},{"text":"ndakakusarudza uye handina kukuramba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naizvozvo usatya, nokuti ndinewe;","poem":1},{"text":"usavhunduka, nokuti ndini Mwari wako.","poem":2},{"text":"Ndichakusimbisa uye ndichakubatsira;","poem":1},{"text":"ndichakutsigira noruoko rwangu rworudyi rwokururama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Vose vanokutsamwira","poem":1},{"text":"zvirokwazvo vachanyadziswa uye vachanyara;","poem":2},{"text":"vose vanokakavadzana newe","poem":1},{"text":"vachava sechinhu chisipo uye vachaparara.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kunyange ukatsvaka vavengi vako,","poem":1},{"text":"hauzovawani.","poem":2},{"text":"Avo vanorwa newe","poem":1},{"text":"vachava sechinhu chisipo chose.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nokuti ndini Jehovha, Mwari wako,","poem":1},{"text":"anobata ruoko rwako rworudyi","poem":2},{"text":"achiti kwauri, Usatya;","poem":1},{"text":"ndichakubatsira.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Usatya Jakobho iwe honye,","poem":1},{"text":"iwe mudiki Israeri,","poem":2},{"text":"nokuti ini iyeni ndichakubatsira,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"Mudzikinuri wako, Mutsvene waIsraeri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Tarira, ndichakuita mupuro, mutsva unopinza,","poem":1},{"text":"una meno mazhinji.","poem":2},{"text":"Uchapura makomo ugoapwanya,","poem":1},{"text":"uye uchaderedza zvikomo zvikava hundi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uchaapepeta, achatorwa nemhepo,","poem":1},{"text":"uye chamupupuri chichaaparadzira.","poem":2},{"text":"Asi iwe uchafara muna Jehovha,","poem":1},{"text":"uye uchazvirumbidza muMutsvene waIsraeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Varombo navanoshaya vanotsvaka mvura","poem":1},{"text":"asi hakuna;","poem":2},{"lineBreak":true},{"text":"ndimi dzavo dzaoma nenyota.","poem":2},{"text":"Asi ini Jehovha ndichavapindura;","poem":1},{"text":"ini, Mwari waIsraeri, handizovasiya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndichaita kuti nzizi dziyerere pamitunhu isina miti,","poem":1},{"text":"namatsime pakati pemipata.","poem":2},{"text":"Ndichashandura gwenga rikava madziva emvura,","poem":1},{"text":"nenyika yakaoma ikava matsime.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndichaisa mugwenga musidhari nomuakasiya,","poem":1},{"text":"mumite nomuorivhi.","poem":2},{"text":"Ndichaisa mipaini musango,","poem":1},{"text":"misipuresi nemifiri pamwe chete,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kuitira kuti vanhu vaone uye vagoziva,","poem":1},{"text":"varangarire vagonzwisisa,","poem":2},{"text":"kuti ruoko rwaJehovha rwakaita izvozvi,","poem":1},{"text":"kuti Mutsvene waIsraeri ndiye akazvisika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Sumai mhaka yenyu,” ndizvo zvinotaura Jehovha.","poem":1},{"text":"“Uyai namashoko enyu akasimba,” ndizvo zvinotaura Mambo waJakobho.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Uyai nezvifananidzo zvenyu zvitiudze","poem":1},{"text":"zvichaitika.","poem":2},{"text":"Tiudzei zvinhu zvakare kuti zvaiva zvipi,","poem":1},{"text":"kuti zvimwe tizviongorore","poem":2},{"lineBreak":true},{"text":"tigoziva magumo azvo.","poem":2},{"text":"Kana kuti tizivisei, zvinhu zvichaitika,","poem":1}]},{"type":"verse","number":23,"content":[{"text":"tiudzei kuti ramangwana rinei,","poem":2},{"lineBreak":true},{"text":"kuti tizive kana imi muri vanamwari.","poem":2},{"text":"Itai chimwe chinhu, chingava chakanaka kana chakaipa,","poem":1},{"text":"kuitira kuti tigoshamiswa tigozadzwa nokutya.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Asi imi hamusi chinhu,","poem":1},{"text":"uye mabasa enyu haana maturo chose;","poem":2},{"lineBreak":true},{"text":"anokusarudzai anonyangadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Ndamutsa mumwe anobva kumusoro, zvino ari kuuya,","poem":1},{"text":"mumwe anobva kumabvazuva anodana kuzita rangu.","poem":2},{"text":"Iye anotsika pamusoro pavabati kunge anotsika dope,","poem":1},{"text":"kuita sokunge muumbi wehari anokanya ivhu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndianiko akazvireva kubva pakutanga, kuti zvimwe,","poem":1},{"text":"tingaziva, kana kuti zvichigere kuitika, kuti zvimwe tigoti, ‘Akanga anatsa?’","poem":2},{"text":"Hapana akataura izvozvi,","poem":1},{"text":"hapana akataura kuti zvichauya,","poem":2},{"lineBreak":true},{"text":"hapana akanzwa kana shoko kubva kwamuri.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ndini akava wokutanga kuudza Zioni kuti, ‘Tarira, ava vari pano!’","poem":1},{"text":"Ndakapa kuJerusarema nhume yamashoko akanaka.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ndinotarisa asi hapana munhu,","poem":1},{"text":"hapana pakati pavo anopa zano,","poem":2},{"lineBreak":true},{"text":"hapana anondipindura pandinovabvunza.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Tarirai, vose inhema dzoga!","poem":1},{"text":"Mabasa avo haana maturo;","poem":2},{"lineBreak":true},{"text":"zvifananidzo zvavo imhepo nenyonganiso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}