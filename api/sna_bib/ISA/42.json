{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["Muranda waJehovha"]},{"type":"verse","number":1,"content":[{"text":"“Tarirai muranda wangu, wandinotsigira,","poem":1},{"text":"musanangurwa wangu wandinofarira;","poem":2},{"text":"Ndichaisa Mweya wangu pamusoro pake,","poem":1},{"text":"uye achavigira ndudzi kururamisirwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haazodanidziri kana kuridza mhere,","poem":1},{"text":"kana kusimudza inzwi munzira dzomuguta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rutsanga rwakapwanyika haangaruvhuni,","poem":1},{"text":"uye nomwenje unopfungaira haazoudzimi.","poem":2},{"text":"Mukutendeka, achavigira vanhu kururamisira;","poem":1}]},{"type":"verse","number":4,"content":[{"text":"haangakoniwi uye haangaperi simba","poem":2},{"text":"kusvikira asimbisa kururamisirwa panyika.","poem":1},{"text":"Zviwi zvichaisa tariro yazvo mumurayiro wake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zvanzi naMwari Jehovha,","poem":1},{"lineBreak":true},{"text":"iye akasika matenga akaatatamura,","poem":1},{"text":"akatambanudza nyika nezvose zvinobuda mairi,","poem":2},{"text":"anopa kufema kuvanhu vayo,","poem":1},{"text":"noupenyu kuna avo vanofamba pamusoro payo:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ini, Jehovha, ndakakudana mukururama;","poem":1},{"text":"ndichabata ruoko rwako.","poem":2},{"text":"Ndichakuchengeta ndigokuita","poem":1},{"text":"kuti uve sungano yavanhu","poem":2},{"lineBreak":true},{"text":"nechiedza kune veDzimwe Ndudzi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kuti usvinudze meso asingaoni,","poem":1},{"text":"usunungure vakasungwa mutorongo","poem":2},{"lineBreak":true},{"text":"uye usunungure vari mugomba, avo vagere murima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ndini Jehovha; ndiro zita rangu!","poem":1},{"text":"Handizopi kukudzwa kwangu kuno mumwe,","poem":2},{"lineBreak":true},{"text":"kana kurumbidzwa kwangu kuzvifananidzo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tarira, zvinhu zvakare zvaitika,","poem":1},{"lineBreak":true},{"text":"uye ndiri kutaura zvinhu zvitsva;","poem":1},{"text":"izvo zvisati zvavapo","poem":2},{"lineBreak":true},{"text":"ndinozvizivisa kwamuri.”","poem":2}]},{"type":"heading","content":["Rwiyo rwoKurumbidza Jehovha"]},{"type":"verse","number":10,"content":[{"text":"Imbirai Jehovha rwiyo rutsva,","poem":1},{"text":"murumbidzei kubva kumagumo enyika,","poem":2},{"text":"imi munoburukira kugungwa, nezvose zviri mariri,","poem":1},{"text":"imi zviwi, navose vanogaramo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gwenga namaguta aro ngazvidanidzire;","poem":1},{"text":"nzvimbo dzinogara Kedhari ngadzifare.","poem":2},{"text":"Vanhu veSera ngavaimbe nomufaro;","poem":1},{"text":"ngavapururudze pamusoro pemakomo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngavape rukudzo kuna Jehovha","poem":1},{"text":"uye vaparidze rumbidzo yake kuzviwi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jehovha achabuda somunhu ane simba,","poem":1},{"text":"semhare, achamutsa kushingaira kwake;","poem":2},{"text":"nokudanidzira, achamutsa kurwa","poem":1},{"text":"uye achakunda vavengi vake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Nokuti ndanga ndakanyarara kwenguva refu,","poem":1},{"text":"ndanga ndinyerere uye ndichizvidzora.","poem":2},{"text":"Asi zvino kufanana nomukadzi ari kusununguka,","poem":1},{"text":"ndiri kudanidzira, ndiri kufemedzeka nokutakwaira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndichaparadza makomo nezvikomo,","poem":1},{"text":"uye ndichaomesa zvose zvawo zvinomera;","poem":2},{"text":"ndichashandura nzizi dzikava zviwi,","poem":1},{"text":"uye madziva ndichaaomesa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndichatungamirira mapofu nenzira dzavasingazivi,","poem":1},{"text":"nomumakwara avasina kuziva,","poem":2},{"text":"ndichavatungamirira; ndichashandura rima rikava chiedza pamberi pavo","poem":1},{"text":"uye ndichaita kuti nzvimbo dzakaipa dziti chechetere.","poem":2},{"text":"Izvi ndizvo zvinhu zvandichaita;","poem":1},{"text":"handizovasiya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Asi ivo vanovimba nezvifananidzo,","poem":1},{"text":"vanoti kune zvakaumbwa, ‘Ndimi vamwari vedu,’","poem":2},{"lineBreak":true},{"text":"vachadzoserwa shure mukunyadziswa kukuru.","poem":2}]},{"type":"heading","content":["Israeri iBofu neMatsi"]},{"type":"verse","number":18,"content":[{"text":"“Inzwai, imi matsi;","poem":1},{"text":"tarirai, imi mapofu, muone!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndianiko bofu, asi muranda wangu,","poem":1},{"text":"uye matsi kufanana nenhume yandinotuma?","poem":2},{"text":"Ndianiko bofu rakafanana naiye akazvipira kwandiri,","poem":1},{"text":"kana bofu rakafanana nomuranda waJehovha?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wakaona zvinhu zvizhinji, asi hauna kuva nehanya;","poem":1},{"text":"nzeve dzako dzakazaruka, asi hauna chaunonzwa.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Zvakafadza Jehovha","poem":1},{"text":"nokuda kwokururama kwake,","poem":2},{"lineBreak":true},{"text":"kuti akudze murayiro wake uye aubwinyise.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Asi ava ndivo vanhu vakapambwa uye vakabirwa,","poem":1},{"text":"vose vakasungwa mumakomba","poem":2},{"lineBreak":true},{"text":"kana kuti vakavanzwa mumatorongo.","poem":2},{"text":"Vakava vabatwa,","poem":1},{"text":"pasina anovarwira;","poem":2},{"text":"vakaitwa chinhu chakapambwa,","poem":1},{"text":"pasina anoti, “Vadzoserei kwavakabva.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ndiani pakati penyu achateerera izvi,","poem":1},{"text":"kana kurerekera nzeve dzake zvikuru panguva inouya?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndiani akarega Jakobho achipambwa,","poem":1},{"text":"akaendesa Israeri kuvapambi?","poem":2},{"text":"Akanga asiri Jehovha here,","poem":1},{"text":"iye watakatadzira?","poem":2},{"text":"Nokuti havana kuda kutevera nzira dzake;","poem":1},{"text":"havana kuteerera murayiro wake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Naizvozvo akadururira hasha dzake dzinopisa pamusoro pavo,","poem":1},{"text":"iro bongozozo rehondo.","poem":2},{"text":"Rakavaputira muvira romoto, asi havana kunzwisisa;","poem":1},{"text":"rakavapisa, asi mwoyo yavo yakashaya hanya nazvo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}