{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["Muponesi waIsraeri Mumwe Oga"]},{"type":"verse","number":1,"content":[{"text":"Asi zvino, zvanzi naJehovha,","poem":1},{"text":"iye akasika iwe Jakobho,","poem":2},{"lineBreak":true},{"text":"iye akakuumba iwe Israeri:","poem":2},{"text":"“Usatya, nokuti ndakakudzikinura;","poem":1},{"text":"ndakakudana nezita rako; uri wangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Paunopfuura nomumvura zhinji","poem":1},{"text":"ini ndichava newe;","poem":2},{"text":"uye paunopinda nomunzizi, hadzizokukukuri.","poem":1},{"text":"Paunofamba nomumoto, haungazotsvi;","poem":2},{"lineBreak":true},{"text":"murazvo haungazokupisi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti ndini Jehovha, Mwari wako,","poem":1},{"text":"Mutsvene waIsraeri, Muponesi wako;","poem":2},{"text":"ndinopa Ijipiti kuti ive rusununguko rwako,","poem":1},{"text":"Etiopia neShebha pachinzvimbo chako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sezvo uchikosha uye uchikudzwa pamberi pangu,","poem":1},{"text":"uye nokuti ndinokuda,","poem":2},{"text":"ndichaisa vanhu panzvimbo yako,","poem":1},{"text":"namarudzi avanhu pachinzvimbo choupenyu hwako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Usatya, nokuti ndinewe;","poem":1},{"text":"ndichauyisa vana vako kubva kumabvazuva,","poem":2},{"lineBreak":true},{"text":"ndichakuunganidzai kubva kumavirira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndichati kurutivi rwokumusoro, ‘Varegedze!’","poem":1},{"text":"uye kurutivi rwezasi, ‘Usavadzivisa.’","poem":2},{"text":"Uyisai vanakomana vangu kubva kure,","poem":1},{"text":"uye navanasikana vangu vabva kumigumo yenyika,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"vose vanodanwa nezita rangu,","poem":1},{"text":"vandakasikira kukudzwa kwangu","poem":2},{"lineBreak":true},{"text":"vandakaumba uye ndikaita.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uyai neavo vane meso asi vari mapofu,","poem":1},{"text":"vane nzeve asi vari matsi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndudzi dzose ngadziungane pamwe chete,","poem":1},{"text":"uye marudzi ngaaungane.","poem":2},{"text":"Ndianiko pakati pavo akati izvi zvichaitika,","poem":1},{"text":"akatiparidzira zvinhu zvakare?","poem":2},{"text":"Ngavauye nezvapupu zvavo kuti zvionekwe kuti havana mhosva,","poem":1},{"text":"kuitira kuti vamwe vanzwe vagoti, “Ichokwadi.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Imi muri zvapupu zvangu,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"“uye nomuranda wangu wandakasarudza,","poem":2},{"text":"kuti mugoziva uye mugonditenda","poem":1},{"text":"uye mugonzwisisa kuti ndini iye.","poem":2},{"text":"Hakuna kumbova nomumwe mwari akaumbwa ndisati ndavapo,","poem":1},{"text":"uye hakuchazova nomumwe shure kwangu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ini, iyeni, ndini Jehovha,","poem":1},{"text":"uye kunze kwangu hakuna muponesi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ini ndakaratidza ndikaponesa, ndikaparidza,","poem":1},{"text":"ini, kwete vamwe vamwari vedzimwe ndudzi vari pakati penyu.","poem":2},{"text":"Imi muri zvapupu zvangu,” ndizvo zvinotaura Jehovha, kuti, “ndini Mwari.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Hongu, kubva pamazuva akare ndini iye.","poem":2},{"text":"Hakuna angarwira munhu muruoko rwangu.","poem":1},{"text":"Pandinoita chinhu, ndianiko angachikonesa?”","poem":2}]},{"type":"heading","content":["Ngoni dzaMwari noKusatendeka kwaIsraeri"]},{"type":"verse","number":14,"content":[{"text":"Zvanzi naJehovha,","poem":1},{"text":"Mudzikunuri wenyu, Mutsvene waIsraeri:","poem":2},{"text":"“Ndichatuma vanhu kuBhabhironi nokuda kwenyu,","poem":1},{"text":"uye ndichaburitsa vaBhabhironi vose vachitiza,","poem":2},{"lineBreak":true},{"text":"muzvikepe zvavaidada nazvo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndini Jehovha, Mutsvene Wenyu,","poem":1},{"text":"Musiki waIsraeri, Mambo wenyu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Zvanzi naJehovha,","poem":1},{"text":"iye akaita nzira pakati pegungwa,","poem":2},{"lineBreak":true},{"text":"nenzira mukati memvura zhinji,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"iye akabudisa ngoro namabhiza,","poem":1},{"text":"hondo pamwe chete nezvinosimbisa,","poem":2},{"text":"vakavata ipapo, havana kuzombomukazve,","poem":1},{"text":"vadzimwa, vadzimwa somwenje:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Chikanganwai zvinhu zvakare;","poem":1},{"text":"musaramba muri pane zvakapfuura.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tarirai, ndava kuita chinhu chitsva!","poem":1},{"text":"Zvino chava kumera; hamuchioni here?","poem":2},{"text":"Ndiri kuita nzira mugwenga","poem":1},{"text":"nehova musango.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Zvikara zvesango zvinondikudza,","poem":1},{"text":"makava namazizi,","poem":2},{"text":"nokuti ndinozvipa mvura mugwenga","poem":1},{"text":"nehova musango,","poem":2},{"text":"kuti ndipe vanhu vangu chokunwa, vasanangurwa vangu,","poem":1}]},{"type":"verse","number":21,"content":[{"text":"vanhu vandakazviumbira,","poem":2},{"lineBreak":true},{"text":"kuti vaparidze kurumbidzwa kwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Kunyange zvakadaro hauna kudana kwandiri, iwe Jakobho;","poem":1},{"text":"hauna kuzvinetesa nokuda kwangu, iwe Israeri.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hauna kundivigira makwai ezvipiriso zvinopiswa,","poem":1},{"text":"kana kundikudza nezvibayiro zvako.","poem":2},{"text":"Handina kukuremedza nezvipiriso zvezviyo,","poem":1},{"text":"kana kukunetesa nokuda zvinonhuhwira.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hauna kundivigira kana zvinotapira,","poem":1},{"text":"kana kundigutsa namafuta ezvibayiro zvako.","poem":2},{"text":"Asi wakandiremedza nezvivi zvako","poem":1},{"text":"uye ukandinetesa nokudarika kwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Ini, iyeni, ndini ndinodzima kudarika kwako,","poem":1},{"text":"nokuda kwangu,","poem":2},{"lineBreak":true},{"text":"handizorangaririzve zvakaipa zvako.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndiyeuchidze zvakapfuura,","poem":1},{"text":"ngatitaurirane nyaya iyi pamwe chete;","poem":2},{"lineBreak":true},{"text":"zvipupurire kuti hauna mhosva.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tateguru wako akatadza;","poem":1},{"text":"vamiririri vako vakandimukira.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Naizvozvo ndichanyadzisa vanokudzwa vomutemberi yako,","poem":1},{"text":"uye ndichaita kuti Jakobho aparadzwe","poem":2},{"lineBreak":true},{"text":"uye Israeri asekwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}