{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["Israeri Musanangurwa"]},{"type":"verse","number":1,"content":[{"text":"“Asi zvino chinzwa, iwe Jakobho, muranda wangu,","poem":1},{"text":"Israeri, wandakasarudza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zvanzi naJehovha, iye akakuita,","poem":1},{"text":"akauumba mudumbu","poem":2},{"lineBreak":true},{"text":"uye iye achakubatsira:","poem":2},{"text":"Usatya, iwe Jakobho, muranda wangu,","poem":1},{"text":"Jeshuruni, wandakasarudza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti ndichadurura mvura panyika ine nyota,","poem":1},{"text":"nehova pamusoro pevhu rakaoma;","poem":2},{"text":"ndichadurura Mweya wangu pamusoro porudzi rwako,","poem":1},{"text":"nemikomborero yangu pamusoro pavana vako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vachamera souswa mudekete,","poem":1},{"text":"semiti yemikonachando pahova dzinoyerera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mumwe achati, ‘Ndiri waJehovha’;","poem":1},{"text":"mumwe achazvitumidza nezita raJakobho;","poem":2},{"text":"zvakadaro, mumwe achanyora muruoko rwake achiti, ‘Ndiri waJehovha,’","poem":1},{"text":"uye achatora zita rokuti Israeri.","poem":2}]},{"type":"heading","content":["Jehovha, Kwete Zvifananidzo"]},{"type":"verse","number":6,"content":[{"text":"“Zvanzi naJehovha,","poem":1},{"text":"Mambo waIsraeri noMudzikinuri, Jehovha Wamasimba Ose:","poem":2},{"text":"Ndini wokutanga uye ndini wokupedzisira;","poem":1},{"text":"kunze kwangu hakuna Mwari.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndianiko zvino akafanana neni? Ngaazvitaure.","poem":1},{"text":"Ngaadanidzire, azviise mberi kwangu","poem":2},{"text":"izvo zvakaitika kubva pandakasimbisa vanhu vangu vekare,","poem":1},{"text":"uye kuti chiiko chichaitika hongu,","poem":2},{"lineBreak":true},{"text":"ngaataure zvichaitika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Musadedera, musatya.","poem":1},{"text":"Handina kuparidza izvi here uye ndikazvitaura kare kare?","poem":2},{"text":"Imi muri zvapupu zvangu.","poem":1},{"text":"Kune mumwe Mwari kunze kwangu here? Kwete, hakuna rimwe Dombo; hakuna rimwe randinoziva.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Vose vanoita zvifananidzo havana maturo,","poem":1},{"text":"uye zvinhu zvavanofarira hazvibatsiri.","poem":2},{"text":"Vose vangada kuvapupurira mapofu;","poem":1},{"text":"havazivi, ndiko kuchava kunyadziswa kwavo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndiani anoveza mwari","poem":1},{"text":"uye anoumba chifananidzo, chisingamubatsiri chinhu?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iye navamwe vake vachanyadziswa;","poem":1},{"text":"mhizha hadzizi chinhu asi vanhu zvavo.","poem":2},{"text":"Ngavaungane vose pamwe chete uye vamire vasingazungunuswi; vachaderedzwa,","poem":1},{"text":"uye vachatya vachanyadziswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mupfuri anotora chokupfurisa","poem":1},{"text":"agochishandisa mumazimbe;","poem":2},{"text":"anoita chifananidzo nenyundo,","poem":1},{"text":"agochiumba nesimba roruoko rwake.","poem":2},{"text":"Anonzwa nzara agorasikirwa nesimba rake.","poem":1},{"text":"Mukusanwa kwake mvura anobva aziya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Muvezi anoyera nerwodzi","poem":1},{"text":"ozoita mutsetse nechokunyoresa;","poem":2},{"text":"anounatsa nembezo,","poem":1},{"text":"uye anoutara nezvienzaniso.","poem":2},{"text":"Anouumba mumufananidzo womunhu,","poem":1},{"text":"womunhu nokunaka kwake kwose,","poem":2},{"lineBreak":true},{"text":"kuti ugare mumba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akatema misidhari,","poem":1},{"text":"kana zvimwe akatora musipuresi kana muouki.","poem":2},{"text":"Akaurega uchikura pakati pemiti yesango,","poem":1},{"text":"kana kuti akasima mupaini, mvura ikaita kuti ukure.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndidzo huni dzomunhu dzokuvesa moto;","poem":1},{"text":"dzimwe dzacho anodzitora agozvidziyisa nadzo,","poem":2},{"lineBreak":true},{"text":"anovesa moto agobika chingwa nadzo.","poem":2},{"text":"Asizve anoveza chimwari agochinamata;","poem":1},{"text":"anoita chifananidzo agochipfugamira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hafu yehuni anopisa mumoto,","poem":1},{"text":"nadzo anobika zvokudya zvake,","poem":2},{"lineBreak":true},{"text":"anogocha nyama yake agoidya achiguta.","poem":2},{"text":"Anozvidziyisazve, agoti,","poem":1},{"text":"“Haiwa! Ndadziyirwa; moto ndiri kuuona.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nezvasara anoita nazvo chimwari,","poem":1},{"text":"icho chifananidzo chake; anochipfugamira agochinamata.","poem":2},{"text":"Anonyengetera kwachiri achiti,","poem":1},{"text":"“Ndiponesei; ndimi mwari wangu.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Havana chavanoziva, havanzwisisi chinhu, meso avo akanamwa kuitira kuti varege kuona,","poem":1},{"text":"uye ndangariro dzavo dzakafukidzirwa kuitira kuti varege kunzwisisa.","poem":2},{"lineBreak":true},{"text":"Hapana anombomira kuti afunge,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hapana ane ruzivo","poem":1},{"text":"kana kunzwisisa kuti ati,","poem":2},{"text":"“Hafu yacho ndaishandisa pakuvesa moto;","poem":1},{"text":"ini iyeni ndabikira chingwa pamazimbe acho,","poem":2},{"lineBreak":true},{"text":"ndagocha nyama ndikadya.","poem":2},{"text":"Ndichaita zvinonyangadza pane zvasara here?","poem":1},{"text":"Ndichapfugamira kudanda rehuni here?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Anodya madota, mwoyo wakanyengerwa unomutsausa;","poem":1},{"text":"haagoni kuzviponesa kana kuti ati,","poem":2},{"lineBreak":true},{"text":"“Ko, chinhu ichi chiri muruoko rwangu rworudyi hachisi chenhema here?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Rangarira zvinhu izvi, iwe Jakobho,","poem":1},{"text":"nokuti uri muranda wangu, iwe Israeri.","poem":2},{"text":"Ndakakuita, uri muranda wangu;","poem":1},{"text":"haiwa Israeri, handichakukanganwizve.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ndakadzima kudarika kwako segore,","poem":1},{"text":"nezvivi zvako semhute yamangwanani.","poem":2},{"text":"Dzokera kwandiri,","poem":1},{"text":"nokuti ndakakudzikinura.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Imbai nomufaro imi matenga, nokuti Jehovha akaita izvozvi;","poem":1},{"text":"danidzira nesimba, iwe nyika iri pasi.","poem":2},{"text":"Imbai nziyo, imi makomo,","poem":1},{"text":"nemi masango nemiti yose,","poem":2},{"text":"nokuti Jehovha adzikinura Jakobho,","poem":1},{"text":"akaratidza kubwinya muIsraeri.","poem":2}]},{"type":"heading","content":["Jerusarema Richagarwazve"]},{"type":"verse","number":24,"content":[{"text":"“Zvanzi naJehovha,","poem":1},{"text":"mudzikinuri wako, iye akakuumba uri mudumbu:","poem":2},{"lineBreak":true},{"text":"“Ndini Jehovha,","poem":1},{"lineBreak":true},{"text":"akaita zvinhu zvose,","poem":1},{"lineBreak":true},{"text":"iye oga akatatamura matenga,","poem":1},{"lineBreak":true},{"text":"akatambanudza nyika oga,","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“iye anokonesa zviratidzo zvavaprofita venhema,","poem":1},{"text":"anoita kuti vavuki vave mapenzi,","poem":2},{"text":"iye anoparadza kudzidza kwevane njere,","poem":1},{"text":"uye anokushandura kuti kuve upenzi,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"anozadzisa mashoko omuranda wake,","poem":1},{"text":"uye anozadzisa zvakaprofitwa nenhume dzake,","poem":2},{"lineBreak":true},{"text":"“anoti kuJerusarema, ‘Richagarwa,’","poem":1},{"text":"nokumaguta eJudha, ‘Achavakwa,’","poem":2},{"lineBreak":true},{"text":"nokumatongo awo, ‘Ndichaavandudza,’","poem":2}]},{"type":"verse","number":27,"content":[{"text":"iye anoti kumvura yakadzika, ‘Oma,","poem":1},{"text":"uye ndichaomesa hova dzako,’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"iye anoti pamusoro paSirasi,","poem":1},{"text":"‘Ndiye mufudzi wangu uye achaita zvose zvandinoda;","poem":2},{"lineBreak":true},{"text":"iye achati pamusoro peJerusarema, “Ngarivakwezve,”","poem":2},{"lineBreak":true},{"text":"uye pamusoro petemberi achati, “Nheyo dzayo ngadziteyiwe.” ’","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}