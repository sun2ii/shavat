{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"“Zvanzi naJehovha kumuzodziwa wake,","poem":1},{"text":"kuna Sirasi, ane ruoko rworudyi rwandakabata","poem":2},{"text":"kuti akunde ndudzi pamberi pake,","poem":1},{"text":"uye kuti atorere madzimambo zvombo zvavo,","poem":2},{"text":"kuti ndizarure mikova pamberi pake,","poem":1},{"text":"masuo agorega kupfigwa:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichaenda mberi kwako","poem":1},{"text":"uye ndichaenzanisa makomo;","poem":2},{"text":"ndichaputsa masuo endarira","poem":1},{"text":"uye ndichacheka ndigopinda napamazariro esimbi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndichakupa pfuma yerima,","poem":1},{"text":"upfumi hwakavigwa panzvimbo dzakavanda,","poem":2},{"text":"kuti uzive kuti ndini Jehovha, Mwari waIsraeri,","poem":1},{"text":"anokudana nezita rako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nokuda kwaJakobho muranda wangu,","poem":1},{"text":"nokwaIsraeri musanangurwa wangu,","poem":2},{"text":"ndinokudana nezita rako,","poem":1},{"text":"uye ndinoisa pamusoro pako zita rokukudzwa,","poem":2},{"lineBreak":true},{"text":"kunyange iwe usingandizivi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndini Jehovha, uye hakuna mumwe;","poem":1},{"text":"kunze kwangu ini hakuna Mwari.","poem":2},{"text":"Ndichakusimbisa,","poem":1},{"text":"kunyange usina kundiziva,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kuti kubva kumabudazuva","poem":1},{"text":"kusvikira kwarinovirira,","poem":2},{"text":"vanhu vazive kuti hakuna mumwe kunze kwangu.","poem":1},{"text":"Ndini Jehovha uye hakuna mumwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndinoumba chiedza uye ndinosika rima,","poem":1},{"text":"ndinoita rugare uye ndinosika njodzi;","poem":2},{"lineBreak":true},{"text":"ini Jehovha, ndini ndinoita zvinhu izvi zvose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Imi matenga kumusoro, nayisai kururama;","poem":1},{"text":"makore ngaakudonhedze pasi.","poem":2},{"text":"Nyika ngaizaruke kwazvo,","poem":1},{"text":"ruponeso ngarutubuke,","poem":2},{"text":"kururama ngakukure pamwe chete narwo;","poem":1},{"text":"ini Jehovha, ndini ndakazvisika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ane nhamo uyo anokakavadzana noMuiti wake,","poem":1},{"text":"iye anongova chaenga pakati pezvaenga pamusoro pevhu.","poem":2},{"text":"Ko, ivhu ringati kumuumbi,","poem":1},{"text":"‘Uri kugadzirei?’","poem":2},{"text":"Ko, basa rako rinoti here,","poem":1},{"text":"‘Uyu haana maoko?’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ane nhamo uyo anoti kuna baba vake,","poem":1},{"text":"‘Chiiko chamakabereka?’","poem":2},{"text":"kana kuna mai vake,","poem":1},{"text":"‘Chiiko chamakazvara?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Zvanzi naJehovha,","poem":1},{"text":"iye Mutsvene waIsraeri, noMuiti wake:","poem":2},{"text":"Pamusoro pezvinhu zvichauya,","poem":1},{"text":"unondibvunza here pamusoro pavana vangu,","poem":2},{"lineBreak":true},{"text":"kana kundirayira pamusoro pebasa ramaoko angu?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndini ndakaita nyika","poem":1},{"text":"uye ndikasika vanhu vendudzi dzose pamusoro payo.","poem":2},{"text":"Maoko angu pachangu akatatamura matenga;","poem":1},{"text":"ndakarayira hondo dzawo dzose dzenyeredzi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndichamutsa Sirasi mukururama kwangu:","poem":1},{"text":"ndichaita kuti nzira dzake dzose dzirurame.","poem":2},{"text":"Achavakazve guta rangu,","poem":1},{"text":"uye achasunungura vatapwa vangu,","poem":2},{"text":"asi pasina muripo kana mubayiro,","poem":1},{"text":"ndizvo zvinotaura Jehovha Wamasimba Ose.”","poem":2}]},{"type":"verse","number":14,"content":["Zvanzi naJehovha:",{"text":"“Zvibereko zveIjipiti nezvinoshambadzirwa zveEtiopia,","poem":1},{"text":"navaSabhea varefu,","poem":2},{"text":"vachauya kwauri","poem":1},{"text":"uye vachava vako;","poem":2},{"text":"vachatevera mushure mako,","poem":1},{"text":"vachiuya kwauri vakasungwa nengetani.","poem":2},{"text":"Vachapfugama pamberi pako","poem":1},{"text":"uye vachakunyengetedza, vachiti,","poem":2},{"text":"‘Zvirokwazvo Mwari anewe,","poem":1},{"text":"uye hakunazve mumwe; hakuna mumwe mwari.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zvechokwadi muri Mwari anozvivanza,","poem":1},{"text":"imi Mwari noMuponesi waIsraeri.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Vose vanoita zvifananidzo vachava nenyadzi uye vachanyadziswa,","poem":1},{"text":"vachasvika pakunyadziswa pamwe chete.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Asi Israeri achaponeswa naJehovha","poem":1},{"text":"noruponeso rusingaperi;","poem":2},{"text":"hamuchazombonyadziswi kana kuva nenyadzi,","poem":1},{"text":"kusvikira kumakore asingaperi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nokuti zvanzi naJehovha,","poem":1},{"lineBreak":true},{"text":"iye akasika matenga,","poem":1},{"text":"ndiye Mwari;","poem":2},{"text":"iye akaumba uye akaita nyika,","poem":1},{"text":"ndiye akaisimbisa;","poem":2},{"text":"haana kuisikira kuti igare isina chinhu,","poem":1},{"text":"asi akaiumba kuti igarwe,","poem":2},{"text":"anoti:","poem":1},{"lineBreak":true},{"text":"“Ndini Jehovha,","poem":1},{"text":"uye hakuna mumwe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Handina kutaura ndiri pakavanda,","poem":1},{"text":"ndichibva kumwe kunyika yerima;","poem":2},{"text":"handina kuti kuvana vaJakobho,","poem":1},{"text":"‘Nditsvakei pasina.’","poem":2},{"text":"Ini, Jehovha ndinotaura chokwadi;","poem":1},{"text":"ndinoparidza zvakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Unganai pamwe chete muuye;","poem":1},{"text":"unganai, imi vatizi vanobva kune dzimwe ndudzi.","poem":2},{"text":"Vose vanotakura mifananidzo yamatanda havazivi,","poem":1},{"text":"vanonyengetera kuna vamwari vasingagoni kuponesa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Paridzai zvichauya, muzvibudise pachena:","poem":1},{"text":"ngavarangane pamwe chete.","poem":2},{"text":"Ndianiko akazvitaura kare,","poem":1},{"text":"ndiani akazvireva kubva kare nakare?","poem":2},{"text":"Handizini Jehovha here?","poem":1},{"text":"Uye kunze kwangu ini hakuna Mwari,","poem":2},{"text":"Mwari akarurama noMuponesi;","poem":1},{"text":"hakuna mumwe asi ini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Dzokerai kwandiri mugoponeswa,","poem":1},{"text":"imi mose migumo yenyika;","poem":2},{"lineBreak":true},{"text":"nokuti ndini Mwari, uye hakuna mumwe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndakapika neni pachangu,","poem":1},{"text":"muromo wangu wakataura","poem":2},{"lineBreak":true},{"text":"nokururama kwose shoko risingazoshandurwi:","poem":2},{"text":"Mabvi ose achapfugama pamberi pangu;","poem":1},{"text":"ndimi dzose dzichapika neni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Vachati pamusoro pangu,","poem":1},{"text":"‘Muna Jehovha chete ndimo muno kururama nesimba.’ ”","poem":2},{"text":"Vose vakamutsamwira","poem":1},{"text":"vachauya kwaari uye vachanyadziswa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Asi rudzi rwose rwaIsraeri","poem":1},{"text":"ruchawanikwa rwakarurama muna Jehovha uye ruchafara.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}