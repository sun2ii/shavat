{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"heading","content":["Vamwari veBhabhironi"]},{"type":"verse","number":1,"content":[{"text":"Bheri rinokotamira pasi, Nebho rinokotama;","poem":1},{"text":"zvifananidzo zvavo zvinotakurwa nezvipfuwo zvinotakura mutoro.","poem":2},{"text":"Zvifananidzo zvacho zvinotakurwa zvinorema,","poem":1},{"text":"mutoro pazvipfuwo zvakaneta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zvinokotama uye zvinokotamira pasi pamwe chete;","poem":1},{"text":"zvisingagoni kurwira mutoro,","poem":2},{"lineBreak":true},{"text":"izvo pachazvo zvinoenda kuutapwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Ndinzwei, imi imba yaJakobho,","poem":1},{"text":"imi mose vakasara veimba yaIsraeri,","poem":2},{"text":"imi vandakasimudzira kubvira muchiri mudumbu,","poem":1},{"text":"uye ndikakutakurai kubvira pakuzvarwa kwenyu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kunyange kusvikira pakuchembera kwenyu,","poem":1},{"text":"bvudzi rachena, ndini iye, ndini ndichakururamisai.","poem":2},{"text":"Ndakakuitai uye ndichakutakurai;","poem":1},{"text":"ndichakuraramisai uye ndichakununurai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Mungandienzanisa naaniko kana kunditi ndakaita saani?","poem":1},{"text":"Mungandifananidza naaniko wandingaenzaniswa naye?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vamwe vanodurura goridhe kubva muhomwe dzavo,","poem":1},{"text":"uye vanoyera sirivha pazviyero;","poem":2},{"text":"vanotsvaka mupfuri kuti avaitire chimwari,","poem":1},{"text":"vagopfugama kuti vachinamate.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vanochisimudzira pamapfudzi avo vagochitakura;","poem":1},{"text":"vanochigadzika panzvimbo yacho,","poem":2},{"lineBreak":true},{"text":"uye hecho chomira, hachigoni kufamba kuti chibvepo.","poem":2},{"text":"Kunyange mumwe akadanidzira kwachiri, hachipinduri;","poem":1},{"text":"hachigoni kumuponesa kubva pamatambudziko ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Rangarirai chinhu ichi, muchiise mupfungwa dzenyu,","poem":1},{"text":"muise pamwoyo yenyu, imi vapanduki.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Rangarirai zvinhu zvakare, zviya zvekare kare;","poem":1},{"text":"ndini Mwari, uye hakuna mumwe;","poem":2},{"lineBreak":true},{"text":"ndini Mwari, hakuna akafanana neni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndinozivisa magumo kubva pakutanga,","poem":1},{"text":"kubva panguva yekare kare, izvo zvichiri kuuya.","poem":2},{"text":"Ndinoti: Zvandakaronga zvichaitika,","poem":1},{"text":"uye ndichaita zvose zvandinoda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kubva kumabvazuva ndinodana gondo;","poem":1},{"text":"kubva kunyika iri kure kure ndinodana munhu achazadzisa kuda kwangu.","poem":2},{"text":"Zvandakareva ndichaita kuti zviitike;","poem":1},{"text":"zvandakaronga, ndichazviita.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nditeererei, imi vane mwoyo yakasindimara,","poem":1},{"text":"iyemi muri kure nokururama.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndiri kuswededza pedyo kururama kwangu,","poem":1},{"text":"hakusi kure;","poem":2},{"lineBreak":true},{"text":"uye ruponeso rwangu haruzononotswi.","poem":2},{"text":"Ndichapa ruponeso kuZioni,","poem":1},{"text":"nokubwinya kwangu kuna Israeri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}