{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Kuwa kweBhabhironi"]},{"type":"verse","number":1,"content":[{"text":"“Buruka, ugare muguruva,","poem":1},{"text":"iwe Mhandara yeBhabhironi;","poem":2},{"text":"gara pasi usina chigaro choushe,","poem":1},{"text":"iwe Mhandara yavaBhabhironi.","poem":2},{"text":"Hauchazonzi uri munyoro","poem":1},{"text":"kana munhu akapfava.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tora makuyo ukuye upfu;","poem":1},{"text":"bvisa vhoiri rako.","poem":2},{"text":"Fukura nguo dzako,","poem":1},{"text":"makumbo ako aonekwe, uyambuke hova.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kushama kwako kuchava pachena,","poem":1},{"text":"uye kunyadzwa kwako kuchaonekwa.","poem":2},{"text":"Ndichatsiva;","poem":1},{"text":"handizosiyi munhu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mudzikinuri wedu, Jehovha Wamasimba Ose ndiro zita rake;","poem":1},{"text":"ndiye Mutsvene waIsraeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gara unyerere, enda murima,","poem":1},{"text":"Mhandara yavaBhabhironi;","poem":2},{"text":"hauchazonzi mambokadzi wenyika","poem":1},{"text":"dzakasiyana-siyana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndakatsamwira vanhu vangu","poem":1},{"text":"ndikasvibisa nhaka yangu;","poem":2},{"text":"ndakavapa muruoko rwako,","poem":1},{"text":"iwe ukasavanzwira ngoni.","poem":2},{"text":"Kunyange vakakwegura","poem":1},{"text":"wakavatakudza joko rinorema kwazvo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wakati, “Ndicharamba","poem":1},{"text":"ndiri mambokadzi nokusingaperi!”","poem":2},{"text":"Asi hauna kufunga zvinhu izvi,","poem":1},{"text":"kana kucherechedza zvaizogona kuitika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Naizvozvo zvino, chinzwa,","poem":1},{"text":"iwe chisikwa chisingagutsikani,","poem":2},{"text":"ugere zvakachengetedzeka, uchiti,","poem":1},{"text":"mumwoyo mako, “Ndini, hakuna mumwe kunze kwangu.","poem":2},{"text":"Handizovi chirikadzi,","poem":1},{"text":"uye handizotambudziki nokurasikirwa navana.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zviviri izvozvi zvichakuwira nechinguva chidiki diki,","poem":1},{"text":"pazuva rimwe chete zvinoti:","poem":2},{"lineBreak":true},{"text":"kufirwa navana nouchirikadzi.","poem":2},{"text":"Zvichauya pamusoro pako nechiyero chizere,","poem":1},{"text":"kunyange uine unʼanga hwako huzhinji,","poem":2},{"lineBreak":true},{"text":"nouroyi hwako hwakawanda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wakavimba nezvakaipa zvako uye wakati,","poem":1},{"text":"“Hapana anondiona.”","poem":2},{"text":"Uchenjeri hwako nezivo yako","poem":1},{"text":"zvinokutsausa paunoti, mumwoyo mako,","poem":2},{"lineBreak":true},{"text":"“Ndini, uye hakuna mumwe kunze kwangu.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dambudziko richakuwira,","poem":1},{"text":"uye haugoni kuzoziva kuti ungaritanda sei.","poem":2},{"text":"Njodzi ichakuwira yausingagoni","poem":1},{"text":"kubvisa nomuripo;","poem":2},{"text":"pakarepo kuparadza kwausingagoni kuziva,","poem":1},{"text":"kuchawira pamusoro pako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Zvino, enderera hako mberi nouroyi hwako,","poem":1},{"text":"uye nounʼanga hwako huzhinji,","poem":2},{"lineBreak":true},{"text":"hwawakashandira kubva paudiki hwako.","poem":2},{"text":"Zvichida uchabudirira,","poem":1},{"text":"zvichida uchavhundutsira vamwe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mazano ose awakagamuchira, akakunetesa chete!","poem":1},{"text":"Vanhu vako vanocherechedza nyeredzi ngavauye mberi,","poem":2},{"text":"avo vanotarira nyeredzi vachifembera mwedzi nomwedzi,","poem":1},{"text":"ngavakuponese pane zviri kuuya pamusoro pako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Zvirokwazvo vakafanana namashanga;","poem":1},{"text":"moto uchaapisa akapera.","poem":2},{"text":"Havangatongogoni kuzvirwira,","poem":1},{"text":"pasimba romurazvo womoto.","poem":2},{"text":"Asi hapana mazimbe okuti munhu adziyirwe;","poem":1},{"text":"hapana moto wokudziya ipapo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Izvozvi ndizvo chete zvavangakuitira,","poem":1},{"text":"ava vawakashanda navo,","poem":2},{"lineBreak":true},{"text":"uye ukafamba navo kubva paudiki hwako.","poem":2},{"text":"Mumwe nomumwe wavo anoenderera mberi nokukanganisa kwake;","poem":1},{"text":"hapana kana mumwe angakuponesa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}