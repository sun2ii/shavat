{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["Israeri ino mwoyo mukukutu"]},{"type":"verse","number":1,"content":[{"text":"“Inzwai izvi, imi imba yaJakobho,","poem":1},{"text":"makatumidzwa zita raIsraeri,","poem":2},{"lineBreak":true},{"text":"uye muchibva kurudzi rwaJudha,","poem":2},{"text":"imi munoita mhiko muzita raJehovha,","poem":1},{"text":"uye munodana kuna Mwari waIsraeri,","poem":2},{"lineBreak":true},{"text":"asi musingaiti muzvokwadi kana mukururama,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"imi munozviti vagari vomuguta dzvene,","poem":1},{"text":"muchivimba naMwari weIsraeri;","poem":2},{"lineBreak":true},{"text":"Jehovha Wamasimba Ose ndiro zita rake:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndakazivisa zvinhu zvakare, kare kare,","poem":1},{"text":"muromo wangu wakazvireva uye ndakaita kuti zvizivikanwe;","poem":2},{"lineBreak":true},{"text":"ipapo nokukurumidza ndakazviita, uye zvikaitika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nokuti ndaiziva kuti mwoyo wako wakanga wakasindimara sei;","poem":1},{"text":"nokuti mutsipa wako wakanga uri runda rwesimbi,","poem":2},{"lineBreak":true},{"text":"huma yako yakanga iri ndarira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naizvozvo ndakakuudza zvinhu izvi kare kare;","poem":1},{"text":"zvisati zvaitika ndakazvizivisa kwauri,","poem":2},{"text":"kuitira kuti urege kuzoti,","poem":1},{"text":"‘Zvifananidzo zvangu,","poem":2},{"lineBreak":true},{"text":"ndizvo zvakazviita; mufananidzo wangu wedanda namwari wangu wesimbi ndizvo zvakarayira izvozvo.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wakazvinzwa zvinhu izvi; zvitarire zvose.","poem":1},{"text":"Haungazvibvumi here?","poem":2},{"lineBreak":true},{"text":"“Kubva zvino ndichakuzivisa zvinhu zvitsva,","poem":1},{"text":"zvakavanzika zvausingazivi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zvava kusikwa zvino, uye hakusi kare;","poem":1},{"text":"hauna kumbozvinzwa zuva ranhasi risati rasvika.","poem":2},{"text":"Saka haugoni kuti,","poem":1},{"text":"‘Hongu, ndaizviziva.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hauna kumbonzwa kana kunzwisisa;","poem":1},{"text":"kubva kare nzeve yako yakanga isina kudziurwa.","poem":2},{"text":"Ndinoziva kwazvo kuti uri munyengeri akadii;","poem":1},{"text":"wakanzi mhandu kubva pakuzvarwa kwako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuda kwezita rangu ndinononoka kutsamwa;","poem":1},{"text":"nokuda kwokurumbidzwa kwangu ndinozvidzora pamusoro pako,","poem":2},{"lineBreak":true},{"text":"kuti ndisakuparadza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tarira, ndakakunatsa, kunyange zvisina kuita sesirivha;","poem":1},{"text":"ndakakuedza muchoto chokutambudzika.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokuda kwangu, nokuda kwangu, ndinoita izvi.","poem":1},{"text":"Ko, ndingaregererei zita rangu richimhurwa?","poem":2},{"lineBreak":true},{"text":"Handingapi kukudzwa kwangu kuno mumwe.","poem":2}]},{"type":"heading","content":["Israeri inosunungurwa"]},{"type":"verse","number":12,"content":[{"text":"“Nditeerere, iwe Jakobho,","poem":1},{"text":"Israeri, wandakadaidza;","poem":2},{"text":"ndini iye:","poem":1},{"text":"ndini wokutanga uye ndini wokupedzisira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ruoko rwangu ndirwo rwakateya nheyo dzenyika,","poem":1},{"text":"uye ruoko rwangu rworudyi rwakatambanudza matenga;","poem":2},{"text":"pandinozvidana,","poem":1},{"text":"zvose zvinomira pamwe chete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Unganai pamwe chete, imi mose muteerere;","poem":1},{"text":"Ndechipiko chimwe chezvifananidzo chakakuudzai kuti zvinhu izvi zvichaitika?","poem":2},{"text":"Iye anodikanwa naJehovha","poem":1},{"text":"achaita zvakarongwa naJehovha pamusoro peBhabhironi;","poem":2},{"lineBreak":true},{"text":"ruoko rwake rucharwisa vaBhabhironi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ini, iyeni ndataura;","poem":1},{"text":"hongu, ndamudana.","poem":2},{"text":"Ndichauya naye,","poem":1},{"text":"uye achabudirira pane zvaanotumwa.","poem":2}]},{"type":"verse","number":16,"content":["“Swederai kwandiri muteerere izvi:",{"text":"“Kubvira pachiziviso chokutanga handina kumbotaura muchivande;","poem":1},{"text":"panguva yazvinoitika, ndinenge ndiripo.”","poem":2},{"lineBreak":true},{"text":"Uye zvino Ishe Jehovha andituma","poem":1},{"text":"noMweya wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zvanzi naJehovha","poem":1},{"text":"Mudzikinuri wako, Mutsvene waIsraeri:","poem":2},{"text":"“Ndini Jehovha Mwari wako,","poem":1},{"text":"anokudzidzisa zvinokubatsira,","poem":2},{"lineBreak":true},{"text":"anokutungamirira munzira yaunofanira kufamba nayo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dai chete wakanga wateerera mirayiro yangu,","poem":1},{"text":"rugare rwako rungadai rwakaita sorwizi,","poem":2},{"lineBreak":true},{"text":"kururama kwako samafungu egungwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zvizvarwa zvako zvingadai zvakaita sejecha,","poem":1},{"text":"navana vako vakaita setsanga dzejecha dzisingaverengeki;","poem":2},{"text":"zita ravo haraimboparara","poem":1},{"text":"kana kuparadzwa pamberi pangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mudai muBhabhironi,","poem":1},{"text":"tizai vaBhabhironi!","poem":2},{"text":"Zivisai izvi nomufaro mukuru,","poem":1},{"text":"uye muzviparidze.","poem":2},{"text":"Zvitumirei kumagumo enyika;","poem":1},{"text":"muti, “Jehovha adzikinura muranda wake Jakobho.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Havana kunzwa nyota paakavatungamirira mugwenga;","poem":1},{"text":"akaita kuti mvura iyerere ichibva mudombo, achiitira ivo;","poem":2},{"text":"akatsemura dombo","poem":1},{"text":"mvura ikatubuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Vakaipa havana rugare,” ndizvo zvinotaura Jehovha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}