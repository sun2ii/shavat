{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["Muranda waJehovha"]},{"type":"verse","number":1,"content":[{"text":"Ndinzwei, imi zviwi;","poem":1},{"text":"inzwai izvi, imi ndudzi dziri kure;","poem":2},{"text":"Jehovha akandidana ndisati ndaberekwa;","poem":1},{"text":"kubva pakuzvarwa kwangu akataura zita rangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akaita muromo wangu somunondo unopinza,","poem":1},{"text":"akandiviga mumumvuri wechanza chake;","poem":2},{"text":"akandiita museve unopenya,","poem":1},{"text":"akandiviga mugomba rake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akati kwandiri, “Ndiwe muranda wangu,","poem":1},{"text":"Israeri, wandicharatidza kubwinya kwangu maari.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asi ndakati, “Ndakashandira pasina,","poem":1},{"text":"ndapedza simba rangu pane zvisina maturo uye pasina.","poem":2},{"text":"Nyamba zvakandifanira ini zviri muruoko rwaJehovha,","poem":1},{"text":"uye mubayiro wangu uri kuna Mwari.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvino Jehovha anoti,","poem":1},{"text":"iye akandiumba ndiri muchizvaro kuti ndive muranda wake,","poem":2},{"text":"kuti ndidzorere Jakobho kwaari","poem":1},{"text":"uye kuti Israeri vaunganidzwezve kwaari,","poem":2},{"text":"nokuti ndinokudzwa pamberi paJehovha,","poem":1},{"text":"uye Mwari wangu ndiye anga ari simba rangu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"iye anoti:","poem":1},{"lineBreak":true},{"text":"“Chinhu chiduku kwazvo kuti iwe uve muranda wangu,","poem":1},{"text":"anomutsazve marudzi aJakobho","poem":2},{"lineBreak":true},{"text":"uye achadzosa avo vaIsraeri vandakachengeta.","poem":2},{"text":"Uyezve ndichakuita chiedza chevedzimwe ndudzi,","poem":1},{"text":"kuti uuyise ruponeso rwangu kumigumo yenyika.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zvanzi naJehovha,","poem":1},{"text":"Mudzikinuri noMutsvene waIsraeri,","poem":2},{"text":"kuna iye akanga azvidzwa uye akasemwa norudzi,","poem":1},{"text":"kumuranda wavatongi:","poem":2},{"text":"“Madzimambo achakuona agosimuka,","poem":1},{"text":"machinda achaona agokotamira pasi,","poem":2},{"text":"nokuda kwaJehovha akatendeka,","poem":1},{"text":"Mutsvene waIsraeri, akakusarudza.”","poem":2}]},{"type":"heading","content":["Israeri Inomutsiridzwa"]},{"type":"verse","number":8,"content":["Zvanzi naJehovha:",{"text":"“Munguva yangu yakafanira, ndichakupindura,","poem":1},{"text":"uye pazuva roruponeso ndichakubatsira;","poem":2},{"text":"ndichakuchengeta uye ndichakuita","poem":1},{"text":"kuti uve sungano yavanhu,","poem":2},{"text":"kuti uvandudze nyika","poem":1},{"text":"uye uvagarise patsva nhaka yakaparara,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kuti uti kunhapwa, ‘Budai,’","poem":1},{"text":"nokuna avo vari murima, ‘Uyai muchiedza!’","poem":2},{"lineBreak":true},{"text":"“Vachadya zvokudya parutivi rwenzira,","poem":1},{"text":"uye vachawana mafuro pazvikomo zvose zvisina zvibereko.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Havangavi nenzara kana nyota,","poem":1},{"text":"havangabayiwi nokupisa kwegwenga, kana nokupisa kwezuva.","poem":2},{"text":"Iye anovanzwira tsitsi achavatungamirira,","poem":1},{"text":"uye achavafambisa napazvitubu zvemvura.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndichashandura makomo angu ose kuti ave migwagwa,","poem":1},{"text":"uye migwagwa yangu mikuru ichasimudzirwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tarirai vachauya vachibva kure:","poem":1},{"text":"vamwe vachibva nechokumusoro, vamwe nechokumavirazuva,","poem":2},{"lineBreak":true},{"text":"vamwe nokurutivi rweAsiwani.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Imbai, imi matenga,","poem":1},{"text":"pembera iwe nyika;","poem":2},{"lineBreak":true},{"text":"imbai rwiyo imi makomo!","poem":2},{"text":"Nokuti Jehovha anonyaradza vanhu vake,","poem":1},{"text":"uye achava netsitsi navanhu vake vanotambudzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Asi Zioni rakati, “Jehovha akandisiya,","poem":1},{"text":"Jehovha akandikanganwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ko, mai vangakanganwa mucheche anonwa ari pachipfuva chavo,","poem":1},{"text":"uye vangasanzwira tsitsi mwana wavakazvara here?","poem":2},{"text":"Kunyange hazvo ivo vakakanganwa,","poem":1},{"text":"ini handizokukanganwi!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tarira, ndakakunyora pazvanza zvamaoko angu;","poem":1},{"text":"madziro ako anogara ari mberi kwangu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Vanakomana vako vanokurumidza kudzoka shure,","poem":1},{"text":"uye vose vaikuparadza vachabva kwauri.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Simudza meso ako utarise kwose kwose;","poem":1},{"text":"vanakomana vako vose vanoungana vachiuya kwauri.","poem":2},{"text":"Zvirokwazvo noupenyu hwangu,”","poem":1},{"text":"ndizvo zvinotaura Jehovha, “uchavafuka vose sezvishongo:","poem":2},{"lineBreak":true},{"text":"uchavapfeka, somwenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Kunyange wakaparadzwa ukaitwa dongo,","poem":1},{"text":"uye nyika yako yakasiyiwa yava dongo,","poem":2},{"text":"zvino vanhu vako havachakwani mauri,","poem":1},{"text":"uye vose vaikumedza vachava kure.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Vana vakaberekwa panguva yokufirwa kwako","poem":1},{"text":"vachatizve munzeve dzako,","poem":2},{"text":"‘Nzvimbo iyi yava diki kwatiri:","poem":1},{"text":"tipeiwo nzvimbo yakatambanuka yatingagara.’","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ipapo uchati mumwoyo mako,","poem":1},{"text":"‘Ndianiko akandiberekera ava?","poem":2},{"text":"Ndakanga ndafirwa uye ndisina mwana;","poem":1},{"text":"ndakanga ndadzingwa uye ndarambwa.","poem":2},{"lineBreak":true},{"text":"Ndianiko akarera ava?","poem":2},{"text":"Ndakasiyiwa ndiri ndoga,","poem":1},{"text":"asi ava, vabvepiko?’ ”","poem":2}]},{"type":"verse","number":22,"content":["Zvanzi naIshe Jehovha,",{"text":"“Tarira ndichasimudza ruoko rwangu kune veDzimwe Ndudzi,","poem":1},{"text":"ndichasimudzira mureza wangu kumarudzi;","poem":2},{"text":"vachauya navanakomana vako vari mumaoko avo,","poem":1},{"text":"uye vachatakura vanasikana vako pamapfudzi avo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Madzimambo achava madzibaba anokurerai,","poem":1},{"text":"uye vanamambokadzi vavo vachava vanamai vanokurerai.","poem":2},{"text":"Vachakupfugamirai uso hwavo hwakatsikitsira pasi,","poem":1},{"text":"vachananzva guruva patsoka dzenyu.","poem":2},{"text":"Ipapo muchaziva kuti ndini Jehovha;","poem":1},{"text":"vanovimba neni havachazonyadziswi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ko, mhare ingapambwa here,","poem":1},{"text":"kana vatapwa vanganunurwa kubva kune anotyisa here?","poem":2}]},{"type":"verse","number":25,"content":["Asi zvanzi naJehovha,",{"text":"“Hongu vatapwa vachatorwa kubva kumhare,","poem":1},{"text":"uye zvakapambwa kubva kune anotyisa;","poem":2},{"text":"ndicharwa nevanorwa newe,","poem":1},{"text":"uye vana vako ndichavaponesa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndichaita kuti vamanikidzi vako vadye nyama yavo;","poem":1},{"text":"vachadhakwa neropa ravo, sevadhakwa newaini.","poem":2},{"text":"Ipapo vanhu vose vachaziva kuti ini Jehovha,","poem":1},{"text":"ndini Muponesi wako,","poem":2},{"lineBreak":true},{"text":"Mudzikinuri wako, Wamasimba Ose waJakobho.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}