{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["Rwiyo rwoMunda weMizambiringa"]},{"type":"verse","number":1,"content":[{"text":"Ndichaimbira mudiwa wangu","poem":1},{"text":"rwiyo pamusoro pomunda wake wemizambiringa:","poem":2},{"text":"Mudiwa wangu akanga ane munda wake wemizambiringa,","poem":1},{"text":"pachikomo chakaorera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akautimbira akabvisa mabwe","poem":1},{"text":"akasimamo mazambiringa akaisvonaka.","poem":2},{"text":"Akavaka shongwe mukati mawo","poem":1},{"text":"uye akauchererawo chisviniro chewaini.","poem":2},{"text":"Ipapo akatarisa kuti awane zvibereko zvamazambiringa akanaka,","poem":1},{"text":"asi iwo wakangobereka muchero wakaipa chete.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Zvino imi vagari vomuJerusarema nemi varume veJudha,","poem":1},{"text":"chitongai pakati pangu nomunda wemizambiringa wangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Chiiko chimwezve chaifanira kuitirwa munda wangu","poem":1},{"text":"wemizambiringa chandisina kuuitira?","poem":2},{"text":"Pandakatsvaka mazambiringa akanaka,","poem":1},{"text":"wakagoberekerei akaipa oga?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvino ndichakuudzai","poem":1},{"text":"zvandichaitira munda wangu wemizambiringa:","poem":2},{"text":"Ndichabvisa ruzhowa rwawo,","poem":1},{"text":"ugoparadzwa;","poem":2},{"text":"ndichaputsa rusvingo rwawo,","poem":1},{"text":"ugochatsikwa-tsikwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndichauita nzvimbo yamarara,","poem":1},{"text":"hauzochekererwi kana kusakurirwa,","poem":2},{"lineBreak":true},{"text":"uye minzwa norukato zvichakuramo.","poem":2},{"text":"Ndicharayira makore kuti","poem":1},{"text":"arege kunayisa mvura pamusoro pawo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Munda womuzambiringa waJehovha Wamasimba Ose","poem":1},{"text":"ndiwo imba yaIsraeri,","poem":2},{"text":"uye varume veJudha","poem":1},{"text":"ndivo bindu rake rinomufadza.","poem":2},{"text":"Zvino akatarisira kururamisira asi akaona kuteuka kweropa;","poem":1},{"text":"akatsvaka kururuma, asi akanzwa kuchema kwokutambudzika.","poem":2}]},{"type":"heading","content":["Nhamo noKutongwa"]},{"type":"verse","number":8,"content":[{"text":"Mune nhamo imi munowedzera dzimba nedzimba","poem":1},{"text":"uye munobatanidza munda nomunda,","poem":2},{"text":"kusvikira pasisina nzvimbo yasara,","poem":1},{"text":"mugogara moga munyika.","poem":2}]},{"type":"verse","number":9,"content":["Jehovha Wamasimba Ose akataura ndichinzwa akati,",{"text":"“Zvirokwazvo dzimba zhinji dzichava matongo,","poem":1},{"text":"dzimba huru dzakanaka dzichashaya vanogaramo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maeka gumi omunda wemizambiringa achabereka bhati rimwe chete","poem":1},{"noteId":0},{"text":"rewaini,","poem":1},{"text":"uye homeri","poem":2},{"noteId":1},{"text":"rembeu richabereka efa","poem":2},{"noteId":2},{"text":"imwe chete rezviyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Vane nhamo avo vanomuka mangwanani","poem":1},{"text":"kuti vatsvake doro rinodhaka,","poem":2},{"text":"vanogara kusvikira usiku,","poem":1},{"text":"kusvikira vapengeswa newaini.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vanenge vane rudimbwa,","poem":1},{"text":"nemitengeranwa pamabiko avo,","poem":2},{"text":"namatambureni, nenyere newaini,","poem":1},{"text":"asi havana hanya namabasa aJehovha, havana rukudzo nebasa ramaoko ake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Naizvozvo vanhu vangu vachapinda muutapwa,","poem":1},{"text":"nokuda kwokushayiwa zivo;","poem":2},{"text":"vanokudzwa vavo vachafa nenzara,","poem":1},{"text":"uye vazhinji vavo vachafa nenyota.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Naizvozvo gehena rakawedzera kukara kwaro,","poem":1},{"text":"uye rakazarura muromo waro zvinodarika mwero;","poem":2},{"text":"mariri muchaburukira vanokudzwa vavo nevoruzhinji,","poem":1},{"text":"navose vanokakavara vavo navanofara vavo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Naizvozvo munhuwo zvake achadzikiswa,","poem":1},{"text":"marudzi avanhu achaninipiswa,","poem":2},{"lineBreak":true},{"text":"nameso avanozvikudza achaninipiswa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asi Jehovha Wamasimba Ose achakudzwa, nokuda kwokururamisira kwake, uye Mwari,","poem":1},{"text":"mutsvene achazviratidza pachake kuti mutsvene, mukururama kwake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ipapo makwai achafura saari mumafuro awo;","poem":1},{"text":"makwayana achadya pakati pamatongo avapfumi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Vane nhamo avo vanokweva chivi nerwodzi rwokunyengera,","poem":1},{"text":"uye zvakaipa sezvinenge mabote engoro,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"uye nevanoti, “Mwari ngaakurumidze,","poem":1},{"text":"ngaachimbidzike nebasa","poem":2},{"lineBreak":true},{"text":"rake kuti tirione.","poem":2},{"text":"Ngarisvike,","poem":1},{"text":"urongwa hwoMutsvene waIsraeri ngahuuye,","poem":2},{"lineBreak":true},{"text":"kuti tihuzive.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Vane nhamo avo vanoti zvakaipa","poem":1},{"text":"ndizvo zvakanaka,","poem":2},{"text":"uye zvakanaka ndizvo zvakaipa,","poem":1},{"text":"vanoisa rima panzvimbo yechiedza nechiedza panzvimbo yerima,","poem":2},{"text":"vanoisa zvinovava panzvimbo yezvinotapira,","poem":1},{"text":"nezvinotapira panzvimbo yezvinovava.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Vane nhamo avo vanoti vakachenjera pameso avo,","poem":1},{"text":"uye vakangwara pakuona kwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Vane nhamo avo vanova mhare pakunwa waini,","poem":1},{"text":"uye shasha pakuvhenganisa zvokunwa zvinodhaka,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"vanopembedza ane mhosva nokuda kwefufuro,","poem":1},{"text":"asi vanoramba kururamisira vasina mhosva.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Naizvozvo, samarimi omoto anonanzva mashanga,","poem":1},{"text":"uye souswa hwakaoma hunomedzwa nemirazvo yemoto,","poem":2},{"text":"naizvozvo midzi yavo ichaora","poem":1},{"text":"uye maruva avo achapeperetswa seguruva;","poem":2},{"text":"nokuti vakaramba murayiro waJehovha Wamasimba Ose,","poem":1},{"text":"uye vakazvidza shoko roMutsvene waIsraeri.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Naizvozvo kutsamwa kwaJehovha kwopfuta pamusoro pavanhu vake;","poem":1},{"text":"ruoko rwake rwasimudzwa uye anovarovera pasi.","poem":2},{"text":"Makomo anozungunuka,","poem":1},{"text":"uye mitumbi yavakafa yaita samarara mumigwagwa.","poem":2},{"lineBreak":true},{"text":"Kunyange zvakadaro nokuda kwezvose izvi,","poem":1},{"text":"kutsamwa kwake hakuna kudzorwa, ruoko rwake rwaramba rwakasimudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Anosimudzira ndudzi dziri kure mureza,","poem":1},{"text":"anoridzira muridzo kuna avo vari kumigumo yenyika.","poem":2},{"text":"Havo vouya, nokukurumidza","poem":1},{"text":"uye nokuchimbidzika!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Hapana kana mumwe wavo anoneta kana kugumburwa,","poem":1},{"text":"hapana kana mumwe wavo achakotsira kana kuvata;","poem":2},{"text":"hapana kana bhanhire richasunungurwa pachiuno,","poem":1},{"text":"hapana kana rukanda rweshangu ruchadambuka.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Miseve yavo inopinza,","poem":1},{"text":"uta hwavo hwose hwakakungwa;","poem":2},{"text":"mahwanda amabhiza avo anenge omusarasara,","poem":1},{"text":"mavhiri engoro dzavo akaita sechamupupuri.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kuomba kwavo kwakaita sokweshumba,","poem":1},{"text":"vanoomba kufanana neshumba diki;","poem":2},{"text":"vanodzvova pavanobata mhuka yavo","poem":1},{"text":"vagoitakura pasina kana angairwira.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Pazuva iro vachaomba pamusoro payo,","poem":1},{"text":"sokutinhira kwegungwa.","poem":2},{"text":"Uye kana mumwe akatarisa panyika,","poem":1},{"text":"achaona rima nokutambudzika;","poem":2},{"lineBreak":true},{"text":"kunyange chiedza chichasvibiswa namakore.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"marita angaita 22","reference":{"chapter":5,"verse":10}},{"noteId":1,"caller":"+","text":"marita angaita 220","reference":{"chapter":5,"verse":10}},{"noteId":2,"caller":"+","text":"marita angaita 22","reference":{"chapter":5,"verse":10}}]},"thisChapterLink":"/api/sna_bib/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}