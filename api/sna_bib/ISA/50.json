{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["Chivi chaIsraeri noKuteerera kwoMuranda"]},{"type":"verse","number":1,"content":["Zvanzi naJehovha:",{"text":"“Ko, rugwaro rwokurambwa","poem":1},{"text":"kwamai venyu rwuripiko rwandakavadzinga narwo?","poem":2},{"text":"Uye ndevapiko vandakakwereta","poem":1},{"text":"ndikazokutengesai kwavari?","poem":2},{"text":"Makatengeswa nokuda kwezvivi zvenyu;","poem":1},{"text":"mai venyu vakadzingwa nokuda kwokudarika kwenyu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sei ndakashaya munhu, pandakauya?","poem":1},{"text":"Sei pasina akapindura pandakadana?","poem":2},{"text":"Ko, ruoko rwangu rwakanga rwakapfupika here kuti ndikudzikinurei?","poem":1},{"text":"Handina simba rokukununurai here?","poem":2},{"text":"Nokungorayira chete ndinopwisa gungwa;","poem":1},{"text":"ndinoshandura nzizi dzikava gwenga;","poem":2},{"text":"hove dzadzo dzinoora nokushayiwa mvura,","poem":1},{"text":"uye dzinofa nenyota.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndinoshongedza denga nerima","poem":1},{"text":"uye ndinoita masaga chifukidzo charo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ishe Jehovha akandipa rurimi rwakadzidziswa,","poem":1},{"text":"kuziva shoko rinosimbisa vakarukutika.","poem":2},{"text":"Anondimutsa mangwanani namangwanani,","poem":1},{"text":"anomutsa nzeve yangu kuti iteerere somunhu anodzidziswa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ishe Jehovha akazarura nzeve dzangu,","poem":1},{"text":"uye handina kumumukira;","poem":2},{"lineBreak":true},{"text":"handina kudzokera shure.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndakapa musana wangu kuna avo vaindirova,","poem":1},{"text":"namatama angu kuna avo vakadzura ndebvu dzangu;","poem":2},{"text":"Handina kuvanza chiso changu","poem":1},{"text":"pakusekwa nokupfirwa mate.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nokuti Ishe Jehovha anondibatsira,","poem":1},{"text":"handizonyadziswi.","poem":2},{"text":"Naizvozvo ndakaita kuti chiso changu chive sebwe romusarasara,","poem":1},{"text":"uye ndinoziva kuti handizonyadziswi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iye anondiruramisira ari pedyo.","poem":1},{"text":"Ndianiko zvino achandipa mhosva?","poem":2},{"lineBreak":true},{"text":"Ngatitarisanei!","poem":2},{"text":"Ndianiko mupomeri wangu?","poem":1},{"text":"Ngaanangane neni!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndiye Ishe Jehovha anondibatsira.","poem":1},{"text":"Ndianiko achandipa mhosva?","poem":2},{"text":"Vose vachasakara senguo;","poem":1},{"text":"vachadyiwa nezvipfuno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndiani pakati penyu anotya Jehovha,","poem":1},{"text":"uye anoteerera shoko romuranda wake?","poem":2},{"text":"Ngaafambe murima,","poem":1},{"text":"iye asina chiedza,","poem":2},{"text":"ngaavimbe nezita raJehovha","poem":1},{"text":"uye avimbe naMwari wake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asi zvino, imi mose munotungidza moto","poem":1},{"text":"muchava nemwenje inopfuta,","poem":2},{"text":"endai, mufambe muchiedza chomoto","poem":1},{"text":"wenyu nechemwenje yamakabatidza.","poem":2},{"text":"Izvi ndizvo zvamuchagamuchira kubva paruoko rwangu:","poem":1},{"text":"Muchavata pasi mukurwadziwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}