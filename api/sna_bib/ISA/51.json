{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Ruponeso Rwokusingaperi rweZioni"]},{"type":"verse","number":1,"content":[{"text":"Nditeererei, imi munotevera kururama","poem":1},{"text":"uye munotsvaka Jehovha:","poem":2},{"text":"Tarirai kudombo ramakabviswa pariri","poem":1},{"text":"naparuware pamakacherwa;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"tarirai kuna Abhurahama, baba venyu,","poem":1},{"text":"nokuna Sara, akakuberekai.","poem":2},{"text":"Pandakamudana akanga achingova mumwe chete,","poem":1},{"text":"ndikamuropafadza ndikamuita vazhinji.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zvirokwazvo Jehovha achanyaradza Zioni,","poem":1},{"text":"uye achatarira netsitsi pamusoro pamatongo aro ose;","poem":2},{"text":"achaita magwenga aro kuti afanane neEdheni,","poem":1},{"text":"marenje aro achafanana nebindu raJehovha.","poem":2},{"text":"Kupembera nomufaro zvichawanikwa mariri,","poem":1},{"text":"kuvonga nenzwi rokuimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nditeererei, imi vanhu vangu;","poem":1},{"text":"ndinzwei imi rudzi rwangu:","poem":2},{"text":"Ndichakupai murayiro;","poem":1},{"text":"kururamisira kwangu kuchava chiedza kundudzi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kururama kwangu kwoswedera pedyo nokukurumidza,","poem":1},{"text":"ruponeso rwangu rwuri munzira,","poem":2},{"lineBreak":true},{"text":"uye ruoko rwangu ruchauyisa kururamisira kundudzi.","poem":2},{"text":"Zviwi zvichatarira kwandiri","poem":1},{"text":"uye zvichamirira ruoko rwangu netariro.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Simudzirai meso enyu kumatenga,","poem":1},{"text":"tarirai pasi panyika;","poem":2},{"text":"matenga achanyangarika soutsi,","poem":1},{"text":"nyika ichasakara senguo,","poem":2},{"lineBreak":true},{"text":"uye vanogaramo vachafa senhunzi.","poem":2},{"text":"Asi ruponeso rwangu ruchagara nokusingaperi,","poem":1},{"text":"kururama kwangu hakuzombogumi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ndinzwei, imi munoziva zvakarurama,","poem":1},{"text":"imi vanhu vane murayiro wangu mumwoyo yenyu:","poem":2},{"text":"Musatya kuzvidza kwavanhu,","poem":1},{"text":"uye musavhundutswa nokutuka kwavo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nokuti chipfuno chichavadya senguo;","poem":1},{"text":"honye ichavadya sewuru.","poem":2},{"text":"Asi kururama kwangu kuchagara nokusingaperi,","poem":1},{"text":"ruponeso rwangu kuzvizvarwa zvose.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Muka, muka! Zvishongedze nesimba,","poem":1},{"text":"iwe ruoko rwaJehovha;","poem":2},{"text":"muka, sepamazuva akare,","poem":1},{"text":"sepazvizvarwa zvakare.","poem":2},{"text":"Ko, hausiwe wakagura-gura Rahabhi,","poem":1},{"text":"ukabaya chikara chiya here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hausiwe wakaomesa gungwa here,","poem":1},{"text":"iyo mvura yokwakadzika zvikuru,","poem":2},{"text":"ukaita mugwagwa makadzika megungwa","poem":1},{"text":"kuitira kuti vakadzikinurwa vayambuke?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vakasunungurwa vaJehovha vachadzoka.","poem":1},{"text":"Vachapinda muZioni vachiimba;","poem":2},{"lineBreak":true},{"text":"mufaro usingaperi uchava korona pamisoro yavo.","poem":2},{"text":"Mufaro nokupembera zvichafashukira,","poem":1},{"text":"uye kusuwa nokukahadzika zvichatiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ini, iyeni, ndini iye anokunyaradzai.","poem":1},{"text":"Ndiwe aniko unotya vanhu vanofa,","poem":2},{"lineBreak":true},{"text":"vanakomana vavanhu, ivo uswa zvahwo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kuti ukanganwe Jehovha Muiti wako,","poem":1},{"text":"akatatamura matenga,","poem":2},{"lineBreak":true},{"text":"akateya nheyo dzenyika,","poem":2},{"text":"kuti ugare uchitya mazuva ose","poem":1},{"text":"nokuda kwehasha dzomumanikidzi,","poem":2},{"lineBreak":true},{"text":"uyo akarerekera kukuparadza?","poem":2},{"text":"Ko, hasha dzomumanikidzi dziripi?","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Vasungwa vakatapwa vachakurumidza kusunungurwa;","poem":2},{"text":"havazofiri mumakomba avo,","poem":1},{"text":"kana kuzoshayiwa chingwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nokuti ndini Jehovha Mwari wako,","poem":1},{"text":"anomutsa gungwa kuti mafungu aro atinhire,","poem":2},{"lineBreak":true},{"text":"Jehovha Wamasimba Ose ndiro zita rake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndakaisa mashoko angu mumuromo mako,","poem":1},{"text":"ndikakufukidza nomumvuri woruoko rwangu,","poem":2},{"text":"iyeni ndakagadzika matenga panzvimbo yawo,","poem":1},{"text":"iyeni ndakateya nheyo dzenyika,","poem":2},{"lineBreak":true},{"text":"uye ndinoti kuZioni, ‘Muri vanhu vangu.’ ”","poem":2}]},{"type":"heading","content":["Mukombe weHasha dzaJehovha"]},{"type":"verse","number":17,"content":[{"text":"Muka, muka! Simuka,","poem":1},{"text":"iwe Jerusarema,","poem":2},{"text":"iwe wakanwa kubva muruoko rwaJehovha,","poem":1},{"text":"mukombe wehasha dzake,","poem":2},{"text":"iwe wakasveta kusvikira wapera kuti tsvai,","poem":1},{"text":"iwo mukombe unoita kuti vanhu vadzedzereke.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pavanakomana vose","poem":1},{"text":"vaakabereka pakanga pasina anomutungamirira;","poem":2},{"text":"pavanakomana vose vaakarera","poem":1},{"text":"pakanga pasina aimusesedza noruoko rwake.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Njodzi mbiri idzi dzauya pamusoro pako,","poem":1},{"text":"ndianiko angakunyaradza? Dzinoti:","poem":2},{"text":"kuva dongo nokuparadzwa, nzara nomunondo;","poem":1},{"text":"ndianiko anogona kukunyaradza?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Vanakomana vako vaziya;","poem":1},{"text":"vanovata panotangira migwagwa,","poem":2},{"lineBreak":true},{"text":"kufanana nemhara yabatwa mumumbure.","poem":2},{"text":"Vakazadzwa nehasha dzaJehovha","poem":1},{"text":"nokutuka kwaMwari wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Naizvozvo inzwa izvi,","poem":1},{"text":"iwe munhu wokutambudzika, wakadhakiswa asi kwete newaini.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Zvanzi naIshe Jehovha Mwari wako,","poem":1},{"text":"anodzivirira vanhu vake,","poem":2},{"text":"“Tarira, ndabvisa muruoko rwako mukombe wakakuita kuti udzedzereke;","poem":1},{"text":"kubva pamukombe uyo,","poem":2},{"text":"iwo mukombe wehasha dzangu,","poem":1},{"text":"hauchazounwizve.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndichauisa mumaoko avatambudzi vako,","poem":1},{"text":"ivo vanoti kwauri,","poem":2},{"lineBreak":true},{"text":"‘Zvambarara pasi kuti tifambe napamusoro pako.’","poem":2},{"text":"Iwe wakaita kuti musana wako uve sapasi,","poem":1},{"text":"kufanana nomugwagwa unofambwa nawo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}