{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Muka, muka iwe Zioni,","poem":1},{"text":"zvifukidze nesimba.","poem":2},{"text":"Fuka nguo dzako dzakanakisa,","poem":1},{"text":"iwe Jerusarema, guta dzvene.","poem":2},{"text":"Vasina kudzingiswa navakasvibiswa","poem":1},{"text":"havachapindizve mauri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zunza guruva rako: simuka,","poem":1},{"text":"ugare paushe, iwe Jerusarema.","poem":2},{"text":"Zvisunungure pangetani dziri pamutsipa wako,","poem":1},{"text":"iwe nhapwa, Mwanasikana weZioni.","poem":2}]},{"type":"verse","number":3,"content":["Nokuti zvanzi naJehovha,",{"text":"“Wakatengeswa pasina mutengo,","poem":1},{"text":"uye uchadzikinurwa pasina mari.”","poem":2}]},{"type":"verse","number":4,"content":["Nokuti zvanzi naIshe Jehovha,",{"text":"“Pakutanga vanhu vangu vakaenda kuIjipiti kundogarako;","poem":1},{"text":"iye zvino Asiria inovamanikidza.","poem":2}]},{"type":"verse","number":5,"content":["“Uye zvino ndinei pano?” ndizvo zvinotaura Jehovha.",{"text":"“Nokuti vanhu vangu vakabviswa pasina,","poem":1},{"text":"uye avo vanovatonga vanovaseka,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"“Uye zuva rose","poem":1},{"text":"zita rangu rinogara richimhurwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naizvozvo vanhu vangu vachaziva zita rangu;","poem":1},{"text":"naizvozvo pazuva iro vachaziva","poem":2},{"text":"kuti ndini ndakazvitaura.","poem":1},{"text":"Hongu, ndini iye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dzakanaka sei pamusoro pamakomo","poem":1},{"text":"tsoka dzavanouya namashoko akanaka,","poem":2},{"text":"vanoparidza rugare,","poem":1},{"text":"vanouya namashoko akanaka,","poem":2},{"lineBreak":true},{"text":"vanoparidza ruponeso,","poem":2},{"text":"vanoti kuZioni,","poem":1},{"text":"“Mwari wako anotonga!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Chinzwa! Nharirire dzako dzinodanidzira namanzwi adzo;","poem":1},{"text":"vanopembera nomufaro pamwe chete.","poem":2},{"text":"Panodzokera Jehovha kuZioni,","poem":1},{"text":"vachazviona nameso avo pachavo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pururudzai muimbe nziyo dzomufaro pamwe chete,","poem":1},{"text":"imi matongo eJerusarema,","poem":2},{"text":"nokuti Jehovha anyaradza vanhu vake,","poem":1},{"text":"akadzikinura Jerusarema.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jehovha acharatidza ruoko rwake rutsvene","poem":1},{"text":"pamberi pendudzi dzose,","poem":2},{"text":"uye magumo ose enyika achaona","poem":1},{"text":"ruponeso rwaMwari wedu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ibvai, ibvai, budai ikoko!","poem":1},{"text":"Musabata chinhu chine tsvina!","poem":2},{"text":"Budaimo mugova vakachena,","poem":1},{"text":"imi munotakura midziyo yaJehovha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi hamungazobudi nokukurumidza","poem":1},{"text":"kana kuenda muchitiza;","poem":2},{"text":"nokuti Jehovha achakutungamirirai,","poem":1},{"text":"Mwari waIsraeri achakurindai mushure.","poem":2}]},{"type":"heading","content":["Kutambudzika noKukudzwa kwoMuranda"]},{"type":"verse","number":13,"content":[{"text":"Tarirai muranda wangu achaita nouchenjeri;","poem":1},{"text":"achasimudzirwa uye achakwidzwa pamusoro, uye achakudzwa kwazvo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sezvo vazhinji vakashamiswa naye,","poem":1},{"text":"chiso chake chakanga chakakuvadzwa zvikuru, kupfuura chomunhu upi zvake,","poem":2},{"lineBreak":true},{"text":"uye chimiro chake chakanga chakanganiswa, kupfuura kuratidzika kwomunhu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"saka iye achasasa ndudzi zhinji,","poem":1},{"text":"uye madzimambo achafumbira miromo nokuda kwake.","poem":2},{"text":"Nokuti zvavakanga vasina kuudzwa, vachazviona,","poem":1},{"text":"uye zvavasina kumbonzwa, vachazvinzwisisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}