{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Ndianiko akatenda zvatakaparidza,","poem":1},{"text":"uye ruoko rwaJehovha rwakaratidzwa kuna aniko?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akamera pamberi pake sebukira nyoro,","poem":1},{"text":"uye somudzi pavhu rakaoma.","poem":2},{"text":"Akanga asina runako kana chimiro choumambo kuti atikwezve kwaari,","poem":1},{"text":"hapana chatingada pakuratidzika kwake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akazvidzwa uye akarambwa navanhu, murume wokusuwa,","poem":1},{"text":"uye anoziva kutambudzika.","poem":2},{"text":"Somunhu anovanzirwa chiso navanhu, akazvidzwa,","poem":1},{"text":"uye isu hatina kumukudza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zvirokwazvo akatakura matenda edu,","poem":1},{"text":"uye akatakura kurwadziswa kwedu;","poem":2},{"text":"asi isu takafunga kuti akarohwa naMwari,","poem":1},{"text":"akarohwa naye uye akarwadziswa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asi akabayiwa nokuda kwokudarika kwedu,","poem":1},{"text":"akakuvadzwa nokuda kwezvakaipa zvedu;","poem":2},{"text":"kurohwa kwakativigira rugare kwaiva pamusoro pake,","poem":1},{"text":"uye namavanga ake takaporeswa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isu tose takanga takarasika samakwai,","poem":1},{"text":"mumwe nomumwe nenzira yake,","poem":2},{"text":"asi Jehovha akaisa pamusoro pake","poem":1},{"text":"kuipa kwedu tose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Akamanikidzwa uye akarwadziswa,","poem":1},{"text":"asi haana kushamisa muromo wake;","poem":2},{"text":"akatungamirirwa segwayana riri kundobayiwa,","poem":1},{"text":"uye sokunyarara kwegwai pamberi pomuveuri waro,","poem":2},{"lineBreak":true},{"text":"saizvozvo haana kushamisa muromo wake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akabviswa achimanikidzwa uye akatongwa.","poem":1},{"text":"Uye ndianiko angataura rudzi rwake?","poem":2},{"text":"Nokuti akagurwa kubva panyika yavapenyu,","poem":1},{"text":"nokuda kwokudarika kwavanhu vangu, akarohwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akapiwa guva rake pakati pavatadzi,","poem":1},{"text":"uye akava navapfumi pakufa kwake,","poem":2},{"text":"kunyange akanga asina kuita zvechisimba,","poem":1},{"text":"uye kunyengera kusina kuwanikwa mumuromo make.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Asi kwakanga kuri kuda kwaJehovha kuti amukuvadze uye aite kuti atambudzike,","poem":1},{"text":"uye kunyange zvazvo Jehovha akaita kuti upenyu hwake huve chipiriso chezvivi,","poem":2},{"text":"achaona zvibereko zvake uye achawedzera mazuva ake,","poem":1},{"text":"uye kuda kwaJehovha kuchabudirira muruoko rwake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shure kwokutambudzika kwomweya wake,","poem":1},{"text":"achaona chiedza choupenyu uye achagutsikana;","poem":2},{"text":"nokuziva kwake, muranda wangu akarurama acharuramisira vazhinji,","poem":1},{"text":"uye achatakura kuipa kwavo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naizvozvo ndichamupa mugove pakati pavakuru vakuru,","poem":1},{"text":"uye achagoverana zvakapambwa navane simba,","poem":2},{"text":"nokuti akadurura upenyu hwake kusvika parufu,","poem":1},{"text":"akaverengwa pamwe chete navadariki.","poem":2},{"text":"Nokuti akatakura chivi chavazhinji,","poem":1},{"text":"akanyengeterera vadariki.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}