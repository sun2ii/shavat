{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["Kubwinya kuchaita Zioni"]},{"type":"verse","number":1,"content":[{"text":"“Imba, iwe mukadzi asina mwana,","poem":1},{"text":"iwe usina kumbobereka mwana","poem":2},{"text":"pururudza uimbe rwiyo, pembera nomufaro,","poem":1},{"text":"iwe usina kumborwadziwa;","poem":2},{"text":"nokuti vana vomukadzi akasiyiwa ari oga vazhinji kupfuura","poem":1},{"text":"veane murume,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wedzera nzvimbo yetende rako,","poem":1},{"text":"tambanudza micheka yetende rako ifare,","poem":2},{"lineBreak":true},{"text":"usarega kuita izvozvo;","poem":2},{"text":"rebesa tambo dzako,","poem":1},{"text":"simbisa mbambo dzako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti uchapararira kurudyi nokuruboshwe;","poem":1},{"text":"vana vako vachatorera dzimwe ndudzi","poem":2},{"lineBreak":true},{"text":"uye vachagara mumatongo amaguta avo.","poem":2}]},{"type":"verse","number":4,"content":["“Usatya hako: haunganyadziswi.",{"text":"Usatya kunyadziswa; haunganinipiswi.","poem":2},{"text":"Uchakanganwa nyadzi dzapaudiki hwako,","poem":1},{"text":"uye hauzorangaririzve kunyadzisa kwouchirikadzi hwako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nokuti Muiti wako ndiye murume wako,","poem":1},{"text":"Jehovha Wamasimba Ose ndiro zita rake,","poem":2},{"text":"Mutsvene waIsraeri ndiye Mudzikinuri wako;","poem":1},{"text":"anonzi Mwari wenyika yose.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jehovha achakudanazve","poem":1},{"text":"sokunge wanga uri mukadzi akasiyiwa, uye anotambudzika pamweya,","poem":2},{"text":"mukadzi akawanikwa achiri mudiki,","poem":1},{"text":"pedzezvo ndokurambwa,” ndizvo zvinotaura Mwari wako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Kwechinguvana ndakakusiya,","poem":1},{"text":"asi netsitsi huru ndikakudzosazve.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndichisundwa nehasha","poem":1},{"text":"ndakavanza chiso changu kwauri kwechinguva,","poem":2},{"text":"asi nounyoro husingaperi","poem":1},{"text":"ndichava netsitsi, pamusoro pako,”","poem":2},{"lineBreak":true},{"text":"ndizvo zvinotaura Jehovha Mudzikinuri wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kwandiri izvi zvakafanana namazuva aNoa,","poem":1},{"text":"pandakapika kuti mvura zhinji yaNoa haizofukidzizve nyika.","poem":2},{"text":"Naizvozvo zvino ndapika kuti ndirege kukutsamwira,","poem":1},{"text":"kana kukutukazve.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kunyange makomo akazungunuswa,","poem":1},{"text":"uye zvikomo zvikabviswa,","poem":2},{"text":"rudo rwangu rusingaperi harungazungunuswi,","poem":1},{"text":"uye sungano yangu yorugare haingabviswi,”","poem":2},{"lineBreak":true},{"text":"ndizvo zvinotaura Jehovha anokunzwira tsitsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Haiwa, iwe guta rokutambudzika wakarohwa nedutu ukasanyaradzwa,","poem":1},{"text":"ndichakuvaka namabwe ana mavara,","poem":2},{"lineBreak":true},{"text":"nheyo dzako namabwe esafire.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndichakuitira zviruvi zvamabwe matsvuku,","poem":1},{"text":"masuo amabwe anovaima,","poem":2},{"lineBreak":true},{"text":"uye masvingo ako ose amabwe anokosha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vanakomana venyu vose vachadzidziswa naJehovha,","poem":1},{"text":"uye rugare rwavana venyu ruchava rukuru.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Muchasimbiswa mukururama:","poem":1},{"lineBreak":true},{"text":"Kumanikidzwa kuchava kure nemi:","poem":1},{"text":"hapana chamuchazotya.","poem":2},{"text":"Kutya kuchava kure nemi;","poem":1},{"text":"hakuchazosviki pedyo nemi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kana mumwe akakurwisa, handisini ndinenge ndazviita;","poem":1},{"text":"ani naani anokurwisa achazvipira kwauri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Tarira, ndini ndakasika mupfuri wesimbi","poem":1},{"text":"anopfutidza mazimbe moto ugonganduma,","poem":2},{"lineBreak":true},{"text":"uye anopfura munondo wakakodzera pabasa rawo.","poem":2},{"text":"Uye ndini ndakasika muparadzi kuti aparadze;","poem":1}]},{"type":"verse","number":17,"content":[{"text":"hapana munondo ucharwisana newe ukakunda,","poem":2},{"lineBreak":true},{"text":"uye uchakonesa rurimi rumwe norumwe runokupomera mhosva.","poem":2},{"text":"Iyi ndiyo nhaka yavaranda vaJehovha,","poem":1},{"text":"uye uku ndiko kururamisirwa kwavo kunobva kwandiri,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}