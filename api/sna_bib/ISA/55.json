{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Kukokwa kwaVane Nyota"]},{"type":"verse","number":1,"content":[{"text":"“Uyai imi mose mune nyota,","poem":1},{"text":"uyai kumvura zhinji;","poem":2},{"text":"nemi musina mari, uyai,","poem":1},{"text":"mutenge uye mudye!","poem":2},{"text":"Uyai mutenge waini nomukaka","poem":1},{"text":"pasina mari uye pasina mutengo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ko, munopedzerei mari pazvinhu zvisati zviri zvokudya,","poem":1},{"text":"nesimba renyu pazvinhu zvisingagutsi?","poem":2},{"text":"Teererai, nditeererei mugodya zvakanaka,","poem":1},{"text":"uye mweya yenyu ichafarira zvakakora zvezvakanaka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rerekai nzeve yenyu muuye kwandiri;","poem":1},{"text":"ndinzwei kuti mweya yenyu irarame.","poem":2},{"text":"Ndichaita sungano isingaperi nemi,","poem":1},{"text":"iko kutendeka kworudo rwangu rwakavimbiswa kuna Dhavhidhi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tarirai, ndakamuita chapupu kumarudzi,","poem":1},{"text":"mutungamiri nomukuru wamarudzi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvirokwazvo uchakoka ndudzi dzausina kumboziva,","poem":1},{"text":"uye ndudzi dzisingakuzive dzichamhanyira kwauri,","poem":2},{"text":"nokuda kwaJehovha Mwari wako,","poem":1},{"text":"Mutsvene waIsraeri,","poem":2},{"lineBreak":true},{"text":"nokuti iye akakufukidza nokubwinya.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsvakai Jehovha achawanikwa:","poem":1},{"text":"danai kwaari achiri pedyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akashata ngaasiye nzira yake,","poem":1},{"text":"nomunhu akaipa mirangariro yake.","poem":2},{"text":"Ngaadzokere kuna Jehovha, uye iye achamunzwira ngoni,","poem":1},{"text":"nokuna Mwari wedu, nokuti achakanganwirwa zvikuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Nokuti ndangariro dzangu hadzizi ndangariro dzenyu,","poem":1},{"text":"uye nzira dzenyu hadzizi nzira dzangu,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"“Sokukwirira kwakaita matenga kupfuura nyika,","poem":1},{"text":"saizvozvo nzira dzangu dzakakwirira kupinda dzenyu,","poem":2},{"lineBreak":true},{"text":"nendangariro dzangu kupfuura ndangariro dzenyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sezvinoita mvura nechando","poem":1},{"text":"zvinoburuka kubva kudenga,","poem":2},{"text":"zvisingadzokeriko","poem":1},{"text":"zvisina kudiridza nyika","poem":2},{"text":"nokuita kuti ibukire uye ibereke zvakawanda,","poem":1},{"text":"kuitira kuti iberekere mudyari wembeu, uye ipe chingwa kune anodya,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"saizvozvo neshoko rangu rinobuda mumuromo mangu:","poem":1},{"text":"Haringadzokeri kwandiri risina chinhu,","poem":2},{"text":"asi richaita zvinondifadza,","poem":1},{"text":"uye richaita zvandakarituma.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Muchabuda nomufaro,","poem":1},{"text":"uye muchafambiswa murugare;","poem":2},{"text":"makomo nezvikomo zvichapururudza","poem":1},{"text":"uye zvichaimba rwiyo pamberi penyu,","poem":2},{"text":"uye miti yose yeminda","poem":1},{"text":"ichauchira maoko ayo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pachinzvimbo chomunzwa pachamera muti womupaini,","poem":1},{"text":"pachinzvimbo chorukato pachamera mumite.","poem":2},{"text":"Izvi zvichava mukurumbira waJehovha,","poem":1},{"text":"nechiratidzo chokusingaperi,","poem":2},{"lineBreak":true},{"text":"chisingazoparadzwi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}