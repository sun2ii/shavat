{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Ruponeso rwaVamwe"]},{"type":"verse","number":1,"content":["Zvanzi naJehovha:",{"text":"“Chengetedzai kururamisira","poem":1},{"text":"mugoita zvakanaka,","poem":2},{"text":"nokuti ruponeso rwangu rwava pedyo,","poem":1},{"text":"uye kururama kwangu kuchakurumidza kuratidzwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akaropafadzwa munhu anoita izvi,","poem":1},{"text":"munhu anozvibatisisa,","poem":2},{"text":"anochengeta Sabata asingarisvibisi,","poem":1},{"text":"uye anodzivisa ruoko rwake kuita chinhu chakaipa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mutorwa akanamatira kuna Jehovha ngaarege kuti,","poem":1},{"text":"“Zvirokwazvo Jehovha achandiparadzanisa navanhu vake.”","poem":2},{"text":"Uye nomuyunaki ngaarege kugununʼuna achiti,","poem":1},{"text":"“Ndinongova zvangu muti wakaoma.”","poem":2}]},{"type":"verse","number":4,"content":["Nokuti zvanzi naJehovha:",{"text":"“Kuvayunaki vanochengeta maSabata angu,","poem":1},{"text":"vanosarudza zvinondifadza,","poem":2},{"lineBreak":true},{"text":"uye vanobatirira pasungano yangu,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"kwavari ndichapa, mukati metemberi yangu namasvingo ayo,","poem":1},{"text":"chirangaridzo nezita riri nani kupfuura vanakomana navanasikana;","poem":2},{"lineBreak":true},{"text":"ndichavapa zita risingaperi, risingazoparadzwi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uye vatorwa vakazvipira kuna Jehovha","poem":1},{"text":"kuti vamushumire,","poem":2},{"text":"kuti vade zita raJehovha,","poem":1},{"text":"uye vamunamate,","poem":2},{"text":"vose vanochengeta Sabata","poem":1},{"text":"vasingarisvibisi vachibatisisa sungano yangu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ivava ndichavauyisa kugomo rangu dzvene","poem":1},{"text":"ndigovapa mufaro muimba yangu yokunyengetera.","poem":2},{"text":"Zvipiriso zvavo zvinopiswa","poem":1},{"text":"nezvibayiro zvichagamuchirwa paaritari yangu;","poem":2},{"text":"nokuti imba yangu ichanzi","poem":1},{"text":"imba yokunyengetera yendudzi dzose.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ishe Jehovha anoti,","poem":1},{"text":"iye anounganidza vakatapwa vaIsraeri,","poem":2},{"text":"“Ndichaunganidzazve vamwe kwavari,","poem":1},{"text":"tisingaverengeri avo vakaunganidzwa kare.”","poem":2}]},{"type":"heading","content":["Mwari anopa mhosva kuna Vakaipa"]},{"type":"verse","number":9,"content":[{"text":"Uyai, imi mose zvikara zvesango,","poem":1},{"text":"uyai mudye, imi mose zvikara zvesango!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nharirire dzeIsraeri mapofu,","poem":1},{"text":"vose vanoshayiwa zivo;","poem":2},{"text":"vose imbwa dzisingahukuri,","poem":1},{"text":"hadzigoni kuhukura;","poem":2},{"text":"dzinovata pose pose dzichingorota,","poem":1},{"text":"dzinofarira kuvata.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Imbwa dzinokara zvikuru;","poem":1},{"text":"dzisingamboguti.","poem":2},{"text":"Vafudzi vanoshayiwa kunzwisisa:","poem":1},{"text":"vose vanotsaukira kunzira yavo pachavo,","poem":2},{"lineBreak":true},{"text":"mumwe nomumwe anotsvaka zvinomupfumisa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mumwe nomumwe anodanidzira achiti, “Uyai, regai nditore waini!","poem":1},{"text":"Regai tinwe tigute nedoro!","poem":2},{"text":"Uye mangwana achafanana nanhasi,","poem":1},{"text":"kana kutopfuura.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}