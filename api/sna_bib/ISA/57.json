{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"Vakarurama vanoparara,","poem":1},{"text":"uye hakuna anofunga izvi mumwoyo make;","poem":2},{"text":"vanhu vanoda Mwari vanobviswa,","poem":1},{"text":"uye hakuna anonzwisisa","poem":2},{"text":"kuti vakarurama vanobviswa","poem":1},{"text":"kuti vanunurwe kubva pane zvakaipa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vose vanofamba mukururama","poem":1},{"text":"vanopinda murugare,","poem":2},{"lineBreak":true},{"text":"vanowana zororo pavanovata murufu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Asi imi, uyai pano, imi vanakomana vomuroyi,","poem":1},{"text":"imi chibereko chemhombwe nezvifeve!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Muri kuseka aniko?","poem":1},{"text":"Ndiani wamunohomera","poem":2},{"lineBreak":true},{"text":"uye wamunobudisira rurimi rwenyu?","poem":2},{"text":"Ko, hamusi chibereko chemhandu here,","poem":1},{"text":"nechizvarwa chavanoreva nhema?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Munotsva noruchiva pakati pemiti","poem":1},{"text":"yemuouki napasi pomuti mumwe nomumwe wakapfumvutira;","poem":2},{"text":"munobayira vana venyu mumipata","poem":1},{"text":"napasi pamapazi akarembera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zvifananidzo zviri pakati pamatombo anotsvedzerera emipata ndiwo mugove wenyu;","poem":1},{"text":"izvozvo, ndiwo mugove wenyu.","poem":2},{"text":"Hongu, wakadururira chipiriso chokunwa kwazviri,","poem":1},{"text":"uye ukapa chipiriso chezviyo.","poem":2},{"lineBreak":true},{"text":"Ko, ini muchagona kundiripira zvinhu izvi here?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wakawaridza nhoo pakakwirira napachikomo chirefu;","poem":1},{"text":"ikoko wakakwira kundobayira zvibayiro.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Seri kwamakonhi ako nezvivivo zvako","poem":1},{"text":"wakaisa chirangaridzo chavamwari vako.","poem":2},{"text":"Uchindisiya ini, wakafukura mubhedha wako,","poem":1},{"text":"wakakwira pauri ukaushamisa kwazvo;","poem":2},{"text":"wakaita sungano naavo vane mibhedha yaunoda,","poem":1},{"text":"uye wakatarisa kusasimira kwavo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wakaenda kuna Moreki namafuta","poem":1},{"text":"omuorivhi ukawedzera zvinonhuhwira zvako.","poem":2},{"text":"Wakatumira nhume dzako kure;","poem":1},{"text":"wakaburukira kuguva chaiko!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wakaneteswa nenzira dzako dzose,","poem":1},{"text":"asi hauna kumboti, ‘Hazvina maturo.’","poem":2},{"text":"Wakawana kuvandudzwa kwesimba rako,","poem":1},{"text":"nokudaro hauna kuziya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ndianiko wawakatya uye ukavhunduka","poem":1},{"text":"zvokuti wakazoreva nhema kwandiri,","poem":2},{"text":"uye hauna kumbondirangarira","poem":1},{"text":"kana kumbozvifunga izvi mumwoyo mako?","poem":2},{"text":"Hakuzi kuti ndakaramba ndakanyarara","poem":1},{"text":"iwe ukasanditya here?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndichaisa pachena kururama kwako namabasa ako,","poem":1},{"text":"uye hazvizombokubatsiri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Paunochemera rubatsiro,","poem":1},{"text":"zvifananidzo zvawakaunganidza ngazvikubatsire!","poem":2},{"text":"Mhepo ichazvikukura zvose,","poem":1},{"text":"mweya wokungofema zvawo uchazvifuridzira kure.","poem":2},{"text":"Asi munhu anondiita utiziro hwake","poem":1},{"text":"achagara nhaka yenyika,","poem":2},{"lineBreak":true},{"text":"uye gomo rangu dzvene richava rake.”","poem":2}]},{"type":"heading","content":["Kunyaradzwa kwaVane Mwoyo Yakapwanyika"]},{"type":"verse","number":14,"content":["Uye zvichazonzi:",{"text":"“Vakai, vakai, gadzirai mugwagwa!","poem":1},{"text":"Bvisai zvipinganidzo munzira yavanhu vangu.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nokuti zvanzi naIye akakwirira ari kumusoro,","poem":1},{"text":"iye anorarama nokusingaperi, ane zita dzvene:","poem":2},{"text":"“Ndinogara pakakwirira panzvimbo tsvene,","poem":1},{"text":"asi naiyewo ane mweya wakapwanyika uye anozvininipisa,","poem":2},{"text":"kuti ndimutsiridze mweya yavanozvininipisa","poem":1},{"text":"uye ndimutsiridze mwoyo yavakapwanyika.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Handichapi mhosva nokusingaperi,","poem":1},{"text":"kana kugara ndakatsamwa,","poem":2},{"text":"nokuti ipapo mweya yavanhu ingaziya pamberi pangu,","poem":1},{"text":"kufema kwomunhu wandakasika.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndakatsamwiswa nechivi chake chokukara;","poem":1},{"text":"ndakamuranga, ndikavanza chiso changu mukutsamwa kwangu,","poem":2},{"lineBreak":true},{"text":"asi akaramba ari munzira dzaaida.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndakaona nzira dzake,","poem":1},{"text":"asi ndichamuporesa; ndichamutungamirira uye ndichamunyaradza,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ndichisika rumbidzo pamiromo yavanochema muIsraeri.","poem":2},{"text":"Rugare, rugare kuna vari kure navari pedyo,”","poem":1},{"text":"ndizvo zvinotaura Jehovha. “Uye ndichavaporesa.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Asi vakaipa vakafanana negungwa rinozungunuka,","poem":1},{"text":"risingagoni kuzorora,","poem":2},{"lineBreak":true},{"text":"rina mafungu anorasa marara namatope.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mwari wangu anoti, “Vakaipa havana rugare.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}