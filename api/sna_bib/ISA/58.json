{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["Kutsanya kwechokwadi"]},{"type":"verse","number":1,"content":[{"text":"“Danidzira nesimba, usanyarara.","poem":1},{"text":"Simudza inzwi rako sehwamanda.","poem":2},{"text":"Paridzira vanhu vangu kupanduka kwavo,","poem":1},{"text":"neimba yaJakobho zvivi zvavo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nokuti zuva nezuva vanonditsvaka;","poem":1},{"text":"vanoita savane chido chokuziva nzira dzangu,","poem":2},{"text":"kunge vanga vari rudzi runoita zvakanaka","poem":1},{"text":"uye rusina kusiya mirayiro yaMwari wavo.","poem":2},{"text":"Vanondikumbira kutonga kwakarurama","poem":1},{"text":"sokunge vanofarira kuti Mwari auye pedyo navo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vanoti, ‘Takatsanyireiko,","poem":1},{"text":"uye imi mukasazviona?","poem":2},{"text":"Takazvininipisireiko,","poem":1},{"text":"imi mukasazviona?’","poem":2},{"lineBreak":true},{"text":"“Asi pazuva rokutsanya kwenyu munoita zvamunoda","poem":1},{"text":"muchimanikidza vashandi venyu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kutsanya kwenyu kunogumisira mukukakavadzana nemhirizhonga,","poem":1},{"text":"uye kurovana netsiva dzakaipisisa.","poem":2},{"text":"Hamungatsanyi sezvamunoita mazuva ano,","poem":1},{"text":"mugotarisira kuti inzwi renyu richanzwika kumusoro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ko, ndiko here kutsanya kwandakasarudza,","poem":1},{"text":"zuva rimwe chete rokuti munhu azvininipise?","poem":2},{"text":"Ndezvokukotamisa musoro chete sorushanga here,","poem":1},{"text":"nokungovata pamusoro penguo dzamasaga namadota?","poem":2},{"text":"Ndiko kwamunoti kutsanya here,","poem":1},{"text":"pazuva rinodikanwa naJehovha?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Uku handiko kutsanya kwandakasarudza here:","poem":1},{"lineBreak":true},{"text":"Kusunungura ngetani dzokusaruramisira","poem":1},{"text":"nokusunungura zvitirobho zvejoko,","poem":2},{"text":"kusunungura vakamanikidzwa","poem":1},{"text":"nokuvhuna joko rimwe nerimwe?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hakuzi kugoverana zvokudya zvako nevane nzara,","poem":1},{"text":"nokupa varombo vanodzungaira pokugara here,","poem":2},{"text":"paunoona vakashama, kuvapfekedza,","poem":1},{"text":"uye kusafuratira venyama neropa rako?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ipapo chiedza chako chichabuda samambakwedza,","poem":1},{"text":"uye kuporeswa kwako kucharatidzwa nokukurumidza;","poem":2},{"text":"ipapo kururama kwako kuchakutungamirira,","poem":1},{"text":"uye kubwinya kwaJehovha kuchakurinda mumashure.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ipapo uchadana, Jehovha achakupindura;","poem":1},{"text":"uchadanidzira uchida rubatsiro, uye iye achati: Ndiri pano.","poem":2},{"lineBreak":true},{"text":"“Kana ukabvisa joko roudzvinyiriri,","poem":1},{"text":"kutendeka nomunwe nokutaura kwakaipa,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"uye ukapa zvokudya zvako kune vane nzara","poem":1},{"text":"uye ukagutsa vakamanikidzwa pakushaya kwavo,","poem":2},{"text":"ipapo chiedza chako chichabuda murima,","poem":1},{"text":"uye usiku hwako huchashanduka hukafanana namasikati.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehovha achakutungamirira nguva dzose;","poem":1},{"text":"achakugutsa pakushaya kwako munyika yakapiswa nezuva","poem":2},{"lineBreak":true},{"text":"uye achasimbisa mapfupa ako.","poem":2},{"text":"Uchafanana nebindu rinodiridzwa nemvura yetsime,","poem":1},{"text":"sechitubu chine mvura isingapwi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vanhu vako vachavakazve matongo akare","poem":1},{"text":"vachasimudza nheyo dzakare;","poem":2},{"text":"iwe uchanzi Mugadziri waMasvingo Akakoromoka,","poem":1},{"text":"Muvandudzi weMigwagwa ine Dzimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Kana ukachengeta tsoka dzako kuti dzisaputsa Sabata,","poem":1},{"text":"uye kuti dzisaita zvinokufadza iwe pazuva rangu dzvene,","poem":2},{"text":"kana ukati Sabata izuva rinofadza,","poem":1},{"text":"uye ukati zuva dzvene raJehovha izuva rinokudzwa,","poem":2},{"text":"uye kana ukarikudza nokusafamba munzira yako,","poem":1},{"text":"uye usingaiti zvinokufadza kana kutaura mashoko asina maturo,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ipapo uchawana mufaro wako muna Jehovha,","poem":1},{"text":"uye ndichakuita kuti ukwire pakakwirira penyika,","poem":2},{"lineBreak":true},{"text":"uye ndichakugutsa nenhaka yababa vako Jakobho.”","poem":2},{"text":"Muromo waJehovha wazvitaura.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}