{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["Chivi, Kureurura, neDzikinuro"]},{"type":"verse","number":1,"content":[{"text":"Zvirokwazvo ruoko rwaJehovha haruna kupfupika kuti rukonewe kuponesa,","poem":1},{"text":"uye nzeve yake haina kudzivira kuti irege kunzwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Asi zvakaipa zvenyu zvakakuparadzanisai","poem":1},{"text":"naMwari wenyu;","poem":2},{"text":"zvivi zvenyu zvakavanza chiso chake","poem":1},{"text":"kwamuri kuti arege kunzwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti maoko enyu akasvibiswa neropa,","poem":1},{"text":"minwe yenyu nezvakaipa.","poem":2},{"text":"Miromo yenyu yakareva nhema,","poem":1},{"text":"rurimi rwenyu runonguruma zvinhu zvakaipa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hapana anochemera kururamisira;","poem":1},{"text":"hapana anokwidza mhaka yake nokutendeka.","poem":2},{"text":"Vanongovimba negakava risina maturo uye nokureva nhema;","poem":1},{"text":"vanoita mimba yezvakashata uye vanobereka zvakaipa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vanochochonya mazai emvumbi,","poem":1},{"text":"uye vanoruka dandira redandemutande.","poem":2},{"text":"Ani naani anodya mazai avo achafa,","poem":1},{"text":"uye rimwe rikaputsika, panochochonywa nyoka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Matandira avo haabatsiri pakupfeka;","poem":1},{"text":"havagoni kuzvifukidza nezvavanogadzira.","poem":2},{"text":"Mabasa avo mabasa akaipa,","poem":1},{"text":"uye kuita nechisimba kuri mumaoko avo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tsoka dzavo dzinomhanyira kundopinda muchivi;","poem":1},{"text":"vanokurumidza kuteura ropa risina mhosva.","poem":2},{"text":"Mirangariro yavo mirangariro yakaipa;","poem":1},{"text":"kuputsa nokuparadza zviri munzira dzavo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nzira yorugare havaizivi;","poem":1},{"text":"hapana kururamisira pamakwara avo.","poem":2},{"text":"Vakashandura nzira dzavo dzikava dzakaminama;","poem":1},{"text":"hakuna anofamba madziri achaziva rugare.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Naizvozvo kururamisira kuri kure nesu,","poem":1},{"text":"uye kururama hakusviki kwatiri.","poem":2},{"text":"Tinotsvaka chiedza, asi zvose irima;","poem":1},{"text":"tinotsvaka kujeka, asi tiri kufamba mumumvuri werima.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sebofu tinotsvanzvadzira tichitevedza madziro,","poem":1},{"text":"tichitsvaka nzira yedu savanhu vasina meso.","poem":2},{"text":"Panguva yamasikati tinogumburwa kunge nguva yorubvunzavaeni;","poem":1},{"text":"pakati pavane simba, tangoita savakafa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tose tiri kuomba samapere;","poem":1},{"text":"tinorira nokurira kukuru senjiva.","poem":2},{"text":"Tinotsvaka kururamisira, asi hatikuwani;","poem":1},{"text":"tinotsvaka kurwirwa, asi kuri kure kure.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nokuti kutadza kwedu kwawanda pamberi penyu,","poem":1},{"text":"uye zvivi zvedu zvinotipupurira zvakaipa.","poem":2},{"text":"Kudarika kwedu kunogara nesu,","poem":1},{"text":"uye tinobvuma kutadza kwedu:","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kumukira nokunyengera Jehovha,","poem":1},{"text":"kufuratira Mwari wedu,","poem":2},{"text":"kukuchidzira udzvinyiriri nokupanduka,","poem":1},{"text":"nokutaura mashoko enhema anobva mumwoyo yedu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Naizvozvo kururamisirwa kwadzorerwa shure,","poem":1},{"text":"uye kururama kwamira kure;","poem":2},{"text":"chokwadi chakagumburwa munzira dzomumusha,","poem":1},{"text":"kutendeka hakuchagoni kupinda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zvokwadi haichawanikwi","poem":1},{"text":"uye vanovenga zvakaipa ndivo vopambwa.","poem":2},{"lineBreak":true},{"text":"Jehovha akatarisa akasafara","poem":1},{"text":"kuti pakanga pasisina kururamisira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akaona kuti pakanga pasina munhu,","poem":1},{"text":"akashamiswa kuti pakanga pasina munhu aipindira;","poem":2},{"text":"naizvozvo ruoko rwake rwakamuvigira ruponeso,","poem":1},{"text":"uye kururama kwake kwakamuraramisa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akashonga kururama sechidzitiro chechipfuva,","poem":1},{"text":"nenguwani yoruponeso mumusoro make;","poem":2},{"text":"akashonga nguo dzokutsiva akazviputira","poem":1},{"text":"mukushingaira kwake seanozviputira nejasi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sezvavakaita, saizvozvo acharipira","poem":1},{"text":"hasha","poem":2},{"text":"kuvavengi vake","poem":1},{"text":"nokutsiva kuvadzivisi vake;","poem":2},{"lineBreak":true},{"text":"acharipira zvakafanira kuzviwi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kubva kumavirira, vanhu vachatya Jehovha,","poem":1},{"text":"uye kubva pakubuda kwezuva, vachakudza kubwinya kwake.","poem":2},{"text":"Nokuti achauya sokudira kworwizi","poem":1},{"text":"runosundwa nokufema kwaJehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mudzikinuri achauya kuZioni,","poem":1},{"text":"kuna avo vari muna Jakobho vanotendeuka pazvivi zvavo,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":21,"content":["“Kana ndirini, iyi ndiyo sungano yangu navo,” ndizvo zvinotaura Jehovha. “Mweya wangu uri pamusoro pako, namashoko angu andakaisa mumuromo mako hazvichabvi pamuromo wako, kana pamiromo yavana venyu, kana pamiromo yezvizvarwa zvavo kubva zvino nokusingaperi,” ndizvo zvinotaura Jehovha."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}