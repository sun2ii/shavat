{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["Kubwinya kweZioni"]},{"type":"verse","number":1,"content":[{"text":"“Simuka, upenye nokuti chiedza chako chasvika,","poem":1},{"text":"uye kubwinya kwaJehovha kwabuda pamusoro pako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tarira, rima rakafukidza nyika","poem":1},{"text":"uye rima guru riri pamusoro pavanhu,","poem":2},{"text":"asi Jehovha anobuda pamusoro pako","poem":1},{"text":"uye kubwinya kwake kunoratidzwa pamusoro pako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndudzi dzichauya kuchiedza chako,","poem":1},{"text":"uye madzimambo kukubwinya kwamambakwedza ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Simudza meso ako utarise zvakakukomberedza:","poem":1},{"text":"vose vanoungana uye vanouya kwauri,","poem":2},{"text":"vanakomana vako vanobva kure,","poem":1},{"text":"uye vanasikana vako vanotakurwa pamaoko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ipapo uchatarisa ugopenya,","poem":1},{"text":"mwoyo wako uchakwata uye uchazara nomufaro;","poem":2},{"text":"upfumi huri pamusoro pamakungwa huchauyiswa kwauri,","poem":1},{"text":"pfuma yendudzi ichauya kwauri.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mapoka engamera achazadza nyika yako,","poem":1},{"text":"mhuru dzengamera dzeMidhiani neEfa.","poem":2},{"text":"Uye vose vanobva kuShebha vachauya,","poem":1},{"text":"vakatakura goridhe nezvinonhuhwira","poem":2},{"lineBreak":true},{"text":"vachiparidza kurumbidzwa kwaJehovha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mapoka eKedhari achaunganidzirwa","poem":1},{"text":"kwauri makondobwe eNebhayoti achakushumira:","poem":2},{"text":"achagamuchirwa sezvipo paaritari yangu,","poem":1},{"text":"uye ndichashongedza temberi yangu yokukudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ndivanaani ava vanobhururuka samakore,","poem":1},{"text":"senjiva dzinoenda kumatendere adzo?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zvirokwazvo zviwi zvinotarira kwandiri;","poem":1},{"text":"zvikepe zveTashishi zvinotungamira","poem":2},{"text":"zvichiuya navanakomana venyu vari kubva kure,","poem":1},{"text":"nesirivha yavo negoridhe,","poem":2},{"text":"kuzokudza Jehovha Mwari wako,","poem":1},{"text":"iye Mutsvene waIsraeri,","poem":2},{"lineBreak":true},{"text":"nokuti akakushongedza nokubwinya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Vatorwa vachavakazve masvingo ako,","poem":1},{"text":"uye madzimambo avo achakushandira.","poem":2},{"text":"Kunyange ndakakurova mukutsamwa kwangu,","poem":1},{"text":"munyasha dzangu ndichakunzwira tsitsi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Masuo ako achagara akashama","poem":1},{"text":"haachazombozarirwi, masikati kana usiku","poem":2},{"text":"kuitira kuti vanhu vakuvigire upfumi hwendudzi,","poem":1},{"text":"madzimambo adzo achafambiswa ari mumudungwe akundwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nokuti rudzi kana ushe husingakushumiri huchaparadzwa;","poem":1},{"text":"huchaparadzwa zvachose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Kubwinya kweRebhanoni kuchauya kwauri,","poem":1},{"text":"mipaini nemifiri nemisipuresi pamwe chete,","poem":2},{"text":"kuzoshongedza nzvimbo yetemberi yangu tsvene;","poem":1},{"text":"uye ndichabwinyisa nzvimbo yetsoka dzangu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vanakomana vavamanikidzi venyu","poem":1},{"text":"vachauya vachikotama pamberi penyu;","poem":2},{"text":"vose vanokuzvidzai vachapfugama patsoka dzenyu uye vachakutumidzai kuti Guta raJehovha,","poem":1},{"text":"Zioni roMutsvene waIsraeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Kunyange wanga wasiyiwa uye uchivengwa,","poem":1},{"text":"pasina munhu anopfuura nemauri,","poem":2},{"text":"ndichakuita kuti ukudzwe nokusingaperi","poem":1},{"text":"uye uve mufaro wezvizvarwa zvinotevera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uchanwa mukaka wendudzi","poem":1},{"text":"uye ucharerwa pamazamu oumambo.","poem":2},{"text":"Ipapo uchaziva kuti ini, iyeni Jehovha, ndini Muponesi wako,","poem":1},{"text":"Mudzikinuri wako, Wamasimba Ose waJakobho.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndichakuvigira goridhe pachinzvimbo chendarira,","poem":1},{"text":"nesirivha pachinzvimbo chesimbi.","poem":2},{"text":"Ndichakuvigira ndarira pachinzvimbo chamatanda,","poem":1},{"text":"nesimbi pachinzvimbo chamabwe.","poem":2},{"text":"Ndichaita rugare mubati wako","poem":1},{"text":"nekururama mutongi wako.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kuita nechisimba hakuchazonzwikwa munyika yako,","poem":1},{"text":"kana dongo kana kuparadzwa mukati memiganhu yako,","poem":2},{"text":"asi uchatumidza masvingo ako zita","poem":1},{"text":"rokuti Ruponeso nemasuo ako kuti Rumbidzo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zuva harichazovi chiedza chako masikati,","poem":1},{"text":"uye kupenya kwomwedzi hakungavi pamusoro pako,","poem":2},{"text":"nokuti Jehovha ndiye achava chiedza chako chisingaperi,","poem":1},{"text":"uye Mwari wako achava kubwinya kwako.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Zuva rako harichazovirizve,","poem":1},{"text":"uye mwedzi wako hauchazoperizve;","poem":2},{"text":"Jehovha achava chiedza chako chisingaperi,","poem":1},{"text":"uye mazuva okuchema kwako achaguma.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ipapo vanhu vako vose vachava vakarurama,","poem":1},{"text":"uye vachatora nyika kuti ive yavo nokusingaperi.","poem":2},{"text":"Ndivo mabukira andakadyara,","poem":1},{"text":"basa ramaoko angu,","poem":2},{"lineBreak":true},{"text":"kuti ndiratidze kubwinya kwangu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mudikisa wako achava chiuru,","poem":1},{"text":"mudiki achava rudzi rune simba.","poem":2},{"text":"Ndini Jehovha,","poem":1},{"text":"munguva yacho ndichazviita nokukurumidza.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}