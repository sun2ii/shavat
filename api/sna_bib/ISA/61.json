{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["Gore reNyasha dzaJehovha"]},{"type":"verse","number":1,"content":[{"text":"Mweya waIshe Jehovha uri pamusoro pangu,","poem":1},{"text":"nokuti Jehovha akandizodza","poem":2},{"lineBreak":true},{"text":"kuti ndiparidze vhangeri kuvarombo.","poem":2},{"text":"Akandituma kuti ndirape vane mwoyo yakaputsika,","poem":1},{"text":"kuti ndiparidze kusunungurwa kwavakatapwa,","poem":2},{"lineBreak":true},{"text":"nokubudiswa kwavasungwa kuti vabve murima,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kuti ndiparidze gore rengoni dzaJehovha","poem":1},{"text":"uye nezuva rokutsiva kwaMwari wedu,","poem":2},{"text":"kuti ndinyaradze vose vanochema,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"uye ndiriritire avo vanochema muZioni,","poem":2},{"text":"kuti ndiise pamusoro pavo korona yorunako","poem":1},{"text":"pachinzvimbo chamadota,","poem":2},{"text":"mafuta omufaro","poem":1},{"text":"pachinzvimbo chokuchema,","poem":2},{"text":"uye nenguo yokurumbidza","poem":1},{"text":"pachinzvimbo chomweya wakarukutika.","poem":2},{"text":"Vachanzi miouki yokururama,","poem":1},{"text":"yakasimwa naJehovha","poem":2},{"lineBreak":true},{"text":"kuti aratidze kubwinya kwake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vachavakazve matongo akare","poem":1},{"text":"uye vachamutsazve nzvimbo dzakaparadzwa kare;","poem":2},{"lineBreak":true},{"text":"vachavandudza matongo amaguta","poem":2},{"lineBreak":true},{"text":"akaparadzwa kwezvizvarwa nezvizvarwa zvakapfuura.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vatorwa vachafudza mapoka amakwai enyu;","poem":1},{"text":"vatorwa vachashanda muminda yenyu nomuminda yenyu yemizambiringa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ipapo imi muchanzi vaprista vaJehovha,","poem":1},{"text":"muchanzi vashumiri vaMwari.","poem":2},{"text":"Muchadya pfuma yendudzi,","poem":1},{"text":"uye muchazvirumbidza nepfuma yavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pachinzvimbo chokunyadziswa kwavo","poem":1},{"text":"vanhu vangu vachagamuchira migove miviri,","poem":2},{"text":"uye pachinzvimbo chokunyadziswa vachafara munhaka yavo;","poem":1},{"text":"nokudaro vachagara nhaka yemigove miviri munyika yavo,","poem":2},{"lineBreak":true},{"text":"uye mufaro usingaperi uchava wavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Nokuti ini, Jehovha, ndinoda kururamisira;","poem":1},{"text":"ndinovenga kupamba nezvakaipa.","poem":2},{"text":"Mukutendeka kwangu, ndichavapa mubayiro","poem":1},{"text":"uye ndichaita sungano isingaperi navo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zvizvarwa zvavo zvichazivikanwa pakati pendudzi","poem":1},{"text":"uye navana vavo pakati pamarudzi.","poem":2},{"text":"Vose vanovaona vachaziva","poem":1},{"text":"kuti vanhu vakaropafadzwa naJehovha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndinofara zvikuru muna Jehovha;","poem":1},{"text":"mweya wangu unofara muna Mwari.","poem":2},{"text":"Nokuti akandifukidza nenguo dzoruponeso,","poem":1},{"text":"uye akandishongedza nenguo yokururama,","poem":2},{"text":"sechikomba chinoshongedza musoro wacho somuprista,","poem":1},{"text":"uye somwenga anozvishongedza nezvishongo zvamatombo anokosha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokuti ivhu sezvarinomeresa mbeu,","poem":1},{"text":"nebindu richiita kuti mbeu dzikure,","poem":2},{"text":"saizvozvo Ishe Jehovha achaita kuti kururama nerumbidzo","poem":1},{"text":"zvimere pamberi pendudzi dzose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}