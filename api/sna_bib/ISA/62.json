{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Zita idzva reZioni"]},{"type":"verse","number":1,"content":[{"text":"Nokuda kweZioni handinganyarari,","poem":1},{"text":"nokuda kweJerusarema handingarambi ndinyerere,","poem":2},{"text":"kusvikira kururama kwake kwapenya samambakwedza,","poem":1},{"text":"noruponeso rwake somwenje unopfuta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndudzi dzichaona kururama kwako,","poem":1},{"text":"uye madzimambo ose achaona kubwinya kwako;","poem":2},{"text":"iwe uchadaidzwa nezita idzva","poem":1},{"text":"richataurwa nomuromo waJehovha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uchava korona yokubwinya muruoko rwaJehovha,","poem":1},{"text":"ukomba hwoumambo muruoko rwaMwari wako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Havachazokutizve Musiyiwa,","poem":1},{"text":"kana kutumidza nyika yako kuti Dongo.","poem":2},{"text":"Asi uchatumidzwa kuti Hefizibha","poem":1},{"text":"uye nyika yako ichanzi Bhiyura;","poem":2},{"text":"nokuti Jehovha achakufarira,","poem":1},{"text":"uye nyika yako icharoorwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sejaya zvarinowana mhandara,","poem":1},{"text":"saizvozvo vanakomana vako vachakuwana;","poem":2},{"text":"sechikomba chinofarira mwenga,","poem":1},{"text":"saizvozvo Mwari wako achafara pamusoro pako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndakagadza nharirire pamasvingo ako, iwe Jerusarema;","poem":1},{"text":"havangambonyarari masikati kana usiku.","poem":2},{"text":"Imi munodana kuna Jehovha,","poem":1},{"text":"musazorora,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"uye musamupa zororo kusvikira asimbisa Jerusarema,","poem":1},{"text":"uye ariita rumbidzo yenyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehovha akapika noruoko rwake rworudyi,","poem":1},{"text":"noruoko rwake rune simba achiti,","poem":2},{"lineBreak":true},{"text":"“Handichazopizve zviyo zvenyu sezvokudya kuvavengi venyu,","poem":2},{"text":"uye vatorwa havachazonwizve waini itsva","poem":1},{"text":"yamakatamburira;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"asi ivo vanokohwa ndivo vachadya","poem":1},{"text":"uye vacharumbidza Jehovha,","poem":2},{"text":"uyewo vaya vanounganidza mazimbiringa ndivo vachainwa","poem":1},{"text":"mumavazhe eimba yangu tsvene.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pfuurai, pfuurai napamasuo!","poem":1},{"text":"Gadzirirai vanhu nzira.","poem":2},{"text":"Vakai, vakai mugwagwa mukuru!","poem":1},{"text":"Bvisai mabwe.","poem":2},{"text":"Simudzirai ndudzi mureza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jehovha akaparidzira kumagumo enyika achiti, “Uti kuMwanasikana weZioni, ‘Tarira, Muponesi wako ouya! Tarira, mubayiro wake anawo, uye kuripira kwake kunomutevera.’ ”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vachanzi Vanhu Vatsvene, Vakadzikinurwa vaJehovha; uye iwe uchanzi Mutsvakwa, iro Guta Risina Kuzova Dongo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}