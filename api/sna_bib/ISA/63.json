{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["Zuva raMwari roKutsiva noKudzikinura"]},{"type":"verse","number":1,"content":[{"text":"Ndianiko uyu anobva kuEdhomu,","poem":1},{"text":"anobva kuBhozira, ane nguo dzakatsvuka seropa?","poem":2},{"text":"Ndianiko uyu, akafuka zvinobwinya,","poem":1},{"text":"anofamba muukuru hwesimba rake?","poem":2},{"text":"“Ndini ndinotaura nokururama,","poem":1},{"text":"ndine simba rokuponesa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Seiko nguo dzenyu dzakatsvuka","poem":1},{"text":"sedzomunhu anotsika chisviniro chewaini?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Ndakatsika chisviniro chewaini ndoga;","poem":1},{"text":"kubva kundudzi dzose hapana akanga aneni.","poem":2},{"text":"Ndakavatsika-tsika mukutsamwa kwangu","poem":1},{"text":"uye ndakavapwanyira pasi muhasha dzangu;","poem":2},{"text":"ropa ravo rikatsatikira panguo dzangu,","poem":1},{"text":"ndikasvibisa nguo dzangu dzose.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nokuti zuva rokutsiva rakanga riri mumwoyo mangu,","poem":1},{"text":"uye gore rokudzikinura kwangu rasvika.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndakatarisa, asi pakanga pasina angabatsira,","poem":1},{"text":"ndakashamiswa nokuti hapana akatsigira;","poem":2},{"text":"naizvozvo ruoko rwangu rwakandivigira ruponeso,","poem":1},{"text":"uye hasha dzangu dzakanditsigira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndakatsika-tsika ndudzi mukutsamwa kwangu;","poem":1},{"text":"muhasha dzangu ndakaita kuti vadhakwe","poem":2},{"lineBreak":true},{"text":"uye ndakadurura ropa ravo pasi.”","poem":2}]},{"type":"heading","content":["Kurumbidza noKunyengetera"]},{"type":"verse","number":7,"content":[{"text":"Ndichataura nezvounyoro hwaJehovha,","poem":1},{"text":"iwo mabasa aanofanira kukudzwa nawo,","poem":2},{"lineBreak":true},{"text":"nokuda kwezvose zvatakaitirwa naJehovha,","poem":2},{"text":"hongu, izvo zvinhu zvizhinji zvaakaitira","poem":1},{"text":"imba yaIsraeri,","poem":2},{"lineBreak":true},{"text":"nokuda kwetsitsi dzake uye nengoni dzake zhinji.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akati, “Zvirokwazvo ndivo vanhu vangu,","poem":1},{"text":"ivo vanakomana vasingazovi venhema kwandiri,”","poem":2},{"lineBreak":true},{"text":"naizvozvo akava Muponesi wavo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mumatambudziko avo ose naiyewo akatambudzika,","poem":1},{"text":"uye mutumwa wokuvapo kwake akavaponesa.","poem":2},{"text":"Murudo rwake nengoni akavadzikinura;","poem":1},{"text":"akavasimudza uye akavatakura","poem":2},{"lineBreak":true},{"text":"mumazuva ose akare.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asi vakamumukira","poem":1},{"text":"vakachemedza Mweya wake Mutsvene.","poem":2},{"text":"Saka akashanduka akava muvengi wavo,","poem":1},{"text":"uye iye amene akarwa navo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ipapo vanhu vake vakarangarira mazuva akare,","poem":1},{"text":"mazuva aMozisi navanhu vake, vakati,","poem":2},{"text":"aripiko akavayambutsa gungwa,","poem":1},{"text":"nomufudzi wamakwai ake?","poem":2},{"text":"Aripiko akaisa","poem":1},{"text":"Mweya wake Mutsvene pakati pavo,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"iye akavatumira ruoko rwake rwokukudzwa nesimba","poem":1},{"text":"kuti ruve paruoko rworudyi rwaMozisi,","poem":2},{"text":"iye akaparadzanisa mvura pamberi pavo,","poem":1},{"text":"kuti azviwanire mukurumbira usingaperi,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"iye akavatungamirira nomakadzika?","poem":1},{"text":"Sebhiza murenje, havana kugumburwa;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"semombe dzinoburukira kubani,","poem":1},{"text":"vakapiwa zororo noMweya waJehovha.","poem":2},{"text":"Ndiwo matungamiriro amakaita vanhu venyu","poem":1},{"text":"kuti muzviitire zita rine mukurumbira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tarirai pasi muri kudenga uye muone,","poem":1},{"text":"kubva pachigaro chenyu chakakwirira chitsvene uye chinobwinya.","poem":2},{"text":"Kushingaira kwenyu nesimba renyu zviripiko?","poem":1},{"text":"Unyoro hwenyu netsitsi dzenyu zvakabviswa kwatiri.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asi muri Baba vedu,","poem":1},{"text":"kunyange Abhurahama asingatizivi","poem":2},{"lineBreak":true},{"text":"kana naIsraeri asingatiziviwo;","poem":2},{"text":"imi, Jehovha, ndimi Baba vedu,","poem":1},{"text":"Mudzikinuri wedu kubva kare ndiro zita renyu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haiwa Jehovha, munotiregereiko tichidzungaira, kubva panzira dzenyu","poem":1},{"text":"muchiomesa mwoyo yedu kuti tirege kukutyai?","poem":2},{"text":"Dzokai nokuda kwavaranda venyu,","poem":1},{"text":"iwo marudzi enhaka yenyu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kwenguva duku vanhu venyu vakatora nzvimbo yenyu tsvene,","poem":1},{"text":"asi zvino vavengi vedu vakatsika-tsika nzvimbo yenyu tsvene.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isu tiri venyu kubva kare;","poem":1},{"text":"asi ivo hamuna kumbovatonga,","poem":2},{"lineBreak":true},{"text":"havana kumbodaidzwa nezita renyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}