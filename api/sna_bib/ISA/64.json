{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Haiwa, dai maibvarura matenga mukaburuka pasi,","poem":1},{"text":"kuti makomo adedere pamberi penyu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sezvinoita moto paunopisa tsotso","poem":1},{"text":"uchiita kuti mvura ivire,","poem":2},{"text":"burukai muzoita kuti zita renyu rizivikanwe kuvavengi venyu,","poem":1},{"text":"uye muite kuti ndudzi dzidedere pamberi penyu!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti pamakaita zvinhu zvinotyisa zvatakanga tisina kutarisira,","poem":1},{"text":"makaburuka pasi, makomo akabvunda pamberi penyu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kubva panguva dzekare hakuna munhu akanzwa,","poem":1},{"text":"hakuna nzeve yakanzwisisa,","poem":2},{"text":"hakuna ziso rakaona mumwe Mwari kunze kwenyu,","poem":1},{"text":"anobatsira avo vanomumirira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Munouya kuzobatsira avo vanofarira kuita zvakarurama,","poem":1},{"text":"vanorangarira nzira dzenyu.","poem":2},{"text":"Asi patakaramba tichivatadzira,","poem":1},{"text":"imi makatsamwa.","poem":2},{"lineBreak":true},{"text":"Zvino tingaponeswa seiko?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isu tose tafanana nousina kuchena,","poem":1},{"text":"uye mabasa edu ose okururama afanana namamvemve enguo dzine tsvina;","poem":2},{"text":"isu tose tinooma seshizha,","poem":1},{"text":"semhepo zvivi zvedu zvinotitsvairira kure.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hakuna anodana kuzita renyu","poem":1},{"text":"kana anoshingairira kuti akubatei;","poem":2},{"text":"nokuti makativanzira chiso chenyu mukaita","poem":1},{"text":"kuti tiperezeke nokuda kwezvivi zvedu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Haiwa, Jehovha, kunyange zvakadaro muri Baba vedu.","poem":1},{"text":"Isu tiri ivhu, imi muri muumbi;","poem":2},{"lineBreak":true},{"text":"isu tose tiri basa ramaoko enyu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Regai kutsamwa zvikuru imi Jehovha;","poem":1},{"text":"regai kurangarira zvivi zvedu nokusingaperi.","poem":2},{"text":"Haiwa Jehovha, ringirai kwatiri, tinokumbira,","poem":1},{"text":"nokuti tose tiri vanhu venyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maguta enyu matsvene ava renje;","poem":1},{"text":"kunyange Zioni irenje, Jerusarema rava dongo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Temberi yedu tsvene inobwinya, umo madzibaba edu akakurumbidzai,","poem":1},{"text":"yakapiswa nomoto,","poem":2},{"lineBreak":true},{"text":"uye nzvimbo dzose dzataikoshesa dzaparara.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Haiwa Jehovha, mushure maizvozvi mungazvidzorawo here?","poem":1},{"text":"Mucharamba munyerere, uye mugotiranga zvinopfuura mwero here?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}