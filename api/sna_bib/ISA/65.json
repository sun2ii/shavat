tera vari munzira yakavanda:","poem":2},{"text":"vanodya nyama yenguruve,","poem":1},{"text":"uye hari dzavo dzine furo renyama yakasvibiswa;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"vanoti, ‘Gara kure; usaswedera pedyo neni,","poem":1},{"text":"nokuti ndiri mutsvene kupfuura iwe.’","poem":2},{"text":"Vanhu vakadaro utsi mumhuno dzangu,","poem":1},{"text":"moto unoramba uchipfuta zuva rose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Tarirai, zvakanyorwa pamberi pangu zvinoti:","poem":1},{"text":"Handinganyarari asi ndicharipira zvakazara;","poem":2},{"lineBreak":true},{"text":"ndichazviripa pamakumbo avo,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"zvakaipa zvenyu nezvamadzibaba enyu,”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":2},{"text":"“Nokuti vakapisira zvibayiro pamusoro pezvikomo,","poem":1},{"text":"ndichayera pamakumbo avo","poem":2},{"lineBreak":true},{"text":"muripo wakazara wamabasa avo akare.”","poem":2}]},{"type":"verse","number":8,"content":["Zvanzi naJehovha:",{"text":"“Sezvazvakangoita kana musvi uchiri kuwanikwa musumbu ramazambiringa","poem":1},{"text":"uye vanhu vachiti, ‘Musauparadza, muchine zvakanaka mauri,’","poem":2},{"text":"saizvozvo ndizvo zvandichaitira varanda vangu;","poem":1},{"text":"handingavaparadzi vose.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndichabudisa marudzi kuna Jakobho,","poem":1},{"text":"uye nokubva kuna Judha avo vachatora makomo angu;","poem":2},{"text":"vasanangurwa vangu vachagara nhaka,","poem":1},{"text":"uye varanda vangu vachagara ikoko.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sharoni richava mafuro amakwai,","poem":1},{"text":"uye Mupata weAkori uchava uvato hwemombe","poem":2},{"lineBreak":true},{"text":"dzavanhu vangu vanonditsvaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Asi kana murimi munosiya Jehovha","poem":1},{"text":"uye munokanganwa gomo rangu dzvene,","poem":2},{"text":"munowaridzira Rombo Rakanaka tafura,","poem":1},{"text":"uye munozadza zvirongo newaini yakavhenganisirwa Magumo,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ndichakuendesai kumunondo,","poem":1},{"text":"uye mose muchakotamira pasi kuti mubayiwe,","poem":2},{"text":"nokuti ndakadana asi hamuna kudavira,","poem":1},{"text":"ndakataura asi hamuna kuteerera.","poem":2},{"text":"Makaita zvakaipa pamberi pangu","poem":1},{"text":"mukasarudza zvisingandifadzi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Naizvozvo zvanzi naIshe Jehovha:","poem":1},{"lineBreak":true},{"text":"“Varanda vangu vachadya,","poem":1},{"text":"asi imi muchanzwa nzara;","poem":2},{"text":"varanda vangu vachanwa,","poem":1},{"text":"asi imi muchava nenyota;","poem":2},{"text":"varanda vangu vachafara,","poem":1},{"text":"asi imi muchanyadziswa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Varanda vangu vachaimba zvichibva mumufaro wemwoyo yavo,","poem":1},{"text":"asi imi muchachema nokurwadziwa nemwoyo","poem":2},{"lineBreak":true},{"text":"uye muchaungudza mukupwanyika kwomweya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Muchasiyira zita renyu","poem":1},{"text":"kuvasanangurwa vangu sechituko;","poem":2},{"text":"Ishe Jehovha achakuurayai,","poem":1},{"text":"asi achapa varanda vake rimwe zita.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani naani achati nyika iropafadzwe","poem":1},{"text":"achazviita naMwari wechokwadi;","poem":2},{"text":"ani naani achaita mhiko munyika","poem":1},{"text":"achapika naMwari wechokwadi.","poem":2},{"text":"Nokuti matambudziko akare achakanganwikwa,","poem":1},{"text":"uye achavanzirwa meso angu.","poem":2}]},{"type":"heading","content":["Matenga Matsva neNyika Itsva"]},{"type":"verse","number":17,"content":[{"text":"“Tarirai, ndichasika","poem":1},{"text":"matenga matsva nenyika itsva.","poem":2},{"text":"Zvinhu zvakare hazvichazorangarirwi,","poem":1},{"text":"kana kuuya mundangariro.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Asi farai mupembere nokusingaperi","poem":1},{"text":"mune zvandichasika,","poem":2},{"text":"nokuti ndichasika Jerusarema kuti rifadze","poem":1},{"text":"uye kuti vanhu varo vave mufaro.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndichapembera pamusoro peJerusarema,","poem":1},{"text":"uye ndichafarira vanhu vangu;","poem":2},{"text":"maungira okuchema kana kurira","poem":1},{"text":"haachazonzwikwazve imomo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mariri hamungazovazve","poem":1},{"text":"nomucheche achararama mazuva mashoma shoma,","poem":2},{"lineBreak":true},{"text":"kana mutana asingasvitsi makore ake okurarama;","poem":2},{"text":"uyo anofa ane zana ramakore","poem":1},{"text":"achangotorwa somujaya;","poem":2},{"text":"uyo anotadza kusvika pazana ramakore","poem":1},{"text":"achatorwa sowakatukwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vachavaka dzimba vagogara madziri;","poem":1},{"text":"vachadyara mazambiringa vagodya michero yawo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Havachazovakazve dzimba dzinozogarwa navamwe,","poem":1},{"text":"kana kudyara vamwe vachizodya.","poem":2},{"text":"Nokuti sezvakaita mazuva omuti,","poem":1},{"text":"ndizvo zvichaita mazuva avanhu vangu;","poem":2},{"text":"vasanangurwa vangu vachafara kwenguva refu","poem":1},{"text":"mumabasa amaoko avo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Havachazoshandira pasina","poem":1},{"text":"kana kubereka vana vanoparadzwa;","poem":2},{"text":"nokuti vachava vanhu vakaropafadzwa naJehovha,","poem":1},{"text":"ivo nezvizvarwa zvavo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Vasati vadana ndichavapindura;","poem":1},{"text":"vachiri kutaura ndichavanzwa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bumhi negwayana zvichafura pamwe chete,","poem":1},{"text":"uye shumba ichadya uswa senzombe,","poem":2},{"lineBreak":true},{"text":"asi guruva richava chokudya chenyoka.","poem":2},{"text":"Hazvichazokuvadza kana kuparadza","poem":1},{"text":"pamusoro pegomo rangu dzvene rose,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}