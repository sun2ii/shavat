{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":66,"content":[{"type":"heading","content":["Kutonga neTariro"]},{"type":"verse","number":1,"content":["Zvanzi naJehovha:",{"text":"“Denga ndicho chigaro changu,","poem":1},{"text":"uye nyika chitsiko chetsoka dzangu.","poem":2},{"text":"Ko, iripi imba yamungandivakira?","poem":1},{"text":"Nzvimbo yangu yokuzorora ichava kupiko?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haruzi ruoko rwangu rwakaita izvozvi zvose here,","poem":1},{"text":"nokudaro zvikavapo?”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"lineBreak":true},{"text":"“Munhu akadai ndiye wandichakudza:","poem":1},{"text":"iye anozvininipisa uye ane mweya wakapwanyika,","poem":2},{"lineBreak":true},{"text":"uye anodedera paanonzwa shoko rangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asi ani naani anobayira hando","poem":1},{"text":"akafanana nouyo anouraya munhu,","poem":2},{"text":"uye anobayira gwayana,","poem":1},{"text":"anofanana nouyo anovhuna mutsipa wembwa;","poem":2},{"text":"ani naani anoita chipiriso chezviyo","poem":1},{"text":"anofanana nomunhu anopa ropa renguruve,","poem":2},{"text":"uye ani naani anopisira zvinonhuhwira zvokurangaridza,","poem":1},{"text":"anofanana nounonamata chifananidzo.","poem":2},{"text":"Vakasarudza nzira dzavo,","poem":1},{"text":"uye mweya yavo inofarira zvinonyangadza zvavo;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"naizvozvo neniwo ndichavasarudzira kuranga kuchavaomera,","poem":1},{"text":"uye ndichauyisa pamusoro pavo izvo zvavanotya.","poem":2},{"text":"Nokuti pandakadana, hapana akapindura,","poem":1},{"text":"pandakataura, hapana akateerera.","poem":2},{"text":"Vakaita zvakaipa pamberi pangu","poem":1},{"text":"vakasarudza zvisingandifadzi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Inzwai shoko raJehovha,","poem":1},{"text":"imi munodedera pamunonzwa shoko rake:","poem":2},{"text":"“Hama dzenyu dzinokuvengai,","poem":1},{"text":"uye dzinokutsaurai nokuda kwezita rangu, dzakati,","poem":2},{"text":"‘Jehovha ngaaratidze kukudzwa kwake,","poem":1},{"text":"kuti tione mufaro wenyu!’","poem":2},{"lineBreak":true},{"text":"Asi ivo vachanyadziswa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inzwai maungira ebope anobva muguta,","poem":1},{"text":"inzwai mheremhere inobva mutemberi!","poem":2},{"text":"Ndiwo maungira aJehovha","poem":1},{"text":"achiripira vavengi vake zvose zvakavakodzera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Asati arwadziwa nemimba,","poem":1},{"text":"anosununguka;","poem":2},{"text":"kurwadza kusati kwauya pamusoro pake,","poem":1},{"text":"anosununguka mwanakomana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndiani akambonzwa chinhu chakadai?","poem":1},{"text":"Ndiani akamboona zvinhu zvakadai?","poem":2},{"text":"Ko, nyika ingazvarwa pazuva rimwe here","poem":1},{"text":"kana rudzi rungazvarwa pakarepo here?","poem":2},{"text":"Kunyange zvakadaro, Zioni rakangoti kurwadziwa,","poem":1},{"text":"pakarepo ndokubereka vana varo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndingasvitsa panguva yokubereka","poem":1},{"text":"ndikasaberekesa here?” ndizvo zvinotaura Jehovha.","poem":2},{"text":"“Ko, ndinozarira chizvaro","poem":1},{"text":"pandinoberekesa here?” ndizvo zvinotaura Mwari wenyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Pemberai pamwe chete neJerusarema uye mufarisise nokuda kwaro,","poem":1},{"text":"imi mose munorida;","poem":2},{"text":"farisisai pamwe chete naro,","poem":1},{"text":"imi mose munochema pamusoro paro.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokuti muchanwa mukaguta","poem":1},{"text":"pamazamu ake anonyaradza;","poem":2},{"text":"muchanwa zvikuru kwazvo","poem":1},{"text":"uye muchafadzwa nezvakawanda zvake zvinopfachukira.”","poem":2}]},{"type":"verse","number":12,"content":["Nokuti zvanzi naJehovha:",{"text":"“Ndichawedzera rugare kwaari sorwizi,","poem":1},{"text":"uye upfumi hwendudzi sokudira kworukova;","poem":2},{"text":"muchayamwa uye muchatakurwa paruoko rwake,","poem":1},{"text":"uye muchavaraidzwa pamabvi ake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Samai vanonyaradza mwana wavo,","poem":1},{"text":"saizvozvo ndichakunyaradzai;","poem":2},{"lineBreak":true},{"text":"uye muchanyaradzwa pamusoro peJerusarema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Pamuchaona izvozvo, mwoyo wenyu uchafara,","poem":1},{"text":"uye muchaita bumhudza sebundo;","poem":2},{"text":"ruoko rwaJehovha rucharatidzwa kuvaranda vake,","poem":1},{"text":"asi hasha dzake dzicharatidzwa kuvavengi vake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tarirai, Jehovha ari kuuya nomoto,","poem":1},{"text":"uye ngoro dzake dzakaita sechamupupuri;","poem":2},{"text":"achaburutsa kutsamwa kwake nehasha huru,","poem":1},{"text":"uye kutuka kwake nomurazvo womoto.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nokuti nomoto uye nomunondo wake","poem":1},{"text":"Jehovha achatonga vanhu vose,","poem":2},{"lineBreak":true},{"text":"uye vazhinji vachava vaya vanourayiwa naJehovha.","poem":2}]},{"type":"verse","number":17,"content":["“Vaya vanozvinatsa nokuzvichenesa kuti vaende mumapindu, vachitevera munhu ari pakati paavo vanodya nyama yenguruve nembeva uye nezvimwe zvinhu zvinonyangadza, magumo avo achava mamwe chete,” ndizvo zvinotaura Jehovha."]},{"type":"verse","number":18,"content":["“Nokuti ini nokuda kwamabasa avo nepfungwa dzavo, ndiri kuuya kuzounganidza marudzi ose nendimi dzose; vachauya uye vachaona kubwinya kwangu."]},{"type":"verse","number":19,"content":["“Ndichaisa chiratidzo pakati pavo, uye ndichatumira vamwe vavakapunyuka kundudzi, kuTashishi, nokuvaRibhiya navaRidhia (vane mbiri yokuwembura uta), nokuTubhari nokuGirisi, nokuzviwi zviri kure zvisina kumbonzwa nezvembiri yangu kana kuona kubwinya kwangu. Vachaparidza kubwinya kwangu pakati pendudzi."]},{"type":"verse","number":20,"content":["Uye vachauyisa hama dzenyu dzose, kubva kundudzi dzose, kugomo rangu dzvene muJerusarema, sechipo kuna Jehovha, pamusoro pamabhiza, nomungoro uye mungoro dzina matenga, napamanyurusi uye napangamera,” ndizvo zvinotaura Jehovha. “Vachazviuyisa, savaIsraeri vanouyisa zvipiriso zvavo zvezviyo, kutemberi yaJehovha mumidziyo yakacheneswa."]},{"type":"verse","number":21,"content":["Ipapo ndichasarudza vamwe vavo kuti vave vaprista navaRevhi,” ndizvo zvinotaura Jehovha."]},{"type":"verse","number":22,"content":["“Nokuti sezvakaita matenga matsva nenyika itsva zvandinoita zvichazogara pamberi pangu,” ndizvo zvinotaura Jehovha, “saizvozvo zita renyu nezvizvarwa zvenyu zvichagara."]},{"type":"verse","number":23,"content":["Kubva paKugara kwoMwedzi kusvikira kuno mumwe, uye kubva paSabata rimwe kusvikira kune rimwe, marudzi ose achauya kuzokotama pamberi pangu,” ndizvo zvinotaura Jehovha."]},{"type":"verse","number":24,"content":["“Vachabudapo vachindotarira zvitunha zvaavo vaindimukira; honye yavo haizofi, moto wavo haungadzimwi, uye vachasemesa vanhu vose.”"]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}