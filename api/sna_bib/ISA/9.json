{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ISA","translationId":"sna_bib","name":"Isaya","commonName":"Isaya","title":"ISAYA","order":23,"numberOfChapters":66,"sha256":"e00926f74965a40e6ec66e51b29ecd57e807cb7f8d488ab8ac429a8b7087bec4","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sna_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Isu tazvarirwa Mwana"]},{"type":"verse","number":1,"content":["Kunyange zvakadaro, hakuchazovazve nerima kuna avo vakanga vari munhamo. Pamazuva akare akaninipisa nyika yeZebhuruni nenyika yeNafutari, asi panguva inouya achakudza Garirea reveDzimwe Ndudzi, nenzira yokugungwa mhiri kwaJorodhani."]},{"type":"verse","number":2,"content":[{"text":"Vanhu vaifamba murima","poem":1},{"text":"vakaona chiedza chikuru;","poem":2},{"text":"avo vaigara munyika yomumvuri worufu,","poem":1},{"text":"chiedza chakavavhenekera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Makakurisa rudzi mukawedzera mufaro wavo;","poem":1},{"text":"vanofara pamberi penyu","poem":2},{"text":"savanhu vanofara","poem":1},{"text":"panguva yokukohwa,","poem":2},{"text":"sokufara kwavarume,","poem":1},{"text":"kana vachigoverana zvakapambwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nokuti sapamazuva okukundwa kwavaMidhia,","poem":1},{"text":"vamakaparadzira","poem":2},{"text":"joko raivaremera,","poem":1},{"text":"nedanda raichinjika mafudzi avo,","poem":2},{"lineBreak":true},{"text":"iyo tsvimbo yavamanikidzi vavo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Shangu imwe neimwe yomurwi yakashandiswa muhondo,","poem":1},{"text":"nenguo imwe neimwe yakaumburudzwa muropa,","poem":2},{"text":"zvichapiswa,","poem":1},{"text":"zvichava huni dzomoto.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nokuti takazvarirwa mwana,","poem":1},{"text":"takapiwa mwanakomana,","poem":2},{"lineBreak":true},{"text":"uye umambo huchava pamapfudzi ake.","poem":2},{"text":"Uye achanzi Gota Rinoshamisa,","poem":1},{"text":"Mwari Ane Simba,","poem":2},{"lineBreak":true},{"text":"Baba Vokusingaperi, Muchinda woRugare.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kukura kwoumambo hwake nekworugare rwake","poem":1},{"text":"hazvizovi namagumo.","poem":2},{"text":"Achatonga pachigaro choushe chaDhavhidhi","poem":1},{"text":"napamusoro poumambo hwake,","poem":2},{"text":"achihusimbisa nokuhutsigira,","poem":1},{"text":"nokururamisira uye nokururama,","poem":2},{"lineBreak":true},{"text":"kubva panguva iyoyo kusvikira nokusingaperi.","poem":2},{"text":"Kushingaira kwaJehovha Wamasimba Ose","poem":1},{"text":"kuchazviita.","poem":2}]},{"type":"heading","content":["Kutsamwa kwaJehovha pamusoro peIsraeri"]},{"type":"verse","number":8,"content":[{"text":"Jehovha akatuma shoko pamusoro paJakobho;","poem":1},{"text":"richawira pamusoro paIsraeri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vanhu vose vachariziva,","poem":1},{"text":"Efuremu navagari vomuSamaria,","poem":2},{"text":"ivo vanoti nokuzvikudza kwavo","poem":1},{"text":"uye namanyawi emwoyo,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Zvidhinha zvakoromokera pasi,","poem":1},{"text":"asi tichavakazve namatombo;","poem":2},{"text":"mionde yatemerwa pasi,","poem":1},{"text":"asi tichaitsiva nemisidhari.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asi Jehovha akamutsira Rezini vadzivisi","poem":1},{"text":"akakurudzira vavengi vavo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"VaAramu vachibva nokumabvazuva navaFiristia vachibva","poem":1},{"text":"nokumavirira vakapedza vaIsraeri nomuromo wakashama.","poem":2},{"lineBreak":true},{"text":"Kunyange zvakadaro, kutsamwa kwake hakuna kudzorwa,","poem":1},{"text":"asi ruoko rwake ruchatongotambanudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Asi vanhu havana kutendeukira kuna iye akavarova,","poem":1},{"text":"kana kutsvaka Jehovha Wamasimba Ose.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Naizvozvo Jehovha achadimura vaIsraeri vose musoro nomuswe,","poem":1},{"text":"zvose davi romuchindwe norutsanga pazuva rimwe;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"vakuru navarume vanokudzwa ndivo musoro,","poem":1},{"text":"vaprofita vanodzidzisa nhema ndivo muswe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Vanotungamirira vanhu ava vanovatsausa,","poem":1},{"text":"navose vanotungamirirwa vanotsauswa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naizvozvo Jehovha haachazofariri majaya,","poem":1},{"text":"kana kuva netsitsi nenherera nechirikadzi,","poem":2},{"text":"nokuti mumwe nomumwe wavo haana umwari uye akaipa,","poem":1},{"text":"muromo mumwe nomumwe unotaura zvoupenzi.","poem":2},{"lineBreak":true},{"text":"Kunyange zvakadaro, kutsamwa kwake hakuna kudzorwa,","poem":1},{"text":"ruoko rwake ruchakangosimudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Zvirokwazvo zvakaipa zvinopfuta somoto;","poem":1},{"text":"unopisa rukato neminzwa,","poem":2},{"text":"unopisa matenhere edondo zvokuti unokwira","poem":1},{"text":"kudenga mushongwe youtsi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kubudikidza nokutsamwa kwaJehovha Wamasimba Ose","poem":1},{"text":"nyika ichapiswa kwazvo","poem":2},{"text":"uye vanhu vachava huni dzomoto;","poem":1},{"text":"hapana achaponesa hama yake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kurudyi vachadya","poem":1},{"text":"asi vacharamba vane nzara;","poem":2},{"text":"kuruboshwe,","poem":1},{"text":"vachadya asi havangaguti.","poem":2},{"text":"Mumwe nomumwe achadya nyama yomwana wake.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Manase achadya Efuremu uye Efuremu achadya Manase;","poem":2},{"lineBreak":true},{"text":"pamwe chete vachamukira Judha.","poem":2},{"lineBreak":true},{"text":"Kunyange zvakadaro, kutsamwa kwake hakuna kudzorwa,","poem":1},{"text":"ruoko rwake ruchakangosimudzwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}