{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JDG","translationId":"sna_bib","name":"Vatongi","commonName":"Vatongi","title":"VATONGI","order":7,"numberOfChapters":21,"sha256":"dcfef0cd9010dd1975e87f75f91bf25f35f256864b087969fd2b3ab51ad5f349","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/sna_bib/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Rwiyo rwaDhibhora"]},{"type":"verse","number":1,"content":["Nomusi uyo Dhibhora naBharaki mwanakomana waAbhinoami vakaimba rwiyo urwu runoti:"]},{"type":"verse","number":2,"content":[{"text":"“Kana machinda aIsraeri achitungamirira,","poem":1},{"text":"kana vanhu vachizvipira pachavo","poem":2},{"lineBreak":true},{"text":"Jehovha ngaarumbidzwe!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Inzwai izvi, imi madzimambo! Teererai imi vatongi!","poem":1},{"text":"Ndichaimbira Jehovha, ini ndichaimba;","poem":2},{"lineBreak":true},{"text":"ndichaimbira Jehovha, Mwari waIsraeri.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Haiwa Jehovha, pamakabuda kubva muSeiri,","poem":1},{"text":"pamakafamba muchibva munyika yeEdhomu, Nyika","poem":2},{"text":"yakadengenyeka, matenga akadurura,","poem":1},{"text":"makore akadurura mvura pasi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Makomo akadengenyeka pamberi paJehovha, Iye weSinai,","poem":1},{"text":"pamberi paJehovha, Mwari weIsraeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mumazuva aShamugari mwanakomana waAnati,","poem":1},{"text":"mumazuva aJaeri, migwagwa yakasiyiwa;","poem":2},{"lineBreak":true},{"text":"vafambi vakafamba nenzira dzinopoterera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Upenyu hwomumisha hwakapera,","poem":1},{"text":"hwakapera kusvikira ini Dhibhora, ndasimuka,","poem":2},{"lineBreak":true},{"text":"ndasimuka ini mai muIsraeri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pavakasarudza vamwari vatsva,","poem":1},{"text":"hondo yakauya ichibva nokumasuo eguta,","poem":2},{"text":"uye hakuna nhoo kana pfumo zvakaonekwa","poem":1},{"text":"pakati pezviuru makumi mana muIsraeri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwoyo wangu uri pamachinda eIsraeri,","poem":1},{"text":"navaya vanozvipira pakati pavanhu.","poem":2},{"lineBreak":true},{"text":"Rumbidzai Jehovha!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Imi munotasva mbongoro chena,","poem":1},{"text":"mugere pamachira ezvigaro zvenyu,","poem":2},{"lineBreak":true},{"text":"nemi munofamba munzira,","poem":2},{"text":"cherechedzai","poem":1}]},{"type":"verse","number":11,"content":[{"text":"inzwi ravaimbi panzvimbo dzemvura.","poem":1},{"text":"Vanodetemba mabasa akarurama aJehovha,","poem":2},{"lineBreak":true},{"text":"Mabasa akarurama avarwi vake muIsraeri.","poem":2},{"lineBreak":true},{"text":"“Ipapo vanhu vaJehovha vakaburuka","poem":1},{"text":"vakaenda kusuo reguta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"‘Muka, muka, Dhibhora! Muka,","poem":1},{"text":"muka, uimbe rwiyo!","poem":2},{"text":"Simuka, Bharaki!","poem":1},{"text":"Tapa vatapwa vako, iwe mwanakomana waAbhinoami.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ipapo varume vakanga vasara","poem":1},{"text":"vakaburuka vakaenda kumakurukota;","poem":2},{"text":"vanhu vaJehovha vakauya","poem":1},{"text":"kwandiri navane simba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vamwe vakauya vachibva kwaEfuremu, midzi yavo yakanga iri muna Amareki;","poem":1},{"text":"Bhenjamini akanga ari pakati pavanhu vakakutevera iwe.","poem":2},{"text":"Kubva kuna Makiri vatungamiri vakaburuka,","poem":1},{"text":"kubva kuZebhuruni avo vanotakura tsvimbo yomutungamiri wehondo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Machinda aIsakari akanga ana Dhibhora;","poem":1},{"text":"hongu Isakari akanga ana Bharaki,","poem":2},{"text":"vachimhanyira kumupata vachimutevera.","poem":1},{"text":"Mudunhu raRubheni makanga muno kunzvera kwomwoyo kukuru.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Seiko wakagara pakati pezvoto kuti","poem":1},{"text":"unzwe muridzo unoridzirwa matanga emakwai?","poem":2},{"text":"Mudunhu raRubheni makanga","poem":1},{"text":"muno kunzvera kwomwoyo kukuru.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gireadhi akagara mhiri kwaJorodhani.","poem":1},{"text":"Uye Dhani akasarireiko pazvikepe?","poem":2},{"text":"Asha akasara zvake pamahombekombe","poem":1},{"text":"Uye akagara zvake panopinda mvura dzegungwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vanhu veZebhuruni vakaisa upenyu hwavo panjodzi;","poem":1},{"text":"neNafutari yakadarowo panzvimbo dzakakwirira dzeminda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Madzimambo akauya, akarwa;","poem":1},{"text":"madzimambo eKenani akarwa","poem":2},{"text":"paTaanaki pamvura zhinji yeMegidho,","poem":1},{"text":"asi havana kudzoka vakatakura sirivha, kana zvakapambwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kubva kumatenga nyeredzi dzakarwa,","poem":1},{"text":"dziri panzira dzadzo dzakarwa naSisera.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Rwizi Kishoni rwakavakukura,","poem":1},{"text":"irwo rwizi rwakare, rwizi Kishoni.","poem":2},{"lineBreak":true},{"text":"Pfuurira mberi, mweya wangu, simba!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ipapo mahwanda amabhiza akatinhira,","poem":1},{"text":"kumhanya, kumhanya kwoune simba.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mutumwa waJehovha akati, ‘Tuka Merozi.","poem":1},{"text":"Tuka vanhu varo zvikuru kwazvo,","poem":2},{"text":"nokuti havana kuuya kuzobatsira Jehovha,","poem":1},{"text":"kubatsira Jehovha kurwisa vane simba.’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Jaeri ngaave mukadzi akaropafadzwa zvikuru,","poem":1},{"text":"iye mukadzi waHebheri muKeni,","poem":2},{"lineBreak":true},{"text":"akaropafadzwa kwazvo kupfuura vakadzi vagere mutende.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Akakumbira mvura, iye akamupa mukaka;","poem":1},{"text":"akamuvigira mukaka wakakora mundiro yakafanira makurukota.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ruoko rwake rwakatambanudzirwa pambambo yetende,","poem":1},{"text":"ruoko rwake rworudyi kunyundo yomuvezi.","poem":2},{"text":"Akabaya Sisera, akapwanya musoro wake,","poem":1},{"text":"akapwanya uye akabvoora zvavovo zvake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Patsoka dzake, akanyura,","poem":1},{"text":"akawa; hoyo akatandavarapo.","poem":2},{"text":"Patsoka dzake akanyura, akawa;","poem":1},{"text":"paakanyura, ndipo paakawira, akafa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Napawindo mai vaSisera vakadongorera;","poem":1},{"text":"vari seri kworutanda, vakadanidzira vachiti,","poem":2},{"text":"‘Seiko ngoro yake yanonoka kusvika?","poem":1},{"text":"Seiko kurira kwengoro dzake kwanonoka?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Vakadzi vokwake vakachenjera kukunda vose vanomupindura;","poem":1},{"text":"zvirokwazvo, anoramba achiti,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘Ko, havasi kuwana nokugoverana zvakapambwa here vachiti,","poem":1},{"text":"musikana mumwe chete kana vaviri pamurume mumwe chete,","poem":2},{"lineBreak":true},{"text":"nguo dzina mavara dzezvakapambwa zvaSisera,","poem":2},{"lineBreak":true},{"text":"nguo dzina mavara dzakarukwa,","poem":2},{"lineBreak":true},{"text":"nguo dzakanyatsorukwa dzomutsipa wangu,","poem":2},{"text":"zvose izvi zviri zvakapambwa?’","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Saka vavengi venyu vose ngavaparare, imi Jehovha!","poem":1},{"text":"Asi vanokudai ngavave sezuva","poem":2},{"lineBreak":true},{"text":"parinobuda nesimba raro.”","poem":2},"Ipapo nyika yakava norugare kwamakore makumi mana."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}