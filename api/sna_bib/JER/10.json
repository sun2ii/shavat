{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["Mwari neZvifananidzo"]},{"type":"verse","number":1,"content":["Inzwai zvinoreva Jehovha kwamuri, imi imba yaIsraeri."]},{"type":"verse","number":2,"content":["Zvanzi naJehovha:",{"text":"“Regai kudzidza tsika dzendudzi","poem":1},{"text":"kana kuvhundutswa nezviratidzo zviri kudenga","poem":2},{"lineBreak":true},{"text":"kunyange hazvo ndudzi dzichivhundutswa nazvo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti tsika dzavanhu hadzina maturo;","poem":1},{"text":"vanotema muti musango,","poem":2},{"lineBreak":true},{"text":"muvezi ouveza nembezo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vanoushongedza nesirivha negoridhe;","poem":1},{"text":"vanourovera nenyundo nezvipikiri","poem":2},{"lineBreak":true},{"text":"kuti urege kuzungunuka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sedukununu kumucheto womunda wamavise,","poem":1},{"text":"zvifananidzo zvavo hazvigoni kutaura;","poem":2},{"text":"zvinofanira kutotakurwa nokuti hazvigoni kufamba.","poem":1},{"text":"Musazvitya; hazvigoni kukukuvadzai,","poem":2},{"lineBreak":true},{"text":"uye hazvina nebasa rose.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hakuna akafanana nemi, imi Jehovha;","poem":1},{"text":"muri mukuru,","poem":2},{"lineBreak":true},{"text":"uye zita renyu iguru pasimba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndianiko angarega kukutyai,","poem":1},{"text":"imi Mambo wendudzi?","poem":2},{"text":"Izvi ndizvo zvakakufanirai.","poem":1},{"text":"Pakati pavakachenjera vose vendudzi nomuushe hwavo hwose,","poem":2},{"lineBreak":true},{"text":"hakuna akafanana nemi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vose havana njere uye mapenzi;","poem":1},{"text":"vanodzidziswa nezvifananidzo zvamatanda zvisingabatsiri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sirivha yakapfurwa inotorwa kubva kuTashishi","poem":1},{"text":"negoridhe richibva kuUfazi.","poem":2},{"text":"Zvakaitwa nemhizha uye nomupfuri wegoridhe,","poem":1},{"text":"zvopfekedzwa zvino nguo dzomucheka webhuruu nowepepuru,","poem":2},{"lineBreak":true},{"text":"zvose zvinoitwa navabati vano umhizha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asi Jehovha ndiye Mwari wechokwadi; ndiye Mwari mupenyu,","poem":1},{"text":"mambo wokusingaperi.","poem":2},{"text":"Kana iye atsamwa, nyika inodedera;","poem":1},{"text":"ndudzi hadzigoni kumira pamberi pehasha dzake.","poem":2}]},{"type":"verse","number":11,"content":["“Muvaudze kuti, ‘Vamwari ava, vasina kuita matenga nenyika, vachaparara panyika nepasi pamatenga.’ ”"]},{"type":"verse","number":12,"content":[{"text":"Asi Mwari akaita nyika nesimba rake,","poem":1},{"text":"akateya nyika nouchenjeri hwake,","poem":2},{"lineBreak":true},{"text":"uye akatambanudza matenga nokunzwisisa kwake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Paanotinhira, mvura zhinji iri mumatenga inoita mubvumo;","poem":1},{"text":"anoita kuti makore asimuke kubva kumigumo yenyika.","poem":2},{"text":"Anotuma mheni pamwe nemvura,","poem":1},{"text":"uye anouyisa mhepo kubva mumatura ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mumwe nomumwe haafungi uye haana zivo;","poem":1},{"text":"mupfuri mumwe nomumwe wegoridhe anonyadziswa nezvifananidzo zvake.","poem":2},{"text":"Zvifananidzo zvake ndezvenhema;","poem":1},{"text":"hazvina mweya mazviri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hazvina maturo, zvinhu zvokutuka;","poem":1},{"text":"kutongwa kwazvo pakunosvika, zvose zvichaparara.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iye anenge ari mugove waJakobho haana kufanana nazvo,","poem":1},{"text":"nokuti ndiye Muiti wezvinhu zvose,","poem":2},{"text":"kusanganisa naIsraeri, rudzi rwenhaka yake,","poem":1},{"text":"Jehovha Wamasimba Ose ndiro zita rake.","poem":2}]},{"type":"heading","content":["Kuparadzwa Kuri Kuuya"]},{"type":"verse","number":17,"content":[{"text":"Unganidzai nhumbi dzenyu mubve munyika,","poem":1},{"text":"imi makakombwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nokuti zvanzi naJehovha:","poem":1},{"text":"“Panguva ino ndichapotsera kure","poem":2},{"lineBreak":true},{"text":"avo vanogara munyika ino;","poem":2},{"text":"Ndichauyisa nhamo","poem":1},{"text":"pamusoro pavo kuti vagotapwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ndine nhamo nokuda kwokukuvara kwangu!","poem":1},{"text":"Ronda rangu harirapiki! Asi ndakati,","poem":2},{"text":"“Uku kurwara ndokwangu,","poem":1},{"text":"uye ndinofanira kukutakura.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tende rangu raparadzwa;","poem":1},{"text":"mabote aro ose adamburwa.","poem":2},{"text":"Vanakomana vangu vabva kwandiri uye havachipozve;","poem":1},{"text":"hakuna asara zvino kuti amise tende rangu","poem":2},{"lineBreak":true},{"text":"kana kumisa dumba rangu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vafudzi havana njere,","poem":1},{"text":"uye havabvunzi Jehovha;","poem":2},{"text":"saka havabudiriri","poem":1},{"text":"uye makwai avo ose apararira.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Inzwai! Chiziviso chiri kuuya,","poem":1},{"text":"bope guru richabva kunyika yokumusoro!","poem":2},{"text":"Richaita kuti maguta eJudha aparare,","poem":1},{"text":"agarwe namakava.","poem":2}]},{"type":"heading","content":["Munyengetero waJeremia"]},{"type":"verse","number":23,"content":[{"text":"Haiwa Jehovha, ndinoziva kuti upenyu hwomunhu hahusi hwake;","poem":1},{"text":"hazvizi kumunhu kuti aruramise nzira dzake.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndirangei, Jehovha, asi chete nokururamisira,","poem":1},{"text":"kwete mukutsamwa kwenyu,","poem":2},{"lineBreak":true},{"text":"kuti murege kundiparadza zvachose.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Dururirai kutsamwa kwenyu pamusoro pendudzi","poem":1},{"text":"dzisingakurangarirei,","poem":2},{"lineBreak":true},{"text":"pamusoro pavanhu vasingadani kuzita renyu.","poem":2},{"text":"Nokuti vakadya Jakobho;","poem":1},{"text":"vakamudya zvachose,","poem":2},{"lineBreak":true},{"text":"uye vakaparadza nyika yake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}