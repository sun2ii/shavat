{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Kugununʼuna kwaJeremia"]},{"type":"verse","number":1,"content":[{"text":"Imi munogara makarurama, iyemi Jehovha,","poem":1},{"text":"pandinouya pamberi penyu nemhaka.","poem":2},{"text":"Kunyange zvakadaro ndichataura nemi pamusoro pokururamisira kwenyu, ndichiti:","poem":1},{"text":"Nemhaka yeiko nzira yavakaipa ichibudirira?","poem":2},{"lineBreak":true},{"text":"Nemhaka yei vasingatendi vachirarama zvakanaka?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Makavasima, uye vava nemidzi;","poem":1},{"text":"vanokura uye vanobereka muchero.","poem":2},{"text":"Imi munogara muri pamiromo yavo","poem":1},{"text":"asi muri kure nemwoyo yavo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asi munondiziva, imi Jehovha;","poem":1},{"text":"munondiona uye munoedza ndangariro dzangu pamusoro penyu.","poem":2},{"text":"Vakwekweredzei samakwai anondobayiwa!","poem":1},{"text":"Muvagadzirire zuva rokubayiwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nyika ichasvika riniko yakangooma,","poem":1},{"text":"nebundo resango rakangosvava?","poem":2},{"text":"Nokuti vose vanogaramo vakaipa,","poem":1},{"text":"mhuka neshiri zvaparara.","poem":2},{"text":"Pamusoro paizvozvo, vanhu vanoti,","poem":1},{"text":"“Haasi kuzoona zvinoitika kwatiri.”","poem":2}]},{"type":"heading","content":["Mhinduro yaMwari"]},{"type":"verse","number":5,"content":[{"text":"“Kana wakaita nhangemutange navanhu netsoka,","poem":1},{"text":"uye vakakunetesa","poem":2},{"lineBreak":true},{"text":"ungagokwikwidzana sei namabhiza?","poem":2},{"text":"Kana uchigumburwa panyika yakanaka,","poem":1},{"text":"ungagara seiko mumatenhere eJorodhani?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hama dzako, mhuri yako chaiyo,","poem":1},{"text":"kunyange naivowo vakakumukira;","poem":2},{"lineBreak":true},{"text":"vakadanidzira zvikuru kwazvo pamusoro pako.","poem":2},{"text":"Usavimba navo,","poem":1},{"text":"kunyange vachitaura zvakanaka pamusoro pako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ndichasiya imba yangu,","poem":1},{"text":"ndigorasa nhaka yangu;","poem":2},{"text":"ndichapa mudikani wangu","poem":1},{"text":"mumaoko avavengi vake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nhaka yangu yava kwandiri","poem":1},{"text":"seshumba iri musango.","poem":2},{"text":"Anoomba pamberi pangu;","poem":1},{"text":"naizvozvo ndinomuvenga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ko, nhaka yangu haizova kwandiri segondo rina mavara here,","poem":1},{"text":"iro rinokombwa","poem":2},{"lineBreak":true},{"text":"uye rinorwiswa namamwe makondo?","poem":2},{"text":"Endai munounganidza zvikara zvose;","poem":1},{"text":"muuye nazvo zvidye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vafudzi vazhinji vachaparadza munda","poem":1},{"text":"wangu womuzambiringa,","poem":2},{"text":"uye vachatsindira munda wangu;","poem":1},{"text":"vachashandura munda wangu unofadza kuti uve dongo risina chinhu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uchaitwa dongo rakaoma","poem":1},{"text":"uye rakaparadzwa pamberi pangu;","poem":2},{"text":"nyika yose ichava dongo","poem":1},{"text":"nokuti hakuna ane hanya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pamusoro pezvikomo zvisina miti zviri mugwenga,","poem":1},{"text":"vaparadzi vachamomotera,","poem":2},{"text":"nokuti munondo waJehovha uchaparadza,","poem":1},{"text":"kubva kuno rumwe rutivi rwenyika kusvikira kuno rumwe,","poem":2},{"lineBreak":true},{"text":"hakuna achava norugare.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vachadyara gorosi asi vachakohwa minzwa;","poem":1},{"text":"vachazvinetesa asi hakuna chavachawana.","poem":2},{"text":"Saka zvitakurirei kunyadziswa kwegohwo renyu,","poem":1},{"text":"nokuda kwokutsamwa kunotyisa kwaJehovha.”","poem":2}]},{"type":"verse","number":14,"content":["Zvanzi naJehovha: “Kana vari vakaipa vakavakidzana nemi vanopamba nhaka yandakapa vanhu vangu vaIsraeri ndichavadzura munyika dzavo uye ndichadzura imba yaJudha kubva pakati pavo."]},{"type":"verse","number":15,"content":["Asi mushure mokuvadzura, ndichavanzwirazve tsitsi uye ndichadzosa mumwe nomumwe wavo kunhaka yake nokunyika yake."]},{"type":"verse","number":16,"content":["Zvino kana vadzidza zvakanaka nzira dzavanhu vangu uye vakapika nezita rangu, vachiti, ‘Zvirokwazvo naJehovha mupenyu,’ kunyange havo vakambodzidzisa vanhu vangu kupika naBhaari, ipapo vachasimbiswa pakati pavanhu vangu."]},{"type":"verse","number":17,"content":["Asi kana pano rudzi rusingateereri, ndicharudzura zvachose ndigoruparadza,” ndizvo zvinotaura Jehovha."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}