{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":13,"content":[{"type":"heading","content":["Bhanhire roMucheka"]},{"type":"verse","number":1,"content":["Zvakanzi naJehovha kwandiri: “Enda unotenga bhanhire romucheka urisunge muchiuno chako, asi usarege richipinda mvura,”"]},{"type":"verse","number":2,"content":["Saka ndakatenga bhanhire, sezvandakarayirwa naJehovha, ndokurisunga muchiuno changu."]},{"type":"verse","number":3,"content":["Ipapo shoko raJehovha rakauya kwandiri kechipiri richiti,"]},{"type":"verse","number":4,"content":["“Tora bhanhire rawakatenga, rawakasunga muchiuno chako uende iye zvino kuPerati undoriviga ikoko mumukaha wamatombo.”"]},{"type":"verse","number":5,"content":["Saka ndakaenda ndikandoriviga paPerati sezvandakaudzwa naJehovha."]},{"type":"verse","number":6,"content":["Mazuva mazhinji akati apfuura Jehovha akati kwandiri, “Chienda zvino kuPerati undotora bhanhire randakati uvigeko.”"]},{"type":"verse","number":7,"content":["Naizvozvo ndakaenda kuPerati ndokufukunura bhanhire ndokuritora, uye risingachabatsiri zvachose."]},{"type":"verse","number":8,"content":["Ipapo shoko raJehovha rakauya kwandiri, richiti,"]},{"type":"verse","number":9,"content":["“Zvanzi naJehovha: ‘Nenzira imwe cheteyo ndichaodza kuzvikudza kweJudha nokuzvikudza kukuru kweJerusarema."]},{"type":"verse","number":10,"content":["Vanhu ava vakaipa, vanoramba kunzwa mashoko angu, vanotevera kusindimara kwemwoyo yavo uye vanoenda kuna vamwe vamwari kuti vavashumire uye vavanamate, vachafanana nebhanhire iri, risingabatsiri chose!"]},{"type":"verse","number":11,"content":["Nokuti sebhanhire rinosungwa muchiuno saizvozvo ndakasungira imba yose yaIsraeri neimba yose yaJudha kwandiri,’ ndizvo zvinotaura Jehovha, ‘kuti vave vanhu vemukurumbira wangu, kurumbidzwa kwangu nokukudzwa kwangu. Asi havana kuteerera.’"]},{"type":"heading","content":["Hombodo dzeWaini Dzamatehwe"]},{"type":"verse","number":12,"content":["“Uti kwavari, ‘Zvanzi naJehovha, Mwari waIsraeri: Hombodo imwe neimwe yedehwe yewaini inofanira kuzadzwa newaini.’ Zvino kana vakati kwauri, ‘Ko, isu hatizivi here kuti hombodo imwe neimwe yedehwe yewaini inofanira kuzadzwa newaini?’"]},{"type":"verse","number":13,"content":["ipapo uvaudze kuti, ‘Zvanzi naJehovha: Ndichadhakisa vose vanogara munyika ino, pamwe chete namadzimambo anogara pachigaro choushe chaDhavhidhi, navaprista navaprofita navose vanogara muJerusarema."]},{"type":"verse","number":14,"content":["Ndichavabonderedza mumwe kuno mumwe, madzibaba navanakomana saizvozvo, ndizvo zvinotaura Jehovha. Handingabvumiri tsitsi kana ngoni dzangu kuti zvindidzivise kuvaparadza.’ ”"]},{"type":"heading","content":["Dambudziko roKuendeswa kuUtapwa"]},{"type":"verse","number":15,"content":[{"text":"Inzwai, rerekai nenzeve dzenyu kwandiri,","poem":1},{"text":"musazvikudza,","poem":2},{"lineBreak":true},{"text":"nokuti Jehovha ataura.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Rumbidzai Jehovha Mwari","poem":1},{"text":"wenyu asati auyisa rima,","poem":2},{"text":"makumbo enyu asati agumburwa","poem":1},{"text":"pamakomo erima.","poem":2},{"text":"Munotarisira chiedza,","poem":1},{"text":"asi iye achachishandura kuti chive mumvuri worufu,","poem":2},{"lineBreak":true},{"text":"uye achachiita rima guru.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Asi kana musingateereri,","poem":1},{"text":"ndichachema pakavanda","poem":2},{"lineBreak":true},{"text":"nokuda kwokuzvikudza kwenyu;","poem":2},{"text":"Meso angu achachema zvikuru,","poem":1},{"text":"achiyerera misodzi,","poem":2},{"lineBreak":true},{"text":"nokuti boka ramakwai aJehovha richaendeswa kuutapwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uti kuna mambo nokuna mai vamambo,","poem":1},{"text":"“Burukai pazvigaro zvenyu zvoushe,","poem":2},{"text":"nokuti korona dzenyu dzokukudzwa","poem":1},{"text":"dzichawira pasi kubva pamisoro yenyu.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Maguta okuNegevhi achazarirwa,","poem":1},{"text":"uye hakuna munhu achaazarura.","poem":2},{"text":"VaJudha vose vachaendeswa kuutapwa,","poem":1},{"text":"vachaendeswa kure zvachose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Simudza meso ako uone","poem":1},{"text":"avo vanobva nechokumusoro.","poem":2},{"text":"Ko, boka ramakwai rawakapiwa kuti urichengete riripi,","poem":1},{"text":"iwo makwai awaizvirumbidza nawo?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Uchati kudiniko kana Jehovha achiisa pamusoro pako","poem":1},{"text":"avo vawakadzidzisa seshamwari dzako dzakasarudzika?","poem":2},{"text":"Haungarwadziwi zvikuru here,","poem":1},{"text":"somukadzi osununguka mwana?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Zvino kana ukazvibvunza pachako, uchiti:","poem":1},{"text":"“Sei izvi zvaitika kwandiri?”","poem":2},{"text":"zvaitika nokuda kwezvivi zvako zvizhinji,","poem":1},{"text":"kuti nguo dzako dzabvarurwa,","poem":2},{"lineBreak":true},{"text":"uye muviri wako ukasabatwa zvakanaka.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ko, muEtiopia angashandura ganda rake here,","poem":1},{"text":"kana ingwe mavara ayo?","poem":2},{"text":"Saizvozvowo imi hamungagoni kuita zvakanaka,","poem":1},{"text":"imi makarovedzera kuita zvakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Ndichakuparadzirai sehundi inopepereswa","poem":1},{"text":"nemhepo yomugwenga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Uyu ndiwo mugove wako,","poem":1},{"text":"ndicho chikamu chandakakutemera,”","poem":2},{"text":"ndizvo zvinotaura Jehovha,","poem":4},{"text":"“nokuti wakandikanganwa","poem":1},{"text":"ukavimba navamwari venhema.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndichafukura nguo dzako pamberi pako,","poem":1},{"text":"kuti kunyadziswa kwako kuonekwe,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"upombwe hwako nokufemhedza kworuchiva rwako,","poem":1},{"text":"iko kufeva kwako kusina nyadzi!","poem":2},{"text":"Ndakaona mabasa ako anonyangadza","poem":1},{"text":"awaiita pamusoro pezvikomo nomumunda.","poem":2},{"text":"Une nhamo, iwe Jerusarema!","poem":1},{"text":"Ucharamba usina kuchena kusvikira rinhiko?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/12.json","previousChapterAudioLinks":{},"numberOfVerses":27}