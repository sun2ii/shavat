{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"heading","content":["Kusanaya kweMvura, Nzara, Munondo"]},{"type":"verse","number":1,"content":["Iri ndiro shoko raJehovha kuna Jeremia pamusoro pokusanaya kwemvura:"]},{"type":"verse","number":2,"content":[{"text":"“Judha anochema,","poem":1},{"text":"maguta ake apera simba;","poem":2},{"text":"vanoungudza nokuda kwenyika,","poem":1},{"text":"uye kuchema kwokwira kuchibva kuJerusarema.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vanokudzwa vanotuma varanda vavo kundochera mvura;","poem":1},{"text":"vanoenda kumatsime,","poem":2},{"lineBreak":true},{"text":"asi vanoshayiwa mvura.","poem":2},{"text":"Vanodzoka nezvirongo zvavo zvisina mvura;","poem":1},{"text":"vaora mwoyo uye vasisina tariro,","poem":2},{"lineBreak":true},{"text":"vanofukidza misoro yavo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nyika yaparuka","poem":1},{"text":"nokuti munyika hamuchina mvura;","poem":2},{"text":"varimi vaora mwoyo","poem":1},{"text":"uye vanofukidza misoro yavo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kunyange nehadzi yenondo iri musango","poem":1},{"text":"inosiya mhuru yayo ichangoberekwa","poem":2},{"lineBreak":true},{"text":"nokuti hakuchina bundo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mbizi dzinomira pazvikomo zvisina miti,","poem":1},{"text":"uye dzinofemedzeka semakava;","poem":2},{"text":"meso adzo haachaona zvakanaka","poem":1},{"text":"nokuda kwokushaya mafuro.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kunyange zvivi zvedu zvichipupura zvakaipa,","poem":1},{"text":"imi Jehovha, onai zvamungaita nokuda kwezita renyu.","poem":2},{"text":"Nokuti kudzokera kwedu shure kukuru;","poem":1},{"text":"takakutadzirai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Imi Tariro yaIsraeri,","poem":1},{"text":"Muponesi wavo panguva yokutambudzika,","poem":2},{"text":"maitireiko somutorwa munyika,","poem":1},{"text":"somufambi anongovata usiku humwe chete?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maitireiko somunhu ashamisika","poem":1},{"text":"somurwi ashaya simba rokuponesa?","poem":2},{"text":"Muri pakati pedu, imi Jehovha,","poem":1},{"text":"uye takatumidzwa zita renyu;","poem":2},{"lineBreak":true},{"text":"regai kutisiya!","poem":2}]},{"type":"verse","number":10,"content":["Zvanzi naJehovha pamusoro pavanhu ava,",{"text":"“Vanofarira kungofamba-famba;","poem":1},{"text":"havadzori tsoka dzavo.","poem":2},{"text":"Saka Jehovha haavagamuchiri;","poem":1},{"text":"zvino acharangarira zvakaipa zvavo","poem":2},{"lineBreak":true},{"text":"uye achavaranga nokuda kwezvivi zvavo.”","poem":2}]},{"type":"verse","number":11,"content":["Ipapo Jehovha akati kwandiri, “Rega kunyengeterera kugara zvakanaka kwavanhu ava."]},{"type":"verse","number":12,"content":["Kunyange vakatsanya, handinganzwi kuchema kwavo; kunyange vakapa zvipiriso zvinopiswa nezvipiriso zvezviyo, handingazvigamuchiri. Asi ndichavaparadza nomunondo, nenzara uye nedenda.”"]},{"type":"verse","number":13,"content":["Asi ndakati, “Haiwa Ishe Jehovha, vaprofita vanogara vachivataurira kuti, ‘Hamungaoni munondo kana kufa nenzara. Zvirokwazvo ndichakupai rugare rusingaperi panzvimbo ino.’ ”"]},{"type":"verse","number":14,"content":["Ipapo Jehovha akati kwandiri, “Vaprofita vanoprofita nhema muzita rangu. Ini handina kuvatuma kana kuvagadza kana kutaura kwavari. Vanokuprofitirai zviratidzo zvenhema, nezvakavukwa, nezvifananidzo nokurasika kwendangariro dzavo."]},{"type":"verse","number":15,"content":["Naizvozvo zvanzi naJehovha pamusoro pavaprofita vanoprofita muzita rangu: Handina kuvatuma, asi ivo vanoti, ‘Hakungavi nomunondo kana nzara ichawira nyika ino.’ Vaprofita vacho ivavo, vachaparara nomunondo nenzara."]},{"type":"verse","number":16,"content":["Uye vanhu vavaiprofitira vacharasirwa munzira dzeJerusarema nokuda kwenzara nomunondo. Hakuna munhu achavaviga ivo, kana vakadzi vavo, kana vanakomana vavo, kana vanasikana vavo. Ndichadururira pamusoro pavo njodzi yakafanira."]},{"type":"verse","number":17,"content":["“Taura shoko iri kwavari, uti,",{"text":"“ ‘Meso angu ngaayerere misodzi","poem":1},{"text":"usiku namasikati asingaregi;","poem":2},{"text":"nokuti mhandara mwanasikana wangu, vanhu vangu,","poem":1},{"text":"vakuvadzwa vanga rakaipa, iko kurohwa kukuru.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kana ndikaenda mukati menyika,","poem":1},{"text":"ndinoona vaya vakaurayiwa nomunondo;","poem":2},{"text":"kana ndikaenda muguta,","poem":1},{"text":"ndinoona vakaparadzwa nenzara.","poem":2},{"text":"Vose, muprofita nomuprista","poem":1},{"text":"vakaenda kunyika yavasingazivi.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ko, maramba Judha zvachose here?","poem":1},{"text":"Munozvidza Zioni here?","poem":2},{"text":"Sei makatirwadzisa","poem":1},{"text":"zvokuti tirege kuporeswa?","poem":2},{"text":"Takatarisira rugare","poem":1},{"text":"asi hakuna chakanaka chakauya,","poem":2},{"text":"takatarisira nguva yokuporeswa","poem":1},{"text":"asi panongova nokuvhundutswa bedzi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Haiwa Jehovha, tinobvuma zvakaipa zvedu,","poem":1},{"text":"uye nemhosva yamadzibaba edu;","poem":2},{"lineBreak":true},{"text":"zvirokwazvo takakutadzirai.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nokuda kwezita renyu, musatizvidza;","poem":1},{"text":"regai kushora chigaro chenyu chinobwinya.","poem":2},{"text":"Rangarirai henyu sungano yenyu nesu","poem":1},{"text":"mugorega kuiputsa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ko, pazvifananidzo zvisina maturo zvendudzi, chiripo chinganayisa mvura here?","poem":1},{"text":"Ko, matenga, anonayisa mvura oga here?","poem":2},{"text":"Kwete, ndimi, iyemi Jehovha Mwari wedu.","poem":1},{"text":"Naizvozvo tariro yedu iri mamuri,","poem":2},{"lineBreak":true},{"text":"nokuti ndimi moga munoita izvi zvose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}