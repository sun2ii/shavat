{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Ipapo Jehovha akati kwandiri, “Kunyange dai Mozisi naSamueri vaimira pamberi pangu, mwoyo wangu hawaiva nehanya navanhu ava. Vadzingei pamberi pangu! Regai vaende!"]},{"type":"verse","number":2,"content":["Zvino kana vakakubvunza vachiti, ‘Tichaendepiko?’ Uvaudze kuti, ‘Zvanzi naJehovha:",{"text":"“ ‘Vakafanirwa norufu ngavaende kurufu,","poem":1},{"lineBreak":true},{"text":"vakafanirwa nomunondo, kumunondo;","poem":1},{"lineBreak":true},{"text":"vakafanirwa nenzara, kunzara;","poem":1},{"lineBreak":true},{"text":"vakafanirwa noutapwa, kuutapwa.’","poem":1}]},{"type":"verse","number":3,"content":["“Ndichatumira mhando ina dzavaparadzi pamusoro pavo,” ndizvo zvinotaura Jehovha, “munondo kuti uuraye uye imbwa kuti dzikwekweredzere kure, neshiri dzedenga nemhuka dzenyika kuti dzidye uye dziparadze."]},{"type":"verse","number":4,"content":["Ndichaita kuti vavengwe noushe hwose hwenyika nokuda kwezvakaitwa muJerusarema naManase, mwanakomana waHezekia mambo weJudha."]},{"type":"verse","number":5,"content":[{"text":"“Ndianiko achakunzwira tsitsi, iwe Jerusarema?","poem":1},{"text":"Ndianiko achakuchemera?","poem":2},{"lineBreak":true},{"text":"Ndianiko achamira achikubvunza mufaro?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wakandiramba,” ndizvo zvinotaura Jehovha.","poem":1},{"text":"“Unoramba uchidzokera shure.","poem":2},{"text":"Saka ndichakubata noruoko rwangu ndigokuparadza;","poem":1},{"text":"handichagoni kuramba ndichikunzwira tsitsi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndichavarudza neforogo yokurudzisa,","poem":1},{"text":"pamasuo eguta renyika.","poem":2},{"text":"Ndichauyisa kufirwa nokuparadzwa pamusoro pavanhu vangu,","poem":1},{"text":"nokuti havana kushandura nzira dzavo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndichawanza chirikadzi dzavo","poem":1},{"text":"kupfuura jecha regungwa.","poem":2},{"text":"Panguva yamasikati ndichauyisa muparadzi,","poem":1},{"text":"pamusoro pavanamai vamajaya avo;","poem":2},{"text":"pakarepo, ndichaburutsa pamusoro pavo","poem":1},{"text":"kurwadziwa nokutya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mai vakabereka vana vanomwe vachaziya vagofa.","poem":1},{"lineBreak":true},{"text":"Zuva rake richavira achiri masikati;","poem":1},{"text":"achanyadziswa uye achaninipiswa.","poem":2},{"lineBreak":true},{"text":"Vachapunyuka ndichavaisa kumunondo","poem":2},{"lineBreak":true},{"text":"pamberi pavavengi vavo,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yowe-e, mai vangu, zvamakandibereka","poem":1},{"text":"kuti ndive murume anorwiswa uye anomisidzanwa naye nenyika yose!","poem":2},{"text":"Handina kumbopa munhu chikwereti, kana kutora chikwereti,","poem":1},{"text":"asi zvakadaro vanhu vose vanondituka.","poem":2}]},{"type":"verse","number":11,"content":["Jehovha akati,",{"text":"“Zvirokwazvo ndichakurwira nokuda kwechikonzero chakanaka;","poem":1},{"text":"zvirokwazvo ndichaita kuti vavengi vako vakunyengetedze","poem":2},{"lineBreak":true},{"text":"panguva yenjodzi nepanguva yokutambudzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ko, munhu angavhuna simbi here,","poem":1},{"text":"simbi inobva nechokumusoro, kana ndarira?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pfuma yako namatura ako","poem":1},{"text":"ndichazvipa sezvakapambwa, pasina muripo,","poem":2},{"text":"nokuda kwezvivi zvako zvose munyika yako yose.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ndichakuita muranda wavavengi vako","poem":1},{"text":"kunyika yausingazivi,","poem":2},{"lineBreak":true},{"text":"nokuti kutsamwa kwangu kuchabatidza moto","poem":2},{"lineBreak":true},{"text":"uchapfuta kuti ukupise.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Haiwa Jehovha, imi munonzwisisa;","poem":1},{"text":"ndirangarirei mugondichengeta.","poem":2},{"lineBreak":true},{"text":"Munditsivire kuvatambudzi vangu.","poem":2},{"text":"Imi mune mwoyo murefu, musandibvisa;","poem":1},{"text":"fungai kuti ndakanyadziswa sei nokuda kwenyu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mashoko enyu paakasvika ndakaadya;","poem":1},{"text":"akanga ari mufaro wangu nokufadzwa kwomwoyo wangu,","poem":2},{"text":"nokuti ndakatumidzwa zita renyu,","poem":1},{"text":"imi Jehovha Mwari Wamasimba Ose.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Handina kumbogara pakati peungano yavanozvifadza,","poem":1},{"text":"handina kumbofara navo;","poem":2},{"text":"ndakagara ndoga nokuti ruoko rwenyu rwaiva pamusoro pangu,","poem":1},{"text":"uye makanga mandizadza nokutsamwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Seiko kurwadziwa kwangu kusingaperi,","poem":1},{"text":"uye ronda rangu richirwadza uye risingarapiki?","poem":2},{"text":"Muchava kwandiri sorukova runonyengera,","poem":1},{"text":"sechitubu chinopwa?","poem":2}]},{"type":"verse","number":19,"content":["Naizvozvo zvanzi naJehovha:",{"text":"“Kana ukatendeuka, ndichakudzosazve","poem":1},{"text":"kuti ugondishumira;","poem":2},{"text":"kana ukataura zvakafanira, kwete mashoko asakafanira,","poem":1},{"text":"uchava munhu anotaura akandimirira.","poem":2},{"text":"Vanhu ava ngavadzokere kwauri,","poem":1},{"text":"asi iwe usaenda kwavari.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndichakuita rusvingo kuvanhu ava,","poem":1},{"text":"nhare yorusvingo rwendarira;","poem":2},{"text":"vacharwa newe,","poem":1},{"text":"asi havangakukundi,","poem":2},{"text":"nokuti ini ndinewe,","poem":1},{"text":"kuti ndikurwire ndigokuponesa,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":21,"content":[{"text":"“Ndichakuponesa kubva mumaoko avakaipa","poem":1},{"text":"uye ndichakudzikinura pamaoko avano utsinye.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}