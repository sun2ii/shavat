{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"“Chivi chaJudha chakanyorwa nechinyoreso chesimbi,","poem":1},{"text":"chakanyorwa nomuromo webwe rakapinza kwazvo,","poem":2},{"text":"pahwendefa dzemwoyo yavo","poem":1},{"text":"nepanyanga dzearitari dzavo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kunyange vana vavo vanorangarira","poem":1},{"text":"aritari dzavo namatanda aAshera","poem":2},{"text":"munyasi memiti yakapfumvutira","poem":1},{"text":"uye napazvikomo zvakakwirira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gomo rangu riri munyika","poem":1},{"text":"uye pfuma yako namatura ako ose","poem":2},{"text":"ndichazviendesa kuutapwa,","poem":1},{"text":"pamwe chete nenzvimbo dzako dzakakwirira,","poem":2},{"lineBreak":true},{"text":"nokuda kwechivi chiri munyika yako yose.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nokuda kwokutadza kwako, ucharasikirwa","poem":1},{"text":"nenhaka yandakakupa.","poem":2},{"text":"Ndichakuita muranda wavavengi vako","poem":1},{"text":"munyika yausingazivi,","poem":2},{"text":"nokuti wakabatidza kutsamwa kwangu,","poem":1},{"text":"uye kuchapfuta nokusingaperi.”","poem":2}]},{"type":"verse","number":5,"content":["Zvanzi naJehovha:",{"text":"“Ngaatukwe munhu uyo anovimba nomumwe munhu,","poem":1},{"text":"anovimba nesimba renyama","poem":2},{"lineBreak":true},{"text":"ano mwoyo unofuratira Jehovha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Achafanana negwenzi murenje;","poem":1},{"text":"haangaoni kubudirira pakunosvika.","poem":2},{"text":"Achagara munzvimbo dzakaoma dzemugwenga,","poem":1},{"text":"munyika yomunyu isingagarwi nomunhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Asi akakomborerwa munhu anovimba naJehovha,","poem":1},{"text":"akaisa chivimbo chake maari.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Achafanana nomuti wakasimwa pamvura,","poem":1},{"text":"unotuma midzi yawo kurukova.","poem":2},{"text":"Hautyi kana kupisa kuchisvika;","poem":1},{"text":"mashizha awo anogara ari manyoro.","poem":2},{"text":"Haufunganyi mugore rokusanaya kwemvura,","poem":1},{"text":"uye haumboshayiwi zvibereko.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mwoyo unonyengera kupfuura zvinhu zvose,","poem":1},{"text":"uye wakaora chose.","poem":2},{"lineBreak":true},{"text":"Ndiani angauziva?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ini Jehovha ndinonzvera mwoyo","poem":1},{"text":"uye ndinoedza ndangariro,","poem":2},{"text":"kuti ndipe munhu zvakaringana namafambiro ake,","poem":1},{"text":"uye zvakafanira mabasa ake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sechikwari chinochochonya mazai achisina kukandira,","poem":1},{"text":"ndizvo zvakaita munhu anowana pfuma nokusarurama.","poem":2},{"text":"Pakati pamazuva ake, zvichamusiya,","poem":1},{"text":"uye pakupedzisira achazviona kuti ibenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Chigaro choushe chinobwinya, chakanga chakasimudzirwa kubva pakutanga,","poem":1},{"text":"ndicho nzvimbo yedu tsvene.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Imi Jehovha, tariro yaIsraeri,","poem":1},{"text":"vose vanokusiyai vachanyadziswa.","poem":2},{"text":"Vose vanotsauka kwamuri vachanyorwa muvhu,","poem":1},{"text":"nokuti vakasiya Jehovha,","poem":2},{"lineBreak":true},{"text":"chitubu chemvura mhenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Haiwa Jehovha, ndiporesei, ipapo ndichaporeswa;","poem":1},{"text":"ndiponesei, ipapo ndichaponeswa,","poem":2},{"lineBreak":true},{"text":"nokuti imi ndimi wandinorumbidza.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vanogara vachiti kwandiri,","poem":1},{"text":"“Shoko raJehovha riripiko?","poem":2},{"lineBreak":true},{"text":"Ngarizadziswe iye zvino!”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Handina kutiza pakuva mufudzi wenyu;","poem":1},{"text":"munoziva kuti handina kushora zuva rokupera kwetariro.","poem":2},{"lineBreak":true},{"text":"Zvinobuda mumuromo mangu zviri pachena pamberi penyu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Musava chinhu chinotyisa kwandiri;","poem":1},{"text":"ndimi utiziro hwangu pazuva renjodzi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vatambudzi vangu ngavanyadziswe,","poem":1},{"text":"asi ini ndidzivirirei pakunyadziswa;","poem":2},{"text":"ngavavhunduswe ivo,","poem":1},{"text":"asi ini ndidzivirirei kuti ndisavhunduswa.","poem":2},{"text":"Uyisai pamusoro pavo zuva renjodzi;","poem":1},{"text":"vaparadzei nokuparadza kwakapetwa kaviri.","poem":2}]},{"type":"heading","content":["Kuchengeta Sabata rive Dzvene"]},{"type":"verse","number":19,"content":["Izvi ndizvo zvakataurwa naJehovha kwandiri: “Enda undomira pasuo ravanhu, panopinda nokubuda namadzimambo eJudha; ugondomirazve pane mamwe masuo ose eJerusarema."]},{"type":"verse","number":20,"content":["Uti kwavari, ‘Inzwai shoko raJehovha, imi madzimambo eJudha navanhu vose veJudha navose vanogara muJerusarema vanopinda napamasuo aya."]},{"type":"verse","number":21,"content":["Zvanzi naJehovha: Zvichenjererei kuti murege kutakura mutoro nomusi weSabata kana kuupinza napasuo reJerusarema."]},{"type":"verse","number":22,"content":["Musabudisa mitoro mudzimba dzenyu kana kuita basa ripi neripi pazuva reSabata, asi chengetai zuva reSabata rive dzvene, sezvandakarayira madzitateguru enyu."]},{"type":"verse","number":23,"content":["Asi havana kunzwa kana kurereka nzeve dzavo; vakava nemitsipa mikukutu uye havana kumboteerera kana kugamuchira kurayirwa."]},{"type":"verse","number":24,"content":["Asi kana mukachenjerera kuti munditeerere, ndizvo zvinotaura Jehovha, mukasauya nemitoro napamasuo eguta iri nomusi weSabata, asi muchichengeta zuva reSabata kuti rive dzvene nokusaita basa ripi neripi pazuva iroro,"]},{"type":"verse","number":25,"content":["ipapo madzimambo anogara pachigaro choushe chaDhavhidhi vachauya napamasuo eguta namachinda avo. Ivo namachinda avo vachauya vakakwira ngoro namabhiza, vachiperekedzwa navarume veJudha navose vanogara muJerusarema, uye guta rino richagarwa nokusingaperi."]},{"type":"verse","number":26,"content":["Vanhu vachauya kumaguta eJudha uye nokumisha yakapoteredza Jerusarema, kubva kunyika yeBhenjamini nokujinga rezvikomo zvokumavirira, nokunyika yemakomo uye nokuNegevhi, vachiuyisa zvipiriso zvinopiswa nezvibayiro, uye zvipiriso zvezviyo, nezvinonhuhwira nezvipo zvokuvonga kuimba yaJehovha."]},{"type":"verse","number":27,"content":["Asi kana mukarega kunditeerera kuti muchengete zuva reSabata kuti rive dzvene, musingaregi kutakura mutoro pamunopinda pamasuo eJerusarema nezuva reSabata, ipapo ndichabatidza moto usingadzimwe mumasuo eJerusarema uchapedza nharo dzaro.’ ”"]}],"footnotes":[]},