{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Israeri inosiya Mwari"]},{"type":"verse","number":1,"content":["Shoko raJehovha rakauya kwandiri richiti,"]},{"type":"verse","number":2,"content":["“Enda unoparidza munzeve dzeJerusarema uchiti:",{"text":"“ ‘Ndinorangarira kunamata kwouduku hwako,","poem":1},{"text":"kuti somwenga waindida sei","poem":2},{"text":"uye uchinditevera nomukati merenje,","poem":1},{"text":"uye nomunyika isina munhu anogaramo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Israeri akanga ari mutsvene kuna Jehovha,","poem":1},{"text":"ari chibereko chokutanga chokukohwa kwake;","poem":2},{"text":"vose vakanga vachimudya vaipiwa mhosva,","poem":1},{"text":"uye njodzi yakavawira,’ ”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inzwai shoko raJehovha imi imba yaJakobho,","poem":1},{"text":"nemi mose vorudzi rweimba yaIsraeri.","poem":2}]},{"type":"verse","number":5,"content":["Zvanzi naJehovha:",{"text":"“Madzibaba enyu akawana mhosva yei kwandiri,","poem":1},{"text":"zvavakaenda kure neni?","poem":2},{"text":"Vakatevera zvifananidzo zvisina maturo","poem":1},{"text":"ivo vakava vasina maturo pachavo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Havana kubvunza kuti, ‘Jehovha aripiko,","poem":1},{"text":"iye akatibudisa kubva munyika yeIjipiti akatitungamirira nomugwenga risina miti,","poem":2},{"text":"nomunyika yamarenje namakoronga,","poem":1},{"text":"iyo nyika yakaoma uye yerima,","poem":2},{"text":"nyika isina munhu anofambamo","poem":1},{"text":"uye isina munhu anogaramo?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndakakupinzai munyika yakaorera","poem":1},{"text":"kuti mudye zvibereko zvayo nezvakanaka zvayo.","poem":2},{"text":"Asi makasvika mukasvibisa nyika yangu,","poem":1},{"text":"mukaita nhaka yangu kuti ive chinhu chinonyangadza.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vaprista havana kubvunza kuti,","poem":1},{"text":"‘Jehovha aripiko?’","poem":2},{"text":"Vakanga vachifambisa murayiro havana kundiziva;","poem":1},{"text":"vatungamiri vakandimukira.","poem":2},{"text":"Vaprofita vakaprofita naBhaari,","poem":1},{"text":"vachitevera zvifananidzo zvisina maturo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Naizvozvo ndinokupai mhosva zvakare,”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"“Ndichapazve mhosva vana vavana venyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yambukirai kumiganhu yeKitimi muone,","poem":1},{"text":"tumai vanhu kuKedhari mugonyatsocherechedza;","poem":2},{"lineBreak":true},{"text":"muone kana pakambova nechimwe chinhu chakadai:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ko, rudzi rwakambotsinhanisa vamwari varwo here?","poem":1},{"text":"Uye havasi vamwari zvachose.","poem":2},{"text":"Asi vanhu vangu vakatsinhanisa kukudzwa kwavo","poem":1},{"text":"nezvifananidzo zvisina maturo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Haiwa, imi matenga, shamiswai nechinhu ichi,","poem":1},{"text":"uye mudedere nokutya kukuru,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"“Vanhu vangu vakaita zvakaipa zviviri:","poem":1},{"lineBreak":true},{"text":"Vakandisiya ini,","poem":1},{"text":"tsime remvura mhenyu,","poem":2},{"text":"vakazvicherera zvirongo","poem":1},{"text":"zvisingachengeti mvura.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ko, Israeri muranda here, kana nhapwa pakuberekwa?","poem":1},{"text":"Nemhaka yeiko apambwa zvino?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shumba dzakaomba;","poem":1},{"text":"dzikanguruma kwaari.","poem":2},{"text":"Dzakaparadza nyika yake;","poem":1},{"text":"maguta ake akapiswa uye haachina vanhu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uyezve, vanhu veNofi neveTapanesi","poem":1},{"text":"vakaveura musoro wako.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ko, hauna kuzvivigira izvozvo pachako here","poem":1},{"text":"pawakasiya Jehovha Mwari","poem":2},{"lineBreak":true},{"text":"wako paakanga achikutungamirira munzira?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zvino, unoendereiko kuIjipiti","poem":1},{"text":"kundonwa mvura inobva muShihori?","poem":2},{"text":"Uye unodireiko kuenda kuAsiria","poem":1},{"text":"kundonwa mvura inobva murwizi?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zvakaipa zvako zvichakuranga;","poem":1},{"text":"kudzokera shure kwako kuchakutuka.","poem":2},{"text":"Rangarira uye uyeuke zvino kuti zvakaipa sei","poem":1},{"text":"uye zvinovava sei kwauri,","poem":2},{"lineBreak":true},{"text":"ukange wasiya Jehovha Mwari wako,","poem":2},{"lineBreak":true},{"text":"uye usingandityi,”","poem":2},{"text":"ndizvo zvinotaura Ishe, Jehovha Wamasimba Ose.","poem":4}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Wakavhuna joko rako kare kare","poem":1},{"text":"uye wakadambura makashu ako;","poem":2},{"lineBreak":true},{"text":"ukati, ‘Handidi kukushumirai!’","poem":2},{"text":"Zvirokwazvo, pamusoro pechikomo chirefu choga choga,","poem":1},{"text":"uye pasi pomuti woga woga wakapfumvutira,","poem":2},{"lineBreak":true},{"text":"wakarara pasi pawo sechifeve.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndakanga ndakusima somuzambiringa wakanakisa,","poem":1},{"text":"uri mbeu kwayo inovimbika.","poem":2},{"text":"Ko, zvino wakazondishandukira","poem":1},{"text":"sei ukava muzambiringa webundo wakaora?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kunyange ukazvishambidza nesoda","poem":1},{"text":"uchishandisa sipo yakawanda,","poem":2},{"lineBreak":true},{"text":"gwapa remhosva yako rinoramba riri mberi kwangu,”","poem":2},{"text":"ndizvo zvinotaura Ishe Jehovha.","poem":4}]},{"type":"verse","number":23,"content":[{"text":"“Unoreva sei, uchiti, ‘Handina kusvibiswa;","poem":1},{"text":"handina kutevera Bhaari’?","poem":2},{"text":"Tarisa zvawakaita mumupata;","poem":1},{"text":"funga zvawakaita.","poem":2},{"text":"Iwe uri ngamera yehadzi","poem":1},{"text":"inomhanya apa nepapo,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"uri mbizi yakarovedzwa mugwenga,","poem":1},{"text":"inofembedza mhepo mukushuva kwayo;","poem":2},{"lineBreak":true},{"text":"ndiani angaidzora pakupfumvura kwayo?","poem":2},{"text":"Mukono upi noupi unoitevera haufaniri kuzvinetesa;","poem":1},{"text":"panguva yokusangana uchaiwana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Usamhanya kusvikira tsoka dzako","poem":1},{"text":"dzisisina shangu nehuro yako yava nenyota.","poem":2},{"text":"Asi iwe wakati, ‘Hazvibatsiri!","poem":1},{"text":"Ndinoda vamwari vokumwe,","poem":2},{"lineBreak":true},{"text":"uye ndinofanira kuvatevera.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Sokunyadziswa kwembavha yabatwa,","poem":1},{"text":"saizvozvo imba yaIsraeri yanyadziswa,","poem":2},{"text":"ivo namadzimambo avo uye namachinda avo,","poem":1},{"text":"vaprista vavo navaprofita vavo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Vanoti kudanda, ‘Ndiwe baba vangu,’","poem":1},{"text":"uye kuibwe, ‘Ndiwe wakandibereka.’","poem":2},{"text":"Vakandifuratira ini","poem":1},{"text":"asi zviso zvavo hazvina,","poem":2},{"text":"nyamba pavanenge vava munhamo, vanoti kwandiri,","poem":1},{"text":"‘Uyai mutiponese!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ko, zvino vamwari vamakazviitira varipi?","poem":1},{"text":"Ngavauye kana vachigona kukuponesai","poem":2},{"lineBreak":true},{"text":"pamunenge mava munhamo!","poem":2},{"text":"Nokuti muna vamwari vakawanda","poem":1},{"text":"kupfuura maguta amunawo, imi Judha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Seiko muchindipa mhosva?","poem":1},{"text":"Imi mose makandimukira,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":30,"content":[{"text":"“Ndakaranga vana venyu pasina;","poem":1},{"text":"havana kuteerera kurangwa.","poem":2},{"text":"Munondo wenyu wakamedza vaprofita,","poem":1},{"text":"kufanana neshumba inoparadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Haiwa, imi vechizvarwa ichi, rangarirai Shoko raJehovha rinoti:","poem":1},{"lineBreak":true},{"text":"“Ndanga ndiri renje kuna Israeri","poem":1},{"text":"here kana nyika yerima guru?","poem":2},{"text":"Ko, vanhu vangu vanotaurireiko vachiti,","poem":1},{"text":"‘Takasununguka kuenda kwatada; hatichazouyizve kwamuri?’","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ko, murandakadzi angakanganwa zvishongo zvake here,","poem":1},{"text":"nomwenga angakanganwa nguo dzake dzomuchato here?","poem":2},{"text":"Asi vanhu vangu vakandikanganwa ini,","poem":1},{"text":"mazuva asingaverengeki.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mune ruzivo rwakadii pakutevera rudo!","poem":1},{"text":"Kunyange vakadzi vakaipisisa vangadzidza kubva panzira dzenyu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Panguo dzako vanhu vanowanapo","poem":1},{"text":"ropa ravarombo vasina mhaka,","poem":2},{"lineBreak":true},{"text":"kunyange usina kuvabata vachipaza.","poem":2},{"text":"Asi kunyange zvakadaro","poem":1}]},{"type":"verse","number":35,"content":[{"text":"unoti, ‘Handina mhosva;","poem":2},{"lineBreak":true},{"text":"uye haana kunditsamwira.’","poem":2},{"text":"Asi ndichatema mutongo wangu","poem":1},{"text":"pauri nokuti unoti, ‘Handina kutadza.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ko, unofambireiko pose pose zvakadai,","poem":1},{"text":"uchishandura nzira dzako?","poem":2},{"text":"Iwe uchagumburwa neIjipiti,","poem":1},{"text":"sezvawakaitwa neAsiria.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Uchabvawo panzvimbo iyoyo","poem":1},{"text":"wakaisa maoko ako pamusoro pako,","poem":2},{"text":"nokuti Jehovha akaramba vose vaunovimba navo;","poem":1},{"text":"iwe hauchazobatsirwi navo.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}