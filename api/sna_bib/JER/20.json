{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":20,"content":[{"type":"heading","content":["Jeremia naPashuri"]},{"type":"verse","number":1,"content":["Muprista Pashuri mwanakomana waImeri, mutariri mukuru mutemberi yaJehovha, akati anzwa Jeremia achiprofita zvinhu izvi,"]},{"type":"verse","number":2,"content":["akarayira kuti Jeremia muprofita arohwe agoiswa muchitokisi paSuo Rokumusoro raBhenjamini raiva patemberi yaJehovha."]},{"type":"verse","number":3,"content":["Chifumi chamangwana, Pashuri akati amusunungura kubva muchitokisi, Jeremia akati kwaari, “Zita rinopiwa kwauri naJehovha harisi Pashuri, asi Magori-Misabhibhi (zvichireva zvinotyisa kumativi ose)."]},{"type":"verse","number":4,"content":["Nokuti zvanzi naJehovha: ‘Ndichakuita chinhu chinokutyisa iwe pachako nokushamwari dzako dzose; uchadziona nemeso ako dzichiwisirwa pasi nomunondo wavavengi vavo. Ndichaisa Judha rose mumaoko amambo weBhabhironi, uye achavaendesa kuBhabhironi kana kuvauraya nomunondo."]},{"type":"verse","number":5,"content":["Ndichaisa pfuma yose yeguta rino, nezvose zvavakawana, nezvose zvinokosha zvaro, nepfuma yose yamadzimambo eJudha, mumaoko avavengi vavo. Vachazvipamba ndokuzviendesa kuBhabhironi."]},{"type":"verse","number":6,"content":["Zvino iwe Pashuri, navose vanogara mumba mako muchatapwa mugondogariswa kuBhabhironi. Uchandofira ikoko, iwe neshamwari dzako dzose dzawaiprofitira nhema.’ ”"]},{"type":"heading","content":["Kugununʼuna kwaJeremia"]},{"type":"verse","number":7,"content":[{"text":"Haiwa Jehovha makandinyengera, uye ndakanyengerwa;","poem":1},{"text":"makandikurira uye mukakunda,","poem":2},{"text":"vanondiseka zuva rose;","poem":1},{"text":"munhu wose anondiseka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pandinotaura pose, ndinodanidzira","poem":1},{"text":"ndichitaura nezvokuita nechisimba nokuparadza.","poem":2},{"text":"Saka shoko raJehovha rakandivigira","poem":1},{"text":"kutukwa nokunyadziswa zuva rose.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Asi kana ndikati, “Handicharevi zita rake,","poem":1},{"text":"kana kutaurazve muzita rake,”","poem":2},{"text":"shoko rake riri mumwoyo mangu rakaita somoto,","poem":1},{"text":"moto wakapfigirwa mumapfupa angu.","poem":2},{"text":"Ndaneta nokuridzivisa;","poem":1},{"text":"zvirokwazvo, handigoni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndinonzwa vazhinji vachizevezera vachiti,","poem":1},{"text":"“Zvinotyisa kumativi ose!","poem":2},{"lineBreak":true},{"text":"Mureverei! Ngatimureverei!”","poem":2},{"text":"Shamwari dzangu dzose","poem":1},{"text":"dzakarindira kutedzemuka kwangu, dzichiti,","poem":2},{"text":"“Zvimwe achanyengererwa;","poem":1},{"text":"ipapo tigomukunda","poem":2},{"lineBreak":true},{"text":"tigozvitsiva paari.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asi Jehovha aneni semhare ine simba;","poem":1},{"text":"saka vatambudzi vangu vachagumburwa, uye havangakundi.","poem":2},{"text":"Vachakundikana uye vachanyadziswa kwazvo;","poem":1},{"text":"kusakudzwa kwavo hakungatongokanganwiki.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Haiwa Jehovha Wamasimba Ose, iyemi munoedza vakarurama","poem":1},{"text":"uye munonzvera mwoyo nendangariro,","poem":2},{"text":"regai ndione kutsiva kwenyu pamusoro pavo,","poem":1},{"text":"nokuti ndaisa mhaka yangu kwamuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Imbirai Jehovha!","poem":1},{"text":"Ipai rumbidzo kuna Jehovha!","poem":2},{"text":"Iye anorwira upenyu hwavanoshayiwa","poem":1},{"text":"kubva mumaoko avakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ngaritukwe zuva randakaberekwa!","poem":1},{"text":"Zuva randakaberekwa namai vangu ngarirege kuropafadzwa!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngaatukwe munhu akazivisa baba vangu shoko,","poem":1},{"text":"iye akaita kuti vafare kwazvo, achiti,","poem":2},{"lineBreak":true},{"text":"“Waberekerwa mwana, iye mwanakomana!”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Munhu uyo ngaave semaguta","poem":1},{"text":"akaparadzwa naJehovha asingazvidembi.","poem":2},{"text":"Ngaanzwe kuungudza mangwanani,","poem":1},{"text":"nokudanidzirwa kwehondo masikati.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nokuti haana kundiuraya ndiri mudumbu,","poem":1},{"text":"mai vangu vangadai vari guva rangu,","poem":2},{"lineBreak":true},{"text":"vairamba vane mimba.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndakambobudireiko mudumbu","poem":1},{"text":"kuti ndione nhamo nokuchema","poem":2},{"lineBreak":true},{"text":"uye ndigogumisa mazuva angu mukunyadziswa?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}