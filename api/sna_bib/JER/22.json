{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":22,"content":[{"type":"heading","content":["Kutongwa kwaMadzimambo Akaipa"]},{"type":"verse","number":1,"content":["Zvanzi naJehovha: “Burukira kumuzinda wamambo weJudha undoparidza shoko iri ikoko uchiti,"]},{"type":"verse","number":2,"content":["‘Inzwai shoko raJehovha, imi mambo weJudha, iyemi munogara pachigaro choushe chaDhavhidhi, imi namachinda enyu navanhu venyu vanopinda napamasuo aya."]},{"type":"verse","number":3,"content":["Zvanzi naJehovha: Itai zvakanaka nezvakarurama. Rwirai akabirwa muruoko rwounomumanikidza. Regai kuitira zvakaipa kana chisimba kumutorwa nenherera kana chirikadzi, uye musateura ropa risina mhosva panzvimbo ino."]},{"type":"verse","number":4,"content":["Nokuti kana mukachenjerera kuteerera mirayiro, ipapo madzimambo anogara pachigaro chaDhavhidhi achapinda napamasuo omuzinda uyu, vakakwira mungoro nepamabhiza vachiperekedzwa namachinda avo navanhu vavo."]},{"type":"verse","number":5,"content":["Asi kana mukaramba kunzwa mirayiro iyi, ndizvo zvinotaura Jehovha, ndinopika neni ndimene kuti nzvimbo ino ichava dongo.’ ”"]},{"type":"verse","number":6,"content":["Nokuti zvanzi naJehovha pamusoro pomuzinda wamambo weJudha:",{"text":"“Kunyange wakaita seGireadhi kwandiri,","poem":1},{"text":"wakaita somusoro weRebhanoni,","poem":2},{"text":"zvirokwazvo ndichakuita segwenga,","poem":1},{"text":"semaguta asingagarwi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndichatumira vaparadzi pamusoro penyu,","poem":1},{"text":"mumwe nomumwe nezvombo zvake,","poem":2},{"text":"uye vachatema matanda enyu emisidhari akanaka","poem":1},{"text":"vagoakanda mumoto.","poem":2}]},{"type":"verse","number":8,"content":["“Marudzi mazhinji avanhu achapfuura nepaguta rino uye vachabvunzana vachiti, ‘Jehovha aitireiko chinhu chakadai kuguta rino?’"]},{"type":"verse","number":9,"content":["Zvino mhinduro ichati, ‘Nokuti vakasiya sungano yaJehovha Mwari wavo vakanamata uye vakashumira vamwe vamwari.’ ”"]},{"type":"verse","number":10,"content":[{"text":"Musachema mambo akafa kana kuungudza nezvake;","poem":1},{"text":"asi muchemere kwazvo uyo akatapwa,","poem":2},{"lineBreak":true},{"text":"nokuti haachambodzoki kana kuzoonazve nyika yaakaberekerwa.","poem":2}]},{"type":"verse","number":11,"content":["Nokuti zvanzi naJehovha pamusoro paSharumi mwanakomana waJosia, uyo akatevera Baba vake samambo weJudha asi akabva panzvimbo ino: “Haazombodzoki."]},{"type":"verse","number":12,"content":["Achafira munzvimbo yavakamuendesa kuutapwa; haachazombooni nyika inozve.”"]},{"type":"verse","number":13,"content":[{"text":"“Ane nhamo uyo anovaka muzinda wake nokusarurama,","poem":1},{"text":"namakamuri ake okumusoro nokusaruramisira,","poem":2},{"text":"anoshandisa vanhu vokwake pasina chaanovapa,","poem":1},{"text":"asingavaripiri pakushanda kwavo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iye anoti, ‘Ndichazvivakira muzinda wakakura","poem":1},{"text":"una makamuri okumusoro anoyevedza.’","poem":2},{"text":"Saka anoita mawindo makuru mairi,","poem":1},{"text":"achiabatanidza nomusidhari,","poem":2},{"lineBreak":true},{"text":"agoashongedza nezvitsvuku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Izvozvo zvinokuita mambo here,","poem":1},{"text":"kuva nemisidhari yakawandawanda?","poem":2},{"text":"Ko, baba vako havana kuwana zvokudya nezvokunwa here?","poem":1},{"text":"Iye akaita zvakarurama uye nokururamisira,","poem":2},{"lineBreak":true},{"text":"saka zvose zvakamufambira zvakanaka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akatongera varombo nevaishayiwa mhaka dzavo,","poem":1},{"text":"nokudaro zvose zvakafamba zvakanaka.","poem":2},{"text":"Hazvisizvo zvinoreva kundiziva here?”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Asi meso enyu nemwoyo yenyu","poem":1},{"text":"zvakangotarisa chete papfuma isakarurama,","poem":2},{"text":"pakuteura ropa risina mhosva","poem":1},{"text":"napakumanikidza nokuita nechisimba.”","poem":2}]},{"type":"verse","number":18,"content":["Naizvozvo zvanzi naJehovha, pamusoro paJehoyakimi mwanakomana waJosia, mambo weJudha:",{"text":"“Havangamuchemi vachiti:","poem":1},{"text":"‘Yowe-e, mununʼuna wangu! Yowe-e, hanzvadzi yangu!’","poem":2},{"text":"Havangamuchemi vachiti:","poem":1},{"text":"‘Yowe-e, tenzi wangu! Yowe-e, ukuru hwake!’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Achavigwa sokuvigwa kunoitwa mbongoro,","poem":1},{"text":"achakwekweredzwa agoraswa kure,","poem":2},{"lineBreak":true},{"text":"kunze kwamasuo eJerusarema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Kwirai kuRebhanoni mudanidzire,","poem":1},{"text":"inzwi renyu ngarinzwike paBhashani,","poem":2},{"text":"danidzirai kubva paAbharimi,","poem":1},{"text":"nokuti shamwari dzenyu dzose dzaparadzwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndakakuyambira uchigere zvakanaka,","poem":1},{"text":"asi iwe wakati, ‘Handidi kuteerera!’","poem":2},{"text":"Ndiyo yanga iri nzira yako kubva pauduku hwako;","poem":1},{"text":"hauna kunditeerera.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mhepo ichadzingira kure vafudzi vako vose,","poem":1},{"text":"uye shamwari dzako dzichaenda kuutapwa.","poem":2},{"text":"Ipapo iwe uchanyara uye uchanyadziswa,","poem":1},{"text":"nokuda kwokuipa kwako kwose.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Imi mugere mu‘Rebhanoni,’","poem":1},{"text":"iyemi makavakirwa matendere mudzimba dzemisidhari,","poem":2},{"text":"muchagomera sei kurwadza pakuchauya pamusoro penyu,","poem":1},{"text":"kurwadziwa sekwomukadzi anosununguka!","poem":2}]},{"type":"verse","number":24,"content":["“Zvirokwazvo, noupenyu hwangu,” ndizvo zvinotaura Jehovha, “kunyange kana iwe Jehoyakini mwanakomana waJehoyakimi mambo weJudha, wakanga uri mhete muruoko rwangu rworudyi, ndaingokubvisa zvakadaro."]},{"type":"verse","number":25,"content":["Ndichakuisa mumaoko aavo vanotsvaka kukuuraya, ivo vaunotya, kuna Nebhukadhinezari mambo weBhabhironi nokuvaBhabhironi."]},{"type":"verse","number":26,"content":["Ndichapotsera iwe namai vakakubereka kune imwe nyika kwamusina kuberekerwa, uye ikoko kwamuchandofira muri vaviri."]},{"type":"verse","number":27,"content":["Hamuzombodzokizve kunyika yamunoshuva kudzokera kwairi.”"]},{"type":"verse","number":28,"content":[{"text":"Ko, murume uyu Jehoyakini munhu akazvidzika, ihari yakaputsika,","poem":1},{"text":"chinhu chisina angada here?","poem":2},{"text":"Seiko iye navana vake vapotserwa kunze,","poem":1},{"text":"vakarasirwa kunyika yavasingazivi?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Iwe nyika, nyika, nyika,","poem":1},{"text":"inzwa shoko raJehovha!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Zvanzi naJehovha:","poem":1},{"lineBreak":true},{"text":"“Nyora munhu uyu seasina mwana,","poem":1},{"text":"munhu asingazobudiriri pamazuva oupenyu hwake,","poem":2},{"text":"nokuti hakuna mwana wake achapfuma,","poem":1},{"text":"hakuna achagara pachigaro choushe chaDhavhidhi,","poem":2},{"lineBreak":true},{"text":"kana kutongazve munyika yeJudha.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}