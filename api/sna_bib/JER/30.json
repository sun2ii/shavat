{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Kuvandudzwa kweIsraeri"]},{"type":"verse","number":1,"content":["Iri ndiro shoko rakauya kuna Jeremia richibva kuna Jehovha richiti,"]},{"type":"verse","number":2,"content":["“Zvanzi naJehovha, Mwari waIsraeri, ‘Nyora mubhuku mashoko ose andakakuudza."]},{"type":"verse","number":3,"content":["Mazuva anouya,’ ndizvo zvinotaura Jehovha, ‘andichadzosa vanhu vangu, vaIsraeri navaJudha kubva kuutapwa. Uye ndichavadzosera kunyika yandakapa madzitateguru avo kuti ive yavo,’ ndizvo zvinotaura Jehovha.”"]},{"type":"verse","number":4,"content":["Aya ndiwo mashoko akataurwa naJehovha pamusoro peIsraeri neJudha:"]},{"type":"verse","number":5,"content":["“Zvanzi naJehovha:",{"text":"“ ‘Tinonzwa kuchema kwevanotya,","poem":1},{"text":"kwokutyisidzirwa, kwete kworugare.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bvunzai muone:","poem":1},{"text":"Ko, murume angagona kusununguka mwana here?","poem":2},{"text":"Zvino, seiko ndichiona murume mumwe nomumwe akasimba","poem":1},{"text":"akabata padumbu pake namaoko ake somukadzi orwadziwa,","poem":2},{"lineBreak":true},{"text":"zviso zvose zvachenuruka?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Haiwa, zuva iro richatyisa seiko!","poem":1},{"text":"Hakuna richafanana naro.","poem":2},{"text":"Ichava nguva yaJakobho yokutambudzika,","poem":1},{"text":"asi achaponeswa pairi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Pazuva iro,’ ndizvo zvinotaura Jehovha Wamasimba Ose,","poem":1},{"text":"‘Ndichavhuna joko pamitsipa yavo","poem":2},{"text":"uye ndichadambura zvisungo zvavo;","poem":1},{"text":"havachazoitwizve varanda navatorwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Asi, vachashumira Jehovha Mwari wavo","poem":1},{"text":"naDhavhidhi mambo wavo,","poem":2},{"lineBreak":true},{"text":"iye wandichavamutsira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Saka, usatya, iwe Jakobho muranda wangu;","poem":1},{"text":"usavhunduka, iwe Israeri,’","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"‘Zvirokwazvo ndichakuponesa kubva kunyika iri kure,","poem":1},{"text":"zvizvarwa zvako kubva kunyika youtapwa hwavo.","poem":2},{"text":"Jakobho achavazve norunyararo uye nokuchengetedzeka,","poem":1},{"text":"uye hakuna achazomutyisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndinewe uye ndichakuponesa,’","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":2},{"text":"‘Kunyange zvazvo ndakaparadza chose ndudzi dzose","poem":1},{"text":"dzandakakuparadzira pakati padzo,","poem":2},{"lineBreak":true},{"text":"handingazokuparadze zvachose iwe.","poem":2},{"text":"Ndichakuranga asi nokururamisira chete;","poem":1},{"text":"handingakusiyi usina kurangwa zvachose.’","poem":2}]},{"type":"verse","number":12,"content":["“Zvanzi naJehovha:",{"text":"“ ‘Ronda rako harirapiki,","poem":1},{"text":"kukuvadzwa kwako hakupori.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hakuna anokureverera mhaka yako,","poem":1},{"text":"vanga rako harina mushonga,","poem":2},{"lineBreak":true},{"text":"hapana kuporeswa kwako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vose vaikuda vakakukanganwa;","poem":1},{"text":"havachina hanya newe.","poem":2},{"text":"Ndakakurova sezvinoitwa nomuvengi","poem":1},{"text":"ndikakuranga sezvinoitwa neano utsinye","poem":2},{"text":"nokuti mhosva yako ihuru","poem":1},{"text":"uye zvivi zvako zvakawanda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Unochemeiko pamusoro pevanga rako,","poem":1},{"text":"nokurwadziswa kwako kusingarapike?","poem":2},{"text":"Nokuda kwokukura kwemhaka yako nezvivi zvizhinji","poem":1},{"text":"ndakaita zvinhu izvi kwauri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ ‘Asi vose vanokudya iwe vachadyiwawo;","poem":1},{"text":"vavengi vako vose vachaenda kuutapwa.","poem":2},{"text":"Vanokupamba, vachapambwawo;","poem":1},{"text":"vose vanokuparadza, ndichavaparadzawo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Asi ndichakudzorera pautano","poem":1},{"text":"uye ndichaporesa maronda ako,’","poem":2},{"text":"ndizvo zvinotaura Jehovha,","poem":4},{"text":"‘nokuti iwe wakanzi murashwa,","poem":1},{"text":"Zioni zvaro risina ane hanya naro.’","poem":2}]},{"type":"verse","number":18,"content":["“Zvanzi naJehovha:",{"text":"“ ‘Ndichadzosazve pfuma yamatende aJakobho","poem":1},{"text":"uye ndichanzwira ugaro hwake tsitsi;","poem":2},{"text":"guta richavakwazve pamatongo aro,","poem":1},{"text":"nomuzinda uchamira panzvimbo yawo yakafanira.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nziyo dzokuvonga dzichabva kwavari","poem":1},{"text":"uye nenzwi romufaro.","poem":2},{"text":"Ndichawedzera kuwanda kwavo,","poem":1},{"text":"uye havangatapudzwi;","poem":2},{"text":"ndichavavigira kukudzwa,","poem":1},{"text":"uye havangadukupiswi,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Vana vavo vachava sepamazuva ekare,","poem":1},{"text":"uye ungano yavo ichasimbiswa pamberi pangu;","poem":2},{"lineBreak":true},{"text":"ndicharanga vose vanovamanikidza.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mutungamiri wavo achava mumwe wokwavo;","poem":1},{"text":"anovabata ushe achamutswa pakati pavo.","poem":2},{"text":"Ndichamuswededza pedyo uye iye achaswedera pedyo neni,","poem":1},{"text":"nokuti ndianiko achazvipira","poem":2},{"lineBreak":true},{"text":"kuti ave pedyo neni?’","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"‘Saka muchava vanhu vangu,","poem":1},{"text":"neni ndichava Mwari wenyu.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tarirai, dutu raJehovha","poem":1},{"text":"richaputika mukutsamwa kwake,","poem":2},{"text":"mhepo inovhuvhuta ichimona","poem":1},{"text":"pamisoro yavakaipa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kutsamwa kunotyisa kwaJehovha hakungadzoki,","poem":1},{"text":"kusvikira apedza","poem":2},{"lineBreak":true},{"text":"zvinovavarirwa nomwoyo wake.","poem":2},{"text":"Mumazuva anouya","poem":1},{"text":"muchanzwisisa izvozvi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}