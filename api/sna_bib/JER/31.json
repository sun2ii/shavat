{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["“Panguva iyo,” ndizvo zvinotaura Jehovha, “ndichava Mwari wamarudzi ose aIsraeri, naivo vachava vanhu vangu.”"]},{"type":"verse","number":2,"content":["Zvanzi naJehovha:",{"text":"“Vanhu vakapunyuka pamunondo","poem":1},{"text":"vachawana nyasha mugwenga;","poem":2},{"lineBreak":true},{"text":"ndichauya kuzopa zororo kuna Israeri.”","poem":2}]},{"type":"verse","number":3,"content":["Jehovha akazviratidza kwatiri kare, achiti:",{"text":"“Ndakakudai norudo rusingaperi;","poem":1},{"text":"ndakakukwevai nokunaka kworudo rwangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndichakuvakazve,","poem":1},{"text":"ipapo uchavakwa, iwe Mhandara Israeri.","poem":2},{"text":"Uchatorazve matambureni ako","poem":1},{"text":"ugoenda kundotamba navanofara.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvakare, muchasima minda yemizambiringa","poem":1},{"text":"pamusoro pezvikomo zveSamaria;","poem":2},{"text":"varimi vachaisima,","poem":1},{"text":"vagofadzwa nezvibereko zvayo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pachava nezuva richadanidzira nharirire","poem":1},{"text":"dziri pamusoro pezvikomo zveEfuremu, dzichiti,","poem":2},{"text":"‘Uyai, ngatikwidzei kuZioni,","poem":1},{"text":"kuna Jehovha Mwari wedu.’ ”","poem":2}]},{"type":"verse","number":7,"content":["Zvanzi naJehovha:",{"text":"“Imbirai Jakobho nomufaro;","poem":1},{"text":"pururudzirai mukuru wendudzi.","poem":2},{"text":"Paridzai, rumbidzai, muchiti,","poem":1},{"text":"‘Haiwa Jehovha, ponesai vanhu venyu,","poem":2},{"lineBreak":true},{"text":"ivo vakasara vaIsraeri.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tarirai, ndichavauyisa vachibva kunyika yokumusoro,","poem":1},{"text":"uye ndigovaunganidza kubva kumigumo yenyika.","poem":2},{"text":"Pakati pavo pachava namapofu nezvirema,","poem":1},{"text":"navanamai vane pamuviri navakadzi vanorwadziwa;","poem":2},{"lineBreak":true},{"text":"boka guru richadzoka kuno.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vachauya vachichema;","poem":1},{"text":"vachanyengetera pandinenge ndichivadzosa.","poem":2},{"text":"Ndichavafambisa nepahova dzemvura,","poem":1},{"text":"napanzira yakati chechetere yavasingagumburwi,","poem":2},{"text":"nokuti ndiri baba vaIsraeri,","poem":1},{"text":"uye Efuremu ndiye dangwe rangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Inzwai shoko raJehovha imi ndudzi dzose;","poem":1},{"text":"muriparidze kuzviwi zviri kure muchiti:","poem":2},{"text":"‘Iye akaparadzira Israeri ndiye achavaunganidza,","poem":1},{"text":"uye achavachengeta somufudzi anochengeta boka ramakwai ake.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokuti Jehovha achasunungura Jakobho,","poem":1},{"text":"uye agovadzikinura kubva muruoko rwaivo vane simba kupinda ivo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vachauya vachipembera nomufaro pamusoro peZioni;","poem":1},{"text":"vachafara nokupa zvakanaka kwaJehovha,","poem":2},{"text":"nokuda kwezviyo, newaini itsva uye namafuta,","poem":1},{"text":"makwayana nemombe.","poem":2},{"text":"Vachafanana nebindu rakanyatsodiridzwa,","poem":1},{"text":"uye havachazosuwazve.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ipapo varandakadzi vachatamba uye vachafara,","poem":1},{"text":"majaya navatana vachafarawo.","poem":2},{"text":"Ndichashandura kuchema kwavo kuti kuve mufaro;","poem":1},{"text":"ndichavanyaradza uye ndichavapa mufaro pachinzvimbo chokusuwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndichagutsa vaprista nezvakawanda,","poem":1},{"text":"uye vanhu vangu vachazadzwa nokupa zvakanaka kwangu,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":15,"content":["Zvanzi naJehovha:",{"text":"“Inzwi rinonzwikwa muRama,","poem":1},{"text":"rokuungudza nokuchema kukuru,","poem":2},{"text":"Rakeri achichema vana vake","poem":1},{"text":"uye achiramba kunyaradzwa,","poem":2},{"lineBreak":true},{"text":"nokuti vana vake havachipo.”","poem":2}]},{"type":"verse","number":16,"content":["Zvanzi naJehovha:",{"text":"“Dzora inzwi rako pakuchema","poem":1},{"text":"nameso ako pamisodzi,","poem":2},{"text":"nokuti basa rako richaripirwa,”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"“Vachadzoka vachibva kunyika yomuvengi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Saka ramangwana rako rine tariro,”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"“Vana vako vachadzokera kunyika yavo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Zvirokwazvo ndanzwa kuchema kwaEfuremu achiti:","poem":1},{"text":"‘Makandirova semhuru isina kupingudzwa,","poem":2},{"lineBreak":true},{"text":"nokudaro ndakarangwa.","poem":2},{"text":"Ndidzorei, ipapo ndichadzoka,","poem":1},{"text":"nokuti imi ndimi Jehovha Mwari wangu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mushure mokutsauka kwangu,","poem":1},{"text":"ndakatendeuka;","poem":2},{"text":"ndakati ndanzwisisa","poem":1},{"text":"ndakazvirova chipfuva.","poem":2},{"text":"Ndakanyadziswa uye ndakaninipiswa","poem":1},{"text":"nokuti ndakatakura nyadzi dzouduku hwangu.’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ko, Efuremu haasi mwanakomana wangu anodikanwa,","poem":1},{"text":"mwana anondifadza here?","poem":2},{"text":"Kunyange ndichimupikisa kazhinji,","poem":1},{"text":"ndinoramba ndichimurangarira.","poem":2},{"text":"Naizvozvo, mwoyo wangu unomushuva;","poem":1},{"text":"ndinomunzwira tsitsi kwazvo,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Zvimisirei shongwe dzenzira;","poem":1},{"text":"misai zvikwangwani.","poem":2},{"text":"Cherechedzai mugwagwa mukuru,","poem":1},{"text":"mugwagwa wamunofamba nawo.","poem":2},{"text":"Dzoka, iwe Mhandara Israeri,","poem":1},{"text":"dzokera kumaguta ako.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Uchadzungaira kusvikira rinhiko,","poem":1},{"text":"iwe mwanasikana wokusatendeka?","poem":2},{"text":"Jehovha achasika chinhu chitsva panyika,","poem":1},{"text":"zvokuti mukadzi achambundikira murume.”","poem":2}]},{"type":"verse","number":23,"content":["Zvanzi naJehovha Wamasimba Ose, Mwari weIsraeri: “Pandichavadzosazve kubva kuutapwa, vanhu vari munyika yeJudha nomumaguta ayo vachataurazve mashoko aya okuti, ‘Jehovha ngaakuropafadze, iwe ugaro hwakarurama, iwe gomo dzvene.’"]},{"type":"verse","number":24,"content":["Vanhu vachagara pamwe chete muJudha nomumaguta ayo ose, varimi navaya vanofamba namapoka avo."]},{"type":"verse","number":25,"content":["Ndichasimbisa vanenge vaneta uye ndichagutsa vanenge vaziya.”"]},{"type":"verse","number":26,"content":["Ipapo ndakamuka ndokuringa-ringa. Ndakanga ndarara zvakanaka."]},{"type":"verse","number":27,"content":["“Mazuva anouya,” ndizvo zvinotaura Jehovha, “andichasima muimba yaIsraeri nomuimba yaJudha zvibereko zvavanhu nezvibereko zvemhuka."]},{"type":"verse","number":28,"content":["Sezvandakavarindira kuti ndidzure, ndikoromore, uye ndiwisire pasi, ndiparadze, ndiuyise njodzi, saizvozvo ndichavarindira, kuti ndivake uye ndisime,” ndizvo zvinotaura Jehovha."]},{"type":"verse","number":29,"content":["“Mumazuva iwayo vanhu havangazoti,",{"text":"“ ‘Madzibaba akadya mazambiringa anovava,","poem":1},{"text":"mazino avana akaita hwadzira.’","poem":2}]},{"type":"verse","number":30,"content":["Asi, mumwe nomumwe achafa nokuda kwezvakaipa zvake; ani naani anodya mazambiringa anovava, mazino ake achaita hwadzira."]},{"type":"verse","number":31,"content":[{"text":"“Nguva inouya,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"“yandichaita sungano itsva","poem":2},{"text":"neimba yaIsraeri","poem":1},{"text":"uye neimba yaJudha.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Haingazofanani nesungano","poem":1},{"text":"yandakaita namadzitateguru avo,","poem":2},{"text":"pandakavabata ruoko","poem":1},{"text":"kuti ndivabudise munyika yeIjipiti,","poem":2},{"text":"nokuti vakaputsa sungano yangu,","poem":1},{"text":"kunyange ndakanga ndiri murume kwavari,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":33,"content":[{"text":"“Iyi indiyo sungano yandichaita neimba yaIsraeri","poem":1},{"text":"shure kwamazuva iwayo,” ndizvo zvinotaura Jehovha.","poem":2},{"text":"“Ndichaisa murayiro wangu mundangariro dzavo","poem":1},{"text":"uye ndigounyora mumwoyo yavo.","poem":2},{"lineBreak":true},{"text":"Ndichava Mwari wavo, uye ivo vachava vanhu vangu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Hakuna munhu achadzidzisa muvakidzani wake","poem":1},{"text":"kana hama yake, achiti, ‘Ziva Jehovha,’","poem":2},{"text":"nokuti vose vachandiziva,","poem":1},{"text":"kubva kumuduku wavo kusvikira kumukuru,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"“Nokuti ndichavakanganwira kuipa kwavo,","poem":1},{"text":"uye handingarangaririzve zvivi zvavo.”","poem":2}]},{"type":"verse","number":35,"content":["Zvanzi naJehovha,",{"text":"iye anogadza zuva","poem":1},{"text":"kuti rivhenekere masikati,","poem":2},{"text":"anoisa chirevo kumwedzi nenyeredzi","poem":1},{"text":"kuti zvivhenekere usiku,","poem":2},{"text":"iye anomutsa gungwa kuti mafungu aro atinhire,","poem":1},{"text":"Jehovha Wamasimba Ose, ndiro zita rake:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Kana chete mitemo iyi ikabva pamberi pangu,”","poem":1},{"text":"ndizvo zvinotaura Jehovha,","poem":2},{"text":"“ndiko kuti zvizvarwa zvaIsraeri zvigume","poem":1},{"text":"kuva rudzi pamberi pangu.”","poem":2}]},{"type":"verse","number":37,"content":["Zvanzi naJehovha:",{"text":"“Kana chete matenga ari kumusoro akagona kuyerwa,","poem":1},{"text":"uye nheyo dzenyika dziri pasi dzikagona kunzverwa,","poem":2},{"text":"ipapo ndipo pandingarambe zvizvarwa zvaIsraeri","poem":1},{"text":"nokuda kwezvose zvavakaita,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":38,"content":["“Mazuva anouya,” ndizvo zvinotaura Jehovha, “andichavakirazve guta kubva paShongwe yeHananeri kusvikira paSuo reKona."]},{"type":"verse","number":39,"content":["Rwodzi rwokuyera ruchatandavara kubva ipapo kusvikira kuchikomo cheGarebhi ndokudzoka ruchisvika kuGoa."]},{"type":"verse","number":40,"content":["Mupata wose unorasirwa zvitunha namadota, neminda yose kusvikira kuMupata weKidhironi kumabvazuva kusvikira kukona reSuo raMabhiza, zvichava zvitsvene kuna Jehovha. Guta harichazombodzurwi kana kuparadzwazve.”"]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}