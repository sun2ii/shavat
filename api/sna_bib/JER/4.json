{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"“Haiwa Israeri, kana muchida kudzoka,","poem":1},{"text":"dzokai kwandiri,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"“Kana mukabvisa pamberi pangu zvifananidzo zvenyu","poem":1},{"text":"zvinonyangadza uye mukasarasikazve,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kana mukapika muchokwadi,","poem":1},{"text":"nokururama uye nenzira yakarurama muchiti:","poem":2},{"text":"‘Zvirokwazvo naJehovha mupenyu,’","poem":1},{"text":"ipapo ndudzi dzicharopafadzwa naye uye dzichazvirumbidza maari.”","poem":2}]},{"type":"verse","number":3,"content":["Izvi ndizvo zvinotaura Jehovha kuvanhu veJudha neJerusarema:",{"text":"“Zviundirei gombo","poem":1},{"text":"murege kudyara pakati peminzwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zvidzingisirei kuna Jehovha,","poem":1},{"text":"dzingisai mwoyo yenyu,","poem":2},{"lineBreak":true},{"text":"imi varume veJudha nemi vanhu veJerusarema,","poem":2},{"text":"kuti kutsamwa kwangu kurege kukubudirai kukapisa somoto,","poem":1},{"text":"nokuda kwezvakaipa zvamakaita,","poem":2},{"lineBreak":true},{"text":"iko kupisa kusina angakudzima.","poem":2}]},{"type":"heading","content":["Njodzi inobva nokumusoro"]},{"type":"verse","number":5,"content":[{"text":"“Zivisai munyika yaJudha uye muparidze muJerusarema muchiti:","poem":1},{"text":"‘Ridzai hwamanda munyika yose!’","poem":2},{"text":"Danidzirai nesimba muchiti:","poem":1},{"text":"‘Unganai pamwe chete!","poem":2},{"lineBreak":true},{"text":"Ngatitizirei kumaguta akakomberedzwa!’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Simudzai mureza wokuenda kuZioni!","poem":1},{"text":"Tizai muvande musinganonoki!","poem":2},{"text":"Nokuti ndiri kuuyisa njodzi inobva kumusoro,","poem":1},{"text":"iko kuparadza kwakaipisisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Shumba yabuda mudenhere rayo;","poem":1},{"text":"muparadzi wendudzi abuda.","poem":2},{"text":"Asiya nzvimbo yake","poem":1},{"text":"kuti aparadze nyika yenyu.","poem":2},{"text":"Maguta enyu achava matongo","poem":1},{"text":"pasina achagaramo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Naizvozvo pfekai masaga,","poem":1},{"text":"chemai muungudze,","poem":2},{"text":"nokuti kutsamwa kwaJehovha","poem":1},{"text":"kunotyisa hakuna kubva kwatiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Pazuva iro,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"“mambo namachinda vachaora mwoyo,","poem":2},{"text":"vaprista vachatyiswa,","poem":1},{"text":"uye vaprofita vachavhundutswa.”","poem":2}]},{"type":"verse","number":10,"content":["Ipapo ndakati, “Haiwa, Ishe Jehovha, makanyengera kwazvo vanhu ava neJerusarema muchiti, ‘Muchava norugare,’ nyamba munondo uri pahuro dzedu.”"]},{"type":"verse","number":11,"content":["Panguva iyoyo vanhu ava neJerusarema vachaudzwa kuti, “Mhepo inopisa inobva kunzvimbo dzakakwirira dzisina miti mugwenga inovhuvhuta yakananga vanhu vangu, asi isingapepeti kana kunatsa;"]},{"type":"verse","number":12,"content":["mhepo ine simba kwazvo kudarika iyoyo ichabva kwandiri. Zvino ndiwo wava mutongo wangu pamusoro pavo.”"]},{"type":"verse","number":13,"content":[{"text":"Tarirai! Ari kuuya samakore,","poem":1},{"text":"ngoro dzake dzinouya sechamupupuri,","poem":2},{"text":"mabhiza ake anomhanya kupfuura makondo,","poem":1},{"text":"Tine nhamo! Taparara!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Haiwa Jerusarema, shamba zvakaipa zviri mumwoyo mako ugoponeswa.","poem":1},{"text":"Ucharamba uchingoviga pfungwa dzako dzakaipa kusvikira riini?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inzwi rinodanidzira richibva kuDhani,","poem":1},{"text":"richizivisa nezvenjodzi inobva kuzvikomo zveEfuremu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Zivisai izvi kumarudzi,","poem":1},{"text":"zviparidzei kuJerusarema muchiti:","poem":2},{"text":"‘Hondo ichakukombai iri kuuya ichibva kunyika iri kure,","poem":1},{"text":"ichidanidzira zvehondo yokurwisa maguta eJudha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Vanorikomba savanhu vakarinda munda,","poem":1},{"text":"nokuti rakandimukira,’ ”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"“Tsika dzako namabasa ako ndizvo zvauyisa","poem":1},{"text":"izvi pamusoro pako.","poem":2},{"text":"Ichi ndicho chirango chako.","poem":1},{"text":"Haiwa, zvinovava sei!","poem":2},{"lineBreak":true},{"text":"Haiwa, zvinobaya sei mwoyo!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Maiwe, kurwadziwa kwangu,","poem":1},{"text":"kurwadziwa kwangu!","poem":2},{"text":"Ndiri kubidirika nokurwadziwa.","poem":1},{"text":"Haiwa, kurwadza kwomwoyo wangu!","poem":2},{"lineBreak":true},{"text":"Hana yangu inorova mukati mangu, handinganyarari.","poem":2},{"text":"Nokuti ndanzwa kurira kwehwamanda;","poem":1},{"text":"ndanzwa mheremhere yehondo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Njodzi inotevera njodzi;","poem":1},{"text":"nyika yose yava dongo.","poem":2},{"text":"Munguva shoma shoma, matende angu aparadzwa,","poem":1},{"text":"musha wangu nenguva diki diki.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndicharamba ndichiona mureza wehondo kusvikira riniko,","poem":1},{"text":"uye ndichanzwa kurira kwehwamanda kusvikira riniko?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Vanhu vangu mapenzi;","poem":1},{"text":"havandizivi ini.","poem":2},{"text":"Vana vasina pfungwa;","poem":1},{"text":"havanzwisisi.","poem":2},{"text":"Vakangwarira kuita zvakaipa;","poem":1},{"text":"havazivi kuita zvakanaka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ndakatarira nyika,","poem":1},{"text":"yakanga isina kugadzirwa, isina chinhu;","poem":2},{"text":"uye nokumatenga,","poem":1},{"text":"chiedza chawo chakanga chisisipo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndakatarira pamakomo,","poem":1},{"text":"tarirai, aidengenyeka;","poem":2},{"lineBreak":true},{"text":"zvikomo zvose zvaizeya.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndakatarira, ipapo pakanga pasina vanhu;","poem":1},{"text":"shiri dzose dzedenga dzakanga dzabhururuka dzikaenda kure.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndakatarira, ndokuona nyika yaibereka zvibereko yava gwenga;","poem":1},{"text":"maguta ayo ose ava matongo pamberi paJehovha,","poem":2},{"lineBreak":true},{"text":"pamberi pehasha dzake dzinotyisa.","poem":2}]},{"type":"verse","number":27,"content":["Zvanzi naJehovha:",{"text":"“Nyika yose ichaparadzwa,","poem":1},{"text":"kunyange hangu ndisingazoiparadzi zvachose.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Naizvozvo nyika ichachema","poem":1},{"text":"uye matenga kumusoro achava rima","poem":2},{"text":"nokuti ndini ndazvitaura uye handingaregi kuzviita,","poem":1},{"text":"ndini ndazvisarudza uye handingadzokeri shure.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Paanonzwa kutinhira kwavatasvi vamabhiza nokwavawemburi vouta,","poem":1},{"text":"maguta ose anotiza.","poem":2},{"text":"Vamwe vanopinda mumatenhere;","poem":1},{"text":"vamwe vanokwira pakati pamatombo.","poem":2},{"text":"Maguta ose asara asina munhu;","poem":1},{"text":"hapana anogaramo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Uchaiteiko, iwe wokuparadzwa?","poem":1},{"text":"Wapfekereiko nguo tsvuku,","poem":2},{"lineBreak":true},{"text":"uye unoshongereiko zvishongo zvegoridhe?","poem":2},{"text":"Wazorereiko meso ako pendi?","poem":1},{"text":"Unongozvishongedzera pasina.","poem":2},{"text":"Zvikomba zvako zvinokushora;","poem":1},{"text":"zvinotsvaka kukuuraya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ndiri kunzwa kuchema sekwomukadzi anorwadziwa pakusununguka,","poem":1},{"text":"kugomera sekwomukadzi opona dangwe rake,","poem":2},{"text":"kuchema kwoMwanasikana weZioni ari kufemedzeka,","poem":1},{"text":"achitambanudza maoko ake achiti,","poem":2},{"text":"“Maiwe! Ndoziya;","poem":1},{"text":"upenyu hwangu hwaiswa kuvaurayi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}