{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Shoko pamusoro peIjipiti"]},{"type":"verse","number":1,"content":["Iri ndiro shoko raJehovha rakauya kuna Jeremia muprofita pamusoro pendudzi:"]},{"type":"verse","number":2,"content":["Pamusoro peIjipiti: Iri ndiro shoko pamusoro pehondo yaFaro Neko mambo weIjipiti, yakakundwa paKarikemishi, paRwizi Yufuratesi naNebhukadhinezari mambo weBhabhironi mugore rechina raJehoyakimi mwanakomana waJosia mambo weJudha:"]},{"type":"verse","number":3,"content":[{"text":"“Gadzirai nhoo dzenyu, dzose huru neduku,","poem":1},{"text":"mubude kundorwa!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sungai mabhiza,","poem":1},{"text":"sungirirai zvigaro!","poem":2},{"text":"Mirai panzvimbo yenyu","poem":1},{"text":"makapfeka nguwani!","poem":2},{"text":"Rodzai mapfumo enyu,","poem":1},{"text":"pfekai nguo dzenyu dzokurwa!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndinooneiko?","poem":1},{"text":"Vavhundutswa,","poem":2},{"text":"vari kudzokera shure,","poem":1},{"text":"mhare dzavo dzakundwa.","poem":2},{"text":"Vari kutiza nokukurumidza","poem":1},{"text":"vasingacheuki,","poem":2},{"lineBreak":true},{"text":"uye pano kutya kumativi ose,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Vanogona kumhanya havangatizi,","poem":1},{"text":"uye vakasimba havangapunyuki.","poem":2},{"text":"Nechokumusoro paRwizi Yufuratesi","poem":1},{"text":"vanogumburwa vagowa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ndianiko uyu anozara serwizi Nairi,","poem":1},{"text":"senzizi dzamapopopo emvura?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ijipiti yazara seNairi,","poem":1},{"text":"senzizi dzamapopopo.","poem":2},{"text":"Inoti, “Ndichazara ndigofukidza nyika;","poem":1},{"text":"ndichaparadza maguta navanhu vawo.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Virimai, imi mabhiza!","poem":1},{"text":"Chairai nehasha, imi vatasvi vengoro!","poem":2},{"text":"Fambirai mberi, imi mhare,","poem":1},{"text":"varume veEtiopia nePuti vanoitakura nhoo,","poem":2},{"lineBreak":true},{"text":"varume veRidhia vanowembura uta.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asi zuva iro nderaShe, iye Jehovha Wamasimba Ose,","poem":1},{"text":"iro zuva rokutsiva, rokutsiva vavengi vake.","poem":2},{"text":"Munondo uchadya kusvikira waguta,","poem":1},{"text":"kusvikira wapodza nyota yawo neropa.","poem":2},{"text":"Nokuti Ishe, iye Jehovha Wamasimba Ose, achabayira chibayiro","poem":1},{"text":"kunyika yokumusoro paRwizi Yufuratesi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Kwidza kuGireadhi undotora bharimu,","poem":1},{"text":"iwe Mwanasikana Mhandara yeIjipiti.","poem":2},{"text":"Asi unongowanza mishonga pasina;","poem":1},{"text":"kuporeswa kwako hapana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndudzi dzichanzwa nezvokunyadziswa kwako;","poem":1},{"text":"kuchema kwako kuchazadza nyika.","poem":2},{"text":"Mhare ichabondera pane imwe mhare;","poem":1},{"text":"vachawira pasi pamwe chete.”","poem":2}]},{"type":"verse","number":13,"content":["Iri ndiro shoko rakataurwa naJehovha kuna Jeremia muprofita, pamusoro pokuuya kwaNebhukadhinezari mambo weBhabhironi kuzorwa neIjipiti achiti:"]},{"type":"verse","number":14,"content":[{"text":"“Zivisai izvi muIjipiti, mugozviparidza paMigidhori;","poem":1},{"text":"zviparidzeiwo paNofi neTapanesi muchiti:","poem":2},{"text":"‘Torai nzvimbo yenyu uye muzvigadzirire,","poem":1},{"text":"nokuti munondo unodya vakakupoteredzai.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ko, mhare dzenyu dzingadzikisirwei?","poem":1},{"text":"Havangagoni kumira, nokuti Jehovha achavadzikisa pasi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Vacharamba vachingogumburwa;","poem":1},{"text":"vachawa mumwe nomumwe pamusoro pomumwe.","poem":2},{"text":"Vachati, ‘Simukai, ngatidzokerei","poem":1},{"text":"kuvanhu vokwedu nokunyika yedu,","poem":2},{"lineBreak":true},{"text":"kure nomunondo womumanikidzi wedu.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ikoko vachadanidzira vachiti,","poem":1},{"text":"‘Faro mambo weIjipiti anongova ruzha chete;","poem":2},{"lineBreak":true},{"text":"akatadza kushandisa mukana wake.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Zvirokwazvo noupenyu hwangu,” ndizvo zvinotaura Mambo,","poem":1},{"text":"ane zita rinonzi Jehovha Wamasimba Ose,","poem":2},{"text":"“pano mumwe achauya akaita seTabhori pakati pamakomo,","poem":1},{"text":"seKarimeri pagungwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Rongedzai zvinhu zvenyu, nokuti muchaenda kuutapwa,","poem":1},{"text":"imi munogara muIjipiti,","poem":2},{"text":"nokuti Nofi richaitwa dongo,","poem":1},{"text":"uye richava dongo risina anogaramo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ijipiti itsiru rakaisvonaka,","poem":1},{"text":"asi vuvo riri kuuya","poem":2},{"lineBreak":true},{"text":"kuzorwisa richibva kumusoro.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Varwi vanorwa kuti varipirwe mari chete vari mairi,","poem":1},{"text":"vakaita semhuru dzakakodzwa.","poem":2},{"text":"Naivowo vachatendeuka uye vachatiza pamwe chete,","poem":1},{"text":"havangamiri panzvimbo yavo,","poem":2},{"text":"nokuti zuva renjodzi riri kuuya pamusoro pavo,","poem":1},{"text":"nguva yokurangwa kwavo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ijipiti ichashinyira senyoka inotiza","poem":1},{"text":"pakuuya nechisimba kwomuvengi;","poem":2},{"text":"vachauya kuzorwa nayo namatemo,","poem":1},{"text":"savarume vanotema miti.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Vachatemera sango raro pasi,”","poem":1},{"text":"ndizvo zvinotaura Jehovha,","poem":4},{"text":"“kunyange risingapindiki zvaro.","poem":2},{"text":"Vakawanda kupfuura mhashu,","poem":1},{"text":"havaverengeki.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mwanasikana weIjipiti achanyadziswa,","poem":1},{"text":"achaiswa mumaoko avanhu vokumusoro.”","poem":2}]},{"type":"verse","number":25,"content":["Jehovha Wamasimba Ose, Mwari weIsraeri, anoti, “Ndava pedyo nokuuyisa shamhu pamusoro paAmoni mwari weTebhesi, napamusoro paFaro, neIjipiti navamwari vayo namadzimambo ayo, napamusoro peavo vanovimba naFaro."]},{"type":"verse","number":26,"content":["Ndichavaisa mumaoko eavo vanotsvaka kuvauraya, nokuna Nebhukadhinezari mambo weBhabhironi namachinda ake. Shure kwaizvozvo, Ijipiti ichagarwa sepamazuva akare,” ndizvo zvinotaura Jehovha."]},{"type":"verse","number":27,"content":[{"text":"“Usatya, iwe Jakobho muranda wangu;","poem":1},{"text":"usavhunduka, iwe Israeri.","poem":2},{"text":"Zvirokwazvo ndichakuponesa uri kunzvimbo iri kure,","poem":1},{"text":"nezvizvarwa zvako kubva kunyika youtapwa hwavo,","poem":2},{"text":"Jakobho achavazve norugare nokuchengetedzeka,","poem":1},{"text":"uye hakuna achamutyisa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Usatya, iwe Jakobho muranda wangu,","poem":1},{"text":"nokuti ndinewe,” ndizvo zvinotaura Jehovha.","poem":2},{"text":"“Kunyange ndikaparadza chose marudzi ose","poem":1},{"text":"andakakuparadzirai pakati pawo,","poem":2},{"lineBreak":true},{"text":"handizokuparadzei imi zvachose.","poem":2},{"text":"Ndichakurangai, asi chete nokururamisira;","poem":1},{"text":"handingakuregei musina kurangwa zvachose.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}