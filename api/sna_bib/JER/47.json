{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Chirevo pamusoro pavaFiristia"]},{"type":"verse","number":1,"content":["Iri ndiro shoko raJehovha rakasvika kumuprofita Jeremia pamusoro pavaFiristia, Faro asati arwisa Gaza:"]},{"type":"verse","number":2,"content":["Zvanzi naJehovha:",{"text":"“Onai kukwira kunoita mvura zhinji yokumusoro;","poem":1},{"text":"ivo vachava rwizi runofashukira nesimba.","poem":2},{"text":"Vachafukidza nyika nezvose zviri mairi,","poem":1},{"text":"maguta navose vanogaramo.","poem":2},{"text":"Vanhu vachachema;","poem":1},{"text":"vose vanogara munyika vachaungudza","poem":2}]},{"type":"verse","number":3,"content":[{"text":"pavachanzwa mutsindo wemahwanda emabhiza,","poem":1},{"text":"kutinhira kwengoro dzavavengi,","poem":2},{"lineBreak":true},{"text":"nokurira kwemavhiri adzo.","poem":2},{"text":"Madzibaba haangadzoki kuzobatsira vana vavo;","poem":1},{"text":"maoko avo acharembera seakaremara.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nokuti zuva rasvika","poem":1},{"text":"rokuparadza vaFiristia vose,","poem":2},{"text":"uye nokuuraya vose vakasara","poem":1},{"text":"vaigona kubatsira Tire neSidhoni.","poem":2},{"text":"Jehovha ava pedyo nokuparadza vaFiristia,","poem":1},{"text":"vaya vakasara vanobva kumahombekombe eKafitori.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gaza richaveura musoro waro mukuchema;","poem":1},{"text":"Ashikeroni richati mwiro.","poem":2},{"text":"Haiwa, imi vakasara vari pabani,","poem":1},{"text":"muchapedza nguva yakadiiko muchizvicheka?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Muchachema muchiti, ‘Maiwe, munondo waJehovha,","poem":1},{"text":"uchapedza nguva yakadiiko usati wazorora?","poem":2},{"text":"Dzokera mumuhara wako;","poem":1},{"text":"mira, unyarare.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asi ungazorora sei,","poem":1},{"text":"Jehovha akaurayira,","poem":2},{"text":"sezvo akaurayira","poem":1},{"text":"kuti urwise Ashikeroni namahombekombe?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}