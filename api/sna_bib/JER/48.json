{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Chirevo pamusoro peMoabhu"]},{"type":"verse","number":1,"content":["Pamusoro peMoabhu: Zvanzi naJehovha Wamasimba Ose, Mwari waIsraeri: “Ine nhamo Nebho, nokuti ichaparadzwa.",{"text":"Kiriataimi ichanyadziswa uye ichakundwa;","poem":2},{"lineBreak":true},{"text":"nhare dzichanyadziswa uye dzichaparadzwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moabhu haichazorumbidzwizve;","poem":1},{"text":"muHeshibhoni varume vacharangana nezvokuwa kwaro, vachiti: ‘Uyai, tiparadze rudzi urwo.’","poem":2},{"text":"Newewo, iwe Madhimeni uchati mwiro;","poem":1},{"text":"munondo uchakutevera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inzwai kuchema kunobva kuHoronaimi,","poem":1},{"text":"kuchema kwokukoromorwa nokuparadzwa kukuru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moabhu ichaputswa;","poem":1},{"text":"vana vadiki varo vacharidza mhere.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vachakwira nomukwidza weRuhiti,","poem":1},{"text":"vachichema zvikuru pakuenda kwavo;","poem":2},{"text":"pamateru enzira yokuHoronaimi","poem":1},{"text":"kuchema kwokurwadziwa pamusoro pokuparadza kunonzwika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tizai! Mhanyai muponese upenyu hwenyu;","poem":1},{"text":"mufanane negwenzi riri mugwenga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sezvo muchivimba namabasa uye nepfuma yenyu,","poem":1},{"text":"nemiwo muchatapwa,","poem":2},{"text":"uye Kemoshi ichaenda kuutapwa,","poem":1},{"text":"pamwe chete navaprista namachinda ayo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Muparadzi acharwa namaguta ose ose,","poem":1},{"text":"uye hapana guta richapunyuka.","poem":2},{"text":"Mupata uchaparadzwa,","poem":1},{"text":"uye mutunhu wakakwirira uchaparadzwa","poem":2},{"lineBreak":true},{"text":"nokuti Jehovha azvitaura.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isai munyu pamusoro peMoabhu,","poem":1},{"text":"nokuti ichaparadzwa;","poem":2},{"text":"maguta ayo achava matongo,","poem":1},{"text":"asina achazogaramo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ngaatukwe uyo anobata basa raJehovha asina hanya!","poem":1},{"text":"Ngaatukwe uyo anodzora munondo wake pakuteura ropa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Moabhu anga ane zororo kubvira pauduku hwake,","poem":1},{"text":"sewaini yasarira mumasese,","poem":2},{"text":"isina kudirwa kubva muno mumwe mudziyo ichiiswa muno mumwe,","poem":1},{"text":"haana kuenda kuutapwa.","poem":2},{"text":"Saka anongotapira sezvaakanga ari,","poem":1},{"text":"uye kunhuhwira kwake hakuna kushanduka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi mazuva anouya,”","poem":1},{"text":"ndizvo zvinotaura Jehovha,","poem":2},{"text":"“andichatuma varume vanodurura zvinobva mumudziyo,","poem":1},{"text":"uye vachadururira pasi;","poem":2},{"text":"vachasiya midziyo isina chinhu","poem":1},{"text":"uye vagoputsa midziyo yake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ipapo Moabhu achanyadziswa neKemoshi,","poem":1},{"text":"sokunyadziswa kwakaitwa imba yaIsraeri","poem":2},{"lineBreak":true},{"text":"pavakavimba neBheteri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ungataura sei, uchiti, ‘Tiri mhare,","poem":1},{"text":"varume vakatsunga muhondo’?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Moabhu ichaparadzwa, uye maguta ayo acharwiswa;","poem":1},{"text":"majaya ake akaisvonaka achaburukira kundourayiwa,”","poem":2},{"lineBreak":true},{"text":"ndizvo zvinotaura Mambo, ane zita rinonzi Jehovha Wamasimba Ose.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Kuwa kweMoabhu kwava pedyo;","poem":1},{"text":"njodzi yayo ichasvika nokukurumidza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ichemei, imi mose mugere makaipoteredza,","poem":1},{"text":"vose vanoziva mukurumbira wayo;","poem":2},{"text":"muti, ‘Yavhunika seiko tsvimbo yakasimba,","poem":1},{"text":"wavhunika seiko mudonzvo wakaisvonaka!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Burukai pakukudzwa kwenyu","poem":1},{"text":"mugare pavhu rakaoma,","poem":2},{"lineBreak":true},{"text":"imi vagari voMwanasikana weDhibhoni,","poem":2},{"text":"nokuti iye anoparadza Moabhu","poem":1},{"text":"achauya kuzokurwisai,","poem":2},{"lineBreak":true},{"text":"uye agoparadza maguta enyu akakomberedzwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mirai panzira mutarire,","poem":1},{"text":"imi vagari vemuAroeri.","poem":2},{"text":"Bvunzai murume ari kutiza nomukadzi apunyuka,","poem":1},{"text":"muvabvunze kuti, ‘Chii chaitika?’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moabhu yanyadziswa, nokuti yaparadzwa.","poem":1},{"text":"Ungudzai uye muridze mhere!","poem":2},{"text":"Zvizivisei paArinoni","poem":1},{"text":"kuti Moabhu yaparadzwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kutonga kwasvika kumutunhu wakakwirira,","poem":1},{"text":"kuHoroni, Jahaza neMefaati,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"kuDhibhoni, Nebho neBheti Dhibhirataimu,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"kuKiriataimu, neBheti Gamuri neBheti Meoni,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"kuKerioti neBhozira,","poem":2},{"lineBreak":true},{"text":"nokumaguta ose eMoabhu ari kure neari pedyo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Runyanga rweMoabhu rwagurwa;","poem":1},{"text":"ruoko rwake rwavhunika,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Itai kuti adhakwe,","poem":1},{"text":"nokuti iye azvidza Jehovha.","poem":2},{"text":"Regai Moabhu aumburuke mumarutsi ake;","poem":1},{"text":"ngaave chinhu chinosekwa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ko, Israeri haana kuva chinhu chinosekwa nemi here?","poem":1},{"text":"Ko, akabatwa ari pakati pembavha here,","poem":2},{"text":"zvamunodzungudza musoro wenyu","poem":1},{"text":"muchimushora pose pamunotaura nezvake?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Siyai maguta enyu mundogara pakati pamatombo,","poem":1},{"text":"imi mugere muMoabhu.","poem":2},{"text":"Itai senjiva inovaka dendere rayo","poem":1},{"text":"pamuromo webako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Takanzwa nezvokuzvikudza kweMoabhu,","poem":1},{"text":"manyawi nokudada kwavo kukuru","poem":2},{"text":"uye kuzvikudza kwakanyanya,","poem":1},{"text":"kuzvikudza kwavo nokuzvitutumadza namanyawi emwoyo wayo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ndinoziva kusindimara kwayo asi hakuna maturo,”","poem":1},{"text":"ndizvo zvinotaura Jehovha,","poem":4},{"text":"“uye kuzvikudza kwake kuzhinji hakuna zvakunoreva.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Naizvozvo ndinoungudza pamusoro peMoabhu,","poem":1},{"text":"nokuda kweMoabhu yose ndinodanidzira,","poem":2},{"lineBreak":true},{"text":"ndinochema varume veKiri Hareseti.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ndinokuchema sokuchema kunoita Jazeri,","poem":1},{"text":"haiwa imi mazambiringa eGibhima.","poem":2},{"text":"Matavi enyu akatandavara kundosvika kugungwa;","poem":1},{"text":"akandosvika kugungwa reJazeri.","poem":2},{"text":"Muparadzi awira pamichero yako","poem":1},{"text":"yaibva namazambiringa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mufaro nokufarisisa zvaenda,","poem":1},{"text":"zvabva muminda yemichero nomuminda yeMoabhu.","poem":2},{"text":"Ndagumisa kuyerera kwewaini inobva pazvisviniro;","poem":1},{"text":"hakuna achazvitsika achidanidzira nomufaro.","poem":2},{"text":"Kunyange pano kudanidzira,","poem":1},{"text":"hakusi kudanidzira kwomufaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Inzwi rokuchema kwavo rinokwira","poem":1},{"text":"richibva kuHeshibhoni kusvikira kuErieri neJahazi,","poem":2},{"text":"kubva kuZoari kusvikira kuHoronaimi neEgirati Sherishiya,","poem":1},{"text":"nokuti kunyange nemvura dzeNimirimi dzapwa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ndichaisa magumo muMoabhu,","poem":1},{"text":"kuna avo vanopa zvipiriso panzvimbo dzakakwirira,","poem":2},{"lineBreak":true},{"text":"uye vanopisira zvinonhuhwira kuna vamwari vavo,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":36,"content":[{"text":"“Saka mwoyo wangu unorira senyere pamusoro peMoabhu;","poem":1},{"text":"unorira senyere pamusoro pavarume veKiri Hareseti.","poem":2},{"lineBreak":true},{"text":"Pfuma yavakawana yapera.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Musoro mumwe nomumwe wakaveurwa,","poem":1},{"text":"uye ndebvu dzose dzakagurirwa;","poem":2},{"text":"ruoko rumwe norumwe rwakagurwa,","poem":1},{"text":"uye zviuno zvose zvakafukidzwa namasaga.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Pamusoro pamatenga ose eMoabhu","poem":1},{"text":"napazvivara","poem":2},{"text":"hakuna chiriko kunze kwokuchema,","poem":1},{"text":"nokuti ndaputsa Moabhu","poem":2},{"lineBreak":true},{"text":"sedende risina anorida,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":39,"content":[{"text":"“Akoromorwa sei! Vaungudza sei!","poem":1},{"text":"Hoyo Moabhu afuratira nokuda kwokunyadziswa!","poem":2},{"text":"Moabhu yava chinhu chinosekwa,","poem":1},{"text":"chinhu chinonyangadza kuna vose vakaipoteredza.”","poem":2}]},{"type":"verse","number":40,"content":["Zvanzi naJehovha:",{"text":"“Tarirai achabhururuka segondo,","poem":1},{"text":"rakatambanudzira mapapiro aro pamusoro peMoabhu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Kerioti ichatapwa","poem":1},{"text":"uye nhare dzichatorwa.","poem":2},{"text":"Pazuva iro mwoyo yemhare dzeMoabhu","poem":1},{"text":"ichafanana nomwoyo womukadzi ari kurwadziwa.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Moabhu ichaparadzwa serudzi","poem":1},{"text":"nokuti yakazvidza Jehovha.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Kutya negomba nomusungo zvakakumirirai,","poem":1},{"text":"imi vanhu veMoabhu,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":44,"content":[{"text":"“Ani naani achatiza njodzi","poem":1},{"text":"iyi achawira mugomba,","poem":2},{"text":"ani naani achakwira achibuda mugomba,","poem":1},{"text":"achabatwa mumusungo;","poem":2},{"text":"nokuti ndichauyisa pamusoro peMoabhu","poem":1},{"text":"gore rokurangwa kwake,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Mumumvuri weHeshibhoni","poem":1},{"text":"vatizi vanomirapo vasina simba,","poem":2},{"text":"nokuti moto wabuda uchibva kuHeshibhoni,","poem":1},{"text":"murazvo pakati peSihoni;","poem":2},{"text":"unopisa huma dzaMoabhu,","poem":1},{"text":"misoro yavanozvikudza vemheremhere.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Une nhamo, iwe Moabhu!","poem":1},{"text":"Vanhu veKemoshi vaparara;","poem":2},{"text":"vanakomana vako vakaendeswa kuutapwa","poem":1},{"text":"navanasikana vako muutapwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Kunyange zvakadaro ndichadzosazve pfuma yeMoabhu","poem":1},{"text":"pamazuva anouya,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4},"Pano ndipo panogumira kutongwa kweMoabhu."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}