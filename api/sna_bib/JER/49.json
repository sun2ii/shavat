{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["Chirevo pamusoro paAmoni"]},{"type":"verse","number":1,"content":["Pamusoro paAmoni: Zvanzi naJehovha:",{"text":"“Ko, Israeri haana mwanakomana here?","poem":1},{"text":"Haana vadyi venhaka here?","poem":2},{"text":"Ko, zvino Moreki atorerei nhaka yaGadhi?","poem":1},{"text":"Nemhaka yeiko vanhu vake vachigara mumaguta ayo?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Asi mazuva anouya,”","poem":1},{"text":"ndizvo zvinotaura Jehovha,","poem":2},{"text":"“andicharidza mhere yehondo","poem":1},{"text":"pamusoro peRabha ravaAmoni;","poem":2},{"text":"richaitwa murwi wamatongo,","poem":1},{"text":"uye misha yakaripoteredza ichapiswa nomoto.","poem":2},{"text":"Ipapo Israeri achadzinga","poem":1},{"text":"vaya vakanga vamudzinga,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"“Ungudza, iwe Heshibhoni, nokuti Ai raparadzwa!","poem":1},{"text":"Ridzai mhere, imi vanogara muRabha!","poem":2},{"text":"Pfekai masaga mucheme,","poem":1},{"text":"mhanyai pano nekoko pakati porusvingo,","poem":2},{"text":"nokuti Moreki achaenda kuutapwa,","poem":1},{"text":"pamwe chete navaprista vake namachinda ake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unozvikudzireiko nemipata yako,","poem":1},{"text":"kuzvikudza nemipata inobereka kwazvo?","poem":2},{"text":"Haiwa mwanasikana wokusatendeka,","poem":1},{"text":"unovimba nepfuma yako uchiti,","poem":2},{"lineBreak":true},{"text":"‘Ndiani acharwa neni?’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndichauyisa kutya pamusoro pako","poem":1},{"text":"kunobva kuna avo vakakupoteredza,”","poem":2},{"text":"ndizvo zvinotaura Jehovha Wamasimba Ose.","poem":4},{"text":"“Mumwe nomumwe wenyu achadzingirwa kure,","poem":1},{"text":"uye hakuna achaunganidza vatizi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Asi shure kwaizvozvo, ndichadzosazve pfuma yavaAmoni,”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"heading","content":["Chirevo pamusoro peEdhomu"]},{"type":"verse","number":7,"content":["Pamusoro peEdhomu: Zvanzi naJehovha Wamasimba Ose:",{"text":"“Ko, muTemani hamuchina uchenjeri here?","poem":1},{"text":"Mano atsakatika here kuna vakangwara?","poem":2},{"lineBreak":true},{"text":"Ko, uchenjeri hwavo hwaora here?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dzokai uye mutize, muwande mumapako akadzika,","poem":1},{"text":"imi munogara muDhedhani,","poem":2},{"text":"nokuti ndichauyisa njodzi pamusoro paEsau,","poem":1},{"text":"panguva yandinomuranga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kana vanononga mazambiringa vakasvika kwauri,","poem":1},{"text":"havangasiyi mazambiringa mashoma here?","poem":2},{"text":"Kana mbavha dzikasvika usiku,","poem":1},{"text":"havangabi zvavanoda chete here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asi ndichafukura Esau;","poem":1},{"text":"ndichazarura nzvimbo dzake dzokuvanda,","poem":2},{"lineBreak":true},{"text":"kuitira kuti akundikane kuzvivanza.","poem":2},{"text":"Vana vake, nehama dzake navavakidzani vake vachafa,","poem":1},{"text":"uye iye haachazovapozve.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Siya nherera dzako; ini ndicharwira upenyu hwavo.","poem":1},{"text":"Chirikadzi dzakowo dzichagona kuvimba neni.”","poem":2}]},{"type":"verse","number":12,"content":["Zvanzi naJehovha: “Kana avo vakanga vasingafaniri kunwa pamukombe vakodzera kuunwa, iwe ucharegereiko kurangwa? Haungaregi kurangwa, asi unofanira kunwa pamukombe wacho."]},{"type":"verse","number":13,"content":["Ndinopika neni ndimene,” ndizvo zvinotaura Jehovha, “kuti Bhozira richava dongo nechinhu chinonyangadza, nechinhu chinotyisa, chinozvidzwa nechinotukwa; uye maguta aro ose achava matongo nokusingaperi.”"]},{"type":"verse","number":14,"content":[{"text":"Ndakanzwa shoko rakabva kuna Jehovha, richiti:","poem":1},{"text":"Nhume yakatumwa kundudzi kunoti,","poem":2},{"text":"“Unganai kuti murwe naro!","poem":1},{"text":"Simukai murwe!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Zvino ndichakuita muduku pakati pendudzi,","poem":1},{"text":"anozvidzwa pakati pavanhu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kutyisa kwaunoita,","poem":1},{"text":"nokuzvikudza kwomwoyo wako zvakunyengera,","poem":2},{"text":"iwe unogara mumikaha yematombo,","poem":1},{"text":"ugere panzvimbo dzakakwirira dzechikomo.","poem":2},{"text":"Kunyange ukavaka dendere rako pakakwirira segondo,","poem":1},{"text":"ndichakukoromora kubva ipapo,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"“Edhomu richava chinhu chinotyisa,","poem":1},{"text":"vose vachapfuura napo vachashamiswa,","poem":2},{"lineBreak":true},{"text":"uye vachaseka nokuda kwamavanga aro ose.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sokuparadzwa kwakaitwa Sodhomu neGomora,","poem":1},{"text":"pamwe chete namaguta akanga akavakidzana nawo,”","poem":2},{"text":"ndizvo zvinotaura Jehovha,","poem":4},{"text":"“saka hakuna munhu achazogarako;","poem":1},{"text":"hakuna munhu achagara mariri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Seshumba inobuda mumatenhere eJorodhani","poem":1},{"text":"ichienda kumafuro akapfuma,","poem":2},{"text":"ndichadzinga Edhomu kubva munyika yake pakarepo.","poem":1},{"text":"Ndianiko akasarudzwa wandichagadza kuti aite izvi?","poem":2},{"text":"Ndiani akafanana neni uye ndiani angakwikwidzane neni?","poem":1},{"text":"Uye ndoupi mufudzi angamisidzana neni?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Naizvozvo, inzwai zvakarongwa naJehovha pamusoro peEdhomu,","poem":1},{"text":"zvaakafunga pamusoro peavo vagere muTemani:","poem":2},{"text":"Achakwekweredza vaduku vemapoka;","poem":1},{"text":"achaparadza chose mafuro avo nokuda kwavo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nyika ichadedera nokuda kwomubvumo wokuwa kwavo;","poem":1},{"text":"kuchema kwavo kuchanzwikwawo kusvikira kuGungwa Dzvuku.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tarirai gondo richabhururuka ndokudzika nesimba,","poem":1},{"text":"rakatambanudza mapapiro aro pamusoro peBhozira.","poem":2},{"text":"Pazuva iro mwoyo yemhare dzeEdhomu","poem":1},{"text":"ichafanana nomwoyo womukadzi orwadziwa.","poem":2}]},{"type":"heading","content":["Chirevo pamusoro peDhamasiko"]},{"type":"verse","number":23,"content":["Pamusoro peDhamasiko:",{"text":"“Hamati neAripadhi avhundutswa,","poem":1},{"text":"nokuti agamuchira mashoko akaipa.","poem":2},{"text":"Aora mwoyo,","poem":1},{"text":"atambudzika segungwa risina zororo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dhamasiko harichina simba,","poem":1},{"text":"rakatendeuka kuti ritize,","poem":2},{"lineBreak":true},{"text":"kuvhunduka kukaribata;","poem":2},{"text":"kugomera nokurwadziwa zvakaribata,","poem":1},{"text":"kurwadziwa sekwomukadzi osununguka.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Guta remukurumbira harina kusiyiwa seiko,","poem":1},{"text":"iro guta randinofarira?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Zvirokwazvo majaya aro achawa mumigwagwa;","poem":1},{"text":"varwi varo vose vachati mwiro pazuva iroro,”","poem":2},{"text":"ndizvo zvinotaura Jehovha Wamasimba Ose.","poem":4}]},{"type":"verse","number":27,"content":[{"text":"“Ndichatungidza moto kumasvingo eDhamasiko;","poem":1},{"text":"uchaparadza nhare dzose dzaBheni-Hadhadhi.”","poem":2}]},{"type":"heading","content":["Chirevo pamusoro peKedhari neHazori"]},{"type":"verse","number":28,"content":["Pamusoro peKedhari noumambo hweHazori, hwakarwiswa naNebhukadhinezari mambo weBhabhironi: Zvanzi naJehovha:",{"text":"“Simukai, murwise Kedhari","poem":1},{"text":"uye muparadze vanhu vokuMabvazuva.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Matende avo namapoka avo amakwai achatorwa;","poem":1},{"text":"matumba avo achatorwa achiendwa nawo,","poem":2},{"lineBreak":true},{"text":"nemidziyo yavo yose nengamera.","poem":2},{"text":"Vanhu vachadanidzira kwavari vachiti,","poem":1},{"text":"‘Zvinhu zviri kutyisa kumativi ose!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Tizirai kure nokukurumidza!","poem":1},{"text":"Garai mumapako akadzika, imi vagari vomuHazari,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"“Nebhukadhinezari mambo weBhabhironi aita zvakaipa pamusoro penyu;","poem":1},{"text":"aronga zano pamusoro penyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Simukai mundorwisa rudzi rwakazvigarira zvarwo,","poem":1},{"text":"rugere zvarwo rusina hanya,”","poem":2},{"text":"ndizvo zvinotaura Jehovha,","poem":4},{"text":"“irwo rudzi rusina masuo kana mazariro;","poem":1},{"text":"vanhu varwo vanogara voga zvavo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngamera dzavo dzichapambwa,","poem":1},{"text":"uye mombe dzavo dzakawanda dzichapambwa.","poem":2},{"text":"Ndichaparadzira kumhepo avo vari kunyika dzokure,","poem":1},{"text":"uye ndichauyisa njodzi pamusoro pavo kubva kumativi ose,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":33,"content":[{"text":"“Hazori richava ugaro hwamakava,","poem":1},{"text":"dongo nokusingaperi.","poem":2},{"text":"Hapana achagarako;","poem":1},{"text":"hakuna munhu achagara mariri.”","poem":2}]},{"type":"heading","content":["Chirevo pamusoro peEramu"]},{"type":"verse","number":34,"content":["Iri ndiro shoko raJehovha rakasvika kuna Jeremia muprofita pamusoro peEramu, pakutanga kwokubata ushe kwaZedhekia mambo weJudha, richiti:"]},{"type":"verse","number":35,"content":["Zvanzi naJehovha Wamasimba Ose:",{"text":"“Tarirai, ndichavhuna uta hweEramu,","poem":1},{"text":"iwo musimboti wesimba ravo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ndichauyisa pamusoro paEramu mhepo ina,","poem":1},{"text":"kubva kumativi mana ematenga;","poem":2},{"text":"ndichavaparadzira kumhepo ina","poem":1},{"text":"uye hakungavi norudzi rumwe","poem":2},{"lineBreak":true},{"text":"kusingaendwi navavakidzani veEramu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ndichapwanya Eramu pamberi pavavengi vavo,","poem":1},{"text":"pamberi paivo vanotsvaka kuvauraya;","poem":2},{"text":"ndichauyisa njodzi pamusoro pavo,","poem":1},{"text":"iko kutsamwa kwangu kunotyisa,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"“Ndichavatevera nomunondo","poem":1},{"text":"kusvikira ndavapedza.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ndichaisa chigaro changu choushe muEramu","poem":1},{"text":"uye ndichaparadza mambo wayo namachinda ayo,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Asi ndichadzosa nhaka yeEramu","poem":1},{"text":"mumazuva okupedzisira,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}