{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["Hakuna akarurama"]},{"type":"verse","number":1,"content":[{"text":"“Kwirai nokudzika nemigwagwa yeJerusarema,","poem":1},{"text":"tarirai pose pose mugofunga,","poem":2},{"lineBreak":true},{"text":"tsvakai muzvivara zvaro muone","poem":2},{"text":"kana mukawana kana munhu mumwe","poem":1},{"text":"anoita zvakanaka uye anotsvaka zvokwadi,","poem":2},{"lineBreak":true},{"text":"ipapo ndicharegerera guta iri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kunyange vachiti havo, ‘NaJehovha mupenyu,’","poem":1},{"text":"vanenge vachingopika nhema.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Haiwa Jehovha, meso enyu haatsvaki chokwadi here?","poem":1},{"text":"Makavarova, asi havana kunzwa kurwadziwa;","poem":2},{"lineBreak":true},{"text":"Makavapwanya, asi vakaramba kurayirwa.","poem":2},{"text":"Vakaomesa zviso zvavo kupfuura dombo","poem":1},{"text":"uye vakaramba kutendeuka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndakafunga ndikati, “Ava varombo bedzi;","poem":1},{"text":"mapenzi,","poem":2},{"text":"nokuti havazivi nzira yaJehovha,","poem":1},{"text":"nezvinodikanwa naMwari wavo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naizvozvo ndichaenda kuvatungamiri","poem":1},{"text":"ndigotaura navo;","poem":2},{"text":"zvirokwazvo vanoziva nzira yaJehovha,","poem":1},{"text":"zvinodiwa naMwari wavo.”","poem":2},{"text":"Asi nomwoyo mumwe, naivowo vakanga vavhuna joko,","poem":1},{"text":"vakadambura makashu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Saka shumba inobva musango ichavauraya,","poem":1},{"text":"bere rinobva mugwenga richavabvambura,","poem":2},{"text":"ingwe ichavavandira pedyo","poem":1},{"text":"namaguta avo kuti ibvamburanye vose vanobudamo,","poem":2},{"text":"nokuti kundimukira kwavo kukuru","poem":1},{"text":"uye kudzokera shure kwavo kwawanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ndingakukanganwirai seiko?","poem":1},{"text":"Vana venyu vakandisiya,","poem":2},{"lineBreak":true},{"text":"uye vakapika navamwari vasati vari vamwari.","poem":2},{"text":"Ndakavapa zvose zvavaishayiwa,","poem":1},{"text":"asi ivo vakaita ufeve","poem":2},{"lineBreak":true},{"text":"vakandoungana kudzimba dzezvifeve.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ivo mabhiza anodya achiguta azere ruchiva,","poem":1},{"text":"mumwe nomumwe achidokwairira mukadzi womumwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ko, handingavarangi nokuda kwaizvozvi here?”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":2},{"text":"“Ko, handingazvitsiviri","poem":1},{"text":"here parudzi rwakadai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Endai nomuminda yavo yamazambiringa muiparadze,","poem":1},{"text":"asi musaiparadza zvachose.","poem":2},{"text":"Bvisai matavi awo,","poem":1},{"text":"nokuti vanhu ava havasi vaJehovha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Imba yaIsraeri neimba yaJudha","poem":1},{"text":"vanga vasina kutendeka kwandiri zvachose,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Vakarevera Jehovha nhema,","poem":1},{"text":"vachiti, “Haana chaachaita!","poem":2},{"text":"Hakuna chakaipa chichaitika kwatiri;","poem":1},{"text":"hatichazombooni hondo kana nzara.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vaprofita vangova mhepo,","poem":1},{"text":"uye shoko harimo mavari.","poem":2},{"lineBreak":true},{"text":"Saka zvavanotaura ngazviitwe kwavari.”","poem":2}]},{"type":"verse","number":14,"content":["Naizvozvo zvanzi naJehovha Mwari Wamasimba Ose:",{"text":"“Nokuti vanhu vakataura mashoko aya,","poem":1},{"text":"ndichaita kuti mashoko angu","poem":2},{"text":"ave moto mumuromo mako,","poem":1},{"text":"uye vanhu ava kuti vave huni dzinopiswa nawo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Haiwa imi imba yaIsraeri,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"“ndiri kuuyisa rudzi runobva kure kuzokurwisai,","poem":2},{"text":"rudzi rwakare kare uye rudzi rwakashinga,","poem":1},{"text":"vanhu vane rurimi rwamusinganzwi,","poem":2},{"lineBreak":true},{"text":"vano mutauro wamusinganzwisisi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Magoba avo akafanana neguva rakashama;","poem":1},{"text":"vose zvavo varwi vane simba.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Vachadya zvamakakohwa nezvokudya zvenyu,","poem":1},{"text":"vachauraya vanakomana navanasikana venyu;","poem":2},{"text":"vachadya makwai enyu nemombe dzenyu,","poem":1},{"text":"vachadya mazambiringa namaonde enyu.","poem":2},{"text":"Vachaparadza nomunondo,","poem":1},{"text":"maguta enyu akakomberedzwa iwo amunovimba nawo.","poem":2}]},{"type":"verse","number":18,"content":["“Kunyange mumazuva iwayo,” ndizvo zvinotaura Jehovha, “handingakuparadzei zvachose."]},{"type":"verse","number":19,"content":["Zvino kana vanhu vakabvunza kuti, ‘Ko, Jehovha Mwari wedu aitirei izvi kwatiri?’ imi muchavaudza kuti, ‘Sezvo makandisiya mukandoshumira vamwari vavatorwa munyika yenyu chaiyo, saizvozvowo zvino muchashandira vatorwa munyika isiri yenyu.’"]},{"type":"verse","number":20,"content":[{"text":"“Zivisai izvi kuimba yaJakobho","poem":1},{"text":"mugozviparidza maJudha muchiti:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inzwai izvi imi mapenzi navanhu vasina pfungwa,","poem":1},{"text":"vane meso, asi vasingaoni,","poem":2},{"lineBreak":true},{"text":"vane nzeve, asi vasinganzwi:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ko, hamufaniri kunditya here?” ndizvo zvinotaura Jehovha.","poem":1},{"text":"“Ko, hamufaniri kudedera pamberi pangu here?","poem":2},{"text":"Ndakaita jecha kuti rive muganhu wegungwa,","poem":1},{"text":"muganhu warisingadariki nokusingaperi.","poem":2},{"text":"Mafungu angafashama, asi haangakundi;","poem":1},{"text":"angavirima asi haangaudariki.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Asi vanhu ava vane mwoyo yakasindimara uye inondimukira;","poem":1},{"text":"vakatsauka vakaenda kure.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Havati mumwoyo yavo,","poem":1},{"text":"‘Ngatityei Jehovha Mwari wedu,","poem":2},{"text":"anotipa mvura yaMatsutso neyoMunakamwe nenguva yayo,","poem":1},{"text":"anotitsidzira mavhiki akatarwa okukohwa.’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Zvakaipa zvenyu zvakadzingira izvi kure;","poem":1},{"text":"zvivi zvenyu zvakadzivisa kuti zvinhu zvakanaka zviuye kwamuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Pakati pavanhu vangu pane vanhu vakaipa","poem":1},{"text":"vanovandira kufanana savanhu vanoteya shiri nougombe","poem":2},{"lineBreak":true},{"text":"uye savaya vanoisa misungo yokubata vanhu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sedendere rizere neshiri,","poem":1},{"text":"dzimba dzavo dzizere nokunyengera;","poem":2},{"text":"vapfuma uye vava nesimba,","poem":1}]},{"type":"verse","number":28,"content":[{"text":"uye vafuta uye vobwinya.","poem":2},{"lineBreak":true},{"text":"Zvakaipa zvavo hazvina magumo,","poem":2},{"lineBreak":true},{"text":"havatambi mhaka dzenherera kuti vakunde,","poem":2},{"lineBreak":true},{"text":"havadziviriri kodzero dzavarombo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ko, handifaniri kuvaranga pane izvi here?”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":2},{"text":"“Ko, handingazvitsiviri here","poem":1},{"text":"parudzi rwakadai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Chinhu chinosemesa uye chinovhundutsa","poem":1},{"text":"chaitika panyika.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Vaprofita vanoprofita nhema,","poem":1},{"text":"vaprista vanotonga nesimba ravo","poem":2},{"text":"uye vanhu vangu vanofarira izvozvo.","poem":1},{"text":"Asi muchaiteiko pakupedzisira?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}