{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Chirevo pamusoro peBhabhironi"]},{"type":"verse","number":1,"content":["Iri ndiro shoko rakataurwa naJehovha kubudikidza nomuprofita Jeremia pamusoro peBhabhironi nenyika yavaBhabhironi:"]},{"type":"verse","number":2,"content":[{"text":"“Zivisai, uye paridzai pakati pendudzi,","poem":1},{"text":"simudzai mureza uye paridzai;","poem":2},{"lineBreak":true},{"text":"musasiya kana chinhu, asi muti,","poem":2},{"text":"‘Bhabhironi richakundwa;","poem":1},{"text":"Bheri richanyadziswa,","poem":2},{"lineBreak":true},{"text":"Merodhaki richazara nokutya.","poem":2},{"text":"Zvifananidzo zvaro zvichanyadziswa","poem":1},{"text":"uye zvifananidzo zvaro zvichazara nokutya.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rudzi runobva kumusoro rucharirwisa,","poem":1},{"text":"uye ruchaparadza nyika yaro.","poem":2},{"text":"Hakuna munhu achagaramo;","poem":1},{"text":"zvose vanhu nezvipfuwo zvichatizira kure.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mumazuva iwayo, nenguva iyoyo,”","poem":1},{"text":"ndizvo zvinotaura Jehovha,","poem":2},{"text":"“vanhu veIsraeri navanhu veJudha pamwe chete","poem":1},{"text":"vachaenda kundotsvaka Jehovha Mwari wavo vachichema.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vachabvunza nzira inoenda kuZioni,","poem":1},{"text":"vagotendeutsira zviso zvavo kwairi.","poem":2},{"text":"Vachauya vagozvisunga kuna Jehovha,","poem":1},{"text":"nesungano isingaperi isingakanganwiki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Vanhu vangu vanga vari makwai akarasika;","poem":1},{"text":"vafudzi vavo vakavatsausa,","poem":2},{"lineBreak":true},{"text":"uye vakavaita kuti vadzungaire pamusoro pamakomo.","poem":2},{"text":"Vakadzungaira pamusoro pamakomo nezvikomo,","poem":1},{"text":"ndokukanganwa nzvimbo yavo yokuzorora.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani naani akavawana akavadya;","poem":1},{"text":"vavengi vavo vakati, ‘Isu hatina mhosva,","poem":2},{"text":"nokuti vakatadzira Jehovha, iye mafuro avo echokwadi,","poem":1},{"text":"iye Jehovha, tariro yamadzibaba avo.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Tizai mubude muBhabhironi;","poem":1},{"text":"siyai nyika yavaBhabhironi,","poem":2},{"lineBreak":true},{"text":"mugoita sembudzi inotungamirira makwai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuti ndichamutsa Bhabhironi","poem":1},{"text":"uye ndichaisa pamusoro paro ndudzi huru dzakabatana dzinobva kumusoro.","poem":2},{"text":"Vachazvigadzirira kurwa naro,","poem":1},{"text":"uye richakundwa kubva nechokumusoro.","poem":2},{"text":"Miseve yavo ichava semhare pakurwa,","poem":1},{"text":"dzisingadzoki dzisina chadzakabata.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naizvozvo Bhabhironi richapambwa;","poem":1},{"text":"vose vanoripamba vachawana mugove wavo,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nokuda kwokuti munofara nokufarisisa,","poem":1},{"text":"iyemi munopamba nhaka yangu,","poem":2},{"text":"nokuti munokwakuka setsiru rinopura zviyo,","poem":1},{"text":"muchirira samabhiza,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"mai venyu vachanyadziswa kwazvo;","poem":1},{"text":"ivo vakakuberekai vachanyadziswa.","poem":2},{"text":"Vachava mudiki pandudzi, renje,","poem":1},{"text":"nenyika yakaoma, uye gwenga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nokuda kwokutsamwa kwaJehovha hamungagarwi,","poem":1},{"text":"asi richava dongo chose.","poem":2},{"text":"Vose vanopfuura pedyo neBhabhironi vachatyiswa,","poem":1},{"text":"uye vacharidza muridzo nokuda kwamavanga ake ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Mirai panzvimbo dzenyu makakomba Bhabhironi,","poem":1},{"text":"imi mose munowembura uta.","poem":2},{"lineBreak":true},{"text":"Ripfurei! Musasiye kana museve nokuti rakatadzira Jehovha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pururudzai pamusoro pake kumativi ose!","poem":1},{"text":"Rakanda mapfumo pasi, shongwe dzaro dzawa,","poem":2},{"lineBreak":true},{"text":"masvingo aro akoromoka.","poem":2},{"text":"Sezvo kuri kutsiva kwaJehovha,","poem":1},{"text":"tsivai pariri; riitirei sezvarakaitira vamwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bvisai mudyari muBhabhironi,","poem":1},{"text":"nomucheki nejeko rake pakukohwa.","poem":2},{"text":"Nokuda kwomunondo womumanikidzi","poem":1},{"text":"mumwe nomumwe ngaadzokere kuvanhu vake,","poem":2},{"lineBreak":true},{"text":"mumwe nomumwe ngaatizire kunyika yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Israeri makwai akapararira","poem":1},{"text":"akadzingirwa kure neshumba.","poem":2},{"text":"Akatanga kumudya","poem":1},{"text":"akanga ari mambo weAsiria;","poem":2},{"text":"akapedzisira kupwanya mapfupa ake","poem":1},{"text":"ndiNebhukadhinezari mambo weBhabhironi.”","poem":2}]},{"type":"verse","number":18,"content":["Naizvozvo zvanzi naJehovha Wamasimba Ose, Mwari waIsraeri:",{"text":"“Ndicharanga mambo weBhabhironi nenyika yake,","poem":1},{"text":"sokuranga kwandakaita mambo weAsiria.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Asi ndichadzosera Israeri kumafuro ake,","poem":1},{"text":"uye achafura paKarimeri nepaBhashani;","poem":2},{"text":"achadya akaguta","poem":1},{"text":"pazvikomo zveEfuremu neGireadhi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mumazuva iwayo, panguva iyoyo,”","poem":1},{"text":"ndizvo zvinotaura Jehovha,","poem":2},{"text":"“mhaka yaIsraeri ichatsvakwa,","poem":1},{"text":"asi pachange pasina mhosva,","poem":2},{"text":"uye zvivi zveJudha zvichatsvakwa,","poem":1},{"text":"asi hapana chichawanikwa,","poem":2},{"lineBreak":true},{"text":"nokuti ndichakanganwira vakasara vandakasiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Rwisai nyika yeMarataimi","poem":1},{"text":"neavo vagere muPekodhi.","poem":2},{"text":"Dzingirirai, urayai uye muvaparadze zvachose,”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"“Muite zvose zvandakurayirai.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mheremhere yehondo iri munyika,","poem":1},{"text":"mheremhere yokuparadza kukuru!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yavhunika nokupwanyika","poem":1},{"text":"seiko nyundo yenyika yose!","poem":2},{"text":"Bhabhironi rava dongo","poem":1},{"text":"seiko pakati pendudzi!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndakakuisira musungo, iwe Bhabhironi,","poem":1},{"text":"uye wakabatwa usati wazviziva;","poem":2},{"text":"wakawanikwa ukapambwa","poem":1},{"text":"nokuti wakapikisana naJehovha,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Jehovha akazarura dura rezvombo","poem":1},{"text":"ndokubudisa zvombo zvehasha dzake,","poem":2},{"text":"nokuti Ishe Jehovha Wamasimba Ose","poem":1},{"text":"ane basa rokuita munyika yavaBhabhironi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Uyai murwe naro muchibva kure.","poem":1},{"text":"Zarurai matura aro; muriunganidze semirwi yezviyo.","poem":2},{"lineBreak":true},{"text":"Riparadzei zvachose, parege kuva navanosara.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Muuraye hondo diki dzaro dzose;","poem":1},{"text":"ngadziendeswe kundobayiwa! Vane nhamo!","poem":2},{"text":"Nokuti zuva ravo rasvika,","poem":1},{"text":"nguva yokurangwa kwavo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Inzwai vanotiza navapoteri vanobva kuBhabhironi,","poem":1},{"text":"vanoparidza muZioni","poem":2},{"text":"kuti Jehovha Mwari wedu akatsiva sei,","poem":1},{"text":"kutsivira temberi yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Kokerai vapfuri vemiseve varwe neBhabhironi,","poem":1},{"text":"vose vanowembura uta.","poem":2},{"text":"Rikombei rose;","poem":1},{"text":"ngakurege kuva nounopukunyuka.","poem":2},{"text":"Riripirei nokuda kwamabasa avo;","poem":1},{"text":"riitireiwo sezvarakaita.","poem":2},{"text":"Nokuti vakamhura Jehovha,","poem":1},{"text":"Iye Mutsvene weIsraeri.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Naizvozvo majaya aro achawira mumigwagwa;","poem":1},{"text":"varwi varo vose vachanyarara kuti mwiro pazuva iro,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":31,"content":[{"text":"“Tarira, ndinorwa newe, iwe wokuzvikudza,”","poem":1},{"text":"ndizvo zvinotaura Ishe Jehovha Wamasimba Ose,","poem":2},{"text":"“nokuti zuva rako rasvika,","poem":1},{"text":"nguva yokurangwa kwako.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Anozvikudza achagumburwa agowa,","poem":1},{"text":"uye hapana achamusimudza;","poem":2},{"text":"ndichatungidza moto mumaguta ake","poem":1},{"text":"uchapisa vose vakamupoteredza.”","poem":2}]},{"type":"verse","number":33,"content":["Zvanzi naJehovha Wamasimba Ose:",{"text":"“Vanhu veIsraeri vakamanikidzwa,","poem":1},{"text":"navanhu veJudha vakamanikidzwawo,","poem":2},{"text":"vapambi vavo vose vakavabata, zvakasimba,","poem":1},{"text":"vanoramba kuvaregedza kuti vaende.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Asi mudzikinuri wavo ane simba;","poem":1},{"text":"Jehovha Wamasimba Ose ndiro zita rake.","poem":2},{"text":"Achavareverera nhaka yavo","poem":1},{"text":"nesimba kuti azorodze nyika yavo,","poem":2},{"lineBreak":true},{"text":"asi achashayisa zororo kuna avo vanogara muBhabhironi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“Munondo pamusoro pavaBhabhironi!”","poem":1},{"text":"ndizvo zvinotaura Jehovha,","poem":2},{"text":"“pamusoro peavo vagere muBhabhironi,","poem":1},{"text":"napamusoro pamachinda aro navakachenjera varo!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Munondo pamusoro pavaprofita","poem":1},{"text":"varo venhema! Vachava mapenzi.","poem":2},{"text":"Munondo pamusoro pemhare dzaro!","poem":1},{"text":"Vachazadzwa nokutya.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Munondo pamusoro pamabhiza nengoro dzaro,","poem":1},{"text":"napamusoro pavatorwa vose vari pazvigaro zvaro!","poem":2},{"lineBreak":true},{"text":"Vachava vakadzi.","poem":2},{"text":"Munondo pamusoro pepfuma yaro!","poem":1},{"text":"Ichapambwa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Mvura yaro zhinji ngaipwe!","poem":1},{"text":"Ichaoma.","poem":2},{"text":"Nokuti inyika yezvifananidzo,","poem":1},{"text":"zvifananidzo zvichapenga nokutya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Saka mhuka dzomugwenga namapere zvichagarako,","poem":1},{"text":"uye zizi richagara imomo.","poem":2},{"text":"Haichazogarwizve,","poem":1},{"text":"uye hapana achagaramo kusvikira kumarudzi namarudzi.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Sokukoromorwa kwakaitwa Sodhomu neGomora naMwari","poem":1},{"text":"pamwe chete namaguta akavakidzana nawo,”","poem":2},{"text":"ndizvo zvinotaura Jehovha,","poem":4},{"text":"“saizvozvo hakuna achagarako;","poem":1},{"text":"hakuna munhu achagara mairi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Tarirai! Hondo inobva nechokumusoro;","poem":1},{"text":"rudzi rukuru namadzimambo mazhinji","poem":2},{"lineBreak":true},{"text":"ari kumutswa kubva kumagumo enyika.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Vakapakata uta namapfumo;","poem":1},{"text":"vano utsinye uye havana tsitsi.","poem":2},{"text":"Vanotinhira segungwa","poem":1},{"text":"vakatasva mabhiza avo;","poem":2},{"text":"vanouya vakaita savarume vakagadzirira kurwa,","poem":1},{"text":"kuti vakurwise, iwe Mwanasikana weBhabhironi.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Mambo weBhabhironi akanzwa guhu pamusoro pavo,","poem":1},{"text":"maoko ake akapera simba.","poem":2},{"text":"Kutya kwakamubata,","poem":1},{"text":"kurwadziwa sekwomukadzi wosununguka.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Seshumba inouya ichibva mudondo reJorodhani","poem":1},{"text":"ichienda kumafuro akapfuma,","poem":2},{"text":"ndichadzinga Bhabhironi kubva munyika yayo pakarepo.","poem":1},{"text":"Ndianiko akatsaurwa wandichagadza pane izvi?","poem":2},{"text":"Ndiani akaita seni uye ndiani achamisidzana neni?","poem":1},{"text":"Uye ndoupi mufudzi angandidzivisa?”","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Naizvozvo, inzwai zvakarongwa naJehovha pamusoro peBhabhironi,","poem":1},{"text":"zvaakaronga pamusoro penyika yavaBhabhironi:","poem":2},{"text":"Makwayana emapoka avo achakwekweredzerwa kure;","poem":1},{"text":"achaparadza mafuro awo zvachose nokuda kwavo.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Pachanzwikwa kutinhira kwokukundwa kweBhabhironi, nyika ichadedera;","poem":1},{"text":"kuchema kwayo kuchanzwikwa pakati pamarudzi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}