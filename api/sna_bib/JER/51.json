{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["Zvanzi naJehovha:",{"text":"“Tarirai, ndichamutsa mwoyo womuparadzi","poem":1},{"text":"pamusoro peBhabhironi navanhu veRebhi Kamai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichatumira vatorwa kuBhabhironi","poem":1},{"text":"kundorirurudza nokuparadza nyika yaro;","poem":2},{"text":"vacharirwisa kumativi ose, pazuva rokuparara kwaro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Musarega mupfuri achiwembura uta hwake,","poem":1},{"text":"kana kumurega achipfeka nhumbi dzake dzokurwa.","poem":2},{"text":"Regai kunzwira majaya aro tsitsi;","poem":1},{"text":"paradzai hondo yaro zvachose.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vachawira pasi vaurayiwa muBhabhironi,","poem":1},{"text":"vachakuvadzwa mumigwagwa zvokuti havazorarami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nokuti Israeri neJudha havana kuraswa","poem":1},{"text":"naMwari wavo, iye Jehovha Wamasimba Ose,","poem":2},{"text":"kunyange nyika yavo yakazara nemhaka","poem":1},{"text":"pamberi poMutsvene waIsraeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Tizai mubve muBhabhironi!","poem":1},{"text":"Mhanyai muponese upenyu hwenyu!","poem":2},{"lineBreak":true},{"text":"Regai kuparadzwa nokuda kwezvivi zvaro.","poem":2},{"text":"Inguva yokutsiva kwaJehovha;","poem":1},{"text":"iye achariripira zvarinokodzera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bhabhironi rakanga riri mukombe wegoridhe muruoko rwaJehovha;","poem":1},{"text":"rakadhakisa nyika yose.","poem":2},{"text":"Ndudzi dzakanwa waini yaro;","poem":1},{"text":"naizvozvo dzava kupenga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bhabhironi richawa pakarepo rigoondomoka.","poem":1},{"text":"Ungudzai pamusoro paro!","poem":2},{"text":"Torai muti webharisamu murape kurwadziwa kwaro;","poem":1},{"text":"zvimwe ringaporeswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ ‘Taida kuporesa Bhabhironi,","poem":1},{"text":"asi haringaporeswi;","poem":2},{"text":"ngatirisiyei mumwe nomumwe aende kunyika yake,","poem":1},{"text":"nokuti kutongwa kwaro kunosvika kumatenga,","poem":2},{"lineBreak":true},{"text":"kunokwira kusvikira kumakore.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Jehovha akati hatina mhosva;","poem":1},{"text":"uyai, tiparidze muZioni","poem":2},{"lineBreak":true},{"text":"zvakaitwa naJehovha Mwari wedu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Rodzai miseve,","poem":1},{"text":"torai nhoo!","poem":2},{"text":"Jehovha akamutsa madzimambo avaMedhia,","poem":1},{"text":"nokuti akaronga kuparadza Bhabhironi.","poem":2},{"text":"Jehovha achatsiva,","poem":1},{"text":"kutsivira temberi yake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Simudzai mureza pamusoro pamasvingo eBhabhironi!","poem":1},{"text":"Simbisai varindi,","poem":2},{"text":"isai nharirire panzvimbo dzavo,","poem":1},{"text":"gadzirirai vanovandira.","poem":2},{"text":"Jehovha achaita zvaakaronga,","poem":1},{"text":"zvaakatema pamusoro pavanhu veBhabhironi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Imi mugere pedyo nemvura zhinji","poem":1},{"text":"uye makapfuma kwazvo,","poem":2},{"text":"magumo enyu asvika,","poem":1},{"text":"nguva yokuti muparadzwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jehovha Wamasimba Ose akapika naiye amene achiti:","poem":1},{"text":"Zvirokwazvo ndichakuzadza navarume, sezvinoitwa nechimokoto chemhashu,","poem":2},{"lineBreak":true},{"text":"uye vachapembera nokuti vanenge vakukundai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Akaita nyika nesimba rake;","poem":1},{"text":"akateya nheyo dzenyika nouchenjeri hwake,","poem":2},{"lineBreak":true},{"text":"akatatamura matenga nokunzwisisa kwake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Paanotinhira, mvura yomumatenga inotinhira;","poem":1},{"text":"anokwidza makore kubva kumigumo yenyika.","poem":2},{"text":"Anotuma mheni pamwe chete nemvura,","poem":1},{"text":"uye anouyisa mhepo kubva mumatura ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Munhu mumwe nomumwe haana pfungwa uye haana zivo;","poem":1},{"text":"mupfuri mumwe nomumwe wesimbi anonyadziswa nezvifananidzo zvake.","poem":2},{"text":"Zvifananidzo zvake ndezvenhema;","poem":1},{"text":"hazvina mweya mazviri.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hazvina maturo, zvinhu zvinosekwa;","poem":1},{"text":"kana kutongwa kwazvo kwasvika, zvichaparadzwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iye Mugove waJakobho haana kufanana naizvozvi,","poem":1},{"text":"nokuti ndiye Muiti wezvinhu zvose,","poem":2},{"text":"pamwe chete norudzi rwenhaka yake,","poem":1},{"text":"Jehovha Wamasimba Ose ndiro zita rake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ndiwe tsvimbo yangu yehondo,","poem":1},{"text":"chombo changu chokurwa,","poem":2},{"text":"newe ndinoparadza ndudzi,","poem":1},{"text":"newe ndinoparadza umambo,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"newe ndinoparadza bhiza nomutasvi,","poem":1},{"text":"newe ndinoparadza ngoro nomuchairi,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"newe ndinoparadza murume nomukadzi,","poem":1},{"text":"newe ndinoparadza mutana nejaya,","poem":2},{"lineBreak":true},{"text":"newe ndinoparadza jaya nomurandakadzi,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"newe ndinoparadza mufudzi neboka,","poem":1},{"text":"newe ndinoparadza murimi nenzombe,","poem":2},{"lineBreak":true},{"text":"newe ndinoparadza vatongi namachinda.","poem":2}]},{"type":"verse","number":24,"content":["“Ndicharipira Bhabhironi navose vagere muBhabhironi pamberi pako, nokuda kwezvakaipa zvavakaita muZioni,” ndizvo zvinotaura Jehovha."]},{"type":"verse","number":25,"content":[{"text":"“Ndine mhosva newe, iwe gomo rinoparadza,","poem":1},{"text":"iwe unoparadza nyika yose,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"“Ndichatambanudzira ruoko rwangu kuti ndikurwise,","poem":1},{"text":"ndigokukungurusira kumawere,","poem":2},{"lineBreak":true},{"text":"ndigokuita gomo rakatsva.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hapana dombo richabviswa kwauri kuti riitwe dombo rekona,","poem":1},{"text":"kana dombo remhepo,","poem":2},{"lineBreak":true},{"text":"nokuti uchaparadzwa nokusingaperi,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Simudzai mureza munyika!","poem":1},{"text":"Ridzai hwamanda pakati pendudzi!","poem":2},{"text":"Gadzirirai ndudzi kuti dzizorwa naye;","poem":1},{"text":"kokai ushe uhu kuzorwa naye:","poem":2},{"lineBreak":true},{"text":"Ararati, Mini neAshikenazi.","poem":2},{"text":"Gadzai mukuru wehondo kuti arwe naye;","poem":1},{"text":"tumirai mabhiza akaita sechimokoto chemhashu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Gadzirirai ndudzi kuti dzizorwa naye,","poem":1},{"text":"madzimambo avaMedhia,","poem":2},{"text":"vabati vavo namachinda avo ose,","poem":1},{"text":"nenyika dzose dzavanotonga.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nyika inodedera uye yomonyoroka,","poem":1},{"text":"nokuti zvakarongwa naJehovha pamusoro peBhabhironi hazvingatongokoni,","poem":2},{"text":"zvokuparadza nyika yeBhabhironi","poem":1},{"text":"kuti pasava nomunhu achagaramo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mhare dzeBhabhironi dzarega kurwa;","poem":1},{"text":"vakarambira munhare dzavo.","poem":2},{"text":"Simba ravo rapera;","poem":1},{"text":"vaita savakadzi.","poem":2},{"text":"Ugaro hwake hwakapiswa nomoto;","poem":1},{"text":"mazariro amasuo ake avhunika.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Anotumwa namagwaro achatevera mumwe,","poem":1},{"text":"uye nhume ichatevera nhume,","poem":2},{"text":"kundozivisa mambo weBhabhironi","poem":1},{"text":"kuti guta rake rose rapambwa,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"mazambuko abatwa,","poem":1},{"text":"mapani apiswa nomoto,","poem":2},{"lineBreak":true},{"text":"uye varwi vavhundutswa.”","poem":2}]},{"type":"verse","number":33,"content":["Zvanzi naJehovha Wamasimba Ose, Mwari waIsraeri:",{"text":"“Mwanasikana weBhabhironi afanana neburiro","poem":1},{"text":"panguva yokupura;","poem":2},{"lineBreak":true},{"text":"nguva yokumukohwa ichasvika zvino zvino.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Nebhukadhinezari mambo weBhabhironi akatidya,","poem":1},{"text":"akatinyonganisa,","poem":2},{"lineBreak":true},{"text":"akatiita chirongo chisina chinhu.","poem":2},{"text":"Akatimedza senyoka,","poem":1},{"text":"uye akazadza dumbu rake nezvinonaka zvedu,","poem":2},{"lineBreak":true},{"text":"mushure maizvozvo akatisvipa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Zvechisimba zvakaitwa panyama yedu ngazvive pamusoro peBhabhironi,”","poem":1},{"text":"ndizvo zvinotaura vanhu vomuZioni.","poem":2},{"text":"Jerusarema rinoti:","poem":1},{"text":"“Ropa redu ngarive pamusoro peavo vanogara muBhabhironi.”","poem":2}]},{"type":"verse","number":36,"content":["Naizvozvo, zvanzi naJehovha:",{"text":"“Tarirai, ndichakurevererai mhaka yenyu","poem":1},{"text":"uye ndichakutsivirai;","poem":2},{"text":"ndichapwisa gungwa raro,","poem":1},{"text":"ndichapwisa matsime aro.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Bhabhironi richava murwi wamatombo,","poem":1},{"text":"ugaro hwamakava,","poem":2},{"text":"chinhu chinotyisa nechinosekesa,","poem":1},{"text":"nzvimbo isina anogaramo.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Vanhu vake vose vanoomba seshumba diki,","poem":1},{"text":"vanobhonʼa sembwanana dzeshumba.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Asi kana vamutswa,","poem":1},{"text":"ndichavagadzirira mutambo","poem":2},{"lineBreak":true},{"text":"ndigovadhakisa,","poem":2},{"text":"kuitira kuti varidze mhere yokuseka,","poem":1},{"text":"vagovata nokusingaperi uye varege kumuka,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":40,"content":[{"text":"“Ndichavaburutsa pasi","poem":1},{"text":"semakwayana ari kundourayiwa,","poem":2},{"lineBreak":true},{"text":"semakondobwe nembudzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Haiwa, Sheshaki richakundwa sei,","poem":1},{"text":"kuzvirumbidza kwenyika yose kwabatwa!","poem":2},{"text":"Bhabhironi rava dongo sei","poem":1},{"text":"pakati pendudzi!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Gungwa richakwira pamusoro peBhabhironi;","poem":1},{"text":"mafungu aro anovirima acharifukidza.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Maguta aro achaparadzwa,","poem":1},{"text":"achava nyika yakaoma negwenga,","poem":2},{"text":"nyika isingagarwi nomunhu,","poem":1},{"text":"isina angapfuura nemairi.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ndicharanga Bheri muBhabhironi","poem":1},{"text":"ndigomuita kuti asvipe zvaamedza.","poem":2},{"text":"Ndudzi hadzichazomhanyiri kwaari.","poem":1},{"text":"Uye rusvingo rweBhabhironi ruchawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Budai mariri, imi vanhu vangu!","poem":1},{"text":"Tizai kuti muponese upenyu hwenyu!","poem":2},{"lineBreak":true},{"text":"Tizai mubve pakutsamwa kunotyisa kwaJehovha.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Regai kuora mwoyo kana kutya","poem":1},{"text":"panotekeshera, runyerekupe munyika;","poem":2},{"text":"rumwe runyerekupe runonzwika gore rino, rumwe gore rinouya,","poem":1},{"text":"runyerekupe rwokurwisana munyika","poem":2},{"lineBreak":true},{"text":"uye rwomutongi achirwa nomumwe mutongi.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Nokuti zvirokwazvo nguva ichasvika","poem":1},{"text":"yandichatonga zvifananidzo zveBhabhironi;","poem":2},{"text":"nyika yaro yose ichanyadziswa,","poem":1},{"text":"uye vakaurayiwa varo vachawira pasi vose mukati maro.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ipapo denga nenyika nezvose zviri mazviri","poem":1},{"text":"zvichapembera nomufaro pamusoro peBhabhironi,","poem":2},{"text":"nokuti vachabva nechokumusoro","poem":1},{"text":"vaparadzi vacharirwisa,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“Bhabhironi rinofanira kuwa nokuda kwavakaurayiwa vaIsraeri,","poem":1},{"text":"sezvakaita vakaurayiwa venyika yose","poem":2},{"lineBreak":true},{"text":"vakawa nokuda kweBhabhironi.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Imi makapunyuka pamunondo,","poem":1},{"text":"endai uye musamira-mira!","poem":2},{"text":"Murangarire Jehovha munyika iri kure,","poem":1},{"text":"uye murangarire Jerusarema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“Takanyadziswa,","poem":1},{"text":"nokuti takatukwa","poem":2},{"lineBreak":true},{"text":"uye nyadzi dzinofukidza zviso zvedu,","poem":2},{"text":"nokuti vatorwa vakapinda","poem":1},{"text":"munzvimbo tsvene dzeimba yaJehovha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"“Asi mazuva anouya,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"“andichatonga zvifananidzo zvaro,","poem":2},{"text":"uye munyika yake yose","poem":1},{"text":"vakakuvara vachagomera.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Kunyange dai Bhabhironi rikasvika kudenga,","poem":1},{"text":"uye rikasimbisa nhare yaro yakareba,","poem":2},{"lineBreak":true},{"text":"ndichatumira vaparadzi kuzorirwisa,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“Inzwi rokuchema rinobva kuBhabhironi,","poem":1},{"text":"inzwi rokuparadza kukuru","poem":2},{"lineBreak":true},{"text":"rinobva kunyika yavaBhabhironi.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Jehovha achaparadza Bhabhironi;","poem":1},{"text":"achanyaradza ruzha rwokunyongana kwaro.","poem":2},{"text":"Mafungu avavengi achaomba semvura zhinji;","poem":1},{"text":"kutinhira kwamanzwi avo kuchanzwikwa.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Muparadzi achauya kuzorwisa Bhabhironi;","poem":1},{"text":"varwi varo vachabatwa,","poem":2},{"lineBreak":true},{"text":"uye uta hwavo huchavhunwa.","poem":2},{"text":"Nokuti Jehovha ndiMwari wokutsiva;","poem":1},{"text":"achatsiva zvizere.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Ndichaita kuti machinda ake navakachenjera vake vadhakwe,","poem":1},{"text":"vabati, namachinda uye navarwi vakewo;","poem":2},{"text":"vachavata nokusingaperi uye havangamuki,”","poem":1},{"text":"ndizvo zvinotaura Mambo, ane zita rinonzi Jehovha Wamasimba Ose.","poem":2}]},{"type":"verse","number":58,"content":["Zvanzi naJehovha Wamasimba Ose:",{"text":"“Masvingo makobvu eBhabhironi achaparadzwa,","poem":1},{"text":"uye masuo aro akakwirira achapiswa;","poem":2},{"text":"vanhu vanongozvinetsa pasina,","poem":1},{"text":"mabasa endudzi ihuni dzomurazvo bedzi.”","poem":2}]},{"type":"verse","number":59,"content":["Iri ndiro shoko rakapiwa naJeremia kumuchinda Seraya mwanakomana waNeria, mwanakomana waMaseya, paakaenda kuBhabhironi naZedhekia mambo weJudha mugore rechina rokutonga kwake."]},{"type":"verse","number":60,"content":["Jeremia akanga anyora murugwaro pamusoro penjodzi dzose dzaizouya pamusoro peBhabhironi, zvose zvakanga zvakanyorwa pamusoro peBhabhironi."]},{"type":"verse","number":61,"content":["Akati kuna Seraya, “Paunosvika kuBhabhironi, uone kuti waverenga mashoko ose aya uchidanidzirisa."]},{"type":"verse","number":62,"content":["Ipapo uti, ‘Haiwa Jehovha, makati muchaparadza nzvimbo ino, zvokuti hakuna munhu kana zvipfuwo zvingagaramo; ichaparadzwa nokusingaperi.’"]},{"type":"verse","number":63,"content":["Paunopedza kuverenga rugwaro urwu, sungira ibwe parwuri ugorukanda muna Yufuratesi."]},{"type":"verse","number":64,"content":["Ipapo uti, ‘Saizvozvo Bhabhironi richanyura rikasazomukazve nokuda kwenjodzi yandichauyisa pamusoro paro. Uye vanhu varo vachawa.’ ” Mashoko aJeremia anogumira pano."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}