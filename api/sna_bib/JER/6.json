{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Kukombwa kweJerusarema"]},{"type":"verse","number":1,"content":[{"text":"“Tizai kuti murarame, imi vana veBhenjamini!","poem":1},{"text":"Tizai mubve muJerusarema!","poem":2},{"text":"Ridzai hwamanda muTekoa!","poem":1},{"text":"Simudzai chiratidzo pamusoro peBheti Hakeremu!","poem":2},{"text":"Nokuti njodzi yava pedyo ichibva kumusoro,","poem":1},{"text":"iko kuparadza kwakaipisisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichaparadza mwanasikana weZioni,","poem":1},{"text":"akanakisa uye anoyevedza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vafudzi namapoka amakwai avo vachauya kuzomurwisa;","poem":1},{"text":"vachadzika matende avo vakamukomba,","poem":2},{"lineBreak":true},{"text":"mumwe nomumwe achifudza chikamu chake.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gadzirirai kurwa naye!","poem":1},{"text":"Simukai, ngatimurwisei masikati!","poem":2},{"text":"“Asi, yowe-e, zuva rovira,","poem":1},{"text":"uye mimvuri yamadekwana yoreba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naizvozvo simukai, ngatimurwisei usiku,","poem":1},{"text":"uye tiparadze nhare dzake!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Zvanzi naJehovha Wamasimba Ose:","poem":1},{"lineBreak":true},{"text":"“Temerai miti pasi,","poem":1},{"text":"mugovakira Jerusarema mirwi yokurikomba.","poem":2},{"text":"Guta iri rinofanira kurangwa;","poem":1},{"text":"rizere nokumanikidza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Setsime rinoeredza mvura yaro,","poem":1},{"text":"saizvozvo Jerusarema rinodurura zvakaipa zvaro.","poem":2},{"text":"Kuita nechisimba nokuparadza zvinonzwikwa mariri,","poem":1},{"text":"kurwara kwaro namavanga zvinoramba zviri pamberi pangu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inzwa yambiro, iwe Jerusarema,","poem":1},{"text":"kuti ndisakufuratira","poem":2},{"text":"ndikaita nyika yako dongo,","poem":1},{"text":"kuti isava nomunhu angagara mairi.”","poem":2}]},{"type":"verse","number":9,"content":["Zvanzi naJehovha Wamasimba Ose:",{"text":"“Ngavatanhe zvakasara zvaIsraeri","poem":1},{"text":"vatanhe zvachose samazambiringa;","poem":2},{"text":"utambanudzirezve ruoko rwako kumatavi,","poem":1},{"text":"sezvinoita munhu anounganidza mazambiringa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndingataura naaniko wandingayambira?","poem":1},{"text":"Ndianiko achandinzwa?","poem":2},{"text":"Nzeve dzavo dzakadzivirwa","poem":1},{"text":"kuti varege kunzwa.","poem":2},{"text":"Shoko raJehovha chigumbuso kwavari;","poem":1},{"text":"havawani mufaro mariri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asi ini ndizere nehasha dzaJehovha,","poem":1},{"text":"uye handichagoni kuzvidzora.","poem":2},{"lineBreak":true},{"text":"“Dzidururire pamusoro pavana vari munzira dzomuguta,","poem":1},{"text":"napamusoro pamajaya akaungana pamwe chete;","poem":2},{"text":"zvose murume nomukadzi vachabatwa imomo,","poem":1},{"text":"navatana, vaya vabva zera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dzimba dzavo dzichapiwa vamwe,","poem":1},{"text":"minda yavo pamwe chete navakadzi vavo,","poem":2},{"lineBreak":true},{"text":"pandichatambanudza ruoko rwangu pamusoro pavagere panyika,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"“Kubva kumudiki kusvikira kuvakuru,","poem":1},{"text":"vose vanokarira pfuma;","poem":2},{"text":"vaprofita navaprista zvimwe chetezvo,","poem":1},{"text":"vose vanoita zvokunyengera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vanosunga ronda ravanhu vangu","poem":1},{"text":"sokunge vasina kukuvara zvikuru.","poem":2},{"text":"Vanoti, ‘Rugare, rugare,’","poem":1},{"text":"ipo pasina rugare.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ko, vanonyadziswa nokusemesa kwamafambiro avo here?","poem":1},{"text":"Kwete, havana nyadzi zvachose;","poem":2},{"lineBreak":true},{"text":"havambozivi kuratidza nyadzi.","poem":2},{"text":"Naizvozvo vachawira pakati pavakawa;","poem":1},{"text":"vachadzikiswa pandichavaranga,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":16,"content":["Zvanzi naJehovha:",{"text":"“Mirai pamharadzano dzenzira muone;","poem":1},{"text":"mubvunze nzira dzekare,","poem":2},{"text":"mubvunze kune nzira yakanaka, mugofamba mairi,","poem":1},{"text":"ipapo muchawana zororo remweya yenyu.","poem":2},{"lineBreak":true},{"text":"Asi imi makati, ‘Hatizofambi mairi.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndakagadza nharirire pamusoro penyu ndikati,","poem":1},{"text":"‘Teererai inzwi rehwamanda!’","poem":2},{"lineBreak":true},{"text":"Asi imi makati, ‘Hatizoteereri.’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naizvozvo inzwai, imi ndudzi,","poem":1},{"text":"nemi zvapupu,","poem":2},{"lineBreak":true},{"text":"cherechedzai zvichaitika kwavari.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Inzwa, iwe nyika:","poem":1},{"lineBreak":true},{"text":"Ndiri kuuyisa njodzi pamusoro pavanhu ava,","poem":1},{"text":"icho chibereko chendangariro dzavo,","poem":2},{"text":"nokuti havana kuteerera mashoko angu,","poem":1},{"text":"uye vakaramba murayiro wangu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndine hanya yeiko nezvinonhuhwira zvinobva kuShebha,","poem":1},{"text":"kana karamisi inotapira inobva kunyika iri kure?","poem":2},{"text":"Zvipiriso zvenyu zvinopiswa handizvidi;","poem":1},{"text":"zvibayiro zvenyu hazvindifadzi.”","poem":2}]},{"type":"verse","number":21,"content":["Naizvozvo zvanzi naJehovha:",{"text":"“Ndichaisa zvipinganidzo pamberi pavanhu ava.","poem":1},{"text":"Madzibaba navanakomana vachagumburwa nazvo pamwe chete,","poem":2},{"lineBreak":true},{"text":"vavakidzani neshamwari vachaparara.”","poem":2}]},{"type":"verse","number":22,"content":["Zvanzi naJehovha:",{"text":"“Tarirai, hondo iri kuuya","poem":1},{"text":"kubva kunyika yokumusoro;","poem":2},{"text":"rudzi rukuru rwuri kumutswa","poem":1},{"text":"kubva kumigumo yenyika.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Vakapakata uta nepfumo;","poem":1},{"text":"vane utsinye uye havana ngoni.","poem":2},{"text":"Vanonzwikwa sokutinhira kwegungwa","poem":1},{"text":"vakatasva mabhiza avo;","poem":2},{"lineBreak":true},{"text":"vari kuuya savanhu vazvigadzirira kurwa hondo","poem":2},{"lineBreak":true},{"text":"kuti vakurwise, iwe Mwanasikana weZioni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Takanzwa guhu ravo,","poem":1},{"text":"uye maoko edu oshayiwa simba.","poem":2},{"text":"Tabatwa nokurwadziwa,","poem":1},{"text":"kurwadziwa kwakaita sekwomukadzi ari kusununguka.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Regai kuenda kumunda,","poem":1},{"text":"kana kufamba mumigwagwa,","poem":2},{"text":"nokuti muvengi ane munondo,","poem":1},{"text":"uye kumativi ose kune zvinotyisa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Haiwa, vanhu vangu, pfekai masaga","poem":1},{"text":"mugoumburuka mumadota;","poem":2},{"text":"chemai nokuchema kukuru kwazvo","poem":1},{"text":"kunge munochemera mwanakomana mumwe chete,","poem":2},{"text":"nokuti muparadzi","poem":1},{"text":"achatiwira pakarepo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Ndakakuita muedzi wamatare","poem":1},{"text":"navanhu vangu mhangura,","poem":2},{"text":"kuti ucherechedze","poem":1},{"text":"uye uedze nzira dzavo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Vose vamukiri vakaoma mwoyo,","poem":1},{"text":"vanongofamba-famba vachiita makuhwa.","poem":2},{"text":"Ivo indarira nesimbi;","poem":1},{"text":"vose vanoita zvakaora.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mvuto inovhutira zvinotyisa","poem":1},{"text":"kuti ipise mutobvu nomoto,","poem":2},{"text":"asi kunatswa kunongova pasina;","poem":1},{"text":"nokuti vakaipa havasi kubviswa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Vanonzi sirivha yakarambwa,","poem":1},{"text":"nokuti Jehovha akavaramba.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}