{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["“ ‘Panguva iyoyo, ndizvo zvinotaura Jehovha, mapfupa amadzimambo namachinda eJudha, namapfupa avaprista navaprofita, uye mapfupa avanhu veJerusarema, achabviswa kubva mumakuva avo."]},{"type":"verse","number":2,"content":["Achava pamhene agorohwa nezuva uye achavhenekwa nomwedzi nenyeredzi dzose dzedenga, zvavakada vakazvishumira vakazvitevera uye vakabvunza kwazviri, vakazvinamata. Haangaunganidzwi kana kuvigwa, asi achafanana nomupfudze uri panyika."]},{"type":"verse","number":3,"content":["Kwose zvako kwandichavadzingira, vakasara vose vorudzi urwu rwakaipa, vachademba rufu pachinzvimbo choupenyu, ndizvo zvinotaura Jehovha Wamasimba Ose.’"]},{"type":"heading","content":["Chivi noKurangwa"]},{"type":"verse","number":4,"content":["“Uti kwavari, ‘Zvanzi naJehovha:",{"text":"“ ‘Vanhu pavanowira pasi, havamukizve here?","poem":1},{"text":"Munhu akange ambotsauka, haadzokizve here?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvino nemhaka yei ava vadzokera shure?","poem":1},{"text":"Nemhaka yei Jerusarema richingogara richitsauka?","poem":2},{"text":"Vanobatirira pakunyengera,","poem":1},{"text":"vanoramba kudzoka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndakanyatsoteereresa,","poem":1},{"text":"asi ivo havambotauri zvakarurama.","poem":2},{"text":"Hakuna anotendeuka pane zvakaipa zvake achiti,","poem":1},{"text":"“Ndaiteiko?”","poem":2},{"text":"Mumwe nomumwe anongotevedza nzira yake","poem":1},{"text":"sebhiza rinomhanyira kurwa hondo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kunyange shohori riri mudenga","poem":1},{"text":"rinoziva nguva dzaro dzakatarwa,","poem":2},{"text":"uye njiva, nenyenganyenga nekondo","poem":1},{"text":"zvinocherechedza nguva yazvo yokutama.","poem":2},{"text":"Asi vanhu vangu havazivi","poem":1},{"text":"zvinodikanwa naJehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Munoreva seiko muchiti, “Takachenjera,","poem":1},{"text":"nokuti tino murayiro waJehovha,”","poem":2},{"text":"asi zvirokwazvo chinyoreso chenhema chavanyori","poem":1},{"text":"chakanyora nhema?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vakachenjera vachanyadziswa,","poem":1},{"text":"vachavhunduka uye vachabatwa.","poem":2},{"text":"Sezvo vakaramba shoko raJehovha,","poem":1},{"text":"kuchenjera kwavanako kwakadiniko?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naizvozvo ndichapa vakadzi vavo kuna vamwe varume,","poem":1},{"text":"neminda yavo kuvaridzi vatsva.","poem":2},{"text":"Kubva kumuduku kusvikira kumukuru vose","poem":1},{"text":"vanokarira pfuma;","poem":2},{"text":"vaprofita navaprista saizvozvo,","poem":1},{"text":"vose vanoita nokunyengera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vanosunga vanga ravanhu vangu","poem":1},{"text":"sokunge duku duku.","poem":2},{"text":"Vanoti, “Rugare, rugare,”","poem":1},{"text":"ipo pasina rugare.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ko, vanonyadziswa netsika dzavo dzinonyangadza here?","poem":1},{"text":"Kwete, havana kana nyadzi zvachose;","poem":2},{"lineBreak":true},{"text":"havambozivi kuti zvinonyadzisa sei.","poem":2},{"text":"Saka vachawa pakati pavakawa;","poem":1},{"text":"vachaderedzwa pavacharangwa,","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ ‘Ndichavatorera zvavakakohwa,","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":4},{"text":"Hapangazovi namazambiringa pamuzambiringa.","poem":2},{"text":"Hakungazovi namaonde pamuti womuonde,","poem":1},{"text":"uye mashizha azvo achaoma.","poem":2},{"text":"Zvandakavapa","poem":1},{"text":"vachazvitorerwa.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ko, takagarireiko pano?","poem":1},{"text":"Unganai pamwe chete!","poem":2},{"text":"Ngatitizirei kumaguta akakomberedzwa","poem":1},{"text":"tindofira ikoko!","poem":2},{"text":"Nokuti Jehovha Mwari wedu atitongera kufa,","poem":1},{"text":"nokuti akatipa mvura ino muchetura kuti tinwe,","poem":2},{"lineBreak":true},{"text":"nokuti takamutadzira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Takanga takatarisira rugare","poem":1},{"text":"asi hakuna chakanaka chakauya;","poem":2},{"text":"takatarisira kuporeswa","poem":1},{"text":"asi paingova nokuvhundutswa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kufemedzeka kwamabhiza omuvengi","poem":1},{"text":"kunonzwika kuchibva kuDhani;","poem":2},{"text":"panorira makono awo","poem":1},{"text":"nyika yose inodedera.","poem":2},{"text":"Auya kuzoparadza","poem":1},{"text":"nyika nezvose zviri mairi,","poem":2},{"lineBreak":true},{"text":"guta navose vanogara imomo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Tarirai ndichatumira nyoka dzino uturu pakati penyu,","poem":1},{"text":"mvumbi dzicharamba kuimbirwa,","poem":2},{"lineBreak":true},{"text":"uye dzichakurumai,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Haiwa, Munyaradzi wangu, pakuchema kwangu,","poem":1},{"text":"mwoyo wangu woziya mukati mangu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Inzwai kuchema kwavanhu vangu","poem":1},{"text":"kunobva kunyika iri kure kure:","poem":2},{"text":"“Ko, Jehovha haazi muZioni here?","poem":1},{"text":"Mambo waro haachimo here?”","poem":2},{"lineBreak":true},{"text":"“Vakanditsamwisireiko nezvifananidzo zvavo,","poem":1},{"text":"nezvifananidzo zvavo zvavatorwa zvisingabatsiri?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Kucheka kwapfuura,","poem":1},{"text":"zhizha rapera,","poem":2},{"lineBreak":true},{"text":"asi tigere kuponeswa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Sezvo vanhu vangu vapwanyiwa, neniwo ndapwanyiwa;","poem":1},{"text":"ndiri kuchema, uye ndiri kutya zvikuru.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ko, muGireadhi hamuna muti webharisamu here?","poem":1},{"text":"Hakuna murapi ikoko here?","poem":2},{"text":"Seiko zvino ronda","poem":1},{"text":"ravanhu vangu risina kurapwa?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}