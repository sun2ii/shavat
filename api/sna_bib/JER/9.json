{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JER","translationId":"sna_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"5eea389a402998b8fd6364c627f3399228109a0cd77d2fa7e01d2ca6b4cc25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sna_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Haiwa, dai musoro wangu waiva chitubu chemvura","poem":1},{"text":"uye meso angu riri tsime remisodzi!","poem":2},{"text":"Ndingadai ndaichema masikati nousiku","poem":1},{"text":"nokuda kwavakaurayiwa vavanhu vangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haiwa, dai ndaiva nenzvimbo","poem":1},{"text":"mugwenga yokugara yavafambi,","poem":2},{"text":"kuitira kuti ndisiye vanhu vangu","poem":1},{"text":"ndiende kure navo;","poem":2},{"text":"nokuti vose imhombwe,","poem":1},{"text":"ungano yavanhu vasina kutendeka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Vanokunga rurimi rwavo souta,","poem":1},{"text":"kuti vapfure nhema;","poem":2},{"text":"havaiti nechokwadi","poem":1},{"text":"pakukunda kwavanoita munyika.","poem":2},{"text":"Vanobva pane chimwe chivi vachienda pane chimwe;","poem":1},{"text":"havandizivi ini,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"“Chenjererai shamwari dzenyu;","poem":1},{"text":"musavimba nehama dzenyu.","poem":2},{"text":"Nokuti hama ipi neipi inonyengera,","poem":1},{"text":"uye shamwari ipi neipi inoita makuhwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Shamwari inonyengera shamwari,","poem":1},{"text":"uye hakuna anotaura chokwadi.","poem":2},{"text":"Vakadzidzisa ndimi dzavo kureva nhema;","poem":1},{"text":"vanozvinetsa nokuita zvakaipa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Munogara pakati pounyengeri;","poem":1},{"text":"mukunyengera kwavo vanoramba kundiziva ini,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":7,"content":["Naizvozvo zvanzi naJehovha Wamasimba Ose:",{"text":"“Tarirai, ndichavanatsa","poem":1},{"text":"uye ndichavaedza, ndechipi chimwe chandingaita","poem":2},{"lineBreak":true},{"text":"nokuda kwechivi chavanhu vangu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Rurimi rwavo museve unouraya;","poem":1},{"text":"runotaura nokunyengera.","poem":2},{"text":"Nomuromo wake mumwe nomumwe anotaura zvakanaka kune wokwake,","poem":1},{"text":"asi mumwoyo make anomuteyera musungo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ko, handigavarangi nokuda kwechinhu ichi here?”","poem":1},{"text":"ndizvo zvinotaura Jehovha.","poem":2},{"text":"“Ko, handingazvitsiviri","poem":1},{"text":"pamusoro porudzi rwakadai here?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndichachema uye ndichaungudza nokuda kwamakomo,","poem":1},{"text":"uye ndichachema pamusoro pamafuro egwenga.","poem":2},{"text":"Aparara uye hakuna anofambako,","poem":1},{"text":"uye kukuma kwemombe hakunzwiki.","poem":2},{"text":"Shiri dzedenga dzatiza,","poem":1},{"text":"uye mhuka dzaenda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ndichaita Jerusarema murwi wedongo,","poem":1},{"text":"panogara makava;","poem":2},{"text":"uye ndichaparadza maguta eJudha,","poem":1},{"text":"kuti kurege kuva nomunhu anogarako.”","poem":2}]},{"type":"verse","number":12,"content":["Ndoupiko munhu akachenjera zvokuti anganzwisisa izvi? Ndianiko akarayirwa naJehovha uye angatsanangura izvi? Nemhaka yeiko nyika yanyangadzwa yava dongo ikafanana negwenga risina angapfuura nomo?"]},{"type":"verse","number":13,"content":["Jehovha akati, “Nemhaka yokuti vakasiya murayiro wangu, wandakaisa pamberi pavo, havana kunditeerera kana kutevera murayiro wangu."]},{"type":"verse","number":14,"content":["Asi, vakatevera kusindimara kwemwoyo yavo; vakatevera vanaBhaari, sezvavakadzidziswa namadzibaba avo.”"]},{"type":"verse","number":15,"content":["Naizvozvo zvanzi naJehovha Wamasimba Ose, Mwari weIsraeri, “Tarirai ndichaita kuti vanhu ava vadye zvinovava uye kuti vanwe mvura ino muchetura."]},{"type":"verse","number":16,"content":["Ndichavaparadzira pakati pendudzi dzavasina kumboziva uye dzisina kumbozivikanwa namadzibaba avo, uye ndichavatevera nomunondo kusvikira ndavaparadza.”"]},{"type":"verse","number":17,"content":["Zvanzi naJehovha Wamasimba Ose:",{"text":"“Rangarirai zvino! Danai vakadzi vanochema vauye;","poem":1},{"text":"danai vanogonesesa pakati pavo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngavakurumidze kuuya","poem":1},{"text":"vagochema pamusoro pedu","poem":2},{"text":"kusvikira maziso edu ayerera misodzi,","poem":1},{"text":"nzizi dzoyerera mumaziso edu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Maungira okuchema anonzwika kubva kuZioni achiti:","poem":1},{"text":"‘Haiwa taparadzwa sei!","poem":2},{"lineBreak":true},{"text":"Haiwa kunyadziswa kwedu kukuru sei!","poem":2},{"text":"Tinofanira kusiya nyika yedu","poem":1},{"text":"nokuti dzimba dzedu dzava matongo.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Zvino, imi vakadzi, inzwai shoko raJehovha;","poem":1},{"text":"dziurai nzeve dzenyu dzinzwe mashoko omuromo wake.","poem":2},{"text":"Dzidzisai vanasikana venyu kuungudza;","poem":1},{"text":"dzidzisanai kuchema.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Rufu rwakapinda napamawindo edu","poem":1},{"text":"uye rwapinda munhare dzedu;","poem":2},{"text":"rwauraya vana mumigwagwa","poem":1},{"text":"namajaya ari munzira dzeguta.","poem":2}]},{"type":"verse","number":22,"content":["Uti, “Zvanzi naJehovha:",{"text":"“ ‘Zvitunha zvavanhu zvichavata","poem":1},{"text":"somupfudze uri pamusoro pomunda,","poem":2},{"text":"sezviyo zvakachekwa shure kwavacheki,","poem":1},{"text":"zvisina achazviunganidza.’ ”","poem":2}]},{"type":"verse","number":23,"content":["Zvanzi naJehovha:",{"text":"“Akachenjera ngaarege kuzvirumbidza pamusoro penjere dzake,","poem":1},{"text":"kana munhu ane simba pamusoro pesimba rake,","poem":2},{"lineBreak":true},{"text":"kana akapfuma pamusoro pepfuma yake,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Asi anozvirumbidza ngaazvirumbidze pamusoro pezvizvi:","poem":1},{"text":"kuti anondinzwisisa uye kuti anondiziva ini,","poem":2},{"text":"kuti ndini Jehovha, anoita unyoro,","poem":1},{"text":"nokukururamisira, nokururama panyika,","poem":2},{"lineBreak":true},{"text":"nokuti ndinofarira izvozvi,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":25,"content":["“Mazuva anouya,” ndizvo zvinotaura Jehovha, “andicharanga vose vakadzingiswa panyama chete,"]},{"type":"verse","number":26,"content":["Ijipiti, Judha, Edhomu, Amoni, Moabhu navose vanogara mugwenga kunzvimbo dziri kure. Nokuti ndudzi dzose idzi hadzina kumbodzingiswa, uye kunyange imba yose yaIsraeri haina kudzingiswa, mumwoyo.”"]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}