{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"“Ndinosema upenyu hwangu chaihwo,","poem":1},{"text":"naizvozvo ndicharega kunyarara pakunyunyuta kwangu","poem":2},{"lineBreak":true},{"text":"ndigotaura mukushungurudzika kwemwoyo wangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichati kuna Mwari: Musandiwanira mhosva","poem":1},{"text":"asi mundiudze mhaka yangu nemi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ko, kundimanikidza kunokufadzai,","poem":1},{"text":"kuti muzvidze basa ramaoko enyu,","poem":2},{"lineBreak":true},{"text":"muchinyemwerera kurangano dzavakaipa here?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ko, imi muna meso enyama here?","poem":1},{"text":"Munoona sokuona kunoita munhu anofa here?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ko, mazuva enyu akaita seavaya vanofa,","poem":1},{"text":"kana makore enyu samakore omunhu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kuti muongorore mhosva yangu","poem":1},{"text":"uye mutsvage chivi changu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kunyange muchiziva kuti handina mhosva,","poem":1},{"text":"uye kuti hakuna anogona kundinunura paruoko rwenyu here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Maoko enyu akandiumba uye akandigadzira.","poem":1},{"text":"Zvino modzoka kuzondiparadza here?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Rangarirai kuti makandiumba sevhu.","poem":1},{"text":"Zvino mondidzoserazve kuvhu here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hamuna kundidurura somukaka here","poem":1},{"text":"uye mukandigwambisa sechizi,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"mukandifukidza neganda nenyama","poem":1},{"text":"mukandisonanidza pamwe chete namapfupa namarunda here?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Makandipa upenyu mukandinzwira ngoni,","poem":1},{"text":"uye nehanya yenyu mukachengeta mweya wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Asi izvi ndizvo zvamakaviga mumwoyo menyu,","poem":1},{"text":"uye ndinoziva kuti izvi zvaiva mupfungwa dzenyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kana ndakatadza, imi maizenge makanditarisa,","poem":1},{"text":"uye hamaizotendera kudarika kwangu kuti kurege kurangwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kana ndine mhosva, ndine nhamo!","poem":1},{"text":"Kunyange dai ndisina mhosva,","poem":2},{"lineBreak":true},{"text":"handingasimudzi musoro wangu,","poem":2},{"lineBreak":true},{"text":"nokuti ndizere nenyadzi","poem":2},{"lineBreak":true},{"text":"uye ndakanyura mukutambudzika kwangu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kana ndikasimudza musoro wangu, imi munondironda sezvinoita shumba,","poem":1},{"text":"uyezve munoratidza simba renyu rinotyisa pamusoro pangu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Munouya nezvapupu zvenyu zvitsva kuzondipomera mhosva","poem":1},{"text":"uye munowedzera hasha dzenyu pamusoro pangu,","poem":2},{"lineBreak":true},{"text":"hondo dzenyu dzinondirwisa, mapoka namapoka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Ko, zvino makandibudisirei mudumbu?","poem":1},{"text":"Ndinoshuva kuti dai ndakafa hangu pasati pava neziso randiona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dai chete ndakanga ndisina kumbovapo hangu,","poem":1},{"text":"kana kuti ndakatakurwa ndichiendeswa kubwiro ndichangobva mudumbu ramai vangu!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ko, mazuva angu haasi mashoma ava kutopera here?","poem":1},{"text":"Ibvai kwandiri kuti ndimbofara hangu kwakanguva,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ndisati ndaenda kusingadzokwi,","poem":1},{"text":"kunyika yerima nomumvuri wakadzama,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kunyika yerima guru,","poem":1},{"text":"yomumvuri wakadzama nenyonganyonga,","poem":2},{"lineBreak":true},{"text":"iko kunoti kunyange chiedza chakangofanana nerima.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}