{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["Ipapo Zofari muNaamati akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Mashoko aya ose haangapindurwi here?","poem":1},{"text":"Ko, mutauri uyu anofanira kushayirwa mhosva here?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ko, kubvotomoka kwako kunganyaradza vanhu here?","poem":1},{"text":"Ko, pangashaya anokutsiura paunenge uchituka here?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iwe unoti kuna Mwari, ‘Zvandinotenda zvakarurama","poem":1},{"text":"uye ndakachena pamberi penyu.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haiwa, ndinoda sei kuti dai Mwari ataura,","poem":1},{"text":"kuti dai ashamisa hake muromo wake pamusoro pako,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"uye akuzarurire zvakavanzika zvouchenjeri,","poem":1},{"text":"nokuti uchenjeri hwechokwadi huri paviri.","poem":2},{"lineBreak":true},{"text":"Uzive izvi: Mwari akatokanganwa kare zvimwe zvivi zvako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ko, unganzwisisa zvakavanzika zvaMwari here?","poem":1},{"text":"Unganzwisisa panogumira Wamasimba Ose here?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zvakakwirira kupfuura matenga, iwe ungaiteiko?","poem":1},{"text":"Zvakadzika kupfuura kudzika kwebwiro, iwe ungaziveiko?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chiero chazvo chakareba kupfuura nyika","poem":1},{"text":"uye zvakapamhama kupfuura gungwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Kana iye akasvika akakupfigira mujeri","poem":1},{"text":"uye akakoka dare remhosva, ndianiko angapikisana naye?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zvirokwazvo anoziva vanhu vanonyengera;","poem":1},{"text":"uye paanoona chakaipa, anoshaya hanya here?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi munhu asina kuchenjera haangagoni kuva akangwara","poem":1},{"text":"sezvo zvisingagoneki kuti mwana wembizi angaberekwa nomunhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Asi kana mwoyo wako ukazvipira kwaari,","poem":1},{"text":"uye ukatambanudzira maoko ako kwaari,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kana ukaisa kure chivi chiri muruoko rwako,","poem":1},{"text":"uye ukasatendera chakaipa kugara mutende rako,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ipapo uchasimudza chiso chako usina nyadzi,","poem":1},{"text":"uchamira wakasimba uye usingatyi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zvirokwazvo uchakanganwa nhamo yako,","poem":1},{"text":"uchangoirangarira semvura yakaerera.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Upenyu huchajeka kupfuura masikati makuru,","poem":1},{"text":"uye rima richaita samangwanani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iwe uchagara zvakanaka, nokuti tariro iriko;","poem":1},{"text":"ucharinga-ringa ugozorora murugare.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Uchavata hako pasi, pasina munhu anokuvhundutsa,","poem":1},{"text":"uye vazhinji vachakumbira nyasha dzako.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Asi meso avakaipa achaneta,","poem":1},{"text":"uye vachashayiwa kwokutizira;","poem":2},{"lineBreak":true},{"text":"tariro yavo ichava yokufa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}