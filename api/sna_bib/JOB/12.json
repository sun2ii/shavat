{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["Ipapo Jobho akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Zvirokwazvo imi muri vanhu,","poem":1},{"text":"uye uchenjeri huchafa nemi!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asi neniwo ndinonzwisisa semi;","poem":1},{"text":"handisi muduku kwamuri.","poem":2},{"lineBreak":true},{"text":"Ndianiko asingazivi zvinhu zvose izvi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ndava chiseko kushamwari dzangu,","poem":1},{"text":"kunyange ndakadana kuna Mwari akapindura,","poem":2},{"lineBreak":true},{"text":"ndava chiseko zvacho, kunyange ndakarurama uye ndisina chandingapomerwa!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Varume vagere zvakanaka vanoshora nhamo,","poem":1},{"text":"vachiti ndiwo magumo avaya vane tsoka dzinotedzemuka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Matende amakororo haakanganiswe,","poem":1},{"text":"uye vaya vanotsamwisa Mwari vagere zvakanaka,","poem":2},{"lineBreak":true},{"text":"ivo vanotakura mwari wavo mumaoko avo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Asi bvunza mhuka, uye dzichakudzidzisa,","poem":1},{"text":"kana shiri dzedenga, idzo dzichakuudza;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kana taura kunyika, ichakudzidzisa,","poem":1},{"text":"kana hove dzegungwa ngadzikuzivise.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndechipiko pane zvose izvi chisingazivi","poem":1},{"text":"kuti ruoko rwaJehovha rwakaita izvi?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Upenyu hwezvisikwa zvose huri muruoko rwake,","poem":1},{"text":"nokufema kwavanhu vamarudzi ose.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ko, nzeve haiedzi mashoko","poem":1},{"text":"sorurimi runoravira chokudya here?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ko, uchenjeri hahuwanikwi pakati pavatana here?","poem":1},{"text":"Ko, kuwanda kwoupenyu hakuuyisi kunzwisisa here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Uchenjeri nesimba ndezvaMwari;","poem":1},{"text":"kudzidzisa nokunzwisisa ndezvake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Zvaanenge akoromora hakuna anozvivakazve;","poem":1},{"text":"murume waanenge apfigira mujeri haangasunungurwi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kana akadzivisa kunaya kwemvura, kuoma kunovapo;","poem":1},{"text":"kana akairegedzera, nyika inoparadzwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Simba nokukunda ndezvake;","poem":1},{"text":"anonyengerwa nomunyengeri vose ndevake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Anodzinga makurukota asina nguo","poem":1},{"text":"uye anoita kuti vatongi vave mapenzi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anobvisa zvisungo zvakaiswa namadzimambo","poem":1},{"text":"agosunga zviuno zvavo nomucheka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Anodzinga vaprista vasina nguo","poem":1},{"text":"uye anobvisa pachigaro vanhu vakanguri vadzika midzi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Anofumbira miromo yavapi vamazano vavanovimba navo,","poem":1},{"text":"uye anobvisa kunzwisisa kwavakuru.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Anodurura kushorwa pamakurukota","poem":1},{"text":"uye anokutunura zvombo zvavane simba.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Anobudisa pachena zvinhu zvakadzama zverima,","poem":1},{"text":"uye anouyisa mimvuri mikuru kuchiedza.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Anoita kuti ndudzi dzive huru, uye anodziparadza;","poem":1},{"text":"anowanza ndudzi, uye anodziparadzira.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Anotorera vatungamiri venyika kunzwisisa kwavo;","poem":1},{"text":"anovaendesa vachingodzungaira pasina nzira.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Vanotsvanzvadzira murima vasina chiedza;","poem":1},{"text":"anoita kuti vadzedzereke sezvidhakwa.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}