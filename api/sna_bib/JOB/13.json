{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"“Meso angu akaona izvi zvose,","poem":1},{"text":"nzeve dzangu dzakanzwa dzikazvinzwisisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zvamunoziva imi, neniwo ndinozviziva;","poem":1},{"text":"handisi muduku kwamuri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asi ndinoshuva kutaura naWamasimba Ose","poem":1},{"text":"uye ndigozvidavirira nyaya yangu kuna Mwari.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kunyange zvakadaro, imi munondizora nhema;","poem":1},{"text":"muri varapi vasina maturo, imi mose!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haiwa, dai bedzi mainyarara henyu!","poem":1},{"text":"Nokuti hungava uchenjeri kwamuri.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Chinzwai zvino kuzvidavirira kwangu;","poem":1},{"text":"teererai munzwe kudemba kwemiromo yangu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ko, mungataura zvakaipa muchimiririra Mwari here?","poem":1},{"text":"Ko, mungataura zvinonyengera muchiti matumwa naye here?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mungamuitira rusaruro here?","poem":1},{"text":"Mungamiririra Mwari here?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ko, zvingabuda zvakanaka here kana akakuedzai?","poem":1},{"text":"Ko, mungamunyengera sokunyengera kwamunoita vanhu here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zvirokwazvo iye angakutsiurai","poem":1},{"text":"kana mukaratidza rusaruro muchivande.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ko, kubwinya kwake hakungakutyisei here?","poem":1},{"text":"Ko, kutyisa kwake hakungawiri pamusoro penyu here?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mashoko enyu anotendwa itsumo dzamadota;","poem":1},{"text":"nhare dzenyu inhare dzevhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Nyararai uye regai nditaure;","poem":1},{"text":"ipapo chinouya kwandiri ngachiuye hacho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ko, ndinozviisirei munjodzi","poem":1},{"text":"ndichibatira upenyu hwangu mumaoko angu?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kunyange akandiuraya hake, asi ini ndichavimba naye;","poem":1},{"text":"zvirokwazvo ndichadzivirira nzira dzangu pamberi pake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zvirokwazvo, uku ndiko kuchava kuponeswa kwangu,","poem":1},{"text":"nokuti hakuna munhu asina umwari achasvika pamberi pake!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Teereresai kumashoko angu,","poem":1},{"text":"nzeve dzenyu ngadzigamuchire zvandinoreva.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zvino ndagadzirisa nyaya yangu,","poem":1},{"text":"ndinoziva kuti ndichashayirwa mhosva.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Pane angagona kundipa mhaka here?","poem":1},{"text":"Kana aripo, ndichanyarara ndigofa hangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Haiwa Mwari, nditsidzirei hangu zvinhu zviviri izvi.","poem":1},{"text":"Uye ipapo handingavandi pamberi penyu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bvisai ruoko rwenyu rwuve kure neni,","poem":1},{"text":"uye murege kundivhundutsa nokutyisa kwenyu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ipapo mukandidana ndichadavira.","poem":1},{"text":"Kana kuti murege nditaure, imi mugopindura.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Zvivi zvandakaita nezvikanganiso zvangu zvinganiko?","poem":1},{"text":"Ndiratidzei kudarika kwangu nechivi changu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Munovanzireiko chiso chenyu","poem":1},{"text":"muchindiona somuvengi wenyu?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ko, muchatambudza shizha rinopeperetswa nemhepo here?","poem":1},{"text":"Ko, muchadzingana nehundi yakaoma here?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nokuti munonyora zvinhu zvinovava pamusoro pangu,","poem":1},{"text":"uye munondigarisa nhaka yezvivi zvoujaya hwangu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Munosunga tsoka dzangu nezvisungo;","poem":1},{"text":"munocherechedza nzira dzangu dzose nokuisa mutaro panotsika tsoka dzangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Saizvozvo munhu anopera kufanana nechinhu chakaora,","poem":1},{"text":"senguo yakadyiwa nezvipfukuto.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}