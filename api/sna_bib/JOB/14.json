{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“Munhu akazvarwa nomukadzi","poem":1},{"text":"ane mazuva mashoma azere nokutambudzika.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anobuda seruva agosvava;","poem":1},{"text":"anotiza somumvuri, haagari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ko, munotarisisa munhu akadai here?","poem":1},{"text":"Ko, muchamuuyisa kuzotongwa pamberi penyu here?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndianiko angabudisa chinhu chakachena kubva pane chine tsvina?","poem":1},{"text":"Hakuna!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mazuva omunhu akatarwa;","poem":1},{"text":"makatema kuwanda kwemwedzi yake,","poem":2},{"lineBreak":true},{"text":"mukamutarira miganhu yaasingagoni kudarika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naizvozvo regai kumutarisa uye mumusiye ari oga,","poem":1},{"text":"kusvikira apedza nguva yake somunhu anoshanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Asi kumuti kune tariro:","poem":1},{"text":"Kana ukatemwa, unobukirazve,","poem":2},{"lineBreak":true},{"text":"uye mabukira awo matsva haasvavi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Midzi yawo ingava yakwegura hayo muvhu","poem":1},{"text":"uye hunde yawo ichifa muvhu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"asi uchabukira pakunhuhwira kwemvura","poem":1},{"text":"ugomera somuti uchangotanga kumera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asi munhu anofa agoradzikwa pasi;","poem":1},{"text":"anofema kokupedzisira uye haazovapozve.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sokupera kunoita mvura mugungwa,","poem":1},{"text":"kana kupwa nokuoma kworwizi,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"saizvozvo munhu anovata pasi asingazomuki;","poem":1},{"text":"kusvikira matenga asisiko, vanhu havazomukizve kana kumutswa pakuvata kwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Haiwa, dai mandiviga henyu muguva chete,","poem":1},{"text":"uye mandiviga kusvikira kutsamwa kwenyu kwapfuura!","poem":2},{"lineBreak":true},{"text":"Dai chete manditarira nguva,","poem":2},{"lineBreak":true},{"text":"uye ipapo mugondirangarira!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kana munhu akafa, angazoraramazve here?","poem":1},{"text":"Mazuva ose okushanda kwangu kwakaoma,","poem":2},{"lineBreak":true},{"text":"ndicharindira kusvikira kuvandudzwa kwangu kwasvika.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Muchadana uye ini ndichakupindurai;","poem":1},{"text":"muchashuva chisikwa chamakaita namaoko enyu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zvirokwazvo muchaverenga nhambwe dzangu ipapo,","poem":1},{"text":"asi musingarondi chivi changu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kudarika kwangu kuchasungirwa musaga;","poem":1},{"text":"muchafukidzira chivi changu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Asi sokupfupfunyuka kunoita gomo rigoondomoka,","poem":1},{"text":"uye sokubviswa kwedombo panzvimbo yaro,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"semvura inochera mabwe,","poem":1},{"text":"uye sokuyerera kwemvura zhinji inokukura ivhu,","poem":2},{"lineBreak":true},{"text":"saizvozvo munoparadza tariro yomunhu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Munomukunda kamwe chete zvachose, uye akasazovapo;","poem":1},{"text":"munoshandura chiso chake mobva mamudzinga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kana vanakomana vake vachikudzwa, iye haazvizivi;","poem":1},{"text":"kana vakadzikisirwa pasi, iye haazvioni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Anongonzwa kurwadza kwomuviri wake chete,","poem":1},{"text":"agozvichema iye pachake bedzi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}