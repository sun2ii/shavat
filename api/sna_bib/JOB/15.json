{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Ipapo Erifazi muTemani akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Ko, munhu akachenjera angapindura zvisina njere here,","poem":1},{"text":"kana kuzadza dumbu rake nemhepo inopisa yokumabvazuva?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ko, angakakavara namashoko asina maturo,","poem":1},{"text":"kana namashoko asina basa here?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asi unotorwisa umwari","poem":1},{"text":"uye unodzivisa kunamata Mwari.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Chivi chako chinorunzira muromo wako;","poem":1},{"text":"uye unotevera rurimi rwavanyengeri.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Muromo wako pachako ndiwo unokupa mhosva, kwete wangu,","poem":1},{"text":"miromo yako pachako inokupupurira zvakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ko, ndiwe munhu wakatanga kuzvarwa here?","poem":1},{"text":"Ko, iwe wakazvarwa makomo asati avapo here?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unoteererawo here panokurukurwa mazano aMwari?","poem":1},{"text":"Unoti uchenjeri ndohwako woga kanhi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chiiko chaunoziva chatisingazivi isu?","poem":1},{"text":"Kunzwisisa kwaunako ndokweiko kwatisinawo isu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vane bvudzi rakachena navatana vakwegura vari kudivi redu,","poem":1},{"text":"varume vatochembera kupinda baba vako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ko, kunyaradza kwaMwari hakuna kukukwanira here,","poem":1},{"text":"iro shoko rakataurwa kwauri zvine unyoro?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ko, mwoyo wako wakurasireiko,","poem":1},{"text":"uye meso ako anobwairireiko,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"zvokuti unoitira Mwari hasha","poem":1},{"text":"ugobudisa mashoko akadai kubva mumuromo mako?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Munhu chiiko, zvokuti angava akanaka,","poem":1},{"text":"kana munhu akazvarwa nomukadzi, kuti angava akarurama?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kana Mwari akasavimba navatsvene vake,","poem":1},{"text":"kunyange dai matenga akasava akachena pamberi pake,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ko, kuzoti munhu, ane uori","poem":1},{"text":"uye akaora, anonwa zvakaipa semvura!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Nditeerere ndigokutsanangurira;","poem":1},{"text":"rega ndikuudze zvandakaona,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"zvakataurwa navanhu vakachenjera,","poem":1},{"text":"vasingavanzi chinhu chavakagamuchira kubva kumadzibaba avo,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ivo voga vakapiwa nyika","poem":1},{"text":"pasina mutorwa akapfuura napakati pavo:","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Murume akaipa anotambudzika nokurwadziwa pamazuva ake ose,","poem":1},{"text":"makore ose outsinye akachengeterwa iye.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Maungira anotyisa anozadza nzeve dzake;","poem":1},{"text":"pazvinenge zvaita sezvakanaka, vapambi vanomurwisa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Anorasikirwa netariro yokupunyuka parima;","poem":1},{"text":"munondo ndiwo waakatarirwa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Anofamba-famba achiita sechokudya zvamagora;","poem":1},{"text":"anoziva kuti zuva rerima raswedera.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kutambudzika nokurwadziwa zvinomuzadza nokutya;","poem":1},{"text":"zvinomukunda, samambo agadzirira kurwisa,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"nokuti anokungira Mwari chibhakera chake","poem":1},{"text":"uye anozvikudza pamusoro paWamasimba Ose,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"achimhanyira kwaari asingatyi","poem":1},{"text":"ane nhoo hobvu, yakasimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Kunyange chiso chake chakafukidzwa namafuta","poem":1},{"text":"uye chiuno chake chakafuta nenyama,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"iye achagara mumaguta akaparadzwa","poem":1},{"text":"nomudzimba dzisingagarwi nomunhu,","poem":2},{"lineBreak":true},{"text":"dzimba dzokoromoka kuva marara.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Haachazovazve mupfumi uye pfuma yake haingagari,","poem":1},{"text":"kana nepfuma yake haingazadzi nyika.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Haangapunyuki rima;","poem":1},{"text":"murazvo uchasvavisa mabukira ake,","poem":2},{"lineBreak":true},{"text":"uye kufema kwomuromo waMwari kuchamurasira kure.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ngaarege kuzvinyengera nokuvimba nezvisina maturo,","poem":1},{"text":"nokuti haana chaachawana pazviri.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Acharipirwa zvakazara nguva yake isati yasvika,","poem":1},{"text":"uye matavi ake haangawandi.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Achafanana nomuzambiringa wabvisirwa mazambiringa asati aibva,","poem":1},{"text":"kufanana nomuti womuorivhi wodonhedza maruva awo.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Nokuti ungano yavasingadi Mwari ichashaya zvibereko,","poem":1},{"text":"uye moto uchaparadza matende avaya vanofarira fufuro.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Vanobata mimba yokutambudzika vagozvara zvakaipa;","poem":1},{"text":"dumbu ravo rinogadzira kunyengera.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}