{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["Ipapo Jobho akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Ndakanzwa zvinhu zvakawanda sezvizvi;","poem":1},{"text":"mose muri vanyaradzi pasina!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ko, kutaura kwenyu kwamadzokorora kwenguva refu hakuperiwo here?","poem":1},{"text":"Chii chinokurwadzai kuti murambe muchiita nharo?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neniwo ndaigona kutaura semi,","poem":1},{"text":"dai imi manga muri pachinzvimbo changu;","poem":2},{"text":"ndaigona kutaura mashoko okukupikisai","poem":1},{"text":"uye ndigokudzungudzirai musoro wangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asi muromo wangu waizokukurudzirai:","poem":1},{"text":"kunyaradza kunobva pamuromo wangu kwaizokuvigirai zororo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Asi kana ndikataura, kurwadziwa kwangu hakuperi;","poem":1},{"text":"uye kana ndikanyarara, iko hakubvi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zvirokwazvo, imi Mwari, mandipedza simba;","poem":1},{"text":"maparadza imba yangu yose.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Makandisunga ini, uye chava chapupu;","poem":1},{"text":"kuondoroka kunondiwira uye kunopupurira zvinondirwisa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwari anondirova uye anondibvambura mukutsamwa kwake,","poem":1},{"text":"uye anondirumanyira meno ake;","poem":2},{"lineBreak":true},{"text":"mudzivisi wangu anondidzvokorera meso ake anobaya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vanhu vanoshamisa miromo yavo kuti vandiseke;","poem":1},{"text":"vanondirova padama pakundimhura kwavo,","poem":2},{"lineBreak":true},{"text":"uye vanobatana pamwe chete kuzondirwisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwari akandidzorera mumaoko avanhu vakaipa,","poem":1},{"text":"uye akandikanda mumaoko avakashata.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Zvose zvakanga zvakanaka hazvo kwandiri, asi iye akandivhuna;","poem":1},{"text":"akandibata napahuro akandipwanya-pwanya.","poem":2},{"lineBreak":true},{"text":"Akandivavarira;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"vapfuri vake vemiseve vakandikomba.","poem":1},{"text":"Anobaya itsvo dzangu asina tsitsi,","poem":2},{"lineBreak":true},{"text":"uye anodururira nduru yangu pasi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nguva nenguva anondirwisa;","poem":1},{"text":"anondidzingirira somurwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ndakasona nguo dzamasaga kuti ndifukidze ganda rangu,","poem":1},{"text":"uye ndaviga huma yangu muguruva.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Chiso changu chatsvuka nokuchema,","poem":1},{"text":"rima guru rakomberedza meso angu;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"asi zvazvo maoko angu haana kuita chisimba,","poem":1},{"text":"uye munyengetero wangu wakachena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Iwe nyika, rega kufukidza ropa rangu;","poem":1},{"text":"kuchema kwangu ngakurege kuwana zororo!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kunyange iko zvino chapupu changu chiri kudenga;","poem":1},{"text":"murevereri wangu ari kumusoro.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Murevereri wangu ndiye shamwari yangu,","poem":1},{"text":"meso angu paanodurura misodzi kuna Mwari;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"anomira pachinzvimbo chomunhu achikumbira kuna Mwari,","poem":1},{"text":"somunhu anokumbirira shamwari yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Makore mashoma bedzi asara,","poem":1},{"text":"ndisati ndaenda parwendo rusingadzokwi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}