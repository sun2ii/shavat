{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Mweya wangu waputsika,","poem":1},{"text":"mazuva angu aitwa mashoma,","poem":2},{"lineBreak":true},{"text":"guva rakandimirira.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zvirokwazvo vaseki vakandipoteredza;","poem":1},{"text":"meso angu anofanira kuramba akatarisa ruvengo rwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Ndipei, imi Mwari, chitsidzo chamunoda.","poem":1},{"text":"Ndianiko achandiisira rubatso?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Makapofumadza ndangariro dzavo pakunzwisisa;","poem":1},{"text":"naizvozvo hamungavatenderi kukunda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kana munhu akaramba shamwari dzake nokuda kwomubayiro,","poem":1},{"text":"meso avana vake achapofumara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mwari akandiita shumo kuvanhu vose,","poem":1},{"text":"munhu anopfirwa mate kumeso kwake navanhu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Meso angu aneta nokuchema;","poem":1},{"text":"muviri wangu wose wangova mumvuri zvawo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanhu vakarurama vanokatyamadzwa nazvo;","poem":1},{"text":"vasina mhaka vachamukira vasingadi Mwari.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kunyange zvakadaro, vakarurama vachabatirira panzira dzavo,","poem":1},{"text":"uye vana maoko akachena vachanyanya kusimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Asi uyai, imi mose, edzaizve!","poem":1},{"text":"Handingawani murume ane uchenjeri pakati penyu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mazuva angu apfuura, urongwa hwangu hwaparadzwa,","poem":1},{"text":"saizvozvowo zvishuvo zvomwoyo wangu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vanhu ava vanoshandura usiku kuti huve masikati;","poem":1},{"text":"mukati merima ivo vanoti, ‘Chiedza chiri pedyo.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kana musha wandinotarisira uri guva chete,","poem":1},{"text":"kana ndikawaridzira mubhedha wangu murima,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kana ndikati kuuori, ‘Ndiwe baba vangu,’","poem":1},{"text":"nokuhonye ndikati, ‘Ndiwe mai vangu’ kana ‘Hanzvadzi yangu,’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ko, tariro yangu iripi zvino?","poem":1},{"text":"Ndianiko angaona tariro yangu?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ichaburukira kumasuo orufu here?","poem":1},{"text":"Tichaburukira muguruva pamwe chete here?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}