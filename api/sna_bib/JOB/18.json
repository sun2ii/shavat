{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["Ipapo Bhiridhadhi muShuhi akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Muchapedza kutaura uku riiniko?","poem":1},{"text":"Chimbonyatsofungai, ipapo tigotaurirana hedu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tinobatirweiko semombe","poem":1},{"text":"uye tichionekwa samapenzi pamberi penyu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iyewe unozvibvamburanya mukutsamwa kwako,","poem":1},{"text":"nyika ingasiyiwa nokuda kwako here?","poem":2},{"lineBreak":true},{"text":"Kana matombo angafanira kubviswa panzvimbo yawo here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Mwenje weakaipa unodzimwa;","poem":1},{"text":"murazvo womoto wake unopera kupisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Chiedza chiri mutende rake chinova rima;","poem":1},{"text":"mwenje uri parutivi pake unodzima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Simba renhambwe dzake rinorukutika;","poem":1},{"text":"mano ake pachake anomuwisira pasi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tsoka dzake dzinomuwisira mumumbure,","poem":1},{"text":"uye anodzungaira ari mumaburi awo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Musungo unomubata chitsitsinho;","poem":1},{"text":"rugombe runomubatisisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Chishwe chakavanzwa muvhu nokuda kwake;","poem":1},{"text":"musungo wakaradzikwa munzira yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kutyisa kunomuvhundutsa kumativi ose,","poem":1},{"text":"uye kunomuteverera panhambwe dzake dzose.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pfumvu inomudokwairira;","poem":1},{"text":"njodzi yakamugaririra paanowa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inodya zvikamu zveganda rake;","poem":1},{"text":"dangwe rorufu rinopedza mitezo yake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anodzurwa kubva patende raanovimba naro","poem":1},{"text":"agoendeswa kuna mambo anotyisa kwazvo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Moto unogara mutende rake;","poem":1},{"text":"safuri inopisa inoparadzirwa pamusoro pougaro hwake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Moto unogara mutende rake;","poem":1},{"text":"uye matavi ake anosvava kumusoro.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kurangarirwa kwake kunopera panyika;","poem":1},{"text":"haana zita munyika.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anobviswa pachiedza achiendeswa murima,","poem":1},{"text":"uye anodzingwa panyika.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Haana mwana kana chizvarwa chinotevera pakati pavanhu vokwake,","poem":1},{"text":"hakuna akasara kwaaimbogara.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Varume vokumavirira vakakatyamara namagumo ake;","poem":1},{"text":"varume vokumabvazuva vakabatwa nokutya kukuru.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Zvirokwazvo, ndizvo zvakaita ugaro hwomurume akaipa;","poem":1},{"text":"iyoyi ndiyo nzvimbo yomunhu asingazivi Mwari.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}