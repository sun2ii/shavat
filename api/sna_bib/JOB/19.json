{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":["Ipapo Jobho akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Mucharamba muchinditambudza","poem":1},{"text":"uye muchindipwanya namashoko kusvikira riniko?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zvino kava kagumi kose muchingonditsoropodza;","poem":1},{"text":"munondirwisa musina nenyadzi dzose.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kana chiri chokwadi kuti ndakatsauka,","poem":1},{"text":"kukanganisa kwangu kuchava dambudziko rangu ndoga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kana zvechokwadi mungada henyu kuzvikudza pamusoro pangu","poem":1},{"text":"mukashandisa kuderedzwa kwangu pakundirwisa,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"zvino muzive imi kuti Mwari akandikanganisira","poem":1},{"text":"uye akandikomberedza nomumbure wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Kunyange ndikachema ndichiti, ‘Ndakakanganisirwa we-e!’ handiwani mhinduro;","poem":1},{"text":"kunyange ndikadanidzira kuti ndibatsirwe, kururamisirwa hakupo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akadzivira nzira yangu kuti ndikonewe kupfuura;","poem":1},{"text":"akaisa rima munzira dzangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akandibvisira kukudzwa kwangu,","poem":1},{"text":"uye akabvisa korona mumusoro mangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anondibvamburanya kumativi ose kusvikira ndapera;","poem":1},{"text":"anodzura tariro yangu kunge muti,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kutsamwa kwake kunopfuta pamusoro pangu;","poem":1},{"text":"anondiverenga pakati pavavengi vake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mauto ake anouya nesimba;","poem":1},{"text":"anovaka muchinjiziri wokurwa neni,","poem":2},{"lineBreak":true},{"text":"anokomba tende rangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Akaisa hama dzangu kure neni;","poem":1},{"text":"vazikani vangu vakaparadzaniswa neni zvachose.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hama dzangu dzepedyo dzakaenda kure neni;","poem":1},{"text":"shamwari dzangu dzandikanganwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vaenzi vangu navarandakadzi vangu vava kundiita mubvakure;","poem":1},{"text":"vanondiona somutorwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndinodana muranda wangu, asi haapinduri,","poem":1},{"text":"kunyange ndikamukumbirisa nomuromo wangu chaiwo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kufema kwangu kunonyangadza kumukadzi wangu;","poem":1},{"text":"ndinosemesa kuhama dzangu chaidzo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kunyange nezvikomana zviduku zvinondiseka;","poem":1},{"text":"pandinosvika vanondituka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Shamwari dzangu dzepedyo dzinondisema;","poem":1},{"text":"vaya vandinoda vandishandukira.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Handisati ndichiri chinhu asi ndangova hangu ganda namapfupa;","poem":1},{"text":"ndangopunyuka napaburi retsono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Ndinzwirei urombo, shamwari dzangu,","poem":1},{"text":"ndinzwirei urombo nokuti ruoko rwaMwari rwandirova.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Seiko muchindidzingirira sezvinoita Mwari?","poem":1},{"text":"Ko, hamungaguti nenyama yangu here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Haiwa, dai mashoko angu ainyorwa hawo,","poem":1},{"text":"dai ainyorwa hawo mubhuku,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"dai ainyorwa nechinyoreso chesimbi pamutobvu,","poem":1},{"text":"kana kuti ainyorwa padombo nokusingaperi!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndinoziva kuti mudzikinuri wangu mupenyu,","poem":1},{"text":"uye kuti pakupedzisira achamira pamusoro penyika.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Uye shure kwokunge ganda rangu raparara, kunyange zvakadaro ndichaona Mwari munyama yangu;","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ini pachangu ndichamuona","poem":1},{"text":"nameso angu pachangu, iyeni kwete mumwe.","poem":2},{"lineBreak":true},{"text":"Haiwa, mwoyo wangu unopanga sei mukati mangu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Kana muchiti, ‘Haiwa tichamutambudza sei,","poem":1},{"text":"sezvo mudzi wenhamo uri maari,’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"munofanira kutya munondo imi pachenyu,","poem":1},{"text":"nokuti hasha dzichauyisa kurangwa nomunondo,","poem":2},{"lineBreak":true},{"text":"ipapo muchaziva kuti pano kutongwa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}