{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":["Ipapo Zofari muNaamati akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Ndangariro dzangu dzokutambudzika dzinondikurumidzisa kuti ndipindure","poem":1},{"text":"nokuti ndakanganisika kwazvo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndiri kunzwa kutsiura kunondizvidza,","poem":1},{"text":"uye kunzwisisa kwangu kunondikurudzira kuti ndipindure.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Zvirokwazvo unoziva zvazvakanga zvakaita kubva kare,","poem":1},{"text":"kubvira pakaiswa munhu panyika,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"kuti kufara kwavakaipa kupfupi,","poem":1},{"text":"mufaro wavasina Mwari ndowenguva duku.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kunyange kuzvikudza kwake kuchisvika kudenga,","poem":1},{"text":"uye musoro wake uchindobata makore,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"achaparara nokusingaperi, setsvina yake pachake;","poem":1},{"text":"vaya vaichimbomuona vachati, ‘Aripiko?’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anobhururuka sokurota, haachawanikwizve,","poem":1},{"text":"adzingwa sechiratidzo chousiku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ziso rakamuona harichazomuonazve;","poem":1},{"text":"nzvimbo yake haichazomuonazve.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vana vake vanofanira kutsvaka nyasha kuvarombo;","poem":1},{"text":"maoko ake chaiwo anofanira kudzorera pfuma yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Simba roujaya rakazadza mapfupa ake","poem":1},{"text":"richaumburuka naye muguruva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kunyange chakaipa chichitapira mumukanwa,","poem":1},{"text":"uye achichiviga pasi porurimi rwake,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kunyange asingagoni kuchiregedza","poem":1},{"text":"achichichengeta mumukanwa make,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"asi chokudya chake chichashanduka chikavava mudumbu make;","poem":1},{"text":"chichava uturu hwenyoka mukati make.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Achapfira pasi upfumi hwaakamedza;","poem":1},{"text":"Mwari achaita kuti dumbu rake rizvirutse.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Achasveta uturu hwenyoka;","poem":1},{"text":"mazino emvumbi achamuuraya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haangafadzwi nehova,","poem":1},{"text":"idzo nzizi dzinoyerera uchi noruomba.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zvaakatamburira anofanira kuzvidzosazve zvisina kudyiwa;","poem":1},{"text":"haangafadzwi nezvaakawana pakutengesa kwake.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nokuti akamanikidza varombo akavasiya vava vachena;","poem":1},{"text":"akatora dzimba dzavasina chavanacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Zvirokwazvo haangamiri kubva pahavi yake;","poem":1},{"text":"haangazviponesi nepfuma yake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hapana chaakasiyirwa kuti adye;","poem":1},{"text":"upfumi hwake hahungagari nokusingaperi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Pakati pezvakawanda zvake, kuremerwa nepfungwa kuchamukunda;","poem":1},{"text":"kuzara kwenjodzi kuchauya pamusoro pake.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Paanenge agutsa dumbu rake,","poem":1},{"text":"Mwari achatuma kutsamwa kwake kunopisa pamusoro pake,","poem":2},{"lineBreak":true},{"text":"uye achanayisa kurova kwake pamusoro pake.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kunyange akatiza chombo chesimbi,","poem":1},{"text":"museve unopinza wendarira unomubaya.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Anoudzura kubva kumusana kwake,","poem":1},{"text":"muromo wawo unovaima uchibva pachiropa chake.","poem":2},{"lineBreak":true},{"text":"Kutya kuzhinji kuchauya pamusoro pake;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"rima guru richavandira pfuma yake.","poem":1},{"text":"Moto usina anopfutidzira uchamupisa","poem":2},{"lineBreak":true},{"text":"uye uchaparadza zvichasara mutende rake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Matenga achaisa pachena mhaka yake;","poem":1},{"text":"nyika ichamumukira.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mafashamu achakukura imba yake,","poem":1},{"text":"mvura zhinji ichaerera pazuva rehasha dzaMwari.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Aya ndiwo magumo anogoverwa vakaipa naMwari,","poem":1},{"text":"iyo nhaka yavakatemerwa naMwari.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}