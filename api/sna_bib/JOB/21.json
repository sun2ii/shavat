{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":["Ipapo Jobho akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Teereresa mashoko angu;","poem":1},{"text":"uku ngakuve kunyaradza kwaunondipa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndiitire mwoyo murefu ndichitaura hangu,","poem":1},{"text":"uye kana ndapedza kutaura, urambe uchiseka hako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ko, kunyunyuta kwangu kwakanangana nomunhu here?","poem":1},{"text":"Ndingatadza seiko kuora mwoyo?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nditarire ushamiswe;","poem":1},{"text":"ufumbire muromo wako noruoko.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndinotya, pandinofunga izvi;","poem":1},{"text":"kudedera kunobata muviri wangu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nemhaka yeiko vakaipa vachirarama,","poem":1},{"text":"vachikwegura uye vachiwedzerwa simba?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanoona vana vavo vachikura ivo vachiri vapenyu,","poem":1},{"text":"zvizvarwa zvavo pamberi pavo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Misha yavo igere zvakanaka uye haina chainotya;","poem":1},{"text":"shamhu yaMwari haisi pamusoro pavo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hando dzavo hadzikonewi kubereka,","poem":1},{"text":"mhou dzavo dzinobereka mhuru dzisingasvodzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vanobudisa vana vavo seboka ramakwai;","poem":1},{"text":"vapwere vavo vanopembera vachitamba.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vanoimba vachiridzirwa tambureni nembira;","poem":1},{"text":"vanofarira kurira kwenyere.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vanopedza makore avo mukubudirira","poem":1},{"text":"uye vanopinda muguva nenguva isipi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kunyange zvakadaro vanoti kuna Mwari, ‘Tisiyei takadaro!","poem":1},{"text":"Hatina hanya nokuziva nzira dzenyu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wamasimba Ose ndianiko, kuti timushumire?","poem":1},{"text":"Tinowaneiko kana tikamunamata?’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asi kubudirira kwavo hakusi mumaoko avo,","poem":1},{"text":"naizvozvo ndinomira kure nerangano yevakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Kunyange zvakadaro, kanganiko kanodzimwa mwenje wevakaipa?","poem":1},{"text":"Kanganiko vachiwirwa nenjodzi,","poem":2},{"lineBreak":true},{"text":"magumo anotarwa naMwari mukutsamwa kwake?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vanofanana namakoto anopeperetswa nemhepo runganiko,","poem":1},{"text":"sehundi inokukurwa nedutu?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zvinonzi, ‘Mwari anochengetera vana vomunhu kutongwa.’","poem":1},{"text":"Ngaamutsive iye amene, kuitira kuti agozviziva!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Meso ake pachake ngaaone kuparadzwa kwake;","poem":1},{"text":"iye ngaanwe kutsamwa kwoWamasimba Ose.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nokuti ane hanya yeiko nemhuri yaanosiya shure,","poem":1},{"text":"mwedzi yaakagoverwa zvoyopera?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Ko, pane munhu angagona kudzidzisa ruzivo kuna Mwari here,","poem":1},{"text":"iye achitonga kunyange vari pamusoro-soro?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mumwe munhu anofa achine simba rake rizere,","poem":1},{"text":"akachengetedzeka uye akagadzikana,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"muviri wake wakagwinya,","poem":1},{"text":"mapfupa ake azere nomwongo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mumwe munhu anofa ane shungu dzomwoyo,","poem":1},{"text":"asina kumbonakidzwa nezvipi zvazvo zvakanaka.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Vanovata muguruva pamwe chete,","poem":1},{"text":"uye honye dzinovafukidza vose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Ndinoziva chose zvamunofunga,","poem":1},{"text":"iwo mano amungandikanganisa nawo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Imi munoti, ‘Imba yomunhu mukuru iripiko zvino,","poem":1},{"text":"iwo matende aigarwa navanhu vakaipa?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Hauna kumbobvunza vafambi vaya here?","poem":1},{"text":"Hauna kuva nehanya nenhoroondo dzavo here,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"dzokuti munhu akaipa anodarikwa pazuva renjodzi,","poem":1},{"text":"kuti anorwirwa pazuva rokutsamwa?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ndianiko anotsoropodza mafambiro ake pachena?","poem":1},{"text":"Ndianiko anomuripira pane zvaakaita?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Iye anotakurwa achiendeswa kuguva,","poem":1},{"text":"uye rinda rake rinorindwa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ivhu romunhika rinotapira kwaari;","poem":1},{"text":"vanhu vose vanomutevera,","poem":2},{"lineBreak":true},{"text":"uye anotungamirirwa navazhinji vasingaverengeki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Saka mungandinyaradza sei nezvisina maturo?","poem":1},{"text":"Hapana chasara pakupindura kwenyu asi nhema dzoga!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}