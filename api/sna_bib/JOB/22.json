{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":["Ipapo Erifazi muTemani akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Ko, munhu angabatsira Mwari here?","poem":1},{"text":"Kunyange munhu akachenjera angamubatsira here?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wamasimba Ose angawana mufaro weiko dai iwe wakarurama?","poem":1},{"text":"Aibatsirwa neiko dai nzira dzako dzaiva dzakarurama?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Imhaka yokumunamata kwako here","poem":1},{"text":"zvaanokutsiura uyewo achikupa mhosva?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvakaipa zvako hazvina kukura here?","poem":1},{"text":"Handiti zvivi zvako hazviperi?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wakakumbira rubatso kuhama dzako pasina;","poem":1},{"text":"wakatorera vanhu nguo dzavo, uchivasiya vasina kupfeka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wakanyima mvura vakaneta","poem":1},{"text":"uye wakanyima vane nzara zvokudya,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kunyange wakanga uri munhu ane simba, ane minda yake,","poem":1},{"text":"uri munhu anokudzwa, agere pairi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wakadzinga chirikadzi dzisina chinhu","poem":1},{"text":"uye wakavhuna simba renherera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndokusaka misungo yakakukomberedza,","poem":1},{"text":"ndokusaka njodzi ichikuvhundutsa,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ndokusaka kuine rima usingakwanisi kuona,","poem":1},{"text":"uye mafashamu emvura achikufukidza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ko, Mwari haazi kumusoro kwokudenga here?","poem":1},{"text":"Tarira kukwirira kwakaita nyeredzi dzokumusoro-soro!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Asi imi munoti, ‘Mwari anoziveiko?","poem":1},{"text":"Ko, anotonga murima rakadai here?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Makore matema anomufukidza,","poem":1},{"text":"saka haationi paanofamba-famba padenderedzwa ramatenga.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ko, iwe ucharambira munzira yakare","poem":1},{"text":"iya yakatsikwa navanhu vakaipa here?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ivo vakabvutwa nguva yavo isati yasvika,","poem":1},{"text":"hwaro hwavo hwakakukurwa namafashamu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Vakati kuna Mwari, ‘Tisiyei takadaro!","poem":1},{"text":"Wamasimba Ose angaiteiko kwatiri?’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sezvo ari iye akazadza dzimba dzavo nezvinhu zvakanaka,","poem":1},{"text":"ndinomira kure namano avakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Vakarurama vanoona kuparadzwa kwavo vagofara,","poem":1},{"text":"vasina mhaka vanovaseka vachiti,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‘Zvirokwazvo vadzivisi vedu vaparadzwa,","poem":1},{"text":"uye moto unopedza pfuma yavo.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Zviise pasi paMwari ugova norugare naye,","poem":1},{"text":"nenzira iyi kubudirira kuchasvika kwauri.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gamuchira kurayira kunobva mumuromo make","poem":1},{"text":"uye uchengete mashoko ake mumwoyo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kana ukadzokera kuna Wamasimba Ose, uchadzoredzerwa:","poem":1},{"text":"Kana ukabvisa zvakaipa uchizviisa kure netende rako,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"uye ukaisa goridhe rako paguruva,","poem":1},{"text":"iro goridhe rako rokuOfiri kumatombo okunzizi,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ipapo Wamasimba Ose achava goridhe rako,","poem":1},{"text":"iyo sirivha yako yakanyatsosanangurwa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Zvirokwazvo ipapo uchawana mufaro muna Wamasimba Ose,","poem":1},{"text":"uye uchasimudzira chiso chako kuna Mwari.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Uchanyengetera kwaari, uye achakunzwa,","poem":1},{"text":"uye iwe uchazadzisa zvawakapika.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Zvaunotaura sechirevo zvichaitika,","poem":1},{"text":"uye chiedza chichavhenekera panzira dzako.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Vanhu pavanodzikiswa iwe ukati, ‘Vasimudzei!’","poem":1},{"text":"ipapo vakaderedzwa vachaponeswa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Achadzikinura kunyange uyo ane mhosva,","poem":1},{"text":"acharwirwa kubudikidza nokuchena kwamaoko ako.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}