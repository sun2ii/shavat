{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["Ipapo Jobho akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Kunyange nanhasi ndinonyunyuta ndine shungu;","poem":1},{"text":"ruoko rwake runondiremera kunyange ndiri pakugomera kwangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dai chete ndaiziva kwandingamuwana;","poem":1},{"text":"dai chete ndaigona kuenda kwaanogara!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndaitaura hangu mhaka yangu pamberi pake,","poem":1},{"text":"uye ndaizadza muromo wangu nenharo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndaizoziva hangu zvaaizondipindura,","poem":1},{"text":"uye ndaizocherechedza zvaaizoreva.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuti aizondidzivisa nesimba guru here?","poem":1},{"text":"Kwete, haaizondipomera mhaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ipapo munhu akarurama aigona kuzotaura mhaka yake pamberi pake,","poem":1},{"text":"uye ndaizosunungurwa kubva pamutongi wangu nokusingaperi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Asi kana ndikaenda kumabvazuva, iye haako;","poem":1},{"text":"kana ndikaenda kumavirira, handimuwani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Paanenge ari pabasa nechokumusoro, handimuoni;","poem":1},{"text":"paanotsaukira zasi, handikwanisi kumuona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asi iye anoziva nzira yandinofamba nayo;","poem":1},{"text":"kana apedza kundiedza, ndichabuda ndava segoridhe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsoka dzangu dzakanyatsotevera paakatsika;","poem":1},{"text":"ndakarambira panzira dzake ndisingambotsaukiri parutivi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Handina kumbobva pamirayiro yemiromo yake;","poem":1},{"text":"ndakakoshesa mashoko omuromo wake kupfuura chingwa changu chamazuva ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Asi iye anomira oga, uye ndiani angapikisana naye?","poem":1},{"text":"Anoita zvaanoda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anoita zvaakatema pamusoro pangu,","poem":1},{"text":"uye urongwa huzhinji hwakadai achinahwo mudura rake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndokusaka ndichitya pamberi pake;","poem":1},{"text":"pandinofunga nezvose izvi, ndomutya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mwari akaita kuti mwoyo wangu unete;","poem":1},{"text":"Wamasimba Ose akandivhundutsa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kunyange zvakadaro rima harina kuita kuti ndinyarare,","poem":1},{"text":"iro rima guru rinofukidza chiso changu.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}