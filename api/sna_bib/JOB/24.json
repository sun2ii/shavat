{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"“Seiko Wamasimba Ose asingatari nguva dzokutonga?","poem":1},{"text":"Seiko avo vanomuziva vachitarisira mazuva akadai pasina?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vanhu vanobvisa mabwe omuganhu;","poem":1},{"text":"vanofudza makwai avakaba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vanotinha mbongoro dzenherera,","poem":1},{"text":"uye vanotora nzombe yechirikadzi vachiita rubatso.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vanodzinga vanoshayiwa kubva panzira,","poem":1},{"text":"uye vanomanikidza varombo vose venyika kundovanda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sezvinoita mbizi murenje,","poem":1},{"text":"varombo vanobuda vachienda kumabasa avo, okukwara-kwara zvokudya;","poem":2},{"lineBreak":true},{"text":"gwenga rinopa vana varo zvokudya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vanosunganidza uswa mumasango,","poem":1},{"text":"uye vanononga mazambiringa muminda yavakaipa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vashaya nguo, vagovata usiku hwose vasina zvavakapfeka","poem":1},{"text":"uye vanoshayiwa zvokufuka muchando.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanototeswa nemvura inonaya mumakomo,","poem":1},{"text":"uye vanombundikira matombo nokuda kwokushayiwa pokuvanda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwana nherera anobvutwa kubva pazamu;","poem":1},{"text":"mwana mucheche womurombo anotorwa nokuda kwechikwereti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nokushayiwa zvokufuka, vanongofamba-famba havo vasina kupfeka;","poem":1},{"text":"vanotakura zvisote, asi vane nzara.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vanopwanya maorivhi pakati pemihoronga;","poem":1},{"text":"vanotsika zvisviniro zvewaini, asi vanofa nenyota.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kugomera kwavanhu vanofa kunonzwika muguta,","poem":1},{"text":"uye mweya yavakakuvadzwa inochema kuti ibatsirwe.","poem":2},{"lineBreak":true},{"text":"Asi Mwari haana munhu waanopa mhosva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Varipo vanomukira chiedza,","poem":1},{"text":"vasingambozivi nzira dzacho kana kugara mumakwara acho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Panongovira zuva, muurayi anobva amuka, uye anouraya varombo navanoshayiwa;","poem":1},{"text":"panguva dzousiku anonyahwaira sembavha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ziso remhombwe rinomirira rubvunzavaeni;","poem":1},{"text":"anofunga achiti, ‘Hakuna ziso richandiona,’","poem":2},{"lineBreak":true},{"text":"uye anogara akavanza chiso chake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Vanhu vanopaza dzimba murima,","poem":1},{"text":"asi masikati vanozvipfigira mukati madzo;","poem":2},{"lineBreak":true},{"text":"havana chokuita nechiedza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwavari vose zvavo, rima guru ndiwo mangwanani avo;","poem":1},{"text":"vanoita ushamwari nokutyisa kwerima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Nyamba ivo ifuro riri pamusoro pemvura;","poem":1},{"text":"mugove wavo wenyika wakatukwa,","poem":2},{"lineBreak":true},{"text":"zvokuti hakuna munhu achaenda kuminda yemizambiringa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kupisa nokuoma sezvakunobvisa chando chanyunguduka,","poem":1},{"text":"saizvozvo guva rinobvuta vaya vakatadza.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Chizvaro chinovakanganwa, honye inovadya;","poem":1},{"text":"vanhu vakaipa havacharangarirwizve asi vakavhunwa somuti.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vanovandira mukadzi asingabereki, asina mwana,","poem":1},{"text":"uye havaitiri chirikadzi tsitsi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Asi Mwari anokwekweredza vane simba nesimba rake;","poem":1},{"text":"kunyange vakasimbiswa, havana chokwadi noupenyu hwavo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Angavarega zvavo vakazorora vachifungidzira kuti vakachengetedzwa;","poem":1},{"text":"asi meso ake ari panzira dzavo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Vanosimudzirwa kwechinguva chiduku, gare gare vaenda;","poem":1},{"text":"vanodukupiswa vagounganidzwa savamwe vose,","poem":2},{"lineBreak":true},{"text":"vanochekwa sehura dzezviyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Kana zvisina kudaro, ndiani anganditi ndinoreva nhema,","poem":1},{"text":"agoshayisa mashoko angu simba?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}