{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["Ipapo Bhiridhadhi muShuhi akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Kubata ushe nokutyiwa ndezvaMwari;","poem":1},{"text":"uye anosimbisa rugare kumusoro-soro kudenga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mauto ake angaverengwa here?","poem":1},{"text":"Ndianiko asingavhenekerwi nechiedza chake?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zvino munhu angava akarurama seiko pamberi paMwari?","poem":1},{"text":"Ko, munhu akazvarwa nomukadzi angava akachena sei?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kunyange dai mwedzi ukasachena,","poem":1},{"text":"uye nyeredzi dzikasava dzakachena pamberi pake,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ndoda munhu zvake, iro gonye zvaro,","poem":1},{"text":"iye mwanakomana womunhu, anongova gonye zvaro!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}