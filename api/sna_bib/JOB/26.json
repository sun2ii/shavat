{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["Ipapo Jobho akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Ndiweka wakabatsira vasina simba!","poem":1},{"text":"Wakaponesa sei ruoko rwakarukutika!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndiweka wakapa zano kune asina uchenjeri!","poem":1},{"text":"Ndiweka wakaratidza njere dzakakura kwazvo!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndianiko akakubatsira kutaura mashoko aya?","poem":1},{"text":"Uye mweya waaniko wakataura kubva pamuromo wako?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Vakafa vari pakushungurudzika kukuru,","poem":1},{"text":"ivo vari pasi pemvura zhinji navose vanogara mairi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sheori yakashama pamberi paMwari;","poem":1},{"text":"kuparadza hakuna kufukidzwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anotambanudza matenga nechokumusoro panzvimbo isina chinhu;","poem":1},{"text":"anorembedza nyika pasina chinhu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anoputira mvura zhinji mumakore ake;","poem":1},{"text":"asi makore acho haabvaruki nokuda kwokuremerwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anofukidza chiso chomwedzi uzere,","poem":1},{"text":"achiwarira makore ake pamusoro pawo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anotara muganhu pamberi pemvura zhinji,","poem":1},{"text":"kuti ugova muganhu pakati pechiedza nerima.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mbiru dzokudenga dzinodengenyeka,","poem":1},{"text":"dzichivhundutswa nokutuka kwake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akaunganidza mvura dzegungwa nesimba rake;","poem":1},{"text":"akagura-gura Rahabhi nenjere dzake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Matenga akashongedzwa nokufema kwake;","poem":1},{"text":"ruoko rwake rwakabaya nyoka inobhururuka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uye izvi ndiwo macheto oga ebasa rake;","poem":1},{"text":"haiwa tinongonzwa kuzevezera kwake!","poem":2},{"lineBreak":true},{"text":"Zvino ndianiko anganzwisisa kutinhira kwesimba rake?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}