{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["Zvino Jobho akapfuurira mberi nokutaura achiti:"]},{"type":"verse","number":2,"content":[{"text":"“Zvirokwazvo naMwari mupenyu, iye akaramba kundiruramisira,","poem":1},{"text":"iye Wamasimba Ose, akaita kuti ndinzwe shungu pamwoyo wangu,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"chero ndichine upenyu mandiri,","poem":1},{"text":"ndichine kufema kwaMwari mumhino dzangu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"miromo yangu haingatauri zvakashata,","poem":1},{"text":"uye rurimi rwangu harungatauri nokunyengera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Handingambobvumi kuti muri kutaura chokwadi;","poem":1},{"text":"kusvikira ndafa, handizorambi kururama kwangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndichachengetedza kururama kwangu uye handingakuregedzi;","poem":1},{"text":"hana yangu haingandipi mhosva ndichiri mupenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Vavengi vangu ngavaite savakaipa,","poem":1},{"text":"navadzivisi vangu savasakarurama!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ko, munhu asina Mwari ane tariro yeiko kana afa,","poem":1},{"text":"Mwari paanotora upenyu hwake?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ko, Mwari anoteerera kuchema kwake","poem":1},{"text":"paanowirwa nenhamo here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iye angawana mufaro muna Wamasimba Ose here?","poem":1},{"text":"Ko, achadana kuna Mwari panguva dzose here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ndichakudzidzisai nezvesimba raMwari;","poem":1},{"text":"nzira dzaWamasimba Ose handingadzivanzi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Imi mose makazviona izvi pachenyu.","poem":1},{"text":"Zvino munotaurireiko zvisina maturo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Haano magumo anogoverwa vakaipa naMwari,","poem":1},{"text":"iyo nhaka inogamuchirwa navanhu vano utsinye, kubva kuna Wamasimba Ose.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hazvinei kuti vana vake vakawanda sei, magumo avo munondo;","poem":1},{"text":"zvizvarwa zvake hazvizombowani zvokudya zvakakwana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Denda richaviga vaya vanenge vasara,","poem":1},{"text":"uye chirikadzi dzavo hadzingavachemi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kunyange akaunganidza sirivha seguruva,","poem":1},{"text":"uye zvokupfeka zvikaita somurwi wevhu,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"zvaanowana zvichapfekwa navakarurama,","poem":1},{"text":"uye vasina mhaka vachagovana sirivha yake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Imba yaanovaka yakaita sedende rechipfukuto,","poem":1},{"text":"sechirindo chakaitwa nomurindi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Anovata pasi akapfuma, asi haachazviitizve;","poem":1},{"text":"paanosvinura meso ake, wanei zvose zvaenda.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Zvinotyisa zvinomubata kufanana namafashamu;","poem":1},{"text":"dutu rinomubvutira kure panguva yousiku.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mhepo yokumabvazuva inomutakura ichimuendesa kure, achibva zvachose.","poem":1},{"text":"Inomukukura kubva panzvimbo yake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Inovhuvhuta paari isingamunzwiri ngoni,","poem":1},{"text":"paanenge achitiza akati tande achitiza simba rayo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Inomuomberera maoko ichimuseka,","poem":1},{"text":"ichishinyira ichiita kuti abve panzvimbo yake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}