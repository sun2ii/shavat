{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":["“Mugodhi wesirivha uripo,",{"text":"nenzvimbo inonatswa goridhe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Simbi inocherwa pasi,","poem":1},{"text":"uye ndarira inonyautswa ichibva pamhangura.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Munhu anoita kuti rima ripere;","poem":1},{"text":"anotsvakisisa kusvikira kumucheto chaiko,","poem":2},{"lineBreak":true},{"text":"mhangura iri murima rakasviba kwazvo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anovhura mugodhi kure nokunogara vanhu,","poem":1},{"text":"kunzvimbo dzakakanganikwa norutsoka rwomunhu;","poem":2},{"lineBreak":true},{"text":"kure navanhu anorezuka ndokuzeya uku nokuku.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iyo nyika, zvokudya zvichibva mairi,","poem":1},{"text":"inoshandurwa nechapasi seinoshandurwa nemoto,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"safire inobva mumatombo ayo,","poem":1},{"text":"uye guruva rayo rine upfu hwegoridhe,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hakuna gondo rinoziva nzira iyo yakavanzika,","poem":1},{"text":"hakuna ziso rorukodzi rakaiona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mhuka dzinozvikudza hadziisi rutsokapo,","poem":1},{"text":"uye hakuna shumba inofambapo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ruoko rwomunhu runorova dombo romusarasara","poem":1},{"text":"uye ronoisa midzi yamakomo pachena.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anochera mugero nomumatombo;","poem":1},{"text":"meso ake anoona pfuma yawo yose.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anotsvakisisa panotangira nzizi","poem":1},{"text":"uye anobudisa zvinhu zvakavanzika pachena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Asi uchenjeri hungawanikwepiko?","poem":1},{"text":"Kunzwisisa kunogarepiko?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Munhu haanzwisisi kukosha kwahwo;","poem":1},{"text":"hahungawanikwi munyika yavapenyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pakadzika panoti, ‘Hahuzi mandiri.’","poem":1},{"text":"Gungwa rinoti, ‘Hahuzi pandiri.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hahungatengwi negoridhe yakaisvonaka,","poem":1},{"text":"uye mutengo wahwo haungayerwi nesirivha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hahungatengwi negoridhe reOfiri,","poem":1},{"text":"namatombo anokosha eonikisi kana esafire.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hahungaenzaniswi negoridhe kana kristari,","poem":1},{"text":"uye hahungatsinhaniswi nezvishongo zvegoridhe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Korari nejasipa hazvingatongorehwi;","poem":1},{"text":"mutengo wouchenjeri unokunda maparera.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Topazi yeEtiopia haingaenzaniswi nahwo;","poem":1},{"text":"hahungatongotengwi negoridhe rakaisvonaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Zvino uchenjeri hunobvepiko?","poem":1},{"text":"Kunzwisisa kunogarepiko?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kwakavanzirwa meso ezvipenyu zvose,","poem":1},{"text":"zvakavigwa kunyange kushiri dzedenga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kuparadza noRufu zvinoti,","poem":1},{"text":"‘Runyerekupe rwahwo chete ndirwo rwakasvika munzeve dzedu.’","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mwari oga ndiye anonzwisisa nzira inoenda kwahuri,","poem":1},{"text":"uye ndiye oga anoziva kwahunogara,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"nokuti anoona magumo enyika,","poem":1},{"text":"uye anoona zvinhu zvose zviri pasi pamatenga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Paakasimbisa simba remhepo","poem":1},{"text":"uye akayera mvura,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"paakaita chirevo chemvura","poem":1},{"text":"negwara rokutinhira wemheni,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ipapo akatarira kuuchenjeri akahunzvera;","poem":1},{"text":"akahusimbisa uye akahuedza.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Zvino akati kumunhu,","poem":1},{"text":"‘Kutya Ishe, ndihwo uchenjeri,","poem":2},{"lineBreak":true},{"text":"uye kusiya zvakaipa ndiko kunzwisisa.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}