{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Shure kwaizvozvo, Jobho akashamisa muromo wake ndokutuka zuva rokuberekwa kwake."]},{"type":"verse","number":2,"content":["Akati:"]},{"type":"verse","number":3,"content":[{"text":"“Zuva rokuberekwa kwangu ngariparare,","poem":1},{"text":"uye nousiku hwakanzi, ‘Kwaberekwa mwanakomana!’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zuva iroro ngarishanduke rive rima;","poem":1},{"text":"Mwari wokudenga ngaarege kuva nehanya naro;","poem":2},{"lineBreak":true},{"text":"Chiedza ngachirege kuvhenekera pamusoro paro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rima nomumvuri wakasviba ngazviritore zvakare;","poem":1},{"text":"gore ngarigare pamusoro paro;","poem":2},{"lineBreak":true},{"text":"kusviba ngakufukidze chiedza charo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Usiku uhwo rima guru ngaribate;","poem":1},{"text":"ngahurege kuverengwa pakati pamazuva egore","poem":2},{"lineBreak":true},{"text":"kana kunyorwa pamwedzi ipi zvayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Usiku uhwo ngahushaye chibereko;","poem":1},{"text":"ngaparege kunzwika kupembera kwomufaro mahuri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanotuka mazuva ngavatuke zuva iro,","poem":1},{"text":"vaya vakagadzirira kumutsa Chikara Chikuru cheGungwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nyeredzi dzahwo dzamangwanani ngadzisvibe;","poem":1},{"text":"ngahumirire chiedza chamasikati pasina","poem":2},{"lineBreak":true},{"text":"uye ngahurege kuona hwerazuva hwamambakwedza;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"nokuti hahuna kundipfigira mikova yechizvaro","poem":1},{"text":"kuti huvanze dambudziko pamberi pangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ko, ndakaregererei kufa pakuberekwa kwangu,","poem":1},{"text":"nokufa pandaibuda mudumbu?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mabvi akavapo seiko kuti andigamuchire","poem":1},{"text":"namazamu kuti ndinwe?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nokuti zvino ndingadai ndakavata murugare;","poem":1},{"text":"ndingadai ndivete uye ndakazorora","poem":2}]},{"type":"verse","number":14,"content":[{"text":"namadzimambo namakurukota enyika,","poem":1},{"text":"vakazvivakira nzvimbo dzava matongo zvino,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"navatongi vakanga vane goridhe,","poem":1},{"text":"vakazadza dzimba dzavo nesirivha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kana kuti sei ndisina kuvigwa","poem":1},{"text":"muvhu somwana asina kusvika,","poem":2},{"lineBreak":true},{"text":"somucheche asina kumboona chiedza chezuva?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ikoko vakaipa vanorega kutambudza,","poem":1},{"text":"uye ikoko vakaneta vakazorora.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nhapwa dzinofarirawo rugare rwadzo;","poem":1},{"text":"havachanzwizve kudanidzira kwomuchairi wenhapwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Vaduku navakuru variko,","poem":1},{"text":"uye nhapwa yakasunungurwa kubva pana tenzi wayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Chiedza chinopirweiko vaya vari kusurukirwa,","poem":1},{"text":"uye upenyu kune ane shungu pamwoyo,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kuna vaya vanoshuva kufa irwo rusingauyi,","poem":1},{"text":"vanorutsvaka kupfuura pfuma yakavanzika,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"vazere nomufaro","poem":1},{"text":"uye vanofara pavanosvika muguva?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Upenyu hunopirweiko munhu ane nzira yakavanzika,","poem":1},{"text":"iye akakomberedzwa naMwari noruzhowa?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nokuti mafemo anosvika kwandiri pachinzvimbo chezvokudya,","poem":1},{"text":"kugomera kwangu kunodururwa semvura.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Zvandaitya zvakandivinga;","poem":1},{"text":"zvandaizeza zvaitika kwandiri.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Handina rugare, handina runyararo;","poem":1},{"text":"handina zororo, asi nhamo chete.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}