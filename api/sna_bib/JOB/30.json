{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"“Asi zvino vanondiseka,","poem":1},{"text":"varume vaduku kwandiri,","poem":2},{"text":"vane madzibaba andaishora","poem":1},{"text":"zvokuti handaivaisa pakati pembwa dzinofudza makwai angu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ko, simba ramaoko avo raizondibatsirei,","poem":1},{"text":"sezvo simba ravo rakanga rapera?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vapererwa nokuda kwokushayiwa uye nenzara,","poem":1},{"text":"vakadzivaira usiku munyika yakaoma,","poem":2},{"lineBreak":true},{"text":"mumatongo nomunyika yakaparara.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vakaunganidza miriwo inovavira kubva mumakwenzi,","poem":1},{"text":"uye zvokudya zvavo zvakanga zviri mudzi womuti womurara.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vakabviswa pakati pavanhu vokwavo,","poem":1},{"text":"vachitukwa kunge vakanga vari mbavha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vakamanikidzwa kuti vagare mukati mehova dzakaoma,","poem":1},{"text":"pakati pamatombo nomumakomba, muvhu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vakarira samakwai pakati pamakwenzi,","poem":1},{"text":"uye vakamanikidzana pasi porukato.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vakanga vari vanhu vakazvidzika vasina zita,","poem":1},{"text":"vakadzingwa kubva munyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Uye zvino vanakomana vavo vanondiseka munziyo;","poem":1},{"text":"ndava shumo pakati pavo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vanondisema uye vanomira kure neni;","poem":1},{"text":"havazezi kundipfira mate kumeso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sezvo zvino Mwari akatsudunura uta hwangu uye akanditambudza,","poem":1},{"text":"havazvidzori pamberi pangu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kurudyi rwangu rudzi runondirwisa; vanoisira makumbo angu misungo, vanovaka michinjiziri yokurwa neni.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Vanoparadza mugwagwa wangu; vanobudirira pakundiparadza, pasina munhu anovabatsira.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Vanofamba zvavo kunge vanopinda napakakoromoka; pakati pamatongo vanongopinda zvavo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Zvinotyisa zvinondibata; kukudzwa kwangu kwabviswa sokunge nemhepo, kuchengetedzeka kwangu kwapera segore.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Uye zvino upenyu hwangu hwava kuguma; mazuva okutambudzika anondibata.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Usiku hunobaya mapfupa angu;","poem":1},{"text":"zvinondiruma-ruma zvinorwadza hazvizorori.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nesimba rake guru Mwari anova chipfeko kwandiri;","poem":1},{"text":"anondisunga somutsipa wenguo yangu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Anondikanda mumatope,","poem":1},{"text":"uye ndava seguruva namadota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ndinochema kwamuri, imi Mwari, asi hamundipinduri;","poem":1},{"text":"ndinosimuka, asi munongonditarisa zvenyu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Munondishandukira noutsinye;","poem":1},{"text":"munondirova nesimba roruoko rwenyu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Munondibvuta mondidzingira pamberi pemhepo;","poem":1},{"text":"munonditenderedza mudutu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndinoziva kuti muchandiburutsa muchindiendesa kurufu, kunzvimbo yakatsaurirwa vapenyu vose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Zvirokwazvo, hakuna munhu anobata munhu ari kushushikana","poem":1},{"text":"paanochemera rubatsiro pakutambudzika kwake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ko, handina kuchema nokuda kwevaitambura here?","poem":1},{"text":"Ko, mweya wangu hauna kuva neshungu pamusoro pavarombo here?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kunyange zvakadaro, pandakanga ndakarindira zvakanaka, zvakaipa zvakasvika;","poem":1},{"text":"pandakatarisira chiedza, ipapo rima rakasvika.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kumonyoroka kwoura hwangu hakumbomiri;","poem":1},{"text":"mazuva okutambudzika anondivinga.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ndinodzungaira ndichisvibiswa, asi kwete nezuva;","poem":1},{"text":"ndinosimuka pakati peungano ndichichemera rubatsiro.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ndava hama yamakava,","poem":1},{"text":"neshamwari yamazizi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ganda rangu riri kusviba uye riri kufunuka;","poem":1},{"text":"muviri wangu unopisa nefivha.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mbira dzangu dzava kungoridza nziyo dzokuchema,","poem":1},{"text":"uye nyere yangu nziyo dzokuungudza.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}