{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"“Ndakaita sungano nameso angu","poem":1},{"text":"kuti ndirege kutarisa musikana noruchiva.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nokuti mugove womunhu unobva kumusoro kuna Mwari ndoweiko,","poem":1},{"text":"iyo nhaka yake inobva kuna Wamasimba Ose?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ko, hakuzi kuparadzwa kwavakaipa,","poem":1},{"text":"nenjodzi kuna avo vanoita zvakaipa here?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ko, iye haaoni nzira dzangu","poem":1},{"text":"uye haaverengi nhambwe dzangu dzose here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Kana ndakafamba nenzira yenhema","poem":1},{"text":"kana kuti tsoka dzangu dzakamhanyira kunyengera,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwari ngaandiyere pachiyero chakatendeka","poem":1},{"text":"uye achaziva kuti handina mhosva,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kana tsoka dzangu dzakatsauka kubva pagwara,","poem":1},{"text":"kana kuti mwoyo wangu wakatevera meso angu,","poem":2},{"lineBreak":true},{"text":"kana kuti maoko angu akasvibiswa,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ipapo vamwe ngavadye zvandakadyara,","poem":1},{"text":"uye mbesa dzangu ngadzidzurwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kana mwoyo wangu wakanyengerwa nomukadzi,","poem":1},{"text":"kana kuti ndakavandira pamusuo wemuvakidzani wangu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ipapo mukadzi wangu ngaakuye zviyo zvomumwe murume,","poem":1},{"text":"uye vamwe varume ngavavate naye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokuti chingadai chiri chinhu chinonyadzisa,","poem":1},{"text":"chivi chinofanira kutongwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndiwo moto unopfuta kusvikira pakuparadzwa;","poem":1},{"text":"ungadai wakadzura mukohwo wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Kana ndichinge ndaramba kururamisira varanda vangu,","poem":1},{"text":"pavane mhaka neni,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ndichaita sei pandichasangana naMwari?","poem":1},{"text":"Ndichatiiko ndikanzi ndizvidavirire?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ko, iye akandiisa muchizvaro haazi iye akavaita here?","poem":1},{"text":"Ko, haazi iye mumwe chete akatiumba tose muna vanamai vedu here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Kana ndakaramba zvido zvevarombo","poem":1},{"text":"kana kurega meso echirikadzi achineta,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kana ndakazvidyira chingwa changu,","poem":1},{"text":"ndisingachigoverani nenherera,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"asi kubva paujaya hwangu ndakamurera sezvinoitwa nababa,","poem":1},{"text":"uye kubva pakuberekwa kwangu ndakatungamirira chirikadzi,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kana ndakaona mumwe achiparara nokuda kwokushaya zvokupfeka,","poem":1},{"text":"kana munhu anoshayiwa asina nguo,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"uye mwoyo wake ukasandiropafadza","poem":1},{"text":"nokuti adziyirwa namakushe amakwai angu,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kana ndakasimudzira nherera ruoko rwangu","poem":1},{"text":"ndichiziva kuti ndinozivikanwa padare redzimhosva,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ipapo ruoko rwangu ngaruwe papfudzi rangu,","poem":1},{"text":"ruwire pasi napafundo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nokuti ndaitya kuparadza kunobva kuna Mwari,","poem":1},{"text":"uye handina kuita zvinhu zvakadaro nokuti ndaitya kubwinya kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Kana ndakaisa chivimbo changu pagoridhe,","poem":1},{"text":"kana kuti kugoridhe rakaisvonaka ndikati, ‘Ndiwe chivimbo changu,’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"kana ndakafadzwa nepfuma yangu huru,","poem":1},{"text":"mukomborero wakabva mumaoko angu,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kana ndakava nehanya nezuva pakubwinya kwaro,","poem":1},{"text":"kana mwedzi uchifamba mukubwinya,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"zvokuti mwoyo wangu wakanyengereka pakavanda,","poem":1},{"text":"uye ruoko rwangu rukazviremekedza nokuzvisveta,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"zvino izvozviwo zvingangova zvivi zvinofanira kutongwa,","poem":1},{"text":"nokuti ndainge ndisina kutendeka kuna Mwari wokumusoro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Kana ndakafadzwa nokurasikirwa kwomuvengi wangu,","poem":1},{"text":"kana kufara zvikuru pamusoro penhamo yakamuwira,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"handina kutendera muromo wangu kutadza,","poem":1},{"text":"nokudana chituko pamusoro poupenyu hwake,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"kana vanhu veimba yangu vasina kumboti,","poem":1},{"text":"‘Ndianiko asina kumbogutswa nenyama yaJobho?’","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Hapana mutorwa akavata usiku hwose munzira dzomumusha,","poem":1},{"text":"nokuti musuo wangu wakaramba wakazarurirwa vashanyi.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kana ndakavanza chivi changu saAdhamu,","poem":1},{"text":"nokuviga mhosva yangu mumwoyo mangu,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"nokuda kwokuti ndaitya kwazvo vanhu vazhinji,","poem":1},{"text":"uye ndakatya kwazvo kuzvidza kwevemhuri,","poem":2},{"lineBreak":true},{"text":"zvokuti ndakaramba ndinyerere ndikasabuda kunze,","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“Haiwa, dai ndaiva nomumwe angandinzwa!","poem":1},{"text":"Ndinonyora runyoro rwangu ndichizvidzivirira iye zvino,","poem":2},{"lineBreak":true},{"text":"Wamasimba Ose ngaandipindure;","poem":2},{"lineBreak":true},{"text":"mupomeri wangu ngaanyore rugwaro rwezvaanondipomera.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Zvirokwazvo ndairutakura pamapfudzi angu,","poem":1},{"text":"ndairupfeka sekorona.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ndaimupa kuzvidavirira kwangu kwenhambwe imwe neimwe;","poem":1},{"text":"ndaiswedera kwaari somuchinda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“Kana munda wangu ukadanidzira kwandiri uchindipa mhosva,","poem":1},{"text":"uye miforo yose ikanyorova nemisodzi,","poem":2}]},{"type":"verse","number":39,"content":[{"text":"kana ndakadya zvibereko zvawo ndisingaripi,","poem":1},{"text":"kana ndakaparadza upenyu hwavanourima,","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ipapo rukato ngarumere pachinzvimbo chegorosi,","poem":1},{"text":"nesora pachinzvimbo chebhari.”","poem":2},"Mashoko aJobho apera."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}