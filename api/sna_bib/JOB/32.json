{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":["Saka varume vatatu ava vakarega kupindura Jobho, nokuti akanga akarurama pakuona kwake."]},{"type":"verse","number":2,"content":["Asi Erihu mwanakomana waBharakeri muBhuzi, wemhuri yaRami, akatsamwira Jobho zvikuru nokuda kwokuzviruramisira kwake panzvimbo yokuti zviitwe naMwari."]},{"type":"verse","number":3,"content":["Akatsamwirawo kwazvo shamwari nhatu idzi, nokuti vakanga vashayiwa nzira yokupikisa nayo Jobho, kunyange vakanga vambomupa mhosva."]},{"type":"verse","number":4,"content":["Zvino Erihu akanga ambomira kutaura naJobho nokuti ivo vaiva vakuru kwaari."]},{"type":"verse","number":5,"content":["Asi paakaona kuti varume vatatu ava vakanga vasisinazve chokureva, hasha dzake dzakamuka."]},{"type":"verse","number":6,"content":["Saka Erihu mwanakomana waBharakeri muBhuzi akati:",{"text":"“Ndiri muduku pamakore,","poem":1},{"text":"uye imi muri vakuru;","poem":2},{"lineBreak":true},{"text":"ndokusaka ndanga ndichitya,","poem":2},{"lineBreak":true},{"text":"ndisingadi kukuudzai zvandinoziva.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndakafunga kuti, ‘Zera rinofanira kutaura;","poem":1},{"text":"makore mazhinji anofanira kudzidzisa uchenjeri.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asi ndiwo mweya uri mumunhu,","poem":1},{"text":"kufema kwaWamasimba Ose, kunomupa kunzwisisa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Havazi vakuru bedzi vakachenjera,","poem":1},{"text":"kana vatana chete vanganzwisisa zvakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Naizvozvo ndinoti: Nditeererei;","poem":1},{"text":"neniwo ndichakuudzai zvandinoziva.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndakambomirira pamaitaura,","poem":1},{"text":"ndakateerera pfungwa dzenyu;","poem":2},{"lineBreak":true},{"text":"pamakanga muchitsvaka mashoko,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ndakanyatsokuteererai.","poem":1},{"text":"Asi hakuna mumwe wenyu akapwisa Jobho;","poem":2},{"lineBreak":true},{"text":"hakuna pamuri akapindura mashoko ake zvinogutsa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Regai kuti, ‘Tawana uchenjeri;","poem":1},{"text":"regai Mwari amukonese, kwete munhu.’","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Asi Jobho haana kunongedza mashoko ake kwandiri,","poem":1},{"text":"uye handingamupinduri namashoko enyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Vashamiswa uye havachina chokureva;","poem":1},{"text":"vapererwa namashoko.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ko, zvino ini ndingamirira here ivo zvavangonyarara,","poem":1},{"text":"zvino zvavangomira ipapo vasina mhinduro?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Neniwo ndichava nechokutaura;","poem":1},{"text":"neniwo ndichareva zvandinoziva.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nokuti ndizere namashoko,","poem":1},{"text":"uye mweya uri mandiri unondimanikidza;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"mukati mangu ndafanana newaini iri muhomwe yakadzivirwa,","poem":1},{"text":"sehomwe itsva dzewaini dzoda kuparuka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndinofanira kutaura kuti ndirerukirwe;","poem":1},{"text":"ndinofanira kushamisa muromo wangu ndigopindura.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Handina munhu wandichatsaura,","poem":1},{"text":"uye handingabati kumeso munhu upi zvake;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"nokuti dai ndaiva nyanzvi yokubata kumeso,","poem":1},{"text":"Muiti wangu aizokurumidza kunditora.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}