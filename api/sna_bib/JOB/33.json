{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"“Asi zvino, Jobho, chinzwa mashoko angu;","poem":1},{"text":"rerekera nzeve yako pane zvose zvandinoreva.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndava kuchizoshamisa muromo wangu;","poem":1},{"text":"mashoko angu ari pamuromo worurimi rwangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mashoko angu anobva pamwoyo wakarurama;","poem":1},{"text":"muromo wangu uchataura chokwadi chandinoziva.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mweya waMwari wakandiita;","poem":1},{"text":"kufema kwaWamasimba Ose kunondipa upenyu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndipindure zvino, kana uchigona;","poem":1},{"text":"zvigadzirire ugomisidzana neni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ini ndakangoita sewe pamberi paMwari;","poem":1},{"text":"neniwo ndakatorwa muvhu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kutyisa kwangu hakufaniri kukuvhundutsa,","poem":1},{"text":"uye ruoko rwangu harufaniri kukuremera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Asi wakati ini ndichizvinzwa,","poem":1},{"text":"ndakanzwa mashoko acho chaiwo,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"‘Ndakachena uye handina chivi;","poem":1},{"text":"ndakanaka uye handina mhosva.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asi Mwari awana mhosva neni;","poem":1},{"text":"anonditi muvengi wake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anosunga makumbo angu nezvisungo;","poem":1},{"text":"anocherechedza nzira dzangu dzose.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Asi ndinokuudza kuti pachinhu ichi hauna kururama,","poem":1},{"text":"nokuti Mwari mukuru kukunda munhu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Seiko uchimunyunyutira","poem":1},{"text":"kuti haasi kupindura mashoko omunhu?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nokuti Mwari anotaura zvino neimwe nzira,","poem":1},{"text":"pane imwe nguva neimwe nzira,","poem":2},{"lineBreak":true},{"text":"kunyange munhu asingazvioni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mukurota, uye muchiratidzo chousiku,","poem":1},{"text":"hope huru padzinowira vanhu,","poem":2},{"lineBreak":true},{"text":"pavanotsimwaira pamibhedha yavo,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"angangotaura munzeve dzavo uye","poem":1},{"text":"agovavhundutsa neyambiro zhinji,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kuti adzore munhu pakuita zvakaipa,","poem":1},{"text":"uye nokuita kuti arege kuzvikudza,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kuti achengetedze mweya wake pagomba,","poem":1},{"text":"uye kuti upenyu hwake hurege kuparadzwa nomunondo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kana kuti munhu angarangwa panhoo yokurwadziwa,","poem":1},{"text":"achiramba achitambudzika mumapfupa ake,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"saka upenyu hwake chaihwo hunosemburwa nezvokudya,","poem":1},{"text":"uye mweya wake unosema zvokudya zvakaisvonaka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Anoonda kusvikira apera,","poem":1},{"text":"uye mapfupa ake, akanga asingaonekwi, zvino obuda kunze.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mweya wake unoswedera kugomba,","poem":1},{"text":"uye upenyu hwake kunhume dzorufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Asi kana kurutivi rwake kuine mutumwa somurevereri,","poem":1},{"text":"mumwe kubva muchiuru, kuti audze munhu zvakamunakira,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kuti amunzwire tsitsi agoti,","poem":1},{"text":"‘Murwirei kuti arege kuenda kugomba;","poem":2},{"lineBreak":true},{"text":"ndamuwanira dzikinuro,’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ipapo nyama yake inovandudzwa ikafanana neyomwana;","poem":1},{"text":"inovandudzwa ikaita sapamazuva oujaya hwake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Anonyengetera kuna Mwari agowana nyasha kwaari,","poem":1},{"text":"anoona chiso chaMwari agopembera nomufaro;","poem":2},{"lineBreak":true},{"text":"anodzoserwazve kururama kwake naMwari.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ipapo anosvika kuvanhu agoti,","poem":1},{"text":"‘Ndakatadza, uye ndakaminamisa zvakanga zvakarurama,","poem":2},{"lineBreak":true},{"text":"asi handina kuwana zvaindikodzera.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Akadzikinura mweya wangu pakupinda mugomba,","poem":1},{"text":"uye ndichararama ndichifadzwa nechiedza.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Mwari anoita zvinhu zvose izvi kumunhu,","poem":1},{"text":"kaviri, kunyange katatu,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"kudzora mweya wake pakupinda mugomba,","poem":1},{"text":"kuti chiedza choupenyu chivhenekere paari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Chinzwa, Jobho, uye urerekere nzeve dzako kwandiri;","poem":1},{"text":"nyarara, uye ini ndichataura.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kana unacho chokureva, ndipindure;","poem":1},{"text":"taurisa, nokuti ndinoda kuti ururamisirwe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Asi kana zvisakadaro, chinzwa zvino kwandiri;","poem":1},{"text":"nyarara, uye ndichakudzidzisa uchenjeri.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}