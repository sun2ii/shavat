{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":["Ipapo Erihu akati:"]},{"type":"verse","number":2,"content":[{"text":"“Inzwai mashoko angu, imi vanhu vakachenjera;","poem":1},{"text":"nditeererei, imi vanhu vedzidzo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti nzeve inoedza mazwi","poem":1},{"text":"sokuravira kunoita rurimi chokudya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngatinzverei pachedu kuti chakarurama ndechipi;","poem":1},{"text":"ngatidzidzei pamwe chete kuti chakanaka ndechipi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Jobho anoti, ‘Handina mhosva,","poem":1},{"text":"asi Mwari anoramba kundiruramisira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kunyange ndakarurama,","poem":1},{"text":"ndinonzi ndiri murevi wenhema;","poem":2},{"lineBreak":true},{"text":"kunyange ndisina mhaka,","poem":2},{"lineBreak":true},{"text":"museve wake unobaya ronda risingarapiki.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndianiko munhu akaita saJobho,","poem":1},{"text":"anonwa kushorwa semvura?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anofambidzana navanoita zvakaipa;","poem":1},{"text":"anowirirana navanhu vakaipa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuti anoti, ‘Munhu haana chaanobatsirwa nacho,","poem":1},{"text":"paanoedza kufadza Mwari.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Saka nditeererei, imi vanhu vokunzwisisa.","poem":1},{"text":"Mwari haangatongoiti zvakaipa, Wamasimba Ose haangatongokanganisi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anoripira munhu pane zvaanenge aita;","poem":1},{"text":"anoisa pamusoro pake zvakakodzera mafambiro ake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hazvingatongogoni kuti Mwari angaita zvakaipa,","poem":1},{"text":"kuti Wamasimba Ose angaminamisa kururamisira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndianiko akamugadza pamusoro penyika?","poem":1},{"text":"Ndianiko akamuita mutariri wepasi pose?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kana kwaiva kufunga kwake,","poem":1},{"text":"uye akatora mweya wake nokufema kwake,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"marudzi ose avanhu aiparara pamwe chete,","poem":1},{"text":"uye munhu aizodzokerazve kuguruva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Kana uchinzwisisa teerera izvi;","poem":1},{"text":"chinzwa zvandinoreva.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ko, munhu anovenga kururamisira angatonga here?","poem":1},{"text":"Ko, muchapomera akarurama uye ane simba here?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ko, haazi iye anoti kumadzimambo, ‘Hamubatsiri imi,’","poem":1},{"text":"uye kumakurukota, ‘Makaipa imi,’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"asingaitiri machinda zvakanaka nokuti machinda,","poem":1},{"text":"uye asingaitiri zvakanaka vapfumi kupfuura varombo,","poem":2},{"lineBreak":true},{"text":"nokuti vose ibasa ramaoko ake?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Vanofa kamwe kamwe, pakati pousiku;","poem":1},{"text":"vanhu vanovhundutswa vagoparara;","poem":2},{"lineBreak":true},{"text":"vane simba vanobviswa zvisingaitwi noruoko rwomunhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Meso ake ari panzira dzavanhu;","poem":1},{"text":"anoona nhambwe imwe neimwe yavo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hakuna nzvimbo ine rima,","poem":1},{"text":"hakuna mumvuri wakadzama,","poem":2},{"lineBreak":true},{"text":"pangavanda vaiti vezvakaipa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mwari haanei nezvokuedzazve vanhu,","poem":1},{"text":"kuti vauye vamire pamberi pake vagotongwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Anoparadza vane simba asina kumbobvunza,","poem":1},{"text":"agogadza vamwe panzvimbo yavo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nokuti anocherechedza mabasa avo,","poem":1},{"text":"anovabvisa usiku uye vanopwanyiwa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Anovaranga nokuda kwokuipa kwavo,","poem":1},{"text":"pavanoonekwa nomunhu wose,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"nokuti vakatsauka pakumutevera","poem":1},{"text":"uye havana kuva nehanya kana neimwe yenzira dzake.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Vakakonzera kuchema kwavarombo kuti kusvike pamberi pake,","poem":1},{"text":"zvokuti akanzwa kuchema kwavanoshayiwa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Asi kana akaramba anyerere ndiani angamupa mhosva?","poem":1},{"text":"Kana akavanza chiso chake, ndianiko angamuona?","poem":2},{"lineBreak":true},{"text":"Zvakadaro iye ari pamusoro pazvose, munhu nendudzi,","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"kuti abvise munhu asina umwari pakutonga,","poem":2},{"lineBreak":true},{"text":"kuti asaisira vanhu misungo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Ngatiti munhu oti kuna Mwari,","poem":1},{"text":"‘Ndine mhaka asi handichatadzazve.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ndidzidzisei zvandisingagoni kuona;","poem":1},{"text":"kana ndakaita zvakaipa, handichazviitizve.’","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ko, Mwari angafanira kukupa mubayiro sezvaunoda iwe here,","poem":1},{"text":"zvaunoramba kutendeuka?","poem":2},{"text":"Unofanira kusarudza iwe, kwete ini;","poem":1},{"text":"saka nditaurire zvaunoziva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Imi vanhu vokunzwisisa taurai,","poem":1},{"text":"vanhu vakachenjera munondinzwa muti kwandiri,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"‘Jobho anotaura asina zivo; mashoko ake haana uchenjeri.’","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Haiwa, dai Jobho aedzwa kusvikira pakupedzisira,","poem":1},{"text":"nokuti anopindura somunhu akaipa!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Pachivi chake anowedzera kumukira;","poem":1},{"text":"anouchira maoko ake pakati pedu sezvisina basa,","poem":2},{"lineBreak":true},{"text":"uye anowedzera mashoko ake okurwa naMwari.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}