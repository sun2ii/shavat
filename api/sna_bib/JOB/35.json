{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["Ipapo Erihu akati:"]},{"type":"verse","number":2,"content":[{"text":"“Unofunga kuti izvi zvakarurama here? Iwe zvaunoti, ‘Ndichanzi ndakarurama naMwari.’","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kunyange zvakadaro unomubvunza uchiti, ‘Zvinondibatsirei, uye ndinowaneiko nokusatadza.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ndinoda kupindura iwe","poem":1},{"text":"neshamwari dzako dzaunadzo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tarira kumatenga uone;","poem":1},{"text":"nanʼanidza makore ari pamusoro pako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kana ukatadza, zvinomurwadza zvakadiniko?","poem":1},{"text":"Kana zvivi zvako zvikawanda, zvinoita sei kwaari?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kana wakarurama, unomupeiko iye,","poem":1},{"text":"kana kuti anogamuchireiko kubva muruoko rwako?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kuipa kwako kunongobata munhu akaita sewe,","poem":1},{"text":"uye kururama kwako ndekwomwanakomana wavanhu chete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Vanhu vanoridza mhere vari pasi pomutoro wokumanikidzwa;","poem":1},{"text":"vanokumbira kusunungurwa kubva muruoko rwoune simba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asi hakuna munhu anoti, ‘Aripiko Mwari Muiti wangu,","poem":1},{"text":"anopa nziyo panguva yousiku,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"anodzidzisa zvakawanda kwatiri kupfuura mhuka dzenyika","poem":1},{"text":"uye anotiita vakachenjera kupfuura shiri dzedenga.’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Haapinduri kana vanhu vachiridza mhere,","poem":1},{"text":"nokuda kwokuzvikudza kwavakaipa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zvirokwazvo, Mwari haateereri chikumbiro chavo chisina maturo;","poem":1},{"text":"Wamasimba Ose haazviteereri izvozvo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndoda, zvino, haangateereri","poem":1},{"text":"kana uchiti hausi kumuona,","poem":2},{"lineBreak":true},{"text":"mhaka yako iri pamberi pake","poem":2},{"lineBreak":true},{"text":"zvokuti unofanira kumumirira,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"uyezve, kuti kutsamwa kwake hakumborangi,","poem":1},{"text":"uye haana hanya zvake nezvakaipa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Saka Jobho anoshamisa muromo wake achitaura zvisina maturo;","poem":1},{"text":"anowanza mashoko ake asina zivo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}