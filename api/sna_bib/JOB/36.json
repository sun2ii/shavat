{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["Erihu akaenderera mberi achiti:"]},{"type":"verse","number":2,"content":[{"text":"“Imbondiitirai mwoyo murefu kwechimwezve chinguva,","poem":1},{"text":"ipapo ndichakuratidzai","poem":2},{"lineBreak":true},{"text":"kuti pane zvimwe zvakawanda zvokutaura, ndakamiririra Mwari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ruzivo rwangu runobva kure;","poem":1},{"text":"ndichati Muiti wangu akarurama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Muzive kuti mashoko angu haasi enhema;","poem":1},{"text":"akakwana pazivo ari pakati penyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Mwari ane simba asi haazvidzi vanhu;","poem":1},{"text":"ane simba, uye anozadzisa zvaakaronga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Haaregi vakaipa vari vapenyu,","poem":1},{"text":"asi anopa vanotambudzika kodzero dzavo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Haabvisi meso ake pane vakarurama;","poem":1},{"text":"anovagadza pamwe chete namadzimambo","poem":2},{"lineBreak":true},{"text":"uye anovasimudzira nokusingaperi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asi kana vanhu vakasungwa nengetani,","poem":1},{"text":"vakabatwa zvakasimba netambo dzokutambudzika,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"iye anovaudza zvavanenge vaita,","poem":1},{"text":"kuti vatadza nokuzvikudza zvikuru.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anovaita kuti vateerere kurayirwa,","poem":1},{"text":"uye anovarayira kuti vatendeuke pane zvakaipa zvavo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kana vakateerera uye vakamushumira,","poem":1},{"text":"vachapedza mazuva avo ose mukubudirira","poem":2},{"lineBreak":true},{"text":"uye makore avo vari mukugutsikana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi kana vasingateereri,","poem":1},{"text":"vachapera nomunondo,","poem":2},{"lineBreak":true},{"text":"uye vachafa vasina zivo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Vasina umwari mumwoyo yavo vanochengeta pfundipfundi,","poem":1},{"text":"kunyange paanovasunga,","poem":2},{"lineBreak":true},{"text":"havaridzi mhere kuti vabatsirwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vanofa panguva yeujaya hwavo,","poem":1},{"text":"pakati pezvifeve zvechirume zvepashongwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asi vaya vanotambudzika anovarwira pakutambudzika kwavo;","poem":1},{"text":"anotaura kwavari panguva yokurwadziwa kwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Ari kukukwezva kubva pamuromo wenhamo,","poem":1},{"text":"kuti akuise panzvimbo yakasununguka isina zvipinganidzo,","poem":2},{"lineBreak":true},{"text":"pazvivaraidzo zvetafura yenyu izere nezvokudya zvakaisvonaka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Asi zvino waremedzwa nokutonga kwakafanira vakaipa;","poem":1},{"text":"kutonga uye kururamisira zvakubata iwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uchenjere kuti parege kuva nomunhu anokunyengera nepfuma;","poem":1},{"text":"usarega fufuro huru ichikutsausa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ko, pfuma yako kana kushingaira kwesimba rako","poem":1},{"text":"zvingakutsigira kuti urege kutambudzika here?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Rega kushuva usiku,","poem":1},{"text":"kuti ukwekweredzere vanhu kure nemisha yavo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Chenjera kuti urege kudzokera kune zvakaipa,","poem":1},{"text":"izvo zvaunoda pachinzvimbo chokutambudzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Tarira, Mwari anosimudzirwa musimba rake.","poem":1},{"text":"Ndianiko mudzidzisi akafanana naye?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndianiko akamuratidza nzira dzake,","poem":1},{"text":"kana akati kwaari, ‘Makanganisa imi?’","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Rangarira kukudza basa rake,","poem":1},{"text":"iro rakarumbidzwa navanhu munziyo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Marudzi ose avanhu akariona;","poem":1},{"text":"vanhu vanoritarisa vari kure.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Haiwa, Mwari mukuru kupfuura kunzwisisa kwedu!","poem":1},{"text":"Kuwanda kwamakore ake hakuverengeki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Anokwevera madonhwe emvura kumusoro,","poem":1},{"text":"anoshanduka achinaya semvura kuhova;","poem":2}]},{"type":"verse","number":28,"content":[{"text":"makore anodurura unyoro hwawo","poem":1},{"text":"uye mvura yakawanda inonaya pamusoro pavanhu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ndianiko anganzwisisa kuparadzira kwaanoita makore,","poem":1},{"text":"namatinhiriro aanoita ari mudenga rake?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tarirai maparadziro aanoita mheni yake pamativi ake,","poem":1},{"text":"ichituhwina makadzika megungwa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ndiyo nzira yaanotonga nayo ndudzi","poem":1},{"text":"neyaanodziriritira nayo nezvokudya zvakawanda.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Anozadza maoko ake nemheni","poem":1},{"text":"agorayira kuti irove paanoda.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kutinhira kwake kunozivisa dutu remvura riri kuuya;","poem":1},{"text":"kunyange mombe dzinoratidza kusvika kwaro.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}