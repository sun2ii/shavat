{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"“Hana yangu inorova nokuda kwezvizvi,","poem":1},{"text":"uye mwoyo wangu unotomuka uchibva panzvimbo yawo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Teererai! Teererai kutinhira kwenzwi rake,","poem":1},{"text":"nokuunga kunobva pamuromo wake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anoregedzera mheni yake pasi pedenga rose,","poem":1},{"text":"agoituma kumigumo yenyika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shure kwaizvozvo inzwi rokutinhira kwake rinosvika;","poem":1},{"text":"anotinhira nenzwi roumambo hwake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inzwi raMwari rinotinhira nenzira dzinoshamisa;","poem":1},{"text":"iye anoita zvinhu zvikuru zvinopfuura kunzwisisa kwedu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anoti kuchando, ‘Donhera panyika,’","poem":1},{"text":"nokumvura inonaya, ‘Naya nesimba.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kuitira kuti vanhu vose vaakasika vazive basa rake,","poem":1},{"text":"anoita kuti munhu mumwe nomumwe ambomira kushanda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mhuka dzinovanda;","poem":1},{"text":"dzinoramba dziri mumapako adzo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dutu rinobuda pakamuri yaro,","poem":1},{"text":"chando chinobva pakuvhuvhuta kwemhepo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kufema kwaMwari kunobudisa mazaya echando,","poem":1},{"text":"uye mvura zhinji inooma kuita chando.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anozadza makore nounyoro;","poem":1},{"text":"anoparadzira mheni yake nomumakore.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anoafambisa sezvaanoda pamusoro penyika yose,","poem":1},{"text":"kuti aite zvose zvaanoarayira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anouyisa makore kuzoranga vanhu,","poem":1},{"text":"kana kuzodiridza nyika yake kuti aratidze rudo rwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Teerera izvi, Jobho;","poem":1},{"text":"imbomira ugorangarira zvishamiso zvaMwari.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Unoziva here kudzorwa kwamakore naMwari","poem":1},{"text":"nokupenyesa kwaanoita mheni yake?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Unoziva maturikirwo akaitwa makore here,","poem":1},{"text":"izvo zvishamiso zvaiye akakwana muruzivo?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iyewe unopiswa nenguo dzako","poem":1},{"text":"nyika painonyaradzwa nemhepo yezasi,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ko, ungagona kubatana naye pakutatamura matenga here,","poem":1},{"text":"iwo akaoma kunge chionioni chendarira yakaumbwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Tiudze zvatingareva kwaari;","poem":1},{"text":"hatigoni kureva mhaka yedu nokuda kwerima redu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ko, anofanira kuudzwa kuti ndinoda kutaura here?","poem":1},{"text":"Ko, pano munhu angakumbira kumedzwa here?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Zvino hakuna munhu angatarira kuzuva,","poem":1},{"text":"nokuvhenekera kwaro riri mumatenga,","poem":2},{"lineBreak":true},{"text":"mushure mokunge mhepo yaachenesa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Anouya nokubwinya kunoyevedza achibva nokumusoro;","poem":1},{"text":"Mwari anouya nokubwinya kunotyisa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wamasimba Ose haasvikiki kwaari uye anokudzwa nesimba;","poem":1},{"text":"mukururamisira uye nokururama kwake kukuru haadzvinyiriri.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Naizvozvo, vanhu vanomutya,","poem":1},{"text":"ko, haana hanya navose vakachenjera pamwoyo here?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}