{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"verse","number":1,"content":["Ipapo Jehovha akapindura Jobho ari mudutu akati:"]},{"type":"verse","number":2,"content":[{"text":"“Ndianiko uyu anodzimaidza zano rangu","poem":1},{"text":"namashoko asina zivo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Chizvishingisa somurume;","poem":1},{"text":"ini ndichakubvunza,","poem":2},{"lineBreak":true},{"text":"uye iwe uchandipindura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Iwe wakanga uripi pandakaisa nheyo dzenyika?","poem":1},{"text":"Ndiudze, kana uchinzwisisa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndianiko akatara miganhu yacho?","poem":1},{"text":"Zvirokwazvo unozviziva!","poem":2},{"lineBreak":true},{"text":"Ndianiko akaiyera nerwodzi?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ko, nheyo dzayo dzakanga dzimire pai,","poem":1},{"text":"kana kuti ndianiko akaisa ibwe rapakona,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"panguva yaiimba nyeredzi dzamangwanani pamwe chete,","poem":1},{"text":"uye vanakomana vaMwari vose vachipembera nomufaro?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ndianiko akapfigira gungwa mikova","poem":1},{"text":"parakatsemuka richibva muchizvaro,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"pandakaita makore kuti ave nguo yaro,","poem":1},{"text":"uye ndikariputira murima guru,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"pandakariisira miganhu yaro,","poem":1},{"text":"uye ndikaisa makonhi aro namazariro panzvimbo yawo,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"pandakati, ‘Apa ndipo paunosvika uye haungapfuuri;","poem":1},{"text":"pano ndipo panoguma kuzvikudza kwamafungu ako’?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Wakambopa mutemo kumangwanani here,","poem":1},{"text":"kana kuratidza mambakwedza nzvimbo yawo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kuti abate mipendero yenyika,","poem":1},{"text":"uye azungunuse vakaipa kuti vabve mairi?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nyika inoumbika sevhu pasi pechisimbiso;","poem":1},{"text":"mamiriro ayo anoita senguo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vakaipa vanonyimwa chiedza chavo,","poem":1},{"text":"uye ruoko rwavo rwakasimudzwa rwavhunika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Wakamboshanyira zvitubu zvegungwa here,","poem":1},{"text":"kana kufamba kwakanyarara kwokwakadzika?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ko, masuo orufu wakamboaratidzwa here?","poem":1},{"text":"Wakamboona masuo omumvuri worufu here?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wati wanzwisisa upamhi hwenzvimbo dzenyika here?","poem":1},{"text":"Ndiudze kana uchiziva zvose izvi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ko, nzira inoenda kunogara chiedza ndeipi?","poem":1},{"text":"Ko, rima rinogarepi?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ungagona kuzviisa kunzvimbo yazvo here?","poem":1},{"text":"Unoziva nzira inoenda kwazvinogara here?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Zvirokwazvo iwe unoziva, nokuti wakanga waberekwa kare!","poem":1},{"text":"Wararama kwamakore mazhinji kwazvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Wakambopinda mudura rechando here,","poem":1},{"text":"kana kuona dura rechimvuramabwe,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"izvo zvandakachengetera nguva dzokutambudzika,","poem":1},{"text":"mazuva ehondo neokurwa?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ko, nzira inoenda kunogoverwa mheni ndeipi,","poem":1},{"text":"kana nzvimbo inoparadzirwa mhepo dzokumabvazuva pamusoro penyika?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndianiko anodziura mugero wemvura zhinji,","poem":1},{"text":"nenzira yechimvuramabwe,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kuti zvidiridze nyika isingagarwi nomunhu,","poem":1},{"text":"gwenga risina munhu mariri,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kugutsa nyika yakaparadzwa","poem":1},{"text":"nokuita kuti imere uswa?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ko, mvura ina baba here?","poem":1},{"text":"Ndianiko baba vemadonhwe edova?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Chando chinobva muchizvaro chaaniko?","poem":1},{"text":"Ndianiko anobereka mazaya echando achibva kudenga,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"panooma mvura ikaita sedombo,","poem":1},{"text":"pamusoro pokwakadzika pachioma nechando?","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Ungagona kusunga nyeredzi dzeChimutanhatu here?","poem":1},{"text":"Iwe ungasunungura mabote eOrioni here?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ungabudisa mapoka enyeredzi panguva yadzo here,","poem":1},{"text":"kana kutungamirira Akuturo navana vayo?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Unoziva mitemo yokumatenga here?","poem":1},{"text":"Ungagona kumisa umambo hwaMwari pamusoro penyika here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Ko, iwe ungasvitsa inzwi rako kumakore here,","poem":1},{"text":"uye ugozvifukidza namafashamu emvura?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ko, iwe unotuma mheni panzira yayo here?","poem":1},{"text":"Ko, zvinodzoka kuzokuzivisa iwe here kuti isu tiri pano?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ndianiko akaisa uchenjeri mumwoyo,","poem":1},{"text":"kana kupa kunzwisisa kundangariro?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ndianiko ane uchenjeri hwokuverenga makore?","poem":1},{"text":"Ndianiko angagona kuteura matende emvura okudenga,","poem":2}]},{"type":"verse","number":38,"content":[{"text":"kana guruva raoma,","poem":1},{"text":"uye mavhinga enyika anamatirana?","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Ko, iwe ungavhimira shumbakadzi chokudya here,","poem":1},{"text":"uye ungagutsa shumba panzara yadzo here,","poem":2}]},{"type":"verse","number":40,"content":[{"text":"kana dzichitsivama mumapako adzo","poem":1},{"text":"kana kuti dzakavandira mudenhere?","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ndianiko anopa gunguo zvokudya","poem":1},{"text":"kana vana varo vachichema kuna Mwari,","poem":2},{"lineBreak":true},{"text":"uye vachidzungaira pose pose nokushayiwa zvokudya?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}