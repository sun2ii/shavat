{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"“Iwe unoziva nguva inobereka ngururu here?","poem":1},{"text":"Unocherechedza kana nondo dzichibereka vana vadzo here?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Unoverenga mwedzi kusvikira dzabereka here?","poem":1},{"text":"Unoziva nguva yadzinobereka here?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dzinotsivama pasi dzigobereka vana vadzo;","poem":1},{"text":"kurwadziwa kwadzo kwapera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vana vadzo vanowanda vagokura vakasimba musango;","poem":1},{"text":"vanoenda uye havadzokizve.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ndianiko akaregedza mbizi ichienda?","poem":1},{"text":"Ndianiko akasunungura tambo dzayo?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndakaipa renje kuti uve musha wayo,","poem":1},{"text":"nyika yomunyu sougaro hwayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inoseka bope riri muguta;","poem":1},{"text":"hainzwi kudaidzira kwomuchairi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inoita zvikomo mafuro ayo","poem":1},{"text":"uye inotsvaka zvinhu zvose zvinenge zvakapfumvudza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ko, nyati ingabvuma kukushandira here?","poem":1},{"text":"Ko, ingagara mudanga rako usiku here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ko, ungagona kuifambisa mumiforo namahanisi here?","poem":1},{"text":"Ko, ingarima mipata mushure mako here?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ungavimba nesimba rayo guru here?","poem":1},{"text":"Ko, ungaisiyira basa rako rinorema here?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ungavimba nayo kuti ikutakurire zviyo zvako","poem":1},{"text":"uye igozviunza paburiro rako here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Mapapiro emhou anopapama nomufaro mukuru,","poem":1},{"text":"asi haangaenzaniswi namapapiro uye neminhenga yedambiramurove.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Zvirokwazvo inokandira mazai ayo muvhu","poem":1},{"text":"igoarega achidziyirwa mujecha,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"isina hanya kuti rutsoka rungaapwanya,","poem":1},{"text":"kana kuti mhuka dzesango dzingaatsika.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inobata vana vayo noukasha, kunge vasati vari vayo;","poem":1},{"text":"haina hanya kuti yakatambudzika pasina,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"nokuti Mwari haana kuisa njere mairi","poem":1},{"text":"kana kuipa mugove wepfungwa dzakanaka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Asi kana ikatambanudza mapapiro ayo kuti imhanye,","poem":1},{"text":"inoseka bhiza nomutasvi waro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Iwe unopa bhiza simba raro","poem":1},{"text":"kana kushongedza mutsipa waro nezenze rinopepereka here?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndiwe unoita kuti rikwakuke semhashu,","poem":1},{"text":"richivhundutsira nokupfeza, kwokuzvikudza kwaro here?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Rinoteta risingatyi, richifarira simba raro,","poem":1},{"text":"rigobuda richienda kundorwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Rinoseka kutya, harina charinotya;","poem":1},{"text":"haritizi munondo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Goba remiseve rinorira parutivi paro,","poem":1},{"text":"pamwe chete nepfumo nebakatwa zvinovaima.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Neshungu rinodya ivhu;","poem":1},{"text":"harigoni kumira rakadzikama","poem":2},{"lineBreak":true},{"text":"kana richinzwa kurira kwehwamanda.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Pakurira kwehwamanda rinopfeza, roti, ‘Hekani!’","poem":1},{"text":"Rinofembedza hwema hwehondo ichiri kure,","poem":2},{"lineBreak":true},{"text":"kudanidzira kwavakuru vehondo nemheremhere yehondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Ko, rukodzi runobhururuka nouchenjeri hwako here","poem":1},{"text":"parunotambanudza mapapiro arwo rwakananga zasi?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ko, gondo rinobhururuka nokuda kwokurayira kwako here","poem":1},{"text":"richindovaka dendere raro pakakwirira?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Rinogara pamawere uye rinovatapo usiku;","poem":1},{"text":"shongwe yedombo ndiyo nhare yaro.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Riri ipapo rinotsvaka zvokudya zvaro;","poem":1},{"text":"meso aro anozviona zvichiri kure.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Vana varo vanodya ropa,","poem":1},{"text":"uye pane chakaurayiwa ndipo pariri.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}