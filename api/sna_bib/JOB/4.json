{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["Ipapo Erifazi muTemani akapindura achiti:"]},{"type":"verse","number":2,"content":[{"text":"“Kana mumwe munhu akava neshoko newe,","poem":1},{"text":"iwe uchashayiwa mwoyo murefu here?","poem":2},{"lineBreak":true},{"text":"Asi ndiani angarega kutaura?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Funga kuti wakadzidzisa vazhinji sei,","poem":1},{"text":"uye kuti wakasimbisa sei maoko asina simba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mashoko ako akatsigira vaya vakagumburwa;","poem":1},{"text":"wakasimbisa mabvi akaneta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asi zvino nhamo yasvika kwauri, uye iwe waora mwoyo;","poem":1},{"text":"inokurova, iwe ndokuvhunduka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ko, kutya kwako Mwari hakuzi chivimbo chako,","poem":1},{"text":"uye nzira dzako dzakarurama tariro yako here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Rangarira iye zvino: Ndianiko, asina mhaka, akamboparadzwa?","poem":1},{"text":"Ndokupiko kwakatongoparadzwa vakarurama?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sezvandakaona, vaya vanodyara zvakaipa","poem":1},{"text":"navaya vanokusha nhamo ndizvo zvavanokohwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vanoparadzwa nokufema kwaMwari;","poem":1},{"text":"vanoparara nokuputika kwehasha dzake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Shumba dzingaomba nokunguruma,","poem":1},{"text":"nyamba meno eshumba huru akaguduka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shumba inoparara nokuda kwokushaya nyama,","poem":1},{"text":"uye vana veshumbakadzi vanopararira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Shoko rakauyiswa kwandiri muchivande,","poem":1},{"text":"nzeve dzangu dzakanzwa zevezeve raro.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pakati pokurota hope dzinovhundutsa usiku,","poem":1},{"text":"hope huru padzinenge dzabata vanhu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kutya nokudedera zvakandibata","poem":1},{"text":"zvikaita kuti mapfupa angu ose abvunde.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mumwe mweya wakapfuura pamberi pechiso changu,","poem":1},{"text":"uye bvudzi romusoro wangu rikamira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wakamira,","poem":1},{"text":"asi ndakatadza kuziva kuti chaiva chii.","poem":2},{"lineBreak":true},{"text":"Chinhu chakamira pamberi pameso angu,","poem":2},{"lineBreak":true},{"text":"uye ndakanzwa inzwi rakanyarara richiti:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"‘Ko, munhu anofa, angava akarurama kupfuura Mwari here?","poem":1},{"text":"Ko, munhu angagona kuchena kukunda Muiti wake here?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kana Mwari akasavimba navaranda vake,","poem":1},{"text":"kana akakanganisa kutonga vatumwa vake,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"zvikuru sei kuna avo vanogara mudzimba dzevhu,","poem":1},{"text":"nheyo dzavo dziri muguruva,","poem":2},{"lineBreak":true},{"text":"dzinopwanyiwa nyore kupfuura chipfukuto!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dzinoputsanyiwa pakati pamambakwedza namadekwana;","poem":1},{"text":"dzinoparara dzisingazoonekwi nokusingaperi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ko, mabote etende ravo haana kubviswa here","poem":1},{"text":"kuti vagofa vasina uchenjeri?’","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}