{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Jehovha akati kuna Jobho:"]},{"type":"verse","number":2,"content":[{"text":"“Ko, munhu anokakavadzana noWamasimba Ose angamurayira here?","poem":1},{"text":"Anopomera Mwari mhosva ngaamupindure!”","poem":2}]},{"type":"verse","number":3,"content":["Ipapo Jobho akapindura Jehovha akati:"]},{"type":"verse","number":4,"content":[{"text":"“Ini handina maturo, ndingakupindurai seiko?","poem":1},{"text":"Ndafumbira muromo wangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndakataura kamwe chete, asi handina mhinduro,","poem":1},{"text":"kaviri, asi handichapamhidzazve.”","poem":2}]},{"type":"verse","number":6,"content":["Ipapo Jehovha akataura naJobho ari mudutu akati:"]},{"type":"verse","number":7,"content":[{"text":"“Chizvisunga chiuno somurume;","poem":1},{"text":"ini ndichakubvunza,","poem":2},{"lineBreak":true},{"text":"uye iwe uchandipindura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ko, iwe unoda kukanganisa kururamisira kwangu here?","poem":1},{"text":"Ko, unondipomera kuti uzviruramise here?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uno ruoko rwakaita sorwaMwari here,","poem":1},{"text":"uye inzwi rako ringatinhira serake here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Chizvishongedza zvino nokukudzwa uye nokubwinya,","poem":1},{"text":"uye zvishongedze nokuremekedzwa uye noumambo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Regedzera ukasha hwehasha dzako,","poem":1},{"text":"utarire munhu mumwe nomumwe anozvikudza ugomuderedza,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"tarira murume mumwe nomumwe anozvikudza ugomuninipisa,","poem":1},{"text":"pwanya vakaipa ipapo pavamire.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uvavige vose pamwe chete muguruva;","poem":1},{"text":"ufukidze zviso zvavo muguva.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ipapo ini pachangu ndichabvuma kwauri","poem":1},{"text":"kuti ruoko rwako rworudyi rungakuponesa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Tarisa kumvuu, yandakaita pamwe chete newe","poem":1},{"text":"uye inofura uswa senzombe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Simba rainaro muchiuno chayo,","poem":1},{"text":"kusimba kwayo kuri mumakakava edumbu rayo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Muswe wayo unotsvikidza somusidhari;","poem":1},{"text":"marunda ezvidya zvayo akasonanidzwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mapfupa ayo ipombi dzendarira,","poem":1},{"text":"miromo yayo yakaita setsvimbo dzesimbi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iyo iri pachinzvimbo chokutanga pakati pamabasa aMwari,","poem":1},{"text":"asi Muiti wayo anogona kusvika pairi nomunondo wake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Zvikomo zvinoivigira zvibereko zvayo,","poem":1},{"text":"uye zvikara zvose zvesango zvinotambira pedyo nayo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inovata pasi pemiti yemirotasi","poem":1},{"text":"yakavanda pakati petsanga munhope.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mirotasi inoivanza pamimvuri yayo;","poem":1},{"text":"mikonachando iri mujinga morukova inoipoteredza.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Panozara rwizi, iyo haivhunduki;","poem":1},{"text":"inodekara zvayo, kunyange Jorodhani rukapfachukira kumuromo wayo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Pano munhu angagona kuibata neziso,","poem":1},{"text":"kana kuiteya uye nokuibaya pamhino yayo here?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}