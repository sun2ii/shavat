{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"“Ungagona kukweva ngwena nechiredzo,","poem":1},{"text":"kana kusunga rurimi rwayo netambo here?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ungagona kupinza mukaro mumhino dzayo,","poem":1},{"text":"kana kuboora rushaya rwayo nechiredzo here?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ko, ingaramba ichikumbira kunzwirwa ngoni newe here?","poem":1},{"text":"Ko, ingataura kwauri mashoko manyoro here?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ko, ingaita chitenderano newe here","poem":1},{"text":"kuti iwe uitore senhapwa kwoupenyu hwayo hwose?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ungagona kuipfuwa seshiri here","poem":1},{"text":"kana kuisunga kuti vanasikana vako vatambe nayo?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ko, vatengesi vangaitsinhanisa here?","poem":1},{"text":"Ko, vangaigoverana pakati pavashambadziri here?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ungagona kuzadza dehwe rayo nemiseve ine nzeve here,","poem":1},{"text":"kana kuzadza musoro wayo namapfumo okuredzesa hove?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kana ukaisa ruoko rwako pairi","poem":1},{"text":"uchazorangarira kurwisana kwako nayo","poem":2},{"lineBreak":true},{"text":"uye haungazozvipamhizve!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tariro ipi zvayo yokuitonga ndeyenhema;","poem":1},{"text":"kungoiona bedzi kunopedza simba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hakuna munhu anotyisa zvokuti angaidenha.","poem":1},{"text":"Ndianiko zvino anogona kumisidzana neni?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndianiko wandakatorera chinhu wandinofanira kuripira?","poem":1},{"text":"Zvinhu zvose zviri pasi pedenga ndezvangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Handingakonewi kutaura zvemitezo yayo,","poem":1},{"text":"simba rayo uye chimiro chayo chakanaka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndianiko angabvisa dehwe rayo?","poem":1},{"text":"Ndianiko angasvika kwairi namatomu?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndianiko anotsunga kuzarura mikova yomuromo wayo,","poem":1},{"text":"iwo wakakomberedzwa nameno ayo anotyisa?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Musana wayo une mitsara yamakwande","poem":1},{"text":"yakanyatsonamirwa pamwe chete;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"rimwe nerimwe riri pedyo pedyo nerimwe,","poem":1},{"text":"zvokuti hakuna mhepo inopinda napakati.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akanyatsobatanidzwa pane rimwe nerimwe;","poem":1},{"text":"akanamatirana pamwe chete uye haagoni kuparadzaniswa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kuhotsira kwayo kunoita mamvari omoto;","poem":1},{"text":"meso ayo akaita sehwerazuva hwamambakwedza.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mazhenje omoto anoyerera achibva mumuromo mayo;","poem":1},{"text":"zvimvari zvomoto zvinobarikira kunze.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Utsi hunobuda mumhino dzayo","poem":1},{"text":"sepahari inovira pamusoro pomoto wetsanga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kufema kwayo kunopfutidza mazimbe omoto,","poem":1},{"text":"uye murazvo unobuda mumuromo mayo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Simba rinogara pamutsipa wayo;","poem":1},{"text":"kuvhundutsa kuri pamberi payo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nhindi dzenyama yayo dzakabatanidzwa zvakasimba;","poem":1},{"text":"dzakasimba uye hadzizungunuswi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Chipfuva chayo chakaoma sebwe,","poem":1},{"text":"chakaoma sapasi peguyo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Painosimuka, vane simba vanovhundutswa,","poem":1},{"text":"vanodududzira shure isati yarova mvura.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Munondo unosvika kwairi hauna simba,","poem":1},{"text":"uye pfumo kana museve kana pfumo guru hazvina simba.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Simbi inoita seshanga kwairi,","poem":1},{"text":"uye ndarira sedanda rakaora.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Miseve haingaiti kuti itize;","poem":1},{"text":"zvimviriri zvakaita sehundi kwairi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Tsvimbo inoita kunge chidimbu cheshanga kwairi;","poem":1},{"text":"inoseka panorira bakatwa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Pasi payo pakaita sezvaenga zvehari,","poem":1},{"text":"inosiya muhwezva mumatope sechirei chinokwevewa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Inoita kuti mvura yakadzika ivire segate rinovhaira,","poem":1},{"text":"uye inokurunga gungwa sehari yamafuta.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Shure kwayo inosiya muhwezva unopenya;","poem":1},{"text":"mumwe munhu angafunga kuti mvura yakadzika yava nevhudzijena.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Hapana chakaenzana nayo munyika,","poem":1},{"text":"chisikwa chisingatyi.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Inotarisira pasi zvose zvinozvikudza;","poem":1},{"text":"ndiyo mambo pamusoro pezvose zvinozvikudza.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}