{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“Chidana zvino kana uchida, asi ndianiko achadavira?","poem":1},{"text":"Uchadzokera kuno upiko wavatsvene?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kutsamwa kunouraya benzi,","poem":1},{"text":"uye godo rinouraya asina mano.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ini pachangu ndakaona benzi richidzika midzi,","poem":1},{"text":"asi pakarepo imba yake yakatukwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vana vake havana kuchengetedzeka,","poem":1},{"text":"vanopwanyiwa padare vasina anovarwira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vane nzara vanodya zvaakacheka,","poem":1},{"text":"vachizvitora kunyange pakati peminzwa,","poem":2},{"lineBreak":true},{"text":"uye vane nyota vanodokwairira pfuma yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nokuti kutambudzika hakubudi muvhu,","poem":1},{"text":"uye nhamo haimeri muvhu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asi munhu anoberekerwa nhamo,","poem":1},{"text":"zvirokwazvo sokubarika kwomoto kunokwira kumusoro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Asi dai ndakanga ndirini, ndaiturira mhosva yangu kuna Mwari;","poem":1},{"text":"ndaiisa mhaka yangu pamberi pake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anoita minana isingagoni kuyerwa,","poem":1},{"text":"zvishamiso zvisingagoni kuverengwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anopa mvura panyika;","poem":1},{"text":"anotuma mvura pamusoro penyika.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vanozvininipisa anovaisa pakakwirira,","poem":1},{"text":"uye vaya vanochema vanosimudzirwa kuchinzvimbo chokuchengetedzwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anokonesa zvirongwa zvavanyengeri,","poem":1},{"text":"kuitira kuti maoko avo abate pasina.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anobata vakachenjera muunyengeri hwavo,","poem":1},{"text":"uye zvirongwa zvenhubu zvinokukurwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Rima rinosvika pamusoro pavo masikati;","poem":1},{"text":"vanotsvanzvadzira masikati makuru sapausiku.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anoponesa vanoshayiwa kubva pamunondo uri pamiromo yavo;","poem":1},{"text":"anovaponesa pakudzvinya kwavane simba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Saka varombo vane tariro,","poem":1},{"text":"uye kusaruramisira kunopfumbira muromo wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Akaropafadzwa munhu anogadziridzwa zvaari naMwari;","poem":1},{"text":"saka usazvidza kuranga kwoWamasimba Ose.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nokuti anopa vanga, asi achisungazve;","poem":1},{"text":"anokuvadza, asi maoko ake anorapazve.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Achakurwira kubva panjodzi nhanhatu;","poem":1},{"text":"kunyange panomwe hakuna kukuvadzwa kuchakuwira.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Munzara achakudzikinura kubva parufu,","poem":1},{"text":"uye muhondo kubva pakubaya kwomunondo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Uchadzivirirwa kubva pakurova kworurimi,","poem":1},{"text":"uye haungatyi panosvika kuparadza.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Uchaseka kuparadza nenzara,","poem":1},{"text":"uye haufaniri kutya zvikara zvenyika.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nokuti uchaita sungano namabwe esango,","poem":1},{"text":"uye zvikara zvesango zvichava norugare newe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Uchaziva kuti tende rako rakasimba,","poem":1},{"text":"uchaverenga zvinhu zvako ugowana zvakakwana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Uchaziva kuti vana vako vachava vazhinji,","poem":1},{"text":"uye zvizvarwa zvako zvichaita souswa hwenyika.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Uchasvika paguva une simba guru,","poem":1},{"text":"sezvisote zvakaunganidzwa panguva yazvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Takazviedza izvi, uye ndezvechokwadi.","poem":1},{"text":"Saka chizvinzwa ugozviita iwe pachako.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}