{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Ipapo Jobho akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Dai chete kurwadziwa kwangu kwaigona kuyerwa","poem":1},{"text":"uye kusuwa kwangu kwaiiswa pachiyero!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zvirokwazvo zvairema kupfuura jecha ramakungwa,","poem":1},{"text":"hazvishamisi kana mashoko angu aiva okuvhurumuka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Miseve yoWamasimba Ose iri mandiri,","poem":1},{"text":"mweya wangu unonwa muchetura wayo;","poem":2},{"lineBreak":true},{"text":"kutyisa kwaMwari kwagadzirira kurwa neni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ko, mbizi ingachema kana ine bundo here?","poem":1},{"text":"Ko, nzombe inokuma kana ine zvokudya here?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ko, chokudya chisinganaki chingadyiwa chisina munyu here?","poem":1},{"text":"Ko, chichena chezai chinonaka here?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndinoramba kuzvibata;","poem":1},{"text":"zvokudya zvakadai zvinondirwarisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Haiwa, dai ndapiwa hangu zvandinokumbira","poem":1},{"text":"kuti Mwari andipe zvandinotarisira,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kuti dai Mwari aida hake kundipwanya,","poem":1},{"text":"kuti aregere ruoko rwake rundiuraye!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ipapo ndaizova hangu nokunyaradzwa uku,","poem":1},{"text":"mufaro wangu mukurwadziwa kusingagumi,","poem":2},{"lineBreak":true},{"text":"kuti handina kunge ndamboramba mashoko aiye Mutsvene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ndinaro here simba, rokuti ndirambe ndine tariro?","poem":1},{"text":"Tariro yacho ndeyeiko kuti nditsungirire?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ko, ndine simba rebwe here?","poem":1},{"text":"Ko, nyama yangu indarira here?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ko, ndine simba here rokuti ndione kuti ndabatsirika,","poem":1},{"text":"sezvo zvino kubudirira kwakabviswa kwandiri?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Munhu asina tariro anofanira kuwana rudo rweshamwari dzake,","poem":1},{"text":"kunyange iye arega kutya Wamasimba Ose.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asi hama dzangu hadzivimbike sezvinongoita hova dzava kudira.","poem":1},{"text":"Sezvinongoita hova dzopfachukira,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"dzinosviba pakunyungudika kwamagwada echando,","poem":1},{"text":"uye dzinozadzwa nokunyungudika kwamagwada echando,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"asi dzinoguma kuyerera mumwaka wokupisa,","poem":1},{"text":"uye mihoronga yadzo inopwa mukupisa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mihoronga inotsauka kubva munzira dzayo;","poem":1},{"text":"inoenda kumakura ndokuparara.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Vafambi veTema vanotsvaka mvura,","poem":1},{"text":"vashambadziri veShebha vanomirira netariro.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Vachaora mwoyo, nokuti vaivimba nesimba ravo;","poem":1},{"text":"vasvikapo, vachashaya zvokuita.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Zvino nemiwo maratidza kusabatsira;","poem":1},{"text":"munoti mukaona chinhu chinotyisa mobva matya.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ko, ndakamboti, ‘Ndipeiwo chipo,","poem":1},{"text":"ndipei fufuro rinobva papfuma yenyu,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ndirwirei muruoko rwomuvengi,","poem":1},{"text":"ndidzikinurei mumaoko avanhu vano utsinye’ here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Ndidzidzisei, uye ndichanyarara hangu;","poem":1},{"text":"ndiratidzei pandakakanganisa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mashoko echokwadi anorwadza sei!","poem":1},{"text":"Asi gakava renyu rinoratidzeiko?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Munoda kutsiura zvandareva,","poem":1},{"text":"nokutora mashoko omunhu arasa tariro semhepo here?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Muchada kana kukanda mijenya pamusoro penherera","poem":1},{"text":"uye nokutengesa shamwari yenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Asi zvino chinditarirai netsitsi.","poem":1},{"text":"Ko, ndingareva nhema pamberi penyu here?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Musadaro, musava vasakarurama;","poem":1},{"text":"fungai zvakare, nokuti kururama kwangu kuchiripo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ko, pamiromo yangu pane zvakaipa here?","poem":1},{"text":"Ko, muromo wangu haugoni kunzvera zvakaipa here?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}