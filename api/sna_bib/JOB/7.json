{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"“Ko, munhu haashandi zvakaoma panyika here?","poem":1},{"text":"Ko, mazuva ake haana kuita seomushandi here?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Somuranda anoshuva mimvuri yamadekwana,","poem":1},{"text":"kana mushandi akamirira kwazvo mubayiro wake,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"saizvozvo ndakagoverwa mwedzi isina maturo,","poem":1},{"text":"uye usiku hwokutambudzika hwakagoverwa kwandiri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pandinovata pasi ndinofunga kuti, ‘Ndichamuka riniko?’","poem":1},{"text":"Usiku hunononoka, uye ndinoshanduka-shanduka kusvikira mambakwedza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Muviri wangu wakafukidzwa nehonye uye nemaronda,","poem":1},{"text":"ganda rangu rakatsemuka uye raora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mazuva angu ari kukurumidza kufamba kukunda chokurukisa chomuruki,","poem":1},{"text":"uye anosvika kumagumo asina tariro.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Rangarirai henyu, imi Mwari, kuti upenyu hwangu hunongova mweya wokufema;","poem":1},{"text":"meso angu haachazoonizve mufaro.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ziso rinondiona zvino harichazondionizve;","poem":1},{"text":"muchanditsvaka, asi handichazovapozve.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sokunyangarika kunoita gore ndokuenda,","poem":1},{"text":"saizvozvo uyo anoburukira kubwiro haadzokizve.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Haachazouyi kumba kwakezve;","poem":1},{"text":"nzvimbo yake haichazomuzivizve.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Naizvozvo handinganyarari;","poem":1},{"text":"ndichataura pakurwadza kwomweya wangu,","poem":2},{"lineBreak":true},{"text":"ndichanyunyuta mushungu dzomwoyo wangu,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ko, ndiri gungwa kanhi, kana chikara chokwakadzika,","poem":1},{"text":"zvamunondiisa pasi pomurindi?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pandinofunga kuti mubhedha wangu uchandivaraidza,","poem":1},{"text":"uye kuti mubhedha wangu uchadzikamisa kunyunyuta kwangu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ipapo munondityisidzira nezviroto","poem":1},{"text":"uye munondivhundutsa nezviratidzo,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"zvokuti ndinosarudza kuti ndidzipwe ndife hangu,","poem":1},{"text":"pachinzvimbo chomuviri wangu uno.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndinozvidza upenyu hwangu, handidi kurarama nokusingaperi.","poem":1},{"text":"Ndiregei nokuti mazuva angu haana zvaanoreva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Munhu chiiko zvamunomukoshesa kudai,","poem":1},{"text":"zvamunomurangarira zvakadai,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"zvamunomunzvera mangwanani ose","poem":1},{"text":"uye muchimuedza nguva dzose?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hamusi kuzombotarirawo kudivi here,","poem":1},{"text":"kana kumbondisiyawo ndakadaro kwechinguva?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kana ndakatadza, ndakaiteiko kwamuri,","poem":1},{"text":"imi mutariri wavanhu?","poem":2},{"text":"Makaitireiko kuti ini ndive munhu wamunovavarira?","poem":1},{"text":"Ko, ini ndava mutoro kwamuri here?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nemhaka yeiko musingandikanganwiri mhaka dzangu","poem":1},{"text":"uye musingandiregereri zvivi zvangu?","poem":2},{"text":"Nokuti ndichavata muguruva nokukurumidza.","poem":1},{"text":"Muchanditsvaka, asi handichazovapozve.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}