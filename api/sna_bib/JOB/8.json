{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Ipapo Bhiridhadhi muShuhi akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Uchasvika riini uchitaura zvinhu zvakadai?","poem":1},{"text":"Mashoko ako imhepo inovhuvhuta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ko, Mwari angaminamisa zvakarurama here?","poem":1},{"text":"Ko, iye Wamasimba Ose angaminamisa kururama here?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vana vako pavakamutadzira,","poem":1},{"text":"akaita kuti varangirwe chivi chavo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asi kana ukatarisa kuna Mwari","poem":1},{"text":"uye ukademba kuna Wamasimba Ose,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kana uri wakachena uye wakarurama,","poem":1},{"text":"kunyange izvozvi achasimuka kuti akurwire,","poem":2},{"lineBreak":true},{"text":"agokudzoserazve panzvimbo yako chaiyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kunyange mavambo ako akanga ari epasi pasi,","poem":1},{"text":"ramangwana rako richava rokubudirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Bvunza marudzi akare","poem":1},{"text":"ugocherechedza zvakadzidzwa namadzibaba avo,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"nokuti isu takaberekwa zuro uye hatina chatinoziva,","poem":1},{"text":"uye mazuva edu panyika akangoita somumvuri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ko, havangakudzidzisi uye vagokuudza here?","poem":1},{"text":"Ko, havangakuvigiri mashoko anobva pakunzwisisa kwavo here?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ko, nhokwe dzingamera pasina nhope here?","poem":1},{"text":"Ko, tsanga dzingararama pasina mvura here?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dzichiri kumera uye dzisati dzatemwa,","poem":1},{"text":"dzinokurumidza kuoma kupinda uswa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndizvo zvakaita magumo avose vanokanganwa Mwari;","poem":1},{"text":"saizvozvo tariro yavasina Mwari inoparara.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Zvaanovimba nazvo hazvina kusimba,","poem":1},{"text":"zvaanovimba nazvo mambure edandemutande.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anosendamira padandemutande rake, asi rinobvaruka;","poem":1},{"text":"anobatirira pariri, asi harimiri.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akafanana nomuti wakanyatsodiridzwa pamushana,","poem":1},{"text":"unotandavadza mabukira awo pamusoro pebindu;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"unomonera midzi yawo pamurwi wamatombo,","poem":1},{"text":"uye unotsvaka nzvimbo pakati pamatombo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Asi kana ukatsemuka ukadzurwa kubva panzvimbo yawo,","poem":1},{"text":"nzvimbo iyo ichauramba igoti, ‘Handina kumbokuona.’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zvirokwazvo upenyu hwawo, hunooma,","poem":1},{"text":"uye mimwe miti inomera ichibuda muvhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Zvirokwazvo Mwari haarambi munhu asina mhaka","poem":1},{"text":"uye haasimbisi maoko avaiti vezvakaipa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Achazadza muromo wako nokuseka","poem":1},{"text":"uye miromo yako nokupururudza.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Vavengi vako vachashongedzwa kunyadziswa,","poem":1},{"text":"uye matende avakaipa haachazovapozve.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}