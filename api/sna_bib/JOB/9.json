{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOB","translationId":"sna_bib","name":"Jobho","commonName":"Jobho","title":"JOBHO","order":18,"numberOfChapters":42,"sha256":"19c12d30eafe74eb7aef4d811384fba9f96fcac8ff79f38fc470e2818292db9c","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sna_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["Ipapo Jobho akapindura akati:"]},{"type":"verse","number":2,"content":[{"text":"“Zvirokwazvo ndinoziva kuti ichokwadi.","poem":1},{"text":"Asi munhu anofa angava akarurama pamberi paMwari seiko?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kunyange dai mumwe aida kuita nharo naye,","poem":1},{"text":"haaizogona kumupindura kamwe chete pamibvunzo chiuru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uchenjeri hwake hwakadzika, simba rake iguru kwazvo.","poem":1},{"text":"Ndianiko akamudzivisa akabuda asina vanga?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anofambisa makomo iwo asingazivi","poem":1},{"text":"agoapidigura mukutsamwa kwake kukuru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anozungunusa nyika ikabva panzvimbo yayo","poem":1},{"text":"uye anoita kuti mbiru dzayo dzidengenyeke.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anotaura kuzuva iro ndokurega kuvhenekera;","poem":1},{"text":"anodzivira chiedza chenyeredzi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iye oga anotambanudza matenga","poem":1},{"text":"uye anofamba pamusoro pamafungu egungwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndiye Muiti weNyeredzi dzeAkutiro neOrioni,","poem":1},{"text":"dzeChimunomwe namapoka enyeredzi dzenyasi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anoita minana isingagoni kunzwisisiswa,","poem":1},{"text":"nezvishamiso zvisingagoni kuverengwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Paanondipfuura, handigoni kumuona;","poem":1},{"text":"paanoenda napo handingamuoni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kana achibvuta, ndiani angamudzivisa?","poem":1},{"text":"Ndiani angati kwaari, ‘Unoiteiko?’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mwari haadzori kutsamwa kwake;","poem":1},{"text":"kunyange boka ravarwi raRahabhi rakawira patsoka dzake nokutya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Zvino ndingakakavadzana naye seiko?","poem":1},{"text":"Ndingawana seiko mashoko okuita nharo naye?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kunyange ndakanga ndisina mhaka, handaigona kumupindura;","poem":1},{"text":"ndaingokumbira hangu nyasha kuMutongi wangu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kunyange dai ndaimudana hangu uye akandipindura,","poem":1},{"text":"handitendi kuti aizowana nguva yokundinzwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aizondiparadza nedutu","poem":1},{"text":"uye achizowedzera maronda angu pasina mhosva.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Haaizonditenderazve kuti nditure mafemo,","poem":1},{"text":"asi aizondizadza namatambudziko.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kana zviri zvesimba, iye ane simba guru!","poem":1},{"text":"Uye kana zviri zvokururamisira, ndianiko angamudana kuti amutonge?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kunyange dai ndisina mhosva, muromo wangu waizongondipa mhaka;","poem":1},{"text":"dai zvangu ndakarurama, iwo waizongondipa mhaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Kunyange ndisina mhosva,","poem":1},{"text":"handina hangu hanya nazvo;","poem":2},{"lineBreak":true},{"text":"ndinozvidza upenyu hwangu pachangu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Zvakangofanana; ndokusaka ndichiti,","poem":1},{"text":"‘Iye anoparadza vasina mhosva nevakaipa.’","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kana dambudziko rikauyisa rufu nokukurumidza,","poem":1},{"text":"achaseka kushaya tariro kwavasina mhosva.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Panowira nyika mumaoko avakaipa,","poem":1},{"text":"vatongi vayo anovapofumadza.","poem":2},{"lineBreak":true},{"text":"Kana asiri iye, zvino ndianiko?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Mazuva angu anokurumidza kupfuura mumhanyi;","poem":1},{"text":"anobhururuka oenda asina kumboona mufaro.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Anopfuura sezvikepe zvenhokwe,","poem":1},{"text":"kufanana namakondo anomhanyira nyama yawo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kana ndikati, ‘Ndichakanganwa kunyunyuta kwangu,","poem":1},{"text":"ndichashandura chiso changu, ndigonyemwerera,’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ndinongotya kutambura kwangu,","poem":1},{"text":"nokuti ndinoziva kuti imi hamuregi kundipa mhosva.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Sezvo ndatopiwa hangu mhosva,","poem":1},{"text":"ko, ndichagotamburirei pasina?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kunyange dai ndikazvishambidza nesipo","poem":1},{"text":"uye ndikashamba maoko angu nesoda,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"imi muchandinyudza mugomba rematope","poem":1},{"text":"zvokuti kunyange nenguo dzangu dzichandisema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Iye haasi munhu akafanana neni kuti ndimupindure,","poem":1},{"text":"kuti zvimwe iye neni tisangane mudare redzimhosva.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Dai chete paingova nomumwe angamira pakati pedu,","poem":1},{"text":"kuti aise ruoko rwake patiri tose,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"mumwe zvake angabvise shamhu yaMwari kwandiri,","poem":1},{"text":"kuti kutyisa kwake kurege kundivhundutsazve.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ipapo ndichataura ndisingamutyi,","poem":1},{"text":"asi sezvazvakaita kwandiri iye zvino, handingakwanisi.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}