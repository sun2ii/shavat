{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOL","translationId":"sna_bib","name":"JOERE","commonName":"JOERE","title":"JOERE","order":29,"numberOfChapters":3,"sha256":"0012316e3c13764d5237a785530b5dc8d3ec0606638a8874621ae516bb9bf258","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/sna_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Shoko raJehovha rakasvika kuna Joere mwanakomana waPetueri."]},{"type":"heading","content":["Dambudziko reMhashu"]},{"type":"verse","number":2,"content":[{"text":"Inzwai izvi, imi vakuru;","poem":1},{"text":"teererai imi mose vagere munyika.","poem":2},{"text":"Ko, zvakadai zvakamboitika here pamazuva enyu,","poem":1},{"text":"kana pamazuva amadzitateguru enyu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zvinhu izvi zviudzei vana venyu,","poem":1},{"text":"uye vana venyu ngavaudzewo vana vavo,","poem":2},{"lineBreak":true},{"text":"vana vavowo vaudze chizvarwa chinotevera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zvakasiyiwa nefararira remhashu","poem":1},{"text":"zvakadyiwa nemhashu dzemagutaguta;","poem":2},{"text":"zvakasiyiwa nemhashu dzemagutaguta","poem":1},{"text":"zvakadyiwa negwatagwata;","poem":2},{"lineBreak":true},{"text":"zvakasiyiwa negwatagwata zvakadyiwa nedzimwewo mhashu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mukai imi zvidhakwa, chemai!","poem":1},{"text":"Ungudzai imi vanwi vewaini;","poem":2},{"text":"ungudzai nokuda kwewaini itsva,","poem":1},{"text":"nokuti yabvutwa pamiromo yenyu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rudzi rwarwisa nyika yangu,","poem":1},{"text":"rune simba uye haruverengeki;","poem":2},{"lineBreak":true},{"text":"rune meno eshumba nameno makuru eshumbakadzi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Rwakaparadza mizambiringa yangu yose,","poem":1},{"text":"rukaparadza mionde yangu yose.","poem":2},{"text":"Rwakasvuura makwati ose emiti,","poem":1},{"text":"rukaarasira kure,","poem":2},{"lineBreak":true},{"text":"ndokusiya mapazi awo achena kuti mbe-e.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Chemai semhandara yakapfeka masaga","poem":1},{"text":"inochema murume wouduku hwayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zvipiriso zvezviyo nezvipiriso zvokunwa","poem":1},{"text":"hazvichawanikwi muimba yaJehovha.","poem":2},{"lineBreak":true},{"text":"Vaprista vari kuungudza, vaya vanoshumira pamberi paJehovha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Minda yaparadzwa,","poem":1},{"text":"pasi paoma;","poem":2},{"text":"zviyo zvaparadzwa,","poem":1},{"text":"waini itsva yapera,","poem":2},{"lineBreak":true},{"text":"mafuta hakuchina.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pererwai nezano, imi varimi,","poem":1},{"text":"ungudzai, imi varimi vemizambiringa,","poem":2},{"text":"chemerai gorosi nebhari,","poem":1},{"text":"nokuti mukohwo weminda waparadzwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Muzambiringa waoma,","poem":1},{"text":"uye muonde wasvava;","poem":2},{"text":"mutamba, muchindwi nomuti womuapuro,","poem":1},{"text":"miti yose yesango, yaoma.","poem":2},{"text":"Zvirokwazvo, mufaro wavanhu","poem":1},{"text":"wasvava.","poem":2}]},{"type":"heading","content":["Vanhu vanonzi vatendeuke"]},{"type":"verse","number":13,"content":[{"text":"Pfekai masaga mucheme, imi vaprista;","poem":1},{"text":"ungudzai, imi munoshanda paaritari.","poem":2},{"text":"Uyai muvate usiku hwose makapfeka masaga,","poem":1},{"text":"imi munoshumira pamberi paMwari wangu;","poem":2},{"text":"nokuti zvipiriso zvezviyo nezvokunwa","poem":1},{"text":"zvadziviswa muimba yaMwari wenyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tsaurai nguva yokutsanya kutsvene;","poem":1},{"text":"danai vanhu kuungano tsvene.","poem":2},{"text":"Kokai vakuru","poem":1},{"text":"navose vanogara munyika","poem":2},{"text":"kuimba yaJehovha Mwari wedu,","poem":1},{"text":"mugodana kuna Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Rinotyisa sei zuva iro!","poem":1},{"text":"Nokuti zuva raJehovha rava pedyo;","poem":2},{"lineBreak":true},{"text":"richauya sokuparadza kunobva kuna Wamasimba Ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ko, zvokudya hazvina kubviswa here","poem":1},{"text":"pamberi pedu chaipo,","poem":2},{"text":"mufaro nokufarisisa","poem":1},{"text":"kubva mumba maMwari wedu?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mbeu dzinopetana","poem":1},{"text":"dzisati dzamera pasi pevhu,","poem":2},{"text":"matura aparara,","poem":1},{"text":"tsapi dzaputswa","poem":2},{"lineBreak":true},{"text":"nokuti hapachina zviyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mombe dzinogomera sei!","poem":1},{"text":"Matanga emombe odzungaira","poem":2},{"text":"nokuda kwokushayiwa mafuro.","poem":1},{"text":"Kunyange mapoka amakwai ari kutambudzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Haiwa Jehovha, ndinodana kwamuri,","poem":1},{"text":"nokuti moto wapisa mafuro,","poem":2},{"lineBreak":true},{"text":"uye mirazvo yemoto yapisa miti yose musango.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kunyange mhuka dzesango dzinochema kwamuri;","poem":1},{"text":"nokuti hova dzesango dzapwa","poem":2},{"lineBreak":true},{"text":"uye moto waparadza mafuro ose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}