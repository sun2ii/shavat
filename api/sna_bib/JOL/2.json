"shure kwadzo kwangova gwenga risina basa,","poem":2},{"lineBreak":true},{"text":"hapana chinopunyuka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pakuonekwa kwadzo dzakaita samabhiza;","poem":1},{"text":"dzinomhanya samabhiza ehondo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nokutinhira sokwengoro","poem":1},{"text":"dzinokwakuka pamusoro pamakomo","poem":2},{"text":"dzichidya mashanga semoto unopisa uswa hwakaoma,","poem":1},{"text":"sehondo ine simba yabuda kundorwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pakungodziona chete, ndudzi dzose dzinotya;","poem":1},{"text":"vose vanocheneruka kumeso.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dzinorwisa samauto;","poem":1},{"text":"dzinokwira madziro savarwi.","poem":2},{"text":"Dzinofamba dzakateverana","poem":1},{"text":"dzisingatsauki padzakananga napo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hadzikwikwidzani pakufamba,","poem":1},{"text":"imwe neimwe inofamba yakananga mberi.","poem":2},{"text":"Dzinopwanya nzvimbo dzakadzivirirwa sei,","poem":1},{"text":"pasina chinodzikanganisa pakurongana kwadzo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dzinobhururuka dzakananga muguta;","poem":1},{"text":"dzinomhanya pamusoro porusvingo.","poem":2},{"text":"Dzinokwira dzichipinda mudzimba;","poem":1},{"text":"dzinopinda napamawindo sembavha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pamberi padzo, pasi panozunguzika,","poem":1},{"text":"denga rinodedera,","poem":2},{"text":"zuva nomwedzi zvinosviba","poem":1},{"text":"uye nyeredzi dzinodzima.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehovha anoomba,","poem":1},{"text":"ari pamberi pehondo yake;","poem":2},{"text":"mauto ake haaverengeki,","poem":1},{"text":"uye vane simba ndivo vanoteerera kurayira kwake.","poem":2},{"text":"Zuva raJehovha iguru;","poem":1},{"text":"rinotyisa kwazvo.","poem":2},{"lineBreak":true},{"text":"Ndiani angamira musi waro?","poem":2}]},{"type":"heading","content":["Bvarurai Mwoyo Yenyu"]},{"type":"verse","number":12,"content":[{"text":"Jehovha anoti, “Kunyange zvino,","poem":1},{"text":"tendeukirai kwandiri nemwoyo yenyu yose","poem":2},{"lineBreak":true},{"text":"muchitsanya, muchichema uye muchiungudza.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bvarurai mwoyo yenyu,","poem":1},{"text":"kwete nguo dzenyu.","poem":2},{"text":"Dzokerai kuna Jehovha Mwari wenyu,","poem":1},{"text":"iye ane nyasha uye ane tsitsi,","poem":2},{"text":"anononoka kutsamwa","poem":1},{"text":"uye ane rudo rukuru;","poem":2},{"lineBreak":true},{"text":"anozvidzora pakutumira vanhu njodzi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndiani anoziva? Anogona kupinduka agonzwa tsitsi,","poem":1},{"text":"uye agokusiyirai mukomborero","poem":2},{"text":"wezvipiriso zvezviyo nezvipiriso zvokunwa","poem":1},{"text":"zvinoitirwa Jehovha Mwari wenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ridzai hwamanda muZioni.","poem":1},{"text":"Sarudzai zuva rokutsanya kutsvene,","poem":2},{"lineBreak":true},{"text":"danai vanhu kuungano tsvene.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Unganidzai vanhu,","poem":1},{"text":"munatse ungano iyi,","poem":2},{"text":"unganidzai pamwe chete vakuru,","poem":1},{"text":"unganidzai vana,","poem":2},{"lineBreak":true},{"text":"vachiri kuyamwa.","poem":2},{"text":"Vachangowanana, murume ngaabude muimba yake","poem":1},{"text":"nomwenga muimba yake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Vaprista vanoshumira pamberi paJehovha","poem":1},{"text":"ngavacheme vari pakati pebiravira retemberi nearitari.","poem":2},{"text":"Ngavati, “Musaparadza vanhu venyu, imi Jehovha.","poem":1},{"text":"Musaita kuti nhaka yenyu ive chinhu chinosekwa,","poem":2},{"lineBreak":true},{"text":"chirevo pakati pendudzi.","poem":2},{"text":"Vachataurirei pakati pamarudzi vachiti,","poem":1},{"text":"‘Mwari wavo aripiko?’ ”","poem":2}]},{"type":"heading","content":["Mhinduro yaJehovha"]},{"type":"verse","number":18,"content":[{"text":"Ipapo Jehovha achava negodo pamusoro penyika yake,","poem":1},{"text":"uye achanzwira vanhu vake tsitsi.","poem":2}]},{"type":"verse","number":19,"content":["Jehovha achavapindura achiti,",{"text":"“Ndava kukutumirai zviyo, waini itsva namafuta,","poem":2},{"text":"zvakawanda zvokuti muchaguta kwazvo,","poem":1},{"text":"handichazokuitai zvakare chiseko chendudzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ndichadzingira kure nemi hondo yokumusoro,","poem":1},{"text":"ndichaidzingira kunyika yakaoma isina chibereko,","poem":2},{"text":"dziya dziri mberi dzichawira mugungwa rokumabvazuva,","poem":1},{"text":"uye dziya dziri shure dzichawira mugungwa rokumadokero.","poem":2},{"text":"Uye kunhuhwa kwadzo kuchakwira;","poem":1},{"text":"kunhuhwa kwadzo kukuru kuchakwira.”","poem":2},{"lineBreak":true},{"text":"Zvirokwazvo akaita zvinhu zvikuru.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Usatya iwe nyika;","poem":2},{"lineBreak":true},{"text":"fara zvako upembere.","poem":2},{"text":"Zvirokwazvo Jehovha aita zvinhu zvikuru.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"Musatya, imi mhuka dzesango,","poem":2},{"lineBreak":true},{"text":"nokuti mafuro ava kusvibira.","poem":2},{"text":"Miti yava kubereka michero yayo; mionde nemizambiringa zvichabereka kwazvo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Farai imi vanhu veZioni,","poem":1},{"text":"farai muna Jehovha Mwari wenyu,","poem":2},{"text":"nokuti akakupai mvura yokupedzisira mukururama.","poem":1},{"text":"Anokupai mvura yakawanda,","poem":2},{"lineBreak":true},{"text":"yokupedzisira neyebumharutsva sakare.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mapuriro enyu achazara nezviyo,","poem":1},{"text":"uye zvisviniro zvenyu zvichazara newaini itsva namafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Ndichakuripirai makore ose amakadyirwa nemhashu:","poem":1},{"text":"mhashu dzemagutaguta nedzegwatakwata,","poem":2},{"lineBreak":true},{"text":"dzimwe mhashu nefararira remhashu;","poem":2},{"text":"hondo yangu huru yandinotuma pakati penyu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Muchava nezvokudya zvakawanda kusvikira maguta,","poem":1},{"text":"ipapo mucharumbidza zita raJehovha Mwari wenyu,","poem":2},{"lineBreak":true},{"text":"uyo akakuitirai zvishamiso;","poem":2},{"text":"vanhu vangu havachazonyadziswi zvakare.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ipapo muchazoziva kuti ndirimo muIsraeri,","poem":1},{"text":"uye kuti ndini Jehovha Mwari wenyu,","poem":2},{"lineBreak":true},{"text":"uyewo kuti hakuna mumwe;","poem":2},{"text":"vanhu vangu havachazonyadziswi zvakare.","poem":1}]},{"type":"heading","content":["Zuva raJehovha"]},{"type":"verse","number":28,"content":[{"text":"“Uye mushure maizvozvo,","poem":1},{"text":"ndichadururira Mweya wangu pamusoro pavanhu vose.","poem":2},{"text":"Vanakomana navanasikana venyu vachaprofita,","poem":1},{"text":"vatana venyu vacharota hope,","poem":2},{"lineBreak":true},{"text":"majaya enyu achaona zviratidzo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kunyange pamusoro pavaranda vangu, zvose varume navakadzi,","poem":1},{"text":"ndichadururira Mweya wangu mumazuva iwayo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ndicharatidza zvishamiso kudenga","poem":1},{"text":"napanyika,","poem":2},{"lineBreak":true},{"text":"ropa nomoto neshongwe dzoutsi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Zuva richashanduka rigova rima,","poem":1},{"text":"uye mwedzi uchava ropa,","poem":2},{"lineBreak":true},{"text":"zuva guru raJehovha rinotyisa risati rasvika.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Uye ani naani anodana","poem":1},{"text":"kuzita raJehovha achaponeswa;","poem":2},{"text":"nokuti paGomo reZioni nomuJerusarema","poem":1},{"text":"muchava noruponeso,","poem":2},{"lineBreak":true},{"text":"sezvakataurwa naJehovha,","poem":2},{"text":"pakati pavanopunyuka,","poem":1},{"text":"avo vachadanwa naJehovha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}