{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JOL","translationId":"sna_bib","name":"JOERE","commonName":"JOERE","title":"JOERE","order":29,"numberOfChapters":3,"sha256":"0012316e3c13764d5237a785530b5dc8d3ec0606638a8874621ae516bb9bf258","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/sna_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Kutongwa kweNdudzi"]},{"type":"verse","number":1,"content":[{"text":"“Mumazuva iwayo, napanguva iyoyo,","poem":1},{"text":"kana ndichinge ndadzosa pfuma yeJudha neyeJerusarema,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ndichaunganidza ndudzi dzose","poem":1},{"text":"ndigoenda nadzo kuMupata waJehoshafati.","poem":2},{"text":"Ipapo ndichavatonga","poem":1},{"text":"nokuda kwenhaka yangu, vanhu vangu vaIsraeri,","poem":2},{"text":"nokuti vakaparadzira vanhu vangu pakati pendudzi,","poem":1},{"text":"uye vakagovana nyika yangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vakakanda mijenya pamusoro pavanhu vangu,","poem":1},{"text":"vakatsinhanisa vakomana nezvifeve;","poem":2},{"text":"vakatengesa vanasikana kuti vagotenga waini","poem":1},{"text":"yokuti vanwe.","poem":2}]},{"type":"verse","number":4,"content":["“Zvino ndakakutadzirai chiiko, imi Tire neSidhoni, nemi matunhu ose eFiristia? Muri kundiripira chimwe chinhu chandakaita here? Zvino kana muchindiripira, ini ndichadzosera zvamakaita pamisoro yenyu chaiyo nokukurumidza chaizvo."]},{"type":"verse","number":5,"content":["Nokuti makatora sirivha negoridhe rangu, mukatakurawo midziyo yangu yakanakisisa mukandoiisa kutemberi dzenyu."]},{"type":"verse","number":6,"content":["Makatengesa vanhu veJudha neveJerusarema kuvaGiriki kuti muvaendese kure."]},{"type":"verse","number":7,"content":["“Tarirai, ini ndichavamutsa kubva kunzvimbo dzamakavatengesera, uye ndichadzosera pamisoro yenyu chaiyo zvamakaita."]},{"type":"verse","number":8,"content":["Ndichatengesa vanakomana navanasikana venyu kuvanhu veJudha, uye vachavatengesa kuvaShebha, rudzi rwuri kure.” Jehovha ataura."]},{"type":"verse","number":9,"content":[{"text":"Paridzirai izvi kundudzi dzose:","poem":1},{"text":"Gadzirirai hondo!","poem":2},{"text":"Mutsai varwi!","poem":1},{"text":"Varwi vose ngavaswedere pedyo varwise.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pfurai mapadza enyu muaite minondo,","poem":1},{"text":"uye mapanga okuchekerera miti muaite mapfumo.","poem":2},{"text":"Asina simba ngaati, “Ndine simba!”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Uyai nokukurumidza, imi ndudzi dzose, kubva kumativi ose","poem":1},{"text":"mugoungana ipapo.","poem":2},{"lineBreak":true},{"text":"Haiwa Jehovha, burutsai varwi venyu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ndudzi dzose ngadzimutswe;","poem":1},{"text":"ngadziende kuMupata waJehoshafati,","poem":2},{"text":"nokuti ipapo ndipo pandichagara pasi","poem":1},{"text":"kuti nditonge ndudzi dzose kumativi ose enyika.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shandisai jeko,","poem":1},{"text":"nokuti gohwo raibva.","poem":2},{"text":"Uyai musvine mazambiringa netsoka dzenyu,","poem":1},{"text":"nokuti chisviniro chazara,","poem":2},{"lineBreak":true},{"text":"uye zvirongo zvopfachukira,","poem":2},{"text":"uku ndiko kukura kwakaita kuipa kwavo.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Vazhinji zhinji, vazhinji zhinji,","poem":1},{"text":"vari mumupata wokutonga.","poem":2},{"text":"Nokuti zuva raJehovha rava pedyo","poem":1},{"text":"mumupata wokutonga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zuva nomwedzi zvichasviba","poem":1},{"text":"uye nyeredzi dzichadzima.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jehovha achaomba paZioni,","poem":1},{"text":"uye achatinhira ari muJerusarema;","poem":2},{"lineBreak":true},{"text":"denga nenyika zvichadedera.","poem":2},{"text":"Asi Jehovha achava utiziro hwavanhu vake,","poem":1},{"text":"nhare yavanhu veIsraeri.","poem":2}]},{"type":"heading","content":["Maropafadzo aVanhu vaMwari"]},{"type":"verse","number":17,"content":[{"text":"“Ipapo muchaziva kuti ini Jehovha Mwari wenyu,","poem":1},{"text":"ndinogara muZioni, gomo rangu dzvene.","poem":2},{"text":"Jerusarema richava dzvene;","poem":1},{"text":"vatorwa havachazorirwisazve.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Pazuva iroro makomo achachururuka waini itsva,","poem":1},{"text":"uye zvikomo zvichaerera mukaka;","poem":2},{"lineBreak":true},{"text":"hova dzose dzomuJudha dzichaerera mvura.","poem":2},{"text":"Chitubu chichaerera chichibva muimba yaJehovha,","poem":1},{"text":"uye chichadiridzira mupata wemiti yemiunga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Asi Ijipiti ichava dongo,","poem":1},{"text":"Edhomu ichava gwenga risina basa,","poem":2},{"text":"nokuda kwokurwiswa kwakaitwa vanhu veJudha,","poem":1},{"text":"vakateura ropa risina mhosva munyika yavo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"MuJudha muchagara vanhu nokusingaperi,","poem":1},{"text":"uye nomuJerusarema kusvikira kuzvizvarwa zvose.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mhosva yavo yeropa yandisina kuregerera,","poem":1},{"text":"ndichairegerera,","poem":2},"nokuti Jehovha anogara muZioni.”"]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}