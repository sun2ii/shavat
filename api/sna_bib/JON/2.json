{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"JON","translationId":"sna_bib","name":"Jona","commonName":"Jona","title":"JONA","order":32,"numberOfChapters":4,"sha256":"37e7ad2485d9b2e40b2d531bae44557d3ea54c944df03802d11424788c7a6400","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/sna_bib/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Munyengetero waJona"]},{"type":"verse","number":1,"content":["Kubva mudumbu rehove Jona akanyengetera kuna Jehovha Mwari wake."]},{"type":"verse","number":2,"content":["Akati:",{"text":"“Mudambudziko rangu ndakadana kuna Jehovha,","poem":1},{"text":"iye akandipindura.","poem":2},{"text":"Kubva mukati meguva ndakadanidzira kuti ndibatsirwe,","poem":1},{"text":"uye imi makanzwa kuchema kwangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Makandikandira makadzika,","poem":1},{"text":"mumwoyo chaimo megungwa,","poem":2},{"text":"uye mvura zhinji ikandikomberedza;","poem":1},{"text":"mafungu enyu ose namapopoma enyu ose","poem":2},{"lineBreak":true},{"text":"zvakapfuura napamusoro pangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndakati, ‘Ndaraswa kubva","poem":1},{"text":"pamberi penyu,","poem":2},{"text":"asi ndichatarirazve ndakaringa","poem":1},{"text":"kutemberi yenyu tsvene.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mvura zhinji dzandikomberedza dzikandityisa;","poem":1},{"text":"pakadzikadzika pakandikomberedza;","poem":2},{"lineBreak":true},{"text":"sora regungwa rakamonera musoro wangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kumidzi yamakomo ndakanyura;","poem":1},{"text":"nyika yapasi yakandipfigiramo nokusingaperi.","poem":2},{"text":"Asi makaburitsa upenyu hwangu kubva mugomba,","poem":1},{"text":"imi Jehovha Mwari wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Upenyu hwangu pahwakanga hwotiza,","poem":1},{"text":"ndakakurangarirai, imi Jehovha,","poem":2},{"text":"uye munyengetero wangu wakauya kwamuri,","poem":1},{"text":"kutemberi yenyu tsvene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Vaya vanobatirira kuzvifananidzo zvisina maturo,","poem":1},{"text":"vanorasa nyasha dzingadai dziri dzavo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Asi ini, norwiyo rwokuvonga,","poem":1},{"text":"ndichabayira kwamuri.","poem":2},{"text":"Zvandakapika ndichazvizadzisa.","poem":1},{"text":"Ruponeso runobva kuna Jehovha.”","poem":2}]},{"type":"verse","number":10,"content":["Uye Jehovha akarayira hove, ikandorutsira Jona panyika yakaoma."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}