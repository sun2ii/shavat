{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"LAM","translationId":"sna_bib","name":"Kuungudza kwaJeremia","commonName":"Kuungudza kwaJeremia","title":"KUUNGUDZA KWAJEREMIA","order":25,"numberOfChapters":5,"sha256":"05ef5affbc27857f85e1f5b7edfbfe4a029156bd253131bfd39641c98b056279","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/sna_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Ko, muguta zvamusisina vanhu,","poem":1},{"text":"iro rakanga rizere navanhu!","poem":2},{"text":"Zvarangova sechirikadzi,","poem":1},{"text":"iro rakanga riri guru pakati pendudzi!","poem":2},{"text":"Iro rakanga riri mambokadzi pakati penyika,","poem":1},{"text":"zvino rava nhapwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rinochema zvikuru usiku,","poem":1},{"text":"misodzi iri pamatama aro.","poem":2},{"text":"Pakati pavadiwa varo vose","poem":1},{"text":"hakuna anorivaraidza.","poem":2},{"text":"Shamwari dzaro dzose dzarimukira;","poem":1},{"text":"dzava vavengi varo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Shure kwokutambudzika nokushanda zvakaomarara,","poem":1},{"text":"Judha akaenda kuutapwa.","poem":2},{"text":"Anogara pakati pendudzi;","poem":1},{"text":"haawani nzvimbo yokuzorora.","poem":2},{"text":"Vose vaimudzinganisa vakamubata","poem":1},{"text":"ari pakati pokutambudzika kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nzira dzinoenda kuZioni dzinochema,","poem":1},{"text":"nokuti hakuna anouya kumitambo yaro yakatarwa.","poem":2},{"text":"Masuo aro ose haasisina vanhu,","poem":1},{"text":"vaprista varo vanogomera,","poem":2},{"text":"varandakadzi varo vanochema,","poem":1},{"text":"uye iro riri pakurwadziwa kukuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vavengi varo ndivo vava vatongi varo;","poem":1},{"text":"vavengi varo vagere zvakanaka,","poem":2},{"text":"Jehovha akarivigira kutambudzika","poem":1},{"text":"nokuda kwezvivi zvaro zvizhinji.","poem":2},{"text":"Vana varo vakaenda kuutapwa,","poem":1},{"text":"vava nhapwa pamberi pavavengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuyevedza kwose kwabva","poem":1},{"text":"paMwanasikana weZioni.","poem":2},{"text":"Machinda aro aita senondo","poem":1},{"text":"dzashayiwa mafuro.","poem":2},{"text":"Mukushayiwa simba vakatiza","poem":1},{"text":"pamberi peanovadzinganisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mumazuva okutambudzika nokudzungaira kwaro,","poem":1},{"text":"Jerusarema rinorangarira pfuma yose","poem":2},{"lineBreak":true},{"text":"yakanga iri yaro pamazuva akare.","poem":2},{"text":"Pakawira vanhu varo mumaoko omuvengi,","poem":1},{"text":"rakashaya anoribatsira.","poem":2},{"text":"Vavengi varo vakaritarisa,","poem":1},{"text":"vakariseka pakuparadzwa kwaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jerusarema rakatadza zvikuru kwazvo,","poem":1},{"text":"naizvozvo rasvibiswa.","poem":2},{"text":"Vose vairikudza vorizvidza,","poem":1},{"text":"nokuti vakaona kushama kwaro;","poem":2},{"text":"iro pacharo rinogomera,","poem":1},{"text":"richidzokera shure.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tsvina yaro yakanamatira panguo dzaro;","poem":1},{"text":"harina kurangarira ramangwana raro.","poem":2},{"text":"Kuwa kwaro kwakashamisa;","poem":1},{"text":"hakuna akarinyaradza.","poem":2},{"text":"“Haiwa Jehovha, tarirai kurwadziwa kwangu,","poem":1},{"text":"nokuti muvengi akunda.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Muvengi akatora","poem":1},{"text":"pfuma yaro yose;","poem":2},{"text":"rakaona ndudzi dzechihedheni","poem":1},{"text":"dzichipinda panzvimbo yaro tsvene,","poem":2},{"text":"avo vamakanga madzivisa","poem":1},{"text":"kupinda paungano yenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Vanhu varo vose vanogomera","poem":1},{"text":"pavanotsvaka chingwa;","poem":2},{"text":"vanotsinhanisa pfuma yavo nezvokudya","poem":1},{"text":"kuti vazviraramise.","poem":2},{"text":"“Tarirai, imi Jehovha, uye murangarire,","poem":1},{"text":"nokuti ndava munhu akazvidzwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Hamuna hanya here, imi mose munopfuura?","poem":1},{"text":"Tarirai pose pose muone.","poem":2},{"text":"Pano kutambudzika sokutambudzika kwangu here,","poem":1},{"text":"kwakaiswa pamusoro pangu,","poem":2},{"text":"kwakauyiswa naJehovha pamusoro pangu","poem":1},{"text":"pazuva rokutsamwa kwake kunotyisa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Akatuma moto kubva kumusoro-soro,","poem":1},{"text":"akautumira mumapfupa angu.","poem":2},{"text":"Akateya makumbo angu nomumbure","poem":1},{"text":"uye akandidzosera shure.","poem":2},{"text":"Akandisiya ndisina chinhu,","poem":1},{"text":"ndikapera simba zuva rose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Zvivi zvangu zvasungwa zvikaitwa joko;","poem":1},{"text":"namaoko ake zvakarukirwa pamwe chete,","poem":2},{"text":"zvauya pamutsipa wangu","poem":1},{"text":"uye Ishe apedza simba rangu.","poem":2},{"text":"Akandiisa mumaoko avanhu","poem":1},{"text":"vandisingagoni kukunda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ishe akaramba","poem":1},{"text":"mhare dzose dziri pakati pangu;","poem":2},{"text":"akakokera hondo kuzondirwisa","poem":1},{"text":"kuzopwanya majaya angu.","poem":2},{"text":"Ishe akatsika-tsika Mhandara Mwanasikana waJudha","poem":1},{"text":"muchisviniro chake chewaini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Ndokusaka ndichichema","poem":1},{"text":"uye maziso angu achierera misodzi.","poem":2},{"text":"Hapana ari pedyo kuti andinyaradze,","poem":1},{"text":"hakuna anovandudza mweya wangu.","poem":2},{"text":"Vana vangu vari kutambudzika","poem":1},{"text":"nokuti muvengi akunda.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zioni rinotambanudza maoko aro,","poem":1},{"text":"asi hakuna munhu anorinyaradza.","poem":2},{"text":"Jehovha akaisa chirevo pamusoro paJakobho,","poem":1},{"text":"kuti vavakidzani vake vave vavengi vake;","poem":2},{"text":"Jerusarema rava","poem":1},{"text":"chinhu chisina kunatswa pakati pavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Jehovha akarurama,","poem":1},{"text":"asi ini ndakamukira murayiro wake.","poem":2},{"text":"Inzwai, imi vanhu mose;","poem":1},{"text":"onai kutambudzika kwangu.","poem":2},{"text":"Majaya angu navarandakadzi vangu","poem":1},{"text":"vakaenda kuutapwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ndakadana kushamwari dzangu","poem":1},{"text":"asi vakandipandukira.","poem":2},{"text":"Vaprista vangu navakuru vangu","poem":1},{"text":"vakafira muguta,","poem":2},{"text":"pavakanga vachitsvaka zvokudya","poem":1},{"text":"kuti vazviraramise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Tarirai, imi Jehovha kutambudzika kwangu!","poem":1},{"text":"Ndiri kurwadziwa mukati mangu,","poem":2},{"text":"uye ndakakanganisika mumwoyo mangu,","poem":1},{"text":"nokuti ndakakumukirai zvikuru.","poem":2},{"text":"Kunze, munondo unondiurayira hama;","poem":1},{"text":"mukati, munongova norufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Vanhu vakanzwa kugomera kwangu,","poem":1},{"text":"asi hakuna anondinyaradza.","poem":2},{"text":"Vavengi vangu vose vakanzwa kutambura kwangu;","poem":1},{"text":"vanofara nezvamakaita.","poem":2},{"text":"Dai mauyisa henyu zuva ramakazivisa","poem":1},{"text":"kuti vagofanana nemi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Zvakaipa zvavo zvose ngazviuye pamberi penyu;","poem":1},{"text":"muvaitire","poem":2},{"text":"sezvamakaita kwandiri","poem":1},{"text":"nokuda kwezvivi zvangu zvose.","poem":2},{"text":"Kugomera kwangu kwawanda,","poem":1},{"text":"uye mwoyo wangu wapera simba.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}