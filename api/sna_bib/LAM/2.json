{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"LAM","translationId":"sna_bib","name":"Kuungudza kwaJeremia","commonName":"Kuungudza kwaJeremia","title":"KUUNGUDZA KWAJEREMIA","order":25,"numberOfChapters":5,"sha256":"05ef5affbc27857f85e1f5b7edfbfe4a029156bd253131bfd39641c98b056279","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/sna_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ishe akafukidza sei Mwanasikana weZioni","poem":1},{"text":"negore rokutsamwa kwake!","poem":2},{"text":"Akapotsera pasi kubwinya kweIsraeri,","poem":1},{"text":"kubva kudenga kusvika panyika;","poem":2},{"text":"haana kurangarira chitsiko chetsoka dzake","poem":1},{"text":"muzuva rokutsamwa kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ishe akamedza ugaro hwose hwaJakobho","poem":1},{"text":"akasavanzwira tsitsi;","poem":2},{"text":"mukutsamwa kwake akakoromorera pasi","poem":1},{"text":"nhare dzoMwanasikana weJudha.","poem":2},{"text":"Akawisira pasi umambo hwake namachinda ahwo","poem":1},{"text":"mukunyadziswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mukutsamwa kwake kunotyisa akagura","poem":1},{"text":"nyanga dzose dzaIsraeri.","poem":2},{"text":"Akadzosa ruoko rwake rworudyi","poem":1},{"text":"pakasvika muvengi.","poem":2},{"text":"Akapisa muna Jakobho somurazvo womoto","poem":1},{"text":"unoparadza zvose zviri kumativi ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Akawembura uta hwake somuvengi;","poem":1},{"text":"ruoko rwake rworudyi rwagadzirira.","poem":2},{"text":"Somuvengi akauraya vose vaifadza kuona;","poem":1},{"text":"akadurura hasha dzake semoto","poem":2},{"lineBreak":true},{"text":"patende roMwanasikana weZioni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ishe akafanana nomuvengi;","poem":1},{"text":"akamedza Israeri.","poem":2},{"text":"Akamedza mizinda yake yose","poem":1},{"text":"uye akaparadza mhare dzake.","poem":2},{"text":"Akawedzera kuungudza nokuchema","poem":1},{"text":"kwoMwanasikana weJudha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Akaparadza ugaro hwake sebindu;","poem":1},{"text":"akaparadza nzvimbo yake yokusanganira.","poem":2},{"text":"Jehovha akaita kuti Zioni rikanganwe","poem":1},{"text":"mitambo yaro yakatarwa namaSabata aro;","poem":2},{"text":"mukutsamwa kwake kunotyisa,","poem":1},{"text":"akaramba vose mambo nomuprista.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ishe akaramba aritari yake","poem":1},{"text":"uye akasiya nzvimbo yake tsvene.","poem":2},{"text":"Akaisa mumaoko omuvengi","poem":1},{"text":"masvingo emizinda yake;","poem":2},{"text":"vakaita ruzha mumba maJehovha","poem":1},{"text":"sapazuva romutambo wakatarwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehovha akafunga kuparadza","poem":1},{"text":"rusvingo rwakakomberedza Mwanasikana weZioni.","poem":2},{"text":"Akatambanudza rwodzi rwokuyera","poem":1},{"text":"uye haana kudzosa ruoko rwake pakuparadza.","poem":2},{"text":"Akaita kuti mirwi namasvingo zviungudze;","poem":1},{"text":"zvose zvakaparara pamwe chete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Masuo aro anyura muvhu,","poem":1},{"text":"akavhuna mazariro aro ndokuaparadza.","poem":2},{"text":"Mambo waro namachinda aro vakaenda kuutapwa pakati pendudzi,","poem":1},{"text":"murayiro hapachina,","poem":2},{"text":"uye vaprofita varo havachawanizve","poem":1},{"text":"zviratidzo zvinobva kuna Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vakuru voMwanasikana weZioni","poem":1},{"text":"vagere pasi vanyerere;","poem":2},{"text":"vamwaya guruva pamisoro yavo","poem":1},{"text":"ndokupfeka masaga.","poem":2},{"text":"Vakadzi vechidiki veJerusarema","poem":1},{"text":"vakotamisa misoro yavo pasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Meso angu aneta nokuchema,","poem":1},{"text":"ndiri kurwadziwa mukati mangu,","poem":2},{"text":"mwoyo wangu wadururirwa pasi","poem":1},{"text":"nokuti vanhu vangu vaparadzwa,","poem":2},{"text":"nokuti vana navacheche voziya","poem":1},{"text":"munzira dzomuguta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Vanoti kuna vanamai vavo,","poem":1},{"text":"“Zvokudya newaini zviripiko?”","poem":2},{"text":"pavanoziya somurume akuvadzwa","poem":1},{"text":"munzira dzomuguta,","poem":2},{"text":"panodururwa upenyu hwavo.","poem":1},{"text":"Mumaoko avanamai vavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndingareveiko pamusoro pako?","poem":1},{"text":"Ndingakuenzanisa neiko,","poem":2},{"lineBreak":true},{"text":"iwe Mwanasikana weJerusarema?","poem":2},{"text":"Ndingakufananidze neiko,","poem":1},{"text":"kuti zvimwe ndikunyaradze,","poem":2},{"lineBreak":true},{"text":"iwe Mhandara Mwanasikana weZioni?","poem":2},{"text":"Vanga rako rakadzika segungwa.","poem":1},{"text":"Ndianiko achakuporesa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Zviratidzo zvavaprofita vako","poem":1},{"text":"zvakanga zviri zvenhema uye zvisina maturo;","poem":2},{"text":"havana kubudisa zvivi zvako pachena","poem":1},{"text":"kuti vabvise kutapwa kwako,","poem":2},{"text":"zvirevo zvavakakupa","poem":1},{"text":"zvakanga zviri zvenhema uye zvaitsausa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Vose vanopfuura nepauri","poem":1},{"text":"vacharova maoko vachikuseka;","poem":2},{"text":"vanoseka uye vanodzungudza misoro yavo","poem":1},{"text":"pamusoro peMhandara yeJerusarema vachiti:","poem":2},{"text":"“Ko, ndiro here guta rainzi","poem":1},{"text":"kukwana kworunako,","poem":2},{"lineBreak":true},{"text":"mufaro wenyika yose?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Vavengi vako vose vanoshama miromo yavo","poem":1},{"text":"pamusoro pako;","poem":2},{"text":"vanoseka uye vanorumanya meno avo","poem":1},{"text":"vachiti, “Tarimedza.","poem":2},{"text":"Iri ndiro zuva ratanga takamirira;","poem":1},{"text":"takararama kuti tirione.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Jehovha aita zvaakaronga;","poem":1},{"text":"azadzisa shoko rake,","poem":2},{"lineBreak":true},{"text":"raakatema kare.","poem":2},{"text":"Akakukoromora asina tsitsi,","poem":1},{"text":"akarega muvengi achifara pamusoro pako,","poem":2},{"lineBreak":true},{"text":"akasimudza runyanga rwavavengi vako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mwoyo yavanhu","poem":1},{"text":"inodana kuna She.","poem":2},{"text":"Iwe rusvingo rwoMwanasikana weZioni,","poem":1},{"text":"rega misodzi yako iyerere sorwizi","poem":2},{"lineBreak":true},{"text":"masikati nousiku;","poem":2},{"text":"usazvipa zororo,","poem":1},{"text":"meso ako asazorora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Simuka, danidzira usiku,","poem":1},{"text":"panotanga varindi vousiku;","poem":2},{"text":"durura mwoyo wako semvura","poem":1},{"text":"pamberi paShe.","poem":2},{"text":"Simudzira maoko ako kwaari","poem":1},{"text":"nokuda kwoupenyu hwavana vako,","poem":2},{"text":"vanoziya nenzara","poem":1},{"text":"pamavambo enzira dzose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Tarirai, imi Jehovha, murangarire kuti:","poem":1},{"text":"Ndiani wamakamboitira zvakadai?","poem":2},{"text":"Ko, vakadzi vanofanira kudya vana vavo,","poem":1},{"text":"ivo vana vavakarera here?","poem":2},{"text":"Ko, vaprista navaprofita vangaurayirwa","poem":1},{"text":"munzvimbo tsvene yaShe here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Majaya navatana vavata pamwe chete","poem":1},{"text":"muguruva romunzira;","poem":2},{"text":"majaya angu navarandakadzi vangu","poem":1},{"text":"vaurayiwa nomunondo.","poem":2},{"text":"Makavauraya pazuva rokutsamwa kwenyu;","poem":1},{"text":"makavabaya musina tsitsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Sokukokera kwamunoita zuva romutambo,","poem":1},{"text":"saizvozvo makandikokera kutyisa kumativi ose.","poem":2},{"text":"Pazuva rokutsamwa kwaJehovha","poem":1},{"text":"hakuna akapunyuka kana kurarama;","poem":2},{"text":"vaya vandakachengeta uye ndikarera,","poem":1},{"text":"vaparadzwa navavengi vangu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}