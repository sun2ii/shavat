{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"LAM","translationId":"sna_bib","name":"Kuungudza kwaJeremia","commonName":"Kuungudza kwaJeremia","title":"KUUNGUDZA KWAJEREMIA","order":25,"numberOfChapters":5,"sha256":"05ef5affbc27857f85e1f5b7edfbfe4a029156bd253131bfd39641c98b056279","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/sna_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Ndini munhu akaona kutambudzika","poem":1},{"text":"neshamhu yehasha dzake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akandidzingira kure akaita kuti ndifambe","poem":1},{"text":"murima panzvimbo yomuchiedza;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"zvirokwazvo, akashandura ruoko rwake kuti rundirwise","poem":1},{"text":"nguva nenguva, zuva rose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Akasakadza ganda rangu nenyama yangu","poem":1},{"text":"uye akavhuna mapfupa angu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akandikomba akandipoteredza","poem":1},{"text":"neshungu nokurwadziswa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akandigarisa murima","poem":1},{"text":"savanhu vakafa kare kare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Akandipfigira kuti ndisapunyuka,","poem":1},{"text":"akandiremedza nengetani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kunyange ndikadana kana kuridza mhere kuti ndibatsirwe,","poem":1},{"text":"anopfigira munyengetero wangu kunze.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akadzivira nzira yangu namatombo;","poem":1},{"text":"akaminamisa nzira dzangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sebere rakavandira,","poem":1},{"text":"seshumba yakavanda,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"akandikwekweredza kubva munzira uye akandibvarura-bvarura","poem":1},{"text":"akandisiya ndisina mubatsiri.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akawembura uta hwake","poem":1},{"text":"akandiita chinhu chinonangwa nemiseve yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Akabaya mwoyo wangu","poem":1},{"text":"nemiseve yaibva mugoba rake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndakava chiseko chavanhu vangu vose;","poem":1},{"text":"vakandihomera nenziyo pazuva rose.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akandigutsa nemiriwo inovava,","poem":1},{"text":"uye akandinwisa nduru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Akagura mazino angu nerukangarabwe;","poem":1},{"text":"akanditsokodzera muguruva.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndakatorerwa rugare;","poem":1},{"text":"ndakakanganwa kuti kubudirira chii.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naizvozvo ndinoti, “Kubwinya kwangu kwaenda,","poem":1},{"text":"uye nezvose zvandanga ndakatarisira kuna Jehovha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ndinorangarira kutambudzika kwangu nokudzungaira kwangu,","poem":1},{"text":"kurwadziwa uye nenduru.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndinozvirangarira kwazvo,","poem":1},{"text":"uye mweya wangu wasuruvara mukati mangu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Asi izvi ndinozvirangarira mupfungwa","poem":1},{"text":"uye naizvozvo ndine tariro:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nokuda kwerudo rukuru rwaJehovha, hatina kuparadzwa,","poem":1},{"text":"nokuti tsitsi dzake hadzitongoperi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Itsva mangwanani oga oga,","poem":1},{"text":"kutendeka kwenyu kukuru.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndinoti kumwoyo wangu, “Jehovha ndiye mugove wangu;","poem":1},{"text":"naizvozvo ndichamumirira.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Jehovha akanaka kuna avo vanovimba naye,","poem":1},{"text":"kumunhu anomutsvaka;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"chinhu chakanaka kumirira","poem":1},{"text":"ruponeso rwaJehovha unyerere.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Chinhu chakanaka kuti munhu atakure joko","poem":1},{"text":"achiri mudiki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ngaagare ari oga anyerere,","poem":1},{"text":"nokuti Jehovha ndiye akariturika paari.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ngaavige chiso chake muguruva,","poem":1},{"text":"zvimwe tariro ichiripo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ngaape dama rake kumunhu anomurova,","poem":1},{"text":"uye ngaazadzwe nenyadzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Nokuti vanhu havangaraswi","poem":1},{"text":"naIshe nokusingaperi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kunyange achiuyisa kusuwa, achanzwira hake tsitsi,","poem":1},{"text":"rukuru sei rudo rwake rusingaperi.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Nokuti haafariri kuuyisa kurwadziwa","poem":1},{"text":"kana kusuwa kuvana vavanhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Kutsikira pasi petsoka","poem":1},{"text":"vasungwa vose venyika,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"kurambira munhu kodzero yake","poem":1},{"text":"pamberi peWokumusoro-soro,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"kutadzisa munhu kuwana kururamisirwa kwake","poem":1},{"text":"ko, Ishe haangaoni zvinhu zvakadai here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Ndiani angataura akaita kuti zviitike","poem":1},{"text":"kana Ishe asina kuzvirayira?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ko, hazvibvi mumuromo weWokumusoro-soro here","poem":1},{"text":"zvose zvakaipa nezvinhu zvakanaka zvinouya?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ko, munhu mupenyu anonyunyutirei","poem":1},{"text":"kana arangwa nokuda kwezvivi zvake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Ngatinzverei nzira dzedu uye ngatidziedzei,","poem":1},{"text":"uyewo ngatidzokerei kuna Jehovha.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ngatisimudzei mwoyo yedu namaoko edu","poem":1},{"text":"kuna Mwari ari kudenga, tigoti:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“Takatadza uye takakumukirai","poem":1},{"text":"uye imi hamuna kukanganwira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“Makazvifukidza nokutsamwa mukatidzingirira;","poem":1},{"text":"makauraya musinganzwiri ngoni.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Makazvifukidza negore","poem":1},{"text":"kuti kurege kuva nomunyengetero ungasvikako.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Makatiita marara netsvina","poem":1},{"text":"pakati pendudzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“Vavengi vedu vose vakashama miromo yavo","poem":1},{"text":"kwazvo kuti vatituke.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Takawirwa nokutya uye takateyiwa nehunza,","poem":1},{"text":"kuparara nokuparadzwa kukuru.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Hova dzemisodzi dzinoyerera kubva mumaziso angu,","poem":1},{"text":"nokuti vanhu vangu vaparadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Meso angu acharamba achiyerera misodzi,","poem":1},{"text":"pasina zvinoyamura,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"kusvikira Jehovha aringira pasi","poem":1},{"text":"kubva kudenga akaona.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Zvandinoona zvinochemedza mweya wangu,","poem":1},{"text":"nokuda kwavakadzi vose veguta rangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Avo vakanga vari vavengi vangu ini pasina chikonzero","poem":1},{"text":"vakandivhima seshiri.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Vakaedza kundiuraya mugomba","poem":1},{"text":"uye vakapotsera matombo kwandiri;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"mvura zhinji yakafukidza musoro wangu,","poem":1},{"text":"uye ndakafunga kuti ndava pedyo nokufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Ndakadana zita renyu, imi Jehovha,","poem":1},{"text":"ndiri mugomba rakadzika.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Makanzwa kukumbira kwangu: “Regai kudzivira nzeve dzenyu","poem":1},{"text":"pandinochemera rubatsiro.”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Makaswedera pedyo pandakakudanai,","poem":1},{"text":"mukati, “Usatya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Haiwa Ishe, makandireverera mhaka yangu;","poem":1},{"text":"makadzikinura upenyu hwangu.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Makaona imi Jehovha, zvakaipa zvandakaitirwa.","poem":1},{"text":"Nditongerei mhaka yangu!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Makaona udzamu hwokutsva kwavo,","poem":1},{"text":"idzo rangano dzavo dzose pamusoro pangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Haiwa Jehovha, makanzwa kutuka kwavo,","poem":1},{"text":"idzo rangano dzavo dzose pamusoro pangu,","poem":2}]},{"type":"verse","number":62,"content":[{"text":"dzinozevezerwa nokungurumwa navavengi vangu","poem":1},{"text":"pamusoro pangu zuva rose.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Tarirai kwavari! Vakagara kana kumira,","poem":1},{"text":"vanondituka nenziyo dzavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Varipidzirei zvakavafanira, imi Jehovha,","poem":1},{"text":"zvakaitwa namaoko avo.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Isai chidziro pamwoyo yavo,","poem":1},{"text":"uye kutuka kwenyu ngakuve pamusoro pavo!","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Vadzinganisei makatsamwa muvaparadze,","poem":1},{"text":"vabve pasi pamatenga aJehovha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}