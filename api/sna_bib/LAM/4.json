{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"LAM","translationId":"sna_bib","name":"Kuungudza kwaJeremia","commonName":"Kuungudza kwaJeremia","title":"KUUNGUDZA KWAJEREMIA","order":25,"numberOfChapters":5,"sha256":"05ef5affbc27857f85e1f5b7edfbfe4a029156bd253131bfd39641c98b056279","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/sna_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Haiwa, goridhe rasviba sei,","poem":1},{"text":"goridhe rakaisvonaka harichabwinyi sei!","poem":2},{"text":"Matombo matsvene aparadzirwa","poem":1},{"text":"kumusoro kwenzira imwe neimwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Haiwa vanakomana vanokosha veZioni,","poem":1},{"text":"kare vaimbokodzera chiero chavo chegoridhe,","poem":2},{"text":"zvino voonekwa sehari dzevhu,","poem":1},{"text":"iro basa ramaoko omuumbi wehari!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kunyange makava anopa mazamu awo","poem":1},{"text":"kuti anwise vana vawo,","poem":2},{"text":"asi vanhu vangu vava vasina hanya","poem":1},{"text":"seshiri dzemhou dziri mugwenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nokuda kwenyota rurimi rwomwana mucheche","poem":1},{"text":"runonamira mumukanwa make;","poem":2},{"text":"vana vanopemha chingwa,","poem":1},{"text":"asi hakuna anovapa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Avo vaisidya zvinonaka","poem":1},{"text":"vava vapemhi mumugwagwa.","poem":2},{"text":"Avo vakarerwa vachifuka nguo dzepepuru","poem":1},{"text":"zvino vava kuvata pamadurunhuru edota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kurangwa kwavanhu vangu","poem":1},{"text":"kukuru kupinda kweSodhomu,","poem":2},{"text":"rakaparadzwa pakarepo","poem":1},{"text":"pasina ruoko rwakadzoka kuzoribatsira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Machinda avo aipenya kupfuura chando,","poem":1},{"text":"uye akanga akachena kupfuura mukaka,","poem":2},{"text":"miviri yavo yakanga yakatsvuka kupfuura matombo anokosha amarubhi,","poem":1},{"text":"kuratidzika kwavo kwakaita sokwesafiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Asi zvino vasviba kupfuura chinʼai;","poem":1},{"text":"hapana angavaziva mumigwagwa.","poem":2},{"text":"Ganda ravo ranamira pamapfupa avo;","poem":1},{"text":"raoma zvokufanana nedanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Avo vakaurayiwa nomunondo vari nani","poem":1},{"text":"pane avo vanourayiwa nenzara;","poem":2},{"text":"vabayiwa nenzara, vaonda kwazvo","poem":1},{"text":"nokuda kwokushayiwa zvokudya zvinobva muminda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Namaoko avo vakadzi vaiva nomwoyo munyoro","poem":1},{"text":"vakabika vana vavo,","poem":2},{"text":"vakava zvokudya zvavo,","poem":1},{"text":"pakaparadzwa vanhu vangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jehovha akaratidza kutsamwa kwake kwose;","poem":1},{"text":"akadurura hasha dzake dzinotyisa.","poem":2},{"text":"Akabatidza moto paZioni","poem":1},{"text":"akapisa nheyo dzaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Madzimambo enyika haana kutenda,","poem":1},{"text":"kunyange navanhu vose vagere panyika,","poem":2},{"text":"kuti vavengi vangapinda","poem":1},{"text":"pamasuo eJerusarema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Zvakaitika nokuda kwezvivi zvavaprofita varo","poem":1},{"text":"uye nokuda kwezvakaipa zvavaprista varo,","poem":2},{"text":"vakateura ropa","poem":1},{"text":"ravakarurama mukati maro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Vanodzungaira munzira dzaro","poem":1},{"text":"savarume mapofu.","poem":2},{"text":"Vakasvibiswa neropa","poem":1},{"text":"zvokuti hapana angada kubata nguo dzavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Vanhu vanodanidzira kwavari vachiti, “Ibvai! Hamuna kuchena!","poem":1},{"text":"Ibvai! Ibvai! Musatibata!”","poem":2},{"text":"Panguva yokutiza nokudzungaira kwavo,","poem":1},{"text":"vanhu pakati pendudzi vanoti,","poem":2},{"lineBreak":true},{"text":"“Havangarambi vachigara pano.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kutsamwa kwaJehovha kwavaparadzira;","poem":1},{"text":"haachavachengetedza.","poem":2},{"text":"Havana kukudza uprista,","poem":1},{"text":"uye havana kuremekedza vakuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Meso edu oonera madzerere,","poem":1},{"text":"tichitarisira rubatsiro rusingauyi;","poem":2},{"text":"tiri pashongwe dzedu takatarisira","poem":1},{"text":"rudzi rwaizotiponesa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Vanhu vakatitevera kwose kwatakaenda,","poem":1},{"text":"zvokuti takatadza kufamba munzira dzedu chaidzo.","poem":2},{"text":"Magumo edu akanga ava pedyo, mazuva edu apera,","poem":1},{"text":"nokuti magumo akanga asvika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Vaitidzinganisa vaimhanya kupfuura","poem":1},{"text":"makondo okudenga;","poem":2},{"text":"vakatidzinganisa napamusoro pamakomo","poem":1},{"text":"uye vakatigaririra murenje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Muzodziwa waJehovha, iye mweya wedu wokufema chaiwo,","poem":1},{"text":"akanga abatwa mumisungo yavo.","poem":2},{"text":"Takafunga kuti mumumvuri wake","poem":1},{"text":"taizorarama pakati pendudzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Pembera ufare, iwe Mwanasikana weEdhomu,","poem":1},{"text":"iwe unogara munyika yeUzi.","poem":2},{"text":"Asi newewo uchapiwa mukombe uyu;","poem":1},{"text":"uchadhakwa uye uchazvibvisa nguo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Iwe, Mwanasikana weZioni, kurangwa kwako kuchaguma;","poem":1},{"text":"haangawedzeri mazuva ako outapwa.","poem":2},{"text":"Asi, iwe Mwanasikana weEdhomu, acharanga chivi chako","poem":1},{"text":"agoratidza kuipa kwako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}