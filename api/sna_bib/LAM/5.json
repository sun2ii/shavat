{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"LAM","translationId":"sna_bib","name":"Kuungudza kwaJeremia","commonName":"Kuungudza kwaJeremia","title":"KUUNGUDZA KWAJEREMIA","order":25,"numberOfChapters":5,"sha256":"05ef5affbc27857f85e1f5b7edfbfe4a029156bd253131bfd39641c98b056279","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/sna_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Rangarirai Jehovha, zvakatiwira;","poem":1},{"text":"tarirai, mugoona kunyadziswa kwedu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nhaka yedu yakapiwa kuvatorwa,","poem":1},{"text":"misha yedu kumabvakure.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tava nherera, hatina vabereki,","poem":1},{"text":"vanamai vedu sechirikadzi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tinofanira kutenga mvura yatinonwa;","poem":1},{"text":"huni dzedu dzinongowanikwa chete nomutengo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Avo vanotidzinganisa vari pedyo pedyo;","poem":1},{"text":"taneta uye hatina zororo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Takazviisa pasi peIjipiti neAsiria,","poem":1},{"text":"kuti tiwane chingwa chakakwana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Madzibaba edu akatadza uye vakafa,","poem":1},{"text":"uye tava kurangwa nokuda kwavo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Varanda vanotitonga,","poem":1},{"text":"uye hapana angatisunungura kubva pamaoko avo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tinowana chingwa chedu nokuisa upenyu hwedu munjodzi,","poem":1},{"text":"nokuda kwomunondo murenje.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ganda redu rava kupisa sechoto,","poem":1},{"text":"nokuda kwokupisa kwenzara.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vakachinya vakadzi muZioni,","poem":1},{"text":"mhandara, mumaguta eJudha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Machinda akasungirirwa namaoko avo;","poem":1},{"text":"vakuru havakudzwi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Majaya anoshanda paguyo;","poem":1},{"text":"vakomana vanotatarika vakatakura mitoro yehuni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vakuru vakabva pasuo reguta;","poem":1},{"text":"majaya akarega kuimba kwavo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mufaro mumwoyo medu waguma;","poem":1},{"text":"kutamba kwedu kwapinduka kukava kuchema.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Korona yawa kubva pamusoro wedu.","poem":1},{"text":"Tine nhamo isu, nokuti takatadza!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nokuda kwaizvozvi mwoyo yedu yapera simba,","poem":1},{"text":"nokuda kwezvinhu izvi meso edu otadza kuona,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"nokuti Gomo reZioni rava dongo,","poem":1},{"text":"makava ofambamo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Imi Jehovha, munotonga nokusingaperi;","poem":1},{"text":"chigaro chenyu choushe chiripo kuzvizvarwa zvose.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sei muchigara muchitikanganwa?","poem":1},{"text":"Sei muchitikanganwa kwenguva yakareba kudai?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tidzoserei kwamuri, Jehovha, kuti tigodzoka;","poem":1},{"text":"vandudzai mazuva edu senguva yekare,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kana musina kutiramba zvachose","poem":1},{"text":"kana kutitsamwira zvikuru kwazvo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}