{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"MIC","translationId":"sna_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"9dc59c244fae0491f7b5a9106456b5408be1df01e76570db792a05d5692b49a1","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/sna_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Shoko raJehovha rakauya kuna Mika weMoresheti panguva yokutonga kwaJotamu, Ahazi naHezekia, madzimambo aJudha, chiratidzo chaakaona pamusoro peSamaria neJerusarema."]},{"type":"verse","number":2,"content":[{"text":"Inzwai, imi marudzi avanhu, imi mose,","poem":1},{"text":"teerera, iwe nyika navose vari mauri,","poem":2},{"text":"kuti Ishe Jehovha achakupai mhosva,","poem":1},{"text":"Jehovha ari mutemberi yake tsvene.","poem":2}]},{"type":"heading","content":["Kutongwa kweSamaria neJerusarema"]},{"type":"verse","number":3,"content":[{"text":"Tarirai! Jehovha ari kubuda panzvimbo yaanogara:","poem":1},{"text":"anoburuka pasi agotsika panzvimbo dzakakwirira dzenyika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Makomo achanyongodeka pasi pake","poem":1},{"text":"uye mipata ichapamuka,","poem":2},{"text":"senamo pamoto,","poem":1},{"text":"semvura inoyerera pamawere.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvose izvi zvakaitika nokuda kwokudarika kwaJakobho,","poem":1},{"text":"nokuda kwezvivi zveimba yaIsraeri.","poem":2},{"text":"Kudarika kwaJakobho ndokweiko?","poem":1},{"text":"Hakuzi Samaria here?","poem":2},{"text":"Nzvimbo yakakwirira yaJudha ndeipiko?","poem":1},{"text":"Haizi Jerusarema here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Naizvozvo ndichaita Samaria murwi wamabwe,","poem":1},{"text":"nzvimbo yokusima minda yemizambiringa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zvose zvifananidzo zvaro zvichaputswa kuita zvimedu;","poem":1},{"text":"zvose zvipo zvaro zvomutemberi zvichapiswa nomoto;","poem":2},{"lineBreak":true},{"text":"ndichaparadza zvifananidzo zvaro zvose.","poem":2},{"text":"Sezvo akaunganidza zvipo zvake kubva pamibayiro yezvifeve,","poem":1},{"text":"semibayiro yezvifeve zvichazoshandiswa zvakare.”","poem":2}]},{"type":"heading","content":["Kuchema noKuungudza"]},{"type":"verse","number":8,"content":[{"text":"Nokuda kwaizvozvo ndichachema uye ndigoungudza;","poem":1},{"text":"ndichafamba ndisina shangu mutsoka uye ndisina kupfeka.","poem":2},{"text":"Ndichaungudza segava","poem":1},{"text":"uye ndichachema sezizi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuti ronda rake harirapiki;","poem":1},{"text":"rasvika kuna Judha.","poem":2},{"text":"Rasvika pasuo ravanhu vangu chaipo,","poem":1},{"text":"kunyange kuJerusarema chaiko.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Musazvireva paGati;","poem":1},{"text":"musambochema.","poem":2},{"text":"MuBheti Ofira","poem":1},{"text":"umburukai muguruva.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pfuurai muende musina kupfeka mukunyara,","poem":1},{"text":"imi munogara muShafiri.","poem":2},{"text":"Avo vanogara muZaanani","poem":1},{"text":"havangabudi kunze.","poem":2},{"text":"Bheti Ezeri riri mukuchema;","poem":1},{"text":"kudzivirirwa kwaro kwabviswa kubva kwariri.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Avo vanogara muMaroti mukurwadziwa kukuru","poem":1},{"text":"vakamirira kudzikinurwa,","poem":2},{"text":"nokuti njodzi yasvika ichibva kuna Jehovha,","poem":1},{"text":"kunyange pasuo reJerusarema.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Imi vanogara muRakishi,","poem":1},{"text":"sungai mabhiza enyu pangoro.","poem":2},{"text":"Ndimi makava mavambo echivi","poem":1},{"text":"kuMwanasikana weZioni,","poem":2},{"text":"Nokuti kudarika kwaIsraeri","poem":1},{"text":"kwakawanikwa mamuri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Naizvozvo uchapa zvipo zvokuonekedzana","poem":1},{"text":"kuna Moresheti Gati.","poem":2},{"text":"Guta reAkizibhi richaratidza unyengeri","poem":1},{"text":"kumadzimambo aIsraeri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndichauyisa mukundi","poem":1},{"text":"kwauri iwe unogara muMaresha.","poem":2},{"text":"Iye anova kubwinya kwaIsraeri","poem":1},{"text":"achauya kuAdhuramu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Veurai misoro yenyu mukuchema","poem":1},{"lineBreak":true},{"text":"nokuda kwavana vamunofarira;","poem":1},{"lineBreak":true},{"text":"zviitei musvuu sowegora,","poem":1},{"text":"nokuti vachabva kwamuri vachienda kuutapwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}