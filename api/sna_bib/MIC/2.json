{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"MIC","translationId":"sna_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"9dc59c244fae0491f7b5a9106456b5408be1df01e76570db792a05d5692b49a1","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/sna_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Urongwa hwoMunhu nohwaMwari"]},{"type":"verse","number":1,"content":[{"text":"Vane nhamo avo vanoronga zvakaipa,","poem":1},{"text":"avo vanoronga zvakaipa pamibhedha yavo!","poem":2},{"text":"Pakuedza kwamangwanani vanozviita","poem":1},{"text":"nokuti zviri musimba ravo kuzviita.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vanochiva minda vagoipamba,","poem":1},{"text":"nedzimba, uye vagodzitora.","poem":2},{"text":"Vanobira munhu imba yake,","poem":1},{"text":"nomuvakidzani nhaka yake.","poem":2}]},{"type":"verse","number":3,"content":["Naizvozvo Jehovha anoti,",{"text":"“Ndiri kuronga njodzi yokurwisa nayo vanhu ava,","poem":1},{"text":"zvamusingagoni kuzvidzivirira kwazviri.","poem":2},{"text":"Hamuchazofambizve muchizvikudza,","poem":1},{"text":"nokuti ichava nguva yedambudziko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pazuva iro vanhu vachakutukai;","poem":1},{"text":"vachakudenhai norwiyo urwu rwokuchema:","poem":2},{"text":"‘Taitwa dongo chose;","poem":1},{"text":"pfuma yavanhu vangu yagovaniswa.","poem":2},{"text":"Anonditorera!","poem":1},{"text":"Anopa minda yedu kuna vanotimukira?’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Naizvozvo muchashayiwa munhu kana mumwe, muungano yaJehovha,","poem":1},{"text":"kuti agove nyika nemijenya.","poem":2}]},{"type":"heading","content":["Vaprofita venhema"]},{"type":"verse","number":6,"content":[{"text":"Vaprofita vavo vanoti, “Musaprofita,","poem":1},{"text":"musaprofita pamusoro pezvinhu izvi;","poem":2},{"lineBreak":true},{"text":"kunyadziswa hakungatibati.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zvingataurwe here, nhai imi imba yaJakobho, kuti:","poem":1},{"text":"“Ko, mweya waJehovha watsamwa here?","poem":2},{"lineBreak":true},{"text":"Iye anoita zvinhu zvakadaro here?”","poem":2},{"lineBreak":true},{"text":"“Ko, mashoko angu haaiti zvakanaka here","poem":1},{"text":"kuno uyo ane nzira dzake dzakarurama?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asi mazuva ano vanhu vangu","poem":1},{"text":"vakandimukira somuvengi.","poem":2},{"text":"Munobvisa majasi anokosha","poem":1},{"text":"pane avo vanopfuura musina kana hanya,","poem":2},{"lineBreak":true},{"text":"savarume vodzoka kubva kuhondo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Munodzinga madzimai avanhu vangu","poem":1},{"text":"kubva mudzimba dzavo dzakanaka.","poem":2},{"text":"Munotora ropafadzo yangu","poem":1},{"text":"kubva kuvana vavo nokusingaperi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Simukai, ibvai pano!","poem":1},{"text":"Nokuti ino haisi nzvimbo yenyu yokuzororera,","poem":2},{"text":"nokuti yakasvibiswa,","poem":1},{"text":"yakaparadzwa zvisingagadziriki.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kana munyepi nomunyengeri akauya oti,","poem":1},{"text":"‘Ndichakuprofitirai waini zhinji nedoro,’","poem":2},{"lineBreak":true},{"text":"iyeyu achava muprofita wavanhu ava!","poem":2}]},{"type":"heading","content":["Kudzikinurwa kunovimbiswa"]},{"type":"verse","number":12,"content":[{"text":"“Zvirokwazvo ndichakuunganidzai imi mose, iwe Jakobho;","poem":1},{"text":"zvirokwazvo ndichaunganidza pamwe chete vakasara vaIsraeri.","poem":2},{"text":"Ndichavaunganidza pamwe chete samakwai muchirugu,","poem":1},{"text":"seboka pamafuro aro; nzvimbo yacho ichazara navanhu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uyo achaparura nzira achaenda pamberi pavo;","poem":1},{"text":"vachapwanya napasuo vagobuda panze.","poem":2},{"text":"Mambo wavo achapfuura ari pamberi pavo,","poem":1},{"text":"Iye Jehovha achivatungamirira.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}