{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"MIC","translationId":"sna_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"9dc59c244fae0491f7b5a9106456b5408be1df01e76570db792a05d5692b49a1","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/sna_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Vatungamiri naVaprofita vanotsiurwa"]},{"type":"verse","number":1,"content":["Ipapo ndakati,",{"text":"“Teererai imi vatungamiri vaJakobho,","poem":1},{"text":"imi vatongi veimba yaIsraeri.","poem":2},{"text":"Hamufaniri kuziva kururamisira here,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"imi munovenga zvakanaka muchida zvakaipa;","poem":2},{"text":"munofunura ganda","poem":1},{"text":"pamapfupa;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"munodya nyama yavanhu vangu,","poem":1},{"text":"munobvisa ganda ravo,","poem":2},{"lineBreak":true},{"text":"muchivhuna mapfupa avo kuita zvidimbu;","poem":2},{"text":"munovatema-tema senyama yokuisa mupani,","poem":1},{"text":"senyama yomuhari?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ipapo vachadana kuna Jehovha,","poem":1},{"text":"asi haangavadaviri.","poem":2},{"text":"Panguva iyoyo achavanza chiso chake","poem":1},{"text":"kwavari nokuda kwezvakaipa zvavakaita.","poem":2}]},{"type":"verse","number":5,"content":["Zvanzi naJehovha:",{"text":"“Kana vari vaprofita vanotsausa vanhu vangu,","poem":1},{"text":"kana mumwe akavapa zvokudya,","poem":2},{"text":"vanodanidzira kuti ‘Rugare’; kana akasavapa,","poem":1},{"text":"vanogadzirira kumurwisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naizvozvo usiku huchauya pamusoro pako,","poem":1},{"text":"pasina zviratidzo, nerima, pasina kuvuka.","poem":2},{"text":"Zuva richavirira vaprofita,","poem":1},{"text":"uye masikati achavasvibira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vaoni vachanyadziswa","poem":1},{"text":"uye vavuki vachanyadziswa.","poem":2},{"text":"Vachafukidza zviso zvavo","poem":1},{"text":"nokuti hakuna mhinduro inobva kuna Jehovha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Asi kana ndirini, ndizere nesimba,","poem":1},{"text":"noMweya waJehovha,","poem":2},{"text":"uye nokururamisira nesimba,","poem":1},{"text":"kuti ndizivise Jakobho kudarika kwake naIsraeri chivi chake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inzwai izvi, imi vatungamiri veimba yaJakobho,","poem":1},{"text":"imi vatongi veimba yaIsraeri,","poem":2},{"text":"munozvidza kururamisira","poem":1},{"text":"uye munominamisa zvose zvakanaka;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"munovaka Zioni nokudeura ropa,","poem":1},{"text":"uye Jerusarema nouipi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vatungamiri varo vanotongera fufuro,","poem":1},{"text":"vaprista varo vanodzidzisa kuti vapiwe mubayiro,","poem":2},{"lineBreak":true},{"text":"uye vaprofita varo vanoprofita kuti vapiwe mubayiro.","poem":2},{"text":"Asi vanozendama pana Jehovha voti,","poem":1},{"text":"“Ko, Jehovha haasi pakati pedu here?","poem":2},{"lineBreak":true},{"text":"Hapana njodzi ingatiwira.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naizvozvo nokuda kwenyu,","poem":1},{"text":"Zioni richarimwa somunda,","poem":2},{"text":"Jerusarema richava murwi wamabwe,","poem":1},{"text":"pachikomo pamire temberi, pachava dondo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}