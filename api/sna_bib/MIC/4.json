{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"MIC","translationId":"sna_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"9dc59c244fae0491f7b5a9106456b5408be1df01e76570db792a05d5692b49a1","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/sna_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Gomo raJehovha"]},{"type":"verse","number":1,"content":["Mumazuva okupedzisira",{"text":"gomo retemberi yaJehovha richasimbiswa","poem":1},{"text":"segomo guru pakati pamakomo;","poem":2},{"text":"richasimudzwa pamusoro pezvikomo,","poem":1},{"text":"uye marudzi achaenda kwariri.","poem":2}]},{"type":"verse","number":2,"content":["Ndudzi zhinji dzichauya dzichiti,",{"text":"“Uyai, handei kugomo raJehovha,","poem":1},{"text":"kuimba yaMwari waJakobho.","poem":2},{"text":"Achatidzidzisa nzira dzake,","poem":1},{"text":"kuti tigofamba munzira dzake.”","poem":2},{"text":"Murayiro uchabuda kubva paZioni,","poem":1},{"text":"shoko raJehovha kubva paJerusarema.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Achatonga pakati pamarudzi mazhinji","poem":1},{"text":"uye achapedza gakava pakati pendudzi dzine simba dziri kure kure.","poem":2},{"text":"Vachapfura minondo yavo vagoiita mapadza,","poem":1},{"text":"namapfumo vachiaita mapanga okuchekerera miti.","poem":2},{"text":"Rudzi harungasimudziri rumwe rudzi munondo,","poem":1},{"text":"havangazodzidzirizve kurwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mumwe nomumwe achagara pasi pomuzambiringa wake,","poem":1},{"text":"napasi pomuonde wake,","poem":2},{"text":"uye hapana anozovaita kuti vatye,","poem":1},{"text":"nokuti Jehovha Wamasimba Ose ataura.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndudzi dzose dzingafamba","poem":1},{"text":"muzita ravamwari vadzo;","poem":2},{"text":"isu tichafamba muzita raJehovha","poem":1},{"text":"Mwari wedu nokusingaperi-peri.","poem":2}]},{"type":"heading","content":["Urongwa hwaJehovha"]},{"type":"verse","number":6,"content":[{"text":"“Pazuva iro,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"“Ndichaunganidza vakaremara;","poem":2},{"text":"ndichaunganidza vakadzingwa","poem":1},{"text":"neavo vandakatambudza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndicharemadza vakasara,","poem":1},{"text":"vaya vakadzingwa, ivo rudzi rwakasimba.","poem":2},{"text":"Jehovha achavatonga paGomo reZioni","poem":1},{"text":"kubva pazuva iroro nokusingaperi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kana uri iwe, chirindo cheboka","poem":1},{"text":"iwe nhare yoMwanasikana weZioni,","poem":2},{"text":"ushe hwakare huchadzoswa kwauri;","poem":1},{"text":"umambo huchauya kuMwanasikana weJerusarema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sei muchiridza mhere iye zvino,","poem":1},{"text":"hamuna mambo here?","poem":2},{"text":"Gota renyu raparara here zvokuti kurwadza","poem":1},{"text":"kwakubatai sekwomukadzi anosununguka?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tambura ugomere,","poem":1},{"text":"iwe Mwanasikana weZioni,","poem":2},{"text":"somukadzi ari pakusununguka,","poem":1},{"text":"nokuti zvino unofanira kubuda muguta unogara kusango.","poem":2},{"text":"Uchaenda kuBhabhironi;","poem":1},{"text":"ikoko uchandonunurwa.","poem":2},{"text":"Ikoko Jehovha achakudzikinura","poem":1},{"text":"kubva paruoko rwavavengi vako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Asi zvino ndudzi zhinji","poem":1},{"text":"dzakaunganira kuzokurwisa.","poem":2},{"text":"Vanoti, “Ngaasvibiswe,","poem":1},{"text":"maziso edu ngaatarise Zioni!”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi havazivi","poem":1},{"text":"pfungwa dzaJehovha;","poem":2},{"text":"havanzwisisi kuronga kwake,","poem":1},{"text":"iye anovaunganidza sezvisote paburiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Simuka upure, iwe Mwanasikana weZioni,","poem":1},{"text":"nokuti ndichakupa nyanga dzesimbi;","poem":2},{"text":"ndichakupa mahwanda endarira","poem":1},{"text":"uye uchapwanya kuita zvidimbu ndudzi zhinji.”","poem":2},{"lineBreak":true},{"text":"Uchatsaurira kuna Jehovha zvavakazviwanira nenzira dzavo,","poem":1},{"text":"upfumi hwavo kuna Ishe wenyika yose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}