{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"MIC","translationId":"sna_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"9dc59c244fae0491f7b5a9106456b5408be1df01e76570db792a05d5692b49a1","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/sna_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Mutongi akavimbiswa kubva kuBheterehema"]},{"type":"verse","number":1,"content":[{"text":"Unganidza mauto ako, iwe guta ramauto,","poem":1},{"text":"nokuti takombwa nomuvengi.","poem":2},{"text":"Vacharova mutongi waIsraeri","poem":1},{"text":"netsvimbo padama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Asi iwe, Bheterehema Efurata,","poem":1},{"text":"kunyange uri muduku pakati pamarudzi aJudha,","poem":2},{"text":"kwauri kuchandibudira mumwe","poem":1},{"text":"achava mutongi pamusoro peIsraeri,","poem":2},{"text":"mavambo ake ndeakare kare,","poem":1},{"text":"kubva pamazuva akare kare.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Naizvozvo Israeri achasiyiwa","poem":1},{"text":"kusvikira panguva iyo, iye anorwadziwa azvara","poem":2},{"text":"uye hama dzake dzose","poem":1},{"text":"dzadzoka kuzobatana navaIsraeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Achamira agofudza boka rake","poem":1},{"text":"musimba raJehovha,","poem":2},{"lineBreak":true},{"text":"muukuru hwezita raJehovha Mwari wake.","poem":2},{"text":"Uye vachagara norugare,","poem":1},{"text":"nokuti ipapo kukura kwake kuchasvika kumagumo enyika.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Uye iye achava rugare rwavo.","poem":2},"Kudzikinurwa noKuparadzwa",{"text":"MuAsiria paacharwisa nyika yedu","poem":1},{"text":"agofamba achipfuura nomunhare dzedu,","poem":2},{"text":"tichamumutsira vafudzi vanomwe","poem":1},{"text":"kuti vamurwise kunyange vatungamiri vasere vavanhu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vachatonga nyika yeAsiria nomunondo,","poem":1},{"text":"nyika yaNimurodhi nomunondo wakavhomorwa.","poem":2},{"text":"Achatirwira kubva kumuAsiria","poem":1},{"text":"paachapinda munyika yedu","poem":2},{"lineBreak":true},{"text":"nokupinda pamiganhu yedu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vakasara vaJakobho vachava","poem":1},{"text":"pakati pamarudzi akawanda,","poem":2},{"text":"sedova rinobva kuna Jehovha,","poem":1},{"text":"sokunaya kwemvura pauswa,","poem":2},{"text":"zvisingamiriri munhu","poem":1},{"text":"kana kugaririra vanhu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vakasara vaJakobho vachava pakati pendudzi,","poem":1},{"text":"pakati poruzhinji rwamarudzi,","poem":2},{"text":"seshumba pakati pezvikara zvesango,","poem":1},{"text":"seshumba duku pakati pamapoka amakwai,","poem":2},{"text":"inotsika uye inobvambura ichienda,","poem":1},{"text":"pasina anogona kununura.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ruoko rwenyu ruchasimudzwa mukukunda","poem":1},{"text":"uye vadzivisi venyu vose vachaparadzwa.","poem":2}]},{"type":"verse","number":10,"content":["“Pazuva iro,” ndizvo zvinotaura Jehovha,",{"text":"“ndichaparadza mabhiza enyu pakati penyu","poem":1},{"text":"uye ndichapwanya ngoro dzenyu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndichaparadza maguta enyika yenyu","poem":1},{"text":"uye ndichaputsa nhare dzenyu dzose.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndichaparadza uroyi hwako","poem":1},{"text":"uye hauchazovizve navavuki.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndichaparadza zvifananidzo zvenyu","poem":1},{"text":"zvakavezwa neshongwe dzenyu pakati penyu;","poem":2},{"text":"hamuchazokotamiri","poem":1},{"text":"kubasa ramaoko enyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndichadzura kubva pakati penyu matanda aAshera","poem":1},{"text":"uye ndichaparadza maguta enyu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndichatsiva nokutsamwa nehasha","poem":1},{"text":"kundudzi dzisina kunditeerera.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}