{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"MIC","translationId":"sna_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"9dc59c244fae0491f7b5a9106456b5408be1df01e76570db792a05d5692b49a1","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/sna_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["Jehovha anopa Israeri mhosva"]},{"type":"verse","number":1,"content":["Teererai zvinotaurwa naJehovha:",{"text":"“Simukai, taurai nyaya yenyu pamberi pamakomo;","poem":1},{"text":"zvikomo ngazvinzwe zvamunoda kutaura.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Chinzwai imi makomo, kupomera kwaJehovha;","poem":1},{"text":"teererai, imi hwaro hwenyika hunogara nokusingaperi.","poem":2},{"text":"Nokuti Jehovha ane mhosva yaari kupa vanhu vake;","poem":1},{"text":"anopa Israeri mhosva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Vanhu vangu, chiiko chandakakuitirai?","poem":1},{"text":"Ndakakuremedzai neiko? Ndipindurei.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndakakubudisai kubva muIjipiti","poem":1},{"text":"uye akakudzikinurai kubva munyika youranda.","poem":2},{"text":"Ndakatuma Mozisi kuti azokutungamirirai,","poem":1},{"text":"naAroniwo naMiriamu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vanhu vangu,","poem":1},{"text":"rangarirai zvakaranganwa naBharaki mambo weMoabhu","poem":2},{"lineBreak":true},{"text":"nezvakapindurwa naBharamu mwanakomana waBheori.","poem":2},{"text":"Rangarirai rwendo rwenyu kubva kuShitimu kusvika kuGirigari,","poem":1},{"text":"kuti mugoziva mabasa akarurama aJehovha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndichauya neiko pamberi paJehovha.","poem":1},{"text":"Uye ndigokotama sei pamberi paMwari anokudzwa?","poem":2},{"text":"Ndingauye pamberi pake nezvibayiro","poem":1},{"text":"zvinopiswa nemhuru dzine gore rimwe here?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ko, Jehovha angafadzwa nezviuru zvamakondobwe,","poem":1},{"text":"uye nezviuru gumi zvenzizi dzamafuta here?","poem":2},{"text":"Ndingapa dangwe rangu nokuda kwokudarika kwangu,","poem":1},{"text":"icho chibereko chomuviri wangu pamusoro pokutadza kwomweya wangu here?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akakuratidza, iwe munhu, kuti zvakanaka ndezvipi.","poem":1},{"text":"Uye ndezvipi zvinodiwa naJehovha kubva kwauri?","poem":2},{"text":"Kuita zvakarurama uye kufarira kunzwira ngoni,","poem":1},{"text":"nokufamba naMwari wako wakazvininipisa.","poem":2}]},{"type":"heading","content":["Mhosva yeIsraeri nokurangwa kwayo"]},{"type":"verse","number":9,"content":[{"text":"Teererai! Jehovha anodanidzira kuguta,","poem":1},{"text":"uye kutya zita renyu ndihwo uchenjeri:","poem":2},{"lineBreak":true},{"text":"“Chenjererai shamhu naIye akaituma.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndichazokanganwa here, iwe imba yakaipa,","poem":1},{"text":"upfumi hwako hwakawanikwa nenzira dzakaipa,","poem":2},{"lineBreak":true},{"text":"nechiero cheefa chakatapudzwa, chakatukwa?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndingaregerera munhu ane chiero","poem":1},{"text":"chinonyengera nesaga rezviero zvenhema here?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vapfumi vake vanoita nechisimba;","poem":1},{"text":"vanhu vake varevi venhema,","poem":2},{"lineBreak":true},{"text":"uye miromo yavo inotaura nokunyengera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Naizvozvo, ndatotanga kukuparadzai,","poem":1},{"text":"kukuitai dongo nokuda kwezvivi zvenyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Muchadya asi hamungaguti:","poem":1},{"text":"dumbu renyu richaramba risina chinhu.","poem":2},{"text":"Muchaisa mudura asi mugoshaya zvamachengeta,","poem":1},{"text":"nokuti zvamunounganidza ndichazviparadza nomunondo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Muchadyara asi hamungakohwi;","poem":1},{"text":"muchasvina maorivhi asi hamungazori mafuta acho,","poem":2},{"lineBreak":true},{"text":"muchasvina mazambiringa asi hamunganwi waini yacho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Makachengeta zvirevo zvaOmuri","poem":1},{"text":"uye namabasa ose eimba yaAhabhu, uye makatevera tsika dzavo.","poem":2},{"text":"Naizvozvo ndichakuisai mukuparadzwa,","poem":1},{"text":"nevanhu venyu mukusekwa;","poem":2},{"lineBreak":true},{"text":"muchatakura kushorwa kwendudzi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}