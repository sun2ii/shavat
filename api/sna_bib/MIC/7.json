{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"MIC","translationId":"sna_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"9dc59c244fae0491f7b5a9106456b5408be1df01e76570db792a05d5692b49a1","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/sna_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Nhamo yeIsraeri"]},{"type":"verse","number":1,"content":[{"text":"Inhamoi yandinayo!","poem":1},{"lineBreak":true},{"text":"Ndafanana nouya anounganidza michero","poem":1},{"text":"yezhizha inosara mumunda wemizambiringa pakukohwa;","poem":2},{"text":"hapana sumbu ramazambiringa rokudya,","poem":1},{"text":"kana maonde okutanga andinopanga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vanhu vano umwari vabviswa panyika;","poem":1},{"text":"hapana mumwe akarurama asara.","poem":2},{"text":"Vanhu vose vanovandira kuti vateure ropa;","poem":1},{"text":"mumwe nomumwe anovhima hama yake nomumbure.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maoko ose ari maviri ane unyanzvi pakuita zvakaipa;","poem":1},{"text":"mubati anomanikidzira vanhu kuti vamupe zvipo,","poem":2},{"text":"mutongi anotambira fufuro,","poem":1},{"text":"vane simba vanomanikidzira zvido zvavo;","poem":2},{"lineBreak":true},{"text":"vose vanozvironga pamwe chete.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akanaka kupfuura vose akangoita sorukato,","poem":1},{"text":"vakarurama kupfuura vose vakaipa kupfuura ruzhowa rweminzwa.","poem":2},{"text":"Zuva renharirire dzenyu rasvika,","poem":1},{"text":"zuva rokushanyirwa kwenyu naMwari.","poem":2},{"lineBreak":true},{"text":"Zvino ino ndiyo nguva yokukanganiswa kwavo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rega kuvimba nomuvakidzani wako;","poem":1},{"text":"usavimba neshamwari yako.","poem":2},{"text":"Kunyange nomukadzi wawakagumbatira,","poem":1},{"text":"uchenjerere mashoko ako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nokuti mwanakomana anozvidza baba vake,","poem":1},{"text":"mwanasikana anomukira mai vake,","poem":2},{"text":"muroora anomukira vamwene vake;","poem":1},{"text":"vavengi vomunhu ndivo vanhu vemhuri yake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asi kana ndirini, ndinomirira netariro kuna Jehovha,","poem":1},{"text":"ndinomirira Mwari Muponesi wangu;","poem":2},{"lineBreak":true},{"text":"Mwari wangu achandinzwa.","poem":2}]},{"type":"heading","content":["Israeri ichasimuka"]},{"type":"verse","number":8,"content":[{"text":"Usafara pamusoro pangu, iwe muvengi wangu!","poem":1},{"text":"Kunyange ndakawira pasi, ndichasimuka.","poem":2},{"text":"Kunyange ndigere murima,","poem":1},{"text":"Jehovha achava chiedza changu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuti ndakamutadzira,","poem":1},{"text":"ndichatakura kutsamwa kwaJehovha,","poem":2},{"text":"kusvikira andireverera mhosva yangu","poem":1},{"text":"uye asimbisa kodzero yangu.","poem":2},{"text":"Achandibudisira kuchiedza,","poem":1},{"text":"ndichaona kururama kwake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ipapo muvengi wangu achazviona","poem":1},{"text":"uye achafukidzwa,","poem":2},{"text":"iye akati kwandiri,","poem":1},{"text":"“Aripiko Jehovha Mwari wako?”","poem":2},{"text":"Meso angu achaona kuwa kwake;","poem":1},{"text":"kunyange iye zvino achatsikwa","poem":2},{"lineBreak":true},{"text":"pasi petsoka sematope mumigwagwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Zuva rokuvaka masvingo enyu richasvika,","poem":1},{"text":"zuva rokuwedzerwa kwemiganhu yenyu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pazuva iro vanhu vachauya kwauri","poem":1},{"text":"vachibva kuAsiria namaguta eIjipiti,","poem":2},{"text":"kunyange kubva kuIjipiti kusvikira kuYufuratesi,","poem":1},{"text":"uye kubva kugungwa kusvika kune rimwe gungwa,","poem":2},{"lineBreak":true},{"text":"nokubva kugomo kusvika kune rimwe gomo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nyika ichava dongo nokuda kwavagari vayo,","poem":1},{"text":"nokuda kwamabasa avo.","poem":2}]},{"type":"heading","content":["Munyengetero noKurumbidza"]},{"type":"verse","number":14,"content":[{"text":"Fudza vanhu vako nomudonzvo wako,","poem":1},{"text":"boka renhaka yako,","poem":2},{"text":"rinogara roga musango,","poem":1},{"text":"mumafuro akanaka.","poem":2},{"text":"Rega afure muBhashani reGireadhi","poem":1},{"text":"samazuva ekare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Sapamazuva amakabuda kubva muIjipiti,","poem":1},{"text":"ndichavaratidza zvishamiso zvangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ndudzi dzichazviona uye dzichanyadziswa,","poem":1},{"text":"dzisisina simba radzo rose.","poem":2},{"text":"Vachabata miromo yavo","poem":1},{"text":"uye nzeve dzavo dzichadzivira.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Vachananzva guruva senyoka,","poem":1},{"text":"sezvipuka zvinokambaira pasi.","poem":2},{"text":"Vachabuda vachidedera kubva munzvimbo dzavo dzokuvanda;","poem":1},{"text":"vachadzoka vachitya kuna Jehovha Mwari wedu,","poem":2},{"lineBreak":true},{"text":"uye vachakutyai.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndiani Mwari akaita semi,","poem":1},{"text":"anoregerera chivi uye anokanganwira","poem":2},{"lineBreak":true},{"text":"kudarika kwavakasara venhaka yake?","poem":2},{"text":"Hamugari makatsamwa nokusingaperi,","poem":1},{"text":"asi munofarira kunzwira ngoni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Muchava nenyasha kwatiri zvakare;","poem":1},{"text":"muchatsikira zvivi zvedu pasi petsoka","poem":2},{"lineBreak":true},{"text":"uye muchakanda kuipa kwedu kwose pakadzikadzika mugungwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Muchava makatendeka kuna Jakobho,","poem":1},{"text":"mucharatidza nyasha kuna Abhurahama,","poem":2},{"text":"sezvamakapika mhiko kumadzibaba edu","poem":1},{"text":"mumazuva akare.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}