{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"NAM","translationId":"sna_bib","name":"Nahumi","commonName":"Nahumi","title":"NAHUMI","order":34,"numberOfChapters":3,"sha256":"8b1dddc9232d83c562e5d09bbdab9095979c9ecacb5aa62d04ce71fad2e01e20","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/sna_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Chirevo pamusoro peNinevhe. Bhuku rezvakaonekwa naNahumi muErikoshi."]},{"type":"heading","content":["Kutsamwa kwaJehovha pamusoro peNinevhe"]},{"type":"verse","number":2,"content":[{"text":"Jehovha ane godo uye ndiMwari anotsiva;","poem":1},{"text":"Jehovha anotsiva uye azere nehasha.","poem":2},{"text":"Jehovha anotsiva kuvavengi vake","poem":1},{"text":"uye anochengetera vavengi vake hasha dzake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jehovha anononoka kutsamwa uye ane simba guru;","poem":1},{"text":"Jehovha haangasiye ane mhosva asina kurangwa.","poem":2},{"text":"Nzira yake iri muchamupupuri nedutu,","poem":1},{"text":"uye makore ndiwo guruva retsoka dzake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anotuka gungwa agoriomesa;","poem":1},{"text":"anoita kuti nzizi dzose dziome.","poem":2},{"text":"Bhashani neKarimeri zvasvava","poem":1},{"text":"uye kutumbuka kweRebhanoni kwapera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Makomo anodengenyeka pamberi pake","poem":1},{"text":"uye zvikomo zvinonyungudika.","poem":2},{"text":"Nyika inodedera pamberi pake,","poem":1},{"text":"nyika uye navose vanogara mairi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndiani angadzivisa hasha dzake?","poem":1},{"text":"Ndiani angashingirire pahasha dzake dzinotyisa?","poem":2},{"text":"Hasha dzake dzadururwa somoto;","poem":1},{"text":"matombo apwanyika pamberi pake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jehovha akanaka,","poem":1},{"text":"utiziro panguva dzokutambudzika.","poem":2},{"text":"Anochengeta avo vanovimba naye,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"asi namafashamu ane simba guru,","poem":2},{"text":"achaparadza Ninevhe;","poem":1},{"text":"achateverera vavengi vake kusvikira murima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zvose zvavakaronga pamusoro paJehovha","poem":1},{"text":"iye achazviparadza;","poem":2},{"lineBreak":true},{"text":"dambudziko haringauyi kechipiri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vachakorokodzwa pakati peminzwa","poem":1},{"text":"uye vachadhakwa newaini yavo;","poem":2},{"lineBreak":true},{"text":"vachaparadzwa samashanga akaoma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kubva mauri, iwe Ninevhe,","poem":1},{"text":"pane mumwe akabuda anoronga zvakaipa pamusoro paJehovha","poem":2},{"lineBreak":true},{"text":"uye anopa zano rakaipa.","poem":2}]},{"type":"verse","number":12,"content":["Zvanzi naJehovha:",{"text":"“Kunyange vane vabatsiri uye vakawanda,","poem":1},{"text":"vachaurayiwa vakasazovapozve.","poem":2},{"text":"Kunyange ndakakutambudza, iwe Judha,","poem":1},{"text":"handichazokutambudzazve.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zvino ndichavhuna joko ravo kubva pamutsipa wako","poem":1},{"text":"uye ndichadambura ngetani dzako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Jehovha arayira shoko pamusoro pako, iwe Ninevhe, rokuti,","poem":1},{"text":"“Hauchazovi nezvizvarwa zvinopiwa zita rako.","poem":2},{"text":"Ndichaparadza zvifananidzo zvakavezwa nezvifananidzo zvakaumbwa,","poem":1},{"text":"zviri mutemberi yavamwari vako.","poem":2},{"text":"Ndichachera guva rako,","poem":1},{"text":"nokuti iwe wakaipa kwazvo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tarira, pamakomo apo,","poem":1},{"text":"tsoka dzouyo anouya namashoko akanaka,","poem":2},{"lineBreak":true},{"text":"anoparidza rugare!","poem":2},{"text":"Pemberera mitambo yako, iwe Judha,","poem":1},{"text":"uye uzadzise mhiko dzako.","poem":2},{"text":"Vakaipa havachakurwisazve;","poem":1},{"text":"vachaparadzwa zvachose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}