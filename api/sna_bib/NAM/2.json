{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"NAM","translationId":"sna_bib","name":"Nahumi","commonName":"Nahumi","title":"NAHUMI","order":34,"numberOfChapters":3,"sha256":"8b1dddc9232d83c562e5d09bbdab9095979c9ecacb5aa62d04ce71fad2e01e20","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/sna_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Ninevhe richawa"]},{"type":"verse","number":1,"content":[{"text":"Murwisi anouya kuzokurwisa iwe, Ninevhe;","poem":1},{"text":"rindai nhare,","poem":2},{"lineBreak":true},{"text":"tarirai kunzira,","poem":2},{"lineBreak":true},{"text":"sungai zviuno zvenyu,","poem":2},{"lineBreak":true},{"text":"unganidzai simba renyu rose!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jehovha achadzosa kurumbidzwa kwaJakobho","poem":1},{"text":"sokurumbidzwa kwaIsraeri,","poem":2},{"text":"kunyange vaparadzi vakavaparadza","poem":1},{"text":"uye vakaparadza mizambiringa yavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nhoo dzavarwi vake dzatsvuka;","poem":1},{"text":"mhare dzokurwa dzapfeka nguo tsvuku.","poem":2},{"text":"Matare engoro ovaima","poem":1},{"text":"pazuva rokugadzirirwa kwadzo;","poem":2},{"lineBreak":true},{"text":"mapfumo omupaini anovheyeswa-vheyeswa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoro dzovirima mumigwagwa,","poem":1},{"text":"dzinomhanya dzichienda nokudzoka muchivara.","poem":2},{"text":"Dzinoita samazhenje omoto;","poem":1},{"text":"dzinomhanya-mhanya semheni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Anodana mauto ake akasarudzwa,","poem":1},{"text":"asi vanogumburwa panzira yavo.","poem":2},{"text":"Vanomhanyira kurusvingo rweguta;","poem":1},{"text":"nhoo yokuzvidzivirira yaiswa panzvimbo payo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Masuo enzizi azarurwa","poem":1},{"text":"uye muzinda wamambo wakoromoka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shoko ratemwa rokuti guta","poem":1},{"text":"ritapwe, uye riendeswe kure.","poem":2},{"text":"Varandakadzi varo vanochema senjiva","poem":1},{"text":"uye vanorova zvipfuva zvavo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ninevhe rakafanana nedziva,","poem":1},{"text":"uye mvura yaro iri kuerera ichipera.","poem":2},{"text":"Vanochema vachiti, “Mirai! Mirai!”","poem":1},{"text":"asi hapana anocheuka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pambai sirivha!","poem":1},{"text":"Pambai goridhe!","poem":2},{"text":"Kuwanda kwazvo hakuperi,","poem":1},{"text":"ihwo upfumi hunobva pamhando dzose dzepfuma yaro!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Rabirwa, rapambwa, ratorerwa zvose!","poem":1},{"text":"Mwoyo yanyungudika, mabvi odedera,","poem":2},{"lineBreak":true},{"text":"miviri yobvunda, zviso zvose zvachenuruka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Riripiko bako reshumba,","poem":1},{"text":"nzvimbo yadzaipira vana vadzo zvokudya,","poem":2},{"text":"kwaienda shumba nehadzi yayo,","poem":1},{"text":"uye navana, pasina chokutya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Shumba yaiuraya zvaikwanira vana vayo","poem":1},{"text":"uye yakadzipira hadzi yayo nyama,","poem":2},{"text":"ichizadza mapako ayo nezvayakauraya","poem":1},{"text":"uye mapako ayo nenyama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ndine mhaka newe,”","poem":1},{"text":"ndizvo zvinotaura Jehovha Wamasimba Ose.","poem":2},{"text":"“Ndichapisa ngoro dzenyu dzive utsi,","poem":1},{"text":"uye munondo uchaparadza shumba dzenyu duku.","poem":2},{"text":"Ndichakusiyai musina nyama panyika.","poem":1},{"text":"Mazwi enhume dzako haangazonzwikazve.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}