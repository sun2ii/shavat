{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"NAM","translationId":"sna_bib","name":"Nahumi","commonName":"Nahumi","title":"NAHUMI","order":34,"numberOfChapters":3,"sha256":"8b1dddc9232d83c562e5d09bbdab9095979c9ecacb5aa62d04ce71fad2e01e20","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/sna_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Ninevhe rine nhamo"]},{"type":"verse","number":1,"content":[{"text":"Rine nhamo guta reropa,","poem":1},{"text":"rizere nenhema,","poem":2},{"text":"rizere nezvakapambwa,","poem":1},{"text":"harigari risina varinotambudza!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kurira kwetyava,","poem":1},{"text":"utsvikitsviki hwamavhiri,","poem":2},{"text":"mutsindo wamabhiza","poem":1},{"text":"nomubvumo wokutinhira kwengoro!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kumhanya kwavatasvi vamabhiza,","poem":1},{"text":"kupenya kweminondo","poem":2},{"lineBreak":true},{"text":"namapfumo anovaima!","poem":2},{"text":"Vazhinji vakaurayiwa,","poem":1},{"text":"mirwi yevakafa,","poem":2},{"text":"mitumbi isingaverengeki,","poem":1},{"text":"vanhu vachigumburwa nezvitunha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zvose izvi nokuda kwokuchiva kuzhinji kwechifeve,","poem":1},{"text":"chinokwezvera, mukuru wouroyi,","poem":2},{"text":"akatapa ndudzi noufeve hwake","poem":1},{"text":"namarudzi avanhu nouroyi hwake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Ndine mhaka newe,” ndizvo zvinotaura Jehovha Wamasimba Ose.","poem":1},{"text":"Ndichafukura nguo yako ifukidze chiso chako","poem":2},{"text":"“Ndicharatidza ndudzi kushama kwako","poem":1},{"text":"namadzimambo kunyadziswa kwako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndichakukandidzira tsvina,","poem":1},{"text":"ndichakuita akazvidzika","poem":2},{"lineBreak":true},{"text":"uye ndichakuita chiseko.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vose vachakuona vachakutiza uye vachati,","poem":1},{"text":"‘Ninevhe raparara, ndiani acharichema?’","poem":2},{"lineBreak":true},{"text":"Ndingawana kupi munhu angakunyaradza?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uri nani kupfuura Tebhesi here,","poem":1},{"text":"rakavakwa paNairi,","poem":2},{"lineBreak":true},{"text":"rakakomberedzwa nemvura?","poem":2},{"text":"Rwizi ndirwo rwairidzivirira,","poem":1},{"text":"mvura iri rusvingo rwaro.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Etiopia neIjipiti ndizvo zvaiva simba rayo guru;","poem":1},{"text":"Puti neRibhiya dzaiva pakati pavabatsiri vayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kunyange zvakadaro yakatapwa","poem":1},{"text":"ikaendeswa kuutapwa.","poem":2},{"text":"Vacheche varo vakaputsanyiwa","poem":1},{"text":"kumavambo kwemigwagwa yose.","poem":2},{"text":"Mijenya yakakandwa pamusoro pemachinda avo,","poem":1},{"text":"uye vakuru vavo vakasungwa nengetani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Newewo uchadhakwa;","poem":1},{"text":"uchavanda","poem":2},{"lineBreak":true},{"text":"ugotsvaka utiziro kubva kumuvengi wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nhare dzako dzose dzafanana nemiti yemionde","poem":1},{"text":"ine michero yokutanga yaibva;","poem":2},{"text":"paanozunzwa,","poem":1},{"text":"maonde anodonhera mumuromo momudyi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tarira mauto ako,","poem":1},{"text":"vose vakadzi!","poem":2},{"text":"Masuo enyika yako","poem":1},{"text":"akazarurirwa kuvavengi vako;","poem":2},{"lineBreak":true},{"text":"moto waparadza mazariro awo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Cherai mvura kuitira kukombwa,","poem":1},{"text":"simbisai nhare dzenyu!","poem":2},{"text":"Gadzirai ivhu,","poem":1},{"text":"kanyai dhaka,","poem":2},{"lineBreak":true},{"text":"mugadzire zvidhina zvenyu!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Moto uchakuparadzai imomo;","poem":1},{"text":"munondo uchakuurayai,","poem":2},{"lineBreak":true},{"text":"uye uchakuparadzai semhashu.","poem":2},{"text":"Berekanai semhashu,","poem":1},{"text":"muberekane sehwiza!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Makawedzera uwandu hwavatengesi venyu","poem":1},{"text":"kusvikira vapfuura nyeredzi dzedenga kuwanda.","poem":2},{"lineBreak":true},{"text":"Asi sehwiza, vanoparadza nyika","poem":2},{"lineBreak":true},{"text":"vobhururuka vachienda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Varindi venyu vakaita sehwiza,","poem":1},{"text":"machinda enyu segundamusaira rehwiza","poem":2},{"lineBreak":true},{"text":"dzinomhara pamadziro musi wakunotonhora,","poem":2},{"text":"asi kana zuva rabuda dzinobhururuka dzichienda,","poem":1},{"text":"uye hapana anoziva kuti kupi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Iwe mambo weAsiria, vafudzi vako vanotsumwaira;","poem":1},{"text":"machinda ako anorara pasi kuti azorore.","poem":2},{"text":"Vanhu vako vakapararira pamusoro pamakomo","poem":1},{"text":"pasina angavaunganidza.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hapana chingarapa ronda rako;","poem":1},{"text":"kukuvara kwako kuchakuuraya.","poem":2},{"text":"Mumwe nomumwe anonzwa nezveguhu rako","poem":1},{"text":"anorova maoko ake pakuwa kwako,","poem":2},{"text":"nokuti ndianiko asina kunzwa","poem":1},{"text":"utsinye hwako husina magumo?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}