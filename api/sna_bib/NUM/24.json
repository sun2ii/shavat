{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"NUM","translationId":"sna_bib","name":"Numeri","commonName":"Numeri","title":"NUMERI","order":4,"numberOfChapters":36,"sha256":"c78bea05fb9cc1b513a4757ef40d5700c6e981db0fd193b3609425e3ac326ff7","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/sna_bib/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Zvino Bharamu akati aona kuti zvinofadza Jehovha kuti aropafadze Israeri, haana kuzoita zvouroyi sepane dzimwe nguva, asi akaringisa chiso chake kurenje."]},{"type":"verse","number":2,"content":["Bharamu akati atarisa kunze akaona vaIsraeri vagere pamusasa, rudzi norudzi, Mweya waMwari wakauya pamusoro pake"]},{"type":"verse","number":3,"content":["uye akataura chirevo chake achiti:",{"text":"“Chirevo chaBharamu mwanakomana waBheori,","poem":1},{"text":"chirevo chaiye ana meso anonyatsoona,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"chirevo chaiye anonzwa mashoko aMwari,","poem":1},{"text":"anoona chiratidzo chinobva kuna Wamasimba Ose,","poem":2},{"lineBreak":true},{"text":"anowira pasi nedumbu rake, uye ana meso akasvinura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Matende ako akanaka seiko, iwe Jakobho,","poem":1},{"text":"nougaro hwako, iwe Israeri!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Semipata, vakaita fararira,","poem":1},{"text":"samapindu pedyo norwizi,","poem":2},{"text":"segavakava rakasimwa naJehovha, s","poem":1},{"text":"semisidhari pedyo nemvura.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mvura ichayerera ichibva muzvirongo zvavo;","poem":1},{"text":"mbeu dzavo dzichawana mvura yakawanda.","poem":2},{"lineBreak":true},{"text":"“Mambo wavo achava mukuru kupinda Agagi;","poem":1},{"text":"umambo hwavo huchasimudzirwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Mwari akavabudisa muIjipiti;","poem":1},{"text":"vane simba renyati.","poem":2},{"text":"Vanomedza ndudzi dzine hasha","poem":1},{"text":"uye vanovhuna-vhuna mapfupa adzo;","poem":2},{"lineBreak":true},{"text":"Vanovabaya nemiseve yavo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Seshumba vanoti vhumba vagovata pasi,","poem":1},{"text":"seshumbakadzi, ndianiko angashinga kuvamutsa?","poem":2},{"lineBreak":true},{"text":"“Vose vanokuropafadza, ngavaropafadzwe","poem":1},{"text":"uye vose vanokutuka, ngavatukwe!”","poem":2}]},{"type":"verse","number":10,"content":["Ipapo kutsamwa kwaBharaki kwakapfuta pamusoro paBharamu. Akarova maoko ake pamwe chete akati kwaari, “Ndakakudanira kuzotuka vavengi vangu, asi wavaropafadza katatu kose aka."]},{"type":"verse","number":11,"content":["Zvino chibva izvozvi uende kwako! Ndakati ndichakupa mubayiro wakaisvonaka, asi Jehovha akudzivisa kuti upiwe mubayiro.”"]},{"type":"verse","number":12,"content":["Bharamu akapindura Bharaki akati, “Ko, handina kutaurira nhume dzawakatuma kwandiri here kuti,"]},{"type":"verse","number":13,"content":["‘Kunyange dai Bharaki andipa muzinda wake wakazara nesirivha negoridhe, handaigona kuita chinhu nokuda kwangu, chakanaka kana chakaipa, kuti ndidarike murayiro waJehovha, uye kuti ndinofanira kutaura chete zvinenge zvataurwa naJehovha here’?"]},{"type":"verse","number":14,"content":["Zvino ndava kudzokera kuvanhu vokwangu, asi uya ndikuyambire zvichaitirwa vanhu vako navanhu ava pamazuva anouya.”"]},{"type":"heading","content":["Chirevo chaBharamu Chechina"]},{"type":"verse","number":15,"content":["Ipapo akataura chirevo chake akati:",{"text":"“Chirevo chaBharamu mwanakomana waBheori,","poem":1},{"text":"chirevo chaiye anoona zvakajeka,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"chirevo chaiye anonzwa mashoko aMwari,","poem":1},{"text":"ano ruzivo runobva kuno Wokumusoro-soro,","poem":2},{"text":"anoona chiratidzo chinobva kuna Wamasimba Ose,","poem":1},{"text":"anowira pasi nedumbu rake, uye ana meso akasvinura:","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Ndiri kumuoona, asi kwete iye zvino;","poem":1},{"text":"ndinomuona, asi haasi pedyo.","poem":2},{"text":"Nyeredzi ichabuda muna Jakobho;","poem":1},{"text":"Tsvimbo youshe ichamera kubva muna Israeri.","poem":2},{"text":"Achapwanya huma dzavaMoabhu,","poem":1},{"text":"madehenya avanakomana vose vaSeti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Edhomu achakundwa;","poem":1},{"text":"Seiri, muvengi wake, achakundwa,","poem":2},{"lineBreak":true},{"text":"asi Israeri achasimba.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mutongi achabuda muna Jakobho","poem":1},{"text":"uye achaparadza vakasara veguta.”","poem":2}]},{"type":"heading","content":["Zvirevo zvaBharamu Zvokupedzisira"]},{"type":"verse","number":20,"content":["Ipapo Bharamu akaona Amareki uye akataura chirevo chake achiti:",{"text":"“Amareki akanga ari wokutanga pakati pendudzi,","poem":1},{"text":"asi pakupedzisira achaparadzwa.”","poem":2}]},{"type":"verse","number":21,"content":["Ipapo akaona vaKeni uye akataura chirevo chake achiti:",{"text":"“Ugaro hwako hwakachengetedzeka,","poem":1},{"text":"dendere rako rakavakwa padombo;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"asi imi vaKeni muchaparadzwa,","poem":1},{"text":"Ashuri paachakutapai.”","poem":2}]},{"type":"verse","number":23,"content":["Ipapo akataura chirevo chake akati:",{"text":"“Haiwa, ndianiko angararama kana Mwari akaita izvi?","poem":1}]},{"type":"verse","number":24,"content":[{"text":"Zvikepe zvichauya zvichibva kumahombekombe eKitimu;","poem":2},{"text":"zvichakunda Ashuri neEbheri,","poem":1},{"text":"asi naizvowo zvichaparadzwa.”","poem":2}]},{"type":"verse","number":25,"content":["Ipapo Bharamu akasimuka akadzokera kunyika yake, uye Bharaki akaenda kwakewo."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}