{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"OBA","translationId":"sna_bib","name":"Obhadhia","commonName":"Obhadhia","title":"OBHADHIA","order":31,"numberOfChapters":1,"sha256":"a49399936942538d380614b23cf5f2b377849e7177e36af7ce8fd0ba130dfad0","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/sna_bib/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Zvakaratidzwa Obhadhia. Zvanzi naIshe Jehovha pamusoro peEdhomu:",{"text":"Takanzwa shoko rakabva kuna Jehovha richiti:","poem":1},{"text":"Nhume yakatumwa kundudzi kuti indotaura ichiti,","poem":2},{"text":"“Simukai, tiende tindorwa hondo naye.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Tarirai, ndichakudukupisai pakati pendudzi;","poem":1},{"text":"muchamhurwa zvachose.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kuzvikudza kwemwoyo yenyu kwakakunyengerai,","poem":1},{"text":"iyemi mugere mumikaha yamatombo","poem":2},{"lineBreak":true},{"text":"muchiita kwakakwirira misha yenyu,","poem":2},{"text":"imi munoti mumwoyo yenyu,","poem":1},{"text":"‘Ndianiko angandiburutsira pasi?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kunyange mukabhururuka segondo","poem":1},{"text":"mukaruka dendere renyu pakati penyeredzi,","poem":2},{"lineBreak":true},{"text":"kubva ipapo ndichakukandai pasi,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"“Kana mbavha dzikauya kwamuri,","poem":1},{"text":"kana makororo usiku,","poem":2},{"text":"haiwa, muchaparadzwa zvakadiniko?","poem":1},{"text":"Havazoba kusvikira pavanoda here?","poem":2},{"text":"Dai vatanhi vamazambiringa vaiuya kwamuri,","poem":1},{"text":"ko, havaizosiya mazambiringa mashoma here?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asi Esau achasiyiwa seiko asina chinhu,","poem":1},{"text":"pfuma yake yakavigwa ichatorwa!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vose vaiva nesungano newe vachakumanikidza kusvikira kumuganhu;","poem":1},{"text":"shamwari dzako dzichakunyengera dzigokukunda;","poem":2},{"text":"vanodya zvokudya zvako vachakuisira musungo,","poem":1},{"text":"asi haungazvizivi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Pazuva iro,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"“handingazoparadzi vachenjeri veEdhomu,","poem":2},{"lineBreak":true},{"text":"varume vazere nokunzwisisa pakati pamakomo eEdhomu here?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mhare dzako, iwe Temani,","poem":1},{"text":"dzichavhunduka,","poem":2},{"lineBreak":true},{"text":"uye vose vari mumakomo aEsau vachaparara pakuurayiwa ikoko.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nokuda kwokuti wakarwisa mununʼuna wako Jakobho,","poem":1},{"text":"uchafukidzwa nenyadzi;","poem":2},{"lineBreak":true},{"text":"uchaparadzwa nokusingaperi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zuva iro rawakamira kure,","poem":1},{"text":"vatorwa pavakatakura pfuma yake vakaenda nayo,","poem":2},{"text":"uye vabvakure vakapinda mumasuo ake,","poem":1},{"text":"vakakanda mijenya pamusoro peJerusarema,","poem":2},{"lineBreak":true},{"text":"iwe wakaita somumwe wavo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Haufaniri kutarisira mununʼuna wako pasi,","poem":1},{"text":"pazuva rokushayiwa kwake,","poem":2},{"text":"kana kufara pamusoro pavanhu veJudha,","poem":1},{"text":"pazuva rokuparadzwa kwavo,","poem":2},{"text":"kana kuzvikudza zvakanyanya","poem":1},{"text":"pazuva rokutambudzika kwavo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hamufaniri kufamba napamasuo avanhu vangu,","poem":1},{"text":"pazuva renjodzi yavo,","poem":2},{"text":"kana kuvatarisira pasi vava munjodzi,","poem":1},{"text":"pazuva renjodzi yavo,","poem":2},{"text":"kana kuvatorera pfuma yavo","poem":1},{"text":"pazuva renhamo yavo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hamufaniri kumira pamharadzano dzenzira,","poem":1},{"text":"kuti muuraye vanotiza vavo,","poem":2},{"text":"kana kuisa vakasara vavo kuvavengi vavo,","poem":1},{"text":"pazuva rokutambudzika kwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Zuva raJehovha rava pedyo","poem":1},{"text":"kundudzi dzose.","poem":2},{"text":"Sezvamakaita, ndizvo zvichaitwawo kwamuri;","poem":1},{"text":"mabasa enyu achadzokera pamisoro yenyu chaiyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sezvamakanwa pagomo rangu dzvene,","poem":1},{"text":"saizvozvowo ndudzi dzose dzicharamba dzichingonwa;","poem":2},{"text":"dzichanwa nokunwa dzikaita","poem":1},{"text":"sedzisina kumbovapo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Asi paGomo reZioni pachava nokununurwa;","poem":1},{"text":"richava dzvene,","poem":2},{"text":"uye imba yaJakobho","poem":1},{"text":"ichadzoserwa nhaka yayo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Imba yaJakobho ichava moto,","poem":1},{"text":"uye imba yaJosefa murazvo womoto;","poem":2},{"text":"imba yaEsau ichava mashanga,","poem":1},{"text":"uye vachaipisa nomoto vagoipedza.","poem":2},{"text":"Hakuzovi navanopona","poem":1},{"text":"muimba yaEsau.”","poem":2},{"text":"Jehovha ataura izvozvo.","poem":4}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Vanhu vanobva kuNegevhi","poem":1},{"text":"vachagara mumakomo aEsau,","poem":2},{"text":"uye vanhu vanobva mujinga mezvikomo","poem":1},{"text":"vachatora nyika yavaFiristia kuti ive yavo.","poem":2},{"text":"Vachatora minda yaEfuremu pamwe chete neSamaria,","poem":1},{"text":"kuti zvive zvavo, uye Bhenjamini achatora Gireadhi kuti ive yake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ungano iyi yavaIsraeri vakadzingwa vagere muKenani","poem":1},{"text":"ichatora nyika kusvikira kuZarefati;","poem":2},{"text":"vakadzingwa kubva muJerusarema vagere muSefaradhi","poem":1},{"text":"vachatora maguta eNegevhi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vaponesi vachakwira pamusoro peGomo reZioni,","poem":1},{"text":"kuti vandotonga makomo aEsau.","poem":2},{"lineBreak":true},{"text":"Uye ushe huchava hwaJehovha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}