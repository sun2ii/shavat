{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"heading","content":["Mavambo: Chinangwa neDingindira"]},{"type":"verse","number":1,"content":["Zvirevo zvaSoromoni mwanakomana waDhavhidhi, mambo weIsraeri:"]},{"type":"verse","number":2,"content":[{"text":"kuti uwane uchenjeri nokurayirwa;","poem":2},{"lineBreak":true},{"text":"nokunzwisisa mashoko enjere;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kuti uve noupenyu hwokuzvibata hune uchenjeri","poem":1},{"text":"uchiita zvakarurama nokururamisira uye nokuenzanisira;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kuti vasina mano vapiwe uchenjeri,","poem":1},{"text":"jaya ripiwe ruzivo namano,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"vakachenjera ngavanzwe uye vagowedzera pakudzidza kwavo,","poem":1},{"text":"uye vanonzvera ngavawane kutungamirirwa,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kuti vanzwisise zvirevo nemifananidzo,","poem":1},{"text":"mashoko nezvirahwe zvavakachenjera.","poem":2}]},{"type":"verse","number":7,"content":["Kutya Jehovha ndiwo mavambo ezivo,",{"text":"asi mapenzi anoshora uchenjeri nokurayirwa.","poem":2}]},{"type":"heading","content":["Kugamuchira Uchenjeri kunokurudzirwa"]},{"type":"heading","content":["Yambiro pamusoro poUnyengeri"]},{"type":"verse","number":8,"content":[{"text":"Mwanakomana wangu, teerera,","poem":1},{"text":"kurayira kwababa vako, uye usarasa kudzidzisa kwamai vako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zvichava chishongo chakanaka pamusoro wako","poem":1},{"text":"nouketani hunoshongedza mutsipa wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mwanakomana wangu, kana vatadzi vachikukwezva,","poem":1},{"text":"usabvuma zvavari kuda kuti uite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kana vakati, “Handei tose;","poem":1},{"text":"ngativandirei munhu timuuraye;","poem":2},{"lineBreak":true},{"text":"ngativandirei mweya usina mhosva;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ngativamedzei vari vapenyu, seguva,","poem":1},{"text":"uye vakakwana kudaro savaya vanodzika mugomba;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"tichawana marudzi ose ezvinhu zvinokosha","poem":1},{"text":"tigozadza dzimba dzedu nezvatichapamba;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"isa zvinhu zvako pamwe chete nesu,","poem":1},{"text":"tigova nechikwama chimwe chete,”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"mwanakomana wangu, usabvumirana navo,","poem":1},{"text":"usaisa rutsoka panzira dzavo;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"nokuti tsoka dzavo dzinomhanyira muchivi,","poem":1},{"text":"vanokurumidza kundodeura ropa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hazvibatsiri sei kutambanudza mumbure","poem":1},{"text":"shiri dzose dzichinyatsoona!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Varume ava vanovandira ropa ravo vomene;","poem":1},{"text":"vanozvivandira ivo pachavo!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Aya ndiwo magumo avaya vanotsvaka pfuma nenzira yakaipa;","poem":1},{"text":"inouraya vaya vanoiwana.","poem":2}]},{"type":"heading","content":["Yambiro pamusoro poKuramba Uchenjeri"]},{"type":"verse","number":20,"content":[{"text":"Uchenjeri hunodanidzira nenzwi guru mumugwagwa,","poem":1},{"text":"hunokwidza inzwi rahwo pachivara;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kumusoro kwemigwagwa ine ruzha hunodanidzira,","poem":1},{"text":"pamasuo eguta hunotaura shoko rahwo huchiti:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Kusvikira riniko imi vasina mano, muchingoda kugara musina mano?","poem":1},{"text":"Kusvikira riniko vaseki vachifarira kuseka,","poem":2},{"lineBreak":true},{"text":"uye mapenzi achivenga zivo?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dai makateerera kutsiura kwangu,","poem":1},{"text":"ndingadai ndakadurura mwoyo wangu kwamuri","poem":2},{"lineBreak":true},{"text":"uye ndakazivisa pfungwa dzangu kwamuri.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Asi sezvo makandiramba pandakakudanai","poem":1},{"text":"uye pasina kana mumwe akateerera pandakatambanudza ruoko rwangu,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"sezvo makashaya hanya nokurayira kwangu,","poem":1},{"text":"uye mukasagamuchira kutsiura kwangu,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"iniwo ndichaseka panguva yenjodzi yenyu;","poem":1},{"text":"ndichaseka dambudziko parichakusvikirai,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"dambudziko parichakukundai sedutu,","poem":1},{"text":"njodzi paichavhuvhuta pamusoro penyu sechamupupuri,","poem":2},{"lineBreak":true},{"text":"nhamo namatambudziko pazvichakukundai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Ipapo vachadana kwandiri asi ini handingavapinduri;","poem":1},{"text":"vachanditsvaka asi havangandiwani.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Sezvo vakavenga zivo","poem":1},{"text":"uye vakasasarudza kutya Jehovha,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"sezvo vasina kugamuchira yambiro yangu,","poem":1},{"text":"uye vakashora kutsiura kwangu,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"vachadya zvibereko zvenzira dzavo","poem":1},{"text":"uye vachazadzwa nezvibereko zvemano avo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nokuti kusateerera kwavasina mano kuchavaurayisa,","poem":1},{"text":"uye kushaya hanya kwamapenzi kuchavaparadza;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"asi ani naani achanditeerera achagara murugare,","poem":1},{"text":"uye achagara akasununguka, asingatyi kuparadzwa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}