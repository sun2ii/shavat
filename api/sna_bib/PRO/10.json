{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"heading","content":["Zvirevo zvaSoromoni"]},{"type":"verse","number":1,"content":["Zvirevo zvaSoromoni:",{"text":"Mwanakomana akachenjera anofadza baba vake,","poem":1},{"text":"asi mwanakomana benzi anosuwisa mai vake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pfuma yakawanikwa zvakaipa haibatsiri chinhu,","poem":1},{"text":"asi kururama kunorwira parufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jehovha haatenderi akarurama kuti anzwe nzara,","poem":1},{"text":"asi kupanga kwowakaipa anokusundira kure.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Maoko ane usimbe anoita kuti munhu ave murombo,","poem":1},{"text":"asi maoko anoshingaira anopfumisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Anounganidza zvirimwa muzhizha, mwanakomana akachenjera,","poem":1},{"text":"asi anorara munguva yokukohwa, mwanakomana anonyadzisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Maropafadzo ndiwo korona yomusoro woakarurama,","poem":1},{"text":"asi kuita nechisimba kuzere mumuromo womunhu akaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kuyeukwa kwowakarurama kuchava chikomborero,","poem":1},{"text":"asi zita rowakaipa richaora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Akachenjera pamwoyo anogamuchira mirayiro,","poem":1},{"text":"asi benzi rinotaura zvisina maturo richaparara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Munhu akarurama anofamba akachengetedzeka,","poem":1},{"text":"asi uyo anofamba nenzira dzakaminama achabatwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Uyo anochonya neziso roruvengo anouyisa kusuwa,","poem":1},{"text":"asi benzi rinotaura zvisina maturo richaparara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Muromo womunhu akarurama chitubu choupenyu,","poem":1},{"text":"asi kuita nechisimba kuzere mumuromo womunhu akaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ruvengo runomutsa kupesana,","poem":1},{"text":"asi rudo runofukidzira zvakaipa zvose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Uchenjeri hunowanikwa pamiromo yavane njere,","poem":1},{"text":"asi shamhu yakafanira musana wouyo asina njere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Vanhu vakachenjera vanochengeta zivo,","poem":1},{"text":"asi muromo webenzi unotsvaka kuparara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Upfumi hwavakapfuma ndiro guta ravo rina masvingo,","poem":1},{"text":"asi urombo ndiko kuparadzwa kwavarombo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mubayiro wavakarurama ndihwo upenyu,","poem":1},{"text":"asi zvinowanikwa nowakaipa ndiko kurangwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Uyo anoteerera kurayira anoratidza nzira youpenyu,","poem":1},{"text":"asi ani naani anozvidza kudzorwa anotsausa vamwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Uyo anovanza ruvengo rwake ane miromo inoreva nhema,","poem":1},{"text":"uye ani naani anoparadzira guhwa ibenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kana mashoko ari mazhinji, chivi hachingashayikwi,","poem":1},{"text":"asi uyo anodzora rurimi rwake akachenjera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Rurimi rwakarurama isirivha yakaisvonaka,","poem":1},{"text":"asi mwoyo wowakaipa haubatsiri chinhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Miromo yemunhu akarurama inosimbisa vazhinji,","poem":1},{"text":"asi mapenzi anofa nokuda kwokushayiwa zivo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kuropafadza kwaJehovha kunowanisa upfumi,","poem":1},{"text":"uye haawedzeri matambudziko kwahuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Benzi rinofadzwa nokuita zvakaipa,","poem":1},{"text":"asi munhu anonzwisisa anofarira uchenjeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Zvinotyiwa nowakaipa ndizvo zvichaitika kwaari;","poem":1},{"text":"zvinoshuviwa nowakarurama zvichapiwa kwaari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kana dutu rapfuura napo, vakaipa havazowanikwi,","poem":1},{"text":"asi vakarurama vachamira vakasimba nokusingaperi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Sevhiniga kumazino noutsi kumaziso,","poem":1},{"text":"ndizvo zvakaita simbe kuna avo vachamutuma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kutya Jehovha kunowedzera mazuva kuupenyu,","poem":1},{"text":"asi makore owakaipa achatapudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Tarisiro yowakarurama mufaro,","poem":1},{"text":"asi tariro dzowakaipa dzichaparadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Nzira yaJehovha ndiyo utiziro hwavakarurama,","poem":1},{"text":"asi ndiko kuparadzwa kwaavo vanoita zvakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Akarurama haangatongodzurwi,","poem":1},{"text":"asi vakaipa havangarambi vari munyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Muromo womunhu akarurama unobudisa uchenjeri,","poem":1},{"text":"asi rurimi rwakaipa ruchabviswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Miromo yomunhu akarurama inoziva zvakafanira,","poem":1},{"text":"asi muromo womunhu akaipa, zvakaipa chete.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}