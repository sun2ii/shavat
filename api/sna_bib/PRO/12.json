{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Ani naani anofarira kuzvirovedza anoda zivo,","poem":1},{"text":"asi uyo anovenga kudzorwa ibenzi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Munhu akanaka anowana nyasha kubva kuna Jehovha,","poem":1},{"text":"asi Jehovha anotuka munhu ane mano akaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Munhu haangasimbiswi nezvakaipa,","poem":1},{"text":"asi mudzi womunhu akarurama haungadzurwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mudzimai ane unhu hwakanaka ikorona kumurume wake,","poem":1},{"text":"asi mudzimai anonyadzisa akafanana nokuora mumapfupa omurume wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Urongwa hwomunhu akarurama hwakarurama,","poem":1},{"text":"asi kurayira kwavakaipa kunonyengera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mashoko owakaipa anovandira ropa,","poem":1},{"text":"asi kutaura kwavakarurama kunovanunura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vanhu vakaipa vanobviswa pachigaro uye havazovapozve,","poem":1},{"text":"asi imba yowakarurama icharamba yakasimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Munhu anorumbidzwa maererano nouchenjeri hwake,","poem":1},{"text":"asi vanhu vane pfungwa dzakatsauka vanozvidzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zviri nani kuva munhu anoninipiswa asi iwe une muranda,","poem":1},{"text":"pane kuzviita munhu wapamusoro iwe usina zvokudya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Munhu akarurama ane hanya nechipfuwo chake,","poem":1},{"text":"asi zviito zvakanaka zvowakaipa utsinye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Uyo anoshanda mumunda wake achava nezvokudya zvakawanda,","poem":1},{"text":"asi uyo anongotevera zvisina maturo anoshayiwa zivo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Vakaipa vanopanga zvakapambwa zvavanhu vakaipa,","poem":1},{"text":"asi mudzi woakarurama unobereka zvibereko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Munhu akaipa anobatwa nokutaura kwake kwakaipa,","poem":1},{"text":"asi munhu akarurama anopunyuka padambudziko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kubva pazvibereko zvemiromo yake munhu anozadzwa nezvinhu zvakanaka,","poem":1},{"text":"zvirokwazvo sokupiwa mubayiro kwaanoitwa nebasa ramaoko ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Nzira yebenzi inoita seyakanaka kwaari,","poem":1},{"text":"asi munhu akachenjera anoteerera kurayira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Benzi rinoratidza kutsamwa pakarepo,","poem":1},{"text":"asi munhu akachenjera anoshayira hanya kutukwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Chapupu chezvokwadi chinopa uchapupu hwezvokwadi,","poem":1},{"text":"asi chapupu chenhema chinoreva nhema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mashoko anotaurwa nokusarangarira anobaya somunondo,","poem":1},{"text":"asi rurimi rwomunhu akachenjera runoporesa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Miromo yezvokwadi ichasimbiswa nokusingaperi,","poem":1},{"text":"asi rurimi runoreva nhema runogara kwechinguva chiduku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mune kunyengera mumwoyo yaavo vanoronga zvakaipa,","poem":1},{"text":"asi rufaro rwuri kune avo vanokurudzira rugare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Akarurama haangatongowirwi nezvakaipa,","poem":1},{"text":"asi vakaipa vachava namatambudziko akavafanira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Jehovha anovenga miromo inotaura nhema,","poem":1},{"text":"asi anofadzwa navanhu vanotaura chokwadi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Munhu akachenjera anovanza zivo yake,","poem":1},{"text":"asi mwoyo yamapenzi inotaura zvoupenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Maoko anoshingaira achatonga,","poem":1},{"text":"asi usimbe hunopedzisira mukushanda somuranda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Mwoyo unopunyaira unoremedza munhu,","poem":1},{"text":"asi shoko nyoro rinomufadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Munhu akarurama anochenjerera ushamwari,","poem":1},{"text":"asi nzira yavakaipa inovatungamirira mukurasika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Munhu ane usimbe haagochi mhuka yaabata,","poem":1},{"text":"asi munhu anoshingaira anokoshesa pfuma yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Munzira yokururama mune upenyu;","poem":1},{"text":"kwainoenda hakuna rufu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}