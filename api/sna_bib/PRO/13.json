{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Mwanakomana akachenjera anoteerera kurayira kwababa vake,","poem":1},{"text":"asi mudadi haateereri kana achitsiurwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubva pazvibereko zvomuromo wake munhu achadya zvinhu zvakanaka,","poem":1},{"text":"asi vasina kutendeka vanofarira kumanikidza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Uyo anobata muromo wake anochengeta upenyu hwake,","poem":1},{"text":"asi uyo anokurumidzira kutaura achaparadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Simbe inopanga asi igoshayiwa chinhu,","poem":1},{"text":"asi zvishuvo zvavanoshingaira zvichazadziswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vakarurama vanovenga nhema,","poem":1},{"text":"asi vakaipa vanouyisa kunyadziswa nokunyangadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kururama kunorinda munhu ane unhu hwakanaka,","poem":1},{"text":"asi kuipa kunowisira mutadzi pasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mumwe munhu anozviti mupfumi, asi asina chinhu;","poem":1},{"text":"mumwewo anozviti murombo, asi aine upfumi huzhinji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Upfumi hwomunhu hunogona kudzikinura upenyu hwake,","poem":1},{"text":"asi murombo haana chinomutyisidzira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Chiedza cheakarurama chinopenya kwazvo;","poem":1},{"text":"asi mwenje woakaipa uchadzimwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kuzvikudza kunongouyisa kukakavara chete,","poem":1},{"text":"asi uchenjeri hunowanikwa mune avo vanogamuchira kurayirwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mari yakawanikwa zvisakarurama ichakurumidza kupera,","poem":1},{"text":"asi uyo anounganidza mari zvishoma nezvishoma achaita kuti iwande.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tariro kana ichinonoka inoodza mwoyo,","poem":1},{"text":"asi chishuvo chazadziswa muti woupenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Uyo anozvidza kurayirwa achazozviripira izvozvo,","poem":1},{"text":"asi uyo anokudza murayiro achawana mubayiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kudzidzisa kwowakachenjera itsime roupenyu,","poem":1},{"text":"rinobvisa munhu pamusungo worufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kunzwisisa kwakanaka kunowanisa nyasha,","poem":1},{"text":"asi nzira yavasina kutendeka ihukutu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Munhu wose akachenjera anoita zvinhu noruzivo,","poem":1},{"text":"asi benzi rinoratidza upenzi hwaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nhume yakaipa inowira munjodzi,","poem":1},{"text":"asi munyai akatendeka anouya nokuporesa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Uyo anozvidza kurayirwa achava murombo uye achanyadziswa,","poem":1},{"text":"asi ani naani anoteerera kurayirwa achakudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Chishuvo chazadziswa chinozipa pamweya,","poem":1},{"text":"asi mapenzi anovenga kusiya zvakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Uyo anofamba navakachenjera achachenjerawo,","poem":1},{"text":"asi shamwari yamapenzi ichakuvadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Zvakaipa zvinotevera mutadzi,","poem":1},{"text":"asi kubudirira ndiwo mugove wavakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Munhu akanaka anosiyira vana vevana vake nhaka,","poem":1},{"text":"asi upfumi hwomutadzi hunounganidzirwa vakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Munda womurombo ungabereka zvokudya zvakawanda,","poem":1},{"text":"asi kusaruramisira kunozvitsvairira kure.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Anorega kushandisa shamhu anovenga mwanakomana wake,","poem":1},{"text":"asi uyo anomuda anochenjerera kumuranga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Vakarurama vanodya zvinogutsa mwoyo yavo,","poem":1},{"text":"asi dumbu reakaipa richanzwa nzara.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}