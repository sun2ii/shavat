{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Mukadzi akachenjera anovaka imba yake,","poem":1},{"text":"asi benzi rinoputsa imba yaro namaoko aro.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Uyo ano mufambiro wakarurama anotya Jehovha,","poem":1},{"text":"asi uyo ano mufambiro wakatsauka anomuzvidza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kutaura kwebenzi kunouyisa shamhu kumusana kwaro,","poem":1},{"text":"asi miromo yavakachenjera inovadzivirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kana pasina nzombe, chidyiro hachina chinhu,","poem":1},{"text":"asi pasimba renzombe ndipo panobva kukohwa kukuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Chapupu chechokwadi hachinyengeri,","poem":1},{"text":"asi chapupu chenhema chinodurura nhema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mudadi anotsvaka uchenjeri asi anohushaya,","poem":1},{"text":"asi ruzivo runouya zviri nyore kune anonzvera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gara kure nomunhu benzi,","poem":1},{"text":"nokuti haungawani ruzivo kubva pamiromo yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uchenjeri hwomunhu akangwara ndiko kunzwisisa nzira dzake,","poem":1},{"text":"asi upenzi hwamapenzi ndihwo unyengeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mapenzi anoseka kutendeuka pazvivi,","poem":1},{"text":"asi kuita zvakanaka kunowanikwa pakati pavakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mwoyo mumwe nomumwe unoziva kutambudzika kwawo,","poem":1},{"text":"uye hapana munhu angagoverana nawo mufaro wawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Imba yeakaipa ichaparadzwa,","poem":1},{"text":"asi tende rowakarurama richabudirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kune nzira inoita seyakanaka kumunhu,","poem":1},{"text":"asi kumagumo inotungamirira kurufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kunyange mukuseka mwoyo unogona kurwadziwa,","poem":1},{"text":"uye mufaro ungangoperera mukusuwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Vasingatendi vachapiwa mubayiro wakazara wenzira dzavo,","poem":1},{"text":"uye munhu akanaka achapiwa mubayiro wenzira dzakewo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Munhu asina mano anongotenda zvose zvose,","poem":1},{"text":"asi munhu akangwara anongwarira mafambiro ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Munhu akachenjera anotya Jehovha uye anovenga zvakaipa,","poem":1},{"text":"asi benzi rina manyawi uye harina hanya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Munhu anokurumidza kutsamwa anoita zvinhu zvoupenzi,","poem":1},{"text":"uye munhu anoita zvounyengeri achavengwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Vasina mano vachagara nhaka youpenzi,","poem":1},{"text":"asi vakangwara vachapfekedzwa korona yezivo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Vanhu vakaipa vachagwadama pamberi pavakanaka,","poem":1},{"text":"uye vakaipa pamasuo avakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Varombo vanoraswa kunyange navavakidzani vavo,","poem":1},{"text":"asi vapfumi vane shamwari zhinji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Uyo anozvidza muvakidzani wake anotadza,","poem":1},{"text":"asi akaropafadzwa ane tsitsi kune vanoshayiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ko, vanoronga zvakaipa havarasiki here?","poem":1},{"text":"Asi avo vanoronga zvakanaka vanowana rudo nokutendeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kushanda nesimba kwose kunopa mubayiro,","poem":1},{"text":"asi kungotaura kunotungamirira kuurombo bedzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Upfumi hwavakachenjera ikorona yavo,","poem":1},{"text":"asi upenzi hwamapenzi hunobereka upenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Chapupu chechokwadi chinoponesa upenyu,","poem":1},{"text":"asi chapupu chenhema chinonyengera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Uyo anotya Jehovha ane nhare yakasimba,","poem":1},{"text":"uye ichava utiziro kuvana vake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kutya Jehovha ndicho chitubu choupenyu,","poem":1},{"text":"kunodzora munhu kubva pamisungo yorufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Mukuwanda kwavanhu ndimo mune ukuru hwamambo,","poem":1},{"text":"asi pasina vanhu muchinda anoparadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Munhu ane mwoyo murefu anonzwisisa,","poem":1},{"text":"asi munhu anokurumidza kutsamwa anoratidza upenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Mwoyo wakagadzikana unopa upenyu kumuviri,","poem":1},{"text":"asi ruchiva runoodza mapfupa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Uyo anomanikidza varombo anoratidza kuti anozvidza Musiki wavo,","poem":1},{"text":"asi ani naani ane hanya nevanoshayiwa anokudza Mwari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Kana njodzi yauya, akaipa anowisirwa pasi,","poem":1},{"text":"asi kunyange murufu akarurama ane utiziro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Uchenjeri hunogara mumwoyo yavanohunzvera","poem":1},{"text":"uye kunyange pakati pamapenzi hunozvizivisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Kururama kunosimudzira rudzi,","poem":1},{"text":"asi chivi chinonyadzisa vanhu vapi zvavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Mambo anofarira muranda akachenjera,","poem":1},{"text":"asi muranda anonyadzisa achatsamwirwa naye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}