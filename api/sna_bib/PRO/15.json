{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Mhinduro nyoro inodzora kutsamwa,","poem":1},{"text":"asi shoko rinorwadza rinomutsa hasha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rurimi rwowakachenjera runobudisa zivo,","poem":1},{"text":"asi muromo webenzi unodurura upenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Meso aJehovha ari pose pose,","poem":1},{"text":"achicherechedza vakaipa navakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rurimi runouyisa kuporesa ndirwo muti woupenyu,","poem":1},{"text":"asi rurimi runonyengera runopwanya mweya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Benzi rinoramba kurayira kwababa varo,","poem":1},{"text":"asi ani naani anogamuchira kurayirwa anoratidza kungwara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Imba yowakarurama ine pfuma zhinji,","poem":1},{"text":"asi zvinowanikwa nowakaipa zvinomuunzira kutambudzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Miromo yavakachenjera inokusha zivo;","poem":1},{"text":"asi mwoyo yamapenzi haidaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehovha anovenga chibayiro chowakaipa,","poem":1},{"text":"asi munyengetero womunhu akarurama unomufadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Jehovha anovenga nzira yeakaipa,","poem":1},{"text":"asi anoda vaya vanotevera kururama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kurangwa kwakaomarara kwakamirira uyo anotsauka kubva panzira;","poem":1},{"text":"uyo anovenga kudzorwa achafa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rufu nokuparadzwa zviri pachena pamberi paJehovha,","poem":1},{"text":"ko, kuzoti mwoyo yavanhu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mudadi anovenga kudzorwa;","poem":1},{"text":"haangabvunzi vakachenjera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mwoyo wakafara, unofadza chiso,","poem":1},{"text":"asi mwoyo une shungu unopwanya mweya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mwoyo unonzvera unotsvaka ruzivo,","poem":1},{"text":"asi muromo webenzi unodya upenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mazuva ose omunhu anotambudzika akaipa,","poem":1},{"text":"asi mwoyo unofara une mutambo nguva dzose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Zviri nani kuva nezvishoma uchitya Jehovha,","poem":1},{"text":"pane kuva nepfuma zhinji namatambudziko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zviri nani kuva nezvokudya zvomuriwo pane rudo,","poem":1},{"text":"pane kuva nemhuru yakakodzwa pane ruvengo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Munhu ane hasha anomutsa bopoto,","poem":1},{"text":"asi munhu ane mwoyo murefu anonyaradza kukakavara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nzira yesimbe yakasoswa neminzwa,","poem":1},{"text":"asi nzira yavakarurama mugwagwa mukuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mwanakomana akachenjera anounzira baba vake mufaro,","poem":1},{"text":"asi munhu benzi anozvidza mai vake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Upenzi hunofadza munhu anoshayiwa njere,","poem":1},{"text":"asi munhu anonzwisisa anochengetedza nzira yakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Urongwa hunoparara kana pasina vanopa mazano,","poem":1},{"text":"asi vanopa mazano vakawanda hunobudirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Munhu anowana mufaro mukupa mhinduro yakanaka,","poem":1},{"text":"uye rakanaka seiko shoko rinouya nenguva!","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Nzira youpenyu kumunhu akachenjera inokwidza kumusoro,","poem":1},{"text":"ichimuchengetedza kuti asaenda muguva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Jehovha anoparadza imba yomunhu anozvikudza,","poem":1},{"text":"asi agochengeta miganhu yechirikadzi yakasimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Jehovha anovenga pfungwa dzowakaipa,","poem":1},{"text":"asi dzavakachena dzinomufadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Munhu anokara pfuma anouyisa kutambudzika kumhuri yake,","poem":1},{"text":"asi anovenga fufuro achararama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Mwoyo wokururama unoyera mhinduro dzawo,","poem":1},{"text":"asi muromo woakaipa unodurura zvakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Jehovha ari kure neakaipa,","poem":1},{"text":"asi anonzwa munyengetero weakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Chiso chinobwinya chinofadza mwoyo,","poem":1},{"text":"uye mashoko akanaka anopa utano kumapfupa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Uyo anoteerera kutsiura","poem":1},{"text":"kunopa upenyu achagara pakati pavakachenjera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Uyo asina hanya nokurangwa anozvizvidza iye pachake,","poem":1},{"text":"asi ani naani anogamuchira kurayira achawana kunzwisisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Kutya Jehovha kunodzidzisa munhu uchenjeri,","poem":1},{"text":"uye kuzvininipisa kunotanga, kukudzwa kwozotevera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}