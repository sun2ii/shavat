{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Kuronga kwomwoyo ndekwomunhu,","poem":1},{"text":"asi mhinduro yorurimi inobva kuna Jehovha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nzira dzose dzomunhu dzinoita sedzakanaka pakuona kwake,","poem":1},{"text":"asi Jehovha anoyera zvinangwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kumikidza kuna Jehovha chose chaunoita,","poem":1},{"text":"ipapo urongwa hwako huchabudirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jehovha anoitira zvinhu zvose magumo azvo;","poem":1},{"text":"kunyange akaipa anomuitira zuva renjodzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jehovha anovenga vose vane mwoyo inozvikudza.","poem":1},{"text":"Zvirokwazvo, havangaregi kurangwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kubudikidza norudo nokutendeka, chivi chinoyananisirwa,","poem":1},{"text":"kubudikidza nokutya Jehovha munhu anorega kuita zvakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kana nzira dzomunhu dzichifadza Jehovha,","poem":1},{"text":"anoita kuti kunyange vavengi vake vagarisane naye murugare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Zviri nani kuva nezvishoma mukururama,","poem":1},{"text":"pane kuva nezvakawanda kwazvo mukusaruramisira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mumwoyo make munhu anoronga gwara rake,","poem":1},{"text":"asi Jehovha ndiye anotonga kufamba kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Miromo yamambo inotaura seinotaura chirevo chaMwari,","poem":1},{"text":"uye muromo wake haufaniri kurega kururamisira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Zviyero nezvienzaniso zvechokwadi zvinobva kuna Jehovha;","poem":1},{"text":"zviyero zvose zviri muhomwe ndiye akazviita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Madzimambo anovenga kuita zvakaipa,","poem":1},{"text":"nokuti chigaro choushe chinosimbiswa nokururama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Madzimambo anofarira miromo inotaura chokwadi;","poem":1},{"text":"anoremekedza munhu anotaura chokwadi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kutsamwa kwamambo inhume yorufu,","poem":1},{"text":"asi munhu akachenjera anonyaradza kutsamwa uku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kana chiso chamambo chichibwinya, zvinoreva upenyu,","poem":1},{"text":"nyasha dzake dzakaita segore remvura panguva yomunakamwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Zviri nani sei kuwana uchenjeri pane goridhe,","poem":1},{"text":"kusarudza njere pane sirivha!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mugwagwa mukuru wavakarurama unonzvenga zvakaipa;","poem":1},{"text":"uye anochengeta nzira yake anochengeta upenyu hwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kuzvikudza kunotangira kuparadzwa,","poem":1},{"text":"mweya wamanyawi unotangira kuwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Zviri nani kuva nomweya unozvininipisa pakati pavakadzvinyirirwa","poem":1},{"text":"pane kugoverana zvakapambwa navanozvikudza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ani naani anoteerera kurayirwa achabudirira,","poem":1},{"text":"uye akaropafadzwa uyo anovimba naJehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Vakachenjera pamwoyo vanonzi ndivo vanonzvera,","poem":1},{"text":"uye mashoko akanaka anokurudzira kurayirwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Njere itsime roupenyu kuna avo vanadzo,","poem":1},{"text":"asi upenzi hunouyisa kurangwa kumapenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mwoyo womunhu akachenjera unotungamirira muromo wake,","poem":1},{"text":"uye miromo yake inokurudzira kurayirwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Mashoko anofadza akafanana nezinga rouchi,","poem":1},{"text":"anozipa kumweya, anoporesa mapfupa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kune nzira inoita seyakanaka kumunhu,","poem":1},{"text":"asi magumo ayo inoenda kurufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Nzara yomushandi inomushandira;","poem":1},{"text":"nzara yake inoita kuti arambe achishanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Munhu asina maturo anoronga zvakaipa,","poem":1},{"text":"uye matauriro ake akaita somoto unopisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Munhu akatsauka anomutsa kupesana,","poem":1},{"text":"uye guhwa rinoparadzanisa shamwari dzepedyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Munhu anoita nechisimba anonyengera muvakidzani wake,","poem":1},{"text":"uye anomufambisa napanzira isina kunaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Uyo anochonya nameso ake ari kuronga zvakaipa;","poem":1},{"text":"uyo anoruma miromo yake ari kuda kuita zvakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Bvudzi rakachena ikorona yakaisvonaka;","poem":1},{"text":"inowanikwa noupenyu hwakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Zviri nani kuva munhu ane mwoyo murefu pane kuva murwi,","poem":1},{"text":"munhu anozvibata pakutsamwa kwake ari nani pane uyo anotapa guta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Mujenya unokandirwa pamakumbo,","poem":1},{"text":"asi zvirevo zvose zvinobva kuna Jehovha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}