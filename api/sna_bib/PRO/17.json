{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Zviri nani kuva nechimedu chakaoma chechingwa uine rugare norunyararo","poem":1},{"text":"pane imba izere namabiko, ine kupesana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muranda akachenjera achatonga mwanakomana anonyadzisa,","poem":1},{"text":"uye achagoverwa nhaka somumwe wehama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hari ndeyokunyautsira sirivha uye choto ndechokunatsa goridhe,","poem":1},{"text":"asi Jehovha ndiye anoedza mwoyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Munhu akaipa anoteerera miromo yakaipa;","poem":1},{"text":"murevi wenhema anorerekera nzeve yake kururimi runoparadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Uyo anoseka varombo anozvidza Musiki wavo,","poem":1},{"text":"ani naani anofarira njodzi dzavamwe haangaregi kurangwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vana vevana ikorona kune vakwegura,","poem":1},{"text":"uye vabereki ndivo kukudzwa kwavana vavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kutaura kuna manyawi hakuna kufanira benzi,","poem":1},{"text":"zvikuru sei kutaura nhema kwomubati!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fufuro inofadza uyo anoipa;","poem":1},{"text":"kwose kwose kwaanoenda, anobudirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uyo anofukidzira kudarika kwomumwe anotsvaka rudo,","poem":1},{"text":"asi ani naani anomutsazve mhaka anoparadzanisa shamwari dzepedyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kutsiurwa kunofadza munhu ane njere","poem":1},{"text":"kupfuura kurohwa kwebenzi kazana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Munhu akaipa anongotsvaka kumukira chete;","poem":1},{"text":"nhume isina tsitsi ichatumirwa kundomurwisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Zviri nani kusangana nechikara chatorerwa vana vacho","poem":1},{"text":"pane benzi muupenzi hwaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kana munhu akaripira zvakanaka nezvakaipa","poem":1},{"text":"zvakaipa hazvizombobvi paimba yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kuvamba kwokukakavara kwakafanana nokudziurira mvura yedhamu;","poem":1},{"text":"saka rega nharo kurwa kusati kwatanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kupembedza ane mhosva nokupomera asina mhaka,","poem":1},{"text":"Jehovha anozvivenga zvose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ine basa reiko mari kana iri muruoko rwebenzi,","poem":1},{"text":"sezvo risina chishuvo chokuwana uchenjeri?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Shamwari inoda panguva dzose,","poem":1},{"text":"uye hama yakaberekerwa kupikisana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Munhu anoshayiwa njere ndiye anombunda noruoko rwake pamhiko,","poem":1},{"text":"uye anoitira muvakidzani wake rubatso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Uyo anoda zvokukakavara anoda chivi;","poem":1},{"text":"uyo anovaka suo refu anotsvaka kuparadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Munhu ane mwoyo wakaipa haabudiriri;","poem":1},{"text":"uyo ane rurimi runonyengera achawira mudambudziko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kuva nomwanakomana benzi kunouyisa kurwadziwa;","poem":1},{"text":"baba vebenzi havana mufaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mwoyo wakafara mushonga wakanaka,","poem":1},{"text":"asi mweya wakaputsika unoomesa mapfupa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Munhu akaipa anogamuchira fufuro muchivande,","poem":1},{"text":"kuti aminamise nzira dzokururamisira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Munhu ane njere anoisa uchenjeri pamberi,","poem":1},{"text":"asi meso ebenzi anosvika kumagumo enyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Mwanakomana benzi anorwadzisa baba vake,","poem":1},{"text":"uye anoitisa shungu uyo akamubereka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Hazvina kunaka kuranga munhu asina mhosva,","poem":1},{"text":"kana kurova machinda nokuda kwokururama kwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Munhu ano ruzivo anoshandisa mashoko achizvidzora,","poem":1},{"text":"uye munhu anonzwisisa akadzikama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kunyange benzi, kana rakanyarara, rinonzi rakachenjera,","poem":1},{"text":"uye rikabata muromo waro rinonzi rakangwara.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}