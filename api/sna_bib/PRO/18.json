{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Munhu asina ukama navamwe anongozvitsvakira zvake;","poem":1},{"text":"anozvidza kutonga kwakanaka kwose.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Benzi harifariri kunzwisisa,","poem":1},{"text":"asi rinofarira kungotaura zvarinofunga chete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Panosvika chakaipa, kuzvidzwa kunouyawo,","poem":1},{"text":"uye kana nyadzi dzichisvika kusakudzwa kwasvikawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mashoko omuromo womunhu imvura yakadzika,","poem":1},{"text":"asi tsime rouchenjeri chitubu chinoyerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hazvina kunaka kutsaura akaipa","poem":1},{"text":"kana kusaruramisira asina mhosva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Miromo yebenzi inoriunzira kukakavara,","poem":1},{"text":"uye muromo wake unomukokera kurohwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Muromo webenzi ndiwo kuparadzwa kwaro,","poem":1},{"text":"uye miromo yaro ndiwo musungo kumweya waro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mashoko amakuhwa akaita semisuva yakanakisisa;","poem":1},{"text":"anoenda pakadzikadzika mukati momunhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uyo ano usimbe pakubata kwake","poem":1},{"text":"ihama youyo anoparadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Zita raJehovha inhare yakasimba;","poem":1},{"text":"vakarurama vanomhanyira kwariri vagochengetedzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Pfuma yavapfumi ndiro guta ravo rina masvingo;","poem":1},{"text":"vanoriona sorusvingo rurefu pakufunga kwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kuparadzwa kusati kwasvika, mwoyo womunhu unozvikudza,","poem":1},{"text":"asi kuzvininipisa kunotangira kukudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Uyo anopindura asati anzwa,","poem":1},{"text":"ndihwo upenzi hwake nokunyadziswa kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mweya womunhu unomusimbisa panguva yokurwara,","poem":1},{"text":"asi mweya wakapwanyika ndiani angautakura?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mwoyo woune njere unowana ruzivo,","poem":1},{"text":"nzeve dzowakachenjera dzinorutsvaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Chipo chinozarurira nzira kune achipa,","poem":1},{"text":"uye chinomusvitsa pamberi pavakuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Anotanga kusvitsa nyaya yake anoita seakanaka,","poem":1},{"text":"kusvikira mumwe auya mberi kuzomubvunza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kukanda mijenya kunopedza gakava,","poem":1},{"text":"uye kunotonga pakati pavaviri vanopikisana zvikuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Hama yatadzirwa yakavangarara kupfuura guta rakakomberedzwa namasvingo,","poem":1},{"text":"uye kukakavara kwakafanana namazariro amasuo omuzinda wamambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kubva pazvibereko zvomuromo wake dumbu romunhu rinogutiswa;","poem":1},{"text":"nezvinobva pamiromo yake achagutiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Rurimi rune simba roupenyu norufu,","poem":1},{"text":"uye vaya vanoruda vachadya chibereko charwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Uyo anowana mudzimai anowana chinhu chakanaka,","poem":1},{"text":"uye anogamuchira nyasha kubva kuna Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Murombo anokumbira kuitirwa tsitsi,","poem":1},{"text":"asi mupfumi anopindura nehasha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Munhu ane shamwari dzakawanda angangoparadzwa,","poem":1},{"text":"asi kune shamwari inonamatira kupfuura hama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}