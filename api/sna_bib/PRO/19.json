{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Zviri nani kuva murombo ane mafambiro akarurama,","poem":1},{"text":"pane benzi rine muromo wakatsauka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hazvibatsiri kushingaira usina zivo,","poem":1},{"text":"kana kukurumidza uchizorasika nzira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Upenzi hwomunhu hunoparadza upenyu hwake,","poem":1},{"text":"asi mwoyo wake unotsamwira Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pfuma inouyisa shamwari zhinji,","poem":1},{"text":"asi murombo anosiyiwa neshamwari dzake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Chapupu chenhema hachingaregi kurangwa,","poem":1},{"text":"uye uyo anodurura manyepo haangaregedzwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vazhinji vanotsvaka nyasha kumutongi,","poem":1},{"text":"uye mumwe nomumwe ishamwari yomunhu anopa zvipo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Murombo anoraswa nehama dzake dzose,","poem":1},{"text":"kuzoti shamwari dzake, dzinomunzvenga zvakadii!","poem":2},{"text":"Kunyange akavatevera achidemba kwazvo","poem":1},{"text":"havangawanikwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uyo anowana uchenjeri anoda upenyu hwake;","poem":1},{"text":"uye anochengeta kunzwisisa anobudirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Chapupu chenhema hachingaregi kurangwa,","poem":1},{"text":"uye uyo anodurura manyepo achaparara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hazvina kufanira kuti benzi rigarike,","poem":1},{"text":"ko, zvakanyanya kuipa sei kuti muranda atonge machinda!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Uchenjeri hwomunhu hunomupa mwoyo murefu;","poem":1},{"text":"kukudzwa kwake ndiko kukanganwira kudarika kwomumwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kutsamwa kwamambo kwakafanana nokuomba kweshumba,","poem":1},{"text":"asi nyasha dzake dzakaita sedova pauswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mwanakomana benzi ndiko kuparara kwababa vake,","poem":1},{"text":"uye mukadzi anokakavara akafanana nemvura inoramba ichingodonha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dzimba nepfuma inhaka inobva kuvabereki,","poem":1},{"text":"asi mukadzi akanaka anobva kuna Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Usimbe hunouyisa hope dzakadzama,","poem":1},{"text":"uye munhu asingashandi achafa nenzara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Uyo anoteerera kurayira anochengetedza upenyu hwake,","poem":1},{"text":"asi uyo asina hanya nenzira dzake achafa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Uyo anonzwira varombo tsitsi anopa kuna Jehovha,","poem":1},{"text":"uye achamupa mubayiro wezvaakaita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ranga mwanakomana wako, nokuti mukuranga ndimo mune tariro;","poem":1},{"text":"usava nechikamu pakuparadzwa kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Munhu ane hasha zvikuru anofanira kuripa mhosva yake;","poem":1},{"text":"kana ukamununura, unofanira kuzomununurazve.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Teerera zano ugamuchire kurayirwa,","poem":1},{"text":"uye pakupedzisira uchava wakachenjera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mune urongwa huzhinji mumwoyo momunhu,","poem":1},{"text":"asi kuda kwaJehovha ndiko kunobudirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Chinodiwa nomunhu rudo rusingagumi;","poem":1},{"text":"zviri nani kuva murombo pano kuva murevi wenhema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kutya Jehovha kunotungamirira kuupenyu:","poem":1},{"text":"Ipapo munhu achazorora zvakanaka, asingawirwi nedambudziko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Simbe inoisa ruoko rwayo mundiro;","poem":1},{"text":"igotadza kunyange kurwudzosa kumuromo wayo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Rova museki, ipapo vasina mano vachadzidzawo ungwaru;","poem":1},{"text":"tsiura munhu ane njere, ipapo achawana zivo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Uyo anobira baba vake uye achidzinga mai vake","poem":1},{"text":"mwanakomana anonyadzisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Mwanakomana wangu, ukasateerera kurayirwa,","poem":1},{"text":"uchatsauka kubva pamashoko oruzivo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Chapupu chakaipa chinoseka kururamisira,","poem":1},{"text":"uye muromo womunhu akaipa unomedza zvakaipa.","poem":2}]},{"type":"verse","number":29,"content":["Kurangwa kwakagadzirirwa vaseki, uye kurohwa misana yamapenzi."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}