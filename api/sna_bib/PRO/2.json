nobuda zivo nokunzwisisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anochengetera vakarurama kukunda,","poem":1},{"text":"iye ndiye nhoo kuna avo vane mufambiro usina chaunopomerwa,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"nokuti anochengetedza nzira yavakarurama,","poem":1},{"text":"uye anodzivirira nzira yavakatendeka vake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ipapo uchanzwisisa zvakarurama,","poem":1},{"text":"kururamisira nokuenzanisira nzira dzose dzakanaka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nokuti uchenjeri huchapinda mumwoyo mako,","poem":1},{"text":"uye ruzivo ruchafadza mweya wako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kungwara kuchakuchengetedza,","poem":1},{"text":"uye kunzwisisa kuchakurinda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uchenjeri huchakuponesa panzira dzavanhu vakaipa,","poem":1},{"text":"vanhu vane mashoko asakarurama,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"vanosiya nzira yakarurama","poem":1},{"text":"kuti vafambe munzira dzerima,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"vanofarira kuita zvakaipa","poem":1},{"text":"uye vanofarira kusarurama kwezvakaipa,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"vane nzira dzakaminama","poem":1},{"text":"uye vanonyengera pamaitiro avo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Zvichakuponesazve pamukadzi chifeve,","poem":1},{"text":"kubva pamudzimai asingazvibati, anokwezva namashoko ake,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"uyo akasiya murume woumhandara hwake","poem":1},{"text":"uye akashaya hanya nesungano yaakaita pamberi paMwari.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nokuti imba yake inoenda kurufu,","poem":1},{"text":"uye nzira dzake kumweya yavakafa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hakuna anoenda kwaari achidzoka","poem":1},{"text":"kana kuzowana nzira dzoupenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Naizvozvo iwe uchafamba munzira dzavanhu vakanaka","poem":1},{"text":"uye ucharamba uri munzira dzavakarurama.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nokuti vakarurama vachagara munyika,","poem":1},{"text":"uye vasina chavanopomerwa vacharamba vari mairi;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"asi vakaipa vachaparadzwa panyika,","poem":1},{"text":"uye vasina kutendeka vachabviswa pairi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}