{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Waini museki uye doro mupopoti;","poem":1},{"text":"ani naani anotsauswa nazvo haana kuchenjera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kutsamwa kwamambo kwakafanana nokuomba kweshumba;","poem":1},{"text":"uyo anomutsamwisa anotadzira upenyu hwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Munhu achakudzwa kana akagara kure nokukakavara,","poem":1},{"text":"asi benzi rimwe nerimwe rinokurumidza kupopota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Simbe hairimi mumwaka wokurima;","poem":1},{"text":"saka panguva yokukohwa anotsvaka asi hapana chaanowana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zvinangwa zvomwoyo womunhu imvura yakadzika,","poem":1},{"text":"asi munhu akachenjera achaichera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vanhu vazhinji vanoti vane rudo rusingagumi,","poem":1},{"text":"asi munhu akatendeka angawanikwa kupiko?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Munhu akarurama anorarama upenyu hwakanaka;","poem":1},{"text":"vana vake vanomutevera vakaropafadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kana mambo achinge agara pachigaro chake kuti atonge,","poem":1},{"text":"anopepeta zvakaipa zvose nameso ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndiani angati, “Ndakachengeta mwoyo wangu wakachena;","poem":1},{"text":"ndakachena uye handina zvivi”?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Zviereso zvakasiyana nezvipimo zvakasiyana","poem":1},{"text":"Jehovha anozvivenga zvose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kunyange mwana anozivikanwa nezvaanoita,","poem":1},{"text":"kuti tsika dzake dzakanaka uye kuti dzakarurama here.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nzeve dzinonzwa nameso anoona,","poem":1},{"text":"Jehovha ndiye akazviita zvose zviri zviviri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Usafarira kurara kana kuti uchava murombo;","poem":1},{"text":"svinudza meso ako ipapo uchava nezvokudya zvakawanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Hazvina kunaka, hazvina kunaka!” ndizvo zvinotaura mutengi;","poem":1},{"text":"ipapo hoyo oenda achizvirumbidza pamusoro pezvaatenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Goridhe riripo, uye matombo anokosha amarubhi azere,","poem":1},{"text":"asi miromo inotaura zivo ndicho chinhu chinokosha chisipo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mutorerei nguo yake, uyo anoitira mutorwa rubatso;","poem":1},{"text":"itorei sorubatso kana azviitira mukadzi asingazvibati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zvokudya zvakawanikwa nokunyengera zvinonaka kumunhu,","poem":1},{"text":"asi achapedzisira ava nomukanwa mazara jecha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ita urongwa nokutsvaga mazano;","poem":1},{"text":"kana uchironga hondo, tsvaka kutungamirirwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Guhwa rinoputsa chivimbo;","poem":1},{"text":"saka furatira munhu anotaurisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kana munhu akatuka baba vake kana mai vake,","poem":1},{"text":"mwenje wake uchadzimwa parima guru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Nhaka yakakurumidza kuwanikwa pakutanga","poem":1},{"text":"haingaropafadzwi pamagumo ayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Usati, “Ndichatsiva zvawanditadzira izvi!”","poem":1},{"text":"Mirira Jehovha, uye iye achakubatsira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Jehovha anovenga zviereso zvinosiyana,","poem":1},{"text":"uye zviero zvinonyengera hazvimufadzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kufamba kwomunhu kunotungamirirwa naJehovha.","poem":1},{"text":"Zvino munhu anganzwisisa sei nzira yake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Musungo kumunhu kuti akumikidze chimwe chinhu nokukurumidza","poem":1},{"text":"uye ozorangarira mhiko dzake pava paya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mambo akachenjera anopepeta zvakaipa;","poem":1},{"text":"anofambisa vhiri rokupura pamusoro pavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Mwenje waJehovha unonzvera mweya womunhu;","poem":1},{"text":"unonzvera zviri mukatikati make.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Rudo nokutendeka zvinochengetedza mambo;","poem":1},{"text":"kubudikidza norudo chigaro chake chinosimbiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Kukudzwa kwamajaya ndiro simba ravo,","poem":1},{"text":"bvudzi jena kubwinya kwavakwegura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kurohwa nokukuvadzwa zvinobvisa zvakaipa,","poem":1},{"text":"uye kurohwa neshamhu kunovaka munhu womukati.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}