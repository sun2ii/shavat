{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Mwoyo wamambo uri muruoko rwaJehovha;","poem":1},{"text":"anouendesa kwaanoda sehova dzemvura.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nzira dzose dzomunhu dzinoita sedzakarurama kwaari,","poem":1},{"text":"asi Jehovha anoyera mwoyo pachikero.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kuita zvakarurama nokururamisira","poem":1},{"text":"zvinonyanya kufadza Jehovha kupfuura chibayiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Meso ana manyawi nomwoyo unozvikudza,","poem":1},{"text":"mwenje woakaipa, ndizvo chivi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Urongwa hwavanoshingaira hunouyisa zvizhinji,","poem":1},{"text":"sezvo, zvirokwazvo, kukurumidzisa kuchiuyisa urombo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pfuma yakaunganidzwa norurimi","poem":1},{"text":"runoreva nhema imhute inopupurutswa uye muteyo wakaipisisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kumanikidza kwavakaipa kuchavazvuzvurudzira kure,","poem":1},{"text":"nokuti vanoramba kuita zvakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nzira yeane mhosva yakaminama,","poem":1},{"text":"asi kufamba kwaasina mhosva kwakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zviri nani kugara pakona yedenga remba,","poem":1},{"text":"pano kugara mumba nomudzimai anokakavara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Munhu akaipa anoshuvira zvakaipa;","poem":1},{"text":"muvakidzani wake haawani tsitsi kubva kwaari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kana museki akarangwa vasina mano vanowana uchenjeri;","poem":1},{"text":"kana munhu akachenjera akarayirwa anowana zivo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Iye Akarurama anocherechedza imba yeakaipa,","poem":1},{"text":"uye anoisa akaipa kukuparadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kana munhu akadzivira nzeve dzake kumurombo,","poem":1},{"text":"naiyewo achachema uye hapana achamunzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Chipo chinopiwa muchivande chinonyaradza hasha,","poem":1},{"text":"uye fufuro yakavigwa mujasi inonyaradza kutsamwa kukuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kana kururamisira kwaitwa, kunouyisa mufaro kuna vakarurama,","poem":1},{"text":"asi kunovhundutsa vaiti vezvakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Munhu anorasika panzira yokunzwisisa","poem":1},{"text":"achandozororera muungano yavakafa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Uyo anofarira mafaro achava murombo;","poem":1},{"text":"ani naani anofarira waini namafuta haazombopfumi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Akaipa achava dzikinuro yavakarurama,","poem":1},{"text":"uye vasina kutendeka vachava dzikinuro yaakatendeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Zviri nani kugara mugwenga,","poem":1},{"text":"pano kugara nomudzimai anokakavara uye ane hasha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mumba mowakachenjera mune zvokudya zvakaisvonaka zvakawanda namafuta,","poem":1},{"text":"asi benzi rinodya zvose zvarinazvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Uyo anotevera kururama norudo anowana upenyu,","poem":1},{"text":"nokubudirira norukudzo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Munhu akachenjera anorwisa guta ravane simba","poem":1},{"text":"agoputsa nhare dzaro dzavanovimba nadzo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Uyo anorinda muromo wake norurimi rwake","poem":1},{"text":"anozvidzivirira kubva panjodzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Munhu anozvikudza uye ana manyawi “Mudadi” ndiro zita rake;","poem":1},{"text":"anoita zvinhu namanyawi uye nokuzvikudza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kushuva kwesimbe kunova rufu rwake,","poem":1},{"text":"nokuti maoko ake anoramba kushanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Muswere wose wezuva anoramba achida zvimwe,","poem":1},{"text":"asi akarurama anopa asinganyimi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Chibayiro chowakaipa chinonyangadza,","poem":1},{"text":"zvikuru sei kana akauya nacho nomufungo wakaipa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Chapupu chenhema chichaparara,","poem":1},{"text":"uye ani naani anoteerera kwaari achaparadzwa nokusingaperi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Munhu akaipa ane chiso chisinganyari,","poem":1},{"text":"asi munhu akarurama anofunga pamusoro penzira dzake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Hapana uchenjeri kana njere kana urongwa","poem":1},{"text":"hungabudirira huchipikisana naJehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Bhiza rinogadzirirwa zuva rokurwa,","poem":1},{"text":"asi kukunda kunobva kuna Jehovha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}