{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Zita rakanaka rinodiwa kwazvo kupfuura pfuma zhinji;","poem":1},{"text":"kuremekedzwa kuri nani pane sirivha kana goridhe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vapfumi navarombo vakafanana pachinhu ichi:","poem":1},{"text":"Jehovha ndiye Musiki wavo vose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Munhu akangwara anoona njodzi agohwanda,","poem":1},{"text":"asi asina mano anoramba achienda uye agotambudzika nokuda kwaizvozvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kuzvininipisa nokutya Jehovha","poem":1},{"text":"kunouyisa pfuma nokukudzwa uye noupenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Munzira yeakaipa mune minzwa nemisungo,","poem":1},{"text":"asi uyo anochengeta mweya wake anogara kure nazvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Rovedza mwana munzira yaanofanira kufamba nayo,","poem":1},{"text":"uye kana achinge akura haazotsauki kubva pairi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mupfumi anobata ushe pamusoro pomurombo,","poem":1},{"text":"uye anokwereta anova muranda weanokweretesa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uyo anodyara kuipa anokohwa dambudziko,","poem":1},{"text":"uye tsvimbo yokutsamwa kwake ichaparadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Munhu anopa zvakawanda acharopafadzwa,","poem":1},{"text":"nokuti anopa varombo zvokudya zvake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dzinga museki, kukakavara kunobva kwaendawo;","poem":1},{"text":"kupopotedzana nokutukana kunoguma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Uyo anoda mwoyo wakachena uye anotaura zvakanaka,","poem":1},{"text":"achava shamwari yamambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Meso aJehovha anorinda zivo,","poem":1},{"text":"asi anokonesa mashoko omunhu asina kutendeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Simbe inoti, “Panze pane shumba,”","poem":1},{"text":"kana kuti, “Ndinourayiwa munzira!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Muromo womukadzi chifeve igomba rakadzika;","poem":1},{"text":"uyo ari pasi pokutsamwa kwaJehovha achawira mariri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Upenzi hwakasungirirwa mumwoyo momwana,","poem":1},{"text":"asi shamhu yokuranga ichahudzingira kure naye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Uyo anomanikidza varombo kuti awedzere pfuma yake","poem":1},{"text":"nouyo anopa zvipo kuvapfumi, vose vachava varombo.","poem":2}]},{"type":"heading","content":["Mashoko oMuchenjeri"]},{"type":"verse","number":17,"content":[{"text":"Nyatsoteerera unzwe mashoko omuchenjeri;","poem":1},{"text":"isa mwoyo wako kumashoko andinokudzidzisa,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"nokuti chinhu chinofadza kana ukaachengeta mumwoyo mako,","poem":1},{"text":"uye ugare wakagadzirira kuataura ose.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kuti uvimbe naJehovha,","poem":1},{"text":"ndinokudzidzisa nhasi, kunyange iyewe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Handina kukunyorera zvirevo makumi matatu here,","poem":1},{"text":"mashoko edzidziso noruzivo,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kukudzidzisa mashoko echokwadi anovimbika,","poem":1},{"text":"kuitira kuti ugopa mhinduro dzakafanira kuno","poem":2},{"lineBreak":true},{"text":"uyo akakutuma?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Usatorera varombo nokuti varombo,","poem":1},{"text":"uye usamanikidza vanoshayiwa mudare redzimhosva,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"nokuti Jehovha achavarwira pamhaka yavo,","poem":1},{"text":"uye achapamba vanovapamba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Usaita ushamwari nomunhu ane hasha,","poem":1},{"text":"uye usafambidzana nomunhu anokurumidza kutsamwa,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"kuti urege kudzidza tsika dzake,","poem":1},{"text":"uye urege kuzviteya nomusungo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Usava munhu anombunda ruoko pamhiko,","poem":1},{"text":"kana kuzviita rubatso pazvikwereti;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kana usina chaungaripa nacho,","poem":1},{"text":"uchatorerwa mubhedha wako chaiwo, paurere chaipo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Usabvisa dombo romuganhu wakare,","poem":1},{"text":"wakaiswapo namadzibaba ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Unoona munhu ane unyanzvi pabasa rake here?","poem":1},{"text":"Achashanda pamberi pamadzimambo;","poem":2},{"lineBreak":true},{"text":"haangashandiri vanhu vasina maturo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}