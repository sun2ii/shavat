{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Kana ukagara pakudya pamwe chete nomubati,","poem":1},{"text":"nyatsocherechedza zviri pamberi pako,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"uise banga pahuro","poem":1},{"text":"kana uri munhu wamadyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Usapanga zvokudya zvake zvinonaka","poem":1},{"text":"nokuti zvokudya izvozvo zvinonyengera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Usazvionza nokuda kuwana pfuma;","poem":1},{"text":"iva nouchenjeri hunoita kuti uzvibate.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kungoti tarisei papfuma, wanei yaenda,","poem":1},{"text":"nokuti zvirokwazvo inomera mapapiro","poem":2},{"lineBreak":true},{"text":"igobhururuka ichienda kudenga segondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Usadya zvokudya zvomunhu anonyima,","poem":1},{"text":"kana kupanga zvokudya zvake zvinonaka;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nokuti munhu uya anongofunga chete mutengo wazvo.","poem":1},{"text":"Anoti kwauri, “Idya ugonwa,” asi mumwoyo make asingadi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ucharutsa zvishoma izvozvo zvawadya,","poem":1},{"text":"uye unenge watambisa mashoko ako nokumutenda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Usataura nebenzi,","poem":1},{"text":"nokuti richashora uchenjeri hwamashoko ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Usabvisa dombo romuganhu wakare","poem":1},{"text":"kana kupinda paminda yenherera,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"nokuti Mudziviriri wavo ane simba;","poem":1},{"text":"iye achavarwira pamhaka yavo newe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Isa mwoyo wako kumurayiro","poem":1},{"text":"nenzeve dzako kumashoko ezivo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Usarega kuranga mwana;","poem":1},{"text":"ukamuranga neshamhu, haafi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Murange neshamhu","poem":1},{"text":"ugoponesa mweya wake kubva parufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mwanakomana wangu, kana mwoyo wako wakachenjera,","poem":1},{"text":"ipapo mwoyo wangu uchafara;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"mukatikati mangu muchapembera","poem":1},{"text":"kana miromo yako ichitaura zvakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Usarega mwoyo wako uchichiva vatadzi,","poem":1},{"text":"asi nguva dzose shingairira kutya Jehovha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zvirokwazvo ramangwana rako rine tariro,","poem":1},{"text":"uye tariro yako haingaparadzwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Teerera, mwanakomana wangu, ugova nouchenjeri,","poem":1},{"text":"uye uchengete mwoyo wako panzira yakarurama.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Usabatana navaya vanonwa waini zhinji,","poem":1},{"text":"kunyange vaya vanokara nyama,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"nokuti zvidhakwa nevane madyo vachava varombo,","poem":1},{"text":"uye hope dzichavapfekedza mamvemve.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Teerera kuna baba vako, ivo vakakubereka,","poem":1},{"text":"uye usazvidza mai vako kana vachinge vakwegura.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tenga zvokwadi urege kuzoitengesa;","poem":1},{"text":"uwane uchenjeri, kuzvibata nokunzwisisa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Baba vomunhu akarurama vane mufaro mukuru;","poem":1},{"text":"uyo ane mwanakomana akachenjera anofadzwa naye.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Baba vako namai vako ngavafare;","poem":1},{"text":"mai vakakubereka ngavafare kwazvo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mwanakomana wangu, ndipe mwoyo wako","poem":1},{"text":"uye meso ako ngaananʼanidze nzira dzangu,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"nokuti chifeve igomba rakadzika,","poem":1},{"text":"uye mukadzi asingazvibati itsime rakamanikana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Segororo anohwandira,","poem":1},{"text":"anowedzera vasina kutendeka pakati pavarume.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ndiani ane nhamo? Ndiani akasuwa?","poem":1},{"text":"Ndiani anokakavara? Ndiani anonyunyuta?","poem":2},{"text":"Ndiani ane mavanga pasina mhaka? Ndiani ane meso akatsvuka?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Vaya vanogara pawaini,","poem":1},{"text":"vanoenda kundoravira makate ewaini yakavhenganiswa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Usatarisa waini kana yatsvuka,","poem":1},{"text":"kana ichivaima iri mumukombe,","poem":2},{"lineBreak":true},{"text":"kana ichidzika zvakanaka pakunwa!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Pakupedzisira inoruma senyoka","poem":1},{"text":"uye ine uturu semvumbi.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Meso ako achaona zvisakamboonekwa","poem":1},{"text":"uye pfungwa dzako dzichafunga zvakapesana.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Uchava souya akarara pamusoro pamafungu amakungwa,","poem":1},{"text":"kana somunhu avete pamusoro pedanda rechikepe.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Uchati, “Vakandirova, asi handina kukuvara!","poem":1},{"text":"Vakandirova asi handina kuzvinzwa!","poem":2},{"text":"Ndichamuka rinhiko","poem":1},{"text":"kuti ndigotsvakazve waini?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}