{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Usachiva vanhu vakaipa,","poem":1},{"text":"usashuva kufamba navo;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"nokuti mwoyo yavo inoronga kuita nechisimba,","poem":1},{"text":"uye miromo yavo inotaura pamusoro pokuita mhirizhonga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nouchenjeri imba inovakwa,","poem":1},{"text":"uye kubudikidza nokunzwisisa inosimbiswa;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kubudikidza nezivo makamuri ayo anozadzwa nezvinhu","poem":1},{"text":"zvinoshamisa uye nepfuma yakaisvonaka inokosha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Munhu akachenjera ane simba guru,","poem":1},{"text":"uye munhu ane zivo anowedzera simba;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"nokuti kundorwa hondo kunoda kutungamirirwa,","poem":1},{"text":"uye kuti ukunde unoda vapi vamazano vazhinji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Uchenjeri hahusvikirwi nebenzi;","poem":1},{"text":"padare repasuo reguta harina chokutaura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uyo anoronga kuita zvakaipa","poem":1},{"text":"achazivikanwa senhubu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mufungo woupenzi chivi,","poem":1},{"text":"uye vanhu vanonyangadzwa nomuseki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kana ukapera simba panguva dzokutambudzika,","poem":1},{"text":"simba rako ishoma sei!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nunurai avo vari kuiswa kurufu;","poem":1},{"text":"dzosai avo vari kudzedzereka vachienda kundourayiwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi kana mukati, “Hapana zvataiziva pamusoro paizvozvi?”","poem":1},{"text":"Ko, iye anoyera mwoyo haangazvioni here?","poem":2},{"text":"Iye anorinda upenyu hwako haangazvizivi here?","poem":1},{"text":"Haangaripire munhu mumwe nomumwe maererano nezvaakaita here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Idya uchi, mwanakomana wangu, nokuti hwakanaka;","poem":1},{"text":"uchi hunobva pazinga hunozipa parurimi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uzivewo zvakare kuti uchenjeri hunozipa kumweya wako;","poem":1},{"text":"kana wahuwana, ramangwana rako rine tariro,","poem":2},{"lineBreak":true},{"text":"uye tariro yako haingaparari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Usavandira sezvinoita akaipa paimba yomunhu akarurama,","poem":1},{"text":"usaparadza paanogara;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"nokuti kunyange munhu akarurama achiwa runomwe, anosimukazve,","poem":1},{"text":"asi akaipa anowisirwa pasi nenjodzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Usafara kana muvengi wako achiwa;","poem":1},{"text":"paanogumburwa, mwoyo wako ngaurege kufara,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kana kuti Jehovha achazviona akasafara nazvo","poem":1},{"text":"uye agobvisa kutsamwa kwake kwaari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Usashungurudzika nokuda kwavanhu vakaipa,","poem":1},{"text":"kana kuchiva vakaipa,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"nokuti vanhu vakaipa havana tariro yeramagwana,","poem":1},{"text":"uye mwenje wavakaipa uchadzimwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Itya Jehovha namambo, mwanakomana wangu,","poem":1},{"text":"usabatana navanopanduka,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"nokuti vaviri ivavo vanouyisa kuparadzwa kwavari nokukurumidza,","poem":1},{"text":"uye ndiani anoziva njodzi dzavangauyisa?","poem":2}]},{"type":"heading","content":["Zvimwe Zvirevo zvoMuchenjeri"]},{"type":"verse","number":23,"content":["Izviwo zvirevo zvomuchenjeri:",{"text":"Kuita rusaruro mukutonga hakuna kunaka:","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ani naani anoti kune ane mhosva, “Hauna mhosva,”","poem":1},{"text":"marudzi achamutuka uye ndudzi dzichamushora.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Asi zvichanakira vaya vanopa mhosva kune vane mhosva,","poem":1},{"text":"uye kuropafadzwa kukuru kuchauya pamusoro pavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mhinduro yechokwadi","poem":1},{"text":"yakafanana nokutsvoda pamiromo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Pedza basa rako rapanze","poem":1},{"text":"ugadzirire minda yako;","poem":2},{"lineBreak":true},{"text":"shure kwaizvozvo, uvake imba yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Usava chapupu chinopomera muvakidzani wako pasina mhaka,","poem":1},{"text":"kana kushandisa miromo yako kuti unyengere.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Usati, “Ndichamuitirawo zvaakandiitira;","poem":1},{"text":"ndicharipira munhu uya zvaakaita.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ndakapfuura napamunda wesimbe,","poem":1},{"text":"ndikapfuura napamunda womuzambiringa womunhu asina njere;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"minzwa yakanga yamera pose pose,","poem":1},{"text":"munda wakanga wafukidzwa nesora,","poem":2},{"lineBreak":true},{"text":"uye rusvingo rwamabwe rwakanga rwakoromoka.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ndakafungisisa zvandakanga ndacherechedza","poem":1},{"text":"ndikadzidza chidzidzo pane zvandakanga ndaona.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kumbovata zvishomanana, kumbotsumwaira,","poem":1},{"text":"kumbofungatira maoko kuti ndizorore,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ipapo urombo huchauya pauri segororo","poem":1},{"text":"uye kushayiwa kuchauya somunhu akashonga nhumbi dzokurwa nadzo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}