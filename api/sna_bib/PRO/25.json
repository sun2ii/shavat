{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"heading","content":["Zvimwe Zvirevo zvaSoromoni"]},{"type":"verse","number":1,"content":["Izvi ndizvo zvimwe zvirevo zvaSoromoni, zvakanyorwa namachinda aHezekia mambo weJudha:"]},{"type":"verse","number":2,"content":[{"text":"Kukudzwa kwaMwari kuviga chinhu;","poem":1},{"text":"kunzvera nyaya ndiko kukudzwa kwamadzimambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sokukwirira kwakaita denga nokudzika kwakaita nyika,","poem":1},{"text":"saizvozvowo mwoyo yamadzimambo haigoni kunzverwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bvisa marara pasirivha,","poem":1},{"text":"panobva pabuda zvinoshandiswa nomuumbi wemidziyo yesirivha;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"bvisa akaipa pamberi pamambo,","poem":1},{"text":"ipapo chigaro chake choushe chichasimbiswa kubudikidza nokururama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Usazvikudza pamberi pamambo,","poem":1},{"text":"uye usazvipa chigaro pakati pavanhu vakuru;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zviri nani kuti ati kwauri, “Kwira pano,” pano kuti akunyadzise pamberi pavanhu vanoremekedzwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Zvawakaona nameso ako","poem":1},{"text":"usakurumidze kuzvikwidza kumatare edzimhosva,","poem":2},{"text":"nokuti uchazoiteiko pamagumo,","poem":1},{"text":"kana muvakidzani wako akakunyadzisa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kana uchipikisana nomuvakidzani wako,","poem":1},{"text":"usarase chivimbo chomumwe munhu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kana kuti uyo achazvinzwa angangokunyadzisa, uye uchazoramba uine chimiro chakaipa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Shoko rataurwa nenguva yakafanira","poem":1},{"text":"rakafanana namaapuro egoridhe mumidziyo yesirivha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Semhete yomunzeve yegoridhe kana chishongo chegoridhe rakaisvonaka,","poem":1},{"text":"ndizvo zvakaita kutsiura kwomunhu akachenjera, kunzeve inoteerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nhume yakatendeka kune anoituma","poem":1},{"text":"yakafanana nokutonhorera kwechando panguva yokukohwa;","poem":2},{"lineBreak":true},{"text":"inonyevenutsa mweya yavanatenzi vake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Samakore nemhepo zvisina mvura,","poem":1},{"text":"ndizvo zvakaita munhu anozvirumbidza pamusoro pezvipo zvaasingapi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kubudikidza nomwoyo murefu mutongi anogona kunyengetedzwa,","poem":1},{"text":"uye rurimi runyoro runogona kuvhuna mapfupa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kana wawana uchi, idya hunokuringana chete, hukawandisa, ucharutsa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Usanyanyoenda pamba pomuvakidzani wako,","poem":1},{"text":"ukanyanya kuendapo, achakuvenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Setsvimbo kana munondo kana museve unopinza,","poem":1},{"text":"ndizvo zvakaita munhu anopa uchapupu hwenhema achipikisa muvakidzani wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sezino rakaora kana tsoka yakaremara,","poem":1},{"text":"ndizvo zvakafanana nokuvimba nomunhu asina kutendeka panguva yokutambudzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Souya anokurura nguo musi unotonhora,","poem":1},{"text":"kana sevhiniga inodururwa pasoda,","poem":2},{"lineBreak":true},{"text":"ndizvo zvinoita uyo anoimbira nziyo kumwoyo wakaremerwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kana muvengi wako ane nzara, mupe zvokudya adye;","poem":1},{"text":"kana aine nyota, mupe mvura anwe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mukuita izvi, uchaunganidzira mazimbe anopisa pamusoro wake,","poem":1},{"text":"uye Jehovha achakupa mubayiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Semhepo yokumusoro inouyisa mvura,","poem":1},{"text":"naizvozvo rurimi rwakaipa runouyisa zviso zvakashatirwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Zviri nani kugara pakona redenga reimba","poem":1},{"text":"pano kugara mumba nomudzimai anokakavara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Semvura inotonhorera kumweya wakaneta","poem":1},{"text":"ndizvo zvakaita nhau dzakanaka dzinobva kunyika iri kure.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Sechitubu chizere madhaka kana tsime rasvibiswa,","poem":1},{"text":"ndizvo zvakaita munhu akarurama anopa mukana kumunhu akaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Hazvina kunaka kudya uchi huzhinji,","poem":1},{"text":"kana kuti munhu azvitsvakire kukudzwa kwake iye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Seguta rakakoromoka masvingo","poem":1},{"text":"ndizvo zvakaita munhu asingagoni kuzvibata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}