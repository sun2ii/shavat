{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"Sechando muzhizha kana mvura pakukohwa,","poem":1},{"text":"rukudzo haruna kufanira kubenzi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sezvinoita kadhimba pakubhururuka kwako, kana nyenganyenga pakubhururuka kwayo somuseve,","poem":1},{"text":"saizvozvowo kutuka pasina mhosva hakuna zvakunoita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tyava yakaitirwa bhiza, matomu akaitirwa mbongoro,","poem":1},{"text":"uye shamhu musana webenzi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Usapindura benzi maererano noupenzi hwaro,","poem":1},{"text":"kana kuti iwe pachako uchafanana naro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pindura benzi maererano noupenzi hwaro,","poem":1},{"text":"kuti rirege kuona sokuti rakachenjera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sokuzvigura tsoka kana kunwa bongozozo,","poem":1},{"text":"ndizvo zvakaita kutumira shoko noruoko rwebenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Samakumbo echirema akangorembera ndizvo","poem":1},{"text":"zvakaita chirevo mumuromo webenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sokusungira ibwe pachipfuramabwe","poem":1},{"text":"ndizvo zvakaita kupa rukudzo kubenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Segwenzi reminzwa riri muruoko rwechidhakwa,","poem":1},{"text":"ndizvo zvakaita chirevo chiri mumuromo webenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Somuwemburi weuta anopfura pose pose,","poem":1},{"text":"ndizvo zvakaita anoshandirwa nebenzi kana nomupfuuri zvake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sembwa inodzokera kumarutsi ayo,","poem":1},{"text":"ndizvo zvakaita benzi rinodzokorora upenzi hwaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Unoona munhu anozviti akachenjera pakuona kwake here?","poem":1},{"text":"Benzi rinotova netariro kupfuura iye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Simbe inoti, “Kune shumba kunzira,","poem":1},{"text":"shumba inotyisa iri kufamba-famba munzira dzomumusha!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Segonhi rinotenderera pamahinji aro,","poem":1},{"text":"ndizvo zvinoita simbe pamubhedha wayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Simbe inoisa ruoko rwayo mundiro;","poem":1},{"text":"inoita usimbe hwokutadza kurudzosera kumuromo wayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Simbe inozviti yakachenjera pakuona kwayo","poem":1},{"text":"kupfuura vanhu vanomwe vanopindura nenjere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Somunhu anobata imbwa nenzeve dzayo,","poem":1},{"text":"ndizvo zvakaita mupfuuri anopindira pagakava risinei naye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Somupengo unopotsera zvitsiga zvomoto,","poem":1},{"text":"kana miseve inouraya,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ndizvo zvakaita munhu anonyengera muvakidzani wake","poem":1},{"text":"uye achizoti, “Ndanga ndichiita zvangu je-e!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Pasina huni moto unodzima;","poem":1},{"text":"pasina makuhwa kukakavara kunopera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Sezvakaita mazimbe pazvitsiga zvinopfuta nehuni pamoto,","poem":1},{"text":"ndizvo zvakaita munhu wegakava pakupfutidza rukave.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mashoko eguhwa akaita semisuva","poem":1},{"text":"yakaisvonaka inodzika mukatikati momunhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Sezvinopenya zvakanamirwa kunze kwomudziyo wevhu,","poem":1},{"text":"ndizvo zvakaita miromo inotaura zvinoyevedza, asi nomwoyo wakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Muparadzi anozvivanza namatauriro ake,","poem":1},{"text":"asi mumwoyo make akaviga ruvengo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kunyange mashoko ake achitapira, usatenda zvaanotaura,","poem":1},{"text":"nokuti mumwoyo make mune zvinonyangadza zvinomwe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ruvengo rwake rungavigwa mukunyengera kwake,","poem":1},{"text":"asi kuipa kwake kuchabudiswa pachena paungano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kana munhu akachera gomba, achawira mariri;","poem":1},{"text":"kana munhu akakungurutsa ibwe, richakunguruka, richidzokera pamusoro pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Rurimi runoreva nhema runovenga varunorwadzisa,","poem":1},{"text":"uye muromo unobata kumeso unoparadza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}