{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Usazvirumbidza pamusoro pezuva ramangwana,","poem":1},{"text":"nokuti hauzivi zvingauyiswa nezuva.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rega mumwe akurumbidze, kwete muromo wako;","poem":1},{"text":"mumwe munhuwo zvake, kwete miromo yako iwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ibwe rinorema uye jecha mutoro,","poem":1},{"text":"asi kudenhwa nebenzi kunorema kupfuura zvose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hasha dzine utsinye uye kutsamwa kunokurira,","poem":1},{"text":"asi ndiani angamira pamberi pomunhu ane godo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kutsiurwa pachena kuri nani","poem":1},{"text":"pane rudo rwakavanzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Maronda okukuvadzwa neshamwari anogamuchirika,","poem":1},{"text":"asi kutsvoda kwomuvengi kunonyengera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Uyo akaguta anovenga uchi,","poem":1},{"text":"asi kune ane nzara kunyange zvinovava zvinozipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Seshiri inorasika kubva padendere rayo,","poem":1},{"text":"ndizvo zvakaita munhu anorasika kubva pamusha wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mafuta nezvinonhuhwira zvinouyisa mufaro kumwoyo,","poem":1},{"text":"uye kunaka kwoushamwari kunobva padzidziso dzake dzakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Usarasa shamwari yako kana shamwari yababa vako,","poem":1},{"text":"uye usangoenda kumba yehama yako kana wawirwa nedambudziko chete,","poem":2},{"lineBreak":true},{"text":"muvakidzani ari pedyo ari nani kupfuura hama iri kure.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Iva wakachenjera, mwanakomana wangu, ugofadza mwoyo wangu;","poem":1},{"text":"ipapo ndichagona kupindura ani naani anondishora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Munhu akangwara anoona njodzi agovanda,","poem":1},{"text":"asi asina mano anoramba achienda uye agokuvadzwa nayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Torera nguo uyo anozviita rubatso kumutorwa;","poem":1},{"text":"uitore semhiko kana achinge aiita rubatso kumukadzi asingazvibati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kana munhu akafumira rungwanangwana","poem":1},{"text":"kukwazisa muvakidzani wake achidaidzirisa zvichaonekwa sechituko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mudzimai anokakavara akafanana","poem":1},{"text":"nemvura inoramba ichidonha-donha mushure mokunge kwanaya;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kumudzivisa zvakafanana nokudzivisa mhepo,","poem":1},{"text":"kana kuchingidzira mafuta noruoko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Simbi inorodza simbi,","poem":1},{"text":"saizvozvowo mumwe munhu anorodza mumwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Uyo anochengeta muonde achadya zvibereko zvawo,","poem":1},{"text":"uye uyo anochengeta tenzi wake achakudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sezvo mvura ichiratidza chiso,","poem":1},{"text":"saizvozvowo mwoyo womunhu unoratidza munhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Rufu nokuparadza hazvimboguti,","poem":1},{"text":"kunyangewo maziso omunhu haaguti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hari ndeyokunyautsira sirivha uye choto ndechokunatsa goridhe,","poem":1},{"text":"asi munhu anoedzwa nerumbidzo yaanowana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kunyange ukatswa benzi muduri,","poem":1},{"text":"kumutswa sezviyo nomutswi,","poem":2},{"lineBreak":true},{"text":"haungabvisi upenzi hwake maari.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Iva nechokwadi kuti unoziva mamiriro amakwai ako,","poem":1},{"text":"uchengete zvakanaka mapoka ako;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"nokuti pfuma haigari nokusingaperi,","poem":1},{"text":"uye korona haigari kusvikira kuzvizvarwa zvose.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kana uswa hukabviswa, uye bumhudza rikabuda,","poem":1},{"text":"nesora rikaunganidzwa kubva kuzvikomo,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"makwayana achakuwanisa zvokupfeka,","poem":1},{"text":"uye mbudzi nomutengo womunda.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Uchava nomukaka wembudzi","poem":1},{"text":"wakawanda wokudya iwe nemhuri yako,","poem":2},{"lineBreak":true},{"text":"uye wokuraramisa varandakadzi vako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}