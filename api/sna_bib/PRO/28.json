{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Munhu akaipa anotiza kusina anomudzinganisa,","poem":1},{"text":"asi vakarurama vakashinga seshumba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kana nyika ikapanduka, inova navatungamiri vakawanda,","poem":1},{"text":"asi munhu anonzwisisa uye ane ruzivo anochengetedza runyararo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mutongi anomanikidza varombo","poem":1},{"text":"akaita semvura inokukura ichisiya pasina zvirimwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Avo vanorasa murayiro vanorumbidza vakaipa,","poem":1},{"text":"asi avo vanochengeta murayiro vanovapikisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vanhu vakaipa havanzwisisi kururamisira,","poem":1},{"text":"asi avo vanotsvaka Jehovha vanozvinzwisisa kwazvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Zviri nani kuva murombo ane mafambiro akarurama","poem":1},{"text":"pane mupfumi ane nzira dzakatsauka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Uyo anochengeta murayiro mwanakomana akachenjera,","poem":1},{"text":"asi anofambidzana navanhu vane madyo anonyadzisa baba vake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uyo anowedzera pfuma yake nokutengesa nomutengo uri pamusoro-soro,","poem":1},{"text":"anozviunganidzira mumwe, uyo anozonzwira varombo tsitsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kana munhu akaramba kunzwa murayiro nenzeve dzake,","poem":1},{"text":"kunyange minyengetero yake inonyangadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Uyo anotungamirira vakarurama panzira yakaipa,","poem":1},{"text":"achawira mumuteyo wake pachake,","poem":2},{"lineBreak":true},{"text":"asi vasina mhosva vachagamuchira nhaka yakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Munhu akapfuma angazviti akachenjera pakuona kwake,","poem":1},{"text":"asi murombo ane njere anomuonorora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kana vakarurama vachikunda, kune mufaro mukuru;","poem":1},{"text":"asi kana akaipa akava pachigaro chokutonga, vanhu vanohwanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Uyo anofukidzira zvivi zvake haabudiriri,","poem":1},{"text":"asi ani naani anozvireurura uye agozvirasa achawana nyasha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Akaropafadzwa munhu anogara achitya Jehovha,","poem":1},{"text":"asi uyo anoomesa mwoyo wake achawira mudambudziko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Seshumba inoomba, kana bere rinodzingirira,","poem":1},{"text":"ndizvo zvakaita munhu akaipa anobata ushe pamusoro pavarombo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mutongi anoshusha haana njere,","poem":1},{"text":"asi uyo anovenga pfuma yakapambwa achararama kwamakore mazhinji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Munhu anoshushikana nemhosva yake yokuuraya,","poem":1},{"text":"acharamba ari wokutiza kusvikira pakufa;","poem":2},{"lineBreak":true},{"text":"ngapasava nomunhu anomutsigira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Uyo ano mufambiro wakarurama anogara akachengetedzeka,","poem":1},{"text":"asi uyo ane nzira dzakatsauka achawa nokukurumidza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Uyo anorima munda wake achava nezvokudya zvakawanda,","poem":1},{"text":"asi uyo anodzinganisana nezviroto achava nourombo hwakamufanira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Munhu akatendeka acharopafadzwa zvikuru,","poem":1},{"text":"asi uyo anokara pfuma haangaregi kurangwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kuita rusarura hakuna kunaka,","poem":1},{"text":"asi kunyange zvakadaro munhu anogona kuita zvakaipa kuti awane chimedu chechingwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Munhu anonyima ane shungu dzokuda kupfuma","poem":1},{"text":"asingazivi kuti urombo hwakamugaririra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Uyo anotsiura munhu iye achawana nyasha dzakawanda pakupedzisira,","poem":1},{"text":"kupfuura uyo ane rurimi runonyengera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Uyo anobira baba kana mai vake","poem":1},{"text":"achiti, “Hazvina kuipa,”","poem":2},{"lineBreak":true},{"text":"ndiye shamwari youya anoparadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Munhu ane ruchiva anomutsa kupesana,","poem":1},{"text":"asi uyo anovimba naJehovha achabudirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Uyo anovimba nesimba rake ibenzi,","poem":1},{"text":"asi uyo anofamba muuchenjeri achachengetedzeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Uyo anopa kuvarombo haangashayiwi chinhu,","poem":1},{"text":"asi uyo anotsinzina meso ake kuvarombo achagamuchira kutukwa kuzhinji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kana akaipa achienda pachigaro chokutonga, vanhu vanohwanda;","poem":1},{"text":"asi kana vakaipa vachiparara, vakarurama vanowanda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}