{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Munhu anoramba akaomesa mutsipa wake mushure mokutsiurwa","poem":1},{"text":"kazhinji achaparadzwa nokukurumidza, kusina chingamubatsira.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kana vakarurama vachiwanda, vanhu vanofara;","poem":1},{"text":"asi kana vakaipa vachitonga, vanhu vanogomera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Munhu anoda uchenjeri anouyisa mufaro kuna baba vake,","poem":1},{"text":"asi anoshamwaridzana nechifeve anoparadza pfuma yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nokururamisira mambo anosimbisa nyika,","poem":1},{"text":"asi uyo anokara fufuro anoiparadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani naani anonyengera muvakidzani wake","poem":1},{"text":"anodzikira tsoka dzake mumbure.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Munhu akaipa anoteyiwa nezvivi zvake,","poem":1},{"text":"asi munhu akarurama anogona kuimba uye agofara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vakarurama vane hanya nokururamisirwa kwavarombo,","poem":1},{"text":"asi vakaipa havana hanya naizvozvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Vatuki vanomutsa bope muguta,","poem":1},{"text":"asi vanhu vakachenjera vanodzora kutsamwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kana munhu akachenjera akaenda kumatare nebenzi,","poem":1},{"text":"benzi rinotsamwa uye rigotuka, zvokuti hapangavi norugare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vanhu vanofarira kudeura ropa vanovenga munhu akarurama,","poem":1},{"text":"uye vanotsvaka kuuraya vakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Benzi rinobudisa hasha dzaro dzose,","poem":1},{"text":"asi munhu akachenjera anozvibata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kana mutongi akateerera nhema","poem":1},{"text":"machinda ake ose achava akaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Murombo nomunhu anomanikidza vakafanana pachinhu ichi:","poem":1},{"text":"Jehovha ndiye anoita kuti meso avo vose aone.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kana mambo akatonga varombo nokururamisira,","poem":1},{"text":"chigaro chake choushe chinogara chakachengetedzeka nguva dzose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Shamhu yokuranga inopa uchenjeri,","poem":1},{"text":"asi mwana anosiyiwa akadaro achanyadzisa mai vake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kana vakaipa vachiwanda, nezvivi zvinowandawo,","poem":1},{"text":"asi vakarurama vachaona kuwa kwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ranga mwanakomana wako, ipapo achakupa rugare;","poem":1},{"text":"achauyisa mufaro kumweya wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Pasina chizaruro, vanhu vanoramba kuzvidzora;","poem":1},{"text":"asi akaropafadzwa uyo anochengeta murayiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Muranda haarayirwi namashoko zvawo chete,","poem":1},{"text":"nokuti kunyange achinzwisisa, haangadaviri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Unoona here munhu anotaura achikurumidza?","poem":1},{"text":"Benzi rine tariro zhinji kupfuura iye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kana munhu akaregerera muranda wake kubva paudiki,","poem":1},{"text":"achazotarisira kodzero dzomwanakomana pakupedzisira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Munhu akashatirwa anomutsa kupesana,","poem":1},{"text":"uye munhu ane hasha anoita zvivi zvizhinji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kuzvikudza kwomunhu kunomudzikisira pasi,","poem":1},{"text":"asi munhu ane mweya wokuzvininipisa achawana kukudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Anoshamwaridzana nembavha anozvivenga iye pachake;","poem":1},{"text":"anoiswa pasi pemhiko, asi haangakwanisi kupa uchapupu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kutya munhu kuchava musungo,","poem":1},{"text":"asi ani naani anovimba naJehovha achagara akachengetedzeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Vazhinji vanotsvaka nyasha kumutongi,","poem":1},{"text":"asi kururamisirwa kwomunhu kunobva kuna Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Vakarurama vanovenga vasina kutendeka;","poem":1},{"text":"vakaipa vanovenga vakarurama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}