{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Munhu ngaatye Jehovha, avimbe naye uye amuteerere"]},{"type":"verse","number":1,"content":[{"text":"Mwanakomana wangu, usakanganwa kudzidzisa kwangu,","poem":1},{"text":"asi uchengete mirayiro yangu mumwoyo mako,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"nokuti zvichawedzera makore mazhinji kuupenyu hwako,","poem":1},{"text":"uye nokubudirira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rudo nokutendeka ngazvirege kukusiya;","poem":1},{"text":"uzvisungirire pamutsipa wako,","poem":2},{"lineBreak":true},{"text":"zvinyore pahwendefa romwoyo wako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ipapo uchawana nyasha nezita rakanaka","poem":1},{"text":"pamberi paMwari navanhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vimba naJehovha nomwoyo wako wose","poem":1},{"text":"urege kuzendamira panjere dzako;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"munzira dzako dzose umutungamidze,","poem":1},{"text":"uye acharuramisa nzira dzako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Usazviita munhu akachenjera pamaonero ako;","poem":1},{"text":"itya Jehovha uvenge zvakaipa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Izvi zvichava utano pamuviri wako","poem":1},{"text":"uye nokusimbiswa kwamapfupa ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kudza Jehovha nepfuma yako,","poem":1},{"text":"zvokutanga zvezvirimwa zvako;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ipapo matura ako achazadzwa kusvikira pakufashukira,","poem":1},{"text":"uye makate ako achazara kusvika pamusoro newaini itsva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwanakomana wangu, usazvidza kuranga kwaJehovha,","poem":1},{"text":"uye usatsamwira kutsiura kwake,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"nokuti Jehovha anoranga avo vaanoda,","poem":1},{"text":"sababa nomwanakomana wavanofarira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Akaropafadzwa munhu anowana uchenjeri,","poem":1},{"text":"munhu anowana kunzwisisa,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nokuti hwakanyanya kunaka kupfuura sirivha,","poem":1},{"text":"uye hunopfumisa kupfuura goridhe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hunokosha kupfuura marubhi;","poem":1},{"text":"zvose zvaunoshuva hazvingafananidzwi nahwo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mazuva mazhinji oupenyu ari muruoko rwahwo rworudyi;","poem":1},{"text":"muruboshwe rwahwo mune upfumi nokukudzwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nzira dzahwo dzinofadza,","poem":1},{"text":"uye makwara ahwo ose rugare.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndihwo muti woupenyu kuna vose vanohumbundikira;","poem":1},{"text":"vose vanohubata vacharopafadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nouchenjeri Jehovha akateya nheyo dzenyika,","poem":1},{"text":"nokunzwisisa akaisa matenga munzvimbo dzawo;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"noruzivo rwake mvura dzakadzika dzakapatsanurwa,","poem":1},{"text":"uye makore akadonhedza dova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mwanakomana wangu, chengetedza kutonga kwakanaka nokungwara,","poem":1},{"text":"usazvirega zvichibva pameso ako;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"zvichava upenyu kwauri,","poem":1},{"text":"chishongo chakanaka pamutsipa wako.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ipapo uchafamba panzira yako murugare,","poem":1},{"text":"uye rutsoka rwako harungagumburwi;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"paunovata pasi, haungatyi; paunovata pasi,","poem":1},{"text":"hope dzako dzichava dzakanaka.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Usatya zvako dambudziko rinovhundutsa","poem":1},{"text":"kana kuparadza kunokunda vakaipa,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"nokuti Jehovha achava chivimbo chako","poem":1},{"text":"uye achachengeta rutsoka rwako kuti rurege kubatwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Usarega kuitira zvakanaka kuno uyo akafanirwa nazvo,","poem":1},{"text":"kana zviri musimba rako kuzviita.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Usati kumuvakidzani wako,","poem":1},{"text":"“Ugodzoka imwe nguva; ndichazokupa mangwana,”","poem":2},{"lineBreak":true},{"text":"iwe uchitova nazvo pauri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Usaronga kuitira muvakidzani wako zvakaipa,","poem":1},{"text":"anogara nechivimbo pedyo newe.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Usapomera munhu mhosva pasina chikonzero,","poem":1},{"text":"iye asina zvaakutadzira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Usachiva munhu anoita zvinhu nechisimba,","poem":1},{"text":"kana kusarudza ipi zvayo yenzira dzake,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"nokuti Jehovha anovenga munhu akatsauka,","poem":1},{"text":"asi anoudza akarurama zvaanoda kuita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Kutuka kwaJehovha kuri paimba yeakaipa,","poem":1},{"text":"asi anoropafadza musha womunhu akarurama.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Anoseka vaseki vanozvikudza,","poem":1},{"text":"asi anoitira nyasha vanozvininipisa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Vakachenjera vanowana kukudzwa,","poem":1},{"text":"asi mapenzi anozviwanira kunyadziswa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}