{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"heading","content":["Zvirevo zvaAguri"]},{"type":"verse","number":1,"content":["Zvirevo zvaAguri mwanakomana waJake, shoko rake:",{"text":"Murume uyu akati kuna Itieri,","poem":1},{"text":"kuna Itieri nokuna Ukari:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Ndini munhu asingazivi zvikuru kwazvo pakati pavanhu;","poem":1},{"text":"handina kunzwisisa kwomunhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Handina kudzidza uchenjeri,","poem":1},{"text":"uye handina ruzivo rwaiye Mutsvene.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndiani akakwidza kudenga uye akazoburuka?","poem":1},{"text":"Ndiani akabata mhepo mumaoko ake?","poem":2},{"text":"Ndiani akasungirira mvura munguo yake?","poem":1},{"text":"Ndiani akaisa migumo yose yenyika?","poem":2},{"text":"Zita rake ndiani, uye nezita romwanakomana wake?","poem":1},{"text":"Ndiudzei kana muchiriziva!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Shoko rimwe nerimwe raMwari nderechokwadi;","poem":1},{"text":"iye chidzitiro kuna avo vanovanda maari.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Usawedzera kumashoko ake,","poem":1},{"text":"kana kuti achakutsiura uye agokuratidza kuti uri murevi wenhema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Zvinhu zviviri zvandinokumbira kwamuri, imi Jehovha,","poem":1},{"text":"musandirambira izvi ndisati ndafa:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bvisai kusatendeka nenhema zvive kure neni;","poem":1},{"text":"musandipa urombo kana pfuma,","poem":2},{"lineBreak":true},{"text":"asi ndipei chete zvokudya zvemisi yose.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zvichida, ndingava nezvakawanda kwazvo ndikasakukudzai,","poem":1},{"text":"uye ndikazoti, ‘Jehovha ndianiko?’","poem":2},{"text":"Kana kuti zvimwe ndingava murombo ndikaba,","poem":1},{"text":"uye ndikasaremekedza zita raMwari wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Usareva muranda kuna tenzi wake,","poem":1},{"text":"nokuti achakutuka, uye uchazviripira izvozvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Kuna avo vanotuka madzibaba avo","poem":1},{"text":"uye vasingaropafadzi vanamai vavo;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"vaya vanozviti vakachena pamaonero avo","poem":1},{"text":"asi vasina kusukwa tsvina yavo;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"vaya vane meso anozvikudza nguva dzose,","poem":1},{"text":"vane matarisiro okushora;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"vaya vane meno anenge minondo","poem":1},{"text":"nameno eshaya dzavo anenge mapanga","poem":2},{"text":"kuti vaparadze varombo panyika,","poem":1},{"text":"navanoshayiwa kubva pakati pavanhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Chikwevaropa chine vanasikana vaviri.","poem":1},{"text":"Vanodanidzira vachiti, ‘Tipei! Tipei!’","poem":2},{"lineBreak":true},"“Kune zvinhu zvitatu zvisingatongoguti, zvina zvisingamboti, ‘Zvaringana!’:"]},{"type":"verse","number":16,"content":["guva, chizvaro chisingabereki, pasi pasingaguti mvura, nomoto usingamboti, ‘Zvaringana!’"]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Ziso rinotuka baba,","poem":1},{"text":"rinoshora kuteerera mai,","poem":2},{"text":"richanongorwa namakunguo omumupata,","poem":1},{"text":"richadyiwa namagora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":["“Pane zvinhu zvitatu zvinondishamisa kwazvo, zvina zvandisinganzwisisi, zvinoti:"]},{"type":"verse","number":19,"content":["nzira yegondo riri mudenga, nenzira yenyoka paruware, nenzira yechikepe pagungwa, uye nzira yomurume ane musikana."]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Iyi ndiyo nzira yomukadzi chifeve:","poem":1},{"text":"Anodya agopukuta muromo wake uye agoti,","poem":2},{"lineBreak":true},{"text":"‘Hapana chinhu chakaipa chandaita ini.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":["“Nyika inodedera nokuda kwezvinhu zvitatu, zvinhu zvina zvaisingadi kuona:"]},{"type":"verse","number":22,"content":["muranda anozova mambo, benzi rine zvokudya zvizhinji,"]},{"type":"verse","number":23,"content":["mukadzi akaroorwa asi asingadiwi, nomurandakadzi anotorera vatenzi vake murume."]},{"type":"line_break"},{"type":"verse","number":24,"content":["“Panyika pane zvinhu zvina zvidiki, asi zvakachenjera kwazvo:"]},{"type":"verse","number":25,"content":["Masvosve zvipuka zvine simba duku asi anounganidza zvokudya zvawo muzhizha:"]},{"type":"verse","number":26,"content":["mbira zvipuka zvisina simba guru, asi dzinoita imba yadzo mumatombo;"]},{"type":"verse","number":27,"content":["mhashu hadzina mambo, asi dzinofamba pamwe chete mumapoka adzo;"]},{"type":"verse","number":28,"content":["dzvinyu rinogona kubatwa namaoko, asi rinowanikwa mumizinda yamadzimambo."]},{"type":"line_break"},{"type":"verse","number":29,"content":["“Kune zvinhu zvitatu zvino kufamba kunokudzwa kwazvo, zvina zvino kufamba kunokudzwa kwazvo;"]},{"type":"verse","number":30,"content":["shumba, ine simba pakati pezvikara, isingadududzi pamberi pechikara chipi zvacho;"]},{"type":"verse","number":31,"content":["mafambiro okuzvikudza ejongwe, nenhongo yembudzi, uye namambo akakomberedzwa navarwi vake."]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Kana uchinge waita upenzi nokuzvirumbidza pachako,","poem":1},{"text":"kana kuti waronga zvakaipa,","poem":2},{"lineBreak":true},{"text":"bata muromo wako noruoko rwako!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Nokuti somukaka warozva unobudisa ruomba,","poem":1},{"text":"uye sokudzvinyirira mhino kunobudisa ropa,","poem":2},{"lineBreak":true},{"text":"nokudaro kumutsa hasha kunobudisa kukakavara.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}