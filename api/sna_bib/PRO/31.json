{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"heading","content":["Zvirevo zvaMambo Remueri"]},{"type":"verse","number":1,"content":["Zvirevo zvaMambo Remueri, zvirevo zvaakadzidziswa namai vake:"]},{"type":"verse","number":2,"content":[{"text":"“Nhaiwe mwanakomana wangu, iwe mwanakomana wokubereka,","poem":1},{"text":"iwe mwanakomana wemhiko dzangu,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"usapedzera simba rako pavakadzi,","poem":1},{"text":"nenzira dzako pane avo vanoparadza madzimambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Hazvisi zvamadzimambo, nhaiwe Remueri,","poem":1},{"text":"hazvina kufanira madzimambo kunwa waini,","poem":2},{"lineBreak":true},{"text":"hazvina kufanira vatongi kukara doro,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"nokuti vangazonwa vakakanganwa zvakatemwa nomurayiro,","poem":1},{"text":"uye vakazotadza kururamisira kodzero dzavanomanikidzwa vose.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ipai doro kuna avo vari kuparara,","poem":1},{"text":"newaini kuna avo vari mukurwadziwa:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"regai vanwe vakanganwe urombo hwavo,","poem":1},{"text":"uye varege kuzorangarirazve kutambudzika kwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Taurai pachinzvimbo chaavo vasingagoni kuzvitaurira,","poem":1},{"text":"pamusoro pekodzero dzavose vanoshayiwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taura utonge zvakanaka;","poem":1},{"text":"udzivirire kodzero dzavarombo navanoshayiwa.”","poem":2}]},{"type":"heading","content":["Mudzimai ane Unhu Hwakanaka"]},{"type":"verse","number":10,"content":[{"text":"Mudzimai ane unhu hwakanaka ndiani angamuwana?","poem":1},{"text":"Mutengo wake unopfuura nokure matombo anokosha emarubhi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Murume wake anovimba naye zvizere,","poem":1},{"text":"uye haana chaanoshayiwa chinokosha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anoitira murume wake zvakanaka, kwete zvakaipa,","poem":1},{"text":"mazuva ose oupenyu hwake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anosarudza wuru neshinda","poem":1},{"text":"uye anoshanda namaoko anoshingaira.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akafanana nezvikepe zvavatengesi,","poem":1},{"text":"anondotora zvokudya zvake kure.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anomuka kuchakasviba;","poem":1},{"text":"agotsvagira mhuri yake zvokudya","poem":2},{"lineBreak":true},{"text":"uye agopa varandakadzi vake basa ravo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Anonanʼanidza munda agoutenga;","poem":1},{"text":"anosima munda wemizambiringa nezvaakawana namaoko ake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Anoita basa rake nesimba;","poem":1},{"text":"maoko ake akasimba kuti aite mabasa ake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anoona kuti kushambadzira kwake kunobatsira,","poem":1},{"text":"uye mwenje wake haudzimi pausiku.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Muruoko rwake anobata chirukiso,","poem":1},{"text":"uye anobata chirukwa neminwe yake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Anotambanudzira maoko ake kuvarombo,","poem":1},{"text":"uye anotandavadzira maoko ake kune vanoshayiwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kana kwotonhora, haatyire mhuri yake;","poem":1},{"text":"nokuti vose vakapfeka nguo dzinodziya.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Anozvigadzirira zvokuwaridza panhoo yake;","poem":1},{"text":"anozvipfekedza nguo yomucheka wakaisvonaka, uye nomucheka wepepuru.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Murume wake anoremekedzwa pasuo reguta,","poem":1},{"text":"kana agere pakati pavakuru venyika.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mudzimai anoita nguo dzemicheka yakanaka agodzitengesa,","poem":1},{"text":"uye anotengesera vanotengesa micheka yokumonera muhuro.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Simba nokukudzwa ndizvo nguo dzake;","poem":1},{"text":"anofara akatarisana namazuva anouya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Anotaura nouchenjeri,","poem":1},{"text":"uye kurayira kwakatendeka kuri parurimi rwake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Anotarira zvakanaka mararamiro emhuri yake,","poem":1},{"text":"uye haadyi zvokudya zvousimbe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Vana vake vanosimuka vagomuti akaropafadzwa,","poem":1},{"text":"murume wakewo, anomurumbidza:","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Vakadzi vazhinji vanoita zvinhu zvakanaka,","poem":1},{"text":"asi iwe unovakunda vose.”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Zvinofadza zvinonyengera, uye runako ndorwenguva duku;","poem":1},{"text":"asi mukadzi anotya Jehovha anofanira kurumbidzwa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mupeiwo mubayiro wake waakashandira,","poem":1},{"text":"uye mabasa ake ngaamupe kurumbidzwa pasuo reguta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}