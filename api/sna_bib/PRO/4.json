{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Uchenjeri chinhu chikuru"]},{"type":"verse","number":1,"content":[{"text":"Teererai, vanakomana vangu, kurayira kwababa venyu;","poem":1},{"text":"nyatsoteererai mugowana kunzwisisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndinokupai dzidziso yakanaka,","poem":1},{"text":"saka regai kurasa dzidziso yangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pandakanga ndiri mukomana mumba mababa vangu,","poem":1},{"text":"ndichiri muduku uye mwana mumwe chete wamai vangu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"baba vangu vakandidzidzisa vachiti,","poem":1},{"text":"“Mwoyo wako ngaubatisise mashoko angu;","poem":2},{"lineBreak":true},{"text":"chengeta mirayiro yangu ugorarama.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wana uchenjeri, wana kunzwisisa;","poem":1},{"text":"usakanganwa mashoko angu kana kubva paari.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Usarasa uchenjeri, ipapo huchakuchengeta;","poem":1},{"text":"hude, ihwo hugokurinda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uchenjeri chinhu chikuru; naizvozvo wana uchenjeri.","poem":1},{"text":"Kunyange huchikutorera zvose zvaunazvo, wana kunzwisisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uhukudze; ipapo huchakusimudzira;","poem":1},{"text":"uhumbundikire, ipapo huchakukudza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Huchakupfekedza chishongo chenyasha mumusoro mako,","poem":1},{"text":"uye huchakupa korona yokubwinya.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Teerera, mwanakomana wangu, gamuchira zvandinotaura,","poem":1},{"text":"ipapo makore oupenyu hwako achava mazhinji.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndinokudzidzisa nzira youchenjeri","poem":1},{"text":"uye ndiri kukutungamirira panzira dzakarurama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Paunofamba, tsoka dzako hadzingapinganidzwi,","poem":1},{"text":"paunomhanya, haungagumburwi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Batisisa kurayirwa, usarega kuchienda;","poem":1},{"text":"nyatsokurinda zvakanaka, nokuti ndihwo upenyu hwako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Usaisa rutsoka panzira dzavakaipa,","poem":1},{"text":"kana kufamba panzira dzavanhu vakaipa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Udzinzvenge, usafamba padziri;","poem":1},{"text":"tsauka padziri ugopfuurira mberi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nokuti havangavati vasati vaita zvakaipa;","poem":1},{"text":"havangabatwi nehope kusvikira vaita kuti mumwe munhu aputsike.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Vanodya zvokudya zvezvakaipa,","poem":1},{"text":"uye vanonwa waini yezvechisimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nzira yavakarurama yakafanana nechiedza chamambakwedza,","poem":1},{"text":"chinoramba chichiwedzera kubwinya kusvikira pachiedza chamasikati makuru.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Asi nzira yavakaipa yakaita serima guru;","poem":1},{"text":"havazivi zvinoita kuti vagumburwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mwanakomana wangu, nyatsoteerera zvandinotaura;","poem":1},{"text":"teereresa kumashoko angu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Usaite kuti abve pameso ako,","poem":1},{"text":"achengete pakati pomwoyo wako;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"nokuti upenyu kuna avo vanoawana","poem":1},{"text":"uye noutano kumuviri wose womunhu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Pamusoro pazvo zvose, chengetedza mwoyo wako,","poem":1},{"text":"nokuti ndicho chitubu choupenyu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bvisa zvinotsausa pamuromo wako;","poem":1},{"text":"kutaura kwakaora ngakuve kure nemiromo yako.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Meso ako ngaatarire mberi bedzi,","poem":1},{"text":"ramba wakatarira mberi kwako.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Gadzirira tsoka dzako gwara","poem":1},{"text":"ugofamba munzira dzakasimba chete.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Usatsaukira kurudyi kana kuruboshwe;","poem":1},{"text":"chengetedza rutsoka rwako kuti rusaende pane zvakaipa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}