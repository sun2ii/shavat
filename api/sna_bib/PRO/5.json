{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["Yambiro pamusoro poUpombwe"]},{"type":"verse","number":1,"content":[{"text":"Mwanakomana wangu, nyatsoteerera kuuchenjeri hwangu,","poem":1},{"text":"teereresa kumashoko angu oungwaru,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kuti ugare wakachengeta kungwara","poem":1},{"text":"uye kuti miromo yako ichengetedze zivo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti miromo yomukadzi chifeve inodonha uchi,","poem":1},{"text":"nomutauriro wake unotedza kupfuura mafuta;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"asi pakupedzisira anovava senduru,","poem":1},{"text":"anopinza somunondo unocheka namativi ose.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tsoka dzake dzinoenda kurufu;","poem":1},{"text":"nhambwe dzake dzinonanga kuguva.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Haafungi pamusoro penzira youpenyu;","poem":1},{"text":"nzira dzake dzakaminama, asi iye haazvizivi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Saka zvino, vanakomana vangu, nditeererei;","poem":1},{"text":"musatsauka pane zvandinotaura.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Fambai nenzira iri kure naye,","poem":1},{"text":"musasvika pedyo nomusuo wemba yake,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kuti murege kupa vamwe zvakanaka zvesimba renyu,","poem":1},{"text":"uye namakore enyu kuno uyo ane utsinye,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kuti vatorwa varege kudya upfumi hwenyu,","poem":1},{"text":"uye kushanda kwenyu nesimba kurege kupfumisa imba yomumwe munhu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pakupedzisira kwoupenyu hwako uchagomera,","poem":1},{"text":"kana nyama nomuviri wako zvaparadzwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uchazoti, “Mavengero andaiita kurayirwa!","poem":1},{"text":"Mashorero aiita mwoyo wangu kudzorwa!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndakanga ndisingateereri vadzidzisi vangu,","poem":1},{"text":"kana kunzwa varairidzi vangu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndasvika pakuparara chaiko","poem":1},{"text":"pakati peungano yose.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Inwa mvura pachirongo chako chaicho,","poem":1},{"text":"mvura inoerera patsime rako chairo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ko, zvitubu zvako zvinofanira kuerera mumigwagwa here;","poem":1},{"text":"nzizi dzako dzemvura pazvivara?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngadzive dzako woga,","poem":1},{"text":"hadzitombofaniri kugoveranwa navatorwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tsime rako ngariropafadzwe,","poem":1},{"text":"uye ufadzwe nomudzimai woujaya hwako.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sehadzi yengururu inofadza, nehadzi yenondo yakanaka,","poem":1},{"text":"mazamu ake ngaakufadze nguva dzose,","poem":2},{"lineBreak":true},{"text":"ugare uchigutswa norudo rwake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Unosungirweiko, mwanakomana wangu, nomukadzi chifeve?","poem":1},{"text":"Unombundikirireiko chipfuva chomukadzi womumwe murume?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Nokuti nzira dzomunhu dziri pachena pamberi paJehovha,","poem":1},{"text":"uye anoongorora nzira dzake dzose.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Zviito zvakaipa zvomunhu akaipa zvichamusunga;","poem":1},{"text":"tambo dzechivi chake dzichamubata iye kwazvo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Achafa nokuda kwokushayiwa kuzvibata kwake,","poem":1},{"text":"atsauswa noupenzi hwake hukuru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}