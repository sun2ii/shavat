{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Yambiro pamusoro poUpenzi"]},{"type":"verse","number":1,"content":[{"text":"Mwanakomana wangu, kana uchinge waita rubatso kumuvakidzani wako,","poem":1},{"text":"kana uchinge waita mhiko nokumbunda noruoko rwako kuno mumwe,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kana uchinge wasungwa nokuda kwezvawakataura,","poem":1},{"text":"wabatwa namashoko omuromo wako,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ipapo ita izvi, mwanakomana wangu,","poem":1},{"text":"kuti uzvisunungure, sezvo wawira mumaoko omuvakidzani wako!","poem":2},{"text":"Enda undozvininipisa;","poem":1},{"text":"ukumbire zvikuru kumuvakidzani wako!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Usatendera meso ako hope,","poem":1},{"text":"usatendera meso ako kutsumwaira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvipukunyutse, semhara kubva paruoko rwomuvhimi,","poem":1},{"text":"seshiri kubva paugombe hwomuteyi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enda kusvosve, iwe simbe;","poem":1},{"text":"cherechedza nzira dzaro ugova wakachenjera!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Harina mutungamiri,","poem":1},{"text":"mutariri kana mutongi,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"asi rinochengeta zvokudya zvaro muzhizha,","poem":1},{"text":"uye rinounganidza zvokudya zvaro pakukohwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uchasvika riniko wakarara ipapo, iwe simbe?","poem":1},{"text":"Uchamuka riniko kubva pahope dzako?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kumbovata zvishomanana, kumbotsumwaira zvishomanana,","poem":1},{"text":"kumbopeta maoko zvishomanana kuti ndizorore.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naizvozvo urombo huchauya kwauri segororo,","poem":1},{"text":"uye kushayiwa somurwi akashonga nhumbi dzokurwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Munhu asina maturo uye anoita zvakaipa,","poem":1},{"text":"anofamba-famba achitaura zvakaora,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"anochonya nameso ake,","poem":2},{"lineBreak":true},{"text":"anonongedzera netsoka dzake,","poem":2},{"lineBreak":true},{"text":"uye anodudzira neminwe yake,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"anoronga zvakaipa nounyengeri mumwoyo make,","poem":2},{"lineBreak":true},{"text":"iyeyo anogaromutsa kupesana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Naizvozvo njodzi ichamuwira munguva shoma shoma;","poem":1},{"text":"achaparadzwa nokukurumidza, pasina chingamubatsira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":["Pane zvinhu zvitanhatu zvakavengwa naJehovha, zvinomwe zvinomunyangadza zvinoti:"]},{"type":"verse","number":17,"content":["meso anozvikudza, rurimi runoreva nhema, maoko anodeura ropa risina mhosva,"]},{"type":"verse","number":18,"content":["mwoyo unoronga mano akaipa, tsoka dzinokurumidza kumhanyira muzvakaipa,"]},{"type":"verse","number":19,"content":["chapupu chenhema chinodurura nhema, uye munhu anomutsa kupesana pakati pehama."]},{"type":"heading","content":["Yambiro pamusoro poUpombwe"]},{"type":"verse","number":20,"content":[{"text":"Mwanakomana wangu, chengetedza mirayiro yababa vako,","poem":1},{"text":"uye usarasa kudzidzisa kwamai vako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Zvisungirire pamwoyo wako nokusingaperi;","poem":1},{"text":"uzvishonge pamutsipa wako.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Paunofamba zvichakutungamirira;","poem":1},{"text":"paucharara, zvichakurinda;","poem":2},{"lineBreak":true},{"text":"pauchamuka, zvichataura newe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nokuti mirayiro iyi ndiyo mwenje kwauri, dzidziso iyi ndiyo chiedza,","poem":1},{"text":"uye kudzora kwokurayira ndiko nzira youpenyu,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kunokuchengetedza pamukadzi asingazvibati,","poem":1},{"text":"kubva parurimi runonyengera rwomudzimai asingazvibati.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Usachiva runako rwake mumwoyo mako,","poem":1},{"text":"kana kumurega achikubata namaziso ake,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"nokuti chifeve chinokuderedza kusvikira wafanana nechingwa,","poem":1},{"text":"uye mukadzi womumwe asi ari chifeve anoendesa upenyu hwako chaihwo kurufu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ko, munhu angaisa moto pamakumbo ake,","poem":1},{"text":"nguo dzake dzikasatsva here?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ko, munhu angafamba pamazimbe anopisa,","poem":1},{"text":"tsoka dzake dzikasatsva here?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ndizvo zvakaita uyo anorara nomudzimai womumwe murume;","poem":1},{"text":"hapana angabate mukadzi iyeyo akasarangwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Vanhu havazvidzi mbavha","poem":1},{"text":"kana ikaba kuti ipedze nzara yayo painenge yoziya.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Asi kana akabatwa, anofanira kuripa kakapetwa kanomwe,","poem":1},{"text":"kunyange zvichimutorera pfuma yose yeimba yake.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Asi munhu anoita upombwe, anoshayiwa njere;","poem":1},{"text":"ani naani anozviita anozviparadza iye pachake.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kurohwa nokunyadziswa ndiwo mugove wake,","poem":1},{"text":"uye kunyadziswa kwake hakungatongobviswi;","poem":2}]},{"type":"verse","number":34,"content":[{"text":"nokuti godo rinomutsa hasha dzomurume,","poem":1},{"text":"uye haanganzwiri tsitsi kana otsiva.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Haangagamuchiri muripo upi zvawo;","poem":1},{"text":"acharamba fufuro, kunyange rakakura sei.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}