{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Yambiro pamusoro poMukadzi Chifeve"]},{"type":"verse","number":1,"content":[{"text":"Mwanakomana wangu,","poem":1},{"text":"chengeta mashoko angu ugoviga mirayiro yangu mauri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Chengeta mirayiro yangu ugorarama;","poem":1},{"text":"uchengete dzidziso dzangu semboni yeziso rako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uzvisungirire paminwe yako;","poem":1},{"text":"uzvinyore pahwendefa yomwoyo wako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uti kuuchenjeri, “Uri hanzvadzi yangu,”","poem":1},{"text":"uye uti kunzwisisa ndiyo hama yako;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"zvichakuchengeta kure nomukadzi chifeve;","poem":1},{"text":"kubva pamudzimai asingazvibati anokwezva namashoko ake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Napawindo remba yangu","poem":1},{"text":"ndakatarira panze nomumagirazi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndakaona pakati pavasina mano","poem":1},{"text":"ndikacherechedza pakati pamajaya,","poem":2},{"lineBreak":true},{"text":"rimwe jaya rakanga risina njere.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Rakanga richidzika nomugwagwa pedyo nepakona yomukadzi uya,","poem":1},{"text":"richifamba rakananga kumba kwake,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"panguva yorubvunzavaeni,","poem":1},{"text":"zuva ravira, kunze kwosviba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ipapo mukadzi akabuda kuzosangana naye,","poem":1},{"text":"akapfeka sechifeve uye azere nounyengeri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anotaura noruzha uye anozvikudza,","poem":1},{"text":"tsoka dzake hadzigari pamba;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"imwe nguva ari munzira, imwe nguva ari pazvivara.","poem":1},{"text":"Anorindira pamakona ose.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akamubata ndokumutsvoda,","poem":1},{"text":"uye nechiso chisina nyadzi akati:","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ndine zvipiriso zvokuwadzana kumba kwangu;","poem":1},{"text":"nhasi ndazadzisa mhiko dzangu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Saka ndauya kuzosangana newe;","poem":1},{"text":"ndanga ndichikutsvaka, zvino ndazokuwana!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndawaridza mubhedha wangu machira ane mavara,","poem":1},{"text":"anobva kuIjipiti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndasasa zvinonhuhwira pamubhedha wangu, zvinoti:","poem":1},{"text":"mura, gavakava nesinamoni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uya, tinwe tigute norudo kusvikira mangwanani;","poem":1},{"text":"ngatifare zvedu norudo!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Murume wangu haako kumba,","poem":1},{"text":"akafamba rwendo rurefu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akatakura homwe yake izere nemari","poem":1},{"text":"uye haangadzoki kumba kusvikira pajenaguru.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Namashoko okunyengetedza akamutsausa;","poem":1},{"text":"akamukwezva nokutaura kwake kunonyengera.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Pakarepo akamutevera senzombe","poem":1},{"text":"inoenda kundobayiwa,","poem":2},{"text":"senondo inopinda mumusungo,","poem":1}]},{"type":"verse","number":23,"content":[{"text":"kusvikira museve wabaya chiropa chake,","poem":2},{"text":"seshiri inokurumidza kupinda muugombe,","poem":1},{"text":"asingazivi kuti zvichamuurayisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Saka zvino, vanakomana vangu, teererai kwandiri;","poem":1},{"text":"nyatsoteererai zvandinotaura.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Usarega mwoyo wako uchitsaukira kunzira dzake,","poem":1},{"text":"kana kurasikira pamakwara ake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Vazhinji vakakuvadzwa naye vakawisirwa pasi;","poem":1},{"text":"vaakauraya vakawanda kwazvo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Imba yake mugwagwa mukuru unoenda kuguva,","poem":1},{"text":"uchitungamirira kumakamuri orufu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}