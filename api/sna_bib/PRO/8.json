{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Kudana kwoUchenjeri"]},{"type":"verse","number":1,"content":[{"text":"Ko, uchenjeri hahudanidziri here?","poem":1},{"text":"Kunzwisisa hakusimudziri inzwi rako here?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Panzvimbo dzakakwirira panzira,","poem":1},{"text":"pamharadzano dzenzira, ndipo pahumire;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"parutivi rwamasuo okupinda muguta, pamikova,","poem":1},{"text":"hunodanidzirisa huchiti,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Kwamuri, imi varume, ndinodanidzira;","poem":1},{"text":"ndinosimudzira inzwi rangu kuvanhu vose.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Imi vasina mano, wanai uchenjeri;","poem":1},{"text":"imi mapenzi, wanai kunzwisisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Teererai, nokuti ndine zvinhu zvinokosha zvokutaura;","poem":1},{"text":"ndinozarura muromo wangu kuti nditaure zvakarurama.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Muromo wangu unotaura zvokwadi,","poem":1},{"text":"nokuti miromo yangu inovenga zvakaipa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mashoko ose omuromo wangu akarurama;","poem":1},{"text":"hapana kana rimwe rakakombama kana rakaipa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kune ane njere ose zvawo akarurama,","poem":1},{"text":"akarurama kuna avo vane zivo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sarudza kurayira kwangu panzvimbo yesirivha,","poem":1},{"text":"ruzivo panzvimbo yegoridhe rakaisvonaka,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"nokuti uchenjeri hunokosha kupfuura marubhi,","poem":1},{"text":"uye hapana chaungada chingaenzaniswa nahwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ini, uchenjeri ndinogara pamwe chete navakachenjera;","poem":1},{"text":"ndine ruzivo nenjere.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kutya Jehovha ndiko kuvenga zvakaipa;","poem":1},{"text":"ndinovenga kuzvikudza namanyawi,","poem":2},{"lineBreak":true},{"text":"maitiro akaipa nokutaura kunonyangadza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Zano nokutonga kwakanaka ndezvangu;","poem":1},{"text":"ndine kunzwisisa nesimba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Madzimambo anobata ushe neni","poem":1},{"text":"uye vatongi vanodzika mirayiro yakarurama;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"machinda anofambisa ushe neni,","poem":1},{"text":"navakuru vose vanotonga panyika.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndinoda avo vanondida,","poem":1},{"text":"uye vaya vanonditsvaka vanondiwana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pfuma nokukudzwa zvineni,","poem":1},{"text":"upfumi hunogara nokururama.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Chibereko changu chakanaka kupfuura goridhe rakaisvonaka;","poem":1},{"text":"zvandinobereka zvinopfuura sirivha yakaisvonaka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndinofamba munzira dzokururama,","poem":1},{"text":"pamakwara okururamisira,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ndichipa upfumi kuna avo vanondida,","poem":1},{"text":"uye ndichiita kuti matura avo azare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Jehovha akandibudisa sebasa rake rokutanga pamabasa ake,","poem":1},{"text":"kutangira mabasa ake akare;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ndakagadzwa kubva pakusingaperi,","poem":1},{"text":"kubva pakutanga, nyika isati yavapo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Makungwa asati avapo, ndakaberekwa,","poem":1},{"text":"pasati pava nezvitubu zvine mvura zhinji;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"makomo asati aiswa munzvimbo dzawo,","poem":1},{"text":"zvikomo zvisati zvavapo, ndakaberekwa,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"asati aita nyika neminda","poem":1},{"text":"kana guruva ripi zvaro renyika.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ndakanga ndiripo paakaisa matenga munzvimbo dzawo,","poem":1},{"text":"paakaita denderedzwa pamusoro pamakungwa,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"paakaita makore kudenga","poem":1},{"text":"uye paakasimbisa zvitubu zvamakungwa,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"paakapa gungwa miganhu yaro","poem":1},{"text":"kuti mvura dzirege kudarika zvaakarayira,","poem":2},{"text":"uye paakateya nheyo dzenyika.","poem":1}]},{"type":"verse","number":30,"content":[{"text":"Ipapo ndini ndaiva mhizha parutivi rwake.","poem":2},{"text":"Ndaigara ndichifara zuva nezuva,","poem":1},{"text":"ndichifara nguva dzose pamberi pake,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ndichifadzwa nenyika yake yose","poem":1},{"text":"uye ndichifadzwa navanhu vose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Saka zvino, vanakomana vangu, teererai kwandiri;","poem":1},{"text":"vakaropafadzwa avo vanochengeta nzira dzangu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Teererai kurayira kwangu mugova vakachenjera;","poem":1},{"text":"musakushayira hanya.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Akaropafadzwa munhu anoteerera kwandiri,","poem":1},{"text":"anorinda mazuva ose pamasuo angu.","poem":2},{"lineBreak":true},{"text":"Anomira pamukova womusuo wangu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Nokuti ani naani anondiwana anowana upenyu","poem":1},{"text":"uye anogamuchira nyasha kubva kuna Jehovha.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Asi ani naani asingandiwani anozvikuvadza;","poem":1},{"text":"vose vanondivenga vanoda rufu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}