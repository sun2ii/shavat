{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PRO","translationId":"sna_bib","name":"Zvirevo","commonName":"Zvirevo","title":"ZVIREVO","order":20,"numberOfChapters":31,"sha256":"7fb7835db0563b52d2833a344bc2298e35a32f6de16b105fb921141d6d7a2741","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sna_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Kukoka kwoUchenjeri nekwoUpenzi"]},{"type":"verse","number":1,"content":[{"text":"Uchenjeri hwakavaka imba yahwo;","poem":1},{"text":"hwakaveza mbiru dzahwo nomwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hwakabika nyama yahwo; uye hukagadzira waini yahwo;","poem":1},{"text":"hwakagadzirawo tafura yahwo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hwakatuma varandakadzi vahwo,","poem":1},{"text":"uye hunodanidzira kubva panzvimbo yakakwirira kwazvo yeguta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuna avo vanoshayiwa njere hunoti,","poem":1},{"text":"“Vose vasina uchenjeri ngavauye muno!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uyai, mudye zvokudya zvangu","poem":1},{"text":"munwe waini yandagadzira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Siyai nzira dzenyu dzisina mano mugorarama;","poem":1},{"text":"fambai munzira yokunzwisisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ani naani anorayira mudadi anozvitsvakira kutukwa;","poem":1},{"text":"ani naani anotsiura munhu akaipa anozviwanira kutukwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Usatsiura mudadi kuti arege kukuvenga;","poem":1},{"text":"tsiura munhu akachenjera uye achakuda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Rayira munhu akachenjera uye achawedzera uchenjeri hwake;","poem":1},{"text":"dzidzisa munhu akarurama uye achawedzera kudzidza kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Kutya Jehovha ndiwo mavambo ouchenjeri,","poem":1},{"text":"uye kuziva Iye Mutsvene ndiko kunzwisisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokuti neni mazuva ako achava mazhinji,","poem":1},{"text":"uye makore achawedzerwa kuupenyu hwako.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kana uri wakachenjera, uchenjeri hwako huchakupa mubayiro;","poem":1},{"text":"kana uri mudadi, iwe woga ndiwe uchatambura.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mukadzi benzi ane ruzha;","poem":1},{"text":"haana kudzikama uye haana zivo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anogara pamusuo wemba yake,","poem":1},{"text":"napachigaro chiri panzvimbo yakakwiririsa yeguta,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"achidanidzira kuna avo vanenge vachipfuura napo,","poem":1},{"text":"vaya vanofamba zvakarurama nenzira yavo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Anoti kuna vaya vasina njere,","poem":1},{"text":"“Vose vasina mano ngavauye muno!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mvura yakabiwa inozipa;","poem":1},{"text":"zvokudya zvinodyirwa muchivande zvinonaka!”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Asi zvavasingazivi ndezvokuti mune vakafa,","poem":1},{"text":"uye kuti vanomushanyira vari mukati kati meguva.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}