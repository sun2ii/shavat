{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Munomirireiko kure, imi Jehovha?","poem":1},{"text":"Munozvivanzireiko panguva yokutambudzika?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pakuzvikudza kwake munhu akaipa anovhima vasina simba,","poem":1},{"text":"vanobatwa namano okufunga kwake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anozvirumbidza pamusoro pezvinopangwa nomwoyo wake;","poem":1},{"text":"anoropafadza vanokara uye anozvidza Jehovha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pakuzvikudza kwake akaipa haamutsvaki;","poem":1},{"text":"mundangariro dzake dzose hamuna nzvimbo yaMwari.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nzira dzake dzinobudirira nguva dzose;","poem":1},{"text":"anozvikudza uye mirayiro yenyu iri kure naye;","poem":2},{"lineBreak":true},{"text":"anodadira vavengi vake vose.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anoti pakufunga kwake, “Hakuna chichandizungunusa;","poem":1},{"text":"ndichagara ndakafara uye handingatongotambudziki.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Muromo wake uzere nokutuka, kureva nhema, uye nokutyisidzira;","poem":1},{"text":"matambudziko nezvakaipa zviri pasi porurimi rwake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anovandira ari pedyo nemisha;","poem":1},{"text":"pakuvandira uku anouraya vasina mhosva,","poem":2},{"lineBreak":true},{"text":"ari panzvimbo yakavanzika anotarira vaachaparadza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anovandira seshumba iri panzvimbo yayo;","poem":1},{"text":"anovandira kuti abate vasina anovabatsira;","poem":2},{"lineBreak":true},{"text":"anobata vasina anobatsira uye anovakweva achienda navo mumumbure wake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vabatwa vake anovapwanya, vanowa;","poem":1},{"text":"vanowira pasi pesimba rake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anoti mumwoyo make, “Mwari akanganwa;","poem":1},{"text":"akafukidza chiso chake uye haazoonizve.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Simukai, imi Jehovha! Simudzai ruoko rwenyu, imi Mwari.","poem":1},{"text":"Regai kukanganwa vanomanikidzwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Munhu akaipa anozvidzireiko Mwari?","poem":1},{"text":"Seiko achiti mumwoyo make,","poem":2},{"lineBreak":true},{"text":"“Haazondibvunzi?”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Asi imi, iyemi Mwari, munoona kutambudzika nokusuwa;","poem":1},{"text":"munokutarisisa kuti mukupedze.","poem":2},{"text":"Asina simba anozviisa kwamuri;","poem":1},{"text":"muri mubatsiri wenherera.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vhunai ruoko rweakaipa nerwomunhu akaipa;","poem":1},{"text":"ngaazvidavirire pazvakaipa zvake","poem":2},{"lineBreak":true},{"text":"zvakanga zvisingazoonekwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Jehovha ndiye Mambo nokusingaperi-peri;","poem":1},{"text":"ndudzi dzichaparara munyika yake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Munonzwa henyu, imi Jehovha, zvishuvo zvavanotambura;","poem":1},{"text":"munovakurudzira, uye munoteerera kuchema kwavo,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"muchiruramisira nherera nevakamanikidzwa,","poem":1},{"text":"kuti munhu wenyika, arege kuramba achingovhundutsa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}