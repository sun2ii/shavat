{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["Pisarema rokuvonga."]},{"type":"verse","number":1,"content":[{"text":"Danidzirai nomufaro kuna Jehovha, imi nyika dzose.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Shumirai Jehovha nomufaro;","poem":2},{"lineBreak":true},{"text":"uyai pamberi pake nenziyo dzomufaro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zivai kuti Jehovha ndiye Mwari.","poem":1},{"text":"Ndiye akatisika, uye tiri vake;","poem":2},{"lineBreak":true},{"text":"tiri vanhu vake, namakwai anofudzwa naye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pindai pamasuo ake nokuvonga","poem":1},{"text":"nomuvanze dzake nokurumbidza;","poem":2},{"lineBreak":true},{"text":"chimuvongai uye murumbidze zita rake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nokuti Jehovha akanaka uye rudo rwake runogara nokusingaperi;","poem":1},{"text":"kutendeka kwake kunoramba kuripo kuzvizvarwa zvose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}