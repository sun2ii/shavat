{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndichaimba nezvorudo rwenyu nokururamisira kwenyu;","poem":1},{"text":"kwamuri, imi Jehovha, ndichaimba nziyo dzokurumbidza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichangwarira kurarama upenyu husina chahungapomerwa.","poem":1},{"text":"Muchauya riniko kwandiri?","poem":2},{"lineBreak":true},{"text":"Ndichafamba mumba mangu","poem":1},{"text":"nomwoyo usina chaungapomerwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Handingaisi chinhu chakaipa","poem":1},{"text":"pamberi pangu.","poem":2},{"lineBreak":true},{"text":"Ndinovenga mabasa avanhu vasingatendi;","poem":1},{"text":"haanganamatiri kwandiri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vanhu vane mwoyo yakatsauka vachava kure neni;","poem":1},{"text":"handichazovi nechokuita nechakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani naani anoitira muvakidzani wake makuhwa pakavanda,","poem":1},{"text":"iyeye ndiye wandichaita kuti anyarare;","poem":2},{"text":"ani naani ane meso anozvikudza nomwoyo unozvikudza,","poem":1},{"text":"iyeye handingamuregi akadaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Meso angu achava pamusoro pavakatendeka vari munyika,","poem":1},{"text":"kuti vagare neni;","poem":2},{"text":"iye ane mafambiro asina chaangapomerwa,","poem":1},{"text":"achandishumira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hakuna munhu anonyengera","poem":1},{"text":"achagara mumba mangu;","poem":2},{"text":"hakuna munhu anotaura nhema","poem":1},{"text":"achamira pamberi pangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mangwanani oga oga ndichaita kuti","poem":1},{"text":"vakaipa vose vari panyika vanyarare;","poem":2},{"text":"ndichauraya vaiti vezvakaipa vose,","poem":1},{"text":"vabve muguta raJehovha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}