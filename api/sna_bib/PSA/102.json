{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"hebrew_subtitle","content":["Munyengetero womunhu anotambudzika. Paanenge aziya uye odurura kuchema kwake pamberi paJehovha."]},{"type":"verse","number":1,"content":[{"text":"Inzwai munyengetero wangu, imi Jehovha;","poem":1},{"text":"kuchemera kwangu rubatsiro ngakusvike kwamuri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Regai kundivanzira chiso chenyu","poem":1},{"text":"pandinenge ndichitambudzika.","poem":2},{"text":"Rerekerai nzeve yenyu kwandiri;","poem":1},{"text":"pandinokudanai, ndipindurei nokukurumidza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nokuti mazuva angu anopera soutsi;","poem":1},{"text":"mapfupa angu anopisa samazimbe anopfuta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwoyo wangu warohwa uye waoma souswa;","poem":1},{"text":"ndinokanganwa kudya zvokudya zvangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nokuda kwokugomera kwangu","poem":1},{"text":"kukuru ndaonda zvokuti ganda rangu ranamatira pamapfupa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndafanana nezizi romugwenga,","poem":1},{"text":"sezizi riri pakati pamatongo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndinovata ndakasvinura,","poem":1},{"text":"ndava seshiri iri yoga pamusoro pedenga remba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zuva rose vavengi vangu vanondishungurudza;","poem":1},{"text":"avo vanondipengera vanoshandisa zita rangu sechituko.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuti ndinodya madota sechokudya changu,","poem":1},{"text":"uye ndinovhenganisa zvokunwa zvangu nemisodzi,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"nokuda kwehasha dzenyu huru,","poem":1},{"text":"nokuti makandisimudza mukandikanda parutivi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mazuva angu akaita somumvuri wamadekwana;","poem":1},{"text":"ndinosvava souswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Asi imi, iyemi Jehovha, munogara pachigaro choushe nokusingaperi;","poem":1},{"text":"mukurumbira wenyu uripo kusvikira kuzvizvarwa zvose.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Imi muchasimuka mugonzwira Zioni tsitsi,","poem":1},{"text":"nokuti ndiyo nguva yokurinzwira nyasha;","poem":2},{"lineBreak":true},{"text":"nguva yakatarwa yasvika.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nokuti matombo aro anokosha kuvaranda venyu;","poem":1},{"text":"guruva raro chairo rinovaendesa kugomba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndudzi dzichatya zita raJehovha,","poem":1},{"text":"madzimambo ose enyika achatya kubwinya kwenyu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nokuti Jehovha achavakazve Zioni,","poem":1},{"text":"agozviratidza pakubwinya kwake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Achadavira minyengetero yavanotambura;","poem":1},{"text":"haangazvidzi chikumbiro chavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Izvi ngazvinyorerwe zvizvarwa zvamangwana,","poem":1},{"text":"kuti vanhu vasati vasikwa vagorumbidza Jehovha vachiti,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“Jehovha akatarira pasi ari panzvimbo yake tsvene yakakwirira,","poem":1},{"text":"ari kudenga akacherechedza pasi,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kuti anzwe kugomera kwavasungwa","poem":1},{"text":"agosunungura avo vakatongerwa rufu.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Saka zita raJehovha richaparidzwa muZioni,","poem":1},{"text":"nokurumbidzwa kwake muJerusarema,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"panoungana marudzi noushe","poem":1},{"text":"kuti vanamate Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Panguva youpenyu hwangu akatapudza simba rangu;","poem":1},{"text":"akaita kuti mazuva angu ave mashoma.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Saka ndakati,","poem":1},{"text":"“Regai kundibvisa, imi Mwari wangu, pakati pamazuva angu;","poem":2},{"lineBreak":true},{"text":"makore enyu anoramba aripo kusvikira kuzvizvarwa zvose.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Pamavambo makateya nheyo dzenyika,","poem":1},{"text":"uye matenga ibasa basa ramaoko enyu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Izvo zvichaparara, asi imi munogara muripo;","poem":1},{"text":"zvose zvichasakara senguo. Senguo muchavabvisa uye vacharaswa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Asi imi mucharamba makadaro,","poem":1},{"text":"uye makore enyu haatongogumi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Vana vavaranda venyu vachagara pamberi penyu;","poem":1},{"text":"zvizvarwa zvavo zvichasimbiswa pamberi penyu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}