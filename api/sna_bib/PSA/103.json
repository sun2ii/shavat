{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":103,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Rumbidza Jehovha, iwe mweya wangu;","poem":1},{"text":"zvose zviri mukati mangu, ngazvirumbidze zita rake dzvene.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rumbidza Jehovha, iwe mweya wangu,","poem":1},{"text":"uye urege kukanganwa mikomborero yake yose,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"iye anokanganwira zvivi zvako zvose,","poem":1},{"text":"uye anoporesa kurwara kwako kwose,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"anodzikinura upenyu hwako kubva pagomba,","poem":1},{"text":"uye anokushongedza korona yorudo netsitsi,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"anogutsa zvido zvako nezvinhu zvakanaka,","poem":1},{"text":"kuti uduku hwako huvandudzwe sohwegondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jehovha anoita zvakarurama,","poem":1},{"text":"uye anoruramisira vose vakadzvinyirirwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Akazivisa nzira dzake kuna Mozisi,","poem":1},{"text":"namabasa ake kuvanhu veIsraeri:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jehovha ane tsitsi nenyasha,","poem":1},{"text":"anononoka kutsamwa, azere norudo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haangarambi achipomera mhosva,","poem":1},{"text":"uye haangarambi akatsamwa nokusingaperi;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"haatiitiri sezvakafanira zvivi zvedu,","poem":1},{"text":"kana kutipa mubayiro sezvakafanira zvakaipa zvedu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokuti sokukwirira kwaakaita kudenga kumusoro kwenyika,","poem":1},{"text":"ndizvo zvakaita kukura kworudo rwake kuna vanomutya;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"sokuva kure kwamabvazuva namavirira,","poem":1},{"text":"saizvozvo akabvisa kudarika kwedu kwatiri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sokunzwira tsitsi kunoita baba vana vavo,","poem":1},{"text":"saizvozvo Jehovha ane tsitsi pamusoro pavanomutya;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nokuti anoziva kuti takaumbwa sei,","poem":1},{"text":"anorangarira kuti tiri guruva.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kana ari munhu zvake, mazuva ake akaita souswa,","poem":1},{"text":"anokura seruva resango;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"mhepo inorova napamusoro paro onei raenda,","poem":1},{"text":"uye nzvimbo yaranga riri haicharirangaririzve.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Asi kubva pakusingaperi kusvikira pakusingaperi,","poem":1},{"text":"rudo rwaJehovha rwuri pane avo vanomutya,","poem":2},{"lineBreak":true},{"text":"nokururama kwake kuvana vavana vavo,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"naavo vanochengeta sungano yake","poem":1},{"text":"uye vanorangarira kuita zvaakatema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Jehovha akasimbisa chigaro chake choushe kudenga,","poem":1},{"text":"uye ushe hwake hunotonga zvinhu zvose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Rumbidzai Jehovha, imi vatumwa vake,","poem":1},{"text":"nemi vane simba vanoita zvaakarayira,","poem":2},{"lineBreak":true},{"text":"vanoteerera shoko rake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Rumbidzai Jehovha, imi hondo dzose dzokudenga,","poem":1},{"text":"imi varanda vake vanoita kuda kwake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Rumbidzai Jehovha, imi mabasa ake ose","poem":1},{"text":"kwose kwose kuno umambo hwake.","poem":2},{"lineBreak":true},{"text":"Rumbidza Jehovha, mweya wangu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}