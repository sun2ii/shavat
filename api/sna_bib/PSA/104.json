{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"Rumbidza Jehovha, mweya wangu.","poem":1},{"lineBreak":true},{"text":"Haiwa Jehovha Mwari wangu, muri mukuru kwazvo; makashongedzwa nokubwinya noumambo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iye anozviputira muchiedza seanozviputira nenguo;","poem":1},{"text":"anotatamura matenga kunge tende","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"uye anogadzika matanda edzimba dzake dzapamusoro pamusoro pemvura yadzo zhinji.","poem":2},{"text":"Anoita makore ngoro dzake,","poem":1},{"text":"uye anokwira pamapapiro emhepo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anoita mhepo nhume dzake,","poem":1},{"text":"namazhenje omoto varanda vake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Akamisa nyika pamusoro penheyo dzayo;","poem":1},{"text":"haingatongozungunuswi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Makaifukidza nokwakadzika somunofukidza nenguo;","poem":1},{"text":"mvura zhinji yakamira pamusoro pamakomo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asi pakutsiura kwenyu mvura zhinji yakatiza,","poem":1},{"text":"pakunzwa kutinhira wenyu yakatiza;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"yakayerera napamusoro pamakomo,","poem":1},{"text":"ikadzika nomumipata,","poem":2},{"lineBreak":true},{"text":"ichienda kunzvimbo yamakairayira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makatara muganhu waisingadariki;","poem":1},{"text":"haichazombofukidzizve nyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Anoita kuti matsime adire mvura mumipata;","poem":1},{"text":"inoyerera napakati pamakomo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anonwisa mhuka dzose dzesango mvura;","poem":1},{"text":"mbizi dzinopedza nyota yadzo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Shiri dzedenga dzinovaka matendere adzo pedyo nemvura;","poem":1},{"text":"dzinorira dziri pakati pamatavi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anodiridza makomo ari padzimba dzake dzapamusoro;","poem":1},{"text":"nyika inogutswa nezvibereko zvebasa rake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anomeresa uswa hwemombe,","poem":1},{"text":"nembeu kuti vanhu vasakure,","poem":2},{"lineBreak":true},{"text":"achibudisa zvokudya kubva pasi:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"iyo waini inofadza mwoyo womunhu,","poem":1},{"text":"namafuta anopenyesa chiso chake,","poem":2},{"lineBreak":true},{"text":"nechingwa chinosimbisa mwoyo wake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Miti yaJehovha inodiridzwa zvakanaka,","poem":1},{"text":"iyo misidhari yeRebhanoni yaakasima.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shiri dzinoruka matendere adzo ipapo;","poem":1},{"text":"dambiramurove rakaita imba yaro mumiti yomupaini.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Makomo marefu ndeengururu;","poem":1},{"text":"mapako ndiwo utiziro hwembira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mwedzi unotara nguva,","poem":1},{"text":"uye zuva rinoziva nguva yokuvira kwaro.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Munouyisa rima, usiku hugovapo,","poem":1},{"text":"uye zvikara zvose zvesango zvinobuda kundovhima.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Shumba dzinoomba dzichitsvaka nyama,","poem":1},{"text":"uye dzinotsvaka zvokudya zvadzo kubva kuna Mwari.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kana zuva robuda, idzo dzinoenda kure;","poem":1},{"text":"dzinodzokera dzondovata mumapako adzo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ipapo munhu anobuda oenda kubasa rake,","poem":1},{"text":"kumushando wake kusvikira madekwana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Haiwa Jehovha, mabasa enyu manganiko!","poem":1},{"text":"Makaaita ose nenjere;","poem":2},{"lineBreak":true},{"text":"nyika izere nezvisikwa zvenyu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hero gungwa, rakakura uye rakapamhama,","poem":1},{"text":"rine zvisikwa zvisingagoni kuverengwa,","poem":2},{"lineBreak":true},{"text":"zvipenyu zvikuru nezviduku.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hezvo zvikepe zvinofamba-famba, nengwena,","poem":1},{"text":"yamakaumba kuti itambemo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Zvose izvi zvinotarira kwamuri","poem":1},{"text":"kuti muzvipe zvokudya zvazvo nenguva yakafanira.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Pamunozvipa, zvinozviunganidza;","poem":1},{"text":"pamunozarura ruoko rwenyu, izvo zvinogutswa nezvinhu zvakanaka.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Pamunovanza chiso chenyu,","poem":1},{"text":"izvo zvinovhundutswa;","poem":2},{"text":"pamunozvitorera mweya,","poem":1},{"text":"izvo zvinofa uye zvinodzokera kuguruva.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Pamunotuma Mweya wenyu,","poem":1},{"text":"izvo zvinosikwa,","poem":2},{"lineBreak":true},{"text":"uye munovandudza chiso chenyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Kubwinya kwaJehovha ngakugare nokusingaperi;","poem":1},{"text":"Jehovha ngaafare nebasa rake,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"iye anotarira nyika, yobva yabvunda,","poem":1},{"text":"iye anobata makomo obva apwititika utsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ndichaimbira Jehovha upenyu hwangu hwose;","poem":1},{"text":"ndichaimbira Mwari wangu nziyo dzokurumbidza ndichiri mupenyu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kurangarira kwangu ngakumufadze,","poem":1},{"text":"pandinofara muna Jehovha.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Asi vatadzi ngavaparadzwe panyika,","poem":1},{"text":"uye vakaipa ngavarege kuzovapozve.","poem":2},{"lineBreak":true},{"text":"Rumbidza Jehovha, mweya wangu.","poem":1},{"lineBreak":true},{"text":"Rumbidzai Jehovha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}