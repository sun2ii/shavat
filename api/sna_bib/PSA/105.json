{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"Vongai Jehovha, danai kuzita rake;","poem":1},{"text":"zivisai zvaakaita pakati pendudzi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muimbirei, muimbirei nziyo dzokurumbidza;","poem":1},{"text":"rondedzerai mabasa ake ose anoshamisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngarikudzwe zita rake dzvene;","poem":1},{"text":"mwoyo yavanotsvaka Jehovha ngaifare.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tarirai kuna Jehovha nokusimba rake;","poem":1},{"text":"tsvakai chiso chake nguva dzose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rangarirai zvishamiso zvaakaita,","poem":1},{"text":"mabasa ake, nezvaakatonga zvaakareva,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"imi vana vaAbhurahama muranda wake,","poem":1},{"text":"haiwa vanakomana vaJakobho, vasanangurwa vake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndiye Jehovha Mwari wedu;","poem":1},{"text":"kutonga kwake kuri munyika yose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Anorangarira sungano yake nokusingaperi,","poem":1},{"text":"iro shoko raakarayira, kuchiuru chezvizvarwa,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"sungano yaakaita naAbhurahama,","poem":1},{"text":"mhiko yaakapika kuna Isaka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akaisimbisa kuna Jakobho somutemo,","poem":1},{"text":"nokuna Israeri sesungano isingaperi achiti,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Ndichapa nyika yeKenani kwauri","poem":1},{"text":"somugove wenhaka yako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Pavaiva vashoma pakuwanda,","poem":1},{"text":"zvirokwazvo vari vashoma, uye vari vaeni mairi,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"vakadzungaira vachibva kuno rumwe rudzi kusvikira kuno rumwe rudzi.","poem":1},{"text":"Kubva kuno humwe ushe vachienda kuno humwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Haana kutendera munhu kuvadzvinyirira;","poem":1},{"text":"akatuka madzimambo nokuda kwavo achiti,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Musabata vazodziwa vangu;","poem":1},{"text":"musaitira vaprofita vangu zvakaipa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Akadana nzara panyika","poem":1},{"text":"ikaparadza zvose zvaiuyisa zvokudya;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"uye akatuma munhu pamberi pavo,","poem":1},{"text":"iye Josefa, akatengeswa senhapwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vakakuvadza tsoka dzake nezvisungo","poem":1},{"text":"mutsipa wake ukaiswa mumatare esimbi,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kusvikira zvaakareva zvazadziswa,","poem":1},{"text":"kusvikira shoko raJehovha raratidza kutendeka kwake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mambo akatuma shoko kuti asunungurwe,","poem":1},{"text":"vatongi vavanhu vakamuregedza.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Akamuita tenzi weimba yake,","poem":1},{"text":"nomutongi wepfuma yake yose,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kuti arayire machinda ake sezvaaida","poem":1},{"text":"uye adzidzise vakuru vake njere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ipapo Israeri akapinda muIjipiti;","poem":1},{"text":"Jakobho akagara somweni munyika yaHamu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Jehovha akawanza vanhu vake chose;","poem":1},{"text":"akavaita vazhinji kwazvo kupinda vavengi vavo,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"avo vaakashandura mwoyo yavo kuti ivenge vanhu vake,","poem":1},{"text":"kuti varangane pamusoro pavaranda vake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Akatuma Mozisi muranda wake,","poem":1},{"text":"naAroni, waakanga asarudza.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Vakaita zviratidzo zvinoshamisa pakati pavo,","poem":1},{"text":"izvo zvishamiso zvake munyika yaHamu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Akatumira rima akaita kuti nyika ive murima,","poem":1},{"text":"nokuti havana kumukira shoko rake here?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Akashandura mvura yavo zhinji ikava ropa,","poem":1},{"text":"zvikaita kuti hove dzavo dzife.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nyika yavo yakazara namatatya,","poem":1},{"text":"akapinda mudzimba dzamadzimambo avo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Akataura mapupira enhunzi akauya,","poem":1},{"text":"nenda munyika yavo yose.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Akashandura mvura yavo ikava chimvuramabwe,","poem":1},{"text":"nemheni munyika yavo yose;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"akarova mizambiringa yavo nemionde yavo,","poem":1},{"text":"akaparadza miti yomunyika yavo.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Akataura, mhashu dzikauya,","poem":1},{"text":"namagutaguta asingaverengeki;","poem":2}]},{"type":"verse","number":35,"content":[{"text":"zvakadya miriwo minyoro yose munyika yavo,","poem":1},{"text":"zvikadya zvibereko zvevhu ravo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ipapo akarova matangwe munyika yavo,","poem":1},{"text":"zvibereko zvokutanga zvesimba roujaya hwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Akabudisa Israeri akaremerwa nesirivha negoridhe,","poem":1},{"text":"kwakanga kusina akagumburwa pakati pamarudzi avo.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ijipiti yakafara pavakabva,","poem":1},{"text":"nokuti kutya vaIsraeri kwakanga kwavabata.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Akatatamura gore rikava chifukidzo,","poem":1},{"text":"uye moto kuti uvhenekere usiku.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Vakakumbira, iye akavauyisira zvihuta, uye akavagutsa nechingwa chakabva kudenga.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Akazarura dombo, mvura ikatubuka;","poem":1},{"text":"ikayerera mugwenga sorwizi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"Nokuti akarangarira mhiko yake tsvene","poem":1},{"text":"yaakapa Abhurahama muranda wake.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Akabudisa vanhu vake nomufaro,","poem":1},{"text":"vasanangurwa vake nokupembera kwomufaro;","poem":2}]},{"type":"verse","number":44,"content":[{"text":"akavapa nyika dzendudzi,","poem":1},{"text":"vakagara nhaka yakanga yatamburirwa navamwe,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"kuti vachengete zvaakatema","poem":1},{"text":"uye vacherechedze mirayiro yake.","poem":2},{"lineBreak":true},{"text":"Rumbidzai Jehovha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}