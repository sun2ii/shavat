{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"Rumbidzai Jehovha.","poem":1},{"lineBreak":true},{"text":"Vongai Jehovha, nokuti akanaka;","poem":1},{"text":"nokuti rudo rwake runogara nokusingaperi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndianiko angaparidza mabasa aJehovha esimba,","poem":1},{"text":"kana kureva kurumbidzwa kwake kwose?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vakaropafadzwa vanochengeta kururamisira,","poem":1},{"text":"vanogara vachiita zvakarurama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndirangarirei, imi Jehovha, pamunoratidza nyasha kuvanhu venyu,","poem":1},{"text":"pamunovaponesa, mundibatsirewo,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"kuti ndifadzwe nokubudirira kwavasanangurwa venyu,","poem":1},{"text":"kuti ndigovane pamufaro wavanhu venyu,","poem":2},{"lineBreak":true},{"text":"uye ndibatane nenhaka yenyu pakurumbidza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Takatadza, sezvakaita madzibaba edu;","poem":1},{"text":"takaita zvakaipa uye takaita mabasa akaipa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Madzibaba edu paakanga ari muIjipiti,","poem":1},{"text":"havana kumbofunga nezvezvishamiso zvenyu;","poem":2},{"text":"havana kurangarira tsitsi dzenyu zhinji,","poem":1},{"text":"asi vakakumukirai pagungwa, iro Gungwa Dzvuku.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kunyange zvakadaro akavaponesa nokuda kwezita rake,","poem":1},{"text":"kuti simba rake guru rizivikanwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akarayira Gungwa Dzvuku iro rikapwa;","poem":1},{"text":"uye akavafambisa napakadzika sevanopfuura nomugwenga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akavaponesa kubva muruoko rwomuvengi;","poem":1},{"text":"akavadzikinura kubva muruoko rwomuvengi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mvura zhinji yakafukidza vadzivisi vavo;","poem":1},{"text":"hakuna mumwe wavo akapona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ipapo vakatenda vimbiso dzake","poem":1},{"text":"vakaimba vachimurumbidza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Asi vakakurumidza kukanganwa zvaakanga aita,","poem":1},{"text":"uye vakasamirira kurayira kwake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Havana kuzvidzora pakukara kwavo mugwenga;","poem":1},{"text":"vakaedza Mwari murenje.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Saka akavapa zvavakakumbira,","poem":1},{"text":"asi akatuma chirwere chinopedza muviri pamusoro pavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Vakaitira Mozisi godo mumusasa,","poem":1},{"text":"naAroni, akanga akatsaurirwa kuna Jehovha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nyika yakazaruka ikamedza Dhatani;","poem":1},{"text":"ikaviga boka raAbhiramu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Moto wakapfuta pakati pavateveri vavo;","poem":1},{"text":"murazvo ukaparadza vakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Vakaumba mhuru paHorebhi,","poem":1},{"text":"vakanamata chifananidzo chakaumbwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Vakatsinhanisa kubwinya kwavo","poem":1},{"text":"nomufananidzo wehando, inodya uswa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vakakanganwa Mwari akavaponesa,","poem":1},{"text":"uyo akanga aita zvinhu zvikuru muIjipiti,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"mabasa anoshamisa munyika yaHamu","poem":1},{"text":"namabasa anotyisa paGungwa Dzvuku.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Saka akati, achavaparadza,","poem":1},{"text":"dai Mozisi, musanangurwa wake,","poem":2},{"text":"asina kumira pamberi pake kuti","poem":1},{"text":"adzore hasha dzake pakuvaparadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ipapo vakazvidza nyika inofadza;","poem":1},{"text":"havana kutenda zvaakavimbisa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Vakanyunyuta vari mumatende","poem":1},{"text":"avo vakasateerera Jehovha.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Saka akapika akasimudza ruoko rwake","poem":1},{"text":"kuti achavaparadza murenje,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"achaparadza zvizvarwa zvavo pakati pendudzi,","poem":1},{"text":"agovaparadzira munyika dzose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Vakazvibatanidza pamwe chete naBhaari wePeori,","poem":1},{"text":"uye vakadya zvibayiro zvakabayirwa vamwari vakafa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Vakatsamwisa Jehovha namabasa avo akaipa,","poem":1},{"text":"uye denda rikavapo pakati pavo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Asi Finehasi akasimuka,","poem":1},{"text":"akaita zvakarurama, denda rikaguma.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Izvozvo zvakanzi kwaari kururama","poem":1},{"text":"kusvikira kuzvizvarwa nezvizvarwa nokusingaperi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Vakatsamwisa Jehovha pamvura zhinji yeMeribha,","poem":1},{"text":"uye Mozisi akaoneswa nhamo nokuda kwavo;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"nokuti vakamukira Mweya waMwari,","poem":1},{"text":"Mozisi akataura nehasha nomuromo wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Havana kuparadza marudzi","poem":1},{"text":"sokurayirwa kwavakaitwa naJehovha,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"asi vakavhengana nendudzi,","poem":1},{"text":"vakatora tsika dzavo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Vakanamata zvifananidzo zvavo,","poem":1},{"text":"izvo zvakazova musungo kwavari.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Vakabayira vanakomana vavo","poem":1},{"text":"navanasikana vavo kumadhimoni.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Vakateura ropa risina mhosva,","poem":1},{"text":"iro ropa ravanakomana vavo neravanasikana vavo,","poem":2},{"text":"vavakabayira kuzvifananidzo zveKenani,","poem":1},{"text":"nyika ikasvibiswa neropa ravo.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Vakazvisvibisa nezvavakaita;","poem":1},{"text":"vakazviitisa ufeve namabasa avo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Naizvozvo Jehovha akatsamwira vanhu vake,","poem":1},{"text":"akasema nhaka yake.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Akavaisa mumaoko endudzi,","poem":1},{"text":"uye vakatongwa navavengi vavo.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Vavengi vavo vakavadzvinyirira,","poem":1},{"text":"uye vakavaisa pasi pesimba ravo.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Akavarwira kakawanda,","poem":1},{"text":"asi ivo vakanga vakarerekera pakumumukira","poem":2},{"lineBreak":true},{"text":"vakaparadzwa muchivi chavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Asi akatarisa kutambudzika kwavo","poem":1},{"text":"paakanzwa kuchema kwavo;","poem":2}]},{"type":"verse","number":45,"content":[{"text":"akarangarira sungano yake nokuda kwavo,","poem":1},{"text":"uye akazvidemba nokuda kworudo rwake rukuru.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Akaita kuti vanzwirwe","poem":1},{"text":"tsitsi navose vakavatapa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Tiponesei, imi Jehovha Mwari wedu,","poem":1},{"text":"uye mutiunganidze kubva kundudzi,","poem":2},{"text":"kuti tigovonga zita renyu dzvene.","poem":1},{"text":"Tigofara mukurumbidzwa kwenyu.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Jehovha ngaarumbidzwe, iye Mwari waIsraeri,","poem":1},{"text":"kubva pakusingaperi kusvikira pakusingaperi.","poem":2},{"text":"Vanhu vose ngavati, “Ameni!”","poem":1},{"lineBreak":true},{"text":"Rumbidzai Jehovha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}