xt":"akavarwira pakutambura kwavo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akavafambisa nenzira yakarurama","poem":1},{"text":"kuenda kuguta ravaizogara.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanhu ngavavonge Jehovha nokuda kworudo rwake rusingaperi,","poem":1},{"lineBreak":true},{"text":"uye nokuda kwamabasa anoshamisa aakavaitira,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"nokuti anogutsa vane nyota,","poem":1},{"text":"uye vane nzara anovazadza nezvakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vamwe vakagara murima nokusurikirwa kwakadzama,","poem":1},{"text":"vari vasungwa vanotambudzika muzvisungo zvamatare,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"nokuti vakanga vamukira mashoko aMwari","poem":1},{"text":"uye vakazvidza kurayira kweWokumusoro-soro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Saka akaita kuti vashande zvinorwadza;","poem":1},{"text":"vakagumburwa, uye pakanga pasina anovabatsira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ipapo vakachema kuna Jehovha pakutambudzika kwavo,","poem":1},{"text":"uye akavaponesa pakutambura kwavo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akavabudisa murima nomukusviba kwakadzika dzika,","poem":1},{"text":"uye akadambura ngetani dzavo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vanhu ngavavonge Jehovha nokuda kworudo rwake rusingaperi,","poem":1},{"text":"uye namabasa ake anoshamisa aakavaitira,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"nokuti anopwanya masuo endarira,","poem":1},{"text":"uye akagura mazariro esimbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Vamwe vakava mapenzi nokuda kwenzira dzavo dzokumukira,","poem":1},{"text":"uye vakatambudzwa kwazvo nokuda kwezvakaipa zvavo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vakasema zvokudya zvose,","poem":1},{"text":"uye vakaswedera pamasuo orufu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ipapo vakachema kuna Jehovha pakutambudzika kwavo,","poem":1},{"text":"uye akavaponesa pakutambura kwavo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akatuma shoko rake uye akavaporesa;","poem":1},{"text":"akavanunura kubva paguva.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vanhu ngavavonge Jehovha nokuda kworudo rwake rusingaperi,","poem":1},{"text":"uye namabasa ake anoshamisa aakavaitira.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ngavabayire zvibayiro zvokuvonga,","poem":1},{"text":"uye vareve zvamabasa ake nenziyo dzomufaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Vamwe vakafamba rwendo pagungwa nezvikepe;","poem":1},{"text":"vakanga vari vashambadziri pamvura zhinji.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Vakaona mabasa aJehovha,","poem":1},{"text":"mabasa ake anoshamisa pakadzika.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nokuti akataura uye akamutsa dutu","poem":1},{"text":"rikasimudza mafungu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Vakaenda kumusoro kumatenga vakaendawo pasi kwakadzika;","poem":1},{"text":"mukutambudzika kwavo kushinga kwavo kwakanyongodeka.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Vakandeya vakadzedzereka savanhu vadhakwa; vakasvika pakupererwa namazano.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ipapo vakachema kuna Jehovha pakutambudzika kwavo,","poem":1},{"text":"uye akavabudisa pakutambura kwavo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Akanyaradza dutu remhepo nezevezeve;","poem":1},{"text":"mafungu egungwa akanyarara kuti mwiro.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Vakafara parakadzikama,","poem":1},{"text":"uye akavatungamirira kwakachengetedzeka kwavaida.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Vanhu ngavavonge Jehovha nokuda kworudo rwake rusingaperi,","poem":1},{"text":"uye namabasa ake anoshamisa aakaitira vanhu.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngavamukudze paungano yavanhu,","poem":1},{"text":"uye vamurumbidze pagungano ramakurukota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Akashandura nzizi dzikava gwenga,","poem":1},{"text":"hova dzinoerera dzikava nyika ine nyota,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"uye nyika yezvibereko ikava gwenga romunyu,","poem":1},{"text":"nokuda kwezvakaipa zvavaigaramo.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Akashandura gwenga rikava madziva emvura,","poem":1},{"text":"nenyika yakaoma ikava zvitubu zvinoerera;","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ndipo paakagarisa vane nzara,","poem":1},{"text":"uye vakavaka guta ravangagara.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Vakadyara minda, uye vakasima minda yemizambiringa,","poem":1},{"text":"ikabereka mukohwo wakanaka;","poem":2}]},{"type":"verse","number":38,"content":[{"text":"akavaropafadza, uye akavawanza zvikuru,","poem":1},{"text":"uye haana kutendera zvipfuwo zvavo kuparara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Ipapo vakava vashoma, uye vakaninipiswa vakadzvinyirirwa,","poem":1},{"text":"nenjodzi uye nokusuwa;","poem":2}]},{"type":"verse","number":40,"content":[{"text":"iye anodurura kuzvidzwa pamusoro pamakurukota,","poem":1},{"text":"akaita kuti vadzungaire musango risina nzira.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Akasimudza vanoshayiwa kubva mukutambudzika kwavo,","poem":1},{"text":"uye akawedzera mhuri dzavo samapoka amakwai.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Vakarurama vanozviona vagofara,","poem":1},{"text":"asi vakaipa vose vanodzivirwa miromo yavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Ani naani akachenjera ngaachengete zvinhu izvi,","poem":1},{"text":"uye arangarire rudo rukuru rwaJehovha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}