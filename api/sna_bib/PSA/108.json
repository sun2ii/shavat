{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["Rwiyo. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Mwoyo wangu wakasimba, Mwari imi;","poem":1},{"text":"ndichaimba uye ndichaimba zvakanaka nomwoyo wangu wose.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muka iwe mutengeranwa nembira!","poem":1},{"text":"Ndichamutsa mambakwedza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Haiwa Jehovha ndichakurumbidzai pakati pendudzi; ndichaimba nezvenyu pakati pamarudzi.","poem":1},{"text":"Kutendeka kwenyu kunosvika kumatenga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nokuti rudo rwenyu rukuru,","poem":1},{"text":"kupfuura kudenga denga;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kudzwai, imi Mwari, kumusoro kwokudenga,","poem":1},{"text":"uye kurumbidzwa kwenyu ngakuve pamusoro penyika yose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tiponesei uye mutibatsire noruoko rwenyu rworudyi,","poem":1},{"text":"kuti vamunoda varwirwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mwari akataura ari panzvimbo yake tsvene achiti,","poem":1},{"text":"“Pakukunda kwangu ndichaganhura Shekemu,","poem":2},{"lineBreak":true},{"text":"uye ndigoyera Mupata weSukoti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gireadhi ndeyangu, Manase ndowangu;","poem":1},{"text":"Efuremu inguwani yangu,","poem":2},{"lineBreak":true},{"text":"Judha itsvimbo yangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moabhu ndiwo mudziyo wangu wokugezera,","poem":1},{"text":"pamusoro paEdhomu ndichapotsera shangu dzangu;","poem":2},{"lineBreak":true},{"text":"pamusoro paFiristia ndichapembera mukukunda.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndianiko achandiuyisa muguta rakakomberedzwa namasvingo?","poem":1},{"text":"Ndianiko achanditungamirira kuEdhomu?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ko, hamusimi here, imi Mwari, iyemi makatiramba","poem":1},{"text":"uye mukasazobudazve kuenda nehondo dzedu?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tibatsirei pamuvengi wedu,","poem":1},{"text":"nokuti rubatsiro rwomunhu haruna maturo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tichapiwa kukunda naMwari,","poem":1},{"text":"uye achatsika-tsika vavengi vedu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}