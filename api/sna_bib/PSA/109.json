{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":109,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Mwari, imi wandinorumbidza,","poem":1},{"text":"regai kunyarara,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"nokuti vanhu vakaipa vanonyengera vakandishamira miromo yavo;","poem":1},{"text":"vakataura nhema pamusoro pangu nendimi dzavo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vakandikomba namashoko okuvenga;","poem":1},{"text":"vanorwa neni pasina mhosva.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pachinzvimbo choushamwari hwangu navo, vanondipa mhosva,","poem":1},{"text":"asi ini ndiri munhu wokunyengetera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vanonditsivira zvakaipa pane zvakanaka,","poem":1},{"text":"uye vanondivengera ushamwari hwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tumai munhu akaipa kuti apikisane naye;","poem":1},{"text":"mupomeri ngaamire kuruoko rwake rworudyi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Paanotongwa, ngaawanikwe ane mhosva,","poem":1},{"text":"uye minyengetero yake ngaimupe mhaka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mazuva ake ngaave mashoma;","poem":1},{"text":"mumwe ngaatore nzvimbo youkuru hwake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vana vake ngavave nherera,","poem":1},{"text":"uye mukadzi wake ave chirikadzi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vana vake ngavave vapemhi vanodzungaira;","poem":1},{"text":"ngavadzingwe vabve mumatongo emisha yavo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waakakwereta ngaatore zvose zvaanazvo;","poem":1},{"text":"vatorwa ngavapambe zvose zvaakashandira.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngakurege kuva neanomunzwira ngoni","poem":1},{"text":"kana kunzwira tsitsi nherera dzake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zvizvarwa zvake ngazvirove,","poem":1},{"text":"mazita avo adzimwe parudzi runotevera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mhosva yamadzibaba ake ngairangarirwe pamberi paJehovha;","poem":1},{"text":"chivi chamai vake ngachirege kumbodzimwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zvivi zvavo ngazvirambe zviri pamberi paJehovha,","poem":1},{"text":"kuti aparadze chirangaridzo chavo panyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nokuti haana kumbofunga kuita zvakanaka,","poem":1},{"text":"asi akavhima varombo kusvika parufu,","poem":2},{"lineBreak":true},{"text":"vanoshayiwa navane mwoyo yakaputsika.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aifarira kutaura chituko, ngachichiuya pamusoro pake;","poem":1},{"text":"iye asina kufadzwa nokuropafadza, ngakuve kure naye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Aifuka kutuka senguo yake;","poem":1},{"text":"zvakapinda mumuviri wake semvura,","poem":2},{"lineBreak":true},{"text":"nomumapfupa ake samafuta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngazvive sejasi rakamonerwa paari,","poem":1},{"text":"sebhanhire rakasungirirwa paari nokusingaperi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Uyu ngauve muripo waJehovha kuvapomeri vangu,","poem":1},{"text":"kuna avo vanotaura zvakaipa pamusoro pangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Asi imi, Ishe Jehovha,","poem":1},{"text":"ndiitirei zvakanaka nokuda kwezita renyu;","poem":2},{"lineBreak":true},{"text":"ndirwirei, kubudikidza nokunaka kworudo rwenyu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nokuti ndiri murombo uye ndinoshayiwa,","poem":1},{"text":"uye mwoyo wangu wakuvara mukati mangu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndinopera somumvuri wamadekwana;","poem":1},{"text":"ndinozunzwa semhashu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mabvi angu apera simba nokutsanya;","poem":1},{"text":"muviri wangu waonda uye ndaonda kwazvo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndiri chinhu chinosekwa navapomeri vangu;","poem":1},{"text":"pavanondiona, vanodzungudza misoro yavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ndibatsirei, imi Jehovha Mwari wangu;","poem":1},{"text":"ndiponesei zvakafanira rudo rwenyu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ngavazive kuti ndirwo ruoko rwenyu,","poem":1},{"text":"kuti imi, iyemi Jehovha, makazviita.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ivo vangatuka havo, asi imi mucharopafadza;","poem":1},{"text":"vachanyadziswa pavanorwisa,","poem":2},{"lineBreak":true},{"text":"asi muranda wenyu achafara.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Vapomeri vangu vachafukidzwa nenyadzi,","poem":1},{"lineBreak":true},{"text":"uye vachaputirwa nokunyara sokunge nejasi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ndicharumbidza Jehovha nomuromo wangu zvikuru;","poem":1},{"text":"paungano huru, ndichamurumbidza.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nokuti anomira kuruoko rworudyi rwouyo anoshayiwa,","poem":1},{"text":"kuti amuponese pane avo vanomupomera mhosva.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}