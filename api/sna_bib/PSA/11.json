{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndinovanda muna Jehovha.","poem":1},{"text":"Mungareva seiko kwandiri muchiti,","poem":2},{"lineBreak":true},{"text":"“Tizira kugomo rako seshiri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nokuti tarira, vakaipa vanowembura uta hwavo;","poem":1},{"text":"vanogadzirira miseve yavo parukungiso,","poem":2},{"text":"kuti vapfure vari murima,","poem":1},{"text":"uyo akarurama pamwoyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kana nheyo dzaparadzwa,","poem":1},{"text":"akarurama angaiteiko?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jehovha ari mutemberi yake tsvene;","poem":1},{"text":"Jehovha ari pachigaro chake choushe chokudenga.","poem":2},{"text":"Anocherechedza vanakomana vavanhu;","poem":1},{"text":"meso ake anovaedza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jehovha anoedza vakarurama,","poem":1},{"text":"asi vakaipa navanoda zvechisimba","poem":2},{"lineBreak":true},{"text":"mweya wake unovavenga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pane vakaipa anonayisa","poem":1},{"text":"mazimbe omoto nesafuri inopfuta;","poem":2},{"lineBreak":true},{"text":"mhepo inopisa ndiwo uchava mugove wavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nokuti Jehovha akarurama,","poem":1},{"text":"anoda kururamisira;","poem":2},{"lineBreak":true},{"text":"vanhu vakarurama vachaona chiso chake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}