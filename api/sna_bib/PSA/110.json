{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi"]},{"type":"verse","number":1,"content":[{"text":"Jehovha akati kuna She wangu,","poem":1},{"text":"“Gara kuruoko rwangu rworudyi,","poem":2},{"text":"kusvikira ndaita vavengi vako","poem":1},{"text":"chitsiko chetsoka dzako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jehovha achatambanudza tsvimbo yesimba rako kubva muZioni;","poem":1},{"text":"uchatonga pakati pavavengi vako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mauto ako achazvipira","poem":1},{"text":"pazuva rako rehondo.","poem":2},{"text":"Wapfekedzwa nguo youshe, utsvene,","poem":1},{"text":"kubva pachizvaro chamambakwedza","poem":2},{"lineBreak":true},{"text":"uchagamuchira dova roujaya hwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jehovha akapika,","poem":1},{"text":"uye haangashanduki, achiti,","poem":2},{"text":"“Iwe uri muprista nokusingaperi,","poem":1},{"text":"worudzi rwaMerikizedheki.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jehovha ari kuruoko rwako rworudyi;","poem":1},{"text":"achaparadza madzimambo pazuva rehasha dzake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Achatonga ndudzi, achiunganidza vakafa,","poem":1},{"text":"uye achiparadza vatongi venyika yose.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Achanwa parukova rwuri parutivi penzira;","poem":1},{"text":"naizvozvo achasimudza musoro wake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}