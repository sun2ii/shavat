{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Rumbidzai Jehovha.","poem":1},{"lineBreak":true},{"text":"Ndicharumbidza Jehovha nomwoyo wangu wose,","poem":1},{"text":"padare ravakarurama nepagungano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mabasa aJehovha makuru;","poem":1},{"text":"anorangarirwa navose vanofara maari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mabasa ake ndeokukudzwa noumambo,","poem":1},{"text":"uye kururama kwake kunogara nokusingaperi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akaita kuti zvishamiso zvake zvirangarirwe;","poem":1},{"text":"Jehovha ane nyasha nengoni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anopa zvokudya kuna avo vanomutya;","poem":1},{"text":"anorangarira sungano yake nokusingaperi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akaratidza vanhu vake simba ramabasa ake,","poem":1},{"text":"achivapa nyika dzedzimwe ndudzi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mabasa amaoko ake akatendeka uye akarurama,","poem":1},{"text":"mitemo yake yose yakavimbika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yakasimba kusvika nokusingaperi-peri,","poem":1},{"text":"yakaitwa mukutendeka nokururama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akapa dzikinuro kuvanhu vake;","poem":1},{"text":"akasimbisa sungano yake nokusingaperi,","poem":2},{"lineBreak":true},{"text":"zita rake idzvene uye rinotyisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kutya Jehovha ndiwo mavambo enjere;","poem":1},{"text":"vose vanotevera mitemo yake vanonzwisisa.","poem":2},{"lineBreak":true},{"text":"Kurumbidzwa ndokwake nokusingaperi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}