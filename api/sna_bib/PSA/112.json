{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Rumbidzai Jehovha.","poem":1},{"lineBreak":true},{"text":"Akaropafadzwa munhu anotya Jehovha,","poem":1},{"text":"anofarira mirayiro yake zvikuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Vana vake vachava nesimba panyika;","poem":1},{"text":"zvizvarwa zvavakarurama zvicharopafadzwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pfuma nezvakawanda zviri mumba make,","poem":1},{"text":"uye kururama kwake kunogara nokusingaperi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kunyange murima akarurama anobudirwa nechiedza,","poem":1},{"text":"iye munhu ane nyasha nengoni uye akarurama.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvakanaka zvinouya kumunhu anopa zvizhinji","poem":1},{"text":"uye anokweretesa pachena, anofambisa nzira dzake nokururamisira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zvirokwazvo, haangatongozungunuswi;","poem":1},{"text":"munhu akarurama acharangarirwa nokusingaperi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Haangatyi mashoko akaipa;","poem":1},{"text":"mwoyo wake wakasimba, anovimba naJehovha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwoyo wake wakachengetedzeka, haangatyi chinhu;","poem":1},{"text":"pakupedzisira achatarira nokukunda kuvavengi vake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akaparadzira zvipo zvake kuvarombo,","poem":1},{"text":"kururama kwake kunogara nokusingaperi;","poem":2},{"lineBreak":true},{"text":"runyanga rwake ruchasimudzwa mudenga mukukudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Akaipa achazviona uye acharwadziwa,","poem":1},{"text":"acharumanya meno ake uye achaonda;","poem":2},{"lineBreak":true},{"text":"kushuva kwowakaipa kuchava pasina.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}