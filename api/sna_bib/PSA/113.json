t":"zviri kudenga napanyika?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Anosimudza murombo kubva muguruva,","poem":1},{"text":"uye anosimudza vanoshayiwa kubva padurunhuru ramadota;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"anovagadza namachinda,","poem":1},{"text":"namachinda avanhu vavo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anogarisa mukadzi asingabereki mumba make,","poem":1},{"text":"samai vavana vanofara.","poem":2},{"lineBreak":true},{"text":"Rumbidzai Jehovha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}