{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Kwete kwatiri, Jehovha, kwete kwatiri,","poem":1},{"text":"asi kukudzwa ngakupiwe kuzita renyu,","poem":2},{"lineBreak":true},{"text":"nokuda kworudo rwenyu nokutendeka kwenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sei ndudzi dzichiti,","poem":1},{"text":"“Mwari wavo aripiko?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwari wedu ari kudenga;","poem":1},{"text":"anoita zvose zvinomufadza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asi zvifananidzo zvavo isirivha negoridhe,","poem":1},{"text":"zvakaitwa namaoko avanhu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvine miromo, asi hazvigoni kutaura,","poem":1},{"text":"zvina meso, asi hazvigoni kuona;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"zvine nzeve, asi hazvigoni kunzwa mhino,","poem":1},{"text":"asi hazvigoni kunhuhwidza;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"zvina maoko, asi hazvigoni kubata,","poem":1},{"text":"tsoka, asi hazvigoni kufamba;","poem":2},{"lineBreak":true},{"text":"uye hazvitauri napahuro pazvo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanozviita vachafanana nazvo,","poem":1},{"text":"navose vanovimba nazvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Haiwa imba yaIsraeri, vimbai naJehovha,","poem":1},{"text":"ndiye mubatsiri wavo nenhoo yavo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Imi imba yaAroni, vimbai naJehovha,","poem":1},{"text":"ndiye mubatsiri wavo nenhoo yavo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Imi vanomutya, vimbai naJehovha,","poem":1},{"text":"ndiye mubatsiri wavo nenhoo yavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jehovha anotirangarira uye achatiropafadza:","poem":1},{"text":"Acharopafadza imba yaIsraeri, acharopafadza imba yaAroni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"acharopafadza vanotya Jehovha,","poem":1},{"text":"vaduku navakuru zvakafanana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Jehovha ngaakuwanzei,","poem":1},{"text":"mose iwe navana vako.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jehovha ngaakuropafadze,","poem":1},{"text":"iye muiti wedenga napasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kudenga denga kumusoro ndokwaJehovha,","poem":1},{"text":"asi nyika akaipa kuvanhu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Vakafa havasivo vanorumbidza Jehovha,","poem":1},{"text":"avo vanoburukira kwakanyarara;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"asi tisu tinokudza Jehovha,","poem":1},{"text":"kubva zvino kusvikira narini.","poem":2},{"lineBreak":true},{"text":"Rumbidzai Jehovha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}