{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Ndinoda Jehovha, nokuti akanzwa inzwi rangu;","poem":1},{"text":"akandinzwira tsitsi pakuchema kwangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nokuti akarerekera nzeve yake kwandiri,","poem":1},{"text":"ndichadana kwaari mazuva ose oupenyu hwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Misungo yorufu yakandipinganidza,","poem":1},{"text":"kurwadza kweguva kwakauya pamusoro pangu;","poem":2},{"lineBreak":true},{"text":"ndakakundwa nenhamo nokusuwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ipapo ndakadana kuzita raJehovha ndikati,","poem":1},{"text":"“Haiwa Jehovha, ndiponesei!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jehovha ane nyasha uye akarurama;","poem":1},{"text":"Mwari wedu azere netsitsi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jehovha anodzivirira vakatendeka pamwoyo;","poem":1},{"text":"pandakanga ndiri pakushayiwa kukuru, iye akandiponesa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Haiwa mweya wangu, chizorora zvakare,","poem":1},{"text":"nokuti Jehovha akakuitira zvakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nokuti imi, iyemi Jehovha, makarwira mweya wangu parufu,","poem":1},{"text":"meso angu pamisodzi,","poem":2},{"lineBreak":true},{"text":"uye makumbo angu pakugumburwa,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kuti ndifambe pamberi paJehovha","poem":1},{"text":"munyika yavapenyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndakatenda; naizvozvo ndakati,","poem":1},{"text":"“Ndiri kutambudzika kwazvo.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uye pakuvhunduka kwangu ndakati,","poem":1},{"text":"“Vanhu vose vanoreva nhema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndingaripira seiko Jehovha","poem":1},{"text":"pamusoro pokunaka kwake kwose kwandiri?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndichasimudza mukombe woruponeso","poem":1},{"text":"ndigodana kuzita raJehovha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndichazadzisa mhiko dzangu kuna Jehovha,","poem":1},{"text":"pamberi pavanhu vake vose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Chinhu chinokosha pamberi paJehovha","poem":1},{"text":"ndirwo rufu rwavatsvene vake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Haiwa Jehovha, zvirokwazvo ndiri muranda wenyu;","poem":1},{"text":"ndiri muranda wenyu, mwanakomana womurandakadzi wenyu;","poem":2},{"lineBreak":true},{"text":"makandisunungura pangetani dzangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ndichabayira chipo chokuvonga kwamuri,","poem":1},{"text":"uye ndichadana kuzita raJehovha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndichazadzisa mhiko dzangu kuna Jehovha,","poem":1},{"text":"pamberi pavanhu vake vose,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"pavanze dzeimba yaJehovha,","poem":1},{"text":"mukati mako, iwe Jerusarema.","poem":2},{"lineBreak":true},{"text":"Rumbidzai Jehovha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}