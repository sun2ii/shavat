aneni; ndiye mubatsiri wangu.","poem":1},{"text":"Ndichatarira vavengi vangu nokukunda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Zviri nani kutizira kuna Jehovha","poem":1},{"text":"pano kuvimba nomunhu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zviri nani kutizira kuna Jehovha","poem":1},{"text":"pano kuvimba namachinda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndudzi dzose dzakandikomba,","poem":1},{"text":"asi ndakavaparadza muzita raJehovha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vakandikomba pamativi ose,","poem":1},{"text":"asi ndakavaparadza muzita raJehovha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vakandimomotera senyuchi,","poem":1},{"text":"asi vakakurumidza kufa seminzwa inotsva,","poem":2},{"lineBreak":true},{"text":"ndakavaparadza muzita raJehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndakasundidzirwa shure uye ndikada kuwa,","poem":1},{"text":"asi Jehovha akandibatsira.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jehovha ndiye simba rangu norwiyo rwangu;","poem":1},{"text":"ndiye ava ruponeso rwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kupembera kwomufaro nokukunda","poem":1},{"text":"kunonzwika mumatende avakarurama kuchiti:","poem":2},{"text":"“Ruoko rworudyi rwaJehovha rwakaita zvinhu zvikuru!","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Ruoko rworudyi rwaJehovha rwakasimudzirwa kumusoro;","poem":2},{"lineBreak":true},{"text":"ruoko rworudyi rwaJehovha rwakaita zvinhu zvikuru!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Handingafi asi ndichararama,","poem":1},{"text":"uye ndichaparidza zvakaitwa naJehovha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jehovha akandiranga kwazvo,","poem":1},{"text":"asi haana kundiisa kurufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ndizarurireiwo masuo okururama;","poem":1},{"text":"ndichapinda ndigovonga Jehovha.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iri ndiro suo raJehovha","poem":1},{"text":"panopinda navakarurama.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndichakuvongai, nokuti makandipindura;","poem":1},{"text":"makava ruponeso rwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dombo rakarambwa navavaki","poem":1},{"text":"ndiro rakazova musoro wekona;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jehovha akaita izvi,","poem":1},{"text":"uye zvinoshamisa pamberi pedu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Iri ndiro zuva rakaitwa naJehovha;","poem":1},{"text":"ngatifarei kwazvo tifarisise mariri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Haiwa Jehovha, tiponesei;","poem":1},{"text":"haiwa Jehovha, tipeiwo kubudirira.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Akaropafadzwa uyo anouya muzita raJehovha.","poem":1},{"text":"Tiri mumba maJehovha tinokuropafadzai.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Jehovha ndiye Mwari,","poem":1},{"text":"uye akaita kuti chiedza chake chivhenekere pamusoro pedu.","poem":2},{"text":"Namatavi muruoko, pinda mumudungwe","poem":1},{"text":"ubatane navamwe vari kuenda kunyanga dzearitari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Imi muri Mwari wangu, uye ndichakuvongai;","poem":1},{"text":"ndimi Mwari wangu, uye ndichakukudzai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Vongai Jehovha, nokuti akanaka;","poem":1},{"text":"rudo rwake runogara nokusingaperi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}