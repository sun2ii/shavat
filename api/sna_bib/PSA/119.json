xt":"sezvo ndichidzidza mirayiro yenyu yakarurama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndichateerera mitemo yenyu;","poem":1},{"text":"regai kundirasa zvachose.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ko, jaya ringanatsa nzira yaro nei?","poem":1},{"text":"Nokurarama sezvinoreva shoko renyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndinokutsvakai nomwoyo wangu wose;","poem":1},{"text":"musandirega ndichitsauka pamirayiro yenyu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shoko renyu ndakariviga mumwoyo mangu,","poem":1},{"text":"kuti ndirege kukutadzirai.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Imi munofanira kukudzwa, Jehovha;","poem":1},{"text":"ndidzidzisei mitemo yenyu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nemiromo yangu ndichataurazve","poem":1},{"text":"mirayiro yose inobva pamuromo wenyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndinofarira kutevera zvirevo zvenyu,","poem":1},{"text":"somunhu anofarira pfuma huru.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndinofungisisa zvirevo zvenyu,","poem":1},{"text":"uye ndinorangarira nzira dzenyu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndinofarira mitemo yenyu;","poem":1},{"text":"handingakanganwi shoko renyu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Itirai muranda wenyu zvakanaka, ndigorarama;","poem":1},{"text":"ndichateerera shoko renyu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndisvinudzei meso angu kuti ndione.","poem":1},{"text":"Zvinhu zvinoshamisa zviri pamurayiro wenyu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndiri mutorwa panyika;","poem":1},{"text":"regai kundivanzira mirayiro yenyu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mweya wangu wapedzwa nokushuva","poem":1},{"text":"mitemo yenyu nguva dzose.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Munotsiura vanozvikudza, avo vakatukwa,","poem":1},{"text":"uye vanotsauka kubva pamirayiro yenyu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bvisai kwandiri kushorwa nokuzvidzwa,","poem":1},{"text":"nokuti ndinochengeta zvirevo zvenyu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kunyange vatongi vachigara pamwe chete vachindireva,","poem":1},{"text":"muranda wenyu achafungisisa mitemo yenyu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndinofadzwa nezvirevo zvenyu;","poem":1},{"text":"ndizvo zvinondipanga mazano.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndakaradzikwa pasi muguruva;","poem":1},{"text":"chengetedzai upenyu hwangu sezvinoreva shoko renyu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndakarevazve nzira dzangu imi mukandipindura;","poem":1},{"text":"ndidzidzisei mitemo yenyu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Itai kuti ndinzwisise zvirevo zvenyu;","poem":1},{"text":"ipapo ndichafungisisa pamusoro pezvishamiso zvenyu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mweya wangu waziya nokusuwa;","poem":1},{"text":"ndisimbisei sezvinoreva shoko renyu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ndibvisei panzira dzokunyengera;","poem":1},{"text":"ndinzwirei nyasha kubudikidza nomurayiro wenyu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ndakasarudza nzira yechokwadi;","poem":1},{"text":"ndakaisa mwoyo wangu pamurayiro wenyu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Haiwa Jehovha, ini ndichabatirira pazvirevo zvenyu;","poem":1},{"text":"musandirega ndichinyadziswa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ndinomhanya munzira yomurayiro wenyu,","poem":1},{"text":"nokuti makasunungura mwoyo wangu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ndidzidzisei, imi Jehovha, kutevera mitemo yenyu;","poem":1},{"text":"ipapo ndichaichengeta kusvikira kumagumo.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ndipei kunzwisisa, ndigochengeta murayiro wenyu","poem":1},{"text":"uye ndigouteerera nomwoyo wangu wose.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Nditungamirirei munzira yemirayiro yenyu,","poem":1},{"text":"nokuti imomo ndinowana mufaro.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Dzorerai mwoyo wangu pane zvamakatema","poem":1},{"text":"kwete pakuchiva kwenyama.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Dzorai meso angu pazvinhu zvisina maturo;","poem":1},{"text":"chengetedzai upenyu hwangu sezvinoreva shoko renyu.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Zadzisai zvamakapikira muranda wenyu,","poem":1},{"text":"kuti mugotyiwa.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Bvisai kunyadziswa kwandaitya,","poem":1},{"text":"nokuti mitemo yenyu yakanaka.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ndinoshuva zvirevo zvenyu sei!","poem":1},{"text":"Chengetedzai upenyu hwangu mukururama kwenyu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Rudo rwenyu rusingaperi ngaruuye kwandiri,","poem":1},{"text":"Jehovha, noruponeso rwenyu sezvamakavimbisa;","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ipapo ndichapindura vanondishora,","poem":1},{"text":"nokuti ndinovimba neshoko renyu.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Regai kubvisa shoko rechokwadi pamuromo pangu,","poem":1},{"text":"nokuti ndakaisa tariro yangu mumurayiro wenyu.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ndichagara ndichiteerera murayiro wenyu,","poem":1},{"text":"nokusingaperi-peri.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Ndichafamba-famba ndakasununguka,","poem":1},{"text":"nokuti ndakatsvaka zvirevo zvenyu.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Ndichataura zvamakatema pamberi pamadzimambo,","poem":1},{"text":"uye handinganyadziswi,","poem":2}]},{"type":"verse","number":47,"content":[{"text":"nokuti ndinofarira mirayiro yenyu","poem":1},{"text":"nokuti ndinoida.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ndinosimudzira maoko angu","poem":1},{"text":"kumirayiro yenyu yandinoda, uye ndinofungisisa zvirevo zvenyu.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Rangarirai shoko renyu kumuranda wenyu,","poem":1},{"text":"nokuti makandipa tariro.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Zvinondinyaradza pakutambura kwangu ndezvizvi:","poem":1},{"text":"Vimbiso yenyu inochengetedza upenyu hwangu.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Vanozvikudza vanondiseka vasingaregi,","poem":1},{"text":"asi ini handitsauki pamurayiro wenyu.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Ndinorangarira mirayiro yenyu yekare, imi Jehovha,","poem":1},{"text":"uye ndinonyaradzwa mairi.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Shungu dzinondibata nokuda kwavakaipa,","poem":1},{"text":"vakasiya murayiro wenyu.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Mitemo yenyu ndiro dingindira rorwiyo rwangu","poem":1},{"text":"pose pandinogara.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Haiwa, Jehovha, ndinorangarira zita renyu usiku,","poem":1},{"text":"uye ndichachengeta murayiro wenyu.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Aya ndiwo anga ari maitiro angu:","poem":1},{"text":"Ndinoteerera zvirevo zvenyu.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Haiwa, Jehovha, ndimi mugove wangu;","poem":1},{"text":"ndakavimbisa kuteerera mashoko enyu.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Ndakatsvaka chiso chenyu nomwoyo wangu wose;","poem":1},{"text":"ndinzwirei nyasha sezvamakavimbisa.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Ndakacherechedza nzira dzangu","poem":1},{"text":"ndikadzorera tsoka dzangu kune zvamakatema.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Ndichakurumidza uye handinganonoki","poem":1},{"text":"kuteerera mirayiro yenyu.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Kunyange vakaipa vakandisunga namabote,","poem":1},{"text":"handizokanganwi murayiro wenyu.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Ndinomuka pakati pousiku ndichikuvongai","poem":1},{"text":"nokuda kwemirayiro yenyu yakarurama.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Ndiri shamwari yavose vanokutyai,","poem":1},{"text":"nokuna vose vanotevera zvirevo zvenyu.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Haiwa Jehovha, nyika izere norudo rwenyu,","poem":1},{"text":"ndidzidzisei zvirevo zvenyu.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Makaitira muranda wenyu zvakanaka,","poem":1},{"text":"imi Jehovha, sezvakafanira shoko renyu.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Ndidzidzisei zivo nokutonga kwakanaka,","poem":1},{"text":"nokuti ndakatenda mirayiro yenyu.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Pandakanga ndisati ndatambudzika,","poem":1},{"text":"ndakatsauka, asi zvino ndinoteerera shoko renyu.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Imi makanaka, uye munoita zvakanaka;","poem":1},{"text":"ndidzidzisei mitemo yenyu.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Kunyange vanozvikudza vakandipomera nhema,","poem":1},{"text":"ndinochengeta zvamakatema nomwoyo wangu wose.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Mwoyo yavo yakasindimara uye hainzwisisi,","poem":1},{"text":"asi ndinofarira murayiro wenyu.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Zvakanga zvakanaka kuti nditambudzike,","poem":1},{"text":"kuitira kuti ndigodzidza mitemo yenyu.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Murayiro unobva pamuromo wenyu unokosha kwandiri,","poem":1},{"text":"kupfuura zviuru zvezvimedu zvesirivha negoridhe.","poem":2}]},{"type":"verse","number":73,"content":[{"text":"Maoko enyu akandisika uye akandiumba;","poem":1},{"text":"ndipei kunzwisisa kuti ndigodzidza mirayiro yenyu.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Avo vanokutyai ngavafare pavanondiona,","poem":1},{"text":"nokuti ndakaisa tariro yangu pashoko renyu.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Haiwa Jehovha, ndinoziva kuti mirayiro yenyu yakarurama,","poem":1},{"text":"uye kuti makanditambudza mukutendeka kwenyu.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Rudo rwenyu rusingaperi ngarutinyaradze,","poem":1},{"text":"maererano nechivimbiso chenyu kumuranda wenyu.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Tsitsi dzenyu ngadziuye kwandiri kuti ndirarame,","poem":1},{"text":"nokuti murayiro wenyu ndiwo mufaro wangu.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Vanozvikudza ngavanyadziswe pakundikanganisira ndisina mhaka,","poem":1},{"text":"asi ini ndichafungisisa zvirevo zvenyu.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"Vanokutyai ngavadzokere kwandiri,","poem":1},{"text":"ivo vanonzwisisa zvamakatema.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Mwoyo wangu ngaushaye chaungapomerwa pamitemo yenyu,","poem":1},{"text":"kuti ndirege kunyadziswa.","poem":2}]},{"type":"verse","number":81,"content":[{"text":"Mweya wangu unoziya nokuda kwekushuva ruponeso rwenyu,","poem":1},{"text":"asi ndakaisa tariro yangu pashoko renyu.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Meso angu aneta nokutsvaga chivimbiso chenyu;","poem":1},{"text":"ndinoti, “Muchandinyaradza riniko?”","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Kunyange ndakaita sehomwe yewaini ndiri muutsi,","poem":1},{"text":"handikanganwi mitemo yenyu.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Muranda wenyu acharindira kusvikira riniko?","poem":1},{"text":"Mucharanga vatambudzi vangu riniko?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Vanozvikudza vakandicherera makomba,","poem":1},{"text":"zvinopesana nomurayiro wenyu.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Mirayiro yenyu yose yakavimbika, ndibatsirei,","poem":1},{"text":"nokuti vanhu vanonditambudza ndisina mhaka.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Vakanga voda kundibvisa panyika,","poem":1},{"text":"asi handina kusiya zvamakatema.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"Chengetedzai upenyu hwangu zvakafanira rudo rwenyu,","poem":1},{"text":"uye ini ndichateerera zvirevo zvomuromo wenyu.","poem":2}]},{"type":"verse","number":89,"content":[{"text":"Haiwa Jehovha, shoko renyu rinogara nokusingaperi;","poem":1},{"text":"rinomira rakasimba kudenga denga.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Kutendeka kwenyu kunoramba kuripo kusvikira kuzvizvarwa zvose;","poem":1},{"text":"makasimbisa nyika uye inogara nokusingaperi.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Mirayiro yenyu iripo kusvikira iye nhasi,","poem":1},{"text":"nokuti zvinhu zvose zvinokushumirai.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Dai murayiro wenyu wanga usiri mufaro wangu,","poem":1},{"text":"ndingadai ndakafira mumatambudziko angu.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Handichazokanganwi zvamakatema,","poem":1},{"text":"nokuti nazvo makachengetedza upenyu hwangu.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Ndiponesei, nokuti ndiri wenyu;","poem":1},{"text":"ndakatsvaka zvamakatema.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"Vakaipa vakarindira kundiparadza,","poem":1},{"text":"asi ini ndichafunga zvirevo zvenyu.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Ndinoona kuguma kwezvose zvakakwana,","poem":1},{"text":"asi mirayiro yenyu haina magumo.","poem":2}]},{"type":"verse","number":97,"content":[{"text":"Haiwa, ndinoda murayiro wenyu sei!","poem":1},{"text":"Ndinoufungisisa zuva rose.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"Mirayiro yenyu inoita kuti ndive akachenjera kupfuura vavengi vangu,","poem":1},{"text":"nokuti inogara neni nguva dzose.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Ndinonzwisisa zvakawanda kupfuura vadzidzisi vangu,","poem":1},{"text":"nokuti ndinofungisisa pamusoro pezvamakatema.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Ndinonzwisisa zvikuru kupfuura vakuru,","poem":1},{"text":"nokuti ndinoteerera zvirevo zvenyu.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Ndakadzora tsoka dzangu panzira","poem":1},{"text":"dzose dzakaipa kuti nditeerere shoko renyu.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Handina kubva pamirayiro yenyu,","poem":1},{"text":"nokuti imi pachenyu makandidzidzisa.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Mashoko enyu anotapira seiko pakuaravira,","poem":1},{"text":"anotapira kukunda uchi mumukanwa mangu!","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Ndinowana kunzwisisa kubva pazvirevo zvenyu;","poem":1},{"text":"naizvozvo ndinovenga nzira dzose dzakaipa.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"Shoko renyu ndiwo mwenje wetsoka dzangu,","poem":1},{"text":"nechiedza chenzira yangu.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Ndakaita mhiko ndikaisimbisa,","poem":1},{"text":"kuti ndichatevera mirayiro yenyu yakarurama.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Ndakatambudzika kwazvo;","poem":1},{"text":"chengetedzai upenyu hwangu, imi Jehovha, zvakafanira shoko renyu.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Haiwa Jehovha, gamuchirai henyu kurumbidza kwomuromo wangu,","poem":1},{"text":"mugondidzidzisa mirayiro yenyu.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Kunyange ndichiramba ndakabata upenyu hwangu mumaoko angu,","poem":1},{"text":"handizokanganwi murayiro wenyu.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Vakaipa vakanditeya nomusungo,","poem":1},{"text":"asi handina kutsauka pazvirevo zvenyu.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Zvirevo zvenyu inhaka yangu nokusingaperi;","poem":1},{"text":"ndizvo mufaro womwoyo wangu.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Mwoyo wangu wakagarira kuchengeta zvirevo zvenyu,","poem":1},{"text":"kusvikira kumagumo.","poem":2}]},{"type":"verse","number":113,"content":[{"text":"Ndinovenga vanhu vane mwoyo miviri,","poem":1},{"text":"asi ndinoda murayiro wenyu.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"Imi muri utiziro hwangu nenhoo yangu;","poem":1},{"text":"ndakaisa tariro yangu pashoko renyu.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Ibvai kwandiri, imi vaiti vezvakaipa,","poem":1},{"text":"kuti ndichengete mirayiro yaMwari wangu!","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Nditsigirei sezvamakavimbisa, ipapo ndichararama;","poem":1},{"text":"musarega tariro yangu ichidzimwa.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"Nditsigirei, ipapo ndicharwirwa;","poem":1},{"text":"ndicharamba ndine hanya nemitemo yenyu.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"Munoramba vose vanotsauka pamitemo yenyu,","poem":1},{"text":"nokuti kunyengera kwavo hakuna maturo.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Vakaipa vose venyika munovaita sengura;","poem":1},{"text":"naizvozvo ndinoda zvamakatema.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Nyama yangu inodedera nokuda kwokukutyai;","poem":1},{"text":"ndinomira ndichitya mirayiro yenyu.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"Ndakaita zvakarurama nokururamisira;","poem":1},{"text":"musandisiya mumaoko avadzvinyiriri vangu.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"Itai kuti muranda wenyu agare zvakanaka;","poem":1},{"text":"musarega vanozvikudza vachimudzvinyirira.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Meso angu aneta nokutsvaka ruponeso rwenyu,","poem":1},{"text":"ndichitsvaga vimbiso yenyu yakarurama.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Itirai muranda wenyu zvinoringana norudo rwenyu,","poem":1},{"text":"uye ndidzidzisei mitemo yenyu.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Ndiri muranda wenyu;","poem":1},{"text":"ndipeiwo kunzvera kuti ndigonzwisisa zvamakatema.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Haiwa Jehovha, inguva yenyu yokubata;","poem":1},{"text":"murayiro wenyu uri kuputswa.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Nokuti ndinoda mirayiro yenyu kupfuura goridhe,","poem":1},{"text":"kupfuura goridhe rakanatswa,","poem":2}]},{"type":"verse","number":128,"content":[{"text":"uye nokuti ndinoti zvirevo zvenyu zvose zvakarurama,","poem":1},{"text":"ndinovenga nzira dzose dzakaipa.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"Zvirevo zvenyu zvinoshamisa;","poem":1},{"text":"naizvozvo ndinozviteerera.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Kuzarurwa kweshoko renyu kunopa chiedza;","poem":1},{"text":"kunopa kunzwisisa kuna vasina mano.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Ndinoshamisa muromo wangu ndigodokwaira,","poem":1},{"text":"ndichishuva mirayiro yenyu.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Dzokerai kwandiri mugondinzwira ngoni,","poem":1},{"text":"sezvamunogara muchiita kuna avo vanoda zita renyu.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Rayirai nhambwe dzetsoka dzangu zviri maererano neshoko renyu;","poem":1},{"text":"chivi ngachirege kunditonga.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Ndidzikinurei pakudzvinyirira kwavanhu,","poem":1},{"text":"kuti ndigoteerera zvirevo zvenyu.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Chiso chenyu ngachipenye pamusoro pomuranda wenyu,","poem":1},{"text":"uye ndidzidzisei mitemo yenyu.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Hova dzemisodzi dzinoerera dzichibva mumeso angu,","poem":1},{"text":"nokuti murayiro wenyu hausi kuteererwa.","poem":2}]},{"type":"verse","number":137,"content":[{"text":"Haiwa Jehovha, imi makarurama,","poem":1},{"text":"uye mirayiro yenyu yakarurama.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Zvirevo zvenyu zvamakadzika zvakarurama;","poem":1},{"text":"zvakavimbika kwazvo.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Kushingaira kwangu kunondipedza,","poem":1},{"text":"nokuti vavengi vangu havana hanya namashoko enyu.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Vimbiso dzenyu dzakaedzwa chose,","poem":1},{"text":"uye muranda wenyu anodzida.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Kunyange ndakaderedzwa uye ndichizvidzwa hangu,","poem":1},{"text":"handikanganwi zvirevo zvenyu.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"Kururama kwenyu kunogara nokusingaperi,","poem":1},{"text":"uye murayiro wenyu ndowezvokwadi.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Nhamo namatambudziko zviri pamusoro pangu,","poem":1},{"text":"asi mirayiro yenyu ndiwo mufaro wangu.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Zvirevo zvenyu zvinogara zvakarurama;","poem":1},{"text":"ndipeiwo kunzwisisa kuti ndirarame.","poem":2}]},{"type":"verse","number":145,"content":[{"text":"Ndinodana nomwoyo wangu wose; haiwa Jehovha ndipindureiwo,","poem":1},{"text":"uye ndichateerera mitemo yenyu.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"Ndinodanidzira kwamuri,","poem":1},{"text":"ndiponesei uye ndichachengeta zvamakatema.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"Ndinomuka mambakwedza asati asvika ndigochemera kubatsirwa;","poem":1},{"text":"ndakaisa tariro yangu pashoko renyu.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Meso angu anogara akasvinura panguva dzose dzousiku,","poem":1},{"text":"kuti ndifungisise pamusoro pevimbiso dzenyu.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Inzwai inzwi rangu sezvakafanira rudo rwenyu;","poem":1},{"text":"haiwa Jehovha, chengetedzai upenyu hwangu zviri maererano nemirayiro yenyu.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Vanoita mano akaipa vari pedyo,","poem":1},{"text":"asi vari kure nomurayiro wenyu.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"Asi imi muri pedyo, Jehovha,","poem":1},{"text":"uye mirayiro yenyu yose ndeyezvokwadi.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Ndakadzidza pane zvamakatema kare,","poem":1},{"text":"kuti makazvisimbisa kuti zvigare nokusingaperi.","poem":2}]},{"type":"verse","number":153,"content":[{"text":"Tarirai kutambudzika kwangu mugondirwira,","poem":1},{"text":"nokuti handina kukanganwa murayiro wenyu.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Miririrai mhosva yangu uye mundidzikinure;","poem":1},{"text":"chengetedzai upenyu hwangu maererano nevimbiso yenyu.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Ruponeso rwuri kure navakaipa,","poem":1},{"text":"nokuti havatsvaki mitemo yenyu.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Haiwa Jehovha, tsitsi dzenyu ihuru;","poem":1},{"text":"chengetedzai upenyu hwangu maererano nemirayiro yenyu.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Vavengi vangu navanonditambudza vazhinji,","poem":1},{"text":"asi handina kutsauka pane zvamakatema.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"Ndinotarira kuna vasingatendi ndichisema,","poem":1},{"text":"nokuti havateereri shoko renyu.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"Tarirai madiro andinoita zvirevo zvenyu;","poem":1},{"text":"haiwa Jehovha, chengetedzai upenyu hwangu, maererano norudo rwenyu.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Mashoko enyu ose ndeechokwadi;","poem":1},{"text":"mirayiro yenyu yose yakarurama ndeyokusingaperi.","poem":2}]},{"type":"verse","number":161,"content":[{"text":"Vatongi vanonditambudza ndisina mhaka,","poem":1},{"text":"asi mwoyo wangu unodedera pashoko renyu.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Ndinofarira vimbiso yenyu","poem":1},{"text":"kufanana nouyo anowana zvakapambwa zvizhinji.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Ndinovenga uye ndinosema nhema,","poem":1},{"text":"asi ndinoda murayiro wenyu.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Ndinokurumbidzai kanomwe pazuva,","poem":1},{"text":"nokuda kwemirayiro yenyu yakarurama.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Vanoda murayiro wenyu vano rugare rukuru,","poem":1},{"text":"uye hakuna chingavagumbusa.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Haiwa Jehovha, ndakamirira ruponeso rwenyu,","poem":1},{"text":"uye ndinotevera mirayiro yenyu.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Ndinoteerera zvirevo zvenyu,","poem":1},{"text":"nokuti ndinozvida zvikuru.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"Ndinoteerera zvirevo zvenyu nezvamakatema,","poem":1},{"text":"nokuti nzira dzangu dzose dzinozivikanwa nemi.","poem":2}]},{"type":"verse","number":169,"content":[{"text":"Dai kuchema kwangu kwasvika pamberi penyu, imi Jehovha;","poem":1},{"text":"ndipeiwo kunzwisisa maererano neshoko renyu.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Kukumbira kwangu dai kwasvika pamberi penyu;","poem":1},{"text":"ndirwirei maererano nevimbiso yenyu.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Miromo yangu dai yafashukira nerumbidzo,","poem":1},{"text":"nokuti munondidzidzisa mitemo yenyu.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Rurimi rwangu dai rwaimba nezveshoko renyu,","poem":1},{"text":"nokuti mirayiro yenyu yose yakarurama.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Ruoko rwenyu dai rwagadzirira kundibatsira,","poem":1},{"text":"nokuti ndakasarudza zvirevo zvenyu.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Haiwa Jehovha, ndinoshuva ruponeso rwenyu,","poem":1},{"text":"uye murayiro wenyu ndiwo mufaro wangu.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Regai ndirarame kuti ndigokurumbidzai,","poem":1},{"text":"uye dai mirayiro yenyu yandibatsira.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Ndakatsauka segwai rakarasika.","poem":1},{"text":"Tsvakai muranda wenyu,","poem":2},{"lineBreak":true},{"text":"nokuti handina kukanganwa mirayiro yenyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}