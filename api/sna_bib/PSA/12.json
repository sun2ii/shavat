{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Nesheminiti. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Batsirai, imi Jehovha, nokuti vanoda Mwari hapachina;","poem":1},{"text":"vakatendeka vapera pakati pavanhu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mumwe nomumwe anorevera wokwake nhema;","poem":1},{"text":"miromo yavo inobata kumeso nokutaura zvinonyengera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jehovha ngaagure miromo yose inobata kumeso,","poem":1},{"text":"norurimi rumwe norumwe runozvikudza","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ruchiti, “Tichakunda nendimi dzedu;","poem":1},{"text":"miromo ndeyedu, tenzi wedu ndiani?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Nokuda kwokumanikidzwa kwavasina simba","poem":1},{"text":"nokugomera kwavarombo,","poem":2},{"text":"ndichasimuka zvino,” ndizvo zvinotaura Jehovha.","poem":1},{"text":"“Ndichavadzivirira kuna avo vanovaparadza.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uye mashoko aJehovha haana chaangapomerwa,","poem":1},{"text":"sesirivha yakacheneswa muchoto chevhu,","poem":2},{"lineBreak":true},{"text":"yakanatswa kanomwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Imi Jehovha, muchatichengeta murugare","poem":1},{"text":"uye muchatidzivirira kubva kuvanhu vakadai nokusingaperi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vakaipa vanofamba-famba vakasununguka","poem":1},{"text":"kana zvakashata zvichikudzwa pakati pavanhu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}