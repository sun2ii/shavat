{"text":"pakati pavanovenga rugare.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndiri munhu worugare;","poem":1},{"text":"asi pandinotaura, ivo ndevehondo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}