{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["Rwiyo rworwendo rwaDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndakafara pavakati kwandiri,","poem":1},{"text":"“Handei kumba yaJehovha.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsoka dzedu dzimire","poem":1},{"text":"mukati mamasuo ako, iwe Jerusarema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jerusarema rakavakwa seguta","poem":1},{"text":"rakapakata kwazvo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndiko kunokwira marudzi,","poem":1},{"text":"iwo marudzi aJehovha,","poem":2},{"text":"kundorumbidza zita raJehovha","poem":1},{"text":"maererano nezvakatemerwa Israeri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvigaro zvokutonga zvimire ikoko,","poem":1},{"text":"zvigaro zvoushe zveimba yaDhavhidhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nyengetererai rugare rweJerusarema:","poem":1},{"text":"“Vanokuda dai vagara zvakanaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dai mukati mamasvingo ako maita rugare,","poem":1},{"text":"nokuchengetedzeka mukati menhare dzako.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nokuda kwehama neshamwari dzangu,","poem":1},{"text":"ndichati, “Rugare ngaruve mukati mako.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuda kweimba yaJehovha Mwari wedu,","poem":1},{"text":"ndichatsvaka kubudirira kwako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}