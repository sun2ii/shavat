","number":5,"content":[{"text":"Asi avo vanotsaukira kunzira dzakaminama,","poem":1},{"text":"Jehovha achavaparadza pamwe chete navaiti vezvakaipa.","poem":2},{"lineBreak":true},{"text":"Rugare ngaruve pana Israeri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}