":7,"content":[{"text":"mukohwi haangazadzi maoko ake nahwo,","poem":1},{"text":"uye anounganidza haangazadzi maoko ake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanopfuura nepo ngavarege kuti,","poem":1},{"text":"“Maropafadzo aJehovha ngaave pamusoro pako;","poem":2},{"lineBreak":true},{"text":"tinokuropafadza muzita raJehovha.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}