{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Kusvikira riniko, nhai Jehovha? Muchandikanganwa nokusingaperi here?","poem":1},{"text":"Muchasvika riniko makandivanzira chiso chenyu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichaita mutsimba nepfungwa dzangu kusvikira riniko,","poem":1},{"text":"uye ndine shungu mumwoyo mangu zuva rimwe nerimwe?","poem":2},{"lineBreak":true},{"text":"Muvengi wangu achandikurira kusvikira riniko?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tarirai kwandiri mugondipindura, imi Jehovha Mwari wangu.","poem":1},{"text":"Vhenekerai meso angu, kana kuti ndichafa ndakarara;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"muvengi wangu achati, “Ndamukurira ndamukunda,”","poem":1},{"text":"uye vadzivisi vangu vachapembera kana ndawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Asi ini ndinovimba norudo rwenyu rusingaperi;","poem":1},{"text":"mwoyo wangu unofarira ruponeso rwenyu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndichaimbira Jehovha,","poem":1},{"text":"nokuti akandinakira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}