{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Rwiyo rworwendo."]},{"type":"verse","number":1,"content":[{"text":"Ndinodanidzira kwamuri Jehovha,","poem":1},{"text":"ndiri pakadzika;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"haiwa Jehovha, inzwai inzwi rangu.","poem":1},{"text":"Nzeve dzenyu ngadzinzwe kuchemera kwangu ngoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dai imi, iyemi Jehovha, maironda zvakaipa zvomunhu,","poem":1},{"text":"haiwa Jehovha, ndianiko aimira?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asi kwamuri kune kukanganwira;","poem":1},{"text":"naizvozvo imi munotyiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndinomirira Jehovha, mweya wangu unomirira,","poem":1},{"text":"uye tariro yangu iri mushoko rake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mweya wangu unorindira Ishe","poem":1},{"text":"kupfuura varindi","poem":2},{"lineBreak":true},{"text":"vanomirira rungwanani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Haiwa Israeri, isa tariro yako muna Jehovha,","poem":1},{"text":"nokuti Jehovha ane rudo rusingaperi","poem":2},{"lineBreak":true},{"text":"uye kwaari kune dzikinuro izere.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iye pachake achadzikinura Israeri","poem":1},{"text":"kubva pazvivi zvavo zvose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}