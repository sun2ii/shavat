{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["Rwiyo rworwendo."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, rangarirai Dhavhidhi","poem":1},{"text":"namatambudziko ake ose aakasangana nawo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akapika mhiko kuna Jehovha,","poem":1},{"text":"akaita mhiko kuna Wamasimba waJakobho achiti,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Handingapindi mumba mangu","poem":1},{"text":"kana kuenda kundovata pamubhedha wangu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"handingatenderi hope mumaziso angu,","poem":1},{"text":"kana kutsumwaira mumeso angu,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"kusvikira ndawana nzvimbo yaJehovha,","poem":1},{"text":"nzvimbo yokugara yoWamasimba waJakobho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Takazvinzwa muEfurata,","poem":1},{"text":"takasangana nazvo muminda yeJaari tikati,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Ngatiendei kunzvimbo yake yokugara;","poem":1},{"text":"ngatinamatei pachitsiko chetsoka dzake,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"haiwa Jehovha, simukai muuye kunzvimbo yenyu yokuzorora,","poem":1},{"text":"imi neareka yesimba renyu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vaprista venyu dai vafukidzwa nokururama;","poem":1},{"text":"dai vatsvene venyu vaimba nomufaro.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nokuda kwaDhavhidhi muranda wenyu,","poem":1},{"text":"musaramba muzodziwa wenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jehovha akapika mhiko kuna Dhavhidhi,","poem":1},{"text":"mhiko yechokwadi yaasingagoni kushandura achiti,","poem":2},{"text":"“Mumwe wechizvarwa chako","poem":1},{"text":"ndichamugadza pachigaro chako choushe,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kana vanakomana vako vakachengeta sungano yangu","poem":1},{"text":"nezvandakatema zvandakavadzidzisa,","poem":2},{"text":"ipapo vanakomana vavo","poem":1},{"text":"vachagara pachigaro chako choushe nokusingaperi-peri.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nokuti Jehovha akasarudza Zioni,","poem":1},{"text":"akarida kuti huve ugaro hwake achiti,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Iyi ndiyo nzvimbo yangu yokuzorora nokusingaperi-peri;","poem":1},{"text":"ipapa ndipo pandichagara samambo, nokuti ndakapada,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ndichariropafadza nezvakawanda;","poem":1},{"text":"ndichagutsa varombo varo nezvokudya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndichafukidza vaprista varo noruponeso,","poem":1},{"text":"uye vatsvene varo vachagara vachiimba nomufaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Pano ndipo pandichameresa nyanga yaDhavhidhi,","poem":1},{"text":"uye ndichatungidza mwenje womuzodziwa wangu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndichafukidza vavengi vake nenyadzi,","poem":1},{"text":"asi korona yake ichabwinya kwazvo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}