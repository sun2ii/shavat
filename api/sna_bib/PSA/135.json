{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Rumbidzai Jehovha.","poem":1},{"lineBreak":true},{"text":"Rumbidzai zita raJehovha;","poem":1},{"text":"murumbidzei, imi varanda vaJehovha,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"imi munoshumira muimba yaJehovha,","poem":1},{"text":"muvanze dzeimba yaMwari wedu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rumbidzai Jehovha, nokuti Jehovha akanaka;","poem":1},{"text":"imbirai zita rake nziyo dzokurumbidza, nokuti ndizvo zvakanaka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nokuti Jehovha akasarudza Jakobho kuti ave wake,","poem":1},{"text":"naIsraeri kuti ave pfuma yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndinoziva kuti Jehovha mukuru,","poem":1},{"text":"uye kuti Ishe wedu mukuru kupfuura vamwari vose.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jehovha anoita zvose zvinomufadza,","poem":1},{"text":"kudenga napasi,","poem":2},{"lineBreak":true},{"text":"nomumakungwa napakadzika pose.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anoita kuti makore akwire kubva kumagumo enyika;","poem":1},{"text":"anotumira mheni nemvura,","poem":2},{"lineBreak":true},{"text":"uye anobudisa mhepo kubva mumatura ake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ndiye akaparadza matangwe eIjipiti,","poem":1},{"text":"matangwe avanhu neemhuka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akatumira zviratidzo nezvishamiso zvake mukati mako,","poem":1},{"text":"iwe Ijipiti, pamusoro paFaro navaranda vake vose.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akaparadza ndudzi dzakawanda","poem":1},{"text":"uye akauraya madzimambo ane simba,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sihoni mambo weAmori,","poem":1},{"text":"Ogi mambo weBhashani","poem":2},{"lineBreak":true},{"text":"namadzimambo ose eKenani,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"akapa nyika yavo kuti ive nhaka,","poem":1},{"text":"nhaka yavanhu vake Israeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Haiwa Jehovha, zita renyu rinogara nokusingaperi,","poem":1},{"text":"mukurumbira wenyu, imi Jehovha, kuzvizvarwa zvose.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nokuti Jehovha achapupurira vanhu vake","poem":1},{"text":"uye achava nenyasha pamusoro pavaranda vake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zvifananidzo zvendudzi isirivha negoridhe,","poem":1},{"text":"zvakaitwa namaoko avanhu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zvine miromo, asi hazvigoni kutaura,","poem":1},{"text":"zvina meso, asi hazvigoni kuona;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"nenzeve, asi hazvigoni kunzwa,","poem":1},{"text":"uye hamuna kufema mumuromo mazvo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vaya vanozviita vachafanana nazvo,","poem":1},{"text":"saizvozvowo, naivo vanovimba nazvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Haiwa imi imba yaIsraeri, rumbidzai Jehovha;","poem":1},{"text":"haiwa imba yaAroni, rumbidzai Jehovha;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Haiwa imi imba yaRevhi, rumbidzai Jehovha;","poem":1},{"text":"imi vanomutya, rumbidzai Jehovha.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jehovha ngaarumbidzwe kubva kuZioni,","poem":1},{"text":"iye agere muJerusarema.","poem":2},{"lineBreak":true},{"text":"Rumbidzai Jehovha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}