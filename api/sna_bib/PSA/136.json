avo senhaka,","poem":1},"Nokuti rudo rwake runogara nokusingaperi."]},{"type":"verse","number":22,"content":[{"text":"nhaka kumuranda wake Israeri.","poem":1},"Nokuti rudo rwake runogara nokusingaperi."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Iye akatirangarira pakudzikisirwa kwedu,","poem":1},"Nokuti rudo rwake runogara nokusingaperi."]},{"type":"verse","number":24,"content":[{"text":"uye akatisunungura kubva pavavengi vedu,","poem":1},"Nokuti rudo rwake runogara nokusingaperi."]},{"type":"verse","number":25,"content":[{"text":"uye anopa zvokudya kuzvisikwa zvose.","poem":1},"Nokuti rudo rwake runogara nokusingaperi."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Vongai Mwari wokudenga,","poem":1},"Nokuti rudo rwake runogara nokusingaperi."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}