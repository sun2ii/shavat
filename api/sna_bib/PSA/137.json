{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Panzizi dzeBhabhironi takagarapo tikachema,","poem":1},{"text":"patakarangarira Zioni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pamikonachando apo","poem":1},{"text":"ndipo patakaturika mbira dzedu,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"nokuti ipapo avo vakatitapa vakatikumbira nziyo,","poem":1},{"text":"vatambudzi vedu vakatigombedzera kuti tiimbe nziyo dzomufaro, vakati,","poem":2},{"lineBreak":true},{"text":"“Tiimbirei rumwe rwiyo rweZioni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tingaimba seiko nziyo dzaJehovha","poem":1},{"text":"tiri munyika yokumwe?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kana ndikakukanganwa, iwe Jerusarema,","poem":1},{"text":"ruoko rwangu rworudyi ngarukanganwe umhizha hwarwo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rurimi rwangu ngarunamatire kumusoro kwomuromo wangu,","poem":1},{"text":"kana ndikasakurangarira iwe,","poem":2},{"text":"kana ndisingafungi Jerusarema,","poem":1},{"text":"iwo mufaro wangu wapamusoro-soro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Haiwa Jehovha, rangarirai henyu zvakaitwa navaEdhomu,","poem":1},{"text":"pazuva rakawa Jerusarema.","poem":2},{"text":"Vakati, “Rikoromorei! Rikoromorei","poem":1},{"text":"kusvikira panheyo dzaro!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Haiwa Mwanasikana weBhabhironi, watongerwa kuparadzwa,","poem":1},{"text":"achafara munhu uyo achatsiva","poem":2},{"lineBreak":true},{"text":"kwauri zvawakaita kwatiri,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"iye achatora pwere dzako","poem":1},{"text":"agodzirovera pamatombo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}