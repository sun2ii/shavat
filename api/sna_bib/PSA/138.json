{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndichakurumbidzai, imi Jehovha, nomwoyo wangu wose;","poem":1},{"text":"ndichaimba nziyo dzokukurumbidzai pamberi pa“vamwari.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichakotamira pasi ndakatarisa kutemberi yenyu tsvene,","poem":1},{"text":"uye ndicharumbidza zita renyu","poem":2},{"lineBreak":true},{"text":"nokuda kworudo rwenyu nokutendeka kwenyu,","poem":2},{"text":"nokuti makakudza zita renyu","poem":1},{"text":"neshoko renyu pamusoro pezvinhu zvose.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pandakadana, imi makandipindura;","poem":1},{"text":"makandishingisa nomwoyo wakasimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Madzimambo ose enyika ngaakurumbidzei, imi Jehovha,","poem":1},{"text":"pavanonzwa mashoko omuromo wenyu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngavaimbe pamusoro penzira dzaJehovha, nokuti kubwinya kwaJehovha kukuru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kunyange Jehovha ari kumusoro, anoona vanozvininipisa,","poem":1},{"text":"asi vanozvikudza anovaziva vari kure.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kunyange ndikafamba pakati penhamo,","poem":1},{"text":"munochengetedza upenyu hwangu;","poem":2},{"text":"munotambanudza ruoko rwenyu pamusoro pehasha dzavavengi vangu,","poem":1},{"text":"munondiponesa noruoko rwenyu rworudyi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jehovha achazadzisa zvirongwa zvake neni;","poem":1},{"text":"rudo rwenyu, imi Jehovha, runogara nokusingaperi,","poem":2},{"lineBreak":true},{"text":"musasiya mabasa amaoko enyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}