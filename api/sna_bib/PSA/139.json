{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, makandinzvera","poem":1},{"text":"uye munondiziva.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Munoziva nguva yandinogara neyandinosimuka;","poem":1},{"text":"munonzwisisa pfungwa dzangu muri kure.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Munonzvera kubuda kwangu nokuvata kwangu pasi;","poem":1},{"text":"munoziva nzira dzangu dzose.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shoko risati rava parurimi rwangu,","poem":1},{"text":"tarirai, imi Jehovha, munoriziva rose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Munondikomberedza shure nemberi;","poem":1},{"text":"makaisa ruoko rwenyu pamusoro pangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuziva kwakadai kunondishamisa,","poem":1},{"text":"kwakanyanya kukwirira zvokuti handingasvikiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ndingaendepiko kuti ndibve paMweya wenyu?","poem":1},{"text":"Ndingatizirepiko kuti ndibve pamberi penyu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kana ndikakwira kumatenga, imi muriko;","poem":1},{"text":"kana ndikawarira mubhedha wangu kwakadzika, imi muriko.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kana ndikasimuka namapapiro amambakwedza,","poem":1},{"text":"kana ndikandogara kumagumo egungwa,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kunyange ipapo ruoko rwenyu runondisesedza,","poem":1},{"text":"ruoko rwenyu rworudyi runondimbundikira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kana ndikati, “Zvirokwazvo rima richandivanza,","poem":1},{"text":"uye chiedza chinondikomberedza chichava usiku kwandiri,”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kunyange rima haringavi rima kwamuri;","poem":1},{"text":"usiku huchapenya samasikati,","poem":2},{"lineBreak":true},{"text":"nokuti rima rakaita sechiedza kwamuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nokuti imi makasika zvomukatikati mangu;","poem":1},{"text":"makandiruka ndiri mudumbu ramai vangu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndinokurumbidzai nokuti ndakaitwa nomutoo unotyisa uye unoshamisa;","poem":1},{"text":"mabasa enyu anoshamisa,","poem":2},{"lineBreak":true},{"text":"ndinonyatsozviziva kwazvo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mapfupa angu akanga asina kuvanzika kwamuri,","poem":1},{"text":"pandakanga ndaiswa munzvimbo yakavanda.","poem":2},{"text":"Pandakarukwa ndiri pakadzika penyika,","poem":1}]},{"type":"verse","number":16,"content":[{"text":"meso enyu akaona muviri usati waumbwa.","poem":2},{"text":"Mazuva ose andakarongerwa","poem":1},{"text":"akanga akanyorwa mubhuku renyu,","poem":2},{"lineBreak":true},{"text":"rimwe rawo risati ravapo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mirangariro yenyu inokosha sei kwandiri, imi Mwari!","poem":1},{"text":"Yakakura sei pakuverengwa kwayo!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dai ndaiverenga,","poem":1},{"text":"ingadai yaikunda tsanga dzejecha pakuwanda.","poem":2},{"text":"Pandinopepuka,","poem":1},{"text":"ndinenge ndinemi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dai mukangouraya vakaipa, imi Mwari!","poem":1},{"text":"Endai kure neni, imi vanhu vokuteura ropa!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ivo vanotaura nemi nomurangariro wakaipa;","poem":1},{"text":"vadzivisi venyu vanoshandisa zita renyu zvakaipa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ko, ini handivengi vanokuvengai here, imi Jehovha,","poem":1},{"text":"nokusema vaya vanokumukirai?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Handina chimwe chinhu asi kuvavenga ivo;","poem":1},{"text":"ndinovati vavengi vangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ndinzverei, imi Mwari, mugoziva mwoyo wangu;","poem":1},{"text":"ndiedzei mugoziva kushuva kwendangariro dzangu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Muone kana musina nzira yakaipa mandiri,","poem":1},{"text":"mugondifambisa munzira isingaperi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}