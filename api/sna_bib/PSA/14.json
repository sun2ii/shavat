{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Benzi rinoti mumwoyo maro,","poem":1},{"text":"“Hakuna Mwari.”","poem":2},{"text":"Vakaora, mabasa avo akashata;","poem":1},{"text":"hakuna anoita zvakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jehovha ari kudenga anotarira pasi","poem":1},{"text":"pamusoro pavanakomana vavanhu,","poem":2},{"text":"kuti aone kana aripo anonzwisisa,","poem":1},{"text":"naani zvake anotsvaka Mwari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vose vakatsauka,","poem":1},{"text":"vose pamwe chete vakasvibiswa;","poem":2},{"text":"hakuna anoita zvakanaka,","poem":1},{"text":"kunyange nomumwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ko, vaiti vezvakaipa havadzidziwo here,","poem":1},{"text":"ivo vanodya vanhu vangu savanhu vanodya chingwa,","poem":2},{"lineBreak":true},{"text":"uye vasingadani kuna Jehovha?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pavari ipapo, vakazara nokutya,","poem":1},{"text":"nokuti Mwari ari paungano yavakarurama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Imi vaiti vezvakaipa, munokanganisa urongwa hwavarombo,","poem":1},{"text":"asi Jehovha ndiye utiziro hwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Haiwa, dai ruponeso rwaIsraeri rwaibuda muZioni!","poem":1},{"text":"Kana Jehovha achidzosazve nhaka yavanhu vake,","poem":2},{"lineBreak":true},{"text":"Jakobho ngaapembere uye Israeri ngaafare.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}