{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndirwirei, imi Jehovha, pavanhu vakaipa;","poem":1},{"text":"ndidzivirirei pavanhu vanoita nechisimba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ivo vanofunga urongwa hwakaipa mumwoyo yavo,","poem":1},{"text":"uye vanomutsa hondo mazuva ose.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vanorodza ndimi dzavo kuti dzipinze sedzenyoka;","poem":1},{"text":"uturu hwenyoka yechiva huri pamiromo yavo. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndichengetei, imi Jehovha, kubva mumaoko avakaipa;","poem":1},{"text":"ndidzivirirei pavanhu vanoita nechisimba","poem":2},{"lineBreak":true},{"text":"vanoronga kupinga tsoka dzangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vanhu vanozvikudza vakandivanzira misungo;","poem":1},{"text":"vakatambanudza mabote emimbure yavo","poem":2},{"lineBreak":true},{"text":"uye vakateya ugombe munzira yandinofamba nayo. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Haiwa Jehovha, ndinoti kwamuri, “Ndimi Mwari wangu.”","poem":1},{"text":"Haiwa Jehovha, inzwai kuchemera nyasha kwangu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Haiwa Ishe Jehovha, imi mudzikinuri wangu ane simba,","poem":1},{"text":"anofukidza musoro wangu pazuva rehondo,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"regai kupa vakaipa zvavanoda, imi Jehovha;","poem":1},{"text":"musarega urongwa hwavo huchibudirira,","poem":2},{"lineBreak":true},{"text":"kuti varege kuzvikudza. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Misoro yaavo vakandipoteredza","poem":1},{"text":"ngaifukidzwe nenhamo yakaparwa nemiromo yavo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mazimbe anopfuta ngaawire pamusoro pavo;","poem":1},{"text":"ngavakandwe mumoto,","poem":2},{"lineBreak":true},{"text":"mumakomba amatope, vasambomukazve.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vane makuhwa ngavarege kusimbiswa panyika;","poem":1},{"text":"njodzi ngaivhime vanhu vanoita zvinhu nechisimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndinoziva kuti Jehovha akachengetera varombo kururamisirwa kwavo,","poem":1},{"text":"uye anotsigira vanoshayiwa pamhaka dzavo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zvirokwazvo vakarurama vacharumbidza zita renyu,","poem":1},{"text":"uye vakarurama vachagara pamberi penyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}