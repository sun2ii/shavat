{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, ndinodana kwamuri; kurumidzai kuuya kwandiri.","poem":1},{"text":"Inzwai inzwi rangu pandinodana kwamuri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Munyengetero wangu ngauiswe pamberi penyu sezvinonhuhwira;","poem":1},{"text":"kusimudzwa kwamaoko angu ngakuite sechibayiro chamadekwana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Isai murindi pamuromo wangu, imi Jehovha;","poem":1},{"text":"chengetai mukova wemiromo yangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwoyo wangu ngaurege kukweverwa kune zvakaipa,","poem":1},{"text":"kuti ndiitewo mabasa akaipa","poem":2},{"text":"navanhu vanoita zvakaipa;","poem":1},{"text":"ngandirege kudya zvinozipa zvavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Akarurama ngaandirove, ndidzo tsitsi;","poem":1},{"text":"ngaanditsiure, ndiwo mafuta pamusoro wangu.","poem":2},{"lineBreak":true},{"text":"Musoro wangu hauzorambi izvozvo.","poem":2},{"lineBreak":true},{"text":"Asi munyengetero wangu unorwisa mabasa avaiti vezvakaipa nguva dzose.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Vatongi vavo vachakandwa kumawere,","poem":2},{"lineBreak":true},{"text":"uye vakaipa vachadzidza kuti mashoko angu akanga akanaka kwazvo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ivo vachati, “Sezvinoita anorima achiparura pasi,","poem":1},{"text":"saizvozvo mapfupa edu akaparadzirwa pamuromo weguva.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Asi meso angu anotarira kwamuri, imi Ishe Jehovha;","poem":1},{"text":"ndinotizira kwamuri, regai kundiisa kurufu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndichengetei pamisungo yavakanditeya nayo,","poem":1},{"text":"napaugombe hwakadzikwa navaiti vezvakaipa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vakaipa ngavawire mumimbure yavo,","poem":1},{"text":"ini ndichipfuura napo norugare.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}