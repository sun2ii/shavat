{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Masikiri raDhavhidhi. Paakanga ari mubako. Munyengetero."]},{"type":"verse","number":1,"content":[{"text":"Ndinodanidzira nenzwi guru kuna Jehovha;","poem":1},{"text":"ndinosimudzira inzwi rangu kuna Jehovha, kuti andinzwire nyasha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndinodurura kugununʼuna kwangu pamberi pake;","poem":1},{"text":"ndinotaura nhamo dzangu pamberi pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mweya wangu paunoziya mandiri,","poem":1},{"text":"imi ndimi munoziva nzira yangu.","poem":2},{"text":"Munzira mandinofamba,","poem":1},{"text":"vanhu vakandivanzira misungo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tarirai kurudyi rwangu mugoona;","poem":1},{"text":"hakuna ane hanya neni.","poem":2},{"text":"Handina utiziro;","poem":1},{"text":"hakuna ane hanya noupenyu hwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndinochema kwamuri, imi Jehovha; ndinoti,","poem":1},{"text":"“Ndimi utiziro hwangu,","poem":2},{"lineBreak":true},{"text":"nomugove wangu munyika yavapenyu.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Teererai kuchema kwangu,","poem":1},{"text":"nokuti ndiri pakushayiwa kukuru;","poem":2},{"text":"ndinunurei kuna avo vanondidzinganisa,","poem":1},{"text":"nokuti vanondikurira simba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndibudisei mutorongo,","poem":1},{"text":"kuti ndirumbidze zita renyu.","poem":2},{"lineBreak":true},{"text":"Ipapo vakarurama vachandipoteredza","poem":1},{"text":"nokuda kwokunaka kwenyu kwandiri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}