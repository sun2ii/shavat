{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, inzwai munyengetero wangu,","poem":1},{"text":"ndinzwirei ngoni pakuchema kwangu;","poem":2},{"text":"uyai mundisunungure nokutendeka","poem":1},{"text":"uye nokururama kwenyu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Musauyisa muranda wenyu mukutongwa,","poem":1},{"text":"nokuti hakuna mupenyu akarurama pamberi penyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Muvengi anondidzinganisa,","poem":1},{"text":"anondirovera pasi;","poem":2},{"text":"anondiita kuti ndigare murima","poem":1},{"text":"savaya vakafa kare.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Saizvozvo mweya wangu unoziya mukati mangu;","poem":1},{"text":"mwoyo wangu unovhundutswa mukati mangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndinorangarira mazuva akare kare;","poem":1},{"text":"ndinofungisisa pamusoro pamabasa enyu ose,","poem":2},{"lineBreak":true},{"text":"uye ndinofunga zvakaitwa namaoko enyu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndinotambanudzira maoko angu kwamuri;","poem":1},{"text":"mweya wangu unokushuvai senyika yakaoma. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Haiwa Jehovha, kurumidzai kundipindura;","poem":1},{"text":"mweya wangu woziya.","poem":2},{"text":"Regai kundivanzira chiso chenyu","poem":1},{"text":"nokuti ndingazova savaya vakaburukira mugomba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mangwanani ngaandivigire shoko rorudo rwenyu rusingaperi,","poem":1},{"text":"nokuti ndinovimba nemi.","poem":2},{"text":"Ndiratidzei nzira yandinofanira kufamba nayo,","poem":1},{"text":"nokuti ndinosimudzira mweya wangu kwamuri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndinunurei kubva kuvavengi vangu, imi Jehovha,","poem":1},{"text":"nokuti ndinozvivanza mamuri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndidzidzisei kuita kuda kwenyu,","poem":1},{"text":"nokuti muri Mwari wangu;","poem":2},{"text":"mweya wenyu wakanaka","poem":1},{"text":"ngaunditungamirire panzira yakati chechetere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Haiwa Jehovha, chengetedzai upenyu hwangu nokuda kwezita renyu;","poem":1},{"text":"ndibudisei panhamo, mukururama kwenyu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nyaradzai vavengi vangu, murudo rwenyu rusingaperi;","poem":1},{"text":"paradzai vavengi vangu vose,","poem":2},{"lineBreak":true},{"text":"nokuti ndiri muranda wenyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}