{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Jehovha Dombo rangu ngaarumbidzwe,","poem":1},{"text":"iye anodzidzisa","poem":2},{"lineBreak":true},{"text":"maoko angu kurwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndiye Mwari anondida uye nhare yangu,","poem":1},{"text":"shongwe yangu nomudzikinuri wangu,","poem":2},{"text":"nenhoo yangu uye ndinovanda maari,","poem":1},{"text":"iye anoisa marudzi pasi pangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Haiwa Jehovha, munhu chiiko zvamune hanya naye?","poem":1},{"text":"Kana mwanakomana womunhu zvamunomufunga?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Munhu akafanana nomweya wokufema;","poem":1},{"text":"mazuva ake akaita somumvuri unopfuura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zarurai matenga enyu, imi Jehovha, uye muburuke;","poem":1},{"text":"batai makomo, kuti apfungaire utsi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tumirai mheni mugoparadzira vavengi;","poem":1},{"text":"pfurai miseve yenyu mugovapedza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tambanudzai ruoko rwenyu kubva kumusoro;","poem":1},{"text":"ndirwirei uye mundinunure","poem":2},{"text":"kubva pamvura zhinji ine simba,","poem":1},{"text":"kubva mumaoko avatorwa","poem":2}]},{"type":"verse","number":8,"content":[{"text":"vane miromo izere nenhema,","poem":1},{"text":"maoko avo orudyi anonyengera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Haiwa Mwari, ndichakuimbirai rwiyo rutsva;","poem":1},{"text":"ndichakuimbirai nziyo dzokurumbidza nomutengeranwa une hungiso gumi,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"iye anopa kukunda kumadzimambo,","poem":1},{"text":"anorwira muranda wake Dhavhidhi kubva pamunondo unouraya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ndirwirei uye mundinunure","poem":1},{"text":"kubva pamaoko avatorwa,","poem":2},{"text":"vane miromo izere nenhema,","poem":1},{"text":"vane maoko orudyi anonyengera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ipapo vanakomana vedu pauduku","poem":1},{"text":"hwavo vachava semiti yakakura zvakanaka,","poem":2},{"text":"uye vanasikana vedu vachava sembiru dzakavezwa","poem":1},{"text":"kuti dzishongedze muzinda wamambo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Matura edu achazadzwa","poem":1},{"text":"nemhando dzose dzezviyo.","poem":2},{"text":"Makwai edu achawanda nezviuru,","poem":1},{"text":"nezviuru gumi mumafuro edu;","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nzombe dzedu dzichatakura mitoro inorema.","poem":2},{"text":"Hapachazova nokuputswa kwamasvingo,","poem":1},{"text":"hapachazova nokuenda kuutapwa,","poem":2},{"lineBreak":true},{"text":"hapachazova nokuchema nenhamo, munzira dzedu dzomumisha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Vakaropafadzwa vanhu avo vachaitirwa saizvozvi;","poem":1},{"text":"vakaropafadzwa vanhu avo vana Jehovha Mwari wavo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}