{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["Pisarema rokurumbidza, raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndichakukudzai, Mwari wangu Mambo;","poem":1},{"text":"ndicharumbidza zita renyu nokusingaperi-peri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichakurumbidzai mazuva ose,","poem":1},{"text":"uye ndichakudza zita renyu nokusingaperi-peri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jehovha mukuru uye akafanira kurumbidzwa;","poem":1},{"text":"ukuru hwake hahunganzverwi nomunhu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Rumwe rudzi rucharumbidza mabasa enyu kuno rumwe;","poem":1},{"text":"vachareva zvamabasa enyu esimba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vachataura nezvokunaka kwokubwinya kwoumambo hwenyu,","poem":1},{"text":"uye ndichafungisisa pamusoro pemabasa enyu anoshamisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vanhu vachataura nezvesimba ramabasa enyu anotyisa,","poem":1},{"text":"uye ndichaparidza mabasa enyu makuru.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vachapemberera kuwanda kwokunaka kwenyu,","poem":1},{"text":"uye vachaimba nomufaro pamusoro pokururama kwenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehovha ane nyasha uye ane tsitsi,","poem":1},{"text":"anononoka kutsamwa uye azere norudo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jehovha akanaka kuna vose;","poem":1},{"text":"uye ane nyasha pamusoro pezvose zvaakaita.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zvose zvamakaita zvichakurumbidzai, imi Jehovha;","poem":1},{"text":"vatsvene venyu vachakukudzai.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vachataura nezvokubwinya kwoumambo hwenyu,","poem":1},{"text":"uye vachataura nezvesimba renyu,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kuitira kuti vanhu vose vazive nezvamabasa enyu makuru,","poem":1},{"text":"nokunaka kwokubwinya kwoumambo hwenyu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Umambo hwenyu umambo hwokusingaperi,","poem":1},{"text":"uye ushe hwenyu hunogara kusvikira kuzvizvarwa zvose.","poem":2},{"lineBreak":true},{"text":"Jehovha akatendeka pavimbiso dzake dzose,","poem":1},{"text":"uye ane rudo kuzvinhu zvose zvaakaita.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jehovha anotsigira vose vanowa,","poem":1},{"text":"uye anosimudza vose vakakotamiswa pasi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Meso avose anotarira kwamuri,","poem":1},{"text":"uye munovapa zvokudya zvavo nenguva yakafanira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Munozarura ruoko rwenyu, uye munogutsa zvisikwa zvipenyu zvose nezvazvinoda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Jehovha akarurama panzira dzake dzose, uye ane rudo kuzvinhu zvose zvaakaita.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Jehovha ari pedyo navose vanodana kwaari, kuna vose vanodana kwaari muchokwadi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Anozadzisa zvido zvaavo vanomutya;","poem":1},{"text":"anonzwa kuchema kwavo uye anovaponesa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Jehovha anochengeta vose vanomuda,","poem":1},{"text":"asi achaparadza vakaipa vose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Muromo wangu uchataura kurumbidzwa kwaJehovha.","poem":1},{"text":"Zvisikwa zvose ngazvirumbidze zita rake dzvene","poem":2},{"lineBreak":true},{"text":"nokusingaperi-peri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}