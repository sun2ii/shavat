{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Rumbidza Jehovha.","poem":1},{"lineBreak":true},{"text":"Rumbidza Jehovha, iwe mweya wangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ndicharumbidza Jehovha mazuva ose oupenyu hwangu;","poem":1},{"text":"ndichaimbira Mwari wangu nziyo dzokurumbidza ndichiri mupenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Regai kuvimba namachinda,","poem":1},{"text":"navanhu vanofa, vasingagoni kuponesa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mweya yavo painoenda, ivo vanodzokera kuvhu;","poem":1},{"text":"pazuva racho iroro urongwa hwavo hunova pasina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Akaropafadzwa munhu uyo ano mubatsiri wake Mwari waJakobho,","poem":1},{"text":"tariro yake iri muna Jehovha Mwari wake,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Muiti wedenga nenyika,","poem":1},{"text":"gungwa uye nezvose zviri mariri, iye Jehovha,","poem":2},{"lineBreak":true},{"text":"anogara akatendeka nokusingaperi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anomiririra zvinodiwa nevakadzvinyirirwa,","poem":1},{"text":"uye anopa zvokudya vane nzara.","poem":2},{"text":"Jehovha anosunungura vasungwa.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Jehovha anosvinudza mapofu,","poem":2},{"text":"Jehovha anosimudza avo vakakotamiswa pasi,","poem":1},{"text":"Jehovha anoda vakarurama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jehovha anorinda vatorwa","poem":1},{"text":"uye anoriritira nherera nechirikadzi,","poem":2},{"lineBreak":true},{"text":"asi anokonesa nzira dzavakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jehovha anotonga nokusingaperi,","poem":1},{"text":"Mwari wako, iwe Zioni, kuzvizvarwa zvose.","poem":2},{"lineBreak":true},{"text":"Rumbidza Jehovha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}