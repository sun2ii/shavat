{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Rumbidzai Jehovha.","poem":1},{"lineBreak":true},{"text":"Zvakanaka sei kuimbira Mwari wedu nziyo dzokurumbidza,","poem":1},{"text":"zvinofadza uye zvakafanira sei kumurumbidza!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jehovha anovaka Jerusarema;","poem":1},{"text":"anounganidza vakadzingwa vaIsraeri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anoporesa vane mwoyo yakaputsika,","poem":1},{"text":"uye anosunga maronda avo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Anotara kuwanda kwenyeredzi,","poem":1},{"text":"anodana imwe neimwe nezita rayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ishe wedu mukuru uye ane simba guru;","poem":1},{"text":"kunzwisisa kwake hakuperi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jehovha anotsigira vanozvininipisa,","poem":1},{"text":"asi anowisira pasi vakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Imbirai Jehovha nokuvonga;","poem":1},{"text":"muimbire Mwari wedu nziyo dzokurumbidza nembira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anofukidza denga namakore;","poem":1},{"text":"anopa nyika mvura,","poem":2},{"lineBreak":true},{"text":"uye anomeresa uswa pazvikomo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anopa mombe zvokudya","poem":1},{"text":"navana vamakunguo pavanochema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mufaro wake hausi musimba rebhiza,","poem":1},{"text":"uye mufaro wake hausi pamakumbo omunhu;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehovha anofadzwa naavo vanomutya,","poem":1},{"text":"vanoisa tariro yavo parudo rwake rusingaperi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kudza Jehovha, iwe Jerusarema;","poem":1},{"text":"rumbidza Mwari wako, iwe Zioni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"nokuti anosimbisa mazariro amasuo ako,","poem":1},{"text":"uye anoropafadza vanhu vako vari mauri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anopa rugare pamiganhu yako,","poem":1},{"text":"uye anokugutsa nezviyo zvakaisvonaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Anotuma murayiro wake kunyika;","poem":1},{"text":"shoko rake rinomhanya kwazvo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Anowarira chando samakushe amakwai,","poem":1},{"text":"uye anoparadzira chando samadota.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Anokanda chimvuramabwe pasi sezvimedu.","poem":1},{"text":"Ndianiko angamira kana chando chake charova?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anotuma shoko rake rigozvinyungudisa;","poem":1},{"text":"anomutsa mhepo yake, mvura zhinji igoerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Akazarurira Jakobho shoko rake,","poem":1},{"text":"mirayiro yake nezvirevo zvake kuna Israeri.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Haana kumboita izvi kuno rumwe rudzi;","poem":1},{"text":"havazivi mirayiro yake.","poem":2},{"lineBreak":true},{"text":"Rumbidzai Jehovha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}