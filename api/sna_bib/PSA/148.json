{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Rumbidzai Jehovha.","poem":1},{"lineBreak":true},{"text":"Rumbidzai Jehovha kubva kumatenga,","poem":1},{"text":"murumbidzei panzvimbo dzokumusoro-soro.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Murumbidzei, imi vatumwa vake vose,","poem":1},{"text":"murumbidzei, imi hondo dzake dzose dzokudenga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Murumbidzei, imi zuva nomwedzi,","poem":1},{"text":"murumbidzei, imi nyeredzi dzose dzinopenya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Murumbidzei, imi matenga ari kumusoro-soro,","poem":1},{"text":"nemi mvura zhinji iri pamusoro pamatenga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngazvirumbidze zita raJehovha,","poem":1},{"text":"nokuti akarayira, izvo zvikasikwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akazviisa panzvimbo yazvo nokusingaperi-peri,","poem":1},{"text":"akapa chirevo chisingazombopfuuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rumbidzai Jehovha imi nyika,","poem":1},{"text":"imi zvisikwa zvikuru zvegungwa nokwakadzika kwenyanza,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"nemi mheni nechimvuramabwe, chando namakore,","poem":1},{"text":"dutu remhepo rinoita zvaakareva,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"imi makomo nemi zvikomo zvose,","poem":1},{"text":"miti inobereka nemisidhari yose,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"mhuka dzesango nemombe dzose,","poem":1},{"text":"zvisikwa zvidiki neshiri dzinobhururuka,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Madzimambo enyika nendudzi dzose,","poem":1},{"text":"imi machinda nemi vatongi vose panyika,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"majaya nemhandara,","poem":1},{"text":"vatana navana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngavarumbidze zita raJehovha,","poem":1},{"text":"nokuti zita rake iye oga iguru;","poem":2},{"lineBreak":true},{"text":"kubwinya kwake kuri pamusoro penyika namatenga.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akasimudzira vanhu vake runyanga,","poem":1},{"text":"iyo rumbidzo yavatsvene vake vose,","poem":2},{"lineBreak":true},{"text":"yaIsraeri, vanhu vari pedyo nomwoyo wake.","poem":2},{"lineBreak":true},{"text":"Rumbidzai Jehovha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}