{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["Mikitami raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndichengetedzei, imi Mwari,","poem":1},{"text":"nokuti ndinovanda mamuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ndakati kuna Jehovha, “Ndimi Ishe wangu;","poem":1},{"text":"kunze kwenyu handina chinhu chakanaka.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kana vari vatsvene vari panyika,","poem":1},{"text":"ndivo vakaisvonaka vandinofarira chose.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuchema kuchawedzerwa,","poem":1},{"text":"kwaavo vanomhanyira vamwe vamwari.","poem":2},{"text":"Handichazodiri zvipiriso zvavo zveropa","poem":1},{"text":"zvinodururwa kana kuisa mazita avo pamiromo yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jehovha, makandigovera mugove wangu nomukombe wangu;","poem":1},{"text":"mukaita kuti mugove wangu uchengetedzeke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndakayererwa miganhu panzvimbo yakanaka;","poem":1},{"text":"zvirokwazvo ndine nhaka inofadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ndicharumbidza Jehovha, anondipa zano;","poem":1},{"text":"kunyange usiku mwoyo wangu unondirayira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndakaisa Jehovha pamberi pangu nguva dzose.","poem":1},{"text":"Nokuti ari kurudyi rwangu,","poem":2},{"lineBreak":true},{"text":"handingatongozungunuswi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Naizvozvo mwoyo wangu unofara uye rurimi rwangu runopururudza;","poem":1},{"text":"muviri wanguwo uchazorora zvakanaka,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"nokuti imi hamuzondisiyi muguva,","poem":1},{"text":"kana kurega Mutsvene wenyu achiona kuora.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Makandizivisa nzira youpenyu;","poem":1},{"text":"muchandizadza nomufaro uri pamberi penyu,","poem":2},{"lineBreak":true},{"text":"nezvinofadza zvisingaperi muruoko rwenyu rworudyi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}