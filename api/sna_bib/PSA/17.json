{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"hebrew_subtitle","content":["Munyengetero waDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Inzwai, imi Jehovha, mukumbiro wangu wakarurama;","poem":1},{"text":"inzwai kuchema kwangu.","poem":2},{"text":"Rerekerai nzeve yenyu kumunyengetero wangu,","poem":1},{"text":"usingabvi pamiromo inonyengera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kururamiswa kwangu ngakubve kwamuri;","poem":1},{"text":"meso enyu ngaaone zvakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kunyange mukaedza mwoyo wangu uye mukandiongorora usiku,","poem":1},{"text":"kunyange mukandiedza, hamungawani chinhu;","poem":2},{"lineBreak":true},{"text":"ndakazvisunga kuti muromo wangu urege kutadza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kana ari mabasa avanhu,","poem":1},{"text":"neshoko remiromo yenyu,","poem":2},{"text":"ndakanzvenga nzira","poem":1},{"text":"dzouyo anoita nechisimba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nhambwe dzangu dzakarambira panzira dzenyu;","poem":1},{"text":"tsoka dzangu hadzina kutedzemuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Haiwa Mwari, ndinodana kwamuri, nokuti muchandipindura;","poem":1},{"text":"rerekerai nzeve yenyu kwandiri, munzwe munyengetero wangu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ratidzai kushamisa kworudo rwenyu rukuru,","poem":1},{"text":"imi munoponesa noruoko rwenyu rworudyi,","poem":2},{"lineBreak":true},{"text":"avo vanovanda vavengi vavo mamuri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndichengetei semboni yeziso renyu;","poem":1},{"text":"ndivanzei pasi pomumvuri wamapapiro enyu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kubva kuno wakaipa anondirwisa,","poem":1},{"text":"kubva kuvavengi vangu, vanoda kundiuraya, vakandikomberedza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vanodzivira mwoyo yavo yakavangarara,","poem":1},{"text":"uye miromo yavo inotaura nokuzvikudza.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vakandironda, zvino vandikomba,","poem":1},{"text":"vanocherechedza nameso avo kuti vandiwisire pasi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vakaita seshumba ine nzara yechokudya,","poem":1},{"text":"seshumba huru yakavandira pakavanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Haiwa, Jehovha, simukai, mirai pamberi pavo,","poem":1},{"text":"vawisirei pasi; ndirwirei nomunondo wenyu pano wakaipa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Haiwa, Jehovha, ndiponesei noruoko rwenyu kubva kuvanhu vakadai,","poem":1},{"text":"kubva kuvanhu venyika ino vano mubayiro uri muupenyu huno.","poem":2},{"lineBreak":true},{"text":"Munopedza nzara yaavo vamunoda;","poem":1},{"lineBreak":true},{"text":"vanakomana vavo vane zvakawanda,","poem":1},{"text":"uye vanounganidzira vana vavo pfuma.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zvino ini mukururama, ndichaona chiso chenyu;","poem":1},{"text":"pandinomuka, ndichagutswa nokuona mufananidzo wenyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}