{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":18,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi muranda waJehovha. Akaimbira Jehovha mashoko orwiyo urwu paakarwirwa naJehovha kubva mumaoko avavengi vake vose nomuruoko rwaSauro. Akati:"]},{"type":"verse","number":1,"content":[{"text":"Ndinokudai, imi Jehovha, simba rangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jehovha ndiye dombo rangu, nhare yangu, murwiri wangu;","poem":1},{"text":"Mwari wangu ndiye dombo rangu, wandinovanda maari.","poem":2},{"lineBreak":true},{"text":"Ndiye nhoo yangu norunyanga rworuponeso rwangu, shongwe yangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndinodana kuna Jehovha, iye akafanira kurumbidzwa,","poem":1},{"text":"uye ndinoponeswa kubva kuvavengi vangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mabote orufu akandipinganidza;","poem":1},{"text":"mvura zhinji inoparadza yakandifukidza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mabote eguva akandimonera;","poem":1},{"text":"misungo yorufu yakanangana neni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pakutambudzika kwangu ndakadana kuna Jehovha;","poem":1},{"text":"ndakadana kuna Mwari wangu kuti ndibatsirwe.","poem":2},{"text":"Akanzwa inzwi rangu ari mutemberi yake;","poem":1},{"text":"kuchema kwangu kwakasvika pamberi pake munzeve dzake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nyika yakadedera ikadengenyeka,","poem":1},{"text":"uye nheyo dzamakomo dzakazunguzika;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Utsi hwakakwira huchibva mumhino dzake;","poem":1},{"text":"moto unoparadza wakabuda mumuromo make,","poem":2},{"lineBreak":true},{"text":"mazimbe anopisa akabuda mauri achipfuta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akatsemura matenga akauya pasi;","poem":1},{"text":"makore erima akanga ari pasi petsoka dzake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akatasva makerubhi akabhururuka;","poem":1},{"text":"akabhururuka pamapapiro emhepo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akaita rima chifukidzo chake, denga rake rakamupoteredza,","poem":1},{"text":"iwo makore matema emvura okudenga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nokupenya kwaibva pamberi pake, makore akabuda akafamba,","poem":1},{"text":"nechimvuramabwe nokupenya kwemheni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jehovha akatinhira kudenga;","poem":1},{"text":"inzwi roWokumusoro-soro rikanzwika.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akapfura miseve yake akaparadzira vavengi vake,","poem":1},{"text":"kupenya kukuru kwemheni kukavavhundutsa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mipata yegungwa yakaiswa pachena,","poem":1},{"text":"uye nheyo dzenyika dzakaiswa pachena","poem":2},{"text":"pakutuka kwenyu, imi Jehovha,","poem":1},{"text":"nokufema kwemhino dzenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Akadzika pasi achibva kumusoro akanditora;","poem":1},{"text":"akandibudisa pamvura zhinji yakadzika.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akandinunura kubva kuvavengi vangu vane simba,","poem":1},{"text":"kubva kuvadzivisi vangu, vakanga vakasimba zvikuru kwandiri.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vakandinanga pazuva renjodzi yangu,","poem":1},{"text":"asi Jehovha akanga ari mutsigiri wangu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Akandibudisa akandiisa panzvimbo yakafarikana;","poem":1},{"text":"akandinunura nokuti akanga achindifarira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Jehovha akandiitira zvakafanira kururama kwangu;","poem":1},{"text":"nokuchena kwamaoko angu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nokuti ndakachengeta nzira dzaJehovha;","poem":1},{"text":"handina kuita zvakaipa nokubva pana Mwari wangu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mirayiro yake yose iri pamberi pangu;","poem":1},{"text":"handina kutsauka pazvirevo zvake.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndakanga ndisina chandingapomerwa pamberi pake,","poem":1},{"text":"uye ndakazvichengeta kuti ndigare kure nechivi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Jehovha akandipa mubayiro zvakaringana nokururama kwangu,","poem":1},{"text":"zvakaringana nokuchena kwamaoko angu pamberi pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kuna vakatendeka munoratidza kutendeka kwenyu,","poem":1},{"text":"kuna vasina chavangapomerwa munoratidza kusapomerwa kwenyu,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kuna vakachena munoratidza kuchena kwenyu,","poem":1},{"text":"asi kuna vakatsauka munoratidza hasha dzenyu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Munoponesa vanozvininipisa,","poem":1},{"text":"asi muchideredza vane meso anozvikudza.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Imi, iyemi Jehovha, munoita kuti mwenje wangu urambe uchipfuta;","poem":1},{"text":"Mwari wangu anoshandura rima rangu richiva chiedza.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Norubatsiro rwenyu ndichaenda kundorwa hondo;","poem":1},{"text":"naMwari wangu ndinogona kukwira rusvingo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kana ari Mwari, nzira yake yakakwana;","poem":1},{"text":"shoko raJehovha harina charingapomerwa.","poem":2},{"text":"Ndiye nhoo","poem":1},{"text":"yavose vanovanda maari.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nokuti ndianiko Mwari kunze kwaJehovha?","poem":1},{"text":"Uye ndianiko Dombo kunze kwaMwari wedu?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"NdiMwari anondishongedza nesimba","poem":1},{"text":"uye anokwanisa nzira yangu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Anoita kuti tsoka dzangu dzive setsoka dzenondo;","poem":1},{"text":"anoita kuti ndigone kumira pakakwirira.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Anodzidzisa maoko angu kurwa;","poem":1},{"text":"maoko angu anowembura uta hwendarira.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Munondipa nhoo yenyu yokukunda,","poem":1},{"text":"uye ruoko rwenyu rworudyi runonditsigira;","poem":2},{"lineBreak":true},{"text":"munokotama pasi kuti mundiite mukuru.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Munondiitira nzira yakapamhama pasi pangu,","poem":1},{"text":"kuitira kuti zvitsitsinho zvangu zvirege kutedzemuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Ndakatevera vavengi vangu ndikavabata;","poem":1},{"text":"handina kudzokera shure kusvikira vaparadzwa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ndakavapwanya kuti vakoniwe kusimuka;","poem":1},{"text":"vakawira pasi petsoka dzangu.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Makandishongedza nesimba rokurwa;","poem":1},{"text":"makaita kuti vadzivisi vangu vapfugame patsoka dzangu.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Makaita kuti vavengi vangu vatize,","poem":1},{"text":"uye ndakaparadza vavengi vangu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Vakachemera kubatsirwa, asi hakuna akavaponesa,","poem":1},{"text":"kunyange kuna Jehovha, asi haana kuvapindura.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Ndakavapura vakatsetseka seguruva ratakurwa nemhepo;","poem":1},{"text":"ndakavadururira pasi sedope renzira dzomumusha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Makandirwira pakurwisa kwavanhu;","poem":1},{"text":"makandiita musoro wendudzi;","poem":2},{"lineBreak":true},{"text":"vanhu vandakanga ndisingazivi vava varanda vangu.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Pavanongondinzwa, vanonditeerera;","poem":1},{"text":"vatorwa vanokotama pamberi pangu.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Vose vanoora mwoyo;","poem":1},{"lineBreak":true},{"text":"vanouya vachibva panhare dzavo vachidedera.","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Jehovha mupenyu! Dombo rangu ngarirumbidzwe!","poem":1},{"text":"Ngaakudzwe Mwari Muponesi wangu!","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Ndiye Mwari anonditsivira,","poem":1},{"text":"anoisa ndudzi pasi pangu,","poem":2}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"anondiponesa pavavengi vangu.","poem":2},{"text":"Makandisimudzira pamusoro pavavengi vangu.","poem":1},{"text":"Makandinunura kubva kuvanhu vechisimba.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Naizvozvo ndichakurumbidzai pakati pendudzi, imi Jehovha;","poem":1},{"text":"ndichaimbira zita renyu nziyo dzokurumbidza.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Anopa mambo wake kukunda kukuru;","poem":1},{"text":"anoratidza unyoro hwake husingaperi kumuzodziwa wake,","poem":2},{"lineBreak":true},{"text":"kuna Dhavhidhi nokuvana vake nokusingaperi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}