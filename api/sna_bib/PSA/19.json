t":"Rinobuda kuno rumwe rutivi rwedenga","poem":1},{"text":"richitenderera kusvikira kuno rumwe rutivi;","poem":2},{"lineBreak":true},{"text":"hakuna chinhu chakavanzika kubva pakupisa kwaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Murayiro waJehovha wakakwana,","poem":1},{"text":"unomutsiridza mweya.","poem":2},{"text":"Zvirevo zvaJehovha zvakavimbika,","poem":1},{"text":"zvinopa njere kuna vasina mano.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zvirevo zvaJehovha zvakarurama,","poem":1},{"text":"zvinopa mufaro kumwoyo.","poem":2},{"text":"Murayiro waJehovha unopenya,","poem":1},{"text":"unopa chiedza kumaziso.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kutya Jehovha kwakanaka,","poem":1},{"text":"kunogara nokusingaperi.","poem":2},{"text":"Zvakatongwa naJehovha ndezvechokwadi","poem":1},{"text":"uye zvose zvakarurama.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zvinokosha kupfuura goridhe,","poem":1},{"text":"kupfuura goridhe rakanatswa;","poem":2},{"text":"zvinotapira kupfuura uchi,","poem":1},{"text":"kupinda uchi hwabva muzinga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Muranda wenyu anoyambirwa nazvo;","poem":1},{"text":"pakuzvichengeta pano mubayiro mukuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndianiko angaziva kukanganisa kwake?","poem":1},{"text":"Ndikanganwirei mhosva dzangu dzakavanzika.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dzorai muranda wenyu kubva pakutadza nobwoni;","poem":1},{"text":"ngazvirege kuva nesimba pamusoro pangu.","poem":2},{"text":"Ipapo handizovi nemhosva,","poem":1},{"text":"ndisina mhaka yokudarika kukuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mashoko omuromo wangu nokurangarira kwomwoyo wangu","poem":1},{"text":"ngazvifadze pamberi penyu,","poem":2},{"lineBreak":true},{"text":"imi Jehovha, Dombo rangu noMudzikinuri wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}