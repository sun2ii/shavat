{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ndudzi dzinoitireiko bope?","poem":1},{"text":"Uye vanhu vanofungireiko zvisina maturo?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Madzimambo enyika azvigadzirira","poem":1},{"text":"uye vabati vanoungana pamwe chete","poem":2},{"text":"kuti vazorwa naJehovha,","poem":1},{"text":"uye kuti vazorwisa Muzodziwa Wake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vanoti, “Ngatidamburei ngetani dzavo,","poem":1},{"text":"tigorasa mabote avo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iye agere pachigaro choushe chokudenga anoseka;","poem":1},{"text":"Ishe anovadadira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ipapo anovatuka mukutsamwa kwake","poem":1},{"text":"uye anovavhundutsa muhasha dzake, achiti,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ndakagadza Mambo wangu","poem":1},{"text":"paZioni, gomo rangu dzvene.”","poem":2}]},{"type":"verse","number":7,"content":["Ndichaparidza chirevo chaJehovha, ndichiti:",{"text":"Iye akati kwandiri, “Ndiwe Mwanakomana wangu;","poem":1},{"text":"nhasi ndava Baba vako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kumbira kwandiri,","poem":1},{"text":"uye ndichaita kuti ndudzi dzive nhaka yako,","poem":2},{"lineBreak":true},{"text":"migumo yenyika ive yako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uchavatonga netsvimbo yesimbi;","poem":1},{"text":"uchavaputsa kuita zvimedu zvimedu sehari.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Naizvozvo, imi madzimambo, ngwarai;","poem":1},{"text":"munyeverwe, imi vabati venyika.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shumirai Jehovha nokutya,","poem":1},{"text":"uye mufare nokudedera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tsvodai Mwanakomana, kuti arege kutsamwa","poem":1},{"text":"mukazoparadzwa munzira yenyu,","poem":2},{"text":"nokuti hasha dzake dzingakurumidza kumuka.","poem":1},{"text":"Vakaropafadzwa vose vanovanda maari.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}