{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Jehovha ngaakupindure paunotambudzika;","poem":1},{"text":"zita raMwari waJakobho ngarikudzivirire.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngaakutumire rubatsiro runobva panzvimbo tsvene,","poem":1},{"text":"uye akupe rutsigiro runobva kuZioni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngaarangarire zvibayiro zvako zvose","poem":1},{"text":"uye agogamuchira zvibayiro zvako zvinopiswa. Sera","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngaakupe zvinodikanwa nomwoyo wako,","poem":1},{"text":"uye aite kuti urongwa hwako hwose hubudirire.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tichadanidzira nomufaro pakukunda kwako,","poem":1},{"text":"uye tichasimudza mireza yedu muzita raMwari wedu.","poem":2},{"lineBreak":true},{"text":"Jehovha ngaakupe zvose zvawakakumbira.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Zvino ndava kuziva kuti Jehovha anoponesa muzodziwa wake;","poem":1},{"text":"anomupindura ari kudenga rake dzvene,","poem":2},{"lineBreak":true},{"text":"nesimba rokuponesa kworuoko rwake rworudyi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vamwe vanovimba nengoro, vamwe namabhiza,","poem":1},{"text":"asi isu tinovimba nezita raJehovha Mwari wedu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanowisirwa pasi namabvi avo vagowa,","poem":1},{"text":"asi isu tinosimuka tigomira takasimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Haiwa Jehovha, ponesai mambo!","poem":1},{"text":"Tipindurei patinodana!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}