{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, mambo anofara musimba renyu.","poem":1},{"text":"Mufaro wake mukuru sei pakukunda kwamunomupa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Makamupa zvinodikanwa nomwoyo wake,","poem":1},{"text":"uye hamuna kumunyima zvaikumbirwa nomuromo wake. Sera","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Makamugamuchira nemikomborero yakapfuma,","poem":1},{"text":"uye makadzika pamusoro pake korona yegoridhe yakachena.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akakukumbirai upenyu, mukamupa mazuva","poem":1},{"text":"mazhinji, nokusingaperi-peri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kubudikidza nokukunda kwamakamupa,","poem":1},{"text":"kukudzwa kwake kukuru; makaisa pamusoro pake kubwinya nokukudzwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zvirokwazvo makamupa maropafadzo anogara nokusingaperi,","poem":1},{"text":"mukamufadza nomufaro pamberi penyu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nokuti mambo anovimba naJehovha;","poem":1},{"text":"nokuda kworudo rusingaperi rwoWokumusoro-soro,","poem":2},{"lineBreak":true},{"text":"iye haangazungunuswi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ruoko rwenyu ruchabata vavengi venyu vose;","poem":1},{"lineBreak":true},{"text":"ruoko rwenyu rworudyi ruchabata vavengi venyu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Panguva yokuonekwa kwenyu","poem":1},{"text":"muchavaita sevira romoto.","poem":2},{"text":"Jehovha achavamedza nehasha dzake,","poem":1},{"text":"uye moto wake uchavaparadza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Muchaparadza zvizvarwa zvavo kubva panyika,","poem":1},{"text":"vana vavo kubva pakati pavanhu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kunyange vachirangana zvakaipa pamusoro penyu","poem":1},{"text":"nokufunga mano akaipa, havangagoni kubudirira;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"nokuti muchaita kuti vafuratire,","poem":1},{"text":"pamuchavananga nouta hwakawemburwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Simudzirwai, imi Jehovha, musimba renyu;","poem":1},{"text":"tichaimba uye ticharumbidza simba renyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}