{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Namaimbirwo e“Nondo yamangwanani.” Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Mwari wangu, Mwari wangu, mandisiyireiko?","poem":1},{"text":"Sei muri kure zvakadai nokundiponesa,","poem":2},{"lineBreak":true},{"text":"kure zvakadai namashoko okugomera kwangu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haiwa Mwari wangu, ndinodanidzira masikati,","poem":1},{"text":"asi hamundipinduri, nousiku, uye handinyarari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Asi imi makagadzwa saIye Mutsvene;","poem":1},{"text":"ndimi rumbidzo yaIsraeri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Madzibaba edu akavimba nemi;","poem":1},{"text":"vakavimba, uye mukavarwira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vakachema kwamuri, vakaponeswa;","poem":1},{"text":"vakavimba nemi uye havana kunyadziswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Asi ini ndiri honye kwete munhu,","poem":1},{"text":"ndinozvidzwa navanhu uye ndinoshorwa namarudzi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vose vanondiona vanondiseka;","poem":1},{"text":"vanoshamisa miromo yavo vachindituka, vachidzungudza misoro yavo vachiti,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Anovimba naJehovha;","poem":1},{"text":"Jehovha ngaamununure.","poem":2},{"text":"Ngaamuponese,","poem":1},{"text":"sezvo achimufarira.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Asi ndimi makandibudisa mudumbu;","poem":1},{"text":"mukaita kuti ndivimbe nemi","poem":2},{"lineBreak":true},{"text":"ndichiri pachipfuva chamai vangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubva pakuzvarwa kwangu, ndakaiswa kwamuri;","poem":1},{"text":"kubva mudumbu ramai vangu, makanga muchingova Mwari wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Regai kuva kure neni,","poem":1},{"text":"nokuti dambudziko riri pedyo","poem":2},{"lineBreak":true},{"text":"uye hakuna angabatsira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hando zhinji dzakandikomba;","poem":1},{"text":"hando dzine simba dzeBhashani dzakandipoteredza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shumba dzinoomba dzichibvambura nyama,","poem":1},{"text":"dzinondishamira miromo yadzo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndadururwa semvura,","poem":1},{"text":"uye mapfupa angu ose abva asvodogoka.","poem":2},{"text":"Mwoyo wangu washanduka ukava namo;","poem":1},{"text":"wanyungudika mukati mangu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Simba rangu raoma sechaenga,","poem":1},{"text":"uye rurimi rwangu runonamatira kumusoro kwomuromo wangu;","poem":2},{"lineBreak":true},{"text":"munondiradzika muguruva rorufu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Imbwa dzakandikomba;","poem":1},{"text":"boka ravanhu vakaipa rakandipoteredza,","poem":2},{"lineBreak":true},{"text":"vakabvoora maoko angu netsoka dzangu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndinokwanisa kuverenga mapfupa angu ose;","poem":1},{"text":"vanhu vanondinanʼanidza uye vanofarira kutambudzika kwangu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vanogovana nguo dzangu pakati pavo","poem":1},{"text":"uye vanokanda mijenya nokuda kwenguo yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Asi imi, Jehovha, regai kuva kure neni;","poem":1},{"text":"imi simba rangu, kurumidzai kundibatsira.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Rwirai upenyu hwangu pamunondo,","poem":1},{"text":"ihwo upenyu hwangu hunokosha, kubva pasimba rembwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndinunurei pamuromo weshumba;","poem":1},{"text":"ndiponesei panyanga dzenyati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ndichaparidza zita renyu kuhama dzangu;","poem":1},{"text":"ndichakurumbidzai paungano.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Imi munotya Jehovha, murumbidzei!","poem":1},{"text":"Imi mose zvizvarwa zvaJakobho, mukudzei!","poem":2},{"lineBreak":true},{"text":"Mutyei, imi mose zvizvarwa zvaIsraeri!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nokuti haana kuzvidza kana kusema","poem":1},{"text":"chibayiro chaiye akatambudzwa;","poem":2},{"text":"haana kumuvanzira chiso chake,","poem":1},{"text":"asi akanzwa kuchemera kwake rubatsiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kwamuri ndiko kunobva dingindira rerumbidzo yangu paungano huru;","poem":1},{"text":"ndichazadzisa mhiko dzangu pamberi pavanokutyai.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Varombo vachadya uye vagoguta;","poem":1},{"text":"vanotsvaka Jehovha vachamurumbidza,","poem":2},{"lineBreak":true},{"text":"mwoyo yenyu ngairarame nokusingaperi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Migumo yose yenyika","poem":1},{"text":"icharangarira igodzokera kuna Jehovha,","poem":2},{"text":"uye mhuri dzendudzi dzose","poem":1},{"text":"dzichapfugama pamberi pake,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"nokuti ushe ndohwaJehovha","poem":1},{"text":"uye anotonga pamusoro pendudzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Vapfumi vose venyika vachadya","poem":1},{"text":"uye vachamunamata; vose vanoburukira muguruva vachapfugama pamberi pake,","poem":2},{"lineBreak":true},{"text":"navose vasingagoni kuzviraramisa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Vana vake vachamushumira;","poem":1},{"text":"zvizvarwa zvinotevera zvichaudzwa nezvaIshe.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Vachaparidza kururama kwake","poem":1},{"text":"kuvanhu vasati vaberekwa,","poem":2},{"lineBreak":true},{"text":"nokuti akazviita.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}