{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Nyika ndeyaJehovha, nezvose zviri mairi,","poem":1},{"text":"nyika, navose vanogaramo;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"nokuti akaiteya pamusoro pamakungwa","poem":1},{"text":"uye akaisimbisa pamusoro pemvura zhinji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ndianiko angakwira pachikomo chaJehovha?","poem":1},{"text":"Ndianiko angamira panzvimbo yake tsvene?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uyo ana maoko akachena nomwoyo wakanaka,","poem":1},{"text":"asingasimudziri mwoyo wake kuzvifananidzo,","poem":2},{"lineBreak":true},{"text":"kana kupika nhema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iye achagamuchira makomborero anobva kuna Jehovha","poem":1},{"text":"nokururamiswa kunobva kuna Mwari woruponeso rwake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ivava ndivo rudzi rwaavo vanomutsvaka,","poem":1},{"text":"ivo vanotsvaka chiso chenyu, imi Mwari waJakobho. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Simudzai misoro yenyu, imi masuo;","poem":1},{"text":"muisimudze, imi makonhi akare,","poem":2},{"lineBreak":true},{"text":"kuti Mambo wokubwinya apinde.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndianiko uyu Mambo wokubwinya?","poem":1},{"text":"Ndiye Jehovha ane simba noumhare,","poem":2},{"lineBreak":true},{"text":"Jehovha ane simba pakurwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Simudzai misoro yenyu, imi masuo;","poem":1},{"text":"muasimudze, imi makonhi akare,","poem":2},{"lineBreak":true},{"text":"kuti Mambo wokubwinya apinde.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndianiko, uyu Mambo wokubwinya?","poem":1},{"text":"Jehovha Wamasimba Ose,","poem":2},{"lineBreak":true},{"text":"ndiye Mambo wokubwinya. Sera","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}