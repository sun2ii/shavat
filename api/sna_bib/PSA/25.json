{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Jehovha, ndinosimudzira mwoyo wangu kwamuri;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"haiwa Mwari wangu, ndinovimba nemi.","poem":2},{"lineBreak":true},{"text":"Musandirega ndichinyadziswa,","poem":1},{"text":"uye musarega vavengi vangu vachindikunda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hapana munhu ane tariro mamuri","poem":1},{"text":"achanyadziswa,","poem":2},{"text":"asi vachanyadziswa","poem":1},{"text":"avo vanonyengera pasina chikonzero.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndiratidzei nzira dzenyu, imi Jehovha,","poem":1},{"text":"ndidzidzisei nzira dzenyu;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"nditungamirirei muzvokwadi yenyu mugondidzidzisa,","poem":1},{"text":"nokuti ndimi Mwari Muponesi wangu,","poem":2},{"lineBreak":true},{"text":"uye tariro yangu iri pamuri zuva rose.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rangarirai, imi Jehovha, ngoni dzenyu huru norudo,","poem":1},{"text":"nokuti zvakabvira kare.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Regai kurangarira zvivi zvouduku hwangu,","poem":1},{"text":"nenzira dzangu dzandaikumukirai nadzo;","poem":2},{"text":"ndirangarirei nokuda kworudo rwenyu,","poem":1},{"text":"nokuti makanaka, imi Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehovha akanaka uye akarurama;","poem":1},{"text":"naizvozvo anodzidzisa vatadzi nzira dzake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anotungamirira vanozvininipisa mune zvakarurama,","poem":1},{"text":"uye anovadzidzisa nzira yake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nzira dzose dzaJehovha ndedzorudo nokutendeka,","poem":1},{"text":"kuna avo vanochengeta zvirevo zvesungano yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokuda kwezita renyu, imi Jehovha,","poem":1},{"text":"kanganwirai chakaipa changu, kunyange chiri chikuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndiani, zvino, munhu anotya Jehovha?","poem":1},{"text":"Achamudzidzisa nzira yaakasarudzirwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Achararama upenyu hwake mukubudirira,","poem":1},{"text":"uye zvizvarwa zvake zvichagara nhaka yenyika.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jehovha anogara pakati pavanomutya;","poem":1},{"text":"anozivisa sungano yake kwavari.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Meso angu anoramba achitarira kuna Jehovha,","poem":1},{"text":"nokuti ndiye chete anosunungura tsoka dzangu pamusungo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dzokerai kwandiri uye mundinzwire nyasha,","poem":1},{"text":"nokuti ndiri ndoga uye ndinotambudzika.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Matambudziko omwoyo wangu awanda;","poem":1},{"text":"ndisunungurei pakurwadziwa kwangu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tarirai kutambudzika kwangu nenhamo yangu,","poem":1},{"text":"mugobvisa zvivi zvangu zvose.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tarirai kuwanda kwaita vavengi vangu,","poem":1},{"text":"uye kuti vanondivenga zvakakura sei!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Rindai upenyu hwangu mugondinunura;","poem":1},{"text":"ndirege kunyadziswa,","poem":2},{"lineBreak":true},{"text":"nokuti ndinovanda mamuri.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kusanyengera nokururama ngazvindichengete,","poem":1},{"text":"nokuti tariro yangu iri mamuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dzikinurai Israeri, imi Mwari,","poem":1},{"text":"kuti vabve mumatambudziko avo ose!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}