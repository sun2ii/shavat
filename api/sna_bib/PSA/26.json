{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Nditongerei, imi Jehovha,","poem":1},{"text":"nokuti ndakararama upenyu","poem":2},{"text":"husina chahungapomerwa;","poem":1},{"text":"ndakavimba naJehovha ndisingazungunuki.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndiedzei, imi Jehovha, ndinzverei,","poem":1},{"text":"nzverai mwoyo wangu nendangariro dzangu;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"nokuti rudo rwenyu rwuri pamberi pangu nguva dzose,","poem":1},{"text":"uye ndinogara ndichifamba muzvokwadi yenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Handigari navanhu vanonyengera,","poem":1},{"text":"kana kufambidzana navanyengeri;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ndinovenga ungano yavaiti vezvakaipa,","poem":1},{"text":"uye ndinoramba kugara navakaipa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndinoshamba maoko angu ndisina mhaka,","poem":1},{"text":"uye ndinofamba-famba paaritari yenyu, imi Jehovha,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ndichiparidza rumbidzo yenyu nenzwi guru,","poem":1},{"text":"uye ndichireva zvamabasa enyu ose anoshamisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndinoda imba yamunogara, imi Jehovha,","poem":1},{"text":"nzvimbo inogara kubwinya kwenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Regai kubatanidza mweya wangu navatadzi,","poem":1},{"text":"noupenyu hwangu navanoteura ropa,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"vana maoko akabata zvakaipa,","poem":1},{"text":"vazere nefufuro mumaoko avo orudyi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asi ini ndinogara upenyu husina chahungapomerwa;","poem":1},{"text":"ndidzikinurei uye mundinzwire ngoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tsoka dzangu dzimire pakati chechetere;","poem":1},{"text":"ndicharumbidza Jehovha paungano huru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}