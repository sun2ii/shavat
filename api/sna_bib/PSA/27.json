{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Jehovha ndiye chiedza changu noruponeso rwangu,","poem":1},{"text":"ndichagotya aniko?","poem":2},{"text":"Jehovha ndiye nhare youpenyu hwangu,","poem":1},{"text":"ndianiko wandingatya?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Vanhu vakaipa pavakauya kwandiri","poem":1},{"text":"kuzodya nyama yangu,","poem":2},{"text":"vavengi navadzivisi vangu pavanondirwisa,","poem":1},{"text":"vanogumburwa ndokuwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kunyange hondo ikandikomba,","poem":1},{"text":"mwoyo wangu haungazotyi;","poem":2},{"text":"kunyange hondo ikamuka kuzondirwisa,","poem":1},{"text":"ipapo ndichavimba naJehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chinhu chimwe chete chandinokumbira kuna Jehovha,","poem":1},{"text":"ndicho chandinotsvaka:","poem":2},{"text":"kuti ndigare mumba maJehovha","poem":1},{"text":"mazuva ose oupenyu hwangu,","poem":2},{"text":"kuti nditarire kunaka kwaJehovha","poem":1},{"text":"uye ndimutsvake mutemberi yake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nokuti zuva rokutambudzika","poem":1},{"text":"achandichengeta zvakanaka munzvimbo yaanogara;","poem":2},{"text":"achandiviga mudumba retabhenakeri yake,","poem":1},{"text":"agondikwidza pamusoro pedombo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ipapo musoro wangu uchasimudzirwa","poem":1},{"text":"pamusoro pavavengi vakandipoteredza;","poem":2},{"text":"ndichamubayira zvibayiro patabhenakeri yake nomufaro mukuru;","poem":1},{"text":"ndichaimba ndigoimbira Jehovha nziyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Inzwai inzwi rangu kana ndichidana, imi Jehovha;","poem":1},{"text":"ndinzwirei ngoni mugondipindura.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwoyo wangu unoti kwandiri, “Tsvaka chiso chake!”","poem":1},{"text":"Chiso chenyu, Jehovha, ndichachitsvaka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Regai kundivanzira chiso chenyu,","poem":1},{"text":"musadzinga muranda wenyu mukutsamwa;","poem":2},{"lineBreak":true},{"text":"makanga muri mubatsiri wangu.","poem":2},{"text":"Regai kundiramba kana kundisiya,","poem":1},{"text":"imi Mwari Muponesi wangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kunyange baba vangu namai vangu vakandisiya,","poem":1},{"text":"Jehovha achandigamuchira.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndidzidzisei nzira yenyu, imi Jehovha;","poem":1},{"text":"ndisesedzei munzira yakarurama","poem":2},{"lineBreak":true},{"text":"nokuda kwavamanikidzi vangu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Regai kundisundira kuzvido zvavavengi vangu,","poem":1},{"text":"nokuti zvapupu zvenhema zvinondimukira,","poem":2},{"lineBreak":true},{"text":"vachifemedzeka nehasha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndichine chokwadi neizvi zvokuti:","poem":1},{"text":"ndichaona kunaka kwaJehovha","poem":2},{"lineBreak":true},{"text":"munyika yavapenyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Rindira Jehovha;","poem":1},{"text":"iva nesimba,","poem":2},{"lineBreak":true},{"text":"utsunge mwoyo ugomirira Jehovha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}