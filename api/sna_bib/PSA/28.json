{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndinodana kwamuri, imi Jehovha Dombo rangu;","poem":1},{"text":"musandinyararira.","poem":2},{"text":"Nokuti kana mukaramba munyerere,","poem":1},{"text":"ini ndichaita savaya vakaburukira kugomba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inzwai kuchemera ngoni kwangu,","poem":1},{"text":"sezvo ndichichemera rubatsiro kwamuri,","poem":2},{"text":"sezvo ndichisimudza maoko angu","poem":1},{"text":"ndakatarira kuNzvimbo yenyu Tsvene-tsvene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Musandikwekweredzera kure pamwe chete navakaipa,","poem":1},{"text":"naavo vanoita zvakaipa,","poem":2},{"text":"vanotaura rugare navavakidzani vavo","poem":1},{"text":"asi vakaviga zvakaipa mumwoyo yavo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vatsivei pamabasa avo","poem":1},{"text":"napabasa ravo rakaipa,","poem":2},{"text":"vatsivei pane zvakaitwa namaoko avo;","poem":1},{"text":"mugodzosera pamusoro pavo zvakavafanira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sezvo vasina hanya namabasa aJehovha","poem":1},{"text":"uye nezvakaitwa namaoko ake,","poem":2},{"text":"achavaputsira pasi","poem":1},{"text":"akasavavakazve.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jehovha ngaarumbidzwe,","poem":1},{"text":"nokuti akanzwa kuchemera kwangu ngoni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jehovha ndiye simba rangu nenhoo yangu;","poem":1},{"text":"mwoyo wangu unovimba naye, uye ndinobatsirwa.","poem":2},{"text":"Mwoyo wangu unokwakuka nomufaro","poem":1},{"text":"uye ndichamuvonga nenziyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehovha ndiye simba ravanhu vake,","poem":1},{"text":"nhare yoruponeso yomuzodziwa wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ponesai vanhu venyu uye muropafadze nhaka yenyu;","poem":1},{"text":"ivai mufudzi wavo uye muvatakure nokusingaperi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}