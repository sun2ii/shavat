pe":"verse","number":6,"content":[{"text":"Anoita kuti Rebhanoni ikwakuke semhuru,","poem":1},{"text":"neSirioni senzombe yenyati.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inzwi raJehovha rinorova","poem":1},{"text":"nokuvaima kwemheni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inzwi raJehovha rinozungunusa gwenga;","poem":1},{"text":"Jehovha anozungunusa Gwenga reKadheshi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inzwi raJehovha rinomonyorora miouki","poem":1},{"text":"uye rinosvuura sango rigosara rati hwe-e.","poem":2},{"text":"Uye mutemberi yake zvose zvinodana zvichiti, “Kubwinya!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jehovha anogara pachigaro choushe chamafashamu emvura;","poem":1},{"text":"Jehovha anogara ari Mambo nokusingaperi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehovha anopa simba kuvanhu vake;","poem":1},{"text":"Jehovha anoropafadza vanhu vake norugare.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}