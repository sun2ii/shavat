{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi. Panguva yaakatiza Abhusaromu mwanakomana wake."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, vadzivisi vangu vakawanda sei!","poem":1},{"text":"Vakawanda sei vanondimukira!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vazhinji vanoti kwandiri,","poem":1},{"text":"“Mwari haangamudzikinuri.” Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Asi imi Jehovha, muri nhoo yakandipoteredza;","poem":1},{"text":"munoisa rukudzo pandiri uye munosimudza musoro wangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuna Jehovha ndinodana nenzwi guru,","poem":1},{"text":"uye anondipindura ari pagomo rake dzvene. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndinovata pasi ndigokotsira;","poem":1},{"text":"ndinomukazve, nokuti Jehovha anonditsigira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Handizotyi makumi ezviuru","poem":1},{"text":"vakandikomba kuti vandirwise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Simukai, imi Jehovha!","poem":1},{"text":"Ndirwirei, imi Mwari wangu!","poem":2},{"text":"Rovai vavengi vangu vose pashaya;","poem":1},{"text":"gurai meno avakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rusununguko runobva kuna Jehovha.","poem":1},{"text":"Maropafadzo enyu ngaave pamusoro pavanhu venyu. Sera","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}