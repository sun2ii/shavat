{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["Pisarema. Rwiyo rwokukumikidza temberi. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndichakukudzai imi Jehovha,","poem":1},{"text":"nokuti makandisimudza kubva pakadzika,","poem":2},{"lineBreak":true},{"text":"uye hamuna kutendera vavengi vangu kuti vafare pamusoro pangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haiwa Jehovha Mwari wangu, ndakachemera rubatsiro kwamuri","poem":1},{"text":"uye mukandiporesa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Haiwa Jehovha, makandibudisa muguva;","poem":1},{"text":"mukandirwira kuti ndirege kupinda mugomba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Imbirai Jehovha, imi vatsvene vake;","poem":1},{"text":"rumbidzai zita rake dzvene.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nokuti kutsamwa kwake ndokwenguva duku,","poem":1},{"text":"asi nyasha dzake ndedzoupenyu hwose;","poem":2},{"text":"kuchema kungangovapo usiku.","poem":1},{"text":"Asi mufaro unouya mangwanani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pandakanzwa kugadzikana, ndakati,","poem":1},{"text":"“Handingatongozungunuswi.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Haiwa Jehovha, pamakandinzwira tsitsi,","poem":1},{"text":"makaita kuti gomo rangu rimire rakasimba;","poem":2},{"text":"asi pamakavanza chiso chenyu,","poem":1},{"text":"ini ndakavhunduka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ndakadana kwamuri, imi Jehovha;","poem":1},{"text":"ndakachemera nyasha kuna Jehovha ndichiti,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Chiiko chinowanikwa pakuparadzwa kwangu,","poem":1},{"text":"napakupinda kwangu mugomba?","poem":2},{"text":"Ko, guruva richakurumbidzai here?","poem":1},{"text":"Richaparidza kutendeka kwenyu here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inzwai, imi Jehovha, mundinzwire ngoni;","poem":1},{"text":"imi Jehovha, ivai mubatsiri wangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Imi makashandura kuungudza kwangu kukava kutamba;","poem":1},{"text":"makabvisa nguo dzangu dzamasaga mukandishongedza nomufaro,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kuti mwoyo wangu ukuimbirei ugorega kunyarara.","poem":1},{"text":"Haiwa Jehovha Mwari wangu, ndichakuvongai nokusingaperi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}