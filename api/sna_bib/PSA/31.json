{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndinovanda mamuri, imi Jehovha;","poem":1},{"text":"itai kuti ndisatombonyadziswa;","poem":2},{"lineBreak":true},{"text":"ndirwirei mukururama kwenyu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rerekerai nzeve yenyu kwandiri,","poem":1},{"text":"kurumidzai kundinunura;","poem":2},{"text":"ivai dombo rangu rokuvanda,","poem":1},{"text":"nhare yakasimba inondiponesa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sezvo murimi dombo rangu nenhare yangu,","poem":1},{"text":"nditungamirirei uye mundisesedze nokuda kwezita renyu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndisunungurei pamusungo wandakadzikirwa,","poem":1},{"text":"nokuti imi muri utiziro hwangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndinoisa mweya wangu mumaoko enyu;","poem":1},{"text":"ndidzikinurei, imi Jehovha, Mwari wechokwadi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndinovenga vanonamatira kuzvifananidzo zvisina maturo;","poem":1},{"text":"ndinovimba naJehovha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndichafara nokufarisisa murudo rwenyu,","poem":1},{"text":"nokuti makaona kutambudzika kwangu","poem":2},{"lineBreak":true},{"text":"mukaziva kurwadziwa kwomwoyo wangu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hamuna kundiisa kumuvengi,","poem":1},{"text":"asi makamisa tsoka dzangu panzvimbo yakafarikana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Haiwa Jehovha, ndinzwirei ngoni nokuti ndine nhamo;","poem":1},{"text":"meso angu aneta nokuchema,","poem":2},{"lineBreak":true},{"text":"mwoyo wangu nomuviri wangu zvarwadziwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Upenyu hwangu hwopera nokurwadziwa,","poem":1},{"text":"uye namakore angu nokugomera;","poem":2},{"text":"simba rangu rapera nokuda kwokutambudzika kwangu,","poem":1},{"text":"uye mapfupa angu arukutika.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokuda kwavavengi vangu,","poem":1},{"text":"ndava chinhu chinovengwa navavakidzani vangu;","poem":2},{"text":"ndava chinhu chinotyisa kushamwari dzangu;","poem":1},{"text":"vanondiona munzira dzomumisha vanonditiza.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndakanganwikwa navo sendakafa;","poem":1},{"text":"ndafanana nehari yakaputsika,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"nokuti ndinonzwa guhwa ravazhinji;","poem":1},{"text":"kumativi ose kune zvinotyisa;","poem":2},{"text":"vanorangana pamusoro pangu","poem":1},{"text":"uye vanoronga kundiuraya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Asi ndinovimba nemi, imi Jehovha;","poem":1},{"text":"ndinoti, “Ndimi Mwari wangu.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nguva dzangu dziri mumaoko enyu;","poem":1},{"text":"ndirwirei kuvavengi vangu","poem":2},{"lineBreak":true},{"text":"nokuna avo vanonditeverera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Chiso chenyu ngachipenye pamusoro pomuranda wenyu;","poem":1},{"text":"ndiponesei norudo rwenyu rusingaperi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haiwa Jehovha, itai kuti ndisanyadziswa,","poem":1},{"text":"nokuti ndakadana kwamuri;","poem":2},{"text":"asi vakaipa ngavanyadziswe","poem":1},{"text":"uye vavate vakati mwiro muguva.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Miromo yavo inoreva nhema ngainyaradzwe,","poem":1},{"text":"nokuti vanotaura namanyawi","poem":2},{"lineBreak":true},{"text":"nokuzvikudza pamusoro pavakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Haiwa, kunaka kwenyu kukuru sei,","poem":1},{"text":"kwamakachengetera vaya vanokutyai,","poem":2},{"text":"kwamunoisa pamberi pavanhu,","poem":1},{"text":"pamusoro paivo vanovanda mamuri.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mukudzivirira kwokuvapo kwenyu munovavanza","poem":1},{"text":"kubva parangano dzavanhu;","poem":2},{"text":"munovachengeta zvakanaka pamunogara","poem":1},{"text":"kubva pandimi dzinopomera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Jehovha ngaarumbidzwe,","poem":1},{"text":"nokuti akaratidza rudo rwake runoshamisa","poem":2},{"lineBreak":true},{"text":"kwandiri pandakanga ndiri muguta rakakombwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mukuvhunduka kwangu, ndakati,","poem":1},{"text":"“Ndabviswa pamberi penyu!”","poem":2},{"text":"Asi makanzwa kuchemera nyasha kwangu","poem":1},{"text":"pandakadanidzira kwamuri ndichida rubatsiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Idai Jehovha, imi vatsvene mose!","poem":1},{"text":"Jehovha anochengetedza vakatendeka,","poem":2},{"lineBreak":true},{"text":"asi anotsiva zvizere vanozvikudza.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Simbai uye mutsunge mwoyo,","poem":1},{"text":"imi mose munorindira Jehovha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}