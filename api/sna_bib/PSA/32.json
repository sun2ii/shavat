{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi neMasikiri."]},{"type":"verse","number":1,"content":[{"text":"Akaropafadzwa uyo","poem":1},{"text":"akakanganwirwa kudarika kwake,","poem":2},{"lineBreak":true},{"text":"akafukidzirwa zvivi zvake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akaropafadzwa munhu","poem":1},{"text":"asingaverengerwi zvivi zvake naJehovha,","poem":2},{"lineBreak":true},{"text":"uye asina kunyengera mumwoyo make.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pandakanyarara,","poem":1},{"text":"mapfupa angu akarukutika nokuda","poem":2},{"lineBreak":true},{"text":"kwokugomera kwangu zuva rose.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nokuti masikati nousiku","poem":1},{"text":"ruoko rwenyu rwakanga ruchirema pamusoro pangu;","poem":2},{"text":"simba rangu rakasvetwa","poem":1},{"text":"sezvinoita kupisa kwechirimo. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ipapo ndakazivisa chivi changu kwamuri","poem":1},{"text":"uye handina kuvanza chakaipa changu.","poem":2},{"text":"Ndakati, “Ndichareurura kudarika kwangu kuna Jehovha,”","poem":1},{"text":"uye makandiregerera mhosva yechivi changu. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Naizvozvo vose vanoda Mwari ngavanyengetere kwamuri","poem":1},{"text":"muchiri kuwanikwa;","poem":2},{"text":"zvirokwazvo mvura zhinji ine simba painokwira,","poem":1},{"text":"haingasviki kwavari.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndimi nzvimbo yangu yokuvanda;","poem":1},{"text":"muchandidzivirira panhamo","poem":2},{"lineBreak":true},{"text":"uye muchandipoteredza nenziyo dzorusununguko. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ndichakurairidza uye ndichakudzidzisa nzira yaunofanira kufamba nayo;","poem":1},{"text":"ndichakupa zano uye ndichakurinda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Rega kuva sebhiza kana senyurusi,","poem":1},{"text":"zvisinganzwisisi asi zvinofanira kupingudzwa","poem":2},{"text":"nomukaro kana namatomu,","poem":1},{"text":"kana kuti hazvingauyi kwauri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wakaipa ana matambudziko mazhinji,","poem":1},{"text":"asi rudo rusingaperi rwaJehovha","poem":2},{"lineBreak":true},{"text":"runopoteredza munhu anovimba naye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Farai muna Jehovha uye mufarisise, imi vakarurama;","poem":1},{"text":"imbai, imi mose makarurama pamwoyo!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}