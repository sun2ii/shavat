{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Imbirai Jehovha, mufarisise, imi vakarurama;","poem":1},{"text":"zvakanaka kuti vakarurama vamurumbidze.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rumbidzai Jehovha nembira;","poem":1},{"text":"muimbirei nziyo nomutengeranwa une hungiso gumi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muimbirei rwiyo rutsva;","poem":1},{"text":"muridze zvakanaka, mugopururudza nomufaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nokuti shoko raJehovha rakarurama uye nderechokwadi;","poem":1},{"text":"iye akatendeka pane zvose zvaanoita.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jehovha anoda kururama nokururamisira;","poem":1},{"text":"nyika izere norudo rwake rusingaperi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kudenga denga kwakaitwa neshoko raJehovha,","poem":1},{"text":"hondo dzenyeredzi dzaikoko, nokufema kwomuromo wake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anounganidza mvura zhinji yegungwa muzvirongo;","poem":1},{"text":"anoisa kwakadzika mumatura.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nyika yose ngaitye Jehovha;","poem":1},{"text":"marudzi ose enyika ngaamuremekedze.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuti iye akataura, zvikaitika;","poem":1},{"text":"akarayira, zvikamira zvakasimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jehovha anokonesa urongwa hwendudzi;","poem":1},{"text":"anopinganidza mifungo yendudzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asi urongwa hwaJehovha hunomira hwakasimba nokusingaperi,","poem":1},{"text":"nendangariro dzomwoyo wake kusvikira kuzvizvarwa zvose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Rwakaropafadzwa rudzi rwakaita Jehovha Mwari warwo,","poem":1},{"text":"vanhu vaakasarudza kuti vave nhaka yake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jehovha anotarira pasi ari kudenga","poem":1},{"text":"uye anoona marudzi ose avanhu;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ari pachigaro chake anotarira","poem":1},{"text":"vose vagere panyika,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"iye anoumba mwoyo yavanhu vose,","poem":1},{"text":"anofungisisa zvose zvavanoita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Hapana mambo anoponeswa nokukura kwehondo yake;","poem":1},{"text":"hapana murwi anopunyuka nokuda kwesimba rake guru.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bhiza itariro isina maturo pakurwirwa;","poem":1},{"text":"harigoni kuponesa kunyange rine simba guru.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Asi meso aJehovha ari pamusoro paavo vanomutya,","poem":1},{"text":"napamusoro paavo vakaisa tariro yavo murudo rwake rusingaperi,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kuti avarwire parufu","poem":1},{"text":"nokuvararamisa panzara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tinomirira Jehovha netariro;","poem":1},{"text":"ndiye mubatsiri wedu nenhoo yedu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mwoyo yedu inofara maari,","poem":1},{"text":"nokuti tinovimba nezita rake dzvene.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Rudo rwenyu rusingaperi ngarugare pamusoro pedu, imi Jehovha,","poem":1},{"text":"kunyange sezvatakaisa tariro yedu mamuri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}