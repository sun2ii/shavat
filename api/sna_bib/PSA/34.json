{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi. Paakaita seanopenga pamberi paAbhimereki; uyo akamudzinga, iye akaenda hake."]},{"type":"verse","number":1,"content":[{"text":"Ndinorumbidza Jehovha nguva dzose;","poem":1},{"text":"kurumbidzwa kwake kucharamba kuri pamiromo yangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwoyo wangu uchazvirumbidza muna Jehovha;","poem":1},{"text":"vanotambudzika ngavanzwe vafare.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kudzai Jehovha pamwe chete neni;","poem":1},{"text":"ngatikudzei zita rake pamwe chete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndakachema kuna Jehovha akandipindura;","poem":1},{"text":"akandisunungura pakutya kwangu kwose.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vanotarira kwaari vanopenya;","poem":1},{"text":"zviso zvavo hazvingambofukidzwi nenyadzi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Murombo uyu akadana, uye Jehovha akamunzwa;","poem":1},{"text":"akamuponesa pakutambudzika kwake kwose.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mutumwa waJehovha anokomberedza avo vanomutya,","poem":1},{"text":"uye anovasunungura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ravirai henyu muone kuti Jehovha akanaka;","poem":1},{"text":"akaropafadzwa munhu anovanda maari.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ityai Jehovha, imi vatsvene vake,","poem":1},{"text":"nokuti vanomutya havana chavanoshayiwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Shumba dzinopera simba uye dzinofa nenzara,","poem":1},{"text":"asi avo vanotsvaka Jehovha havashayiwi chinhu chakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Uyai, vana vangu, nditeererei;","poem":1},{"text":"ndichakudzidzisai kutya Jehovha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani naani wenyu anoda upenyu,","poem":1},{"text":"uye uchida kuona mazuva akawanda,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"dzora rurimi rwako pane zvakaipa","poem":1},{"text":"nemiromo yako pakureva nhema.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ibva pane zvakaipa ugoita zvakanaka;","poem":1},{"text":"tsvaka rugare uye urutevere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Meso aJehovha ari pamusoro pavakarurama","poem":1},{"text":"uye nzeve dzake dzinonzwa kuchema kwavo;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"chiso chaJehovha chinovenga avo vanoita zvakaipa,","poem":1},{"text":"kuti abvise chiyeuchidzo chavo panyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Vakarurama vanodanidzira, uye Jehovha anovanzwa;","poem":1},{"text":"anovarwira pakutambudzika kwavo kwose.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jehovha ari pedyo navane mwoyo yakaputsika","poem":1},{"text":"uye anoponesa avo vakapwanyika pamweya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Akarurama angava namatambudziko mazhinji,","poem":1},{"text":"asi Jehovha anomurwira paari ose;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"anochengetedza mapfupa ake ose,","poem":1},{"text":"hakuna nerimwe rawo richavhunika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Zvakaipa zvichauraya vakaipa;","poem":1},{"text":"vavengi vavakarurama vachapiwa mhosva.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Jehovha anodzikinura varanda vake;","poem":1},{"text":"hapana kana mumwe anovanda maari achapiwa mhosva.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}