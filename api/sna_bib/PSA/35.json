{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, kakavadzanai navanokakavadzana neni;","poem":1},{"text":"rwisai avo vanondirwisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Torai nhoo huru neduku;","poem":1},{"text":"simukai, uye uyai mundibatsire.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vheyesai pfumo guru nepfumo diki","poem":1},{"text":"murwise avo vanonditevera.","poem":2},{"text":"Muti kumweya wangu,","poem":1},{"text":"“Ndini ruponeso rwako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vanotsvaka kundiuraya","poem":1},{"text":"ngavazvidzwe uye vanyadziswe;","poem":2},{"text":"vanorangana kuparadzwa kwangu","poem":1},{"text":"ngavadzoserwe shure vachitya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngavaite sehundi pamberi pemhepo,","poem":1},{"text":"mutumwa waJehovha achivasundira kure;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"nzira yavo ngaisvibe uye itsvedze,","poem":1},{"text":"mutumwa waJehovha achivateverera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sezvo vakandivanzira mimbure yavo ndisina mhosva,","poem":1},{"text":"uye vakandicherera gomba ndisina mhosva,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kuparadzwa ngakuvawire pakarepo,","poem":1},{"text":"mumbure wavakavanza ngauvapinge ivo,","poem":2},{"lineBreak":true},{"text":"ngavawire mugomba ravo vaparare.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ipapo mweya wangu uchafara muna Jehovha,","poem":1},{"text":"uye uchafarira ruponeso rwake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zvandiri zvose zvichadanidzira zvichiti:","poem":1},{"text":"“Ndianiko akaita semi, Jehovha?","poem":2},{"text":"Munonunura varombo kubva","poem":1},{"text":"kuna avo vane simba kupinda ravo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Zvapupu zvino utsinye zvinouya mberi;","poem":1},{"text":"zvinondibvunza pamusoro pezvinhu zvandisingazivi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vanotsiva zvakanaka zvangu nezvakaipa,","poem":1},{"text":"uye vanosiya mweya wangu uchidzungaira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Asi pavairwara, ndakafuka nguo dzamasaga","poem":1},{"text":"ndikazvininipisa nokutsanya.","poem":2},{"text":"Munyengetero wangu pawakadzokera kwandiri usina mhinduro,","poem":1}]},{"type":"verse","number":14,"content":[{"text":"ndakafamba-famba ndichichema","poem":2},{"lineBreak":true},{"text":"kunge ndinochemera shamwari yangu kana hama yangu.","poem":2},{"text":"Ndakakotamisa musoro wangu ndichichema,","poem":1},{"text":"sokunge ndinochema mai vangu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asi pandakagumburwa, vakaungana vachifara;","poem":1},{"text":"varwi vakaungana kuzondirwisa ndisingazivi.","poem":2},{"lineBreak":true},{"text":"Vakandireva vasingaregi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Savanhu vasina Mwari vakandiseka muruvengo rwavo;","poem":1},{"text":"vakandirumanyira meno avo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haiwa Jehovha, muchasvika riniko makangotarira?","poem":1},{"text":"Nunurai upenyu hwangu kubva pakuparadza kwavo,","poem":2},{"lineBreak":true},{"text":"noupenyu hwangu hunokosha kubva pashumba idzi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndichakuvongai paungano huru;","poem":1},{"text":"ndichakurumbidzai pakati pavanhu vazhinji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ngavarege kufara pamusoro pangu","poem":1},{"text":"avo vanondivenga ndisina mhosva;","poem":2},{"text":"vanondivenga ndisina mhosva","poem":1},{"text":"ngavarege kuchonyerana meso avo mukundivenga.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Havatauri norugare,","poem":1},{"text":"asi vanofunga kupomera mhosva","poem":2},{"lineBreak":true},{"text":"pamusoro pavanogara norunyararo munyika.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vanondishamira miromo yavo vachiti,","poem":1},{"text":"“Hekani waro! Hekani waro! Tazviona nameso edu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Haiwa Jehovha, mazviona izvi; regai kunyarara.","poem":1},{"text":"Regai kuva kure neni, imi Ishe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mukai uye simukai mundirwire!","poem":1},{"text":"Ndirwirei, Mwari wangu naIshe wangu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndiruramisirei mukururama kwenyu, imi Jehovha Mwari wangu;","poem":1},{"text":"musarega vachifara pamusoro pangu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Musarega vachifunga mumwoyo mavo vachiti, “Hekani waro,","poem":1},{"text":"ndizvo zvatanga tichida!” kana kuti vati, “Tamumedza chose.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Vose vanofarira kutambudzika kwangu","poem":1},{"text":"ngavanyadziswe uye vanyonganiswe;","poem":2},{"text":"vose vanozvisimudzira pamusoro pangu","poem":1},{"text":"ngavafukidzwe nenyadzi nokuzvidzwa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Vose vanofarira kururamisirwa kwangu","poem":1},{"text":"ngavapembere nomufaro nokufarisisa;","poem":2},{"text":"ngavarambe vachiti, “Jehovha ngaakudzwe,","poem":1},{"text":"iye anofarira kugara zvakanaka kwavaranda vake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Rurimi rwangu ruchataura zvokururama kwenyu,","poem":1},{"text":"uye nezvokurumbidzwa kwenyu zuva rose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}