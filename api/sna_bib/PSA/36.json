{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi muranda waJehovha."]},{"type":"verse","number":1,"content":[{"text":"Shoko riri mumwoyo mangu","poem":1},{"text":"pamusoro pokutadza kweakaipa rinoti:","poem":2},{"text":"Hakuna kutya Mwari","poem":1},{"text":"pamberi pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pamaonero ake anozvirumbidza, nokuti anozvibata kumeso kwazvo pakuona kwake,","poem":1},{"text":"zvokuti anotadza kuona kana kuvenga chivi chake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mashoko omuromo wake akaipa uye anonyengera;","poem":1},{"text":"haachisiri munhu akachenjera kana anoita zvakanaka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kunyange panhoo yake anofunga zvakaipa;","poem":1},{"text":"anozvifambisa panzira yezvakaipa","poem":2},{"lineBreak":true},{"text":"uye haarambi chakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rudo rwenyu, imi Jehovha, runosvika kudenga denga,","poem":1},{"text":"kutendeka kwenyu kunosvika kumakore.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kururama kwenyu kwakaita segomo guru guru,","poem":1},{"text":"kururamisira kwenyu sepakadzika dzika.","poem":2},{"text":"Haiwa Jehovha, imi munochengetedza zvose munhu nemhuka.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Haiwa rudo rwenyu rusingatongoperi runokosha sei!","poem":2},{"text":"Vose vakuru navaduku pakati pavanhu","poem":1},{"text":"vanovanda mumumvuri wamapapiro enyu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanogutswa nezvakawanda zvomumba menyu;","poem":1},{"text":"munovanwisa kubva parwizi rwenyu runofadza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuti kwamuri ndiko kune chitubu choupenyu;","poem":1},{"text":"muchiedza chenyu tinoona chiedza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rambai muchiitira rudo kuna avo vanokuzivai,","poem":1},{"text":"uye kururama kwenyu kuna vane mwoyo yakarurama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Rutsoka rwounozvikudza ngarurege kusvika kwandiri,","poem":1},{"text":"kunyange ruoko rweakaipa ngarurege kundidzingira kure.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tarirai vaiti vezvakaipa kuti vawa sei,","poem":1},{"text":"vakandwa pasi, havagoni kumuka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}