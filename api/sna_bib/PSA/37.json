{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Usava neshungu nokuda kwavanhu vakaipa,","poem":1},{"text":"uye usaitira godo avo vanoita zvakaipa;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"nokuti souswa vachaoma nokukurumidza,","poem":1},{"text":"somuriwo wakasvibira vachakurumidza kuoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Vimba naJehovha uite zvakanaka;","poem":1},{"text":"gara panyika ufarikane pamafuro manyoro.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Farikana muna Jehovha,","poem":1},{"text":"uye iye achakupa zvinodikanwa nomwoyo wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Isa nzira yako kuna Jehovha;","poem":1},{"text":"uvimbe naye uye iye achaita izvi;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"achaita kuti kururama kwako kupenye samambakwedza,","poem":1},{"text":"nokururamisirwa kwako sezuva ramasikati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nyarara pamberi paJehovha, umurindire unyerere;","poem":1},{"text":"usava neshungu kana vanhu vachibudirira panzira dzavo,","poem":2},{"lineBreak":true},{"text":"pavanoita mano avo akaipa avakaronga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rega kutsamwa, uzvidzore pahasha;","poem":1},{"text":"usava neshungu zvinokutungamirira mune zvakaipa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nokuti vasakarurama vachagurwa,","poem":1},{"text":"asi avo vanomirira Jehovha vachagara nhaka yenyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Chinguva chiduku duku, vakaipa havachazovapozve;","poem":1},{"text":"kunyange ukavatsvaka, havazowanikwi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asi vanyoro vachagara nhaka yenyika,","poem":1},{"text":"uye vachafarikana norugare rukuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Vakaipa vanofungira vakarurama mano akaipa,","poem":1},{"text":"uye vanovarumanyira meno avo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Asi Ishe anoseka vakaipa","poem":1},{"text":"nokuti anoziva kuti zuva ravo riri kuuya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Vakaipa vanovhomora munondo","poem":1},{"text":"uye vanowembura uta","poem":2},{"text":"kuti vawisire pasi varombo navanoshayiwa,","poem":1},{"text":"kuti vauraye avo vane nzira dzakarurama.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asi minondo yavo ichabaya mwoyo yavo pachavo,","poem":1},{"text":"uye uta hwavo huchavhunika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Zvishoma zvowakarurama zviri nani","poem":1},{"text":"kupinda pfuma yavakaipa vazhinji;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"nokuti simba ravakaipa richavhuniwa,","poem":1},{"text":"asi Jehovha anotsigira vakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mazuva avakarurama anozivikanwa naJehovha,","poem":1},{"text":"uye nhaka yavo ichagara nokusingaperi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Panguva yamatambudziko, havanganyadziswi;","poem":1},{"text":"mumazuva enzara ivo vachava nezvakawanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Asi vakaipa vachaparara:","poem":1},{"text":"vavengi vaJehovha vachafanana norunako rweminda,","poem":2},{"lineBreak":true},{"text":"vachanyangarika soutsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Vakaipa vanokwereta uye havadzori,","poem":1},{"text":"asi vakarurama vanopa zvakawanda;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"avo vanoropafadzwa naJehovha vachagara nhaka yenyika,","poem":1},{"text":"asi avo vaanotuka vachaparadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kana Jehovha achifarira nzira yomunhu,","poem":1},{"text":"anosimbisa mafambiro ake;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kunyange akagumburwa, haangawi,","poem":1},{"text":"nokuti Jehovha anomutsigira noruoko rwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ndakanga ndiri muduku uye zvino ndakwegura,","poem":1},{"text":"asi handina kumboona vakarurama vachiraswa,","poem":2},{"lineBreak":true},{"text":"kana vana vavo vachipemha chingwa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Vanogara vachingopa vamwe, uye vachikweretesa pasina muripo;","poem":1},{"text":"vana vavo vacharopafadzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dzoka pane zvakaipa ugoita zvakanaka;","poem":1},{"text":"ipapo uchagara panyika nokusingaperi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nokuti Jehovha anoda vanoruramisira","poem":1},{"text":"uye haangazosiyi vanhu vake vakatendeka.","poem":2},{"lineBreak":true},{"text":"Vachadzivirirwa nokusingaperi;","poem":1},{"text":"asi vana vowakaipa vachaparadzwa;","poem":2}]},{"type":"verse","number":29,"content":[{"text":"vakarurama vachagara nhaka yenyika","poem":1},{"text":"uye vachagara mairi nokusingaperi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Muromo womunhu akarurama unotaura uchenjeri,","poem":1},{"text":"uye rurimi rwake runotaura kururamisira.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Murayiro waMwari wake uri pamwoyo wake;","poem":1},{"text":"tsoka dzake hadzitedzemuki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Vakaipa vanovandira vakarurama,","poem":1},{"text":"vachitsvaka upenyu hwavo chaihwo;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"asi Jehovha haangavasiyi vari musimba ravo,","poem":1},{"text":"kana kuvarega vachipomerwa kana vamira pakutongwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Rindira Jehovha,","poem":1},{"text":"uye uchengete nzira yake.","poem":2},{"text":"Achakusimudzira kuti ugare nhaka yenyika;","poem":1},{"text":"kana vakaipa voparadzwa, iwe uchazviona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Ndakaona munhu akaipa uye ano utsinye","poem":1},{"text":"achibudirira somuti wakasvibira pavhu romunyika yawo,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"asi nokukurumidza akapfuura uye akasazovapozve;","poem":1},{"text":"kunyange ndakamutsvaka, haana kuzowanikwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Cherechedza asina mhosva, ongorora akarurama;","poem":1},{"text":"ane ramangwana rakanaka munhu worugare.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Asi vatadzi vose vachaparadzwa;","poem":1},{"text":"ramangwana rowakaipa richagurwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Ruponeso rwavakarurama runobva kuna Jehovha;","poem":1},{"text":"ndiye nhare yavo panguva yamatambudziko.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Jehovha anovabatsira uye anovanunura;","poem":1},{"text":"anovanunura kubva kuna vakaipa uye anovaponesa,","poem":2},{"lineBreak":true},{"text":"nokuti vanovanda maari.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}