{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"hebrew_subtitle","content":["Pisarema raDhavhidhi. Chikumbiro."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, musandirayira mukutsamwa kwenyu kana","poem":1},{"text":"kundiranga muhasha dzenyu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nokuti miseve yenyu yandibaya,","poem":1},{"text":"uye ruoko rwenyu rwawira pamusoro pangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mumuviri mangu hamuchina utano nokuda kwehasha dzenyu;","poem":1},{"text":"mapfupa angu apera simba nokuda kwechivi changu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mhosva yangu yandiremera","poem":1},{"text":"somutoro unorema kwazvo kuutakura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Maronda angu aora uye anosemesa","poem":1},{"text":"nokuda kwoupenzi hwokutadza kwangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndakotamiswa uye ndaderedzwa kwazvo;","poem":1},{"text":"ndinofamba ndichichema zuva rose.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Musana wangu wazara nokupisa kunorwadza;","poem":1},{"text":"muviri wangu hauchina utano.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndarukutika uye ndapwanyika chose;","poem":1},{"text":"ndiri kugomera nokurwadza kwomwoyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Haiwa Ishe, zvose zvandinoshuva zviri pachena pamberi penyu,","poem":1},{"text":"kugomera kwangu hakuna kuvanzika kwamuri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hana yangu inorova, simba rangu rapera;","poem":1},{"text":"kunyange nechiedza chabva pameso angu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shamwari dzangu navafambidzani vondinzvenga nokuda kwamaronda angu;","poem":1},{"text":"vavakidzani vangu vanogara kure neni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Avo vanotsvaka kundiuraya vanonditeya nemisungo yavo,","poem":1},{"text":"avo vanoda kundikuvadza vanotaura nezvokuparadzwa kwangu;","poem":2},{"lineBreak":true},{"text":"zuva rose vanorangana zvounyengeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ini ndafanana nematsi, isinganzwi,","poem":1},{"text":"sembeveve, isingagoni kushamisa muromo wayo;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ndava somunhu asinganzwi,","poem":1},{"text":"ano muromo usingapinduri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Haiwa Jehovha, ndakakumirirai;","poem":1},{"text":"muchapindura, imi Ishe Mwari wangu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nokuti ndakati, “Musavarega vachifarira kutambudzika kwangu","poem":1},{"text":"kana kuzvisimudzira pamusoro pangu, rutsoka rwangu parunotedzemuka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nokuti ndava pedyo nokuwa,","poem":1},{"text":"uye kurwadziwa kwangu kunogara neni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndinoreurura chivi changu;","poem":1},{"text":"chivi changu chinonditambudza.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Vavengi vangu vane simba vazhinji;","poem":1},{"text":"vanondivenga ndisina mhosva vakawanda.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ivavo vanotsiva zvakanaka zvangu nezvakaipa,","poem":1},{"text":"vanondireva pandinotevera zvakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Haiwa Jehovha, regai kundisiya;","poem":1},{"text":"regai kuva kure neni, imi Mwari wangu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Haiwa Ishe Muponesi wangu,","poem":1},{"text":"kurumidzai kuuya kuzondibatsira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}