{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Kuna Jedhutuni. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndakati, “Ndichangwarira nzira dzangu","poem":1},{"text":"nokuchengeta rurimi rwangu pachivi;","poem":2},{"text":"ndichaisa matomu pamuromo wangu","poem":1},{"text":"kana vakaipa vari pamberi pangu.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Asi pandakanga ndinyerere uye ndakadzikama,","poem":1},{"text":"ndisingatauri kana chakanaka zvacho,","poem":2},{"lineBreak":true},{"text":"kurwadziwa kwangu kwakawedzerwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwoyo wangu wakapisa mukati mangu,","poem":1},{"text":"uye pandakafungisisa, moto ukapisa;","poem":2},{"lineBreak":true},{"text":"ipapo ndakataura norurimi rwangu ndikati:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ndiratidzei, imi Jehovha, magumo oupenyu hwangu","poem":1},{"text":"nokuwanda kwamazuva angu;","poem":2},{"lineBreak":true},{"text":"ndizivisei kupfuura kwoupenyu hwangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Makaita mazuva angu soupamhi hwechanza changu;","poem":1},{"text":"kuwanda kwamakore angu kwakaita sechinhu chisipo pamberi penyu.","poem":2},{"lineBreak":true},{"text":"Upenyu hwomunhu mumwe nomumwe mweya bedzi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Munhu anongori mumvuri zvaanofamba-famba hake:","poem":1},{"text":"anofamba nomufaro mukuru, asi zvinongova pasina;","poem":2},{"lineBreak":true},{"text":"anounganidza pfuma, asingazivi achazoitora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Asi zvino, Ishe, ndakamirireiko?","poem":1},{"text":"Tariro yangu iri mamuri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndiponesei pakudarika kwangu kwose;","poem":1},{"text":"regai kundiita chiseko chamapenzi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndakanga ndinyerere; handina kushamisa muromo wangu,","poem":1},{"text":"nokuti ndimi makaita izvi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bvisai shamhu yenyu kwandiri;","poem":1},{"text":"ndakundwa nokurova kworuoko rwenyu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Munorayira uye munoranga vanhu nokuda kwezvivi zvavo,","poem":1},{"text":"munoparadza pfuma yavo sechipfukuto,","poem":2},{"lineBreak":true},{"text":"munhu mumwe nomumwe mweya zvawo. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Inzwai munyengetero wangu, imi Jehovha,","poem":1},{"text":"rerekerai nzeve yenyu pandinochemera rubatsiro;","poem":2},{"lineBreak":true},{"text":"regai kuva matsi pakuchema kwangu.","poem":2},{"text":"Nokuti ndigere nemi somutorwa,","poem":1},{"text":"somweni, sezvakanga zvakaita madzibaba angu ose.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ringirai kure neni, kuti ndimbofarazve","poem":1},{"text":"ndisati ndabva uye ndisisipo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}