{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wenziyo nemitengeranwa. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndipindurei pandinodana kwamuri,","poem":1},{"text":"imi Mwari wangu makarurama.","poem":2},{"text":"Ndisunungurei pakutambudzika kwangu;","poem":1},{"text":"ndinzwirei ngoni uye munzwe munyengetero wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nhai imi vanhu, muchashandura kukudzwa kwangu kukava chinyadziso kusvikira riniko?","poem":1},{"text":"Muchada kutsauswa nokutsvaka vamwari venhema kusvikira riniko? Sera","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zivai kuti Jehovha akazvitsaurira vanomuda;","poem":1},{"text":"Jehovha achandinzwa pandinodana kwaari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pakutsamwa kwenyu, regai kutadza;","poem":1},{"text":"pamunenge muri pamibhedha yenyu,","poem":2},{"lineBreak":true},{"text":"nzverai mwoyo yenyu uye munyarare. Sera","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ipai zvibayiro zvakarurama","poem":1},{"text":"uye muvimbe naJehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vazhinji vanobvunza vachiti, “Ndianiko angatiratidza chakanaka?”","poem":1},{"text":"Chiedza chechiso chenyu ngachipenye pamusoro pedu, imi Jehovha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Makazadza mwoyo wangu nomufaro mukuru","poem":1},{"text":"kupfuura zviyo zvavo newaini yavo itsva yakawanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ndichavata pasi ndigokotsira norugare,","poem":1},{"text":"nokuti imi moga, Jehovha,","poem":2},{"lineBreak":true},{"text":"munoita kuti ndigare pakasimba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}