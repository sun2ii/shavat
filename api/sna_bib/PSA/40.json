{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndakamirira Jehovha nomwoyo murefu;","poem":1},{"text":"iye akatendeukira kwandiri akanzwa kuchema kwangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akandibudisa mugomba rakadzika,","poem":1},{"text":"kunze kwamatope netsvina;","poem":2},{"text":"akamisa tsoka dzangu padombo","poem":1},{"text":"akandipa nzvimbo yakasimba kuti ndimirepo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akaisa rwiyo rutsva mumuromo mangu,","poem":1},{"text":"rwiyo rwokurumbidza Mwari wedu.","poem":2},{"text":"Vazhinji vachaona, uye vachatya","poem":1},{"text":"uye vachaisa ruvimbo rwavo muna Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Akaropafadzwa munhu","poem":1},{"text":"akaita Jehovha ruvimbo rwake,","poem":2},{"text":"asingatariri kuna vanozvikudza,","poem":1},{"text":"kuna avo vanotsaukira kuna vamwari venhema.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haiwa Jehovha, Mwari wangu,","poem":1},{"text":"zvizhinji zvishamiso zvamakaita.","poem":2},{"text":"Zvinhu zvamakatitongera hakuna","poem":1},{"text":"angazvirondedzera kwamuri;","poem":2},{"text":"dai ndingataura nokureva pamusoro pazvo,","poem":1},{"text":"zvaizowandisa kuzvizivisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hamuna kufarira zvibayiro nezvipo,","poem":1},{"text":"asi nzeve dzangu makadziboora;","poem":2},{"text":"zvibayiro zvinopiswa nezvipiriso","poem":1},{"text":"zvezvivi hamuna kuzvireva.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ipapo ndakati, “Ndiri pano hangu,","poem":1},{"text":"ndauya, zvakanyorwa mubhuku pamusoro pangu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndinofarira kuita kuda kwenyu, imi Mwari wangu;","poem":1},{"text":"murayiro wenyu uri mukati momwoyo wangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndinoparidza kururama paungano huru;","poem":1},{"text":"handidziviri miromo yangu,","poem":2},{"lineBreak":true},{"text":"sokuziva kwenyu, imi Jehovha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Handivanzi kururama kwenyu mumwoyo mangu;","poem":1},{"text":"ndinotaura nezvokutendeka kwenyu noruponeso rwenyu.","poem":2},{"text":"Handivanzi rudo rwenyu nechokwadi chenyu","poem":1},{"text":"paungano huru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Regai kundinyima ngoni dzenyu, imi Jehovha;","poem":1},{"text":"rudo rwenyu nechokwadi chenyu ngazvindidzivirire nguva dzose.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nokuti matambudziko asingaverengeki akandikomberedza;","poem":1},{"text":"zvivi zvangu zvakandibata, uye handigoni kuona.","poem":2},{"text":"Zvakawanda kupfuura bvudzi romumusoro mangu,","poem":1},{"text":"uye mwoyo wangu waneta mukati mangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Haiwa Jehovha, kundiponesa ngakukufadzei;","poem":1},{"text":"haiwa Jehovha, kurumidzai kundibatsira.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vose vanotsvaka kutora upenyu hwangu","poem":1},{"text":"ngavanyadziswe uye vanyonganiswe;","poem":2},{"text":"vose vanoda kuparadzwa kwangu","poem":1},{"text":"ngavadzoserwe shure vanyadziswe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Avo vose vanoti kwandiri, “Hekani waro! Hekani waro!”","poem":1},{"text":"ngavavhundutswe nokuda kwenyadzi dzavo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asi vose vanokutsvakai","poem":1},{"text":"ngavafare uye vafarisise mamuri;","poem":2},{"text":"avo vanoda ruponeso rwenyu ngavarambe vachiti,","poem":1},{"text":"“Jehovha ngaakudzwe!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Asi ndiri murombo nomushayiwi;","poem":1},{"text":"dai Ishe vandifungawo.","poem":2},{"text":"Ndimi mubatsiri wangu nomununuri wangu;","poem":1},{"text":"haiwa Mwari wangu, musanonoka henyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}