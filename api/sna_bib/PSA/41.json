{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Akaropafadzwa uyo ane hanya navasina simba;","poem":1},{"text":"Jehovha anomurwira panguva dzokutambudzika.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jehovha achamudzivirira uye achachengetedza upenyu hwake;","poem":1},{"text":"achamuropafadza panyika","poem":2},{"lineBreak":true},{"text":"uye haangamuisi kuchido chavavengi vake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jehovha achamuraramisa panhoo yake yourwere","poem":1},{"text":"uye achamuponesa panhoo yake yourwere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ini ndakati, “Haiwa Jehovha, ndinzwirei ngoni;","poem":1},{"text":"ndiporesei, nokuti ndakakutadzirai.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vavengi vangu vachindigodora vanoti,","poem":1},{"text":"“Achafa riniko uye zita rake rigoparara?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kana mumwe achiuya kuzondiona,","poem":1},{"text":"anotaura zvenhema, mwoyo uchiunganidza makuhwa;","poem":2},{"lineBreak":true},{"text":"ipapo anobuda ondozviparadzira kumwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vavengi vangu vose vanoita zevezeve pamwe chete pamusoro pangu;","poem":1},{"text":"vanondifungira zvakaipisisa, vachiti,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Chirwere chakaipa chakamubata,","poem":1},{"text":"haachambomukizve panzvimbo paakarara.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kunyange neshamwari yangu yapedyo yandaivimba nayo,","poem":1},{"text":"yandaigovana zvokudya nayo,","poem":2},{"lineBreak":true},{"text":"yandisimudzira chitsitsinho chayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Asi imi, iyemi Jehovha, mune tsitsi neni,","poem":1},{"text":"ndisimudzei, kuti ndivatsive.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndinoziva kuti munofadzwa neni,","poem":1},{"text":"nokuti muvengi wangu haandikundi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Munonditsigira pakutendeka kwangu,","poem":1},{"text":"uye munondiisa pamberi penyu nokusingaperi.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kurumbidzwa ngakuve kuna Jehovha, Mwari waIsraeri,","poem":1},{"text":"kubva pakusingaperi kusvikira nokusingaperi.","poem":2},"Ameni naAmeni."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}