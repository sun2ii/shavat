{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Rwiyo rweMasikiri rwaVanakomana vaKora."]},{"type":"verse","number":1,"content":[{"text":"Senondo inodokwairira hova dzemvura,","poem":1},{"text":"saizvozvo mweya wangu unodokwairirai, imi Mwari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mweya wangu une nyota kuna Mwari, nyota yaMwari mupenyu.","poem":1},{"text":"Ndingaenda riniko kundosangana naMwari?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Misodzi yangu yanga iri zvokudya zvangu","poem":1},{"text":"masikati nousiku,","poem":2},{"text":"asi zuva rose vanhu vanoti kwandiri,","poem":1},{"text":"“Mwari wako aripiko?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndinorangarira zvinhu izvi","poem":1},{"text":"pandinodurura mweya wangu,","poem":2},{"text":"mafambiro andaiita navazhinji","poem":1},{"text":"ndichitungamirira mudungwe wavanhu kuimba yaMwari,","poem":2},{"text":"nokupembera nomufaro uye nokuvonga","poem":1},{"text":"pakati pavazhinji pamutambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wakasuwireiko, nhai mweya wangu?","poem":1},{"text":"Unotambudzwa neiko mukati mangu?","poem":2},{"text":"Isa tariro yako muna Mwari,","poem":1},{"text":"nokuti ndichamurumbidzazve,","poem":2},{"lineBreak":true},{"text":"Muponesi wangu naMwari wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mweya wangu wakaneta mukati mangu;","poem":1},{"text":"naizvozvo ndichakurangarirai","poem":2},{"text":"ndiri kunyika yeJorodhani,","poem":1},{"text":"pamatunhu akakwirira eHeremoni, kubva paGomo reMizari.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pakadzika panodana pakadzika","poem":1},{"text":"mukutinhira kwamapopopo emvura;","poem":2},{"text":"mafungu enyu ose namafashamu","poem":1},{"text":"akapfuura napamusoro pangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Masikati, Jehovha anorayira rudo rwake,","poem":1},{"text":"pausiku rwiyo rwake runeni,","poem":2},{"lineBreak":true},{"text":"munyengetero kuna Mwari woupenyu hwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndinoti kuna Mwari Dombo rangu,","poem":1},{"text":"“Mandikanganwireiko?","poem":2},{"text":"Ndinofambireiko ndichichema","poem":1},{"text":"ndakadzvinyirirwa nomuvengi?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mapfupa angu atambura nokurwadza kworufu,","poem":1},{"text":"sezvo vavengi vangu vachindizvidza","poem":2},{"text":"zuva rose vachiti kwandiri,","poem":1},{"text":"“Mwari wako aripiko?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wakasuwireiko, nhai mweya wangu?","poem":1},{"text":"Unotambudzwa neiko mukati mangu?","poem":2},{"text":"Isa tariro yako muna Mwari,","poem":1},{"text":"nokuti ndichamurumbidzazve.","poem":2},{"lineBreak":true},{"text":"Muponesi wangu naMwari wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}