{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Ndiruramisirei, imi Mwari,","poem":1},{"text":"uye mundireverere mhaka yangu parudzi rusina Mwari;","poem":2},{"lineBreak":true},{"text":"ndinunurei pavanhu vanonyengera nevakaipa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndimi Mwari nhare yangu.","poem":1},{"text":"Mandirambireiko?","poem":2},{"text":"Ndinofambireiko pose ndichichema","poem":1},{"text":"ndichidzvinyirirwa navavengi?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tumirai chiedza chenyu nechokwadi chenyu,","poem":1},{"text":"ngazvinditungamirire;","poem":2},{"text":"ngazvindisvitse kugomo renyu dzvene,","poem":1},{"text":"kunzvimbo yamunogara.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ipapo ndichaenda kuaritari yaMwari,","poem":1},{"text":"kuna Mwari, iye mufaro wangu nomudikani wangu.","poem":2},{"text":"Ndichakurumbidzai nembira,","poem":1},{"text":"imi Mwari, Mwari wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wakasuwireiko, nhai mweya wangu?","poem":1},{"text":"Unotambudzwa neiko mukati mangu?","poem":2},{"text":"Isa tariro yako muna Mwari,","poem":1},{"text":"nokuti ndichamurumbidzazve,","poem":2},{"lineBreak":true},{"text":"Muponesi wangu naMwari wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}