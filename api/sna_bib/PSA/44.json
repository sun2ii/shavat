{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba waVanakomana vaKora. Masikiri."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Mwari, takanzwa nenzeve dzedu;","poem":1},{"text":"madzibaba edu akatiudza","poem":2},{"text":"zvamakaita pamazuva avo,","poem":1},{"text":"pamazuva ekare.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Noruoko rwenyu makadzinga ndudzi","poem":1},{"text":"uye mukasima madzibaba edu;","poem":2},{"text":"makapwanya marudzi","poem":1},{"text":"mukaita kuti madzibaba edu abudirire.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Havana kuzviwanira nyika nomunondo wavo,","poem":1},{"text":"uye ruoko rwavo haruna kuvakundisa;","poem":2},{"text":"rwakanga rwuri ruoko rwenyu rworudyi, irwo ruoko rwenyu,","poem":1},{"text":"nokupenya kwechiso chenyu, nokuti imi makavada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndimi Mambo wangu naMwari wangu,","poem":1},{"text":"anorayira kukunda kwaJakobho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kubudikidza nemi, tinosunda vavengi vedu shure;","poem":1},{"text":"kubudikidza nezita renyu, tinotsika vavengi vedu netsoka dzedu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Handivimbi nouta hwangu,","poem":1},{"text":"munondo wangu haundivigiri kukunda;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"asi imi munotipa kukunda pamusoro pavavengi vedu,","poem":1},{"text":"munonyadzisa vadzivisi vedu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tinozvirumbidza muna Mwari zuva rose,","poem":1},{"text":"uye ticharumbidza zita renyu nokusingaperi. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Asi zvino matiramba uye matininipisa;","poem":1},{"text":"hamuchabudi nehondo dzedu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Makaita kuti tidududze pamberi pavavengi vedu,","poem":1},{"text":"uye vadzivisi vedu vakatipamba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Makatiramwira kumudyi samakwai","poem":1},{"text":"uye makatiparadzira pakati pendudzi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Makatengesa vanhu venyu pasina,","poem":1},{"text":"hamuna kuwana kana chinhu pakuvatengesa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Makatiita chiseko kuvavakidzani vedu,","poem":1},{"text":"chinozvidzwa nechinosekwa chaavo vakatipoteredza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Makatiita tsumo pakati pendudzi;","poem":1},{"text":"vanhu vanotidzungudzira misoro.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kunyadziswa kwangu kuri pamberi pangu zuva rose,","poem":1},{"text":"uye chiso changu chafukidzwa nenyadzi","poem":2}]},{"type":"verse","number":16,"content":[{"text":"pakuseka kwaavo vanondizvidza nokundirwisa,","poem":1},{"text":"nokuda kwomuvengi, agarira kutsiva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zvose izvi zvakaitika kwatiri","poem":1},{"text":"kunyange takanga tisina kukukanganwai,","poem":2},{"lineBreak":true},{"text":"kana kuva vasina kutendeka kusungano yenyu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mwoyo yedu yakanga isati yafuratira;","poem":1},{"text":"tsoka dzedu dzakanga dzisati dzatsauka panzira yenyu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Asi makatipwanya mukatiita nzvimbo yamakava","poem":1},{"text":"uye mukatifukidza nerima guru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dai takanga takanganwa zita raMwari wedu,","poem":1},{"text":"kana kutambanudzira maoko edu kuna mwari wavatorwa,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mwari haaizviziva here,","poem":1},{"text":"sezvo achiziva zvakavanzika zvomwoyo?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Asi nokuda kwenyu takatarisana norufu zuva rose;","poem":1},{"text":"tinotorwa samakwai anobayiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mukai, imi Ishe! Munovatireiko?","poem":1},{"text":"Zvisimudzei! Regai kutiramba nokusingaperi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ko, munovanzirei chiso chenyu","poem":1},{"text":"muchikanganwa kutambudzika nokudzvinyirirwa kwedu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Takawisirwa muguruva;","poem":1},{"text":"miviri yedu inonamatira pavhu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Simukai mutibatsire;","poem":1},{"text":"tidzikinurei nokuda kworudo rwenyu rusingaperi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}