{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":45,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba waVanakomana vaKora. Masikiri nomuimbirwo wa“Maruva aMahapa.” Rwiyo rwoMuchato."]},{"type":"verse","number":1,"content":[{"text":"Mwoyo wangu unobvongodzwa nedingindira rakanaka,","poem":1},{"text":"pandinodetembera mambo ndima dzangu;","poem":2},{"lineBreak":true},{"text":"rurimi rwangu chinyoreso chomunyori anogona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Imi makanakisisa pavanhu vose","poem":1},{"text":"uye miromo yenyu yakazadzwa nenyasha,","poem":2},{"lineBreak":true},{"text":"sezvo Mwari akakuropafadzai nokusingaperi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sungai munondo wenyu parutivi, imi wamasimba,","poem":1},{"text":"zvishongedzei nokubwinya noumambo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Paumambo hwenyu kwirai mukunde kwazvo,","poem":1},{"text":"makamirira chokwadi, kuzvininipisa nokururama;","poem":2},{"lineBreak":true},{"text":"ruoko rwenyu rworudyi ngaruratidze mabasa enyu anotyisa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Miseve yenyu inopinza ngaibaye mwoyo yavavengi vamambo;","poem":1},{"text":"ndudzi ngadziputsikire pasi petsoka dzenyu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Chigaro chenyu, imi Mwari, chichagara nokusingaperi-peri;","poem":1},{"text":"tsvimbo yokururamisira ichava tsvimbo youmambo hwenyu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Imi munoda kururama uye munovenga zvakaipa;","poem":1},{"text":"naizvozvo Mwari, Mwari wenyu, akakuisai pamusoro peshamwari dzenyu","poem":2},{"lineBreak":true},{"text":"nokukuzodzai namafuta omufaro.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nguo dzenyu dzose dzinonhuwirira mura, arosi nekasia,","poem":1},{"text":"zvinobva kumizinda yamadzimambo yakashongedzwa nenyanga dzenzou,","poem":2},{"lineBreak":true},{"text":"kurira kwehungiso kunokufadzai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vanasikana vamadzimambo vari pakati pavakadzi vanokudzwa;","poem":1},{"text":"kuruoko rwenyu rworudyi kuno mwenga akashongedzwa negoridhe reOfiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Teerera, iwe mwanasikana, rangarira,","poem":1},{"text":"uye urereke nzeve yako: Kanganwa vanhu vako neimba yababa vako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mambo ayevedzwa norunako rwako;","poem":1},{"text":"mukudze, nokuti ndiye Ishe wako.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mwanasikana weTire achauya nechipo,","poem":1},{"text":"vanhu vakapfuma vachatsvaka nyasha kwauri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mwanasikana wamambo akanaka kwazvo mukati meimba yake; nguo yake yakarukirirwa negoridhe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Akapfeka nguo dzakashongedzwa achaperekedzwa kuna mambo;","poem":1},{"text":"shamwari dzake idzo mhandara dzinomutevera","poem":2},{"lineBreak":true},{"text":"uye vanouyiswa kwamuri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vanoperekedzwa vachapinda nomufaro nokufarisisa;","poem":1},{"text":"vanopinda mumuzinda wamambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Vanakomana venyu vachatsiva nzvimbo yamadzibaba enyu;","poem":1},{"text":"muchavaita machinda munyika yose.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndichaita kuti kurangarirwa kwenyu kurambe kuripo, kusvikira kuzvizvarwa zvose;","poem":1},{"text":"naizvozvo ndudzi dzichakurumbidzai nokusingaperi-peri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}