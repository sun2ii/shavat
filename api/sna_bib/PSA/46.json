{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba waVanakomana vaKora. Namaimbirwo earamoti. Rwiyo."]},{"type":"verse","number":1,"content":[{"text":"Mwari ndiye utiziro hwedu nesimba redu,","poem":1},{"text":"ndiye mubatsiri anogara aripo panguva yokutambudzika.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Naizvozvo hatizotyi, kunyange nyika ikashanduka,","poem":1},{"text":"uye makomo akawira mukatikati megungwa,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kunyange mvura yaro ikatinhira uye ikapupuma furo,","poem":1},{"text":"uye makomo akadengenyeswa namafungu aro. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pane rwizi rwuripo rune hova dzinofadza guta raMwari,","poem":1},{"text":"nzvimbo tsvene yeWokumusoro-soro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwari ari mukati maro, haringawiri pasi;","poem":1},{"text":"Mwari acharibatsira panguva yemambakwedza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndudzi dzinoita bope, umambo hunoondomoka;","poem":1},{"text":"anotaura nenzwi guru, nyika yonyongodeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jehovha Wamasimba Ose anesu;","poem":1},{"text":"Mwari waJakobho ndiye nhare yedu. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uyai muone mabasa aJehovha,","poem":1},{"text":"kuparadza kwaakaita panyika.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anoita kuti hondo dzigume kusvikira kumagumo enyika;","poem":1},{"text":"anovhuna uta uye anovhuna-vhuna mapfumo,","poem":2},{"lineBreak":true},{"text":"anopisa nhoo nomoto.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Mirai, muzive kuti ndini Mwari;","poem":1},{"text":"ndichakudzwa pakati pendudzi,","poem":2},{"lineBreak":true},{"text":"ndichasimudzirwa panyika.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jehovha Wamasimba Ose anesu;","poem":1},{"text":"Mwari waJakobho ndiye nhare yedu. Sera","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}