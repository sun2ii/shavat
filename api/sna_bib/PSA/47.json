{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba waVanakomana vaKora. Pisarema."]},{"type":"verse","number":1,"content":[{"text":"Uchirai maoko, imi vanhu vose;","poem":1},{"text":"pururudzai kuna Mwari nokudanidzira kwomufaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jehovha Wokumusoro-soro anotyisa sei,","poem":1},{"text":"iye Mambo mukuru pamusoro penyika yose!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akaisa ndudzi dzavanhu pasi pedu,","poem":1},{"text":"marudzi pasi petsoka dzedu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akatitsaurira nhaka yedu,","poem":1},{"text":"iyo pfuma yaJakobho, waakada. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mwari akwidza kumusoro pakati pokudanidzira kwomufaro,","poem":1},{"text":"Jehovha pakati pokurira kwehwamanda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Imbirai Mwari nziyo dzokurumbidza, murumbidzei nenziyo.","poem":1},{"text":"Imbirai Mambo wedu nziyo dzokurumbidza, murumbidzei nenziyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nokuti Mwari ndiye Mambo wenyika yose;","poem":1},{"text":"muimbirei pisarema rokurumbidza.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwari anotonga pamusoro pendudzi dzose;","poem":1},{"text":"Mwari agere pamusoro pechigaro chake chitsvene.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makurukota amarudzi aungana","poem":1},{"text":"savanhu vaMwari waAbhurahama,","poem":2},{"text":"nokuti madzimambo enyika ndeaMwari;","poem":1},{"text":"iye anokudzwa zvikuru kwazvo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}