{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["Rwiyo. Pisarema raVanakomana vaKora."]},{"type":"verse","number":1,"content":[{"text":"Jehovha mukuru, uye anofanira kurumbidzwa kwazvo,","poem":1},{"text":"muguta raMwari wedu, mugomo rake dzvene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rakanaka pakukwirira kwaro, mufaro wenyika yose.","poem":1},{"text":"Sokumusoro-soro kweZafoni,","poem":2},{"text":"ndizvo zvakaita Gomo reZioni,","poem":1},{"text":"guta raMambo Mukuru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwari ari munhare dzaro;","poem":1},{"text":"akazviratidza kwariri kuti ndiye nharirire yaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Madzimambo akati abatanidza mauto,","poem":1},{"text":"vakati vafamba pamwe chete kundorwa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"vakariona vakashamiswa;","poem":1},{"text":"vakatiza nokutya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vakabatwa nokudedera ipapo,","poem":1},{"text":"nokurwadziwa sekwomukadzi osununguka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Makavaparadza sezvakaitwa zvikepe zveTashishi,","poem":1},{"text":"zvakaputswa-putswa nemhepo yokumabvazuva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sezvatakanzwa, ndizvo zvataona,","poem":1},{"text":"muguta raJehovha Wamasimba Ose,","poem":2},{"text":"muguta raMwari wedu:","poem":1},{"text":"Mwari anorisimbisa nokusingaperi. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tiri mukati metemberi yenyu, imi Mwari,","poem":1},{"text":"tinofungisisa nezvorudo rwenyu rusingaperi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sezvakaita zita renyu, imi Mwari,","poem":1},{"text":"kurumbidzwa kwenyu kunosvika kumagumo enyika;","poem":2},{"lineBreak":true},{"text":"ruoko rwenyu rworudyi ruzere nokururama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gomo reZioni rinofarisisa,","poem":1},{"text":"misha yeJudha inofara","poem":2},{"lineBreak":true},{"text":"nokuda kwokutonga kwenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Famba-fambai muZioni, ripoteredzei,","poem":1},{"text":"verengai shongwe dzaro,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"fungisisai zvakanaka nezvamasvingo aro,","poem":1},{"text":"cherechedzai nhare dzaro,","poem":2},{"lineBreak":true},{"text":"kuti mugotaura nezvazvo kuchizvarwa chinotevera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nokuti Mwari uyu ndiye Mwari wedu nokusingaperi-peri;","poem":1},{"text":"iye achava muperekedzi wedu kusvikira kumagumo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}