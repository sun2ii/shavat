{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba, waVanakomana vaKora. Pisarema."]},{"type":"verse","number":1,"content":[{"text":"Inzwai izvi, imi vanhu mose;","poem":1},{"text":"teererai imi mose mugere panyika,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"vapasi navapamusoro,","poem":1},{"text":"vapfumi navarombo pamwe chete.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muromo wangu uchataura nouchenjeri;","poem":1},{"text":"kutaura kunobva pamwoyo wangu kuchapa kunzwisisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndicharerekera nzeve yangu kuchirahwe;","poem":1},{"text":"nembira ndichadudzira shoko rangu rakavanzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndinotyireiko kana mazuva akaipa achiuya,","poem":1},{"text":"kana vanyengeri vakaipa vandikomberedza,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"vaya vanovimba nepfuma yavo","poem":1},{"text":"vanozvikudza nepfuma yavo zhinji?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hakuna munhu angadzikinura upenyu hwomumwe","poem":1},{"text":"kana kupa Mwari rudzikinuro rwake,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"rudzikinuro rwoupenyu runokosha,","poem":1},{"text":"hakuna muripo unoringana nahwo,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kuti ararame nokusingaperi","poem":1},{"text":"uye kuti asaona kuora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nokuti vose vanogona kuona kuti vanhu vakachenjera vanofa;","poem":1},{"text":"mapenzi navasina pfungwa zvimwe chetezvo vanofa,","poem":2},{"lineBreak":true},{"text":"uye vanosiyira vamwe pfuma yavo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Marinda avo achagara ari dzimba dzavo nokusingaperi,","poem":1},{"text":"nougaro hwavo kusvikira kuzvizvarwa zvisingaperi,","poem":2},{"lineBreak":true},{"text":"kunyange vakanga vakapa nyika mazita avo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Asi munhu, kunyange ane pfuma yake, haagari;","poem":1},{"text":"akafanana nemhuka dzinofa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndiwo magumo aivavo vanovimba nezvavanoita,","poem":1},{"text":"namagumo avateveri vavo, vanotenda zvavanotaura. Sera","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Samakwai vakatarirwa kuenda kuguva,","poem":1},{"text":"uye rufu ruchavadya.","poem":2},{"text":"Vakarurama vachavatonga mangwanani;","poem":1},{"text":"chimiro chavo chichaora murinda,","poem":2},{"lineBreak":true},{"text":"kure nedzimba dzavo dzoumambo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asi Mwari achadzikinura upenyu hwangu kubva muguva,","poem":1},{"text":"zvirokwazvo achanditora iye. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Usanyanya kutya kana munhu apfuma,","poem":1},{"text":"kana kubwinya kweimba yake kwawedzerwa;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"nokuti haana chaachatora paanofa;","poem":1},{"text":"kubwinya kwake hakungaburukiri naye murinda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kunyange paairarama aizviti akaropafadzwa,","poem":1},{"text":"uye vanhu vachirumbidza munhu paanobudirira,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"achabatana norudzi rwamadzibaba ake,","poem":1},{"text":"vasingazoonizve chiedza choupenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Munhu ane pfuma zhinji asinganzwisisi","poem":1},{"text":"akaita semhuka dzinofa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}