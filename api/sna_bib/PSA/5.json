{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Nenyere. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Rerekerai nzeve yenyu kumashoko angu, imi Jehovha.","poem":1},{"text":"Rangarirai chikumbiro changu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Teererai inzwi rokuchema kwangu,","poem":1},{"text":"Mambo wangu naMwari wangu,","poem":2},{"lineBreak":true},{"text":"nokuti ndinonyengetera kwamuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mangwanani, munonzwa inzwi rangu, imi Jehovha;","poem":1},{"text":"mangwanani ndinoisa zvikumbiro zvangu pamberi penyu","poem":2},{"lineBreak":true},{"text":"uye ndichimirira netariro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Imi hamusi Mwari anofarira zvakaipa;","poem":1},{"text":"munhu akaipa haangagari nemi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Munhu anozvikudza haangamiri pamberi penyu;","poem":1},{"text":"munovenga vose vanoita zvakaipa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Munoparadza vose vanoreva nhema;","poem":1},{"text":"vanoteura ropa navanhu vanonyengera,","poem":2},{"lineBreak":true},{"text":"Jehovha anovasema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Asi ini, nenyasha dzenyu huru,","poem":1},{"text":"ndichapinda mumba menyu;","poem":2},{"text":"norukudzo, ndichakotamira pasi pamberi penyu,","poem":1},{"text":"ndakatarira kutemberi yenyu tsvene.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nditungamirirei, imi Jehovha,","poem":1},{"text":"mukururama kwenyu nokuda kwavavengi vangu,","poem":2},{"lineBreak":true},{"text":"ruramisai nzira yenyu pamberi pangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hakuna shoko rinobva mumuromo mavo ringavimbwa naro;","poem":1},{"text":"mwoyo yavo izere nokuparadza.","poem":2},{"text":"Huro dzavo iguva rakashama;","poem":1},{"text":"vanotaura zvinonyengera norurimi rwavo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Haiwa Mwari, vapei mhosva!","poem":1},{"text":"Ngavawisirwe pasi nerangano dzavo.","poem":2},{"text":"Vabvisei nokuda kwezvivi zvavo zvizhinji,","poem":1},{"text":"nokuti vakakumukirai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Asi vose vanovanda mamuri ngavafare;","poem":1},{"text":"ngavagare vachiimba nomufaro.","poem":2},{"text":"Tambanudzirai pamusoro pavo kudzivirira kwenyu,","poem":1},{"text":"kuitira kuti vaya vanoda zita renyu vafare mamuri.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nokuti zvirokwazvo, imi Jehovha, munoropafadza vakarurama;","poem":1},{"text":"munovakomberedza nenyasha dzenyu sokunge nenhoo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}