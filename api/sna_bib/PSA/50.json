{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"hebrew_subtitle","content":["Pisarema raAsafi."]},{"type":"verse","number":1,"content":[{"text":"Iye Wamasimba, Mwari, Jehovha,","poem":1},{"text":"anotaura uye anodana nyika","poem":2},{"lineBreak":true},{"text":"kubva pakubuda kwezuva kusvikira kwarinovirira.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubva kuZioni, rakakwana parunako,","poem":1},{"text":"Mwari anopenya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwari wedu anouya uye haanganyarari;","poem":1},{"text":"moto unoparadza pamberi pake,","poem":2},{"lineBreak":true},{"text":"uye dutu rine hasha rakamupoteredza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anodana matenga kumusoro,","poem":1},{"text":"uye nenyika, kuti atonge vanhu vake achiti:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Ndiunganidzirei vatsvene vangu,","poem":1},{"text":"vakaita sungano neni nechibayiro.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uye matenga anoparidza kururama kwake,","poem":1},{"text":"nokuti Mwari amene ndiye mutongi. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Inzwai, imi vanhu vangu, uye ndichataura,","poem":1},{"text":"imi Israeri, uye ndichapupura pamusoro penyu:","poem":2},{"lineBreak":true},{"text":"Ndini Mwari, Mwari wenyu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Handikutukei nokuda kwezvibayiro zvenyu,","poem":1},{"text":"kana zvipiriso zvenyu zvinopiswa, zvinogara zviri pamberi pangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Handisi kuda hando inobva mudanga rako,","poem":1},{"text":"kana mbudzi inobva muzvirugu zvako,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"nokuti mhuka dzose dzesango ndedzangu,","poem":1},{"text":"nemombe pamakomo chiuru.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndinoziva shiri dzose dziri mumakomo,","poem":1},{"text":"uye zvisikwa zvose zvesango ndezvangu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kana dai ndaiva nenzara, handaikuudza iwe,","poem":1},{"text":"nokuti nyika ndeyangu, nezvose zviri mairi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ko, ndinodya nyama yehando","poem":1},{"text":"kana kunwa ropa rembudzi here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Bayirai zvibayiro zvokuvonga kuna Mwari,","poem":1},{"text":"zadzisai zvamakapikira Wokumusoro-soro,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"uye mudane kwandiri pazuva rokutambudzika;","poem":1},{"text":"ndichakurwirai, uye imi muchandikudza.”","poem":2}]},{"type":"verse","number":16,"content":["Asi kuna vakaipa, Mwari anoti:",{"text":"“Ko, une mvumo ipiko iwe yokuti ududzire mutemo wangu,","poem":1},{"text":"kana kuisa sungano yangu pamiromo yako?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unovenga kurayira kwangu,","poem":1},{"text":"uye unorasira mashoko angu shure kwako.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Paunoona mbavha, unowadzana nayo;","poem":1},{"text":"unogoverana nemhombwe mugove wako.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Unoshandisa muromo wako kuita zvakaipa,","poem":1},{"text":"uye unorovedza rurimi rwako kukunyengera.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Unogara uchipomera hama yako","poem":1},{"text":"uye unoitira mwanakomana wamai vako makuhwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Zvinhu izvi wakazviita ini ndikaramba ndinyerere;","poem":1},{"text":"wakafunga kuti ndakafanana newe.","poem":2},{"text":"Asi ndichakutsiura","poem":1},{"text":"uye ndichaisa mhosva iyi pamberi pako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Fungai izvi, imi vanokanganwa Mwari,","poem":1},{"text":"kuti ndirege kukubvambura-bvamburai mukashaya angakununurai:","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Munhu anobayira chibayiro chokuvonga ndiye anondikudza,","poem":1},{"text":"uye anogadzira nzira","poem":2},{"lineBreak":true},{"text":"kuitira kuti ndimuratidze ruponeso rwaMwari.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}