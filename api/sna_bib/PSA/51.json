{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi. Panguva yakauya muprofita Natani kwaari shure kwokuita upombwe kwaDhavhidhi naBhatishebha."]},{"type":"verse","number":1,"content":[{"text":"Ndinzwirei tsitsi, imi Mwari,","poem":1},{"text":"nokuda kworudo rwenyu rusingaperi;","poem":2},{"text":"dzimai kudarika kwangu","poem":1},{"text":"nokuda kwengoni dzenyu huru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Shambidzai zvakaipa zvangu zvose","poem":1},{"text":"uye mundinatse kubva pachivi changu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nokuti ndinoziva kudarika kwangu,","poem":1},{"text":"uye chivi changu chinogara chiri pamberi pangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndakakutadzirai imi, iyemi moga","poem":1},{"text":"nokuita chinhu chakaipa pamberi penyu,","poem":2},{"text":"kuti munzi makarurama pamunotaura","poem":1},{"text":"uye musapomerwa mhosva pakutonga kwenyu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zvirokwazvo ndakanga ndiri mutadzi pandakaberekwa,","poem":1},{"text":"ndiri mutadzi kubva pandakaumbwa mudumbu ramai vangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zvirokwazvo imi munoda chokwadi pakati pomwoyo;","poem":1},{"text":"munondidzidzisa uchenjeri panzvimbo yomukatikati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ndinatsei nehisopi, ipapo ndichachena;","poem":1},{"text":"ndishambidzei, ipapo ndichachena sechando.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndiitei kuti ndinzwe mufaro nokufarisisa;","poem":1},{"text":"itai kuti mapfupa amakapwanya afare.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vanzai chiso chenyu pazvivi zvangu","poem":1},{"text":"uye mudzime zvakaipa zvangu zvose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sikai mukati mangu mwoyo wakachena, imi Mwari,","poem":1},{"text":"uye muvandudze mweya wakarurama mukati mangu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Regai kundirasa pamberi penyu","poem":1},{"text":"kana kubvisa Mweya wenyu Mutsvene kwandiri.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dzoreraizve kwandiri mufaro woruponeso rwenyu,","poem":1},{"text":"uye mundipe mweya unoda, kuti undiraramise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ipapo ndichadzidzisa vadariki nzira dzenyu,","poem":1},{"text":"uye vatadzi vachatendeukira kwamuri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndiponesei pamhosva yeropa, imi Mwari,","poem":1},{"text":"iyemi Mwari anondiponesa,","poem":2},{"lineBreak":true},{"text":"ipapo rurimi rwangu ruchaimba zvokururama kwenyu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Haiwa Ishe, zarurai miromo yangu,","poem":1},{"text":"ipapo muromo wangu uchaparidza rumbidzo yenyu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hamufariri chibayiro, ndingadai ndakuvigirai,","poem":1},{"text":"imi hamufariri zvipiriso zvinopiswa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Zvibayiro zvaMwari mweya wakaputsika;","poem":1},{"text":"mwoyo wakaputsika nowakapwanyika,","poem":2},{"lineBreak":true},{"text":"imi Mwari hamuzoushori.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Pamufaro wenyu wakanaka, itai kuti Zioni ribudirire;","poem":1},{"text":"muvake masvingo eJerusarema.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ipapo pachava nezvibayiro zvakarurama,","poem":1},{"text":"zvipiriso zvinopiswa zvakazara zvinokufadzai;","poem":2},{"lineBreak":true},{"text":"ipapo hando dzichabayirwa paaritari yenyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}