{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Rwiyo rweMasikiri rwaDhavhidhi. Dhoegi muEdhomu paakanga aenda kuna Sauro akamuudza kuti: “Dhavhidhi aenda kumba kwaAhimereki.”"]},{"type":"verse","number":1,"content":[{"text":"Ko, unozvikudzirei pane zvakaipa, iwe murume wesimba?","poem":1},{"text":"Unozvikudzirei zuva rose,","poem":2},{"lineBreak":true},{"text":"iyewe unonyadzisa pamberi paMwari?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rurimi rwako runofarira zvokuparadza;","poem":1},{"text":"rwakaita sechisvo chakarodzwa,","poem":2},{"lineBreak":true},{"text":"iyewe unogara uchingonyengera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unoda zvakaipa pachinzvimbo chezvakanaka,","poem":1},{"text":"kureva nhema pachinzvimbo chokutaura chokwadi. Sera","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unoda shoko rimwe nerimwe rinoparadza,","poem":1},{"text":"iwe rurimi runonyengera!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zvirokwazvo Mwari achakuburutsira kukuparadzwa kusingaperi:","poem":1},{"text":"Achakubvuta agokubvisa mutende rako;","poem":2},{"lineBreak":true},{"text":"achakudzura kubva munyika yavapenyu. Sera","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vakarurama vachazviona uye vachatya;","poem":1},{"text":"vachamuseka vachiti,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Houno zvino munhu asina kuita Mwari nhare yake,","poem":1},{"text":"asi aivimba nepfuma yake zhinji,","poem":2},{"lineBreak":true},{"text":"uye aisimba nokuparadza vamwe!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Asi ini ndakaita somuti","poem":1},{"text":"womuorivhi unokura zvakanaka mumba maMwari;","poem":2},{"text":"ndinovimba norudo rusingaperi rwaMwari,","poem":1},{"text":"nokusingaperi-peri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndichakurumbidzai, nokusingaperi nokuda kwezvamakaita;","poem":1},{"text":"ndichavimba nezita renyu, nokuti zita renyu rakanaka.","poem":2},{"lineBreak":true},{"text":"Ndichakurumbidzai pamberi pavatsvene venyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}