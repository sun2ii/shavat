{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Namaimbirwo eMaharati. Rwiyo rweMasikiri rwaDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Benzi rinoti mumwoyo maro,","poem":1},{"text":"“Mwari hakuna.”","poem":2},{"text":"Vakaora, uye nzira dzavo dzakaipa;","poem":1},{"text":"hakuna anoita zvakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mwari anotarira ari kudenga,","poem":1},{"text":"pavanakomana vavanhu,","poem":2},{"text":"kuti aone kana aripo anonzwisisa,","poem":1},{"text":"kana aripo anotsvaka Mwari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mumwe nomumwe wavo akadzokera shure,","poem":1},{"text":"vakava vakaora pamwe chete;","poem":2},{"text":"hakuna anoita zvakanaka,","poem":1},{"text":"kunyange nomumwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ko, vaiti vezvakaipa havangadzidzi here,","poem":1},{"text":"vaya vanodya vanhu vangu savanhu vanodya chingwa,","poem":2},{"lineBreak":true},{"text":"uye vasingadani kuna Mwari?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Havo, vakazadzwa nokutya,","poem":1},{"text":"ipo pasina chavangatya.","poem":2},{"text":"Mwari akaparadzira mapfupa avanhu vaikurwisa;","poem":1},{"text":"makavanyadzisa, nokuti Mwari akavazvidza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Haiwa, dai ruponeso rwaIsraeri rwabuda kubva muZioni;","poem":1},{"text":"Mwari paachadzosera nhaka yavanhu vake;","poem":2},{"lineBreak":true},{"text":"Jakobho ngaafarisise uye Israeri ngaafarisise!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}