{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba nemitengeranwa ine hungiso. Rwiyo rweMasikiri rwaDhavhidhi. VaZefati pavakaenda kuna Sauro kundoti, “Ko, Dhavhidhi haana kuvanda pakati pedu here?”"]},{"type":"verse","number":1,"content":[{"text":"Ndiponesei, imi Mwari, nezita renyu;","poem":1},{"text":"ndiruramisirei nesimba renyu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inzwai munyengetero wangu, imi Mwari;","poem":1},{"text":"teererai kumashoko omuromo wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Vatorwa vanondirwisa;","poem":1},{"text":"vanhu vane utsinye vanotsvaka upenyu hwangu,","poem":2},{"lineBreak":true},{"text":"vanhu vasingazivi Mwari. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Zvirokwazvo Mwari ndiye mubatsiri wangu;","poem":1},{"text":"ishe ndiye anonditsigira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zvakaipa ngazvimonere pane avo vanondireva;","poem":1},{"text":"muvaparadze pakutendeka kwenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndichakubayirai chipiriso chokungopa;","poem":1},{"text":"ndicharumbidza zita renyu, imi Jehovha,","poem":2},{"lineBreak":true},{"text":"nokuti rakanaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nokuti akandirwira pamatambudziko angu ose,","poem":1},{"text":"uye mukukunda, meso angu akatarisa vavengi vangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}