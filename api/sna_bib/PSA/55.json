{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba nemitengeranwa ine hungiso. Rwiyo rweMasikiri rwaDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Rerekerai nzeve yenyu kumunyengetero wangu, imi Mwari;","poem":1},{"text":"regai kushaya hanya nokukumbira kwangu;","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ndinzwei, uye ndipindureiwo.","poem":2},{"text":"Pfungwa dzangu dzinondinetsa uye ndiri kushushikana,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"pandinonzwa inzwi romuvengi wangu,","poem":2},{"text":"pandinodzvokorwa navakaipa; nokuti vanodururira matambudziko pamusoro pangu,","poem":1},{"text":"uye vanondituka mukutsamwa kwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mwoyo wangu unorwadziwa mukati mangu;","poem":1},{"text":"kutyisa kworufu kunondiwira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kutya nokudedera zvakandibata;","poem":1},{"text":"kutya kukuru kwakandifukidza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ini ndakati, “Haiwa, dai ndina mapapiro enjiva!","poem":1},{"text":"Ndaibhururukira kure ndikandozorora hangu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ndaitizira kure kwazvo,","poem":1},{"text":"ndikandogara mugwenga; Sera","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ndaikurumidza kundovanda panzvimbo yangu,","poem":1},{"text":"kure nemafungu nedutu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nyonganisai vakaipa, imi Ishe, kanganisai mutauro wavo,","poem":1},{"text":"nokuti ndinoona mhirizhonga nokurwa muguta.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Masikati nousiku vanopoterera masvingo aro chinyararire;","poem":1},{"text":"utsinye nokumanikidza zviri mukati maro.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Masimba okuparadza azere muguta;","poem":1},{"text":"kutyisidzira nenhema hazvibvi munzira dzaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dai ndatukwa nomuvengi,","poem":1},{"text":"ndaigona kushinga hangu;","poem":2},{"text":"dai muvengi aindimukira,","poem":1},{"text":"ndaigona kumuvanda hangu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Asi ndiwe, munhu akaita seni,","poem":1},{"text":"mumwe wangu, shamwari yangu yapedyo,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"yandaimbofarira kuwadzana nayo","poem":1},{"text":"pataifamba navazhinji mumba maMwari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Rufu ngaruwane vavengi vangu vasingafungiri;","poem":1},{"text":"ngavaburukire muguva vari vapenyu,","poem":2},{"lineBreak":true},{"text":"nokuti kuipa kwakawana pokugara pakati pavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Asi ini ndinodana kuna Mwari,","poem":1},{"text":"uye Jehovha anondiponesa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Madekwana, mangwanani namasikati","poem":1},{"text":"ndinochema mukushushikana,","poem":2},{"lineBreak":true},{"text":"uye iye anonzwa inzwi rangu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anondidzikinura ndisina kukuvara","poem":1},{"text":"kubva pahondo inondirwisa,","poem":2},{"lineBreak":true},{"text":"kunyange zvazvo vazhinji vachindipikisa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mwari, agere pachigaro choushe nokusingaperi,","poem":1},{"text":"achavanzwa agovaninipisa, Sera","poem":2},{"text":"ivo vanhu vasingamboshanduri nzira dzavo,","poem":1},{"text":"uye vasingatyi Mwari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mumwe wangu anorova shamwari dzake;","poem":1},{"text":"anoputsa sungano yake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mutauro wake unotsvedzerera samafuta,","poem":1},{"text":"asi kurwa kuri mumwoyo make;","poem":2},{"text":"mashoko ake anopfavisa kukunda mafuta,","poem":1},{"text":"asi minondo yakavhomorwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kanda kufunganya kwako pana Jehovha","poem":1},{"text":"uye iye achakusimbisa;","poem":2},{"lineBreak":true},{"text":"haazombotenderi vakarurama kuti vawire pasi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Asi imi, iyemi Mwari, muchaburutsira vakaipa pasi","poem":1},{"text":"mugomba rokuora;","poem":2},{"text":"vanhu vanokarira ropa navanyengeri","poem":1},{"text":"havangararami hafu yamazuva avo.","poem":2},{"lineBreak":true},{"text":"Asi kana ndirini, ndinovimba nemi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}