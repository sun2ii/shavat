{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Namaririro e“Njiva paMiouki iri kure.” Pisarema raDhavhidhi. Rwiyo rweMikitami. Paakabatwa navaFiristia paGati."]},{"type":"verse","number":1,"content":[{"text":"Ndinzwirei ngoni, imi Mwari, nokuti vanhu vanondidzinganisa nehasha;","poem":1},{"text":"zuva rose vanorwa neni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vavengi vangu vanondidzinganisa zuva rose;","poem":1},{"text":"vazhinji vanorwa neni mukuzvikudza kwavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pandinenge ndotya,","poem":1},{"text":"ndichavimba nemi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Muna Mwari, iye ane shoko randinorumbidza,","poem":1},{"text":"muna Mwari ndinovimba; handichazotyi.","poem":2},{"lineBreak":true},{"text":"Ko, munhu anofa angandiitei?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zuva rose vanomonyorora mashoko angu;","poem":1},{"text":"vanogara vachirangana kundikuvadza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vanorangana, vanovandira,","poem":1},{"text":"vanocherechedza mafambiro angu,","poem":2},{"lineBreak":true},{"text":"vachishuva kundiuraya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngavasapunyuka savasina mhaka;","poem":1},{"text":"koromorerai ndudzi pasi mukutsamwa kwenyu imi Mwari.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nyorai kuchema kwangu;","poem":1},{"text":"isai misodzi yangu parugwaro rwenyu,","poem":2},{"lineBreak":true},{"text":"ko, hazvina kuiswa muzvinyorwa zvenyu here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ipapo vavengi vangu vachadzokera shure","poem":1},{"text":"pandinodanidzira kuti ndibatsirwe.","poem":2},{"lineBreak":true},{"text":"Nechinhu ichi, ndichaziva kuti Mwari ari kurutivi rwangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Muna Mwari, iye ane shoko randinorumbidza,","poem":1},{"text":"muna Jehovha, ane shoko randinorumbidza,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"muna Mwari ndinovimba; handichazotyi chinhu.","poem":1},{"text":"Ko, munhu angandiitei?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndinosungwa nemhiko kwamuri, imi Mwari;","poem":1},{"text":"ndichakuvigirai zvipo zvangu zvokuvonga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nokuti makandirwira parufu,","poem":1},{"text":"uye netsoka dzangu pakugumburwa,","poem":2},{"text":"kuti ndifambe pamberi penyu","poem":1},{"text":"muchiedza choupenyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}