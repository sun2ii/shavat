{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba namaimbiro okuti, “Musaparadza.” Pisarema raDhavhidhi. Rwiyo rweMikitami. Paakatiza kubva kuna Sauro akapinda mubako."]},{"type":"verse","number":1,"content":[{"text":"Ndinzwirei ngoni, imi Mwari, ndinzwirei ngoni,","poem":1},{"text":"nokuti mweya wangu unovanda mamuri.","poem":2},{"text":"Ndichavanda mumumvuri wamapapiro enyu,","poem":1},{"text":"kusvikira njodzi yapfuura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ndinodanidzira kuna Mwari Wokumusoro-soro,","poem":1},{"text":"kuna Mwari anozadzisa chinangwa chake kwandiri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anotuma kubva kudenga agondiponesa,","poem":1},{"text":"achituka vaya vanondidzingirira nehasha; Sera","poem":2},{"lineBreak":true},{"text":"Mwari anotumira rudo rwake nokutendeka kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndiri pakati peshumba;","poem":1},{"text":"ndinovata pakati pemhuka dzinokara,","poem":2},{"text":"ivo vanhu vane meno amapfumo nemiseve,","poem":1},{"text":"vane ndimi dzinopinza seminondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kudzwai, imi Mwari, pamusoro pamatenga;","poem":1},{"text":"kubwinya kwenyu ngakuve pamusoro penyika yose. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vanowaririra tsoka dzangu mimbure,","poem":1},{"text":"ndakakotamiswa pasi nenhamo.","poem":2},{"text":"Vakachera gomba panzira yangu,","poem":1},{"text":"asi vakawiramo vamene. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mwoyo wangu wakasimba, Mwari wangu,","poem":1},{"text":"mwoyo wangu wakasimba;","poem":2},{"lineBreak":true},{"text":"ndichaimba uye ndichaimba rwiyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Chimuka iwe mweya wangu!","poem":1},{"text":"Mukai imi mutengeranwa nembira!","poem":2},{"lineBreak":true},{"text":"Ini ndichamutsa mambakwedza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndichakurumbidzai imi, iyemi Ishe, pakati pendudzi;","poem":1},{"text":"ndichakuimbirai pakati pamarudzi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nokuti rudo rwenyu rukuru, runosvika kudenga denga;","poem":1},{"text":"kutendeka kwenyu kunosvika kumusoro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kudzwai, imi Mwari, pamusoro pamatenga;","poem":1},{"text":"kubwinya kwenyu ngakuve pamusoro penyika yose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}