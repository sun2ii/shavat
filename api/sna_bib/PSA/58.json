{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba namaimbiro okuti, “Musaparadza.” Pisarema raDhavhidhi. Rwiyo rweMikitami."]},{"type":"verse","number":1,"content":[{"text":"Ko, imi vatongi munotaura mukururama here?","poem":1},{"text":"Munotonga pakati pavanhu nokururamisira here?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwete, munofunga kusaruramisira mumwoyo menyu,","poem":1},{"text":"uye maoko enyu anomanikidza panyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kunyange kubvira pakuberekwa, vakaipa vanofamba mukutsauka;","poem":1},{"text":"kubva mudumbu ramai, vakaipa uye vanoreva nhema.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uturu hwavo hwakaita souturu hwenyoka,","poem":1},{"text":"vakafanana nemhakure yadzivira nzeve dzayo,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"isingateereri maimbiro enʼanga","poem":1},{"text":"kunyange zvazvo achiimba nouchenjeri hukuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vhunai mazino mumiromo yavo, imi Mwari;","poem":1},{"text":"bvisai, imi Jehovha, mazino marefu eshumba!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngavatsakatike semvura yapera kuerera;","poem":1},{"text":"pavanowembura uta, miseve yavo ngaigomare.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vafanane nehozhwa inonyakatika painofamba,","poem":1},{"text":"kufanana negavamwedzi, ngavarege kuona zuva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hari dzenyu dzisati dzanzwa kupisa kweminzwa pamoto,","poem":1},{"text":"ingava minyoro kana yakaoma, vakaipa vachakukurwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vakarurama vachafara pavachatsivirwa,","poem":1},{"text":"pavachashambidza tsoka dzavo muropa ravakaipa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ipapo vanhu vachati,","poem":1},{"text":"“Zvirokwazvo vakarurama vachiri kungowana mubayiro;","poem":2},{"lineBreak":true},{"text":"zvirokwazvo Mwari ariko anotonga nyika.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}