{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba namaimbiro anoti, “Musaparadza.” Pisarema raDhavhidhi. Rwiyo rweMikitami. Sauro paakanga atuma varume kundorinda imba yaDhavhidhi kuti amuuraye."]},{"type":"verse","number":1,"content":[{"text":"Ndirwirei pavavengi vangu, imi Mwari;","poem":1},{"text":"Ndidzivirirei kubva kuna avo vanondimukira.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndirwirei pavaiti vezvakaipa,","poem":1},{"text":"uye mundiponese pavanhu vanokarira kuteura ropa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tarirai kundivandira kwavakaita!","poem":1},{"text":"Vanhu vanotyisa vanondirangana","poem":2},{"lineBreak":true},{"text":"pasina mhosva yandapara kana chivi, nhai Jehovha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Handina chandakakanganisa, asi ivo vagadzirira kundirwisa.","poem":1},{"text":"Simukai mundibatsire; tarirai dambudziko rangu!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haiwa Jehovha, Mwari Wamasimba Ose, Mwari waIsraeri,","poem":1},{"text":"mukai murange ndudzi dzose;","poem":2},{"lineBreak":true},{"text":"musanzwira ngoni vakaipa navapanduki. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vanodzoka madekwana,","poem":1},{"text":"vachihonʼa sembwa,","poem":2},{"lineBreak":true},{"text":"uye vachinyahwaira muguta.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onai zvavanorutsa mumiromo yavo:","poem":1},{"text":"vanorutsa minondo kubva pamiromo yavo,","poem":2},{"lineBreak":true},{"text":"uye vanoti, “Ndiani angatinzwa?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asi imi, iyemi Jehovha, munovaseka;","poem":1},{"text":"munodadira ndudzi dzose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Haiwa imi simba rangu, ndinokurindirai;","poem":1},{"text":"imi, iyemi Mwari, ndimi nhare yangu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mwari anondida","poem":2},{"lineBreak":true},{"text":"achanditungamirira","poem":1},{"text":"uye achanditendera kuti ndifare pamusoro pavanondireva.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asi musavauraya, imi Ishe nhoo yedu,","poem":1},{"text":"zvimwe vanhu vangu vangakanganwa.","poem":2},{"text":"Musimba renyu itai kuti vadzungaire,","poem":1},{"text":"uye muvaderedze.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nokuda kwezvivi zvemiromo yavo,","poem":1},{"text":"nokuda kwamashoko emiromo yavo,","poem":2},{"lineBreak":true},{"text":"ngavabatwe pakuzvikudza kwavo.","poem":2},{"text":"Nokuda kwokutuka nenhema dzavanotaura,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"vaparadzei nehasha dzenyu,","poem":2},{"lineBreak":true},{"text":"vaparadzei kusvikira vapera.","poem":2},{"text":"Ipapo zvichazivikanwa kumigumo yenyika","poem":1},{"text":"kuti Mwari anotonga pamusoro paJakobho. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Vanodzoka madekwana,","poem":1},{"text":"vachihonʼa sembwa,","poem":2},{"lineBreak":true},{"text":"uye vachinyahwaira muguta.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vanodzungaira vachitsvaka zvokudya,","poem":1},{"text":"uye vanohuhudza kana vasina kuguta.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asi ini ndichaimba nezvesimba renyu,","poem":1},{"text":"ndichaimba nezvorudo rwenyu mangwanani;","poem":2},{"text":"nokuti imi muri nhare yangu,","poem":1},{"text":"utiziro hwangu panguva dzokutambudzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Haiwa imi simba rangu, ndinokuimbirai nziyo dzokukurumbidzai;","poem":1},{"text":"imi, Mwari, ndimi nhare yangu, Mwari anondida.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}