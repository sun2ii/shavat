{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba nemitengeranwa. Nesheminiti. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, regai kundirayira mukutsamwa kwenyu,","poem":1},{"text":"kana kundiranga muhasha dzenyu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndinzwirei ngoni, Jehovha, nokuti ndava kuziya;","poem":1},{"text":"haiwa Jehovha, ndiporesei, nokuti mapfupa angu ava kurwadza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mweya wangu uri kurwadziwa.","poem":1},{"text":"Haiwa Jehovha, kusvikira riniko, kusvikira riniko?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dzokai, imi Jehovha, mugondirwira;","poem":1},{"text":"ndiponesei nokuda kworudo rwenyu rusingaperi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hakuna anokurangarirai kana afa.","poem":1},{"text":"Ndiani anokurumbidzai kubva muguva?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndaneta nokugomera;","poem":1},{"text":"ndinonyorovesa mubhedha wangu nemisodzi ndichichema usiku hwose,","poem":2},{"lineBreak":true},{"text":"ndinonyorovesa uvato hwangu nemisodzi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Meso angu aneta nokuchema;","poem":1},{"text":"haachaoni nokuda kwavavengi vangu vose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ibvai pandiri, imi mose munoita zvakaipa,","poem":1},{"text":"nokuti Jehovha anzwa kuchema kwangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jehovha anzwa kukumbira kwangu nyasha;","poem":1},{"text":"Jehovha anogamuchira munyengetero wangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vavengi vangu vose vachanyadziswa uye vachavhundutswa;","poem":1},{"text":"vachadzokera shure pakarepo mukunyadziswa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}