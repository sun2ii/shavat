{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":60,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba namaimbirwo e“Ruva reMahapa reSungano.” Rwiyo rweMikitami rwaDhavhidhi. Rwokudzidzisa. Paakarwa neAramu Naharaimu neAramu Zobha, uye panguva yakadzoka Joabhu akaparadza zviuru gumi nezviviri zvavaEdhomu muMupata woMunyu."]},{"type":"verse","number":1,"content":[{"text":"Makatiramba, imi Mwari, uye mukatirwisa;","poem":1},{"text":"makanga makatsamwa, zvino tidzorei henyu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Makazungunusa nyika mukaitsemura napakati;","poem":1},{"text":"gadzirai henyu mitswe yayo, nokuti iri kudengenyeka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Makaratidza vanhu venyu nguva dzakaoma;","poem":1},{"text":"makatipa waini inotidzedzeresa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Asi kuna vanokutyai, makasimudza mureza","poem":1},{"text":"kuti urege kupfaranyurwa neuta. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tiponesei uye tibatsirei noruoko rwenyu rworudyi,","poem":1},{"text":"kuti avo vamunoda varwirwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwari akataura ari muimba yake tsvene achiti:","poem":1},{"text":"“Ndichaganhura Shekemu nesimba","poem":2},{"lineBreak":true},{"text":"uye ndichayera Mupata weSukoti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gireadhi nderangu, uye Manase ndowangu;","poem":1},{"text":"Efuremu inguwani yangu yakasimba,","poem":2},{"lineBreak":true},{"text":"Judha itsvimbo yangu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Moabhu ndiwo mudziyo wangu wokushambira,","poem":1},{"text":"pamusoro paEdhomu ndipo pandinokanda shangu yangu;","poem":2},{"lineBreak":true},{"text":"pamusoro paFiristia ndinopururudza mukukunda.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndianiko achandiisa kuguta rakakomberedzwa?","poem":1},{"text":"Ndianiko achanditungamirira kuenda kuEdhomu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hamusimi, iyemi Mwari, iyemi makatiramba here,","poem":1},{"text":"uye mukarega kubuda nehondo dzedu?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tibatsirei pavavengi vedu,","poem":1},{"text":"nokuti rubatsiro rwavanhu haruna maturo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"NaMwari wedu, tichakunda,","poem":1},{"text":"uye achatsikira vavengi vedu pasi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}