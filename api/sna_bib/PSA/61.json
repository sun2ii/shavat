{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba, nomutengeranwa une hungiso. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Inzwai kuchema kwangu, imi Mwari;","poem":1},{"text":"rerekerai nzeve yenyu kumunyengetero wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kubva kumigumo yenyika, ndinodanidzira kwamuri,","poem":1},{"text":"ndinodana sezvo mwoyo wangu woziya;","poem":2},{"lineBreak":true},{"text":"nditungamirirei kudombo rakakwirira kundipfuura.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti imi makanga muri utiziro hwangu,","poem":1},{"text":"shongwe yakasimba pamusoro pavavengi vangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndinopanga kugara mutende renyu nokusingaperi,","poem":1},{"text":"uye nokuvanda mumumvuri wamapapiro enyu. Sera","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nokuti makanzwa mhiko dzangu, imi Mwari;","poem":1},{"text":"makandipa nhaka yaavo vanotya zita renyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wedzerai mazuva oupenyu hwamambo,","poem":1},{"text":"makore ake kumarudzi namarudzi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngaagare pachigaro choushe pamberi paMwari nokusingaperi;","poem":1},{"text":"gadzai rudo nokutendeka kwenyu kuti zvimudzivirire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ipapo ndichagara ndichirumbidza zita renyu nenziyo,","poem":1},{"text":"uye ndichazadzisa mhiko dzangu zuva nezuva.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}