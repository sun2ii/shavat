{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Kuna Jedhutuni. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Mweya wangu unozorora muna Mwari oga;","poem":1},{"text":"ruponeso rwangu runobva kwaari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iye oga ndiye dombo rangu noruponeso rwangu;","poem":1},{"text":"ndiye nhare yangu, handingambozungunuswi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Muchasvika kupiko muchingorova munhu?","poem":1},{"text":"Ko, imi mose muchamukanda pasi here,","poem":2},{"lineBreak":true},{"text":"iyeyu rusvingo rwakarereka, noruzhowa rwuri kuwa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vanofunga kwazvo zvokumuwisira","poem":1},{"text":"pasi kubva panzvimbo yake yakakwirira;","poem":2},{"lineBreak":true},{"text":"vanofarira nhema.","poem":2},{"text":"Vanoropafadza nemiromo yavo,","poem":1},{"text":"Asi vachituka mumwoyo yavo. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iwe mweya wangu, zviwanire zororo muna Mwari oga;","poem":1},{"text":"tariro yangu inobva kwaari.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndiye oga dombo rangu noruponeso rwangu;","poem":1},{"text":"ndiye nhare yangu, handingazungunuswi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ruponeso rwangu nokukudzwa kwangu zvinobva kuna Mwari;","poem":1},{"text":"ndiye dombo rangu guru, noutiziro hwangu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vimbai naye nguva dzose, imi vanhu;","poem":1},{"text":"dururai mwoyo yenyu kwaari,","poem":2},{"lineBreak":true},{"text":"nokuti Mwari ndiye utiziro hwedu. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Vanhu vasina maturo vanongova mweya zvawo,","poem":1},{"text":"asi vanokudzwa inhema bedzi;","poem":2},{"text":"kana vakayerwa havaremi, havasi chinhu;","poem":1},{"text":"vose pamwe chete vanongova mweya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Regai kuvimba noupambi","poem":1},{"text":"kana kuzvikudza nezvinhu zvokuba;","poem":2},{"text":"kunyange pfuma yenyu ichiwanda,","poem":1},{"text":"regai kuisa mwoyo yenyu pairi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Chinhu chimwe chakataurwa naMwari,","poem":1},{"text":"zvinhu zviviri zvandakanzwa:","poem":2},{"text":"Kuti imi, iyemi Mwari, mune simba,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"uye kuti imi, iyemi Ishe, mune rudo.","poem":2},{"text":"Zvirokwazvo muchapa mubayiro kumunhu mumwe nomumwe","poem":1},{"text":"maererano nezvaakaita.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}