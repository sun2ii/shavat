wangu uchagutswa kunge wadya zvakakora kwazvo;","poem":1},{"text":"muromo wangu uchakurumbidzai nemiromo inofara kwazvo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndinokurangarirai ndiri pamubhedha wangu;","poem":1},{"text":"ndinokufungai panguva dzose dzousiku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nokuti muri mubatsiri wangu,","poem":1},{"text":"ndinoimba ndiri mumumvuri wamapapiro enyu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mweya wangu unonamatira kwamuri;","poem":1},{"text":"ruoko rwenyu rworudyi runonditsigira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Vanotsvaka upenyu hwangu vachaparadzwa;","poem":1},{"text":"vachaburukira kwakadzika kwepasi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vachaiswa kumunondo","poem":1},{"text":"vagova zvokudya zvamakava.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Asi mambo achafara muna Mwari;","poem":1},{"text":"vose vanopika nezita raMwari vachamurumbidza,","poem":2},{"lineBreak":true},{"text":"asi miromo yavanoreva nhema ichafumbirwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}