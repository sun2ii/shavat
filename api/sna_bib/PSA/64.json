{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndinzweiwo, imi Mwari, pandinotaura chichemo changu;","poem":1},{"text":"dzivirirai upenyu hwangu pakutyisidzira kwavavengi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndivanzei pakurangana kwavakaipa,","poem":1},{"text":"ndibve pazhowezhowe yeungano yavaiti vezvakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Vanorodza ndimi dzavo seminondo,","poem":1},{"text":"uye vanonanga namashoko avo semiseve inouraya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vanopfura vari pakavanda munhu asina mhosva;","poem":1},{"text":"vanomupfura pakarepo, vasingatyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vanokurudzira mumwe nomumwe wavo pakufunga zvakaipa,","poem":1},{"text":"vanotaura pamusoro pokuteya misungo yavo, uye vanoti,","poem":2},{"lineBreak":true},{"text":"“Ndianiko achaiona?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vanorangana kusaruramisira vachiti,","poem":1},{"text":"“Tafunga zano rakakwana!”","poem":2},{"lineBreak":true},{"text":"Zvirokwazvo mwoyo nomurangariro womunhu zvinonyengera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Asi Mwari achavapfura nemiseve;","poem":1},{"text":"pakarepo vachawira pasi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Achaita kuti ndimi dzavo dzivashandukire,","poem":1},{"text":"uye achavaisa pakuparadzwa;","poem":2},{"lineBreak":true},{"text":"vose vanovaona vachavadzungudzira misoro vachivaseka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Marudzi ose avanhu achatya;","poem":1},{"text":"achaparidza mabasa aMwari,","poem":2},{"lineBreak":true},{"text":"uye achafungisisa zvaakaita.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vakarurama ngavafare muna Jehovha","poem":1},{"text":"uye vavande maari;","poem":2},{"lineBreak":true},{"text":"vose vakarurama mumwoyo ngavamurumbidze!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}