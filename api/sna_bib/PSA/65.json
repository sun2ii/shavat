{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Pisarema raDhavhidhi. Rwiyo."]},{"type":"verse","number":1,"content":[{"text":"Kurumbidzwa kwakakumirirai, imi Mwari, muZioni;","poem":1},{"text":"kwamuri mhiko dzedu dzichazadziswa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haiwa, imi munonzwa munyengetero,","poem":1},{"text":"vanhu vose vachauya kwamuri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Patakanga takafukidzwa nezvivi,","poem":1},{"text":"makakanganwira kudarika kwedu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vakaropafadzwa avo vamunosarudza","poem":1},{"text":"navamunoswededza pedyo kuti vagare pavanze dzenyu!","poem":2},{"text":"Takagutswa nezvinhu zvakanaka zveimba yenyu,","poem":1},{"text":"zvetemberi yenyu tsvene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Munotipindura namabasa okururama anotyisa,","poem":1},{"text":"imi Mwari Muponesi wedu,","poem":2},{"text":"tariro yemigumo yepasi pose","poem":1},{"text":"namakungwa ari kure kure,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"iyemi makaumba makomo nesimba renyu,","poem":1},{"text":"makazvishongedza nesimba,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"iyemi makanyaradza kutinhira kwamakungwa,","poem":1},{"text":"iko kutinhira kwamafungu aro,","poem":2},{"lineBreak":true},{"text":"nokupopota kwendudzi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanogara kure kure vanotya zvishamiso zvenyu;","poem":1},{"text":"uko kunobuda mambakwedza uye madekwana achipera,","poem":2},{"lineBreak":true},{"text":"munodanidzira nziyo dzomufaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mune hanya nenyika uye munoidiridza;","poem":1},{"text":"munoipfumisa kwazvo.","poem":2},{"text":"Hova dzaMwari dzizere nemvura","poem":1},{"text":"kuti dzivigire vanhu zviyo,","poem":2},{"lineBreak":true},{"text":"nokuti saizvozvo ndimi makazvirayira.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Munozadza mihoronga yacho nemvura,","poem":1},{"text":"uye munoenzanisa mihomba yacho;","poem":2},{"text":"munoinyorovesa nemvura inopfunha","poem":1},{"text":"munoropafadza zvibereko zvayo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Munoshongedza gore nekorona yezvakawanda zvenyu,","poem":1},{"text":"uye ngoro dzenyu dzinopfachukira nezvakawanda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uswa hwomurenje hwopfachukira;","poem":1},{"text":"zvikomo zvakafukidzwa nomufaro.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mafuro azara namapoka emakwai,","poem":1},{"text":"uye mipata yafukidzwa nezviyo;","poem":2},{"lineBreak":true},{"text":"zvinodanidzira nomufaro uye zvinoimba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}