{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Rwiyo. Pisarema."]},{"type":"verse","number":1,"content":[{"text":"Danidzirai nomufaro kuna Mwari, imi nyika yose!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Imbirai mukurumbira wezita rake;","poem":2},{"lineBreak":true},{"text":"murumbidze zvikuru kukudzwa kwake!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muti kuna Mwari, “Mabasa enyu anotyisa sei!","poem":1},{"text":"Simba renyu iguru zvokuti vavengi venyu","poem":2},{"lineBreak":true},{"text":"vanodedera pamberi penyu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nyika yose inokukotamirai;","poem":1},{"text":"vanokuimbirai nziyo dzokurumbidza,","poem":2},{"lineBreak":true},{"text":"vanoimba nziyo dzokurumbidza zita renyu.” Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Uyai muone zvaitwa naMwari,","poem":1},{"text":"mabasa ake anotyisa sei pakati pavanhu!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akashandura gungwa rikava nyika yakaoma,","poem":1},{"text":"vakafamba nomumvura zhinji netsoka dzavo,","poem":2},{"lineBreak":true},{"text":"uyai, ngatifarei maari.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anotonga nokusingaperi nesimba rake,","poem":1},{"text":"meso ake anocherechedza ndudzi,","poem":2},{"lineBreak":true},{"text":"vanomumukira ngavarege kumisidzana naye. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rumbidzai Mwari wedu, imi vanhu,","poem":1},{"text":"inzwi rokurumbidzwa kwake ngarinzwike;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"iye akachengetedza upenyu hwedu","poem":1},{"text":"netsoka dzedu kuti dzirege kutedzemuka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nokuti imi, iyemi Mwari, makatiedza;","poem":1},{"text":"mukatinatsa sesirivha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Makatipinza mutorongo","poem":1},{"text":"mukatitakudza mitoro pamisana yedu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Makabvumira vanhu kukwira pamisoro yedu;","poem":1},{"text":"takapinda mumoto nomumvura,","poem":2},{"lineBreak":true},{"text":"asi makatiisa kunzvimbo ine zvakawanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndichauya nezvibayiro zvinopiswa kutemberi yenyu,","poem":1},{"text":"ndigozadzisa mhiko dzangu kwamuri,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mhiko dzandakavimbisa nemiromo yangu,","poem":1},{"text":"uye muromo wangu wakataura pandakanga ndiri munhamo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndichakubayirai mhuka dzakakora","poem":1},{"text":"nechipiriso chamakondobwe;","poem":2},{"lineBreak":true},{"text":"ndichabayirawo hando nembudzi. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Uyai munzwe, imi mose munotya Mwari;","poem":1},{"text":"ndikuudzei zvaakandiitira.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndakachema kwaari nomuromo wangu; rumbidzo yake yaiva parurimi rwangu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dai ndakanga ndaviga chivi mumwoyo mangu,","poem":1},{"text":"Ishe aidai asina kundinzwa;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"asi zvirokwazvo Mwari akateerera","poem":1},{"text":"akanzwa inzwi rangu mumunyengetero.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mwari ngaarumbidzwe,","poem":1},{"text":"iye asina kuramba munyengetero wangu.","poem":2},{"lineBreak":true},{"text":"Kana kudzivisa rudo rwake kwandiri!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}