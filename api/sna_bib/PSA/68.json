{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"hebrew_subtitle","content":["Mutungamiri mukuru wokuimba. Pisarema raDhavhidhi. Rwiyo."]},{"type":"verse","number":1,"content":[{"text":"Mwari ngaasimuke, vavengi vake ngavaparadzirwe;","poem":1},{"text":"vavengi vake ngavatize pamberi pake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sokupeperetswa kunoitwa utsi nemhepo,","poem":1},{"text":"saizvozvo vapeperetsei;","poem":2},{"text":"sokunyauka kunoita namo pamberi pomoto,","poem":1},{"text":"vakaipa ngavaparare pamberi paMwari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asi vakarurama ngavafare,","poem":1},{"text":"vafarisise pamberi paMwari;","poem":2},{"lineBreak":true},{"text":"ngavafare vapembere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Imbirai Mwari, imbirai zita rake nziyo dzokurumbidza,","poem":1},{"text":"murumbidzei zvikuru iye anofamba pamusoro pamakore,","poem":2},{"text":"zita rake ndiJehovha,","poem":1},{"text":"uye farai pamberi pake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baba venherera, mudziviriri wechirikadzi,","poem":1},{"text":"ndiye Mwari ari paugaro hwake utsvene.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vakanga vari voga Mwari akavagarisa mumhuri,","poem":1},{"text":"anosesedza vasungwa vachiimba;","poem":2},{"lineBreak":true},{"text":"asi mhandu dzinogara panyika yatsva nezuva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pamakatungamirira vanhu venyu, imi Mwari,","poem":1},{"text":"pamakafamba napakati perenje, Sera","poem":2}]},{"type":"verse","number":8,"content":[{"text":"nyika yakazungunuka,","poem":1},{"text":"matenga akadurura mvura, pamberi paMwari,","poem":2},{"text":"iye weSinai, pamberi paMwari,","poem":1},{"text":"iye Mwari waIsraeri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Imi Mwari, makanayisa mvura zhinji;","poem":1},{"text":"mukaita kuti nhaka yenyu yakaneta ifefeterwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vanhu venyu vakagaramo,","poem":1},{"text":"uye imi Mwari, kubva pane, zvakawanda zvenyu, makariritira varombo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ishe akataura shoko,","poem":1},{"text":"vanhu vakaparidza shoko vaiva vazhinji kwazvo:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Madzimambo navarwi vakakurumidza kutiza;","poem":1},{"text":"mumisasa, vanhu vakagovana zvakapambwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kunyange pamunenge makavata pakati pemoto yemisasa,","poem":1},{"text":"mapapiro enjiva yangu akafukidzwa nesirivha,","poem":2},{"lineBreak":true},{"text":"minhenga yayo negoridhe rinovaima.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wamasimba Ose paakaparadzira madzimambo munyika,","poem":1},{"text":"zvakanga zvakaita sechando chawira pamusoro peZarimoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Makomo eBhashani makomo oushe;","poem":1},{"text":"makomo eBhashani akati twi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Munotaririreiko negodo, imi makomo akati twi,","poem":1},{"text":"pagomo rakasarudzwa naMwari kuti atongepo,","poem":2},{"lineBreak":true},{"text":"pachagarwa naJehovha pachake nokusingaperi?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngoro dzaMwari dzinosvika makumi ezviuru","poem":1},{"text":"nezviuru zvezviuru;","poem":2},{"lineBreak":true},{"text":"Ishe akasvika panzvimbo yake tsvene achibva kuSinai.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pamakakwira kumusoro,","poem":1},{"text":"makatungamirira vatapwa mumudungwe wenyu;","poem":2},{"lineBreak":true},{"text":"mukagamuchira zvipo zvaibva kuvanhu,","poem":2},{"text":"kunyange zvaibva kuna vakapanduka,","poem":1},{"text":"kuti imi, iyemi Jehovha Mwari, mugarepo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ishe ngaarumbidzwe, Mwari Muponesi wedu,","poem":1},{"text":"anotakura mitoro yedu zuva nezuva. Sera","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mwari wedu ndiMwari anoponesa;","poem":1},{"text":"kupunyuka parufu kunobva kuna Ishe Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Zvirokwazvo Mwari achapwanya misoro yavavengi vake,","poem":1},{"text":"panhongonya dzine vhudzi dzaavo vanorambira muzvivi zvavo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ishe anoti, “Ndichavabvisa kubva kuBhashani;","poem":1},{"text":"ndichavabudisa kubva kwakadzika kwegungwa,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"kuti unyike tsoka dzako muropa ravavengi vako,","poem":1},{"text":"ndimi dzembwa dzako dzichiwanawo mugove wadzo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Mudungwe wenyu wakaonekwa, imi Mwari,","poem":1},{"text":"mudungwe waMwari wangu naMambo achipinda munzvimbo tsvene.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mberi kuna vaimbi, vachiteverwa navaridzi vemitengeranwa;","poem":1},{"text":"pamwe chete navarandakadzi vachiridza matambureni.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Rumbidzai Mwari paungano huru;","poem":1},{"text":"rumbidzai Mwari pagungano raIsraeri.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tarirai, rudzi ruduku rwaBhenjamini runovatungamirira,","poem":1},{"text":"hawo machinda mazhinji aJudha,","poem":2},{"lineBreak":true},{"text":"uye hawo machinda aZebhuruni neaNafutari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Danai simba renyu, imi Mwari;","poem":1},{"text":"tiratidzei simba renyu, imi Mwari, sezvamakaita kare.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nokuda kwetemberi yenyu paJerusarema,","poem":1},{"text":"madzimambo achakuvigirai zvipo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tukai mhuka dziri pakati petsanga,","poem":1},{"text":"mapoka ehando ari pakati pemhuru dzendudzi.","poem":2},{"text":"Ngavauye nesirivha, vakazvininipisa.","poem":1},{"text":"Paradzirai ndudzi dzinofarira kurwa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nhume dzichabva kuIjipiti;","poem":1},{"text":"Etiopia ichazviisa pasi paMwari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Imbirai Mwari, imi ushe hwepasi,","poem":1},{"text":"rumbidzai Ishe nenziyo, Sera","poem":2}]},{"type":"verse","number":33,"content":[{"text":"kuna iye anotasva matenga akare kumusoro,","poem":1},{"text":"iye anobudisa inzwi rake, inzwi rine simba.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Paridzai simba raMwari,","poem":1},{"text":"iye ano ushe huri pamusoro peIsraeri,","poem":2},{"lineBreak":true},{"text":"ane simba riri kudenga denga.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Munotyisa imi Mwari, muri panzvimbo yenyu tsvene;","poem":1},{"text":"Mwari waIsraeri anopa ushe nesimba kuvanhu vake.","poem":2},{"lineBreak":true},{"text":"Mwari ngaarumbidzwe!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}