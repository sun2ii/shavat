{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba namaimbirwo a“Maruva eMahapa.” Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndiponesei, imi Mwari,","poem":1},{"text":"nokuti mvura zhinji yakwira kusvikira pamutsipa wangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndinonyura munhope yakadzika,","poem":1},{"lineBreak":true},{"text":"pasina pangatsika makumbo angu.","poem":1},{"lineBreak":true},{"text":"Ndapinda mumvura yakadzika;","poem":1},{"text":"ndafukidzwa namafashamu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndaneta nokuridza mhere yokuti ndibatsirwe;","poem":1},{"text":"huro dzangu dzaoma,","poem":2},{"text":"meso angu aneta","poem":1},{"text":"nokumirira Mwari wangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vanondivenga ndisina mhosva vakawanda","poem":1},{"text":"kupfuura bvudzi romusoro wangu;","poem":2},{"text":"vanondivenga ndisina mhosva vazhinji, avo vanotsvaka kundiparadza. Ndinomanikidzwa kudzosera zvandisina kuba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Munoziva upenzi hwangu, imi Mwari;","poem":1},{"text":"mhaka yangu haina kuvanzika kwamuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vaya vane tariro mamuri","poem":1},{"text":"ngavarege kunyadziswa nokuda kwangu,","poem":2},{"lineBreak":true},{"text":"haiwa Ishe, Jehovha Wamasimba Ose;","poem":2},{"text":"vanokutsvakai","poem":1},{"text":"ngavarege kunyadziswa nokuda kwangu,","poem":2},{"lineBreak":true},{"text":"haiwa Mwari waIsraeri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nokuti ndinotsunga kusekwa hangu nokuda kwenyu,","poem":1},{"text":"uye nyadzi dzafukidza chiso changu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndiri mutorwa kuhama dzangu,","poem":1},{"text":"nomweni kuvanakomana vamai vangu;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"nokuti kushingairira imba yenyu kwandipedza,","poem":1},{"text":"uye kutuka kwaavo vanokutukai kunowira pamusoro pangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pandinochema uye ndichitsanya,","poem":1},{"text":"ndinofanira kushinga pakusekwa;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"pandinofuka nguo dzamasaga,","poem":1},{"text":"vanhu vanondiita shumo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vaya vanogara pasuo vanondiseka,","poem":1},{"text":"uye ndiri rwiyo rwezvidhakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Asi ndinonyengetera kwamuri, imi Mwari,","poem":1},{"text":"panguva inokufadzai;","poem":2},{"text":"murudo rwenyu rukuru, imi Mwari,","poem":1},{"text":"ndipindurei noruponeso rwenyu rwechokwadi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndinunurei mumatope,","poem":1},{"text":"musandirega ndichinyura;","poem":2},{"text":"ndirwirei kuna vanondivenga,","poem":1},{"text":"napamvura zhinji yakadzika.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Musatendera mvura yamafashamu kuti indifukidze,","poem":1},{"text":"kana kwakadzika kuti kundimedze","poem":2},{"lineBreak":true},{"text":"kana kuti gomba rizarure muromo waro pamusoro pangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ndipindurei, imi Jehovha, zvichibva pakunaka kworudo rwenyu;","poem":1},{"text":"dzokerai henyu kwandiri nokuda kwetsitsi dzenyu huru.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Regai kuvanzira muranda wenyu chiso chenyu;","poem":1},{"text":"ndipindurei nokukurumidza, nokuti ndava mudambudziko.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Swederai pedyo mundinunure;","poem":1},{"text":"ndidzikinurei nokuda kwavavengi vangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Munoziva kusekwa kwangu, kunyadziswa nokusakudzwa kwangu;","poem":1},{"text":"vavengi vangu vose vari pamberi penyu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kusekwa kwaputsa mwoyo wangu,","poem":1},{"text":"uye kwandisiya ndisisina chingandibatsira;","poem":2},{"text":"Ndakatsvaka vangandinzwira ngoni, asi ndakavashaya,","poem":1},{"text":"vangandinyaradza, asi ndakavashayazve.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vakaisa nduru mune zvokudya zvangu,","poem":1},{"text":"uye vakandipa vhiniga pandaiva nenyota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Tafura yagadzirwa pamberi pavo ngaive musungo;","poem":1},{"text":"ngaive shamhu yokuranga neriva.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Meso avo ngaapofumadzwe kuti varege kuona,","poem":1},{"text":"uye misana yavo iminame nokusingaperi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dururirai hasha dzenyu pamusoro pavo;","poem":1},{"text":"kutsamwa kwenyu kunotyisa ngakuvakurire.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nzvimbo yavo ngaisiyiwe;","poem":1},{"text":"ngaparege kuva nomunhu anogara mumatende avo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nokuti vanotambudza vaya vamakarova,","poem":1},{"text":"uye vanotaura pamusoro pokurwadziwa kwavakakuvadzwa nemi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Vapei mhosva pamusoro pemhosva;","poem":1},{"text":"ngavarege kuva nomugove woruponeso rwenyu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ngavadzimwe mubhuku roupenyu,","poem":1},{"text":"uye varege kuverengwa pamwe chete navakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ndiri pakurwadziwa nenhamo;","poem":1},{"text":"ruponeso rwenyu imi Mwari, ngarundidzivirire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ndicharumbidza zita raMwari norwiyo,","poem":1},{"text":"uye ndichamukudza nokuvonga.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Izvi zvichafadza Jehovha kukunda nzombe,","poem":1},{"text":"kupfuura hando nenyanga dzayo, namahwanda ayo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Varombo vachazviona uye vachafara,","poem":1},{"text":"imi vanotsvaka Mwari, mwoyo yenyu ngairarame!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Jehovha anonzwa vanoshayiwa","poem":1},{"text":"uye haashori vanhu vake vakatapwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Denga nenyika ngazvimurumbidze,","poem":1},{"text":"makungwa nezvose zvinofamba, imomo,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"nokuti Mwari achaponesa Zioni","poem":1},{"text":"agovakazve maguta aJudha.","poem":2},{"text":"Ipapo vanhu vachagarako, vagoritora;","poem":1}]},{"type":"verse","number":36,"content":[{"text":"Vana vavaranda vake vacharipiwa senhaka,","poem":2},{"lineBreak":true},{"text":"uye avo vanoda zita rake vachagara ikoko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}