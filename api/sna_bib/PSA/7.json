{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["Rwiyo rwaDhavhidhi, rwaakaimbira Jehovha pamusoro paKushi, muBhenjamini."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, Mwari wangu, ndinovanda mamuri;","poem":1},{"text":"ndiponesei uye mundirwire pane vose vanondidzinganisa,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kuti varege kundibvambura seshumba","poem":1},{"text":"nokundibvambura-bvambura pasina anondinunura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Haiwa Jehovha, Mwari wangu,","poem":1},{"text":"kana ndichinge ndakaita izvi uye ndine mhosva pamaoko angu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kana ndakaita zvakaipa kuno uya akanga ane rugare neni","poem":1},{"text":"kana kupamba muvengi wangu pasina mhaka,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ipapo muvengi wangu ngaandidzinganise andibate;","poem":1},{"text":"ngaatsike-tsike upenyu hwangu muvhu","poem":2},{"lineBreak":true},{"text":"uye andivatise muguruva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Simukai, imi Jehovha pakutsamwa kwenyu;","poem":1},{"text":"simukai murwise hasha dzavavengi vangu.","poem":2},{"lineBreak":true},{"text":"Simukai, Mwari wangu; rayirai kururamisira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Marudzi akaungana ngaaungane akakupoteredzai.","poem":1},{"text":"Vatongei imi muri kumusoro;","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jehovha ngaatonge marudzi.","poem":2},{"text":"Nditongei, imi Jehovha, zvakafanira kururama kwangu,","poem":1},{"text":"zvakafanira kukwaniswa kwangu, imi Wokumusoro-soro.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haiwa, Mwari akarurama,","poem":1},{"text":"iyemi munonzvera ndangariro nomwoyo,","poem":2},{"text":"gumisai kuita nesimba kwavakaipa","poem":1},{"text":"mugoita kuti vakarurama vagare zvakanaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nhoo yangu ndimi Mwari Wokumusoro-soro,","poem":1},{"text":"iye anoponesa vane mwoyo yakarurama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwari ndiye mutongi akarurama,","poem":1},{"text":"iye Mwari anoratidza hasha dzake zuva nezuva.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kana munhu asingatendeuki,","poem":1},{"text":"iye acharodza munondo wake;","poem":2},{"lineBreak":true},{"text":"achakunga uta hwake agogadzirira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Agadzirira zvombo zvake zvinouraya;","poem":1},{"text":"anozvigadzirira miseve yake inopisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Iye ane mimba yezvakaipa","poem":1},{"text":"akatakura mimba yokutambudzika achabereka nhema.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uyo anochera gomba,","poem":1},{"text":"akaridzikisa achawira mugomba raachera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zvakashata zvake zvichadzokera pamusoro wake;","poem":1},{"text":"uye kumanikidza kwake kuchauya pamusoro wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ndichatenda Jehovha nokuda kwokururama kwake,","poem":1},{"text":"uye ndichaimbira zita raJehovha Wokumusoro-soro nziyo dzokurumbidza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}