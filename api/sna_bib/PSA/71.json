{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"Ndinovanda mamuri, imi Jehovha;","poem":1},{"text":"ngandirege kutongonyadziswa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndinunurei uye mundirwire mukururama kwenyu;","poem":1},{"text":"rerekerai nzeve yenyu kwandiri uye mundiponese.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ivai bako rangu rokuvanda kwandingaramba ndichienda;","poem":1},{"text":"rayirai kuti ndiponeswe, nokuti ndimi dombo rangu nenhare yangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Haiwa Mwari wangu, ndirwirei, paruoko rwowakaipa,","poem":1},{"text":"pakubatwa navanhu vakaipa uye vane utsinye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nokuti muri tariro yangu, imi Ishe Jehovha,","poem":1},{"text":"ndakavimba nemi kubva pauduku hwangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndakazendamira pamuri kubva pakuberekwa kwangu;","poem":1},{"text":"ndimi makandibudisa mudumbu ramai vangu.","poem":2},{"lineBreak":true},{"text":"Ndicharamba ndichikurumbidzai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndava sechishamiso kuvazhinji,","poem":1},{"text":"asi imi muri utiziro hwangu hwakasimba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Muromo wangu uzere nerumbidzo yenyu,","poem":1},{"text":"ndinoparidza kubwinya kwenyu zuva rose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Regai kundirasa pandinenge ndakwegura;","poem":1},{"text":"musandisiya kana simba rangu rapera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nokuti vavengi vangu vanotaura zvakaipa pamusoro pangu;","poem":1},{"text":"avo vakamirira kundiuraya vanorangana pamwe chete.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vanoti, “Mwari amusiya;","poem":1},{"text":"muteverei mumubate,","poem":2},{"lineBreak":true},{"text":"nokuti hakuna achamununura.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Regai kuva kure neni, imi Mwari;","poem":1},{"text":"uyai nokukurumidza, imi Mwari wangu, mundibatsire.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vapomeri vangu ngavaparare vanyadziswe;","poem":1},{"text":"vaya vanoda kundikuvadza","poem":2},{"lineBreak":true},{"text":"ngavafukidzwe nokusekwa nokunyadziswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Asi kana ndirini, ndichagara ndine tariro;","poem":1},{"text":"ndicharamba ndichikurumbidzai zvakanyanya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Muromo wangu uchareva zvokururama kwenyu,","poem":1},{"text":"nezvoruponeso rwenyu zuva rose,","poem":2},{"lineBreak":true},{"text":"kunyange ndisingazivi chiyero charwo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndichauya ndichiparidza mabasa enyu makuru, imi Ishe Jehovha;","poem":1},{"text":"ndichaparidza kururama kwenyu, iyemi moga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kubva pauduku hwangu, imi Mwari, makandidzidzisa,","poem":1},{"text":"nanhasi uno ndinoparidza mabasa enyu anoshamisa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kunyange pandinenge ndakwegura uye bvudzi rachena,","poem":1},{"text":"musandisiya, imi Mwari,","poem":2},{"text":"kusvikira ndaparidza simba renyu kurudzi runotevera,","poem":1},{"text":"nesimba renyu kuna vose vari kuzouya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kururama kwenyu kunosvika kudenga kumusoro, imi Mwari,","poem":1},{"text":"iyemi makaita zvinhu zvikuru.","poem":2},{"lineBreak":true},{"text":"Haiwa Mwari, ndiani akafanana nemi?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kunyange imi makandiratidza matambudziko mazhinji uye anorwadza,","poem":1},{"text":"muchadzosa upenyu hwangu zvakare;","poem":2},{"text":"kubva kwakadzika kwepasi","poem":1},{"text":"muchandibudisazve.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Muchawedzera kukudzwa kwangu,","poem":1},{"text":"uye muchandinyaradzazve.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ndichakurumbidzai nembira","poem":1},{"text":"nokuda kwokutendeka kwenyu, imi Mwari wangu;","poem":2},{"text":"ndichakurumbidzai nenziyo nomutengeranwa,","poem":1},{"text":"imi Mutsvene woga waIsraeri.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Miromo yangu ichadanidzira nomufaro","poem":1},{"text":"pandinokurumbidzai nenziyo,","poem":2},{"lineBreak":true},{"text":"iyeni, wamakadzikinura.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Rurimi rwangu ruchataura nezvamabasa enyu akarurama","poem":1},{"text":"zuva rose,","poem":2},{"text":"nokuti avo vaida kundikuvadza","poem":1},{"text":"vanyadziswa uye vakanganiswa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}