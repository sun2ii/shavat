{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"hebrew_subtitle","content":["Pisarema raSoromoni."]},{"type":"verse","number":1,"content":[{"text":"Shongedzai Mambo nokururamisira kwenyu, imi Mwari,","poem":1},{"text":"mwanakomana wamambo nokururama kwenyu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Achatonga vanhu venyu nokururama,","poem":1},{"text":"navanonetswa venyu nokururamisira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Makomo achavigira vanhu kubudirira,","poem":1},{"text":"nezvikomo, chibereko chokururama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Achadzivirira vanonetswa pakati pavanhu,","poem":1},{"text":"uye achaponesa vana vavanoshayiwa;","poem":2},{"lineBreak":true},{"text":"achapwanya mudzvinyiriri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Achashinga sokuvapo kwezuva, sokuvapo kwomwedzi,","poem":1},{"text":"kusvikira kumarudzi ose anotevera,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"achafanana nemvura inonaya pamunda une uswa hwakachekererwa,","poem":1},{"text":"seguti rinonyorovesa nyika.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pamazuva ake vakarurama vachakura zvakanaka;","poem":1},{"text":"kubudirira kuchawanda kusvikira mwedzi waguma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Achatonga kubva kugungwa kusvikira kugungwa,","poem":1},{"text":"uye kubva paRwizi kusvikira kumagumo enyika.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Marudzi omugwenga achapfugama pamberi pake,","poem":1},{"text":"uye vavengi vake vachananzva guruva.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Madzimambo eTashishi navari kumahombekombe ari kure","poem":1},{"text":"vachamuvigira mutero;","poem":2},{"text":"madzimambo eShebha neSebha","poem":1},{"text":"vachamupa zvipo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Madzimambo ose achamupfugamira","poem":1},{"text":"uye ndudzi dzose dzichamushandira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nokuti acharwira vanoshayiwa vanodanidzira;","poem":1},{"text":"vanonetswa vasina anovabatsira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Achanzwira ngoni vasina simba navanoshayiwa,","poem":1},{"text":"uye achaponesa vanoshayiwa kubva parufu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Achavanunura pakudzvinyirirwa nokuitirwa zvinhu nechisimba,","poem":1},{"text":"nokuti ropa ravo rinokosha pamberi pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Iye ngaararame upenyu hurefu!","poem":1},{"text":"Goridhe rinobva kuShebha ngaripiwe kwaari.","poem":2},{"text":"Vanhu ngavarambe vachimunyengeterera","poem":1},{"text":"uye vamuropafadze zuva rose.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zviyo ngazviwande munyika yose;","poem":1},{"text":"ngazvizengaire pamusoro pezvikomo.","poem":2},{"text":"Zvibereko zvazvo ngazvikure zvakanaka seRebhanoni;","poem":1},{"text":"ngazvibukire sebundo romusango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zita rake ngarigare nokusingaperi;","poem":1},{"text":"ngarirambe riripo sokuvapo kwezuva.","poem":2},{"lineBreak":true},{"text":"Ndudzi dzose dzicharopafadzwa kubudikidza naye,","poem":1},{"text":"uye vachamuti, ano mufaro.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Jehovha Mwari ngaarumbidzwe, Mwari waIsraeri,","poem":1},{"text":"iye oga anoita mabasa anoshamisa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zita rake rinobwinya ngarirumbidzwe nokusingaperi;","poem":1},{"text":"nyika yose ngaizadzwe nokubwinya kwake.","poem":2},"Ameni naAmeni."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ndipo panoperera minyengetero yaDhavhidhi, mwanakomana waJese.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}