{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"hebrew_subtitle","content":["Pisarema raAsafi."]},{"type":"verse","number":1,"content":[{"text":"Zvirokwazvo Mwari akanaka kuna Israeri,","poem":1},{"text":"kuna avo vakachena pamwoyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Asi kana ndirini, tsoka dzangu dzakapotsa dzatsvedza;","poem":1},{"text":"ndakasara paduku kupunzika.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nokuti ndakaitira shanje vanozvikudza,","poem":1},{"text":"pandakaona kubudirira kwavakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Havatambudziki;","poem":1},{"text":"miviri yavo ino utano uye vakasimba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vakasununguka pamitoro inowanikwa muvanhu;","poem":1},{"text":"havatambudzwi nezvinotambudza vanhu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naizvozvo kuzvikudza ndiko ruketani rwemitsipa yavo;","poem":1},{"text":"vanozvishongedza nechisimba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mumwoyo yavo makasindimara munobuda chitadzo;","poem":1},{"text":"mifungo yakaipa yendangariro dzavo haina magumo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vanoseka, uye vanotaura noutsinye mukuzvikudza kwavo,","poem":1},{"text":"vanoti vachadzvinyirira vamwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Miromo yavo inoti denga nderavo,","poem":1},{"text":"uye ndimi dzavo dzinotora nyika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naizvozvo vanhu vavo vanodzokera kwavari,","poem":1},{"text":"uye vanonwa mvura yakawanda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vanoti, “Mwari angazviziva sei?","poem":1},{"text":"Ko, Wokumusoro-soro ane ruzivo here?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndizvo zvakaita vakaipa,","poem":1},{"text":"havana hanya nguva dzose, vanowedzera pfuma yavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Zvirokwazvo ndakanatsa mwoyo wangu, asi pasina;","poem":1},{"text":"ndakashamba maoko angu ndisina mhosva, asi pasina.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Zuva rose ndanga ndichitambudzwa;","poem":1},{"text":"ndinorangwa mangwanani ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dai ndakanga ndati, “Ndichataura zvakadai,”","poem":1},{"text":"ndingadai ndakapandukira vana venyu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pandakaedza kunzwisisa izvi zvose,","poem":1},{"text":"zvakandiremera kwazvo","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kusvikira ndapinda munzvimbo tsvene yaMwari;","poem":1},{"text":"ipapo ndikazonzwisisa magumo avo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Zvirokwazvo makavaisa munzira inotsvedza;","poem":1},{"text":"makavakanda pasi kuti vaparare.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Haiwa, vanoparadzwa kamwe kamwe,","poem":1},{"text":"vanopedzwa chose nezvinotyisa!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sezvakaita kurota panopepuka munhu,","poem":1},{"text":"saizvozvo pamunomuka, imi Ishe,","poem":2},{"lineBreak":true},{"text":"muchavashora savanhu vanorotomoka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mwoyo wangu pawakachema","poem":1},{"text":"uye mweya wangu ukashungurudzika,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ndakanga ndava benzi uye ndisingazivi;","poem":1},{"text":"ndakanga ndava mhuka inotyisa pamberi penyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kunyange zvakadaro ndinogara nemi nguva dzose;","poem":1},{"text":"munondibata noruoko rwenyu rworudyi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Munondisesedza nezano renyu,","poem":1},{"text":"uye pashure muchazonditora mondipinza mukubwinya kwenyu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndianiko wandinaye kudenga kana musirimi?","poem":1},{"text":"Uye nyika haina chandinoshuva kunze kwenyu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nyama yangu nomwoyo wangu zvingapera hazvo,","poem":1},{"text":"asi Mwari isimba romwoyo wangu","poem":2},{"lineBreak":true},{"text":"nomugove wangu nokusingaperi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Avo vari kure nemi vachaparara;","poem":1},{"text":"munoparadza vose vasina kutendeka kwamuri.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Asi kana ndirini, zvakanaka kuva pedyo naMwari.","poem":1},{"text":"Ndakaita Ishe Jehovha utiziro hwangu;","poem":2},{"lineBreak":true},{"text":"ndichataura zvamabasa enyu ose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}