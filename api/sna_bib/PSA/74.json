{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":74,"content":[{"type":"hebrew_subtitle","content":["Masikiri raAsafi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Mwari, makatirambireiko nokusingaperi?","poem":1},{"text":"Kutsamwa kwenyu kwapfungairireiko pamusoro pamakwai anofudzwa nemi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rangarirai vanhu vamakatenga kare,","poem":1},{"text":"rudzi rwenhaka yenyu, ivo vamakadzikinura,","poem":2},{"lineBreak":true},{"text":"Gomo reZioni, pamaigara.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dzorai nhambwe dzenyu mutarise matongo asingaperi,","poem":1},{"text":"kuparadza ikoku kwose kwakauya nomuvengi pamusoro penzvimbo yenyu tsvene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vavengi venyu vakaomba panzvimbo yamakasangana nesu;","poem":1},{"text":"vakamisa mireza yavo sechiratidzo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vakaita savanhu vanosimudza matemo","poem":1},{"text":"kuti vateme dondo remiti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vakaputsa zvose zvakavezwa","poem":1},{"text":"namatemo avo nembezo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vakapisira pasi nzvimbo yenyu tsvene;","poem":1},{"text":"vakamhura ugaro hweZita renyu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vakati mumwoyo yavo, “Tichavaputsa zvachose!”","poem":1},{"text":"Vakapisa nzvimbo dzose dzokunamatira Mwari munyika.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hatichaoni zviratidzo zvinoshamisa;","poem":1},{"text":"hakuna muprofita akasara,","poem":2},{"lineBreak":true},{"text":"pakati pedu hapana munhu anoziva kuti zvicharamba zvakadaro kusvikira rini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Haiwa Mwari, muvengi acharamba achikushorai kusvikira riniko?","poem":1},{"text":"Ko, muvengi acharamba achimhura zita renyu nokusingaperi here?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Munodzoserereiko ruoko rwenyu shure, irwo ruoko rwenyu rworudyi?","poem":1},{"text":"Rubvisei pamupendero wenguo yenyu muvaparadze!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Asi imi, iyemi Mwari, ndimi mambo wangu kubva nakare;","poem":1},{"text":"imi munouyisa ruponeso panyika.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndimi makaganhura gungwa napakati nesimba renyu;","poem":1},{"text":"makaputsa misoro yechikara chomumvura.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndimi makapwanya misoro yaRevhiatani,","poem":1},{"text":"mukamuita chokudya chezvisikwa zvomugwenga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndimi makazarura zvitubu nehova;","poem":1},{"text":"mukapwisa nzizi dzaigara dzichierera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zuva nderenyu, uye usiku ndohwenyuwo;","poem":1},{"text":"makasimbisa zuva nomwedzi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndimi makatara miganhu yose yenyika;","poem":1},{"text":"mukaita zvose zhizha nechando.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Rangarirai kuti muvengi akakushorai sei, imi Jehovha,","poem":1},{"text":"uye kuti mapenzi akamhura sei zita renyu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Regai kuisa upenyu hwenjiva yenyu kumhuka dzesango;","poem":1},{"text":"regai kukanganwa nokusingaperi upenyu hwavanhu venyu vanonetswa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ivai nehanya nesungano yenyu,","poem":1},{"text":"nokuti mweya wokurwisana wazadza nzvimbo dzerima munyika.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Musarega vakadzvinyirirwa vachidududza shure nenyadzi;","poem":1},{"text":"varombo navanoshayiwa ngavarumbidze zita renyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Simukai, imi Mwari, mutsigire mhaka yenyu;","poem":1},{"text":"rangarirai kuti mapenzi anokushorai sei zuva rose.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Regai kushayira hanya ruzha rwavadzivisi venyu,","poem":1},{"text":"bope ravavengi venyu, rinoramba richikwira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}