{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba namaimbiro okuti, “Regai kuparadza.” Pisarema raAsafi. Rwiyo."]},{"type":"verse","number":1,"content":[{"text":"Tinokuvongai, imi Mwari, tinokuvongai,","poem":1},{"text":"nokuti Zita renyu riri pedyo;","poem":2},{"lineBreak":true},{"text":"vanhu vanotaura nezvamabasa enyu anoshamisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Imi munoti, “Ndinosarudza nguva yakatarwa;","poem":1},{"text":"ndini ndinotonga zvakarurama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Panozununguka nyika yose navanhu vayo,","poem":1},{"text":"ini ndini ndinobata mbiru dzayo zvakasimba. Sera","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuna vanozvikudza ndinoti, ‘Regai kuzvikudzazve,’","poem":1},{"text":"uye kuna vakaipa, ndinoti, ‘Regai kusimudza nyanga dzenyu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Regai kusimudzira nyanga dzenyu kudenga;","poem":1},{"text":"regai kutaura nemitsipa mikukutu.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hakuna munhu anobva kumabvazuva kana kumavirira,","poem":1},{"text":"kana anobva kugwenga angasimudzira munhu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asi Mwari ndiye anotonga:","poem":1},{"text":"Anoderedza mumwe, achisimudzira mumwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Muruoko rwaJehovha mune mukombe","poem":1},{"text":"uzere newaini inopupuma, yakavhenganiswa nezvinonhuhwira;","poem":2},{"text":"anoidururira pasi, uye vakaipa vose vapanyika","poem":1},{"text":"vanoinwa kusvikira pamasese ayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kana ndirini, ndichaparidza izvi nokusingaperi;","poem":1},{"text":"ndichaimbira Mwari waJakobho rwiyo rwokurumbidza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndichagura nyanga dzavakaipa vose,","poem":1},{"text":"asi nyanga dzavakarurama dzichasimudzirwa kumusoro.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}