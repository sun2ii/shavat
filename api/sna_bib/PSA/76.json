{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba nomutengeranwa une hungiso. Pisarema raAsafi. Rwiyo."]},{"type":"verse","number":1,"content":[{"text":"Mwari anozivikanwa muJudha;","poem":1},{"text":"zita rake iguru muIsraeri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tende rake riri muSaremu,","poem":1},{"text":"ugaro hwake paZioni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndipo paakavhuna miseve inovaima,","poem":1},{"text":"nhoo neminondo, izvo zvombo zvokurwa. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Imi makashongedzwa nechiedza,","poem":1},{"text":"kupfuura makomo akapfuma nemhuka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Varume vakashinga vakavata pasi vapambwa,","poem":1},{"text":"vakavata hope dzavo dzokupedzisira;","poem":2},{"text":"hakuna mumwe wavarwi","poem":1},{"text":"angasimudza maoko ake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pakutuka kwenyu, imi Mwari waJakobho,","poem":1},{"text":"zvose bhiza nengoro zvinovata zvakati mwiro.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Imi moga ndimi munofanira kutyiwa.","poem":1},{"text":"Mukatsamwa, ndianiko angamira pamberi penyu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Muri kudenga makazivisa kutonga kwenyu,","poem":1},{"text":"uye nyika yakatya ikanyarara,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"haiwa Mwari, pamakasimuka kuti mutonge,","poem":1},{"text":"kuti muponese vanonetswa vose venyika. Sera","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zvirokwazvo hasha dzenyu pamusoro pavanhu dzinokuvigirai kurumbidzwa,","poem":1},{"text":"uye vanosara pahasha dzenyu vachadziviswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Itai mhiko kuna Jehovha Mwari wenyu mugodzizadzisa;","poem":1},{"text":"nyika dzose dzakakupoteredzai","poem":2},{"lineBreak":true},{"text":"ngadzivigire zvipo kuna Iye anofanira kutyiwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anoputsa mweya yavatongi;","poem":1},{"text":"anotyiwa namadzimambo enyika.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}