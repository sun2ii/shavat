{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Kuna Jedhutuni. Pisarema raAsafi."]},{"type":"verse","number":1,"content":[{"text":"Ndakadanidzira kuna Mwari kuti andibatsire;","poem":1},{"text":"ndakadana kuna Mwari kuti andinzwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pandakanga ndiri pakutambudzika, ndakatsvaka Ishe;","poem":1},{"text":"panguva yousiku ndakatambanudza maoko angu asinganeti,","poem":2},{"lineBreak":true},{"text":"uye mweya wangu wakaramba kunyaradzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Haiwa Mwari, ndakakurangarirai, uye ndikagomera;","poem":1},{"text":"ndakafungisisa, mweya wangu ukaziya. Sera","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Makakonesa meso angu kutsinzina;","poem":1},{"text":"ndakatambudzika zvokuti ndakatadza kutaura.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndakarangarira mazuva ekare,","poem":1},{"text":"makore ekare kare;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ndakarangarira nziyo dzangu panguva yousiku.","poem":1},{"text":"Mwoyo wangu wakafungisisa uye mweya wangu wakabvunza ukati,","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ko, Ishe acharamba nokusingaperi here?","poem":1},{"text":"Haachazombonzwiri ngonizve here?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ko, rudo rwake rusingaperi rwakabva nokusingaperi here?","poem":1},{"text":"Chipikirwa chake chakakona nokusingaperi here? Sera","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ko, Mwari akanganwa kuva nenyasha here?","poem":1},{"text":"Mukutsamwa kwake haachaitira tsiye dzake nyoro here?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ipapo ndakafunga ndikati, “Ndichakumbira hangu pane izvozvi:","poem":1},{"text":"makore oruoko rworudyi reWokumusoro-soro.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndicharangarira mabasa aJehovha;","poem":1},{"text":"hongu, ndicharangarira zvishamiso zvenyu zvakare kare.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndichafungisisa pamusoro pamabasa enyu ose,","poem":1},{"text":"uye ndicharangarira mabasa enyu makuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Haiwa Mwari, nzira dzenyu itsvene.","poem":1},{"text":"Ndoupiko mwari mukuru saMwari wedu?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Muri Mwari anoita zvishamiso;","poem":1},{"text":"munoratidza simba renyu pakati pavanhu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Noruoko rwenyu rune simba,","poem":1},{"text":"makadzikinura vanhu venyu, izvo zvizvarwa zvaJakobho naJosefa. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mvura zhinji yakakuonai, imi Mwari,","poem":1},{"text":"mvura zhinji yakakuonai ikatya;","poem":2},{"lineBreak":true},{"text":"kwakadzika chaiko kwakabvunda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Makore akadurura mvura,","poem":1},{"text":"kumatenga kwakaunga nokutinhira;","poem":2},{"lineBreak":true},{"text":"miseve yenyu yakapenya kuno nokoko.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kutinhira kwenyu kwakanzwika muchamupupuri,","poem":1},{"text":"kupenya kwenyu kwakavhenekera nyika;","poem":2},{"lineBreak":true},{"text":"nyika yakadedera ikadengenyeka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gwara renyu rakapinda nomugungwa,","poem":1},{"text":"nzira yenyu ikapinda nomumvura zhinji zhinji,","poem":2},{"lineBreak":true},{"text":"kunyange zvazvo tsoka dzenyu dzakanga dzisingaonekwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Makatungamirira vanhu venyu seboka ramakwai","poem":1},{"text":"noruoko rwaMozisi naAroni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}