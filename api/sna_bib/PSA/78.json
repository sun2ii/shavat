{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":78,"content":[{"type":"hebrew_subtitle","content":["Masikiri raAsafi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa vanhu vangu, inzwai kudzidzisa kwangu;","poem":1},{"text":"teererai mashoko omuromo wangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichashamisa muromo wangu nditaure nomufananidzo,","poem":1},{"text":"ndichataura zvinhu zvakavanzika, zvinhu zvakare kare,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"zvatakanzwa nezvatakaziva,","poem":1},{"text":"zvatakaudzwa namadzibaba edu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hatingazozvivanziri vana vavo;","poem":1},{"text":"tichaudza rudzi runotevera","poem":2},{"text":"mabasa angarumbidzwa aJehovha,","poem":1},{"text":"simba rake, nezvishamiso zvaakaita.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akatema zvirevo zvaJakobho","poem":1},{"text":"akasimbisa murayiro muIsraeri,","poem":2},{"text":"waakarayira madzitateguru edu","poem":1},{"text":"kuti vadzidzise vana vavo,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kuti rudzi runotevera ruzvizive,","poem":1},{"text":"kunyange vana vachazoberekwa,","poem":2},{"lineBreak":true},{"text":"naivo vagozoudzawo vana vavo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ipapo vachavimba naMwari wavo","poem":1},{"text":"uye havangazokanganwi mabasa ake","poem":2},{"lineBreak":true},{"text":"asi vachazochengeta mirayiro yake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Havazofanani namadzitateguru avo,","poem":1},{"text":"rudzi rwakanga rwakasindimara uye rwaimumukira,","poem":2},{"text":"mwoyo yavo yakanga isingateereri Mwari,","poem":1},{"text":"mweya yavo yakanga isina kutendeka kwaari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Vanhu vokwaEfuremu, kunyange vakanga vakapakata uta,","poem":1},{"text":"vakadzokera shure pazuva rokurwa;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"havana kuchengeta sungano yaMwari,","poem":1},{"text":"uye vakaramba kufamba maererano nomurayiro wake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vakakanganwa zvaakaita,","poem":1},{"text":"zvishamiso zvaakavaratidza.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akaita zviratidzo pamberi pamadzibaba avo","poem":1},{"text":"munyika yeIjipiti, mudunhu reZoani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akapamura gungwa akavayambutsa napakati;","poem":1},{"text":"akaita kuti mvura imire yakasimba sorusvingo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akavatungamirira negore masikati,","poem":1},{"text":"uye nechiedza chomoto usiku hwose.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akapamura ruware mugwenga","poem":1},{"text":"akavapa mvura yakawanda seyamakungwa;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"akabudisa hova dzemvura paruware","poem":1},{"text":"akaita kuti iyerere seyenzizi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Asi vakaramba vachingomutadzira,","poem":1},{"text":"vachimukira Wokumusoro-soro mugwenga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vakaedza Mwari nobwoni","poem":1},{"text":"vachimugombedzera kuti avape zvokudya zvavaipanga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Vakapopotera Mwari, vachiti,","poem":1},{"text":"“Ko, Mwari angawadzira tafura mugwenga here?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Paakarova dombo, mvura yakatubuka,","poem":1},{"text":"uye hova dzakayerera mvura zhinji.","poem":2},{"text":"Asi angagona kutipawo zvokudya here?","poem":1},{"text":"Angavigira vanhu vake nyama here?”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jehovha akati avanzwa, akatsamwa zvikuru kwazvo;","poem":1},{"text":"moto wake ukaveserwa Jakobho,","poem":2},{"lineBreak":true},{"text":"uye hasha dzake dzikamukira Israeri,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"nokuti havana kutenda muna Mwari","poem":1},{"text":"kana kuvimba nokurwira kwake.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Asi akarayira matenga kumusoro","poem":1},{"text":"akazarura makonhi okumatenga;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"akanayisa mana kuti vanhu vadye,","poem":1},{"text":"akavapa zviyo zvokudenga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Vanhu vakadya chingwa chavatumwa;","poem":1},{"text":"akavatumira zvokudya zvose zvavaigona kudya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Akazarura mhepo yokumabvazuva kubva kudenga,","poem":1},{"text":"uye akafambisa mhepo yakabva zasi nesimba rake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Akavanayisira nyama pamusoro pavo seguruva,","poem":1},{"text":"shiri dzinobhururuka dzakaita sejecha rokumhenderekedzo yegungwa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Akaita kuti dziburukire mumisasa yavo,","poem":1},{"text":"dzakapoteredza matende avo ose.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Vakadya kusvikira vaguta kwazvo,","poem":1},{"text":"nokuti akanga avapa zvavakanga vachipanga.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Asi vasati vafuratira chokudya chavaikarira,","poem":1},{"text":"kunyange pachakanga chichiri pamiromo yavo,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"kutsamwa kwaMwari kwakavamukira;","poem":1},{"text":"akauraya vakanga vakanyanya kusimba pakati pavo,","poem":2},{"lineBreak":true},{"text":"akaparadza majaya eIsraeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Kunyange zvakadaro, vakaramba vachingotadza;","poem":1},{"text":"kunyange zvazvo zviratidzo zvake izvi zvaivapo, havana kutenda.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Saka akagumisa mazuva avo nezvisina maturo,","poem":1},{"text":"uye makore avo mukutya.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Pose pavaiurayiwa naMwari, ndipo pavaimutsvaka;","poem":1},{"text":"vaishingairira kudzokerazve kwaari.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Vakarangarira kuti Mwari ndiye Dombo ravo,","poem":1},{"text":"kuti Mwari Wokumusoro-soro ndiye Mudzikinuri wavo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Asizve vaingomubata kumeso nemiromo yavo,","poem":1},{"text":"vachimurevera nhema nendimi dzavo;","poem":2}]},{"type":"verse","number":37,"content":[{"text":"mwoyo yavo yakanga isina kutendeka kwaari,","poem":1},{"text":"vakanga vasina kutendeka pasungano yake.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Kunyange zvakadaro","poem":1},{"text":"iye akavanzwira tsitsi;","poem":2},{"lineBreak":true},{"text":"akavakanganwira kuipa kwavo akasavaparadza.","poem":2},{"text":"Nguva nenguva akadzora kutsamwa kwake,","poem":1},{"text":"uye haana kumutsa hasha dzake dzose.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Akarangarira kuti ivo vaingova nyama bedzi,","poem":1},{"text":"mhepo inopfuura isingadzoki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Vakamumukira mugwenga kazhinji sei,","poem":1},{"text":"uye vakamuitisa shungu murenje!","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Vakaedza Mwari vamuedzazve;","poem":1},{"text":"vakagumbusa Iye Mutsvene waIsraeri.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Havana kurangarira simba rake,","poem":1},{"text":"zuva raakavadzikinura kubva pamudzvinyiriri,","poem":2}]},{"type":"verse","number":43,"content":[{"text":"zuva raakaratidza zviratidzo zvake zvinoshamisa muIjipiti,","poem":1},{"text":"zvishamiso zvake mudunhu reZoani.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Akashandura nzizi dzavo dzikava ropa;","poem":1},{"text":"havana kugona kunwa muhova dzavo.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Akavatumira mapupira enhunzi dzikavaparadza,","poem":1},{"text":"uye matatya akavaparadza zvikuru.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Akapa zviyo zvavo kumagutaguta","poem":1},{"text":"nezvibereko zvavo kumhashu.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Akaparadza mazambiringa avo nechimvuramabwe,","poem":1},{"lineBreak":true},{"text":"uye namaonde emionde yavo nechando.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Mombe dzavo akadziisa kuchimvuramabwe,","poem":1},{"text":"nezvipfuwo zvavo kukurova kwemheni.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Akaregedzera kutsamwa kwake kukuru pamusoro pavo,","poem":1},{"text":"hasha dzake, shungu dzake noukasha hwake,","poem":2},{"lineBreak":true},{"text":"boka ravatumwa vokuparadza.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Akagadzira nzira yokutsamwa kwake;","poem":1},{"text":"haana kuponesa mweya yavo parufu asi akavaisa kudenda.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Akauraya matangwe ose eIjipiti,","poem":1},{"text":"chibereko chokutanga chomurume pamatende aHamu.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Asi akabudisa vanhu vake seboka ramakwai;","poem":1},{"text":"akavatungamirira samakwai nomugwenga.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Akavafambisa norugare,","poem":1},{"text":"asi gungwa rakamedza vavengi vavo.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Saizvozvo akavasvitsa kumuganhu wenyika yake tsvene,","poem":1},{"text":"kunyika yamakomo yaakatora noruoko rwake rworudyi.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Akadzinga ndudzi mberi kwavo,","poem":1},{"text":"akagovera nyika yavo kwavari senhaka;","poem":2},{"lineBreak":true},{"text":"akagarisa rudzi rwaIsraeri mudzimba dzavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"Asi vakaedza Mwari","poem":1},{"text":"uye vakamukira Wokumusoro-soro;","poem":2},{"lineBreak":true},{"text":"vakasachengeta zvirevo zvake.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Vakanga vasingazvirereki uye vasina kutendeka samadzibaba avo,","poem":1},{"text":"vasingavimbiki souta hunonyengera.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Vakamutsamwisa nenzvimbo dzavo dzakakwirira;","poem":1},{"text":"vakamutsa godo rake nokuda kwezvifananidzo zvavo.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Mwari akati avanzwa akatsamwa zvikuru kwazvo;","poem":1},{"text":"akaramba Israeri zvachose.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Akasiya tabhenakeri yeShiro,","poem":1},{"text":"iyo tende yaakanga amisa pakati pavanhu.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Akaendesa areka yesimba rake kuutapwa,","poem":1},{"text":"kubwinya kwake mumaoko omuvengi.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Akaisa vanhu vake kumunondo;","poem":1},{"text":"akatsamwira nhaka yake zvikuru kwazvo.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Moto wakaparadza majaya avo,","poem":1},{"text":"uye varandakadzi vavo vakashayiwa nziyo dzesvitsa;","poem":2}]},{"type":"verse","number":64,"content":[{"text":"vaprista vavo vakanga vaiswa kumunondo,","poem":1},{"text":"uye chirikadzi dzavo hadzina kugona kuchema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Ipapo Ishe akamuka somunhu anga akakotsira,","poem":1},{"text":"somunhu amuka pakubatwa newaini.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Akarova vavengi vake vakadzokera shure;","poem":1},{"text":"akavanyadzisa nokusingaperi.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Ipapo akaramba matende aJosefa,","poem":1},{"text":"haana kusarudza rudzi rwaEfuremu;","poem":2}]},{"type":"verse","number":68,"content":[{"text":"asi akasarudza rudzi rwaJudha,","poem":1},{"text":"Gomo reZioni, raakada.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Akavaka nzvimbo yake tsvene senhare yakakwirira,","poem":1},{"text":"senyika yaakasimbisa nokusingaperi.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Akasarudza Dhavhidhi muranda wake,","poem":1},{"text":"akamutora kumatanga amakwai;","poem":2}]},{"type":"verse","number":71,"content":[{"text":"akamubvisa pakufudza makwai","poem":1},{"text":"kuti ave mufudzi wavanhu vake Jakobho,","poem":2},{"lineBreak":true},{"text":"vaIsraeri nhaka yake.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Uye Dhavhidhi akavafudza nokururama kwomwoyo;","poem":1},{"text":"akavatungamirira namaoko ouchenjeri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}