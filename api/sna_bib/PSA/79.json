{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["Pisarema raAsafi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Mwari, ndudzi dzapinda panhaka yenyu;","poem":1},{"text":"vakasvibisa temberi yenyu tsvene,","poem":2},{"lineBreak":true},{"text":"Jerusarema varideredza rikava marara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vakapa mitumbi yavaranda venyu","poem":1},{"text":"sezvokudya zveshiri dzedenga,","poem":2},{"lineBreak":true},{"text":"nyama yavatsvene venyu kuzvikara zvenyika.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vakateura ropa kunge mvura","poem":1},{"text":"paJerusarema rose,","poem":2},{"lineBreak":true},{"text":"uye hakuna munhu anoviga zvitunha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tiri chinhu chinoshorwa navatigere navo,","poem":1},{"text":"chinosekwa nechinozvidzwa kuna avo vakatipoteredza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Haiwa Jehovha, mucharamba makatitsamwira nokusingaperi kusvikira riniko?","poem":1},{"text":"Godo renyu richapisa somoto kusvikira riniko?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dururirai hasha dzenyu pamusoro pendudzi dzisingakuzive,","poem":1},{"text":"napaushe husingadani kuzita renyu;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nokuti vakapedza Jakobho","poem":1},{"text":"uye vakaparadza nyika yokwake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Regai kuverengera pamusoro pedu zvivi zvamadzibaba;","poem":1},{"text":"tsitsi dzenyu ngadzikurumidze kuuya kuzosangana nesu,","poem":2},{"lineBreak":true},{"text":"nokuti tiri pakutambudzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tibatsirei, imi Mwari Muponesi wedu,","poem":1},{"text":"nokuda kwokukudzwa kwezita renyu;","poem":2},{"text":"tirwirei mutiregerere zvivi zvedu","poem":1},{"text":"nokuda kwezita renyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndudzi dzichataurireiko dzichiti,","poem":1},{"text":"“Mwari wavo aripi?”","poem":2},{"text":"Zivisai pakati pendudzi, pamberi pedu,","poem":1},{"text":"kuti munotsiva ropa ravaranda venyu rakateurwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kugomera kwavasungwa ngakusvike pamberi penyu;","poem":1},{"text":"nesimba roruoko rwenyu","poem":2},{"lineBreak":true},{"text":"chengetedzai avo vakatongerwa rufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mutsive kanomwe pamabvi avavakidzani vedu,","poem":1},{"text":"kutuka kwavakaita zita renyu, imi Ishe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ipapo vanhu venyu, makwai amafuro enyu,","poem":1},{"text":"vachakurumbidzai nokusingaperi;","poem":2},{"text":"kubva kune chimwe chizvarwa kusvikira kune chimwe chizvarwa,","poem":1},{"text":"ticharondedzera nezvokurumbidzwa kwenyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}