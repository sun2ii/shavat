{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba nomuimbiro wa “Maruva amahapa eSungano.” Pisarema raAsafi."]},{"type":"verse","number":1,"content":[{"text":"Tinzwei, imi Mufudzi weIsraeri,","poem":1},{"text":"imi makatungamirira Josefa seboka ramakwai;","poem":2},{"text":"iyemi munogara pachigaro choushe pakati pamakerubhi, penyai","poem":1}]},{"type":"verse","number":2,"content":[{"text":"pamberi paEfuremu, Bhenjamini naManase.","poem":2},{"text":"Mutsai simba renyu;","poem":1},{"text":"uyai mutiponese.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tidzorei, imi Mwari,","poem":1},{"text":"penyesai chiso chenyu pamusoro pedu,","poem":2},{"lineBreak":true},{"text":"kuti tiponeswe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Haiwa Jehovha Mwari Wamasimba Ose,","poem":1},{"text":"kutsamwa kwenyu kucharamba kuchipisa","poem":2},{"lineBreak":true},{"text":"pamusoro peminyengetero yavanhu venyu kusvikira riniko?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Makavapa chingwa chemisodzi kuti vadye;","poem":1},{"text":"makaita kuti vanwe misodzi yakawanda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Makatiita mavambo enharo kuna vatigere navo,","poem":1},{"text":"uye vavengi vedu vanotiseka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tidzorei, imi Mwari Wamasimba Ose;","poem":1},{"text":"penyesai chiso chenyu pamusoro pedu,","poem":2},{"lineBreak":true},{"text":"kuti tiponeswe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Makabudisa muzambiringa kubva muIjipiti;","poem":1},{"text":"makadzinga ndudzi mukaudyara.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makaukurira nzvimbo,","poem":1},{"text":"uye ukava nemidzi ukazadza nyika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Makomo akanga akafukidzwa nomumvuri wawo,","poem":1},{"text":"nemisidhari mikuru namatavi awo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wakatandavadza matavi awo kusvikira kuGungwa,","poem":1},{"text":"namabukira awo kusvikira kuRwizi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Seiko makaputsa masvingo awo","poem":1},{"text":"kuti vose vanopfuura napo vanonge mazambiringa awo?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nguruve dzinobva musango dzinouparadza,","poem":1},{"text":"uye zvisikwa zvesango zvinoudya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dzokerai kwatiri, imi Mwari Wamasimba Ose!","poem":1},{"text":"Tarirai muri kudenga muone!","poem":2},{"text":"Rindai muzambiringa uyu,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"iwo mudzi wakasimwa noruoko rwenyu rworudyi,","poem":2},{"lineBreak":true},{"text":"mwanakomana wamakazvirerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Muzambiringa wenyu watemerwa pasi, wapiswa nomoto;","poem":1},{"text":"pakutuka kwenyu, vanhu venyu vanofa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ruoko rwenyu rworudyi ngarugare pamusoro pomunhu ari kurudyi kwenyu,","poem":1},{"text":"mwanakomana womunhu wamakazvirerera.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ipapo hatingazobvi kwamuri;","poem":1},{"text":"timutsiridzei, tigodana kuzita renyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tidzorei, imi Mwari Wamasimba Ose;","poem":1},{"text":"penyesai chiso chenyu pamusoro pedu,","poem":2},{"lineBreak":true},{"text":"kuti tiponeswe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}