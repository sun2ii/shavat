{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba. Namaimbirwo egititi. Pisarema raAsafi."]},{"type":"verse","number":1,"content":[{"text":"Imbirai Mwari nomufaro iye simba redu;","poem":1},{"text":"danidzirai kuna Mwari waJakobho!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vambai rwiyo, muridze tambureni,","poem":1},{"text":"ridzai mbira dzinonakidza nomutengeranwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ridzai runyanga rwehwai paKugara kwoMwedzi,","poem":1},{"text":"uye pakuchena kwomwedzi, pazuva roMutambo wedu;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ichi ndicho chirevo chaIsraeri,","poem":1},{"text":"chakatarwa naMwari waJakobho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akachisimbisa somutemo wakanyorwa waJosefa","poem":1},{"text":"panguva yaakandorwa neIjipiti,","poem":2},{"lineBreak":true},{"text":"uko kwatakanzwa mutauro watakanga tisinganzwisisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iye anoti, “Ndakabvisa mutoro pamapfudzi avo;","poem":1},{"text":"maoko avo akasunungurwa padengu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pakutambudzika kwako wakadana ini ndikakununura,","poem":1},{"text":"ndakakupindura ndiri mugore rokutinhira;","poem":2},{"lineBreak":true},{"text":"ndakakuedza pamvura zhinji yeMeribha. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Inzwai, imi vanhu vangu, uye ndichakuyambirai,","poem":1},{"text":"kana mukada chete kunditeerera, imi Israeri!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pakati penyu ngaparege kuva namwari wavatorwa,","poem":1},{"text":"musapfugamira mwari wokumwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndini Jehovha Mwari wako,","poem":1},{"text":"akakubudisa kubva munyika yeIjipiti.","poem":2},{"lineBreak":true},{"text":"Shamisa muromo wako kwazvo, ndigouzadza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Asi vanhu vangu havana kuda kundinzwa,","poem":1},{"text":"Israeri haana kuda kuzviisa pasi pangu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Saka ndakavaregera paukukutu hwemwoyo yavo,","poem":1},{"text":"kuti vatevere mano avo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Kana vanhu vangu vakada kunditeerera,","poem":1},{"text":"kana Israeri akada kutevera nzira dzangu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ndaikurumidza kukunda sei vavengi","poem":1},{"text":"vavo nokurova vavengi vavo noruoko rwangu!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vaya vanovenga Jehovha vachatya pamberi pake,","poem":1},{"text":"uye kurangwa kwavo kuchagara nokusingaperi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asi imi muchagutswa nezviyo zvakaisvonaka;","poem":1},{"text":"uye ndichakugutsai nouchi hunobva padombo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}