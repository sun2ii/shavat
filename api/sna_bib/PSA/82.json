]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ndakati, ‘Muri vamwari;","poem":1},{"text":"imi mose muri vanakomana veWokumusoro-soro.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asi muchafa savanhuwo zvavo;","poem":1},{"text":"muchawa savatongi vose.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Simukai, imi Mwari, mutonge nyika,","poem":1},{"text":"nokuti ndudzi dzose inhaka yenyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}