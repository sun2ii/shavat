{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["Rwiyo. Pisarema raAsafi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Mwari, regai kunyarara;","poem":1},{"text":"musanyarara, imi Mwari, musati mwiro.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tarirai kumutswa kwaitwa vavengi venyu,","poem":1},{"text":"namasimudziro avaita misoro yavo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vakarangana nounyengeri pamusoro pavanhu venyu;","poem":1},{"text":"vanorangana pamusoro paavo vamunochengeta zvakanaka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ivo vanoti, “Uyai, ngativaparadzei sorudzi,","poem":1},{"text":"kuti zita raIsraeri rirove.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vanorangana pamwe chete nomwoyo mumwe chete;","poem":1},{"text":"vanoita sungano yokuzorwa nemi,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"matende eEdhomu nevaIshumaeri,","poem":1},{"text":"neMoabhu navaHagari,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gebha, Amoni neAmareki,","poem":1},{"text":"Firistia, navanhu veTire.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kunyange neAsiria yabatana","poem":1},{"text":"navo kuti vasimbise zvizvarwa zvaRoti. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Muvaitire sezvamakaitira vaMidhia,","poem":1},{"text":"sezvamakaita kuna Sisera naJabhini paRwizi Kishoni,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ivo vakafira paEndori","poem":1},{"text":"uye vakava sendove pamusoro pevhu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Muite makurukota avo saOrebhu naZibhi,","poem":1},{"text":"machinda avo ose saZebha naZarumuna,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ivo vakati, “Handei tindotora","poem":1},{"text":"mafuro aMwari.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Haiwa Mwari wangu, vaitei sendira,","poem":1},{"text":"sehundi inodzingwa nemhepo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Somoto unopisa sango","poem":1},{"text":"kana moto unoririma mugomo,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"saka vateverei nedutu renyu","poem":1},{"text":"mugovavhundutsa nokutinhira wenyu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Fukidzai zviso zvavo nenyadzi","poem":1},{"text":"kuti vanhu vagotsvaka zita renyu, imi Jehovha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ngavarambe vachinyadziswa","poem":1},{"text":"uye vavhundutswe; ngavafire munyadzi dzavo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngavazive kuti imi, mune zita rinonzi Jehovha,","poem":1},{"text":"ndimi moga Wokumusoro-soro ari pamusoro penyika yose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}