{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba namaimbirwo egititi. Pisarema ravanakomana vaKora."]},{"type":"verse","number":1,"content":[{"text":"Ugaro hwenyu hwakanaka sei,","poem":1},{"text":"imi Jehovha Wamasimba Ose!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mweya wangu unopanga,","poem":1},{"text":"uye unotoziya, nokuda kwezvivanze zvaJehovha;","poem":2},{"text":"mwoyo wangu nenyama yangu","poem":1},{"text":"zvinodana kuna Mwari mupenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kunyange shiri diki yakazviwanira imba,","poem":1},{"text":"nenyenganyenga yakazviwanirawo","poem":2},{"lineBreak":true},{"text":"dendere kwaingachochonyera vana vayo,","poem":2},{"text":"iyo nzvimbo iri pedyo nearitari yenyu,","poem":1},{"text":"imi Jehovha Wamasimba Ose, Mambo wangu naMwari wangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vakaropafadzwa avo vanogara mumba menyu;","poem":1},{"text":"vanogara vachikurumbidzai. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vakaropafadzwa avo vane simba ravo mamuri,","poem":1},{"text":"vakaisa mwoyo yavo parwendo rweZioni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pavanopfuura nomuMupata weBhaka,","poem":1},{"text":"vanouita nzvimbo yamatsime;","poem":2},{"lineBreak":true},{"text":"mvura yomuzhizha inouzadzawo namadziva.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vanowedzera simba pasimba,","poem":1},{"text":"kusvikira mumwe nomumwe wavo amira pamberi paMwari muZioni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Inzwai munyengetero wangu, imi Jehovha Mwari Wamasimba Ose;","poem":1},{"text":"rerekerai nzeve yenyu kwandiri, imi Mwari waJakobho. Sera","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haiwa Mwari, tariraiwo nhoo yedu;","poem":1},{"text":"ringirai nenyasha dzenyu pamuzodziwa wenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Zviri nani kuva pavazhe dzenyu kwezuva rimwe chete,","poem":1},{"text":"kupfuura mazuva zviuru ndiri kumwe;","poem":2},{"text":"ndingada zvangu kuva murindi womukova weimba yaMwari","poem":1},{"text":"wangu kukunda kugara mumatende avakaipa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokuti Jehovha Mwari ndiye zuva nenhoo;","poem":1},{"text":"Jehovha anopa nyasha nokukudzwa;","poem":2},{"text":"hapana chinhu chakanaka chaanganyima","poem":1},{"text":"avo vanofamba zvakarurama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Haiwa Jehovha Wamasimba Ose,","poem":1},{"text":"akaropafadzwa munhu anovimba nemi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}