{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba waVanakomana vaKora. Pisarema."]},{"type":"verse","number":1,"content":[{"text":"Makanzwira nyasha nyika yenyu, imi Jehovha;","poem":1},{"text":"makadzosera Jakobho nhaka yake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Makakanganwira kutadza kwavanhu venyu,","poem":1},{"text":"uye mukafukidza zvivi zvavo zvose. Sera","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Makaisa parutivi hasha dzenyu dzose,","poem":1},{"text":"mukadzoka pakutsamwa kwenyu kunotyisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tidzoreizve, imi Mwari Muponesi wedu,","poem":1},{"text":"mugoisa kure nemi kusafara kwenyu pamusoro pedu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mucharamba makatitsamwira nokusingaperi here?","poem":1},{"text":"Mucharega kutsamwa kwenyu kuripo kusvikira kuzvizvarwa zvose here?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ko, hamungatimutsiridzizve here,","poem":1},{"text":"kuti vanhu venyu vagofara mamuri?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tiratidzei ngoni dzenyu, imi Jehovha,","poem":1},{"text":"mugotipawo ruponeso rwenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ndichateerera zvichataurwa naJehovha Mwari;","poem":1},{"text":"anovimbisa rugare kuvanhu vake, vatsvene vake,","poem":2},{"lineBreak":true},{"text":"asi ngavasadzokerazve kuupenzi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chokwadi, ruponeso rwake rwuri pedyo navanomutya,","poem":1},{"text":"kuti kubwinya kwake kugogara munyika yedu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rudo nokutendeka zvinosangana pamwe chete;","poem":1},{"text":"kururama norugare zvinosvetana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kutendeka kunomera panyika,","poem":1},{"text":"kururama kunotarira pasi kuri kudenga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Chokwadi, Jehovha achapa zvinhu zvakanaka,","poem":1},{"text":"uye nyika yedu ichabereka mukoho wayo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kururama kuchamutungamirira,","poem":1},{"text":"uye kuchamugadzirira nzira yetsoka dzake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}