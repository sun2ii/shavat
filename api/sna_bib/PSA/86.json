{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"hebrew_subtitle","content":["Munyengetero waDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Inzwai, imi Jehovha, mundipindure,","poem":1},{"text":"nokuti ndiri murombo uye ndinoshayiwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Chengetai upenyu hwangu, nokuti ndakazvipa kwamuri.","poem":1},{"text":"Muri Mwari wangu;","poem":2},{"lineBreak":true},{"text":"ponesai muranda wenyu anovimba nemi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndinzwirei ngoni, imi Ishe,","poem":1},{"text":"nokuti ndinodana kwamuri zuva rose.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vigirai muranda wenyu mufaro,","poem":1},{"text":"nokuti kwamuri, imi Ishe,","poem":2},{"lineBreak":true},{"text":"ndinosimudzira mweya wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Imi munokanganwira uye makanaka, imi Ishe,","poem":1},{"text":"muzere norudo kuna vose vanodana kwamuri.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inzwai munyengetero wangu, imi Jehovha;","poem":1},{"text":"inzwai kuchemera kwangu ngoni dzenyu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndichadana kwamuri pazuva rokutambudzika kwangu,","poem":1},{"text":"nokuti muchandipindura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Haiwa Ishe, hakuna akafanana nemi pakati pavamwari;","poem":1},{"text":"hakuna mabasa akaita seenyu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndudzi dzose dzamakaita dzichauya","poem":1},{"text":"kuzonamata pamberi penyu, imi Ishe;","poem":2},{"lineBreak":true},{"text":"dzicharumbidza zita renyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nokuti imi muri mukuru uye munoita zvinhu zvinoshamisa;","poem":1},{"text":"imi moga ndimi Mwari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Haiwa Jehovha, ndidzidzisei nzira yenyu,","poem":1},{"text":"uye ndichafamba muzvokwadi yenyu;","poem":2},{"text":"ndipei mwoyo mumwe,","poem":1},{"text":"kuti ndigotya zita renyu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndichakurumbidzai, imi Ishe Mwari wangu, nomwoyo wangu wose;","poem":1},{"text":"ndicharumbidza zita renyu nokusingaperi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nokuti rudo rwenyu rukuru kwandiri;","poem":1},{"text":"makandirwira paguva rakadzika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Haiwa Mwari, vanozvikudza vari kundirwisa;","poem":1},{"text":"boka ravanhu vane utsinye rinotsvaka upenyu hwangu,","poem":2},{"lineBreak":true},{"text":"vanhu vasina hanya nemi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asi, imi Ishe, mune tsitsi uye muri Mwari ane nyasha,","poem":1},{"text":"anononoka kutsamwa, azere norudo nokutendeka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dzokerai kwandiri mundinzwire ngoni;","poem":1},{"text":"ipai simba renyu kumuranda wenyu,","poem":2},{"lineBreak":true},{"text":"uye muponese mwanakomana womurandakadzi wenyu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndipei chiratidzo chokunaka kwenyu,","poem":1},{"text":"kuti vavengi vangu vazvione vagonyadziswa,","poem":2},{"lineBreak":true},{"text":"nokuti imi Jehovha makandibatsira uye mukandinyaradza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}