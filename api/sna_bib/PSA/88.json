{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"hebrew_subtitle","content":["Rwiyo. Pisarema ravanakomana vaKora. Kumutungamiri wokuimba namaimbirwo emaharati reanoti. Masikiri raHemani muEzrahi."]},{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, Mwari anondiponesa,","poem":1},{"text":"ndakachema masikati nousiku pamberi penyu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Munyengetero wangu ngausvike pamberi penyu;","poem":1},{"text":"rerekerai nzeve yenyu kukuchema kwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nokuti mweya wangu uzere nokutambudzika,","poem":1},{"text":"uye upenyu hwangu hwaswedera pedyo neguva.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndinoverengwa pakati paavo vakaburukira kugomba;","poem":1},{"text":"ndava somunhu asina simba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndakatsaurwa pamwe chete navakafa,","poem":1},{"text":"savakaurayiwa vavete muguva,","poem":2},{"text":"vamusingacharangaririzve,","poem":1},{"text":"vakagurwa kubva pakuchengeta kwenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Makandiisa mugomba rakadzika dzika,","poem":1},{"text":"murima guru makadzika dzika.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hasha dzenyu dzinorema kwazvo pamusoro pangu,","poem":1},{"text":"makandifukidza namafungu enyu ose. Sera","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Makanditorera shamwari dzangu dzapedyo,","poem":1},{"text":"uye mukandiita chinhu chinonyangadza.","poem":2},{"text":"Ndakapfigirwa uye handingatongopunyuki;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"meso angu asviba neshungu.","poem":2},{"lineBreak":true},{"text":"Ndinodana kwamuri, imi Jehovha, mazuva ose;","poem":1},{"text":"ndinotambanudzira maoko angu kwamuri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ko, munoratidza zvishamiso zvenyu kuna vakafa here?","poem":1},{"text":"Ko, vakafa vanomuka vachikurumbidzai here? Sera","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ko, rudo rwenyu runoparidzwa muguva,","poem":1},{"text":"nokutendeka kwenyu mukuparadzwa here?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ko, zvishamiso zvenyu zvinozivikanwa munzvimbo yerima,","poem":1},{"text":"kana mabasa akarurama enyu munyika yokukanganwa here?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Asi ndinochemera rubatsiro kwamuri, imi Jehovha;","poem":1},{"text":"mangwanani, munyengetero wangu unosvika pamberi penyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Seiko, imi Jehovha, muchindiramba","poem":1},{"text":"uye muchindivanzira chiso chenyu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kubvira pauduku hwangu, ndakatambudzika zvokutosvika pedyo norufu;","poem":1},{"text":"ndatambudzika nokutyisa kwenyu uye handisisina tariro.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hasha dzenyu dzakapfuura napamusoro pangu;","poem":1},{"text":"kutyisa kwenyu kwandiparadza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Zuva rose zvakandipoteredza samafashamu;","poem":1},{"text":"ndakaputirwa nazvo chose.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Makanditorera shamwari dzangu navadikani vangu;","poem":1},{"text":"rima ndiyo shamwari yangu iri pedyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}