{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"hebrew_subtitle","content":["Masikiri raEtani muEzirahi."]},{"type":"verse","number":1,"content":[{"text":"Ndichaimba nezvorudo rukuru rwaJehovha nokusingaperi;","poem":1},{"text":"ndichazivisa kutendeka kwenyu nomuromo wangu kuzvizvarwa zvose.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichaparidza kuti rudo rwenyu runomira rwakasimba nokusingaperi,","poem":1},{"text":"uye kuti muchasimbisa kutendeka kwenyu kudenga chaiko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Imi makati, “Ndakaita sungano nomusanangurwa wangu,","poem":1},{"text":"ndakapika kuna Dhavhidhi muranda wangu, ndichiti,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘Ndichasimbisa imba yako nokusingaperi,","poem":1},{"text":"uye ndichasimbisa chigaro chako choushe kuzvizvarwa zvose.’ ” Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Matenga anorumbidza zvishamiso zvenyu, imi Jehovha,","poem":1},{"text":"kutendeka kwenyuwo muungano yavatsvene.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nokuti ndianiko kudenga kumusoro angaenzaniswa naJehovha?","poem":1},{"text":"Ndianiko akaita saJehovha pakati pezvisikwa zvokudenga?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mwari anotyiwa zvikuru paungano yavatsvene;","poem":1},{"text":"iye anotyisa kwazvo kupfuura vose vakamupoteredza.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Haiwa Jehovha Mwari Wamasimba Ose, ndianiko akaita semi?","poem":1},{"text":"Mune simba, imi Jehovha, uye kutendeka kwenyu kunokupoteredzai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Munotonga pamusoro pokusunda kwegungwa;","poem":1},{"text":"mafungu aro paanosimuka, munoanyaradza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Makapwanya Rahabhi somumwe wavakaurayiwa;","poem":1},{"text":"makaparadzira vavengi venyu noruoko rwenyu rune simba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Matenga ndeenyu, nenyika ndeyenyuwo;","poem":1},{"text":"makavamba nyika nezvose zviri mairi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndimi makasika kumusoro nezasi;","poem":1},{"text":"Tabhori neHerimoni zvinoimbira zita renyu nomufaro.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ruoko rwenyu rune simba;","poem":1},{"text":"chanza chenyu chakasimba, ruoko rwenyu rworudyi rwakasimudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kururama nokururamisira ndidzo nheyo dzechigaro chenyu choushe;","poem":1},{"text":"rudo nokutendeka zvinokutungamirirai.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vakaropafadzwa avo vakadzidza kukurumbidzai,","poem":1},{"text":"vanofamba muchiedza pamberi penyu, imi Jehovha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Vanofara muzita renyu zuva rose;","poem":1},{"text":"vanofara mukururama kwenyu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nokuti imi ndimi kubwinya nesimba ravo,","poem":1},{"text":"uye nenyasha dzenyu munosimudzira runyanga rwedu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zvirokwazvo, nhoo yedu ndeyaJehovha,","poem":1},{"text":"mambo wedu, iye Mutsvene oga waIsraeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ipapo makataura muchiratidzo,","poem":1},{"text":"mukati, kuvanhu venyu vakatendeka:","poem":2},{"text":"“Ndakaisa simba pamusoro pemhare;","poem":1},{"text":"ndakasimudzira jaya pakati pavanhu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndakawana Dhavhidhi muranda wangu;","poem":1},{"text":"ndakamuzodza namafuta matsvene.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ruoko rwangu ruchamutsigira;","poem":1},{"text":"zvirokwazvo chanza changu chichamusimbisa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hakuna muvengi achamuripisa mutero;","poem":1},{"text":"hakuna munhu akaipa achamudzvinyirira.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndichapwanya vavengi vake pamberi pake,","poem":1},{"text":"uye ndicharovera pasi vadzivisi vake.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Rudo rwangu rwakatendeka ruchava naye,","poem":1},{"text":"uye runyanga rwake ruchasimudzirwa muzita rangu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndichaisa ruoko rwake pamusoro pegungwa,","poem":1},{"text":"ruoko rwake rworudyi pamusoro penzizi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Iye achadana kwandiri, achiti, ‘Ndimi Baba vangu,","poem":1},{"text":"Mwari wangu, Dombo noMuponesi wangu.’","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ndichamugadzawo kuti ave dangwe rangu,","poem":1},{"text":"iye anokudzwa zvikuru pamadzimambo enyika.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ndichachengetedza rudo rwangu kwaari nokusingaperi,","poem":1},{"text":"uye sungano yangu naye haitongoperi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ndichasimbisa imba yake nokusingaperi,","poem":1},{"text":"uye nechigaro chake choushe chero matenga achingovapo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Kana vana vake vakasiya murayiro wangu,","poem":1},{"text":"uye vakasatevera zvandakatema,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"kana vakazvidza mitemo yangu,","poem":1},{"text":"uye vakakoniwa kuchengeta mirayiro yangu,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ndicharanga chivi chavo neshamhu,","poem":1},{"text":"uye kuipa kwavo nokurova kukuru;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"asi handizobvisi rudo rwangu kwavari,","poem":1},{"text":"kana kuzombopandukira kutendeka kwangu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Handizozvidzi sungano yangu","poem":1},{"text":"kana kushandura zvakarehwa nemiromo yangu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kamwe chete, ndakapika noutsvene hwangu,","poem":1},{"text":"uye handingarevi nhema kuna Dhavhidhi,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"kuti imba yake icharamba iripo nokusingaperi","poem":1},{"text":"uye chigaro chake choushe chichagara pamberi pangu sezuva;","poem":2}]},{"type":"verse","number":37,"content":[{"text":"chichasimbiswa nokusingaperi somwedzi,","poem":1},{"text":"chapupu chakatendeka chiri kudenga.” Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Asi imi makaramba, makavenga,","poem":1},{"text":"makatsamwira kwazvo muzodziwa wenyu.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Makaparadza sungano yomuranda wenyu","poem":1},{"text":"uye mukasvibisa korona yake muguruva.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Makaputsa masvingo ake ose","poem":1},{"text":"mukaita nhare dzake matongo.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Vose vanopfuura napo vanomupamba;","poem":1},{"text":"ava chiseko chavavakidzani vake.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Makasimudzira ruoko rworudyi rwavavengi vake;","poem":1},{"text":"makaita kuti vavengi vake vose vafare.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Makadzosera shure munondo wake unopinza,","poem":1},{"text":"uye hamuna kumutsigira pakurwa.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Makagumisa kubwinya kwake,","poem":1},{"text":"mukawisira pasi chigaro chake choushe.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Makatapudza mazuva oujaya hwake;","poem":1},{"text":"makamufukidza nejasi renyadzi. Sera","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Haiwa Jehovha kusvikira riniko? Muchazvivanza nokusingaperi here?","poem":1},{"text":"Hasha dzenyu dzichapisa somoto kusvikira riniko?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Rangarirai kuti upenyu hwangu hunopfuura sei.","poem":1},{"text":"Nokuti makasikira vanhu vose zvisina maturo!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ko, munhu ndoupi angararama akasaona rufu,","poem":1},{"text":"kana angazviponesa pasimba reguva? Sera","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Haiwa Ishe, rudo rwenyu rukuru rwekare rwuripiko,","poem":1},{"text":"irwo rwamakapika nokutendeka kwenyu kuna Dhavhidhi?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Rangarirai, Ishe kuti muranda wenyu aisekwa sei,","poem":1},{"text":"kuti ndaitakura sei muchipfuva changu kutuka kwendudzi dzose,","poem":2}]},{"type":"verse","number":51,"content":[{"text":"kutuka uko vavengi venyu vaikusekai nako, imi Jehovha,","poem":1},{"text":"pavaiseka nhambwe imwe neimwe yomuzodziwa wenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Jehovha ngaarumbidzwe nokusingaperi!","poem":1},"Ameni naAmeni."]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}