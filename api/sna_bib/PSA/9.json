{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"hebrew_subtitle","content":["Kumutungamiri wokuimba namaimbiro o“Kufa kwoMwanakomana.” Pisarema raDhavhidhi."]},{"type":"verse","number":1,"content":[{"text":"Ndichakurumbidzai, imi Jehovha, nomwoyo wangu wose;","poem":1},{"text":"ndichataura pamusoro pezvishamiso zvenyu zvose.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichafara nokufarisisa mamuri;","poem":1},{"text":"ndichaimbira zita renyu nziyo dzokurumbidza, imi Wokumusoro-soro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Vavengi vangu vanodzokera shure;","poem":1},{"text":"vanogumburwa uye vanoparara pamberi penyu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nokuti makatsigira kodzero yangu nenyaya yangu;","poem":1},{"text":"makagara pachigaro chenyu choushe, muchitonga zvakarurama kwazvo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Makatuka ndudzi mukaparadza vakaipa;","poem":1},{"text":"makadzima zita ravo nokusingaperi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuparadzwa kusina magumo kwakakunda muvengi,","poem":1},{"text":"makadzura maguta avo;","poem":2},{"lineBreak":true},{"text":"kunyange chiyeuchidzo chavo chakaparara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jehovha anotonga nokusingaperi;","poem":1},{"text":"akasimbisa chigaro chake choushe kuti atonge.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Achatonga nyika nokururama;","poem":1},{"text":"achatonga marudzi nokururamisira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jehovha ndiye nhare yavakamanikidzwa,","poem":1},{"text":"nhare yakasimba panguva yokutambudzika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vanoziva zita renyu vachavimba nemi,","poem":1},{"text":"nokuti imi, Jehovha hamuna kumbosiya avo vanokutsvakai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Imbirai Jehovha nziyo dzokurumbidza,","poem":1},{"text":"iye agere pachigaro choushe muZioni; paridzai zvaakaita pakati pendudzi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nokuti iye anotsiva ropa anorangarira;","poem":1},{"text":"haashayiri hanya kuchema kwavanotambudzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Haiwa Jehovha, onai kuti vavengi vangu vanonditambudza sei!","poem":1},{"text":"Ndinzwirei ngoni mundisimudze pamasuo orufu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kuti ndiparidze kurumbidzwa kwenyu","poem":1},{"text":"mumasuo oMwanasikana weZioni,","poem":2},{"lineBreak":true},{"text":"uye ndigofara muruponeso rwenyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ndudzi dzakawira mugomba radzakachera;","poem":1},{"text":"tsoka dzavo dzakabatwa nemimbure yavakaviga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jehovha anozivikanwa nokururamisira kwake;","poem":1},{"text":"vakaipa vakateyiwa namabasa amaoko avo. Higayoni. Sera","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Vakaipa vanodzokera kuguva,","poem":1},{"text":"idzo ndudzi dzose dzinokanganwa Mwari.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Asi vanoshayiwa havangagari vachikanganwikwa,","poem":1},{"text":"uye tariro yavanotambudzwa haingaparari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Simukai, Jehovha, munhu ngaarege kukunda;","poem":1},{"text":"ndudzi ngadzitongwe pamberi penyu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Varovei nokutyisa, imi Jehovha;","poem":1},{"text":"ndudzi ngadzizive kuti vanongova vanhu zvavo. Sera","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}