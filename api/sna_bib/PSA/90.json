{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"hebrew_subtitle","content":["Munyengetero waMozisi munhu waMwari."]},{"type":"verse","number":1,"content":[{"text":"Jehovha, imi makava ugaro hwedu","poem":1},{"text":"kuzvizvarwa zvose.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Makomo asati azvarwa","poem":1},{"text":"uye musati mabudisa nyika nepasi rose,","poem":2},{"lineBreak":true},{"text":"kubva pakusingaperi kusvikira pakusingaperi muri Mwari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Munodzosera vanhu kuguruva zvakare, muchiti,","poem":1},{"text":"“Dzokerai kuguruva, imi vanakomana vavanhu.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nokuti pamberi penyu makore chiuru","poem":1},{"text":"akangofanana nezuva richangopfuura,","poem":2},{"lineBreak":true},{"text":"kana senguva yokurinda usiku.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Munokukura vanhu pakuvata kworufu;","poem":1},{"text":"vakaita sebundo idzva ramangwanani,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kunyange richimera riri idzva mangwanani,","poem":1},{"text":"nenguva yamadekwana rinenge raoma uye rasvava.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tapera nokutsamwa kwenyu","poem":1},{"text":"uye tinovhundutswa nehasha dzenyu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Makaisa zvakaipa zvedu pamberi penyu,","poem":1},{"text":"makaisa zvivi zvedu zvakavanzika muchiedza chokuvapo kwenyu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mazuva edu ose anopfuura napasi pehasha dzenyu;","poem":1},{"text":"tinopedza makore edu nokuchema.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uwandu hwamazuva edu hunosvika makore makumi manomwe,","poem":1},{"text":"kana makumi masere, kana tiine simba;","poem":2},{"text":"kunyange zvakadaro uwandu hwawo hunongova nhamo nokusuwa,","poem":1},{"text":"nokuti anokurumidza kupfuura, uye isu tobhururuka toenda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ndianiko anoziva simba rokutsamwa kwenyu?","poem":1},{"text":"Nokuti hasha dzenyu dzakakura sokutyiwa kwakakufanirai imi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tidzidzisei kuverenga mazuva edu zvakanaka,","poem":1},{"text":"kuti tiwane mwoyo wouchenjeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dzokai, imi Jehovha! Zvichadaro kusvikira riniko?","poem":1},{"text":"Ivai netsitsi pamusoro pavaranda venyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tigutsei mangwanani norudo rwenyu rusingaperi,","poem":1},{"text":"kuti tigoimba nomufaro tigofara mazuva edu ose.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tifadzei zvinoenzana namazuva amakatitambudza,","poem":1},{"text":"samakore mazhinji atakaona nhamo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mabasa enyu ngaaratidzwe kuvaranda venyu,","poem":1},{"text":"nokubwinya kwenyu kuvana vavo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nyasha dzaIshe Mwari wedu ngadzive pamusoro pedu;","poem":1},{"text":"tisimbisirei mabasa amaoko edu, hongu,","poem":2},{"lineBreak":true},{"text":"simbisai basa ramaoko edu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}