{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"Uyo anogara panzvimbo yokuvanda yeWokumusoro-soro","poem":1},{"text":"achazorora mumumvuri weWamasimba Ose.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichati pamusoro paJehovha, “Ndiye utiziro hwangu nenhare yangu,","poem":1},{"text":"Mwari wangu, wandinovimba naye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zvirokwazvo achakuponesa parugombe rwomuteyi","poem":1},{"text":"napadenda rinouraya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Achakufukidza neminhenga yake,","poem":1},{"text":"uye uchawana utiziro pasi pamapapiro ake;","poem":2},{"lineBreak":true},{"text":"kutendeka kwake kuchava nhoo yako norusvingo rwako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haungatyiswi nokuvhundutsa kwousiku,","poem":1},{"text":"kana museve unopfurwa masikati,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kana hosha inofamba murima,","poem":1},{"text":"kana denda rinoparadza masikati.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Chiuru chingawa parutivi rwako,","poem":1},{"text":"zviuru gumi kurudyi pako,","poem":2},{"lineBreak":true},{"text":"asi hazvingaswederi kwauri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uchangozviona nameso ako chete,","poem":1},{"text":"uye uchaona kurangwa kwavakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kana ukaita Wokumusoro-soro ugaro hwako,","poem":1},{"text":"kunyange Jehovha, iye utiziro hwangu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ipapo hapana chakaipa chichakuwira,","poem":1},{"text":"hakuna njodzi ichasvika patende rako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokuti acharayira vatumwa vake pamusoro pako,","poem":1},{"text":"kuti vakuchengete panzira dzako dzose;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"vachakusimudza mumaoko avo,","poem":1},{"text":"kuti rutsoka rwako rurege kugumburwa padombo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uchatsika pamusoro peshumba napamusoro pechiva;","poem":1},{"text":"uchatsika-tsika shumba huru nenyoka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Nokuti anondida,” ndizvo zvinotaura Jehovha, “neni ndichamununura;","poem":1},{"text":"ndichamudzivirira, nokuti anoziva zita rangu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Achadana kwandiri, uye ndichamupindura;","poem":1},{"text":"ndichava naye pakutambudzika,","poem":2},{"lineBreak":true},{"text":"ndichamurwira uye ndichamukudza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndichamugutsa noupenyu hurefu,","poem":1},{"text":"uye ndichamuratidza ruponeso rwangu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}