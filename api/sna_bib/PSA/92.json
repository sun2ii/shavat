{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["Pisarema. Rwiyo rweSabata."]},{"type":"verse","number":1,"content":[{"text":"Zvakanaka kurumbidza Jehovha","poem":1},{"text":"nokuimbira zita renyu nziyo, imi Wokumusoro-soro,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kuparidza rudo rwenyu mangwanani","poem":1},{"text":"nokutendeka kwenyu usiku,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"nechiridzwa chine hungiso","poem":1},{"text":"gumi namaririro akanaka embira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nokuti munondifadza namabasa enyu, imi Jehovha;","poem":1},{"text":"ndinoimba nomufaro nokuda kwamabasa amaoko enyu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haiwa Jehovha, mabasa enyu makuru seiko,","poem":1},{"text":"ndangariro dzenyu dzakadzika sei!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Munhu asina njere haazivi,","poem":1},{"text":"mapenzi haanzwisisi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kuti kunyange vakaipa vachimera souswa,","poem":1},{"text":"uye vaiti vezvakaipa vose vachikura,","poem":2},{"text":"vachaparadzwa nokusingaperi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Asi imi, iyemi Jehovha, munosimudzirwa nokusingaperi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nokuti zvirokwazvo vavengi venyu, imi Jehovha,","poem":1},{"text":"zvirokwazvo vavengi venyu vachaparadzwa;","poem":2},{"lineBreak":true},{"text":"vaiti vezvakaipa vose vachaparadzirwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Makasimudzira runyanga rwangu sorwenyati;","poem":1},{"text":"mafuta akaisvonaka akadururirwa pamusoro pangu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Meso angu akaona kukundwa kwavadzivisi vangu;","poem":1},{"text":"nzeve dzangu dzakanzwa kuparadzwa kwavavengi vangu vakaipa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Vakarurama vachakura kwazvo somuchindwe,","poem":1},{"text":"vachakura somusidhari weRebhanoni;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"wakadyarwa muimba yaJehovha,","poem":1},{"text":"vachakura kwazvo muvanze dzaMwari wedu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vacharamba vachibereka zvibereko pakukwegura kwavo,","poem":1},{"text":"vachagara vari vanyoro uye vari vatsva.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vachaparidza kuti, “Jehovha akarurama;","poem":1},{"text":"ndiye Dombo rangu, uye maari hamuna chakaipa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}