nt":[{"text":"Zvamakatema hazvishanduki;","poem":1},{"text":"utsvene hunofukidza imba yenyu imi Jehovha,","poem":2},{"lineBreak":true},{"text":"kwamazuva asingaperi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}