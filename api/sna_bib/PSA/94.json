{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"Haiwa Jehovha, imi Mwari anotsiva,","poem":1},{"text":"haiwa Mwari iyemi munotsiva, penyai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Simukai, imi Mutongi wenyika;","poem":1},{"text":"tsivai vanozvikudza zvakavafanira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Haiwa Jehovha, vakaipa vachasvika riniko,","poem":1},{"text":"vachasvika riniko vakaipa vachingofara?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vanodurura mashoko okuzvikudza;","poem":1},{"text":"vose vanoita zvakaipa vazere nokuzvirumbidza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vanopwanya vanhu venyu, imi Jehovha,","poem":1},{"text":"vanodzvinyirira nhaka yenyu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vanouraya chirikadzi nomweni;","poem":1},{"text":"vanoponda nherera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vanoti, “Jehovha haaoni;","poem":1},{"text":"Mwari waJakobho haana hanya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nzwisisai, imi vasina njere pakati pavanhu;","poem":1},{"text":"imi mapenzi, muchava vakachenjera riniko?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ko, iye akasima nzeve, haanganzwi here?","poem":1},{"text":"Iye akaumba ziso haangaoni here?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ko, iye anoranga ndudzi haangarangi here?","poem":1},{"text":"Anodzidzisa vanhu angashayiwa zivo here?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehovha anoziva mirangariro yavanhu;","poem":1},{"text":"anoziva kuti haina maturo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Akaropafadzwa munhu anorangwa nemi, iyemi Jehovha,","poem":1},{"text":"munhu wamunodzidzisa pamurayiro wenyu;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"munomuzorodza pamazuva enhamo,","poem":1},{"text":"kusvikira akaipa achererwa gomba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nokuti Jehovha haangarambi vanhu vake;","poem":1},{"text":"haangambosiyi nhaka yake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kururamisira kuchawanikwa nokuda kwevakarurama,","poem":1},{"text":"uye vose vakarurama pamwoyo vachakutevera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ndianiko achandirwira pane vakaipa?","poem":1},{"text":"Ndianiko achandibatsira pavaiti vezvakaipa?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dai Jehovha asina kundibatsira,","poem":1},{"text":"ndingadai ndakakurumidza kugara parunyararo rworufu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pandakati, “Rutsoka rwangu rwotedzemuka,”","poem":1},{"text":"rudo rwenyu, imi Jehovha, rwakanditsigira.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Pandakava nokufunganya kukuru mandiri,","poem":1},{"text":"kunyaradza kwenyu kwakandivigira mufaro kumweya wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ko, chigaro choushe chino uori chingashamwaridzana nemi here,","poem":1},{"text":"icho chinouyisa kutambudzika muzvirevo zvacho?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vanobatana pamwe chete kuti varwise vakarurama,","poem":1},{"text":"vachipomera mhosva yorufu kuna vasina mhosva.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Asi Jehovha ndiye ava nhare yangu,","poem":1},{"text":"uye Mwari wangu ndiye dombo randinotizira.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Achavatsiva nokuda kwezvivi zvavo,","poem":1},{"text":"uye achavaparadza nokuda kwezvakaipa zvavo;","poem":2},{"lineBreak":true},{"text":"Jehovha Mwari wedu achavaparadza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}