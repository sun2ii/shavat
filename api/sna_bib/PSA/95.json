{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Uyai, tiimbire Jehovha nomufaro;","poem":1},{"text":"ngatidanidzirei kuDombo roruponeso rwedu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngatisvikei pamberi pake nokuvonga","poem":1},{"text":"uye timukudze nenziyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nokuti Jehovha ndiye Mwari mukuru,","poem":1},{"text":"Mambo mukuru pamusoro pavamwari vose.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nzvimbo dzakadzika dzapanyika dziri muruoko rwake,","poem":1},{"text":"uye misoro yamakomo ndeyake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gungwa nderake, nokuti ndiye akariita,","poem":1},{"text":"uye maoko ake akaumba nyika yakaoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Uyai tikotame, tinamate,","poem":1},{"text":"ngatipfugamei pamberi paJehovha Muiti wedu;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nokuti ndiye Mwari wedu,","poem":1},{"text":"uye isu tiri vanhu vanofudzwa naye,","poem":2},{"lineBreak":true},{"text":"makwai anochengetwa naye.","poem":2},{"lineBreak":true},{"text":"Nhasi kana muchinzwa inzwi rake,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"musaomesa mwoyo yenyu sezvamakaita paMeribha,","poem":2},{"lineBreak":true},{"text":"sezvamakaita pazuva riya paMasa mugwenga,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"pandakaedzwa namadzibaba enyu","poem":1},{"text":"kunyange vakanga vaona zvandakanga ndaita.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndakatsamwira rudzi urwu kwamakore makumi mana;","poem":1},{"text":"ndakati, “Ava vanhu vane mwoyo yakatsauka,","poem":2},{"lineBreak":true},{"text":"uye havana kuziva nzira dzangu.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Saka ndakapika pakutsamwa kwangu ndikati,","poem":1},{"text":"“Havangazombopindi pazororo rangu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}