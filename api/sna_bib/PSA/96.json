{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"Imbirai Jehovha rwiyo rutsva;","poem":1},{"text":"imbirai Jehovha, nyika yose.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Imbirai Jehovha, rumbidzai zita rake;","poem":1},{"text":"paridzai ruponeso rwake zuva nezuva.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Paridzai kubwinya kwake pakati pendudzi,","poem":1},{"text":"namabasa ake anoshamisa pakati pamarudzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nokuti Jehovha mukuru uye anofanira kurumbidzwa,","poem":1},{"text":"iye anofanira kutyiwa pamusoro pavamwari vose.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nokuti vamwari vose vendudzi zvifananidzo,","poem":1},{"text":"asi Jehovha akaita matenga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kubwinya noumambo zviri pamberi pake;","poem":1},{"text":"simba nokubwinya zviri munzvimbo yake tsvene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Remekedzai Jehovha, imi ndudzi dzose,","poem":1},{"text":"ipai rukudzo nesimba kuna Jehovha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ipai kuna Jehovha rukudzo rwakafanira zita rake;","poem":1},{"text":"uyai nechipiriso mugopinda pavanze dzake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Namatai Jehovha mukubwinya kwoutsvene hwake;","poem":1},{"text":"dederai pamberi pake, imi nyika dzose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Muti pakati pendudzi, “Jehovha ndiye anobata ushe.”","poem":1},{"text":"Nyika yakanyatsosimbiswa, haingazungunuswi;","poem":2},{"lineBreak":true},{"text":"uye achatonga marudzi nokururama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kudenga denga ngakufare, nyika ngaifarisise;","poem":1},{"text":"gungwa ngaritinhire, nezvose zviri mariri;","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"masango ngaafare, nezvose zviri maari.","poem":2},{"text":"Ipapo miti yose yesango ichaimba nomufaro;","poem":1}]},{"type":"verse","number":13,"content":[{"text":"ichaimba pamberi paJehovha, nokuti anouya,","poem":2},{"lineBreak":true},{"text":"anouya kuzotonga nyika.","poem":2},{"text":"Achatonga nyika nokururama,","poem":1},{"text":"uye vanhu nechokwadi chake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}