{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"PSA","translationId":"sna_bib","name":"MAPISAREMA","commonName":"MAPISAREMA","title":"MAPISAREMA","order":19,"numberOfChapters":150,"sha256":"02c90d86284b40af01e5e214d295a524b74d4d1aff7444e46f2e9990731d8f95","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sna_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"Jehovha anobata ushe, nyika ngaifare;","poem":1},{"text":"zviwi zviri kure ngazvifare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Makore nerima guru zvakamukomberedza;","poem":1},{"text":"kururama nokururamisira ndidzo nheyo dzechigaro chake choushe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Moto unoenda mberi kwake","poem":1},{"text":"uchipisa vavengi vake kumativi ose.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mheni yake inovhenekera pasi;","poem":1},{"text":"nyika inozviona igodedera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Makomo anonyungudika senamo pamberi paJehovha,","poem":1},{"text":"pamberi paIshe wenyika yose.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kudenga denga kunoparidza kururama kwake,","poem":1},{"text":"uye vanhu vose vanoona kubwinya kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vose vanonamata zvifananidzo vanonyadziswa,","poem":1},{"text":"avo vanozvirumbidza nezvifananidzo,","poem":2},{"lineBreak":true},{"text":"munamatei, imi vamwari vose!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Zioni rinonzwa rigofara uye misha yeJudha inofara nokuda kwezvamakatonga, imi Jehovha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nokuti imi, iyemi Jehovha, ndimi Wokumusoro-soro pasi pose;","poem":1},{"text":"makasimudzirwa kupfuura vamwari vose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vanoda Jehovha ngavavenge zvakaipa,","poem":1},{"text":"nokuti anorinda upenyu kwavanhu vake vakatendeka","poem":2},{"lineBreak":true},{"text":"uye anovarwira muruoko rwowakaipa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Chiedza chinovhenekera pamusoro pavakarurama,","poem":1},{"text":"nomufaro pamusoro pavane mwoyo yakarurama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Farai muna Jehovha, imi vakarurama,","poem":1},{"text":"uye mukudze zita rake dzvene.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}