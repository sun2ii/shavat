ext":"nembira nenzwi rokuimba,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"nehwamanda nokurira kworunyanga rwegondobwe,","poem":1},{"text":"danidzirai nomufaro pamberi paJehovha, iye Mambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gungwa ngaritinhire, nezvose zviri mariri,","poem":1},{"text":"nenyika, navose vanogaramo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nzizi ngadziuchire maoko adzo,","poem":1},{"text":"makomo ngaaimbe pamwe chete nomufaro;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ngaaimbe pamberi paJehovha,","poem":1},{"text":"nokuti anouya kuzotonga nyika.","poem":2},{"text":"Achatonga nyika zvakarurama","poem":1},{"text":"navanhu nokururamisira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}