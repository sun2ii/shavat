oem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mozisi naAroni vakanga vari pakati pavaprista vake,","poem":1},{"text":"Samueri akanga ari pakati paavo","poem":2},{"text":"vaidana kuzita rake,","poem":1},{"text":"vakadana kuna Jehovha akavapindura.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akataura kwavari ari mushongwe yegore;","poem":1},{"text":"vakachengeta zvaakatema nemitemo yaakavapa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Haiwa Jehovha Mwari wedu,","poem":1},{"text":"imi makavapindura;","poem":2},{"text":"makanga muri Mwari anokanganwira kuna Israeri,","poem":1},{"text":"kunyange makavaranga pane zvavakaita.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kudzai Jehovha Mwari wedu","poem":1},{"text":"mumunamate pagomo rake dzvene,","poem":2},{"lineBreak":true},{"text":"nokuti Jehovha Mwari wedu ndiye mutsvene.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}