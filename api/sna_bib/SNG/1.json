{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"SNG","translationId":"sna_bib","name":"Rwiyo Rukuru rwaSoromoni","commonName":"Rwiyo Rukuru rwaSoromoni","title":"RWIYO RUKURU RWASOROMONI","order":22,"numberOfChapters":8,"sha256":"e13790c0f1b86d5a8c80ce6c5f4a10e8876a6b699a2faab46b1158550d755cea","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/sna_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Rwiyo Rukuru rwaSoromoni:"]},{"type":"verse","number":2,"content":[{"text":"Ngaanditsvode hake nokutsvoda kwomuromo wake.","poem":1},{"text":"Nokuti rudo rwako runofadza kupfuura waini.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kunhuhwirira kwamafuta enyu kunofadza;","poem":1},{"text":"zita renyu rakafanana namafuta anonhuwirira adururwa.","poem":2},{"lineBreak":true},{"text":"Hazvishamisi kuti mhandara dzinokudai!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nditorei muende neni, ngatikurumidzei.","poem":1},{"text":"Mambo ngaandipinze mudzimba dzake dzomukati.","poem":2},"Shamwari",{"text":"Tinokupembererai uye tinokufarirai;","poem":1},{"text":"ticharumbidza rudo rwenyu kupfuura waini.","poem":2},"Mukadzi",{"text":"Regai zvenyu mhandara dzikudei!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kusviba ndakasviba zvangu, asi ndakanaka hangu,","poem":1},{"text":"vanasikana veJerusarema,","poem":2},{"lineBreak":true},{"text":"ndakasviba samatende eKedhari,","poem":2},{"lineBreak":true},{"text":"sezvidzitiro zvetende raSoromoni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Musanditarisisa nokuda kwoutema hwangu,","poem":1},{"text":"nokuti ndakasvibiswa nezuva.","poem":2},{"text":"Vanakomana vamai vangu vakanditsamwira","poem":1},{"text":"vakandiita kuti ndichengete minda yemizambiringa;","poem":2},{"lineBreak":true},{"text":"munda wangu chaiwo wemizambiringa ndakaushayira nguva.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndiudze, iwe mudiwa wangu, kwaunofudzira makwai ako","poem":1},{"text":"nokwaunozorodzera makwai ako masikati.","poem":2},{"text":"Ko, ndichaitirei somukadzi akafukidza chiso chake","poem":1},{"text":"pedyo namakwai eshamwari dzako?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kana usingazivi, iwe mukadzi akanaka kukunda vamwe,","poem":1},{"text":"chitevera makwara amakwai","poem":2},{"text":"ugondofudzira mbudzana dzako","poem":1},{"text":"pedyo namatende avafudzi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndinokufananidza, iwe mudiwa wangu, nebhiza rakasungwa","poem":1},{"text":"pane imwe yengoro dzaFaro.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Matama ako akashongedzwa zvakanaka nemhete,","poem":1},{"text":"mutsipa wako nezvuma zvamatombo anokosha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tichakugadzirira mhete","poem":1},{"text":"dzenzeve dzegoridhe nesirivha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mambo paakanga agere patafura yake,","poem":1},{"text":"munhuwi wamafuta andainge ndazora wakapararira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mudiwa wangu, kwandiri akaita sakahomwe kemura","poem":1},{"text":"kanogara pakati pamazamu angu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mudiwa wangu, kwandiri akaita sesumbu ramaruva machena","poem":1},{"text":"anobva mubindu remizambiringa yeEni Gedhi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kunaka here kwawakaita uku, mudiwa wangu!","poem":1},{"text":"A-a, wakazonaka!","poem":2},{"lineBreak":true},{"text":"Meso ako injiva chaidzo!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wakanaka sei, mudiwa wangu!","poem":1},{"text":"A-a, unofadza!","poem":2},{"lineBreak":true},{"text":"Uye mubhedha wedu wakasvibira.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nhungo dzeimba yedu ndedzomusidhari;","poem":1},{"text":"mbariro dzacho ndedzomupaini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}