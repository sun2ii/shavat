{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"SNG","translationId":"sna_bib","name":"Rwiyo Rukuru rwaSoromoni","commonName":"Rwiyo Rukuru rwaSoromoni","title":"RWIYO RUKURU RWASOROMONI","order":22,"numberOfChapters":8,"sha256":"e13790c0f1b86d5a8c80ce6c5f4a10e8876a6b699a2faab46b1158550d755cea","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/sna_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ndiri ruva reSharoni,","poem":1},{"text":"ruva romumipata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Seruva riri pakati peminzwa,","poem":1},{"text":"ndizvo zvakaita mudiwa wangu pakati pemhandara.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Somuti womuapuro pakati pemiti yesango,","poem":1},{"text":"ndizvo zvawakaita mudiwa wangu pakati pamajaya.","poem":2},{"text":"Ndinofarira kugara mumumvuri wake,","poem":1},{"text":"uye muchero wake unondinakira kuudya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akaenda neni kuimba yamabiko,","poem":1},{"text":"uye mureza wake pamusoro pangu ndirwo rudo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndisimbise namazambiringa akaomeswa,","poem":1},{"text":"ndisimbise namaapuro;","poem":2},{"lineBreak":true},{"text":"nokuti ndoziya norudo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ruoko rwake rworuboshwe rwuri pasi pomusoro wangu,","poem":1},{"text":"uye ruoko rwake rworudyi rwakandimbundikira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Imi vanasikana veJerusarema ndinokupikirai","poem":1},{"text":"nemhara uye nenondo dzesango:","poem":2},{"text":"Musazunguza kana kumutsa rudo","poem":1},{"text":"kusvikira irwo rwada rwoga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Inzwai! Inzwi romudiwa wangu!","poem":1},{"text":"Tarirai! Hoyo","poem":2},{"text":"ouya achiuruka nomumakomo,","poem":1},{"text":"achikwakuka nomuzvikomo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mudiwa wangu akafanana nemhara","poem":1},{"text":"kana netsvana yenondo.","poem":2},{"text":"Tarirai! Hoyo amira seri kworusvingo rwedu,","poem":1},{"text":"akatarira napamawindo achidongorera napamaburi apamawindo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mudiwa wangu akataura kwandiri akati,","poem":1},{"text":"“Simuka, mudiwa wangu,","poem":2},{"lineBreak":true},{"text":"iwe munakunaku wangu, uya tiende tose.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tarira! Nguva yechando yapera;","poem":1},{"text":"mvura yapera; uye haichanayi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maruva oonekwa panyika;","poem":1},{"text":"nguva yokuimba yasvika,","poem":2},{"text":"kurira kwenjiva","poem":1},{"text":"kwonzwikwa munyika yedu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Muonde wobereka michero yawo yokutanga;","poem":1},{"text":"uye mizambiringa yotunga maruva ayo anonhuhwira kwazvo.","poem":2},{"text":"Simuka, uya, mudiwa wangu;","poem":1},{"text":"munakunaku wangu, uya tiende tose.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njiva yangu iri mumikaha yedombo,","poem":1},{"text":"munzvimbo dzokuvanda mumativi egomo,","poem":2},{"text":"ndiratidze chiso chako,","poem":1},{"text":"ndinoda kunzwa inzwi rako;","poem":2},{"text":"nokuti inzwi rako rinotapira,","poem":1},{"text":"uye chiso chako chinoyevedza.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tibatirei makava,","poem":1},{"text":"ivo vana vemakava","poem":2},{"text":"anoparadza minda yemizambiringa,","poem":1},{"text":"iyo mizambiringa yedu yotunga maruva.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mudiwa wangu ndewangu uye ndiri wake;","poem":1},{"text":"anofamba-famba pakati pamaruva omubani.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kusvikira zuva rabuda","poem":1},{"text":"uye mimvuri yatiza,","poem":2},{"text":"pinduka, mudiwa,","poem":1},{"text":"ubve waita semhara","poem":2},{"text":"kana tsvana","poem":1},{"text":"pamusoro pezvikomo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}