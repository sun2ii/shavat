{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"SNG","translationId":"sna_bib","name":"Rwiyo Rukuru rwaSoromoni","commonName":"Rwiyo Rukuru rwaSoromoni","title":"RWIYO RUKURU RWASOROMONI","order":22,"numberOfChapters":8,"sha256":"e13790c0f1b86d5a8c80ce6c5f4a10e8876a6b699a2faab46b1158550d755cea","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/sna_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Usiku hwose ndiri pamubhedha wangu","poem":1},{"text":"ndakatsvaka uyo anodiwa nomwoyo wangu;","poem":2},{"lineBreak":true},{"text":"ndakamutsvaka asi handina kumuwana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndichasimuka zvino ndinofamba-famba muguta,","poem":1},{"text":"mumigwagwa yaro nomuzvivara zvaro;","poem":2},{"text":"ndichatsvaka iye anodiwa nomwoyo wangu.","poem":1},{"text":"Saka ndakamutsvaka asi handina kumuwana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Varindi vakandiona","poem":1},{"text":"pavaiva pabasa ravo rokufamba-famba vachichengetedza guta.","poem":2},{"lineBreak":true},{"text":"“Ko, mamboona here iye anodiwa nomwoyo wangu?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndichingopfuudzana navo","poem":1},{"text":"ndakabva ndamuwana, iye anodiwa nomwoyo wangu.","poem":2},{"text":"Ndakamubata ndikasamuregedza","poem":1},{"text":"kusvikira ndaenda naye kumba kwamai vangu,","poem":2},{"lineBreak":true},{"text":"kuimba yaavo vakandibereka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vanasikana veJerusarema, ndinokurayirai","poem":1},{"text":"nemhara kana nenondo dzesango kuti:","poem":2},{"text":"Musazunguza kana kumutsa rudo","poem":1},{"text":"kusvikira irwo rwada rwoga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndianiko uyo ari kuuya achibva nokurenje","poem":1},{"text":"seshongwe youtsi","poem":2},{"text":"ine munhuwi wemura, nezvimwe zvinonhuhwira","poem":1},{"text":"zvakagadzirwa nezvikuyiwa zvinonhuhwira zvavashambadzi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tarirai! Ndiyo ngoro yaSoromoni,","poem":1},{"text":"yakachengetedzwa nemhare makumi matanhatu dzamachinda,","poem":2},{"lineBreak":true},{"text":"apamusoro-soro omuIsraeri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mumwe nomumwe wavo akabata munondo","poem":1},{"text":"vose vakarwa hondo,","poem":2},{"text":"mumwe nomumwe ane munondo parutivi rwake,","poem":1},{"text":"vakagadzirira kutarisana nezvinotyisa usiku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mambo Soromoni akazvigadzirira ngoro;","poem":1},{"text":"akaigadzira nemiti yokuRebhanoni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mbiru dzacho akadzigadzira nesirivha,","poem":1},{"text":"pokuzembera musana pakagadzirwa negoridhe.","poem":2},{"text":"Pokugara pakashongedzwa nejira repepuru,","poem":1},{"text":"mukati mayo makashongedzwa norudo","poem":2},{"lineBreak":true},{"text":"navanasikana veJerusarema.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Budai imi vanasikana veZioni,","poem":1},{"text":"muzoona Mambo Soromoni akapfeka korona,","poem":2},{"lineBreak":true},{"text":"korona yaakapfekedzwa namai vake","poem":2},{"text":"musi wesvitsa,","poem":1},{"text":"zuva iro mwoyo wake wakafara.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}