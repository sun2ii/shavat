{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"SNG","translationId":"sna_bib","name":"Rwiyo Rukuru rwaSoromoni","commonName":"Rwiyo Rukuru rwaSoromoni","title":"RWIYO RUKURU RWASOROMONI","order":22,"numberOfChapters":8,"sha256":"e13790c0f1b86d5a8c80ce6c5f4a10e8876a6b699a2faab46b1158550d755cea","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/sna_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Wakanaka sei, mudiwa wangu!","poem":1},{"text":"A, wakazonaka!","poem":2},{"lineBreak":true},{"text":"Meso ako uri mumumbure injiva chaidzo.","poem":2},{"text":"Bvudzi rako rakaita sedanga rembudzi","poem":1},{"text":"riri kuburuka kubva muGomo reGireadhi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Meno ako akafanana neboka ramakwai achangobva mukuveurwa,","poem":1},{"text":"ari kubva kundoshambidzwa.","poem":2},{"text":"Rimwe nerimwe riine rarakafanana naro,","poem":1},{"text":"pasina rimwe riri roga zvaro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Miromo yako yakafanana nomucheka mutsvuku;","poem":1},{"text":"muromo wako wakaisvonaka.","poem":2},{"text":"Zvavovo zvako zviri mumumbure wako","poem":1},{"text":"zvakaita sezvikamu zviviri zvedamba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mutsipa wako wakafanana neshongwe yaDhavhidhi","poem":1},{"text":"yakavakwa zvinoyevedza.","poem":2},{"text":"Mairi makaturikwa nhoo dzine chiuru,","poem":1},{"text":"dzose dziri nhoo dzemhare.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mazamu ako ari maviri akafanana netsvana mbiri dzemhara,","poem":1},{"text":"mapatya emhara","poem":2},{"lineBreak":true},{"text":"dzinofura pamwe chete pakati pemaruva.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kusvikira zuva rabuda","poem":1},{"text":"uye mimvuri yotiza,","poem":2},{"text":"ndichaenda kugomo remura","poem":1},{"text":"nokuchikomo chezvinonhuhwira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wakaisvonaka iwe, mudiwa wangu;","poem":1},{"text":"mauri hamuna kana chinongo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngatibvei tose kuRebhanoni, iwe mwenga wangu,","poem":1},{"text":"ngatibvei tose kuRebhanoni.","poem":2},{"text":"Buruka kubva pamusoro-soro peAmana,","poem":1},{"text":"kubva pamusoro peSeniri,","poem":2},{"text":"pamusoro-soro peHerimoni,","poem":1},{"text":"kubva kumapako eshumba nokumakomo anofamba-famba mbada.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Watora mwoyo wangu hanzvadzi yangu, mwenga wangu;","poem":1},{"text":"wanditora mwoyo","poem":2},{"text":"nokungondiringa kwawaita kamwe chete,","poem":1},{"text":"uye nedombo rimwe rinokosha rechishongo chomutsipa wako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Rudo rwako kwandiri runondifadza sei, hanzvadzi yangu, mwenga wangu!","poem":1},{"text":"Rudo rwako runofadza sei kukunda waini,","poem":2},{"lineBreak":true},{"text":"uye kunhuhwira kwamafuta ako okuzora","poem":2},{"lineBreak":true},{"text":"kunokunda zvose zvinonhuhwira.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Miromo yako inodonhesa zvinotapira sezinga rouchi, mwenga wangu;","poem":1},{"text":"uchi nomukaka zviri pasi porurimi rwako.","poem":2},{"lineBreak":true},{"text":"Kunhuhwira kwenguo dzako kwakafanana nokweRebhanoni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uri bindu rakapfigwa, hanzvadzi yangu, mwenga wangu.","poem":1},{"text":"Uri tsime rakakomberedzwa, nechitubu chakavakirirwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Miti yako ibindu ramatamba","poem":1},{"text":"nemimwe michero yakaisvonaka,","poem":2},{"lineBreak":true},{"text":"hena nenaridhi,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"naridhi nesafuroni,","poem":2},{"lineBreak":true},{"text":"karamusi, nesinamoni,","poem":2},{"lineBreak":true},{"text":"nemiti yose inogadziriswa zvinonhuhwira","poem":2},{"lineBreak":true},{"text":"nemura negavakava,","poem":2},{"lineBreak":true},{"text":"uye nezvose zvinonhuhwira zvakanakisisa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uri chitubu chomubindu,","poem":1},{"text":"tsime remvura inoerera,","poem":2},{"lineBreak":true},{"text":"inoerera ichibva kuRebhanoni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Muka, iwe mhepo yokumusoro,","poem":1},{"text":"uye uya iwe mhepo yezasi!","poem":2},{"text":"Vhuvhuta napabindu rangu","poem":1},{"text":"kuti kunhuhwirira kwezvirimo kuparadzirwe kwose kwose.","poem":2},{"text":"Rega mudiwa wangu apinde mubindu rake,","poem":1},{"text":"agoravira michero yaro yakaisvonaka, sepaanodira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}