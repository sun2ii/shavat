{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"SNG","translationId":"sna_bib","name":"Rwiyo Rukuru rwaSoromoni","commonName":"Rwiyo Rukuru rwaSoromoni","title":"RWIYO RUKURU RWASOROMONI","order":22,"numberOfChapters":8,"sha256":"e13790c0f1b86d5a8c80ce6c5f4a10e8876a6b699a2faab46b1158550d755cea","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/sna_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Ndauya zvangu mubindu rangu, hanzvadzi yangu, iwe mwenga wangu;","poem":1},{"text":"ndaunganidza mura yangu pamwe chete nezvinonhuhwira zvangu.","poem":2},{"text":"Ndadya zinga rangu rouchi nouchi hwangu;","poem":1},{"text":"ndanwa waini yangu nomukaka wangu.","poem":2},"Shamwari",{"text":"Idyai, imi shamwari, uye munwe;","poem":1},{"text":"inwai mugute, imi vanodanana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndakavata asi mwoyo wangu wakanga wakasvinura.","poem":1},{"text":"Inzwai! Mudiwa wangu ari kugogodza, achiti,","poem":2},{"text":"“Ndizarurire, hanzvadzi yangu, mudiwa wangu,","poem":1},{"text":"njiva yangu, wangu asina chinongo.","poem":2},{"text":"Musoro wangu wanyorova nedova,","poem":1},{"text":"bvudzi rangu ranyoroveswa nounyoro hweusiku.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndabvisa nguo yangu,","poem":1},{"text":"ndoipfekazve here?","poem":2},{"text":"Ndashambidza tsoka dzangu,","poem":1},{"text":"ndodzisvibisazve here?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mudiwa wangu akapinza ruoko rwake nepahwangwadza yomukova;","poem":1},{"text":"mwoyo wangu wakatanga kumudokwairira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndakasimuka kuti ndizarurire mudiwa wangu,","poem":1},{"text":"maoko angu akadonha mura,","poem":2},{"text":"mimwe yangu ichiyerera mura,","poem":1},{"text":"pazvibato zvechizarira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndakazarurira mudiwa wangu,","poem":1},{"text":"asi mudiwa wangu akanga abva; akanga atoenda.","poem":2},{"text":"Mwoyo wangu wakarwadziwa nokuenda kwake.","poem":1},{"text":"Ndakamutsvaka asi handina kumuwana.","poem":2},{"lineBreak":true},{"text":"Ndakamudana asi haana kupindura.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Varindi vakandiona","poem":1},{"text":"pavaiva pabasa ravo rokufamba-famba vachichengetedza guta.","poem":2},{"text":"Vakandirova, vakandikuvadza;","poem":1},{"text":"vakanditorera jasi rangu,","poem":2},{"lineBreak":true},{"text":"ivavo varindi vamasvingo!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Imi vanasikana veJerusarema, ndinokurayirai,","poem":1},{"text":"kana mukaona mudiwa wangu,","poem":2},{"text":"muchamuudzeiko?","poem":1},{"text":"Mumuudze kuti ndinorwara nerudo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mudiwa wako akanaka kukunda vamwe pakudii,","poem":1},{"text":"iwe zvako wakanaka kukunda vamwe vakadzi?","poem":2},{"text":"Mudiwa wako akanaka kukunda vamwe pakudii,","poem":1},{"text":"zvaunotirayira kudaro?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mudiwa wangu akanaka uye mutsvuku,","poem":1},{"text":"anokunda vanokwana zviuru gumi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Musoro wake igoridhe chairo;","poem":1},{"text":"bvudzi rake rinoyevedza","poem":2},{"lineBreak":true},{"text":"uye rakasviba segunguo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Meso ake akafanana nenjiva","poem":1},{"text":"dziri pahova dzemvura,","poem":2},{"text":"dzakashambidzwa mumukaka,","poem":1},{"text":"akarongwa sezvishongo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Matama ake akaita semihomba yezvinonhuhwira","poem":1},{"text":"inobereka zvinonhuhwira.","poem":2},{"text":"Miromo yake yakaita samaruva amahapa","poem":1},{"text":"anodonha mura.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Maoko ake itsvimbo dzegoridhe","poem":1},{"text":"dzakaiswa mabwe anokosha ekrisorite.","poem":2},{"text":"Muviri wake wakaita senyanga dzenzou dzinobwinya","poem":1},{"text":"dzakashongedzwa nesafire.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Makumbo ake imbiru dzamabwe machena","poem":1},{"text":"akamiswa pazvigadziko zvegoridhe rakanatswa.","poem":2},{"text":"Chimiro chake chakaita seRebhanoni,","poem":1},{"text":"chakanakisisa semisidhari yayo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Muromo wake inhapitapi pachayo;","poem":1},{"text":"zvirokwazvo akaisvonaka.","poem":2},{"text":"Uyu ndiye mudiwa wangu, ndiye shamwari yangu,","poem":1},{"text":"imi vanasikana veJerusarema.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}