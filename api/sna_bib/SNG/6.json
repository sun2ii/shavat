{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"SNG","translationId":"sna_bib","name":"Rwiyo Rukuru rwaSoromoni","commonName":"Rwiyo Rukuru rwaSoromoni","title":"RWIYO RUKURU RWASOROMONI","order":22,"numberOfChapters":8,"sha256":"e13790c0f1b86d5a8c80ce6c5f4a10e8876a6b699a2faab46b1158550d755cea","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/sna_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Ko, mudiwa wako aendepiko,","poem":1},{"text":"iwe zvako wakanaka kukunda vamwe vakadzi?","poem":2},{"text":"Mudiwa wako aenda nokupiko,","poem":1},{"text":"kuti tigomutsvaka pamwe chete newe?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mudiwa wangu adzika kubindu rake,","poem":1},{"text":"kumihomba yezvinonhuwirira,","poem":2},{"text":"kuti andomema mumapindu","poem":1},{"text":"uye agotanha maruva.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ini ndiri womudiwa wangu uye mudiwa wangu ndowangu;","poem":1},{"text":"anomema pakati pamaruva.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wakanaka iwe mudiwa wangu, seTiriza,","poem":1},{"text":"unoyevedza seJerusarema,","poem":2},{"lineBreak":true},{"text":"unoremekedzeka samauto ane mireza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bvisa meso ako pandiri;","poem":1},{"text":"anondikunda.","poem":2},{"text":"Bvudzi rako rakaita sedanga rembudzi","poem":1},{"text":"riri kuburuka muGireadhi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Meno ako akafanana neboka ramakwai","poem":1},{"text":"achangobva mukushambidzwa.","poem":2},{"text":"Rimwe nerimwe rine rarakafanana naro,","poem":1},{"text":"pasina riri roga zvaro.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zvavovo zvako zviri mumumbure wako","poem":1},{"text":"zvakaita sezvikamu zviviri zvedamba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kungava navanamambokadzi makumi matanhatu,","poem":1},{"text":"navarongo makumi masere","poem":2},{"lineBreak":true},{"text":"nemhandara dzisingaverengeki;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Asi njiva yangu, iye akakwana wangu,","poem":1},{"text":"ndiwe mumwe oga, mwanasikana mumwe oga wamai vake,","poem":2},{"lineBreak":true},{"text":"iye woga anodikanwa naiye akamubereka.","poem":2},{"text":"Mhandara dzakamuona dzikamuti akaropafadzwa.","poem":1},{"text":"Vanamambokadzi navarongo vakamurumbidza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ko, ndiani uyo anoratidzika samambakwedza,","poem":1},{"text":"akanaka somwedzi, anopenya sezuva,","poem":2},{"lineBreak":true},{"text":"akanaka senyeredzi dziri mumudungwe?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndakadzika kusango remiti yemipfura","poem":1},{"text":"kundoona zvitsva zvakamera mumupata,","poem":2},{"text":"kundoona kana mizambiringa yainge yabukira,","poem":1},{"text":"kana kuti mitamba yainge yava namaruva.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndisati ndambodii,","poem":1},{"text":"mwoyo wangu wakandiisa pakati pengoro dzoumambo dzavanhu vangu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dzoka, dzoka iwe muShurami;","poem":1},{"text":"dzoka, dzoka kuti timbokuona!","poem":2},"Mudiwa",{"text":"Ko, munodirei kuona muShurami","poem":1},{"text":"sezvamunoita mutambo weMahanaimi?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}