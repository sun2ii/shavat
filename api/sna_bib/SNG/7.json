{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"SNG","translationId":"sna_bib","name":"Rwiyo Rukuru rwaSoromoni","commonName":"Rwiyo Rukuru rwaSoromoni","title":"RWIYO RUKURU RWASOROMONI","order":22,"numberOfChapters":8,"sha256":"e13790c0f1b86d5a8c80ce6c5f4a10e8876a6b699a2faab46b1158550d755cea","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/sna_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Dzakanaka sei tsoka dzako dzakapfekedzwa shangu,","poem":1},{"text":"iwe mwanasikana womuchinda!","poem":2},{"text":"Makumbo ako akanakisisa akaita sezvishongo,","poem":1},{"text":"basa ramaoko emhizha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Guvhu rako rakatenderera somukombe","poem":1},{"text":"unogara uine waini yakasanganiswa zvakanaka.","poem":2},{"text":"Chiuno chako murwi wegorosi","poem":1},{"text":"wakakomberedzwa namaruva.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mazamu ako akaita setsvana mbiri,","poem":1},{"text":"mapatya emhara.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mutsipa wakaita seshongwe yakagadzirwa nenyanga dzenzou.","poem":1},{"lineBreak":true},{"text":"Meso ako ndiwo madziva eHeshibhoni","poem":1},{"text":"pasuo reBhati Rabhimi.","poem":2},{"text":"Mhuno yako yakaita seshongwe yeRebhanoni","poem":1},{"text":"yakatarisa kudivi reDhamasiko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Musoro wako unokushongedza nekorona seGomo reKarimeri.","poem":1},{"text":"Bvudzi rako rakaita sezvirukwa zvomumba mamambo;","poem":2},{"lineBreak":true},{"text":"mwoyo wamambo wakabatwa nokugadzirwa kwebvudzi rako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wakanaka uye unofadza sei,","poem":1},{"text":"iwe mudiwa nezvinofadza zvako!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Chimiro chako chakaita somuti womuchindwe;","poem":1},{"text":"uye mazamu ako samasumbu omuchero.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndakati, “Ndichakwira muchindwi uyu,","poem":1},{"text":"ndigobata muchero wawo.”","poem":2},{"text":"Mazamu ako ngaaite samasumbu omuzambiringa,","poem":1},{"text":"munhuwi wokufema kwako uite samaapuro,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"muromo wako ugoita sewaini yakanakisisa.","poem":2},"Mukadzi",{"text":"Waini ngaiendeswe kumudiwa wangu chaiko,","poem":1},{"text":"igoyerera zvinyoronyoro, napamiromo yake nameno ake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ini ndiri womudiwa wangu,","poem":1},{"text":"uye iye anondishuva.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uya, mudiwa wangu, ngatiendei kumunda,","poem":1},{"text":"tigozopedza usiku hwose kumaruwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngatimukirei kuminda yemizambiringa","poem":1},{"text":"tindoona kana mizambiringa yakabukira,","poem":2},{"text":"uye kana maruva awo azaruka,","poem":1},{"text":"uye kana mitamba yatumbuka yava namaruva,","poem":2},{"lineBreak":true},{"text":"ikoko ndiko kwandichakupa rudo rwangu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Miti yemidiwadiwa inopa kunhuhwira kwayo,","poem":1},{"text":"uye pamusuo pedu pane zvinonaka zvose,","poem":2},{"text":"zvose zvitsva nezvitsaru,","poem":1},{"text":"zvandakachengetera iwe, mudiwa wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}