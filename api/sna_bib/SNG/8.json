{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"SNG","translationId":"sna_bib","name":"Rwiyo Rukuru rwaSoromoni","commonName":"Rwiyo Rukuru rwaSoromoni","title":"RWIYO RUKURU RWASOROMONI","order":22,"numberOfChapters":8,"sha256":"e13790c0f1b86d5a8c80ce6c5f4a10e8876a6b699a2faab46b1158550d755cea","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/sna_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Dai chete wakanga uri sehanzvadzi kwandiri,","poem":1},{"text":"akanwa pamazamu amai vangu!","poem":2},{"text":"Ipapo kana ndaikuwana panze,","poem":1},{"text":"ndaikutsvoda","poem":2},{"lineBreak":true},{"text":"uye hapana aizondishora.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndaizokutora ndouya newe","poem":1},{"text":"kumba kwamai vangu,","poem":2},{"lineBreak":true},{"text":"ivo vakandidzidzisa.","poem":2},{"text":"Ndaikupa waini yakaiswa zvinonhuhwira kuti unwe,","poem":1},{"text":"nomukume wemitamba yangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ruoko rwake rworuboshwe rwuri pasi pomusoro wangu,","poem":1},{"text":"uye ruoko rwake rworudyi rwakandimbundikira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Imi vanasikana veJerusarema ndinokurayirai:","poem":1},{"text":"Musazunguza kana kumutsa rudo","poem":2},{"lineBreak":true},{"text":"kusvikira irwo rwada rwoga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndianiko uyo ari kuuya achibva kurenje","poem":1},{"text":"akazendamira pamudiwa wake?","poem":2},"Mukadzi",{"text":"Pasi pomuti womuapuro ndakakumutsa;","poem":1},{"text":"ipapo mai vako vakakubereka,","poem":2},{"lineBreak":true},{"text":"ipapo ivo vairwadziwa vakakubereka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndiise pamwoyo pako sechisimbiso,","poem":1},{"text":"sechisimbiso paruoko rwako;","poem":2},{"text":"nokuti rudo rwakasimba sorufu,","poem":1},{"text":"godo rarwo seguva harishanduki.","poem":2},{"text":"Runopisa serimi romoto,","poem":1},{"text":"somurazvo mukuru kwazvo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mvura zhinji haigoni kudzima rudo;","poem":1},{"text":"nzizi hadzigoni kurukukura.","poem":2},{"text":"Kunyange munhu akapa","poem":1},{"text":"pfuma yose yemba yake kuti awane rudo,","poem":2},{"lineBreak":true},{"text":"zvingazvidzwa chose.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tine hanzvadzi yedu duku","poem":1},{"text":"uye mazamu ake haasati akura.","poem":2},{"text":"Tichaitireiko hanzvadzi yedu","poem":1},{"text":"pazuva rokukumbirwa kwayo kuti iwanikwe?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kana ari rusvingo,","poem":1},{"text":"tichavaka shongwe dzesirivha paari.","poem":2},{"text":"Kana ari musuo,","poem":1},{"text":"tichamukomberedza namapuranga omusidhari.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndiri rusvingo,","poem":1},{"text":"mazamu angu akaita seshongwe.","poem":2},{"text":"Ndizvo zvandava pamberi pake,","poem":1},{"text":"somunhu anouyisa kugutsikana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Soromoni aiva nomunda wemizambiringa muBhaari Hamoni;","poem":1},{"text":"akapa munda wake wemizambiringa kuvanhu vairima vachimuripira.","poem":2},{"text":"Mumwe nomumwe wavo pachibereko chawo","poem":1},{"text":"aiuya namashekeri chiuru","poem":2},{"noteId":0},{"text":"esirivha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi munda wangu wemizambiringa ndewangu kuti ndiupe;","poem":1},{"text":"chiuru chamashekeri esirivha ndechako, iwe Soromoni,","poem":2},{"lineBreak":true},{"text":"asi mazana maviri","poem":2},{"noteId":1},{"text":"ndeevanochengeta michero yawo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iwe unogara mumapindu","poem":1},{"text":"unoshandirwa neshamwari,","poem":2},{"lineBreak":true},{"text":"rega ndinzwe inzwi rako!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Handei mudiwa wangu,","poem":1},{"text":"uite semhara kana setsvana","poem":2},{"text":"pamusoro pamakomo","poem":1},{"text":"azere zvinonhuhwira.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"makirogiramu angaita 11.5","reference":{"chapter":8,"verse":11}},{"noteId":1,"caller":"+","text":"makirogiramu angaita 2.3","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/sna_bib/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}