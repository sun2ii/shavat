{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ZEC","translationId":"sna_bib","name":"Zekaria","commonName":"Zekaria","title":"ZEKARIA","order":38,"numberOfChapters":14,"sha256":"d2d59c6d4872a8f091ff68ea81660108b38b91d7f4153cf83aa6e39cf5c533e2","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["Jehovha achachengeta Judha"]},{"type":"verse","number":1,"content":[{"text":"Kumbirai kuna Jehovha mvura yomunakamwe;","poem":1},{"text":"Jehovha ndiye anogadzira makore edutu.","poem":2},{"text":"Anonayisa mvura kuvanhu,","poem":1},{"text":"uye anopa zvirimwa zveminda kuno mumwe nomumwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zvifananidzo zvinotaura zvounyengeri,","poem":1},{"text":"vavuki vanoona zviratidzo zvenhema;","poem":2},{"text":"vanotaura zviroto zvenhema,","poem":1},{"text":"vanopa varaidzo pasina.","poem":2},{"text":"Nokudaro vanhu vanodzungaira","poem":1},{"text":"samakwai anomanikidzwa nokuda kwokushayiwa mufudzi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Kutsamwa kwangu kunomukira vafudzi,","poem":1},{"text":"uye ndicharova vatungamiri,","poem":2},{"text":"nokuti Jehovha Wamasimba Ose achava nehanya","poem":1},{"text":"namakwai ake, imba yaJudha,","poem":2},{"lineBreak":true},{"text":"uye achavaita sebhiza rinodadisa pakurwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Muna Judha muchabva ibwe rapakona,","poem":1},{"text":"kubva maari mbambo yetende,","poem":2},{"lineBreak":true},{"text":"kubva maari uta hwehondo,","poem":2},{"lineBreak":true},{"text":"kubva maari vatungamiri vose.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pamwe chete vachava savarume voumhare","poem":1},{"text":"vanotsika migwagwa ina matope pakurwa.","poem":2},{"text":"Nokuti Jehovha anavo,","poem":1},{"text":"vacharwa vachakunda vatasvi vamabhiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ndichasimbisa imba yaJudha","poem":1},{"text":"uye ndichaponesa imba yaJosefa.","poem":2},{"text":"Ndichavadzosa","poem":1},{"text":"nokuti ndinovanzwira tsitsi.","poem":2},{"text":"Vachava savanhu","poem":1},{"text":"vandakanga ndisina kuramba,","poem":2},{"text":"nokuti ndini Jehovha Mwari wavo","poem":1},{"text":"uye ndichavapindura.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"VaEfuremu vachava semhare,","poem":1},{"text":"uye mwoyo yavo ichafara sevakabatwa newaini.","poem":2},{"text":"Vana vavo vachazviona uye vachapembera;","poem":1},{"text":"Mwoyo yavo ichafara muna Jehovha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndichaninira kwavari","poem":1},{"text":"ndigovaunganidza.","poem":2},{"text":"Zvirokwazvo ndichavadzikinura,","poem":1},{"text":"vachava vakawanda sakare.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kunyange ndikavaparadzira pakati pamarudzi,","poem":1},{"text":"kunyange zvakadaro vachandirangarira vari kunyika dziri kure.","poem":2},{"text":"Ivo navana vavo vachararama,","poem":1},{"text":"uye vachadzoka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndichavauyisa kubva kuIjipiti","poem":1},{"text":"uye ndichavaunganidza kubva kuAsiria.","poem":2},{"text":"Ndichavauyisa kuGireadhi nokuRebhanoni,","poem":1},{"text":"uye hakungazovi nenzvimbo yavanokwana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vachapfuura napagungwa rokutambudzika;","poem":1},{"text":"mafungu egungwa achaderedzwa","poem":2},{"lineBreak":true},{"text":"uye pakadzika pose muna Nairi pachapwa.","poem":2},{"text":"Kuzvikudza kweAsiria kuchaparadzwa","poem":1},{"text":"uye tsvimbo youshe yeIjipiti ichabviswa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndichavasimbisa muna Jehovha","poem":1},{"text":"uye muzita rake vachafamba,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}