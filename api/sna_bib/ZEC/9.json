{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ZEC","translationId":"sna_bib","name":"Zekaria","commonName":"Zekaria","title":"ZEKARIA","order":38,"numberOfChapters":14,"sha256":"d2d59c6d4872a8f091ff68ea81660108b38b91d7f4153cf83aa6e39cf5c533e2","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/sna_bib/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["Kutongwa kwaVavengi veIsraeri"]},{"type":"heading","content":["Chirevo"]},{"type":"verse","number":1,"content":[{"text":"Shoko raJehovha rinorwisana nenyika yeHadhiraki","poem":1},{"text":"uye richagara pamusoro peDhamasiko,","poem":2},{"text":"nokuti meso avanhu naamarudzi ose","poem":1},{"text":"eIsraeri ari pana Jehovha,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"uye napamusoro peHamatiwo, rakaganhurana naro,","poem":1},{"text":"uye napamusoro peTire neSidhoni, kunyange zvazvo vane unyanzvi kwazvo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tire yakazvivakira nhare;","poem":1},{"text":"yakaunganidza sirivha seguruva","poem":2},{"lineBreak":true},{"text":"uye goridhe samarara omumugwagwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asi Ishe achatora upfumi hwayo","poem":1},{"text":"uye achaparadzira simba rayo pagungwa,","poem":2},{"lineBreak":true},{"text":"uye ichaparadzwa nomoto.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ashikeroni richazviona, rigotya;","poem":1},{"text":"Gaza richatambura mukurwadziwa,","poem":2},{"lineBreak":true},{"text":"neEkironiwo, nokuti tariro yaro ichapera.","poem":2},{"text":"Gaza richarasikirwa namambo waro","poem":1},{"text":"uye Ashikeroni haringavi navanhu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vatorwa vachagara paAshidhodhi,","poem":1},{"text":"uye ndichaparadza kuzvikudza kwavaFiristia.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndichabvisa ropa pamiromo yavo,","poem":1},{"text":"kudya kusingabvumirwi pakati pamazino avo.","poem":2},{"text":"Vaya vakasara vachava vanhu vaMwari wedu","poem":1},{"text":"uye vachava vatungamiri muJudha,","poem":2},{"lineBreak":true},{"text":"uye Ekironi achava savaJebhusi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asi ndichadzivirira imba yangu","poem":1},{"text":"pavarwi vanoirwisa.","poem":2},{"text":"Hapachazovazve nomumanikidzi angakunda vanhu vangu,","poem":1},{"text":"nokuti zvino ndiri kugara ndakatarira.","poem":2}]},{"type":"heading","content":["Kuuya kwaMambo weZioni"]},{"type":"verse","number":9,"content":[{"text":"Fara kwazvo, iwe Mwanasikana weZioni!","poem":1},{"text":"Danidzira, Mwanasikana weJerusarema!","poem":2},{"text":"Tarira, mambo wako anouya kwauri,","poem":1},{"text":"iye akarurama uye ano ruponeso,","poem":2},{"lineBreak":true},{"text":"anozvininipisa akatasva mbongoro,","poem":2},{"lineBreak":true},{"text":"iyo mhuru, mwana wembongoro.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndichabvisa ngoro kuna Efuremu,","poem":1},{"text":"namabhiza ehondo kuJerusarema,","poem":2},{"lineBreak":true},{"text":"uye uta hwehondo huchavhunwa.","poem":2},{"text":"Achaparidzira ndudzi rugare.","poem":1},{"text":"Ushe hwake huchabva kugungwa huchisvika kugungwa,","poem":2},{"lineBreak":true},{"text":"uye kubva kuRwizi kusvika kumigumo yenyika.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kana uriwe, nokuda kweropa resungano yangu newe,","poem":1},{"text":"ndichasunungura vasungwa vako kubva pagomba risina mvura.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dzokerai kunhare yenyu, imi vasungwa vetariro;","poem":1},{"text":"kunyange iye zvino ndichazivisa kuti ndichadzorera kwamuri zvakapetwa kaviri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndichakunga Judha sendinokunga uta hwangu,","poem":1},{"text":"uye ndichaizadza naEfuremu.","poem":2},{"text":"Ndichamutsa vanakomana vako, iwe Zioni,","poem":1},{"text":"kuti varwise vanakomana vako, iwe Girisi;","poem":2},{"lineBreak":true},{"text":"uye ndichakuita somunondo wemhare.","poem":2}]},{"type":"heading","content":["Jehovha achaonekwa"]},{"type":"verse","number":14,"content":[{"text":"Ipapo Jehovha achaonekwa pamusoro pavo;","poem":1},{"text":"museve wake uchapenya semheni.","poem":2},{"text":"Ishe Jehovha acharidza hwamanda;","poem":1},{"text":"achafamba mudutu rezasi.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Uye Jehovha Wamasimba Ose achavadzivirira.","poem":2},{"text":"Vachaparadza","poem":1},{"text":"uye vachakunda nezvimviriri.","poem":2},{"text":"Vachanwa vagoomba sevanwa waini;","poem":1},{"text":"vachazara sembiya dzinoshandiswa","poem":2},{"lineBreak":true},{"text":"pakusasa makona earitari.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jehovha Mwari wavo achavaponesa","poem":1},{"text":"pazuva iroro seboka ravanhu vake,","poem":2},{"text":"Vachavaima munyika yake","poem":1},{"text":"samabwe anokosha ari mukorona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuyevedza kwavo nokunaka kwavo kuchava kukuru sei!","poem":1},{"text":"Zviyo zvichaita kuti majaya abudirire,","poem":2},{"lineBreak":true},{"text":"uye waini itsva kumhandara.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}