{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ZEP","translationId":"sna_bib","name":"Zefania","commonName":"Zefania","title":"ZEFANIA","order":36,"numberOfChapters":3,"sha256":"f1bfffc264f4f718f4959dae7162320eca271f115235e2ff1198f8fafe684ec2","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/sna_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Shoko raJehovha rakasvika kuna Zefania, mwanakomana waKushi, mwanakomana waGedharia, mwanakomana waAmaria, mwanakomana waHezekia, pamazuva okutonga kwaJosia mwanakomana waAmoni mambo weJudha richiti:"]},{"type":"heading","content":["Yambiro yokuuya kwoKuparadzwa"]},{"type":"verse","number":2,"content":[{"text":"“Ndichatsvaira zvose","poem":1},{"text":"kubva pamusoro penyika,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"“Ndichatsvaira zvose vanhu nemhuka;","poem":1},{"text":"ndichatsvaira shiri dzedenga nehove dzegungwa.","poem":2},{"text":"Vakaipa vachasara nemirwi yamarara chete,","poem":1},{"text":"kana ndabvisa munhu pamusoro penyika,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]},{"type":"heading","content":["Kurwiswa kweJudha"]},{"type":"verse","number":4,"content":[{"text":"Ndichatambanudza ruoko rwangu kuti ndirwise Judha","poem":1},{"text":"uye ndicharwisa vose vanogara muJerusarema.","poem":2},{"text":"Ndichaparadza kubva panzvimbo ino vose vakasara vaBhaari,","poem":1},{"text":"mazita avaprista vechihedheni vanonamata zvifananidzo,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"vaya vanopfugama pamusoro pedzimba","poem":1},{"text":"kuti vanamate nyeredzi dzedenga,","poem":2},{"text":"vaya vanopfugama vachipika naJehovha","poem":1},{"text":"uye vanopikawo naMoreki,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"vaya vanotsauka kubva pakutevera Jehovha","poem":1},{"text":"uye vasingatsvaki Jehovha kana kubvunza kwaari.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nyararai pamberi paIshe Jehovha,","poem":1},{"text":"nokuti zuva raJehovha rava pedyo.","poem":2},{"text":"Jehovha agadzirira chibayiro;","poem":1},{"text":"akavaita vatsvene, vaya vaakakoka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pazuva rechibayiro chaJehovha,","poem":1},{"text":"ndicharova machinda","poem":2},{"lineBreak":true},{"text":"navanakomana vamambo,","poem":2},{"text":"navaya vose vakapfeka","poem":1},{"text":"nguo dzavatorwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pazuva iro ndicharanga","poem":1},{"text":"vose vanonyenyeredza kuti vasatsika paburiro,","poem":2},{"text":"vanozadza temberi yavamwari vavo","poem":1},{"text":"nechisimba nounyengeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Pazuva iro,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"“kuchema kuchanzwikwa kubva kuSuo reHove,","poem":2},{"lineBreak":true},{"text":"kuungudza kubva kuRutivi Rutsva rweguta,","poem":2},{"lineBreak":true},{"text":"nokukoromoka kukuru kubva kuzvikomo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ungudzai imi munogara munharaunda yomusika,","poem":1},{"text":"vashambadzi venyu vose vachaparadzwa,","poem":2},{"lineBreak":true},{"text":"vose vanotengesa nesirivha vachaparadzwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Panguva iyoyo ndichanzvera Jerusarema nomwenje;","poem":1},{"text":"uye ndicharanga vaya vagere zvavo,","poem":2},{"lineBreak":true},{"text":"vakaita sewaini yakasiyiwa mumasese ayo,","poem":2},{"text":"vanofunga kuti, ‘Jehovha hapana zvaangaita,","poem":1},{"text":"zvakanaka kana zvakaipa.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Upfumi hwavo huchapambwa,","poem":1},{"text":"dzimba dzavo dzichaputswa,","poem":2},{"text":"vachavaka dzimba,","poem":1},{"text":"asi havangagari madziri;","poem":2},{"text":"vachasima minda yemizambiringa,","poem":1},{"text":"asi havanganwi waini yacho.","poem":2}]},{"type":"heading","content":["Zuva Guru raJehovha"]},{"type":"verse","number":14,"content":[{"text":"“Zuva guru raJehovha rava pedyo,","poem":1},{"text":"pedyo, uye riri kuuya nokukurumidza.","poem":2},{"text":"Teererai! Kuchema pazuva raJehovha kucharwadza,","poem":1},{"text":"kuchema kwemhere ipapo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zuva iro richava rokutsamwa,","poem":1},{"text":"zuva rokudzungaira nokumanikidzwa,","poem":2},{"text":"zuva rokutambudzika nokuparadzwa,","poem":1},{"text":"zuva rerima nokusuwa, zuva ramakore nezarima.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zuva rehwamanda nemhere yehondo yokurwisa maguta akakomberedzwa namasvingo, nokurwisa shongwe dzomumakona.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ndichauyisa kudzungaira pavanhu","poem":1},{"text":"uye vachafamba samapofu,","poem":2},{"lineBreak":true},{"text":"nokuti vakatadzira Jehovha.","poem":2},{"text":"Ropa ravo richadururwa seguruva,","poem":1},{"text":"uye nyama yavo sendove.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sirivha yavo kana goridhe ravo","poem":1},{"text":"hazvingagoni kuvaponesa,","poem":2},{"lineBreak":true},{"text":"pazuva rokutsamwa kwaJehovha.","poem":2},{"text":"Mumoto wegodo rake","poem":1},{"text":"nyika yose ichaparadzwa,","poem":2},{"text":"nokuti achauyisa magumo pakarepo","poem":1},{"text":"kuna vose vanogara panyika.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}