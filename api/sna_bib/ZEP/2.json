{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ZEP","translationId":"sna_bib","name":"Zefania","commonName":"Zefania","title":"ZEFANIA","order":36,"numberOfChapters":3,"sha256":"f1bfffc264f4f718f4959dae7162320eca271f115235e2ff1198f8fafe684ec2","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/sna_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Unganai pamwe chete, unganai pamwe chete,","poem":1},{"text":"imi rudzi runonyadzisa,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"nguva dzakatarwa dzisati dzasvika","poem":1},{"text":"uye zuva iroro risati rapfuura sehundi,","poem":2},{"text":"kutsamwa kukuru kwaJehovha kusati kwauya pamusoro penyu,","poem":1},{"text":"zuva rehasha dzaJehovha risati rauya pamusoro penyu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tsvakai Jehovha, imi mose vanyoro vapanyika,","poem":1},{"text":"imi mose munoita zvaakarayira.","poem":2},{"text":"Tsvakai kururama, tsvakai unyoro;","poem":1},{"text":"zvimwe mungadzivirirwa","poem":2},{"lineBreak":true},{"text":"pazuva rokutsamwa kwaJehovha.","poem":2}]},{"type":"heading","content":["Kurwiswa kweFiristia"]},{"type":"verse","number":4,"content":[{"text":"Gaza richasiyiwa","poem":1},{"text":"uye Ashikeroni richasiyiwa rava dongo.","poem":2},{"text":"Pamasikati makuru Ashidhodhi richasiyiwa risisina chinhu","poem":1},{"text":"uye Ekironi radzurwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mune nhamo imi munogara pedyo negungwa,","poem":1},{"text":"imi vanhu veKereti;","poem":2},{"text":"shoko raJehovha rinokurwisa,","poem":1},{"text":"iwe Kenani nyika yavaFiristia.","poem":2},{"text":"“Ndichakuparadza,","poem":1},{"text":"uye hapana achasara.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nyika iri pedyo negungwa, panogara vaKereti,","poem":1},{"text":"ichava nzvimbo yavafudzi namatanga ehwai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ichava yavakasara veimba yavaJudha;","poem":1},{"text":"vachawana mafuro ikoko.","poem":2},{"text":"Mumadekwana vachavata pasi","poem":1},{"text":"mudzimba dzaAshikeroni.","poem":2},{"text":"Jehovha Mwari wavo achavachengeta;","poem":1},{"text":"Achavadzorera pfuma yavo.","poem":2}]},{"type":"heading","content":["Kurwiswa kweMoabhu neAmoni"]},{"type":"verse","number":8,"content":[{"text":"“Ndakanzwa kutuka kwaMoabhu","poem":1},{"text":"nokuzvidza kwavaAmoni,","poem":2},{"text":"avo vakatuka vanhu vangu","poem":1},{"text":"uye vakatyisidzira nyika yavo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Naizvozvo, zvirokwazvo noupenyu hwangu,”","poem":1},{"text":"ndizvo zvinotaura Wamasimba Ose, Mwari waIsraeri,","poem":2},{"text":"“zvirokwazvo Moabhu achaita seSodhomu,","poem":1},{"text":"vaAmoni seGomora,","poem":2},{"text":"nzvimbo yesora namakomba emunyu,","poem":1},{"text":"matongo nokusingaperi.","poem":2},{"text":"Vakasara vavanhu vangu vachavapamba;","poem":1},{"text":"vachararama vorudzi rwangu vachagara nhaka yenyika yavo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Izvi ndizvo zvavachawana nokuda kwokuzvikudza kwavo,","poem":1},{"text":"nokuti vakatuka uye vakadadira vanhu vaJehovha Wamasimba Ose.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehovha achava anotyisa kwavari","poem":1},{"text":"paachaparadza vamwari vose venyika.","poem":2},{"text":"Ndudzi pamahombekombe ose dzichamunamata,","poem":1},{"text":"rudzi rumwe norumwe munyika yarwo.","poem":2}]},{"type":"heading","content":["Kurwiswa kweEtiopia"]},{"type":"verse","number":12,"content":[{"text":"“Nemiwo, imi vaEtiopia,","poem":1},{"text":"muchaparadzwa nomunondo wangu.”","poem":2}]},{"type":"heading","content":["Kurwiswa kweAsiria"]},{"type":"verse","number":13,"content":[{"text":"Achatambanudza ruoko rwake kuti arwise nyika","poem":1},{"text":"yokumusoro agoparadza Asiria,","poem":2},{"text":"achasiya Ninevhe rava dongo zvachose","poem":1},{"text":"uye raoma segwenga.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mapoka amakwai nemombe zvichavata pasi imomo,","poem":1},{"text":"nezvipuka zvamarudzi ose.","poem":2},{"text":"Zizi romurenje nezizi romurwizi","poem":1},{"text":"zvichavata pamusoro pembiru dzavo.","poem":2},{"text":"Kudana kwazvo kuchaungira nomumawindo,","poem":1},{"text":"marara achava pamisuo yavo,","poem":2},{"lineBreak":true},{"text":"mapango omusidhari achasiyiwa pachena.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iri ndiro guta risina hanya","poem":1},{"text":"raigara vakachengetedzeka.","poem":2},{"text":"Rakati mumwoyo maro,","poem":1},{"text":"“Ndini, uye hakuna mumwe kunze kwangu.”","poem":2},{"text":"Razova dongo rakadii,","poem":1},{"text":"nzvimbo inovata mhuka dzesango!","poem":2},{"text":"Vose vanopfuura napariri vanoseka","poem":1},{"text":"Uye vanokunga zvibhakera zvavo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}