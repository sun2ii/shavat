{"translation":{"id":"sna_bib","name":"Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi 2017","website":"https://ebible.org/Scriptures/details.php?id=sna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sna","licenseNotes":null,"shortName":"BIB","englishName":"Shona Bible","language":"sna","textDirection":"ltr","sha256":"ffcce39458d9ec156de5ce385e461cc81cc99ff0046dbc4dea03bb49c54ce307","availableFormats":["json"],"listOfBooksApiLink":"/api/sna_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"chiShona","languageEnglishName":"Shona"},"book":{"id":"ZEP","translationId":"sna_bib","name":"Zefania","commonName":"Zefania","title":"ZEFANIA","order":36,"numberOfChapters":3,"sha256":"f1bfffc264f4f718f4959dae7162320eca271f115235e2ff1198f8fafe684ec2","firstChapterNumber":1,"firstChapterApiLink":"/api/sna_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/sna_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Ramangwana reJerusarema"]},{"type":"verse","number":1,"content":[{"text":"Rine nhamo guta ravamanikidzi,","poem":1},{"text":"rakapanduka uye rikasvibiswa!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Harina warinoteerera,","poem":1},{"text":"harigamuchiri kudzorwa.","poem":2},{"text":"Harivimbi naJehovha,","poem":1},{"text":"hariswederi pedyo naMwari waro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Machinda aro ishumba dzinoomba,","poem":1},{"text":"vatongi varo mapere amadekwana,","poem":2},{"lineBreak":true},{"text":"vasingasiyi chinhu chamangwanani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vaprofita vavo vanozvikudza;","poem":1},{"text":"vanhu vanonyengera.","poem":2},{"text":"Vaprista varo vanozvidza nzvimbo tsvene","poem":1},{"text":"uye vanoputsa murayiro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jehovha ari mariri mutsvene;","poem":1},{"text":"haaiti zvakaipa.","poem":2},{"text":"Mangwanani oga oga anotonga nokururamisira kwake,","poem":1},{"text":"zuva rimwe nerimwe idzva anoriuyisa,","poem":2},{"lineBreak":true},{"text":"asi vasakarurama havanyari.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ndakaparadza ndudzi;","poem":1},{"text":"shongwe dzavo dzakaparara.","poem":2},{"text":"Ndakasiya nzira dzavo dzisisafambwi,","poem":1},{"text":"hapasisina anopfuura nomo.","poem":2},{"text":"Maguta avo akaparadzwa;","poem":1},{"text":"hapana achasiyiwa, kana mumwe zvake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndakati kuguta,","poem":1},{"text":"‘Zvirokwazvo uchanditya","poem":2},{"lineBreak":true},{"text":"ugogamuchira kudzorwa!’","poem":2},{"text":"Ipapo vagari varo havangaparadzwi,","poem":1},{"text":"kana kuranga kwangu kwose hakungauyi pariri.","poem":2},{"text":"Asi vakanga vachine shungu","poem":1},{"text":"dzokuita uori pakuita kwavo kwose.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Naizvozvo ndimirirei,” ndizvo zvinotaura Jehovha,","poem":1},{"text":"“zuva randichasimuka kuti ndigopupura.","poem":2},{"text":"Ndafunga kuunganidza ndudzi,","poem":1},{"text":"kuunganidza ushe hwose","poem":2},{"text":"uye nokudurura hasha dzangu pavari,","poem":1},{"text":"kutsamwa kukuru kwangu kwose.","poem":2},{"text":"Nyika yose ichaparadzwa","poem":1},{"text":"nomoto wegodo rokutsamwa kwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ipapo ndichachenesa miromo yavanhu,","poem":1},{"text":"kuti vose zvavo vadane kuzita raJehovha","poem":2},{"lineBreak":true},{"text":"uye vamushumire nomwoyo mumwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubva mhiri kwenzizi dzeEtiopia vanamati vangu,","poem":1},{"text":"vanhu vangu vakapararira,","poem":2},{"lineBreak":true},{"text":"vachandiunzira zvipiriso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pazuva iro hamungaiswi pakunyadziswa","poem":1},{"text":"nokuda kwezvakaipa zvamakandiitira,","poem":2},{"text":"nokuti ndichabvisa kubva","poem":1},{"text":"muguta rino vaya vanofara mukuzvikudza kwavo.","poem":2},{"text":"Hamungazovizve namanyawi","poem":1},{"text":"pagomo rangu dzvene.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi ndichasiya pakati penyu","poem":1},{"text":"vanyoro vanozvininipisa,","poem":2},{"lineBreak":true},{"text":"vanovimba nezita raJehovha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vakasara vaIsraeri havangaiti zvakaipa;","poem":1},{"text":"havangarevi nhema,","poem":2},{"lineBreak":true},{"text":"uye kunyengera hakuzowanikwi mumiromo yavo.","poem":2},{"text":"Vachadya uye vagorara pasi,","poem":1},{"text":"uye hapana angavatyisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Imba, iwe Mwanasikana weZioni,","poem":1},{"text":"danidzira, iwe Israeri!","poem":2},{"text":"Fara ugofarisisa nomwoyo wako wose,","poem":1},{"text":"iwe Mwanasikana weJerusarema!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jehovha abvisa kurangwa kwako kwose,","poem":1},{"text":"adzinga muvengi wako. Jehovha,","poem":2},{"text":"Mambo waIsraeri, anewe;","poem":1},{"text":"hauzotyizve kuti ungakuvadzwa nechinhu chipi zvacho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pazuva iro vachati kuJerusarema,","poem":1},{"text":"“Usatya, iwe Zioni;","poem":2},{"lineBreak":true},{"text":"usarega maoko ako achishayiwa simba.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jehovha Mwari wako anewe,","poem":1},{"text":"ndiye ane simba rokuponesa.","poem":2},{"text":"Achafadzwa zvikuru newe,","poem":1},{"text":"achakunyaradza norudo rwake,","poem":2},{"lineBreak":true},{"text":"achafara nokuda kwako nokuimba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Matambudziko emitambo","poem":1},{"text":"yakatarwa ndichaabvisa kwauri;","poem":2},{"lineBreak":true},{"text":"iwo mutoro nokuzvidzwa kwauri.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Panguva iyoyo ndichatonga","poem":1},{"text":"vose vakakumanikidza;","poem":2},{"text":"ndichanunura vakaremara","poem":1},{"text":"uye ndichaunganidza vaya vakaparadzirwa.","poem":2},{"text":"Ndichavapa rumbidzo norukudzo","poem":1},{"text":"munyika dzose dzavakaiswa pakunyadziswa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Panguva iyoyo ndichakuunganidzai;","poem":1},{"text":"panguva iyoyo ndichakuuyisai kumusha.","poem":2},{"text":"Ndichakupai rukudzo nerumbidzo","poem":1},{"text":"pakati pavanhu vose vapanyika,","poem":2},{"text":"pandichadzora pfuma yenyu","poem":1},{"text":"muchizviona nameso enyu,”","poem":2},{"text":"ndizvo zvinotaura Jehovha.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/sna_bib/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sna_bib/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sna_bib/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}