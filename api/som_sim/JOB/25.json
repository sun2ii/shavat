{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"JOB","translationId":"som_sim","name":"AYUUB","commonName":"AYUUB","title":"KITAABKII AYUUB","order":18,"numberOfChapters":42,"sha256":"d77fe757f4ee402f4f3f7b5dc2f202c14a3b05025ef3452639d17c1e24d2b232","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/som_sim/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["Bildad"]},{"type":"verse","number":1,"content":["Markaasaa Bildad oo ahaa reer Shuuxii u jawaabay, oo wuxuu ku yidhi,"]},{"type":"verse","number":2,"content":[{"text":"Dowladnimo iyo cabsiba isagaa leh,","poem":1},{"lineBreak":true},{"text":"Oo meelihiisa sarena nabad buu ka dhigaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ciidammadiisu ma tiray leeyihiin?","poem":1},{"lineBreak":true},{"text":"Oo yuu yahay kan aan iftiinkiisu ku soo bixin?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Balse sidee baa nin u kari karaa inuu Ilaah hortiisa xaq ku ahaado?","poem":1},{"lineBreak":true},{"text":"Mid naagu dhashayse sidee buu u karaa inuu nadiif ahaado?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bal eeg, xataa dayuxu hortiisa nuur kuma leh,","poem":1},{"lineBreak":true},{"text":"Oo xiddiguhuna hortiisa daahir kuma aha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Intee buu ka sii liitaa nin dirxi ahu!","poem":1},{"lineBreak":true},{"text":"Iyo binu-aadmiga dirxiga ahu!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}