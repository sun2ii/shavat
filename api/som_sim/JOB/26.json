{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"JOB","translationId":"som_sim","name":"AYUUB","commonName":"AYUUB","title":"KITAABKII AYUUB","order":18,"numberOfChapters":42,"sha256":"d77fe757f4ee402f4f3f7b5dc2f202c14a3b05025ef3452639d17c1e24d2b232","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/som_sim/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Ayuub"]},{"type":"verse","number":1,"content":["Markaasaa Ayuub u jawaabay oo wuxuu ku yidhi,"]},{"type":"verse","number":2,"content":[{"text":"Sidee baad u caawisay midka aan itaalka lahayn!","poem":1},{"lineBreak":true},{"text":"Oo kan ayan gacantiisu xoogga lahayn sidee baad u badbaadisay!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sidee baad ula talisay kan aan xigmadda lahayn!","poem":1},{"lineBreak":true},{"text":"Oo aad u muujisay aqoon wanaagsan!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaad erayo kula hadashay?","poem":1},{"lineBreak":true},{"text":"Oo yaa ruuxiisu xaggaaga ka soo baxay?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuwii dhintayna way ku hoos gariiraan","poem":1},{"lineBreak":true},{"text":"Biyaha iyo waxyaalaha dhex deggan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"She'ool hortiisuu yaal isagoo qaawan,","poem":1},{"lineBreak":true},{"text":"Oo Halligaadduna dabool ma leh.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Isagu woqooyiga wuxuu ku kala bixiyaa meel madhan,","poem":1},{"lineBreak":true},{"text":"Oo dhulkana wuxuu ka laalaadshaa wax aan waxba ahayn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Biyaha wuxuu ku xidhaa daruurihiisa qarada waaweyn;","poem":1},{"lineBreak":true},{"text":"Oo daruurtuna hoostooda kama dillaacdo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wuxuu xidhaa wejiga carshigiisa,","poem":1},{"lineBreak":true},{"text":"Oo daruurtiisana wuu ku kala bixiyaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Biyaha dushooda wuxuu ku wareejiyey soohdin","poem":1},{"lineBreak":true},{"text":"Kala xidha nuurka iyo gudcurka.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tiirarka samadu way gariiraan,","poem":1},{"lineBreak":true},{"text":"Oo waxay ka yaabaan canaantiisa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Badda ayuu xooggiisa ku aamusiiyaa,","poem":1},{"lineBreak":true},{"text":"Oo kibirkana waxgarashadiisuu ku dhuftaa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Samooyinka waxaa lagu sharraxay Ruuxiisa,","poem":1},{"lineBreak":true},{"text":"Gacantiisuna waxay mudday abeesada dheeraysa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bal eeg, waxanu waa darafyadii jidadkiisa uun;","poem":1},{"lineBreak":true},{"text":"Oo inta isaga laga maqlaana yaraan badanaa!","poem":1},{"lineBreak":true},{"text":"Laakiinse bal yaa onkodka xooggiisa garan kara?","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}