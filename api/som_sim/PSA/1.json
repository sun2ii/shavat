{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Waxaa barakaysan ninkii aan ku socon talada kuwa sharka leh,","poem":1},{"lineBreak":true},{"text":"Oo aan istaagin jidka dembilayaasha,","poem":1},{"lineBreak":true},{"text":"Oo aan ku fadhiisan kursiga kuwa wax quudhsada.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Laakiinse waxaa isaga ka farxiya sharciga Rabbiga,","poem":1},{"lineBreak":true},{"text":"Oo habeen iyo maalinba sharcigiisuu ka fikiraa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oo wuxuu ahaan doonaa sida geed lagu beeray durdurrada biyaha agtooda,","poem":1},{"lineBreak":true},{"text":"Oo midhihiisa dhala xilligooda,","poem":1},{"lineBreak":true},{"text":"Oo aan caleentiisuna engegin.","poem":1},{"lineBreak":true},{"text":"Oo wax alla wuxuu sameeyoba wuu ku liibaani doonaa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Laakiinse kuwa sharka lahu sidaas ma aha,","poem":1},{"lineBreak":true},{"text":"Iyaguse waxay la mid yihiin buunshaha dabayshu kaxayso.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sidaas daraaddeed kuwa sharka lahu isma dhex taagi doonaan xukunka,","poem":1},{"lineBreak":true},{"text":"Dembilayaashuna sooma dhex geli doonaan kuwa xaqa ah ururkooda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waayo, Rabbigu waa yaqaan kuwa xaqa ah jidkooda,","poem":1},{"lineBreak":true},{"text":"Laakiinse kuwa sharka ah jidkoodu waa baabbi'i doonaa.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}