{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"heading","content":["Kanu waa sabuur mahadnaqid ah."]},{"type":"verse","number":1,"content":[{"text":"Inta dhulka deggan oo dhammay, Rabbiga farxad ugu qayliya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rabbiga farxad ugu adeega,","poem":1},{"lineBreak":true},{"text":"Oo hortiisa gabay la kaalaya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ogaada in Rabbigu Ilaah yahay,","poem":1},{"lineBreak":true},{"text":"Waxaa ina sameeyey isaga, oo waxaynu nahay kuwiisii,","poem":1},{"lineBreak":true},{"text":"Waxaynu nahay dadkiisii iyo idihii daaqsintiisa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Irdihiisa mahadnaqid la gala,","poem":1},{"lineBreak":true},{"text":"Barxadihiisana ammaan.","poem":1},{"lineBreak":true},{"text":"Isaga u mahadnaqa, oo magiciisa ammaana.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waayo, Rabbigu waa wanaagsan yahay, naxariistiisuna weligeed way sii waartaa,","poem":1},{"lineBreak":true},{"text":"Aaminnimadiisuna tan iyo ka ab ka ab.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}