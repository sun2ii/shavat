{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Waxaan ka gabyi doonaa naxariis iyo garsoorid,","poem":1},{"lineBreak":true},{"text":"Rabbiyow, waxaan kuugu gabyi doonaa ammaan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oo waxaan u dhawrsan doonaa si qumman oo caqliya,","poem":1},{"lineBreak":true},{"text":"Bal goormaad ii iman doontaa?","poem":1},{"lineBreak":true},{"text":"Waxaan gurigayga ku dhex socon doonaa qalbi qumman.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Indhahayga hortooda wax xun ma dhigi doono,","poem":1},{"lineBreak":true},{"text":"Waan necbahay kuwa leexda shuqulkooda,","poem":1},{"lineBreak":true},{"text":"Oo innaba iguma dhegi doono.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qalbi qalloocanu wuu iga fogaan doonaa,","poem":1},{"lineBreak":true},{"text":"Oo innaba wax shar ah ma aqoon doono.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kii qarsoodi u xanta deriskiisa, kaas waan baabbi'in doonaa,","poem":1},{"lineBreak":true},{"text":"Kii isla madax weyn oo qalbigiisu kibirsan yahayna uma dulqaadan doono.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Indhahaygu waxay la jiri doonaan kuwa aamiinka ah oo dalka deggan, si ay iila joogaan aawadeed,","poem":1},{"lineBreak":true},{"text":"Kii si qumman u socda ayaa ii adeegi doona.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kii khiyaano ka shaqeeyaase gurigayga ma joogi doono,","poem":1},{"lineBreak":true},{"text":"Kii been ku hadlaana hortayda kuma xoogaysan doono.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Subax ilaa ka subax ayaan wada baabbi'in doonaa kuwa sharka leh oo dalka deggan oo dhan,","poem":1},{"lineBreak":true},{"text":"Si aan magaalada Rabbiga uga baabbi'iyo kuwa xumaanta ka shaqeeya oo dhan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}