{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud u tiriyey madaxdii muusikaystayaasha."]},{"type":"verse","number":1,"content":[{"text":"Anigu Rabbigaan isku halleeyaa,","poem":1},{"lineBreak":true},{"text":"Haddaba idinku sidee baad naftayda ugu tidhaahdaan,","poem":1},{"lineBreak":true},{"text":"Sida shimbir oo kale buurtiinnii ku carara?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waayo, bal eega, kuwa sharka lahu waxay xoodaan qaansada,","poem":1},{"lineBreak":true},{"text":"Fallaadhoodana waxay ku diyaariyaan xadhigga,","poem":1},{"lineBreak":true},{"text":"Inay kan qalbiga ka qumman goor gudcur ah ku ganaan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Haddii aasaaska la dumiyo,","poem":1},{"lineBreak":true},{"text":"Kan xaqa ahu bal muxuu samayn karaa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rabbigu wuxuu ku jiraa macbudkiisa quduuska ah,","poem":1},{"lineBreak":true},{"text":"Rabbiga carshigiisu wuxuu yaal samada,","poem":1},{"lineBreak":true},{"text":"Indhihiisu way eegaan, oo indhihiisa daboolkooduna way imtixaamaan binu-aadmiga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rabbigu waa tijaabiyaa kii xaq ah,","poem":1},{"lineBreak":true},{"text":"Laakiinse kii shar leh iyo kii dulmi jecelba naftiisu way neceb tahay.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuwa shar leh wuxuu ku soo kor daadin doonaa dabinno,","poem":1},{"lineBreak":true},{"text":"Oo qaybta koobkooduna waxaa weeye dab iyo baaruud iyo dabayl hanfi ah.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waayo, Rabbigu waa xaq, oo isagu xaqnimaduu jecel yahay,","poem":1},{"lineBreak":true},{"text":"Kuwa qummanuna wejigiisay arki doonaan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}