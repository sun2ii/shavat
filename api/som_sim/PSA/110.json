{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Rabbigu wuxuu Sayidkayga ku yidhi, Midigtayda fadhiiso,","poem":1},{"lineBreak":true},{"text":"Ilaa aan cadaawayaashaada ka dhigo meeshaad cagahaaga saaratid.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rabbigu wuxuu Siyoon ka soo diri doonaa ushii xooggaaga,","poem":1},{"lineBreak":true},{"text":"Cadaawayaashaada dhexdooda ka tali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dadkaagu iyagoo raalli ah bay isbixiyaan maalintii xooggaaga,","poem":1},{"lineBreak":true},{"text":"Iyagoo leh quruxda quduusnimada, ee ka timaada uurka waaberiga,","poem":1},{"lineBreak":true},{"text":"Adigaa leh sayaxa dhallinyaranimadaada.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rabbigu wuu dhaartay, kana soo noqon maayo, oo wuxuu yidhi,","poem":1},{"lineBreak":true},{"text":"Adigu weligaaba wadaad baad tahay,","poem":1},{"lineBreak":true},{"text":"Sidii derejadii Malkisadaq.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sayidka midigtaada joogaa","poem":1},{"lineBreak":true},{"text":"Wuxuu maalinta cadhadiisa dooxi doonaa boqorro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Isagu quruumaha dhexdooda ayuu wax ku xukumi doonaa,","poem":1},{"lineBreak":true},{"text":"Oo meel walba wuxuu ka buuxin doonaa meydad,","poem":1},{"lineBreak":true},{"text":"Oo waddammo badan ayuu madaxda ka dili doonaa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Intuu jidka socdo ayuu durdurka ka cabbi doonaa,","poem":1},{"lineBreak":true},{"text":"Oo sidaas daraaddeed ayuu madaxa kor u qaadi doonaa.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}