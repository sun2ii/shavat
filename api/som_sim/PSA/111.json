{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Rabbiga ammaana.","poem":1},{"lineBreak":true},{"text":"Qalbigayga oo dhan ayaan Rabbiga ugaga mahadnaqi doonaa","poem":1},{"lineBreak":true},{"text":"Guddiga kuwa qumman dhexdiisa iyo ururka dhexdiisaba.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Shuqullada Rabbigu way waaweyn yihiin,","poem":1},{"lineBreak":true},{"text":"Oo waxaa doondoona kuwa ku faraxsan oo dhan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Shuqulkiisu waa sharaf iyo haybad,","poem":1},{"lineBreak":true},{"text":"Oo xaqnimadiisuna weligeedba way waartaa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wuxuu ka dhigay in la sii xusuusto shuqulladiisa yaabka badan,","poem":1},{"lineBreak":true},{"text":"Rabbigu waa nimco miidhan, oo waxaa ka buuxda raxmad.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wuxuu cunto siiyey kuwa isaga ka cabsada,","poem":1},{"lineBreak":true},{"text":"Oo weligiisna wuxuu xusuusnaan doonaa axdigiisii.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wuxuu dadkiisii tusay xooggii shuqulladiisa,","poem":1},{"lineBreak":true},{"text":"Markii uu iyaga siiyey quruumaha dhaxalkoodii.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Shuqullada gacmihiisu waa run iyo garsoorid,","poem":1},{"lineBreak":true},{"text":"Oo amarradiisa oo dhammuna waa hubaal.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Way sii adag yihiin weligood iyo weligoodba,","poem":1},{"lineBreak":true},{"text":"Oo waxaa lagu sameeyey run iyo qummanaan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wuxuu dadkiisa u soo diray furasho,","poem":1},{"lineBreak":true},{"text":"Oo wuxuu amray in axdigiisu ahaado mid weligiisba waara,","poem":1},{"lineBreak":true},{"text":"Magiciisu waa quduus, waana mid laga cabsado.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rabbiga ka cabsashadiisu waa bilowga xigmadda,","poem":1},{"lineBreak":true},{"text":"Kuwa sidaas yeela oo dhammu waxay leeyihiin waxgarasho wanaagsan,","poem":1},{"lineBreak":true},{"text":"Ammaantiisu way waartaa weligeedba.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}