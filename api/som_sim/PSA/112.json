{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Rabbiga ammaana.","poem":1},{"lineBreak":true},{"text":"Waxaa barakaysan ninkii Rabbiga ka cabsada,","poem":1},{"lineBreak":true},{"text":"Oo aad ugu farxa amarradiisa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Farcankiisu wuxuu ku xoog badnaan doonaa dhulka,","poem":1},{"lineBreak":true},{"text":"Kuwa qumman farcankooduna wuu barakoobi doonaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gurigiisa waxaa ku jira maal iyo taajirnimo,","poem":1},{"lineBreak":true},{"text":"Xaqnimadiisuna weligeedba way sii waartaa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuwa qumman iftiin baa gudcurka uga soo baxa,","poem":1},{"lineBreak":true},{"text":"Isagu waa nimco miidhan, oo waxaa ka buuxda raxmad, waana xaq.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waxaa nimcaysan ninkii naxariis leh oo dadka wax amaahiya,","poem":1},{"lineBreak":true},{"text":"Kaasu danihiisuu ku wadi doonaa caddaalad.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waayo, isaga weligiis lama dhaqaajin doono,","poem":1},{"lineBreak":true},{"text":"Oo kii xaq ah weligiisba waa la xusuusan doonaa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Isagu innaba kama cabsan doono war xun,","poem":1},{"lineBreak":true},{"text":"Qalbigaa u fadhiya, oo wuxuu isku halleeyaa Rabbiga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qalbigaa u fadhiya, oo ma uu cabsan doono,","poem":1},{"lineBreak":true},{"text":"Ilaa uu wuxuu doonayay ku arko cadaawayaashiisa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wax buu kala qaybshay, oo wuxuu wax siiyey kuwii baahnaa,","poem":1},{"lineBreak":true},{"text":"Xaqnimadiisuna way sii waartaa weligeedba,","poem":1},{"lineBreak":true},{"text":"Geeskiisana waxaa lagu sarraysiin doonaa sharaf.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kii shar lahu wuu arki doonaa, wuuna cadhoon doonaa,","poem":1},{"lineBreak":true},{"text":"Wuu ilko jirriqsan doonaa, oo wuu dhalaali doonaa,","poem":1},{"lineBreak":true},{"text":"Kuwa sharka leh doonistoodu way baabbi'i doontaa.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}