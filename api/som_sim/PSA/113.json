{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Rabbiga ammaana.","poem":1},{"lineBreak":true},{"text":"Rabbiga addoommadiisow, ammaana.","poem":1},{"lineBreak":true},{"text":"Rabbiga magiciisa ammaana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hadda intii ka bilaabata iyo tan iyo weligeedba","poem":1},{"lineBreak":true},{"text":"Rabbiga magiciisu mahad ha lahaado.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Qorraxdu markay soo baxdo iyo markay dhacdo inta ka dhex leh","poem":1},{"lineBreak":true},{"text":"Magaca Rabbiga waa in la ammaano.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rabbigu quruumaha oo dhan wuu ka wada sarreeyaa,","poem":1},{"lineBreak":true},{"text":"Ammaantiisuna samooyinka way ka sii sarraysaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bal yaa la mid ah Rabbiga Ilaaheenna ah,","poem":1},{"lineBreak":true},{"text":"Oo kursigiisa ku leh xagga sare,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oo hoos u eega","poem":1},{"lineBreak":true},{"text":"Waxyaalaha samada ku jira iyo waxyaalaha dhulka yaalba?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wuxuu miskiinka kor uga qaadaa ciidda,","poem":1},{"lineBreak":true},{"text":"Oo kan baahanna wuxuu sara uga qaadaa meesha digada,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Inuu isaga la fadhiisiyo amiirro,","poem":1},{"lineBreak":true},{"text":"Kuwaas oo ah amiirrada dadkiisa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Oo naagtii madhalays ahna wuxuu ka dhigaa inay reer hayso,","poem":1},{"lineBreak":true},{"text":"Iyo inay ahaato hooyo faraxsan oo carruur leh.","poem":1},{"lineBreak":true},{"text":"Rabbiga ammaana.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}