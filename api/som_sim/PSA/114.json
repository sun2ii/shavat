{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Markay reer binu Israa'iil Masar ka soo bexeen,","poem":1},{"lineBreak":true},{"text":"Oo ay reerkii Yacquub dad af qalaad ka soo bexeen,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ayaa Yahuudah noqday meeshiisa quduuska ah,","poem":1},{"lineBreak":true},{"text":"Israa'iilna noqday meeshuu u talinayay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Baddii way aragtay, wayna carartay,","poem":1},{"lineBreak":true},{"text":"Webi Urdunna dib baa loo celiyey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buurihii waxay u boodboodeen sidii wanan,","poem":1},{"lineBreak":true},{"text":"Kurihiina sidii baraar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Baddoy, bal maxaa kugu dhacay oo aad u cararaysaa?","poem":1},{"lineBreak":true},{"text":"Webi Urdunow, maxaad dib ugu noqonaysaa?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buurahow, bal maxaad ugu boodboodaysaan sida wanan?","poem":1},{"lineBreak":true},{"text":"Kuraha yaryarow, bal maxaad ugu boodboodaysaan sida baraar?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dhulkow, ku gariir Sayidka hortiisa,","poem":1},{"lineBreak":true},{"text":"Ilaaha reer Yacquub hortiisa ku gariir,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kaas oo dhagaxii u beddelay balli biyo ah,","poem":1},{"lineBreak":true},{"text":"Oo dhagaxmadowgiina u beddelay il biyo ah.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}