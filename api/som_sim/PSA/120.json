{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["Gabayga meelokoridda."]},{"type":"verse","number":1,"content":[{"text":"Anigoo cidhiidhi ku jira ayaan Rabbiga u qayshaday,","poem":1},{"lineBreak":true},{"text":"Oo isna wuu ii jawaabay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rabbiyow, naftayda ka samatabbixi bushimo been sheega,","poem":1},{"lineBreak":true},{"text":"Iyo carrab khiyaano badan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Carrabka khiyaanada badanow, bal maxaa lagu siin doonaa?","poem":1},{"lineBreak":true},{"text":"Oo maxaa kaloo laguu samayn doonaa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adoo ah sida ku xoog badan oo fallaadhihiisa afaysan,","poem":1},{"lineBreak":true},{"text":"Kuwaas oo wata dhuxulo geed rotem la yidhaahdo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Anaa hoogay, waayo, Mesheg baan qariib ku noqday,","poem":1},{"lineBreak":true},{"text":"Oo waxaan dhex degay teendhooyinkii Qedaar!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Naftaydu waxay wakhti dheer la degganayd","poem":1},{"lineBreak":true},{"text":"Mid nabadda neceb.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waxaan ahay mid nabad jecel,","poem":1},{"lineBreak":true},{"text":"Laakiinse kolkii aan hadlo, iyagu waa kuwa dagaal jecel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}