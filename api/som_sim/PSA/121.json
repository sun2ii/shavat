{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"heading","content":["Gabayga meelokoridda."]},{"type":"verse","number":1,"content":[{"text":"Buurahaan indhahayga ku taagi doonaa,","poem":1},{"lineBreak":true},{"text":"Caawimaaddaydu xaggee bay ka iman doontaa?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Caawimaaddaydu waxay ka timaadaa","poem":1},{"lineBreak":true},{"text":"Rabbiga sameeyey samada iyo dhulka.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Isagu uma oggolaan doono in cagtaada la dhaqaajiyo,","poem":1},{"lineBreak":true},{"text":"Kan ku dhawraa ma gam'i doono.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bal eeg, kan reer binu Israa'iil dhawraa","poem":1},{"lineBreak":true},{"text":"Ma gam'i doono, mana seexan doono.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kan ku dhawraa waa Rabbiga,","poem":1},{"lineBreak":true},{"text":"Rabbigu waa hooskaaga midigtaada taagan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qorraxdu maalinta waxba kuma yeeli doonto.","poem":1},{"lineBreak":true},{"text":"Habeenkana dayaxu waxba kuma yeeli doono.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rabbiga ayaa kaa dhawri doona shar kasta,","poem":1},{"lineBreak":true},{"text":"Isagu wuxuu dhawri doonaa naftaada.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hadda intii ka bilaabata iyo tan iyo weligeedba","poem":1},{"lineBreak":true},{"text":"Rabbigu wuxuu dhawri doonaa bixiddaada iyo soo geliddaadaba.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}