{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["Gabayga meelokoridda oo Daa'uud tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Waan farxay markay igu yidhaahdeen,","poem":1},{"lineBreak":true},{"text":"Ina keena, aan guriga Rabbiga tagnee.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yeruusaalemay, cagahayagu","poem":1},{"lineBreak":true},{"text":"Waxay taagan yihiin irdahaaga gudahooda,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yeruusaalem waxaa loo dhisay","poem":1},{"lineBreak":true},{"text":"Sida magaalo isku wada dheggan,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Halkaasay qabiilooyinka, oo ah qabiilooyinka Rabbigu kor ugu baxaan","poem":1},{"lineBreak":true},{"text":"Inay Israa'iil u marag furaan,","poem":1},{"lineBreak":true},{"text":"Iyo inay magaca Rabbiga ku mahadnaqaan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waayo, waxaa yaalla carshiyo garsoorid loo dhigay,","poem":1},{"lineBreak":true},{"text":"Waana carshiyadii reerka Daa'uud.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yeruusaalem nabad ugu duceeya.","poem":1},{"lineBreak":true},{"text":"Kuwa ku jecelu way barwaaqoobi doonaan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nabadu ha ku jirto derbiyadaada gudahooda,","poem":1},{"lineBreak":true},{"text":"Barwaaqona ha ku jirto daarahaaga dhaadheer.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Walaalahay iyo rafiiqyadayda daraaddood","poem":1},{"lineBreak":true},{"text":"Ayaan hadda waxaan odhanayaa, Nabadu gudahaaga ha ku jirto.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rabbiga Ilaahayaga gurigiisa daraaddiis","poem":1},{"lineBreak":true},{"text":"Ayaan wanaaggaaga u doondooni doonaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}