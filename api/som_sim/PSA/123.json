an","poem":1},{"lineBreak":true},{"text":"Iyo quudhsashadii kuwa kibirsan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}