{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"heading","content":["Gabayga meelokoridda oo Daa'uud tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Haddaan Rabbigu inala jirin","poem":1},{"lineBreak":true},{"text":"Hadda reer binu Israa'iil ha yidhaahdeen,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Haddaan Rabbigu inala jirin,","poem":1},{"lineBreak":true},{"text":"Markii dadku inagu kacay,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kolkaasay innagoo noolnool ina wada liqliqi lahaayeen,","poem":1},{"lineBreak":true},{"text":"Markay aad inoogu cadhoodeen,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kolkaasay biyuhu ina qarqin lahaayeen,","poem":1},{"lineBreak":true},{"text":"Durdurna nafteennuu dul mari lahaa,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oo kolkaasay biyaha kibirsanu nafteenna dul mari lahaayeen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waxaa mahad leh Rabbiga","poem":1},{"lineBreak":true},{"text":"Aan inaga dhigin ugaadh ilkahoodu ay qabsadaan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nafteennu waxay u baxsatay sida shimbir uga baxsato dabinka shimbirrodabtaha,","poem":1},{"lineBreak":true},{"text":"Dabinkii wuu go'ay, innaguna waynu baxsannay.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Caawimaaddeennu waxay ku jirtaa magaca Rabbiga","poem":1},{"lineBreak":true},{"text":"Sameeyey samada iyo dhulkaba.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}