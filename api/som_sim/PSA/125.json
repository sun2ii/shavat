{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["Gabayga meelokoridda."]},{"type":"verse","number":1,"content":[{"text":"Kuwa Rabbiga isku halleeyaa","poem":1},{"lineBreak":true},{"text":"Waa sida Buur Siyoon oo aan la dhaqaajin karin, laakiinse weligeedba sii jirta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sida buuruhu Yeruusaalem ugu wareegsan yihiin","poem":1},{"lineBreak":true},{"text":"Ayuu Rabbigu dadkiisa ugu wareegsan yahay,","poem":1},{"lineBreak":true},{"text":"Hadda intii ka bilaabata iyo tan iyo weligeedba.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Waayo, usha xumaantu ku dhici mayso qaybta kuwa xaqa ah,","poem":1},{"lineBreak":true},{"text":"Si aan kuwa xaqa ahu gacmahooda xumaan ugu soo fidin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rabbiyow, kuwa wanaagsan wanaag u samee,","poem":1},{"lineBreak":true},{"text":"Iyo weliba kuwa qalbigoodu qumman yahay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Laakiinse kuwa geesta ugu leexda jidadkooda qalloocan","poem":1},{"lineBreak":true},{"text":"Rabbigu wuxuu iyaga la kaxayn doonaa xumaanfalayaasha.","poem":1},{"lineBreak":true},{"text":"Reer binu Israa'iil korkooda nabadu ha ahaato.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}