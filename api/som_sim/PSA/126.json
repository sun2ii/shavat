{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["Gabayga meelokoridda."]},{"type":"verse","number":1,"content":[{"text":"Markii Rabbigu soo celiyey maxaabiistii Siyoon,","poem":1},{"lineBreak":true},{"text":"Waxaynu noqonnay sida kuwa riyooda.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Markaasaa afkeenna waxaa ka buuxsamay qosol,","poem":1},{"lineBreak":true},{"text":"Carrabkeennana gabay,","poem":1},{"lineBreak":true},{"text":"Kolkaasaa quruumaha waxaa laga dhex yidhi,","poem":1},{"lineBreak":true},{"text":"Rabbigu waxyaalo waaweyn ayuu iyaga u sameeyey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rabbigu wuxuu inoo sameeyey waxyaalo waaweyn,","poem":1},{"lineBreak":true},{"text":"Oo aynu ku faraxsan nahay.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rabbiyow, maxaabiisnimada mar kale nooga soo celi","poem":1},{"lineBreak":true},{"text":"Sida durdurrada koonfureed.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuwa ilmada wax ku abuurtaa, farxad bay ku goosan doonaan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kii iska taga isagoo ooyaya oo abuurkiisa sita,","poem":1},{"lineBreak":true},{"text":"Wuxuu soo noqon doonaa isagoo faraxsan oo xidhmooyinkiisa sita.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}