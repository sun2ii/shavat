{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"heading","content":["Gabayga meelokoridda oo Sulaymaan tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Haddaan Rabbigu guriga dhisin,","poem":1},{"lineBreak":true},{"text":"Kuwa dhisaya, waxtarla'aan bay u hawshoodaan,","poem":1},{"lineBreak":true},{"text":"Haddaan Rabbigu magaalada dhawrin,","poem":1},{"lineBreak":true},{"text":"Waardiyuhu micnela'aan buu u soo jeedaa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Faa'iido idiinma leh inaad aroor hore kacdaan oo aad goor dambe seexataan,","poem":1},{"lineBreak":true},{"text":"Oo aad kibista dhibka cuntaan,","poem":1},{"lineBreak":true},{"text":"Waayo, wuxuu kuwuu jecel yahay siiyaa hurdo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bal eeg, carruurtu waa dhaxal xagga Rabbiga laga helo.","poem":1},{"lineBreak":true},{"text":"Oo midhaha maxalku waa abaalgudkiisa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sida fallaadho ku jira nin xoog badan gacantiis,","poem":1},{"lineBreak":true},{"text":"Sidaasoo kale weeye carruurta dhallinyaranimadu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waxaa barakaysan ninkii gabooyihiisa ka buuxsada iyaga,","poem":1},{"lineBreak":true},{"text":"Iyagu ma ay ceeboobi doonaan","poem":1},{"lineBreak":true},{"text":"Markay cadaawayaashooda kula hadlaan xagga iridda.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}