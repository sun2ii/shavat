{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"heading","content":["Gabayga meelokoridda."]},{"type":"verse","number":1,"content":[{"text":"Waxaa barakaysan mid kasta oo Rabbiga ka cabsada,","poem":1},{"lineBreak":true},{"text":"Oo jidadkiisa ku socda.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waayo, waad cuni doontaa waxa gacmahaagu ku hawshoodeen,","poem":1},{"lineBreak":true},{"text":"Waadna farxi doontaa, oo waad barwaaqoobi doontaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Naagtaadu waxay gurigaaga ku dhex ahaan doontaa sida geed canab ah oo midho badan dhala.","poem":1},{"lineBreak":true},{"text":"Carruurtaaduna waxay noqon doonaan sida geedo saytuun ah oo miiskaaga ku wareegsan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bal eeg, sidaasuu u barakoobi doonaa","poem":1},{"lineBreak":true},{"text":"Ninka Rabbiga ka cabsadaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rabbigu Siyoon buu kaa barakayn doonaa,","poem":1},{"lineBreak":true},{"text":"Oo cimrigaaga oo dhan waxaad arki doontaa wanaagga Yeruusaalem.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Haah, oo waxaad arki doontaa carruurtaada carruurtooda.","poem":1},{"lineBreak":true},{"text":"Reer binu Israa'iil korkooda nabadu ha ahaato.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}