{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["Gabayga meelokoridda."]},{"type":"verse","number":1,"content":[{"text":"Tan iyo yaraantaydii marar badan bay i dhibeen,","poem":1},{"lineBreak":true},{"text":"Reer binu Israa'iil hadda ha yidhaahdeen,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tan iyo yaraantaydii marar badan bay i dhibeen,","poem":1},{"lineBreak":true},{"text":"Laakiinse igama ay adkaan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuwa beerta jeexa ayaa dhabarkayga jeexay,","poem":1},{"lineBreak":true},{"text":"Oo jeexjeexoodiina way dheereeyeen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rabbigu waa xaq,","poem":1},{"lineBreak":true},{"text":"Oo isagu wuxuu kala gooyay xadhkihii kuwa sharka leh.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inta Siyoon neceb oo dhammu,","poem":1},{"lineBreak":true},{"text":"Ha ceeboobeen oo dib ha u noqdeen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ha noqdeen sida cawska guryaha korkooda ka baxa","poem":1},{"lineBreak":true},{"text":"Oo engega intaanu korin,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oo aan beergooyuhu gacantiisa ka buuxin,","poem":1},{"lineBreak":true},{"text":"Kan xidhmooyinka xidhaana aanu laabtiisa ka buuxin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Oo kuwa ag maraana ma yidhaahdaan,","poem":1},{"lineBreak":true},{"text":"Barakadii Rabbigu korkiinna ha ahaato.","poem":1},{"lineBreak":true},{"text":"Waxaan idiinku ducaynaynaa magaca Rabbiga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}