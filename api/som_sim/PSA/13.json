{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud u tiriyey madaxdii muusikaystayaasha."]},{"type":"verse","number":1,"content":[{"text":"Rabbiyow, ilaa goormaad i illoobaysaa? Ma weligaa baa?","poem":1},{"lineBreak":true},{"text":"Oo ilaa goormaad wejigaaga iga qarinaysaa?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ilaa goormaan naftayda la tashanayaa,","poem":1},{"lineBreak":true},{"text":"Anigoo maalinta oo dhan calool xun?","poem":1},{"lineBreak":true},{"text":"Ilaa goormuu cadowgaygu iga sarraynayaa?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rabbiyow Ilaahayow, waxaas u fiirso, oo ii jawaab,","poem":1},{"lineBreak":true},{"text":"Indhahayga iftiimi, yaanan hurdadii geerida seexanine,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waaba intaasoo cadowgaygu yidhaahdaa, Anigu isagaan ka adkaaday,","poem":1},{"lineBreak":true},{"text":"Oo ay cadaawayaashaydu farxaan markii lay dhaqaajiyo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Laakiinse anigu waxaan isku halleeyey naxariistaada,","poem":1},{"lineBreak":true},{"text":"Oo qalbigayguna wuxuu ku rayrayn doonaa badbaadintaada.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rabbigaan u gabyi doonaa,","poem":1},{"lineBreak":true},{"text":"Maxaa yeelay, wax badan oo wanaagsan buu ii sameeyey.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}