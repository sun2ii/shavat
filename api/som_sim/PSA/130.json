{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["Gabayga meelokoridda."]},{"type":"verse","number":1,"content":[{"text":"Rabbiyow, waxaan kaaga qayshaday moolalka.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sayidow, codkayga maqal,","poem":1},{"lineBreak":true},{"text":"Oo dhegahaagu ha noqdeen kuwo u digtoon","poem":1},{"lineBreak":true},{"text":"Codka baryootankayga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rabbiyow, haddaad dembiyada u fiirsatid,","poem":1},{"lineBreak":true},{"text":"Bal yaa istaagi doona, Sayidow?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Laakiinse waxaa kula jirta dembidhaafid,","poem":1},{"lineBreak":true},{"text":"In adiga lagaa cabsado daraaddeed.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waxaan sugaa Rabbiga,","poem":1},{"lineBreak":true},{"text":"Naftayduna way sugtaa, oo eraygiisa ayaan rajo ku qabaa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Naftaydu waxay Sayidka u dhawrtaa","poem":1},{"lineBreak":true},{"text":"In ka sii badan sida waardiyuhu u dhawro waaga berigiisa,","poem":1},{"lineBreak":true},{"text":"Haah, in ka sii badan sida waardiyuhu u dhawro waaga berigiisa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Reer binu Israa'iilow, Rabbiga rajo ku qaba,","poem":1},{"lineBreak":true},{"text":"Waayo, Rabbigu wuxuu leeyahay naxariis","poem":1},{"lineBreak":true},{"text":"Iyo weliba furasho aad iyo aad u badan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Oo wuxuu reer binu Israa'iil ka soo furan doonaa","poem":1},{"lineBreak":true},{"text":"Dembiyadooda oo dhan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}