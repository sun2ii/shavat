{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":131,"content":[{"type":"heading","content":["Gabayga meelokoridda oo Daa'uud tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Rabbiyow, qalbigaygu kor isuma qaado, indhahayguna ma kibirsana,","poem":1},{"lineBreak":true},{"text":"Oo anna iskuma dhex tuuro axwaal waaweyn,","poem":1},{"lineBreak":true},{"text":"Ama waxyaalihii igu yaab badan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hubaal naftaydii waan dejiyey, oo waan xasilliyey,","poem":1},{"lineBreak":true},{"text":"Sida ilmo naas laga gudhiyey oo hooyadiis la jooga,","poem":1},{"lineBreak":true},{"text":"Naftaydu waxay iigu jirtaa sida ilmo naas laga gudhiyey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Reer binu Israa'iilow, Rabbiga rajo ku qaba,","poem":1},{"lineBreak":true},{"text":"Haddeer intii laga bilaabo iyo tan iyo weligiinba.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}