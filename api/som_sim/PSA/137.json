{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Waxaannu ag fadhiisannay webiyaashii Baabuloon,","poem":1},{"lineBreak":true},{"text":"Oo waannu ooynay markii aannu Siyoon soo xusuusannay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oo waxaannu kataaradahayagii sudhannay geedaha safsaafkaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Waayo, kuwii maxaabiis ahaanta noo watay ayaa halkaas gabayo nagu weyddiistay,","poem":1},{"lineBreak":true},{"text":"Oo kuwii na silciyey ayaa farxad na weyddiistay, oo waxay nagu yidhaahdeen,","poem":1},{"lineBreak":true},{"text":"Noogu gabya gabayadii Siyoon midkood.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bal sidee baannu gabaygii Rabbiga ugu gabaynaa","poem":1},{"lineBreak":true},{"text":"Dal qalaad dhexdiis?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yeruusaalemay, haddaan ku illoobo,","poem":1},{"lineBreak":true},{"text":"Gacantayda midig ha illowdo sancadeedii.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Carrabkayguna ha ku dhego dhanxanagga afkayga,","poem":1},{"lineBreak":true},{"text":"Haddaanan ku xusuusan,","poem":1},{"lineBreak":true},{"text":"Iyo haddaanan Yeruusaalem ka sii jeclaan","poem":1},{"lineBreak":true},{"text":"Farxaddayda ugu weyn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rabbiyow, soo xusuuso reer Edom,","poem":1},{"lineBreak":true},{"text":"Kuwaasoo maalintii Yeruusaalem yidhi,","poem":1},{"lineBreak":true},{"text":"Dumiya, dumiya, tan iyo aasaaskeeda.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gabadha Baabuloonay, waa lagu baabbi'in doonaa,","poem":1},{"lineBreak":true},{"text":"Waxaa faraxsanaan doona kii kaa abaalmariya","poem":1},{"lineBreak":true},{"text":"Sidii aad nagu samaysay.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Waxaa faraxsanaan doona kii dhallaankaaga qabsada","poem":1},{"lineBreak":true},{"text":"Oo dhagaxa weyn ku dul tuura.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}