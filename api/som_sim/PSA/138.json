{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Qalbigayga oo dhan ayaan kugu mahadnaqi doonaa,","poem":1},{"lineBreak":true},{"text":"Oo ilaahyada hortooda ayaan ammaan kuugu gabyi doonaa,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waxaan u soo tukan doonaa macbudkaaga quduuska ah xaggiisa,","poem":1},{"lineBreak":true},{"text":"Oo magacaagana waxaan ugu mahadnaqi doonaa raxmaddaada iyo runtaada aawadood,","poem":1},{"lineBreak":true},{"text":"Waayo, eraygaaga ayaad ka sii weynaysay magacaaga oo dhan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maalintii aan qayshaday waad ii jawaabtay,","poem":1},{"lineBreak":true},{"text":"Waanad igu kalsooni gelisay xooggii aad naftayda u yeeshay.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rabbiyow, boqorrada dhulka jooga oo dhammu way kugu mahadnaqi doonaan,","poem":1},{"lineBreak":true},{"text":"Waayo, waxay maqlaan erayada afkaaga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Haah, way ka gabyi doonaan jidadka Rabbiga,","poem":1},{"lineBreak":true},{"text":"Waayo, ammaanta Rabbigu waa weyn tahay.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waayo, in kastoo Rabbigu sarreeyo, haddana wuu fiiriyaa kuwa hooseeya,","poem":1},{"lineBreak":true},{"text":"Laakiinse kan kibra meel fog buu ka yaqaan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"In kastoo aan ku dhex socdo dhibaato waad i soo noolayn doontaa,","poem":1},{"lineBreak":true},{"text":"Oo waxaad gacantaada ku soo fidin doontaa cadhada cadaawayaashayda,","poem":1},{"lineBreak":true},{"text":"Oo gacantaada midigna way i badbaadin doontaa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rabbigaa kaamil ka dhigi doona waxa igu saabsan,","poem":1},{"lineBreak":true},{"text":"Rabbiyow, naxariistaadu weligeedba way sii waartaa,","poem":1},{"lineBreak":true},{"text":"Ha ka tegin shuqulladii gacmahaaga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}