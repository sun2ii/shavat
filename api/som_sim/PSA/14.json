{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud u tiriyey madaxdii muusikaystayaasha."]},{"type":"verse","number":1,"content":[{"text":"Nacasku wuxuu qalbigiisa iska yidhaahdaa, Ilaah ma jiro.","poem":1},{"lineBreak":true},{"text":"Iyagu way kharriban yihiin, oo waxay sameeyeen shuqullo karaahiyo ah,","poem":1},{"lineBreak":true},{"text":"Ma jiro mid wanaag sameeya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rabbigu samaduu ka soo fiiriyey binu-aadmiga,","poem":1},{"lineBreak":true},{"text":"Inuu arko haddii ay jiraan kuwo wax garanaya,","poem":1},{"lineBreak":true},{"text":"Oo Ilaah doondoona.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dhammaantood gees bay u wada leexdeen, oo way wada nijaasoobeen,","poem":1},{"lineBreak":true},{"text":"Mid wanaag falaa ma jiro, midnaba.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xumaanfalayaasha oo dhammu miyaanay aqoon lahayn?","poem":1},{"lineBreak":true},{"text":"Iyagoo dadkayga cuna, siday kibista u cunaan,","poem":1},{"lineBreak":true},{"text":"Mana ay baryaan Rabbiga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Halkaasay aad ugu cabsadeen,","poem":1},{"lineBreak":true},{"text":"Maxaa yeelay, Ilaah wuxuu la jiraa qarniga xaqa ah.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Idinku waxaad ceebaysaan talada miskiinka,","poem":1},{"lineBreak":true},{"text":"Laakiin Rabbigu waa magangalkiisa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Badbaadada reer binu Israa'iil bal may Siyoon ka timaado!","poem":1},{"lineBreak":true},{"text":"Marka Rabbigu dadkiisa maxaabiisnimada ka soo celiyo,","poem":1},{"lineBreak":true},{"text":"Ayaa reer Yacquub rayrayn doonaa, oo reer binu Israa'iilna farxi doonaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}