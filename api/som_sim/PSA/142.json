{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"heading","content":["Kanu waa baryootan Maskiil ah ee Daa'uud tiriyey markuu godkii ku jiray."]},{"type":"verse","number":1,"content":[{"text":"Anigu codkaygaan Rabbiga ugu qayshadaa,","poem":1},{"lineBreak":true},{"text":"Oo codkaygaan Rabbiga ku baryaa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oo hortiisaan ku cawdaa,","poem":1},{"lineBreak":true},{"text":"Oo dhibaatadaydana hortiisaan ku muujiyaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Markii naftaydu gudahayga ku itaal darnaatay, waddadayda waad tiqiin,","poem":1},{"lineBreak":true},{"text":"Jidka aan ku socdona dabin bay iigu qariyeen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bal fiiri xaggayga midig, oo bal arag,","poem":1},{"lineBreak":true},{"text":"Waayo, nin i yaqaan ma jiro,","poem":1},{"lineBreak":true},{"text":"Meel aan magangalo ayaan waayay, ninna naftayda dan kama leh.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rabbiyow, adigaan kuu qayshaday,","poem":1},{"lineBreak":true},{"text":"Oo waxaan idhi, Waxaad tahay magangalkayga,","poem":1},{"lineBreak":true},{"text":"Iyo qaybta aan dalka kuwa nool ku leeyahay.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qayladayda dhegayso, waayo, aad baa hoos laygu dejiyey,","poem":1},{"lineBreak":true},{"text":"Kuwa i silciya iga samatabbixi, waayo, iyagu way iga xoog badan yihiin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Naftayda xabsiga ka soo bixi, si aan magacaaga ugu mahadnaqo,","poem":1},{"lineBreak":true},{"text":"Kuwa xaqa ah ayaa igu hareeraysnaan doona,","poem":1},{"lineBreak":true},{"text":"Waayo, wax badan oo wanaagsan baad ii samayn doontaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}