{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Rabbiga ammaana.","poem":1},{"lineBreak":true},{"text":"Naftaydoy, Rabbiga ammaan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Intaan noolahay oo dhan Rabbiga waan ammaani doonaa,","poem":1},{"lineBreak":true},{"text":"Oo ammaan baan Ilaahay ugu gabyi doonaa intaan jiro oo dhan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ha isku hallaynina amiirrada","poem":1},{"lineBreak":true},{"text":"Iyo binu-aadmiga aan waxba caawimi karin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Naftiisu way ka baxdaa, oo wuxuu ku noqdaa dhulkiisii.","poem":1},{"lineBreak":true},{"text":"Oo isla maalintaas ayaa fikirradiisu baabba'aan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waxaa faraxsan ninkii ay caawimaaddiisu tahay Ilaaha reer Yacquub,","poem":1},{"lineBreak":true},{"text":"Oo rajadiisuna ay ku xidhan tahay Rabbiga Ilaahiisa ah,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oo sameeyey cirka iyo dhulka,","poem":1},{"lineBreak":true},{"text":"Iyo badda iyo waxyaalaha ku jira oo dhan,","poem":1},{"lineBreak":true},{"text":"Oo runtana dhawra weligiisba,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oo kuwa la dulmay u garsoora,","poem":1},{"lineBreak":true},{"text":"Oo kuwa gaajaysanna quud siiya.","poem":1},{"lineBreak":true},{"text":"Rabbigu maxaabiistuu furaa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rabbigu indhahuu u bixiyaa indhoolayaasha,","poem":1},{"lineBreak":true},{"text":"Oo kuwa gotana Rabbigaa toosiya,","poem":1},{"lineBreak":true},{"text":"Oo kuwa xaqa ahna Rabbigu waa jecel yahay.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rabbigu waa ilaaliyaa kuwa qariibka ah,","poem":1},{"lineBreak":true},{"text":"Oo isagaa taageera agoonta iyo carmallada,","poem":1},{"lineBreak":true},{"text":"Laakiinse jidka kuwa sharka leh wuu qalloociyaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rabbigu xukun buu haysan doonaa weligiis,","poem":1},{"lineBreak":true},{"text":"Siyoonay, Ilaahaagaa boqor ah tan iyo ab ka ab.","poem":1},{"lineBreak":true},{"text":"Rabbiga ammaana.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}