{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Rabbiga ammaana.","poem":1},{"lineBreak":true},{"text":"Waayo, way wanaagsan tahay in Ilaaheenna ammaan loogu gabyo,","poem":1},{"lineBreak":true},{"text":"Waayo, taasu way wacan tahay, oo ammaantuna way habboon tahay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rabbigu Yeruusaalem buu dhisaa,","poem":1},{"lineBreak":true},{"text":"Oo wuxuu isu soo wada ururiyaa kuwa la naco oo reer binu Israa'iil ah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Isagaa bogsiiya kuwa qalbi jabay,","poem":1},{"lineBreak":true},{"text":"Oo nabrahoodana wuu duubaa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wuxuu sheegaa xiddigaha tiradooda,","poem":1},{"lineBreak":true},{"text":"Oo kulligoodna magacyo buu u bixiyaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sayidkeennu waa weyn yahay, wuuna xoog badan yahay,","poem":1},{"lineBreak":true},{"text":"Waxgarashadiisuna waa mid aan la koobi karayn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rabbigu wuu tiiriyaa kuwa camalka qabow,","poem":1},{"lineBreak":true},{"text":"Oo kuwa sharka lehna dhulkuu ku soo tuuraa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rabbiga mahadnaqid ugu gabya,","poem":1},{"lineBreak":true},{"text":"Oo kataaradda ammaan ugu gabya Ilaaheenna,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kaasoo samada daruuro ku qariya,","poem":1},{"lineBreak":true},{"text":"Oo dhulka roob u diyaarsha,","poem":1},{"lineBreak":true},{"text":"Buurahana doog ka soo bixiya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wuxuu quud siiyaa xayawaanka,","poem":1},{"lineBreak":true},{"text":"Iyo tukayaasha yaryar markay qayliyaanba.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Isagu kuma farxo xoogga faraska,","poem":1},{"lineBreak":true},{"text":"Oo kuma reyreeyo lugaha dadka.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rabbigu wuxuu ku reyreeyaa kuwa isaga ka cabsada,","poem":1},{"lineBreak":true},{"text":"Iyo kuwa naxariistiisa rajada ka qaba.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yeruusaalemay, Rabbiga ammaan,","poem":1},{"lineBreak":true},{"text":"Siyoonay, Ilaahaaga ammaan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Waayo, wuxuu xoogeeyey qataarrada irdahaaga,","poem":1},{"lineBreak":true},{"text":"Carruurtaadana wuu kugu dhex barakeeyey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Soohdimahaaga nabad buu ka dhigaa,","poem":1},{"lineBreak":true},{"text":"Oo wuxuu kaa dhergiyaa sarreenka ugu wanaagsan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Amarkiisa wuxuu u soo diraa dhulka,","poem":1},{"lineBreak":true},{"text":"Eraygiisuna aad buu u dheereeyaa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Baraf cad wuxuu u soo daadshaa sida dhogor oo kale,","poem":1},{"lineBreak":true},{"text":"Sayax barafoobayna wuxuu u kala firdhiyaa sida dambas oo kale.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Barafkiisa wuxuu u soo ridaa sida jajab oo kale,","poem":1},{"lineBreak":true},{"text":"Bal yaa qabowgiisa hor istaagi kara?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wuxuu soo diraa eraygiisa, oo wuu dhalaaliyaa iyaga,","poem":1},{"lineBreak":true},{"text":"Dabayshiisana wuxuu ka dhigaa inay dhacdo, biyuhuna way qulqulaan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Eraygiisa wuxuu tusaa reer Yacquub,","poem":1},{"lineBreak":true},{"text":"Qaynuunnadiisa iyo xukummadiisana reer binu Israa'iil.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Quruunna sidaas oo kale uma uu samayn.","poem":1},{"lineBreak":true},{"text":"Xukummadiisiina ma ay garanaynin,","poem":1},{"lineBreak":true},{"text":"Rabbiga ammaana.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}