{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Rabbiga ammaana.","poem":1},{"lineBreak":true},{"text":"Rabbiga samooyinka ka ammaana,","poem":1},{"lineBreak":true},{"text":"Meelaha sarsarena ka ammaana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Malaa'igihiisa oo dhammow, ammaana isaga,","poem":1},{"lineBreak":true},{"text":"Ciidankiisa oo dhammow, ammaana isaga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Qorraxda iyo dayaxow, ammaana isaga,","poem":1},{"lineBreak":true},{"text":"Xiddigaha iftiinka oo dhammow, ammaana isaga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ammaana isaga, samooyinka samooyinkow,","poem":1},{"lineBreak":true},{"text":"Iyo biyaha samooyinka ka sarreeyow.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Iyagu magaca Rabbiga ha ammaaneen,","poem":1},{"lineBreak":true},{"text":"Waayo, isagu wuu amray, oo iyana way abuurmeen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oo weliba isagaa adkeeyey iyaga weligood iyo weligoodba,","poem":1},{"lineBreak":true},{"text":"Oo wuxuu sameeyey xad aan la gudbi doonayn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rabbiga dhulka ka ammaana,","poem":1},{"lineBreak":true},{"text":"Masbadeedyo iyo moolal oo dhammow,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dab iyo roobdhagaxyaale, baraf cad iyo ceeryaamow,","poem":1},{"lineBreak":true},{"text":"Iyo dabayl duufaan ah oo eraygiisa oofiyow,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Buuro iyo kuro oo dhammow,","poem":1},{"lineBreak":true},{"text":"Dhir midho badan iyo dhir kedar la yidhaahdo oo dhammow,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dugaag iyo xoolo oo dhammow,","poem":1},{"lineBreak":true},{"text":"Waxa gurguurta iyo haadda duusha oo dhammow,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Boqorrada dhulka iyo dadyowga oo dhammow,","poem":1},{"lineBreak":true},{"text":"Amiirrada iyo xaakinnada dhulka oo dhammow,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Barbaar iyo hablow,","poem":1},{"lineBreak":true},{"text":"Odayaal iyo carruuray,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ha ammaaneen magaca Rabbiga,","poem":1},{"lineBreak":true},{"text":"Waayo, magiciisa oo keliya ayaa la sarraysiiyaa,","poem":1},{"lineBreak":true},{"text":"Ammaantiisu dhulka iyo cirkaba way ka korraysaa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Isagu wuxuu sare u qaaday geeskii dadkiisa,","poem":1},{"lineBreak":true},{"text":"Iyo ammaantii quduusiintiisa oo dhan,","poem":1},{"lineBreak":true},{"text":"Waana reer binu Israa'iil oo ah dad isaga u dhow.","poem":1},{"lineBreak":true},{"text":"Rabbiga ammaana.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}