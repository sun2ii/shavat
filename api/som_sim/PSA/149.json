{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Rabbiga ammaana.","poem":1},{"lineBreak":true},{"text":"Rabbiga gabay cusub ugu gabya,","poem":1},{"lineBreak":true},{"text":"Oo ammaantiisana shirka quduusiinta kaga dhex gabya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Reer binu Israa'iil kii iyaga uumay ha ku reyreeyeen,","poem":1},{"lineBreak":true},{"text":"Oo reer Siyoonna boqorkooda ha ku farxeen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Magiciisa cayaarta ha ku ammaaneen,","poem":1},{"lineBreak":true},{"text":"Oo ammaan ha ugu gabyeen iyagoo sita daf iyo kataarad.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waayo, Rabbigu wuxuu ku farxaa dadkiisa,","poem":1},{"lineBreak":true},{"text":"Wuxuu kuwa camalka qabowna ku qurxin doonaa badbaado.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quduusiintu ammaan ha ku reyreeyeen,","poem":1},{"lineBreak":true},{"text":"Oo farxad ha ku gabyeen iyagoo sariirahooda jiifa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ammaanta sare oo Ilaah afkooda ha ku jirto,","poem":1},{"lineBreak":true},{"text":"Seef laba af lahuna gacantooda ha ku jirto,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Si ay quruumaha uga aargutaan,","poem":1},{"lineBreak":true},{"text":"Oo ay dadyowgana u ciqaabaan,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Si ay boqorradooda silsilado ugu soo xidhaan,","poem":1},{"lineBreak":true},{"text":"Oo ay raggooda gobta ahna jeebbooyin bir ah ugu soo xidhaan,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Si ay iyaga ugu soo dejiyaan xukunka qoran,","poem":1},{"lineBreak":true},{"text":"Quduusiintiisa oo dhammuna waxay leeyihiin sharaftan.","poem":1},{"lineBreak":true},{"text":"Rabbiga ammaana.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}