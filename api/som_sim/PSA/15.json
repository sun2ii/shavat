{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Rabbiyow, bal yaa taambuuggaaga ku fadhiyaya?","poem":1},{"lineBreak":true},{"text":"Oo bal yaa buurtaada quduuska ah degganaanaya?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waa kii si qumman u socda, oo xaqnimo sameeya,","poem":1},{"lineBreak":true},{"text":"Oo qalbigiisa run kaga hadla.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Waana kii aan carrabkiisa wax ku xaman,","poem":1},{"lineBreak":true},{"text":"Ama aan saaxiibkiis xumaan ku samayn,","poem":1},{"lineBreak":true},{"text":"Ama aan deriskiisa cay ku soo hadal qaadin,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kii indhihiisu ay nejiska quudhsadaan,","poem":1},{"lineBreak":true},{"text":"Oo isagu murweeya kuwa Rabbiga ka cabsada,","poem":1},{"lineBreak":true},{"text":"Kii hadduu dhaarto oo ay waxyeello ku tahay, aan isbeddelin,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kii aan lacagtiisa u soo bixin korsocod,","poem":1},{"lineBreak":true},{"text":"Ama aan laaluush u qaadan inuu wax yeelo kuwa aan xaqa qabin.","poem":1},{"lineBreak":true},{"text":"Kii waxyaalahaas sameeya weligiis lama dhaqaajin doono.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}