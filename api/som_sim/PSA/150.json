xuunta sanqadha dheer.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wax kasta oo neef lahuba Rabbiga ha ammaaneen.","poem":1},{"lineBreak":true},{"text":"Rabbiga ammaana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}