{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Rabbigu waa adhijirka i jira; waxba u baahan maayo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wuxuu i fadhiisiyaa doog qoyan dhexdiis,","poem":1},{"lineBreak":true},{"text":"Oo wuxuu ii hoggaamiyaa biyaha deggan dhinacooda.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Naftayda wuu soo celiyaa.","poem":1},{"lineBreak":true},{"text":"Oo magiciisa aawadiis wuxuu igu hor kacaa waddooyinka xaqnimada.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"In kastoo aan ku dhex socdo dooxada hooska dhimashada,","poem":1},{"lineBreak":true},{"text":"Sharna ka baqi maayo, waayo, waad ila jirtaa,","poem":1},{"lineBreak":true},{"text":"Ushaada iyo hangoolkaaga ayaa ii raaxeeya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cadaawayaashayda hortooda waxaad iigu diyaarisaa miis,","poem":1},{"lineBreak":true},{"text":"Oo saliid baad madaxayga ku subagtaa, koobkayguna waa buuxdhaafaa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hubaal cimrigayga oo dhan waxaa i raaci doona wanaag iyo naxariis,","poem":1},{"lineBreak":true},{"text":"Oo weligay guriga Rabbiga ayaan degganaan doonaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}