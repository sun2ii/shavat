{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Rabbigaa iska leh dhulka iyo waxa ka buuxa oo dhan,","poem":1},{"lineBreak":true},{"text":"Iyo dunida iyo kuwa degganba.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waayo, isagaa badaha dushooda ka aasaasay,","poem":1},{"lineBreak":true},{"text":"Oo wuxuu ka dul dhisay webiyaasha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bal yaa fuuli doona Rabbiga buurtiisa?","poem":1},{"lineBreak":true},{"text":"Oo bal yaa dhex istaagi doona meeshiisa quduuska ah?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waa kii gacmihiisu nadiifsan yihiin, oo qalbigiisu daahir yahay,","poem":1},{"lineBreak":true},{"text":"Oo aan naftiisa hawo been ah kor ugu qaadin,","poem":1},{"lineBreak":true},{"text":"Oo aan si khiyaano leh u dhaaran.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kaasu wuxuu Rabbiga ka heli doonaa barako,","poem":1},{"lineBreak":true},{"text":"Ilaaha badbaadadiisana xaqnimo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kanu waxaa weeye qarnigii kuwa isaga doondoona,","poem":1},{"lineBreak":true},{"text":"Oo waa kuwa wejigaaga doondoona, Ilaaha Yacquubow. (Selaah)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Irdahow, madaxiinna kor u qaada,","poem":1},{"lineBreak":true},{"text":"Oo albaabbada daa'imiska ahow, kor ha laydiin qaado,","poem":1},{"lineBreak":true},{"text":"Oo waxaa soo geli doona Boqorka ammaanta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bal waa ayo Boqorka ammaantu?","poem":1},{"lineBreak":true},{"text":"Waa Rabbiga xoog iyo itaal badan,","poem":1},{"lineBreak":true},{"text":"Waa Rabbiga dagaalka ku xoog badan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Irdahow, madaxiinna kor u qaada,","poem":1},{"lineBreak":true},{"text":"Oo albaabbada daa'imiska ahow, madaxiinna kor u qaada,","poem":1},{"lineBreak":true},{"text":"Oo waxaa soo geli doona Boqorka ammaanta.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bal waa ayo Boqorkan ammaantu?","poem":1},{"lineBreak":true},{"text":"Waa Rabbiga ciidammada,","poem":1},{"lineBreak":true},{"text":"Isaga weeye Boqorka ammaantu. (Selaah)","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}