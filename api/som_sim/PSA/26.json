{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Rabbiyow, i xukun, waayo, waxaan ku socday daacadnimadayda,","poem":1},{"lineBreak":true},{"text":"Oo weliba waxaan Rabbiga isugu halleeyey rogrogmashola'aan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rabbiyow, i imtixaan, oo i tijaabi,","poem":1},{"lineBreak":true},{"text":"Oo uurkayga iyo qalbigaygana baadh.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Waayo, raxmaddaadu waxay taal indhahayga hortooda,","poem":1},{"lineBreak":true},{"text":"Oo waxaan ku socday runtaada.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lama aan fadhiisan waxmatarayaal,","poem":1},{"lineBreak":true},{"text":"Oo kuwa isyeelyeelana gudaha la geli maayo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waan necbahay ururka xumaanfalayaasha,","poem":1},{"lineBreak":true},{"text":"Oo kuwa sharka lehna la fadhiisan maayo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gacmahayga waxaan ku maydhan doonaa eedla'aanta,","poem":1},{"lineBreak":true},{"text":"Markaasaan ku wareegi doonaa meeshaada allabariga, Rabbiyow,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Si aan codka mahadnaqidda dadka u maqashiiyo,","poem":1},{"lineBreak":true},{"text":"Oo aan uga sheekeeyo shuqulladaada yaabka leh oo dhan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rabbiyow, rugta gurigaaga waan jeclahay,","poem":1},{"lineBreak":true},{"text":"Iyo meesha ammaantaadu joogto.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naftayda ha la ururin dembilayaal,","poem":1},{"lineBreak":true},{"text":"Noloshaydana ha la ururin dhiigyocabyada,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gacmahooda belaayadu ku jirto,","poem":1},{"lineBreak":true},{"text":"Gacantooda midigna laaluush ka buuxo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Laakiinse anigu waxaan ku socon doonaa daacadnimadayda,","poem":1},{"lineBreak":true},{"text":"Haddaba i madaxfuro, oo ii naxariiso.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Cagtaydu waxay ku taagan tahay meel siman,","poem":1},{"lineBreak":true},{"text":"Oo Rabbigaan ku ammaani doonaa shirarka dhexdooda.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}