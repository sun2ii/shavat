{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Kuwiinna carruurta Ilaah ahow, Rabbiga ammaana,","poem":1},{"lineBreak":true},{"text":"Rabbiga ka sheega ammaan iyo xoog.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rabbiga ku ammaana ammaanta magiciisu mudan yahay,","poem":1},{"lineBreak":true},{"text":"Rabbiga ku caabuda quruxda quduuska ah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rabbiga codkiisu wuxuu dul joogaa biyaha,","poem":1},{"lineBreak":true},{"text":"Ilaaha ammaantu wuu onkodaa,","poem":1},{"lineBreak":true},{"text":"Oo xataa Rabbigu wuxuu ka kor onkodaa biyo badan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rabbiga codkiisu waa xoog badan yahay,","poem":1},{"lineBreak":true},{"text":"Rabbiga codkiisu waa haybad badan yahay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rabbiga codkiisu wuxuu jebiyaa geedaha kedarka ah,","poem":1},{"lineBreak":true},{"text":"Haah, oo Rabbigu wuxuu kala jebjebiyaa geedaha kedarka ah oo Lubnaan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oo weliba wuxuu iyaga ka dhigaa inay u boodboodaan sida weyl oo kale,","poem":1},{"lineBreak":true},{"text":"Lubnaan iyo Siryonba wuxuu ka dhigaa sida gisi yar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rabbiga codkiisu wuxuu googooyaa ololka dabka.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rabbiga codkiisu wuxuu ruxruxaa cidlada,","poem":1},{"lineBreak":true},{"text":"Rabbigu wuxuu ruxruxaa cidlada Qaadeesh.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rabbiga codkiisu wuxuu dhaliyaa deerooyinka,","poem":1},{"lineBreak":true},{"text":"Oo kayntana caleemaha wuu ka daadiyaa,","poem":1},{"lineBreak":true},{"text":"Oo wax kasta oo macbudkiisa ku jiraana waxay yidhaahdaan, Ammaan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rabbigu wuxuu dul fadhiyaa daadka,","poem":1},{"lineBreak":true},{"text":"Haah, oo Rabbigu wuxuu weligiisba u fadhiyaa sida boqor oo kale.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rabbigu dadkiisuu xoogayn doonaa,","poem":1},{"lineBreak":true},{"text":"Oo Rabbigu nabad buu dadkiisa ku barakayn doonaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}