{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud tiriyey markuu wiilkiisa Absaaloom ka cararay."]},{"type":"verse","number":1,"content":[{"text":"Rabbiyow, cadaawayaashaydu fara badanaa!","poem":1},{"lineBreak":true},{"text":"Kuwa igu kacaa aad bay u badan yihiin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Way badan yihiin kuwa naftayda wax ka sheegaa, iyagoo leh,","poem":1},{"lineBreak":true},{"text":"Ilaah isaga caawin maayo. (Selaah)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Laakiinse, Rabbiyow, adigu waxaad tahay gaashaan igu wareegsan,","poem":1},{"lineBreak":true},{"text":"Iyo sharaftayda, iyo kan madaxayga kor u qaada.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Codkayga ayaan Rabbiga ugu qayliyaa,","poem":1},{"lineBreak":true},{"text":"Oo isaguna wuxuu iiga jawaabaa buurtiisa quduuska ah. (Selaah)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Anigu waan jiifsaday oo waan iska seexday,","poem":1},{"lineBreak":true},{"text":"Oo haddana waan soo toosay, waayo, Rabbiga ayaa i xannaaneeya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ka baqi maayo dadka kumanyaalkaa,","poem":1},{"lineBreak":true},{"text":"Oo gees kasta iga hareereeyey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kac, Rabbiyow, oo i badbaadi, Ilaahayow,","poem":1},{"lineBreak":true},{"text":"Waayo, cadaawayaashaydii oo dhan waxaad ku dhufatay dhabanka,","poem":1},{"lineBreak":true},{"text":"Oo kuwa sharka leh ilkahoodiina waad jejebisay.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Badbaado waxaa leh Rabbiga,","poem":1},{"lineBreak":true},{"text":"Barakadaadu dadkaaga ha ku soo degto. (Selaah)","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}