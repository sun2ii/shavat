{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud u tiriyey madaxdii muusikaystayaasha, oo waxaa lagu qaadaa alaab xadhko leh oo muusiko ah."]},{"type":"verse","number":1,"content":[{"text":"Ilaaha xaqnimadaydow, markii aan ku baryo i maqal,","poem":1},{"lineBreak":true},{"text":"Markii aan cidhiidhi ku jirayba meel baad ii bannaysay,","poem":1},{"lineBreak":true},{"text":"Ii naxariiso oo baryadayda maqal.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Binu-aadmigow, ilaa goormaa sharaftaydu sharafjab u rogmanaysaa?","poem":1},{"lineBreak":true},{"text":"Ilaa goormaad wax aan micne lahayn jeclaanaysaan?","poem":1},{"lineBreak":true},{"text":"Oo ilaa goormaad been doondoonaysaan? (Selaah)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Laakiinse ogaada in Rabbigu gooni ahaan isugu soocay kii cibaado leh,","poem":1},{"lineBreak":true},{"text":"Rabbigu wuu maqli doonaa markii aan u yeedho isaga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cadhooda oo ha dembaabina,","poem":1},{"lineBreak":true},{"text":"Qalbigiinna la hadla markii aad sariirtiinna ku jiiftaan, oo aamusa. (Selaah)","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bixiya allabaryadii xaqnimada,","poem":1},{"lineBreak":true},{"text":"Oo Rabbiga isku halleeya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waxaa jira kuwo badan oo yidhaahda, Bal yaa wanaag na tusaya?","poem":1},{"lineBreak":true},{"text":"Rabbiyow, iftiinka wejigaaga nagu ifi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waxaad qalbigayga gelisay farxad","poem":1},{"lineBreak":true},{"text":"Ka sii badan tan ay helaan markii hadhuudhkooda iyo khamrigoodu ay kordhaan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nabad baan ku jiifsanayaa oo aan ku seexanayaa,","poem":1},{"lineBreak":true},{"text":"Waayo, Rabbiyow, adigoo keliya ayaa ammaan igu bariiya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}