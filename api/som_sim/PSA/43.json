{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Ilaahow, ii gar soor, oo dacwadayda kala muddac quruun aan cibaado lahayn,","poem":1},{"lineBreak":true},{"text":"Iga samatabbixi ninka khiyaanada badan oo xaqa daran.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waayo, waxaad tahay Ilaaha xoogga ii ah, bal maxaad ii xoortay?","poem":1},{"lineBreak":true},{"text":"Dulmiga cadowga daraaddiis bal maxaan ula sii cabaadaa?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuurkaaga iyo runtaada ii soo dir, oo ha i hoggaamiyeen,","poem":1},{"lineBreak":true},{"text":"Oo ha i keeneen buurtaada quduuska ah, iyo taambuugyadaada.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Oo markaasaan tegi doonaa meesha allabariga Ilaah,","poem":1},{"lineBreak":true},{"text":"Iyo Ilaaha ah farxaddayda weyn,","poem":1},{"lineBreak":true},{"text":"Ilaahow, Ilaahaygiiyow, kataaradda waan kugu ammaani doonaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naftaydoy, bal maxaad u murugaysan tahay?","poem":1},{"lineBreak":true},{"text":"Oo bal maxaad gudahayga ugu rabshaysan tahay?","poem":1},{"lineBreak":true},{"text":"Ilaah ku kalsoonow, waayo, weli waxaan ammaanayaa","poem":1},{"lineBreak":true},{"text":"Isagoo ah caawimaadda wejigayga iyo Ilaahay.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}