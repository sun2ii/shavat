{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"heading","content":["Kanu waa sabuur ay reer Qorax u tiriyeen madaxdii muusikaystayaasha."]},{"type":"verse","number":1,"content":[{"text":"Dadyowga oo dhammow, kulligiin sacabka tuma,","poem":1},{"lineBreak":true},{"text":"Oo Ilaah cod guuleed ugu qayliya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waayo, Rabbiga ah Ilaaha ugu sarreeya waa cabsi miidhan,","poem":1},{"lineBreak":true},{"text":"Oo isagu waa boqor weyn oo dhulka oo dhan u taliya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Isagu dadyowga wuxuu gelin doonaa hoosteenna,","poem":1},{"lineBreak":true},{"text":"Quruumahana wuxuu ka hoos marin doonaa cagaheenna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Isagu dhaxalkeenna ayuu inoo dooran doonaa,","poem":1},{"lineBreak":true},{"text":"Kaasoo ah ammaanta Yacquub uu jecel yahay. (Selaah)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ilaah qaylo buu la kacay,","poem":1},{"lineBreak":true},{"text":"Oo wuxuu Rabbiguna la kacay dhawaaqa buunka.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ilaah ammaan ugu heesa, ammaan ugu heesa,","poem":1},{"lineBreak":true},{"text":"Ammaan ugu heesa Boqorkeenna, ammaan heesa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waayo, Ilaah waa dunida oo dhan Boqorkeeda,","poem":1},{"lineBreak":true},{"text":"Haddaba sabuur ammaan ah ku heesa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ilaah wuxuu u taliyaa quruumaha,","poem":1},{"lineBreak":true},{"text":"Ilaahna carshigiisa quduuska ah ayuu ku fadhiistaa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dadyowga amiirradoodii oo dhammu waxay isu soo wada urursadeen","poem":1},{"lineBreak":true},{"text":"Inay dadka Ilaaha Ibraahim noqdaan,","poem":1},{"lineBreak":true},{"text":"Waayo, dhulka gaashaammadiisa waxaa iska leh Ilaah.","poem":1},{"lineBreak":true},{"text":"Oo isaga aad iyo aad baa loo sarraysiiyey.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}