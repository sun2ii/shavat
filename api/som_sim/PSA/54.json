{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["Kanu waa gabay Maskiil ah oo Daa'uud u tiriyey madaxdii muusikaystayaasha, markii ay reer Sif Saa'uul u yimaadeen oo ay ku yidhaahdeen, Daa'uud miyaanu dhuumasho noo dhex joogin? Waxaana lagu qaadaa alaab xadhko leh oo muusiko ah."]},{"type":"verse","number":1,"content":[{"text":"Ilaahow, magacaaga igu badbaadi,","poem":1},{"lineBreak":true},{"text":"Oo xooggaaga iigu garsoor.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ilaahow, baryadayda maqal,","poem":1},{"lineBreak":true},{"text":"Oo erayada afkayga dhegta u dhig,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Waayo, shisheeyayaal baa igu kacay,","poem":1},{"lineBreak":true},{"text":"Oo rag dulmi badan ayaa doonayay inay nafta iga qaadaan,","poem":1},{"lineBreak":true},{"text":"Iyagu Ilaah kama fikirin. (Selaah)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bal eega, Ilaah waa gargaarahayga,","poem":1},{"lineBreak":true},{"text":"Oo Sayidkuna wuxuu la jiraa kuwa naftayda tiiriya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Isagu sharka wuxuu ku celin doonaa cadaawayaashayda,","poem":1},{"lineBreak":true},{"text":"Iyaga runtaada ku baabbi'i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waxaan kuu qali doonaa qurbaan ikhtiyaar ah,","poem":1},{"lineBreak":true},{"text":"Rabbiyow, magacaaga waan ku mahadnaqi doonaa, waayo wuu wanaagsan yahay.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waayo, isagu wuxuu iga samatabbixiyey dhibaato oo dhan,","poem":1},{"lineBreak":true},{"text":"Oo ishayduna waxay cadaawayaashayda ku aragtay wixii aan doonayay.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}