{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud u tiriyey madaxdii muusikaystayaasha, oo waxaa lagu qaadaa alaab xadhko leh oo muusiko ah."]},{"type":"verse","number":1,"content":[{"text":"Ilaahow, qayladayda maqal,","poem":1},{"lineBreak":true},{"text":"Oo baryadaydana dhegta u dhig.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Markii qalbigaygu itaal darnaado, waxaan kaaga qayshan doonaa darafka dhulka ugu shisheeya,","poem":1},{"lineBreak":true},{"text":"Ii hoggaami dhagaxa iga dheer.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Waayo, waxaad ii ahayd magangal,","poem":1},{"lineBreak":true},{"text":"Iyo qalcad adag oo aan cadowga ka galo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Anigu weligayba waxaan degganaan doonaa taambuuggaaga,","poem":1},{"lineBreak":true},{"text":"Oo waxaan magangeli doonaa baalashaada meeshooda qarsoon. (Selaah)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waayo, Ilaahow, nidarradaydii waad maqashay,","poem":1},{"lineBreak":true},{"text":"Oo waxaad i siisay kuwa magacaaga ka cabsada dhaxalkooda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Boqorka noloshiisa waad dheeraynaysaa,","poem":1},{"lineBreak":true},{"text":"Oo cimrigiisuna wuxuu noqon doonaa sida qarniyo badan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oo weligiisba wuxuu joogi doonaa Ilaah hortiisa,","poem":1},{"lineBreak":true},{"text":"Raxmad iyo run u diyaari, inay isaga dhawraan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Markaasaan weligayba magacaaga ammaan ugu gabyi doonaa,","poem":1},{"lineBreak":true},{"text":"Si aan maalin kasta nidarradayda u oofiyo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}