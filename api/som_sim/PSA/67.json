{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["Kanu waa sabuur gabay ah oo loo tiriyey madaxdii muusikaystayaasha, waxaana lagu qaadaa alaab xadhko leh oo muusiko ah."]},{"type":"verse","number":1,"content":[{"text":"Ilaahow, noo naxariiso, oo na barakee,","poem":1},{"lineBreak":true},{"text":"Oo wejigaaguna ha na iftiimiyo, (Selaah)","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"In jidkaaga laga ogaado dhulka,","poem":1},{"lineBreak":true},{"text":"Quruumaha oo dhan dhexdoodana laga wada ogaado caafimaadkaaga wax badbaadiya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ilaahow, dadyowgu ha ku ammaaneen,","poem":1},{"lineBreak":true},{"text":"Dadyowga oo dhammu ha ku ammaaneen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quruumuhu ha farxeen oo ha gabyeen farxad aawadeed,","poem":1},{"lineBreak":true},{"text":"Waayo, dadyowga waxaad ku xukumi doontaa caddaalad,","poem":1},{"lineBreak":true},{"text":"Oo quruumahana dhulkaad ugu talin doontaa. (Selaah)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ilaahow, dadyowgu ha ku ammaaneen,","poem":1},{"lineBreak":true},{"text":"Dadyowga oo dhammu ha ku ammaaneen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dhulku wuxuu soo saaray midhihiisii,","poem":1},{"lineBreak":true},{"text":"Waxaa ina barakayn doona Ilaah, oo ah Ilaaheenna qudhiisa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ilaah waa ina barakayn doonaa,","poem":1},{"lineBreak":true},{"text":"Oo dhulka darafyadiisa oo dhammuna way ka cabsan doonaan isaga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}