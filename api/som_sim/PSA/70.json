{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud u tiriyey madaxdii muusikaystayaasha, si wax loogu xusuusto."]},{"type":"verse","number":1,"content":[{"text":"Ilaahow, soo dhaqso oo i samatabbixi,","poem":1},{"lineBreak":true},{"text":"Rabbiyow, soo dhaqso oo i caawi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kuwa doondoonaya inay naftayda iga qaadaan","poem":1},{"lineBreak":true},{"text":"Ha ceeboobeen oo ha wareereen,","poem":1},{"lineBreak":true},{"text":"Oo kuwa waxyeelladayda ku farxaana","poem":1},{"lineBreak":true},{"text":"Dib ha u noqdeen oo ha sharaf beeleen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuwa Ahaa, Ahaa, lahu,","poem":1},{"lineBreak":true},{"text":"Ceebtooda dib ha ula noqdeen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuwa adiga ku doondoona oo dhammu ha reyreeyeen oo ha kugu farxeen,","poem":1},{"lineBreak":true},{"text":"Oo kuwa badbaadintaada jeceluna had iyo goorba ha yidhaahdeen,","poem":1},{"lineBreak":true},{"text":"Ilaah ha la weyneeyo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Laakiinse miskiin iyo mid baahan baan ahay,","poem":1},{"lineBreak":true},{"text":"Ilaahow, ii soo dhaqso,","poem":1},{"lineBreak":true},{"text":"Waxaad tahay caawimaaddayda iyo samatabbixiyahayga.","poem":1},{"lineBreak":true},{"text":"Rabbiyow, ha iga raagin.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}