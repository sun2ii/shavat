{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"heading","content":["Kanu waa sabuur Daa'uud u tiriyey madaxdii muusikaystayaasha, oo waxaa lagu luuqeeyaa Gitiid."]},{"type":"verse","number":1,"content":[{"text":"Rabbiyow, Sayidkayagiiyow,","poem":1},{"lineBreak":true},{"text":"Magacaagu dunida oo dhan ku fiicanaa!","poem":1},{"lineBreak":true},{"text":"Waayo, sharaftaadii waxaad ka sarraysiisay samooyinka.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waxaad xoog u yeeshay afka ilmaha yaryar iyo caanonuugga,","poem":1},{"lineBreak":true},{"text":"Waana cadaawayaashaada daraaddood,","poem":1},{"lineBreak":true},{"text":"Si aad u aamusiisid cadowga iyo aardoonka.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Markaan ka fiirsado samooyinka farahaaga lagu sameeyey,","poem":1},{"lineBreak":true},{"text":"Iyo dayaxa iyo xiddigaha aad amartay,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bal waa maxay dadku oo aad u xusuusataa isaga?","poem":1},{"lineBreak":true},{"text":"Iyo wiilka aadanaha oo aad u soo booqataa?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waayo, waxaad isaga wax yar ka hoosaysiisay malaa'igaha,","poem":1},{"lineBreak":true},{"text":"Waxaanad taaj uga dhigtay ammaan iyo murwad.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oo waxaad isaga ka dhigtay inuu u taliyo shuqullada gacmahaaga,","poem":1},{"lineBreak":true},{"text":"Oo wax walbana cagihiisaad ka hoosaysiisay,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Idaha iyo lo'da oo dhan,","poem":1},{"lineBreak":true},{"text":"Iyo xayawaanka duurka joogaba,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iyo haadka hawada, iyo kalluunka badda,","poem":1},{"lineBreak":true},{"text":"Iyo wax alla waxa ku dhex socda waddooyinka badaha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rabbiyow, Sayidkayagiiyow,","poem":1},{"lineBreak":true},{"text":"Magacaagu dunida oo dhan ku fiicanaa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}