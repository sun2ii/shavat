{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["Kanu waa sabuur uu Aasaaf tiriyey."]},{"type":"verse","number":1,"content":[{"text":"Ilaah wuxuu dhex istaagaa ururka Ilaah,","poem":1},{"lineBreak":true},{"text":"Oo wuxuu wax ku xukumaa ilaahyada dhexdooda,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ilaa goormaad xaqdarro wax ku xukumaysaan?","poem":1},{"lineBreak":true},{"text":"Oo ilaa goormaad kuwa sharka leh u eexanaysaan? (Selaah)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Miskiinka iyo agoonka gar siiya,","poem":1},{"lineBreak":true},{"text":"Oo caddaalad ugu garsoora kan dhibaataysan iyo saboolka.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Badbaadiya miskiinka iyo kan baahan,","poem":1},{"lineBreak":true},{"text":"Oo ka samatabbixiya gacanta kuwa sharka leh.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Iyagu waxba ma yaqaaniin, waxna garan maayaan,","poem":1},{"lineBreak":true},{"text":"Oo gudcur bay hor iyo dib ugu socdaan,","poem":1},{"lineBreak":true},{"text":"Dhulka aasaaskiisii oo dhammu waa wada dhaqdhaqaaqay.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waxaan idhi, Idinku waxaad tihiin ilaahyo,","poem":1},{"lineBreak":true},{"text":"Oo dhammaantiin waxaad tihiin Ilaaha uga sarreeya wiilashiisii.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Habase yeeshee waxaad u dhiman doontaan sida dadka oo kale,","poem":1},{"lineBreak":true},{"text":"Oo waxaad u dhici doontaan sida amiirrada midkood.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ilaahow, sara joogso oo dhulka xukun,","poem":1},{"lineBreak":true},{"text":"Waayo, waxaad dhaxli doontaa quruumaha oo dhan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}