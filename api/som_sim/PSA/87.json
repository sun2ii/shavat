{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"heading","content":["Kanu waa sabuur gabay ah oo ay reer Qorax tiriyeen."]},{"type":"verse","number":1,"content":[{"text":"Aasaaskiisu wuxuu ku jiraa buuraha quduuska ah.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rabbigu degmooyinka reer Yacquub oo dhan","poem":1},{"lineBreak":true},{"text":"Wuxuu ka jecel yahay irdaha Siyoon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Magaalada Ilaahay,","poem":1},{"lineBreak":true},{"text":"Waxyaalo ammaan badan ayaa lagaa sheegaa. (Selaah)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Anigu waxaan ka sheekayn doonaa Rahab iyo Baabuloon sidii kuwo i yaqaan,","poem":1},{"lineBreak":true},{"text":"Bal eeg, Falastiin, iyo Turos, iyo Itoobiya.","poem":1},{"lineBreak":true},{"text":"Midkanu halkaasuu ku dhashay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Haah, oo Siyoonna waxaa laga odhan doonaa, Midkan iyo midkaasuba iyaduu ku dhashay,","poem":1},{"lineBreak":true},{"text":"Oo Ilaaha ugu sarreeya ayaa iyada dhisi doona.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rabbigu wuu tirin doonaa markuu dadka qorayo,","poem":1},{"lineBreak":true},{"text":"Midkanu halkaasuu ku dhashay. (Selaah)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuwa gabya iyo kuwa cayaaraaba waxay odhan doonaan,","poem":1},{"lineBreak":true},{"text":"Waxaa kugu jira ilahayga oo dhan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}