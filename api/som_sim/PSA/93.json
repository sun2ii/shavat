{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Rabbigaa taliya, oo wuxuu huwan yahay haybad,","poem":1},{"lineBreak":true},{"text":"Rabbigu waa huwan yahay, oo wuxuu dhexda ku xidhay xoog,","poem":1},{"lineBreak":true},{"text":"Duniduna waxay u dhisan tahay si aan la dhaqaajin karin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Carshigaagu wuxuu dhismay waa hore,","poem":1},{"lineBreak":true},{"text":"Oo adiguna waxaad jirtay tan iyo weligaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rabbiyow, webiyadii kor bay u kaceen,","poem":1},{"lineBreak":true},{"text":"Webiyadii codkooday kor u qaadeen,","poem":1},{"lineBreak":true},{"text":"Oo webiyadii waxay kor u qaadeen hirarkoodii.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Biyaha badan codkooda,","poem":1},{"lineBreak":true},{"text":"Iyo mawjadaha badda oo waaweynba","poem":1},{"lineBreak":true},{"text":"Waxaa ka sii xoog badan Rabbiga sare.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rabbiyow, markhaatifurkaagu waa hubaal,","poem":1},{"lineBreak":true},{"text":"Oo weligaaba waxaa gurigaaga ku habboon quduusnimo.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}