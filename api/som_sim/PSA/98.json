{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["Sabuur"]},{"type":"verse","number":1,"content":[{"text":"Rabbiga gabay cusub ugu gabya,","poem":1},{"lineBreak":true},{"text":"Waayo, isagu wuxuu sameeyey waxyaalo yaab badan,","poem":1},{"lineBreak":true},{"text":"Gacantiisa midig iyo dhudhunkiisa quduuska ahuna waxay keeneen badbaado.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rabbigu wuxuu dadka ogeysiiyey badbaadadiisii,","poem":1},{"lineBreak":true},{"text":"Oo xaqnimadiisiina wuxuu bayaan ugu muujiyey quruumaha hortooda.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oo wuxuu soo xusuustay naxariistiisii iyo aaminnimadiisii uu u qabay reerka binu Israa'iil,","poem":1},{"lineBreak":true},{"text":"Dadka dhulka darfihiisa jooga oo dhammu way wada arkeen badbaadinta Ilaaheenna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inta dhulka joogta oo dhammay, Rabbiga farxad ugu qayliya,","poem":1},{"lineBreak":true},{"text":"Dhawaaqa, oo farxad ku gabya, oo ammaan ku gabya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rabbiga ammaan ugu gabya idinkoo kataarad haysta,","poem":1},{"lineBreak":true},{"text":"Kataarad iyo codka heeska ugu gabya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Boqorka Rabbiga ah hortiisa farxad kaga dhawaajiya","poem":1},{"lineBreak":true},{"text":"Turumbooyin iyo buunan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Badda iyo waxa ka buuxaaba ha guuxeen,","poem":1},{"lineBreak":true},{"text":"Dunida iyo kuwa dhex deggan oo dhammuna ha dhawaaqeen,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Webiyadu ha sacbiyeen,","poem":1},{"lineBreak":true},{"text":"Oo buuruhuna dhammaantood farxad ha kaga gabyeen Rabbiga hortiisa,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Waayo, isagu wuxuu u imanayaa inuu dhulka xukumo,","poem":1},{"lineBreak":true},{"text":"Wuxuu dunida ku xukumi doonaa xaqnimo,","poem":1},{"lineBreak":true},{"text":"Dadyowgana caddaalad.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}