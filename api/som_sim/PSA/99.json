{"translation":{"id":"som_sim","name":"Kitaabka Quduuska Ah","website":"https://ebible.org/Scriptures/details.php?id=som","licenseUrl":"https://ebible.org/Scriptures/details.php?id=som","licenseNotes":null,"shortName":"SIM","englishName":"Somali Bible","language":"som","textDirection":"ltr","sha256":"663e0e02a8009b2756fa7977f28303c5a4663f81726f4911fa2b42671ca7b8a9","availableFormats":["json"],"listOfBooksApiLink":"/api/som_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Soomaali","languageEnglishName":"Somali"},"book":{"id":"PSA","translationId":"som_sim","name":"SABUURRADII","commonName":"SABUURRADII","title":"SABUURRADII","order":19,"numberOfChapters":150,"sha256":"4291a1d54de153d2188eb50f5f55056c3eb0aff32d9db3e6a3124247a749cf82","firstChapterNumber":1,"firstChapterApiLink":"/api/som_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/som_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Rabbigu isagaa taliya, dadyowgu ha gariireen,","poem":1},{"lineBreak":true},{"text":"Isagu wuxuu ku fadhiyaa keruubiimta, dhulku ha dhaqdhaqaaqo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rabbigu Siyoon dhexdeeda waa ku weyn yahay,","poem":1},{"lineBreak":true},{"text":"Oo dadyowga oo dhanna wuu ka wada sarreeyaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iyagu ha ammaaneen magacaaga weyn oo laga cabsado,","poem":1},{"lineBreak":true},{"text":"Isagu waa quduus.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Oo weliba boqorka xooggiisu wuxuu jecel yahay garsoorid,","poem":1},{"lineBreak":true},{"text":"Caddaalad baad adkaysaa,","poem":1},{"lineBreak":true},{"text":"Garsoorid iyo xaqnimo baad u samaysaa reer Yacquub.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rabbiga Ilaaheenna ah sarraysiiya,","poem":1},{"lineBreak":true},{"text":"Oo meeshuu cagaha saartona ku sujuuda,","poem":1},{"lineBreak":true},{"text":"Isagu waa quduus.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Muuse iyo Haaruun waxay ka mid ahaayeen wadaaddadiisa,","poem":1},{"lineBreak":true},{"text":"Samuu'eelna wuxuu ka mid ahaa kuwa magiciisa u yeedha,","poem":1},{"lineBreak":true},{"text":"Iyagu waxay baryeen Rabbiga, oo isna wuu u jawaabay.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wuxuu iyagii kala dhex hadlay tiirkii daruurta ahaa,","poem":1},{"lineBreak":true},{"text":"Iyana waxay xajiyeen markhaatifurkiisii iyo qaynuunkii uu iyaga siiyey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rabbiyow Ilaahayagiiyow, waad u jawaabtay,","poem":1},{"lineBreak":true},{"text":"Oo waxaad ahayd Ilaah iyaga cafiyey,","poem":1},{"lineBreak":true},{"text":"In kastoo aad falimahoodii ka aargoosatay.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rabbiga Ilaaheenna ah sarraysiiya,","poem":1},{"lineBreak":true},{"text":"Oo isaga ku caabuda buurtiisa quduuska ah,","poem":1},{"lineBreak":true},{"text":"Waayo, Rabbiga Ilaaheenna ahu waa quduus.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/som_sim/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/som_sim/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/som_sim/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}