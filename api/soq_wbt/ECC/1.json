{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"ECC","translationId":"soq_wbt","name":"Aten gagalowa","commonName":"Aten gagalowa","title":"Aten gagalowa","order":21,"numberOfChapters":9,"sha256":"04572b70ed884bf12b5bb9c9a8030a0033e4fe9b1453da178281997fc28561ee","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/soq_wbt/ECC/12.json","totalNumberOfVerses":85},"chapter":{"number":1,"content":[{"type":"heading","content":["Nitu uduudu diapanau ipusiawaia"]},{"type":"verse","number":1,"content":["Ema ipa Waeuwa Apanawa Dawid otopa Ierusalem bedewe warereleidie wandia aiawa."]},{"type":"verse","number":2,"content":[{"text":"Waeuwa Apanawa wadiase,","poem":1},{"text":"“Nitu uduudu diapanau, diapanauida,","poem":2},{"text":"ipusiawaia!","poem":1},{"text":"Ulaipa di diapanauida!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Apana tawo ema osowe waimoie nola pokawaa dewasai,","poem":1},{"text":"ita dima euwa dosaie wadei?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Apana muntoie waimoi ita do apana bontoie antoi,","poem":1},{"text":"tane tawo deawa winede.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omo wiseidie ita pamede,","poem":1},{"text":"ita leuleidie aupawe wiseide.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lanunu wita sen deneuwe wiseidie,","poem":1},{"text":"ita on deneuwe aleide.","poem":2},{"text":"Ita kawiroroleidie winede.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Esa nomoie owa bedewe antoi,","poem":1},{"text":"tane owa mai nopeleipona;","poem":2},{"text":"esa leuleidie aupawe wiseide,","poem":1},{"text":"ita aleide.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nitu uduudu segaleidia etea dabuasampa rua,","poem":1},{"text":"gagalowa wawa apana mai menamoipona;","poem":2},{"lineBreak":true},{"text":"emamba nitu ewamode tane mai pokasaipona,","poem":2},{"lineBreak":true},{"text":"ita asimba dima etamodia mai pokasaipona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nitu uduudu bauta segantona tane osowe segantopu,","poem":1},{"text":"nitu bauta apana dewamoiena osowe dewamopu,","poem":2},{"lineBreak":true},{"text":"tawo osowe mai nitu da sanaa segaleipona, dia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Walama isiwa apana wapuase,","poem":1},{"text":"“Ewane, nitu ema sanaa segalen.”","poem":2},{"text":"Dia, nitu uduudu mapo segantona deawaa winei","poem":1},{"text":"muriwa no munten.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dewa dainea mapo segantona","poem":1},{"text":"mai mida insamoipona, dia,","poem":2},{"text":"ita dima no tauma dewamoitana,","poem":1},{"text":"apana ando muntompa mai insamopu.","poem":2}]},{"type":"heading","content":["Aten waeuwa"]},{"type":"verse","number":12,"content":["Ne ipa Waeuwa Apanawa Israelwa warereu Ierusalem bedewe wainedine."]},{"type":"verse","number":13,"content":["Ne aten insaisawa mampe nitu uduudu tawo osowe segaleidia insadewasamodine ita insena, “God apana osouwo sai ita nuabola itun.”"]},{"type":"verse","number":14,"content":["Nitu uduudu tawo osowe segaleidia ipawa ne ewanasuden diapana, ewaewa lanunu tanone wadasusana rua."]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Nitu kiokiolena e mai dodomanasaa rua,","poem":1},{"text":"ita nitu dainea mai winamoipona e mai di wisiaitaa rua.","poem":2}]},{"type":"verse","number":16,"content":["Ne neba wane wanase, “Ewee, ne ateina debamaidalen mai mapo warere Ierusalem bedewe waimoia atembu rua, dia. Ne ipa aten debama apanawa.”"]},{"type":"verse","number":17,"content":["Ne insadewasa ita insakadisa atendewasamopa baiwa insaisawantedine tane donsana ipa dewa ema do lanunu tanone wadasusana rua."]},{"type":"verse","number":18,"content":[{"text":"Naita ateina insaisawa euwa debamaidalepia nuabola osonawo itupi,","poem":1},{"text":"ita naita ateina debamalepia nuapare osonawo itupi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}