{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"ECC","translationId":"soq_wbt","name":"Aten gagalowa","commonName":"Aten gagalowa","title":"Aten gagalowa","order":21,"numberOfChapters":9,"sha256":"04572b70ed884bf12b5bb9c9a8030a0033e4fe9b1453da178281997fc28561ee","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/soq_wbt/ECC/12.json","totalNumberOfVerses":85},"chapter":{"number":4,"content":[{"type":"heading","content":["Edasau gagalowa"]},{"type":"verse","number":9,"content":[{"text":"Apana dea meba waimpa ipa euda tane apana nata waimompa sa ipa eudida,","poem":1},{"text":"ipawa mo nata nolau bedewe edasauntompo ipuipua segalempa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naita sowa da omepia da sausapie wadepiposidepi,","poem":1},{"text":"tane apana dea meba waimpe omepia, sa ipa mai euda.","poem":2},{"lineBreak":true},{"text":"Ipawa mai mida me sausapia rua, dia.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Deawaa apana nata ituntompa mai obasa tomopi,","poem":1},{"text":"tane apana dea meba itulempa obasa toidasapi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Apana dea mai onalepie emalawoa nanausapia rua, dia,","poem":1},{"text":"tane apana natantopua edasauntopua rua.","poem":2},{"text":"Tane apana natadea ipa mukamukauaida","poem":1},{"text":"tai badowa owaowanala rua mai tauwadea puwapi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":4}