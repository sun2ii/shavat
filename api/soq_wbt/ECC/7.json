{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"ECC","translationId":"soq_wbt","name":"Aten gagalowa","commonName":"Aten gagalowa","title":"Aten gagalowa","order":21,"numberOfChapters":9,"sha256":"04572b70ed884bf12b5bb9c9a8030a0033e4fe9b1453da178281997fc28561ee","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/soq_wbt/ECC/12.json","totalNumberOfVerses":85},"chapter":{"number":7,"content":[{"type":"heading","content":["Aten insaisawa euda gagalowa"]},{"type":"verse","number":15,"content":["Ina tawo ema osowe diapana bedewe nitu nata ewamone atenten:",{"text":"Apana God anaanawa ruawaleidie wanwan dodomana wande,","poem":1},{"text":"tane ideita apana sanaa boleide.","poem":2},{"text":"Tane me mida kadiwa dewalala God anaanawa mai ruawaleipona","poem":1},{"text":"wanwan daumawa wande.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"E mai apana emauwo dodomana wainiana asowawaitaa,","poem":1},{"text":"mai apana emauwo e insaisa euda apanawa wainiana asowawaitaa,","poem":2},{"lineBreak":true},{"text":"dima baiwa eba kadikaditiana?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mai eba kadi dewalala apanawaida segaitaa,","poem":1},{"text":"mai insakadisalaida segaitaa,","poem":2},{"lineBreak":true},{"text":"e meneedia boa walamawaida ee amua boita, ba?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dewa ema nata emoa.","poem":1},{"text":"Euda ipa nuaitu wasauwa ema insene ruawaitona,","poem":2},{"text":"apana mida God wiwirawaleidia,","poem":1},{"text":"me mai eudidalepia ita kadiidalepia","poem":2},{"lineBreak":true},{"text":"sawano waimpa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Insadewasa apanawa ipa mukamukauaida,","poem":1},{"text":"mai warere 10 bola dea debama onieia mukau rua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ulaipa mai apana da tawo ema osowe dodomanaida, dia,","poem":1},{"text":"mai mida kadiwa dewasiawaiaida ita dodomanaida wainipona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/ECC/5.json","previousChapterAudioLinks":{},"numberOfVerses":6}