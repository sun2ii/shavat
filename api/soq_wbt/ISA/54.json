{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"ISA","translationId":"soq_wbt","name":"Aisaia","commonName":"Aisaia","title":"Aisaia","order":23,"numberOfChapters":19,"sha256":"e43d2a797f253aa75269795fff1a643c9b6367ca9886e2cc2384f46c2d66aab5","firstChapterNumber":2,"firstChapterApiLink":"/api/soq_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/soq_wbt/ISA/64.json","totalNumberOfVerses":130},"chapter":{"number":54,"content":[{"type":"heading","content":["Iawe God Israel apanawa nuawadawadamode"]},{"type":"verse","number":5,"content":[{"text":"Me mida e dewaena ipa e badaa,","poem":1},{"text":"me ebowa ipa Iawe God Mukamukaua uduudu onapolene oniamode,","poem":2},{"text":"Israelwa Godiu kakaiwa ipa e inawala,","poem":1},{"text":"me ebowa waia ipa tawo uduudu Godiu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E ipa i sanaa nainaila badawa edio nuapareleidie wandia rua.","poem":1},{"text":"Tane Iawe God umanaa wapio leuite mampe winea.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iawe God mida e oniaedia ema epe wade, “Walama kampaida os baiwa ne eena,","poem":1},{"text":"tane nuaparena debama mampe leuepo mainawo winea.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne nuana kadileno walama kampaida bedewe ne adiananaena,","poem":1},{"text":"tane nuawadawadana winakasala mampe","poem":2},{"lineBreak":true},{"text":"ne nuaparena e manawo sabamosapa.”","poem":2},{"lineBreak":true},{"text":"Iawe God me mida e kakailedie onialedia ema epe wade","poem":1}]},{"type":"verse","number":9,"content":[{"text":"“Noa walamawe ne sauantena mai osowe abaia wapaaubepo tawo kadisapi,","poem":1},{"text":"epe rua ne sauantedina mai osowe adiananaepa,","poem":2},{"lineBreak":true},{"text":"ita ne mai osowe matangelaepa, dia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naita wadi debamau ba kerakerau lawosantopue diantopu,","poem":1},{"text":"tane ne nuawadawana mai dialepi,","poem":2},{"text":"ita ne wanwan euda obasa eneepa sauawa wana winakasalepi,”","poem":1},{"text":"sa ipa Iawe God mida nuaparealeidia epe wade.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":6}