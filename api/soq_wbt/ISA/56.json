{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"ISA","translationId":"soq_wbt","name":"Aisaia","commonName":"Aisaia","title":"Aisaia","order":23,"numberOfChapters":19,"sha256":"e43d2a797f253aa75269795fff1a643c9b6367ca9886e2cc2384f46c2d66aab5","firstChapterNumber":2,"firstChapterApiLink":"/api/soq_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/soq_wbt/ISA/64.json","totalNumberOfVerses":130},"chapter":{"number":56,"content":[{"type":"heading","content":["Apana uduudu rauparintompa duwa"]},{"type":"verse","number":1,"content":["Iawe God wadiase, “Ne walama kerauda os bedewe wineape inalepa.",{"text":"Ne dewana dodomana apana uduudu mampo sabamosapo ewapu,","poem":1},{"text":"sa baiwa e ulaipa ita dodomana mampe apana mampo dewasanuna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ando bola da apanau inawau amonantopue ne Iawe God mainawo wimopue,","poem":1},{"text":"ita dima ne menanedia rua dewasapu,","poem":2},{"text":"mo ne nuawadawadaneapue wadaposineapu,","poem":1},{"text":"ne bubuana walamawa mo wiwirawantopu,","poem":2},{"lineBreak":true},{"text":"mo ne sauana badowa wanaa wadapuitudepi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bola da apanawa sa ne otamope wadina kakaiwa","poem":1},{"noteId":3},{"text":"osowe teamopa,","poem":1},{"text":"ita ne rauparina duwa bedewe nuaeuna wanamopa.","poem":2},{"text":"Mo amonau susula ita amonau isiwa ne watana osowe teamompa ne nuaeubuntepine mainawomopina,","poem":1},{"text":"apana uduudu ne duna kakaiwa ebowa wapue wapuase, uwa daitada apanawa rauparintompa duwa.”","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"56.7 Wadi kakaiwa umanawa wadia sa ipa wadi Ierusalem bedewe winedia umanawa wade ebowa, da waia Saion.","reference":{"chapter":56,"verse":7}}]},"thisChapterLink":"/api/soq_wbt/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":3}