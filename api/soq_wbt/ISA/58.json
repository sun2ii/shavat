{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"ISA","translationId":"soq_wbt","name":"Aisaia","commonName":"Aisaia","title":"Aisaia","order":23,"numberOfChapters":19,"sha256":"e43d2a797f253aa75269795fff1a643c9b6367ca9886e2cc2384f46c2d66aab5","firstChapterNumber":2,"firstChapterApiLink":"/api/soq_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/soq_wbt/ISA/64.json","totalNumberOfVerses":130},"chapter":{"number":58,"content":[{"type":"heading","content":["Ulaipa ita laga wadaposiwa gagalowa"]},{"type":"verse","number":7,"content":[{"text":"“Mo mida omana tomodia nanala moawa wanamono napu,","poem":1},{"text":"ita apana mida bolau dia bola wanamono wampu,","poem":2},{"text":"mo mida gara abolawantoia garala wanamona,","poem":1},{"text":"do osina sosolaida mai adiananamona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"E epe dewaitano ne sapana omo sanaa wisedie sapa wadia rua","poem":1},{"text":"e osolawo sapa wapi,","poem":2},{"text":"e kerola inantopua walamawa maidaleide,","poem":1},{"text":"ne bautanteape e intala dodomanasapa,","poem":2},{"lineBreak":true},{"text":"ne adilawo enape mukana debama mampe oniadewasalepa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ita e ne mainawo rauparitano etalepe sipoasapa,","poem":1},{"text":"ita e sau baiwa apaitonuno ne etalepe wapaase,","poem":2},{"lineBreak":true},{"text":"‘Ne ema!’","poem":2},{"lineBreak":true},{"text":"E mai apana osouwo sai itununa,","poem":1},{"text":"ita mai wakadisamonuna ba lagau wana, dia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Apana omana totopu mukala uduudu mampe saumonuna,","poem":1},{"text":"ita mo mida bagorantoia mukala uduudu mampe","poem":2},{"text":"nolaitonune saumonuna,","poem":1},{"text":"e epe dewaitonuno e sapala dubawa bedewe sapa wapi,","poem":2},{"lineBreak":true},{"text":"ita tadina uduudu e manlawo ipa walama sapawa rua winompa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":4}