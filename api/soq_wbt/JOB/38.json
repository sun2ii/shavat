{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"JOB","translationId":"soq_wbt","name":"Iob","commonName":"Iob","title":"Iob","order":18,"numberOfChapters":7,"sha256":"621554f5f0f86e5182d972b381c6bff1818f79e8da8f75108893f3c70178ff34","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/soq_wbt/JOB/42.json","totalNumberOfVerses":85},"chapter":{"number":38,"content":[{"type":"heading","content":["Iawe God Iob sipoasade"]},{"type":"verse","number":1,"content":["Tane Iawe God kaibisibisi bedewe Iob sipoasane diene wanase,"]},{"type":"verse","number":2,"content":[{"text":"“E ambi ne insaisana dewasadina bedewe","poem":1},{"text":"aiaa ipasiawaia mampe ne waitaraneiana?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naita e apana, imaite wine nainawo enaa;","poem":1},{"text":"Ne e waitaraepino sipoanea.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E na epe wainiano ne tawo ema dewasane ituna?","poem":1},{"text":"Naita e ateitaa tauma dianea.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mida debamawa makawa atenlene rua dewasan, e ateiten ba, dia?","poem":1},{"text":"Mida witapa aubene rualen?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tuatua sa bumpa dima osowe eindoe enede?","poem":1},{"text":"Tuatua sawano enedia mida eindoden?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Walama sawo walama kiporawa uduudu sasantoie,","poem":1},{"text":"ita God enseliwa uduudu nuaeu mampe wadaposintoie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tane walama ipa owa bupa bedewe abaialene nosen,","poem":1},{"text":"ita mida owa itunbodeno winede?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":8}