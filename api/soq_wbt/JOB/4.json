{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"JOB","translationId":"soq_wbt","name":"Iob","commonName":"Iob","title":"Iob","order":18,"numberOfChapters":7,"sha256":"621554f5f0f86e5182d972b381c6bff1818f79e8da8f75108893f3c70178ff34","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/soq_wbt/JOB/42.json","totalNumberOfVerses":85},"chapter":{"number":4,"content":[{"type":"heading","content":["Elipas Iob mampe gagaloleide"]},{"type":"verse","number":1,"content":["Tane Elipas Teman apanawa Iob sipoasane wanase:"]},{"type":"verse","number":2,"content":[{"text":"“Naita ne gagaloepo, e nuaa kadilepio?","poem":1},{"text":"Tane mai daina wampaa rua.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ulaipa, e apana uaraia waeuwamoana,","poem":1},{"text":"e mo witapu oarantoia dewamoano badonton.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E aiaa mampe apana omeia saumoano eneiena;","poem":1},{"text":"apana imimpu oaoarau e dewamoano badonton.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tane tauma poka saiwa manawo wiseno e insaisaa omen;","poem":1},{"text":"poka saiwa ibua wadeno saidaiten.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ambi, e God wiwirawaitiana ita do wanwanaa dodomanawa wainiana","poem":1},{"text":"dewaepono insaisaa badolepona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"E inseiana apana kadiwa mai dewasaipona","poem":1},{"text":"do sanaa waimoia di bontoi, ba?","poem":2},{"text":"Apana wanwan dodomana waimoia God kadimode, ba?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ne apana sa ewamodina, mo ipa sa kadiwa aimoie","poem":1},{"text":"ita kadiwa uwauwantoi.","poem":2},{"text":"Sa baiwa mo poka saiwa anei","poem":1},{"text":"lawuru naumba aneia rua.","poem":2},{"text":"Ita mo muba ipa sa kadi dewawa","poem":1},{"text":"ita poka saiwa aneiena deawaida uwauwantoi.”","poem":2},"Iob sosowa me dewa kadiu uara dewamodia umanawa osoweosowe dieie sa baiwa me pokawa saiwa mampe debamaidalen, tane Iob wadia me mai kadiwa da dewasapona, dia."]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}