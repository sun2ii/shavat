{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"NUM","translationId":"soq_wbt","name":"Nambas","commonName":"Nambas","title":"Nambas","order":4,"numberOfChapters":13,"sha256":"2818d44279eb80daf8b4fe1556b7b0987f19634ad0193dad071d28677afe1655","firstChapterNumber":6,"firstChapterApiLink":"/api/soq_wbt/NUM/6.json","lastChapterNumber":36,"lastChapterApiLink":"/api/soq_wbt/NUM/36.json","totalNumberOfVerses":152},"chapter":{"number":23,"content":[{"type":"verse","number":18,"content":["Ita Balaam gagalowa ema wane wanase:",{"text":"“Balak, Sipo otopa,","poem":1},{"text":"Wine ne gagalona ema etaadewaitaa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"God ipa mai apanaida ruamba,","poem":1},{"text":"me mai laga wapi, dia.","poem":2},{"text":"Me mai insaisawa leusaipona,","poem":1},{"text":"no apanaida ruamba, dia.","poem":2},{"text":"Me dima wadia ruawaida dewasade.","poem":1},{"text":"Dima me sauawalene wadia ideita segaleide, mai dia.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Me ne dianena sau euda me apanawa osouwo itupa.","poem":1},{"text":"Me mo osouwo sau euda itun.","poem":2},{"text":"Sa baiwa ne saua sa mo osouwo ituna","poem":1},{"text":"mai wadapaaubepa rua, dia.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iawe God ipa mo do,","poem":1},{"text":"mo nuaeu mampe mukantoie wadaposintoi","poem":2},{"text":"ipawa me ipa mo warereu.","poem":1},{"text":"Me ando mai poka saiwa daitada","poem":2},{"text":"Iakob nosinosiwa Israelwa osouwo itupi, dia.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"God Israel apanawa Isibtiwa waimoio","poem":1},{"text":"banlamono nomoiena.","poem":2},{"text":"Me mukawa ipa debamaia,","poem":1},{"text":"kau dobinoa onawaa mukawa rua.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mai mida da Israel apanawa osouwo","poem":1},{"text":"saua kadiwa wapia rua, dia.","poem":2},{"text":"Mai wene ba ginauri dewawa mampe","poem":1},{"text":"mo kadimopua rua, dia.","poem":2},{"text":"Tane mo Israel apanawa Iakob nosinosiwa","poem":1},{"text":"umanau wapue wapuase,","poem":2},{"text":"‘Ewane, God dewa pokawaa me apanawa baibu dewasan!’","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Israel apanawa mukau ipa debamaia","poem":1},{"text":"pue onawaa laion rua;","poem":2},{"text":"me mai di wampia rua, dia, me ideita aleidie moiawa bomodie namode,","poem":1},{"text":"ita do osinapu remoleidio dialeide.","poem":2},{"text":"Ita edie aleidie bubualeidie ituleide.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/NUM/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/NUM/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/NUM/22.json","previousChapterAudioLinks":{},"numberOfVerses":7}