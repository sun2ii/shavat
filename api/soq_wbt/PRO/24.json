{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PRO","translationId":"soq_wbt","name":"Wasau gagalowa","commonName":"Wasau gagalowa","title":"Wasau gagalowa","order":20,"numberOfChapters":14,"sha256":"6de1899876dc04209b7386f5e54a08b79aaf7bd6e955c94417128698cb634272","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/soq_wbt/PRO/31.json","totalNumberOfVerses":55},"chapter":{"number":24,"content":[{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ne apana etedabuala iraiwa sa tampeinta winene anten,","poem":1},{"text":"me ua koakoa wain aina iraiwa sa tampeinta anten.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Irai sa bedewe gedara inintoio ewamona,","poem":1},{"text":"do ina kadiwa inilene debamalen,","poem":2},{"lineBreak":true},{"text":"ita do irai gonaawa seu mampe dewalala daberaralen.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ne irai sa ewane ita insaisawanten ita do atemba wadana.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Itu kerauntape, bubua kerauntape,","poem":1},{"text":"witaa nukuite ita itu dauma ituitaa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"E ituitono nitu uduudu omanawa debama manawo wisepie wadeepiitudepi,","poem":1},{"text":"poi apanawa wisepie wadeepiitudepia, rua.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":5}