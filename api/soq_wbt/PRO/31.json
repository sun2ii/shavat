{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PRO","translationId":"soq_wbt","name":"Wasau gagalowa","commonName":"Wasau gagalowa","title":"Wasau gagalowa","order":20,"numberOfChapters":14,"sha256":"6de1899876dc04209b7386f5e54a08b79aaf7bd6e955c94417128698cb634272","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/soq_wbt/PRO/31.json","totalNumberOfVerses":55},"chapter":{"number":31,"content":[{"type":"heading","content":["I euda gagalowa"]},{"type":"verse","number":10,"content":[{"text":"Apana mida manainapa euda naisena,","poem":1},{"text":"me nitu uwatauwa donsan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Badawa manainapa sumanaiwaleide,","poem":1},{"text":"ita me mai dima da abolawalepi, diaida.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Me walama uduudu, badawa mampe dewa euda dewasade.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Me sipsip imba ita nitu isiwa otamodie upamodie mampe tai owanamode,","poem":1},{"text":"me meba witape gara dewamode.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Me meba witape tai dewamode,","poem":1},{"text":"ita owanamode.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Me duwa moawa wadaaubala apana nuaparelala mampo,","poem":1},{"text":"ita apana dima menamodia mampe saumode.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"I dewawa nuateiteinala dewamodia apana mona lagasapia rua,","poem":1},{"text":"me inainamba euwa sa ando mai winakasalepi, dia.","poem":2},{"text":"Tane i dainea Iawe God wiwirawaleidia,","poem":1},{"text":"apana i sa asowa wapu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"E i sa wiwirawaitana!","poem":1},{"text":"Me witape nolaleidie dewa debamau pokawaau dewamodia baiwa","poem":2},{"lineBreak":true},{"text":"apana uara danauwo me asowa wapue ita ebowa ituposisapu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":8}