{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PRO","translationId":"soq_wbt","name":"Wasau gagalowa","commonName":"Wasau gagalowa","title":"Wasau gagalowa","order":20,"numberOfChapters":14,"sha256":"6de1899876dc04209b7386f5e54a08b79aaf7bd6e955c94417128698cb634272","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/soq_wbt/PRO/31.json","totalNumberOfVerses":55},"chapter":{"number":6,"content":[{"type":"heading","content":["Nina rebareba anaanawa badowa"]},{"type":"verse","number":20,"content":[{"text":"Otona mamaa aiawa etee ruawaitaa,","poem":1},{"text":"ita do inaa waeuwa mai dabuasae ea.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mo aiau nuaawo ituwo walama uduudu winompa;","poem":1},{"text":"ita do posaru rua gadompawo seuwo winompa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"E a leuna bedewe mo wasaubu e inta waeuwaempa;","poem":1},{"text":"do itua bedewe mo waeuwau e oniaepi,","poem":2},{"lineBreak":true},{"text":"ita do itu bedewe enona walamawe aia ema e gagaloepi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mo waeuwau inta waeuwaede,","poem":1},{"text":"iwimpa bedewe siwa sapa wadia rua.","poem":2},{"text":"Mo e wadabuaepu sa e dodomanaeie euwaei","poem":1},{"text":"wanadewaitaa baiwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Waeuwa ema e kakaiepio i nina rebarebala mai mampeita,","poem":1},{"text":"ita do apana da manainapa me aiawa eubu wampo,","poem":2},{"lineBreak":true},{"text":"e mai etee ruawaitaa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Me inainamba euda ewee mai nuaa bedewe omepi,","poem":1},{"text":"me emawa bedewa mai ewaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":6}