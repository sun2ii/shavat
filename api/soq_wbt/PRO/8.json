{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PRO","translationId":"soq_wbt","name":"Wasau gagalowa","commonName":"Wasau gagalowa","title":"Wasau gagalowa","order":20,"numberOfChapters":14,"sha256":"6de1899876dc04209b7386f5e54a08b79aaf7bd6e955c94417128698cb634272","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/soq_wbt/PRO/31.json","totalNumberOfVerses":55},"chapter":{"number":8,"content":[{"type":"heading","content":["Aten Insaisawa Euwa gagalowa"]},{"type":"verse","number":22,"content":[{"text":"Mapo, Iawe God tawo mai dewasapona walamawe,","poem":1},{"text":"walama sawo me nolawa ualepona baiwaleidie,","poem":2},{"lineBreak":true},{"text":"bauta ne, Aten Insaisawa Euwa, dewanen.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bauta ne munten, muriwa Iawe God owa dewasan,","poem":1},{"text":"ita maneu dogo bedewe dewasano wisen.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bauta ne munteno, muriwa Iawe God wadi debamau ita kerakera,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"tawo ita irai bolawa ba dogo dewamon.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ne wainedino Iawe God uba dewasan,","poem":1},{"text":"ita me uba ita owa sawano makalen.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ne mampe wainedino","poem":1},{"text":"me uba tampe giou dewamone teen,","poem":2},{"lineBreak":true},{"text":"ita esa dewamono wimone owa nopesaiena.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ne wainedino Iawe God owa makawa einpunden,","poem":1},{"text":"ita me anaanasana makawa mai ampibolepi.","poem":2},{"text":"Ne wainedino me tawo winepia bolawa badowa dewasane osowe itun.","poem":1}]},{"type":"verse","number":30,"content":[{"text":"Walama sawo ne koitau dewalala apanawa me tampe wainedine,","poem":2},{"text":"ne walama uduudu me nuawa eusadine,","poem":1},{"text":"ne me nata wainitana baiwa nuaeuntedine.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Me tawo dewasana ne ewane nuana eulen,","poem":1},{"text":"ita do tawo osowe apana waimoia ewane nuana eulen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":9}