{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PRO","translationId":"soq_wbt","name":"Wasau gagalowa","commonName":"Wasau gagalowa","title":"Wasau gagalowa","order":20,"numberOfChapters":14,"sha256":"6de1899876dc04209b7386f5e54a08b79aaf7bd6e955c94417128698cb634272","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/soq_wbt/PRO/31.json","totalNumberOfVerses":55},"chapter":{"number":9,"content":[{"type":"heading","content":["Aten Insaisawa Euda ita insakadisalala nisou"]},{"type":"verse","number":1,"content":[{"text":"Aten Insaisawa Euwa meba duwa waden;","poem":1},{"text":"meba unsia 7 dewasan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I sa oda debama dewasan,","poem":1},{"text":"me wain bedewe nitu bonabonaua aimone leusaitusane","poem":2},{"lineBreak":true},{"text":"ita nana do wata osowe teen.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Me nolawa dewalala iotopa wanaubeno anton","poem":1},{"text":"apana uduudu nisomopio wimpu.","poem":2},{"lineBreak":true},{"text":"Me alene sawano enene apalen.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Me wanase, “Apana insakadisalala uduudu","poem":1},{"text":"nisoledina winlena!”","poem":2},{"lineBreak":true},{"text":"Mo mida mai insadewasantoipona mo mampo me wanase,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Winlene nanana dewasana nana,","poem":1},{"text":"ita do wain dewasana nana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Insakoa dewawa emona ita wanwan euda waina;","poem":1},{"text":"aten insaisawa euwa bedeweitane ita dewasana.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":6}