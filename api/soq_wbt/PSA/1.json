{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PSA","translationId":"soq_wbt","name":"Sam","commonName":"Sam","title":"Sam","order":19,"numberOfChapters":14,"sha256":"452799f1bf6ad2d1b70d1316efbdf887dee6fa26aaf7302d9918908677b9b132","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/soq_wbt/PSA/139.json","totalNumberOfVerses":176},"chapter":{"number":1,"content":[{"type":"heading","content":["Nuaeu ulaipaida mampe"]},{"type":"verse","number":1,"content":[{"text":"Nuaeu debama me mampe mida mai","poem":1},{"text":"kadi dewalala do warorontoipona ba aiau eteipe ruawaleipona;","poem":2},{"text":"ba kadi dewalala ita do mo mida God wasiwa waia,","poem":1},{"text":"bedeuwoleipe do deantoipona,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"tane me Iawe God anaanawa nuawadawadasadie,","poem":1},{"text":"tadina ita walama God aiawa wisialeidie insaisaleidie wandia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Apana sa ia maneu tampe inintoie,","poem":1},{"text":"ita ipau walamau osowe naumoidewantoia rua","poem":2},{"text":"ita do asiu mai rorontoipe nonosintoipona","poem":1},{"text":"tane dima uduudu mo dewasaia ipa ipuipua segaleide.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tane apana kadi dewalala mampo mai epe segaleipona!","poem":1},{"lineBreak":true},{"text":"Mo ina tonapa rua lanunu wisedie suaubamode.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sa baiwa mo mai Iawe God kotuwa saiepue inantopu,","poem":1},{"text":"ita me apanawaida do mai deantopu, dia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iawe God dewa dodomana dewasaia apanawa os ewamodie saumode,","poem":1},{"text":"tane kadi dewalala bo intawa asiasi antoi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}