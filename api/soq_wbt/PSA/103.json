{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PSA","translationId":"soq_wbt","name":"Sam","commonName":"Sam","title":"Sam","order":19,"numberOfChapters":14,"sha256":"452799f1bf6ad2d1b70d1316efbdf887dee6fa26aaf7302d9918908677b9b132","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/soq_wbt/PSA/139.json","totalNumberOfVerses":176},"chapter":{"number":103,"content":[{"type":"heading","content":["Iawe God nuawadawadawa sasawa"]},{"type":"hebrew_subtitle","content":["Dawid sasawa"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Ne nuana uduudu mampe Iawe God wadaposisapa.","poem":1},{"text":"Me ebowa kakaiwa wadaposisapa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne nuana uduudu mampe Iawe God wadaposisapa,","poem":1},{"text":"ne walama uduudu me dewa eubu dewamona insamopina.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Me ne kadiwana uduudu insadabuamode","poem":1},{"text":"ita kerona uduudu inamode.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne bo baiwantedino me inanen.","poem":1},{"text":"Me ne nuawadawadanedie","poem":2},{"text":"ita nuaparenaleidie","poem":1},{"text":"dewa eubu mainawo dewamode.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne inawaa wainepino me nitu eubu mampe ne sauneampa,","poem":1},{"text":"ema epe inta ne apana sanaa mukamukaua seganteapa","poem":2},{"lineBreak":true},{"text":"nene inamoia mukamukaua rua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iawe God apana ewadabualala saumode","poem":1},{"text":"ipawa me dewawa dodomana;","poem":2},{"lineBreak":true},{"text":"me mo mampo kotuwa dodomana os dewasade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Me dima insedia umanawa Moses euwasan,","poem":1},{"text":"me dewa pokawaa dewamone mukawa debama","poem":2},{"lineBreak":true},{"text":"sabamosano Israel apanawa eweiena.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iawe God nuawa aiaisiwa ita nuaparelala,","poem":1},{"text":"me mai tauwadea nuawa kadileipona,","poem":2},{"lineBreak":true},{"text":"do me nuawadawadawa mai dialepi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Me mai no kadimba kainokaino eweipe enituidaneipona, dia,","poem":1},{"text":"ita do me nuakadiwa mai winakasaleipona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"No kadiwa dewasaitana baiwa me matangelaneipona,","poem":1},{"text":"tane me no kadiwa dewasaitana","poem":2},{"lineBreak":true},{"text":"mai ruaida sipoanepie matangelaidanepi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mo mida me wiwirawantoia mampo","poem":1},{"text":"me nuawadawadawa ipa debamaia winakasalala;","poem":2},{"lineBreak":true},{"text":"nuawadawada sa ipa iono uba debama winedia rua.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Omo wisedie nowa daumaia aleidie pamedia rua,","poem":1},{"text":"epe rua me no kadimba riasadio nambeido aleide.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Seda mambu obampa mampo","poem":1},{"text":"nuawa aiaisiwa wandia rua,","poem":2},{"text":"Iawe God mo mida me sawantoia mampo","poem":1},{"text":"nuawa aiaisiwa wande,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ipawa me atemba no popokau mampe dewanen,","poem":1},{"text":"me atemba no mai apana mukamukaua, dia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"No ipa beran rua tawo osowe wainitana,","poem":1},{"text":"no beran kelontoie ita nonosintoia rua,","poem":2},{"lineBreak":true},{"text":"walama kampaida os wainitana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lanunu wiseidie suaubamode,","poem":1},{"text":"ita tauwadea nonosintoio","poem":2},{"lineBreak":true},{"text":"mai mida ewamoipona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tane Iawe God nuawadawadawa ipa winakasalala,","poem":1},{"text":"mo mida me sawantoie wiwirawantoia mampo me euda dewasade","poem":2},{"lineBreak":true},{"text":"ita mo bedeuwo mida ando muntompa mampo winakasalepi,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"mo mida saua badowa wadeitue","poem":2},{"lineBreak":true},{"text":"ita anaana sa ruawantoia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Iawe God uba dewasana me kolaiwatawa,","poem":1},{"text":"osowe waine dewa uduudu oniamode.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"E ensel mukamukaua uduudu,","poem":1},{"text":"Iawe God aiawa eteile ruawaitilana,","poem":2},{"lineBreak":true},{"text":"e Iawe God wadaposisana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"E uboo wanwanlala mukamukaua uduudu","poem":1},{"text":"e mida me nolawa dewasailana,","poem":2},{"lineBreak":true},{"text":"Iawe God wadaposisana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dewa uduudu me dewamona","poem":1},{"text":"uboo ita tawo osowe wineia,","poem":2},{"text":"e uduudu Iawe God wadaposisana.","poem":1},{"text":"Ne do nuana uduudu mampe Iawe God wadaposisapa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":22}