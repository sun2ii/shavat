{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PSA","translationId":"soq_wbt","name":"Sam","commonName":"Sam","title":"Sam","order":19,"numberOfChapters":14,"sha256":"452799f1bf6ad2d1b70d1316efbdf887dee6fa26aaf7302d9918908677b9b132","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/soq_wbt/PSA/139.json","totalNumberOfVerses":176},"chapter":{"number":119,"content":[{"type":"heading","content":["Iawe God anaanawa"]},{"type":"verse","number":9,"content":[{"text":"O Iawe God, apana sanaa ambi wanwan dodomana os wampi?","poem":1},{"text":"E aiaa ruawalepie wanwan dodomana wampi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne nuana uduudu mampe rubusadina nolaa dewasapa,","poem":1},{"text":"sa baiwa mai enewo anaanaa dabuasape epa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E aiaa ne nuana bedewe teamono winei,","poem":1},{"text":"ita dewa kadiwa e manawo mai dewasapa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne Iawe God wadaposiedina,","poem":1},{"text":"e anaanaa ne waeuwanea.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"E anaanaa apana wanamoana","poem":1},{"text":"ne osowesane mukantene wisiantedina.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ne e anaanaa ruawantedina mampe nuaeuidantedina,","poem":1},{"text":"mai maura bedewe nuaeu donsadina rua.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne e anaanaa wisiantepine ewepinadewantepine,","poem":1},{"text":"ita e waeuwa insepina.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne nuaeuntepina e anaanaa bedewe","poem":1},{"text":"e aiaa ne mai nuana awawalepi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":8}