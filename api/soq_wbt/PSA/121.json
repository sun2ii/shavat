{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PSA","translationId":"soq_wbt","name":"Sam","commonName":"Sam","title":"Sam","order":19,"numberOfChapters":14,"sha256":"452799f1bf6ad2d1b70d1316efbdf887dee6fa26aaf7302d9918908677b9b132","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/soq_wbt/PSA/139.json","totalNumberOfVerses":176},"chapter":{"number":121,"content":[{"type":"heading","content":["Iawe God me ipa onioniau apanawa"]},{"type":"verse","number":1,"content":[{"text":"Ne sau naepeinta donsapona insene,","poem":1},{"text":"pisiwane wadi ewamona.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne sau Iawe God mida uba ita tawo dewamona mampee,","poem":1},{"text":"mainawo wisepio wadapa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sa baiwa me mai eepio omea, dia,","poem":1},{"text":"walama uduudu eweedio wainiana mai ituleipona,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iawe God ipa Israelwa onioniau apanawa,","poem":1},{"text":"me mai emawa lauleipona ba ituleipona, dia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iawe God ipa e onioniaa apanawa wande,","poem":1},{"text":"me ipa e tanawoido kadiwa donsano sauepi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Walamo omo sapawa e mai kadiepi","poem":1},{"text":"ita tadino uaboa sapawa mai kadiepi, dia.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Poka daitada manawo wisempo Iawe God e oniadewasaepi,","poem":1},{"text":"ita kadiwa mai donsaa, dia.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E noene aitona ita leuitona bedewe Iawe God emawa ipa e osoawo,","poem":1},{"text":"me e oniadewasaempa tauma ita ando ita ando bedewe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":8}