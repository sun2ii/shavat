{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PSA","translationId":"soq_wbt","name":"Sam","commonName":"Sam","title":"Sam","order":19,"numberOfChapters":14,"sha256":"452799f1bf6ad2d1b70d1316efbdf887dee6fa26aaf7302d9918908677b9b132","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/soq_wbt/PSA/139.json","totalNumberOfVerses":176},"chapter":{"number":27,"content":[{"type":"heading","content":["Wadaposi raupariwa"]},{"type":"hebrew_subtitle","content":["Dawid sasawa"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Iawe God ipa ne sapana, ita inawana,","poem":1},{"text":"sa baiwa ne mai santeapa.","poem":2},{"text":"Me ne onianede ando mai kadi donsapa","poem":1},{"text":"sa baiwa ne mai inguguranteapa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Emalawoa apanawa kadi daitada dewalala","poem":1},{"text":"ne bodaneapu kadineapua baiwa,","poem":2},{"lineBreak":true},{"text":"tane mo muba bagorantopue omepu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mo uara awodeantopue ne onana enapu,","poem":1},{"text":"tane ne mai mo sauntapa.","poem":2},{"text":"Mo ne bodaneampo,","poem":1},{"text":"ne sumanaina Iawe God mampe itupa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ne Iawe God iririsapo dewa dea os ne baina dewasapi:","poem":1},{"text":"walama uduudu ne inawana bedewe me duwa bedewe wainepina,","poem":2},{"lineBreak":true},{"text":"ne me euwaa ewapaa menanede","poem":2},{"lineBreak":true},{"text":"ita me duwa kakaiwa bedewe mampe rauparintapa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne poka mainawo wisempo","poem":1},{"text":"me bola euda bedewe wereganepi,","poem":2},{"lineBreak":true},{"text":"me duwa bedewe ne onianepi,","poem":2},{"lineBreak":true},{"text":"me nau osowe ionoido itunepi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne emalawoana apanawa uara enapue pananeapu,","poem":1},{"text":"tane ne mo onaponteapa.","poem":2},{"text":"Ne Iawe God duwa bedewe","poem":1},{"text":"me mampe pue pulontape supa,","poem":2},{"lineBreak":true},{"text":"ne nuaeu mampe ka wape sino epape","poem":2},{"lineBreak":true},{"text":"ita sasantapa Iawe God mampe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iawe God, manawo rauparintepino etanea,","poem":1},{"text":"nuaparenaite saunea!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E ne dianee waanase, “Wine mainawo gagaloitaa.”","poem":1},{"text":"Sa baiwa tauma ne manawo iedina.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne ipa e nolaa dewalala,","poem":1},{"text":"mai nuaa kadilepio adia ne mainawo itua,","poem":2},{"lineBreak":true},{"text":"e mai weregaitaa!","poem":2},{"text":"E ne inaneana,","poem":1},{"text":"e walama uduudu ne sauneie,","poem":2},{"lineBreak":true},{"text":"sa baiwa tauma mai nebaida enea!","poem":2},{"text":"Mai eneaiaa!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Naita ne mamana ita inana","poem":1},{"text":"adiu ne mainawo itupu,","poem":2},{"lineBreak":true},{"text":"tane Iawe God walama uduudu","poem":2},{"lineBreak":true},{"text":"wadanempe mampeneampa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iawe God, ne emalawoana apanawa","poem":1},{"text":"wadaneapua baiwantoi,","poem":2},{"lineBreak":true},{"text":"sa baiwa waeuwaneawo waroroepa,","poem":2},{"lineBreak":true},{"text":"e inta dodomana asiasi banlanea.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Emalawoa apanawa sa ne lagana wai,","poem":1},{"text":"mo ne kadineapua menamode,","poem":2},{"lineBreak":true},{"text":"sa baiwa e mai mo emowo ne wadaneapu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ne sumanaintedina Iawe God euda dewasapio ewapa,","poem":1},{"text":"tawo ema osowe inawaa wainepino me dewasapi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sa baiwa Iawe God sumanaiwaitana,","poem":1},{"text":"insaisala itune badowa enonuna,","poem":2},{"lineBreak":true},{"text":"Iawe God sumanaiwaitana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":14}